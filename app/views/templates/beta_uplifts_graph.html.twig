{% extends 'base.html.twig' %}

{% block head_additions %}
    {% set meta_description = 'Total beta uplifts per Firefox release' %}
    <meta name="description" content="{{ meta_description }}">
    <meta property="twitter:description" content="{{ meta_description }}">
    <meta property="og:url" content="https://whattrainisitnow.com/beta/uplifts/graph/">
{% endblock %}

{% block header %}
<header class="mx-auto mb-3 no-focus-scroll">
    <h1>Beta uplifts per release</h1>
    <p class="fs-6">Total bugs uplifted to beta and RC builds per Firefox release</p>
</header>
{% endblock %}

{% block main %}
<div class="w-75 mx-auto" aria-hidden="true">
    <canvas id="upliftsChart"></canvas>
    <p class="text-center fs-6 mt-3">
        <span class="uplift-legend uplift-legend-4w"></span> 4-week cycle
        <span class="uplift-legend uplift-legend-2w ms-4"></span> 2-week cycle (Firefox {{ two_week_cadence_start }} and later)
    </p>
</div>
<table class="visually-hidden">
    <caption>Beta uplifts per Firefox release</caption>
    <thead>
        <tr>
            <th scope="col">Firefox version</th>
            <th scope="col">Uplifts</th>
            <th scope="col">Beta cycle</th>
        </tr>
    </thead>
    <tbody>
    {% for version, count in graph_data %}
        <tr>
            <td><a href="/beta/?version={{ version }}">{{ version }}</a></td>
            <td>{{ count }}</td>
            <td>{{ version >= two_week_cadence_start ? '2 weeks' : '4 weeks' }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}

{% block footer %}
<footer class="w-50 mx-auto"><i>The graph counts bugs uplifted for the whole beta cycle, not per beta. <br>That means that the numbers are about 1% lower than what we show for the current beta because in the current beta a single bug uplifted in beta 2 can get a follow up fix in say beta 3 or be backed out later in the cycle.</i></footer>
<script src="/assets/chartjs/chart.umd.min.js"></script>
<script nonce="{{constant('NONCE')}}">
const ctx = document.getElementById('upliftsChart');
const style = getComputedStyle(document.documentElement);
Chart.defaults.color = style.getPropertyValue('--font-default-color').trim();
Chart.defaults.font.family = style.getPropertyValue('font-family').trim();
Chart.defaults.font.size = 14;

const labels = {{ graph_labels|json_encode|raw }};
// Firefox moved from a 4-week to a 2-week beta cycle with this version,
// bars are colored differently on each side of the switch.
const twoWeekCadenceStart = {{ two_week_cadence_start }};
const isTwoWeekCycle = (version) => Number(version) >= twoWeekCadenceStart;
const cycleColors = {
    fourWeeks: style.getPropertyValue('--purple-light').trim() || '#cfe2ff',
    twoWeeks:  style.getPropertyValue('--orange-light').trim() || '#ffbe5a',
};
const barColor = (version) => isTwoWeekCycle(version)
    ? cycleColors.twoWeeks
    : cycleColors.fourWeeks;

new Chart(ctx, {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [{
            label: 'Uplifts',
            data: {{ graph_values|json_encode|raw }},
            backgroundColor: labels.map(barColor),
            borderColor: labels.map(barColor),
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        devicePixelRatio: window.devicePixelRatio,
        onClick: (event, elements) => {
            if (elements.length > 0) {
                const version = labels[elements[0].index];
                window.location.href = '/beta/?version=' + version;
            }
        },
        onHover: (event, elements) => {
            event.native.target.style.cursor = elements.length > 0 ? 'pointer' : 'default';
        },
        plugins: {
            legend: { display: false },
            tooltip: {
                callbacks: {
                    title: (items) => 'Firefox ' + items[0].label,
                    label: (item) => item.raw + ' uplifts',
                    afterLabel: (item) => isTwoWeekCycle(item.label)
                        ? '2-week beta cycle'
                        : '4-week beta cycle'
                }
            }
        },
        scales: {
            x: { title: { display: true, text: 'Firefox version' } },
            y: { title: { display: true, text: 'Number of uplifts' }, beginAtZero: true }
        }
    }
});
</script>
{% endblock %}
