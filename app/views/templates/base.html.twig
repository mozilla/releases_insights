<!DOCTYPE html>
<html lang="en" dir="ltr">
    <head>
        <title>{{ page_title }}</title>
        <meta charset="utf-8">
        {# Paint the dark background before external stylesheets load: Firefox has no paint holding
           between same-origin navigations (Chrome does), so it would otherwise flash a white canvas.
           "html > body" outranks the white body background of bootstrap.min.css #}
        <meta name="color-scheme" content="dark">
        <style nonce="{{constant('NONCE')}}">html, html > body { background-color: #210340; }</style>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="alternate" type="application/rss+xml" title="Feed to get alerted of Firefox releases" href="/rss/">
        <link rel="alternate" type="application/rss+xml" title="Feed to get alerted of Firefox ESR releases" href="/rss/esr/">
        <link rel="stylesheet" href="{{ asset('/assets/bootstrap/css/bootstrap.min.css') }}" media="screen">
        {# No version on the font preload: it must match the URL in inter.css or the font is downloaded twice #}
        <link rel="preload" href="/assets/fonts/Inter-4.1/InterVariable-Latin.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="{{ asset('/assets/fonts/Inter-4.1/inter.css') }}">

        {% block head_additions %}{% endblock %}

        <link rel="stylesheet" href="{{ asset('/style/base.css') }}" type="text/css" media="all">

        {% if branch != '' %}
        <link rel="icon" type="image/svg+xml" href="/assets/img/site_icon_dev.svg">
        {% else %}
        <link rel="icon" type="image/svg+xml" href="/assets/img/site_icon.svg">
        {% endif %}

        <link rel="apple-touch-icon" type="image/png" href="/assets/img/site_icon.png">
        <link rel="author" href="/humans.txt">

        <meta property="og:site_name" content="{{ page_title }}">
        <meta property="og:title" content="{{ page_title }}">
        <meta property="og:description" content="">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:creator" content="@pascalchevrel">
        <meta property="twitter:title" content="{{ page_title }}">
        <meta property="twitter:image" content="https://whattrainisitnow.com/assets/img/site-sharing-header.png">

    </head>
    <body id="{{ css_page_id }}" class="container-fluid px-lg-5">
        {% if branch != '' %}
        <div class="position-fixed top-0 start-50 translate-middle badge text-bg-info font-monospace mt-5" title="Git branch"><small>{{ branch }}</small></div>
        {% endif %}

        {% if constant('STAGING')  %}
        <div class="position-absolute top-0 start-50 translate-middle-x font-monospace fw-bold text-dark bg-warning bg-gradient mt-1 w-75 text-center">This is a staging environment for <a href="https://whattrainisitnow.com"  class="link-primary bg-warning">whattrainisitnow.com</a></div>
        {% endif %}
        {% include 'menu.html.twig' %}
        {% block header %}{% endblock %}
        <main>
        {% block main %}{% endblock %}
        </main>
        <script src="{{ asset('/assets/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
        {% block footer %}{% endblock %}
        <script nonce="{{constant('NONCE')}}">
            // Text version of a tooltip title, which can contain HTML (data-bs-html)
            const tooltipText = html => new DOMParser()
                .parseFromString(html.replace(/<br\s*\/?>/gi, ' '), 'text/html')
                .body.textContent.replace(/\s+/g, ' ').trim();

            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                const text = el.title ? tooltipText(el.title) : '';
                if (text !== '') {
                    if (el.textContent.trim() === '' && ! el.hasAttribute('aria-label')) {
                        // Icon-only element: Bootstrap would use the raw HTML title as aria-label
                        el.setAttribute('aria-label', text);
                    } else if (! el.matches('a[href], button, input, select, textarea, [tabindex]')) {
                        // Keyboard and screen reader users can't open a tooltip on a non-focusable
                        // element, and Bootstrap removes its title: keep the text for screen readers
                        const hidden = document.createElement('span');
                        hidden.className = 'visually-hidden';
                        hidden.textContent = ` (${text})`;
                        el.append(hidden);
                    }
                }
                new bootstrap.Tooltip(el);
            });
        </script>
    </body>
</html>