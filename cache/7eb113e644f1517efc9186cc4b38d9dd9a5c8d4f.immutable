"pushes": {"258": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 436a2ee5bfc7c4e70c0d6bc14bf1946e66c1a231 with FIREFOX_102_12_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c84a07c6eacf1227f4bec78ab8ba0b65c080d109", "parents": ["436a2ee5bfc7c4e70c0d6bc14bf1946e66c1a231"], "tags": []}], "date": 1685382204, "git_changesets": [null], "user": "ffxbld"}, "259": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179665", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "79fc1aad50f69d7cd11549eac9bfe9776d2bed12", "parents": ["c84a07c6eacf1227f4bec78ab8ba0b65c080d109"], "tags": []}, {"author": "mcheang \u003cmcheang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835934 - update search engine tests. r=Standard8, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179490", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_baidu.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_distributions.js"], "git_node": null, "git_parents": [null], "node": "db336df68d34820185714cd19fbb027041c5aa3f", "parents": ["79fc1aad50f69d7cd11549eac9bfe9776d2bed12"], "tags": []}], "date": 1685640727, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "260": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "9edaabd7041b23f73162e00514d30faebcb99b31", "parents": ["db336df68d34820185714cd19fbb027041c5aa3f"], "tags": []}], "date": 1685976424, "git_changesets": [null], "user": "ffxbld-merge"}, "261": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 436a2ee5bfc7c4e70c0d6bc14bf1946e66c1a231 with FIREFOX_102_12_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "8054dd0f7f73a4c1aad8e3737b86fee65930005a", "parents": ["9edaabd7041b23f73162e00514d30faebcb99b31"], "tags": []}], "date": 1686056261, "git_changesets": [null], "user": "ffxbld"}, "262": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180313", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "89d799cb7aba537343ef8fb9ad07f4b28cdc7b2a", "parents": ["8054dd0f7f73a4c1aad8e3737b86fee65930005a"], "tags": []}], "date": 1686232919, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "263": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1836883. Avoid passing ref function arguments to Rc::from_raw. r=eemeli, a=dmeehan\n\nIt is unfortunately undefined behavior and leads to problems with LLVM\n16.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180061", "files": ["intl/l10n/rust/fluent-ffi/src/bundle.rs", "intl/l10n/rust/fluent-ffi/src/resource.rs", "intl/l10n/rust/l10nregistry-ffi/src/registry.rs", "intl/l10n/rust/l10nregistry-ffi/src/source.rs"], "git_node": null, "git_parents": [null], "node": "fef410902ca8d68c3bbfe59f04fb888046f1add2", "parents": ["89d799cb7aba537343ef8fb9ad07f4b28cdc7b2a"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180670", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "5a69a9972d4c0b42f1c775322141c9bca38f4f69", "parents": ["fef410902ca8d68c3bbfe59f04fb888046f1add2"], "tags": []}], "date": 1686579943, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "264": {"changesets": [{"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1825169: Process off main thread deletions in DrawEventRecorderPrivate::AddStoredObject. r=aosmond, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D174952", "files": ["gfx/2d/DrawEventRecorder.h", "gfx/2d/DrawTargetRecording.cpp", "gfx/layers/CanvasDrawEventRecorder.cpp", "gfx/layers/CanvasDrawEventRecorder.h", "gfx/layers/ipc/CanvasChild.cpp"], "git_node": null, "git_parents": [null], "node": "23fb72af3558908de3d20111fef7c7fc335b8a54", "parents": ["5a69a9972d4c0b42f1c775322141c9bca38f4f69"], "tags": []}, {"author": "Corinne R Pohl \u003ccorinne.r.pohl@gmail.com\u003e", "branch": "default", "desc": "Bug 1829507: Fix typo in DrawEventRecorder.h. r=jrmuizel, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D176220", "files": ["gfx/2d/DrawEventRecorder.h"], "git_node": null, "git_parents": [null], "node": "301dc715712ffbb061f4a26dd41612f99d37e3f5", "parents": ["23fb72af3558908de3d20111fef7c7fc335b8a54"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1831188: Process pending deletions in DrawEventRecorderPrivate::DetachResources. r=aosmond, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177095", "files": ["gfx/2d/DrawEventRecorder.h"], "git_node": null, "git_parents": [null], "node": "e49be4c7f00406dde860121b0293eb3de9819a96", "parents": ["301dc715712ffbb061f4a26dd41612f99d37e3f5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1836670 - ESR patch. a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180185", "files": ["Cargo.lock", "Cargo.toml", "third_party/rust/cssparser/src/cow_rc_str.rs"], "git_node": null, "git_parents": [null], "node": "8b7eadc7f5062d8f5fc5aa757bdfb03a9f8ae181", "parents": ["e49be4c7f00406dde860121b0293eb3de9819a96"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1834711 - Set background finalized flag for dead object proxes created after nuking all CCWs r=jandem (ESR102), a=dmeehan\n\n\nThe background finalized flag wasn't getting set in the second overload of\nNewDeadProxyObject. The patch makes the first overload of this function more\ngeneric so it can accept non-proxy arguments and uses it in all cases.\n\nThe testcase also results in dead object proxies being returned from rewrap()\nin RemapDeadWrapper which previously cased an assertion. I added an early\nreturn for this case - do you think that's OK?\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180949", "files": ["js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/proxy/DeadObjectProxy.cpp", "js/src/proxy/DeadObjectProxy.h", "js/src/vm/Compartment.cpp", "js/src/vm/JSObject.cpp", "js/src/vm/JSObject.h"], "git_node": null, "git_parents": [null], "node": "145eb64b95c10ecf71a43b4ceaa531af8301f55d", "parents": ["8b7eadc7f5062d8f5fc5aa757bdfb03a9f8ae181"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181073", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "83c6d476a93bb91d8a31c8195e378bc76bc3404b", "parents": ["145eb64b95c10ecf71a43b4ceaa531af8301f55d"], "tags": []}], "date": 1686839173, "git_changesets": [null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "265": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181368", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "428280ada88971034c4a533d61fadf841245106b", "parents": ["83c6d476a93bb91d8a31c8195e378bc76bc3404b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1832306 - Make `BrowserParent` stop handling access keys with delayed events r=smaug,NeilDeakin, a=dmeehan\n\n`EventStateManager::WalkESMTreeToHandleAccessKey()` requests all `BrowserParent`\ninstances to handle access key in content processes:\nhttps://searchfox.org/mozilla-central/rev/a4fd6daad3a4123d995478467c1274653b283801/dom/events/EventStateManager.cpp#1379,1398,1410-1411\n\nThen, content processes will reply if no element matches with the access key:\nhttps://searchfox.org/mozilla-central/rev/8e1b221afcdae76284b1439c547b032d1f84d236/dom/ipc/BrowserChild.cpp#2304-2305,2310\n\nFinally, the parent process handles the keypress event:\nhttps://searchfox.org/mozilla-central/rev/8e1b221afcdae76284b1439c547b032d1f84d236/dom/ipc/BrowserParent.cpp#2710-2712,2720,2725\n\nHowever, this is odd because if multiple remote processes calls\n`BrowserParent::RecvAccessKeyNotHandled()`, the parent process will handle\nsame `keypress` event multiple times.\n\nThe approach of this patch is, `BrowserParent` should store main data of\nsending `eKeyPress` event, and `RecvAccessKeyNotHandled()` handles only if\nthe coming event matches with the stored one and clear the data to avoid\nhandling multiple times.\n\nEven with this approach, we cannot avoid one `eKeyPress` event handled in\nmultiple content processes, or in both the main process and a content process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179172", "files": ["dom/ipc/BrowserParent.cpp", "widget/TextEvents.h"], "git_node": null, "git_parents": [null], "node": "7b5e63e739fa0c8e53b0870fa14a2d56b7f89e65", "parents": ["428280ada88971034c4a533d61fadf841245106b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833603 - use google cloud storage instead of amazon s3 for release-generate-checksums task. r=releng-reviewers,bhearsum, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178661", "files": ["taskcluster/ci/release-generate-checksums/kind.yml", "testing/mozharness/scripts/release/generate-checksums.py"], "git_node": null, "git_parents": [null], "node": "c9ae202c8caeae1d69d87bcb4249510af0f2cbd2", "parents": ["7b5e63e739fa0c8e53b0870fa14a2d56b7f89e65"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833603 - update snap repackage task to download from archive.m.o instead of s3 buckets directly. r=releng-reviewers,bhearsum, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178662", "files": ["taskcluster/ci/release-snap-repackage/kind.yml"], "git_node": null, "git_parents": [null], "node": "5741ffac993d808f0653e295b4327069f5ef15c4", "parents": ["c9ae202c8caeae1d69d87bcb4249510af0f2cbd2"], "tags": []}], "date": 1687190813, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "266": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1836188 - Cherry-pick bindgen fixes for llvm16. r=glandium, a=dmeehan\n\n\nCherry-picks:\n\n * https://github.com/rust-lang/rust-bindgen/commit/80738016a36e803fe3bf8b8f6f388c6589d86a1c\n * https://github.com/rust-lang/rust-bindgen/commit/c03b37697a1e117995ea76203e5c0ce7d6696c4e\n\nCo-authored-by: Douglas R. Reno \u003crenodr@linuxfromscratch.org\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179683", "files": ["third_party/rust/bindgen/src/clang.rs", "third_party/rust/bindgen/src/ir/comp.rs", "third_party/rust/bindgen/src/ir/ty.rs", "third_party/rust/bindgen/src/ir/var.rs"], "git_node": null, "git_parents": [null], "node": "b514cdde75accfba95887f397000d5e6dd56dba1", "parents": ["5741ffac993d808f0653e295b4327069f5ef15c4"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1836723 - Link against ntdll for rustc 1.70. r=firefox-build-system-reviewers,ahochheiden, a=dmeehan\n\nBuilding with rustc 1.70 adds a dependency to the ntdll library through\nlibstd using NtCreateFile/NtWriteFile (it previously picked the symbols\nat runtime).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180011", "files": ["js/src/build/moz.build", "security/manager/ssl/ipcclientcerts/dynamic-library/moz.build", "security/manager/ssl/osclientcerts/dynamic-library/moz.build", "toolkit/mozapps/defaultagent/moz.build"], "git_node": null, "git_parents": [null], "node": "3efc34ebdeceb50e893175fe38dca30d6624b5c5", "parents": ["b514cdde75accfba95887f397000d5e6dd56dba1"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1836550 - Validate image data received from IPC r=NeilDeakin, a=dmeehan", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": null, "git_parents": [null], "node": "00297c9943e1719e8615261bf7ee40c0c81292d6", "parents": ["3efc34ebdeceb50e893175fe38dca30d6624b5c5"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181766", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "aaad6fca8133a09f375248e72b3cc8c7d56b0595", "parents": ["00297c9943e1719e8615261bf7ee40c0c81292d6"], "tags": []}], "date": 1687445529, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "267": {"changesets": [{"author": "Sean Feng \u003csefeng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1816287 - Always exit fullscreen when triggering on external protocol r=edgar, a=dmeehan\nIt's a security risk such that the maximized external program can obscure\nthe fullscreen notification and the malicious site can use this trick\nto load a spoofed page in the background without user notices it.\n\nThis patch minimized the risk by always exit the fullscreen mode when\nan external protocol is triggered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177771", "files": ["docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/LocationBase.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/nsNoDataProtocolContentPolicy.cpp", "dom/base/test/browser.ini", "dom/base/test/browser_fullscreen_exit_on_external_protocol.js", "image/imgLoader.cpp", "image/imgRequest.cpp", "parser/html/nsHtml5TreeOperation.cpp"], "git_node": null, "git_parents": [null], "node": "1a652c68ff2a733d0b39f3caa7d973c6b0247f75", "parents": ["aaad6fca8133a09f375248e72b3cc8c7d56b0595"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1837450 - Check for overflow when validating custom cursor data. r=nika, a=dmeehan\nDifferential Revision: https://phabricator.services.mozilla.com/D181260", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": null, "git_parents": [null], "node": "dfbd8a4c3e2bf57151b4aef8577e2e20cec166b8", "parents": ["1a652c68ff2a733d0b39f3caa7d973c6b0247f75"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1839669 - Use stack pointer register for stack probes to fix crashes on older Linux kernels. r=iain, a=dmeehan\n\nGoogle Images creates a huge stack frame with more than 19550 slots (more than 150 KB)\nand then uses OSR to enter Baseline Interpreter code.\n\nThe stack probing we do there caused crashes because older kernels don't like it when\nthe distance between the address and RSP is more than about 64 KB.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181892", "files": ["js/src/jit-test/tests/baseline/osr-large-stack-frame.js", "js/src/jit/MacroAssembler.cpp"], "git_node": null, "git_parents": [null], "node": "68d9c3b95fd1ed886232e324de6204043681c677", "parents": ["dfbd8a4c3e2bf57151b4aef8577e2e20cec166b8"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181989", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "e8f4ecee801c29b98f8b1dac2cf612ddff605dd2", "parents": ["68d9c3b95fd1ed886232e324de6204043681c677"], "tags": []}], "date": 1687797606, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "268": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1826002 - use decoded certificates r=jschanck, a=dmeehan", "files": ["dom/media/webrtc/RTCCertificate.cpp", "dom/media/webrtc/transport/dtlsidentity.cpp", "dom/webauthn/U2FSoftTokenManager.cpp"], "git_node": null, "git_parents": [null], "node": "a053c9cb7874ada4502fb0f39146103f1a2d5e77", "parents": ["e8f4ecee801c29b98f8b1dac2cf612ddff605dd2"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1834862 - implement nsICryptoHash in rust r=jschanck,supply-chain-reviewers, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179727", "files": ["Cargo.lock", "security/manager/ssl/components.conf", "security/manager/ssl/crypto_hash/Cargo.toml", "security/manager/ssl/crypto_hash/crypto_hash.h", "security/manager/ssl/crypto_hash/src/lib.rs", "security/manager/ssl/moz.build", "security/manager/ssl/nsCryptoHash.cpp", "security/manager/ssl/nsCryptoHash.h", "security/manager/ssl/nsICryptoHash.idl", "security/manager/ssl/nsNSSModule.cpp", "third_party/rust/digest/.cargo-checksum.json", "third_party/rust/digest/CHANGELOG.md", "third_party/rust/digest/Cargo.toml", "third_party/rust/digest/README.md", "third_party/rust/digest/src/core_api/ct_variable.rs", "third_party/rust/digest/src/core_api/wrapper.rs", "third_party/rust/digest/src/dev.rs", "third_party/rust/digest/src/dev/rng.rs", "third_party/rust/digest/src/digest.rs", "third_party/rust/digest/src/lib.rs", "third_party/rust/digest/src/mac.rs", "third_party/rust/md-5/.cargo-checksum.json", "third_party/rust/md-5/CHANGELOG.md", "third_party/rust/md-5/Cargo.toml", "third_party/rust/md-5/LICENSE-APACHE", "third_party/rust/md-5/LICENSE-MIT", "third_party/rust/md-5/README.md", "third_party/rust/md-5/benches/mod.rs", "third_party/rust/md-5/src/compress.rs", "third_party/rust/md-5/src/lib.rs", "third_party/rust/md-5/tests/data/md5.blb", "third_party/rust/md-5/tests/mod.rs", "third_party/rust/sha1/.cargo-checksum.json", "third_party/rust/sha1/CHANGELOG.md", "third_party/rust/sha1/Cargo.toml", "third_party/rust/sha1/LICENSE-APACHE", "third_party/rust/sha1/LICENSE-MIT", "third_party/rust/sha1/README.md", "third_party/rust/sha1/benches/mod.rs", "third_party/rust/sha1/src/compress.rs", "third_party/rust/sha1/src/compress/aarch64.rs", "third_party/rust/sha1/src/compress/soft.rs", "third_party/rust/sha1/src/compress/x86.rs", "third_party/rust/sha1/src/lib.rs", "third_party/rust/sha1/tests/data/sha1.blb", "third_party/rust/sha1/tests/mod.rs", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": null, "git_parents": [null], "node": "5cd1ec341c132e49d25c3ca246f777748e9e1f1e", "parents": ["a053c9cb7874ada4502fb0f39146103f1a2d5e77"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838108 - nsICryptoHash: use non-assembly hashing implementation on Windows r=jschanck, a=dmeehan\n\nOn Windows 7 pre-SP1, AVX instructions are disabled, even though they might be\nsupported by the processor. The cpufeatures crate doesn't take this into\naccount, so the assembly implementation of sha-512 causes illegal instruction\ncrashes. As a workaround for now, use the non-assembly implementation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181000", "files": ["security/manager/ssl/crypto_hash/Cargo.toml"], "git_node": null, "git_parents": [null], "node": "de3985836b99af24d65f72235b6ad13ce680037d", "parents": ["5cd1ec341c132e49d25c3ca246f777748e9e1f1e"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1837675, a=dmeehan\n\n\n\nOriginal Revision: https://phabricator.services.mozilla.com/D182113\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182114", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": null, "git_parents": [null], "node": "169f7b3be57e6fbd93d048384e1446378696bbc8", "parents": ["de3985836b99af24d65f72235b6ad13ce680037d"], "tags": []}], "date": 1687872892, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "269": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset de3985836b99 (bug 1838108) with Bug 1834862 for causing build failures in esr102", "files": ["security/manager/ssl/crypto_hash/Cargo.toml"], "git_node": null, "git_parents": [null], "node": "26d2d36c75e55bafedb9dda55d34cf39271a173c", "parents": ["169f7b3be57e6fbd93d048384e1446378696bbc8"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 5cd1ec341c13 (bug 1834862) with Bug 1838108 for causing build failures in esr102", "files": ["Cargo.lock", "security/manager/ssl/components.conf", "security/manager/ssl/crypto_hash/Cargo.toml", "security/manager/ssl/crypto_hash/crypto_hash.h", "security/manager/ssl/crypto_hash/src/lib.rs", "security/manager/ssl/moz.build", "security/manager/ssl/nsCryptoHash.cpp", "security/manager/ssl/nsCryptoHash.h", "security/manager/ssl/nsICryptoHash.idl", "security/manager/ssl/nsNSSModule.cpp", "third_party/rust/digest/.cargo-checksum.json", "third_party/rust/digest/CHANGELOG.md", "third_party/rust/digest/Cargo.toml", "third_party/rust/digest/README.md", "third_party/rust/digest/src/core_api/ct_variable.rs", "third_party/rust/digest/src/core_api/wrapper.rs", "third_party/rust/digest/src/dev.rs", "third_party/rust/digest/src/dev/rng.rs", "third_party/rust/digest/src/digest.rs", "third_party/rust/digest/src/lib.rs", "third_party/rust/digest/src/mac.rs", "third_party/rust/md-5/.cargo-checksum.json", "third_party/rust/md-5/CHANGELOG.md", "third_party/rust/md-5/Cargo.toml", "third_party/rust/md-5/LICENSE-APACHE", "third_party/rust/md-5/LICENSE-MIT", "third_party/rust/md-5/README.md", "third_party/rust/md-5/benches/mod.rs", "third_party/rust/md-5/src/compress.rs", "third_party/rust/md-5/src/lib.rs", "third_party/rust/md-5/tests/data/md5.blb", "third_party/rust/md-5/tests/mod.rs", "third_party/rust/sha1/.cargo-checksum.json", "third_party/rust/sha1/CHANGELOG.md", "third_party/rust/sha1/Cargo.toml", "third_party/rust/sha1/LICENSE-APACHE", "third_party/rust/sha1/LICENSE-MIT", "third_party/rust/sha1/README.md", "third_party/rust/sha1/benches/mod.rs", "third_party/rust/sha1/src/compress.rs", "third_party/rust/sha1/src/compress/aarch64.rs", "third_party/rust/sha1/src/compress/soft.rs", "third_party/rust/sha1/src/compress/x86.rs", "third_party/rust/sha1/src/lib.rs", "third_party/rust/sha1/tests/data/sha1.blb", "third_party/rust/sha1/tests/mod.rs", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": null, "git_parents": [null], "node": "93e1268418d16fe5efa4f3b200c488492e5ded2d", "parents": ["26d2d36c75e55bafedb9dda55d34cf39271a173c"], "tags": []}], "date": 1687874780, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "270": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1813494 - Part 1: Common up code to cancel and remove all load requests, a=dmeehan\n\n\nCancellation happend in ParsingComplete() and Destroy() but was inconsistent in\nwhich kinds of requests were cancelled and which were cancelled and removed.\nThis makes one method that cancels and removes everything and uses it in both\nplaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182190", "files": ["dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": null, "git_parents": [null], "node": "83c6a50319e2185e1efe02516a369726fbe6a8e2", "parents": ["93e1268418d16fe5efa4f3b200c488492e5ded2d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838484 - Don't create module loader for template contents owner document, a=dmeehan\n\n\nWhen I added ScriptLoader::SetGlobalObject I didn't realise that more than one\ndocument could share the same global object. It turns out that this happens for\nthese template contents owner documents and this causes the assert that checks\nthat right module loader is associated with the global to fail because it finds the\nother document's module loader.\n\nAs far as I can tell we don't need a module load for these documents so we can\nskip this call that creates it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182191\n\nDepends on D182190", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/crashtests/1838484.html", "dom/base/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "03da282eb8a59ccb68b5edf8be4379db8dd1aafa", "parents": ["83c6a50319e2185e1efe02516a369726fbe6a8e2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835886 - Cancel outstanding load requests when a document is detached from a global, a=dmeehan\n\n\nAlso cancel module load requests when cancelling requests generally.\n\nWhat was happening here was that a previous load was completing and calling\ninto the wrong module loader, because the loader to use is determined via the\ncurrent global, and this was now associated with a different document / script\nloader / module loader.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182192\n\nDepends on D182191", "files": ["dom/script/ScriptLoader.cpp", "js/loader/ModuleLoaderBase.cpp"], "git_node": null, "git_parents": [null], "node": "a09940345a857e60ec7c614104e6d3cfb72060fe", "parents": ["03da282eb8a59ccb68b5edf8be4379db8dd1aafa"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835886 - Report errors for dynamicly loaded modules in ensureCustomElements, a=dmeehan\n\n\nThis is required to prevent unhandled rejections causing test failures when\ntests close the window before these dynamically loaded modules finish loading.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182193\n\nDepends on D182192", "files": ["toolkit/content/customElements.js"], "git_node": null, "git_parents": [null], "node": "13502893a8933a7f586a8310baa287e0b54d07db", "parents": ["a09940345a857e60ec7c614104e6d3cfb72060fe"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835886 - Fix linter failures on esr102, a=me", "files": ["toolkit/content/customElements.js"], "git_node": null, "git_parents": [null], "node": "e00b12330b4f762b921611f3be26433c5a7c7728", "parents": ["13502893a8933a7f586a8310baa287e0b54d07db"], "tags": []}], "date": 1687892741, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "271": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset e00b12330b4f (bug 1835886) with Bug 181394 and Bug 1838484 for causing test failures in esr102", "files": ["toolkit/content/customElements.js"], "git_node": null, "git_parents": [null], "node": "50835623f55bf08cb8c4812ae1b0a789bec7ed57", "parents": ["e00b12330b4f762b921611f3be26433c5a7c7728"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 13502893a893 (bug 1835886) with Bug 1813494 and Bug 1838484 for causing test failures in esr102", "files": ["toolkit/content/customElements.js"], "git_node": null, "git_parents": [null], "node": "48a99343226e9954d4c6a63c789e58c3b6fdca56", "parents": ["50835623f55bf08cb8c4812ae1b0a789bec7ed57"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset a09940345a85 (bug 1835886) with Bug 1813494 and Bug 1838484 for causing test failures in esr102", "files": ["dom/script/ScriptLoader.cpp", "js/loader/ModuleLoaderBase.cpp"], "git_node": null, "git_parents": [null], "node": "d40fb6996e040f9d089e3cb114add8d8e8e801c3", "parents": ["48a99343226e9954d4c6a63c789e58c3b6fdca56"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 03da282eb8a5 (bug 1838484) with Bug 1813494 and Bug 1835886 for causing test failures in esr102", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/crashtests/1838484.html", "dom/base/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "d0f72061cb9c595f15f8e3001fbcda3e16179b74", "parents": ["d40fb6996e040f9d089e3cb114add8d8e8e801c3"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 83c6a50319e2 (bug 1813494) with Bug 1813494 and Bug 1838484 for causing test failures in esr102", "files": ["dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": null, "git_parents": [null], "node": "21f655a57e8118a566dee3cd32ac43df0bc0f4be", "parents": ["d0f72061cb9c595f15f8e3001fbcda3e16179b74"], "tags": []}], "date": 1687900090, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "272": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1816287 - Fix paths for browser_fullscreen_exit_on_external_protocol.js. a=bustage\n\nOn ESR102, the fullscreen tests live in dom/html, not dom/base. Also, the\nsupport files are specified per-test rather than at the top of the manifest,\nso add them to the new test.\n\nUnfortunately, this test is still permanently failing due to a stuck application\nhandler dialog trying to handle a mailto: link, so skip it for now.", "files": ["dom/base/test/browser.ini", "dom/base/test/browser_fullscreen_exit_on_external_protocol.js", "dom/html/test/browser.ini", "dom/html/test/browser_fullscreen_exit_on_external_protocol.js"], "git_node": null, "git_parents": [null], "node": "da917366ac9119c37a7ec89b6d9b64ad167b8b5c", "parents": ["21f655a57e8118a566dee3cd32ac43df0bc0f4be"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1779326 - Handle a few more `native` types in rust-xpidl, r=xpcom-reviewers,kmag, a=dmeehan\n\nThis makes the logic for the rust type line up a bit more with the C++\nlogic for existing types, and adds support for 'char' and 'char16_t'\nnative types (for 'charPtr').\n\nThis specifically enables `nsIInputStream::Read` to be used from Rust.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152715", "files": ["docs/writing-rust-code/xpcom.md", "services/common/app_services_logger/src/lib.rs", "toolkit/components/glean/src/init/upload_pref.rs", "toolkit/components/glean/src/init/user_activity.rs", "toolkit/components/xulstore/src/ffi.rs", "xpcom/idl-parser/xpidl/xpidl.py", "xpcom/rust/gtest/xpcom/test.rs"], "git_node": null, "git_parents": [null], "node": "bce72fde46a404ff429f399579dab3bba3444130", "parents": ["da917366ac9119c37a7ec89b6d9b64ad167b8b5c"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1834862 - implement nsICryptoHash in rust r=jschanck,supply-chain-reviewers, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179727", "files": ["Cargo.lock", "security/manager/ssl/components.conf", "security/manager/ssl/crypto_hash/Cargo.toml", "security/manager/ssl/crypto_hash/crypto_hash.h", "security/manager/ssl/crypto_hash/src/lib.rs", "security/manager/ssl/moz.build", "security/manager/ssl/nsCryptoHash.cpp", "security/manager/ssl/nsCryptoHash.h", "security/manager/ssl/nsICryptoHash.idl", "security/manager/ssl/nsNSSModule.cpp", "third_party/rust/digest/.cargo-checksum.json", "third_party/rust/digest/CHANGELOG.md", "third_party/rust/digest/Cargo.toml", "third_party/rust/digest/README.md", "third_party/rust/digest/src/core_api/ct_variable.rs", "third_party/rust/digest/src/core_api/wrapper.rs", "third_party/rust/digest/src/dev.rs", "third_party/rust/digest/src/dev/rng.rs", "third_party/rust/digest/src/digest.rs", "third_party/rust/digest/src/lib.rs", "third_party/rust/digest/src/mac.rs", "third_party/rust/md-5/.cargo-checksum.json", "third_party/rust/md-5/CHANGELOG.md", "third_party/rust/md-5/Cargo.toml", "third_party/rust/md-5/LICENSE-APACHE", "third_party/rust/md-5/LICENSE-MIT", "third_party/rust/md-5/README.md", "third_party/rust/md-5/benches/mod.rs", "third_party/rust/md-5/src/compress.rs", "third_party/rust/md-5/src/lib.rs", "third_party/rust/md-5/tests/data/md5.blb", "third_party/rust/md-5/tests/mod.rs", "third_party/rust/sha1/.cargo-checksum.json", "third_party/rust/sha1/CHANGELOG.md", "third_party/rust/sha1/Cargo.toml", "third_party/rust/sha1/LICENSE-APACHE", "third_party/rust/sha1/LICENSE-MIT", "third_party/rust/sha1/README.md", "third_party/rust/sha1/benches/mod.rs", "third_party/rust/sha1/src/compress.rs", "third_party/rust/sha1/src/compress/aarch64.rs", "third_party/rust/sha1/src/compress/soft.rs", "third_party/rust/sha1/src/compress/x86.rs", "third_party/rust/sha1/src/lib.rs", "third_party/rust/sha1/tests/data/sha1.blb", "third_party/rust/sha1/tests/mod.rs", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": null, "git_parents": [null], "node": "af4c936634299076cc2ecfbe6763f3ba56ac4356", "parents": ["bce72fde46a404ff429f399579dab3bba3444130"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838108 - nsICryptoHash: use non-assembly hashing implementation on Windows r=jschanck, a=dmeehan\n\nOn Windows 7 pre-SP1, AVX instructions are disabled, even though they might be\nsupported by the processor. The cpufeatures crate doesn't take this into\naccount, so the assembly implementation of sha-512 causes illegal instruction\ncrashes. As a workaround for now, use the non-assembly implementation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181000", "files": ["security/manager/ssl/crypto_hash/Cargo.toml"], "git_node": null, "git_parents": [null], "node": "8f09fb4350de0f9ed3122e2f241f4d5f7cf447c6", "parents": ["af4c936634299076cc2ecfbe6763f3ba56ac4356"], "tags": []}], "date": 1687910686, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "273": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1813494 - Part 1: Common up code to cancel and remove all load requests a=dmeehan\n\n\nCancellation happend in ParsingComplete() and Destroy() but was inconsistent in\nwhich kinds of requests were cancelled and which were cancelled and removed.\nThis makes one method that cancels and removes everything and uses it in both\nplaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182190", "files": ["dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": null, "git_parents": [null], "node": "6294efbe451ea1278d375accee3cac8d42e147b9", "parents": ["8f09fb4350de0f9ed3122e2f241f4d5f7cf447c6"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838484 - Don't create module loader for template contents owner document a=dmeehan\n\n\nWhen I added ScriptLoader::SetGlobalObject I didn't realise that more than one\ndocument could share the same global object. It turns out that this happens for\nthese template contents owner documents and this causes the assert that checks\nthat right module loader is associated with the global to fail because it finds the\nother document's module loader.\n\nAs far as I can tell we don't need a module load for these documents so we can\nskip this call that creates it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182191\n\nDepends on D182190", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/crashtests/1838484.html", "dom/base/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "07b206524b7e0a0343cf76cd37f38c7a20e4382e", "parents": ["6294efbe451ea1278d375accee3cac8d42e147b9"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835886 - Cancel outstanding load requests when a document is detached from a global a=dmeehan\n\n\nAlso cancel module load requests when cancelling requests generally.\n\nWhat was happening here was that a previous load was completing and calling\ninto the wrong module loader, because the loader to use is determined via the\ncurrent global, and this was now associated with a different document / script\nloader / module loader.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182192\n\nDepends on D182191", "files": ["dom/script/ScriptLoader.cpp", "js/loader/ModuleLoaderBase.cpp"], "git_node": null, "git_parents": [null], "node": "4e773e69c9b35756e0689b68d4c2b9d02f327390", "parents": ["07b206524b7e0a0343cf76cd37f38c7a20e4382e"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1840323 - Backport mp4parse change to fix building with recent rustc. r=kinetik, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182272", "files": ["Cargo.lock", "Cargo.toml", "third_party/rust/mp4parse/src/lib.rs"], "git_node": null, "git_parents": [null], "node": "acdd5cca5f849a1363bedcfcdff172edd4dfe115", "parents": ["4e773e69c9b35756e0689b68d4c2b9d02f327390"], "tags": ["FIREFOX_102_13_0esr_BUILD1"]}], "date": 1687967240, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "274": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging acdd5cca5f849a1363bedcfcdff172edd4dfe115 with FIREFOX_102_13_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "4297ce3887555154c2305b23b2e59870818ceb9c", "parents": ["acdd5cca5f849a1363bedcfcdff172edd4dfe115"], "tags": []}], "date": 1687975921, "git_changesets": [null], "user": "ffxbld"}, "275": {"changesets": [{"author": "Sean Feng \u003csefeng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1744288 - Store pending full screen request when calling element.requestFullscreen immediately. r=edgar, a=dmeehan\nWhen element.requestFullscreen is called, we dispatch small task via\nDocument::AsyncRequestFullscreen. But it doesn't append FullscreenRequests\nto PendingFullscreenChangeList immediately. So if we want to check\nwhether we have pending full screen request, we have to run an event loop.\n\nAlthough I would like to check whether we have pending full screen request for\nscreen.orientation.lock compatibility, since we don't append it to pending\nlist immediately, we don't have the easy way to detect it.\n\nRequestFullscreen doesn't wait for the completion if it runs on content\nprocess since RequestFullscreenInContentProcess doesn't wait for the result\nof chrome event. If runs on chrome process, RequestFullscreenInParentProcess\nis synchronous. So this change removes AsyncRequestFullscreen and simply\ncalls RequestFullscreen.\n\nBy not using AsyncRequestFullscreen, we will append FullscreenRequests to\npending list immediately, so we can check it without event loop.\n\nCredit of this patch goes to : m_kato\u003cmkato.birchill@mozilla.com\u003e", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/html/test/browser.ini"], "git_node": null, "git_parents": [null], "node": "3ba84f15ffa6092b5587de58f09dbc4240bcf8e2", "parents": ["4297ce3887555154c2305b23b2e59870818ceb9c"], "tags": ["FIREFOX_102_13_0esr_BUILD2", "FIREFOX_102_13_0esr_RELEASE"]}], "date": 1688059511, "git_changesets": [null], "user": "dmeehan@mozilla.com"}}
}";