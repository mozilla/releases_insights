9ae67", "parents": ["8955d24fa7c2d6c81a25d850438bed7dbf41372a"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067190 - Add test.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322748\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324682\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2067190.js"], "git_node": "0981ff3d5c099c50defa32b7c78f84b98d28b339", "git_parents": ["b146feafa7df3d3b613fc5bb06d608712cd71637"], "node": "65fef2e57973faca142e4db4cbf5562b52c41af3", "parents": ["6821f0af2b8babfff3cf7b02c2e3fec25779ae67"], "tags": []}], "date": 1789648485, "git_changesets": ["b146feafa7df3d3b613fc5bb06d608712cd71637", "0981ff3d5c099c50defa32b7c78f84b98d28b339"], "user": "pchevrel@mozilla.com"}, "1684": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 1 - Rename ModulePaths to ModuleIdentifiers  a=pascalc DONTBUILD\n\nRename-only, since ModuleIdentifiers will be used in later parts, instead of\njust paths.  No substantive changes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324702\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325992\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPPlatform.cpp", "dom/media/gmp/GMPPlatform.h", "dom/media/gmp/PGMP.ipdl", "dom/media/ipc/PRDD.ipdl", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h"], "git_node": "cb0713bec6b062c2cbc8a35b2dcc75e65e3011b1", "git_parents": ["0981ff3d5c099c50defa32b7c78f84b98d28b339"], "node": "36cbfe206df61d2cdb7023238ab9c4898a0c7d78", "parents": ["65fef2e57973faca142e4db4cbf5562b52c41af3"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 2 - Pass child process's module list by section handle  a=pascalc DONTBUILD\n\nChild processes now report loaded DLLs to the parent by section HANDLE instead\nof by filename.  The DLL blocklist's NtMapViewOfSection hook already receives\nthe section a module is being mapped from, so it duplicates that section,\nread-only, onto the ModuleLoadInfo for the load.  The parent identifies the\nmodule from the HANDLE.\n\nBecause the section outlives the view, this also fixes reporting for two kinds\nof load: a module the blocklist rejected, which is unmapped immediately, and a\nmodule unloaded before the parent processed the batch.  Previously, either\ncould be deleted before the parent had a chance to consider them.\n\nA handle cannot be forged into a reference to a different file and a child can\nonly send one it holds.  ValidateAndResolveModuleSection sanity checks:\n\n1. The section must map, and the view must be MEM_IMAGE. A data section can\n   be made over any openable file but an image section means the kernel\n   accepted the file as a PE and the child's image-load policy applied to it.\n2. The file must not be on a remote device.\n3. The file must not carry a mandatory integrity label below medium.\n\nThese checks replicate the checks of the MITIGATION_IMAGE_LOAD_NO_REMOTE and\nMITIGATION_IMAGE_LOAD_NO_LOW_LABEL child sandbox behaviors.  A child\ncan create a non-IMAGE section over any file it can open, so what it hands us\nis not bounded by the image-load policy.  The check avoid considering such\nfiles at all.  This currently applies to all child processes: content, gpu,\nRDD, socket, utility (all kinds), and GMP.  All have these sandbox mitigations.\n\nAlso fixes a couple of ways that a version resource could misuse VerQueryValueW's\noutput in the parent: a zero length underflowing to SIZE_MAX in\nQueryStringValue and a too-short buffer dereference in GetFromImage.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324703\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325993\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPPlatform.h", "mozglue/misc/NativeNt.h", "toolkit/xre/dllservices/ModuleVersionInfo.cpp", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h"], "git_node": "6ed3718819b552f1a0b90143afbd4c1091fb5e7e", "git_parents": ["cb0713bec6b062c2cbc8a35b2dcc75e65e3011b1"], "node": "c65634ff507b19fbc896703cd96326d69ab9ab1e", "parents": ["36cbfe206df61d2cdb7023238ab9c4898a0c7d78"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 3 - Test that UntrustedModulesProcessor rejects invalid modules  a=pascalc DONTBUILD\n\nCheck that ValidateAndResolveModuleSection rejects descriptors that are\nnon-IMAGE sections or are for below-medium-integrity modules.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324704\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325994\n", "files": ["toolkit/xre/dllservices/tests/gtest/TestModuleFileValidation.cpp", "toolkit/xre/dllservices/tests/gtest/moz.build"], "git_node": "da05be70cc4b17c5a9c01b65c57cb45bf866094f", "git_parents": ["6ed3718819b552f1a0b90143afbd4c1091fb5e7e"], "node": "e563c2bcfbbc8d50e3f70d8ef12ce801d496ca30", "parents": ["c65634ff507b19fbc896703cd96326d69ab9ab1e"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 4 - Add DLL-reporting test  a=pascalc DONTBUILD\n\nTests that ModuleRecord and DOS paths match.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325995\n", "files": ["toolkit/xre/dllservices/tests/gtest/TestModuleFileValidation.cpp"], "git_node": "471cf249a63f65a3ddf5ec15b9200067c56c7eec", "git_parents": ["da05be70cc4b17c5a9c01b65c57cb45bf866094f"], "node": "961dfb13fce4b738031e33a79655fcfa8074fe13", "parents": ["e563c2bcfbbc8d50e3f70d8ef12ce801d496ca30"], "tags": []}], "date": 1789648721, "git_changesets": ["cb0713bec6b062c2cbc8a35b2dcc75e65e3011b1", "6ed3718819b552f1a0b90143afbd4c1091fb5e7e", "da05be70cc4b17c5a9c01b65c57cb45bf866094f", "471cf249a63f65a3ddf5ec15b9200067c56c7eec"], "user": "pchevrel@mozilla.com"}, "1685": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071695 - build funsize-update-generator image on top of debian12-base.  a=pascalc DONTBUILD\n\nUse our own base image instead of pulling from docker hub, to get\nreproducible/snapshotted packages; update from debian 11 to 12.\n\nReplace /home/worker paths with /builds/worker following the base image's $HOME.\n\nUpdate funsize's requirements.txt for python 3.11.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326872\n", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile", "taskcluster/docker/funsize-update-generator/requirements.txt", "taskcluster/docker/funsize-update-generator/runme.sh", "taskcluster/gecko_taskgraph/transforms/partials.py", "taskcluste