@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053518 - Handle the *-oe-linux-* rust targets added in rustc 1.98 in rust target detection.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311145\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324529\n", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "c1d3042b6d9408637c7b165e8d12b0786940d708", "git_parents": ["be7546617fb1e0bdce8649003985d128f8197748"], "node": "a0418bb85d901b76e211bcbc663e2c914bf33354", "parents": ["52a4c094f566ea480b88f2f93ba38e0848156c24"], "tags": []}], "date": 1789632274, "git_changesets": ["c1d3042b6d9408637c7b165e8d12b0786940d708"], "user": "pchevrel@mozilla.com"}, "1675": {"changesets": [{"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: check for invalid payload length.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317971\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325380\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "eba2834527c794bca3cbc92bb2523df09313ec84", "git_parents": ["c1d3042b6d9408637c7b165e8d12b0786940d708"], "node": "fbc77acfa5a626a0c60249a2d6cb0d3a304c7521", "parents": ["a0418bb85d901b76e211bcbc663e2c914bf33354"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: make sure buffer storing decrypted data is not left uninitialized.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325381\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "d85cd5fbe82d90062803b29eea4a72e33f2d75b7", "git_parents": ["eba2834527c794bca3cbc92bb2523df09313ec84"], "node": "6fe8fbf9ff34a26fa3944fecb1889bdd2cfa4ae1", "parents": ["fbc77acfa5a626a0c60249a2d6cb0d3a304c7521"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: decrypt the previous block when seeking on EOF so mPlainBuffer contains the expected data.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322324\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325382\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "dc7f07f1efd92f9ee0a2ff90700296c7b6a69a5b", "git_parents": ["d85cd5fbe82d90062803b29eea4a72e33f2d75b7"], "node": "c0f59fff73bc17e216784655f57e3a843dface0f", "parents": ["6fe8fbf9ff34a26fa3944fecb1889bdd2cfa4ae1"], "tags": []}], "date": 1789632365, "git_changesets": ["eba2834527c794bca3cbc92bb2523df09313ec84", "d85cd5fbe82d90062803b29eea4a72e33f2d75b7", "dc7f07f1efd92f9ee0a2ff90700296c7b6a69a5b"], "user": "pchevrel@mozilla.com"}, "1676": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061009 - Set default browser triggers two prompts on macOS 27 r!#mac-reviewers   a=pascalc\n\nUse -[NSWorkspace setDefaultApplicationAtURL:toOpenURLsWithScheme:] instead of\nLSSetDefaultHandlerForURLScheme() and LSSetDefaultRoleHandlerForContentType() to\nset the default browser on macOS 27+.\n\nOn macOS 27 Beta, with LSSetDefaultHandlerForURLScheme() and\nLSSetDefaultRoleHandlerForContentType(), each call generates a confirmation\nprompt resulting in multiple prompts when the \"Make default\" button is pressed.\n\nThe NSWorkspace API is available on macOS 12+, but limit it to macOS 27+ for now\nto be conservative.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317309\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326340\n", "files": ["CLOBBER", "browser/components/shell/moz.build", "browser/components/shell/nsMacShellService.cpp", "browser/components/shell/nsMacShellService.mm"], "git_node": "b8650f29fa55cd3ca5a02e5d1c10704e1af236cf", "git_parents": ["dc7f07f1efd92f9ee0a2ff90700296c7b6a69a5b"], "node": "fe38461ecee9f3a7e5aa84c7651630a6dd35ebe9", "parents": ["c0f59fff73bc17e216784655f57e3a843dface0f"], "tags": []}], "date": 1789633365, "git_changesets": ["b8650f29fa55cd3ca5a02e5d1c10704e1af236cf"], "user": "pchevrel@mozilla.com"}, "1677": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071064 - Call ClearForm when unlinking form controls.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325435\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325511\n", "files": ["dom/html/HTMLImageElement.cpp", "dom/html/nsGenericHTMLElement.cpp"], "git_node": "a2f566ad4bf7863e91dc08ab6146e15c358a71a0", "git_parents": ["b8650f29fa55cd3ca5a02e5d1c10704e1af236cf"], "node": "c85a597b59124e59d2437fcc18ffecb1a44c914a", "parents": ["fe38461ecee9f3a7e5aa84c7651630a6dd35ebe9"], "tags": []}], "date": 1789635769, "git_changesets": ["a2f566ad4bf7863e91dc08ab6146e15c358a71a0"], "user": "pchevrel@mozilla.com"}, "1678": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068351 - Add GetFormIfRegistered helper  a=pascalc DONTBUILD\n\nThis adds a new helper which returns the form, guarded by the ADDED_TO_FORM flag.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323267\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324685\n", "files": ["dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h"], "git_node": "9f99865feaa303c2dd9eebe78dd33a9d5c0e0351", "git_parents": ["a2f566ad4bf7863e91dc08ab6146e15c358a71a0"], "node": "b16ac31e42d2103a80b277e5c90e36bd800410b9", "parents": ["c85a597b59124e59d2437fcc18ffecb1a44c914a"], "tags": []}], "date": 1789635978, "git_changesets": ["9