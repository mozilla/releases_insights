531d7d26c79cdc408f4faa383caab924", "ee1f48209df890f93a2b8dffe2366f8e39aa9995", "f098aef4c97c1668ff4a0b905d476080ae4155c5"], "user": "ffxbld@lando.moz.tools"}, "1661": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "789c637d4c5c2d927d93933f3a88ff1226f6aa98", "git_parents": ["82076abb4c58a40cbd5e772b2c41887444aa9510"], "node": "e208601472ceb5cca9f69e176a4a04be051545e1", "parents": ["d864999404b3032f682d74ccc60d1ce38c9ce609"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "8e024eed5b78fc85089e3fb3864db2712a2df018", "git_parents": ["789c637d4c5c2d927d93933f3a88ff1226f6aa98"], "node": "42bd040ccf94c1ab58b111c49b1cfc97f9626f81", "parents": ["e208601472ceb5cca9f69e176a4a04be051545e1"], "tags": []}], "date": 1789040441, "git_changesets": ["789c637d4c5c2d927d93933f3a88ff1226f6aa98", "8e024eed5b78fc85089e3fb3864db2712a2df018"], "user": "ffxbld@lando.moz.tools"}, "1662": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061009 - Set default browser triggers two prompts on macOS 27 r!#mac-reviewers  a=pascalc\n\nUse -[NSWorkspace setDefaultApplicationAtURL:toOpenURLsWithScheme:] instead of\nLSSetDefaultHandlerForURLScheme() and LSSetDefaultRoleHandlerForContentType() to\nset the default browser on macOS 27+. We already use NSWorkspace this way to set\nthe default PDF handler.\n\nOn macOS 27 Beta, with LSSetDefaultHandlerForURLScheme() and\nLSSetDefaultRoleHandlerForContentType(), each call generates a confirmation\nprompt resulting in multiple prompts when the \"Make default\" button is pressed.\n\nThe NSWorkspace API is available on macOS 12+, but limit it to macOS 27+ for now\nto be conservative.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317309\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324456\n", "files": ["browser/components/shell/nsMacShellService.cpp"], "git_node": "49e0d38c01d56227d4148730ce5734e0b927bc9d", "git_parents": ["8e024eed5b78fc85089e3fb3864db2712a2df018"], "node": "507f87e2653d23cca596ca0ab95930dbc20c24c8", "parents": ["42bd040ccf94c1ab58b111c49b1cfc97f9626f81"], "tags": []}], "date": 1789317393, "git_changesets": ["49e0d38c01d56227d4148730ce5734e0b927bc9d"], "user": "pchevrel@mozilla.com"}, "1663": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061009 - Set default browser triggers two prompts on macOS 27 r!#mac-reviewers a=pascalc\" for build bustages a=backout\n\nThis reverts commit 49e0d38c01d56227d4148730ce5734e0b927bc9d.\n", "files": ["browser/components/shell/nsMacShellService.cpp"], "git_node": "f617e0e508c1f5db56c39d655266d3393bf4b113", "git_parents": ["49e0d38c01d56227d4148730ce5734e0b927bc9d"], "node": "c5741c4f0f631d09ccba4a0a30206c98c498dd1e", "parents": ["507f87e2653d23cca596ca0ab95930dbc20c24c8"], "tags": []}], "date": 1789319308, "git_changesets": ["f617e0e508c1f5db56c39d655266d3393bf4b113"], "user": "pchevrel@mozilla.com"}, "1664": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325767\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config-icons.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "eaa3235af920ed9e375a8618b5fba216bebebaf6", "git_parents": ["f617e0e508c1f5db56c39d655266d3393bf4b113"], "node": "dd321b3d431d33e9e0aab63da5035376072fc128", "parents": ["c5741c4f0f631d09ccba4a0a30206c98c498dd1e"], "tags": []}], "date": 1789376711, "git_changesets": ["eaa3235af920ed9e375a8618b5fba216bebebaf6"], "user": "pchevrel@mozilla.com"}, "1665": {"changesets": [{"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065397 - Add bounds check hardening to _cairo_array_index,  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320349\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324985\n", "files": ["gfx/cairo/cairo/src/cairo-array.c", "gfx/cairo/patches/0050-Bug-2065397-array-bounds-check.patch"], "git_node": "cdde4251e4373a53424e6cfe5762e37a848afd4c", "git_parents": ["eaa3235af920ed9e375a8618b5fba216bebebaf6"], "node": "0a1740c57e8249f7e85012044c68f69df6d4017f", "parents": ["dd321b3d431d33e9e0aab63da5035376072fc128"], "tags": []}], "date": 1789378938, "git_changesets": ["cdde4251e4373a53424e6cfe5762e37a848afd4c"], "user": "pchevrel@mozilla.com"}, "1666": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057690 - Add Wikipedia search for Sardinian.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325855\n", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_wikipedia.js"], "git_node": "e266cbe2ca98968ed92429f7f1edc65f0e01a820", "git_parents": ["cdde4251e4373a53424e6cfe5762e37a848afd4c"], "node": "e61bde8506bbe040c9c2968c26a9ef7bb346946c", "parents": ["0a1740c57e8249f7e85012044c68f69df6d4017f"], "tags": []}], "date": 1789389446, "git_changesets": ["e266cbe2ca98968ed92429f7f1edc65f0e01a820"], "user": "pchevrel@mozilla.com"}, "1667": {"changesets": [{"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070972 - Repeat the loopback video test frame with imagefreeze  a=pascalc DONTBUILD\n\nUse the current v4l2loopback control IDs. Repeat one green frame with GStreamer imagefreeze so the producer continues to supply frames while tests open and close the video device. The existing cleanup stops the producer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325488\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325882\n", "files": ["testing/mochitest/runtests.py"], "git_node": "8a81092a3cc41ff58a9105b247922480907aecf3", "git_parents": ["e266cbe2ca98968ed92429f7f1edc65f0e01a820"], "node": "c3974fe8563590fab701556252ba5b8b5fa27174", "parents": ["e61bde8506bbe040c9c2968c26a9ef7bb346946c"], "tags": []}], "date": 1789466573, "git_changesets": ["8a81092a3cc41ff58a9105b247922480907aecf3"], "user": "pchevrel@mozilla.com"}, "1668": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070871 - Reuse the pending MLS fallback when PortalLocationProvider::Watch is called again.  a=pascalc DONTBUILD\n\nWatch() runs for every new geolocation request while the provider stays\nstarted. While the portal has not delivered a position yet, each call\nreplaced the MLSFallback without shutting the previous one down, so its\nNetworkGeolocationProvider stayed alive with its repeating timer and wifi\nlistener for the rest of the session.\n\nReuse the existing fallback instead, and add a gtest that counts the armed\nfallback timers across repeated Watch() calls.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324916\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325762\n", "files": ["dom/system/linux/PortalLocationProvider.cpp", "dom/system/linux/gtest/TestPortalLocationProvider.cpp", "dom/system/linux/gtest/moz.build", "dom/system/linux/moz.build"], "git_node": "25cb49291ed737992ee12ac3155671a186bc4c28", "git_parents": ["8a81092a3cc41ff58a9105b247922480907aecf3"], "node": "130d5b0c6d3cb059e7869b4016c2fe7b9690be6b", "parents": ["c3974fe8563590fab701556252ba5b8b5fa27174"], "tags": []}], "date": 1789466862, "git_changesets": ["25cb49291ed737992ee12ac3155671a186bc4c28"], "user": "pchevrel@mozilla.com"}, "1669": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 574c275bcf5b4f86198c979b7e61f4a844aba0ea with FIREFOX_156_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a6a1643cd538c0aaf72605fca18e345eafd92b2a", "git_parents": ["f098aef4c97c1668ff4a0b905d476080ae4155c5"], "node": "ac7a7a344e02abffdecddd8faf123ad7797dd4fc", "parents": ["6af5d3cadd3539586005cab84edd374df7c673af"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 574c275bcf5b4f86198c979b7e61f4a844aba0ea with FIREFOX-ANDROID_156_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4441006d589a74d35e9a38b52223afe66dab91ea", "git_parents": ["a6a1643cd538c0aaf72605fca18e345eafd92b2a"], "node": "51b61aad3789021b69fc128c4bdc677c72c3e314", "parents": ["ac7a7a344e02abffdecddd8faf123ad7797dd4fc"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 574c275bcf5b4f86198c979b7e61f4a844aba0ea with DEVEDITION_156_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0f96f6a2f64c336825159f2ec3a4881348e28839", "git_parents": ["4441006d589a74d35e9a38b52223afe66dab91ea"], "node": "925c967270221b18863aca3fbeb25679e7763e2c", "parents": ["51b61aad3789021b69fc128c4bdc677c72c3e314"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-un