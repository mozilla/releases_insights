mozilla.com\u003e", "branch": "default", "desc": "Bug 2058035 - Ensure consistent block and offset,  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335606\n", "files": ["gfx/thebes/SharedFontList.cpp", "gfx/thebes/SharedFontList.h"], "git_node": "fdb9f19913e638c1ffbd7b3f18cdd154244363a8", "git_parents": ["f992add3d9b57effff4c6a451893c25dcbe430e7"], "node": "db902b733dfc1af2ead943b31cd8993292be9808", "parents": ["0ad88c3268e3c4723d07b7ec11c5fa5db7c47bea"], "tags": []}], "date": 1793361844, "git_changesets": ["fdb9f19913e638c1ffbd7b3f18cdd154244363a8"], "user": "dmeehan@mozilla.com"}, "1789": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086254 - Set cancel content JS Epoch only when BrowserChild exists  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337606\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337874\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "4b4aee90d0987b2eaae942b9c88453d41d3d12d4", "git_parents": ["fdb9f19913e638c1ffbd7b3f18cdd154244363a8"], "node": "43ef71d90a53872b0e85e3fbd21cbc7f59c13649", "parents": ["db902b733dfc1af2ead943b31cd8993292be9808"], "tags": []}], "date": 1793361865, "git_changesets": ["4b4aee90d0987b2eaae942b9c88453d41d3d12d4"], "user": "dmeehan@mozilla.com"}, "1790": {"changesets": [{"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086675: Unset fixed containing blocks explicitly for repeating table headers only.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337717\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337979\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-position/crashtests/top-layer-dialog-crash.html"], "git_node": "9f2b19765b1d739673bcacfa77a1dfa0f5b3c8d6", "git_parents": ["4b4aee90d0987b2eaae942b9c88453d41d3d12d4"], "node": "b284d4f64e77740bda269f842ed65364a2d90fcc", "parents": ["43ef71d90a53872b0e85e3fbd21cbc7f59c13649"], "tags": []}], "date": 1793361937, "git_changesets": ["9f2b19765b1d739673bcacfa77a1dfa0f5b3c8d6"], "user": "dmeehan@mozilla.com"}, "1791": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2084673 - Simplify mojo dead proxy handling,  a=dmeehan DONTBUILD\n\nPreviously, the mojo ports backend used a generic \"broadcast\" mechanism\nwhich was only ever used to broadcast a specific `ObserveProxy` message\nto signal a dead proxy. This specific message had special handling in\nevery place it was used within the ports code.\n\nThis makes the single use of the broadcast mechanism more explicit, by\nexplicitly limiting it to only support sending a `DeadProxy` message,\nand removing broadcast support from generic events.\n\nThis also fixes a minor bug in proxy handling where the broker process\nwould never be delivered the dead proxy notification itself, and the\nsending process would handle the dead proxy notification multiple times.\n\nChromium no longer uses this ports code upstream, so this divergence is\nnot an uplift concern. We are now the sole maintainers of this logic.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337281\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337737\n", "files": ["ipc/chromium/gtest/ports_unittest.cc", "ipc/chromium/src/mojo/core/ports/event.cc", "ipc/chromium/src/mojo/core/ports/event.h", "ipc/chromium/src/mojo/core/ports/node.cc", "ipc/chromium/src/mojo/core/ports/node.h", "ipc/chromium/src/mojo/core/ports/node_delegate.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/NodeController.cpp", "ipc/glue/NodeController.h", "ipc/glue/ProtocolUtils.h", "ipc/ipdl/ipdl.py"], "git_node": "012f2617eef0f668e116b4fa1e575561c00d8a39", "git_parents": ["9f2b19765b1d739673bcacfa77a1dfa0f5b3c8d6"], "node": "117002513edbecd47aef85c97454c3039c28dc34", "parents": ["b284d4f64e77740bda269f842ed65364a2d90fcc"], "tags": []}], "date": 1793361958, "git_changesets": ["012f2617eef0f668e116b4fa1e575561c00d8a39"], "user": "dmeehan@mozilla.com"}, "1792": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2083629 - Pop the change index before performing block I/O in FileBlockCache.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336984\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337789\n", "files": ["dom/media/FileBlockCache.cpp"], "git_node": "01deb587f1890ecaad7a452ad95869d26963ed1c", "git_parents": ["012f2617eef0f668e116b4fa1e575561c00d8a39"], "node": "a0d6b70496830973653c794446a37a34911c2b4c", "parents": ["117002513edbecd47aef85c97454c3039c28dc34"], "tags": []}], "date": 1793362399, "git_changesets": ["01deb587f1890ecaad7a452ad95869d26963ed1c"], "user": "dmeehan@mozilla.com"}, "1793": {"changesets": [{"author": "Jes\u00fas Legan\u00e9s-Combarro (piranna) \u003cpiranna@gmail.com\u003e", "branch": "default", "desc": "Bug 2065515 - Add option to DeviceInfo::GetDeviceName() identifying a placeholder device (Cherry-pick Bug 1844020) r=mjf a=dmeehan\n\nAdds a new parameter \"deviceIsPlaceholder\" that will be set to true in\ncase the returned device is not a real device but a placeholder that is\njust used to inform about camera device existence.\n\nSource Differential: https://phabricator.services.mozilla.com/D189929\nDetailed-Range-First: f7484c082d63f800dde4a5c50fed1dbe0a3ad1c2\nDetailed-Range-Last: f7484c082d63f800dde4a5c50fed1dbe0a3ad1c2\nDetailed-Commit-Count: 1\nDetailed-Stack-Head: e3e1e43c851cfae15889097ed9674be08a93a625\nDetailed-Endpoint-Tree: 1da3f1d67eb33107925a8cc773b4d1b4c32e0b03\nSource-Orders-First: 0.1\nSource-Orders-Last: 0.1\nSource-Bug: 1844020\nCondensation-Plan-SHA256: 69539955ba352d719b129ce8096019ffff9c99f3b6ccfbd13454d18602453db7\nDetailed-Source-Commit: f7484c082d63f800dde4a