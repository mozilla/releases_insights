a37529cfed6f662eca9935551e0bef", "parents": ["e54ee172d3ddbb1baef640c3f7def84277be2d75"], "tags": []}], "date": 1751306866, "git_changesets": ["7a6a15ffaa236348879af3a8d10a8dad90df933f"], "user": "dsmith@mozilla.com"}, "577": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1973990 - Do not reorder the state transition for async generator yield.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255429\n", "files": ["js/src/vm/AsyncIteration.cpp"], "git_node": "a941d83faeecf1a59e5234a01622ffc3501f9fab", "git_parents": ["7a6a15ffaa236348879af3a8d10a8dad90df933f"], "node": "7bd1c6b763a2944873579523666acc0d2e23acd5", "parents": ["6c89200010a37529cfed6f662eca9935551e0bef"], "tags": []}], "date": 1751536781, "git_changesets": ["a941d83faeecf1a59e5234a01622ffc3501f9fab"], "user": "pchevrel@mozilla.com"}, "578": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255949\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "2e84b98ca6ca21cc0ab504891dbb8ea62d9f0360", "git_parents": ["a941d83faeecf1a59e5234a01622ffc3501f9fab"], "node": "6124742fcaa8e7e77dfa9e1d1c9c02d35dcf5a58", "parents": ["7bd1c6b763a2944873579523666acc0d2e23acd5"], "tags": []}], "date": 1751547229, "git_changesets": ["2e84b98ca6ca21cc0ab504891dbb8ea62d9f0360"], "user": "pchevrel@mozilla.com"}, "579": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970402 - [esr115] Fix adjusted-size initialization in gfxGDIFont. r=#gfx-reviewers a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253819\n", "files": ["gfx/thebes/gfxGDIFont.cpp"], "git_node": "cec3a89d37a8e21ffd4c02cf49fd07ebe13536a8", "git_parents": ["2e84b98ca6ca21cc0ab504891dbb8ea62d9f0360"], "node": "6532a3219f8c5432a583798fb98fe653814404f1", "parents": ["6124742fcaa8e7e77dfa9e1d1c9c02d35dcf5a58"], "tags": []}], "date": 1751651514, "git_changesets": ["cec3a89d37a8e21ffd4c02cf49fd07ebe13536a8"], "user": "pchevrel@mozilla.com"}, "580": {"changesets": [{"author": "William Durand \u003cwill+git@drnd.me\u003e", "branch": "default", "desc": "Bug 1942328 - Add www.firefox.com to UITour allow-list permissions. r=emz a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235334\n", "files": ["browser/app/permissions"], "git_node": "539158ffd4bd445d84fa9921f2e7df901d9c15af", "git_parents": ["cec3a89d37a8e21ffd4c02cf49fd07ebe13536a8"], "node": "9ab80bf7544b0dd0d89ba90068c4b6675e759c99", "parents": ["6532a3219f8c5432a583798fb98fe653814404f1"], "tags": []}], "date": 1751651934, "git_changesets": ["539158ffd4bd445d84fa9921f2e7df901d9c15af"], "user": "pchevrel@mozilla.com"}, "581": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1959052 - Ensure JS execution is blocked during window.print() when we're using the system UI (rather than printing via the Firefox preview panel).  a=pascalc\n\nThe patch in bug 1898184 made reasonable sense, inasmuch as when the\nprint.prefer_system_dialog option is set, we don't show our window-modal\npreview panel.\n\nHowever, as noted in comment 6 here, we do still need to block JS while\nwindow.print() is presenting the system dialog, otherwise the document\nmay be changed or even closed by script behind the dialog's back. Prior\nto bug 1898184, the IsPreview::Yes flag caused us to block, but the issue\nwas that without the preview panel taking care of cleaning up the cloned\ndocument, the block got cleared.\n\nIt looks like we can solve this by setting the closeWindowAfterPrint\nflag in this case. In local testing, this seems to work for the various\nexamples here, and does not regress bug 1898184.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253655\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253945\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js"], "git_node": "87f4420abaf74dd6a9a2a642e1b521e4c8cfd17d", "git_parents": ["539158ffd4bd445d84fa9921f2e7df901d9c15af"], "node": "bb8a1fc0a62cfc5f1425d59a7f40abbd9701fabc", "parents": ["9ab80bf7544b0dd0d89ba90068c4b6675e759c99"], "tags": []}], "date": 1751661753, "git_changesets": ["87f4420abaf74dd6a9a2a642e1b521e4c8cfd17d"], "user": "pchevrel@mozilla.com"}, "582": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256260\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/translations-models.json"], "git_node": "20ec3eb20baac1be735b67571a23915608e50715", "git_parents": ["87f4420abaf74dd6a9a2a642e1b521e4c8cfd17d"], "node": "4916949fafa589ce14320ec396ddfc147ace1c3f", "parents": ["bb8a1fc0a62cfc5f1425d59a7f40abbd9701fabc"], "tags": []}], "date": 1751891899, "git_changesets": ["20ec3eb20baac1be735b67571a23915608e50715"], "user": "pchevrel@mozilla.com"}, "583": {"changesets": [{"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1968414 - [devtools] Escape carriage return character properly r=devtools-reviewers,nchevobbe a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254323\