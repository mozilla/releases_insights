ium, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D73178", "files": ["browser/config/tooltool-manifests/win32/build-clang-cl.manifest", "build/build-clang/build-clang.py", "build/build-clang/clang-4.0-linux64.json", "build/build-clang/clang-7-linux64.json", "build/build-clang/clang-8-android.json", "build/build-clang/clang-8-linux64-aarch64-cross.json", "build/build-clang/clang-8-linux64.json", "build/build-clang/clang-8-macosx64.json", "build/build-clang/clang-8-mingw.json", "build/build-clang/clang-tidy-8.patch", "build/build-clang/clang-tidy-linux64.json", "build/build-clang/clang-tidy-macosx64.json", "build/build-clang/clang-tidy-win64.json", "build/build-clang/clang-win64.json", "build/clang-plugin/import_mozilla_checks.py", "taskcluster/scripts/misc/build-clang-8-mingw.sh", "taskcluster/scripts/misc/build-clang-windows-helper64.sh"], "git_node": null, "git_parents": [null], "node": "d1267d72cc18fe6b5c76fe4b19456383683b9099", "parents": ["43f042af22eeaefb28faa4b062354b379725bc23"], "tags": []}], "date": 1588623746, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1019": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 416007f3bb6c5a70edb59449e5c8fa4e25b318a9 with FENNEC_68_8_0_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "ed1388b92de375a506a3521ebbeb9d32d2182fac", "parents": ["d1267d72cc18fe6b5c76fe4b19456383683b9099"], "tags": []}], "date": 1588683274, "git_changesets": [null], "user": "ffxbld"}, "1020": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 416007f3bb6c5a70edb59449e5c8fa4e25b318a9 with FIREFOX_68_8_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "a18bd6dfccab6e49eff7f57a2b1b383b1633795f", "parents": ["ed1388b92de375a506a3521ebbeb9d32d2182fac"], "tags": []}], "date": 1588683360, "git_changesets": [null], "user": "ffxbld"}, "1021": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74237", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "a29650b48b757633652ea1503569aa2c6a17aa6a", "parents": ["a18bd6dfccab6e49eff7f57a2b1b383b1633795f"], "tags": []}], "date": 1588866884, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1022": {"changesets": [{"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1633568 - AdjustHelper can inform more listeners about Attribution changes\n\n\nTelemetryCorePingDelegate was already a listener for AdjustAttribution campaign\nchanges.\nThe new \"installation\" ping also needs all data about the AdjustAttribution\nwhen it changes.\nTo keep a simple API AdjustHelper will now be able to inform more listeners\nabout Attribution changes and will send the entire object, each callback being\nresponsible to extract the data it needs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74072", "files": ["mobile/android/base/java/org/mozilla/gecko/adjust/AdjustBrowserAppDelegate.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelperInterface.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AttributionHelperListener.java", "mobile/android/base/java/org/mozilla/gecko/adjust/StubAdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryCorePingDelegate.java"], "git_node": null, "git_parents": [null], "node": "31b72a62024acd31a682b05dececc5f828e35137", "parents": ["a29650b48b757633652ea1503569aa2c6a17aa6a"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1633568 - Introduce a installation ping\n\n\nThis mobile-specific ping is intended to keep track of installs and Adjust\nattribution.\n\nThe app should send two installation pings, based on different reasons:\nOne sent immediately after the app starts.\nOne sent immediately after the Adjust attribution data becomes available.\n\nIf the app is later deleted and installed again, the installation pings must be\nsent again.\n\nThis will will be a modern ping, sent to\nhostname/submit/mobile/docType/appVersion/docId.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74073", "files": ["mobile/android/base/java/org/mozilla/gecko/BrowserApp.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryInstallationPingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryInstallationPingBuilder.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/stores/TelemetryInstallationPingStore.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/stores/TelemetryJSONFilePingStore.java"], "git_node": null, "git_parents": [null], "node": "fe76f80393ad6e72b00cd574acb31330d812907c", "parents": ["31b72a62024acd31a682b05dececc5f828e35137"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1633568 - Document the installation ping a=RyanVM-for-testing\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74075", "files": ["toolkit/components/telemetry/docs/data/installation-ping.rst"], "git_node": null, "git_parents": [null], "node": "fc35d7e69e4458edc478c2ec6cc1241e77fe5d63", "parents": ["fe76f80393ad6e72b00cd574acb31330d812907c"], "tags": []}], "date": 1588955732, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "1023": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out 3 changesets (bug 1633568) DONTBUILD\n\nBacked out changeset fc35d7e69e44 (bug 1633568)\nBacked out changeset fe76f80393ad (bug 1633568)\nBacked out changeset 31b72a62024a (bug 1633568)", "files": ["mobile/android/base/java/org/mozilla/gecko/BrowserApp.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustBrowserAppDelegate.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelperInterface.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AttributionHelperListener.java", "mobile/android/base/java/org/mozilla/gecko/adjust/StubAdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryCorePingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryInstallationPingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryInstallationPingBuilder.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/stores/TelemetryInstallationPingStore.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/stores/TelemetryJSONFilePingStore.java", "toolkit/components/telemetry/docs/data/installation-ping.rst"], "git_node": null, "git_parents": [null], "node": "1d4398562b29e2cdb64fcadb3704d8caade7cf4d", "parents": ["fc35d7e69e4458edc478c2ec6cc1241e77fe5d63"], "tags": []}], "date": 1588955854, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1024": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74665", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadLis