t_changesets": [null, null, null, null, null], "user": "jcristau@mozilla.com"}, "1027": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D75308", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "072e2cdf6db14b0f5014f85a12a650e1675898db", "parents": ["8d41cf7c34399c8febbfe46b7e689d247b5dffb8"], "tags": []}], "date": 1589466020, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1028": {"changesets": [{"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1633568 - AdjustHelper can inform more listeners about Attribution changes. r=Grisha, a=RyanVM\n\nTelemetryCorePingDelegate was already a listener for AdjustAttribution campaign\nchanges.\nThe new \"installation\" ping also needs all data about the AdjustAttribution\nwhen it changes.\nTo keep a simple API AdjustHelper will now be able to inform more listeners\nabout Attribution changes and will send the entire object, each callback being\nresponsible to extract the data it needs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74072", "files": ["mobile/android/base/java/org/mozilla/gecko/adjust/AdjustBrowserAppDelegate.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelperInterface.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AttributionHelperListener.java", "mobile/android/base/java/org/mozilla/gecko/adjust/StubAdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryCorePingDelegate.java"], "git_node": null, "git_parents": [null], "node": "1c92814b83dd5717a61109202514ce3c0d48d4f1", "parents": ["072e2cdf6db14b0f5014f85a12a650e1675898db"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1633568 - Introduce a installation ping. r=Grisha, a=RyanVM\n\nThis mobile-specific ping is intended to keep track of installs and Adjust\nattribution.\n\nThe app should send two installation pings, based on different reasons:\nOne sent immediately after the app starts.\nOne sent immediately after the Adjust attribution data becomes available.\n\nIf the app is later deleted and installed again, the installation pings must be\nsent again.\n\nThis will will be a modern ping, sent to\nhostname/submit/mobile/docType/appVersion/docId.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74073", "files": ["mobile/android/base/java/org/mozilla/gecko/BrowserApp.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryInstallationPingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryInstallationPingBuilder.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/stores/TelemetryInstallationPingStore.java"], "git_node": null, "git_parents": [null], "node": "b8222f07b0c2bb635353a2b8146f1c4ad4d1cbcb", "parents": ["1c92814b83dd5717a61109202514ce3c0d48d4f1"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1633568 - Document the installation ping. r=frank, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74075", "files": ["toolkit/components/telemetry/docs/data/installation-ping.rst"], "git_node": null, "git_parents": [null], "node": "ae094433b55defdcd5a0ebeb52f197f42d1a92b6", "parents": ["b8222f07b0c2bb635353a2b8146f1c4ad4d1cbcb"], "tags": []}], "date": 1589480720, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "1029": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1628871 - followup: fix test for esr68. a=bustage-fix\n\nDifferential Revision: https://phabricator.services.mozilla.com/D75347", "files": ["browser/base/content/test/plugins/browser_enable_DRM_prompt.js"], "git_node": null, "git_parents": [null], "node": "77897237c7a870f6bc754e0a57742391504e4b89", "parents": ["ae094433b55defdcd5a0ebeb52f197f42d1a92b6"], "tags": []}], "date": 1589480923, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "1030": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_68_8_X_RELBRANCH", "desc": "Bump version number to 68.8.1. a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/config/version-files/release/version.txt", "mobile/android/config/version-files/release/version_display.txt"], "git_node": null, "git_parents": [null], "node": "69e50e5c237c15870488c54ce0be7814b3f74c18", "parents": ["115e575532fb2f77b504bc5aa517d13b34d7530f"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "FIREFOX_ESR_68_8_X_RELBRANCH", "desc": "Bug 1633568 - AdjustHelper can inform more listeners about Attribution changes. r=Grisha, a=RyanVM\n\nTelemetryCorePingDelegate was already a listener for AdjustAttribution campaign\nchanges.\nThe new \"installation\" ping also needs all data about the AdjustAttribution\nwhen it changes.\nTo keep a simple API AdjustHelper will now be able to inform more listeners\nabout Attribution changes and will send the entire object, each callback being\nresponsible to extract the data it needs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74072", "files": ["mobile/android/base/java/org/mozilla/gecko/adjust/AdjustBrowserAppDelegate.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelperInterface.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AttributionHelperListener.java", "mobile/android/base/java/org/mozilla/gecko/adjust/StubAdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryCorePingDelegate.java"], "git_node": null, "git_parents": [null], "node": "9c08bb26d3af807efc3f1d80c067a0d3c7a2f57b", "parents": ["69e50e5c237c15870488c54ce0be7814b3f74c18"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "FIREFOX_ESR_68_8_X_RELBRANCH", "desc": "Bug 1633568 - Introduce a installation ping. r=Grisha, a=RyanVM\n\nThis mobile-specific ping is intended to keep track of installs and Adjust\nattribution.\n\nThe app should send two installation pings, based on different reasons:\nOne sent immediately after the app starts.\nOne sent immediately after the Adjust attribution data becomes available.\n\nIf the app is later deleted and installed again, the installation pings must be\nsent again.\n\nThis will will be a modern ping, sent to\nhostname/submit/mobile/docType/appVersion/docId.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74073", "files": ["mobile/android/base/java/org/mozilla/gecko/BrowserApp.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryInstallationPingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryInstallationPingBuilder.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/stores/TelemetryInstallationPingStore.java"], "git_node": null, "git_parents": [null], "node": "779dee1241adec18384fa1ff2c7d8ed297cc8b85", "parents": ["9c08bb26d3af807efc3f1d80c067a0d3c7a2f57b"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "FIREFOX_ESR_68_8_X_RELBRANCH", "desc": "Bug 1633568 - Document the installation ping. r=frank, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74075", "files": ["toolkit/components/telemetry/docs/data/installation-ping.rst"], "git_node": null, "git_parents": [null], "node": "fc5a91e400243cc2c2c6a6ecc0d211be26a9662b", "parents": ["779dee1241adec18384fa1ff2c7d8ed297cc8b85"], "tags": ["FENNEC_68_8_1_BUILD1", "FENNEC_68_8_1_RELEASE"]}], "date": 1589486026, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "1031": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging fc5a91e400243cc2c2c6a6ecc0d211be26a9662b with FENNEC_68_8_1_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "6863f516ba386cfadfd2f60ac45411dc7a0850cf", "parents": ["77897237c7a870f6bc754e0a57742391504e4b89"], "tags": []}], "date": 1589501783, "git_changesets": [null], "user": "ffxbld"}, "1032": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging fc5a91e400243cc2c2c6a6ecc0d211be26a9662b with FENNEC_68_8_1_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "df2af1437f899361e95b76766fac5a0b4a30a65c", "parents": ["6863f516ba386cfadfd2f60ac45411dc7a0850cf"], "tags": []}], "date": 1589813216, "git_changesets": [null], "user": "ffxbld"}, "1033": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D75794", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "3edcf381faf75d85bf9d20648e83b978bed85bfe", "parents": ["df2af1437f899361e95b76766fac5a0b4a30a65c"], "tags": []}], "date": 1589826543, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1034": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1560700 - Change how the rust target is derived from the build system target. r=froydnj, a=jcristau\n\nThere are a few problems with the strategy currently used to find the\nrust target. For example, we don't find a target for arm freebsd, and we\npick the wrong target for armel linux. Both are related to how things\ncurrently work when multiple targets have the same (cpu, endianness,\nos).\n\nSo, to derive the rust target, we now use a more fine-grained approach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41481", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": null, "git_parents": [null], "node": "ff374d37b61a3ce19841496a6ee59a23ebc56bc0", "parents": ["3edcf381faf75d85bf9d20648e83b978bed85bfe"], "tags": []}, {"author": "Chris Manchester \u003ccmanchester@mozilla.com\u003e", "branch": "default", "desc": "Bug 1587913 - Fix rust target detection for rustc 1.38. r=firefox-build-system-reviewers,glandium, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48996", "files": ["build/moz.configure/init.configure", "build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": null, "git_parents": [null], "node": "e422e27f3e927e7f3d0ea274c6904fbc7da0f77a", "parents": ["ff374d37b61a3ce19841496a6ee59a23ebc56bc0"], "tags": []}, {"author": "Chris Manchester \u003ccmanchester@mozilla.com\u003e", "branch": "default", "desc": "Bug 1595218 - Update rust target detection for rustc 1.39. r=glandium, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D53901", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": null, "git_parents": [null], "node": "22b959bfc4953156d396ca6c4c7fb79b193a72e6", "parents": ["e422e27f3e927e7f3d0ea274c6904fbc7da0f77a"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1631618 - Make SharedWorkerService be alive until shutdown r=dom-workers-and-storage-reviewers,asuth, a=pascalc\n\nUsing StaticRefPtr instead of a raw pointer for sSharedWorkerService in SharedWorkerService.cpp, and keeping sSharedWorkerService be alive until shutdown by registering sSharedWorkerService to ClearOnShutdown.\n\nSince sSharedWorkerService is not raw pointer anymore, SharedWorkerService needs not to inherit from SupportsCheckedUnsafePtr\u003cCheckIf\u003cDiagnosticAssertEnabled\u003e\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72379", "files": ["dom/workers/sharedworkers/SharedWorkerService.cpp", "dom/workers/sharedworkers/SharedWorkerService.h"], "git_node": null, "git_parents": [null], "node": "dcfa7eaa9049f6c177fa4f171b48eca7c44089a3", "parents": ["22b959bfc4953156d396ca6c4c7fb79b193a72e6"], "tags": []}], "date": 1589898478, "git_changesets": [null, null, null, null], "user": "jcristau@mozilla.com"}, "1035": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Backed out 1 changesets (bug 1631618) for build bustage. a=backout\n\nBacked out changeset dcfa7eaa9049 (bug 1631618)", "files": ["dom/workers/sharedworkers/SharedWorkerService.cpp", "dom/workers/sharedworkers/SharedWorkerService.h"], "git_node": null, "git_parents": [null], "node": "53e86f11003d7b8048c84d166b9b6a3beb9826c8", "parents": ["dcfa7eaa9049f6c177fa4f171b48eca7c44089a3"], "tags": []}], "date": 1589901669, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "1036": {"changesets": [{"author": "Wander Lairson Costa \u003cwander.lairson@gmail.com\u003e", "branch": "default", "desc": "Bug 1635877: move all android-em tests to AWS baremetal r=gbrown a=test-only\n\nThis is a rebased version of\nhttps://hg.mozilla.org/mozilla-central/rev/4d9ef53c1141\nhttps://hg.mozilla.org/mozilla-central/rev/0d45875628da\nhttps://hg.mozilla.org/mozilla-central/rev/7a7ab7873659\non mozilla-esr68.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D76060", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/transforms/tests.py", "taskcluster/taskgraph/util/workertypes.py"], "git_node": null, "git_parents": [null], "node": "ee7ed57e1b2820b98052604bed86235164415657", "parents": ["53e86f11003d7b8048c84d166b9b6a3beb9826c8"], "tags": []}, {"author": "Wander Lairson Costa \u003cwander.lairson@gmail.com\u003e", "branch": "default", "desc": "Bug 1637000: Increase the maximum runtime for xpcshell in android emulator r=gbrown a=test-only\n\nSince we now run those tests in baremetal (which runs more parallel jobs\nthan packet.net), the variance of the time it takes to execute xpcshell\ntests increased.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74703", "files": ["taskcluster/ci/test/xpcshell.yml"], "git_node": null, "git_parents": [null], "node": "752b9e8ebe850de7a6737c05aa0f3403372a6866", "parents": ["ee7ed57e1b2820b98052604bed86235164415657"], "tags": []}], "date": 1589992997, "git_changesets": [null, null], "user": "mozilla@hocat.ca"}, "1037": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D76326", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "d68cf3ff99f841299cd2703ca58bc198815ed318", "parents": ["752b9e8ebe850de7a6737c05aa0f3403372a6866"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1469629 - Read system level policies on Linux if available. r=stransky a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74323", "files": ["toolkit/components/enterprisepolicies/EnterprisePolicies.js"], "git_node": null, "git_parents": [null], "node": "203a8c227a997c4ae7e970d0ec497d7292078d5c", "parents": ["d68cf3ff99f841299cd2703ca58bc198815ed318"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1635240 - Add policy for using SSO in private browsing. r=mconley a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74112", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "1b0a29b456b432d1c8bef09c233b84205ec9e13c", "parents": ["203a8c227a997c4ae7e970d0ec497d7292078d5c"], "tags": []}, {"author": "J.C. Jones \u003cjc@mozila.com\u003e", "branch": "default", "desc": "Bug 1632908 - land NSS NSS_3_44_4_RTM UPGRADE_NSS_RELEASE, r=kjacobs a=RyanVM\n\n\n2020-05-19  J.C. Jones  \u003cjjones@mozilla.com\u003e\n\n\t* lib/nss/nss.h, lib/softoken/softkver.h, lib/util/nssutil.h:\n\tSet version numbers to 3.44.4 final\n\t[be8b38f87121] [NSS_3_44_4_RTM] \u003cNSS_3_44_BRANCH\u003e\n\n2020-04-23  Robert Relyea  \u003crrelyea@redhat.com\u003e\n\n\t* lib/freebl/dsa.c:\n\tBug 1631576 - Force a fixed length for DSA exponentiation\n\tr=pereida,bbrumley\n\n\t[48612468b52f] \u003cNSS_3_44_BRANCH\u003e\n\n2020-01-13  Kevin Jacobs  \u003ckjacobs@mozilla.com\u003e\n\n\t* automation/taskcluster/windows/build_gyp.sh:\n\tBug 1608895 - Install setuptools\u003c45.0.0 until workers are upgraded\n\tto python3 r=jcj\n\n\t[[ https://setuptools.readthedocs.io/en/latest/history.html#v45-0-0\n\t| Setuptools 45.0.0 ]] drops support for Python2, which our Windows\n\tworkers are running.\n\n\tThis patch installs the prior version during build, in order to\n\tunblock CI until the workers can be upgraded.\n\n\t[42186bde9062] \u003cNSS_3_44_BRANCH\u003e\n\n2019-11-19  J.C. Jones  \u003cjjones@mozilla.com\u003e\n\n\t* .hgtags:\n\tAdded tag NSS_3_44_3_RTM for changeset d871fc63531d\n\t[b6910cab5f1e] \u003cNSS_3_44_BRANCH\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D76065", "files": ["old-configure.in", "security/nss/TAG-INFO", "security/nss/automation/taskcluster/windows/build_gyp.sh", "security/nss/coreconf/coreconf.dep", "security/nss/lib/freebl/dsa.c", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "555ae5322bbbc633c9ce24b1b2681657675bd3d1", "parents": ["1b0a29b456b432d1c8bef09c233b84205ec9e13c"], "tags": []}], "date": 1590110085, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "1038": {"changesets": [{"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639224 - Verify signature if local timestamp is in the future. r=Gijs, a=dveditz", "files": ["services/settings/RemoteSettingsClient.jsm", "services/settings/test/unit/test_remote_settings.js"], "git_node": null, "git_parents": [null], "node": "c36bb4f2f5e5003ab4df862bd50368180aed0598", "parents": ["555ae5322bbbc633c9ce24b1b2681657675bd3d1"], "tags": []}], "date": 1590356655, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "1039": {"changesets": [{"author": "Dorel Luca \u003cdluca@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset c36bb4f2f5e5 (bug 1639224) for XPCShell failures in services/common/tests/unit/test_blocklist_onecrl.js. a=backout", "files": ["services/settings/RemoteSettingsClient.jsm", "services/settings/test/unit/test_remote_settings.js"], "git_node": null, "git_parents": [null], "node": "07f7d20b2c15a16e40fa809c69367611218595bd", "parents": ["c36bb4f2f5e5003ab4df862bd50368180aed0598"], "tags": []}], "date": 1590364284, "git_changesets": [null], "user": "dluca@mozilla.com"}, "1040": {"changesets": [{"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639224 - Verify signature if local timestamp is in the future. r=Gijs, a=dveditz", "files": ["services/common/tests/unit/test_blocklist_onecrl.js", "services/settings/RemoteSettingsClient.jsm", "services/settings/test/unit/test_remote_settings.js"], "git_node": null, "git_parents": [null], "node": "ef12da9a0188c3cf3dff85544e49ee601fcad37d", "parents": ["07f7d20b2c15a16e40fa809c69367611218595bd"], "tags": []}], "date": 1590414296, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "1041": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Backed out changeset ef12da9a0188 (bug 1639224) for failing xpcshell's services/common/tests/unit/test_blocklist_pinning.js. a=backout", "files": ["services/common/tests/unit/test_blocklist_onecrl.js", "services/settings/RemoteSettingsClient.jsm", "services/settings/test/unit/test_remote_settings.js"], "git_node": null, "git_parents": [null], "node": "e464a2ba6a78c85ec57eac5caa9e82b6edfd437e", "parents": ["ef12da9a0188c3cf3dff85544e49ee601fcad37d"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639224 - Verify signature if local timestamp is in the future. r=Gijs a=dveditz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D76714", "files": ["services/common/tests/unit/test_blocklist_onecrl.js", "services/common/tests/unit/test_blocklist_pinning.js", "services/settings/RemoteSettingsClient.jsm", "services/settings/test/unit/test_remote_settings.js"], "git_node": null, "git_parents": [null], "node": "225cd08daf7d8c774ddce0f8ab2956adedf93444", "parents": ["e464a2ba6a78c85ec57eac5caa9e82b6edfd437e"], "tags": []}], "date": 1590421413, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "1042": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639590: Finish removing unboxed objects code. r=mgaudet, a=dveditz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D76155", "files": ["js/src/vm/JSObject.cpp"], "git_node": null, "git_parents": [null], "node": "335f6c486ca455444ae6790a52568eae2497704b", "parents": ["225cd08daf7d8c774ddce0f8ab2956adedf93444"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1636576 - Have Leanplum queue events if not started. r=snorp,csadilek a=RyanVM\n\ntrack() would previously check if \"applicationContext != null\" essentially\n hecking if init() was called - if Leanplum was started.\nIt is possible for this static method to be called even before Leanplum start\n(eg: by a BroadcastReceiver like in the case of the Search widget).\n\nWe'll now just check if \"isMmaAllowed\".\nIf it is allowed and enabled we will pass the event to Leanplum which will:\n- send the event right away if it is started\n- queue the event to be sent immediately after being started\n\nDifferential Revision: https://phabricator.services.mozilla.com/D75313", "files": ["mobile/android/base/java/org/mozilla/gecko/mma/MmaDelegate.java"], "git_node": null, "git_parents": [null], "node": "aa761c20030b0992e5dfff769015e8dff7569550", "parents": ["335f6c486ca455444ae6790a52568eae2497704b"], "tags": []}], "date": 1590532003, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "1043": {"changesets": [{"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1641037 - Show an upcoming update promo banner. r=st3fan, a=RyanVM\n\nThis patch re-enables the promo banner added in bug 1603275.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D77002", "files": ["mobile/android/app/src/main/res/values/bool.xml", "mobile/android/base/java/org/mozilla/gecko/activitystream/homepanel/StreamRecyclerAdapter.java"], "git_node": null, "git_parents": [null], "node": "922c778024f323a5042778bc41e1315bb091044f", "parents": ["aa761c20030b0992e5dfff769015e8dff7569550"], "tags": []}], "date": 1590605262, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1044": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1631618 - Make SharedWorkerService be alive until shutdown. r=asuth, a=RyanVM\n\nUsing StaticRefPtr instead of a raw pointer for sSharedWorkerService in SharedWorkerService.cpp, and keeping sSharedWorkerService be alive until shutdown by registering sSharedWorkerService to ClearOnShutdown.\n\nSince sSharedWorkerService is not raw pointer anymore, SharedWorkerService needs not to inherit from SupportsCheckedUnsafePtr\u003cCheckIf\u003cDiagnosticAssertEnabled\u003e\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72379", "files": ["dom/workers/sharedworkers/SharedWorkerService.cpp", "dom/workers/sharedworkers/SharedWorkerService.h"], "git_node": null, "git_parents": [null], "node": "e17129d84f13cc84f3a09d23bcbb005194573e23", "parents": ["922c778024f323a5042778bc41e1315bb091044f"], "tags": ["FENNEC_68_9_0_BUILD1", "FENNEC_68_9_0_RELEASE", "FIREFOX_68_9_0esr_BUILD1", "FIREFOX_68_9_0esr_RELEASE"]}], "date": 1590614082, "git_changesets": [null], "user": "ryanvm@gmail.com"}}
}";