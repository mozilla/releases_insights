314184619ca46a34e"], "tags": []}], "date": 1793034115, "git_changesets": ["b9ec913408c0cc0d5f4fbe3d368dbdc9166696c8"], "user": "dmeehan@mozilla.com"}, "1105": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2070798 - Abort targeting context recording during shutdown  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336203\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_recordTargetingContext.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml"], "git_node": "8a06aefe94ae5ebb8d90b4d36c75a6a54f49044a", "git_parents": ["b9ec913408c0cc0d5f4fbe3d368dbdc9166696c8"], "node": "981a6981f37dba269e4a1e30fa9233159d061dd7", "parents": ["1237773aca25d6b792224bc24945264304207dee"], "tags": []}], "date": 1793034219, "git_changesets": ["8a06aefe94ae5ebb8d90b4d36c75a6a54f49044a"], "user": "dmeehan@mozilla.com"}, "1106": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025386 - Replace per-instance weak memory reporters with a strong singleton.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333536\n", "files": ["dom/file/BlobImpl.h", "dom/file/BlobMemoryReporter.cpp", "dom/file/BlobMemoryReporter.h", "dom/file/StreamBlobImpl.cpp", "dom/file/StreamBlobImpl.h", "dom/file/StringBlobImpl.cpp", "dom/file/StringBlobImpl.h", "dom/file/moz.build"], "git_node": "4ad3128f6ba1ae90cf461b1374c30bcf741f883e", "git_parents": ["8a06aefe94ae5ebb8d90b4d36c75a6a54f49044a"], "node": "4006e5f25b2628e1928369cd0aef19815af42bc8", "parents": ["981a6981f37dba269e4a1e30fa9233159d061dd7"], "tags": []}], "date": 1793034244, "git_changesets": ["4ad3128f6ba1ae90cf461b1374c30bcf741f883e"], "user": "dmeehan@mozilla.com"}, "1107": {"changesets": [{"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1730261 - Mark urlbar clipboard writes as sensitive in private windows  a=dmeehan\n\nPass nsIClipboardHelper.Sensitive when copying from the urlbar in a\nprivate window so downstream consumers (OS clipboard managers, sync,\ncloud clipboard) can skip retention. Applies to both UrlbarInput.mjs\nand the temporarily forked SmartbarInput.mjs.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291560\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336772\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "8dc2633e89f0550fd3d7b991a87cb9ea9fe282a8", "git_parents": ["4ad3128f6ba1ae90cf461b1374c30bcf741f883e"], "node": "2602dd7f9943942b91c2497ed5169ca5cf07f340", "parents": ["4006e5f25b2628e1928369cd0aef19815af42bc8"], "tags": []}], "date": 1793034672, "git_changesets": ["8dc2633e89f0550fd3d7b991a87cb9ea9fe282a8"], "user": "dmeehan@mozilla.com"}, "1108": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070798 - Fix Prettier formatting in ESR153 test a=bustage DONTBUILD\n", "files": ["toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_recordTargetingContext.js"], "git_node": "089215754bfea98a49733a8aa677ca41f44b6781", "git_parents": ["8dc2633e89f0550fd3d7b991a87cb9ea9fe282a8"], "node": "7c8387702385d9f4e5ef50a4f9bc7999aec08930", "parents": ["2602dd7f9943942b91c2497ed5169ca5cf07f340"], "tags": []}], "date": 1793039801, "git_changesets": ["089215754bfea98a49733a8aa677ca41f44b6781"], "user": "dmeehan@mozilla.com"}, "1109": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080420 - Tighten matching of early hint preloads to their consumers a=dmeehan\" from ESR153 due to test failures\n\nThis reverts commit f8cfde561f4b05c0cf0d0b0c7dc3c5c530a88d5a.\n", "files": ["netwerk/protocol/http/EarlyHintPreloader.cpp", "netwerk/protocol/http/EarlyHintPreloader.h", "netwerk/protocol/http/EarlyHintRegistrar.cpp", "netwerk/protocol/http/EarlyHintRegistrar.h", "netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "bc99e30e49449c879d8099d7034df16c0c83aaf1", "git_parents": ["089215754bfea98a49733a8aa677ca41f44b6781"], "node": "17118ab1be79073c1cdd5cf30da559d37dfe9dcc", "parents": ["7c8387702385d9f4e5ef50a4f9bc7999aec08930"], "tags": []}], "date": 1793040220, "git_changesets": ["bc99e30e49449c879d8099d7034df16c0c83aaf1"], "user": "dmeehan@mozilla.com"}, "1110": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047113 - Part 1: Simplify JitScript::templateEnv_ to remove Maybe (ESR153)  a=dmeehan\n\nMarking needs to be able to read GC edge pointers atomically. This one is\ncurrently stored in a Maybe which makes this difficult. Instead we can have the\nedge be always present (and null when not used) and store the initialized flag\nseparately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336799\n", "files": ["js/src/jit/JitScript.cpp", "js/src/jit/JitScript.h"], "git_node": "0fa1998f25f35df9617b2621d5f875b6ea6849be", "git_parents": ["bc99e30e49449c879d8099d7034df16c0c83aaf1"], "node": "3ead53016d786c4748c9057ecb7ccdf1ac189cc0", "parents": ["17118ab1be79073c1cdd5cf30da559d37dfe9dcc"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047113 - Part 2: Convert HeapPtr to GCPtr in JitScript (ESR153)  a=dmeehan\n\nThis makes writes to these atomic in concurrent marking builds which will be\nrequired to prevent data races. Technically they should be HeapPtrs since they\nmay not have GC lifetime. To make them GCPtrs we must clear them if they are\ndestroyed to add the missing pre-write barrier (which we already do for other\nrelated fields).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336800\n", "files": ["js/src/jit/JitScript.cpp", "js/src/jit/JitScript.h"], "git_node": "731efd57597f82e572b361d737783b79669ec446", "git_parents": ["0fa1998f25f35df9617b2621d5f875b6ea6849be"], "node": "3207b470bbb87321550fb7f341c31d2826e9a661", "parents": ["3ead53016d786c4748c9057ecb7ccdf1ac189cc0"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047113 - Part 3: Make writes to JSScript gcThings array atomic for concurrent marking (ESR153)  a=dmeehan\n\nThis also adds atomic getter/setter methods to GCCellPtr. The getter is used in\na later patch.\n\nI tried making these into GCPtr\u003cJS::GCCellPtr\u003e instead and although I think\nit's a good change it ends up adding a lot of extra machinery since\nJS::GCCellPtr isn't currently supported by barrier wrappers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336801\n", "files": ["js/public/HeapAPI.h", "js/src/vm/JSScript.h"], "git_node": "300649f70b76940f9372d054bdc42418c8e10a07", "git_parents": ["731efd57597f82e572b361d737783b79669ec446"], "node": "a31c6132062de7e108ebc23ed555b8485605ab57", "parents": ["3207b470bbb87321550fb7f341c31d2826e9a661"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047113 - Part 4: Make public methods to set reserved slots atomic under concurrent marking (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336802\n", "files": ["js/public/Object.h", "js/public/Proxy.h"], "git_node": "40dca6724da3d1205b4c9fca89792d67bdd1966b", "git_parents": ["300649f70b76940f9372d054bdc42418c8e10a07"], "node": "4b55106bd06dfdcc7c2ed87fcf3b92944c561c28", "parents": ["a31c6132062de7e108ebc23ed555b8485605ab57"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047113 - Part 5: Make updates to atom marking bitmap atomic under concurrent marking (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336803\n", "files": ["js/src/ds/Bitmap.h", "js/src/gc/AtomMarking-inl.h"], "git_node": "627772eb6e509910f5272192fa8c96c4aa788220", "git_parents": ["40dca6724da3d1205b4c9fca89792d67bdd1966b"], "node": "0a552087fc6ada0748d5c509f192ace3e81c1b1c", "parents": ["4b55106bd06dfdcc7c2ed87fcf3b92944c561c28"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047113 - Part 6: Make TraceGCCellPtrRoot use atomic acceses under concurrent marking (ESR153)  a=dmeehan\n\nAlso simplify TraceBufferEdge/TraceEdgeAndBuffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336804\n", "files": ["js/src/gc/Marking.cpp", "js/src/gc/Tracer.h"], "git_node": "631927610e0c01d04f5d535b1f6eb4ff48db5a9c", "git_parents": ["627772eb6e509910f5272192fa8c96c4aa788220"], "node": "5ba49f614af13abd61e3d736fe7cea887e8737f3", "parents": ["0a552087fc6ada0748d5c509f192ace3e81c1b1c"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045112 - Part 1: Rename \"atom marking bitmaps\" to \"atom reference bitmaps\" (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336809\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/Compacting.cpp", "js/src/gc/GCMarker.h", "js/src/gc/GCRuntime.h", "js/src/gc/Heap.h", "js/src/gc/Marking.cpp", "js/src/gc/WeakMap.h", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/vm/HelperThreads.cpp", "js/src/vm/JSContext-inl.h"], "git_node": "9e4c84f3c9046b232d76f4b954a13181798ddbac", "git_parents": ["631927610e0c01d04f5d535b1f6eb4ff48db5a9c"], "node": "17895b7396bd80a754c9e0d1074e262e7411cd6c", "parents": ["5ba49f614af13abd61e3d736fe7cea887e8737f3"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045112 - Part 2: Rename Zone::markedAtoms -\u003e referencedAtoms (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336810\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h"], "git_node": "f1d25a1c3319c7ab1f22c6732c57d09ee037a3fa", "git_parents": ["9e4c84f3c9046b232d76f4b954a13181798ddbac"], "node": "a4ce396ab6ab74b63e41a2d6631dc1143e5dcae6", "parents": ["17895b7396bd80a754c9e0d1074e262e7411cd6c"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045112 - Part 3: Use \"record\"/\"ref\"/\"reference\" terminology: \"atomIsMarked\" =\u003e \"hasRef\", \"mark atom\" -\u003e \"record reference\" (and AtomMarkingRuntime -\u003e ZoneRefRuntime) (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336811\n", "files": ["js/src/builtin/RegExp.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/builtin/intl/SharedIntlData.cpp", "js/src/debugger/Debugger.cpp", "js/src/debugger/Environment.cpp", "js/src/debugger/ExecutionTracer.cpp", "js/src/debugger/Frame.cpp", "js/src/debugger/Object.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Heap-inl.h", "js/src/gc/Marking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp", "js/src/gc/WeakMap.cpp", "js/src/jsapi.cpp", "js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/Compartment.cpp", "js/src/vm/JSAtomUtils.cpp", "js/src/vm/JSAtomUtils.h", "js/src/vm/JSContext-inl.h", "js/src/vm/JSContext.h", "js/src/vm/JSFunction.cpp", "js/src/vm/JSFunction.h", "js/src/vm/NativeObject.h", "js/src/vm/SavedStacks.cpp", "js/src/vm/Scope.cpp", "js/src/vm/StructuredClone.cpp", "js/src/vm/SymbolType.cpp"], "git_node": "42d6b97673795f84ab8d883863a114afd688f6bf", "git_parents": ["f1d25a1c3319c7ab1f22c6732c57d09ee037a3fa"], "node": "a2173763d1e292054ed5a8998a0de6f0f7e41881", "parents": ["a4ce396ab6ab74b63e41a2d6631dc1143e5dcae6"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061758 - Part 1: Run heap check if gray marking assertions fail to give more information (ESR153)  a=dmeehan\n\nThis changes the gray marking checks to print all cells that were found to be\ngray (rather than stopping at the first one) and then running a gray marking check\nover the whole heap at the end of GC if any were found (and if it is compiled in).\n\nIt also adds some extra details like trace kind and zone GC state to the output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336819\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp"], "git_node": "3cb99469d86ad2aac1ff2b35195f8f37a38634df", "git_parents": ["42d6b97673795f84ab8d883863a114afd688f6bf"], "node": "7fd068f9adbbd00dc10d9c3ec886697b0f8f9a1f", "parents": ["a2173763d1e292054ed5a8998a0de6f0f7e41881"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061758 - Part 2: Try to skip recording duplicate elements in the buffer (ESR153)  a=dmeehan\n\nWe sometimes get the same cell recorded multiple times in the buffer, so add a\ncheck against the last element to help mitigate this.\n\nThe buffer doesn't seem to grow particularly large in actual use (the largest I\nsaw was ~100 elements) so it's probably not worth makin this more complicated\nby using a hash table.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336820\n", "files": ["js/src/gc/GC.cpp"], "git_node": "b7e242837dd2814eb2f4552ffbec1d56374b19a7", "git_parents": ["3cb99469d86ad2aac1ff2b35195f8f37a38634df"], "node": "caf18f604765d0a709ee063c6d689cf32cd1ef7f", "parents": ["7fd068f9adbbd00dc10d9c3ec886697b0f8f9a1f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076903 - Part 1: Make some Symbol fields const and remove unused method (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336834\n", "files": ["js/src/vm/SymbolType.h"], "git_node": "9ee613a5058dc7b4a5311cd5b66ab589262fd74c", "git_parents": ["b7e242837dd2814eb2f4552ffbec1d56374b19a7"], "node": "a6c5e66fdc7bcbc6f29596a2adb3e534a8b0094f", "parents": ["caf18f604765d0a709ee063c6d689cf32cd1ef7f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076903 - Part 2: Tighten assertions for AtomRefRuntime::recordRefToValue (ERR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336835\n", "files": ["js/public/Zone.h", "js/src/gc/AtomMarking.cpp"], "git_node": "e8cf9826054e93bf03c65b0edea6d010663fb2d9", "git_parents": ["9ee613a5058dc7b4a5311cd5b66ab589262fd74c"], "node": "3e53a0ef898854cf7225fac574bcc16bd8feebbc", "parents": ["a6c5e66fdc7bcbc6f29596a2adb3e534a8b0094f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076903 - Part 3: Move traceIncomingCrossCompartmentEdgesForZoneGC method to GCRuntime (ESR153)  a=dmeehan\n\nThis is already not specific to compartments as it does debugger tracing and\nwill soon be extended to add zone related tracing too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336836\n", "files": ["js/src/gc/Compacting.cpp", "js/src/gc/GCEnum.h", "js/src/gc/GCRuntime.h", "js/src/gc/RootMarking.cpp", "js/src/gc/Sweeping.cpp", "js/src/vm/Compartment.cpp", "js/src/vm/Compartment.h"], "git_node": "3bd39ccf6af8b2c836e2f96d928bc9282adaf28e", "git_parents": ["e8cf9826054e93bf03c65b0edea6d010663fb2d9"], "node": "55cef9b00cbbc98e9fefd92d1c3585a9b6ba290c", "parents": ["3e53a0ef898854cf7225fac574bcc16bd8feebbc"], "tags": []}], "date": 1793047548, "git_changesets": ["0fa1998f25f35df9617b2621d5f875b6ea6849be", "731efd57597f82e572b361d737783b79669ec446", "300649f70b76940f9372d054bdc42418c8e10a07", "40dca6724da3d1205b4c9fca89792d67bdd1966b", "627772eb6e509910f5272192fa8c96c4aa788220", "631927610e0c01d04f5d535b1f6eb4ff48db5a9c", "9e4c84f3c9046b232d76f4b954a13181798ddbac", "f1d25a1c3319c7ab1f22c6732c57d09ee037a3fa", "42d6b97673795f84ab8d883863a114afd688f6bf", "3cb99469d86ad2aac1ff2b35195f8f37a38634df", "b7e242837dd2814eb2f4552ffbec1d56374b19a7", "9ee613a5058dc7b4a5311cd5b66ab589262fd74c", "e8cf9826054e93bf03c65b0edea6d010663fb2d9", "3bd39ccf6af8b2c836e2f96d928bc9282adaf28e"], "user": "dmeehan@mozilla.com"}, "1111": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with FIREFOX_160_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "b0759467145911a6860cc71d2eda469f4a6077a1", "git_parents": ["ab6558de2c6b44296f28b76a9b119a2761f0222c"], "node": "b2af06d942129cfbfd153ff44966a4e7fd8efe30", "parents": ["df37fc5b6f31f231b90ca30bac5056e0fdc1b98e"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with DEVEDITION_160_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "64bc79bf66d8178621edf3dacd7fe7cf088e9f90", "git_parents": ["b0759467145911a6860cc71d2eda469f4a6077a1"], "node": "916894cd94aa34c6753afd00c67a9168d5ea61ca", "parents": ["b2af06d942129cfbfd153ff44966a4e7fd8efe30"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with FIREFOX-ANDROID_160_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "636004bc46f21963e30420f3721d4d442fa5f001", "git_parents": ["64bc79bf66d8178621edf3dacd7fe7cf088e9f90"], "node": "578a13fc97f2aa5323b4a4304cf4c36b79f45249", "parents": ["916894cd94aa34c6753afd00c67a9168d5ea61ca"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with FIREFOX-ANDROID_160_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "53d3a12c1168bd1772d208706945e844cc367ce8", "git_parents": ["636004bc46f21963e30420f3721d4d442fa5f001"], "node": "98a9c395e22f3ea462b2ce36e4813a581bf6cb5f", "parents": ["578a13fc97f2aa5323b4a4304cf4c36b79f45249"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with FIREFOX_160_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9b155f8b4aa1a6c5b4c4cdf6c70ba08dae480aa5", "git_parents": ["53d3a12c1168bd1772d208706945e844cc367ce8"], "node": "53d84b8bd49bf5b9c65017ffdf849fb00819795d", "parents": ["98a9c395e22f3ea462b2ce36e4813a581bf6cb5f"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with DEVEDITION_160_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "2e1db2ece8a3a1d68a94cab8aee845aff0ba85da", "git_parents": ["9b155f8b4aa1a6c5b4c4cdf6c70ba08dae480aa5"], "node": "374006e562b213c42f8c6e9ef28521447782fc32", "parents": ["53d84b8bd49bf5b9c65017ffdf849fb00819795d"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging d63de7b9609253a860fbb0050f678700f4cdc492 with FIREFOX_153_6_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c30b9d30271092074c2843490c74b2ef8bb72b95", "git_parents": ["2e1db2ece8a3a1d68a94cab8aee845aff0ba85da"], "node": "8c06d24e0d425ac5348c27748e4388275b956a1a", "parents": ["374006e562b213c42f8c6e9ef28521447782fc32"], "tags": []}], "date": 1793104441, "git_changesets": ["b0759467145911a6860cc71d2eda469f4a6077a1", "64bc79bf66d8178621edf3dacd7fe7cf088e9f90", "636004bc46f21963e30420f3721d4d442fa5f001", "53d3a12c1168bd1772d208706945e844cc367ce8", "9b155f8b4aa1a6c5b4c4cdf6c70ba08dae480aa5", "2e1db2ece8a3a1d68a94cab8aee845aff0ba85da", "c30b9d30271092074c2843490c74b2ef8bb72b95"], "user": "ffxbld@lando.moz.tools"}, "1112": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2058648 - Keep the GTK emoji picker on the focused window.  a=dmeehan DONTBUILD\n\nInsertEmoji() redirected the picker to whatever rollup popup was open, even\none belonging to another toplevel. That popup's hidden GtkEntry then kept\nthe focused toplevel as its insert_text target for as long as the popup\nlived.\n\nRedirect only to a popup of the same toplevel. The entry now also holds a\nreference to its target window, so the target outlives the insert_text\nhandler.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334388\n\n(cherry picked from commit c25ff1d5742ef3b63aef7e1ca3889f3d839b4d0d)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336888\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "6581293739602c2ca1fbc95b6ae13e0205ef139e", "git_parents": ["3bd39ccf6af8b2c836e2f96d928bc9282adaf28e"], "node": "c5ced53356b35e120468145cdcb1bcb2b5e483d3", "parents": ["55cef9b00cbbc98e9fefd92d1c3585a9b6ba290c"], "tags": []}], "date": 1793107831, "git_changesets": ["6581293739602c2ca1fbc95b6ae13e0205ef139e"], "user": "dmeehan@mozilla.com"}, "1113": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2079937 - Make `WhiteSpaceVisibilityKeeper::InsertTextOrInsertOrUpdateCompositionString` abort if the target `Text` has gone  a=dmeehan DONTBUILD\n\nAfter deleting a `\u003cbr\u003e`, the target `Text` may have been removed.\nThen, the tracked point is set to outside the `Text`. Then, it should\nstop handling the insertion since it should be handled by the app\nentirely.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333988\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336944\n", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/WhiteSpaceVisibilityKeeper.cpp"], "git_node": "b572e28a8604750fd727bffe995032bb0e03d74f", "git_parents": ["6581293739602c2ca1fbc95b6ae13e0205ef139e"], "node": "ed579fd4757ef75302aaa4fac5ed7876bb2701b2", "parents": ["c5ced53356b35e120468145cdcb1bcb2b5e483d3"], "tags": []}], "date": 1793107852, "git_changesets": ["b572e28a8604750fd727bffe995032bb0e03d74f"], "user": "dmeehan@mozilla.com"}, "1114": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 1: Change existing APIs to record atom references to allow wrapping (ESR153)  a=dmeehan\n\nSymbols may need to be wrapped when they are passed between zones. This changes\nthe internal and external APIs which currently update the atom reference bitmap\nto refer to wrapping symbols.\n\nThe existing external APIs are replaced by a shim over the new APIs. They are\nreplaced in a later patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336840\n", "files": ["js/public/Zone.h", "js/src/debugger/Debugger.cpp", "js/src/debugger/Environment.cpp", "js/src/debugger/Frame.cpp", "js/src/debugger/Object.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/JSContext.h", "js/src/vm/SymbolType.cpp"], "git_node": "749e98e0c378492d1ee88131f36485d1a091831e", "git_parents": ["b572e28a8604750fd727bffe995032bb0e03d74f"], "node": "c29d524bba8a2732d101902edd13d7ade9c78d86", "parents": ["ed579fd4757ef75302aaa4fac5ed7876bb2701b2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 2: Merge atom reference bitmap recordRef methods into JSContext (ESR153)  a=dmeehan\n\nThese will do more than just update the atom reference bitmap so merge these\ninto their JSContext callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336841\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h"], "git_node": "cfd9c675834255d974733a027c8ddeae3b27f195", "git_parents": ["749e98e0c378492d1ee88131f36485d1a091831e"], "node": "060365c497a5117fd3004ed8ecf5d8b84844df31", "parents": ["c29d524bba8a2732d101902edd13d7ade9c78d86"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 3: Update the browser to call JS_WrapId function in place of JS_MarkCrossZoneId (ESR153)  a=dmeehan\n\nThis new function now also wraps symbols when appropriate. It is fallible\nunlike the function it replaces.\n\nUse of JS_MarkCrossZoneIdValue is replaced with JS_WrapValue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336842\n", "files": ["dom/base/ChromeUtils.cpp", "dom/base/MaybeCrossOriginObject.cpp", "dom/base/nsGlobalWindowOuter.cpp", "dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "js/public/Zone.h", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/vm/JSContext-inl.h", "js/xpconnect/src/ExportHelpers.cpp", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCWrappedNativeInfo.cpp", "js/xpconnect/src/XPCWrappedNativeJSOps.cpp", "js/xpconnect/wrappers/XrayWrapper.cpp"], "git_node": "c3ae59d109ca2326d003fd7201e23e326ab95b0b", "git_parents": ["cfd9c675834255d974733a027c8ddeae3b27f195"], "node": "610d3c92b83c4272eb51e1643871c12abb6a0bc4", "parents": ["060365c497a5117fd3004ed8ecf5d8b84844df31"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 4: Extend JS::Symbol to support allocating per-zone wrappers (ESR153)  a=dmeehan\n\nAdds methods to query whether a symbol is shared (canonical, allocated in the\natoms zone) or local (a wrapper, not allocated in the atoms zone).\n\nThis changes the symbol header pointer for a local symbol to point to its\nshared symbol. For non-unique and shared symbols the header pointer\ncontinues to point to the description atom.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336843\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/Cell.h", "js/src/gc/TraceMethods-inl.h", "js/src/vm/SymbolType.cpp", "js/src/vm/SymbolType.h"], "git_node": "5362f6c84060b90d673cb778e6476e1870a7d387", "git_parents": ["c3ae59d109ca2326d003fd7201e23e326ab95b0b"], "node": "394a7c24774ff9d0f7b06c9601d9821e02fce90c", "parents": ["610d3c92b83c4272eb51e1643871c12abb6a0bc4"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 5: Allocate local/shared symbol pairs for unique symbols and implement wrapping (ESR153)  a=dmeehan\n\nThis is the main patch that changes the way symbols are allocated. For unique\nsymbols we allocate a local symbol and make it point to a shared symbol. Local\nsymbols are wrapped when being moved between zones so that JS always sees the\nlocal symbol.\n\nTests are updated to take account of the fact that unqiue symbols are no longer\npresent in atom reference bitmap.\n\nNot using the atoms reference bitmap (which is quite conservative) means we can\ncollect symbols sooner in some cases.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336844\n", "files": ["js/src/builtin/FinalizationRegistryObject.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/builtin/WeakRefObject.cpp", "js/src/gc/Allocator.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/Cell.h", "js/src/gc/Marking.cpp", "js/src/gc/RootMarking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.h", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/jit-test/tests/gc/bug-2042465.js", "js/src/jit-test/tests/gc/bug-2061775.js", "js/src/jit-test/tests/gc/marked-atoms.js", "js/src/jit-test/tests/gc/symbols-as-weakmap-keys.js", "js/src/jit/VMFunctions.cpp", "js/src/jl", "js/src/proxy/Proxy.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/Compartment.cpp", "js/src/vm/EqualityOperations.cpp", "js/src/vm/JSAtomUtils.h", "js/src/vm/JSContext-inl.h", "js/src/vm/JSContext.cpp", "js/src/vm/SymbolType.cpp", "js/src/vm/SymbolType.h"], "git_node": "281b6d6252bdc548d35767bea9b36c684dd8f44a", "git_parents": ["5362f6c84060b90d673cb778e6476e1870a7d387"], "node": "8eebe30c76be8c5ba9c90e39d00ff3555dfda353", "parents": ["394a7c24774ff9d0f7b06c9601d9821e02fce90c"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 6: Add some tests to exercise symbols being passed between zones (ESR153)  a=dmeehan\n\nI think our existing tests already cover most of this but having some explicit\ntests for this can't hurt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336845\n", "files": ["js/src/jit-test/tests/gc/symbol-cross-zone-identity.js", "js/src/jit-test/tests/gc/symbol-cross-zone-weakref-finalization.js"], "git_node": "0ff523af167319af278e9ef62fa579efc56d57e0", "git_parents": ["281b6d6252bdc548d35767bea9b36c684dd8f44a"], "node": "e9754f913ad68f13b9ab2af93f2ee5a3c65bad97", "parents": ["8eebe30c76be8c5ba9c90e39d00ff3555dfda353"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 7: Add a ref to the symbol description in getters (ESR153)  a=dmeehan\n\nI'm not sure why this wasn't already present. We need to add a ref to the\ndescription atom in the current zone when returning it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336846\n", "files": ["js/public/Symbol.h", "js/src/builtin/Symbol.cpp", "js/src/jit-test/tests/gc/symbol-description-atom-ref.js", "js/src/jsapi-tests/testSymbol.cpp", "js/src/jsapi.cpp"], "git_node": "74db1c986fb32ada923073959d266755da33e908", "git_parents": ["0ff523af167319af278e9ef62fa579efc56d57e0"], "node": "bd563f49d67fa102bee28a6ec11f19a825d284a1", "parents": ["e9754f913ad68f13b9ab2af93f2ee5a3c65bad97"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 8: Fix gdb tests to understand the new symbol layout (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336848\n", "files": ["js/src/gdb/mozilla/CellHeader.py", "js/src/gdb/mozilla/GCCellPtr.py", "js/src/gdb/mozilla/JSSymbol.py", "js/src/gdb/mozilla/prettyprinters.py"], "git_node": "4fa5f29fbf4a47fb755376b8c6c6b4bb476e51de", "git_parents": ["74db1c986fb32ada923073959d266755da33e908"], "node": "28fa106a43dba48d1489d4ec5bdbac403762d35e", "parents": ["bd563f49d67fa102bee28a6ec11f19a825d284a1"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 9: Stop tracking gray references in atom reference bitmap (ESR153)  a=dmeehan\n\nThis updates APIs to remove references to cell color and removes updating gray\nsymbol references in marking.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336849\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Marking.cpp", "js/src/gc/Verifier.cpp", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/vm/JSContext-inl.h"], "git_node": "830728dd9f351915eaca55372c1ac6d47421e79c", "git_parents": ["4fa5f29fbf4a47fb755376b8c6c6b4bb476e51de"], "node": "307c0d3d585763fb3bdcb64405eb3348209fc692", "parents": ["28fa106a43dba48d1489d4ec5bdbac403762d35e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 10: Add tests from related bugs (ESR153)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336850\n", "files": ["js/src/.python-version", "js/src/jit-test/tests/gc/bug-2068369.js", "js/src/jit-test/tests/gc/bug-2068384.js", "js/src/jit-test/tests/gc/bug-2073649.js", "js/src/jit-test/tests/gc/bug-2074215.js", "js/src/jit-test/tests/gc/bug-2077750.js", "js/src/jit-test/tests/gc/bug-2078783.js"], "git_node": "0097d043437715808c4f1d2d4f00f7732600a6e2", "git_parents": ["830728dd9f351915eaca55372c1ac6d47421e79c"], "node": "e6edb7e85710c2561aae643e8a7fe8fa3ebb440c", "parents": ["307c0d3d585763fb3bdcb64405eb3348209fc692"], "tags": []}], "date": 1793108102, "git_changesets": ["749e98e0c378492d1ee88131f36485d1a091831e", "cfd9c675834255d974733a027c8ddeae3b27f195", "c3ae59d109ca2326d003fd7201e23e326ab95b0b", "5362f6c84060b90d673cb778e6476e1870a7d387", "281b6d6252bdc548d35767bea9b36c684dd8f44a", "0ff523af167319af278e9ef62fa579efc56d57e0", "74db1c986fb32ada923073959d266755da33e908", "4fa5f29fbf4a47fb755376b8c6c6b4bb476e51de", "830728dd9f351915eaca55372c1ac6d47421e79c", "0097d043437715808c4f1d2d4f00f7732600a6e2"], "user": "dmeehan@mozilla.com"}, "1115": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045459 - Avoid clearing the current chunk for isPointerWithinTenuredCell() check  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307634\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337186\n", "files": ["js/src/gc/Tenuring.cpp", "js/src/gc/Verifier.cpp"], "git_node": "c7294eee761b7d52e3e7c6c3a65b4d74655a9b8f", "git_parents": ["0097d043437715808c4f1d2d4f00f7732600a6e2"], "node": "4305086fa9ce601f7166dd2fdf6220dca1d069d9", "parents": ["e6edb7e85710c2561aae643e8a7fe8fa3ebb440c"], "tags": []}], "date": 1793119257, "git_changesets": ["c7294eee761b7d52e3e7c6c3a65b4d74655a9b8f"], "user": "dmeehan@mozilla.com"}, "1116": {"changesets": [{"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050157 - Restore select-control container roles.  a=dmeehan DONTBUILD\n\nBug 2037052 stopped the host from supplying its child container role.\nNow we move that role to the inner fieldset and set the role\naccordingly.\n\nEven though role=\"listbox|tablist\" is technically not allowed on a\nfieldset element (WCAG spec), we allow that assignment because in Gecko\nthe role assignment gives functionally correct semantics and behavior.\nSee Bug 2050157 Comment 10 for more info.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319621\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337180\n", "files": ["toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_moz_radio_group.html", "toolkit/content/tests/widgets/test_moz_visual_picker.html", "toolkit/content/widgets/lit-select-control.mjs", "toolkit/content/widgets/moz-fieldset/moz-fieldset.mjs"], "git_node": "c62da78be9b47a41e2a605c7f4d8fdebca5c7e92", "git_parents": ["c7294eee761b7d52e3e7c6c3a65b4d74655a9b8f"], "node": "521cae1a71a2a5e6612e2a24698fca8561d1f243", "parents": ["4305086fa9ce601f7166dd2fdf6220dca1d069d9"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050157 - Name about:preferences radio groups.  a=dmeehan DONTBUILD\n\nSettings config now passes each setting group's Fluent ID to\nmoz-radio-group. This allows the inner `radiogroup` to have a localized\nname, which is required by the ARIA spec. The migration reuses the\nexisting section labels.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321098\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337181\n", "files": ["browser/components/preferences/config/about-firefox.mjs", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection.js", "browser/components/preferences/tests/browser_updates_managed_by_os.js", "browser/components/preferences/tests/etp/browser_etp_advanced.js", "browser/components/preferences/tests/head.js", "browser/components/preferences/tests/privacy/browser_privacy_dnsoverhttps_policy_srd.js", "browser/components/preferences/tests/privacy/browser_privacy_history_search_l10n_ids.js", "browser/locales-preview/aiFeatures.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "python/l10n/fluent_migrations/bug_2050157_preferences_radio_group_accessible_names.py"], "git_node": "37c68f3a2f512f4c1b16fd6e7d97b8102bfbc355", "git_parents": ["c62da78be9b47a41e2a605c7f4d8fdebca5c7e92"], "node": "34116c3cfd9f718ef3d96ab43f73399d2f288929", "parents": ["521cae1a71a2a5e6612e2a24698fca8561d1f243"], "tags": []}], "date": 1793119290, "git_changesets": ["c62da78be9b47a41e2a605c7f4d8fdebca5c7e92", "37c68f3a2f512f4c1b16fd6e7d97b8102bfbc355"], "user": "dmeehan@mozilla.com"}, "1117": {"changesets": [{"author": "Shravan Narayan \u003cshravanrn@gmail.com\u003e", "branch": "default", "desc": "Bug 2077405 - Update rlbox to avoid duplicate reads of sandbox data  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337000\n", "files": ["third_party/rlbox/include/rlbox.hpp", "third_party/rlbox/include/rlbox_conversion.hpp", "third_party/rlbox/include/rlbox_helpers.hpp", "third_party/rlbox/include/rlbox_policy_types.hpp", "third_party/rlbox/include/rlbox_range.hpp", "third_party/rlbox/include/rlbox_sandbox.hpp", "third_party/rlbox/include/rlbox_stdlib.hpp", "third_party/rlbox/include/rlbox_stdlib_polyfill.hpp", "third_party/rlbox/i