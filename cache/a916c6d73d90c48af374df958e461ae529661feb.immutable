c", "third_party/libwebrtc/video/corruption_detection/evaluation/qp_parser.cc", "third_party/libwebrtc/video/corruption_detection/evaluation/qp_parser.h", "third_party/libwebrtc/video/corruption_detection/evaluation/webrtc_picture_pair_provider_unittest.cc", "third_party/libwebrtc/video/end_to_end_tests/bandwidth_tests.cc", "third_party/libwebrtc/video/end_to_end_tests/multi_stream_tester.cc", "third_party/libwebrtc/video/end_to_end_tests/multi_stream_tester.h", "third_party/libwebrtc/video/end_to_end_tests/network_state_tests.cc", "third_party/libwebrtc/video/end_to_end_tests/rtp_rtcp_tests.cc", "third_party/libwebrtc/video/end_to_end_tests/ssrc_tests.cc", "third_party/libwebrtc/video/end_to_end_tests/stats_tests.cc", "third_party/libwebrtc/video/end_to_end_tests/transport_feedback_tests.cc", "third_party/libwebrtc/video/frame_decode_timing.cc", "third_party/libwebrtc/video/frame_decode_timing.h", "third_party/libwebrtc/video/frame_decode_timing_unittest.cc", "third_party/libwebrtc/video/pc_full_stack_tests.cc", "third_party/libwebrtc/video/receive_statistics_proxy.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h", "third_party/libwebrtc/video/video_quality_test.cc", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc", "third_party/libwebrtc/video/video_send_stream_tests.cc", "third_party/libwebrtc/video/video_stream_buffer_controller.cc", "third_party/libwebrtc/video/video_stream_encoder.cc", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc", "third_party/libwebrtc/webrtc.gni"], "git_node": "f0f0a2e87104fcd0274c5990aa59d39a722d55bc", "git_parents": ["d33b10e92951a6d5df29143658e433a36e818d8d"], "node": "5e4a79656b75c8df175945eba05e1324587b4216", "parents": ["a367e2b679bb81aa44cd1eab06fd57a17c1f1958"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086243 - Cherry-pick upstream libwebrtc commit c6c0780f55 r=bwc a=dmeehan\n\nAlso updates dom/media/webrtc/third_party_build/ignored_branch_head_commits.json\nso we ignore a couple upstream commits that don't apply to Firefox.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c6c0780f555c970bdf5dbe14bdafc9adfbfe3652\n       [M150-LTS] Harden payload capacity and reduction checks in RTP packetizers\n\n       Original change's description:\n       \u003e Harden payload capacity and reduction checks in RTP packetizers\n       \u003e\n       \u003e Ensure packet reduction lengths cannot be negative when computing\n       \u003e payload limits in RTPSenderVideo and when determining needed payload\n       \u003e sizes during aggregation. Additionally, add a bounds check against\n       \u003e available payload capacity before copying aggregated fragments in\n       \u003e RtpPacketizerH265.\n       \u003e\n       \u003e Bug: chromium:567088927\n       \u003e Change-Id: Ibd57aacce9ef79379fa627903d4aed89c9fbf489\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506260\n       \u003e Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#48750}\n\n       (cherry picked from commit fc6666263eafa63878d02102189e3dabe9c90455)\n\n       Using no-try due to infra failures.\n\n       No-try: true\n       Bug: chromium:567088927\n       Change-Id: I5f25e1ac625528b731f134a0a50e2996d51fb94f\n       Fixed: chromium:567813534\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506580\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       Cr-Original-Commit-Position: refs/branch-heads/8037@{#3}\n       Cr-Original-Branched-From: 57f79e8e198c946f781606df091e733f3d033c5f-refs/heads/main@{#48447}\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506880\n       Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       Cr-Commit-Position: refs/branch-heads/7871@{#5}\n       Cr-Branched-From: b1dde843dc4388c62a66f8ca903e795463b04075-refs/heads/main@{#47863}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337357\n", "files": ["dom/media/webrtc/third_party_build/ignored_branch_head_commits.json", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_h264.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_h264_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packetizer_h265.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packetizer_h265_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/moz-patch-stack/c6c0780f55.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0153.patch"], "git_node": "e9f9e05dd8d36a9615737f9c9a061bb4a8ae9a99", "git_parents": ["f0f0a2e87104fcd0274c5990aa59d39a722d55bc"], "node": "c216497109c4952fabca2612f92a2c0f184b5e69", "parents": ["5e4a79656b75c8df175945eba05e1324587b4216"], "tags": []}], "date": 1793287039, "git_changesets": ["f0f0a2e87104fcd0274c5990aa59d39a722d55bc", "e9f9e05dd8d36a9615737f9c9a061bb4a8ae9a99"], "user": "dmeehan@mozilla.com"}, "1164": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086243 - ESR153 linter fix a=lint-fix DONTBUILD\n", "files": ["dom/media/webrtc/third_party_build/ignored_branch_head_commits.json"], "git_node": "f9e5c6caf08442c3ae3ae97d0901b920777f3116", "git_parents": ["e9f9e05dd8d36a9615737f9c9a061bb4a8ae9a99"], "node": "42e2032b8115b09fecc3f6df9498c79988bac2b1", "parents": ["c216497109c4952fabca2612f92a2c0f184b5e69"], "tags": []}], "date": 1793292723, "git_changesets": ["f9e5c6caf08442c3ae3ae97d0901b920777f3116"], "user": "dmeehan@mozilla.com"}, "1165": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2084673 - Simplify mojo dead proxy handling,  a=dmeehan DONTBUILD\n\nPreviously, the mojo ports backend used a generic \"broadcast\" mechanism\nwhich was only ever used to broadcast a specific `ObserveProxy` message\nto signal a dead proxy. This specific message had special handling in\nevery place it was used within the ports code.\n\nThis makes the single use of the broadcast mechanism more explicit, by\nexplicitly limiting it to only support sending a `DeadProxy` message,\nand removing broadcast support from generic events.\n\nThis also fixes a minor bug in proxy handling where the broker process\nwould never be delivered the dead proxy notification itself, and the\nsending process would handle the dead proxy notification multiple times.\n\nChromium no longer uses this ports code upstream, so this divergence is\nnot an uplift concern. We are now the sole maintainers of this logic.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337281\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337741\n", "files": ["ipc/chromium/gtest/ports_unittest.cc", "ipc/chromium/src/mojo/core/ports/event.cc", "ipc/chromium/src/mojo/core/ports/event.h", "ipc/chromium/src/mojo/core/ports/node.cc", "ipc/chromium/src/mojo/core/ports/node.h", "ipc/chromium/src/mojo/core/ports/node_delegate.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/NodeController.cpp", "ipc/glue/NodeController.h", "ipc/glue/ProtocolUtils.h", "ipc/ipdl/ipdl.py", "tools/fuzzing/ipc/IPCFuzzController.cpp"], "git_node": "4413053796ed13121c0546cec9eb28b978ad2ef5", "git_parents": ["f9e5c6caf08442c3ae3ae97d0901b920777f3116"], "node": "7bbef594c854109f331be149297b3c02e7b59c9c", "parents": ["42e2032b8115b09fecc3f6df9498c79988bac2b1"], "tags": []}], "date": 1793295402, "git_changesets": ["4413053796ed13121c0546cec9eb28b978ad2ef5"], "user": "dmeehan@mozilla.com"}, "1166": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2083629 - Pop the change index before performing block I/O in FileBlockCache.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336984\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337790\n", "files": ["dom/media/FileBlockCache.cpp"], "git_node": "08e6c6ac821c2b51e13f91c9a7cfb80cade4f760", "git_parents": ["4413053796ed13121c0546cec9eb28b978ad2ef5"], "node": "065fd0415ccf56b318490a73ead8a5ed50a67689", "parents": ["7bbef594c854109f331be149297b3c02e7b59c9c"], "tags": []}], "date": 1793295642, "git_changesets": ["08e6c6ac821c2b51e13f91c9a7cfb80cade4f760"], "user": "dmeehan@mozilla.com"}, "1167": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084865 - Force a pip upgrade in updatebot docker images by pinning to the latest version. a=dmeehan\"\n\nThis reverts commit cb67c1d1e0acb5cd4f2fdc4d679cbf086f109b6b.\n", "files": ["taskcluster/docker/updatebot/privileged-setup.sh", "taskcluster/docker/updatebot/windows-setup.sh"], "git_node": "f7681f32f4cd9e4cd8586f322c1a1d66555ce255", "git_parents": ["08e6c6ac821c2b51e13f91c9a7cfb80cade4f760"], "node": "3e5facf78c4a42889f013bbed62d926eb3f39d72", "parents": ["065fd0415ccf56b318490a73ead8a5ed50a67689"], "tags": []}, {"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084865 - Update ca-certificates in the Ubuntu images. a=dmeehan\"\n\nThis reverts commit 7b46f6fe69c674581b087e83543f3522fcabb392.\n", "files": ["