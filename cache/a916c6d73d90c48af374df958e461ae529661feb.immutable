8825507c", "git_parents": ["fd5d19ae630ca7759b8e181e4b50c1aade673d35"], "node": "8eeaa25b37fdb9c0be3b7e1a28880eea9f4b4aae", "parents": ["1417385ecd785fdab59703fbb36493ae35c41a37"], "tags": []}], "date": 1792955102, "git_changesets": ["fd5d19ae630ca7759b8e181e4b50c1aade673d35", "9035cc543d6d3899073609abd49537ae8825507c"], "user": "ffxbld@lando.moz.tools"}, "1097": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2080420 - Tighten matching of early hint preloads to their consumers  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335126\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336687\n", "files": ["netwerk/protocol/http/EarlyHintPreloader.cpp", "netwerk/protocol/http/EarlyHintPreloader.h", "netwerk/protocol/http/EarlyHintRegistrar.cpp", "netwerk/protocol/http/EarlyHintRegistrar.h", "netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "f8cfde561f4b05c0cf0d0b0c7dc3c5c530a88d5a", "git_parents": ["9035cc543d6d3899073609abd49537ae8825507c"], "node": "65e63308e820d1d8e99db9b58da64c57568bdacd", "parents": ["8eeaa25b37fdb9c0be3b7e1a28880eea9f4b4aae"], "tags": []}], "date": 1793021871, "git_changesets": ["f8cfde561f4b05c0cf0d0b0c7dc3c5c530a88d5a"], "user": "dmeehan@mozilla.com"}, "1098": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074556 - Don't try to create editor for non-HTML/XHTML documents in Document::EditingStateChanged.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329633\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336683\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "editor/libeditor/tests/file_svg_designMode_blur.svg", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_svg_designMode_blur.html"], "git_node": "e09da4c19df7d3bbc58b469f6a47aae3f7c52e88", "git_parents": ["f8cfde561f4b05c0cf0d0b0c7dc3c5c530a88d5a"], "node": "1d1398e63255099457d0f2930bb08c4989a5c88b", "parents": ["65e63308e820d1d8e99db9b58da64c57568bdacd"], "tags": []}], "date": 1793021896, "git_changesets": ["e09da4c19df7d3bbc58b469f6a47aae3f7c52e88"], "user": "dmeehan@mozilla.com"}, "1099": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084640. Don't reuse cached path patterns at a different offset from the path.  a=dmeehan DONTBUILD\n\nhttps://searchfox.org/firefox-main/rev/034cd8a8207e38b04afec5e6f75e5161f75a112f/dom/canvas/DrawTargetWebgl.cpp#4540\n\nPathCacheEntry::MatchesPath ignores translation, assuming the pattern moves\nwith the path. That isn't true when the path stays put in device space and\nonly the pattern moves, e.g. pdf.js filling the whole canvas with a translated\nradial gradient for each shading, so we reused the first draw's texture for\nthe others. This was hidden until bug 2072448 let gradient patterns match in\nthe cache. Record the quantized offset of the pattern relative to the path\nwhenever the pattern is rasterized into an entry's texture, and require it to\nmatch for entries with a baked texture. Entries that only cache WGR vertex\ngeometry draw with the live pattern, so they are unaffected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336152\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336499\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h", "dom/canvas/DrawTargetWebglInternal.h", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat-expected.html", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat-expected.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.w.html", "testing/web-platform/tests/html/canvas/tools/yaml/fill-and-stroke-styles.yaml"], "git_node": "51e16852ede3e5bd2a08f55296f35425d60a15cc", "git_parents": ["e09da4c19df7d3bbc58b469f6a47aae3f7c52e88"], "node": "6250e73fb17da35313dd2069a5440daff7f47d51", "parents": ["1d1398e63255099457d0f2930bb08c4989a5c88b"], "tags": []}], "date": 1793022435, "git_changesets": ["51e16852ede3e5bd2a08f55296f35425d60a15cc"], "user": "dmeehan@mozilla.com"}, "1100": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076695 - Make nsTimer support thread-safe weak pointers and hold it weakly from nsTimerImpl.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331822\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336647\n", "files": ["xpcom/threads/nsTimerImpl.cpp", "xpcom/threads/nsTimerImpl.h"], "git_node": "44d79de83b7a333ecbc72fe78c2812632adf26fe", "git_parents": ["51e16852ede3e5bd2a08f55296f35425d60a15cc"], "node": "2ac0000db7a98ef18c3f48b003f882775841af89", "parents": ["6250e73fb17da35313dd2069a5440daff7f47d51"], "tags": []}], "date": 1793022537, "git_changesets": ["44d79de83b7a333ecbc72fe78c2812632adf26fe"], "user": "dmeehan@mozilla.com"}, "1101": {"changesets": [{"author": "Evandro Baginski \u003cebaginski@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2054199 - Fix mach try comm detection on Windows by normalizing paths  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336696\n", "files": ["tools/tryselect/util/project.py"], "git_node": "c83720f8181420fb8dc6560fda85942b7ec04da3", "git_parents": ["44d79de83b7a333ecbc72fe78c2812632adf26fe"], "node": "9c440d63330bbe52de2718dc5dd6f3fccff83dba", "parents": ["2ac0000db7a98ef18c3f48b003f882775841af89"], "tags": []}], "date": 1793022558, "git_changesets": ["c83720f8181420fb8dc6560fda85942b7ec04da3"], "user": "dmeehan@mozilla.com"}, "1102": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Cherry-pick upstream libwebrtc commit 19576e3787  a=dmeehan\n\nUpstream commit: https://webrtc.googlesource.com/src/+/19576e37870bfe5a0a910a32f98ff411f722f43a\n       [M156] Fail EncodeFec when packets are passed radically out of order\n\n       Original change's description:\n       \u003e Fail EncodeFec when packets are passed radically out of order\n       \u003e\n       \u003e Bug: chromium:570927027\n       \u003e Change-Id: I9fd8d548e9e7935a4862dc95cb65548eba3b4c5f\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/509462\n       \u003e Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n       \u003e Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#48960}\n\n       (cherry picked from commit d86ac8ab5e04c7efb8f474985e1bec1f82443a34)\n\n       Bug: chromium:575704619,chromium:570927027\n       Change-Id: I9fd8d548e9e7935a4862dc95cb65548eba3b4c5f\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/510520\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Commit-Queue: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n       Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n       Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n       Cr-Commit-Position: refs/branch-heads/8078@{#6}\n       Cr-Branched-From: 3225248425fe2b3cafe389465b94ebc24968d9ba-refs/heads/main@{#48737}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336658\n", "files": ["third_party/libwebrtc/m