dmeehan@mozilla.com"}, "1076": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025197 - Move AddSecurityState to PWindowGlobal.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331666\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336113\n", "files": ["docshell/base/WindowContext.cpp", "docshell/base/WindowContext.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/security/nsHTTPSOnlyStreamListener.cpp", "dom/security/nsMixedContentBlocker.cpp"], "git_node": "d9b437c6875f5d556310f562b15996a37fa5b70f", "git_parents": ["447b9870d1fdc5f3dbe0ace72718ba93ada7feb7"], "node": "ba6bbc46ddb7b1c08a19241061b620d292205c08", "parents": ["e758f6eaa0c7495dc488e5d7237d66169948e3f2"], "tags": []}], "date": 1792778307, "git_changesets": ["d9b437c6875f5d556310f562b15996a37fa5b70f"], "user": "dmeehan@mozilla.com"}, "1077": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2076948 - Use exact permission check for open-protocol-handler.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335341\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336254\n", "files": ["toolkit/mozapps/handling/ContentDispatchChooser.sys.mjs", "uriloader/exthandler/tests/unit/test_launch_first_click_with_permission.js"], "git_node": "bf445a85c01320ff3e0618a16362f264323c0487", "git_parents": ["d9b437c6875f5d556310f562b15996a37fa5b70f"], "node": "3fea3a8275c406149667b5cd3d34acde734c30a0", "parents": ["ba6bbc46ddb7b1c08a19241061b620d292205c08"], "tags": []}], "date": 1792778488, "git_changesets": ["bf445a85c01320ff3e0618a16362f264323c0487"], "user": "dmeehan@mozilla.com"}, "1078": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081550 - Fix ESR153 build a=bustage\n", "files": ["image/SVGDocumentWrapper.cpp"], "git_node": "b21b66afe4d5b5ad091cd54aa7898285f0fd1d7e", "git_parents": ["bf445a85c01320ff3e0618a16362f264323c0487"], "node": "b408c77e3039ef6ca9702ed678ceaaaef9d982d7", "parents": ["3fea3a8275c406149667b5cd3d34acde734c30a0"], "tags": []}], "date": 1792780745, "git_changesets": ["b21b66afe4d5b5ad091cd54aa7898285f0fd1d7e"], "user": "dmeehan@mozilla.com"}, "1079": {"changesets": [{"author": "Corey Bryant \u003ccorey@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2010071 - Support `mach try` from Thunderbird (comm) checkout.  a=dmeehan DONTBUILD\n\n`mach try` assumed a Firefox checkout and `mach try fuzzy` generated\nits task list from \u003ctopsrcdir\u003e/taskcluster (the gecko task set only),\nso Thunderbird tasks never appeared.\n\nThe build.substr check was removed from is_thunderbird_try in order\nto enable try before a configure/build. Otherwise, False was returned,\nresulting in an assumed Firefox try.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309933\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336171\n", "files": ["python/mozversioncontrol/mozversioncontrol/repo/base.py", "python/mozversioncontrol/mozversioncontrol/repo/git.py", "python/mozversioncontrol/mozversioncontrol/repo/jj.py", "python/mozversioncontrol/mozversioncontrol/repo/mercurial.py", "tools/tryselect/push.py", "tools/tryselect/tasks.py", "tools/tryselect/util/project.py"], "git_node": "04626c19f4c2b7fa9a96e130b302919eac08c979", "git_parents": ["b21b66afe4d5b5ad091cd54aa7898285f0fd1d7e"], "node": "5b9005b602abaf1ac0e93c7af3ac3474d49c950d", "parents": ["b408c77e3039ef6ca9702ed678ceaaaef9d982d7"], "tags": []}], "date": 1792783933, "git_changesets": ["04626c19f4c2b7fa9a96e130b302919eac08c979"], "user": "dmeehan@mozilla.com"}, "1080": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2070798 - Abort targeting context recording during shutdown  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336203\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_recordTargetingContext.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml"], "git_node": "fc0afc4f4bfc46f8d260b340738eac8b0e4c3710", "git_parents": ["04626c19f4c2b7fa9a96e130b302919eac08c979"], "node": "a3af40e009932a7915c31b19fa74fccf959910b4", "parents": ["5b9005b602abaf1ac0e93c7af3ac3474d49c950d"], "tags": []}], "date": 1792783958, "git_changesets": ["fc0afc4f4bfc46f8d260b340738eac8b0e4c3710"], "user": "dmeehan@mozilla.com"}, "1081": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1753276 - Require signatures for dictionary  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328092\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336181\n", "files": ["browser/components/preferences/tests/languages/browser_browser_languages_subdialog.js", "toolkit/mozapps/extensions/internal/XPIDatabase.sys.mjs", "toolkit/mozapps/extensions/internal/XPIInstall.sys.mjs", "toolkit/mozapps/extensions/internal/XPIProvider.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_AbuseReporter.js", "toolkit/mozapps/extensions/test/xpcshell/test_signed_verify.js"], "git_node": "130a41d5a082fbb3d303404f47a0a49dcbe66682", "git_parents": ["fc0afc4f4bfc46f8d260b340738eac8b0e4c3710"], "node": "aac6e7eb25f609dc7408e975fc1fe9f90f0ad89d", "parents": ["a3af40e009932a7915c31b19fa74fccf959910b4"], "tags": []}], "date": 1792783982, "git_changesets": ["130a41d5a082fbb3d303404f47a0a49dcbe66682"], "user": "dmeehan@mozilla.com"}, "1082": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2079798 - Make GetContextInfo return Maybe  a=dmeehan DONTBUILD\n\nThis involves an inconsistent GlobalTeardownObserver behavior, where mParentGlobal is dropped for objects created before teardown, but it still exists for objects created after teardown.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333327\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336012\n", "files": ["dom/notification/Notification.cpp", "dom/notification/Notification.h", "testing/web-platform/tests/notifications/crashtests/show-and-close.https.html"], "git_node": "0926099ea270bea24e438d83f26372b8ecd9585f", "git_parents": ["130a41d5a082fbb3d303404f47a0a49dcbe66682"], "node": "764144abe3285f948e845c357b6b19f7e967d056", "parents": ["aac6e7eb25f609dc7408e975fc1fe9f90f0ad89d"], "tags": []}], "date": 1792784006, "git_changesets": ["0926099ea270bea24e438d83f26372b8ecd9585f"], "user": "dmeehan@mozilla.com"}, "1083": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082024 - Cache advances during STCH measurement pass.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335149\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335943\n", "files": ["gfx/harfbuzz/moz.yaml", "gfx/harfbuzz/src/hb-ot-shaper-arabic.cc", "gfx/harfbuzz/stch-advance-cache.patch"], "git_node": "1403b6f3d15d9faa889f15a8c4bd9870b4b19c77", "git_parents": ["0926099ea270bea24e438d83f26372b8ecd9585f"], "node": "47b219e6ea0c545191ff895dc5f62b72f34ace44", "parents": ["764144abe3285f948e845c357b6b19f7e967d056"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082024 - Handle hb_scalar_cache_t value quantization.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335155\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335944\n", "files": ["gfx/harfbuzz/hb-scalar-cache-quantization.patch", "gfx/harfbuzz/moz.yaml", "gfx/harfbuzz/src/hb-ot-layout-common.hh", "gfx/harfbuzz/src/hb-ot-var-common.hh"], "git_node": "fbc7c49c9f6988ed0bab0e4ca75cfaab965bd9cc", "git_parents": ["1403b6f3d15d9faa889f15a8c4bd9870b4b19c77"], "node": "42ca65f7a7469cf5981b6626e57a6a82956379f5", "parents": ["47b219e6ea0c545191ff895dc5f62b72f34ace44"], "tags": []}], "date": 1792784055, "git_changesets": ["1403b6f3d15d9faa889f15a8c4bd9870b4b19c77", "fbc7c49c9f6988ed0bab0e4ca75cfaab965bd9cc"], "user": "dmeehan@mozilla.com"}, "1084": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2077802 - ContentList should have strong ref to root node so that it would behave like other browsers.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330609\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335300\n", "files": ["dom/base/ContentList.cpp", "dom/base/ContentList.h", "dom/html/HTMLFormControlsCollection.cpp", "dom/html/HTMLFormControlsCollection.h", "dom/html/HTMLOptionsCollection.cpp", "dom/html/HTMLTableElement.cpp", "testing/web-platform/tests/dom/collections/HTMLCollection-detached-root-gc.html", "testing/web-platform/tests/html/infrastructure/common-dom-interfaces/collections/detached-root-gc.html", "testing/web-platform/tests/shadow-dom/reference-target/tentative/label-lifetime.html"], "git_node": "c3eb71364807af22bb69104cf02b3238b942beca", "git_parents": ["fbc7c49c9f6988ed0bab0e4ca75cfaab965bd9cc"], "node": "f13870f4064710fae22d0430206ba1d7eb391407", "parents": ["42ca65f7a7469cf5981b6626e57a6a82956379f5"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2077803 - ElementInternals attr-element getters should check shared-root.  a=dmeehan\n\nThis follows https://github.com/whatwg/html/pull/8932, which lets\nElementInternals refer to any element that has the same shadow-including root\nas the target element. Chrome does the same, except that it also returns\nelements that are in a different, disconnected tree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330610\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335301\n", "files": ["dom/html/ElementInternals.cpp", "testing/web-platform/tests/custom-elements/element-internals-aria-element-reflection-shadow-including-root.tentative.html"], "git_node": "602a80ff88f9a903f4262b0b83115364f95a1077", "git_parents": ["c3eb71364807af22bb69104cf02b3238b942beca"], "node": "b25f720b5fdb6987a0b297f8eaaa05a25f4e2e37", "parents": ["f13870f4064710fae22d0430206ba1d7eb391407"], "tags": []}], "date": 1792784256, "git_changesets": ["c3eb71364807af22bb69104cf02b3238b942beca", "602a80ff88f9a903f4262b0b83115364f95a1077"], "user": "dmeehan@mozilla.com"}, "1085": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2076891 - Cover more form elements in nsTreeSanitizer  a=dmeehan DONTBUILD\n\n- Move input from MustFlatten to MustPrune (cannot have children).\n- Add output to MustFlatten (can be form elements with children).\n- Add textarea to MustPrune (can be a form element)\n- Drop \"for\" attribute (can reference a form element)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330054\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336306\n", "files": ["dom/base/nsTreeSanitizer.cpp", "dom/base/test/test_bug650776.html", "parser/xml/test/unit/results.js"], "git_node": "c8be3ef666c6df47e2dcb683e7aa6c4ed0eb125e", "git_parents": ["602a80ff88f9a903f4262b0b83115364f95a1077"], "node": "662b52dd252ef90e2c38deec458eead079fbef9e", "parents": ["b25f720b5fdb6987a0b297f8eaaa05a25f4e2e37"], "tags": []}], "date": 1792785994, "git_changesets": ["c8be3ef666c6df47e2dcb683e7aa6c4ed0eb125e"], "user": "dmeehan@mozilla.com"}, "1086": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2080371 - Don't crash late during shutdown in JSActor code.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333899\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334682\n", "files": ["dom/ipc/jsactor/JSActorService.cpp", "dom/ipc/jsactor/JSProcessActorProtocol.cpp"], "git_node": "f29af572034e04c08b638227133de0fe39eb454c", "git_parents": ["c8be3ef666c6df47e2dcb683e7aa6c4ed0eb125e"], "node": "4045fa07e87f42113a775e42558a2459181deed8", "parents": ["662b52dd252ef90e2c38deec458eead079fbef9e"], "tags": []}], "date": 1792786016, "git_changesets": ["f29af572034e04c08b638227133de0fe39eb454c"], "user": "dmeehan@mozilla.com"}, "1087": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2077257 - Improve ThreadSafeWeakPtrHashKey behaviour during an object's destructor, r=sergesanspaille a=dmeehan DONTBUILD\n\nCurrently ThreadSafeWeakPtrHashKey is defined fully in terms of the\nconcrete referenced type, meaning that it cannot work late during an\nobject's lifecycle, after the object's refcount has reached 0 and during\nthe destructor. I expect that removing entries from a table during the\ndestructor is a clear use-case for this type, meaning that it would be\nbetter if we supported this.\n\nThis patch does this by simplifying the handling of `ThreadSafeWeakPtr`\nsuch that it's used directly, and slightly improving the ergonomics of\nthe underlying type so that it can be used directly in this way.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331272\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335325\n", "files": ["dom/indexedDB/IDBDatabase.cpp", "gfx/2d/2D.h", "gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/layers/wr/WebRenderBridgeChild.h", "mfbt/ThreadSafeWeakPtr.h", "xpcom/ds/nsHashKeys.h", "xpcom/ds/nsTHashMap.h", "xpcom/tests/gtest/TestHashtables.cpp"], "git_node": "40b82442d5e0aeae8e84200c35d12764b3922d30", "git_parents": ["f29af572034e04c08b638227133de0fe39eb454c"], "node": "e943d271231b11a608ad390cdb118e23bea17aec", "parents": ["4045fa07e87f42113a775e42558a2459181deed8"], "tags": []}], "date": 1792786098, "git_changesets": ["40b82442d5e0aeae8e84200c35d12764b3922d30"], "user": "dmeehan@mozilla.com"}, "1088": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082537 - Derive the crashreporter Glean app id in a more general way  a=dmeehan\n\nThis looks for \"firefox\" and \"thunderbird\" prefixes and shortens the app\nname to those. For good measure, we compare with the lowercase version\nof the string.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334257\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335620\n", "files": ["toolkit/crashreporter/client/app/src/glean.rs"], "git_node": "d3d2556c544c6d469bbabf5ff62acf86344d3765", "git_parents": ["40b82442d5e0aeae8e84200c35d12764b3922d30"], "node": "e280fcaf92066812ad13e746dca99a120104a0fd", "parents": ["e943d271231b11a608ad390cdb118e23bea17aec"], "tags": []}], "date": 1792786482, "git_changesets": ["d3d2556c544c6d469bbabf5ff62acf86344d3765"], "user": "dmeehan@mozilla.com"}, "1089": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077257 - Fix ESR153 build a=bustage\n", "files": ["dom/indexedDB/IDBDatabase.cpp"], "git_node": "dfc41a541be64bd5436b17606dbb70ef9330b236", "git_parents": ["d3d2556c544c6d469bbabf5ff62acf86344d3765"], "node": "74b64e9b121ff9f9827937f58e29584c44d7b20d", "parents": ["e280fcaf92066812ad13e746dca99a120104a0fd"], "tags": []}, {"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070798 - Abort targeting context recording during shutdown a=dmeehan\" for causing test failures on ESR153\n\nThis reverts commit fc0afc4f4bfc46f8d260b340738eac8b0e4c3710.\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_recordTargetingContext.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml"], "git_node": "bf92ad2c12b0c771008ca3abbcb7592788d9e73b", "git_parents": ["dfc41a541be64bd5436b17606dbb70ef9330b236"], "node": "8aea5309ec0174deaddb02ab2ea65f0114b6ce40", "parents": ["74b64e9b121ff9f9827937f58e29584c44d7b20d"], "tags": []}], "date": 1792789263, "git_changesets": ["dfc41a541be64bd5436b17606dbb70ef9330b236", "bf92ad2c12b0c771008ca3abbcb7592788d9e73b"], "user": "dmeehan@mozilla.com"}, "1090": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067602: Relax asserts that NativeLayerRootCA has no sublayers upon destruction.  a=dmeehan DONTBUILD\n\nIt's not dangerous to have sublayers when the root layer is destroyed,\nbut we still want to catch it in debug builds. Relax the release assert\nin the destructor, and add an assert in RemoveLayer, which *might* be an\nentry point for where we lose track of sublayers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323052\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336282\n", "files": ["gfx/layers/NativeLayerCA.mm"], "git_node": "b6d13785b2503f1e7293cd837d5dad1034b01279", "git_parents": ["bf92ad2c12b0c771008ca3abbcb7592788d9e73b"], "node": "f119f4e9e069eb492d80b72aae6258e6caf222c7", "parents": ["8aea5309ec0174deaddb02ab2ea65f0114b6ce40"], "tags": []}], "date": 1792848443, "git_changesets": ["b6d13785b2503f1e7293cd837d5dad1034b01279"], "user": "dmeehan@mozilla.com"}, "1091": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081887 p1 - Pre-generate the CrashEventID to use for a main process crash  a=dmeehan DONTBUILD\n\nThis avoids running `GenerateUUID()` in the exception handler.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335306\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336255\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/test/unit/head_crashreporter.js"], "git_node": "a1cea6612d4c0338552ebbc012a3ff7cc15a0617", "git_parents": ["b6d13785b2503f1e7293cd837d5dad1034b01279"], "node": "865d1da2edec37dbc87af650aef468bd59aecb7c", "parents": ["f119f4e9e069eb492d80b72aae6258e6caf222c7"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081887 p2 - Use an nsTAutoStringN to avoid heap allocation by NSID_TrimBracketsASCII  a=dmeehan DONTBUILD\n\nThis allows us to use NSID_TrimBracketsASCII in async-signal-safe\ncontexts.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335663\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336256\n", "files": ["xpcom/base/nsIDUtils.h"], "git_node": "0ec9d8b32c2bd6268cfe83d1db9d99b02a6e4242", "git_parents": ["a1cea6612d4c0338552ebbc012a3ff7cc15a0617"], "node": "c2a83f91275c1c3747809736cb8ceeb7e3788d1b", "parents": ["865d1da2edec37dbc87af650aef468bd59aecb7c"], "tags": []}], "date": 1792848468, "git_changesets": ["a1cea6612d4c0338552ebbc012a3ff7cc15a0617", "0ec9d8b32c2bd6268cfe83d1db9d99b02a6e4242"], "user": "dmeehan@mozilla.com"}, "1092": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2071727 - Perform CustomFreeTransferHandler bounds checks outside of fuzzing,  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326661\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336017\n", "files": ["dom/base/StructuredCloneHolder.cpp"], "git_node": "5236c93621adb751d68d150174bb5fcbe77a2142", "git_parents": ["0ec9d8b32c2bd6268cfe83d1db9d99b02a6e4242"], "node": "c349721fea9bf1a7baff2781219896a03964f90e", "parents": ["c2a83f91275c1c3747809736cb8ceeb7e3788d1b"], "tags": []}], "date": 1792848493, "git_changesets": ["5236c93621adb751d68d150174bb5fcbe77a2142"], "user": "dmeehan@mozilla.com"}, "1093": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2068614 - Set mSourceNode after hiding the previous tooltip in MouseMove.  a=dmeehan DONTBUILD\n\nFollow-up to https://hg.mozilla.org/mozilla-central/rev/3bfa78cb60f7\n\ncomm/mail/components/im/test/browser/browser_tooltips.js regressed on\nbug 2001695 and passes again with this: its second task moves the mouse into a\nfresh conversation browser while a node from the first task is still tracked.\n\nnsXULTooltipListener::MouseMove() recorded mSourceNode and ran\nCheckTreeBodyMove() before hiding the tooltip of the node the mouse just left.\nBoth of those HideTooltip() paths end in DestroyTooltip(), which clears\nmSourceNode, so the timer armed a few lines later fired into a ShowTooltip()\nwith no source node: GetTooltipFor(nullptr) fails and no tooltip is shown for\nthe new node, ever.\n\nMove the mSourceNode assignment and CheckTreeBodyMove() call to after the teardown,\nso the source survives for the timer callback.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322942\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336493\n", "files": ["layout/xul/nsXULTooltipListener.cpp"], "git_node": "422cbf6a2a8edc01d35140e79cf6f2fd44bf4108", "git_parents": ["5236c93621adb751d68d150174bb5fcbe77a2142"], "node": "30fd0333e01f037a85f7a07711e305d5708a9a9a", "parents": ["c349721fea9bf1a7baff2781219896a03964f90e"], "tags": []}], "date": 1792848649, "git_changesets": ["422cbf6a2a8edc01d35140e79cf6f2fd44bf4108"], "user": "dmeehan@mozilla.com"}, "1094": {"changesets": [{"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078993 - Don't run scripts between updating two carets.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336063\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336490\n", "files": ["layout/base/AccessibleCaretManager.cpp"], "git_node": "984247b7b36845efc96979a4390516dda722751a", "git_parents": ["422cbf6a2a8edc01d35140e79cf6f2fd44bf4108"], "node": "b8c05c6a808f4836acb408718d0c1abdcbe73c66", "parents": ["30fd0333e01f037a85f7a07711e305d5708a9a9a"], "tags": []}], "date": 1792848867, "git_changesets": ["984247b7b36845efc96979a4390516dda722751a"], "user": "dmeehan@mozilla.com"}, "1095": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083847 - Remove HSTS preload entries for host names that no longer exist. a=RyanVM DONTBUILD\n\nRemoves every entry that is not on Chromium's current preload list, returns an authoritative NXDOMAIN from\npublic resolvers and was unknown-host in two pinning-update runs on different days. Names that exist without\nan address record, return SERVFAIL or never answered stay, since a no-address apex can front a live www. host\nunder includeSubdomains.\n", "files": ["security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "c759a4606dae7372bb01e5f678c0c09142461467", "git_parents": ["984247b7b36845efc96979a4390516dda722751a"], "node": "6a05058ddad2eeffbf7f28d5110d242cfbfa7c15", "parents": ["b8c05c6a808f4836acb408718d0c1abdcbe73c66"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1920886 - Keep the ProcessReader timeout tests' child running well past the timeout. a=test-only DONTBUILD\n\ntest_timeout and test_output_timeout gave their child 0.1s against a 0.05s timeout, so a reader thread that\nstarted or woke late found the child already finished and reported no timeout. The child now sleeps 10s and is\nkilled when the test ends.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336051\n", "files": ["testing/mozbase/mozprocess/tests/test_process_reader.py"], "git_node": "ef80361e4d2417048eb2b49c592185a9c559548d", "git_parents": ["c759a4606dae7372bb01e5f678c0c09142461467"], "node": "49c4fc1140c0bb29cccc80e3424976e3b1d84b9b", "parents": ["6a05058ddad2eeffbf7f28d5110d242cfbfa7c15"], "tags": []}], "date": 1792850399, "git_changesets": ["c759a4606dae7372bb01e5f678c0c09142461467", "ef80361e4d2417048eb2b49c592185a9c559548d"], "user": "rvandermeulen@mozilla.com"}, "1096": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\naf -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nan -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nar -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nast -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\naz -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nbe -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nbg -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nbn -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nbr -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nbs -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nca -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nca-valencia -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\ncak -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\ncs -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\ncy -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nda -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nde -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\ndsb -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nel -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nen-CA -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nen-GB -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\neo -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nes-AR -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nes-CL -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nes-ES -\u003e 3ae91662ee285b44f21ef31b9cae722d132e28ea\nes-MX -\