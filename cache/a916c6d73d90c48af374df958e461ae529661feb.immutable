bfd752e9629aca4ff96044fc55ea2c721a2d46"], "user": "rperta@mozilla.com"}, "1129": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056107 - Validate IsKnownForChildID in RecvCreateBrowsingContext,  a=dmeehan DONTBUILD\n\nThis isn't necessary for the parent because of the earlier check\n(parent-\u003eGetIsContentParent() != this).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313545\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337198\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "3eff5bde3eef51e40d9dbbb5747638978e1d7232", "git_parents": ["d3bfd752e9629aca4ff96044fc55ea2c721a2d46"], "node": "0198aebca07cbc934bb79a974b375b2adffbe61a", "parents": ["c1d06015c860a74b837571090a6b2206efde33ad"], "tags": []}], "date": 1793146488, "git_changesets": ["3eff5bde3eef51e40d9dbbb5747638978e1d7232"], "user": "dmeehan@mozilla.com"}, "1130": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2072096 - Part 1: Ensure all blob:null URIs hold consistent principals,  a=dmeehan DONTBUILD\n\nAdds an extra table which is tracked within the protocol handler to\ntrack associations between blob: URLs, and their content principals, to\nensure that they remain consistent. This is tracked by the Blob data\nentry as well as all parsed Blob URLs within the process.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331351\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337214\n", "files": ["dom/file/uri/BlobURL.cpp", "dom/file/uri/BlobURL.h", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/file/uri/BlobURLProtocolHandler.h", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentParent.cpp"], "git_node": "7714a0efd3f817fb63f1728abc8307afb3e5733d", "git_parents": ["3eff5bde3eef51e40d9dbbb5747638978e1d7232"], "node": "d39eef2634d45780f3708466b4a7ec58aad122a0", "parents": ["0198aebca07cbc934bb79a974b375b2adffbe61a"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2072096 - Part 2: Clarify meaning of BlobURL::GetNullPrincipal,  a=dmeehan DONTBUILD\n\nThe type is now explicitly `NullOrigin` to make it more clear that it\ncan also apply to content principals in addition to null principals in\nthe case where the origin doesn't have a web-exposed origin\nserialization (e.g. `file://` URIs).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333748\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337215\n", "files": ["dom/file/uri/BlobURL.cpp", "dom/file/uri/BlobURL.h", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/file/uri/BlobURLProtocolHandler.h", "ipc/glue/URIParams.ipdlh"], "git_node": "ac6e85995e64320f22ae616505532f45177ec51b", "git_parents": ["7714a0efd3f817fb63f1728abc8307afb3e5733d"], "node": "7013c9fd7039ea967b8973187b664e2d4339268b", "parents": ["d39eef2634d45780f3708466b4a7ec58aad122a0"], "tags": []}], "date": 1793146512, "git_changesets": ["7714a0efd3f817fb63f1728abc8307afb3e5733d", "ac6e85995e64320f22ae616505532f45177ec51b"], "user": "dmeehan@mozilla.com"}, "1131": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2060230 - Consider TriggeringRemoteType in IsolationOptionsForNavigation,  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333354\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337303\n", "files": ["dom/ipc/ProcessIsolation.cpp"], "git_node": "bf99339aff06e803c782e93e01e32bc91a5abb3f", "git_parents": ["ac6e85995e64320f22ae616505532f45177ec51b"], "node": "715995d904df7412679d2b34ef20490290240fd0", "parents": ["7013c9fd7039ea967b8973187b664e2d4339268b"], "tags": []}], "date": 1793146544, "git_changesets": ["bf99339aff06e803c782e93e01e32bc91a5abb3f"], "user": "dmeehan@mozilla.com"}, "1132": {"changesets": [{"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081380:.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335800\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337307\n", "files": ["layout/style/nsComputedDOMStyle.cpp"], "git_node": "44fa71c06b513b100e9da69f22a3b7315a728d09", "git_parents": ["bf99339aff06e803c782e93e01e32bc91a5abb3f"], "node": "f15b59e1bba8dd36a8cb914377ee3fa6b2b8373e", "parents": ["715995d904df7412679d2b34ef20490290240fd0"], "tags": []}], "date": 1793146567, "git_changesets": ["44fa71c06b513b100e9da69f22a3b7315a728d09"], "user": "dmeehan@mozilla.com"}, "1133": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081982.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335399\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337222\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "d313cd461374e29a41ad59def52541f4d318fb25", "git_parents": ["44fa71c06b513b100e9da69f22a3b7315a728d09"], "node": "e0752ab6d5ecc8980f85931f09ff13784fdfb6ea", "parents": ["f15b59e1bba8dd36a8cb914377ee3fa6b2b8373e"], "tags": []}], "date": 1793146753, "git_changesets": ["d313cd461374e29a41ad59def52541f4d318fb25"], "user": "dmeehan@mozilla.com"}, "1134": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update HSTS HPKP remote-settings ct-logs  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336890\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "a19d5fb5008be281e78a5a3290194591599276b7", "git_parents": ["d313cd461374e29a41ad59def52541f4d318fb25"], "node": "d89c904a9d1e6b19a954bf5bb16d8fd18899978f", "parents": ["e0752ab6d5ecc8980f85931f09ff13784fdfb6ea"], "tags": []}], "date": 1793160394, "git_changesets": ["a19d5fb5008be281e78a5a3290194591599276b7"], "user": "rvandermeulen@mozilla.com"}, "1135": {"changesets": [{"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1847625 - Apply auth prompt spoofing protection when the current page is an error page.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334991\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337525\n", "files": ["browser/base/content/test/tabPrompts/browser_auth_spoofing_protection.js", "toolkit/components/prompts/src/Prompter.sys.mjs"], "git_node": "d71ccca67ecc41b1ba60c4e1d3aae8b2f4909b82", "git_parents": ["a19d5fb5008be281e78a5a3290194591599276b7"], "node": "97bc1b37c04aba6faa44d35439c166b28b6c0248", "parents": ["d89c904a9d1e6b19a954bf5bb16d8fd18899978f"], "tags": []}], "date": 1793190695, "git_changesets": ["d71ccca67ecc41b1ba60c4e1d3aae8b2f4909b82"], "user": "dmeehan@mozilla.com"}, "1136": {"changesets": [{"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081939: Avoid duplicating frames that escape repeating headers.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336318\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337314\n", "files": ["layout/base/crashtests/crashtests.list", "layout/base/nsCSSFrameConstructor.cpp", "layout/reftests/bugs/reftest.list"], "git_node": "628c021dfaa97c874c28c09173a0461dde1b8eb5", "git_parents": ["d71ccca67ecc41b1ba60c4e1d3aae8b2f4909b82"], "node": "09d45210824cc3470b6260dc0a9487649fe11912", "parents": ["97bc1b37c04aba6faa44d35439c166b28b6c0248"], "tags": []}], "date": 1793191163, "git_changesets": ["628c021dfaa97c874c28c09173a0461dde1b8eb5"], "user": "dmeehan@mozilla.com"}, "1137": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2082205 - Make `HTMLEditor::ReapplyCachedStyles` clone the cached style while it computes the preserving styles  a=dmeehan DONTBUILD\n\nThat requires to flush pending notifications at computing current style.\nTherefore, it should clone the cached styles first. Then, it should\nhandle only the original caches styles.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334438\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337352\n", "files": ["editor/libeditor/HTMLEditSubActionHandler.cpp"], "git_node": "49dca69aff34a74251d60b915af8875819d54909", "git_parents": ["628c021dfaa97c874c28c09173a0461dde1b8eb5"], "node": "b412debd0093e51286ad63acd80637c51da3fe5a", "parents": ["09d45210824cc3470b6260dc0a9487649fe11912"], "tags": []}], "date": 1793191184, "git_changesets": ["49dca69aff34a74251d60b915af8875819d54909"], "user": "dmeehan@mozilla.com"}, "1138": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082350 - Notify on attributes set on custom elements from parser  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337192\n", "files": ["parser/html/nsHtml5TreeOperation.cpp", "parser/html/nsHtml5TreeOperation.h"], "git_node": "4daf0807127087c747aeaa8408a0e695ada7a95e", "git_parents": ["49dca69aff34a74251d60b915af8875819d54909"], "node": "fa9ba0c7ba00adaa54ae885adbdb0e668ebc6dee", "parents": ["b412debd0093e51286ad63acd80637c51da3fe5a"], "tags": []}], "date": 1793191646, "git_changesets": ["4daf0807127087c747aeaa8408a0e695ada7a95e"], "user": "dmeehan@mozilla.com"}, "1139": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081939 - ESR153 build fix a=bustage\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "8ab42c9a701f00adc81979a7f4ad34986e9f16ca", "git_parents": ["4daf0807127087c747aeaa8408a0e695ada7a95e"], "node": "0401d0762b809fdedf8038d50ebc7c9d297fa304", "parents": ["fa9ba0c7ba00adaa54ae885adbdb0e668ebc6dee"], "tags": []}], "date": 1793196849, "git_changesets": ["8ab42c9a701f00adc81979a7f4ad34986e9f16ca"], "user": "dmeehan@mozilla.com"}, "1140": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076414 - Clean up DOMMediaStream listener handling.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334724\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337577\n", "files": ["dom/media/DOMMediaStream.cpp", "dom/media/DOMMediaStream.h"], "git_node": "8353c61ffd2edf0b748802cc35f958ad92890d4c", "git_parents": ["8ab42c9a701f00adc81979a7f4ad34986e9f16ca"], "node": "1cc69d296220344f79248dbacbea65f289bdb5dc", "parents": ["0401d0762b809fdedf8038d50ebc7c9d297fa304"], "tags": []}], "date": 1793200944, "git_changesets": ["8353c61ffd2edf0b748802cc35f958ad92890d4c"], "user": "dmeehan@mozilla.com"}, "1141": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074194 - Tidy up MediaDecoder metadata event handling.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330287\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337585\n", "files": ["dom/media/MediaDecoder.cpp", "dom/media/MediaDecoder.h"], "git_node": "1cd5daa7755e69b0f89914dfa7547dc4dfe0c88d", "git_parents": ["8353c61ffd2edf0b748802cc35f958ad92890d4c"], "node": "7e5ea41c6313715af6858f9a2634298f68e75f57", "parents": ["1cc69d296220344f79248dbacbea65f289bdb5dc"], "tags": []}], "date": 1793200965, "git_changesets": ["1cd5daa7755e69b0f89914dfa7547dc4dfe0c88d"], "user": "dmeehan@mozilla.com"}, "1142": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050623 - Refresh Expat local patches.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308888\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337367\n", "files": ["parser/expat/00_xmlchar.patch", "parser/expat/01_noslop.patch", "parser/expat/02_report_mismatched_tag.patch", "parser/expat/03_dont_generate_salt.patch", "parser/expat/04_always_set_eventptrs.patch", "parser/expat/05_getcurrentbyteindex.patch", "parser/expat/06_always_store_rawnames.patch", "parser/expat/07_dont_ignore_undeclared_entity.patch", "parser/expat/08_include_xmlns.patch", "parser/expat/09_internalsubset.patch", "parser/expat/10_version_limit.patch", "parser/expat/11_no_debug_report.patch", "parser/expat/12_unused.patch"], "git_node": "954f09c34b8ac2f532f3c3e6a58d89112db3bc12", "git_parents": ["1cd5daa7755e69b0f89914dfa7547dc4dfe0c88d"], "node": "3dd74a719b961a4ebcc84958372addc0a48902d4", "parents": ["7e5ea41c6313715af6858f9a2634298f68e75f57"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050623 - Update to Expat 2.8.2.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308889\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337368\n", "files": ["parser/expat/expat/lib/expat.h", "parser/expat/expat/lib/fallthrough.h", "parser/expat/expat/lib/siphash.h", "parser/expat/expat/lib/xcsinc.c", "parser/expat/expat/lib/xmlparse.c", "parser/expat/expat/lib/xmltok.c", "parser/expat/expat/lib/xmltok_impl.c", "parser/expat/moz.build", "parser/expat/moz.yaml"], "git_node": "5811382285d86a7d2a61934bccc8bca7cf9ca1bd", "git_parents": ["954f09c34b8ac2f532f3c3e6a58d89112db3bc12"], "node": "7105ad15aa3dca9cd006c929be3cae003f6a082d", "parents": ["3dd74a719b961a4ebcc84958372addc0a48902d4"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062946. Fix the path in expat's 13_high_surrogate_mask.patch.  a=dmeehan\n\nThe patch added in bug 2053153 names the file it changes expat/expat/lib/xmltok.c,\nwith expat/ doubled, while the other thirteen expat patches use expat/lib/... . The\npatches are applied with `patch -p1 --directory parser/expat`, so patch could not find\na file at that path, skipped the whole patch and counted its hunk as ignored. The\nchange was in the tree anyway, so nothing looked wrong, but re-vendoring expat dropped\nit and left upstream's mask, and the next update of expat would have done the same.\n\nWith this, `./mach vendor parser/expat/moz.yaml -r R_2_8_2 --patch-mode check --force`\nreproduces the committed tree exactly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318092\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337369\n", "files": ["parser/expat/13_high_surrogate_mask.patch"], "git_node": "4dbadbdf37e229a49ef535abe131c838ec96fb0e", "git_parents": ["5811382285d86a7d2a61934bccc8bca7cf9ca1bd"], "node": "fde2e9c885f56785937a22b7e345d2eabb78a45e", "parents": ["7105ad15aa3dca9cd006c929be3cae003f6a082d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064164 - Remove obsolete Expat 01_noslop.patch.  a=dmeehan\n\nThe patch tuned INIT_BLOCK_SIZE so that poolGrow() allocations landed exactly on a\nmozjemalloc size class. Expat 2.7.2's CVE-2025-59375 fix routes every allocation through\nexpat_malloc(), which prepends an 8-byte header, so the request no longer lands where the\ntuning intended. It is moot regardless: expat is compiled into the wasm sandbox in all\nshipping configurations and uses dlmalloc there, which has no jemalloc-style size classes.\n\nThe remaining patches are renumbered to close the gap. Their contents are untouched, so they\napply at an offset until the hunk headers get regenerated as part of the next upstream\nupdate.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320106\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337370\n", "files": ["parser/expat/01_noslop.patch", "parser/expat/01_report_mismatched_tag.patch", "parser/expat/02_dont_generate_salt.patch", "parser/expat/02_report_mismatched_tag.patch", "parser/expat/03_always_set_eventptrs.patch", "parser/expat/03_dont_generate_salt.patch", "parser/expat/04_always_set_eventptrs.patch", "parser/expat/04_getcurrentbyteindex.patch", "parser/expat/05_always_store_rawnames.patch", "parser/expat/05_getcurrentbyteindex.patch", "parser/expat/06_always_store_rawnames.patch", "parser/expat/06_dont_ignore_undeclared_entity.patch", "parser/expat/07_dont_ignore_undeclared_entity.patch", "parser/expat/07_include_xmlns.patch", "parser/expat/08_include_xmlns.patch", "parser/expat/08_internalsubset.patch", "parser/expat/09_internalsubset.patch", "parser/expat/09_version_limit.patch", "parser/expat/10_no_debug_report.patch", "parser/expat/10_version_limit.patch", "parser/expat/11_no_debug_report.patch", "parser/expat/11_unused.patch", "parser/expat/12_high_surrogate_mask.patch", "parser/expat/12_unused.patch", "parser/expat/13_high_surrogate_mask.patch", "parser/expat/expat/lib/xmlparse.c", "parser/expat/moz.yaml"], "git_node": "49e3c12026ca7ff5c327ab913f563ad79a6e473b", "git_parents": ["4dbadbdf37e229a49ef535abe131c838ec96fb0e"], "node": "a4c8f84752be9c05ea1454a5799ebb26feaa4374", "parents": ["fde2e9c885f56785937a22b7e345d2eabb78a45e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062690 - Refresh Expat local patches for 2.8.3.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318006\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337371\n", "files": ["parser/expat/00_xmlchar.patch", "parser/expat/01_report_mismatched_tag.patch", "parser/expat/02_dont_generate_salt.patch", "parser/expat/03_always_set_eventptrs.patch", "parser/expat/04_getcurrentbyteindex.patch", "parser/expat/05_always_store_rawnames.patch", "parser/expat/06_dont_ignore_undeclared_entity.patch", "parser/expat/07_include_xmlns.patch", "parser/expat/08_internalsubset.patch", "parser/expat/09_version_limit.patch", "parser/expat/10_no_debug_report.patch", "parser/expat/11_unused.patch"], "git_node": "244f68883f309b4d45c5ce9d8168c13937a465f0", "git_parents": ["49e3c12026ca7ff5c327ab913f563ad79a6e473b"], "node": "347fba046ec58884898757d22c059f06714f16e1", "parents": ["a4c8f84752be9c05ea1454a5799ebb26feaa4374"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062690 - Update to Expat 2.8.3.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337372\n", "files": ["parser/expat/12_high_surrogate_mask.patch", "parser/expat/expat/lib/ascii.h", "parser/expat/expat/lib/asciitab.h", "parser/expat/expat/lib/expat.h", "parser/expat/expat/lib/expat_external.h", "parser/expat/expat/lib/fallthrough.h", "parser/expat/expat/lib/iasciitab.h", "parser/expat/expat/lib/internal.h", "parser/expat/expat/lib/latin1tab.h", "parser/expat/expat/lib/nametab.h", "parser/expat/expat/lib/siphash.h", "parser/expat/expat/lib/utf8tab.h", "parser/expat/expat/lib/winconfig.h", "parser/expat/expat/lib/xcsinc.c", "parser/expat/expat/lib/xmlparse.c", "parser/expat/expat/lib/xmlrole.c", "parser/expat/expat/lib/xmlrole.h", "parser/expat/expat/lib/xmltok.c", "parser/expat/expat/lib/xmltok.h", "parser/expat/expat/lib/xmltok_impl.c", "parser/expat/expat/lib/xmltok_impl.h", "parser/expat/expat/lib/xmltok_ns.c", "parser/expat/moz.yaml"], "git_node": "d0d98ef0477c5a1c4f1fcdc78c1eccc4ecc36323", "git_parents": ["244f68883f309b4d45c5ce9d8168c13937a465f0"], "node": "096ae4f10d744e1adfcd82e03e7fa0b91777169d", "parents": ["347fba046ec58884898757d22c059f06714f16e1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062690 - Refresh Expat local patches for 2.8.4.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322436\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337373\n", "files": ["parser/expat/00_xmlchar.patch", "parser/expat/01_report_mismatched_tag.patch", "parser/expat/02_dont_generate_salt.patch", "parser/expat/03_always_set_eventptrs.patch", "parser/expat/04_getcurrentbyteindex.patch", "parser/expat/05_always_store_rawnames.patch", "parser/expat/06_dont_ignore_undeclared_entity.patch", "parser/expat/07_include_xmlns.patch", "parser/expat/08_internalsubset.patch", "parser/expat/10_no_debug_report.patch", "parser/expat/11_unused.patch"], "git_node": "c2378976461df38c4f5158abc9300a2d5d1f3b42", "git_parents": ["d0d98ef0477c5a1c4f1fcdc78c1eccc4ecc36323"], "node": "aca7907e9ad5a4356872e8b3c7918fc1fd378730", "parents": ["096ae4f10d744e1adfcd82e03e7fa0b91777169d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062690 - Update to Expat 2.8.4.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322437\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337374\n", "files": ["parser/expat/expat/lib/expat.h", "parser/expat/expat/lib/internal.h", "parser/expat/expat/lib/xmlparse.c", "parser/expat/expat/lib/xmltok.h", "parser/expat/moz.yaml"], "git_node": "750ecdaea7284ea74e4d610eda65ae1a2d3be969", "git_parents": ["c2378976461df38c4f5158abc9300a2d5d1f3b42"], "node": "19f8601d506b8bc40c8db4f0e8fc28cd1ebf7037", "parents": ["aca7907e9ad5a4356872e8b3c7918fc1fd378730"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2069703. Use the correct path for three upstream filenames in parser/expat/moz.yaml's include list.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323902\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337375\n", "files": ["parser/expat/expat/AUTHORS", "parser/expat/expat/Changes", "parser/expat/expat/README.md", "parser/expat/moz.yaml"], "git_node": "08889c4f9e1025c0800a5cf6ec0ecb3ecdaea235", "git_parents": ["750ecdaea7284ea74e4d610eda65ae1a2d3be969"], "node": "e3d032b806b2407c96136ed733adecfbeac45e7c", "parents": ["19f8601d506b8bc40c8db4f0e8fc28cd1ebf7037"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074541 - Refresh Expat local patches for 2.8.5.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328275\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337376\n", "files": ["parser/expat/00_xmlchar.patch", "parser/expat/01_report_mismatched_tag.patch", "parser/expat/02_dont_generate_salt.patch", "parser/expat/03_always_set_eventptrs.patch", "parser/expat/04_getcurrentbyteindex.patch", "parser/expat/05_always_store_rawnames.patch", "parser/expat/06_dont_ignore_undeclared_entity.patch", "parser/expat/07_include_xmlns.patch", "parser/expat/08_internalsubset.patch", "parser/expat/09_version_limit.patch", "parser/expat/10_no_debug_report.patch", "parser/expat/11_unused.patch"], "git_node": "40268b83b3b5f1d22c8f7b465d920e008ef7ee73", "git_parents": ["08889c4f9e1025c0800a5cf6ec0ecb3ecdaea235"], "node": "39a8780e0991cbf7eb5db33b09538aa05f8aa296", "parents": ["e3d032b806b2407c96136ed733adecfbeac45e7c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074541 - Update to Expat 2.8.5.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328276\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337377\n", "files": ["parser/expat/expat/Changes", "parser/expat/expat/README.md", "parser/expat/expat/lib/.gitignore", "parser/expat/expat/lib/expat.h", "parser/expat/expat/lib/expat_external.h", "parser/expat/expat/lib/hash_table.h", "parser/expat/expat/lib/internal.h", "parser/expat/expat/lib/xmlparse.c", "parser/expat/expat/lib/xmlrole.c", "parser/expat/expat/lib/xmlrole.h", "parser/expat/expat/lib/xmltok.c", "parser/expat/expat/lib/xmltok.h", "parser/expat/expat/lib/xmltok_impl.c", "parser/expat/expat/lib/xmltok_ns.c", "parser/expat/moz.yaml"], "git_node": "932a5fb41d8dfe7a7924c2e5e49483aea92f19a9", "git_parents": ["40268b83b3b5f1d22c8f7b465d920e008ef7ee73"], "node": "d288f86fed9eb031e7d48869e546935508641a19", "parents": ["39a8780e0991cbf7eb5db33b09538aa05f8aa296"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083666 - Remove the now-redundant Expat version-limit patch.  a=dmeehan\n\nExpat 2.8.5 added its own `checkXmlDeclVersionNum` check that accepts the XML Fifth Edition's \"1.[0-9]+\"\nVersionNum grammar. Our local 09_version_limit.patch ran its own, stricter \"1.0\" exact match right after it,\nso the new upstream check had no effect and xml-prolog-accepted-versions.html stayed failing after the 2.8.5\nupdate.\n\nRemoving our check (rather than disabling upstream's) takes the Fifth Edition behavior upstream already\nimplements, which is also closer to Chrome's.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335343\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337378\n", "files": ["parser/expat/09_version_limit.patch", "parser/expat/expat/lib/xmltok.c", "parser/expat/moz.yaml", "testing/web-platform/meta/xml/xml-prolog-accepted-versions.html.ini"], "git_node": "66dc8b6fffe1d3ed37abf4b6216b0336919ad3d5", "git_parents": ["932a5fb41d8dfe7a7924c2e5e49483aea92f19a9"], "node": "1b52c9fc440b60203f0839c59a7ba7137f346e55", "parents": ["d288f86fed9eb031e7d48869e546935508641a19"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083667 - Add a WPT for XML innerHTML rejecting a lone unpaired surrogate.  a=dmeehan\n\nExpat 2.8.5 (bug 2074541) rejects a lone UTF-16 high surrogate as not well-formed, so setting innerHTML on an\nXML document to one now throws a SyntaxError DOMException instead of inserting the raw surrogate and part of\nthe markup after it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335344\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337379\n", "files": ["testing/web-platform/tests/xml/xml-innerHTML-unpaired-surrogate.html"], "git_node": "5c8aa4ed7606aef3cedcd119a2d1a707962dc25b", "git_parents": ["66dc8b6fffe1d3ed37abf4b6216b0336919ad3d5"], "node": "aede18dd94dc2d45b2ac0595a775cc31742b7562", "parents": ["1b52c9fc440b60203f0839c59a7ba7137f346e55"], "tags": []}], "date": 1793201531, "git_changesets": ["954f09c34b8ac2f532f3c3e6a58d89112db3bc12", "5811382285d86a7d2a61934bccc8bca7cf9ca1bd", "4dbadbdf37e229a49ef535abe131c838ec96fb0e", "49e3c12026ca7ff5c327ab913f563ad79a6e473b", "244f68883f309b4d45c5ce9d8168c13937a465f0", "d0d98ef0477c5a1c4f1fcdc78c1eccc4ecc36323", "c2378976461df38c4f5158abc9300a2d5d1f3b42", "750ecdaea7284ea74e4d610eda65ae1a2d3be969", "08889c4f9e1025c0800a5cf6ec0ecb3ecdaea235", "40268b83b3b5f1d22c8f7b465d920e008ef7ee73", "932a5fb41d8dfe7a7924c2e5e49483aea92f19a9", "66dc8b6fffe1d3ed37abf4b6216b0336919ad3d5", "5c8aa4ed7606aef3cedcd119a2d1a707962dc25b"], "user": "dmeehan@mozilla.com"}, "1143": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2055554 - Part 1: Add stripping OriginAttributes comparators,  a=dmeehan DONTBUILD\n\nAdd some extra comparators to OriginAttributes. These will be used in\nlater parts.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312532\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337208\n", "files": ["caps/OriginAttributes.h", "caps/tests/gtest/TestOriginAttributes.cpp", "dom/ipc/ProcessIsolation.cpp"], "git_node": "23549c22dd54b144da6e6c9f880d77f6e5ad0d03", "git_parents": ["5c8aa4ed7606aef3cedcd119a2d1a707962dc25b"], "node": "bbeb35bc2250b94fb2fc3c211b82013883719d12", "parents": ["aede18dd94dc2d45b2ac0595a775cc31742b7562"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2055554 - Part 2: Track loaded origins in content processes,  a=dmeehan DONTBUILD\n\nAdd a number of changes to track which origins are loaded in each\ncontent process. This adds a new API to nsIDOMProcessParent\n(AboutToLoadOrigin), which will start tracking this information.\n\nIn order to allow this to be shared with BlobURL broadcast checking, a\nmulti-tier map is used, tracking OAs-\u003eoriginNoSuffix-\u003eloadedAsOrigin,\nwhich allows tracking both sites and origins in a single data structure.\n\nTo align with the way we've previously handled BlobURL broadcasting,\nthis does actually track null principals, though that's unlikely to be\nusable yet. Unfortunately this could lead to a number of \"useless\"\nentries in the table. Future improvements could help things here\nfurther.\n\nNotably, this also tracks whether or not the system principal has been\nloaded in the process, which is intended to allow us to further tighten\nsystem principal checks in content.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312533\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337209\n", "files": ["docshell/base/BrowsingContext.cpp", "dom/interfaces/base/nsIRemoteTab.idl", "dom/ipc/BrowserHost.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/InProcessImpl.cpp", "dom/ipc/LoadedOriginSet.cpp", "dom/ipc/LoadedOriginSet.h", "dom/ipc/PContent.ipdl", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/moz.build", "dom/ipc/nsIDOMProcessParent.idl", "dom/serviceworkers/ServiceWorkerManager.cpp", "dom/workers/remoteworkers/RemoteWorkerChild.cpp", "dom/workers/remoteworkers/RemoteWorkerManager.cpp", "extensions/permissions/PermissionManager.cpp", "extensions/permissions/PermissionManager.h", "netwerk/ipc/DocumentLoadListener.cpp", "toolkit/components/ml/content/EngineProcess.sys.mjs", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "053db1dec423b96ebde26c8f59d681d5f71d0ac9", "git_parents": ["23549c22dd54b144da6e6c9f880d77f6e5ad0d03"], "node": "5b32f8196cf5303f06e6989f6249f5f4f8bbb6e0", "parents": ["bbeb35bc2250b94fb2fc3c211b82013883719d12"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2055554 - Part 3: Check loaded sites in ValidatePrincipal,  a=dmeehan DONTBUILD\n\nUse the loaded origin tracking from the pervious part in\nValidatePrincipal, and update call-sites to specify flags which modify\nthe behaviour here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312534\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337210\n", "files": ["docshell/base/BrowsingContextGroup.cpp", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellLoadState.cpp", "dom/cache/PrincipalVerifier.cpp", "dom/clients/manager/ClientHandleOpParent.cpp", "dom/clients/manager/ClientHandleParent.cpp", "dom/clients/manager/ClientManagerOpParent.cpp", "dom/clients/manager/ClientSource.cpp", "dom/clients/manager/ClientSourceParent.cpp", "dom/clients/manager/ClientValidation.cpp", "dom/clients/manager/ClientValidation.h", "dom/cookiestore/CookieStoreParent.cpp", "dom/fetch/FetchParent.cpp", "dom/fs/child/FileSystemBackgroundRequestHandler.cpp", "dom/indexedDB/IndexedDBCommon.cpp", "dom/ipc/BrowserHost.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/LoadedOriginSet.cpp", "dom/ipc/LoadedOriginSet.h", "dom/ipc/ProcessIsolation.cpp", "dom/ipc/ProcessIsolation.h", "dom/ipc/WindowGlobalParent.cpp", "dom/localstorage/ActorsParent.cpp", "dom/security/nsContentSecurityManager.cpp", "dom/serviceworkers/ServiceWorkerContainerParent.cpp", "ipc/glue/BackgroundImpl.cpp", "ipc/glue/BackgroundParent.h", "ipc/glue/BackgroundParentImpl.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "1bff72c18a19621587eeb21262cad338c77094f6", "git_parents": ["053db1dec423b96ebde26c8f59d681d5f71d0ac9"], "node": "3e72f9e28fe7a3b2ab607a96a986cc2b666c34b5", "parents": ["5b32f8196cf5303f06e6989f6249f5f4f8bbb6e0"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2050774 - Part 1: Consider precursor origin in ValidatePrincipal,  a=dmeehan DONTBUILD\n\nAn extra tier is added to LoadedOriginSet to track site-origins which\nare only loaded as a null principal precursor. This is then used by\nValidatePrincipal to allow these loaded origins only during precursor\nprincipal validation.\n\nIn order to add this extra level, there are a few simplifications made\nto the LoadedOriginSet type as well, changing the signature of a few\ntypes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319631\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337211\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/LoadedOriginSet.cpp", "dom/ipc/LoadedOriginSet.h", "dom/ipc/ProcessIsolation.cpp", "dom/ipc/ProcessIsolation.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "59e906c704e32d61808ce4c6bc8f61e9de096ef8", "git_parents": ["1bff72c18a19621587eeb21262cad338c77094f6"], "node": "c41de7a7a91802354672bf66737d96ce281c096d", "parents": ["3e72f9e28fe7a3b2ab607a96a986cc2b666c34b5"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2050774 - Part 2: Trust PrincipalToInherit from HTTP(s) redirects,  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321321\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337212\n", "files": ["dom/ipc/ContentChild.cpp", "dom/security/nsContentSecurityManager.cpp", "netwerk/base/LoadInfo.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/TRRLoadInfo.cpp", "netwerk/base/nsILoadInfo.idl", "netwerk/ipc/DocumentChannelChild.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "85b2792d371bc7cc4309d763453387e6e132e2b0", "git_parents": ["59e906c704e32d61808ce4c6bc8f61e9de096ef8"], "node": "bdde45ca93163269286147448c93a1d5c5faa7f7", "parents": ["c41de7a7a91802354672bf66737d96ce281c096d"], "tags": []}], "date": 1793208379, "git_changesets": ["23549c22dd54b144da6e6c9f880d77f6e5ad0d03", "053db1dec423b96ebde26c8f59d681d5f71d0ac9", "1bff72c18a19621587eeb21262cad338c77094f6", "59e906c704e32d61808ce4c6bc8f61e9de096ef8", "85b2792d371bc7cc4309d763453387e6e132e2b0"], "user": "dmeehan@mozilla.com"}, "1144": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052908 - Add a backstop timeout for a channel wedged waiting on a cache entry.  a=dmeehan DONTBUILD\n\nA channel that opens a cache entry asynchronously parks in AwaitingCacheCallbacks\nuntil OnCacheEntryAvailable fires. Nothing bounds that wait, so if the entry is\nleft perpetually \"being written\" (e.g. by a writer that was suspended or\ncancelled without ever closing its output stream), the load neither proceeds nor\ntimes out.\n\nAdd a one-shot backstop timer, armed while the channel is parked waiting for the\ncache entry and cancelled once the callback arrives. When it fires the channel\nstops waiting and races to the network so the load can make progress instead of\nhanging forever. The timeout is controlled by network.cache.entry_wait_timeout_ms\n(default 30s, 0 disables) and is kept generous so it never fires for legitimately\nslow concurrent reads/writes of large resources.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310750\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336971\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h"], "git_node": "542b72b90641acfff5ddeadfc79b02646bda173b", "git_parents": ["85b2792d371bc7cc4309d763453387e6e132e2b0"], "node": "762ceec019dbb2898233f5b39b66bc2f9f421dd9", "parents": ["bdde45ca93163269286147448c93a1d5c5faa7f7"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052908 - Release cache consumers parked behind a bypassed writer lock.  a=dmeehan DONTBUILD\n\nWhen a cache entry writer is suspended or stalled for too long, the suspend\ntimer sets the entry writer-lock bypass (SetBypassWriterLock). That already lets\nnew callbacks through the WRITING/REVALIDATING gate, but a consumer that has\nalready passed OnCacheEntryCheck and is waiting for the write to finish\n(RECHECK_AFTER_WRITE_FINISHED) is gated solely on the data being complete, so it\nkeeps getting re-queued and never wakes -- the load hangs forever.\n\nHonor mBypassWriterLock on that path too: when the bypass is set and the data is\nstill in progress, hand the consumer the entry as \"not wanted\"\n(NS_ERROR_CACHE_KEY_NOT_FOUND) so it falls back to the network instead of\ndeadlocking.\n\nAdds gtests for the cache-layer behavior (a bypassed writer lock releases a\nparked consumer; dooming a being-written entry releases a parked consumer) and\nan xpcshell test that reproduces the end-to-end hang: a no-cache writer stranded\nmid-write must not wedge a later same-URL request.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310751\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336972\n", "files": ["netwerk/cache2/CacheEntry.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/gtest/TestCacheEntryWriterHang.cpp", "netwerk/test/gtest/moz.build", "netwerk/test/unit/test_cache2-42-no_cache_writer_hang.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "4b5df1ce32700e24bbcf4bcc4cb5dca5d7fa9d83", "git_parents": ["542b72b90641acfff5ddeadfc79b02646bda173b"], "node": "8bf9b07039f58bc7bd98367ac0ebef0328cb10bc", "parents": ["762ceec019dbb2898233f5b39b66bc2f9f421dd9"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052908 - Tear down a suspended cache writer on cancel instead of stranding it.  a=dmeehan DONTBUILD\n\nWhen a channel is suspended after examining the response to await asynchronous\ntracking-protection annotation (bug 2030021) and is then cancelled while still\nsuspended, nsHttpChannel::CancelInternal defers the terminal teardown\n(CloseCacheEntry / AsyncAbort) to a Resume() that may never arrive. For a cache\nwriter this strands the entry perpetually \"being written\" -- its output stream\nnever closed and the entry never doomed -- wedging every later same-URL\nrevalidating consumer.\n\nUndo the annotation suspension in CancelInternal so the cancelled pump delivers\nOnStopRequest and the write-only entry is closed/doomed through the normal path.\nThis is a no-op if the channel only primed but never actually suspended.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310752\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336973\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h"], "git_node": "bd895f5635be3e5dcdeb21e3609ea3d5b840719c", "git_parents": ["4b5df1ce32700e24bbcf4bcc4cb5dca5d7fa9d83"], "node": "c81478831036fc7d4cfef3fb49834a18a31c22ef", "parents": ["8bf9b07039f58bc7bd98367ac0ebef0328cb10bc"], "tags": []}], "date": 1793208417, "git_changesets": ["542b72b90641acfff5ddeadfc79b02646bda173b", "4b5df1ce32700e24bbcf4bcc4cb5dca5d7fa9d83", "bd895f5635be3e5dcdeb21e3609ea3d5b840719c"], "user": "dmeehan@mozilla.com"}, "1145": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072437: Serialize the cache-entry check with the cache-wait backstop and discard its state on timeout  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327235\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337407\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h"], "git_node": "0db5bb731b2cf63934541cb51bca40a7de57a608", "git_parents": ["bd895f5635be3e5dcdeb21e3609ea3d5b840719c"], "node": "b0a98270c07082079ed14afb48747845667d8690", "parents": ["c81478831036fc7d4cfef3fb49834a18a31c22ef"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081949: Discard state from a previous cache-entry check when the entry is checked again  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333972\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337408\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "82954dec4af8cd86b94abbfa508f8a1cad087a60", "git_parents": ["0db5bb731b2cf63934541cb51bca40a7de57a608"], "node": "6c137650dae8ca8325ff829758ef54ce7cab0fbd", "parents": ["b0a98270c07082079ed14afb48747845667d8690"], "tags": []}], "date": 1793208966, "git_changesets": ["0db5bb731b2cf63934541cb51bca40a7de57a608", "82954dec4af8cd86b94abbfa508f8a1cad087a60"], "user": "dmeehan@mozilla.com"}, "1146": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2080420 - Tighten matching of early hint preloads to their consumers  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335126\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336687\n", "files": ["netwerk/protocol/http/EarlyHintPreloader.cpp", "netwerk/protocol/http/EarlyHintPreloader.h", "netwerk/protocol/http/EarlyHintRegistrar.cpp", "netwerk/protocol/http/EarlyHintRegistrar.h", "netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "290054de4d5153091781b6b1ddd9220b8218c586", "git_parents": ["82954dec4af8cd86b94abbfa508f8a1cad087a60"], "node": "55535e43d6ddd502ede2b0baa0bd6c7433e88b4d", "parents": ["6c137650dae8ca8325ff829758ef54ce7cab0fbd"], "tags": []}], "date": 1793210734, "git_changesets": ["290054de4d5153091781b6b1ddd9220b8218c586"], "user": "dmeehan@mozilla.com"}, "1147": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074179 - Reject ErrorResult-internal nsresult values in IPC deserialization.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330160\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337500\n", "files": ["dom/bindings/BindingUtils.cpp", "dom/bindings/ErrorResult.h", "ipc/chromium/src/chrome/common/ipc_message_utils.h"], "git_node": "6d36ad78e98f287440a595ea66557d5674d55fab", "git_parents": ["290054de4d5153091781b6b1ddd9220b8218c586"], "node": "45b954e70b012b500b925b478092636f174c15b9", "parents": ["55535e43d6ddd502ede2b0baa0bd6c7433e88b4d"], "tags": []}], "date": 1793215434, "git_changesets": ["6d36ad78e98f287440a595ea66557d5674d55fab"], "user": "dmeehan@mozilla.com"}, "1148": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082033 - Don't fire events sync for pending load triggers.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336732\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337509\n", "files": ["layout/style/Loader.cpp", "layout/style/Loader.h", "layout/style/SharedStyleSheetCache.cpp", "layout/style/SharedStyleSheetCache.h", "layout/style/SheetLoadData.h", "layout/style/StreamLoader.cpp", "testing/web-platform/tests/html/semantics/document-metadata/the-link-element/link-load-event-alt.html"], "git_node": "497e64c41634b1d2a7da2cf01fcd10668d69c786", "git_parents": ["6d36ad78e98f287440a595ea66557d5674d55fab"], "node": "baadbf711067e9733cd8f9158c64a9c54d9844be", "parents": ["45b954e70b012b500b925b478092636f174c15b9"], "tags": []}], "date": 1793215492, "git_changesets": ["497e64c41634b1d2a7da2cf01fcd10668d69c786"], "user": "dmeehan@mozilla.com"}, "1149": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082025 - Explicitly check for resize() failure.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336817\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337336\n", "files": ["gfx/harfbuzz/bug-2082025.patch", "gfx/harfbuzz/moz.yaml", "gfx/harfbuzz/src/OT/Layout/GDEF/GDEF.hh"], "git_node": "e37a8e2d8852b9ab6c309545328a27378d8ce8ef", "git_parents": ["497e64c41634b1d2a7da2cf01fcd10668d69c786"], "node": "1cd50fe8ae83da8dc7acc10aa6218d137d9e7462", "parents": ["baadbf711067e9733cd8f9158c64a9c54d9844be"], "tags": []}], "date": 1793215520, "git_changesets": ["e37a8e2d8852b9ab6c309545328a27378d8ce8ef"], "user": "dmeehan@mozilla.com"}, "1150": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075604 - Use the latest version of fix-stacks  a=dmeehan DONTBUILD\n\nThis version includes the migration from `symbolic` to `wholesym`,\nresulting in large performance improvements on large symbol files.\n\nThis also has the regression fix from bug 2085593.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335749\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337659\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "28f9be036e7d4db54f8e1f04990fb6055e7faa9f", "git_parents": ["e37a8e2d8852b9ab6c309545328a27378d8ce8ef"], "node": "a7351210de674a1b04ced42e942c5d2f63bd37ec", "parents": ["1cd50fe8ae83da8dc7acc10aa6218d137d9e7462"], "tags": []}], "date": 1793215544, "git_changesets": ["28f9be036e7d4db54f8e1f04990fb6055e7faa9f"], "user": "dmeehan@mozilla.com"}, "1151": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082039 - Hold strong reference to ImageListener and requests during OnStartRequest  a=dmeehan DONTBUILD\n\nDuring ImageListener::OnStartRequest -\u003e AddNativeObserver, ReplayImageStatus calls can make things happen on the event loop, which potentially can invalidate weak references.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334458\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337563\n", "files": ["dom/base/crashtests/2082038.html", "dom/base/crashtests/crashtests.list", "dom/base/nsImageLoadingContent.cpp", "dom/html/ImageDocument.cpp"], "git_node": "700c35bef890d1ae101ef5cf392a6c953eaf08e7", "git_parents": ["28f9be036e7d4db54f8e1f04990fb6055e7faa9f"], "node": "b9a993bfe611e62327fe5b8953d13e8390526200", "parents": ["a7351210de674a1b04ced42e942c5d2f63bd37ec"], "tags": []}], "date": 1793215837, "git_changesets": ["700c35bef890d1ae101ef5cf392a6c953eaf08e7"], "user": "dmeehan@mozilla.com"}, "1152": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082186 - Fix calculation of gray marking valid state (ESR153)  a=dmeehan\n\nThe patch changes the grayBitsValid boolean into a grayBitsInvalid bitmask, so\nwe can have a state to record when the gray bits were marked invalid as part of\nthe current collection. The gray bit state is no longer reset to valid at the\nend of such a collection.\n\nThe bitmask is made atomic because it can be written from parallel marking\nthreads as noted in bug 2082082.\n\nThe call to waitBackgroundSweepEnd() is no longer needed since the recent\nchanges to symbol gray marking in bug 2075296.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337189\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp", "js/src/jit-test/tests/gc/bug-2072426.js", "js/src/jit-test/tests/gc/bug-2082186.js"], "git_node": "667f96c18f909550a0f6a5bc8202af7beff2957d", "git_parents": ["700c35bef890d1ae101ef5cf392a6c953eaf08e7"], "node": "fc577772920fd923025fc06587a7044de6f54bfe", "parents": ["b9a993bfe611e62327fe5b8953d13e8390526200"], "tags": []}], "date": 1793216028, "git_changesets": ["667f96c18f909550a0f6a5bc8202af7beff2957d"], "user": "dmeehan@mozilla.com"}, "1153": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079100: Queue Cocoa file pickers and refresh download directories.  a=dmeehan DONTBUILD\n\nResolve each download's starting directory after the preceding picker has finished, so queued downloads see the user's new location. Closing the parent window cancels active and waiting download prompts.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333966\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335975\n", "files": ["toolkit/mozapps/downloads/HelperAppDlg.sys.mjs", "toolkit/mozapps/downloads/tests/browser/browser.toml", "toolkit/mozapps/downloads/tests/browser/browser_download_save_directory.js", "widget/cocoa/nsFilePicker.h", "widget/cocoa/nsFilePicker.mm", "widget/tests/gtest/TestCocoaFilePickerQueue.mm", "widget/tests/gtest/moz.build"], "git_node": "cd1d18e9acb807dea38eb7c3091d0ec37416b951", "git_parents": ["667f96c18f909550a0f6a5bc8202af7beff2957d"], "node": "31a66d674eb7346ccfdedfac863c34f0a697a5fd", "parents": ["fc577772920fd923025fc06587a7044de6f54bfe"], "tags": []}], "date": 1793280777, "git_changesets": ["cd1d18e9acb807dea38eb7c3091d0ec37416b951"], "user": "dmeehan@mozilla.com"}, "1154": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082006.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337761\n", "files": ["gfx/2d/2D.h", "gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/ScaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/cairo/cairo/src/cairo-ft-font.c", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0053-Bug-2082006-lock-sharedftface.patch", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp"], "git_node": "5cc33c5326e0f05ccdb1a9bb9eb305b07d414311", "git_parents": ["cd1d18e9acb807dea38eb7c3091d0ec37416b951"], "node": "f307b382767ecdf9f7387c8528c132bdf3afa138", "parents": ["31a66d674eb7346ccfdedfac863c34f0a697a5fd"], "tags": []}], "date": 1793280801, "git_changesets": ["5cc33c5326e0f05ccdb1a9bb9eb305b07d414311"], "user": "dmeehan@mozilla.com"}, "1155": {"changesets": [{"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085450 - send Fetch Metadata headers with WebAuthn related origin requests.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336794\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337688\n", "files": ["dom/webauthn/WebAuthnRelatedOriginFetcher.sys.mjs", "dom/webauthn/tests/test_webauthn_related_origin.html", "dom/webauthn/tests/webauthn-wellknown.sjs"], "git_node": "bc793c55faac7c66d9546e5267c0ecdafa4006c3", "git_parents": ["5cc33c5326e0f05ccdb1a9bb9eb305b07d414311"], "node": "836b93b3c74d6eb4d0525f632f8cf704f4bea31b", "parents": ["f307b382767ecdf9f7387c8528c132bdf3afa138"], "tags": []}], "date": 1793280824, "git_changesets": ["bc793c55faac7c66d9546e5267c0ecdafa4006c3"], "user": "dmeehan@mozilla.com"}, "1156": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2074210 - Update cubeb-pulse-rs to 18bcb4ec. r=cubeb-reviewers,padenot a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337781\n", "files": [".cargo/config.toml.in", "Cargo.lock", "third_party/rust/cubeb-pulse/.cargo-checksum.json", "third_party/rust/cubeb-pulse/src/backend/stream.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "9783e3abc6cc767a6e49f7c0df1e47697aaff991", "git_parents": ["bc793c55faac7c66d9546e5267c0ecdafa4006c3"], "node": "5b1b5ad5778f670a8797d6b79b95ddfe0236b511", "parents": ["836b93b3c74d6eb4d0525f632f8cf704f