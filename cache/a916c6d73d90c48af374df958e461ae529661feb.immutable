6ac702e0e482fca4c16a9cd7d811"], "tags": []}], "date": 1792761927, "git_changesets": ["e966ceef7c82451561ecd7bda7710d29a24c361e", "1910d41897e64d907214aa63fad504c048000b24"], "user": "ffxbld@lando.moz.tools"}, "1056": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2074786 - Make `HTMLEditor::HandleInsertText` not delete unnecessary `\u003cbr\u003e` immediately before `\u003cspan _moz_quote=\"true\"\u003e`  a=dmeehan DONTBUILD\n\nIt's unnecessary for the layout, but it's necessary for the serializer.\nTherefore, it's actually necessary one for plain email composer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330087\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332620\n", "files": ["editor/libeditor/HTMLEditSubActionHandler.cpp", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/WSRunScanner.h", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_mailcite_insert_text_after_split.html"], "git_node": "12cd53975eece7a3d9e477c4011b69da7252e2e7", "git_parents": ["1910d41897e64d907214aa63fad504c048000b24"], "node": "a511a74f9db8dddffd128cbe881291cef92a4384", "parents": ["b265f86b00846fd1afbbbf20b2e979c592166575"], "tags": []}], "date": 1792766613, "git_changesets": ["12cd53975eece7a3d9e477c4011b69da7252e2e7"], "user": "dmeehan@mozilla.com"}, "1057": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045704: Validate LoadInfoArgs and HTTP channel flags  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327025\n", "files": ["netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h"], "git_node": "25fd68b0dec5fb212c599a5cb06258198047917c", "git_parents": ["12cd53975eece7a3d9e477c4011b69da7252e2e7"], "node": "c78c0a046424f93570ccab246da443e22bc53af9", "parents": ["a511a74f9db8dddffd128cbe881291cef92a4384"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045704: Resend DevTools document and object requests as TYPE_OTHER  a=dmeehan\n\nContent processes can no longer open document, subdocument or object loads\nover PHttpChannel, so resending such a request from the console or netmonitor\nwas blocked.  Use TYPE_OTHER for these, and drop the now-unreachable HTTPS\nupgrade telemetry annotation for TYPE_DOCUMENT resends.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331198\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333284\n", "files": ["devtools/server/actors/network-monitor/network-content.js"], "git_node": "a209f1affa96039e8cdbcd920da7d86f21cea46c", "git_parents": ["25fd68b0dec5fb212c599a5cb06258198047917c"], "node": "3f0097b73656d25daa89d6b4b75fd63bb2a54845", "parents": ["c78c0a046424f93570ccab246da443e22bc53af9"], "tags": []}], "date": 1792766736, "git_changesets": ["25fd68b0dec5fb212c599a5cb06258198047917c", "a209f1affa96039e8cdbcd920da7d86f21cea46c"], "user": "dmeehan@mozilla.com"}, "1058": {"changesets": [{"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2045704: apply code formatting via Lando a=bustage\n", "files": ["netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "03dd0da49b3959c588904bfb8d6eba2cc096197f", "git_parents": ["a209f1affa96039e8cdbcd920da7d86f21cea46c"], "node": "d74ebf2950143278e26bd211684956be56177b94", "parents": ["3f0097b73656d25daa89d6b4b75fd63bb2a54845"], "tags": []}], "date": 1792767036, "git_changesets": ["03dd0da49b3959c588904bfb8d6eba2cc096197f"], "user": "dmeehan@mozilla.com"}, "1059": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2074894 Don't expose Gecko patch level in Opus User Comment  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D33