"pushes": {"431": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 2ac22c53b238cae73c2e72915e2a423dcfa7f099 with FIREFOX_115_13_0esr_BUILD3 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "d0a8688d85be7ddc9a42979f39eb7217c968ea10", "parents": ["2ac22c53b238cae73c2e72915e2a423dcfa7f099"], "tags": []}], "date": 1720056906, "git_changesets": [null], "user": "ffxbld"}, "432": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "4e6240146d2b00a507179244ca0be500133cea18", "parents": ["d0a8688d85be7ddc9a42979f39eb7217c968ea10"], "tags": []}], "date": 1720454014, "git_changesets": [null], "user": "ffxbld-merge"}, "433": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 2ac22c53b238cae73c2e72915e2a423dcfa7f099 with FIREFOX_115_13_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "73a146110c0b172eed436433d32dc16f071582cd", "parents": ["4e6240146d2b00a507179244ca0be500133cea18"], "tags": []}], "date": 1720530011, "git_changesets": [null], "user": "ffxbld"}, "434": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902307 - Better validate shm sections. r=gfx-reviewers,lsalzman, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215368", "files": ["gfx/layers/client/TextureClient.cpp", "gfx/layers/ipc/ISurfaceAllocator.cpp", "gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/LayersMessages.ipdlh"], "git_node": null, "git_parents": [null], "node": "0288d0ce41f93e87b66d247ef7a772f254eec5dc", "parents": ["73a146110c0b172eed436433d32dc16f071582cd"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216536", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "9549b40e0c2e599f630c08fd429510d4edf3bfa9", "parents": ["0288d0ce41f93e87b66d247ef7a772f254eec5dc"], "tags": []}], "date": 1721046414, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "435": {"changesets": [{"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903320 - Create a dedicated task route for pernosco,  a=dmeehan\n\nThis sets up a route on Pernosco tasks such that they will emit pulse messages\nover the notify service's exchange with a dedicated routing key. This will allow\nthe Pernosco pulse consumer to receive only tasks that should be recorded.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215967\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216447", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/pernosco.py", "tools/tryselect/task_config.py", "tools/tryselect/test/test_task_configs.py"], "git_node": null, "git_parents": [null], "node": "d952083a90645ff6a7f5837071f271048fcb0056", "parents": ["9549b40e0c2e599f630c08fd429510d4edf3bfa9"], "tags": []}], "date": 1721062088, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "436": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903320 - Fix linter failures on ESR115. a=release", "files": ["taskcluster/gecko_taskgraph/decision.py"], "git_node": null, "git_parents": [null], "node": "00fe75ebb47ef36b10fcb6ed455a88e8f10767da", "parents": ["d952083a90645ff6a7f5837071f271048fcb0056"], "tags": []}], "date": 1721065188, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "437": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216927", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "8f01a8407c8d2c09d57d9d20a9f61ea8f3326901", "parents": ["00fe75ebb47ef36b10fcb6ed455a88e8f10767da"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1857332 - Remove redundant artifact expiry calculation. r=taskgraph-reviewers,jcristau, a=release\n\nIt's already handled in set_task_and_artifact_expiry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190233", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "f382902a1c157349bf02049c02f40215f4fd86b2", "parents": ["8f01a8407c8d2c09d57d9d20a9f61ea8f3326901"], "tags": []}, {"author": "Mike Hommey \u003cmh+mo