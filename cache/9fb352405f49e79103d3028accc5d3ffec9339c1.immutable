r-riscv64.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x86/MacroAssembler-x86.cpp", "js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmBuiltins.h", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h"], "git_node": null, "git_parents": [null], "node": "723cc10c7059edc3f51d1da56c7a152a062ad5f1", "parents": ["68474f82bdfc1147a2e045130a45650bf2b64aea"], "tags": []}], "date": 1721654032, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "440": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1907968 - Disable Nimbus when Shield is disallowed by enterprise policy  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216601\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217305", "files": ["toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "3631f47bcbd38065f1612639f5dbd74a19fc6795", "parents": ["723cc10c7059edc3f51d1da56c7a152a062ad5f1"], "tags": []}], "date": 1721743174, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "441": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907968 - Fix lint failures on ESR115. a=me", "files": ["toolkit/components/nimbus/test/unit/test_policy.js"], "git_node": null, "git_parents": [null], "node": "5a05350a37c14afe31cb99589380210dff428ffd", "parents": ["3631f47bcbd38065f1612639f5dbd74a19fc6795"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903187 - ESR 115, r=Gijs, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217083", "files": ["toolkit/modules/PopupNotifications.sys.mjs"], "git_node": null, "git_parents": [null], "node": "b1708d77b8ef12274bbbbc747c3f0f0f9cb99cf4", "parents": ["5a05350a37c14afe31cb99589380210dff428ffd"], "tags": []}], "date": 1721746640, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "442": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1909566 - pixman: Adjust arm assembly for binutils change.  a=dmeehan\n\nA change in the latest version of binutils broke building pixman for arm.\n\nThe binutils change:\nhttps://sourceware.org/git/?p=binutils-gdb.git;a=commit;h=226749d5a6ff0d5c607d6428d6c81e1e7e7a994b\n\nThis change was committed upstream in\nhttps://gitlab.freedesktop.org/pixman/pixman/-/commit/865e6ce00bb79a6b925ed4c2c436e1533e4472aa\nand will be in the next release.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217517\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217541", "files": ["gfx/cairo/libpixman/src/pixman-arm-simd-asm.S"], "git_node": null, "git_parents": [null], "node": "ac053f4f561a993ccf839a39d00979ee2a627844", "parents": ["b1708d77b8ef12274bbbbc747c3f0f0f9cb99cf4"], "tags": []}], "date": 1721857077, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "443": {"changesets": [{"author": "John Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909714 - land NSS NSS_3_90_4_RTM UPGRADE_NSS_RELEASE, r=keeler a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217594", "files": ["security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/doc/rst/releases/nss_3_90_4.rst", "security/nss/lib/freebl/chacha20poly1305.c"], "git_node": null, "git_parents": [null], "node": "bd4eca15906eafec82fbd13037012eaca985d8a0", "parents": ["ac053f4f561a993ccf839a39d00979ee2a627844"], "tags": []}], "date": 1721858717, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "444": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217706", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f73c7d487e30bcc7e3d7363ac5d894a9bcf10895", "parents": ["bd4eca15906eafec82fbd13037012eaca985d8a0"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1871303 - Ensure there is no more marking at the start of sweeping (ESR115) a=dmeehan\n\n\nThere are two issues here. The first is that there unexpected marking work at\nthe start of sweeping after entering from the mark phase without yielding. We\npreviously called assertNoMarkingWork() after markUntilBudgetExhausted() in the\nmarking phase so something since then must have added it.\n\nAs far as I can tell this must be the conditional call to\ncollectNurseryFromMajorGC(), where a post barrier for a pointer cleared during\nfinalization (e.g. for Maps in mapObject::sweepAfterMinorGC) ends up marking\nsomething. I'm not sure such barriers are necessary, but for now the safest\nthing to do is to move this nursery collection to the start of the slice so\nthat it happens before we drain the mark stack.\n\nThe second issue is that we check the budget and conditionally yield if we\nenter from the marking state. The comment above this code states that this is\nnot safe since we have not yet started sweeping a sweep group. This check was\nadded in bug 1865383 but was not the main part of the fix. I think we should\nremove this.\n\nI wasn't able to come up with a test case to reproduce this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217551", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp"], "git_node": null, "g