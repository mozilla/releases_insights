s:92381:"{
"lastpushid": 632,
"pushes": {"11": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 4cff37e891cdf778f142fd8005c71b1dd88898b2 with FIREFOX_128_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "42067013b653f1d7bca6dc970f87404859a53edc", "parents": ["4cff37e891cdf778f142fd8005c71b1dd88898b2"], "tags": []}], "date": 1720110584, "git_changesets": [null], "user": "ffxbld"}, "12": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903516 - re-enable periodic-updates cron job. a=release DONTBUILD\n\nBacked out changeset 780ebe09abe5 (bug 1899174)", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "a0be24d55de105b82186220ed1bc945275e16304", "parents": ["42067013b653f1d7bca6dc970f87404859a53edc"], "tags": []}], "date": 1720122684, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "13": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "8a501a3f614d4e0ac9796b01f86d3bb56361bc2b", "parents": ["a0be24d55de105b82186220ed1bc945275e16304"], "tags": []}], "date": 1720453840, "git_changesets": [null], "user": "ffxbld-merge"}, "14": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 4cff37e891cdf778f142fd8005c71b1dd88898b2 with FIREFOX_128_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "7ca4270e6f26123a5d421a0aed6d085505c53845", "parents": ["8a501a3f614d4e0ac9796b01f86d3bb56361bc2b"], "tags": []}], "date": 1720529543, "git_changesets": [null], "user": "ffxbld"}, "15": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1906699 - enable cron-bouncer-check on mozilla-esr128. r=releng-reviewers,bhearsum a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215923", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "fc9a9f95402d732693ecab167315ed590c64f8ed", "parents": ["7ca4270e6f26123a5d421a0aed6d085505c53845"], "tags": []}], "date": 1720531454, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "16": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216290", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "eb16e9722386cda210911f97fbfa24f8783bb44c", "parents": ["fc9a9f95402d732693ecab167315ed590c64f8ed"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851083 - Do not show the attention badge for mv3 extensions requiring the activeTab permission. r=robwu, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215038", "files": ["browser/components/extensions/test/browser/browser_ext_originControls.js", "toolkit/components/extensions/ExtensionPermissions.sys.mjs"], "git_node": null, "git_parents": [null], "node": "4febc46784639953ce3f7bfb53cd35ed0e1ca1eb", "parents": ["eb16e9722386cda210911f97fbfa24f8783bb44c"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905468 - Prevent some more mouse events from reaching the content page. r=sfoster, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215515", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/components/screenshots/tests/browser/browser_test_prevent_events.js"], "git_node": null, "git_parents": [null], "node": "a6db9a655d3687713307f4a0427dd3edd2ea6a89", "parents": ["4febc46784639953ce3f7bfb53cd35ed0e1ca1eb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1906078 - Avoid pathological VecDeque behavior on parallel traversal. r=dshin, a=dmeehan\n\nUsing split_off to split the front chunk from the queue seems like it'd\nbe efficient, but it's not:\n\n  https://github.com/rust-lang/rust/issues/127281\n\nInstead, pass the range of nodes to distribute, and use\nVecDeque::from_iter in the callee. Then, just truncate() the queue to\nthe remaining local work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215705", "files": ["servo/components/style/parallel.rs"], "git_node": null, "git_parents": [null], "node": "2578d1f8740c7f6c2faa3d917edc6627f39cd622", "parents": ["a6db9a655d3687713307f4a0427dd3edd2ea6a89"], "tags": []}], "date": 1720717016, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "17": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216537", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/translations-models.json"], "git_node": null, "git_parents": [null], "node": "06586540d1305d6beae491e2c90a79840cfc12c3", "parents": ["2578d1f8740c7f6c2faa3d917edc6627f39cd622"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905971 - Handle large PT_NOTE entries in the program headers correctly r=gerard-majax, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215555", "files": ["toolkit/crashreporter/process_reader/src/platform/linux.rs"], "git_node": null, "git_parents": [null], "node": "e73b7a8c1564c8f476fd69af33fdc5b0e04a2a8f", "parents": ["06586540d1305d6beae491e2c90a79840cfc12c3"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902307 - Better validate shm sections. r=gfx-reviewers,lsalzman, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215368", "files": ["gfx/layers/client/TextureClient.cpp", "gfx/layers/ipc/ISurfaceAllocator.cpp", "gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/LayersMessages.ipdlh"], "git_node": null, "git_parents": [null], "node": "053d9a9fa4beb7b7590693ef7afe54b2c8488829", "parents": ["e73b7a8c1564c8f476fd69af33fdc5b0e04a2a8f"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905771 - switcherTarget element label set by SidebarController.registerExtension is still set when switching to a non extension sidebar. r=willdurand,sidebar-reviewers,Gijs, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215945", "files": ["browser/components/extensions/test/browser/browser_ext_sidebarAction.js", "browser/components/sidebar/browser-sidebar.js"], "git_node": null, "git_parents": [null], "node": "0e7fc501924ed5e3235d30520289bddfa2394b0d", "parents": ["053d9a9fa4beb7b7590693ef7afe54b2c8488829"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1907289 - Reflow table cell if collapsed borders have changed. r=dshin, a=dmeehan\n\nA potentially better approach could be to call FrameNeedsReflow from\nnsBCTableCellFrame::SetBorderWidth... But it seems that might\nover-invalidate quite a lot when recalculating borders, since it seems\nwe reset the relevant ones and then accumulate directly on the frame.\n\nIf that seems like a better approach, happy to give that a try. This\nshould be less risky for performance changes in general tho.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216409", "files": ["layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableCellFrame.h", "layout/tables/nsTableRowFrame.cpp", "testing/web-platform/tests/css/css-tables/collapsed-border-remove-row-group-ref.html", "testing/web-platform/tests/css/css-tables/collapsed-border-remove-row-group.html"], "git_node": null, "git_parents": [null], "node": "19bda7044b354c53991acf203049c9901d850eac", "parents": ["0e7fc501924ed5e3235d30520289bddfa2394b0d"], "tags": []}], "date": 1721055375, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "18": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1905153 - Support loadModule after asyncLoadModule  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215155\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215407", "files": ["toolkit/components/extensions/ExtensionCommon.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_load_all_api_modules.js"], "git_node": null, "git_parents": [null], "node": "3fb651855a5e1c3961a7d32b42c86edc3ad11c7c", "parents": ["19bda7044b354c53991acf203049c9901d850eac"], "tags": []}], "date": 1721076999, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "19": {"changesets": [{"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903320 - Create a dedicated task route for pernosco,  a=dmeehan\n\nThis sets up a route on Pernosco tasks such that they will emit pulse messages\nover the notify service's exchange with a dedicated routing key. This will allow\nthe Pernosco pulse consumer to receive only tasks that should be recorded.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215967\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216444", "files": ["taskcluster/gecko_taskgraph/parameters.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/pernosco.py", "tools/tryselect/task_config.py", "tools/tryselect/test/test_task_configs.py"], "git_node": null, "git_parents": [null], "node": "d760a32dbbefb4bd5a82a22360e0bcdea3bb0e9a", "parents": ["3fb651855a5e1c3961a7d32b42c86edc3ad11c7c"], "tags": []}], "date": 1721131733, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "20": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903041: Use a linear search in more situations.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214989\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216607", "files": ["js/src/wasm/WasmTypeDef.h"], "git_node": null, "git_parents": [null], "node": "42f57fc7e18214c9422704dc1aff43c6899ee650", "parents": ["d760a32dbbefb4bd5a82a22360e0bcdea3bb0e9a"], "tags": []}], "date": 1721140299, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "21": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1822297 - Implement a SearchHistoryResult to remove dependency on satchel and fix deleting items from the search bar history.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214956\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216692", "files": ["browser/components/search/test/browser/browser_searchbar_default.js", "toolkit/components/search/SearchSuggestions.sys.mjs"], "git_node": null, "git_parents": [null], "node": "b19a1800f64cebf4d5e82b171ea06d980e0e1011", "parents": ["42f57fc7e18214c9422704dc1aff43c6899ee650"], "tags": []}], "date": 1721157930, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "22": {"changesets": [{"author": "Oliver Medhurst \u003comedhurst@mozilla.com\u003e", "branch": "default", "desc": "Bug 1877969 - Consume user activation when showing any picker  a=dmeehan\n\nConsume transient user activation when showing file/color picker\nat any time. Do not open if there is no transent user activation.\n\nFixed various internal tests broken by this change.\n\nSpec PR: https://github.com/whatwg/html/pull/10344\n\nOriginal Revision: https://phabricator.services.mozilla.com/D201096\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216792", "files": ["accessible/tests/browser/e10s/browser_file_input.js", "browser/base/content/test/tabPrompts/browser_confirmFolderUpload.js", "dom/filesystem/tests/test_webkitdirectory.html", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLSelectElement.cpp", "dom/html/test/forms/test_change_event.html", "dom/html/test/forms/test_input_color_picker_popup.html", "dom/html/test/forms/test_input_file_picker.html", "dom/html/test/test_bug592802.html", "dom/html/test/test_filepicker_default_directory.html", "dom/html/test/test_input_file_cancel_event.html", "dom/html/test/test_input_files_not_nsIFile.html", "dom/html/test/test_multipleFilePicker.html", "dom/ipc/tests/test_bug1086684.js", "layout/forms/test/bug536567_subframe.html", "layout/forms/test/test_bug536567_perwindowpb.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PromptDelegateTest.kt", "testing/web-platform/meta/html/semantics/forms/the-input-element/show-picker-disabled-readonly.html.ini", "testing/web-platform/meta/html/semantics/forms/the-input-element/show-picker-user-gesture.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/show-picker-user-gesture.html.ini"], "git_node": null, "git_parents": [null], "node": "04ca2f03248aaa226bede846d82ba9ae0c73cf7c", "parents": ["b19a1800f64cebf4d5e82b171ea06d980e0e1011"], "tags": []}], "date": 1721219409, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "23": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1875354 - Don't create an unnecessary user activation from select when not firing the input event.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214933\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216716", "files": ["toolkit/actors/SelectChild.sys.mjs"], "git_node": null, "git_parents": [null], "node": "0fb6c5d5981a07cd632093e594dc41030bdd05bc", "parents": ["04ca2f03248aaa226bede846d82ba9ae0c73cf7c"], "tags": []}], "date": 1721220524, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "24": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1906978 - Fix the positioning/anchoring of SVG text runs with bidi control characters.  a=dmeehan\n\nThe added reftests here failed both prior to and after the bidi-engine update,\nalthough the exact nature of the failures changed due to the engine leaving the\nbidi control characters in different places in the reordered text. (This is\nexplicitly unspecified by the Unicode Bidi Algorithm, because the control codes\nare nominally removed after processing; leaving them present but invisible is\nan implementation detail.)\n\nThe key fix here is that DoGlyphPositioning() anchors the first *addressable*\ncharacter of the text, not necessarily the absolute first codepoint, as that\nmay be a \"deleted\" control code whose position is arbitrary.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216400\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216527", "files": ["layout/svg/SVGTextFrame.cpp", "testing/web-platform/tests/svg/text/reftests/text-bidi-controls-anchors-1-ref.svg", "testing/web-platform/tests/svg/text/reftests/text-bidi-controls-anchors-1.svg", "testing/web-platform/tests/svg/text/reftests/text-bidi-controls-anchors-2-ref.svg", "testing/web-platform/tests/svg/text/reftests/text-bidi-controls-anchors-2.svg"], "git_node": null, "git_parents": [null], "node": "746d01c6275622b753de1c0b1dcc92f27d5589b7", "parents": ["0fb6c5d5981a07cd632093e594dc41030bdd05bc"], "tags": []}], "date": 1721229077, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "25": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1907035 - fix about:support use of genai experiment strings,  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216299\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216871", "files": ["toolkit/content/aboutSupport.xhtml"], "git_node": null, "git_parents": [null], "node": "239fb6a739689bcfc21d8853eb7118955f17e5ab", "parents": ["746d01c6275622b753de1c0b1dcc92f27d5589b7"], "tags": []}], "date": 1721259747, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "26": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216930", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "5f1a06cad8f21ad55df3d3b272a24b98a662a260", "parents": ["239fb6a739689bcfc21d8853eb7118955f17e5ab"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1907709 - Add a search header for website advertising section. r=settings-reviewers,Gijs, a=dmeehan\n\nA bit weird that this doesn't work more automatically but...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216680", "files": ["browser/components/preferences/privacy.inc.xhtml"], "git_node": null, "git_parents": [null], "node": "5f66270c17d05bf13bbe51c60fb68ed55c56d2af", "parents": ["5f1a06cad8f21ad55df3d3b272a24b98a662a260"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 1882206 - Added longer timeout and cleanup for siteDataTestUtils in browser_sanitizeDialog_v2_datasizes . r=pbz, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215641", "files": ["browser/base/content/test/sanitize/browser_sanitizeDialog_v2_dataSizes.js"], "git_node": null, "git_parents": [null], "node": "098386d6595d5ae80fa495bb6f0bf856fee14201", "parents": ["5f66270c17d05bf13bbe51c60fb68ed55c56d2af"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907353 - Use the loadInfo to check storage access if there is no target browsing context. r=anti-tracking-reviewers,pbz, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216394", "files": ["toolkit/components/antitracking/StorageAccess.cpp"], "git_node": null, "git_parents": [null], "node": "f44c25ddead8012a25ffea6291c67740237c31c9", "parents": ["098386d6595d5ae80fa495bb6f0bf856fee14201"], "tags": []}, {"author": "Henry Wilkes \u003chenry@torproject.org\u003e", "branch": "default", "desc": "Bug 1904802 - Ensure info-pages .title is tall enough for icon. r=desktop-theme-reviewers,dao, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214953", "files": ["toolkit/themes/shared/in-content/info-pages.css"], "git_node": null, "git_parents": [null], "node": "cb3bc72c1a82063a62a62d6b85f5a424fca1bdd5", "parents": ["f44c25ddead8012a25ffea6291c67740237c31c9"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903187, r=Gijs, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215510", "files": ["toolkit/modules/PopupNotifications.sys.mjs"], "git_node": null, "git_parents": [null], "node": "c22e1c08561f44e020c265391d12c51d84fc5eca", "parents": ["cb3bc72c1a82063a62a62d6b85f5a424fca1bdd5"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1897444 - Pass base color in add_composite_prim, then ignore it in the shader (release). r=gw, a=dmeehan\n\n\n\nThis appears to work around the glitch on Windows + Adreno. It is unclear why. The fact that this so far only reproduced on windows on arm looks like a driver issue, however from the workaround it looks like there might be a confusion between the textured and non-textured code paths with composite quads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216302", "files": ["gfx/wr/webrender/res/ps_quad_textured.glsl", "gfx/wr/webrender/src/quad.rs"], "git_node": null, "git_parents": [null], "node": "f1d4e5121889420da6b24608787f69e00afd104c", "parents": ["c22e1c08561f44e020c265391d12c51d84fc5eca"], "tags": []}], "date": 1721307738, "git_changesets": [null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "27": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1904407 - Clear nsColorPickerProxy's callback when we destroy the actor.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214739\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216959", "files": ["widget/nsColorPickerProxy.cpp", "widget/nsColorPickerProxy.h"], "git_node": null, "git_parents": [null], "node": "7a7cb6ad6bbe573655d3a40b65495603dace1a5c", "parents": ["f1d4e5121889420da6b24608787f69e00afd104c"], "tags": []}], "date": 1721318654, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "28": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1908539 restrict MacOS platform audio processing to Nightly  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216870\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217010", "files": ["modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "b2a76d42bda30d41834daa75f1d2170dfedf9603", "parents": ["7a7cb6ad6bbe573655d3a40b65495603dace1a5c"], "tags": []}], "date": 1721333114, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "29": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1895741 - Clear _res when DNS thread is shutdown,  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216923", "files": ["netwerk/dns/nsHostResolver.cpp"], "git_node": null, "git_parents": [null], "node": "5136dd39b5bcd77b3de9de780266b2a360d2074c", "parents": ["b2a76d42bda30d41834daa75f1d2170dfedf9603"], "tags": []}], "date": 1721340149, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "30": {"changesets": [{"author": "Eemeli Aro \u003ceemeli@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907422 - Rename \"click ancestor\" as \"clickAncestor\".  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216335\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216710", "files": ["accessible/generic/LocalAccessible.cpp", "accessible/ipc/DocAccessibleChild.cpp", "accessible/ipc/RemoteAccessible.cpp", "accessible/tests/browser/e10s/browser_caching_actions.js", "accessible/tests/mochitest/actions.js", "accessible/tests/mochitest/elm/test_HTMLSpec.html", "accessible/tests/mochitest/test_nsIAccessibleImage.html", "browser/locales/l10n-changesets.json", "dom/locales/en-US/chrome/accessibility/mac/accessible.properties", "dom/locales/en-US/chrome/accessibility/unix/accessible.properties", "dom/locales/en-US/chrome/accessibility/win/accessible.properties", "mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "bf200a384d15b2d9cc9588a6311e0076537ac944", "parents": ["5136dd39b5bcd77b3de9de780266b2a360d2074c"], "tags": []}], "date": 1721396684, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "31": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1906606 - Sanitize nsCString objects coming from crashed processes  a=dmeehan\n\nAlso remove some logspam from the test harness.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215899\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216949", "files": ["toolkit/crashreporter/mozannotation_server/src/lib.rs", "toolkit/crashreporter/test/unit/head_crashreporter.js"], "git_node": null, "git_parents": [null], "node": "b7eaf777c084253f76d11bc73d959730649ffef0", "parents": ["bf200a384d15b2d9cc9588a6311e0076537ac944"], "tags": []}], "date": 1721397858, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "32": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1830136 - Stop adding _processedColors to startupData of theme  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214540\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216988", "files": ["toolkit/components/extensions/parent/ext-theme.js", "toolkit/components/extensions/test/xpcshell/test_ext_theme_startupData.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml", "toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": null, "git_parents": [null], "node": "5669b04c826fd3f38c5ab0609c647a7a010f6343", "parents": ["b7eaf777c084253f76d11bc73d959730649ffef0"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1830136 - Delete obsolete _processedColors entries  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214831\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216989", "files": ["toolkit/components/extensions/parent/ext-theme.js"], "git_node": null, "git_parents": [null], "node": "59c79ea1898f7531938a09d8547be573c14423ab", "parents": ["5669b04c826fd3f38c5ab0609c647a7a010f6343"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1830144 - Stop overwriting startupData when theme.update is called  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214832\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216990", "files": ["toolkit/components/extensions/parent/ext-theme.js", "toolkit/components/extensions/test/xpcshell/test_ext_theme_startupData.js"], "git_node": null, "git_parents": [null], "node": "49b24ca2b77f9499697d56a91460ff42e14f3b2e", "parents": ["59c79ea1898f7531938a09d8547be573c14423ab"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1830144 - Only use startupData.lwtData for static themes  a=dmeehan\n\nStop using startupData.lwtData for extensions that are not static\nthemes, because this feature was designed for use by static themes\nonly.\n\nAlso added test coverage that explicitly confirms when\nstartupData.lwtData is used and when not.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214833\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216991", "files": ["toolkit/components/extensions/Extension.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_theme_startupData.js", "toolkit/mozapps/extensions/internal/XPIProvider.sys.mjs"], "git_node": null, "git_parents": [null], "node": "05d5639620fd16aa74b2341873d53bc655117902", "parents": ["49b24ca2b77f9499697d56a91460ff42e14f3b2e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1830144 - Clarify use of startupData in ext-theme.js  a=dmeehan\n\nAdd comments explaining the role of startupData, and explicitly assign\nproperties from startupData instead of Object.assign to make it obvious\nwhich properties are intended to be read (and to also make it impossible\nto overwrite properties that should not be overwritten).\n\nAnd add test coverage verifying that after a restart, the stored theme\nis actually applied, for the light and dark theme, because such test\ncoverage was missing before.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215216\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216992", "files": ["toolkit/components/extensions/parent/ext-theme.js", "toolkit/components/extensions/test/xpcshell/test_ext_theme_startupData.js"], "git_node": null, "git_parents": [null], "node": "670e2854d9ae59bf699534f809d93126b4ddc6e6", "parents": ["05d5639620fd16aa74b2341873d53bc655117902"], "tags": []}], "date": 1721403298, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "33": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1908312 - Make it clear in about:preferences that PPA is disabled when telemetry is disabled,  a=RyanVM\n\nRight now the UI state for PPA remains checked and active even when the main telemetry\nsetting is disabled. This is confusing UX, since DAP submission is disabled when\ntelemetry is disabled.\n\nAlso migrate off the deprecated toolkit-private isTelemetryEnabled() accessor to the normal pref check.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216801\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216970", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/preferences/privacy.js", "dom/privateattribution/PrivateAttribution.cpp", "dom/privateattribution/PrivateAttribution.h", "dom/privateattribution/PrivateAttributionService.sys.mjs"], "git_node": null, "git_parents": [null], "node": "d62877663c09663dca2e1a45b1c6dedd50e89e7b", "parents": ["670e2854d9ae59bf699534f809d93126b4ddc6e6"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905021: Don't incorrectly treat the start of a node inside a contentEditable as the end of a line. r=nlapre a=RyanVM\n\nPreviously, we assumed that CaretAssociationHint::Before always meant the caret was at the insertion point at the end of a line.\nHowever, it can also mean that the caret is before the start of a node in the middle of a line.\nTo fix this, we need to check for line and paragraph boundaries.\nSee the code comments for details.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215316", "files": ["accessible/generic/HyperTextAccessible-inl.h", "accessible/generic/HyperTextAccessible.cpp", "accessible/tests/browser/text/browser_text_caret.js"], "git_node": null, "git_parents": [null], "node": "f1220475a545ff3cb883a8dfb28c12f133fccdcd", "parents": ["d62877663c09663dca2e1a45b1c6dedd50e89e7b"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1905928 - Part 1: Add MOZ_LOG for error notifier functions in dom/geolocation  a=RyanVM\n\nAnd also some log for provider selection on Linux. This gives some clue to see what's happening in geolocation when dealing with bug reports.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215906\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216940", "files": ["dom/geolocation/Geolocation.cpp", "dom/geolocation/GeolocationPositionError.cpp", "dom/geolocation/MLSFallback.cpp"], "git_node": null, "git_parents": [null], "node": "2ec60dd7aaa3b209ad8b30fcc1fad772f4a3ab9a", "parents": ["f1220475a545ff3cb883a8dfb28c12f133fccdcd"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1905928 - Part 2: Opt-in for release channel collection of legacy geolocation telemetry  a=RyanVM\n\nThis is to quickly compare the existing data while including stable/esr releases too.\n\nAlso setting expiry date for eventual full glean migration.\n\n(Confusingly \"opt-out\" means \"opt-in\" for release channel data collection while \"opt-in\" means prerelease channel-only data collection)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216084\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216941", "files": ["toolkit/components/telemetry/Histograms.json"], "git_node": null, "git_parents": [null], "node": "e75c39148c288640b9ec66343e3dcbc57b1e205d", "parents": ["2ec60dd7aaa3b209ad8b30fcc1fad772f4a3ab9a"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1905928 - Part 3: Add glean telemetry entries  a=RyanVM\n\nEach provider has different fallback behavior:\n* Windows/macOS: Fallback only on error\n* Gpsd/Portal: Fallback only on timeout\n* Geoclue: Fallback on both\n\nTo meet all the behaviors MLSFallback got FallbackReason/ShutdownReason and report via Glean based on that.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216085\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216942", "files": ["dom/geolocation/Geolocation.cpp", "dom/geolocation/MLSFallback.cpp", "dom/geolocation/MLSFallback.h", "dom/geolocation/metrics.yaml", "dom/system/linux/GeoclueLocationProvider.cpp", "dom/system/linux/GpsdLocationProvider.cpp", "dom/system/linux/PortalLocationProvider.cpp", "dom/system/mac/CoreLocationLocationProvider.h", "dom/system/mac/CoreLocationLocationProvider.mm", "dom/system/windows/location/WindowsLocationProvider.cpp", "dom/system/windows/location/WindowsLocationProvider.h", "toolkit/components/glean/metrics_index.py"], "git_node": null, "git_parents": [null], "node": "fc7a012929a5e2d9d4403a0702e12e3a791fa6b7", "parents": ["e75c39148c288640b9ec66343e3dcbc57b1e205d"], "tags": []}], "date": 1721406478, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "34": {"changesets": [{"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885310 - Await SearchService init in TelemetryEnvironment test r=janerik,mcheang, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214979", "files": ["toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": null, "git_parents": [null], "node": "e0382358e1966f29a24ad70f1ee6aca18f1d8a0d", "parents": ["fc7a012929a5e2d9d4403a0702e12e3a791fa6b7"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1898815 - Add tests for pointerlock and xul popup; r=smaug a=test-only", "files": ["dom/tests/browser/browser.toml", "dom/tests/browser/browser_pointerlock_popup.js"], "git_node": null, "git_parents": [null], "node": "db626bed143ffb1a358159bbe7978093209ce61f", "parents": ["e0382358e1966f29a24ad70f1ee6aca18f1d8a0d"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905642 - Speed up the remote settings part of periodic_file_updates.sh. r=leplatrem,releng-reviewers,bhearsum a=NPOTB", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "3eb2b34b568911e1e2608a621120694429ec0b28", "parents": ["db626bed143ffb1a358159bbe7978093209ce61f"], "tags": []}, {"author": "Sean Feng \u003csefeng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902561 - Make F6 or Control+Tab takes the focus to the first focusable element in scope for Chrome document r=smaug a=RyanVM\n\nThis is to miminc the behaviour in\nhttps://searchfox.org/mozilla-central/rev/cb1060f7b4581e6c2d30f1accc84c7d807132d82/dom/base/nsFocusManager.cpp#4550-4561\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214629", "files": ["dom/base/nsFocusManager.cpp", "dom/tests/mochitest/chrome/chrome.toml", "dom/tests/mochitest/chrome/file_first_focusable_in_scope.xhtml", "dom/tests/mochitest/chrome/test_first_focusable_in_scope.xhtml"], "git_node": null, "git_parents": [null], "node": "7747a6ef647a0210a1e6ca0deccfdeb54f21c2f7", "parents": ["3eb2b34b568911e1e2608a621120694429ec0b28"], "tags": []}], "date": 1721414202, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "35": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1906132 - Propagate BResize flag from viewport frame to root scroll frame. r=dholbert a=RyanVM\n\nThe regression range is baffling, but it just shows a missing\ninvalidation.\n\nThe extension has worked around this upstream:\n\n  https://github.com/AdguardTeam/AdguardBrowserExtension/commit/a48ff54cf6ec7e93f651e8b55b77d08eb0fe1be2\n\nBut the root cause is a bug in Firefox. The popup here had styles much\nlike:\n\n```\nhtml, body, #root {\n  height: 100%;\n  min-height: 100%;\n  width: auto;\n  min-width: 320px;\n}\n```\n\nThe popup starts off zero-sized, but then gets re-measured async at some\npoint by the extension code.\n\nMain issue here is that, due to the bresize, we reflow the viewport,\nthen the html, but the html loses the bresize flag. So we don't reflow\nthe body element to give it the right height.\n\nBefore my patch, the body was reflowed because there was a BFC under it,\nso it had the NS_BLOCK_HAS_CLEAR_CHILDREN flag, which ended up papering\nover this bug.\n\nI think this can only happen with the special shrink-wrap resize mode,\nbecause it's the only thing that can turn a percentage bsize like 100%\nfrom behaving like a percentage to behave like auto... So I haven't been\nable to reproduce outside of our extension popup usage. Otherwise the\npercentages resolving to different things would set the bresize flag\nappropriately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215842", "files": ["browser/components/extensions/test/browser/browser.toml", "browser/components/extensions/test/browser/browser_ext_popup_bug1906132.js", "layout/generic/ViewportFrame.cpp"], "git_node": null, "git_parents": [null], "node": "d1f491188d82cee02b8d5c69a41aaeb8dc34ecd8", "parents": ["7747a6ef647a0210a1e6ca0deccfdeb54f21c2f7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1905253 - Add a null-check in AppWindow::MoveResize. r=smaug, a=RyanVM\n\nMuch like the method we forward to.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216580", "files": ["xpfe/appshell/AppWindow.cpp"], "git_node": null, "git_parents": [null], "node": "269fbb025e79c559a35a41d4ce67f069c2083b94", "parents": ["d1f491188d82cee02b8d5c69a41aaeb8dc34ecd8"], "tags": []}], "date": 1721415147, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "36": {"changesets": [{"author": "Bryan Olsson \u003cbolsson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908976 - Update l10n-changesets.json for ESR128,  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217148", "files": ["browser/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "773f6caed2c6918fe5f6bc491c14bc2d91591299", "parents": ["269fbb025e79c559a35a41d4ce67f069c2083b94"], "tags": []}], "date": 1721415675, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "37": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1904285 - [devtools] Don't mark CSS variable declaration invalid in ::cue and highlight pseudo-elements.  a=dmeehan.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214546\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217101", "files": ["devtools/server/actors/utils/inactive-property-helper.js", "devtools/server/tests/chrome/inactive-property-helper/cue-pseudo-element.mjs", "devtools/server/tests/chrome/inactive-property-helper/highlight-pseudo-elements.mjs"], "git_node": null, "git_parents": [null], "node": "ae3643a459c41755cba054093cf416d111421ec4", "parents": ["773f6caed2c6918fe5f6bc491c14bc2d91591299"], "tags": []}], "date": 1721421571, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "38": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1906736 - Remove BaseRustLibrary.deps_path.  a=RyanVM\n\nIts only use was removed in bug 1304815.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216140\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216768", "files": ["python/mozbuild/mozbuild/frontend/data.py"], "git_node": null, "git_parents": [null], "node": "a3097b870d4b4df0109bc9fa428202201294fa19", "parents": ["ae3643a459c41755cba054093cf416d111421ec4"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1906736 - Make BaseRustLibrary.import_name a name, not a path.  a=RyanVM\n\nFor consistency with other Library classes, import_name should be the\n\"import\" library name, while import_path is the full path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216141\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216769", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py"], "git_node": null, "git_parents": [null], "node": "68d5c3eacb8cbaadc3ef84cfbce07cf07b404a65", "parents": ["a3097b870d4b4df0109bc9fa428202201294fa19"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1906736 - Make Linkables' import_path an ObjDirPath.  a=RyanVM\n\nThis will allow to use better backend primitives to use it in a\nsubsequent change.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216142\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216770", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py"], "git_node": null, "git_parents": [null], "node": "0c3752099e580d76fd79172901e2ca418d24b7c4", "parents": ["68d5c3eacb8cbaadc3ef84cfbce07cf07b404a65"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1906736 - Use RecursiveMakeBackend._pretty_path to output import_paths.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216143\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216771", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": null, "git_parents": [null], "node": "758d5a7afd1bfdd3596c88692aeb0a24dcdf92a3", "parents": ["0c3752099e580d76fd79172901e2ca418d24b7c4"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1906736 - Make IMPORT_LIBRARY a full path.  a=RyanVM\n\nThis makes IMPORT_LIBRARY a full path, to match the change to\nSHARED_LIBRARY so that the IMPORT_LIBRARY target can be found in\njs/src/build/Makefile.in. Fixes regression in js standalone build 'make\ninstall'.\n\nInitial patch by Philip Chimento.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215992\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216772", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py"], "git_node": null, "git_parents": [null], "node": "92607226a15d6b752b6f95543605090f2db2abf4", "parents": ["758d5a7afd1bfdd3596c88692aeb0a24dcdf92a3"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1906736 - Fix INSTALL_NAME_TOOL invocation in standalone js `make install` after bug 1459764.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215970\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216773", "files": ["js/src/build/Makefile.in"], "git_node": null, "git_parents": [null], "node": "add8899c3692ae47e20a5fdb4cf24d75589ace74", "parents": ["92607226a15d6b752b6f95543605090f2db2abf4"], "tags": []}], "date": 1721425655, "git_changesets": [null, null, null, null, null, null], "user": "rvandermeulen@mozilla.com"}, "39": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907070 - Part 1: Move WeakCache into the JS namespace (backout of changeset e6babd625779) r=sfink a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216166", "files": ["js/src/gc/Compacting.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp", "js/src/gc/SweepingAPI.h", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h", "js/src/jsapi-tests/testGCWeakCache.cpp", "js/src/shell/jsshell.h", "js/src/vm/InvalidatingFuse.h", "js/src/vm/Realm.h", "js/src/vm/RegExpShared.h", "js/src/vm/Runtime.cpp", "js/src/vm/Runtime.h", "js/src/vm/ShapeZone.h", "js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmJS.h", "js/src/wasm/WasmTable.h"], "git_node": null, "git_parents": [null], "node": "ccfd096507865f81453d86b2f54154f6b8f2aa16", "parents": ["add8899c3692ae47e20a5fdb4cf24d75589ace74"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907070 - Part 2: Make SweepingAPI.h a public header (backout of changeset 2592881b3f6d) r=sfink a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216167", "files": ["js/public/GCHashTable.h", "js/public/SweepingAPI.h", "js/src/gc/GCRuntime.h", "js/src/gc/SweepingAPI.h", "js/src/jit/CacheIRCompiler.cpp", "js/src/jsapi-tests/testGCWeakCache.cpp", "js/src/moz.build", "js/src/shell/js.cpp", "js/src/vm/InvalidatingFuse.h", "js/src/vm/RegExpShared.h", "js/src/vm/ShapeZone.h", "js/src/wasm/WasmJS.h"], "git_node": null, "git_parents": [null], "node": "442df66c1f341ec92b27b8c477e207b2d519e2d6", "parents": ["ccfd096507865f81453d86b2f54154f6b8f2aa16"], "tags": []}], "date": 1721425950, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "40": {"changesets": [{"author": "Jan Varga \u003cjvarga@mozilla.com\u003e", "branch": "default", "desc": "Bug 1903252 - Move crash tests for IndexedDB to dom/indexedDB/test; r=dom-storage-reviewers,aiunusov a=test-only", "files": ["dom/indexedDB/crashtests/1499854-1.html", "dom/indexedDB/crashtests/1505821-1.html", "dom/indexedDB/crashtests/1543154-1.html", "dom/indexedDB/crashtests/1813284-1.html", "dom/indexedDB/crashtests/1857979-1.html", "dom/indexedDB/crashtests/726376-1.html", "dom/indexedDB/crashtests/crashtests.list", "dom/indexedDB/test/crashtests/1499854-1.html", "dom/indexedDB/test/crashtests/1505821-1.html", "dom/indexedDB/test/crashtests/1543154-1.html", "dom/indexedDB/test/crashtests/1813284-1.html", "dom/indexedDB/test/crashtests/1857979-1.html", "dom/indexedDB/test/crashtests/726376-1.html", "dom/indexedDB/test/crashtests/crashtests.list", "testing/crashtest/crashtests.list", "testing/runtimes/manifest-runtimes-android.json", "testing/runtimes/manifest-runtimes-unix.json", "testing/runtimes/manifest-runtimes-windows.json"], "git_node": null, "git_parents": [null], "node": "dad51718cd79164783434fcf9648a1a72e81a428", "parents": ["442df66c1f341ec92b27b8c477e207b2d519e2d6"], "tags": []}], "date": 1721426648, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "41": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1905505 - Avoid scheduling background shutdown when it is already stopped  a=dmeehan\n\nThis patch adds a bunch of checks + early returns to make sure that the\nidle timer is NOT started when the background context is in the STOPPED\nstate. Encountering these errors is an implementation flaw, and the\nerrors should never been seen in practice.\n\nThe logs added in this commit should never be seen in the wild.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216986", "files": ["toolkit/components/extensions/parent/ext-backgroundPage.js", "toolkit/components/extensions/test/xpcshell/test_ext_eventpage_idle.js"], "git_node": null, "git_parents": [null], "node": "470f3b67c904086dbc437889676ac50b7ab15eed", "parents": ["dad51718cd79164783434fcf9648a1a72e81a428"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1905505 - Remove unnecessary resetIdleOnEvent from child modules  a=dmeehan\n\nThis patch updates every use of EventManager in child/ext-*.js files\nthat can referenced from extension contexts of envType \"addon_child\".\n\nPre patch, these could trigger \"background-script-reset-idle\" and\nresult in triggering \"background-script-reset-idle\" in the parent\ndespite the background being stopped, and consequently trigger the\nreported bug. The previous patch fixes the negative consequence of this\nunexpected event, this patch fixes an underlying cause by removing the\ntriggers.\n\nForcing resetIdleOnEvent to false does not have any negative impact on\nthese modules, because all of these events are dependencies of an\nEventManager in the parent, which already activates the functionality\nassociated with resetIdleOnEvent=true.\n\nTo minimize the likelihood of affecting unit tests, this patch keeps the\nEventManager of test.onMessage at resetIdleOnEvent=true as before, and\ndefers to bug 1901294 for changing it to false.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215298\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216987", "files": ["browser/components/extensions/child/ext-menus.js", "browser/components/extensions/child/ext-omnibox.js", "toolkit/components/extensions/child/ext-storage.js", "toolkit/components/extensions/child/ext-test.js", "toolkit/components/extensions/child/ext-webRequest.js"], "git_node": null, "git_parents": [null], "node": "e0bfbbd93ea6e6f879be0c931db3b21d4b48d184", "parents": ["470f3b67c904086dbc437889676ac50b7ab15eed"], "tags": []}], "date": 1721478225, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "42": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217236", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "da2c49767475f7db01a9da719a7298133843af2a", "parents": ["e0bfbbd93ea6e6f879be0c931db3b21d4b48d184"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 1875768 - Use pthread_equal in IsOnMainThread and MaybeMutex r=glandium, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212228", "files": ["memory/build/Mutex.h", "memory/build/mozjemalloc.cpp"], "git_node": null, "git_parents": [null], "node": "b06fe1e55f9b4920aae09ff9b356bed844a0b937", "parents": ["da2c49767475f7db01a9da719a7298133843af2a"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 1875768 - Run PostForkMainThread before iterating the arenas r=glandium, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212229", "files": ["memory/build/mozjemalloc.cpp"], "git_node": null, "git_parents": [null], "node": "051d4c4b9425e6a3116e3e093fd87feb23ebe91e", "parents": ["b06fe1e55f9b4920aae09ff9b356bed844a0b937"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 1875768 - Clear mMainThreadId after a fork in the child r=glandium, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212230", "files": ["memory/build/mozjemalloc.cpp"], "git_node": null, "git_parents": [null], "node": "9a4d45dcfb626f7d92ce84f85a0ad850d6e8ac45", "parents": ["051d4c4b9425e6a3116e3e093fd87feb23ebe91e"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 1875768 - Call the appropriate postfork handler on MacOS r=glandium, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212231", "files": ["memory/build/mozjemalloc.cpp", "memory/build/zone.c"], "git_node": null, "git_parents": [null], "node": "c3084a4d42979ded6a37a8eff37297fd8136b84c", "parents": ["9a4d45dcfb626f7d92ce84f85a0ad850d6e8ac45"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908115 - disable network.auth.use_redirect_for_retries for release. r=necko-reviewers,kershaw, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216816", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "afc5523f1dc653c6b201f9aebeefc8c741ac24db", "parents": ["c3084a4d42979ded6a37a8eff37297fd8136b84c"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1904644 - Share more exception handling code. r=rhunt, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214959", "files": ["js/src/jit/JitFrames.cpp", "js/src/jit/arm/MacroAssembler-arm.cpp", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/mips32/MacroAssembler-mips32.cpp", "js/src/jit/mips64/MacroAssembler-mips64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x86/MacroAssembler-x86.cpp", "js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmBuiltins.h", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h"], "git_node": null, "git_parents": [null], "node": "9d0bd5bd89333365c37b7fa053b26c2630d23654", "parents": ["afc5523f1dc653c6b201f9aebeefc8c741ac24db"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1899516 - Warn user when missing unprivileged user namespace r=firefox-desktop-core-reviewers ,fluent-reviewers,Gijs,flod, a=dmeehan, l10n=bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212024", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/tests/browser/browser.toml", "browser/components/tests/browser/browser_browserGlue_userNamespacesNotification.js", "modules/libpref/init/StaticPrefList.yaml", "security/sandbox/common/SandboxUtils.sys.mjs", "security/sandbox/common/moz.build", "toolkit/locales/en-US/toolkit/updates/elevation.ftl"], "git_node": null, "git_parents": [null], "node": "27a532eabc9002edf809716d42c3b5db2586d2a1", "parents": ["9d0bd5bd89333365c37b7fa053b26c2630d23654"], "tags": []}], "date": 1721652551, "git_changesets": [null, null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "43": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1896625 - Support creating TLS tunnel for WebrtcTCPSocket,  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217025", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/transport/ipc/WebrtcTCPSocket.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/TLSTransportLayer.cpp", "netwerk/protocol/http/nsHttp.cpp", "netwerk/protocol/http/nsHttp.h", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.h", "netwerk/protocol/http/nsIHttpChannelInternal.idl", "netwerk/test/unit/test_proxyconnect.js", "netwerk/test/unit/test_proxyconnect_https.js", "netwerk/test/unit/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "f80574ecc83730f94f4dbe793939511c21b59c06", "parents": ["27a532eabc9002edf809716d42c3b5db2586d2a1"], "tags": []}], "date": 1721653949, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "44": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909281 - Mark Page.authenticate test as FAIL/PASS due to different values for use_redirect_for_retries  a=dmeehan\n\nOnly required for 128 release and ESR, next releases only have one event for auth attempts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217306", "files": ["remote/test/puppeteer/test/TestExpectations.json"], "git_node": null, "git_parents": [null], "node": "abafaa9752ed18ebef2c86ccf547aaf0c2e90051", "parents": ["f80574ecc83730f94f4dbe793939511c21b59c06"], "tags": []}], "date": 1721669540, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "45": {"changesets": [{"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909256 - Update FeatureManifest weatherLocationSearch to use setPref instead of fallbackPref  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217289\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217294", "files": ["toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": null, "git_parents": [null], "node": "20d1d5ce07ffaaa7734db46eed4bf3ee098bc165", "parents": ["abafaa9752ed18ebef2c86ccf547aaf0c2e90051"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1904087 - block Teruten DLLs from the content process to avoid crashes  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215958\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217336", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": null, "git_parents": [null], "node": "9a8bf2a5db06fab93d57f6dca2f43fd604308a1f", "parents": ["20d1d5ce07ffaaa7734db46eed4bf3ee098bc165"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909219 - Add null-checks for mAuthProvider. a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217324\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217337", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": null, "git_parents": [null], "node": "f3dfb3250704839953559752ac64a9ceadd8450c", "parents": ["9a8bf2a5db06fab93d57f6dca2f43fd604308a1f"], "tags": []}], "date": 1721688163, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "46": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1907968 - Disable Nimbus when Shield is disallowed by enterprise policy  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216601\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217304", "files": ["toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "b376a48e97ac249a1ac19fbe3cfea4bab59cd5fd", "parents": ["f3dfb3250704839953559752ac64a9ceadd8450c"], "tags": []}], "date": 1721742926, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "47": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907968 - Fix lint failures on ESR128. a=me", "files": ["toolkit/components/nimbus/test/unit/test_policy.js"], "git_node": null, "git_parents": [null], "node": "046f9138c3395c963940b9d6d1a69797e43ac4f3", "parents": ["b376a48e97ac249a1ac19fbe3cfea4bab59cd5fd"], "tags": []}], "date": 1721745285, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "48": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1871303 - Ensure there is no more marking at the start of sweeping r=sfink, a=dmeehan\n\nThere are two issues here. The first is that there unexpected marking work at\nthe start of sweeping after entering from the mark phase without yielding. We\npreviously called assertNoMarkingWork() after markUntilBudgetExhausted() in the\nmarking phase so something since then must have added it.\n\nAs far as I can tell this must be the conditional call to\ncollectNurseryFromMajorGC(), where a post barrier for a pointer cleared during\nfinalization (e.g. for Maps in mapObject::sweepAfterMinorGC) ends up marking\nsomething. I'm not sure such barriers are necessary, but for now the safest\nthing to do is to move this nursery collection to the start of the slice so\nthat it happens before we drain the mark stack.\n\nThe second issue is that we check the budget and conditionally yield if we\nenter from the marking state. The comment above this code states that this is\nnot safe since we have not yet started sweeping a sweep group. This check was\nadded in bug 1865383 but was not the main part of the fix. I think we should\nremove this.\n\nI wasn't able to come up with a test case to reproduce this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215925", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp"], "git_node": null, "git_parents": [null], "node": "17ff7300dbe0471b1b5dad91f7b155f67a872bc5", "parents": ["046f9138c3395c963940b9d6d1a69797e43ac4f3"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1834864 - Select BCG more consistently during COOP+COEP process switches, r=smaug,tabbrowser-reviewers,mak, a=dmeehan\n\nPreviously it was possible to bypass specific BCG selection based on\ncross-origin isolated status if the site was allowed to load file URIs\nusing enterprise policies, which could lead to a crash.\n\nThis patch changes the behaviour such that BCG selection now happens\ncorrectly. The site will still not be cross-origin isolated due to being\nloaded into a file content process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217007", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_new_file_whitelisted_http_tab.js", "browser/components/tabbrowser/test/browser/tabs/file_coop_coep.html", "browser/components/tabbrowser/test/browser/tabs/file_coop_coep.html^headers^", "docshell/base/CanonicalBrowsingContext.cpp", "dom/ipc/ProcessIsolation.cpp", "dom/ipc/ProcessIsolation.h"], "git_node": null, "git_parents": [null], "node": "d9dbb4bc8a66fac9d95fc18122303f96f82c8ae5", "parents": ["17ff7300dbe0471b1b5dad91f7b155f67a872bc5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1908242 - Minor clean-ups to StickyScrollContainer. r=TYLin,layout-reviewers, a=dmeehan\n\nRemove one totally unused function, and some useless virtual keywords.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216860", "files": ["layout/generic/StickyScrollContainer.cpp", "layout/generic/StickyScrollContainer.h", "layout/generic/nsIFrame.h"], "git_node": null, "git_parents": [null], "node": "6c401250eae382afc2d12de79584326adfa9cbe1", "parents": ["d9dbb4bc8a66fac9d95fc18122303f96f82c8ae5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1908242 - Make sure that sticky items are processed in the right order. r=TYLin, a=dmeehan\n\nWe rely on positioning ancestors before descendants to get the right\nposition. This was very implicitly enforced before the regressing bug,\nby reframing on position changes (due to the order\nStickyScrollContainer::AddFrame was called, ancestors before children).\n\nIn order to support dynamic sticky changes without reframing, we need to\nhandle the case of an existing ancestor switching position to sticky\ndynamically.\n\nLuckily we already have the right data-structure for that, so the change\nis rather trivial.\n\nWrite a testharness test for this because APZ does get the position\nright, so it's more future-proof against regressions to just test the\nraw layout values.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216858", "files": ["layout/base/DepthOrderedFrameList.h", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/StickyScrollContainer.cpp", "layout/generic/StickyScrollContainer.h", "testing/web-platform/tests/css/css-position/position-sticky-dynamic-ancestor-001.html"], "git_node": null, "git_parents": [null], "node": "028e071b9448383b84035e6b402166066d638528", "parents": ["6c401250eae382afc2d12de79584326adfa9cbe1"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1897255 - Make `nsIFrame::PeekOffsetForLine` won't cross editing host boundary unless the callers allows that r=emilio, a=dmeehan\n\nThe problems in the testcase are, `nsIFrame::PeekOffsetForLine` returns a frame\nfor any content node outside the editing host and `nsIFrame::GetLastLeaf`\nreturns a native anonymous subtree node if the frame is for the native\nanonymous subtree root like `\u003cinput\u003e` or `\u003ctextarea\u003e`.\n\nFor fixing the former, the methods need to check whether found frame's editable\nstate **and** whether the editable node is an inclusive descendant of the\nediting host.  However, there are complicated cases with inline editing hosts\nand elements whose `contenteditable` is set to `false` and this is a new\nregression for ESR 128.  Therefore, we need to fix this without any behavior\nchanges as far as possible.  Therefore, this patch basically checks only whether\nthe editing state of found one is editable and/or whether the one is an\ninclusive descendant of the editing host to avoid `Selection` moves outside the\nediting host.  The reaming complicated cases should be handled in new bugs which\nblocks bug 1873155.\n\nFor fixing the latter, `nsIFrame::GetLastLeaf` needs to check the given frame's\ncontent is a native anonymous subtree root or not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216371", "files": ["layout/generic/SelectionMovementUtils.cpp", "layout/generic/SelectionMovementUtils.h", "layout/generic/nsFrameSelection.cpp", "layout/generic/nsFrameSelection.h", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/generic/nsIFrameInlines.h", "testing/web-platform/tests/selection/crashtests/selection-modify-line-from-contenteditable-to-textarea.html"], "git_node": null, "git_parents": [null], "node": "c65969507ce59b5edd42faccc902a1d4e14f6f49", "parents": ["028e071b9448383b84035e6b402166066d638528"], "tags": []}], "date": 1721756533, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "49": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908466 - Ensure source signal is not null when creating a dependent signal.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217233\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217452", "files": ["dom/abort/AbortSignal.cpp", "testing/web-platform/tests/dom/abort/abort-signal-any-crash.html"], "git_node": null, "git_parents": [null], "node": "8ab8cee6727cdde127fc20fee46725cc066db997", "parents": ["c65969507ce59b5edd42faccc902a1d4e14f6f49"], "tags": []}], "date": 1721771091, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "50": {"changesets": [{"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1908317 - Add XP_SOLARIS to media-related prefs r=padenot, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217227", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "15725075b76e157bfb3c83e7210a5788f27161cd", "parents": ["8ab8cee6727cdde127fc20fee46725cc066db997"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907783 - Use the new clear on shutdown branch to prevent losing pending shutdown items on unexpected shutdown. r=pbz,places-reviewers,Standard8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216616", "files": ["browser/components/places/tests/unit/test_clearHistory_shutdown_v2.js", "browser/components/places/tests/unit/xpcshell.toml", "browser/modules/Sanitizer.sys.mjs", "browser/modules/test/unit/test_Sanitizer_interrupted_v2.js", "browser/modules/test/unit/xpcshell.toml", "security/manager/ssl/tests/unit/test_sss_sanitizeOnShutdown_v2.js", "security/manager/ssl/tests/unit/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "1aacb4ce03b6c4dee88556658e087eb6d5043890", "parents": ["15725075b76e157bfb3c83e7210a5788f27161cd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1907789 - Fix some edge cases when handling removal / reconstruction of table captions and col groups. r=dholbert, a=dmeehan\n\nBeing the last caption is not enough to remove an anonymous table (and\ntable wrapper).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216587", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-tables/remove-caption-from-anon-table-ref.html", "testing/web-platform/tests/css/css-tables/remove-caption-from-anon-table.html", "testing/web-platform/tests/css/css-tables/remove-colgroup-from-anon-table.html"], "git_node": null, "git_parents": [null], "node": "d660dcfb24be02ed66359bc73b50390572ef8634", "parents": ["1aacb4ce03b6c4dee88556658e087eb6d5043890"], "tags": []}], "date": 1721826786, "git_changesets": [null, null, null], "user": "dmeehan@mozilla.com"}, "51": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1909566 - pixman: Adjust arm assembly for binutils change.  a=dmeehan\n\nA change in the latest version of binutils broke building pixman for arm.\n\nThe binutils change:\nhttps://sourceware.org/git/?p=binutils-gdb.git;a=commit;h=226749d5a6ff0d5c607d6428d6c81e1e7e7a994b\n\nThis change was committed upstream in\nhttps://gitlab.freedesktop.org/pixman/pixman/-/commit/865e6ce00bb79a6b925ed4c2c436e1533e4472aa\nand will be in the next release.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217517\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217540", "files": ["gfx/cairo/libpixman/src/pixman-arm-simd-asm.S"], "git_node": null, "git_parents": [null], "node": "95dce030f3429bbce4c19321de7a78a386182a5c", "parents": ["d660dcfb24be02ed66359bc73b50390572ef8634"], "tags": []}], "date": 1721857014, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "52": {"changesets": [{"author": "John Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909713 - land NSS NSS_3_101_2_RTM UPGRADE_NSS_RELEASE, r=keeler a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217596", "files": ["security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/doc/rst/releases/nss_3_101.2.rst", "security/nss/lib/freebl/chacha20poly1305.c"], "git_node": null, "git_parents": [null], "node": "61b0194d4a778aed668896b2f3735153f56f68d2", "parents": ["95dce030f3429bbce4c19321de7a78a386182a5c"], "tags": []}], "date": 1721858410, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "53": {"changesets": [{"author": "Jan Varga \u003cjvarga@mozilla.com\u003e", "branch": "default", "desc": "Bug 1906083 - Add a bool template argument to TypedArray::ProcessData to enable support for large types arrays; r=peterv, a=dmeehan\n\nCurrently, there isn't a straightforward and safe method to verify the length\nbefore invoking TypedArray::ProcessData. If the length isn't checked and\nexceeds INT32_MAX, it triggers a release assert. The addition of the\nAllowLargeTypedArrays argument offers a mechanism to validate the length within\nthe processor, allowing for an error to be returned if necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215478", "files": ["dom/bindings/TypedArray.h"], "git_node": null, "git_parents": [null], "node": "b31aaf10a1b8e99c8e3f1357fb2a74895cffe02c", "parents": ["61b0194d4a778aed668896b2f3735153f56f68d2"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1895951 - Switch IndexedDB to newer ArrayBuffer (or view) APIs. r=dom-storage-reviewers,sfink,jari, a=dmeehan\n\nThe patch has been authored by Steve Fink, Jari Jalkanen and Jan Varga.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211140", "files": ["dom/indexedDB/Key.cpp", "dom/indexedDB/Key.h"], "git_node": null, "git_parents": [null], "node": "2c95a4fcedf871bc7b391072a4d18f78e6c73bcb", "parents": ["b31aaf10a1b8e99c8e3f1357fb2a74895cffe02c"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909666 - Re-enable network.http.http2.enabled.deps and not send SETTINGS_NO_RFC7540_PRIORITIES, r=necko-reviewers,jesup, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217584", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp"], "git_node": null, "git_parents": [null], "node": "f2b2ddeea7c58823eff8aaa2fa659aa5f1383ab2", "parents": ["2c95a4fcedf871bc7b391072a4d18f78e6c73bcb"], "tags": []}, {"au