s:39848:"{
"lastpushid": 336,
"pushes": {"46": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging fc56efe4d94deab2c7d3ee49f116e98d0bc827f6 with FIREFOX_78_1_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "20c2d22d6e0398000ba2e3445555115ac5517aad", "parents": ["fc56efe4d94deab2c7d3ee49f116e98d0bc827f6"], "tags": []}], "date": 1595440950, "git_changesets": [null], "user": "ffxbld"}, "47": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84696", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/main/search-default-override-allowlist.json"], "git_node": null, "git_parents": [null], "node": "e88786724ab69befc700c4acacdc74ddad1675e6", "parents": ["20c2d22d6e0398000ba2e3445555115ac5517aad"], "tags": []}], "date": 1595515843, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "48": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "b8fb2675b0a32cddc95be3d50cee6f3069b41a1f", "parents": ["e88786724ab69befc700c4acacdc74ddad1675e6"], "tags": []}], "date": 1595879284, "git_changesets": [null], "user": "ffxbld-merge"}, "49": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging fc56efe4d94deab2c7d3ee49f116e98d0bc827f6 with FIREFOX_78_1_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "36ee3dd48dc50b1c0fd8bb7126973f3db76a7389", "parents": ["b8fb2675b0a32cddc95be3d50cee6f3069b41a1f"], "tags": []}], "date": 1595940661, "git_changesets": [null], "user": "ffxbld"}, "50": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_78_0_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_78_0_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "02ae44b542c719832a8fe9deae542aebb8273b17", "parents": ["6e1145ecb9914c071b0066b3422ff33464196190"], "tags": []}], "date": 1596470222, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "51": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85758", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "44adce0359d1221264bc4a0d131cf251a7df2389", "parents": ["36ee3dd48dc50b1c0fd8bb7126973f3db76a7389"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1571156: Wait for streams to be ready before trying to send packets. r=mjf, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84251", "files": ["media/mtransport/test/ice_unittest.cpp"], "git_node": null, "git_parents": [null], "node": "212d37ac070125486a182c2095f3a87e7581b9dd", "parents": ["44adce0359d1221264bc4a0d131cf251a7df2389"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1654465 - Set -Cembed-bitcode=yes instead of CARGO_PROFILE_RELEASE_LTO. r=firefox-build-system-reviewers,rstewart, a=RyanVM\n\nIt turns out setting CARGO_PROFILE_RELEASE_LTO has unwanted side\neffects.\n\nFirst it's not actually strictly equivalent to using `cargo rustc --\n-Clto`. For instance, it apparently also enables cross-language LTO in\nnewer versions of cargo.\n\nSecond, it changes the rust computed hash for all the dependencies of\nthe crate being built with the variable set, which makes them diverge\nfrom when the same dependencies are built through another crate in the\ntree that is not LTOed. This effectively makes us build a _lot_ of\ncrates twice, many of which are not cacheable.\n\nSince the original problem is that cargo \u003e= 1.45 passes extra flags (`-C\nembed-bitcode=no`) to rustc that are incompatible with `-Clto`, and while\nit knows to adjust based on the `lto` setting in the build profile\n(which CARGO_PROFILE_RELEASE_LTO overrides the default of), cargo\nignores flags passed via `cargo rustc -- ...` when making those\nadjustments.\n\nSo, we need to override with `-C embed-bitcode=yes` on our own at the\nsame time we pass `-Clto`. But doing that through `cargo rustc -- ...`\nis not enough because all the dependencies of the crate built with\n`-Clto` need to be built with `-C embed-bitcode=yes`. So we need to\noverride with `RUSTFLAGS`, which will affect all the dependencies.\nBut we also need to do this consistently across all crates, not only the\ndependencies of crates built with `-Clto`, otherwise we'd still end up\nbuilding crates twice (once with and once without the override).\n\nUnfortunately, the `-C embed-bitcode=*` flag is also not supported in\nversions older than 1.45, so we have to avoid adding it on older\nversions.\n\nWe unfortunately support a large range of versions of rustc (albeit only\nfor tools/crashreporter), but we actually need to upgrade the smaller\nsupported version because rustc \u003c 1.38 doesn't support our top-level\nCargo.lock. This makes the version check slightly less awful.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84652", "files": ["build/moz.configure/rust.configure", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": null, "git_parents": [null], "node": "9181214a2308b5b614e7a60c6e99bd3130a9ed2b", "parents": ["212d37ac070125486a182c2095f3a87e7581b9dd"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 1644070 - add missing URLish attributes to TreeSanitizer r=hsivonen a=RyanVM\n\nThis adds the elements `formaction`, `data`, `ping`, `poster`.\n\nWe can't really add a test for the `\u003cobject data\u003e`, since we never\nallow `\u003cobject\u003e` elements in the first place and we don't allow\nsettings exceptions for temporarily allowed elements.\nSame for `poster` elements, since it's only used in media elements\nand those are either all allowed or none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78638", "files": ["dom/base/nsTreeSanitizer.cpp", "dom/base/test/test_bug650776.html", "parser/xml/test/unit/results.js"], "git_node": null, "git_parents": [null], "node": "e151724f6d6490f642dd511f76c6d3c3ed6f204a", "parents": ["9181214a2308b5b614e7a60c6e99bd3130a9ed2b"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1644575: Change SFNTData::GetUniqueKey to use a hash of head tables within the font data. r=jfkthame, a=RyanVM\n\nThis is used instead of hashing the first full name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80412", "files": ["gfx/2d/SFNTData.cpp", "gfx/2d/SFNTData.h"], "git_node": null, "git_parents": [null], "node": "191dca09c9eec900dafdd854e2d324c884c19698", "parents": ["e151724f6d6490f642dd511f76c6d3c3ed6f204a"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1644575 part 2: Remove now unused SFNT* files and functions. r=jfkthame, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80429", "files": ["gfx/2d/SFNTData.cpp", "gfx/2d/SFNTData.h", "gfx/2d/SFNTNameTable.cpp", "gfx/2d/SFNTNameTable.h", "gfx/2d/moz.build"], "git_node": null, "git_parents": [null], "node": "d9d20fc8ed659f5f2c1724b5fce790023d4421ed", "parents": ["191dca09c9eec900dafdd854e2d324c884c19698"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1647816 - Make sandboxing OS version checks aware of major version. r=spohl, a=RyanVM\n\nFix the content and Flash sandbox policies to use the major and minor number for OS version checks allowing video playback to work properly on macOS 11 Big Sur.\n\nPass the macOS major and minor version to sandbox policies as a combined string.\n\nRemove unused OSXVersion methods and members and more minor cleanup in Sandbox.mm.\n\nLeave in the checks for unsupported versions (macOS 10.9 - 10.11) for now in case this fix needs to be uplifted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81385", "files": ["security/sandbox/mac/Sandbox.mm", "security/sandbox/mac/SandboxPolicyContent.h", "security/sandbox/mac/SandboxPolicyFlash.h"], "git_node": null, "git_parents": [null], "node": "c9bb48782bcfbcdb7254ed85f4f546c1f9a8c444", "parents": ["d9d20fc8ed659f5f2c1724b5fce790023d4421ed"], "tags": []}], "date": 1596472936, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "52": {"changesets": [{"author": "William Durand \u003cwill+git@drnd.me\u003e", "branch": "default", "desc": "Bug 1648036 - Use `window.location` to determine the `sourceURL`/`sourceHost` when installing an add-on. r=rpl, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82738", "files": ["toolkit/mozapps/extensions/amInstallTrigger.jsm", "toolkit/mozapps/extensions/amWebAPI.jsm", "toolkit/mozapps/extensions/test/browser/browser.ini", "toolkit/mozapps/extensions/test/browser/browser_installtrigger_install.js", "toolkit/mozapps/extensions/test/browser/browser_webapi_install.js"], "git_node": null, "git_parents": [null], "node": "743b5298c4dba6f20516a8eacf93132a2ff0d62b", "parents": ["c9bb48782bcfbcdb7254ed85f4f546c1f9a8c444"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1654982 - Don't default to sending 'silent' print jobs to a file. r=nordzilla, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84840", "files": ["widget/cocoa/nsPrintSettingsX.mm"], "git_node": null, "git_parents": [null], "node": "f2444c2883c04728a5e0b78cfb037d0f612c45b0", "parents": ["743b5298c4dba6f20516a8eacf93132a2ff0d62b"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1654982 - Ensure job disposition is set correctly for output to a file. r=nordzilla, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84906", "files": ["widget/cocoa/nsDeviceContextSpecX.mm", "widget/cocoa/nsPrintSettingsX.h", "widget/cocoa/nsPrintSettingsX.mm"], "git_node": null, "git_parents": [null], "node": "f0bffb23722d09ec366cbbc85db086e4bb5d6911", "parents": ["f2444c2883c04728a5e0b78cfb037d0f612c45b0"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1651001 - post-barrier delegate restoration. r=jonco, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83704", "files": ["js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.h", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h", "js/src/jit-test/tests/gc/weakmark-remap.js", "js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/vm/Compartment.cpp", "js/src/vm/ProxyObject.cpp"], "git_node": null, "git_parents": [null], "node": "2b9182c2d8aa0e71a69e7563f68c78ee3c900037", "parents": ["f0bffb23722d09ec366cbbc85db086e4bb5d6911"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1651001 - avoid reentry with same-zone weakmap delegates. r=jonco, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84579", "files": ["js/src/gc/Marking.cpp", "js/src/jit-test/tests/gc/weakmark-remap2.js"], "git_node": null, "git_parents": [null], "node": "9fd18fc98364e641a62db7b6d62451c367aa5a6e", "parents": ["2b9182c2d8aa0e71a69e7563f68c78ee3c900037"], "tags": []}, {"author": "Kai Engert \u003ckaie@kuix.de\u003e", "branch": "default", "desc": "Bug 1648836 - Uplift NSPR 4.25.1 to support macOS 11. r=jcj, a=RyanVM UPGRADE_NSPR_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84741", "files": ["nsprpub/TAG-INFO", "nsprpub/configure", "nsprpub/configure.in", "nsprpub/pr/include/prinit.h", "nsprpub/pr/src/linking/prlink.c", "nsprpub/pr/tests/vercheck.c"], "git_node": null, "git_parents": [null], "node": "144ac8f6c028a5fe1c7959d24d39b1924cb94497", "parents": ["9fd18fc98364e641a62db7b6d62451c367aa5a6e"], "tags": []}], "date": 1596479359, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "53": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1604749: Get misc worker-type from graph config; r=Callek a=tomprince DONTBUILD\n\nThe original patch calculated the worker type, but didn't use it in the\ngenerated task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D61643", "files": ["taskcluster/taskgraph/morph.py"], "git_node": null, "git_parents": [null], "node": "57824aa9e179d1c66d2059758c3381f7cf6f8e7c", "parents": ["144ac8f6c028a5fe1c7959d24d39b1924cb94497"], "tags": []}], "date": 1596658632, "git_changesets": [null], "user": "mozilla@hocat.ca"}, "54": {"changesets": [{"author": "Perry Jiang \u003cperry@mozilla.com\u003e", "branch": "default", "desc": "Bug 1632036 - check for null global when freezing/thawing WorkerPrivate r=dom-workers-and-storage-reviewers,sg, a=jcristau\n\n- Apply pointer guidelines to ClientSource getter.\n- When freezing/thawing WorkerPrivate, check if the client/global is null. It seems possible that the client is null because the WorkerPrivate can remain registered to the RuntimeService even if it failed to create its global, and freezing/thawing is done through the RuntimeService. The other two callsites to get the client won't execute unless CompileScriptRunnable successfully creates the client.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82482", "files": ["dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerScope.h"], "git_node": null, "git_parents": [null], "node": "8fcbcd0de7c6517f2db108c41c8a35587afbc759", "parents": ["57824aa9e179d1c66d2059758c3381f7cf6f8e7c"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 1450853 - Use Generic Error for 3rdparty MediaElement r=ckerschb,smaug, a=jcristau\n\n***\nAdd test\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80080", "files": ["dom/html/HTMLMediaElement.cpp", "dom/security/test/general/mochitest.ini", "dom/security/test/general/test_bug1450853.html"], "git_node": null, "git_parents": [null], "node": "f46af8bc88a4c3ba617056cca36165542c928d85", "parents": ["8fcbcd0de7c6517f2db108c41c8a35587afbc759"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 436200 - Add a pref to turn off warning submitting secure to insecure. r=dveditz,pbz, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83863", "files": ["dom/html/HTMLFormElement.cpp", "dom/html/test/browser.ini", "dom/html/test/browser_bug436200.js", "dom/html/test/bug436200.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "48174c4ae8eed9518fe8c9db9bfcfbb1383d0e32", "parents": ["f46af8bc88a4c3ba617056cca36165542c928d85"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1654626 - fix crash in [@ mozilla::storage::Connection::ExecuteAsync]. r=mak, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84589", "files": ["storage/mozStorageConnection.cpp"], "git_node": null, "git_parents": [null], "node": "f36ff66bf1067a348bbfc8c9d9dba78e708d864a", "parents": ["48174c4ae8eed9518fe8c9db9bfcfbb1383d0e32"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1655655 - Some MP4 Videos Fail to Play on Big Sur. r=spohl, a=jcristau\n\nAllow access to the \"com.apple.trustd.agent\" service in the content process sandbox. VTDecompressionSessionCreate() fails without it, causing playback failure for some MP4 videos.\n\nTranslate deprecated OS version numbers so that sandbox version checks don't need to check for 10.16.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85213", "files": ["security/sandbox/mac/Sandbox.mm", "security/sandbox/mac/SandboxPolicyContent.h"], "git_node": null, "git_parents": [null], "node": "e7ce3379c574e203cd00a338f6e389efe5c158a6", "parents": ["f36ff66bf1067a348bbfc8c9d9dba78e708d864a"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 1648964 - Always check for Firefox when creating WebDriver session, r=webdriver-reviewers,whimboo,maja_zf, a=jcristau\n\nWhen creating a Firefox session with a custom binary, ensure that it\neither has a valid application ini file or a valid version string when\nrun with --version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81531", "files": ["testing/geckodriver/src/capabilities.rs", "testing/webdriver/src/capabilities.rs"], "git_node": null, "git_parents": [null], "node": "cf657f2ec1491008aef2162051f4ff0f15fe0949", "parents": ["e7ce3379c574e203cd00a338f6e389efe5c158a6"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 1648964 - Pass double-dash options to Firefox, r=webdriver-reviewers,whimboo, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81532", "files": ["testing/geckodriver/src/android.rs", "testing/geckodriver/src/capabilities.rs", "testing/geckodriver/src/marionette.rs"], "git_node": null, "git_parents": [null], "node": "13f10d164293025c9eea3dad7e15e50e896831ac", "parents": ["cf657f2ec1491008aef2162051f4ff0f15fe0949"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 1648964 - Improve content-type header handling, r=webdriver-reviewers,whimboo, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81533", "files": ["testing/webdriver/src/server.rs"], "git_node": null, "git_parents": [null], "node": "84ee8424783080357b39147c92d087e285586a1c", "parents": ["13f10d164293025c9eea3dad7e15e50e896831ac"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 1648964 - Improve Origin header handling, r=freddyb,webdriver-reviewers,whimboo, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81534", "files": ["testing/webdriver/src/server.rs"], "git_node": null, "git_parents": [null], "node": "17aa7639d66a9f5cb7039f1d519f90a1dcde2d07", "parents": ["84ee8424783080357b39147c92d087e285586a1c"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 1648964 - Return proper error when the server starts, r=freddyb,webdriver-reviewers,whimboo, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81574", "files": ["testing/webdriver/src/server.rs"], "git_node": null, "git_parents": [null], "node": "34006a2e14797314fc30b4d99eb881bb35ea7734", "parents": ["17aa7639d66a9f5cb7039f1d519f90a1dcde2d07"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1655575 - Add enterprise policy for xr permission. r=emalysz, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85200", "files": ["browser/base/content/pageinfo/permissions.js", "browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_pageinfo_permissions.js", "browser/components/enterprisepolicies/tests/xpcshell/test_permissions.js"], "git_node": null, "git_parents": [null], "node": "89bd47656f3d849c2be15c87f8d4afae756c48e9", "parents": ["34006a2e14797314fc30b4d99eb881bb35ea7734"], "tags": []}], "date": 1596709896, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "jcristau@mozilla.com"}, "55": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86215", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "e21bf8670b749d1dbe7e8aaede34668685d91f0e", "parents": ["89bd47656f3d849c2be15c87f8d4afae756c48e9"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1620264 - Fix browser_rules_media-queries_reload.js intermittent. r=gl, a=test-only\n\nInstead of relying on events being fired, we wait until the rule view displays\nthe properties we expect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85005", "files": ["devtools/client/inspector/rules/test/browser_rules_media-queries_reload.js"], "git_node": null, "git_parents": [null], "node": "