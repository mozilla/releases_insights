eb-platform/meta/html/dom/__dir__.ini", "testing/web-platform/meta/html/rendering/replaced-elements/__dir__.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/__dir__.ini"], "git_node": null, "git_parents": [null], "node": "a912e4ed04b07d02eb39861b185dc8a8f301089d", "parents": ["8ac708cf124839d3d4d4ff13f2a034b560fd73d6"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86969", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "7d8b9ab25b079f968bf16c77b5a46b7c474eba6c", "parents": ["a912e4ed04b07d02eb39861b185dc8a8f301089d"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1651449 - rework intermediate caching to use a serial background task queue. r=kjacobs,rmf a=RyanVM\n\nnsNSSComponent now has a background task queue that is used for importing\nintermediates from TLS connections instead of using the certificate\nverification thread pool.\n\nThis patch also addresses places where PSM was directly accessing the isperm\nmember of CERTCertificate, which is protected by a lock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86878", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp", "security/manager/ssl/nsINSSComponent.idl", "security/manager/ssl/nsNSSCertificateDB.cpp", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/nsNSSComponent.h", "security/nss.symbols"], "git_node": null, "git_parents": [null], "node": "a28c58add438f6b94c69886c5264fce55dddceb0", "parents": ["7d8b9ab25b079f968bf16c77b5a46b7c474eba6c"], "tags": []}, {"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1656957 - Pin AbortSignalImpl instance while signaling followers. r=baku, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86011", "files": ["dom/abort/AbortSignal.cpp"], "git_node": null, "git_parents": [null], "node": "4258220f507e950570f039ff6e8722ccff1f6877", "parents": ["a28c58add438f6b94c69886c5264fce55dddceb0"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1651680 - Replace PKG_SKIP_STRIP with PKG_STRIP. r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86648", "files": ["moz.configure", "python/mozbuild/mozpack/executables.py", "testing/testsuite-targets.mk", "toolkit/mozapps/installer/l10n-repack.py", "toolkit/mozapps/installer/strip.py", "toolkit/mozapps/installer/unpack.py"], "git_node": null, "git_parents": [null], "node": "0af3b12bc9a079c6ea1237e45a461b8752c59c8f", "parents": ["4258220f507e950570f039ff6e8722ccff1f6877"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1651680 - Support --enable-strip/--enable-install-strip on mingw. r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86649", "files": ["moz.configure"], "git_node": null, "git_parents": [null], "node": "3ce564d77e5f4acd0f53241c0652af470ed2ffdb", "parents": ["0af3b12bc9a079c6ea1237e45a461b8752c59c8f"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1652764: Only allow nsPrinterList objects to be created in the main process on macOS. r=jwatt, a=RyanVM", "files": ["widget/cocoa/nsWidgetFactory.mm"], "git_node": null, "git_parents": [null], "node": "4926d2fb2493288033f49d141704ec14bf1dc074", "parents": ["3ce564d77e5f4acd0f53241c0652af470ed2ffdb"], "tags": []}], "date": 1597354081, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "59": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1631018 - Enable blocklist v3 by default on desktop. r=Gijs, a=RyanVM\n\nThe blocklist v2 implementation will be removed in bug 1649906.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81929", "files": ["browser/app/profile/firefox.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_addonBlockURL.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_appversion.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_metadata_filters.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_osabi.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_prefs.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_regexp_split.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_severities.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklistchange.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_softblocked.js"], "git_node": null, "git_parents": [null], "node": "f4e931882d2621aec82538a85a8b7863ebbf7b44", "parents": ["4926d2fb2493288033f49d141704ec14bf1dc074"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1631018 - Run test_blocklistchange.js with v2 and v3 blocklist. r=Gijs, a=RyanVM\n\nTo preserve the test coverage for addon updates and appversion-specific\nblocks, test_blocklistchange.js now runs with blocklist v2 and v3.\n\nThis provides NEW test coverage for features that already worked but\nlacked automated test coverage. Bug 1649896 is a follow-up and concerned\nwith creating a new test file to achieve the same coverage in a cleaner\nway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81930", "files": ["toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklistchange.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklistchange_v2.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "198b5174ca3120e82fe6cfb546906006990a69f9", "parents": ["f4e931882d2621aec82538a85a8b7863ebbf7b44"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1606568 - Add JS::ConstLatin1Chars. r=jwalden, a=RyanVM\n\nUseful for the public BigInt API which takes Range\u003cconst CharT\u003e. Allows\n\nJS::NumberToBigInt(JSContext*, JS::ConstLatin1Chars)\n\nin order to match\n\nJS::NumberToBigInt(JSContext*, JS::ConstTwoByteChars)\n\nwhich already exists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82797", "files": ["js/public/CharacterEncoding.h"], "git_node": null, "git_parents": [null], "node": "4c5276b58f500ba476def10ae3a687b7f97bcc06", "parents": ["198b5174ca3120e82fe6cfb546906006990a69f9"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1606568 - Prevent excessive instantiation of BigInt parsing template. r=jwalden, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82479", "files": ["js/src/vm/BigIntType.cpp"], "git_node": null, "git_parents": [null], "node": "db4ac813e98b5793d25a9624cfb5cc3dd72f16f9", "parents": ["4c5276b58f500ba476def10ae3a687b7f97bcc06"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1606568 - Add public BigInt API. r=jwalden, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82480", "files": ["js/public/BigInt.h", "js/src/jsapi-tests/moz.build", "js/src/jsapi-tests/testBigInt.cpp", "js/src/moz.build", "js/src/vm/BigIntType.cpp"], "git_node": null, "git_parents": [null], "node": "a5bcbd34ea664a9c879ae5d5c3367837d1833af8", "parents": ["db4ac813e98b5793d