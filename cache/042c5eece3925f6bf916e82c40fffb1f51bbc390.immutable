e": "96ac92343c627d1b9a9361385550b7d4ded9d341", "git_parents": ["78a1c5be04ecfa8fecad51192c66d9f035488017"], "node": "4ea86b5367ad01b86d9dc4864163b2d8668505cf", "parents": ["ea8ed0021ab3cf9935ff60b15b0a2a127ea5e260"], "tags": []}], "date": 1789648552, "git_changesets": ["96ac92343c627d1b9a9361385550b7d4ded9d341"], "user": "pchevrel@mozilla.com"}, "597": {"changesets": [{"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2057988 - Reject a duplicate conduit id.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325089\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326716\n", "files": ["toolkit/components/extensions/ConduitsParent.sys.mjs", "toolkit/components/extensions/test/mochitest/test_ext_subframes_privileges.html"], "git_node": "b9fe61adcb1c69d7e73df07f2d85cd19fe464916", "git_parents": ["96ac92343c627d1b9a9361385550b7d4ded9d341"], "node": "81b28bb619967857671f890d90a64a9684249924", "parents": ["4ea86b5367ad01b86d9dc4864163b2d8668505cf"], "tags": []}], "date": 1789648574, "git_changesets": ["b9fe61adcb1c69d7e73df07f2d85cd19fe464916"], "user": "pchevrel@mozilla.com"}, "598": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2049352 - Clear mCallback before invoking Done() in the file, color, and application pickers.  a=pascalc DONTBUILD\n\nSeveral picker and chooser handlers invoke mCallback and null the member\nafterwards. Move the callback into a local before invoking it, and return\nearly when it is already null, so each handler runs at most once.\n\nHandlers updated:\n  * widget/nsFilePickerProxy.cpp (Recv__delete__, ActorDestroy)\n  * widget/gtk/nsFilePicker.cpp (DoneNonPortal, DonePortal, DoneCommon)\n  * widget/gtk/nsColorPicker.cpp (Done)\n  * widget/gtk/nsApplicationChooser.cpp (Done)\n  * widget/cocoa/nsColorPicker.mm (Done)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309753\n\n(cherry picked from commit 9218e63542cccf76054284d84f95c07f1b0b4332)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326718\n", "files": ["widget/cocoa/nsColorPicker.mm", "widget/gtk/nsApplicationChooser.cpp", "widget/gtk/nsColorPicker.cpp", "widget/gtk/nsFilePicker.cpp", "widget/gtk/nsFilePicker.h", "widget/nsFilePickerProxy.cpp"], "git_node": "bf0d297415a0250d3cbc30b15aedef9a9b6176df", "git_parents": ["b9fe61adcb1c69d7e73df07f2d85cd19fe464916"], "node": "1e3881924741cc306c9260e7d8084d55912f1475", "parents": ["81b28bb619967857671f890d90a64a9684249924"], "tags": []}], "date": 1789648806, "git_changesets": ["bf0d297415a0250d3cbc30b15aedef9a9b6176df"], "user": "pchevrel@mozilla.com"}, "599": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2047721 - Clear VP9 frame-thread state on flush  a=pascalc\n\nCherry-pick of FFmpeg commit a024f8c5413d (avcodec/vp9: unref next_refs in\nvp9_decode_flush). vp9_decode_flush() releases s-\u003es.refs[] but not\ns-\u003enext_refs[], and vp9_decode_update_thread_context() seeds a worker's\nrefs[] from the source worker's next_refs[], so references from before a\nflush could survive it. Unref next_refs[] alongside refs[].\n\nThe commit is not in the FFmpeg 9.0 release branch, so it is carried as\nvp9-flush-unref-next-refs.patch and listed in README_MOZILLA to be\nre-applied on the next ffvpx update.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310961\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326601\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/vp9.c", "media/ffvpx/vp9-flush-unref-next-refs.patch"], "git_node": "c87adfaaee12855429b91e73f5ff43e44318ebbb", "git_parents": ["bf0d297415a0250d3cbc30b15aedef9a9b6176df"], "node": "adf9125d48115e647168e3360a6ad90ecd4531f5", "parents": ["1e3881924741cc306c9260e7d8084d55912f1475"], "tags": []}], "date": 1789648840, "git_changesets": ["c87adfaaee12855429b91e73f5ff43e44318ebbb"], "user": "pchevrel@mozilla.com"}, "600": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2041248 - Prevent NTLM login attempt with empty credentials  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326121\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326400\n", "files": ["netwerk/protocol/http/nsHttpNTLMAuth.cpp", "netwerk/protocol/http/nsHttpNTLMAuth.h"], "git_node": "59cf97c4498672daf31bc34477557d7a9fbbc0a2", "git_parents": ["c87adfaaee12855429b91e73f5ff43e44318ebbb"], "node": "421c28b90f66ba468d1d4e262032b0c727a8821b", "parents": ["adf9125d48115e647168e3360a6ad90ecd4531f5"], "tags": []}], "date": 1789648869, "git_changesets": ["59cf97c4498672daf31bc34477557d7a9fbbc0a2"], "user": "pchevrel@mozilla.com"}, "601": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071068 - Use SegmentedVector on the popup painting code.  a=pascalc DONTBUILD\n\nTo prevent WeakFrame from being memmove()d. This is an upliftable\nlow-risk fix.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325322\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326434\n", "files": ["layout/xul/nsXULPopupManager.cpp"], "git_node": "4b0f41b036e87617e5934ece2150175334d294b4", "git_parents": ["59cf97c4498672daf31bc34477557d7a9fbbc0a2"], "node": "979bf79ee7b19492df01410652a910e6504ca7a3", "parents": ["421c28b90f66ba468d1d4e262032b0c727a8821b"], "tags": []}], "date": 1789648969, "git_changesets": ["4b0f41b036e87617e5934ece2150175334d294b4"], "user": "pchevrel@mozilla.com"}, "602": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2061103 - Update encoding_rs to main before 0.8.40.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316770\n\nDifferential Revision: https://phabricato