hor": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging af3b068ff4548a6d6818a7aca8d03f432e50b296 with FIREFOX_115_41_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9d5af75f2c3d60e7c992fc38edf45fa3d161fb99", "git_parents": ["745869f099accbe19a22291d7d4169309a023efe"], "node": "ed6e9e71ef866d27f035b16c787adec0499d6f0b", "parents": ["8d52105e7f8f906a04f44f6450c6baa3477b3dc3"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3b49a44994fb7ff6902f7df5a3bd5f689a4fb4e9 with FIREFOX_153_3_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4cea99f2ad9c131bf5c82fb3d4b5240c52afaddf", "git_parents": ["9d5af75f2c3d60e7c992fc38edf45fa3d161fb99"], "node": "74782f39ae1efcc13207a070b47892ec3bce2145", "parents": ["ed6e9e71ef866d27f035b16c787adec0499d6f0b"], "tags": []}], "date": 1789475932, "git_changesets": ["ee1f48209df890f93a2b8dffe2366f8e39aa9995", "f098aef4c97c1668ff4a0b905d476080ae4155c5", "a6a1643cd538c0aaf72605fca18e345eafd92b2a", "4441006d589a74d35e9a38b52223afe66dab91ea", "0f96f6a2f64c336825159f2ec3a4881348e28839", "0ac6a0da8c97166200ae77fdfb65593982254534", "52916b177aa76c2d1f914dbfc294b73918266442", "ff5a4f1271f2e3f7d3a93017b794ce7058d4c616", "e7505550b47b3bd0231ff64788ced2128bb6a381", "5cb16d15673d81da36cccd34f87be3f7e78ee995", "a87d091bf1e979f153d93090edd54e44d023b1e9", "aa3cc94dfde1e9f9e5e5f8cc155c6ec8e6ba0181", "c330ce02ff79317e77f6d89cd1b5e44d44174833", "b1a827dfc945620fb0328e07255513220402f3c5", "9696515a0405c9677725aa8cfd274b7ee14be6be", "384794c2ee0b430359ca3b95def8fe4310ced294", "5969f37bfe792d19dd89dddcb5ef680732a0faf5", "d1f7dfb1a7daa2e9c7f8f414268b2d1ec47dfc65", "f450936891a23066b26194581aaeba720d01de2d", "88d9b8c5ffbb8026d42318bbd0e1c98c5c63e14b", "b5b05ee64a3d5c23300a86c52559e7db66b552b7", "90783c7f985235f6037206718b719c3ea99aa3e2", "bdfdbb689de520be4229b00e12a7b06639d80404", "cb67ba687679f8d5f79b57dd60d7c91d108ec88e", "d0bc0447545eb07fdc3bd5ab032e0d2889560db7", "61d6ef392715b35bf77f2de24819770d2043e069", "745869f099accbe19a22291d7d4169309a023efe", "9d5af75f2c3d60e7c992fc38edf45fa3d161fb99", "4cea99f2ad9c131bf5c82fb3d4b5240c52afaddf"], "user": "ffxbld@lando.moz.tools"}, "552": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061009 - Set default browser triggers two prompts on macOS 27  a=pascalc\n\nUse -[NSWorkspace setDefaultApplicationAtURL:toOpenURLsWithScheme:] instead of\nLSSetDefaultHandlerForURLScheme() and LSSetDefaultRoleHandlerForContentType() to\nset the default browser on macOS 27+.\n\nOn macOS 27 Beta, with LSSetDefaultHandlerForURLScheme() and\nLSSetDefaultRoleHandlerForContentType(), each call generates a confirmation\nprompt resulting in multiple prompts when the \"Make default\" button is pressed.\n\nThe NSWorkspace API is available on macOS 12+, but limit it to macOS 27+ for now\nto be conservative.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317309\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326337\n", "files": ["CLOBBER", "browser/components/shell/moz.build", "browser/components/shell/nsMacShellService.cpp", "browser/components/shell/nsMacShellService.mm"], "git_node": "dc09f64c90e47325f4126869aa166235dc764c81", "git_parents": ["13bd681be248ae55035888d56f017bd6cdd0f511"], "node": "27ab6001e43084e226f1bdfe2a212a961d6f0f4c", "parents": ["dd8610f821578f09b115265426496d100d835880"], "tags": []}], "date": 1789545445, "git_changesets": ["dc09f64c90e47325f4126869aa166235dc764c81"], "user": "pchevrel@mozilla.com"}, "553": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071064 - Call ClearForm when unlinking form controls.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325435\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325512\n", "files": ["dom/html/HTMLImageElement.cpp", "dom/html/nsGenericHTMLElement.cpp"], "git_node": "0916240b375500862e9ec94dfb9b15cf3740df33", "git_parents": ["dc09f64c90e47325f4126869aa166235dc764c81"], "node": "2abbd8a38248f6e572d5b7e7de7196fbdef1a119", "parents": ["27ab6001e43084e226f1bdfe2a212a961d6f0f4c"], "tags": []}], "date": 1789547095, "git_changesets": ["0916240b375500862e9ec94dfb9b15cf3740df33"], "user": "pchevrel@mozilla.com"}, "554": {"changesets": [{"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2066575: Use CachedTableAccessible for XUL elements with table roles  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321409\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325489\n", "files": ["accessible/base/AccTypes.h", "accessible/base/CachedTableAccessible.cpp", "accessible/base/nsAccessibilityService.cpp", "accessible/basetypes/Accessible.h", "accessible/generic/LocalAccessible.cpp", "accessible/tests/browser/tree/browser.toml", "accessible/tests/browser/tree/browser_xul_aria_grid.js", "accessible/tests/browser/tree/doc_xul_grid.xhtml", "accessible/xul/XULListboxAccessible.cpp"], "git_node": "268a3f2c04f43b3acbf9eaee40f9c5ea95c27d91", "git_parents": ["0916240b375500862e9ec94dfb9b15cf3740df33"], "node": "f30d892b08301fac592181d8b8bfa9db26504787", "parents": ["2abbd8a38248f6e572d5b7e7de7196fbdef1a119"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2066575: Ensure table properties are exposed for XUL tables on mac  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321410\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325490\n", "files": ["accessible/tests/browser/mac/browser.toml", "accessible/tests/browser/mac/browser_xul_role_grid.js", "accessible/tests/browser/mac/doc_xul_grid.xhtml"], "git_node": "6da2fab6d773612a921bfcd8ca203d3879341db1", "git_parents": ["268a3f2c04f43b3acbf9eaee40f9c5ea95c27d91"], "node": "f4dcb3f8f59c59f8f297505642546614ea90ab34", "parents": ["f30d892b08301fac592181d8b8bfa9db26504787"], "tags": []}], "date": 1789547238, "git_changesets": ["268a3f2c04f43b3acbf9eaee40f9c5ea95c27d91", "6da2fab6d773612a921bfcd8ca203d3879341db1"], "user": "pchevrel@mozilla.com"}, "555": {"changesets": [{"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: check for invalid payload length.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317971\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325383\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "cde7416eb237da2e878c94419a7f658d93a564d4", "git_parents": ["6da2fab6d773612a921bfcd8ca203d3879341db1"], "node": "83c4831db025d5e34d793ba0317782504e24692e", "parents": ["f4dcb3f8f59c59f8f297505642546614ea90ab34"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: make sure buffer storing decrypted data is not left uninitialized.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325384\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "62c8bff7209029328fa5066ac90ecf7e6074da3d", "git_parents": ["cde7416eb237da2e878c94419a7f658d93a564d4"], "node": "590cfcfaeb64170ed05b585830ff4ee92a63c887", "parents": ["83c4831db025d5e34d793ba0317782504e24692e"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: decrypt the previous block when seeking on EOF so mPlainBuffer contains the expected data.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322324\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325385\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "7e3c5d20a5bf444ff80b20cfa28234ade6e8eb28", "git_parents": ["62c8bff7209029328fa5066ac90ecf7e6074da3d"], "node": "483d383ffedaa12748fd9a136dce92da4728497f", "parents": ["590cfcfaeb64170ed05b585830ff4ee92a63c887"], "tags": []}], "date": 1789547332, "git_changesets": ["cde7416eb237da2e878c94419a7f658d93a564d4", "62c8bff7209029328fa5066ac90ecf7e6074da3d", "7e3c5d20a5bf444ff80b20cfa28234ade6e8eb28"], "user": "pchevrel@mozilla.com"}, "556": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061530: Replace MWasmLoadField::mightAlias.  a=pascalc\n\nThe whole way of checking if two different MaybeRefTypes might have\nvalues in common was a) overly focused on structs for some reason, and\nb) a buggy copy of RefType::castPossible. The logic is equivalent: do\ntwo types have any possible values in common? For casts this tells us if\nthe cast will always fail, and for GC object stores/loads it tells us if\ntwo operations are guaranteed to work on different values.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317715\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325124\n", "files": ["js/src/jit-test/tests/wasm/gc/bug2061530.js", "js/src/jit/MIR-wasm.cpp", "js/src/jit/MIR.cpp", "js/src/wasm/WasmTypeDef.h", "js/src/wasm/WasmValType.h"], "git_node": "de9a0851b691592254e9217c4af174f7784b4bb9", "git_parents": ["7e3c5d20a5bf444ff80b20cfa28234ade6e8eb28"], "node": "36c7dfd489e192948b9b3f0b08288eb633805513", "parents": ["483d383ffedaa12748fd9a136dce92da4728497f"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061530: Also do struct alias analysis on OOL loads.  a=pascalc\n\nWhen looking at this with fresh eyes, I realized that it actually would\nrefuse to do this analysis for out-of-line struct fields, because it\nonly checked if the base had a ref type, and the data pointer never\nwill. But the data pointer has its own MIRType, and the load is always\nan MWasmLoadField, so we can just follow it back one more step to the\nbase struct.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317716\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325125\n", "files": ["js/src/jit-test/tests/wasm/gc/bug2061530.js", "js/src/jit/MIR.cpp"], "git_node": "bbba81531cc2568a03db0abdb38302372cd91b1e", "git_parents": ["de9a0851b691592254e9217c4af174f7784b4bb9"], "node": "08ce220f618f06aa956da40f9c8f37f2eb6fbecd", "parents": ["36c7dfd489e192948b9b3f0b08288eb633805513"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068315: Make MWasmLoadField::mightAlias phi-friendly.  a=pascalc\n\nLoop unrolling, it seems, can cause phis to pick up\nMIRType::WasmStructData, which annoyingly prevents us from cleverly\ngoing backwards to the base struct object for alias analysis.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323261\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325126\n", "files": ["js/src/jit-test/tests/wasm/gc/bug2068315.js", "js/src/jit/MIR.cpp"], "git_node": "50a18b1807e17663cc989ae9181e464c3eaeea97", "git_parents": ["bbba81531cc2568a03db0abdb38302372cd91b1e"], "node": "349d3c307ec09a614f9c0587c90716be5864f52d", "parents": ["08ce220f618f06aa956da40f9c8f37f2eb6fbecd"], "tags": []}], "date": 1789547553, "git_changesets": ["de9a0851b691592254e9217c4af174f7784b4bb9", "bbba81531cc2568a03db0abdb38302372cd91b1e", "50a18b1807e17663cc989ae9181e464c3eaeea97"], "user": "pchevrel@mozilla.com"}, "557": {"changesets": [{"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060408 - Update wgpu to upstream 259cbd02 (2026-09-08)  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325116\n", "files": [".cargo/config.toml.in", "Cargo.lock", "gfx/wgpu_bindings/Cargo.toml", "gfx/wgpu_bindings/moz.yaml", "supply-chain/audits.toml", "supply-chain/imports.lock", "third_party/rust/cfg_aliases/.cargo-checksum.json", "third_party/rust/cfg_aliases/.cargo_vcs_info.json", "third_party/rust/cfg_aliases/Cargo.lock", "third_party/rust/cfg_aliases/Cargo.toml", "third_party/rust/cfg_aliases/Cargo.toml.orig", "third_party/rust/cfg_aliases/README.md", "third_party/rust/cfg_aliases/src/lib.rs", "third_party/rust/naga/.cargo-checksum.json", "third_party/rust/naga/Cargo.toml", "third_party/rust/wgpu-core/.cargo-checksum.json", "third_party/rust/wgpu-core/Cargo.toml", "third_party/rust/wgpu-core/src/command/clear.rs", "third_party/rust/wgpu-core/src/command/compute.rs", "third_party/rust/wgpu-core/src/command/memory_init.rs", "third_party/rust/wgpu-core/src/command/mod.rs", "third_party/rust/wgpu-core/src/command/pass.rs", "third_party/rust/wgpu-core/src/command/render.rs", "third_party/rust/wgpu-core/src/command/transfer.rs", "third_party/rust/wgpu-core/src/device/queue.rs", "third_party/rust/wgpu-core/src/device/resource.rs", "third_party/rust/wgpu-core/src/global.rs", "third_party/rust/wgpu-core/src/hub.rs", "third_party/rust/wgpu-core/src/init_tracker/texture.rs", "third_party/rust/wgpu-core/src/resource.rs", "third_party/rust/wgpu-hal/.cargo-checksum.json", "third_party/rust/wgpu-hal/Cargo.toml"], "git_node": "adc1fce540995b80b6fe67098fd70423a48ba69e", "git_parents": ["50a18b1807e17663cc989ae9181e464c3eaeea97"], "node": "2bdde8f11a06d820602f87e1ac7b9c966d039d74", "parents": ["349d3c307ec09a614f9c0587c90716be5864f52d"], "tags": []}], "date": 1789548520, "git_changesets": ["adc1fce540995b80b6fe67098fd70423a48ba69e"], "user": "pchevrel@mozilla.com"}, "558": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055694 - Generate a random nonce per message in NSSCipherStrategy  a=pascalc DONTBUILD\n\nNSSCipherStrategy::Cipher asked PK11_AEADOp to produce the ChaCha20-Poly1305\nnonce with CKG_GENERATE_COUNTER and fixedbits=0. NSS implements that by\noverwriting the whole 96-bit nonce with a counter private to the PK11Context\nand starting at zero, so the random block prefix callers passed in was\ndiscarded.\n\nObfuscatingVFS creates an encrypt context per SQLite file handle and per\nreopen, all keyed with the same per-database key, so those independent counters\nrepeat (key, nonce) pairs. ChaCha20 is a stream cipher, so a repeated pair\nmeans a repeated keystream, and it also repeats the Poly1305 one-time key.\n\nDraw the nonce with PK11_GenerateRandom on every Cipher call instead and pass\nCKG_NO_GENERATE. Decrypt reads the nonce stored alongside the ciphertext and\nnever derived it, so this changes no on-disk format and existing databases stay\nreadable.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319641\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325094\n", "files": ["dom/quota/DummyCipherStrategy.h", "dom/quota/EncryptingOutputStream_impl.h", "dom/quota/NSSCipherStrategy.cpp", "dom/quota/NSSCipherStrategy.h", "dom/quota/test/gtest/TestNSSCipherStrategy.cpp", "dom/quota/test/gtest/moz.build", "storage/ObfuscatingVFS.cpp"], "git_node": "fc46d6cd8ac0f6374a33078fc1113521f180c195", "git_parents": ["adc1fce540995b80b6fe67098fd70423a48ba69e"], "node": "df4b50f525051bc5c9bc9e1272ef6c5c721f367b", "parents": ["2bdde8f11a06d820602f87e1ac7b9c966d039d74"], "tags": []}], "date": 1789548581, "git_changesets": ["fc46d6cd8ac0f6374a33078fc1113521f180c195"], "user": "pchevrel@mozilla.com"}, "559": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2068336 - Make !isEmpty release asserts  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324646\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325050\n", "files": ["dom/streams/QueueWithSizes.h", "dom/streams/ReadableByteStreamController.cpp", "dom/streams/ReadableStream.cpp", "dom/streams/WritableStream.cpp"], "git_node": "5af0fa48831866529360a319fa9856c59d9c36c3", "git_parents": ["fc46d6cd8ac0f6374a33078fc1113521f180c195"], "node": "b5c9d215473e99f059ef65d229f42a4ff65c9890", "parents": ["df4b50f525051bc5c9bc9e1272ef6c5c721f367b"], "tags": []}], "date": 1789548628, "git_changesets": ["5af0fa48831866529360a319fa9856c59d9c36c3"], "user": "pchevrel@mozilla.com"}, "560": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070171 - Clear last fallback properly when don't fit after fitting.  a=pascalc DONTBUILD\n\nIf a fallback used to fit, but after fallback none of the positions fit,\nwe end up in the base position, but we didn't clear the last index\nproperly, so the fallback reflow kept triggering.\n\nMove the clear to after the loop, and add a test that repros with or\nwithout overlay scrollbars. Add also the test as a crashtest.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/362\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324999\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp", "testing/web-platform/tests/css/css-anchor-position/fallback-no-fit-after-fit-crash.html", "testing/web-platform/tests/css/css-anchor-position/position-try-fallbacks-no-fit-after-fit.html"], "git_node": "9f2ce42719a9202b0db56581362481d4a9a52979", "git_parents": ["5af0fa48831866529360a319fa9856c59d9c36c3"], "node": "66d475fc1d7d7cff2040d4744f7c289a7d79e893", "parents": ["b5c9d215473e99f059ef65d229f42a4ff65c9890"], "tags": []}], "date": 1789548701, "git_changesets": ["9f2ce42719a9202b0db56581362481d4a9a52979"], "user": "pchevrel@mozilla.com"}, "561": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068374 - Restore the realm when unwinding a trapping wasm tail call.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323721\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324987\n", "files": ["js/src/vm/JitActivation.cpp"], "git_node": "8095f8007f4a08c4e58b9f9c683a539c8214d255", "git_parents": ["9f2ce42719a9202b0db56581362481d4a9a52979"], "node": "56c84150bedb96e40f43b00dbca7f2df54cfbce4", "parents": ["66d475fc1d7d7cff2040d4744f7c289a7d79e893"], "tags": []}], "date": 1789548748, "git_changesets": ["8095f8007f4a08c4e58b9f9c683a539c8214d255"], "user": "pchevrel@mozilla.com"}, "562": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2068404.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324609\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324902\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h"], "git_node": "78b068d1bed1e41f47e54da87fee168c521ecd92", "git_parents": ["8095f8007f4a08c4e58b9f9c683a539c8214d255"], "node": "955536ee40c23ee3a06b01778269e16254eea6f4", "parents": ["56c84150bedb96e40f43b00dbca7f2df54cfbce4"], "tags": []}], "date": 1789548834, "git_changesets": ["78b068d1bed1e41f47e54da87fee168c521ecd92"], "user": "pchevrel@mozilla.com"}, "563": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063488 - Only allow the parent process to set the service worker BrowsingContext flags.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324908\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h"], "git_node": "b1040d41b31f8ce62ce2268ff856714aab110a2f", "git_parents": ["78b068d1bed1e41f47e54da87fee168c521ecd92"], "node": "8ba5bc8818dd2f2dcacb13a5721d47c27af07f0c", "parents": ["955536ee40c23ee3a06b01778269e16254eea6f4"], "tags": []}], "date": 1789548864, "git_changesets": ["b1040d41b31f8ce62ce2268ff856714aab110a2f"], "user": "pchevrel@mozilla.com"}, "564": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069276: Don't expose IA2 text interfaces for XUL boxes.  a=pascalc DONTBUILD\n\nIn general, it's expected that any container which can have TextLeafAccessible children should be a HyperTextAccessible.\nBug 1979253 enforced this even for XUL boxes.\nUnfortunately, we use XUL boxes for address bar action buttons.\nThese don't actually contain any text.\nHowever, because we expose IA2 text interfaces, NVDA mouse tracking looks for text and doesn't find any, causing it to report nothing.\nRather than making a special case exception for the HyperTextAccessible -\u003e TextLeafAccessible invariant (which might cause problems on other platforms, particularly Mac), just avoid exposing the IA2 text interfaces for these elements.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324168\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324769\n", "files": ["accessible/tests/browser/windows/ia2/browser_text.js", "accessible/windows/msaa/MsaaAccessible.cpp"], "git_node": "70ae23b891f0593f782194ef4ec3f46633292e1f", "git_parents": ["b1040d41b31f8ce62ce2268ff856714aab110a2f"], "node": "6ee29907ce5e11f91a648a6b84e8554f012c86cc", "parents": ["8ba5bc8818dd2f2dcacb13a5721d47c27af07f0c"], "tags": []}], "date": 1789549019, "git_changesets": ["70ae23b891f0593f782194ef4ec3f46633292e1f"], "user": "pchevrel@mozilla.com"}, "565": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068385: Don't support sparse arrays in SpreadMathMinMax  a=pascalc\n\nMarking the testcase --slow because it takes 7+ minutes on my laptop in an opt-debug build.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323120\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324692\n", "files": ["js/src/jit/BaselineIC.cpp", "js/src/jit/CacheIR.cpp"], "git_node": "ae8ddb732dfd0c6442ee9c43bc10ab8b7e876085", "git_parents": ["70ae23b891f0593f782194ef4ec3f46633292e1f"], "node": "c19f792d6f7fc7b513f0078f76a357183cde8782", "parents": ["6ee29907ce5e11f91a648a6b84e8554f012c86cc"], "tags": []}], "date": 1789549099, "git_changesets": ["ae8ddb732dfd0c6442ee9c43bc10ab8b7e876085"], "user": "pchevrel@mozilla.com"}, "566": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "[ESR 153] Bug 2065294 - Update YUVBufferGenerator.  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324691\n", "files": ["dom/media/gtest/TestYUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.h"], "git_node": "2d12927fe8c14e15dcceccd4b90e4fc45a54cb5b", "git_parents": ["ae8ddb732dfd0c6442ee9c43bc10ab8b7e876085"], "node": "a6a1ec000e43a38a8387254dc6fa072928cf1b32", "parents": ["c19f792d6f7fc7b513f0078f76a357183cde8782"], "tags": []}], "date": 1789549201, "git_changesets": ["2d12927fe8c14e15dcceccd4b90e4fc45a54cb5b"], "user": "pchevrel@mozilla.com"}, "567": {"changesets": [{"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2067277 - Always report APZ autoscroll rejection by message.  a=pascalc DONTBUILD\n\nStartAutoscroll returned whether APZ accepted the autoscroll, but that\nanswer only reached the caller when the compositor ran in the parent\nprocess. With a GPU process the request goes over an async message, so the\nreturn value only said the message was sent and the rejection came back\nvia message instead. This patch makes it report the rejection that way in\nboth cases.\n\nNotable details:\n\n- AutoScrollChild now registers its \"autoscroll-rejected-by-apz\" observer\n  before sending \"Autoscroll:Start\" rather than after the reply. Without a\n  GPU process, ChromeProcessController::NotifyAsyncAutoscrollRejected is\n  already on the UI thread and notifies synchronously, so the rejection\n  would otherwise always be delivered before the observer exists and be\n  dropped.\n\n- CanonicalBrowsingContext::StartApzAutoscroll keeps returning bool for its\n  own early-outs (no BrowserParent, no widget, APZ disabled) to prevent\n  a regression of main-thread scrolling. nsIWidget::StartAsyncAutoscroll no\n  longer has anything to report.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322015\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324686\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "gfx/layers/apz/public/IAPZCTreeManager.h", "gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZCTreeManager.h", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerChild.h", "toolkit/actors/AutoScrollChild.sys.mjs", "widget/nsIWidget.cpp", "widget/nsIWidget.h"], "git_node": "282248985fb816bc22d4146acff29077eaac87a8", "git_parents": ["2d12927fe8c14e15dcceccd4b90e4fc45a54cb5b"], "node": "bef2bb15dd84ad4025c5771627424007414bc219", "parents": ["a6a1ec000e43a38a8387254dc6fa072928cf1b32"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2064211 - Move messages sent only from the parent process from PAPZCTreeManager to PAPZInputBridge.  a=pascalc DONTBUILD\n\nSetKeyboardMap, SetDPI, SetBrowserGestureResponse, StartAutoscroll,\nStopAutoscroll and SetLongTapEnabled are only ever sent from the UI\nprocess to the GPU process, so move them to PAPZInputBridge, a protocol\nwhich doesn't have an endpoint in the content process at all.\n\nNotable details:\n\n- PAPZInputBridge's child endpoint is bound to the APZ controller thread\n  rather than the main thread, so APZInputBridgeChild hops to it before\n  sending. Note that on Android, these calls can initially arrive on the\n  Java UI thread.\n\n- Originally, four of those methods are executed via APZUpdater queue by\n  RunOnUpdaterThread in APZCTreeManagerParent. But this patch doesn't use\n  the queue anymore, because the message doesn't need to be ordered with\n  respect to WR frame generation first of all.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319238\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324687\n", "files": ["gfx/layers/apz/public/APZInputBridge.h", "gfx/layers/apz/public/IAPZCTreeManager.h", "gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZCTreeManager.h", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerChild.h", "gfx/layers/ipc/APZCTreeManagerParent.cpp", "gfx/layers/ipc/APZCTreeManagerParent.h", "gfx/layers/ipc/APZInputBridgeChild.cpp", "gfx/layers/ipc/APZInputBridgeChild.h", "gfx/layers/ipc/APZInputBridgeParent.cpp", "gfx/layers/ipc/APZInputBridgeParent.h", "gfx/layers/ipc/PAPZCTreeManager.ipdl", "gfx/layers/ipc/PAPZInputBridge.ipdl", "widget/android/nsWindow.cpp", "widget/nsIWidget.cpp"], "git_node": "f8781b88b7fe9580dc2cc86b24d306ce7044abe2", "git_parents": ["282248985fb816bc22d4146acff29077eaac87a8"], "node": "cca6e697562d85f4f5642d471cdc48d780bb38fa", "parents": ["bef2bb15dd84ad4025c5771627424007414bc219"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2064211 - Move messages sent only to the parent process from PAPZCTreeManager to PAPZInputBridge.  a=pascalc DONTBUILD\n\nNotifyPinchGesture, CancelAutoscroll, NotifyScaleGestureComplete\nare only ever sent to the UI process from the GPU process, so move\nthem to PAPZInputBridge, a protocol which doesn't have an endpoint\nin the content process at all.\n\nNotable details:\n\n- In RemoteContentController.cpp, some non-trivial changes are added,\n  because APZInputBridgeParent is bound to the main thread while\n  APZCTreeManagerParent is bound to the compositor one.\n\n- In APZInputBridgeChild.cpp, APZInputBridgeChild is bound to the\n  controller thread, which on Android is the Java UI thread, so a\n  thread hop is needed before calling the implementations which need\n  to be on the main thread.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320331\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324688\n", "files": ["gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerChild.h", "gfx/layers/ipc/APZInputBridgeChild.cpp", "gfx/layers/ipc/APZInputBridgeChild.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/PAPZCTreeManager.ipdl", "gfx/layers/ipc/PAPZInputBridge.ipdl", "gfx/layers/ipc/RemoteContentController.cpp", "gfx/layers/ipc/RemoteContentController.h"], "git_node": "8c51eacadfc4ab94710ac2f6e0038d5d8f5c598c", "git_parents": ["f8781b88b7fe9580dc2cc86b24d306ce7044abe2"], "node": "1ea65e4c6ea7deb488ab86f04f9e8d09a69518c9", "parents": ["cca6e697562d85f4f5642d471cdc48d780bb38fa"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2064211 - Move messages sent only to the parent process from PAPZ to PAPZInputBridge.  a=pascalc DONTBUILD\n\nLayerTransforms, UpdateOverscrollVelocity, UpdateOverscrollOffset and\nHideDynamicToolbar are only ever sent to the UI process from the GPU\nprocess, so move them to PAPZInputBridge, a protocol which doesn't have\nan endpoint in the content process at all.\n\nAfter this patch, the remaining PAPZ methods are ones which can\ngenuinely reach a content process and accordingly have an implementation\nin ContentProcessController.\n\nNotable details:\n\n- APZInputBridgeParent is bound to the main thread and so\n  RemoteContentController hops to the main thread.\n\n- mCanSend check in RemoteContentController for these methods is\n  now not necessary, because APZInputBridge actors (parent/child) have\n  the same lifetime.\n\n- NotifyLayerTransforms has no ScrollableLayerGuid to select the target\n  window's input bridge with, so RemoteContentController now stores the\n  LayersId it was allocated for. For the actor that carries these messages\n  that is the window's root LayersId, which keeps the routing identical to\n  what sending on PAPZ did.\n\n- On the receiving side the four handlers hop to the main thread before\n  touching mCompositorSession, mirroring RecvHandleTap and\n  RecvNotifyPinchGesture. PAPZInputBridge's child endpoint is bound to the\n  APZ controller thread, which is not the main thread on Android, whereas\n  the compositor session and its content controller are only written on the\n  main thread.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320985\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324689\n", "files": ["gfx/layers/ipc/APZChild.cpp", "gfx/layers/ipc/APZChild.h", "gfx/layers/ipc/APZInputBridgeChild.cpp", "gfx/layers/ipc/APZInputBridgeChild.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/PAPZ.ipdl", "gfx/layers/ipc/PAPZInputBridge.ipdl", "gfx/layers/ipc/RemoteContentController.cpp", "gfx/layers/ipc/RemoteContentController.h"], "git_node": "bd7a35065874f3a064ba2d379456b5305da386f3", "git_parents": ["8c51eacadfc4ab94710ac2f6e0038d5d8f5c598c"], "node": "6336f80d0338cecf5957ead285e5f06d0409f026", "parents": ["1ea65e4c6ea7deb488ab86f04f9e8d09a69518c9"], "tags": []}], "date": 1789549449, "git_changesets": ["282248985fb816bc22d4146acff29077eaac87a8", "f8781b88b7fe9580dc2cc86b24d306ce7044abe2", "8c51eacadfc4ab94710ac2f6e0038d5d8f5c598c", "bd7a35065874f3a064ba2d379456b5305da386f3"], "user": "pchevrel@mozilla.com"}, "568": {"changesets": [{"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067190 - Refactor instance tracing with imports.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322747\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324659\n", "files": ["js/src/jit/JitFrames.cpp", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmFrameIter.h", "js/src/wasm/WasmStacks.cpp"], "git_node": "11c562e82d741592381876a5575e65fb67fcb4cf", "git_parents": ["bd7a35065874f3a064ba2d379456b5305da386f3"], "node": "754744dbe4e190b804a416cf4cf9ea8fb14123a8", "parents": ["6336f80d0338cecf5957ead285e5f06d0409f026"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067190 - Add test.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322748\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324660\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2067190.js"], "git_node": "4850caa3cdaa7b39781b38d5c313f582262a5299", "git_parents": ["11c562e82d741592381876a5575e65fb67fcb4cf"], "node": "0b3b072caf00a319b8eeb5f505573ef581a3712b", "parents": ["754744dbe4e190b804a416cf4cf9ea8fb14123a8"], "tags": []}], "date": 1789549576, "git_changesets": ["11c562e82d741592381876a5575e65fb67fcb4cf", "4850caa3cdaa7b39781b38d5c313f582262a5299"], "user": "pchevrel@mozilla.com"}, "569": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2069588 - Wrap object in ReadableByteStreamControllerGetBYOBRequest  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324327\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324598\n", "files": ["dom/streams/ReadableByteStreamController.cpp", "testing/web-platform/tests/streams/readable-byte-streams/crashtests/from-cross-realm.html"], "git_node": "e66de24e6a810126af50b1255ff343acef58ede7", "git_parents": ["4850caa3cdaa7b39781b38d5c313f582262a5299"], "node": "5b403ef75e4177f8ac8ba99e268d32e6b0ce2840", "parents": ["0b3b072caf00a319b8eeb5f505573ef581a3712b"], "tags": []}], "date": 1789549704, "git_changesets": ["e66de24e6a810126af50b1255ff343acef58ede7"], "user": "pchevrel@mozilla.com"}, "570": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068351 - Add GetFormIfRegistered helper  a=pascalc DONTBUILD\n\nThis adds a new helper which returns the form, guarded by the ADDED_TO_FORM flag.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323267\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324555\n", "files": ["dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h"], "git_node": "d13453208432922af2b4f5b8e49aab0f5ad8fd11", "git_parents": ["e66de24e6a810126af50b1255ff343acef58ede7"], "node": "f9ed5f65b4ee23f6c5df8d3055cf0fd501430040", "parents": ["5b403ef75e4177f8ac8ba99e268d32e6b0ce2840"], "tags": []}], "date": 1789549726, "git_changesets": ["d13453208432922af2b4f5b8e49aab0f5ad8fd11"], "user": "pchevrel@mozilla.com"}, "571": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057465 - Handle OOM correctly when removing a property from an object with an ObjectFuse.  a=pascalc DONTBUILD\n\nRemoving the property involves shape changes that can fail due to OOM, and marking the\nproperty `Untracked` is invalid in this case. Mark the property `NotConstant` instead\nand only after a successful removal change this to `Untracked`.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324325\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324543\n", "files": ["js/src/jit-test/tests/fuses/objectfuse-property-remove-oom.js", "js/src/vm/ObjectFuse.cpp", "js/src/vm/ObjectFuse.h", "js/src/vm/Shape.cpp", "js/src/vm/Watchtower.cpp", "js/src/vm/Watchtower.h"], "git_node": "ce9bd193fe14bf50256f0f95699d2ab486fb95f5", "git_parents": ["d13453208432922af2b4f5b8e49aab0f5ad8fd11"], "node": "6019093ed3ea534ab3baab8d98c64b23ed00cc68", "parents": ["f9ed5f65b4ee23f6c5df8d3055cf0fd501430040"], "tags": []}], "date": 1789549748, "git_changesets": ["ce9bd193fe14bf50256f0f95699d2ab486fb95f5"], "user": "pchevrel@mozilla.com"}, "572": {"changesets": [{"author": "Jesse Schwartzentruber \u003ctruber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053518 - Handle the *-oe-linux-* rust targets added in rustc 1.98 in rust target detection.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311145\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324527\n", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "4d3af87370c7a42052568f6ff7c7a7a2de573bd0", "git_parents": ["ce9bd193fe14bf50256f0f95699d2ab486fb95f5"], "node": "d6f86b4522aba1040504d1ab314e372dcc2ec666", "parents": ["6019093ed3ea534ab3baab8d98c64b23ed00cc68"], "tags": []}], "date": 1789549771, "git_changesets": ["4d3af87370c7a42052568f6ff7c7a7a2de573bd0"], "user": "pchevrel@mozilla.com"}, "573": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068335: Only allow capture requests from the root WebRender bridge.  a=pascalc\n\nContent processes should never request this, and if they were allowed,\na compromised content process could trigger large disk writes (to a\npredefined, safe location).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323111\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324422\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "a38adbdb0598f9bc991491a43dc649abd5e5af0a", "git_parents": ["4d3af87370c7a42052568f6ff7c7a7a2de573bd0"], "node": "8b0b7dba5f97115f7aa075347b6e820abd5de85d", "parents": ["d6f86b4522aba1040504d1ab314e372dcc2ec666"], "tags": []}], "date": 1789549945, "git_changesets": ["a38adbdb0598f9bc991491a43dc649abd5e5af0a"], "user": "pchevrel@mozilla.com"}, "574": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068385: Fix PBL  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323744\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324712\n", "files": ["js/src/jit/CacheIRWriter.h", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "efdd220408f6110a25889693088b1f36b8b84f90", "git_parents": ["a38adbdb0598f9bc991491a43dc649abd5e5af0a"], "node": "7622226515f28b8784f378f776e977b4d992faa7", "parents": ["8b0b7dba5f97115f7aa075347b6e820abd5de85d"], "tags": []}], "date": 1789552131, "git_changesets": ["efdd220408f6110a25889693088b1f36b8b84f90"], "user": "pchevrel@mozilla.com"}, "575": {"changesets": [{"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2058017 - Backport win11 UILIMIT_HANDLES fix.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316613\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323995\n", "files": ["gfx/layers/ipc/CompositorThread.cpp", "gfx/webrender_bindings/RenderThread.cpp", "modules/libpref/init/StaticPrefList.yaml", "mozglue/misc/WindowsUserHandleValidation.h", "mozglue/misc/moz.build", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp", "widget/windows/WinCompositorWindowThread.cpp"], "git_node": "619a2f6f4c816d5d2029c1ce49347a19ad08af96", "git_parents": ["efdd220408f6110a25889693088b1f36b8b84f90"], "node": "50955c7b93fe5f481a3d8684cc3865bea8d6f573", "parents": ["7622226515f28b8784f378f776e977b4d992faa7"], "tags": []}], "date": 1789552506, "git_changesets": ["619a2f6f4c816d5d2029c1ce49347a19ad08af96"], "user": "pchevrel@mozilla.com"}, "576": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2051115 - [esr153] Reject unescaped nulls from mimeheader  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321827\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323930\n", "files": ["netwerk/mime/nsMIMEHeaderParamImpl.cpp"], "git_node": "7fee53f30ec3b3bae4f3e5e88be902b2570a7c69", "git_parents": ["619a2f6f4c816d5d2029c1ce49347a19ad08af96"], "node": "b4bf36e99c49f02db09d5f583b5a3c27ef69f127", "parents": ["50955c7b93fe5f481a3d8684cc3865bea8d6f573"], "tags": []}], "date": 1789553836, "git_changesets": ["7fee53f30ec3b3bae4f3e5e88be902b2570a7c69"], "user": "pchevrel@mozilla.com"}, "577": {"changesets": [{"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2068401: Make this function a no-op on failure.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322984\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323667\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/stun/turn_client_ctx.cpp"], "git_node": "2863ad49864df16980ada9e262cb3e8dc3b28f79", "git_parents": ["7fee53f30ec3b3bae4f3e5e88be902b2570a7c69"], "node": "fd3fc89b5da8843d98b0fd7356f7b7de4c809d25", "parents": ["b4bf36e99c49f02db09d5f583b5a3c27ef69f127"], "tags": []}], "date": 1789553879, "git_changesets": ["2863ad49864df16980ada9e262cb3e8dc3b28f79"], "user": "pchevrel@mozilla.com"}, "578": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2067586 - Properly annotate proxyFilter channel with isTRRServiceChannel  a=pascalc DONTBUILD\n\nProxyConfigLookup synthesizes a throwaway nsHttpChannel for the proxy filter check\nand that didn't properly match the isTRRServiceChannel flag of the real TRR channel.\nThis patch makes sure the flag is correctly passed to the filter.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322858\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323504\n", "files": ["netwerk/dns/TRRServiceBase.cpp", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/ProxyConfigLookup.cpp", "netwerk/ipc/ProxyConfigLookup.h", "netwerk/ipc/ProxyConfigLookupChild.cpp", "netwerk/ipc/ProxyConfigLookupChild.h", "netwerk/ipc/ProxyConfigLookupParent.cpp", "netwerk/ipc/ProxyConfigLookupParent.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "netwerk/protocol/http/TRRServiceChannel.cpp", "netwerk/test/unit/test_trr_proxy_channel_filter.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "e9b1595a6f8e851f5b80151ed7123c19fcd5d7ad", "git_parents": ["2863ad49864df16980ada9e262cb3e8dc3b28f79"], "node": "5d1ed1b553947af33433ec6274b63c787a48a51a", "parents": ["fd3fc89b5da8843d98b0fd7356f7b7de4c809d25"], "tags": []}], "date": 1789553949, "git_changesets": ["e9b1595a6f8e851f5b80151ed7123c19fcd5d7ad"], "user": "pchevrel@mozilla.com"}, "579": {"changesets": [{"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037258 - Convert the service worker script to UTF-8 fallibly in CompareManager::WriteToCache.  a=pascalc DONTBUILD\n\n`NS_ConvertUTF16toUTF8` uses the infallible `AppendUTF16toUTF8` overload, which\ncalls `nsTSubstring::AllocFailed()` -\u003e `NS_ABORT_OOM()` when the allocation\nfails. Service worker scripts are routinely megabytes (~5MB in the reports), so\nthis aborts the parent process under memory pressure.\n\nUse the fallible `CopyUTF16toUTF8` instead and return NS_ERROR_OUT_OF_MEMORY.\nThe existing `MakeScopeExit([&] { Fail(rv); })` guard in `ManageNewCache()`\nalready handles a failing `WriteToCache()` (this is the same path taken when\n`Cache::Put` fails), so the registration/update fails cleanly instead of\nkilling the process.\n\nTwo related improvements at the same site:\n\n- The converted string is now moved into the string stream rather than copied,\n  which drops one full copy of the script body from the peak (was: 2N for the\n  UTF-16 buffer + N for the UTF-8 temporary + N for the stream's copy).\n- `SetBody()` is passed the length of the UTF-8 body that was actually produced\n  instead of the UTF-16 code unit count of the buffer it was converted from.\n  These differ for any script containing non-ASCII characters.\n\nVerification: this is an OOM abort, not a logic error, and the reports are\ncrash-stats aggregates with no testcase \u2014 there is no way to force the\nallocation failure deterministically from content, so there is no regression\ntest to add. The mechanism is fully determined by the stack in comment 0 and\nthe fix is the standard fallible-conversion pattern used elsewhere in the tree\n(e.g. dom/localstorage/LSValue.cpp, dom/fetch/BodyExtractor.cpp). The patch was\ncompile-verified with a local opt build (no new warnings in dom/serviceworkers)\nand is clang-format clean; I was not able to exercise it at runtime in my\nenvironment, so please let the usual service worker test suites\n(dom/serviceworkers/test) cover the non-OOM path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323346\n", "files": ["dom/serviceworkers/ServiceWorkerScriptCache.cpp"], "git_node": "654c67339ca42c99a202d4d6e77cd79487bc9563", "git_parents": ["e9b1595a6f8e851f5b80151ed7123c19fcd5d7ad"], "node": "f210ea064eca1f5e579416bf00f142bba18e217e", "parents": ["5d1ed1b553947af33433ec6274b63c787a48a51a"], "tags": []}], "date": 1789554005, "git_changesets": ["654c67339ca42c99a202d4d6e77cd79487bc9563"], "user": "pchevrel@mozilla.com"}, "580": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2065230 - Fix data corruption after filter.disconnect()  a=pascalc DONTBUILD\n\nThis fixes two bugs in the implementation and adds test coverage that\nverifies both fixes. For details, see\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=2065230#c3\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321950\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322593\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_webRequest_StreamFilter_disconnect_transitions.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common-e10s.toml", "toolkit/components/extensions/webrequest/StreamFilterParent.cpp"], "git_node": "59110f2b3dc25a70a30835faa6de6000e053fbe2", "git_parents": ["654c67339ca42c99a202d4d6e77cd79487bc9563"], "node": "a571b225701b5bd023e48010fdebf3b239984804", "parents": ["f210ea064eca1f5e579416bf00f142bba18e217e"], "tags": []}], "date": 1789554150, "git_changesets": ["59110f2b3dc25a70a30835faa6de6000e053fbe2"], "user": "pchevrel@mozilla.com"}, "581": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "[ESR 153] Bug 2048399 - Add gtests for converting the picture region.  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322399\n", "files": ["dom/media/gtest/TestImageConversion.cpp"], "git_node": "dcd2b520ae3bb6d63757d6a210ccb33795fa7e4b", "git_parents": ["59110f2b3dc25a70a30835faa6de6000e053fbe2"], "node": "5e265c5c4802d8b00a78278886c2d91a6161fd1e", "parents": ["a571b225701b5bd023e48010fdebf3b239984804"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "[ESR 153] Bug 2048399 - Convert the picture region, not the coded origin.  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322400\n", "files": ["dom/media/ImageConversion.cpp"], "git_node": "905b1586b4cf23b820d27c073ba1c28783b32456", "git_parents": ["dcd2b520ae3bb6d63757d6a210ccb33795fa7e4b"], "node": "b9071f57cb7f2016940b152d6374a574c2d5dc11", "parents": ["5e265c5c4802d8b00a78278886c2d91a6161fd1e"], "tags": []}], "date": 1789554262, "git_changesets": ["dcd2b520ae3bb6d63757d6a210ccb33795fa7e4b", "905b1586b4cf23b820d27c073ba1c28783b32456"], "user": "pchevrel@mozilla.com"}, "582": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2055233 - Don't stop the InitMacApplication() runloop until first idle.  a=pascalc DONTBUILD\n\nBefore the SDK update, macOS did the openURLs calls sync, before\napplicationDidFinishLaunching, so applicationDidFinishLaunching was a\nnice place to stop the app again.\n\nHowever those calls are just posted to the event loop, so this mechanism\nwas not working at all.\n\nBug 2036237 fixed the opening of these urls so that they went through\nthe remote service instead of getting dropped, but that still races with\nsession restore, which looks at whether the command line was empty for\nexample.\n\nThis is the lower risk fix, which fixes this mechanism to wait for those\nevents. In order to do that without arbitrary timeouts, we just wait for\nthe event loop to idle.\n\nThere's a (maybe better) long term fix, which is removing this startup\nurl mechanism stuff altogether, handle all the openURLs method in the\nremote service, and ensure session restore doesn't mess with them.\n\nBut that seems more annoying and risky, and this doesn't feel too\nterrible? And it seems we might need the eager initialization anyways\nfor accessibility, so...\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313704\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322348\n", "files": ["toolkit/xre/MacApplicationDelegate.h", "toolkit/xre/MacApplicationDelegate.mm", "toolkit/xre/nsAppRunner.cpp"], "git_node": "1d505bfa04745d2215acfea3b97190ff12be8369", "git_parents": ["905b1586b4cf23b820d27c073ba1c28783b32456"], "node": "ebc89036a5e073ce8171d03e1c19a5c43a57c55b", "parents": ["b9071f57cb7f2016940b152d6374a574c2d5dc11"], "tags": []}], "date": 1789554334, "git_changesets": ["1d505bfa04745d2215acfea3b97190ff12be8369"], "user": "pchevrel@mozilla.com"}, "583": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056767: Shut down DocAccessibleParents before we shut down platform accessibility.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322228\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323108\n", "files": ["accessible/base/DocManager.cpp", "accessible/ipc/DocAccessibleParent.cpp"], "git_node": "79f24cacf9957260f156c56b51c06096fde8b332", "git_parents": ["1d505bfa04745d2215acfea3b97190ff12be8369"], "node": "e41baf3aee1a41c462f7fda9a18387559142a21b", "parents": ["ebc89036a5e073ce8171d03e1c19a5c43a57c55b"], "tags": []}], "date": 1789554393, "git_changesets": ["79f24cacf9957260f156c56b51c06096fde8b332"], "user": "pchevrel@mozilla.com"}, "584": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049792 - Sanity-check content-provided result and original URI.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319828\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326181\n", "files": ["docshell/base/nsDocShellLoadState.cpp"], "git_node": "c2b3a853e7e5e2441ee90a922e004092fa947010", "git_parents": ["79f24cacf9957260f156c56b51c06096fde8b332"], "node": "d0884c27793e5f7f151c86006e6cae8f05846098", "parents": ["e41baf3aee1a41c462f7fda9a18387559142a21b"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049792 - Don't allow content to set result or original URI on SH.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319829\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326182\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "dom/ipc/ContentParent.cpp"], "git_node": "54523319af292f85afcdf26ded586c4a666800ac", "git_parents": ["c2b3a853e7e5e2441ee90a922e004092fa947010"], "node": "4f54177a4b5cdfbf74e4bbac6947d057150e4762", "parents": ["d0884c27793e5f7f151c86006e6cae8f05846098"], "tags": []}], "date": 1789560230, "git_changesets": ["c2b3a853e7e5e2441ee90a922e004092fa947010", "54523319af292f85afcdf26ded586c4a666800ac"], "user": "pchevrel@mozilla.com"}, "585": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072623 - Update l10n-changesets on ESR153. a=pascalc DONTBUILD\n", "files": ["browser/locales/l10n-changesets.json"], "git_node": "bf4f18ce61d31bb521c55eda7890dccec3b5a1a7", "git_parents": ["54523319af292f85afcdf26ded586c4a666800ac"], "node": "eefc03172c096d1a401516357ea1fe0d682493d3", "parents": ["4f54177a4b5cdfbf74e4bbac6947d057150e4762"], "tags": []}], "date": 1789566861, "git_changesets": ["bf4f18ce61d31bb521c55eda7890dccec3b5a1a7"], "user": "pchevrel@mozilla.com"}, "586": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2054213 - Make non-starters not participate in the quick primary check.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322901\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324192\n", "files": ["third_party/rust/icu_collator/src/comparison.rs", "third_party/rust/icu_collator/src/elements.rs", "third_party/rust/icu_collator/src/provider.rs", "third_party/rust/icu_collator_data/data/collation_root_v1.rs.data", "third_party/rust/icu_collator_data/data/collation_tailoring_v1.rs.data"], "git_node": "a27aab9269861498ef6182d72ca77dbcf9c2f6cf", "git_parents": ["bf4f18ce61d31bb521c55eda7890dccec3b5a1a7"], "node": "c5b183b7e0ae902c2c40d6105cc631dbc0097373", "parents": ["eefc03172c096d1a401516357ea1fe0d682493d3"], "tags": []}], "date": 1789567596, "git_changesets": ["a27aab9269861498ef6182d72ca77dbcf9c2f6cf"], "user": "pchevrel@mozilla.com"}, "587": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 1 - Rename ModulePaths to ModuleIdentifiers  a=pascalc\n\nRename-only, since ModuleIdentifiers will be used in later parts, instead of\njust paths.  No substantive changes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324702\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325952\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPPlatform.cpp", "dom/media/gmp/GMPPlatform.h", "dom/media/gmp/PGMP.ipdl", "dom/media/ipc/PRDD.ipdl", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h"], "git_node": "4c513f5ee420e716ba4ff6895311b21103a31366", "git_parents": ["a27aab9269861498ef6182d72ca77dbcf9c2f6cf"], "node": "66c2a36dd7209be91f061d1e30a0f950ac775b62", "parents": ["c5b183b7e0ae902c2c40d6105cc631dbc0097373"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 2 - Pass child process's module list by section handle  a=pascalc\n\nChild processes now report loaded DLLs to the parent by section HANDLE instead\nof by filename.  The DLL blocklist's NtMapViewOfSection hook already receives\nthe section a module is being mapped from, so it duplicates that section,\nread-only, onto the ModuleLoadInfo for the load.  The parent identifies the\nmodule from the HANDLE.\n\nBecause the section outlives the view, this also fixes reporting for two kinds\nof load: a module the blocklist rejected, which is unmapped immediately, and a\nmodule unloaded before the parent processed the batch.  Previously, either\ncould be deleted before the parent had a chance to consider them.\n\nA handle cannot be forged into a reference to a different file and a child can\nonly send one it holds.  ValidateAndResolveModuleSection sanity checks:\n\n1. The section must map, and the view must be MEM_IMAGE. A data section can\n   be made over any openable file but an image section means the kernel\n   accepted the file as a PE and the child's image-load policy applied to it.\n2. The file must not be on a remote device.\n3. The file must not carry a mandatory integrity label below medium.\n\nThese checks replicate the checks of the MITIGATION_IMAGE_LOAD_NO_REMOTE and\nMITIGATION_IMAGE_LOAD_NO_LOW_LABEL child sandbox behaviors.  A child\ncan create a non-IMAGE section over any file it can open, so what it hands us\nis not bounded by the image-load policy.  The check avoid considering such\nfiles at all.  This currently applies to all child processes: content, gpu,\nRDD, socket, utility (all kinds), and GMP.  All have these sandbox mitigations.\n\nAlso fixes a couple of ways that a version resource could misuse VerQueryValueW's\noutput in the parent: a zero length underflowing to SIZE_MAX in\nQueryStringValue and a too-short buffer dereference in GetFromImage.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324703\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325953\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPPlatform.h", "mozglue/misc/NativeNt.h", "toolkit/xre/dllservices/ModuleVersionInfo.cpp", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h"], "git_node": "0b2ec98f277e1bb6f012fd928e6e380c44fc270b", "git_parents": ["4c513f5ee420e716ba4ff6895311b21103a31366"], "node": "b1e192f3f16b2a9a61a3d4746567ef7b8035beb1", "parents": ["66c2a36dd7209be91f061d1e30a0f950ac775b62"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 3 - Test that UntrustedModulesProcessor rejects invalid modules  a=pascalc\n\nCheck that ValidateAndResolveModuleSection rejects descriptors that are\nnon-IMAGE sections or are for below-medium-integrity modules.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324704\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325954\n", "files": ["toolkit/xre/dllservices/tests/gtest/TestModuleFileValidation.cpp", "toolkit/xre/dllservices/tests/gtest/moz.build"], "git_node": "386f0c844434e2f85dc1dd1032f13fbfb5484ddc", "git_parents": ["0b2ec98f277e1bb6f012fd928e6e380c44fc270b"], "node": "611ddcd34b531392585800fef24116a1eb7b3e2c", "parents": ["b1e192f3f16b2a9a61a3d4746567ef7b8035beb1"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 4 - Add DLL-reporting failures to the third-party-modules ping  a=pascalc\n\nNow that the parent identifies a child process's modules from the section\nhandle the child sends, and silently skips any handle it cannot identify,\nwe will need telemetry for how often that skipping happens. This patch\nadds counters for that.\n\nunverifiableLoads: the number of module loads in child processes where the DLL\nblocklist hook reached the load but failed to duplicate the section handle.\n\nrejectedSections: the number of module section handles a child process sent\nto the parent that it refused as invalid module section handles.\n\nThe counters are per-process and are only ever incremented for child\nprocesses, so the browser process reports zero for both. The counters are\nreported by the process using the module, so their accuracy depends on\ntrusting the process itself. This is how the UntrustedModulesProcessor\nhas always worked, and is by design (for performance reasons).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325955\n", "files": ["toolkit/components/telemetry/metrics.yaml", "toolkit/components/telemetry/other/UntrustedModules.cpp", "toolkit/components/telemetry/other/UntrustedModulesDataSerializer.cpp", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/tests/gtest/TestModuleFileValidation.cpp", "toolkit/xre/dllservices/tests/gtest/TestUntrustedModules.cpp"], "git_node": "656aecde4d716babf53b8f57a888a6a04fbb274a", "git_parents": ["386f0c844434e2f85dc1dd1032f13fbfb5484ddc"], "node": "120dbcc28911bd1999d5fc4745ca8302df4535d7", "parents": ["611ddcd34b531392585800fef24116a1eb7b3e2c"], "tags": []}], "date": 1789567825, "git_changesets": ["4c513f5ee420e716ba4ff6895311b21103a31366", "0b2ec98f277e1bb6f012fd928e6e380c44fc270b", "386f0c844434e2f85dc1dd1032f13fbfb5484ddc", "656aecde4d716babf53b8f57a888a6a04fbb274a"], "user": "pchevrel@mozilla.com"}, "588": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061399 - Record the wasm Ion call safepoint at the builtin instance call trap offset. r=jseward a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323310\n", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": "fd9559714388e59f934195720a1fd5a06f05047b", "git_parents": ["656aecde4d716babf53b8f57a888a6a04fbb274a"], "node": "c8151d4ab7901a9d3df4a8bae0e2221cc173753f", "parents": ["120dbcc28911bd1999d5fc4745ca8302df4535d7"], "tags": []}], "date": 1789631701, "git_changesets": ["fd9559714388e59f934195720a1fd5a06f05047b"], "user": "pchevrel@mozilla.com"}, "589": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2069804 - Backport an upstream libvpx VP8 fix  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326361\n", "files": ["media/libvpx/libvpx/vp8/common/reconinter.c", "media/libvpx/moz.yaml", "media/libvpx/vp8_clamp_fullpixel_chroma_mv.patch"], "git_node": "a254f9b61dcd039dee36da7c3eddbe7429a9dfcf", "git_parents": ["fd9559714388e59f934195720a1fd5a06f05047b"], "node": "923e4a504f90855ab5b8df6f28c14a4dd776a32c", "parents": ["c8151d4ab7901a9d3df4a8bae0e2221cc173753f"], "tags": []}], "date": 1789632065, "git_changesets": ["a254f9b61dcd039dee36da7c3eddbe7429a9dfcf"], "user": "pchevrel@mozilla.com"}, "590": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068648 - Remove unneeded nsILoadInfo flag.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323977\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326860\n", "files": ["dom/fetch/FetchDriver.cpp", "ipc/glue/BackgroundUtils.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/nsILoadInfo.idl", "netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "f0e81de21b987e8c549243834159bdc37cda094a", "git_parents": ["a254f9b61dcd039dee36da7c3eddbe7429a9dfcf"], "node": "4b08a2b5f79ebb941e6ff4d6bf2223c632708042", "parents": ["923e4a504f90855ab5b8df6f28c14a4dd776a32c"], "tags": []}], "date": 1789641315, "git_changesets": ["f0e81de21b987e8c549243834159bdc37cda094a"], "user": "pchevrel@mozilla.com"}, "591": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071695 - build funsize-update-generator image on top of debian12-base.  a=pascalc DONTBUILD\n\nUse our own base image instead of pulling from docker hub, to get\nreproducible/snapshotted packages; update from debian 11 to 12.\n\nReplace /home/worker paths with /builds/worker following the base image's $HOME.\n\nUpdate funsize's requirements.txt for python 3.11.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326858\n", "files": ["taskcluste