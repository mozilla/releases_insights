"third_party/rust/target-features/rustc-version.txt", "third_party/rust/target-features/src/lib.rs", "third_party/rust/target-features/src/simd.rs", "third_party/rust/target-features/target-cpus.txt", "third_party/rust/target-features/target-features.txt", "third_party/rust/target-features/tests/target.rs"], "git_node": "1bae7c68c867690ad8498f6df5c14c36b0841941", "git_parents": ["4b0f41b036e87617e5934ece2150175334d294b4"], "node": "d7013223ee482e1196e8332bfa9b55adc01adc0e", "parents": ["979bf79ee7b19492df01410652a910e6504ca7a3"], "tags": []}], "date": 1789649166, "git_changesets": ["1bae7c68c867690ad8498f6df5c14c36b0841941"], "user": "pchevrel@mozilla.com"}, "603": {"changesets": [{"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2028871 - Init should clear variables.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322276\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326442\n", "files": ["intl/uconv/nsConverterInputStream.cpp"], "git_node": "d7497192789f62ee23ab269adcdc7652fee90dff", "git_parents": ["1bae7c68c867690ad8498f6df5c14c36b0841941"], "node": "579879f5dfb658723eb25b602a0d2959bd507cc3", "parents": ["d7013223ee482e1196e8332bfa9b55adc01adc0e"], "tags": []}], "date": 1789649203, "git_changesets": ["d7497192789f62ee23ab269adcdc7652fee90dff"], "user": "pchevrel@mozilla.com"}, "604": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068217 - Let a test shorten the terminator's watchdog deadline instead of waiting it out.  a=pascalc DONTBUILD\n\ntest_crash_terminator.js needs its watchdog deadline both long enough that the\nphase notifications in its setup cannot be overtaken and short enough that the\ntest does not spend it idling. Bug 2065080 widened the margin the terminator\nkeeps for real shutdowns from 3 to 10 seconds, the test inherited it, and that\npushed it over the harness timeout on the slower macOS machines.\n\nMake the deadline a value the watchdog re-reads on every tick and let a test\nlower it once it has reached the phase it wants to hang in. StartWatchdog sets\nit on the main thread before the watchdog thread exists, so it cannot race with\na later SetTicksBeforeCrash. The test now crashes at the next heartbeat rather\nthan waiting out a margin it never needed, and no delay between its phase\nnotifications can make the watchdog fire against the wrong phase.\n\nWhile here, check MozCrashReason too. crasher_subprocess_tail.js crashes the\nprocess unconditionally once our setup returns, so the test passed even when\nthe terminator never fired at all.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322833\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326939\n", "files": ["toolkit/components/terminator/nsITerminatorTest.idl", "toolkit/components/terminator/nsTerminator.cpp", "toolkit/crashreporter/test/unit/test_crash_terminator.js"], "git_node": "8f46128e2ff91493cf86e66b2b6b11362ae1be1b", "git_parents": ["d7497192789f62ee23ab269adcdc7652fee90dff"], "node": "64398c2de056380af356c7b52346fd73695ad308", "parents": ["579879f5dfb658723eb25b602a0d2959bd507cc3"], "tags": []}], "date": 1789656396, "git_changesets": ["8f46128e2ff91493cf86e66b2b6b11362ae1be1b"], "user": "pchevrel@mozilla.com"}, "605": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068406 - Validate the display directory for file picker;  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325830\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326853\n", "files": ["dom/ipc/FilePickerParent.cpp", "widget/gtk/nsFilePicker.cpp", "widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h"], "git_node": "c8496a588fd79cc0c88d03ef5dba826727fde9ba", "git_parents": ["8f46128e2ff91493cf86e66b2b6b11362ae1be1b"], "node": "196eca8e050fd11554c47e3af67ee5c4bceb4eb3", "parents": ["64398c2de056380af356c7b52346fd73695ad308"], "tags": []}], "date": 1789717228, "git_changesets": ["c8496a588fd79cc0c88d03ef5dba826727fde9ba"], "user": "pchevrel@mozilla.com"}, "606": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070264 - Guard mFontFace//mFontFace5 members with the font-entry lock.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326447\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326893\n", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "5fc709857fd4b294179d9f2ec621b10656179568", "git_parents": ["c8496a588fd79cc0c88d03ef5dba826727fde9ba"], "node": "d89a86660296008a4b5f531c361da92a477f6ce3", "parents": ["196eca8e050fd11554c47e3af67ee5c4bceb4eb3"], "tags": []}], "date": 1789717268, "git_changesets": ["5fc709857fd4b294179d9f2ec621b10656179568"], "user": "pchevrel@mozilla.com"}, "607": {"changesets": [{"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2071784 - Add guid check to RecvSetTargetAPZC.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326281\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326984\n", "files": ["gfx/layers/ipc/APZCTreeManagerParent.cpp"], "git_node": "8162adf26297a7008939f8867908d7383388086e", "git_parents": ["5fc709857fd4b294179d9f2ec621b10656179568"], "node": "c958d46a551f2807297f8ddfcf803b5fa605e5eb", "parents": ["d89a86660296008a4b5f531c361da92a477f6ce3"], "tags": []}], "date": 1789717388, "git_changesets": ["8162adf26297a7008939f8867908d7383388086e"], "user": "pchevrel@mozilla.com"}, "608": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067973 - Validate PWebBrowserPersistDocument actor state in the parent process.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324050\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326909\n", "files": ["dom/webbrowserpersist/WebBrowserPersistDocumentParent.cpp", "dom/webbrowserpersist/WebBrowserPersistDocumentParent.h", "dom/webbrowserpersist/WebBrowserPersistResourcesParent.cpp"], "git_node": "ea1b0aabd833213d3459ab925ac75dfa2b22ad9a", "git_parents": ["8162adf26297a7008939f8867908d7383388086e"], "node": "434d400b790b3ac08eaadba82382d40846bd0c1c", "parents": ["c958d46a551f2807297f8ddfcf803b5fa605e5eb"], "tags": []}], "date": 1789717966, "git_changesets": ["ea1b0aabd833213d3459ab925ac75dfa2b22ad9a"], "user": "pchevrel@mozilla.com"}, "609": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Use weak references in sLayerToBrowserParentTable and unregister in ~BrowserParent.  a=pascalc DONTBUILD\n\nUsing weak references in sLayerToBrowserParentTable ensures that we never end\nup with dangling pointers. Clean up the table in ~BrowserParent() in case we\nskipped ActorDestroy.\n\nGetBrowserParentFromLayersId now returns an already_AddRefed because we were\nholding onto a strong reference anyways, and it is probably better anyways to\nhold strong stack references in the callers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326780\n", "files": ["dom/events/EventStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": "6c6148b69de8093a51108f327e6d99e629ef06d2", "git_parents": ["ea1b0aabd833213d3459ab925ac75dfa2b22ad9a"], "node": "4be66587743789d875dc7af4e84c5a38e48b402e", "parents": ["434d400b790b3ac08eaadba82382d40846bd0c1c"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Reject child-initiated deletion.  a=pascalc DONTBUILD\n\nThe child should only send us the delete message after we've sent it the\nDestroy message, so if that's not the case, something has gone wrong, so\nlet's kill the child process to prevent further hijinks.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323316\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326781\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "2d866b1b0a82547a3095d3674d2c2dbba2d0fba8", "git_parents": ["6c6148b69de8093a51108f327e6d99e629ef06d2"], "node": "ac6d0ef4358e334fd589bb3feadf1a065106f73f", "parents": ["4be66587743789d875dc7af4e84c5a38e48b402e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Don't initialize rendering for an already-destroyed BrowserParent.  a=pascalc DONTBUILD\n\nIf we can't send in nsFrameLoader::TryRemoteBrowserInternal() or\nBrowserParent::InitRendering(), then we've already started the process of\ndestroying the BrowserParent, so don't set up this rendering stuff that we may\nhave already tried to clean up.\n\nNote that mIsDestroyed is not usable here: it is only set by BrowserParent::Destroy(),\nwhich is not involved when the child initiates teardown.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326782\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "0542a431cf6f9df5a901b88eee40a325a3d163e4", "git_parents": ["2d866b1b0a82547a3095d3674d2c2dbba2d0fba8"], "node": "b579e6d3ae8540ce476642220f701ecd7a0b80dd", "parents": ["ac6d0ef4358e334fd589bb3feadf1a065106f73f"], "tags": []}], "date": 1789741210, "git_changesets": ["6c6148b69de8093a51108f327e6d99e629ef06d2", "2d866b1b0a82547a3095d3674d2c2dbba2d0fba8", "0542a431cf6f9df5a901b88eee40a325a3d163e4"], "user": "pchevrel@mozilla.com"}, "610": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068456.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326370\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327019\n", "files": ["gfx/thebes/gfxOTSUtils.h"], "git_node": "0d00061e385c59cf7976d8821a02b04224c004b5", "git_parents": ["0542a431cf6f9df5a901b88eee40a325a3d163e4"], "node": "c1e90cc1de508a69739fb55994f3abe1c8e1fb79", "parents": ["b579e6d3ae8540ce476642220f701ecd7a0b80dd"], "tags": []}], "date": 1789741234, "git_changesets": ["0d00061e385c59cf7976d8821a02b04224c004b5"], "user": "pchevrel@mozilla.com"}, "611": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2069399 - Hold references to the print dialog's header/footer dropdowns.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324694\n\n(cherry picked from commit 99645b958a738e515f8dbb305dbf9ff2ada6e438)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327038\n", "files": ["widget/gtk/nsPrintDialogGTK.cpp"], "git_node": "f8758b4bf478fafc6bf63b3a6caec16484cbc4bf", "git_parents": ["0d00061e385c59cf7976d8821a02b04224c004b5"], "node": "bc5c0d1bfe0b41dd648e0cff37f5102f0cb58754", "parents": ["c1e90cc1de508a69739fb55994f3abe1c8e1fb79"], "tags": []}], "date": 1789741257, "git_changesets": ["f8758b4bf478fafc6bf63b3a6caec16484cbc4bf"], "user": "pchevrel@mozilla.com"}, "612": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Make BrowserParent::mBrowserHost a strong reference.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324465\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327070\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "347dae40390929f2217eaf64effad12da888b250", "git_parents": ["f8758b4bf478fafc6bf63b3a6caec16484cbc4bf"], "node": "b4896a9ca1fad84e67c46940519f9917ead30eb7", "parents": ["bc5c0d1bfe0b41dd648e0cff37f5102f0cb58754"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Make BrowserParent::mBrowserBridgeParent a WeakPtr.  a=pascalc DONTBUILD\n\nEvery user of the field runs on the parent process main thread, which\nWeakPtr's debug-only owning-thread assertions now enforce.\nBrowserBridgeParent::Destroy() still clears it explicitly, so the pointer\nis dropped when the actor is destroyed rather than when the\nBrowserBridgeParent is freed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324466\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327071\n", "files": ["dom/ipc/BrowserBridgeParent.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "48da8e759947f9600cfe7677c0072aa8417e4064", "git_parents": ["347dae40390929f2217eaf64effad12da888b250"], "node": "a4e5cc02a742068087f471aa2b8102ff35078662", "parents": ["b4896a9ca1fad84e67c46940519f9917ead30eb7"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Don't let a content process name an already-embedded tab as the new tab in CreateWindow.  a=pascalc DONTBUILD\n\nIn TryRemoteBrowserInternal, don't create a new BrowserHost is we're going to\nfail immediately anyways. This could result in failing to clean up properly.\n\nFor the two BrowserParent set methods, check in release builds that we are\neither clearing the field or the BrowserParent is not already in use.\n\nIn ContentParent::RecvCreateWindow, make sure that the child is handing us a\nfresh BrowserParent, or we can get into a weird state because things aren't\ncleaned up properly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324467\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327072\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentParent.cpp"], "git_node": "5840abb12e6841d501a2c2e35edfc07c6cc37652", "git_parents": ["48da8e759947f9600cfe7677c0072aa8417e4064"], "node": "e579c0bec40061143f3fa06eb4caaa0c463227b1", "parents": ["a4e5cc02a742068087f471aa2b8102ff35078662"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Wait to set BrowserParent::mBrowserBridgeParent.  a=pascalc DONTBUILD\n\nDon't set BrowserParent::mBrowserBridgeParent until we've set the strong half of\nthe cycle, BrowserBridgeParent::mBrowserParent, in case we hit any failure states.\n\nBrowserParent::mBrowserBridgeParent is now only set alongside the strong\nBrowserBridgeParent::mBrowserParent reference, and the two are cleared together,\nso Destroy() can only ever be clearing its own back pointer. Assert that, so\nthis doesn't silently regress into clobbering another bridge's pointer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324468\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327073\n", "files": ["dom/ipc/BrowserBridgeParent.cpp"], "git_node": "76d7ceee5064d2ba9f7aa76c22fed700bc2cae51", "git_parents": ["5840abb12e6841d501a2c2e35edfc07c6cc37652"], "node": "f8534f8edfab4b27fd28bf6e893fca44bfe98f1c", "parents": ["e579c0bec40061143f3fa06eb4caaa0c463227b1"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Don't embed a discarded BrowsingContext from RecvCreateWindow.  a=pascalc DONTBUILD\n\nThis is like a semi-related cleanup found while working on the other patches.\n\nThe existing BrowsingContext validation checks the shape of the new tab's\nBrowsingContext but not whether it is still live, so a discarded one would be\nadopted as the new frameloader's pending BrowsingContext by CreateBrowsingContext\nin nsFrameLoader.cpp and then embedded.\n\nUnlike the other checks here this isn't necessarily the child's fault, so fail\nthe window open the way we already do for a missing parent rather than killing\nthe child.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324469\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327074\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "74ccd140668bfede7a0d6e358c477226502e10bf", "git_parents": ["76d7ceee5064d2ba9f7aa76c22fed700bc2cae51"], "node": "b51a03ac13838d7d754d0ee9397fcc767f2fe294", "parents": ["f8534f8edfab4b27fd28bf6e893fca44bfe98f1c"], "tags": []}], "date": 1789741604, "git_changesets": ["347dae40390929f2217eaf64effad12da888b250", "48da8e759947f9600cfe7677c0072aa8417e4064", "5840abb12e6841d501a2c2e35edfc07c6cc37652", "76d7ceee5064d2ba9f7aa76c22fed700bc2cae51", "74ccd140668bfede7a0d6e358c477226502e10bf"], "user": "pchevrel@mozilla.com"}, "613": {"changesets": [{"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2069733 - Remove the selection border-radius reftests  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324432\n", "files": ["layout/reftests/selection/reftest.list", "layout/reftests/selection/selection-border-radius-notref.html", "layout/reftests/selection/selection-border-radius-web-content-ref.html", "layout/reftests/selection/selection-border-radius-web-content.html", "layout/reftests/selection/selection-border-radius.html", "layout/tools/reftest/jar.mn"], "git_node": "00f6fc6603ebd00fb3523722a4643cf34f49ecea", "git_parents": ["74ccd140668bfede7a0d6e358c477226502e10bf"], "node": "0d9807d8ef0e36dbc9e004b7bb91d025bba90c98", "parents": ["b51a03ac13838d7d754d0ee9397fcc767f2fe294"], "tags": []}], "date": 1789741628, "git_changesets": ["00f6fc6603ebd00fb3523722a4643cf34f49ecea"], "user": "pchevrel@mozilla.com"}, "614": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072432 - Use AppendChild instead of AppendChildTo in txMozillaXMLOutput.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326562\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327120\n", "files": ["dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "343766d94d691a7aec2bba6d2135f67344c2e834", "git_parents": ["00f6fc6603ebd00fb3523722a4643cf34f49ecea"], "node": "92eae4690ceb878f7d4ab84b6b6b75c6aee90e6d", "parents": ["0d9807d8ef0e36dbc9e004b7bb91d025bba90c98"], "tags": []}], "date": 1789741694, "git_changesets": ["343766d94d691a7aec2bba6d2135f67344c2e834"], "user": "pchevrel@mozilla.com"}, "615": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070478 - Fix macOS exception handling for child processes that don't register their own exception handler.  a=pascalc DONTBUILD\n\nWhen we receive an exception that is not meant for us, we claim we\nwant to ignore the exception. However, what we actually tell the\nkernel is that we handled the exception and it can resume the thread\nthat crashed. This causes a crash loop where the process gets\ncontinually resumed at the crashing point, generating a new\nexception and then getting resumed again. It never gets terminated\nby the kernel.\n\nFix that by telling the kernel we didn't handle the exception, so\nthat the exception continues to propagate and the process crashes.\n\nDiscovered while writing tests where the updater binary crashes as\na child of xpcshell. The updater binary does not register an\nexception handler. The tests were failing with a timeout.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324566\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327358\n", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/exception_handler.cc", "toolkit/crashreporter/test/gtest/TestMacExceptionHandler.cpp", "toolkit/crashreporter/test/gtest/moz.build"], "git_node": "04486c43337b10ee95e8594e662a6343f1ee6ecd", "git_parents": ["343766d94d691a7aec2bba6d2135f67344c2e834"], "node": "659b1f45e175da56d58cf14ee67086795800175f", "parents": ["92eae4690ceb878f7d4ab84b6b6b75c6aee90e6d"], "tags": []}], "date": 1789745986, "git_changesets": ["04486c43337b10ee95e8594e662a6343f1ee6ecd"], "user": "pchevrel@mozilla.com"}, "616": {"changesets": [{"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066808 - Do not open Smart Window from the UITour entrypoint on ESR  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327444\n", "files": ["browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_aiwindow.js"], "git_node": "cee1ffa88edea3fac4c29aa541742c66a9177cd0", "git_parents": ["04486c43337b10ee95e8594e662a6343f1ee6ecd"], "node": "96a800e1e2cb9f82d77dcf10ac8357587cf923b1", "parents": ["659b1f45e175da56d58cf14ee67086795800175f"], "tags": []}], "date": 1789755918, "git_changesets": ["cee1ffa88edea3fac4c29aa541742c66a9177cd0"], "user": "pchevrel@mozilla.com"}, "617": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067008: Add nsCocoaFeatures::OnGoldenGateOrLater() for macOS 27.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321777\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327490\n", "files": ["widget/cocoa/nsCocoaFeatures.h", "widget/cocoa/nsCocoaFeatures.mm"], "git_node": "092e8f58d363e9a507f5562455d6dbf61c6052b0", "git_parents": ["cee1ffa88edea3fac4c29aa541742c66a9177cd0"], "node": "3b424809c02bbda2c608c50c8fa961ff4a210162", "parents": ["96a800e1e2cb9f82d77dcf10ac8357587cf923b1"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066632 - [macOS 27] Double clicking title bar shrinks then re-expands window  a=pascalc DONTBUILD\n\nAddress a macOS 27-specific issue where double-click to zoom actions are\nprocessed twice. Avoid re-zooming a window if the action has already\nstarted when the second mouseUp event handler runs.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323414\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327491\n", "files": ["widget/cocoa/nsChildView.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "d67ef8651317ad1904cb9c85178ba94e6fcbd066", "git_parents": ["092e8f58d363e9a507f5562455d6dbf61c6052b0"], "node": "a95a976223c5186b2d0be85a61dc1ad9a76df91a", "parents": ["3b424809c02bbda2c608c50c8fa961ff4a210162"], "tags": []}], "date": 1789801444, "git_changesets": ["092e8f58d363e9a507f5562455d6dbf61c6052b0", "d67ef8651317ad1904cb9c85178ba94e6fcbd066"], "user": "pchevrel@mozilla.com"}, "618": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2071658 - Hold refptrs in nsSyncStreamListener::Read / ::ReadSegments  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326873\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327445\n", "files": ["netwerk/base/nsSyncStreamListener.cpp"], "git_node": "a1132efd5e757e66c9a99b7857e58a0ab69aa15b", "git_parents": ["d67ef8651317ad1904cb9c85178ba94e6fcbd066"], "node": "8159aefe4ca5de993ad49215a0232e9c9225797b", "parents": ["a95a976223c5186b2d0be85a61dc1ad9a76df91a"], "tags": []}], "date": 1789801787, "git_changesets": ["a1132efd5e757e66c9a99b7857e58a0ab69aa15b"], "user": "pchevrel@mozilla.com"}, "619": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071645.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326209\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327422\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser/browser_dragdropURL.js", "toolkit/components/places/BookmarkHTMLUtils.sys.mjs", "toolkit/components/places/PlacesUtils.sys.mjs"], "git_node": "41f92864b32da4ba188f465da2593340aa30e039", "git_parents": ["a1132efd5e757e66c9a99b7857e58a0ab69aa15b"], "node": "7a5923e1e8eaf5173a2c04a9131aad17f0931374", "parents": ["8159aefe4ca5de993ad49215a0232e9c9225797b"], "tags": []}], "date": 1789801836, "git_changesets": ["41f92864b32da4ba188f465da2593340aa30e039"], "user": "pchevrel@mozilla.com"}, "620": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2072433, don't leak elements with animated classes,  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326773\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327402\n", "files": ["dom/base/ContentList.cpp", "dom/base/ContentList.h", "dom/base/nsContentUtils.h"], "git_node": "f788fb947404adba0b8d6a48c63a0d3aa935ead1", "git_parents": ["41f92864b32da4ba188f465da2593340aa30e039"], "node": "67d532608a636542dcfbf52b7cce764855aada0b", "parents": ["7a5923e1e8eaf5173a2c04a9131aad17f0931374"], "tags": []}], "date": 1789801874, "git_changesets": ["f788fb947404adba0b8d6a48c63a0d3aa935ead1"], "user": "pchevrel@mozilla.com"}, "621": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067254 - Improve the source URL provenance information for clipboard copies.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325348\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327327\n", "files": ["dom/base/nsCopySupport.cpp", "dom/base/nsCopySupport.h", "dom/events/Clipboard.cpp", "dom/events/DataTransfer.cpp", "dom/events/test/clipboard/browser.toml", "dom/events/test/clipboard/browser_clipboard_source_url.js", "dom/tests/mochitest/general/test_clipboard_disallowed.html"], "git_node": "14432190c3978acabcdf6a8562fbb4119a474341", "git_parents": ["f788fb947404adba0b8d6a48c63a0d3aa935ead1"], "node": "168b09cbfa08190c22bdb9174b34b94934cded82", "parents": ["67d532608a636542dcfbf52b7cce764855aada0b"], "tags": []}], "date": 1789801965, "git_changesets": ["14432190c3978acabcdf6a8562fbb4119a474341"], "user": "pchevrel@mozilla.com"}, "622": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update remote-settings tld-suffixes ct-logs -  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327736\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin.meta.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/newtab-wallpapers-v2.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "63488b36cdd2b385f3fa18e4ea8a8361801dbc69", "git_parents": ["14432190c3978acabcdf6a8562fbb4119a474341"], "node": "ee18a5d5b703e10407b1379b34f9e8e00ac39db0", "parents": ["168b09cbfa08190c22bdb9174b34b94934cded82"], "tags": []}], "date": 1789975158, "git_changesets": ["63488b36cdd2b385f3fa18e4ea8a8361801dbc69"], "user": "pchevrel@mozilla.com"}, "623": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067465.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326584\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327355\n", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": "4141770e4bb0dd682eab76c007ed4b763045bb54", "git_parents": ["63488b36cdd2b385f3fa18e4ea8a8361801dbc69"], "node": "965c55aa33bbf74fb99e5cb59b2b5660d40ff77a", "parents": ["ee18a5d5b703e10407b1379b34f9e8e00ac39db0"], "tags": []}], "date": 1789977741, "git_changesets": ["4141770e4bb0dd682eab76c007ed4b763045bb54"], "user": "pchevrel@mozilla.com"}, "624": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2063425 - Don't block shutdown with failed Nimbus updates  a=pascalc DONTBUILD\n\nPreviously, if `RemoteSettingsExperimentLoader.#updateImpl()` threw we\nwould end up not resetting the updating state, so `._updating` would\nalways be true (blocking futher updates) and `finishedUpdating()` would\nnever resolve.\n\nWe now reset this state in a finally clause and report exception\ninformation in a new Glean event.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321990\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327460\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js"], "git_node": "c318d99e58351f38b6fdb1034f359653e1663aeb", "git_parents": ["4141770e4bb0dd682eab76c007ed4b763045bb54"], "node": "aa1c57f4e2380a7c976fede78be5d5cff88d6d9e", "parents": ["965c55aa33bbf74fb99e5cb59b2b5660d40ff77a"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2018640 - Attempt to abort Nimbus updates during shutdown before changing enrollment state  a=pascalc DONTBUILD\n\nWe now aggressively try to abort updateRecipes during shutdown at\nseveral point before we make changes to enrollment state. Additionally,\nwe race all IO-bound promises (i.e., `RemoteSettingsClient.get()` and\n`NimbusEnrollments.loadUnenrolledSlugsFromOtherProfiles`) with promises\nthat reject once shutdown begins.\n\nUnfortunately, there is a cut-off point after which we can no longer\nabort. As soona as we've made any enrollment changes, they must be\nflushed to the database to ensure that we do not corrupt profiles (e.g.,\nwith applied prefFlips or setPrefs that are not persisted to the\ndatabase).\n\nIn the case where we trigger shutdown during the initialization of\n`ExperimentAPI`, we will halt applying migrations and making enrollment\nchanges after attempting to enable the `RemoteSettingsExperimentLoader`.\n\nShutdown unit tests have been added to ensure that we correctly\nrace promises and bail out early.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312737\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327461\n", "files": ["browser/components/backup/resources/PreferencesBackupResource.sys.mjs", "toolkit/components/nimbus/ExperimentAPI.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/moz.build", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_RemoteSettingsClient_get.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_before_update.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_timer.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_timer_lock_held.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_withUpdateLock.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml"], "git_node": "673bacf6af0aedc349d8c5f7f9e6bcf03f038c00", "git_parents": ["c318d99e58351f38b6fdb1034f359653e1663aeb"], "node": "1faab8e019e350a01ef79eb7a37ea99e6ba40b27", "parents": ["aa1c57f4e2380a7c976fede78be5d5cff88d6d9e"], "tags": []}], "date": 1789977978, "git_changesets": ["c318d99e58351f38b6fdb1034f359653e1663aeb", "673bacf6af0aedc349d8c5f7f9e6bcf03f038c00"], "user": "pchevrel@mozilla.com"}, "625": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071557 - Keep color-font palette entries as hb_color_t to reduce memory footprint.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325607\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327588\n", "files": ["gfx/tests/fuzz/TestCOLRv1.cpp", "gfx/thebes/COLRFonts.cpp", "gfx/thebes/COLRFonts.h", "gfx/thebes/FontPaletteCache.h", "layout/style/GeckoBindings.cpp"], "git_node": "7d969fac57b9af3040bbd74a950e0cd801dae1b8", "git_parents": ["673bacf6af0aedc349d8c5f7f9e6bcf03f038c00"], "node": "49f8b03e46c60f456ebd14289e73f59c83165990", "parents": ["1faab8e019e350a01ef79eb7a37ea99e6ba40b27"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071921 - Use fallible allocation for color-font palettes to avoid a potential OOM crash with large fonts.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325911\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327589\n", "files": ["gfx/thebes/COLRFonts.cpp"], "git_node": "e1dc02db53a5dcbdae124f780d49877641101e1c", "git_parents": ["7d969fac57b9af3040bbd74a950e0cd801dae1b8"], "node": "54b387203e52b81ce3e51d47a021cc196282fd60", "parents": ["49f8b03e46c60f456ebd14289e73f59c83165990"], "tags": []}], "date": 1789978002, "git_changesets": ["7d969fac57b9af3040bbd74a950e0cd801dae1b8", "e1dc02db53a5dcbdae124f780d49877641101e1c"], "user": "pchevrel@mozilla.com"}, "626": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2072429  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327599\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "layout/svg/SVGObserverUtils.cpp", "layout/svg/SVGObserverUtils.h"], "git_node": "bb948c3757b54e4c473113366b0a3441cff026a4", "git_parents": ["e1dc02db53a5dcbdae124f780d49877641101e1c"], "node": "7999d28a3ce1efe60928f991581224f616b0e52f", "parents": ["54b387203e52b81ce3e51d47a021cc196282fd60"], "tags": []}], "date": 1789978184, "git_changesets": ["bb948c3757b54e4c473113366b0a3441cff026a4"], "user": "pchevrel@mozilla.com"}, "627": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2018640 - Attempt to abort Nimbus updates during shutdown before changing enrollment state a=pascalc\" for xpcshell failures a=backout\n\nThis reverts commit 673bacf6af0aedc349d8c5f7f9e6bcf03f038c00.\n", "files": ["browser/components/backup/resources/PreferencesBackupResource.sys.mjs", "toolkit/components/nimbus/ExperimentAPI.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/moz.build", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_RemoteSettingsClient_get.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_before_update.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_timer.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_timer_lock_held.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_withUpdateLock.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml"], "git_node": "4753f0746a06049b43920ca4c92f5cb096498058", "git_parents": ["bb948c3757b54e4c473113366b0a3441cff026a4"], "node": "a17a2f7d4517cdf2ed66c5e96d6c7cdaadefda5b", "parents": ["7999d28a3ce1efe60928f991581224f616b0e52f"], "tags": []}, {"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063425 - Don't block shutdown with failed Nimbus updates a=pascalc\" for xpcshell failures a=backout\n\nThis reverts commit c318d99e58351f38b6fdb1034f359653e1663aeb.\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js"], "git_node": "ae785476d0dd85f3cb79af38150d5493afa8e0c8", "git_parents": ["4753f0746a06049b43920ca4c92f5cb096498058"], "node": "c780ca5b211b3d594f477487f0edf020f1f9a4a6", "parents": ["a17a2f7d4517cdf2ed66c5e96d6c7cdaadefda5b"], "tags": []}], "date": 1789984231, "git_changesets": ["4753f0746a06049b43920ca4c92f5cb096498058", "ae785476d0dd85f3cb79af38150d5493afa8e0c8"], "user": "pchevrel@mozilla.com"}, "628": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072467.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327500\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327696\n", "files": ["dom/canvas/OffscreenCanvas.cpp"], "git_node": "1a1a0e1d6189bd4749e0bc69c45b14b72efa4046", "git_parents": ["ae785476d0dd85f3cb79af38150d5493afa8e0c8"], "node": "591c5c74d65bff67fa9b3b6550adb77e506c7ffc", "parents": ["c780ca5b211b3d594f477487f0edf020f1f9a4a6"], "tags": []}], "date": 1789991527, "git_changesets": ["1a1a0e1d6189bd4749e0bc69c45b14b72efa4046"], "user": "pchevrel@mozilla.com"}, "629": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063680 - Destroy CacheIndexRecordWrapper via its refcount  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327690\n", "files": ["netwerk/cache2/CacheIndex.cpp", "netwerk/cache2/CacheIndex.h"], "git_node": "c5e5b979dfdc672e07f97bf6585e45499ac02bac", "git_parents": ["1a1a0e1d6189bd4749e0bc69c45b14b72efa4046"], "node": "2c727fb74236dac0889be5b2beb02b7506dc27ce", "parents": ["591c5c74d65bff67fa9b3b6550adb77e506c7ffc"], "tags": []}], "date": 1789991561, "git_changesets": ["c5e5b979dfdc672e07f97bf6585e45499ac02bac"], "user": "pchevrel@mozilla.com"}, "630": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update HSTS HPKP -  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327479\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "0bf2166597d1954b132aca25876068ed1e91fc24", "git_parents": ["c5e5b979dfdc672e07f97bf6585e45499ac02bac"], "node": "77e33540f80856deff9bca3591dc3f26f088b4a2", "parents": ["2c727fb74236dac0889be5b2beb02b7506dc27ce"], "tags": []}], "date": 1790001803, "git_changesets": ["0bf2166597d1954b132aca25876068ed1e91fc24"], "user": "dsmith@mozilla.com"}, "631": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074047 - Measure AsyncShutdown's crash countdown against a clock that stops while the system is suspended.  a=pascalc DONTBUILD\n\nSince bug 2065080 the countdown compares ChromeUtils.now() against a\ndeadline. On Windows that clock keeps counting while the machine sleeps,\nand relative timers that expire during sleep fire on wake, so a shutdown\ninterrupted by a suspend crashed on the first beat after resume, naming\nwhatever blocker had not yet had a chance to run. Blockers that give up\non their own after a few seconds, like the native messaging host\ncleanup, showed up this way.\n\nExpose mozglue's AwakeTimeStamp as ChromeUtils.awakeNow() and\nuse it for the countdown, so that, like nsTerminator, it only counts time\nthe system was awake.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327786\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327935\n", "files": ["dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "toolkit/components/asyncshutdown/AsyncShutdown.sys.mjs"], "git_node": "345cd49120b5cae4cb6b624d012376d6f9f5f107", "git_parents": ["0bf2166597d1954b132aca25876068ed1e91fc24"], "node": "1c1c77e745dc6b201316952be0c88193215df652", "parents": ["77e33540f80856deff9bca3591dc3f26f088b4a2"], "tags": []}], "date": 1790058800, "git_changesets": ["345cd49120b5cae4cb6b624d012376d6f9f5f107"], "user": "pchevrel@mozilla.com"}, "632": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073819: Close the parent's pipe ends when Subprocess fails to launch the child on Unix.  a=pascalc DONTBUILD\n\nWhen IOUtils.launchProcess() throws, spawn() disposed only the child's ends of the pipes it had just created. The parent's ends of stdin, stdout, stderr and the exit sentinel stayed open until the worker garbage-collected them, four descriptors per failed launch. An extension that keeps retrying a native messaging host whose launch fails can exhaust the process's descriptors this way. The Windows worker already closes its pipes on failure.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327609\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327932\n", "files": ["toolkit/modules/subprocess/subprocess_unix.worker.js", "toolkit/modules/subprocess/test/xpcshell/test_subprocess.js"], "git_node": "dd7f78e087a0e215c77a28d06cf8f4103473cedc", "git_parents": ["345cd49120b5cae4cb6b624d012376d6f9f5f107"], "node": "3feb4c2e07524fa1a5bf5d293a706cd3d9fd4422", "parents": ["1c1c77e745dc6b201316952be0c88193215df652"], "tags": []}], "date": 1790058823, "git_changesets": ["dd7f78e087a0e215c77a28d06cf8f4103473cedc"], "user": "pchevrel@mozilla.com"}, "633": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068367: Make Cairo _get_bitmap_surface free its tmp buffer.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324784\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327866\n", "files": ["gfx/cairo/cairo/src/cairo-ft-font.c", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0051-Bug-2068367-bitmap-surface-tmp-buffer.patch"], "git_node": "4b9c46af1cbaae8e4d0098d28d66acf8b453d0fc", "git_parents": ["dd7f78e087a0e215c77a28d06cf8f4103473cedc"], "node": "d7191b6281b3f7c4574555b631ee39f2c1cca5f8", "parents": ["3feb4c2e07524fa1a5bf5d293a706cd3d9fd4422"], "tags": []}], "date": 1790059664, "git_changesets": ["4b9c46af1cbaae8e4d0098d28d66acf8b453d0fc"], "user": "pchevrel@mozilla.com"}, "634": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073266 - Recover the stack pointer after the import wrapper's call.  a=pascalc DONTBUILD\n\nThe wasm import wrapper reads its instance slot and runs its epilogue at\nframe-pointer-relative offsets computed from framePushed, which assumes the\nstack pointer is unchanged across the call. A callee that ends in a return\ncall collapses frames and can leave the stack pointer elsewhere, so restore\nit from the frame pointer before reading those slots.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327347\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327830\n", "files": ["js/src/wasm/WasmStubs.cpp"], "git_node": "0eb6f1f2beb820b7d543f1988886c8f14c08bd65", "git_parents": ["4b9c46af1cbaae8e4d0098d28d66acf8b453d0fc"], "node": "e5da2725fc9dd646bd22528421c2cbe5df4b6772", "parents": ["d7191b6281b3f7c4574555b631ee39f2c1cca5f8"], "tags": []}], "date": 1790059698, "git_changesets": ["0eb6f1f2beb820b7d543f1988886c8f14c08bd65"], "user": "pchevrel@mozilla.com"}, "635": {"changesets": [{"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072413 - wasm: Change rooting of throw-stub owner during an exception.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327156\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327822\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2072413.js", "js/src/jit/JitFrames.cpp"], "git_node": "76fa89c5ee8502f3f931ce3b096a2f352d485fbf", "git_parents": ["0eb6f1f2beb820b7d543f1988886c8f14c08bd65"], "node": "22ec4530e7d1173272f8e6f09c2cb125c0539ac6", "parents": ["e5da2725fc9dd646bd22528421c2cbe5df4b6772"], "tags": []}], "date": 1790059750, "git_changesets": ["76fa89c5ee8502f3f931ce3b096a2f352d485fbf"], "user": "pchevrel@mozilla.com"}, "636": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068340 - Plumb aFromParser through nsXMLContentSink  a=pascalc\n\nThis change ensures that nsXMLContentSink::HandleStartElement properly\npasses through the parser origin.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325403\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327780\n", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xml/nsXMLFragmentContentSink.cpp"], "git_node": "aefceafbbce9e2c5a42f7b4682544394bc0b22d2", "git_parents": ["76fa89c5ee8502f3f931ce3b096a2f352d485fbf"], "node": "24a60d984a3b05034583e3cf377454c2b14add57", "parents": ["22ec4530e7d1173272f8e6f09c2cb125c0539ac6"], "tags": []}], "date": 1790059790, "git_changesets": ["aefceafbbce9e2c5a42f7b4682544394bc0b22d2"], "user": "pchevrel@mozilla.com"}, "637": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2067248 - Accept several pipe-separated homepages in the Homepage policy.  a=pascalc\n\nbrowser.startup.homepage holds one URL or several separated by \"|\", and\nadministrators have long set the whole list as Homepage.URL rather than using\nAdditional. No JSON Schema format describes that value, and \"uri\" rejects \"|\"\noutright, so the list no longer validates.\n\nGive Homepage.URL a \"moz-homepage-url-list\" format: split on \"|\" the way\nHomePage.sys.mjs splits the pref, and require every entry to parse as a URL.\nThe field hydrates to a normalized string instead of a URL object, since no\nsingle URL object can hold a list.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321965\n\n(cherry picked from commit b924677bda6ba7a0d4a553ce328b778be89deacf)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327883\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_set_homepage.js", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs"], "git_node": "01cc8c09f78028dc1a0b6b88e09a3264dea0982c", "git_parents": ["aefceafbbce9e2c5a42f7b4682544394bc0b22d2"], "node": "25b3f4f28b0cd09d32fe15d24fd82e9515a8edc2", "parents": ["24a60d984a3b05034583e3cf377454c2b14add57"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2067099 - Contain unresolvable Handlers entries so later entries are still processed.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321971\n\n(cherry picked from commit 674ab89622d796e216e1d41b5a5ff7e4bfc62d51)\n\nRebased for ESR 153: the helper functions moved to\ntoolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs in Bug 2048572,\nwhich is not on ESR 153. The processMIMEInfo change is applied in its\npre-refactor location in browser/components/enterprisepolicies/Policies.sys.mjs\nand the lazy.processMIMEInfo call sites are unprefixed accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327884\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_handlers.js"], "git_node": "b27d38231772a0b925ac3e5345cdd9aa3f11e785", "git_parents": ["01cc8c09f78028dc1a0b6b88e09a3264dea0982c"], "node": "06f3a1c1b123ed8d65b56e46166a671f18802d8d", "parents": ["25b3f4f28b0cd09d32fe15d24fd82e9515a8edc2"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2067123 - Record and surface policies that only partially applied.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322420\n\n(cherry picked from commit 97652a82f9b00fd400a94271fc8f0352585ddd6c)\n\nRebased for ESR 153: Bug 2048572, which moved the Policies helper functions to\ntoolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs, is not on\nESR 153. PoliciesHelpers.sys.mjs is added here containing only the new\nPolicyFailures state and reportFailure, which EnterprisePoliciesParent and the\nbrowser-side policy helpers both need. The other helpers keep their existing\nhome in browser/components/enterprisepolicies/Policies.sys.mjs, so their call\nsites stay unprefixed and applyExtensionGuards, installAddonFromRepository and\ninstallAddonFromURL take their policyName changes in place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327885\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/content/aboutPolicies.css", "browser/components/enterprisepolicies/content/aboutPolicies.html", "browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/helpers/BookmarksPolicies.sys.mjs", "browser/components/enterprisepolicies/helpers/ProxyPolicies.sys.mjs", "browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policies_about_policies.js", "browser/components/enterprisepolicies/tests/xpcshell/test_policy_failures.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "browser/locales/en-US/browser/aboutPolicies.ftl", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs", "toolkit/components/enterprisepolicies/moz.build"], "git_node": "36d2aaac467dee967e1878aa1b7672d23baa3b3d", "git_parents": ["b27d38231772a0b925ac3e5345cdd9aa3f11e785"], "node": "acd7604a946bdd111a336563dfd0ef4288d18114", "parents": ["06f3a1c1b123ed8d65b56e46166a671f18802d8d"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2067123 - Name the Handlers entry that failed and say why a preference could not be set.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322421\n\n(cherry picked from commit c6bac48c25adacb20339375b1666e1af0c4d3d32)\n\nRebased for ESR 153: describePreferenceFailure is added to the trimmed\nPoliciesHelpers.sys.mjs introduced in the previous patch, and processMIMEInfo\ntakes its policyName change in place in\nbrowser/components/enterprisepolicies/Policies.sys.mjs, where ESR 153 still\nkeeps it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327886\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/c