 "git_parents": ["c5b43c85d4031f90e7863ef88bbaea447dec8178"], "node": "080e5057996078d8f07197bb741cc45f8e5e5f73", "parents": ["2bb652c987c1afc71d30d87b177d5f26bea344d9"], "tags": []}], "date": 1789466454, "git_changesets": ["d4215656acf0d870031dcb86f374ee23ccf29816"], "user": "pchevrel@mozilla.com"}, "544": {"changesets": [{"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070972 - Repeat the loopback video test frame with imagefreeze  a=pascalc DONTBUILD\n\nUse the current v4l2loopback control IDs. Repeat one green frame with GStreamer imagefreeze so the producer continues to supply frames while tests open and close the video device. The existing cleanup stops the producer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325488\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325821\n", "files": ["testing/mochitest/runtests.py"], "git_node": "db221809717a7ba135df9dce41fb3c5b2c4082cc", "git_parents": ["d4215656acf0d870031dcb86f374ee23ccf29816"], "node": "5dfb6551f3826b2416db3086c888f82dd57e9e12", "parents": ["080e5057996078d8f07197bb741cc45f8e5e5f73"], "tags": []}], "date": 1789466522, "git_changesets": ["db221809717a7ba135df9dce41fb3c5b2c4082cc"], "user": "pchevrel@mozilla.com"}, "545": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062740  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318094\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325807\n", "files": ["dom/clients/manager/ClientOpenWindowUtils.cpp"], "git_node": "9369f098b7f81cf877b0dca0a3a613a132605be4", "git_parents": ["db221809717a7ba135df9dce41fb3c5b2c4082cc"], "node": "1cc07fd6323dbaac52ebf6d5619713fac901b44c", "parents": ["5dfb6551f3826b2416db3086c888f82dd57e9e12"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062740 - Test.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322564\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325808\n", "files": ["dom/notification/test/mochitest/openWindow.serviceworker.js"], "git_node": "3506f2f6d13bdc6d6a57c19e9c3455230563378a", "git_parents": ["9369f098b7f81cf877b0dca0a3a613a132605be4"], "node": "c94251a7c7de41b32231da4cdba9848884c767ad", "parents": ["1cc07fd6323dbaac52ebf6d5619713fac901b44c"], "tags": []}], "date": 1789466715, "git_changesets": ["9369f098b7f81cf877b0dca0a3a613a132605be4", "3506f2f6d13bdc6d6a57c19e9c3455230563378a"], "user": "pchevrel@mozilla.com"}, "546": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049792 - Sanity-check content-provided result and original URI.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319828\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325768\n", "files": ["docshell/base/nsDocShellLoadState.cpp"], "git_node": "0667f1203c2ad56de3e5bd44d9d77545de640a75", "git_parents": ["3506f2f6d13bdc6d6a57c19e9c3455230563378a"], "node": "a4efe81590998264d07464119aa47fb5a439fad7", "parents": ["c94251a7c7de41b32231da4cdba9848884c767ad"], "tags": []}], "date": 1789466778, "git_changesets": ["0667f1203c2ad56de3e5bd44d9d77545de640a75"], "user": "pchevrel@mozilla.com"}, "547": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070871 - Reuse the pending MLS fallback when PortalLocationProvider::Watch is called again.  a=pascalc DONTBUILD\n\nWatch() runs for every new geolocation request while the provider stays\nstarted. While the portal has not delivered a position yet, each call\nreplaced the MLSFallback without shutting the previous one down, so its\nNetworkGeolocationProvider stayed alive with its repeating timer and wifi\nlistener for the rest of the session.\n\nReuse the existing fallback instead, and add a gtest that counts the armed\nfallback timers across repeated Watch() calls.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324916\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325763\n", "files": ["dom/system/linux/PortalLocationProvider.cpp", "dom/system/linux/gtest/TestPortalLocationProvider.cpp", "dom/system/linux/gtest/moz.build", "dom/system/linux/moz.build"], "git_node": "10ef6004913feeb96028f6a24eb45be44aa99cfa", "git_parents": ["0667f1203c2ad56de3e5bd44d9d77545de640a75"], "node": "4cafa4395fd8813bf11ead1f499f1ab3fd2035f7", "parents": ["a4efe81590998264d07464119aa47fb5a439fad7"], "tags": []}], "date": 1789466828, "git_changesets": ["10ef6004913feeb96028f6a24eb45be44aa99cfa"], "user": "pchevrel@mozilla.com"}, "548": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066354 - Don't crash for illegal loads in release builds.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324568\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325307\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h"], "git_node": "39a75fbab8ff5d51c5ea8dd5a73f3fb1f09e8155", "git_parents": ["10ef6004913feeb96028f6a24eb45be44aa99cfa"], "node": "9f66e6d4e71395cc2f481a43a491e79a9a84628c", "parents": ["4cafa4395fd8813bf11ead1f499f1ab3fd2035f7"], "tags": []}], "date": 1789470048, "git_changesets": ["39a75fbab8ff5d51c5ea8dd5a73f3fb1f09e8155"], "user": "pchevrel@mozilla.com"}, "549": {"changesets": [{"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2069644 - Fix non-Nightly CloseHandleWrapper.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325055\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325298\n", "files": ["security/sandbox/chromium-shim/patches/39_change_to_DCHECK_in_CloseHandleWrapp