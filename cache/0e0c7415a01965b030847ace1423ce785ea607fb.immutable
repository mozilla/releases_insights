5e2a0"], "user": "rvandermeulen@mozilla.com"}, "1215": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2036929 - Make nsUnknownDecoder::CheckListenerChain return error  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D303834\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303854\n", "files": ["netwerk/streamconv/converters/nsUnknownDecoder.cpp"], "git_node": "34b0d67d03d06f5a6685a68ee9580ad3bb9d19c5", "git_parents": ["636a4bc5812ad44219700510c6050e0d3045e2a0"], "node": "d4b1e2e216e58520c48d8d398f0d7ec2d2734626", "parents": ["4cebe732d3c7b3830b6608d5857ad1b16c753190"], "tags": []}], "date": 1780338694, "git_changesets": ["34b0d67d03d06f5a6685a68ee9580ad3bb9d19c5"], "user": "rvandermeulen@mozilla.com"}, "1216": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042268 - Properly clean up ObservableArray proxy;  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302983\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303723\n", "files": ["dom/bindings/Codegen.py"], "git_node": "b5eb11883f806504c21da089269f3d7d546a8834", "git_parents": ["34b0d67d03d06f5a6685a68ee9580ad3bb9d19c5"], "node": "2d846ff94a4b9424e8bc71af67a5ae5dedd378d1", "parents": ["d4b1e2e216e58520c48d8d398f0d7ec2d2734626"], "tags": []}], "date": 1780345502, "git_changesets": ["b5eb11883f806504c21da089269f3d7d546a8834"], "user": "rvandermeulen@mozilla.com"}, "1217": {"changesets": [{"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041981 - Cherry-pick upstream libwebrtc commit 9a7f650bcd. r=bwc a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/9a7f650bcd14f241d20f88f4e1ea3b7300de72ac\n       [M148] Always release VideoEncoders before destruction.\n\n       Original change's description:\n       \u003e Always release VideoEncoders before destruction.\n       \u003e\n       \u003e Without a `Release()` call there is a potential for race conditions\n       \u003e between asynchronous encoder callbacks and the destructor sequence.\n       \u003e\n       \u003e Bug: chromium:504620824\n       \u003e Change-Id: I1fba23ef3a4a238503cdf8d2ea5831e815d7b902\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/465582\n       \u003e Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       \u003e Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n       \u003e Commit-Queue: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n       \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47495}\n\n       (cherry picked from commit 21d9744bd599d106da9171fbb1ed09047d7178ca)\n\n       Bug: chromium:505251595,chromium:504620824\n       Change-Id: I1fba23ef3a4a238503cdf8d2ea5831e815d7b902\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/468940\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Cr-Commit-Position: refs/branch-heads/7778@{#7}\n       Cr-Branched-From: ca896b7ffef011bbf6957c99d413c5aac602c99f-refs/heads/main@{#47319}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303835\n", "files": ["third_party/libwebrtc/moz-patch-stack/9a7f650bcd.no-op-cherry-pick-msg", "third_party/libwebrtc/video/video_stream_encoder.cc", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc"], "git_node": "c25258ec73bd14513257ee56b0533b246711bcba", "git_parents": ["b5eb11883f806504c21da089269f3d7d546a8834"], "node": "bb9f526bcf9f7c79fc0f1d52862317cc9ee0b6bc", "parents": ["2d846ff94a4b9424e8bc71af67a5ae5dedd378d1"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041981 - Cherry-pick upstream libwebrtc commit 305a870932. r=bwc a=RyanVM\n\nand needed to properly build:\n              Cherry-pick upstream libwebrtc commit e26f1de971\n              Cherry-pick upstream libwebrtc commit 71434c0a5e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/305a870932d9c9de4bbfe3814d4946b2f6cf2c60\n       [M148] Refactor RTP header extension ID allocation to be persistent and shared.\n\n       Original change's description:\n       \u003e Refactor RTP header extension ID allocation to be persistent and shared.\n       \u003e\n       \u003e - Introduced RtpHeaderExtensionRecorder and RtpHeaderExtensionPicker in\n       \u003e call/payload_type_picker.\n       \u003e - Added SuggestRtpHeaderExtensionId and AddRtpHeaderExtensionMapping to\n       \u003e PayloadTypeSuggester interface.\n       \u003e - Implemented persistent RTP header extension ID mapping in\n       \u003e SdpPayloadTypeSuggester.\n       \u003e - Refactored pc/media_session.cc to use PayloadTypeSuggester for all\n       \u003e RTP header extension ID allocations, replacing UsedRtpHeaderExtensionIds.\n       \u003e - Ensured shared mapping between local and remote extensions for the\n       \u003e same transport.\n       \u003e - Maintained RFC 8285 compliance for one-byte and two-byte ID allocation.\n       \u003e - Updated tests to explicitly allow mixed extensions when two-byte IDs\n       \u003e are expected.\n       \u003e - Removed obsolete UsedRtpHeaderExtensionIds and its unit test.\n       \u003e\n       \u003e Bug: webrtc:503013383\n       \u003e Change-Id: Ic98522b1eec52c736a73bd034493f19ac6524b5a\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/465300\n       \u003e Auto-Submit: Harald Alvestrand \u003chta@webrtc.org\u003e\n       \u003e Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n       \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47492}\n\n       (cherry picked from commit d1ae1e9ad4d183f4b00ad0962b35bba90162f038)\n\n       Bug: webrtc:503013383\n       Bug: chromium:513880244\n       Fixed: chromium:514078702\n       No-Try: true\n       Change-Id: If466bf7fa67e1277bcdd6b8af8c4f175ad0c9df7\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/472720\n       Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n       Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n       Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n       Cr-Commit-Position: refs/branch-heads/7778@{#8}\n       Cr-Branched-From: ca896b7ffef011bbf6957c99d413c5aac602c99f-refs/heads/main@{#47319}\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e26f1de971edd0d26a19c788fbe09ce1d5cfb865\n       Remove a PT handling that had no effect\n\n       This code block was found to have no effect on PT mapping.\n       Submitting as a separate CL in order to ensure no side effects.\n\n       Bug: webrtc:360058654\n       Change-Id: Ie25d7d6c1b39c4705a3277edaad8e1cf44483306\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/429342\n       Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#46350}\n\nUpstream commit: https://webrtc.googlesource.com/src/+/71434c0a5e66602c7a79a2ad52e15f35f6369df6\n    Remove JsepTransportController's PayloadTypeSuggester\n\n    Also remove functions that were only called from that.\n\n    Bug: webrtc:360058654\n    Change-Id: I7a4e3a5f4c65f586f002dfdc35d927c74ad3fff5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/429344\n    Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#46394}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303836\n", "files": ["third_party/libwebrtc/api/rtp_parameters.h", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/call.cc", "third_party/libwebrtc/call/call.h", "third_party/libwebrtc/call/fake_payload_type_suggester.h", "third_party/libwebrtc/call/payload_type.h", "third_party/libwebrtc/call/payload_type_picker.cc", "third_party/libwebrtc/call/payload_type_picker.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc"], "git_node": "c30cf22c1ea24a6d97334cc12a34bdf7adedf6f0", "git_parents": ["c25258ec73bd14513257ee56b0533b246711bcba"], "node": "22eeeb473d66bb98db20eb9c5d8b037e99b2fad1", "parents": ["bb9f526bcf9f7c79fc0f1d52862317cc9ee0b6bc"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041981 - Cherry-pick upstream libwebrtc commit d46237a72e r=bwc a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d46237a72ede7294840c375bed7b9df6f60cdca7\n       [M148] Validate CGImage dimensions in MouseCursorMonitorMac\n\n       Original change's description:\n       \u003e Validate CGImage dimensions in MouseCursorMonitorMac\n       \u003e\n       \u003e This adds missing height checks alongside the existing width checks\n       \u003e when processing and scaling the cursor image.\n       \u003e\n       \u003e Fixed: chromium:513268100\n       \u003e Change-Id: Ida1e58334a9d3bda429819e4af51b33afbd0a95d\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/472700\n       \u003e Reviewed-by: Alexander Cooper \u003calcooper@chromium.org\u003e\n       \u003e Auto-Submit: Johannes Kron \u003ckron@webrtc.org\u003e\n       \u003e Commit-Queue: Alexander Cooper \u003calcooper@chromium.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47715}\n\n       (cherry picked from commit b343cd4e280980f26b4feb80684f57d5b4324e12)\n\n       Bug: chromium:514925120,chromium:513268100\n       Change-Id: Ida1e58334a9d3bda429819e4af51b33afbd0a95d\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/473980\n       Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Cr-Commit-Position: refs/branch-heads/7778@{#9}\n       Cr-Branched-From: ca896b7ffef011bbf6957c99d413c5aac602c99f-refs/heads/main@{#47319}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303837\n", "files": ["third_party/libwebrtc/modules/desktop_capture/mouse_cursor_monitor_mac.mm", "third_party/libwebrtc/moz-patch-stack/d46237a72e.no-op-cherry-pick-msg"], "git_node": "3f180a49feb89166ac77d41934aab199434808f8", "git_parents": ["c30cf22c1ea24a6d97334cc12a34bdf7adedf6f0"], "node": "de621d9b48fb6d181f1e1167cb4c550664e5672a", "parents": ["22eeeb473d66bb98db20eb9c5d8b037e99b2fad1"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041981 - Cherry-pick upstream libwebrtc commit 26c6538381 r=bwc a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/26c6538381a19e8ed58af0c22068db9f050d2967\n       [M148] Guard RestoreTokenManager add/reads with Mutex\n\n       Original change's description:\n       \u003e Guard RestoreTokenManager add/reads with Mutex\n       \u003e\n       \u003e The RestoreTokenManager is a singleton who's adds and reads could be\n       \u003e accessed by multiple threads simultaneously. To prevent any potential\n       \u003e issues/collisions, ensure that such accesses happen behind a lock.\n       \u003e\n       \u003e Bug: chromium:513049286\n       \u003e Change-Id: I44c1c7977a6d02e1ac3fbe00e6ffc7bc22e41e46\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/472480\n       \u003e Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n       \u003e Auto-Submit: Alexander Cooper \u003calcooper@chromium.org\u003e\n       \u003e Commit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47711}\n\n       (cherry picked from commit b9f0b184cb5a487fcb4910efaf4f84483ddba284)\n\n       Bug: chromium:514926739,chromium:513049286\n       Change-Id: I44c1c7977a6d02e1ac3fbe00e6ffc7bc22e41e46\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/474060\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Cr-Commit-Position: refs/branch-heads/7778@{#10}\n       Cr-Branched-From: ca896b7ffef011bbf6957c99d413c5aac602c99f-refs/heads/main@{#47319}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303838\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/restore_token_manager.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/restore_token_manager.h"], "git_node": "447f12007cb52539e19d4cd207878c9b068d4560", "git_parents": ["3f180a49feb89166ac77d41934aab199434808f8"], "node": "6828c079c633bd5ab1d7fbfa6d24796746c77f49", "parents": ["de621d9b48fb6d181f1e1167cb4c550664e5672a"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041981 - Cherry-pick upstream libwebrtc commit ac8b0016a8 r=bwc a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ac8b0016a84a52407e52b92af0671ed23196202c\n       [M148] [desktop capture] Fix TOCTOU race condition in CroppingWindowCapturer.\n\n       Original change's description:\n       \u003e [desktop capture] Fix TOCTOU race condition in CroppingWindowCapturer.\n       \u003e\n       \u003e Crop the frame using the window rectangle captured when the capture\n       \u003e was initiated, rather than re-querying the rectangle after the capture\n       \u003e finishes.\n       \u003e\n       \u003e Bug: chromium:504557432\n       \u003e Change-Id: I459d528ac343163fde9a9dbf6c40a542c1a04c61\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/467820\n       \u003e Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n       \u003e Reviewed-by: Alexander Cooper \u003calcooper@chromium.org\u003e\n       \u003e Commit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47575}\n\n       (cherry picked from commit 22f071a33eb46cbabcbf05961127dde7a2e3d908)\n\n       Bug: chromium:514924157,chromium:504557432\n       Change-Id: I459d528ac343163fde9a9dbf6c40a542c1a04c61\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/474160\n       Reviewed-by: Alexander Cooper \u003calcooper@chromium.org\u003e\n       Commit-Queue: Alexander Cooper \u003calcooper@chromium.org\u003e\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n       Cr-Commit-Position: refs/branch-heads/7778@{#11}\n       Cr-Branched-From: ca896b7ffef011bbf6957c99d413c5aac602c99f-refs/heads/main@{#47319}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303839\n", "files": ["third_party/libwebrtc/modules/desktop_capture/cropping_window_capturer.cc", "third_party/libwebrtc/modules/desktop_capture/cropping_window_capturer.h"], "git_node": "51cde6ede91ca04023b41d7ae8b578b6704fcf57", "git_parents": ["447f12007cb52539e19d4cd207878c9b068d4560"], "node": "309fc2b889f02e21e6f35e9d151807efa105044b", "parents": ["6828c079c633bd5ab1d7fbfa6d24796746