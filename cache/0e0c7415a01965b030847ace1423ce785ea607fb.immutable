la.com/D305204\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.cpp"], "git_node": "2d09a47c65794816a8d97c2ef379d0d9d4df76ca", "git_parents": ["598abdfdc99f8ffb7ff98183882e6d1fd9f7802a"], "node": "373a83f60320e21e5197f320b46e676cdf7967bf", "parents": ["c5a68f62ed1c75ae6cd387e4293d0e6303849253"], "tags": []}], "date": 1780965222, "git_changesets": ["2d09a47c65794816a8d97c2ef379d0d9d4df76ca"], "user": "rvandermeulen@mozilla.com"}, "1238": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305103\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "4a06bdfaaa22f97f7e42e2406377e4da19721b12", "git_parents": ["2d09a47c65794816a8d97c2ef379d0d9d4df76ca"], "node": "5e353c602bf902416d7ab3b8a79f5b7c51ac261e", "parents": ["373a83f60320e21e5197f320b46e676cdf7967bf"], "tags": []}], "date": 1780965249, "git_changesets": ["4a06bdfaaa22f97f7e42e2406377e4da19721b12"], "user": "rvandermeulen@mozilla.com"}, "1239": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042724: Check uses_memory at validation time.  a=RyanVM\n\nAdds a new pass to validation that ensures that all imports of builtin\nfunctions with uses_memory have a memory available. This occurs after\nthe memory section but before the code section, so the code section can\nonly concern itself with providing the correct parameters. In addition,\nit ensures that the memory used is unshared.\n\nAlso fixes an issue where a LinkError encountered during builtin\ninstantiation would trigger a release assert.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D303914\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305364\n", "files": ["js/src/jit-test/tests/wasm/builtin-modules/bad-memory.js", "js/src/jit-test/tests/wasm/builtin-modules/directives.txt", "js/src/jit-test/tests/wasm/builtin-modules/uses-memory.js", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmBuiltinModule.cpp", "js/src/wasm/WasmOpIter.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "72f16fdbe1d60da55a96b009314e69d8c93ea008", "git_parents": ["4a06bdfaaa22f97f7e42e2406377e4da19721b12"], "node": "a8a3808acd17f25d85e18b9c85d64c29b97ca35a", "parents": ["5e353c602bf902416d7ab3b8a79f5b7c51ac261e"], "tags": []}], "date": 1780965268, "git_changesets": ["72f16fdbe1d60da55a96b009314e69d8c93ea008"], "user": "rvandermeulen@mozilla.com"}, "1240": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2007035 - Migrate Windows Limited Access Feature code to Rust. a=RyanVM\" for build bustage.\n\nThis reverts commit 598abdfdc99f8ffb7ff98183882e6d1fd9f7802a.\n", "files": ["Cargo.lock", "browser/components/build/components.conf", "browser/components/shell/Windows11LimitedAccessFeatures.cpp", "browser/components/shell/Windows11LimitedAccessFeatures.h", "browser/components/shell/Windows11TaskbarPinning.cpp", "browser/components/shell/moz.build", "browser/components/shell/nsILimitedAccessFeature.idl", "browser/components/shell/rust/shell_windows/Cargo.toml", "browser/components/shell/rust/shell_windows/src/LimitedAccessFeatureService.h", "browser/components/shell/rust/shell_windows/src/lib.rs", "browser/components/shell/rust/shell_windows/src/limited_access_features.rs", "browser/components/shell/test/gtest/LimitedAccessFeatureTests.cpp", "config/create_rc.py", "toolkit/library/rust/gkrust-features.mozbuild", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs", "tools/lint/clippy.yml"], "git_node": "251abe798f3e4e079c9821fd046041973d9e62ff", "git_parents": ["72f16fdbe1d60da55a96b009314e69d8c93ea008"], "node": "c780f734c5adbe681f2a491033903ebabd7c8809", "parents": ["a8a3808acd17f25d85e18b9c85d64c29b97ca35a"], "tags": []}], "date": 1780966471, "git_changesets": ["251abe798f3e4e079c9821fd046041973d9e62ff"], "user": "rvandermeulen@mozilla.com"}, "1241": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042724 - Skip builtin-modules memory jit-tests on ESR140. a=bustage\n\nThey require the mozIntGemm direct-import compile option (bug 1969508) not present on this branch.\n", "files": ["js/src/jit-test/tests/wasm/builtin-modules/bad-memory.js", "js/src/jit-test/tests/wasm/builtin-modules/uses-memory.js"], "git_node": "dfbb7b5f3816f912ac75e85a0425021dbb72c8bc", "git_parents": ["251abe798f3e4e079c9821fd046041973d9e62ff"], "node": "7d1e98f7752365ee71fa43db1ffd0c47e934ca45", "parents": ["c780f734c5adbe681f2a491033903ebabd7c8809"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2006135 - Add .claude/settings.local.json to .gitignore. r=ai4dev-reviewers,suhaib a=NPOTB\n", "files": [".gitignore"], "git_node": "c5295056127021c100a867bd3f81aaa78e1a53ad", "git_parents": ["dfbb7b5f3816f912ac75e85a0425021dbb72c8bc"], "node": "f117bf5e4583815bd8a316abf1fa9f61315ce006", "parents": ["7d1e98f7752365ee71fa43db1ffd0c47e934ca45"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042268 - Fix linter failures. a=bustage\n", "files": ["dom/bindings/Codegen.py"], "git_node": "32bf7eb42c0bc302581ad38a91b4522c9d50ef0b", "git_parents": ["c5295056127021c100a867bd3f81aaa78e1a53ad"], "node": "5975b0123d2dc96e3e2fb2078f4e729e6dd8c01b", "parents": ["f117bf5e4583815bd8a316abf1fa9f61315ce006"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2041118 - Route ESR140 Windows 11 24H2 GPU tests to 25H2 worker pools, update test expectations. a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305568\n", "files": ["dom/canvas/test/webgl-conf/generated-mochitest.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/media/test/reftest/color_quads/reftest.list", "dom/media/test/reftest/reftest.list", "taskcluster/config.yml", "taskcluster/kinds/test/mochitest.yml", "taskcluster/kinds/test/reftest.yml", "taskcluster/kinds/test/variants.yml", "taskcluster/kinds/test/web-platform.yml", "testing/web-platform/meta/css/CSS2/generated-content/content-counter-005.xht.ini", "testing/web-platform/meta/css/CSS2/generated-content/content-counter-016.xht.ini"], "git_node": "498c7dbf6f5536dcaa44ae99537469bb0ee8cdbf", "git_parents": ["32bf7eb42c0bc302581ad38a91b4522c9d50ef0b"], "node": "9073d70c0763f564cf2538a5ce869ed03cc429c7", "parents": ["5975b0123d2dc96e3e2fb2078f4e729e6dd8c01b"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 1944610 - Read Windows cache paths from worker environment. a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D261470\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305401\n", "files": ["taskcluster/gecko_taskgraph/transforms/job/common.py", "taskcluster/scripts/run-task", "testing/mozharness/configs/builds/taskcluster_base_windows.py", "testing/mozharness/configs/talos/windows_taskcluster_config.py"], "git_node": "028cdc6895415838b2c139fbf1ae4ee813a6ec7c", "git_parents": ["498c7dbf6f5536dcaa44ae99537469bb0ee8cdbf"], "node": "1cda6a79659bad5f1da5032f69eb0f4b80b77610", "parents": ["9073d70c0763f564cf2538a5ce869ed03cc429c7"], "tags": []}], "date": 1781008262, "git_changesets": ["dfbb7b5f3816f912ac75e85a0425021dbb72c8bc", "c5295056127021c100a867bd3f81aaa78e1a53ad", "32bf7eb42c0bc302581ad38a91b4522c9d50ef0b", "498c7dbf6f5536dcaa44ae99537469bb0ee8cdbf", "028cdc6895415838b2c139fbf1ae4ee813a6ec7c"], "user": "rvandermeulen@mozilla.com"}, "1242": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1945274 - Fix race condition in get_output_from_command using shared tmpfile names. r=releng-reviewers,bhearsum a=test-only DONTBUILD\n\nThe Python test runner executes mozharness test files concurrently via\nThreadPoolExecutor. Both test_base_script.py and test_base_vcs_mercurial.py\ncall get_output_from_command(), which used hardcoded filenames\n(tmpfile_stdout/tmpfile_stderr) in the current working directory.\ntest_base_script.py's cleanup() helper deletes these files in every\nsetUp/tearDown, racing with the mercurial tests' hg subprocess output,\ncausing get_output_from_command() to return None and subsequent\nAttributeError crashes.\n\nFix by using tempfile.mkstemp() to create unique per-call temp files,\npassing the returned file descriptors directly to Popen. Also close the\nstdout fd when the stderr mkstemp fails before returning None, to avoid\nleaking the file descriptor.\n\nAdd test_chdir_relative to cover the relative-path case that was\npreviously exercised by test_chdir when it used the shared test_logs\ndirectory.\n", "files": ["testing/mozharness/mozharness/base/script.py", "testing/mozharness/test/test_base_script.py"], "git_node": "e505188aef2cf8e754e4b618ab1ce40e63fce95d", "git_parents": ["028cdc6895415838b2c139fbf1ae4ee813a6ec7c"], "node": "8979cdc62024b96a1c48562f5cb4420585fbecca", "parents": ["1cda6a79659bad5f1da5032f69eb0f4b80b77610"], "tags": []}], "date": 1781011470, "git_changesets": ["e505188aef2cf8e754e4b618ab1ce40e63fce95d"], "user": "rvandermeulen@mozilla.com"}, "1243": {"changesets": [{"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2044142: Add unzip to the updatebot image r=freddyb a=NPOTB\n", "files": ["taskcluster/docker/updatebot/privileged-setup.sh"], "git_node": "11b0364777677e2577450aacb092a70b216fb3c7", "git_parents": ["e505188aef2cf8e754e4b618ab1ce40e63fce95d"], "node": "946c9b908f29d52fb89d74ae32897b4272e4926b", "parents": ["8979cdc62024b96a1c48562f5cb4420585fbecca"], "tags": []}], "date": 1781011818, "git_changesets": ["11b0364777677e2577450aacb092a70b216fb3c7"], "user": "rvandermeulen@mozilla.com"}, "1244": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042058 - Strip CustomElementData in nsTreeSanitizer.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D303755\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305531\n", "files": ["dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsINode.h", "dom/base/nsTreeSanitizer.cpp"], "git_node": "65b41921be379ea39df7463f68ec92b11916eb46", "git_parents": ["11b0364777677e2577450aacb092a70b216fb3c7"], "node": "da683fc177cf440f051b4541b02e66bf3b2730af", "parents": ["946c9b908f29d52fb89d74ae32897b4272e4926b"], "tags": []}], "date": 1781019149, "git_changesets": ["65b41921be379ea39df7463f68ec92b11916eb46"], "user": "rvandermeulen@mozilla.com"}, "1245": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032185 - Update Widevine fallback downloader URLs for 4.10.3050.0.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304106\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305444\n", "files": ["toolkit/content/gmp-sources/widevinecdm.json"], "git_node": "6c0ffa4e3e4ac08ed4c277f3c1e8e88905da9c8a", "git_parents": ["65b41921be379ea39df7463f68ec92b11916eb46"], "node": "c987d7608d3b1887faa5cbef2805602b61f51d85", "parents": ["da683fc177cf440f051b4541b02e66bf3b2730af"], "tags": []}], "date": 1781019179, "git_changesets": ["6c0ffa4e3e4ac08ed4c277f3c1e8e88905da9c8a"], "user": "rvandermeulen@mozilla.com"}, "1246": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2039443.  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305415\n", "files": ["media/libpng/apng.patch", "media/libpng/pngpread.c"], "git_node": "a138ef1ad03ef9ff3d9742c77b7deaad95b1a2c1", "git_parents": ["6c0ffa4e3e4ac08ed4c277f3c1e8e88905da9c8a"], "node": "3e7eac43f91ee33f6f83245e85d0c115a65a4bb2", "parents": ["c987d7608d3b1887faa5cbef2805602b61f51d85"], "tags": []}], "date": 1781019204, "git_changesets": ["a138ef1ad03ef9ff3d9742c77b7deaad95b1a2c1"], "user": "rvandermeulen@mozilla.com"}, "1247": {"changesets": [{"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2042782 - fix(webgl): clamp `maxColorDrawBuffers` to `kMaxDrawBuffers`  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D303020\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305253\n", "files": ["dom/canvas/WebGLContextValidate.cpp"], "git_node": "182e8b67fd4a22a6b12589b1d9535ac4c7e6464e", "git_parents": ["a138ef1ad03ef9ff3d9742c77b7deaad95b1a2c1"], "node": "4ebb302722bb1aa346eb57ceff49eb4396fe0fc2", "parents": ["3e7eac43f91ee33f6f83245e85d0c115a65a4bb2"], "tags": []}], "date": 1781019248, "git_changesets": ["182e8b67fd4a22a6b12589b1d9535ac4c7e6464e"], "user": "rvandermeulen@mozilla.com"}, "1248": {"changesets": [{"author": "Ashley Hale \u003cahale@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029402 - cherrypick a gl_FragColor bug fix in ANGLE  a=RyanVM\n\nSome of the changes weren't brought in:\n\n- Rust changes aren't being brought in yet because the base didn't have the parallel Rust implementation of the compiler.\n- We forgo tests to simplify rebasing, under the assumption that upstream will keep these tests and not regress.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D305452\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305571\n", "files": ["gfx/angle/checkout/src/compiler/translator/tree_ops/EmulateGLFragColorBroadcast.cpp"], "git_node": "f8025617e815f21388b40baf189338d31a5f9a0a", "git_parents": ["182e8b67fd4a22a6b12589b1d9535ac4c7e6464e"], "node": "7df86525c2c876c7c92320e49c3e0771f7a605c0", "parents": ["4ebb302722bb1aa346eb57ceff49eb4396fe0fc2"], "tags": ["FIREFOX_140_12_0esr_BUILD1", "FIREFOX_140_12_0esr_RELEASE"]}], "date": 1781019293, "git_changesets": ["f8025617e815f21388b40baf189338d31a5f9a0a"], "user": "rvandermeulen@mozilla.com"}}
