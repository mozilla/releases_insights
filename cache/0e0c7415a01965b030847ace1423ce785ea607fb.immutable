r/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "dd2f9eb18c7bf8b1f8b34715133fc8dc0e6dbe69", "git_parents": ["4fdc241f2f815114a3539d8c397520c9367ba5bf"], "node": "7e34b9613d443eae8ab336ada212f916437bf0ca", "parents": ["719a7123a3f3c0271cbc0a1b07c563eec70d152b"], "tags": []}], "date": 1779118663, "git_changesets": ["dd2f9eb18c7bf8b1f8b34715133fc8dc0e6dbe69"], "user": "rvandermeulen@mozilla.com"}, "1178": {"changesets": [{"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039070 - Emit pernosco notify pulse events for more state transitions,  a=RyanVM DONTBUILD\n\nPernosco folks indicated this would be helpful and make transitioning to\nthe new route simpler.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300119\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300471\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/pernosco.py"], "git_node": "a041231cb1244e0c8ffb3e69db609692d10e8fbe", "git_parents": ["dd2f9eb18c7bf8b1f8b34715133fc8dc0e6dbe69"], "node": "6585def2c27188ac6487458eecaa6d570bc7063d", "parents": ["7e34b9613d443eae8ab336ada212f916437bf0ca"], "tags": []}], "date": 1779121372, "git_changesets": ["a041231cb1244e0c8ffb3e69db609692d10e8fbe"], "user": "rvandermeulen@mozilla.com"}, "1179": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036676: Use basic GeolocationSystem implementation when NECKO_WIFI is not defined  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300825\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301209\n", "files": ["dom/geolocation/moz.build"], "git_node": "d4bcb1b84bc89a72c1dd08afbfe0a5ad82ea7c56", "git_parents": ["a041231cb1244e0c8ffb3e69db609692d10e8fbe"], "node": "f93a726de965670b87a0019c204a001cba85c36f", "parents": ["6585def2c27188ac6487458eecaa6d570bc7063d"], "tags": []}], "date": 1779159936, "git_changesets": ["d4bcb1b84bc89a72c1dd08afbfe0a5ad82ea7c56"], "user": "rvandermeulen@mozilla.com"}, "1180": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2039203 - Make `TSFEmptyTextStore::GetSelection` return `SelectionACP` collapsed at start of the empty text for Sogou  a=RyanVM DONTBUILD\n\nSogou which is TIP for Simplified Chinese crashes (at least ver. 16.4)\nafter `TSFEmptyTextStore::GetSelection()` returns `TS_E_NOSELECTION`\nerror. `TSFEmptyTextStore` treats it's empty and void. Therefore, we're\nreturning no selection error. However, the TIP does not handle the\ncase properly. It seems that returning a dummy selection avoids the\ncrash.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300501\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300928\n", "files": ["widget/windows/TSFEmptyTextStore.cpp", "widget/windows/TSFStaticSink.cpp", "widget/windows/TSFStaticSink.h", "widget/windows/TSFTextInputProcessorList.h", "widget/windows/TSFUtils.h"], "git_node": "4c941f1bacba353a68fad89886b9532cb73e9920", "git_parents": ["d4bcb1b84bc89a72c1dd08afbfe0a5ad82ea7c56"], "node": "b7aa7c3178fbb53c5444e497ec5c48a1272b308b", "parents": ["f93a726de965670b87a0019c204a001cba85c36f"], "tags": []}], "date": 1779159987, "git_changesets": ["4c941f1bacba353a68fad89886b9532cb73e9920"], "user": "rvandermeulen@mozilla.com"}, "1181": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2029444 - WebRTC backport: Add cursor size validation to Wayland capture  a=RyanVM DONTBUILD\n\nLimit maximum cursor size accepted to 1024x1024 to reject unreasonably large cursor metadata from PipeWire. Also promote existing constants from const to constexpr.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 07b9afe36a95b49c23f51ff8933b8b5f5a6b6878\n\nOriginal Revision: https://phabricator.services.mozilla.com/D299695\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300036\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/07b9afe36a.no-op-cherry-pick-msg"], "git_node": "2e049cf15e53a340db73eb0d3f2a9d1cea9df9b3", "git_parents": ["4c941f1bacba353a68fad89886b9532cb73e9920"], "node": "1e4bfe5a33c0ac9946141d53891a00faa69e308d", "parents": ["b7aa7c3178fbb53c5444e497ec5c48a1272b308b"], "tags": []}], "date": 1779160041, "git_changesets": ["2e049cf15e53a340db73eb0d3f2a9d1cea9df9b3"], "user": "rvandermeulen@mozilla.com"}, "1182": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1932413 - get the data from the parent process for broken site reports directly, rather then sending it through the child process (for ESR140); r=Gijs a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296253\n", "files": ["browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/reportbrokensite/test/browser/send_more_info.js", "mobile/android/android-components/components/feature/webcompat-reporter/src/main/assets/extensions/webcompat-reporter/experimentalAPIs/tabExtras.js", "toolkit/components/reportbrokensite/ReportBrokenSiteChild.sys.mjs", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs"], "git_node": "872ac2c8e47afc41be00b21d4f82f988d5bd7341", "git_parents": ["2e049cf15e53a340db73eb0d3f2a9d1cea9df9b3"], "node": "666b6a2a97ba0729c43250ab4e357ec666f3b9bb", "parents": ["1e4bfe5a33c0ac9946141d53891a00faa69e308d"], "tags": []}], "date": 1779160100, "git_changesets": ["872ac2c8e47afc41be00b21d4f82f988d5bd7341"], "user": "rvandermeulen@mozilla.com"}, "1183": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003