Handler.cpp", "dom/media/ChannelMediaResource.cpp", "dom/security/nsHTTPSOnlyStreamListener.cpp", "dom/xhr/XMLHttpRequestMainThread.cpp", "dom/xslt/xslt/txMozillaStylesheetCompiler.cpp", "image/SVGDocumentWrapper.cpp", "image/VectorImage.cpp", "image/decoders/icon/win/nsIconChannel.cpp", "image/imgLoader.cpp", "layout/style/StreamLoader.cpp", "modules/libjar/nsJARChannel.cpp", "modules/libjar/zipwriter/nsDeflateConverter.cpp", "modules/libjar/zipwriter/nsZipDataStream.cpp", "modules/libjar/zipwriter/nsZipWriter.cpp", "netwerk/base/nsAsyncStreamCopier.cpp", "netwerk/base/nsBaseChannel.cpp", "netwerk/base/nsIncrementalDownload.cpp", "netwerk/base/nsIncrementalStreamLoader.cpp", "netwerk/base/nsRequestObserverProxy.cpp", "netwerk/base/nsSimpleStreamListener.cpp", "netwerk/base/nsStreamListenerTee.cpp", "netwerk/base/nsStreamLoader.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/protocol/http/EarlyHintPreloader.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpTransactionParent.cpp", "netwerk/protocol/http/OpaqueResponseUtils.cpp", "netwerk/protocol/http/ParentChannelListener.cpp", "netwerk/protocol/http/TRRServiceChannel.cpp", "netwerk/protocol/viewsource/nsViewSourceChannel.cpp", "netwerk/streamconv/converters/nsIndexedToHTML.cpp", "netwerk/streamconv/converters/nsMultiMixedConv.cpp", "parser/prototype/PrototypeDocumentParser.cpp", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp", "toolkit/components/extensions/webrequest/StreamFilterParent.cpp", "uriloader/base/nsURILoader.cpp", "uriloader/exthandler/ExternalHelperAppChild.cpp", "uriloader/exthandler/ExternalHelperAppParent.cpp", "uriloader/preload/FetchPreloader.cpp", "uriloader/preload/gtest/TestFetchPreloader.cpp"], "git_node": "2e52cfd735bc505c8633cd2a251f6b15c76ea985", "git_parents": ["2ae993b11742e737c96c283c9beff311a00e27e9"], "node": "2f7b06710562b20796dad2fef8e2db4fa7af8700", "parents": ["8c909de9d88625181597be57f87a2ccba6c4de2f"], "tags": []}], "date": 1780317