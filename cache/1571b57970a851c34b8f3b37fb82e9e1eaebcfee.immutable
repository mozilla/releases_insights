"pushes": {"114": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 28738f45597b736e5689c199131d5da9ae0a6cec with FIREFOX_102_5_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "3ee2e40921c5d947a8f07c2faff221edaf13a029", "parents": ["28738f45597b736e5689c199131d5da9ae0a6cec"], "tags": []}], "date": 1667855796, "git_changesets": [null], "user": "ffxbld"}, "115": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "8acd04d80e13a9cc9d4d0e51297d2fba4c2a9abe", "parents": ["3ee2e40921c5d947a8f07c2faff221edaf13a029"], "tags": []}], "date": 1668440338, "git_changesets": [null], "user": "ffxbld-merge"}, "116": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 28738f45597b736e5689c199131d5da9ae0a6cec with FIREFOX_102_5_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "8ed93af520aab8007216fedbf66a771e3fbd1c62", "parents": ["8acd04d80e13a9cc9d4d0e51297d2fba4c2a9abe"], "tags": []}], "date": 1668520511, "git_changesets": [null], "user": "ffxbld"}, "117": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1793923 - stop pinning the hg.mozilla.org certificate in docker-worker tasks. r=releng-reviewers,gabriel a=release DONTBUILD\n\nThis way hg can verify that the cert chains to a trusted root CA, and we\ndon't have to pin it by fingerprint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158748", "files": ["taskcluster/gecko_taskgraph/transforms/job/run_task.py"], "git_node": null, "git_parents": [null], "node": "b4cceead07e432fa0abda97b5927b48fd9028e45", "parents": ["8ed93af520aab8007216fedbf66a771e3fbd1c62"], "tags": []}], "date": 1668523778, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "118": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162279", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "429eec1c3288fedd92bbe8f7b7b6a4a17f14dfa8", "parents": ["b4cceead07e432fa0abda97b5927b48fd9028e45"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 1798976 - [ci] Update URL for fetch-zlib-1.2.11. r=glandium, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161188", "files": ["taskcluster/ci/fetch/toolchains.yml"], "git_node": null, "git_parents": [null], "node": "6edf91cdb7cc46ee5e7336303bf8d0da938f171d", "parents": ["429eec1c3288fedd92bbe8f7b7b6a4a17f14dfa8"], "tags": []}, {"author": "Kai Engert \u003ckaie@kuix.de\u003e", "branch": "default", "desc": "Bug 1797468 - Mozilla 102 should require NSS 3.79.2. r=bbeurdouche UPGRADE_NSS_RELEASE a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161566", "files": ["build/moz.configure/nss.configure", "security/nss/TAG-INFO", "security/nss/automation/release/nspr-version.txt", "security/nss/coreconf/coreconf.dep", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "49f28a04b2ef023df4e9e4fbaf62ca0d76443e12", "parents": ["6edf91cdb7cc46ee5e7336303bf8d0da938f171d"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1782988 - Avoid build bustage when building against glibc 2.36 or newer. r+a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153716", "files": ["ipc/chromium/src/third_party/libevent/README.mozilla", "ipc/chromium/src/third_party/libevent/linux/event2/event-config.h"], "git_node": null, "git_parents": [null], "node": "c72aa6841930e32d37d8e8a6e1a45b9d5e45b3a5", "parents": ["49f28a04b2ef023df4e9e4fbaf62ca0d76443e12"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1782988 - Fix use of arc4random_buf use in ping.cpp. r=gsvelto, a=RyanVM\n\nThe code was probably never built before glibc 2.36, because before\nthat, only Android and some BSDs had arc4random_buf, but none of those\nactually built this code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154024", "files": ["toolkit/crashreporter/client/ping.cpp"], "git_node": null, "git_parents": [null], "node": "d138cc8a7eef7d5c3ecd4785aff5597f7070b1b9", "parents": ["c72aa6841930e32d37d8e8a6e1a45b9d5e45b3a5"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1799057 - Don't allow allocations sizes larger than isize::MAX in vec_try_extend. r=kinetik, a=RyanVM\n\nOn ESR, we have a version of fallible_collections that doesn't have the\nrust_1_57 feature, and newer versions that do also pull a new version\nof hashbrown, which is an heavy weight change (and would create a\nduplicate of hashbrown).\n\nInstead, backport https://github.com/vcombey/fallible_collections/pull/31/commits/f26cad643c852d6b31f0287a517a88d6a0c5b6ac\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161236", "files": ["Cargo.lock", "Cargo.toml", "third_party/rust/fallible_collections/src/vec.rs"], "git_node": null, "git_parents": [null], "node": "83fd4c934380d8c103220d8d6bae8b7714cbe572", "parents": ["d138cc8a7eef7d5c3ecd4785aff5597f7070b1b9"], "tags": []}], "date": 1668694896, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "119": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162550", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6d89f78907614885543d4706f08e159fcd231e8e", "parents": ["83fd4c934380d8c103220d8d6bae8b7714cbe572"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1799748 - Backport fix for libpixman CVE-2022-44638. r=jfkthame, a=dsmith\n\nBackport of upstream commit:\nhttps://gitlab.freedesktop.org/pixman/pixman/-/commit/a1f88e842e0216a5b4df1ab023caebe33c101395\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161624", "files": ["gfx/cairo/libpixman/src/pixman-trap.c"], "git_node": null, "git_parents": [null], "node": "47feff550f43c0c81bb1cb3574c0808e461a1f10", "parents": ["6d89f78907614885543d4706f08e159fcd231e8e"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1797235 - Implement WPT expectation. r=necko-reviewers,valentin, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160638", "files": ["netwerk/cookie/CookieCommons.cpp", "netwerk/cookie/CookieCommons.h", "netwerk/cookie/CookieService.cpp", "testing/web-platform/meta/cookies/value/value-ctl.html.ini"], "git_node": null, "git_parents": [null], "node": "80eeeeddbf7fd876255fed498677d859126a8749", "parents": ["47feff550f43c0c81bb1cb3574c0808e461a1f10"], "tags": []}, {"author": "Nicolai Kasper \u003cnicolai@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1746139 - Keeping filename ending intact when using windows with events like drag and drop. r=cmartin, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141941", "files": ["widget/windows/nsDataObj.cpp"], "git_node": null, "git_parents": [null], "node": "9d361299a3ab3ec302742f472c28897083044173", "parents": ["80eeeeddbf7fd876255fed498677d859126a8749"], "tags": []}], "date": 1669042720, "git_changesets": [null, null, null, null], "user": "dsmith@mozilla.com"}, "120": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1801775 - Work around Debian Jessie GPG key being expired. r=jcristau, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162694", "files": ["taskcluster/docker/debian-raw/Dockerfile", "taskcluster/docker/debian-raw/gpgvnoexpkeysig", "taskcluster/scripts/misc/build-sysroot.sh"], "git_node": null, "git_parents": [null], "node": "f19c58701abd6a2e8b715ef6f39678f822e30cdd", "parents": ["9d361299a3ab3ec302742f472c28897083044173"], "tags": []}], "date": 1669169203, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "121": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1797280 - Fix windows 7 selectors to avoid overriding fullscreentoolbar rules. r=dao, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162115", "files": ["browser/themes/windows/browser.css"], "git_node": null, "git_parents": [null], "node": "067fcde761dfc