nsInputStreamPump.cpp", "netwerk/base/nsInputStreamPump.h"], "git_node": null, "git_parents": [null], "node": "38b6d5e70b5b68cefacf09c6cdff7c4ddc794e6f", "parents": ["f95398ef5882c793105bee320481d4400d6d6829"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1797370 - Do not access nsInputStream::mListener without holding mutex. r=jesup, a=RyanVM", "files": ["netwerk/base/nsInputStreamPump.cpp", "netwerk/base/nsInputStreamPump.h"], "git_node": null, "git_parents": [null], "node": "813db5dba1234f5d21007e52e698f468e6ee46bf", "parents": ["38b6d5e70b5b68cefacf09c6cdff7c4ddc794e6f"], "tags": []}], "date": 1669671934, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "125": {"changesets": [{"author": "Butkovits Atila \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 2a865fc9f258 (bug 1773259) for causing Hazard failures. a=backout", "files": ["build/moz.configure/bindgen.configure", "gfx/webrender_bindings/webrender_ffi.h"], "git_node": null, "git_parents": [null], "node": "9b2625d4969500aa892ae6790e46adb3db7af7ea", "parents": ["813db5dba1234f5d21007e52e698f468e6ee46bf"], "tags": []}], "date": 1669673398, "git_changesets": [null], "user": "abutkovits@mozilla.com"}, "126": {"changesets": [{"author": "Mike Hommey \u003cmh@glandium.org\u003e", "branch": "default", "desc": "Bug 1773259 - Work around build failure with newer cbindgen. r=ahochheiden, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162262", "files": ["build/moz.configure/bindgen.configure", "gfx/webrender_bindings/webrender_ffi.h"], "git_node": null, "git_parents": [null], "node": "7ba2b486b22e3f65dd736cd9ed77da5a782b54b2", "parents": ["9b2625d4969500aa892ae6790e46adb3db7af7ea"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1801102 - Handle corrupted JAR files r=jesup, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162392", "files": ["modules/libjar/nsZipArchive.cpp", "modules/libjar/test/unit/data/test_1801102.jar", "modules/libjar/test/unit/test_corrupt_1801102.js", "modules/libjar/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "9968c9743e6aa71d64fefb57aff9242bebb801d9", "parents": ["7ba2b486b22e3f65dd736cd9ed77da5a782b54b2"], "tags": []}], "date": 1669779331, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "127": {"changesets": [{"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1768190 - Forbid same tex unit different sampler types even if unbound. r=lsalzman, a=RyanVM\n\nPreviously, we checked this but only if there was a texture bound to the\ntex unit. However technically we're supposed to check regardless. ANGLE\nand Mesa both do, which causes this error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153422", "files": ["dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextDraw.cpp", "dom/canvas/WebGLContextUtils.cpp", "dom/canvas/WebGLProgram.h", "dom/canvas/WebGLTypes.h", "dom/canvas/test/webgl-mochitest/mochitest.ini", "dom/canvas/test/webgl-mochitest/test_tex_unit_different_sampler_types.html"], "git_node": null, "git_parents": [null], "node": "3bc5d1b9765f72dd18f0288fe576c9a15d1cbb95", "parents": ["9968c9743e6aa71d64fefb57aff9242bebb801d9"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1795372 - Keepalive mNotLost within FuncScope. r=lsalzman, a=RyanVM\n\nAlso remove unused FuncScopeId.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159428", "files": ["dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ClientWebGLContext.h", "dom/canvas/ClientWebGLExtensions.h", "dom/canvas/WebGLTypes.h"], "git_node": null, "git_parents": [null], "node": "76cc8c96f4a8fcf8db96a64b4afb3113b6d49c1c", "parents": ["3bc5d1b9765f72dd18f0288fe576c9a15d1cbb95"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1795372 - Remove redundant keepalives. r=lsalzman, a=RyanVM\n\nNow that FuncScope keepalives mNotLost, individual functions don't need\nto.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159431", "files": ["dom/canvas/ClientWebGLContext.cpp"], "git_node": null, "git_parents": [null], "node": "7020896e8c7cd82ec1963b88aca8ab4b6539494f", "parents": ["76cc8c96f4a8fcf8db96a64b4afb3113b6d49c1c"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1797068 - Ensure GPU process gets disabled after certain number of unstable launch attempts. r=aosmond, a=RyanVM\n\nThis was accidentally broken in bug 1768197.\n\nDepends on D160042\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160043", "files": ["gfx/ipc/GPUProcessManager.cpp"], "git_node": null, "git_parents": [null], "node": "80a6a6bad68787902204871474d3977145d014be", "parents": ["7020896e8c7cd82ec1963b88aca8ab4b6539494f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1798098: Prevent a11y tree walks by the Suggested Actions feature in Windows 11 22H2. r=nlapre, a=RyanVM\n\nThe patches in bug 1774285 prevent Suggested Actions a11y tree walking in most cases.\nHowever, when a11y is already enabled, we can still get into a tree walk that triggers a hang when using Copy Phone Number on a tel: link.\nThis is because there is no selected text in this case, so Suggested Actions falls back to walking the tree.\n\nThis patch prevents these walks by returning 1 from get_nSelections within a timeout period after setting the clipboard, indicating that there is a selection when there isn't really.\nUnfortunately, even though we lie about the selection count, the selection reported by get_selection still isn't valid.\nFixing that for a selection deep in the tree is difficult; we don't have enough information in the parent process to fake the selection properly.\nThus, Suggested Actions might then do a normal tree walk from the document, so we also return a 0 child count within this timeout period.\nWith the cache disabled, in-process Windows clients access content process Accessibles using COM proxies.\nWe must therefore hack get_nSelections and get_accChildCount in AccessibleHandler, which wraps these COM proxies for in-process clients.\nThis means that Firefox needs to be installed in order for this to work, since AccessibleHandler can only be used with an installed copy.\nA11y performance without the cache is very poor without AccessibleHandler anyway.\nBecause AccessibleHandler is an entirely separate dll, we need to duplicate the suppression logic in AccessibleHandlerControl, which can be accessed by both Gecko and AccessibleHandler.\n\nAfter all these attempts on the document, Suggested Actions falls back to walking from the root.\nTo prevent that walk, we return 0 for the child count on the root MsaaAccessible within the timeout period.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160746", "files": ["accessible/ipc/win/handler/AccessibleHandler.cpp", "accessible/ipc/win/handler/AccessibleHandlerControl.cpp", "accessible/ipc/win/handler/AccessibleHandlerControl.h", "accessible/ipc/win/handler/HandlerData.idl", "accessible/windows/msaa/AccessibleWrap.cpp", "accessible/windows/msaa/AccessibleWrap.h", "accessible/windows/msaa/Compatibility.cpp", "accessible/windows/msaa/MsaaAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "8404850ef31cdd5d2a3603f328b0d9b841928a1d", "parents": ["80a6a6bad68787902204871474d3977145d014be"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1787315, starting a new load after reload() should take precedence, r=peterv,ochameau a=RyanVM\n\nThe devtools test reloads a page twice in a row and depending on timing it isn't guaranteed that it leads to two requests anymore.\nThat test seems to fail on debug builds every now and then. The test itself expects 1 or more requests, but then assumes later that there\nare at least 2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160573", "files": ["devtools/client/netmonitor/src/har/test/browser_net_har_copy_all_as_har.js", "docshell/base/nsDocShell.cpp", "docshell/test/mochitest/file_load_during_reload.html", "docshell/test/mochitest/mochitest.ini", "docshell/test/mochitest/test_load_during_reload.html"], "git_node": null, "git_parents": [null], "node": "a3be4e20b0dac724c32bd16b6cbedab0101f7980", "parents": ["8404850ef31cdd5d2a3603f328b0d9b841928a1d"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1669836 - Bail out from modal dialog during shutdown. r=emilio, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161038", "files": ["toolkit/components/windowwatcher/nsWindowWatcher.cpp", "xpfe/appshell/AppWindow.cpp"], "git_node": null, "git_parents": [null], "node": "a4167befb70526e788c4eba9ee12925c764d40a0", "parents": ["a3be4e20b0dac724c32bd16b6cbedab0101f7980"], "tags": []}], "date": 1669818944, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "128": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1633019 - Crash in [@ mozilla::PresShell::EventHandler::MaybeFlushThrottledStyles], r=masayuki a=RyanVM\n\nGetViewManager() may return null if the relevant presshell is being destroyed.\nThis is a guess fix, but the crash reports seem to hint about this issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161587", "files": ["layout/base/PresShell.cpp"], "git_node": null, "git_parents": [null], "node": "db6a4af87843519ecf8ce9d1285e38fafc484181", "parents": ["a4167befb70526e788c4eba9ee12925c764d40a0"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774111 - Initialize AutoJAPI from the native global in the module loader r=yulia, a=RyanVM\n\nWe're getting a bunch of crashes related to initializing AutoJSAPI from a\nJSObject pointer that turns out to be null. That overload of Init() gets the\nnative global from the JSObject and since we already have a native global in\nthe module loader we can use the overload that takes that instead. This\noverload does a null check so we will catch the case where the global is null\n(although that should also not happen).\n\nThis might just move crashes elsewhere but it's a reasonable tidyup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162386", "files": ["js/loader/ModuleLoaderBase.cpp", "js/loader/ModuleLoaderBase.h"], "git_node": null, "git_parents": [null], "node": "c4898a852b12a498ae71e53d6751a5b4214b9a1e", "parents": ["db6a4af87843519ecf8ce9d1285e38fafc484181"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774111 - Check for already-completed request in ModuleLoaderBase::FinishDynamicImport r=yulia, a=RyanVM\n\nI've looked at this for a while and still don't know how this can happen but it\ndoes seem reasonable to add a check here that we haven't already completed the\nrequest.\n\nDepends on D162386\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162387", "files": ["js/loader/ModuleLoaderBase.cpp"], "git_node": null, "git_parents": [null], "node": "f3e233eefb5599b66d0c552a3cd6884f11656411", "parents": ["c4898a852b12a498ae71e53d6751a5b4214b9a1e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794647 - Pick up specialized cflags flags when processing BUILD.gn files. r=glandium, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161697", "files": ["python/mozbuild/mozbuild/gn_processor.py"], "git_node": null, "git_parents": [null], "node": "b94e16db57bacfe29a9d63a3816d75549f465c88", "parents": ["f3e233eefb5599b66d0c552a3cd6884f11656411"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794647 - Revert -fobjc-arc hack from Bug 1654112. r=mjf, a=RyanVM", "files": ["third_party/libwebrtc/BUILD.gn"], "git_node": null, "git_parents": [null], "node": "2b95456189d286251194e0c87839e9521aef148e", "parents": ["b94e16db57bacfe29a9d63a3816d75549f465c88"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794647 - Generate libwebrtc build files. r=mjf, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161699", "files": ["third_party/libwebrtc/modules/desktop_capture/desktop_capture_objc_gn/moz.build", "third_party/libwebrtc/rtc_base/system/cocoa_threading_gn/moz.build"], "git_node": null, "git_parents": [null], "node": "89a0242b384ce6cd57fd31bdbc57279ad7e98d24", "parents": ["2b95456189d286251194e0c87839e9521aef148e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794647 - Avoid leaks with a NSAutoReleasePool in macOS desktop capture. r=mjf, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161700", "files": ["dom/media/systemservices/video_engine/desktop_capture_impl.cc"], "git_node": null, "git_parents": [null], "node": "5043d7345f7195ef4f954bea736e6eb3341bfb31", "parents": ["89a0242b384ce6cd57fd31bdbc57279ad7e98d24"], "tags": []}], "date": 1669825040, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "129": {"changesets": [{"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1767792 - [devtools] Wait for network event updates to complete. r=nchevobbe, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152514", "files": ["devtools/client/netmonitor/src/har/test/browser_net_har_copy_all_as_har.js"], "git_node": null, "git_parents": [null], "node": "7381c6f18a5aabea0f2fea6afd661856e8d6b70a", "parents": ["5043d7345f7195ef4f954bea736e6eb3341bfb31"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1790013 - [devtools] Fix browser_net_har_copy_all_as_har.js intermitent. r=bomsy, a=test-only\n\nWhen reloading twice, we weren't waiting for the two reload requests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157093", "files": ["devtools/client/netmonitor/src/har/test/browser_net_har_copy_all_as_har.js"], "git_node": null, "git_parents": [null], "node": "1df757e2e3f93139c0db74d98ab7780fd69e3785", "parents": ["7381c6f18a5aabea0f2fea6afd661856e8d6b70a"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1764318 - Add more test for fullscreen; r=smaug, a=test-only", "files": ["browser/base/content/test/fullscreen/browser.ini", "browser/base/content/test/fullscreen/browser_fullscreen_window_open.js", "browser/base/content/test/fullscreen/open_and_focus_helper.html"], "git_node": null, "git_parents": [null], "node": "176961fea226c8d69708da0eb793b7ee66a11bcd", "parents": ["1df757e2e3f93139c0db74d98ab7780fd69e3785"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1775039 - Do not crash when failing to set Breakpad's exception handler thread's name. r=KrisWright, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161642", "files": ["toolkit/crashreporter/breakpad-client/windows/handler/exception_handler.cc"], "git_node": null, "git_parents": [null], "node": "897e0ff79060c532b746bc713d03067994ee4bb3", "parents": ["176961fea226c8d69708da0eb793b7ee66a11bcd"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1802395, remove an unneeded member variable, r=edgar, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D163209", "files": ["xpcom/base/CycleCollectedJSContext.cpp", "xpcom/base/CycleCollectedJSContext.h"], "git_node": null, "git_parents": [null], "node": "e36df59f863bd3ec7c5ce60ffbca673dc65f2b15", "parents": ["897e0ff79060c532b746bc713d03067994ee4bb3"], "tags": []}], "date": 1669838849, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "130": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D163573", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "2bb258a61b60d69aceaa546a0bd4585634a3fc67", "parents": ["e36df59f863bd3ec7c5ce60ffbca673dc65f2b15"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1803516: Update time zone data to tzdata2022g. r=gregtatum, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D163570", "files": ["config/external/icu/data/icudt71l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js"], "git_node": null, "git_parents": [null], "node": "31acb0355a4b64d6532d87ba9e3ceb602568e221", "parents": ["2bb258a61b60d69aceaa546a0bd4585634a3fc67"], "tags": []}, {"author": "Kelsey Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779800 - Fix WebGL instancing in some cases on Mac. r=lsalzman, a=RyanVM\n\nThis reverts the code that would collapse DrawElements to DrawArrays in some cases,\nbecause it was not a correct transform in some cases.\n\nInstead, we need to *always* keep around a cpu copy of the index buffer,\nso that we can figure out how many fakeAttrib0 verts we need.\n\nFinally, in order to correct for the bug where Mac offsets the base instance by `first` in DrawArrays,\nwe need to (temporarily) patch vertexAttribPointer offsets for any call with non-zero `first`.\n(This can be disabled via MOZ_WEBGL_WORKAROUND_FIRST_AFFECTS_INSTANCE_ID=0)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D163524", "files": ["dom/canvas/WebGLBuffer.cpp", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextDraw.cpp", "dom/canvas/WebGLContextValidate.cpp", "dom/canvas/WebGLProgram.cpp", "dom/canvas/WebGLProgram.h", "dom/canvas/WebGLShaderValidator.cpp", "dom/canvas/WebGLShaderValidator.h", "dom/canvas/WebGLVertexArray.h", "dom/canvas/WebGLVertexArrayFake.cpp", "dom/canvas/test/webgl-conf/checkout/conformance2/rendering/00_test_list.txt", "dom/canvas/test/webgl-conf/checkout/conformance2/rendering/builtin-vert-attribs.html", "dom/canvas/test/webgl-conf/checkout/js/webgl-test-utils.js", "dom/canvas/test/webgl-conf/cherry_picks.txt", "dom/canvas/test/webgl-conf/generated-mochitest.ini", "dom/canvas/test/webgl-conf/generated/test_2_conformance2__rendering__builtin-vert-attribs.html", "dom/canvas/test/webgl-conf/mochitest-errata.ini", "gfx/thebes/gfxEnv.h", "security/sandbox/chromium-shim/sandbox/win/permissionsService.h"], "git_node": null, "git_parents": [null], "node": "bfcd0ce4da09ba2aa4de4e65643d6af757152d31", "parents": ["31acb0355a4b64d6532d87ba9e3ceb602568e221"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779040 - Don't update DataStorage if HSTS data hasn't significantly changed. r=jschanck, a=RyanVM\n\nWhen gecko encounters multiple responses from the same host with substantially\nthe same HSTS information, the implementation shouldn't update DataStorage,\nbecause that can cause unnecessary writes. \"Substantially the same\" means the\ninformation is identical except for the expiration time, which can be up to a\nday different.", "files": ["security/manager/ssl/nsSiteSecurityService.cpp", "security/manager/ssl/tests/unit/test_sss_savestate.js"], "git_node": null, "git_parents": [null], "node": "448e55025b51bc1e3e3246ae66fd6ea98b9883d6", "parents": ["bfcd0ce4da09ba2aa4de4e65643d6af757152d31"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1791495 - Check for zero sqrt on ARM. r=jrmuizel, a=RyanVM\n\nFor SWGL on ARM, we implement sqrt(N) as N * inversesqrt(N). This means we don't\nproperly handle zero unless we explicitly check for it. Otherwise, a NaN ends up\ngetting produced erroneously.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161107", "files": ["gfx/wr/swgl/src/glsl.h"], "git_node": null, "git_parents": [null], "node": "afca188a6ea57d226a3d7acc04726bf747b9f43b", "parents": ["448e55025b51bc1e3e3246ae66fd6ea98b9883d6"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1799156 - Filter unknown DataTransferItem flavors. r=nika, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D163443", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/events/DataTransfer.cpp", "dom/events/DataTransfer.h", "dom/events/RemoteDragStartData.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/ContentParent.cpp", "widget/nsClipboardProxy.cpp"], "git_node": null, "git_parents": [null], "node": "48049cc5b3a854e027d8e3812fcaa07ec3670443", "parents": ["afca188a6ea57d226a3d7acc04726bf747b9f43b"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1799156 - Test for writing unknown clipboard type. r=nika, a=RyanVM\n\nBased on https://phabricator.services.mozilla.com/D160944\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161900", "files": ["dom/ipc/tests/browser.ini", "dom/ipc/tests/browser_child_clipboard_restricted.js"], "git_node": null, "git_parents": [null], "node": "001b8447fd9c5485bd049b51eb76ad27bf9b6217", "parents": ["48049cc5b3a854e027d8e3812fcaa07ec3670443"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 1781167 - Allow stacking calls to Add/RemoveVsyncDispatcher so that we survive the sequence Add,Add,Remove. r=jrmuizel, a=RyanVM\n\nThis fixes a bug which caused Firefox windows to become frozen after some time.\n\nFull credit goes to Susan and RandyS for bisecting the regressor of this bug, and\nto Jeff DeFouw for debugging the issue and finding the cause.\n\nThe bug here is a \"state race\" between the VsyncDispatcher state and\nthe VsyncSource state. Both are protected by locks, and the code that\nruns in those locks respectively can see a different orders of invocations.\n\nVsyncDispatcher::UpdateVsyncStatus does this thing where it updates its state inside\na lock, gathers some information, and then calls methods on VsyncSource *outside* the lock.\nSince it calls those methods outside the lock, these calls can end up being executed\nin a different order than the state changes were observed inside the lock.\n\nHere's the bad scenario in detail, with the same VsyncDispatcher being used from\ntwo different threads, turning a Remove,Add into an Add,Remove:\n\n```\nThread A                                       Thread B\n\nVsyncDispatcher::UpdateVsync\n |\n |----\u003e Enter VsyncDispatcher lock\n |    |                                         VsyncDispatcher::UpdateVsync\n |    |   state-\u003emIsObservingVsync = false       |\n |    |   (We want to stop listening)            |\n |    |                                          |\n |\u003c---- Exit VsyncDispatcher lock                |\n |                                               |----\u003e Enter VsyncDispatcher lock\n |                                               |    |\n |                                               |    |   state-\u003emIsObservingVsync = true\n |                                               |    |   (We want to start listening)\n |                                               |    |\n |                                               |\u003c----  Exit VsyncDispatcher lock\n |                                               |\n |                                               |----\u003e Enter VsyncSource::AddVsyncDispatcher\n |                                               |    |\n |                                               |    |----\u003e Enter VsyncSource lock\n |                                               |    |    |\n |                                               |    |    |  state-\u003emDispatchers.Contains(aVsyncDispatcher)\n |----\u003e VsyncSource::RemoveVsyncDispatcher       |    |    |  VsyncDispatcher already present in list, not doing anything\n |    |                                          |    |    |\n |    |                                          |    |\u003c---- Exit VsyncSource lock\n |    |                                          |    |\n |    |                                          |\u003c---- Exit VsyncSource::AddVsyncDispatcher\n |    |----\u003e Enter VsyncSource lock\n |    |    |\n |    |    |  Removing aVsyncDispatcher from state-\u003emDispatchers\n |    |    |\n |    |\u003c---- Exit VsyncSource lock\n |    |\n |\u003c---- Exit VsyncSource::AddVsyncDispatcher\n```\n\nNow the VsyncDispatcher thinks it is still observing vsync, but it is\nno longer registered with the VsyncSource.\n\nThis patch makes it so that two calls to AddVsyncDispatcher followed by one call\nto RemoveVsyncDispatcher result in the VsyncDispatcher still being registered.\nAddVsyncDispatcher is no longer idempotent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162760", "files": ["gfx/thebes/VsyncSource.cpp", "gfx/thebes/VsyncSource.h"], "git_node": null, "git_parents": [null], "node": "8e4d1da64b643c1feed8db568bf32986debde929", "parents": ["001b8447fd9c5485bd049b51eb76ad27bf9b6217"], "tags": []}], "date": 1669910562, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "131": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D163822", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "2369ed4fad7a7c8649d8d7d10e8c55c259849f60", "parents": ["8e4d1da64b643c1feed8db568bf32986debde929"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1791033, avoid crash by computing the extension's byte length correctly and truncate the filename's extension when it is too long, r=gsvelto,jfkthame, a=RyanVM", "files": ["uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/tests/unit/test_filename_sanitize.js"], "git_node": null, "git_parents": [null], "node": "bb83c162957ee1638695b3f47d7e88c584013e49", "parents": ["2369ed4fad7a7c8649d8d7d10e8c55c259849f60"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1798780, ensure we don't evict the current frameloader, r=peterv a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D163497", "files": ["docshell/shistory/nsSHistory.cpp", "docshell/test/browser/browser.ini", "docshell/test/browser/browser_bug1798780.js"], "git_node": null, "git_parents": [null], "node": "5cf04e23dbbf3d0cea45dca214dea8df1322ea00", "parents": ["bb83c162957ee1638695b3f47d7e88c584013e49"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1786188. r=Gijs,dimi, a=RyanVM", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/ApplicationReputation.h", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h", "xpcom/io/nsLocalFileUnix.cpp"], "git_node": null, "git_parents": [null], "node": "f9180d5446f2b219dc06f2eafc3e14e987266f7a", "parents": ["5cf04e23dbbf3d0cea45dca214dea8df1322ea00"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1801184 - Update Widevine fallback downloader URLs for 4.10.2557.0. r=media-playback-reviewers,alwu, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D162332", "files": ["toolkit/content/gmp-sources/widevinecdm.json"], "git_node": null, "git_parents": [null], "node": "72b501d7159eb634a961e27157a3af58360a0b74", "parents": ["f9180d5446f2b219dc06f2eafc3e14e987266f7a"], "tags": ["FIREFOX_102_6_0esr_BUILD1", "FIREFOX_102_6_0esr_RELEASE"]}], "date": 1670249955, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}}
}";