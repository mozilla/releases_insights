d3065b0bb02545b629f13485b3fb95ad1d7"], "tags": []}], "date": 1772528070, "git_changesets": ["2441dbbb858a113bf385bb2e05d4c5f6aedfa75a"], "user": "pchevrel@mozilla.com"}, "542": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2012791 - Fix CheckedInt overflow in AudioData::CopyTo  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285612\n", "files": ["dom/media/webcodecs/AudioData.cpp"], "git_node": "37a14264adeb0024e301bfc7531d17d3fb866459", "git_parents": ["2441dbbb858a113bf385bb2e05d4c5f6aedfa75a"], "node": "477986cad943c7e153ec10aac4d46233a013b24f", "parents": ["6d72d2f69bccbf71949e5b2208c281c632aeb427"], "tags": []}], "date": 1772528564, "git_changesets": ["37a14264adeb0024e301bfc7531d17d3fb866459"], "user": "pchevrel@mozilla.com"}, "543": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2018592: Combine code paths in ResizableArrayBufferObject::copy.  a=pascalc\n\nThis code path is only used for small buffers, so let's simplify it a bit.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284448\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285444\n", "files": ["js/src/vm/ArrayBufferObject.cpp"], "git_node": "059996e56f7901cfa06a48fe6ce6e51056a1756e", "git_parents": ["37a14264adeb0024e301bfc7531d17d3fb866459"], "node": "6ddffccdf8d95bf8fdf1f1722ff4ea862f84e5bc", "parents": ["477986cad943c7e153ec10aac4d46233a013b24f"], "tags": []}], "date": 1772528806, "git_changesets": ["059996e56f7901cfa06a48fe6ce6e51056a1756e"], "user": "pchevrel@mozilla.com"}, "544": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2017512 - Sanity check adopted stylesheet setters / deleters. r=edgar,#style,#layout a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D284097\n", "files": ["dom/base/DocumentOrShadowRoot.cpp"], "git_node": "eac31edbd2fe0414ddcc6eb70a44478462f440d2", "git_parents": ["059996e56f7901cfa06a48fe6ce6e51056a1756e"], "node": "4948e84f4af6b92c995635c99edae5808e2b64e3", "parents": ["6ddffccdf8d95bf8fdf1f1722ff4ea862f84e5bc"], "tags": []}], "date": 1772531368, "git_changesets": ["eac31edbd2fe0414ddcc6eb70a44478462f440d2"], "user": "pchevrel@mozilla.com"}, "545": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1999970 - Retrofit a Skipped callback on top of GMP encoder API using input frame destroy calls.  a=pascalc\n\nThis allows the GMP client (in this case the WebRTC GMP encoder) to know whether\nthe encoder plugin decided to drop a frame. This lets us avoid flushing the\nencoder with more encode jobs than it can handle.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272613\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276213\n", "files": ["dom/media/gmp/GMPSharedMemManager.h", "dom/media/gmp/GMPVideoEncoderChild.cpp", "dom/media/gmp/GMPVideoEncoderChild.h", "dom/media/gmp/GMPVideoEncoderParent.cpp", "dom/media/gmp/GMPVideoEncoderParent.h", "dom/media/gmp/GMPVideoEncoderProxy.h", "dom/media/gmp/GMPVideoHost.cpp", "dom/media/gmp/GMPVideoi420FrameImpl.cpp", "dom/media/gmp/GMPVideoi420FrameImpl.h", "dom/media/gmp/PGMPVideoEncoder.ipdl", "dom/media/platforms/agnostic/gmp/GMPVideoEncoder.cpp", "dom/media/platforms/agnostic/gmp/GMPVideoEncoder.h", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.h"], "git_node": "d2e12963caada57476d579f956da5003561a9b11", "git_parents": ["eac31edbd2fe0414ddcc6eb70a44478462f440d2"], "node": "f1785c0711175b7ebff3d6ee84a7bca7e91f169e", "parents": ["4948e84f4af6b92c995635c99edae5808e2b64e3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1999970 - Handle dropped-frame callbacks in the GMP PEM.  a=pascalc\n\nThe OpenH264 encoder may silently drop a frame due to rate control.\nIf not handled in the GMP PEM, it may risk stalling waiting for an encoded frame\nthat never arrives.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D274755\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276214\n", "files": ["dom/media/platforms/agnostic/gmp/GMPVideoEncoder.cpp", "xpcom/base/ErrorList.py"], "git_node": "0c36aa86a48d4a88209b5e0dcb2ee23d099d17ee", "git_parents": ["d2e12963caada57476d579f956da5003561a9b11"], "node": "465363e6a20e0943ee8a17accb9e8e2985ed7871", "parents": ["f1785c0711175b7ebff3d6ee84a7bca7e91f169e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1992567 - Enforce a hard limit of 1 frame in flight in WebRTC GMP encoder.  a=pascalc\n\nThis avoids an ~unbounded memory leak when OpenH264 is not able to keep up with\nencoding in real-time.\n\nAlso report frame drops from Encode() upwards.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272451\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276215\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp"], "git_node": "51bfa08fe8ad8bad03d92bccf43be7fd236a3888", "git_parents": ["0c36aa86a48d4a88209b5e0dcb2ee23d099d17ee"], "node": "a65647ba2fd94bed00d5fbd7f04abe841915f1ff", "parents": ["465363e6a20e0943ee8a17accb9e8e2985ed7871"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2004850 - Clear WebRTC GMP encoder input image map on Release (from libwebrtc) and termination (from IPC).  a=pascalc\n\nThis covers some corner cases, for instance when libwebrtc releases the encoder\nwith a frame in flight, then re-uses it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D275605\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276216\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp"], "git_node": "d958fa389b25b8548dc93ef849da9d11a6d9baaa", "git_parents": ["51bfa08fe8ad8bad03d92bccf43be7fd236a3888"], "node": "9a55bd91f69ce574ca943009f128436f6ffc1df6", "parents": ["a65647ba2fd94bed00d5fbd7f04abe841915f1ff"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005729 - Write initial set of WebrtcGmpVideoEncoder gtests.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284650\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285679\n", "files": ["dom/media/gtest/TestWebrtcGmpCodec.cpp", "dom/media/gtest/moz.build"], "git_node": "2fd607794fb9a78aabe9289d5809d3d272399ba5", "git_parents": ["d958fa389b25b8548dc93ef849da9d11a6d9baaa"], "node": "86e83f3cdab808897b2ec2cdea8b881e0d007f43", "parents": ["9a55bd91f69ce574ca943009f128436f6ffc1df6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005729 - Unit test that GMP encoder input frames dropped by plugin are tracked.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284809\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285680\n", "files": ["dom/media/gmp-plugin-openh264/gmp-fake-openh264.cpp", "dom/media/gtest/TestWebrtcGmpCodec.cpp"], "git_node": "8c71d4f86517a6d417e6bde2ed11358461176794", "git_parents": ["2fd607794fb9a78aabe9289d5809d3d272399ba5"], "node": "b412e01cf99e4ee4646bc508633a9a5c82b71df4", "parents": ["86e83f3cdab808897b2ec2cdea8b881e0d007f43"], "tags": []}], "date": 1772532463, "git_changesets": ["d2e12963caada57476d579f956da5003561a9b11", "0c36aa86a48d4a88209b5e0dcb2ee23d099d17ee", "51bfa08fe8ad8bad03d92bccf43be7fd236a3888", "d958fa389b25b8548dc93ef849da9d11a6d9baaa", "2fd607794fb9a78aabe9289d5809d3d272399ba5", "8c71d4f86517a6d417e6bde2ed11358461176794"], "user": "pchevrel@mozilla.com"}, "546": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u