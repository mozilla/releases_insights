74918a4445c34e89305028ba714eabafe5e8b"], "node": "18864a3c5b9a775c37d0601fa07247e32cf7968f", "parents": ["a6482a418330c5e174cbb13f027380d3df25a132"], "tags": []}], "date": 1773249126, "git_changesets": ["78c14c97bb6a37f083727d0d711809de797f05a6"], "user": "rvandermeulen@mozilla.com"}, "576": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019302 - Cleanup Telemetry IPC.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287071\n", "files": ["toolkit/components/telemetry/core/ipc/TelemetryComms.h"], "git_node": "df13889c36d149702b05efaf6871f2bf75f51c25", "git_parents": ["78c14c97bb6a37f083727d0d711809de797f05a6"], "node": "a3930e967107c8db3eca644dbb76c41091209ae7", "parents": ["18864a3c5b9a775c37d0601fa07247e32cf7968f"], "tags": []}], "date": 1773249439, "git_changesets": ["df13889c36d149702b05efaf6871f2bf75f51c25"], "user": "rvandermeulen@mozilla.com"}, "577": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2003766 - [esr140] Make sure header array always holds the last value of the contentType header  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287086\n", "files": ["dom/base/MimeType.cpp", "dom/base/test/gtest/TestMimeType.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/nsHttpResponseHead.cpp", "netwerk/protocol/http/nsHttpResponseHead.h", "testing/web-platform/meta/fetch/content-type/response.window.js.ini", "testing/web-platform/meta/fetch/content-type/script.window.js.ini"], "git_node": "a40312ee2dcb30b3782a33d457648e7d98247bd5", "git_parents": ["df13889c36d149702b05efaf6871f2bf75f51c25"], "node": "ab21f97b1d87d3838bcb6f3a0e74ca47dccf753f", "parents": ["a3930e967107c8db3eca644dbb76c41091209ae7"], "tags": []}], "date": 1773252119, "git_changesets": ["a40312ee2dcb30b3782a33d457648e7d98247bd5"], "user": "pchevrel@mozilla.com"}, "578": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013560: Handle force return at yield opcodes  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283332\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287194\n", "files": ["js/src/debugger/Debugger.cpp", "js/src/jit-test/tests/debug/Frame-onStep-generator-resumption-04.js"], "git_node": "4bdc84018a4b1a3c2d816fa7b5f1dfa04c40caa4", "git_parents": ["a40312ee2dcb30b3782a33d457648e7d98247bd5"], "node": "b1383ef44abc7fd4d11e3067bd17d6daba91521f", "parents": ["ab21f97b1d87d3838bcb6f3a0e74ca47dccf753f"], "tags": []}], "date": 1773276407, "git_changesets": ["4bdc84018a4b1a3c2d816fa7b5f1dfa04c40caa4"], "user": "rvandermeulen@mozilla.com"}, "579": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015359 - Use MADV_FREE instead of MADV_FREE_REUSABLE + MADV_FREE_REUSE on MacOS.  a=RyanVM\n\nMacOS Tahoe has a bug where (very intermittently) pages can be zeroed by the kernel\nafter going through `madvise` with `MADV_FREE_REUSABLE` and then `MADV_FREE_REUSE`.\n\nThe fuzz bug triggers this issue in the JS shell and we've also seen an increase in crashes\non Mac after the release of Tahoe, with very similar signatures. I've been able to\nreproduce this with a stand-alone C++ test case and the issue has been reported to Apple.\n\nI haven't been able to reproduce this bug with `MADV_FREE` so this patch switches back to\nthat, reverting bug 1567366 and bug 1682947. Unfortunately this means our RSS numbers are\nlikely to increase.\n\nThe JIT code allocator also uses `MADV_FREE_REUSABLE` and `MADV_FREE_REUSE` but it's\nmore complex and it's not clear if it's affected the same way, so let's start with the\nGC memory allocator and see what the effect is on crash rates.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285226\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286611\n", "files": ["js/src/gc/Memory.cpp"], "git_node": "4b8faa68bcc3bfe2d3103f2adc0f0c9500947bfb", "git_parents": ["4bdc84018a4b1a3c2d816fa7b5f1dfa04c40caa4"], "node": "babcbc29c3fada76b4092e18219c5eb4ac04dbc4", "parents": ["b1383ef44abc7fd4d11e3067bd17d6daba91521f"], "tags": []}], "date": 1773276444, "git_changesets": ["4b8faa68bcc3bfe2d3103f2adc0f0c9500947bfb"], "user": "rvandermeulen@mozilla.com"}, "580": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2019309 - Use ContiguousEnumSerializer for necko ipdl params  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285413\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287180\n", "files": ["netwerk/protocol/http/PHttpChannelParams.h"], "git_node": "65e3d0dd101a8d5d902c8c25b6d7cd222fd1b66a", "git_parents": ["4b8faa68bcc3bfe2d3103f2adc0f0c9500947bfb"], "node": "0c41b6b6d98ea5ff9bfd2fc42f25ea6143e71892", "parents": ["babcbc29c3fada76b4092e18219c5eb4ac04dbc4"], "tags": []}], "date": 1773311205, "git_changesets": ["65e3d0dd101a8d5d902c8c25b6d7cd222fd1b66a"], "user": "pchevrel@mozilla.com"}, "581": {"changesets": [{"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2017643 - Prevent toggling RDM BrowsingContext flag from content processes. a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285125\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287293\n", "files": ["docshell/base/BrowsingContext.cpp"], "git_node": "6ffa1bc5154e5c90ce726d12761c25af77dcea01", "git_parents": ["65e3d0dd101a8d5d902c8c25b6d7cd222fd1b66a"], "node": "7a5b6dea379f95a879f1cb322f6387df012efaca", "parents": ["0c41b6b6d98ea5ff9bfd2fc42f25ea6143e71892"], "tags": []}], "date": 1773312389, "git_changesets": ["6ffa1bc5154e5c90ce726d12761c25af77dcea01"], "user": "pchevrel@mozilla.com"}, "582": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2017643 - Prevent toggling RDM BrowsingContext flag from content processes. a=pascalc\" DONTBUILD\n\nThis reverts commit 6ffa1bc5154e5c90ce726d12761c25af77dcea01.\n", "files": ["docshell/base/BrowsingContext.cpp"], "git_node": "55c18030ad6039e6ba90cab72d87d2498be1792f", "git_parents": ["6ffa1bc5154e5c90ce726d12761c25af77dcea01"], "node": "64858b9dca18e70ef2eb23bff599b01bf670fc3a", "parents": ["7a5b6dea379f95a879f1cb322f6387df012efaca"], "tags": []}], "date": 1773323638, "git_changesets": ["55c18030ad6039e6ba90cab72d87d2498be1792f"], "user": "rvandermeulen@mozilla.com"}, "583": {"changesets": [{"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2017643 - Prevent toggling RDM BrowsingContext flag from content processes. a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285125\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287293\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h"], "git_node": "6eae7527b7619cd8f66676101a09f9dd2574dd4a", "git_parents": ["55c18030ad6039e6ba90cab72d87d2498be1792f"], "node": "410012256df7e0abc52169ff746057f3b0475b3b", "parents": ["64858b9dca18e70ef2eb23bff599b01bf670fc3a"], "tags": []}], "date": 1773323723, "git_changesets": ["6eae7527b7619cd8f66676101a09f9dd2574dd4a"], "user": "rvandermeulen@mozilla.com"}, "584": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2017894: Make ImageBridgeParent::RecvUpdate skip duplicate operations.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286976\n", "files": ["gfx/layers/ipc/ImageBridgeParent.cpp"], "git_node": "62b13bec677f9bf66dce3e84f3aa1f35d29b65c3", "git_parents": 