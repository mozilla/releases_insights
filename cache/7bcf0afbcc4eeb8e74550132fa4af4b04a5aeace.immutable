eulen@mozilla.com"}, "593": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018379 - Refactor the mozilla::ErrorResult IPC serializer.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284442\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287291\n", "files": ["dom/bindings/BindingUtils.cpp", "dom/bindings/ErrorIPCUtils.h", "dom/bindings/ErrorResult.h"], "git_node": "3ab2fa2ca7b1dbea634d7206a6aa92990a80e810", "git_parents": ["b502d36068ae58168ae1832f4ba2b77d405386ff"], "node": "6189d6a1f35712692362f98c3699c0fca5b854dd", "parents": ["d0cd134685dd1cc9f5387e9d23619d77c7727c83"], "tags": []}], "date": 1773446414, "git_changesets": ["3ab2fa2ca7b1dbea634d7206a6aa92990a80e810"], "user": "rvandermeulen@mozilla.com"}, "594": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018430: Make WebRenderBridgeParent::RecvGetSnapshot reject invalid buffer sizes.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285152\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287611\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "2a1dccb9d81183e3ef3b9d33c1c5c649d30c8460", "git_parents": ["3ab2fa2ca7b1dbea634d7206a6aa92990a80e810"], "node": "44c2fbb9e19d2d564506da6d7eb00c263ead928b", "parents": ["6189d6a1f35712692362f98c3699c0fca5b854dd"], "tags": []}], "date": 1773446548, "git_changesets": ["2a1dccb9d81183e3ef3b9d33c1c5c649d30c8460"], "user": "rvandermeulen@mozilla.com"}, "595": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2011129: Make WebRenderBridgeParent::RecvSetDisplayList and ::RecvEmptyTransaction skip duplicate operations.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D286972\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287404\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "84a2e822b381422a2233616ed00b9022c836f567", "git_parents": ["2a1dccb9d81183e3ef3b9d33c1c5c649d30c8460"], "node": "f6615dc4b7c7d51bc47832384b7b638e7b91d652", "parents": ["44c2fbb9e19d2d564506da6d7eb00c263ead928b"], "tags": []}], "date": 1773446584, "git_changesets": ["84a2e822b381422a2233616ed00b9022c836f567"], "user": "rvandermeulen@mozilla.com"}, "596": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023039 - [devtools] Restore updated devtools-devices.json and fix browser_device_state_restore.js failures. r=jdescottes,devtools-reviewers a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287621\n", "files": ["devtools/client/responsive/test/browser/browser_device_state_restore.js", "services/settings/dumps/main/devtools-devices.json"], "git_node": "e828f0608a400ece39f90243eccfd55760baf4f0", "git_parents": ["84a2e822b381422a2233616ed00b9022c836f567"], "node": "2afb6c9db86e6f44586db5e3661856aca50bc2f2", "parents": ["f6615dc4b7c7d51bc47832384b7b638e7b91d652"], "tags": []}], "date": 1773511583, "git_changesets": ["e828f0608a400ece39f90243eccfd55760baf4f0"], "user": "rvandermeulen@mozilla.com"}, "597": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021863 - Cherry-pick 'stch' fixes #5808 and #5823 from harfbuzz upstream.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287305\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287533\n", "files": ["gfx/harfbuzz/src/hb-algs.hh", "gfx/harfbuzz/src/hb-ot-shaper-arabic.cc"], "git_node": "e4b54782e025dd0c42b802a2d77c669e1c7b2891", "git_parents": ["e828f0608a400ece39f90243eccfd55760baf4f0"], "node": "6e51e40c31a5772cd78078ffb87b201c2149d085", "parents": ["2afb6c9db86e6f44586db5e3661856aca50bc2f2"], "tags": []}], "date": 1773522187, "git_changesets": ["e4b54782e025dd0c42b802a2d77c669e1c7b2891"], "user": "rvandermeulen@mozilla.com"}, "598": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016373 ESR140: Ensure the correct doc and id when setting the embedder.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287270\n", "files": ["accessible/ipc/DocAccessibleParent.cpp", "dom/ipc/BrowserBridgeParent.cpp"], "git_node": "165e2e187106be5a3a187300b44b18e84945409c", "git_parents": ["e4b54782e025dd0c42b802a2d77c669e1c7b2891"], "node": "c8a474d57c981d739dd826607578f7088a58cffd", "parents": ["6e51e40c31a5772cd78078ffb87b201c2149d085"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019759 ESR140: Don't always treat embedding a DocAccessibleParent which already has a parent as an error.  a=RyanVM\n\nThere is one case where this is actually valid: when the embedder OuterDocAccessible gets re-created, whether due to layout or some other reason.\nIn this case, PBrowserBridge::SetEmbedderAccessible is sent when the new OuterDocAccessible is constructed, but that happens *before* we send the IPDL messages to destroy the old OuterDoc and add the new one.\nThis means that the old OuterDocAccessible is still the embedded document's parent when BrowserBridgeParent::RecvSetEmbedderAccessible executes.\nThus, we can't treat this as an error here.\nInstead, I've added a diagnostic assert to ensure that the embedded document doesn't have a parent when the new OuterDocAccessible is created, since by that time, the old OuterDocAccessible should have been removed.\nThis patch also fires a reorder event in AddChildDoc even for same-process documents.\nThis is necessary in order to write a reliable test, but it's probably better for clients too in case they happen to touch the re-created iframe in the short time before the embedded document is bound.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285198\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287271\n", "files": ["accessible/ipc/DocAccessibleParent.cpp", "accessible/tests/browser/fission/browser.toml", "accessible/tests/browser/fission/browser_iframe_recreation.js", "dom/ipc/BrowserBridgeParent.cpp"], "git_node": "3faec3f01dfea25a9b446da2e48d6054f3a3c54d", "git_parents": ["165e2e187106be5a3a187300b44b18e84945409c"], "node": "45b97da08b6bebfb13ec205d031425ef2bffc756", "parents": ["c8a474d57c981d739dd826607578f7088a58cffd"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020094 ESR140: Unify and correct the firing of reorder events for remote OuterDocAccessible.  a=RyanVM\n\nPreviously, the content process fired reorder events for same-process embedded documents.\nHowever, this couldn't be done for out-of-process embedded documents because of the process boundary.\nThe content process also didn't fire a reorder event when the embedder was re-created.\nI attempted to solve this in bug 2019759 by having AddChildDoc fire a reorder event even for same-process embedded documents.\nUnfortunately, this resulted in the reorder event being fired before the embedded document's initial tree had been received in some cases.\nTo fix this:\n\n1. Don't fire reorder events on OuterDocAccessibles from the content process. Instead, let the parent process handle all reorder events for remote OuterDocAccessibles as described below, since it has a much clearer view of the various moving parts of the unified document tree.\n2. Set a flag when a remote document's initial tree has been received and attached in the parent process.\n3. Fire a single reorder event on the embedder when both the initial tree has been attached and the embedded document has been bound. These things can happen in either order, but both conditions must be met before the event is fired. This also includes firing a reorder event when the document is bound to a new embedder.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285378\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287272\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h"], "git_node": "b55f97147d0b90300b5f78d26cb73e1b93f564da", "git_parents": ["3faec3f01dfea25a9b446da2e48d6054f3a3c54d"], "node": "463f928b07afaa116d12f5702285d3367e9a206a", "parents": ["45b97da08b6bebfb13ec205d031425ef2bffc756"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019763 ESR140: When a new top level DocAccessibleParent is constructed for an OOP iframe, destroy the old top level DocAccessibleParent if there is one.  a=RyanVM\n\nIn bug 1786496, we learned that during navigation, a new top level DocAccessibleParent can be constructed before the old one is destroyed.\nI don't know exactly how/why this happens, but it's not entirely unreasonable; destroying an old document should hardly take priority over loading the new one the user just requested.\nBug 1786496 fixed this for top level remote documents, but not for remote documents which are at the top level of their content process; i.e. OOP iframes.\nWhile speculative, it's reasonable to assume that this same issue might apply to OOP iframe documents.\nIf this does occur, when the BrowserBridgeParent version of AddChildDoc calls BrowserParent::GetTopLevelDocAccessibleParent to get the embedded document, it could end up with the old DocAccessibleParent (which might still be bound to its parent) instead of the new one.\nThis likely explains the \"Attempt to add child doc which already has a parent\" failure reported by AddChildDoc.\nAside from the content process crash, this would likely result in the OOP iframe being completely inaccessible in the parent process, since the new document would never be bound.\nTo fix this, apply the fix from bug 1786496 to all DocAccessibleParents at the top level of their content process, not just those at the very top of the remote tree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285652\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287273\n", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": "92e757c11fbad5944c2bba579fed4486c677855c", "git_parents": ["b55f97147d0b90300b5f78d26cb73e1b93f564da"], "node": "ec1d0e8e418c8b441f46a9f64b530bd87c1024f0", "parents": ["463f928b07afaa116d12f5702285d3367e9a206a"], "tags": []}], "date": 1773524420, "git_changesets": ["165e2e187106be5a3a187300b44b18e84945409c", "3faec3f01dfea25a9b446da2e48d6054f3a3c54d", "b55f97147d0b90300b5f78d26cb73e1b93f564da", "92e757c11fbad5944c2bba579fed4486c677855c"], "user": "rvandermeulen@mozilla.com"}, "599": {"changesets": [{"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2019763, Bug 2020094, Bug 2019759, Bug 2016373 ESR140: When a new top level DocAccessibleParent is constructed for an OOP iframe, destroy the old top level DocAccessibleParent if there is one. a=RyanVM\" for causing build bustages in DocAccessibleParent.h. DONTBUILD\n\nThis reverts commit 92e757c11fbad5944c2bba579fed4486c677855c.\n\nThis reverts commit b55f97147d0b90300b5f78d26cb73e1b93f564da.\n\nThis reverts commit 3faec3f01dfea25a9b446da2e48d6054f3a3c54d.\n\nThis reverts commit 165e2e187106be5a3a187300b44b18e84945409c.\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/tests/browser/fission/browser.toml", "accessible/tests/browser/fission/browser_iframe_recreation.js", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "b3eec794522ee940e73555a909ee41a32c45cc3d", "git_parents": ["92e757c11fbad5944c2bba579fed4486c677855c"], "node": "11d75865453e229bb0ac0bb05cc668a7b228131c", "parents": ["ec1d0e8e418c8b441f46a9f64b530bd87c1024f0"], "tags": []}], "date": 1773526304, "git_changesets": ["b3eec794522ee940e73555a909ee41a32c45cc3d"], "user": "sstanca@mozilla.com"}, "600": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2016661 - Don't allow attaching already parented remote accessibles.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283389\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287738\n", "files": ["accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h"], "git_node": "97efd7fe51a9bdeaec9f9fbd914e27265e8e5508", "git_parents": ["b3eec794522ee940e73555a909ee41a32c45cc3d"], "node": "bc0bb83ec0ecb74e0c0517c5da9e3de16005d22e", "parents": ["11d75865453e229bb0ac0bb05cc668a7b228131c"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2016664 - Cycle check children so they don't get added to themselves.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283391\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287739\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "2f30573e0a39532e02fa9c746b3db7b1495018ad", "git_parents": ["97efd7fe51a9bdeaec9f9fbd914e27265e8e5508"], "node": "55e042126f653164de5602dc802043ade6fa5957", "parents": ["bc0bb83ec0ecb74e0c0517c5da9e3de16005d22e"], "tags": []}], "date": 1773526640, "git_changesets": ["97efd7fe51a9bdeaec9f9fbd914e27265e8e5508", "2f30573e0a39532e02fa9c746b3db7b1495018ad"], "user": "rvandermeulen@mozilla.com"}, "601": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015267.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287792\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287795\n", "files": ["gfx/2d/FilterNodeSoftware.cpp"], "git_node": "feb7457aaa45067114a0cef1cd40eee0a16f8ee5", "git_parents": ["2f30573e0a39532e02fa9c746b3db7b1495018ad"], "node": "e71698e44a7237e03114cd91c27c1fab9aab079b", "parents": ["55e042126f653164de5602dc802043ade6fa5957"], "tags": []}], "date": 1773596722, "git_changesets": ["feb7457aaa45067114a0cef1cd40eee0a16f8ee5"], "user": "rvandermeulen@mozilla.com"}, "602": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2020030. a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287089\n", "files": ["third_party/aom/av1/encoder/pickcdef.c"], "git_node": "1c76ee596c5c686732a1772a612380234c2f82cc", "git_parents": ["feb7457aaa45067114a0cef1cd40eee0a16f8ee5"], "node": "d58d7a4fb9830de79b6ec9271d54e41846358214", "parents": ["e71698e44a7237e03114cd91c27c1fab9aab079b"], "tags": []}], "date": 1773600654, "git_changesets": ["1c76ee596c5c686732a1772a612380234c2f82cc"], "user": "rvandermeulen@mozilla.com"}, "603": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016373 ESR140: Ensure the correct doc and id when setting the embedder.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287270\n", "files": ["accessible/ipc/DocAccessibleParent.cpp", "dom/ipc/BrowserBridgeParent.cpp"], "git_node": "7a166b4d277c88eef0b77a2688f8f5856596fff4", "git_parents": ["1c76ee596c5c686732a1772a612380234c2f82cc"], "node": "54248a4a0b17e4d7fbf963a9365971ea9764b05f", "parents": ["d58d7a4fb9830de79b6ec9271d54e41846358214"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019759 ESR140: Don't always treat embedding a DocAccessibleParent which already has a parent as an error.  a=RyanVM\n\nThere is one case where this is actually valid: when the embedder OuterDocAccessible gets re-created, whether due to layout or some other reason.\nIn this case, PBrowserBridge::SetEmbedderAccessible is sent when the new OuterDocAccessible is constructed, but that happens *before* we send the IPDL messages to destroy the old OuterDoc and add the new one.\nThis means that the old OuterDocAccessible is still the embedded document's parent when BrowserBridgeParent::RecvSetEmbedderAccessible executes.\nThus, we can't treat this as an error here.\nInstead, I've added a diagnostic assert to ensure that the embedded document doesn't have a parent when the new OuterDocAccessible is created, since by that time, the old OuterDocAccessible should have been removed.\nThis patch also fires a reorder event in AddChildDoc even for same-process documents.\nThis is necessary in order to write a reliable test, but it's probably better for clients too in case they happen to touch the re-created iframe in the short time before the embedded document is bound.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285198\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287271\n", "files": ["accessible/ipc/DocAccessibleParent.cpp", "accessible/tests/browser/fission/browser.toml", "accessible/tests/browser/fission/browser_iframe_recreation.js", "dom/ipc/BrowserBridgeParent.cpp"], "git_node": "bdc80174f053522b9180a1b79734ee89d254bc38", "git_parents": ["7a166b4d277c88eef0b77a2688f8f5856596fff4"], "node": "43c4ca294cb27343584b793c7e636acb2fdd308d", "parents": ["54248a4a0b17e4d7fbf963a9365971ea9764b05f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020094 ESR140: Unify and correct the firing of reorder events for remote OuterDocAccessible.  a=RyanVM\n\nPreviously, the content process fired reorder events for same-process embedded documents.\nHowever, this couldn't be done for out-of-process embedded documents because of the process boundary.\nThe content process also didn't fire a reorder event when the embedder was re-created.\nI attempted to solve this in bug 2019759 by having AddChildDoc fire a reorder event even for same-process embedded documents.\nUnfortunately, this resulted in the reorder event being fired before the embedded document's initial tree had been received in some cases.\nTo fix this:\n\n1. Don't fire reorder events on OuterDocAccessibles from the content process. Instead, let the parent process handle all reorder events for remote OuterDocAccessibles as described below, since it has a much clearer view of the various moving parts of the unified document tree.\n2. Set a flag when a remote document's initial tree has been received and attached in the parent process.\n3. Fire a single reorder event on the embedder when both the initial tree has been attached and the embedded document has been bound. These things can happen in either order, but both conditions must be met before the event is fired. This also includes firing a reorder event when the document is bound to a new embedder.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285378\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287272\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h"], "git_node": "c65d455d4dd43c64499c157363a135ea4b57a68c", "git_parents": ["bdc80174f053522b9180a1b79734ee89d254bc38"], "node": "e2e101db1b6736cf27a620da12da6ce1e6e3f703", "parents": ["43c4ca294cb27343584b793c7e636acb2fdd308d"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019763 ESR140: When a new top level DocAccessibleParent is constructed for an OOP iframe, destroy the old top level DocAccessibleParent if there is one.  a=RyanVM\n\nIn bug 1786496, we learned that during navigation, a new top level DocAccessibleParent can be constructed before the old one is destroyed.\nI don't know exactly how/why this happens, but it's not entirely unreasonable; destroying an old document should hardly take priority over loading the new one the user just requested.\nBug 1786496 fixed this for top level remote documents, but not for remote documents which are at the top level of their content process; i.e. OOP iframes.\nWhile speculative, it's reasonable to assume that this same issue might apply to OOP iframe documents.\nIf this does occur, when the BrowserBridgeParent version of AddChildDoc calls BrowserParent::GetTopLevelDocAccessibleParent to get the embedded document, it could end up with the old DocAccessibleParent (which might still be bound to its parent) instead of the new one.\nThis likely explains the \"Attempt to add child doc which already has a parent\" failure reported by AddChildDoc.\nAside from the content process crash, this would likely result in the OOP iframe being completely inaccessible in the parent process, since the new document would never be bound.\nTo fix this, apply the fix from bug 1786496 to all DocAccessibleParents at the top level of their content process, not just those at the very top of the remote tree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285652\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287273\n", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": "9fe13e37a7c10e5c5cc8f3dcf6ec76511c0800c5", "git_parents": ["c65d455d4dd43c64499c157363a135ea4b57a68c"], "node": "1e161b8c71157e0162d0a7949907e80a1043a645", "parents": ["e2e101db1b6736cf27a620da12da6ce1e6e3f703"], "tags": []}], "date": 1773617162, "git_changesets": ["7a166b4d277c88eef0b77a2688f8f5856596fff4", "bdc80174f053522b9180a1b79734ee89d254bc38", "c65d455d4dd43c64499c157363a135ea4b57a68c", "9fe13e37a7c10e5c5cc8f3dcf6ec76511c0800c5"], "user": "rvandermeulen@mozilla.com"}, "604": {"changesets": [{"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2022643 - skip UTF-8 BOM when parsing prefs files  a=pascalc\n\nOur telemetry data indicates that this is pretty common. (in an admittedly\nsmall sample) I will continue monitoring the failure rate after this goes\nin to see if we get any improvements in Nightly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287210\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287563\n", "files": ["modules/libpref/parser/src/lib.rs", "modules/libpref/test/gtest/Parser.cpp"], "git_node": "a907c0fddb0e97e8a11a786fd76aae29a8d869bd", "git_parents": ["9fe13e37a7c10e5c5cc8f3dcf6ec76511c0800c5"], "node": "f8e741e46f467f2aac539a0f5b4eb2b3d544a9e3", "parents": ["1e161b8c71157e0162d0a7949907e80a1043a645"], "tags": []}], "date": 1773642568, "git_changesets": ["a907c0fddb0e97e8a11a786fd76aae29a8d869bd"], "user": "pchevrel@mozilla.com"}, "605": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2018113. a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287340\n", "files": ["gfx/layers/SourceSurfaceSharedData.cpp", "gfx/layers/SourceSurfaceSharedData.h"], "git_node": "6f7122e0b10d405ae49b2fc8f649ef20a3d4b245", "git_parents": ["a907c0fddb0e97e8a11a786fd76aae29a8d869bd"], "node": "625f417e9d86d400e7dacd3ab2fb4691b1dad4b6", "parents": ["f8e741e46f467f2aac539a0f5b4eb2b3d544a9e3"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2018113. a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287341\n", "files": ["gfx/layers/BufferTexture.cpp", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageDataSerializer.cpp", "gfx/layers/ImageDataSerializer.h", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp"], "git_node": "7597d6a40a8372a7066607118cfdd039c3e96178", "git_parents": ["6f7122e0b10d405ae49b2fc8f649ef20a3d4b245"], "node": "784dc33e59b45347902f5ca552ab1f569e747d5e", "parents": ["625f417e9d86d400e7dacd3ab2fb4691b1dad4b6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2021592. Relax check for aCbCrSize to only what we need. a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287342\n", "files": ["gfx/layers/ImageDataSerializer.cpp"], "git_node": "e3ddba32fad652b7c7d49424803c2cbdea4f8339", "git_parents": ["7597d6a40a8372a7066607118cfdd039c3e96178"], "node": "2bcca6fc98d284c305488720d37c4ccfe6f3a23b", "parents": ["784dc33e59b45347902f5ca552ab1f569e747d5e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2020091. a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287343\n", "files": ["gfx/layers/BufferTexture.cpp", "gfx/layers/ImageContainer.cpp"], "git_node": "393bb827a246f0d322c67db1a7b2e06d745e490d", "git_parents": ["e3ddba32fad652b7c7d49424803c2cbdea4f8339"], "node": "e1a81b0f8074ad0df0624ac29ab4024976301801", "parents": ["2bcca6fc98d284c305488720d37c4ccfe6f3a23b"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2023383. Use image::SurfaceCache::IsLegalSize over gfx::Factory::AllowedSurfaceSize in SourceSurfaceSharedDataWrapper. a=pascalc\n\nSurfaceCache::IsLegalSize is what is used to determine if imgFrame's are valid, and that is what is on the content process side of this parent process code. So using the same function is what we want.\n\nPratically, on trunk SurfaceCache::IsLegalSize and Factory::AllowedSurfaceSize are basically identical (reject if one dimension is over 64k or total area can't fit in an int32_t), but that is only true after bug 1911583 which expanded that from 32k to 64k. But on esr140, that doesn't have bug 1911583, so these functions are different and we want to uplift the AllowedSurfaceSize check there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287904\n", "files": ["gfx/layers/SourceSurfaceSharedData.cpp", "image/moz.build"], "git_node": "1dbf0cec2a9728dc560b75812647a8eff9505697", "git_parents": ["393bb827a246f0d322c67db1a7b2e06d745e490d"], "node": "ebc913dcb2abfc0f39ad3f9c35406cca8f963e70", "parents": ["e1a81b0f8074ad0df0624ac29ab4024976301801"], "tags": []}], "date": 1773650827, "git_changesets": ["6f7122e0b10d405ae49b2fc8f649ef20a3d4b245", "7597d6a40a8372a7066607118cfdd039c3e96178", "e3ddba32fad652b7c7d49424803c2cbdea4f8339", "393bb827a246f0d322c67db1a7b2e06d745e490d", "1dbf0cec2a9728dc560b75812647a8eff9505697"], "user": "pchevrel@mozilla.com"}, "606": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022733 - WebTransportSessionProxy::mServerCertHashes cleanup,  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287298\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287916\n", "files": ["netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.h"], "git_node": "02c3a5ff4e4ec35e17ccf85eb746b1253aef3ebd", "git_parents": ["1dbf0cec2a9728dc560b75812647a8eff9505697"], "node": "b5f676e38b199eb0e236913f93ed8b443b1445d5", "parents": ["ebc913dcb2abfc0f39ad3f9c35406cca8f963e70"], "tags": []}], "date": 1773652332, "git_changesets": ["02c3a5ff4e4ec35e17ccf85eb746b1253aef3ebd"], "user": "pchevrel@mozilla.com"}, "607": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287919\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "b42cc9a9604f5de6d31c44ca54b0570962abbb72", "git_parents": ["02c3a5ff4e4ec35e17ccf85eb746b1253aef3ebd"], "node": "5e91c22e087de2a7ddc1c03ffef007b4357b0a91", "parents": ["b5f676e38b199eb0e236913f93ed8b443b1445d5"], "tags": []}], "date": 1773653311, "git_changesets": ["b42cc9a9604f5de6d31c44ca54b0570962abbb72"], "user": "pchevrel@mozilla.com"}, "608": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022090 - Do not continue when it is not expected.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287324\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288052\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "82c8b1568a1f76f340c25103f797e54ea7b27eb4", "git_parents": ["b42cc9a9604f5de6d31c44ca54b0570962abbb72"], "node": "752223c383ab16fd7cda6f1e0c0dfcd9d2932496", "parents": ["5e91c22e087de2a7ddc1c03ffef007b4357b0a91"], "tags": []}], "date": 1773688708, "git_changesets": ["82c8b1568a1f76f340c25103f797e54ea7b27eb4"], "user": "pchevrel@mozilla.com"}, "609": {"changesets": [{"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022351 - Check upload totalRows.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287129\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287937\n", "files": ["dom/canvas/TexUnpackBlob.cpp"], "git_node": "313f574c3be3e0cb2623651720e6241e9c272656", "git_parents": ["82c8b1568a1f76f340c25103f797e54ea7b27eb4"], "node": "780f454ee6fb41cf56ebf73db80b8a6eaccaca2f", "parents": ["752223c383ab16fd7cda6f1e0c0dfcd9d2932496"], "tags": []}], "date": 1773703185, "git_changesets": ["313f574c3be3e0cb2623651720e6241e9c272656"], "user": "rvandermeulen@mozilla.com"}, "610": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2021922 - Check isValid before accessing Host()  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D286858\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287959\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/base/nsStandardURL.h"], "git_node": "ffbf058a4249235d97d96996b132b3359ec32165", "git_parents": ["313f574c3be3e0cb2623651720e6241e9c272656"], "node": "2a0cd64bc757f1d50596cfd62206a76aa0e8d5df", "parents": ["780f454ee6fb41cf56ebf73db80b8a6eaccaca2f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2022567 - Check URL bounds before old_param in nsStandardURL::ReadPrivate  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287296\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287960\n", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": "04a56c28ec59e3d6bb1dc40b01eff8e650f351f9", "git_parents": ["ffbf058a4249235d97d96996b132b3359ec32165"], "node": "ea66d4f731670458ad4e003a24825b7d60386505", "parents": ["2a0cd64bc757f1d50596cfd62206a76aa0e8d5df"], "tags": []}], "date": 1773703624, "git_changesets": ["ffbf058a4249235d97d96996b132b3359ec32165", "04a56c28ec59e3d6bb1dc40b01eff8e650f351f9"], "user": "rvandermeulen@mozilla.com"}, "611": {"changesets": [{"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021695 - [devtools] Escape URL when doing a copy as fetch  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287067\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288044\n", "files": ["devtools/client/netmonitor/src/widgets/RequestListContextMenu.js", "devtools/client/netmonitor/test/browser_net_copy_as_fetch.js"], "git_node": "575caf464c0afc557f721c8469033033f79aadfb", "git_parents": ["04a56c28ec59e3d6bb1dc40b01eff8e650f351f9"], "node": "164be4f4a4e0d062784d8b46355ee5998bd572e3", "parents": ["ea66d4f731670458ad4e003a24825b7d60386505"], "tags": []}], "date": 1773703663, "git_changesets": ["575caf464c0afc557f721c8469033033f79aadfb"], "user": "rvandermeulen@mozilla.com"}, "612": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022478 - Improve localstorage state machine.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287311\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288111\n", "files": ["dom/localstorage/ActorsParent.cpp"], "git_node": "0e460e0cd31a92469f7052404805ad4255c3d560", "git_parents": ["575caf464c0afc557f721c8469033033f79aadfb"], "node": "726873f2a4ab623ec2a707b05f7635cc52f0c1d6", "parents": ["164be4f4a4e0d062784d8b46355ee5998bd572e3"], "tags": []}], "date": 1773706379, "git_changesets": ["0e460e0cd31a92469f7052404805ad4255c3d560"], "user": "rvandermeulen@mozilla.com"}, "613": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023384 - Add back phiBlock check in BlockIsSingleTest.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287979\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288132\n", "files": ["js/src/jit/IonAnalysis.cpp"], "git_node": "953f1f34b1f68d71dac8feb99920cef16d66c050", "git_parents": ["0e460e0cd31a92469f7052404805ad4255c3d560"], "node": "dd3ff18ae9e8d04aa39e129cf3fcd522c127eaef", "parents": ["726873f2a4ab623ec2a707b05f7635cc52f0c1d6"], "tags": []}], "date": 1773736903, "git_changesets": ["953f1f34b1f68d71dac8feb99920cef16d66c050"], "user": "pchevrel@mozilla.com"}, "614": {"changesets": [{"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2023094 p1 - Trigger AppLocker checks for CDM DLLs before lowering the sandbox.  a=pascalc\n\nPublisher AppLocker rules are currently blocked by the sandbox. Without\nexecuting any code from the DLL, we trigger the check before lowering the\nsandbox. A successful check is cached and then succeeds within the sandbox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288134\n", "files": ["dom/media/gmp/GMPLoader.cpp", "xpcom/base/nsWindowsHelpers.h"], "git_node": "24ee2c48cb00648ef60e0bf1ca43207eea90b8e2", "git_parents": ["953f1f34b1f68d71dac8feb99920cef16d66c050"], "node": "59c460a27ac018b8027bc3d5264bff86c949be6b", "parents": ["dd3ff18ae9e8d04aa39e129cf3fcd522c127eaef"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2023094 p2 - Update AppLocker sandbox rules.  a=pascalc\n\nThis makes two changes:\n1) Remove an old rule which allowed for a double slash in the registry path.\n   This was seen in a log when these rules were originally added, it cannot now\n   be found in any of the DLLs analyzed from Windows 7 onwards.\n2) A new rule to allow read access to System32\\AppLocker\\MDM. This folder is\n   required as part of checks to see if an AppLocker policy is configured.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288135\n", "files": ["security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "d44e76f6e4c24f560aa2b509fdd5a3ea93615528", "git_parents": ["24ee2c48cb00648ef60e0bf1ca43207eea90b8e2"], "node": "ad4a5ceb5516151b4014e2af6c1565c68ab330cc", "parents": ["59c460a27ac018b8027bc3d5264bff86c949be6b"], "tags": ["FIREFOX_140_9_0esr_BUILD1", "FIREFOX_140_9_0esr_RELEASE"]}], "date": 1773740006, "git_changesets": ["24ee2c48cb00648ef60e0bf1ca43207eea90b8e2", "d44e76f6e4c24f560aa2b509fdd5a3ea93615528"], "user": "pchevrel@mozilla.com"}}
}";