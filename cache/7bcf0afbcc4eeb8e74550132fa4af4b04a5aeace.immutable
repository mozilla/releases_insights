or.services.mozilla.com/D284097\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285705\n", "files": ["dom/base/DocumentOrShadowRoot.cpp"], "git_node": "493a0f074783c1c358b46cc7d50dac221267bf95", "git_parents": ["c57bad946724c1dc1a839332effc98174d4e288e"], "node": "0ffcb2320b754448919edebce292d2826366f4b1", "parents": ["520fcf4367a36c5966203648d0ca5d75999bad6f"], "tags": []}], "date": 1773064372, "git_changesets": ["493a0f074783c1c358b46cc7d50dac221267bf95"], "user": "pchevrel@mozilla.com"}, "556": {"changesets": [{"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2016368  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283147\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285742\n", "files": ["toolkit/components/telemetry/other/CombinedStacks.h"], "git_node": "8b77ca580ab35597d3232bbfcae0c2ecd2aecf4e", "git_parents": ["493a0f074783c1c358b46cc7d50dac221267bf95"], "node": "b864f8e07bad95965608f99560b7f6f53b0070e1", "parents": ["0ffcb2320b754448919edebce292d2826366f4b1"], "tags": []}], "date": 1773165568, "git_changesets": ["8b77ca580ab35597d3232bbfcae0c2ecd2aecf4e"], "user": "pchevrel@mozilla.com"}, "557": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2016374 - Add more checks to InputStream IPC,  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283757\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285790\n", "files": ["xpcom/io/SlicedInputStream.cpp"], "git_node": "ccf5bc86f4f5c0abf1598ae22e5fc64bc38b3351", "git_parents": ["8b77ca580ab35597d3232bbfcae0c2ecd2aecf4e"], "node": "18fabdf16284b4675d6bd22a496253233fabf769", "parents": ["b864f8e07bad95965608f99560b7f6f53b0070e1"], "tags": []}], "date": 1773165832, "git_changesets": ["ccf5bc86f4f5c0abf1598ae22e5fc64bc38b3351"], "user": "pchevrel@mozilla.com"}, "558": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2019112 - Fold the prompt message into ContentPermissionRequest construction.  a=pascalc\n\nInstead of sending a separate message, immediately do the initialization after the\nactor is created and registered, via a new override of RecvPContentPermissionRequestConstructor.\nI didn't move the initialization inside AllocPContentPermissionRequestParent because\nthe Init() method runs JS so it seems like a bad idea to do when the actor isn't fully set up.\n\naRequests is now set inside the Init() method instead of the constructor, which allows us\nto avoid a copy of this array at the low cost of making the diff gross.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284774\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286018\n", "files": ["dom/base/nsContentPermissionHelper.cpp", "dom/base/nsContentPermissionHelper.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContentPermissionRequest.ipdl"], "git_node": "25998877a4fa8cfd276934dadaf90b329ed93eb3", "git_parents": ["ccf5bc86f4f5c0abf1598ae22e5fc64bc38b3351"], "node": "3874c659e209295fdfbea876c62d47850dc34c80", "parents": ["18fabdf16284b4675d6bd22a496253233fabf769"], "tags": []}], "date": 1773169020, "git_changesets": ["25998877a4fa8cfd276934dadaf90b329ed93eb3"], "user": "pchevrel@mozilla.com"}, "559": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018196 - Ensure RemoteWorkerController::SetServiceWorkerWaitingFlag() is only called for ServiceWorker.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285929\n", "files": ["dom/workers/remoteworkers/RemoteWorkerController.cpp"], "git_node": "18e8ead4494a3f42a986e0dded77d16cd8e0ceea", "git_parents": ["25998877a4fa8cfd276934dadaf90b329ed93eb3"], "node": "dc640d2010a4e5b65d0412e2d8df6d4201e8de01", "parents": ["3874c659e209295fdfbea876c62d47850dc34c80"], "tags": []}], "date": 1773172264, "git_changesets": ["18e8ead4494a3f42a986e0dded77d16cd8e0ceea"], "user": "pchevrel@mozilla.com"}, "560": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018405. (esr140) r=pascalc a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285854\n", "files": ["gfx/2d/FilterNodeSoftware.cpp", "gfx/2d/FilterNodeSoftware.h"], "git_node": "1245506dc424820e557cf27b8dcee5157469c13c", "git_parents": ["18e8ead4494a3f42a986e0dded77d16cd8e0ceea"], "node": "da902eb1b78c6c3cc78eb48432547881cf2f5713", "parents": ["dc640d2010a4e5b65d0412e2d8df6d4201e8de01"], "tags": []}], "date": 1773172676, "git_changesets": ["1245506dc424820e557cf27b8dcee5157469c13c"], "user": "pchevrel@mozilla.com"}, "561": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2019287 - Use `ContiguousEnumSerializer` to receive/send `EventClassID`  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285201\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286407\n", "files": ["widget/EventForwards.h", "widget/nsGUIEventIPC.h"], "git_node": "d188e45617d125406bd67f2e8232dfa47c845c8b", "git_parents": ["1245506dc424820e557cf27b8dcee5157469c13c"], "node": "9bba1628de3aef10ed1fbb8355cb3095c1bd2751", "parents": ["da902eb1b78c6c3cc78eb48432547881cf2f5713"], "tags": []}], "date": 1773173096, "git_changesets": ["d188e45617d125406bd67f2e8232dfa47c845c8b"], "user": "pchevrel@mozilla.com"}, "562": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2020275 - Make `ParamTraits` for `enum`s of `WidgetMouseEvent` and `WidgetWheelEvent`  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285911\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286445\n", "files": ["widget/MouseEvents.h", "widget/nsGUIEventIPC.h"], "git_node": "bcadfb9fcabc5eef64611a242ec63f4d8c676bc4", "git_parents": ["d188e45617d125406bd67f2e8232dfa47c845c8b"], "node": "16bd59864353e1871d3edfeb1a91e33b5443aa8a", "parents": ["9bba1628de3aef10ed1fbb8355cb3095c1bd2751"], "tags": []}], "date": 1773173178, "git_changesets": ["bcadfb9fcabc5eef64611a242ec63f4d8c676bc4"], "user": "pchevrel@mozilla.com"}, "563": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2016329 - Rework CheckFrameData  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283433\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286497\n", "files": ["dom/media/gmp/GMPVideoi420FrameImpl.cpp"], "git_node": "a7430c72ac5b70f8f24306862a4ac6096a37c341", "git_parents": ["bcadfb9fcabc5eef64611a242ec63f4d8c676bc4"], "node": "b812020da57a6770c53d25c984b944176559b068", "parents": ["16bd59864353e1871d3edfeb1a91e33b5443aa8a"], "tags": []}], "date": 1773173259, "git_changesets": ["a7430c72ac5b70f8f24306862a4ac6096a37c341"], "user": "pchevrel@mozilla.com"}, "564": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2018102 validate chroma plane strides for VideoData::CreateAndCopyData()  a=pascalc DONTBUILD\n\nand assert that plane sizes match subsampling.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285683\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286514\n", "files": ["dom/media/MediaData.cpp", "dom/media/platforms/agnostic/VPXDecoder.cpp"], "git_node": "2b451552de0d600249dd8c18121667d2913448b0", "git_parents": ["a7430c72ac5b70f8f24306862a4ac6096a37c341"], "node": "d4c741d072828827d40a0ef2089cc7bfdfc2f6c6", "parents": ["b812020da57a6770c53d25c984b944176559b068"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2018102 validate alpha plane for VideoData::CreateAndCopyData()  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285684\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286515\n", "files": ["dom/media/MediaData.cpp"], "git_node": "0e05145e3fc768245f268dd287deea1c8379a164", "git_parents": ["2b451552de0d600249dd8c18121667d2913448b0"], "node": "77911ccef9665b6e4b1e7b48f7f40bdeb9499a4c", "parents": ["d4c741d072828827d40a0ef2089cc7bfdfc2f6c6"], "tags": []}], "date": 1773174219, "git_changesets": ["2b451552de0d600249dd8c18121667d2913448b0", "0e05145e3fc768245f268dd287deea1c8379a164"], "user": "pchevrel@mozilla.com"}, "565": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2019372 - Clear native key bindings of the reply event  a=pascalc DONTBUILD\n\nThe parent process should handle only the shortcut key and access key\nwhen it receives a reply key event. Thus, the editor commands are not\nrequired, but the copy cost may not be cheap. Therefore, we should stop\ncopying them and the parent process should check whether the reply event\nhas unexpected edit commands or not.\n\nAnd also this makes `nsGUIEventIPC.h` sanitizes the `KeyNameIndex` and\n`CodeNameIndex`.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D286456\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286586\n", "files": ["dom/events/GlobalKeyListener.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserParent.cpp", "toolkit/components/resistfingerprinting/nsRFPService.cpp", "toolkit/components/resistfingerprinting/nsRFPService.h", "widget/EventForwards.h", "widget/TextEvents.h", "widget/WidgetEventImpl.cpp", "widget/nsGUIEventIPC.h"], "git_node": "6fc714ca4c9f047a680a1a70957f2784c9c9f1ba", "git_parents": ["0e05145e3fc768245f268dd287deea1c8379a164"], "node": "303b29215bd4cb41d37f6c954f63b94b61c10d33", "parents": ["77911ccef9665b6e4b1e7b48f7f40bdeb9499a4c"], "tags": []}], "date": 1773174318, "git_changesets": ["6fc714ca4c9f047a680a1a70957f2784c9c9f1ba"], "user": "pchevrel@mozilla.com"}, "566": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020906 - Improve FoldTests pattern matching.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D286003\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286615\n", "files": ["js/src/jit/IonAnalysis.cpp"], "git_node": "7b5c30b335c787c1dfe8e322f123300138f91b6f", "git_parents": ["6fc714ca4c9f047a680a1a70957f2784c9c9f1ba"], "node": "84a0bb40da428e08b6b7e334dea3d98668bbfa95", "parents": ["303b29215bd4cb41d37f6c954f63b94b61c10d33"], "tags": []}], "date": 1773174734, "git_changesets": ["7b5c30b335c787c1dfe8e322f123300138f91b6f"], "user": "pchevrel@mozilla.com"}, "567": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2017521: Make SampleAnimationForProperty bail out when an animation has no segments.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284193\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286956\n", "files": ["gfx/layers/AnimationHelper.cpp"], "git_node": "cbd916fb84f313a48071d5df0747cc1f7067955b", "git_parents": ["7b5c30b335c787c1dfe8e322f123300138f91b6f"], "node": "126f3c211de199513dae08d57a5ce56da5762e79", "parents": ["84a0bb40da428e08b6b7e334dea3d98668bbfa95"], "tags": []}], "date": 1773199563, "git_changesets": ["cbd916fb84f313a48071d5df0747cc1f7067955b"], "user": "rvandermeulen@mozilla.com"}, "568": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015091: Define constant for Filter channel count, and validate against it.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284178\n\nDifferential Revision: https://phabricator.services.mozilla.com/D