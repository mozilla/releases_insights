"549": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020685 - Fix up unit test for GMP encoder tracking dropped frames.  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285764\n", "files": ["dom/media/gmp-plugin-openh264/gmp-fake-openh264.cpp", "dom/media/gtest/TestWebrtcGmpCodec.cpp"], "git_node": "3207d8942b1cab427a6f6b1208fb6403bb79648c", "git_parents": ["738352115a50d7106846655bcc71c383919852af"], "node": "05f930a2fc8ecd21b9400f6c30aa8a7e994c38b6", "parents": ["c71248812286f5fb4f445e79fede966277802c4e"], "tags": []}], "date": 1772633023, "git_changesets": ["3207d8942b1cab427a6f6b1208fb6403bb79648c"], "user": "pchevrel@mozilla.com"}, "550": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013762: Make table loads immovable.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D284888\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285792\n", "files": ["js/src/jit/MIR-wasm.h"], "git_node": "2526dc9b15e238a6544f0672c597d4f1f8636eab", "git_parents": ["3207d8942b1cab427a6f6b1208fb6403bb79648c"], "node": "bb6d1ff79980cbc01e30f14a0411c55e9c39f177", "parents": ["05f930a2fc8ecd21b9400f6c30aa8a7e994c38b6"], "tags": []}], "date": 1772698160, "git_changesets": ["2526dc9b15e238a6544f0672c597d4f1f8636eab"], "user": "pchevrel@mozilla.com"}, "551": {"changesets": [{"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2013747 - [mips64] Export JS::detail::CanonicalizedNaNBits for inlined accessors when embedding.  a=pascalc DONTBUILD\n\nTested on Loongson 3B4000.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D281725\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286064\n", "files": ["js/public/Value.h"], "git_node": "28927d9801dacfe562b66fdecd7c3a9b07128175", "git_parents": ["2526dc9b15e238a6544f0672c597d4f1f8636eab"], "node": "22cf9646cda34cd75a138f2fa8bc9ca31b251763", "parents": ["bb6d1ff79980cbc01e30f14a0411c55e9c39f177"], "tags": []}], "date": 1772719848, "git_changesets": ["28927d9801dacfe562b66fdecd7c3a9b07128175"], "user": "pchevrel@mozilla.com"}, "552": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018103. (esr140)  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285858\n", "files": ["gfx/layers/BufferTexture.cpp", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageDataSerializer.cpp", "gfx/layers/ImageDataSerializer.h", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp"], "git_node": "cab2d629eb33fb4ff0ede4ef1e49fec9f9a8bad6", "git_parents": ["28927d9801dacfe562b66fdecd7c3a9b07128175"], "node": "54829016af7cb78a4601807f075469350dce00b0", "parents": ["22cf9646cda34cd75a138f2fa8bc9ca31b251763"], "tags": []}], "date": 1772977629, "git_changesets": ["cab2d629eb33fb4ff0ede4ef1e49fec9f9a8bad6"], "user": "pchevrel@mozilla.com"}, "553": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1988534, part 1 - Add README_MOZILLA to the keep list for Expat.  a=pascalc\n\nAlso update the readme to mention git instead of hg.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D278890\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286429\n", "files": ["parser/expat/README_MOZILLA", "parser/expat/moz.yaml"], "git_node": "f66bcf5d5694568217d297174a4905b5e5813ed4", "git_parents": ["cab2d629eb33fb4ff0ede4ef1e49fec9f9a8bad6"], "node": "8e41fd99f5db2a72e93a8aee2fb377e110b73cf5", "parents": ["54829016af7cb78a4601807f075469350dce00b0"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1988534, part 2 - Upgrade Expat from R_2_6_4 to R_2_7_3.  a=pascalc\n\nGenerated using\n  mach vendor parser/expat/moz.yaml --patch-mode=none\n\nOriginal Revision: https://phabricator.services.mozilla.com/D278891\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286430\n", "files": ["parser/expat/COPYING", "parser/expat/expat/lib/expat.h", "parser/expat/expat/lib/expat_external.h", "parser/expat/expat/lib/internal.h", "parser/expat/expat/lib/xmlparse.c", "parser/expat/expat/lib/xmlrole.h", "parser/expat/expat/lib/xmltok.c", "parser/expat/expat/lib/xmltok.h"], "git_node": "472db7c68caa2b5853fd36ecb33cd4b72102bc4a", "git_parents": ["f66bcf5d5694568217d297174a4905b5e5813ed4"], "node": "4afb5d355327802dde7352c77c893fc6199edb02", "parents": ["8e41fd99f5db2a72e93a8aee2fb377e110b73cf5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1988534, part 3 - Fix Firefox patches for Expat.  a=pascalc\n\n* Mostly, this unbitrots the patches and updates line numbers.\n\n* Define MOZ_XML_GetMismatchedTag and MOZ_XML_ProcessingEntityValue in\n  moz_xmlparse.c instead of these patches, to reduce future bitrot. This means\n  that 06_report_processing_entity.patch can be removed entirely.\n\n* For 06_always_store_rawnames.patch, in the section from line 33 to 71 nothing\n  is really changing. The old diff was just really awful for some reason. For\n  the final chunk from line 72 to 86, that chunk of code with a call to\n  storeRawNames in internalEntityProcessor, so it could be deleted.\n\n* 11_nested_entities.patch handles some kind of issue with nested entities.\n  This seems to correspond to code in internalEntityProcessor where there\n  is now an assertion:\n    assert(parser-\u003em_openInternalEntities == openEntity);\n  So I guess it is no longer needed. Peter removed it from his patch stack.\n\n* Renumber the patches to account for the two removed ones.\n\n* In 11_no_debug_report.patch, a new struct MALLOC_TRACKER has been added.\n  I had to remove new debugLevel here, as well as peakBytesAllocated, which\n  as it says is only used when debugLevel is set. expat_heap_stat is also\n  only used by that code, so it gets removed, too.\n\n* 12_unused.patch removes a bunch of unused code. The stuff around line 56\n  had to change because a new function, parserBusy, that is used was added\n  into the middle of a bunch of unused functions.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D278892\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286431\n", "files": ["parser/expat/00_xmlchar.patch", "parser/expat/01_noslop.patch", "parser/expat/02_report_mismatched_tag.patch", "parser/expat/03_dont_generate_salt.patch", "parser/expat/04_always_set_eventptrs.patch", "parser/expat/05_getcurrentbyteindex.patch", "parser/expat/06_always_store_rawnames.patch", "parser/expat/06_report_processing_entity.patch", "parser/expat/07_always_store_rawnames.patch", "parser/expat/07_dont_ignore_undeclared_entity.patch", "parser/expat/08_dont_ignore_undeclared_entity.patch", "parser/expat/08_include_xmlns.patch", "parser/expat/09_include_xmlns.patch", "parser/expat/09_internalsubset.patch", "parser/expat/10_internalsubset.patch", "parser/expat/10_version_limit.patch", "parser/expat/11_nested_entities.patch", "parser/expat/11_no_debug_report.patch", "parser/expat/12_unused.patch", "parser/expat/12_version_limit.patch", "parser/expat/13_no_debug_report.patch", "parser/expat/14_unused.patch", "parser/expat/expat/lib/moz_xmlparse.c", "parser/expat/moz.yaml"], "git_node": "a0e95f89828d76539ce0c1e551a254e9d8857b36", "git_parents": ["472db7c68caa2b5853fd36ecb33cd4b72102bc4a"], "node": "71c4ee388730b478489dd589fc0e1416ae451b2d", "parents": ["4afb5d355327802dde7352c77c893fc6199edb02"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1988534, part 4 - Apply the Expat patches.  a=pascalc\n\nThis was auto generated with\n  ./mach vendor parser/expat/moz.yaml --patch-mode=only\n\nOriginal Revision: htt