], "tags": ["FIREFOX_52_7_1esr_BUILD1", "FIREFOX_52_7_1esr_RELEASE"]}], "date": 1520974151, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7585": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "2584735c78220a59aa3b520c6b1ba28c353e863a", "parents": ["fb71467f219b08127b92bcaf94a9569b0a213ddb"], "tags": []}, {"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "No bug - Tagging fb71467f219b08127b92bcaf94a9569b0a213ddb with FIREFOX_52_7_1esr_BUILD1, FIREFOX_52_7_1esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "960c7dc0dd7d2e069624d2e8c6f4f64857891099", "parents": ["2584735c78220a59aa3b520c6b1ba28c353e863a"], "tags": []}], "date": 1521038439, "git_changesets": [null, null], "user": "ffxbld"}, "7586": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "36b851930ac3ad79c4455ec0faef5eabca02ad78", "parents": ["960c7dc0dd7d2e069624d2e8c6f4f64857891099"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-302 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "10d834a15494112aa3be753e68f37a503415fa7a", "parents": ["36b851930ac3ad79c4455ec0faef5eabca02ad78"], "tags": []}], "date": 1521058080, "git_changesets": [null, null], "user": "ffxbld"}, "7587": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1426603 - Fallback from audio callback to system clock driver on error only once. r=padenot, a=RyanVM\n\nUsually, mShouldFallbackIfError has been reset to false in DataCallback()\nbefore Stop() is called.  However, if fallback to a system clock driver due to\ncubeb error had already occurred, then mShouldFallbackIfError would not have\nbeen reset, and Stop() is still called.  With mShouldFallbackIfError still\ntrue, a cubeb error in stop would have created another fallback thread.\n\nI expect that resetting mShouldFallbackIfError in Stop() would also be an\neffective alternative solution, but resetting on StateCallback() happens\nearlier, which would be an advantage if any additional errors could possibly\nbe reported to StateCallback().\n\nMozReview-Commit-ID: E9j7PQmS3O4", "files": ["dom/media/GraphDriver.cpp"], "git_node": null, "git_parents": [null], "node": "ca0b92ecedee6561e0ce590eab9309c31a1ad0c5", "parents": ["10d834a15494112aa3be753e68f37a503415fa7a"], "tags": []}], "date": 1521139818, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7588": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "501c6ec6297637b10f5bec7179f21b6e757013c6", "parents": ["ca0b92ecedee6561e0ce590eab9309c31a1ad0c5"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-303 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "f2eb8ad26a29ec9715a1994b982cbe35a3ba3a12", "parents": ["501c6ec6297637b10f5bec7179f21b6e757013c6"], "tags": []}], "date": 1521144068, "git_changesets": [null, null], "user": "ffxbld"}, "7589": {"changesets": [{"author": "Monty Montgomery \u003cmonty@xiph.org\u003e", "branch": "default", "desc": "Bug 1446062 - Vorbis fix. r=jmspeex, a=lizzard", "files": ["media/libvorbis/lib/vorbis_codebook.c"], "git_node": null, "git_parents": [null], "node": "494e5d5278ba6f5fdda9a2bb9ac7ca772653ee4a", "parents": ["f2eb8ad26a29ec9715a1994b982cbe35a3ba3a12"], "tags": ["FIREFOX_52_7_2esr_BUILD1", "FIREFOX_52_7_2esr_RELEASE"]}], "date": 1521156786, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7590": {"changesets": [{"author": "Thomas Daede \u003cdaede003@umn.edu\u003e", "branch": "default", "desc": "Bug 1446062: libtremor Vorbis fix.  r=jmspeex  a=dveditz", "files": ["media/libtremor/lib/tremor_codebook.c"], "git_node": null, "git_parents": [null], "node": "5cd5586a2f48424a9031a3fa4c782954a9df9a52", "parents": ["494e5d5278ba6f5fdda9a2bb9ac7ca772653ee4a"], "tags": []}], "date": 1521181602, "git_changesets": [null], "user": "dbaron@mozilla.com"}, "7591": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "d870d35d17c6c6d4c8dad1367ea3d3ca7cb94189", "parents": ["5cd5586a2f48424a9031a3fa4c782954a9df9a52"], "tags": []}, {"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "No bug - Tagging 494e5d5278ba6f5fdda9a2bb9ac7ca772653ee4a with FIREFOX_52_7_2esr_BUILD1, FIREFOX_52_7_2esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "9c8f0636b015f04eebf8e85c84255d94da37bb1c", "parents": ["d870d35d17c6c6d4c8dad1367ea3d3ca7cb94189"], "tags": []}], "date": 1521215545, "git_changesets": [null, null], "user": "ffxbld"}, "7592": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "merge default to THUNDERBIRD_52_VERBRANCH. 