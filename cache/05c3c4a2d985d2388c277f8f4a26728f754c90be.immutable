ml"], "git_node": "ccbc5e6940e38ac58facb944a7d2d42ff1f86e30", "git_parents": ["654ec70bfc680c3021689324d55620b645f6980a"], "node": "4f7ad536599f9854c13a6b78036e89c9f6d07761", "parents": ["59e79b76b330e8ed4fca6f4a473236fb44338713"], "tags": []}], "date": 1758301099, "git_changesets": ["ccbc5e6940e38ac58facb944a7d2d42ff1f86e30"], "user": "dmeehan@mozilla.com"}, "228": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1984724 - Account for missing data_collection field (ESR140 port)  a=dmeehan\n\nextensions.json can miss the data_collection field when it was generated\nby a Firefox version that did not support it. The implementation did not\naccount for this, and prevented extensions from updating due to a\nruntime error.\n\nThis patch fixes the issue by adding a null check, and unit tests for\nbackground updates. The unit test does not exercise the code path of the\n\"manual update\" scenario from the bug, because of complexity and the\nfact that its implementation is going to be replaced with the same logic\nof the background update check (bug 1974732).\n\nThis patch also includes smaller fixups related to this bug and patch:\n- https://phabricator.services.mozilla.com/D263925\n- https://phabricator.services.mozilla.com/D264372\n\nOriginal Revision: https://phabricator.services.mozilla.com/D264155\n\nDifferential Revision: https://phabricator.services.mozilla.com/D264618\n", "files": ["toolkit/components/extensions/Extension.sys.mjs", "toolkit/mozapps/extensions/internal/XPIDatabase.sys.mjs", "toolkit/mozapps/extensions/internal/XPIInstall.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/head_addons.js", "toolkit/mozapps/extensions/test/xpcshell/test_data_collection_not_in_db.js", "toolkit/mozapps/extensions/test/xpcshell/xpcshell.toml"], "git_node": "f031088fb4dcd74bae8aac2e2be52a9f49ae1312", "git_parents": ["ccbc5e6940e38ac58facb944a7d2d42ff1f86e30"], "node": "56c490bcad501e85ef080897eec11d9d246d228e", "parents": ["4f7ad536599f9854c13a6b78036e89c9f6d07761"], "tags": []}], "date": 1758301370, "git_changesets": ["f031088fb4dcd74bae8aac2e2be52a9f49ae1312"], "user": "dmeehan@mozilla.com"}, "229": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D265594\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "869bc13cbde049737665be2108d02e7ec5b0595d", "git_parents": ["f031088fb4dcd74bae8aac2e2be52a9f49ae1312"], "node": "d433c44eecc9da3898fdaca140cd0e070274c99e", "parents": ["56c490bcad501e85ef080897eec11d9d246d228e"], "tags": []}], "date": 1758542607, "git_changesets": ["869bc13cbde049737665be2108d02e7ec5b0595d"], "user": "dmeehan@mozilla.com"}, "230": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1987624 - wasm: Refactor GetBufferSource.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D264478\n\nDifferential Revision: https://phabricator.services.mozilla.com/D265497\n", "files": ["js/src/wasm/WasmJS.cpp"], "git_node": "fdb7d96e3c2c50a610f776988c41727f965f95ef", "git_parents": ["869bc13cbde049737665be2108d02e7ec5b0595d"], "node": "18b9a7189cc9c442a83f8c86997b7266658bad7e", "parents": ["d433c44eecc9da3898fdaca140cd0e070274c99e"], "tags": []}], "date": 1758549897, "git_changesets": ["fdb7d96e3c2c50a610f776988c41727f965f95ef"], "user": "dmeehan@mozilla.com"}, "231": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1987227 part 1 - Add test for cmp8 with byte registers on x64.  a=dmeehan DONTBUILD\n\nThis uses the Zydis disassembler to check the generated code is what we expect.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D264054\n\nDifferential Revision: https://phabricator.services.mozilla.com/D264207\n", "files": ["js/src/jsapi-tests/moz.build", "js/src/jsapi-tests/testAssemblerCodeGen.cpp"], "git_node": "21ba16fd5204de33fabf905f8565d0ef20111004", "git_parents": ["fdb7d96e3c2c50a610f776988c41727f965f95ef"], "node": "7a6140d1daa5e5ffc89604197c0b98c85612deab", "parents": ["18b9a7189cc9c442a83f8c86997b7266658bad7e"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1987227 part 2 - Emit correct instructions for cmp8 with byte registers on x64.  a=dmeehan DONTBUILD\n\nUse `oneByteOp8` to emit the `REX` prefix for byte registers if needed. This fixes an\nissue with our code for `LStringToLowerCase` for certain register combinations/values.\n\nWith patches for bug 1986983 this was caught by jit-tests on Win64-debug builds.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D263972\n\nDifferential Revision: https://phabricator.services.mozilla.com/D264208\n", "files": ["js/src/jit/x86-shared/BaseAssembler-x86-shared.h", "js/src/jsapi-tests/testAssemblerCodeGen.cpp"], "git_node": "92b634843b173afd31173ab7f853d8f1108836d5", "git_parents": ["21ba16fd5204de33fabf905f8565d0ef20111004"], "node": "c92630a3ae4656f365a838c4e7d050cd1d28ef5a", "parents": ["7a6140d1daa5e5ffc89604197c0b98c85612deab"], "tags": []}], "date": 1758550005, "git_changesets": ["21ba16fd5204de33fabf905f8565d0ef20111004", "92b634843b173afd31173ab7f853d8f1108836d5"], "user": "dmeehan@mozilla.com"}, "232": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1987780 - Add releas