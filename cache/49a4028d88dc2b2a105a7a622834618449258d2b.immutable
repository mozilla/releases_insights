/intermediates.json"], "git_node": null, "git_parents": [null], "node": "bcb9d62bcc2593212813311cf41e2c0114ffdc3a", "parents": ["cb47d9f70f81d05779825c53f40da20016668dda"], "tags": []}], "date": 1627315512, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "293": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1717922 - Blockify outside markers at used value time rather than at computed value time. r=jfkthame, a=jcristau\nTrusting the display value in style_adjuster is wrong, as some elements\nforce a given kind of frame (like \u003cdetails\u003e).", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-pseudo/marker-display-computed.html.ini"], "git_node": null, "git_parents": [null], "node": "4538308a7ec667050942e572f277f6569af022e1", "parents": ["bcb9d62bcc2593212813311cf41e2c0114ffdc3a"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1720031 - Check for SetInitializedLength when reordering. r=iain a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D120626", "files": ["js/src/jit/InstructionReordering.cpp"], "git_node": null, "git_parents": [null], "node": "d05f240578e805116dfef848b167ea49e5163b93", "parents": ["4538308a7ec667050942e572f277f6569af022e1"], "tags": []}], "date": 1627377104, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "294": {"changesets": [{"author": "Csoregi Natalia \u003cncsoregi@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 4538308a7ec6 (bug 1717922) for failures on marker-display-computed.html. a=backout", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-pseudo/marker-display-computed.html.ini"], "git_node": null, "git_parents": [null], "node": "73435f09e1d9e00fce7f31a66e060fef4c10ec58", "parents": ["d05f240578e805116dfef848b167ea49e5163b93"], "tags": []}], "date": 1627385859, "git_changesets": [null], "user": "ncsoregi@mozilla.com"}, "295": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1717922 - Blockify outside markers at used value time rather than at computed value time. r=jfkthame, a=pascal\n\nTrusting the display value in style_adjuster is wrong, as some elements force a given kind of frame (like \u003cdetails\u003e).", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs"], "git_node": null, "git_parents": [null], "node": "c3427a79e7df1e101163eefbfbb49a76480a967d", "parents": ["73435f09e1d9e00fce7f31a66e060fef4c10ec58"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1720568: Be more explicit about the WorkerPrivate self-reference. r=dom-worker-reviewers,asuth a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D120630", "files": ["dom/workers/WorkerPrivate.cpp"], "git_node": null, "git_parents": [null], "node": "19adff12c5d9160d25645ae6e60780acb90003c2", "parents": ["c3427a79e7df1e101163eefbfbb49a76480a967d"], "tags": []}], "date": 1627389005, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "296": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1618067 - rebuild-cached-tasks action r=#taskgraph a=release DONTBUILD\n\nCached tasks help us reuse existing tasks for toolchain, docker-image,\nand fetch tasks, among others. This saves us compute cycles and\nend-to-end time; it also allows us to keep these artifacts pinned\nuntil we rebuild, which is a way to keep non-deterministic\nartifacts, like docker images, in a predictable state.\n\nHowever, occasionally we need to rebuild these tasks, e.g. when we\nrotate the CoT key and want to invalidate the old key that we signed\nthe existing cached_tasks with. Until now, this process was unwieldy.\nNow we have an action to allow us to do this at will.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D118749", "files": ["taskcluster/taskgraph/actions/rebuild_cached_tasks.py"], "git_node": null, "git_parents": [null], "node": "d1450b0eaf8d89b6b57257c1a795a79d984f2e78", "parents": ["19adff12c5d9160d25645ae6e60780acb90003c2"], "tags": []}], "date": 1627511084, "git_changesets": [null], "user": "asasaki@mozilla.com"}, "297": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D121172", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "96708d60105a0ee8614e87debbbb8b5a4692ac15", "parents": ["d1450b0eaf8d89b6b57257c1a795a79d984f2e78"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1696138 - Make a copy of the host before calling getaddrinfo. r=kershaw, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D118010", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/dns/GetAddrInfo.cpp"], "git_node": null, "git_parents": [null], "node": "65d51d00fb9ec78db97ab18efd68fcc3e73f2877", "parents": ["96708d60105a0ee8614e87debbbb8b5a4692ac15"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1662