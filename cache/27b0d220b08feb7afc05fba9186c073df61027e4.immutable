3e", "branch": "default", "desc": "No bug - Tagging 17fcbdf6426663c10da5d0ba21927e71184304c3 with FIREFOX_115_8_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "25871339447abece83cc74a51b16d5db3031eb88", "parents": ["b126672a1eedf871fa1c11dddd974641a2da66a3"], "tags": []}], "date": 1708437490, "git_changesets": [null], "user": "ffxbld"}, "270": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1879488: Update time zone data to tzdata2024a.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D201196\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201954", "files": ["config/external/icu/data/icudt73l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/windowsZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/windowsZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/windowsZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/windowsZones.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js"], "git_node": null, "git_parents": [null], "node": "b10cb96ee33a098db62c4c15f95baa421eb1acb9", "parents": ["25871339447abece83cc74a51b16d5db3031eb88"], "tags": []}], "date": 1708552369, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "271": {"changesets": [{"author": "dependabot[bot] \u003c49699333+dependabot[bot]@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1841705 [wpt PR 40879] - Bump aioquic from 0.9.20 to 0.9.21 in /tools, a=testonly\n\nAutomatic update from web-platform-tests\nBump aioquic from 0.9.20 to 0.9.21 in /tools\n\nBumps [aioquic](https://github.com/aiortc/aioquic) from 0.9.20 to 0.9.21.\n- [Commits](https://github.com/aiortc/aioquic/compare/0.9.20...0.9.21)\n\n---\nupdated-dependencies:\n- dependency-name: aioquic\n  dependency-type: direct:production\n  update-type: version-update:semver-patch\n...\n\nSigned-off-by: dependabot[bot] \u003csupport@github.com\u003e\n--\n\nwpt-commits: d86eab89c1e5dc4220c89d56cf4e5691ccedc542\nwpt-pr: 40879", "files": ["testing/web-platform/tests/tools/webtransport/requirements.txt", "testing/web-platform/tests/tools/wptrunner/requirements_chromium.txt"], "git_node": null, "git_parents": [null], "node": "334741e700a54ead2e0931a86c3606b2c32a11c6", "parents": ["b10cb96ee33a098db62c4c15f95baa421eb1acb9"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 1827252 - updating aioquic version to 0.9.21. r=jgraham, a=test-only", "files": ["python/sites/wpt.txt"], "git_node": null, "git_parents": [null], "node": "fe5cb7666a3e5fedfa6c936459d8e568b3330607", "parents": ["334741e700a54ead2e0931a86c3606b2c32a11c6"], "tags": []}], "date": 1708568285, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "272": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1879825 - Make Family::FindIndex fallible and safely handle failures. r=gfx-reviewers,lsalzman, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201819", "files": ["gfx/thebes/SharedFontList.cpp", "gfx/thebes/SharedFontList.h"], "git_node": null, "git_parents": [null], "node": "15a6f4db05fee2dea438cdf66836354e63416c90", "parents": ["fe5cb7666a3e5fedfa6c936459d8e568b3330607"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1879444 - Make SafeRefPtr move assignment work as RefPtr does r=smaug,dom-storage-reviewers,asuth, a-dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201598", "files": ["dom/indexedDB/SafeRefPtr.h"], "git_node": null, "git_parents": [null], "node": "8d29923301cbca248fd98559e62c208c40cdfc9d", "parents": ["15a6f4db05fee2dea438cdf66836354e63416c90"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202407", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "7c2a6bcc682e56fc248b4479e574487160ca91a5", "parents": ["8d29923301cbca248fd98559e62c208c40cdfc9d"], "tags": []}], "date": 1708607893, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "273": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851570 - [for esr] Allow necko to know when client auth is selected to drive TLS handshake, r=necko-reviewers,valentin, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201722", "files": ["netwerk/protocol/http/TlsHandshaker.cpp", "netwerk/protocol/http/nsITlsHandshakeListener.idl", "netwerk/test/unit/test_client_auth_with_proxy.js", "netwerk/test/unit/xpcshell.ini", "security/manager/ssl/NSSSocketControl.cpp"], "git_node": null, "git_parents": [null], "node": "a64b95dfc24a1cfa9fc63f5dc3f635993ac561dd", "parents": ["7c2a6bcc682e56fc248b4479e574487160ca91a5"], "tags": []}], "date": 1708619717, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "274": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset a64b95dfc24a (bug 1851570) for causing xpcshell failures, a=backout", "files": ["netwerk/protocol/http/TlsHandshaker.cpp", "netwerk/protocol/http/nsITlsHandshakeListener.idl", "netwerk/test/unit/test_client_auth_with_proxy.js", "netwerk/test/unit/xpcshell.ini", "security/manager/ssl/NSSSocketControl.cpp"], "git_node": null, "git_parents": [null], "node": "04cbfcf89188fddd5b11141dfe653385648c3e0d", "parents": ["a64b95dfc24a1cfa9fc63f5dc3f635993ac561dd"], "tags": []}], "date": 1708629932, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "275": {"changesets": [{"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1858496 - Crash on OOM in ICU;  a=diannaS\n\nWe're seeing inconsistent handling of OOMs in the ICU library. This\npatch changes the behaviour to crash on OOM rather than allowing\nICU to handle the allocation failure. The inconsistent handling in ICU\ncould lead to ICU being in an inconsistent state which could in turn\ncause security problems. The safer alternative is to crash, but it's\npossible this will lead to too high of crash rate.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D191892\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202498", "files": ["xpcom/build/XPCOMInit.cpp"], "git_node": null, "git_parents": [null], "node": "ed4feddaa2024cc0d9af4de7aa16cde901b2702b", "parents": ["04cbfcf89188fddd5b11141dfe653385648c3e0d"], "tags": []}], "date": 1708636122, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "276": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1881093 - Cherry-pick dav1d commit 2b475307. r=chunmin a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202247", "files": ["third_party/dav1d/src/decode.c", "third_party/dav1d/src/internal.h"], "git_node": null, "git_parents": [null], "node": "abeabe4f7ff257cbedcb40bd08fb00342d64de8d", "parents": ["ed4feddaa2024cc0d9af4de7aa16cde901b2702b"], "tags": []}], "date": 1708729085, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "277": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1871112 - ESR 115: Specialize AddAttributes for \u003chtml\u003e/\u003cbody\u003e. r=hsivonen, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202303", "files": ["parser/html/nsHtml5TreeOperation.cpp"], "git_node": null, "git_parents": [null], "node": "337a357bf24fa5dc7cdec1d75a9a522ddfd70151", "parents": ["abeabe4f7ff257cbedcb40bd08fb00342d64de8d"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1685358 - Apply seek threshold after decoder creation. r=media-playback-reviewers,padenot, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201297", "files": ["dom/media/platforms/wrappers/MediaChangeMonitor.cpp", "dom/media/platforms/wrappers/MediaChangeMonitor.h"], "git_node": null, "git_parents": [null], "node": "0d4bf7bc5866f2a5337195236484ffdaf68dc4a7", "parents": ["337a357bf24fa5dc7cdec1d75a9a522ddfd70151"], "tags": []}], "date": 1708732217, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "278": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851570 - [for esr] Allow necko to know when client auth is selected to drive TLS handshake, r=necko, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201722", "files": ["netwerk/protocol/http/TlsHandshaker.cpp", "netwerk/protocol/http/nsITlsHandshakeListener.idl", "netwerk/test/unit/test_client_auth_with_proxy.js", "netwerk/test/unit/xpcshell.ini", "security/manager/ssl/NSSSocketControl.cpp"], "git_node": null, "git_parents": [null], "node": "cf90e0fe4b077523bd5ec335a9845523bfdc1d43", "parents": ["0d4bf7bc5866f2a5337195236484ffdaf68dc4a7"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202705", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json"], "git_node": null, "git_parents": [null], "node": "a42e9838a9aa87a60feeb9b0a4ae02f1fa6a3600", "parents": ["cf90e0fe4b077523bd5ec335a9845523bfdc1d43"], "tags": []}], "date": 1708961719, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "279": {"changesets": [{"author": "John Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880562 - land NSS NSS_3_90_2_RTM UPGRADE_NSS_RELEASE,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202015\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202017", "files": ["security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/doc/rst/releases/nss_3_90_2.rst", "security/nss/lib/freebl/mpi/mpi-priv.h", "security/nss/lib/freebl/mpi/mpi.c", "security/nss/lib/freebl/mpi/mpi.h", "security/nss/lib/freebl/mpi/mpmontg.c", "security/nss/lib/freebl/rsa.c", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/sslsecur.c", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "41273d890f85927e407a3009f908d0137ebf4baf", "parents": ["a42e9838a9aa87a60feeb9b0a4ae02f1fa6a3600"], "tags": []}], "date": 1708970514, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "280": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1873763: Add 'overflow:hidden' to root scroller in some grid reftests, to avoid running afoul of scrollbar-presence nondeterminism.  a=diannaS\n\nThis is a workaround for an edge-case where the default 'overflow:auto' setup\ncan lead to a layout with or without a scrollbar, depending on whether the\nfirst layout happens before vs. after the DOM is fully complete.  See\nexplanations in https://bugzilla.mozilla.org/show_bug.cgi?id=1873763#c0 and in\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1873749 for more details. This\nbehavior seems to be common to all major browser engines, so it's probably not\nworth worrying about too much, which is why I'm simply working around it in\nthese tests.\n\nThe changes to the -001 test files will address intermittent bug 1522442, and\nthe changes to the -010 and -011 test files are to address intermittent\nbug 1809735.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D198080\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202738", "files": ["layout/reftests/css-grid/grid-repeat-auto-fill-fit-001-ref.html", "layout/reftests/css-grid/grid-repeat-auto-fill-fit-001.html", "layout/reftests/css-grid/grid-repeat-auto-fill-fit-010-ref.html", "layout/reftests/css-grid/grid-repeat-auto-fill-fit-010.html", "layout/reftests/css-grid/grid-repeat-auto-fill-fit-011.html"], "git_node": null, "git_parents": [null], "node": "c718bef67d432768d9ee6cec52d314a80df81aed", "parents": ["41273d890f85927e407a3009f908d0137ebf4baf"], "tags": []}], "date": 1708975339, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "281": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1878346 - revert unwanted revert of file_bug514732_window.xhtml. a=test-only DONTBUILD\n\nThe revert of the file in bug 1874627 had been unintended.", "files": ["layout/generic/test/file_bug514732_window.xhtml"], "git_node": null, "git_parents": [null], "node": "83d1c3fc0bb76fef9a99376a350cd49e2d00a5ab", "parents": ["c718bef67d432768d9ee6cec52d314a80df81aed"], "tags": []}], "date": 1709030878, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "282": {"changesets": [{"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880405: Post cell span restyle event for border-collapsed MathML table cells.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202455\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202493", "files": ["layout/tables/nsTableCellFrame.cpp"], "git_node": null, "git_parents": [null], "node": "2512e45d287cc2764a34ed160b18580e5927f502", "parents": ["83d1c3fc0bb76fef9a99376a350cd49e2d00a5ab"], "tags": []}], "date": 1709131355, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "283": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1755186 - HpackDynamicTableReporter::CollectReports should hold a mutex  a=diannaS\n\nHpackDynamicTableReporter::mMutex protects access to HpackDynamicTableReporter::mCompressor\nnvFIFO::mMutex protects access to mvFIFO::mTable - is aquired when adding or removing elements in the table, and when reporting SizeOfDynamicTable\n\nOriginal Revision: https://phabricator.services.mozilla.com/D200814\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202906", "files": ["netwerk/protocol/http/Http2Compression.cpp", "netwerk/protocol/http/Http2Compression.h"], "git_node": null, "git_parents": [null], "node": "15a99446c279ec8797bb17ec9efcf78b6d3bf920", "parents": ["2512e45d287cc2764a34ed160b18580e5927f502"], "tags": []}], "date": 1709137003, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "284": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1874235 - Make the WER interceptor more robust  a=diannaS\n\n* Always provide a value for the installation time, even when we fail to read it from the corresponding file\n* Parse the parent PID correctly\n* Create the pending folder if it's missing\n\nOriginal Revision: https://phabricator.services.mozilla.com/D198699\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202825", "files": ["toolkit/crashreporter/mozwer-rust/lib.rs"], "git_node": null, "git_parents": [null], "node": "806f87437f00ba72cd6bb725129f196127c2329c", "parents": ["15a99446c279ec8797bb17ec9efcf78b6d3bf920"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872920 - Make the crash reporter client locate the executable by itself  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D199352\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202912", "files": ["toolkit/crashreporter/client/crashreporter.cpp", "toolkit/crashreporter/client/moz.build", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": null, "git_parents": [null], "node": "48f187ce1d9826a34350770cd0a4386bcf0f8fc9", "parents": ["806f87437f00ba72cd6bb725129f196127c2329c"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872920 - Change the way we identify the parent process  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D199353\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202913", "files": ["build/workspace-hack/Cargo.toml", "toolkit/crashreporter/mozwer-rust/lib.rs", "toolkit/crashreporter/mozwer-rust/moz.build"], "git_node": null, "git_parents": [null], "node": "d63417193b5f5c79aaa85b7eb048e6553d826d46", "parents": ["48f187ce1d9826a34350770cd0a4386bcf0f8fc9"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872920 - Prevent the crash reporer from restarting Firefox when dealing with WER crashes  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D199856\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202914", "files": ["toolkit/crashreporter/client/crashreporter.cpp", "toolkit/crashreporter/docs/index.rst", "toolkit/crashreporter/mozwer-rust/lib.rs"], "git_node": null, "git_parents": [null], "node": "c507da671b492bd13e36ec9e196e60cff5f0b483", "parents": ["d63417193b5f5c79aaa85b7eb048e6553d826d46"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872920 - Introduce the process_reader crate  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D201590\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202915", "files": ["Cargo.lock", "toolkit/crashreporter/process_reader/Cargo.toml", "toolkit/crashreporter/process_reader/src/error.rs", "toolkit/crashreporter/process_reader/src/lib.rs", "toolkit/crashreporter/process_reader/src/process_reader.rs", "toolkit/crashreporter/process_reader/src/process_reader/windows.rs"], "git_node": null, "git_parents": [null], "node": "a89e97918b1bc4cb14011bd6f63b91e5809d27d7", "parents": ["c507da671b492bd13e36ec9e196e60cff5f0b483"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872920 - Change how we notify the main process when we intercept a crash via WER  a=diannaS\n\nThis patch makes several fundamental changes to the logic we use to inform\nthe main process whenever the WER runtime exception module intercepts a child\nprocess crash:\n\n* We no longer read the process type or any other data from the child process;\n  the process type is passed as the runtime exception module's context\n* We no longer read the address of the memory area used to communicate with the\n  main process from the child process arguments. Instead we allocate memory\n  directly into the main process and store the required information there\n* We don't read anything from the main process either, the pointer to the\n  function used to notify the main process is now found by looking out its\n  dedicated section in the parent process' xul.dll mapping\n* We no longer read the OOM crash annotation from a child process, this\n  functionality will be restored by making the module use the mozannotation\n  crates to fetch all the annotations\n\nOriginal Revision: https://phabricator.services.mozilla.com/D201589\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202916", "files": ["Cargo.lock", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "mozglue/misc/RuntimeExceptionModule.cpp", "toolkit/crashreporter/mozwer-rust/Cargo.toml", "toolkit/crashreporter/mozwer-rust/lib.rs", "toolkit/crashreporter/mozwer-rust/moz.build", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.h", "toolkit/xre/nsEmbedFunctions.cpp"], "git_node": null, "git_parents": [null], "node": "1247a19d2f5b22fa2bf2e86620f528a4a7811dbb", "parents": ["a89e97918b1bc4cb14011bd6f63b91e5809d27d7"], "tags": []}], "date": 1709150406, "git_changesets": [null, null, null, null, null, null], "user": "dsmith@mozilla.com"}, "285": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872920 - Fix building mozwer-rust for rust version 1.69.0  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D203050", "files": ["toolkit/crashreporter/process_reader/src/process_reader/windows.rs"], "git_node": null, "git_parents": [null], "node": "332453ecfde5358ed67c6a97698ee0aa31b23603", "parents": ["1247a19d2f5b22fa2bf2e86620f528a4a7811dbb"], "tags": []}], "date": 1709158773, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "286": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D203411", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "94862e45d9d39e11fed0032419ef3e6563d2904a", "parents": ["332453ecfde5358ed67c6a97698ee0aa31b23603"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1880692, part 1 - Make StringBuilder::Unit::mLength specific to literals. r=smaug, a=RyanVM\n\nThat is the only case that uses it. This might save a bit of space\nand avoids some useless stores. Idea by peterv.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202344", "files": ["dom/base/nsContentUtils.cpp"], "git_node": null, "git_parents": [null], "node": "ab88c34b160cac83122c86bc83b40a06f22bf1ba", "parents": ["94862e45d9d39e11fed0032419ef3e6563d2904a"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1880692, part 2 - Use an estimate for encoded characters. r=smaug, a=RyanVM\n\nThis makes the calculation simpler and faster, at a hopefully small\ncost in space. Idea by peterv.\n\nThis reduced the time to run a microbenchmark locally by around 12%.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202281", "files": ["dom/base/nsContentUtils.cpp"], "git_node": null, "git_parents": [null], "node": "8986273499ef76354be00ae7fe1a4e2ece3fab97", "parents": ["ab88c34b160cac83122c86bc83b40a06f22bf1ba"], "tags": []}], "date": 1709579781, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "287": {"changesets": [{"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1876675,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202932\n\nDifferential Revision: https://phabricator.services.mozilla.com/D203626", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "toolkit/modules/PopupNotifications.sys.mjs"], "git_node": null, "git_parents": [null], "node": "eb5d8b4a594cd33427fe55cbcbbfacbe19290738", "parents": ["8986273499ef76354be00ae7fe1a4e2ece3fab97"], "tags": []}], "date": 1709671079, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "288": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1879939: Save output registers.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D201684\n\nDifferential Revision: https://phabricator.services.mozilla.com/D203291", "files": ["js/src/jit/arm/MacroAssembler-arm.cpp"], "git_node": null, "git_parents": [null], "node": "f080bbff0923c02ded4bda2f288cb76aa27875f7", "parents": ["eb5d8b4a594cd33427fe55cbcbbfacbe19290738"], "tags": []}], "date": 1709683368, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "289": {"changesets": [{"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1804978: Prevent release assert crashes due to a race when opening context menus on macOS. r=mstange, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198700", "files": ["widget/cocoa/MOZMenuOpeningCoordinator.mm"], "git_node": null, "git_parents": [null], "node": "aab792a24e14a312b33fd70523eec77f399efa07", "parents": ["f080bbff0923c02ded4bda2f288cb76aa27875f7"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D203895", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "574b999ac4466bd3ed6f2da3786942e904aa9e2a", "parents": ["aab792a24e14a312b33fd70523eec77f399efa07"], "tags": []}], "date": 1709821317, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "290": {"changesets": [{"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1878818 - Change search-telemetry schema to use the same sub-schema syntax as search-config - r=Standard8, a=dsmith\n\nI think the main issue was the use of ids, but also just to keep things a consistent\nbetween the two in case a team member has to learn how to modify both, it might be\nbetter to use the same syntax.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D200754", "files": ["browser/components/search/schema/search-telemetry-schema.json"], "git_node": null, "git_parents": [null], "node": "285eb41f942d174613f677bccba393c49066b070", "parents": ["574b999ac4466bd3ed6f2da3786942e904aa9e2a"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1879714 - Update search-telemetry-v2 schema with more functionality and loosen restrictions on component types - r=Standard8, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201313", "files": ["browser/components/search/schema/search-telemetry-schema.json"], "git_node": null, "git_parents": [null], "node": "609a303537efc908096c11ea395f877b9ca7889e", "parents": ["285eb41f942d174613f677bccba393c49066b070"], "tags": []}], "date": 1709923163, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "291": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1881257 - Reset mSourceTopWindowContext when drag session end;  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D203103\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204101", "files": ["widget/nsBaseDragService.cpp"], "git_node": null, "git_parents": [null], "node": "c56185de4d6de223bacaca3702a50d8368a90e8a", "parents": ["609a303537efc908096c11ea395f877b9ca7889e"], "tags": []}], "date": 1709939601, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "292": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1883868 - Don't fire http loads from workers. r=jfkthame, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D203927", "files": ["gfx/thebes/gfxUserFontSet.cpp", "layout/style/FontFaceImpl.cpp", "testing/web-platform/tests/html/canvas/offscreen/manual/the-offscreen-canvas/offscreencanvas-worker-font-load-crash.html"], "git_node": null, "git_parents": [null], "node": "eac05307e86ac219754dad95903b2bd77c8cfbe1", "parents": ["c56185de4d6de223bacaca3702a50d8368a90e8a"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Bug 1883868 - Restrict new codepath to worker threads. a=dsmith\n\nSo as to not change load timing from stylo threads.", "files": ["gfx/thebes/gfxUserFontSet.cpp"], "git_node": null, "git_parents": [null], "node": "b1a9839f82305b18dfd3edc07e79fece06d7f3d1", "parents": ["eac05307e86ac219754dad95903b2bd77c8cfbe1"], "tags": []}], "date": 1710007325, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "293": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1870499 - HttpChannelChild::Release should pass itself using std::move  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202796\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204061", "files": ["netwerk/protocol/http/HttpChannelChild.cpp"], "git_node": null, "git_parents": [null], "node": "59f87ac1fb42dcfa0d6b7f140a65f46c8c6bee5b", "parents": ["b1a9839f82305b18dfd3edc07e79fece06d7f3d1"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1870499 - Break potential runnable loop in HttpChannelChild::Release  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202797\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204062", "files": ["netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelChild.h"], "git_node": null, "git_parents": [null], "node": "aa4cd4d62f70b999c7fa64e0ef501f4acd765ef1", "parents": ["59f87ac1fb42dcfa0d6b7f140a65f46c8c6bee5b"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1870499 - Make sure ContinueDoNotifyListener is called immediately during release  a=diannaS\n\nThe causes of the runnable loop are as follows:\n1. In Release we have a special case to make sure OnStart&OnStop are always\n   called. We do this by dispatching a runnable that calls DoNotifyListener.\n2. DoNotifyListener is called, then the reference to the channel is again\n   dropped. But at this point only OnStartRequest was called, and\n   ContinueDoNotifyListener was added to mEventQ. That means another\n   runnable would be dispatched.\n\nWhile the loop was broken in the previous patch, we still want to ensure\nOnStopRequest is called before the channel is released, so this patch\nadds an argument to DoNotifyListener to select whether ContinueDoNotifyListener\nshould be called synchronously or dispatched to mEventQ.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202798\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204063", "files": ["netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelChild.h"], "git_node": null, "git_parents": [null], "node": "04ba905a00865daa029245dee9a8fe7eff3ecac9", "parents": ["aa4cd4d62f70b999c7fa64e0ef501f4acd765ef1"], "tags": []}], "date": 1710103168, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "294": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204210", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "f3dd0afed51cb7283d4fa06a0c40286eee657e30", "parents": ["04ba905a00865daa029245dee9a8fe7eff3ecac9"], "tags": ["FIREFOX_115_9_0esr_BUILD1"]}], "date": 1710160583, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "295": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f3dd0afed51cb7283d4fa06a0c40286eee657e30 with FIREFOX_115_9_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "bb47ce0137b04e798a4ebb30b8ca669a630c316f", "parents": ["f3dd0afed51cb7283d4fa06a0c40286eee657e30"], "tags": []}], "date": 1710186839, "git_changesets": [null], "user": "ffxbld"}, "296": {"changesets": [{"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861016 - some fixes. r=media-playback-reviewers,jolin, a=RyanVM", "files": ["media/gmp-clearkey/0.1/ClearKeyUtils.cpp"], "git_node": null, "git_parents": [null], "node": "423e963b3d9b923e3c7fae8eae2f626f02c15cf2", "parents": ["bb47ce0137b04e798a4ebb30b8ca669a630c316f"], "tags": ["FIREFOX_115_9_0esr_BUILD2", "FIREFOX_115_9_0esr_RELEASE"]}], "date": 1710380496, "git_changesets": [null], "user": "ryanvm@gmail.com"}}
}";