ython/taskcluster/taskcluster/queueevents.py", "third_party/python/taskcluster/taskcluster/secrets.py", "third_party/python/taskcluster/taskcluster/treeherderevents.py", "third_party/python/taskcluster/taskcluster/utils.py", "third_party/python/taskcluster/test/test_async.py", "third_party/python/taskcluster/test/test_client.py", "third_party/python/taskcluster/test/test_utils.py"], "git_node": null, "git_parents": [null], "node": "53fd9b6081618cb5e5d2f291f5d2bb5e8c810b7f", "parents": ["6248ace3a5010e3dc4b33beea2da45a259c3d2fe"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1492128: [mozrelease] Add mozrelease tests to taskcluster; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10147", "files": ["taskcluster/ci/source-test/python.yml"], "git_node": null, "git_parents": [null], "node": "376d2bf874d452fab90f5b69822dfcd2036b26d3", "parents": ["53fd9b6081618cb5e5d2f291f5d2bb5e8c810b7f"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1492128: Add `VOLUME` definitions to base debian images; r=gps\n\nFor tasks that only need python, the base images are sufficient. The in-tree\ncode verifies that the caches are setup as volumes in the image being used,\nso set the caches in the base images as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10148", "files": ["taskcluster/docker/debian-base/Dockerfile"], "git_node": null, "git_parents": [null], "node": "ae67721d8d1432e94b3e6b39d4b49125e169eedc", "parents": ["376d2bf874d452fab90f5b69822dfcd2036b26d3"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1492128: Set TASKCLUSTER_ROOT_URL in tasks that use the taskcluster proxy; r=dustin\n\nThis sets `TASKCLUSTER_BASE_URL` instead of `TASKCLUSTER_ROOT_URL`, since the proxy doesn't support the redeployable URL schema yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10149", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "4585f0bba945bd55ee2082ed0b1e28359a8b7b55", "parents": ["ae67721d8d1432e94b3e6b39d4b49125e169eedc"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1492128: [mozrelease] Import buglist_creator from build-tools; r=mtabara\n\nThis is imported from https://hg.mozilla.org/build/tools/file/482c0f6537d47f7cbf1326066ecd1d3efbbd53a7\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10150", "files": ["python/mozrelease/mozrelease/buglist_creator.py", "python/mozrelease/test/test_buglist_creator.py"], "git_node": null, "git_parents": [null], "node": "144b86ee4a5c4939501164818280ce2d88e6afe2", "parents": ["4585f0bba945bd55ee2082ed0b1e28359a8b7b55"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1492128: [mozrelease] Add buglist_creator to test-suite; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10151", "files": ["python/mozrelease/mozrelease/buglist_creator.py", "python/mozrelease/test/python.ini", "python/mozrelease/test/test_buglist_creator.py"], "git_node": null, "git_parents": [null], "node": "d3cbc4397cf6d5f6cc701c992a6895d9f4dac0b8", "parents": ["144b86ee4a5c4939501164818280ce2d88e6afe2"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1492128: [mozrelease] Fix flake8 errors in buglist_creator; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10152", "files": ["python/mozrelease/mozrelease/buglist_creator.py", "python/mozrelease/test/data/buglist_changesets.json", "python/mozrelease/test/test_buglist_creator.py"], "git_node": null, "git_parents": [null], "node": "0b195464716bdb35e84b447cb84a6da522453032", "parents": ["d3cbc4397cf6d5f6cc701c992a6895d9f4dac0b8"], "tags": []}, {"author": "Tom Prince \u0