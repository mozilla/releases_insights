ess based on\nordering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9848", "files": ["taskcluster/taskgraph/generator.py"], "git_node": null, "git_parents": [null], "node": "3293ad5ea912b565a68aeff4b8518553565479b2", "parents": ["94c021c8063f37dc1ccee3d3749f85fc3e343c56"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1501113 Disable local partials caching to work around races r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9628", "files": ["taskcluster/docker/funsize-update-generator/runme.sh"], "git_node": null, "git_parents": [null], "node": "af2316056c9d1d2747204803d41ec4d85abc6752", "parents": ["3293ad5ea912b565a68aeff4b8518553565479b2"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502253: [taskgraph] Remove unsupported docker-engine worker implementation; r=dustin\n\nTrying to use this will fail, as there isn't a payload builder for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9862", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "b303538ab605360e10837f14490e3bd38ccee5cc", "parents": ["af2316056c9d1d2747204803d41ec4d85abc6752"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502253: [taskgraph] Give reasonable error message when an error is made in task.run blocks; r=dustin,aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9863", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "e2cffaf66b9f61f27665a7384d71f45ab3c06dbc", "parents": ["b303538ab605360e10837f14490e3bd38ccee5cc"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502253: [taskgraph] Remove some single-variant `Any` schemas; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9885", "files": ["taskcluster/taskgraph/cron/schema.py", "taskcluster/taskgraph/transforms/fetch.py", "taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/tests.py"], "git_node": null, "git_parents": [null], "node": "3ab71896eab3feb5b88ffda3b9a1f09d51a2e8d6", "parents": ["e2cffaf66b9f61f27665a7384d71f45ab3c06dbc"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502749: [taskgraph] Use the correct index rank for index-tasks morphs; r=bstack\n\nWhen a task gets too routes to be indexed by the queue, we create a new\ndependent task that generates the index tasks. This task didn't set the index\nrank, so if a task gets new routes that push it over the limit, it would stop\nupdating the old index, as it would be using an index of 0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10016", "files": ["taskcluster/docker/index-task/insert-indexes.js", "taskcluster/taskgraph/morph.py", "taskcluster/taskgraph/test/test_morph.py"], "git_node": null, "git_parents": [null], "node": "ba57fc465057269698381f448794b78c31606965", "parents": ["3ab71896eab3feb5b88ffda3b9a1f09d51a2e8d6"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1500897 - geckoview: only spin beetmover tasks on GECKOVIEW_XX_RELBRANCH r=dustin,tomprince\n\ngeckoview: only spin beetmover tasks on GECKOVIEW_XX_RELBRANCH\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9551", "files": ["taskcluster/docs/attributes.rst", "taskcluster/docs/parameters.rst", "taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/actions/util.py", "taskcluster/taskgraph/cron/__init__.py", "taskcluster/taskgraph/cron/util.py", "taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/target_tasks.py", "taskcluster/taskgraph/test/test_decision.py", "taskcluster/taskgraph/test/test_target_tasks.py", "taskcluster/taskgraph/transforms/task.py", "taskcluster/taskgraph/util/attributes.py", "taskcluster/taskgraph/util/hg.py"], "git_node": null, "git_parents": [null], "node": "ee4c2821597a1510c5065edba925b572ad090e6d", "parents": ["ba57fc465057269698381f448794b78c31606965"], "tags": []}, {"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1499590 - Thunderbird fixes in periodic_file_updates.sh. r=sfraser\n\nUpdates to periodic_file_updates.sh to complete Thunderbird support\n\n- added comm- branch support so that repository URL's are correctly determined\n- set COMMIT_AUTHOR appropriately for Thunderbird\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9259", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "e23cfc1643f8b5ca0067996dba681cb50936e0d4", "parents": ["ee4c2821597a1510c5065edba925b572ad090e6d"], "tags": []}, {"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1500897 - Follow-up: Get hg_branch from GECKO repo. r=jorgk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10135", "files": ["taskcluster/taskgraph/decision.py"], "git_node": null, "git_parents": [null], "node": "4a550cde28b558787f76485fd4d7110080579611", "parents": ["e23cfc1643f8b5ca0067996dba681cb50936e0d4"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502531: [mozharness] Upload mozharness builds logs; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9965", "files": ["taskcluster/taskgraph/transforms/job/mozharness.py", "taskcluster/taskgraph/transforms/job/mozharness_test.py"], "git_node": null, "git_parents": [null], "node": "6e3c80e6621b28793bbaedc624c1ea59a84cdf63", "parents": ["4a550cde28b558787f76485fd4d7110080579611"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502531: [mozharness] Stop needlessly copying around mozharness logs; r=Callek\n\nTaskcluster knows where mozharness generates the logs, and can upload them from\nthere. Thus, mozharness no longer needs to copy the logs to a new directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9966", "files": ["testing/mozharness/mozharness/base/script.py", "testing/mozharness/test/test_base_script.py"], "git_node": null, "git_parents": [null], "node": "466cbb4f9a21849907522cba905eec3b408e079e", "parents": ["6e3c80e6621b28793bbaedc624c1ea59a84cdf63"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502531: [mozharness] Move `abs_upload_dir` code to openh264_build script; r=Callek\n\nThat variable, and the function that references it is only used by the openh264\ncode, so move it there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9967", "files": ["testing/mozharness/mozharness/base/script.py", "testing/mozharness/scripts/openh264_build.py", "testing/mozharness/test/test_l10n_locales.py"], "git_node": null, "git_parents": [null], "node": "690014be4a684f7667e78c34c217b8bf6a96f876", "parents": ["466cbb4f9a21849907522cba905eec3b408e079e"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1403131: [mozharness] Run lint against tests; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10250", "files": ["testing/mozharness/test/test_base_config.py", "testing/mozharness/test/test_base_log.py", "testing/mozharness/test/test_base_script.py", "testing/mozharness/test/test_base_vcs_mercurial.py", "testing/mozharness/test/test_l10n_locales.py", "testing/mozharness/test/test_mozilla_merkle.py", "tools/lint/flake8.yml"], "git_node": null, "git_parents": [null], "node": "7cb626330a70cc571e17987135a0917bd19fd9d8", "parents": ["690014be4a684f7667e78c34c217b8bf6a96f876"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1503644 - Start submitting Beta Language packs to AMO in 'listed' state. r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10406", "files": ["taskcluster/ci/release-sign-and-push-langpacks/kind.yml"], "git_node": null, "git_parents": [null], "node": "cb31ed7865f3455b9d0ede0c37fa1fa250f5030c", "parents": ["7cb626330a70cc571e17987135a0917bd19fd9d8"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502531: [mozharness] Adjust paths used for logs in tests too; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10320", "files": ["taskcluster/taskgraph/transforms/job/mozharness_test.py"], "git_node": null, "git_parents": [null], "node": "481694d463e324fc0a05d1e9bdf26fea3248bef2", "parents": ["cb31ed7865f3455b9d0ede0c37fa1fa250f5030c"], "tags": []}, {"author": "Jordan Lund \u003cjlund@mozilla.com\u003e", "branch": "default", "desc": "Bug 1503445 - update release owner for  hsts hpkp blocklist r=RyanVM\n\nupdate release owner for  hsts hpkp blocklist\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10321", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "b0d51163fbbbac0acf767f04cd33a458c4290326", "parents": ["481694d463e324fc0a05d1e9bdf26fea3248bef2"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1490247 - Use a relative directory for MOZ_FETCHES_DIR on Mac too. r=ahal", "files": ["taskcluster/taskgraph/transforms/job/__init__.py"], "git_node": null, "git_parents": [null], "node": "f20a8730f48b1c8613db4dde59216595b3155ce7", "parents": ["b0d51163fbbbac0acf767f04cd33a458c4290326"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1475510 - Use locale from dep job attributes. r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9333", "files": ["taskcluster/taskgraph/transforms/repackage.py", "taskcluster/taskgraph/util/attributes.py"], "git_node": null, "git_parents": [null], "node": "ffdd345eb0ce34077949d124945c30db5bd9bfac", "parents": ["f20a8730f48b1c8613db4dde59216595b3155ce7"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1504906 - Add support for building non-amd64 Debian packages. r=gps\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11139", "files": ["taskcluster/taskgraph/transforms/job/debian_package.py"], "git_node": null, "git_parents": [null], "node": "d9b1a02567c005920d0cb5f4a5c7941bf53b2756", "parents": ["ffdd345eb0ce34077949d124945c30db5bd9bfac"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "bug 1505652: [taskgraph] Download debian packages from latest run of package task; r=dustin\n\nIf a packaging task ended up being retried for any reason, the downstream\ndocker tasks that depended on them would fail, since they were hard-coding the\nartifacts from the initial run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7364", "files": ["taskcluster/docker/debian-base/setup_packages.sh", "taskcluster/taskgraph/transforms/job/debian_package.py"], "git_node": null, "git_parents": [null], "node": "ed403babe69de4a21baedaa3e8c13010ecac3721", "parents": ["d9b1a02567c005920d0cb5f4a5c7941bf53b2756"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1504906 - Use a separate docker image for base toolchain builds. r=gps\n\nWe're going to bump our shipped builds to build against Gtk+ 3.10, but\nstill want to ensure we can still build against Gtk+ 3.4. As we're using\nGtk+ packages installed in the build docker image, we need to have a\nseparate image where the Gtk+ packages are kept at version 3.4.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11137", "files": ["taskcluster/ci/build/linux.yml", "taskcluster/ci/docker-image/kind.yml"], "git_node": null, "git_parents": [null], "node": "b423610d11df102a37000ad57ff531657d33781f", "parents": ["ed403babe69de4a21baedaa3e8c13010ecac3721"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Add support for early-to-late-beta migration; r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11393", "files": ["testing/mozharness/configs/merge_day/early_to_late_beta.py", "tools/tryselect/selectors/release.py"], "git_node": null, "git_parents": [null], "node": "b6efde50bfce526fc51c591fb59714284e9310a3", "parents": ["b423610d11df102a37000ad57ff531657d33781f"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Allow specifying no migrations for staging releases; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11388", "files": ["tools/tryselect/docs/selectors/release.rst", "tools/tryselect/selectors/release.py"], "git_node": null, "git_parents": [null], "node": "799c5c4e87def6bedf7c4107b2f66bfdacb56f1c", "parents": ["b6efde50bfce526fc51c591fb59714284e9310a3"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Include devedition platforms in on-push changesets; r=Callek\n\nThe on-push changsets are re-used for the default set of locales for try\nstaging runs. Include deveditions platforms to support try staging deved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11389", "files": ["browser/locales/l10n-onchange-changesets.json"], "git_node": null, "git_parents": [null], "node": "53e87612566ab647006e7ad7d02afef1c3c43ea3", "parents": ["799c5c4e87def6bedf7c4107b2f66bfdacb56f1c"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Don't generate versions with `esr` in them; r=nthomas\n\nBalrog accepts them, but then fails to serve them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11390", "files": ["tools/tryselect/selectors/release.py"], "git_node": null, "git_parents": [null], "node": "b681fb1173acea10f4d5cf0e75c1352513449d95", "parents": ["53e87612566ab647006e7ad7d02afef1c3c43ea3"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Geneate the correct release_type for esr60 staging runs; r=nthomas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11391", "files": ["tools/tryselect/selectors/release.py"], "git_node": null, "git_parents": [null], "node": "4cd6379244e627c6f96907ede33577eae5f34fef", "parents": ["b681fb1173acea10f4d5cf0e75c1352513449d95"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Filter out appropriate tasks for staging release on non-beta branches; r=nthomas\n\nWe should:\n- filter out android builds on esr branches\n- filter out devedition builds on non-beta branches\n- look at the branch corresponding to the release type in beta-sims for\n  evaluating `run-on-projects`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11392", "files": ["taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "ce67eed72dcc64c1bb93fc5846e18312d63844ca", "parents": ["4cd6379244e627c6f96907ede33577eae5f34fef"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1486071 - Retry docker-image and packages tasks that fail during apt-get. r=dustin\n\nWhen apt-get fails, it has a distinctive error code (100). Most of the\ntime, when apt-get fails, it's because of some network error, or\npossibly some problem unpacking archives. When that happens, retrying\nthe task usually \"fixes\" the issue.\n\nOne of the (currently) most common causes of problems is\nsnapshot.debian.org not being available to some of the EC2 instances.\n\nIt would be possible to only set things up so that we only retry when we\ndetect such setup (checking the public IP of the instance is not in the\nknown list of problematic IPs), but that would require possibly wrapping\napt-get, or something along those line, which is not entirely trivial to\ndo for the packages tasks, because they don't rely on docker images.\n\nHowever, since there aren't many apt-get failures other than these,\nand since there have been, historically, some intermittent apt-get\nfailures of a different nature that were solved by re-running the tasks,\nit seems fair to just retry wheneven apt-get fails.\n\nOne downside of the approach is that if for some reason a change to a\nDockerfile ends up mentioning a package that doesn't exist, that too\nwill result in multiple retries ; which might be inconvenient, but\nthat's not something that's going to happen often.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11420", "files": ["taskcluster/taskgraph/transforms/docker_image.py", "taskcluster/taskgraph/transforms/job/debian_package.py", "taskcluster/taskgraph/util/docker.py"], "git_node": null, "git_parents": [null], "node": "20f90f3014dd981ab383aa714191769ed0cde0ec", "parents": ["ce67eed72dcc64c1bb93fc5846e18312d63844ca"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1506920: [taskgraph] Track parent images in docker image digests; r=dustin\n\nThe digest for a docker image task did not include the digest for the parent\nimage in it, and so in particular did not depend on the versions of packages\nincluded in a parent image.\n\nIf two branches have a docker image with identical docker files, but different\nparents, this would lead to them both getting the same digest, leading to\nunexpected interference between the branches.\n\nThis fixes things by including the digest of the parent image as input into the\ndigest of child images.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11807", "files": ["taskcluster/docs/attributes.rst", "taskcluster/taskgraph/transforms/docker_image.py", "taskcluster/taskgraph/util/cached_tasks.py"], "git_node": null, "git_parents": [null], "node": "71ea54ddb753f6c8ea6efcddc0b904fdce44a7c1", "parents": ["20f90f3014dd981ab383aa714191769ed0cde0ec"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1507030 - Use the same docker image for opt and debug base-toolchain jobs. r=froydnj\n\nBug 1504906 added a separate docker image for those (with Gtk+ 3.4), and\nswitched the opt build to it, but forgot the debug build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11838", "files": ["taskcluster/ci/build/linux.yml"], "git_node": null, "git_parents": [null], "node": "ccb0c2c9989c76e7b6e1b8aedb4714b009f0a40c", "parents": ["71ea54ddb753f6c8ea6efcddc0b904fdce44a7c1"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [taskgraph] Don't mutate a dictionary while iterating it in beetmover_repackage; r=dustin\n\nIterating a container while mutating it has undefined behavior. This caused a\ndecision task[1] to fail once, so stop doing it here.\n\n\n[1] https://treeherder.mozilla.org/#/jobs?repo=autoland&searchStr=decision&revision=3c9736576736aba5810577e6b89ae00e5e9a6b98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12062", "files": ["taskcluster/taskgraph/transforms/beetmover_repackage.py"], "git_node": null, "git_parents": [null], "node": "28cecbe99d559c7baa2759cc82c63948c2ee4117", "parents": ["ccb0c2c9989c76e7b6e1b8aedb4714b009f0a40c"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1506319 Change log levels for bouncer check failures r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12259", "files": ["testing/mozharness/scripts/release/bouncer_check.py"], "git_node": null, "git_parents": [null], "node": "9496eb02b4591d17229ba4fd0de8a16ae6b0a749", "parents": ["28cecbe99d559c7baa2759cc82c63948c2ee4117"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1506310: Remove unused branch_name passed from taskcluster to talos; r=jmaher\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12076", "files": ["taskcluster/taskgraph/transforms/tests.py", "testing/mozharness/mozharness/mozilla/testing/talos.py", "testing/talos/talos/cmdline.py", "testing/talos/talos/config.py", "testing/talos/talos/unittests/test_config.py", "testing/talos/talos/unittests/test_talosconfig_browser_config.json"], "git_node": null, "git_parents": [null], "node": "8c64f4130d865bedcdc04aa7760657b2792e96b5", "parents": ["9496eb02b4591d17229ba4fd0de8a16ae6b0a749"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1506310: Determine whether builds under test need signed extenions by release type; r=bc,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12077", "files": ["taskcluster/ci/test/kind.yml", "taskcluster/taskgraph/transforms/tests.py"], "git_node": null, "git_parents": [null], "node": "57c6bca5255e0961a0fe37a6843a06e3e089c1be", "parents": ["8c64f4130d865bedcdc04aa7760657b2792e96b5"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1507898: [taskgraph] Factor out schema validation in transformations; r=dustin\n\nMost jobs include at least one transform that verifies the input of all the\ntasks against a schema. This code is duplicated in each transform. Refactor it,\nso that we only need one copy of the logic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12165", "files": ["taskcluster/taskgraph/transforms/balrog_submit.py", "taskcluster/taskgraph/transforms/base.py", "taskcluster/taskgraph/transforms/beetmover.py", "taskcluster/taskgraph/transforms/beetmover_checksums.py", "taskcluster/taskgraph/transforms/beetmover_emefree_checksums.py", "taskcluster/taskgraph/transforms/beetmover_langpack_checksums.py", "taskcluster/taskgraph/transforms/beetmover_push_to_release.py", "taskcluster/taskgraph/transforms/beetmover_repackage.py", "taskcluster/taskgraph/transforms/beetmover_repackage_partner.py", "taskcluster/taskgraph/transforms/beetmover_source_checksums.py", "taskcluster/taskgraph/transforms/checksums_signing.py", "taskcluster/taskgraph/transforms/diffoscope.py", "taskcluster/taskgraph/transforms/docker_image.py", "taskcluster/taskgraph/transforms/fetch.py", "taskcluster/taskgraph/transforms/google_play_strings.py", "taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/l10n.py", "taskcluster/taskgraph/transforms/push_apk.py", "taskcluster/taskgraph/transforms/release_beetmover_signed_addons.py", "taskcluster/taskgraph/transforms/release_generate_checksums_beetmover.py", "taskcluster/taskgraph/transforms/release_generate_checksums_signing.py", "taskcluster/taskgraph/transforms/release_sign_and_push_langpacks.py", "taskcluster/taskgraph/transforms/release_snap_push.py", "taskcluster/taskgraph/transforms/repackage.py", "taskcluster/taskgraph/transforms/repackage_partner.py", "taskcluster/taskgraph/transforms/repackage_routes.py", "taskcluster/taskgraph/transforms/repackage_signing.py", "taskcluster/taskgraph/transforms/repackage_signing_partner.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/source_checksums_signing.py", "taskcluster/taskgraph/transforms/source_test.py", "taskcluster/taskgraph/transforms/tests.py"], "git_node": null, "git_parents": [null], "node": "91a2cc19c4b791cedf35dde2cd0e561d03d72a1c", "parents": ["57c6bca5255e0961a0fe37a6843a06e3e089c1be"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1506254 - Support TBPL_RETRY in structured logger, to enable task retry; r=jmaher", "files": ["testing/mozharness/mozharness/mozilla/structuredlog.py"], "git_node": null, "git_parents": [null], "node": "17c90b5fed5dba1fbcf989f0699fd2f8724ebae7", "parents": ["91a2cc19c4b791cedf35dde2cd0e561d03d72a1c"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1507860: [taskgraph] Move most classes to use attrs; r=dustin\n\nThis moves most of the low-hanging fruit to use attrs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1141", "files": ["taskcluster/taskgraph/generator.py", "taskcluster/taskgraph/graph.py", "taskcluster/taskgraph/morph.py", "taskcluster/taskgraph/task.py", "taskcluster/taskgraph/taskgraph.py", "taskcluster/taskgraph/transforms/base.py", "taskcluster/taskgraph/util/seta.py", "taskcluster/taskgraph/util/verify.py"], "git_node": null, "git_parents": [null], "node": "930a7b1001b61acc2eb3782334ae5a965f31fb0e", "parents": ["17c90b5fed5dba1fbcf989f0699fd2f8724ebae7"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1508049: [funsize] Don't verify decoded download length against HTTP header; r=sfraser\n\nWhen Content-Encoding is specified, the decoded length won't match the lenght\nin the header. In any case aiohttp has code that verifies the length, so we\ndon't need to do it as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12342", "files": ["taskcluster/docker/funsize-update-generator/scripts/funsize.py"], "git_node": null, "git_parents": [null], "node": "a9479c9788cee4b71d32a02774b6189be8227158", "parents": ["930a7b1001b61acc2eb3782334ae5a965f31fb0e"], "tags": []}, {"author": "Aki Sasaki \u003caki@escapewindow.com\u003e", "branch": "default", "desc": "Bug 1501878 - point partials at unsigned complete mars. r=tomprince\n\nPartial MAR generation doesn't need a signed complete MAR.\nBy pointing the partials tasks at the unsigned complete MARs, we are\nable to defer signing the complete MARs without deferring partials\ncreation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11729", "files": ["taskcluster/ci/partials/kind.yml", "taskcluster/taskgraph/transforms/partials.py"], "git_node": null, "git_parents": [null], "node": "98834fead28de87f589bb2e4769d037e4caba70b", "parents": ["a9479c9788cee4b71d32a02774b6189be8227158"], "tags": []}, {"author": "Aki Sasaki \u003caki@escapewindow.com\u003e", "branch": "default", "desc": "Bug 1501878 - drop complete mar from repackage-signing. r=tomprince\n\nWe want to defer mar-signing to the second half of the promote phase,\nbut we want to keep Windows repackaged exe signing in the first half of\nthe promote phase. This means we need to stop signing the complete MAR\nin repackage-signing, and defer it to another kind.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11730", "files": ["taskcluster/ci/beetmover-repackage/kind.yml", "taskcluster/ci/repackage-signing-l10n/kind.yml", "taskcluster/ci/repackage-signing/kind.yml", "taskcluster/taskgraph/transforms/beetmover_repackage.py", "taskcluster/taskgraph/transforms/repackage_signing.py"], "git_node": null, "git_parents": [null], "node": "931ac407ca9737932cb862a364fbe0f471a31b2b", "parents": ["98834fead28de87f589bb2e4769d037e4caba70b"], "tags": []}, {"author": "Aki Sasaki \u003caki@escapewindow.com\u003e", "branch": "default", "desc": "Bug 1501878 - add mar-signing{,-l10n} kinds. r=tomprince,Callek\n\nalso rename the partials_signing transform to mar_signing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11731", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/mar-signing-l10n/kind.yml", "taskcluster/ci/mar-signing/kind.yml", "taskcluster/ci/partials-signing/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/mar_signing.py", "taskcluster/taskgraph/transforms/partials_signing.py"], "git_node": null, "git_parents": [null], "node": "f4c93cc911062d9378b8e4231cc0b98a43395a3a", "parents": ["931ac407ca9737932cb862a364fbe0f471a31b2b"], "tags": []}, {"author": "Aki Sasaki \u003caki@escapewindow.com\u003e", "branch": "default", "desc": "Bug 1501878 - beetmove complete mars. r=tomprince,Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11732", "files": ["taskcluster/ci/beetmover-repackage/kind.yml", "taskcluster/taskgraph/transforms/beetmover_repackage.py"], "git_node": null, "git_parents": [null], "node": "95e0fbfd2dec15cd5612bcf3351994c7b575a7d9", "parents": ["f4c93cc911062d9378b8e4231cc0b98a43395a3a"], "tags": []}, {"author": "Aki Sasaki \u003caki@escapewindow.com\u003e", "branch": "default", "desc": "Bug 1501878 - required_signoffs and signoff_urls parameters r=tomprince\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11733", "files": ["taskcluster/docs/parameters.rst", "taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/parameters.py"], "git_node": null, "git_parents": [null], "node": "dc0942024727b1b092d4eb1c77a58fda3a543f3f", "parents": ["95e0fbfd2dec15cd5612bcf3351994c7b575a7d9"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1501878: [taskgraph] Verify that required signoffs propagate to dependent tasks; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12041", "files": ["taskcluster/taskgraph/util/verify.py"], "git_node": null, "git_parents": [null], "node": "fdd96cefe3e001cfe1998734b31dcd3e8d3c8ff6", "parents": ["dc0942024727b1b092d4eb1c77a58fda3a543f3f"], "tags": []}, {"author": "Aki Sasaki \u003caki@escapewindow.com\u003e", "branch": "default", "desc": "Bug 1501878 - required_signoffs attribute. r=tomprince\n\nIf a task has `required_signoffs` that match a release's `required_signoffs`, we should defer running that task until we have a matching `signoff_url`.\n\n- add filter_out_missing_signoffs\n- add transforms changes to inherit upstream `required_signoffs`\n- add `mar-signing` `required_signoffs` to the `partials-signing`, `mar-signing`, and `mar-signing-l10n` kinds\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11734", "files": ["taskcluster/ci/mar-signing-l10n/kind.yml", "taskcluster/ci/mar-signing/kind.yml", "taskcluster/ci/partials-signing/kind.yml", "taskcluster/docs/attributes.rst", "taskcluster/taskgraph/loader/multi_dep.py", "taskcluster/taskgraph/target_tasks.py", "taskcluster/taskgraph/transforms/balrog_submit.py", "taskcluster/taskgraph/transforms/beetmover_repackage.py", "taskcluster/taskgraph/transforms/beetmover_repackage_l10n.py", "taskcluster/taskgraph/transforms/mar_signing.py", "taskcluster/taskgraph/transforms/per_platform_dummy.py", "taskcluster/taskgraph/transforms/release_deps.py", "taskcluster/taskgraph/transforms/release_generate_checksums_beetmover.py", "taskcluster/taskgraph/transforms/release_snap_push.py", "taskcluster/taskgraph/util/attributes.py"], "git_node": null, "git_parents": [null], "node": "ab3b676a22ea4ae5605a955c8c673e51a4f44309", "parents": ["fdd96cefe3e001cfe1998734b31dcd3e8d3c8ff6"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492245 - Switch Fennec format from `jar` to `autograph_apk_fennec_sha1` r=mtabara\n\nSwitch Fennec format from `jar` to `autograph_apk_fennec_sha1`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12685", "files": ["taskcluster/taskgraph/util/signed_artifacts.py"], "git_node": null, "git_parents": [null], "node": "ed897e983193dde5a5475552c13321bc9c911600", "parents": ["ab3b676a22ea4ae5605a955c8c673e51a4f44309"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1507635 - Log reftest.manifests and reftest.tests when there is an error with them. r=ahal", "files": ["layout/tools/reftest/reftest.jsm"], "git_node": null, "git_parents": [null], "node": "0fb2cab11e3c1e4963a63031a67de0cb1fe6e9cf", "parents": ["ed897e983193dde5a5475552c13321bc9c911600"], "tags": []}, {"author": "Chris Pearce \u003ccpearce@mozilla.com\u003e", "branch": "default", "desc": "Bug 1503776 - Whitelist setupapi.dll for read during talos tests. r=aklotz\n\nSome change in this series caused setupapi.dll to load as a dependency earlier\non in startup while loading xul.dll. I don't understand why, but setupapi.dll\nis already a dependency of xul.dll so we should be loading it anyway.\n\nWill file a follow up to investigate.\n\nhttps://treeherder.mozilla.org/#/jobs?repo=try&revision=4cf79174757b9aa88ec10ac9745a97869fa9914d\n\nDepends on D12241\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12711", "files": ["testing/talos/talos/xtalos/xperf_whitelist.json"], "git_node": null, "git_parents": [null], "node": "0e338f867c15b998a0b6a4e79fe9eebca4127295", "parents": ["0fb2cab11e3c1e4963a63031a67de0cb1fe6e9cf"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1509048 - [tryselect] Pass full taskgraph into selectors, r=marco\n\nCurrently selectors that generate the taskgraph receive a list of task labels\nback. While this works, it isn't very robust and limits the selectors in what\nthey can accomplish.\n\nFor example, it means we need to use regexes to map test suites to tasks. If\nwe had the full taskgraph, we could use filter functions instead.\n\nThere are also new selectors in the works which will need this (like ./mach\ntry chooser). Finally the try syntax selector would also need this if we\never migrate it to use the 'try_task_config.json' format.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12570", "files": ["tools/tryselect/selectors/fuzzy.py", "tools/tryselect/tasks.py", "tools/tryselect/test/setup.sh"], "git_node": null, "git_parents": [null], "node": "2dfcf2b798ce4ccebecb94f3916bc44d09f49eb2", "parents": ["0e338f867c15b998a0b6a4e79fe9eebca4127295"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1509900 - Improve documentation for taskcluster-load-image. r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12932", "files": ["taskcluster/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "db616c45632859044c735aae3836102c486b1f24", "parents": ["2dfcf2b798ce4ccebecb94f3916bc44d09f49eb2"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1482395: [mozrelease] Add support for generating update metadata; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12707", "files": ["python/mozrelease/mozrelease/balrog.py", "python/mozrelease/mozrelease/util.py", "python/mozrelease/test/data/Firefox-62.0.3.update.json", "python/mozrelease/test/data/Firefox-62.0b11-update.json", "python/mozrelease/test/data/Firefox-62.0b11.update.json", "python/mozrelease/test/data/whatsnew-62.0.3.yml", "python/mozrelease/test/data/whatsnew-release.yml", "python/mozrelease/test/python.ini", "python/mozrelease/test/test_balrog.py"], "git_node": null, "git_parents": [null], "node": "18505b1a3afb79943aa6ec75c6e124a5d183f3c8", "parents": ["db616c45632859044c735aae3836102c486b1f24"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1482395: [mozrelease] Generate whats new blob and populate it during release; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12708", "files": ["browser/config/whats_new_page.yml", "build/sparse-profiles/taskgraph", "taskcluster/ci/balrog/kind.yml", "taskcluster/ci/release-balrog-submit-toplevel/kind.yml", "taskcluster/ci/release-secondary-balrog-submit-toplevel/kind.yml", "taskcluster/taskgraph/transforms/balrog_submit.py", "taskcluster/taskgraph/transforms/balrog_toplevel.py", "taskcluster/taskgraph/transforms/task.py", "tools/lint/yaml.yml"], "git_node": null, "git_parents": [null], "node": "e659d82e2f45480aaf65a10ed0b191201e3e3a1e", "parents": ["18505b1a3afb79943aa6ec75c6e124a5d183f3c8"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1482395: [mozrelease] Fix product details links for beta and deveditions; r=sfraser\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13225", "files": ["python/mozrelease/test/data/Firefox-62.0b11.update.json", "python/mozrelease/test/data/Firefox-64.0b13.update.json", "python/mozrelease/test/test_balrog.py", "taskcluster/taskgraph/transforms/balrog_toplevel.py"], "git_node": null, "git_parents": [null], "node": "8300b35286e0870ab68f18064e956389dd6503cc", "parents": ["e659d82e2f45480aaf65a10ed0b191201e3e3a1e"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1509973 - Follow-up to increase timeout for windows ASAN reftests. r=me", "files": ["taskcluster/ci/test/reftest.yml"], "git_node": null, "git_parents": [null], "node": "2d679757fc10996ffa012c3294aa3c59149b4364", "parents": ["8300b35286e0870ab68f18064e956389dd6503cc"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1486970: [taskgraph] Make find_hg_revision_pushlog_id more re-usable; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13103", "files": ["taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/util/hg.py"], "git_node": null, "git_parents": [null], "node": "4ba5c33da199f8d1ec3524b7853e7e4d4a4f4474", "parents": ["2d679757fc10996ffa012c3294aa3c59149b4364"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1486970: [taskgraph] Add retries to getting pushlog information; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13104", "files": ["taskcluster/taskgraph/util/hg.py"], "git_node": null, "git_parents": [null], "node": "15f9dda16c3fd901e3b1c658d0759cec48ceea1f", "parents": ["4ba5c33da199f8d1ec3524b7853e7e4d4a4f4474"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1486970 - Create revision and pushlog-id index routes for cron decision tasks. r=dustin,aki\n\nThis changeset actually creates the new routes we want for decision tasks, and adds the supporting code for passing push info\nin to the taskgraph.\n\nThis must land after scriptworker is updated and deployed. This has the affect of also un-hardcoding the .taskcluster.yml\nfields applied in the first part of this bug.\n\nThis changeset in particular will ride trains and not be uplifted (outside of compelling reasons).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5195", "files": [".taskcluster.yml", "taskcluster/taskgraph/cron/decision.py"], "git_node": null, "git_parents": [null], "node": "3dd7049aa480d020bcfde95dbf0bfce435e15bb5", "parents": ["15f9dda16c3fd901e3b1c658d0759cec48ceea1f"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1486970: [taskgraph] Remove dead parameter to `make_decision_task` in cron; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13107", "files": ["taskcluster/taskgraph/cron/decision.py"], "git_node": null, "git_parents": [null], "node": "377030f12fb749106e2f9bb9673d1ce41161ec78", "parents": ["3dd7049aa480d020bcfde95dbf0bfce435e15bb5"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1471905: [taskgraph] Fix some typos in docker image transform; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12063", "files": ["taskcluster/taskgraph/transforms/docker_image.py"], "git_node": null, "git_parents": [null], "node": "fe21d8d6197d64533262f3e90a802875d47aaa12", "parents": ["377030f12fb749106e2f9bb9673d1ce41161ec78"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1471905: [taskgraph] Don't calculate docker context hashes if asked for a fast taskgraph; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12064", "files": ["taskcluster/taskgraph/transforms/docker_image.py"], "git_node": null, "git_parents": [null], "node": "b8aa3aa9632371ba5307fb2772ed564214959ef7", "parents": ["fe21d8d6197d64533262f3e90a802875d47aaa12"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1397847: Add supported API to get tasks of a given kind from a taskgraph; r=dustin\n\n`mach artifact toolchain` gets task definitions from taskgraph, to get the\nindex path to find the artifacts at. Now that these index paths depend on the\ndigests of fetch tasks, those kinds need to be loaded as well. This adds a\nsupported API to get task definitions for a given kind, which loads all the\nkind dependencies.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12161", "files": ["python/mozbuild/mozbuild/mach_commands.py", "taskcluster/mach_commands.py", "taskcluster/taskgraph/generator.py", "taskcluster/taskgraph/transforms/job/__init__.py"], "git_node": null, "git_parents": [null], "node": "4cf0b2332bce6d7f51c04809ae1baf362a993bfd", "parents": ["b8aa3aa9632371ba5307fb2772ed564214959ef7"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1454685: [taskgraph] Load docker images based on digest generated by the task; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12167", "files": ["taskcluster/taskgraph/docker.py", "taskcluster/taskgraph/util/cached_tasks.py"], "git_node": null, "git_parents": [null], "node": "95222021c29fa785d7edad6db678bc05937e63c5", "parents": ["4cf0b2332bce6d7f51c04809ae1baf362a993bfd"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1510465: [taskgraph] Use `mach` job type more consistently; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13158", "files": ["taskcluster/ci/source-test/doc.yml", "taskcluster/ci/source-test/file-metadata.yml", "taskcluster/ci/upload-generated-sources/kind.yml", "taskcluster/ci/upload-symbols/kind.yml", "taskcluster/taskgraph/transforms/job/mach.py"], "git_node": null, "git_parents": [null], "node": "0567a89e9192d883015d0295be83eca5ed024b54", "parents": ["95222021c29fa785d7edad6db678bc05937e63c5"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1510465: [taskgraph] Use mach job type more consistently in release tasks; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13159", "files": ["taskcluster/ci/cron-bouncer-check/kind.yml", "taskcluster/ci/release-bouncer-check/kind.yml", "taskcluster/ci/release-secondary-update-verify-config/kind.yml", "taskcluster/ci/release-update-verify-config/kind.yml", "taskcluster/taskgraph/transforms/bouncer_check.py", "taskcluster/taskgraph/transforms/update_verify_config.py"], "git_node": null, "git_parents": [null], "node": "1c312a921adc6b4ad224526c610c0e93e8a7712b", "parents": ["0567a89e9192d883015d0295be83eca5ed024b54"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1510591 - Fix 'get_changed_files' to cope with empty commit messages. r=dustin\n\nc['desc'].splitlines()[0] raises an error because .splitlines() returns an empty list, rather than a one element list with an empty string when c['desc'] is ''. So test for c['desc'] first and then set it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13252", "files": ["taskcluster/taskgraph/files_changed.py"], "git_node": null, "git_parents": [null], "node": "a3775ec1315d23e40e8b19f8f8337b6cba84a118", "parents": ["1c312a921adc6b4ad224526c610c0e93e8a7712b"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1397847: Pass the taskcluster root to `load_tasks_for_kind` in `mach artifact toolchain`; r=dustin a=tomprince\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13433", "files": ["python/mozbuild/mozbuild/mach_commands.py", "taskcluster/taskgraph/generator.py"], "git_node": null, "git_parents": [null], "node": "ba9634bec13e7dd700d7f40f79a57c883ba5cde2", "parents": ["a3775ec1315d23e40e8b19f8f8337b6cba84a118"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1454685: Update sparse profile to allow docker images to build; r=me a=tomprince", "files": ["build/sparse-profiles/docker-image"], "git_node": null, "git_parents": [null], "node": "e734d6e5d900549912ea16f1eeb9b635c8e978ac", "parents": ["ba9634bec13e7dd700d7f40f79a57c883ba5cde2"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1506310: Fix typo in determining whether builds under test need signed extenions by release type; r=me", "files": ["taskcluster/taskgraph/transforms/tests.py"], "git_node": null, "git_parents": [null], "node": "9bbffcaaefb98d66b43936b3490014b28ef41ac4", "parents": ["e734d6e5d900549912ea16f1eeb9b635c8e978ac"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1509962: Vendor redo==2.0.2; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12973", "files": ["third_party/python/redo/PKG-INFO", "third_party/python/redo/README", "third_party/python/redo/README.md", "third_party/python/redo/redo.egg-info/PKG-INFO", "third_party/python/redo/redo.egg-info/SOURCES.txt", "third_party/python/redo/redo/__init__.py", "third_party/python/redo/redo/cmd.py", "third_party/python/redo/setup.cfg", "third_party/python/redo/setup.py"], "git_