 "image/SurfaceCache.cpp", "xpcom/base/nsMemoryReporterManager.cpp"], "git_node": null, "git_parents": [null], "node": "3ed441e5310db4207b0b3ae1c3a82d7c9f95f4f3", "parents": ["914b2e8e71e124375d682bb3d1f732c75dd72548"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 1511284 - Also ignore breakpad client r=me CLOSED TREE", "files": [".clang-format-ignore", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": null, "git_parents": [null], "node": "dfc3f6cce0bc1f402cf476cfb43888cad7c2dfc4", "parents": ["3ed441e5310db4207b0b3ae1c3a82d7c9f95f4f3"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 1445269 - Refresh tools/rewriting/ThirdPartyPaths.txt r=tjr\n", "files": [".clang-format-ignore", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": null, "git_parents": [null], "node": "562c947bf64b944bd4b31d7f17a86dcfb8828787", "parents": ["dfc3f6cce0bc1f402cf476cfb43888cad7c2dfc4"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 1464452 - Add richtext to the list of thirdparties r=andi\n\nMozReview-Commit-ID: 44BqrMb6Ko0", "files": [".clang-format-ignore", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": null, "git_parents": [null], "node": "a2d8d7d608915c2284e3ff9acafa172c5e96c5c6", "parents": ["562c947bf64b944bd4b31d7f17a86dcfb8828787"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1486502 - Add widevine CDM headers to third party paths, clang-format ignore. r=sylvestre\n\nWe wish to keep the widevine headers in the same formatting as upstream to\nease comparison and as we do not modify these files. This patch adds the\nexisting headers, as well as another we anticipate pulling down for our next\nbump (content_decryption_module_proxy.h) to the ignored paths. These files are\nignored individually rather than the whole directory they'r