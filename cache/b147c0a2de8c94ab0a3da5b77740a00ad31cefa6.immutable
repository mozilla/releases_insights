mmon/check_updates.sh", "tools/update-verify/release/common/download_builds.sh", "tools/update-verify/release/common/download_mars.sh", "tools/update-verify/release/common/installdmg.ex", "tools/update-verify/release/common/unpack-diskimage.sh", "tools/update-verify/release/common/unpack.sh", "tools/update-verify/release/compare-directories.py", "tools/update-verify/release/final-verification.sh", "tools/update-verify/release/get-update-xml.sh", "tools/update-verify/release/mar_certs/README", "tools/update-verify/release/mar_certs/dep1.der", "tools/update-verify/release/mar_certs/dep2.der", "tools/update-verify/release/mar_certs/nightly_aurora_level3_primary.der", "tools/update-verify/release/mar_certs/nightly_aurora_level3_secondary.der", "tools/update-verify/release/mar_certs/release_primary.der", "tools/update-verify/release/mar_certs/release_secondary.der", "tools/update-verify/release/mar_certs/xpcshellCertificate.der", "tools/update-verify/release/replace-updater-certs.py", "tools/update-verify/release/test-mar-url.sh", "tools/update-verify/release/updates/verify.sh", "tools/update-verify/scripts/chunked-verify.py", "tools/update-verify/scripts/chunked-verify.sh"], "git_node": null, "git_parents": [null], "node": "992c90d6e5bfd240f142c47b68dc11547335248f", "parents": ["f6ad5d08d3ec4449cfd282d6621a638da41d185d"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1509962: [update-verify] Use in-tree update-verify code; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12977", "files": ["build/sparse-profiles/update-verify", "taskcluster/ci/release-final-verify/kind.yml", "taskcluster/ci/release-secondary-final-verify/kind.yml", "taskcluster/ci/release-secondary-update-verify/kind.yml", "taskcluster/ci/release-update-verify/kind.yml", "taskcluster/taskgraph/transforms/final_verify.py", "taskcluster/taskgraph/transforms/job/run_task.py", "taskcluster/taskgraph/transforms/update_verify.py", "tools/update-verify/release/common/download_builds.sh", "tools/update-verify/release/updates/verify.sh", "tools/update-verify/scripts/chunked-verify.sh"], "git_node": null, "git_parents": [null], "node": "014512d3410ee93457d6a0ccfaae3c14c946ca3b", "parents": ["992c90d6e5bfd240f142c47b68dc11547335248f"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1509962: [update-verify] Run lint against python code in update-verify; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12978", "files": ["tools/update-verify/python/util/commands.py", "tools/update-verify/release/compare-directories.py", "tools/update-verify/release/replace-updater-certs.py", "tools/update-verify/scripts/chunked-verify.py"], "git_node": null, "git_parents": [null], "node": "20fd25ee94adcabba339c8352e2768b44f7fa70e", "parents": ["014512d3410ee93457d6a0ccfaae3c14c946ca3b"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1509962: [update-verify] Remove some unused options from update-verify code; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12979", "files": ["tools/update-verify/scripts/chunked-verify.py"], "git_node": null, "git_parents": [null], "node": "e3dfac88793ce7a268f39083cd49fa452be6334b", "parents": ["20fd25ee94adcabba339c8352e2768b44f7fa70e"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1509962: [update-verify] Use argparse in update-verify code; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12980", "files": ["tools/update-verify/scripts/chunked-verify.py"], "git_node": null, "git_parents": [null], "node": "f9b47a5c5ef8e926959e04eba6992995ceb33a3b", "parents": ["e3dfac88793ce7a268f39083cd49fa452be6334b"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1509962: [update-verify] Use taskgraph fetches in update-verify; r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12981", "files": ["taskcluster/docker/update-verify/Dockerfile", "taskcluster/taskgraph/transforms/update_verify.py", "tools/update-verify/scripts/chunked-verify.sh"], "git_node": null, "git_parents": [null], "node": "5f52ee495c758e54d1261cc81f24781e63e834dc", "parents": ["f9b47a5c5ef8e926959e04eba6992995ceb33a3b"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: Fix some rst errors in taskcluster documentation; r=me", "files": ["taskcluster/docs/actions.rst", "taskcluster/docs/attributes.rst"], "git_node": null, "git_parents": [null], "node": "67198b677c521fd1be39c4b1c502a90d884f6e4e", "parents": ["5f52ee495c758e54d1261cc81f24781e63e834dc"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1503756 - Inherit from working desktop1604-test image to work around non-deterministic rebuilding; r=dustin\n\nThe desktop1604-test image doesn't build deterministically, primarily\ndue to not pinning APT package indices. Rebuilding it from scratch\ntoday results in at least 2 problems causing test failures. One has\nto do with a renamed media device. Another is not yet determined but\nis causing the Android emulator to fail.\n\nVarious people have spent several hours trying to debug the failures.\nThere are some leads. But no obvious solution is in sight. Various\ncode landings are blocked on this.\n\nEnough is enough.\n\nThis commit modifies desktop1604-test so it inherits from a base image\nthat contains the last good build of the image. Other minimal\nmodifications were made to enable the image to build with a populated\nbase image.\n\nThis is a gross hack. It is equivalent to sweeping dust under the rug.\nBut it gets the job done. It should unblock various code landings.\n\nThe base image was imported from task K-qJkvIqQQ-EFK8-4zg_nA.\n\nThe intent is to undo this hack ASAP by fixing the base image. This is\ntracked by bug 1511527.\n\nAs part of developing this patch, I ran into at least two different\nissues building the Docker image using the last known good image as a\nbase.\n\nOn my desktop machine using btrfs for Docker storage, the image failed to\nbuild due to a \"failed to export image: failed to create image: failed\nto get layer XXX: layer does not exist\" error.\n\nIn CI, I ran into separate issues where some `rm` invocations didn't\nwork. Why, I have no clue.\n\nI ran a `docker export | docker import` of a running container with\nthe good image to produce a new Docker image with just the filesystem\ncontents. This had the effect of squashing the original Docker image\ninto a single layer. For reasons I can't explain, this made the image\nbuild in CI. Welcome to the wonderful world of Docker bugs, everyone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13600", "files": ["taskcluster/docker/desktop1604-test/Dockerfile"], "git_node": null, "git_parents": [null], "node": "68843d2182e86d2d7ed4afe24bad909b3b2d38b5", "parents": ["67198b677c521fd1be39c4b1c502a90d884f6e4e"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1497660 - Add new hg.mo fingerprint to run-task fallback; r=dustin\n\nWe duplicate the hg.mo fingerprints in run-task so we can fall\nback to known good values in case secrets retrieval fails.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10090", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "d902d530878ef879edb586e8f2e35e43d239dab8", "parents": ["68843d2182e86d2d7ed4afe24bad909b3b2d38b5"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1498640 - deploy latest image_builder image r=glandium\n\nThis uses the latest image_builder image (on docker hub) to build even the\nimage_builder image.\n\nThe change to `docker.py` handles a new API response (`aux`) from the Docker\ndaemon.  It's unclear what this key means, but displaying it is simple.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8441", "files": ["taskcluster/docker/image_builder/VERSION", "taskcluster/docs/docker-images.rst", "taskcluster/taskgraph/transforms/docker_image.py", "taskcluster/taskgraph/util/docker.py"], "git_node": null, "git_parents": [null], "node": "84b3320e3c797e2ba1d4c4a6ddb2d777c39af161", "parents": ["d902d530878ef879edb586e8f2e35e43d239dab8"], "tags": []}, {"author": "Bob Clary \u003cbclary@bclary.com\u003e", "branch": "default", "desc": "Bug 1501802 - Update tooltool.py fetch_file to log.info exceptions instead of log.debug, r=garbas", "files": ["python/mozbuild/mozbuild/action/tooltool.py", "testing/mozharness/external_tools/tooltool.py"], "git_node": null, "git_parents": [null], "node": "553a3723af1647c05ed11508d06e54a94d859c35", "parents": ["84b3320e3c797e2ba1d4c4a6ddb2d777c39af161"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1505579 - Upgrade to latest robustcheckout; r=sheehan\n\nVendored robustcheckout extension from the version-control-tools\nrepository revision d78e5c52a0228c3dc8ed03fe43bf749c8e68bd20 without\nmodifications.\n\nThis is needed to support Mercurial 4.8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11398", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "8ef5c2eb46e5eea3291a7028fa7c864964e51da3", "parents": ["553a3723af1647c05ed11508d06e54a94d859c35"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1505579 - Upgrade Docker images to Mercurial 4.8; r=sheehan\n\nWe need to run Mercurial 4.8 so we can start using SQLite storage\nand wire protocol version 2 for partial clones.\n\n--auto-deconfigure was added because desktop1604-test now inherits\nfrom a base image with Mercurial installed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11399", "files": ["taskcluster/ci/packages/kind.yml", "taskcluster/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "27f24b79926d934048a68a0c0ba485d8a360364d", "parents": ["8ef5c2eb46e5eea3291a7028fa7c864964e51da3"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512075 - Upgrade to latest robustcheckout; r=ted\n\nFrom changeset d0828787e64fa55b535c7e783bc97612f5c30cff from\nversion-control-tools repository.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13767", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "386476927e1cbdecea7c462a9ca63ce64c569478", "parents": ["27f24b79926d934048a68a0c0ba485d8a360364d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512075 - Upgrade to Mercurial 4.8.1; r=ted\n\nThis was released a few minutes ago. It contains some fixes necessary to support\npartial clones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13768", "files": ["taskcluster/ci/packages/kind.yml", "taskcluster/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "52bd33db41f27ecf8b4044f4c5f3ed344cb88bd0", "parents": ["386476927e1cbdecea7c462a9ca63ce64c569478"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1502531: Adjust test script to create the properly log directories; r=Callek\n\nDue to Bug 1503756, this couldn't be landed with the changes to the paths, as\nit changed the docker image.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10454", "files": ["taskcluster/scripts/tester/test-linux.sh"], "git_node": null, "git_parents": [null], "node": "94fb896e4a10a8faea04c61f514789498ddf3568", "parents": ["52bd33db41f27ecf8b4044f4c5f3ed344cb88bd0"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1471905: [taskgraph] Consistently include the cache digests of parent tasks in downstream cached tasks; r=dustin\n\nThere are several kinds that cache tasks based on the inputs that go into the task. Historically,\nthese inputs included the name of upstream tasks. This change these tasks to include the digest\nof the upstream tasks.\n\nThis also bumps the version of the docker and toolchain as every digest is changed for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11949", "files": ["taskcluster/ci/docker-image/kind.yml", "taskcluster/ci/packages/kind.yml", "taskcluster/ci/toolchain/kind.yml", "taskcluster/docs/attributes.rst", "taskcluster/taskgraph/transforms/cached_tasks.py", "taskcluster/taskgraph/transforms/docker_image.py", "taskcluster/taskgraph/transforms/job/debian_package.py", "taskcluster/taskgraph/transforms/job/toolchain.py", "taskcluster/taskgraph/util/cached_tasks.py"], "git_node": null, "git_parents": [null], "node": "acb4d77a70ff698c711bf1e794669ac3f40f406a", "parents": ["94fb896e4a10a8faea04c61f514789498ddf3568"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1507360: Fetch HG fingerprint; r=gps\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11966", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "028927b0e6c2f247de1590630040971bcec8cece", "parents": ["acb4d77a70ff698c711bf1e794669ac3f40f406a"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1507360: Fix python3.5 support in fetching hg fingerprints; r=gps\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13810", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "b61f8ae77ba79d5e0c35a682b5b97f1cfd343911", "parents": ["028927b0e6c2f247de1590630040971bcec8cece"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1507360: Fix flake8 error in run-task; r=gps\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13811", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "72249fbe05e7d3157caeff3691aca7faf11195b6", "parents": ["b61f8ae77ba79d5e0c35a682b5b97f1cfd343911"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512065 Remove ClamAV scanning from partials input r=tomprince\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13761", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile", "taskcluster/docker/funsize-update-generator/scripts/funsize.py"], "git_node": null, "git_parents": [null], "node": "68fc68017a9cfdf7439ebf6137ed5c066e5ba7ab", "parents": ["72249fbe05e7d3157caeff3691aca7faf11195b6"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "NO BUG - Vendor latest robustcheckout extension; r=sheehan\n\nCorresponds to revision 53c65bf08e17bc943a52e464f72a51a8ea5809e5 from\nversion-control-tools repository.", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "08005a65e224673d7c3f8f97a7c78d29b6f893c6", "parents": ["68fc68017a9cfdf7439ebf6137ed5c066e5ba7ab"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1509962: [update-verify] Import update-verify replacement certs from build-tools; r=me\n\nThese were not correctly landed by lando. These are used for staging releases,\nto verify updates from production releases.", "files": ["tools/update-verify/release/mar_certs/dep1.der", "tools/update-verify/release/mar_certs/dep2.der", "tools/update-verify/release/mar_certs/nightly_aurora_level3_primary.der", "tools/update-verify/release/mar_certs/nightly_aurora_level3_secondary.der", "tools/update-verify/release/mar_certs/release_primary.der", "tools/update-verify/release/mar_certs/release_secondary.der", "tools/update-verify/release/mar_certs/xpcshellCertificate.der"], "git_node": null, "git_parents": [null], "node": "d21e9b559dfec4d63707771b5ad1d3848088eaed", "parents": ["08005a65e224673d7c3f8f97a7c78d29b6f893c6"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1509997 - set priorities cron \u003e action \u003e decision r=tomprince\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12991", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "68c150dcf1757e32af3541fc9a809606583072f9", "parents": ["d21e9b559dfec4d63707771b5ad1d3848088eaed"], "tags": []}, {"author": "Danut Labici \u003cdlabici@mozilla.com\u003e", "branch": "default", "desc": "BUG 1500166 - notify ciduty by email if a nightly hook fails + fix identation issue. r=tomprice", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "11511aa267cf54d1a2def1d564c81aafe58a036a", "parents": ["68c150dcf1757e32af3541fc9a809606583072f9"], "tags": []}, {"author": "J.C. Jones \u003cjjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1505930 - Promote try-push analysis result r=catlee\n\n\"It's the best!\" used to be front-and-center on try push email notifications,\nwithin the content area of the automated happiness-intensifier email.\n\nBug 1490515 regressed the happiness to the far-right side of the subject line.\nIn keeping with \"It's the best!\" deserving a top-level treatment, it should be\nduplicated (by value) in the message body.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11374", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "29c89fd2e859dfab26f258b2469f8725dccac329", "parents": ["11511aa267cf54d1a2def1d564c81aafe58a036a"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Rename beta-sim to release-sim to reflect flexibility; r=aryx\n\nNow that `mach try release` also supports simulating release and esr, rename\nthe option to `release-sim`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11516", "files": ["taskcluster/taskgraph/target_tasks.py", "tools/tryselect/selectors/release.py"], "git_node": null, "git_parents": [null], "node": "cf4b0a927e1e450720b6e8e0d2b0ab503cb57273", "parents": ["29c89fd2e859dfab26f258b2469f8725dccac329"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1517652: [release] Use old signing for old complete mars; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15693", "files": ["taskcluster/taskgraph/transforms/mar_signing.py"], "git_node": null, "git_parents": [null], "node": "a4c8349f5dd0045aee078ea6c1ae5a0525b18604", "parents": ["cf4b0a927e1e450720b6e8e0d2b0ab503cb57273"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1508316: [mingw-clang] Patch mingw clang to support non-standard math definitions in C++ r=froydnj a=tomprince\n\nThis patch for mingw is being reviewed by upstream; when incorportated we will\nbump MinGW and remove the manual patch.  It is needed to ensure that M_PI,\n_finite, and other math-related functions that are not Strict ANSI are still\ndefined by MinGW. In -central; we use std=gnu++14; but on esr60 we pass std=c++\nwhich enables strict ansi mode in MinGW. This patch is less invasive than\nchanging the std flag we pass (since it affects only the MinGW build and not\nall builds.)", "files": ["build/build-clang/math.patch", "taskcluster/scripts/misc/build-clang-trunk-mingw.sh"], "git_node": null, "git_parents": [null], "node": "303a4e12ec379a442bd182a650db787981aac5e9", "parents": ["a4c8349f5dd0045aee078ea6c1ae5a0525b18604"], "tags": []}], "date": 1546628081, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "mozilla@hocat.ca"}, "288": {"changesets": [{"author": "Masatoshi Kimura \u003cVYV03354@nifty.ne.jp\u003e", "branch": "default", "desc": "Bug 1462616 - Unblock Windows 10 April 2018 Update SDK with clang-cl. r=ted, a=RyanVM\n\nMozReview-Commit-ID: 9KGu1KTmyRM", "files": ["build/moz.configure/windows.configure"], "git_node": null, "git_parents": [null], "node": "811ae8044ce43ac756eb78d77c7dcf87e7c14cea", "parents": ["303a4e12ec379a442bd182a650db787981aac5e9"], "tags": []}, {"author": "Masatoshi Kimura \u003cVYV03354@nifty.ne.jp\u003e", "branch": "default", "desc": "Bug 1484184 - Remove now unused _RAISE macro check to deal with MSVC 2017 15.8. r=froydnj, a=RyanVM", "files": ["memory/mozalloc/moz.build", "old-configure.in"], "git_node": null, "git_parents": [null], "node": "95bc53e0f0a7ca52b51a4783d943d6725f7b2e1c", "parents": ["811ae8044ce43ac756eb78d77c7dcf87e7c14cea"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1516738 - Specialize x86 code generation for byte register. r=jseward, a=RyanVM", "files": ["js/src/jit-test/tests/wasm/regress/baseline-extend8.js", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": null, "git_parents": [null], "node": "6590fd8ab9c3c1365dd852613bc6a54e28402609", "parents": ["95bc53e0f0a7ca52b51a4783d943d6725f7b2e1c"], "tags": []}], "date": 1546642483, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "289": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1516738 - Remove the test on ESR60 since it requires testing functions which aren't available on that branch. a=bustage DONTBUILD", "files": ["js/src/jit-test/tests/wasm/regress/baseline-extend8.js"], "git_node": null, "git_parents": [null], "node": "50fda92eb56ba1c584b80f123a110a8281d0e259", "parents": ["6590fd8ab9c3c1365dd852613bc6a54e28402609"], "tags": []}], "date": 1546645280, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "290": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15820", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "d71f423a11e6a3ee13cbd51952d705bb8cd44bf0", "parents": ["50fda92eb56ba1c584b80f123a110a8281d0e259"], "tags": []}], "date": 1546873987, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "291": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493743 - Make AddFamilyToFontList return safely if passed a null font-family. r=lsalzman, a=RyanVM", "files": ["gfx/thebes/gfxTextRun.cpp"], "git_node": null, "git_parents": [null], "node": "fe810e4d97774045c5fd0a87cfe6b40c80658591", "parents": ["d71f423a11e6a3ee13cbd51952d705bb8cd44bf0"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493743 - Make BuildFontList robust against an invalid FontFamilyName record with no name atom. r=lsalzman, a=RyanVM", "files": ["gfx/thebes/gfxTextRun.cpp"], "git_node": null, "git_parents": [null], "node": "421de5ff5bcba14c1e3939b8125d91683ae67f9f", "parents": ["fe810e4d97774045c5fd0a87cfe6b40c80658591"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1511701 - Apply a band-aid null check for crashes happening in the wild. r=botond, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D14621", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp"], "git_node": null, "git_parents": [null], "node": "5038a31de4fe8c9b3ec25122fa504490eba22c84", "parents": ["421de5ff5bcba14c1e3939b8125d91683ae67f9f"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1510296 - Update Google search for new codes. r=daleharvey, a=RyanVM", "files": ["browser/components/search/test/browser_google.js", "browser/components/search/test/browser_google_behavior.js", "browser/locales/search/list.json", "browser/locales/searchplugins/google-b-1-d.xml", "browser/locales/searchplugins/google-b-1-e.xml", "browser/locales/searchplugins/google-b-d.xml", "browser/locales/searchplugins/google-b-e.xml", "mobile/locales/search/list.json", "toolkit/components/search/nsSearchService.js"], "git_node": null, "git_parents": [null], "node": "acf00cfc72275f113bac9dfc25bf58878c99387e", "parents": ["5038a31de4fe8c9b3ec25122fa504490eba22c84"], "tags": []}, {"author": "David Major \u003cdmajor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1514592: Don't call RpcExceptionCode if we don't HAVE_SEH_EXCEPTIONS. r=aklotz, a=RyanVM", "files": ["ipc/mscom/StructStream.h"], "git_node": null, "git_parents": [null], "node": "a09b2a626b9c2678853b780ac522cf33dc06590c", "parents": ["acf00cfc72275f113bac9dfc25bf58878c99387e"], "tags": []}], "date": 1546972810, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "292": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493743 (esr60 followup) - The FontFamilyName.mName was still a string in this version, not an atom. a=bustage", "files": ["gfx/thebes/gfxTextRun.cpp"], "git_node": null, "git_parents": [null], "node": "ab8ca4f7cce0d51c285b52a6e2aae719cba3d847", "parents": ["a09b2a626b9c2678853b780ac522cf33dc06590c"], "tags": []}], "date": 1546973951, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "293": {"changesets": [{"author": "Kearwood \"Kip\" Gilbert \u003ckgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460619 - Do not run frame request callbacks immediately after updating a VR layer. r=dmu, a=RyanVM", "files": ["gfx/vr/ipc/VRLayerChild.cpp"], "git_node": null, "git_parents": [null], "node": "ca261c6e299d62614a46454c73ccc88bbdf162b1", "parents": ["ab8ca4f7cce0d51c285b52a6e2aae719cba3d847"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1510296 - Fix failing ESR test. r=mconnor, a=test-only", "files": ["toolkit/components/search/tests/xpcshell/test_json_cache.js"], "git_node": null, "git_parents": [null], "node": "d02b5cc2d51ba3f9a25008b13eace79af4a3f5e2", "parents": ["ca261c6e299d62614a46454c73ccc88bbdf162b1"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1446472 - Part 1: Showing the identity block icon for canvas permission without the doorhanger when canvas extraction is auto detected. r=baku,Gijs, a=RyanVM\n\nFor a better user experience of auto-blocking canvas extraction, this\npatch changes the behavior when detecting a canvas extraction without\nuser interaction. It will show a canvas identity block icon with a\nhidden doorhanger when auto-blocking the canvas extraction. Users can\nmake their choice to either block or allow the canvas extraction by\nclicking the identity block icon and then refresh the page to make\nthe canvas permission taking effect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D14259", "files": ["browser/base/content/browser.js", "dom/canvas/CanvasUtils.cpp", "dom/ipc/PBrowser.ipdl", "dom/ipc/TabParent.cpp", "dom/ipc/TabParent.h"], "git_node": null, "git_parents": [null], "node": "91e3866c264972ae1055a794f79eeac51d5e1995", "parents": ["d02b5cc2d51ba3f9a25008b13eace79af4a3f5e2"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1446472 - Part 2: Add a test for ensuring that the identity block icon will show without the doorhanger when canvas auto-blocking happens. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D14260", "files": ["browser/base/content/test/permissions/browser_canvas_fingerprinting_resistance.js"], "git_node": null, "git_parents": [null], "node": "a578196b1fe09f2804c26fa3388c9b5e9a84ca83", "parents": ["91e3866c264972ae1055a794f79eeac51d5e1995"], "tags": []}], "date": 1546993825, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "294": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1517542 - Fail URL deserialization if query or ref start at position 0. r=mayhemer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15854", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": null, "git_parents": [null], "node": "b4aa9fdd1e583ebf3b39ea862dc921e01c167130", "parents": ["a578196b1fe09f2804c26fa3388c9b5e9a84ca83"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460620 - Have MinGW look for d3dcompiler_47.dll (so it will be packaged). r=froydnj, a=RyanVM", "files": ["build/moz.configure/toolchain.configure", "old-configure.in"], "git_node": null, "git_parents": [null], "node": "6e4da7e63d3535d27171115b27f36063f6f987cf", "parents": ["b4aa9fdd1e583ebf3b39ea862dc921e01c167130"], "tags": []}], "date": 1547073623, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "295": {"changesets": [{"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487811 - P1: Update Widevine headers and C++ code to prepare for CDM interface 10 support. r=cpearce, a=RyanVM\n\nUpdate content_decryption_module.h and other Widevine headers. This removes the\nCDM8 interface and adds in the CDM10 and CDM11 interfaces. As such this patch\nremoves references to CDM8 from the code and adds some of the foundations for\nsupporting CDM10. Most of the CDM10 code will be implemented in another bug, but\nthere are a number of cases where it was straight forward to shuffle CDM8+9 code\n-\u003e CDM9+10, rather than deleting it and replacing it later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5628", "files": ["dom/media/fake-cdm/cdm-test-decryptor.h", "dom/media/gmp/ChromiumCDMAdapter.cpp", "dom/media/gmp/ChromiumCDMCallbackProxy.cpp", "dom/media/gmp/ChromiumCDMChild.cpp", "dom/media/gmp/ChromiumCDMChild.h", "dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/GMPContentChild.cpp", "dom/media/gmp/GMPUtils.h", "dom/media/gmp/moz.build", "dom/media/gmp/widevine-adapter/WidevineVideoFrame.cpp", "dom/media/gmp/widevine-adapter/WidevineVideoFrame.h", "dom/media/gmp/widevine-adapter/content_decryption_module.h", "dom/media/gmp/widevine-adapter/content_decryption_module_export.h", "dom/media/gmp/widevine-adapter/content_decryption_module_proxy.h", "dom/media/platforms/agnostic/eme/ChromiumCDMVideoDecoder.cpp", "media/gmp-clearkey/0.1/ClearKeyCDM.cpp", "media/gmp-clearkey/0.1/ClearKeyCDM.h", "media/gmp-clearkey/0.1/ClearKeyDecryptionManager.h", "media/gmp-clearkey/0.1/ClearKeySessionManager.cpp", "media/gmp-clearkey/0.1/ClearKeySessionManager.h", "media/gmp-clearkey/0.1/VideoDecoder.cpp", "media/gmp-clearkey/0.1/VideoDecoder.h"], "git_node": null, "git_parents": [null], "node": "35c330e1458531386929e79abf36e69f15634dfa", "parents": ["6e4da7e63d3535d27171115b27f36063f6f987cf"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487811 - P2: Remove CDM8 interface specific IPDL. r=cpearce, a=RyanVM\n\nRemove members only used by CDM8 from the IPDL and remove code that depended on\nthe removed IPDL. Rename various instances of 'error' to 'exception' as from\nCDM9 'exception' is used exclusively to refer to promise failure states.\n\nESR60 specific: Revert changes from Bug 1462937 as ESR60 does not include deps.\n\nDepends on D5628\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5629", "files": ["dom/media/gmp/ChromiumCDMCallback.h", "dom/media/gmp/ChromiumCDMCallbackProxy.cpp", "dom/media/gmp/ChromiumCDMCallbackProxy.h", "dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/ChromiumCDMParent.h", "dom/media/gmp/PChromiumCDM.ipdl", "dom/media/gtest/TestCDMStorage.cpp"], "git_node": null, "git_parents": [null], "node": "652ea7e854ea75f4531594a9076a7211fe390098", "parents": ["35c330e1458531386929e79abf36e69f15634dfa"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487811 - P3: Add CDM10 functions to IPDL. r=cpearce, a=RyanVM\n\nThe CDM10 interface makes 2 notable changes here:\n1) Instead of the binary choice between unencrypted and encrypted (which assumed\ncenc encryption), the interface now allows for specification of encryption used.\nPractically this means we will eventually need to support choosing between not\nencrypted, cenc, or cbcs.\n2) The interface adds a bool for hardware secure codecs for use when\ninitializing the CDM.\n\nThis changeset adjusts the IPDL for the CDM to accommodate these changes. The\nchanges are also supported in surrounding code, but are not fully plumbed to\neither the web, or the CDM.\n\nFully supporting new encryption schemes and hardware secure codecs will require\nfurther work which is beyond the scope of this bug.\n\nSome formatting drive bys so new formatting and old formatting both match\nexpected formatting by clang-format.\n\nDepends on D5629\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5630", "files": ["dom/media/gmp/ChromiumCDMChild.cpp", "dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/GMPMessageUtils.h", "dom/media/gmp/GMPTypes.ipdlh", "dom/media/gmp/PChromiumCDM.ipdl", "dom/media/gmp/gmp-api/gmp-video-codec.h"], "git_node": null, "git_parents": [null], "node": "b6ffb526c3d3c5d510cd8e4ce3c77d078e1eb269", "parents": ["652ea7e854ea75f4531594a9076a7211fe390098"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487811 - P4: Implement CDM10 -\u003e CDM9 compat layer. r=cpearce, a=RyanVM\n\nImplement a compatibility layer so that we can expose a CDM10 interface while\nstill using CDM9. Notably, this layer checks to make sure the new encryption\nscheme introduced with CDM10 is not used with CDM9.\n\nDepends on D5630\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5631", "files": ["dom/media/gmp/ChromiumCDMChild.cpp", "dom/media/gmp/ChromiumCDMChild.h", "dom/media/gmp/GMPContentChild.cpp"], "git_node": null, "git_parents": [null], "node": "bbea5c6d563d054242148ed2756fa8ded1f08af8", "parents": ["b6ffb526c3d3c5d510cd8e4ce3c77d078e1eb269"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491117 - Do not add crypto info to unencrypted samples from encrypted WebM tracks. r=jya, a=RyanVM\n\nWebMs with encrypted tracks may have unencrypted samples in these tracks.\nPreviously we would populate some of the crypto metadata on these samples. This\ndata was correct, but it was potentially misleading to include crypto metadata on\nclear samples.\n\nThis changeset alters the behaviour so that we do not populate any such data for\nunencrypted packets. This should not alter existing behaviour, notably the\nWidevine CDM version 9 should continue to work. However, this change makes our\nsamples easier to feed to version 10 of the CDM. Without this change, we would\nneed to do extra conversion steps to appease the new CDM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6183", "files": ["dom/media/webm/WebMDemuxer.cpp"], "git_node": null, "git_parents": [null], "node": "900f94556211204ebb820033a15990284aca8626", "parents": ["bbea5c6d563d054242148ed2756fa8ded1f08af8"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491889 - Update chromium CDM interface to accommodate async init. r=cpearce, a=RyanVM\n\nStarting at the Widevine CDM10 interface, the CDM is expected to make a callback\nto an `OnInititalized` function to signal initialization has taken place. Prior\nto this, it was sufficient to call the init function on the CDM, with no waiting\nfor a callback.\n\nThis changeset puts in place the IPDL to support async init, as well as the\nhandling for the ChromiumCDMParent and ChromiumCDMProxy. The code is not fully\nupdated to handle CDM10, so CDM9 is the only compatible CDM. Because CDM9 does\nnot perform the init callback, we immediately call our IPDL to signal init has\ntaken place. This also accommodates the clearkey case, which uses the CDM9\ninterface.\n\nFurther changesets will put in place more elaborate handling to accommodate the\npossible failure of init, as well as implementing the handling `OnInitialized`\nfunction explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6061", "files": ["dom/media/gmp/ChromiumCDMChild.cpp", "dom/media/gmp/ChromiumCDMChild.h", "dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/ChromiumCDMParent.h", "dom/media/gmp/ChromiumCDMProxy.cpp", "dom/media/gmp/PChromiumCDM.ipdl", "dom/media/gtest/TestCDMStorage.cpp"], "git_node": null, "git_parents": [null], "node": "01c06ac0606e7bf90e0fb655961922b13115c68b", "parents": ["900f94556211204ebb820033a15990284aca8626"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491889 - Update ChromiumCDMChild to hold a promise to track CDM init. r=cpearce, a=RyanVM\n\nThis changeset extends the async initialize functionality added in the prior\nchangeset by wrapping the Initialize resolver in a promise. This allows us to\nuse familiar promise machinery to handle async init of the CDM. We do this by\ncreating the promise and setting up handling when we receive the init message on\nthe ChromiumCDMChild, but resolving the promise in the `OnInitialized` callback\nfrom the CDM to the ChromiumCDMChild.\n\nWe still only support CDM9 as of this changeset. As such, we now manually call\n`OnInitialized` to make sure the ChromiumCDMParent is notified that the CDM has\ninitialized. When we implement the CDM10 interface, these manual calls will be\nmoved to the CDM9 compat layer, and Widevine CDM10+ can perform its own\ncallback.\n\nThis changeset adds a failure path to initialization, as the `OnInitialized`\ninterface we implement allows for failure. However, since we manually call into\nthis path for CDM9 we shouldn't get any such failures. Once CDM10 is fully\nimplemented its possible that the init callback could indicate failure, and the\nhandling here would be invoked.\n\nDepends on D6061\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6066", "files": ["dom/media/gmp/ChromiumCDMChild.cpp", "dom/media/gmp/ChromiumCDMChild.h", "dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/GMPContentChild.cpp"], "git_node": null, "git_parents": [null], "node": "0faad9929481ce4eaa0e6f0317ebf8667df53a9b", "parents": ["01c06ac0606e7bf90e0fb655961922b13115c68b"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1494178 - Add check to ChromiumCDMChild to mark samples with 0 encrypted bytes as unencrypted. r=cpearce, a=RyanVM\n\nWith the addition of an explicit encryption enum for CDM10 input data, if a\nsample has 0 encrypted bytes it must be marked as unencrypted. Historically we\ncould let the CDM figure out based on the unencrypted + encrypted bytes.\nHowever, if we mark a sample as encrypted but it has 0 encrypted bytes, the CDM\nwill fail to decrypt.\n\nThis changeset adds a check to gracefully handle samples that are marked as\nencrypted but with no encrypted ranges. In such cases we mark the data as\nunencrypted and log that such data was encountered. This means we don't break\nplayback of encrypted media should we overlook such cases, but have better\ndetection via logging.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6873", "files": ["dom/media/gmp/ChromiumCDMChild.cpp"], "git_node": null, "git_parents": [null], "node": "757faffe20e3104e19823382e47016739b2990c1", "parents": ["0faad9929481ce4eaa0e6f0317ebf8667df53a9b"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1494178 - Attempt to instantiate CDM10 before CDM9. r=cpearce, a=RyanVM\n\nDepends on D6873\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6874", "files": ["dom/media/gmp/GMPContentChild.cpp", "dom/media/gmp/GMPUtils.h"], "git_node": null, "git_parents": [null], "node": "e46ea5747b2ead61d1f9281d801eb61744337f59", "parents": ["757faffe20e3104e19823382e47016739b2990c1"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1496501 - Do not mark CDM input as unencrypted even if it has no encrypted bytes. r=cpearce, a=RyanVM\n\nBug 1494178 added code to mark samples with 0 encrypted ranges as unencrypted\nbefore they were fed to the CDM. This was to catch issues where we could mark\nsuch unencrypted samples as encrypted. However, the CDM expects certain samples\nthat are clear to still be marked as encrypted.\n\nSpecifically, WebM samples should be marked as encrypted if they are from an\nencrypted track and have the signal byte's encryption bit set (a marker for if\nthe packet is encrypted), even if they have no encrypted ranges.\n\nThe WebM demuxer is already doing this. Further inspection and testing of the\nmp4 demuxer shows it is behaving in line with Chromium's current mp4 parser,\nwhich we can expect prepares its data sensibly for Widevine.\n\nAs the code removed here was added as a safety fallback, but is causing issues,\nand as the demuxers already appear to be doing the right thing, the fallback\ncode can be removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8024", "files": ["dom/media/gmp/ChromiumCDMChild.cpp"], "git_node": null, "git_parents": [null], "node": "8f436181b5e82572a272b7b8294b626b07a8059a", "parents": ["e46ea5747b2ead61d1f9281d801eb61744337f59"], "tags": []}], "date": 1547076230, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "296": {"changesets": [{"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "merge 50fda92eb56b to THUNDERBIRD_60_VERBRANCH DONTBUILD. a=rjl", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/transforms/partials_signing.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_devedition.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_devedition.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_devedition.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_devedition.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_mingw_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_devedition.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_mingw_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win32/addondevel.py", "testing/mozharness/configs/builds/taskcluster_sub_win32/opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win32/rusttests_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/addondevel.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/asan_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/opt.py", "third_party/python/redo/README"], "git_node": null, "git_parents": [null, null], "node": "248ca5c585f8a5d9d2f9b333e0fbb422ea450f31", "parents": ["7bd4edb13f5ea0c5936dbc224f1c178df8328eb7", "50fda92eb56ba1c584b80f123a110a8281d0e259"], "tags": []}], "date": 1547084880, "git_changesets": [null], "user": "thunderbird@calypsoblue.org"}, "297": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D16180", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "2922706e66359c5c990d02e47a93ca1038974f01", "parents": ["8f436181b5e82572a272b7b8294b626b07a8059a"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1517222 - Update tzdata in ICU data files to 2018i. r=Waldo, a=RyanVM", "files": ["config/external/icu/data/icudt60l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/windowsZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/windowsZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/windowsZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/windowsZones.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js"], "git_node": null, "git_parents": [null], "node": "a3d9f59c892536642fe385a9c20a1b0b372e5a4f", "parents": ["2922706e66359c5c990d02e47a93ca1038974f01"], "tags": []}, {"author": "Thomas Nguyen \u003ctnguyen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1482659 - Purge the last sound, free then start to play a sound. r=m_kato,masayuki, a=RyanVM\n\nBecause we don't know when the PlaySound API stop/finish playing. So when starting to play a sound, we should call PlaySound(0,0,PURGE) to stop playing then free the last data sound.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D14554", "files": ["widget/windows/nsSound.cpp", "widget/windows/nsSound.h"], "git_node": null, "git_parents": [null], "node": "7defe9bd65cdab425347b311ceaa5c6dfab292a3", "parents": ["a3d9f59c892536642fe385a9c20a1b0b372e5a4f"], "tags": []}], "date": 1547176426, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "298": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "merge 7defe9bd65cd (Bug 1482659) to THUNDERBIRD_60_VERBRANCH. a=jorgk", "files": ["dom/ipc/TabParent.cpp"], "git_node": null, "git_parents": [null, null], "node": "0d12208f4729a605a744e01f5c449f52aad38b03", "parents": ["248ca5c585f8a5d9d2f9b333e0fbb422ea450f31", "7defe9bd65cdab425347b311ceaa5c6dfab292a3"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1499430 - Make PresShell::PageMove() use result of nsFrameSelection::GetFrameToPageSelect() when PresShell::GetScrollableFrameToScroll() returns nullptr. r=smaug a=jorgk\n\nIf there is no scrollable frame, PresShell::GetScrollableFrameToScroll() returns\nnullptr.  However, even when we don't expand selection, we need to move caret\nin current selection root.  Therefore, it should call\nnsFrameSelection::CommonPageMove() with the result of\nnsFrameSelection::GetFrameToPageSelect() to move caret.", "files": ["layout/base/PresShell.cpp", "layout/base/tests/mochitest.ini", "layout/base/tests/test_expanding_selection_per_page.html", "layout/base/tests/test_moving_and_expanding_selection_per_page.html"], "git_node": null, "git_parents": [null], "node": "2218e4b1e2cdd28586e1bcc0ca191034a119d5e9", "parents": ["0d12208f4729a605a744e01f5c449f52aad38b03"], "tags": []}], "date": 1547462356, "git_changesets": [null, null], "user": "mozilla@jorgk.com"}, "299": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D16452", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "ec98f4d9d10dd7c0a157cb847b2746e2393b9163", "parents": ["7defe9bd65cdab425347b311ceaa5c6dfab292a3"], "tags": []}, {"author": "Eric Rahm \u003cerahm@mozilla.com\u003e", "branch": "default", "desc": "Bug 1519209 - Disable NSS_ALLOW_SSLKEYLOGFILE in beta and release. r=glandium, a=RyanVM\n\nThis disables NSS_ALLOW_SSLKEYLOGFILE in beta in release in order to avoid shutdown hangs until the NSS project has time to fix the root cause of the issue.", "files": ["python/mozbuild/mozbuild/frontend/gyp_reader.py"], "git_node": null, "git_parents": [null], "node": "027887b2d74e42bc054e085455b449ee3cc4f65a", "parents": ["ec98f4d9d10dd7c0a157cb847b2746e2393b9163"], "tags": []}], "date": 1547473472, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "300": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D16816", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "dba66d4305c8c9145b128b7eaf28fede5feba8da", "parents": ["027887b2d74e42bc054e085455b449ee3cc4f65a"], "tags": []}], "date": 1547734049, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "301": {"changesets": [{"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491901 - move MK*SHLIB to moz.configure; r=ted.mielczarek, a=jcristau\n\nIt's nicer to have all that logic in one place, and to be able to common\nup the Unix-y flags setting.  The Makefile constructs in string values\nis gross, but it's no worse than we had before.", "files": ["build/moz.configure/toolchain.configure", "js/src/old-configure.in", "old-configure.in"], "git_node": null, "git_parents": [null], "node": "492cd032bcc2b741468598cd2ef51e592ffcb227", "parents": ["dba66d4305c8c9145b128b7eaf28fede5feba8da"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1470127 - Move binary checks to a standalone script. r=froydnj, a=jcristau\n\nWe perform, on the binaries we build, a series of check, that are\nimplemented as half-baked make commands, invoked after linking them.\n\n- check libstdc++ symbol versions to ensure binary compatibility with\n  a baseline.\n- check glibc symbol versions to ensure binary compatibility with a\n  baseline.\n- check that target binaries don't contain text relocations.\n- check that libmozglue is linked before libc on android.\n- on libxul, check that NSModules are laid out correctly.\n- on libxul, check that there is more than one PT_LOAD segment.\n\nThose checks happen to work where they matter, but their setup is\nunreliable. For example, the checks for symbol versions are supposed to\nwork for libclang-plugin on cross osx builds, but in fact, don't,\nbecause the readelf path doesn't exist, and the command doesn't fail in\nthat case.\n\nSo move them all to a standalone script, performing the checks more\nthoroughly (especially the NSModules one, where we now also check that\nthey are all adjacent), and more verbosely.", "files": ["config/config.mk", "config/rules.mk", "python/mozbuild/mozbuild/action/check_binary.py", "toolkit/library/libxul.mk"], "git_node": null, "git_parents": [null], "node": "c00e45470bd9ad46e6042fbce71ea7e6f9969b68", "parents": ["492cd032bcc2b741468598cd2ef51e592ffcb227"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1471685 - Work around MSVC linker adding padding during incremental builds. r=froydnj, a=jcristau", "files": ["python/mozbuild/mozbuild/action/check_binary.py", "xpcom/components/nsComponentManager.cpp"], "git_node": null, "git_parents": [null], "node": "f13c9d320dc7ce80311bbb5b61679674aff0f73b", "parents": ["c00e45470bd9ad46e6042fbce71ea7e6f9969b68"], "tags": []}, {"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "default", "desc": "Bug 1473291 - handle valueless dynamic section entries; r=glandium, a=jcristau\n\nSome dynamic entry types, like DT_BIND_NOW, are printed without a value\nby readelf.  Handle such types gracefully.", "files": ["python/mozbuild/mozbuild/action/check_binary.py"], "git_node": null, "git_parents": [null], "node": "8a49ed95c148deade0eb0a022ac132359de8a403", "parents": ["f13c9d320dc7ce80311bbb5b61679674aff0f73b"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1482270 - Check libgcc version compatibility. r=froydnj, a=jcristau\n\nSimilar to what we do for libstdc++ and glibc, we need to ensure that\nwe don't somehow end up with a dependency on a too new libgcc, which\ncan happen if it comes from gcc 7.0.", "files": ["python/mozbuild/mozbuild/action/check_binary.py"], "git_node": null, "git_parents": [null], "node": "e4ec2d6cd306735517f5034943762dd9a844db96", "parents": ["8a49ed95c148deade0eb0a022ac132359de8a403"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "Bug 1489211 - invoke dumpbin.exe to check NSModule ordering in libxul; r=froydnj, a=jcristau", "files": ["python/mozbuild/mozbuild/action/check_binary.py"], "git_node": null, "git_parents": [null], "node": "c26bc5d0d33d6a0568b556b7481567e389a33265", "parents": ["e4ec2d6cd306735517f5034943762dd9a844db96"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1472496 - Don't call out to readelf in check_binary.py. r=mshal, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6892", "files": ["python/mozbuild/mozbuild/action/check_binary.py"], "git_node": null, "git_parents": [null], "node": "e4ec2848fed5651249178a1f88383b9e02560430", "parents": ["c26bc5d0d33d6a0568b556b7481567e389a33265"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1481633 Resolve kPStaticModules undefined symbols in MinGW Clang. r=glandium, a=jcristau\n\nclang can handle MSVC-like codepaths generally, so we want to use those\nwhen building with clang for Windows. So we switch _MSC_VER over to _WIN32\nto pick up those codepaths when compiling for Windows with clang.\n\nAdditionally, we relax the ordering of sections for the same scenario.\n\nNote that we do need to tell clang to use -fms-extensions with the MSVC code,\nwe do that in the mingw clang build job patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3526", "files": ["python/mozbuild/mozbuild/action/check_binary.py", "xpcom/components/Module.h"], "git_node": null, "git_parents": [null], "node": "750ac3b5b7403d4a7438d66077bfdb3c419e4432", "parents": ["e4ec2848fed5651249178a1f88383b9e02560430"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1475562 - Fix check_binary to examine mingw-clang modules. r=ted, a=jcristau\n\nThis patch only backports part of 1475562 to make it less invasive\nas part of a large backport set.", "files": ["python/mozbuild/mozbuild/action/check_binary.py", "taskcluster/scripts/misc/build-clang-trunk-mingw.sh"], "git_node": null, "git_parents": [null], "node": "b5fd0e5701d73a23e99f6a583b36c6812719bec2", "parents": ["750ac3b5b7403d4a7438d66077bfdb3c419e4432"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471132 - Handle 3-column nm/readelf output in check_binary. r=glandium, a=jcristau\n\nThis patch backports only one small part of 1471132 to handle certain\ntypes of nm/readelf output.", "files": ["python/mozbuild/mozbuild/action/check_binary.py"], "git_node": null, "git_parents": [null], "node": "6be34dffbc7432b5a0598846eaba1bf99fa61350", "parents": ["b5fd0e5701d73a23e99f6a583b36c6812719bec2"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1519316 - Check NSModules for the MinGW gcc build. r=froydnj, a=jcristau\n\nThis requires filtering out symboles that contain NSModule in them\nbut are not really NSModules.", "files": ["python/mozbuild/mozbuild/action/check_binary.py"], "git_node": null, "git_parents": [null], "node": "52d60c758838d2fa4d9f947680c12a380b0e8e46", "parents": ["6be34dffbc7432b5a0598846eaba1bf99fa61350"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1498672 Include string.h explicitly instead of relying on algorithm to bring it in. r=bobowen, a=jcristau\n\nThe mingw-clang build was broken because the dependency wasn't specified explicitly.", "files": ["security/sandbox/chromium-shim/sandbox/win/permissionsService.cpp"], "git_node": null, "git_parents": [null], "node": "43268095c86acfcb9dd2dfc179bcdc5facd85eef", "parents": ["52d60c758838d2fa4d9f947680c12a380b0e8e46"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1504022 - Map GetExceptionCode to a nop to avoid an error. r=bobowen, a=jcristau\n\nerror: '_exception_code' only allowed in __except block or filter expression", "files": ["mozilla-config.h.in"], "git_node": null, "git_parents": [null], "node": "e400b3791e4785c2844c1a2a2456ad6e98044be2", "parents": ["43268095c86acfcb9dd2dfc179bcdc5facd85eef"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1506450 - Bump LLVM and use llvm-rc via mingw-llvm windres wrapper as resource compiler. r=froydnj, a=jcristau", "files": ["browser/config/mozconfigs/win32/mingwclang", "browser/config/mozconfigs/win64/mingwclang", "build/build-clang/clang-trunk-mingw.json", "taskcluster/scripts/misc/build-clang-trunk-mingw.sh"], "git_node": null, "git_parents": [null], "node": "42aae8ce3a5e273cf1e8a51a69e69ace885aa584", "parents": ["e400b3791e4785c2844c1a2a2456ad6e98044be2"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1511672 - Fix dependent base lookups in AsyncInvoker.h r=froydnj, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13633", "files": ["ipc/mscom/AsyncInvoker.h"], "git_node": null, "git_parents": [null], "node": "a78d31ef649a861892bc3a49237db2d4c7dadf76", "parents": ["42aae8ce3a5e273cf1e8a51a69e69ace885aa584"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1430149 - Fix NtUndoc.h on mingw. r=aklotz, a=jcristau\n\nmingw headers declare both ObjectNameInformation and OBJECT_NAME_INFORMATION, which conflicts with local definitions.", "files": ["accessible/windows/msaa/NtUndoc.h"], "git_node": null, "git_parents": [null], "node": "cbb386941cf7afe8f22e41198be62b20e52d33cb", "parents": ["a78d31ef649a861892bc3a49237db2d4c7dadf76"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1430149 - widl compatibility fixes. r=aklotz, a=jcristau\n\nwidl can't handle generating the typelib without explicit importlib() in this case. This should be fixed in widl as well, but using importlib() in this case looks right anyway.", "files": ["accessible/ipc/win/handler/AccessibleHandler.h", "accessible/ipc/win/handler/HandlerData.idl"], "git_node": null, "git_parents": [null], "node": "35d886531689702d2924fa1b22438af6fdef2dcf", "parents": ["cbb386941cf7afe8f22e41198be62b20e52d33cb"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1430149 - Don't define INITGUID when not needed. r=aklotz, a=jcristau\n\nOn mingw this causes IIDs to be defined in headers. Those definitions conflict\nwith _i.c files that are included as well. Since we include _i.c anyway,\nINITGUID is simply not needed.", "files": ["accessible/ipc/win/HandlerProvider.cpp", "accessible/ipc/win/handler/AccessibleHandler.cpp"], "git_node": null, "git_parents": [null], "node": "fe547fe73bba411951fa314ed473336844dbe79f", "parents": ["35d886531689702d2924fa1b22438af6fdef2dcf"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1430149 - Fix AsyncInvoker.h compilation on mingw. r=aklotz, a=jcristau\n\nMozReview-Commit-ID: FIswvwMzGdC\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15325", "files": ["ipc/mscom/AsyncInvoker.h"], "git_node": null, "git_parents": [null], "node": "3e18d1aa6c318467e341d891155b458b56c8f64c", "parents": ["fe547fe73bba411951fa314ed473336844dbe79f"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1518544 - Bump the default value of _WIN32_WINNT in the mingw-clang toolchain to 0x601. r=froydnj, a=jcristau", "files": ["taskcluster/scripts/misc/build-clang-trunk-mingw.sh"], "git_node": null, "git_parents": [null], "node": "c7cba7f60631edadc8a969e8206d09aff5049f14", "parents": ["3e18d1aa6c318467e341d891155b458b56c8f64c"], "tags": []}], "date": 1547734819, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "jcristau@mozilla.com"}, "302": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1518989 - Bump MinGW to get D3D constant fix. r=froydnj, a=jcristau", "files": ["taskcluster/scripts/misc/build-clang-trunk-mingw.sh"], "git_node": null, "git_parents": [null], "node": "41133d26f067e935da5c08bf87705072a9a2348d", "parents": ["c7cba7f60631edadc8a969e8206d09aff5049f14"], "tags": []}, {"author": "Adam Gashlin \u003cagashlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1482920 - Force fullscreen window position. r=jmathies, a=jcristau\n\nIncludes regression fixes from Bug 1513066 and Bug 1514501.", "files": ["widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "5d96340ff73119aa54dd36ad26ce97da6aa16c34", "parents": ["41133d26f067e935da5c08bf87705072a9a2348d"], "tags": []}], "date": 1547735340, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}, "303": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1475562 - Actually generate the pdbs for the mingw-clang build. r=ted, a=jcristau", "files": ["browser/config/mozconfigs/win32/mingwclang", "browser/config/mozconfigs/win64/mingwclang", "build/moz.configure/toolchain.configure", "build/win64/mozconfig.asan", "config/rules.mk", "moz.configure", "toolkit/mozapps/installer/packager.py"], "git_node": null, "git_parents": [null], "node": "434bde49b9c86abb147a6eec2ef60009ec099ed7", "parents": ["5d96340ff73