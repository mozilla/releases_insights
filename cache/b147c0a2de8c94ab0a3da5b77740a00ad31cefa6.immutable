, "desc": "Bug 1502871 - Get RefPtr to transaction before using it. r=janv, a=RyanVM\n\nAvoid use-after-free by getting a RefPtr to a transaction before calling\ncontent code that could cause its deallocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D14427", "files": ["dom/indexedDB/ActorsChild.cpp"], "git_node": null, "git_parents": [null], "node": "5f30ae385560809eccb70f4d16c781b249e50059", "parents": ["f90ccef732dabcdf21fd05314b621b9e409d3368"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458003 - Make a local copy of the face list in CheckForLegacyFamilyNames, in case mAvailableFonts is mutated during this function. r=lsalzman, a=RyanVM", "files": ["gfx/thebes/gfxFontEntry.cpp"], "git_node": null, "git_parents": [null], "node": "10b03e611a4296896b4081d7dfa6a18de78791b9", "parents": ["5f30ae385560809eccb70f4d16c781b249e50059"], "tags": []}], "date": 1545861988, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "278": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492033 - Create partner repacks during esr60 releases r=tomprince, a=release\n\nSupports partner builds on esr60 by re-arranging how we specify the manifest repositories, which are different for esr60 compared to beta+release. The defaults for enabling partners and EME-free now depend on the partner-urls definition in taskcluster/ci/config.yml.\n\nThis patch also adds support for partner & EMEfree repacks in try staging releases, for all the various release branches. It makes release_level available early in the decision task (for the release promotion action) where a Parameters object is not available. Signing worker type is no longer hard-coded, and we use level-1 secrets for querying Github (via bug 1513375).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15185", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/transforms/repackage_signing_partner.py", "taskcluster/taskgraph/util/attributes.py", "taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "ac44dea415b7202fc83ed63ff3b8f613111f1f23", "parents": ["10b03e611a4296896b4081d7dfa6a18de78791b9"], "tags": []}], "date": 1545987657, "git_changesets": [null], "user": "nthomas@mozilla.com"}, "279": {"changesets": [{"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1513900 - Reformat everything on the ESR branch to the Google coding style (DateTimeFormat.cpp only). r=ehsan a=jorgk", "files": ["intl/locale/DateTimeFormat.cpp"], "git_node": null, "git_parents": [null], "node": "5d79ca5eac09b4651b95c2117ddaf9484ba18a14", "parents": ["c23331af8ac635f86d748c0eb1e5bbb8fcfd86d9"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1404666 - patch 1 - Accelerate OSPreferences::GetDateTimePattern by caching patterns found for particular style/locale combinations. r=gandalf a=jorgk", "files": ["intl/locale/OSPreferences.cpp", "intl/locale/OSPreferences.h"], "git_node": null, "git_parents": [null], "node": "64bba4f9928e6b0f0cded35016f671a32b812519", "parents": ["5d79ca5eac09b4651b95c2117ddaf9484ba18a14"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1404666 - patch 2 - Accelerate DateTimeFormat::FormatUDateTime by caching ICU UDateFormat objects instead of creating them afresh every time. r=gandalf a=jorgk DONTBUILD", "files": ["intl/locale/DateTimeFormat.cpp", "intl/locale/DateTimeFormat.h"], "git_node": null, "git_parents": [null], "node": "aafc47a21cd3190e7d22521e409aa3cbaceb9861", "parents": ["64bba4f9928e6b0f0cded35016f671a32b812519"], "tags": []}], "date": 15461