nager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "7de26aa38d0d1ac5339bc1794cd55582651d410a", "parents": ["d7e099f6fc71ba0170d26243dccca08fb6267815"], "tags": []}], "date": 1650289470, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "238": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update,r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D144273", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "9886fdf835cdf42fb7b65fdb7e1ddd2b48031081", "parents": ["7de26aa38d0d1ac5339bc1794cd55582651d410a"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1753298 - Improve error handling in BaseMediaResource::ModifyLoadFlags. r=padenot,a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143863", "files": ["dom/media/BaseMediaResource.cpp", "dom/media/BaseMediaResource.h", "dom/media/ChannelMediaResource.cpp"], "git_node": null, "git_parents": [null], "node": "d4ea4b5dd6859ce9511377fe7e5bfec60435fdc7", "parents": ["9886fdf835cdf42fb7b65fdb7e1ddd2b48031081"], "tags": []}], "date": 1650546573, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "239": {"changesets": [{"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1747879 - Pass Thunderbird subrepo srcpath to symbolstore.py. r=firefox-build-system-reviewers,andi,a=dsmith\n\nThe sym files generated for Thunderbird builds contain incorrect VCS references.\nsymbolstore.py will handle the subrepo correctly with an additional -s argument\nif MOZ_SOURCE_REPO and MOZ_SOURCE_CHANGESET are not set. See D135392.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135299", "files": ["python/mozbuild/mozbuild/action/dumpsymbols.py"], "git_node": null, "git_parents": [null], "node": "9705667ae90d09fa50fd89d746c0af66d8600050", "parents": ["d4ea4b5dd6859ce9511377fe7e5bfec60435fdc7"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1762125. Allow DXVA on newer Intel drivers. r=aosmond a=a=dsmith\n\nNewer Intel drivers break our assumptions about the bottom four digits\nbeing the build id and we end up blocking newer drivers with build ids\nlike 11404. This reverts the change in bug 1295902 which changed this\nblocklist rule to only look at the build number. I think bug 1295902 was\njust trying to be more correct and I don't know that it actually blocks\nimportant crashes. Decoding now mostly happens in the GPU process\nso the impact of these crashes is reduced from what it originally was.\n\nThe information on how to interpret Intel driver version is from:\nhttps://www.intel.ca/content/www/ca/en/support/articles/000005654/graphics.html\n\nThe proper fix is to have Intel specific driver version parsing.\n\nThis is a more conservative fix that also adds blocking for drivers\nearlier or equal to 8.15.10.2849.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143362", "files": ["widget/windows/GfxInfo.cpp"], "git_node": null, "git_parents": [null], "node": "fb4046e174337e13fb44547bd71a09042cc18eae", "parents": ["9705667ae90d09fa50fd89d746c0af66d8600050"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1762614: Update libopus to 2654707e86cc94413998976d179b2ab4a2aa3114 r=kinetik,a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142717", "files": ["media/libopus/README_MOZILLA", "media/libopus/celt/arch.h", "media/libopus/celt/arm/armcpu.c", "media/libopus/celt/bands.c", "media/libopus/celt/celt_decoder.c", "media/libopus/celt/celt_encoder.c", "media/libopus/celt/celt_lpc.c", "media/libopus/celt/ecintrin.h", "media/libopus/celt/fixed_debug.h", "media/libopus/celt/fixed_generic.h", "media/libopus/celt/float_cast.h", "media/libopus/celt/mathops.h", "media/libopus/celt/mips/celt_mipsr1.h", "media/libopus/celt/mips/vq_mipsr1.h", "media/libopus/celt/os_support.h", "media/libopus/celt/rate.c", "media/libopus/celt/rate.h", "media/libopus/celt/stack_alloc.h", "media/libopus/celt/vq.c", "media/libopus/celt/vq.h", "media/libopus/celt/x86/pitch_sse.h", "media/libopus/celt/x86/pitch_sse4_1.c", "media/libopus/celt/x86/x86cpu.h", "media/libopus/include/opus_custom.h", "media/libopus/include/opus_defines.h", "media/libopus/moz.build", "media/libopus/nonunified2.patch", "media/libopus/silk/CNG.c", "media/libopus/silk/LPC_fit.c", "media/libopus/silk/MacroCount.h", "media/libopus/silk/NSQ.c", "media/libopus/silk/NSQ_del_dec.c", "media/libopus/silk/PLC.c", "media/libopus/silk/SigProc_FIX.h", "media/libopus/silk/VAD.c", "media/libopus/silk/VQ_WMat_EC.c", "media/libopus/silk/arm/LPC_inv_pred_gain_neon_intr.c", "media/libopus/silk/bwexpander_32.c", "media/libopus/silk/debug.c", "media/libopus/silk/debug.h", "media/libopus/silk/decode_frame.c", "media/libopus/silk/define.h", "media/libopus/silk/fixed/arm/warped_autocorrelation_FIX_neon_intr.c", "media/libopus/silk/fixed/burg_modified_FIX.c", "media/libopus/silk/fixed/mips/warped_autocorrelation_FIX_mipsr1.h", "media/libopus/silk/fixed/vector_ops_FIX.c", "media/libopus/silk/fixed/warped_autocorrelation_FIX.c", "media/libopus/silk/fixed/x86/burg_modified_FIX_sse4_1.c", "media/libopus/silk/fixed/x86/vector_ops_FIX_sse4_1.c", "media/libopus/silk/float/warped_autocorrelation_FLP.c", "media/libopus/silk/main.h", "media/libopus/silk/typedef.h", "media/libopus/silk/x86/NSQ_del_dec_sse4_1.c", "media/libopus/silk/x86/NSQ_sse4_1.c", "media/libopus/silk/x86/SigProc_FIX_sse.h", "media/lib