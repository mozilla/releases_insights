": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143150", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "4ee676367b087c4c960391f2f3742d7eb3fb37a8", "parents": ["cc523ad131f8fdc35346cf798510ae64b84469ea"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1761850 - Fix wasm select on ARM64. r=jseward, a=RyanVM\n\nJSOpToCondition is applicable only to integer types. JSOpToDoubleCondition and\nConditionFromDoubleCondition sequence has to be used for float types.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142288", "files": ["js/src/jit-test/tests/wasm/binop-arm64-ion-codegen.js", "js/src/jit-test/tests/wasm/regress/bug1761850.js", "js/src/jit/arm64/CodeGenerator-arm64.cpp"], "git_node": null, "git_parents": [null], "node": "94e42a10297abed31285501c2852d0e174bc0a73", "parents": ["4ee676367b087c4c960391f2f3742d7eb3fb37a8"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1762899 - Fix {f32,f64}.copysign for Aarch64. r=lth, a=RyanVM\n\nUsing defineReuseInput in LIRGenerator to prevents rhs == output && lhs != output,\nwhich is the case that would clobber the rhs in copySignDouble().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142994", "files": ["js/src/jit-test/tests/wasm/regress/bug1762899.js", "js/src/jit/arm64/Lowering-arm64.cpp"], "git_node": null, "git_parents": [null], "node": "554ce378af3d9702f6e043f07d17257a96c64cca", "parents": ["94e42a10297abed31285501c2852d0e174bc0a73"], "tags": []}], "date": 1649342043, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "234": {"changesets": [{"author": "Gabriel Bustamante \u003cgbustamante@mozilla.com\u003e", "branch": "default", "desc": "No bug - Bump gecko_decision to 4.0.0 r=ahal,aki a=release", "files": [".taskcluster.yml", "taskcluster/docker/decision/HASH"], "git_node": null, "git_parents": [null], "node": "1e771964595f66e1101e853053c813f312195a11", "parents": ["554ce378af3d9702f6e043f07d17257a96c64cca"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1762128 - bump the cache name for decision images to stop interfering with other trees. r=releng-reviewers,ahal a=release\n\nhg 4.8 (e.g. from the v3.0.1 decision image) seems to choke on cached repos\ncreated with 5.8 (from v4.0.0).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142455", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "f76058e6967924e5f47bf7661d39f7514de7d6bf", "parents": ["1e771964595f66e1101e853053c813f312195a11"], "tags": []}], "date": 1649347284, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "235": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143359", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "e4ad51991b58d34c8b7e0252439ad365fe7c7391", "parents": ["f76058e6967924e5f47bf7661d39f7514de7d6bf"], "tags": []}], "date": 1649697918, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "236": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "defa