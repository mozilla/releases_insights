runme.sh"], "git_node": null, "git_parents": [null], "node": "190e1c11fcefa44c54a216364c3cad75ea5762d0", "parents": ["b732dac3ca9a76fa0ee9cb7e66156a86b1089d60"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492664 - update funsize scripts to use TASKCLUSTER_ROOT_URL; r=sfraser", "files": ["taskcluster/docker/funsize-update-generator/runme.sh", "taskcluster/docker/funsize-update-generator/scripts/funsize.py"], "git_node": null, "git_parents": [null], "node": "ffd5d554708fc6c3a779ec61439021320b213685", "parents": ["190e1c11fcefa44c54a216364c3cad75ea5762d0"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492664 - update periodic-updates to use TASKCLUSTER_ROOT_URL; r=sfraser", "files": ["taskcluster/docker/periodic-updates/runme.sh", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "af2485e7e498fc26331367da2ff6779ecdfcff85", "parents": ["ffd5d554708fc6c3a779ec61439021320b213685"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492664 - generate portable URLs for Android mach commands; r=nalexander", "files": ["mobile/android/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "a2fead9d27165f2a2dc686b99f31297747603d35", "parents": ["af2485e7e498fc26331367da2ff6779ecdfcff85"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492664 - update references in docs; r=froydnj", "files": ["taskcluster/docs/partials.rst"], "git_node": null, "git_parents": [null], "node": "1a78e1bf84e80f5757c9d60d0841bd86e39a88a2", "parents": ["a2fead9d27165f2a2dc686b99f31297747603d35"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [taskgraph] Don't set `optimize_target_tasks` by branch; r=dustin\n\nThe only branch where it set differently is `try`/`try-comm-central`, but it gets\noverriden there in `set_try_config`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15478", "files": ["taskcluster/taskgraph/decision.py"], "git_node": null, "git_parents": [null], "node": "e23138f2c521390b05513a4e500f5c12db3ea44f", "parents": ["1a78e1bf84e80f5757c9d60d0841bd86e39a88a2"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512188 - Rename --vcs-checkout to --gecko-checkout; r=tomprince,dustin\n\nWe now have multiple things we may check out. \"vcs\" meaning \"gecko\"\nis not obvious. Let's change the terminology to be more specific.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13813", "files": ["taskcluster/docker/image_builder/build-image.sh", "taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/job/hazard.py", "taskcluster/taskgraph/transforms/job/mozharness.py", "taskcluster/taskgraph/transforms/job/mozharness_test.py", "taskcluster/taskgraph/transforms/job/run_task.py", "taskcluster/taskgraph/transforms/job/spidermonkey.py", "taskcluster/taskgraph/transforms/job/toolchain.py"], "git_node": null, "git_parents": [null], "node": "ce634269f18d4c50fbabe74a4823735dcc2570b2", "parents": ["e23138f2c521390b05513a4e500f5c12db3ea44f"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512188 - Rename --sparse-profile to --gecko-sparse-profile; r=tomprince,dustin\n\nWe have multiple source checkouts. --sparse-profile is ambiguous\nas to which one it could refer to. Let's rename the argument so it\nis prefixed with the repo/project we are checking out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13814", "files": ["taskcluster/docker/image_builder/build-image.sh", "taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/job/run_task.py", "taskcluster/taskgraph/transforms/job/toolchain.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "654d56643a8ee723c42e08960cfe95ace8841975", "parents": ["ce634269f18d4c50fbabe74a4823735dcc2570b2"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1512285: Stop checking out tools; r=nthomas,gps\n\nThis code was used by mozharness jobs to check out the tools repo.\nHowever, those jobs aren't actually using the repository.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13855", "files": ["taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/job/mozharness.py"], "git_node": null, "git_parents": [null], "node": "34ea503cf6935ca074386292d01ffb3ed5056713", "parents": ["654d56643a8ee723c42e08960cfe95ace8841975"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512188 - make VCS checkout options generic; r=tomprince,dustin\n\nWe currently manage VCS checkout arguments as one-offs for each\nproject. This isn't scalable and results in a bit of copy-pasta.\n\nLet's make the VCS checkout arguments generic so we can have the\nsame control for all repositories.\n\nThis commit focuses on consolidating the existing argument parser\ncode. It stops short of further unification, which will be done in\nsubsequent commits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13815", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "a2c68a828cd1181bd70bf98ea0129f06041e9ffb", "parents": ["34ea503cf6935ca074386292d01ffb3ed5056713"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512188 - Collect environment variables into VCS options; r=tomprince,dustin\n\nThis makes behavior consistent across all VCS checkouts. I'm still not\na fan of using environment variables here. But at least this gets us\n1 step closer to being able to plug alternate logic in without having\nto update use of environment variables outside a single function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13816", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "2b2df02aed4ccbc1668181abd363809faf59de14", "parents": ["a2c68a828cd1181bd70bf98ea0129f06041e9ffb"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512188 - Move base repo normalization into collect_vcs_options(); r=tomprince,dustin\n\nThis is a generic normalization and doesn't need to be Firefox\nspecific.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13817", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "4c1c7f6eac3b965451374bcbe1fc5e417e1fcfa4", "parents": ["2b2df02aed4ccbc1668181abd363809faf59de14"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512188 - Collect hg store path in collect_vcs_options(); r=tomprince,dustin\n\nOne step closer to making all state gathering and normalization in one\nplace.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13819", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "8a235e8cd255ae57090387bd9b417f13cc68437b", "parents": ["4c1c7f6eac3b965451374bcbe1fc5e417e1fcfa4"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1512188 - Consolidate VCS checkout from args logic; r=tomprince,dustin\n\nWe create a minimal wrapper function to call collect_vcs_options()\nand vcs_checkout().\n\nWe could consolidate this logic into vcs_checkout(). But I don't have\nstrong feelings about doing that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13821", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "cee366f3711b4c7851b8b117fb9d29f132771fbb", "parents": ["8a235e8cd255ae57090387bd9b417f13cc68437b"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: [try-staging] Allow partial generation to access https URLS on try; r=sfraser\n\nThe nightly partial generation code generates URLs with https:// so they should\nbe accepted as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15311", "files": ["taskcluster/docker/funsize-update-generator/scripts/funsize.py"], "git_node": null, "git_parents": [null], "node": "ef316851628238893498ee71a938f9bcf58554aa", "parents": ["cee366f3711b4c7851b8b117fb9d29f132771fbb"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1485861 - Define many treeherder symbols based on the parent task. r=aki\n\nThis changes a bunch of symbols, notably:\n* Group name BMR-L10n(*) ==\u003e BMR(*)\n* Group name BM-L10n(*) ==\u003e BM(*)\n* Groups the BMR symbol itself for en-US Nightly [so BMR ==\u003e BMR(N)]\n* Groups the BM symbol itself for en-US Nightly [so BM ==\u003e BM(N)]\n* Changes Source Signing fron symbol Bs to Srcs\n* Groups Source signing beetmoving as BM(Srcs) instead of symbol BM-S\n* Balrog complete update submission changes from c-Up(N) to c-Up(Ns) [Fennec Only]\n* Beetmover en-US changes from symbol BM-S to BM(Ns) [used in Fennec]\n* Beetmover Checksums (en-US) changes from BMcs(N) =\u003e BMcs(Ns) [fennec]\n* Checksums signing (en-US, fennec) changes from cs(N) =\u003e cs(Ns)\n* [Asan] Balrog changed [c-UP(N) ==\u003e c-UP(BoR)]\n* [Asan] signing changed from Ns to BoRs\n* [Asan] checksums signing changed from cs(N) to cs(BoR)\n* [Asan] Change generated source uploading from Ugs ==\u003e UgsBoR\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4178", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/transforms/balrog_submit.py", "taskcluster/taskgraph/transforms/beetmover.py", "taskcluster/taskgraph/transforms/beetmover_checksums.py", "taskcluster/taskgraph/transforms/beetmover_l10n.py", "taskcluster/taskgraph/transforms/beetmover_repackage.py", "taskcluster/taskgraph/transforms/beetmover_repackage_l10n.py", "taskcluster/taskgraph/transforms/checksums_signing.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/upload_generated_sources.py", "taskcluster/taskgraph/util/treeherder.py"], "git_node": null, "git_parents": [null], "node": "61c1a58b1420b591fb49219ba9e2e4dbf02b8356", "parents": ["ef316851628238893498ee71a938f9bcf58554aa"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1517201 - put actionPerm in schema-compliant action.extra r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15616", "files": ["taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "1fa61df76c77aff459732d0ec09966dca989d4c2", "parents": ["61c1a58b1420b591fb49219ba9e2e4dbf02b8356"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1517701 - allow docker-worker:capability:device:*, too r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15736", "files": ["taskcluster/taskgraph/actions/create_interactive.py"], "git_node": null, "git_parents": [null], "node": "d0dfbe6ef0c3e6ff4e4353b4e2e327eff24e1e64", "parents": ["1fa61df76c77aff459732d0ec09966dca989d4c2"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1513480 - stop writing out deprecated runnable-jobs.json.gz r=emorley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D15849", "files": ["taskcluster/taskgraph/decision.py"], "git_node": null, "git_parents": [null], "node": "826bfe4585cd983c4376edbc4e28b4af7601df17", "parents": ["d0dfbe6ef0c3e6ff4e4353b4e2e327eff24e1e64"], "tags": []}, {"author": "Tom Prince \u003c