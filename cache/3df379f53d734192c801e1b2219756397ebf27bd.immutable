s.mozilla.com/D199418", "files": ["security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/nsNSSComponent.h"], "git_node": null, "git_parents": [null], "node": "02ec7801175bc81e17e5545962f11fb38d61b87e", "parents": ["d7f8bbb5f0375e725c629b1e05225c622b9ca856"], "tags": []}], "date": 1707249679, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "253": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1878182 - Instantiate Cairo scaled font for ScaledFontBase::GetPathForGlyphs. r=jfkthameApproved for 123 beta 8, thanks. a=pascalc\n\nThis bug likely dates back to bug 1584268, which makes it so that Cairo scaled fonts must be\ninstantiated on demand for their first use. It seems like some StrokeGlyphs machinery got\noverlooked and somehow never caused a problem till now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D200472", "files": ["gfx/2d/DrawTarget.cpp", "gfx/2d/ScaledFontBase.cpp"], "git_node": null, "git_parents": [null], "node": "2463c35f95a6b1f1abe4e6851029dcb8e57ca099", "parents": ["02ec7801175bc81e17e5545962f11fb38d61b87e"], "tags": []}], "date": 1707250485, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "254": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201069", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/search-config.json"], "git_node": null, "git_parents": [null], "node": "8ca8483ba0837526d7fc2ecee374d2635d7992fe", "parents": ["2463c35f95a6b1f1abe4e6851029dcb8e57ca099"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1873960 - Test. r=Gijs, a=test-only", "files": ["browser/base/content/test/fullscreen/browser_fullscreen_permissions_prompt.js"], "git_node": null, "git_parents": [null], "node": "5b7cbf1b5827e9440f529b2ac3df0f318ed12fa0", "parents": ["8ca8483ba0837526d7fc2ecee374d2635d7992fe"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Bug 1817727 - Disable test_filename_sanitize.js on mac because of permafailures. r=aryx, a=test-only", "files": ["uriloader/exthandler/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "e0a579f59f7f435373ac3faa0586d294344b2063", "parents": ["5b7cbf1b5827e9440f529b2ac3df0f318ed12fa0"], "tags": []}, {"author": "Natalia Csoregi \u003cncsoregi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1760081 - Disabled netwerk/test/unit/test_alt-data_simple.js on Windows for having a high failure rate. r=necko-reviewers,kershaw a=test-only", "files": ["netwerk/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "310a41044ade0086e34d377d8063261d789ff140", "parents": ["e0a579f59f7f435373ac3faa0586d294344b2063"], "tags": []}, {"author": "Cristina Horotan \u003cchorotan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1837646 - disable browser_sma_show_migration_wizard.js on mac for frequent failures. r=aryx, a=test-only", "files": ["toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.ini"], "git_node": null, "git_parents": [null], "node": "389df8c55e51fab3f84d113ed0bcbf6c713b9dcf", "parents": ["310a41044ade0086e34d377d8063261d789ff140"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Bug 1198168 - disable test_bug1113600.html on mac. a=test-only", "files": ["dom/media/test/mochitest_bugs.ini"], "git_node": null, "git_parents": [null], "node": "42e1d7a399a6447bcfc4440e38497a24ab703297", "parents": ["389df8c55e51fab3f84d113ed0bcbf6c713b9dcf"], "tags": []}], "date": 1707421052, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "255": {"changesets": [{"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1867784 - Force reflow all kids in the last column balancing reflow. a=RyanVM\n\nThe bug occurs because some abspos children are split, but not being reflowed\nagain in the last column balancing reflow where the available block-size of the\nlast column might be unconstrained.\n\nThis patch makes the callers utilizing `ReflowInput::ShouldReflowAllKids()`\nalways reflow in the last column balancing reflow to ensure the correctness of\nthe layout.\n\nNote: the `mIsInLastColumnBalancingReflow` flag is inheriting from parent to\nchild reflow input, but it will stop at the nested `nsColumnSetFrame` because\nthe nested one will create its own `ReflowConfig::mIsLastBalancingReflow` and\nassign that flag when creating the reflow input for the children.", "files": ["layout/generic/ReflowInput.cpp", "layout/generic/ReflowInput.h", "layout/generic/nsColumnSetFrame.cpp"], "git_node": null, "git_parents": [null], "node": "c263e4b3dd951868dc2af6191510b3fb8a9e573f", "parents": ["42e1d7a399a6447bcfc4440e38497a24ab703297"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1870159 - Use a different string for empty driver versions. r=aosmond,win-reviewers,mhowell a=RyanVM\n\nThis lets us distinguish parse failures from empty versions in\ntelemetry.", "files": ["widget/windows/GfxInfo.cpp"], "git_node": null, "git_parents": [null], "node": "64b897a1fb2e8f5ee3da3494726e734a64968fbc", "parents": ["c263e4b3dd951868dc2af6191510b3fb8a9e573f"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1868737 - Allow minimal gfx features by default for uncertain configurations. r=jrmuizel,perftest-reviewers,kshampur a=RyanVM\n\nSome features such as the GPU process (except on Android), backdrop\nfilter (because it always works with Software WebRender), ANGLE (because\nit is generally good) and out of process WebGL (we generally want to\nremote WebGL for sandboxing purposes) are special, and should not be\ndisabled simply because we are uncertain about our configuration. In\nthese situations, disable most features, but keep these enabled by\ndefault.", "files": ["taskcluster/ci/test/talos.yml", "widget/GfxInfoBase.cpp", "widget/GfxInfoBase.h", "widget/android/GfxInfo.cpp", "widget/gtk/GfxInfo.cpp", "widget/windows/GfxInfo.cpp"], "git_node": null, "git_parents": [null], "node": "b72ded5fe488c222a55386684647e45bb64339de", "parents": ["64b897a1fb2e8f5ee3da3494726e734a64968fbc"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1866883 - Avoid attempting to apply DirectWrite FONT_SIMULATIONS_BOLD to COLR fonts. a=RyanVM\n\nThe DirectWrite \"bold simulation\" has poor results with some fonts;\nwe already disable it by default for webfonts, to avoid rendering\nissues.\n\nAs it also works poorly with some of the component layers in Segoe UI\nEmoji, let's disable it for COLR fonts as well.", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFonts.cpp"], "git_node": null, "git_parents": [null], "node": "4defe834fc5b30b96b63461f739f534b3a2961c0", "parents": ["b72ded5fe488c222a55386684647e45bb64339de"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1873659 - Hide broken favicons from mime handler dialog. r=desktop-theme-reviewers,dao a=RyanVM\n\nSimplify the code to use loading=lazy to make the images not block the\nload event.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198426", "files": ["toolkit/mozapps/handling/content/appChooser.js", "toolkit/mozapps/handling/content/handler.css"], "git_node": null, "git_parents": [null], "node": "bf1288ce57a8135d785b0ec5de81fd65f7ffb57a", "parents": ["4defe834fc5b30b96b63461f739f534b3a2961c0"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1874502: Use ScratchDoubleScope in moveValue. r=jandem, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198479", "files": ["js/src/jit-test/tests/ion/bug1874502.js", "js/src/jit/arm/MacroAssembler-arm.cpp"], "git_node": null, "git_parents": [null], "node": "4aebdf4262187291ede31707dfd4572cb8a252f2", "parents": ["bf1288ce57a8135d785b0ec5de81fd65f7ffb57a"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1873521: Code cleanup r=valentin,necko-reviewers,kershaw a=RyanVM", "files": ["netwerk/dns/DNSRequestChild.cpp"], "git_node": null, "git_parents": [null], "node": "bfa2d93c0fafb952d482ab231336d3b81eb8ec94", "parents": ["4aebdf4262187291ede31707dfd4572cb8a252f2"], "tags": []}], "date": 1707441853, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "256": {"changesets": [{"author": "edgul \u003cedgul@mozilla.com\u003e", "branch": "default", "desc": "Bug 1864385 - Block set-cookie from multipart/x-mixed-replace with pref. r=valentin,necko-reviewers a=RyanVM", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/streamconv/converters/nsMultiMixedConv.cpp"], "git_node": null, "git_parents": [null], "node": "ec81a0da67e2cbce802725c02e7ced429126c7af", "parents": ["bfa2d93c0fafb952d482ab231336d3b81eb8ec94"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1832627 - Popup should be closed. r=edgar, a=RyanVM", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "toolkit/actors/SelectParent.sys.mjs"], "git_node": null, "git_parents": [null], "node": "4ef8e1792fdaf3b13ffd6da5a1286616966f4282", "parents": ["ec81a0da67e2cbce802725c02e7ced429126c7af"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 