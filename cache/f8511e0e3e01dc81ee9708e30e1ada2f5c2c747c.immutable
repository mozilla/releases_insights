633941519d5e6316d4abd53"], "node": "b40e191aff08631efd0c7ded9bd9a5f015a0882d", "parents": ["58561eae4bca3bc9d91552ab5d30e3271e915723"], "tags": []}], "date": 1791469331, "git_changesets": ["66ac0dbf963fcfb06633941519d5e6316d4abd53", "48422d5c200641b7a219dd891be32166cff2c956"], "user": "ffxbld@lando.moz.tools"}, "1648": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778932 - Skip browser_test_procinfo.js on Windows 11 on ESR 115 for frequent failures. r=intermittent-reviewers,aryx a=RyanVM DONTBUILD\n\nESR 115 branched before bug 1880373 fixed these failures on Windows 11. That fix changes ProcInfo and XPConnect code, which isn't worth uplifting to a branch that is only supported for Windows 7-8.1 and macOS 10.12-10.14.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330669\n", "files": ["toolkit/components/processtools/tests/browser/browser.ini"], "git_node": "a0356acc5251ff41599c63d1c5dffe6c32ca0a3d", "git_parents": ["48422d5c200641b7a219dd891be32166cff2c956"], "node": "7d161aa794ecbf8df2572b8c6690c67736c4d791", "parents": ["b40e191aff08631efd0c7ded9bd9a5f015a0882d"], "tags": []}], "date": 1791470427, "git_changesets": ["a0356acc5251ff41599c63d1c5dffe6c32ca0a3d"], "user": "rvandermeulen@mozilla.com"}, "1649": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077730.  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331364\n", "files": ["gfx/2d/DrawTargetCairo.cpp", "gfx/thebes/gfxPattern.cpp"], "git_node": "17a9e0a186bdafa7cc666df2f7c5297f778905ad", "git_parents": ["a0356acc5251ff41599c63d1c5dffe6c32ca0a3d"], "node": "d660cc953cf5a8621f8ffe1b257f710bbde1574f", "parents": ["7d161aa794ecbf8df2572b8c6690c67736c4d791"], "tags": []}], "date": 1791470955, "git_changesets": ["17a9e0a186bdafa7cc666df2f7c5297f778905ad"], "user": "rvandermeulen@mozilla.com"}, "1650": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077739.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331018\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331353\n", "files": ["gfx/wr/swgl/src/swgl_ext.h"], "git_node": "226098b043afef8c99702db49197c792722284d7", "git_parents": ["17a9e0a186bdafa7cc666df2f7c5297f778905ad"], "node": "6f06345154e788804172c662f4bafd9ad56bc532", "parents": ["d660cc953cf5a8621f8ffe1b257f710bbde1574f"], "tags": []}], "date": 1791470981, "git_changesets": ["226098b043afef8c99702db49197c792722284d7"], "user": "rvandermeulen@mozilla.com"}, "1651": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075985 - Take strong reference to doc when script can run in SubmitSubmission  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330116\n", "files": ["dom/html/HTMLFormElement.cpp"], "git_node": "07bad0cf6b750952e363ba264123ea61727b8b64", "git_parents": ["226098b043afef8c99702db49197c792722284d7"], "node": "16ec149cff6dc04152499b530ecc3d0baf7aa2f9", "parents": ["6f06345154e788804172c662f4bafd9ad56bc532"], "tags": []}], "date": 1791471002, "git_changesets": ["07bad0cf6b750952e363ba264123ea61727b8b64"], "user": "rvandermeulen@mozilla.com"}, "1652": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076268 - Simplify nsGenConInitializer.  a=RyanVM DONTBUILD\n\nNo need to create the list upfront, do it only when we get to initialize\nthe text frame.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331348\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332006\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-contain/crashtests/contain-style-discarded-item.html"], "git_node": "112eb01c9e6d0b82649292baaa2f1984679f2cb4", "git_parents": ["07bad0cf6b750952e363ba264123ea61727b8b64"], "node": "93ebb387dc34f87cc73baa7d6658951e79743f8e", "parents": ["16ec149cff6dc04152499b530ecc3d0baf7aa2f9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076268 - Don't create an unnecessary style scope from AddCounterChanges.  a=RyanVM DONTBUILD\n\nThis is a bit sketchy over-all, but is enough to prevent the\nfirst-letter code from messing up the style scoping, and I think it's\nsound, because first-letter can never pull a whole inline or somesuch...\n\nThis is only an issue for that code because ::first-letter will create a\nframe for an arbitrarily deep text node (but just the text, which can't\nhave counters). So if it manages to create something for a text node\nthat's about  to go away we end up with a stale scope.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331349\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332007\n", "files": ["layout/base/ContainStyleScopeManager.cpp", "layout/base/nsCounterManager.cpp", "layout/base/nsCounterManager.h", "testing/web-platform/tests/css/css-contain/crashtests/contain-style-first-letter-colgroup.html", "testing/web-platform/tests/css/css-contain/crashtests/contain-style-first-letter.html"], "git_node": "2bc071243bbc3f552723acb4e78a34201ec6fb79", "git_parents": ["112eb01c9e6d0b82649292baaa2f1984679f2cb4"], "node": "2b6505e604d4a333e7c29b26b6ffa682d6ae7dab", "parents": ["93ebb387dc34f87cc73baa7d6658951e79743f8e"], "tags": []}], "date": 1791471060, "git_changesets": ["112eb01c9e6d0b82649292baaa2f1984679f2cb4", "2bc071243bbc3f552723acb4e78a34201ec6fb79"], "user": "rvandermeulen@mozilla.com"}, "1653": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077656 - Don't check whether directory is readable in content process;  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331722\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331982\n", "files": ["dom/html/test/browser.ini", "dom/html/test/browser_input_file_picker_default_directory.js", "widget/nsBaseFilePicker.cpp"], "git_node": "d91742786c1e72f950d8d5b28eb79261a7b98f78", "git_parents": ["2bc071243bbc3f552723acb4e78a34201ec6fb79"], "node": "bb0d0fe89920ef83680341980090b5fe1ef57d89", "parents": ["2b6505e604d4a333e7c29b26b6ffa682d6ae7dab"], "tags": []}], "date": 1791471085, "git_changesets": ["d91742786c1e72f950d8d5b28eb79261a7b98f78"], "user": "rvandermeulen@mozilla.com"}, "1654": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077656 - Drop the Docs case from browser_input_file_picker_default_directory.js on ESR115. a=test-only\n\nThe \"Docs\" directory service key does not exist on ESR115, so the test threw at load.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n", "files": ["dom/html/test/browser_input_file_picker_default_directory.js"], "git_node": "a90e60a04ca218aef9c22b3b216c87b3b80e418c", "git_parents": ["d91742786c1e72f950d8d5b28eb79261a7b98f78"], "node": "8d8d30dc2d94214ef52034596f9fee40d853aa07", "parents": ["bb0d0fe89920ef83680341980090b5fe1ef57d89"], "tags": []}], "date": 1791475301, "git_changesets": ["a90e60a04ca218aef9c22b3b216c87b3b80e418c"], "user": "rvandermeulen@mozilla.com"}, "1655": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075996 - Check the root element before pretty printing.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331121\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332054\n", "files": ["dom/xml/crashtests/2075996-1.html", "dom/xml/crashtests/2075996-2.html", "dom/xml/crashtests/2075996.sjs", "dom/xml/crashtests/crashtests.list", "dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLPrettyPrinter.cpp"], "git_node": "fb81bc4877cc3520059febc70725c846a2c8837f", "git_parents": ["a90e60a04ca218aef9c22b3b216c87b3b80e418c"], "node": "ba0592727856229837ecde4fa2e913706ad05437", "parents": ["8d8d30dc2d94214ef52034596f9fee40d853aa07"], "tags": []}], "date": 1791492306, "git_changesets": ["fb81bc4877cc3520059febc70725c846a2c8837f"], "user": "rvandermeulen@mozilla.com"}, "1656": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079904 - Allow dbghelp.dll to be loaded in the GMP sandbox for Widevine. r=media-playback-reviewers,azebrowski a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332160\n", "files": ["dom/media/gmp/GMPChild.cpp", "dom/media/gmp/GMPParent.cpp"], "git_node": "9edca525765fddbc18267e643f68cc62f4f77434", "git_parents": ["fb81bc4877cc3520059febc70725c846a2c8837f"], "node": "f47793a479dd6b4cce47acef459bbd1bceea6591", "parents": ["ba0592727856229837ecde4fa2e913706ad05437"], "tags": []}], "date": 1791494141, "git_changesets": ["9edca525765fddbc18267e643f68cc62f4f77434"], "user": "rvandermeulen@mozilla.com"}, "1657": {"changesets": [{"author": "Amy Burnett \u003camyb@openai.com\u003e", "branch": "default", "desc": "Bug 2075431 - IndexedDB: turn debug assert into a release check, and compute the DB filepath the same way everywhere.  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332345\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "8e4deddc9f2703b88a381b5b09d3af6156a25db2", "git_parents": ["9edca525765fddbc18267e643f68cc62f4f77434"], "node": "71e4633b30891824378c45866f9d66dbe582b25b", "parents": ["f47793a479dd6b4cce47acef459bbd1bceea6591"], "tags": []}], "date": 1791562151, "git_changesets": ["8e4deddc9f2703b88a381b5b09d3af6156a25db2"], "user": "rvandermeulen@mozilla.com"}, "1658": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076399.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332247\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332316\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp"], "git_node": "c975de50d7bd1e1955c35062660b33899956d9fe", "git_parents": ["8e4deddc9f2703b88a381b5b09d3af6156a25db2"], "node": "0a93f7e66ca38e87fafb816dba00e14f7e01a178", "parents": ["71e4633b30891824378c45866f9d66dbe582b25b"], "tags": []}], "date": 1791562173, "git_changesets": ["c975de50d7bd1e1955c35062660b33899956d9fe"], "user": "rvandermeulen@mozilla.com"}, "1659": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079062 - Use a single task to resolve the ready promise and fire loadingdone/loadingerror events.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332162\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332375\n", "files": ["layout/style/FontFaceSet.cpp", "layout/style/FontFaceSet.h"], "git_node": "a5a60c4c4c0d1030532a358d32d8eb15f6cea5c5", "git_parents": ["c975de50d7bd1e1955c35062660b33899956d9fe"], "node": "3e9e40f1aeac4e491102ab302c5cf237a11b8a16", "parents": ["0a93f7e66ca38e87fafb816dba00e14f7e01a178"], "tags": []}], "date": 1791562194, "git_changesets": ["a5a60c4c4c0d1030532a358d32d8eb15f6cea5c5"], "user": "rvandermeulen@mozilla.com"}, "1660": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079687.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332230\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332368\n", "files": ["dom/webidl/CSSRule.webidl", "dom/webidl/CSSStyleDeclaration.webidl", "layout/style/Rule.cpp", "layout/style/Rule.h", "layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h", "layout/style/nsICSSDeclaration.cpp", "layout/style/nsICSSDeclaration.h"], "git_node": "898ae034262a405e19a8b9e0861e8c32dc50d3b2", "git_parents": ["a5a60c4c4c0d1030532a358d32d8eb15f6cea5c5"], "node": "ad66f9b9e378cd272de546bfccca6bdc95b67b28", "parents": ["3e9e40f1aeac4e491102ab302c5cf237a11b8a16"], "tags": []}], "date": 1791562216, "git_changesets": ["898ae034262a405e19a8b9e0861e8c32dc50d3b2"], "user": "rvandermeulen@mozilla.com"}, "1661": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075853 - Probe HSTS hosts with a sliding-window pool and retry failures once.  a=diannaS\n\ngetHSTSPreloadList.js probed hosts in batches of 500 and waited for the slowest request of each batch, so most\nbatches took the full 30 second timeout. The bursts of 500 lookups also overwhelmed the container's DNS\nresolver and produced tens of thousands of false connection failures, which kept live Chromium-listed hosts\noff the list.\n\nA pool of 250 requests now starts the next one as soon as one completes. Every connection failure, TLS errors\nincluded, is then retried once in a second pass with the same concurrency and timeout. This replaces\nMAX_RETRIES, which at 1 never retried.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329494\n\n(cherry picked from commit 5807cfa561bec3d51ba6bf8df36ee112cbddfd70)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332558\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "d6c0374e471adf88c52f66dd5eea016547ef6908", "git_parents": ["898ae034262a405e19a8b9e0861e8c32dc50d3b2"], "node": "eed48609538cbe53b76a9553e710e5a56b99997d", "parents": ["ad66f9b9e378cd272de546bfccca6bdc95b67b28"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075853 - Probe HSTS preload hosts in random order and retry 429 responses.  a=diannaS\n\nChromium's list holds thousands of domains of one hosting operator in a contiguous block, all served from two\naddresses. Probing in list order sent nearly every request in flight to those two addresses at once, and the\noperator answered with 429 for thousands of hosts that otherwise send a valid header, which kept them off the\npreload list. Shuffling the probe order spreads them over the whole run. The operator still limits the rate\nover the run as a whole, so this recovers only part of the entries it kept off the list. It also shortens the\nmain pass by about a third, mostly because that block answers slowly when probed all at once.\n\n429 responses without the header also join the connection failures in the retry pass, which runs after the\nmain pass and is spread out the same way. processStsHeader now keeps the HTTP status so the retry pass can\nrecognize them. A second retry pass was considered and left out: it would cost about as long as the first,\nmostly in 30 second timeouts, while the first reaches under 1% of the hosts it retries.\n\nThis is an addition to the plan in bug 1891052, which did not cover rate limiting.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329496\n\n(cherry picked from commit 263339295e4694a4b9363552c6160184c69cca60)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332559\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "0571711d4355228ee842be39ca47c786a10adddc", "git_parents": ["d6c0374e471adf88c52f66dd5eea016547ef6908"], "node": "fb868fe0d47eec13f27c414be08b326f0c9f016d", "parents": ["eed48609538cbe53b76a9553e710e5a56b99997d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078929 - Run the repo-update task on b-linux-medium workers with a shorter max run time.  a=diannaS\n\n(cherry picked from commit fb57f2a08b39, adapted to the single esr115 task)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332560\n", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": "bae4024ee373391244fd0c6532b253cf1aa673cb", "git_parents": ["0571711d4355228ee842be39ca47c786a10adddc"], "node": "7340057f2311fa63f37c80c0f9e8da6db5d3629e", "parents": ["fb868fe0d47eec13f27c414be08b326f0c9f016d"], "tags": []}], "date": 1791575863, "git_changesets": ["d6c0374e471adf88c52f66dd5eea016547ef6908", "0571711d4355228ee842be39ca47c786a10adddc", "bae4024ee373391244fd0c6532b253cf1aa673cb"], "user": "dsmith@mozilla.com"}, "1662": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079062 - Use a single task to resolve the ready promise and fire loadingdone/loadingerror events. a=RyanVM DONTBUILD\" for causing gtests and mochitest plain failures\n\nThis reverts commit a5a60c4c4c0d1030532a358d32d8eb15f6cea5c5.\n", "files": ["layout/style/FontFaceSet.cpp", "layout/style/FontFaceSet.h"], "git_node": "6c98c0e8c764507a18bae9fd6996a56153b49938", "git_parents": ["bae4024ee373391244fd0c6532b253cf1aa673cb"], "node": "e275af3a2619e64d168c8632805471155cb7b18e", "parents": ["7340057f2311fa63f37c80c0f9e8da6db5d3629e"], "tags": []}], "date": 1791577604, "git_changesets": ["6c98c0e8c764507a18bae9fd6996a56153b49938"], "user": "asilaghi@mozilla.com"}, "1663": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075853 - Raise the DNS resolver thread limits for the HSTS preload probes. a=RyanVM DONTBUILD\n\nESR115 predates bug 1753979, so its resolver defaults to 5 + 3 threads, which throttles the 250 concurrent\nprobes to a third of the newer branches' rate and pushes the run past the task's max-run-time. Use the current\ndefaults instead.\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "d16c8b0ace3196fe100ac701c5469b472de25db3", "git_parents": ["6c98c0e8c764507a18bae9fd6996a56153b49938"], "node": "017e604262a2a7041e87e0aebf649329da483b1c", "parents": ["e275af3a2619e64d168c8632805471155cb7b18e"], "tags": []}], "date": 1791600901, "git_changesets": ["d16c8b0ace3196fe100ac701c5469b472de25db3"], "user": "rvandermeulen@mozilla.com"}, "1664": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080408 - Raise the repo-update task's max-run-time to 7200 seconds. a=RyanVM\n", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": "53e86d5c52cad6681235f72c6e750b6da8f58751", "git_parents": ["d16c8b0ace3196fe100ac701c5469b472de25db3"], "node": "3a04080de2e21458b239952faff4549a1f199e84", "parents": ["017e604262a2a7041e87e0aebf649329da483b1c"], "tags": []}], "date": 1791638230, "git_changesets": ["53e86d5c52cad6681235f72c6e750b6da8f58751"], "user": "rvandermeulen@mozilla.com"}, "1665": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080342 - Skip the bugbug confidence_thresholds key when merging bugbug replies. a=test-only DONTBUILD\n\nThe key is a nested dict per kind, so merging two replies compared dicts with `\u003c` and threw. Nothing on this\nbranch reads it.\n", "files": ["taskcluster/gecko_taskgraph/optimize/bugbug.py"], "git_node": "277656cac5c5397a409e3e4d8be6b3b09a33c3be", "git_parents": ["53e86d5c52cad6681235f72c6e750b6da8f58751"], "node": "1401558deb51be911c5376436342e804fb282090", "parents": ["3a04080de2e21458b239952faff4549a1f199e84"], "tags": []}], "date": 1791639803, "git_changesets": ["277656cac5c5397a409e3e4d8be6b3b09a33c3be"], "user": "rvandermeulen@mozilla.com"}, "1666": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Backed out 5 changesets (bug 2075853, bug 2078929, bug 2080408) for repo-update timeouts on esr115. a=RyanVM\n\nBacked out changeset 53e86d5c52ca (bug 2080408)\nBacked out changeset d16c8b0ace31 (bug 2075853)\nBacked out changeset bae4024ee373 (bug 2078929)\nBacked out changeset 0571711d4355 (bug 2075853)\nBacked out changeset d6c0374e471a (bug 2075853)\n", "files": ["task