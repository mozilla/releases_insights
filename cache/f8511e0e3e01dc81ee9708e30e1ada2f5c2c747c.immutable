/web-platform/meta/css/css-position/crashtests/content-visibility-abspos-continuations-crash.html.ini"], "git_node": "58c9666da8377e30676fe29bc543ad8af9a38f6b", "git_parents": ["10a62c633dd99afcf5ec50a8b4b97698389dc4e4"], "node": "3b35b4d87a6bc0a02adb3768604eee26386ca479", "parents": ["a44412076b6630b538afd34f3f099f6657f0589a"], "tags": []}], "date": 1792514501, "git_changesets": ["58c9666da8377e30676fe29bc543ad8af9a38f6b"], "user": "rvandermeulen@mozilla.com"}, "1752": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083514 - Deal with reframes of ancestors of replicated fixed-pos frames.  a=RyanVM DONTBUILD\n\nSo the issue is that esr153 reframes the ::before and that means really\nreframing the originating element entirely, which is _not_ in the\nfixed-pos subtree. The WPT triggers the issue pre-patch on nightly and\ndoesn't depend on us eventually allowing reframing of individual pseudos\n(which is on file).\n\nMove the paginated bail-out sooner since it's the most aggressive one.\nOtherwise I'm guessing that if you hit the multicol case you might still\nbe able to trigger the original issue.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335133\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335546\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "testing/web-platform/tests/css/printing/fixed-generated-content-reconstruct-crash-print.html"], "git_node": "f3335d9ac911d47b93d734a345b45cf32c8e02e7", "git_parents": ["58c9666da8377e30676fe29bc543ad8af9a38f6b"], "node": "da0261146387465be122b185c8357eb48d395f88", "parents": ["3b35b4d87a6bc0a02adb3768604eee26386ca479"], "tags": []}], "date": 1792517114, "git_changesets": ["f3335d9ac911d47b93d734a345b45cf32c8e02e7"], "user": "rvandermeulen@mozilla.com"}, "1753": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "defau