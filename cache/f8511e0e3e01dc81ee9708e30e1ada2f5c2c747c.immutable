799fe76d0b6642cd2df49d2285b200b7a35", "git_parents": ["bf2b7416fa2c9909be9734b2b0acbd1986dcd725"], "node": "0bd1f2026c2780c4a95d198b157419d95babf467", "parents": ["176a1d79c0f152fec18421b56acf42ed4f38e550"], "tags": []}], "date": 1792022170, "git_changesets": ["2f2f6799fe76d0b6642cd2df49d2285b200b7a35"], "user": "rvandermeulen@mozilla.com"}, "1707": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2079053 - Make sure that `HTMLEditor::CreateAnonymousElement` and `HTMLEditor::GetPositionAndDimensions` won't handle different document's node  a=RyanVM DONTBUILD\n\nIf the target node of resizers etc was moved into another document\nwhile we're initializing the native anonymous nodes, we may start to\nput some anonymous nodes into the new target's owner document.\nTherefore, the methods should return error in the case to make the\ncaller abort the initialization.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332618\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333936\n", "files": ["editor/libeditor/HTMLAnonymousNodeEditor.cpp"], "git_node": "a0c5c01ae2d903322b9bf0059cde64e4fdcaf4f5", "git_parents": ["2f2f6799fe76d0b6642cd2df49d2285b200b7a35"], "node": "a3e050f7a1ee40193f9ad81b6b955d8f6a74c3f1", "parents": ["0bd1f2026c2780c4a95d198b157419d95babf467"], "tags": []}], "date": 1792022193, "git_changesets": ["a0c5c01ae2d903322b9bf0059cde64e4fdcaf4f5"], "user": "rvandermeulen@mozilla.com"}, "1708": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2081549 - ImageDocument should use the right token list,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333622\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333651\n", "files": ["dom/html/ImageDocument.cpp"], "git_node": "dae73f9ec2fe129d016214e10fed0e42d3124824", "git_parents": ["a0c5c01ae2d903322b9bf0059cde64e4fdcaf4f5"], "node": "6b7cef0f7c8e094f8d1b71493e15dab643e0ec05", "parents": ["a3e050f7a1ee40193f9ad81b6b955d8f6a74c3f1"], "tags": []}], "date": 1792022215, "git_changesets": ["dae73f9ec2fe129d016214e10fed0e42d3124824"], "user": "rvandermeulen@mozilla.com"}, "1709": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079046 - Keep the HTTP/2 session alive while adding and cleaning up streams,  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334044\n", "files": ["netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/nsHttpConnection.cpp"], "git_node": "9ade10f2b41fe529aec52b575a69ec9733978d01", "git_parents": ["dae73f9ec2fe129d016214e10fed0e42d3124824"], "node": "131f8fa2363fea17bf156ed5933e85dd76c3bb18", "parents": ["6b7cef0f7c8e094f8d1b71493e15dab643e0ec05"], "tags": []}], "date": 1792082527, "git_changesets": ["9ade10f2b41fe529aec52b575a69ec9733978d01"], "user": "rvandermeulen@mozilla.com"}, "1710": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079692 - Handle WebSocketChannel::OnUpgradeFailed on the main thread.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332515\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334001\n", "files": ["netwerk/protocol/websocket/WebSocketChannel.cpp"], "git_node": "ee8e55e611cfda7074ae14a6538366b12733729e", "git_parents": ["9ade10f2b41fe529aec52b575a69ec9733978d01"], "node": "9359f523af878858d88fcfed426018d1518e635e", "parents": ["131f8fa2363fea17bf156ed5933e85dd76c3bb18"], "tags": []}], "date": 1792082551, "git_changesets": ["ee8e55e611cfda7074ae14a6538366b12733729e"], "user": "rvandermeulen@mozilla.com"}, "1711": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079036 - Clamp damage area in nsTableCellFrame::DidSetComputedStyle.  a=RyanVM DONTBUILD\n\n(original patch provided by clauditor)\n\nThe col-span clamp in nsTableCellFrame::DidSetComputedStyle here is sufficient\nto fix the reported issue; but given the complexity of table and border-collapse\ncode in general, the precaution of clamping in nsTableFrame::ExpandBCDamageArea\nseems worthwhile for a little extra hardening.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332732\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334301\n", "files": ["layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableFrame.cpp", "testing/web-platform/tests/css/css-tables/crashtests/border-collapse-dynamic-crash.html"], "git_node": "a0b87bd0fd2b7179a84c7a78932ac95f115f627f", "git_parents": ["ee8e55e611cfda7074ae14a6538366b12733729e"], "node": "cc7b4e28880bb9b6c3e411481dbd322ae2074399", "parents": ["9359f523af878858d88fcfed426018d1518e635e"], "tags": []}], "date": 1792117582, "git_changesets": ["a0b87bd0fd2b7179a84c7a78932ac95f115f627f"], "user": "rvandermeulen@mozilla.com"}, "1712": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082092: Limit length of regexp literals in CheckPatternSyntaxImpl  a=RyanVM\n\nI'm not including the test because the source file is 2GB, it needs at least 4GB more memory, and has a runtime measured in minutes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333940\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334234\n", "files": ["js/src/irregexp/RegExpAPI.cpp"], "git_node": "4baf9a9fe47383db8988df9226bf414b497086fb", "git_parents": ["a0b87bd0fd2b7179a84c7a78932ac95f115f627f"], "node": "0593211a666b8bf5f56136ba5ce13679948ffa47", "parents": ["cc7b4e28880bb9b6c3e411481dbd322ae2074399"], "tags": []}], "date": 1792117605, "git_changesets": ["4baf9a9fe47383db8988df9226bf414b497086fb"], "user": "rvandermeulen@mozilla.com"}, "1713": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079054 - Use the current document in ScreenOrientation::MaybeChanged after firing mozorientationchange.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334050\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334558\n", "files": ["dom/base/ScreenOrientation.cpp"], "git_node": "b4ab6f6c435b371dbd2dddf69f21e3c80017f09d", "git_parents": ["4baf9a9fe47383db8988df9226bf414b497086fb"], "node": "b4e718d0e909a9c4952c9b365ca35fe5e02e632d", "parents": ["0593211a666b8bf5f56136ba5ce13679948ffa47"], "tags": []}], "date": 1792266686, "git_changesets": ["b4ab6f6c435b371dbd2dddf69f21e3c80017f09d"], "user": "rvandermeulen@mozilla.com"}, "1714": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082005 - Initialize cx in FirstSubsumedFrame's move constructor.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333987\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334507\n", "files": ["js/public/Stack.h", "js/src/jsapi-tests/testSavedStacks.cpp"], "git_node": "0d9fec5d22ca9361486e645ab0060811df3113bb", "git_parents": ["b4ab6f6c435b371dbd2dddf69f21e3c80017f09d"], "node": "63a6529557f5206813186ace13d631b8c5860964", "parents": ["b4e718d0e909a9c4952c9b365ca35fe5e02e632d"], "tags": []}], "date": 1792266709, "git_changesets": ["0d9fec5d22ca9361486e645ab0060811df3113bb"], "user": "rvandermeulen@mozilla.com"}, "1715": {"changesets": [{"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079560 - Avoid a quadratic slowdown in mbsdiff on long duplicated data.  a=RyanVM DONTBUILD\n\nThe macOS universal XUL holds its architecture-independent data twice. When\nthe copy mbsdiff is following is only 1-10 bytes worse than the other one,\nthe scan loop calls search() once per byte of the run, and the 156.x -\u003e 158.0\nXUL diffs took over 5 hours. Taking any exact match of at least 64 KiB ends\nthat crawl; the output only changes where the scan would otherwise get stuck.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332128\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334598\n", "files": ["other-licenses/bsdiff/bsdiff.c"], "git_node": "69f2218edfb00763534ac88ae58387d3bbc060c9", "git_parents": ["0d9fec5d22ca9361486e645ab0060811df3113bb"], "node": "fabef2ac5087c026626069b60a50a8d3fccabfe5", "parents": ["63a6529557f5206813186ace13d631b8c5860964"], "tags": []}], "date": 1792266732, "git_changesets": ["69f2218edfb00763534ac88ae58387d3bbc060c9"], "user": "rvandermeulen@mozilla.com"}, "1716": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082001 - Make ElementInternals::mForm a RefPtr.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334194\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334619\n", "files": ["dom/html/ElementInternals.cpp", "dom/html/ElementInternals.h"], "git_node": "27bccb0f0387a02467987617f9d6db16760d130a", "git_parents": ["69f2218edfb00763534ac88ae58387d3bbc060c9"], "node": "b26f98a8fd4f7c0727f549470d7e786fd5fbbe6e", "parents": ["fabef2ac5087c026626069b60a50a8d3fccabfe5"], "tags": []}], "date": 1792266754, "git_changesets": ["27bccb0f0387a02467987617f9d6db16760d130a"], "user": "rvandermeulen@mozilla.com"}, "1717": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068395 - Make densifySparseElements update the initialized length infallibly.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334009\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334521\n", "files": ["js/src/vm/NativeObject.cpp", "js/src/vm/NativeObject.h", "js/src/vm/Shape.cpp"], "git_node": "8ce3d2ce87d7cf009b6d8048b2eda428068c925f", "git_parents": ["27bccb0f0387a02467987617f9d6db16760d130a"], "node":