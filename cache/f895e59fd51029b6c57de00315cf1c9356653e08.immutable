u\n\nMozReview-Commit-ID: 328ETwMdVnq", "files": ["dom/media/MediaData.cpp", "gfx/layers/ImageContainer.cpp"], "git_node": null, "git_parents": [null], "node": "456913d7e8b55a26aa46697d0663e7ffe6a44f02", "parents": ["ac743923f81ddf020e8a236cfc625824fc69b2fa"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1334465 - Make HttpChannelParent::mIPCClosed atomic. r=bagder, a=ritu\n\nMozReview-Commit-ID: 6irCJMAjzjW", "files": ["netwerk/protocol/http/HttpChannelParent.h"], "git_node": null, "git_parents": [null], "node": "f95c5b88144296dc338b325b3e8b6d7c3be6c629", "parents": ["456913d7e8b55a26aa46697d0663e7ffe6a44f02"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1334465 - Set mIPCClosed to true before calling SendDeleteSelf in order to avoid race. r=bagder, a=ritu\n\nIn the previous code, a race condition could cause us to call SendSetPriority() after calling SendDeleteSelf.\n\nFor example:\nT1: SendDeleteSelf()\nT2: if (!mIPCClosed) SendSetPriority()\nT1: mIPCClosed = true\n\nMozReview-Commit-ID: 3XOwCaphb2o", "files": ["netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": null, "git_parents": [null], "node": "8a4265c8fb4135b8311fb723ab9891ee72717b25", "parents": ["f95c5b88144296dc338b325b3e8b6d7c3be6c629"], "tags": []}], "date": 1519161617, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7553": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "201086f58dda1ac480dd3ed9e887b3a5c5134305", "parents": ["8a4265c8fb4135b8311fb723ab9891ee72717b25"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Aut