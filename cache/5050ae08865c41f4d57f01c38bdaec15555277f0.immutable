git_parents": ["c47200ff4a95836a1bcb00e157f33f8da11625dc"], "node": "50b48ec8a64205b93eb7c10b40c363532f872621", "parents": ["2b4a20addc8c312e5b27d691ab20a6fa13fe76a7"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063078 - In WebrtcMediaDataEncoder switch to generic, non-deprecated, end_of_picture (Cherry-pick Bug 1859231). r=mjf a=RyanVM DONTBUILD\" for causing build bustages\n\nThis reverts commit 8192fe4690323beca9af3792beb8278fe630d01f.\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcMediaDataEncoderCodec.cpp"], "git_node": "34c8996bb5e6e6d0f98de7bdafc271f8c988e460", "git_parents": ["16c563bb03712e62b471da86c892a8caea8b3714"], "node": "54d13274abf4ad7c9a5822b93f04a3d900e15813", "parents": ["50b48ec8a64205b93eb7c10b40c363532f872621"], "tags": []}], "date": 1787410215, "git_changesets": ["c47200ff4a95836a1bcb00e157f33f8da11625dc", "16c563bb03712e62b471da86c892a8caea8b3714", "34c8996bb5e6e6d0f98de7bdafc271f8c988e460"], "user": "rperta@mozilla.com"}, "1518": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058660 - Forward WebTransport stream events to the retargeted thread.  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320729\n", "files": ["netwerk/protocol/webtransport/WebTransportSessionProxy.cpp"], "git_node": "584b8de78787627cb53e98392b0cde5ee6c626a7", "git_parents": ["34c8996bb5e6e6d0f98de7bdafc271f8c988e460"], "node": "a969414feecc4c7b7a74ad55eb38055ef233be79", "parents": ["54d13274abf4ad7c9a5822b93f04a3d900e15813"], "tags": []}], "date": 1787517154, "git_changesets": ["584b8de78787627cb53e98392b0cde5ee6c626a7"], "user": "rvandermeulen@mozilla.com"}, "1519": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061397 - Tear down WebSocketChannelChild on the main thread to fix a UAF.  a=RyanVM\n\nESR115 uplift of D319530, hand-rebased onto the older Release()/\nMaybeReleaseIPCObject() shape.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320725\n", "files": ["netwerk/protocol/websocket/WebSocketChannelChild.cpp"], "git_node": "5381e791dab494a687cb47b41806c04ccad0a6d7", "git_parents": ["584b8de78787627cb53e98392b0cde5ee6c626a7"], "node": "8ddc4cf4fb5f96d2ccecb1a7ab77df7c78e95fca", "parents": ["a969414feecc4c7b7a74ad55eb38055ef233be79"], "tags": []}], "date": 1787517176, "git_changesets": ["5381e791dab494a687cb47b41806c04ccad0a6d7"], "user": "rvandermeulen@mozilla.com"}, "1520": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320841\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/gfx.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "af091571e198e41af52265ec6a8f641f1f5f4506", "git_parents": ["5381e791dab494a687cb47b41806c04ccad0a6d7"], "node": "2fa9551b1caf81668ece4b18a8df02103965b523", "parents": ["8ddc4cf4fb5f96d2ccecb1a7ab77df7c78e95fca"], "tags": []}], "date": 1787600545, "git_changesets": ["af091571e198e41af52265ec6a8f641f1f5f4506"], "user": "rvandermeulen@mozilla.com"}, "1521": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2053781 - Verify signatures of RS records in Nimbus  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321030\n", "files": ["browser/components/newtab/test/browser/browser_aboutwelcome_multistage_experimentAPI.js", "browser/components/newtab/test/browser/browser_asrouter_experimentsAPILoader.js", "browser/components/newtab/test/browser/browser_asrouter_targeting.js", "browser/components/newtab/test/browser/browser_trigger_messagesLoaded.js", "browser/components/newtab/test/browser/head.js", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/browser/head.js"], "git_node": "7a5f00e4e7991ecd68e2c46173c26baf42c787da", "git_parents": ["af091571e198e41af52265ec6a8f641f1f5f4506"], "node": "35bd0d65490cd2a24f4bf7723c5a1e77a57013de", "parents": ["2fa9551b1caf81668ece4b18a8df02103965b523"], "tags": []}], "date": 1787600582, "git_changesets": ["7a5f00e4e7991ecd68e2c46173c26baf42c787da"], "user": "rvandermeulen@mozilla.com"}, "1522": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061300 - Make ProxyObject::renew work when called on dying objects (ESR)  a=RyanVM DONTBUILD\n\nThis is similar to other places where we call setMayHavePointersToDeadCells().\nWe may end up remapping dying proxy objects so if we insert a storebuffer entry\nwe need to set this flag so we'll empty the nursery before we sweep the object.\n\nThe original testcase doesn't reproduce on this version due to differences in\nthe shell testing functions and has been removed from the patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320438\n", "files": ["js/src/proxy/Proxy.cpp"], "git_node": "419609f7cdf567966a0c9dd84fb87c692561ae04", "git_parents": ["7a5f00e4e7991ecd68e2c46173c26baf42c787da"], "node": "098a233a290eae8d8a65a50830b9869a0a5fb64d", "parents": ["35bd0d65490cd2a24f4bf7723c5a1e77a57013de"], "tags": []}], "date": 1787603554, "git_changesets": ["419609f7cdf567966a0c9dd84fb87c692561ae04"], "user": "rvandermeulen@mozilla.com"}, "1523": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2053781 - Adapt disableSignatureVerification for ESR115. a=bustage\n\nRemoteSettingsExperimentLoader only has a single Remote Settings collection on ESR115; the secure collection\nwas added later, so there is no remoteSettingsClients map to iterate. Toggle verifySignature on the one\nclient instead.\n\nThe exported test utils object is also still named ExperimentTestUtils on ESR115 rather than\nNimbusTestUtils, so head.js has to use the old name.\n", "files": ["toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/browser/head.js"], "git_node": "0a5c4e0b38c770e09ceab0c0ccedfb7377297d62", "git_parents": ["419609f7cdf567966a0c9dd84fb87c692561ae04"], "node": "343dece8f8e65e99392e941c058ed992112820f6", "parents": ["098a233a290eae8d8a65a50830b9869a0a5fb64d"], "tags": []}], "date": 1787604866, "git_changesets": ["0a5c4e0b38c770e09ceab0c0ccedfb7377297d62"], "user": "rvandermeulen@mozilla.com"}, "1524": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1927066 - Do not try to verify signatures of local data for Thunderbird, even if verifySignatures passed in as an option. a=RyanVM\n\nWe get here through https://searchfox.org/mozilla-central/rev/4ce36232b265b53de4fb7eb754430f94e262bbbe/netwerk/base/SimpleURIUnknownSchemesRemoteObserver.sys.mjs#100\nWe have local data with the same time stamp, so in this else if we do nothing:\nhttps://searchfox.org/mozilla-central/rev/4ce36232b265b53de4fb7eb754430f94e262bbbe/services/settings/RemoteSettingsClient.sys.mjs#499\n\nSince verifySignature is on the https://searchfox.org/mozilla-central/source/services/settings/RemoteSettingsClient.sys.mjs#598 sync() call happens, but the collection is not on the Thunderbird server ... therefore we get validation error and things bail out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242319\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs", "services/settings/test/unit/test_remote_settings.js"], "git_node": "66ad23c562dfa28b73c03d2c21a90ebd6211d68e", "git_parents": ["0a5c4e0b38c770e09ceab0c0ccedfb7377297d62"], "node": "a5173665d6c571170305ecfba4b0e922300f4801", "parents": ["343dece8f8e65e99392e941c058ed992112820f6"], "tags": []}], "date": 1787617211, "git_changesets": ["66ad23c562dfa28b73c03d2c21a90ebd6211d68e"], "user": "rvandermeulen@mozilla.com"}, "1525": {"changesets": [{"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046144 - Route ESR115 Windows 11 GPU tests to win10-64-2009-gpu r=aryx a=pascalc,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307415\n", "files": ["dom/canvas/test/webgl-conf/generated-mochitest.ini", "dom/canvas/test/webgl-conf/mochitest-errata.ini", "dom/canvas/test/webgl-mochitest/test_renderer_strings.html", "dom/media/test/reftest/color_quads/reftest.list", "dom/media/test/reftest/reftest.list", "image/test/reftest/generic/reftest.list", "layout/reftests/bugs/reftest.list", "taskcluster/ci/config.yml", "taskcluster/gecko_taskgraph/transforms/test/worker.py", "testing/web-platform/meta/css/css-highlight-api/painting/custom-highlight-painting-002.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3i.html.ini", "testing/web-platform/meta/css/filter-effects/filter-contrast-002.html.ini", "testing/web-platform/meta/css/filter-effects/svg-mutation-single-to-multiple-001.html.ini", "testing/web-platform/meta/css/filter-effects/svg-shorthand-hue-rotate-001.html.ini"], "git_node": "562eae91ab1d23dca9aec8e81c03d116fa676e63", "git_parents": ["66ad23c562dfa28b73c03d2c21a90ebd6211d68e"], "node": "0912124944aae2ff400c544068fcd08625b235e7", "parents": ["a5173665d6c571170305ecfba4b0e922300f4801"], "tags": []}], "date": 1787620490, "git_changesets": ["562eae91ab1d23dca9aec8e81c03d116fa676e63"], "user": "rvandermeulen@mozilla.com"}, "1526": {"changesets": [{"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066336 - Add win10_2009 to WPT fission run info.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321243\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321264\n", "files": ["testing/web-platform/fissionregressions.py"], "git_node": "18ebd65a629ebbd04b8ecbe51360bb54b617222e", "git_parents": ["562eae91ab1d23dca9aec8e81c03d116fa676e63"], "node": "8b88dbff2dadd7d85eaf0095821149109bce2eb3", "parents": ["0912124944aae2ff400c544068fcd08625b235e7"], "tags": []}], "date": 1787670644, "git_changesets": ["18ebd65a629ebbd04b8ecbe51360bb54b617222e"], "user": "rvandermeulen@mozilla.com"}, "1527": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2059018 - Explicitly record serializable support in components.conf,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315738\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321299\n", "files": ["image/decoders/icon/components.conf", "layout/build/components.conf", "modules/libjar/components.conf", "netwerk/build/components.conf", "security/manager/ssl/components.conf", "xpcom/components/StaticComponents.h", "xpcom/components/gen_static_components.py", "xpcom/io/moz.build", "xpcom/io/nsBinaryStream.cpp"], "git_node": "046cd7dcaa120505502a252f4ac820e9c9609619", "git_parents": ["18ebd65a629ebbd04b8ecbe51360bb54b617222e"], "node": "04d88a7a3a4c4b5a999a2e860138b45d189c8eca", "parents": ["8b88dbff2dadd7d85eaf0095821149109bce2eb3"], "tags": []}], "date": 1787675434, "git_changesets": ["046cd7dcaa120505502a252f4ac820e9c9609619"], "user": "rvandermeulen@mozilla.com"}, "1528": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059027 - Give the DLL blocklist shared section an empty DACL and a name. r=win-reviewers,gstoll a=RyanVM\n\nSharedSection::Init() creates the section with no security descriptor. Give\nthe object a present-but-empty DACL, as ipc/chromium's shared_memory_win.cc\ndoes for freezable shared memory.\n\nUnlike central, this branch still supports Windows 7, 8 and 8.1, and before\n8.1 CreateFileMappingW silently ignores lpSecurityAttributes for an unnamed\nobject. This version names the section so that the DACL applies, as we already\ndo in shared_memory_win.cc.  The name is not a secret: any process in the\nsession can enumerate \\Sessions\\\u003cn\u003e\\BaseNamedObjects, but the empty DACL\ndenies OpenFileMapping.  The only way to interfere is to create the object\nbefore we do, which is why we try a fresh name when we get\nERROR_ALREADY_EXISTS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321033\n", "files": ["browser/app/winlauncher/freestanding/SharedSection.cpp", "browser/app/winlauncher/freestanding/moz.build", "browser/app/winlauncher/test/TestCrossProcessWin.cpp", "browser/app/winlauncher/test/moz.build"], "git_node": "2e773b0d03b8e4f4ac89d733fa48e62646319b73", "git_parents": ["046cd7dcaa120505502a252f4ac820e9c9609619"], "node": "3dac78fdf052fe5cbe784a99a51d37e74f981765", "parents": ["04d88a7a3a4c4b5a999a2e860138b45d189c8eca"], "tags": []}], "date": 1787685276, "git_changesets": ["2e773b0d03b8e4f4ac89d733fa48e62646319b73"], "user": "rvandermeulen@mozilla.com"}, "1529": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2054650 - Enforce TYPE_INTERNAL_OBJECT/EMBED content policy types for object loads  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320111\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321247\n", "files": ["netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "925c98e71524f947b592fcb3544e50f58971f2d1", "git_parents": ["2e773b0d03b8e4f4ac89d733fa48e62646319b73"], "node": "82b84e90cfa6893ae6cf836fb1a8329d9264728b", "parents": ["3dac78fdf052fe5cbe784a99a51d37e74f981765"], "tags": []}], "date": 1787696516, "git_changesets": ["925c98e71524f947b592fcb3544e50f58971f2d1"], "user": "rvandermeulen@mozilla.com"}, "1530": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055705 - Harden drop link handling;  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319614\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321417\n", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": "1f57c79c95e139c3d6300bc0f73b6b83233b1792", "git_parents": ["925c98e71524f947b592fcb3544e50f58971f2d1"], "node": "1355f39fe166eccdfbadb8382069042205847f69", "parents": ["82b84e90cfa6893ae6cf836fb1a8329d9264728b"], "tags": []}], "date": 1787698694, "git_changesets": ["1f57c79c95e139c3d6300bc0f73b6b83233b1792"], "user": "rvandermeulen@mozilla.com"}, "1531": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061316 - Handle zero-length allocation chunk test,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318587\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321426\n", "files": ["js/src/gc/Nursery.cpp"], "git_node": "916cb3cf753cd2b1f6b56e51389c0661071266fe", "git_parents": ["1f57c79c95e139c3d6300bc0f73b6b83233b1792"], "node": "713124d101dc6894cf32c6c7c4293cf46f79633f", "parents": ["1355f39fe166eccdfbadb8382069042205847f69"], "tags": ["FIREFOX_115_40_0esr_BUILD1", "FIREFOX_115_40_0esr_RELEASE"]}], "date": 1787716220, "git_changesets": ["916cb3cf753cd2b1f6b56e51389c0661071266fe"], "user": "rvandermeulen@mozilla.com"}}
