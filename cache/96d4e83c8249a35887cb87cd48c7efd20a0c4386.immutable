ult", "desc": "Bug 1466222 - Get rid of unused stage_platform config entry. r=catlee\n\nfor \"Cleanup l10n mozharness config files.\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1533", "files": ["testing/mozharness/configs/single_locale/tc_android-api-16.py"], "git_node": null, "git_parents": [null], "node": "74b85be5b31981be1a2bbc3c34852d602b89bd2d", "parents": ["781fa671670d10452f0ab34413cfc79c452e7a2c"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1466222 - Get rid of unused replace_dict entries and buildid parsing support. r=catlee\n\nfor \"Cleanup l10n mozharness config files.\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1534", "files": ["testing/mozharness/scripts/desktop_l10n.py", "testing/mozharness/scripts/mobile_l10n.py"], "git_node": null, "git_parents": [null], "node": "61c7b1d638b510ac58fb32c8cb1eea8d82d1f005", "parents": ["74b85be5b31981be1a2bbc3c34852d602b89bd2d"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1466222 - Get rid of unused mobile_partner_repack.py script. r=catlee\n\nfor \"Cleanup l10n mozharness config files.\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1535", "files": ["testing/mozharness/scripts/mobile_partner_repack.py"], "git_node": null, "git_parents": [null], "node": "473d27282f86ba39596af834d9124ac4efe9d1b2", "parents": ["61c7b1d638b510ac58fb32c8cb1eea8d82d1f005"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1466222 - Do on-change for mobile_l10n.py too. r=me\n\nfor \"Cleanup l10n mozharness config files.\"", "files": ["taskcluster/ci/l10n/kind.yml"], "git_node": null, "git_parents": [null], "node": "968c2ff3b442fd159794a6968cbcbef97087efd2", "parents": ["473d27282f86ba39596af834d9124ac4efe9d1b2"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466689 - Perform macOS builds on gecko-{L}-b-linux worker type; r=dustin,mshal\n\nThe gecko-{L}-b-macosx64 worker types are really Linux (macOS builds are\ncross-compiled). These worker types are essentially identical to their\ngecko-{L}-b-linux counterparts.\n\nI don't see a compelling reason to maintain separate worker types for\nthese builds other than maybe cost accounting (worker types are tagged\nin AWS land and these tags can be more easily broken out for billing\nanalysis). But I don't think any important systems are relying on\nthis \"feature.\"\n\nSo let's move the macOS build tasks to the gecko-{L}-b-linux workers.\n\nMozReview-Commit-ID: 67bArn6IG9T", "files": ["taskcluster/ci/build/macosx.yml", "taskcluster/ci/searchfox/kind.yml"], "git_node": null, "git_parents": [null], "node": "df5da2a468c495a442dee88658ba0e16e41875e8", "parents": ["968c2ff3b442fd159794a6968cbcbef97087efd2"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466689 - Move repackage tasks to gecko-{L}-b-linux worker types; r=dustin\n\nFor the same reasons that we moved build tasks to this worker type.\n\nMozReview-Commit-ID: LZuzDtHSKL6", "files": ["taskcluster/taskgraph/transforms/repackage.py", "taskcluster/taskgraph/transforms/repackage_partner.py"], "git_node": null, "git_parents": [null], "node": "dd5768ae17e71a873ffc5312bb8befa7f1f1e231", "parents": ["df5da2a468c495a442dee88658ba0e16e41875e8"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466689 - Remove gecko-{L}-b-macosx worker types; r=dustin\n\nThey are no longer used. By not listing them, we prevent new tasks\nfrom using them.\n\nMozReview-Commit-ID: FiYhV8WcAsm", "files": ["taskcluster/taskgraph/util/workertypes.py"], "git_node": null, "git_parents": [null], "node": "62ecdedfbf20b9e2ceb2c9d57ce1990b4c86420d", "parents": ["dd5768ae17e71a873ffc5312bb8befa7f1f1e231"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466746 - dh-python backport for wheezy; r=glandium\n\ndh-python isn't available in Wheezy. Let's backport it so we can\nbuild Python packages that use it.\n\nFortunately for us, the package builds without any modifications.\nThe only customization we need is to ensure our custom Python\npackages are present in order to satisfy Build-Depends.\n\nMozReview-Commit-ID: CqZtwvosA6K", "files": ["taskcluster/ci/packages/kind.yml"], "git_node": null, "git_parents": [null], "node": "4dbf9778f0948e836c7d90120c0ed0851a657b0c", "parents": ["62ecdedfbf20b9e2ceb2c9d57ce1990b4c86420d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466746 - Debian packages for python-zstandard; r=glandium\n\npython-zstandard's 0.9.1 source distribution contains a debian/\ndirectory.\n\nOn Squeeze, producing a Debian package is straightforward.\n\nOn Wheezy, we need to hack up Build-Depends because Wheezy doesn't\nhave a package for the Hypothesis fuzzing library. This package is\nonly used for testing and our package building disables testing,\nso we don't even need to further hack up the packaging to disable\ntests.\n\nMozReview-Commit-ID: 6raXjdzggCH", "files": ["build/debian-packages/python-zstandard-wheezy.diff", "taskcluster/ci/packages/kind.yml"], "git_node": null, "git_parents": [null], "node": "df304cb358fba6601af10c53da348d9b0bd0c3d4", "parents": ["4dbf9778f0948e836c7d90120c0ed0851a657b0c"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466746 - Install python-zstandard in debian-base; r=glandium\n\nLet's install python-zstandard for both Python 2 and Python 3 in\nall our Debian-based images so it is readily available for use.\n\nMozReview-Commit-ID: 1L8zDc5MYXA", "files": ["taskcluster/ci/docker-image/kind.yml", "taskcluster/docker/debian-base/Dockerfile"], "git_node": null, "git_parents": [null], "node": "bdd2b744c28fa6d58252bec989107041e6494d7d", "parents": ["df304cb358fba6601af10c53da348d9b0bd0c3d4"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1465945 - make retrigger an action with kind=hook; r=tomprince\n\nMozReview-Commit-ID: LlZVweIjHsg", "files": ["taskcluster/taskgraph/actions/retrigger.py"], "git_node": null, "git_parents": [null], "node": "be0607e0a3e71828ca053f15a417c5a54ae12c10", "parents": ["bdd2b744c28fa6d58252bec989107041e6494d7d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460777 - Extract GPG keys to standalone files; r=glandium\n\nAfter this change, we consistently import GPG keys from files in\nthe GCC build scripts.\n\nMozReview-Commit-ID: BcyvCQoGbMS", "files": ["build/unix/build-gcc/5ED46A6721D365587791E2AA783FCD8E58BCAFBA.key", "build/unix/build-gcc/DA23579A74D4AD9AF9D3F945CEFAC8EAAF17519D.key", "taskcluster/scripts/misc/build-mingw32-nsis.sh", "taskcluster/scripts/misc/build-wine.sh"], "git_node": null, "git_parents": [null], "node": "4c064d7f7f7aa2f8d0273d439104350d82c2368d", "parents": ["be0607e0a3e71828ca053f15a417c5a54ae12c10"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1466222 - Noqa the pythonpath magic to avoid warnings about module imports not being first r=catlee\n\nfor \"Cleanup l10n mozharness config files.\" (Batch 2)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1540", "files": ["testing/mozharness/scripts/desktop_l10n.py", "testing/mozharness/scripts/mobile_l10n.py"], "git_node": null, "git_parents": [null], "node": "606fa9834fa44103e42b572a0558005e52667c27", "parents": ["4c064d7f7f7aa2f8d0273d439104350d82c2368d"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1466222 - Drop some unused runtime config tokens. r=catlee\n\nfor \"Cleanup l10n mozharness config files.