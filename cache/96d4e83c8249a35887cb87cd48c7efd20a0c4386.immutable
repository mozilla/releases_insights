.com/D2756", "files": ["testing/mozharness/scripts/release/generate-checksums.py"], "git_node": null, "git_parents": [null], "node": "9acf7f25890bae96986ab2ed2b5f51205e8644fc", "parents": ["2d248bce62d758a31a885f5e7d88918e1c9c88f3"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1463749 - Langpack Checksums. r=mtabara, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2446", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/post-beetmover-checksums-dummy/kind.yml", "taskcluster/ci/release-beetmover-signed-langpacks-checksums/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/beetmover_langpack_checksums.py"], "git_node": null, "git_parents": [null], "node": "2177be7a65c08d8989d2c6eed8ca9cffc0d5273d", "parents": ["9acf7f25890bae96986ab2ed2b5f51205e8644fc"], "tags": []}], "date": 1533935102, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "141": {"changesets": [{"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1482289 - Enlarge index buffer validation cache size to handle CAD workloads. r=kvark, a=RyanVM\n\nMozReview-Commit-ID: 8DF3o4mLYZ6", "files": ["dom/canvas/WebGLBuffer.cpp"], "git_node": null, "git_parents": [null], "node": "c0072e43781d23bf76a0ed5be607c40170f976c8", "parents": ["2177be7a65c08d8989d2c6eed8ca9cffc0d5273d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1483377 - Use static array for FilePreferences whitelist instead of StaticAutoPtr. r=mayhemer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3403", "files": ["xpcom/io/FilePreferences.cpp"], "git_node": null, "git_parents": [null], "node": "895eb260e9460d65b84982846c5867c3c49073af", "parents": ["c0072e43781d23bf76a0ed5be607c40170f976c8"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1404274 - Key Evaluation on the cloned JS objects. r=asuth, a=RyanVM", "files": ["dom/indexedDB/IDBCursor.cpp", "dom/indexedDB/IDBObjectStore.cpp", "dom/indexedDB/IDBObjectStore.h", "testing/web-platform/meta/IndexedDB/clone-before-keypath-eval.html.ini", "testing/web-platform/meta/IndexedDB/key_invalid.htm.ini", "testing/web-platform/meta/IndexedDB/keypath-exceptions.htm.ini"], "git_node": null, "git_parents": [null], "node": "8578421ae142b07cfcdc9139bffed428946dc6ba", "parents": ["895eb260e9460d65b84982846c5867c3c49073af"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1480640 - Fix hazard in CopyingStructuredCloneReadCallback. r=baku, a=RyanVM", "files": ["dom/indexedDB/IDBObjectStore.cpp"], "git_node": null, "git_parents": [null], "node": "bd80e86bf7049b0e0306258555d2fa0dc62eb725", "parents": ["8578421ae142b07cfcdc9139bffed428946dc6ba"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1481093 - Also update children of typed object type descriptor objects when compacting. r=sfink, a=RyanVM", "files": ["js/src/builtin/TypedObject.cpp", "js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug-1481093.js"], "git_node": null, "git_parents": [null], "node": "19066167de9dd75ec03eac9881f0f245b888fe32", "parents": ["bd80e86bf7049b0e0306258555d2fa0dc62eb725"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1479579 - Update GMP fallback downloader for Widevine CDM 1.4.9.1088. r=rhelmer, a=RyanVM\n\nMozReview-Commit-ID: 2f6ArUh12vz", "files": ["toolkit/content/gmp-sources/widevinecdm.json"], "git_node": null, "git_parents": [null], "node": "80f7741d8c4fdfe0c9d587793514783771d30360", "parents": ["19066167de9dd75ec03eac9881f0f245b888fe32"], "tags": []}, {"author": "Andreea Pavel \u003capavel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1483229 - Exit test early if TypedObject is not defined. r=jonco, a=test-only", "files": ["js/src/jit-test/tests/gc/bug-1481093.js"], "git_node": null, "git_parents": [null], "node": "24c0c057e80df4dfb4e8ec6520c7c871220322aa", "parents": ["80f7741d8c4fdfe0c9d587793514783771d30360"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1480092 - Cherrypick rev 52add5896661d186dec284ed646a4b33b607d2c7. r=drno a=RyanVM", "files": ["media/libvpx/bug1480092.patch", "media/libvpx/libvpx/vp8/common/postproc.c", "media/libvpx/update.py"], "git_node": null, "git_parents": [null], "node": "01a8adcbeab625c782b9e4f12778576c76ad90a9", "parents": ["24c0c057e80df4dfb4e8ec6520c7c871220322aa"], "tags": []}], "date": 1534363653, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "142": {"changesets": [{"author": "Michal Novotny \u003cmichal.novotny@gmail.com\u003e", "branch": "default", "desc": "Bug 1466577 - Race condition in WebSocketChannel::StopSession. r=hurley a=dveditz\n\nThis patch prevents calling WebSocketChannel::StopSession at the same time on main thread from WebSocketChannel::Close and on socket thread from WebSocketChannel::AbortSession.", "files": ["netwerk/protocol/websocket/WebSocketChannel.cpp", "netwerk/protocol/websocket/WebSocketChannel.h"], "git_node": null, "git_parents": [null], "node": "8857505321fd28e98a7a1e06178423b10ea6732b", "parents": ["01a8adcbeab625c782b9e4f12778576c76ad90a9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1471415 - Fix logic in nsXULPopupManager::ShouldConsumeOnMouseWheelEvent. r=smaug, a=RyanVM\n\nIt was accidentally toggled in bug 1423990.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1863", "files": ["layout/xul/nsXULPopupManager.cpp"], "git_node": null, "git_parents": [null], "node": "bcb4837d51e803b8f14e8363227477ae383a60d7", "parents": ["8857505321fd28e98a7a1e06178423b10ea6732b"], "tags": []}], "date": 1534406722, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "143": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3496", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "0e77bc4e6777cea375c4cf4957534ddeeafaa71a", "parents": ["bcb4837d51e803b8f14e8363227477ae383a60d7"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1461307 - Overwrite selection colors of widget which may be referred by IME via IM context with selection colors of GtkTextView. r=karlt, a=RyanVM\n\nIME (e.g., fcitx) may refer selection colors of widget under window which\nis associated with IM context to support any colored widget.  So, IME\nexpects good selection colors which have sufficient contrast between\nforeground and background, and also selection background color and\nwidget background color like GtkTextView.  However, some desktop themes\nset our widget to different selection colors from GtkTextView which may\nbe unreadable.\n\nnsTextFrame (which paints composition string) expects that composition\nstring colors coming from IME are sufficiently readable and background\ncolor of composition string and background color of our editor's default\nstyle (coming from LookAndFeel) have sufficient contrast because\nnsTextFrame assmes that composition string colors coming from IME are\ndecided for the default style.\n\nTherefore, this patch creates SelectionStyleProvider which overwrites\nselection style of our widget with selection style of GtkTextView so\nthat IME can refer selection colors of GtkTextView via our widget.\n\nMozReview-Commit-ID: 5vdcSgoEYv0", "files": ["widget/gtk/IMContextWrapper.cpp", "widget/gtk/IMContextWrapper.h", "widget/gtk/mozgtk/mozgtk.c", "widget/gtk/nsWidgetFactory.cpp", "widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "84d7324fb1185660117cf09bf1f3a95cfdfac454", "parents": ["0e77bc4e6777cea375c4cf4957534ddeeafaa71a"], "tags": []}], "date": 1534429443, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "144": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 947838 - Don't reload distro prefs, just load at the same time as customizations. r=florian, a=RyanVM\n\nMozReview-Commit-ID: DPaE92V2xKg", "files": ["browser/components/distribution.js", "browser/components/nsBrowserGlue.js"], "git_node": null, "git_parents": [null], "node": "dff964b7a5e64e36cd804c657f709ba43dc5eb68", "parents": ["84d7324fb1185660117cf09bf1f3a95cfdfac454"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1482694 - Don't clear the insertion point from ClearInsertedChildren if we're not the insertion point the node is assigned to. r=smaug, a=RyanVM\n\nWhat's going on is that nested XBL insertion points are completely unsound, and\nwe leave all sorts of kids in mInsertedChildren when bindings dynamically\nchange.\n\nSo if bindings change in a particular way so that the innermost insertion point\nis cleared, but the outermost bindings aren't, like this, we end up with an\ninconsistent flattened tree.\n\nThis prevents the inconsistent flattened tree in this case, though what ought\nto happen in the SetXBLInsertionPoint(nullptr) case is setting the insertion\npoint to the outer insertion point.\n\nBut we don't keep track of all our insertion points, and I don't think it's\nworth to fix that given XBL is going away unless it gives us more problems. See\nalso bug 1425362 & co.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3163", "files": ["dom/xbl/XBLChildrenElement.h"], "git_node": null, "git_parents": [null], "node": "b225794bcc8227913ed876bee67d6af4409fed89", "parents": ["dff964b7a5e64e36cd804c657f709ba43dc5eb68"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1482797 - Don't use MADV_FREE on Linux until we support it properly. r=njn, a=RyanVM", "files": ["memory/build/mozjemalloc.cpp"], "git_node": null, "git_parents": [null], "node": "0828425992f2782ba1e2ef4827682b2bf392010a", "parents": ["b225794bcc8227913ed876bee67d6af4409fed89"], "tags": []}], "date": 1534432202, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "145": {"changesets": [{"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1477817 - Try to get RBAB even with EXT_create_context_robustness. - r=kvark a=ryanvm\n\nMozReview-Commit-ID: JO2jc5ATE4s\n", "files": ["gfx/gl/GLContextProviderEGL.cpp"], "git_node": null, "git_parents": [null], "node": "d6e2e094e337273c7795a5b39cc08496f0efcc8c", "parents": ["0828425992f2782ba1e2ef4827682b2bf392010a"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1477817 - Add test_has_rbab to guarantee we can skip index validation where available. - r=kvark,qdot a=ryanvm\n\nMozReview-Commit-ID: JKVtfwwVGn9\n", "files": ["dom/canvas/WebGLContext.h", "dom/canvas/WebGLExtensionMOZDebug.cpp", "dom/canvas/test/webgl-mochitest/mochitest.ini", "dom/canvas/test/webgl-mochitest/test_has_rbab.html", "dom/webidl/WebGLRenderingContext.webidl"], "git_node": null, "git_parents": [null], "node": "a77a58eaf8f2e99a15b8abb8219ed0f5fa45cf68", "parents": ["d6e2e094e337273c7795a5b39cc08496f0efcc8c"], "tags": []}], "date": 1534546079, "git_changesets": [null, null], "user": "jgilbert@mozilla.com"}, "146": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3769", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "ef86fcf0934dfff10023ba09df0b6f31b989d9fc", "parents": ["a77a58eaf8f2e99a15b8abb8219ed0f5fa45cf68"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changesets a77a58eaf8f2 and d6e2e094e337 (bug 1477817) for Windows WebGL conformance test failures.", "files": ["dom/canvas/WebGLContext.h", "dom/canvas/WebGLExtensionMOZDebug.cpp", "dom/canvas/test/webgl-mochitest/mochitest.ini", "dom/canvas/test/webgl-mochitest/test_has_rbab.html", "dom/webidl/WebGLRenderingContext.webidl", "gfx/gl/GLContextProviderEGL.cpp"], "git_node": null, "git_parents": [null], "node": "5797501ab49c3d78b00601efc0a1747609ecd08d", "parents": ["ef86fcf0934dfff10023ba09df0b6f31b989d9fc"], "tags": []}], "date": 1534879518, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "147": {"changesets": [{"author": "Paolo Amadini \u003cpaolo.mozmail@amadzone.org\u003e", "branch": "default", "desc": "Bug 1393965 - Fix intermittent browser_default_image_filename.js. r=mconley, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3775", "files": ["toolkit/content/tests/browser/browser_default_image_filename.js"], "git_node": null, "git_parents": [null], "node": "d4e3a88eef06a4b712b0619c50538fb6973435d0", "parents": ["5797501ab49c3d78b00601efc0a1747609ecd08d"], "tags": []}, {"author": "David Parks \u003cdparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1445444- Properly initialize plugin window drawing type on Windows. r=jimm, a=RyanVM\n\nSets the default plugin window type to windowed on Windows.  Most of the time, plugins use async drawing so this will be overwritten but it should be properly initialized for cases where we do not switch to async.", "files": ["dom/plugins/base/nsPluginNativeWindowWin.cpp"], "git_node": null, "git_parents": [null], "node": "1973f8b39e0cfa9e277400f4b36332d77c5b4d0f", "parents": ["d4e3a88eef06a4b712b0619c50538fb6973435d0"], "tags": []}, {"author": "Kanika Saini \u003cksaini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469943 - Enterprise policy to set a custom app update URL. r=felipe, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_app_update_URL.js"], "git_node": null, "git_parents": [null], "node": "b68604c980e3413d57cd544ec1751668f1f02843", "parents": ["1973f8b39e0cfa9e277400f4b36332d77c5b4d0f"], "tags": []}, {"author": "Michal Novotny \u003cmichal.novotny\u003e", "branch": "default", "desc": "Bug 1477684 - rcwn blocking some xmlHttpRequests. r=valentin, a=RyanVM\n\nRemove conditional and byte range headers when network won the race for case we send the request again due to 401 response.", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": null, "git_parents": [null], "node": "b6973124edaef8703e5b5b41299fa084858cbc9e", "parents": ["b68604c980e3413d57cd544ec1751668f1f02843"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 1483134 - Add an overflow: hidden to the inspector-responsive-container. r=rcaliman, a=RyanVM", "files": ["devtools/client/themes/inspector.css"], "git_node": null, "git_parents": [null], "node": "c1c4fbe5d3b2b7ed5a8ab9d128c635b2ec07d0ea", "parents": ["b6973124edaef8703e5b5b41299fa084858cbc9e"], "tags": []}, {"author": "Richard Marti \u003crichard.marti@gmail.com\u003e", "branch": "default", "desc": "Bug 1481544 - Style the treecol with CSS on Windows Classic and HC themes. r=dao, a=RyanVM", "files": ["toolkit/themes/windows/global/listbox.css", "toolkit/themes/windows/global/tree.css"], "git_node": null, "git_parents": [null], "node": "5c3ef4992a6367778c6960c6f55597b9ad2e8e05", "parents": ["c1c4fbe5d3b2b7ed5a8ab9d128c635b2ec07d0ea"], "tags": []}], "date": 1534888942, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "148": {"changesets": [{"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1480521 - Backport fixes from Bug 1479900. r=sfink, a=RyanVM\n\nMozReview-Commit-ID: 3bP92eIdNIw", "files": ["js/src/jsfriendapi.h", "js/src/vm/Shape.h"], "git_node": null, "git_parents": [null], "node": "bf26310ec595095b8fcba50099456f29d5a2a76c", "parents": ["5c3ef4992a6367778c6960c6f55597b9ad2e8e05"], "tags": []}, {"author": "Alphan Chen \u003calchen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469348 - Fix the problem of download file failed on Mac. r=paolo, a=RyanVM\n\nIn this bug, we will focus on the problem of cannot download PDF file from google drawing successfully on MAC.\n\nAfter investigating, I found that \"SetTarget()\" is called twice with two different addresses.\nHowever, they both point to the same file.\nWe will assign the first target to \"mInitialTarget\" and the second one to \"mRenamedTarget\".\n\nThis problem happened when doing the second \"SetTarget()\".\nAfter canceling the existing AsyncCopy, we will schedule a new AsyncCopy.\nHowever, we only assign the mActualTarget with mRenamedTarget when they point to different files.\nIn this case, the two different addresses point to the same file.\nSo the mActualTarget is still the same as mInitialTarget.\n\nAfter completion of the AsyncCopy, we try to do \"CheckCompletion\".\nBut it will always return false due to \"mRenamedTarget exists\" and \"mActualTarget\" is not the same as \"mRenamedTarget\".\n\nThe solution is quite easy.\nWe should always update mActualTarget with renameTarget, even if they point to the same file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3400", "files": ["netwerk/base/BackgroundFileSaver.cpp"], "git_node": null, "git_parents": [null], "node": "b7142243310ccfd62d83082e8981dc659f1163ea", "parents": ["bf26310ec595095b8fcba50099456f29d5a2a76c"], "tags": []}], "date": 1534948253, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "149": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4082", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "eed0f569aae461b683a71f9706d60d5948e2fe90", "parents": ["b7142243310ccfd62d83082e8981dc659f1163ea"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1447449 - [marionette] Prevent hang in pause action. r=ato, a=test-only\n\nUnder some unknown circumstances an instance of nsITimer doesn't\ncall resolve(), and as such the pause action hangs forever.\n\nInjecting a custom handler which itself calls resolve, prevents\nthis hang.\n\nThis is a workaround for older branches while bug 1484161 fixed\nit for Firefox 63.", "files": ["testing/marionette/action.js"], "git_node": null, "git_parents": [null], "node": "f9513471a145d7b1f046231c2af28b3bed8c0342", "parents": ["eed0f569aae461b683a71f9706d60d5948e2fe90"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1447449 - [wdspec] Re-enable mouse_pause_dblclick.py. r=ato, a=test-only", "files": ["testing/web-platform/meta/webdriver/tests/actions/mouse_pause_dblclick.py.ini"], "git_node": null, "git_parents": [null], "node": "517bd56b666207289ef035d5ab564ea0f207cf2b", "parents": ["f9513471a145d7b1f046231c2af28b3bed8c0342"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1478848 - [fxui] Fix test_ssl_disabled_error_page to correctly wait for page load. r=ato, a=test-only\n\nCurrently the test doesn't wait for the restore button to become stale,\nand as such the call to find_element will return immediately with a\nreference to a \"h1\" element on the error page.", "files": ["testing/firefox-ui/tests/functional/security/test_ssl_disabled_error_page.py"], "git_node": null, "git_parents": [null], "node": "4cb88c2bc63a4b61a58ad1cb0795bf59bca8fe54", "parents": ["517bd56b666207289ef035d5ab564ea0f207cf2b"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1478849. r=mccr8, a=RyanVM", "files": ["ipc/glue/ProtocolUtils.cpp"], "git_node": null, "git_parents": [null], "node": "07aedc90a6c16dca9f0727cb787c2af85aeb3a84", "parents": ["4cb88c2bc63a4b61a58ad1cb0795bf59bca8fe54"], "tags": []}, {"author": "Mantaroh Yoshinaga \u003cmantaroh@gmail.com\u003e", "branch": "default", "desc": "Bug 1479071 - Revert kPMDataFormatXMLCompressed to kPMDataFormatXMLNormal. r=mstange, a=RyanVM\n\nBug 1411879 introduced kPMDataFormatXMLCompress. However, this parameter caused\nthe saving print settings problem.\nBefore investigating this reason, this patch will revert this parameter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3943", "files": ["widget/cocoa/nsPrintSettingsX.mm"], "git_node": null, "git_parents": [null], "node": "97ccdfcb42197c37ba788b28b5333495e3d6213a", "parents": ["07aedc90a6c16dca9f0727cb787c2af85aeb3a84"], "tags": []}], "date": 1535036747, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "150": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 07aedc90a6c1 (bug 1478849) for bustage.", "files": ["ipc/glue/ProtocolUtils.cpp"], "git_node": null, "git_parents": [null], "node": "d3e100fe45ae459b9e44f5be686bfcebf2b6c392", "parents": ["97ccdfcb42197c37ba788b28b5333495e3d6213a"], "tags": []}], "date": 1535037880, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "151": {"changesets": [{"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1478575 - Unify CamerasChild shutdown paths. r=gcp, a=RyanVM", "files": ["ipc/glue/BackgroundChildImpl.cpp"], "git_node": null, "git_parents": [null], "node": "12213cfa93d9202807fe4074dd471d5704dc885d", "parents": ["d3e100fe45ae459b9e44f5be686bfcebf2b6c392"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1483120 - Sum SkDashPath intervals instead of subtracting. r=rhunt, a=RyanVM", "files": ["gfx/skia/skia/src/utils/SkDashPath.cpp"], "git_node": null, "git_parents": [null], "node": "df3fb67f0972d0582cfad2fe750432dddbb5e356", "parents": ["12213cfa93d9202807fe4074dd471d5704dc885d"], "tags": []}, {"author": "Tim Nguyen \u003cntim.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1443561 - Part 0: Workaround bug 1482157, set -moz-appearance:toolbox on #navigator-toolbox::after. r=dao, a=RyanVM\n\nMozReview-Commit-ID: CuJIYn9ioPO", "files": ["browser/themes/osx/browser.css", "toolkit/components/extensions/test/browser/browser_ext_themes_separators.js"], "git_node": null, "git_parents": [null], "node": "2d5cc6eecb7c9b3a1e41ab16136def8f695e6c05", "parents": ["df3fb67f0972d0582cfad2fe750432dddbb5e356"], "tags": []}, {"author": "Vivek Dhingra \u003cvivek3zero@gmail.com\u003e", "branch": "default", "desc": "Bug 1443561 - Part 1: Make additional backgrounds alignment relative to toolbox. r=jaws, a=RyanVM\n\nMozReview-Commit-ID: 5gjrzZiLx0Q", "files": ["browser/base/content/browser.css", "toolkit/components/extensions/ext-theme.js", "toolkit/components/extensions/test/browser/browser.ini", "toolkit/components/extensions/test/browser/browser_ext_themes_additional_backgrounds_alignment.js", "toolkit/components/extensions/test/browser/browser_ext_themes_multiple_backgrounds.js"], "git_node": null, "git_parents": [null], "node": "4c33709c2271ec5ad667b74213d06e34c963c443", "parents": ["2d5cc6eecb7c9b3a1e41ab16136def8f695e6c05"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1461706 - Sync disabled state of number control regardless of appearance. r=jwatt, a=RyanVM\n\nI noticed this bug while fixing bug 1478069, but it goes back way earlier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3867", "files": ["layout/forms/nsNumberControlFrame.cpp", "testing/web-platform/meta/MANIFEST.json", "testing/web-platform/tests/html/input/the-disabled-attribute/number-disabled.html"], "git_node": null, "git_parents": [null], "node": "2d1beffe431d08cdda1b5245a4a71098cf941ace", "parents": ["4c33709c2271ec5ad667b74213d06e34c963c443"], "tags": []}, {"author": "ISHIKAWA, Chiaki \u003cishikawa@yk.rim.or.jp\u003e", "branch": "default", "desc": "Bug 1480374 - memset partially zeroed out due to incorrect size. r=drno, a=RyanVM", "files": ["media/libvpx/libvpx/vp8/decoder/onyxd_if.c"], "git_node": null, "git_parents": [null], "node": "b63eb86ff55a9aaff322cbc0839b400eeaa0a3d8", "parents": ["2d1beffe431d08cdda1b5245a4a71098cf941ace"], "tags": []}], "date": 1535046750, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "152": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "8f796700d9ebb5b64e5a1ee9ded54069f1d9629f", "parents": ["b63eb86ff55a9aaff322cbc0839b400eeaa0a3d8"], "tags": []}], "date": 1535135564, "git_changesets": [null], "user": "ffxbld-merge"}, "153": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4322", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "fd3fc9c15afa02b6b6682e948baae7bbb96c7497", "parents": ["8f796700d9ebb5b64e5a1ee9ded54069f1d9629f"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1476570 - Allow proxy to work on restricted domains. r=aswan, a=RyanVM\n\nProxies must work with all requests, however the new onRequest proxy api\nhas maching logic using ChannelWrapper which uses WebExtensionPolicy which\nchecks against restricted domains.  We need to bypass that check when\nmatching for proxy requests.\n\nMozReview-Commit-ID: 5zCdmV1b9M7", "files": ["toolkit/components/extensions/WebExtensionPolicy.h", "toolkit/components/extensions/test/xpcshell/test_proxy_listener.js", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp"], "git_node": null, "git_parents": [null], "node": "594d22a711b0a466d994a05e2dc4eaf04f8111f9", "parents": ["fd3fc9c15afa02b6b6682e948baae7bbb96c7497"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1480354 - Better approach for nested blobs construction. r=smaug, a=RyanVM", "files": ["dom/file/BlobSet.cpp", "dom/file/tests/crashtests/1480354.html", "dom/file/tests/crashtests/crashtests.list", "testing/crashtest/crashtests.list"], "git_node": null, "git_parents": [null], "node": "8b34737e4fdf9cf9ed21a71f4bcc4ed9f83348f3", "parents": ["594d22a711b0a466d994a05e2dc4eaf04f8111f9"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1485087 - Remove the option to use the TLS session cache from nsITLSServerSocket. r=jryans, r=mayhemer, a=RyanVM\n\nAs initially implemented, nsITLSServerSocket by default enabled the use of the\nTLS session cache provided by NSS. However, no consumers of nsITLSServerSocket\nactually used it. Because it was an option, though, PSM had to jump through some\nhoops to a) make it work in the first place and b) not have NSS panic on\nshutdown. Furthermore, it meant increased memory usage for every user of Firefox\n(and again, nothing actually used the feature, so this was for naught).\n\nIn bug 1479918, we discovered that if PSM shut down before Necko, NSS could\nattempt to acquire a lock on the session cache that had been deleted, causing a\nshutdown hang. We probably should make it less easy to make this mistake in NSS,\nbut in the meantime bug 1479918 needs uplifting and this workaround is the\nsafest, most straight-forward way to achieve this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3919", "files": ["browser/base/content/test/urlbar/browser_urlbar_search_no_speculative_connect_with_client_cert.js", "devtools/shared/security/socket.js", "dom/presentation/provider/PresentationControlService.js", "netwerk/base/TLSServerSocket.cpp", "netwerk/base/nsITLSServerSocket.idl", "netwerk/test/unit/test_be_conservative.js", "netwerk/test/unit/test_be_conservative_error_handling.js", "netwerk/test/unit/test_tls_flags.js", "netwerk/test/unit/test_tls_server.js", "netwerk/test/unit/test_tls_server_multiple_clients.js", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/tests/unit/test_logoutAndTeardown.js", "xpcom/build/XPCOMInit.cpp"], "git_node": null, "git_parents": [null], "node": "247e07710c04316b11e381436a0889c8a7e48956", "parents": ["8b34737e4fdf9cf9ed21a71f4bcc4ed9f83348f3"], "tags": []}, {"author": "Tim Nguyen \u003cntim.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1486018 - Make additional_backgrounds_alignment default to right top. r=dao, a=RyanVM", "files": ["browser/base/content/browser.css", "toolkit/components/extensions/test/browser/browser_ext_themes_additional_backgrounds_alignment.js", "toolkit/components/extensions/test/browser/browser_ext_themes_multiple_backgrounds.js"], "git_node": null, "git_parents": [null], "node": "a8e3e64319427067daccdc99a04f02bbcbaa0728", "parents": ["247e07710c04316b11e381436a0889c8a7e48956"], "tags": []}], "date": 1535389798, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "154": {"changesets": [{"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1423261 - Skip intentionally crashing the browser during KillHard shutdowns. r=jimm, a=RyanVM", "files": ["dom/ipc/ContentParent.cpp", "ipc/glue/MessageChannel.cpp", "ipc/glue/MessageChannel.h"], "git_node": null, "git_parents": [null], "node": "65bfaed5281891fa8b77737955a5a49b4c3543b8", "parents": ["a8e3e64319427067daccdc99a04f02bbcbaa0728"], "tags": []}], "date": 1535476861, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "155": {"changesets": [{"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1479918 - Fix HSTS update script to only access XHR headers after each request has completed. r=sfraser, a=NPOTB\n\nWhen the HSTS preload script was reworked to use async/await in bug 1436369,\n`fetchstatus` would create an asynchronous xml http request and then attempt to\naccess a response header from it. However, there was nothing to ensure that the\nrequest had completed before this code ran. This patch ensures that the request\nhas completed before the response header is used.\n\nThis patch also replaces a lingering instance of `Ci.nsISSLStatusProvider` that\nshould have been changed to `Ci.nsITransportSecurityInfo` in bug 1475647.\n\nFinally, this patch removes the old, redundant getHSTSPreloadList.js in\nsecurity/manager/tools as well as the unused nsSTSPreloadList.errors file in\nsecurity/manager/ssl.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2807", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/tools/getHSTSPreloadList.js", "taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": null, "git_parents": [null], "node": "6554500ae47776c1a0f4b60d220a255aa405d830", "parents": ["65bfaed5281891fa8b77737955a5a49b4c3543b8"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1479918 - Batch requests in getHSTSPreloadList.js to avoid livelock. r=sfraser, a=NPOTB\n\nPrior to this patch, getHSTSPreloadList.js would queue an XHR for every preload\nlist candidate site. This meant that there would be ~50,000 requests in flight\nsimultaneously. Simply processing these requests caused them to all time out,\nand no useful work was done. This patch resolves them in batches of 250 to\navoid this issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3622", "files": ["taskcluster/ci/repo-update/kind.yml", "taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": null, "git_parents": [null], "node": "825800d57043c7ea9b1543d30fbf16c37b4a3518", "parents": ["6554500ae47776c1a0f4b60d220a255aa405d830"], "tags": []}], "date": 1535633884, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "156": {"changesets": [{"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1481907 - Part 1: Block updater code from using paths containing invalid symlinks. r=rstrong, a=RyanVM", "files": ["toolkit/mozapps/update/common/updatecommon.cpp"], "git_node": null, "git_parents": [null], "node": "a2b17d8a58fa9834499426137aaac230d2cce121", "parents": ["825800d57043c7ea9b1543d30fbf16c37b4a3518"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1481907 - Part 2: Remove uses of GetTempFileName from updater code. r=rstrong, a=RyanVM", "files": ["toolkit/mozapps/update/common/moz.build", "toolkit/mozapps/update/common/updatecommon.cpp", "toolkit/mozapps/update/common/updatehelper.cpp", "toolkit/mozapps/update/common/updatehelper.h", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "7af1843bbfb5d64537bb60f7066b13761e0eef46", "parents": ["a2b17d8a58fa9834499426137aaac230d2cce121"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1481907 - Followup: Fix a memory allocation oversight. r=me, a=RyanVM", "files": ["toolkit/mozapps/update/common/updatecommon.cpp"], "git_node": null, "git_parents": [null], "node": "b7a7d47e309ce247dc3ad53171a95e07d9e35417", "parents": ["7af1843bbfb5d64537bb60f7066b13761e0eef46"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4679", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "921a910927efe52404531a5967a0bf84c19ec119", "parents": ["b7a7d47e309ce247dc3ad53171a95e07d9e35417"], "tags": []}], "date": 1535642169, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "157": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487126 - Change uses of 3-argument wcstok to wcstok_s. r=mhowell, a=RyanVM\n\nthe Mingw Clang build failed because a 3-argument form of wcstok could not\nbe found, despite it apparently being part of the C++ standard. Multiple\nforms of header files were tried.\n\nBy comparison, wcstok_s is already used (e.g. widget/windows/WinUtils.cpp)\nand does the correct thing. So change the functions over to that one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4568", "files": ["toolkit/mozapps/update/common/updatecommon.cpp"], "git_node": null, "git_parents": [null], "node": "0eb16d811e0245099494dc9ee19ad7ff39f0ea8d", "parents": ["921a910927efe52404531a5967a0bf84c19ec119"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487133 - Move rpcrt4 out from behind the Maintenance Service if, as mingw disables that. r=mhowell, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4581", "files": ["toolkit/mozapps/update/common/moz.build"], "git_node": null, "git_parents": [null], "node": "5c8233afa2d6a282dadc631c86113c3b4b38a226", "parents": ["0eb16d811e0245099494dc9ee19ad7ff39f0ea8d"], "tags": []}], "date": 1535644075, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "158": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1479918 - Revert QueryInterface change in preload list script for esr60. r=me, a=NPOTB\n\nBug 1475647 removed nsISSLStatusProvider in 63 (making nsITransportSecurityInfo\nthe right interface to use). However, in uplifting changes in bug 1479918 to\nESR60, we need to keep using nsISSLStatusProvider.", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": null, "git_parents": [null], "node": "ad7285c0f876ee09a80d224dc374cef1ccbe51fe", "parents": ["5c8233afa2d6a282dadc631c86113c3b4b38a226"], "tags": []}], "date": 1535649350, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "159": {"changesets": [{"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460777 - Taskgraph tasks for retrieving remote content; r=dustin, glandium\n\nCurrently, many tasks fetch content from the Internets. A problem with\nthat is fetching from the Internets is unreliable: servers may have\noutages or be slow; content may disappear or change out from under us.\n\nThe unreliability of 3rd party services poses a risk to Firefox CI.\nIf services aren't available, we could potentially not run some CI tasks.\nIn the worst case, we might not be able to release Firefox. That would\nbe bad. In fact, as I write this, gmplib.org has been unavailable for\n~24 hours and Firefox CI is unable to retrieve the GMP source code.\nAs a result, building GCC toolchains is failing.\n\nA solution to this is to make tasks more hermetic by depending on\nfewer network services (which by definition aren't reliable over time\nand therefore introduce instability).\n\nThis commit attempts to mitigate some external service dependencies\nby introducing the *fetch* task kind.\n\nThe primary goal of the *fetch* kind is to obtain remote content and\nre-expose it as a task artifact. By making external content available\nas a cached task artifact, we allow dependent tasks to consume this\ncontent without touching the service originally providing that\ncontent, thus eliminating a run-time dependency and making tasks more\nhermetic and reproducible over time.\n\nWe introduce a single \"fetch-url\" \"using\" flavor to define tasks that\nfetch single URLs and then re-expose that URL as an artifact. Powering\nthis is a new, minimal \"fetch\" Docker image that contains a\n\"fetch-content\" Python script that does the work for us.\n\nWe have added tasks to fetch source archives used to build the GCC\ntoolchains.\n\nFetching remote content and re-exposing it as an artifact is not\nvery useful by itself: the value is in having tasks use those\nartifacts.\n\nWe introduce a taskgraph transform that allows tasks to define an\narray of \"fetches.\" Each entry corresponds to the name of a \"fetch\"\ntask kind. When present, the corresponding \"fetch\" task is added as a\ndependency. And the task ID and artifact path from that \"fetch\" task\nis added to the MOZ_FETCHES environment variable of the task depending\non it. Our \"fetch-content\" script has a \"task-artifacts\"\nsub-command that tasks can execute to perform retrieval of all\nartifacts listed in MOZ_FETCHES.\n\nTo prove all of this works, the code for fetching dependencies when\nbuilding GCC toolchains has been updated to use `fetch-content`. The\nnow-unused legacy code has been deleted.\n\nThis commit improves the reliability and efficiency of GCC toolchain\ntasks. Dependencies now all come from task artifacts and should always\nbe available in the common case. In addition, `fetch-content` downloads\nand extracts files concurrently. This makes it faster than the serial\napplication which we were previously using.\n\nThere are some things I don't like about this commit.\n\nFirst, a new Docker image and Python script for downloading URLs feels\na bit heavyweight. The Docker image is definitely overkill as things\nstand. I can eventually justify it because I want to implement support\nfor fetching and repackaging VCS repositories and for caching Debian\npackages. These will require more packages than what I'm comfortable\ninstalling on the base Debian image, therefore justifying a dedicated\nimage.\n\nThe `fetch-content static-url` sub-command could definitely be\nimplemented as a shell script. But Python is readily available and\nis more pleasant to maintain than shell, so I wrote it in Python.\n\n`fetch-content task-artifacts` is more advanced and writing it in\nPython is more justified, IMO. FWIW, the script is Python 3 only,\nwhich conveniently gives us access to `concurrent.futures`, which\nfacilitates concurrent download.\n\n`fetch-content` also duplicates functionality found elsewhere.\ngeneric-worker's task payload supports a \"mounts\" feature which\nfacilitates downloading remote content, including from a task\nartifact. However, this feature doesn't exist on docker-worker.\nSo we have to implement downloading inside the task rather than\nat the worker level. I concede that if all workers had generic-worker's\n\"mounts\" feature and supported concurrent download, `fetch-content`\nwouldn't need to exist.\n\n`fetch-content` also duplicates functionality of\n`mach artifact toolchain`. I probably could have used\n`mach artifact toolchain` instead of writing\n`fetch-content task-artifacts`. However, I didn't want to introduce\nthe requirement of a VCS checkout. `mach artifact toolchain` has its\norigins in providing a feature to the build system. And \"fetching\nartifacts from tasks\" is a more generic feature than that. I think\nit should be implemented as a generic feature and not something that is\n\"toolchain\" specific.\n\nI think the best place for a generic \"fetch content\" feature is in\nthe worker, where content can be defined in the task payload. But as\nexplained above, that feature isn't universally available. The next\nbest place is probably run-task. run-task already performs generic,\nvery-early task preparation steps, such as performing a VCS checkout.\nI would like to fold `fetch-content` into run-task and make it all\ndriven by environment variables. But run-task is currently Python 2\nand achieving concurrency would involve a bit of programming (or\nadding package dependencies). I may very well port run-task to Python\n3 and then fold fetch-content into it. Or maybe we leave\n`fetch-content` as a standalone script.\n\nMozReview-Commit-ID: AGuTcwNcNJR", "files": ["build/unix/build-gcc/build-gcc.sh", "taskcluster/ci/docker-image/kind.yml", "taskcluster/ci/fetch/kind.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/toolchain/kind.yml", "taskcluster/ci/toolchain/linux.yml", "taskcluster/docker/fetch/Dockerfile", "taskcluster/docs/attributes.rst", "taskcluster/docs/kinds.rst", "taskcluster/docs/transforms.rst", "taskcluster/scripts/misc/build-gcc-4.9-linux.sh", "taskcluster/scripts/misc/build-gcc-6-linux.sh", "taskcluster/scripts/misc/build-gcc-mingw32.sh", "taskcluster/scripts/misc/build-gcc-sixgill-plugin-linux.sh", "taskcluster/scripts/misc/fetch-content", "taskcluster/taskgraph/transforms/job/fetch.py", "taskcluster/taskgraph/transforms/use_fetches.py"], "git_node": null, "git_parents": [null], "node": "ff7b658f52501134bab7095ad1a9d5aad7e2f9ad", "parents": ["ad7285c0f876ee09a80d224dc374cef1ccbe51fe"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1400484 MinGW gcc is broken - root_dir is required with the new fetch code r=gps\n\nMozReview-Commit-ID: LC0ZgWDyDDT", "files": ["taskcluster/scripts/misc/build-gcc-mingw32.sh"], "git_node": null, "git_parents": [null], "node": "3806e6227b9e8620be090f69f5720107b94525ba", "parents": ["ff7b658f52501134bab7095ad1a9d5aad7e2f9ad"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1461980 - [taskgraph] Use run-task's 'use-artifacts' key to setup artifacts in mochitest and reftest selftests, r=dustin\n\nInstead of downloading the build artifacts (rather hackily) in moztest.fixtures, this now happens\ndirectly in the taskgraph module via the run-task script.\n\nFor now extraction and setup happens in the task's command key. It might be a good idea to figure\nout a syntax to tell run-task to do this extraction, e.g something like:\n\nrun:\n    using-artifacts:\n        build:\n            target.tar.bz2:\n                extract: true\n                path: /home/worker/build\n                name: firefox\n\nBut for now I wanted to avoid this extra complexity, so maybe it could be done in a follow-up.\n\nMozReview-Commit-ID: KOhFFpFdP7Y", "files": ["layout/tools/reftest/selftest/conftest.py", "taskcluster/ci/source-test/kind.yml", "taskcluster/ci/source-test/python.yml", "taskcluster/taskgraph/transforms/source_test.py", "testing/mozbase/moztest/moztest/selftest/fixtures.py"], "git_node": null, "git_parents": [null], "node": "368bc778429309b88f1050deffdac5b3e8ba6177", "parents": ["3806e6227b9e8620be090f69f5720107b94525ba"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466660 - Remove use-artifact directory from run-task workers after task has finished r=jmaher\n\nRight now artifacts from previous tasks are left lying around. We should clean these up\nin case a task accidentally uses an artifact from the wrong dependency.\n\nIdeally we'd cache these properly based on the taskId they came from, but that can be\nfollow-up fodder.\n\nMozReview-Commit-ID: HUgvNlqyFav", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "7d0856d5fe6e17f5cc7d2cbc3113ccc89119a74c", "parents": ["368bc778429309b88f1050deffdac5b3e8ba6177"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1445944 - [moztest] Update shared test fixtures so they can work outside of mozilla-central r=rwood\n\nThis isn't strictly related to this bug, but it is a change made to mozbase in\nthe raptor repo that is worth backporting here. Figured it's easiest to land it\nalongside the other mozbase backports.\n\nMozReview-Commit-ID: DW7I2zKZZNk", "files": ["testing/mozbase/moztest/moztest/selftest/fixtures.py"], "git_node": null, "git_parents": [null], "node": "f89f7acb439f4c518427178609a7206029ea6c05", "parents": ["7d0856d5fe6e17f5cc7d2cbc3113ccc89119a74c"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468812 - [taskgraph] Move 'use_fetches' transform to the job section r=gps\n\nThe 'use_fetches' transform is currently only being used by toolchain tasks,\nbut we'd like to expand this to more kinds (like 'test' and 'source_test').\n\nThe problem is that 'use_fetches' doesn't have a schema, and assumes things\nabout the kinds of keys that will be set in the job. For example, it assumes\nthat job['worker']['env'] is going to be forwarded up to the jobdesc properly.\n\nBy moving this transform into the set applied to all 'job' tasks, we:\n\nA) Have a task schema we can reliably depend on\nB) Can automatically use it from any 'job' task without kind specific\nmodifications\n\nSince the toolchain tasks apply the 'job' transforms (almost) right after\nthe 'use_fetches' transform, this change just works.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2028", "files": ["taskcluster/ci/toolchain/kind.yml", "taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/use_fetches.py"], "git_node": null, "git_parents": [null], "node": "a1694865935af4af4faa9768f03a73eed8a30430", "parents": ["f89f7acb439f4c518427178609a7206029ea6c05"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468812 - [taskgraph] Support artifacts from any dependency via fetches r=gps\n\nFetches no longer need to be artifacts exposed via a 'fetch' task, they can\nalso be artifacts from a task's dependencies. The new format is:\n\nfetches:\n    fetch:\n        - fetch-artifact-1.zip\n        - fetch-artifact-2.zip\n    build:\n        - build-artifact-1.zip\n        ...\n\nSpecifying 'build' artifacts to fetch will error out if the task doesn't have\nany build dependencies.\n\nThe 'fetch' key works the same as before, but it is now a special case. Unlike\n'build' (or other dependencies), adding a fetch task's artifact here will\nimplicitly make our task depend on the corresponding fetch task. It will not\nbe an error.\n\nDepends on D2028.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2102", "files": ["taskcluster/ci/toolchain/linux.yml", "taskcluster/taskgraph/transforms/job/__init__.py"], "git_node": null, "git_parents": [null], "node": "b87ec7457a979221c9ec0e1fb299f7add94da975", "parents": ["a1694865935af4af4faa9768f03a73eed8a30430"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468812 - [fetch-content] Implement ability to specify a per-fetch subdirectory to extract into r=gps\n\nCurrently 'fetch' artifacts are all extracted in the same directory, this could\nmake the extdir messy, or in the worst case, cause file name collisions.\n\nSome artifacts are ok to extract into the same directory as they're already\nbundled within the archive. But other artifacts are not. This patch keeps the\ndefault behaviour (extracting everything into the same directory), but allows\ntask authors to specify per-artifact directories to extract into.\n\nThe syntax is:\npath[\u003edest]@\u003ctask\u003e\n\nThe 'dest' value will be a subdirectory of the MOZ_FETCHES_DIR environment\nvariable.\n\nDepends on D2102.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2166", "files": ["taskcluster/scripts/misc/fetch-content", "taskcluster/taskgraph/transforms/job/__init__.py"], "git_node": null, "git_parents": [null], "node": "8c1e7fd7cfa9f4087aa5bea8c1fc1bec1a680d77", "parents": ["b87ec7457a979221c9ec0e1fb299f7add94da975"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468812 - [ci] Support MOZ_FETCHES and fetch-content in run-task r=gps\n\nThis removes the 'use-artifacts' mechanism in favour of fetches. There are a\nfew pieces here that need to land atomically:\n\n1. Remove use-artifact related code\n2. Call 'fetch-content' from the run-task script\n3. Convert existing tasks on top of fetches (jsshell, python unittest)\n4. Stop calling 'fetch-content' from toolchain setup tasks (as this now gets handled in run-task)\n\nDepends on D2166.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2167", "files": ["layout/tools/reftest/selftest/conftest.py", "taskcluster/ci/source-test/python.yml", "taskcluster/docker/desktop1604-test/Dockerfile", "taskcluster/scripts/misc/build-gcc-4.9-linux.sh", "taskcluster/scripts/misc/build-gcc-6-linux.sh", "taskcluster/scripts/misc/build-gcc-mingw32.sh", "taskcluster/scripts/misc/build-gcc-sixgill-plugin-linux.sh", "taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/job/common.py", "taskcluster/taskgraph/transforms/job/mozharness.py", "taskcluster/taskgraph/transforms/job/run_task.py", "taskcluster/taskgraph/transforms/job/toolchain.py"], "git_node": null, "git_parents": [null], "node": "7e9c660985dd8ecca43dc11da39e5ded0e588901", "parents": ["8c1e7fd7cfa9f4087aa5bea8c1fc1bec1a680d77"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1479533 - Refactor archive decompression; r=tomprince\n\nPreviously, we told `tar` or `unzip` to operate on an explicit file.\nThis worked when `tar` understood the compression format of the file.\nAnd this worked in the majority of cases.\n\nBut `tar` does not support zstandard compression (at least not outside\nextremely new versions, which aren't yet widely deployed). And not all\nversions of `tar` support the `-a` argument.\n\nThis commit changes our invocation of `tar` so input data is piped\nto it from Python. In the case of `tar`, we perform decompression in\nPython, if possible. This allows us to support zstandard and `tar`\nbinaries that don't support `-a` to auto-detect the compression format.\n\nI wanted to be consistent and always pipe the raw data via stdin.\nBut `unzip` doesn't appear to like this. Oh well.\n\nWe also refactor the logic around detecting archives. We have a\nfunction to identify the archive type based on a filename. We then\npass the archive type to the extraction function and key off that\nlogic within. We also conditionally call extract_archive() and\nfail hard in extract_archive() when things fail. This will make\nfuture archive code easier to reason about.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1576", "files": ["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "81a70b1d7f7d36424779525b7a9ce0c0590ca49d", "parents": ["7e9c660985dd8ecca43dc11da39e5ded0e588901"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1479533 - Log to stderr, capitalize messages; r=tomprince\n\nThis is what a lot of programs do.\n\nWe do logging in a helper function so we can flush after every write.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2526", "files": ["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "9caa6e54ee694dafb025d38bed475b2d897576a5", "parents": ["81a70b1d7f7d36424779525b7a9ce0c0590ca49d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1480431 - Make ifh a file object; r=tomprince\n\nOtherwise it can't be used as a context manager since it\ndoesn't have __enter__ or __exit__.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2672", "files": ["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "5ab93028ab38937a0a74a5a884e16d35bb75ed58", "parents": ["9caa6e54ee694dafb025d38bed475b2d897576a5"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1484790 - [fetches] Overwrite without prompting when unzipping an artifact with fetch-content, r=gps\n\nThis also moves the call to 'fetch_artifacts' in run-task down inside the\ntry/finally block. This way if something goes wrong, we'll still cleanup\nMOZ_FETCHES_DIR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4152", "files": ["taskcluster/scripts/misc/fetch-content", "taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "b89eed9e2a943915bdf4974cbd10ce6010a9028d", "parents": ["5ab93028ab38937a0a74a5a884e16d35bb75ed58"], "tags": []}, {"author": "Andi-Bogdan Postelnicu \u003cbpostelnicu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1461777: Add `skip-artifacts` option to generic-worker. r=gps\n\nMozReview-Commit-ID: 7o7iPneK34e", "files": ["taskcluster/taskgraph/transforms/job/mozharness.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "2dd23930d3e58b8bf1eb866a7f21b8c4671e3d3a", "parents": ["b89eed9e2a943915bdf4974cbd10ce6010a9028d"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1484012: [fetch-content] Pass `MOZ_FETCHES` as json; r=gps,ahal\n\nRather than trying to parse strings, just pass a json blob. This will allow us\nto easily do things like mark artifacts to be left unextracted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3553", "files": ["taskcluster/ci/source-test/python.yml", "taskcluster/scripts/misc/fetch-content", "taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/job/__init__.py"], "git_node": null, "git_parents": [null], "node": "ea95b756dba8aae82311a99429c8a26394b2c08f", "parents": ["2dd23930d3e58b8bf1eb866a7f21b8c4671e3d3a"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1484012: [fetch-content] Add an option to not unpack downloaded artifacts; r=gps\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3554", "files": ["taskcluster/scripts/misc/fetch-content", "taskcluster/taskgraph/transforms/job/__init__.py"], "git_node": null, "git_parents": [null], "node": "3901c3782254488cda52924577dd4c60d1386e90", "parents": ["ea95b756dba8aae82311a99429c8a26394b2c08f"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1484012: [fetch-content] Transparently decompress artifacts; r=gps\n\ngeneric-worker transparently compresses uncompressed artifacts. Teach\nfetch-content to decompress those artifacts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3555", "files": ["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "8fc45397024adaf375c1716abd32a6c60554aa36", "parents": ["3901c3782254488cda52924577dd4c60d1386e90"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1484012: [fetch-content] Add support for downloading private artifacts; r=gps\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3556", "files": ["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "51576b57361e13c480e1d2c0dd621bdb9866c6f9", "parents": ["8fc45397024adaf375c1716abd32a6c60554aa36"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1484012: [taskgraph] Allow windows mozharness tasks to use `fetch-content`; r=gps\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3557", "files": ["taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/job/mozharness.py"], "git_node": null, "git_parents": [null], "node": "0f5e4e79d21d4710f44a7ea03c496753d9fc217d", "parents": ["51576b57361e13c480e1d2c0dd621bdb9866c6f9"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1484012: [mozharness] Hard-code repackage input/output directories, since they don't vary meaningfully; r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3558", "files": ["taskcluster/taskgraph/transforms/repackage.py", "taskcluster/taskgraph/transforms/repackage_partner.py", "testing/mozharness/configs/repackage/linux32_signed.py", "testing/mozharness/configs/repackage/linux64_signed.py", "testing/mozharness/configs/repackage/osx_partner.py", "testing/mozharness/configs/repackage/osx_signed.py", "testing/mozharness/configs/repackage/win32_partner.py", "testing/mozharness/configs/repackage/win32_signed.py", "testing/mozharness/configs/repackage/win64_partner.py", "testing/mozharness/configs/repackage/win64_signed.py", "testing/mozharness/scripts/repackage.py"], "git_node": null, "git_parents": [null], "node": "c66c6aa4a3a63ca361d911ba05db161df53d20a2", "parents": ["0f5e4e79d21d4710f44a7ea03c496753d9fc217d"], "tags": []}, {"author": "Tom Prince \u