scripts/web_platform_tests.py", "testing/mozharness/unit.sh"], "git_node": null, "git_parents": [null], "node": "3a17890b842711246689ef6935fedd829767dcc2", "parents": ["5af8c37f769f7333ea664f2f1882da15d97623f8"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460650 - Rename sixgill task name so it has \"gcc\" in it; r=nalexander\n\nMainly so searching \"toolchain\" + \"gcc\" yields something useful in the\ntaskgraph.\n\nMozReview-Commit-ID: HWiT3AwwYQ2", "files": ["taskcluster/ci/hazard/kind.yml", "taskcluster/ci/toolchain/linux.yml"], "git_node": null, "git_parents": [null], "node": "2f346200eee8f6576823c84526081c34b2b13be2", "parents": ["3a17890b842711246689ef6935fedd829767dcc2"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460906 Fix use of config.params and release_eta r=aki\n\nMozReview-Commit-ID: 9wtsZw118YX", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "ec1aaa88e3ba9859bf5b364a8b1969c3cfdcae9d", "parents": ["2f346200eee8f6576823c84526081c34b2b13be2"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453993 - Update repo update owners for releaseduty change. r=sfraser", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "51fa75d6a8efc9ce37ae314a3faba1053a280c24", "parents": ["ec1aaa88e3ba9859bf5b364a8b1969c3cfdcae9d"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1459198 - Set a validation method to make sure notification filters are accurately set. r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1135", "files": ["taskcluster/taskgraph/util/verify.py"], "git_node": null, "git_parents": [null], "node": "7abd390667c2e49c8a3601e2749ff69f827a0d43", "parents": ["51fa75d6a8efc9ce37ae314a3faba1053a280c24"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1460243 - don't try to upload symbols for asan-reporter nightlies. r=Callek,tomprince\n\nAddress Sanitizer builds use --disable-crashreporter so they don't have\nsymbols zip files to upload. Don't run symbol upload tasks for these builds.\n\nMozReview-Commit-ID: GeQgRZF3m8t", "files": ["taskcluster/ci/upload-symbols/kind.yml"], "git_node": null, "git_parents": [null], "node": "74630af66d0028b3d16b9774354e664673efd6d5", "parents": ["7abd390667c2e49c8a3601e2749ff69f827a0d43"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460411 - Add kvm to desktop1604-test image; r=jmaher\n\nOur normal ubuntu 16.04 test image is suitable for hosting an Android x86\nemulator with these minor updates: Install kvm and make sure /dev/kvm\nrw permissions are open for everyone. Note that /dev/kvm is generally\nonly visible when running docker with --privileged; its permissions\ncannot be modified in the Dockerfile, only at run-time: run-task is the\nfirst opportunity.", "files": ["taskcluster/docker/recipes/ubuntu1604-test-system-setup.sh", "taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "8a60910533f3176b0c98b771b9a0de8155c70275", "parents": ["74630af66d0028b3d16b9774354e664673efd6d5"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460411 - Follow-up - diffoscope repo moved; updated url; r=me on a CLOSED TREE", "files": ["taskcluster/docker/diffoscope/Dockerfile"], "git_node": null, "git_parents": [null], "node": "554197d34849cdff575df9464991cb91e3dfbcf9", "parents": ["8a60910533f3176b0c98b771b9a0de8155c70275"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Move `push-to-release` step to release-tasks platform; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1137", "files": ["taskcluster/ci/beetmover-cdns/kind.yml"], "git_node": null, "git_parents": [null], "node": "b0d0fce48056fbcd799ccbfef3309e7d3032d7e7", "parents": ["554197d34849cdff575df9464991cb91e3dfbcf9"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Rename `beetmover-cdns` to `release-beetmover-push-to-release`; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1138", "files": ["taskcluster/ci/beetmover-cdns/kind.yml", "taskcluster/ci/release-beetmover-push-to-release/kind.yml", "taskcluster/ci/release-bouncer-check/kind.yml", "taskcluster/ci/release-notify-push/kind.yml", "taskcluster/ci/release-version-bump/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/beetmover_cdns.py", "taskcluster/taskgraph/transforms/beetmover_push_to_release.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "6633a0986a53bdfdb3f4286c6e2c5d6d4c7b5a98", "parents": ["b0d0fce48056fbcd799ccbfef3309e7d3032d7e7"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1421062: [release] Use configured scriptworker scope prefix for checksum signing; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1291", "files": ["taskcluster/taskgraph/transforms/checksums_signing.py", "taskcluster/taskgraph/transforms/release_generate_checksums_signing.py", "taskcluster/taskgraph/transforms/source_checksums_signing.py"], "git_node": null, "git_parents": [null], "node": "1440c0b9bc70f464296e866b57f220b5ca823e85", "parents": ["6633a0986a53bdfdb3f4286c6e2c5d6d4c7b5a98"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1461784: [release-promotion] Always respect previous graphs, even on try; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1290", "files": ["taskcluster/taskgraph/actions/release_promotion.py"], "git_node": null, "git_parents": [null], "node": "f98df5ba720bd04403ad90eb2db9c898b4f5697d", "parents": ["1440c0b9bc70f464296e866b57f220b5ca823e85"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460475 - Install Python 3 on image_builder; r=dustin\n\nWe want Python 3 available everywhere because it is 2018.\n\nMozReview-Commit-ID: L3wufNXKdnp", "files": ["taskcluster/docker/image_builder/setup.sh"], "git_node": null, "git_parents": [null], "node": "8909a614da16e86ccde52a7d4e202d9677c34b74", "parents": ["f98df5ba720bd04403ad90eb2db9c898b4f5697d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460475 - Upgrade python-zstandard in image_builder; r=dustin\n\nVersion 0.9.0 bundles a newer version of the zstandard library, which\nis a little faster and has a few minor bug fixes (none that we were\nlikely hitting, however).\n\nMozReview-Commit-ID: 9YgSZ0G41eg", "files": ["taskcluster/docker/image_builder/download-and-compress", "taskcluster/docker/image_builder/setup.sh"], "git_node": null, "git_parents": [null], "node": "dbf782051e398cf4747583ce9b8b8b35f05c5d3e", "parents": ["8909a614da16e86ccde52a7d4e202d9677c34b74"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460475 - Install zstandard 0.9.0 in mach; r=dustin\n\nThe latest python-zstandard uses a newer zstandard that is faster.\nIt also has wheels available, which means installation doesn't require\nPython development headers, etc.\n\nMozReview-Commit-ID: 5gRq81KYmX4", "files": ["taskcluster/mach_commands.py", "taskcluster/taskgraph/docker.py"], "git_node": null, "git_parents": [null], "node": "5844142ca95adf1ed8bfb383f85cabb782c06461", "parents": ["dbf782051e398cf4747583ce9b8b8b35f05c5d3e"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460475 - Use stream_reader API; r=dustin\n\npython-zstandard 0.9 has an API that exposes a file object interface\nfor compression and decompression. This means we can remove our\nstream wrapper in order to consume a zstandard compressed tar file.\n\nMozReview-Commit-ID: DeWWKnigJVa", "files": ["taskcluster/taskgraph/docker.py"], "git_node": null, "git_parents": [null], "node": "a9b63fb3fb45e11f91238658775687abac6dd672", "parents": ["5844142ca95adf1ed8bfb383f85cabb782c06461"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460475 - Port download-and-compress to Python 3; r=dustin\n\ndownload-and-compress isn't very complicated and should work on Python 3\nwith minimal effort. So let's switch it to use Python 3.\n\nMozReview-Commit-ID: 9G1WfcbbKEY", "files": ["taskcluster/docker/image_builder/download-and-compress", "taskcluster/docker/image_builder/setup.sh"], "git_node": null, "git_parents": [null], "node": "9b37047f66a20c572bf339c295039a38f7ce1119", "parents": ["a9b63fb3fb45e11f91238658775687abac6dd672"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Removing unused buildbot support r=Callek\n\nMozReview-Commit-ID: EjclZgc864L", "files": ["testing/mozharness/mozharness/mozilla/buildbot.py", "testing/mozharness/mozharness/mozilla/l10n/locales.py", "testing/mozharness/mozharness/mozilla/testing/talos.py", "testing/mozharness/scripts/desktop_l10n.py", "testing/mozharness/scripts/mobile_l10n.py"], "git_node": null, "git_parents": [null], "node": "4f0802d405e9e867771fc993df2d2dcc81623165", "parents": ["9b37047f66a20c572bf339c295039a38f7ce1119"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [taskgraph]: Add a helper for adding a suffix to a possibly grouped treeherder symbol; r=dustin.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1286", "files": ["taskcluster/taskgraph/test/test_util_treeherder.py", "taskcluster/taskgraph/transforms/l10n.py", "taskcluster/taskgraph/transforms/reverse_chunk_deps.py", "taskcluster/taskgraph/transforms/tests.py", "taskcluster/taskgraph/transforms/update_verify.py", "taskcluster/taskgraph/util/treeherder.py"], "git_node": null, "git_parents": [null], "node": "7063bb37a47b8008d6311adce28093feac038755", "parents": ["4f0802d405e9e867771fc993df2d2dcc81623165"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Change update-verify platforms to match the corresponding build platforms; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1287", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/release-secondary-update-verify/kind.yml", "taskcluster/ci/release-update-verify-config/kind.yml", "taskcluster/ci/release-update-verify/kind.yml"], "git_node": null, "git_parents": [null], "node": "d5a0a17e37bd1b1c18a788f081fdc91dc5643951", "parents": ["7063bb37a47b8008d6311adce28093feac038755"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "487c3 Bug 1456234: [release] Use `-release` platforms for bouncer tasks; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1288", "files": ["taskcluster/ci/release-bouncer-check/kind.yml", "taskcluster/docs/kinds.rst"], "git_node": null, "git_parents": [null], "node": "095b10b9661e38e00316d1fbf3b7fb4575c0a362", "parents": ["d5a0a17e37bd1b1c18a788f081fdc91dc5643951"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Use `-release` platforms for top-level balrog tasks; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1289", "files": ["taskcluster/ci/release-balrog-scheduling/kind.yml", "taskcluster/ci/release-balrog-submit-toplevel/kind.yml"], "git_node": null, "git_parents": [null], "node": "b8fb82d55646210a5ce326a18097edc895a7b063", "parents": ["095b10b9661e38e00316d1fbf3b7fb4575c0a362"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1458700: [release-promotion] Move configuration of flavors into the graph configuration; r=aki,dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1121", "files": ["taskcluster/ci/config.yml", "taskcluster/docs/actions.rst", "taskcluster/taskgraph/actions/registry.py", "taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/config.py"], "git_node": null, "git_parents": [null], "node": "6e8de0294b524b5933268f1f4aca70a0aeee5bb0", "parents": ["b8fb82d55646210a5ce326a18097edc895a7b063"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1458700: [release-promotion] Use a common target task for firefox and devedition; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1122", "files": ["taskcluster/ci/config.yml", "taskcluster/docs/parameters.rst", "taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/target_tasks.py", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "4d61cf6253b9a5ff303223969964c9c09c4840fa", "parents": ["6e8de0294b524b5933268f1f4aca70a0aeee5bb0"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1447460: [taskgraph] Use the graph config root to guess find the path to `.taskcluster.yml` in actions; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1126", "files": ["taskcluster/taskgraph/actions/registry.py", "taskcluster/taskgraph/config.py"], "git_node": null, "git_parents": [null], "node": "94bd6c517ca41105c2ab8016f718458bb7993f67", "parents": ["4d61cf6253b9a5ff303223969964c9c09c4840fa"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1461784: [release] Fix release notification on try; r=aki\n\nThe email address used for notification on try was templated,\nbut nothing actually evaluated the template. This applies the same\ntemplating that applies to the message to any emails specified.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1297", "files": ["taskcluster/ci/release-notify-promote/kind.yml", "taskcluster/ci/release-notify-push/kind.yml", "taskcluster/ci/release-notify-ship/kind.yml", "taskcluster/ci/release-secondary-notify-ship/kind.yml", "taskcluster/taskgraph/transforms/release_notifications.py"], "git_node": null, "git_parents": [null], "node": "45d75df67542324732d155ecd79050870d182d58", "parents": ["94bd6c517ca41105c2ab8016f718458bb7993f67"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460470 - Make run-task compile on Python 3; r=mshal\n\nThe file failed to compile due to octal syntax and missing imports.\nAfter this change, we get a run-time error, which is strictly better.\n\nMozReview-Commit-ID: nY9A13Pt3E", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "e9194e7edcadfcb521f663e1fe967d81d64f8346", "parents": ["45d75df67542324732d155ecd79050870d182d58"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460470 - Make run-task somewhat usable on Python 3; r=mshal\n\nThis required a lot of attention to bytes versus strings.\n\nThe hacks around handling process output are somewhat gross. Apparently\nreadline() doesn't work on bytes streams in Python 3?! So we install a\ncustom stream decoder so we can have nice things.\n\nThere are still some failures in run-task on Python 3. But we're a big\nstep closer.\n\nMozReview-Commit-ID: 4FJlTn3q9Ai", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "c87d6d0973e2fe4e535d85d4e16cb9cc90261fdb", "parents": ["e9194e7edcadfcb521f663e1fe967d81d64f8346"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460470 - More run-task Python 3 porting; r=mshal\n\nMostly normalization of str and bytes. Python 3 is annoying for\nsystems level code where most things are bytes.\n\nMozReview-Commit-ID: KpvZGegBkYn", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "c0e40f3db223b454ae1ae4516096b3163a4ba33d", "parents": ["c87d6d0973e2fe4e535d85d4e16cb9cc90261fdb"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460470 - Change run-task to use Python 3 by default; r=mshal\n\nPython 3 is the future.\n\nMozReview-Commit-ID: APuu4Q3mimj", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "f86a907fd2f403f6ccfe0f1b810828e838204f04", "parents": ["c0e40f3db223b454ae1ae4516096b3163a4ba33d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460470 - Make run-task Python 3.5+ only; r=mshal\n\nA try push converting run-task to Python 3 seemed to complete without\nerror.\n\nSince it is annoying writing code that needs to work on both Python\n2 and 3, let's require Python 3 and remove code for supporting Python 2.\n\nWe implement a version check enforcing Python 3.5+. This is because\nwe're supposed to be standardizing on 3.5+ everywhere. I want to\nprevent accidental usage of older Python 3 versions.\n\nMozReview-Commit-ID: 4vATLZ6Si2e", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "e0f80c8f3e7dac385c1dec798d3dd534bb638448", "parents": ["f86a907fd2f403f6ccfe0f1b810828e838204f04"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459980 - google-play-strings: pin mozapkpublisher to 0.7.2 r=gps\n\nMozReview-Commit-ID: 65Puqafnlkw", "files": ["taskcluster/docker/google-play-strings/Dockerfile"], "git_node": null, "git_parents": [null], "node": "f2342488ae7bbbe082e7c374e437d1b5b06327d4", "parents": ["e0f80c8f3e7dac385c1dec798d3dd534bb638448"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Remove unused mapper mixin r=Callek\n\nMozReview-Commit-ID: GN7lGzWwcvx", "files": ["testing/mozharness/mozharness/mozilla/mapper.py"], "git_node": null, "git_parents": [null], "node": "3ea56e28f2aa5c91e95501e695071075087a5aba", "parents": ["f2342488ae7bbbe082e7c374e437d1b5b06327d4"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Get rid of taskcluster helpers r=Callek", "files": ["testing/mozharness/mozharness/mozilla/taskcluster_helper.py", "testing/mozharness/mozharness/mozilla/testing/testbase.py"], "git_node": null, "git_parents": [null], "node": "769239fe0e8829102384e9d22c9639cacb048a50", "parents": ["3ea56e28f2aa5c91e95501e695071075087a5aba"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: remove mock(chroot) support r=Callek", "files": ["taskcluster/scripts/builder/build-l10n.sh", "testing/mozharness/configs/openh264/android-aarch64.py", "testing/mozharness/configs/openh264/android-arm.py", "testing/mozharness/configs/openh264/android-x86.py", "testing/mozharness/configs/openh264/linux32.py", "testing/mozharness/configs/openh264/linux64.py", "testing/mozharness/configs/single_locale/ash_android-api-16.py", "testing/mozharness/configs/single_locale/jamun_android-api-16.py", "testing/mozharness/configs/single_locale/maple_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-aurora_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-beta_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-central_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-release_android-api-16.py", "testing/mozharness/configs/single_locale/try_android-api-16.py", "testing/mozharness/configs/users/sfink/mock.py", "testing/mozharness/docs/mozharness.mozilla.rst", "testing/mozharness/mozharness/mozilla/mock.py", "testing/mozharness/mozharness/mozilla/tooltool.py", "testing/mozharness/mozharness/mozilla/updates/balrog.py", "testing/mozharness/scripts/desktop_l10n.py", "testing/mozharness/scripts/mobile_l10n.py", "testing/mozharness/scripts/openh264_build.py"], "git_node": null, "git_parents": [null], "node": "10ba3ac7adbcbb463240aefb905fa88807f153d8", "parents": ["769239fe0e8829102384e9d22c9639cacb048a50"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Fix android l10n nightlies a=bustage\n\nMissed some references to run_command_m, get_output_from_command_m when\nremoving the mock mixin.", "files": ["testing/mozharness/scripts/mobile_l10n.py"], "git_node": null, "git_parents": [null], "node": "5f51fcd01866ee19e3dfcabf8d2fdca78758caa5", "parents": ["10ba3ac7adbcbb463240aefb905fa88807f153d8"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462405 - Fix a typo r=callek", "files": ["taskcluster/docs/versioncontrol.rst"], "git_node": null, "git_parents": [null], "node": "7bd02a7d1b56f8f73fe46eac6f0ffbcfce59d4f7", "parents": ["5f51fcd01866ee19e3dfcabf8d2fdca78758caa5"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415868 - add 'mach taskgraph actions'; r=jonasfj,tomprince\n\nMozReview-Commit-ID: ExVRgcD02GK", "files": ["taskcluster/docs/actions.rst", "taskcluster/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "4a033838fdc55980e12ebaea19c6664a4504d8ec", "parents": ["7bd02a7d1b56f8f73fe46eac6f0ffbcfce59d4f7"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415868 - Remove support for register_action_task; r=jonasfj,tomprince\n\nIn a post-actions-as-hooks world, users will not have scopes to create tasks,\nso this mode of action definition will not be possible. This is not currently\nused from Treeherder (it links to\nhttps://tools.taskcluster.net/tasks/\u003ctaskid\u003e/interactive instead)\n\nThis drops support for the JSON-e-only interactive action; that action is not\ncurrently used from treeherder, so that should have no impact for users.\n\nMozReview-Commit-ID: 9i3POpjahAc", "files": ["taskcluster/taskgraph/actions/__init__.py", "taskcluster/taskgraph/actions/docker_linux_loaner.yml", "taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "6542f5cc532bd4793df61bcd849877c584176701", "parents": ["4a033838fdc55980e12ebaea19c6664a4504d8ec"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415868 - add support for defining actions with kind=hook; r=jonasfj,tomprince\n\nThis does not affect any existing actions.\n\nMozReview-Commit-ID: 9j5cT2kA7UU", "files": ["taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "6966214a07c08ee349f77193bcc0f59e333bf73f", "parents": ["6542f5cc532bd4793df61bcd849877c584176701"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415868 - include in-tree:hook-action:..{level}-* in decision task scopes; r=jonasfj,tomprince\n\nThe inclusion of this scope limits the actions initiated within this decision\ntask's task group.\n\nMozReview-Commit-ID: E5gP9UR3pdu", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "daa88efc034cbee1d368f467362900f9d83c82b7", "parents": ["6966214a07c08ee349f77193bcc0f59e333bf73f"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415868 - remove ACTION_TASK r=jonasfj,tomprince\n\nFor kind=hook, the spec doesn't include this value as it's untrustworthy.\n\nFor kind=task, it's still untrustworthy, but there is no privilege escalation\nso that's not important. Still, it dramatically expands the size of the task\ndefinition.\n\nMozReview-Commit-ID: 6scQ2ZwxP10", "files": [".taskcluster.yml", "taskcluster/mach_commands.py", "taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "1d408582e55f89f69115c8d262b770d4779a387d", "parents": ["daa88efc034cbee1d368f467362900f9d83c82b7"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415868 - change ACTION_TASK_GROUP_ID to be the taskGroupId of the target task; r=aki\n\nMozReview-Commit-ID: 8Hkga4MmmtG", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "bc4eacfd95775ff1def022857967de4bda3751c2", "parents": ["1d408582e55f89f69115c8d262b770d4779a387d"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1461980 - [taskgraph] Add ability to download artifacts from dependencies in run-task script, r=dustin\n\nThis adds a 'use-artifacts' key to the run_task schema. Tasks can specify artifacts to download like this:\n\nrun:\n    using: run-task\n    use_artifacts:\n        build:\n            - target.tar.bz2\n            - target.common.tests.zip\n            - target.mochitest.tests.zip\n\nThis will cause the run-task script to download those three artifacts from the task's 'build' dependency.\nIf the task doesn't have a 'build' dependency, taskgraph generation will error. The artifacts will be\ndownloaded into $USE_ARTIFACT_PATH. It is up to the task to do whatever extracting/setup may be required.\nE.g this setup could go in the task's command.\n\nAt this time, only 'run-task' tasks using docker-worker are supported.\n\nMozReview-Commit-ID: 3f02oCys62i", "files": ["taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/job/common.py", "taskcluster/taskgraph/transforms/job/run_task.py"], "git_node": null, "git_parents": [null], "node": "268d0e644e2bcfc661fc61ab41e107ed13d9b462", "parents": ["bc4eacfd95775ff1def022857967de4bda3751c2"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1451040 - Download remote settings dumps regularly r=sfraser\n\nMozReview-Commit-ID: BCCEplOq1O8", "files": ["taskcluster/ci/repo-update/kind.yml", "taskcluster/docker/periodic-updates/runme.sh"], "git_node": null, "git_parents": [null], "node": "0967bae4a9a51a1af9b7d3ea8fa1c73971e7b57e", "parents": ["268d0e644e2bcfc661fc61ab41e107ed13d9b462"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1463480 - always set task, even for taskgraph-level actions; r=tomprince\n\nMozReview-Commit-ID: 5A50Tef72gk", "files": ["taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "c369798a76a45062dcf72a3def052ba522ff6615", "parents": ["0967bae4a9a51a1af9b7d3ea8fa1c73971e7b57e"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Remove mozharness blobber mixin r=mtabara", "files": ["testing/mozharness/mozharness/mozilla/blob_upload.py", "testing/mozharness/mozharness/mozilla/testing/talos.py", "testing/mozharness/scripts/awsy_script.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/scripts/marionette.py", "testing/mozharness/scripts/web_platform_tests.py", "testing/mozharness/test/test_mozilla_blob_upload.py"], "git_node": null, "git_parents": [null], "node": "97962f5b0aa718c49b45ebe735f09d495b0d1074", "parents": ["c369798a76a45062dcf72a3def052ba522ff6615"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Remove mozharness purge mixin r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1318", "files": ["testing/mozharness/configs/builds/branch_specifics.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_devedition.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_devedition.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_devedition.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_devedition.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_devedition.py", "testing/mozharness/configs/single_locale/ash_android-api-16.py", "testing/mozharness/configs/single_locale/jamun_android-api-16.py", "testing/mozharness/configs/single_locale/maple_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-aurora_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-beta_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-central_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-release_android-api-16.py", "testing/mozharness/configs/single_locale/try_android-api-16.py", "testing/mozharness/external_tools/clobberer.py", "testing/mozharness/mozharness/mozilla/building/buildbase.py", "testing/mozharness/mozharness/mozilla/purge.py", "testing/mozharness/scripts/desktop_l10n.py", "testing/mozharness/scripts/desktop_partner_repacks.py", "testing/mozharness/scripts/fx_desktop_build.py", "testing/mozharness/scripts/mobile_l10n.py"], "git_node": null, "git_parents": [null], "node": "fb86737241fa9fb1083a2df971105b132fb741f7", "parents": ["97962f5b0aa718c49b45ebe735f09d495b0d1074"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1461784: Enable staging releases on try-comm-central; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1353", "files": ["taskcluster/taskgraph/util/attributes.py"], "git_node": null, "git_parents": [null], "node": "dd320db5421cc94b1347784d7ba9898826b42945", "parents": ["fb86737241fa9fb1083a2df971105b132fb741f7"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1461784: [release] Only use the partials cache on level 3 jobs; r=sfraser\n\nWhen running jobs on try, we shouldn't have access to the partials, so\ndon't try to give them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1352", "files": ["taskcluster/taskgraph/transforms/partials.py"], "git_node": null, "git_parents": [null], "node": "d5f4f67bcb8982ce3521254f1ca4bda17e9db048", "parents": ["dd320db5421cc94b1347784d7ba9898826b42945"], "tags": []}, {"author": "Chris Manchester \u003ccmanchester@mozilla.com\u003e", "branch": "default", "desc": "Bug 1463805 - Update mozharness artifact build configs not to include the \"clobber\" step. r=froydnj\n\nMozReview-Commit-ID: IS6KXh06pQ", "files": ["testing/mozharness/configs/builds/releng_base_android_64_builds.py", "testing/mozharness/configs/builds/releng_base_mac_64_cross_builds.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_artifact.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_debug_artifact.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_artifact.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_debug_artifact.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_artifact.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_fuzzing_asan.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_debug_artifact.py"], "git_node": null, "git_parents": [null], "node": "f446edb05ebec24fb61251bc96453b2150659c79", "parents": ["d5f4f67bcb8982ce3521254f1ca4bda17e9db048"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459181 - Fetch version-specific \"whatsnew\" on mozilla-release only r=sfraser\n\nMozReview-Commit-ID: Iaet3uja3vG", "files": ["taskcluster/ci/google-play-strings/kind.yml", "taskcluster/taskgraph/transforms/google_play_strings.py"], "git_node": null, "git_parents": [null], "node": "6cadd8d642503147bdf26ff3aea852ceb540d555", "parents": ["f446edb05ebec24fb61251bc96453b2150659c79"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462791 - Add helper function for VCS checkout on generic-worker; r=dustin\n\nThis functionality was implemented at least 3 times. Let's consolidate\nit to a central function.\n\nReturning multiple command strings is kind of funky. I preserved\nexisting behavior and mozharness jobs are the only ones printing the\nforensic logging. We should probably move this logging into\nrobustcheckout so we don't need to involve taskgraph with this. But\nthat can be deferred to another day.\n\nMozReview-Commit-ID: I2LglJvfI6", "files": ["taskcluster/taskgraph/transforms/job/common.py", "taskcluster/taskgraph/transforms/job/mozharness.py", "taskcluster/taskgraph/transforms/job/spidermonkey.py", "taskcluster/taskgraph/transforms/job/toolchain.py"], "git_node": null, "git_parents": [null], "node": "241b8b987ea5897e393eae2b897a8907cbd61682", "parents": ["6cadd8d642503147bdf26ff3aea852ceb540d555"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462791 - Remove docker_worker_add_gecko_vcs_env_vars(); r=dustin\n\nsupport_vcs_checkout() always sets the environment variables that\nwere set by this deleted function. In addition, support_vcs_checkout()\nalso adds caches and scopes - at least for docker-worker and\ndocker-engine. For generic-worker - which was used in all call sites\nof docker_worker_add_gecko_vcs_env_vars() (yes, the \"docker_worker\"\nbit of the name was completely wrong - probably a legacy holdover) -\nsupport_vcs_checkout() was *almost* exactly equivalent to\ndocker_worker_add_gecko_vcs_env_vars(). The only difference is that\nsupport_vcs_checkout() adds the\nsecrets:get:project/taskcluster/gecko/hgfingerprint scope in addition\nto setting the environment variables.\n\nMozReview-Commit-ID: 8fl3u9be5fT", "files": ["taskcluster/taskgraph/transforms/job/common.py", "taskcluster/taskgraph/transforms/job/mozharness.py", "taskcluster/taskgraph/transforms/job/spidermonkey.py", "taskcluster/taskgraph/transforms/job/toolchain.py"], "git_node": null, "git_parents": [null], "node": "7db48feb6ffcd3b0dc36ad609209d19c7a54d7e0", "parents": ["241b8b987ea5897e393eae2b897a8907cbd61682"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1355482 - add in-tree signing docs. r=catlee", "files": ["taskcluster/docs/release-promotion.rst", "taskcluster/docs/signing.rst"], "git_node": null, "git_parents": [null], "node": "78489002b4abad6e47b2d3c1e348a3810e163c93", "parents": ["7db48feb6ffcd3b0dc36ad609209d19c7a54d7e0"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1462791: [taskgraph] Return list from `generic_worker_hg_commands`; r=dustin a=Aryx\n\nSome code[1] expects to be able to `.extend` the result.\n\n[1] https://searchfox.org/mozilla-central/rev/bf4def01bf8f6ff0d18f02f2d7e9efc73e12c63f/taskcluster/taskgraph/transforms/job/mozharness.py#318-331\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1384", "files": ["taskcluster/taskgraph/transforms/job/common.py"], "git_node": null, "git_parents": [null], "node": "6b7f14334ea2e611f74da2039e57d4891336f90c", "parents": ["78489002b4abad6e47b2d3c1e348a3810e163c93"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Remove more buildbot references from mozharness r=Callek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1372", "files": ["taskcluster/taskgraph/transforms/job/mozharness.py", "taskcluster/taskgraph/transforms/upload_generated_sources.py", "testing/mozharness