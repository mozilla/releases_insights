able. r=catlee\n\nfor \"Cleanup l10n mozharness config files.\" (Batch 2)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1564", "files": ["testing/mozharness/configs/single_locale/ash_android-api-16.py", "testing/mozharness/configs/single_locale/autoland_android-api-16.py", "testing/mozharness/configs/single_locale/jamun_android-api-16.py", "testing/mozharness/configs/single_locale/linux.py", "testing/mozharness/configs/single_locale/linux64.py", "testing/mozharness/configs/single_locale/linux64_devedition.py", "testing/mozharness/configs/single_locale/linux_devedition.py", "testing/mozharness/configs/single_locale/macosx64.py", "testing/mozharness/configs/single_locale/macosx64_devedition.py", "testing/mozharness/configs/single_locale/maple_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-aurora_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-beta_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-central_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-inbound_android-api-16.py", "testing/mozharness/configs/single_locale/mozilla-release_android-api-16.py", "testing/mozharness/configs/single_locale/try_android-api-16.py", "testing/mozharness/configs/single_locale/win32.py", "testing/mozharness/configs/single_locale/win32_devedition.py", "testing/mozharness/configs/single_locale/win64.py", "testing/mozharness/configs/single_locale/win64_devedition.py", "testing/mozharness/scripts/desktop_l10n.py"], "git_node": null, "git_parents": [null], "node": "77305658bf2762df34b5b77623b3c1b8b0a78aa5", "parents": ["96b91ef8a5b79c25ca1f473422b4e24d2ec78d83"], "tags": []}, {"author": "David Major \u003cdmajor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1467284 - Remove the now-unused BUILDER_NAME_PREFIX map. r=aki", "files": ["taskcluster/taskgraph/transforms/job/mozharness_test.py"], "git_node": null, "git_parents": [null], "node": "007f9380e9ad05f973d6aff85d92f76bd0a41e9a", "parents": ["77305658bf2762df34b5b77623b3c1b8b0a78aa5"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1467248 - Make the spidermonkey jobs labeled debug be debug builds, r=fitzgen", "files": ["taskcluster/ci/spidermonkey/linux.yml"], "git_node": null, "git_parents": [null], "node": "1544d0ec5e6c3e4bec3ee2928d64bccaf7a59645", "parents": ["007f9380e9ad05f973d6aff85d92f76bd0a41e9a"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1422471 - EME-free Firefox builds should be included in the checksums files (eg SHA256SUMS), r=aki\n\nChains a release-eme-free-repack-beetmover-checksums kind after release-eme-free-repack-beetmover, to move\nthe target.checksums generated by the latter into the beetmover-checksums/ in candidates directory. Those\nare then consumed by release-generate-checksum kind.\n\nA lot of details like scopes, worker & provisioner, attributes, as well as data like repack_id and\npartner_path, are inherited directly from the parent beetmover task. Mainly to avoid recalculating them.\n\nIn contrast to nightly builds, GPG signing of target.checksums has not been implemented. I don't believe\nthat adds any value in our current system because the sigs are not verified.\n\nMozReview-Commit-ID: 38iz3J2PAXh", "files": ["taskcluster/ci/post-beetmover-checksums-dummy/kind.yml", "taskcluster/ci/release-eme-free-repack-beetmover-checksums/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/beetmover_emefree_checksums.py"], "git_node": null, "git_parents": [null], "node": "5b46810b8f6364caa4b782942e3686a3aecb40d0", "parents": ["1544d0ec5e6c3e4bec3ee2928d64bccaf7a59645"], "tags": []}, {"author": "Ben Hearsum \u003cbhearsum@mozilla.com\u003e", "branch": "default", "desc": "bug 1458329: update funsize update generator deps. r=sfraser", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile", "taskcluster/docker/funsize-update-generator/README", "taskcluster/docker/funsize-update-generator/requirements.txt"], "git_node": null, "git_parents": [null], "node": "cbd3902412cc8468bab72d45d8199759bf486120", "parents": ["5b46810b8f6364caa4b782942e3686a3aecb40d0"], "tags": []}, {"author": "Bhavesh \u003cbhavesh1999@gmail.com\u003e", "branch": "default", "desc": "Bug 1466098 - Removed test defaults that are set twice. r=marco", "files": ["taskcluster/taskgraph/transforms/tests.py"], "git_node": null, "git_parents": [null], "node": "d7a2e91d94680ba9d681a00b7277f6283c7c4547", "parents": ["cbd3902412cc8468bab72d45d8199759bf486120"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468386 Don't build funsize balrog image r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1655", "files": ["taskcluster/ci/docker-image/kind.yml"], "git_node": null, "git_parents": [null], "node": "09eae13133c89f5b21d1b42867c8c4362ea1118a", "parents": ["d7a2e91d94680ba9d681a00b7277f6283c7c4547"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468386 Clean up unused funsize-balrog-submitter image r=mtabara\n\nReviewers: mtabara\n\nReviewed By: mtabara\n\nSubscribers: sfraser, mtabara\n\nBug #: 1468386\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1648", "files": ["taskcluster/docker/funsize-balrog-submitter/Dockerfile", "taskcluster/docker/funsize-balrog-submitter/Makefile", "taskcluster/docker/funsize-balrog-submitter/dep.pubkey", "taskcluster/docker/funsize-balrog-submitter/nightly_sha1.pubkey", "taskcluster/docker/funsize-balrog-submitter/nightly_sha384.pubkey", "taskcluster/docker/funsize-balrog-submitter/release_sha1.pubkey", "taskcluster/docker/funsize-balrog-submitter/release_sha384.pubkey", "taskcluster/docker/funsize-balrog-submitter/requirements.txt", "taskcluster/docker/funsize-balrog-submitter/runme.sh", "taskcluster/docker/funsize-balrog-submitter/scripts/funsize-balrog-submitter-complete.py", "taskcluster/docker/funsize-balrog-submitter/scripts/funsize-balrog-submitter.py", "taskcluster/docker/funsize-balrog-submitter/submit_complete.sh"], "git_node": null, "git_parents": [null], "node": "c65ffda1fdc3492b4781cf867fe5e16b90be091e", "parents": ["09eae13133c89f5b21d1b42867c8c4362ea1118a"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1469308 - Bouncer Submission should use a different treeherder symbol for rc. r=tomprince\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1684", "files": ["taskcluster/ci/release-bouncer-sub/kind.yml"], "git_node": null, "git_parents": [null], "node": "8e791fcf8d531c212e5a34965606f9ce0031fda5", "parents": ["c65ffda1fdc3492b4781cf867fe5e16b90be091e"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469351 - Vendor latest robustcheckout; r=sheehan\n\nThis vendors the latest version of the robustcheckout extension with\na workaround for bug 1462323. This should hopefully mitigate the\nunderlying issue while servers are being physically moved this\nweek.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1689", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "25c8d1fe721993c69c5448c0b9b3ec4f30496e8c", "parents": ["8e791fcf8d531c212e5a34965606f9ce0031fda5"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469450 - release-update-verify-config tasks failing for 61.0rc, r=aki\n\nThe by-project and by-build-platform are collapsed by resolve_keyed_by(), and in turn by keymatch() in\nutils/attributes.py. That needs a regexp to look for matches (if a simple match isn't possible). Rev\n39eed777c0c4 missed that when it landed. The trailing hypens are to distringuish between the two linux\nplatforms.\n\nMozReview-Commit-ID: LiAJpfV71Ws", "files": ["taskcluster/ci/release-update-verify-config/kind.yml"], "git_node": null, "git_parents": [null], "node": "de01c023e0d8ced1962e6dcdd944d3295820bdc7", "parents": ["25c8d1fe721993c69c5448c0b9b3ec4f30496e8c"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469687 - Handle EXIT_PURGE_CACHES in all run-task tasks; r=tomprince\n\nAny run-task task could exit with EXIT_PURGE_CACHES and expect the\ntask to be retried. Before this commit, we only registered this exit\ncode for tasks \"using: run-task.\" That excluded mozharness and\na handful of other \"using\" flavors.\n\nWith this commit, we register the exit codes for all run-task tasks\nby sniffing for the presence of run-task in the low-level code that\nemits the task definition. This should prevent run-tasks tasks\nfrom falling through the cracks and not having their exit codes\nresult in meaningful behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1715", "files": ["taskcluster/taskgraph/transforms/job/run_task.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "9c5c34a182f6947abc0c520b9184c63a2cb1ba21", "parents": ["de01c023e0d8ced1962e6dcdd944d3295820bdc7"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1465799 - Makes sure that we don't check for a truthy stub-installer value until after resolving keyed by r=dustin\n\nFixes https://bugzilla.mozilla.org/show_bug.cgi?id=1465799#c11\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1671", "files": ["taskcluster/taskgraph/transforms/build.py"], "git_node": null, "git_parents": [null], "node": "457225062f010fdcc6fbfd1392e20d2c5e57ba0d", "parents": ["9c5c34a182f6947abc0c520b9184c63a2cb1ba21"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1465799 - Set expectations for stub installer to true on beta/release because we always set update channel as such on these branches. r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1708", "files": ["taskcluster/ci/build/windows.yml"], "git_node": null, "git_parents": [null], "node": "2277fa301c70744251227ecead8eab82f62fa604", "parents": ["457225062f010fdcc6fbfd1392e20d2c5e57ba0d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469676 - Reduce max-run-time for various build tasks; r=glandium\n\nThe max-run-time for tasks appears to have been mostly cargo\nculted. In particular, a value of 36000 (10 hours) is quite absurd:\nno single task takes that long to execute.\n\nThis commit reduces the max-run-time of several tasks to\nmore reasonable values. The goal here is to prevent\nexcessively long-running tasks. There is definitely room to\nfurther tweak values to further mitigate long-running tasks. But\nlet's bite off the biggest chunk first, since that doesn't\nrequire much mental effort.\n\nThere is a possibility I overshot on some of these tasks. If we\nget timeouts, we can always increase the timeout again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1716", "files": ["taskcluster/ci/artifact-build/kind.yml", "taskcluster/ci/build/android-stuff.yml", "taskcluster/ci/build/linux.yml", "taskcluster/ci/build/macosx.yml", "taskcluster/ci/toolchain/linux.yml", "taskcluster/ci/toolchain/macosx.yml", "taskcluster/ci/toolchain/windows.yml"], "git_node": null, "git_parents": [null], "node": "cb6c49908cfe22caf6e2dabafcd2040f6efac73a", "parents": ["2277fa301c70744251227ecead8eab82f62fa604"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1469095 - Fix always-optimized jobs after bug 1465181. r=dustin", "files": ["taskcluster/taskgraph/transforms/job/__init__.py"], "git_node": null, "git_parents": [null], "node": "5eded7263b0cedd74820fa07691f21d87054178c", "parents": ["cb6c49908cfe22caf6e2dabafcd2040f6efac73a"], "tags": []}, {"author": "Brian Stack \u003cbstack@mozilla.com\u003e", "branch": "default", "desc": "Bug 1465117 - Take two at updating backfill task. Use modifier this time. r=dustin,jmaher\n\nMozReview-Commit-ID: CAs0WRb839r", "files": ["taskcluster/mach_commands.py", "taskcluster/taskgraph/actions/backfill.py", "taskcluster/taskgraph/actions/util.py", "taskcluster/taskgraph/task.py"], "git_node": null, "git_parents": [null], "node": "4179a704b16f0fab97b9e820b917e120eb3b39ac", "parents": ["5eded7263b0cedd74820fa07691f21d87054178c"], "tags": []}, {"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1469676 - Reduce max-run-time for various build tasks: Increase Linux build max-run-time because they are pgo on beta. r=me a=beta-fix", "files": ["taskcluster/ci/build/linux.yml"], "git_node": null, "git_parents": [null], "node": "ecaa62aed082a5a13c5d5015246beae493f45bfd", "parents": ["4179a704b16f0fab97b9e820b917e120eb3b39ac"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468627 - add docs pointing to ci-admin and ci-configuration; r=tomprince\n\nThis is just enough to make these repos discoverable and suggest their usage.\nAnything more would duplicate documentation in those repositories.\n\nMozReview-Commit-ID: 1WNEsoQBB9U", "files": ["taskcluster/docs/actions.rst", "taskcluster/docs/index.rst", "taskcluster/docs/taskcluster-config.rst"], "git_node": null, "git_parents": [null], "node": "1a54c9a15f7b351382e7541def287fad2ee194a8", "parents": ["ecaa62aed082a5a13c5d5015246beae493f45bfd"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415868 - fix test-action-callback after rev e2931d904975, r=dustin\n\nMozReview-Commit-ID: LlUQHanvVng", "files": ["taskcluster/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "adc416042808c3a608850b8028d9a1f81ef438fc", "parents": ["1a54c9a15f7b351382e7541def287fad2ee194a8"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1301782 - Be explicit about what tags to create. r=aki\n\nfor Tag RC releases\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1757", "files": ["taskcluster/ci/release-version-bump/kind.yml", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "e4a3b63242ed5ee88d6789e37891f4ab99e17c1e", "parents": ["adc416042808c3a608850b8028d9a1f81ef438fc"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1301782 - Perform buildN tagging at promote phase. r=aki\n\nfor Tag RC releases\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1758", "files": ["taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/ci/release-version-bump/kind.yml", "taskcluster/docs/kinds.rst"], "git_node": null, "git_parents": [null], "node": "1c23c04e3d2fbeb4cfd7c8cdc618208921921210", "parents": ["e4a3b63242ed5ee88d6789e37891f4ab99e17c1e"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462294 - remove unused date branch; r=Pike\n\nMozReview-Commit-ID: LLUWpPiDOcI", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "1cd2b3238a7e294f569c4e8cb752d6efd1adffe3", "parents": ["1c23c04e3d2fbeb4cfd7c8cdc618208921921210"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Fix python unitests r=bustage a=tomprince", "files": ["layout/tools/reftest/selftest/test_reftest_output.py", "testing/mochitest/tests/python/test_basic_mochitest_plain.py"], "git_node": null, "git_parents": [null], "node": "5e22edccd73569d0e6a3c9244d6724ffe2aeefee", "parents": ["1cd2b3238a7e294f569c4e8cb752d6efd1adffe3"], "tags": []}], "date": 1531503031, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "mozilla@hocat.ca"}, "109": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1421062: [release] Enable production scriptworkers on comm-beta and comm-esr60; r=me a=release DONTBUILD", "files": ["taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/util/attributes.py", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "0b4260b76ba21c52c0d78bafb285dcdd92fba840", "parents": ["5e22edccd73569d0e6a3c9244d6724ffe2aeefee"], "tags": []}], "date": 1531504517, "git_changesets": [null], "user": "mozilla@hocat.ca"}, "110": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1420865 - Don't check for CONTENT_MAY_CHANGE_TRANSFORM across layer trees. r=mstange, a=RyanVM\n\nMayResample() is used on the content and compositor to determine whether the whole\nvisible region should be or should have been validated. This calculation is done\npartially by traversing ancestor layers and looking for a flag. This can return\ndifferent values then in the content side versus the shadow side, which in this\ncase leads to artifacts.\n\nThis commit tries to solve the problem by ignoring layers that content is unaware\nof. This works, but has the downside that resampling artifacts could show up if\nthe parent process is truly doing animations that require resampling.\n\nMozReview-Commit-ID: 4TW6nzxS6E", "files": ["gfx/layers/Layers.cpp", "gfx/layers/Layers.h"], "git_node": null, "git_parents": [null], "node": "7b0391a25a29f84c72fcf4d05488ab1daccbfbe2", "parents": ["0b4260b76ba21c52c0d78bafb285dcdd92fba840"], "tags": []}, {"author": "David Major \u003cdmajor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453061- Merge libaom code size fix. r=drno, a=RyanVM\n\nhttps://aomedia-review.googlesource.com/c/aom/+/39401", "files": ["media/libaom/config/win/ia32/aom_config.h", "media/libaom/config/win/x64/aom_config.h", "third_party/aom/configure"], "git_node": null, "git_parents": [null], "node": "5f480411f54538cccc002fc8c6cbcaca0eabfc06", "parents": ["7b0391a25a29f84c72fcf4d05488ab1daccbfbe2"], "tags": []}, {"author": "David Major \u003cdmajor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453061 - Merge libvpx code size fix. r=drno, a=RyanVM\n\nhttps://chromium-review.googlesource.com/c/webm/libvpx/+/841103", "files": ["media/libvpx/config/win/x64/vpx_config.h", "media/libvpx/libvpx/configure"], "git_node": null, "git_parents": [null], "node": "27b5a1a03f38600c8a24b5fcdd20bbc94c885dd7", "parents": ["5f480411f54538cccc002fc8c6cbcaca0eabfc06"], "tags": []}, {"author": "kanika \u003ckanika16047@iiitd.ac.in\u003e", "branch": "default", "desc": "Bug 1452740 - Added Policy: Disable Hardware Acceleration. r=Felipe, a=RyanVM\n\nMozReview-Commit-ID: FVrpCRtwQLh", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/hardware_acceleration/browser.ini", "browser/components/enterprisepolicies/tests/browser/hardware_acceleration/browser_policy_hardware_acceleration.js", "browser/components/enterprisepolicies/tests/browser/hardware_acceleration/disable_hardware_acceleration.json", "browser/components/enterprisepolicies/tests/moz.build"], "git_node": null, "git_parents": [null], "node": "390c533b2694d00af7d3170174eaef727d298482", "parents": ["27b5a1a03f38600c8a24b5fcdd20bbc94c885dd7"], "tags": []}, {"author": "Kanika Saini", "branch": "default", "desc": "Bug 1453350 - Search Engines Policy runs on modification. r=Felipe, a=RyanVM\n\nMozReview-Commit-ID: DXfC6ldE63T", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "97641a1614d4d36a93fd7233d40871dd0dd12343", "parents": ["390c533b2694d00af7d3170174eaef727d298482"], "tags": []}, {"author": "Felipe Gomes \u003cfelipc@gmail.com\u003e", "branch": "default", "desc": "Bug 1463895 - Allow some policies to be machine-only. r=mkaply, a=RyanVM\n\nMachine-only policies can only be triggered from sources that require user privileges to make machine-wide changes. Currently, that means the policies.json file in the installation folder, or the HKEY_LOCAL_MACHINE registry root. In other words, it currently excludes the HKEY_CURRENT_USER registry root\n\nMozReview-Commit-ID: G9wxEM19yVb", "files": ["browser/components/enterprisepolicies/EnterprisePolicies.js", "browser/components/enterprisepolicies/WindowsGPOParser.jsm"], "git_node": null, "git_parents": [null], "node": "7978d6ecb26b360fb5bf5df0ddf5cedcd432f864", "parents": ["97641a1614d4d36a93fd7233d40871dd0dd12343"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1441821 - NativeKey shouldn't mark eKeyDown and eKeyPress as \"skippable in remote process\" if message is not caused by physical key press. r=m_kato, r=smaug, a=RyanVM\n\nCurrently, TabChild discards eKeyDown and eKeyPress events which are marked as\n\"repeated\" and were dispatched after the latest eKeyDown event comes into the\nprocess.  However, keyboard layout utils may generate native key events\nas \"repeated\" even if each native key is important to input proper text.\n\nSo, TabChild shouldn't decide if coming keyboard event is skippable only with\nmIsRepeat.  For solving this issue, this patch adds\nmMaybeSkippableInRemoteProcess to WidgetKeyboardEvent and makes\nTabChild::SkipRepeatedKeyEvent() check\nWidgetKeyboardEvent::CanSkipInRemoteProcess() instead.\n\nOn Windows, there are two ways to generate keyboard input messages.  One is\nusing SendMessage() or PostMessage().  The other is SendInput() API.  In both\nways, utils can make their input as repeated key messages.\n\nThe former case must be safe for this issue since such utils need to set 31st\nbit of lParam to 1 explicitly.\n\nOn the other hand, in the latter case, the utils probably need to append\nKEYEVENTF_KEYUP into KEYBDINPUT::dwFlags.  Otherwise, only first call is\ntreated as non-repeated event.\n\nSo, when given message does not came from physical key operation, NativeKey\nshould set WidgetKeyboardEvent::mMaybeSkippableInRemoteProcess to false\neven if WidgetKeyboardEvent::mIsRepeat is true.\n\nMozReview-Commit-ID: 3rinrOjx8Tf", "files": ["dom/ipc/TabChild.cpp", "widget/TextEvents.h", "widget/nsGUIEventIPC.h", "widget/windows/KeyboardLayout.cpp", "widget/windows/KeyboardLayout.h", "widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "e290aa06c191389a232e80dcd0a62903b46b2a5b", "parents": ["7978d6ecb26b360fb5bf5df0ddf5cedcd432f864"], "tags": []}], "date": 1531516987, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "111": {"changesets": [{"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1467870 - When cloning Xray expando chains for an adopt into the Xray compartment, don't lose expandos. r=mrbkap, a=RyanVM\n\nThis does mean that if the node is adopted back into the original document the\nexpandos would end up on the reflector at that point.  I think that's OK;\npeople shouldn't be adopting things in that direction.  Futhermore, if they\nadopt, then set expandos, then adopt back they already get this behaviorl\n\nSo if we decide we don't want that, we should probably just avoid copying own\nprops when reparenting into a global whose principals don't subsume the old\nglobal.", "files": ["dom/bindings/test/test_dom_xrays.html", "js/xpconnect/wrappers/XrayWrapper.cpp"], "git_node": null, "git_parents": [null], "node": "c3a6baa14bfc0654cde77db5814597a853b5f2bd", "parents": ["e290aa06c191389a232e80dcd0a62903b46b2a5b"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1466991 - Part 1: Factor out ShouldUseXBLScope. r=smaug, a=RyanVM\n\nWe're going to add another consumer in the next changeset.", "files": ["dom/base/nsIDocument.h"], "git_node": null, "git_parents": [null], "node": "078985dd8656d929d079ab9236f5be321037ab08", "parents": ["c3a6baa14bfc0654cde77db5814597a853b5f2bd"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1466991 - Part 2: Reparent nodes when they start being in the XBL scope. r=smaug, a=RyanVM", "files": ["dom/base/nsINode.cpp"], "git_node": null, "git_parents": [null], "node": "0915c8e08aa926e892c22d7d6c4944945b1828f8", "parents": ["078985dd8656d929d079ab9236f5be321037ab08"], "tags": []}, {"author": "Kanika Saini", "branch": "default", "desc": "Bug 1466484 - Added remove to SearchEngines Policy. r=Felipe, a=RyanVM\n\nMozReview-Commit-ID: 6g3qp6q605i", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_search_engine.js"], "git_node": null, "git_parents": [null], "node": "c42dc9fb2a1b8b81d697c7ab0540712eb4d4a556", "parents": ["0915c8e08aa926e892c22d7d6c4944945b1828f8"], "tags": []}, {"author": "Kanika Saini", "branch": "default", "desc": "Bug 1467062 - Permissions Policy added to configure camera, microphone, location and notifications. r=Felipe, a=RyanVM\n\nMozReview-Commit-ID: IqpEboxHjjt", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_permissions.js", "browser/components/preferences/sitePermissions.js"], "git_node": null, "git_parents": [null], "node": "bb4c2fcd5a0467d7b95e475e74145a6022378f03", "parents": ["c42dc9fb2a1b8b81d697c7ab0540712eb4d4a556"], "tags": []}, {"author": "Nico Grunbaum \u003cna-g@nostrum.com\u003e", "branch": "default", "desc": "Bug 1456101 - Ensure X11 DesktopCapture module is created on main thread. r=dminor, a=RyanVM\n\nMozReview-Commit-ID: 8lP03135ttK", "files": ["dom/media/systemservices/VideoEngine.cpp", "media/webrtc/trunk/webrtc/video_engine/desktop_capture_impl.cc"], "git_node": null, "git_parents": [null], "node": "2bbea07a6d67f5854b10d736961cd9be003de065", "parents": ["bb4c2fcd5a0467d7b95e475e74145a6022378f03"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469257 - [H264] Only check for SPS changes on keyframe. r=bryce, a=RyanVM\n\nSome invalid streams contain SPS changes and those appear to only occur on non-keyframe, this cause all frames to be dropped until the next keyframe is found. This result in apparent freezes.\n\nWhile it is theoretically possible to have SPS changes inband on non-keyframe those should be very rare (I've never seen one). The content would have been invalid anyway in an non-fragmented mp4.\n\nSo we now only check for a SPS change on keyframe. This would cause no affect on either windows, android or ffmpeg as those decoders handle format change fine. The mac decoder could however show garbled frames temporarily.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1733", "files": ["dom/media/platforms/wrappers/H264Converter.cpp"], "git_node": null, "git_parents": [null], "node": "42232ab8fa6d453c4a30b2f245142646ca20e74f", "parents": ["2bbea07a6d67f5854b10d736961cd9be003de065"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469603 - Use a recursive lock in crash reporter callbacks that might be called synchronously. r=erahm, a=RyanVM", "files": ["dom/plugins/ipc/PluginModuleParent.cpp", "dom/plugins/ipc/PluginModuleParent.h"], "git_node": null, "git_parents": [null], "node": "0d73faee431ce2a70cf5056714344f442b1fe4af", "parents": ["42232ab8fa6d453c4a30b2f245142646ca20e74f"], "tags": []}], "date": 1531518112, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "112": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1423895: Don't use the XUL stylesheet cache if the parsing mode doesn't match. r=bz a=jorgk\n\nEnigmail is loading a XUL document sheet that is @import-ed in another chrome://\nsheet.\n\nServo keys stuff off the origin of the sheet, which we derive from the parsing\nmode (see mode_to_origin in glue.rs).\n\nMozReview-Commit-ID: LQqKmxToBKC", "files": ["layout/style/Loader.cpp"], "git_node": null, "git_parents": [null], "node": "0c42de7c105b1f4fa427a3cb99541e543d5dd4b1", "parents": ["0b4260b76ba21c52c0d78bafb285dcdd92fba840"], "tags": []}, {"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1439323 - Backed out bug 1429125 (changeset 2e705f777acd) to build Thunderbird 60. a=jorgk", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": null, "git_parents": [null], "node": "a86e665e8e8e7a4ece2d6cbc6f24c45c99ccf0db", "parents": ["0c42de7c105b1f4fa427a3cb99541e543d5dd4b1"], "tags": []}, {"author": "Samuel Thibault \u003csamuel.thibault\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1376756 - gtk: while drawing nsTreeBodyFrame, fetch current row attributes for proper style rendering. r=karlt a=jorgk DONTBUILD", "files": ["layout/xul/tree/nsTreeBodyFrame.h", "widget/gtk/gtk2drawing.c", "widget/gtk/gtk3drawing.cpp", "widget/gtk/gtkdrawing.h", "widget/gtk/nsNativeThemeGTK.cpp"], "git_node": null, "git_parents": [null], "node": "feccfbf2922833dbd8ff0a3f1a9966ad63561c1e", "parents": ["a86e665e8e8e7a4ece2d6cbc6f24c45c99ccf0db"], "tags": []}], "date": 1531518836, "git_changesets": [null, null, null], "user": "mozilla@jorgk.com"}, "113": {"changesets": [{"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1470993 - Fix reflect mingw clang compilation. r=dmajor, a=RyanVM\n\nMozReview-Commit-ID: 4al9Yid9prK", "files": ["xpcom/reflect/xptcall/md/win32/xptcinvoke_asm_x86_64_gnu.s", "xpcom/reflect/xptcall/md/win32/xptcstubs_x86_64_gnu.cpp"], "git_node": null, "git_parents": [null], "node": "c97eb25fa3142c649d8efb9ed89369a4a03c120b", "parents": ["0d73faee431ce2a70cf5056714344f442b1fe4af"], "tags": []}, {"author": "Timothy Guan-tin Chien \u003ctimdream@gmail.com\u003e", "branch": "default", "desc": "Bug 1454610 - Restore PNG density metadata on DMG backgrounds. r=dolske, a=RyanVM\n\nMozReview-Commit-ID: GI6rL2Kv0D5", "files": ["browser/branding/aurora/background.png", "browser/branding/official/background.png"], "git_node": null, "git_parents": [null], "node": "c01e26f35e0293041c183f72740f601bc5098cfe", "parents": ["c97eb25fa3142c649d8efb9ed89369a4a03c120b"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1471177 - Use mingw-specific IFStream and OFStream implementation only when building againstd libstdc++. r=froydnj, a=RyanVM\n\nMozReview-Commit-ID: 6aKGtK7B74z", "files": ["mfbt/FStream.h"], "git_node": null, "git_parents": [null], "node": "ce326730c91e68c227d4d7f854001335bbb21982", "parents": ["c01e26f35e0293041c183f72740f601bc5098cfe"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1471293 - Support using llvm-objdump in dependentlibs.py. r=glandium, a=RyanVM\n\nMozReview-Commit-ID: 8b0o06EQh3n", "files": ["toolkit/library/dependentlibs.py"], "git_node": null, "git_parents": [null], "node": "b8d266ef27f9801e8b3b3760ce93e4e16c6d8eb7", "parents": ["ce326730c91e68c227d4d7f854001335bbb21982"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1470973 - Fix cairo-d2d-surface.cpp mingw clang compilation. r=lsalzman, a=RyanVM\n\nMozReview-Commit-ID: Jt7MvFZTMYY", "files": ["gfx/cairo/cairo/src/cairo-d2d-surface.cpp"], "git_node": null, "git_parents": [null], "node": "1604fca43d55ae27ef1d64e69714a6905adf1bb7", "parents": ["b8d266ef27f9801e8b3b3760ce93e4e16c6d8eb7"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1471352 - Don't export functions from gcc_throw.h in mingw builds. r=froydnj, a=RyanVM\n\nMozReview-Commit-ID: D5HQWCN12oI", "files": ["memory/mozalloc/throw_gcc.h"], "git_node": null, "git_parents": [null], "node": "ebcdfc8d2d1e05c34d11d102b14cdb3d365b8ec4", "parents": ["1604fca43d55ae27ef1d64e69714a6905adf1bb7"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1461421 - Use OffsetOf to calculate the location of parameters_ rather than making assumptions about the parent class. r=bobowen, a=RyanVM\n\nMozReview-Commit-ID: D7REZiAIMpN", "files": ["security/sandbox/chromium/sandbox/win/src/crosscall_params.h", "security/sandbox/chromium/sandbox/win/src/crosscall_server.cc"], "git_node": null, "git_parents": [null], "node": "4b45706bab90190d2c6b40f83eebe4553e616e90", "parents": ["ebcdfc8d2d1e05c34d11d102b14cdb3d365b8ec4"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1461421 - Add OffsetOf patch to chromium patch directory. r=bobowen, a=RyanVM\n\nMozReview-Commit-ID: 3td0bc2PHzu", "files": ["security/sandbox/chromium-shim/patches/with_update/mingw_offsetof.patch", "security/sandbox/chromium-shim/patches/with_update/patch_order.txt"], "git_node": null, "git_parents": [null], "node": "c633b410482c065c24f0cafb655b9399441ed425", "parents": ["4b45706bab90190d2c6b40f83eebe4553e616e90"], "tags": []}], "date": 1531519182, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "114": {"changesets": [{"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1471643 - Use -std=gnu89 for libpng compilation on mingw. r=glandium, a=RyanVM\n\nMozReview-Commit-ID: 3JnNunChnv", "files": ["media/libpng/moz.build"], "git_node": null, "git_parents": [null], "node": "0a420f6c4295c7b7ae27e1aec45db22f326b444e", "parents": ["c633b410482c065c24f0cafb655b9399441ed425"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468909 - Enforce that all given RP IDs be valid domain strings in webauthn. r=qdot, a=RyanVM\n\nThe webauthn spec mandates that relying party identifiers (RP IDs) are valid\ndomain strings. This enforces that by ensuring that any passed-in RP IDs parse\ncorrectly when set as the host portion of a URL.\n\nhttps://w3c.github.io/webauthn/#relying-party-identifier", "files": ["dom/webauthn/WebAuthnManager.cpp", "dom/webauthn/tests/test_webauthn_make_credential.html", "dom/webauthn/tests/test_webauthn_sameorigin.html"], "git_node": null, "git_parents": [null], "node": "889b989e9723b0ebbfe58142b7f8c2ff63257e1d", "parents": ["0a420f6c4295c7b7ae27e1aec45db22f326b444e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468845 - Check calls to GetFontResource for failure and bail out safely. r=lsalzman, a=RyanVM", "files": ["gfx/thebes/gfxDWriteFontList.cpp"], "git_node": null, "git_parents": [null], "node": "c8095b306d4d99a5d728448b11562d0f584463dd", "parents": ["889b989e9723b0ebbfe58142b7f8c2ff63257e1d"], "tags": []}, {"author": "Paolo Amadini \u003cpaolo.mozmail@amadzone.org\u003e", "branch": "default", "desc": "Bug 1465458 - Fix launching downloads without a file extension on Windows. r=mak, a=RyanVM\n\nMozReview-Commit-ID: 6VYjHM46gZx", "files": ["toolkit/components/downloads/DownloadIntegration.jsm"], "git_node": null, "git_parents": [null], "node": "bb310ef154f70dfa4b567e05b54771baae86efff", "parents": ["c8095b306d4d99a5d728448b11562d0f584463dd"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1471095 - Don't do extra work we don't need to in ReparentWrappersInSubtree. r=smaug, a=RyanVM", "files": ["dom/base/nsINode.cpp", "layout/base/nsCSSFrameConstructor.cpp"], "git_node": null, "git_parents": [null], "node": "345d18e0fb7cbda953fce0f63d1e7394cc12476c", "parents": ["bb310ef154f70dfa4b567e05b54771baae86efff"], "tags": []}, {"author": "Eric Rahm \u003cerahm@mozilla.com\u003e", "branch": "default", "desc": "Bug 1472018 - Limit the lock scope in WebCryptoThreadPool::Shutdown. r=bz, a=RyanVM\n\nIn bug 1364624 we switched over to SRWLock on Windows for our internal\nimplementation of mozilla::Mutex. This doesn't allow for re-entrancy. The\nWebCryptoThreadPool shutdown code has potential for re-entrancy due to the\nspinning of the main thread event loop while shutting down the worker threads.\n\nBy limiting the scope of the lock protecting mPool during shutdown we can avoid\nthe re-entrancy. Addtionally we track the shutdown status to avoid dispatching\nevents once shutdown has started.", "files": ["dom/crypto/WebCryptoThreadPool.cpp", "dom/crypto/WebCryptoThreadPool.h"], "git_node": null, "git_parents": [null], "node": "5ece581f9c7be228ba022a3f55828031a287f1fc", "parents": ["345d18e0fb7cbda953fce0f63d1e7394cc12476c"], "tags": []}, {"author": "ozoder \u003cozoder@redhat.com\u003e", "branch": "default", "desc": "Bug 1472611 - Don't link DBus 1.5.12 symbol dbus_validate_bus_name(). r=stransky, a=RyanVM\n\nMozReview-Commit-ID: 6scVh8DOex2", "files": ["toolkit/components/remote/nsDBusRemoteService.cpp", "widget/xremoteclient/DBusRemoteClient.cpp"], "git_node": null, "git_parents": [null], "node": "548d1abcf197c3566c05fc34cbd2a3ec0b3f793d", "parents": ["5ece581f9c7be228ba022a3f55828031a287f1fc"], "tags": []}], "date": 1531673254, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "115": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469309 - Remove an unused sensor type. r=agaynor, a=RyanVM", "files": ["hal/Hal.cpp", "hal/HalSensor.h", "hal/sandbox/SandboxHal.cpp"], "git_node": null, "git_parents": [null], "node": "0e6190b701db068e61e5f57249b4acc6f2c92c30", "parents": ["548d1abcf197c3566c05fc34cbd2a3ec0b3f793d"], "tags": []}, {"author": "Mats Palmgren \u003cmats@mozilla.com\u003e", "branch": "default", "desc": "Bug 1470260 - Part 1: Ensure that 'this' stays alive for the duration of the TickRefreshDriver call. r=emilio, a=RyanVM", "files": ["layout/base/nsRefreshDriver.cpp"], "git_node": null, "git_parents": [null], "node": "dbcd9b40290f7fc82e2143b9109bd4799d83d6b2", "parents": ["0e6190b701db068e61e5f57249b4acc6f2c92c30"], "tags": []}, {"author": "Mats Palmgren \u003cmats@mozilla.com\u003e", "branch": "default", "desc": "Bug 1470260 - Part 2: Make RefreshDriverTimer ref-counted and hold a strong ref on it on the stack when nsRefreshDriver::Tick can be reached. r=emilio, a=RyanVM", "files": ["layout/base/nsRefreshDriver.cpp"], "git_node": null, "git_parents": [null], "node": "47af518fe0286f677b7409b7b43bcd9bae81d6d9", "parents": ["dbcd9b40290f7fc82e2143b9109bd4799d83d6b2"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468738 - Create new DisplayItemDatas if required for unmerged display items. r=mattwoodrow, a=RyanVM", "files": ["layout/painting/FrameLayerBuilder.cpp"], "git_node": null, "git_parents": [null], "node": "caa39737edde9b0b3fe52e0edc612769090cbdf4", "parents": ["47af518fe0286f677b7409b7b43bcd9bae81d6d9"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469914 - Prevent the HAL from registering duplicate observers. r=froydnj, a=RyanVM\n\nThis also replaces the custom logic in ObserverList with an nsTObserverArray\nwhich has all the necessary logic for stable iteration over a potentially\nchanging list of items. Unused dependencies were also removed.", "files": ["hal/Hal.cpp", "hal/Hal.h", "xpcom/ds/Observer.h"], "git_node": null, "git_parents": [null], "node": "f00c89b679b2e0ed6deec4e42ebf62b8f5082f6b", "parents": ["caa39737edde9b0b3fe52e0edc612769090cbdf4"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1472137 - Prevent mutex reentry in mscom::Interceptor::Create if GetInitialInterceptorForIID fails. r=aklotz, a=RyanVM\n\nIf GetInitialInterceptorForIID fails, the live set lock is not released in most cases, but the newly created Interceptor will be destroyed.\nThe Interceptor's destructor tries to acquire the live set lock again, but that causes a deadlock, since reentry is no longer allowed for a mutex after bug 1364624.\nGetInitialInterceptorForIID now ensures the live set lock is always released  on failure, thus preventing the deadlock.\n\nMozReview-Commit-ID: z0Q7JLnJXQ", "files": ["accessible/ipc/win/HandlerProvider.cpp", "ipc/mscom/Interceptor.cpp", "ipc/mscom/Utils.h"], "git_node": null, "git_parents": [null], "node": "03d0bbff4c5c3987a2229a85dd917b6a0f0c7c22", "parents": ["f00c89b679b2e0ed6deec4e42ebf62b8f5082f6b"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1474007 - Null check to prevent crash when ipc::mscom::GetInitialInterceptorForIID fails after PublishTarget. r=aklotz, a=RyanVM\n\nPublishTarget calls Unlock on our LiveSetAutolock.\nIt's possible for GetInitialInterceptorForIID to fail after this point.\nThis will cause the failure cleanup code to run, which tries to call Unlock again.\nHowever, the previous call to Unlock set mLiveSet to null, and Unlock previously didn't handle this case.\nNow, unlock is a no-op (in release builds) if it's already been called.\n\nMozReview-Commit-ID: 15ffXR6nKqc", "files": ["ipc/mscom/Interceptor.cpp"], "git_node": null, "git_parents": [null], "node": "97ac105db46db89a67040e7dcc6866df5c31cca1", "parents": ["03d0bbff4c5c3987a2229a85dd917b6a0f0c7c22"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1471556 - Support mingw clang in configure scripts. r=glandium, a=RyanVM\n\nMozReview-Commit-ID: GKLbHvYgXnL", "files": ["js/src/old-configure.in", "old-configure.in"], "git_node": null, "git_parents": [null], "node": "6213468203898d1183c1d30a45f7689ca6368a6a", "parents": ["97ac105db46db89a67040e7dcc6866df5c31cca1"], "tags": []}], "date": 1531674199, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "116": {"changesets": [{"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1470977 - Fix GLBlitHelperD3D.cpp mingw clang compilation. r=lsalzman, a=RyanVM\n\nMozReview-Commit-ID: LVrzWQKmKeW", "files": ["gfx/gl/GLBlitHelperD3D.cpp"], "git_node": null, "git_parents": [null], "node": "bb9ea018edf6ec5d64d92ac0ee005d56beddccc5", "parents": ["6213468203898d1183c1d30a45f7689ca6368a6a"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1443471 - Use correct rust target for mingw clang. r=glandium, a=RyanVM\n\nMozReview-Commit-ID: G40IanxGWXv", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": null, "git_parents": [null], "node": "0aeece86e02dab4b8c193df1bef16018f278dd53", "parents": ["bb9ea018edf6ec5d64d92ac0ee005d56beddccc5"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1443471 - Take clang mingw into account in moz.build files. r=glandium, a=RyanVM\n\nMozReview-Commit-ID: 2vKiHjmI9Hn", "files": ["config/external/ffi/moz.build", "toolkit/crashreporter/minidump-analyzer/moz.build", "toolkit/crashreporter/test/moz.build", "xpcom/base/moz.build", "xpcom/build/moz.build"], "git_node": null, "git_parents": [null], "node": "a43554005a5ab97efc589b1a3325ddb4218479f9", "parents": ["0aeece86e02dab4b8c193df1bef16018f278dd53"], "tags": []}, {"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1443471 - Support mingw clang in skia moz.build. r=glandium, a=RyanVM\n\nMozReview-Commit-ID: 4H8bkHyczGM", "files": ["gfx/skia/generate_mozbuild.py", "gfx/skia/moz.build"], "git_node": null, "git_parents": [null], "node": "16ed2ac69014fe6b492aed15758380fb341ad359", "parents": ["a43554005a5ab97efc589b1a3325ddb4218479f9"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1474814 - Invalidate the AccessibleHandler cache on focus events. r=MarcoZ, a=RyanVM\n\nWe don't fire a state change for the focused state, since that would be redundant given that we fire a focus event.\nHowever, that also means the handler cache previously didn't get invalidated when there was a focus change without any other update.\nThat resulted in stale focused states, which could mean an object was exposed as focused when it wasn't.\nInvalidating the cache for focus events ensures the focused state is always up to date.\n\nMozReview-Commit-ID: DZTJMbiTwgt", "files": ["accessible/windows/msaa/AccessibleWrap.cpp"], "git_node": null, "git_parents": [null], "node": "f2e139fd72f68eb58a04acb2ea19b6311d9ea40b", "parents": ["16ed2ac69014fe6b492aed15758380fb341ad359"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1472925 - Keep a strong reference to MediaStreamGraph from GraphDriver. r=padenot, a=RyanVM", "files": ["dom/media/GraphDriver.cpp", "dom/media/GraphDriver.h", "dom/media/MediaStreamGraph.cpp"], "git_node": null, "git_parents": [null], "node": "511fca97fb60ebda78b0d8aff49d379ca238d26a", "parents": ["f2e139fd72f68eb58a04acb2ea19b6311d9ea40b"], "tags": []}], "date": 1531674976, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "117": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1475868: [release] comm-esr60 is used for releasing things to the `release` update channel; r=me a=tomprince DONTBUILD", "files": ["taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "eae0435135ad6713bf9d776f71b7d7cc3e01756d", "parents": ["feccfbf2922833dbd8ff0a3f1a9966ad63561c1e"], "tags": []}], "date": 1531675001, "git_changesets": [null], "user": "mozilla@hocat.ca"}, "118": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1456988 - don't use strict compatibility for dictionaries. r=kmag a=jorgk", "files": ["toolkit/mozapps/extensions/internal/XPIInstall.jsm", "toolkit/mozapps/extensions/internal/XPIProvider.jsm", "toolkit/mozapps/extensions/test/xpcshell/test_strictcompatibility.js"], "git_node": null, "git_parents": [null], "node": "cefdbe8256166a07816452429c5a3e27eb503652", "parents": ["eae0435135ad6713bf9d776f71b7d7cc3e01756d"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 468497: Inform the accessibility FocusManager when a XUL tree's view changes. r=MarcoZ a=jorgk DONTBUILD\n\nWithout this, accessibility clients don't get notified about the newly focused item.\nFor example, this meant that nothing was reported by screen readers when switching tabs in Thunderbird with control+tab.\n\nMozReview-Commit-ID: F7vqvLXzeJR", "files": ["accessible/xul/XULTreeAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "8c585f7d67f5636dc3eef2cbd5b71052b570fdd1", "parents": ["cefdbe8256166a07816452429c5a3e27eb503652"], "tags": []}], "date": 1531697565, "git_changesets": [null, null], "user": "mozilla@jorgk.com"}, "119": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2152", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "62ff213422537e62bd32ce4aa475600bec95c4df", "parents": ["511fca97fb60ebda78b0d8aff49d379ca238d26a"], "tags": []}], "date": 1531751895, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "120": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1456988 - Follow-up: s/webextension-dictionary/dictionary/. r+a=me DONTBUILD CLOSED TREE", "files": ["toolkit/mozapps/extensions/internal/XPIInstall.jsm", "toolkit/mozapps/extensions/internal/XPIProvider.jsm"], "git_node": null, "git_parents": [null], "node": "abae8941234801d8aa5b6cfd8cc49ef62bc48e62", "parents": ["8c585f7d67f5636dc3eef2cbd5b71052b570fdd1"], "tags": []}], "date": 1531765533, "git_changesets": [null], "user": "mozilla@jorgk.com"}, "121": {"changesets": [{"author": "kanika \u003ckanika16047@iiitd.ac.in\u003e", "branch": "default", "desc": "Bug 1455888 - Added a check to Policies.jsm addAllowDenyPermissions to throw an error when the user tries to add built-in sites to the permission manager. r=Felipe, a=RyanVM\n\nMozReview-Commit-ID: JIRr6BtK3x8", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "b362584937acf04901c07cd3947562abadaee4f8", "parents": ["62ff213422537e62bd32ce4aa475600bec95c4df"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471932 - Avoid deadlock when loading 3rd party roots. r=franziskus, a=RyanVM\n\nChangeCertTrustWithPossibleAuthentication should never be called while holding\nnsNSSComponent::mMutex, because doing so can result in showing the master\npassword dialog, which spins the event loop, which can cause other code to run\nthat may attempt to acquire the same lock (e.g. speculative connect checking\nnsNSSComponent to see if the user has smart cards or client certificates).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2011", "files": ["security/manager/ssl/nsNSSComponent.cpp"], "git_node": null, "git_parents": [null], "node": "c205c55c641d37b68e60097caf3a289004f530c1", "parents": ["b362584937acf04901c07cd3947562abadaee4f8"], "tags": []}], "date": 1531868809, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "122": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2240", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "f0916cba09daacc6c715fab31cfde70833987de9", "parents": ["c205c55c641d37b68e60097caf3a289004f530c1"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1476149 - Intermittent verify failure in browser_formless_submit_chrome.js. r=Gijs, a=test-only\n\nMake the test select() urlbar text beforem moving to the right of it\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2220", "files": ["toolkit/components/passwordmgr/test/browser/browser_formless_submit_chrome.js"], "git_node": null, "git_parents": [null], "node": "9a262bb3b87b69dd00b861e382424472c5c9d1ae", "parents": ["f0916cba09daacc6c715fab31cfde70833987de9"], "tags": []}, {"author": "Anny Gakhokidze \u003cagakhokidze@mozilla.com\u003e", "branch": "default", "desc": "Bug 1473161 - Add missing bound check in nsContentUtils::DataTransferItemToImage. r=nika, a=RyanVM\n\nMozReview-Commit-ID: BE8e0lBjMRt", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h"], "git_node": null, "git_parents": [null], "node": "e48cec0a46e2def10839d14fbb9361118a9019ed", "parents": ["9a262bb3b87b69dd00b861e382424472c5c9d1ae"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1456294 - Hook ImmAssociateContextEx. r=masayuki, a=RyanVM", "files": ["dom/ipc/PBrowser.ipdl", "dom/ipc/TabParent.cpp", "dom/ipc/TabParent.h", "dom/plugins/base/nsPluginInstanceOwner.cpp", "dom/plugins/base/nsPluginInstanceOwner.h", "dom/plugins/ipc/PPluginInstance.ipdl", "dom/plugins/ipc/PluginInstanceChild.cpp", "dom/plugins/ipc/PluginInstanceChild.h", "dom/plugins/ipc/PluginInstanceParent.cpp", "dom/plugins/ipc/PluginInstanceParent.h", "widget/PuppetWidget.cpp", "widget/PuppetWidget.h", "widget/nsIWidget.h", "widget/windows/WinUtils.cpp", "widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "cb8f0498a8b1bf250eafe0a1245b5fc6c2e02f72", "parents": ["e48cec0a46e2def10839d14fbb9361118a9019ed"], "tags": []}], "date": 1532019950, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "123": {"changesets": [{"author": "Ben Hearsum \u003cbhearsum@mozilla.com\u003e", "branch": "default", "desc": "bug 1469284: allow ssh username to be passed to the merge day scripts. r=mtabara, a=release DONTBUILD", "files": ["testing/mozharness/scripts/merge_day/gecko_migration.py"], "git_node": null, "git_parents": [null], "node": "3e9b4893c28092dfe332efd4b90c4048a1ac2e54", "parents": ["cb8f0498a8b1bf250eafe0a1245b5fc6c2e02f72"], "tags": []}], "date": 1532358616, "git_changesets": [null], "user": "bhearsum@mozilla.com"}, "124": {"changesets": [{"author": "Rok Garbas \u003crok@garbas.si\u003e", "branch": "default", "desc": "Bug 1471541 - switch to new tooltool url, r=rail, a=release", "files": ["python/mozboot/bin/bootstrap-msys2.vbs", "testing/mozharness/configs/repackage/win32_partner.py", "testing/mozharness/configs/repackage/win64_partner.py", "tools/lint/eslint/eslint-plugin-mozilla/update.sh", "tools/lint/eslint/update.sh"], "git_node": null, "git_parents": [null], "node": "90ed6b60beeb406951d5eb6d2de4e989cc436b3b", "parents": ["3e9b4893c28092dfe332efd4b90c4048a1ac2e54"], "tags": []}], "date": 1532436577, "git_changesets": [null], "user": "rgarbas@mozilla.com"}, "125": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2504", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "2ac1a4b2dd848a92e374812194564598c5ca452c", "parents": ["90ed6b60beeb406951d5eb6d2de4e989cc436b3b"], "tags": []}], "date": 1533154503, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "126": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1414776 - [fxui] Reset security.mixed_content.upgrade_display_content preference for mixed content test. r=ato a=test-only\n\nMozReview-Commit-ID: IOIFyH5ilPp", "files": ["testing/firefox-ui/tests/functional/security/test_mixed_content_page.py"], "git_node": null, "git_parents": [null], "node": "e87f42adb54bebdcd276e3c87f6c2e788f154372", "parents": ["2ac1a4b2dd848a92e374812194564598c5ca452c"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1414776 - [fxui] Change testcases from mozqa.com to badssl.com and mixed-content-tests-mozilla.org. r=ato a=test-only\n\nMozReview-Commit-ID: DadY39FdZQT", "files": ["testing/firefox-ui/tests/functional/security/test_dv_certificate.py", "testing/firefox-ui/tests/functional/security/test_ev_certificate.py", "testing/firefox-ui/tests/functional/security/test_mixed_content_page.py", "testing/firefox-ui/tests/functional/security/test_mixed_script_content_blocking.py", "testing/firefox-ui/tests/functional/security/test_security_notification.py", "testing/firefox-ui/tests/functional/security/test_ssl_disabled_error_page.py", "testing/firefox-ui/tests/functional/security/test_ssl_status_after_restart.py", "testing/firefox-ui/tests/functional/security/test_submit_unencrypted_info_warning.py", "testing/firefox-ui/tests/functional/security/test_unknown_issuer.py", "testing/firefox-ui/tests/functional/security/test_untrusted_connection_error_page.py", "testing/firefox-ui/tests/puppeteer/test_security.py", "testing/firefox-ui/tests/puppeteer/test_toolbars.py", "testing/marionette/puppeteer/firefox/firefox_puppeteer/api/security.py"], "git_node": null, "git_parents": [null], "node": "83881d78f3db97b68703e599cb1533706049340c", "parents": ["e87f42adb54bebdcd276e3c87f6c2e788f154372"], "tags": []}], "date": 1533233200, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "127": {"changesets": [{"author": "rahul-shiv \u003crahul.shivaprasad@gmail.com\u003e", "branch": "default", "desc": "Bug 1478883 - Tagging operations should use DONTBUILD in commit message r=Callek a=ritu\n\nMozReview-Commit-ID: 6QBQG3m907I", "files": ["taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "0d20abc40d2845160ae491fb28e3dc85c54374d3", "parents": ["83881d78f3db97b68703e599cb1533706049340c"], "tags": []}], "date": 1533414471, "git_changesets": [null], "user": "Callek@gmail.com"}, "128": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=mtabara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2773", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "703938ae6e8d2f533b4318d28b0ecba11293d182", "parents": ["0d20abc40d2845160ae491fb28e3dc85c54374d3"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1373234 - Avoid races in tests involving menu creation. r=mixedpuppy, a=test-only\n\nbrowser.menus.create and browser.contextMenus.create are asynchronous\nAPIs. For compatibility reasons, they cannot return a promise (since\nthey already return an integer).\n\nThis modifies all tests that use either of these APIs, to ensure that\nthe test waits for the callback of the last menus/contextMenus.create\ncall before continuing with the test.\n\nIn some cases in browser_ext_menus.js I did not add any callbacks,\nbecause there were other asynchronous API calls (browser.tabs API)\nthat already guaranteed that the test made a round-trip to the parent\nprocess before continuing.\n\nThis fixes:\n- Bug 1462862 (browser_ext_contextMenus_icons.js)\n- Bug 1403429 (browser_ext_contextMenus_onclick.js)\n- Bug 1321182 (browser_ext_contextMenus.js)\n- Bug 1373234 (browser_ext_menus.js)\n\nMozReview-Commit-ID: IZFUyIw8Tbl", "files": ["browser/components/extensions/test/browser/browser_ext_contextMenus.js", "browser/components/extensions/test/browser/browser_ext_contextMenus_icons.js", "browser/components/extensions/test/browser/browser_ext_contextMenus_onclick.js", "browser/components/extensions/test/browser/browser_ext_menus.js"], "git_node": null, "git_parents": [null], "node": "66a7064bfc9fcce9449d585e1f50ea88951ab7dd", "parents": ["703938ae6e8d2f533b4318d28b0ecba11293d182"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1373234 - Small cleanup in browser_ext_contextMenus*.js tests. r=mixedpuppy, a=test-only\n\nUse sendMessage/awaitMessage instead of notifyPass/awaitFinish in tests\nwhere this is not the last completion callback.\n\nRemove an unneeded browser.contextMenus.onClicked.addListener call.\n\nMozReview-Commit-ID: Akpla9tiAlD", "files": ["browser/components/extensions/test/browser/browser_ext_contextMenus.js", "browser/components/extensions/test/browser/browser_ext_contextMenus_icons.js"], "git_node": null, "git_parents": [null], "node": "71e5720baa204bfb5f352cbb95a99a6f437623d5", "parents": ["66a7064bfc9fcce9449d585e1f50ea88951ab7dd"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469657 - Whitelist Extensis UTC fonts on 10.11 and Earlier. r=Alex_Gaynor, a=RyanVM\n\nAdd whitelist rules to allow access to Extensis Universal Type Manager fonts\non 10.11 and earlier OS versions.\n\nMozReview-Commit-ID: 3cPKlC1xCUW", "files": ["security/sandbox/mac/SandboxPolicies.h"], "git_node": null, "git_parents": [null], "node": "bb527c36fe121e29366b9b625af9568eb448a16a", "parents": ["71e5720baa204bfb5f352cbb95a99a6f437623d5"], "tags": []}, {"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1473840: fixed Teredo IPv6 prefix detection. r=mjf a=ritu\n\nMozReview-Commit-ID: 6dRsirith0O", "files": ["media/mtransport/third_party/nICEr/src/net/transport_addr.c"], "git_node": null, "git_parents": [null], "node": "aeb7ea1b5492ad79f74cd5631a1c048e1222ce1c", "parents": ["bb527c36fe121e29366b9b625af9568eb448a16a"], "tags": []}, {"author": "Dragana Damjanovic \u003cdd.mozilla@gmail.com\u003e", "branch": "default", "desc": "Bug 1468523 - Fix the history entry for http-equiv=refresh. r=smaug, r=mayhemer, a=ritu", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsDocShellLoadInfo.cpp", "docshell/base/nsDocShellLoadInfo.h", "docshell/base/nsIDocShell.idl", "docshell/base/nsIDocShellLoadInfo.idl"], "git_node": null, "git_parents": [null], "node": "5c8d99292b7bb02aa0b5adcce0c53e7a79e88448", "parents": ["aeb7ea1b5492ad79f74cd5631a1c048e1222ce1c"], "tags": []}], "date": 1533584174, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "129": {"changesets": [{"author": "Jacek Caban \u003cjacek@codeweavers.com\u003e", "branch": "default", "desc": "Bug 1471016 - cubeb_winmm.c should not define __MSVCRT_VERSION__. r=padenot, a=RyanVM\n\nMozReview-Commit-ID: FqEPnmxxkc5", "files": ["media/libcubeb/mingw-ucrt.patch", "media/libcubeb/src/cubeb_winmm.c", "media/libcubeb/update.sh"], "git_node": null, "git_parents": [null], "node": "9accf16021d13619d8842636ec8c30251ffb4efc", "parents": ["5c8d99292b7bb02aa0b5adcce0c53e7a79e88448"], "