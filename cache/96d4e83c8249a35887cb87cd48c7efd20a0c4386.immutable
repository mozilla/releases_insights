gtest/TestFilePreferencesWin.cpp", "xpcom/tests/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "8a1e8be23badb364dc17135c7051e29256ba00a9", "parents": ["1ab79799a5e963d294161e5ed0b3eea054ed77d0"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1412081 - Call KillClearOnShutdown(ShutdownPhase::ShutdownFinal) in PluginProcessChild on all platforms. r=jimm, a=RyanVM\n\nThis call gated by ifdef OS_WIN - so on Linux it would leak objects that were supposed to be ClearOnShutdown in the plugin process", "files": ["dom/plugins/ipc/PluginProcessChild.cpp"], "git_node": null, "git_parents": [null], "node": "6a1df03e37c9d428064356645b73567f97b83586", "parents": ["8a1e8be23badb364dc17135c7051e29256ba00a9"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1404274 - Key Evaluation on the cloned JS objects. r=asuth, a=RyanVM", "files": ["dom/indexedDB/IDBCursor.cpp", "dom/indexedDB/IDBObjectStore.cpp", "dom/indexedDB/IDBObjectStore.h", "testing/web-platform/meta/IndexedDB/clone-before-keypath-eval.html.ini", "testing/web-platform/meta/IndexedDB/key_invalid.htm.ini", "testing/web-platform/meta/IndexedDB/keypath-exceptions.htm.ini"], "git_node": null, "git_parents": [null], "node": "63f65151b538d6a9a4e363a0688713cdf3761aca", "parents": ["6a1df03e37c9d428064356645b73567f97b83586"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1474883 - Ensure D2D glyph cache is pruned after rendering 1000 transformed glyphs. r=bas, a=RyanVM\n\nRendering glyphs at many different rotations was causing the D2D glyph\ncache to grow very large. Calling EndDraw/BeginDraw will prune the\ncache, but is costly, so only do it for every 1000 glyphs.\n\nMozReview-Commit-ID: HUFpxDvYAzQ", "files": ["gfx/2d/DrawTargetD2D1.cpp", "gfx/2d/DrawTargetD2D1.h"], "git_node": null, "git_parents": [null], "node": "151d3c2ef92d9ba9e585728441ac15ddfe1544d1", "parents": ["63f65151b538d6a9a4e363a0688713cdf3761aca"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1450989 - Capture the action and target as part of the form submission creation. r=bz, a=RyanVM", "files": ["dom/base/FormData.cpp", "dom/html/HTMLFormElement.cpp", "dom/html/HTMLFormElement.h", "dom/html/HTMLFormSubmission.cpp", "dom/html/HTMLFormSubmission.h"], "git_node": null, "git_parents": [null], "node": "a62385e8d213ffa4cf5cbbe820c8ebebbeaa0e23", "parents": ["151d3c2ef92d9ba9e585728441ac15ddfe1544d1"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1473113 - Defer initializing the MAR index until it's needed. r=rstrong, a=RyanVM", "files": ["modules/libmar/src/mar.h", "modules/libmar/src/mar_read.c"], "git_node": null, "git_parents": [null], "node": "76f13904a547c74b88ff3141e73b462b32b8b34b", "parents": ["a62385e8d213ffa4cf5cbbe820c8ebebbeaa0e23"], "tags": []}], "date": 1533677819, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "135": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 63f65151b538 (bug 1404274) for bustage.", "files": ["dom/indexedDB/IDBCursor.cpp", "dom/indexedDB/IDBObjectStore.cpp", "dom/indexedDB/IDBObjectStore.h", "testing/web-platform/meta/IndexedDB/clone-before-keypath-eval.html.ini", "testing/web-platform/meta/IndexedDB/key_invalid.htm.ini", "testing/web-platform/meta/IndexedDB/keypath-exceptions.htm.ini"], "git_node": null, "git_parents": [null], "node": "4724f75e4822ad568357303ecc787b1c69e9710a", "parents": ["76f13904a547c74b88ff3141e73b462b32b8b34b"], "tags": []}], "date": 1533679140, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "136": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1454627 - Re-enable browser_ext_user_events.js (bug 1381305). r=mixedpuppy, a=test-only\n\nRe-enable the test that was disabled in bug 1381305 and fix the\nunderlying issue that caused th intermittent failure in the first place.\n\nMozReview-Commit-ID: BL9wS2fogaf", "files": ["browser/components/extensions/test/browser/browser-common.ini", "browser/components/extensions/test/browser/browser_ext_user_events.js"], "git_node": null, "git_parents": [null], "node": "7f50df7d3dffa074c64bf8253fb8356007ab4a65", "parents": ["4724f75e4822ad568357303ecc787b1c69e9710a"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1454627 - Run \"onclick\" event of menu with user input. r=mixedpuppy, a=test-only\n\nMozReview-Commit-ID: r1URJfOKUB", "files": ["browser/components/extensions/ext-c-menus.js", "browser/components/extensions/test/browser/browser_ext_user_events.js"], "git_node": null, "git_parents": [null], "node": "e9ebf293f7d2acbfddfd7989eb8ffd3b376e1cf1", "parents": ["7f50df7d3dffa074c64bf8253fb8356007ab4a65"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1454627 - Fix timing issue in browser_ext_user_events.js. r=mixedpuppy, a=test-only\n\nThe hard-coded wait exists to avoid a test failure caused by a\nnon-functional click event in an options browser. However, that\nstill does not get rid of the intermittent failure.\n\nTo really avoid the timing issue, check whether onclick was fired\nafter supposedly triggering a click, and if not, wait and retry.\n\nMozReview-Commit-ID: 9eg6sz1s1e3", "files": ["browser/components/extensions/test/browser/browser_ext_user_events.js"], "git_node": null, "git_parents": [null], "node": "c757271f3a16f8fba3f6829f5a707be3075cf691", "parents": ["e9ebf293f7d2acbfddfd7989eb8ffd3b376e1cf1"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1404274 - Key Evaluation on the cloned JS objects. r=asuth, a=RyanVM", "files": ["dom/indexedDB/IDBCursor.c