ault", "desc": "Bug 1456234: [mozharness] Process EXTRA_MOZHARNESS_CONFIG even if no files are specified; r=aki\n\nThis will allow mozharness configs to be specified exclusively in the taskgraph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1017", "files": ["taskcluster/scripts/builder/build-linux.sh", "testing/mozharness/mozharness/base/config.py"], "git_node": null, "git_parents": [null], "node": "0c53c704e5e853db6a6a4fb178da8a7217ff5d3c", "parents": ["38b55b326dc3f1af2875ec99db7813d01a74f88f"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Embed generate-checksums mozharness config in taskcluster config; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1018", "files": ["taskcluster/ci/release-generate-checksums/kind.yml", "taskcluster/taskgraph/transforms/release_generate_checksums.py", "testing/mozharness/configs/releases/checksums_devedition.py", "testing/mozharness/configs/releases/checksums_fennec.py", "testing/mozharness/configs/releases/checksums_firefox.py", "testing/mozharness/configs/releases/dev_checksums_devedition.py", "testing/mozharness/configs/releases/dev_checksums_fennec.py", "testing/mozharness/configs/releases/dev_checksums_firefox.py"], "git_node": null, "git_parents": [null], "node": "1816dcbb10708384d1d2a054a1bee3918c6459ab", "parents": ["0c53c704e5e853db6a6a4fb178da8a7217ff5d3c"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1455143 - Stop beetmoving deleted testing artifacts r=gps,mtabara\n\nMozReview-Commit-ID: L10NmJH7s2A", "files": ["taskcluster/taskgraph/transforms/beetmover.py"], "git_node": null, "git_parents": [null], "node": "b34c58259fb657c88d2cf503c12ce525f4258abf", "parents": ["1816dcbb10708384d1d2a054a1bee3918c6459ab"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1455378 Give an informative error message of you try to ./mach pastebin too large a file. r=gps", "files": ["tools/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "401b6e9f0c3d1d9e73b0e9c9339cc22503eccc52", "parents": ["b34c58259fb657c88d2cf503c12ce525f4258abf"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456379: Remove references to `date` branch; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1028", "files": [".cron.yml", "taskcluster/mach_commands.py", "taskcluster/taskgraph/test/test_util_attributes.py", "taskcluster/taskgraph/transforms/task.py", "testing/mozharness/configs/builds/branch_specifics.py", "testing/mozharness/configs/multi_locale/date_android-armv6.json", "testing/mozharness/configs/multi_locale/date_android-x86.json", "testing/mozharness/configs/multi_locale/date_android.json", "testing/mozharness/configs/single_locale/date.py", "testing/mozharness/configs/single_locale/date_android-api-16.py", "testing/mozharness/configs/single_locale/dev-mozilla-beta_devedition.py"], "git_node": null, "git_parents": [null], "node": "f0138ea3d88e052e53a2cc8e56b6a9b362620500", "parents": ["401b6e9f0c3d1d9e73b0e9c9339cc22503eccc52"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1456326 - Trim some fat from decision image; r=dustin\n\nThe big win comes from removing the APT lists. We also reduce the\nnumber of layers while we're here.\n\nThis makes the image 162 MB instead of 202 MB.\n\nMozReview-Commit-ID: K2ic4zcr31j", "files": ["taskcluster/docker/decision/Dockerfile", "taskcluster/docker/decision/system-setup.sh"], "git_node": null, "git_parents": [null], "node": "9b059c32ee129ad3ab5815ae99300cf887ed42f0", "parents": ["f0138ea3d88e052e53a2cc8e56b6a9b362620500"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1456326 - Bump version of decision image; r=dustin\n\nVersion number is arbitrary.\n\nMozReview-Commit-ID: EGfDiyGuCPI", "files": ["taskcluster/docker/decision/VERSION"], "git_node": null, "git_parents": [null], "node": "484416f550b6e67c11019182565521bcf70f24ff", "parents": ["9b059c32ee129ad3ab5815ae99300cf887ed42f0"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1456326 - Use latest decision image for decision task; r=dustin\n\nAs part of this we also change the cache name to ensure that\nthe new image uses a separate cache from the old image.\n\nMozReview-Commit-ID: J4DmgupnyS", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "96a34dd5b69fd9ca1c944a60bfc4f1d7e7543cf5", "parents": ["484416f550b6e67c11019182565521bcf70f24ff"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1418058: [taskcluster] Add `graph_config` to some actions that were originally missed; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1025", "files": ["taskcluster/taskgraph/actions/cancel_all.py", "taskcluster/taskgraph/actions/purge_caches.py"], "git_node": null, "git_parents": [null], "node": "9e98e037421d128d652ec1f1041c7e2a5e59b5ee", "parents": ["96a34dd5b69fd9ca1c944a60bfc4f1d7e7543cf5"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1456620 - stop uploading public partners to private. r=nthomas\n\nMozReview-Commit-ID: 2clmiQKswnp", "files": ["taskcluster/taskgraph/transforms/beetmover_repackage_partner.py"], "git_node": null, "git_parents": [null], "node": "7e206bf77a77e6e2a3db8aa12998472ac83123d8", "parents": ["9e98e037421d128d652ec1f1041c7e2a5e59b5ee"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1456620 - move check_if_partners_enabled call. r=nthomas\n\nBecause the transforms are generators, we actually call them from the bottom up. The previous transforms don't get called until the `for task in tasks:` or `for job in jobs:` in the following transform.\n\nMoving the `check_if_partners_enabled` transform to the end means we never try to access `config.params['release_partner_config'].values()` in `add_command_arguments` when `release_partner_config` is None. Otherwise, we hit errors when we run taskgraph-gen.py.\n\nMozReview-Commit-ID: Ho2odPL9FxS", "files": ["taskcluster/taskgraph/transforms/partner_repack.py"], "git_node": null, "git_parents": [null], "node": "0b87cd08fff76652c4a2231d8a95eda70c650cfc", "parents": ["7e206bf77a77e6e2a3db8aa12998472ac83123d8"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1456620 - chunk mac partner signing. r=nthomas\n\nPreviously, we had a single mac signing task that signed all mac locales and subpartners in a single signing task. This task required us to bump the signing task timeout. Chunking gives us a speed boost and a bit more resiliency if a single signing task fails - we don't have to re-sign everything, only the tasks that fail.\n\nMozReview-Commit-ID: 4vPZE1vzZoQ", "files": ["taskcluster/ci/release-eme-free-repack-signing/kind.yml", "taskcluster/ci/release-partner-repack-signing/kind.yml", "taskcluster/taskgraph/transforms/chunk_partners.py", "taskcluster/taskgraph/transforms/partner_signing.py", "taskcluster/taskgraph/transforms/signing.py"], "git_node": null, "git_parents": [null], "node": "b91270dfe0ae602af7b14e8e5549871299de2c19", "parents": ["0b87cd08fff76652c4a2231d8a95eda70c650cfc"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1457010 - gpg sign partner repacks, r=aki\n\nThis adds repackage-signing on mac and linux, depending on repackage and the chunking-dummy kinds respectively, and repackage-signing is extended to create gpg signatures. The signing_dependencies are no longer added because the beetmover_repackage_partner.py transform is going to set that up manually, and it avoids duplicate targets which the schema blocks.\n\nBeetmover can depend now on repackage-signing for all platforms, and no longer has any indirect dependencies to worry about, but does need to know about copying the .asc files as upstream artifacts.\n\nMozReview-Commit-ID: JcIdXQ2B7Rg", "files": ["taskcluster/ci/release-eme-free-repack-beetmover/kind.yml", "taskcluster/ci/release-eme-free-repack-repackage-signing/kind.yml", "taskcluster/ci/release-partner-repack-beetmover/kind.yml", "taskcluster/ci/release-partner-repack-repackage-signing/kind.yml", "taskcluster/taskgraph/transforms/beetmover_repackage_partner.py", "taskcluster/taskgraph/transforms/repackage_signing_partner.py"], "git_node": null, "git_parents": [null], "node": "099c7e07a7ed68d47dbb62a86d1c4c84364b5344", "parents": ["b91270dfe0ae602af7b14e8e5549871299de2c19"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1421062: Enable production beetmoving on comm-central branches; r=aki a=me\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1060", "files": ["taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "5303f8cbf750e23ca09a2a4ebcc4713b5e2819d3", "parents": ["099c7e07a7ed68d47dbb62a86d1c4c84364b5344"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1421062: Enable production nightly balrog update on comm-central branches; r=me a=me", "files": ["taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "6166e5e7cabd0136f80627fd488569b29fb91b2a", "parents": ["5303f8cbf750e23ca09a2a4ebcc4713b5e2819d3"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458105 - try more to fetch automationrelevance; r=gps\n\nMozReview-Commit-ID: LdcGes2mf01", "files": ["taskcluster/taskgraph/files_changed.py"], "git_node": null, "git_parents": [null], "node": "909c1a4834711ec96d8ffccd4629acb6d79d41a7", "parents": ["6166e5e7cabd0136f80627fd488569b29fb91b2a"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1446815 - add source shas in release checksums. r=aki a=release", "files": ["taskcluster/ci/beetmover-release-source-checksums/kind.yml", "taskcluster/ci/config.yml", "taskcluster/ci/post-beetmover-checksums-dummy/kind.yml", "taskcluster/ci/release-source-checksums-signing/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/beetmover_source_checksums.py", "taskcluster/taskgraph/transforms/source_checksums_signing.py"], "git_node": null, "git_parents": [null], "node": "426ad9dd34bf248ae1bf09cb99063529d8aec079", "parents": ["909c1a4834711ec96d8ffccd4629acb6d79d41a7"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Use release platforms in generate-checksums tasks; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1019", "files": ["taskcluster/ci/release-generate-checksums/kind.yml"], "git_node": null, "git_parents": [null], "node": "6811f48f2de349db7560452bd3fcdd552c6ed385", "parents": ["426ad9dd34bf248ae1bf09cb99063529d8aec079"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Don't use toolchains in source tasks; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1053", "files": ["taskcluster/ci/release-source/kind.yml"], "git_node": null, "git_parents": [null], "node": "1a6217ac322c21e87b21f1a02dc1f6159bd7ad7c", "parents": ["6811f48f2de349db7560452bd3fcdd552c6ed385"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Unsplit definition of release-source tasks; r=aki\n\nThe previous definitions are split across to files, but the task are complex\nenough to warrant it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1054", "files": ["taskcluster/ci/release-source/kind.yml", "taskcluster/ci/release-source/source.yml"], "git_node": null, "git_parents": [null], "node": "f9a1cf8dbd8db361b1f8b2d47c56a24484d21583", "parents": ["1a6217ac322c21e87b21f1a02dc1f6159bd7ad7c"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: [release] Use release platforms for source; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1055", "files": ["taskcluster/ci/release-source-signing/kind.yml", "taskcluster/ci/release-source/kind.yml", "taskcluster/taskgraph/transforms/beetmover.py", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "b2af0e367e3e0be5f6097d983c61c427c2d7031d", "parents": ["f9a1cf8dbd8db361b1f8b2d47c56a24484d21583"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1456234: Fix yamllint errors; rs=bustage-fix CLOSED TREE", "files": ["taskcluster/ci/release-source/kind.yml"], "git_node": null, "git_parents": [null], "node": "81e7922c67cc0cba01e992c8918afb057bb8aa2f", "parents": ["b2af0e367e3e0be5f6097d983c61c427c2d7031d"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1453033 - Do not define shipping-product explicitly, let it be inhereted. r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1103", "files": ["taskcluster/ci/release-beetmover-signed-langpacks/kind.yml", "taskcluster/ci/release-sign-and-push-langpacks/kind.yml"], "git_node": null, "git_parents": [null], "node": "c89e13fc3f4721729c32fd23150799ab5ca6d5c5", "parents": ["81e7922c67cc0cba01e992c8918afb057bb8aa2f"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1453033 - Define taskgraph logic for signing and shipping devedition language packs as well. r=aki\n\nThis merely extends the logic involved in shipping language packs to AMO. All devedition language packs will be shipped as 'unlisted' for now, meaning that there is no extra AMO work involved. The extension ID is taken from the langpack itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1104", "files": ["taskcluster/ci/release-sign-and-push-langpacks/kind.yml", "taskcluster/taskgraph/transforms/beetmover_repackage.py", "taskcluster/taskgraph/transforms/release_beetmover_signed_addons.py", "taskcluster/taskgraph/transforms/release_sign_and_push_langpacks.py"], "git_node": null, "git_parents": [null], "node": "919d2de9237f844b48ffbfb93a7fe35d1c88d466", "parents": ["c89e13fc3f4721729c32fd23150799ab5ca6d5c5"], "tags": []}, {"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1458378 - Make l10n jobs (seen on try) tier 3, since they are more likely than not to fail, because they are different than what we do for Nightlies. r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1081", "files": ["taskcluster/ci/l10n/kind.yml"], "git_node": null, "git_parents": [null], "node": "21bc86782f47413c475c2c93bcb069b521ab0817", "parents": ["919d2de9237f844b48ffbfb93a7fe35d1c88d466"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459116 - Disable job failed/exception notifications, r=rail\n\nMozReview-Commit-ID: 39kxGWO6oyV", "files": ["taskcluster/ci/beetmover-release-source-checksums/kind.yml", "taskcluster/ci/release-partner-repack/kind.yml", "taskcluster/ci/release-source-checksums-signing/kind.yml"], "git_node": null, "git_parents": [null], "node": "fdd471629c2bed9e50c2a769d071078f6e460d33", "parents": ["21bc86782f47413c475c2c93bcb069b521ab0817"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1450029: Remove buildbot/buildbot-bridge references from taskcluster r=aki,tomprince\n\nMozReview-Commit-ID: Hu9ju4XVQpA", "files": ["taskcluster/docker/desktop1604-test/Dockerfile", "taskcluster/docker/periodic-updates/README.md", "taskcluster/docker/recipes/ubuntu1604-test-system-setup.sh", "taskcluster/docs/transforms.rst", "taskcluster/taskgraph/morph.py", "taskcluster/taskgraph/optimize.py", "taskcluster/taskgraph/transforms/job/buildbot.py", "taskcluster/taskgraph/transforms/job/mozharness_test.py", "taskcluster/taskgraph/transforms/task.py", "taskcluster/taskgraph/transforms/tests.py", "taskcluster/taskgraph/util/bbb_validation.py", "taskcluster/taskgraph/util/schema.py", "taskcluster/taskgraph/util/seta.py", "taskcluster/taskgraph/util/verify.py", "taskcluster/taskgraph/util/workertypes.py"], "git_node": null, "git_parents": [null], "node": "c0747119d1984f085fb8c2625eb49f4db6d2d740", "parents": ["fdd471629c2bed9e50c2a769d071078f6e460d33"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459273 - remove unnecessary options from taskcluster talos.yml configs. r=rwood", "files": ["taskcluster/ci/test/talos.yml", "testing/mozharness/mozharness/mozilla/testing/talos.py"], "git_node": null, "git_parents": [null], "node": "84a540beeae9ecaa8c077149f49481455215c10c", "parents": ["c0747119d1984f085fb8c2625eb49f4db6d2d740"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458638 - It looks like Skia is no longer being used on talos on windows. r=rwood", "files": ["taskcluster/taskgraph/transforms/tests.py"], "git_node": null, "git_parents": [null], "node": "31e5a218248c71c3cdb6ce9927977d4392d31246", "parents": ["84a540beeae9ecaa8c077149f49481455215c10c"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1458700: [release-promotion] Add shipping-product list to graph config; r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1111", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "5017ef9d29d690b7506d5dd98d13feeabf681a41", "parents": ["31e5a218248c71c3cdb6ce9927977d4392d31246"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1442306 - simplify make-buildinfo-file by letting it assume Mozilla CI. r=gps\n\nThe `make-buildinfo-file` target is called as part of `make package` to\ngenerate a json file and a text file with some info about the build. Because\na few of those things like the Build ID and source repo / changeset are not\nguaranteed to be set at configure time it has to pass them down from the make\nenvironment.\n\nIn CI all of these things are passed in the environment, populated at task\ngraph generation time, so doing this work only in automation builds lets\nus simplify things a bit.\n\nMozReview-Commit-ID: 5Ygd3XmSA8x", "files": ["toolkit/mozapps/installer/informulate.py", "toolkit/mozapps/installer/packager.mk"], "git_node": null, "git_parents": [null], "node": "99307c8739efa4d788300016dbab91eb4d73e947", "parents": ["5017ef9d29d690b7506d5dd98d13feeabf681a41"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1442306 - move build info.txt generation into informulate.py. r=gps\n\nThis script is already doing most of the work, so make it write the text\nfile instead of using shell commands.\n\nMozReview-Commit-ID: HfFTlNaPSst", "files": ["toolkit/mozapps/installer/informulate.py", "toolkit/mozapps/installer/packager.mk"], "git_node": null, "git_parents": [null], "node": "499adaff0c575ac0db17a9cb5ef7c8c4457ba591", "parents": ["99307c8739efa4d788300016dbab91eb4d73e947"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1442306 - move make-buildinfo-file and make-mozinfo-file targets inline into make-package target. r=gps\n\nCurrently we have a mess of targets in packager.mk which doesn't really help\nmuch. This patch removes the make-buildinfo-file and make-mozinfo-file targets\nand just puts their commands inline in the make-package target.\n\nMozReview-Commit-ID: 7j83dC4QoZY", "files": ["toolkit/mozapps/installer/packager.mk"], "git_node": null, "git_parents": [null], "node": "fda201833f1d833a9738fd45a68d693d34a90826", "parents": ["499adaff0c575ac0db17a9cb5ef7c8c4457ba591"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1442306 - set MOZ_SOURCE_CHANGESET and MH_BRANCH consistently in the environment for mozharness tasks. r=gps\n\nWe currently set GECKO_HEAD_REV to the revision being built, but the build\nsystem already looks for MOZ_SOURCE_CHANGESET so set that as well. Additionally,\nset MH_BRANCH for mozharness tasks on generic-worker to match docker-worker.\n\nMozReview-Commit-ID: 52B3SSQpSwU", "files": ["taskcluster/taskgraph/transforms/job/mozharness.py"], "git_node": null, "git_parents": [null], "node": "c2ff03aaf40316696aa5d9af4f5fdcf3cc4ed29d", "parents": ["fda201833f1d833a9738fd45a68d693d34a90826"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1442306 - generate a buildhub.json file during packaging. r=gps\n\nbuildhub is a service that stores a list of nightly and release builds and\ncan be queried to find specific builds. Currently it ingests data by scraping\ninfo from ftp.mozilla.org. This patch makes it so we generate a buildhub.json\nduring packaging with the data that buildhub wants.\n\nThere are a few pieces of data that we can't accurately provide from the\nbuild system such as the URL to the build, so we provide some stub data\nthere with the expectation that a release engineering process will fill\nthem in later.\n\nMozReview-Commit-ID: 266BnZZBFoL", "files": ["toolkit/mozapps/installer/informulate.py", "toolkit/mozapps/installer/package-name.mk", "toolkit/mozapps/installer/packager.mk", "toolkit/mozapps/installer/upload-files.mk"], "git_node": null, "git_parents": [null], "node": "c012c6633cf9acecdaa422a45270e8bd0e067937", "parents": ["c2ff03aaf40316696aa5d9af4f5fdcf3cc4ed29d"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1421062: [release] Update secondary balrog tasks to get scopes based on project; r=aki\n\nThis is a follow up to 9c941daebe9fb3e79066ee4def16ed5ce0eb10a9\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1140", "files": ["taskcluster/ci/release-secondary-balrog-scheduling/kind.yml", "taskcluster/ci/release-secondary-balrog-submit-toplevel/kind.yml"], "git_node": null, "git_parents": [null], "node": "d3adeebde3495996e60d07bb07e392e78998a3f0", "parents": ["c012c6633cf9acecdaa422a45270e8bd0e067937"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1458700: [taskgraph] Move `load_graph_config` into `taskgraph.config`; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1123", "files": ["python/mozbuild/mozbuild/mach_commands.py", "taskcluster/taskgraph/actions/registry.py", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/generator.py"], "git_node": null, "git_parents": [null], "node": "169ef85a7eac41c888a8e6b6820ceba9c6488cd2", "parents": ["d3adeebde3495996e60d07bb07e392e78998a3f0"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1458700: [python] Vendor attrs; r=dustin,ted\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1124", "files": ["build/virtualenv_packages.txt", "third_party/python/attrs/.coveragerc", "third_party/python/attrs/.github/CODE_OF_CONDUCT.rst", "third_party/python/attrs/.github/CONTRIBUTING.rst", "third_party/python/attrs/.readthedocs.yml", "third_party/python/attrs/AUTHORS.rst", "third_party/python/attrs/CHANGELOG.rst", "third_party/python/attrs/LICENSE", "third_party/python/attrs/MANIFEST.in", "third_party/python/attrs/PKG-INFO", "third_party/python/attrs/README.rst", "third_party/python/attrs/changelog.d/towncrier_template.rst", "third_party/python/attrs/conftest.py", "third_party/python/attrs/docs/Makefile", "third_party/python/attrs/docs/_static/attrs_logo.png", "third_party/python/attrs/docs/_static/attrs_logo.svg", "third_party/python/attrs/docs/api.rst", "third_party/python/attrs/docs/backward-compatibility.rst", "third_party/python/attrs/docs/changelog.rst", "third_party/python/attrs/docs/conf.py", "third_party/python/attrs/docs/contributing.rst", "third_party/python/attrs/docs/docutils.conf", "third_party/python/attrs/docs/examples.rst", "third_party/python/attrs/docs/extending.rst", "third_party/python/attrs/docs/glossary.rst", "third_party/python/attrs/docs/hashing.rst", "third_party/python/attrs/docs/how-does-it-work.rst", "third_party/python/attrs/docs/index.rst", "third_party/python/attrs/docs/init.rst", "third_party/python/attrs/docs/license.rst", "third_party/python/attrs/docs/overview.rst", "third_party/python/attrs/docs/why.rst", "third_party/python/attrs/moz.yaml", "third_party/python/attrs/pyproject.toml", "third_party/python/attrs/setup.cfg", "third_party/python/attrs/setup.py", "third_party/python/attrs/src/attr/__init__.py", "third_party/python/attrs/src/attr/_compat.py", "third_party/python/attrs/src/attr/_config.py", "third_party/python/attrs/src/attr/_funcs.py", "third_party/python/attrs/src/attr/_make.py", "third_party/python/attrs/src/attr/converters.py", "third_party/python/attrs/src/attr/exceptions.py", "third_party/python/attrs/src/attr/filters.py", "third_party/python/attrs/src/attr/validators.py", "third_party/python/attrs/tests/__init__.py", "third_party/python/attrs/tests/strategies.py", "third_party/python/attrs/tests/test_annotations.py", "third_party/python/attrs/tests/test_config.py", "third_party/python/attrs/tests/test_converters.py", "third_party/python/attrs/tests/test_dark_magic.py", "third_party/python/attrs/tests/test_dunders.py", "third_party/python/attrs/tests/test_filters.py", "third_party/python/attrs/tests/test_funcs.py", "third_party/python/attrs/tests/test_init_subclass.py", "third_party/python/attrs/tests/test_make.py", "third_party/python/attrs/tests/test_slots.py", "third_party/python/attrs/tests/test_validators.py", "third_party/python/attrs/tests/utils.py", "third_party/python/attrs/tox.ini", "third_party/python/moz.build"], "git_node": null, "git_parents": [null], "node": "4b7578e2fe18f88dfc650feb5cf0c2db058b8041", "parents": ["169ef85a7eac41c888a8e6b6820ceba9c6488cd2"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1458700: [release-promotion] Record the root of the graph configuration for use in release promotion; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1125", "files": ["taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/config.py"], "git_node": null, "git_parents": [null], "node": "07a8a1c9de31c54e36c52d906beb3b4fa3e12e76", "parents": ["4b7578e2fe18f88dfc650feb5cf0c2db058b8041"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "No bug: Fix some python linting errors; r=dustin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1127", "files": ["python/mozbuild/mozbuild/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "b7f0f694fe3176934e23205d41b1162c9b52542e", "parents": ["07a8a1c9de31c54e36c52d906beb3b4fa3e12e76"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1458700: Fix flake8 error; r=me", "files": ["taskcluster/taskgraph/config.py"], "git_node": null, "git_parents": [null], "node": "8468d03b8e517eaf03a5bc4d6ae15832331b6317", "parents": ["b7f0f694fe3176934e23205d41b1162c9b52542e"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459077 - Install known working pip and virtualenv; r=ted\n\nPreviously, we installed the latest version of pip and virtualenv.\n\nThis commit pins the pip and virtualenv version so we install known\nworking versions (pip 10 breaks the image build for some reason).\n\nMozReview-Commit-ID: hOAMencdcr", "files": ["taskcluster/docker/recipes/ubuntu1604-test-system-setup.sh"], "git_node": null, "git_parents": [null], "node": "b5a639d810b82ae1885db83b253198f73bfcdbd4", "parents": ["8468d03b8e517eaf03a5bc4d6ae15832331b6317"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1446815 - cleanup in naming beetmover source checksums for consistency. r=tomprince", "files": ["taskcluster/ci/beetmover-release-source-checksums/kind.yml", "taskcluster/ci/post-beetmover-checksums-dummy/kind.yml", "taskcluster/ci/release-beetmover-source-checksums/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/beetmover_source_checksums.py"], "git_node": null, "git_parents": [null], "node": "9db70a54f47cc819736da8b6772ba8f17a8585cb", "parents": ["b5a639d810b82ae1885db83b253198f73bfcdbd4"], "tags": []}, {"author": "Ben Hearsum \u003cbhearsum@mozilla.com\u003e", "branch": "default", "desc": "bug 1455692: add support for limiting locales in partner repacks. r=nthomas", "files": ["taskcluster/ci/release-eme-free-repack/kind.yml", "taskcluster/ci/release-partner-repack/kind.yml", "taskcluster/taskgraph/transforms/partner_repack.py", "testing/mozharness/scripts/desktop_partner_repacks.py"], "git_node": null, "git_parents": [null], "node": "1ccaff5a61624f2e36e68ecdd1c98dd62a980d4a", "parents": ["9db70a54f47cc819736da8b6772ba8f17a8585cb"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1353296 - get rid of filter_upload_symbols. r=dustin\n\nfilter_upload_symbols is a relic of task configurations that were written\nbefore we had a better handle on taskgraph generation. We should only be\nuploading symbols for nightly builds anyway, so this is better served using\nnewer filtering methods.\n\nupload-symbols tasks were specified to run on non-nightly build types in the\nkind.yml, but those were filtered out in filter_upload_symbols. I believe\nthese were simply an artifact of the initial upload-symbols implementation\nhappening before nightly builds were running in Taskcluster.\n\nMozReview-Commit-ID: Je1NytrVPT8", "files": ["taskcluster/ci/upload-symbols/kind.yml", "taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "c23bf868958709b264a0983dd97c4c05e33f400b", "parents": ["1ccaff5a61624f2e36e68ecdd1c98dd62a980d4a"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1437577 - Upload symbols from try server builds to symbols.mozilla.org instead of symbols.stage.mozaws.net. r=peterbe\n\nThe symbol server recently gained the ability to upload symbols from try\nto a different prefix in the symbols bucket. If we change the token stored\nin the Taskcluster secret `project/releng/gecko/build/level-1/gecko-symbol-upload`\nto one that has only \"upload try symbols\" permissions then we can upload\nsymbols from try server builds directly to symbols.mo.\n\nMozReview-Commit-ID: HjQclKKXbA3", "files": ["toolkit/crashreporter/tools/upload_symbols.py"], "git_node": null, "git_parents": [null], "node": "a16b4e2ca19aa905a9993cfd9d2da68a2b02e0e9", "parents": ["c23bf868958709b264a0983dd97c4c05e33f400b"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1437577 - preserve treeherder.platform from job into task. r=dustin\n\nTasks like upload-symbols that have a dependency on a build job want to\ncopy the treeherder.platform from the build job but it gets lost in\nthe task transform currently. This simply copies it into\nan extra.treeherder-platform key to make life easier.\n\nMozReview-Commit-ID: H4PtC4mvIYA", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "c9eae430459f77b1620d5150f6344aef6df12a40", "parents": ["a16b4e2ca19aa905a9993cfd9d2da68a2b02e0e9"], "tags": []}, {"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "bug 1437577 - allow uploading symbols from any build type on try. r=dustin\n\nPreviously we would only generate upload-symbols tasks for nightly builds,\nsince we only want to upload symbols for builds we ship to users.\n\nOn try, developers may want to use the symbol server but very rarely want\nto do nightly builds, so allow uploading symbols from any build type there.\n\nMozReview-Commit-ID: IYs9mZii3DN", "files": ["taskcluster/ci/upload-symbols/kind.yml", "taskcluster/taskgraph/transforms/upload_symbols.py"], "git_node": null, "git_parents": [null], "node": "9158fb59c72769dc27fff1a09334c087a9bd3ea1", "parents": ["c9eae430459f77b1620d5150f6344aef6df12a40"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1403548 - filter out asan on beta+release. r=catlee", "files": ["taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "c9423cd87730524b9d9327ac24c0445f050000c1", "parents": ["9158fb59c72769dc27fff1a09334c087a9bd3ea1"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458855 Change periodic file update reviewers r=asasaki\n\nSummary: Now with correct phabricator usernames\n\nReviewers: aki\n\nReviewed By: aki\n\nBug #: 1458855\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1133", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "7518e46cac11854c2d0ad98780f8830e83c354c7", "parents": ["c9423cd87730524b9d9327ac24c0445f050000c1"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Move run-task into taskcluster/scripts; r=dustin\n\nIn preparation for making it usable on Windows, after which point\nhaving it in a directory with \"docker\" in it doesn't make much sense.\n\nMozReview-Commit-ID: Hgu0buFyJwF", "files": ["taskcluster/docker/debian-base/Dockerfile", "taskcluster/docker/decision/Dockerfile", "taskcluster/docker/desktop1604-test/Dockerfile", "taskcluster/docker/diffoscope/Dockerfile", "taskcluster/docker/image_builder/Dockerfile", "taskcluster/docker/lint/Dockerfile", "taskcluster/docker/recipes/run-task", "taskcluster/docker/update-verify/Dockerfile", "taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/job/run_task.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "f06666dca910618c28bb7600a48d0004bae1539d", "parents": ["7518e46cac11854c2d0ad98780f8830e83c354c7"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Make run-task more runnable on non-POSIX platforms; r=dustin\n\nI want to make run-task work on Windows. The script is currently very\nPOSIX oriented, as it assumes the existence of the grp and pwd modules,\nthat user IDs are numeric, and that system calls like setresgid() and\nsetresuid() are available, etc.\n\nThis commit starts to make some of the POSIX-centric code conditional\non running on POSIX.\n\nCode for uid/gid extraction has been moved to its own function. Some\nerror messages were tweaked slightly as part of the move. Otherwise,\nthe changes should be pretty straightforward.\n\nThere are still other parts of this file that won't work on e.g.\nWindows. But this gets us a big step closer.\n\nMozReview-Commit-ID: HNyytKcBbBo", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "eb44e3c48e6b72483377e9ae1d2d202e9671288f", "parents": ["f06666dca910618c28bb7600a48d0004bae1539d"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Teach run-task where to find Mercurial on Windows; r=dustin\n\nBecause we can't rely on it being in %PATH%.\n\nMozReview-Commit-ID: H6sMdX7XO5Q", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "c024d0795ac074663ac202f619632dfe3c198dd8", "parents": ["eb44e3c48e6b72483377e9ae1d2d202e9671288f"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Move closure to module-level function; r=dustin\n\nMozReview-Commit-ID: 2Z2qL8LaEno", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "a61b0a17c8d7faf49decb2418c4c48783a86e979", "parents": ["c024d0795ac074663ac202f619632dfe3c198dd8"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Require to run on root on POSIX platforms; r=dustin\n\nThe code for cache and volume normalization makes assumptions that uid\nand gid are defined. They are not defined if not running as root and\nPython would crash in these code paths.\n\nSo, presumably this means that all tasks using run-task are running as\nroot. Let's codify that requirement.\n\nThis requirement is arbitrary. But let's not scope bloat run-task to\nsupport scenarios until we need them.\n\nMozReview-Commit-ID: 2uW4OSovzWi", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "61f4e86cf4dda449c40367b0965e7fafeab1af80", "parents": ["a61b0a17c8d7faf49decb2418c4c48783a86e979"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Move cache configuration to standalone function; r=dustin\n\nmain() is quite long. And the control flow will become more complicated\nas we support Windows.\n\nLet's move the bulk of the cache configuration code into a standalone\nfunction so main() is less cluttered.\n\nMozReview-Commit-ID: xredCubr1E", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "19c305b5e7ad97bd4e684e5f921c2b98c0de6420", "parents": ["61f4e86cf4dda449c40367b0965e7fafeab1af80"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Move volume configuration to standalone function; r=dustin\n\nDo to volumes what we did to caches.\n\nMozReview-Commit-ID: 7s4nYPC27nk", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "517056cfe87ff8c602e4a6066782f8a60e2f6473", "parents": ["19c305b5e7ad97bd4e684e5f921c2b98c0de6420"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Assert that volumes aren't used on Windows; r=dustin\n\nVolumes are a docker-worker concept. They shouldn't be encountered on\nWindows, which uses generic-worker.\n\nMozReview-Commit-ID: KUdSxVHVJQ", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "288c7384afc5856977cfb614d4a4f5c727742d45", "parents": ["517056cfe87ff8c602e4a6066782f8a60e2f6473"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459737 - Add missing package dependencies to google-play-strings Dockerfile; r=nalexander CLOSED TREE\n\nThis Dockerfile downloads non-deterministic remote content (by cloning a\nGit repo) and then executes code from it. Part of that code is\nexecuting Python package installs.\n\nSince this Docker image was generated, it appears the remote code\nrequires new build dependencies. This commit adds those package\ndependencies.\n\nNot having deterministic Docker image builds is a bug. I'll file a\nfollow-up so we pin the Git commit used for building so this type\nof failure doesn't occur again.", "files": ["taskcluster/docker/google-play-strings/Dockerfile"], "git_node": null, "git_parents": [null], "node": "edc68b8681576350499a4c1d3ea85ca10d262b29", "parents": ["288c7384afc5856977cfb614d4a4f5c727742d45"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458854 Disable release_eta for rc on beta channel r=bhearsum\n\nSummary:\nIn essence, we're allowing a new field in the task definition,\nwhich is trusted over the one that's passed in with the config. This\nwouldn't make much sense if it had a real date in, but allows us to\nset an empty string for the kind that needs it\n\nReviewers: bhearsum\n\nReviewed By: bhearsum\n\nBug #: 1458854\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1214", "files": ["taskcluster/ci/release-secondary-balrog-scheduling/kind.yml", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "ba29ece3ef471c98a4c6fa830b85027610bb8f94", "parents": ["edc68b8681576350499a4c1d3ea85ca10d262b29"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1457034 - re-add partner github code. r=nthomas\n\nWe originally had this logic here, and called it from the `partner_repack` transform. This kept the config more hidden, but had the downsides of a) being difficult to test, and b) hitting the network during transforms, which we're trying to avoid.\n\nWe moved this code to release-runner3, and passed in the `release_partner_config` as input, and saved it as a parameter. Parameterizing the partner config means that we can refer to it easily throughout taskgraph generation and in local testing, and we don't have to hit the network during transforms. The downsides include potentially having to generate this config in multiple places (rr3, ship-it-v2, the partner hook), and risking hitting the 20k gpg cleartext character limit in the `ACTION_INPUT` environment variable.\n\nNow I'm moving this code back into util.partners, but I'm calling it from the action, not from the transform. The action populates the `release_partner_config` parameter, so we can still access the config from anywhere in the taskgraph generation code, more easily test, and avoid hitting the network during transforms. It also means that release-runner3, ship-it-v2, and the partner hook can all use the partner config generation code from a single location, rather than having to duplicate it.\n\nHoping this is the last major change we need to make here for a while.\n\nMozReview-Commit-ID: 8UmvmcAoZgD", "files": ["taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "b9cd43ff425fef8d19a58c1596c92224f7248b18", "parents": ["ba29ece3ef471c98a4c6fa830b85027610bb8f94"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1457034 - generate `release_partner_config` in `release_promotion` r=nthomas\n\nIf we're not passed `release_partner_config` in the input, let's poll github for it in the action.\n\nMozReview-Commit-ID: 2swx76vhTE5", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/release-eme-free-repack/kind.yml", "taskcluster/ci/release-partner-repack/kind.yml", "taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/partner_repack.py", "taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "9378e5ad8c687040d8da829de898aff31ac020a3", "parents": ["b9cd43ff425fef8d19a58c1596c92224f7248b18"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1457034 - populate release_partner_build_number. r=nthomas\n\nMozReview-Commit-ID: EC4jHIwBWWb", "files": ["taskcluster/taskgraph/actions/release_promotion.py"], "git_node": null, "git_parents": [null], "node": "7ad06a0e62f6268093a782e38134aa8c062120d5", "parents": ["9378e5ad8c687040d8da829de898aff31ac020a3"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460451 - Add /usr/bin/python3 to Debian images; r=glandium\n\nThe python3-minimal package provides /usr/bin/python3 on Debian.\n\nThis commit installs this package so a `python3` executable is\nprovided.\n\nThis required backporting the package to wheezy. The final patch\nis trivial. But I wasted a bit of time figuring out why `mk-build-deps`\nwasn't working. It would no-op and exit 0 and then the build would\ncomplain about missing dependencies!\n\nglandium's theory is that the \":any\" multiarch support on wheezy\nisn't complete. Removing \":any\" seems to make things \"just work.\"\n\nMozReview-Commit-ID: FBicpK4SmkQ", "files": ["build/debian-packages/python3-defaults-wheezy.diff", "taskcluster/ci/docker-image/kind.yml", "taskcluster/ci/packages/kind.yml", "taskcluster/docker/debian-base/Dockerfile"], "git_node": null, "git_parents": [null], "node": "5af8c37f769f7333ea664f2f1882da15d97623f8", "parents": ["7ad06a0e62f6268093a782e38134aa8c062120d5"], "tags": []}, {"author": "Chris AtLee \u003ccatlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237182: Removing unused buildbot support r=Callek\n\nMozReview-Commit-ID: EjclZgc864L", "files": ["taskcluster/ci/test/compiled.yml", "taskcluster/ci/test/marionette.yml", "taskcluster/ci/test/misc.yml", "taskcluster/ci/test/mochitest.yml", "taskcluster/ci/test/reftest.yml", "taskcluster/ci/test/talos.yml", "taskcluster/ci/test/web-platform.yml", "taskcluster/ci/test/xpcshell.yml", "taskcluster/taskgraph/transforms/job/mozharness_test.py", "taskcluster/taskgraph/transforms/tests.py", "testing/mozharness/configs/android/android_common.py", "testing/mozharness/configs/builds/releng_base_android_64_builds.py", "testing/mozharness/configs/builds/releng_base_linux_32_builds.py", "testing/mozharness/configs/builds/releng_base_linux_64_builds.py", "testing/mozharness/configs/builds/releng_base_mac_64_cross_builds.py", "testing/mozharness/configs/builds/releng_base_windows_32_mingw_builds.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_artifact.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_debug_artifact.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_artifact.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_debug_artifact.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_source.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_stat_and_opt.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_artifact.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_debug_artifact.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_debug.py", "testing/mozharness/configs/marionette/prod_config.py", "testing/mozharness/configs/marionette/windows_config.py", "testing/mozharness/configs/multi_locale/ash_android-x86.json", "testing/mozharness/configs/multi_locale/ash_android.json", "testing/mozharness/configs/multi_locale/jamun_android-armv6.json", "testing/mozharness/configs/multi_locale/jamun_android-x86.json", "testing/mozharness/configs/multi_locale/jamun_android.json", "testing/mozharness/configs/multi_locale/mozilla-aurora_android-armv6.json", "testing/mozharness/configs/multi_locale/mozilla-aurora_android-x86.json", "testing/mozharness/configs/multi_locale/mozilla-aurora_android.json", "testing/mozharness/configs/multi_locale/mozilla-beta_android-armv6.json", "testing/mozharness/configs/multi_locale/mozilla-beta_android-x86.json", "testing/mozharness/configs/multi_locale/mozilla-beta_android.json", "testing/mozharness/configs/multi_locale/mozilla-central_android-armv6.json", "testing/mozharness/configs/multi_locale/mozilla-central_android-x86.json", "testing/mozharness/configs/multi_locale/mozilla-central_android.json", "testing/mozharness/configs/multi_locale/mozilla-release_android-armv6.json", "testing/mozharness/configs/multi_locale/mozilla-release_android-x86.json", "testing/mozharness/configs/multi_locale/mozilla-release_android.json", "testing/mozharness/configs/multi_locale/release_mozilla-beta_android-armv6.json", "testing/mozharness/configs/multi_locale/release_mozilla-beta_android-x86.json", "testing/mozharness/configs/multi_locale/release_mozilla-beta_android.json", "testing/mozharness/configs/multi_locale/release_mozilla-release_android-armv6.json", "testing/mozharness/configs/multi_locale/release_mozilla-release_android-x86.json", "testing/mozharness/configs/multi_locale/release_mozilla-release_android.json", "testing/mozharness/configs/multi_locale/staging_release_mozilla-beta_android-armv6.json", "testing/mozharness/configs/multi_locale/staging_release_mozilla-beta_android-x86.json", "testing/mozharness/configs/multi_locale/staging_release_mozilla-beta_android.json", "testing/mozharness/configs/multi_locale/staging_release_mozilla-release_android-armv6.json", "testing/mozharness/configs/multi_locale/staging_release_mozilla-release_android-x86.json", "testing/mozharness/configs/multi_locale/staging_release_mozilla-release_android.json", "testing/mozharness/configs/partner_repacks/release_mozilla-release_android.py", "testing/mozharness/configs/partner_repacks/staging_release_mozilla-release_android.py", "testing/mozharness/configs/releases/updates_firefox_devedition.py", "testing/mozharness/configs/single_locale/ash_android-api-16.py", "tes