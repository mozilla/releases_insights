r_BUILD1", "FIREFOX_78_10_1esr_RELEASE"]}], "date": 1620049371, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "249": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f685975ba5576001483e5521e06d5a0ccf9b5f54 with FIREFOX_78_10_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "cea2588f229c6daa75d0547dce3e3e5693bf3e11", "parents": ["2d975d84500496300e142762360dc84b324499ec"], "tags": []}], "date": 1620060820, "git_changesets": [null], "user": "ffxbld"}, "250": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f685975ba5576001483e5521e06d5a0ccf9b5f54 with FIREFOX_78_10_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "1318b22a90e940b27446505410800b00c5c5c5f4", "parents": ["cea2588f229c6daa75d0547dce3e3e5693bf3e11"], "tags": []}], "date": 1620136820, "git_changesets": [null], "user": "ffxbld"}, "251": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114491", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "245b151ba9a48525d6f8de4819bbca1fa2bd5169", "parents": ["1318b22a90e940b27446505410800b00c5c5c5f4"], "tags": []}], "date": 1620308041, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "252": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1706056 - increase the parallelism of getHSTSPreloadList.js r=releng-reviewers,jmaher a=release\n\nBefore this patch, getHSTSPreloadList.js would have no more than 250 requests\nin flight at any given time. In the past, this limit was 500. After a refactor\nthat inadvertantly completely removed the limit, it was reduced to 250.\nPresumably increasing it to 500 again will not have negative effects and will\nallow the script to run faster.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114019", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": null, "git_parents": [null], "node": "405eaeaadb98a160c609362aa10cef0ef00fb745", "parents": ["245b151ba9a48525d6f8de4819bbca1fa2bd5169"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1706056 - reduce max-run-time for repo-update task. r=RyanVM,releng-reviewers,bhearsum a=release DONTBUILD\n\nNow that getHSTSPreloadList.js runs with increased parallelism, it goes\nmuch faster and we don't need to let the task run for 6 hours.\n\nThe timeout was 3 hours for a while, then bumped to 5 hours in bug\n1570646, then to 6 hours in bug 1705639 (with 250 in-flight requests).\nThe new run time with 500 in-flight requests seems to be around 2.5\nhours, so pick 4 hours as a compromise.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114496", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "1d47c7b0d2d0e3961f44e2a00cb2a5553642f2e9", "parents": ["405eaeaadb98a160c609362aa10cef0ef00fb745"], "tags": []}], "date": 1620642708, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}, "253": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114741", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "2720ad803341048f27131bf113f63a8a2170f248", "parents": ["1d47c7b0d2d0e3961f44e2a00cb2a5553642f2e9"], "tags": []}], "date": 1620652260, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "254": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115052", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ae6799f9b325b5b30289f074b8fba8486b1e36e4", "parents": ["2720ad803341048f27131bf113f63a8a2170f248"], "tags": []}, {"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1706041 - Reset gDllServices when DllServices is destroyed. r=aklotz, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113524", "files": ["mozglue/dllservices/WindowsDllBlocklist.cpp", "toolkit/xre/WinDllServices.cpp", "toolkit/xre/WinDllServices.h"], "git_node": null, "git_parents": [null], "node": "b527fc1610192d2d16d08c843734e2d7c1bac665", "parents": ["ae6799f9b325b5b30289f074b8fba8486b1e36e4"], "tags": []}, {"author": "Marco Trevisan (Trevi\u00f1o) \u003cmail@3v1n0.net\u003e", "branch": "default", "desc": "Bug 1644600 - Move JSStructuredCloneData destructor into private impl. r=sfink, a=RyanVM\n\nThis is using js::SharedArrayRawBufferRefs that is a private API and not\nexported. Leaving it in the header makes linking not to work when using\nStructuredClone:\n\n  JSStructuredCloneData::~JSStructuredCloneData()':\n    /usr/include/mozjs-78/js/StructuredClone.h:459:\n    undefined reference to\n    `js::SharedArrayRawBufferRefs::~SharedArrayRawBufferRefs()\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114128", "files": ["js/public/StructuredClone.h", "js/src/vm/StructuredClone.cpp"], "git_node": null, "git_parents": [null], "node": "2abc0a4645aa6afb7aa55a52d8f7b5baf6823f85", "parents": ["b527fc1610192d2d16d08c843734e2d7c1bac665"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1708527 - Enable gfx and layers prefs via policy. r=jrmuizel a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113848", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "88c22fc68cbff697ba630f86de0484484346075c", "parents": ["2abc0a4645aa6afb7aa55a52d8f7b5baf6823f85"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1674943. Ensure the CStrings live long enough. r=glandium, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D95643", "files": ["gfx/webrender_bindings/src/bindings.rs"], "git_node": null, "git_parents": [null], "node": "6f6fabf77ee884ed16813e1f1de6cda39091667d", "parents": ["88c22fc68cbff697ba630f86de0484484346075c"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1705372 - Add new Amazon search engine definitions. r=daleharvey, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113397", "files": ["CLOBBER", "browser/components/search/extensions/amazon/_locales/mx/messages.json", "browser/components/search/extensions/amazon/_locales/spain/messages.json", "browser/components/search/extensions/amazon/_locales/sweden/messages.json", "browser/components/search/extensions/amazon/manifest.json"], "git_node": null, "git_parents": [null], "node": "6cdaa8e2957b3761af89872ebe77f4f2cfa40df9", "parents": ["6f6fabf77ee884ed16813e1f1de6cda39091667d"], "tags": []}], "date": 1620933546, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "255": {"changesets": [{"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 1559448 - Move Thunderbird primary password prompt earlier in start-up. r=kaie,mccr8 a=RyanVM\n\nTriggering the password prompt after the Add-Ons Manager start-up is causing the latter to fail.\n\nI'm not sure if something needs to be unlocked by the password, or if the existence of the prompt is causing some bad interaction, but prompting slightly earlier appears to fix it.", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsXREDirProvider.cpp"], "git_node": null, "git_parents": [null], "node": "04e1fdae7185ad84fa6184f1284b0e175d653dc2", "parents": ["6cdaa8e2957b3761af89872ebe77f4f2cfa40df9"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1694008 - add null check for getting nsIPK11TokenDB service (to prevent crash). r=kaie,sg a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D109055", "files": ["toolkit/xre/nsXREDirProvider.cpp"], "git_node": null, "git_parents": [null], "node": "5cd29d2ca2c7bdf986c8be7225d460275ae08318", "parents": ["04e1fdae7185ad84fa6184f1284b0e175d653dc2"], "tags": []}, {"author": "Emilio Cobos Alvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1702964 - Remove workaround for bug that's fixed. r=jaws, a=RyanVM\n\nAnd which causes text to be invisible in high contrast mode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D112368", "files": ["browser/components/aboutlogins/content/components/login-list.css"], "git_node": null, "git_parents": [null], "node": "ce31e18faa0955d1cf22b434661e12be447f3830", "parents": ["5cd29d2ca2c7bdf986c8be7225d460275ae08318"], "tags": []}, {"author": "Chris Martin \u003ccmartin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1701570 - Use NSPR threads instead of std::thread in RemoteBackBuffer. r=gerald, a=RyanVM\n\nIt appears there are situations where a new thread may not be able to\ninitialize, causing stdlib to throw a C++ exception (which we don't allow\nor handle).\n\nThis changes RemoteBackbuffer to use NSPR threads and handle the error via the\nreturn code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113576", "files": ["widget/windows/RemoteBackbuffer.cpp", "widget/windows/RemoteBackbuffer.h"], "git_node": null, "git_parents": [null], "node": "cf2bf2c5713983a1326b89e76c86a395ff5a9fcf", "parents": ["ce31e18faa0955d1cf22b434661e12be447f3830"], "tags": []}, {"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1706501 - Make HandleCommandLine take nsACString. r=mossop, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114691", "files": ["toolkit/components/remote/nsWinRemoteServer.cpp"], "git_node": null, "git_parents": [null], "node": "80e97d09f4228dd90ef55ae0bc430df51702919d", "parents": ["cf2bf2c5713983a1326b89e76c86a395ff5a9fcf"], "tags": []}], "date": 1621000022, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "256": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115197", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "db14795490cbc726b125565abe2dd368b18b5898", "parents": ["80e97d09f4228dd90ef55ae0bc430df51702919d"], "tags": []}], "date": 1621255364, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "257": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115587", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ca6854cb2931d4f1fd605612fb716193ba31a51e", "parents": ["db14795490cbc726b125565abe2dd368b18b5898"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "bug 1612116 - turn NSS not setting an error code into SEC_ERROR_LIBRARY_FAILURE. r=bbeurdouche, a=jcristau\n\nSometimes SSL_ForceHandshake will return SECFailure without setting an error\ncode. When this happens, calling GetXPCOMFromNSSError on that not-an-error-code\nwill fail. This patch first checks for this situation and substitutes\nSEC_ERROR_LIBRARY_FAILURE if applicable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114908", "files": ["security/manager/ssl/nsNSSIOLayer.cpp"], "git_node": null, "git_parents": [null], "node": "37780929b65dbe29160a0187acb32e3a535779d9", "parents": ["ca6854cb2931d4f1fd605612fb716193ba31a51e"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1711504 - Update Amazon au search definition. r=daleharvey, a=jcristau", "files": ["browser/components/search/extensions/amazon/_locales/au/messages.json", "toolkit/components/search/tests/xpcshell/searchconfigs/test_amazon.js"], "git_node": null, "git_parents": [null], "node": "793689ead561821b7838d9e4eef4953ca6402182", "parents": ["37780929b65dbe29160a0187acb32e3a535779d9"], "tags": []}], "date": 1621515260, "git_changesets": [null, null, null], "user": "jcristau@mozilla.com"}, "258": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115802", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "b8a17b516a70f620a56fbd74226512609626832b", "parents": ["793689ead561821b7838d9e4eef4953ca6402182"], "tags": []}], "date": 1621861599, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "259": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1712150 - take branches into account in release-started email notification. r=aki, a=RyanVM\n\nInstead of using the pushlog, grab the hg log using a revset to avoid\nbeing confused by branches: we're looking for revisions that are\nancestors of the new revision but not of the previous tag, i.e.\n\"current % previous\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115624", "files": ["python/mozrelease/mozrelease/buglist_creator.py", "python/mozrelease/test/data/buglist_changesets.json"], "git_node": null, "git_parents": [null], "node": "07bb07cd400f4b9f764e496ba8e7b2bd510b5b70", "parents": ["b8a17b516a70f620a56fbd74226512609626832b"], "tags": []}], "date": 1621863315, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "260": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1712297 - Hide pinned search shortcut when its engine gets removed/hidden. r=Standard8 a=pascalc", "files": ["browser/components/newtab/lib/SearchShortcuts.jsm", "browser/components/newtab/lib/TopSitesFeed.jsm"], "git_node": null, "git_parents": [null], "node": "58d0b007bcedce2d87978431d472b1d81308ff36", "parents": ["07bb07cd400f4b9f764e496ba8e7b2bd510b5b70"], "tags": ["FIREFOX_78_11_0esr_BUILD1"]}], "date": 1621873769, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "261": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 58d0b007bcedce2d87978431d472b1d81308ff36 with FIREFOX_78_11_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "392647f7f1ee97f1d5d19265917edffdf7e94d53", "parents": ["58d0b007bcedce2d87978431d472b1d81308ff36"], "tags": []}], "date": 1621875115, "git_changesets": [null], "user": "ffxbld"}, "262": {"changesets": [{"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1709851 - Update fallback GMP downloader for Widevine 4.10.2209.1. r=mjf, a=RyanVM\n\nUpdate the GMP fallback downloader for Widevine to reference the 4.10.2209.1\nCDM. This keeps the fallback URLs in step with Balrog.\n\nAdd the aarch64/arm64 entry for the new Apple Silicone CDM to the fallback.\n\nReorder the json file so it matches the ordering used by balrog so it's easier\nto eyeball and diff the files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D114529", "files": ["toolkit/content/gmp-sources/widevinecdm.json"], "git_node": null, "git_parents": [null], "node": "b3b0de11433e8da72deea0dcb25737ace6268e6f", "parents": ["392647f7f1ee97f1d5d19265917edffdf7e94d53"], "tags": []}], "date": 1621875818, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "263": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D116092", "files": ["services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "59c418920b54a46e10eef94d09c511c3643600e4", "parents": ["b3b0de11433e8da72deea0dcb25737ace6268e6f"], "tags": []}], "date": 1622127558, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "264": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1713497 - work around wpt manifest issue. a=test-only", "files": ["testing/web-platform/manifestdownload.py"], "git_node": null, "git_parents": [null], "node": "01d6500ecb254baea73ebad2fb3d29f182046952", "parents": ["59c418920b54a46e10eef94d09c511c3643600e4"], "tags": ["FIREFOX_78_11_0esr_BUILD2", "FIREFOX_78_11_0esr_RELEASE"]}], "date": 1622470142, "git_changesets": [null], "user": "jcristau@mozilla.com"}}
}";