[]}], "date": 1619099441, "git_changesets": [null, null, null, null, null], "user": "jcristau@mozilla.com"}, "243": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1679826 - Fix the test for Firefox 78. a=test-only", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_extensionsettings2.js"], "git_node": null, "git_parents": [null], "node": "aaa3cc84d6fc6323fb9a2114e31318360f08a868", "parents": ["20a68b9d0207e3d80a90f8f32cd6204f817da2e4"], "tags": []}], "date": 1619106886, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "244": {"changesets": [{"author": "Narcis Beleuzu \u003cnbeleuzu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1679826 - Fix lint failure a=lint-fix", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_extensionsettings2.js"], "git_node": null, "git_parents": [null], "node": "2aabcd7ea37d3a5fcc94cf2d29f3a98ea7e7dcf7", "parents": ["aaa3cc84d6fc6323fb9a2114e31318360f08a868"], "tags": []}], "date": 1619293753, "git_changesets": [null], "user": "nbeleuzu@mozilla.com"}, "245": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113336", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "b57de77ce279af7c3b4f067a072ba19ddaba5242", "parents": ["2aabcd7ea37d3a5fcc94cf2d29f3a98ea7e7dcf7"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1704850 - Update Amazon deployments. r=daleharvey, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113141", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_amazon.js"], "git_node": null, "git_parents": [null], "node": "ffc0618e5350338385794ded6e04bd3a295536ea", "parents": ["b57de77ce279af7c3b4f067a072ba19ddaba5242"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1706717 - Update Canonical distribution settings. r=mkaply, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113183", "files": ["toolkit/components/search/tests/xpcshell/test_distributions.js"], "git_node": null, "git_parents": [null], "node": "410f1560869ba12b9bf733cb378d2e0e4c3da96b", "parents": ["ffc0618e5350338385794ded6e04bd3a295536ea"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1704722 - Tidy up confusion around jit entry/exit generation. r=rhunt, a=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D112333", "files": ["js/src/wasm/WasmCode.cpp", "js/src/wasm/WasmCode.h", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmStubs.cpp"], "git_node": null, "git_parents": [null], "node": "f326cd8f9f19a8f3b5edf9d6838fdce5b02d9c64", "parents": ["410f1560869ba12b9bf733cb378d2e0e4c3da96b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1680166 - Return EFAULT when given a null path to stat* calls in the sandbox filter. r=gcp, a=RyanVM\n\nIt's a common way to check the existence of system calls. Glibc may fall\nback to fstatat when statx is called, passing down the null path.\n\nSince we handle fstatat, let's return -EFAULT the same way the real\nfstatat syscall would do.\n\nThis is needed for the sandbox not to constantly crash due to this statx\ncall in rustc:\n\nhttps://github.com/rust-lang/rust/blob/09c9c9f7da72b774cc445c0f56fc0b9792a49647/library/std/src/sys/unix/fs.rs#L119-L123\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98414", "files": ["security/sandbox/linux/SandboxBrokerClient.cpp", "security/sandbox/linux/SandboxFilter.cpp", "security/sandbox/linux/gtest/TestBroker.cpp"], "git_node": null, "git_parents": [null], "node": "ff436849850a87dfa3db032e80eaba5e5a3536f4", "parents": ["f326cd8f9f19a8f3b5edf9d6838fdce5b02d9c64"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1680166 - GCC is smarter than clang, so ignore the warning properly. a=RyanVM", "files": ["security/sandbox/linux/gtest/TestBroker.cpp"], "git_node": null, "git_parents": [null], "node": "8aa3952dd7208d96648ea171f814c748ec027630", "parents": ["ff436849850a87dfa3db032e80eaba5e5a3536f4"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1703191. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D113201", "files": ["ipc/glue/GeckoChildProcessHost.cpp"], "git_node": null, "git_parents": [null], "node": "0c2865c2251ac8cba28d84c1165638fb0bd95c5f", "parents": ["8aa3952dd7208d96648ea171f814c748ec027630"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1703760 - Fix invalid early return in BaselineFrame::trace. r=tcampbell, a=RyanVM\n\nWe were not tracing debugger environments for Baseline frames without any local/expression slots.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D112741", "files": ["js/src/jit-test/tests/debug/bug1703760.js", "js/src/jit/BaselineFrame.cpp"], "git_node": null, "git_parents": [null], "node": "b203605dcd4bec5d95b1d5b5f70a0b1b7c91ab7f", "parents": ["0c2865c2251ac8cba28d84c1165638fb0bd95c5f"], "tags": []}, {"author": "Kirk Steuber \u003cksteuber@mozilla.com\u003e", "branch": "default", "desc": "Bug 1690062 - r=agashlin, a=RyanVM\n\nDifferential Revision: https:/