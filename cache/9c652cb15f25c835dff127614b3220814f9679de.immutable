], "node": "324ab451710ee6b232185bebd7bf6621c7aa3dde", "parents": ["842ab8d9394a22d69da92d1133bb8a0b6f0e8d5f"], "tags": []}], "date": 1653007463, "git_changesets": [null], "user": "ffxbld"}, "267": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 262b3b86a564b17e3397b519488698bc530f0858 with FIREFOX_91_9_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "72776010860b468ec93fae5731f4c080d8f30fb3", "parents": ["324ab451710ee6b232185bebd7bf6621c7aa3dde"], "tags": []}], "date": 1653053042, "git_changesets": [null], "user": "ffxbld"}, "268": {"changesets": [{"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1769759 - Update extension ID for rust-analyzer vscode extension recommendation. r=andi, a=NPOTB\n\nDifferential Revision: https://phabricator.services.mozilla.com/D146576", "files": [".vscode/extensions.json"], "git_node": null, "git_parents": [null], "node": "d07ff56abf59e056728e4089f78b7794aa5a84c4", "parents": ["72776010860b468ec93fae5731f4c080d8f30fb3"], "tags": []}, {"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1769572 - [devtools] The CONNECT method should no longer be sent on request resend. r=nchevobbe, a=RyanVM\n\nThe CONNECT method sent on Edit & Resend of certain requests crashes firefox\nbased on https://bugzilla.mozilla.org/show_bug.cgi?id=1769572#c2, Necko uses CONNECT in a special way, so lets restrict\nthe devtools from selecting and sending it.\n\nThe crash happens with both the current and new edit and resend panels, so this patch\nneeds to be tested for both.\n\nUse the devtools.netmonitor.features.newEditAndResend and set it to true to enable the new edit and resend panel.\n\nNote: The new edit and resend panel is enabled by default in Nightly.\n\nSee https://bugzilla.mozilla.org/show_bug.cgi?id=1769572#c0 for the STR for the current Edit and Resend panel\nSee https://bugzilla.mozilla.org/show_bug.cgi?id=1769572#c7 for the STR for the new Edit and Resend", "files": ["devtools/server/actors/network-monitor/network-content.js"], "git_node": null, "git_parents": [null], "node": "ec18cb3ff9a754173d778e26e5bede8105301d88", "parents": ["d07ff56abf59e056728e4089f78b7794aa5a84c4"], "tags": []}, {"author": "Dennis Jackson \u003cdjackson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1770397 - land NSS NSS_3_68_4_RTM UPGRADE_NSS_RELEASE. r=jschanck, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D146905", "files": ["security/nss/TAG-INFO", "security/nss/cmd/smimetools/cmsutil.c", "security/nss/coreconf/coreconf.dep", "security/nss/lib/nss/nss.h", "security/nss/lib/smime/cmsdigest.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "60d6f7a293bd5218fe254f766782c98a916e67e6", "parents": ["ec18cb3ff9a754173d778e26e5bede8105301d88"], "tags": []}], "date": 1653078241, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "269": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147075", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6f720d9434addf56417c7b6ec17782c0daccf108", "parents": ["60d6f7a293bd5218fe254f766782c98a916e67e6"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1768734 - Make sure JS holders are cleared before a shutdown GC. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D14707