"pushes": {"243": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 3bde71d19b45fab43d38764d7adbde25902fbb43 with FIREFOX_91_9_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "91400d0d688ef1ec89ce575d6341da6816302b9f", "parents": ["3bde71d19b45fab43d38764d7adbde25902fbb43"], "tags": []}], "date": 1651002516, "git_changesets": [null], "user": "ffxbld"}, "244": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D144936", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/password-rules.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "eb7d2d173c5b5c0657081dcbfc8a17d74a7ca781", "parents": ["91400d0d688ef1ec89ce575d6341da6816302b9f"], "tags": []}], "date": 1651165041, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "245": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145222", "files": ["netwerk/dns/effective_tld_names.dat", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "8dcdba96da467f1240a18c7565300a9a26cd7017", "parents": ["eb7d2d173c5b5c0657081dcbfc8a17d74a7ca781"], "tags": []}], "date": 1651495855, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "246": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "c7b1504489a3864bca95dadb6d1c674f69013e45", "parents": ["8dcdba96da467f1240a18c7565300a9a26cd7017"], "tags": []}], "date": 1651511230, "git_changesets": [null], "user": "ffxbld-merge"}, "247": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 3bde71d19b45fab43d38764d7adbde25902fbb43 with FIREFOX_91_9_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "1db76c301268da75dcef9a8dad0946ccfac6c492", "parents": ["c7b1504489a3864bca95dadb6d1c674f69013e45"], "tags": []}], "date": 1651580545, "git_changesets": [null], "user": "ffxbld"}, "248": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145552", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "78df931132de827dac98cb66267e8de2697839e4", "parents": ["1db76c301268da75dcef9a8dad0946ccfac6c492"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1759196 - Fix the Linux sandbox's handling of 32-bit arguments on 64-bit platforms. r=gcp,bobowen a=RyanVM\n\nBackground: When 32-bit types are passed in registers on x86-64 (and\nprobably other platforms?), the function call ABI does not specify the\ncontents of the upper half, and the Linux kernel syscall ABI appears to\nhave the same behavior.\n\nIn practice, the upper half is usually zero (or maybe sign-extended from\nthe lower half), because 64-bit operations aren't cheaper than 32-bit,\nand 32-bit operations zero-extend their outputs; therefore, this case\nusually doesn't happen in the first place, and any kind of spill or\nregister move will zero the upper half.  However, arbitrary values are\npossible, and a case like this has occurred with the Firefox profiler\nusing `clock_gettime`.  (This paragraph is applicable to x86-64 and\nARM64; other 64-bit architecutures may behave differently.)\n\nBut the Chromium seccomp-bpf compiler, when testing the value of a 32-bit\nargument on a 64-bit platform, requires that the value be zero-extended\nor sign-extended, and (incorrectly, as far as I can tell) considers\nanything else an ABI violation.\n\nWith this patch, when that case is detected, we use the `SIGSYS` handler\nto zero-extend the problematic argument and re-issue the syscall.\n\n(It would also be possible to just ignore the upper half, and that would\nbe faster, but that could lead to subtle security holes if the type\nused in `bpf_dsl` is incorrect and the kernel really does treat it as\n64-bit.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D144643", "files": ["security/sandbox/chromium-shim/patches/after_update/linux_32bit_arg_fixup.patch", "security/sandbox/chromium-shim/patches/after_update/patch_order.txt", "security/sandbox/chromium/sandbox/linux/bpf_dsl/policy_compiler.cc", "security/sandbox/chromium/sandbox/linux/bpf_dsl/policy_compiler.h", "security/sandbox/common/test/SandboxTestingChildTests.h", "security/sandbox/linux/SandboxFilter.cpp"], "git_node": null, "git_parents": [null], "node": "f3b52baf87fa39c54da80065f88a8222b6c1fd7f", "parents": ["78df931132de827dac98cb66267e8de2697839e4"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1735923 - Error on opacity change. r=edenchuang, a=RyanVM", "files": ["dom/media/ChannelMediaResource.cpp", "dom/media/ChannelMediaResource.h"], "git_node": null, "git_parents": [null], "node": "dfc94f10465c24db999f4b2af7bcd0535812b9ce", "parents": ["f3b52baf87fa39c54da80065f88a8222b6c1fd7f"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1756388; r=smaug, a=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D144193", "files": ["browser/actors/DOMFullscreenParent.jsm", "browser/base/content/browser-fullScreenAndPointerLock.js"], "git_node": null, "git_parents": [null], "node": "b25038f89d63a1eb88b6a90909161520e4f79090", "parents": ["dfc94f10465c24db999f4b2af7bcd0535812b9ce"], "tags": []}], "date": 1651758971, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "249": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset dfc94f10465c (bug 1735923) for test_midflight_redirect_blocked.html failures.", "files": ["dom/media/ChannelMediaResource.cpp", "dom/media/ChannelMediaResource.h"], "git_node": null, "git_parents": [null], "node": "c5fe204aa88c475fcea7e59cf34b1899bb3d6776", "parents": ["b25038f89d63a1eb88b6a90909161520e4f79090"], "tags": []}], "date": 1651764036, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "250": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1764515 Remove \"media.block-midflight-redirects\" pref. r=padenot, a=RyanVM\n\nThe \"media.block-midflight-redirects\" was added to verify that test videos\nplay without the blocking,\nhttps://hg.mozilla.org/integration/mozilla-inbound/rev/d8c358ea16eb\nbut we have CORS for that.\n\nThe behavior of the code is easier to follow without the different paths from\nthe pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143572", "files": ["dom/media/ChannelMediaDecoder.cpp", "dom/media/test/test_midflight_redirect_blocked.html"], "git_node": null, "git_parents": [null], "node": "442ee1b4a98f8920f3d1529be6be7c5baf7ab1dd", "parents": ["c5fe204aa88c475fcea7e59cf34b1899bb3d6776"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1735923 - Error on opacity change. r=edenchuang, a=RyanVM", "files": ["dom/media/ChannelMediaResource.cpp", "dom/media/ChannelMediaResource.h"], "git_node": null, "git_parents": [null], "node": "9f143c561b4bc59fe81c8770c7dc582a61b7dcc3", "parents": ["442ee1b4a98f8920f3d1529be6be7c5baf7ab1dd"], "tags": []}], "date": 1651866241, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "251": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145869", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "336420191a5d1fcceb8a599911917b71b8bf9d66", "parents": ["9f143c561b4bc59fe81c8770c7dc582a61b7dcc3"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1711719 - Disable new tab menulist if preference is locked. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143610", "files": ["browser/components/preferences/home.js"], "git_node": null, "git_parents": [null], "node": "4a79264e22c3070b9a59f730e0d1cb51cd058a2d", "parents": ["336420191a5d1fcceb8a599911917b71b8bf9d66"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1520913 - Allow password manager exceptions in policy. r=mstriemer,flod,Gijs a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142886", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_permissions.js", "browser/components/preferences/dialogs/permissions.js", "browser/components/preferences/tests/browser.ini", "browser/components/preferences/tests/browser_site_login_exceptions_policy.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "9137f00be7b39e1174c62796fb64626bbf37a1d0", "parents": ["4a79264e22c3070b9a59f730e0d1cb51cd058a2d"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1654787 - Allow disabling pinching from the command line. r=botond, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143768", "files": ["browser/components/BrowserContentHandler.jsm"], "git_node": null, "git_parents": [null], "node": "a074f080d4a53cd01bf43f676a808fa4ffe00292", "parents": ["9137f00be7b39e1174c62796fb64626bbf37a1d0"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1499095 - Remove engines hidden by policy after restoring defaults. r=Standard8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142888", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_search_engine.js", "browser/components/preferences/search.js"], "git_node": null, "git_parents": [null], "node": "25985bb793eaec14c185c5be6a698404febacdcb", "parents": ["a074f080d4a53cd01bf43f676a808fa4ffe00292"], "tags": []}], "date": 1652115172, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "252": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1767365 - Clip image data transfers. r=aosmond, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145674", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "gfx/2d/BaseRect.h"], "git_node": null, "git_parents": [null], "node": "e70578598718b5b263d6a88bec3c1deccbb82e4a", "parents": ["25985bb793eaec14c185c5be6a698404febacdcb"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1760527 - Use content signature instead of cert pinning everywhere for GMP updates. r=Gijs, a=RyanVM\n\nThis sets up prefs so by default any release will use the content signature path\nfor GMP updates, rather than cert pinning. This intentionally leaves in place\nthe old cert pinning machinery so that we can still use if we need to\n- Compare the new and old for things like debugging.\n- Revert these changes in the case of regressions (either by shipping a patch or\n  something like normandy).\n\nThis patch is also small to enable it to be uplifted easily.\n\nOnce we're sure this new path is good, a larger patch can follow up to remove\nthe cert pinning code + rework our tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141891", "files": ["modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "bd70133284ef766e7f6de0a2b55ca63dd5d87b81", "parents": ["e70578598718b5b263d6a88bec3c1deccbb82e4a"], "tags": []}, {"author": "Molly Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1765049 - Filter out illegal paths. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145518", "files": ["widget/windows/nsFilePicker.cpp"], "git_node": null, "git_parents": [null], "node": "f6a3fb31a326a375bcbbe1e72d1f0a8113200ad7", "parents": ["bd70133284ef766e7f6de0a2b55ca63dd5d87b81"], "tags": []}], "date": 1652232838, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "253": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1766806 - Avoid checkIntegrity failure in f32.copysign wasm instruction. r=lth, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145009", "files": ["js/src/jit-test/tests/wasm/regress/bug1762899.js", "js/src/jit/arm64/Lowering-arm64.cpp"], "git_node": null, "git_parents": [null], "node": "5f01542de9f3d3e41cb3e2011bcab233f8f0938a", "parents": ["f6a3fb31a326a375bcbbe1e72d1f0a8113200ad7"], "tags": []}, {"author": "Nicolas B. Pierron \u003cnicolas.b.pierron@nbp.name\u003e", "branch": "default", "desc": "Bug 1766283 - Make hash table usage deterministic. r=arai, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145100", "files": ["js/src/ds/InlineTable.h"], "git_node": null, "git_parents": [null], "node": "a231c9c155cf735f1827225bd59b59f210ed0e6b", "parents": ["5f01542de9f3d3e41cb3e2011bcab233f8f0938a"], "tags": []}], "date": 1652275989, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "254": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D146168", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "2aa126a81d529a34161c4b1ce69663411239b603", "parents": ["a231c9c155cf735f1827225bd59b59f210ed0e6b"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1727995 - Disable websocket over h2, r=necko-reviewers,dragana, a=RyanVM", "files": ["modules/libpref/init/all.js", "testing/web-platform/meta/infrastructure/server/__dir__.ini", "testing/web-platform/meta/websockets/__dir__.ini", "testing/web-platform/meta/websockets/extended-payl