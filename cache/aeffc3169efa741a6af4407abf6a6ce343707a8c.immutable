s:41831:"{
"lastpushid": 336,
"pushes": {"125": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging d482421dc3fe22020f2c57f573ed902f6d302ffa with FIREFOX_78_5_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "aba16c583e0c290ce18024295673f91bae4fbab8", "parents": ["d482421dc3fe22020f2c57f573ed902f6d302ffa"], "tags": []}], "date": 1605033749, "git_changesets": [null], "user": "ffxbld"}, "126": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "f32a9f767fe967dd58006419c8af6a53a986ed12", "parents": ["aba16c583e0c290ce18024295673f91bae4fbab8"], "tags": []}], "date": 1605521842, "git_changesets": [null], "user": "ffxbld-merge"}, "127": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97162", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/main/hijack-blocklists.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "147b46951b5a2d3dfee7c3b1f70b0e2c65c342e1", "parents": ["f32a9f767fe967dd58006419c8af6a53a986ed12"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1608358 - Fix allowfullscreen check to check for feature policy. r=baku, a=RyanVM\n\nWe can clean up this code once the feature policy pref goes away, but\nmeanwhile this should do the right thing.", "files": ["docshell/base/nsDocShell.cpp", "dom/base/nsFrameLoader.cpp", "dom/html/HTMLIFrameElement.cpp", "dom/html/HTMLIFrameElement.h", "dom/html/test/file_fullscreen-denied.html", "dom/security/featurepolicy/FeaturePolicy.cpp", "dom/security/featurepolicy/FeaturePolicyUtils.cpp", "dom/webidl/HTMLIFrameElement.webidl", "testing/web-platform/meta/fullscreen/api/document-fullscreen-enabled.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-iframe-element/iframe-allowfullscreen.html.ini", "testing/web-platform/tests/fullscreen/api/document-fullscreen-enabled-cross-origin.sub.html", "toolkit/content/tests/widgets/test_videocontrols_iframe_fullscreen.html"], "git_node": null, "git_parents": [null], "node": "528bc3937f80f559b9d187437db206f3ab242d77", "parents": ["147b46951b5a2d3dfee7c3b1f70b0e2c65c342e1"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1649005 - fix crash when rewrapping an empty message via mozilla::HTMLEditor::InsertTextWithQuotationsInternal. r=masayuki, a=RyanVM\n\nIf empty input, aStringToInsert.First() will crash at https://searchfox.org/mozilla-central/rev/c2e3ac11be4837718c2604e58085fbc8252b69dd/xpcom/string/nsTSubstring.cpp#968\n\nNeeded to adjust whether rewrap needs beforeinput handling:\nNeedsBeforeInputEventHandling would return false, because rewrap was set not to need that\nhttps://searchfox.org/mozilla-central/rev/803b368879fa332e8e2c1840bf1ec164f7ed2c32/editor/libeditor/EditorBase.h#1152\n.. so EditorBase::AutoEditActionDataSetter::MaybeDispatchBeforeInputEvent would assert\n\nrewrap also needs to be allowed for MayEditActionDeleteSelection (not to assert)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D93167", "files": ["editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditorDataTransfer.cpp", "editor/libeditor/tests/mochitest.ini", "editor/libeditor/tests/test_bug1649005.html"], "git_node": null, "git_parents": [null], "node": "0322427df80a91fdeace25c1508105074dc8adad", "parents": ["528bc3937f80f559b9d187437db206f3ab242d77"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1673202 - Call fstat directly in Linux sandbox fstatat interception. r=gcp, a=RyanVM\n\nSandbox policies handle the case of `fstatat(fd, \"\", AT_EMPTY_PATH|...)`\nby invoking the SIGSYS handler (because seccomp-bpf can't tell if the\nstring will be empty when the syscall would use it), which makes the\nequivalent call to `fstat`.\n\nUnfortunately, recent development versions of glibc implement `fstat` by\ncalling `fstatat`, which causes unbounded recursion and stack overflow.\n(This depends on the headers present at build time; see the bug for more\ndetails.)  This patch switches it to use the `fstat` (or `fstat64` on\n32-bit) syscall directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D94798", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": null, "git_parents": [null], "node": "13d5867b039948a79fa80fc2081a17b8089f1ed7", "parents": ["0322427df80a91fdeace25c1508105074dc8adad"], "tags": []}], "date": 1605547374, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "128": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1643798 - Fix feature policy check for fullscreen so that it gets reflected properly in document.fullscreenEnabled. r=baku, a=RyanVM\n\nSee bug 1606660 comment 8 as to why checking it only in\nElement.requestFullscreen is wrong.\n\nDo you know how to test this? I'm not very familiar with feature-policy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78567", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/html/test/file_fullscreen-featurePolicy-inner.html", "dom/html/test/file_fullscreen-featurePolicy.html", "testing/web-platform/tests/feature-policy/feature-policy-header-policy-disallowed-for-all.https.sub.html"], "git_node": null, "git_parents": [null], "node": "8a302b9b4d330625ed3d6740266e8b4c588e8885", "parents": ["13d5867b039948a79fa80fc2081a17b8089f1ed7"], "tags": []}], "date": 1605551233, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "129": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging d482421dc3fe22020f2c57f573ed902f6d302ffa with FIREFOX_78_5_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "9a494ea141cdddd0a158031843d9694dfb6db170", "parents": ["8a302b9b4d330625ed3d6740266e8b4c588e8885"], "tags": []}], "date": 1605620306, "git_changesets": [null], "user": "ffxbld"}, "130": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_78_4_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_78_4_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "cf567fcaff1209ce373aaebf1534e917de6fab19", "parents": ["22b8bef3c436a4d36b586804f342928e1ab11e51"], "tags": []}], "date": 1605814074, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "131": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97589", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "4e708898d49e078de5f946d03b0627779b282fd0", "parents": ["9a494ea141cdddd0a158031843d9694dfb6db170"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1673770 - Extend the handling of fstatat-as-fstat to sandboxes that don't use a file broker. r=gcp, a=RyanVM\n\nThe fix for bug 1660901, to handle the subset of fstatat that is\nequivalent to fstat, was incomplete: it was added to the existing\nhook for the file broker, so processes that don't use a broker (like\nGMP) didn't get the fix.  That wasn't a problem when the only use of\nthat feature was in content processes via GTK, but now that glibc has\nreimplemented fstat that way, it's necessary for all processes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D95108", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": null, "git_parents": [null], "node": "3962fa9f3084c5bca8458cecdaac664dc431164a", "parents": ["4e708898d49e078de5f946d03b0627779b282fd0"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1674006 - Add null check for addon source. r=emalysz, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D95087", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "7911a2ea168f23758ee389ba5d5a7362a9e0675c", "parents": ["3962fa9f3084c5bca8458cecdaac664dc431164a"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1674009 - Add pdfjs. and spellchecker. to Preferences policy. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D95091", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "d5ec402e7fe8c128cace8eb37a6e7164b5614504", "parents": ["7911a2ea168f23758ee389ba5d5a7362a9e0675c"], "tags": []}], "date": 1605814519, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "132": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97878", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/gfx.json", "services/settings/dumps/main/hijack-blocklists.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "3c9a848fb65fd6af2543fc17833b79ac47f27271", "parents": ["d5ec402e7fe8c128cace8eb37a6e7164b5614504"], "tags": []}], "date": 1606144211, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "133": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97999", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/gfx.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "59f47afe5443841fdf8fbd27c16e0ae0e4ad56d6", "parents": ["3c9a848fb65fd6af2543fc17833b79ac47f27271"], "tags": []}], "date": 1606407928, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "134": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98191", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6a1d4d25755afa59812f9eaeb4be143170376eee", "parents": ["59f47afe5443841fdf8fbd27c16e0ae0e4ad56d6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1368015 - Null-check selection in nsCaret::GetFrameAndOffset. r=masayuki, a=RyanVM\n\nA bit of a wallpaper, but it's silly to crash with a null deref here. If\nthere's no selection there's nothing to invalidate really.\n\nWe already null-check it effectively when aOverrideNode is null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97960", "files": ["layout/base/nsCaret.cpp"], "git_node": null, "git_parents": [null], "node": "24bce7b71db463425baafdb11f5f82f88a2c9bd0", "parents": ["6a1d4d25755afa59812f9eaeb4be143170376eee"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1677806 - Set network.dns.dns_query_single_label to false. r=Gijs, a=RyanVM\n\nThis seems to have caused a bunch of regressions. We'll likely try to enable\nit at a later time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97597", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "e76a6648d63129ee58b3528c08ceb75ce8f2a77f", "parents": ["24bce7b71db463425baafdb11f5f82f88a2c9bd0"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1657916 - Allow extensions to see view-source requests. r=robwu, a=RyanVM\n\nView source prefixes urls with a view-source scheme.  Somewhere along\nthe way a request is made for the un-prefixed url but we do not intercept.  This\nremoves the prefix for webrequest and proxy APIs prior to checking access rules\nand filters, allowing the APIs to intercept those requests that the otherwise\ncould.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89068", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_webRequest_viewsource.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.ini", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp"], "git_node": null, "git_parents": [null], "node": "aa4b9610162034d8e4ce6ac9f721cfb509d2fea1", "parents": ["e76a6648d63129ee58b3528c08ceb75ce8f2a77f"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1661365. r=Gijs a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D94268", "files": ["toolkit/components/downloads/DownloadIntegration.jsm"], "git_node": null, "git_parents": [null], "node": "fc2be3fd6644f5c3a82e73c60f4e906dbe4f4cdc", "parents": ["aa4b9610162034d8e4ce6ac9f721cfb509d2fea1"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639613 - Pre: Fix potential typo: lastUsed -\u003e lastused. r=mhowell, a=RyanVM\n\nIt's not 100% clear that this has any effect -- it might be that the\nstring is case insensitive -- but in any case let's keep our source\ncode uniform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D94774", "files": ["browser/installer/windows/nsis/uninstaller.nsi"], "git_node": null, "git_parents": [null], "node": "d6cfe618fe6730b9ed238adb3407013401c6ee0d", "parents": ["fc2be3fd6644f5c3a82e73c60f4e906dbe4f4cdc"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639613 - Make Windows uninstaller conditionally request UAC elevation when silent. r=mhowell, a=RyanVM\n\nThis essentially cribs the equivalent installer conditional elevation.\nI elected to guard this behind /S (silent) because it's not obvious to\nme that unelevated users will see identical behaviour when not\nelevating.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D76254", "files": ["toolkit/mozapps/installer/windows/nsis/common.nsh"], "git_node": null, "git_parents": [null], "node": "f683c43589b0659fecb47dd73e17d50c20c31f0b", "parents": ["d6cfe618fe6730b9ed238adb3407013401c6ee0d"], "tags": []}], "date": 1606781408, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "135": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1651745 - Memoize the max channel count in AudioSegment::MaxChannelCount(). r=padenot, a=jcristau\n\nWhen an AudioCallbackDriver starts a fallback SystemClockDriver is running in\nits stead. The AudioTrack getting fed data from the input stream of the driver\nwill get real data while the AudioCallbackDriver is running, and silence while\nthe fallback driver is running.\n\nIf the MediaStreamTrack representing the microphone source is part of a\nMediaStream being played by an HTMLMediaElement; and another MediaStreamTrack\nrepresenting another source with a lower channel count than the microphone is\npart of another MediaStream being played by another HTMLMediaElement; then:\n1. We start the graph with the other source's output channel count, and a\n   fallback driver.\n2. Once the audio driver has started, it adds data at a higher channel count\n   than the graph's to its MediaTrack. The driver switches audio driver to\n   match the new channel count.\n3. The new driver starts with a fallback driver, which adds silence to the\n   track. Silence has no channel count, so the graph sees only the channel\n   count of the other source and switches audio driver to match this.\n4. Go to 1.\n\nThis patch fixes makes us memoize a previously returned max channel count for an\nAudioSegment for use when there is only null data (e.g., silence) present in the\nsegment. This applies to step 3 above, where no audio driver would be switched\nbecause the graph still sees the mic's channel count.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D95931", "files": ["dom/media/AudioSegment.h", "dom/media/gtest/TestAudioSegment.cpp"], "git_node": null, "git_parents": [null], "node": "0c00345f33455e118edad62fcd604861bfb95f6a", "parents": ["f683c43589b0659fecb47dd73e17d50c20c31f0b"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1652925 - Fix memory leak of extension Port via conduits. r=zombie, a=jcristau\n\nExtension ports should be eligible for garbage collection when\ndisconnected. This did not happen because there was a strong reference\nfrom the context to the conduit, whose subject was the Port. As a\nresult, the Port instances were not GCd until the context was unloaded.\n\nThis results in significant memory leaks over time, because it is not\nuncommon for extensions to have a long-lived background page that\nreceives messages via Ports. The issue is made even worse by the fact\nthat ports contain metadata that can potentially be very large.\n\nThere are other callers of openConduit, but these are not affected\nbecause their lifetimes are similar to the BaseContext.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D96952", "files": ["toolkit/components/extensions/ConduitsChild.jsm", "toolkit/components/extensions/ExtensionCommon.jsm", "toolkit/components/extensions/test/xpcshell/test_ext_runtime_ports_gc.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.ini"], "git_node": null, "git_parents": [null], "node": "4ac934ca4cc37b82044be49bef10d39b268c6cef", "parents": ["0c00345f33455e118edad62fcd604861bfb95f6a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1666072 - Disable HSTS upgrade for captive portal channels. r=Gijs, a=jcristau\n\nhttps://firefox.com/ sends `strict-transport-security:\tmax-age=31536000; includeSubDomains`\nand http://firefox.com sends the `upgrade-insecure-requests: 1` header.\n\nCombined, these cause the captive portal check to report a redirect, which\ntriggers the locked captive portal banner. The fix is to exclude the captive\nportal channel from the upgrade.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97152", "files": ["toolkit/components/captivedetect/CaptiveDetect.jsm"], "git_node": null, "git_parents": [null], "node": "eda9c77d3a54028090810ee8aeea2f08c416d6e8", "parents": ["4ac934ca4cc37b82044be49bef10d39b268c6cef"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1666072 - Temporarily disable test_trr.js::test25e. a=test-only\n\nThe test expects the only code that would call SetAllowSTS=false is the OCSP code. Making the captive portal do that too messes up expectations. A follow-up to bug 1556194 is necessary.\n\nDepends on D97152\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97172", "files": ["netwerk/test/unit/test_trr.js"], "git_node": null, "git_parents": [null], "node": "018983b97fb6922b01ac1301f1c7122bb6c8568a", "parents": ["eda9c77d3a54028090810ee8aeea2f08c416d6e8"], "tags": []}, {"author": "Matt Woodrow \u003cmwoodrow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1664831 - r=sotaro, a=jcristau", "files": ["dom/media/ipc/GpuDecoderModule.cpp", "dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/ipc/RemoteVideoDecoder.cpp", "dom/media/ipc/RemoteVideoDecoder.h", "gfx/layers/RotatedBuffer.cpp", "gfx/layers/RotatedBuffer.h", "gfx/layers/client/TextureClient.h", "gfx/layers/d3d11/TextureD3D11.cpp", "gfx/layers/d3d11/TextureD3D11.h", "gfx/layers/ipc/KnowsCompositor.h", "gfx/layers/ipc/ShadowLayers.cpp"], "git_node": null, "git_parents": [null], "node": "bac0869c171b0ba9598ae6a66a2fec4c6e34057e", "parents": ["018983b97fb6922b01ac1301f1c7122bb6c8568a"], "tags": []}], "date": 1606843168, "git_changesets": [null, null, null, null, null], "user": "jcristau@mozilla.com"}, "136": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1652925 - Fix eslint issue in ConduitsChild.jsm on ESR78. a=eslint-fix\n\nESR78 uses eslint 6.8.0, which triggers the no-unused-expressions\nwarning when optional chaining is used, despite the expression\nopbviously not being unused (as a function call).\n\nThis issue does not occur on m-c because it uses a recent version of\neslint: eslint@7.5.0 and later support optional chaining without\nexternal plugins\n(https://eslint.org/blog/2020/07/eslint-v7.5.0-released#enhancements).\n\nInstead of updating eslint@7.5.0 or newer on the ESR78 branch, this\npatch adds a comment to ignore the false positive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98403", "files": ["toolkit/components/extensions/ConduitsChild.jsm"], "git_node": null, "git_parents": [null], "node": "a9c49499343aa520e9c6d7d5f173b53a885ac983", "parents": ["bac0869c171b0ba9598ae6a66a2fec4c6e34057e"], "tags": []}], "date": 1606867288, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "137": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1680467 - add url-classifier-skip-urls.json to allowed duplicate files. r=Gijs,leplatrem, a=jcristau\n\nallowed-dupes.mn contains a list of remote settings dumps that are allowed to\nbe empty.  url-classifier-skip-urls.json was missing from that list and its\nlatest version is empty, causing bustage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98577", "files": ["browser/installer/allowed-dupes.mn"], "git_node": null, "git_parents": [null], "node": "e72f6ec8e9b59c25b15c730bfa853f64327a2ab5", "parents": ["a9c49499343aa520e9c6d7d5f173b53a885ac983"], "tags": []}, {"author": "Jason Orendorff \u003cjason.orendorff@gmail.com\u003e", "branch": "default", "desc": "Bug 1679003 - Fix uninitialized overflow digit in BigInt right shift. r=tcampbell, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98204", "files": ["js/src/jit-test/tests/bigint/bug1679003.js", "js/src/vm/BigIntType.cpp"], "git_node": null, "git_parents": [null], "node": "6f1267e4aff2a7a93d3552c527f4978f2dcda904", "parents": ["e72f6ec8e9b59c25b15c730bfa853f64327a2ab5"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 1673589 - Crash [@ ??] with SIGTRAP with WebAssembly.  r=lth, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98564", "files": ["js/src/wasm/WasmInstance.cpp"], "git_node": null, "git_parents": [null], "node": "96a892d40be234f1ae9f8186d69cd5f167943a06", "parents": ["6f1267e4aff2a7a93d3552c527f4978f2dcda904"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 1674735 - add port 5060 to bad port list. r=valentin,necko-reviewers, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D95504", "files": ["netwerk/base/nsIOService.cpp"], "git_node": null, "git_parents": [null], "node": "50f9a90291467c9eb9ba4d3797cf2e2657365a81", "parents": ["96a892d40be234f1ae9f8186d69cd5f167943a06"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1627673 - Do null-check the result of `DragEvent::GetDataTransfer()` in `EditorEventListener``. r=smaug, a=jcristau\n\nI guess that `DataTransfer::HasType()` is inlined in the opt builds and\nactually crashed in `EditorEventListener::DragEventHasSupportingData()`\nat accessing `aDragEvent-\u003eGetDataTransfer()` result without null-check\nbecause `DataTransfer::mItems` is set to `nullptr` only by the cycle\ncollector, but it does not make sense to think that it occurs the STR\nin bug 1627673 comment 3.\n\nTherefore, this patch adds null-checks in\n`EditorEventListener::DragEventHasSupportingData()`.\n\nI have no idea how to test this with automated tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D96310", "files": ["editor/libeditor/EditorEventListener.cpp"], "git_node": null, "git_parents": [null], "node": "fc39ab246aa8eb5254c93eb018589c13a1b531b5", "parents": ["50f9a90291467c9eb9ba4d3797cf2e2657365a81"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1465847 - If a website is blocked via policy, block view source. r=emalysz, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D94366", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.jsm", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js"], "git_node": null, "git_parents": [null], "node": "53f4fae320e19a5548df879dc93df926e649350d", "parents": ["fc39ab246aa8eb5254c93eb018589c13a1b531b5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1678413 - Release listeners for nsViewSourceChannel. r=necko-reviewers,dragana, a=jcristau\n\nRelease the two kinds of listeners that view source channel has\nif AsyncOpen fails, or in OnStop. This matches the behavior of\nHttpChannelChild. The former change fixes a leak when view source\nchannels are blocked by enterprise policies.\n\nIt looks like clang-format deleted the double include of\nnsViewSourceChannel.h.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98223", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js", "netwerk/protocol/viewsource/nsViewSourceChannel.cpp", "netwerk/protocol/viewsource/nsViewSourceChannel.h"], "git_node": null, "git_parents": [null], "node": "95dacfb8daf33f1769058ac36997ea2b8dc94e60", "parents": ["53f4fae320e19a5548df879dc93df926e649350d"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 1677047 - Add the ports for the H323, PPTP, RTSP protocols (1720, 1723, 554) to the restricted ports list. r=valentin,necko-reviewers, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D96979", "files": ["netwerk/base/nsIOService.cpp"], "git_node": null, "git_parents": [null], "node": "a11c295b7ec3f3c0bd83e8892333b6f863f06dd1", "parents": ["95dacfb8daf33f1769058ac36997ea2b8dc94e60"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 1677047 - Testing to block ports 1720, 1723, 554- r=necko-reviewers,valentin, a=jcristau\n\nDepends on D96979\n\nDifferential Revision: https://phabricator.services.mozilla.com/D96980", "files": ["testing/web-platform/tests/fetch/api/request/request-bad-port.html", "testing/web-platform/tests/tools/wptserve/wptserve/utils.py", "testing/web-platform/tests/websockets/Create-blocked-port.any.js"], "git_node": null, "git_parents": [null], "node": "64addb3cd3582c32d77106204a7441994a1aaabc", "parents": ["a11c295b7ec3f3c0bd83e8892333b6f863f06dd1"], "tags": []}, {"author": "Steven Michaud \u003csmichaud@pobox.com\u003e", "branch": "default", "desc": "Bug 1676102 - Prevent access to child process modules not in dyld shared cache. r=gsvelto, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D97679", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/dynamic_images.cc", "toolkit/crashreporter/breakpad-client/mac/handler/dynamic_images.h", "toolkit/crashreporter/breakpad-client/mac/handler/minidump_generator.cc", "toolkit/crashreporter/breakpad-client/mac/handler/minidump_generator.h"], "git_node": null, "git_parents": [null], "node": "5523366f99da3f7a82c2a7b95a16f302bf2292b0", "parents": ["64addb3cd3582c32d77106204a7441994a1aaabc"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98600", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0724cae903ec40535803c41f61e45638377d8b5e", "parents": ["5523366f99da3f7a82c2a7b95a16f302bf2292b0"], "tags": []}], "date": 1607013732, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "jcristau@mozilla.com"}, "138": {"changesets": [{"author": "Razvan Maries \u003crmaries@mozilla.com\u003e", "branch": "default", "desc": "Backed out 2 changesets (bug 1677047) for perma failures on websockets/Create-blocked-port.any.html. a=backout\n\nBacked out changeset 64addb3cd358 (bug 1677047)\nBacked out changeset a11c295b7ec3 (bug 1677047)", "files": ["netwerk/base/nsIOService.cpp", "testing/web-platform/tests/fetch/api/request/request-bad-port.html", "testing/web-platform/tests/tools/wptserve/wptserve/utils.py", "testing/web-platform/tests/websockets/Create-blocked-port.any.js"], "git_node": null, "git_parents": [null], "node": "a84355c618cace81392286f557b8f2874347aaae", "parents": ["0724cae903ec40535803c41f61e45638377d8b5e"], "tags": []}], "date": 1607025753, "git_changesets": [null], "user": "rmaries@mozilla.com"}, "139": {"changesets": [{"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 1677047 - Testing to block ports 1720, 1723, 554- r=necko-reviewers,valentin, a=jcristau\n\nDepends on D96979\n\nDifferential Revision: https://phabricator.services.mozilla.com/D96980", "files": ["testing/web-platform/tests/fetch/api/request/request-bad-port.html", "testing/web-platform/tests/tools/wptserve/wptserve/utils.py"], "git_node": null, "git_parents": [null], "node": "a6c73