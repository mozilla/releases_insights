a.com"}, "193": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1982763 - Re-add `CLONE_NEWIPC` to the Linux GMP sandbox.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D260923\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263007\n", "files": ["security/sandbox/linux/launch/SandboxLaunch.cpp"], "git_node": "13cf8c918d4e9967da2d0f84222143ac51ecebed", "git_parents": ["8d5666b49b882a9a5bb4fef13a6609b9798b3d4f"], "node": "8cb217873bf19e77fa80a26ce5c78b745d0727e6", "parents": ["e76ee3c47d75324c3ec627ae4665726307283b1d"], "tags": []}], "date": 1756430890, "git_changesets": ["13cf8c918d4e9967da2d0f84222143ac51ecebed"], "user": "rvandermeulen@mozilla.com"}, "194": {"changesets": [{"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1978985 - Disable printing when enablePermission is true and the pdf isn't allowed to be printed  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263103\n", "files": ["toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs"], "git_node": "90bc3d36c3d0465648bc7ce1092756b6965b24a0", "git_parents": ["13cf8c918d4e9967da2d0f84222143ac51ecebed"], "node": "45ed42f4092c89d0722c9db0b4a3847f2b3a57d9", "parents": ["8cb217873bf19e77fa80a26ce5c78b745d0727e6"], "tags": []}], "date": 1756503478, "git_changesets": ["90bc3d36c3d0465648bc7ce1092756b6965b24a0"], "user": "rvandermeulen@mozilla.com"}, "195": {"changesets": [{"author": "Landry Breuil \u003clandry@rhaalovely.net\u003e", "branch": "default", "desc": "Bug 1874059: fix build with libc++\u003e=18 on OpenBSD and FreeBSD r=sylvestre a=RyanVM DONTBUILD\n\nwithout -fvisibility=hidden, linking libxul fails with undefined hidden symbol\nreferences to std::__1::basic_string\u003cchar, std::__1::char_traits\u003cchar\u003e, std::__1::allocator\u003cchar\u003e\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262230\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "ede5e748f7d451fd2e06f21f810a6a1b08d827b1", "git_parents": ["90bc3d36c3d0465648bc7ce1092756b6965b24a0"], "node": "1752f7c8b673318ecc65aa58961fbaeaf75a8733", "parents": ["45ed42f4092c89d0722c9db0b4a3847f2b3a57d9"], "tags": []}], "date": 1756685603, "git_changesets": ["ede5e748f7d451fd2e06f21f810a6a1b08d827b1"], "user": "rvandermeulen@mozilla.com"}, "196": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984825. r=jnicol a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262611\n", "files": ["gfx/2d/InlineTranslator.h"], "git_node": "14d3f5b07627f509408ba56d6c88b1d964f93b5a", "git_parents": ["ede5e748f7d451fd2e06f21f810a6a1b08d827b1"], "node": "0b4c9e17a5972b082fdce400b275704ef0182eaf", "parents": ["1752f7c8b673318ecc65aa58961fbaeaf75a8733"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1985067. r=jnicol a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262614\n", "files": ["layout/printing/PrintTranslator.h"], "git_node": "44ff633cd511efd4d427130ab7246f567b191878", "git_parents": ["14d3f5b07627f509408ba56d6c88b1d964f93b5a"], "node": "51a81ed43fa316fb57b0fbd46133267623784d84", "parents": ["0b4c9e17a5972b082fdce400b275704ef0182eaf"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984505 - Improve Opus packet duration error output in WebM demuxer. r=padenot a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262818\n", "files": ["dom/media/webm/WebMDemuxer.cpp"], "git_node": "e124e4aaaca734e8264b8461124caef1ae08fd9a", "git_parents": ["44ff633cd511efd4d427130ab7246f567b191878"], "node": "8b2f66cbbac4c4161a37e508ff31e9b75cd961c4", "parents": ["51a81ed43fa316fb57b0fbd46133267623784d84"], "tags": []}], "date": 1756685970, "git_changesets": ["14d3f5b07627f509408ba56d6c88b1d964f93b5a", "44ff633cd511efd4d427130ab7246f567b191878", "e124e4aaaca734e8264b8461124caef1ae08fd9a"], "user": "rvandermeulen@mozilla.com"}, "197": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 1980788 - Use std::size rather than hardcoding an array size  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262967\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263128\n", "files": ["gfx/2d/FilterProcessingScalar.cpp"], "git_node": "99bec85ef379982d3046dd8c1de8598ca6e2b1a6", "git_parents": ["e124e4aaaca734e8264b8461124caef1ae08fd9a"], "node": "158270b6cdbc9f2d32b9e3bc7053f38b36c8018a", "parents": ["8b2f66cbbac4c4161a37e508ff31e9b75cd961c4"], "tags": []}], "date": 1756686244, "git_changesets": ["99bec85ef379982d3046dd8c1de8598ca6e2b1a6"], "user": "rvandermeulen@mozilla.com"}, "198": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1981502 - Parse merged version of cache-control instead of just the latest header  a=RyanVM\n\nnsHttpResponseHead::ParseHeaderLine_locked parses each header as it comes in.\nIt then updates its own member variables based on that header.\nFor cache-control, it's important to reparse the merged version of the header\ninstead of the most recent one, otherwise we'll miss directives present in\nprevious headers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D260461\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263269\n", "files": ["netwerk/protocol/http/nsHttpResponseHead.cpp", "netwerk/test/gtest/TestCacheControlParser.cpp", "netwerk/test/gtest/TestHttpResponseHead.cpp", "netwerk/test/unit/test_cache2_nostore.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "6691758c454e4bb4e7a565f5e03a728ddd6fd701", "git_parents": ["99bec85ef379982d3046dd8c1de8598ca6e2b1a6"], "node": "ebae823100ca656c9a03e18d2071b24926a80b20", "parents": ["158270b6cdbc9f2d32b9e3bc7053f38b36c8018a"], "tags": []}], "date": 1756732335, "git_changesets": ["6691758c454e4bb4e7a565f5e03a728ddd6fd701"], "user": "rvandermeulen@mozilla.com"}, "199": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263265\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "bddc068382197c0ca0a573d1d9a954357b4c82fd", "git_parents": ["6691758c454e4bb4e7a565f5e03a728ddd6fd701"], "node": "07aa8e24bfd91224b9182295dd90015cfa939423", "parents": ["ebae823100ca656c9a03e18d2071b24926a80b20"], "tags": []}], "date": 1756732782, "git_changesets": ["bddc068382197c0ca0a573d1d9a954357b4c82fd"], "user": "rvandermeulen@mozilla.com"}, "200": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981688 - Rename fluent string corruptedContentError-title to corruptedContentErrorv2-title.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D260266\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263444\n", "files": ["toolkit/locales/en-US/toolkit/neterror/certError.ftl", "tools/lint/fluent-lint/exclusions.yml"], "git_node": "0339985881641c74a43f2a23f4a8762f5da820e2", "git_parents": ["bddc068382197c0ca0a573d1d9a954357b4c82fd"], "node": "555282aef3deb1bc130d263388a31dffe37ee248", "parents": ["07aa8e24bfd91224b9182295dd90015cfa939423"], "tags": []}], "date": 1756836142, "git_changesets": ["0339985881641c74a43f2a23f4a8762f5da820e2"], "user": "rvandermeulen@mozilla.com"}, "201": {"changesets": [{"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1959023 Part 1: Only set the macOS menubar when the app is active. r=spohl a=RyanVM\n\nThis prevents windowDidResignMain from altering the menubar when Firefox\nis not the active app. This avoids menubar changes on multiple monitors\nwhen switching from one window to another. When Firefox becomes active\nagain, it will update its menubar, which is typically the same menubar\nas it had before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255243\n", "files": ["widget/cocoa/nsCocoaUtils.mm", "widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsMenuBarX.mm"], "git_node": "a27e723b0bdead6fb8025e5a49e2452864436604", "git_parents": ["0339985881641c74a43f2a23f4a8762f5da820e2"], "node": "54220dbe8c70ac516bc8373acde0b47c86001db2", "parents": ["555282aef3deb1bc130d263388a31dffe37ee248"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1959023 Part 2: Prevent macOS menubar from flickering when quitting Firefox. r=spohl a=RyanVM\n\nThis also prevents the momentary appearance of a gray, disabled-looking\nmenubar when quitting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255244\n", "files": ["toolkit/components/startup/nsAppStartup.cpp", "toolkit/components/startup/public/nsIAppStartup.idl", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "1142ca05c035154167d3dbc49c96e4ac814cc4b2", "git_parents": ["a27e723b0bdead6fb8025e5a49e2452864436604"], "node": "e54a3a9b572b47a37bf62e73a805a2f0272ba8c7", "parents": ["54220dbe8c70ac516bc8373acde0b47c86001db2"], "tags": []}], "date": 1756839243, "git_changesets": ["a27e723b0bdead6fb8025e5a49e2452864436604", "1142ca05c035154167d3dbc49c96e4ac814cc4b2"], "user": "rvandermeulen@mozilla.com"}, "202": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986395 - fix last-watershed for linux64-aaarch64 on esr.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D263342\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263343\n", "files": ["taskcluster/kinds/release-update-verify-config/kind.yml"], "git_node": "9f8620ad31caf6abf1953ffe35253a1934438da4", "git_parents": ["1142ca05c035154167d3dbc49c96e4ac814cc4b2"], "node": "72909a706d577b8f57953d0f759c91627cae87a9", "parents": ["e54a3a9b572b47a37bf62e73a805a2f0272ba8c7"], "tags": []}], "date": 1756839545, "git_changesets": ["9f8620ad31caf6abf1953ffe35253a1934438da4"], "user": "rvandermeulen@mozilla.com"}, "203": {"changesets": [{"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 1977770 - Fix \"View\u2026\" button in certificate exception dialog.  a=RyanVM DONTBUILD\n\nTake two, this time with the right event listener for a XUL button instead of an HTML button. :-(\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257650\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263476\n", "files": ["security/manager/pki/resources/content/exceptionDialog.js", "security/manager/ssl/tests/mochitest/browser/browser_add_exception_dialog.js"], "git_node": "ed678723bad0c7090db215c2d0fc2410df4d0516", "git_parents": ["9f8620ad31caf6abf1953ffe35253a1934438da4"], "node": "ec302a179def09a533bc145fb93206157eb1d456", "parents": ["72909a706d577b8f57953d0f759c91627cae87a9"], "tags": []}], "date": 1756844875, "git_changesets": ["ed678723bad0c7090db215c2d0fc2410df4d0516"], "user": "rvandermeulen@mozilla.com"}, "204": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977962 - use a subdialog for the certificate exception override dialog if available  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258326\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263455\n", "files": ["security/manager/pki/resources/content/certManager.js", "security/manager/pki/resources/content/exceptionDialog.css", "security/manager/pki/resources/content/exceptionDialog.js", "security/manager/ssl/tests/mochitest/browser/browser_add_exception_dialog.js"], "git_node": "f09f7641bb91c3ce4fffda32ba066a599f84f028", "git_parents": ["ed678723bad0c7090db215c2d0fc2410df4d0516"], "node": "5b8e559cbbc4165b10169984517004a641612cb7", "parents": ["ec302a179def09a533bc145fb93206157eb1d456"], "tags": []}], "date": 1756844926, "git_changesets": ["f09f7641bb91c3ce4fffda32ba066a599f84f028"], "user": "rvandermeulen@mozilla.com"}, "205": {"changesets": [{"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1979719 [Wayland] Terminate D&D operation if we don't get motion event before button release r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260184\n", "files": ["widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": "3d20460a97e0689329d6320d7d1b5994fb5061bc", "git_parents": ["f09f7641bb91c3ce4fffda32ba066a599f84f028"], "node": "453460cf0f4791f21598e50ff9bc2a8d1b49a9e4", "parents": ["5b8e559cbbc4165b10169984517004a641612cb7"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1960626 [Wayland] Align directly placed popups with toplevel bounds r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263244\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "76673d8e1c9224ac8e52316bc4e02223480b2a6f", "git_parents": ["3d20460a97e0689329d6320d7d1b5994fb5061bc"], "node": "d3387784b3feff8b7336dc10f3591bf811444e7b", "parents": ["453460cf0f4791f21598e50ff9bc2a8d1b49a9e4"], "tags": []}], "date": 1756844996, "git_changesets": ["3d20460a97e0689329d6320d7d1b5994fb5061bc", "76673d8e1c9224ac8e52316bc4e02223480b2a6f"], "user": "rvandermeulen@mozilla.com"}, "206": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986185. r=aosmond a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263287\n", "files": ["gfx/layers/ipc/CanvasTranslator.cpp"], "git_node": "c07482a24d6cca6db7c577bde69cbd94e23f9718", "git_parents": ["76673d8e1c9224ac8e52316bc4e02223480b2a6f"], "node": "94e160d25a3cd34ba10eebece1b6a8cbff8f616e", "parents": ["d3387784b3feff8b7336dc10f3591bf811444e7b"], "tags": []}], "date": 1756852637, "git_changesets": ["c07482a24d6cca6db7c577bde69cbd94e23f9718"], "user": "rvandermeulen@mozilla.com"}, "207": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1985747 - Allow toolbarspring to shrink to 1px in the nav-bar again.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262927\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263573\n", "files": ["browser/themes/shared/toolbarbuttons.css"], "git_node": "b6ae9b266ef856928e9c8cfd798dca4bb4bc6c4a", "git_parents": ["c07482a24d6cca6db7c577bde69cbd94e23f9718"], "node": "bcc225930db72f6cd58175cfcac4d3993d336c0a", "parents": ["94e160d25a3cd34ba10eebece1b6a8cbff8f616e"], "tags": []}], "date": 1756943997, "git_changesets": ["b6ae9b266ef856928e9c8cfd798dca4bb4bc6c4a"], "user": "rvandermeulen@mozilla.com"}, "208": {"changesets": [{"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976006 - Fix moz- input labels when localisation changes  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258995\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263495\n", "files": ["toolkit/content/tests/widgets/test_moz_base_input_element.html", "toolkit/content/tests/widgets/test_moz_label.html", "toolkit/content/widgets/lit-utils.mjs", "toolkit/content/widgets/moz-label/moz-label.mjs"], "git_node": "cd516e806e7e73d1e9d11a83c384790166af6ae0", "git_parents": ["b6ae9b266ef856928e9c8cfd798dca4bb4bc6c4a"], "node": "8b5160ab5b82b357a2db6b1f1ac361d6e57e85e8", "parents": ["bcc225930db72f6cd58175cfcac4d3993d336c0a"], "tags": []}], "date": 1756944049, "git_changesets": ["cd516e806e7e73d1e9d11a83c384790166af6ae0"], "user": "rvandermeulen@mozilla.com"}, "209": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1970490: Use loading principal (rather than triggering principal) for CORS checks, by default. a=RyanVM\n\nThis is essentially a backout of bug 1496505, putting its change behind a new\noff-by-default about:config pref[1] for now, in case there are use cases that\nrequire it.\n\n[1] content.cors.use_triggering_principal\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252611\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263611\n", "files": ["dom/security/nsContentSecurityManager.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/test/unit/xpcshell.toml"], "git_node": "b75ffdc7ab20914209f126fe0d06b0e242b2a6c6", "git_parents": ["cd516e806e7e73d1e9d11a83c384790166af6ae0"], "node": "1a2c74aed0dbc64a5b543472d7e22c48cb79cda4", "parents": ["8b5160ab5b82b357a2db6b1f1ac361d6e57e85e8"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1985652: Use triggeringPrincipal rather than loadingPrincipal for CORS checks, if triggeringPrincipal is from an extension. a=RyanVM\n\nThis allows extensions to access their own content from scripts that they\ninjected into web pages, without that requested content being automatically\nblocked due to failing CORS checks (since the Origin of the request is\nthe web page).\n\nWe have an existing pref 'extensions.content_web_accessible.enabled' whose\n'false' value is meant to allow MV2 extensions to access their own resources\nfrom their content-scripts (even if those resources aren't web-exposed). A\nrecent CORS strictness patch broke this use-case; so this patch relaxes the\nstrictness, specifically for extensions and specifically when that pref has\nthe permissive 'false' value.\n\nWhile we're at it, this patch extends the related xpcshell test cover the case\nwhere the pref is in its default/permissive 'false' configuration (to test the\nregression being addressed by this patch), and to test that MV3 is strict under\nthat configuration. This patch also clarifies the other relevant pref for CORS\nprincipal-selection to avoid implying that it's relevant to WebExtensions\n(since it's not anymore).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262863\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263613\n", "files": ["dom/security/nsContentSecurityManager.cpp", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/extensions/test/xpcshell/test_ext_contentscript_module_import.js"], "git_node": "59758e6b1de0ec26f909f570ae0087fd438313f2", "git_parents": ["b75ffdc7ab20914209f126fe0d06b0e242b2a6c6"], "node": "ef9cc44911abbed45a30d15ea47299567fd3408c", "parents": ["1a2c74aed0dbc64a5b543472d7e22c48cb79cda4"], "tags": []}], "date": 1756957182, "git_changesets": ["b75ffdc7ab20914209f126fe0d06b0e242b2a6c6", "59758e6b1de0ec26f909f570ae0087fd438313f2"], "user": "rvandermeulen@mozilla.com"}, "210": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263710\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "424180bd8b71164ed77faca8610478afaa820364", "git_parents": ["59758e6b1de0ec26f909f570ae0087fd438313f2"], "node": "cb7127352a58c1380adb214fb156d461012a47e6", "parents": ["ef9cc44911abbed45a30d15ea47299567fd3408c"], "tags": []}], "date": 1756993428, "git_changesets": ["424180bd8b71164ed77faca8610478afaa820364"], "user": "rvandermeulen@mozilla.com"}, "211": {"changesets": [{"author": "Joel Maher \u003cjoel.maher@gmail.com\u003e", "branch": "default", "desc": "Bug 1983773 - Do not collect full test info data on branches other than try/central.  a=RyanVM DONTBUILD\n\nnot sure this should be reviewed, it is supposed to be https://phabricator.services.mozilla.com/D263609\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263775\n", "files": ["testing/testinfo.py"], "git_node": "dbbe73f5d783c10665c4d8a9865d2a4b404dbb38", "git_parents": ["424180bd8b71164ed77faca8610478afaa820364"], "node": "e0e54041fe43ae5cc7a44da1566a4d3c862cdc62", "parents": ["cb7127352a58c1380adb214fb156d461012a47e6"], "tags": []}], "date": 1757007254, "git_changesets": ["dbbe73f5d783c10665c4d8a9865d2a4b404dbb38"], "user": "rvandermeulen@mozilla.com"}, "212": {"changesets": [{"author": "Steven Michaud \u003csmichaud@pobox.com\u003e", "branch": "default", "desc": "Bug 1986701 - Link mChildView only after mNativeLayerRoot is initialized.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D263616\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263736\n", "files": ["widget/cocoa/nsCocoaWindow.mm"], "git_node": "1c0eec24812e3f4be6cfee50823b6aad9e747340", "git_parents": ["dbbe73f5d783c10665c4d8a9865d2a4b404dbb38"], "node": "156d5cbbcf1b8896a69c090bab72434d09f1b04a", "parents": ["e0e54041fe43ae5cc7a44da1566a4d3c862cdc62"], "tags": []}], "date": 1757036807, "git_changesets": ["1c0eec24812e3f4be6cfee50823b6aad9e747340"], "user": "rvandermeulen@mozilla.com"}, "213": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1986191. Work around a null mScrollContainerFrame in an active scrolled root.  a=RyanVM\n\nWe should not have a null mScrollContainerFrame in an asr that is in use, but we are getting crashes in bug 1764863 that show that this is happening at volume. We have not been successful over a long period of time of finding a testcase or some way to reproduce. We have a landed patch in bug 1984898 (based on a pernosco of one instance of this from a few years back) that we hope fixes some or most of these. The patch in bug 1984898 is a little bit big, and we have no evidence that it fixes the problem. So I am proposing this patch as something we can uplift that should work around the problem. We still want to fix any instances of that this we come across so the MOZ_DIAGNOSTIC_ASSERT will fire in nightly and early beta builds. The gfxCriticalNoteOnce will alert us if this is having negative consequences later on.\n\nBy returning false we will abort the partial display list update and delete the retained display list that contains an asr that has a null mScrollContainerFrame and we will do a full rebuild. This should avoid the problem and be much better than crashing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D263224\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263820\n", "files": ["layout/painting/RetainedDisplayListBuilder.cpp"], "git_node": "a6603c3ef3315511b77f22416c5d2b2cafa87b0f", "git_parents": ["1c0eec24812e3f4be6cfee50823b6aad9e747340"], "node": "57581b9b56f9245fb8e9f78b436197839945b15a", "parents": ["156d5cbbcf1b8896a69c090bab72434d09f1b04a"], "tags": []}], "date": 1757036856, "git_changesets": ["a6603c3ef3315511b77f22416c5d2b2cafa87b0f"], "user": "rvandermeulen@mozilla.com"}, "214": {"changesets": [{"author": "Fatih Kilic \u003cme@fklc.dev\u003e", "branch": "default", "desc": "Bug 1985073 - Fix the thread-safety issues with canvas permission prompting. a=RyanVM\n\nPreviously, as seen, I wrote some horrible code. This patch intends to fix the thread safety issue in the permission prompt code for OffscreenCanvas.\n\nFor context, with privacy.fingerprintingProtection=True and privacy.fingerprintingProtection.overrides=\"+CanvasImageExtractionPrompt\", when a canvas is read, we randomize the data, and return the randomized data. At the same time, we show a permission prompt asking the user if they want to allow the website to read the canvas data without randomization. It is a non-blocking prompt (i.e. we allow further canvas reads, it just keeps adding the randomization).\n\nWe have two types of canvases. HTMLCanvasElement and OffscreenCanvas. The former is used in the main thread, the latter can be used in both the main thread and worker threads.\n\nTo ask for permission, we need to communicate with the parent process with the correct window. However, accessing window from a worker thread is not thread safe. We need to dispatch to the main thread to access the window.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262475\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263138\n", "files": ["dom/canvas/CanvasUtils.cpp"], "git_node": "c674f99b18e6ea87214392907f690dc4d0e08b3a", "git_parents": ["a6603c3ef3315511b77f22416c5d2b2cafa87b0f"], "node": "bceab3dde2c2a1d23a92a3947b835e4f020a32d7", "parents": ["57581b9b56f9245fb8e9f78b436197839945b15a"], "tags": []}, {"author": "Fatih Kilic \u003cme@fklc.dev\u003e", "branch": "default", "desc": "Bug 1986031 - Use GetAncestorWindow instead of GetWindow in OffscreenCanvasPromptRunnable to allow prompting from nested workers. r=tjr a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263136\n", "files": ["dom/canvas/CanvasUtils.cpp"], "git_node": "bc7689a03693c984e5a56690ce7c6625d6ba0e77", "git_parents": ["c674f99b18e6ea87214392907f690dc4d0e08b3a"], "node": "97b5967d5511813a687052bd29b326219c2c845a", "parents": ["bceab3dde2c2a1d23a92a3947b835e4f020a32d7"], "tags": []}], "date": 1757106097, "git_changesets": ["c674f99b18e6ea87214392907f690dc4d0e08b3a", "bc7689a03693c984e5a56690ce7c6625d6ba0e77"], "user": "rvandermeulen@mozilla.com"}, "215": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986539 - Update l10n-changesets on ESR140. a=RyanVM DONTBUILD\n", "files": ["browser/locales/l10n-changesets.json"], "git_node": "b5c40204b0ced8d3ac26b06bf162318d19a0ad96", "git_parents": ["bc7689a03693c984e5a56690ce7c6625d6ba0e77"], "node": "aff8ab27139911c24e7c2027be6d4aac922bf8df", "parents": ["97b5967d5511813a687052bd29b326219c2c845a"], "tags": []}], "date": 1757333281, "git_changesets": ["b5c40204b0ced8d3ac26b06bf162318d19a0ad96"], "user": "rvandermeulen@mozilla.com"}, "216": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D264058\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "228d3bd24dcd1ad5a8051d27cd377d99361b32c3", "git_parents": ["b5c40204b0ced8d3ac26b06bf162318d19a0ad96"], "node": "1d701f7dfed0b1e23be0f5b318d8f2b4f9c0a0b8", "parents": ["aff8ab27139911c24e7c2027be6d4aac922bf8df"], "tags": []}], "date": 1757333498, "git_changesets": ["228d3bd24dcd1ad5a8051d27cd377d99361b32c3"], "user": "rvandermeulen@mozilla.com"}, "217": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986417 - Try to ensure regional flags (encoded with WAVING BLACK FLAG + tag letters) render properly.  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D263906\n", "files": ["gfx/thebes/gfxTextRun.cpp", "layout/reftests/font-matching/reftest.list", "layout/reftests/font-matching/regional-flags-notref.html", "layout/reftests/font-matching/regional-flags.html"], "git_node": "da94da9a9153ac7a6e6c9bfb04b5c2498fff30fb", "git_parents": ["228d3bd24dcd1ad5a8051d27cd377d99361b32c3"], "node": "8519df17450ed3edcfd5807173605d5ca523b556", "parents": ["1d701f7dfed0b1e23be0f5b318d8f2b4f9c0a0b8"], "tags": []}], "date": 1757346724, "git_changesets": ["da94da9a9153ac7a6e6c9bfb04b5c2498fff30fb"], "user": "rvandermeulen@mozilla.com"}, "218": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973900 - Remove support for the codebase attribute from \u003cobject\u003e. r=farre,dom-core a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254958\n", "files": ["dom/base/nsObjectLoadingContent.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/tests/html/semantics/embedded-content/the-object-element/historical.html"], "git_node": "2ea021b9473a0690d1cfafc5fa12b901a27fe43a", "git_parents": ["da94da9a9153ac7a6e6c9bfb04b5c2498fff30fb"], "node": "21285e5fdf030ee5df4e371b921ba4d985477aff", "parents": ["8519df17450ed3edcfd5807173605d5ca523b556"], "tags": ["FIREFOX_140_3_0esr_BUILD1", "FIREFOX_140_3_0esr_RELEASE"]}], "date": 1757355912, "git_changesets": ["2ea021b9473a0690d1cfafc5fa12b901a27fe43a"], "user": "rvandermeulen@mozilla.com"}}
}";