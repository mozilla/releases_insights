rs", "third_party/rust/nix/test/sys/test_socket.rs", "third_party/rust/nix/test/sys/test_sockopt.rs", "third_party/rust/nix/test/sys/test_stat.rs", "third_party/rust/nix/test/sys/test_termios.rs", "third_party/rust/nix/test/sys/test_uio.rs", "third_party/rust/nix/test/test.rs", "third_party/rust/nix/test/test_dir.rs", "third_party/rust/nix/test/test_fcntl.rs", "third_party/rust/nix/test/test_net.rs", "third_party/rust/nix/test/test_pty.rs", "third_party/rust/nix/test/test_sendfile.rs", "third_party/rust/nix/test/test_spawn.rs", "third_party/rust/nix/test/test_stat.rs", "third_party/rust/nix/test/test_syslog.rs", "third_party/rust/nix/test/test_unistd.rs", "toolkit/crashreporter/crash_helper_client/Cargo.toml", "toolkit/crashreporter/crash_helper_common/Cargo.toml", "toolkit/crashreporter/crash_helper_server/Cargo.toml"], "git_node": "9e514a4382b7b3384edfef46343d4c39d0d3912e", "git_parents": ["714b7245e2405a749b6cac7be71bc7c7c1f72528"], "node": "aabb6511bdcac47c8be6dd1f67fd56986a609830", "parents": ["4458488be481f7c997da24b60574b49279c5f9ce"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977514 - Use nix 0.30.x in the crash helper code  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258708\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262345\n", "files": ["toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/macos.rs", "toolkit/crashreporter/crash_helper_server/Cargo.toml"], "git_node": "6357fac547c8cfcdd3f49cbcdd4593fa2e90ba0b", "git_parents": ["9e514a4382b7b3384edfef46343d4c39d0d3912e"], "node": "5c54f8a868a29f3b6cc0531a9fcd66fa10f9d5c2", "parents": ["aabb6511bdcac47c8be6dd1f67fd56986a609830"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977514 - Use posix_spawn() when launching the crash helper to work around an issue with fork() on macOS 10.15  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258709\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262346\n", "files": ["toolkit/crashreporter/crash_helper_client/src/platform/unix.rs", "toolkit/crashreporter/crash_helper_server/src/lib.rs"], "git_node": "ac82b5a387cda89b41c9c85f93477e5c9d4632e8", "git_parents": ["6357fac547c8cfcdd3f49cbcdd4593fa2e90ba0b"], "node": "f8c5f5488e81c9eb01ce386945b939efe2cdc303", "parents": ["5c54f8a868a29f3b6cc0531a9fcd66fa10f9d5c2"], "tags": []}], "date": 1756142955, "git_changesets": ["9e514a4382b7b3384edfef46343d4c39d0d3912e", "6357fac547c8cfcdd3f49cbcdd4593fa2e90ba0b", "ac82b5a387cda89b41c9c85f93477e5c9d4632e8"], "user": "rvandermeulen@mozilla.com"}, "183": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980225 - fix race condition with content analysis and printing to file  a=RyanVM DONTBUILD\n\nWith content analysis active, if a DLP agent pops up a dialog but allows\nthe print to happen (for example, when responding REPORT_ONLY), this can\ncause ::StartDocW() to fail for \"printer\"s that pop open a dialog for the\nuser to choose where to save the file. (i.e. Microsoft Print to PDF)\n\nAfter trying some various hacks, the one that worked was calling\nSetForegroundWindow() on a Firefox window before calling ::StartDocW().\nIt even works if the Firefox window that we call SetForegroundWindow()\nisn't the one that the print is happening in. (which I verified by starting\na print and then quickly clicking on another window)\n\nI put this behind a pref just in case this causes problems in the future,\nbut I doubt it will.\n\nI also reverted the previous attempt to fix this by calling\n::LockSetForegroundWindow(), which does not work.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D261572\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262385\n", "files": ["gfx/thebes/PrintTargetWindows.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "64d0b9989230caf37d05103d564ce743a8d09c1b", "git_parents": ["ac82b5a387cda89b41c9c85f93477e5c9d4632e8"], "node": "4f5e997c552ce9397574e7e7157f06a3b894a901", "parents": ["f8c5f5488e81c9eb01ce386945b939efe2cdc303"], "tags": []}], "date": 1756151527, "git_changesets": ["64d0b9989230caf37d05103d564ce743a8d09c1b"], "user": "rvandermeulen@mozilla.com"}, "184": {"changesets": [{"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1957680 - Trigger a fake scrollend event in case it hasn't been triggered by the browser in the pdf viewer  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262320\n", "files": ["toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs"], "git_node": "2782b9db1dab2904c598cfe9f50dd4fa5399110f", "git_parents": ["64d0b9989230caf37d05103d564ce743a8d09c1b"], "node": "2b958aa97257f8930f2330cea99e6bfa7eaaa062", "parents": ["4f5e997c552ce9397574e7e7157f06a3b894a901"], "tags": []}], "date": 1756151605, "git_changesets": ["2782b9db1dab2904c598cfe9f50dd4fa5399110f"], "user": "rvandermeulen@mozilla.com"}, "185": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984014 - Check for untransformed OP_SOURCE rectangles when drawing. r=aosmond a=RyanVM DONTBUILD\n\nSometimes we submit rectangles for drawing without a transform to bypass the transform.\nHowever, for OP_SOURCE, we expected there to always be a transform to check when to clear\nthe background. This fixes the OP_SOURCE check to account for untransformed rects.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261805\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/test/reftest/1984014-1-ref.html", "dom/canvas/test/reftest/1984014-1.html", "dom/canvas/test/reftest/reftest.list"], "git_node": "7c14b878296879b79ca587389bcde5bb2145e802", "git_parents": ["2782b9db1dab2904c598cfe9f50dd4fa5399110f"], "node": "254b75e2ce38203243a0d2a43c23a63d8e8a4e01", "parents": ["2b958aa97257f8930f2330cea99e6bfa7eaaa062"], "tags": []}], "date": 1756165112, "git_changesets": ["7c14b878296879b79ca587389bcde5bb2145e802"], "user": "rvandermeulen@mozilla.com"}, "186": {"changesets": [{"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984544 - upgrade NSS to NSS_3_112_1_RTM. r=keeler a=RyanVM UPGRADE_NSS_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262051\n", "files": ["security/nss/doc/rst/releases/nss_3_112_1.rst", "security/nss/lib/dev/devtoken.c", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h", "security/nss/moz.yaml"], "git_node": "d4b467bd4f6f63d3c85c3b271e48560e7983570f", "git_parents": ["7c14b878296879b79ca587389bcde5bb2145e802"], "node": "f4bcca377b5c2d9a2f96e220b35a46d6b87e9d97", "parents": ["254b75e2ce38203243a0d2a43c23a63d8e8a4e01"], "tags": []}], "date": 1756165295, "git_changesets": ["d4b467bd4f6f63d3c85c3b271e48560e7983570f"], "user": "rvandermeulen@mozilla.com"}, "187": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1980356: Don't block in window.print() if there's a registered mozPrintCallback (e.g. for PDF.js) and if any sort of print dialog might be up.  a=RyanVM\n\nBefore this patch, we would unconditionally block in window.print() if the user\nhad the system print dialog enabled.  That was problematic because it prevents\nmozPrintCallback from doing asynchronous work, as described in the nearby\ncode-comment, and this resulted in PDFs printing blank for such users if they\nused the \"print\" button (which triggered window.print()).\n\nThis patch makes the print.prefer_system_dialog codepath share the same logic\nflow as the regular-print-preview codepath -- now we will *not* block if\nthere's a registered print callback (which allows the callback's microtasks to\nproceed while the print dialog is still up).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D261296\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262703\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "testing/web-platform/mozilla/meta/dom/window-print-mozPrintCallback-async-001.html.ini", "testing/web-platform/mozilla/tests/dom/window-print-mozPrintCallback-async-001.html"], "git_node": "0f04bc47ad8e50b355c5f50f3ea9df34455bcbd1", "git_parents": ["d4b467bd4f6f63d3c85c3b271e48560e7983570f"], "node": "4a22ddc38010de5415735eeb9bfaaa87627ed949", "parents": ["f4bcca377b5c2d9a2f96e220b35a46d6b87e9d97"], "tags": []}], "date": 1756263895, "git_changesets": ["0f04bc47ad8e50b355c5f50f3ea9df34455bcbd1"], "user": "rvandermeulen@mozilla.com"}, "188": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1979502 - Check slices vector not empty before accessing the last slice r=sfink a=RyanVM\n\n|aborted| is reset to false at the end of a slice but\nGCRuntime::waitBackgroundSweepEnd can be called outside of a slice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260685\n", "files": ["js/src/gc/Statistics.cpp"], "git_node": "d96c994e954ec69ea9d79b0383b013eadb2848a8", "git_parents": ["0f04bc47ad8e50b355c5f50f3ea9df34455bcbd1"], "node": "43b4033ea3e9b4590fcad9d8d85ac7fca0a514ad", "parents": ["4a22ddc38010de5415735eeb9bfaaa87627ed949"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981280 - Make nursery owned bitmap atomic. a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262760\n", "files": ["js/src/gc/BufferAllocator.cpp"], "git_node": "cf6e739fbc149ea4cae20fca91e671ddd1fc8bb0", "git_parents": ["d96c994e954ec69ea9d79b0383b013eadb2848a8"], "node": "ec05dda5cec3312ee96a2939fa489aa5aa73fa74", "parents": ["43b4033ea3e9b4590fcad9d8d85ac7fca0a514ad"], "tags": []}], "date": 1756296756, "git_changesets": ["d96c994e954ec69ea9d79b0383b013eadb2848a8", "cf6e739fbc149ea4cae20fca91e671ddd1fc8bb0"], "user": "rvandermeulen@mozilla.com"}, "189": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976207 - Allow mozilla::BitSet to use atomic storage r=glandium a=RyanVM\n\nThis patch relaxes the restriction on BitSet so that it can take\nmozilla::Atomic as its storage type.\n\nThe Reference assignment operator is changed so that it results in a single\nupdate rather than a separate read and update that would not be atomic when\nused with atomic storage.\n\nTests are added for atomic storage and to exercise the assignment operator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259230\n", "files": ["mfbt/Atomics.h", "mfbt/BitSet.h", "mfbt/tests/TestBitSet.cpp"], "git_node": "08142458c825808966f632b4587dd6272ff52483", "git_parents": ["cf6e739fbc149ea4cae20fca91e671ddd1fc8bb0"], "node": "9e99cb7b25719d5b7ccff6f24a86fedb7fb3c1a2", "parents": ["ec05dda5cec3312ee96a2939fa489aa5aa73fa74"], "tags": []}], "date": 1756299041, "git_changesets": ["08142458c825808966f632b4587dd6272ff52483"], "user": "rvandermeulen@mozilla.com"}, "190": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1985216 - fetch from ftpmirror.gnu.org. r=firefox-build-system-reviewers,sylvestre,ahochheiden a=release\n\nftp.gnu.org is struggling, so use a mirror for hopefully better reliability.\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "cc71f694e8c4529f4fe13c58cd656ed5dac0e700", "git_parents": ["08142458c825808966f632b4587dd6272ff52483"], "node": "ffc167b082396d137a60371067f1df575f0cd723", "parents": ["9e99cb7b25719d5b7ccff6f24a86fedb7fb3c1a2"], "tags": []}], "date": 175634073