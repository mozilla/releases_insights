urity/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "3a97f37e31fbc9de7ba03c6a33d6499562110dcd", "git_parents": ["a45cba7ea5831ad85e5be2be5caa507077ad1676"], "node": "0ea376ed40087018298f09a3e4bef33913ed3767", "parents": ["f755fc70709f574f701379ef52a6e7713bb7c889"], "tags": []}], "date": 1755792739, "git_changesets": ["a45cba7ea5831ad85e5be2be5caa507077ad1676", "3a97f37e31fbc9de7ba03c6a33d6499562110dcd"], "user": "rvandermeulen@mozilla.com"}, "168": {"changesets": [{"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1980730 - Trace dispatched tasks on worklets.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D260817\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261535\n", "files": ["dom/worklet/WorkletThread.cpp"], "git_node": "6dc01ca59a1f6270a45d758dd30442bd5bb79340", "git_parents": ["3a97f37e31fbc9de7ba03c6a33d6499562110dcd"], "node": "c66320b3e0086b5df5cbebc89254c3ee5abf289d", "parents": ["0ea376ed40087018298f09a3e4bef33913ed3767"], "tags": []}], "date": 1755793835, "git_changesets": ["6dc01ca59a1f6270a45d758dd30442bd5bb79340"], "user": "rvandermeulen@mozilla.com"}, "169": {"changesets": [{"author": "Narcis Beleuzu \u003cnbeleuzu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1944610 - Adjust windows tasks to use updated dir for hgstore. r=#taskgraph-reviewers\" for causing windows oom failures\n\nThis reverts commit 38dedc07e1e08f0e70893e702addd885ad67ba11.\n", "files": ["taskcluster/gecko_taskgraph/transforms/job/common.py"], "git_node": "3a108ff2cd7a9a82f02131ea79b62bb5a2ab5412", "git_parents": ["6dc01ca59a1f6270a45d758dd30442bd5bb79340"], "node": "d4e65d4fde02e17eadfe34736ec2b8850dc39b4a", "parents": ["c66320b3e0086b5df5cbebc89254c3ee5abf289d"], "tags": []}], "date": 1755806263, "git_changesets": ["3a108ff2cd7a9a82f02131ea79b62bb5a2ab5412"], "user": "nbeleuzu@mozilla.com"}, "170": {"changesets": [{"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1978317 - Fix the xref table with the ref in a xref stream  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261981\n", "files": ["toolkit/components/pdfjs/content/build/pdf.worker.mjs"], "git_node": "8361c7b38049bf36327f566a236ed5e13aded505", "git_parents": ["3a108ff2cd7a9a82f02131ea79b62bb5a2ab5412"], "node": "9d1adb3c590062c97450e6bcd3212ec407e4553c", "parents": ["d4e65d4fde02e17eadfe34736ec2b8850dc39b4a"], "tags": []}], "date": 1755825532, "git_changesets": ["8361c7b38049bf36327f566a236ed5e13aded505"], "user": "rvandermeulen@mozilla.com"}, "171": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970805 - Remove validity check from Translator::GetCurrentDrawTarget to avoid aborting print-job playback, and add drawtarget-validity checks to more methods in DrawTargetCairo.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255099\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261880\n", "files": ["gfx/2d/DrawTargetCairo.cpp", "gfx/2d/RecordedEvent.h", "testing/web-platform/meta/css/printing/huge-font-crash-print.html.ini"], "git_node": "251e895995b850a96bf2115e62d7b37cc963788f", "git_parents": ["8361c7b38049bf36327f566a236ed5e13aded505"], "node": "8fe3233e4df4f0ae62cdb5ebae40d291be69c74a", "parents": ["9d1adb3c590062c97450e6bcd3212ec407e4553c"], "tags": []}], "date": 1755825576, "git_changesets": ["251e895995b850a96bf2115e62d7b37cc963788f"], "user": "rvandermeulen@mozilla.com"}, "172": {"changesets": [{"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975800 - Also run ensure_l10n_central on `build installers-*` (single locale repack)  a=RyanVM DONTBUILD\n\nIn D246824 we moved the `l10n-central` clone step out of `l10n.mk`.\nWe added it to the code path for the `package-multi-locale` command,\nbut we did not add it to `build installers-$AB_CD` command.\n\nThis made single locale repacks not download the `l10n-central` repo\nand single locales silently run without actuall doing localizations.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258311\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261995\n", "files": ["python/mozbuild/mozbuild/build_commands.py", "python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/util.py"], "git_node": "e8b179b639d8846553b0e4d3232acafe906d6d39", "git_parents": ["251e895995b850a96bf2115e62d7b37cc963788f"], "node": "98eae780233b67f2858df2ef064536f5eb52e70d", "parents": ["8fe3233e4df4f0ae62cdb5ebae40d291be69c74a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975800 - Add logging output to `ensure_l10n_central` function  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258312\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261996\n", "files": ["python/mozbuild/mozbuild/util.py"], "git_node": "d2702ecdacfb22c3080b7d9eda4ecd570dbf6166", "git_parents": ["e8b179b639d8846553b0e4d3232acafe906d6d39"], "node": "6c44be27cbc9c169978dd2fa19d0e897f5999558", "parents": ["98eae780233b67f2858df2ef064536f5eb52e70d"], "tags": []}], "date": 1755826063, "git_changesets": ["e8b179b639d8846553b0e4d3232acafe906d6d39", "d2702ecdacfb22c3080b7d9eda4ecd570dbf6166"], "user": "rvandermeulen@mozilla.com"}, "173": {"changesets": [{"author": "Fatih Kilic \u003cme@fklc.dev\u003e", "branch": "default", "desc": "Bug 1975753 - Force site specific zoom when RFPTarget::SiteSpecificZoom is active.  a=RyanVM DONTBUILD\n\nI wasn't around when RFPTarget::SiteSpecificZoom was implemented, but the current implementation is very confusing.\n\nIn Firefox, we have two modes of zoom level. Per tab zoom, and site specific zoom. It is controlled in two (maybe more) places. browser-fullZoom.js and in [CanonicalBrowsingContext.cpp](https://searchfox.org/mozilla-central/rev/ac81a39dfe0663eb40a34c7c36d89e34be29cb20/docshell/base/CanonicalBrowsingContext.cpp#285-289).\n\nOur current implementation disables site specific zoom in `browser-fullZoom.js` by checking the RFP target, but it doesn't modify `CanonicalBrowsingContext.cpp`. So,`CanonicalBrowsingContext` still thinks we are using site specific zoom.\n\nPre-bug1914149 this method worked because we didn't keep/inherit zoom level across navigations. Post-bug1914149, it no longer works because we keep the zoom level across navigations in `CanonicalBrowsingContext` and let `browser-fullZoom.js` reset to its correct value back.\n\nThe issue is caused because `CanonicalBrowsingContext` keeps the previous page's zoom level, but `browser-fullZoom.js` thinks we use tab zoom mode, so it doesn't bother setting the zoom level for the site/page. So, we end up keeping the zoom level.\n\nThe solution here I'm suggesting is, doing the opposite of what we are doing in `browser-fullZoom.js`. So, now we should force SiteSpecificZoom with RFP. The reason I'm suggesting this is because within the same site, even acrss tabs, we persist cookies, so fingerprinting isn't much of concern here. We also don't persist zoom levels in private browsing. So, linking normal to PBM isn't a concern either.\n\nSo, in summary,\n- If you open the same site, in 100 tabs, all of them will get the same zoom level with this patch (just like default normal Firefox)\n- If you are in PBM, the zoom level is NOT persisted.\n- If you are in normal browsing, the zoom level is persisted, but so are cookies.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257497\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261948\n", "files": ["browser/components/resistfingerprinting/test/browser/browser.toml", "browser/components/resistfingerprinting/test/browser/browser_bug1369357_site_specific_zoom_level.js", "browser/components/resistfingerprinting/test/browser/browser_bug1975753_site_specific_zoom_level.js", "browser/components/tabbrowser/content/browser-fullZoom.js", "toolkit/components/cleardata/ClearDataService.sys.mjs"], "git_node": "b848b2b57194aafb46396e986d5edb2eea51cf7d", "git_parents": ["d2702ecdacfb22c3080b7d9eda4ecd570dbf6166"], "node": "2509e243545dbaa52648e956f28af27daec8095d", "parents": ["6c44be27cbc9c169978dd2fa19d0e897f5999558"], "tags": []}], "date": 1755826119, "git_changesets": ["b848b2b57194aafb46396e986d5edb2eea51cf7d"], "user": "rvandermeulen@mozilla.com"}, "174": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1979124 - Remove thirdPartyRoots check in DoHHeuristics  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D261008\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261571\n", "files": ["security/manager/ssl/nsIX509CertDB.idl", "security/manager/ssl/nsNSSCertificateDB.cpp", "toolkit/components/doh/DoHHeuristics.sys.mjs"], "git_node": "d7d8c7ad0e85fc2f762648b35b6484ca13eb4ae1", "git_parents": ["b848b2b57194aafb46396e986d5edb2eea51cf7d"], "node": "a1257d8c043c124e56056c8145aa15f9cadc21c8", "parents": ["2509e243545dbaa52648e956f28af27daec8095d"], "tags": []}], "date": 1755826656, "git_changesets": ["d7d8c7ad0e85fc2f762648b35b6484ca13eb4ae1"], "user": "rvandermeulen@mozilla.com"}, "175": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976116 - Respect eDoNotClipToBBoxOfContentInsideClipPath in SVGUtils::GetBBox. r=longsonr a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256773\n", "files": ["layout/reftests/svg/1976116-ref.html", "layout/reftests/svg/1976116.html", "layout/reftests/svg/reftest.list", "layout/svg/SVGUtils.cpp"], "git_node": "65b22a4883cfd4dde47adc4673edc3b768e6d3f4", "git_parents": ["d7d8c7ad0e85fc2f762648b35b6484ca13eb4ae1"], "node": "1354ff1ee708780f3bf09988a247917a5a371d45", "parents": ["a1257d8c043c124e56056c8145aa15f9cadc21c8"], "tags": []}], "date": 1755827223, "git_changesets": ["65b22a4883cfd4dde47adc4673edc3b768e6d3f4"], "user": "rvandermeulen@mozilla.com"}, "176": {"changesets": [{"author": "Jacqueline Amherst \u003cjacqueline.amherst@icloud.com\u003e", "branch": "default", "desc": "Bug 1972342 - change --in-content-box-background-color to --background-color-box r=akulyk,settings-reviewers,desktop-theme-reviewers,hjones a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256467\n", "files": ["browser/themes/shared/preferences/preferences.css"], "git_node": "3a2744a0ee1e9df07011d41408af60662a265d2c", "git_parents": ["65b22a4883cfd4dde47adc4673edc3b768e6d3f4"], "node": "334ba24a5f47a403d7a31707c1d70f982326dd7e", "parents": ["1354ff1ee708780f3bf09988a247917a5a371d45"], "tags": []}], "date": 1755832498, "git_changesets": ["3a2744a0ee1e9df07011d41408af60662a265d2c"], "user": "rvandermeulen@mozilla.com"}, "177": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1980297 - Avoid setting background of visually selected tab by default. r=dao,desktop-theme-reviewers a=RyanVM\n\nThis matches better the in-content styles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259354\n", "files": ["toolkit/themes/shared/tabbox.css"], "git_node": "9e34876554b4d267809854a951a3c1f12b2f98ea", "git_parents": ["3a2744a0ee1e9df07011d41408af60662a265d2c"], "node": "8b749305cf55e55236481eeb8bdf0cfe4c00704a", "parents": ["334ba24a5f47a403d7a31707c1d70f982326dd7e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1980297 - Remove redundant in-content tab styles. r=desktop-theme-reviewers,dao a=RyanVM DONTBUILD\n\nThe selected styles match the unselected ones. Same for some of the\nforced-colors ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259355\n", "files": ["toolkit/themes/shared/in-content/common-shared.css"], "git_node": "f6e62385932eae95fa7696a8cb02153cae367797", "git_parents": ["9e34876554b4d267809854a951a3c1f12b2f98ea"], "node": "6eed480b60c34c06bb230f6cf68cee40d7ca3afd", "parents": ["8b749305cf55e55236481eeb8bdf0cfe4c00704a"], "tags": []}], "date": 1755832660, "git_changesets": ["9e34876554b4d267809854a951a3c1f12b2f98ea", "f6e62385932eae95fa7696a8cb02153cae367797"], "user": "rvandermeulen@mozilla.com"}, "178": {"changesets": [{"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965056 - for stale revalidating channel do not copy cookies. r=necko-reviewers,valentin a=RyanVM\n\nRoot Cause:\nThe issue was caused by cookie headers being copied twice. Cookies were added to the revalidating channel just before it was opened, in PerformBackgroundCacheRevalidationNow -\u003e VisitNonDefaultRequestHeaders, and then again in PrepareToConnect -\u003e AddCookiesToRequest, where cookies from the cookie service were merged with those passed during channel creation. This led to duplicate cookies being sent.\n\nFix:\nWe now skip setting cookies if the channel is for cache revalidation. This is because, at the point of opening, the channel already includes both the user\u2019s cookies and those from the cookie service. The fix is based on the assumption that by the time PerformBackgroundCacheRevalidationNow is called, cookies are already up-to-date in mRequestHead. This assumption is valid, as cookies are added in PrepareToConnect, which is always invoked before OpenCacheEntry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260268\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_stale-while-revalidate_positive.js"], "git_node": "328bfe2659a8a7f2f6e1d56d1bb07c6aafffc791", "git_parents": ["f6e62385932eae95fa7696a8cb02153cae367797"], "node": "ddb5c103161e90963b05ff7bda83ff2952cb1274", "parents": ["6eed480b60c34c06bb230f6cf68cee40d7ca3afd"], "tags": []}], "date": 1755832748, "git_changesets": ["328bfe2659a8a7f2f6e1d56d1bb07c6aafffc791"], "user": "rvandermeulen@mozilla.com"}, "179": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1969446 - Reverse the order in which the crash helper processes incoming events  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251873\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262068\n", "files": ["toolkit/crashreporter/crash_helper_server/src/ipc_server.rs"], "git_node": "713e2ee899bc5442105b2a5050dc413fe0741dc0", "git_parents": ["328bfe2659a8a7f2f6e1d56d1bb07c6aafffc791"], "node": "b13ed50506af2eeb5ad2c64bef169ab3cd420d35", "parents": ["ddb5c103161e90963b05ff7bda83ff2952cb1274"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964600 - Remove the crash helper PID from the IPC connectors  a=RyanVM\n\nThis paves the way for the daemonization of the crash helper. First of all the\nmain process won't know the PID of the crash helper process directly, as it\nwon't be a child of the main process anymore. Additionally, child processes'\nIPC channels will be created in the main process, and then both ends will be\nhanded to the crash helper and child respectively. Because of this it won't be\npossible for a child to fetch the PID of the other endpoint of the pipe (all\noperating systems record the process identifier of the process that *created*\nthe pipe as the endpoint, regardless of what process one endpoint is handed\nto afterwards).\n\nThis patch removes all references to the crash helper PID and ways to fetch it\nfrom the crash helper IPC machinery. See the following patches for how we\ndeal with authorizing certain operations now that we don't have the PIDs\nanymore.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251558\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262069\n", "files": ["toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/macos.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs", "toolkit/crashreporter/crash_helper_server/src/lib.rs"], "git_node": "7e30a25f60f4837e06f25e9d539ae1eebf56beb4", "git_parents": ["713e2ee899bc5442105b2a5050dc413fe0741dc0"], "node": "3b946efe6670d585403231a218c6e96b48602409", "parents": ["b13ed50506af2eeb5ad2c64bef169ab3cd420d35"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964600 - Move the IPC waiting and connection logic directly into the server  a=RyanVM\n\nThis is the second step towards daemonizing the crash helper process. The code\nused to listen to incoming connections and messages is moved directly into the\nserver for better coupling. New and existing connections are now categorized\nas belonging to Firefox parent process, a child process or an external process\n(typically the WER service on Windows). The permission checks on the various\nmessages are now based on these categories, instead of the PIDs of the\ncrash helper clients.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251559\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262070\n", "files": ["toolkit/crashreporter/crash_helper_common/src/ipc_poller.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_poller/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_poller/windows.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/unix.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/windows.rs"], "git_node": "e35beda67b326786186beee017dcc0bc0988c0aa", "git_parents": ["7e30a25f60f4837e06f25e9d539ae1eebf56beb4"], "node": "7c1b13f88a9ba773cbdf7ef8a90fbfbdb6cafa63", "parents": ["3b946efe6670d585403231a218c6e96b48602409"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964600 - Allow macOS crash helper IPC to pass file descriptors  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252664\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262071\n", "files": ["toolkit/crashreporter/crash_helper_common/src/breakpad.rs", "toolkit/crashreporter/crash_helper_common/src/breakpad/linux.rs", "toolkit/crashreporter/crash_helper_common/src/breakpad/macos.rs", "toolkit/crashreporter/crash_helper_common/src/breakpad/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/macos.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/unix.rs"], "git_node": "3536a141460a5cbc8e6040abdfe38ffc15cf90c5", "git_parents": ["e35beda67b326786186beee017dcc0bc0988c0aa"], "node": "f149e6108bf5935f9e611d3ccf60700bb76792f2", "parents": ["7c1b13f88a9ba773cbdf7ef8a90fbfbdb6cafa63"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964600 - Allow Windows crash helper IPC to pass handles  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254045\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262072\n", "files": ["toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/platform.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/macos.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs"], "git_node": "cddb6d587ee69a2fa399479a92103cf305112d2b", "git_parents": ["3536a141460a5cbc8e6040abdfe38ffc15cf90c5"], "node": "433cd7c210712e5c261a40ee768340b3758ca08d", "parents": ["f149e6108bf5935f9e611d3ccf60700bb76792f2"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964600 - Daemonize the crash helper process on Linux and macOS  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254046\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262073\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_client/src/platform/unix.rs", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "1ed126d2392314a191b7ee6c0ee0e1211875f247", "git_parents": ["cddb6d587ee69a2fa399479a92103cf305112d2b"], "node": "07e5bcf228a73aaa2a6c6c270fb26c78a61ca8b3", "parents": ["433cd7c210712e5c261a40ee768340b3758ca08d"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964600 - Introduce an IPC channel between child processes and the crash helper  a=RyanVM\n\nThis channel is currently only used on Linux to rendez-vous with the\ncrash helper, obtain its PID and use it to enable the process to be\ndumped when the Yama LSM is enabled. It will be used to actually request\na dump in the future, when the breakpad exception handler is removed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254047\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262074\n", "files": ["ipc/glue/GeckoChildProcessHost.cpp", "toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_client/src/platform.rs", "toolkit/crashreporter/crash_helper_client/src/platform/android.rs", "toolkit/crashreporter/crash_helper_client/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_client/src/platform/unix.rs", "toolkit/crashreporter/crash_helper_client/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/windows.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_common/src/platform.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/macos.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs", "toolkit/crashreporter/nsDummyExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.h", "toolkit/xre/GeckoArgs.h", "toolkit/xre/nsEmbedFunctions.cpp"], "git_node": "6d82d3eb47faf71eb0b393c009ad94489cd3f06f", "git_parents": ["1ed126d2392314a191b7ee6c0ee0e1211875f247"], "node": "2b5c0c505e3ba97f32c2d011d782d7c63e655bf8", "parents": ["07e5bcf228a73aaa2a6c6c270fb26c78a61ca8b3"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981002 - Crash helper leaks a unix fd on macOS and Linux that persists past tab close  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D259986\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262075\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs"], "git_node": "67e86233d3f79717fe71f73a85cbc711e3497365", "git_parents": ["6d82d3eb47faf71eb0b393c009ad94489cd3f06f"], "node": "bbb56e97a1858828453bdfc0dc60331dcd8814ce", "parents": ["2b5c0c505e3ba97f32c2d011d782d7c63e655bf8"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975853 - Fail gracefully if we cannot start the crash helper client  a=RyanVM\n\nBefore this patch if we failed to launch the crash helper client then we\nwould either freeze or crash Firefox, which is not what we want. This\nmakes sure that errors when launching the crash helper are not\ncatastrophic. Additionally, this problem was triggered on a machine that\nlaunched more than 64 child processes at startup during session restore.\nThat was a hard limit on Windows because of the limitations of\nWaitForMultipleObjects(). I adjusted the code to also handle that\ngracefully even though we don't support more than 64 child processes at\nthe moment. That's not a big deal because we're not yet using that\nparticular IPC channel, so ignoring every child process above the 63rd\ndoesn't change anything at the moment. Last but not least there was a\nsmall race in the crash helper rendez-vous that might cause Linux to\nattempt to generate a minidump before we had allowed a child process to\nallow the crash helper to ptrace() it. This was also fixed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256299\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262076\n", "files": ["ipc/glue/GeckoChildProcessHost.cpp", "toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/windows.rs"], "git_node": "7c81a53f687c524706816b358dde88575fb5a906", "git_parents": ["67e86233d3f79717fe71f73a85cbc711e3497365"], "node": "e56432f1e2ad2ab043bceb2dc93f5883d3bf8a50", "parents": ["bbb56e97a1858828453bdfc0dc60331dcd8814ce"], "tags": []}], "date": 1755879960, "git_changesets": ["713e2ee899bc5442105b2a5050dc413fe0741dc0", "7e30a25f60f4837e06f25e9d539ae1eebf56beb4", "e35beda67b326786186beee017dcc0bc0988c0aa", "3536a141460a5cbc8e6040abdfe38ffc15cf90c5", "cddb6d587ee69a2fa399479a92103cf305112d2b", "1ed126d2392314a191b7ee6c0ee0e1211875f247", "6d82d3eb47faf71eb0b393c009ad94489cd3f06f", "67e86233d3f79717fe71f73a85cbc711e3497365", "7c81a53f687c524706816b358dde88575fb5a906"], "user": "rvandermeulen@mozilla.com"}, "180": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1975696 - Revert suppression of AXTitle introduced in bug 1901324. r=Jamie a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D261165\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261203\n", "files": ["accessible/mac/mozAccessible.mm", "accessible/tests/browser/mac/browser_radio_position.js"], "git_node": "a5ebf1856ceba10cfd6d67a70860179f095bfc7e", "git_parents": ["7c81a53f687c524706816b358dde88575fb5a906"], "node": "04c0297674e2e622144e0a6a27baf385109f387b", "parents": ["e56432f1e2ad2ab043bceb2dc93f5883d3bf8a50"], "tags": []}], "date": 1755908883, "git_changesets": ["a5ebf1856ceba10cfd6d67a70860179f095bfc7e"], "user": "rvandermeulen@mozilla.com"}, "181": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262375\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "714b7245e2405a749b6cac7be71bc7c7c1f72528", "git_parents": ["a5ebf1856ceba10cfd6d67a70860179f095bfc7e"], "node": "4458488be481f7c997da24b60574b49279c5f9ce", "parents": ["04c0297674e2e622144e0a6a27baf385109f387b"], "tags": []}], "date": 1756128144, "git_changesets": ["714b7245e2405a749b6cac7be71bc7c7c1f72528"], "user": "rvandermeulen@mozilla.com"}, "182": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977514 - Updated nix to version 0.30.1  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258707\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262344\n", "files": ["Cargo.lock", "Cargo.toml", "build/rust/nix-0.29/Cargo.toml", "build/rust/nix-0.29/lib.rs", "build/rust/nix/Cargo.toml", "supply-chain/audits.toml", "third_party/rust/nix/.cargo-checksum.json", "third_party/rust/nix/CHANGELOG.md", "third_party/rust/nix/Cargo.lock", "third_party/rust/nix/Cargo.toml", "third_party/rust/nix/README.md", "third_party/rust/nix/build.rs", "third_party/rust/nix/src/dir.rs", "third_party/rust/nix/src/errno.rs", "third_party/rust/nix/src/fcntl.rs", "third_party/rust/nix/src/features.rs", "third_party/rust/nix/src/ifaddrs.rs", "third_party/rust/nix/src/lib.rs", "third_party/rust/nix/src/mount/bsd_without_apple.rs", "third_party/rust/nix/src/mqueue.rs", "third_