9e90311a75198e0"], "node": "a798f2d482bf8629cf6c8cc4e39881359b814981", "parents": ["dc3c5fb605f3c221c2f6b6c10cf14088bdee8019"], "tags": []}], "date": 1786360154, "git_changesets": ["d28d98f7d6f70de743214d41ad1f4ea9763dcd3e"], "user": "dsmith@mozilla.com"}, "1548": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045635 - Validate more fields for nsDocShellLoadState. r=dom-core-reviewers,smaug\" a=backout\n\nThis reverts commit 525c000aa563248de81cb15fb3008fb14ad15acc.\n", "files": ["docshell/base/nsDocShellLoadState.cpp", "dom/security/nsContentSecurityManager.cpp"], "git_node": "728f67000d4541cfa8b7242da3e10309d9984fa6", "git_parents": ["d28d98f7d6f70de743214d41ad1f4ea9763dcd3e"], "node": "55e8ed4b9cc56968d65c754d0622998edfc8002b", "parents": ["a798f2d482bf8629cf6c8cc4e39881359b814981"], "tags": []}], "date": 1786374136, "git_changesets": ["728f67000d4541cfa8b7242da3e10309d9984fa6"], "user": "dsmith@mozilla.com"}, "1549": {"changesets": [{"author": "Benjamin VanderSloot \u003cbvandersloot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027819 - Use EffectiveStoragePrincipal for Quota operations and IndexedDB file references -  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290959\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317649\n", "files": ["dom/quota/PrincipalUtils.cpp", "dom/quota/StorageManager.cpp", "dom/workers/WorkerPrivate.cpp"], "git_node": "d7c83dcf39b9c7f5624b47a6b571a35bfa52cd5a", "git_parents": ["728f67000d4541cfa8b7242da3e10309d9984fa6"], "node": "9bef367ad21778b449e4d4903b9a244d6e4fd577", "parents": ["55e8ed4b9cc56968d65c754d0622998edfc8002b"], "tags": []}], "date": 1786395661, "git_changesets": ["d7c83dcf39b9c7f5624b47a6b571a35bfa52cd5a"], "user": "dsmith@mozilla.com"}, "1550": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 1: Add tests for push subscribes  a=diannaS\n\nThis mostly copies the same tests from notifications.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315057\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317280\n", "files": ["testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/worker-subscribe.https.window.js.ini", "testing/web-platform/tests/push-api/cross-origin-nested.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-same-site-request.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-serviceworker.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/resources/cross-origin-nested-child.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-nested-parent.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-serviceworker-iframe.sub.html", "testing/web-platform/tests/push-api/resources/permission-helper.js", "testing/web-platform/tests/push-api/resources/permission-sw.js", "testing/web-platform/tests/push-api/resources/permission-worker.js", "testing/web-platform/tests/push-api/worker-subscribe.https.window.js"], "git_node": "55bd9844e4fefd10f3c14d6bd8c8f75ce2fe0858", "git_parents": ["d7c83dcf39b9c7f5624b47a6b571a35bfa52cd5a"], "node": "58783e3c8f5ae78c66c82fec7fe056d8a03985f2", "parents": ["9bef367ad21778b449e4d4903b9a244d6e4fd577"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 2: Disallow retrieving push subscription in partitioned worker  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315058\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317281\n", "files": ["dom/push/PushManager.cpp", "dom/push/test/mochitest.toml", "testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini"], "git_node": "f29bc4875bb19de0c0c18e675a5a0a73ca126171", "git_parents": ["55bd9844e4fefd10f3c14d6bd8c8f75ce2fe0858"], "node": "cdce7183fa1b3f23a64ba51920448f485f69daba", "parents": ["58783e3c8f5ae78c66c82fec7fe056d8a03985f2"], "tags": []}], "date": 1786395709, "git_changesets": ["55bd9844e4fefd10f3c14d6bd8c8f75ce2fe0858", "f29bc4875bb19de0c0c18e675a5a0a73ca126171"], "user": "dsmith@mozilla.com"}, "1551": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2052401 - Guard AudioCallbackDriver::mAudioStream with a DataMutex.  a=diannaS DONTBUILD\n\nAudioOutputLatency() reads mAudioStream from the main thread\n(AudioContext.getOutputTimestamp()), while Init() writes it on the\nCubebOperation thread with no synchronization.\n\nEvery other access to mAudioStream is already CubebOperation-thread-only,\nso wrap it in a DataMutex, matching the existing mFallback pattern in this\nfile, rather than e.g. caching a latency value (which can change over the\nstream's life). The real-time audio callback thread never touches\nmAudioStream, so this lock is never contended on that path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310300\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317496\n", "files": ["dom/media/GraphDriver.cpp", "dom/media/GraphDriver.h"], "git_node": "2bdb060d502aa1f0f61d257506eba8a6cb02289f", "git_parents": ["f29bc4875bb19de0c0c18e675a5a0a73ca126171"], "node": "7bf7a0c7c8e69465d20c57601144b3f6830e5576", "parents": ["cdce7183fa1b3f23a64ba51920448f485f69daba"], "tags": []}], "date": 1786415356, "git_changesets": ["2bdb060d502aa1f0f61d257506eba8a6cb02289f"], "user": "dsmith@mozilla.com"}, "1552": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2061794.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317311\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317315\n", "files": ["netwerk/protocol/http/InterceptedHttpChannel.cpp"], "git_node": "28124d7814d7fa55a3c45fea8b611808896a7e5e", "git_parents": ["2bdb060d502aa1f0f61d257506eba8a6cb02289f"], "node": "a8a5bbd1de5b3db0ed473706a2b522deb5ba6ef6", "parents": ["7bf7a0c7c8e69465d20c57601144b3f6830e5576"], "tags": []}], "date": 1786415384, "git_changesets": ["28124d7814d7fa55a3c45fea8b611808896a7e5e"], "user": "dsmith@mozilla.com"}, "1553": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047853: Persisting response credential type in cache entries table.   a=diannaS DONTBUILD\n\nThis re-lands D311986, backed out from esr153 in b81b4a1b1f41 for crashing\nevery dom/cache xpcshell migration test, and squashes in the Bug 2009295\nschema migration it depends on.\n\nRoot cause: D311986 bumps kLatestSchemaVersion from 29 to 31 but registers\nonly MigrateFrom30To31. Schema version 30 comes from Bug 2009295 (D278397),\nwhich adds the response_headers(entry_id, name) index and was never uplifted\nto esr153. With nothing registered for version 29, Migrate() walked a database\nup to 29, found no matching entry in sMigrationList, and looped without the\nversion advancing:\n\n  Assertion failure: currentVersion \u003e lastVersion, at dom/cache/DBSchema.cpp:2659\n\nOn the release channel MOZ_DIAGNOSTIC_ASSERT is compiled out, so this is an\ninfinite loop on the Cache IO thread rather than a crash. Every existing\nesr153 profile is at schema 29, so it would have hung Cache API and Service\nWorker storage for upgrading users, not just broken tests.\n\nSquashed commits:\n\n  Bug 2009295 (D278397), by Marcelo Camargo - closes the gap at version 29.\n  Uplifted whole rather than schema-only so that versions 30 and 31 mean the\n  same thing on esr153 as on mozilla-central. Profiles are shared across\n  channels, and a partial uplift would leave an esr153 database at version 31\n  permanently missing the index, with no migration left to ever add it.\n\n  Bug 2047853 (D311986) - unchanged from the original uplift.\n\nWith both applied, dom/cache/DBSchema.cpp matches mozilla-central except for\nthe unrelated nsID::Parse signature change from Bug 2054573.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D278397\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311986\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317102\n", "files": ["dom/cache/DBSchema.cpp", "dom/cache/TypeUtils.cpp"], "git_node": "394a5057669b9d046bec60a6ff09ba7a8d7cb02f", "git_parents": ["28124d7814d7fa55a3c45fea8b611808896a7e5e"], "node": "66cab7d6f0e687bfe5d22e1bf4a9744ba97a78fb", "parents": ["a8a5bbd1de5b3db0ed473706a2b522deb5ba6ef6"], "tags": []}], "date": 1786468149, "git_changesets": ["394a5057669b9d046bec60a6ff09ba7a8d7cb02f"], "user": "dsmith@mozilla.com"}, "1554": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Send SSPI channel bindings on the initial InitializeSecurityContext call.  a=diannaS\n\nThe SEC_CHANNEL_BINDINGS buffer was only ever built on continuation calls. That\nis sufficient for raw NTLM, whose channel binding travels in message 3, but\nSPNEGO carries the AP-REQ in the very first token, so Kerberos needs the\nbindings from the initial call on and never received them.\n\nMove the token construction into a helper and attach it whenever a certificate\nis available, building the input buffer descriptor up front so it can be passed\nwith no accompanying token. Keep the certificate for the lifetime of the\nsequence instead of freeing it after first use, so every leg of a multi-leg\nexchange carries the bindings.\n\nThe exemption for PACKAGE_TYPE_NTLM covers the sys-ntlm module only, which\nkeeps behaving exactly as it does today. NTLM negotiated inside SPNEGO runs\nunder PACKAGE_TYPE_NEGOTIATE and will now carry bindings from the first call:\nthat is the main behaviour change here and the one worth reviewing closely,\nsince raw NTLM is deliberately untouched.\n\nOn its own this commit changes nothing, because no caller supplies a\ncertificate on the Negotiate path until the next one.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316807\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317836\n", "files": ["extensions/auth/nsAuthSSPI.cpp", "extensions/auth/nsAuthSSPI.h"], "git_node": "efcaf97c02e25f6d177d9193267039de61a7146f", "git_parents": ["394a5057669b9d046bec60a6ff09ba7a8d7cb02f"], "node": "df7af2df3c62c734b8dac4d13dbc68d11c2a5cc8", "parents": ["66cab7d6f0e687bfe5d22e1bf4a9744ba97a78fb"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Pass the server certificate to the Negotiate auth module.  a=diannaS\n\nnsHttpNegotiateAuth never retrieved the server certificate, so nsAuthSSPI had\nnothing to build a channel binding token from and Negotiate authentication\nnever sent one. Servers with Extended Protection set to Require reject that,\nwhich is why Kerberos SSO fails against ADFS and Exchange OWA where Chrome and\nEdge succeed. nsHttpNTLMAuth is the only caller that has ever supplied a\ncertificate.\n\nGenerateCredentials runs on a background thread, so the certificate is\ncollected on the main thread in GenerateCredentialsAsync, and only for a\nchallenge that carries no token of its own. That is the first call of a\nsequence, and the only call where nsAuthSSPI::GetNextToken expects a\ncertificate in place of the input token.\n\nProxy auth is excluded because the channel's security info describes the origin\nserver rather than the proxy. Extended Protection for proxies needs the proxy's\nown certificate and is left for a follow-up.\n\nnetwork.auth.negotiate_channel_binding backs the change out.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317837\n", "files": ["extensions/auth/nsHttpNegotiateAuth.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b51a7711ac914209aacabc8186a75ce8f8fbf93a", "git_parents": ["efcaf97c02e25f6d177d9193267039de61a7146f"], "node": "cfcd392c57b6155a883dd38e655c04bd0a8a7437", "parents": ["df7af2df3c62c734b8dac4d13dbc68d11c2a5cc8"], "tags": []}], "date": 1786468572, "git_changesets": ["efcaf97c02e25f6d177d9193267039de61a7146f", "b51a7711ac914209aacabc8186a75ce8f8fbf93a"], "user": "dsmith@mozilla.com"}, "1555": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2057204 - use the right AddSystemEventListener variant with nsFileControlFrame::mMouseListener,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314734\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317322\n", "files": ["dom/html/test/browser.toml", "dom/html/test/browser_input_file_untrusted_drop.js", "dom/html/test/file_input_file_untrusted_drop.html", "layout/forms/nsFileControlFrame.cpp"], "git_node": "cabc34dc1ad1a4593995b76303e97f659c46e3d3", "git_parents": ["b51a7711ac914209aacabc8186a75ce8f8fbf93a"], "node": "ee9f2b2aedc3c58347d66ca8d7b9f92ef1df3f53", "parents": ["cfcd392c57b6155a883dd38e655c04bd0a8a7437"], "tags": ["FIREFOX_140_14_0esr_BUILD1", "FIREFOX_140_14_0esr_RELEASE"]}], "date": 1786475191, "git_changesets": ["cabc34dc1ad1a4593995b76303e97f659c46e3d3"], "user": "dsmith@mozilla.com"}}
}";