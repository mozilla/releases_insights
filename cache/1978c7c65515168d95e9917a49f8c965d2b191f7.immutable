NativeMacroAssembler.cpp"], "git_node": "ea947be70fe62c3ef7cd19b72c417df9c2d3d478", "git_parents": ["9261310b951bd36d9e4fa37e9ca28a666a184720"], "node": "79b91e5818bc776c73a4e5c55d46a6075620e4c0", "parents": ["de73dec1aae0b0de561654c7692fdf3eb060e47f"], "tags": []}], "date": 1784647910, "git_changesets": ["ea947be70fe62c3ef7cd19b72c417df9c2d3d478"], "user": "dsmith@mozilla.com"}, "1441": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055373: don't run update verify against esr115 linux 32-bit builds r=releng-reviewers,ahal a=diannaS\n\nThis is not an ideal fix, but IMO it's not worthwhile adding support for dealing with gaps in update coverage to get full coverage for this platform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312406\n", "files": ["taskcluster/kinds/release-update-verify-config/kind.yml"], "git_node": "a42e7a98c7d52fe3d9bdc7a81dd0f81156ec21d4", "git_parents": ["ea947be70fe62c3ef7cd19b72c417df9c2d3d478"], "node": "15b6bf1d8390e0421d4b56b821bbf41f26ac2851", "parents": ["79b91e5818bc776c73a4e5c55d46a6075620e4c0"], "tags": []}], "date": 1784648172, "git_changesets": ["a42e7a98c7d52fe3d9bdc7a81dd0f81156ec21d4"], "user": "dsmith@mozilla.com"}, "1442": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056713: stop checking esr-next bouncer entries on esr140  a=diannaS\n\nWe started getting failures out of these tasks due to the fact that `esr-next` entries moved to esr153 when it shipped its first release, and it doesn't have 32-bit linux builds. This highlights that we were still checking these entries at _all_ on esr140, something that has been unnecessary ever since esr140 became the not-next esr release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313349\n", "files": ["testing/mozharness/configs/releases/bouncer_firefox_esr.py"], "git_node": "082047f540ba48289bd55e4ee848255cf485477b", "git_paren