illa.com/D315482\n", "files": ["dom/media/AudioPacketizer.h"], "git_node": "93fc31e971a96ec06fc517323d46529fa634eda0", "git_parents": ["f8de5247ca2f74ed1bdc510d0c124e2ade36e333"], "node": "7b69eca9ac3626a9d605466bfcf0562f45c85bc6", "parents": ["db948a13d193f496385f370ae4104a78a3ca49ea"], "tags": []}], "date": 1785520295, "git_changesets": ["f8de5247ca2f74ed1bdc510d0c124e2ade36e333", "93fc31e971a96ec06fc517323d46529fa634eda0"], "user": "rvandermeulen@mozilla.com"}, "1470": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053327 - Check allocations in _cairo_win32_printing_surface_paint_linear_pattern.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311550\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315631\n", "files": ["gfx/cairo/cairo/src/win32/cairo-win32-printing-surface.c", "gfx/cairo/patches/0042-win32-printing-linear-pattern.patch"], "git_node": "c6ffc4897c5f25cab7da7fcf9d8e09f7ca273fc1", "git_parents": ["93fc31e971a96ec06fc517323d46529fa634eda0"], "node": "ad920d726198efca9527c3a487f52e20dafab7cf", "parents": ["7b69eca9ac3626a9d605466bfcf0562f45c85bc6"], "tags": []}], "date": 1785520321, "git_changesets": ["c6ffc4897c5f25cab7da7fcf9d8e09f7ca273fc1"], "user": "rvandermeulen@mozilla.com"}, "1471": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049393 - Try to clean up some integer wrangling in IPC.  a=RyanVM DONTBUILD\n\nI don't think any of this is exploitable, but:\n* Add a bunch of overflow checks.\n* Remove a couple of checks that are now superfluous.\n* Widen some arguments to `size_t` to avoid silent truncation.\n\nI ran some perf tests on CI and didn't see any obvious regressions.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312391\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315118\n", "files": ["ipc/chromium/src/base/pickle.cc", "ipc/chromiu