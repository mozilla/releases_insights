c58c75d8cf3879650a50025303f843272", "parents": ["9ef1814d207b58be3c90fc9f548baf54c6460493"], "tags": []}], "date": 1785796915, "git_changesets": ["6a880eeefbaf2302fe7809238204158c68239254"], "user": "dsmith@mozilla.com"}, "1494": {"changesets": [{"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051013 - Validate `mInnerURI` when deserializing  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315684\n", "files": ["netwerk/base/nsSimpleNestedURI.cpp", "netwerk/base/nsSimpleNestedURI.h", "netwerk/protocol/about/nsAboutProtocolHandler.cpp", "netwerk/protocol/about/nsAboutProtocolHandler.h"], "git_node": "56e0db6c644a673fe99dcc30ed929c10f0c25829", "git_parents": ["6a880eeefbaf2302fe7809238204158c68239254"], "node": "a27fb1e26775962b89703e5b18637e310020d846", "parents": ["0b4e319c58c75d8cf3879650a50025303f843272"], "tags": []}], "date": 1785796935, "git_changesets": ["56e0db6c644a673fe99dcc30ed929c10f0c25829"], "user": "dsmith@mozilla.com"}, "1495": {"changesets": [{"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041906 - Use case insensitive string comparator in file ext checks for ApplicationReputation.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311840\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315929\n", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp"], "git_node": "88c4ce6e0d7feaaa5c53dd199d6328dd374bbe15", "git_parents": ["56e0db6c644a673fe99dcc30ed929c10f0c25829"], "node": "9ca824ecbbb62d3109d2c78a7ef8678fc97126a8", "parents": ["a27fb1e26775962b89703e5b18637e310020d846"], "tags": []}], "date": 1785796969, "git_changesets": ["88c4ce6e0d7feaaa5c53dd199d6328dd374bbe15"], "user": "dsmith@mozilla.com"}, "1496": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2057101  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313927\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315927\n", "files": ["gfx/layers/d3d11/TextureD3D11.cpp"], "git_node": "f31824afbdbb7ae689f5c787f1fffb0933050348", "git_parents": ["88c4ce6e0d7feaaa5c53dd199d6328dd374bbe15"], "node": "3e12084651a6d4f89c91d30179e2b4a1b67c3327", "parents": ["9ca824ecbbb62d3109d2c78a7ef8678fc97126a8"], "tags": []}], "date": 1785797019, "git_changesets": ["f31824afbdbb7ae689f5c787f1fffb0933050348"], "user": "dsmith@mozilla.com"}, "1497": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058645 - Clear a stale user value when an incoming pref update flips the type.  a=diannaS DONTBUILD\n\nPref keeps its default and user values in a union governed by a single shared\ntype tag. FromDomPref applies the incoming default value first, so when that\nvalue changes the type it leaves mUserValue holding a member of the old type,\nwhich the user-value handling right below then reads as the new type.\n\nA content process can hold a user value whose type no longer matches the\nparent's, because ContentParent::Observe deliberately drops updates for prefs\nthat ShouldSanitizePreference() classifies as sanitized, and that\nclassification applies only while a dynamically named pref is a String without\na default value.\n\nClear such a user value before the type tag changes, while Clear() can still\nmatch the type it was actually stored as.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315248\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315936\n", "files": ["modules/libpref/Preferences.cpp"], "git_node": "d11355a7be4b227795d973034b42019da490d9d5", "git_parents": ["f31824afbdbb7ae689f5c787f1fffb0933050348"], "node": "a561951cd589ba06101b674c8ab301e78fbc086b", "parents": ["3e12084651a6d4f89c91d30179e2b4a1b67c3327"], "tags": []}], "date": 1785810098, "git_changesets": ["d11355a7be4b227795d973034b42019da490d9d5"], "user": "dsmith@mozilla.com"}, "1498": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2057100  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313928\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315925\n", "files": ["gfx/gl/SharedSurfaceD3D11Interop.cpp"], "git_node": "20a36b29102ad47cf770ef92fee30ca16d388cdc", "git_parents": ["d11355a7be4b227795d973034b42019da490d9d5"], "node": "0a1b1b0674d5742bc692b9eb5faa1daa97b88107", "parents": ["a561951cd589ba06101b674c8ab301e78fbc086b"], "tags": []}], "date": 1785810118, "git_changesets": ["20a36b29102ad47cf770ef92fee30ca16d388cdc"], "user": "dsmith@mozilla.com"}, "1499": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "[ESR 140] Bug 2045774 - Adjust picture-region handling for decoded video buffers.  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315506\n", "files": ["dom/media/MediaData.cpp", "dom/media/webm/WebMDemuxer.cpp", "gfx/layers/ImageContainer.cpp"], "git_node": "ba760c437763ca0d14024d404c626b389ff745bb", "git_parents": ["20a36b29102ad47cf770ef92fee30ca16d388cdc"], "node": "19c19c1cbe778205107f41de335a91ff2f1dd1db", "parents": ["0a1b1b0674d5742bc692b9eb5faa1daa97b88107"], "tags": []}], "date": 1785810175, "git_changesets": ["ba760c437763ca0d14024d404c626b389ff745bb"], "user": "dsmith@mozilla.com"}, "1500": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059188 - Add the missing WebGL texel unpack specializations.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315284\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315982\n", "files": ["dom/canvas/TexUnpackBlob.cpp", "dom/canvas/WebGLTexelConversions.cpp", "dom/canvas/WebGLTexelConversions.h"], "git_node": "