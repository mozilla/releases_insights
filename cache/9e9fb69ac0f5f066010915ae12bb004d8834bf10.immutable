hangeset d2be13b2616c (bug 1283067) for breaking multiple tests on Windows a=backout", "files": ["browser/modules/WindowsPreviewPerTab.jsm"], "git_node": null, "git_parents": [null], "node": "93487b5d946700ce8b8c66b90714c13c6c4d2a81", "parents": ["d2be13b2616c20e9fa914f5b0e3f1725b8f7941c"], "tags": []}], "date": 1467997357, "git_changesets": [null], "user": "kwierso@gmail.com"}, "183": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1282992 - Improve sync event loop shutdown in workers, r=khuey a=ritu", "files": ["dom/workers/WorkerPrivate.cpp"], "git_node": null, "git_parents": [null], "node": "380c05fc7d7f5fa9cb3c2a3a933fb0317d57d6ac", "parents": ["93487b5d946700ce8b8c66b90714c13c6c4d2a81"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1280043 - Upgrade bzip2 to 1.0.6; r=glandium, a=ritu\n\nhttp://www.bzip.org/1.0.6/bzip2-1.0.6.tar.gz was uncompressed to\nmodules/libbz2/src unmodified. Only modified files were committed.\nOther files from the archive not previously under version control\nwere not added.\n\nIt's worth noting that bzip.org is not available over https://\nand they only publish a MD5 of the source archive. So there is\nno good way to verify the sources from the vendor. Out of paranoia,\nI obtained the source archive from Debian\n(https://packages.debian.org/jessie/bzip2) and verified they matched\nthe vendor-obtained sources.\n\nMozReview-Commit-ID: 1DJ3UiHQC4f", "files": ["modules/libbz2/src/LICENSE", "modules/libbz2/src/blocksort.c", "modules/libbz2/src/bzlib.c", "modules/libbz2/src/bzlib.h", "modules/libbz2/src/bzlib_private.h", "modules/libbz2/src/compress.c", "modules/libbz2/src/crctable.c", "modules/libbz2/src/decompress.c", "modules/libbz2/src/huffman.c", "modules/libbz2/src/randtable.c"], "git_node": null, "git_parents": [null], "node": "9972630a75688bf9e069a3d59ef4876b7bfda533", "parents": ["380c05fc7d7f5fa9cb3c2a3a933fb0317d57d6ac"], "tags": []}], "date": 1468017797, "git_changesets": [null, null], "user": "kwierso@gmail.com"}, "184": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1283067, r=mak, a=ritu\n\nMozReview-Commit-ID: JJpepH22gY5", "files": ["browser/modules/WindowsPreviewPerTab.jsm"], "git_node": null, "git_parents": [null], "node": "057e4d2a39cc40098e466bacceae137d98432c6d", "parents": ["9972630a75688bf9e069a3d59ef4876b7bfda533"], "tags": []}], "date": 1468023210, "git_changesets": [null], "user": "gijskruitbosch@gmail.com"}, "185": {"changesets": [{"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1276110 - Workaround a wget bug by not performing internationalisation. r=ted a=ritu", "files": ["toolkit/locales/l10n.mk"], "git_node": null, "git_parents": [null], "node": "cd64cd568d3879680838f3de32f5033fbaa409d5", "parents": ["057e4d2a39cc40098e466bacceae137d98432c6d"], "tags": []}], "date": 1468028343, "git_changesets": [null], "user": "Callek@gmail.com"}, "186": {"changesets": [{"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1279146 - Clean up streams on shutdown. r=bwc, a=lizzard", "files": ["media/mtransport/nricectx.cpp", "media/mtransport/nricemediastream.cpp", "media/mtransport/transportlayerdtls.cpp"], "git_node": null, "git_parents": [null], "node": "fe34f5e690c22802ba9c461ef495b53ff4f83be1", "parents": ["cd64cd568d3879680838f3de32f5033fbaa409d5"], "tags": []}], "date": 1468223044, "git_changesets": [null], "user": "cbook@mozilla.com"}, "187": {"changesets": [{"author": "Carsten \"Tomcat\" Book \u003ccbook@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset fe34f5e690c2 (bug 1279146) for bustage", "files": ["media/mtransport/nricectx.cpp", "media/mtransport/nricemediastream.cpp", "media/mtransport/transportlayerdtls.cpp"], "git_node": null, "git_parents": [null], "node": "9ae12ca08d6