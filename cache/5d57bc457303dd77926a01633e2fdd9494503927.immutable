esr78 python3 path. a=bustage-fix\n\nfix esr78 python3 path\n\nDifferential Revision: https://phabricator.services.mozilla.com/D91757", "files": ["taskcluster/taskgraph/transforms/job/python_test.py"], "git_node": null, "git_parents": [null], "node": "56c74fa62076218aefe617e070d89765e33f03dc", "parents": ["138658fea9c059a795776eb90fc4ca2d680b2111"], "tags": []}], "date": 1601393939, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "92": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging afe18e892761da9cf8376d5f8298fe6489d6cb93 with FIREFOX_78_3_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "bdc966332160eb25d79b377261257bf40489ac24", "parents": ["56c74fa62076218aefe617e070d89765e33f03dc"], "tags": []}], "date": 1601482060, "git_changesets": [null], "user": "ffxbld"}, "93": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging afe18e892761da9cf8376d5f8298fe6489d6cb93 with FIREFOX_78_3_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "acc6a314f0dcdc9ddf9e8640bf54be2de3464fb7", "parents": ["bdc966332160eb25d79b377261257bf40489ac24"], "tags": []}], "date": 1601559107, "git_changesets": [null], "user": "ffxbld"}, "94": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92062", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f9d13d78d22ce4d70ba1361429989781f7d1a240", "parents": ["acc6a314f0dcdc9ddf9e8640bf54be2de3464fb7"], "tags": []}], "date": 1601565531, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "95": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Backed out 1 changesets (bug 1656697) for regressions. a=backout\n\nBacked out changeset 005391f69f10 (bug 1656697)", "files": ["netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": null, "git_parents": [null], "node": "c07fd996818eea0938c14827173383f898dd2a9a", "parents": ["f9d13d78d22ce4d70ba1361429989781f7d1a240"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1663677 - Fix macro hygiene usage in fxaccounts/rust-bridge. r=eoger,lina, a=jcristau\n\nThis prevents us from building with rust beta/nightly.\n\nThis is technically a Rust regression, see\nhttps://github.com/rust-lang/rust/issues/76480, though I think that this\nshould've never worked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89466", "files": ["services/fxaccounts/rust-bridge/firefox-accounts-bridge/src/bridge.rs"], "git_node": null, "git_parents": [null], "node": "cb29365df8b4405860a9c56a5c7682a7964df927", "parents": ["c07fd996818eea0938c14827173383f898dd2a9a"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1656301 - Popup Menus Don't Match Big Sur Look and Feel, Have White Line Artifacts. r=mstange, a=jcristau\n\nAvoid the menu separator artifacts caused by HIThemeDrawMenuSeparator() on macOS Big Sur by drawing the the separator with CGContextFillRect() instead.\n\nAdjust the width of the separator and submenu right margin to resemble Big Sur native popups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D91381", "files": ["widget/cocoa/nsCocoaFeatures.h", "widget/cocoa/nsCocoaFeatures.mm", "widget/cocoa/nsNativeThemeCocoa.mm"], "git_node": null, "git_parents": [null], "node": "fad7cbf79ff685409e47690281123c059ba45abf", "parents": ["cb29365df8b4405860a9c56a5c7682a7964df927"], "tags": []}], "date": 1601630724, "git_changesets": [null, null, null], "user": "jcristau@mozilla.com"}, "96": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update, r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92440", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "83f9e1607b2ab92d7f9059bb463013cc55588c07", "parents": ["fad7cbf79ff685409e47690281123c059ba45abf"], "tags": []}, {"author": "Jeff Walden \u003cjwalden@mit.edu\u003e", "branch": "default", "desc": "Bug 1660954.  r=smaug, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92313", "files": ["dom/abort/AbortSignal.cpp", "dom/abort/AbortSignal.h", "dom/fetch/Fetch.cpp", "dom/fetch/Fetch.h"], "git_node": null, "git_parents": [null], "node": "5f36d412891c642bcaa873cbfe94785257205b7a", "parents": ["83f9e1607b2ab92d7f9059bb463013cc55588c07"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1666140 - Fix OOM bailout path. r=rhunt, a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D91750", "files": ["js/src/wasm/WasmStubs.cpp"], "git_node": null, "git_parents": [null], "node": "1a793d052f25525434e9bde9c3283960ffe253c2", "parents": ["5f36d412891c642bcaa873cbfe94785257205b7a"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1668493 - macOS 11.0 - Popup Menus separator lines have blue tint. r=mstange, a=jcristau\n\nSlight color adjustment of the separator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92273", "files": ["widget/cocoa/nsNativeThemeCocoa.mm"], "git_node": null, "git_parents": [null], "node": "2496f9b063643441e78016d5723d223c2a572834", "parents": ["1a793d052f25525434e9bde9c3283960ffe253c2"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1668374 - Treat 0/1 as boolean in policy unless there is an existing int pref. r=emalysz, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D91492", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/tests/browser/browser_policies_setAndLockPref_API.js", "browser/components/enterprisepolicies/tests/xpcshell/test_preferences.js"], "git_node": null, "git_parents": [null], "node": "a05489887e78f3ce77cd3a4be41eeda92469aaff", "parents": ["2496f9b063643441e78016d5723d223c2a572834"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1658571 - Don't create a reference cycle when catching redirects of a preload. r=smaug, a=pascalc\n\nPreloaderBase -\u003e RedirectSink -\u003e PreloaderBase is a strong,\nnon-cycle-collected reference cycle, which in cases where we don't drop\nthe channel because we never get an NotifyStop notification, it can\ncause leaks.\n\nI'm investigating the root cause of the lack of NotifyStop, but this\nshould fix the leak and is correct anyhow.\n\nMove the class to the cpp file to ease debugging and changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D91259", "files": ["uriloader/preload/PreloaderBase.cpp", "uriloader/preload/PreloaderBase.h"], "git_node": null, "git_parents": [null], "node": "7cdc79640b2c2f11a8d8cc3c3fe2fdb41712a1f3", "parents": ["a05489887e78f3ce77cd3a4be41eeda92469aaff"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1658571 - release PreloaderBase::RedirectSink on the main thread. r=sg, a=pascalc", "files": ["mfbt/WeakPtr.h", "uriloader/preload/PreloaderBase.cpp"], "git_node": null, "git_parents": [null], "node": "89812268b2e428b3d836f629fe3cdadf620c162f", "parents": ["7cdc79640b2c2f11a8d8cc3c3fe2fdb41712a1f3"], "tags": []}], "date": 1601995957, "git_changesets": [null, null, null, null, null, null, null], "user": "jcristau@mozilla.com"}, "97": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92938", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "2a5a9d7c3acd12b90b41d4312d1ba003fe39e3f7", "parents": ["89812268b2e428b3d836f629fe3cdadf620c162f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1662760 - Add dedicated setup method to audio and video receivers. r=padenot, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92448", "files": ["media/webrtc/signaling/src/mediapipeline/MediaPipeline.cpp"], "git_node": null, "git_parents": [null], "node": "0acd0078b8717cb55dc589c2dbe047f056f4d313", "parents": ["2a5a9d7c3acd12b90b41d4312d1ba003fe39e3f7"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1668099 - Fix symbols that rely on unified build order in media gtests. r=jolin, a=jcristau\n\nFix up includes so AnnexB.h and TestMediaDataEncoder.cpp don't rely on unified\nbuild order. Reformat include lists to match style guide. Rework #include guard\non AnnexB.h to reflect style guide.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D91825", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp", "dom/media/platforms/agnostic/bytestreams/AnnexB.h"], "git_node": null, "git_parents": [null], "node": "a851459ebef01953bb14add50169c9c7e6be0e90", "parents": ["0acd0078b8717cb55dc589c2dbe047f056f4d313"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1618529 - Add gtest coverage for AnnexB conversions. r=jolin, a=jcristau\n\nAdd test code to ensure AnnexB conversions behave as we expect. This adds some\ncoverage for non-encrypted conversions that we only tested with broader tests\nuntil now. It also adds a test to ensure we don't overflow our subsample sizes\nwhen dealing with encrypted media with very large subsamples. This latter test\ncovers the issue seen in bug 1618529.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92299", "files": ["dom/media/platforms/agnostic/bytestreams/gtest/TestAnnexB.cpp", "dom/media/platforms/agnostic/bytestreams/gtest/moz.build", "dom/media/platforms/agnostic/bytestreams/moz.build"], "git_node": null, "git_parents": [null], "node": "7bcbee51d877a317df739414c71b06a19c09bce8", "parents": ["a851459ebef01953bb14add50169c9c7e6be0e90"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1618529 - Store clear crypto subsample info in uint32 rather than uint16. r=jolin, a=jcristau\n\nThis avoids us risking an overflow when we convert encrypted media with\nsubsamples to AnnexB (since that conversion can grow the clear sizes of the\nsample). See the test in the preceding patch for an example of how and why this\nhappens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92300", "files": ["dom/media/MediaData.h", "dom/media/gmp/GMPTypes.ipdlh", "dom/media/hls/HLSDemuxer.cpp", "dom/media/platforms/agnostic/bytestreams/AnnexB.cpp", "dom/media/platforms/android/RemoteDataDecoder.cpp"], "git_node": null, "git_parents": [null], "node": "8a7ca5f6390588511a523a9dc31a3f8544ae7ea4", "parents": ["7bcbee51d877a317df739414c71b06a19c09bce8"], "tags": []}, {"author": "Ricky Stewart \u003crstewart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1668718 - Don't set `import` hook for Python 3 in `mach bootstrap`. r=glandium, a=npotb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92825", "files": ["build/mach_bootstrap.py"], "git_node": null, "git_parents": [null], "node": "e2fade7a3527980ce662d28adb015c943017284d", "parents": ["8a7ca5f6390588511a523a9dc31a3f8544ae7ea4"], "tags": []}], "date": 1602181961, "git_changesets": [null, null, null, null, null, null], "user": "jcristau@mozilla.com"}, "98": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1643201 - Cherry-pick some servo changes to derive_common. a=jcristau\n\nDepends on D78199\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78200", "files": ["servo/components/derive_common/cg.rs"], "git_node": null, "git_parents": [null], "node": "65acca4d6d8b9e7d9f371c477656a1c5c8c3fbcf", "parents": ["e2fade7a3527980ce662d28adb015c943017284d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1653339 - Teach style_derive's map_type_params about mapping self correctly. r=boris, a=jcristau\n\nConsider the following:\n\nstruct Complex\u003cT\u003e {\n    something: T,\n    #[compute(field_bound)]\n    something_else: Generic\u003cSelf, T\u003e,\n}\n\nThat will generate:\n\nimpl\u003cT\u003e ToComputedValue for Complex\u003cT\u003e\nwhere\n    T: ToComputedValue,\n    Generic\u003cSelf, T\u003e: ToComputedValue\u003cComputedValue = Generic\u003cSelf, \u003cT as ToComputedValue\u003e::ComputedValue\u003e\u003e,\n{\n    // ...\n}\n\nThat last clause is obviously incorrect. map_type_params correctly maps\nthe T, but it should know also about Self.\n\nIdeally we could just do the same as for T and do:\n\n    \u003cSelf as ToComputedValue\u003e::ComputedValue\n\nBut that doesn't quite work, because we are in that implementation of\nthe trait, and the compiler rightfully complains about we don't yet\nknowing the computed type. So we need to pass it explicitly, which is\nsimple enough, if a bit annoying.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83816", "files": ["servo/components/derive_common/cg.rs", "servo/components/style_derive/to_computed_value.rs"], "git_node": null, "git_parents": [null], "node": "feb6a72d2e799af4df13e1f3d21bb32105f3b6d1", "parents": ["65acca4d6d8b9e7d9f371c477656a1c5c8c3fbcf"], "tags": []}, {"author": "Kris Taeleman \u003cktaeleman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1656987 - Change WeakPtr to ThreadSafeWeakPtr. r=aosmond, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D90748", "files": ["gfx/layers/ImageContainer.h", "image/Image.cpp", "image/Image.h"], "git_node": null, "git_parents": [null], "node": "f8fc6ba229c28bb620399cb4bd85be4d00c79f14", "parents": ["feb6a72d2e799af4df13e1f3d21bb32105f3b6d1"], "tags": []}, {"author": "Kris Taeleman \u003cktaeleman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1656987 - Only cast and call CanvasLayer::Update() if the layer is a CanvasLayer. r=mattwoodrow, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92160", "files": ["dom/html/HTMLCanvasElement.cpp"], "git_node": null, "git_parents": [null], "node": "f417ba9c240d7608d6ca018474b9795ce1d781fd", "parents": ["f8fc6ba229c28bb620399cb4bd85be4d00c79f14"], "tags": []}], "date": 1602508522, "git_changesets": [null, null, null, null], "user": "jcristau@mozilla.com"}, "99": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D93256", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "8b2e95b473f0e20b424f7b6cfaf7c2fd6460bcc5", "parents": ["f417ba9c240d7608d6ca018474b9795ce1d781fd"], "tags": []}], "date": 1602580863, "git_changesets": [null], "user": "jcristau@mozilla.com"}}
}";