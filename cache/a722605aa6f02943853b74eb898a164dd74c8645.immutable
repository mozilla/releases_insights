086b"], "user": "ffxbld@lando.moz.tools"}, "866": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012608: Create this after pushing arguments (esr115) r=jandem a=dmeehan DONTBUILD\n\nThe patch for esr140 doesn't apply cleanly because of the patch for bug 1871089, which didn't affect esr115.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282689\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCacheIRCompiler.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h"], "git_node": "9dd8ac35bb4b3d2ca63aab25bf3fcd753f463189", "git_parents": ["a520cbe2c2cff6c8b9ac90ca436a35c191dd52c7"], "node": "b95f20091ec8dd91eacc0faba045931eb66be1b1", "parents": ["ffc3b6389b0f1482fcefd1e10cef05a1e84d1368"], "tags": []}], "date": 1771071821, "git_changesets": ["9dd8ac35bb4b3d2ca63aab25bf3fcd753f463189"], "user": "dmeehan@mozilla.com"}, "867": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2014827 - Update mp4parse-rust to bea4a55f7852de8076c67626888a0b05d0c5a3f5.   a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283169\n", "files": [".cargo/config.in", "Cargo.lock", "third_party/rust/mp4parse_capi/.cargo-checksum.json", "third_party/rust/mp4parse_capi/src/lib.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "fdcd1272a5adc421c45714a212aa40fad1155199", "git_parents": ["9dd8ac35bb4b3d2ca63aab25bf3fcd753f463189"], "node": "a16a5e710b8d5419010a2bf078641011af285336", "parents": ["b95f20091ec8dd91eacc0faba045931eb66be1b1"], "tags": []}], "date": 1771071860, "git_changesets": ["fdcd1272a5adc421c45714a212aa40fad1155199"], "user": "dmeehan@mozilla.com"}, "868": {"changesets": [{"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016498 - Fix Span::Subspan assertion.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283118\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283192\n", "files": ["mfbt/Span.h"], "git_node": "318c649c2e814c95e631361997e32277fcfcfd91", "git_parents": ["fdcd1272a5adc421c45714a212aa40fad1155199"], "node": "da0d21a93ff4d579d137eebee2f83abfe59589a7", "parents": ["a16a5e710b8d5419010a2bf078641011af285336"], "tags": []}], "date": 1771071915, "git_changesets": ["318c649c2e814c95e631361997e32277fcfcfd91"], "user": "dmeehan@mozilla.com"}, "869": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2016358 - Use Span in ReadStructuredCloneInternal.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283128\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283289\n", "files": ["dom/base/StructuredCloneBlob.cpp"], "git_node": "1fcdf3c447b9b9a21582b3e2c81a205b87ca6b51", "git_parents": ["318c649c2e814c95e631361997e32277fcfcfd91"], "node": "6b01cb17d47d549010e7a205928ee1720ecc2b79", "parents": ["da0d21a93ff4d579d137eebee2f83abfe59589a7"], "tags": []}], "date": 1771071953, "git_changesets": ["1fcdf3c447b9b9a21582b3e2c81a205b87ca6b51"], "user": "dmeehan@mozilla.com"}, "870": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2014883.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282414\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283302\n", "files": ["dom/media/webm/WebMDemuxer.cpp"], "git_node": "0137631d98ae6a327cf69a66236f043fa7dcdc1c", "git_parents": ["1fcdf3c447b9b9a21582b3e2c81a205b87ca6b51"], "node": "17f2a5d9183800d59f9553b5fe821c5986d2ccd7", "parents": ["6b01cb17d47d549010e7a205928ee1720ecc2b79"], "tags": []}], "date": 1771071999, "git_changesets": ["0137631d98ae6a327cf69a66236f043fa7dcdc1c"], "user": "dmeehan@mozilla.com"}, "871": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2014832.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283325\n", "files": ["dom/media/webaudio/MediaBufferDecoder.cpp"], "git_node": "c80e0050731aa19b75f5b77d43bf2a10020eaaea", "git_parents": ["0137631d98ae6a327cf69a66236f043fa7dcdc1c"], "node": "d2e55dd6c80ce2248d400ab76efefab7df7b51fb", "parents": ["17f2a5d9183800d59f9553b5fe821c5986d2ccd7"], "tags": []}], "date": 1771072037, "git_changesets": ["c80e0050731aa19b75f5b77d43bf2a10020eaaea"], "user": "dmeehan@mozilla.com"}, "872": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014550: Reset FileInfoEntry::mSavepointDelta after the rollback.  a=dmeehan\n\nThis bug exposes an edge case with IDB blob file ref-counting. `FileInfo` manages the blob file at runtime and contains the logic for on-disk file management. It does so by maintaining both an in-memory ref-count and a DB ref-count. `FileInfoEntry` manages the DB ref-counting side of things during an active transaction and pushes the effective delta to the DB ref-count after the transaction commits (via `FileInfoEntry::MaybeUpdateDBRefs`), i.e., at the end of the transaction's lifetime.\n\nThe test case in question (as attached to the bug) opens an IDB database and stores 3 records that each reference the same blob, giving the underlying blob file a DB ref-count of 3. It then starts a new read-write transaction and attempts to add 3 more records that intentionally violate a unique index constraint. Each failed `add()` raises a `ConstraintError`, and the error handler calls `e.preventDefault()` to keep the transaction alive rather than allowing it to abort. Internally, each individual IDB operation runs inside a Auotsavepoint. When an operation fails, the savepoint is rolled back, but the transaction itself continues normally to the next operation.\n\n`FileInfoEntry` has two fields for tracking ref-count changes: `mDelta` and `mSavepointDelta`. `mDelta` accumulates the total ref-count change for the entire transaction and is the value that ultimately gets applied to `FileInfo`'s DB ref-count at commit time. `mSavepointDelta` tracks the ref-count changes made within the current savepoint, so that if the savepoint is rolled back, those changes can be subtracted from `mDelta` to restore it to its pre-savepoint value.\n\nThe issue is that even though we are calculating mDelta after every rollback but it's not correct as the mSavepointDelta was never reset after the rollback and on the next rollback attempt, it would still has the stale value from the last savepoint.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282624\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283330\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "38ba23eebc0d76dd691efae8caea605dcb3f2c01", "git_parents": ["c80e0050731aa19b75f5b77d43bf2a10020eaaea"], "node": "5513653525e97f3c122d3911c4424e05de3b29ac", "parents": ["d2e55dd6c80ce2248d400ab76efefab7df7b51fb"], "tags": []}], "date": 1771072175, "git_changesets": ["38ba23eebc0d76dd691efae8caea605dcb3f2c01"], "user": "dmeehan@mozilla.com"}, "873": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 2012608: Create this after pushing arguments (esr115) r=jandem a=dmeehan\" for causing build failures\n\nThis reverts commit 9dd8ac35bb4b3d2ca63aab25bf3fcd753f463189.\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCacheIRCompiler.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h"], "git_node": "ddd7b7e21858f5ec1a4253d61006d66e57d0cbb6", "git_parents": ["38ba23eebc0d76dd691efae8caea605dcb3f2c01"], "node": "3548d4ba842195efbe2b95294f85f9ff0a7f477e", "parents": ["5513653525e97f3c122d3911c4424e05de3b29ac"], "tags": []}], "date": 1771075773, "git_changesets": ["ddd7b7e21858f5ec1a4253d61006d66e57d0cbb6"], "user": "dmeehan@mozilla.com"}, "874": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016423. r=ahale a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283207\n", "files": ["dom/canvas/TexUnpackBlob.cpp", "dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLTypes.h"], "git_node": "76a5bcbc2aeacb057f7387a38b222baac2260ce4", "git_parents": ["ddd7b7e21858f5ec1a4253d61006d66e57d0cbb6"], "node": "4129987f04ec1a7c68dfd16c74d21a17c86ad90d", "parents": ["3548d4ba842195efbe2b95294f85f9ff0a7f477e"], "tags": []}], "date": 1771236489, "git_changesets": ["76a5bcbc2aeacb057f7387a38b222baac2260ce4"], "user": "dmeehan@mozilla.com"}, "875": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283533\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "f609c96229f54850e85301396e4b82b3f689036d", "git_parents": ["76a5bcbc2aeacb057f7387a38b222baac2260ce4"], "node": "20895b037f2754b78daf0067a67b9f6ebac4538f", "parents": ["4129987f04ec1a7c68dfd16c74d21a17c86ad90d"], "tags": []}], "date": 1771240972, "git_changesets": ["f609c96229f54850e85301396e4b82b3f689036d"], "user": "dmeehan@mozilla.com"}, "876": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fc43c97c72749b9e222d68e0d37e7c696ae933e2 with FIREFOX_147_0_4_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c44eeebf5001929120ef8e393f18ece14fc59d70", "git_parents": ["fc07d27982c3f1ef4fa107f681961add9e02086b"], "node": "ae84e83f99e09daac8c274421a2381752293