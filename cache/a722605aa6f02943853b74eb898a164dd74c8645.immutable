devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "f30668c9bc84d073c9061d617c68f08a3256e7b3", "git_parents": ["d076a71dcf888adfaf4c4524dfab021a10a27aaf"], "node": "b3c0f0a80a68770a9dfcb4312842a6b4efe22def", "parents": ["2711b2721d658f123acf8b99863e9d79d23e26da"], "tags": []}], "date": 1768484972, "git_changesets": ["f30668c9bc84d073c9061d617c68f08a3256e7b3"], "user": "dmeehan@mozilla.com"}, "830": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279506\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "db29b0987373a0f1d0cb5c8179bd57c73d738fd9", "git_parents": ["f30668c9bc84d073c9061d617c68f08a3256e7b3"], "node": "bbd2c10b3e0e9e9b4e90d2878a50395d50df129b", "parents": ["b3c0f0a80a68770a9dfcb4312842a6b4efe22def"], "tags": []}], "date": 1768828767, "git_changesets": ["db29b0987373a0f1d0cb5c8179bd57c73d738fd9"], "user": "dmeehan@mozilla.com"}, "831": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280017\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "8db64a0787c4f66e774d6997d49a410035e4f872", "git_parents": ["db29b0987373a0f1d0cb5c8179bd57c73d738fd9"], "node": "d57d47c8e6552d6474aa333de9f53df154e2611e", "parents": ["bbd2c10b3e0e9e9b4e90d2878a50395d50df129b"], "tags": []}], "date": 1769088745, "git_changesets": ["8db64a0787c4f66e774d6997d49a410035e4f872"], "user": "dmeehan@mozilla.com"}, "832": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009608 - Don't assign non-live hash table entry r=glandium a=dmeehan\n\nThe problem here is that we use move assignment on a hash table entry that is\nnot live. Although all entries are constructed by HashTable::createTable, they\nmay subsequently be destroyed by HashTableEntry::destroyStoredT(). Therefore it\nis not safe to call any methods on a non live entry.\n\nThis causes a problem for GC barrier wrappers which assume that the object\nstate is valid (and presumably anything that does more than just write the\nassigned data into memory).\n\nThe fix is to construct a new entry in place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278629\n", "files": ["mfbt/HashTable.h"], "git_node": "b45b3541b638b2a84fb27b1623a6df5e5751d8ee", "git_parents": ["8db64a0787c4f66e774d6997d49a410035e4f872"], "node": "6920d3f39cbaccd5715975ba85c45c65bdd0cad4", "parents": ["d57d47c8e6552d6474aa333de9f53df154e2611e"], "tags": []}], "date": 1769089055, "git_changesets": ["b45b3541b638b2a84fb27b1623a6df5e5751d8ee"], "user": "dmeehan@mozilla.com"}, "833": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2010933. Do better error checking for AVIFDecoderStream.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279806\n", "files": ["image/decoders/nsAVIFDecoder.cpp"], "git_node": "bc8a691fae66c3eb4f4cb4a300ea9d8a7ef5e946", "git_parents": ["b45b3541b638b2a84fb27b1623a6df5e5751d8ee"], "node": "facd3303abe786fee51d30e0ed0a2c9e85648e48", "parents": ["6920d3f39cbaccd5715975ba85c45c65bdd0cad4"], "tags": []}], "date": 1769432890, "git_changesets": ["bc8a691fae66c3eb4f4cb4a300ea9d8a7ef5e946"], "user": "dmeehan@mozilla.com"}, "834": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280408\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "bb7b7ec0fa25850850ee7b9c5901e80013582a22", "git_parents": ["bc8a691fae66c3eb4f4cb4a300ea9d8a7ef5e946"], "node": "eaa3f88f7ad3db56d8386b6a552512dad958b53d", "parents": ["facd3303abe786fee51d30e0ed0a2c9e85648e48"], "tags": []}], "date": 1769433623, "git_changesets": ["bb7b7ec0fa25850850ee7b9c5901e80013582a22"], "user": "dmeehan@mozilla.com"}, "835": {"changesets": [{"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "No bug - update fuzzyness of moz-icon-blank-1-almostref.html after worker update. a=testonly DONTBUILD\n", "files": ["image/test/reftest/generic/reftest.list"], "git_node": "2142cf151c9082a6b77c7129fb86f5c80be215ce", "git_parents": ["bb7b7ec0fa25850850ee7b9c5901e80013582a22"], "node": "2b56493970ec977ffc811ea0d8ec15fb0db2f934", "parents": ["eaa3f88f7ad3db56d8386b6a552512dad958b53d"], "tags": []}], "date": 1769617280, "git_changesets": ["2142cf151c9082a6b77c7129fb86f5c80be215ce"], "user": "archaeopteryx@coole-files.de"}, "836": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280915\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "917a94d38d61837c676b0c4ebc1ae6d9c5ecc12a", "git_parents": ["2142cf151c9082a6b77c7129fb86f5c80be215ce"], "node": "f15cef7007c8c71e8910cabbfefda06ecb0fd872", "parents": ["2b56493970ec977ffc811ea0d8ec15fb0db2f934"], "tags": []}], "date": 1769692425, "git_changesets": ["917a94d38d61837c676b0c4ebc1ae6d9c5ecc12a"], "user": "dmeehan@mozilla.com"}, "837": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012018 - Simplify property lookup in SuppressDeletedProperty.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D280679\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281184\n", "files": ["js/src/vm/Iteration.cpp"], "git_node": "86040855a82a17cc7d7c13b0c277027b9a7418c0", "git_parents": ["917a94d38d61837c676b0c4ebc1ae6d9c5ecc12a"], "node": "c52c20119cb30a0627c24a86333682c5f348a45f", "parents": ["f15cef7007c8c71e8910cabbfefda06ecb0fd872"], "tags": []}], "date": 1770044979, "git_changesets": ["86040855a82a17cc7d7c13b0c277027b9a7418c0"], "user": "dmeehan@mozilla.com"}, "838": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281408\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "c1afb5fd39f0aae0e80906032ce2b7dadb7314d1", "git_parents": ["86040855a82a17cc7d7c13b0c277027b9a7418c0"], "node": "d7357dd27366fbd695ff2cb9086ac5c389c5181c", "parents": ["c52c20119cb30a0627c24a86333682c5f348a45f"], "tags": []}], "date": 1770045349, "git_changesets": ["c1afb5fd39f0aae0e80906032ce2b7dadb7314d1"], "user": "dmeehan@mozilla.com"}, "839": {"changesets": [{"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 2011063: Reject snapshots for unsupported formats. r=gfx-reviewers,jnicol a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280864\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "589f097b452de72fb5c05d368aba275f5f0e6e14", "git_parents": ["c1afb5fd39f0aae0e80906032ce2b7dadb7314d1"], "node": "eb260c4c7bf2e971a2498a8b07dda9d659698118", "parents": ["d7357dd27366fbd695ff2cb9086ac5c389c5181c"], "tags": []}], "date": 1770215144, "git_changesets": ["589f097b452de72fb5c05d368aba275f5f0e6e14"], "user": "dmeehan@mozilla.com"}, "840": {"changesets": [{"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2010145 - renew test certificates for 2026  a=dmeehan\n\nCertificates expire on 2027-02-04.\n\nExtended with the instructions in security/manager/ssl/tests/unit/test_cert_expiration_canary.js\n\nIf this test and only this test fails, do the following:\n1. Create a bug for the issue in \"Core :: Security: PSM\".\n2. Write a patch to temporarily disable the test.\n3. Land the patch.\n4. Write a patch to reenable the test but don't land it.\n5. Needinfo the triage owner of Bugzilla's \"Core :: Security: PSM\" component\n   in the bug.\n6. Patches to update certificates get created.\n6.1. Update certificates in security/manager/ssl/tests/unit with\n     ./mach generate-test-certs\n6.2. Update more certificates with\n     ./mach python build/pgo/genpgocert.py\n6.3. Temporarily uncomment the code in security/manager/ssl/tests/unit/test_signed_apps/moz.build,\n     build Firefox with |./mach build| and copy the relevant non-build files\n     from the related object directory folder into this folder.\n6.4. Update the certificate fingerprints mentioned in\n     security/manager/ssl/tests/unit/test_cert_override_read.js with\n     openssl x509 -noout -fingerprint -sha256 -in security/manager/ssl/tests/unit/bad_certs/certName.pem\n6.5. Update the base64 encoded serial numbers of test-int.pem and other-test-ca.pem in\n     security/manager/ssl/tests/unit/test_cert_storage.js\n6.5.1. Get the serial number value\n       openssl x509 -noout -in security/manager/ssl/tests/unit/bad_certs/test-int.pem -serial\n6.5.2. base64 encode the hex value without the prefix\n6.5.3. Update base64 encoded value in the test file.\n7. Commit the changes: Mention the year of the update, the date of the\n   next expiration and add these instructions to the commit message.\n8. Test the patches with a Try push.\n9. Land the patches on all trees whose code will still be used when the\n   certificates expire in 3 weeks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281556\n", "files": ["build/pgo/certs/cert9.db", "build/pgo/certs/key4.db", "build/pgo/certs/mochitest.client", "netwerk/test/unit/client-cert.p12", "security/manager/ssl/tests/mochitest/browser/ca.pem", "security/manager/ssl/tests/mochitest/browser/client-cert-via-intermediate.pem", "security/manager/ssl/tests/mochitest/browser/client-cert-with-ocsp-signing.pem", "security/manager/ssl/tests/mochitest/browser/code-ee.pem", "security/manager/ssl/tests/mochitest/browser/ee-from-expired-ca.pem", "security/manager/ssl/tests/mochitest/browser/ee-from-untrusted-ca.pem", "security/manager/ssl/tests/mochitest/browser/email-ee.pem", "security/manager/ssl/tests/mochitest/browser/has-cn.pem", "security/manager/ssl/tests/mochitest/browser/has-empty-subject.pem", "security/manager/ssl/tests/mochitest/browser/has-non-empty-subject.pem", "security/manager/ssl/tests/mochitest/browser/has-o.pem", "security/manager/ssl/tests/mochitest/browser/has-ou.pem", "security/manager/ssl/tests/mochitest/browser/intermediate.pem", "security/manager/ssl/tests/mochitest/browser/invalid.pem", "security/manager/ssl/tests/mochitest/browser/longOID.pem", "security/manager/ssl/tests/mochitest/browser/md5-ee.pem", "security/manager/ssl/tests/mochitest/browser/pgo-ca-all-usages.pem", "security/manager/ssl/tests/mochitest/browser/pgo-ca-regular-usages.pem", "security/manager/ssl/tests/mochitest/browser/revoked.pem", "security/manager/ssl/tests/mochitest/browser/ssl-ee.