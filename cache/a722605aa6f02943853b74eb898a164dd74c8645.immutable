759, "git_changesets": ["c44eeebf5001929120ef8e393f18ece14fc59d70", "4e9a5f251b73c9cbe35027dbcee8ba37cc0f4216", "33576df626dc5eb64606378a590cb3114fd944d9", "ff9932dcf87fd135fdf3565c54e6595ba14329e9", "6fbd1119bdfaff2ca0eb07d4b83f1c3678df4036"], "user": "ffxbld@lando.moz.tools"}, "877": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012608: Create this after pushing arguments (esr115) r=jandem a=dmeehan\n\nThe patch for esr140 doesn't apply cleanly because of the patch for bug 1871089, which didn't affect esr115.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282689\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCacheIRCompiler.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h"], "git_node": "9269fc30e74b702929809f9a085928f47fef562a", "git_parents": ["f609c96229f54850e85301396e4b82b3f689036d"], "node": "cd55789de1db79989314e7fc2876ca18c03f7113", "parents": ["20895b037f2754b78daf0067a67b9f6ebac4538f"], "tags": []}], "date": 1771262497, "git_changesets": ["9269fc30e74b702929809f9a085928f47fef562a"], "user": "dmeehan@mozilla.com"}, "878": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2017183: Adjust NumTraceableArgsForCreateThis for ESR r=spidermonkey-reviewers,arai a=dmeehan\n\nESR (both 115 and 140) don't contain bug 1983137. This means that we adjust for arguments underflow in the arguments rectifier, which happens after calling createThis, so NumTraceableArgsForCreateThis should always just use argc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283620\n", "files": ["js/src/jit/VMFunctions.cpp"], "git_node": "1071feab9e97071317e6ee46880e36e6c8d6b062", "git_parents": ["9269fc30e74b702929809f9a085928f47fef562a"], "node": "b8cd8fd24cc6a1693934238a26d8d2c063972a31", "parents": ["cd55789de1db79989314e7fc2876ca18c03f7113"], "tags": ["FIREFOX_115_33_0esr_BUILD1", "FIREFOX_115_33_0esr_RELEASE"]}], "date": 1771318043, "git_changesets": ["1071feab9e97071317e6ee46880e36e6c8d6b062"], "user": "dmeehan@mozilla.com"}}
}";