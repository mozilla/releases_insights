/head_searchconfig.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_ebay.js"], "git_node": null, "git_parents": [null], "node": "55097a5cf353f1b2a2228820bdf26bb69a1372a0", "parents": ["76943b7660efe6c36924ac5ee30175c7e95428b9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1684261 - Fix build with rust nightly. r=jrmuizel, a=RyanVM\n\nFixes errors like:\n\n  dependency (nix) specification is ambiguous. Only one of `branch`, `tag` or `rev` is allowed.\n\nI've left the most specific dependency, but for wgpu the rev is not\nright, so I've kept the branch which effectively preserves behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D100485", "files": [".cargo/config.in", "Cargo.lock", "Cargo.toml"], "git_node": null, "git_parents": [null], "node": "0e8f444683cb9c4079d3b2250f32f986043ea582", "parents": ["55097a5cf353f1b2a2228820bdf26bb69a1372a0"], "tags": []}, {"author": "Farooq AR \u003cfarooqbckk@gmail.com\u003e", "branch": "default", "desc": "Bug 1682928 - Resolve potential data race. r=asuth, a=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D104819", "files": ["dom/base/EventSource.cpp", "dom/base/EventSource.h"], "git_node": null, "git_parents": [null], "node": "21131db75e03a1232d262e3e9252ac91c9d3eebd", "parents": ["0e8f444683cb9c4079d3b2250f32f986043ea582"], "tags": []}], "date": 1613096961, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "197": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1678734 - Fix crash in StreamFilter with view-source. r=mixedpuppy, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D100146", "files": ["netwerk/protocol/viewsource/nsIViewSourceChannel.idl", "netwerk/protocol/viewsource/nsViewSourceChannel.cpp", "toolkit/components/extensions/test/xpcshell/test_ext_webRequest_viewsource_StreamFilter.js", "toolkit/components/extensions/test/xpcshell/xpcshell-e10s.ini", "toolkit/components/extensions/test/xpcshell/xpcshell-remote.ini", "toolkit/components/extensions/webrequest/StreamFilterParent.cpp"], "git_node": null, "git_parents": [null], "node": "2b4f1f232bacee02171d462ba1249acee57a478a", "parents": ["21131db75e03a1232d262e3e9252ac91c9d3eebd"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1687391 - Avoid using a spinlock in ThreadSafeWeakReference, r=glandium,mccr8,Gankra,sg a=RyanVM\n\nThis new approach to weak references is roughly modeled after the approach used\nby Rust's Arc\u003cT\u003e, and uses an atomic compare-and-swap loop to perform weak to\nstrong reference upgrades. This approach ends up moving the strong reference\ncount out of the tracked object and into the weak reference object, as the\nstrong reference count atomic needs to outlife the object itself.\n\nRust's Arc Weak::upgrade implementation:\nhttps://github.com/rust-lang/rust/blob/d98d2f57d9b98325ff075c343d2c7695b66dfa7d/library/alloc/src/sync.rs#L1806-L1837\n\nDifferential Revision: https://phabricator.services.mozilla.com/D102245", "files": ["dom/indexedDB/SafeRefPtr.h", "dom/workers/WorkerPrivate.cpp", "gfx/2d/GenericRefCounted.h", "image/Image.cpp", "mfbt/RefCounted.h", "mfbt/ThreadSafeWeakPtr.h", "mfbt/tests/TestThreadSafeWeakPtr.cpp"], "git_node": null, "git_parents": [null], "node": "cecd979ce5ff9d66d6b61f3534b80164065e7f99", "parents": ["2b4f1f232bacee02171d462ba1249acee57a478a"], "tags": []}], "date": 1613169921, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "198": {"changesets": [{"author": "Christoph Kerschbaumer \u003cckerschb@christophkerschbaumer.com\u003e", "branch": "default", "desc": "Bug 1687342: Blocked-URI in CSP reports should be URI before redirects with ref removed r=freddyb,dveditz a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D103450", "files": ["dom/security/nsCSPContext.cpp", "dom/security/test/csp/test_blocked_uri_in_reports.html", "testing/web-platform/meta/content-security-policy/frame-src/frame-src-redirect.html.ini"], "git_node": null, "git_parents": [null], "node": "93aa4e03d7a15b52a041afee6f64ca2b51821a52", "parents": ["cecd979ce5ff9d66d6b61f3534b80164065e7f99"], "tags": []}, {"author": "Christoph Kerschbaumer \u003cckerschb@christophkerschbaumer.com\u003e", "branch": "default", "desc": "Bug 1542194: Set original frame src load. r=mattwoodrow, a=RyanVM", "files": ["docshell/base/nsDocShell.cpp", "ipc/glue/BackgroundUtils.cpp", "netwerk/base/LoadInfo.cpp", "netwerk/base/LoadInfo.h", "netwerk/ipc/NeckoChannelParams.ipdlh"], "git_node": null, "git_parents": [null], "node": "748f749fda1daddeee3f5b01c85b0b59261c15d4", "parents": ["93aa4e03d7a15b52a041afee6f64ca2b51821a52"], "tags": []}, {"author": "Christoph Kerschbaumer \u003cckerschb@christophkerschbaumer.com\u003e", "branch": "default", "desc": "Bug 1542194: Update blocked-uri in CSP reporting by treating frame naviations as redirects. r=freddyb,dveditz,mixedpuppy, a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D103697", "files": ["dom/security/nsCSPService.cpp", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/extensions/test/xpcshell/test_ext_contentscript_triggeringPrincipal.js"], "git_node": null, "git_parents": [null], "node": "70b9086b702c80e3a9f22a8cb7ac302f8d361bec", "parents": ["748f749fda1daddeee3f5b01c85b0b59261c15d4"], "tags": []}, {"author": "Alexis Beingessner \u003ca.beingessner@gmail.com\u003e", "branch": "default", "desc": "Bug 1616120 - Add suppression for esr78. r=decoder, a=npotb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D102332", "files": ["mozglue/build/TsanOptions.cpp"], "git_node": null, "git_parents": [null], "node": "598091ee313cb2e5a113828bbf7fc956f05ddf27", "parents": ["70b9086b702c80e3a9f22a8cb7ac302f8d361bec"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D105196", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0269f1ca7e71a0f887afd52366a9758faa9ba9ee", "parents": ["598091ee313cb2e5a113828bbf7fc956f05ddf27"], "tags": []}], "date": 1613518005, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "199": {"changesets": [{"author": "Mitchell Hentges \u003cmhentges@mozilla.com\u003e", "branch": "default", "desc": "Bug 1686168: Immediately unset __PYVENV_LAUNCHER__ when `mach` starts. r=sheehan,glandium a=RyanVM\n\nCatch additional cases where both __PYVENV_LAUNCHER__ is set and we invoke a\nvirtualenv python by unsetting the variable in a prominent location.\nThis will specifically catch the `./mach bootstrap` =\u003e `./mach artifact` case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D101809", "files": ["mach"], "git_node": null, "git_parents": [null], "node": "a4c6c50586984d9df575e089220edada13449155", "parents": ["0269f1ca7e71a0f887afd52366a9758faa9ba9ee"], "tags": ["FIREFOX_78_8_0esr_BUILD1"]}], "date": 1613518455, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "200": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging a4c6c50586984d9df575e089220edada13449155 with FIREFOX_78_8_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "f2c5b8fc309765988d59bf5f56f1a9c655176153", "parents": ["a4c6c50586984d9df575e089220edada13449155"], "tags": []}], "date"