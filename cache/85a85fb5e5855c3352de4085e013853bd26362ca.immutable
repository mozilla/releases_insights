s:156979:"{
"lastpushid": 336,
"pushes": {"176": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cb919a80aa244e2734a36f0122280125b1a0f7e1 with FIREFOX_78_7_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "bac1459b5c65dc25b53c3b081aa777c8eea8f136", "parents": ["cb919a80aa244e2734a36f0122280125b1a0f7e1"], "tags": []}], "date": 1611166641, "git_changesets": [null], "user": "ffxbld"}, "177": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "c26b03b8b828c72af47caec4120472fc9d93d820", "parents": ["bac1459b5c65dc25b53c3b081aa777c8eea8f136"], "tags": []}], "date": 1611590749, "git_changesets": [null], "user": "ffxbld-merge"}, "178": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D102913", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "423f532365bf7614c17f2cb790fef7b3c0ff2f74", "parents": ["c26b03b8b828c72af47caec4120472fc9d93d820"], "tags": []}], "date": 1611591375, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "179": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cb919a80aa244e2734a36f0122280125b1a0f7e1 with FIREFOX_78_7_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "a530113f084bad770db50acf9649e199a989d55f", "parents": ["423f532365bf7614c17f2cb790fef7b3c0ff2f74"], "tags": []}], "date": 1611668938, "git_changesets": [null], "user": "ffxbld"}, "180": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1678451 - Split the Ubuntu test image and work around recent issues. r=releng-reviewers,bhearsum\n\nTo avoid breakage from Ubuntu package upgrades, we split the test image\ninto two, one that sets up the packages only, and that won't change when\nwe need to update our scripts, and another that derives from it, that\nadds all our scripts and other setup.\n\nAdditionally, we work around the recent timeout issues due to the\nupgrade of packages.\n\nThe timeout itself is due to gst-launch waiting indefinitely when it\ncrashes, rather than exiting with an error code. Bug 1679491 addresses\nthis issue, but the core problem is that gst-launch crashes, which seems\nto be that some change in libc (presumably \"Fix pthread_rwlock_try*lock\nstalls\") turns `gst_object_unref: assertion '((GObject *)\nobject)-\u003eref_count \u003e 0' failed` fatal warnings (which were already\nhappening) into actual crashes (presumably because a race condition is\nlost on a use-after-free).\n\nThis workaround, however, will stop working as soon as the updated libc\npackage migrates from bionic-updates into bionic proper, presumaby on\nthe next 18.04 dot-release. Hopefully, we won't be rebuilding the base\nimage for a while, avoiding further problems. Eventually, we'll want to\nupload the base image to docker hub so that it's set in stone, and\nchange the FROM in the base image to use that instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D98045", "files": ["taskcluster/ci/docker-image/kind.yml", "taskcluster/docker/recipes/ubuntu1804-test-system-setup-base.sh", "taskcluster/docker/recipes/ubuntu1804-test-system-setup.sh", "taskcluster/docker/ubuntu1804-test-base/Dockerfile", "taskcluster/docker/ubuntu1804-test-base/apt-prefs", "taskcluster/docker/ubuntu1804-test/Dockerfile"], "git_node": null, "git_parents": [null], "node": "69c45feebe448ffd6d9f92b239b19e3234ab5002", "parents": ["a530113f084bad770db50acf9649e199a989d55f"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1656999 - Unmark now-passing tests.\n\nSome tests now pass after rebuilding Docker images in bug 1616925.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85937", "files": ["dom/canvas/test/webgl-conf/generated-mochitest.ini", "dom/canvas/test/webgl-conf/mochitest-errata.ini"], "git_node": null, "git_parents": [null], "node": "52f5840091efe16f7efbacb9a71f2a16b4ac6dcb", "parents": ["69c45feebe448ffd6d9f92b239b19e3234ab5002"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Backed out backout a106e18f969cdbcf41bec507c000db67c27927ad (bug 1669879, bug 1677914) . a=release", "files": ["python/mach/mach/mixin/process.py", "taskcluster/ci/config.yml", "taskcluster/ci/generate-profile/kind.yml", "taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/build.py", "taskcluster/taskgraph/transforms/job/toolchain.py"], "git_node": null, "git_parents": [null], "node": "e73c1715c63dd35b7722f0d16d775162ef95143a", "parents": ["52f5840091efe16f7efbacb9a71f2a16b4ac6dcb"], "tags": []}], "date": 1611688153, "git_changesets": [null, null, null], "user": "asasaki@mozilla.com"}, "181": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Back out changeset e73c1715c63d", "files": ["python/mach/mach/mixin/process.py", "taskcluster/ci/config.yml", "taskcluster/ci/generate-profile/kind.yml", "taskcluster/scripts/run-task", "taskcluster/taskgraph/transforms/build.py", "taskcluster/taskgraph/transforms/job/toolchain.py"], "git_node": null, "git_parents": [null], "node": "f044f936991d2857cd06a2b71e1dc4afce2622f4", "parents": ["e73c1715c63dd35b7722f0d16d775162ef95143a"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 52f5840091ef", "files": ["dom/canvas/test/webgl-conf/generated-mochitest.ini", "dom/canvas/test/webgl-conf/mochitest-errata.ini"], "git_node": null, "git_parents": [null], "node": "7509bf91205e246f564d1871d2031535be8865a3", "parents": ["f044f936991d2857cd06a2b71e1dc4afce2622f4"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 69c45feebe44 a=release", "files": ["taskcluster/ci/docker-image/kind.yml", "taskcluster/docker/recipes/ubuntu1804-test-system-setup-base.sh", "taskcluster/docker/recipes/ubuntu1804-test-system-setup.sh", "taskcluster/docker/ubuntu1804-test-base/Dockerfile", "taskcluster/docker/ubuntu1804-test-base/apt-prefs", "taskcluster/docker/ubuntu1804-test/Dockerfile"], "git_node": null, "git_parents": [null], "node": "5db035cb5c68886076c9632af5dd25c53ec0ce4a", "parents": ["7509bf91205e246f564d1871d2031535be8865a3"], "tags": []}], "date": 1611695914, "git_changesets": [null, null, null], "user": "asasaki@mozilla.com"}, "182": {"changesets": [{"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648506 - Disable some python tests on py2 on mac; r=mhentges, a=RyanVM\n\nThese tests fail on py2 on osx when 'mach python-test' runs with python 3, blocking\nbug 1594914.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81247", "files": ["python/mozbuild/mozbuild/test/python.ini", "python/mozbuild/mozpack/test/python.ini"], "git_node": null, "git_parents": [null], "node": "17fc73573d8d93e44bb422cfaa9447abdecb69c3", "parents": ["5db035cb5c68886076c9632af5dd25c53ec0ce4a"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1614626 - Move xpcshell selftests to before running actual xpcshell tests. r=gbrown, a=RyanVM\n\nThis allows to test them in the exact same environment as the tests are\ngoing to run, which turns out to have revealed a few issues that would\nonly appear once xpcshell tests fail, impeding on debugging those\nfailures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84781", "files": ["python/mozbuild/mozbuild/action/test_archive.py", "testing/mozharness/configs/unittests/linux_unittest.py", "testing/mozharness/configs/unittests/mac_unittest.py", "testing/mozharness/configs/unittests/win_unittest.py", "testing/testsuite-targets.mk", "testing/xpcshell/moz.build", "testing/xpcshell/python.ini", "testing/xpcshell/runxpcshelltests.py", "testing/xpcshell/selftest.py", "testing/xpcshell/xpcshellcommandline.py"], "git_node": null, "git_parents": [null], "node": "a00af3bc78a83d6c4eb99abd9f764f2e8c7f3e30", "parents": ["17fc73573d8d93e44bb422cfaa9447abdecb69c3"], "tags": []}, {"author": "Ricky Stewart \u003crstewart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1655111 - Stop running `mach python-test` during `make check` r=froydnj, a=RyanVM\n\nAfter bug 1614626, the last remaining `python-test` that runs during builds is the `symbolstore` Python tests. Having discussed the tests with other build peers, nobody seems to think these tests are valuable or have recently failed or uncovered an issue. In lieu of changing the way the `symbolstore` tests work we can leave them in-tree unchanged for now and just stop running them in CI entirely.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85209", "files": ["testing/testsuite-targets.mk"], "git_node": null, "git_parents": [null], "node": "e901b8f5b9df9d0e41634ee73e72a61cab2b334c", "parents": ["a00af3bc78a83d6c4eb99abd9f764f2e8c7f3e30"], "tags": []}, {"author": "Hamzah \u003chamzah18051@iiitd.ac.in\u003e", "branch": "default", "desc": "Bug 1594914 - Convert mach python-test to run with python 3. r=gbrown, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D77872", "files": ["mach", "python/mach_commands.py", "python/mozbuild/mozbuild/pythonutil.py", "python/mozbuild/mozbuild/virtualenv.py", "testing/mozbase/moznetwork/moznetwork/moznetwork.py"], "git_node": null, "git_parents": [null], "node": "2e5fc3e1f0828077282a48d9e2e5f367f0a2ea2e", "parents": ["e901b8f5b9df9d0e41634ee73e72a61cab2b334c"], "tags": []}, {"author": "Mitchell Hentges \u003cmhentges@mozilla.com\u003e", "branch": "default", "desc": "Bug 1654074: Make @CommandProvider validation more specific. r=rstewart, a=RyanVM\n\n@CommandProvider does parameter validation and collects information (such\nas \"pass_context\") that will be needed by Registrar.\n\nHowever, rather than just checking parameter length, we can make it more\nspecific and assert that the specific expected parameter (\"context\") exists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85482", "files": ["python/mach/mach/decorators.py", "python/mach/mach/main.py"], "git_node": null, "git_parents": [null], "node": "d90ed108cfc9766474779c567570c3e817999c41", "parents": ["2e5fc3e1f0828077282a48d9e2e5f367f0a2ea2e"], "tags": []}, {"author": "Ricky Stewart \u003crstewart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1657650 - Require that Mach command providers subclass MachCommandBase. r=maja_zf,mhentges,froydnj a=RyanVM\n\nToday we don't require that `mach` `CommandProvider`s subclass from any particular parent class and we're very lax about the requirements they must meet. While that's convenient in certain circumstances, it has some unfortunate implications for feature development.\n\nToday the only requirements that we have for `CommandProvider`s are that they have an `__init__()` method that takes either 1 or 2 arguments, the second of which must be called `context` and is populated with the `mach` `CommandContext`. Again, while this flexibility is occasionally convenient, it is limiting. As we add features to `mach`, having a better idea what the shape of our `CommandProvider`s are and how we can instantiate them and use them is increasingly important, and this gives us additional control when having `mach` configure `CommandProvider`s based on data that is only available at the `mach` level. In particular, we plan to leverage this in bugs 985141 and 1654074.\n\nHere we add validation to the `CommandProvider` decorator to ensure all classes inherit from `MachCommandBase`, update all `CommandProvider`s in-tree to inherit from `MachCommandBase`, and update source and test code accordingly.\n\nFollow-up work: we now require (de facto) that the `context` be populated with a `topdir` attribute by the `populate_context_handler` function, since instantiating the `MachCommandBase` requires a `topdir` be provided. This is fine for now in the interest of keeping this patch reasonably sized, but some additional refactoring could make this cleaner.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86255", "files": ["build/valgrind/mach_commands.py", "js/src/devtools/rootAnalysis/mach_commands.py", "layout/tools/reftest/mach_test_package_commands.py", "python/mach/docs/commands.rst", "python/mach/docs/settings.rst", "python/mach/mach/commands/commandinfo.py", "python/mach/mach/commands/settings.py", "python/mach/mach/decorators.py", "python/mach/mach/dispatcher.py", "python/mach/mach/main.py", "python/mach/mach/registrar.py", "python/mach/mach/test/providers/basic.py", "python/mach/mach/test/providers/commands.py", "python/mach/mach/test/providers/conditions.py", "python/mach/mach/test/providers/conditions_invalid.py", "python/mach/mach/test/providers/throw.py", "python/mach/mach/test/test_commands.py", "python/mach/mach/test/test_conditions.py", "python/mach/mach/test/test_error_output.py", "python/mozboot/mozboot/mach_commands.py", "python/mozbuild/mozbuild/base.py", "remote/mach_commands.py", "taskcluster/mach_commands.py", "testing/gtest/mach_test_package_commands.py", "testing/marionette/mach_test_package_commands.py", "testing/mochitest/mach_test_package_commands.py", "testing/mozbase/mozrunner/mozrunner/devices/android_device.py", "testing/web-platform/mach_test_package_commands.py", "testing/xpcshell/mach_test_package_commands.py", "tools/compare-locales/mach_commands.py", "tools/mach_commands.py", "tools/moztreedocs/mach_commands.py", "tools/power/mach_commands.py", "tools/tryselect/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "48d786b062f92e408a707d5e4a74090980c52452", "parents": ["d90ed108cfc9766474779c567570c3e817999c41"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 985141 - [mozbuild] Remove leading underscore from MozbuildObject._activate_virtualenv. r=andi,AlexandruIonescu,rstewart a=RyanVM\n\nThis function is used all across the tree and should be considered a public API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85045", "files": ["build/upload_generated_sources.py", "python/mach_commands.py", "python/mozbuild/mozbuild/base.py", "python/mozbuild/mozbuild/code-analysis/mach_commands.py", "python/mozbuild/mozbuild/frontend/mach_commands.py", "python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/vendor_python.py", "python/mozperftest/mozperftest/browser/noderunner.py", "python/mozperftest/mozperftest/mach_commands.py", "testing/condprofile/mach_commands.py", "testing/mach_commands.py", "testing/mochitest/mach_commands.py", "testing/web-platform/mach_commands.py", "toolkit/crashreporter/tools/upload_symbols.py", "tools/browsertime/mach_commands.py", "tools/lint/mach_commands.py", "tools/mach_commands.py", "tools/tryselect/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "eb4d9f7b6378ea05b86684b34d5a37b20c9ce192", "parents": ["48d786b062f92e408a707d5e4a74090980c52452"], "tags": []}, {"author": "Andrew Halberstadt \u003cahalberstadt@mozilla.com\u003e", "branch": "default", "desc": "Bug 985141 - [mozperftest] Fix missed instances of _activate_virtualenv in mozperftest framework. r=sparky, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D85203", "files": ["python/mozperftest/mozperftest/tests/test_mach_commands.py"], "git_node": null, "git_parents": [null], "node": "ce1a5d0f3458eff53cba359603d7ba5cea44adae", "parents": ["eb4d9f7b6378ea05b86684b34d5a37b20c9ce192"], "tags": []}, {"author": "Ricky Stewart \u003crstewart@mozilla.com\u003e", "branch": "default", "desc": "Bug 985141 - Allow mach commands to specify what virtualenv they should use. r=mhentges,dmajor a=RyanVM\n\nNow you can pass the `virtualenv_name` kwarg to the `Command` decorator which will configure the `_virtualenv_manager` accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86256", "files": ["python/mach/mach/decorators.py", "python/mach/mach/dispatcher.py", "python/mach/mach/registrar.py", "python/mozbuild/mozbuild/base.py", "python/mozbuild/mozbuild/code-analysis/mach_commands.py", "python/mozbuild/mozbuild/test/test_base.py"], "git_node": null, "git_parents": [null], "node": "fb60f781ba8ac5ab7922b78a11edffaad4c58bdf", "parents": ["ce1a5d0f3458eff53cba359603d7ba5cea44adae"], "tags": []}, {"author": "Ricky Stewart \u003crstewart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1659113 - Fix bad call to constructor of Build object after bug 985141. r=froydnj, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D87076", "files": ["testing/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "fac7cded5c6a8cdf8c990b4bb45a3dca5eb7695d", "parents": ["fb60f781ba8ac5ab7922b78a11edffaad4c58bdf"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1659411 - Default virtualenv_name to None in MachCommandBase. r=rstewart, a=RyanVM\n\nBug #985141 added this argument without changing all the callers.\nInstead of fixing each caller individually, just allow a value not to be\npassed in. This is what the underlying MozbuildObject class does\nanyways.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D87386", "files": ["python/mozbuild/mozbuild/base.py"], "git_node": null, "git_parents": [null], "node": "3e4ec610debfb5a9be23fc53f19e7ad13d8a660f", "parents": ["fac7cded5c6a8cdf8c990b4bb45a3dca5eb7695d"], "tags": []}, {"author": "Ricky Stewart \u003crstewart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1659539 - [python-test] Remove '--python' and stop using pipenv to manage virtualenvs. r=ahal, a=RyanVM\n\nPipenv is heavy weight and overkill for the purposes it is being used. We'd like to remove it from the tree and |mach python-test| was one of the last remanining use cases.\n\nRemove the `--python` command-line argument as a result. Users who wish to run unit tests with Python 2 can do `MACH_PY2=1 ./mach python-test ...` or `python2 ./mach python-test ...`.\n\nAlso update a few unit tests that would break otherwise in the presence of this change.\n\nThere were a couple lines in the `setup.py` for `mozlog` that were problematic for tests and was resulting in errors due to the `mozlog` plugin being loaded by `pytest` more than once. We just delete those lines and bump up the major version number of the package to fix it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88296", "files": ["python/mach_commands.py", "python/mozbuild/mozbuild/test/configure/common.py", "python/mozbuild/mozbuild/test/configure/test_toolkit_moz_configure.py", "taskcluster/ci/source-test/python.yml", "taskcluster/taskgraph/transforms/job/mach.py", "taskcluster/taskgraph/transforms/job/python_test.py", "testing/mozbase/mozlog/setup.py"], "git_node": null, "git_parents": [null], "node": "a8280827e0aa11c063128134d0f8e87a84ecca6e", "parents": ["3e4ec610debfb5a9be23fc53f19e7ad13d8a660f"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1654457 - Update virtualenv to 20.0.31. r=mhentges,rstewart a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92173", "files": ["python/mozbuild/mozbuild/virtualenv.py", "third_party/python/virtualenv/AUTHORS.txt", "third_party/python/virtualenv/LICENSE.txt", "third_party/python/virtualenv/MANIFEST.in", "third_party/python/virtualenv/PKG-INFO", "third_party/python/virtualenv/README.rst", "third_party/python/virtualenv/README_MOZILLA", "third_party/python/virtualenv/__main__.py", "third_party/python/virtualenv/__virtualenv__/appdirs-1.4.4-py2.py3-none-any/appdirs-1.4.4.dist-info/LICENSE.txt", "third_party/python/virtualenv/__virtualenv__/appdirs-1.4.4-py2.py3-none-any/appdirs-1.4.4.dist-info/METADATA", "third_party/python/virtualenv/__virtualenv__/appdirs-1.4.4-py2.py3-none-any/appdirs-1.4.4.dist-info/RECORD", "third_party/python/virtualenv/__virtualenv__/appdirs-1.4.4-py2.py3-none-any/appdirs-1.4.4.dist-info/WHEEL", "third_party/python/virtualenv/__virtualenv__/appdirs-1.4.4-py2.py3-none-any/appdirs-1.4.4.dist-info/top_level.txt", "third_party/python/virtualenv/__virtualenv__/appdirs-1.4.4-py2.py3-none-any/appdirs.py", "third_party/python/virtualenv/__virtualenv__/configparser-4.0.2-py2.py3-none-any/backports/__init__.py", "third_party/python/virtualenv/__virtualenv__/configparser-4.0.2-py2.py3-none-any/backports/configparser/__init__.py", "third_party/python/virtualenv/__virtualenv__/configparser-4.0.2-py2.py3-none-any/backports/configparser/helpers.py", "third_party/python/virtualenv/__virtualenv__/configparser-4.0.2-py2.py3-none-any/configparser-4.0.2.dist-info/LICENSE", "third_party/python/virtualenv/__virtualenv__/configparser-4.0.2-py2.py3-none-any/configparser-4.0.2.dist-info/METADATA", "third_party/python/virtu