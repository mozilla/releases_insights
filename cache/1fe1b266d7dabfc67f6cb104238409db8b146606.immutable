s:32938:"{
"lastpushid": 1568,
"pushes": {"203": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging aa9f02961b2bbb92e17fea5d6b8fd14c097baf72 with FIREFOX_115_6_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "049208f6026dabc30c026a567d5e85586ce30cdf", "parents": ["aa9f02961b2bbb92e17fea5d6b8fd14c097baf72"], "tags": []}], "date": 1702321737, "git_changesets": [null], "user": "ffxbld"}, "204": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1869944 - Relax the version of zstandard allowed by the mach site. r=ahochheiden a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196378", "files": ["python/sites/mach.txt"], "git_node": null, "git_parents": [null], "node": "c0760ddf4c36b115bd25f8d1412dbb6770b9a907", "parents": ["049208f6026dabc30c026a567d5e85586ce30cdf"], "tags": []}], "date": 1702522725, "git_changesets": [null], "user": "nfay@mozilla.com"}, "205": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "9d63a16503940029057c683f9862e293716215d4", "parents": ["c0760ddf4c36b115bd25f8d1412dbb6770b9a907"], "tags": []}], "date": 1702917352, "git_changesets": [null], "user": "ffxbld-merge"}, "206": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging aa9f02961b2bbb92e17fea5d6b8fd14c097baf72 with FIREFOX_115_6_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b15e85484853e8bc0215d5d2d28c7f0ea9859293", "parents": ["9d63a16503940029057c683f9862e293716215d4"], "tags": []}], "date": 1702994400, "git_changesets": [null], "user": "ffxbld"}, "207": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1838265 - Clean-up \u003ctitle\u003e code. r=smaug, a=dmeehan\n\nTrivialish clean-ups while I was looking at this code, and related\nclean-ups elsewhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180850", "files": ["dom/base/Document.cpp"], "git_node": null, "git_parents": [null], "node": "37ce357fdc0fff57a09e74f049392b203cdffca6", "parents": ["b15e85484853e8bc0215d5d2d28c7f0ea9859293"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1866385 - Re-enqeue suppressed microtasks when destroying SavedMicroTaskQueue r=arai, a=dmeehan\n\nI have yet to be able to produce an automated test for things under the control of\nnsAutoSyncOperation; this patch has been verified locally using the following STR,\nmodified from [1].\n\nSTR for Mac\n\n 1. Go to https://debugger-crash-before-print.glitch.me/\n 2. Open debugger\n 3. Press Command + P to trigger print for the page (This should cause the debugger to pause on line 2)\n 4. Go to the console, and enter Promise.resolve(10).then(() =\u003e {}).\n 5. Resume execution and cancel the print preview.\n 5. Tab Crashes\n\n[1]: https://bugzilla.mozilla.org/show_bug.cgi?id=1849675#c3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D195900", "files": ["xpcom/base/CycleCollectedJSContext.cpp"], "git_node": null, "git_parents": [null], "node": "7fa0b1df522d32138f249f6e6eed9202ad3c105f", "parents": ["37ce357fdc0fff57a09e74f049392b203cdffca6"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197059", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0b474b39b5e5eeedd8898936f5eb521cb3a2988a", "parents": ["7fa0b1df522d32138f249f6e6eed9202ad3c105f"], "tags": []}], "date": 1703172128, "git_changesets": [null, null, null], "user": "dmeehan@mozilla.com"}, "208": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1848628: Null-check swipe tracker before cleaning it up, in nsBaseWidget::SwipeFinished.  a=dmeehan\n\nIt seems unexpected that the swipe tracker would be non-null when a swipe\nfinishes, but there are several codepaths that can clear it, which might\nconceivably fire while the SwipeFinished callback is in the queue to be\ndispatched.\n\nNote that before bug 1837226, SwipeFinished just nulled out the pointer, which\nwas harmless if it was already null.  My patch in bug 1837226 made us start\ncalling a method as well, and that created a new opportunity for a null-deref\ncrash here if the pointer happens to be null when we reach this function.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D186204\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196360", "files": ["widget/nsBaseWidget.cpp"], "git_node": null, "git_parents": [null], "node": "0f158c2767db4d0e5f486c70fa83ba6cec4f1287", "parents": ["0b474b39b5e5eeedd8898936f5eb521cb3a2988a"], "tags": []}], "date": 1703182956, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "209": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1660223: Let printer enumeration run to completion, to avoid a GTK bug.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D195949\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196685", "files": ["widget/gtk/nsDeviceContextSpecG.cpp", "widget/gtk/nsDeviceContextSpecG.h"], "git_node": null, "git_parents": [null], "node": "0168b085c45b39f0f2ddb3d671e2e3a6f6631ff6", "parents": ["0f158c2767db4d0e5f486c70fa83ba6cec4f1287"], "tags": []}], "date": 1703683349, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "210": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1865689 - Clarify access checks in devtools.inspectedWindow.eval r=rpl,devtools-reviewers,ochameau, a=dmeehan\n\nand report a static error instead of including the URL in the message.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196133", "files": ["devtools/server/actors/addon/webextension-inspected-window.js", "devtools/shared/commands/inspected-window/tests/browser.ini", "devtools/shared/commands/inspected-window/tests/browser_webextension_inspected_window.js", "devtools/shared/commands/inspected-window/tests/browser_webextension_inspected_window_access.js"], "git_node": null, "git_parents": [null], "node": "f1e03fbd5a7642489f6b236303294aa19e7481af", "parents": ["0168b085c45b39f0f2ddb3d671e2e3a6f6631ff6"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1865689 - Fixup browser.toml - move prefs to DEFAULT. a=test-only\n\nThe individual test ran as expected when prefs was next to the file.\nBut when the whole directory is selected, the test runner refuses to\nrun the test due to the following error:\n\n\u003e The 'prefs' key must be set in the DEFAULT section of a manifest.\n\nThis patch fixes the issue by moving prefs to DEFAULT. This is okay\nbecause the other test in the test manifest is independent of the pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196295", "files": ["devtools/shared/commands/inspected-window/tests/browser.ini"], "git_node": null, "git_parents": [null], "node": "18a676f4bf5da32ade6aef58381f5378606651cc", "parents": ["f1e03fbd5a7642489f6b236303294aa19e7481af"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197372", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "002a9e9770fe2e57c5c98f6cc213bce7a2a0a578", "parents": ["18a676f4bf5da32ade6aef58381f5378606651cc"], "tags": []}], "date": 1703789594, "git_changesets": [null, null, null], "user": "dmeehan@mozilla.com"}, "211": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out 2 changesets (bug 1865689) for causing test failures\n\nBacked out changeset 18a676f4bf5d (bug 1865689)\nBacked out changeset f1e03fbd5a76 (bug 1865689)", "files": ["devtools/server/actors/addon/webextension-inspected-window.js", "devtools/shared/commands/inspected-window/tests/browser.ini", "devtools/shared/commands/inspected-window/tests/browser_webextension_inspected_window.js", "devtools/shared/commands/inspected-window/tests/browser_webextension_inspected_window_access.js"], "git_node": null, "git_parents": [null], "node": "5c964bb7aa99de2e4c7de4c5ef130f77d2324cde", "parents": ["002a9e9770fe2e57c5c98f6cc213bce7a2a0a578"], "tags": []}], "date": 1703795107, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "212": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1868998 - Mark custom-car jobs as running nowhere and not being cached. r=taskgraph-reviewers,kshampur,jcristau a=release\n\nThey are triggered via cron, so an empty run-on-projects should be the\nappropriate config.\n\nAs they are not idempotent (they will pick the last from upstream on\neach run), they also shouldn't be cached.", "files": ["taskcluster/ci/toolchain/misc.yml"], "git_node": null, "git_parents": [null], "node": "b6fde2e8b099623d1ac94b9e28e3482ab01383e8", "parents": ["5c964bb7aa99de2e4c7de4c5ef130f77d2324cde"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1869128 - Fix llvm-symbolizer condition in build-sm.sh. r=firefox-build-system-reviewers,sergesanspaille a=npotb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D195960", "files": ["taskcluster/scripts/builder/build-sm.sh"], "git_node": null, "git_parents": [null], "node": "b8d6f1fcefecf913f749aa0b95daeb0874bda967", "parents": ["b6fde2e8b099623d1ac94b9e28e3482ab01383e8"], "tags": []}], "date": 1703956778, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "213": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197473", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "636a9054f04b5c65a4fbe1b79b91f1ee32629a99", "parents": ["b8d6f1fcefecf913f749aa0b95daeb0874bda967"], "tags": []}], "date": 1704207026, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "214": {"changesets": [{"author": "Francesco Lodolo (:flod) \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 1866313 - Update l10n-changesets.json for ESR115, r=RyanVM, a=l10n-bump\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197482", "files": ["browser/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "b2c0698cf97e2c7367b458ab576a8774865656e5", "parents": ["636a9054f04b5c65a4fbe1b79b91f1ee32629a99"], "tags": []}], "date": 1704220994, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "215": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1868137 - Allow setting alerts. prefs via policy.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D195731\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197512", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs"], "git_node": null, "git_parents": [null], "node": "1692ff7688742d29aafc2fad21fabbbca3c9e8ce", "parents": ["b2c0698cf97e2c7367b458ab576a8774865656e5"], "tags": []}], "date": 1704294057, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "216": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1866295 - Land new strings for ASRouter spotlight message to encourage users without FxA accounts to create one.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D194553\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197601", "files": ["browser/locales/en-US/browser/newtab/asrouter.ftl", "python/l10n/fluent_migrations/bug_1866295_new_device_migration_strings.py"], "git_node": null, "git_parents": [null], "node": "f3e834d221c67a8592e3e9d0a19854782e5f58ed", "parents": ["1692ff7688742d29aafc2fad21fabbbca3c9e8ce"], "tags": []}], "date": 1704303380, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "217": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1866295 - fix lint failure for ESR115 a=me", "files": ["python/l10n/fluent_migrations/bug_1866295_new_device_migration_strings.py"], "git_node": null, "git_parents": [null], "node": "c95b9944f34f969b9b809d69c6605293055a4c8e", "parents": ["f3e834d221c67a8592e3e9d0a19854782e5f58ed"], "tags": []}], "date": 1704305949, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "218": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1868680 - Stop prewarming the ARM AVD. r=geckoview-reviewers,owlish a=release DONTBUILD\n\nprewarming the AVDs was done for CI, where AVDs are used only once in\neach task using them, and the cost of first use is high. Prewarming\nreduces that overhead.\n\nHowever, the ARM AVD is not used on CI (anymore?), so we don't need\nthem prewarmed. This unblocks the situation wrt the failure to run\nthe emulator on CI, while not addressing the underlying issues, so that\nCoT keys can be rotated without waiting for the full situation to be\nresolved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D195820", "files": ["python/mozboot/mozboot/android-avds/arm.json"], "git_node": null, "git_parents": [null], "node": "f7e37ab080b0a57d3cb3454f1b375c65d6f080c8", "parents": ["c95b9944f34f969b9b809d69c6605293055a4c8e"], "tags": []}], "date": 1704377331, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "219": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1867346 - Tweak strings for ASRouter spotlight message to encourage users without FxA accounts to create one. r=fluent-reviewers,flod, a=dmeehan, l10n=flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D195013", "files": ["browser/locales/en-US/browser/newtab/asrouter.ftl", "python/l10n/fluent_migrations/bug_1867346_new_device_migration_string_replacement.py"], "git_node": null, "git_parents": [null], "node": "f55d7baa02d5ab63d73c31826cf919f6111497ce", "parents": ["f7e37ab080b0a57d3cb3454f1b375c65d6f080c8"], "tags": []}, {"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1867912 - Update Device Migration Spotlight string. r=fluent-reviewers,kpatenio, a=dmeehan, l10n=flod\nDifferential Revision: https://phabricator.services.mozilla.com/D196099", "files": ["browser/locales/en-US/browser/newtab/asrouter.ftl"], "git_node": null, "git_parents": [null], "node": "5b21ad7e87ebd51c4d4949bf433dc516a7059f7a", "parents": ["f55d7baa02d5ab63d73c31826cf919f6111497ce"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1870262 - a subdomain of any HSTS superdomain that asserts includeSubdomains is HSTS (ESR115) r=jschanck, a=dmeehan\n\n\nPreviously, the HSTS implementation would only consider the first superdomain\nthat had any HSTS information and use the presence or absence of the\nincludeSubdomains directive to determine if the subdomain was HSTS. However,\nthe specification actually stipulates that if any superdomain that is HSTS\nasserts includeSubdomains, the subdomain is HSTS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197550", "files": ["security/manager/ssl/nsSiteSecurityService.cpp", "security/manager/ssl/nsSiteSecurityService.h", "security/manager/ssl/tests/unit/test_sts_preloadlist_perwindowpb.js"], "git_node": null, "git_parents": [null], "node": "251e932660ccb47315887f99ea3f70c273803520", "parents": ["5b21ad7e87ebd51c4d4949bf433dc516a7059f7a"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1863083 - ESR, r=Gijs, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197667", "files": ["toolkit/modules/PopupNotifications.sys.mjs"], "git_node": null, "git_parents": [null], "node": "068365f6b942caeb56d82c48b2ce1f0544157c24", "parents": ["251e932660ccb47315887f99ea3f70c273803520"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197672", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "8cc757835d6c696c8c4c7b90fce67fc8f91ae86e", "parents": ["068365f6b942caeb56d82c48b2ce1f0544157c24"], "tags": []}], "date": 1704382068, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "220": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1868456: Improve ManagedPostRefreshObserver invariants.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D195607\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197611", "files": ["layout/base/nsRefreshObservers.cpp"], "git_node": null, "git_parents": [null], "node": "daec25f6dc9b6e9cc46b6004be89938fd3c4048f", "parents": ["8cc757835d6c696c8c4c7b90fce67fc8f91ae86e"], "tags": []}], "date": 1704472474, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "221": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1852420 - Ensure surface and crop rect used in ImageBitmap are valid. r=gfx-reviewers,lsalzman, a=dmeehan\n\nWhen ImageBitmap::PrepareForDrawTarget is called, we must ensure\nthat the surface returned is acceptable to the given DrawTarget. If\nit is not, then we need to recreate the surface from mData. We must\nalso ensure similar when we are creating a new ImageBitmap from\nanother ImageBitmap, as we don't know in what context it may be\nused.\n\nSimilarly, we need to ensure we produce DataSourceSurface compatible\nsurfaces when we need to both crop and premultiply.\n\nAdditionally, we now no longer clear mPictureRect or mAlphaType\nwhen we set mSurface with the cached, cropped data. Since we may\nneed to clear the cached surface, we need to know the original crop\nrect and alpha.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188056", "files": ["dom/canvas/ImageBitmap.cpp"], "git_node": null, "git_parents": [null], "node": "90599daace8d3ffa2a47f1659997fbc003fc13d5", "parents": ["daec25f6dc9b6e9cc46b6004be89938fd3c4048f"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1869195 - Fix crash in [@ mozilla::PresShell::GetRootScrollFrame]. r=emilio, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196021", "files": ["layout/base/PresShell.cpp"], "git_node": null, "git_parents": [null], "node": "6bab46d3a1e730801047a56370c13989e231ce6b", "parents": ["90599daace8d3ffa2a47f1659997fbc003fc13d5"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872956 - Avoid copying document URI in nsLayoutUtils::PaintFrame unless logging. r=layout-reviewers,tnikkel, a=dmeehan\n\nMost of the time, we don't need to call Document::GetDocumentURI in\nnsLayoutUtils::PaintFrame, as it is only used when we are logging or\ndumping to the console. We should avoid calling it because this might be\nquite large in the case of data URIs and result in OOM crashes. This is\nmost commonly observed with rasterizing SVG images.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197637", "files": ["layout/base/nsLayoutUtils.cpp"], "git_node": null, "git_parents": [null], "node": "6282c4893fe9e39f4ed2b7cd4707e30c09e020e9", "parents": ["6bab46d3a1e730801047a56370c13989e231ce6b"], "tags": []}, {"author": "Sean Feng \u003csefeng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1867152 - Fix the assertion in nsPresContext::UserInputEventsAllowed r=smaug, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196106", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "layout/base/nsPresContext.cpp"], "git_node": null, "git_parents": [null], "node": "9a1943558564ac4200be739bcd8e39790e9e06d3", "parents": ["6282c4893fe9e39f4ed2b7cd4707e30c09e020e9"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197900", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0cf521a86e8b7e61301483d5a310c247e36a916b", "parents": ["9a1943558564ac4200be739bcd8e39790e9e06d3"], "tags": []}], "date": 1704744539, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "222": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1871445 - Fix copy&paste typo in ContentParent.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D197151\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197990", "files": ["dom/ipc/ContentParent.cpp"], "git_node": null, "git_parents": [null], "node": "3844056cd99ee063dff8a41fe2d7249c927c2cb3", "parents": ["0cf521a86e8b7e61301483d5a310c247e36a916b"], "tags": []}], "date": 1704812708, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "223": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1873464 - For search related configurations, only validate additional properties on nightly builds.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D197920\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198101", "files": ["browser/components/search/test/unit/test_search_telemetry_config_validation.js"], "git_node": null, "git_parents": [null], "node": "496a204850efed47a2868762ca432abb22bbecf0", "parents": ["3844056cd99ee063dff8a41fe2d7249c927c2cb3"], "tags": []}], "date": 1704851335, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "224": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872536 - Use MakeUniqueFallible for large buffers in image decoders/encoders. r=gfx-reviewers,lsalzman, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197461", "files": ["image/decoders/icon/mac/nsIconChannelCocoa.mm", "image/decoders/nsAVIFDecoder.cpp", "image/decoders/nsBMPDecoder.cpp", "image/decoders/nsICODecoder.cpp", "image/encoders/jpeg/nsJPEGEncoder.cpp", "image/encoders/png/nsPNGEncoder.cpp", "image/encoders/webp/nsWebPEncoder.cpp"], "git_node": null, "git_parents": [null], "node": "5b0b974ccd038bdbf3c205543df5b58df8592b65", "parents": ["496a204850efed47a2868762ca432abb22bbecf0"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1834718: Don't process a duplicate DocAccessible::ContentRemoved call for a DOM node we've already processed. r=morgan, a=dmeehan\n\nContentRemoved recursively walks both AllChildrenIterator and direct DOM children.\nIn addition, we might get duplicate notifications from DOM and layout, plus PruneOrInsertSubtree might do a recursive walk and it too calls ContentRemoved.\nTo avoid this duplicate processing, keep a set of removed DOM nodes on the DocAccessible which we clear after mutation events are processed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196707", "files": ["accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h"], "git_node": null, "git_parents": [null], "node": "aaf4afe4a3f461273b28f6c06e5c45e6bdef75a0", "parents": ["5b0b974ccd038bdbf3c205543df5b58df8592b65"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1864587 - [esr115] [angle] Vendor mozilla/angle/firefox-115. r=gfx-reviewers, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198114", "files": ["gfx/angle/checkout/out/gen/angle/angle_commit.h", "gfx/angle/checkout/src/compiler/translator/VariablePacker.cpp", "gfx/angle/cherry_picks.txt", "gfx/angle/update-angle.py"], "git_node": null, "git_parents": [null], "node": "5cc988e8734ea8b09fba7087c20dc6c1c60cc10c", "parents": ["aaf4afe4a3f461273b28f6c06e5c45e6bdef75a0"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198258", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "618e904cf366871556bb178a6eb1d5d2a05cd123", "parents": ["5cc988e8734ea8b09fba7087c20dc6c1c60cc10c"], "tags": []}], "date": 1704985182, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "225": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "No bug - Make perfdocs linter happy. a=NPOTB", "files": ["testing/perfdocs/generated/raptor.rst", "testing/perfdocs/generated/talos.rst"], "git_node": null, "git_parents": [null], "node": "9a8153736f9277326a0d788b68b4279ee1fa0961", "parents": ["618e904cf366871556bb178a6eb1d5d2a05cd123"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1873701. a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198046", "files": ["dom/canvas/DrawTargetWebgl.cpp", "gfx/2d/DrawTargetD2D1.cpp", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetSkia.cpp", "gfx/2d/RecordedEvent.h", "gfx/2d/RecordedEventImpl.h", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/CanvasTranslator.h"], "git_node": null, "git_parents": [null], "node": "fcbdc4daf34e6fbd048409c0a8cbe764242fb911", "parents": ["9a8153736f9277326a0d788b68b4279ee1fa0961"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1874269 - Downgrade home for a smaller MSRV when building cargo-apk. r+a=RyanVM\n\nThis works around the lack of Cargo.lock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198324", "files": ["taskcluster/scripts/misc/wrench-deps-vendoring.sh"], "git_node": null, "git_parents": [null], "node": "5e53bac5bddc9be118589e8c9480f377b4d77957", "parents": ["fcbdc4daf34e6fbd048409c0a8cbe764242fb911"], "tags": []}], "date": 1705013323, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "226": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1865689 - Clarify access checks in devtools.inspectedWindow.eval r=rpl,devtools-reviewers,ochameau, a=dmeehan\n\nand report a static error instead of including the URL in the message.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196133", "files": ["devtools/server/actors/addon/webextension-inspected-window.js", "devtools/shared/commands/inspected-window/tests/browser.ini", "devtools/shared/commands/inspected-window/tests/browser_webextension_inspected_window.js", "devtools/shared/commands/inspected-window/tests/browser_webextension_inspected_window_access.js"], "git_node": null, "git_parents": [null], "node": "7dd25c5a4261423e737fb8b0cfd697da455cd3e7", "parents": ["5e53bac5bddc9be118589e8c9480f377b4d77957"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1865689 - ESR115 change test exceptations. a=test-only", "files": ["devtools/shared/commands/inspected-window/tests/browser.ini"], "git_node": null, "git_parents": [null], "node": "300fe5a57d9dcfa766bdcf4124104273b5c8324a", "parents": ["7dd25c5a4261423e737fb8b0cfd697da455cd3e7"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1764343 - ESR115: Remove steps in Document::Open not derived from spec. r=dveditz, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D197783", "files": ["dom/base/Document.cpp", "dom/security/test/csp/file_bug1764343.html", "dom/security/test/csp/mochitest.ini", "dom/security/test/csp/test_bug1764343.html", "testing/web-platform/meta/content-security-policy/unsafe-eval/eval-blocked-in-about-blank-iframe.html.ini"], "git_node": null, "git_parents": [null], "node": "d4bec049e2f08edc8d680a89946444c8e26dfe91", "parents": ["300fe5a57d9dcfa766bdcf4124104273b5c8324a"], "tags": []}, {"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1873927. r=gfx-reviewers,lsalzman, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198163", "files": ["gfx/ipc/CanvasManagerParent.cpp"], "git_node": null, "git_parents": [null], "node": "7f3707b0ab1f8897be0eedd476b92ae780cd0e5f", "parents": ["d4bec049e2f08edc8d680a89946444c8e26dfe91"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1873002 - Make the richlistbox contents not grow the richlistbox. r=Gijs, a=dmeehan\n\nThis matches the behavior of XUL trees, and also what we did for the\nlanguages listboxes and bug 1860214.\n\nThis is enough to fix the bug, but more in-depth fix incoming too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198395", "files": ["security/manager/pki/resources/content/certManager.css"], "git_node": null, "git_parents": [null], "node": "29e552ccfa535356cfd648343cbe388d80ab53a7", "parents": ["7f3707b0ab1f8897be0eedd476b92ae780cd0e5f"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198526", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "980ec32f825b2f54c05d16057a6e60d5b62d2ee2", "parents": ["29e552ccfa535356cfd648343cbe388d80ab53a7"], "tags": ["FIREFOX_115_7_0esr_BUILD1", "FIREFOX_115_7_0esr_RELEASE"]}], "date": 1705338192, "git_changesets": [null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}}
}";