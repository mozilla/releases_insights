ni/test_disassembler.h", "third_party/zucchini/chromium/components/zucchini/test_reference_reader.cc", "third_party/zucchini/chromium/components/zucchini/test_reference_reader.h", "third_party/zucchini/chromium/components/zucchini/test_utils.cc", "third_party/zucchini/chromium/components/zucchini/test_utils.h", "third_party/zucchini/chromium/components/zucchini/typed_value_unittest.cc", "third_party/zucchini/chromium/components/zucchini/zucchini_apply_unittest.cc", "third_party/zucchini/chromium/components/zucchini/zucchini_gen_unittest.cc", "third_party/zucchini/chromium/moz.yaml", "third_party/zucchini/executable/moz.build", "third_party/zucchini/moz.build", "third_party/zucchini/tests/gtest/moz.build", "third_party/zucchini/tests/gtest/testdata/chrome64_1.exe", "third_party/zucchini/tests/gtest/testdata/chrome64_2.exe", "third_party/zucchini/tests/gtest/testdata/setup1.exe", "third_party/zucchini/tests/gtest/testdata/setup2.exe"], "git_node": "1b4fb4c3af55b1c0a0a06ac537e83d8f78aa8628", "git_parents": ["988f8816adc08bd42ffdcd912a94c40eae38e751"], "node": "7f8bce65c4fea3005b690f46d26fffe562c7dc0a", "parents": ["f7610b4c389ee04ca2ec6c9ddfe792ee256d9297"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1987589 - Remove dependency on mincore.lib in zucchini.  a=diannaS\n\nWe remove the definition of LiveTicks::Now from time.cc. This removes\na dependency on mincore.lib through time_win.cc.\n\nWe consider linking with mincore.lib as potentially harmful for\nretrocompatibility after it caused bug 1983020 in firefox.exe,\neven though updater.exe was not affected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D264193\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272274\n", "files": ["third_party/zucchini/chromium-shim/patches/0013-Limit-dependencies-in-time.-cc-h-and-time_win.cc.patch", "third_party/zucchini/chromium/base/time/time.cc", "third_party/zucchini/chromium/bas