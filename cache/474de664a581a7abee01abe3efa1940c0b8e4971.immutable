, "date": 1764260972, "git_changesets": ["a28ec27f94448a5c6abb4cada4bd012ea4d94ad1"], "user": "dmeehan@mozilla.com"}, "370": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2001459 - Don't show reveal button if DisablePasswordReveal policy is set. r=mtigley a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D273648\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274168\n", "files": ["browser/components/aboutlogins/content/components/login-item.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_password_reveal.js"], "git_node": "9686783f1b0070f89d2dcbd187a45be8c5de2bf6", "git_parents": ["a28ec27f94448a5c6abb4cada4bd012ea4d94ad1"], "node": "86a5f2059e2fef9166df4c9b2696e6e523517dda", "parents": ["1e06db84027f43451e3714b8e08d4d357797de22"], "tags": []}], "date": 1764261011, "git_changesets": ["9686783f1b0070f89d2dcbd187a45be8c5de2bf6"], "user": "dmeehan@mozilla.com"}, "371": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966501 - Check fd is open before use (esr),  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274098\n", "files": ["netwerk/base/nsIUDPSocket.idl", "netwerk/base/nsUDPSocket.cpp", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/HttpConnectionUDP.cpp"], "git_node": "32eecc12a6998b218b124b88535a7974a31727df", "git_parents": ["9686783f1b0070f89d2dcbd187a45be8c5de2bf6"], "node": "fa253fdef6eef014da5e5d2b502adb012b58a573", "parents": ["86a5f2059e2fef9166df4c9b2696e6e523517dda"], "tags": []}], "date": 1764261155, "git_changesets": ["32eecc12a6998b218b124b88535a7974a31727df"], "user": "dmeehan@mozilla.com"}, "372": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274313\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "c6818796d7001db871854d95c46b273aee03ac1a", "git_parents": ["32eecc12a6998b218b124b88535a7974a31727df"], "node": "5e4fbe33ab484e7f2a2dcd10f97af0dfb0ac6176", "parents": ["fa253fdef6eef014da5e5d2b502adb012b58a573"], "tags": []}], "date": 1764261240, "git_changesets": ["c6818796d7001db871854d95c46b273aee03ac1a"], "user": "dmeehan@mozilla.com"}, "373": {"changesets": [{"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1997018 - [devtools] Stop escaping Unicode control (non-printable) characters with caret(^)  a=dmeehan\n\nEscaping control (mostly non-printable) charaters, means that only the caret(^) used for the escape will be\nincluded in the curl output and therefore the caret will be unexpectedly be escaping whatever character is after\nthe control character.\nThis patch stops escaping the unicode control characters.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D270661\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274178\n", "files": ["devtools/client/netmonitor/test/browser_net_curl-utils.js", "devtools/client/shared/curl.js"], "git_node": "14e726f69c86c58652294f21a756f75b4a872d7e", "git_parents": ["c6818796d7001db871854d95c46b273aee03ac1a"], "node": "0ddcaf2c22c1d7cc7ec1a334f8dda3230c8a1736", "parents": ["5e4fbe33ab484e7f2a2dcd10f97af0dfb0ac6176"], "tags": []}, {"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996761 - [devtools] Replace any other whitespace like characters with space  a=dmeehan\n\nCertain control characters (e.g tab or form feed) are whitespace like characters.\nThis replaces those with a simple space.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272425\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274179\n", "files": ["devtools/client/netmonitor/test/browser_net_curl-utils.js", "devtools/client/shared/curl.js"], "git_node": "a6f3bf0d1ba9b537e94e67d7d2ccf86b0bf95a1a", "git_parents": ["14e726f69c86c58652294f21a756f75b4a872d7e"], "node": "fa4c895cd0db7e1d77edcd1666ed1c2ef66e14f4", "parents": ["0ddcaf2c22c1d7cc7ec1a334f8dda3230c8a1736"], "tags": []}], "date": 1764264795, "git_changesets": ["14e726f69c86c58652294f21a756f75b4a872d7e", "a6f3bf0d1ba9b537e94e67d7d2ccf86b0bf95a1a"], "user": "dmeehan@mozilla.com"}, "374": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1997118 - Mark gray bits as invalid if we abort GC during marking (ESR140)  a=dmeehan\n\nWe depend on GC marking to propagate gray umarking through zones that are being\nmarked incrementally. Aborting this raises the possibility of creating black to\ngray edges as previously happened with this testcase.\n\nMarking the gray bits as invalid will cause the CC to perform another GC to\nredo the marking. Aborting GC is pretty rare in practice so I don't expect this\nto have a performance impact.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274432\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/GC.cpp", "js/src/gc/Marking.cpp", "js/src/jit-test/tests/gc/gray-unmarking.js", "xpcom/base/nsCycleCollector.cpp"], "git_node": "3521009ade948e3c4b495d0bf9b03110f1098b53", "git_parents": ["a6f3bf0d1ba9b537e94e67d7d2ccf86b0bf95a1a"], "node": "53c28fcd52f9f867b7779e3b8416fbc8cbdd4131", "parents": ["fa4c895cd0db7e1d77edcd1666ed1c2ef66e14f4"], "tags": []}], "date": 1764341887, "git_changesets": ["3521009ade948e3c4b495d0bf9b03110f1098b53"], "user": "dmeehan@mozilla.com"}, "375": {"changesets": [{"author": "Rong \"Mantle\" Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 1996840 - Part 1: (Drive-by) Append InstSize factor for secondaryVeneers. r=nbp a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270942\n", "files": ["js/src/jit/shared/IonAssemblerBufferWithConstantPools.h"], "git_node": "e265a5999bc751ea7e41f7f02f223974ae49a8c8", "git_parents": ["3521009ade948e3c4b495d0bf9b03110f1098b53"], "node": "082892bbde136e3eca5a96bc94bb265311bdac8f", "parents": ["53c28fcd52f9f867b7779e3b8416fbc8cbdd4131"], "tags": []}], "date": 1764342313, "git_changesets": ["e265a5999bc751ea7e41f7f02f223974ae49a8c8"], "user": "dmeehan@mozilla.com"}, "376": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 1997118 - Mark gray bits as invalid if we abort GC during marking (ESR140)  a=dmeehan\" for causing assertion failures\n\nThis reverts commit 3521009ade948e3c4b495d0bf9b03110f1098b53.\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/GC.cpp", "js/src/gc/Marking.cpp", "js/src/jit-test/tests/gc/gray-unmarking.js", "xpcom/base/nsCycleCollector.cpp"], "git_node": "7278acf042b4b1d0d02513a5a5ce9bc8838b2167", "git_parents": ["e265a5999bc751ea7e41f7f02f223974ae49a8c8"], "node": "4163953a96b2d016a952425fdaa6a07f952c5435", "parents": ["082892bbde136e3eca5a96bc94bb265311bdac8f"], "tags": []}], "date": 1764352282, "git_changesets": ["7278acf042b4b1d0d02513a5a5ce9bc8838b2167"], "user": "dmeehan@mozilla.com"}, "377": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274573\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/c