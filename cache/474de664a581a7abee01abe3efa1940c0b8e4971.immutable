f34dd2ba1", "3ee85ef933fd128e51bced771a096ac2f9b12948"], "user": "dsmith@mozilla.com"}, "354": {"changesets": [{"author": "Kai Engert \u003ckaie@kuix.de\u003e", "branch": "default", "desc": "Bug 1999107 - Uplift NSPR 4.36.2.  a=diannaS UPGRADE_NSPR_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272064\n", "files": ["nsprpub/TAG-INFO", "nsprpub/configure", "nsprpub/configure.in", "nsprpub/pr/include/prinit.h", "nsprpub/pr/src/misc/prtime.c", "nsprpub/pr/tests/parsetm.c", "nsprpub/pr/tests/vercheck.c"], "git_node": "5564ae2aa4683df540c2bc3294bd44f9779f067d", "git_parents": ["3ee85ef933fd128e51bced771a096ac2f9b12948"], "node": "2e714d39156026088d040664648105b92f20f12d", "parents": ["019319154723d1588fec503294d02cadc29f3fe7"], "tags": []}], "date": 1763604536, "git_changesets": ["5564ae2aa4683df540c2bc3294bd44f9779f067d"], "user": "dsmith@mozilla.com"}, "355": {"changesets": [{"author": "Rong \"Mantle\" Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 1997503 - [riscv64] Supply good tag shift to ExtractBits when unboxing for GC barrier. r=jandem, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D271395\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.h"], "git_node": "f299259c327babc83160f868af7e0e2cb70c0695", "git_parents": ["5564ae2aa4683df540c2bc3294bd44f9779f067d"], "node": "95cb9d8fdca039574d7d88cf72e2ba65113f66dd", "parents": ["2e714d39156026088d040664648105b92f20f12d"], "tags": []}], "date": 1763605099, "git_changesets": ["f299259c327babc83160f868af7e0e2cb70c0695"], "user": "dsmith@mozilla.com"}, "356": {"changesets": [{"author": "Pier Angelo Vendrame \u003cpierov@torproject.org\u003e", "branch": "default", "desc": "Bug 1998435 - Do not reset the default zoom when clearing the FFP state.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D271446\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273169\n", "files": ["browser/components/resistfingerprinting/test/browser/browser_bug1975753_site_specific_zoom_level.js", "toolkit/components/cleardata/ClearDataService.sys.mjs"], "git_node": "221062b2315d71bf38a3aa8e2fb59f9a119a45c4", "git_parents": ["f299259c327babc83160f868af7e0e2cb70c0695"], "node": "26755db4d7754d5142365d516122dab828db991d", "parents": ["95cb9d8fdca039574d7d88cf72e2ba65113f66dd"], "tags": []}], "date": 1763646534, "git_changesets": ["221062b2315d71bf38a3aa8e2fb59f9a119a45c4"], "user": "dsmith@mozilla.com"}, "357": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1978709 \u2013 Fix issue where load event might fire unexpectedly when loading a JavaScript URI;  a=diannaS DONTBUILD\n\nThe issue occurs when a JavaScript URI is being loaded while image loads are also\ntriggered at the same time. If images finish loading before the Javascript URI\ncompletes execution, e.g. requested images are avaiable in image cache or a\nsynchronous XHR is spining the event loop, the load event might be fired unexpectedly.\nThis is primarily because the Javascript URI loading is tracked as a state in DocLoader\nwhenever a Javascript URI load is triggered even if the load event should not fired.\nSo when image load complete, DocLoader erroneously determines to fire load event\ndue to document is in Javascript URI loading state.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D260780\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273104\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-iframe-element/iframe_javascript_url_form_submission.html", "testing/web-platform/tests/html/semantics/embedded-content/the-iframe-element/iframe_javascript_url_xhr.html", "testing/web-platform/tests/html/semantics/embedded-content/the-iframe-element/resources/javascript_url_form_submission.html", "uriloader/base/nsDocLoader.cpp", "uriloader/base/nsDocLoader.h"], "git_node": "6f96582d9b1b2cc91d7b5c09673036e9c31aefc9", "git_parents": ["221062b2315d71bf38a3aa8e2fb59f9a119a45c4"], "node": "d0de08d992b3e6a3fb22364ebda1036920e5c14f", "parents": ["26755db4d7754d5142365d516122dab828db991d"], "tags": []}], "date": 1763646745, "git_changesets": ["6f96582d9b1b2cc91d7b5c09673036e9c31aefc9"], "user": "dsmith@mozilla.com"}, "358": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273401\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "429e3b20f6375f5320abd632773289cd5b470185", "git_parents": ["6f96582d9b1b2cc91d7b5c09673036e9c31aefc9"], "node": "5466285c5e3fad31330c0c88e974adc444529bf4", "parents": ["d0de08d992b3e6a3fb22364ebda1036920e5c14f"], "tags": []}], "date": 1763647109, "git_changesets": ["429e3b20f6375f5320abd632773289cd5b470185"], "user": "dsmith@mozilla.com"}, "359": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1986922 - Block magicdsfilterQuest2.dll too.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D267880\n\nDifferential Revision: https://phabricator.services.mozilla.com/D271482\n", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": "a61fc9f82db0bc78a992fad419f210f6d1c2c1d5", "git_parents": ["429e3b20f6375f5320abd632773289cd5b470185"], "node": "82eb51d31818def55f8c090acdc531941e6a385c", "parents": ["5466285c5e3fad31330c0c88e974adc444529bf4"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1986922 - Block magicdsfilterQuestPro.dll too.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269805\n\nDifferential Revision: https://phabricator.services.mozilla.com/D271483\n", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": "6936e3b46c26bad443af9569d91fdf6cf15bd282", "git_parents": ["a61fc9f82db0bc78a992fad419f210f6d1c2c1d5"], "node": "dd08b1105b89d1abad37e6222a60a53f9f5947a3", "parents": ["82eb51d31818def55f8c090acdc531941e6a385c"], "tags": []}], "date": 1763701050, "git_changesets": ["a61fc9f82db0bc78a992fad419f210f6d1c2c1d5", "6936e3b46c26bad443af9569d91fdf6cf15bd282"], "user": "rvandermeulen@mozilla.com"}, "360": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1992288 - Make `AutoEditActionDataSetter` manage whether the destroyed editor was reinitialized  a=RyanVM\n\nOnce the editor is destroyed while dispatching `beforeinput` event,\ne.g., by a reframe of the text control frame, `AutoEditActionDataSetter`\nmarks \"the editor has destroyed during my lifetime\".  Then, nested\n`EditAction`s always fail because the parent `AutoEditActionDataSetter`\nthinks the editor is not available.\n\nHowever, the editor can be reinitialized immediately.  Then, the nested\n`EditAction`s should work (note that it does not mean that another user\ninput is handled, `AutoEditActionDataSetter` is used by some query\nmethods too). Therefore, this patch adds a new `bool` member to store\nwhether the editor is initialized again.\n\nI think we could reset `mEditorWasDestroyedDuringHandlingEditAction`,\nbut I'm afraid to do that because it forgets the destroyed thing\ncompletely and some features may need to abort handling something even\nif the editor is restored since the editable nodes are recreated.\nTherefore, this patch adds a new `bool` member for making this change\nsafer and anybody can access the details of the state.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D271559\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273165\n", "files": ["editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/TextEditor.cpp", "testing/web-platform/tests/editing/other/restyle-textcontrol-during-beforeinput.html"], "git_node": "e8ad94ab84c00567052d9c183ea3436ced38f3df", "git_parents": ["6936e3b46c26bad443af9569d91fdf6cf15bd282"], "node": "85c0ecb7431f841ea6e3c1e7f2072510270fc3f4", "parents": ["dd08b1105b89d1abad37e6222a60a53f9f5947a3"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1824143 - part 2: Make `TSFTextStore::FlushPendingActions()` set `mDeferNotifyingTSFUntilNextUpdate` before dispatching composition events  a=RyanVM\n\nThis fixes a regression of bug 1137561.  That made `TSFTextStore` stop\ndispatching composition events directly.  However, its dispatcher sets\n`mDeferNotifyingTSFUntilNextUpdate` to notify TSF of anything until\nit receives `NOTIFY_IME_OF_COMPOSITION_EVENT_HANDLED` since\n`GetTextExt()` etc will return error if the layout has not be updated.\nSo, we started return `E_FAIL` a lot from various `ITextStoreACP`\nmethods if TSF/TIP queries something immediately after updating\nthe composition.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D271560\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273166\n", "files": ["widget/windows/TSFTextStore.cpp", "widget/windows/TSFTextStoreBase.cpp"], "git_node": "9b09a62268306e94c85020626eca624345880dc8", "git_parents": ["e8ad94ab84c00567052d9c183ea3436ced38f3df"], "node": "d9f6b94f6d6911785299911811c335c7110118d7", "parents": ["85c0ecb7431f841ea6e3c1e7f2072510270fc3f4"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2000479 - Make `ContentCacheInParent::HandleQueryContentEvent` not stop handling the query when the offset is relative and there is selection  a=RyanVM\n\nThis is just the typo of the condition, but this have made a lot of\nqueries failed when there is no IME selections.  This could be one of\nthe cause of bug 1824143.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272821\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273167\n", "files": ["widget/ContentCache.cpp", "widget/tests/browser/browser_test_ContentCache.js"], "git_node": "b11b1742646329dc3a883e1cd2f483bcc1bb8638", "git_parents": ["9b09a62268306e94c85020626eca624345880dc8"], "node": "67e2d9596fdbe6f85d78dfe4a8c63c59d5890909", "parents": ["d9f6b94f6d6911785299911811c335c7110118d7"], "tags": []}], "date": 1763701291, "git_changesets": ["e8ad94ab84c00567052d9c183ea3436ced38f3df", "9b09a62268306e94c85020626eca624345880dc8", "b11b1742646329dc3a883e1cd2f483bcc1bb8638"], "user": "rvandermeulen@mozilla.com"}, "361": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1988313 - Add back the ability to remember the persistent storage permission decision. a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D267114\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273484\n", "files": ["browser/locales/en-US/browser/permissions.ftl", "browser/locales/l10n-changesets.json", "browser/modules/PermissionUI.sys.mjs"], "git_node": "ba1d416c76a65e9ff798cf50ca9bc4a79eb86071", "git_parents": ["b11b1742646329dc3a883e1cd2f483bcc1bb8638"], "node": "eec5be09f7191a02aef2e897e90c28d3c9f26117", "parents": ["67e2d9596fdbe6f85d78dfe4a8c63c59d5890909"], "tags": []}], "date": 1763701824, "git_changesets": ["ba1d416c76a65e9ff798cf50ca9bc4a79eb86071"], "user": "rvandermeulen@mozilla.com"}, "362": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996473. r=ahale a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270290\n", "files": ["dom/canvas/TexUnpackBlob.cpp"], "git_node": "ae6420afdc155d97080cafc2b7380bf26b81f55b", "git_parents": ["ba1d416c76a65e9ff798cf50ca9bc4a79eb86071"], "node": "15e7ddd342b1afd23964e55e8198a34e2d0c4678", "parents": ["eec5be09f7191a02aef2e897e90c28d3c9f26117"], "tags": []}], "date": 1763756807, "git_changesets": ["ae6420afdc155d97080cafc2b7380bf26b81f55b"], "user": "rvandermeulen@mozilla.com"}, "363": {"changesets": [{"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1992760: Clean this up, and mark a test as long.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D270706\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273453\n", "files": ["dom/media/webrtc/jsapi/RTCEncodedFrameBase.cpp", "dom/media/webrtc/jsapi/RTCEncodedFrameBase.h", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-sender-worker-single-frame.https.html"], "git_node": "22dbfbfd9e5938c1556c0e2bc91af77bbde0c4a0", "git_parents": ["ae6420afdc155d97080cafc2b7380bf26b81f55b"], "node": "fdfdd16c53af9bfe4d750a3dd5133378bf81353b", "parents": ["15e7ddd342b1afd23964e55e8198a34e2d0c4678"], "tags": []}], "date": 1763757645, "git_changesets": ["22dbfbfd9e5938c1556c0e2bc91af77bbde0c4a0"], "user": "rvandermeulen@mozilla.com"}, "364": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950282 - update our webcompat intervention for f1tv.formula1.com;  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273480\n", "files": ["browser/extensions/webcompat/data/interventions.json", "browser/extensions/webcompat/injections/js/bug1950282-f1tv.formula1.com-unblock-firefox.js", "browser/extensions/webcompat/manifest.json"], "git_node": "007cc675f5b294d0ad573ff8227fb95e14979c80", "git_parents": ["22dbfbfd9e5938c1556c0e2bc91af77bbde0c4a0"], "node": "5482ec9c77c399227babeeacc87e4c79aedf89bd", "paren