2", "git_parents": ["4a23cc529be2ce168e67149fb3fe4bbef253fa5c"], "node": "ffb62a617298b039db4d883472fd44505bf63b1f", "parents": ["c877a7e44dc1f84cedaeef0d335fee2fa5a1ffbe"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946753 - Vendor zucchini_commands.cc and dependencies.  a=diannaS\n\nThis patch vendors the files required to build zucchini_commands.cc,\nwhich is the final milestone before being able to define main().\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240050\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272265\n", "files": ["third_party/zucchini/chromium/base/command_line.cc", "third_party/zucchini/chromium/base/command_line.h", "third_party/zucchini/chromium/base/containers/contains.h", "third_party/zucchini/chromium/base/strings/string_split.h", "third_party/zucchini/chromium/base/strings/string_split_win.h", "third_party/zucchini/chromium/base/strings/string_tokenizer.h", "third_party/zucchini/chromium/components/zucchini/zucchini_commands.cc", "third_party/zucchini/chromium/components/zucchini/zucchini_commands.h", "third_party/zucchini/chromium/components/zucchini/zucchini_tools.cc", "third_party/zucchini/chromium/components/zucchini/zucchini_tools.h", "third_party/zucchini/chromium/moz.yaml", "third_party/zucchini/moz.build"], "git_node": "c6d783bfa02ff2cadded8cf200c075f257f1fb1c", "git_parents": ["1ece4411ed91037cd9d6681af76931dd4df62582"], "node": "67d5818cb0910e666d217ef1e9b76c75377fc7ea", "parents": ["ffb62a617298b039db4d883472fd44505bf63b1f"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946753 - Vendor zucchini_main.cc and dependencies.  a=diannaS\n\nThis patch vendors zucchini_main.cc, which defines main() to let us\nuse the zucchini binary.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240051\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272266\n", "files": ["third_party/zucchini/chromium-shim/components/zucchini/zucchini_main.temporary.cc", "third_party/zucchini/chromium-shim/patches/0012-Remove-debug-only-lock-implementation.patch", "third_party/zucchini/chromium-shim/patches/0013-Remove-definition-of-ThreadTicks-Now-from-time.cc.patch", "third_party/zucchini/chromium-shim/patches/0014-Neuter-chromium-logging-and-error-handling-in-zucchi.patch", "third_party/zucchini/chromium/base/bit_cast.h", "third_party/zucchini/chromium/base/cpu.cc", "third_party/zucchini/chromium/base/cpu.h", "third_party/zucchini/chromium/base/process/process_handle.h", "third_party/zucchini/chromium/base/synchronization/lock.h", "third_party/zucchini/chromium/base/synchronization/lock_impl_win.cc", "third_party/zucchini/chromium/base/third_party/nspr/LICENSE", "third_party/zucchini/chromium/base/third_party/nspr/prtime.cc", "third_party/zucchini/chromium/base/third_party/nspr/prtime.h", "third_party/zucchini/chromium/base/threading/platform_thread.h", "third_party/zucchini/chromium/base/time/time.cc", "third_party/zucchini/chromium/base/time/time_override.h", "third_party/zucchini/chromium/base/time/time_win.cc", "third_party/zucchini/chromium/components/zucchini/main_utils.cc", "third_party/zucchini/chromium/components/zucchini/main_utils.h", "third_party/zucchini/chromium/components/zucchini/zucchini_main.cc", "third_party/zucchini/chromium/moz.yaml", "third_party/zucchini/moz.build"], "git_node": "c162edc02797114a29fe825c7a6f4098f0357675", "git_parents": ["c6d783bfa02ff2cadded8cf200c075f257f1fb1c"], "node": "53d36d1987e36371a7b6289c8acc7492e730a41e", "parents": ["67d5818cb0910e666d217ef1e9b76c75377fc7ea"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950055 - Define base::FILEToFile in our zucchini vendoring.  a=diannaS\n\nWe deleted this function from file_util_win.cc, but it is actually required in\norder to interface properly with our updater code which relies on FILE.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253469\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272267\n", "files": ["third_party/zucchini/chromium-shim/patches/0006-Only-define-DeleteFile-from-file_util_win.cc.patch", "third_party/zucchini/chromium/base/files/file_util_win.cc"], "git_node": "be497f635be3f3eb1e6e3303b0a5ac0a398b4203", "git_parents": ["c162edc02797114a29fe825c7a6f4098f0357675"], "node": "a9836e5a0bf8ca0ba6264155b6f110e111bc3fc8", "parents": ["53d36d1987e36371a7b6289c8acc7492e730a41e"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950055 - Make MappedFileWriter usable without the DELETE access right in our zucchini vendoring.  a=diannaS\n\nThis is required for interfacing with our updater code, which creates files through the stdio abstractions and cannot have control over the access rights for the underlying handle.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253470\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272268\n", "files": ["third_party/zucchini/chromium-shim/patches/0015-Make-MappedFileWriter-usable-without-the-DELETE-acce.patch", "third_party/zucchini/chromium/components/zucchini/mapped_file.cc", "third_party/zucchini/chromium/components/zucchini/mapped_file.h"], "git_node": "e6059270935712ad1cc65345a14d385f94d89c11", "git_parents": ["be497f635be3f3eb1e6e3303b0a5ac0a398b4203"], "node": "9fae18375b59b4f43d3edba28a521f123efaf60e", "parents": ["a9836e5a0bf8ca0ba6264155b6f110e111bc3fc8"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950055 - Abstract over the binary diffing algorithm used by the updater.  a=diannaS\n\nupdater.cpp is currently very tied to bspatch, which we'd like to ultimately\nreplace by zucchini. This patch prepares the integration of zucchini by\nseparating the logic of applying a patch from the details of how patches are\nformatted and what binary diffing algorithm is used. We put these details\nbehind an abstract interface, which we implement for bspatch. In a follow-up\npatch, this allows us to integrate zucchini rather simply by implementing the\nsame abstract interface.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253471\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272269\n", "files": ["build/moz.configure/update-programs.configure", "toolkit/mozapps/update/updater/bspatch/bspatch.cpp", "toolkit/mozapps/update/updater/bspatch/bspatch.h", "toolkit/mozapps/update/updater/updater-common.build", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/toolkit.mozbuild"], "git_node": "eeb277c04b87dbf01b3f97c84afca94dd9a26ab7", "git_parents": ["e6059270935712ad1cc65345a14d385f94d89c11"], "node": "d2bd49762e4a677e7fac50fb3774e859244fc8e3", "parents": ["9fae18375b59b4f43d3edba28a521f123efaf60e"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950055 - Integrate zucchini into updater.cpp.  a=diannaS\n\nThis patch adds zucchini support to our updater by implementing the relevant\nabstract interface in updater.cpp and linking updater.exe with a new zucchini\nlibrary. This library contains the code shared by the updater and the zucchini\nexecutable. Code files that are irrelevant for the updater are directly\nintegrated into the zucchini executable (in particular, zucchini_gen.cc and its\ndependencies, which provide patch generation capabilities). To help implement\nthe abstract interface, we add helper functions in moz_zucchini.{cc,h}, with\ncode largely inspired by zucchini_integration.{cc,h} but that matches better\nwith the requirements from updater.cpp.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253472\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272270\n", "files": ["third_party/zucchini/chromium-shim/base/logging.cc", "third_party/zucchini/chromium-shim/patches/0016-Use-zucchini-status-Code-definition-from-moz_zucchin.patch", "third_party/zucchini/chromium/components/zucchini/zucchini.h", "third_party/zucchini/executable/moz.build", "third_party/zucchini/moz.build", "third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/updater/updater-common.build", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "36518ebc51e31df880dfc56d7b9c117a4dfc2321", "git_parents": ["eeb277c04b87dbf01b3f97c84afca94dd9a26ab7"], "node": "274078523c3662b125d8494be5ee975e3d4c22a1", "parents": ["d2bd49762e4a677e7fac50fb3774e859244fc8e3"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950060 - Add Linux and macOS support for zucchini.  a=diannaS\n\nThis patch adds the upstream definitions required to build and use\nzucchini on Linux and macOS platforms. We also remove zucchini support\nin mingwclang builds (32-bit and 64-bit) because of the lack of SEH\nsupport in the 32-bit compiler (bug 1975960).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253663\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272271\n", "files": ["browser/config/mozconfigs/win32/mingwclang", "browser/config/mozconfigs/win64/mingwclang", "build/moz.configure/update-programs.configure", "third_party/zucchini/chromium-shim/base/debug/debugging_buildflags.h", "third_party/zucchini/chromium-shim/base/logging.cc", "third_party/zucchini/chromium-shim/base/logging_buildflags.h", "third_party/zucchini/chromium-shim/base/synchronization/synchronization_buildflags.h", "third_party/zucchini/chromium-shim/base/time/buildflags/buildflags.h", "third_party/zucchini/chromium-shim/build/blink_buildflags.h", "third_party/zucchini/chromium-shim/build/chromecast_buildflags.h", "third_party/zucchini/chromium-shim/patches/0005-Only-define-IsUser32AndGdi32Available-from-win_util..patch", "third_party/zucchini/chromium-shim/patches/0006-Define-only-the-required-functions-from-file_util.h.patch", "third_party/zucchini/chromium-shim/patches/0006-Only-define-DeleteFile-from-file_util_win.cc.patch", "third_party/zucchini/chromium-shim/patches/0007-Only-define-SysInfo-VMAllocationGranularity-from-sys.patch", "third_party/zucchini/chromium-shim/patches/0009-Limit-dependencies-in-file_path.cc.patch", "third_party/zucchini/chromium-shim/patches/0013-Limit-dependencies-in-time.-cc-h-and-time_win.cc.patch", "third_party/zucchini/chromium-shim/patches/0013-Remove-definition-of-ThreadTicks-Now-from-time.cc.patch", "third_party/zucchini/chromium-shim/patches/0017-Neuter-file-descriptor-ownership-enforcement.patch", "third_party/zucchini/chromium-shim/patches/0018-Support-build-linux64-base-toolchains-clang-jobs.patch", "third_party/zucchini/chromium/base/allocator/partition_allocator/partition_alloc_base/compiler_specific.h", "third_party/zucchini/chromium/base/allocator/partition_allocator/partition_alloc_base/cxx20_is_constant_evaluated.h", "third_party/zucchini/chromium/base/allocator/partition_allocator/partition_alloc_base/thread_annotations.h", "third_party/zucchini/chromium/base/allocator/partition_allocator/partition_alloc_forward.h", "third_party/zucchini/chromium/base/bits.h", "third_party/zucchini/chromium/base/compiler_specific.h", "third_party/zucchini/chromium/base/cxx20_is_constant_evaluated.h", "third_party/zucchini/chromium/base/files/file_path.cc", "third_party/zucchini/chromium/base/files/file_path.h", "third_party/zucchini/chromium/base/files/file_posix.cc", "third_party/zucchini/chromium/base/files/file_util.cc", "third_party/zucchini/chromium/base/files/file_util_posix.cc", "third_party/zucchini/chromium/base/files/memory_mapped_file.cc", "third_party/zucchini/chromium/base/files/memory_mapped_file_posix.cc", "third_party/zucchini/chromium/base/files/scoped_file.cc", "third_party/zucchini/chromium/base/files/scoped_file_linux.cc", "thir