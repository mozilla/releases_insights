/zucchini/chromium/components/zucchini/version_info.h", "third_party/zucchini/chromium/components/zucchini/zucchini.h", "third_party/zucchini/chromium/components/zucchini/zucchini_apply.cc", "third_party/zucchini/chromium/components/zucchini/zucchini_apply.h", "third_party/zucchini/chromium/moz.yaml", "third_party/zucchini/moz.build"], "git_node": "804cd8e78f9ce390fb5d183f7fbc24d9c5d436f1", "git_parents": ["c9e66d4320cbd8fc93ddd869266aeb955158101e"], "node": "15cac8e3951cb810e94dd2058e5d28322fcbaa7d", "parents": ["145346ba702774772b08b641fe280638e64a899f"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946753 - Vendor zucchini_gen.cc and dependencies.  a=diannaS\n\nThis patch vendors the files required to build zucchini_gen.cc, which\nallows to generate a zucchini diff from memory buffers. It is useful to\nkeep this as a separate patch because these files will not have to be\nintegrated within the updater.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240048\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272263\n", "files": ["third_party/zucchini/chromium/components/zucchini/binary_data_histogram.cc", "third_party/zucchini/chromium/components/zucchini/binary_data_histogram.h", "third_party/zucchini/chromium/components/zucchini/ensemble_matcher.cc", "third_party/zucchini/chromium/components/zucchini/ensemble_matcher.h", "third_party/zucchini/chromium/components/zucchini/heuristic_ensemble_matcher.cc", "third_party/zucchini/chromium/components/zucchini/heuristic_ensemble_matcher.h", "third_party/zucchini/chromium/components/zucchini/imposed_ensemble_matcher.cc", "third_party/zucchini/chromium/components/zucchini/imposed_ensemble_matcher.h", "third_party/zucchini/chromium/components/zucchini/zucchini_gen.cc", "third_party/zucchini/chromium/components/zucchini/zucchini_gen.h", "third_party/zucchini/chromium/moz.yaml", "third_party/zucchini/moz.build"], "git_node": "4a23cc529be2ce168e67149fb3fe4bbef253fa5c", "git_parents": ["804cd8e78f9ce390fb5d183f7fbc24d9c5d436f1"], "node": "c877a7e44dc1f84cedaeef0d335fee2fa5a1ffbe", "parents": ["15cac8e3951cb810e94dd2058e5d28322fcbaa7d"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946753 - Vendor zucchini_integration.cc and dependencies.  a=diannaS\n\nThis patch vendors the files required to build zucchini_integration.cc,\nwhich allows to generate or apply a zucchini diff from/to files. It\nis a useful milestone for future integration into the updater,\nwhich will not need more code than this.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240049\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272264\n", "files": ["third_party/zucchini/chromium-shim/base/gtest_prod_util.h", "third_party/zucchini/chromium-shim/base/threading/scoped_blocking_call.h", "third_party/zucchini/chromium-shim/patches/0005-Only-define-IsUser32AndGdi32Available-from-win_util..patch", "third_party/zucchini/chromium-shim/patches/0006-Only-define-DeleteFile-from-file_util_win.cc.patch", "third_party/zucchini/chromium-shim/patches/0007-Only-define-SysInfo-VMAllocationGranularity-from-sys.patch", "third_party/zucchini/chromium-shim/patches/0008-Neuter-debug-only-CheckedScopedHandle-in-scoped_hand.patch", "third_party/zucchini/chromium-shim/patches/0009-Limit-dependencies-in-file_path.cc.patch", "third_party/zucchini/chromium-shim/patches/0010-Limit-dependencies-in-file.-cc-h-and-file_win.cc.patch", "third_party/zucchini/chromium-shim/patches/0011-Limit-dependencies-in-memory_mapped_file.-cc-h-and-m.patch", "third_party/zucchini/chromium/base/files/file.cc", "third_party/zucchini/chromium/base/files/file.h", "third_party/zucchini/chromium/base/files/file_path.cc", "third_party/zucchini/chromium/base/files/file_path.h", "third_party/zucchini/chromium/base/files/file_tracing.cc", "third_party/zucchini/chromium/base/files/fi