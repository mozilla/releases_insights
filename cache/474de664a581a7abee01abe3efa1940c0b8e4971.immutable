"0eed677e6113294c2f75680d0297f48c69d2104f"], "tags": []}], "date": 1763036324, "git_changesets": ["7ba5592e2ea49a56d585b548535e5f27637f8129"], "user": "dsmith@mozilla.com"}, "341": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1999551 - Part 1: Update the comment for js::LooselyEqual with TODOs.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272195\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272466\n", "files": ["js/src/vm/EqualityOperations.cpp"], "git_node": "357ecfe6bcdf5c8b531c63a64c39b353a274a5f9", "git_parents": ["7ba5592e2ea49a56d585b548535e5f27637f8129"], "node": "2127c374961f3da8dfdca40f3715194943194ebb", "parents": ["dc9cc9d4b4b71cc417ab5e36471cb877f489759a"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1999551 - Part 2: Update js::LooselyEqual.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272196\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272467\n", "files": ["js/src/vm/EqualityOperations.cpp"], "git_node": "a562134c2c75f51baa3c42ef1761aa32d169d11e", "git_parents": ["357ecfe6bcdf5c8b531c63a64c39b353a274a5f9"], "node": "9792521fa2baa903e8d2f1b743e50f96491aab8f", "parents": ["2127c374961f3da8dfdca40f3715194943194ebb"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1999551 - Part 3: Remove unused BigInt::looselyEqual.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272197\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272468\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "8f5c553e6522129d2f2f86bbae48c4f30c937b17", "git_parents": ["a562134c2c75f51baa3c42ef1761aa32d169d11e"], "node": "d5d1bb03833e237d9728ce3ca6f35e7d8f3a673d", "parents": ["9792521fa2baa903e8d2f1b743e50f96491aab8f"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1999551 - Part 4: Add tests.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272198\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272469\n", "files": ["js/src/jit-test/tests/bigint/loosely-equal.js"], "git_node": "0847d69503272a003d880f0523108f0a69e29076", "git_parents": ["8f5c553e6522129d2f2f86bbae48c4f30c937b17"], "node": "15aa5aca6c985d028f8ace1c4c236acdc3eac7c3", "parents": ["d5d1bb03833e237d9728ce3ca6f35e7d8f3a673d"], "tags": []}], "date": 1763085020, "git_changesets": ["357ecfe6bcdf5c8b531c63a64c39b353a274a5f9", "a562134c2c75f51baa3c42ef1761aa32d169d11e", "8f5c553e6522129d2f2f86bbae48c4f30c937b17", "0847d69503272a003d880f0523108f0a69e29076"], "user": "dsmith@mozilla.com"}, "342": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946753 - Initial vendoring of zucchini for Windows. r=sylvestre a=diannaS\n\nThis is the initial patch in the stack for vendoring a zucchini binary\nthat builds and runs on Windows. Updater integration and cross-platform\nsupport will come through a different stack of patches.\n\nThis initial patch only brings and use a single couple of files\n(crc32.{cc,h}) so as to keep the attention of reviewers focused on the\noverall structure of the vendoring.\n\nWe mimic the existing vendoring of the chromium sandbox under\n/security/sandbox:\n- We use a chromium/ directory with an individual-files-list moz.yaml\n  file to grab files that are either used as-is or with small changes.\n- We use a chromium-shim/ directory for files that provide our own\n  definitions when they completely differ from upstream.\n- Patches from upstream can be added to chromium-shim/patches/upstream\n  if required, currently we need none.\n- Our own patches to files that live in chromium/ can be added to\n  chromium-shim/patches.\n\nWe vendor at the parent of the first chromium commit that explicitly\nbroke C++17 compatibility for chromium/base/. We can consider\nchanging later when we support C++20.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240045\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272261\n", "files": ["build/moz.configure/update-programs.configure", "third_party/moz.build", "third_party/zucchini/chromium-shim/base/allocator/partition_allocator/partition_alloc_buildflags.h", "third_party/zucchini/chromium-shim/base/debug/debugging_buildflags.h", "third_party/zucchini/chromium-shim/base/logging.cc", "third_party/zucchini/chromium-shim/base/logging_buildflags.h", "third_party/zucchini/chromium-shim/base/tracing_buildflags.h", "third_party/zucchini/chromium-shim/base/values.h", "third_party/zucchini/chromium-shim/build/chromeos_buildflags.h", "third_party/zucchini/chromium-shim/components/zucchini/zucchini_main.temporary.cc", "third_party/zucchini/chromium-shim/patches/0001-Remove-dependency-on-double-conversion.patch", "third_party/zucchini/chromium-shim/patches/0002-Adjust-prefix-path-computations-for-base-Location.patch", "third_party/zucchini/chromium-shim/patches/0003-Limit-dependencies-in-check.cc.patch", "third_party/zucchini/chromium-shim/third_party/abseil-cpp/absl/types/optional.h", "third_party/zucchini/chromium/LICENSE", "third_party/zucchini/chromium/base/allocator/partition_allocator/partition_alloc_base/compiler_specific.h", "third_party/zucchini/chromium/base/allocator/partition_allocator/pointers/raw_ptr_exclusion.h", "third_party/zucchini/chromium/base/base_export.h", "third_party/zucchini/chromium/base/check.cc", "third_party/zucchini/chromium/base/check.h", "third_party/zucchini/chromium/base/check_op.cc", "third_party/zucchini/chromium/base/check_op.h", "third_party/zucchini/chromium/base/compiler_specific.h", "third_party/zucchini/chromium/base/containers/checked_iterators.h", "third_party/zucchini/chromium/base/containers/contiguous_iterator.h", "third_party/zu