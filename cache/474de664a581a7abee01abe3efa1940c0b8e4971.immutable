er/ImportMap.cpp"], "git_node": "fa437959dc97f1836224f45b3a1241a3e274113c", "git_parents": ["9fc332059eeff41cf07da9c2064fb0f00120e5c7"], "node": "57b884750afb398d8fe88d22b6e668ae38e94ef8", "parents": ["8c716f336ab598435b700e54fd4bc0509500d1e4"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1979050 - Part 2: test(ESR 140)  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272645\n", "files": ["dom/base/test/jsmodules/importmaps/chrome.toml", "dom/base/test/jsmodules/importmaps/module_1979050.mjs", "dom/base/test/jsmodules/importmaps/scope1/module_1979050.mjs", "dom/base/test/jsmodules/importmaps/scope1/scope2/module_1979050.mjs", "dom/base/test/jsmodules/importmaps/test_1979050.html", "dom/base/test/jsmodules/importmaps/test_1979050_2.html"], "git_node": "51c0ca876d94590055685b38997fc49f9d0082c9", "git_parents": ["fa437959dc97f1836224f45b3a1241a3e274113c"], "node": "ced3c0a7fbe53131666dea68f6499bb6475034dd", "parents": ["57b884750afb398d8fe88d22b6e668ae38e94ef8"], "tags": []}], "date": 1763316229, "git_changesets": ["fa437959dc97f1836224f45b3a1241a3e274113c", "51c0ca876d94590055685b38997fc49f9d0082c9"], "user": "dsmith@mozilla.com"}, "345": {"changesets": [{"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984458 - Make `UpdateService` check for persistent access failures  a=diannaS DONTBUILD\n\n`UpdateService` already handles most types of errors with retry and fallback logic, but cases where `update.status` is permanently not accessible can lead to updates being delayed indefinitely.\n\nThis change adds logic to check for this situation. The check increments a counter stored as a user pref when attempts to read/write `update.status` fails due to file access or locking. When the number of failures exceeds a configurable max and the `update.status` file's last modified time is greater than a maximum age, the user will be notified that there is something wrong with their installation, and they should manually reinstall.\n\nThis additionally propogates errors a bit further through the update system than they previously were. This has two purposes: (1) Allow us to notice when state writing fails so we can notify the user, and (2) allow AUS to notice the update failure so that it can react to it properly instead of continuing, often screwing up our attempts to show an update failed notification.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D247857\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272675\n", "files": ["toolkit/mozapps/update/UpdateService.sys.mjs", "toolkit/mozapps/update/metrics.yaml", "toolkit/mozapps/update/nsIUpdateService.idl"], "git_node": "e55d55e8189cfefa90a031436e7acf1287aac801", "git_parents": ["51c0ca876d94590055685b38997fc49f9d0082c9"], "node": "8382ee68b9520b237b7df794080c2efcb30c8af8", "parents": ["ced3c0a7fbe53131666dea68f6499bb6475034dd"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984458 - Add test utilities for `update.status` I/O failures  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D247858\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272676\n", "files": ["toolkit/mozapps/update/tests/moz.build", "toolkit/mozapps/update/tests/test_file_change_mtime.cpp", "toolkit/mozapps/update/tests/test_file_hold_open.cpp"], "git_node": "7af755fed0b252f660235a258915309cf8ff82e7", "git_parents": ["e55d55e8189cfefa90a031436e7acf1287aac801"], "node": "e8775352aa0915ad2008cab8ee14fd34b56a14f4", "parents": ["8382ee68b9520b237b7df794080c2efcb30c8af8"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984458 - Add tests that `UpdateService` notices when `update.status` is inaccessible  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D247859\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272677\n", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_aus_update/accessAndLockout.js", "toolkit/mozapps/update/tests/unit_aus_update/xpcshell.toml"], "git_node": "c7eba18e5a30b6df548d7020a245f9422b50b027", "git_parents": ["7af755fed0b252f660235a258915309cf8ff82e7"], "node": "74a69050c35ad7b856ebef6334c0f9db0798d8fc", "parents": ["e8775352aa0915ad2008cab8ee14fd34b56a14f4"], "tags": []}], "date": 1763410586, "git_changesets": ["e55d55e8189cfefa90a031436e7acf1287aac801", "7af755fed0b252f660235a258915309cf8ff82e7", "c7eba18e5a30b6df548d7020a245f9422b50b027"], "user": "dsmith@mozilla.com"}, "346": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1999689 - Serialize access to the crash helper client  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272251\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272837\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "5cf79830c2aad8d461db0c3da93adee53db66527", "git_parents": ["c7eba18e5a30b6df548d7020a245f9422b50b027"], "node": "b1cd6f1a0c1bc89fb71179181bc7da9b1757583c", "parents": ["74a69050c35ad7b856ebef6334c0f9db0798d8fc"], "tags": []}], "date": 1763412462, "git_changesets": ["5cf79830c2aad8d461db0c3da93adee53db66527"], "user": "dsmith@mozilla.com"}, "347": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272860\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/setting