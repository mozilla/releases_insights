ini/chromium/components/zucchini/main_utils.cc", "third_party/zucchini/chromium/components/zucchini/patch_reader.cc", "third_party/zucchini/chromium/moz.yaml", "third_party/zucchini/executable/moz.build", "third_party/zucchini/moz.build"], "git_node": "17ceb7f47d4b101ccf4880aebcfc04239d95ffae", "git_parents": ["36518ebc51e31df880dfc56d7b9c117a4dfc2321"], "node": "1b6830ff11bc5e99b99693ea611cda1d11895c06", "parents": ["274078523c3662b125d8494be5ee975e3d4c22a1"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950060 - Enable zucchini support in the updater.  a=diannaS\n\nThis patch makes our updater support zucchini patches if present in a\nmar file. This does not mean that we need to start shipping zucchini\npatches right now. bspatch support is preserved and the updater is able\nto consume both kinds of patches.\n\nThis will let us benchmark zucchini patch application in updater.exe,\nand experiment with zucchini rollouts that target a small portion of the\npopulation so we can catch any issue ahead of a global rollout.\n\nThis patch also adds the zucchini equivalents for our tests that use a\nbspatch-based mar.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253687\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272272\n", "files": ["build/moz.configure/update-programs.configure", "toolkit/mozapps/update/tests/data/README.md", "toolkit/mozapps/update/tests/data/partial_zucchini.mar", "toolkit/mozapps/update/tests/data/partial_zucchini_mac.mar", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/moz.build", "toolkit/mozapps/update/tests/unit_update_binary/marCallbackAppStageSuccessPartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marCallbackAppSuccessPartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchini.js", "toolkit/mozapps/update/tests/unit_update_binary/marFileInUseStageFailurePartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFileInUseSuccessPartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFileLockedFailurePartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFileLockedStageFailurePartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marRMRFDirFileInUseStageFailurePartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marRMRFDirFileInUseSuccessPartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marStageFailurePartialZucchini.js", "toolkit/mozapps/update/tests/unit_update_binary/marStageSuccessPartialZucchini.js", "toolkit/mozapps/update/tests/unit_update_binary/marSuccessPartialZucchini.js", "toolkit/mozapps/update/tests/unit_update_binary/marSuccessPartialZucchiniWhileBackgroundTaskRunning.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_service.toml"], "git_node": "988f8816adc08bd42ffdcd912a94c40eae38e751", "git_parents": ["17ceb7f47d4b101ccf4880aebcfc04239d95ffae"], "node": "f7610b4c389ee04ca2ec6c9ddfe792ee256d9297", "parents": ["1b6830ff11bc5e99b99693ea611cda1d11895c06"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950064 - Build zucchini-gtest to run upstream tests locally.  a=diannaS\n\nThis patch builds a dedicated zucchini-gtest program that can be used\nto run the Zucchini upstream tests locally by running the binary after\n./mach build. We do not (yet) automatically run these tests on CI, which\nis left as future work.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256004\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272273\n", "files": ["third_party/zucchini/chromium-shim/base/gtest_prod_util.h", "third_party/zucchini/chromium-shim/build/branding_buildflags.h", "third_party/zucchini/chr