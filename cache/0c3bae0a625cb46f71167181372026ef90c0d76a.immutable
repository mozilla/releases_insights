a7046dcbc324ae132f8516f6001b81", "git_parents": ["f09cc8bec51a2927d931d57aa2f4150ee6e0d41c"], "node": "c1faa7fbb392a888b0ff0357cafb4fde88696b49", "parents": ["712d5511d712c679313406a467535da0078c9656"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070089 - Run hazard tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324211\n", "files": ["taskcluster/kinds/hazard/kind.yml"], "git_node": "e0a301798d0917d4aecbb0834e4535e1f3629b21", "git_parents": ["5c95722b8ea7046dcbc324ae132f8516f6001b81"], "node": "f85494e1483cd5d14b2cdd235ace293d27c27aad", "parents": ["c1faa7fbb392a888b0ff0357cafb4fde88696b49"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056841: Validate OriginInfo after lock reacquisition. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323652\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CanonicalQuotaObject.cpp", "dom/quota/DirtyTrackingAutoLock.cpp", "dom/quota/OriginInfo.cpp"], "git_node": "c2568070ec3ebe0729d1ff699abe161d7fc8a8c8", "git_parents": ["e0a301798d0917d4aecbb0834e4535e1f3629b21"], "node": "de2841b02847d87acd82855563eecc003499e565", "parents": ["f85494e1483cd5d14b2cdd235ace293d27c27aad"], "tags": []}, {"author": "mimi \u003cmjung@mozilla.com\u003e", "branch": "default", "desc": "Bug 1901533 - Moves Refresh Firefox Infobar into Messaging System r=firefox-desktop-core-reviewers ,fluent-reviewers,omc-reviewers,bolsson,mossop,sachung\n\nScope of this patch is to pull the refresh (unused and reinstall) firefox infobar into messaging system.\n\nThe infobars are now idle dispatched through the defaultBrowserCheck trigger (previously `onFirstWindowLoaded`), and will respect [activeNotifications](https://searchfox.org/firefox-main/source/browser/components/asrouter/modules/ASRouterTargeting.sys.mjs#1125)\n\n See screenshots below:\n\n{F79391908}\n\n{F79391907}\n\n{F79391906}\n\n[try run](https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=88932)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323372\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/ReinstallCheck.sys.mjs", "browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js", "browser/components/moz.build", "browser/locales/en-US/browser/newtab/asrouter.ftl", "python/l10n/fluent_migrations/bug_1901533_refresh_unused_profile_infobar.py", "toolkit/components/messaging-system/lib/MessagingSystemBlocklists.sys.mjs", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_reset_profile.js", "toolkit/locales/en-US/chrome/global/resetProfile.properties", "toolkit/locales/jar.mn"], "git_node": "68b523fa016016ce99ee85f05b8ccf9b5a078444", "git_parents": ["c2568070ec3ebe0729d1ff699abe161d7fc8a8c8"], "node": "17aca97a343312a2a470ba81927bc2cf01734ce7", "parents": ["de2841b02847d87acd82855563eecc003499e565"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013288 - Run the jetstream3 benchmark on Android emulators. r=perftest-reviewers,kshampur\n\nAdd browsertime-benchmark-jetstream3 to the android-em-14-arm64 test set at tier 3, and schedule it on autoland for fenix, matching what speedometer3\nalready does on that platform. Jetstream3 produces many more alerts than speedometer3(none since we landed the sp3 emulator change) so it makes sense\nto use this benchmark in addition to sp3 because of its ability to show long term trends for alerting.\n\nAlso raise that emulator's RAM from 3GB to 6GB, which was the culprit behind the jetstream3 job permafailing previously.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324733\n", "files": ["taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "testing/mozharness/configs/raptor/android_emulator_macosx_config.py", "testing/perfdocs/generated/raptor.md"], "git_node": "4147bd5b01bd532d5084858b2f9579c06c9836a9", "git_parents": ["68b523fa016016ce99ee85f05b8ccf9b5a078444"], "node": "bdafb88f764be4ad0a8aa8c4aab52354e0bacb6e", "parents": ["17aca97a343312a2a470ba81927bc2cf01734ce7"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029292: Add test r=nbp\n\nDifferential Revision: https://phabricator.services.mozilla.com/D293197\n", "files": ["js/src/jit-test/tests/debug/bug2029292.js"], "git_node": "ae0ce0bafce00afd6315633ec88c951217064763", "git_parents": ["4147bd5b01bd532d5084858b2f9579c06c9836a9"], "node": "76274f190c963d5e64a4b1636c6f248689cf6b12", "parents": ["bdafb88f764be4ad0a8aa8c4aab52354e0bacb6e"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029806: Add test r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294529\n", "files": ["js/src/jit-test/tests/regexp/bug2029806.js"], "git_node": "a4892dedaf66e5281f7c22bddf04876332e54a1d", "git_parents": ["ae0ce0bafce00afd6315633ec88c951217064763"], "node": "e13c8af91b1a59f947fee7ceea0d434683f5591c", "parents": ["76274f190c963d5e64a4b1636c6f248689cf6b12"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034837: Add testcase r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297076\n", "files": ["js/src/jit-test/tests/ion/bug2034837.js"], "git_node": "f76268fec3bf5427cbab487b35e3e90c7e06f547", "git_parents": ["a4892dedaf66e5281f7c22bddf04876332e54a1d"], "node": "f412460fc241d33a728bf944ea1a88534a61ccb3", "parents": ["e13c8af91b1a59f947fee7ceea0d434683f5591c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036256: Add test r=jonco\n\nI'm not sure how bad the bug is, so I'm putting the test in a separate patch just in case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297931\n", "files": ["js/src/jit-test/tests/gc/bug2036256.js"], "git_node": "1d36b3661a354e70694496af743abc11d185078e", "git_parents": ["f76268fec3bf5427cbab487b35e3e90c7e06f547"], "node": "f2f190de32c31a6d09cbc4b1d2df374980b66875", "parents": ["f412460fc241d33a728bf944ea1a88534a61ccb3"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040903: Add test and comment r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301606\n", "files": ["js/src/jit-test/tests/ion/bug2040903.js"], "git_node": "fa0902b674102c307998a242a603255b56e94d55", "git_parents": ["1d36b3661a354e70694496af743abc11d185078e"], "node": "4e99ef739a39130cc4436eda85405eaf4738ab10", "parents": ["f2f190de32c31a6d09cbc4b1d2df374980b66875"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069719 - Update irregexp to 9f30cc5fc4ad6c3236c522fd23224ddc94591a20 r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323909\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-compiler-tonode.cc", "js/src/irregexp/imported/regexp-compiler.cc", "js/src/irregexp/imported/regexp-compiler.h", "js/src/irregexp/imported/regexp-dotprinter.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-macro-assembler.h", "js/src/irregexp/imported/regexp-node-printer.cc", "js/src/irregexp/imported/regexp-nodes.h", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/moz.yaml"], "git_node": "02fee9a00c60ca16941bea43bbdfca4b940db7e2", "git_parents": ["fa0902b674102c307998a242a603255b56e94d55"], "node": "7de2d46d6a90564a30ccb6bcef70129d0347dd8b", "parents": ["4e99ef739a39130cc4436eda85405eaf4738ab10"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069719 - Apply mozilla patches for irregexp r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323910\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h"], "git_node": "4b41f47b64cbc884e65d96790e7db7c2f36774ae", "git_parents": ["02fee9a00c60ca16941bea43bbdfca4b940db7e2"], "node": "2ea930f695a9413acb5c9f81175b2d79fc4560e0", "parents": ["7de2d46d6a90564a30ccb6bcef70129d0347dd8b"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069719: Remove unneeded argument from AnalyzeRegExp r=dminor\n\nIrregexp now stores flags inside nodes (to improve handling of regexp flag modifiers), so AnalyzeRegExp no longer needs the flags to be passed in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324803\n", "files": ["js/src/irregexp/RegExpAPI.cpp"], "git_node": "f40315eaf2908e46858a4c683d5cdaac1dce0579", "git_parents": ["4b41f47b64cbc884e65d96790e7db7c2f36774ae"], "node": "47bd6b242d48a8bf6fb117b32b76d2219270de1f", "parents": ["2ea930f695a9413acb5c9f81175b2d79fc4560e0"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069719: Remove dead JitOptions r=dminor\n\nRegexp modifiers and named capture groups were shipped ~2 years ago. V8 removed the flag in irregexp to disable them, so these JitOptions no longer do anything.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324804\n", "files": ["js/src/jit/JitOptions.cpp", "js/src/jit/JitOptions.h"], "git_node": "7d09e5a84803feed1c77936f34b1c8f764cb5b5c", "git_parents": ["f40315eaf2908e46858a4c683d5cdaac1dce0579"], "node": "9b1d5ec22f14fff4596e34e2bacaeacb648dbcd6", "parents": ["47bd6b242d48a8bf6fb117b32b76d2219270de1f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070649: Report OOM size in irregexp::Zone r=dminor\n\nAutoEnterOOMUnsafeRegion::crash has an overload that annotates the crash with information about the size of the allocation, but it's been broken for a while. Fix it and use it here.\n\nDrive-by: rewrite some math to be more careful about overflow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324766\n", "files": ["js/public/Utility.h", "js/src/irregexp/util/VectorShim.h", "js/src/irregexp/util/ZoneShim.h"], "git_node": "352674da24c5dfa84e7aa2755395154c582940cb", "git_parents": ["7d09e5a84803feed1c77936f34b1c8f764cb5b5c"], "node": "de31a3c9e8eee01f339781ea346586a2086493f9", "parents": ["9b1d5ec22f14fff4596e34e2bacaeacb648dbcd6"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067435 - use outline to increase audio overlay icon size for collapsed and pinned tabs r=desktop-theme-reviewers,tabbrowser-reviewers,sthompson,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323374\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "1dd26280cb972f89d547601f595c4b1429a5f690", "git_parents": ["352674da24c5dfa84e7aa2755395154c582940cb"], "node": "8a9ececd49e3c9d0d5ddf8201ac56722ea4c0c50", "parents": ["de31a3c9e8eee01f339781ea346586a2086493f9"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064511: Don't reuse a device record from a replaced session  r=markh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319657\n", "files": ["services/fxaccounts/FxAccountsClient.sys.mjs", "services/fxaccounts/FxAccountsDevice.sys.mjs", "services/fxaccounts/FxAccountsWebChannel.sys.mjs", "services/fxaccounts/tests/xpcshell/test_accounts_device_registration.js", "services/fxaccounts/tests/xpcshell/test_client.js", "services/fxaccounts/tests/xpcshell/test_web_channel.js"], "git_node": "d784e578ebbbd9625e4e18810c20150fa8c247cb", "git_parents": ["1dd26280cb972f89d547601f595c4b1429a5f690"], "node": "812bf21e62b9f78ec3da185a22995b0435c8f66b", "parents": ["8a9ececd49e3c9d0d5ddf8201ac56722ea4c0c50"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070481 - Don't apply the snap outset to an outset box-shadow's ClipOut r=gfx-reviewers,nical\n\nBug 2052033 passed the spread as the clip snap outset on both zero-blur\nbox-shadow arms. Only inset needs it, where the ClipOut is the element\ndeflated by the spread. An outset shadow's ClipOut is already the element,\nand anchoring it to snap(element.inflate(spread)) inset by the spread\ndiffers from snap(element) whenever spread * device_scale is fractional,\nso a border or background the element paints in the same colour no longer\nmeets the shadow and a partial-coverage seam flickers as the element moves.\n\nThe reftest fills the element in the shadow colour so the correct result is\nthe snapped shadow rect, solid. It uses spread 10.5 at scale 1, and no\nscale(*), because an integral spread * scale is the one case the bug cannot\nshow in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324811\n", "files": ["gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/reftests/boxshadow/outset-abutting-fill-snap-ref.yaml", "gfx/wr/wrench/reftests/boxshadow/outset-abutting-fill-snap.yaml", "gfx/wr/wrench/reftests/boxshadow/reftest.list"], "git_node": "0c87244bf99f0ff363d2130efa2cbf55c5643c3f", "git_parents": ["d784e578ebbbd9625e4e18810c20150fa8c247cb"], "node": "18861801d88ec980dd7f556d377bb000496df6dd", "parents": ["812bf21e62b9f78ec3da185a22995b0435c8f66b"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070369:  Fix crash when bookmark snackbar is shown and the fragment is destroyed r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324475\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/TabManagementFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/TabManagementFragmentTest.kt"], "git_node": "0f45b0743e6fac4c3403c4deb80688e070fc0bcd", "git_parents": ["0c87244bf99f0ff363d2130efa2cbf55c5643c3f"], "node": "10c9451548e5e5c1ed797c7d819e3d7657726182", "parents": ["18861801d88ec980dd7f556d377bb000496df6dd"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2036256: Add test r=jonco\" for causing sm bustages in bug2036256.js.\n\nThis reverts commit 1d36b3661a354e70694496af743abc11d185078e.\n", "files": ["js/src/jit-test/tests/gc/bug2036256.js"], "git_node": "3b1a6fe2d5fe57ec47c7d6394d371515db237532", "git_parents": ["0f45b0743e6fac4c3403c4deb80688e070fc0bcd"], "node": "a3952b8fada054c256841e87211b503fa8e03453", "parents": ["10c9451548e5e5c1ed797c7d819e3d7657726182"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070294 - Fix newtab context menu button colors r=desktop-theme-reviewers,tgiles,thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324732\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "3b9b8ba74d62827248b1ea72418a682425736519", "git_parents": ["3b1a6fe2d5fe57ec47c7d6394d371515db237532"], "node": "ff2174320c83bf621b942e3369f3036d315a9776", "parents": ["a3952b8fada054c256841e87211b503fa8e03453"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050542. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325138\n", "files": ["widget/windows/RemoteBackbuffer.cpp"], "git_node": "06bed2fc72565579ae6e0da815d727383feb3661", "git_parents": ["3b9b8ba74d62827248b1ea72418a682425736519"], "node": "d02b834bb657c2eb8aa622f5c1f3a69151904d7e", "parents": ["ff2174320c83bf621b942e3369f3036d315a9776"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2065681, part 1 - Clean up the return value of SpecialPowers.swapFactoryRegistration. r=jgraham\n\nThis only ever returns an object with an originalCID field, so just return the value\nand get rid of the unnecessary error handling code in MockObjectRegisterer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320607\n", "files": ["testing/mochitest/tests/SimpleTest/MockObjects.js", "testing/specialpowers/content/SpecialPowersChild.sys.mjs"], "git_node": "ea5dc5d55360221a4735a457f6621a375ee75af0", "git_parents": ["06bed2fc72565579ae6e0da815d727383feb3661"], "node": "ec385592d79fbdab61342951fb6301f00ada089a", "parents": ["d02b834bb657c2eb8aa622f5c1f3a69151904d7e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2065681, part 2 - Copy swapFactoryRegistration into two identical versions. r=jgraham\n\nswapFactoryRegistration is only called by MockObjectRegisterer, in two places.\nWhen we're initially registering the factory, cid is null and newFactory is\nnon-null. When we're unregistering the factory, cid is non-null and newFactory\nis null.\n\nAs a first step towards simplifying this method, in this patch I change\nswapFactoryRegistration into two identical methods, registerFactory\nand unregisterFactory, to cover these two roles. Later patches will\ncarry out simplifications, but splitting out this intermediate patch\nmakes it easier to see what actually changed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321536\n", "files": ["testing/mochitest/tests/SimpleTest/MockObjects.js", "testing/specialpowers/content/SpecialPowersChild.sys.mjs"], "git_node": "67ed7eef166a32ae7133da14e1af6c642825eaa0", "git_parents": ["ea5dc5d55360221a4735a457f6621a375ee75af0"], "node": "526c0e86e2fc8fdb60fb7283bf41d2c857a48403", "parents": ["ec385592d79fbdab61342951fb6301f00ada089a"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2065681, part 3 - Specialize the two swapFactoryRegistration methods. r=jgraham\n\nIn this patch, I carry out the simplification enabled by the previous patch.\n\nregisterFactory\n* The first argument is always null, so drop it and simplify the code.\n* currentFactory is now dead so remove it.\n* Remove a comment that no longer applies.\n\nunregisterFactory\n* cid is always non-null. I added a null check for cid, but this is mostly for\ndocumentation purposes, because its caller has already done the same check.\n* The only caller only passes in two arguments, so newFactory will always be\nundefined. Replace it with null in the place that it is used.\n* The caller does not use the return value, so don't bother with it.\n\nI think the split version is easier to understand, and it enables a further\nsimplification in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320608\n", "files": ["testing/mochitest/tests/SimpleTest/MockObjects.js", "testing/specialpowers/content/SpecialPowersChild.sys.mjs"], "git_node": "7b2d95ca1f967eef4fb58ebd478a9ebae30f726d", "git_parents": ["67ed7eef166a32ae7133da14e1af6c642825eaa0"], "node": "5e826f2deae376729d28b16bd376e93c74230ad1", "parents": ["526c0e86e2fc8fdb60fb7283bf41d2c857a48403"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2065681, part 4 - Remove getClassObject call from unregisterFactory. r=jgraham\n\ngetClassObject is used in unregisterFactory to determine what the current\nfactory is so that we can unregister it, but the only caller is already\ntracking it, so pass it in rather than recomputing it.\n\ngetClassObject is an odd API I am trying to eliminate, and this is really\nmy entire goal of this patch series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320609\n", "files": ["testing/mochitest/tests/SimpleTest/MockObjects.js", "testing/specialpowers/content/SpecialPowersChild.sys.mjs"], "git_node": "402b792817f41067bcf741e3ae8a2531bed68dd7", "git_parents": ["7b2d95ca1f967eef4fb58ebd478a9ebae30f726d"], "node": "65ffaa81cf50afe3deff0c5b36e3b78fd0ad3322", "parents": ["5e826f2deae376729d28b16bd376e93c74230ad1"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068585 - Get rid of collections.OrderedDict r=perftest-reviewers,aglavic\n\ndict is ordered since 3.6\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322953\n", "files": ["testing/talos/talos/mainthreadio.py", "testing/talos/talos/scripts/report.py"], "git_node": "4af46aa0f88f1c5384dbece9d0668f8d808f6f09", "git_parents": ["402b792817f41067bcf741e3ae8a2531bed68dd7"], "node": "86a90b5fd824755d3467ffaa6ae8d08709216796", "parents": ["65ffaa81cf50afe3deff0c5b36e3b78fd0ad3322"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068585 - Get rid of collections.OrderedDict r=ahochheiden\n\ndict is ordered since 3.6\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322954\n", "files": ["testing/mozbase/mozlog/mozlog/handlers/summaryhandler.py", "testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py"], "git_node": "34e7634b358da24afae767c4a03828520b948ca6", "git_parents": ["4af46aa0f88f1c5384dbece9d0668f8d808f6f09"], "node": "06a72c2a7d09acbc4d57a32c7c38aae1dd5255fb", "parents": ["86a90b5fd824755d3467ffaa6ae8d08709216796"], "tags": []}, {"author": "ahanot \u003cahanot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070627 - Fix the New Tab ads-client path serving MARS and cached ads. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324709\n", "files": ["browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/unit/lib/DiscoveryStreamFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "90231dc473777927d52f8baed51f76a1ce7a05e9", "git_parents": ["34e7634b358da24afae767c4a03828520b948ca6"], "node": "76927e0e84e5aab0225988d7aa233260dc175b23", "parents": ["06a72c2a7d09acbc4d57a32c7c38aae1dd5255fb"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070753 - Put the host's tokens first in the search CTA's derived query - r=mconley\n\nThe `dnsNotFound` Search CTA built its query as the path's keywords followed by the host's, so the site the user was trying to reach trailed the query. We want to lead with the host's tokens instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324814\n", "files": ["browser/base/content/test/about/browser_aboutNetError_searchCTA_derivation.js", "toolkit/locales/en-US/toolkit/neterror/netError.ftl", "toolkit/modules/URLKeywordAnalyzer.sys.mjs", "toolkit/modules/tests/xpcshell/test_URLKeywordAnalyzer.js"], "git_node": "7ebc77de377cac4423ce29ddae0bc41c7245cc62", "git_parents": ["90231dc473777927d52f8baed51f76a1ce7a05e9"], "node": "90c953760965175776e9095938693b2585cd236f", "parents": ["76927e0e84e5aab0225988d7aa233260dc175b23"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057607 - Update checklist divider color for Nova r=omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322652\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_feature-callout.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "2673979a6c523ed1f2c57c9901a551d0182e1e54", "git_parents": ["7ebc77de377cac4423ce29ddae0bc41c7245cc62"], "node": "aa082cd9851df2fedee44809c45fc23f9b9a5d71", "parents": ["90c953760965175776e9095938693b2585cd236f"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064864 - added datastore for l2p persistence r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324443\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/listentopage/build.gradle", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/settings/ListenSettings.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SpeechSynthesizer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/settings/ListenSettingsTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPage.kt"], "git_node": "03d130d6c0422450a193dc91f2db3fe998f79aa6", "git_parents": ["2673979a6c523ed1f2c57c9901a551d0182e1e54"], "node": "2d0467696b3bf460f0e473c39f3e7c89976d3b21", "parents": ["aa082cd9851df2fedee44809c45fc23f9b9a5d71"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070652 - Record Glean events for the Smart Window Firefox Accounts sign-in flow r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324742\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/AIWindowAccountAuth.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_account_auth.js"], "git_node": "4c840bbcfc2eada85545708ace72dedae3e78d6c", "git_parents": ["03d130d6c0422450a193dc91f2db3fe998f79aa6"], "node": "c49f35e9d0953a76a0c61ab5441796d518a79b93", "parents": ["2d0467696b3bf460f0e473c39f3e7c89976d3b21"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2066063 - [devtools] Ignore local mode request with custom ports. r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324079\n", "files": ["devtools/shared/network-observer/NetworkObserver.sys.mjs", "devtools/shared/network-observer/test/browser/browser_networkobserver_localMode.js"], "git_node": "2d7e2b58b1079f732b62abef79efb340e1a1a0ef", "git_parents": ["4c840bbcfc2eada85545708ace72dedae3e78d6c"], "node": "18477ca4be205dfdc7c2d0b9a1876bc341963ae2", "parents": ["c49f35e9d0953a76a0c61ab5441796d518a79b93"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2066063 - [devtools] Redirect invalid path to 404 for local mode requests. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324080\n", "files": ["devtools/shared/network-observer/NetworkLocalMode.sys.mjs", "devtools/shared/network-observer/test/browser/browser_networkobserver_localMode.js"], "git_node": "d27eb6ae9969cfea9e362f0b07b7958348508785", "git_parents": ["2d7e2b58b1079f732b62abef79efb340e1a1a0ef"], "node": "aa27ed7e919fdd2cd6125ae6c8ebd68588793a1e", "parents": ["18477ca4be205dfdc7c2d0b9a1876bc341963ae2"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2065291 - Never createInstance in MockRegistrar. r=extension-reviewers,kpatenio,chutten,robwu,hiro\n\nThe shouldCreateInstance option for MockRegistrar, which is true by default,\nmakes it so that every time you call createInstance on the mock component it\ncalls createInstance on the real component, and sticks the real instance on\na property _genuine. This can be used for things like forwarding calls you\ndon't want to change to the real component.\n\nUnfortunately, in order to support the full generality of MockRegistrar, this\nis implemented in terms of a low-level XPCOM component manager feature called\ngetClassObject, which gets a handle to the underlying factory. I am trying to\nget rid of it.\n\nHowever, this feature is only used in two specific places, in FakeCertDB and\nin telemetry. Both of them only forward a few property lookups to the real\ncomponent, and the actual real component doesn't seem to change, so we can\nmanually snapshot it when we create the mock component and then remove this\nfeature from MockRegistrar entirely.\n\nRemoving this option means that there are no options, so I merged registerEx\ninto register.\n\nAnother non-obvious thing is that there's a try-catch around the starting part\nof the function where we check for an existing component. I found at least one\ntest, browser_downloads_taskbar.js, that relies on this. It registers a mock\ncomponent for some OS-specific things, across every OS, so we need to be able to\nhandle this gracefully. Now that this can only fail in one place, I tightened\nup the try-catch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320276\n", "files": ["browser/components/backup/tests/xpcshell/test_BackupService_onedrive.js", "testing/modules/MockRegistrar.sys.mjs", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/mozapps/extensions/internal/AddonTestUtils.sys.mjs", "xpcom/tests/unit/test_windows_onedrive_registry.js"], "git_node": "83b163b91b9825cfec607a150b857198cc5b3140", "git_parents": ["d27eb6ae9969cfea9e362f0b07b7958348508785"], "node": "3b5b02a0e2b8f6a00614cc60497657c87410241d", "parents": ["aa27ed7e919fdd2cd6125ae6c8ebd68588793a1e"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066344 - Part 1: Call the theme picker's shown() when a New Tab picker becomes visible r=maxx\n\nNew Tab now calls the toolkit theme picker's `shown()` whenever one of\nits pickers comes into view, so the `theme_picker.shown` event is\nrecorded for about:newtab: for the compact picker when the Customize\npanel opens, and for the full picker when the \"See more themes\" subpanel\nopens. The picker element loads lazily, so the call waits for the element\nto be defined and is skipped if the panel has moved on by then, or if the\nFirefox build is too old to have `shown()`.\n\nNote that toolkit's `ThemePickerChild` actor records `shown` at most once\nper document, whichever layout reports first. The Customize panel always\nopens on its root panel, so the compact picker reports first and the full\npicker's event from about:newtab is currently dropped. New Tab still\ncalls `shown()` every time either picker appears, so if toolkit later\nrecords one event per layout, the full picker's events will start\narriving without any change on the New Tab side.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324867\n", "files": ["browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/lib/theme-picker-shown.mjs", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/theme-picker-shown.test.js", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx"], "git_node": "72b0ccafc2a56da1895d9901517807b56288e5fb", "git_parents": ["83b163b91b9825cfec607a150b857198cc5b3140"], "node": "80f09f44341205fbeb4cf1fb03ce25c8c0c2d246", "parents": ["3b5b02a0e2b8f6a00614cc60497657c87410241d"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066344 - Part 2: Track which New Tab customize subpanel is open with a single activeSubpanel value r=maxx\n\nRefactor how the customize panel tracks which subpanel is open. Part 3 of\nthis stack adds telemetry for the customize panel, and that telemetry\nneeds one value that names the open subpanel. The Base component now\nholds that value as `activeSubpanel`, so at most one subpanel is open at\na time, and the CustomizeMenu component derives each subpanel's open\nstate and its own styling from `activeSubpanel`. This removes the four\nbooleans and the callback each subpanel used to report its state back\nup. The subpanel props are unchanged.\n\nThis also fixes the panel styling itself as if no subpanel were open\nafter one subpanel replaced another, which Dre noted on D324515.\n\nThe Jest tests for the Base component now cover the new state: opening,\ntoggling and closing subpanels, one subpanel at a time, and the panel\ntaking its styling from the open subpanel. These replace the Enzyme\ntests deleted in this patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324868\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/SectionsMgmtPanel/SectionsMgmtPanel.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ThemesManagementPanel/ThemesManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/content-src/lib/constants.mjs", "browser/extensions/newtab/content-src/lib/theme-picker-shown.mjs", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/SectionsMgmtPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ThemesManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/theme-picker-shown.test.js", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/SectionsMgmtPanel.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx"], "git_node": "7d16c6c134279b98626aee627b806cd0e0e231a8", "git_parents": ["72b0ccafc2a56da1895d9901517807b56288e5fb"], "node": "b6bf1e5497aa3cb5b7a1dd03b5294b834c4160e8", "parents": ["80f09f44341205fbeb4cf1fb03ce25c8c0c2d246"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066344 - Part 3: Add telemetry for opening the New Tab customize panel and its subpanels r=maxx\n\nRecord in the newtab ping when the Customize panel opens, when one of\nits subpanels opens and which one, and when \"Explore more themes\" is\nclicked in the themes subpanel. The CustomizeMenu component records the\ntwo open events at the point where the panel becomes visible, so every\nway of opening it counts the same way, whether from the customize\nbutton, a message, or the widgets context menu. The \"Explore more\nthemes\" button reports its click as a user event, the way the other\nNew Tab clicks reach the TelemetryFeed module.\n\nThe panel open reuses the `SHOW_PERSONALIZE` user event name, so the\nseven entry points that already sent that event are changed to stop\nsending it. Nothing was listening for the event before this patch, and\nnow that the TelemetryFeed module is aware of it, leaving those\ndispatches in place would count every open twice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324869\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/content-src/components/ActivationWindowMessage/ActivationWindowMessage.jsx", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ThemesManagementPanel/ThemesManagementPanel.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/FeatureHighlight/WallpaperFeatureHighlight.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/PersonalizedCard/PersonalizedCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/PromoCard/PromoCard.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/lib/customize-panel-telemetry.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ThemesManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/PromoCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/customize-panel-telemetry.test.js", "browser/extensions/newtab/test/unit/content-src/components/Widgets.test.jsx", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "5bc47f3a9e4a87c7be496649a9c54d6c24149360", "git_parents": ["7d16c6c134279b98626aee627b806cd0e0e231a8"], "node": "a17bac684f80f057ed2a935416a478b05510e149", "parents": ["b6bf1e5497aa3cb5b7a1dd03b5294b834c4160e8"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066474 - Restore selected checkmark on lists widget switcher menu. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321275\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Lists/Lists.jsx"], "git_node": "794c470b678223b9f1dc7333c4030289b6a8dffb", "git_parents": ["5bc47f3a9e4a87c7be496649a9c54d6c24149360"], "node": "867a65255cbe4a6a2395d76f4005ca8e0a9b7e22", "parents": ["a17bac684f80f057ed2a935416a478b05510e149"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071034 - Disable V8 metagen instance-type generation for win64 CaR builds r=aglavic\n\nwindows CaR builds fail on //v8:metagen_isntance_types_h\nthe cause is the header search order in the new v8 tools/metagen\n\nonly our build fails as our MSVC is newer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325107\n", "files": ["taskcluster/kinds/toolchain/custom-car.yml"], "git_node": "2149ebeabc82af9cf74627be3debe1aefb697c67", "git_parents": ["794c470b678223b9f1dc7333c4030289b6a8dffb"], "node": "cf9ed331bf8dd4aa94d3dcca5d0fee033675c70d", "parents": ["867a65255cbe4a6a2395d76f4005ca8e0a9b7e22"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067076: Add z-index and cursor pointer to jump to bottom button in chat r=czhou\n\nIssue: the jump to bottom chat button stops working after we send a second message.\n\nSolution: it was behind the blur and needed a z-index to come to the top layer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324437\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css"], "git_node": "421a1bd6aa4213ea13a63705c87cceee911d58f7", "git_parents": ["2149ebeabc82af9cf74627be3debe1aefb697c67"], "node": "11c59929485994967a7eb90c36da1105df04a19c", "parents": ["cf9ed331bf8dd4aa94d3dcca5d0fee033675c70d"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068208 - [macOS 27] Warn `./mach run` users about new Firefox directory protections r=firefox-build-system-reviewers,ahochheiden,mac-reviewers,bradwerth\n\nOn macOS 27, when the default data directory (~/Library/Application\nSupport/Firefox) can not be read, warn the user and provide workaround\ninstructions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322802\n", "files": ["python/mozbuild/mozbuild/mach_commands.py"], "git_node": "92a4a0d0a105b0551f0f448722b5d27d30a7d23a", "git_parents": ["421a1bd6aa4213ea13a63705c87cceee911d58f7"], "node": "59362acacc012cf8c3647de6d12c7090838ab60d", "parents": ["11c59929485994967a7eb90c36da1105df04a19c"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066206 - Remove recently visited and bookmarks homepage sections from nimbus and default to false r=android-reviewers,gl,mobiletest-reviewers,jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322936\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelperDelegate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/HomeActivityTestRule.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NimbusMessagingHomescreenTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NimbusMessagingSurveyTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SearchTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/FenixApplicationTest.kt"], "git_node": "13b7456a12ab497b20ce18bc9699fa6d69716cc4", "git_parents": ["92a4a0d0a105b0551f0f448722b5d27d30a7d23a"], "node": "4ed756c18c0828ec93d8ca40ccb986e40be1ecb3", "parents": ["59362acacc012cf8c3647de6d12c7090838ab60d"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054193 - Add functionality to use form history to target low/no SAP searchers. r=mcheang,omc-reviewers,emcminn\n\nGive the stale form-history entry in check_recentSearchCount a safety\nmargin past the recency window, instead of landing exactly on the\n28-day cutoff, since the test's cutoff and the recentSearchCount\ngetter's own Date.now()-based cutoff could land on either side of the\nboundary on loaded/virtualized CI hardware, intermittently counting it\nas recent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311643\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "0bd8a8db526f897648f159cce9ffdb2119209a7a", "git_parents": ["13b7456a12ab497b20ce18bc9699fa6d69716cc4"], "node": "1eda0223390a8d3655a852c617b0ae9046e2f6a7", "parents": ["4ed756c18c0828ec93d8ca40ccb986e40be1ecb3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070252 - Check content policy types from PFetch. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324967\n", "files": ["dom/fetch/FetchParent.cpp", "dom/fetch/InternalRequest.h"], "git_node": "997b80c69fb2c41062fc45b7af5a62d952a5680c", "git_parents": ["0bd8a8db526f897648f159cce9ffdb2119209a7a"], "node": "1cf9c4c3eba2f57a25f57aa8718f51c523791dd4", "parents": ["1eda0223390a8d3655a852c617b0ae9046e2f6a7"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062965 - Tell Smart Window chat tabs apart by their conversation when closing duplicate tabs r=tabbrowser-reviewers,kcochrane,Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324446\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowTabStatesManager.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_duplicate_chat_tabs.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "7657554d78f46681922e272c4044f98c865b7159", "git_parents": ["997b80c69fb2c41062fc45b7af5a62d952a5680c"], "node": "61637715945f6fc08e1957e6af551e0712feda40", "parents": ["1cf9c4c3eba2f57a25f57aa8718f51c523791dd4"], "tags": []}, {"author": "Dominik Bay \u003cdominik@bay.sh\u003e", "branch": "default", "desc": "Bug 2067245 - Validate destination strides in ConvertToI420. r=media-playback-reviewers,chunmin\n\nBug 2050150 added a stride check to ConvertToNV12 after the WMF encoder\npassed a chroma stride that was too small. ConvertToI420 had the same\nmissing check, so I added it too, with a gtest covering the Y, U and V\nstride cases.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321954\n", "files": ["dom/media/ImageConversion.cpp", "dom/media/ImageConversion.h", "dom/media/gtest/TestImageConversion.cpp"], "git_node": "4fd5a695e81ef5c5a8d7a7cf06f48394df836a97", "git_parents": ["7657554d78f46681922e272c4044f98c865b7159"], "node": "d995d109ef8dc5b6c2cbc0dfdea3d92a78cb5ba6", "parents": ["61637715945f6fc08e1957e6af551e0712feda40"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2061046 - Add AITab Header component, wire up page actions - r=omarg,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322792\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/ui/actors/AITabChild.sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.css", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-shared.css", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabConstants.sys.mjs", "browser/components/aiwindow/ui/modules/AITabMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/AITabSql.sys.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_actions.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDate.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDelete.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml", "browser/locales-preview/aiWindow.ftl"], "git_node": "f1856812efbbec28b2dc48ab1304f833618e8ebe", "git_parents": ["4fd5a695e81ef5c5a8d7a7cf06f48394df836a97"], "node": "bca1811c78c532358794d3ecb67762801dc5784c", "parents": ["d995d109ef8dc5b6c2cbc0dfdea3d92a78cb5ba6"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066474 - Restore selected checkmark on lists widget switcher menu. r=maxx\" for causing node failures\n\nThis reverts commit 794c470b678223b9f1dc7333c4030289b6a8dffb.\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Lists/Lists.jsx"], "git_node": "3998bffd3c5515383280066dcf0c0d086bccbad1", "git_parents": ["f1856812efbbec28b2dc48ab1304f833618e8ebe"], "node": "d8e37e76dddb17a848dc73add9592319794b5573", "parents": ["bca1811c78c532358794d3ecb67762801dc5784c"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066063 - [devtools] Redirect invalid path to 404 for local mode requests. r=devtools-reviewers,nchevobbe\" for causing devtools and TV failures\n\nThis reverts commit d27eb6ae9969cfea9e362f0b07b7958348508785.\n\nRevert \"Bug 2066063 - [devtools] Ignore local mode request with custom ports. r=devtools-reviewers,jdescottes\"\n\nThis reverts commit 2d7e2b58b1079f732b62abef79efb340e1a1a0ef.\n", "files": ["devtools/shared/network-observer/NetworkLocalMode.sys.mjs", "devtools/shared/network-observer/NetworkObserver.sys.mjs", "devtools/shared/network-observer/test/browser/browser_networkobserver_localMode.js"], "git_node": "fb547655b088cb6ee4dfb3ae63a358fa0d9a3446", "git_parents": ["3998bffd3c5515383280066dcf0c0d086bccbad1"], "node": "5f3f158fcd97f6ba72065a5b541e9881bfe65916", "parents": ["d8e37e76dddb17a848dc73add9592319794b5573"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061046 - Add AITab Header component, wire up page actions - r=omarg,fluent-reviewers,bolsson\" for causing bc and TV failures\n\nThis reverts commit f1856812efbbec28b2dc48ab1304f833618e8ebe.\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/ui/actors/AITabChild.sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.css", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-shared.css", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabConstants.sys.mjs", "browser/components/aiwindow/ui/modules/AITabMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/AITabSql.sys.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_actions.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDate.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDelete.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml", "browser/locales-preview/aiWindow.ftl"], "git_node": "ac6e68df9469c784905aff6b87acbbba3b654b41", "git_parents": ["fb547655b088cb6ee4dfb3ae63a358fa0d9a3446"], "node": "46525b3b7fac5ae2686e3508b561a57ef826ed8a", "parents": ["5f3f158fcd97f6ba72065a5b541e9881bfe65916"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062032 -  Note that the Custom ETP category  exists r=dmehic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324894\n", "files": ["docs/_addons/etp_matrix.py"], "git_node": "06774ebc35b78dc79c400f3c0b380ad2992ba459", "git_parents": ["ac6e68df9469c784905aff6b87acbbba3b654b41"], "node": "7d50e34857683b468e47a3cabccb60be0807cdbc", "parents": ["46525b3b7fac5ae2686e3508b561a57ef826ed8a"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058313: Pass a String instead of start/end pointers to RegExp jitcode r=jandem\n\nIn preparation for being able to handle GC in interrupted regexps execution, the jitcode needs direct access to the string, so that it can be rooted when necessary. This patch changes InputOutputData to pass in a string directly, and stores it in the FrameData. While we're here, we also add the canResume flag; eventually, the regexp will use this to determine that it's safe to handle interrupts because everything is rooted in the caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324675\n", "files": ["js/src/irregexp/RegExpAPI.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h", "js/src/irregexp/RegExpTypes.h", "js/src/jit/CodeGenerator.cpp"], "git_node": "4b04e4d38109d3477fbe3f7a97a6ef0207e67bdf", "git_parents": ["06774ebc35b78dc79c400f3c0b380ad2992ba459"], "node": "37b51dc0d40a1aee1b1ebe055e9960f6f3deb9bb", "parents": ["7d50e34857683b468e47a3cabccb60be0807cdbc"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058313: Add aspirational backtrack stack SMDOC and implement non-interrupting parts r=jandem\n\nThe backtracking stuff gets somewhat complicated, so I wrote up an SMDOC to help pin down the details. This comment is currently not entirely accurate (in that we don't support interrupts yet) but it will be accurate at the end of the patch stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324676\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h", "js/src/irregexp/RegExpShim.cpp", "js/src/irregexp/RegExpShim.h"], "git_node": "0ac92b5476385757d66adf044aa7a0f3f6232d61", "git_parents": ["4b04e4d38109d3477fbe3f7a97a6ef0207e67bdf"], "node": "e1c88b2e8b92ad06ea6a77b7f6b410fe4d713d5b", "parents": ["37b51dc0d40a1aee1b1ebe055e9960f6f3deb9bb"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058313: Move all backtrack code into a single handler r=jandem\n\nCurrently, we sometimes backtrack by emitting the `Backtrack()` code inline, and sometimes by jumping to a shared backtrack handler. Given that we are emitting the backtrack handler, we might as well use it consistently to reduce code size, particularly since interrupt handling will make it a bit bigger. This matches what V8 already does. This also makes it a little easier to implement backtrack stack elision (bug 2061826).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324677\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp"], "git_node": "dbc4b8c34f9830dd06cfc51b7761559003b47beb", "git_parents": ["0ac92b5476385757d66adf044aa7a0f3f6232d61"], "node": "8df9ef0d55248cb9133f9464017a76dbaf45f64d", "parents": ["e1c88b2e8b92ad06ea6a77b7f6b410fe4d713d5b"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058313: Handle interrupts from RegExp jitcode r=jandem\n\nThis is fiddly code, so (using rr) I manually verified that:\n- interrupt-regexp-with-gc.js covers the case where the string is promoted from the nursery while interrupted\n- the AutoInterruptingRegExp in HandleRegExpInterrupt is necessary; without it, interrupt-regexp-with-gc.js will free the jitcode and segfault\n- interrupt-regexp-with-regexp.js covers the case where we reallocate the backtrack stack while interrupted\n- interrupt-regexp-with-nested-regexp.js covers the case where we interrupt an interrupted regexp (the interrupt depth in the JitZone goes to 5)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324678\n", "files": ["js/src/gc/Zone.cpp", "js/src/irregexp/RegExpAPI.h", "js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h", "js/src/jit-test/tests/regexp/interrupt-regexp-with-gc.js", "js/src/jit-test/tests/regexp/interrupt-regexp-with-nested-regexp.js", "js/src/jit-test/tests/regexp/interrupt-regexp-with-regexp.js", "js/src/jit/ABIFunctionList-inl.h", "js/src/jit/JitZone.h"], "git_node": "87cc57cebcb05fcb9fee16a488009646060109e6", "git_parents": ["dbc4b8c34f9830dd06cfc51b7761559003b47beb"], "node": "b63e57ea4675f1718ed3832eb859a2148e8247fb", "parents": ["8df9ef0d55248cb9133f9464017a76dbaf45f64d"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058313: Update existing code r=jandem\n\nNow that we (sometimes) handle interrupts, a bunch of code can be updated. The biggest change here is error handling in RegExpShared::execute. Prior to this change, we assumed that returning RegExpRunStatus::Error from a regexp implied stack overflow unless there was an interrupt pending. Now that we support handling interrupts, we also have to consider the case where we invoke an interrupt handler and it returns false. To ensure that we properly disambiguate between that case and stack overflow, I've added a flag to the context that can be used to signal that we would like to throw a stack overflow error (which we can't do because we're generally in a context where we can't GC). That flag is now checked in RegExpShared::execute, and in each of the four JIT entry points that are used as fallbacks from regexp stub code. (Previously, if we hit stack overflow when called via a regexp stub, I think we would just fall back to a VM call and invoke the regexp again, which would presumably eventually overflow again. It seems better to fail early.)\n\n(I also squashed a few clang-format changes that didn't absorb properly into this patch.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324679\n", "files": ["js/src/builtin/RegExp.cpp", "js/src/irregexp/RegExpAPI.h", "js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpShim.h", "js/src/jit-test/tests/regexp/interrupt-regexp-and-fail.js", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h", "js/src/vm/RegExpObject.cpp"], "git_node": "f946b611a115475962b6fc187216cb7c742c7125", "git_parents": ["87cc57cebcb05fcb9fee16a488009646060109e6"], "node": "de924bac22a949496d2b35c604e663a229f509f3", "parents": ["b63e57ea4675f1718ed3832eb859a2148e8247fb"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070894 - Update dav1d to a34e0685b9111b9eb1d7835ea7bea5b425dced73 r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324944\n", "files": ["media/libdav1d/moz.yaml", "media/libdav1d/vcs_version.h", "third_party/dav1d/include/compat/msvc/stdatomic.h", "third_party/dav1d/src/x86/cdef_sse.asm"], "git_node": "33ad7988e5134c406c247835df0ba716f23ebc72", "git_parents": ["f946b611a115475962b6fc187216cb7c742c7125"], "node": "e1efdaf98a36b15eb52196a9ef128a4ef7728951", "parents": ["de924bac22a949496d2b35c604e663a229f509f3"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070896 - Update libvpx to d2413e2ca11039724ca33bb4d661ca2c94cb501e r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324947\n", "files": ["media/libvpx/libvpx/test/predict_test.cc", "media/libvpx/libvpx/vp8/common/reconinter.c", "media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vp9/vp9_cx_iface.c", "media/libvpx/libvpx/vpx_ports/aarch64_cpudetect.c", "media/libvpx/libvpx/vpx_util/vpx_pthread.h", "media/libvpx/moz.yaml"], "git_node": "ef723865eee0b7428e58da0d840fa4a8694c74db", "git_parents": ["33ad7988e5134c406c247835df0ba716f23ebc72"], "node": "54fa0ec0e4946202e7568a2fa728b1db5b56f5a6", "parents": ["e1efdaf98a36b15eb52196a9ef128a4ef7728951"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070896 - Apply mozilla patches for libvpx r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324948\n", "files": ["media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vp9/vp9_cx_iface.c", "media/libvpx/libvpx/vpx_ports/aarch64_cpudetect.c", "media/libvpx/libvpx/vpx_util/vpx_pthread.h"], "git_node": "68e783934603fce75f2509f571678d8b29e92a5e", "git_parents": ["ef723865eee0b7428e58da0d840fa4a8694c74db"], "node": "ee112d17dce1610c61b79f1d1d9acf273e25ca0c", "parents": ["54fa0ec0e4946202e7568a2fa728b1db5b56f5a6"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2037472 - Fix focus timer widget's radio group keyboard navigation and selection. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323948\n", "files": ["browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/content-src/components/Widgets/FocusTimer/FocusTimer.jsx", "browser/extensions/newtab/content-src/components/Widgets/FocusTimer/_FocusTimer.scss", "browser/extensions/newtab/data/content/abouthomecache/page.html.template", "browser/extensions/newtab/prerendered/activity-stream-debug.html", "browser/extensions/newtab/prerendered/activity-stream-noscripts.html", "browser/extensions/newtab/prerendered/activity-stream.html", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FocusTimer.test.jsx"], "git_node": "d864680783c3bb006060a81cb8a8da6d3fab2df4", "git_parents": ["68e783934603fce75f2509f571678d8b29e92a5e"], "node": "da44d122bc5afadfe37cf62cf2fbe646d1fe86b9", "parents": ["ee112d17dce1610c61b79f1d1d9acf273e25ca0c"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070696 - Turn newtab sections on by default for all launched markets. r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325065\n", "files": ["browser/app/profile/firefox.js"], "git_node": "c44f5a98167bfe3fc84e39b7276cc2d08d975212", "git_parents": ["d864680783c3bb006060a81cb8a8da6d3fab2df4"], "node": "cdc587c9573bed565ce83e5c62bb41c7bfdf3a89", "parents": ["da44d122bc5afadfe37cf62cf2fbe646d1fe86b9"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068046 - Ensure avatar background color is set when picking default theme with Nova enabled r=mkennedy,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323055\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_test.js"], "git_node": "3fe3d7811333015806e08b64413c41956c1a3d97", "git_parents": ["c44f5a98167bfe3fc84e39b7276cc2d08d975212"], "node": "0fbb496ec0cc032d7fc300fcf2a98b35f00dbd1b", "parents": ["cdc587c9573bed565ce83e5c62bb41c7bfdf3a89"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068917 - revert to old theme color selection for non-Nova themes r=rpl,desktop-theme-reviewers,mkennedy,tgiles,mossop\n\nWe switched how we're selecting theme foreground and background colors to make the profile avatars look the best for Nova specific themes. It turns out this causes contrast issues with some legacy/user generated themes, so this patch adds a check to determine which color selection logic we should follow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324415\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs"], "git_node": "8deda8007c4449bfc41f20169ff148086cc8db0e", "git_parents": ["3fe3d7811333015806e08b64413c41956c1a3d97"], "node": "d6e7bc8e226f7f1cd8d042521f23d4a7c4c09abb", "parents": ["0fbb496ec0cc032d7fc300fcf2a98b35f00dbd1b"], "tags": []}], "date": 1789118955, "git_changesets": ["67e3887542a2c9e1d748d1f68ea4aa995bc8f083", "fa4401d54e1722f8d4fbdc763802e6342a5e4d45", "f828eb05f8607d4ed9c55a3136c2bc2e