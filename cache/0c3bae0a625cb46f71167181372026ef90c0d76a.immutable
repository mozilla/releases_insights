ctices.md", "dom/base/Document.cpp", "dom/events/test/browser.toml", "dom/events/test/browser_mouse_click_screenXY.js", "dom/events/test/browser_mouse_enterleave_switch_tab.js", "dom/security/test/general/browser_test_referrer_loadInOtherProcess.js", "dom/webserial/tests/browser/browser_webserial_blocked_icon.js", "eslint-file-globals.config.mjs", "eslint-ignores.config.mjs", "eslint-rollouts.config.mjs", "eslint-subdirs.config.mjs", "eslint-test-paths.config.mjs", "eslint.config.mjs", "gfx/layers/apz/test/mochitest/browser.toml", "gfx/layers/apz/test/mochitest/browserSidebarRevamp.toml", "gfx/layers/apz/test/mochitest/helper_browser_test_utils.js", "layout/base/tests/browser.toml", "layout/base/tests/browser_select_popup_from_background_tab.js", "layout/base/tests/browser_select_popup_position_in_out_of_process_iframe.js", "mobile/android/fenix/app/src/androidTest/assets/resources/trackingAPI.js", "security/manager/tools/mach_commands.py", "testing/docs/tests-for-new-config/manual.md", "toolkit/components/antitracking/test/browser/browser-blocking.toml", "toolkit/components/antitracking/test/browser/browser.toml", "toolkit/components/antitracking/test/browser/browser_referrerDefaultPolicy.js", "toolkit/components/antitracking/test/browser/trackingAPI.js", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_content_analysis.js", "toolkit/components/pageextractor/tests/browser/browser_dom_extractor.js", "toolkit/components/pdfjs/moz.yaml", "toolkit/content/xul.css", "tools/lint/rejected-words.yml", "tools/tryselect/try_presets.yml"], "git_node": "3446f93cf0af937af5354370cc3116ab86b97d38", "git_parents": ["7fcc0b778cfb37bcb88c6b2eb313718f5675abbf"], "node": "74f3fe362b70bc2da556d3cdcf104892df4809a8", "parents": ["1c3fd14325e083c3d3496503421e325e2f9d59b1"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071976 - Update metadata for cookiestore/cookieStore_set_arguments.https.any.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326468\n", "files": ["testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini"], "git_node": "46c5df618272ea1fd2c6a79cb09e29dd03da7d48", "git_parents": ["3446f93cf0af937af5354370cc3116ab86b97d38"], "node": "372e68fb7d1b99cbb1f3213e61ecde6dc1c7621e", "parents": ["74f3fe362b70bc2da556d3cdcf104892df4809a8"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072299 - Cache each surface's picture-to-device mapping on SurfaceInfo. r=gfx-reviewers,gw\n\nA surface's picture space relates to its device space (its raster space\nscaled by device_pixel_scale) by a 2D scale+offset: either the device\nscale alone, or, for a root-snapping surface, the surface node's\nscale+offset to the root. assign_surface only diverges the raster node\nfrom the surface node for a surface in the root coordinate system, and a\nnode there relates to the root by a scale+offset by construction.\n\nThat mapping is fixed for the frame, but map_to_device_rect and\nget_surface_rect were re-deriving it as a SpaceMapper on every call,\ncosting a get_relative_transform each time, and get_surface_rects spelled\nout a third copy of it. Store it as a ScaleOffset when the surface is\nassigned instead, and re-derive it in the one place that rewrites the\nscale: the max_surface_size clamp in get_surface_rects.\n\nThe per-call assertions about that invariant become one debug assertion\nper surface, next to the reasoning they check.\n\nNo functional change: SpaceMapper::map on a ScaleOffset kind is\nScaleOffset::map_rect, so the rects are identical.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326240\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/surface.rs"], "git_node": "6afcd13c1078512ba7bccdd0aafb93624bd38581", "git_parents": ["46c5df618272ea1fd2c6a79cb09e29dd03da7d48"], "node": "cec77a43187d9167e9992b8c5b9514ae1e2c19b3", "parents": ["372e68fb7d1b99cbb1f3213e61ecde6dc1c7621e"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072299 - Express SurfaceInfo::clipping_rect in device space. r=gfx-reviewers,gw\n\nEvery consumer of clipping_rect intersects a primitive's footprint\nagainst it in order to size or place a render task, which is a\ndevice-space rect, so each one mapped out of picture space at its own\ncall site. Keep the rect in the surface's device space instead and the\nintersections happen on the far side of that mapping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326241\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "b5178aa444257025fe0c4cae28a3f7641ebb7b54", "git_parents": ["6afcd13c1078512ba7bccdd0aafb93624bd38581"], "node": "98882f42443b0f73fc644c60904578f74d1f266c", "parents": ["cec77a43187d9167e9992b8c5b9514ae1e2c19b3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071068 - Improve WeakFrame handling. r=xpcom-reviewers,layout-reviewers,dshin,mccr8\n\nAdd a move constructor, mark it as non-memmovable, and go back to\nstd::pair\u003c\u003e (making sure that nsTArray deals with it properly).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325323\n", "files": ["layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/xul/nsXULPopupManager.cpp", "xpcom/ds/nsTArray.h", "xpcom/tests/gtest/TestTArray.cpp"], "git_node": "94e92ce03bbe730b034e86f3e3f6513b21f23cfc", "git_parents": ["b5178aa444257025fe0c4cae28a3f7641ebb7b54"], "node": "dec7c1379e969530ba3a165d93032a779ea16518", "parents": ["98882f42443b0f73fc644c60904578f74d1f266c"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2072452 - Update WPT for CSS random() serialization to test eager simplification. r=firefox-style-system-reviewers,emilio\n\nSee: https://github.com/w3c/csswg-drafts/issues/14478\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326342\n", "files": ["testing/web-platform/meta/css/css-values/random-serialize.tentative.html.ini", "testing/web-platform/tests/css/css-values/random-serialize.tentative.html"], "git_node": "41babb01c5b3e50f45809a764c1567b72b0d12ec", "git_parents": ["94e92ce03bbe730b034e86f3e3f6513b21f23cfc"], "node": "cdc99e817bba3db8911e6c396ff896949151b547", "parents": ["dec7c1379e969530ba3a165d93032a779ea16518"], "tags": []}, {"author": "Sho Sakuma \u003cme@m1sk9.dev\u003e", "branch": "default", "desc": "Bug 2072520 - Fix WP_WIN and WP_MACOSX typos in LaunchChild's #endif comments. r=firefox-desktop-core-reviewers ,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326402\n", "files": ["toolkit/xre/nsAppRunner.cpp"], "git_node": "7c1514ed791288169b24b1b594724b412ce230c7", "git_parents": ["41babb01c5b3e50f45809a764c1567b72b0d12ec"], "node": "19d58e0951c5e4f94554537e6ea655e41c3a61bb", "parents": ["cdc99e817bba3db8911e6c396ff896949151b547"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Adjust reftest fuzziness. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326247\n", "files": ["layout/reftests/border-radius/reftest.list", "layout/reftests/bugs/reftest.list", "layout/reftests/image-element/reftest.list", "layout/reftests/svg/as-image/reftest.list", "layout/reftests/svg/moz-only/reftest.list", "layout/reftests/svg/reftest.list", "layout/reftests/svg/smil/transform/reftest.list", "layout/reftests/svg/svg-integration/clip-path/reftest.list", "layout/reftests/svg/text/reftest.list", "layout/reftests/text-svgglyphs/reftest.list", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3a.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3b.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3c.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3d.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3e.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3f.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3g.html.ini", "testing/web-platform/meta/css/css-transforms/transforms-rotate-degree-45.html.ini", "testing/web-platform/meta/svg/painting/marker-001.svg.ini", "testing/web-platform/meta/svg/painting/marker-009.svg.ini", "testing/web-platform/meta/svg/styling/css-linked-parameters/img-with-linked-parameters-1.html.ini"], "git_node": "09ff442d5a46b59d14fc9c6db90546e602f165a2", "git_parents": ["7c1514ed791288169b24b1b594724b412ce230c7"], "node": "ace4a55196d3dab4cbd2f8e0b03f5ba3ad73fb9c", "parents": ["19d58e0951c5e4f94554537e6ea655e41c3a61bb"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1709529 - [devtools] Set `watchedByDevTools` from the parent process. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324044\n", "files": ["devtools/server/actors/targets/window-global.js", "devtools/server/actors/watcher.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/server/connectors/js-process-actor/target-watchers/window-global.sys.mjs", "docshell/test/browser/browser_watchedByDevTools.js"], "git_node": "9ec420fcbf627ef2ac6d60c1f2224496b3b09903", "git_parents": ["09ff442d5a46b59d14fc9c6db90546e602f165a2"], "node": "b2c7e105e4e9eb00aa10ac2f0abd28fec488bb06", "parents": ["ace4a55196d3dab4cbd2f8e0b03f5ba3ad73fb9c"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069869 - Move vertical tab close button down 1px so the first unpinned tab's close button doesn't get clipped r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325945\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "46117301628808547f37c181ded4883a76497c86", "git_parents": ["9ec420fcbf627ef2ac6d60c1f2224496b3b09903"], "node": "b701cb7005997f75b4fd4be1baadab1c888113fa", "parents": ["b2c7e105e4e9eb00aa10ac2f0abd28fec488bb06"], "tags": []}, {"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069954 - Add Glean telemetry for login storage operation timings and initialization phases r=joschmidt,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324390\n", "files": ["toolkit/components/passwordmgr/LoginManager.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/storage-desktop.sys.mjs", "toolkit/components/passwordmgr/storage-geckoview.sys.mjs", "toolkit/components/passwordmgr/storage-json.sys.mjs", "toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_login_storage_migrator.js"], "git_node": "8cbb811a6428df8d34c3d7e44dc080aa63c13675", "git_parents": ["46117301628808547f37c181ded4883a76497c86"], "node": "0cdaba8b751cd51e43ac38682172a20bd8a9c5d5", "parents": ["b701cb7005997f75b4fd4be1baadab1c888113fa"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069803 - Enable on-device Speech Recognition on Nightly. r=media-webspeech-reviewers,pehrsons,webidl,jjaschke,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326192\n", "files": ["dom/tests/mochitest/general/test_interfaces.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "27eea98dc82576cb9e769a8f6e041a56c7effaea", "git_parents": ["8cbb811a6428df8d34c3d7e44dc080aa63c13675"], "node": "d9500728d6572771aad43c848d6e46d747648186", "parents": ["0cdaba8b751cd51e43ac38682172a20bd8a9c5d5"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2072523 - [wpt] Call assertions from event listeners within a test step. r=hiro,edgar\n\ntestharness.js requires that assertions are only called in the context of\na Test. Several tests break that rule by asserting directly inside an\nevent listener.\n\nAs long as such a listener is invoked synchronously from the test body,\nthe exception still propagates into the test and is reported as a subtest\nfailure. But when the listener is driven by asynchronous input from\ntestdriver it runs in its own task, so a failing assertion escapes to the\nglobal error handler. That marks the whole test file as ERROR without any\nsubtest results, which cannot be annotated in the expectation metadata and\nhides the actual assertion message. In several of these tests the escaping\nexception also skips the call that resolves the test's promise, so the test\nadditionally runs into a timeout instead of failing.\n\nWrap the affected listeners in Test.step_func(), or move the assertions\ninto the test body where the listener only needs to record state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326403\n", "files": ["testing/web-platform/meta/dom/events/click-on-absolute-pseudo.html.ini", "testing/web-platform/meta/pointerlock/pointerlock_unadjustedMovement_update.html.ini", "testing/web-platform/tests/dom/events/click-on-absolute-pseudo.html", "testing/web-platform/tests/dom/events/scrolling/save-iframe-scroll-offset-when-display-none.html", "testing/web-platform/tests/dom/events/scrolling/scroll-cross-origin-iframes.html", "testing/web-platform/tests/dom/ev