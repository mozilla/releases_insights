/auto-repeat/intrinsic-auto-repeat/row-auto-repeat-auto-018.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/intrinsic-auto-repeat/row-auto-repeat-auto-031.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/intrinsic-auto-repeat/row-auto-repeat-fit-content-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/intrinsic-auto-repeat/row-auto-repeat-max-content-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/intrinsic-auto-repeat/row-auto-repeat-min-content-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-006.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-007.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-008.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-009.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-010.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-011.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-012.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-013.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-014.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-015.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-016.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-017.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-021.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-022.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-023.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-024.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-025.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-026.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-027.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-028.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/dynamic-grid-track-direction.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-flex-sizing-rows-min-max-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-fr-rows-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-check-grid-height-on-resize.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini"], "git_node": "5086038b098d3e54833a975ac440e39c92b332c5", "git_parents": ["e3c61b8fec6f641ade25ca5378d634bfbc471a48"], "node": "7069e0f754afa1a835db4a75f9f0ed434c1f1a09", "parents": ["790b47e49a360384eb60b4eaf1d10db0ac47868b"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070176 - Connection Allowlists: Implement in-process support for Report a Violation. r=simonf,webidl,sfarre,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324289\n", "files": ["dom/reporting/ConnectionAllowlistViolationReportBody.cpp", "dom/reporting/ConnectionAllowlistViolationReportBody.h", "dom/reporting/moz.build", "dom/security/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlists.h", "dom/webidl/Reporting.webidl", "testing/web-platform/meta/connection-allowlist/tentative/reporting-http.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/reporting-image-blocked.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/reporting-multiple-violations.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/reporting-report-only.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/service-worker-reporting-url-sanitization.https.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/service-worker-reporting.sub.https.window.js.ini", "xpcom/ds/StaticAtoms.py"], "git_node": "a0fc77faa9911f8ceea8b808d8612482be5d8466", "git_parents": ["5086038b098d3e54833a975ac440e39c92b332c5"], "node": "31d650ff03d95d9ccaafd50260b6f3c325c6d0a6", "parents": ["7069e0f754afa1a835db4a75f9f0ed434c1f1a09"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057375 - Confine GooglePlayIntegrityClient to Components.kt. r=nalexander,android-reviewers,matt-tighe\" for causing linting opt failures.\n\nThis reverts commit 68616800ab8d19276f64a22f2a8f82b2967188f8.\n\nThis reverts commit 7271bd33ba6d703fc7aed77f98f070a2c9b52be4.\n", "files": ["mobile/android/android-components/components/concept/integrity/src/main/java/mozilla/components/concept/integrity/IntegrityClient.kt", "mobile/android/android-components/components/concept/integrity/src/main/java/mozilla/components/concept/integrity/RequestHashProvider.kt", "mobile/android/android-components/components/lib/integrity-googleplay/src/main/java/mozilla/components/lib/integrity/googleplay/GooglePlayIntegrityClient.kt", "mobile/android/android-components/components/lib/integrity-googleplay/src/main/java/mozilla/components/lib/integrity/googleplay/ext/StandardIntegrityManager.kt", "mobile/android/android-components/components/lib/integrity-googleplay/src/test/java/mozilla/components/lib/integrity/googleplay/GooglePlayIntegrityClientTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ClientUUID.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ClientUuid.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/llm/Llm.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/integrity/FakeClientUUID.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/integrity/FakeClientUuid.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/integrity/IntegrityTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/navigation/DebugDrawerRoute.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/ui/FenixOverlay.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ClientUUIDTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ClientUuidTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "7baf62313e51d493c1cce8565d91079ccf9c37a7", "git_parents": ["a0fc77faa9911f8ceea8b808d8612482be5d8466"], "node": "52cbd16323765b340b83a7db09603c3b94e806d5", "parents": ["31d650ff03d95d9ccaafd50260b6f3c325c6d0a6"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073443 - Treat unparseable network geolocation responses as failures and skip requests without a service URL. r=geoprovider-reviewers,handyman\n\nA 2xx response whose body is not JSON, or is JSON without a location, was\ncounted as a successful request and never as a failure. Count it under\ngeolocation.network_failures like a non-2xx status.\n\nWhen geo.provider.network.url has no value, formatURLPref() returns\nabout:blank and the provider POSTed to it on every timer tick. Fail the\nrequest without sending anything instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327369\n", "files": ["dom/geolocation/test/unit/test_geolocation_provider_bad_response.js", "dom/geolocation/test/unit/xpcshell.toml", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "b698bcb4084611e458affb4981652e3a0226f8ca", "git_parents": ["7baf62313e51d493c1cce8565d91079ccf9c37a7"], "node": "85b7ba6e9ca1ea87883a5ddc7bcc8e7ed889c75e", "parents": ["52cbd16323765b340b83a7db09603c3b94e806d5"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1741675 - Bound the BITS service activation so a stuck BITS service cannot block XPCOM shutdown. r=application-update-reviewers,yjuglaret,cdupuis\n\nTo start or reconnect to an update download, the BitsCommander thread\nconnects to the BITS service with CoCreateInstance(CLSID_BackgroundCopyManager,\nCLSCTX_LOCAL_SERVER). That call has no timeout: it asks RPCSS to have the\nService Control Manager start the BITS service and waits for the answer. On\nmachines where that start never completes, for example while the SCM database\nis locked during boot, the thread sits in the activation indefinitely.\n\nTwo things follow. The pending request keeps the update service in the\n\"downloading\" state, so no later check and no fallback happens and the update\nis never downloaded in that session. And at shutdown,\nnsThreadManager::ShutdownNonMainThreads waits for the BitsCommander thread\nuntil the shutdown terminator aborts the process, which is the main-thread\nsignature tracked by bug 1505660. On Windows, every recent report under that\nsignature shows this activation on the BitsCommander thread.\n\nPerform the activation on a plain helper thread that joins the same\nmultithreaded apartment, and let the command thread wait for at most 30\nseconds. On timeout the client reports a ConnectBcm failure, which the update\nservice already handles by marking the patch and falling back to\nnsIIncrementalDownload. The helper thread is not an XPCOM thread, so nothing\nwaits for it at shutdown, and it releases the interface if the activation\ncompletes later. 30 seconds is the Service Control Manager's own default wait\nfor a service start and stays below the 60 seconds the terminator grants the\nXPCOMShutdownThreads step. Timed-out activations that are still pending are\ncounted; once two are, further connects fail at once instead of parking yet\nanother thread. Two cover the monitor thread's reconnect plus a concurrent\ncommand, more can only mean a service that stays stuck. Both failures carry\nHRESULTs of our own, with the customer bit set, so telemetry can tell them from\nanything Windows returns.\n\nThe monitor thread reconnects on every status poll and is handled in the next\npatch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324605\n", "files": ["toolkit/components/bitsdownload/bits_client/bits/src/lib.rs", "toolkit/components/bitsdownload/bits_client/src/in_process/mod.rs"], "git_node": "039771934be64ab3a03a4baadaf1b6cf039a785a", "git_parents": ["b698bcb4084611e458affb4981652e3a0226f8ca"], "node": "6743371a70ebfa789a02b850bbc706ecd70bd0d7", "parents": ["85b7ba6e9ca1ea87883a5ddc7bcc8e7ed889c75e"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1741675 - Keep one BITS connection per monitor thread instead of reconnecting on every poll. r=application-update-reviewers,yjuglaret,cdupuis\n\nThe monitor thread reconnected to the BITS service on every status poll, which\nleft one unbounded CoCreateInstance in bits_client: had the service stopped\nanswering mid-transfer, the BitsMonitor thread would have hung at shutdown the\nsame way the command thread did.\n\nConnect once with the bounded connect and keep the proxy for the following\npolls. The proxy belongs to the multithreaded apartment, so it may travel with\nthe monitor object between threads, but it is only used on the thread that\nconnected. It is released there when the job reaches a final state or a poll\nfails. Should the monitor be dropped on another thread instead, the proxy is\nleaked rather than released from a foreign apartment.\n\nReconnecting on every poll also made a restart of the BITS service invisible,\nsince the next poll simply found the job again. To keep that, a failure on a\nkept connection is retried once on a fresh one before it is reported, unless\nthe error came from the BITS service itself, which a fresh connection would\nonly repeat. If the retry fails as well, the first error is the one reported.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324606\n", "files": ["toolkit/components/bitsdownload/bits_client/bits/src/lib.rs", "toolkit/components/bitsdownload/bits_client/src/in_process/mod.rs", "toolkit/components/bitsdownload/bits_client/src/in_process/tests.rs", "toolkit/components/bitsdownload/src/bits_interface/task/service_task.rs"], "git_node": "9c97e418aa749a10d2d0191b54e8eb7ceacc8479", "git_parents": ["039771934be64ab3a03a4baadaf1b6cf039a785a"], "node": "9ba638eaa28d73a3f49e9bf1298a7b3376889f11", "parents": ["6743371a70ebfa789a02b850bbc706ecd70bd0d7"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1741675 - Report BITS connect failures on the monitor thread as such, with their HRESULT. r=application-update-reviewers,yjuglaret,cdupuis\n\nA connect failure while polling a job's status was reported as\nFAILED_TO_GET_JOB_STATUS without an error code, so telemetry could not tell a\nconnect timeout or a stale connection from a failing status query. Return it as\nits own error, map it to FAILED_TO_CONNECT_TO_BCM like the command thread does,\nand pass the HRESULT through in both cases. A reconnect that fails during the\nretry after a failed status query keeps reporting that first error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324607\n", "files": ["toolkit/components/bitsdownload/bits_client/src/in_process/mod.rs", "toolkit/components/bitsdownload/bits_client/src/lib.rs", "toolkit/components/bitsdownload/src/bits_interface/error.rs", "toolkit/components/bitsdownload/src/bits_interface/monitor.rs"], "git_node": "5403d264714191f25e7c5d398e058280e631d552", "git_parents": ["9c97e418aa749a10d2d0191b54e8eb7ceacc8479"], "node": "7e06868af169e0ba753da5bed59586c8d34f1f39", "parents": ["9ba638eaa28d73a3f49e9bf1298a7b3376889f11"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1741675 - Replace the update.bitshresult counter with a bits_error event that can carry the HRESULT. r=application-update-reviewers,yjuglaret,cdupuis\n\nupdate.bitshresult was migrated from a keyed scalar to a labeled_counter, but\nthe code still calls set() on it, which counters do not have. The call throws\ninto a catch block, so no BITS HRESULT has been recorded since the migration.\nA counter cannot carry a code anyway, so replace it with an event that records\nthe patch type, the nsIBits error type, action and stage, and the HRESULT when\nthere is one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324608\n", "files": ["toolkit/mozapps/update/UpdateTelemetry.sys.mjs", "toolkit/mozapps/update/shared_metrics.yaml", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "62207e29da4e10dc98ec98ac93f0edf69bde61d3", "git_parents": ["5403d264714191f25e7c5d398e058280e631d552"], "node": "4243f1fb4755d43bd5a55784c7baf5dad9292eaf", "parents": ["7e06868af169e0ba753da5bed59586c8d34f1f39"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2070099 - Extend meta schema to support more compat data nesting. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327861\n", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/schemas/policies-schema.meta.json"], "git_node": "0add822f64ce3f7dc79ef9f978ed348950a9e761", "git_parents": ["62207e29da4e10dc98ec98ac93f0edf69bde61d3"], "node": "0dfa6259c272da2d04984a03fc4cc289b528e06d", "parents": ["4243f1fb4755d43bd5a55784c7baf5dad9292eaf"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2070099 - Add compat to policy properties. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327873\n", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": "2559401686edc8ce5b92595f5f4c342fdc01e258", "git_parents": ["0add822f64ce3f7dc79ef9f978ed348950a9e761"], "node": "245426b48e05b2a22185d4879b74bd6454274387", "parents": ["0dfa6259c272da2d04984a03fc4cc289b528e06d"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062633 - Add module owners for Remote Settings r=shtrom\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317823\n", "files": ["mots.yaml"], "git_node": "193eeac42053619d263f55598b3705522b7c3093", "git_parents": ["2559401686edc8ce5b92595f5f4c342fdc01e258"], "node": "a1b348dceab354ba947bc64d83816898f6c6e378", "parents": ["245426b48e05b2a22185d4879b74bd6454274387"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071337 - Hide theme cards description in about:addons themes list view. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328219\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css"], "git_node": "6b7dba74864b061f7d6482ee436d3436e2fbc7a4", "git_parents": ["193eeac42053619d263f55598b3705522b7c3093"], "node": "c18f63899dff8fd7702e0fcd950f17db4e1a9e71", "parents": ["a1b348dceab354ba947bc64d83816898f6c6e378"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073838 - Keep the urlbar view closed when a search mode query has no results and no one-offs to show. r=daleharvey\n\npromiseSearchComplete no longer waits for the view to open, since a query without results now leaves it closed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327663\n", "files": ["browser/components/urlbar/UrlbarSearchOneOffs.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js", "browser/components/urlbar/tests/browser-searchMode/browser_newWindow.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js"], "git_node": "18223a4156c674e2ea2258b2e1083fa95be5398c", "git_parents": ["6b7dba74864b061f7d6482ee436d3436e2fbc7a4"], "node": "2d90a00fcc5ebe550e4ec08e0c6011acb37f45f9", "parents": ["c18f63899dff8fd7702e0fcd950f17db4e1a9e71"], "tags": []}, {"author": "Marcos C\u00e1ceres \u003ccaceres_m@apple.com\u003e", "branch": "default", "desc": "Bug 2072776 [wpt PR 62571] - [geolocation] Test that cached positions are only reused for a matching accuracyMode, a=testonly\n\nAutomatic update from web-platform-tests\n[geolocation] test that cached positions are only reused for a matching accuracyMode (#62571)\n--\n\nwpt-commits: e7edf6fb2cbc6308670f1c52e26ec297d0c032a6\nwpt-pr: 62571\n", "files": ["testing/web-platform/tests/geolocation/getCurrentPosition-accuracyMode-cache.https.html"], "git_node": "8090b7db2a718c20594e3d6a55f56174db161c83", "git_parents": ["18223a4156c674e2ea2258b2e1083fa95be5398c"], "node": "e4ad13bb281c3e220b704a2959d30cfbe98715ea", "parents": ["2d90a00fcc5ebe550e4ec08e0c6011acb37f45f9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072776 [wpt PR 62571] - Update wpt metadata, a=testonly\n\nwpt-pr: 62571\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/geolocation/getCurrentPosition-accuracyMode-cache.https.html.ini"], "git_node": "9f82005d83b983b9e53642d9963df8ed0aa213fd", "git_parents": ["8090b7db2a718c20594e3d6a55f56174db161c83"], "node": "441fbfefb132045dd4523576a00242d0b8c74d8a", "parents": ["e4ad13bb281c3e220b704a2959d30cfbe98715ea"], "tags": []}, {"author": "David Baron \u003cdbaron@chromium.org\u003e", "branch": "default", "desc": "Bug 2072781 [wpt PR 62748] - Allow calc-size() to interpolate with keyword when basis is length without percentages., a=testonly\n\nAutomatic update from web-platform-tests\nAllow calc-size() to interpolate with keyword when basis is length without percentages.\n\nThis was an error in the optimization where we tried to determine\ninterpolation against keywords without actually doing the calc-size()\nconversion.  Instead, fall back to the general code for more cases (but\nstill not the performance-sensitive ones).\n\nReported in https://github.com/w3c/csswg-drafts/issues/14499\n\nBug: 40339056\nChange-Id: Id56a9a0eb561a8af12fd1e4e1cc25d40f95cb6d8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8415727\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699148}\n\n--\n\nwpt-commits: 59659655022114158b074145e5c8bc8115235f9e\nwpt-pr: 62748\n", "files": ["testing/web-platform/tests/css/css-values/calc-size/animation/calc-size-height-interpolation.html", "testing/web-platform/tests/css/css-values/calc-size/animation/calc-size-width-interpolation.html"], "git_node": "b04efc8624feb80405857c0564dbf6da80f08751", "git_parents": ["9f82005d83b983b9e53642d9963df8ed0aa213fd"], "node": "6df246c2c7585170d307f8591e40492a00f43ac6", "parents": ["441fbfefb132045dd4523576a00242d0b8c74d8a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072781 [wpt PR 62748] - Update wpt metadata, a=testonly\n\nwpt-pr: 62748\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/calc-size/animation/calc-size-height-interpolation.html.ini", "testing/web-platform/meta/css/css-values/calc-size/animation/calc-size-width-interpolation.html.ini"], "git_node": "d981d712410fd7bd72c8926a1f0ea10264391a27", "git_parents": ["b04efc8624feb80405857c0564dbf6da80f08751"], "node": "d1ac32196dc5d87ea9c51ac1290644f09a2214cd", "parents": ["6df246c2c7585170d307f8591e40492a00f43ac6"], "tags": []}, {"author": "Rahul Singh (EDGE) \u003crahsin@microsoft.com\u003e", "branch": "default", "desc": "Bug 2072473 [wpt PR 62726] - [SVG] [CSS-link-params] Add the link-parameters property, a=testonly\n\nAutomatic update from web-platform-tests\n[SVG] [CSS-link-params] Add the link-parameters property\n\nRegisters link-parameters behind an experimental runtime flag. Parses\nthe new property using the infrastructure from\nhttps://crrev.com/c/7930231. LinkParameters::ParseSingleValue() calls\nConsumeLinkParameters(), which produces a CSSValueList of\nCSSParamValuePair entries.\n\nFor declarations containing substitutions, ConsumeParam() returns\nnullptr. Blink's CSS substitution handling then resolves the\nsubstitutions and reparses the property.\n\nConvertLinkParameters() converts the resolved entries into a\nLinkParameterList for storage in ComputedStyle.\nCSSValueFromComputedStyleInternal() reconstructs the computed CSS value\nfor serialization. LinkParameterList preserves parameter order and\nduplicate names in computed-style serialization, as required by the\nspecification.\n\nBug: 41482962\nChange-Id: I51d6b60d7b9848fb1cb91ead4f8a7614b876c708\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8275329\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCommit-Queue: Rahul Singh \u003crahsin@microsoft.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699308}\n\n--\n\nwpt-commits: a73f7068e5d22d2a0681e2809de72bbeae832f17\nwpt-pr: 62726\n", "files": ["testing/web-platform/tests/css/css-link-params/link-parameters-computed.html", "testing/web-platform/tests/css/css-link-params/link-parameters-dynamic.html", "testing/web-platform/tests/css/css-link-params/link-parameters-no-interpolation.html"], "git_node": "49ccf6d3db67a071dd529359412a7c62b9e30a32", "git_parents": ["d981d712410fd7bd72c8926a1f0ea10264391a27"], "node": "1d00e74f8d3be38a089fbb0d4fca9924324e24a9", "parents": ["d1ac32196dc5d87ea9c51ac1290644f09a2214cd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072473 [wpt PR 62726] - Update wpt metadata, a=testonly\n\nwpt-pr: 62726\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-link-params/link-parameters-computed.html.ini"], "git_node": "c11f27a26470b9b6017bb97499780b639b0850cb", "git_parents": ["49ccf6d3db67a071dd529359412a7c62b9e30a32"], "node": "5dbc134b9d45bb6581b97ac8166f822e795ef6c4", "parents": ["1d00e74f8d3be38a089fbb0d4fca9924324e24a9"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2071568 [wpt PR 62645] - Correct viewport expectations inside symbols, a=testonly\n\nAutomatic update from web-platform-tests\nCorrect viewport expectations inside symbols\n\nAn uninstantiated symbol does not establish an SVG viewport. This fixture has no use element, so the viewportElement getter must skip the symbol and return the enclosing svg for both the group and the circle.\n\nhttps://svgwg.org/svg2-draft/types.html#__svg__SVGElement__viewportElement\nhttps://svgwg.org/svg2-draft/coords.html#EstablishingANewSVGViewport\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 2971340498805350babb6c167e0df98eaa380f98\nwpt-pr: 62645\n", "files": ["testing/web-platform/tests/svg/struct/scripted/element-symbol.html"], "git_node": "7154c35182ab4569c5c2cf8275b34acb6bfdde8e", "git_parents": ["c11f27a26470b9b6017bb97499780b639b0850cb"], "node": "07d5f345a96b4c505d80d3dfd77db40f61ed1e51", "parents": ["5dbc134b9d45bb6581b97ac8166f822e795ef6c4"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2072937 [wpt PR 62753] - Clamp profiler sample timestamps based on context isolation status, a=testonly\n\nAutomatic update from web-platform-tests\nClamp profiler sample timestamps based on context isolation status\n\nProfilerTraceBuilder::AddSample() previously converted sample timestamps\nusing a hardcoded cross_origin_isolated_capability parameter set to\ntrue. Consequently, sample timestamps received fine-resolution clamping\neven in contexts that were not cross-origin isolated.\n\nThis change updates ProfilerTraceBuilder::AddSample() to pass the\nbuilder's is_cross_origin_isolated_ member instead, ensuring timestamp\nresolution matches the execution context's actual isolation capability.\n\nTAG=agy\n\nBug: 511325076\nChange-Id: I0ac2aa2c63f7ba177db759784ddced0ac96c4433\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8416487\nReviewed-by: Kouhei Ueno \u003ckouhei@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699494}\n\n--\n\nwpt-commits: 87812b1aecbf4a2b892f540e077d9ac6fd90455c\nwpt-pr: 62753\n", "files": ["testing/web-platform/tests/js-self-profiling/time-domain.window.js"], "git_node": "4fe40c09a9abd4aadcb0a3c2132399214f404117", "git_parents": ["7154c35182ab4569c5c2cf8275b34acb6bfdde8e"], "node": "e3e48b62e1e6a9200ca069cdc7a7a22dc25e0fd6", "parents": ["07d5f345a96b4c505d80d3dfd77db40f61ed1e51"], "tags": []}, {"author": "Andreu Botella \u003cabotella@igalia.com\u003e", "branch": "default", "desc": "Bug 2072943 [wpt PR 62431] - [line-clamp] Clip floats inside line-clamp containers, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Clip floats inside line-clamp containers\n\nAs per https://github.com/w3c/csswg-drafts/issues/12665, floats\ninside a line-clamp container should be clipped to the container's\nbottom-end content edge. A previous CL, https://crrev.com/c/8138462,\nadded `PhysicalBoxFragment::IsLineClampClippedFloat` to mark such\nfloats.\n\nThis CL implements the actual clipping by adding a new clip node,\n`LineClampFloatClip`, which is set on clipped floats. To keep track of\nthe edge to clip at, we add a `line_clamp_float_clip_state` field to\n`PaintPropertyTreeBuilderFragmentContext::ContainingBlockContext`,\nstoring a clip rect and the transform active at the line-clamp\ncontainer. We populate this field in\n`FragmentPaintPropertyTreeBuilder::UpdateForSelf` when we reach a\nline-clamp container, and we clear it whenever we enter a new\nformatting context, since those floats won't be clipped to that\noffset.\n\nBug: 40336192, 445688004, 543371829\nChange-Id: I6d4e700efd3084af07b36c6a11653f9fba26c92a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8137283\nCommit-Queue: Andreu Botella \u003cabotella@igalia.com\u003e\nReviewed-by: Xianzhu Wang \u003cwangxianzhu@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1693387}\n\n--\n\nwpt-commits: 2b2a6a3ba5e395b50a16e4096b47b5a9ca6ef31f\nwpt-pr: 62431\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-with-floats-008.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-with-floats-009.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-with-floats-013.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-with-floats-014.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-with-floats-009-ref.html"], "git_node": "a513ae80d7fcf2ed9491068d877df6e7e41b5c6a", "git_parents": ["4fe40c09a9abd4aadcb0a3c2132399214f404117"], "node": "26659fccad8108a246926cbc453896da20eebafc", "parents": ["e3e48b62e1e6a9200ca069cdc7a7a22dc25e0fd6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072943 [wpt PR 62431] - Update wpt metadata, a=testonly\n\nwpt-pr: 62431\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-040-crash.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-008.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-009.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-013.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-014.html.ini"], "git_node": "f48099afa8f660dbf992612e4fe7332a3bba3a0b", "git_parents": ["a513ae80d7fcf2ed9491068d877df6e7e41b5c6a"], "node": "21fbf3ba781f83432248d06fd9804e30a98ae4a5", "parents": ["26659fccad8108a246926cbc453896da20eebafc"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2072947 [wpt PR 62710] - HTML: test negative zero dimension attributes, a=testonly\n\nAutomatic update from web-platform-tests\nHTML: test negative zero dimension attributes\n\nThe rules for parsing non-negative integers only reject a value that is\nless than zero, so \"-0\" and \"-0.5\" parse as 0 rather than being ignored.\n\nFollow-up to #61080.\n--\n\nwpt-commits: 8460f63e3a475ec53f46ebbf0cf7703694dcad89\nwpt-pr: 62710\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/width-height-attribute-parsing.html", "testing/web-platform/tests/html/semantics/forms/the-input-element/image-width-height.html"], "git_node": "867059f97b48095588e9a1ed60572a8c852217cb", "git_parents": ["f48099afa8f660dbf992612e4fe7332a3bba3a0b"], "node": "e95a5c3b5fa603a5027a4be44bcaec44ff82e5bd", "parents": ["21fbf3ba781f83432248d06fd9804e30a98ae4a5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072947 [wpt PR 62710] - Update wpt metadata, a=testonly\n\nwpt-pr: 62710\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-img-element/width-height-attribute-parsing.html.ini", "testing/web-platform/meta/html/semantics/forms/the-input-element/image-width-height.html.ini"], "git_node": "2dc60b66aee63f1e1c48b29e34b9fa6acbd9438a", "git_parents": ["867059f97b48095588e9a1ed60572a8c852217cb"], "node": "d14a1bb154cccfd10851c8059431dcaf2a2cdaf6", "parents": ["e95a5c3b5fa603a5027a4be44bcaec44ff82e5bd"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2072903 [wpt PR 62752] - Fix helper loading races in DOMParser URL tests, a=testonly\n\nAutomatic update from web-platform-tests\nFix helper loading races in DOMParser URL tests\n\nLoad the shared helper before creating the iframe whose load handler calls it. A fast iframe can finish loading while the parser is waiting for the external helper script, leaving the load handler without its callback.\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 7dbbcb8bcbf62683e6ac095da7d95a84b3672ab5\nwpt-pr: 62752\n", "files": ["testing/web-platform/tests/domparsing/DOMParser-parseFromString-url-base-pushstate.html", "testing/web-platform/tests/domparsing/DOMParser-parseFromString-url-base.html", "testing/web-platform/tests/domparsing/DOMParser-parseFromString-url-pushstate.html", "testing/web-platform/tests/domparsing/DOMParser-parseFromString-url.html"], "git_node": "f8034c939f9d58c847d6476c9c8c7cee73727e44", "git_parents": ["2dc60b66aee63f1e1c48b29e34b9fa6acbd9438a"], "node": "95c41f48bd3a0d889e4505abd3fe04422c3e7b71", "parents": ["d14a1bb154cccfd10851c8059431dcaf2a2cdaf6"], "tags": []}, {"author": "Manuel Rego Casasnovas \u003crego@igalia.com\u003e", "branch": "default", "desc": "Bug 2072606 [wpt PR 62585] - aamtests: Add support to test events, a=testonly\n\nAutomatic update from web-platform-tests\naamtests: Add support to test events\n\nThis patch adds a new expect_event() method, that allows testing events\nfired by the accessibility APIs.\n\nSo far this method is only implemented in AT-SPI wrapper.\n\nAdded a couple of example tests to show how to use this new method.\nNote that the test `event/aria_disabled.py` fails one of the checks\nin Firefox, as it never fires `object:state-changed:sensitive` event,\nonly `object:state-changed:enabled` (Chromium passes the test).\n\n--\n\nwpt-commits: 70e77b17cfe241905145a1dabe2351c88496913a\nwpt-pr: 62585\n", "files": ["testing/web-platform/tests/core-aam/aamtests/event/aria_checked.py", "testing/web-platform/tests/core-aam/aamtests/event/aria_disabled.py", "testing/web-platform/tests/core-aam/aamtests/support/api_wrapper.py", "testing/web-platform/tests/core-aam/aamtests/support/atspi_wrapper.py", "testing/web-platform/tests/core-aam/aamtests/support/axapi_wrapper.py", "testing/web-platform/tests/core-aam/aamtests/support/ia2_wrapper.py", "testing/web-platform/tests/core-aam/aamtests/support/uia_wrapper.py", "testing/web-platform/tests/docs/writing-tests/aamtest.md"], "git_node": "9dfa5cfe722ea06a8c6da8a64a506404f2771021", "git_parents": ["f8034c939f9d58c847d6476c9c8c7cee73727e44"], "node": "58e50b619a00d0648288229b1fd04f6162847614", "parents": ["95c41f48bd3a0d889e4505abd3fe04422c3e7b71"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072606 [wpt PR 62585] - Update wpt metadata, a=testonly\n\nwpt-pr: 62585\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/core-aam/aamtests/event/__dir__.ini", "testing/web-platform/meta/core-aam/aamtests/event/aria_checked.py.ini"], "git_node": "ab4ca0fac0a36513cfc827d0ef7734cb9ea7a616", "git_parents": ["9dfa5cfe722ea06a8c6da8a64a506404f2771021"], "node": "901bca2774c80e02e2a3725da0ae9d87690bfe3b", "parents": ["58e50b619a00d0648288229b1fd04f6162847614"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2065345 [wpt PR 62088] - [wdspec] Add missing BiDi `emulation` client command helpers, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Add `emulation.set_media_features_override` BiDi client command\n\n- Add `set_media_features_override` command helper to the WebDriver BiDi `Emulation` client module (`tools/webdriver/webdriver/bidi/modules/emulation.py`).\n\nSpec: https://w3c.github.io/webdriver-bidi/#command-emulation-setMediaFeaturesOverride\n\n--\n[wdspec] Add missing BiDi `emulation` client command helpers\n\n- Add `set_forced_colors_mode_theme_override`, `set_text_layout_mode_override`, and `set_viewport_meta_override` command helpers to the WebDriver BiDi `Emulation` client module (`tools/webdriver/webdriver/bidi/modules/emulation.py`).\n\nSpec: https://w3c.github.io/webdriver-bidi/#command-emulation-setForcedColorsModeThemeOverride\nSpec: https://w3c.github.io/webdriver-bidi/#command-emulation-setTextLayoutModeOverride\nSpec: https://w3c.github.io/webdriver-bidi/#command-emulation-setViewportMetaOverride\n\n--\n\nwpt-commits: 9018f6af953d5549e13c492107573b31f8d75e8c, dcddaafb1cf38b79aeabde6612139d3da68e3d88\nwpt-pr: 62088\n", "files": ["testing/web-platform/tests/tools/webdriver/webdriver/bidi/modules/emulation.py"], "git_node": "5be11d7d0057fae6077ee25f0daf0f18ce3d3e8c", "git_parents": ["ab4ca0fac0a36513cfc827d0ef7734cb9ea7a616"], "node": "d034c8b8be24f51048ebae0fd0ace3d31d73be11", "parents": ["901bca2774c80e02e2a3725da0ae9d87690bfe3b"], "tags": []}, {"author": "Yoshisto Yanagisawa \u003cyyanagisawa@chromium.org\u003e", "branch": "default", "desc": "Bug 2072761 [wpt PR 62746] - ServiceWorker: Propagate TAO check result via FetchAPIResponse, a=testonly\n\nAutomatic update from web-platform-tests\nServiceWorker: Propagate TAO check result via FetchAPIResponse\n\nWhen a ServiceWorker fetches a resource that undergoes HTTP redirects,\nthe TAO (Timing-Allow-Origin) check across the redirect chain is\nevaluated during the network fetch in the Service Worker context.\n\nPreviously, this timing allow check result was not preserved in\nFetchAPIResponse. Consequently, downstream ServiceWorker resource\nloaders (ServiceWorkerSubresourceLoader and\nServiceWorkerMainResourceLoader) could only evaluate the\nTiming-Allow-Origin header of the final response without accounting for\nwhether the initial or intermediate redirects passed the TAO check.\n\nThis CL adds a timing_allow_passed field to blink.mojom.FetchAPIResponse\nand propagates the check result from FetchResponseData to ensure\naccurate Timing-Allow-Origin handling consistent with the Fetch\nspecification.\n\nTAG=agy\nCONV=31d53e00-4937-4ac8-9798-3aa965f6e95e\n\nBug: 550666278\nChange-Id: I4fe2f49ed2eb23371820281c8f5831bbbc6c9683\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8294879\nCommit-Queue: Yoshisato Yanagisawa \u003cyyanagisawa@chromium.org\u003e\nReviewed-by: Takashi Toyoshima \u003ctoyoshim@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699547}\n\n--\n\nwpt-commits: 621a8a094ba6b33d34bc9425d489118b2180424c\nwpt-pr: 62746\n", "files": ["testing/web-platform/tests/service-workers/service-worker/resource-timing-cross-origin-server-timing.https.html", "testing/web-platform/tests/service-workers/service-worker/resources/resource-timing-server-timing-worker.js", "testing/web-platform/tests/service-workers/service-worker/resources/server-timing.py"], "git_node": "531bf09fc3d7c749a8a3cd3fe284dd897e991747", "git_parents": ["5be11d7d0057fae6077ee25f0daf0f18ce3d3e8c"], "node": "0ba94309c2b41d3daa5c86e92a054e34354298b3", "parents": ["d034c8b8be24f51048ebae0fd0ace3d31d73be11"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072761 [wpt PR 62746] - Update wpt metadata, a=testonly\n\nwpt-pr: 62746\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/service-workers/service-worker/detached-register-crash.https.html.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-audio-tainting.https.html.ini", "testing/web-platform/meta/service-workers/service-worker/navigation-redirect.https.html.ini", "testing/web-platform/meta/service-workers/service-worker/resource-timing-cross-origin-server-timing.https.html.ini"], "git_node": "8350980cb46147d04dd231eb0350f7240d57a9aa", "git_parents": ["531bf09fc3d7c749a8a3cd3fe284dd897e991747"], "node": "0eada862ac59531c05f282ef2dc7845d56bb8084", "parents": ["0ba94309c2b41d3daa5c86e92a054e34354298b3"], "tags": []}, {"author": "Byungwoo Lee \u003cblee@igalia.com\u003e", "branch": "default", "desc": "Bug 2072743 [wpt PR 62743] - Split content-security-policy/securitypolicyviolation/targeting.html, a=testonly\n\nAutomatic update from web-platform-tests\nSplit content-security-policy/securitypolicyviolation/targeting.html\n\ntargeting.html covers multiple securitypolicyviolation event targeting\ncases in a single async_test() using a long EventWatcher chain. A\nregression in any single step makes the whole file fail or time out,\nand it is hard to tell which case failed and why.\n\nSplit the test into multiple tests, each focused on a specific scenario,\nand add baselines for the cases that fail.\n\nOther browsers:\n- Firefox 154.0.1: all pass.\n- Safari 26.6.2: same failures as Chromium.\n\nBug: 559396684\nForce-WPT-Export: true\nChange-Id: If49c86742db77a423ee955e266f4f4979fc5e933\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8377681\nReviewed-by: Antonio Sartori \u003cantoniosartori@chromium.org\u003e\nCommit-Queue: Byungwoo Lee \u003cblee@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1699570}\n\n--\n\nwpt-commits: 2d2eadfb5fc9ada9a78f1dbe434bba0b31e8c176\nwpt-pr: 62743\n", "files": ["testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-connected-after-set.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-in-markup-disconnected-after-set.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-in-markup-then-disconnected.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-in-markup.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-in-shadow-dom.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-on-disconnected-element.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-on-element-in-disconnected-document-fragment.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-on-main-frame-element-moved-to-subframe.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-handler-on-subframe-element.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-script-without-nonce.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-style-in-shadow-dom.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting-for-inline-style.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/targeting.html"], "git_node": "a5131634c0a359134d7f6aaff7f3ed52eb616d9f", "git_parents": ["8350980cb46147d04dd231eb0350f7240d57a9aa"], "node": "a76bf5f0ac54354cd25f7978634c355931e21dd0", "parents": ["0eada862ac59531c05f282ef2dc7845d56bb8084"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072743 [wpt PR 62743] - Update wpt metadata, a=testonly\n\nwpt-pr: 62743\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/securitypolicyviolation/targeting.html.ini"], "git_node": "f4bdd30edbf728aed055405307daaac3aa5a303e", "git_parents": ["a5131634c0a359134d7f6aaff7f3ed52eb616d9f"], "node": "4ae170f4d08d8fd69f2e785e9acaf781cd1d9f1b", "parents": ["a76bf5f0ac54354cd25f7978634c355931e21dd0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072870 [wpt PR 62750] - [webdriver-wpt] Extend timeout for long-running BiDi and Classic tests, a=testonly\n\nAutomatic update from web-platform-tests\n[webdriver-wpt] Extend timeout for long-running BiDi and Classic tests\n\n- Add `# META: timeout=long` with explanatory comments to `wdspec` WPT\n  test files that time out due to high subtest volume, multi-profile\n  creation, or heavy navigation/network roundtrips.\n\nTAG=agy\nCONV=94b788e0-d0b5-477d-9209-e280abcc4037\n\nBug: 377833124\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,linux-rel,linux-blink-rel,linux_chromium_dbg_ng,android-15-x64-rel,mac-rel,mac14-blink-rel,win-rel,win11-blink-rel\nInclude-Ci-Only-Tests: true\nChange-Id: I74bb9373541b3822f0df44a5317ea0ca3aff9ab8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8407451\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1698956}\n\n--\n\nwpt-commits: 2aa0214e2055b1725beadcf496854ab65bbde02b\nwpt-pr: 62750\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browser/remove_user_context/user_context.py", "testing/web-platform/tests/webdriver/tests/bidi/browser/set_download_behavior/global.py", "testing/web-platform/tests/webdriver/tests/bidi/browser/set_download_behavior/user_context.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_created/context_created.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_created/original_opener.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_created/subscribe_steps.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_destroyed/context_destroyed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/fragment_navigated/fragment_navigated.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/get_tree/frames.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/handle_user_prompt/handle_user_prompt.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/history_updated/history_updated.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/locate_nodes/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/locate_nodes/locator.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigate/data_url.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigate/error.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigate/navigate.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigation_committed/navigation_committed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigation_failed/navigation_failed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigation_started/navigation_started.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/print/page.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/set_viewport/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/set_viewport/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/user_prompt_closed/user_prompt_closed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/user_prompt_opened/user_prompt_opened.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_geolocation_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_locale_override/locale.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_locale_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_network_conditions/network_conditions_offline.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_network_conditions/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_screen_settings_override/u