e.html", "browser/base/content/test/webrtc/get_user_media_in_xorigin_frame_ancestor.html", "browser/base/content/test/webrtc/gracePeriod/browser.toml", "browser/base/content/test/webrtc/head.js", "browser/base/content/test/webrtc/peerconnection_connect.html", "browser/base/content/test/webrtc/single_peerconnection.html", "browser/components/aiwindow/ui/components/aitab-page/aitab-shared.css", "dom/webgpu/tests/cts/checkout/.eslintrc.json", "gfx/2d/FontFeature.h", "gfx/2d/FontVariation.h", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationEndpointRaw.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpoint.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpointRawTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpointTest.kt", "mobile/android/android-components/components/service/pocket/src/test/resources/pocket/content_recommendations_null_url_response.json", "mobile/android/android-components/components/service/pocket/src/test/resources/pocket/content_recommendations_response.json", "taskcluster/scripts/misc/onnxruntime.patches/0001-Decrease-CMake-minimal-version-requirement.patch", "taskcluster/scripts/misc/onnxruntime.patches/0006-Separate-provider-compilation-from-its-archive-on-MS.patch"], "git_node": "383240b1c47fcbe804430e196a78f57abf4e1dfb", "git_parents": ["572cbc53633d3ed8a0b1390828611752f0317938", "88b81b9e07b77104608796db1f8479c915030ee6"], "node": "cf79615e8a61e80335dad220a126e81b1a08fd87", "parents": ["24b31c98c7b9663cc0c098ee2bb81a7047f7479f", "c68d29eb2646b8c2dde0f8bf558611489cc2035d"], "tags": []}], "date": 1789705301, "git_ch