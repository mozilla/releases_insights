s/dumps/main/top-sites.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "fcfb26d7c6a75e1c987cb2d687fc68509906b20e", "git_parents": ["aee5cb0fdb77ae062e1ba8a5169064588787032a"], "node": "dca5ddfc55b456c8db2b9078dcf51c1a2e9f9c43", "parents": ["ad59fc45b6fc336956c0d578fbb05a71ec406e53"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044905 - Move MediaCapabilities decoder support probing into PDMFactory::StrictSupportsAsync. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304788\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/PDMFactory.h"], "git_node": "39a7a6b364555cdbfc712dbf766c8e83dca22aac", "git_parents": ["fcfb26d7c6a75e1c987cb2d687fc68509906b20e"], "node": "cdd70b5fccbddda9e6c2218b76873f5a7074febd", "parents": ["dca5ddfc55b456c8db2b9078dcf51c1a2e9f9c43"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072109 - Disable New Tab background activity in ML perftests r=gregtatum\n\nThis commit ensures that the newtab code that is causing a perma-fail\nby attempting network access during unrelated ML perftests will not run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326289\n", "files": ["browser/components/genai/tests/browser/perftest.toml", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/perftest.toml", "browser/components/urlbar/tests/browser-ml/perftest.toml", "browser/extensions/formautofill/test/browser/performance/perftest.toml"], "git_node": "8d76a2ba4c3a730703578ac8f850a243cc3cda77", "git_parents": ["39a7a6b364555cdbfc712dbf766c8e83dca22aac"], "node": "83943a4ec5c46429ffd00e873a91a63da837e870", "parents": ["cdd70b5fccbddda9e6c2218b76873f5a7074febd"], "tags": []}], "date": 1789531882, "git_changesets": ["91e158697a7fb542cc858e9ec66