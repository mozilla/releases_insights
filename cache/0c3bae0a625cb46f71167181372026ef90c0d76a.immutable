: "b1db2f60c55192c2c9743c98d5f77c03fa7ba245", "parents": ["6c8c0684641aa15ab631a07f920c84b61a341c4e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044909 - Add PEMFactory::StrictSupportsAsync and strict WebRTC encode support path for MediaCapabilities. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309895\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h", "testing/gtest/mozilla/ScopedPrefSetter.h", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-webrtc-smooth.any.js.ini"], "git_node": "662a2f7034eedb28babba416d155e826b80872ae", "git_parents": ["d135288bc6195333190f8c924ebae4080f87c809"], "node": "05e1eb5275499997625eb3ccae8de37d91cb5fdf", "parents": ["b1db2f60c55192c2c9743c98d5f77c03fa7ba245"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044909 - Serialize MediaCapabilities encode-support probes through an encoder AllocPolicy. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\n\nGeneralize GlobalAllocPolicy and SingleAllocPolicy to encoders, mirroring how\nCheckVideoDecodingInfo serializes its strict decoder probes. Decoders and\nencoders are counted separately. PEMFactory::StrictSupportsAsync takes an\noptional AllocPolicy, allocates the probe encoder through it (or the global\nencoder policy) and holds the token until the encoder has shut down, so at most\none MediaCapabilities probe encoder exists at a time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324287\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/AllocationPolicy.cpp", "dom/media/platforms/AllocationPolicy.h", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h"], "git_node": "920a85e3498f68f7b80f322441002bba094c3915", "git_parents": ["662a2f7034eedb28babba416d155e826b80872ae"], "node": "1b8a3761fcf2011524d0541d483af365a906e5d1", "parents": ["05e1eb5275499997625eb3ccae8de37d91cb5fdf"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044909 - Serialize MediaCapabilities encode-support probes through an encoder AllocPolicy. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\" for causing build bustages at undefined symbols\n\nThis reverts commit 920a85e3498f68f7b80f322441002bba094c3915.\n\nRevert \"Bug 2044909 - Add PEMFactory::StrictSupportsAsync and strict WebRTC encode support path for MediaCapabilities. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\"\n\nThis reverts commit 662a2f7034eedb28babba416d155e826b80872ae.\n\nRevert \"Bug 2044909 - Add strict create-and-probe WebRTC decode support path for MediaCapabilities. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\"\n\nThis reverts commit d135288bc6195333190f8c924ebae4080f87c809.\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/AllocationPolicy.cpp", "dom/media/platforms/AllocationPolicy.h", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/webrtc/CodecIn