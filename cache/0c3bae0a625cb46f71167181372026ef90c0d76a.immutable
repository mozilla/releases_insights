form/tests/html/canvas/element/manual/draw-element-image/shadow-basic.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/shadow-dom-slot-canvas-child.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/shadow-dom-slotted-moveBefore.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/shadow-dom-slotted.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/shadow-non-opaque-element-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/shadow-non-opaque-element.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/svg-foreign-object.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/svg-rect.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/top-layer-not-painted-in-canvas.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/triple-nested-content-drawable-canvas.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/triple-nested-layoutsubtree-canvas.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/update-element-geometry-get-bounding-client-rect.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/video.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/animated-gif-worker.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/canvas-transform-update-worker.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/getElementTransform-worker.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/ink-overflow-worker.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/offscreenCanvas-drawElementImage-worker.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/offscreenCanvas-drawElementImage.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/scale-worker.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/video-worker.tentative.html"], "git_node": "0f3f94317bede38ad28b17f3f08e2158b4365bda", "git_parents": ["818a18fb011441a8114b78ef286dc27a8891720d"], "node": "32c9f5bbb17dc3036b1c40a50de0e0880241edce", "parents": ["3701c2d7c9fa5a74f0326c7c2ec09269d9a60810"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073410 [wpt PR 62772] - Update wpt metadata, a=testonly\n\nwpt-pr: 62772\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-get-set.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/moved-nested-content-drawable-canvas.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/moved-nested-layoutsubtree-canvas.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-content-drawable-canvas.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-div-content-drawable-canvas.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-div-layoutsubtree-canvas.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-layoutsubtree-canvas.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/onpaint.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/triple-nested-content-drawable-canvas.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/triple-nested-layoutsubtree-canvas.tentative.html.ini"], "git_node": "fd56d37e9cbec3b2c77dec70d491f52b3d98ee63", "git_parents": ["0f3f94317bede38ad28b17f3f08e2158b4365bda"], "node": "e03ac676575e4cee970c91aea7d84bb0414a9e9f", "parents": ["32c9f5bbb17dc3036b1c40a50de0e0880241edce"], "tags": []}, {"author": "Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e", "branch": "default", "desc": "Bug 2073414 [wpt PR 62771] - Reduce percentage-sizing-of-table-cell-* flakiness, a=testonly\n\nAutomatic update from web-platform-tests\nReduce percentage-sizing-of-table-cell-* flakiness\n\nThe `percentage-sizing-of-table-cell-replaced-children-001` and\n`percentage-sizing-of-table-cell-children-002` tests are the 2 consumers\nof `scrollbars.css`. They include this file with the intention of making\nthe pixel capture of the scrollbars stable (turning off default\nstyling), but the use of a `border-radius` leaves it subject to raster\ndifferences on the curved edges, resulting in slightly flaky tests.\n\nThis change drops the `border-radius` and also applies the standardized\n`scrollbar-color` (which overrides the `::-webkit` versions on browsers\nthat support it), leaving perfectly straight-edged scrollbars of a color\nnot currently being used in the test files. In privately-run repeat runs\nof these tests it increased success rates from 91/100 and 81/100, to\n100/100.\n\nThis does not impact the behaviors these tests are validating.\n\nThe Test History for both of these tests shows notable flakiness across\nplatforms:\n\nhttps://ci.chromium.org/ui/test/chromium/%3A%2F%2F%5C%3Aheadless_shell_wpt!webtest%3A%3Aexternal%2Fwpt%2Fcss%2Fcss-tables%2Fheight-distribution%23percentage-sizing-of-table-cell-replaced-children-001.html\n\nhttps://ci.chromium.org/ui/test/chromium/%3A%2F%2F%5C%3Aheadless_shell_wpt!webtest%3A%3Aexternal%2Fwpt%2Fcss%2Fcss-tables%2Fheight-distribution%23percentage-sizing-of-table-cell-children-002.html\n\nBug: 510232476\nChange-Id: If9a761dd78f615eec57814e2d41849918f881161\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8419404\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1700240}\n\n--\n\nwpt-commits: 4a9699f6142669fb0919ffe34244ae367b01a604\nwpt-pr: 62771\n", "files": ["testing/web-platform/tests/css/css-tables/height-distribution/support/scrollbars.css"], "git_node": "f421c4aa4a1816d88ab7b79eb9cc1210f57ae9ab", "git_parents": ["fd56d37e9cbec3b2c77dec70d491f52b3d98ee63"], "node": "79667ae7ec288edac6a23b9c5ca9f948fb2ee6ef", "parents": ["e03ac676575e4cee970c91aea7d84bb0414a9e9f"], "tags": []}, {"author": "Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e", "branch": "default", "desc": "Bug 2073415 [wpt PR 62780] - Reduce scroll-timeline-source-single-axis-viewport-writing-mode flakes, a=testonly\n\nAutomatic update from web-platform-tests\nReduce scroll-timeline-source-single-axis-viewport-writing-mode flakes\n\nThis test was using `waitForNextFrame` to wait for a style mutation to\nhave taken effect, but that is not guaranteed if the next frame was\nalready in progress. This change modifies the test to use\n`runAndWaitForFrameUpdate`, which waits for a completed frame, then\napplies the style change, and then waits for the next frame. This\nensures the style mutation should be included in that 'next frame'.\n\nPrivate repeat runs of this on Mac showed an improvement from 68/100\npassing to 100/100.\n\nTest History for this test shows regular flakiness on many Mac variants,\nand occassional flakiness on other platforms:\n\nhttps://ci.chromium.org/ui/test/chromium/%3A%2F%2F%5C%3Aheadless_shell_wpt!webtest%3A%3Aexternal%2Fwpt%2Fscroll-animations%2Fscroll-timelines%23scroll-timeline-source-single-axis-viewport-writing-mode.html\n\nBug: None\nChange-Id: I4c9a00e9db1181ca3bedb567a2d0d9a66f0ae7b2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8417508\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nReviewed-by: Olga Gerchikov \u003cgerchiko@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1700468}\n\n--\n\nwpt-commits: 8e678696c41c163b294e8a9267b57a0079dd1085\nwpt-pr: 62780\n", "files": ["testing/web-platform/tests/scroll-animations/scroll-timelines/scroll-timeline-source-single-axis-viewport-writing-mode.html"], "git_node": "21322a23e9b73d3ca0096b7baa9489408f5a8b76", "git_parents": ["f421c4aa4a1816d88ab7b79eb9cc1210f57ae9ab"], "node": "edbaf8c273993b2079440553a66dfea0e3ea489e", "parents": ["79667ae7ec288edac6a23b9c5ca9f948fb2ee6ef"], "tags": []}, {"author": "Stalgia Grigg \u003cstalgiag@igalia.com\u003e", "branch": "default", "desc": "Bug 2065455 [wpt PR 62103] - [testdriver] Add test_driver.create_window(), a=testonly\n\nAutomatic update from web-platform-tests\n[testdriver] Add test_driver.create_window()\n\nAdd a testdriver method matching the WebDriver classic New Window command that returns the new window's handle. This gives tests a top-level browsing context that is created as if the user opened it. This differs from the behavior of window.open.\n--\n\nwpt-commits: e63fcd53884b6202c5783d51c42a06b762bc1eed\nwpt-pr: 62103\n", "files": ["testing/web-platform/tests/docs/writing-tests/testdriver.md", "testing/web-platform/tests/infrastructure/testdriver/create_window.html", "testing/web-platform/tests/resources/testdriver.js", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/actions.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executormarionette.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executorselenium.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executorwebdriver.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/protocol.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/testdriver-extra.js"], "git_node": "2f0589ad64a1ccc2da03bd0e2b5e6b3893a7b088", "git_parents": ["21322a23e9b73d3ca0096b7baa9489408f5a8b76"], "node": "04444a61257b3b0b14046046f536c5b0b8ff4a9e", "parents": ["edbaf8c273993b2079440553a66dfea0e3ea489e"], "tags": []}, {"author": "Fran\u00e7ois Beaufort \u003cbeaufort.francois@gmail.com\u003e", "branch": "default", "desc": "Bug 2073348 [wpt PR 62767] - [WebMCP] Add debugging member in ToolAnnotations, a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Add debugging member in ToolAnnotations\n\nWhen a tool is registered with `debugging: true`, this annotation\nindicates that the tool is intended for debugging and developer\ntooling rather than end-user interactions.\n\nSpec PR: https://github.com/webmachinelearning/webmcp/pull/253\n\nBug: 489045948\nChange-Id: Ie80de3eccd61e9b8420a32e2deb4ab3e89301dee\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8398587\nReviewed-by: Philip Pfaffe \u003cpfaffe@chromium.org\u003e\nCommit-Queue: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1700568}\n\n--\n\nwpt-commits: 2699eaa2e5f906eda4d7443f7080c3de19e62365\nwpt-pr: 62767\n", "files": ["testing/web-platform/tests/webmcp/imperative/exposedTo-defaults-same-origin.https.html", "testing/web-platform/tests/webmcp/imperative/getTools-imperative-annotations.https.html", "testing/web-platform/tests/webmcp/imperative/resources/helpers.js"], "git_node": "33bc18edcee0de2e577a0a0e980f409ff77baf8b", "git_parents": ["2f0589ad64a1ccc2da03bd0e2b5e6b3893a7b088"], "node": "ed1f8a0743955d8590a0a8e407ea32d0298fcb6e", "parents": ["04444a61257b3b0b14046046f536c5b0b8ff4a9e"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2073503 [wpt PR 62792] - [wdspec] Add tests for emulation.setViewportMetaOverride, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Add tests for emulation.setViewportMetaOverride\n\n- Spec: https://w3c.github.io/webdriver-bidi/#commands-emulationsetviewportmetaoverride\n- Add WPT wdspec coverage for enabling (`viewportMeta: true`) and\n  resetting (`viewportMeta: null`) viewport meta tag parsing.\n- Verify browsing context (`contexts`), user context (`userContexts`),\n  and global scoping, isolation, and override precedence.\n- Add parameter and scope validation tests for invalid types and values.\n\nTAG=agy\nCONV=b8f67bbe-1380-44b8-8641-53e4b2d2cafa\n\nBug: 470318350\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,mac-webdriver-bidi-rel,win-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: Ib2fdd276a6ce2f2923deefb200364a848a691eb0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8422926\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1700657}\n\n--\n\nwpt-commits: d910cc283a04297f31d5dce191c3dd487f0c856a\nwpt-pr: 62792\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/emulation/set_viewport_meta_override/__init__.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_viewport_meta_override/conftest.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_viewport_meta_override/contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_viewport_meta_override/global.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_viewport_meta_override/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_viewport_meta_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_viewport_meta_override/viewport_meta.py"], "git_node": "a02707758a791157a447d5734d5548a772076841", "git_parents": ["33bc18edcee0de2e577a0a0e980f409ff77baf8b"], "node": "de9dd1c0587c361862dea501ec9c0eb7066464c2", "parents": ["ed1f8a0743955d8590a0a8e407ea32d0298fcb6e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073503 [wpt PR 62792] - Update wpt metadata, a=testonly\n\nwpt-pr: 62792\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/emulation/set_viewport_meta_override/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_viewport_meta_override/global.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_viewport_meta_override/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_viewport_meta_override/user_contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_viewport_meta_override/viewport_meta.py.ini"], "git_node": "188c5f18bcb501b9f3d999e758263a457f57aeaa", "git_parents": ["a02707758a791157a447d5734d5548a772076841"], "node": "98734d818b139774a03bf0b0b0fa3acc6e179c7e", "parents": ["de9dd1c0587c361862dea501ec9c0eb7066464c2"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2073552 [wpt PR 62788] - [webauthn] Test that BufferSource members reject shared buffers, a=testonly\n\nAutomatic update from web-platform-tests\nWebAuthn: test that BufferSource members reject shared buffers\n--\n\nwpt-commits: 8e1827834c9bc9a458f10cf6706de7a7be88da58\nwpt-pr: 62788\n", "files": ["testing/web-platform/tests/webauthn/createcredential-badargs-sharedarraybuffer.https.html", "testing/web-platform/tests/webauthn/getcredential-badargs-sharedarraybuffer.https.html"], "git_node": "3d5d5ecfc20685543dc3e8bf1b3d0acabe7e7a83", "git_parents": ["188c5f18bcb501b9f3d999e758263a457f57aeaa"], "node": "c21a89aba43fb96c137fbd0897f281be3f66bc08", "parents": ["98734d818b139774a03bf0b0b0fa3acc6e179c7e"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2073520 [wpt PR 62793] - Test that BufferSource arguments reject shared buffers, a=testonly\n\nAutomatic update from web-platform-tests\nTest that BufferSource arguments reject shared buffers\n\nBufferSource in Media Source Extensions, Web Cryptography, Encrypted Media Extensions, and WebTransport is not [AllowShared].\n\n--\n\nwpt-commits: a6a0a0292a4706866328488ffaaace00400edcc6\nwpt-pr: 62793\n", "files": ["testing/web-platform/tests/WebCryptoAPI/sharedarraybuffer.https.any.js", "testing/web-platform/tests/encrypted-media/clearkey-sharedarraybuffer.https.window.js", "testing/web-platform/tests/media-source/mediasource-appendbuffer-sharedarraybuffer.window.js", "testing/web-platform/tests/webtransport/constructor-sharedarraybuffer.https.any.js"], "git_node": "0557ccaaca1629030fecab2342209cc223c56c0c", "git_parents": ["3d5d5ecfc20685543dc3e8bf1b3d0acabe7e7a83"], "node": "feff9747ee092ec4afa9341146b2c446bbb00853", "parents": ["c21a89aba43fb96c137fbd0897f281be3f66bc08"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073520 [wpt PR 62793] - Update wpt metadata, a=testonly\n\nwpt-pr: 62793\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/WebCryptoAPI/sharedarraybuffer.https.any.js.ini"], "git_node": "2f52a8e566425942f0c933666f82b9b28d4a729b", "git_parents": ["0557ccaaca1629030fecab2342209cc223c56c0c"], "node": "f580d97812e782c01a6a6a3407e4da286e447e1d", "parents": ["feff9747ee092ec4afa9341146b2c446bbb00853"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2073509 [wpt PR 62778] - [js-self-profiling] Filter stack frames on the script's muted errors, a=testonly\n\nAutomatic update from web-platform-tests\n[js-self-profiling] Filter stack frames on the script's muted errors\n\nProfilerTraceBuilder::ShouldIncludeStackFrame() included a frame if\nv8::CpuProfileNode::IsScriptSharedCrossOrigin() was true, or, as a\nfallback, if the origin of GetScriptResourceNameStr() was same-origin\nwith allowed_origin_. GetScriptResourceNameStr() holds the initial\npre-redirect request URL, so a classic script requested from a\nsame-origin URL that redirected to a cross-origin response without CORS\nsatisfied the fallback, exposing its function names and source locations\nin the trace.\n\nDrop the fallback and decide inclusion on IsScriptSharedCrossOrigin()\nalone, which is the inverse of the script's muted-errors state. This\nmatches step 7 of the \"get a frame ID\" algorithm in the JS\nSelf-Profiling specification, and it derives from the response rather\nthan the request: true for same-origin classic scripts, CORS-enabled\ncross-origin scripts, inline scripts, and module scripts, and false for\nopaque no-cors responses no matter how the request got there. Traces no\nlonger describe scripts that already report \"Script error.\" to\nwindow.onerror.\n\nKeep the guard that omits frames whose script has no parseable resource\nname, such as eval() and new Function(). The specification includes\nthose frames, and they expose nothing opaque, as V8 propagates\nis_shared_cross_origin to eval()ed scripts and defaults it to false for\nentries that have no script. Including them would newly emit frames that\ncarry a line and column but no resource, which consumers have never\nseen.\n\nWith the fallback gone, nothing needs the profiling context's origin.\nRemove Profiler::source_origin_, Profiler::SourceOrigin(),\nProfilerTraceBuilder::allowed_origin_, and the GetSecurityOrigin() call\nin ProfilerGroup::CreateProfiler(). Rename script_same_origin_cache_ to\nscript_inclusion_cache_, as it now caches the whole decision rather than\na same-origin check.\n\nAdd cross-origin-script-redirect-no-cors.sub.html, which fails before\nthis change and passes after it.\n\nBug: 511311494\nChange-Id: If605837e57a7084729930d7acec982a28bd785eb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8409345\nReviewed-by: Kouhei Ueno \u003ckouhei@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nReviewed-by: Michal Mocny \u003cmmocny@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1700662}\n\n--\n\nwpt-commits: 63ad90940cc1688ebf4eef84a182965ea464f2d0\nwpt-pr: 62778\n", "files": ["testing/web-platform/tests/js-self-profiling/cross-origin-script-redirect-no-cors.sub.html"], "git_node": "c5ac69f0c59c192fe234f410f8bf23657d9d7c49", "git_parents": ["2f52a8e566425942f0c933666f82b9b28d4a729b"], "node": "d698ee7f71029cafb464d37f5d74d44a97b31479", "parents": ["f580d97812e782c01a6a6a3407e4da286e447e1d"], "tags": []}, {"author": "Dominik R\u00f6ttsches \u003cdrott@chromium.org\u003e", "branch": "default", "desc": "Bug 2073541 [wpt PR 62796] - Accept BOM at start of parsing input in Rust XML parser, a=testonly\n\nAutomatic update from web-platform-tests\nAccept BOM at start of parsing input in Rust XML parser\n\nFix BOM handling in Rust XML parser by stripping it from the\nbeginning of the input string.\n\nAdd a Web Platform Test covering DOMParser parsing of XML documents\nstarting with a Byte Order Mark (U+FEFF). Under the experimental Rust\nXML parser (XmlRustForNonXslt), leading BOM characters currently fail\nparsing as unexpected characters outside the root element.\n\nFixed: 561655168\nChange-Id: I519666eca927d44d76827996e29db99ae9e0005f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8425943\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nAuto-Submit: Dominik R\u00f6ttsches \u003cdrott@chromium.org\u003e\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1700711}\n\n--\n\nwpt-commits: 67dfbc1e15e58754a78332e2ba518711d0b7731d\nwpt-pr: 62796\n", "files": ["testing/web-platform/tests/xml/xml-bom.html"], "git_node": "9c850473de9a6addeb5cc476f7589ccd695619bb", "git_parents": ["c5ac69f0c59c192fe234f410f8bf23657d9d7c49"], "node": "364a494e26b3c8349149436642a3c245b127e082", "parents": ["d698ee7f71029cafb464d37f5d74d44a97b31479"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073541 [wpt PR 62796] - Update wpt metadata, a=testonly\n\nwpt-pr: 62796\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/xml/xml-doc-innerHTML-crash.html.ini", "testing/web-platform/meta/xml/xslt/invalid-output-encoding-crash.html.ini"], "git_node": "4facd8683d8f1b09c962582cb9799df97a44f9f0", "git_parents": ["9c850473de9a6addeb5cc476f7589ccd695619bb"], "node": "daf229eca9e2e063d7a402c8ae40e8d7749c77c9", "parents": ["364a494e26b3c8349149436642a3c245b127e082"], "tags": []}, {"author": "Sky Debreuil \u003cskydebreuil@google.com\u003e", "branch": "default", "desc": "Bug 2073562 [wpt PR 62797] - [css-overflow] Add WPT crashtest for scroll-marker-group position change, a=testonly\n\nAutomatic update from web-platform-tests\n[css-overflow] Add WPT crashtest for scroll-marker-group position change\n\nChanging `scroll-marker-group` from `before` to `after` on a scroll\ncontainer with descendant `::scroll-marker` pseudo-elements triggers\na `DCHECK(!GetLayoutObject())` failure in\n`PseudoElement::AttachLayoutTree()`.\n\nAdd a WPT crashtest for this case and mark it as an expected crash in\n`TestExpectations` until the fix lands in a follow-up CL.\n\nBug: 500793607\nChange-Id: I0b9b2c66560b43fdbbac72ce84a8fb915994eb30\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8406166\nCommit-Queue: Sky Debreuil \u003cskydebreuil@google.com\u003e\nReviewed-by: Free Debreuil \u003cfreedebreuil@google.com\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1700740}\n\n--\n\nwpt-commits: 4357f9f6f7fd8d7c09f7188a1d540b466790cab9\nwpt-pr: 62797\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-group-position-change-crash.html"], "git_node": "4c7c82091c2d1d7b5072c00ac4aac35739b08c0d", "git_parents": ["4facd8683d8f1b09c962582cb9799df97a44f9f0"], "node": "7f11e797bb8dd911b4337f27764db50505ab42da", "parents": ["daf229eca9e2e063d7a402c8ae40e8d7749c77c9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073562 [wpt PR 62797] - Update wpt metadata, a=testonly\n\nwpt-pr: 62797\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/chrome-421199213-crash.html.ini"], "git_node": "6daa8c6636f3e47ab33d4a1a9b00055808343f11", "git_parents": ["4c7c82091c2d1d7b5072c00ac4aac35739b08c0d"], "node": "9e7497b2467e15e7ff2fd87bf12cfa653d719206", "parents": ["7f11e797bb8dd911b4337f27764db50505ab42da"], "tags": []}, {"author": "Stefan Zager \u003cszager@chromium.org\u003e", "branch": "default", "desc": "Bug 2073594 [wpt PR 62775] - [HiC] Correctly apply canvas scaling to ElementImage.(width|height), a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Correctly apply canvas scaling to ElementImage.(width|height)\n\nThis makes the width and height values equal to the internal default\nvalues for the dwidth and dheight parameters to drawElementImage, which\nobey the invariant: drawElementImage with default dwidth/dheight and no\ntransform applied to the canvas context should draw the element with the\nsame on-screen proportions as it would appear were the element placed\noutside the canvas with identical computed style.\n\nBug: 456097302\nChange-Id: I3b268ea39a94e8b8236f685f8fd5916404863c26\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8423113\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1700809}\n\n--\n\nwpt-commits: 47f500f1d743ddc40312992fad5788d4ddb4688d\nwpt-pr: 62775\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/captureElementImage.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/element-image-fractional-size.tentative.html"], "git_node": "bf11e3a36bc50244b17f46cc6764d85822095558", "git_parents": ["6daa8c6636f3e47ab33d4a1a9b00055808343f11"], "node": "d50ee2cb5a6a714937e34928a60e3e61950c1d83", "parents": ["9e7497b2467e15e7ff2fd87bf12cfa653d719206"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073594 [wpt PR 62775] - Update wpt metadata, a=testonly\n\nwpt-pr: 62775\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/captureElementImage.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/element-image-fractional-size.tentative.html.ini"], "git_node": "5647909205c117ba54cfda8e5555eaa37bd0e6c7", "git_parents": ["bf11e3a36bc50244b17f46cc6764d85822095558"], "node": "7e09280c882eab70a5a3a36c9ba29501b96d1401", "parents": ["d50ee2cb5a6a714937e34928a60e3e61950c1d83"], "tags": []}, {"author": "github-actions[bot] \u003c41898282+github-actions[bot]@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071569 [wpt PR 62646] - Regenerate WPT certificates, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated regeneration of WPT certificates (#62646)\n\nCo-authored-by: wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e\n--\n\nwpt-commits: 79076f519d81e0c5d51298127d05e55b129a7498\nwpt-pr: 62646\n", "files": ["testing/web-platform/tests/tools/certs/cacert.key", "testing/web-platform/tests/tools/certs/cacert.pem", "testing/web-platform/tests/tools/certs/web-platform.test.key", "testing/web-platform/tests/tools/certs/web-platform.test.pem", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/chrome_spki_certs.py"], "git_node": "176ee32cfd4eb3dea4c680578c3ecd8440caf683", "git_parents": ["5647909205c117ba54cfda8e5555eaa37bd0e6c7"], "node": "4f36009da5c86e73e8491414302cb1bb7a3c52e2", "parents": ["7e09280c882eab70a5a3a36c9ba29501b96d1401"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2073635 [wpt PR 62785] - [svg] Add WPT coverage for style invalidation after independent updates, a=testonly\n\nAutomatic update from web-platform-tests\n[svg] Add WPT coverage for style invalidation after independent updates\n\nThere are a few SVG CSS performance improvements in flight that cause\nregressions that weren't caught by existing WPT's. See\nhttps://crrev.com/c/8142587 and https://crrev.com/c/8225006.\n\nThis change addresses that gap. In particular, these tests cover cases\nwhere the SVGLength values impact CSS selectors matching.\n\nopacity-text-decoration.html needs a reftests because SVG text\ndecorations from an ancestor \u003cg\u003e don't propagate to computed style.\n\nChange-Id: I736bb74bf7f57f141da0b46693d9145ca74d9a86\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8421166\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1700874}\n\n--\n\nwpt-commits: 5069718f4ced035ca5694a009e0c3fbdbc6ee359\nwpt-pr: 62785\n", "files": ["testing/web-platform/tests/svg/styling/invalidation/attribute-style-invalidation.html", "testing/web-platform/tests/svg/styling/invalidation/opacity-style-invalidation.html", "testing/web-platform/tests/svg/styling/render/opacity-text-decoration-ref.html", "testing/web-platform/tests/svg/styling/render/opacity-text-decoration.html"], "git_node": "a05aa003219b90f053e976d12c1c3cd70ce68565", "git_parents": ["176ee32cfd4eb3dea4c680578c3ecd8440caf683"], "node": "fcd45e95ceec4da022da69bad500a838af1da219", "parents": ["4f36009da5c86e73e8491414302cb1bb7a3c52e2"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2073588 [wpt PR 62798] - Fix attachment order of succeeding layout pseudo-elements, a=testonly\n\nAutomatic update from web-platform-tests\nFix attachment order of succeeding layout pseudo-elements\n\nMove AttachLayoutSucceedingPseudoElements to run after children are\nattached and previous_in_flow is updated. This ensures succeeding\nlayout pseudo-elements (such as ::interest-button and scroll buttons)\nare attached after children when the originating element has display:\ncontents.\n\nPlacing this before LeaveObject on counters_context also preserves the\noriginating element's counter scope for these pseudo-elements. Also add\na null check for the group box in\nScrollMarkerPseudoElement::AttachLayoutTree.\n\nBug: 453705247,544157272\nChange-Id: I250785daab61ca6c3016b75dbc42e64ff1463aa3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8383996\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1700908}\n\n--\n\nwpt-commits: d5da07faf2f8b5593c0f0f8e0063fab47d77f68c\nwpt-pr: 62798\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-buttons-contents-appearance-ref.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-buttons-contents-appearance.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-buttons-counter-appearance-ref.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-buttons-counter-appearance.html"], "git_node": "1c1e999101bd82591c49249db5f8221f38b0f3dc", "git_parents": ["a05aa003219b90f053e976d12c1c3cd70ce68565"], "node": "8de29346afb88f8341f228cb09a0d44afb6639a0", "parents": ["fcd45e95ceec4da022da69bad500a838af1da219"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073588 [wpt PR 62798] - Update wpt metadata, a=testonly\n\nwpt-pr: 62798\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-buttons-contents-appearance.html.ini", "testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-buttons-counter-appearance.html.ini"], "git_node": "bc351d1ae7e84bc33cac9c944380b6c35033b0fc", "git_parents": ["1c1e999101bd82591c49249db5f8221f38b0f3dc"], "node": "4e5f6fdff2a5568cf5bff445d8bc285908e29530", "parents": ["8de29346afb88f8341f228cb09a0d44afb6639a0"], "tags": []}, {"author": "David Grogan \u003cdgrogan@chromium.org\u003e", "branch": "default", "desc": "Bug 2073701 [wpt PR 62802] - [menu a11y] Rename dialog mode to violation mode, a=testonly\n\nAutomatic update from web-platform-tests\n[menu a11y] Rename dialog mode to violation mode\n\nWe keep a flag to indicate that a menu hierarchy's content model is\nviolated. We'd named that state \"dialog mode\" because a violated menu\nwas originally exposed with the dialog ARIA role. That name no longer\ndescribes the state: submenus already map to list rather than dialog,\nand the mapping is expected to keep changing while we gather screen\nreader feedback.\n\nSo this CL renames \"dialog mode\" to \"violation mode\".\n\n\u003cselect\u003e still has \"dialog mode\" though, because that name is still\naccurate there.\n\nNo behavior change intended.\n\nBug: 425682466\nChange-Id: Id8c939ff0aea9f833492df88d7d7acabeefaf09c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8428084\nAuto-Submit: David Grogan \u003cdgrogan@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCommit-Queue: David Grogan \u003cdgrogan@chromium.org\u003e\nReviewed-by: Chris Harrelson \u003cchrishtr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1701079}\n\n--\n\nwpt-commits: 27bd32456d9551ac2920302a4fdba7a8ca5f107b\nwpt-pr: 62802\n", "files": ["testing/web-platform/tests/html/semantics/menu/tentative/menu-dialog-mode-focus.html", "testing/web-platform/tests/html/semantics/menu/tentative/menu-violation-mode-focus.html", "testing/web-platform/tests/html/semantics/menu/tentative/reparent-with-pending-dialog-microtask.html", "testing/web-platform/tests/html/semantics/menu/tentative/reparent-with-pending-violation-microtask.html"], "git_node": "db3850c44192d32f0a56ed4074167fe4b2a0a9be", "git_parents": ["bc351d1ae7e84bc33cac9c944380b6c35033b0fc"], "node": "fcea6228512239e17028f351128480958c0aa592", "parents": ["4e5f6fdff2a5568cf5bff445d8bc285908e29530"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073701 [wpt PR 62802] - Update wpt metadata, a=testonly\n\nwpt-pr: 62802\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/menu/tentative/menu-dialog-mode-focus.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/menu-violation-mode-focus.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/reparent-with-pending-dialog-microtask.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/reparent-with-pending-violation-microtask.html.ini"], "git_node": "c9f82d753faf4b6fdaf8fe61ab1d88fcec893e9d", "git_parents": ["db3850c44192d32f0a56ed4074167fe4b2a0a9be"], "node": "611c8d23de16ad4715c4dc7ea6297cb45413f55c", "parents": ["fcea6228512239e17028f351128480958c0aa592"], "tags": []}, {"author": "Ningxin Hu \u003cningxin.hu@intel.com\u003e", "branch": "default", "desc": "Bug 2073743 [wpt PR 62805] - webnn: Emit a single-input concat as an identity for LiteRT, a=testonly\n\nAutomatic update from web-platform-tests\nwebnn: Emit a single-input concat as an identity for LiteRT\n\nA concat with one input is an identity, but it was still serialized as\nCONCATENATION. That may cause ML Drift to emit a wrong shader and fail\nto compile (GraphFloat32 path) or reject and fall back to CPU (IrModel\npath).\n\nEmit SerializeIdentityOperation instead. That helper elides an\nintermediate identity without creating a TFLite operator, so make the\nelision explicit rather than returning a null OperatorOffset: it now\nreturns base::expected\u003cstd::optional\u003cOperatorOffset\u003e, std::string\u003e, the\noptional is propagated through SerializeConcat,\nSerializeElementWiseUnary and SerializeReverse, and SerializeOperation\nappends an operator only when one was created.\n\nAlso add a WPT conformance test for it.\n\nBug: 562999372\nChange-Id: I565124f75b42813897052725e7ae4c123c82cfb3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8422780\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nCommit-Queue: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nCr-Commit-Position: refs/heads/main@{#1701120}\n\n--\n\nwpt-commits: 0ff799bc838683c7f865e10928909b8938108e82\nwpt-pr: 62805\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/concat.https.any.js"], "git_node": "434fcc24e793bcaf8a5a4b987be43fd33c69f6c0", "git_parents": ["c9f82d753faf4b6fdaf8fe61ab1d88fcec893e9d"], "node": "a77c230dacc8bbd0b174cda6e7548d8cc13d2f92", "parents": ["611c8d23de16ad4715c4dc7ea6297cb45413f55c"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2073671 [wpt PR 62799] - [html-in-canvas] Add support for hit test clip rect, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Add support for hit test clip rect\n\nThis patch adds support for a hit test clip rect. It adds a 2d rect to\n`UpdateElementGeometryOptions`, and automatically sets it based on the\nsrc rect parameters when using `drawElementImage` with default options.\nFloatClipRect is used which supports an infinite clip rect for the\nno-clip state, so the code largely mirrors the canvas transform code.\nSimilar to CSS clip-path, the canvas clip affects hit testing,\nincluding APIs like `elementsFromPoint`, but does not affect geometry\nAPIs like `getBoundingClientRect`. In the future we may support\nexpanding this clip to be a path and to include the current context's\nclip, but for now it is only set based on the src rect parameters.\n\nFixed: 556756510\nChange-Id: I2f12309991a2ca999193220543d1e270a72735d5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8413537\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1701151}\n\n--\n\nwpt-commits: bd79340c7a124a592c165ccad61be5223f35ed79\nwpt-pr: 62799\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry-offscreen.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/update-element-geometry-get-bounding-client-rect.tentative.html"], "git_node": "47d04900fa9255afc1931d7b403ec9ad47909067", "git_parents": ["434fcc24e793bcaf8a5a4b987be43fd33c69f6c0"], "node": "3cad0818a39a724d14659b2a762be8cd9f21659a", "parents": ["a77c230dacc8bbd0b174cda6e7548d8cc13d2f92"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073671 [wpt PR 62799] - Update wpt metadata, a=testonly\n\nwpt-pr: 62799\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry-offscreen.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/update-element-geometry-get-bounding-client-rect.tentative.html.ini"], "git_node": "0ad5d006ab2d79be1517bc6a8fb3e13a18e4ddea", "git_parents": ["47d04900fa9255afc1931d7b403ec9ad47909067"], "node": "54d59c0d95735e1a0a8d5c632a18f27c809c7f5a", "parents": ["3cad0818a39a724d14659b2a762be8cd9f21659a"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2073751 [wpt PR 62806] - Fix shadow root leak from beforeinput event, a=testonly\n\nAutomatic update from web-platform-tests\nFix shadow root leak from beforeinput event\n\nThe nodes returned in beforeinput event's getTargetRanges() method was\nnot doing retargeting and could leak shadow nodes. This patch fixes that\nby doing retargeting.\n\nfast/events/inputevents/inputevent-transpose.html was updated because\nthe first subtest left a beforeinput listener on document that relied on\n\u003ctextarea\u003e's internal UA shadow root nodes being leaked via\ngetTargetRanges() when the second subtest ran.\n\nFixed: 553390794\nChange-Id: Ib774191fef0c54e3f14f649f37f40c87f22c7bf4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8400446\nAuto-Submit: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1701270}\n\n--\n\nwpt-commits: 4de146b83e2423af3c92e0d46705ebb956e4071c\nwpt-pr: 62806\n", "files": ["testing/web-platform/tests/input-events/input-events-get-target-ranges-shadow-dom.html"], "git_node": "57494c1c9ab4dba04a7ffd32346e9f9fa5569cf2", "git_parents": ["0ad5d006ab2d79be1517bc6a8fb3e13a18e4ddea"], "node": "88bb20151cc01b54277b1b0ff5318c3c7f72fb07", "parents": ["54d59c0d95735e1a0a8d5c632a18f27c809c7f5a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073751 [wpt PR 62806] - Update wpt metadata, a=testonly\n\nwpt-pr: 62806\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/input-events/input-events-get-target-ranges-shadow-dom.html.ini"], "git_node": "973a191cb3ff006e779e1abd9a92a6db0dc7340b", "git_parents": ["57494c1c9ab4dba04a7ffd32346e9f9fa5569cf2"], "node": "9c2eebf691eaed3667015130d70e275a52717cb6", "parents": ["88bb20151cc01b54277b1b0ff5318c3c7f72fb07"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2073763 [wpt PR 62813] - Test constructor as a non-special URL scheme, a=testonly\n\nAutomatic update from web-platform-tests\nTest constructor as a non-special URL scheme\n\nAdd parsing cases for the non-special `constructor` scheme with an opaque path, a hierarchical path without a host, and an opaque host with a port and an empty path.\n\nThis catches JavaScript implementations that accidentally inherit the `constructor` property when looking up special schemes in an object, as in https://github.com/jsdom/whatwg-url/pull/342.\n\nCo-Authored-By: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: c48d58747e1f211527fb695fd60548a997fae617\nwpt-pr: 62813\n", "files": ["testing/web-platform/tests/url/resources/urltestdata.json"], "git_node": "ad599b6db814b3d7f185eacfbeae36f2850747b0", "git_parents": ["973a191cb3ff006e779e1abd9a92a6db0dc7340b"], "node": "c1b74a335b80f437b4af5ec6d009eb763c279603", "parents": ["9c2eebf691eaed3667015130d70e275a52717cb6"], "tags": []}, {"author": "github-actions[bot] \u003c41898282+github-actions[bot]@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2073334 [wpt PR 62766] - Sync interfaces/ with @webref/idl 3.84.0, a=testonly\n\nAutomatic update from web-platform-tests\nSync interfaces/ with @webref/idl 3.84.0 (#62766)\n\nCo-authored-by: wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e\n--\n\nwpt-commits: b993d8dca9bc5a2e504bafdc34e0f2754c2e31b9\nwpt-pr: 62766\n", "files": ["testing/web-platform/tests/interfaces/SVG.idl", "testing/web-platform/tests/interfaces/animation-triggers.idl", "testing/web-platform/tests/interfaces/container-timing.idl", "testing/web-platform/tests/interfaces/html.idl", "testing/web-platform/tests/interfaces/install-element.idl", "testing/web-platform/tests/interfaces/serial.idl", "testing/web-platform/tests/interfaces/speech-api.idl", "testing/web-platform/tests/interfaces/web-animations-2.idl", "testing/we