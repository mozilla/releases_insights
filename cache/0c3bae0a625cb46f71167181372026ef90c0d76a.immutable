8096"], "node": "19f246c7db0b8b585f687adc9f776b872e51c320", "parents": ["04907667bb5075f611b47f7e453b6fc9fd6e32fa"], "tags": []}, {"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "default", "desc": "Bug 2052994 - Persist stream name in PlaybackParams r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324528\n", "files": ["dom/media/gtest/TestAudioSinkWrapper.cpp", "dom/media/mediasink/AudioSink.cpp", "dom/media/mediasink/AudioSink.h", "dom/media/mediasink/AudioSinkWrapper.cpp"], "git_node": "c006f31e97e32c51a0b7016b342f8a371b56fabe", "git_parents": ["0c909aeeca8cb433f64d28252a5965cc2b12713c"], "node": "2d31150799852715da389e5c174456879854b44c", "parents": ["19f246c7db0b8b585f687adc9f776b872e51c320"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070977 - add hashes arg to the openNewtab function r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325053\n", "files": ["browser/components/uitour/UITour-lib.js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_showNewTab.js"], "git_node": "c7f4c2a16cc1373e34d5182a835665aeebaddb3d", "git_parents": ["c006f31e97e32c51a0b7016b342f8a371b56fabe"], "node": "f8ecd20a273797eb154a73d187d4a056901575cb", "parents": ["2d31150799852715da389e5c174456879854b44c"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2071780 - fix(webgpu): add `rustfmt.toml` with `edition = \"2021\"` to `wgpu_bindings` r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325777\n", "files": ["gfx/wgpu_bindings/rustfmt.toml"], "git_node": "9c94c5b31ed045e91e29b4cd7f80c799e7b8d1ee", "git_parents": ["c7f4c2a16cc1373e34d5182a835665aeebaddb3d"], "node": "a11984cb6866f9f5ee2b0fb81b311a2998d7da26", "parents": ["f8ecd20a273797eb154a73d187d4a056901575cb"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068765 - Part 1: Parser for Declarative Web Push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323282\n", "files": ["Cargo.lock", "dom/push/moz.build", "dom/push/rust/Cargo.toml", "dom/push/rust/cbindgen.toml", "dom/push/rust/src/declarative_push.rs", "dom/push/rust/src/lib.rs", "modules/libpref/init/StaticPrefList.yaml", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "49e681bb622c748f88a6e88be4c18db4456e4bfc", "git_parents": ["9c94c5b31ed045e91e29b4cd7f80c799e7b8d1ee"], "node": "21f740d46af489741616244fadf6220345152a66", "parents": ["a11984cb6866f9f5ee2b0fb81b311a2998d7da26"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068765 - Part 2: Create notification from Declarative Web Push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323283\n", "files": ["dom/push/Declarative.cpp", "dom/push/Declarative.h", "dom/push/PushNotifier.cpp", "dom/push/moz.build", "testing/web-platform/mozilla/meta/push-api/__dir__.ini", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/push-api/declarative.https.any.js"], "git_node": "9e71bf401bd9673c331116e2ad9571378ac2efa8", "git_parents": ["49e681bb622c748f88a6e88be4c18db4456e4bfc"], "node": "fb45ca7d8ec2ca62f0964d947183206bf542df92", "parents": ["21f740d46af489741616244fadf6220345152a66"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070836 - Fix snap-upstream-build tasks by ensuring newtab-node-modules is part of the toolchain. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325908\n", "files": ["taskcluster/kinds/snap-upstream-build/kind.yml"], "git_node": "0d26a5429aaf41e6f234b86334e60a2e6fce3bfe", "git_parents": ["9e71bf401bd9673c331116e2ad9571378ac2efa8"], "node": "fe594c92089999501e1194ea1a7d7888a9421c98", "parents": ["fb45ca7d8ec2ca62f0964d947183206bf542df92"], "tags": []}, {"author": "Ali Sayed Salehi \u003ca.s.salehi.95@gmail.com\u003e", "branch": "default", "desc": "Bug 2055854 - Add fixed size and time-based perf batching strategies to the shadow schedulers. r=sparky,taskgraph-reviewers,bhearsum\n\nAdds batching strategies for performance tests, evaluated via autoland\nshadow schedulers: run the full perf suite every N pushes\n(perf_fixed_batch_{10..60}, pushlog_id % N == 0) or every N hours\n(perf_time_batch_{3h..7h}) instead of the current backstop/expanded\ncadences.\n\nPurely additive: production scheduling is unaffected. The strategies are\nonly consumed by the new SS(perf_*_batch_*) shadow scheduler tasks,\nwhich upload the graph they would have scheduled for offline evaluation.\n\nPerformance tasks are now optimized through dedicated perf-cadence-*\nstrategies, assigned in the transforms and registered as pass-through\naliases of the strategies they replace: raptor uses\nperf-cadence-expanded or perf-cadence-backstop depending on tier, mobile\nbrowsertime uses perf-cadence-android, mozperftest uses\nperf-cadence-backstop and talos/awsy use perf-cadence-default (an alias\nof `test`). This gives the shadow schedulers (and later, production) a\nperf-only hook to override, since the underlying strategy names are\nshared with builds and unit tests. Wherever `test` is overridden\n(project.autoland, project.beta, the existing shadow schedulers), the\noverride is mirrored to perf-cadence-default so talos/awsy keep being\njudged identically to the other test tasks. The raptor regression-tests\ntasks keep the generic `test` strategy, preserving their existing\nexclusion from perf cadence optimization.\n\nThe time-based strategies are stateful, mirroring how the backstop\nchains through decision tasks: each run loads its predecessor's\npublic/shadow-scheduler-state/state.json artifact through the\nTaskcluster index and records an updated one. Cold starts (no state\nfound) batch and are flagged so evaluation can discount them.\n\nCron-only perf tasks are out of scope. Risk-based strategies are a\nfollow-up blocked on bug 2055853 and will reuse the state mechanism.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322189\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/optimize/perf_batching.py", "taskcluster/gecko_taskgraph/optimize/schema.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py", "taskcluster/gecko_taskgraph/transforms/perftest.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/gecko_taskgraph/transforms/test/raptor.py", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/kinds/source-test/shadow-scheduler.yml"], "git_node": "a22a283bdcaa6e606e2c3255e5131de27f5ed76a", "git_parents": ["0d26a5429aaf41e6f234b86334e60a2e6fce3bfe"], "node": "c6ebb8781ba9380b5e10801403f8ea06750703c3", "parents": ["fe594c92089999501e1194ea1a7d7888a9421c98"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2061046 - Add AITab Header component, wire up page actions - r=omarg,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322792\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/ui/actors/AITabChild.sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.css", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-shared.css", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabConstants.sys.mjs", "browser/components/aiwindow/ui/modules/AITabMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/AITabSql.sys.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_actions.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDate.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDelete.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml", "browser/locales-preview/aiWindow.ftl"], "git_node": "9938c52e1be01a9bb1d7984e6368a2aa16c81f04", "git_parents": ["a22a283bdcaa6e606e2c3255e5131de27f5ed76a"], "node": "26014e1888cbd1718fa5311d1406774d85610424", "parents": ["c6ebb8781ba9380b5e10801403f8ea06750703c3"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2050823 - Keep Google Lens image upload application scoped so Android 12 and below devices can use Google Lens integration r=android-reviewers,rebecatudor273\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314526\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/LensFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensImageSearch.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/BrowserToolbarSearchMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/LensFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensImageSearchTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/BrowserToolbarSearchMiddlewareTest.kt"], "git_node": "2db9d351cf85bf8c96a94828cd4979d3bed64284", "git_parents": ["9938c52e1be01a9bb1d7984e6368a2aa16c81f04"], "node": "d5c45e3dd5ddaac88932311eef4e29d9dfe6e6a1", "parents": ["26014e1888cbd1718fa5311d1406774d85610424"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2065392 - Fix for Google Lens integration on OnePlus devices r=android-reviewers,rebecatudor273\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321050\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraFragmentTest.kt"], "git_node": "e32c77cdb7b7a9dae75da2925b752a155712b47e", "git_parents": ["2db9d351cf85bf8c96a94828cd4979d3bed64284"], "node": "19791d0848a627e5edabf15b0fd56c91697bb05c", "parents": ["d5c45e3dd5ddaac88932311eef4e29d9dfe6e6a1"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2069082 - P1: Use AccessibilityNodeInfo.setLiveRegion(). r=Jamie,geckoview-reviewers,m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323395\n", "files": ["accessible/android/SessionAccessibility.cpp", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-descendant.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "1f096b14d53c71443ed4fa6c19d289c7b7dae0ec", "git_parents": ["e32c77cdb7b7a9dae75da2925b752a155712b47e"], "node": "02a36ca077fb86b91480245ce5ade0613b2491fb", "parents": ["19791d0848a627e5edabf15b0fd56c91697bb05c"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2069082 - P2: Reimplement Android live regions. r=Jamie,geckoview-reviewers,m_kato\n\nThis removes the old announcement based live regions and relies on a\nTYPE_WINDOW_CONTENT_CHANGED events.\n\nThere is an arbitrary event limiter in there\nso we don't saturate the platform with many events. There is anyway a\nlimit to how much of a live region any AT can reliably convey.\n\nI also removed the image labeled-by test since it uses a similar\ncodepath to a any name changed events and we already have non-OS\ncoverage for that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323396\n", "files": ["accessible/android/AccessibleWrap.cpp", "accessible/android/AccessibleWrap.h", "accessible/android/Platform.cpp", "accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-descendant.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-image-labeled-by.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-image.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-large.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "377b087410e2592b36f7b9ee2f4d7a040258808e", "git_parents": ["1f096b14d53c71443ed4fa6c19d289c7b7dae0ec"], "node": "c198d7ed22502cb1320f9c6b1699952cb7c46ebe", "parents": ["02a36ca077fb86b91480245ce5ade0613b2491fb"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1185617 - Implement alert live regions in Android. r=Jamie,geckoview-reviewers,m_kato\n\nI'm not 100% sure why this a live region in mac since we handle ALERT\nevents over there. Implicitly, I think this needs to be an assertive\nregion everywhere..\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323755\n", "files": ["accessible/base/ARIAMap.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "5f11bddf0842cd3b52324b6e747c747085588662", "git_parents": ["377b087410e2592b36f7b9ee2f4d7a040258808e"], "node": "97bfe3e6ec45d5797dd9f95baf865d1d60ad85c1", "parents": ["c198d7ed22502cb1320f9c6b1699952cb7c46ebe"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 908042 - Implement aria-busy in Android. r=Jamie,geckoview-reviewers,m_kato\n\nThis is ideally something the AT should do and not us. According to\nspec, once aria-busy is set to false the AT should announce any\nchanges it has tracked while it was busy. We don't do that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323754\n", "files": ["accessible/android/SessionAccessibility.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "c9a199426b9d679a279caa523539c671b0563273", "git_parents": ["5f11bddf0842cd3b52324b6e747c747085588662"], "node": "91e6dc972cd1c50236e6deadc2236d8a97938cba", "parents": ["97bfe3e6ec45d5797dd9f95baf865d1d60ad85c1"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068765 - Part 2: Create notification from Declarative Web Push. r=saschanaz\" for causing bustages in Declarative.cpp.\n\nThis reverts commit 9e71bf401bd9673c331116e2ad9571378ac2efa8.\n\nRevert \"Bug 2068765 - Part 1: Parser for Declarative Web Push. r=saschanaz\"\n\nThis reverts commit 49e681bb622c748f88a6e88be4c18db4456e4bfc.\n", "files": ["Cargo.lock", "dom/push/Declarative.cpp", "dom/push/Declarative.h", "dom/push/PushNotifier.cpp", "dom/push/moz.build", "dom/push/rust/Cargo.toml", "dom/push/rust/cbindgen.toml", "dom/push/rust/src/declarative_push.rs", "dom/push/rust/src/lib.rs", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/push-api/__dir__.ini", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/push-api/declarative.https.any.js", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "49931ce023e4b21a85ed34bbf98d3aa0914c1b43", "git_parents": ["c9a199426b9d679a279caa523539c671b0563273"], "node": "f6a50dcf6d0ee5316f4673ae141ef6df10422acd", "parents": ["91e6dc972cd1c50236e6deadc2236d8a97938cba"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2059658: Flesh out remote candidate obfuscation tests. r=mjf\n\nIncludes a bunch of mDNS-related tests in mozilla wpt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324407\n", "files": ["testing/web-platform/mozilla/meta/webrtc/mdns-candidate-obfuscation.html.ini", "testing/web-platform/mozilla/tests/webrtc/mdns-candidate-obfuscation.html", "testing/web-platform/tests/webrtc/RTCIceTransport-peer-reflexive-remote.html", "testing/web-platform/tests/webrtc/RTCPeerConnection-helper.js"], "git_node": "16b689e7e7b401e4e239dc5831e09bbc013b492e", "git_parents": ["49931ce023e4b21a85ed34bbf98d3aa0914c1b43"], "node": "995d42f5df9260a2fd6572ae0f5f355530f8beb9", "parents": ["f6a50dcf6d0ee5316f4673ae141ef6df10422acd"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2070327: Wait for trickle in this test case to ensure it works. r=mjf\n\nDepends on D324407\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324408\n", "files": ["testing/web-platform/meta/webrtc-stats/getStats-remote-candidate-address.html.ini", "testing/web-platform/tests/webrtc-stats/getStats-remote-candidate-address.html"], "git_node": "8d24eb9d1056618029fc731139ce4a42a6c06b98", "git_parents": ["16b689e7e7b401e4e239dc5831e09bbc013b492e"], "node": "3a7aba8bdd8d59cd67d922b67438f4e9070193fa", "parents": ["995d42f5df9260a2fd6572ae0f5f355530f8beb9"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2059658: Stop passing around munged remote candidates. r=mjf,webidl,smaug\n\nThe previous approach for mDNS-based remote candidates was to resolve\nthe address, and replace the mDNS address with the resolved address in\nthe candidate string. The original mDNS addr was passed along as a side\nthing. This now works the other way around. The original candidate\nstring is left alone, and the resolved address rides along as a side\nthing. This removes the need to un-munge every time a candidate string\nmight be exposed to content.\n\nDepends on D324408\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324439\n", "files": ["dom/media/webrtc/MediaTransportParent.h", "dom/media/webrtc/PMediaTransport.ipdl", "dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsapi/MediaTransportHandler.h", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.cpp", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.h", "dom/media/webrtc/jsapi/MediaTransportParent.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/jsapi/RTCIceCandidate.cpp", "dom/media/webrtc/jsapi/RTCIceCandidate.h", "dom/media/webrtc/tests/mochitests/stats.js", "dom/media/webrtc/transport/nricecandidate.cpp", "dom/media/webrtc/transport/nricectx.cpp", "dom/media/webrtc/transport/nricemediastream.cpp", "dom/media/webrtc/transport/nricemediastream.h", "dom/media/webrtc/transport/test/buffered_stun_socket_unittest.cpp", "dom/media/webrtc/transport/test/gtest_utils.h", "dom/media/webrtc/transport/test/ice_unittest.cpp", "dom/media/webrtc/transport/test/multi_tcp_socket_unittest.cpp", "dom/media/webrtc/transport/test/stunserver.cpp", "dom/media/webrtc/transport/test/test_nr_socket_unittest.cpp", "dom/media/webrtc/transport/test/turn_unittest.cpp", "dom/media/webrtc/transport/test_nr_socket.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate.h", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_component.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_ctx.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_parser.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_peer_ctx.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/net/transport_addr.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/net/transport_addr.h", "dom/webidl/RTCStatsReport.webidl", "toolkit/content/aboutwebrtc/aboutWebrtc.mjs"], "git_node": "d38643f4040868b2651e96b23e83e3806b34bebe", "git_parents": ["8d24eb9d1056618029fc731139ce4a42a6c06b98"], "node": "4be0cef11638a8fc5040179f8107d246dea153ea", "parents": ["3a7aba8bdd8d59cd67d922b67438f4e9070193fa"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2067652 - Include ERROR/CRITICAL log records in TestSummaryFormatter output r=jgraham\n\nFailures that are not tied to a test (LeakSanitizer/TSan reports, shutdown\nleakcheck, assertion-count mismatches, harness errors) are reported as `log`\nrecords of level ERROR/CRITICAL. ErrorSummaryFormatter keeps them, but\nTestSummaryFormatter dropped every `log` action, so a job failing only on\nsuch an error ended up with a summary.jsonl that contained no failure at all\n(e.g. LSan leaks after netwerk/test/browser/browser.toml on linux asan bc).\nMirror errorsummary and pass those two levels through, stripped like every\nother record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322250\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "50996bd58242628613058e46124a881ae01b78a6", "git_parents": ["d38643f4040868b2651e96b23e83e3806b34bebe"], "node": "2f36c279171982b22b1ee08ed18f756f57cf8e66", "parents": ["4be0cef11638a8fc5040179f8107d246dea153ea"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069021 - Add a test utility for intercepting ML engine creation r=ai-platform-reviewers,valentinp\n\nThis commit adds a test utility for observing, asserting against and/or overriding\nselected ML engine creation requests.\n\nCo-authored-by: Valentin Pollet \u003cvpollet@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321999\n", "files": ["toolkit/components/ml/ml.d.ts", "toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_engine_creation_interceptor.js"], "git_node": "b925c0ab96907c4cb178c68028eed3f4e1a81260", "git_parents": ["50996bd58242628613058e46124a881ae01b78a6"], "node": "a1ca6efd774252e3ef312ff5e67e83a4cced26ea", "parents": ["2f36c279171982b22b1ee08ed18f756f57cf8e66"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069021 - Allow Mochitest perftests to opt into ML services r=mozperftest-reviewers,ai-platform-reviewers,kshampur,valentinp\n\nThis commit makes production ML services opt-in for Mochitest\nperformance tests while keeping them enabled for eval-Mochitest tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322474\n", "files": ["python/mozperftest/mozperftest/system/__init__.py", "python/mozperftest/mozperftest/system/ml_services.py", "python/mozperftest/mozperftest/tests/test_ml_services.py"], "git_node": "d32a5c2aa7c2cc2d5ccadd10ee6217901daa27ed", "git_parents": ["b925c0ab96907c4cb178c68028eed3f4e1a81260"], "node": "a64a285dcf0b92d0a48ddf309a7e417e24ec938f", "parents": ["a1ca6efd774252e3ef312ff5e67e83a4cced26ea"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069021 - Add MLPerfTestUtils for ML end-to-end perf tests. r=ai-platform-reviewers,nordzilla\n\nThis commit adds shared lifecycle orchestration, peak-memory sampling,\nand Perfherder reporting for ML end-to-end performance tests.\n\nCo-authored-by: Erik Nordin \u003cenordin@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322588\n", "files": ["toolkit/components/ml/ml.d.ts", "toolkit/components/ml/tests/MLPerfTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_perf_test_utils.js", "toolkit/components/ml/tests/moz.build"], "git_node": "f2f033cf0ba1c8467f56170829dc7e0eea6f56d6", "git_parents": ["d32a5c2aa7c2cc2d5ccadd10ee6217901daa27ed"], "node": "5eea263426edeb6fccc9a1f112a041f165f6aa7c", "parents": ["a64a285dcf0b92d0a48ddf309a7e417e24ec938f"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069021 - Capture MLEngine activity in performance scenarios. r=ai-platform-reviewers,nordzilla\n\nThis commit extends MLPerfTestUtils to observe configured production\nengine creations and completed inference calls during a measured scenario.\n\nCo-authored-by: Erik Nordin \u003cenordin@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322590\n", "files": ["toolkit/components/ml/ml.d.ts", "toolkit/components/ml/tests/MLPerfTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_perf_test_utils.js"], "git_node": "f6eb540a8d5100469000d4b4c5290c5dd0df523d", "git_parents": ["f2f033cf0ba1c8467f56170829dc7e0eea6f56d6"], "node": "45bfda13e1a16322d9bd0900e751978b4ca7bd94", "parents": ["5eea263426edeb6fccc9a1f112a041f165f6aa7c"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069021 - Report shared ML performance metrics r=ai-platform-reviewers,valentinp\n\nThis commit reports consistent engine creation and run timing, inference-process memory before and after each run, and peak memory through the shared lifecycle runner.\n\nFor streamed generation, it also reports TTFT, decoding time, input and output token counts, and tokens per second.\n\nCo-authored-by: Valentin Pollet \u003cvpollet@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323155\n", "files": ["toolkit/components/ml/ml.d.ts", "toolkit/components/ml/tests/MLPerfTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_perf_test_utils.js"], "git_node": "2aeebc8300b86879cdc4627b993fb8c9133171b1", "git_parents": ["f6eb540a8d5100469000d4b4c5290c5dd0df523d"], "node": "76b4070e976f3a09d422c9a0e865128b0e1dbea1", "parents": ["45bfda13e1a16322d9bd0900e751978b4ca7bd94"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069021 - Pin the ONNX backend from MOZ_ML_BACKENDS in MLPerfTestUtils. r=nordzilla,ai-platform-reviewers\n\nPer-backend CI jobs set MOZ_ML_BACKENDS. runPerfScenario applies it: declared\nengines get a backend override through the creation interceptor, series get\nthe backend tag, and each observed ONNX engine is checked to have resolved to\nit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323349\n", "files": ["toolkit/components/ml/tests/MLPerfTestUtils.sys.mjs"], "git_node": "546dfcc7a1aca32c1f135e16d1a6d4076d4848d4", "git_parents": ["2aeebc8300b86879cdc4627b993fb8c9133171b1"], "node": "18b2f505131a82251c58248189119725bf721ef1", "parents": ["76b4070e976f3a09d422c9a0e865128b0e1dbea1"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069021 - Stop tearing engines down before warm samples. r=ai-platform-reviewers,nordzilla\n\nWarm means the scenario has run once and nothing was torn down since. Warm\nsamples now follow one unreported run and check they used its engines. Peak\nmemory is sampled in separate runs after the latency samples, with the engines\nin whatever state the feature leaves them, as a single series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323350\n", "files": ["toolkit/components/ml/tests/MLPerfTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_perf_test_utils.js"], "git_node": "d85befd740d8be60eff288ee3a38e29db60b0260", "git_parents": ["546dfcc7a1aca32c1f135e16d1a6d4076d4848d4"], "node": "cb721a12320eb2f118555cda1eadc9c88345b0df", "parents": ["18b2f505131a82251c58248189119725bf721ef1"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065012 - Add end-to-end performance coverage for Form Autofill r=perftest-reviewers,mozperftest-reviewers,credential-management-reviewers,ai-platform-reviewers,dimi,kshampur,valentinp\n\nThis commit adds a performance test to measure the single- and double-engine\nclassifiers through real field identification for both ONNX native and WASM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322000\n", "files": ["browser/extensions/formautofill/moz.build", "browser/extensions/formautofill/test/browser/performance/browser_formautofill_ml_perf.js", "browser/extensions/formautofill/test/browser/performance/head.js", "browser/extensions/formautofill/test/browser/performance/perftest.toml", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "9dd63d158d95ef550d9065ebb75573e36544559e", "git_parents": ["d85befd740d8be60eff288ee3a38e29db60b0260"], "node": "90aa548853f83e97b2ba123a744e4301e5a2570f", "parents": ["cb721a12320eb2f118555cda1eadc9c88345b0df"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065247 - Add end-to-end performance coverage for Link Preview key points. r=perftest-reviewers,mozperftest-reviewers,gcardieri,ai-platform-reviewers,kshampur,nordzilla\n\nDrives key points generation through the production hover flow and reports\nthe user-perceived spans plus the engine internals MLPerfTestUtils captures\nfor the link-preview feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322589\n", "files": ["browser/components/genai/moz.build", "browser/components/genai/tests/browser/browser_link_preview_perf.js", "browser/components/genai/tests/browser/perftest.toml", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "fa6b4f140055713fa071c6753799b1eebebd2a0f", "git_parents": ["9dd63d158d95ef550d9065ebb75573e36544559e"], "node": "60d96c2eb7b9460a73b891d4748c0b1319274ef6", "parents": ["90aa548853f83e97b2ba123a744e4301e5a2570f"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065253 - Add end-to-end performance coverage for semantic history search. r=perftest-reviewers,mozperftest-reviewers,urlbar-reviewers,ai-platform-reviewers,kshampur,mak,nordzilla\n\nIngests history through the production indexing task and queries through\nthe real urlbar. Indexing reports the embedder's per-sweep cost on a\nresident engine, which is what scales with history size; the search reports\nthe time to a semantic result across cold and warm engine states.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323351\n", "files": ["browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-ml/browser_urlbar_semantic_history_perf.js", "browser/components/urlbar/tests/browser-ml/perftest.toml", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "d2df02f4a1b4996c4dd6ef5422da7e7ec54660a0", "git_parents": ["fa6b4f140055713fa071c6753799b1eebebd2a0f"], "node": "0777b32e1c9e373e43ced1e81c090796a77a941b", "parents": ["60d96c2eb7b9460a73b891d4748c0b1319274ef6"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065260 - Add end-to-end performance coverage for ML-backed Firefox Suggest. r=perftest-reviewers,mozperftest-reviewers,urlbar-reviewers,ai-platform-reviewers,kshampur,nordzilla,mak\n\nEnables the Suggest ML backend and types a Yelp-intent query into the urlbar,\nreporting the time to the suggestion row, peak memory, and the per-engine\nseries. Suggest creates its engines when enabled and a query never waits for\nthem, so the lifecycles are first use and warm.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323352\n", "files": ["browser/components/urlbar/tests/browser-ml/browser_quicksuggest_ml_perf.js", "browser/components/urlbar/tests/browser-ml/perftest.toml", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "6a8f8d2ab3164788be9aff8f2ee3d3ffec46be09", "git_parents": ["d2df02f4a1b4996c4dd6ef5422da7e7ec54660a0"], "node": "ca8f29dd4e2bb4e630f022cdd65f05544e9a202b", "parents": ["0777b32e1c9e373e43ced1e81c090796a77a941b"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065257 - Add end-to-end performance coverage for Smart Tab Grouping. r=ai-platform-reviewers,perftest-reviewers,mozperftest-reviewers,tabbrowser-reviewers,sthompson,kshampur,nordzilla\n\nThe existing Smart Tab Grouping perf tests run the topic and embedding models\ndirectly, and invoke the grouping implementation with synthetic tab data,\nrather than exercising the tab group menu that requests generated labels and\ndisplays suggested tabs. This lets the tests and the shipping feature drift\napart.\n\nOpen real tabs, create a group through the menu, and request suggestions from\nthe panel, measuring from each user action to the point the result reaches the\nUI. Both spans are guarded by assertions on what the production path returned:\na failed engine resolves to an empty label and renders no suggestion rows,\nwhich would otherwise be recorded as a fast result.\n\nLifecycle orchestration, engine observation and reporting come from\nMLPerfTestUtils, so the topic and embedding engines each also report creation\ntime, run time and inference-process memory across first-use, cold and warm\nengines. Each ONNX backend runs as its own job.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324479\n", "files": ["browser/components/tabbrowser/moz.build", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/browser_smart_tab_grouping_perf.js", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/data/e2e/flights.html", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/data/e2e/hotels.html", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/data/e2e/lasagna.html", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/data/e2e/lisbon.html", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/data/e2e/mdn-array-map.html", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/data/e2e/nba-scoreboard.html", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/perftest.toml", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "c1675cb152301edde5c74515d52eeb341b0f8571", "git_parents": ["6a8f8d2ab3164788be9aff8f2ee3d3ffec46be09"], "node": "848ee27d2476be35ef56fe38b8ef25afd4f7341d", "parents": ["ca8f29dd4e2bb4e630f022cdd65f05544e9a202b"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066849 - Add Kit animation to the PBW. r=credential-management-reviewers,desktop-theme-reviewers,emilio,sthompson,emz,mtigley\n\nAdd a one-time \"kit\" intro animation to the private-browsing \"You're off the\nrecord\" mask, gated behind the private window redesign experiment.\n\nWhen enrolled, about:privatebrowsing swaps the static mask logo for a new\n\u003cprivate-browsing-mask-intro\u003e Lit element: the kit peeks inside the circular\nmask window, does a small vertical bounce, then drops out while the mask icon\nfades in. It plays only once per profile and rolls out to all users, including\nthose who have opened a private window before. Under prefers-reduced-motion the\nmask renders in its final state with no animation.\n\nPrefs:\n- browser.privateWindowRedesign.enabled (default false): the experiment gate,\n  set on the default branch via Nimbus (privateWindowRedesign feature).\n- browser.privatebrowsing.introAnimationShown (default false): the seen-once\n  flag. It is written from about:privatebrowsing via RPMSetPref (allowlisted in\n  both RemotePageAccessManager and AsyncPrefs) so it persists across separate\n  private-window launches; once true, the intro renders its final state instead\n  of replaying.\n\nBecause the subsequent-launch gating is awkward to exercise by hand (it only\nreproduces across fresh profiles/launches), this also adds a Storybook story\nfor the component so the animation and its play/final states can be previewed\nand iterated in isolation.\n\nTests cover: the intro is absent unless the experiment is enabled; it plays on\nfirst run; it does not replay once the seen-once flag is set; the flag is\npersisted once the intro starts playing; and reduced motion is respected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322649\n", "files": ["browser/app/profile/firefox.js", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.html", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.js", "browser/components/privatebrowsing/content/private-browsing-mask-intro.css", "browser/components/privatebrowsing/content/private-browsing-mask-intro.mjs", "browser/components/privatebrowsing/jar.mn", "browser/components/privatebrowsing/test/browser/browser.toml", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_kit_intro.js", "browser/components/storybook/stories/private-browsing-kit-intro.stories.mjs", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/privatebrowsing/kit-pbw.svg", "toolkit/modules/AsyncPrefs.sys.mjs", "toolkit/modules/RemotePageAccessManager.sys.mjs"], "git_node": "f378b8e4403ab6bcfe89a88da72eeed52e0b461f", "git_parents": ["c1675cb152301edde5c74515d52eeb341b0f8571"], "node": "97be15a179403c316e94b297b2caca0a6faaf1e2", "parents": ["848ee27d2476be35ef56fe38b8ef25afd4f7341d"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2068992 - Add priority and scope auto-triggering set default and pin to startup on the first profile r=omc-reviewers,mimi\n\nThis patch ensures that the auto-triggering of set default and pin for users who will see an OS-level consent prompt only occur on first startup on the first profile and do not trigger for new selectable profiles. It also addresses the inconsistent behavior noted in the STR of the bug by adding a priority so that it takes precedence over [[ https://searchfox.org/firefox-main/source/browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs#2345 | FXA_ACCOUNTS_BADGE_REVISED ]].\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324750\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "3f947760658f748aa6f975d6583e10f7d843a1be", "git_parents": ["f378b8e4403ab6bcfe89a88da72eeed52e0b461f"], "node": "37c7694bece2a178dc3f0febd5cea26c8feb9fdd", "parents": ["97be15a179403c316e94b297b2caca0a6faaf1e2"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2071090 - add browser_clipboard_paste_chat_shortcuts.js to test manifest r=dlp-reviewers,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325182\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser.toml"], "git_node": "084de832cc2fef861036bf58b90e35ffa29e35b4", "git_parents": ["3f947760658f748aa6f975d6583e10f7d843a1be"], "node": "399e1a958543b0cd949e7eae031f10ddc72ac80e", "parents": ["37c7694bece2a178dc3f0febd5cea26c8feb9fdd"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2071981 - Add Rect operators to allow addition / subtraction with margins. r=gfx-reviewers,bradwerth\n\nBaseRect already has r1 - r2 = m, the margin between two rects. This\npatch adds r2 + m = r1 and r1 - m = r2, plus the matching += and -=,\nfor consistency and convenience. They call Inflate and Deflate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325950\n", "files": ["gfx/2d/BaseRect.h"], "git_node": "c5e7bfd98df52ab3f0dca6c7a4668f6555972227", "git_parents": ["084de832cc2fef861036bf58b90e35ffa29e35b4"], "node": "79b1f232befe118e115272c15f4c8895e4511c8a", "parents": ["399e1a958543b0cd949e7eae031f10ddc72ac80e"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070717: bump max run time of gcc toolchain jobs r=firefox-build-system-reviewers,ahochheiden\n\nThese currently have a max run time of 60 minutes. The most recent build of gcc-11 took 60 minutes. We should bump the max run time to avoid failures.\n\nBumping for all of them is probably not strictly necessary, but it's unlikely to be meaningfully harmful, and will help avoid issues when we, eg: add a new gcc version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324770\n", "files": ["taskcluster/kinds/toolchain/gcc.yml"], "git_node": "1fa88dbdc8055182417792d2275445002afd58bd", "git_parents": ["c5e7bfd98df52ab3f0dca6c7a4668f6555972227"], "node": "64f2c413b888866444392f1074e0b56f575ae64f", "parents": ["79b1f232befe118e115272c15f4c8895e4511c8a"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2062112 - [Monitor Agent][FE] Create monitor component in tool bar panel r=ngrato,fluent-reviewers,desktop-theme-reviewers,sfoster,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321407\n", "files": ["browser/base/content/browser.js", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartwindowMonitor.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "96548999a5dd08209b38b9820ea1c6fc23e71491", "git_parents": ["1fa88dbdc8055182417792d2275445002afd58bd"], "node": "34ce692fa40a6b52bdac1bbf3e2c5530563bfad4", "parents": ["64f2c413b888866444392f1074e0b56f575ae64f"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2068669 - Align the content recommendations supported locales with the Merino client r=android-reviewers,skhan\n\n- Derive the supported locales from CuratedRecommendationLocale\n- Locales need to match exactly on the language and region in order to receive content recommendations\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324109\n", "files": ["mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/ContentRecommendationsLocales.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/ext/Mappers.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/MerinoContentRecommendationsProvider.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/ContentRecommendationsLocalesTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/ext/MappersKtTest.kt", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/pocket/ContentRecommendationsFeatureHelper.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/pocket/ContentRecommendationsFeatureHelperTest.kt"], "git_node": "f9694059831bbb774afde0af16719f0241062371", "git_parents": ["96548999a5dd08209b38b9820ea1c6fc23e71491"], "node": "bd10c9f479b61c4c6ef8cdf30bfd38d865cfb7c2", "parents": ["34ce692fa40a6b52bdac1bbf3e2c5530563bfad4"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066625: For automatic line clamping, containers now respect descendants' min-height. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324690\n", "files": ["layout/generic/nsBlockFrame.cpp", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-042.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-058.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-059.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-060.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-061.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-062.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-auto-048-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-auto-058-ref.html"], "git_node": "5e6e95317564620b72efdc04f6661e0a77ce0f00", "git_parents": ["f9694059831bbb774afde0af16719f0241062371"], "node": "13954e04bee3c6350799d51b1723706208ed52df", "parents": ["bd10c9f479b61c4c6ef8cdf30bfd38d865cfb7c2"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2071110 - Update the content recommendations refresh frequency to 30 minutes r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325196\n", "files": ["mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/PocketStoriesConfig.kt"], "git_node": "84abe43fd75479b41ccc436151435d2d283adb2e", "git_parents": ["5e6e95317564620b72efdc04f6661e0a77ce0f00"], "node": "b9a06530185583b66e860675a8b95e38310496c0", "parents": ["13954e04bee3c6350799d51b1723706208ed52df"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071618 - Don't let the shipped search engines add tab-to-search rows to the urlbar unit tests. r=mak\n\nThe dropped expectation isn't tab-to-search coverage: it and its onboarding pref came in together in bug 1823450 to make the expected list match, and test_autofill_prefix_priority is about autofill picking https over http.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325801\n", "files": ["browser/components/urlbar/tests/unit/head.js", "browser/components/urlbar/tests/unit/test_autofill_origins_alt_frecency.js"], "git_node": "40099b7450c624e1bac0992205ec5f1c