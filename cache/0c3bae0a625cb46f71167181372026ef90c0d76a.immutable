wser/head.js", "browser/components/miniwindow/test/browser/mini-window-crop-target.html", "browser/components/miniwindow/test/browser/mini-window-redirect.html", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "browser/components/miniwindow/test/xpcshell/xpcshell.toml"], "git_node": "293a5b3b53d9f6b6e6fba90373daacc31288be3d", "git_parents": ["b410f74428e94ca230e986388b084f3fd4a1010d"], "node": "48c6560cf3163327c1273151bc0d840ee63ba2c1", "parents": ["de60c132c5cb3423e940d2803077498486fadcf9"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Add the Screenshots mini-window mode and toolbar button. r=mconley,fluent-reviewers,bolsson,niklas,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322138\n", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsSelectionModes.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "browser/components/screenshots/moz.build", "browser/components/screenshots/overlay/overlay.css", "browser/components/screenshots/overlayHelpers.mjs", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/toolbarbutton-icons.css", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "c7d1614b4123f767f811fe23cc9e3fe22ff7d8f9", "git_parents": ["293a5b3b53d9f6b6e6fba90373daacc31288be3d"], "node": "2ea25ab37f9039e8f9af9ba4a5bc5fccea4b021d", "parents": ["48c6560cf3163327c1273151bc0d840ee63ba2c1"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Add a Use Mini Window item to the content context menu. r=mconley,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323857\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/webext-panels.xhtml", "browser/locales-preview/miniWindow.ftl"], "git_node": "4f64b55a5115ed8451000e73a302201a9951ffc2", "git_parents": ["c7d1614b4123f767f811fe23cc9e3fe22ff7d8f9"], "node": "900b4415c16ad7e3449d524c49b34259bd45c3c0", "parents": ["2ea25ab37f9039e8f9af9ba4a5bc5fccea4b021d"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Test the mini window screenshots entry points. r=mconley,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322139\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_region_entry.js", "browser/components/miniwindow/test/browser/browser_toolbar_button.js", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/screenshots/tests/browser/browser_mini_window_mode.js"], "git_node": "66450b9b4c2a571419a9bb1eeee6f1f0bb802ca7", "git_parents": ["4f64b55a5115ed8451000e73a302201a9951ffc2"], "node": "5a34195ef06ecd9afb979272a5a7e06f5ceb11f9", "parents": ["900b4415c16ad7e3449d524c49b34259bd45c3c0"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Separate cropped and full tab mini windows. r=mconley,fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,dao,sfoster,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323858\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_open_close.js", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/toolbarbuttons.css"], "git_node": "57dbd0536f96d210d8b8f24791762b2acc7909fd", "git_parents": ["66450b9b4c2a571419a9bb1eeee6f1f0bb802ca7"], "node": "f9a5b5ea5598eaaa4954f5f6902580cb442bd598", "parents": ["5a34195ef06ecd9afb979272a5a7e06f5ceb11f9"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Return a cropped mini window's tab home when it navigates away. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323859\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "c4c95030aad90c6e8d7ee5125533c42de7482477", "git_parents": ["57dbd0536f96d210d8b8f24791762b2acc7909fd"], "node": "3daf08a25fa36664c31b87b09cb51f478e476a6b", "parents": ["f9a5b5ea5598eaaa4954f5f6902580cb442bd598"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Test the mini window flavors. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323860\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_cropped_navigation.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/head.js"], "git_node": "dd14d17a529c27b2590ee41ccc146d113ae3e3c5", "git_parents": ["c4c95030aad90c6e8d7ee5125533c42de7482477"], "node": "2b87011386f7527fa78bb1bab6b04ceb3a47b502", "parents": ["3daf08a25fa36664c31b87b09cb51f478e476a6b"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Restyle the mini window toolbar and suppress its sidebar. r=mconley,sidebar-reviewers,sfoster\n\nTwo bits of chrome polish that were still following the ordinary browsing\nwindow:\n\nThe reused nav-bar took its colour from the theme, which made a mini window\nread as a shrunken browsing window rather than its own surface. Pin it to\nwhite in light mode and #252428 in dark, active and inactive alike. Left alone\nunder forced colours: HCM users choose their own background, so the system\ncolours the toolbox tokens already carry are the right answer there.\n\nThe sidebar still initialised, because SidebarController.inSingleTabWindow only\nknew about Taskbar Tabs and mini windows deliberately keep toolbar.visible\ntrue. A mini window holds one tab and hides the app menu, so the sidebar and\nits launcher have nothing to offer there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325080\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_sidebar.js", "browser/components/sidebar/browser-sidebar.js", "browser/themes/shared/browser-shared.css"], "git_node": "6187d5d9a06698748de43c04ebdfc1cda1fdc0d4", "git_parents": ["dd14d17a529c27b2590ee41ccc146d113ae3e3c5"], "node": "81ac1a41a6025bf76f71a147c38468540e43dcb5", "parents": ["2b87011386f7527fa78bb1bab6b04ceb3a47b502"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Add a mute button to the mini window nav-bar. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson\n\nA mini window can be playing audio with no way to silence it: the tab strip's\naudio button isn't there, and the app menu is hidden. Add a button beside the\nput-tab-back control that mirrors the tab's sound state and toggles mute,\nusing the same icons the tab strip does.\n\nIt only appears while there is sound to mute, or while the tab is already\nmuted and needs a way back, so an ordinary mini window is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325081\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "d41bf4afbda9da3d43d2bed9c5fd10367352f8d4", "git_parents": ["6187d5d9a06698748de43c04ebdfc1cda1fdc0d4"], "node": "b01320a07538452bbafc4e9018b0f1a7e335164c", "parents": ["81ac1a41a6025bf76f71a147c38468540e43dcb5"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Re-frame a mini window's crop from a ResizeObserver. r=mconley\n\nThe crop was re-framed from the window's resize event, and each pass read\nminiWin.innerWidth to do it. That read can force a synchronous layout flush,\nand resize fires continuously while a window edge is dragged, so the flush\nlanded on every event of the drag.\n\nA ResizeObserver carries the new size in its observation, so there is nothing\nto read back, and the engine batches observations per frame - a drag now costs\none re-frame per frame rather than one per event. #applyTransform still falls\nback to a non-flushing read for its other caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325228\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs"], "git_node": "f6eafad304d152d300121fdfa02fe1a269bd88e9", "git_parents": ["d41bf4afbda9da3d43d2bed9c5fd10367352f8d4"], "node": "359db077bcf50d3a1bad593128926ba9bf3f3a8c", "parents": ["b01320a07538452bbafc4e9018b0f1a7e335164c"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2073857 - The Monitors list spills out of the Toolbar Monitor panel when there is a large number of monitors created r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327875\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js"], "git_node": "586e4a6a4b5f9184e1a6d56d5671cde2b167ec06", "git_parents": ["f6eafad304d152d300121fdfa02fe1a269bd88e9"], "node": "a5450ad26db7d0383b2810ddc85d490bc687b1f9", "parents": ["359db077bcf50d3a1bad593128926ba9bf3f3a8c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073785: Restore cap on size of irregexp Zone allocation r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328009\n", "files": ["js/src/irregexp/util/ZoneShim.h"], "git_node": "2cb66243af3060ff2e8d00cd2fd8fb2c805f7447", "git_parents": ["586e4a6a4b5f9184e1a6d56d5671cde2b167ec06"], "node": "7b83838f6e1353f36c9244b19b0088539c1bb7a3", "parents": ["a5450ad26db7d0383b2810ddc85d490bc687b1f9"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "902193e687e546d4e6ab7b37417f9f08867f9578", "git_parents": ["2cb66243af3060ff2e8d00cd2fd8fb2c805f7447", "270f33501017a3286a0baf31c440520551f2adcc"], "node": "5c12cdc65173b93d2a853b26578e9365c1e8e38e", "parents": ["7b83838f6e1353f36c9244b19b0088539c1bb7a3", "8f824662c46e9c009dc6a03bfe1806a4259e2188"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1632281 - Read the AutoConfig input prefs from the installation, not the profile. r=gstoll\" for causing xpcshells failures\n\nThis reverts commit ed634e3eb11b53fff30f31557c631cd6bdc82694.\n", "files": ["extensions/pref/autoconfig/src/nsReadConfig.cpp", "extensions/pref/autoconfig/test/unit/autoconfig-admin-pref.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-admin-url-pref.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-admin.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-remote.jsc", "extensions/pref/autoconfig/test/unit/test_autoconfig_profile_prefs.js", "extensions/pref/autoconfig/test/unit/xpcshell.toml"], "git_node": "ce1a490ead35e712bade3748133924ec4b961d76", "git_parents": ["902193e687e546d4e6ab7b37417f9f08867f9578"], "node": "6d4ecc69ef8b79f29ceaf192e0397ca178ded020", "parents": ["5c12cdc65173b93d2a853b26578e9365c1e8e38e"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069765 - Fix PullAbsoluteFramesFrom() when told to pull every frames. r=layout-reviewers,emilio,dshin\n\nThis is the scenario where the absolute containing block is an inline, and we\nmove all the frames from an inline continuation that is *not* the first in its\nfragmentainer.\n\nThis patch 1) fixes the continuation ordering when `child` already has a\nprev-in-flow in the current absCB, and 2) empties `aContinuation`'s pushed child\nlist. Both can trigger assertions in `SanityCheckChildLists()` if not fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328019\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp"], "git_node": "99f0f7634e06b4f9ad8af1a057df8f76d23708f0", "git_parents": ["ce1a490ead35e712bade3748133924ec4b961d76"], "node": "d3218333522883cd7730465ee090657aa043ada0", "parents": ["6d4ecc69ef8b79f29ceaf192e0397ca178ded020"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2073617 - [devtools] Avoid toggling watchedByDevTools on non top level Browsingcontext. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327839\n", "files": ["devtools/server/actors/watcher.js"], "git_node": "b4d889ea675a4447eb38583a9101d353f8226f33", "git_parents": ["99f0f7634e06b4f9ad8af1a057df8f76d23708f0"], "node": "0f7e5728fd52711d30dc3a3e202b4b9f72324a5e", "parents": ["d3218333522883cd7730465ee090657aa043ada0"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072590 - Support chart fields in BaseMarkerType r=profiler-reviewers,canova\n\nMarkerSchema::AddChart/AddChartColor let a marker type plot one of its numeric\npayload fields as a timeline track, but BaseMarkerType had no way to express\nthat, so any marker using it was stuck on the hand-written MarkerTypeDisplay\nsyntax.\n\nAdd an optional GraphFields array of MarkerSchema::GraphField, mirroring how\nPayloadFields works: MarkerTypeDisplay walks it and calls AddChartColor when a\ncolor is given and AddChart otherwise. A constexpr check rejects a null Key,\nand UseSpecialFrontendLocation types are barred from declaring GraphFields\nalong with the other display properties the front-end ignores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326453\n", "files": ["mozglue/baseprofiler/public/BaseProfilerMarkersPrerequisites.h", "tools/profiler/docs/markers-guide.md", "tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "3946503e01820d6bf41b0ac0cc3596a75c5210f8", "git_parents": ["b4d889ea675a4447eb38583a9101d353f8226f33"], "node": "6dfed49214f44bb75d1fe0b838d27896c2758faf", "parents": ["0f7e5728fd52711d30dc3a3e202b4b9f72324a5e"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072590 - Migrate CPUSpeedMarker to BaseMarkerType r=canova,profiler-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327274\n", "files": ["tools/profiler/core/platform.cpp"], "git_node": "1173cb9d95d80d155b73786ee8b08bb6b0ff9e60", "git_parents": ["3946503e01820d6bf41b0ac0cc3596a75c5210f8"], "node": "76bb02f2798c97b0555b406fc78cce1b938eba8b", "parents": ["6dfed49214f44bb75d1fe0b838d27896c2758faf"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2072590: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "11eb7bfbf67cc791653e7398e3fbe96decad3224", "git_parents": ["1173cb9d95d80d155b73786ee8b08bb6b0ff9e60"], "node": "37b17d8be1272523294c89a894aff9299d9f9a7d", "parents": ["76bb02f2798c97b0555b406fc78cce1b938eba8b"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074428 - Add light-dark solid background color behind default-theme translucent linear background gradient colors. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328107\n", "files": ["toolkit/mozapps/extensions/default-theme/preview-nova.svg"], "git_node": "72336c542b812f4d430bce700f25cb889efbb60f", "git_parents": ["11eb7bfbf67cc791653e7398e3fbe96decad3224"], "node": "4c9f2282024b82bf8e322bceed16b935a75e015d", "parents": ["37b17d8be1272523294c89a894aff9299d9f9a7d"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2072895 - clear NonRudeHWND before going fullscreen r=win-reviewers,handyman\n\nIt seems that the Windows shell only looks at NonRudeHWND when the window\nis resized, so setting it later doesn't seem to have an effect. This\nchange has us set it before the window is resized.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327972\n", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindowTaskbarConcealer.cpp", "widget/windows/nsWindowTaskbarConcealer.h"], "git_node": "5260971eeff22cb07a84358513b7fc17e7c842aa", "git_parents": ["72336c542b812f4d430bce700f25cb889efbb60f"], "node": "63ed36c99747620b983e74987834e6c4bb080611", "parents": ["4c9f2282024b82bf8e322bceed16b935a75e015d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071626 - Carry layer state over a frameloader replacement and report the change in the browser's layers. r=dom-core-reviewers,tabbrowser-reviewers,jsudiaman,smaug\n\nNeither a destroyed nor a bfcached BrowserParent reports a layer change, and the new frameloader lost the old one's renderLayers, preservation and priority hint, so AsyncTabSwitcher could wait forever on a warmed, unloading or bfcache-restored tab. Both paths now carry the state and dispatch MozLayerTreeCleared or MozLayerTreeReady when the browser's layers changed, a bfcache restore once its documents are active. A bfcached BrowserParent's own layer changes stay off the browser, which shows another page.\n\nWithout a BrowserParent to carry from, the new one takes the BrowsingContext's active state.\n\nTransferLayerState creates the BrowserParent when the browser has no frame yet; construct() would otherwise create it later with rendering on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327251\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/docs/async-tab-switcher.md", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tabswitch_remoteness_change.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabswitch_remoteness_change_bfcache.js", "docshell/shistory/nsSHistory.cpp", "dom/base/nsFrameLoaderOwner.cpp", "dom/base/nsFrameLoaderOwner.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "1e59f0c342147356d66aeac64c0a5b3bf638768f", "git_parents": ["5260971eeff22cb07a84358513b7fc17e7c842aa"], "node": "95a6f34dcac2b46d875431f038d8e266d6b24416", "parents": ["63ed36c99747620b983e74987834e6c4bb080611"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1817966 - [devtools] Ensure rejecting invalid source map with no sources. r=devtools-reviewers,nchevobbe\n\nThis ensures that any subsequent `getSourceMap` call would reject\nand so avoid processing with a buggy source map.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326586\n", "files": ["devtools/client/debugger/test/mochitest/browser_gp.toml", "devtools/client/shared/source-map-loader/source-map.js", "devtools/client/shared/source-map-loader/utils/fetchSourceMap.js"], "git_node": "dc7b98d2c2891bf5c84ed718ce4c720e922e1230", "git_parents": ["1e59f0c342147356d66aeac64c0a5b3bf638768f"], "node": "3685fbf1b8429ff68db7285f9c46cd20b2105463", "parents": ["95a6f34dcac2b46d875431f038d8e266d6b24416"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2064871 - Add debug drawer helpers to visualize listen timeline changes r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327399\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/listentopage/ListenToPageTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/navigation/DebugDrawerRoute.kt"], "git_node": "07fb7e7fe3168011643e031d791b30f4c465e2ec", "git_parents": ["dc7b98d2c2891bf5c84ed718ce4c720e922e1230"], "node": "3264f79f5dfe0bf6e9d8a01bf747a386b71ae702", "parents": ["3685fbf1b8429ff68db7285f9c46cd20b2105463"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2064871 - Seek to a position in the article r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328018\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ProgressMapper.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueue.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ProgressMapperTest.kt"], "git_node": "f1d4f5dc1fc9838bf78cd31cd270b3bf6911e31e", "git_parents": ["07fb7e7fe3168011643e031d791b30f4c465e2ec"], "node": "56e3e3e201bccc4b9721a8e450f3aeab514e86ce", "parents": ["3264f79f5dfe0bf6e9d8a01bf747a386b71ae702"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073499 - Use theme-adaptive design tokens for about:policies Active table borders r=joporter,desktop-theme-reviewers,dao\n\nabout:policies used a custom 2px border with hardcoded light colors for the separators in the Active policies table. Those colors do not adapt to dark theme. Switch to the standard theme-adaptive tokens var(--border-width) solid var(--table-border-color), which render correctly in both light and dark themes and match other in-content tables.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327397\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.css"], "git_node": "ac9d3fa8b01079ba1919a19a0d4407a91a26da66", "git_parents": ["f1d4f5dc1fc9838bf78cd31cd270b3bf6911e31e"], "node": "d24f956846991d27aa6bcf144d62a5074c1ab147", "parents": ["56e3e3e201bccc4b9721a8e450f3aeab514e86ce"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2067285 - Wire removal from autocomplete dropdown for saved logins. r=mtigley,joschmidt,dimi\n\n`#confirmLoginRemoval(loginGuid)` consumes the boolean\n`AutocompleteRemoveRecord.confirmRemoval` already returned and calls\n`Services.logins.removeLoginAsync`, so confirming the prompt removes the login\ninstead of only dismissing the dialog.\n\n`#findRemovableLogin(origin, guid)` looks the guid up and hands the stored\n`nsILoginInfo` to `removeLoginAsync`. Since the guid arrives in `fillMessageData`,\nwhich `LoginAutoCompleteResult` authors in the content process, the\nparent-side `get origin()` vouches for it through `isOriginMatching`, accepting\nexactly what the dropdown could list. `searchLoginsAsync` drops every other key\nonce `guid` is present, so `origin` cannot scope the search itself. `origin` is\nread before the prompts, which can destroy the actor.\n\n`PasswordManager:clearFieldsFilledWithLogin` -\u003e `#clearFieldsFilledWithLogin(guid)`\nempties the fields `fillsByRootElement` recorded for the controlled form when\nthat fill's guid matches, while the login is still in storage so the `input`\nevents match a saved record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324771\n", "files": ["toolkit/components/passwordmgr/LoginManagerParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js"], "git_node": "cf8d93ba0181f88bb66704a68b49a557e8f9aabc", "git_parents": ["ac9d3fa8b01079ba1919a19a0d4407a91a26da66"], "node": "ae6a0beae3e2aae121a6f7d9af8f4cf01d37b792", "parents": ["d24f956846991d27aa6bcf144d62a5074c1ab147"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074198 - Move EditContext initialization to separate Init() method. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328155\n", "files": ["dom/html/EditContext.cpp", "dom/html/EditContext.h"], "git_node": "dbd6f24e1735ca465561afa18c8e644ecde183f5", "git_parents": ["cf8d93ba0181f88bb66704a68b49a557e8f9aabc"], "node": "40d9fcf86349291db5f0d2b5f12b721e604090f0", "parents": ["ae6a0beae3e2aae121a6f7d9af8f4cf01d37b792"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068234 - Make split view tabs selectable from the edge of the tab strip. r=kcochrane,desktop-theme-reviewers,tabbrowser-reviewers\n\nThe dragstart test from bug 2033520 dragged from the tab strip below a split view wrapper, which is now the tab's own hit area, so it now checks that the drag grabs the tab above.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327230\n", "files": ["browser/components/tabbrowser/test/browser/dragdrop/browser_drag_splitview.js", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_click_target.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "d7e6867ae05f18fdb33da18d816affe7eee0b678", "git_parents": ["dbd6f24e1735ca465561afa18c8e644ecde183f5"], "node": "d972488b98867286dc52f549f68c933e9b03d244", "parents": ["40d9fcf86349291db5f0d2b5f12b721e604090f0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072670 - Shrink the Bing and grow the DuckDuckGo wordmark in the New Tab search bar. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328183\n", "files": ["browser/themes/shared/urlbar.css", "browser/themes/shared/urlbar/engine-wordmarks/Bing.svg", "browser/themes/shared/urlbar/engine-wordmarks/DuckDuckGo.svg"], "git_node": "91c5057ed065892ca925f6b353497f84b13368c4", "git_parents": ["d7e6867ae05f18fdb33da18d816affe7eee0b678"], "node": "cbff72df02fd6886bc527309595d6c6728fec362", "parents": ["d972488b98867286dc52f549f68c933e9b03d244"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066197 - Fixes the focus order on the PDF tools FAB r=android-reviewers,accessibility-frontend-reviewers,morgan,tcampbell\n\nPrevious focus order was toolbar -\u003e content -\u003e PDF tools, which hides the PDF FABs deep in the linear focus order.\n\nNew focus order is toolbar -\u003e PDF tools -\u003e content.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327014\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt"], "git_node": "bbe17f0769caddcd97c7aa4324c097f814681ed3", "git_parents": ["91c5057ed065892ca925f6b353497f84b13368c4"], "node": "e827258df43f2728524b816c2482448dc7860af1", "parents": ["cbff72df02fd6886bc527309595d6c6728fec362"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064871 - Seek to a position in the article r=android-reviewers,moyin\" for causing fenix failures on PlaybackController.\n\nThis reverts commit f1d4f5dc1fc9838bf78cd31cd270b3bf6911e31e.\n\nRevert \"Bug 2064871 - Add debug drawer helpers to visualize listen timeline changes r=android-reviewers,moyin\"\n\nThis reverts commit 07fb7e7fe3168011643e031d791b30f4c465e2ec.\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ProgressMapper.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueue.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ProgressMapperTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/listentopage/ListenToPageTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/navigation/DebugDrawerRoute.kt"], "git_node": "b721847a9fdebfde82b3a4c2142988c8a79e9b47", "git_parents": ["bbe17f0769caddcd97c7aa4324c097f814681ed3"], "node": "a9d745a841a7b06a4e6750362fdae65f5fd27583", "parents": ["e827258df43f2728524b816c2482448dc7860af1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057979 - Part 1 - Add `--disable-makefile-installer-build` configure flag r=firefox-build-system-reviewers,sergesanspaille,cdupuis\n\nThis stack implements a new Windows installer build alongside the\nMakefile one. This flag selects which implementation is used. The\nenv var takes precedence over the `--disable-makefile-installer-build`\nflag to make diffoscope testing easier.\n\nIn the end, this is all temporary and will be removed when we rip out\nthe Makefile installer build implementation for good.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314299\n", "files": ["moz.configure"], "git_node": "e183fb230b2918177ee6eb39b1d231d93d31c04d", "git_parents": ["b721847a9fdebfde82b3a4c2142988c8a79e9b47"], "node": "b10af03bdc924d62678f9194073d5b47d55bde1f", "parents": ["a9d745a841a7b06a4e6750362fdae65f5fd27583"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057979 - Part 2 - Move the Windows NSIS installer inputs out of Make r=cdupuis,firefox-build-system-reviewers,sergesanspaille\n\nMoves the NSIS static file manifests into `mozbuild.nsis`, and its SFX\nmodule, UPX toggle, and preprocessor defines into `moz.configure`.\nConfigure temporarily exports the manifests for legacy Make, while\nPython consumers import them directly.\n\nThe defines become a single shell quoted `NSIS_INSTALLER_DEFINES` so\nvalues with spaces survive Make expansion. This also removes the\nduplicated `DEFINES` from `browser/installer/windows/moz.build`. Only\n`browser/moz.configure` sets the subst, so another application that\nincludes `makensis.mk` has to set it for the shared `helper.exe` recipe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314300\n", "files": ["browser/installer/windows/Makefile.in", "browser/installer/windows/docs/NSISPlugins.md", "browser/installer/windows/moz.build", "browser/moz.configure", "moz.configure", "python/mozbuild/mozbuild/nsis.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_nsis.py", "toolkit/moz.configure", "toolkit/mozapps/installer/windows/nsis/makensis.mk"], "git_node": "47713c0b3f1b78c66872493ca01958f8be2e7503", "git_parents": ["e183fb230b2918177ee6eb39b1d231d93d31c04d"], "node": "b16f18327efcd4fe6ba5dbd1ef2ca0e2abbc934c", "parents": ["b10af03bdc924d62678f9194073d5b47d55bde1f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057979 - Part 3 - Add `nsis_stage` action r=cdupuis,firefox-build-system-reviewers,sergesanspaille\n\n`nsis_stage` populates a `CONFIG_DIR` with the files makensis needs,\ngenerates `defines.nsi`, and preprocesses the installer locale files.\nSeparating staging from the makensis compile lets several installers\nshare one staged directory.\n\n`--spec-out` records the resolved inputs so a localized repack can restage\nthem for its locale with `stage_repack`, substituting only the locale and\nthe merged strings directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314302\n", "files": ["python/mozbuild/mozbuild/action/nsis_stage.py", "python/mozbuild/mozbuild/test/action/test_nsis_stage.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "67b1c7cd6dc524c9c4e77e7490bead7f516875e1", "git_parents": ["47713c0b3f1b78c66872493ca01958f8be2e7503"], "node": "bcb9f487774c8177add50d8d7415e966893f14f1", "parents": ["b16f18327efcd4fe6ba5dbd1ef2ca0e2abbc934c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057979 - Part 4 - Add `nsis_build` action r=firefox-build-system-reviewers,sergesanspaille\n\n`nsis_build` runs makensis on a single `.nsi` script in an already\nstaged `CONFIG_DIR` and optionally copies the produced executable\nto its output path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314301\n", "files": ["python/mozbuild/mozbuild/action/nsis_build.py", "python/mozbuild/mozbuild/test/action/test_nsis_build.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "950f39534a33b0b5e0d1432ff7430d8be4e3505f", "git_parents": ["67b1c7cd6dc524c9c4e77e7490bead7f516875e1"], "node": "6388614e5e2b51948a4ac4a7f990c41ea9239c65", "parents": ["bcb9f487774c8177add50d8d7415e966893f14f1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057979 - Part 5 - Declare the NSIS staging and installer builds as build edges r=cdupuis,firefox-build-system-reviewers,browser-installer-reviewers,sergesanspaille\n\n`uninstaller` runs during the application build so that `helper.exe` exists when\nthe mar is generated. Nothing enforces that, so losing the ordering produces a\nmar missing its uninstaller rather than a build failure.\n\nThe three staging recipes were supersets of one another, not merely similar.\n`helper.exe` and `maintenanceservice_installer` staged a byte identical set and\n`setup.exe` added three steps on top, so one staging pass now serves all three\nbuilds. The `.nsi` scripts reach staged files only by explicit name, through\n`!include` and through `File /oname=`, so files a build does not name are\nignored.\n\n`FileAvoidWrite` leaves an unchanged file's mtime alone, so the staging stamp\nholds a digest of the staged tree. A constant stamp would never go newer than its\ninputs and the edge would rerun on every build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321372\n", "files": ["browser/Makefile.in", "browser/installer/windows/moz.build"], "git_node": "813af80a0757a0ccb63d8f6e3e15a948d5914e95", "git_parents": ["950f39534a33b0b5e0d1432ff7430d8be4e3505f"], "node": "8ef4453380f15543d919b80fdc4e33be17203389", "parents": ["6388614e5e2b51948a4ac4a7f990c41ea9239c65"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057979 - Part 6 - Build the Windows installer with `nsis_stage` and `nsis_build` when `MOZ_USE_MAKEFILE_INSTALLER_BUILD` is false r=cdupuis,firefox-build-system-reviewers,browser-installer-reviewers,sergesanspaille\n\nWith the flag set (the default) the Makefile recipes run unchanged.\nWith it unset, `setup.exe`, the stub, the uninstaller, the maintenance\nservice installer, and the test stub stage their `CONFIG_DIR` with\n`nsis_stage` and compile each `.nsi` with `nsis_build`, and\n`l10n_repackage` calls both directly for the repack uninstaller. The\ntest stub and `setup.exe` share one staging step.\n\n`l10n_repackage` restages from the inputs the app's own staging edge\nrecorded in `nsis-stage.json`, so shared code never names an app directory\nand comm only has to declare its own edge.\n\nA locale repack objdir only builds the export tier, so `installers-%` lists\nthe staging stamp as a prerequisite. The stamp rule lives in the top level\nbackend file, where the top level `installers-%` rule can ask for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314303\n", "files": ["browser/build.mk", "browser/installer/windows/Makefile.in", "browser/installer/windows/moz.build", "browser/installer/windows/nsis/Makefile.in", "python/mozbuild/mozbuild/action/l10n_repackage.py", "python/mozbuild/mozbuild/test/action/test_l10n_repackage.py", "python/mozbuild/mozbuild/test/python.toml", "toolkit/mozapps/installer/windows/nsis/makensis.mk"], "git_node": "7dd4b6cb4867cf7c46b8d4e79d8c84250771ef57", "git_parents": ["813af80a0757a0ccb63d8f6e3e15a948d5914e95"], "node": "59dcfce40a574a43c38da0010abaa9c2858e7a57", "parents": ["8ef4453380f15543d919b80fdc4e33be17203389"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040501 - record click_view_all_synced_tabs glean events for avatar and app menus when view all synced tabs button is selected. r=sync-reviewers,LougeniaBailey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326326\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser.toml", "browser/base/content/test/browser-sync/browser_sync_device_view_all_tabs_telemetry.js", "services/sync/modules/metrics.yaml"], "git_node": "5101e817656fd392013918e791fa87b908141aa7", "git_parents": ["7dd4b6cb4867cf7c46b8d4e79d8c84250771ef57"], "node": "70f2ba470ff179ddb8da9f002df6de2d837ec8c6", "parents": ["59dcfce40a574a43c38da0010abaa9c2858e7a57"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074319 - make PiP Shift+Tab key press focus on preceding control, not just the seek backward button. r=mconley\n\nThis patch fixes a 'gap' when pressing Shift + Tab after opening the PiP window for the first time. On regular window\nsizes, where all PiP controls are visible, Shift + Tab would focus on the seek backward button. But on live videos or smaller\nwindow dimensions, the seek backward button is not rendered. To address this, allow PiP to find the next button\npreceding the play/pause button if the seek backward button is unavailable. On macOS, this is normally the unpip button, whereas\non other platforms it is the close button.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328218\n", "files": ["toolkit/components/pictureinpicture/content/player.js", "toolkit/components/pictureinpicture/tests/browser_controlsTabOrder.js", "toolkit/components/pictureinpicture/tests/head.js"], "git_node": "a6b2d91b13903a6ccd542fe3394c058af90b47b0", "git_parents": ["5101e817656fd392013918e791fa87b908141aa7"], "node": "f7b3b8e6ec12db285ff9a5f1e712330543fdb008", "parents": ["70f2ba470ff179ddb8da9f002df6de2d837ec8c6"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065228 - remove `hidden` features from session state r=sfoster\n\nDuring manual session restore, only use existing windows that can be modified to match the restoring window. In particular, we will no longer convert popup windows into normal windows and vice versa.\n\nThis will lead in some cases to opening one more window than we used to on manual session restore.\n\nAfter bug 2060396 and bug 2064683, the only hideable element left is the toolbar, but it can only be hidden at window creation time. It's no longer possible to change the visibility of chrome elements in existing windows via bar properties.\n\nWe already store `isPopup` on window state and the value is determined by toolbar visibility.\n\nThis means that each window's `hidden` string no longer does anything and no longer stores any unique information.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322711\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/session.schema.json", "browser/components/sessionstore/test/browser_354894_perwindowpb.js", "browser/components/sessionstore/test/browser_495495.js", "browser/components/sessionstore/test/browser_597071.js", "browser/components/sessionstore/test/browser_oldformat.toml", "browser/components/sessionstore/test/browser_restored_window_features.js", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_close_last_nonpopup_window.py", "browser/components/sessionstore/test/marionette/test_restore_last_session_window_mismatch.py"], "git_node": "8dc8126e6ecbe1c7fbb49b8b5cc1a30862ff7a09", "git_parents": ["a6b2d91b13903a6ccd542fe3394c058af90b47b0"], "node": "3f1daf8b09a6092989063e8ee1fdcb3794c51c1c", "parents": ["f7b3b8e6ec12db285ff9a5f1e712330543fdb008"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066315 - store and restore window arguments r=pdahiya,sfoster\n\nStore the `web-extension-popup-window` and `chromeless-window` window arguments on corresponding windows' state and restore windows with those arguments. This fixes a recently introduced issue where restoring a previous session could result in an add-on popup window or chromeless popup window that incorrectly show their URL bars.\n\nBug 2064683 removed the `CHROME_LOCATIONBAR` chrome flag and related CSS rules that hide the URL bar on some windows. The patch replaced the specific `location` window feature with more targeted use-based window arguments.\n\n`web-extension-popup-window` applies to popup windows opened by WebExtensions/add-ons.\n\n`chromeless-window` applies to popup windows that request to be chromeless, all of which seem to come from the Messaging system at this time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322713\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/session.schema.json", "browser/components/sessionstore/test/browser_restored_window_features.js", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_close_last_nonpopup_window.py", "browser/components/sessionstore/test/marionette/test_restore_last_session_window_mismatch.py"], "git_node": "b808073d8409b3880c896f6e93c3c2350e3d7136", "git_parents": ["8dc8126e6ecbe1c7fbb49b8b5cc1a30862ff7a09"], "node": "0baee5df166db39cb2f364b9c2b9298b0514b685", "parents": ["3f1daf8b09a6092989063e8ee1fdcb3794c51c1c"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070404 - add telemetry about restoring into mismatched windows r=sfoster\n\nThis patch records when SessionRestore.#restoreWindows was asked to restore state into a window that has immutable window features. In these cases, affected windows won't be fully restored to the desired state, so there may be bugs or other issues that result. This patch only provides a warning log and records the window features so that we can learn more about any code paths or window features need to be updated before we can fully prevent SessionStore from reusing unsuitable windows.\n\nAfter bug 2060396 and bug 2064683, it's no longer possible to change some window features on existing windows. Manual session restore (\"restore last session\") has long had additional logic to avoid unsuitable existing windows to restore into, and the previous patch in this stack hardens that code.\n\nHowever, that code path is separate from the general \"restore windows\" path. The \"restore windows\" path seems like it has guaranteed to callers that SessionStore will make a window fully conform to a session state. Even though we can't guarantee that anymore, I'm reluctant to make a broad change here because I don't fully understand all of the potential impacts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322712\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_window_features_mismatch_telemetry.js", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_automatic_startup_window_features_mismatch.py", "browser/components/sessionstore/test/marionette/test_automatic_with_taskbar_tab_window_features_mismatch.py", "browser/components/sessionstore/test/marionette/test_deferred_initial_state_window_features_mismatch.py", "browser/components/sessionstore/test/marionette/test_new_tab_on_restore.py", "browser/components/sessionstore/test/marionette/test_restore_last_session_window_mismatch.py", "browser/components/sessionstore/test/marionette/test_set_browser_state_window_features_mismatch.py"], "git_node": "3b7936ef518b3e7ffcbcb48ed5c65877a68602d4", "git_parents": ["b808073d8409b3880c896f6e93c3c2350e3d7136"], "node": "1b9f1b42de7beaffd3952682a857556073353d73", "parents": ["0baee5df166db39cb2f364b9c2b9298b0514b685"], "tags": []}, {"author": "lewisian8787 \u003clewisian8787@gmail.com\u003e", "branch": "default", "desc": "Bug 2072737 - Count session files with an incompatible format version as corrupt. r=sfoster,sessionstore-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327906\n", "files": ["browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/unit/test_glean_backup_can_be_loaded.js"], "git_node": "61cfae557eb9cd1c3d14bd633d091cd5f450e327", "git_parents": ["3b7936ef518b3e7ffcbcb48ed5c65877a68602d4"], "node": "d5b011a9ab188524c587476d0feba05715226748", "parents": ["1b9f1b42de7beaffd3952682a857556073353d73"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Add a `license-declarations` linter for the license declarations r=linter-reviewers,sergesanspaille,ahal\n\nChecks the LICENSES and LICENSED_UNDER declarations across the tree without\nrunning a build: every LICENSED_UNDER id must have a matching LICENSES\ndeclaration somewhere, and every `spdx` flag must be a valid SPDX expression.\nAn id declared twice is rejected by mozbuild.licenses, where the two\ndeclarations are still distinguishable, and is not checked again here.\n\nIt lives in tools/lint/license.yml, next to the `license` header check, rather\nthan in a `licenses.yml` a letter away from it: mozlint selects linters by\nconfiguration file name, so both run under `mach lint -l license` and in the\none taskgraph task, the way file-perm.yml groups its two checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325283\n", "files": ["docs/code-quality/lint/linters/license.md", "python/sites/lint.txt", "taskcluster/config.yml", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/files/license-declarations/bad/bad.build", "tools/lint/test/files/license-declarations/bad/computed.build", "tools/lint/test/files/license-declarations/bad/duplicate.build", "tools/lint/test/files/license-declarations/bad/repeated.build", "tools/lint/test/files/license-declarations/bad/syntax.build", "tools/lint/test/files/license-declarations/good/assigned.mozbuild", "tools/lint/test/files/license-declarations/good/good.build", "tools/lint/test/python.toml", "tools/lint/test/test_file_license.py", "tools/lint/test/test_license_declarations.py"], "git_node": "a4b69a0e0d229d30080656dba07d389289bbd673", "git_parents": ["61cfae557eb9cd1c3d14bd633d091cd5f450e327"], "node": "5db9e01a9b34c4851c30affabc54d7955fab1763", "parents": ["d5b011a9ab188524c587476d0feba05715226748"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Declare every about:license notice in moz.build r=firefox-build-system-reviewers,ipc-reviewers,application-update-reviewers,media-playback-reviewers,credential-management-reviewers,webrtc-reviewers,devtools-reviewers,cubeb-reviewers,profiler-reviewers,win-reviewers,frontend-codestyle-reviewers,ai-platform-reviewers,sandbox-reviewers,crashreporting-reviewers,media-webspeech-reviewers,bobowen,dimi,canova,padenot,nchevobbe,mccr8,yjuglaret,bwc,ahochheiden\n\ntoolkit/content/license.html is a 6451-line preprocessed file holding all 96\nlicense notices, their path lists and their #ifdefs by hand. This moves that\ncontent to the directories that own the code; the page itself is still the\nchecked-in file until the next commits replace it.\n\nEach notice becomes a file next to the code it covers, or in\ntoolkit/content/licenses/ when the text is shared across the tree, plus a\nLICENSES declaration in the owning moz.build. Where one directory owns two\nnotices, gfx/skia owning both android and skia among them, the filename is\nqualified with the license id.\n\nThe per-entry #ifdefs are gone. Six block-level guards became CONFIG\nconditionals; the rest were guarding individual paths and are now implicit,\nsince a directory that is not built is never traversed.\n\nOf the 241 path entries, 52 are attributed by the directory itself and 112 by\ntheir nearest built ancestor. The remaining 77 live under third_party/ and\nnsprpub/, which the build system does not traverse, so they stay as explicit\npaths in toolkit/content/licenses/moz.build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325284\n", "files": [".prettierignore", "browser/extensions/formautofill/moz.build", "build/moz.build", "devtools/client/debugger/dist/LICENSE-NOTICE-babel.txt", "devtools/client/debugger/dist/LICENSE-NOTICE-babylon.txt", "devtools/client/debugger/dist/moz.build", "devtools/client/debugger/moz.build", "devtools/client/inspector/markup/moz.build", "devtools/client/netmonitor/src/components/messages/parsers/moz.build", "devtools/client/netmonitor/src/utils/moz.build", "devtools/client/shared/sourceeditor/codemirror6/LICENSE-NOTICE.txt", "devtools/client/shared/sourceeditor/codemirror6/moz.build", "devtools/client/shared/sourceeditor/moz.build", "devtools/client/shared/vendor/LICENSE-NOTICE.txt", "devtools/client/shared/vendor/moz.build", "devtools/client/shared/widgets/moz.build", "devtools/shared/jsbeautify/moz.build", "devtools/shared/moz.build", "devtools/shared/network-observer/moz.build", "devtools/shared/storage/vendor/stringvalidator/LICENSE-NOTICE.txt", "devtools/shared/storage/vendor/stringvalidator/moz.build", "dom/media/systemservices/moz.build", "dom/media/webaudio/blink/moz.build", "dom/media/webrtc/transport/moz.build", "dom/media/webrtc/transport/test/moz.build", "dom/media/webspeech/recognition/moz.build", "dom/moz.build", "editor/libeditor/moz.build", "extensions/auth/moz.build", "extensions/spellcheck/hunspell/LICENSE-NOTICE.txt", "extensions/spellcheck/hunspell/moz.build", "extensions/spellcheck/moz.build", "gfx/angle/LICENSE-NOTICE.txt", "gfx/angle/moz.build", "gfx/cairo/LICENSE-NOTICE.txt", "gfx/cairo/moz.build", "gfx/moz.build", "gfx/pixman/moz.build", "gfx/qcms/LICENSE-NOTICE.txt", "gfx/qcms/moz.build", "gfx/skia/LICENSE-NOTICE-android.txt", "gfx/skia/LICENSE-NOTICE-skia.txt", "gfx/skia/moz.build", "gfx/thebes/LICENSE-NOTICE.txt", "gfx/thebes/moz.build", "gfx/vr/service/openvr/LICENSE-NOTICE.txt", "gfx/vr/service/openvr/moz.build", "gfx/ycbcr/moz.build", "intl/components/src/calendar/moz.build", "intl/moz.build", "ipc/chromium/moz.build", "ipc/chromium/src/third_party/moz.build", "js/src/builtin/moz.build", "js/src/ctypes/moz.build", "js/src/irregexp/moz.build", "js/src/jit/moz.build", "js/src/util/moz.build", "js/src/vm/moz.build", "js/src/vtune/moz.build", "js/src/xsum/moz.build", "js/src/zydis/moz.build", "media/libcubeb/LICENSE-NOTICE.txt", "media/libcubeb/moz.build", "media/libnestegg/LICENSE-NOTICE.txt", "media/libnestegg/moz.build", "media/libnestegg/src/LICENSE-NOTICE.txt", "media/libnestegg/src/moz.build", "media/libogg/moz.build", "media/libsoundtouch/src/LICENSE-NOTICE.txt", "media/libsoundtouch/src/moz.build", "media/libspeex_resampler/moz.build", "media/libvorbis/moz.build", "media/libvpx/LICENSE-NOTICE.txt", "media/libvpx/moz.build", "media/libyuv/LICENSE-NOTICE.txt", "media/libyuv/moz.build", "memory/build/LICENSE-NOTICE.txt", "memory/build/moz.build", "mfbt/moz.build", "mfbt/tests/gtest/moz.build", "modules/fdlibm/src/moz.build", "modules/woff2/moz.build", "mozglue/baseprofiler/moz.build", "netwerk/dns/LICENSE-NOTICE.txt", "netwerk/dns/moz.build", "netwerk/sctp/src/LICENSE-NOTICE.txt", "netwerk/sctp/src/moz.build", "netwerk/wifi/moz.build", "other-licenses/snappy/LICENSE-NOTICE.txt", "other-licenses/snappy/moz.build", "parser/expat/LICENSE-NOTICE.txt", "parser/expat/moz.build", "python/mozbuild/mozbuild/vendor/vendor_manifest.py", "security/moz.build", "security/sandbox/moz.build", "third_party/js/prosemirror/moz.build", "third_party/libwebrtc/moz.build", "third_party/llama.cpp/moz.build", "third_party/msgpack/moz.build", "third_party/perfetto/moz.build", "third_party/zstd/moz.build", "third_party/zucchini/moz.build", "toolkit/components/formautofill/moz.build", "toolkit/components/jsoncpp/moz.build", "toolkit/components/ml/moz.build", "toolkit/components/passwordmgr/moz.build", "toolkit/components/protobuf/moz.build", "toolkit/components/reputationservice/moz.build", "toolkit/components/resistfingerprinting/moz.build", "toolkit/components/url-classifier/moz.build", "toolkit/content/licenses/acorn.txt", "toolkit/content/licenses/apache-llvm.txt", "toolkit/content/licenses/apache.txt", "toolkit/content/licenses/apple-password-rules-parser.txt", "toolkit/content/licenses/apple.txt", "toolkit/content/licenses/arm.txt", "toolkit/content/licenses/boost.txt", "toolkit/content/licenses/bsd2clause.txt", "toolkit/content/licenses/bsd3clause.txt", "toolkit/content/licenses/bspatch.txt", "toolkit/content/licenses/chromium.txt", "toolkit/content/licenses/codemirror.txt", "toolkit/content/licenses/cryptogams.txt", "toolkit/content/licenses/cubic-bezier.txt", "toolkit/content/licenses/d3.txt", "toolkit/content/licenses/dagre-d3.txt", "toolkit/content/licenses/diff.txt", "toolkit/content/licenses/disconnect.me.html", "toolkit/content/licenses/dtoa.txt", "toolkit/content/licenses/dxcompiler-deps.html", "toolkit/content/licenses/firebug.txt", "toolkit/content/licenses/gears-istumbler.txt", "toolkit/content/licenses/gfx-font-list.txt", "toolkit/content/licenses/google-bsd.txt", "toolkit/content/licenses/gyp.txt", "toolkit/content/licenses/harfbuzz.txt", "toolkit/content/licenses/hunspell-ee.txt", "toolkit/content/licenses/hunspell-en.html", "toolkit/content/licenses/hunspell-lt.txt", "toolkit/content/licenses/hunspell-nl.txt", "toolkit/content/licenses/hunspell-ru.txt", "toolkit/content/licenses/immutable.txt", "toolkit/content/licenses/jquery.txt", "toolkit/content/licenses/k_exp.txt", "toolkit/content/licenses/lgpl-3.0.html", "toolkit/content/licenses/lgpl.html", "toolkit/content/licenses/libc++.txt", "toolkit/content/licenses/libevent.txt", "toolkit/content/licenses/libffi.txt", "toolkit/content/licenses/libjingle.txt", "toolkit/content/licenses/llvm.txt", "toolkit/content/licenses/lodash.txt", "toolkit/content/licenses/mit.txt", "toolkit/content/licenses/moz.build", "toolkit/content/licenses/mpl.html", "toolkit/content/licenses/nicer.txt", "toolkit/content/licenses/nom.txt", "toolkit/content/licenses/nrappkit-cont-1.html", "toolkit/content/licenses/nrappkit-cont-2.txt", "toolkit/content/licenses/nrappkit-cont-3.txt", "toolkit/content/licenses/nrappkit.txt", "toolkit/content/licenses/openvision.txt", "toolkit/content/licenses/praton.txt", "toolkit/content/licenses/praton1.txt", "toolkit/content/licenses/prosemirror.html", "toolkit/content/licenses/qrcode-generator.txt", "toolkit/content/licenses/react-redux.txt", "toolkit/content/licenses/react.txt", "toolkit/content/licenses/redux.txt", "toolkit/content/licenses/sprintf.js.txt", "toolkit/content/licenses/sunsoft.txt", "toolkit/content/licenses/superfasthash.txt", "toolkit/content/licenses/twemoji.txt", "toolkit/content/licenses/ucal.html", "toolkit/content/licenses/unicase.txt", "toolkit/content/licenses/unicode-v3.txt", "toolkit/content/licenses/unicode.txt", "toolkit/content/licenses/v8.txt", "toolkit/content/licenses/vtune.txt", "toolkit/content/licenses/webrtc.txt", "toolkit/content/licenses/x264.txt", "toolkit/content/licenses/xdg.txt", "toolkit/content/licenses/xiph.txt", "toolkit/content/moz.build", "toolkit/crashreporter/moz.build", "toolkit/mozapps/update/updater/bspatch/moz.build", "tools/lint/file-whitespace.yml", "tools/lint/license.yml", "tools/profiler/moz.build", "widget/cocoa/moz.build", "widget/windows/moz.build", "xpcom/base/moz.build", "xpcom/io/moz.build"], "git_node": "8c79875a596a173c95c2a742943ee42884e9af3d", "git_parents": ["a4b69a0e0d229d30080656dba07d389289bbd673"], "node": "2aeb4bdc20f70fe63ccd4bdc14a0b9e865a9ab0b", "parents": ["5db9e01a9b34c4851c30affabc54d7955fab1763"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Render about:license from the LICENSES declarations r=firefox-build-system-reviewers,sergesanspaille\n\nlicense.html.mako and gen_license_html.py render the page from licenses.json\nthrough GENERATED_FILES, so jar.mn no longer needs the preprocessor. Firefox\nkeeps its own copy, the shared page plus the Mozilla binaries notice, which\njar.mn goes on overriding chrome://global/content/license.html with.\n\nThe blocks an application splices into the page come in as extra inputs rather\nthan through APP_LICENSE_BLOCK and its siblings. Those were an #includesubst of\na path held in a per-directory DEFINE, which a script driven by GENERATED_FILES\ncannot read: buildconfig carries the global configuration, not what one\nmoz.build defined. Passing the file as an input also puts it in the dependency\nset, so editing the notice rebuilds the page.\n\nA notice stored as a .txt is wrapped in \u003cpre\u003e and escaped; one that carries\nmarkup of its own is stored as .html and emitted verbatim. Nine do, including\nthe MPL and the LGPLs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325285\n", "files": ["browser/base/jar.mn", "browser/base/moz.build", "toolkit/content/gen_license_html.py", "toolkit/content/jar.mn", "toolkit/content/license.html.mako", "toolkit/content/moz.build", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/files/license-declarations/bad/bad.build", "tools/lint/test/test_license_declarations.py"], "git_node": "bf736acd01e59a3eb3fa514ea0871f6661663673", "git_parents": ["8c79875a596a173c95c2a742943ee42884e9af3d"], "node": "0f59ab38b1364c916953f7d1a7beee2328524344", "parents": ["2aeb4bdc20f70fe63ccd4bdc14a0b9e865a9ab0b"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Remove the hand-maintained license.html r=firefox-build-system-reviewers,sergesanspaille,frontend-codestyle-reviewers\n\nThe page is generated now, so the preprocessed file goes away.\n\nIt carries the same data as before. Comparing the union across all four\nplatforms the old file knew about, with every feature flag on, against the\nunion rendered from licenses.json: same 96 rows, no title changed, no path\ndropped, and every license body preserved, modulo ten notices where a named\ncharacter entity is now stored decoded (&copy; as the literal character),\nwhich renders identically.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325286\n", "files": [".prettierignore", "toolkit/content/license.html"], "git_node": "e495153bacfbcb85cb3b713a63c97a908929d432", "git_parents": ["bf736acd01e59a3eb3fa514ea0871f6661663673"], "node": "298c14cefe8fa7617a10023a0400f4092de99c2a", "parents": ["0f59ab38b1364c916953f7d1a7beee2328524344"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070827 - Attach the moz.build license notices to the SBOM components r=mach-reviewers,ahochheiden\n\nmoz.yaml carries a license field but no notice text, and it only exists for\nvendored libraries; the LICENSES declarations cover directories moz.yaml knows\nnothing about. Where both describe the same code, the notice ids are recorded\non the component as a moz:license.notice-ids property, matching on exact,\nparent-directory and glob paths. Where moz.yaml declared no license at all,\nthe notice's SPDX expression fills the gap.\n\nWhere a notice names paths inside the component -- one file of a vendored\nlibrary rather than the library -- those paths are kept as CycloneDX evidence\noccurrences. The notice ids alone would lose which files the attribution came\nfrom.\n\nlicenses.json is written by the build backend, so it is absent in an\nunconfigured tree; the SBOM is then built from moz.yaml alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325287\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/vendor/sbom.py"], "git_node": "5f0b9a0479ef3ad6adbaa442e916edfd72d93ac4", "git_parents": ["e495153bacfbcb85cb3b713a63c97a908929d432"], "node": "c3f996a304ed4742d0e10828a448036ca1fceaf3", "parents": ["298c14cefe8fa7617a10023a0400f4092de99c2a"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Add `mach licenses` to render about:license without a build r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahochheiden\n\nRenders the page straight from the tree's LICENSES declarations, so a change to\na notice or to the template can be checked without building:\n\n    ./mach licenses -o /tmp/license.html\n\nThe tree has to be configured, since the configuration decides which\ndirectories are traversed and so which notices exist, but nothing beyond\n./mach configure is needed: the command reads the moz.builds itself rather than\nwaiting for the backend to write licenses.json. An unconfigured tree is\nrefused rather than rendered as a silent subset.\n\nIt joins `mach sbom` in mozbuild/licensing_commands.py and runs in the same\n`build` site, which is where mako already is because GENERATED_FILES renders\nthe page from the same template during a build.\n\nMachine-readable output is deliberately not offered here; that is what\n`mach sbom` is for.\n\nThe aggregation moves to mozbuild/licenses.py, shared with the build backend so\nthe command and licenses.json cannot drift, and the per-context extraction moves\nthere too: the command cannot run the full emitter, since objects like Library\nneed an objdir it does not have.\n\nThe page rendered is the application's own copy, the one Firefox ships: the\nblocks browser/base splices in, the Mozilla binaries notice among them, are\nread back off that directory's GENERATED_FILES[\"license.html\"] inputs rather\nthan named again here, so the command and the build cannot disagree about\nthem.\n\ngen_license_html.py grows a render() that takes substs as an argument, leaving\nbuildconfig to main(), which is the GENERATED_FILES entry point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325288\n", "files": ["python/mach/mach/command_util.py", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/licenses.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/frontend/data/licenses-declared-twice/moz.build", "python/mozbuild/mozbuild/test/frontend/data/licenses-declared-twice/notice.txt", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_license_collection.py", "toolkit/content/gen_license_html.py", "tools/lint/license.yml"], "git_node": "9d334255ddb2813ac554b76cf38dfbd58740afd6", "git_parents": ["5f0b9a0479ef3ad6adbaa442e916edfd72d93ac4"], "node": "c70fa62d71eb973f0ee302377f632d3339cfa0a9", "parents": ["c3f996a304ed4742d0e10828a448036ca1fceaf3"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070827 - Represent every about:license notice in the SBOM r=mach-reviewers,ahochheiden\n\nAttaching notices to the moz.yaml components covered only 38 of the 96\nlicenses and 70 of the 248 attributed paths, because moz.yaml exists only for\nvendored libraries. The SBOM therefore described considerably less than\nabout:license did.\n\nLicensed paths that no manifest covers now become components of their own,\ncarrying the notice ids and the SPDX expression where one is known. They are\nshipped third-party code we simply hold less metadata about, so a component\nwith a name and a license beats no record at all.\n\nThe notices about:license reproduces without naming a path, the MPL, the\nbundled spellchecking dictionaries, jQuery and React among them, cannot attach\nto a component. Those go on the root, whose licenses and moz:license.notice-ids\nproperty now name them.\n\nThe SBOM is a superset of about:license: all 96 notice ids and all 248 paths\nare represented, across 293 components, 289 of which carry a license.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325289\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_cyclonedx.py", "python/mozbuild/mozbuild/vendor/sbom.py", "python/mozbuild/mozbuild/vendor/sbom_cyclonedx.py"], "git_node": "6efe1718f95bd07be54b50dfebfde746f121c0da", "git_parents": ["9d334255ddb2813ac554b76cf38dfbd58740afd6"], "node": "c95a9028d9afaa9b4c4be971c083cef411c54a8f", "parents": ["c70fa62d71eb973f0ee302377f632d3339cfa0a9"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070828 - Generate the SBOM on shippable builds r=firefox-build-system-reviewers,taskgraph-reviewers,ahochheiden,sergesanspaille,ahal\n\nNothing in automation produced the bill of materials, so it existed only for\nwhoever ran `mach sbom` locally.\n\nThe document is a GENERATED_FILES entry on the top level moz.build, guarded by\nthe new MOZ_GENERATE_SBOM configure option, so the normal build graph schedules\nit: `licenses.json`, `.cargo/config.toml` and `Cargo.lock` are its extra_deps,\nand the result lands in `\u003cobjdir\u003e/sbom.json`, which automation/upload picks up\nthe way it already picks up config.status. No new automation tier, and nothing\nnew in Makefile.in.\n\n`force` because the generator also reads every tracked moz.yaml and the whole\nCargo.lock graph. Enumerating that as prerequisites would buy little for a\ndocument only the builds that ask for one produce; proper dependency tracking\nis what enabling this by default for local builds would need.\n\nThe build is the right place for this rather than a source-test task, because\nwhich LICENSES declarations are reachable depends on the configuration: a\ndirectory the configuration does not traverse contributes no notice. A single\ntask could only ever describe one platform, and configuring the tree just to\nread it back needs a compile environment to be honest -- without one the tree\nyields 90 of 96 notices and 197 of 248 attributed paths.\n\nMOZ_GENERATE_SBOM is set per task in taskcluster/kinds/build rather than\nderived in the build transform, so whether a given build produces an SBOM is\nvisible where the build is defined. That covers the 20 shippable build tasks\nthat run a build of their own: Linux, Windows and Android, plus devedition,\nand on macOS the per-architecture tasks rather than the universal task that\nonly recombines their output. Artifact builds have no licenses.json, and\nbuild-fat-aar and release-source run no build to describe.\n\nThe generator is strict there: an unparseable moz.yaml fails the build rather\nthan silently shrinking the SBOM. `generate()` and the new `generate_file()`\nentry point share build_document(), so the document `mach sbom` writes is the\none the build writes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325290\n", "files": ["moz.build", "moz.configure", "python/mozbuild/mozbuild/action/generate_sbom.py", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "2bbdda936690f57cd633ccab5e702739c9e364af", "git_parents": ["6efe1718f95bd07be54b50dfebfde746f121c0da"], "node": "e96944916a41b486d18d5c2e8fe9f4c8f5fb13b7", "parents": ["c95a9028d9afaa9b4c4be971c083cef411c54a8f"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070828 - Document the license declarations and the SBOM\n\nThe LICENSES and LICENSED_UNDER variables carry reference documentation\nthrough the mozbuild symbol list, but nothing explained how the pieces fit:\nthat about:license and the SBOM read the same declarations, that licenses.json\nis the seam between them, why `mach vendor licenses` on an unconfigured tree\nreturns a subset, or what the moz: properties on a component mean.\n\nA new page under the vendoring docs covers declaring a notice, both commands,\nwhat becomes a component and why the two sources are merged, the\nreproducibility guarantees, and where to fetch the per-platform SBOM shippable\nbuilds upload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325291\n", "files": ["python/mozbuild/mozbuild/vendor/docs/index.md", "python/mozbuild/mozbuild/vendor/docs/licensing.md"], "git_node": "dbb4be19ca9ae1afcf7c5daa051e214d3c58306b", "git_parents": ["2bbdda936690f57cd633ccab5e702739c9e364af"], "node": "624cd9b7f9a89469361a41e7ef3692b3c4920542", "parents": ["e96944916a41b486d18d5c2e8fe9f4c8f5fb13b7"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Stop repeating moz.yaml in the license declarations r=firefox-build-system-reviewers,linter-reviewers,webrtc-reviewers,gfx-reviewers,bwc,nical,sergesanspaille\n\nA vendored library already states its license in moz.yaml, and that is the\nfield `mach sbom` reports; the `spdx` flag on a LICENSES declaration in the\nsame directory is a second copy of it with nothing keeping the two equal. They\nhad already drifted: media/libyuv declared BSD-3-Clause in moz.build against\nBSD-3-Clause-Clear in moz.yaml, and since the SBOM prefers moz.yaml the wrong\ncopy was the one nobody read.\n\nDrop the flag from the six declarations a moz.yaml already covers. A notice for\ncode whose license differs from the library's own is not a duplicate and keeps\nits flag, now saying so with `subcomponent = True`: the MySpell files inside\nhunspell, whose moz.yaml declares MPL-1.1 for the library itself. The\n`license-declarations` linter reports the rest, so a new declaration cannot\nreintroduce the drift.\n\n`origin.license-file` is the same story. It names the file the library ships\nits license in, and `mach vendor` is what checks that file against upstream, so\na `text` flag naming the same file is a second copy only the manifest keeps\ncurrent. `text` is optional now -- a declaration without one reads its notice\nfrom the `license-file` of the covering moz.yaml -- and the linter reports one\nthat repeats it. That drops the flag from expat and libyuv, and deletes the\nLICENSE-NOTICE.txt copies in gfx/angle, gfx/vr/service/openvr, media/libcubeb\nand media/libnestegg, whose moz.yaml gains the `license-file` it was missing.\nThree of those four were byte-for-byte the shipped file; angle's was the\n2002-2010 text where third_party/angle/LICENSE reads 2018, so about:license\nreproduces the file ANGLE actually ships now, comment markers and all.\n\nThree notice files stay, because none is a copy of a single shipped file, and\neach says why in place: media/libvpx's is LICENSE plus the VP8 patent grant\nupstream keeps in libvpx/PATENTS; netwerk/sctp's reproduces the FreeBSD, Cisco\nand WIDE copyright headers its sources carry, which upstream's LICENSE.md,\ncovering the usrsctp code alone, does not; hunspell's is the MySpell license\nthe files in src/ carry, which upstream ships only as the comment header in\nsrc/license.myspell, and not the library's own COPYING.MPL. Their moz.yaml\nstill gains the `license-file` where it was missing, since the SBOM and\n`mach vendor` want it either way.\n\nmedia/libnestegg/src declared a halloc notice and halloc is no longer in the\ntree: nestegg.c is the only file under it, ISC like the rest of the library,\nas media/libnestegg/moz.yaml already says. Delete the declaration and its\ncopied text rather than keep a heading for code the product does not ship.\n\nThe `subcomponent` flag is carried through to licenses.json and read by the\nSBOM, where the enclosing library's component gains the subcomponent's\nexpression alongside the one moz.yaml declares -- hunspell is MPL-1.1 and\nBSD-2-Clause, not MPL-1.1 alone.\n\nabout:license does not render `spdx`, so the page changes only where the notice\ntext does: it reproduces the license the library actually ships, and loses the\nhalloc heading.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326291\n", "files": ["docs/code-quality/lint/linters/license.md", "extensions/spellcheck/hunspell/moz.build", "gfx/angle/LICENSE-NOTICE.txt", "gfx/angle/moz.build", "gfx/angle/moz.yaml", "gfx/vr/service/openvr/LICENSE-NOTICE.txt", "gfx/vr/service/openvr/moz.build", "gfx/vr/service/openvr/moz.yaml", "media/libcubeb/LICENSE-NOTICE.txt", "media/libcubeb/moz.build", "media/libcubeb/moz.yaml", "media/libnestegg/LICENSE-NOTICE.txt", "media/libnestegg/moz.build", "media/libnestegg/moz.yaml", "media/libnestegg/src/LICENSE-NOTICE.txt", "media/libnestegg/src/moz.build", "media/libvpx/moz.build", "media/libyuv/LICENSE-NOTICE.txt", "media/libyuv/moz.build", "netwerk/sctp/src/moz.build", "netwerk/sctp/src/moz.yaml", "parser/expat/LICENSE-NOTICE.txt", "parser/expat/moz.build", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/licenses.py", "python/mozbuild/mozbuild/test/frontend/data/licenses-no-text/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/test/test_license_collection.py", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/sbom.py", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/files/license-declarations/bad/notice/moz.yaml", "tools/lint/test/files/license-declarations/bad/notice/notice.build", "tools/lint/test/files/license-declarations/bad/vendored/moz.yaml", "tools/lint/test/files/license-declarations/bad/vendored/vendored.build", "tools/lint/test/files/license-declarations/good/notice/moz.yaml", "tools/lint/test/files/license-declarations/good/notice/notice.build", "tools/lint/test/files/license-declarations/good/unlicensed/moz.yaml", "tools/lint/test/files/license-declarations/good/unlicensed/unlicensed.build", "tools/lint/test/files/license-declarations/good/vendored/moz.yaml", "tools/lint/test/files/license-declarations/good/vendored/vendored.build", "tools/lint/test/test_license_declarations.py"], "git_node": "f34bef88d8b4c23a30d7ec2ef043cd42d1c43d98", "git_parents": ["dbb4be19ca9ae1afcf7c5daa051e214d3c58306b"], "node": "8119fd46a462e9f6987b54b4bb41c2e5d49474bf", "parents": ["624cd9b7f9a89469361a41e7ef3692b3c4920542"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Move node-licenses into the legal() Treeherder group r=taskgraph-reviewers,bhearsum\n\nThe group now holds the license checks, and node-licenses is one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327795\n", "files": ["taskcluster/kinds/source-test/mozlint.yml"], "git_node": "e329b6e4e976d70085133545056f53e95988972d", "git_parents": ["f34bef88d8b4c23a30d7ec2ef043cd42d1c43d98"], "node": "65391c9d5c015fe9c70ce681c59abb03a443ab4f", "parents": ["8119fd46a462e9f6987b54b4bb41c2e5d49474bf"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074161: Fix constant folding for MUrsh r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327988\n", "files": ["js/src/jit/MIR.cpp"], "git_node": "2b11fca0dd14eb633c1cf16492ee42d17ee7ca7d", "git_parents": ["e329b6e4e976d70085133545056f53e95988972d"], "node": "ef136fa338e1eb67a8b82e7589200107cc5d10ea", "parents": ["65391c9d5c015fe9c70ce681c59abb03a443ab4f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074161: Add assertion r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327989\n", "files": ["js/src/jit/MIR.cpp"], "git_node": "9207a63782d9438e295abae02adf5c403a1b911c", "git_parents": ["2b11fca0dd14eb633c1cf16492ee42d17ee7ca7d"], "node": "2fde1a98e900607a11d4053a81284145eedd47ce", "parents": ["ef136fa338e1eb67a8b82e7589200107cc5d10ea"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074161: Add test r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327990\n", "files": ["js/src/jit-test/tests/ion/bug2074161.js"], "git_node": "4efe01975fcc04b2fca831547c1d4793afd5b717", "git_parents": ["9207a63782d9438e295abae02adf5c403a1b911c"], "node": "958dcb7ebec8e371aa5fa99e6a58938a0e0ce3e7", "parents": ["2fde1a98e900607a11d4053a81284145eedd47ce"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066606, Bug 2066607 - Re-frame a mini window's crop from a ResizeObserver. r=mconley\" for causing bc and TV tests failures at browser_framing.js\n\nThis reverts commit f6eafad304d152d300121fdfa02fe1a269bd88e9.\n\nRevert \"Bug 2066606 - Add a mute button to the mini window nav-bar. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson\"\n\nThis reverts commit d41bf4afbda9da3d43d2bed9c5fd10367352f8d4.\n\nRevert \"Bug 2066606 - Restyle the mini window toolbar and suppress its sidebar. r=mconley,sidebar-reviewers,sfoster\"\n\nThis reverts commit 6187d5d9a06698748de43c04ebdfc1cda1fdc0d4.\n\nRevert \"Bug 2066606 - Test the mini window flavors. r=mconley\"\n\nThis reverts commit dd14d17a529c27b2590ee41ccc146d113ae3e3c5.\n\nRevert \"Bug 2066606 - Return a cropped mini window's tab home when it navigates away. r=mconley\"\n\nThis reverts commit c4c95030aad90c6e8d7ee5125533c42de7482477.\n\nRevert \"Bug 2066606 - Separate cropped and full tab mini windows. r=mconley,fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,dao,sfoster,bolsson\"\n\nThis reverts commit 57dbd0536f96d210d8b8f24791762b2acc7909fd.\n\nRevert \"Bug 2066607 - Test the mini window screenshots entry points. r=mconley,niklas\"\n\nThis reverts commit 66450b9b4c2a571419a9bb1eeee6f1f0bb802ca7.\n\nRevert \"Bug 2066607 - Add a Use Mini Window item to the content context menu. r=mconley,fluent-reviewers,bolsson\"\n\nThis reverts commit 4f64b55a5115ed8451000e73a302201a9951ffc2.\n\nRevert \"Bug 2066607 - Add the Screenshots mini-window mode and toolbar button. r=mconley,fluent-reviewers,bolsson,niklas,flod\"\n\nThis reverts commit c7d1614b4123f767f811fe23cc9e3fe22ff7d8f9.\n\nRevert \"Bug 2066606 - Add browser-chrome tests for mini window. r=mconley\"\n\nThis reverts commit 293a5b3b53d9f6b6e6fba90373daacc31288be3d.\n\nRevert \"Bug 2066606 - Reuse and restyle the nav-bar as the mini window chrome. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson,urlbar-reviewers\"\n\nThis reverts commit b410f74428e94ca230e986388b084f3fd4a1010d.\n", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/browser.xhtml", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/webext-panels.xhtml", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/moz.build", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_cropped_navigation.js", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_last_tab.js", "browser/components/miniwindow/test/browser/browser_open_close.js", "browser/components/miniwindow/test/browser/browser_origin_close.js", "browser/components/miniwindow/test/browser/browser_placement.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/browser_region_entry.js", "browser/components/miniwindow/test/browser/browser_restore_vs_close.js", "browser/components/miniwindow/test/browser/browser_reveal.js", "browser/components/miniwindow/test/browser/browser_sessionstore.js", "browser/components/miniwindow/test/browser/browser_sidebar.js", "browser/components/miniwindow/test/browser/browser_toolbar.js", "browser/components/miniwindow/test/browser/browser_toolbar_button.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/miniwindow/test/browser/mini-window-crop-target.html", "browser/components/miniwindow/test/browser/mini-window-redirect.html", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "browser/components/miniwindow/test/xpcshell/xpcshell.toml", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsSelectionModes.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "browser/components/screenshots/moz.build", "browser/components/screenshots/overlay/overlay.css", "browser/components/screenshots/overlayHelpers.mjs", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/screenshots/tests/browser/browser_mini_window_mode.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/locales-preview/miniWindow.ftl", "browser/locales/jar.mn", "browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css", "browser/themes/shared/urlbar.css", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "365aca989a5a560a615d02815b528490be2c7f19", "git_parents": ["4efe01975fcc04b2fca831547c1d4793afd5b717"], "node": "1c90307903ee5b1f49b2a029d938b0f04dd7d051", "parents": ["958dcb7ebec8e371aa5fa99e6a58938a0e0ce3e7"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066606 - Return mini windows when the origin window's last tab is closed. r=mconley,tabbrowser-reviewers,dao\"\n\nThis reverts commit 02d13a41182202d8d09abe40b5ecf6f64df2e489.\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "705e099f62dda18553342a63397c02d20191f0f8", "git_parents": ["365aca989a5a560a615d02815b528490be2c7f19"], "node": "cbb934e6c5f8d36cadf3baec91b12ae7fca221b6", "parents": ["1c90307903ee5b1f49b2a029d938b0f04dd7d051"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066606 - Exclude mini windows from the messaging system. r=omc-reviewers,mimi\"\n\nThis reverts commit 193519cefbd434d231f4f15baea754633ca0b059.\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/InfoBar.sys.mjs"], "git_node": "ce736c989277b261367b23ead94ee6394bb87102", "git_parents": ["705e099f62dda18553342a63397c02d20191f0f8"], "node": "b13206b364c42cdbd11e8a78f69a1d806c3b7cc5", "parents": ["cbb934e6c5f8d36cadf3baec91b12ae7fca221b6"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066606 - Add the always-on-top mini window component behind a pref. r=mconley,tabbrowser-reviewers,dao\"\n\nThis reverts commit f4a8ebb1bb323516b0c7b09a7feed733290fa176.\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/moz.build", "browser/components/moz.build", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/tabbrowser/content/tab-bar-visibility.js", "browser/modules/BrowserDOMWindow.sys.mjs", "browser/modules/BrowserWindowTracker.sys.mjs", "browser/modules/URILoadingHelper.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "ee2a6526ffd729f6fa2ab31b1fdc9681eb25c9d9", "git_parents": ["ce736c989277b261367b23ead94ee6394bb87102"], "node": "b6a514c12ac1805d18b7c8822eeaa0850232abe2", "parents": ["b13206b364c42cdbd11e8a78f69a1d806c3b7cc5"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes mobile-merino-manifest ct-logs - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328246\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "eaedbd81e23a7d393f047543a69b661ce8b66358", "git_parents": ["ee2a6526ffd729f6fa2ab31b1fdc9681eb25c9d9"], "node": "a1a51452cd429045bb0298c404838fbbee7a4419", "parents": ["b6a514c12ac1805d18b7c8822eeaa0850232abe2"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072369 - Add responsive styling for the HNT card stack r=omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327394\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/asrouter-newtab-multistage/asrouter-newtab-multistage.scss", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs"], "git_node": "4d0a4234de052f76d0625f0f9edb7cca97b8fb4d", "git_parents": ["eaedbd81e23a7d393f047543a69b661ce8b66358"], "node": "d19622ca2ff3c0a8ffdfe93367bd11c3c4e268ca", "parents": ["a1a51452cd429045bb0298c404838fbbee7a4419"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041621 - [devtools] Handle percentage values in InspectorUtils.getComputationSteps. r=layout-reviewers,devtools-reviewers,firefox-style-system-reviewers,emilio,ochameau.\n\nWe now pass the property name to the method so we can properly compute the\npercentage basis (it might depend on the width/height/inline/block size of the\nelement/its parent).\nWe can then pass this percentage basis to `Servo_GetComputationSteps` so we\ncan substitute those with actual size.\n\nWe're bailing out on a few case: if the passed property is unknown, or if it's\na shorthand for which the % value would be computed differently for the longhands\nit represents, or if the property % value is more challenging to compute (e.g.\nbackground-position-*, which depends on the background image size).\n\nTest cases are added to cover this feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326471\n", "files": ["devtools/client/inspector/rules/test/browser_rules_css_explainers.js", "devtools/client/inspector/rules/utils/utils.js", "devtools/client/shared/widgets/tooltip/css-explainers-tooltip-helper.js", "devtools/server/actors/style-rule.js", "devtools/shared/specs/style-rule.js", "dom/chrome-webidl/InspectorUtils.webidl", "layout/inspector/InspectorUtils.cpp", "layout/inspector/InspectorUtils.h", "layout/inspector/tests/test_getComputationSteps.html", "servo/ports/geckolib/glue.rs"], "git_node": "701fcd6a6659f0a9e627ba4adb42eeee05f6e795", "git_parents": ["4d0a4234de052f76d0625f0f9edb7cca97b8fb4d"], "node": "e7a863b9e308ead0338545d664469f128793e509", "parents": ["d19622ca2ff3c0a8ffdfe93367bd11c3c4e268ca"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070166 - [devtools] Add InspectorUtils method that returns the substituted value of a given expression. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326952\n", "files": ["dom/chrome-webidl/InspectorUtils.webidl", "layout/inspector/InspectorUtils.cpp", "layout/inspector/InspectorUtils.h", "layout/inspector/tests/mochitest.toml", "layout/inspector/tests/test_getSubstitutedValue.html", "servo/ports/geckolib/glue.rs"], "git_node": "0d52f7be75a7f127413ef0c31bd8bb9daedb639e", "git_parents": ["701fcd6a6659f0a9e627ba4adb42eeee05f6e795"], "node": "de3c31acd6196794c8dfdc17772ad520c5e70d5a", "parents": ["e7a863b9e308ead0338545d664469f128793e509"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074405 - Accept simple dimension and percentage expressions in Servo_GetComputationSteps. r=layout-reviewers,firefox-style-system-reviewers,emilio.\n\nUntil now, we were only accepting function calls expressions (e.g. calc(1px * 2).\nThis patch handles dimensions (e.g. `1em`, `2vw`, `3lh`, \u2026) as well as percentage (e.g. `50%`).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327269\n", "files": ["layout/inspector/tests/test_getComputationSteps.html", "servo/ports/geckolib/glue.rs"], "git_node": "e3dd2875dd546f304f17d5109e67e4077fafef6d", "git_parents": ["0d52f7be75a7f127413ef0c31bd8bb9daedb639e"], "node": "652ac05366d9b3c66a3089daf2b0cede9dcb5675", "parents": ["de3c31acd6196794c8dfdc17772ad520c5e70d5a"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 1 - Build wrench shaders through a separate device, as Gecko does r=gfx-reviewers,lsalzman\n\nGecko compiles WebRender's shaders through a device of their own and shares\nthe programs with every window's renderer, so a program created or linked\nthrough one device is drawn with through another. Wrench let the renderer\nbuild its own shaders, which never exercised that. It now mirrors Gecko:\nthe shaders are built on a separate device, precached fully with --precache\nand asynchronously otherwise, and handed to the renderer, which owns and\nreleases them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328029\n", "files": ["gfx/wr/wrench/src/wrench.rs"], "git_node": "90c8c1f47b798ea2c4ed68262d2cb7872131e7be", "git_parents": ["e3dd2875dd546f304f17d5109e67e4077fafef6d"], "node": "d0a8e7b08a4bfa8737dbf4fc8302ab0a5e84add2", "parents": ["652ac05366d9b3c66a3089daf2b0cede9dcb5675"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 2 - Make the WebRender scissor a single piece of render pass state r=gfx-reviewers,lsalzman\n\nThe scissor was three GL-style toggles, enable_scissor, disable_scissor and\nset_scissor_rect, each issuing its call immediately. Explicit graphics APIs\nset the scissor as dynamic state on the pass, with a default of the whole\ntarget, so a backend needs one set_scissor(Option\u003crect\u003e) that begin_render_pass\nresets. Renderer call sites become one call per rect, and the frame-start\ndisable goes away since every pass starts unscissored.\n\nThe GL backend caches the scissor alongside the other render state and issues\nenable, disable and glScissor only when something changes, so the GL calls are\nthe same or fewer. A scissored clear now restores the scissor it found rather\nthan leaving the test disabled, which nothing relied on. The renderer passes\nthe scissor rect into the readback composite path, which needs it back after\nthe blit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328030\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "b50d049ffa5fde98ecbf84858e01e23f63aa9b9d", "git_parents": ["90c8c1f47b798ea2c4ed68262d2cb7872131e7be"], "node": "f7b7e8223f9a33d7152fc796347735f682a29a18", "parents": ["d0a8e7b08a4bfa8737dbf4fc8302ab0a5e84add2"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 3 - Make whole-target WebRender clears the render pass load ops r=gfx-reviewers,lsalzman\n\nExplicit graphics APIs clear an attachment by giving the render pass a\nclear load op rather than by a clear command, and describe the depth\nattachment's load separately from color. LoadOp becomes generic with a Clear\nvariant, RenderPassDescriptor gains depth_load, and begin_render_pass applies\nboth, so every clear of a whole target moves into the pass descriptor. What\nremains are clears of part of a target, which become clear_rect with a\nmandatory rect; in an explicit API those are a draw, as the ps_clear path\nalready does.\n\nThe color and alpha target clear logic is split into a plan, taken before the\npass begins so it can choose the load ops, and the rect clears and quads that\nfollow. The decisions themselves are unchanged. The composite pass sets the\npartial present damage region before beginning the pass, since its clear now\nhappens as the pass begins, and the region must be set before any rendering\nto the framebuffer. The GL calls issued are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328031\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/device/types.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/upload.rs"], "git_node": "f56c582a5233a45e2cf2819a30d4f9ef1f3bc97e", "git_parents": ["b50d049ffa5fde98ecbf84858e01e23f63aa9b9d"], "node": "96131720470626af469dd4935e00793beb35c06c", "parents": ["f7b7e8223f9a33d7152fc796347735f682a29a18"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 4 - Move WebRender framebuffer objects into the GL backend r=gfx-reviewers,lsalzman\n\nTexture carried two GL framebuffer object handles, and DrawTarget and\nReadTarget named a target by one, so every backend would have had to invent\nframebuffer objects. Explicit graphics APIs attach a texture to a pass\ndirectly. Texture now records only whether it is a render target and whether\na depth buffer has been requested, DrawTarget and ReadTarget name the texture\nthrough a TextureId, and a native surface read target carries the surface\nhandle like the draw target does.\n\nThe GL backend keeps the FBOs of each render target texture in a map by\ntexture id, created and deleted where the texture's were, and looks them up\nwhen binding a target. FBOId is private to it. The GL calls issued are\nunchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328032\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/types.rs"], "git_node": "431ea42eaf8caccc8942d7f1c8546d8dc6e2e67e", "git_parents": ["f56c582a5233a45e2cf2819a30d4f9ef1f3bc97e"], "node": "a767d356e604acbb7f86390cee63fd894146b83c", "parents": ["96131720470626af469dd4935e00793beb35c06c"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 1 - Introduce DocAccessible::IsRootContent and DocAccessible::GetAccessibleOrDocument. r=Jamie\n\n`DocAccessible::IsRootContent` asserts that the doc accessible's\nmContent is either null (when the tree is not yet constructed) or the document node's root\nelement. It then returns true if the given node matches mContent and\nfalse otherwise. When the root element is replaced, as in\n`testSelectAtRoot` in\n`browser/name_and_description/browser_name_general.js` mContent\ncan be briefly bound to the _old_ root element. The assert therefore\nignores mContent if it is not in a composed doc.\n\n`DocAccessible::GetAccessibleOrDocument` uses the root content checker\nabove to tell if the given aNode is the doc's mContent. If it is, it\nreturns the doc accessible and otherwise it calls GetAccessible\ndirectly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325188\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h"], "git_node": "7b55d0a639c740d47689bf6e29bdc7f52a05deaf", "git_parents": ["431ea42eaf8caccc8942d7f1c8546d8dc6e2e67e"], "node": "5ca25144d39a9999135a8c8e4493e6575d86607e", "parents": ["a767d356e604acbb7f86390cee63fd894146b83c"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 2 - Create a HyperText for the body when the body is relevant, and ensure the DocAccessible only ever maps to the root element. r=Jamie\n\nThis patch does two things:\n- It ensures we create a HyperTextAccessible to represent the `\u003cbody\u003e` element\n  when that element has relevant styling/properties.\n- It ensures the DocAccessible can never be mapped to the `\u003cbody\u003e` element\n  and, instead, only ever maps to the document's root element.\n\nThis involves a fair bit of concurrent clean up. Here are the main pieces:\n- We used to return `false` in `MustBeGenericAccessible` when considering\n  the root element. This check is removed and replaced with an explicit root\n  element check/early-out in `CreateAccessible`. With this, we also remove\n  the `Document` argument to `MustBeGenericAccessible` since we were only\n  using it to check for the root.\n- Several callsites where we used to do the \"do we have the doc acc's\n  content item, is it the root or the body?\" dance are replaced with a\n  single call to `IsRootContent`, since the document can now only ever have\n  the root element as its mContent mapping.\n- The hack that required we push the document's bounds in addition to the\n  target-accessible's bounds in `NotifyOfPossibleBoundsChange` is removed\n  because a body with relevant styling will always have its own acc which manages its own\n  updates. We still need to handle a push to the document explicitly because\n  `GetAccessible` won't return it.\n- `nsAccessibilityService::CreateAccessible` now has three paths for\n  creating an acc for the body:\n    1. The body has relevant accessibility or layout properties which\n       necessitate we track it\n    2. The body has relevant accessibility properties, but is\n       `display:contents` and so has no frame (this path inherits other\n       `display:contents` checks like \"this acc isn't presentational,\n       right?\" but skips some role logic because we will ultimately forward\n       the role from the body acc to the doc acc in a later patch and don't\n       want to take action on it here. In other words, a body element should\n       always beget a HyperText acc with no role map entry.)\n    3. NEW - The body has a click listener. There is a test for this new\n       behaviour in part 10 along with a change to an existing test which\n       verified actions on the body were forwarded to the doc\n       accessible.\n- `DocAccessible::UpdateRootElIfNeeded` is updated to only ever set\n  `mContent` to the root element. We also diff the new/old role map entry\n  index to check if pushing a role changed event is necessary. We still call\n  `SetRoleMapEntryForDoc`, though the exact logistics of this will change in\n  the next patches. Role forwarding isn't implemented here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325189\n", "files": ["accessible/base/nsAccessibilityService.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h", "accessible/generic/LocalAccessible.h"], "git_node": "f1a5c68531ad24ff9efd646a5e14ed5776c4a1b1", "git_parents": ["7b55d0a639c740d47689bf6e29bdc7f52a05deaf"], "node": "2d3e96fa2776145195f7da684a582f0f56d2802d", "parents": ["5ca25144d39a9999135a8c8e4493e6575d86607e"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 3 - Remove the DocAccessible overload of aria::IsValidARIAHidden. r=Jamie\n\nWe no longer need this because the DocAccessible can only ever have the root\nelement as its `mContent`. We can rely on the other version of this method,\nwhich considers a single DOM node at a time, instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326314\n", "files": ["accessible/base/ARIAMap.cpp", "accessible/base/ARIAMap.h", "accessible/base/TreeWalker.cpp"], "git_node": "22af1049f60604af4ff5d7aaa71d62e21d005f03", "git_parents": ["f1a5c68531ad24ff9efd646a5e14ed5776c4a1b1"], "node": "8a54bf53710bf37f3cabdadfa30dfd93fb2c6000", "parents": ["2d3e96fa2776145195f7da684a582f0f56d2802d"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 4 - Expose the body element's role on the DocAccessible. r=Jamie\n\nThis patch ensures that any (valid) role set on the body element is uniquely\nexposed on the Doc Accessible. It makes these changes:\n1. `DocAccessible::UpdateRootElIfNeeded` is split into two separate\n   functions:\n    1. `DocAccessible::UpdateDocRoleMapEntry`\n        1. This function considers the role of the body element (or the role\n           of the root element, when no body exists) and checks it for\n           validity. This used to happen in\n           `DocAccessible::SetRoleMapEntryForDoc`.\n        2. The old role map entry index is noted and `SetRoleMapEntry` is\n           called with the new role (or null, if the provided role was\n           invalid).\n        3. If the new and old role map entry indicies differ, indicating the\n           role was updated, a role-changed event is sent.\n        4. We call this when the root element is updated and when the role\n           attribute changes on the root or body element.\n    2. `DocAccessible::UpdateRootElement`\n        1. This function ensures `mContent` is set to the root element. Then\n           it calls `UpdateDocRoleMapEntry`.\n        2. We call this when a new root element is seen in\n           `ProcessContentInserted` as well as in `DoInitialUpdate`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325190\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h"], "git_node": "b62f55c3409e7612043d1ff91bd7731fd21271f7", "git_parents": ["22af1049f60604af4ff5d7aaa71d62e21d005f03"], "node": "f90a2bd32b2dcf8885da99d73c3b7efca1358d4e", "parents": ["8a54bf53710bf37f3cabdadfa30dfd93fb2c6000"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 5 - Report focus on the body element as focus on the document. r=Jamie\n\nThis patch redirects focus events targeting the body to target the document\ninstead.\n\nThis is done by introducing two new functions:\n1. `FocusTargetFor` - this is a wrapper on all sites where we decide return\n   values in `FocusManager::FocusedLocalAccessible`,\n   `FocusManager::ProcessFocusEvent` and `FocusManager::ProcessDOMFocus`. On\n   all but one of these, we were calling\n   `GetAccessibleEvenIfNotInMapOrContainer` before returning, so I bundled\n   this check and added a second: a call to our other new function\n   `MaybeAdjustDocumentFocusTarget`\n2. `MaybeAdjustDocumentFocusTarget` - this does what it says :) if the\n   target is not the body, we return it outright. Otherwise, if it is the\n   body, we return the body's doc acc instead.\n    1. Aside from the call internal to `FocusTargetFor` this is called at:\n        1. One spot in `ProcessFocusEvent` where we use `GetAccessible`\n           on the event; we don't have a reference to a node.\n        2. The beginning of `FocusManager::DispatchFocusEvent` where we\n           already have an accessible target to consider, instead of a node.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325191\n", "files": ["accessible/base/FocusManager.cpp"], "git_node": "18902f9cb9bec927d6c433ba14a9489e42304885", "git_parents": ["b62f55c3409e7612043d1ff91bd7731fd21271f7"], "node": "08c130a9b4331386efe38f79c0856b74cc3941ea", "parents": ["f90a2bd32b2dcf8885da99d73c3b7efca1358d4e"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 6 - Cascade the body element's editable state to the document. r=Jamie\n\nWhen the body has attributes/properties which makes it EDITABLE, that state\nshould be exposed on the doc accessible. We manage this in two places:\n- `DocAccessible::ElementStateChanged` - When we witness a dom read/write\n  state change for the body element, we now fire acc state change events for\n  the document's EDITABLE and READONLY states. There's no handling for the\n  root element here because it'll be caught by the existing logic for\n  read/write state changes below.\n- `DocAccessible::GetEditor` - This used to check only the doc's `mContent`.\n  Now, it checks the body if it exists and the root otherwise. I note this\n  in a comment in the function, but for posterity I'll note it here too: it\n  is insufficient to check _only the body_ because it is possible to nest\n  web content directly inside the root element :( When the body exists,\n  though, any editable state expressed on the root will be cascaded downward\n  and duplicated on the body and it is safe to rely on it for both its own\n  editable state and the root's editable state.\n\nTest coverage: accessible/tests/browser/e10s/browser_caching_states.js\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325192\n", "files": ["accessible/generic/DocAccessible.cpp"], "git_node": "336d08154f00c6c6ae8630ca2f7c440b3c4219a8", "git_parents": ["18902f9cb9bec927d6c433ba14a9489e42304885"], "node": "ebd86cdb3eca5f13c410891bbebbae8ed314f064", "parents": ["08c130a9b4331386efe38f79c0856b74cc3941ea"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 7 - Descend through the body element for mac rotor searches. r=Jamie\n\nTesting: accessible/tests/browser/mac/browser_rotor.js, browser_navigate.js\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325193\n", "files": ["accessible/mac/RotorRules.mm"], "git_node": "86f51c71964c0e7f6a0d9f6c2e20a0aef5ad6cd9", "git_parents": ["336d08154f00c6c6ae8630ca2f7c440b3c4219a8"], "node": "6caa99c0f2e51920be7fd6f781f2575e91eb278e", "parents": ["ebd86cdb3eca5f13c410891bbebbae8ed314f064"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 8 - Introduce and use new shared-head.js ID constants which target the doc accessible rather than the body. r=Jamie\n\nThis patch introduces two new constants in shared-head.js: `DEFAULT_CONTENT_DOC_ID` and `DEFAULT_IFRAME_DOC_ID`. It also replaces every use of the old `_DOC_BODY_ID` variants with the new `_DOC_ID` versions.\n\nIn this patch, both consts have values that are identical to their `_DOC_BODY_ID` predecessors, making this functionally a no-op.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327174\n", "files": ["accessible/tests/browser/atk/browser_notification.js", "accessible/tests/browser/e10s/browser_caching_states.js", "accessible/tests/browser/fission/browser_hidden_iframe.js", "accessible/tests/browser/fission/browser_reframe_root.js", "accessible/tests/browser/fission/browser_reframe_visibility.js", "accessible/tests/browser/fission/browser_src_change.js", "accessible/tests/browser/mac/browser_announcement.js", "accessible/tests/browser/pdfOutput/browser_a11yLifecycle.js", "accessible/tests/browser/shared-head.js", "accessible/tests/browser/windows/uia/browser_notificationEvent.js", "accessible/tests/browser/windows/uia/browser_simplePatterns.js"], "git_node": "27b8b443ef44a0c0bc47059c336168499bc28f3b", "git_parents": ["86f51c71964c0e7f6a0d9f6c2e20a0aef5ad6cd9"], "node": "29d17fc8366c0785d75e32c32c64d17a2f314afd", "parents": ["6caa99c0f2e51920be7fd6f781f2575e91eb278e"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 9 - Make *_DOC_ID consts unique and use them within the test harness r=Jamie\n\nThis patch modifies the values of the shared-head.js consts created in part 8 such that they are unique compared to the IDs used for body elements. It also adjusts the test harness in the following ways:\n- The `\u003chtml\u003e` element in the default test configuration is assigned `id=\"${DEFAULT_CONTENT_DOC_ID}\"`\n- When running a test in an iframe, the iframe's root element gets `id=\"${DEFAULT_IFRAME_DOC_ID}\"`\n- `contentDocAttrs` is introduced alongside `docAttrs` and `contentDocBodyAttrs` to allow tests to supply attributes to the top level content doc's root element. This is used in later parts\n\nFor html files that specify their own root element and run under `addAccessibleTask`, this patch also updates the root ID to match the harness so doc load complete can be detected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327175\n", "files": ["accessible/tests/browser/doc_mathml.html", "accessible/tests/browser/e10s/doc_language.html", "accessible/tests/browser/e10s/doc_treeupdate_ariadialog.html", "accessible/tests/browser/e10s/doc_treeupdate_ariaowns.html", "accessible/tests/browser/e10s/doc_treeupdate_imagemap.html", "accessible/tests/browser/e10s/doc_treeupdate_removal.xhtml", "accessible/tests/browser/e10s/doc_treeupdate_visibility.html", "accessible/tests/browser/e10s/doc_treeupdate_whitespace.html", "accessible/tests/browser/mac/doc_aria_tabs.html", "accessible/tests/browser/mac/doc_textmarker_test.html", "accessible/tests/browser/shared-head.js", "accessible/tests/browser/tree/doc_xul.xhtml", "accessible/tests/browser/windows/a11y_setup.py", "accessible/tests/browser/windows/uia/browser_generalEvents.js", "accessible/tests/browser/windows/uia/browser_simplePatterns.js", "testing/mochitest/document-builder.sjs"], "git_node": "babf28059daa662bfbb70fa5edd53ca075910357", "git_parents": ["27b8b443ef44a0c0bc47059c336168499bc28f3b"], "node": "4591725df040796d472b3df4944e99c48c904c4d", "parents": ["29d17fc8366c0785d75e32c32c64d17a2f314afd"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 10 - Verify click listeners on the body are correctly exposed on the body's own accessible. r=Jamie\n\nThis adds a test for functionality added in part two of this stack. It also\nupdates the existing doc action assertions, which expected a click listener on\nthe body to give the document an action. Under part two that listener force creates an\nacc for the body and the action belongs to it, so the document keeps no action of\nits own and descendants pick up clickAncestor from the body Accessible instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327176\n", "files": ["accessible/tests/browser/e10s/browser_caching_actions.js"], "git_node": "de0e23fafef6b6493987fe902abaae39af0ee4da", "git_parents": ["babf28059daa662bfbb70fa5edd53ca075910357"], "node": "666010d009a503d95affff37a460f328e659ae83", "parents": ["4591725df040796d472b3df4944e99c48c904c4d"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 11 - Expect tag:html on the document accessible instead of tag:body r=Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327177\n", "files": ["accessible/tests/mochitest/test_nsIAccessibleDocument.html"], "git_node": "d228a2474540e73030d45bd8f8be998fe125db27", "git_parents": ["de0e23fafef6b6493987fe902abaae39af0ee4da"], "node": "a17f63fb583074487e4ff34c5768d5b4c1c70264", "parents": ["666010d009a503d95affff37a460f328e659ae83"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 12 - Validate the doc acc exposes SELECTABLE_TEXT state from the body frame. r=Jamie\n\nThe document accessible steals the selectable text state from the body element,\nwhen the body exists (see part 2). This state is exposed by default, so there's no triggering attribute here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327178\n", "files": ["accessible/tests/mochitest/aom/test_general.html"], "git_node": "30abdb9823c56f716656068f74c080de64473088", "git_parents": ["d228a2474540e73030d45bd8f8be998fe125db27"], "node": "109c347c08177b126e24dd28d84c0eb04888ae85", "parents": ["a17f63fb583074487e4ff34c5768d5b4c1c70264"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 13 - Set the document's relation attribute on the root element. r=Jamie\n\nThis test was meant to verify that a relation set on the doc acc is exposed\ncorrectly. Since the body is no longer the doc accessible, set the attribute on\nthe root element, which is where the doc accessible now reads its relations\nfrom.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327179\n", "files": ["accessible/tests/mochitest/relations/test_update.html"], "git_node": "6a374cad77d338def06e6726d16e195fc2d65679", "git_parents": ["30abdb9823c56f716656068f74c080de64473088"], "node": "17e18e437a10e4cb21624f87ef0b01146b590583", "parents": ["109c347c08177b126e24dd28d84c0eb04888ae85"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 14 - Set aria-owns on the root element in mochitest/treeupdate/test_ariaowns.html. r=Jamie\n\nThis test verifies that aria-owns works on the doc accessible. The body is no\nlonger the doc accessible's content, so set the attribute on the root element,\nwhich is.\n\naria-owns on the root element works with this stack, so the tree and event\nexpectations here are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327180\n", "files": ["accessible/tests/mochitest/treeupdate/test_ariaowns.html"], "git_node": "8de750924c7d908d64e5814a5f78c7a9cca1c6dc", "git_parents": ["6a374cad77d338def06e6726d16e195fc2d65679"], "node": "a29d80dc94dd032d3c1e3111de1d89089074cdde", "parents": ["17e18e437a10e4cb21624f87ef0b01146b590583"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 15 - Update browser/tree/ tests to verify aria-hidden is ignored on the body's accessible. r=Jamie\n\nWe have a bunch of tests here to verify aria-hidden doesn't hide document\ncontent when placed on top level docs (root elements) or the body elements of\ntop level docs. We also have tests that verify aria-hidden is respected on\niframes. These need to be adjusted slightly, since `aria-hidden` on an otherwise\nplain body element will cause the body to get its own acc.\n\nThis stack also fixes bug 1959547.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327181\n", "files": ["accessible/tests/browser/tree/browser_test_aria_hidden.js", "accessible/tests/browser/tree/browser_test_aria_hidden_iframe.js", "accessible/tests/browser/tree/browser_test_aria_hidden_svg.js"], "git_node": "37c4de7fd8896bd1db9efaa31b3ebb48925ea3db", "git_parents": ["8de750924c7d908d64e5814a5f78c7a9cca1c6dc"], "node": "f0c9f2b5b1353529b66d17ca2f31fcf9eee50513", "parents": ["a29d80dc94dd032d3c1e3111de1d89089074cdde"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 16 - Update the mac accessibility tests for the body Accessible. r=Jamie\n\nThese replacements are pretty straightforward, mostly just substituting\nthe appropriate doc ID for what used to be `\"body\"`.\n\nbrowser_rootgroup.js: I'm less sure about this change, we end up with\nboth a body accessible AND a root group, which feels excessive. I don't\nthink this will have a practical impact on users, since VO tends to skip\ngroups without semantic info pretty liberally. Still, we should consider\nrevisiting our root group logic to ensure we're not creating it in\nunnecessary cases.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327182\n", "files": ["accessible/tests/browser/mac/browser_input.js", "accessible/tests/browser/mac/browser_rootgroup.js", "accessible/tests/browser/mac/browser_text_input.js", "accessible/tests/browser/mac/browser_text_leaf.js", "accessible/tests/browser/mac/browser_text_selection.js"], "git_node": "a7f8e8c95f2e0698dac24fed0442d96c098cd8cb", "git_parents": ["37c4de7fd8896bd1db9efaa31b3ebb48925ea3db"], "node": "cc2f0a66e835cbfe5d99134b6b575f9694a204e2", "parents": ["f0c9f2b5b1353529b66d17ca2f31fcf9eee50513"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 17 - Provide an id for the root element in the shutdown tests so doc load complete events can be awaited. r=Jamie\n\nThese tests don't use our traditional addAccessibleTask framework, so we\ncan't use the new ID consts here. Still, the doc load complete event\nwill fire expecting an ID from the root element and not the body, so we\nhave to supply something.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327183\n", "files": ["accessible/tests/browser/browser_shutdown_multi_proxy_acc_reference_doc.js", "accessible/tests/browser/browser_shutdown_multi_proxy_acc_reference_obj.js", "accessible/tests/browser/browser_shutdown_proxy_doc_acc_reference.js"], "git_node": "6eb9a964cec6ac71c7926abc2f31ca94ceaaf533", "git_parents": ["a7f8e8c95f2e0698dac24fed0442d96c098cd8cb"], "node": "f205a980a26788f33ee4d2767b94d307d35fe8d3", "parents": ["cc2f0a66e835cbfe5d99134b6b575f9694a204e2"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 18 - Update browser/e10s/ tests. r=Jamie\n\nThere are four updates here:\n- browser_caching_attributes.js - the doc accessible no longer has the \u003cbody\u003e\n  tag, it has the \u003chtml\u003e tag instead\n- browser_events_statechange.js - this test turns designMode on for an iframe\n  document and waits for the EDITABLE state change by id. That id used to sit on\n  the iframe's body, which was the doc accessible's content, so the event matched\n  the doc acc. It now sits on the root element and still matches the doc acc.\n- browser_treeupdate_ariaowns.js - the caret move event is still fired on the\n  body, and the body is no longer the doc accessible so we have to check the ID\n  explicitly here.\n- browser_treeupdate_doc.js - this test removes and inserts a bunch of content\n  into the root of an iframe. In some places the test comments don't seem to\n  match what the test is actually doing, so I've made some guesses about its\n  intentions. I've mostly updated the reorder targets to reflect the root\n  instead of the body.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327184\n", "files": ["accessible/tests/browser/e10s/browser_caching_actions.js", "accessible/tests/browser/e10s/browser_caching_attributes.js", "accessible/tests/browser/e10s/browser_events_statechange.js", "accessible/tests/browser/e10s/browser_treeupdate_ariaowns.js", "accessible/tests/browser/e10s/browser_treeupdate_doc.js"], "git_node": "cd1ed4b9d02452bc50a63e9ec28474924676671c", "git_parents": ["6eb9a964cec6ac71c7926abc2f31ca94ceaaf533"], "node": "15be7ea19a66e02d33319b93ca0871f4993cb960", "parents": ["f205a980a26788f33ee4d2767b94d307d35fe8d3"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 19 - Update the events tests for the body Accessible. r=Jamie\n\nThere are four updates here:\n- browser_menu_and_alerts.js - the focus, doc load complete and busy state\n  change events are all reported against the doc acc, so the id we match them by\n  moves from the body to the root.\n- browser_test_docload.js - same story for the doc load complete event on the\n  top level document.\n- browser_test_focus_browserui.js - the focus event is reported against the doc\n  acc, so this id comes from `contentDocAttrs` rather than\n  `contentDocBodyAttrs`.\n- browser_test_focus_dialog.js - the editable iframe keeps `contentEditable` on\n  its body, but the id the focus event is matched by belongs to the doc acc, so\n  the two attrs split across `contentDocAttrs` and `contentDocBodyAttrs`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327185\n", "files": ["accessible/tests/browser/events/browser_menu_and_alerts.js", "accessible/tests/browser/events/browser_test_docload.js", "accessible/tests/browser/events/browser_test_focus_browserui.js", "accessible/tests/browser/events/browser_test_focus_dialog.js"], "git_node": "c6e8fa73e5646cef2357c521d37fb2bdf0784551", "git_parents": ["cd1ed4b9d02452bc50a63e9ec28474924676671c"], "node": "da7d36098dd764352b6956762653236dfb621e2c", "parents": ["15be7ea19a66e02d33319b93ca0871f4993cb960"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 20 - Update browser/fission/ tests. r=Jamie\n\nThere are two updates here:\n- browser_nested_iframe.js - the nested iframe's doc acc is both looked up and\n  waited for by id, so `NESTED_IFRAME_DOC_BODY_ID` becomes\n  `NESTED_IFRAME_DOC_ID` and that id moves from the body to the root.\n- browser_take_focus.js - the focused child here is the iframe's doc acc, so\n  these assertions use `DEFAULT_IFRAME_DOC_ID` instead of the hard coded body\n  id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327186\n", "files": ["accessible/tests/browser/fission/browser_nested_iframe.js", "accessible/tests/browser/fission/browser_take_focus.js"], "git_node": "0753003067d60b706159aacc18d32e35bee0b901", "git_parents": ["c6e8fa73e5646cef2357c521d37fb2bdf0784551"], "node": "ddc8daad30dac9eec4b704ac1033a25b7076298a", "parents": ["da7d36098dd764352b6956762653236dfb621e2c"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 21 - Put the document id on the root element in browser_test_visibility.js. r=Jamie\n\nThis test waits for doc load complete on an iframe document. Previously it used\nthe body ID, but now it needs to use the root ID. The test source here is a\ndata:text/html, snippet so it doesn't automatically get the harness\nboilerplate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327187\n", "files": ["accessible/tests/browser/states/browser_test_visibility.js"], "git_node": "2f06ef5af95ea327b1422ea879e99a1eddad8474", "git_parents": ["0753003067d60b706159aacc18d32e35bee0b901"], "node": "21bf10c9a9a6e6d437b3a4ef602d4cd2a7d2f054", "parents": ["ddc8daad30dac9eec4b704ac1033a25b7076298a"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 22 - Put contentEditable on the root element in browser_editabletext.js. r=Jamie\n\nThe existing task in this file verified that adding `contentEditable` to\nthe document's body resulted in a doc accessible that had editable state\nand was the target of text-edit related events.\n\nNow that the body is not the backing element for the document, we modify\nthe existing test to pass `contentEditable` on the root element and test\neditable state on the doc accessible.\n\nWe also introduce a new task which sets `contentEditable` on the body element\nvia `contentDocBodyAttrs` and tests the body accessible's editable\nstate.\n\nFinally, we introduce a new task which does not set `contentEditable`\nvia the test content*Attrs functions but instead sets it via\n`invokeContentTask`. In this task, we verify the root is affected by\nsetting `contentEditable` on the body and that when the body has its own\nacc, text-edit events are targeted to that acc rather than the docAcc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327188\n", "files": ["accessible/tests/browser/text/browser_editabletext.js"], "git_node": "7520655bd39b57c9576d3968e485da0e9ed43bba", "git_parents": ["2f06ef5af95ea327b1422ea879e99a1eddad8474"], "node": "f5286a41fefe857c9e1cb7a06ed7cbc44769866c", "parents": ["21bf10c9a9a6e6d437b3a4ef602d4cd2a7d2f054"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2051694: Part 23 - Update the devtools accessibility panel tests for the body Accessible. r=Jamie,devtools-reviewers,nchevobbe\n\nThere are two updates here:\n- browser_accessibility_print_to_json.js - the panel snapshots the doc acc's\n  attributes, which come from its content element. That's the root element now,\n  so the tag is html and the margins are the root's rather than the body's\n  default 8px.\n- browser_accessibility_sidebar.js - this test marks the document as disabled\n  for accessibility, so `aria-disabled` moves from the body to the root.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327189\n", "files": ["devtools/client/accessibility/test/browser/browser_accessibility_print_to_json.js", "devtools/client/accessibility/test/browser/browser_accessibility_sidebar.js"], "git_node": "8fae36b94fad45ea593ef1fa61ace8fc14700ab0", "git_parents": ["7520655bd39b57c9576d3968e485da0e9ed43bba"], "node": "ab8cee5ca7bfaf348a9f334e29bad31490be66e5", "parents": ["f5286a41fefe857c9e1cb7a06ed7cbc44769866c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073652: Fix proxy get validation for non-writable length r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327878\n", "files": ["js/src/jit-test/tests/proxy/bug2073652.js", "js/src/vm/ObjectFlags-inl.h"], "git_node": "3e14d4afd7ea30f6e1009e7a19f7d4e211715894", "git_parents": ["8fae36b94fad45ea593ef1fa61ace8fc14700ab0"], "node": "299f2d233b9b1e0eaea1204e2ead70a5541d18b9", "parents": ["ab8cee5ca7bfaf348a9f334e29bad31490be66e5"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045487: Don't optimize AddSlot with a typed array on the proto chain r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327879\n", "files": ["js/src/jit-test/tests/large-arraybuffers/bug2073645.js", "js/src/jit/CacheIR.cpp"], "git_node": "b1d3e0f6c9f4b4545f00ae2f640e9e12d9157ee3", "git_parents": ["3e14d4afd7ea30f6e1009e7a19f7d4e211715894"], "node": "97d528fc7f10d49464147d44c0dff0bec23ccb4f", "parents": ["299f2d233b9b1e0eaea1204e2ead70a5541d18b9"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073681: Report OOM in WasmFunctionScope::create r=spidermonkey-reviewers,jpages\n\nThe only other caller of debugGetLocalTypes is DebugFrame::getLocal, which in turn is only called by DebugEnvironmentProxyHandler::handleUnaliasedAccess, which [already reports OOM](https://searchfox.org/firefox-main/rev/73f46f2636b5677d7282764dd7afeaea7036f0ce/js/src/vm/EnvironmentObject.cpp#1973).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327880\n", "files": ["js/src/jit-test/tests/debug/bug2073681.js", "js/src/vm/Scope.cpp"], "git_node": "f3aca13478444bee3811648ae776b60ec3db8f36", "git_parents": ["b1d3e0f6c9f4b4545f00ae2f640e9e12d9157ee3"], "node": "fe6aaeabf84ca5c706f8977afbf5bff2fda612d4", "parents": ["97d528fc7f10d49464147d44c0dff0bec23ccb4f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073661: Fix constant folding for BigIntPtrLsh r=spidermonkey-reviewers,jonco\n\nDriveby: Fix typo in \"UnsigedInt\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327881\n", "files": ["js/src/jit-test/tests/bigint/bug2073661.js", "js/src/jit/MIR.cpp"], "git_node": "c1ea1477e2c94f2802cfacc5d826341c4c91827f", "git_parents": ["f3aca13478444bee3811648ae776b60ec3db8f36"], "node": "ea2cdd42061851cefb87bbf98a7dbfbd600d6035", "parents": ["fe6aaeabf84ca5c706f8977afbf5bff2fda612d4"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060702: Shrink RegExpShared r=spidermonkey-reviewers,arai\n\nWe had terrible layout in RegExpShared. flags + kind was one byte for flags, followed by three bytes of padding, followed by four bytes of kind (which could be represented in 2 bits), followed by another 4 bytes of padding.\n\nAt some point, if we really cared, it might also be reasonable to union the Atom pointer with some other field, because most of these fields are only used for Kind::RegExp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326731\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/vm/RegExpShared.h"], "git_node": "fbb76d7404eccb274fc9f050bae04e3dc7b2e285", "git_parents": ["c1ea1477e2c94f2802cfacc5d826341c4c91827f"], "node": "92eec41898a559f5db014cab4571b31983e5304f", "parents": ["ea2cdd42061851cefb87bbf98a7dbfbd600d6035"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060702: Support RegExp quickcheck r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326732\n", "files": ["js/src/irregexp/RegExpShim.h", "js/src/jit/CodeGenerator.cpp", "js/src/vm/RegExpObject.cpp", "js/src/vm/RegExpShared.h"], "git_node": "28d77a14b87318100a09631021d35ce57a1afa94", "git_parents": ["fbb76d7404eccb274fc9f050bae04e3dc7b2e285"], "node": "91557adf6af12d2ee8092e79b030cc0c7c94af8c", "parents": ["92eec41898a559f5db014cab4571b31983e5304f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060702: Add test r=spidermonkey-reviewers,jandem\n\nThis is the Claude-written test from Mayank's prototype, with the assertRejects/assertAccepts mechanism removed. (I don't think it makes sense here to hardcode a test for whether an optimization kicks in; that just makes us brittle if (eg) upstream Irregexp makes an improvement to identify more candidates.) I've verified that it hits the quickcheck code frequently and that it gets the same results on other engines.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326733\n", "files": ["js/src/jit-test/tests/regexp/quickcheck.js"], "git_node": "9b1ca10e92b7a1e449a20c702d9b24fede411b9a", "git_parents": ["28d77a14b87318100a09631021d35ce57a1afa94"], "node": "f4880c44d39e7eb7176f5a37ef4d4dd681237be3", "parents": ["91557adf6af12d2ee8092e79b030cc0c7c94af8c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-da/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hu/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-in/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ka/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sv-rSE/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-tr/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-da/strings.xml", "mobile/android/fenix/app/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml"], "git_node": "77eb7a9742cf52fc63788f99260bac916d1ca2b8", "git_parents": ["9b1ca10e92b7a1e449a20c702d9b24fede411b9a"], "node": "5b8abd2e89f1c3da31d285e2626382b757160b99", "parents": ["f4880c44d39e7eb7176f5a37ef4d4dd681237be3"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073661, Bug 2045487, Bug 2073681, Bug 2073652 : Fix constant folding for BigIntPtrLsh r=spidermonkey-reviewers,jonco\" for causinfg spider momkey failures\n\nThis reverts commit c1ea1477e2c94f2802cfacc5d826341c4c91827f.\n\nRevert \"Bug 2073681: Report OOM in WasmFunctionScope::create r=spidermonkey-reviewers,jpages\"\n\nThis reverts commit f3aca13478444bee3811648ae776b60ec3db8f36.\n\nRevert \"Bug 2045487: Don't optimize AddSlot with a typed array on the proto chain r=spidermonkey-reviewers,jandem\"\n\nThis reverts commit b1d3e0f6c9f4b4545f00ae2f640e9e12d9157ee3.\n\nRevert \"Bug 2073652: Fix proxy get validation for non-writable length r=spidermonkey-reviewers,jonco\"\n\nThis reverts commit 3e14d4afd7ea30f6e1009e7a19f7d4e211715894.\n", "files": ["js/src/jit-test/tests/bigint/bug2073661.js", "js/src/jit-test/tests/debug/bug2073681.js", "js/src/jit-test/tests/large-arraybuffers/bug2073645.js", "js/src/jit-test/tests/proxy/bug2073652.js", "js/src/jit/CacheIR.cpp", "js/src/jit/MIR.cpp", "js/src/vm/ObjectFlags-inl.h", "js/src/vm/Scope.cpp"], "git_node": "1f9ed26c239434f45facaeede9553c1795c9bd6b", "git_parents": ["77eb7a9742cf52fc63788f99260bac916d1ca2b8"], "node": "0b31418224a81fe9b21237521dc78f2e4a260fdf", "parents": ["5b8abd2e89f1c3da31d285e2626382b757160b99"], "tags": []}, {"author": "Jared Hirsch \u003cohai@6a68.net\u003e", "branch": "default", "desc": "Bug 2072763 - Improve 'restart required' messaging and add an illustration r=niklas,fluent-reviewers,desktop-theme-reviewers,tgiles,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328003\n", "files": ["browser/base/content/aboutRestartRequired.js", "browser/base/content/aboutRestartRequired.mjs", "browser/base/content/aboutRestartRequired.xhtml", "browser/base/content/test/browser-about/browser.toml", "browser/base/content/test/browser-about/browser_aboutRestartRequired_details.js", "browser/base/content/test/browser-tabcrashed/browser_shownRestartRequired.js", "browser/base/jar.mn", "browser/locales/en-US/browser/aboutRestartRequired.ftl", "browser/themes/shared/aboutRestartRequired.css", "toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/illustrations/kit-sympathetic.svg"], "git_node": "e220f5c0b16ed7c708c44004bde0d2baed2ad924", "git_parents": ["1f9ed26c239434f45facaeede9553c1795c9bd6b"], "node": "adfefc03bcb61149b83661efb0528e0fc4a50d90", "parents": ["0b31418224a81fe9b21237521dc78f2e4a260fdf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067007 - Measure grid item's block-size contribution intrinsic sizing. r=layout-reviewers,dholbert\n\nThis is fine now after bug 2074002.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328251\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/track-sizing/column-subgrid-with-row-standalone-axis-size-002.html.ini", "testing/web-platform/meta/css/css-grid/subgrid/standalone-axis-size-011.html.ini", "testing/web-platform/tests/css/css-grid/grid-items/percentage-block-size-transfer-through-item-001.html"], "git_node": "881379c413def6b279e1884804cf32fcca6b64a4", "git_parents": ["e220f5c0b16ed7c708c44004bde0d2baed2ad924"], "node": "aeb9446f1a3263d1f7e0458ee831e7c570cb0681", "parents": ["adfefc03bcb61149b83661efb0528e0fc4a50d90"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074543 - Use a specific partner code for the Recent Search Widget experiment. r=daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328197\n", "files": ["toolkit/components/search/ConfigSearchEngine.sys.mjs", "toolkit/components/search/tests/xpcshell/test_getSubmission_partnerCode.js"], "git_node": "0479f1065f9410d3f8f69d36b4dcb34a5e12a46f", "git_parents": ["881379c413def6b279e1884804cf32fcca6b64a4"], "node": "219bc68e6c5e761d3b5d8a85d8b13bff55eb2871", "parents": ["aeb9446f1a3263d1f7e0458ee831e7c570cb0681"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074224: Don't optimize IsTypedArray for non-wrapper proxies r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327933\n", "files": ["js/src/jit-test/tests/cacheir/bug2074224.js", "js/src/jit/CacheIR.cpp"], "git_node": "acab9b68ce1bcf7adf3d7d09d27d58f82140b3ad", "git_parents": ["0479f1065f9410d3f8f69d36b4dcb34a5e12a46f"], "node": "55c6b2bada378c8017d2be6257d1363a6e83facb", "parents": ["219bc68e6c5e761d3b5d8a85d8b13bff55eb2871"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2072358: Test-cases for stream removal during ICE. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327508\n", "files": ["dom/media/webrtc/transport/test/ice_unittest.cpp", "testing/web-platform/mozilla/tests/webrtc/RTCIceTransport-frozen-behind-stuck-transport.html"], "git_node": "a4d3288d688f14103fc28e4909877cc9e6d7acb7", "git_parents": ["acab9b68ce1bcf7adf3d7d09d27d58f82140b3ad"], "node": "24dc1f55c477ddd2318bfd90bd53027f1783ec08", "parents": ["55c6b2bada378c8017d2be6257d1363a6e83facb"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2072358: Fix some cases where ICE could get stuck. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327509\n", "files": ["dom/media/webrtc/transport/nricectx.cpp", "dom/media/webrtc/transport/test/test_nr_socket_ice_unittest.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_media_stream.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_peer_ctx.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_peer_ctx.h"], "git_node": "9b6aa4de6459974e3085b45ad0358fe6f39d22c9", "git_parents": ["a4d3288d688f14103fc28e4909877cc9e6d7acb7"], "node": "c1547a8689c2ed46b66541cb3f067fbec39c54de", "parents": ["24dc1f55c477ddd2318bfd90bd53027f1783ec08"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1004510: Test-cases for pranswer. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327510\n", "files": ["media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "testing/web-platform/meta/webrtc/RTCPeerConnection-setLocalDescription-pranswer-parameterless.html.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-setLocalDescription-pranswer.html.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-setRemoteDescription-pranswer.html.ini", "testing/web-platform/mozilla/tests/webrtc/RTCPeerConnection-pranswer.https.html", "testing/web-platform/tests/webrtc/RTCIceTransport.html", "testing/web-platform/tests/webrtc/RTCPeerConnection-pranswer-description-types.html", "testing/web-platform/tests/webrtc/RTCPeerConnection-setLocalDescription-pranswer-parameterless.html"], "git_node": "ddfa9124da3cd71a558f6fb8754e87882fe0d433", "git_parents": ["9b6aa4de6459974e3085b45ad0358fe6f39d22c9"], "node": "5620ff945e619f690173d913fca2241b677aa6a2", "parents": ["c1547a8689c2ed46b66541cb3f067fbec39c54de"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1004510: pranswer support r=mjf\n\nVery restricted right now; transport changes are generally forbidden, as\nwell as some dicey media things (eg; pt remapping, simulcast changes, msid\nchanges).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327511\n", "files": ["dom/media/PeerConnection.sys.mjs", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.h"], "git_node": "8dcb9314583f6365b4b9954c7fd5ba8191141adb", "git_parents": ["ddfa9124da3cd71a558f6fb8754e87882fe0d433"], "node": "66ac024fcece3ffd1063815d46817fa1207f053f", "parents": ["5620ff945e619f690173d913fca2241b677aa6a2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070277 - Let a mouse release over a panel-list item choose it in content documents. r=mstriemer,urlbar-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324382\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js", "toolkit/content/tests/widgets/browser.toml", "toolkit/content/tests/widgets/browser_panel_item_click_on_mouseup.js", "toolkit/content/tests/widgets/test_panel_item_mouseup_click.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "c8c1ee29660914960c09f059ed25ea2c52ea9807", "git_parents": ["8dcb9314583f6365b4b9954c7fd5ba8191141adb"], "node": "9d8ccd4ab236b63d9cf078f0504a1d5f7018614d", "parents": ["66ac024fcece3ffd1063815d46817fa1207f053f"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2074303 - wait to dismiss import passwords dialog until lifecycle is started r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327995\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/logins/ImportPasswordsDialogFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/logins/ImportPasswordsDialogFragmentTest.kt"], "git_node": "7b50afff9efc4709c3a41c792d254fa77869480c", "git_parents": ["c8c1ee29660914960c09f059ed25ea2c52ea9807"], "node": "d3ffbbb2d1f1319b2ac5d29b5ff0b1ba969e3b42", "parents": ["9d8ccd4ab236b63d9cf078f0504a1d5f7018614d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073826 - Move `packagesymbols.py` from mozharness `external_tools` to the mozbuild actions. r=ahal,taskgraph-reviewers,releng-reviewers\n\nThe script has nothing to do with mozharness. It runs `dump_syms` over a\nlibrary and zips the result for the openh264 plugin build, which is a\nbuild action like the other symbol packaging scripts in\n`mozbuild/action`. The file is unchanged and `build.sh` keeps running it\nwith the image `python3`, since the openh264 task has no mach\nenvironment to bootstrap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327646\n", "files": ["python/mozbuild/mozbuild/action/packagesymbols.py", "taskcluster/gecko_taskgraph/transforms/openh264.py", "taskcluster/scripts/openh264/build.sh", "testing/mozharness/external_tools/packagesymbols.py"], "git_node": "df339cb36fe714d35568e3f2f344b2118728dc63", "git_parents": ["7b50afff9efc4709c3a41c792d254fa77869480c"], "node": "0e3e09d4b0bff4c1e74e9631359dc551641162a7", "parents": ["d3ffbbb2d1f1319b2ac5d29b5ff0b1ba969e3b42"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073826 - Move the Perfherder artifact schema out of mozharness `external_tools` into `testing/performance`. r=ahal,perftest-reviewers,mozperftest-reviewers,sparky\n\nThe schema describes the `PERFHERDER_DATA` payload, which mozharness, Raptor\nand mozperftest all produce and validate, so it does not belong to any one\nof them. Test tasks still run mozharness from `mozharness.zip`, so the\narchive carries the schema at its tree relative path and\n`perfherder_schema_path` resolves it from either a checkout or the zip.\nRaptor takes the path from `PERFHERDER_SCHEMA_PATH` in its environment,\nsince the tests archive does not contain it. The `docker-image` sparse\nprofile entry goes because no Dockerfile includes the schema.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327647\n", "files": ["build/sparse-profiles/docker-image", "python/mozbuild/mozbuild/action/test_archive.py", "python/mozperftest/mozperftest/metrics/perfherder.py", "testing/mozharness/external_tools/performance-artifact-schema.json", "testing/mozharness/mozharness/base/python.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/mozharness/mozharness/mozilla/testing/talos.py", "testing/perfdocs/generated/talos.md", "testing/perfdocs/generated/webextension.md", "testing/performance/common/performance-artifact-schema.json", "testing/raptor/raptor/perfdocs/webextension.md", "testing/raptor/raptor/results.py", "testing/talos/perfdocs/index.md"], "git_node": "b66b4535f4eb96a28c8d2d4ca373d207671e1c98", "git_parents": ["df339cb36fe714d35568e3f2f344b2118728dc63"], "node": "b8cb764183232631f39f672a8b80111fbdc36621", "parents": ["0e3e09d4b0bff4c1e74e9631359dc551641162a7"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073826 - Move `robustcheckout.py` from mozharness `external_tools` to `taskcluster/scripts`. r=ahal,taskgraph-reviewers\n\nThe extension is CI infrastructure. `run-task` loads it, the decision\ntask uploads it as an artifact next to `run-task` and `fetch-content`,\nand the base Docker images copy it into `/usr/local/mercurial`. None of\nthat involves mozharness. The file is byte identical, so it keeps the\nruff exclusion it had under `external_tools`. The `docker-image` sparse\nprofile entry goes because the profile already includes all of\n`taskcluster/`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327648\n", "files": ["build/sparse-profiles/docker-image", "pyproject.toml", "taskcluster/docker/debian-base/Dockerfile", "taskcluster/docker/fedora41-base/Dockerfile", "taskcluster/docker/opensuse-leap-base/Dockerfile", "taskcluster/docker/ubuntu1804-base/Dockerfile", "taskcluster/docs/versioncontrol.md", "taskcluster/gecko_taskgraph/decision.py", "taskcluster/scripts/robustcheckout.py", "testing/mozharness/external_tools/robustcheckout.py", "testing/mozharness/mozharness/base/vcs/mercurial.py"], "git_node": "f5b77e2ed343e1b6120046332858dfaa8c25294e", "git_parents": ["b66b4535f4eb96a28c8d2d4ca373d207671e1c98"], "node": "57efd5f9c277e7884bccfe58aebf06427e0bdcdd", "parents": ["b8cb764183232631f39f672a8b80111fbdc36621"], "tags": []}, {"author": "Brendan Birdsong \u003cbbirdsong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072361 - Add New Tab SponsoredTopSitesScoreProvider module for sponsored top sites. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326703\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js"], "git_node": "0d64bd54a8c7872727b1cc69027dbd6eb86864b1", "git_parents": ["f5b77e2ed343e1b6120046332858dfaa8c25294e"], "node": "7936fb8bbeea32ffa6b06db4a15d8a2fe5991b76", "parents": ["57efd5f9c277e7884bccfe58aebf06427e0bdcdd"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074325 - Pt 4 - Move WebRender framebuffer objects into the GL backend r=gfx-reviewers,lsalzman\" for causing diffscopes build bustages failures\n\nThis reverts commit 431ea42eaf8caccc8942d7f1c8546d8dc6e2e67e.\n\nRevert \"Bug 2074325 - Pt 3 - Make whole-target WebRender clears the render pass load ops r=gfx-reviewers,lsalzman\"\n\nThis reverts commit f56c582a5233a45e2cf2819a30d4f9ef1f3bc97e.\n\nRevert \"Bug 2074325 - Pt 2 - Make the WebRender scissor a single piece of render pass state r=gfx-reviewers,lsalzman\"\n\nThis reverts commit b50d049ffa5fde98ecbf84858e01e23f63aa9b9d.\n\nRevert \"Bug 2074325 - Pt 1 - Build wrench shaders through a separate device, as Gecko does r=gfx-reviewers,lsalzman\"\n\nThis reverts commit 90c8c1f47b798ea2c4ed68262d2cb7872131e7be.\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/device/types.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/upload.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "c39c85c8e734d1b124ae54da58e3860e4f0f10d5", "git_parents": ["0d64bd54a8c7872727b1cc69027dbd6eb86864b1"], "node": "21dad5fb2859e4f0d357c752a17b0dd8eaf4a02b", "parents": ["7936fb8bbeea32ffa6b06db4a15d8a2fe5991b76"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 1 - Build wrench shaders through a separate device, as Gecko does r=gfx-reviewers,lsalzman\n\nGecko compiles WebRender's shaders through a device of their own and shares\nthe programs with every window's renderer, so a program created or linked\nthrough one device is drawn with through another. Wrench let the renderer\nbuild its own shaders, which never exercised that. It now mirrors Gecko:\nthe shaders are built on a separate device, precached fully with --precache\nand asynchronously otherwise, and handed to the renderer, which owns and\nreleases them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328029\n", "files": ["gfx/wr/wrench/src/wrench.rs"], "git_node": "7e24094a50feebd85f61e4741df130eb53922753", "git_parents": ["c39c85c8e734d1b124ae54da58e3860e4f0f10d5"], "node": "61f684df53edae6ec6664d6858d213d46fc76586", "parents": ["21dad5fb2859e4f0d357c752a17b0dd8eaf4a02b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 2 - Make the WebRender scissor a single piece of render pass state r=gfx-reviewers,lsalzman\n\nThe scissor was three GL-style toggles, enable_scissor, disable_scissor and\nset_scissor_rect, each issuing its call immediately. Explicit graphics APIs\nset the scissor as dynamic state on the pass, with a default of the whole\ntarget, so a backend needs one set_scissor(Option\u003crect\u003e) that begin_render_pass\nresets. Renderer call sites become one call per rect, and the frame-start\ndisable goes away since every pass starts unscissored.\n\nThe GL backend caches the scissor alongside the other render state and issues\nenable, disable and glScissor only when something changes, so the GL calls are\nthe same or fewer. A scissored clear now restores the scissor it found rather\nthan leaving the test disabled, which nothing relied on. The renderer passes\nthe scissor rect into the readback composite path, which needs it back after\nthe blit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328030\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "02a5815dbc775230ad5b0bc7dc75b0099626abbc", "git_parents": ["7e24094a50feebd85f61e4741df130eb53922753"], "node": "72352c05e0dc80a4cb361db2db66e0eb2ff2de70", "parents": ["61f684df53edae6ec6664d6858d213d46fc76586"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 3 - Make whole-target WebRender clears the render pass load ops r=gfx-reviewers,lsalzman\n\nExplicit graphics APIs clear an attachment by giving the render pass a\nclear load op rather than by a clear command, and describe the depth\nattachment's load separately from color. LoadOp becomes generic with a Clear\nvariant, RenderPassDescriptor gains depth_load, and begin_render_pass applies\nboth, so every clear of a whole target moves into the pass descriptor. What\nremains are clears of part of a target, which become clear_rect with a\nmandatory rect; in an explicit API those are a draw, as the ps_clear path\nalready does.\n\nThe color and alpha target clear logic is split into a plan, taken before the\npass begins so it can choose the load ops, and the rect clears and quads that\nfollow. The decisions themselves are unchanged. The composite pass sets the\npartial present damage region before beginning the pass, since its clear now\nhappens as the pass begins, and the region must be set before any rendering\nto the framebuffer. The GL calls issued are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328031\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/device/types.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/upload.rs"], "git_node": "72d0c4aea2a86b25fffe9f9c2d63a3c100518308", "git_parents": ["02a5815dbc775230ad5b0bc7dc75b0099626abbc"], "node": "cbfe2c82f34f76d2ff4c8d2ad159e9f44788491a", "parents": ["72352c05e0dc80a4cb361db2db66e0eb2ff2de70"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 4 - Move WebRender framebuffer objects into the GL backend r=gfx-reviewers,lsalzman\n\nTexture carried two GL framebuffer object handles, and DrawTarget and\nReadTarget named a target by one, so every backend would have had to invent\nframebuffer objects. Explicit graphics APIs attach a texture to a pass\ndirectly. Texture now records only whether it is a render target and whether\na depth buffer has been requested, DrawTarget and ReadTarget name the texture\nthrough a TextureId, and a native surface read target carries the surface\nhandle like the draw target does.\n\nThe GL backend keeps the FBOs of each render target texture in a map by\ntexture id, created and deleted where the texture's were, and looks them up\nwhen binding a target. FBOId is private to it. The GL calls issued are\nunchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328032\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/types.rs"], "git_node": "21ca9eda62399406776588c52108602f57771688", "git_parents": ["72d0c4aea2a86b25fffe9f9c2d63a3c100518308"], "node": "5586782b36490e1fc5c05b52424ccf6ac3bff971", "parents": ["cbfe2c82f34f76d2ff4c8d2ad159e9f44788491a"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070824 - Move node-licenses into the legal() Treeherder group r=taskgraph-reviewers,bhearsum\" for causing multiple diffoscope build bustages failures\n\nThis reverts commit e329b6e4e976d70085133545056f53e95988972d.\n\nRevert \"Bug 2070824 - Stop repeating moz.yaml in the license declarations r=firefox-build-system-reviewers,linter-reviewers,webrtc-reviewers,gfx-reviewers,bwc,nical,sergesanspaille\"\n\nThis reverts commit f34bef88d8b4c23a30d7ec2ef043cd42d1c43d98.\n\nRevert \"Bug 2070828 - Document the license declarations and the SBOM\"\n\nThis reverts commit dbb4be19ca9ae1afcf7c5daa051e214d3c58306b.\n\nRevert \"Bug 2070828 - Generate the SBOM on shippable builds r=firefox-build-system-reviewers,taskgraph-reviewers,ahochheiden,sergesanspaille,ahal\"\n\nThis reverts commit 2bbdda936690f57cd633ccab5e702739c9e364af.\n\nRevert \"Bug 2070827 - Represent every about:license notice in the SBOM r=mach-reviewers,ahochheiden\"\n\nThis reverts commit 6efe1718f95bd07be54b50dfebfde746f121c0da.\n\nRevert \"Bug 2070824 - Add `mach licenses` to render about:license without a build r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahochheiden\"\n\nThis reverts commit 9d334255ddb2813ac554b76cf38dfbd58740afd6.\n\nRevert \"Bug 2070827 - Attach the moz.build license notices to the SBOM components r=mach-reviewers,ahochheiden\"\n\nThis reverts commit 5f0b9a0479ef3ad6adbaa442e916edfd72d93ac4.\n\nRevert \"Bug 2070824 - Remove the hand-maintained license.html r=firefox-build-system-reviewers,sergesanspaille,frontend-codestyle-reviewers\"\n\nThis reverts commit e495153bacfbcb85cb3b713a63c97a908929d432.\n\nRevert \"Bug 2070824 - Render about:license from the LICENSES declarations r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit bf736acd01e59a3eb3fa514ea0871f6661663673.\n\nRevert \"Bug 2070824 - Declare every about:license notice in moz.build r=firefox-build-system-reviewers,ipc-reviewers,application-update-reviewers,media-playback-reviewers,credential-management-reviewers,webrtc-reviewers,devtools-reviewers,cubeb-reviewers,profiler-reviewers,win-reviewers,frontend-codestyle-reviewers,ai-platform-reviewers,sandbox-reviewers,crashreporting-reviewers,media-webspeech-reviewers,bobowen,dimi,canova,padenot,nchevobbe,mccr8,yjuglaret,bwc,ahochheiden\"\n\nThis reverts commit 8c79875a596a173c95c2a742943ee42884e9af3d.\n\nRevert \"Bug 2070824 - Add a `license-declarations` linter for the license declarations r=linter-reviewers,sergesanspaille,ahal\"\n\nThis reverts commit a4b69a0e0d229d30080656dba07d389289bbd673.\n", "files": [".prettierignore", "browser/base/jar.mn", "browser/base/moz.build", "browser/extensions/formautofill/moz.build", "build/moz.build", "devtools/client/debugger/dist/LICENSE-NOTICE-babel.txt", "devtools/client/debugger/dist/LICENSE-NOTICE-babylon.txt", "devtools/client/debugger/dist/moz.build", "devtools/client/debugger/moz.build", "devtools/client/inspector/markup/moz.build", "devtools/client/netmonitor/src/components/messages/parsers/moz.build", "devtools/client/ne