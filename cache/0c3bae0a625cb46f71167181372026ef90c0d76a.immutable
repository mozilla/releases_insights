__.ini", "testing/web-platform/meta/webmcp/imperative/executeTool-invalid-dictionary.https.html.ini", "testing/web-platform/meta/webmcp/imperative/register_tool_invalid_json_schema.https.html.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-iceRestart.html.ini", "testing/web-platform/meta/webrtc/RTCIceTransport.html.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-getStats-timestamp.https.html.ini", "testing/web-platform/meta/webrtc/RTCRtpReceiver-video-jitterBufferTarget-stats.html.ini", "testing/web-platform/meta/workers/worker-url-encoding.html.ini"], "git_node": "ef69bff0524f87eb4e68616fd2116b6d52494bfe", "git_parents": ["0ea51abc746e2117ac330017e8b8f016d4dcd6b3"], "node": "a3c7985e0072ed72452ee95c25d94440e53d4d3a", "parents": ["91bc3fcd48bc53ed577adc35a39a7fc007d5b7e4"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1719394 - Remove WebSocket connection map. r=devtools-reviewers,necko-reviewers,jdescottes,kershaw\" for causing dt failures @browser_net_ws-early-connection.js.\n\nThis reverts commit 37266c1ac0e3440704215a11613f640f19389fd3.\n\nRevert \"Bug 1719394 - Preserve early WebSocket frames. r=devtools-reviewers,necko-reviewers,kershaw,jdescottes\"\n\nThis reverts commit ff6a772594c7b43fbf06cf81dd36b734c6b25023.\n", "files": ["devtools/client/netmonitor/test/file_ws_early_backend_wsh.py", "devtools/client/netmonitor/test/websockets/browser.toml", "devtools/client/netmonitor/test/websockets/browser_net_ws-early-connection.js", "devtools/client/netmonitor/test/websockets/html_ws-early-connection-page.html", "devtools/server/actors/resources/websockets.js", "devtools/server/tests/xpcshell/test_websocket_watcher.js", "devtools/server/tests/xpcshell/xpcshell.toml", "dom/websocket/WebSocket.cpp", "dom/websocket/tests/test_websocket_frame.html", "netwerk/protocol/websocket/PWebSocketEventListener.ipdl", "netwerk/protocol/websocket/WebSocketChannel.cpp", "netwerk/protocol/websocket/WebSocketEventListenerChild.cpp", "netwerk/protocol/websocket/WebSocketEventListenerChild.h", "netwerk/protocol/websocket/WebSocketEventListenerParent.cpp", "netwerk/protocol/websocket/WebSocketEventService.cpp", "netwerk/protocol/websocket/WebSocketEventService.h", "netwerk/protocol/websocket/nsIWebSocketEventService.idl", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "1a81dc23e4c9e563df86d2f365bd45d1576f65ec", "git_parents": ["ef69bff0524f87eb4e68616fd2116b6d52494bfe"], "node": "b59b5b8e456d50ce3295d718255d14c5352d0090", "parents": ["a3c7985e0072ed72452ee95c25d94440e53d4d3a"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045801: Expand SitePolicies to support containerized site data. r=bsmth,baku\" for causing build bustages on ProcessIsolationTest.cpp.\n\nThis reverts commit c9177aeb6bffe3587128640e4430fc331b898b60.\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_policy.js", "toolkit/components/contextualidentity/tests/unit/xpcshell.toml", "toolkit/components/enterprisepolicies/EnterprisePoliciesContent.sys.mjs", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/nsIEnterprisePolicies.idl"], "git_node": "58645bd97ec3e873b7560555fc23baf953fb32bd", "git_parents": ["1a81dc23e4c9e563df86d2f365bd45d1576f65ec"], "node": "c41ad1fac7e1fc5e3103448a80d24ca6b870209d", "parents": ["b59b5b8e456d50ce3295d718255d14c5352d0090"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2062615 - Report timeouts and crashes against the test that failed r=ahal\n\nTrack whether the current test has finished separately from its name, so crash\nand leak attribution get a test path rather than a status marker, and stop\nsubstituting manifest paths for test names - mozcrash records the value verbatim\nas the crash's test field, and a manifest path cannot be mapped back to a test.\n\nEmit a structured test_end for harness-level aborts in RemoteProcessMonitor so\nthey reach consumers that only read structured actions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317809\n", "files": ["testing/mochitest/runtests.py", "testing/mochitest/runtestsremote.py", "testing/mochitest/runtestsremoteios.py", "testing/mochitest/tests/SimpleTest/TestRunner.js", "testing/mozbase/mozdevice/mozdevice/remote_process_monitor.py", "testing/mozbase/mozdevice/tests/manifest.toml", "testing/mozbase/mozdevice/tests/test_remote_process_monitor.py", "testing/mozbase/mozlog/tests/test_testsummary.py", "testing/mozbase/mozrunner/mozrunner/base/device.py"], "git_node": "e0f87089ba1c32f12fbf42dd36ea635d083c2ed7", "git_parents": ["58645bd97ec3e873b7560555fc23baf953fb32bd"], "node": "7041ac40a5d85d433bab0e5297c135e614cac5f6", "parents": ["c41ad1fac7e1fc5e3103448a80d24ca6b870209d"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071445: Initialize NSS through PSM before lockstore opens its keystore r=keeler\n\nHave LockstoreService::Init call EnsureNSSInitializedChromeOrContent()\nand fail service creation if PSM cannot bring NSS up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325518\n", "files": ["security/lockstore/LockstoreService.cpp"], "git_node": "76e181cd2dae6878a9d10d91ee0ec731aea0a19e", "git_parents": ["e0f87089ba1c32f12fbf42dd36ea635d083c2ed7"], "node": "f92efbad5e847366f72b327ad71031839a162ebd", "parents": ["7041ac40a5d85d433bab0e5297c135e614cac5f6"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046049 - Add a terminator hook to collect shutdown-hang crash annotations. r=xpcom-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304162\n", "files": ["toolkit/components/asyncshutdown/AsyncShutdown.sys.mjs", "toolkit/components/startup/nsAppStartup.cpp", "toolkit/components/startup/public/nsIAppStartup.idl", "toolkit/components/terminator/nsTerminator.cpp", "xpcom/base/AppShutdown.h", "xpcom/base/StaticMutex.h"], "git_node": "bb4bc2824c10e3ecce366fa0c9db0e2755e7c85a", "git_parents": ["76e181cd2dae6878a9d10d91ee0ec731aea0a19e"], "node": "031679e2a2347584e4e231f02ec80c9b6fd23109", "parents": ["f92efbad5e847366f72b327ad71031839a162ebd"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044611 - Replace SHDRCV/SHDACK thread-rename breadcrumbs with a ShuttingDownThreads crash annotation. r=xpcom-reviewers,emilio,ipc-reviewers\n\nThe diagnostic SHDRCV/SHDACK thread-name suffixes clutter thread names in\ncrash reports and can only carry a single bit of state. Remove them and\ninstead record a ShuttingDownThreads crash annotation: a JSON array of the\nin-flight nsThread::Shutdown handshakes, each with the joining/closing TID and\nname, the handshake phase (Joining/Recv/Ack) and when that phase was entered.\n\nIt is gathered by nsThread::CollectShutdownHangAnnotation via the\nCollectShutdownHangAnnotations hook added in bug 2046049, called just before a\ndeliberate shutdown crash, so it reflects the live state at the moment of the\nkill.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301248\n", "files": ["build/clang-plugin/ThreadFileAllows.txt", "ipc/docs/proc_shutdown.md", "toolkit/components/startup/nsAppStartup.cpp", "toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "xpcom/tests/gtest/TestThreadShutdownAnnotations.cpp", "xpcom/tests/gtest/moz.build", "xpcom/threads/nsThread.cpp", "xpcom/threads/nsThread.h"], "git_node": "d04bc93c2ec2cbfc3beed51916fb484c8e3147e1", "git_parents": ["bb4bc2824c10e3ecce366fa0c9db0e2755e7c85a"], "node": "d06ba6c90372d0a83b5236006448504e957a7163", "parents": ["031679e2a2347584e4e231f02ec80c9b6fd23109"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2068823 - Remove web_push.unsubscribed_by_clearing_data r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325405\n", "files": ["dom/push/PushService.sys.mjs", "dom/push/metrics.yaml", "dom/push/test/xpcshell/test_clearAll_successful.js", "dom/push/test/xpcshell/test_clear_origin_data.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "fc7445ad50fe1dad32559e93c4079eb706c412e5", "git_parents": ["d04bc93c2ec2cbfc3beed51916fb484c8e3147e1"], "node": "2b81bb68994c785f6f11714e37442647fcb81c59", "parents": ["d06ba6c90372d0a83b5236006448504e957a7163"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045510 - Test snappy CompressedData chunk shorter than the CRC field. r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305219\n", "files": ["xpcom/tests/gtest/TestSnappyStreams.cpp"], "git_node": "88f19976a655d8de41f9d6cfea5c5cac5b1351f3", "git_parents": ["fc7445ad50fe1dad32559e93c4079eb706c412e5"], "node": "d120d3177a8fe7ca2c7f48b5d6a313917e72c440", "parents": ["2b81bb68994c785f6f11714e37442647fcb81c59"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051106 - Add a regression test for pref callback notification snapshot lifetime. r=gstoll\n\nCovers compaction of the callback trie during a notification round, plus\na test-only hook to run the idle sweep synchronously.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309514\n", "files": ["modules/libpref/Preferences.cpp", "modules/libpref/Preferences.h", "modules/libpref/test/gtest/Basics.cpp"], "git_node": "41db4f451a2003cff496a4d42afe84a770d534bb", "git_parents": ["88f19976a655d8de41f9d6cfea5c5cac5b1351f3"], "node": "817862b1022d4cd3392303dfa045453a3ec6112f", "parents": ["d120d3177a8fe7ca2c7f48b5d6a313917e72c440"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058645 - Test applying a pref update that flips a type a content process never saw. r=gstoll\n\nThe xpcshell child process has the \"web\" remote type, so pref updates reach it\nthrough the same sanitization filter as any web content process. That is enough\nto stage the state where the parent holds a String while the child still has an\nInt cached under the shared type tag, and to then deliver an update whose\ndefault value flips that tag.\n\nCover both ways the child can reach the stale user value from there: an update\nthat carries a new user value, which has to replace it, and one that carries\nnone, which has to discard it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315247\n", "files": ["modules/libpref/test/unit_ipc/test_sanitized_type_flip.js", "modules/libpref/test/unit_ipc/xpcshell.toml"], "git_node": "3215e710bd0090cc086f46d27859a6722c5cf154", "git_parents": ["41db4f451a2003cff496a4d42afe84a770d534bb"], "node": "617fd16c2b48b83ae04e2ba84d5a014455a5923d", "parents": ["817862b1022d4cd3392303dfa045453a3ec6112f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071173 - Enable New Tab search bar by default in debug builds. r=daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325350\n", "files": ["browser/app/profile/firefox.js"], "git_node": "1d2440039d6055e2d0b0642e8c78c61e12b848ae", "git_parents": ["3215e710bd0090cc086f46d27859a6722c5cf154"], "node": "b30d6e74956bd7725af3d3c1d3ecd0829cf318b2", "parents": ["617fd16c2b48b83ae04e2ba84d5a014455a5923d"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2068764 [Linux][Vulkan Video] Cache selected device for compositor GPU too. r=stransky,media-playback-reviewers\n\nSelectVulkanDecoderPhysicalDevice only reused the cached name when the\ncompositor renderer node was empty. Key the cache off renderer DRM ids\nso later inits on a real GPU skip vkEnumeratePhysicalDevices.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325671\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp"], "git_node": "43c270e37b7275f780e767f0b1e4fda89ecdfc01", "git_parents": ["1d2440039d6055e2d0b0642e8c78c61e12b848ae"], "node": "1c3cec6a0b7c98b5a445123733db8cc38fcc2302", "parents": ["b30d6e74956bd7725af3d3c1d3ecd0829cf318b2"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "408cf945cce0afc2b94de3eb44cae644a9d3ef93", "git_parents": ["43c270e37b7275f780e767f0b1e4fda89ecdfc01", "1713b2fe116495380852077e8f7f3618d4380721"], "node": "fb97b4a5f9f2d40139c281f6bb8aa0cf97e54b8b", "parents": ["1c3cec6a0b7c98b5a445123733db8cc38fcc2302", "980b80614bdd65e23da0d3ba757a68844271f1c6"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068590: Report the time since install and update in the new-profile ping. r=jhirsch\" for causing xpc failures.\n\nThis reverts commit 363edddb2de800eb50f91a0599f5b829c6ee6e2c.\n", "files": ["toolkit/profile/ProfileMetrics.sys.mjs", "toolkit/profile/metrics.yaml", "toolkit/profile/test/xpcshell/test_profile_metrics_seconds_since_install.js", "toolkit/profile/test/xpcshell/test_profile_metrics_seconds_since_no_files.js", "toolkit/profile/test/xpcshell/test_profile_metrics_seconds_since_update.js", "toolkit/profile/test/xpcshell/xpcshell.toml"], "git_node": "d15d8a8e7ecff19c16280a900c6fcff70b89c881", "git_parents": ["408cf945cce0afc2b94de3eb44cae644a9d3ef93"], "node": "d94c40d9b7c1cf44d7df74f63954a25ecad89f78", "parents": ["fb97b4a5f9f2d40139c281f6bb8aa0cf97e54b8b"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071311 - Add MDN icon to the search-config-icons dumps. r=search-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325416\n", "files": ["services/settings/dumps/main/moz.build", "services/settings/dumps/main/search-config-icons/2cb3ddd3-0b70-4a4b-b487-fb36cb9658ca", "services/settings/dumps/main/search-config-icons/2cb3ddd3-0b70-4a4b-b487-fb36cb9658ca.meta.json"], "git_node": "e750b90d1683c8e40a143decead49d31e9302803", "git_parents": ["d15d8a8e7ecff19c16280a900c6fcff70b89c881"], "node": "02135c086e6a8cff3d55c7f27b6db7f5c5c6572c", "parents": ["d94c40d9b7c1cf44d7df74f63954a25ecad89f78"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070485 - Update sidebar triage rotation to two weeks r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324570\n", "files": ["browser/components/sidebar/triage.json"], "git_node": "d36400404f1283a2e0fb6df87898cb99830c2ff9", "git_parents": ["e750b90d1683c8e40a143decead49d31e9302803"], "node": "97dfc78bc7af646a627ccee7e2500510686c288b", "parents": ["02135c086e6a8cff3d55c7f27b6db7f5c5c6572c"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710901 - Replace hand-rolled waitForCondition with TestUtils.waitForCondition in toolkit/mozapps/extensions/test/browser. r=extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325387\n", "files": ["browser/components/extensions/test/browser/browser_unified_extensions.js", "toolkit/mozapps/extensions/test/browser/head.js"], "git_node": "efdf4b0132f0cf289ca30fd36f32da0e4ba94987", "git_parents": ["d36400404f1283a2e0fb6df87898cb99830c2ff9"], "node": "4e2545987db0fe1ef86112f8782d34d09a816085", "parents": ["97dfc78bc7af646a627ccee7e2500510686c288b"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710901 - Replace waitForCondition with ContentTaskUtils.waitForCondition in browser/components/resistfingerprinting/test. r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325388\n", "files": ["browser/components/resistfingerprinting/test/browser/browser_cross_origin_isolated_animation_api.js"], "git_node": "124b64e83a809fe3185ef3cf49547ebddce74440", "git_parents": ["efdf4b0132f0cf289ca30fd36f32da0e4ba94987"], "node": "d1b91af40bbaba8b8672e94b148fd7929ec50862", "parents": ["4e2545987db0fe1ef86112f8782d34d09a816085"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710901 - Replace waitForCondition with TestUtils.waitForCondition in widget/tests. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325389\n", "files": ["widget/tests/browser/browser_test_AZERTY_digit_shortcut.js"], "git_node": "fdefa0c54c1131198fc242a0b219d39daaca806b", "git_parents": ["124b64e83a809fe3185ef3cf49547ebddce74440"], "node": "9197b4bfc04e773d8d79401daf3e5f4ea2f19cab", "parents": ["d1b91af40bbaba8b8672e94b148fd7929ec50862"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710901 - Replace waitForCondition with ContentTaskUtils.waitForCondition in browser/extensions/webcompat/tests. r=webcompat-reviewers,twisniewski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325390\n", "files": ["browser/extensions/webcompat/tests/browser/browser_special_content_scripts.js"], "git_node": "cb91651deab3834c446733d471f1061947f32283", "git_parents": ["fdefa0c54c1131198fc242a0b219d39daaca806b"], "node": "27e8f007a5866c3e8f2c30b31383e6b4601f2c5e", "parents": ["9197b4bfc04e773d8d79401daf3e5f4ea2f19cab"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710901 - Replace waitForCondition with TestUtils.waitForCondition in browser/components/uitour/test. r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325393\n", "files": ["browser/components/uitour/test/browser_UITour.js", "browser/components/uitour/test/browser_UITour2.js", "browser/components/uitour/test/browser_UITour3.js", "browser/components/uitour/test/browser_UITour_forceReaderMode.js", "browser/components/uitour/test/browser_UITour_modalDialog.js", "browser/components/uitour/test/browser_UITour_pocket.js", "browser/components/uitour/test/browser_UITour_sync.js", "browser/components/uitour/test/browser_UITour_toggleReaderMode.js", "browser/components/uitour/test/browser_openPreferences.js", "browser/components/uitour/test/head.js"], "git_node": "fccf1ed43d762102d2475f6634838887395702ef", "git_parents": ["cb91651deab3834c446733d471f1061947f32283"], "node": "886730cef50d197056fcd52f34386afb966f74ea", "parents": ["27e8f007a5866c3e8f2c30b31383e6b4601f2c5e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068973 - Gate call to InitSkrifaFontRef() behind a runtime pref. r=AlaskanEmily\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323250\n", "files": ["gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxUserFontSet.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "e06fcfe9f52cb28d0e4a563f724bd03b0ebbbac2", "git_parents": ["fccf1ed43d762102d2475f6634838887395702ef"], "node": "70f39c62c8b6d9212d058943488b51f24158cf6f