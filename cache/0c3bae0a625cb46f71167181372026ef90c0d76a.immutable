ow-auto-repeat-013.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-014.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-015.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-016.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-017.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-021.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-022.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-023.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-024.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-025.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-026.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-027.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-028.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/dynamic-grid-track-direction.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-flex-sizing-rows-min-max-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-fr-rows-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-check-grid-height-on-resize.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/block-container-block-end-clearance.html"], "git_node": "ab5b898e126f68a25d8649d83c4287e1e916651a", "git_parents": ["60785570e486efb06d333f0974a1a57e035004ae"], "node": "6426534c69dd97d5de41308802d90d992b0f6f05", "parents": ["2d92e6e2a1ab9cdf34a07ef4a0a9601ee70164fc"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072892 - Remove metadata for WebCryptoAPI/digest/digest.https.any.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327827\n", "files": ["testing/web-platform/meta/WebCryptoAPI/digest/digest.https.any.js.ini"], "git_node": "29201aa512ef662c3d4738d2175555ab458f87cb", "git_parents": ["ab5b898e126f68a25d8649d83c4287e1e916651a"], "node": "b0364f747259ab9fc60c0811348e61668621f131", "parents": ["6426534c69dd97d5de41308802d90d992b0f6f05"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073781 - Fix macOS WebGL test expectations for non-nightly builds. r=gfx-reviewers,nical\n\nThe expectation updates from bug 2072535 did not account for the fact\nthat Metal ANGLE WebGL is enabled only on Nightly, and therefore cause\nfailures in beta simulation builds. This patch ensures that\nnon-nightly builds retain the same expectations as before, and should\nbe reverted when Metal ANGLE WebGL rides the trains.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327787\n", "files": ["dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml"], "git_node": "7dca1db2342ab060e8148cc5dccd7bc1d3ae8b5e", "git_parents": ["29201aa512ef662c3d4738d2175555ab458f87cb"], "node": "699d82937164d03060eafd2d8a22c450798acc6e", "parents": ["b0364f747259ab9fc60c0811348e61668621f131"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073030 - Lint all gfx/ headers through clang-tidy r=gfx-reviewers,nical\n\nChanges includes:\n- using C++20 type alias and inline variables\n- making some methods default\n- deleting a header which is never included\n- rework some include dependencies to make header self contained\n- the above sometimes require moving implementation to .cpp\n- conditionally export some headers from gfx/layers/moz.build\n- replacing 0 by nullptr\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326968\n", "files": ["gfx/2d/2D.h", "gfx/2d/BasePoint3D.h", "gfx/2d/BaseRect.h", "gfx/2d/CriticalSection.h", "gfx/2d/GenericRefCounted.h", "gfx/2d/RecordingTypes.h", "gfx/2d/ScaleFactor.h", "gfx/2d/StackArray.h", "gfx/2d/Tools.h", "gfx/config/gfxConfigManager.h", "gfx/gl/AutoMappable.h", "gfx/gl/ForceDiscreteGPUHelperCGL.h", "gfx/gl/GLContext.cpp", "gfx/gl/GLContext.h", "gfx/gl/HeapCopyOfStackArray.h", "gfx/gl/MozFramebuffer.cpp", "gfx/gl/MozFramebuffer.h", "gfx/gl/moz.build", "gfx/ipc/OverlayInfo.h", "gfx/layers/NativeLayerRemoteChild.h", "gfx/layers/apz/public/APZInputBridge.h", "gfx/layers/apz/util/ContentProcessController.h", "gfx/layers/moz.build", "gfx/layers/opengl/CompositingRenderTargetOGL.h", "gfx/layers/opengl/OGLShaderConfig.h", "gfx/layers/wr/OMTASampler.h", "gfx/src/Etagere.h", "gfx/src/nsRectAbsolute.h", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxLineSegment.h", "gfx/thebes/gfxSparseBitSet.h", "gfx/thebes/moz.build", "gfx/vr/moz.build"], "git_node": "7fa148a77f1747e0377bd265d65601286761180b", "git_parents": ["7dca1db2342ab060e8148cc5dccd7bc1d3ae8b5e"], "node": "82eafa03bc81933af1e4e4d4ef94321cddb0ae34", "parents": ["699d82937164d03060eafd2d8a22c450798acc6e"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043461 - Update bookmark-12 and pin-12 icons r=desktop-theme-reviewers,hjones,fxview-reviewers,sfoster,thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326049\n", "files": ["browser/themes/shared/icons/bookmark-12.svg", "browser/themes/shared/icons/pin-12.svg"], "git_node": "ba0cf71d11272d57c79fdcfcb2c66346d9eac5c0", "git_parents": ["7fa148a77f1747e0377bd265d65601286761180b"], "node": "1d25d256178b753e7b5bc2261c5b390693377dbb", "parents": ["82eafa03bc81933af1e4e4d4ef94321cddb0ae34"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Don't swap the requested frame dimensions for rotated frames. r=webrtc-reviewers,bwc\n\nA capture backend reports rotation rather than applying it, so its frames stay\nin camera orientation and it is the consumer that turns them upright for\ndisplay. CalculateDesiredSize() nonetheless swapped the requested width and\nheight whenever a frame carried a rotation of 90 or 270 degrees, which sized\nthe frame against an orientation it was never delivered in.\n\nWith a 640x480 request and a frame rotated 90 degrees, that computed a desired\nsize of 480x640 for a frame that is 640x480. DeliverFrame() then declined to\nrescale, since that would have meant upscaling the height, so the frame was\ndelivered untouched at 640x480 while getSettings() reported 480x640.\n\nRotation is display metadata and does not change which frame size was\nnegotiated, so the swap is removed rather than corrected. It also swapped\nmCapabilityWidth with itself instead of with mCapabilityHeight, so it had never\nswapped the dimensions of the capability it was reached for in the first place.\n\ntest_getUserMedia_videoOrientation.html gains two passes over the camera\ncapture backend, reached with media.getusermedia.camera.fake.force since\nfake: true uses MediaEngineFake and does not exercise\nMediaEngineRemoteVideoSource at all: one rotating while capture is running, and\none where the rotation is already in effect when capture starts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324970\n", "files": ["dom/media/VideoSegment.cpp", "dom/media/VideoSegment.h", "dom/media/systemservices/PCameras.ipdl", "dom/media/systemservices/VideoFrameUtils.cpp", "dom/media/webrtc/MediaEngineRemoteVideoSource.cpp", "dom/media/webrtc/tests/mochitests/mochitest_getusermedia.toml", "dom/media/webrtc/tests/mochitests/test_getUserMedia_videoOrientation.html"], "git_node": "a81daf23899e428cbaeb7ae953379c8c065599dc", "git_parents": ["ba0cf71d11272d57c79fdcfcb2c66346d9eac5c0"], "node": "afacb6747a4d0cb19330103a47a3e213e2cc7923", "parents": ["1d25d256178b753e7b5bc2261c5b390693377dbb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Apply capture rotation centrally, behind a pref. r=webrtc-reviewers,layout-reviewers,bwc,TYLin\n\nBackends disagree about rotation: some route through\nVideoCaptureImpl::IncomingFrame, where libwebrtc would apply\nSetApplyRotation, and some deliver straight to DeliverCapturedFrame and so\nnever reach it. IncomingFrame also allocates a full buffer per frame whether\nor not it rotates.\n\nRather than teaching every backend to use IncomingFrame, straighten the frame\nonce in AggregateCapturer::OnFrame, after the frame-rate throttle so it is\npaid per delivered frame rather than per captured frame, and only when a\nconsumer wants the frame. media.webrtc.capture.apply-rotation decides whether\nto apply it at all.\n\nPCameras now says whether that happened: originalRotationRequired is the\nrotation the backend reported, and rotationApplied whether the parent\nstraightened the buffer or left it to the consumer. The negotiated capability\ndescribes the frame as the backend produced it, so the consumer needs the\noriginal rotation for its size calculations either way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324971\n", "files": ["dom/media/systemservices/CamerasParent.cpp", "dom/media/systemservices/FakeVideoSource.cpp", "dom/media/systemservices/PCameras.ipdl", "dom/media/systemservices/VideoFrameUtils.cpp", "dom/media/systemservices/VideoFrameUtils.h", "dom/media/webrtc/MediaEngineRemoteVideoSource.cpp", "dom/media/webrtc/tests/mochitests/test_getUserMedia_videoOrientation.html", "dom/media/webrtc/tests/reftest/reftest.list", "dom/media/webrtc/tests/reftest/videoOrientation-ref.html", "dom/media/webrtc/tests/reftest/videoOrientation.html", "layout/reftests/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/mediacapture-streams/MediaStreamTrack-rotation.https.html.ini", "testing/web-platform/mozilla/tests/mediacapture-streams/MediaStreamTrack-rotation.https.html"], "git_node": "b06c54f94e03f1492743ec3e41c339bc9ea72a03", "git_parents": ["a81daf23899e428cbaeb7ae953379c8c065599dc"], "node": "ddd3c53fc3ca6b0392fa5fd2b4feea9c8f3d88bb", "parents": ["afacb6747a4d0cb19330103a47a3e213e2cc7923"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Only report a capture frame size change when it actually changed. r=webrtc-reviewers,bwc\n\ndstSize is the negotiated size while mScaledImageSize tracks the delivered\nimage, and the two differ when the parent straightens a quarter turn. Comparing\nthem dispatched a settings update for every frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324972\n", "files": ["dom/media/webrtc/MediaEngineRemoteVideoSource.cpp", "dom/media/webrtc/MediaEngineRemoteVideoSource.h"], "git_node": "e2aa0d3859a2b9658b78c718c69fa4fbde987a4a", "git_parents": ["b06c54f94e03f1492743ec3e41c339bc9ea72a03"], "node": "eefd2b074a58bfb31067a2370a1ec6560ceda548", "parents": ["ddd3c53fc3ca6b0392fa5fd2b4feea9c8f3d88bb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Report rotation from the Android capture backend instead of applying it. r=webrtc-reviewers,bwc\n\nVideoCaptureAndroid rotated every frame with I420Buffer::Rotate, which\nallocates, and then delivered it tagged as needing no rotation. Every other\nbackend reports the rotation and leaves the frame in camera orientation for the\nconsumer to turn upright, so do that here too and drop the copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324973\n", "files": ["dom/media/systemservices/android_video_capture/video_capture_android.cc"], "git_node": "a705c33cc59dae072ca209c955aa9dc0f73131fb", "git_parents": ["e2aa0d3859a2b9658b78c718c69fa4fbde987a4a"], "node": "659f25a8e300a1a36059ea617c59f77e50dc4de7", "parents": ["eefd2b074a58bfb31067a2370a1ec6560ceda548"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058417 - Testcase. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320207\n", "files": ["dom/events/test/mochitest.toml", "dom/events/test/test_datatransfer_internal_types.html"], "git_node": "b1fbee40ce3722b8aea575d22dcef35998ed62f0", "git_parents": ["a705c33cc59dae072ca209c955aa9dc0f73131fb"], "node": "b7d03aef48153f3aeba31925494c4d1a521b1d04", "parents": ["659f25a8e300a1a36059ea617c59f77e50dc4de7"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070817 - Resolve AudioContext operation promises on the graph thread. r=karlt\n\nPendingResumeOperation::Apply() unsuspended the context's tracks on the graph\nthread but dispatched the promise resolution to a main thread stable state\nrunnable. Resolving there only queues the MozPromise Then callback as a further\nmain thread task, so AudioContext::OnStateChanged() -- which is what settles the\npromises in mPendingResumePromises -- ran one task later again.\n\nAn AudioWorklet starts producing as soon as the tracks are unsuspended, so its\nport messages can reach main thread inside that window. A close() from such a\nmessage handler then found mPendingResumePromises non-empty and rejected the\nresume promises with \"Closed before resume completed\", for a resume that had in\nfact completed -- OnStateChanged() reached Running on the very next tick.\n\nResolve directly on the graph thread instead. Suspend, Close and pending Resume\noperations are all applied before the iteration's processing, so the main thread\nupdates from the previous iteration already describe the state for the rendered\ntime; there is nothing for a stable state runnable to wait for. Suspend and\nClose are changed the same way so that promises for one AudioContext keep\nsettling in the order the operations were applied.\n\nOn try this takes\nwebaudio/the-audio-api/the-audioworklet-interface/audioworkletprocessor-unconnected-outputs.https.window.js\non Windows opt from 50/80 failures to 0/40.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322503\n", "files": ["dom/media/MediaTrackGraph.cpp"], "git_node": "b32e66018bad2ef3b01dddbd42ee05d92839b536", "git_parents": ["b1fbee40ce3722b8aea575d22dcef35998ed62f0"], "node": "b52e37bbaa917290c7d665b3d9666799d634b0fc", "parents": ["b7d03aef48153f3aeba31925494c4d1a521b1d04"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070817 - Resolve NotifyWhenDeviceStarted promises on the graph thread. r=karlt\n\nThe promise was resolved from a main thread runnable so that the graph thread\nwould not take MozPromise's mutex. Dispatching that runnable directly to the\nmain thread however used to, when this code was originally written, grab a much\nmore contended lock for the main thread event queue.\n\nWith the graph now using tail dispatch, dispatches to main thread grabs no lock.\nResolving directly on the graph thread only takes the promise mutex. Since this\nis an exclusive promise there is at most a single consumer, i.e. virtually no\ncontention. Compared to the original code this is a net win, and provides\neasier reasoning of the order of events than the original resolve-on-main did.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324925\n", "files": ["dom/media/MediaTrackGraph.cpp"], "git_node": "8809982ff3c56de06087bc2136fe3917b2197694", "git_parents": ["b32e66018bad2ef3b01dddbd42ee05d92839b536"], "node": "314d6bcf56f004b7a5151b6b2f090dea8e8d7ce4", "parents": ["b52e37bbaa917290c7d665b3d9666799d634b0fc"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070817 - Add nsIEventTarget::SUPPORTS_TAIL_DISPATCH. r=xpcom-reviewers,nika\n\nThis lets code holding an nsISerialEventTarget tell whether dispatching to it\nfrom a tail dispatching AbstractThread goes through the tail dispatcher, without\nknowing the concrete type. It is set by the AbstractThread implementations\nwhose TailDispatchPolicy is not NoTailDispatch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324926\n", "files": ["dom/media/MediaTrackGraph.cpp", "xpcom/threads/AbstractThread.cpp", "xpcom/threads/TaskQueue.cpp", "xpcom/threads/nsIEventTarget.idl"], "git_node": "68a799b80b26a13dbc1481edadd37dc91398ab9d", "git_parents": ["8809982ff3c56de06087bc2136fe3917b2197694"], "node": "123d429315959282699fe876a53d749e9d1463e0", "parents": ["314d6bcf56f004b7a5151b6b2f090dea8e8d7ce4"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070817 - Add MozPromiseHolder::RequireTailDispatch(). r=xpcom-reviewers,nika\n\nA producer settling a promise from a tail dispatching AbstractThread, such as\nthe MediaTrackGraph, can do so cheaply only if the Then callbacks are dispatched\nthrough its tail dispatcher. That depends on the consumer passing an event\ntarget that supports tail dispatch; otherwise Resolve() dispatches to the target\ndirectly, which for the main thread means taking its heavily contended event\nqueue lock, on an audio callback thread. RequireTailDispatch() lets the producer\nstate that requirement so it is asserted when the callbacks are dispatched,\nrather than being a convention.\n\nIt is exposed on the holder only, so that it can be set before any Then handler\ncould have been dispatched, and it applies to that promise alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324927\n", "files": ["xpcom/tests/gtest/TestMozPromise.cpp", "xpcom/threads/MozPromise.h"], "git_node": "b8ec8291b1d7971034f278dd6c9f3d9c39621c57", "git_parents": ["68a799b80b26a13dbc1481edadd37dc91398ab9d"], "node": "77c991b6a317eaa922b3e719fd089264e7f9477e", "parents": ["123d429315959282699fe876a53d749e9d1463e0"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070817 - Remove AudioContext::GetMainThread(). r=karlt,media-playback-reviewers\n\nIt dispatched to the owner window's labeled event target for Quantum DOM task\nscheduling, with a fallback for a torn down window. Labeled event targets are\ngone and nsIGlobalObject::SerialEventTarget() is the main thread event target\nfor windows, so both branches returned the same thing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324928\n", "files": ["dom/media/webaudio/AudioContext.cpp", "dom/media/webaudio/AudioContext.h"], "git_node": "b8e234cd7ea6064aac57fb4f64b4f7cf1d48a4b6", "git_parents": ["b8ec8291b1d7971034f278dd6c9f3d9c39621c57"], "node": "a74e7acf29aa7de3fb719a5e05f584ead5e7d354", "parents": ["77c991b6a317eaa922b3e719fd089264e7f9477e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070817 - Handle MediaTrackGraph promises on AbstractThread::MainThread(). r=karlt,webrtc-reviewers,media-playback-reviewers,bwc\n\nThe graph settles these promises on the graph thread. Dispatching the Then\ncallbacks only goes through the graph's tail dispatcher if the event target is\nthe AbstractThread for the main thread; with the plain nsIThread event target,\nResolve() would take the main thread's event queue lock from the audio callback.\n\nAs a side effect, multiple audio context operations tail-dispatched from a\nsingle graph iteration will fire \"statechange\" events from a single main thread\ngroup runnable, with no microtask checkpoints in between. This is against spec.\nThis patch therefore adds an extra bounce to the main thread nsThread for the\nrelevant uses.\n\nWaitFor() in gtests uses the current AbstractThread for the same reason, as it\nalready does for MediaEventSource listeners.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324929\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/webaudio/AudioContext.cpp", "dom/media/webaudio/AudioContext.h", "dom/media/webrtc/transportbridge/MediaPipeline.cpp", "testing/gtest/mozilla/WaitFor.h"], "git_node": "dcd33d2d49393d3b2c378f3a12e1e8b3b088f4c5", "git_parents": ["b8e234cd7ea6064aac57fb4f64b4f7cf1d48a4b6"], "node": "1724ef05598908298c1644538505af9baf00044e", "parents": ["a74e7acf29aa7de3fb719a5e05f584ead5e7d354"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070817 - Require tail dispatch for MediaTrackGraph promises. r=karlt\n\nThe graph settles these promises on the graph thread, which is cheap only when\nthe Then callbacks are dispatched through its tail dispatcher rather than\nstraight to the main thread. That holds only when the event target supports\ntail dispatch, so require it rather than leave it to convention.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324930\n", "files": ["dom/media/MediaTrackGraph.cpp"], "git_node": "830a628e0349e7af63e9f2516f04c5c4a4431eb6", "git_parents": ["dcd33d2d49393d3b2c378f3a12e1e8b3b088f4c5"], "node": "943fbaad58a928ffbe86a40369b5ea958ee2f84e", "parents": ["1724ef05598908298c1644538505af9baf00044e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529575 - Reset a discarded tab's state in the async tab switcher. r=tabbrowser-reviewers,nsharpley\n\nA discarded tab keeps its browser element as a lazy browser, so the switcher kept the tab in STATE_LOADED. The next switch to it then finished before its layers arrived and left the blank attribute set, which is the empty tab from bug 1529575 comment 2. browser_multiselect_tabs_unload.js hits the finish and onLayersCleared assertions on every run without this.\n\nThe reset mirrors what preActions does for a removed tab and drops the tab from the layer cache, which removeTab also does by hand.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327255\n", "files": ["browser/components/tabbrowser/AsyncTabSwitcher.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tabswitch_discard.js"], "git_node": "aca34743d8449c81f16c7b37ebc916db302d6a2c", "git_parents": ["830a628e0349e7af63e9f2516f04c5c4a4431eb6"], "node": "911c4ebd9eb225dd11989ccfa29e0b5230722009", "parents": ["943fbaad58a928ffbe86a40369b5ea958ee2f84e"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071446 - Fix test failure in browser_localSearchShortcuts_xul.js caused when too many search engines are listed. r=settings-reviewers,Gijs\" for causing bc tests failures at changedEngine_xul.js\n\nThis reverts commit 2ab13412cede169981076ab0bfed4aca189d26f3.\n", "files": ["browser/components/preferences/tests/search/browser_localSearchShortcuts_xul.js"], "git_node": "11b35788925dfe8ee12f4a1bb53062c88d2bb209", "git_parents": ["aca34743d8449c81f16c7b37ebc916db302d6a2c"], "node": "6bad7e7c9b253380d7c5b06e0a249137abe1a60e", "parents": ["911c4ebd9eb225dd11989ccfa29e0b5230722009"], "tags": []}, {"author": "Artem Popov \u003cart@artfwo.net\u003e", "branch": "default", "desc": "Bug 2063725 - Stop leftover timer from aborting IP Protection activation r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326960\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs"], "git_node": "e02942770d5d6422ac1400bc52daf2a98fbedf6c", "git_parents": ["11b35788925dfe8ee12f4a1bb53062c88d2bb209"], "node": "9241f81cc508dbf267550a34ac9a072a42a9cc6f", "parents": ["6bad7e7c9b253380d7c5b06e0a249137abe1a60e"], "tags": []}, {"author": "Artem Popov \u003cart@artfwo.net\u003e", "branch": "default", "desc": "Bug 2063725 - Reject aborted IP Protection token fetches with the abort reason r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327815\n", "files": ["toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs"], "git_node": "b10c1f73a507fc9971b31e04356a82462cefee6a", "git_parents": ["e02942770d5d6422ac1400bc52daf2a98fbedf6c"], "node": "34f744793d8b82687295998764dd93b512da0bd5", "parents": ["9241f81cc508dbf267550a34ac9a072a42a9cc6f"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072278 - Count the logins the restore would have to delete. r=credential-management-reviewers,dimi\n\nA login deleted while the Rust backend was primary is gone from the Rust store\nbut still sits in the JSON store, so the revert brings it back. Before the\nrestore starts deleting anything, measure how much data that would be.\n\nThe restore now diffs the guids of both stores and reports the JSON logins Rust\nno longer has as number_of_logins_to_delete. Logins the migration failed to\ncopy land in that number too, which is exactly what the measurement needs to\ntell us apart before deletions can be carried over.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326407\n", "files": ["toolkit/components/passwordmgr/LoginStorageMigrator.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/browser/browser_login_storage_migrator.js", "toolkit/components/passwordmgr/test/unit/test_LoginStorageMigrator.js"], "git_node": "a3d5e5e30096d4ad47bdd19f31dbb0b225bd8dec", "git_parents": ["b10c1f73a507fc9971b31e04356a82462cefee6a"], "node": "ac88765add9fabc9f657353b9fde8b9428f5fb48", "parents": ["34f744793d8b82687295998764dd93b512da0bd5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2025752 - Exclude the add-shortcut tile from browser_topsites_section.js's menu test selectors, r=mconley.\n\n`TopSiteAddButton` renders its in-grid variant as `.top-site-outer.add-button-tile`\nwith no `.context-menu-button`, since \"Add shortcut\" has no context menu. These\nselectors excluded `.search-shortcut` and `.placeholder` but not that tile, so\nbefore a real top site had rendered the tile satisfied the wait above each of\nthem and the test went on to a null `.context-menu-button`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327084\n", "files": ["browser/extensions/newtab/test/browser/browser_topsites_section.js", "browser/extensions/newtab/test/browser/head.js"], "git_node": "81baafa5d451148d2e79ec658abe8e05dcdaad61", "git_parents": ["a3d5e5e30096d4ad47bdd19f31dbb0b225bd8dec"], "node": "6b9a7a91e0b29ec798c54a0df016b5da48f1a5fd", "parents": ["ac88765add9fabc9f657353b9fde8b9428f5fb48"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1960245 - Wait on the story card menu's shown event rather than polling its geometry in browser_discovery_card.js, r=mconley.\n\n`test_card_menu_item_is_clickable` waited for panel-list's `open` attribute and\nthen polled the first menu item for a non-zero box, standing in for the\nreadiness signal `open` does not give. The box turns non-zero before\n`setAlign()` has positioned the panel, so `elementFromPoint` at the item's\ncentre finds nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327085\n", "files": ["browser/extensions/newtab/test/browser/browser_discovery_card.js"], "git_node": "e50f7e4be1200ad0c0a4d8fa8d2abb67dfb2713a", "git_parents": ["81baafa5d451148d2e79ec658abe8e05dcdaad61"], "node": "f61e9ed2efa5cc5763aff674a2b4deb44b951cde", "parents": ["6b9a7a91e0b29ec798c54a0df016b5da48f1a5fd"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2064559 - Wait for the content feed's layout in browser_newtab_side_by_side_layout.js, r=mconley.\n\nEvery test waited for the content band, which renders from prefs alone, while\nthe column it measures stays display: contents until the layout has arrived\nfrom the parent process. Wait for .layout-content-column.has-feed instead.\n\ntest_side_by_side_with_no_widgets_recenters checked the panel's border colour,\nwhich is opaque currentColor when no panel is generated and transparent for a\nreal panel over a wallpaper. It checks the pseudo-element's content instead,\nwhich tells the two apart.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327097\n", "files": ["browser/extensions/newtab/test/browser/browser_newtab_side_by_side_layout.js"], "git_node": "3b6166fffa78f48a579c774764641462043d3d80", "git_parents": ["e50f7e4be1200ad0c0a4d8fa8d2abb67dfb2713a"], "node": "37fc4a72906f6f08a5e0481828582c5beaa58fd3", "parents": ["f61e9ed2efa5cc5763aff674a2b4deb44b951cde"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2011958 - Count the sponsored tiles rather than the whole row in browser_topsites_sponsored.js, r=mconley.\n\ntest_dismiss adds two sponsored top sites and then asserts that the row holds\nexactly four `li.top-site-outer` elements, and three after one sponsored tile\nis dismissed. Only two of those are the test's own; the rest of the row is\nwhatever the profile happens to hold, and the assertion has failed in both\ndirections. Count the sponsored tiles instead, which is what the test is about.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327101\n", "files": ["browser/extensions/newtab/test/browser/browser_topsites_sponsored.js"], "git_node": "991017d353d27771b1363f2d793be9d2c2daab2d", "git_parents": ["3b6166fffa78f48a579c774764641462043d3d80"], "node": "73f8a29e02d2d4aa432769088f2b13bedac4fd24", "parents": ["37fc4a72906f6f08a5e0481828582c5beaa58fd3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2073001 - Check a top site's context menu rather than a search shortcut's in browser_context_menu_item.js, r=mconley.\n\ntest_contextMenuIcons means to inspect a top site's context menu, but its\nselector matched the list rather than the tiles inside it, so it has only ever\nopened the menu of the search shortcut that was the row's first tile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327104\n", "files": ["browser/extensions/newtab/test/browser/browser_context_menu_item.js", "browser/extensions/newtab/test/browser/head.js"], "git_node": "9775174e1697884e47dfcb0893d5de7f3f29f61e", "git_parents": ["991017d353d27771b1363f2d793be9d2c2daab2d"], "node": "3deae2694c526b8debc0b490c12662581af6dcf4", "parents": ["73f8a29e02d2d4aa432769088f2b13bedac4fd24"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1958336 - Click the example.com top site by URL in browser_newtab_towindow.js, r=mconley.\n\nThe test waited for and clicked the first `.top-sites a`, which is not\nnecessarily the example.com tile setTestTopSites configures. A search shortcut\npinned by an earlier test in the job stays in browser.newtabpage.pinned, and\nclicking one sends FILL_SEARCH_TERM rather than OPEN_LINK, so no tab ever opens\nand waitForNewTab waits until the harness kills the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327107\n", "files": ["browser/extensions/newtab/test/browser/browser_newtab_towindow.js", "browser/extensions/newtab/test/browser/head.js"], "git_node": "9c286b69aaea789f3b584973ee5194c2a3fbc498", "git_parents": ["9775174e1697884e47dfcb0893d5de7f3f29f61e"], "node": "4c947ab642fe1b05794511f6b8a3a21b6cde898f", "parents": ["3deae2694c526b8debc0b490c12662581af6dcf4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2031620 - Click the top site browser_open_tab_focus.js set up, r=mconley.\n\nThe test waited for the first .top-site-button tile and clicked it. That also\nmatches a pinned search shortcut, which has no href, so the click filled the\naddress bar instead of opening a tab and removeTab(gBrowser.tabs[2]) threw.\nMatching on the URL also asserts the tab opens at the site the test set up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327108\n", "files": ["browser/extensions/newtab/test/browser/browser_open_tab_focus.js"], "git_node": "491dabd690eacf1e28415d87989917bf8410ff94", "git_parents": ["9c286b69aaea789f3b584973ee5194c2a3fbc498"], "node": "fec87577db9263e71fe14c3e2b6eeb9375f0654e", "parents": ["4c947ab642fe1b05794511f6b8a3a21b6cde898f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2031620 - Let browser_open_tab_focus.js run on Linux, r=mconley.\n\nThe annotation was never about this test: bug 1667645 inserted the manifest\nentry immediately above the linux skip-if belonging to\nbrowser_newtab_overrides.js, and bug 1917073 converted the inherited line\nmechanically. accelKey is the portable spelling and head.js has no platform\nbranch, so there is no mac/win-only setup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327109\n", "files": ["browser/extensions/newtab/test/browser/browser.toml"], "git_node": "6bec4a842cb8e0373130c7d3ec9c0d871aefa968", "git_parents": ["491dabd690eacf1e28415d87989917bf8410ff94"], "node": "b4b982ac3ac070f71e5a7180e4c3d7a0480bfa9f", "parents": ["fec87577db9263e71fe14c3e2b6eeb9375f0654e"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2073167 - re-enable tests disable on macOS AArch64. r=rcurran,devtools-reviewers,nchevobbe\n\nThe tests had been disabled initially when macOS AArch64 had been\nadded as testing platform for them, see bug 2019466.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327793\n", "files": ["browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-zoom/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/urlbar/tests/browser/browser.toml", "devtools/client/aboutdebugging/test/browser/browser.toml", "dom/events/test/mochitest.toml", "dom/tests/browser/browser.toml"], "git_node": "36791814a9f23de8c19254d8a7ff73a60517ab7c", "git_parents": ["6bec4a842cb8e0373130c7d3ec9c0d871aefa968"], "node": "c1dfbb245e7ec8e3785a5e1f68e831aebd863a9a", "parents": ["b4b982ac3ac070f71e5a7180e4c3d7a0480bfa9f"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074096 - Remove no-longer-needed OTS patch (merged upstream). r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327807\n", "files": ["gfx/ots/moz.yaml", "gfx/ots/ots-variation-overflow.patch"], "git_node": "7ebae00358c2be73e81f8aee332f945a8a5ea89a", "git_parents": ["36791814a9f23de8c19254d8a7ff73a60517ab7c"], "node": "acdbc7dd33d8608b26c7d96d1d2226efc381312e", "parents": ["c1dfbb245e7ec8e3785a5e1f68e831aebd863a9a"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074096 - Vendor latest OTS code (6263433) from upstream. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327809\n", "files": ["gfx/ots/include/opentype-sanitiser.h", "gfx/ots/moz.yaml", "gfx/ots/src/cff.cc", "gfx/ots/src/cff_charstring.cc", "gfx/ots/src/cff_charstring.h", "gfx/ots/src/glat.cc", "gfx/ots/src/gpos.cc", "gfx/ots/src/gsub.cc", "gfx/ots/src/layout.cc", "gfx/ots/src/metrics.cc", "gfx/ots/src/ots.cc", "gfx/ots/src/silf.cc", "gfx/ots/tests/passthru_test.cc"], "git_node": "2387522b50c5fc4a2a57c5cfb91eae2c5eb26207", "git_parents": ["7ebae00358c2be73e81f8aee332f945a8a5ea89a"], "node": "d4656c2989af361ac5e61b4646524ebb48bfbecc", "parents": ["acdbc7dd33d8608b26c7d96d1d2226efc381312e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074096 - Re-apply local OTS patches. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327810\n", "files": ["gfx/ots/include/opentype-sanitiser.h", "gfx/ots/src/cff_charstring.cc", "gfx/ots/src/cff_charstring.h", "gfx/ots/src/glat.cc", "gfx/ots/src/ots.cc", "gfx/ots/src/silf.cc"], "git_node": "1e538c4c0315544e7f26df939b689e5746d09c18", "git_parents": ["2387522b50c5fc4a2a57c5cfb91eae2c5eb26207"], "node": "57e1a172103a36172c6105f1900335926bc4c4f0", "parents": ["d4656c2989af361ac5e61b4646524ebb48bfbecc"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058417 - Testcase. r=edgar\" for causing mochistest plain failures at internal_types.html\n\nThis reverts commit b1fbee40ce3722b8aea575d22dcef35998ed62f0.\n", "files": ["dom/events/test/mochitest.toml", "dom/events/test/test_datatransfer_internal_types.html"], "git_node": "aa60e6cebcadc4e38460a5a41d5a0aef21e1d096", "git_parents": ["1e538c4c0315544e7f26df939b689e5746d09c18"], "node": "737e4f0600cc5b2ad35c4fded9ed9216bc8871db", "parents": ["57e1a172103a36172c6105f1900335926bc4c4f0"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063562 - Don't count a restoring or loading about:blank tab as a duplicate. r=tabbrowser-reviewers,jswinarton\" for causing bc tests failures at contextMenu.js\n\nThis reverts commit 60785570e486efb06d333f0974a1a57e035004ae.\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_close_duplicate_tabs.js"], "git_node": "255d69848f2c81a911b3ef62b36a80420d299a93", "git_parents": ["aa60e6cebcadc4e38460a5a41d5a0aef21e1d096"], "node": "3ec0e8db4ab0eaccd7dd028198b09083fa28ea2a", "parents": ["737e4f0600cc5b2ad35c4fded9ed9216bc8871db"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2063025 - Fetch search-telemetry-v2 from Remote Settings instead of an in-tree asset r=android-reviewers,geckoview-reviewers,frontend-codestyle-reviewers,mossop,Standard8,jdelorenzo,tcampbell\n\nsearch-telemetry-v2 is in the packaged_collections! list of the\napplication-services remote_settings crate, so RemoteSettingsClient::get_records\nalready serves the dump bundled with the megazord and prefers it over a stale\ncache. Android was shipping a second, hand-maintained copy of the collection as\nan asset, refreshed from the desktop dump at every beta cut.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318859\n", "files": [".prettierignore", "mobile/android/android-components/components/feature/search/build.gradle", "mobile/android/android-components/components/feature/search/src/main/assets/search/search_telemetry_v2.json", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/telemetry/SerpTelemetryRepository.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/telemetry/BaseSearchTelemetryTest.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/telemetry/SerpTelemetryRepositoryTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/beta-cut.py", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/docs/release-checklist.md", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/telemetry/GleanMetricsService.kt", "tools/rewriting/Generated.txt"], "git_node": "1f7ac5e20d98fb1f719efb58020edc15412500b2", "git_parents": ["255d69848f2c81a911b3ef62b36a80420d299a93"], "node": "7cf22955bf3e04600e85da78b83adda6d4f3d73f", "parents": ["3ec0e8db4ab0eaccd7dd028198b09083fa28ea2a"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044525 - Part 1: Set policy site list permissions on both trailing dot host forms. r=jmendez\n\nA host and its trailing dot form are distinct permission origins. An\nadministrator lists one form, so the policy sets the permission for both.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325956\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_permissions.js", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs"], "git_node": "6460ae1898722a5c07578abec5ae15a440d22201", "git_parents": ["1f7ac5e20d98fb1f719efb58020edc15412500b2"], "node": "79ed031a95c06685cc6f0331880d64156a1b07a0", "parents": ["7cf22955bf3e04600e85da78b83adda6d4f3d73f"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044525 - Part 2: List a site once in the permission exceptions dialogs. r=settings-reviewers,Gijs\n\nPart 1 sets a policy permission for both trailing dot forms of a host, which\nare distinct permission origins. The dialogs list the site once, and still\nlist a trailing dot host that has a permission of its own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325957\n", "files": ["browser/components/preferences/dialogs/permissions.js", "browser/components/preferences/dialogs/sitePermissions.js"], "git_node": "832fe83533d9588cb55cb2c448be76e4c7ec8dbe", "git_parents": ["6460ae1898722a5c07578abec5ae15a440d22201"], "node": "c904040dd4dcf58623fb888c1b2c890d5d6e607f", "parents": ["79ed031a95c06685cc6f0331880d64156a1b07a0"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044525 - Part 3: Test that the site permissions dialog lists a policy site once. r=firefox-desktop-core-reviewers ,settings-reviewers,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326225\n", "files": ["browser/components/preferences/tests/permissions/browser-srd.toml", "browser/components/preferences/tests/permissions/browser_permissions_policy_trailing_dot.js"], "git_node": "26b4dc02ee51c08cf85873fc8522bd3b970022dd", "git_parents": ["832fe83533d9588cb55cb2c448be76e4c7ec8dbe"], "node": "dbedc6243b6a007ecb96d8fb9c87f0fdf2e90131", "parents": ["c904040dd4dcf58623fb888c1b2c890d5d6e607f"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073058 - Lint all docshell headers through clang-tidy r=emilio\n\nChanges includes:\n- making deleted methods public\n- use std::forward instead of std::move to prevent lifetime issues\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326942\n", "files": ["docshell/base/BrowsingContext.h", "docshell/base/SyncedContext.h", "docshell/base/nsPingListener.h", "docshell/shistory/nsSHEntryShared.h"], "git_node": "4d74a390ba6b3447b615798f8fdc39f0e2300dd2", "git_parents": ["26b4dc02ee51c08cf85873fc8522bd3b970022dd"], "node": "40e330d9975e223ae4bf440ce7122987c87ab64c", "parents": ["dbedc6243b6a007ecb96d8fb9c87f0fdf2e90131"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073234 - Remove the exception message from JavaException annotations in crash pings r=crashreporting-reviewers,gsvelto\n\nTo be honest, this feels a bit wrong (I'd prefer any annotations we send\nin a ping to be identical to their counterparts in a report), but we can\nrevisit that later (it would either involve splitting the annotation or\nmaking another which is almost the same, but without the exception\nmessages).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327154\n", "files": ["mobile/android/android-components/components/lib/crash/src/androidTest/java/mozilla/components/lib/crash/service/GleanCrashReporterServiceTest.kt", "toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/conversions.py", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/src/annotations.rs", "toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "c985e485d223d223d52604f889f0ad6c35a55aa0", "git_parents": ["4d74a390ba6b3447b615798f8fdc39f0e2300dd2"], "node": "f56e7e58b60c5c5be1f7eacf4df36954342b0533", "parents": ["40e330d9975e223ae4bf440ce7122987c87ab64c"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2061784 r=device-api-reviewers,gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323348\n", "files": ["dom/webserial/Win32SerialOverlappedIO.cpp", "dom/webserial/Win32SerialOverlappedIO.h", "dom/webserial/Win32SerialParityCheckStream.cpp", "dom/webserial/Win32SerialParityCheckStream.h", "dom/webserial/Win32SerialPlatformService.cpp", "dom/webserial/moz.build"], "git_node": "ddfefa260bf01c343eee51b952e18b72889d8d89", "git_parents": ["c985e485d223d223d52604f889f0ad6c35a55aa0"], "node": "a778178235531b99c047bada011d8bd1e6718074", "parents": ["f56e7e58b60c5c5be1f7eacf4df36954342b0533"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073669 - Let startGeolocationOnBackground use the default harness timeout. r=geckoview-reviewers,ohall\n\nThe 6000 ms override also caps the initial page load, which takes longer than that on debug emulators, so the\ntest times out in waitForPageStop before the geolocation part starts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327488\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeolocationTest.kt"], "git_node": "f171655bfb102064a302b7e030fafd0dc5e9ede5", "git_parents": ["ddfefa260bf01c343eee51b952e18b72889d8d89"], "node": "6ab6f9b7dc4af65b82beb2692a427fcfa6ecb587", "parents": ["a778178235531b99c047bada011d8bd1e6718074"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051635 - Play a looping media element in audioSessionTypeMediaElementIsPlayback. r=geckoview-reviewers,ohall\n\nThe test loads media_session_default1.html, whose owl.mp3 clip lasts 3.3 seconds. When the parent main thread\nis busy for longer than that (debug builds), the child's play, audible, inaudible and pause notifications\narrive in one burst: the effective audio-session type flips auto to playback and back to auto within a few\nmilliseconds, and GeckoViewMediaControl reads the controller's current type when it handles the queued\neffectiveaudiosessiontypechange events, so the delegate only ever hears \"auto\". Give the test its own page\nwith a looping element, like the Web Audio and Web Speech pages, so the type stays \"playback\" until the test\nends.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327489\n", "files": ["mobile/android/geckoview/src/androidTest/assets/www/audio_session_type_playback.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/MediaSessionTest.kt"], "git_node": "ae8ea126023962945169e737c11913487c0e33b8", "git_parents": ["f171655bfb102064a302b7e030fafd0dc5e9ede5"], "node": "cec88654ee9e5ffc59a52dfde0654bbd12adbcbc", "parents": ["6ab6f9b7dc4af65b82beb2692a427fcfa6ecb587"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058553 - Keep the pending prompt response reachable in the autocomplete selection tests. r=geckoview-reviewers,ohall\n\nThe delegates return a fresh GeckoResult they never complete or reference, so the JVM can collect it together\nwith the EventCallback that would answer Gecko. The callback's finalizer rejects the pending GeckoView:Prompt\nrequest, GeckoViewPrompter treats that as a dismissal and GeckoViewAutocomplete drops the prompt, which either\nopens a second prompt on the next field or leaves the final blur with nothing to dismiss. Hold the result in a\nfield for the test's lifetime instead. The field is initialized on the instrumentation thread, which has no\nLooper, so the result needs the main Looper's Handler explicitly or then() throws \"Must have a Handler\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327714\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AutocompleteTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PromptDelegateTest.kt"], "git_node": "d18497615a4f59af2b6397fc8c3cd13ebdc48b2d", "git_parents": ["ae8ea126023962945169e737c11913487c0e33b8"], "node": "df2d2afedef81a992255af55a7480ce1d227cf84", "parents": ["cec88654ee9e5ffc59a52dfde0654bbd12adbcbc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902103 - Request positions in GeolocationTest with the harness default timeout. r=geckoview-reviewers,ohall\n\ngetCurrentPosition() was given a 3 s timeout, but on debug and coverage emulators the first fix from the mock\nprovider can take longer than that once the permission is granted, so the request rejects with TIMEOUT (code\n3) in jsContentRequestForLocation and accurateProviderSelected (bug 1789286). The timeout only bounds how long\nthe request waits for a fix and never decides which fix is returned, so every request can use the harness\ndefault.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327715\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeolocationTest.kt"], "git_node": "b31f0b2ede6bd61a756d9f6521c93afdf44301e2", "git_parents": ["d18497615a4f59af2b6397fc8c3cd13ebdc48b2d"], "node": "32d253c9787aae132bdc406349b71c1d1162ac1b", "parents": ["df2d2afedef81a992255af55a7480ce1d227cf84"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073436 - Keep the Firefox logo clear of the New Tab search bar in HNT Search Logos Experiment Variant B. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327338\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/Logo/_Logo.scss", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx"], "git_node": "e8c7ae80a499ba04f2ce3cb9dbec2d4ceb242d88", "git_parents": ["b31f0b2ede6bd61a756d9f6521c93afdf44301e2"], "node": "2983af376056b9c447e92cced52e341ba4c94562", "parents": ["32d253c9787aae132bdc406349b71c1d1162ac1b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072670 - Draw the HNT Search Logos Experiment Variant B card from the New Tab page, anchored to the search bar. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327339\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/Logo/_Logo.scss", "browser/extensions/newtab/content-src/components/Search/_Search.scss", "browser/extensions/newtab/content-src/styles/_variables.scss", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/themes/shared/urlbar.css"], "git_node": "5ffb581a0b3a5790630eab0e6ac7a2bd1a53a803", "git_parents": ["e8c7ae80a499ba04f2ce3cb9dbec2d4ceb242d88"], "node": "38474040b71fc49b7a55b7302ae71f81bf9b7d1d", "parents": ["2983af376056b9c447e92cced52e341ba4c94562"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2073031 - Record the try push base revision so the decision task can diff against it r=taskgraph-reviewers,ahal\n\nGithub reports a null `before` revision for a push that creates a branch, which\nis what every `mach try` push to a Git try repository does. `GitRepository.\nget_changed_files` turns that into a diff from the empty tree, so `files_changed`\nlists the whole repository and every `skip-unless-changed` optimization matches.\nTasks that are `always-target`, such as the ones in the `bootstrap` kind, are\nthen scheduled on every try push.\n\nRecord the real base in the `try_task_config.json` parameters at push time, and\nderive `files_changed` only once the parameter overrides have been applied, so\nthe recorded base is the one used. Decision tasks check out shallow and don't\nhave that commit, so fetch it first; if it can't be fetched, fall back to the\nprevious whole-tree behaviour rather than failing the decision task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327277\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_decision.py", "tools/tryselect/push.py", "tools/tryselect/test/conftest.py", "tools/tryselect/test/test_push.py"], "git_node": "b0e9a082fd28329f52f2a2dc48adb339d56f6463", "git_parents": ["5ffb581a0b3a5790630eab0e6ac7a2bd1a53a803"], "node": "0231825b71f27ea6db02f67b99064d18536ed5da", "parents": ["38474040b71fc49b7a55b7302ae71f81bf9b7d1d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064144 - Stop pre-initializing dynamic slots in concurrent marking builds r=jandem\n\nThis removes the initialization of dynamic slots up to the allocation capacity.\nThis was causing performance regressions in concurrent marking builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327361\n", "files": ["js/src/gc/Marking.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/vm/JSObject.cpp", "js/src/vm/NativeObject.cpp", "js/src/vm/NativeObject.h"], "git_node": "6a31a4ee82ea9295357ca4ecb98d09ef67b43847", "git_parents": ["b0e9a082fd28329f52f2a2dc48adb339d56f6463"], "node": "71717b57eb468fb292c9d4263a9d6cd45c762e6e", "parents": ["0231825b71f27ea6db02f67b99064d18536ed5da"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073396 - Prevent potential data race in font instantiation. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327838\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxMacFont.cpp"], "git_node": "32f24ec9093012f50168f738823f346086a9f96c", "git_parents": ["6a31a4ee82ea9295357ca4ecb98d09ef67b43847"], "node": "2fdcdb405d7de23f2ae026b161eab8ec2d28e30c", "parents": ["71717b57eb468fb292c9d4263a9d6cd45c762e6e"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073627 - Lint all uriloader/ headers through clang-tidy r=emilio\n\nOnly some include rework, nothing else detected by clang-tidy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327467\n", "files": ["uriloader/exthandler/mac/nsOSHelperAppService.mm"], "git_node": "a2efb58f8b4c6abdc901308d98c65ac58364bb1f", "git_parents": ["32f24ec9093012f50168f738823f346086a9f96c"], "node": "43120929c14d075eb33c0163bb158ddf10fe8887", "parents": ["2fdcdb405d7de23f2ae026b161eab8ec2d28e30c"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073030 - Lint all storage/ headers through clang-tidy r=emilio\n\nVery few changes for that subpart, only a conversion from zero to\nnullptr.\n\nAs detected and auto-fixed by clang-tidy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327462\n", "files": ["storage/SQLiteMutex.h"], "git_node": "8053e1caf2908cdecb857ca7ac7e36a276b3d0a8", "git_parents": ["a2efb58f8b4c6abdc901308d98c65ac58364bb1f"], "node": "c4ff8a3782fa1625ac92c99902dd8fe13fd0d9db", "parents": ["43120929c14d075eb33c0163bb158d