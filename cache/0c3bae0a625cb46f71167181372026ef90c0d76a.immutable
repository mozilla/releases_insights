ml", "toolkit/components/antitracking/test/browser/trackingAPI.js", "toolkit/components/pdfjs/moz.yaml", "tools/lint/rejected-words.yml", "tools/tryselect/try_presets.yml"], "git_node": "c9739388e01bde6eabf30f0d82282fa6c648bdf1", "git_parents": ["c747abc7ec3402d0732a02b5c8b7259e62443abc"], "node": "290413c21aa12824de1c60e65e42dc0aea2effdf", "parents": ["073366b8b7fe8f9db7e4b2d393fe9201cc2a7f6f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2015990 - Explicitly size empty animation summary graph path. r=devtools-reviewers,nchevobbe\n\nWith the other patch in this bug, this empty svg gets a min-content\nwidth of 300px, which matches other browsers, but that would cause the\ngrid to grow, and thus change the tick mark count that we end up with.\n\nThat caused the previous patch to get backed out. Instead, explicitly\nsize the empty SVG so it takes no extra space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327290\n", "files": ["devtools/client/inspector/animation/components/graph/SummaryGraphPath.js"], "git_node": "1fa361c242789664840ce34da4700b6fb793671a", "git_parents": ["c9739388e01bde6eabf30f0d82282fa6c648bdf1"], "node": "ef73d8900f765c23d21f7753f3ba930118b9307e", "parents": ["290413c21aa12824de1c60e65e42dc0aea2effdf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2015990 - Make SVG intrinsic sizing a bit more sensible. r=layout-reviewers,firefox-svg-reviewers,dholbert\n\nmax-content and min-content should match except maybe on the weird case\nwhere we return the fallback intrinsic size... But other browsers do\nmatch that, so let's do it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326903\n", "files": ["layout/generic/AspectRatio.h", "layout/svg/SVGOuterSVGFrame.cpp", "testing/web-platform/tests/css/css-sizing/svg-intrinsic-size-009.html", "testing/web-platform/tests/css/css-sizing/svg-intrinsic-size-010.html"], "git_node": "bc0b360f9646953ba6fb917e56d72169651dd89c", "git_parents": ["1fa361c242789664840ce34da4700b6fb793671a"], "node": "42b5e2d1aa86c64c14fd1c0cc76b8b90eda6b246", "parents": ["ef73d8900f765c23d21f7753f3ba930118b9307e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2073182 - Set dom.fetch.streaming_upload:true for service worker WPTs r=necko-reviewers,sunil\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327261\n", "files": ["testing/web-platform/meta/service-workers/service-worker/__dir__.ini"], "git_node": "6cd02b39530a1bbeeda544dd607522977988284e", "git_parents": ["bc0b360f9646953ba6fb917e56d72169651dd89c"], "node": "0f19c7dbf4a46d8133070fd5e64a9d9f0e83f3ae", "parents": ["42b5e2d1aa86c64c14fd1c0cc76b8b90eda6b246"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2073168 - Set dom.fetch.streaming_upload for beacon WPT r=necko-reviewers,sunil\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327262\n", "files": ["testing/web-platform/meta/beacon/beacon-basic.https.window.js.ini"], "git_node": "20bf449e31f8aa6c8d23a4e441b8e3a0f52d3726", "git_parents": ["6cd02b39530a1bbeeda544dd607522977988284e"], "node": "1935dab94dfa55c5a87ff77944f57c96ff0094a7", "parents": ["0f19c7dbf4a46d8133070fd5e64a9d9f0e83f3ae"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2073407 - Add streaming upload to feature manifest r=necko-reviewers,sunil\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327263\n", "files": ["toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "61ca6f67855661d14fec53a5f5a407d496dd59dd", "git_parents": ["20bf449e31f8aa6c8d23a4e441b8e3a0f52d3726"], "node": "47863771990c2654de3c17ffbe43277973fe264e", "parents": ["1935dab94dfa55c5a87ff77944f57c96ff0094a7"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2047496 - Make mozilla::Maybe\u003cT\u003e formattable. r=sergesanspaille\n\nAdds a fmt::formatter specialization for mozilla::Maybe\u003cT\u003e, enabled when T\nis itself formattable. Nothing formats as \"\u003cNothing\u003e\"; Some(t) formats as t.\n\nUsing fmt::ostream_formatter (the simpler approach) would delegate to\noperator\u003c\u003c, which has different semantics from fmt for primitive types: bool\nformats as \"1\" instead of \"true\", and floats use 6-decimal precision instead\nof shortest round-trip. A full specialization forwarding parse() and format()\nto fmt::formatter\u003cT\u003e is needed for correct output.\n\nfmt/base.h is included after the mozilla headers because it uses MFBT_API,\nwhich requires mozilla/Types.h to be included first.\n\nBased on an initial patch by Masayuki Nakano.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306783\n", "files": ["mfbt/MaybeFmt.h", "mfbt/api.yml", "mfbt/moz.build", "mfbt/tests/gtest/TestFormattingAndStreaming.cpp", "mfbt/tests/gtest/moz.build"], "git_node": "9d4c9ce52a67d9d8603712acfc2701d1a3c29fc5", "git_parents": ["61ca6f67855661d14fec53a5f5a407d496dd59dd"], "node": "1d12387a7b2d327b08da4a8f3c7c882236578c26", "parents": ["47863771990c2654de3c17ffbe43277973fe264e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072669 - Implement HNT Search Logos Experiment Variant A. r=daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326965\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarNewTabComponentRegistrant.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/bro