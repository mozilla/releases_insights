ebrender/src/scene_building.rs"], "git_node": "b1022dc0f55a1b2a25ba7d8d216d27a48714db4d", "git_parents": ["c17facc81b75ee75ca7d86021eef625de3403ab8"], "node": "18730a2d9d610675e193065aef918d084ff67c9b", "parents": ["19b395b4701c3099d55bc83e93e531504493b501"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Dont't snap anti-aliased primitives. r=gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310363\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/space.rs", "testing/web-platform/meta/css/css-images/object-position-svg-001e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-001o.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002o.html.ini", "testing/web-platform/meta/svg/painting/inline-svg-resize-viewport-dependent-mask.html.ini", "testing/web-platform/meta/svg/painting/inner-outer-svg-overflow-auto.html.ini"], "git_node": "657ba97309b215a3ead6526605c2642167ff6a9e", "git_parents": ["b1022dc0f55a1b2a25ba7d8d216d27a48714db4d"], "node": "0ec425cc4b4b444bc5e825d3dbc74008186eb542", "parents": ["18730a2d9d610675e193065aef918d084ff67c9b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Add a wrench test. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310362\n", "files": ["gfx/wr/wrench/reftests/snap/antialiased-ref.png", "gfx/wr/wrench/reftests/snap/antialiased.yaml", "gfx/wr/wrench/reftests/snap/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "04303baa631a3f824eb122bac7c95c0a33c67a7c", "git_parents": ["657ba97309b215a3ead6526605c2642167ff6a9e"], "node": "af8cf2e5947969fd6855f0672a342afa61f788fc", "parents": ["0ec425cc4b4b444bc5e825d3dbc74008186eb542"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Quantize reference frame origins in device space, not local space. r=gw\n\nThe 1/128 px quantization of reference frame origins (added to keep float\nnoise from the external scroll offset round-trip off the device-pixel snap\ntie) was applied to origin_in_parent_reference_frame at scene build time, in\nthe parent frame's local units. Under a scaled ancestor those units are not\ndevice pixels: SVG content sits under the outer \u003csvg\u003e's viewBox transform,\nso a rect with a CSS transform gets a nested reference frame whose origin\nis quantized to 1/128 of a user unit, i.e. scale/128 device pixels. With\nanti-aliased primitives no longer snapped, that error becomes visible.\n\nMove the quantization to the places where a device-space offset is about to\nbe rounded to a device pixel: snap_offset(), and the should_snap round of\nthe accumulated ScaleOffset in update_transform(). That keeps the snap-tie\nprotection while leaving unsnapped content at its exact position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326214\n", "files": ["gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled-ref.yaml", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled.yaml", "gfx/wr/wrench/reftests/snap/reftest.list"], "git_node": "f2b230ac43905ea8bd4018ab93873b55f0253316", "git_parents": ["04303baa631a3f824eb122bac7c95c0a33c67a7c"], "node": "8c40a7c9f5cf943222db33d7a89aa09ea64a097b", "parents": ["af8cf2e5947969fd6855f0672a342afa61f788fc"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Honour shape-rendering: crispEdges for WebRender SVG rects. r=firefox-svg-reviewers,longsonr\n\nwhen crispEdges is used the primitive should not be anti-aliased.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326215\n", "files": ["layout/svg/SVGGeometryFrame.cpp"], "git_node": "3151415a427681ca5a824675de6c6b75656a13a0", "git_parents": ["f2b230ac43905ea8bd4018ab93873b55f0253316"], "node": "9042b8748aa25f346b52c51b2ceb2b7a49efaf97", "parents": ["8c40a7c9f5cf943222db33d7a89aa09ea64a097b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2050211: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["layout/svg/SVGGeometryFrame.cpp"], "git_node": "7473834b83efa1e64fae9faaaa1d5d284f42af24", "git_parents": ["3151415a427681ca5a824675de6c6b75656a13a0"], "node": "5daf344e3f286fd8fe6a8a3736826874c38cce78", "parents": ["9042b8748aa25f346b52c51b2ceb2b7a49efaf97"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2023566 - Cull snapshot pictures against their snapshot area. r=gfx-reviewers,lsalzman\n\nA detached snapshot is only read through its texture, so it contributes to its\narea rather than to the screen. Culling rects are initialised from the screen,\nand a transformed clip rejects primitives whose raster rect does not intersect\nthat rect, so content inside the snapshot area but off-screen was dropped from\nthe snapshot. This happens for an element far to the right under a perspective\nand a translateZ, such as an iframe snapshot during a view transition.\n\nCull against the projected snapshot area instead, and union it with the screen\nfor a composited snapshot. Clipping the surface's local rect to the area still\nlimits the allocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328060\n", "files": ["gfx/wr/webrender/src/visibility.rs", "gfx/wr/wrench/reftests/image/reftest.list", "gfx/wr/wrench/reftests/image/snapshot-offscreen-03-ref.yaml", "gfx/wr/wrench/reftests/image/snapshot-offscreen-03.yaml"], "git_node": "23c2b35459ae6a8d4daa1a79eea13d114829632e", "git_parents": ["7473834b83efa1e64fae9faaaa1d5d284f42af24"], "node": "e630ec41ba80356a9251ee62c8bba385b927482a", "parents": ["5daf344e3f286fd8fe6a8a3736826874c38cce78"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073666 - Report DNS stale-cache status per delivered answer instead of via the shared record r=necko-reviewers,sunil\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327824\n", "files": ["netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsHostRecord.cpp", "netwerk/dns/nsHostRecord.h", "netwerk/dns/nsHostResolver.cpp", "netwerk/dns/nsHostResolver.h", "netwerk/test/gtest/TestDNS.cpp"], "git_node": "d2352a107572d0317ee7f1dd52bcd1f5eb41f148", "git_parents": ["23c2b35459ae6a8d4daa1a79eea13d114829632e"], "node": "4a7a5a38554710a7f9fdf29d7d74062df1cec029", "parents": ["e630ec41ba80356a9251ee62c8bba385b927482a"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074097 - Prefetch AF_UNSPEC when Happy Eyeballs is disabled so the connection reuses it r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327845\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_dns_prefetch_family.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "16c8ee6d1598b12689ceecd81b69e324f66810c6", "git_parents": ["d2352a107572d0317ee7f1dd52bcd1f5eb41f148"], "node": "fa2beb607daaa19f73250a469324ad5debc5d5b6", "parents": ["4a7a5a38554710a7f9fdf29d7d74062df1cec029"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066123 - Document the events and notifications Session Restore broadcasts. r=sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322891\n", "files": ["browser/components/sessionstore/docs/events.md", "browser/components/sessionstore/docs/index.md"], "git_node": "ac34f020055c36f9e81af038536f5fc6b9f53932", "git_parents": ["16c8ee6d1598b12689ceecd81b69e324f66810c6"], "node": "8b8491f06f32f455e6f0fdc74bab32f4ada49e9c", "parents": ["fa2beb607daaa19f73250a469324ad5debc5d5b6"], "tags": []}, {"author": "f3tch \u003cftech169@gmail.com\u003e", "branch": "default", "desc": "Bug 2070577 - Allow permissions.setPermission and WebDriver:SetPermission to set camera and microphone permissions. r=Sasha,webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327436\n", "files": ["remote/shared/Permissions.sys.mjs"], "git_node": "e8b9b546706bfd00a881d76f3ee9c8fa481caed0", "git_parents": ["ac34f020055c36f9e81af038536f5fc6b9f53932"], "node": "dffd93685a1efd44a8f69bc59d17ad72bfed8be9", "parents": ["8b8491f06f32f455e6f0fdc74bab32f4ada49e9c"], "tags": []}, {"author": "f3tch \u003cftech169@gmail.com\u003e", "branch": "default", "desc": "Bug 2070577 - [wdspec] Add tests for camera and microphone permissions. r=Sasha,webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327848\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/external/permissions/set_permission/set_permission.py"], "git_node": "03bcfb78e7cf140f3b6f4cc2400298518472d482", "git_parents": ["e8b9b546706bfd00a881d76f3ee9c8fa481caed0"], "node": "f45a7b12411f943d3e6ca2b113c23b54f8fe1dcd", "parents": ["dffd93685a1efd44a8f69bc59d17ad72bfed8be9"], "tags": []}, {"author": "Holger Benl \u003chbenl@evandor.de\u003e", "branch": "default", "desc": "Bug 1966217 - [webdriver-bidi] Support the \"input.performActions\" and \"input.releaseActions\" commands in privileged scopes. r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325010\n", "files": ["remote/webdriver-bidi/modules/root/input.sys.mjs", "testing/web-platform/mozilla/tests/webdriver/bidi/input/perform_actions/privileged.py", "testing/web-platform/mozilla/tests/webdriver/bidi/input/release_actions/privileged.py"], "git_node": "02041e2fc894995118df289068e22d27c0b52890", "git_parents": ["03bcfb78e7cf140f3b6f4cc2400298518472d482"], "node": "7058e66e98ed2774bf9870c8eff9157feda6e665", "parents": ["f45a7b12411f943d3e6ca2b113c23b54f8fe1dcd"], "tags": []}, {"author": "Holger Benl \u003chbenl@evandor.de\u003e", "branch": "default", "desc": "Bug 2007067 - [webdriver-bidi] Support the \"browsingContext.locateNodes\" command in privileged scopes. r=whimboo,webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325046\n", "files": ["remote/webdriver-bidi/modules/root/browsingContext.sys.mjs", "testing/web-platform/mozilla/tests/webdriver/bidi/browsing_context/locate_nodes/privileged.py"], "git_node": "3dc3a69e65be64a0a849bbf23f9755dc89313670", "git_parents": ["02041e2fc894995118df289068e22d27c0b52890"], "node": "24efea81744f75564f1c935cc5933edb11479fb0", "parents": ["7058e66e98ed2774bf9870c8eff9157feda6e665"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/events headers through clang-tidy r=dom-core-reviewers,smaug\n\nThe only change here is the addition of a header to cope with dependency\nchange introduce in #2034839\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327944\n", "files": ["dom/events/UIEvent.cpp"], "git_node": "f5b7d712b0ddc4f20213f72c9bb2d1aaa2b8940a", "git_parents": ["3dc3a69e65be64a0a849bbf23f9755dc89313670"], "node": "e426700fb06a944ed1734bf07ea3c2f6b776ee09", "parents": ["24efea81744f75564f1c935cc5933edb11479fb0"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/{fs,html,quota,serializers} headers through clang-tidy r=dom-core-reviewers,smaug\n\nThe only change here is the addition of a header to cope with dependency\nchange introduce in #2074284\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327946\n", "files": ["dom/fs/child/FileSystemShutdownBlocker.cpp", "dom/html/HTMLFormSubmission.cpp", "dom/quota/ClientUsageArray.cpp", "dom/serializers/nsPlainTextSerializer.cpp"], "git_node": "35a3165eba5a73dcd220a9236c0e73fcb7c05d28", "git_parents": ["f5b7d712b0ddc4f20213f72c9bb2d1aaa2b8940a"], "node": "5902b351980121c0c7c22f2280a25ada9e2dc2f3", "parents": ["e426700fb06a944ed1734bf07ea3c2f6b776ee09"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050211: apply code formatting via Lando\" for causing failures at svg-no-natural-size-grandchild.html.\n\nThis reverts commit 7473834b83efa1e64fae9faaaa1d5d284f42af24.\n\nRevert \"Bug 2050211 - Honour shape-rendering: crispEdges for WebRender SVG rects. r=firefox-svg-reviewers,longsonr\"\n\nThis reverts commit 3151415a427681ca5a824675de6c6b75656a13a0.\n\nRevert \"Bug 2050211 - Quantize reference frame origins in device space, not local space. r=gw\"\n\nThis reverts commit f2b230ac43905ea8bd4018ab93873b55f0253316.\n\nRevert \"Bug 2050211 - Add a wrench test. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit 04303baa631a3f824eb122bac7c95c0a33c67a7c.\n\nRevert \"Bug 2050211 - Dont't snap anti-aliased primitives. r=gw\"\n\nThis reverts commit 657ba97309b215a3ead6526605c2642167ff6a9e.\n\nRevert \"Bug 2050211 - Wire up AA for primitives that have the ANTIALIASING flag. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit b1022dc0f55a1b2a25ba7d8d216d27a48714db4d.\n\nRevert \"Bug 2050211 - Make test 1780191-1.svg not rely on WebRender's incorrect snapping of SVG rectangles. r-#gfx-reviewers r=layout-reviewers,tnikkel\"\n\nThis reverts commit c17facc81b75ee75ca7d86021eef625de3403ab8.\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/space.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/wrench/reftests/snap/antialiased-ref.png", "gfx/wr/wrench/reftests/snap/antialiased.yaml", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled-ref.yaml", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled.yaml", "gfx/wr/wrench/reftests/snap/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs", "layout/reftests/bugs/1780191-1-ref.svg", "layout/reftests/bugs/1780191-1.svg", "layout/reftests/bugs/reftest.list", "layout/svg/SVGGeometryFrame.cpp", "testing/web-platform/meta/css/css-images/object-position-svg-001e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-001o.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002o.html.ini", "testing/web-platform/meta/svg/painting/inline-svg-resize-viewport-dependent-mask.html.ini", "testing/web-platform/meta/svg/painting/inner-outer-svg-overflow-auto.html.ini"], "git_node": "226150483e6386c7fd5a3dd627962e298d517e20", "git_parents": ["35a3165eba5a73dcd220a9236c0e73fcb7c05d28"], "node": "9c50fb2e9b5273676a45da3fd5876e787de8bca9", "parents": ["5902b351980121c0c7c22f2280a25ada9e2dc2f3"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2072300 - Firefox doesn't follow RFC9460 HTTPS AliasMode TargetName on Linux r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327825\n", "files": ["netwerk/dns/PlatformDNSUnix.cpp", "netwerk/test/gtest/TestDNS.cpp"], "git_node": "b6aebd5c9904148b66a3efe8aa1f95241d51100a", "git_parents": ["226150483e6386c7fd5a3dd627962e298d517e20"], "node": "602f67d26ba3a1b8d5c4c0fcd2df4cad536e24d6", "parents": ["9c50fb2e9b5273676a45da3fd5876e787de8bca9"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058855 - Judge clippy results from cargo's JSON output rather than the exit code r=linter-reviewers,sergesanspaille\n\n`mach cargo` always exits 0 (continue_on_error), so for gkrust the\nfailure-to-run check never fired and --fix always counted the crate as fixed.\nRead cargo's JSON output instead: no JSON line means clippy never ran, and the\nbuild-finished message says whether the build succeeded. This also prepares\nfor running the other crates through `mach cargo`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327349\n", "files": ["tools/lint/clippy/__init__.py", "tools/lint/test/test_clippy.py"], "git_node": "a725ca2819f1f5f8781039545b5a40e1f008b593", "git_parents": ["b6aebd5c9904148b66a3efe8aa1f95241d51100a"], "node": "3ac55fbe4205ff136174bd7fa984757f41204152", "parents": ["602f67d26ba3a1b8d5c4c0fcd2df4cad536e24d6"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058855 - Run clippy on non-gkrust crates through mach cargo r=linter-reviewers,sergesanspaille\n\nlint_crate ran bare cargo from the source directory, where there is no vendored\n.cargo/config.toml, so every run downloaded and built the crate's dependencies\nfrom scratch: about 2m20s of a 7m30s CI task. `mach cargo -p \u003ccrate\u003e clippy`\nreuses the objdir, the vendored sources and the dependencies already checked\nfor gkrust.\n\nBug 1960928 chose bare cargo to also lint crates excluded from the workspace,\nwhich never happened, and because mach swallows cargo's exit code, which the\nprevious commit stopped relying on. clippy.yml now says these crates must be\nworkspace members.\n\nmach's clippy wrapper (build/cargo-clippy-wrapper) lints every crate cargo\ncompiles, including path dependencies like autocfg and goblin, and this path\ndoes not filter results by path. Pass --no-deps to keep them to the requested\ncrate, as with bare cargo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327350\n", "files": ["tools/lint/clippy.yml", "tools/lint/clippy/__init__.py", "tools/lint/test/test_clippy.py"], "git_node": "b5f85a1cd1f56c16fe083cfefce0458eaa196d4d", "git_parents": ["a725ca2819f1f5f8781039545b5a40e1f008b593"], "node": "9a839ba11f7a784ea77fcce9b6ea34b2ceefb9c3", "parents": ["3ac55fbe4205ff136174bd7fa984757f41204152"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058855 - Share the clippy invocation between gkrust and the other crates r=linter-reviewers,sylvestre\n\nBoth paths now go through `mach cargo` and only differ in the cargo arguments\nand in whether results are filtered by path. Move the rest into run_clippy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327346\n", "files": ["tools/lint/clippy/__init__.py"], "git_node": "eca91d834021dd581bfb8058a896992067d3ee75", "git_parents": ["b5f85a1cd1f56c16fe083cfefce0458eaa196d4d"], "node": "9d9d1a46d8077305bf2c4b05896ff5921184addb", "parents": ["9a839ba11f7a784ea77fcce9b6ea34b2ceefb9c3"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2074212 r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328021\n", "files": ["layout/svg/SVGObserverUtils.cpp"], "git_node": "0c9c88d0d378ae4db63881c1e650e26e571f645c", "git_parents": ["eca91d834021dd581bfb8058a896992067d3ee75"], "node": "4c036f962c89cb0d985ee1cae7329f6cd8a2d42e", "parents": ["9d9d1a46d8077305bf2c4b05896ff5921184addb"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2039222 - Show addEngine badge on urlbar when applicable. r=dao,search-reviewers,urlbar-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326851\n", "files": ["browser/components/search/OpenSearchManager.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngineBadge.js"], "git_node": "0ea5bbbd30c2a43754ffda395f5eb3a9ce632999", "git_parents": ["0c9c88d0d378ae4db63881c1e650e26e571f645c"], "node": "6e870dcbbd39a8bc86addb0d8be2e8c1956a71de", "parents": ["4c036f962c89cb0d985ee1cae7329f6cd8a2d42e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2036862 - Make sure to use a fresh connection for each captive portal check r=necko-reviewers,sunil\n\nIf the interception is only achieved via DNS, and the captive portal does not forward traffic when\nunlocked, we might think the captive portal is still locked because we're reusing the connection\nwe obtained before logging in.\n\nThis patch adds LOAD_FRESH_CONNECTION + LOAD_INITIAL_DOCUMENT_URI to the CP detector\nso that we always use a new connection and refresh DNS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327801\n", "files": ["toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/test/unit/test_fresh_connection.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml"], "git_node": "6ae60b8d90e8f17f336aa5ec3fd0094b73b999eb", "git_parents": ["0ea5bbbd30c2a43754ffda395f5eb3a9ce632999"], "node": "5f30029eec46834f96887bd04568119520757c1c", "parents": ["6e870dcbbd39a8bc86addb0d8be2e8c1956a71de"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073570 - Mention ZenUML diagrams in the documentation skill. r=firefox-source-docs-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327432\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "1281e611b2c16ebc51c278f28e170fc2bbc7beab", "git_parents": ["6ae60b8d90e8f17f336aa5ec3fd0094b73b999eb"], "node": "fb3d541bd16c3fe3e6b668507fe2ae1a081d6959", "parents": ["5f30029eec46834f96887bd04568119520757c1c"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064872 - End playback during specific scenarios r=android-reviewers,matt-tighe\n\nEnd playback when:\n# The user removes the app from the recents list\n# The user dismisses the notification\n# The system kills the app\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327803\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionServiceTest.kt"], "git_node": "91810b533c718a74b657dc6ee63b0be182f28ed8", "git_parents": ["1281e611b2c16ebc51c278f28e170fc2bbc7beab"], "node": "cd74fdffa67456e9794cf3525a4c14d5f28c334f", "parents": ["fb3d541bd16c3fe3e6b668507fe2ae1a081d6959"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070577 - [wdspec] Add tests for camera and microphone permissions. r=Sasha,webdriver-reviewers\" for causing failures at GUM-deny.https.html.\n\nThis reverts commit 03bcfb78e7cf140f3b6f4cc2400298518472d482.\n\nRevert \"Bug 2070577 - Allow permissions.setPermission and WebDriver:SetPermission to set camera and microphone permissions. r=Sasha,webdriver-reviewers\"\n\nThis reverts commit e8b9b546706bfd00a881d76f3ee9c8fa481caed0.\n", "files": ["remote/shared/Permissions.sys.mjs", "testing/web-platform/tests/webdriver/tests/bidi/external/permissions/set_permission/set_permission.py"], "git_node": "a52bcbe012f74b2dea3a60f9c725308eca51b7e0", "git_parents": ["91810b533c718a74b657dc6ee63b0be182f28ed8"], "node": "dbd84acdb48f44b69830dd08fd27d15e5549917d", "parents": ["cd74fdffa67456e9794cf3525a4c14d5f28c334f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1815540 - Make SVG geometry independent of pointer-events. r=longsonr,firefox-svg-reviewers\n\nTrack the stroke width as part of ink overflow if needed, to make sure\nwe do the hit-testing right without affecting mRect.\n\nPort dom/svg/test/test_pointer-events-1*.xhtml to WPT so that it has\nsome coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327994\n", "files": ["dom/svg/test/mochitest.toml", "dom/svg/test/pointer-events.js", "dom/svg/test/test_pointer-events-1a.xhtml", "dom/svg/test/test_pointer-events-1b.xhtml", "layout/style/nsStyleStruct.cpp", "layout/svg/DisplaySVGItem.h", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGTextFrame.cpp", "testing/web-platform/meta/svg/interact/scripted/rect-hittest-001.html.ini", "testing/web-platform/meta/svg/interact/scripted/svg-small-big-path.html.ini", "testing/web-platform/tests/svg/interact/scripted/pointer-events-fill-stroke-hittest.html", "testing/web-platform/tests/svg/interact/scripted/pointer-events-getBoundingClientRect.html"], "git_node": "73497fd0b250cb687ee75c190fecb47f8d8b85f7", "git_parents": ["a52bcbe012f74b2dea3a60f9c725308eca51b7e0"], "node": "f067b55123b2838849c89f6f5c946cc86f0f6f43", "parents": ["dbd84acdb48f44b69830dd08fd27d15e5549917d"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/media headers through clang-tidy r=webrtc-reviewers,ng,bwc\n\nChanges includes:\n- using C++20 type aliases and inline variables\n- using nullptr where appropriate\n- making deleted methods public\n- making some methods default\n- rework some include dependencies to make header self contained\n- move some definition to source file to avoid some circular header\n  dependencies\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327947\n", "files": ["dom/media/BackgroundVideoDecodingPermissionObserver.cpp", "dom/media/Intervals.h", "dom/media/SelfRef.h", "dom/media/SharedBuffer.h", "dom/media/UnboundedMPSCQueue.h", "dom/media/VideoLimits.h", "dom/media/eme/CDMCaps.h", "dom/media/eme/CDMProxy.h", "dom/media/eme/DecryptorProxyCallback.h", "dom/media/encoder/ContainerWriter.h", "dom/media/gmp/GMPStorageParent.h", "dom/media/gmp/GMPVideoEncoderParent.h", "dom/media/gmp/gmp-api/gmp-video-decode.h", "dom/media/gmp/gmp-api/gmp-video-encode.h", "dom/media/mediasession/MediaSessionIPCUtils.h", "dom/media/mediasource/SourceBufferAttributes.h", "dom/media/mediasource/SourceBufferTask.h", "dom/media/mp4/Box.h", "dom/media/platforms/MediaTelemetryConstants.h", "dom/media/platforms/agnostic/bytestreams/ByteStreamsUtils.h", "dom/media/systemservices/MediaUtils.cpp", "dom/media/utils/MediaElementEventRunners.cpp", "dom/media/utils/MediaElementEventRunners.h", "dom/media/webaudio/AlignedTArray.h", "dom/media/webaudio/AudioWorkletGlobalScope.h", "dom/media/webm/NesteggPacketHolder.h", "dom/media/webrtc/RTCCertificate.h", "dom/media/webrtc/SineWaveGenerator.h", "dom/media/webrtc/WebrtcGlobal.h", "dom/media/webrtc/transport/nricemediastream.h", "dom/media/webrtc/transport/nriceresolverfake.h", "dom/midi/MIDIPlatformRunnables.h", "media/libogg/geckoextra/include/OggStructsForRLBox.h"], "git_node": "7f47ed1b7d4e1f4d03420908c7e89503d64a9560", "git_parents": ["73497fd0b250cb687ee75c190fecb47f8d8b85f7"], "node": "2c45d1bc90e4c1725944a721b33021536b7a4c15", "parents": ["f067b55123b2838849c89f6f5c946cc86f0f6f43"], "tags": []}, {"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074077 - Measure Rust login migration duration with ChromeUtils.now instead of Date.now() r=joschmidt,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327799\n", "files": ["toolkit/components/passwordmgr/LoginStorageMigrator.sys.mjs"], "git_node": "c4e1b4da747db638672cd16008cf846e7ccb34bf", "git_parents": ["7f47ed1b7d4e1f4d03420908c7e89503d64a9560"], "node": "5888e31d9804b980dc2a55297d193861548680ee", "parents": ["2c45d1bc90e4c1725944a721b33021536b7a4c15"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2069191 - Prevent socket thread priority events from blocking shutdown r=necko-reviewers,kershaw\n\nThe shutdown could also have been prevented by a regular priority event, if it\ngets redispatched to the socket thread, or if it triggers the dispatch of other events\nto the socket thread.\n\nThe fix adds a pref to limit the shutdown event processing to 3 seconds.\nIf there are still events to be processed after 3 seconds, we go ahead and break from the loop.\nIt is possible this will cause shutdown leaks, but that's probably better than hanging forever.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327784\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/base/nsSocketTransportService2.cpp", "netwerk/test/gtest/TestSocketTransportService.cpp"], "git_node": "f49526f5d2bacad11e66b4081a8bb33039ed76a3", "git_parents": ["c4e1b4da747db638672cd16008cf846e7ccb34bf"], "node": "d2cd874f1bfa1a1ba3bc51b3199f82e50c1a28d5", "parents": ["5888e31d9804b980dc2a55297d193861548680ee"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071741 - Don't generate full task graph for caching given we're not using it anymore. r=perftest-reviewers,aglavic DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327819\n", "files": ["tools/tryselect/selectors/perf.py", "tools/tryselect/tasks.py"], "git_node": "8bf904da347c291c57cdf81dbe74c7f16d104fab", "git_parents": ["f49526f5d2bacad11e66b4081a8bb33039ed76a3"], "node": "23e5d1145e83439e8d9ed8c89990b2be37f37678", "parents": ["d2cd874f1bfa1a1ba3bc51b3199f82e50c1a28d5"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072993 - Only mark a ContentClassifierRequest valid once its site and third-party flag are derived. r=emz\n\nThe channel constructor set mValid before deriving the host, site and\nthird-party flag, so any later early return handed the engine a request\nbuilt from the constructor defaults, where mThirdParty is true. A loading\nprincipal without a base domain, such as the expanded principal of a\ncontent-script fetch, took that path and got first-party requests to a\nlisted site blocked. Keep classifying those requests with an empty source\nsite, and set mValid last.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326929\n", "files": ["toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.cpp", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_content_script.js"], "git_node": "b5925e603d3a7587c1380f84db74c81da3039113", "git_parents": ["8bf904da347c291c57cdf81dbe74c7f16d104fab"], "node": "8f831d9f95de3da75ab79f8158607a874bc0aa01", "parents": ["23e5d1145e83439e8d9ed8c89990b2be37f37678"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074296 - Don't call script-\u003erealm() for dying scripts. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328068\n", "files": ["js/src/gc/Zone.cpp", "js/src/jit-test/tests/gc/bug2074296.js"], "git_node": "9069aebe63bf35546c30af02e912aa7bcdcf49a4", "git_parents": ["b5925e603d3a7587c1380f84db74c81da3039113"], "node": "62e84f7aa67ae46cc48962eaabf8c32573b5ea2e", "parents": ["8f831d9f95de3da75ab79f8158607a874bc0aa01"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073268 - Disable hoisting for loops with a generator resume dispatch. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327751\n", "files": ["js/src/jit/LICM.cpp", "js/src/jit/MIRGraph.cpp", "js/src/jit/MIRGraph.h", "js/src/jit/RangeAnalysis.cpp", "js/src/jit/WarpBuilder.cpp"], "git_node": "7b2fe6b3526ae10a771ce8a6c42a4fdd9637469d", "git_parents": ["9069aebe63bf35546c30af02e912aa7bcdcf49a4"], "node": "9a9e85b3aa08b1d7ae7ddc33aefe177e8057dc47", "parents": ["62e84f7aa67ae46cc48962eaabf8c