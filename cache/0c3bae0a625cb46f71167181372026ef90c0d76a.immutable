ebcf7cad48253c2e23", "e898c68f5a257f98efaa0d84b405acf978ab3ef7", "b48578dc3b36271de9a4ce8937fb502df8fcbe70", "b524a5c2c73e444fdc0104c214c46fd540aa6b98", "ea433875a76403af1aac330fc2033ed0e812783d", "1ddc4fc1c9f4168d54af4d46fc3357fe8877efeb", "4b8a1b7253e894723f7d0cd1d61e3e572d96418f", "c0ce5ae5a35f6c81e59a61f88f4f5afdb826d1ec", "5d6421bb6b21238c72fd00873fe62f0987b0d923", "f128b90fdcec25fad428cd3e2b33444d0c1e4615", "b69f1613d3ec7cd27251cbbf94b24824aa4aff34", "42b57cbde52097075d8ed9e64cb9e183f017312b", "20d2b60d6b16d72f047453fa5e1ce6d3bede3d9e", "f984cb1cff65053514566177bfafa1886ce42d46", "a1ede75a778814d12cfa4e125debc6e2ffaabce0", "9a17117b7bd4e5da0081bdcdec93cfb63864c966", "de748cf25a7ea6a68ce61c06a7fd0e029fb9d959", "1f504e17f70d539818dbb352533c9718d3a0380c", "251c0992cd1f4204e3ea188ff00c4dbf845fb077"], "user": "amarc@mozilla.com"}, "45312": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071179 - Prevent image function from ending up as WR fallback. r=gfx-reviewers,layout-reviewers,lsalzman,dshin\n\nThe image() function is incorrectly falling back to a blob image.\n\nUse an exclusive switch so that it doesn't happen again. The only thing\nwe don't support in the WR path as far as I can tell is -moz-element().\n\n-moz-symbolic-icon() works just like url(), and all the cases for url()\nwhere we return false there's basically nothing to draw. cross-fade() is\nnot implemented in either path so let's return true for now so that we\nintentionally switch to false if needed.\n\nI don't get the EffectiveAppearance() check and I don't think it's\nneeded. Those go through\nnsDisplayThemedBackground::CreateWebRenderCommands, and any\nauthor-specified background disables the native appearance.\n\nWhile at it don't bother to create WR commands for transparent colors,\nwhich are common in the front-end and is a one-liner check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325399\n", "files": ["layout/painting/nsCSSRendering.cpp", "layout/painting/nsImageRenderer.cpp"], "git_node": "99e4377e2e6865b45ba099ab3bd57883619f0cec", "git_parents": ["251c0992cd1f4204e3ea188ff00c4dbf845fb077"], "node": "629069ee2ae4fdbb2b66c88303e7d1c515f01616", "parents": ["45306dee8419383e2ce5c1619f3fbc613ec345f8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071359 - Use input tokens for the new tab search bar. r=emilio,desktop-theme-reviewers\n\nThe brand value the input text color gains is the page text color moz-input-text already inherited in-content.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325585\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_inputBackground.js", "browser/themes/shared/urlbar.css", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/input.tokens.json"], "git_node": "948709ca852d27a0d512f7a9e87e027ab1bd1a5e", "git_parents": ["99e4377e2e6865b45ba099ab3bd57883619f0cec"], "node": "3b0cff64ca4bc7383010c882b565c1f314cdf90c", "parents": ["629069ee2ae4fdbb2b66c88303e7d1c515f01616"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067259 - Rework the criteria used to determine whether font-family names are quoted. r=firefox-style-system-reviewers,emilio\n\nThis reflects the decision in https://github.com/w3c/csswg-drafts/issues/5846,\nand expectations of some recent WPTs (see later patch updating metadata).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325334\n", "files": ["devtools/server/tests/browser/browser_style_utils_getFontPreviewData.js", "servo/components/style/values/computed/font.rs", "testing/web-platform/meta/css/css-font-loading/fontfaceset-load-css-wide-keywords.html.ini", "testing/web-platform/tests/css/css-fonts/parsing/font-family-invalid.html", "testing/web-platform/tests/css/cssom/font-family-serialization-001.html"], "git_node": "035464ff9366f797be0691861a38c30a297ab35e", "git_parents": ["948709ca852d27a0d512f7a9e87e027ab1bd1a5e"], "node": "d37f36289ee052235cfb798029f4e5a432c37141", "parents": ["3b0cff64ca4bc7383010c882b565c1f314cdf90c"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067259 - When FamilyName is used for font names in src:local(), force its syntax to be Quoted. r=firefox-style-system-reviewers,emilio\n\nAlthough the spec seems a little unclear on this IMO, it matches the behavior of both Chrome and Safari,\nand is what css/css-fonts/font-family-src-quoted.html asserts:\nhttps://github.com/web-platform-tests/wpt/blob/59ff8a4854a8d2d32ca0dc113760f2aaad70f4b5/css/css-fonts/font-family-src-quoted.html#L7\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325335\n", "files": ["servo/components/style/font_face.rs", "testing/web-platform/tests/css/css-fonts/font-family-src-quoted.html"], "git_node": "b0b4f61f55bfe457678a6aebc91ee95748b26a04", "git_parents": ["035464ff9366f797be0691861a38c30a297ab35e"], "node": "a9191b775e6e6a0305426776ac601a1464770b9a", "parents": ["d37f36289ee052235cfb798029f4e5a432c37141"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067259 - Update WPT metadata to reflect revised behavior. r=firefox-style-system-reviewers,emilio\n\nMostly we're passing a bunch more tests now. The only \"new\" failure is because we don't implement\nthe ui-* generics, and therefore don't force things like (quoted) \"ui-serif\" to retain String syntax.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325337\n", "files": ["testing/web-platform/meta/css/css-font-loading/fontface-css-connected-descriptors.html.ini", "testing/web-platform/meta/css/css-fonts/parsing/font-family-computed.html.ini", "testing/web-platform/meta/css/css-fonts/parsing/font-family-valid.html.ini", "testing/web-platform/meta/css/css-fonts/variations/font-weight-matching-installed-fonts.html.ini", "testing/web-platform/meta/css/cssom/font-family-serialization-001.html.ini", "testing/web-platform/meta/css/cssom/serialize-values.html.ini"], "git_node": "a96f6b83c0eb1b2e8a9afeb65e28c9f52a78627e", "git_parents": ["b0b4f61f55bfe457678a6aebc91ee95748b26a04"], "node": "eafbefdc317c059b1f5cb22a51099f527b7ab778", "parents": ["a9191b775e6e6a0305426776ac601a1464770b9a"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067259 - Update mochitest expectations for revised font-family quoting behavior. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325338\n", "files": ["layout/style/test/test_font_face_parser.html", "layout/style/test/test_font_family_serialization.html"], "git_node": "f48bac4bf4ebaa559d420dedd65551c8a62a16e3", "git_parents": ["a96f6b83c0eb1b2e8a9afeb65e28c9f52a78627e"], "node": "5297a7745ef067157aae9092326cc97e681bf3f3", "parents": ["eafbefdc317c059b1f5cb22a51099f527b7ab778"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2069212. Back out the local jxl_simd workaround so the 0.7.2 vendor bump is a pure upstream delta. r=saschanaz,supply-chain-reviewers\n\nThis backs the bug 2043090 macOS x86_64 workaround\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325231\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/src/x86_64/avx.rs", "third_party/rust/jxl_simd/src/x86_64/avx512.rs"], "git_node": "49a7796d3331f27504474a2de148b11e1598bcca", "git_p