.html", "dom/media/autoplay/test/mochitest/file_autoplay_gv_play_request_window.html"], "git_node": "87ce44a6bbe60902e80b7fa0b52ec313119d8dae", "git_parents": ["476f78b572b79c72d85b2445e7547d4c4e422ed5"], "node": "feff598c3f38f910d2eba052315dd0f57360ccda", "parents": ["08b9cdfbdc4abc11aed8dc7407c6a7388eece658"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058024 - Update color of empty state links in the sidebar r=desktop-theme-reviewers,fxview-reviewers,dao,nsharpley\n\nSpoke to Eric on the UX team about this, and he wants to use --link variables here to be consistent with other internal browser links around the browser for Nova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325100\n", "files": ["browser/components/firefoxview/fxview-empty-state.css"], "git_node": "7864854ce75271a6f97d05a174db8698c2b473e6", "git_parents": ["87ce44a6bbe60902e80b7fa0b52ec313119d8dae"], "node": "8e42835052345e92539f99a97d39e826ec1568ce", "parents": ["feff598c3f38f910d2eba052315dd0f57360ccda"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072228 - [nova] Fix mica / accent-color-in-tabs rendering. r=desktop-theme-reviewers,kcochrane\n\nFixes the mica / accent-color-in-tabs prefs when using nova.\n\nProbably long-term we want to avoid using the brand colors more\ngenerally here, like when we use the windows system theme, but...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326176\n", "files": ["browser/themes/windows/browser.css"], "git_node": "a265c733bbad75d360e64370e22392b1d4bce168", "git_parents": ["7864854ce75271a6f97d05a174db8698c2b473e6"], "node": "3d186851a1576b4abed42cca54ce1b1c6cd0781d", "parents": ["8e42835052345e92539f99a97d39e826ec1568ce"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071056 - make gecko-profiler optional for mdns_service;r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325128\n", "files": ["dom/media/webrtc/transport/mdns_service/Cargo.toml", "dom/media/webrtc/transport/mdns_service/src/lib.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "fb2f0c0016e28810f87803774c1cc636be51b9da", "git_parents": ["a265c733bbad75d360e64370e22392b1d4bce168"], "node": "d7e46f2185c06d712ecd734d833b461337ef2f57", "parents": ["3d186851a1576b4abed42cca54ce1b1c6cd0781d"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070751 - run clippy on mdns_service;r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325092\n", "files": ["dom/media/webrtc/transport/mdns_service/src/lib.rs"], "git_node": "90605e51181f1e871bc99b58305b0233c1f11e9f", "git_parents": ["fb2f0c0016e28810f87803774c1cc636be51b9da"], "node": "85f8ba91fd0da03d650fdb5f8279df7abf4e7f01", "parents": ["d7e46f2185c06d712ecd734d833b461337ef2f57"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068255 - do not use magic numbers;r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325093\n", "files": ["dom/media/webrtc/transport/mdns_service/src/lib.rs"], "git_node": "fa920a2f14dc432eab2cbcc5d206ed7666208634", "git_parents": ["90605e51181f1e871bc99b58305b0233c1f11e9f"], "node": "0e845cc3e2aa98e5ef32a68fbb5af82dce2f54b0", "parents": ["85f8ba91fd0da03d650fdb5f8279df7abf4e7f01"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067940 - Time out quickly when Canonical debuginfod servers are not responding r=schopin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326118\n", "files": ["taskcluster/kinds/system-symbols/kind.yml"], "git_node": "6301266de311b1873055a41ff49afab91ec34164", "git_parents": ["fa920a2f14dc432eab2cbcc5d206ed7666208634"], "node": "4050891654479bd83cf37603c7618285a7bac81f", "parents": ["0e845cc3e2aa98e5ef32a68fbb5af82dce2f54b0"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067940 - Build 7-zip as a statically linked executable r=schopin\n\nThis prevents potential mismatches between the libstdc++ version the\nexecutable is built against and the one available in the Docker\ncontainer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326119\n", "files": ["taskcluster/scripts/misc/build-7zz.sh"], "git_node": "e199f56b70df50c68393ec69bc7ae5f0c857f82a", "git_parents": ["6301266de311b1873055a41ff49afab91ec34164"], "node": "aee1a96f963ab4673e5b813a02746e8c6edddf04", "parents": ["4050891654479bd83cf37603c7618285a7bac81f"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067940 - Use a new version of the symbol scraper scripts with various fixes r=schopin\n\n* More Ubuntu-packaged versions of Firefox and Thunderbird are scraped\n* The scripts won't waste time looking up debug information for known\n  closed-source packages\n* Ubuntu debug information packages are scraped again\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326120\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "2b404797f3647588bfdeceb8519289ec3a4f4e44", "git_parents": ["e199f56b70df50c68393ec69bc7ae5f0c857f82a"], "node": "c1abfc7b3013dc283aee077fc46119e4de551b34", "parents": ["aee1a96f963ab4673e5b813a02746e8c6edddf04"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071539 - Use a sparse checkout for `repackage-msi` tasks r=taskgraph-reviewers,bhearsum\n\nAn MSI repackage reads one `.wxs` file and runs a mozharness script, but\nchecked out the full tree, which on Windows is 10 of the task's 16 minutes\n(in hg).\n\nThe `mach` profile gains `testing/gtest`. Since bug 1973820,\n`mozbuild/mach_commands.py` imports `gtest.reports` at load time, so any\n`./mach` command needs that directory. Every sparse profile that ran `./mach` so\nfar happened to pull it in through broader patterns, this is the first one\nthat doesn't.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325580\n", "files": ["build/sparse-profiles/mach", "build/sparse-profiles/repackage-msi", "taskcluster/gecko_taskgraph/transforms/job/mozharness.py", "taskcluster/gecko_taskgraph/transforms/repackage.py", "taskcluster/kinds/repackage-msi/kind.yml"], "git_node": "553796051470591bf78b04de884a4e1eba358746", "git_parents": ["2b404797f3647588bfdeceb8519289ec3a4f4e44"], "node": "c905f76a7841308641e464d60b706c2d029036bb", "parents": ["c1abfc7b3013dc283aee077fc46119e4de551b34"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071081 - Add a `# git-checkout: full` marker for sparse profiles that are slower sparse than full on git r=taskgraph-reviewers,jcristau\n\nSome sparse profiles are slower as a git sparse checkout than as a full\nclone. A sparse clone fetches the profile's blobs by hash after the clone,\nwhich is much slower than the single pack a full clone streams. Profiles\nthat match files all over the tree (taskgraph, everything that includes\nit, and sphinx-docs) take 80s to 87s cold vs ~45s on Linux and ~59s on\nWindows for a full clone, and gain nothing warm. hg isn't affected, it\nalready has every file locally and a sparse profile only means writing\nfewer of them.\n\nA `# git-checkout: full` comment in a profile, or in one it `%include`s,\nmarks it as a full checkout for git tasks. hg ignores the comment. A test\npins the marked set to the five profiles I measured.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325577\n", "files": ["build/sparse-profiles/sphinx-docs", "build/sparse-profiles/taskgraph", "taskcluster/gecko_taskgraph/test/test_util_sparse_profiles.py", "taskcluster/gecko_taskgraph/util/sparse_profiles.py"], "git_node": "323ae3f3e9dfe77692ad43063bcb9b8f040df3ed", "git_parents": ["553796051470591bf78b04de884a4e1eba358746"], "node": "239c0dee6fa18f79af4275f588cd018bdc1468fc", "parents": ["c905f76a7841308641e464d60b706c2d029036bb"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069803 - Enable on-device Speech Recognition on Nightly. r=media-webspeech-reviewers,pehrsons\" for causing mochitest failures\n\nThis reverts commit 55a34140f46c23da1e972c44de3242fdca50e55f.\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "b230f8bab55b05c3a58559a1b37f7d1d3629da77", "git_parents": ["323ae3f3e9dfe77692ad43063bcb9b8f040df3ed"], "node": "bd4b986991a45ebe55d69010641f09c3c388d7f4", "parents": ["239c0dee6fa18f79af4275f588cd018bdc1468fc"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045798, Bug 2045801: Support ephemeral containers in SitePolicies. r=bsmth\" for causing xpcshell failures in test_sitepolicies.js.\n\nThis reverts commit ac00aa71d8fc131aec235b5b108fa759432fa1dd.\n\nThis reverts commit 16f1aef104734dd2589cda324a1c470dc19837cc.\n", "files": ["browser/components/enterprisepolicies/EphemeralContainerWatcher.sys.mjs", "browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/moz.build", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "dom/ipc/gtest/ProcessIsolationTest.cpp", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit