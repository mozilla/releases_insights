], "git_node": "68f98212ec6fbfc692515bee0ee45b684eabb006", "git_parents": ["263328c99329921ac6282374e2ab2c6bdd723501"], "node": "ab5a5a87fff63fc0b14307f42117d3cbaa5cfea4", "parents": ["8d90b89b1dfc6169f74bb19476182565f9a45fd5"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2061862 - [Monitor Agent][FE] Adding more testing around region gating for slash command r=yjamora,urlbar-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324700\n", "files": ["browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "33861f4f474e99363da96541ee203ebfe8a5e31d", "git_parents": ["68f98212ec6fbfc692515bee0ee45b684eabb006"], "node": "d92c1ea59255e9ee42d847ff14bdd946d4195964", "parents": ["ab5a5a87fff63fc0b14307f42117d3cbaa5cfea4"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063154 - Remove redundant engine construction from #buildPlainResumeConversation r=echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326278\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "264edde694f1ddd74979dab50356a883679b23dc", "git_parents": ["33861f4f474e99363da96541ee203ebfe8a5e31d"], "node": "fbf9790636c84b2b550f156cef6c62d7f326fda9", "parents": ["d92c1ea59255e9ee42d847ff14bdd946d4195964"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072718 - Expose borrowed style struct getters and rename clone_ to slow_clone_. r=firefox-style-system-reviewers,dshin\n\nAdd get_\u003clonghand\u003e() accessors returning a reference to the stored computed\nvalue for every longhand whose Gecko storage is the computed value type, and\nrename the by-value clone_\u003clonghand\u003e() accessors to slow_clone_\u003clonghand\u003e()\nto discourage their use.\n\nLonghands stored in per-layer / per-animation arrays (background-*, mask-*,\nanimation-*, transition-*, scroll-timeline-*, view-timeline-*), and the few\nhand-converted ones (font-size, -x-lang, font-feature-settings,\nfont-variation-settings) keep only slow_clone_. Keyword longhands whose enum\nis still defined by hand in nsStyleConsts.h also keep only slow_clone_ until\nthey are moved to Rust.\n\nThe \u003clonghand\u003e_equals() comparators for the array-backed longhands now\ncompare the arrays in place instead of cloning both sides, and\ndiffering_properties() uses them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326610\n", "files": ["servo/components/style/data.rs", "servo/components/style/device/gecko.rs", "servo/components/style/device/mod.rs", "servo/components/style/gecko/pseudo_element.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/invalidation/stylesheets.rs", "servo/components/style/logical_geometry.rs", "servo/components/style/matching.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/data.py", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/helpers.mako.rs", "servo/components/style/properties/helpers/animated_properties.mako.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/rule_cache.rs", "servo/components/style/servo/animation.rs", "servo/components/style/servo/selector_parser.rs", "servo/components/style/style_adjuster.rs", "servo/components/style/style_resolver.rs", "servo/components/style/stylesheets/container_rule.rs", "servo/components/style/values/computed/border.rs", "servo/components/style/values/computed/font.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/computed/text.rs", "servo/components/style/values/specified/color.rs", "servo/components/style/values/specified/font.rs", "servo/components/style/values/specified/length.rs", "servo/components/style/values/specified/text.rs", "servo/ports/geckolib/glue.rs"], "git_node": "1d8af47e7546e45986e19e3eb23f41f81da2f3e5", "git_parents": ["264edde694f1ddd74979dab50356a883679b23dc"], "node": "571b98b1560df55c0fca4f48337ba88a85652358", "parents": ["fbf9790636c84b2b550f156cef6c62d7f326fda9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072718 - Make box-decoration-break a predefined type. r=firefox-style-system-reviewers,dshin\n\nDefine the enum in Rust and export it through cbindgen instead of\nkeeping a hand-written copy in nsStyleConsts.h, so the Gecko style\nstruct stores the computed value type directly and the style struct\ngetter can hand out a reference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326611\n", "files": ["layout/style/ServoBindings.toml", "layout/style/nsStyleConsts.h", "servo/components/style/properties/data.py", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/border.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/specified/border.rs", "servo/components/style/values/specified/mod.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": "b0aab82126180085544781588dc0e5bbfd2616e5", "git_parents": ["1d8af47e7546e45986e19e3eb23f41f81da2f3e5"], "node": "b110fd0ca8b3ed6df7a9c9c854250900ab591ecb", "parents": ["571b98b1560df55c0fca4f48337ba88a85652358"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072718 - Make background-attachment a predefined type. r=firefox-style-system-reviewers,dshin\n\nDefine the enum in Rust and export it through cbindgen instead of\nkeeping a hand-written copy in nsStyleConsts.h, so the Gecko style\nstruct stores the computed value type directly and the style struct\ngetter can hand out a reference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326612\n", "files": ["layout/style/ServoBindings.toml", "layout/style/nsStyleConsts.h", "servo/components/style/properties/data.py", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/background.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/specified/background.rs", "servo/components/style/values/specified/mod.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": "1654bf4a3506e35315b9a0cdc4b68c9f8e8ff750", "git_parents": ["b0aab82126180085544781588dc0e5bbfd2616e5"], "node": "73094a6010443b90b13af1b0e5eada9bd17f6905", "parents": ["b110fd0ca8b3ed6df7a9c9c854250900ab591ecb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072718 - Make -moz-float-edge a predefined type. r=firefox-style-system-reviewers,dshin\n\nDefine the enum in Rust and export it through cbindgen instead of\nkeeping a hand-written copy in nsStyleConsts.h, so the Gecko style\nstruct stores the computed value type directly and the style struct\ngetter can hand out a reference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326613\n", "files": ["layout/style/ServoBindings.toml", "layout/style/nsStyleConsts.h", "servo/components/style/properties/data.py", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/border.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/specified/border.rs", "servo/components/style/values/specified/mod.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": "8b6f4dd8ccac0a96a7c01a8dea346351ccf31056", "git_parent