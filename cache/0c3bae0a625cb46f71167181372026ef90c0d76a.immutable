g 1594264 - Enable sql normalization r=mak\"\n\nThis reverts commit ace0d6657813aeeda194947628b1a58f010552e9.\n", "files": ["storage/metrics.yaml", "storage/moz.build", "storage/mozStorageConnection.cpp", "storage/mozStorageConnection.h", "storage/mozStorageService.cpp", "storage/pings.yaml", "third_party/sqlite3/src/moz.build", "third_party/sqlite3/src/sqlite.symbols", "toolkit/components/glean/metrics_index.py"], "git_node": "d52ea4b46df8cacff1f50cde65126e85f01f6283", "git_parents": ["59d8828ca8d27ff171926f37ea7461fdad9745f2"], "node": "1fb42e30232eb89a699045f8ae064a0601bff997", "parents": ["02392ebf56fd34cb163f85d4c33ef00282b66433"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062112 - [Monitor Agent][FE] Create monitor component in tool bar panel r=ngrato,fluent-reviewers,desktop-theme-reviewers,sfoster,bolsson\" for causing bc and tv tests failures\n\nThis reverts commit f0d8095427ae40d25d3057d187102d3548a155c4.\n", "files": ["browser/base/content/browser.js", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/a