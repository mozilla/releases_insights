ontainers/flat_serialize.rs", "third_party/rust/adblock/src/flatbuffers/containers/flat_set.rs", "third_party/rust/adblock/src/flatbuffers/containers/hash_index.rs", "third_party/rust/adblock/src/flatbuffers/containers/hash_map.rs", "third_party/rust/adblock/src/flatbuffers/containers/hash_set.rs", "third_party/rust/adblock/src/flatbuffers/containers/mod.rs", "third_party/rust/adblock/src/flatbuffers/containers/sorted_index.rs", "third_party/rust/adblock/src/flatbuffers/fb_network_filter.fbs", "third_party/rust/adblock/src/flatbuffers/fb_network_filter_generated.rs", "third_party/rust/adblock/src/flatbuffers/mod.rs", "third_party/rust/adblock/src/flatbuffers/unsafe_tools.rs", "third_party/rust/adblock/src/lib.rs", "third_party/rust/adblock/src/lists.rs", "third_party/rust/adblock/src/network_filter_list.rs", "third_party/rust/adblock/src/optimizer.rs", "third_party/rust/adblock/src/regex_manager.rs", "third_party/rust/adblock/src/request.rs", "third_party/rust/adblock/src/resources/mod.rs", "third_party/rust/adblock/src/resources/resource_assembler.rs", "third_party/rust/adblock/src/resources/resource_storage.rs", "third_party/rust/adblock/src/url_parser/mod.rs", "third_party/rust/adblock/src/url_parser/parser.rs", "third_party/rust/adblock/src/utils.rs", "toolkit/components/antitracking/docs/content-classifier/index.md", "toolkit/components/content-classifier/content_classifier_engine/Cargo.toml", "toolkit/components/content-classifier/content_classifier_engine/src/lib.rs", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "059761bd4731862a3be1424125e40d049b1d1aab", "git_parents": ["e588df35783921211383191009fb365459ff7da5"], "node": "9f65c98e1892714aabad7273ef2d477b6ae3108b", "parents": ["081e539a24f63501f6f571da9ecbdbd516f07ff0"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071897 - Normalise the algorithm once per WebCrypto operation r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325894\n", "files": ["dom/crypto/WebCryptoTask.cpp", "dom/crypto/WebCryptoTask.h", "testing/web-platform/meta/WebCryptoAPI/encrypt_decrypt/aes_gcm.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/encrypt_decrypt/aes_gcm_256_iv.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/sign_verify/eddsa_curve25519.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/sign_verify/rsa_pkcs.https.any.js.ini"], "git_node": "3be31e6707ff00db280beb0c2d3a674f38ccc2c1", "git_parents": ["059761bd4731862a3be1424125e40d049b1d1aab"], "node": "3383bb6785ff6a35d7a9bbe378b4037d836ead13", "parents": ["9f65c98e1892714aabad7273ef2d477b6ae3108b"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068190 - Log nsTerminator's shutdown hang diagnosis before saving the hang profile. r=xpcom-reviewers,edenchuang,nika\n\nOnce RunWatchdog decides to crash it first saves a profile of the hang in\nMaybeSaveShutdownHangProfile() and only then emits its diagnosis: the nested\nevent loop stack to stderr, the shutdown phase and the running worker counts\nonly through the crash message. Writing the profile can take long enough for\nthe test harness to kill the process first, and the wait for a scheduled\nprofiler dump that precedes it exits the process on its own. In both cases the\nhang is left behind as a bare profile artifact, with no line in the log saying\nwhere shutdown stopped.\n\nGather and log the diagnosis first, and keep the profile save and the crash\ncalls after it. The worker information needs CrashIfHanging to be split up for\nthat, since it fuses gathering the message with crashing on it: the terminator\nwas its only caller, so it becomes GetHangingWorkersInfo and the terminator\ncrashes with the message itself.\n\nThe crash messages are unchanged; the phase and the worker counts are now also\nlogged to stderr, and the workers crash requests analysis of all threads like\nthe other crashes in RunWatchdog.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322832\n", "files": ["dom/workers/RuntimeService.cpp", "dom/workers/RuntimeService.h", "toolkit/components/terminator/nsTerminator.cpp"], "git_node": "681d14d7f4bba88271d8ab9b2de9e01b71acb266", "git_parents": ["3be31e6707ff00db280beb0c2d3a674f38ccc2c1"], "node": "58cf7e071aaf22204f689d6d1f61a71800040e54", "parents": ["3383bb6785ff6a35d7a9bbe378b4037d836ead13"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072423 - Update metadata for network-error-logging/sends-report-on-cache-validation.https.html on Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326861\n", "files": ["testing/web-platform/meta/network-error-logging/sends-report-on-cache-validation.https.html.ini"], "git_node": "e7fc49210f9b752ce5060279f130a49a19df122c", "git_parents": ["681d14d7f4bba88271d8ab9b2de9e01b71acb266"], "node": "ea8749d429ff0e49e55d1ca1c672e02bc4db164f", "parents": ["58cf7e071aaf22204f689d6d1f61a71800040e54"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050230 - Remove unused IPProtectionManager code. r=android-reviewers,gmalekpour,joberhauser\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326556\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/IPProtectionManager.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/IPProtectionManagerTest.kt"], "git_node": "c7a12f054f0706d0e2b73661599c404ecceb263c", "git_parents": ["e7fc49210f9b752ce5060279f130a49a19df122c"], "node": "30706424bd0b7b0764d80ba1be63671ea4c2dcd8", "parents": ["ea8749d429ff0e49e55d1ca1c672e02bc4db164f"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072686 - Retire the onboarding auto-finish heuristic in BaseBrowserFragment.observeTabSource(). r=android-reviewers,joberhauser\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326574\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/BrowserFragmentTest.kt"], "git_node": "27621bf70a3892c044b8ab14e47b7f1f06d4c928", "git_parents": ["c7a12f054f0706d0e2b73661599c404ecceb263c"], "node": "81989236f7f9fd080a691a30acfa98fb5db013ff", "parents": ["30706424bd0b7b0764d80ba1be63671ea4c2dcd8"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Don't swap the requested frame dimensions for rotated frames. r=webrtc-reviewers,bwc\n\nA capture backend reports rotation rather than applying it, so its frames stay\nin camera orientation and it is the consumer that turns them upright for\ndisplay. CalculateDesiredSize() nonetheless swapped the requested width and\nheight whenever a frame carried a rotation of 90 or 270 degrees, which sized\nthe frame against an orientation it was never delivered in.\n\nWith a 640x480 request and a frame rotated 90 degrees, that computed a desired\nsize of 480x640 for a frame that is 640x480. DeliverFrame() then declined to\nrescale, since that would have meant upscaling the height, so the frame was\ndelivered untouched at 640x480 while getSettings() reported 480x640.\n\nRotation is display metadata and does not change which frame size was\nnegotiated, so the swap is removed rather than corrected. It also swapped\nmCapabilityWidth with itself instead of with mCapabilityHeight, so it had never\nswapped the dimensions of the capability it was reached for in the first place.\n\ntest_getUserMedia_videoOrientation.html gains two passes over the camera\ncapture backend, reached with media.getusermedia.camera.fake.force since\nfake: true uses MediaEngineFake and does not exercise\nMediaEngineRemoteVideoSource at all: one rotating while capture is running, and\none where the rotation is already in effect when capture starts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324970\n", "files": ["dom/media/VideoSegment.cpp", "dom/media/VideoSegment.h", "dom/media/systemservices/PCameras.ipdl", "dom/media/systemservices/VideoFrameUtils.cpp", "dom/media/webrtc/MediaEngineRemoteVideoSource.cpp", "dom/media/webrtc/tests/mochitests/mochitest_getusermedia.toml", "dom/media/webrtc/tests/mochitests/test_getUserMedia_videoOrientation.html"], "git_node": "67d548b502efb7cdd6d77298306c085cdb039ba8", "git_parents": ["27621bf70a3892c044b8ab14e47b7f1f06d4c928"], "node": "ec10faa35616dc427c257bdc8d30ea1437a76766", "parents": ["81989236f7f9fd080a691a30acfa98fb5db013ff"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Apply capture rotation centrally, behind a pref. r=webrtc-reviewers,layout-reviewers,bwc,TYLin\n\nBackends disagree about rotation: some route through\nVideoCaptureImpl::IncomingFrame, where libwebrtc would apply\nSetApplyRotation, and some deliver straight to DeliverCapturedFrame and so\nnever reach it. IncomingFrame also allocates a full buffer per frame whether\nor not it rotates.\n\nRather than teaching every backend to use IncomingFrame, straighten the frame\nonce in AggregateCapturer::OnFrame, after the frame-rate throttle so it is\npaid per delivered frame rather than per captured frame, and only when a\nconsumer wants the frame. media.webrtc.capture.apply-rotation decides whether\nto apply it at all.\n\nPCameras now says whether that happened: originalRotationRequired is the\nrotation the backend reported, and rotationApplied whether the parent\nstraightened the buffer or left it to the consumer. The negotiated capability\ndescribes the frame as the backend produced it, so the consumer needs the\noriginal rotation for its size calculations either way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324971\n", "files": ["dom/media/systemservices/CamerasParent.cpp", "dom/media/systemservices/FakeVideoSource.cpp", "dom/media/systemservices/PCameras.ipdl", "dom/media/systemservices/VideoFrameUtils.cpp", "dom/media/systemservices/VideoFrameUtils.h", "dom/media/webrtc/MediaEngineRemoteVideoSource.cpp", "dom/media/webrtc/tests/mochitests/test_getUserMedia_videoOrientation.html", "dom/media/webrtc/tests/reftest/reftest.list", "dom/media/webrtc/tests/reftest/videoOrientation-ref.html", "dom/media/webrtc/tests/reftest/videoOrientation.html", "layout/reftests/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/mediacapture-streams/MediaStreamTrack-rotation.https.html.ini", "testing/web-platform/mozilla/tests/mediacapture-streams/MediaStreamTrack-rotation.https.html"], "git_node": "8447ecb42cfd192fa5631726ff2f0ca0c0549059", "git_parents": ["67d548b502efb7cdd6d77298306c085cdb039ba8"], "node": "47acad0a79339ff5b7b5e1ae6f38d9efbd3fa5a4", "parents": ["ec10faa35616dc427c257bdc8d30ea1437a76766"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Only report a capture frame size change when it actually changed. r=webrtc-reviewers,bwc\n\ndstSize is the negotiated size while mScaledImageSize tracks the delivered\nimage, and the two differ when the parent straightens a quarter turn. Comparing\nthem dispatched a settings update for every frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324972\n", "files": ["dom/media/webrtc/MediaEngineRemoteVideoSource.cpp", "dom/media/webrtc/MediaEngineRemoteVideoSource.h"], "git_node": "a970c57f6c0a86e49fd0ada87a3b9db486850a3c", "git_parents": ["8447ecb42cfd192fa5631726ff2f0ca0c0549059"], "node": "374d7674ffb551f904fa5c13e7d6551129836692", "parents": ["47acad0a79339ff5b7b5e1ae6f38d9efbd3fa5a4"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066949 - Report rotation from the Android capture backend instead of applying it. r=webrtc-reviewers,bwc\n\nVideoCaptureAndroid rotated every frame with I420Buffer::Rotate, which\nallocates, and then delivered it tagged as needing no rotation. Every other\nbackend reports the rotation and leaves the frame in camera orientation for the\nconsumer to turn upright, so do that here too and drop the copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324973\n", "files": ["dom/media/systemservices/android_video_capture/video_capture_android.cc"], "git_node": "2fd05f7e6778ffac219621a25f5962a3ac9f8bad", "git_parents": ["a970c57f6c0a86e49fd0ada87a3b9db486850a3c"], "node": "104370ce09de7bb77c7ece93dd24552b1107677a", "parents": ["374d7674ffb551f904fa5c13e7d6551129836692"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2066949: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/webrtc/MediaEngineRemoteVideoSource.cpp"], "git_node": "084f38a4fb93ac43335278ae3b5914cf7d906d5f", "git_parents": ["2fd05f7e6778ffac219621a25f5962a3ac9f8bad"], "node": "820144178ad1eed74a0325f76e19cb1a2e1e8ca1", "parents": ["104370ce09de7bb77c7ece93dd24552b1107677a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072488 - Fix C++ representation of computed colors. r=sajidanwar\n\nThis patch makes the C++ representation of computed colors, which\ncurrently involves a specified calc node, correct.\n\nThis is mostly a band-aid fix, there are two issues that are worth\nfixing here:\n\n * Now that we have computed calc nodes, it probably makes sense to use\n   those properly for colors, even if a bit of a pain.\n\n * RandomKey stores a specified::Number but the C++ code only knows\n   about computed::Number. This all kinda works out because RandomKey is\n   boxed and shouldn't get to computed nodes anyway, but might go away\n   or move soon enough, see bug 2071971.\n\n * I made the GenericPercentageLeaf less generic because it made things\n   complicated for no good reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326798\n", "files": ["layout/style/ServoBindings.toml", "layout/style/ServoStyleConstsForwards.h", "servo/components/style/color/component.rs", "servo/components/style/values/computed/calc.rs", "servo/components/style/values/computed/length.rs", "servo/components/style/values/computed/length_percentage.rs", "servo/components/style/values/computed/percentage.rs", "servo/components/style/values/generics/calc.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/percentage.rs", "servo/components/style/values/specified/random.rs", "servo/ports/geckolib/cbindgen.toml", "servo/ports/geckolib/glue.rs", "testing/web-platform/tests/css/css-color/crashtests/firefox-bug-2072488.html"], "git_node": "d4b12b566362db378b644d22714ae1fce43e4faa", "git_parents": ["084f38a4fb93ac43335278ae3b5914cf7d906d5f"], "node": "cd3e53f293e6848269385ff0e0c181c1dd2270d9", "parents": ["820144178ad1eed74a0325f76e19cb1a2e1e8ca1"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2070815 [Wayland] Make MoveToWorkspace()/GetWorkspaceID() no op when session management is disabled r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326840\n", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "98bfd32c15ce01424623b1f601c4a8d1a6bc5434", "git_parents": ["d4b12b566362db378b644d22714ae1fce43e4faa"], "node": "90ef981ca9ecd7063d29935078bb694f6607368e", "parents": ["cd3e53f293e6848269385ff0e0c181c1dd2270d9"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070659 - upgrade NSS to d2eac3af657f915858f926