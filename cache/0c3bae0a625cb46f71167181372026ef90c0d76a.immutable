ting/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/dynamic-grid-track-direction.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-flex-sizing-rows-min-max-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-fr-rows-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-check-grid-height-on-resize.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini"], "git_node": "18875dc40511a2d574563bf045541eff56137018", "git_parents": ["5e65b268b49f35ff4030f2994d0e38678f5d2de9"], "node": "ace31ebf37b58f976361e92717acce3ade1d5f87", "parents": ["234a6d474a99e8a225ee518d4463efca9feba8ba"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066949: apply code formatting via Lando\" for causing reftests failures in videoOrientation.html.\n\nThis reverts commit 084f38a4fb93ac43335278ae3b5914cf7d906d5f.\n\nThis reverts commit 2fd05f7e6778ffac219621a25f5962a3ac9f8bad.\n\nThis reverts commit a970c57f6c0a86e49fd0ada87a3b9db486850a3c.\n\nThis reverts commit 8447ecb42cfd192fa5631726ff2f0ca0c0549059.\n\nThis reverts commit 67d548b502efb7cdd6d77298306c085cdb039ba8.\n", "files": ["dom/media/VideoSegment.cpp", "dom/media/VideoSegment.h", "dom/media/systemservices/CamerasParent.cpp", "dom/media/systemservices/FakeVideoSource.cpp", "dom/media/systemservices/PCameras.ipdl", "dom/media/systemservices/VideoFrameUtils.cpp", "dom/media/systemservices/VideoFrameUtils.h", "dom/media/systemservices/android_video_capture/video_capture_android.cc", "dom/media/webrtc/MediaEngineRemoteVideoSource.cpp", "dom/media/webrtc/MediaEngineRemoteVideoSource.h", "dom/media/webrtc/tests/mochitests/mochitest_getusermedia.toml", "dom/media/webrtc/tests/mochitests/test_getUserMedia_videoOrientation.html", "dom/media/webrtc/tests/reftest/reftest.list", "dom/media/webrtc/tests/reftest/videoOrientation-ref.html", "dom/media/webrtc/tests/reftest/videoOrientation.html", "layout/reftests/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/mediacapture-streams/MediaStreamTrack-rotation.https.html.ini", "testing/web-platform/mozilla/tests/mediacapture-streams/MediaStreamTrack-rotation.https.html"], "git_node": "71e2d49cb7b3bfc6e0247e7c5dd2bda0bcced83b", "git_parents": ["18875dc40511a2d574563bf045541eff56137018"], "node": "3fabf262cbd03a5e8fc63efe129b6d617c903082", "parents": ["ace31ebf37b58f976361e92717acce3ade1d5f87"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for MediaStreamTrack state after transfer to a dedicated worker. r=webrtc-reviewers,bwc\n\nCovers that id, kind, label, readyState, enabled, muted, contentHint,\nsettings and constraints survive transferring an audio and a video track,\nthat the transferred-from track ends synchronously without an ended event,\nand that transferring an ended track yields an ended track. Also adds the\nworker helpers shared by the transfer tests.\n\nFirefox does not implement transferable MediaStreamTrack and fails all\ntests. Chrome exposes MediaStreamTrack only on Window and fails them too.\nSafari exposes MediaStreamTrack in dedicated workers and is the only browser\nexpected to pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324145\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-attributes.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-attributes.https.html", "testing/web-platform/tests/mediacapture-extensions/support/transfer-helper.js"], "git_node": "4bb410436b8c82faf36aa9ce89e5fa10dfd3f1fd", "git_parents": ["71e2d49cb7b3bfc6e0247e7c5dd2bda0bcced83b"], "node": "212b09ae5389aa1c36483a95d5cb9186d6af747e", "parents": ["3fabf262cbd03a5e8fc63efe129b6d617c903082"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for structured cloning and same-realm transfer of MediaStreamTrack. r=webrtc-reviewers,bwc\n\nUses structuredClone() so that the serialization rules are tested without a\nworker. Covers that serializing a MediaStreamTrack without transferring it\nthrows DataCloneError and leaves the track intact, that a duplicate transfer\nlist entry throws, that transferring within the same realm yields a live\ntrack with the same id and detaches the original, that transferring a\ndetached or stopped track throws, and that a track in the transfer list is\ndetached even if the value does not reference it.\n\nThe tests that expect DataCloneError without a transfer pass in every\nbrowser, since no browser serializes MediaStreamTrack. Firefox does not\nimplement transferable MediaStreamTrack and fails the tests that transfer.\nChrome fails them too. Safari is the only browser expected to pass them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324146\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStreamTrack-structured-clone.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStreamTrack-structured-clone.https.html"], "git_node": "39636f5bdd20d6405cb5669ed609ad53773f20a3", "git_parents": ["4bb410436b8c82faf36aa9ce89e5fa10dfd3f1fd"], "node": "4c6807712c2112786255b6ee6f27a0ab679e7369", "parents": ["212b09ae5389aa1c36483a95d5cb9186d6af747e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for source lifetime of a MediaStreamTrack transferred to a dedicated worker. r=webrtc-reviewers,bwc\n\nCovers that stopping the original track does not end a clone transferred to\na worker, and that a track captured in an iframe and transferred to a worker\nends when the iframe is removed. The worker reads frames with\nMediaStreamTrackProcessor to show the source is still producing data.\n\nFirefox implements neither transferable MediaStreamTrack nor\nMediaStreamTrackProcessor and fails both tests. Chrome exposes both only on\nWindow and fails them too. Safari exposes both in dedicated workers and is\nthe only browser expected to pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324147\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-source-lifetime.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-source-lifetime.https.html", "testing/web-platform/tests/mediacapture-extensions/support/iframe-getUserMedia-transfer.html"], "git_node": "cae245504018bf34baa7b3bc2a7d5979c7661c00", "git_parents": ["39636f5bdd20d6405cb5669ed609ad53773f20a3"], "node": "06febfc40d9e8a49d39ccfacc4161b98f43be8b9", "parents": ["4c6807712c2112786255b6ee6f27a0ab679e7369"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for cloning and re-transferring a MediaStreamTrack in a dedicated worker. r=webrtc-reviewers,bwc\n\nCovers that a clone made in a worker has the state of the transferred track\nand survives stopping it, and that a clone transferred on to a nested worker\nsurvives stopping the track in the intermediate worker. The workers read\nframes with MediaStreamTrackProcessor to show the clones are still fed.\n\nFirefox implements neither transferable MediaStreamTrack nor\nMediaStreamTrackProcessor and fails both tests. Chrome exposes both only on\nWindow and fails them too. Safari exposes both in dedicated workers and is\nthe only browser expected to pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324148\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-clone.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-clone.https.html"], "git_node": "6f86f7ce319d68e59dcab12d5e7c1fcdf4fed68f", "git_parents": ["cae245504018bf34baa7b3bc2a7d5979c7661c00"], "node": "ec4c6fc717e68b62a99bf4a6766fa6c3b0da68bf", "parents": ["06febfc40d9e8a49d39ccfacc4161b98f43be8b9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for mute propagation to a MediaStreamTrack transferred to a dedicated worker. r=webrtc-reviewers,bwc\n\nA VideoTrackGenerator in one worker is the source. Its track is transferred\nto the page and on to a second worker, and muting and unmuting the generator\nmust be reflected in the muted attribute and mute/unmute events of the track\nat each step.\n\nFirefox implements neither transferable MediaStreamTrack nor\nVideoTrackGenerator and fails the test. Chrome has no VideoTrackGenerator\nand exposes MediaStreamTrack only on Window, so it fails too. Safari exposes\nboth in dedicated workers and is the only browser expected to pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324149\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-mute.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-mute.https.html"], "git_node": "453274a2dc23bb90e4e4d9565b27a1bf95e25934", "git_parents": ["6f86f7ce319d68e59dcab12d5e7c1fcdf4fed68f"], "node": "254daef4690abbcb5f9b59544ba3f4cfb0aacb11", "parents": ["ec4c6fc717e68b62a99bf4a6766fa6c3b0da68bf"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for keeping a MediaStreamTrack source alive during transfer to a dedicated worker. r=webrtc-reviewers,bwc\n\nCovers that stopping the last remaining track of a source in the page while\na transfer of another track of it is in flight does not end the transferred\ntrack. The worker reads a frame with MediaStreamTrackProcessor to show the\nsource keeps producing data.\n\nFirefox implements neither transferable MediaStreamTrack nor\nMediaStreamTrackProcessor and fails the test. Chrome exposes both only on\nWindow and fails it too. Safari exposes both in dedicated workers and is the\nonly browser expected to pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324150\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-data-holder.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-data-holder.https.html"], "git_node": "2f5c0e3465de06b95ac64a87304cc8f76f260f8d", "git_parents": ["453274a2dc23bb90e4e4d9565b27a1bf95e25934"], "node": "760139847966f85ca62ddc1ec3a988a5e0f39ead", "parents": ["254daef4690abbcb5f9b59544ba3f4cfb0aacb11"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for MediaStream in a dedicated worker. r=webrtc-reviewers,ng\n\nCovers that MediaStream, MediaStreamTrack and MediaStreamTrackEvent are\nexposed in a dedicated worker, and that MediaStream can be constructed\nempty, from transferred tracks and from another MediaStream. getTrackById(),\naddTrack(), removeTrack(), clone(), the MediaStreamTrackEvent constructor and\nthe active attribute each have their own test so that a failure in one does\nnot hide the others.\n\nNo browser exposes MediaStream in dedicated workers: Firefox, Chrome and\nSafari all fail every test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324151\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStream-in-dedicated-worker.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStream-in-dedicated-worker.https.html"], "git_node": "e955ac98e574b7b1cd91a783e44bdef800603802", "git_parents": ["2f5c0e3465de06b95ac64a87304cc8f76f260f8d"], "node": "408da8cfda2a53f70fe568f3f396f914b5420af3", "parents": ["760139847966f85ca62ddc1ec3a988a5e0f39ead"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070014 - Add WPT for tearing down a dedicated worker holding a transferred MediaStreamTrack. r=webrtc-reviewers,bwc\n\nCovers terminate() and self.close() with a live transferred track, a\ntransfer in flight, a clone made in the worker, and a worker holding the\nonly track of a source. In each case the tracks left in the page must stay\nlive and keep receiving frames.\n\nFirefox does not implement transferable MediaStreamTrack and fails all\ntests. Chrome exposes MediaStreamTrack only on Window and fails them too.\nSafari exposes MediaStreamTrack in dedicated workers and is the only browser\nexpected to pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326045\n", "files": ["testing/web-platform/meta/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-teardown.https.html.ini", "testing/web-platform/tests/mediacapture-extensions/MediaStreamTrack-transfer-to-worker-teardown.https.html"], "git_node": "f8b2f72c578c828b3c37336b1e7e302d865099e9", "git_parents": ["e955ac98e574b7b1cd91a783e44bdef800603802"], "node": "4f63d45ddf049227d762e02cdbefe303a9916545", "parents": ["408da8cfda2a53f70fe568f3f396f914b5420af3"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2071108 - pt1. Remove unused bailout return address tracking in Baseline Interpreter/ICs r=jandem,iain\n\nNow that bailout rebuilds baseline frames using actual calls within bailout stubs, the\nreturn address of these calls are not directly required.\n\n- Remove bailout return address storage/retrieval from the Baseline Interpreter and Fallback ICs\n- BaselineStackBuilder now uses nullptr for the manually constructed bailout stack frames.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326701\n", "files": ["js/src/jit/BaselineBailouts.cpp", "js/src/jit/BaselineIC.cpp", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h", "js/src/jit/JitRuntime.h"], "git_node": "51aec7b9b79727ed345cc0a0290a626fca4d78c9", "git_parents": ["f8b2f72c578c828b3c37336b1e7e302d865099e9"], "node": "df43fed9c098de85ed7e4b5178991cff2b6cd5da", "parents": ["4f63d45ddf049227d762e02cdbefe303a9916545"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2071108 - pt2. Cleanup baseline interpreter storage/usage of bailout stub offsets r=jandem,iain\n\n- Rename the types and fields used in the Baseline Interpreter and it's code generation handler\nto clarify that the stored value is the bailout stub offset and not the return address offset.\n- Addded a new field to temporarily store the IC return offset for the brief period between it's\nemission and usage when the corresponding bailout stub is emitted.\n- This also moves the creation of the actual ICBailoutStubOffsetVector entry from emitNextIC to\nemitICBailoutStub.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326702\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h"], "git_node": "65493b504697401e9d148f3a36e4209a5f3eb946", "git_parents": ["51aec7b9b79727ed345cc0a0290a626fca4d78c9"], "node": "c9c81a016b3e2dcb985e6082d9aef03ed3e5506a", "parents": ["df43fed9c098de85ed7e4b5178991cff2b6cd5da"], "tags": []}, {"author": "Nikolas Wipper \u003cnwipper@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048600 - Add KEK migration, password change and existence probes to lockstore. r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305573\n", "files": ["security/lockstore/LockstoreService.cpp", "security/lockstore/LockstoreService.h", "security/lockstore/lockstore_ffi/src/lib.rs", "security/lockstore/lockstore_rs/src/keystore.rs", "security/lockstore/lockstore_rs/tests/keystore_tests.rs", "security/lockstore/nsILockstore.idl", "security/lockstore/tests/unit/test_nsILockstore.js"], "git_node": "bb50a7b42be7b1a714cc04091c82e04bfec162fe", "git_parents": ["65493b504697401e9d148f3a36e4209a5f3eb946"], "node": "4e466905651004b331094305bb69ba9f8761cf6f", "parents": ["c9c81a016b3e2dcb985e6082d9aef03ed3e5506a"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046415: Add get_dek_automatic to key store r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305918\n", "files": ["security/lockstore/LockstoreService.cpp", "security/lockstore/LockstoreService.h", "security/lockstore/gtest/TestLockstoreKeystore.cpp", "security/lockstore/lockstore_ffi/src/lib.rs", "security/lockstore/lockstore_rs/src/keystore.rs", "security/lockstore/lockstore_rs/tests/keystore_tests.rs", "security/lockstore/nsILockstore.idl"], "git_node": "f1f3dc4261b8455977754edc8292fe13fc2c37eb", "git_parents": ["bb50a7b42be7b1a714cc04091c82e04bfec162fe"], "node": "47c54b675be4c5b317a5a808bcb122069b6d876d", "parents": ["4e466905651004b331094305bb69ba9f8761cf6f"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2014283 - Part 1: Pass the referrer as a JS::Value in the module loading hooks. r=jonco,arai\n\nIn the host layer, the referrer is used to get the following information:\n- Get the ScriptFetchInfo and use it to resolve a module specifier.\n- To get the [[LoadedModules]] slot for module referrer in\n  FinishLoadingImportedModule.\n\nThis patch fixes the crash by using a JS::Value to represent the referrer's\ninformation in classic scripts and module scripts.\n\nThe host layer stores this value in the ModuleLoadRequest and passes it back\nunchanged to FinishLoadingImportedModule, which resolves the module record of\nthe referrer itself.\n\nAlso add:\nA JS::GetReferrerPrivate JSAPI to get the script/module private value\nfrom a JS::Value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326168\n", "files": ["js/loader/ModuleLoadRequest.cpp", "js/loader/ModuleLoadRequest.h", "js/loader/ModuleLoaderBase.cpp", "js/loader/ModuleLoaderBase.h", "js/public/Modules.h", "js/public/ScriptPrivate.h", "js/src/jsapi.cpp", "js/src/shell/ModuleLoader.cpp", "js/src/shell/ModuleLoader.h", "js/src/vm/Modules.cpp", "js/src/vm/Modules.h"], "git_node": "677038febb3a99797689485a264ef48d7fc03579", "git_parents": ["f1f3dc4261b8455977754edc8292fe13fc2c37eb"], "node": "69398b12e61a958f17b084bb60454400ecbb21e2", "parents": ["47c54b675be4c5b317a5a808bcb122069b6d876d"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2014283 - Part 2: Remove the unused referrer from DynamicImportContextObject. r=jonco\n\nThe referrer is only used in FinishLoadingImporteModule but not in\nContinueDynamicImport.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326170\n", "files": ["js/src/vm/Modules.cpp"], "git_node": "0431952c8cbf531c22b2495271d8dbc5cf4b1422", "git_parents": ["677038febb3a99797689485a264ef48d7fc03579"], "node": "095de68d7eea7ddf391af1e579c321710885c3da", "parents": ["69398b12e61a958f17b084bb60454400ecbb21e2"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2014283 - Part 3: Resolve the referrer of a dynamic import to its enclosing module. r=jonco,arai\n\nWhen the dynamic import is called inside a function, the |referrer| is a function\nscript whose isModule() is false. This patch fixes the bug by using the module\nobject of the enclosing module scope if available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326171\n", "files": ["js/src/vm/Modules.cpp"], "git_node": "8bbb4e4cb99bcc522eb09ea7a051207dbc6c20ad", "git_parents": ["0431952c8cbf531c22b2495271d8dbc5cf4b1422"], "node": "a7cd1a0148cd3bd73c8a009892bbb39e417c0f3f", "parents": ["095de68d7eea7ddf391af1e579c321710885c3da"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2014283 - Part 4: Add getModuleLoadedModules to access module.[[LoadedModules]] in the js shell. r=jonco\n\nAdd |getModuleLoadedModules()| util function to verify the\nmodule.[[LoadedModules]] is updated correctly in the previous patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326172\n", "files": ["js/src/jit-test/modules/dynamic-import-function-referrer.js", "js/src/jit-test/tests/modules/bug-2014283.js", "js/src/shell/js.cpp"], "git_node": "de2ba167c1886be75b917ab7890d18982cd2b33f", "git_parents": ["8bbb4e4cb99bcc522eb09ea7a051207dbc6c20ad"], "node": "5a489af3326b23d2f0ed99715c55184290d431a3", "parents": ["a7cd1a0148cd3bd73c8a009892bbb39e417c0f3f"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2014283 - Part 5: A mochitest-plain test to call import() in a relazifiable function script. r=jonco,arai\n\nTo reproduce the problem that the referrer script may be relazified before the\nimport() completes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326173\n", "files": ["dom/base/test/jsmodules/mochitest.toml", "dom/base/test/jsmodules/test_dynamicImportRelazify.html"], "git_node": "56f7c2706378058cfc4152d0fe5c45783d647e1d", "git_parents": ["de2ba167c1886be75b917ab7890d18982cd2b33f"], "node": "dd7083648e267b59f3c5ad665c2b29fc414895fe", "parents": ["5a489af3326b23d2f0ed99715c55184290d431a3"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072884 - Update android nightly application-services version bump to c38af630689eb664f89ac932f48b48e026498778 r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326838\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "e60a61589746fc938c468ea3d77ba8aecec1b13b", "git_parents": ["56f7c2706378058cfc4152d0fe5c45783d647e1d"], "node": "7b81beb7bf5689f439b3a29fd2bd7b61fb4f7247", "parents": ["dd7083648e267b59f3c5ad665c2b29fc414895fe"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070927 - Fix web platform tests with corner-shape pref enabled. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326849\n", "files": ["testing/web-platform/meta/css/css-backgrounds/__dir__.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-corner-shape.htm