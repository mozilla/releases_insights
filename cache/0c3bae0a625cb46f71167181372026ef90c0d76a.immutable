0f39fb371350a61c024c37017c35563327e", "e38860eabc8a4f0b74b0fcf99c42646fd538cc9a", "49446aacc446c00cac59bf2b267d76b12360f365", "2b7d1cb9f258d62dd9e38807417e144bdc237b63", "b44de16b5a8a662c63033d691da179175974be49", "2a4e7c7612dc20ca2dc3465bb2dac57e2e903208", "90f4000cea42bad814d8411134f2b83694698a09", "d9a76c0abc6667c48e400457ef3e74460b746938", "284673c8beb4e8366aeef8eeaf751218cc923084", "3531a0ae7698c93e98a60074dfee8cc8dad04e4d", "63573011ef08f5df6a990af1484ba7f33a6a9c69", "e710fe54a144ec24a53c7f9aa8118580afbcf63f", "9219bc7aff2d3eaea3640f831ece89892f4fe058", "6702fe8845e33e3be58aa9ce63de96b07a93063c", "3b3efab098cc753c2df2dfa08b462896bc6e95b9", "fa6169d39402fa75cbc73b998fee9cd52c759c91", "6e53ae674369cdf83068ff45d0c946aeb950f4e3", "3047a5371f05d8e7238c91fdea0ece3c28f42acd", "ebb9a2ea1b2c3bad82706b0edb157e535bbde7d1", "e76388574099a2feacdcac8ff9c638b0e02061fc", "f656cc02e24cd64d6b51046791ee2d7d1f0f9b40", "4db73aad6ac97b36f5bd8ac6473b9d2abb413632", "0cd7647f066f731b58dbc113a6a0729e5fca091e", "e6845ae51034d1abf078a15783af05bdc511d404", "9f778234bdcdb652c9d334942c73aec3ecd5143f", "4cc0614c93b085b7d7d8744f61c4497c0bbb908b", "747ccfbb921277ae30d94a1ebf134ee1dfdf23f6", "f8d5ce6a7f8c96b9d6d33a4cdd796c319bfcd5b8", "96544a44265659737f532626d597e7d9361a948a", "4f82f002f356cfe26ce034246297a6e43761cd10", "5a48448d4a0d6e3692c39ebf8ba8dc1ac272153b", "86142171c1dc19e2919fb01d5847e7703fbe85d9", "b8ca3294ecb703472f4297d0f90664180d6bcfa9", "1db6d8c8155ea06a3a206440c7792d2bc603760a", "8c202d009b01a5064e2e09ecb65b790ef7a9fac9"], "user": "csabou@mozilla.com"}, "45388": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050211: apply code formatting via Lando\" for causing multiple reftests failures\n\nThis reverts commit 18be802fc4cf3cc32f5e78e09c93baf71a724c74.\n\nRevert \"Bug 2050211 - Honour shape-rendering: crispEdges for WebRender SVG rects. r=firefox-svg-reviewers,longsonr\"\n\nThis reverts commit 8947db015ab946ec825e7484031a52ba8d1d8052.\n\nRevert \"Bug 2050211 - Quantize reference frame origins in device space, not local space. r=gw\"\n\nThis reverts commit 877720c5c24a1defdd2c02e9146727b97e980781.\n\nRevert \"Bug 2050211 - Add a wrench test. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit e19a8107bca95be9abbc56f18a400e10c684fdda.\n\nRevert \"Bug 2050211 - Dont't snap anti-aliased primitives. r=gw\"\n\nThis reverts commit 6b3e7f49dd35932f228f4707e32590a82952fc4e.\n\nRevert \"Bug 2050211 - Wire up AA for primitives that have the ANTIALIASING flag. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit ff02306a5c15d8fdaef0d8b59c690b5d30fbd034.\n\nRevert \"Bug 2050211 - Make test 1780191-1.svg not rely on WebRender's incorrect snapping of SVG rectangles. r-#gfx-reviewers r=layout-reviewers,tnikkel\"\n\nThis reverts commit 65bf38606968dbf9c1ab4e4f3dfc5ab01e83d248.\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/space.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/wrench/reftests/snap/antialiased-ref.png", "gfx/wr/wrench/reftests/snap/antialiased.yaml", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled-ref.yaml", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled.yaml", "gfx/wr/wrench/reftests/snap/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs", "layout/reftests/bugs/1780191-1-ref.svg", "layout/reftests/bugs/1780191-1.svg", "layout/reftests/bugs/reftest.list", "layout/svg/SVGGeometryFrame.cpp", "testing/web-platform/meta/css/CSS2/floats-clear/float-replaced-height-006.xht.ini", "testing/web-platform/meta/css/CSS2/floats-clear/float-replaced-width-007.xht.ini", "testing/web-platform/meta/css/CSS2/floats-clear/float-replaced-width-008.xht.ini", "testing/web-platform/meta/css/CSS2/floats-clear/float-replaced-width-009.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/block-replaced-height-006.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/block-replaced-width-002.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-block-replaced-height-006.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-block-replaced-height-009.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-block-replaced-width-002.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-block-replaced-width-003.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-block-replaced-width-007.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-block-replaced-width-008.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-replaced-height-006.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-replaced-height-009.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-replaced-width-002.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-replaced-width-003.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-replaced-width-008.xht.ini", "testing/web-platform/meta/css/CSS2/normal-flow/inline-replaced-width-009.xht.ini", "testing/web-platform/meta/css/compositing/mix-blend-mode/mix-blend-mode-svg.html.ini", "testing/web-platform/meta/css/css-flexbox/svg-no-natural-size-grandchild.html.ini", "testing/web-platform/meta/css/css-flexbox/svg-root-as-flex-item-001.html.ini", "testing/web-platform/meta/css/css-flexbox/svg-root-as-flex-item-002.html.ini", "testing/web-platform/meta/css/css-flexbox/svg-root-as-flex-item-003.html.ini", "testing/web-platform/meta/css/css-flexbox/svg-root-as-flex-item-004.html.ini", "testing/web-platform/meta/css/css-flexbox/svg-root-as-flex-item-005.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-001e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-001o.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002o.html.ini", "testing/web-platform/meta/css/css-sizing/intrinsic-ratio-replaced-box-sizing.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-001.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-002.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-003.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-004.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-006.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-007.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-008.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-009.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-010.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-011.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-012.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-013.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-014.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-015.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-016.html.ini", "testing/web-platform/meta/css/css-transforms/scale/svg-scale-017.html.ini", "testing/web-platform/meta/css/css-transforms/skewX/svg-skewx-001.html.ini", "testing/web-platform/meta/css/css-transforms/skewX/svg-skewx-006.html.ini", "testing/web-platform/meta/css/css-transforms/skewX/svg-skewx-011.html.ini", "testing/web-platform/meta/css/css-transforms/skewX/svg-skewx-016.html.ini", "testing/web-platform/meta/css/css-transforms/skewX/svg-skewx-021.html.ini", "testing/web-platform/meta/css/css-transforms/skewX/svg-skewx-with-units.html.ini", "testing/web-platform/meta/css/css-transforms/skewX/svg-skewxy-001.html.ini", "testing/web-platform/meta/css/css-transforms/skewY/svg-skewy-001.html.ini", "testing/web-platform/meta/css/css-transforms/skewY/svg-skewy-006.html.ini", "testing/web-platform/meta/css/css-transforms/skewY/svg-skewy-011.html.ini", "testing/web-platform/meta/css/css-transforms/skewY/svg-skewy-016.html.ini", "testing/web-platform/meta/css/css-transforms/skewY/svg-skewy-021.html.ini", "testing/web-platform/meta/css/css-transforms/skewY/svg-skewy-with-units.html.ini", "testing/web-platform/meta/css/css-transforms/transform-percent-010.html.ini", "testing/web-platform/meta/css/filter-effects/fecolormatrix-special-value.html.ini", "testing/web-platform/meta/css/filter-effects/svg-filter-filter-units-user-space.html.ini", "testing/web-platform/meta/svg/extensibility/foreignObject/will-change-in-transformed-foreign-object.html.ini", "testing/web-platform/meta/svg/painting/inline-svg-resize-viewport-dependent-mask.html.ini", "testing/web-platform/meta/svg/painting/inner-outer-svg-overflow-auto.html.ini"], "git_node": "f43efb2ceb35d485f7d7b8b884a9e1ba3053a7bb", "git_parents": ["8c202d009b01a5064e2e09ecb65b790ef7a9fac9"], "node": "c0c404da9583a36f2fd16c206a623e3009def531", "parents": ["3c52ef3a58466057a21802189895aada258c0fc7"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074273 - Do not upload at all any ohttp-requiring pings that don't satisfy the no-_info-sections rule r=tcampbell,TravisLong,android-reviewers\n\nWith the second commit in this stack and bug 2074263, pings like this\nare forbidden from existing.\nThis catches pending pings that are on disk and as-yet-unuploaded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327927\n", "files": ["toolkit/components/glean/src/init/viaduct_uploader.rs"], "git_node": "b4c7167b179fd9c4fad9ab9e4e0b9d00e3e65752", "git_parents": ["f43efb2ceb35d485f7d7b8b884a9e1ba3053a7bb"], "node": "f61eb8dc8317fdf790a6d31e1e50d48d69a4caa3", "parents": ["c0c404da9583a36f2fd16c206a623e3009def531"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074273 - Do not include _info sections in pings uploaded over OHTTP r=tcampbell,TravisLong,android-reviewers\n\nThe included lint only catches Firefox Desktop pings.\nFenix and others will get it in bug 2074263.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327928\n", "files": ["browser/components/urlbar/pings.yaml", "mobile/android/fenix/app/pings.yaml", "toolkit/components/glean/build_scripts/glean_parser_ext/run_glean_parser.py"], "git_node": "270f33501017a3286a0baf31c440520551f2adcc", "git_parents": ["b4c7167b179fd9c4fad9ab9e4e0b9d00e3e65752"], "node": "8f824662c46e9c009dc6a03bfe1806a4259e2188", "parents": ["f61eb8dc8317fdf790a6d31e1e50d48d69a4caa3"], "tags": []}], "date": 1790111622, "git_changesets": ["f43efb2ceb35d485f7d7b8b884a9e1ba3053a7bb", "b4c7167b179fd9c4fad9ab9e4e0b9d00e3e65752", "270f33501017a3286a0baf31c440520551f2adcc"], "user": "csabou@mozilla.com"}, "45389": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 365ff2bc5b79267ca93cfdbbc1d07af5e2bbd120 with FIREFOX_115_42_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0d5f523f35d0c9330c539ee57542aba1ba7263b9", "git_parents": ["158e5076b88609556edd6cbe5580a1d3062d7b01"], "node": "c73ed037d82565b4b9449f9272591256b0cd6d50", "parents": ["c852acf37d964d2bd28a222fbb9982ed0c600649"], "tags": []}], "date": 1790116820, "git_changesets": ["0d5f523f35d0c9330c539ee57542aba1ba7263b9"], "user": "ffxbld@lando.moz.tools"}, "45390": {"changesets": [{"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065228 - remove `hidden` features from session state r=sfoster\n\nDuring manual session restore, only use existing windows that can be modified to match the restoring window. In particular, we will no longer convert popup windows into normal windows and vice versa.\n\nThis will lead in some cases to opening one more window than we used to on manual session restore.\n\nAfter bug 2060396 and bug 2064683, the only hideable element left is the toolbar, but it can only be hidden at window creation time. It's no longer possible to change the visibility of chrome elements in existing windows via bar properties.\n\nWe already store `isPopup` on window state and the value is determined by toolbar visibility.\n\nThis means that each window's `hidden` string no longer does anything and no longer stores any unique information.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322711\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/session.schema.json", "browser/components/sessionstore/test/browser_354894_perwindowpb.js", "browser/components/sessionstore/test/browser_495495.js", "browser/components/sessionstore/test/browser_597071.js", "browser/components/sessionstore/test/browser_oldformat.toml", "browser/components/sessionstore/test/browser_restored_window_features.js", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_close_last_nonpopup_window.py", "browser/components/sessionstore/test/marionette/test_restore_last_session_window_mismatch.py"], "git_node": "c89a5e061f6ea7bdb593cec1e373e8ab9ba7c6b0", "git_parents": ["8c202d009b01a5064e2e09ecb65b790ef7a9fac9"], "node": "3fcfe64f5820cba0bda74690cf94790f01541f54", "parents": ["3c52ef3a58466057a21802189895aada258c0fc7"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066315 - store and restore window arguments r=pdahiya,sfoster\n\nStore the `web-extension-popup-window` and `chromeless-window` window arguments on corresponding windows' state and restore windows with those arguments. This fixes a recently introduced issue where restoring a previous session could result in an add-on popup window or chromeless popup window that incorrectly show their URL bars.\n\nBug 2064683 removed the `CHROME_LOCATIONBAR` chrome flag and related CSS rules that hide the URL bar on some windows. The patch replaced the specific `location` window feature with more targeted use-based window arguments.\n\n`web-extension-popup-window` applies to popup windows opened by WebExtensions/add-ons.\n\n`chromeless-window` applies to popup windows that request to be chromeless, all of which seem to come from the Messaging system at this time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322713\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/session.schema.json", "browser/components/sessionstore/test/browser_restored_window_features.js", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_restore_last_session_window_mismatch.py"], "git_node": "32f6b0db1b6831fcd9de985fd506dac113b1d2a1", "git_parents": ["c89a5e061f6ea7bdb593cec1e373e8ab9ba7c6b0"], "node": "3425d9fec3118d7b017e56065fe7f80e46a1c4d2", "parents": ["3fcfe64f5820cba0bda74690cf94790f01541f54"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070404 - add telemetry about restoring into mismatched windows r=sfoster\n\nThis patch records when SessionRestore.#restoreWindows was asked to restore state into a window that has immutable window features. In these cases, affected windows won't be fully restored to the desired state, so there may be bugs or other issues that result. This patch only provides a warning log and records the window features so that we can learn more about any code paths or window features need to be updated before we can fully prevent SessionStore from reusing unsuitable windows.\n\nAfter bug 2060396 and bug 2064683, it's no longer possible to change some window features on existing windows. Manual session restore (\"restore last session\") has long had additional logic to avoid unsuitable existing windows to restore into, and the previous patch in this stack hardens that code.\n\nHowever, that code path is separate from the general \"restore windows\" path. The \"restore windows\" path seems like it has guaranteed to callers that SessionStore will make a window fully conform to a session state. Even though we can't guarantee that anymore, I'm reluctant to make a broad change here because I don't fully understand all of the potential impacts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322712\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_window_features_mismatch_telemetry.js", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_automatic_startup_window_features_mismatch.py", "browser/components/sessionstore/test/marionette/test_automatic_with_taskbar_tab_window_features_mismatch.py", "browser/components/sessionstore/test/marionette/test_deferred_initial_state_window_features_mismatch.py", "browser/components/sessionstore/test/marionette/test_new_tab_on_restore.py", "browser/components/sessionstore/test/marionette/test_restore_last_session_window_mismatch.py", "browser/components/sessionstore/test/marionette/test_set_browser_state_window_features_mismatch.py"], "git_node": "a80e754e53b30836212c0695060e352541c1df8d", "git_parents": ["32f6b0db1b6831fcd9de985fd506dac113b1d2a1"], "node": "e8d1e15ed085278bbe59779834623196713fa8cc", "parents": ["3425d9fec3118d7b017e56065fe7f80e46a1c4d2"], "tags": []}, {"author": "halemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069479 - Add the special message actions that toggle closed-browser notifications. r=omc-reviewers,sachung\n\nENABLE_CLOSED_BROWSER_NOTIFICATIONS and DISABLE_CLOSED_BROWSER_NOTIFICATIONS\nwrite the user-owned pref through PushNotificationHelper.setEnabled(), so the\ninfobar's opt-out never touches the pref Nimbus set and never unenrolls the\nuser.\n\nPushNotificationHelper is only packaged on Windows, so both actions go through\na guard that makes them a no-op elsewhere, the same way setBrowserIcon handles\nCustomIconManager.\n\nOnly the enabling action joins ALLOWED_ACTION_MESSAGE_ACTIONS: an action_only\nmessage turns the feature on for eligible clients, while the disabling action\nis only ever fired from UI the user clicked.\n\nmessaging-surfaces.md no longer repeats the allowlist inline. That copy had\nalready gone stale, so it now points at ALLOWED_ACTION_MESSAGE_ACTIONS instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326191\n", "files": ["browser/components/asrouter/docs/messaging-surfaces.md", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/lib/test/unit/test_MessagingSystemBlocklists.js", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_closed_browser_notifications.js"], "git_node": "e73bfb2d636af44d47f45792634e0d861cf830ed", "git_parents": ["a80e754e53b30836212c0695060e352541c1df8d"], "node": "735ad35d547b3cff3cfb02686f8b1da684f21e67", "parents": ["e8d1e15ed085278bbe59779834623196713fa8cc"], "tags": []}, {"author": "Markus Stange \u