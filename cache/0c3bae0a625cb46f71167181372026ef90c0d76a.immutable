sts/webvtt/rendering/cues-with-video/processing-model/2_cues_overlapping_partially_move_up-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/2_cues_overlapping_partially_move_up.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/2_tracks-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/2_tracks.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/3_tracks-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/3_tracks.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/align_center-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/align_center.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/align_center_position_50-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/align_center_position_50.html"], "git_node": "5140b835d15f34b488e4011ae36549028251f7f5", "git_parents": ["752bbe45b6dcd91158ed29fc2490c0b02f3dfb21"], "node": "9d2df4d420e975edb46424b738435aa220ce414d", "parents": ["aa5d046168e7d4426f1a5aabe5fc5ac3a95608b8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056969 [wpt PR 61482] - Update wpt metadata, a=testonly\n\nwpt-pr: 61482\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/2_cues_overlapping_completely_move_up.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/2_tracks.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/3_tracks.html.ini"], "git_node": "d30d2453fee0e5b64e8ff504ff81c74db6a135d2", "git_parents": ["5140b835d15f34b488e4011ae36549028251f7f5"], "node": "60a1bbccb08abf52feb0800fef0ce2d8f9a7710f", "parents": ["9d2df4d420e975edb46424b738435aa220ce414d"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070209 [wpt PR 62463] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323401, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=323401 (#62463)\n--\n\nwpt-commits: d317428a65e0312e0a199d5db69591e252431dfe\nwpt-pr: 62463\n", "files": ["testing/web-platform/tests/service-workers/cache-storage/cache-delete.https.any.js", "testing/web-platform/tests/service-workers/cache-storage/cache-keys.https.any.js"], "git_node": "aeecddbcef76cce1043931493e786dad8c62208f", "git_parents": ["d30d2453fee0e5b64e8ff504ff81c74db6a135d2"], "node": "217993a0a13f110157e3bb1c091edceafa836240", "parents": ["60a1bbccb08abf52feb0800fef0ce2d8f9a7710f"], "tags": []}, {"author": "Alison Maher \u003calmaher@microsoft.com\u003e", "branch": "default", "desc": "Bug 2070215 [wpt PR 62461] - [Masonry] Support fragmented column spanners, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Support fragmented column spanners\n\nColumn grid-lanes fragmentation previously walked each lane\nindependently. A spanner could therefore be visited before earlier items\nin all of its occupied lanes had been processed, or be treated as\nunstarted again after resuming from a child break token. Breaks inside a\nspanner also only blocked its start lane, allowing later content from\nanother occupied lane into the current fragmentainer.\n\nMake the iterator defer column spanners until all preceding items across\ntheir span have been visited. Resumed spanners advance each occupied\nlane past its shared entry, and a fragmented spanner defers later\ncontent in its complete span. Row spanners will be handled in a follow\nup.\n\nThere is a new crashing test, but this should be fixed once we support\nbreak rule handling in grid lanes.\n\nBug: 343257585\nChange-Id: I36ab0ecaa1eb8d2cb70062609cb2bd8f3112def3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8349061\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1692557}\n\n--\n\nwpt-commits: c9b23530118915a2eaa34cbe9c33fc3fefb7ae41\nwpt-pr: 62461\n", "files": ["testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-006.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-007.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-008.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-009.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-010.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-011.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-012.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-013.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-014.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/grid-lanes-fragmentation-002.html"], "git_node": "5350791dff98d950e4a0696bde94c68454a55f76", "git_parents": ["aeecddbcef76cce1043931493e786dad8c62208f"], "node": "0860eb94d20b62ac40ceb18f70c29a5e452c2953", "parents": ["217993a0a13f110157e3bb1c091edceafa836240"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070215 [wpt PR 62461] - Update wpt metadata, a=testonly\n\nwpt-pr: 62461\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-006.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-007.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-008.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-009.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-010.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-011.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-012.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-014.html.ini"], "git_node": "6aa9af5558a28b780342d3ed0b2eed54e51f9599", "git_parents": ["5350791dff98d950e4a0696bde94c68454a55f76"], "node": "0699b114026d8feaa8842b3e17b5f635b2b11164", "parents": ["0860eb94d20b62ac40ceb18f70c29a5e452c2953"], "tags": []}, {"author": "Yanling Wang \u003cyanlingwang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2070219 [wpt PR 62471] - [Masonry] Fix intrinsic size of empty row containers, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Fix intrinsic size of empty row containers\n\nAvoid counting border, scrollbar, and padding twice when computing\nintrinsic inline size for an empty row direction grid-lanes container.\n\nBug: 343257585\nChange-Id: I6086a4ffc8c26d6f2dae1da0c0a01ea9cd4f5968\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8351020\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1692564}\n\n--\n\nwpt-commits: 6f9e382f6be798771268d70f1c3c04dc42072e0b\nwpt-pr: 62471\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/intrinsic-sizing/grid-lanes-contain-intrinsic-size-row-004-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/row-empty-grid-lanes-container-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/row-empty-grid-lanes-container-003.html"], "git_node": "6248825b574cf6b8eca6fb1cca70bcc8a927cdf4", "git_parents": ["6aa9af5558a28b780342d3ed0b2eed54e51f9599"], "node": "65578e5da4b55dcc83081d5baa7429d64a155e62", "parents": ["0699b114026d8feaa8842b3e17b5f635b2b11164"], "tags": []}, {"author": "Andrew Martinez \u003c157772165+AndrewJMart@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070221 [wpt PR 62476] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323026, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=323026 (#62476)\n\nCo-authored-by: Andrew Martinez \u003camartinez55@apple.com\u003e\n--\n\nwpt-commits: d46c7643ab50d2bb3e3584ed6a5e05263fe09ab6\nwpt-pr: 62476\n", "files": ["testing/web-platform/tests/css/css-nesting/nested-declarations-cssom.html", "testing/web-platform/tests/css/css-sizing/size-shorthand-serialization.tentative.html"], "git_node": "bc3f924b76ea0282e84e59f310bd70d73218cedf", "git_parents": ["6248825b574cf6b8eca6fb1cca70bcc8a927cdf4"], "node": "2718366f00d6b3bb4ffe45106b02bdf1fbda0182", "parents": ["65578e5da4b55dcc83081d5baa7429d64a155e62"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070221 [wpt PR 62476] - Update wpt metadata, a=testonly\n\nwpt-pr: 62476\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-sizing/size-shorthand-serialization.tentative.html.ini"], "git_node": "cd3220403d5be22b638b8e162668aad8c317eddf", "git_parents": ["bc3f924b76ea0282e84e59f310bd70d73218cedf"], "node": "1a45c92361ca04b249dc62f036c0ecee8b050e2b", "parents": ["2718366f00d6b3bb4ffe45106b02bdf1fbda0182"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2070222 [wpt PR 62474] - Fuzzy matching for corner-shape tests, a=testonly\n\nAutomatic update from web-platform-tests\nFuzzy matching for corner-shape tests\n\nIncrease maxDifference to make tests match in Chrome.\n\nNumbers based on wpt.fyi results.\n\nBug: 555826997, 557075192\nChange-Id: Iada20c7b0303f6d3de3a94bd7285ae729c86c78e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8352705\nAuto-Submit: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692606}\n\n--\n\nwpt-commits: 21420d4c0d4b260cc110cbfe350eebb3395d92d7\nwpt-pr: 62474\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-notch-squircle-outset.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-superellipse-concave.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-superellipse-convex.html"], "git_node": "036e2c8eaa9d65d858f6e3dd85d5ef7afa9029a1", "git_parents": ["cd3220403d5be22b638b8e162668aad8c317eddf"], "node": "a34177464a28d7db8d239865974554a1538aa111", "parents": ["1a45c92361ca04b249dc62f036c0ecee8b050e2b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070222 [wpt PR 62474] - Update wpt metadata, a=testonly\n\nwpt-pr: 62474\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "f31b9252c02483c65af5290aa2ec3e1f906e797c", "git_parents": ["036e2c8eaa9d65d858f6e3dd85d5ef7afa9029a1"], "node": "099a84815edfcf621cde3837f500c5ee0693917d", "parents": ["a34177464a28d7db8d239865974554a1538aa111"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2070226 [wpt PR 62473] - Do not close command-invoked popovers on loss of interest, a=testonly\n\nAutomatic update from web-platform-tests\nDo not close command-invoked popovers on loss of interest\n\nWhen an invoker has both command and interest invoker attributes (e.g.\ncommandfor and interestfor), opening the popover via the command\ninvoker should not cause the popover to close when the button or\npopover subsequently loses interest.\n\nPreviously, Element::InterestLost unconditionally hid the target\npopover on loss of interest, regardless of how it was opened.\n\nThis CL introduces a PopoverInvokedVia enum to PopoverData to track how\nthe popover was invoked (kNone, kInterest, or kCommand).\nElement::InterestLost now only hides popovers that were invoked via\ninterest.\n\nIf a popover opened via interest is subsequently invoked via a command\n(such as show-popover or menu activation), its invocation status\nupgrades to kCommand and its invoker is updated so that it persists\nwhen interest is lost.\n\nFixed: 556283651\nBug: 406566432\nChange-Id: Ibf92fa4c837b9a4640b66aca6febdd1d35fb04fe\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8344388\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692665}\n\n--\n\nwpt-commits: d6328700c6601806db16fc87bfe37bf32514f972\nwpt-pr: 62473\n", "files": ["testing/web-platform/tests/html/semantics/interestfor/interestfor-command-invoker.tentative.html", "testing/web-platform/tests/html/semantics/menu/tentative/menubar-interest-command-invoker.tentative.html"], "git_node": "f1303090b253239301cf2c511b8d2d6df4da6c59", "git_parents": ["f31b9252c02483c65af5290aa2ec3e1f906e797c"], "node": "ed4bec61e2058ad2519ae0db6f183836a54f8b89", "parents": ["099a84815edfcf621cde3837f500c5ee0693917d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070226 [wpt PR 62473] - Update wpt metadata, a=testonly\n\nwpt-pr: 62473\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/interestfor/interestfor-pseudo-element-crash.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/menubar-interest-command-invoker.tentative.html.ini"], "git_node": "6eefbc2381438696c822643dbe2f17d3eba5e8f2", "git_parents": ["f1303090b253239301cf2c511b8d2d6df4da6c59"], "node": "258bc89d2c5324c657acd71410f762ff148b0668", "parents": ["ed4bec61e2058ad2519ae0db6f183836a54f8b89"], "tags": []}, {"author": "Christopher Cameron \u003cccameron@google.com\u003e", "branch": "default", "desc": "Bug 2070229 [wpt PR 62475] - Avoid precision loss when encoding linear float16 canvases, a=testonly\n\nAutomatic update from web-platform-tests\nAvoid precision loss when encoding linear float16 canvases\n\nWhen encoding images from a linear float16 canvas (using toBlob,\ntoDataURL, or convertToBlob), converting directly to 8-bit linear\nintegers produces quantization artifacts at dark values (e.g. an\nsRGB-value gradient with 256 stops will only produce 183 unique output\nvalues).\n\nAdd ImageEncoderUtils::GetColorInfoForEncoder to select an\nappropriate non-linear encoding color space (sRGB transfer function)\nwhen serializing linear float16 canvases, and ensure premultiplied alpha\nis converted to unpremultiplied alpha upfront. Include a gfx::HDRMetadata\nparameter which we can use, in the future, to select between sRGB and PQ.\n\nApply this conversion in CanvasAsyncBlobCreator and ImageDataBuffer's\nStaticBitmapImage constructor. Log a warning in ImageDataBuffer(SkPixmap)\nif callers higher in the stack have not already performed any necessary\nconversion.\n\nAdd WPT tests for toBlob, toDataURL, and convertToBlob with both JPEG\nand PNG formats across HTMLCanvasElement and OffscreenCanvas.\n\nTAG=agy\nCONV=6afb9a4e-b9e1-4c5a-9273-c80de68abad8\n\nBug: 454152417\nChange-Id: Ifb6a25195e0cb39c80cabf00fab2ee39f6db8fcf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8342747\nReviewed-by: Florin Malita \u003cfmalita@chromium.org\u003e\nCommit-Queue: ccameron chromium \u003cccameron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692722}\n\n--\n\nwpt-commits: 9b965429d81f9f0eab13f47c20c0e6a4f88c67b3\nwpt-pr: 62475\n", "files": ["testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.jpeg.linear.float.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.png.linear.float.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.jpeg.linear.float.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.png.linear.float.html", "testing/web-platform/tests/html/canvas/tools/yaml/color_space.yaml"], "git_node": "310fdf999c7f759dbef7ef6daf6eaaf87ba893c8", "git_parents": ["6eefbc2381438696c822643dbe2f17d3eba5e8f2"], "node": "2c31783f3a6bde410788d4b84bdd36f1a0f966f5", "parents": ["258bc89d2c5324c657acd71410f762ff148b0668"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070229 [wpt PR 62475] - Update wpt metadata, a=testonly\n\nwpt-pr: 62475\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.jpeg.linear.float.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.png.linear.float.html.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.jpeg.linear.float.html.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.toBlob.toDataURL.png.linear.float.html.ini"], "git_node": "0b03de0757e93ac176f039c7bb28bf50c4920fc9", "git_parents": ["310fdf999c7f759dbef7ef6daf6eaaf87ba893c8"], "node": "114bcb9adceec691838bfc618fe0234510422474", "parents": ["2c31783f3a6bde410788d4b84bdd36f1a0f966f5"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2070234 [wpt PR 62478] - [html-in-canvas] Fire paint events in reverse document order, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fire paint events in reverse document order\n\nCanvas paint events need to fire on descendant canvases before their\nancestors. The explainer has been updated to state that \"`paint` events\nfire in reverse document order, and in reverse tree order within each\ndocument\", and this patch implements this new behavior.\n\nSee: https://github.com/WICG/html-in-canvas/pull/164\n\nFixed: 556304549\nChange-Id: I3d74eedb413d862cc35c7cc3c930de1f213898b9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8351250\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692750}\n\n--\n\nwpt-commits: bffb67c057d61153a89c2a6d76fd6f6a98fd00fb\nwpt-pr: 62478\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/onpaint-iframe-post-tree-order.tentative.html"], "git_node": "99c52bbc326467c5d837c2b29e6841cdfee44da3", "git_parents": ["0b03de0757e93ac176f039c7bb28bf50c4920fc9"], "node": "a6d9b7bd24e9a706290dc6fb1a9481492e9198f3", "parents": ["114bcb9adceec691838bfc618fe0234510422474"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070234 [wpt PR 62478] - Update wpt metadata, a=testonly\n\nwpt-pr: 62478\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/onpaint-iframe-post-tree-order.tentative.html.ini"], "git_node": "9b1899ed8372379ca104c4980519edc2ba5faf37", "git_parents": ["99c52bbc326467c5d837c2b29e6841cdfee44da3"], "node": "e5aa4c79d9a2f0acad9022d93f20ca890e91bc55", "parents": ["a6d9b7bd24e9a706290dc6fb1a9481492e9198f3"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2070238 [wpt PR 62458] - Make coord-box offset-path follow corner-shape, a=testonly\n\nAutomatic update from web-platform-tests\nMake coord-box offset-path follow corner-shape\n\nApplyMotionPathTransform() built the path for offset-path: border-box\n(and other coord-box values) from a BasicShapeInset using only the\ncontaining block's border-radius, so corner-shape was ignored and the\nmotion path always traced rounded corners. Build the path from\nContouredBorderGeometry::ContouredBorder() instead, which produces the\nidentical rounded-rect path when the corner curvature is round and the\ncontoured (bevel/scoop/notch/squircle) path otherwise, matching the\npainted border contour.\n\nBug: 525581076\nChange-Id: I91ab6bf2b122397b122e3223fd7fcf44a998aac3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8346030\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nAuto-Submit: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1692754}\n\n--\n\nwpt-commits: eee69bd6491969fcbce67cf22f467ab9a5b285b1\nwpt-pr: 62458\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-offset-path-coord-box-001-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-offset-path-coord-box-001.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-offset-path-coord-box-002-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-offset-path-coord-box-002.html", "testing/web-platform/tests/css/motion/offset-path-coord-box-corner-shape.html"], "git_node": "dba344610b6e0b2a591735ebe01bd7beb8f0ec76", "git_parents": ["9b1899ed8372379ca104c4980519edc2ba5faf37"], "node": "0ff2835307b67b7dc540e891cd683a4d4c9e691c", "parents": ["e5aa4c79d9a2f0acad9022d93f20ca890e91bc55"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070238 [wpt PR 62458] - Update wpt metadata, a=testonly\n\nwpt-pr: 62458\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-offset-path-coord-box-001.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-offset-path-coord-box-002.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-zoom-overlap-extreme-values-crash.html.ini", "testing/web-platform/meta/css/motion/offset-path-coord-box-corner-shape.html.ini"], "git_node": "5db842365b9838b35830d884a80fa996f412602f", "git_parents": ["dba344610b6e0b2a591735ebe01bd7beb8f0ec76"], "node": "b308532d416bf83639b91a9b91346485c230ca23", "parents": ["0ff2835307b67b7dc540e891cd683a4d4c9e691c"], "tags": []}, {"author": "Adam Rice \u003cricea@chromium.org\u003e", "branch": "default", "desc": "Bug 2070269 [wpt PR 62454] - Add regression test for crbug.com/552159676, a=testonly\n\nAutomatic update from web-platform-tests\nAdd regression test for crbug.com/552159676\n\nAdd a web platform test that verifies that the expression `new\nWebSocket(url, undefined, {})` does not throw.\n\nThe change https://crrev.com/c/8197225 changed the behavior of this\nexpression even though it was intended to preserve existing behavior\nwhen the flag was not set. So the test is also added to the\nvirtual/stable configuration to stop the same regression happening\nagain.\n\nModify the \"protocol_array\" WebSocket handler to not crash when no\nsubprotocol is specified so that the test will still pass even with the\nWebSocketOptionBag Blink feature enabled.\n\nNo behavior change.\n\nBUG=552159676\n\nChange-Id: Id83238ada57d5d48bf21880546fa86df19a3e3c9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8317547\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Adam Rice \u003cricea@chromium.org\u003e\nReviewed-by: Nidhi Jaju \u003cnidhijaju@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692775}\n\n--\n\nwpt-commits: e207ce80ef256418e5b6b3c7f184dc427d1d8575\nwpt-pr: 62454\n", "files": ["testing/web-platform/tests/websockets/constructor/third-param-ignored.any.js", "testing/web-platform/tests/websockets/handlers/protocol_array_wsh.py"], "git_node": "c22ac0b08141862423f8901dc75fd708b3ecabf4", "git_parents": ["5db842365b9838b35830d884a80fa996f412602f"], "node": "e7ec48d54aaed2547f446c6a924b1c945d4a59e6", "parents": ["b308532d416bf83639b91a9b91346485c230ca23"], "tags": []}, {"author": "Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e", "branch": "default", "desc": "Bug 2070273 [wpt PR 62479] - [layout] Don't compute borders for sections/rows., a=testonly\n\nAutomatic update from web-platform-tests\n[layout] Don't compute borders for sections/rows.\n\nInternal table elements (rows, row groups, header/footer groups)\nshouldn't have borders on their fragments.\n\nWhen an out-of-flow positioned descendant inside a fragmented context\nqueried the containing block's fragment borders, it would contract a\npotentially 0-sized table row/section fragment by these borders,\nresulting in a negative containing block size.\n\nFixed: 514535250\nChange-Id: I04ff07e99380effdb5735b4a3e947bbf3588cf7b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8355633\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692857}\n\n--\n\nwpt-commits: b09f5cdca2bec4e3095a0dedc2e5d62102252de3\nwpt-pr: 62479\n", "files": ["testing/web-platform/tests/css/css-multicol/crashtests/oof-in-table-row.html"], "git_node": "9e2e41e11342fd7281c0b499c92e0e5fb939a459", "git_parents": ["c22ac0b08141862423f8901dc75fd708b3ecabf4"], "node": "313864b37def225265628b35d57e036144b7bbad", "parents": ["e7ec48d54aaed2547f446c6a924b1c945d4a59e6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070273 [wpt PR 62479] - Update wpt metadata, a=testonly\n\nwpt-pr: 62479\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-multicol/crashtests/add-list-item-marker.html.ini", "testing/web-platform/meta/css/css-multicol/crashtests/ancestor-toggle-spanner-remove-child.html.ini"], "git_node": "091cd6acced80f98bb0178940190384360198f8b", "git_parents": ["9e2e41e11342fd7281c0b499c92e0e5fb939a459"], "node": "127bfbf1473b6c4e975ad3cfd38c04fc5c462d40", "parents": ["313864b37def225265628b35d57e036144b7bbad"], "tags": []}, {"author": "Ho Cheung \u003chocheung@chromium.org\u003e", "branch": "default", "desc": "Bug 2070275 [wpt PR 62470] - Fix WebAssembly.Module messaging with AudioWorklet, a=testonly\n\nAutomatic update from web-platform-tests\nFix WebAssembly.Module messaging with AudioWorklet\n\nWorklets have opaque origins but share their creator's agent cluster.\nUse the creator document's origin for Chromium's additional same-origin\ncheck when an AudioWorklet message requires it only for WebAssembly\nmodules.\n\nKeep strict same-origin checks for File System Access handles, including\nmixed messages, and retain the agent-cluster check. Add WPT and unit\ncoverage for the global and processor ports and rejection cases.\n\nBug: 40210558\nChange-Id: I556705cbd7491eec71e7e6a060eada9b77ace87d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8334848\nReviewed-by: Hongchan Choi \u003chongchan@chromium.org\u003e\nCommit-Queue: Aaron Teo \u003chocheung@chromium.org\u003e\nReviewed-by: Jeremy Roman \u003cjbroman@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692867}\n\n--\n\nwpt-commits: b89af32bc8f42d678f444eb0703bca015ddcf240\nwpt-pr: 62470\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-audioworklet-interface/audioworklet-messageport-wasm.https.html", "testing/web-platform/tests/webaudio/the-audio-api/the-audioworklet-interface/processors/wasm-port-processor.js"], "git_node": "de43376305923773f4ad2c34aa8d7695313950e7", "git_parents": ["091cd6acced80f98bb0178940190384360198f8b"], "node": "8a65e72351c0f222c4a1240ebf09c78bc267fe3e", "parents": ["127bfbf1473b6c4e975ad3cfd38c04fc5c462d40"], "tags": []}, {"author": "Luke Warlow \u003clwarlow@igalia.com\u003e", "branch": "default", "desc": "Bug 2070279 [wpt PR 62424] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320463, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320463\n\n--\n\nwpt-commits: a53926ac643a128435401793216d72e11a5928d7\nwpt-pr: 62424\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-invoke-move-source-audio.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-invoke-move-source-in-div.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-invoke-move-source-in-namespace.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-invoke-move-source-not-in-document.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-invoke-move-source.html"], "git_node": "480979ff8df925a0bea469d6be155309bccbc021", "git_parents": ["de43376305923773f4ad2c34aa8d7695313950e7"], "node": "423431bf92e60caa5cffceba5479cb1704d2a651", "parents": ["8a65e72351c0f222c4a1240ebf09c78bc267fe3e"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070283 [wpt PR 62472] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322109, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=322109 (#62472)\n--\n\nwpt-commits: 671d5bcf0e06113a76f2afa2d9718bedd33e48e6\nwpt-pr: 62472\n", "files": ["t