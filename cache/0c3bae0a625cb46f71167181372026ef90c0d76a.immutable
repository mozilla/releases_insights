m/meta/css/css-overscroll-behavior/overscroll-behavior.html.ini", "testing/web-platform/meta/css/css-scroll-snap/unrelated-gesture-scroll-during-snap.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-events.https.html.ini", "testing/web-platform/meta/fetch/api/cors/cors-cookies.any.js.ini", "testing/web-platform/meta/fetch/api/crashtests/huge-fetch.any.js.ini", "testing/web-platform/meta/html/semantics/embedded-content/__dir__.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/event_canplay_noautoplay.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-appearance-button-after-text.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini", "testing/web-platform/meta/html/semantics/permission-element/usermedia/no-focus.html.ini", "testing/web-platform/meta/inert/inert-on-non-html.html.ini", "testing/web-platform/meta/largest-contentful-paint/background-image-set-image.html.ini", "testing/web-platform/meta/loading/early-hints/early-hints-response-time.h2.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/picture-in-picture/picture-in-picture-element.html.ini", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/referrer-policy/gen/srcdoc-inherit.meta/origin/img-tag.http.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-settings.https.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia.https.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio+video.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-video.https.sub.html.ini", "testing/web-platform/meta/serial/serial-disabled-by-permissions-policy.https.sub.html.ini", "testing/web-platform/meta/service-workers/service-worker/same-site-cookies.https.html.ini", "testing/web-platform/meta/storage-access-api/requestStorageAccess-same-site-iframe.sub.https.window.js.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/streams/transferable/transform-stream.html.ini", "testing/web-platform/meta/web-extensions/browser.runtime.extension.js.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/get_client_windows/get_client_windows.py.ini", "testing/web-platform/meta/webtransport/__dir__.ini"], "git_node": "cf5e6408d52ad54eb1ff263a61bf0ea9a3324377", "git_parents": ["e56a244670ab34d50d3e674a2bc7f401d253a2e6"], "node": "410dfb8ad5f5abde7c9e0387d2af2ada349a04ee", "parents": ["afd1bbb411751baf8d8f2f019617c73874dece3a"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2068764 [Linux][Vulkan Video] Reuse one VkInstance for decoder physical-device select. r=stransky,media-playback-reviewers\n\nSelectVulkanDecoderPhysicalDevice used to vkCreateInstance and\nvkDestroyInstance on every cache miss. Keep a process-wide instance\ninstead so later selects skip that cost. FFmpeg still creates its own\ninstance and device.\n\nsMutex is per-LIBAV_VER and cannot guard these statics.\nEnsureSharedVulkanInstance takes a file-local mutex and copies\ninstance and vkGetInstanceProcAddr out under it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323687\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp"], "git_node": "fbffbbbd7a2732c4c8cc18433276cdf1b00418ab", "git_parents": ["cf5e6408d52ad54eb1ff263a61bf0ea9a3324377"], "node": "1b10675a58d551c0e6bdd0a9e853ed03d7d660e3", "parents": ["410dfb8ad5f5abde7c9e0387d2af2ada349a04ee"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063316: Add tests for CheckCompatibility and download ping generation. r=nika\" for causing build bustages @TestDowngradePing.cpp.\n\nThis reverts commit 02eb3b39c996ebcdfde221060349785955af59c0.\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "9db3c5fbe79a00af4a1b420df8baee4f01a41b93", "git_parents": ["fbffbbbd7a2732c4c8cc18433276cdf1b00418ab"], "node": "c91808162ef8c68fc8292bba0092c2ae72ae7351", "parents": ["1b10675a58d551c0e6bdd0a9e853ed03d7d660e3"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: check for invalid payload length. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317971\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "de34ef291d912b6908890d9f936642676a1e647e", "git_parents": ["9db3c5fbe79a00af4a1b420df8baee4f01a41b93"], "node": "fc3f81838a4ad3716c03379444786a00cc2c9957", "parents": ["c91808162ef8c68fc8292bba0092c2ae72ae7351"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: make sure buffer storing decrypted data is not left uninitialized. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322317\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "4e58b79fcff8ee83e02034f053398c86a1e081e4", "git_parents": ["de34ef291d912b6908890d9f936642676a1e647e"], "node": "ee002b282e8d5c45436ee1512dee199b6ee0fb6d", "parents": ["fc3f81838a4ad3716c03379444786a00cc2c9957"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054736 - Quota input stream parser: decrypt the previous block when seeking on EOF so mPlainBuffer contains the expected data. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322324\n", "files": ["dom/quota/DecryptingInputStream_impl.h"], "git_node": "c879f071e8fb8bcbd9b01c3f4f8b1093568d422b", "git_parents": ["4e58b79fcff8ee83e02034f053398c86a1e081e4"], "node": "b7728fd030a97e87ee1ca0d473d3c6534c2dc144", "parents": ["ee002b282e8d5c45436ee1512dee199b6ee0fb6d"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068865 - Add the Rust credit card storage adapter r=joschmidt,credential-management-reviewers\n\nPresent the AutofillRecords credit card interface over the Application Services\nautofill Store, so it can later back FormAutofillStorage.getCreditCards().\nNothing constructs it yet.\n\nMost of that interface does not depend on the collection behind it, so it lands\nin a new RustAutofillAdapterBase and the address adapter is converted to it --\n19 of its 24 methods were identical bar the type name. Address behaviour is\nunchanged.\n\nThe number is stored encrypted with only its last four digits in the clear, so\ncc-number is a mask on read and the ciphertext is derived on write. A stored\nrecord is therefore decrypted before it can be merged from, and the merged\nrecord validated afterwards, because a number the caller did not restate\narrives from the stored side.\n\nEncrypting a mask would store it in place of the card, so #encryptNumber\nrefuses one: every path that stores a number comes through it, including the\nbulk import, which does not reach _validateRecord.\n_recordForMigrationExport refuses one too, for the direction where the\nreceiving store does the encrypting.\n\nThe encryption is interim: OSKeyStore, the same mechanism and key as the JSON\nstore's cc-number-encrypted, so no new key is introduced. The bulk half has no\ncaller until the migration in bug 2068982.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323229\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "browser/extensions/formautofill/test/unit/xpcshell.toml", "toolkit/components/formautofill/RustAutofillAdapterBase.sys.mjs", "toolkit/components/formautofill/RustAutofillAddressStorage.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs"], "git_node": "4b4f1cc5a102dbb566f49c04e29555a47c4290d2", "git_parents": ["c879f071e8fb8bcbd9b01c3f4f8b1093568d422b"], "node": "a157c2c3f1146f9888af6b9ef3a08bfd05d17d40", "parents": ["b7728fd030a97e87ee1ca0d473d3c6534c2dc144"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065267: add high confidence reduced manifests bugbug optimization r=marco,taskgraph-reviewers,ahal\n\nWe're going to want this optimization to power bugbug-driven build and test selection for reviewbot pushes, per https://github.com/mozilla/code-review/pull/3578#discussion_r3894934091\n\nSpecifically, we want reviewbot pushes to only run high confidence selections, to reduce the cost and time spent on these tasks. This may be changed later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324612\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/optimize/bugbug.py"], "git_node": "b53a70a3337ec1a10c30993256bf55c08d3d70ea", "git_parents": ["4b4f1cc5a102dbb566f49c04e29555a47c4290d2"], "node": "8d1df5fb307c10fd9e30ada27e18ab6534069b20", "parents": ["a157c2c3f1146f9888af6b9ef3a08bfd05d17d40"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1842455 - Remove the dom.webnotifications.allowcrossoriginiframe pref r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324943\n", "files": ["browser/modules/PermissionUI.sys.mjs", "dom/notification/Notification.cpp", "dom/notification/NotificationUtils.cpp", "dom/notification/test/mochitest/test_notification_crossorigin_iframe.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "764cf7b2dbd308a8a66b67e6b483ffee822c04a1", "git_parents": ["b53a70a3337ec1a10c30993256bf55c08d3d70ea"], "node": "d759abc982592cfe9cc32e02ecb89bc9715e2efc", "parents": ["8d1df5fb307c10fd9e30ada27e18ab6534069b20"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Retire the ConstraintLayout custom view warning. r=android-reviewers,mcarare\n\nThe check had two halves. The strict one counts the framework's ConstraintLayouts in a file, from a list of\ntwo names that has not needed to change. The other warned whenever a view of ours that extends\nConstraintLayout shared a file with any other one, from a list written out by hand in 2020 that had drifted\nthe way such lists do: one entry named a class that has never existed under that package, another one that\nhas since moved to Compose, and four views added since were invisible to it.\n\nFixing the list is the wrong repair, because the warning is unactionable where it fires. It points at a\nscreen for using a shared component, and the screen can do nothing about what that component extends. Every\none of its fourteen baselined findings is that shape. Where the component itself was the problem, the fix\nwas in the component, in a file the warning never pointed at. So the warning goes, and its baseline entries\nwith it.\n\nWhat is left is the strict check, unchanged, and tests for it, which it never had.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318976\n", "files": ["mobile/android/android-components/components/tooling/lint/src/main/java/mozilla/components/tooling/lint/ConstraintLayoutPerfDetector.kt", "mobile/android/android-components/components/tooling/lint/src/main/java/mozilla/components/tooling/lint/LintIssueRegistry.kt", "mobile/android/android-components/components/tooling/lint/src/test/java/mozilla/components/tooling/lint/ConstraintLayoutPerfDetectorTest.kt", "mobile/android/fenix/app/lint-baseline.xml"], "git_node": "8bd94ce184f15926fa189794b3713541b74535ca", "git_parents": ["764cf7b2dbd308a8a66b67e6b483ffee822c04a1"], "node": "c4078c09b218506721611efc921433a0f667ae05", "parents": ["d759abc982592cfe9cc32e02ecb89bc9715e2efc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Stop inflating ConstraintLayouts that nothing looks at. r=android-reviewers,mcarare\n\nTwo of the collection creation layouts are never shown. They are handed to ConstraintSet.clone(), which\ninflates the whole file, keeps the constraints, visibility and alpha of the root's direct children, and\nthrows the rest away. The bottom bar in each was written out in full, three children and all, so that a\ntransition could read one view's constraints off it. Leave the one view.\n\nThe delete browsing data row is a ConstraintLayout that inflates a ConstraintLayout into itself, so every\nrow in the list carries two of them. The layout already had the tools:parentTag that only means anything\non a merge, and the tracking protection row three files over was already written that way, so follow it.\nThe minimum height moves onto the row itself, which is where it has to live once the root it was written\non is gone.\n\nNeither changes what any of it looks like. The rows lose a view each and the two transitions lose four,\nand the check that had been reporting the collection layouts has nothing left to report there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318977\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/deletebrowsingdata/DeleteBrowsingDataItem.kt", "mobile/android/fenix/app/src/main/res/layout/component_collection_creation_name_collection.xml", "mobile/android/fenix/app/src/main/res/layout/component_collection_creation_select_collection.xml", "mobile/android/fenix/app/src/main/res/layout/delete_browsing_data_item.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/deletebrowsingdata/DeleteBrowsingDataItemTest.kt"], "git_node": "16b0d58e4ed64e46c39d29b4a9a61d5d1a63e623", "git_parents": ["8bd94ce184f15926fa189794b3713541b74535ca"], "node": "6296612460d860af96142048844733ff56e1d967", "parents": ["c4078c09b218506721611efc921433a0f667ae05"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Stop two more components inflating a second ConstraintLayout. r=android-reviewers,mcarare\n\nEach of these is a ConstraintLayout that inflates a layout rooted in a ConstraintLayout into itself, so\nevery one of them costs two where it needs one. The library row pays it on every row of every history and\nbookmarks list. Every android-components view that does this was already written as a merge; these were\nthe ones left.\n\nThe check cannot see any of this, because the two halves live in different files, so neither of these is\na finding. They are the same mistake the delete browsing data row had.\n\nThe minimum height and the background the library row's discarded root carried move onto the view, which\nmakes the two rows that were setting the same minimum height themselves redundant.\n\nThe crash reporter has the same mistake and keeps it. Binding against a merge means binding against the\nview itself rather than against a root of its own, and its tests hand it a copy of itself, which then has\nnothing to find. It inflates once, when a tab crashes, so it is not worth the surgery.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318978\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/LibrarySiteItemView.kt", "mobile/android/fenix/app/src/main/res/layout/history_list_item.xml", "mobile/android/fenix/app/src/main/res/layout/history_metadata_group_list_item.xml", "mobile/android/fenix/app/src/main/res/layout/library_site_item.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/LibrarySiteItemViewTest.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/widget/SwitchWithDescription.kt", "mobile/android/focus-android/app/src/main/res/layout/switch_with_description.xml"], "git_node": "131997ce36351004c748b2d59c95157cf6c4f5e5", "git_parents": ["16b0d58e4ed64e46c39d29b4a9a61d5d1a63e623"], "node": "f4096c9487eb1fb0d389006a2cdca7f30e442ed8", "parents": ["6296612460d860af96142048844733ff56e1d967"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Flatten the add-on rating row. r=android-reviewers,mcarare\n\nThe three views were wrapped in a ConstraintLayout that did nothing but hold them, which the check counts\nas a second one in the file. Nothing referred to the wrapper from code, and only the divider below it\nreferred to it at all, so the views move up a level unchanged.\n\nThe wrapper was as tall as the tallest of the three, and no single view reproduces that, so the divider\nnow follows a barrier across them instead. The two on the right centre on the label rather than on the\nrow, which is the same thing while the label is the tallest, and it is: it sets the minimum height the\nrow used to get.\n\nRemoving the wrapper's id is what turned up the rest of this. A test walking the add-ons list was finding\nits rating bar by asking Fenix for an id named rating, which resolved only because this layout, which has\nnothing to do with that list, happened to define the same name. The right numbers for the wrong reason,\nand no longer any number at all once the name went. It asks the add-ons component now.\n\nThe same test reaches four more of that component's views the same way, through ids named title,\nreview_count and add_button that Fenix also happens to define. Those still work and would break the same\nway, so they are pointed at the component too. Other views the robots find by an id named title really\nare Fenix's own and are left alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318979\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAddonsManagerRobot.kt", "mobile/android/fenix/app/src/main/res/layout/fragment_add_on_details.xml"], "git_node": "2f49f1c1c2224c5b43d36bf8de6dba11492ac803", "git_parents": ["131997ce36351004c748b2d59c95157cf6c4f5e5"], "node": "8e35bbbb2f4b9d019b6822651e66d29b65aad3bf", "parents": ["f4096c9487eb1fb0d389006a2cdca7f30e442ed8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Use a LinearLayout for the no-suggestions prompt. r=android-reviewers,mcarare\n\nA message with a button under it does not need constraints, and the ConstraintLayout holding them was the\nsecond one in the file. It is a sibling of the other one rather than nested inside it, so there was never\nanything to flatten here, only a container that had been reached for out of habit.\n\nThe only thing that reads it sets isVisible, which does not care what kind of view it is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318980\n", "files": ["mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/main/res/layout/fragment_search_suggestions.xml"], "git_node": "31ec09cfb86a5b04c02df639d86d989efff615d9", "git_parents": ["2f49f1c1c2224c5b43d36bf8de6dba11492ac803"], "node": "8c34a25606080812dac0b66374701d79bc177b05", "parents": ["8e35bbbb2f4b9d019b6822651e66d29b65aad3bf"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Stack the tracking protection category with a LinearLayout. r=android-reviewers,mcarare\n\nThe category is a title with a description under it, which was a ConstraintLayout holding a two-view\nvertical chain. Seven of them sit in the panel, so the check reported six, and none of them was going to\nbe flattened into anything: they are siblings in a list, not nested.\n\nWhat made them ConstraintLayouts was the component, not the screen, so change that instead. The two views\nwere already full width and stacked, and the horizontal bias they carried does nothing at that width.\n\nThe class needed the documentation detekt had been told to overlook, which it can have now rather than a\nbaseline entry that only matched while it extended what it used to.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318981\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/trackingprotection/TrackingProtectionCategoryItem.kt", "mobile/android/fenix/app/src/main/res/layout/tracking_protection_category.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/trackingprotection/TrackingProtectionCategoryItemTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "8613e5982a604f05a5b44d5aa3898df4a004a26d", "git_parents": ["31ec09cfb86a5b04c02df639d86d989efff615d9"], "node": "db3b2ca9f5a54ef8a4c16f72c186f3b4d3317e66", "parents": ["8c34a25606080812dac0b66374701d79bc177b05"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Report a ConstraintLayout that inflates a second one into itself. r=android-reviewers,mcarare\n\nEvery real cost this bug turned up had the same shape: a view that extends ConstraintLayout inflating a\nlayout rooted in another ConstraintLayout into itself, two where one would do, on every instance. Four\nviews did it, the earlier patches fix them, and nothing stops the next one being written, because the\ncheck that counts ConstraintLayouts reads one file at a time and the two halves of this live in two.\n\nSo read both. When a view that extends ConstraintLayout inflates a layout into itself, whether through a\nview binding, View.inflate or LayoutInflater.inflate, look the layout up and report if its root is a\nConstraintLayout. A binding is named after its layout, so the name says which file to open; the other two\nforms name the resource directly. Only an inflation attached to the view itself counts, since that is the\none that nests.\n\nThe crash reporter is the one view left doing this, for the reason given when the others were fixed, and\ncarries a suppression saying so.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323265\n", "files": ["mobile/android/android-components/components/tooling/lint/src/main/java/mozilla/components/tooling/lint/ConstraintLayoutInflationDetector.kt", "mobile/android/android-components/components/tooling/lint/src/main/java/mozilla/components/tooling/lint/ConstraintLayoutPerfDetector.kt", "mobile/android/android-components/components/tooling/lint/src/main/java/mozilla/components/tooling/lint/LintIssueRegistry.kt", "mobile/android/android-components/components/tooling/lint/src/test/java/mozilla/components/tooling/lint/ConstraintLayoutInflationDetectorTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/crashes/CrashContentView.kt"], "git_node": "5b75d95f238441e2fd8177121536c53a4edd64aa", "git_parents": ["8613e5982a604f05a5b44d5aa3898df4a004a26d"], "node": "f2f44cf57fb50d15761fc99962b8251feb5f76e7", "parents": ["db3b2ca9f5a54ef8a4c16f72c186f3b4d3317e66"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063937 - Suppress the ConstraintLayouts that have to stay. r=android-reviewers,mcarare\n\nWhat is left after the ones worth changing are changed: a bar whose visibility the transitions drive by id,\na sheet that paints its own background over the scrim, and a banner that sizes its own background. Each has\nits reason written next to it.\n\nThe suppressions sit on the elements reported rather than on anything above them, so a ConstraintLayout\nadded later is still reported, and neither baseline carries this check any more.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318982\n", "files": ["mobile/android/android-components/samples/browser/src/main/res/layout/fragment_browser.xml", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/res/layout/component_collection_creation.xml", "mobile/android/fenix/app/src/main/res/layout/fragment_share.xml", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/main/res/layout/dialog_add_to_homescreen2.xml"], "git_node": "88097fc6ca87e6d0a323d82f5c5e3228b7059266", "git_parents": ["5b75d95f238441e2fd8177121536c53a4edd64aa"], "node": "9e4684384e34881769cda5f9fddefcd7d81e0dd6", "parents": ["f2f44cf57fb50d15761fc99962b8251feb5f76e7"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069350 - Move enough widgets into the navbar in ensureToolbarOverflow to overflow it on every channel r=firefox-desktop-core-reviewers ,mossop\n\nensureToolbarOverflow() resized the window to kForceOverflowWidthPx and moved\nfour palette widgets into the navbar. That no longer leaves any slack now that\nNova is enabled on all channels (bug 2056186): Nova's chrome is narrower, and\nthe default navbar outside Nightly has one widget fewer, since sidebar-button\nis only placed there when sidebar.revamp is enabled, which is Nightly-only.\nThe navbar then never overflows and callers waiting on its overflowing\nattribute time out. DevEdition escaped this because developer-button takes the\nplace of that missing widget.\n\nMove three more widgets so the helper overflows the narrowest default navbar\nof any channel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324632\n", "files": ["browser/components/customizableui/test/head.js"], "git_node": "1db876aea95f944e8edb3376cb4584010491fdf6", "git_parents": ["88097fc6ca87e6d0a323d82f5c5e3228b7059266"], "node": "a220a6a72ac2dc9df1ac18d03071455d8f16e1ce", "parents": ["9e4684384e34881769cda5f9fddefcd7d81e0dd6"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2070799 - Skip the no-op OR when tagging object nursery cell headers r=jandem\n\nNurseryCellHeader::MakeValue packs an allocation site pointer and a trace\nkind into one word, and since the site is aligned well enough to leave the\nlow two bits free the pack is an OR. JS::TraceKind::Object is zero, so for\nobject allocations that OR contributes nothing: the Baseline nursery\nallocation path emits a dead \"or rsi, 0x0\", four bytes on x64. Every other\nnursery-allocated kind has a non-zero tag and still needs it.\n\nGuard the orPtr on the trace kind, matching the constant-header path a few\nlines above, which already special-cases Object.\n\nThis is the register path, reached only from Baseline; Warp and the other\ncallers build the header word at compile time and store it whole.\n\nAn x86lint survey of a full JetStream 3 run counts 2,517 \"redundant\nOR/XOR zero\" sites before this change and none after, all of them in\nBaseline.  On x86-64 this drops four bytes each although the the guard\nremoves it on every backend.\n\nFound via x86lint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324863\n", "files": ["js/src/jit/MacroAssembler.cpp"], "git_node": "903f432d3a29da2bbf445709654d171dd458d8cc", "git_parents": ["1db876aea95f944e8edb3376cb4584010491fdf6"], "node": "a51d0263ed51d64f106c1d274cb9974c11dd2cb7", "parents": ["a220a6a72ac2dc9df1ac18d03071455d8f16e1ce"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2070678 - Emit movzx for x & 0xff and x & 0xffff on x86 r=jandem\n\nMasking an int32 to its low byte or word with a constant bitwise AND is a\nzero-extension: and r32, 0xff and and r32, 0xffff keep only the low bits and\nclear everything above. movzbl / movzwl compute the identical value in three\nbytes (four with a REX prefix); the AND needs five or six, since neither 0xff\nnor 0xffff fits a sign-extended imm8 and the immediate is emitted as a full\nimm32. visitModPowTwoI already lowers its power-of-two remainder masks this\nway.\n\nFold the two masks in visitBitOpI's constant path, guarding the byte case on\nsingle-byte registers exactly as visitModPowTwoI does (a source register with\nno byte encoding on 32-bit x86 keeps the AND). The AND's flags are dead here:\na bitwise-AND feeding a branch lowers to a fused LBitAndAndBranch, so a plain\nLBitOpI never has its flags read, and movzx -- which sets no flags -- is a\nsafe substitution.\n\nAn x86lint survey of a full JetStream 3 run counts 390 such sites before this\nchange and none after: every constant low-byte or low-word mask Ion emits is\nnow a movzx. A deterministic gbemu+crypto workload shows the same, 184 -\u003e 0.\n\nFound via x86lint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324751\n", "files": ["js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp"], "git_node": "69325a70deaad3aeff37ba64c298a56aff937507", "git_parents": ["903f432d3a29da2bbf445709654d171dd458d8cc"], "node": "b30cd1799cc86325bc27eaab4b43d4f67b281403", "parents": ["a51d0263ed51d64f106c1d274cb9974c11dd2cb7"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070899 - Quota manager test: use EXPECT_THAT(testing::Each()) instead of std::all. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324956\n", "files": ["dom/quota/test/gtest/TestEncryptedStream.cpp"], "git_node": "3ab7fb18fee8782eddf0cdf703f8bfad8e9f053a", "git_parents": ["69325a70deaad3aeff37ba64c298a56aff937507"], "node": "171506a1a6b5e7b81077be3cc15d34406300cd9a", "parents": ["b30cd1799cc86325bc27eaab4b43d4f67b281403"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.p3.canvas.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.with.putImageData.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.jpeg.p3.canvas.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.p3.canvas.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.with.putImageData.html.ini", "testing/web-platform/meta/streams/transferable/transform-stream.html.ini", "testing/web-platform/tests/css/css-pseudo/first-line-line-height-003-ref.html", "testing/web-platform/tests/css/css-pseudo/first-line-line-height-003.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.p3.canvas.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.with.putImageData.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.jpeg.p3.canvas.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.p3.canvas.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.with.putImageData.html"], "git_node": "31aaa104c99421ced2e674334eef2aa5b7e45b5d", "git_parents": ["ffc07a625994a9db71c7b6fbfe4be2ed64ed1aee", "3ab7fb18fee8782eddf0cdf703f8bfad8e9f053a"], "node": "df470c01ed6a