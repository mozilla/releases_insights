ils.sys.mjs", "toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_mock_llm_engine.js"], "git_node": "b10f889a3ddcc0b626f2a217b6ba1c60452eda4f", "git_parents": ["aa479506421ee48d174ff57e815020eca1045cdf"], "node": "cc0ffbd2da488668e831436bf70fb036b89fc9a3", "parents": ["d2caa104bfaba3acbc95dcd18375af28b1dfef17"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069527 - Remove Linux 18.04 pinned Talos and Translations perftests r=perftest-reviewers,mozperftest-reviewers,sparky\n\nThis patch finalizes the migration of 18.04 -\u003e 24.04 ubuntu performance\ntesting. The last remaining test sets were a few talos and mozperftest\ntasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328000\n", "files": ["python/mozperftest/mozperftest/perfdocs/hardware.yml", "taskcluster/gecko_taskgraph/transforms/perftest.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/linux_perf_platform_restrictions.py", "taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/test/talos.yml", "taskcluster/test_configs/os-integration.yml", "taskcluster/test_configs/test-platforms.yml", "testing/perfdocs/generated/performance-infrastructure.md", "testing/perfdocs/generated/talos.md"], "git_node": "8d45a0aa390a95523642e28c49d306055937cff2", "git_parents": ["b10f889a3ddcc0b626f2a217b6ba1c60452eda4f"], "node": "f233ffd4483b43b9b154384ca5b25504b8e5e320", "parents": ["cc0ffbd2da488668e831436bf70fb036b89fc9a3"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074551 - Mark setHTMLUnsafe() and ShadowRoot.setHTML() as [CEReactions] r=webidl,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328196\n", "files": ["dom/webidl/Element.webidl", "dom/webidl/ShadowRoot.webidl", "testing/