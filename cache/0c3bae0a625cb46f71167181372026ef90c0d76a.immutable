e": "1c7fb73211a3174fccef1296e94bd9764c4ed7a2", "parents": ["45bca7c032faca1f28906cd61676d605f3cdbb68"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074208. r=smaug,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328462\n", "files": ["dom/base/nsImageLoadingContent.cpp"], "git_node": "14dcbdd4a7e8732ae4f2e4555d573aa1bf238bb7", "git_parents": ["23b35fd480f4d0615c55da188bcfce5ac3840f9b"], "node": "6ec1241710b754b27f46937ff22e527d08e9cf74", "parents": ["1c7fb73211a3174fccef1296e94bd9764c4ed7a2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070271 - Improve nova button hover / active color tokens. r=mstriemer,desktop-theme-reviewers\n\nMake the default button hover / active backgrounds semi-transparent tints\nof the accent color instead of opaque desaturated violets. Ghost buttons\nkeep referencing the default button tokens.\n\nThe mix percentages are chosen so that over the usual backdrops (white\nin light mode, the toolbox / box backgrounds in dark mode) the result is\nvery close to the previous opaque colors, while still giving some more\ncontrast on hover in places that are already purple like inactive tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326748\n", "files": ["toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "bcd528e6b614535c5c842cb856c6c5153efc9916", "git_parents": ["14dcbdd4a7e8732ae4f2e4555d573aa1bf238bb7"], "node": "ee8b27e8e2c1959237c63fabcfc484a54e93fda1", "parents": ["6ec1241710b754b27f46937ff22e527d08e9cf74"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074356 - Remove some dead code and make AttrArray::Clear() properly preserve bloom filter. r=denispal,dom-core-reviewers,smaug\n\nI don't think this is observable because Clear() is only called on\nLastRelease() tho.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328482\n", "files": ["dom/base/AttrArray.cpp", "dom/base/AttrArray.h", "dom/html/nsGenericHTMLElement.h"], "git_node": "da5ab723d4a00cfd52714e48194bb47298e54cee", "git_parents": ["bcd528e6b614535c5c842cb856c6c5153efc9916"], "node": "2fae42f60f9958ca99caef17c7e3f78bb5bc6cf1", "parents": ["ee8b27e8e2c1959237c63fabcfc484a54e93fda1"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2071356 - Enforce Extensions.Uninstall at every startup. r=joporter\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327434\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_extensions.js", "browser/components/enterprisepolicies/tests/xpcshell/test_extensions_uninstall.js", "browser/components/enterprisepolicies/tests/xpcshell/test_runOnce_helper.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs"], "git_node": "d035f6c8f96cad92f34b9395132d6f8ad07a9d82", "git_parents": ["da5ab723d4a00cfd52714e48194bb47298e54cee"], "node": "49b5af435daa015dc3c64df27ca992c090ed778f", "parents": ["2fae42f60f9958ca99caef17c7e3f78bb5bc6cf1"], "tags": []}, {"author": "zhuangxiaosen \u003cxz.ganbaruibro@gmail.com\u003e", "branch": "default", "desc": "Bug 2044184 - Remove DebuggerObject.promiseID r=bthrall\n\nUnused in DevTools; remove its documentation, implementation, and test\ncoverage.\n\n- docs: promiseID section in js/src/doc/Debugger/Debugger.Object.md and\n  its mirror in devtools/docs/user/debugger-api/debugger.object/index.md\n- impl: promiseIDGetter declaration, definition, and JS_DEBUG_PSG\n  registration in js/src/debugger/Object.cpp\n- tests: promiseID assertions in debug/inspect-wrapped-promise.js\n  (the file's remaining promise reflection assertions are untouched)\n\nThe underlying promise IDs stay: PromiseObject::getID() and\nJS::GetPromiseID are still used by unhandled-rejection tracking in\nxpcom and dom.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326811\n", "files": ["devtools/docs/user/debugger-api/debugger.object/index.md", "js/src/debugger/Object.cpp", "js/src/doc/Debugger/Debugger.Object.md", "js/src/jit-test/tests/debug/inspect-wrapped-promise.js"], "git_node": "ca7ac7a090d7d75323572937cecf4e8ba7999353", "git_parents": ["d035f6c8f96cad92f34b9395132d6f8ad07a9d82"], "node": "e3fd01bcd3d32f8decd37e27f19996ad3f864568", "parents": ["49b5af435daa015dc3c64df27ca992c090ed778f"], "tags": []}, {"author": "zhuangxiaosen \u003cxz.ganbaruibro@gmail.com\u003e", "branch": "default", "desc": "Bug 2044179 - Remove deprecated Debugger.Script offset functions r=bthrall,devtools-reviewers,ochameau\n\nRemove getAllOffsets, getAllColumnOffsets, getLineOffsets and\ngetOffsetLocation in favor of getPossibleBreakpoints,\ngetPossibleBreakpointOffsets, and getOffsetMetadata:\n\n- impl: the four CallData wrappers, their matcher classes, the\n  FlowGraphSummary helper, the JS_DEBUG_FN registrations, and the\n  method declarations in js/src/debugger/Script.cpp. The internal C++\n  methods of the same names stay: getPossibleBreakpoints and\n  getOffsetMetadata reuse them (including for wasm).\n\n- docs: the deprecated section in js/src/doc/Debugger/Debugger.Script.md\n  and its mirror in devtools/docs/user/debugger-api/debugger.script/.\n\n- thread.js: migrate the first-statement fallback off\n  getAllColumnOffsets() to script.mainOffset, which marks the start of\n  top-level execution.\n\n- tests: delete the dedicated tests for the removed APIs and migrate\n  borrowers to the replacement APIs. Where the old entry-point and new\n  recommended-breakpoint semantics genuinely differ, expectations are\n  regenerated (loop heads, try/catch/finally headers, prologue\n  positions) and nonsense-position stops are filtered with\n  isBreakpoint, matching what the debugger actually shows.\n\nVerified: ./mach jit-test debug (PASSED ALL),\neslint on thread.js, devtools/server/tracer xpcshell tests (104/104).\n\nNote for reviewers: while migrating the tests I noticed that\ngetOffsetMetadata reports raw positions that can inherit dead-code\npositions (e.g. jump targets after a not-taken branch). I filtered\nthose with isBreakpoint in the migrated tests -- is that the intended\nconsumption pattern?\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327732\n", "files": ["devtools/docs/user/debugger-api/debugger.script/index.md", "devtools/server/actors/thread.js", "js/src/debugger/Script.cpp", "js/src/doc/Debugger/Debugger.Script.md", "js/src/jit-test/lib/assert-offset-columns.js", "js/src/jit-test/lib/debuggerNXHelper.js", "js/src/jit-test/lib/stepping.js", "js/src/jit-test/tests/auto-regress/bug677386.js", "js/src/jit-test/tests/debug/Debugger-clearAllBreakpoints-01.js", "js/src/jit-test/tests/debug/Debugger-collectCoverageInfo-observing-mismatch.js", "js/src/jit-test/tests/debug/Debugger-debuggees-28.js", "js/src/jit-test/tests/debug/Frame-implementation-02.js", "js/src/jit-test/tests/debug/Frame-onPop-11.js", "js/src/jit-test/tests/debug/Frame-onPop-23.js", "js/src/jit-test/tests/debug/Frame-onStep-08.js", "js/src/jit-test/tests/debug/Frame-onStep-11.js", "js/src/jit-test/tests/debug/Frame-onStep-12.js", "js/src/jit-test/tests/debug/Frame-onStep-13.js", "js/src/jit-test/tests/debug/Frame-onStep-14.js", "js/src/jit-test/tests/debug/Frame-onStep-15.js", "js/src/jit-test/tests/debug/Frame-onStep-16.js", "js/src/jit-test/tests/debug/Frame-onStep-17.js", "js/src/jit-test/tests/debug/Frame-onStep-18.js", "js/src/jit-test/tests/debug/Frame-onStep-async-01.js", "js/src/jit-test/tests/debug/Frame-onStep-async-02.js", "js/src/jit-test/tests/debug/Frame-onStep-generators-01.js", "js/src/jit-test/tests/debug/Frame-onStep-generators-02.js", "js/src/jit-test/tests/debug/Frame-onStep-generators-03.js", "js/src/jit-test/tests/debug/Frame-onStep-generators-04.js", "js/src/jit-test/tests/debug/Frame-onStep-generators-defaults.js", "js/src/jit-test/tests/debug/Frame-onStep-lines-01.js", "js/src/jit-test/tests/debug/Script-clearBreakpoint-01.js", "js/src/jit-test/tests/debug/Script-clearBreakpoint-02.js", "js/src/jit-test/tests/debug/Script-clearBreakpoint-03.js", "js/src/jit-test/tests/debug/Script-clearBreakpoint-04.js", "js/src/jit-test/tests/debug/Script-getAllColumnOffsets.js", "js/src/jit-test/tests/debug/Script-getAllOffsets.js", "js/src/jit-test/tests/debug/Script-getBreakpoints-01.js", "js/src/jit-test/tests/debug/Script-getBreakpoints-02.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-01.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-02.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-03.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-04.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-05.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-06.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-07.js", "js/src/jit-test/tests/debug/Script-getLineOffsets-08.js", "js/src/jit-test/tests/debug/Script-getOffsetLine-01.js", "js/src/jit-test/tests/debug/Script-getOffsetLine-02.js", "js/src/jit-test/tests/debug/Script-getOffsetLocation-overflow.js", "js/src/jit-test/tests/debug/Script-getOffsetLocation.js", "js/src/jit-test/tests/debug/Script-prologue-offsets.js", "js/src/jit-test/tests/debug/Source-introductionScript-01.js", "js/src/jit-test/tests/debug/Source-introductionScript-02.js", "js/src/jit-test/tests/debug/breakpoint-01.js", "js/src/jit-test/tests/debug/breakpoint-04.js", "js/src/jit-test/tests/debug/breakpoint-06.js", "js/src/jit-test/tests/debug/breakpoint-07.js", "js/src/jit-test/tests/debug/breakp