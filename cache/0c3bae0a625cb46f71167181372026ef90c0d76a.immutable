"testing/web-platform/tests/webdriver/tests/classic/forward/forward.py", "testing/web-platform/tests/webdriver/tests/classic/get_element_attribute/get.py", "testing/web-platform/tests/webdriver/tests/classic/get_element_property/get.py", "testing/web-platform/tests/webdriver/tests/classic/get_element_text/get.py", "testing/web-platform/tests/webdriver/tests/classic/is_element_enabled/enabled.py", "testing/web-platform/tests/webdriver/tests/classic/navigate_to/file.py", "testing/web-platform/tests/webdriver/tests/classic/navigate_to/navigate.py", "testing/web-platform/tests/webdriver/tests/classic/new_session/invalid_capabilities.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/none.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_modifier_click.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_mouse.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_mouse_drag.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_pen.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_touch.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/wheel_events.py", "testing/web-platform/tests/webdriver/tests/classic/send_alert_text/send.py", "testing/web-platform/tests/webdriver/tests/classic/take_element_screenshot/screenshot.py", "testing/web-platform/tests/webdriver/tests/classic/take_screenshot/screenshot.py"], "git_node": "050655c9147b8474094a5d322a8a7f5b743b18be", "git_parents": ["f4bdd30edbf728aed055405307daaac3aa5a303e"], "node": "67061ad58c1a03e0c031c5c70e9306e5c493ed12", "parents": ["4ae170f4d08d8fd69f2e785e9acaf781cd1d9f1b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072870 [wpt PR 62750] - Update wpt metadata, a=testonly\n\nwpt-pr: 62750\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/network/response_completed/response_completed_cached.py.ini"], "git_node": "2d64df89b98b7836892ccf844e6d6d06d61204ce", "git_parents": ["050655c9147b8474094a5d322a8a7f5b743b18be"], "node": "4f8e59458f9e4607f407df04a81473350f7fd5d9", "parents": ["67061ad58c1a03e0c031c5c70e9306e5c493ed12"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2073059 [wpt PR 62763] - [webdriver-wpt] Fix timeout in set_network_conditions contexts.py, a=testonly\n\nAutomatic update from web-platform-tests\n[webdriver-wpt] Fix timeout in set_network_conditions contexts.py (#62763)\n\n- Add `# META: timeout=long` to `contexts.py` to prevent WPT testrunner\n  timeouts and false `CRASH` status reports on CI.\n- Use `new_tab` instead of `affected_user_context` in\n  `test_overrides_global` and `test_restores_to_global_when_removed` in\n  `contexts.py`, halving custom user context creation overhead\n  from 4 to 2.\n- Remove the `crbug.com/450508310` entry for `contexts.py` from\n  `TestExpectations`.\n\nTAG=agy\nCONV=ab6276ac-6451-4bd7-8ec6-4327b053801f\n\nFixed: 450508310\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,linux-rel,linux_chromium_dbg_ng,android-15-x64-rel\nInclude-Ci-Only-Tests: true\nChange-Id: I166fa30c144797d0ee52afd9557d0fe3d4bc8158\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8420180\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699615}\n\nCo-authored-by: Maksim Sadym \u003csadym@chromium.org\u003e\n--\n\nwpt-commits: f2a98812bcf2caa6ed25c2caabfc87eadb829903\nwpt-pr: 62763\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/emulation/set_network_conditions/contexts.py"], "git_node": "5871a2f8d52e96ae54be06dba1ba368d3ca7bade", "git_parents": ["2d64df89b98b7836892ccf844e6d6d06d61204ce"], "node": "12c0d8ef7746a9b1887450e7e30d057a958b949e", "parents": ["4f8e59458f9e4607f407df04a81473350f7fd5d9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073059 [wpt PR 62763] - Update wpt metadata, a=testonly\n\nwpt-pr: 62763\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/emulation/set_network_conditions/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_network_conditions/global.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_network_conditions/invalid.py.ini"], "git_node": "f36780cba831caff261de10faa8b72086a164979", "git_parents": ["5871a2f8d52e96ae54be06dba1ba368d3ca7bade"], "node": "61cef217f8ca6354f56fe488f72bc32648e05adb", "parents": ["12c0d8ef7746a9b1887450e7e30d057a958b949e"], "tags": []}, {"author": "moonira \u003cmoonira@google.com\u003e", "branch": "default", "desc": "Bug 2073062 [wpt PR 62761] - Allow downcasting CSSLightDarkValuePair and CSSParamValuePair to CSSValuePair, a=testonly\n\nAutomatic update from web-platform-tests\nAllow downcasting CSSLightDarkValuePair and CSSParamValuePair to CSSValuePair\n\nCSSLightDarkValuePair and CSSParamValuePair derive from CSSValuePair,\nbut DowncastTraits\u003cCSSValuePair\u003e checks CSSValue::IsValuePair(), which\npreviously only checked for kValuePairClass. As a result, downcasting\nvia To\u003cCSSValuePair\u003e failed a CHECK in casting.h when called on\nderived instances (such as in CSSValue::HasRandomFunctions() when\nevaluating light-dark() animations for compositing).\n\nFixed: 561828148\nChange-Id: I2a6777553314dcd605b4767de97db6cb7bc16886\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8410130\nAuto-Submit: Munira Tursunova \u003cmoonira@google.com\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699576}\n\n--\n\nwpt-commits: 08008df7afd0916a2afdc41d919dd322ecf295cc\nwpt-pr: 62761\n", "files": ["testing/web-platform/tests/css/css-color/crashtests/light-dark-animation-crash.html"], "git_node": "39583ba67999803a7a889b807ccb3ded5d8082be", "git_parents": ["f36780cba831caff261de10faa8b72086a164979"], "node": "de4a050cc3ff6a2d09e70b95db2b0ba7db7b5b13", "parents": ["61cef217f8ca6354f56fe488f72bc32648e05adb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073062 [wpt PR 62761] - Update wpt metadata, a=testonly\n\nwpt-pr: 62761\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color/crashtests/light-dark-animation-crash.html.ini", "testing/web-platform/meta/css/css-color/crashtests/stop-color-invalid-rgb.html.ini"], "git_node": "180896b4d9b6e4459b14843acd29e16f3d0369c2", "git_parents": ["39583ba67999803a7a889b807ccb3ded5d8082be"], "node": "1eb86264373a639e05c9ae31f7d46545e4a2fb38", "parents": ["de4a050cc3ff6a2d09e70b95db2b0ba7db7b5b13"], "tags": []}, {"author": "Simon Pieters \u003czcorpan@gmail.com\u003e", "branch": "default", "desc": "Bug 2072376 [wpt PR 62344] - HTML: test view and target of focus events fired at a Window, a=testonly\n\nAutomatic update from web-platform-tests\nHTML: test view and target of focus events fired at a Window (#62344)\n--\n\nwpt-commits: 8ac54c383a9f26b141a5f21fa01e9ea29421e18b\nwpt-pr: 62344\n", "files": ["testing/web-platform/tests/html/interaction/focus/focus-management/focus-event-view.html"], "git_node": "f7ed9f7ad04a50f0130cb8c7aa8c0e9cb6aa2846", "git_parents": ["180896b4d9b6e4459b14843acd29e16f3d0369c2"], "node": "c3ca8bc3a9578e02d18ebef4b46bbd5cabbac602", "parents": ["1eb86264373a639e05c9ae31f7d46545e4a2fb38"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071457 [wpt PR 62417] - Split one test of fetch/range/sw.https.window.js for interop 2026, a=testonly\n\nAutomatic update from web-platform-tests\nSplit one test of fetch/range/sw.https.window.js for interop 2026. (#62417)\n\nTest is now in its own file named fetch/range/sw-opaque.https.window.js\n--\n\nwpt-commits: 01347c3138410f9101bcae82ceb979c11eecdd7f\nwpt-pr: 62417\n", "files": ["testing/web-platform/tests/fetch/range/sw-opaque.https.window.js", "testing/web-platform/tests/fetch/range/sw.https.window.js"], "git_node": "c8c752f82a9228137f86ca8770438ed899d9599a", "git_parents": ["f7ed9f7ad04a50f0130cb8c7aa8c0e9cb6aa2846"], "node": "e7cb264eda7bf482009ee216d1117aad9e9307da", "parents": ["c3ca8bc3a9578e02d18ebef4b46bbd5cabbac602"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071457 [wpt PR 62417] - Update wpt metadata, a=testonly\n\nwpt-pr: 62417\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/fetch/range/sw-opaque.https.window.js.ini"], "git_node": "0afccdbfeddca7765acb2d4b991897c54ab85a78", "git_parents": ["c8c752f82a9228137f86ca8770438ed899d9599a"], "node": "8790c36e7d7760248061d18c8f5f76f253048747", "parents": ["e7cb264eda7bf482009ee216d1117aad9e9307da"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071460 [wpt PR 62418] - Split one test of fetch/api/basic/request-upload.any.js for interop 2026, a=testonly\n\nAutomatic update from web-platform-tests\nSplit one test of fetch/api/basic/request-upload.any.js for interop 2026 (#62418)\n\nThis test is moved to fetch/api/basic/request-upload-421.any.js\n--\n\nwpt-commits: 214832a23e67dbe1ae38de7321ade47b7ba75a60\nwpt-pr: 62418\n", "files": ["testing/web-platform/tests/fetch/api/basic/request-upload-421.any.js", "testing/web-platform/tests/fetch/api/basic/request-upload.any.js"], "git_node": "faa68200fd6b313f49db7651a8d0bec5963180f2", "git_parents": ["0afccdbfeddca7765acb2d4b991897c54ab85a78"], "node": "528ca09c99dabd6e97674dd48276f6a5cb84c04c", "parents": ["8790c36e7d7760248061d18c8f5f76f253048747"], "tags": []}, {"author": "Byungwoo Lee \u003cblee@igalia.com\u003e", "branch": "default", "desc": "Bug 2073075 [wpt PR 62762] - Apply CSP to inline event handler content attributes when set, a=testonly\n\nAutomatic update from web-platform-tests\nApply CSP to inline event handler content attributes when set\n\nPer the HTML spec, the event handler content attribute change steps\nrun the CSP \"Should element's inline behavior be blocked?\" check when\nthe attribute is set [1][2]. But the violation was reported lazily,\nwhen the handler was first accessed, rather than when the attribute\nwas set.\n\nTo report a violation and skip setting the inline event listener as\nper the spec, Element provides the following functions:\n- SetElementAttributeEventListenerFromScriptBody()\n- SetDocumentAttributeEventListenerFromScriptBody()\n- SetWindowAttributeEventListenerFromScriptBody()\n\nThe functions check whether the modification is an inline handler\n(kDirectly or kByParser) and, if so, whether it is blocked by CSP\n(ContentSecurityPolicy::AllowInline()). When blocked, a violation is\nreported and the listener is not set. The CSP check is guarded by\nthe stable runtime feature CheckCSPOnInlineScriptAttributeSet.\n\nElement's subclasses use these functions in ParseAttribute() when\nthey set an inline event handler (HTMLInputElement, HTMLBodyElement,\nHTMLElement, HTMLFrameElementBase, HTMLFrameSetElement, MathMLElement,\nSVGSMILElement, SVGElement, SVGScriptElement, SVGSVGElement).\n\nThis CL updates two tests that do not match the spec:\n- style-element-csp-nonce-allowed.html: Fix the unintended CSP\n  violation on the inline onerror attribute.\n- domdebugger-script-blocked-by-csp.js: Introduce CSP violation by\n  setAttribute() instead of click().\n\n[1] https://html.spec.whatwg.org/multipage/webappapis.html#event-handler-content-attributes\n[2] https://w3c.github.io/webappsec-csp/#should-block-inline\n\nLow-Coverage-Reason: COVERAGE_UNDERREPORTED Tests exist (targeting-for-multiple-inline-handler-violations.html)\nBug: 559396684\nChange-Id: I864b7456169307e78df8eab9d975d9d3ea863b21\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8365264\nReviewed-by: Antonio Sartori \u003cantoniosartori@chromium.org\u003e\nCommit-Queue: Byungwoo Lee \u003cblee@igalia.com\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699666}\n\n--\n\nwpt-commits: b64c3c63d80b0f1d474ccd3be70dccc45ea514a6\nwpt-pr: 62762\n", "files": ["testing/web-platform/tests/html/semantics/document-metadata/the-style-element/tentative/style-element-csp-nonce-allowed.html"], "git_node": "3af6475d14fefb364d992b7ef2e588d2744c2383", "git_parents": ["faa68200fd6b313f49db7651a8d0bec5963180f2"], "node": "b76c63ac8ea72d1cf55785061740666bf4af4cf4", "parents": ["528ca09c99dabd6e97674dd48276f6a5cb84c04c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073075 [wpt PR 62762] - Update wpt metadata, a=testonly\n\nwpt-pr: 62762\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/document-metadata/the-style-element/tentative/style-element-csp-nonce-allowed.html.ini"], "git_node": "ff9ece53e17b28775176c8d0950f272d97410ffa", "git_parents": ["3af6475d14fefb364d992b7ef2e588d2744c2383"], "node": "ff718f9a48a7d7a7d1cd6a3891823e44c730b2aa", "parents": ["b76c63ac8ea72d1cf55785061740666bf4af4cf4"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2073329 [wpt PR 62765] - Fix test hover-invalidates-slotted-descendant.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix test hover-invalidates-slotted-descendant.html\n\nThe test had broken shadow DOM styling, and none of the test_driver\nframeworks support pointerMove() origin inside shadow trees.\n\nBug: 562529672\nChange-Id: I143999c077bd8901a202ebdb3dde75102ae351b8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8419622\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1699756}\n\n--\n\nwpt-commits: d552535bce46b410371ff91c70f04b8b91b19e5a\nwpt-pr: 62765\n", "files": ["testing/web-platform/tests/css/css-shadow/hover-invalidates-slotted-descendant.html"], "git_node": "85d952570c38fac557d7edb1a7bb5493d59983a0", "git_parents": ["ff9ece53e17b28775176c8d0950f272d97410ffa"], "node": "ea86af28a6768958b6d96a4a4512576626cda2b2", "parents": ["ff718f9a48a7d7a7d1cd6a3891823e44c730b2aa"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2073367 [wpt PR 62769] - [masonry] Test rule visibility by lane, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Test rule visibility by lane\n\nAdd Grid Lanes reftests that determine grid-axis rule visibility from\nwhether adjacent lanes contain items. Existing gap-decoration coverage\ndid not exercise rules next to empty lanes.\n\nCover normal, between, around, and all with both column and row grid\naxes. Each case includes three explicit lanes with only the first\noccupied, plus a stacking-axis rule to verify that rule-visibility-items\ndoes not filter stacking-axis rules.\n\nBug: 343257585\nChange-Id: Ic61e318e19ed35fad1b22ac8122bdceff69ed2e1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8404083\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1699979}\n\n--\n\nwpt-commits: 228031ec8e113291f6e0b34df72caa89b51309cb\nwpt-pr: 62769\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-all-001-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-all-001.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decor