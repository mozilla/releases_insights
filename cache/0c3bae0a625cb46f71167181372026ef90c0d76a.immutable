asm/WasmBCClass.h", "js/src/wasm/WasmBCCodegen-inl.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBCFrame.h", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmBCRegDefs-inl.h", "js/src/wasm/WasmBCRegDefs.h", "js/src/wasm/WasmBCRegMgmt-inl.h", "js/src/wasm/WasmBCStk.h", "js/src/wasm/WasmBCStkMgmt-inl.h", "js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmBinary.h", "js/src/wasm/WasmDebugFrame.cpp", "js/src/wasm/WasmDebugFrame.h", "js/src/wasm/WasmFeatures.h", "js/src/wasm/WasmInitExpr.cpp", "js/src/wasm/WasmIonCompile.cpp", "js/src/wasm/WasmOpIter.cpp", "js/src/wasm/WasmOpIter.h", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h", "js/src/wasm/WasmValType.cpp", "js/src/wasm/WasmValType.h", "js/src/wasm/WasmValidate.cpp", "js/xpconnect/src/nsXPConnect.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "ffc07a625994a9db71c7b6fbfe4be2ed64ed1aee", "git_parents": ["dbe1f6c27b5694cd8afa154980a710ff0bb84969"], "node": "8e195fe382b60644e2901571ca1f3f2ed9142b49", "parents": ["da701896fcd0ab7e3a991469bec7de3f404e488d"], "tags": []}], "date": 1789050772, "git_changesets": ["ffc07a625994a9db71c7b6fbfe4be2ed64ed1aee"], "user": "agoloman@mozilla.com"}, "45303": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3a21c1f6b3cdb7033022525980fb181461acd334 with FIREFOX-ANDROID_157_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "f450936891a23066b26194581aaeba720d01de2d", "git_parents": ["d1f7dfb1a7daa2e9c7f8f414268b2d1ec47dfc65"], "node": "719a280158a434b5857f6f4a9294dabda8179e4c", "parents": ["2854179d5183a4a0fa2ae364e863dd1322075d9c"], "tags": []}], "date": 1789053763, "git_changesets": ["f450936891a23066b26194581aaeba720d01de2d"], "user": "ffxbld@lando.moz.tools"}, "45304": {"changesets": [{"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058886 - Fix screen reader announcement and labeling in theme picker r=fluent-reviewers,extension-reviewers,hjones,bolsson,rpl\n\nThe light/dark/device group in the theme picker had no accessible name for screen readers, and its buttons had their role and selected state on a wrapper element instead of the button that gets focused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323767\n", "files": ["toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/tests/widgets/test_segmented_control.html", "toolkit/content/widgets/moz-button/moz-button.mjs", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.mjs", "toolkit/content/widgets/theme-picker/theme-picker.mjs", "toolkit/locales/en-US/toolkit/about/aboutAddons.ftl", "toolkit/locales/en-US/toolkit/global/theme-picker.ftl", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-mode.mjs"], "git_node": "93414b1783a1ac4e5f67fce659d5d9cc35b36a03", "git_parents": ["4161a38c1ff2744303d6aaee05bd54a3287ddf15"], "node": "843ef64a98c45c3c122e4e6ba1fa25fe04e90812", "parents": ["b6333e929676d16c92d709c6705bc685d40c5f1d"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064563 - Add explicit test assertion to ensure the expected fluent id is set on the aboutaddons-themes-mode moz-segmented-control element. r=fluent-reviewers,bolsson,mkennedy\n\nThis patch is adding only an additional test assertion to verify that\nthe aboutaddons-themes-mode moz-segmented-control does have the expected\nfluent id (which is something that the parent patch, D323767, is taking care of).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323037\n", "files": ["toolkit/mozapps/extensions/test/browser/browser_html_themes_mode.js"], "git_node": "5fa3641b28e45ce07aca1a8c480453ae596fb391", "git_parents": ["93414b1783a1ac4e5f67fce659d5d9cc35b36a03"], "node": "11d0a9f95b709367753e6d07fa5a1f77be58f04c", "parents": ["843ef64a98c45c3c122e4e6ba1fa25fe04e90812"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2068875 - Store GpuFenceMTLSharedEvent in CompositeProcessFencesHolderMap r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323499\n", "files": ["dom/canvas/WebGLContext.cpp", "dom/webgpu/ExternalTexture.cpp", "dom/webgpu/SharedTextureMacIOSurface.cpp", "dom/webgpu/SharedTextureMacIOSurface.h", "gfx/gl/GLBlitHelper.cpp", "gfx/gl/SharedSurface.h", "gfx/gl/SharedSurfaceIO.cpp", "gfx/gl/SharedSurfaceIO.h", "gfx/ipc/GPUParent.cpp", "gfx/layers/Fence.h", "gfx/layers/GpuFence.h", "gfx/layers/NativeLayer.h", "gfx/layers/NativeLayerCA.h", "gfx/layers/NativeLayerCA.mm", "gfx/layers/NativeLayerRemoteMac.h", "gfx/layers/NativeLayerRemoteMac.mm", "gfx/layers/NativeLayerWayland.h", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/LayersSurfaces.ipdlh", "gfx/layers/opengl/MacIOSurfaceTextureClientOGL.cpp", "gfx/layers/opengl/MacIOSurfaceTextureHostOGL.cpp", "gfx/layers/opengl/MacIOSurfaceTextureHostOGL.h", "gfx/thebes/gfxPlatform.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.h", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.h", "gfx/webrender_bindings/RenderMacIOSurfaceTextureHost.cpp", "gfx/webrender_bindings/RenderMacIOSurfaceTextureHost.h"], "git_node": "c8196f9387c5284242aeede7f6008c68eb9ec6c0", "git_parents": ["5fa3641b28e45ce07aca1a8c480453ae596fb391"], "node": "2339447524164b798f5f3153161092f7d40a337a", "parents": ["11d0a9f95b709367753e6d07fa5a1f77be58f04c"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065412 - switch the static-analysis-build docker image to debian 13. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320368\n", "files": ["taskcluster/docker/static-analysis-build/Dockerfile", "taskcluster/kinds/docker-image/kind.yml"], "git_node": "7668b1f5290e0881d66d59aadc3102aa7917b657", "git_parents": ["c8196f9387c5284242aeede7f6008c68eb9ec6c0"], "node": "a26107072aedd25609d537ee0595b604231168dd", "parents": ["2339447524164b798f5f3153161092f7d40a337a"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070456 - Move the spidermonkey builds to the Debian 13 image. r=firefox-build-system-reviewers,ahochheiden\n\nBug 2010489 moves the toolchain tasks to a Debian 13 docker image. gcc is\nbuilt host-native, so the gcc 10 toolchain now requires GLIBC_2.38, while\ndebian12-amd64-build provides 2.36. The spidermonkey builds that use gcc\nfail in configure with\n\n\u003e /builds/worker/fetches/gcc/bin/gcc: /lib/x86_64-linux-gnu/libc.so.6: version `GLIBC_2.38' not found\n\nSwitch the kind to debian13-amd64-build, which already exists and is the\nimage ordinary Firefox builds use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324559\n", "files": ["taskcluster/kinds/spidermonkey/linux.yml"], "git_node": "53f76038ea57737ef9bf9e170d8bc6139d5129fb", "git_parents": ["7668b1f5290e0881d66d59aadc3102aa7917b657"], "node": "5c3300e8fbd9cb8c9ff2f669555eda7fa2210fc0", "parents": ["a26107072aedd25609d537ee0595b604231168dd"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070456 - Move the gdb-test image to Debian 13. r=firefox-build-system-reviewers,ahochheiden\n\nThe image is only used by spidermonkey-sm-gdb-linux64/debug, which fetches\nthe gcc 10 toolchain. With bug 2010489 that toolchain requires GLIBC_2.38,\nwhich debian12-amd64-build does not provide.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324560\n", "files": ["taskcluster/kinds/docker-image/kind.yml"], "git_node": "cbebc5e0e1f58f0728f53c212b3775f031722201", "git_parents": ["53f76038ea57737ef9bf9e170d8bc6139d5129fb"], "node": "0816830d4b2e03bd57e7fa6b6d0067c2258635d1", "parents": ["5c3300e8fbd9cb8c9ff2f669555eda7fa2210fc0"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070457 - Move the hazard builds to the Debian 13 image. r=firefox-build-system-reviewers,ahochheiden\n\nBoth hazard tasks fetch the gcc 10 toolchain and the sixgill plugin built\nagainst it. With bug 2010489 that toolchain requires GLIBC_2.38, which\ndebian12-amd64-build does not provide.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324561\n", "files": ["taskcluster/kinds/hazard/kind.yml"], "git_node": "2e84015f412e67f676ac604e0fa7eabf2f74657d", "git_parents": ["cbebc5e0e1f58f0728f53c212b3775f031722201"], "node": "e0cb57fe7ac7ae30bad153ffb0d47dd44047c13b", "parents": ["0816830d4b2e03bd57e7fa6b6d0067c2258635d1"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2069181 - Switch hazard builds to gcc 11. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324500\n", "files": ["js/src/devtools/rootAnalysis/mach_commands.py", "taskcluster/kinds/hazard/kind.yml", "taskcluster/kinds/packages/debian.yml", "taskcluster/kinds/toolchain/gcc.yml", "taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "70accd6ccc7555b90a08fc48c39c93fddce5e613", "git_parents": ["2e84015f412e67f676ac604e0fa7eabf2f74657d"], "node": "b78e425f0e68001dbfae26d8fb53bbc2cb09ee8a", "parents": ["e0cb57fe7ac7ae30bad153ffb0d47dd44047c13b"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 3009c7432afd39877bb3a937b3ab08ae0a9601dc\naf -\u003e 3009c7432afd39877bb3a937b3ab08ae0a9601dc\nan -\u003e 3009c7432afd39877bb3a937b3ab08ae0a9601dc\nar -\u003e 3009c7432afd39877bb3a937b3ab08ae0a9601dc\nast -\u003e 3009c7432a