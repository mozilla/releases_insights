2073692.html", "dom/xml/crashtests/crashtests.list", "dom/xml/nsXMLPrettyPrinter.cpp", "dom/xml/nsXMLPrettyPrinter.h"], "git_node": "133a822f130a8bbb950d912e45ecb4f68f7de075", "git_parents": ["36e82169f3d383a08d6ff825b35f24db59147abb"], "node": "88d17894c4b003d85516734702234dd7b7e3d469", "parents": ["92dc71373c442d8b2f0158f54ba7442b8cd9c3fa"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059211: Cap streaming request body sizes. r=dom-storage-reviewers,hsingh,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325120\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "18b9d47a78c0b37a63801f652fb410fb5d948daf", "git_parents": ["133a822f130a8bbb950d912e45ecb4f68f7de075"], "node": "2660a7bbdb032e6fcbf8a7798333d3462751616c", "parents": ["88d17894c4b003d85516734702234dd7b7e3d469"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074249 - Record METRIC_MEMORY_USAGE globally. r=janerik\n\nI don't think there's any guarantee that you'd call this on the main\nthread? And even if you do this is cheaper anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327902\n", "files": ["toolkit/components/glean/api/src/metrics.rs"], "git_node": "23889ffdd2a52c7f67e6ec3c5d31e10e571d5b88", "git_parents": ["18b9d47a78c0b37a63801f652fb410fb5d948daf"], "node": "363d1dc2cbe959ec2803f3feed1ec24cc357cee7", "parents": ["2660a7bbdb032e6fcbf8a7798333d3462751616c"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072899 - Copy Clean Link: Extend the StripOnShare.json list with new query parameters. r=manuel\n\nExcluded any not verifiable params from the GitHub source\n(https://github.com/mpchadwick/tracking-query-params-registry)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326846\n", "files": ["toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json"], "git_node": "50efa76fae2508f6254412cda26def5b91ea2ce8", "git_parents": ["23889ffdd2a52c7f67e6ec3c5d31e10e571d5b88"], "node": "89ccd6bec717cec1760d5605e7cab314652d2178", "parents": ["363d1dc2cbe959ec2803f3feed1ec24cc357cee7"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2036862 - Make sure to use a fresh connection for each captive portal check r=necko-reviewers,sunil\" for causing failures at test_fresh_connection.js.\n\nThis reverts commit 6ae60b8d90e8f17f336aa5ec3fd0094b73b999eb.\n", "files": ["toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/test/unit/test_fresh_connection.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml"], "git_node": "7034c01a54648ac980506dad722bea6bf5ca138d", "git_parents": ["50efa76fae2508f6254412cda26def5b91ea2ce8"], "node": "5c3f92ad87a489b1ede5abcb00f3182c08c21ec3", "parents": ["89ccd6bec717cec1760d5605e7cab314652d2178"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1815540 - Fix SVGGeometryFrame dynamic overflow handling.\n\nThis fixes some tests in drawSnapshot mode.\n", "files": ["layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGeometryFrame.h"], "git_node": "308077b4df513ccab0018261b71ad367e9a519ce", "git_parents": ["7034c01a54648ac980506dad722bea6bf5ca138d"], "node": "26039f11cbb1f685d680dcdd5fd18a4510b7c4d3", "parents": ["5c3f92ad87a489b1ede5abcb00f3182c08c21ec3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1815540 - Bump antialiasing fuzzy count for a few SVG transform tests.\n\nStill one-channel difference so not worrisome.\n", "files": ["testing/web-platform/tests/css/css-transforms/skewY/svg-skewy-001.html", "testing/web-platform/tests/css/css-transforms/skewY/svg-skewy-006.html", "testing/web-platform/tests/css/css-transforms/skewY/svg-skewy-011.html", "testing/web-platform/tests/css/css-transforms/skewY/svg-skewy-016.html", "testing/web-platform/tests/css/css-transforms/skewY/svg-skewy-021.html"], "git_node": "d92f8a3c100e36f44f1ebd241a122db36d43afb4", "git_parents": ["308077b4df513ccab0018261b71ad367e9a519ce"], "node": "4572664f690b0b45802c4068abb19d16a689db8d", "parents": ["26039f11cbb1f685d680dcdd5fd18a4510b7c4d3"], "tags": []}, {"author": "virsworld \u003cvirpatel71@gmail.com\u003e", "branch": "default", "desc": "Bug 1865119 - Add comment noting that equalsURI ignores the ref fragment. r=manuel DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328034\n", "files": ["caps/nsIPrincipal.idl"], "git_node": "9578413d691893f5772ae9849c0853b53cd10a2b", "git_parents": ["d92f8a3c100e36f44f1ebd241a122db36d43afb4"], "node": "e2b258e75b6ac47773edef5af84796e6d9743b93", "parents": ["4572664f690b0b45802c4068abb19d16a689db8d"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2067771 - Use single-handle *-shm locking on Windows network volumes. r=mak\n\nUpstream commit: https://github.com/sqlite/sqlite/commit/28fe5623286bdb4eaf543e7be4dddee5762ee51b\n\nSQLite 3.50 split Windows WAL shared-memory locking across two file handles:\nwinShmNode.hSharedShm for the DMS lock, truncation and the MapViewOfFile\nmapping, plus a per-connection winShm.hShm for the eight WAL lock bytes. That\ndoes not work on network filesystems, so 3.51.0 added\nwinShmNode.bUseSharedLockHandle to restore the single-handle scheme -- but\nselects it with winIsUNCPath(), a string test for a leading \"\\\\\".\n\nA drive letter mapped to an SMB share is on a network filesystem and has no\n\"\\\\\" prefix, so the mitigation never engages and WAL locking fails with\nSQLITE_IOERR.\n\nImport the upstream fix as a local patch until we vendor a release that\ncontains it. It asks the OS rather than parsing the path:\nGetDriveTypeW() == DRIVE_REMOTE, for both \"X:\\...\" and \"\\\\?\\X:\\...\".\n\nOne deliberate divergence from upstream: the osGetDriveTypeW cast keeps\nWINAPI, since GetDriveTypeW is __stdcall and calling it through a __cdecl\npointer drifts ESP by 4 bytes per call on win32.\n\nBug 2016438 is preserved: \"\\\\?\\C:\\...\" on a local volume still takes the fast\npath. GetDriveTypeW() is called once per winShmNode, i.e. once per *-shm\nfile, not per lock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326859\n", "files": ["third_party/sqlite3/moz.yaml", "third_party/sqlite3/patches/bug-2067771-win-remote-volume-shm-locking.patch", "third_party/sqlite3/src/sqlite3.c"], "git_node": "015040ed43d182f94402a3eebbf86b728c30e3e6", "git_parents": ["9578413d691893f5772ae9849c0853b53cd10a2b"], "node": "c0bd1961ee5ac0b144cfcc072ad4a56748bf30e8", "parents": ["e2b258e75b6ac47773edef5af84796e6d9743b93"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063280 - Add ConnectionAllowlistsService stub. r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318460\n", "files": ["dom/security/ConnectionAllowlistsService.cpp", "dom/security/ConnectionAllowlistsService.h", "dom/security/moz.build", "layout/build/components.conf"], "git_node": "1bc68869329cfb7c614b07fc1e9dbd3c0f15de95", "git_parents": ["015040ed43d182f94402a3eebbf86b728c30e3e6"], "node": "1ad1edb2cfef7797dff5cfb9563ea6cd2ce84771", "parents": ["c0bd1961ee5ac0b144cfcc072ad4a56748bf30e8"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063280 - Empty ConnectionAllowlists class and PolicyContainer hookup. r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318461\n", "files": ["dom/security/ConnectionAllowlists.h", "dom/security/PolicyContainer.cpp", "dom/security/PolicyContainer.h", "dom/security/moz.build"], "git_node": "9be886da40e6c63cdf01c