.any.js.ini", "testing/web-platform/meta/webcodecs/video-encoder-hbd.https.any.js.ini", "testing/web-platform/meta/webcodecs/video-encoder-rescaling.https.any.js.ini", "testing/web-platform/meta/webcodecs/video-encoder.https.any.js.ini", "testing/web-platform/meta/webcodecs/videoFrame-copyTo-opaque-swizzle.https.any.js.ini", "testing/web-platform/meta/webcodecs/videoFrame-createImageBitmap.https.any.js.ini", "testing/web-platform/meta/webrtc/RTCRtpReceiver-video-jitterBufferTarget-stats.html.ini", "testing/web-platform/meta/webrtc/idlharness.https.window.js.ini"], "git_node": "aa899b63e1a88458e279c72d445346013e31fb3a", "git_parents": ["b8fb63cee2b04a2d8a0b8468e765f4706fbe03c9"], "node": "5b8a2e58d4f34d4e9300c4154f95464806f1674a", "parents": ["21ff3a1cd505182d1a741b346c755ea774676169"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072119 - Make the DNS negative-cache lifetime a pref and raise the default r=necko-reviewers,valentin\" for causing multiple Gtest failures\n\nThis reverts commit f87b4b438bf0104b610333b0a90b715c64f082b6.\n\nRevert \"Bug 2072119 - Add telemetry for why DNS lookups miss the cache r=necko-reviewers,valentin,mxinden\"\n\nThis reverts commit ee62863169fc4c5e4ab9936e61dad9a4343aaacd.\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/dns/HostRecordQueue.cpp", "netwerk/dns/metrics.yaml", "netwerk/dns/nsHostRecord.cpp", "netwerk/dns/nsHostRecord.h", "netwerk/dns/nsHostResolver.cpp", "netwerk/test/unit/test_dns_cache_miss_telemetry.js", "netwerk/test/unit/xpcshell.toml", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "04e912057237f1a6269c05001aaae60dce1584f2", "git_parents": ["aa899b63e1a88458e279c72d445346013e31fb3a"], "node": "101ff7b48bf58626c57a94a7a9a887b02337ed88", "parents": ["5b8a2e58d4f34d4e9300c4154f95464806f1674a"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072201 - Generate the StaticAnalysis backend during configure in the clang-tidy source-test tasks. r=firefox-build-system-reviewers,sergesanspaille\n\n`mach static-analysis check` runs config.status a second time to produce the\nstatic-analysis compile_commands.json, which means reading every moz.build\nfile twice per task. Listing StaticAnalysis in --build-backends makes configure\nproduce it directly, and _build_compile_db already handles that case. This\nalso drops the FasterMake and Clangd backends, which these tasks never use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326145\n", "files": ["taskcluster/scripts/misc/source-test-clang-setup.sh"], "git_node": "a5fa1b2149ac99298fa9f933d2b32771d22abe5e", "git_parents": ["04e912057237f1a6269c05001aaae60dce1584f2"], "node": "719228667eaa4f41abc2e48483edb93960b95f86", "parents": ["101ff7b48bf58626c57a94a7a9a887b02337ed88"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072515 - Add Canvas to the module owner file. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326394\n", "files": ["mots.yaml"], "git_node": "5b6b9005098c2a0e0df03c20d38146e7e3cf0ab6", "git_parents": ["a5fa1b2149ac99298fa9f933d2b32771d22abe5e"], "node": "d2f44c36d39f18693bc57ad858d22db0ba29c97d", "parents": ["719228667eaa4f41abc2e48483edb93960b95f86"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2045801: Expand SitePolicies to support containerized site data. r=bsmth,baku,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323260\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policies_getActivePolicies.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies.js", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "dom/ipc/gtest/ProcessIsolationTest.cpp", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_policy.js", "toolkit/components/contextualidentity/tests/unit/xpcshell.toml", "toolkit/components/enterprisepolicies/EnterprisePoliciesContent.sys.mjs", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/nsIEnterprisePolicies.idl"], "git_node": "1a1c3e68e94cede0ac9fd5bc6f5ef1b676f64d5a", "git_parents": ["5b6b9005098c2a0e0df03c20d38146e7e3cf0ab6"], "node": "acbb8278a05629195e4a7f66da2e3212fdf58ea8", "parents": ["d2f44c36d39f18693bc57ad858d22db0ba29c97d"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2045798: Support ephemeral containers in SitePolicies. r=bsmth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324911\n", "files": ["browser/components/enterprisepolicies/EphemeralContainerWatcher.sys.mjs", "browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/moz.build", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies_container.js"], "git_node": "253bd57861702d77c761e87eefa3a8cdfa61adea", "git_parents": ["1a1c3e68e94cede0ac9fd5bc6f5ef1b676f64d5a"], "node": "e25b3d748fa95adf2252807766f57a88f1fe67bb", "parents": ["acbb8278a05629195e4a7f66da2e3212fdf58ea8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2021819 - Let tagged PDF generation ride the trains. r=accessibility-platform-reviewers,Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326235\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "07ccee2cb2d9deee59261fdef8a54d5697981aa4", "git_parents": ["253bd57861702d77c761e87eefa3a8cdfa61adea"], "node": "6a526a5a2d0bb877b78e95c24ab9b00edc5c7cba", "parents": ["e25b3d748fa95adf2252807766f57a88f1fe67bb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072237 - Expand a directory even when a linter declares no extensions. r=linter-reviewers,sergesanspaille\n\nThe walk yields files with no extension too. That only affects a config declaring exclude_extensions, which no in-tree linter does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326230\n", "files": ["python/mozlint/mozlint/pathutils.py", "python/mozlint/test/filter/subdir2/noext", "python/mozlint/test/linters/global_no_extensions.yml", "python/mozlint/test/linters/global_payload.py", "python/mozlint/test/test_pathutils.py", "python/mozlint/test/test_types.py"], "git_node": "44edc14c03e51b2d5c583abe417872006784596f", "git_parents": ["07ccee2cb2d9deee59261fdef8a54d5697981aa4"], "node": "330860dd43f32854848487656962e854b385831f", "parents": ["6a526a5a2d0bb877b78e95c24ab9b00edc5c7cba"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072204 - Restore propagation disabled by enable_unstructured when enable_all_structured_loggers replaces the structured loggers. r=firefox-build-system-reviewers,sergesanspaille DONTBUILD\n\nenable_unstructured() disables propagation on the registered structured\nloggers, including the `mach` logger that command contexts log through.\nenable_all_structured_loggers() then removes the terminal handler from every\nlogger and only re-adds it to the root logger, leaving those loggers with no\nhandler and no propagation. Any command that calls enable_unstructured() and\nthen runs configure loses all of its INFO messages afterwards, and its\nWARNING messages are printed unformatted by Python's last-resort handler,\nwhich is why the clang-tidy tasks in CI log a literal \"{count} warnings\npresent.\".\n\nTrack the loggers whose propagation enable_unstructured() disabled and only\nrestore those, so a logger that deliberately does not propagate is left\nalone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326146\n", "files": ["python/mach/mach/logging.py", "python/mach/mach/test/test_logger.py"], "git_node": "36e5679bbdf417f092084d48f6e84c2a94817665", "git_parents": ["44edc14c03e51b2d5c583abe417872006784596f"], "node": "9f80289c3220ac134ac9f1ac7f0fda9695e580e7", "parents": ["330860dd43f32854848487656962e854b385831f"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071976 - update wpt metadata\n", "files": ["testing/web-platform/meta/webaudio/the-audio-api/the-audioparam-interface/k-rate-dynamics-compressor-connections.html.ini"], "git_node": "15b7c04588e0e5fcf24ec07ab63bd7f22b0badaa", "git_parents": ["36e5679bbdf417f092084d48f6e84c2a94817665"], "node": "fc6115100796700fb3b5ab4c1ef19bfc609d0e0c", "parents": ["9f80289c3220ac134ac9f1ac7f0fda9695e580e7"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071976 - Update metadata for html/semantics/embedded-content/media-elements/preserves-pitch.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326443\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/media-elements/preserves-pitch.html.ini"], "git_node": "35ea9e06ab70346a54a4e1c3fa015e3a8baca1d0", "git_parents": ["15b7c04588e0e5fcf24ec07ab63bd7f22b0badaa"], "node": "9280b58de9eaa9c2aae1dfba8013ec7a55173976", "parents": ["fc611510079670