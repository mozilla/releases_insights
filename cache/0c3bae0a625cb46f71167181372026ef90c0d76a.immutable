22e234b0f9b083dfd778445904f7e7af57a305\nte -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nth -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\ntl -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\ntr -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\ntrs -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nuk -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nur -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nuz -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nvi -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nwo -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nxh -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nzam -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nzh-CN -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\nzh-TW -\u003e db22e234b0f9b083dfd778445904f7e7af57a305\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "ab46b0f5d35988e098a01d1f40b55b86ce7acd42", "git_parents": ["5454e6466f19770ca6f239ed99138bf31576fc32"], "node": "3bf6739a54f4e1c942d293792ba9a7afefba36fe", "parents": ["6eae05ec2663cc75249e3d6b948be7ffd5c175a0"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057685 - Part 4: Add GeckoView backend support for full page screenshot API r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318616\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "widget/android/GeckoViewSupport.h", "widget/android/nsWindow.cpp"], "git_node": "64cf3d97f86d0660adebd4b95418fb91a61b4a8d", "git_parents": ["ab46b0f5d35988e098a01d1f40b55b86ce7acd42"], "node": "71dd86ccd6611ff5ea24e11297c340c3c0e30996", "parents": ["3bf6739a54f4e1c942d293792ba9a7afefba36fe"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057630 Part 1 - Simplify implementation of ScrollContainerFrame::GetPositionOfChildIgnoringScrolling(). r=layout-reviewers,emilio\n\nThis patch does not change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324786\n", "files": ["layout/generic/ScrollContainerFrame.h"], "git_node": "56ab4b6060978f5fb5b32ac90287990e2d79e5e5", "git_parents": ["64cf3d97f86d0660adebd4b95418fb91a61b4a8d"], "node": "355adf5397d625efc2182131a74eabab942ce12f", "parents": ["71dd86ccd6611ff5ea24e11297c340c3c0e30996"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057630 Part 2 - Return the result in a struct from StickyScrollContainer::ComputeStickyLimits(). r=layout-reviewers,emilio\n\n`ComputeStickyLimits()` returned its two rectangles through outparams.\nReturn them in a struct instead, which is easier to use at the call\nsites.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324787\n", "files": ["layout/generic/StickyScrollContainer.cpp", "layout/generic/StickyScrollContainer.h"], "git_node": "f92e5fb2fc400f9bc78072055b5a61904dd00ac3", "git_parents": ["56ab4b6060978f5fb5b32ac90287990e2d79e5e5"], "node": "b66a7330e93af082475c5a6d605354e874023422", "parents": ["355adf5397d625efc2182131a74eabab942ce12f"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057630 Part 3 - Add two helpers in StickyScrollContainer. r=layout-reviewers,emilio\n\n`ComputeTranslationIgnoringScrolling()` is required for the next part.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324788\n", "files": ["layout/generic/StickyScrollContainer.cpp", "layout/generic/StickyScrollContainer.h"], "git_node": "cb01fd05597256efac0bcc49e79ef8400e05c3c4", "git_parents": ["f92e5fb2fc400f9bc78072055b5a61904dd00ac3"], "node": "52dc9445ef31286fd5235c478429f59913100931", "parents": ["b66a7330e93af082475c5a6d605354e874023422"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057630 Part 4 - Make OffsetCalculator() take a position getter callable. r=layout-reviewers,dshin\n\nIt allows the caller to pass a lambda to accumulate a difference of\ntwo position getters in one walk of the frame tree, which is needed by\nthe next part.\n\nThis patch does not change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325534\n", "files": ["layout/generic/nsIFrame.cpp"], "git_node": "888d43dc659c30e6557cc18dcb508ef032860222", "git_parents": ["cb01fd05597256efac0bcc49e79ef8400e05c3c4"], "node": "91d84efaba92c8861575e1fe71d65f961a951f46", "parents": ["52dc9445ef31286fd5235c478429f59913100931"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057630 Part 5 - Make anchor's scroll offset computation aware of sticky positioning. r=layout-reviewers,dshin\n\nThis patch introduces `GetPositionIgnoringScrollingAndSticky()` and\n`GetOffsetToIgnoringScrollingAndSticky()`, and uses the latter in all\nthe helpers in `AnchorPositioningUtils` instead of\n`GetOffsetToIgnoringScrolling()`. As a result, an anchor positioned\nelement whose anchor is sticky is now laid out against the sticky\nanchor's scroll-ignored position.\n\n`GetScrollOffsetFor()` then becomes `GetScrollOffsetTo()`, which\naccumulates the difference between the anchor's scroll-ignored and\nactual position in a single walk of the frame tree. Because both\naccessors are evaluated on the same frames, any scroll container that\nmoves the anchor and the absolute containing block together cancels\nout.\n\nThat eliminates the need to check the stop conditions in the old code,\nand it works when the absolute containing block is fragmented or has\nIB-split siblings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324789\n", "files": ["layout/base/AnchorPositioningUtils.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "testing/web-platform/meta/css/css-anchor-position/anchor-scroll-to-sticky-005.html.ini"], "git_node": "e1b54aa821eca401f70ca1ca8cc28f42184bedcc", "git_parents": ["888d43dc659c30e6557cc18dcb508ef032860222"], "node": "42b55019de758ff3098c6e3a3cdc89141fff2c6c", "parents": ["91d84efaba92c8861575e1fe71d65f961a951f46"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057630 Part 6 - Add WPT to exercise sticky and transform. r=layout-reviewers,dshin\n\n`anchor-scroll-to-sticky-006.html` renders the same as\n`anchor-scroll-to-sticky-005`. The only difference between the two\ntests is that 006 has an identity `scale: 1` added to `#sticky` to\nexercise the anchor transform code path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325535\n", "files": ["testing/web-platform/tests/css/css-anchor-position/anchor-scroll-to-sticky-006.html"], "git_node": "7c24ec41235c1b4f1fc61bdd0884fb60c581b3dc", "git_parents": ["e1b54aa821eca401f70ca1ca8cc28f42184bedcc"], "node": "4b7c887d92a4cc3657c9bd49e0ed32bccb751650", "parents": ["42b55019de758ff3098c6e3a3cdc89141fff2c6c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071614 - Update JDK 17 to version 17.0.20.1+1. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325616\n", "files": ["python/mozboot/mozboot/android.py", "python/mozbuild/mozbuild/test/configure/test_checks_configure.py", "taskcluster/kinds/toolchain/android.yml"], "git_node": "73d0b06bfb106f0b27be72ea48c3f6743938d81a", "git_parents": ["7c24ec41235c1b4f1fc61bdd0884fb60c581b3dc"], "node": "45d98e3fe187788ca93aaf3afd1262e938325e70", "parents": ["4b7c887d92a4cc3657c9bd49e0ed32bccb751650"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071614 - Update JDK 8 to version 8u502-b07. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325617\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "fccbd9a5a25d007fac1dc3333af8544e6da02f98", "git_parents": ["73d0b06bfb106f0b27be72ea48c3f6743938d81a"], "node": "f45b0818f35869df0c4c3ec0facabec5ba343da7", "parents": ["45d98e3fe187788ca93aaf3afd1262e938325e70"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057685 - Part 4: Add GeckoView backend support for full page screenshot API r=geckoview-reviewers,ohall\" for causing build bustages on TestCOLRv1.\n\nThis reverts commit 64cf3d97f86d0660adebd4b95418fb91a61b4a8d.\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "widget/android/GeckoViewSupport.h", "widget/android/nsWindow.cpp"], "git_node": "53b235ad1073bb69a55fd02942a6d7db144980c4", "git_parents": ["fccbd9a5a25d007fac1dc3333af8544e6da02f98"], "node": "0ab3e2493d78bffb7571ca5721689ac6e4299242", "parents": ["f45b0818f35869df0c4c3ec0facabec5ba343da7"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071557 - Keep color-font palette entries as hb_color_t to reduce memory footprint. r=firefox-style-system-reviewers,emilio\" for causing build bustages on TestCOLRv1.\n\nThis reverts commit 3cb9d005f61d855fc5aa4e7dd2bbfc8b01558c25.\n", "files": ["gfx/thebes/COLRFonts.cpp", "gfx/thebes/COLRFonts.h", "gfx/thebes/FontPaletteCache.h", "layout/style/GeckoBindings.cpp"], "git_node": "6dc230d73f0e51c52948f99007ee12cb61bc3804", "git_parents": ["53b235ad1073bb69a55fd02942a6d7db144980c4"], "node": "67b9cba7a4c99bfe2f7551d630b111496405348b", "parents": ["0ab3e2493d78bffb7571ca5721689ac6e4299242"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1992418 - add runtime.getVersion() r=robwu\" for causing mochitests failures at apis.html\n\nThis reverts commit df22bd790510a18fd7514669670b453ab998dba5.\n", "files": ["toolkit/components/extensions/child/ext-runtime.js", "toolki