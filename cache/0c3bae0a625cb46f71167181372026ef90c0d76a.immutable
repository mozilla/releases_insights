kit/components/pictureinpicture/content/player.js", "toolkit/components/pictureinpicture/content/player.xhtml", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_controlButtonClickFocus.js", "toolkit/components/pictureinpicture/tests/browser_controlsTabOrder.js", "toolkit/components/pictureinpicture/tests/head.js"], "git_node": "f1b15632b02ffd757e5c2d21bbae275e433db8d3", "git_parents": ["c620092b5902d70b8b6b34e06ee0011fd668d445"], "node": "839a55ec904ca236b44e8c247183d71a7a50ec5d", "parents": ["04ad6479e182155d3752c82c0603477d107806d0"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2073222 - Check whether non-scaling-stroke matrix is singular and if so, skip bbox calculation r=dholbert,firefox-svg-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327136\n", "files": ["layout/svg/SVGGeometryFrame.cpp", "layout/svg/crashtests/2073222.html", "layout/svg/crashtests/crashtests.list"], "git_node": "9d27e9cfccbef6b3db720132b621c678b16c0a44", "git_parents": ["f1b15632b02ffd757e5c2d21bbae275e433db8d3"], "node": "b0271576f61b6046db877cfb200ce7f0fe62a25b", "parents": ["839a55ec904ca236b44e8c247183d71a7a50ec5d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073235 - Update intellij-markdown to version 0.7.14. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327135\n", "files": ["gradle/libs.versions.toml"], "git_node": "2f52bf6951930dc94abed7ff1418de80882caaaf", "git_parents": ["9d27e9cfccbef6b3db720132b621c678b16c0a44"], "node": "89e378530ff918892f8be017cfae11408f9d8783", "parents": ["b0271576f61b6046db877cfb200ce7f0fe62a25b"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2072086 - Harden ApplicationExitInfo callers against OEM AMS throwing IllegalArgumentException. r=android-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327171\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/ApplicationExitInfoMetrics.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/telemetry/TelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/perf/ApplicationExitInfoMetricsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/telemetry/TelemetryMiddlewareTest.kt"], "git_node": "797a6830fe241476e3ca726af2d47fb722cb9a3e", "git_parents": ["2f52bf6951930dc94abed7ff1418de80882caaaf"], "node": "3b40fd7221a8072950c115a3884f601055200682", "parents": ["89e378530ff918892f8be017cfae11408f9d8783"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2073163 - Fall back to strtof/strtod in wasm2c on openbsd. r=shravanrn\n\nhttps://github.com/WebAssembly/wabt/commit/b7ad849395485e6adf9ab2bfad8226741038690d\nswitched from strtof/strtod to strtof_l/strtod_l, which are not\navailable on OpenBSD.\n\nRevert to strtof/strtod on OpenBSD.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327199\n", "files": ["config/external/wasm2c_sandbox_compiler/moz.yaml", "config/external/wasm2c_sandbox_compiler/openbsd-no-strtod-l.patch", "third_party/wasm2c/src/literal.cc"], "git_node": "5d79a457e125b8122820836969d974fcfda84107", "git_parents": ["797a6830fe241476e3ca726af2d47fb722cb9a3e"], "node": "7df0b44d9ef759c17949c66ae9fbee1e2fc6cae6", "parents": ["3b40fd7221a8072950c115a3884f601055200682"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2072952 - Keep wasm2c guard-page bounds checking enabled under clang-cl. r=shravanrn\n\nclang-cl doesn't define __GNUC__, but does accept the GCC asm barriers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327204\n", "files": ["config/external/wasm2c_sandbox_compiler/allow-guard-pages-with-clang-cl.patch", "config/external/wasm2c_sandbox_compiler/moz.yaml", "third_party/wasm2c/src/prebuilt/wasm2c_simd_source_declarations.cc", "third_party/wasm2c/src/prebuilt/wasm2c_source_declarations.cc", "third_party/wasm2c/wasm2c/wasm-rt.h"], "git_node": "c06b0fa43fe184faf72063f06e2acd594b338c35", "git_parents": ["5d79a457e125b8122820836969d974fcfda84107"], "node": "13697ce9304e58843b1a9ab859026520ddab0248", "parents": ["7df0b44d9ef759c17949c66ae9fbee1e2fc6cae6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065319 - Retry HTTP/2 and HTTP/3 requests after an unclean session shutdown r=necko-reviewers,valentin,kershaw,chumphreys\n\nWhen an H2 or H3 session goes away without a clean GOAWAY-based shutdown\n(e.g. the server silently drops a pooled connection), streams that never\nreceived any response data were closed with NS_ERROR_ABORT, which is not\nretried. Chrome retries in this situation as long as the connection was\nreused and no response headers were received yet.\n\nIntroduce NS_ERROR_NET_UNCLEAN_SHUTDOWN for this case and treat it like\nNS_ERROR_NET_RESET in nsHttpTransaction::Close's stale-connection retry\nlogic, so the request is retried once on a new connection instead of\nfailing outright.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323730\n", "files": ["docshell/base/metrics.yaml", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellTelemetryUtils.cpp", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/test/unit/test_h2_unclean_shutdown_retry.js", "netwerk/test/unit/xpcshell.toml", "toolkit/components/telemetry/Histograms.json", "xpcom/base/ErrorList.py"], "git_node": "0f2b12dfb6a2f2ca95d273740f784302bcda9c82", "git_parents": ["c06b0fa43fe184faf72063f06e2acd594b338c35"], "node": "d9605212bc6c2aa5e9bdbe894d51a15a56e67835", "parents": ["13697ce9304e58843b1a9ab859026520ddab0248"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072637 - Drop the two wrapper elements between the address bar's results view and its results list. r=adw,desktop-theme-reviewers,emilio\n\nProton's gutter bleed and open-state border move from the inner wrapper onto the results list, which they wrapped directly; nothing else styled or scripted the wrappers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326684\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "ffc3dbbbaf9915153aed1921c1ce0322263521e4", "git_parents": ["0f2b12dfb6a2f2ca95d273740f784302bcda9c82"], "node": "965c11a8f7fa6304d9c04a41e2e66e1ff6e0def0", "parents": ["d9605212bc6c2aa5e9bdbe894d51a15a56e67835"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2073342. Record fuzz in tests/avif/animated-avif-timeout.html. r=gfx-reviewers,lsalzman\n\nThe test is testing that we show the final frame of the animation. The fuzz is because we are 3 off in the blue channel but otherwise correct. Recording it in the html file means that wpt.fyi results report us as passing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327234\n", "files": ["testing/web-platform/meta/avif/animated-avif-timeout.html.ini", "testing/web-platform/tests/avif/animated-avif-timeout.html"], "git_node": "3233e6663a3d15b31044218d1493880f24f1ca1d", "git_parents": ["ffc3dbbbaf9915153aed1921c1ce0322263521e4"], "node": "2f25f2c518508b104c3e15d2b6ddf0f33422bf30", "parents": ["965c11a8f7fa6304d9c04a41e2e66e1ff6e0def0"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073216 - Minimize what directories Android Studio indexes r=jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327041\n", "files": ["build.gradle"], "git_node": "63c9ae0090d3f22c3ef41cc3339a05562fc6989c", "git_parents": ["3233e6663a3d15b31044218d1493880f24f1ca1d"], "node": "bf58f291dbebb091d34245d7fe3fb058e7496102", "parents": ["2f25f2c518508b104c3e15d2b6ddf0f33422bf30"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071380 - Make the bookmarks and notifications toolbars part of the titlebar r=emilio,desktop-theme-reviewers,tabbrowser-reviewers,kcochrane,reusable-components-reviewers,akulyk\n\nPut the toolbar background/text color back on the #notifications-toolbar\nfor LWTs since they may have low contrast now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326730\n", "files": ["browser/components/tabbrowser/content/tab-bar-visibility.js"], "git_node": "ed4b01abce61b4f8318f25cd41921ec008e3d660", "git_parents": ["63c9ae0090d3f22c3ef41cc3339a05562fc6989c"], "node": "c50f7e42ed37265788a0c463f7f06a67d5e8b14b", "parents": ["bf58f291dbebb091d34245d7fe3fb058e7496102"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072952, Bug 2073163 - Keep wasm2c guard-page bounds checking enabled under clang-cl. r=shravanrn\" for causing Linting failures.\n\nThis reverts commit c06b0fa43fe184faf72063f06e2acd594b338c35.\n\nRevert \"Bug 2073163 - Fall back to strtof/strtod in wasm2c on openbsd. r=shravanrn\"\n\nThis reverts commit 5d79a457e125b8122820836969d974fcfda84107.\n", "files": ["config/external/wasm2c_sandbox_compiler/allow-guard-pages-with-clang-cl.patch", "config/external/wasm2c_sandbox_compiler/moz.yaml", "config/external/wasm2c_sandbox_compiler/openbsd-no-strtod-l.patch", "third_party/wasm2c/src/literal.cc", "third_party/wasm2c/src/prebuilt/wasm2c_simd_source_declarations.cc", "third_party/wasm2c/src/prebuilt/wasm2c_source_declarations.cc", "third_party/wasm2c/wasm2c/wasm-rt.h"], "git_node": "01d3aa54a2c11c76345a231a8c9f774a69ac3a72", "git_parents": ["ed4b01abce61b4f8318f25cd41921ec008e3d660"], "node": "8089b13fa019ffb0df824ef4703e7e34c3872b81", "parents": ["c50f7e42ed37265788a0c463f7f06a67d5e8b14b"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072101 part 2: Use RefPtr for CachedTableAccessible. r=accessibility-platform-reviewers,eeejay\" for causing failures complaining about RemoteProcessMonitor.\n\nThis reverts commit 1c23c71c5994a6eac27b4ba934146c8f8c48af2f.\n\nRevert \"Bug 2072101 part 1: Make Accessible support RefPtr. r=accessibility-platform-reviewers,eeejay\"\n\nThis reverts commit 43fae04566e55b0cbcc5f30c627b3200ace92ec8.\n", "files": ["accessible/atk/nsMaiInterfaceComponent.cpp", "accessible/base/CachedTableAccessible.h", "accessible/basetypes/Accessible.h", "accessible/ipc/RemoteAccessible.h", "accessible/mac/mozAccessible.mm", "accessible/windows/ia2/ia2Accessible.cpp", "accessible/windows/uia/uiaRawElmProvider.cpp", "accessible/xpcom/xpcAccessible.cpp"], "git_node": "3de02c0ca57a497ee47e755e2c803f0fdf65331b", "git_parents": ["01d3aa54a2c11c76345a231a8c9f774a69ac3a72"], "node": "ce8d7a2ea7bfdf79bf99307fe8ba9d9362d015ef", "parents": ["8089b13fa019ffb0df824ef4703e7e34c3872b81"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1982182 - Add WPT for a \"Content-Disposition\" response header appearing multiple times. r=necko-reviewers,valentin\n\nCovers identical and differing duplicate values over HTTP/1.1 (.asis\nresources) and HTTP/2 (an .h2.py handler).  The tests are tentative: RFC\n6266 does not define Content-Disposition as a list-based field and says\nnothing about repeated field lines, so the assertions follow the Fetch\nheader list model (both field lines kept, combined with \", \", not a\nnetwork error).  Current failures are recorded in the metadata.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323979\n", "files": ["testing/web-platform/meta/fetch/content-disposition/multiple-content-disposition.tentative.any.js.ini", "testing/web-platform/meta/fetch/content-disposition/multiple-content-disposition.tentative.h2.window.js.ini", "testing/web-platform/tests/fetch/content-disposition/README.md", "testing/web-platform/tests/fetch/content-disposition/multiple-content-disposition.tentative.any.js", "testing/web-platform/tests/fetch/content-disposition/multiple-content-disposition.tentative.h2.window.js", "testing/web-platform/tests/fetch/content-disposition/resources/differing-duplicates.asis", "testing/web-platform/tests/fetch/content-disposition/resources/identical-duplicates.asis", "testing/web-platform/tests/fetch/content-disposition/resources/multiple-content-disposition.h2.py", "testing/web-platform/tests/fetch/content-disposition/resources/multiple-content-disposition.js"], "git_node": "5a2584a33a88c1972afb0a5263f56f4179c500f8", "git_parents": ["3de02c0ca57a497ee47e755e2c803f0fdf65331b"], "node": "6aac8a255acf5bcb3a203f72c9da5f2faf6c7e01", "parents": ["ce8d7a2ea7bfdf79bf99307fe8ba9d9362d015ef"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026894 - Let a WebSocket upgrade fall back to the other address family when its first endpoint dies mid-handshake. r=necko-reviewers,kershaw\n\nA wss:// connection to a dual-stack host failed with\nNS_ERROR_WEBSOCKET_CONNECTION_REFUSED when the preferred (IPv6) endpoint\naccepted the TCP connection but died before responding, while https:// to\nthe same host fell back to IPv4.  Two fixes:\n\nnsHttpTransaction::Close would not restart a transaction carrying\nNS_HTTP_STICKY_CONNECTION.  Upgrades set that flag to bind the upgraded\nconnection, not for connection-based auth, and nothing is bound before the\nresponse arrives, so allow the restart until then.\n\nHappyEyeballsConnectionAttempt aborted the race for any security-module\nerror, but NSPR errors such as PR_END_OF_FILE_ERROR are tagged with that\nmodule whenever NSS drives the socket.  Map them back to network-module\ncodes before classifying so the race continues; genuine NSS errors still\nabort.  This also fixes plain https:// on the Happy Eyeballs path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323973\n", "files": ["netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/test/unit/test_websocket_ipv6_fallback.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "e41290334755fcdc09b81dc38b2e6f8314e693f4", "git_parents": ["5a2584a33a88c1972afb0a5263f56f4179c500f8"], "node": "366249ef6fb4f93e92680f6b1d5720c58f2632da", "parents": ["6aac8a255acf5bcb3a203f72c9da5f2faf6c7e01"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2070800 - part 1: Make native IME handlers dispatch `eSetSelection` event via `TextEventDispatcher` r=m_kato,ltenenbaum,geckoview-reviewers\n\nTo consider whether a new composition change can merge with a preceding\ncommit in `TextEventDispatcher`, `TextEventDispatcher` needs to know\nwhether a selection change is intended during them. Therefore, all\nnative IME handlers should dispatch `eSetSelection` via\n`TextEventDispatcher`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326038\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/events/ContentEventHandler.cpp", "dom/events/ContentEventHandler.h", "dom/events/IMEContentObserver.cpp", "dom/html/EditContext.cpp", "widget/ContentCache.cpp", "widget/EventForwards.h", "widget/IMEData.h", "widget/TextEventDispatcher.cpp", "widget/TextEventDispatcher.h", "widget/TextEvents.h", "widget/android/GeckoEditableSupport.cpp", "widget/cocoa/TextInputHandler.mm", "widget/gtk/IMContextWrapper.cpp", "widget/nsGUIEventIPC.h", "widget/windows/TSFTextStore.cpp", "widget/windows/TSFTextStore.h"], "git_node": "d4d817f7f33bf89c78ccd216eed59af8253bb3b0", "git_parents": ["e41290334755fcdc09b81dc38b2e6f8314e693f4"], "node": "e6001ed894b48ec465e07133434b6220c22b0d63", "parents": ["366249ef6fb4f93e92680f6b1d5720c58f2632da"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2070800 - part 2-1: Make new `enum class`es for replacing `bool` members of `WidgetContentCommandEvent` members r=ltenenbaum\n\nThis is a preparation patch for avoiding the new methods added in the\nnext patch not to take multiple `bool` arguments. So, the callers of\nthe methods will be clearer about what they specify.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326050\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/events/EventStateManager.cpp", "dom/html/EditContext.cpp", "dom/html/EditContext.h", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/PBrowser.ipdl", "editor/libeditor/EditorBase.h", "widget/ContentCache.cpp", "widget/EventForwards.h", "widget/MiscEvents.h", "widget/cocoa/TextInputHandler.h", "widget/cocoa/TextInputHandler.mm", "widget/cocoa/nsCocoaWindow.mm", "widget/nsGUIEventIPC.h", "widget/windows/nsWindow.cpp"], "git_node": "1a16920a87f94e19d74f54905a6684bc4649d045", "git_parents": ["d4d817f7f33bf89c78ccd216eed59af8253bb3b0"], "node": "1c39b1e240f3f2d53beff6fa1986a7738230794f", "parents": ["e6001ed894b48ec465e07133434b6220c22b0d63"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2070800 - part 2-2: Make native event handlers dispatch `WidgetContentCommandEvent` via `TextEventDispatcher` r=m_kato,geckoview-reviewers\n\nSame as the `eSetSelection` event, some events of\n`WidgetContentCommandEvent` causes a text input which should not\npreserve composition. Therefore, these events should be dispatched via\n`TextEventDispatcher` too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326039\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/ipc/BrowserChild.cpp", "widget/TextEventDispatcher.cpp", "widget/TextEventDispatcher.h", "widget/android/GeckoEditableSupport.cpp", "widget/cocoa/TextInputHandler.mm", "widget/cocoa/nsCocoaWindow.mm", "widget/gtk/IMContextWrapper.cpp", "widget/windows/KeyboardLayout.cpp", "widget/windows/nsWindow.cpp"], "git_node": "692ffa8602788012f995b6ea61dadf38585dd09d", "git_parents": ["1a16920a87f94e19d74f54905a6684bc4649d045"], "node": "49ad8bfd3acc23cbbadb519c49d2d58241b0c10b", "parents": ["1c39b1e240f3f2d53beff6fa1986a7738230794f"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2070800 - part 3: Assert dispatcher of `WidgetSelectionEvent` and `WidgetContentCommandEvent` r=ltenenbaum\n\nLet's assert if they are not dispatched via `TextEventDispatcher`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326040\n", "files": ["dom/events/EventStateManager.cpp", "dom/events/TextComposition.cpp", "widget/MiscEvents.h", "widget/TextEventDispatcher.cpp", "widget/TextEvents.h"], "git_node": "6e42086fcb7e6932b18fa5ed0966f5c5f5f90092", "git_parents": ["692ffa8602788012f995b6ea61dadf38585dd09d"], "node": "194fd5be9ced361ed688a7788360d140d7a0dc8d", "parents": ["49ad8bfd3acc23cbbadb519c49d2d58241b0c10b"], "tags": []}, {"author": "Anand Balaji \u003canandb@cs.utexas.edu\u003e", "branch": "default", "desc": "Bug 2072754 - Use a call in OSREntry sequence on x64 r=jandem,iain\n\nThe OSR Entry sequence on x64 currently pushes a return address onto the\nstack, then jumps into JIT code. Use a call instead to push a fake\nreturn address onto the stack that jumps to the intended return\nsequence. This fixes a potential shadow stack mismatch when returning\nfrom the JIT.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326754\n", "files": ["js/src/jit/x64/Trampoline-x64.cpp"], "git_node": "43e0d2d3e9d724292b0db8debde4bb137a1d2343", "git_parents": ["6e42086fcb7e6932b18fa5ed0966f5c5f5f90092"], "node": "2d69da7321b47f1709a38001bcd17ac3a2fcd721", "parents": ["194fd5be9ced361ed688a7788360d140d7a0dc8d"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065729 - Use std::source_location in CheckedUnsafePtr. r=dom-storage-reviewers,janv\n\nThe bt_function/bt_file/bt_line macros here hand roll what std::source_location\nprovides now that the build sysroot ships libstdc++ 11. They were also never\nundefined, so three very generic names leaked into every translation unit\nincluding this header.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320653\n", "files": ["dom/quota/CheckedUnsafePtr.h"], "git_node": "338e6e715a03a3ccce7d6a1f4ef8d91dcca150d1", "git_parents": ["43e0d2d3e9d724292b0db8debde4bb137a1d2343"], "node": "8964e73d124a4a8317920dd21fbef694b3d25d53", "parents": ["2d69da7321b47f1709a38001bcd17ac3a2fcd721"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973646 - Use std::source_location in WebrtcLocation. r=webrtc-reviewers,pehrsons\n\nThe file's own comment asked for this once std::source_location was available,\nwhich it is now that the build sysroot ships libstdc++ 11.\n\nThe MSVC fallback in MOZ_HAS_BUILTIN goes away with the macros; we build this\nwith clang everywhere.\n\nmLine becomes uint32_t, which is what a source location actually carries and\nlets the last cast go. That is invisible to libwebrtc: our override does not\nexpose upstream's accessors at all, so third party code only ever passes a\nLocation on, and the one consumer that reads the members,\nWebrtcTaskQueueWrapper, formats mLine with fmt and tests it for zero.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320654\n", "files": ["dom/media/webrtc/libwebrtc_overrides/api/location.h"], "git_node": "7587ade26b1147f6c6d2338fa017109e581be9c6", "git_parents": ["338e6e715a03a3ccce7d6a1f4ef8d91dcca150d1"], "node": "91ee48d51509979177f61366edd571d6fa868045", "parents": ["8964e73d124a4a8317920dd21fbef694b3d25d53"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065730 - Add a profiler marker per ClearOnShutdown entry. r=xpcom-reviewers,mccr8,nika\n\nKillClearOnShutdown walks a list of type erased observers, so a profile shows\nthe aggregate cost of a phase's clearing with no way to tell which entry is\nresponsible, and nothing at all about which entries are registered for a phase.\n\nRecord the calling location in ShutdownObserver and emit a marker around each\nentry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320448\n", "files": ["xpcom/base/ClearOnShutdown.cpp", "xpcom/base/ClearOnShutdown.h"], "git_node": "01a1cfb83ac102bb597fab8303bd24e4adf8557e", "git_parents": ["7587ade26b1147f6c6d2338fa017109e581be9c6"], "node": "eeff1600b4e5583752b89806bd5fe7039c9e6cb3", "parents": ["91ee48d51509979177f61366edd571d6fa868045"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Name get_partner_config_by_url instead of linking to it r=firefox-source-docs-reviewers,taskgraph-reviewers,releng-reviewers,ahal DONTBUILD\n\ntaskgraph.util is not part of the generated Python API documentation, so the\nlink could never resolve.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325702\n", "files": ["taskcluster/docs/partner-attribution.md", "taskcluster/docs/partner-repacks.md"], "git_node": "272d370a13ef7a61b780280526c75aaf5a8a5309", "git_parents": ["01a1cfb83ac102bb597fab8303bd24e4adf8557e"], "node": "495b81ddb2fcca53c3248a09655da018b2c270fe", "parents": ["eeff1600b4e5583752b89806bd5fe7039c9e6cb3"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2067174 - Add missing debug-mode stackmaps for wasm::Trap::OutOfBounds.  r=bvisness.\n\nThis patch adds stackmaps associated with linear-memory instructions that might\ntrap if their bounds check fails.\n\nThe patch is unfortunately huge, because involves changes to the assembler\ninterface for each architecture.  But it is conceptually simple:\n\n(1) All assembler methods that generate instructions that might do a\n    Trap::OutOfBounds now return a FaultingCodeRange to describe the trapping\n    instruction.  These changes are the majority of the patch.  They are\n    generally very simple and involve capturing and returning the\n    FaultingCodeRange created by low-level assembler routines, or,\n    alternatively, by creating them directly from the MacroAssembler\n    currentOffset() values.\n\n(2) The FaultingCodeRanges returned by (1) arrive at one of the many\n    create-a-linear-memory-access routines in WasmBCMemory.cpp.  There, they\n    are handed to new routine MaybeAddDebugStackMapForTrapOOB.\n\n(3) MaybeAddDebugStackMapForTrapOOB does nothing when not compiling for\n    debugging.  When compiling for debugging, it creates a StackMap and\n    registers it at the FaultingCodeRanges from (2).\n\nThat's all.\n\nA bit more detail on the above:\n\n* For some routines in (1), multiple `appendAndVerify` (\"register a Trap\")\n  calls have been merged and moved to the end of the routine.\n\n* For (2), new routines MaybeAddDebugStackMapForTrapOOB and\n  MaybeAddDebugStackMapPairForTrapOOB.  The whole point of this patch is to\n  cause data to flow to these routines.\n\n* MacroAssembler.h and all other assembler header files: many routines that\n  used to return `void` now return a `FaultingCodeRange`.  Eg wasmLoad/Store\n  routines, also all routines for atomics in linear memory, eg\n  wasmCompareExchange.  Routines that produce two 32-bit transactions on 32-bit\n  targets return a `FaultingCodeRangePair`.\n\n* In a few places, routines on 32-bit targets that produce a 64-bit value in\n  two 32-bit registers, have been renamed from `*64*` to `*32x2*`.  This is\n  because it is not allowed, in C++, to have two routines of the same name that\n  differ only in their return type.  Yet the previous point makes that\n  necessary.  Eg:\n\n  FaultingCodeRange wasmLoadI64(const wasm::MemoryAccessDesc& access,\n                                Operand srcAddr, Register64 out)\n      DEFINED_ON(x64);\n\n  FaultingCodeRangePair wasmLoadI32x2(const wasm::MemoryAccessDesc& access,\n                                      Operand srcAddr, Register64 out)\n      DEFINED_ON(x86);\n\n  These have identical argument types, differing only in the return type.\n  Hence they have to have different names.  The MacroAssembler.h macro magic\n  requires them both to be in scope simultaneously despite being used on\n  different targets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321881\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/CodeGenerator-arm.cpp", "js/src/jit/arm/MacroAssembler-arm.cpp", "js/src/jit/arm/MacroAssembler-arm.h", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared.cpp", "js/src/jit/mips64/MacroAssembler-mips64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jit/wasm32/MacroAssembler-wasm32.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared.h", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/MacroAssembler-x86.cpp", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "0209509759346c7d41d2e77d0abe87041f887829", "git_parents": ["272d370a13ef7a61b780280526c75aaf5a8a5309"], "node": "74bca2de371c8c4a217a1d90e8c8b116440ca34e", "parents": ["495b81ddb2fcca53c3248a09655da018b2c270fe"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072388 - Use run-if for manifest-wide scope conditions in manifests that also annotate individual tests. r=ci-and-tooling,accessibility-platform-reviewers,firefox-desktop-core-reviewers ,extension-reviewers,credential-management-reviewers,niklas,robwu,Jamie,aryx,mossop,dimi\n\nThese were left out of the earlier conversions because a per-test run-if used to\nreplace the manifest default rather than narrow it, so moving the condition into\nrun-if would have stopped applying it to those tests. Bug 1989470 makes the two\nlevels combine, so the condition can go where it belongs without touching the\nper-test annotations.\n\nThe static analysis manifest gets \"ccov\" and \"opt\" rather than the literal\ninverse, because the linter asks for the remaining build types instead of\n\"!debug\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326542\n", "files": ["accessible/tests/browser/windows/ia2/browser.toml", "browser/base/content/test/static/browser.toml", "toolkit/components/backgroundtasks/tests/xpcshell/xpcshell.toml", "toolkit/components/downloads/test/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/native_messaging.toml", "toolkit/components/passwordmgr/test/mochitest/mochitest.toml", "toolkit/components/reputationservice/test/unit/xpcshell.toml", "toolkit/profile/test/xpcshell/xpcshell.toml"], "git_node": "a259700d20471e221f124df1dbe45fdf05d6fb66", "git_parents": ["0209509759346c7d41d2e77d0abe87041f887829"], "node": "a235aeb68f84862d1ba492b67dcddb7d4c30b4ee", "parents": ["74bca2de371c8c4a217a1d90e8c8b116440ca34e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072956 - revert partials to mbsdiff on esr153. r=releng-reviewers,taskgraph-reviewers,hneiva\n\nReplace LEGACY_PARTIALS_PROJECTS with ZUCCHINI_PARTIALS_PROJECTS to avoid\nunintended zucchini rollout on new branches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326869\n", "files": ["taskcluster/docs/partials.md", "taskcluster/gecko_taskgraph/transforms/zucchini_partial_rollout.py"], "git_node": "015f390a8f85b44ae01b5272511a8d07c1a16a0e", "git_parents": ["a259700d20471e221f124df1dbe45fdf05d6fb66"], "node": "cc2b05db540cfad9a23803e5e8774f3c657014cb", "parents": ["a235aeb68f84862d1ba492b67dcddb7d4c30b4ee"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072243 - Part 1: Refactor buffer allocator tests r=sfink\n\nThis extends BufferHolderObject so it can hold multiple buffers are uses it for\nthe stress test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326201\n", "files": ["js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "fad5c6719f14d4ce52945688ec12e134c1612908", "git_parents": ["015f390a8f85b44ae01b5272511a8d07c1a16a0e"], "node": "8ee3c07a0fc62cca9cfbc43a657b51fa9cddc69c", "parents": ["cc2b05db540cfad9a23803e5e8774f3c657014cb"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072243 - Part 2: Allocate nursery buffers in stress test r=sfink\n\nThe stress test doesn't currently allocate any nursery-owned buffers. Extend\nthat while we're here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326202\n", "files": ["js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "6709ec7bc773ab14187950a649d233b694cfc6c5", "git_parents": ["fad5c6719f14d4ce52945688ec12e134c1612908"], "node": "ca8b81ad6f59c8f1998a14179dda7334dd4ed611", "parents": ["8ee3c07a0fc62cca9cfbc43a657b51fa9cddc69c"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072243 - Part 3: Add test for sharing buffer allocator chunks between nursery and tenured allocations r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326203\n", "files": ["js/src/gc/BufferAllocator.h", "js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "75f13e6a17a62c15ca9b2268e1c2242ad580bc50", "git_parents": ["6709ec7bc773ab14187950a649d233b694cfc6c5"], "node": "b07fa008670e0e41c0eb3372fe928567aa1b3e9b", "parents": ["ca8b81ad6f59c8f1998a14179dda7334dd4ed611"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023960 - Migrate markers in xpcom/ to the new marker API r=canova,profiler-reviewers\n\n\"Sync\" PayloadFields of GCSliceMarker, GCMajorMarker and GCMinorMarker\nbecause the front-end handles its visualization specially.\n\nDebugBreakMarker's payload keys become the short lowercase form (\"lvl\",\n\"msg\", \"expr\", \"file\", \"line\") and its label is now built by AllLabels,\nso the duplicated \"name\" property is gone. The label template has to\nspell its separators out with conditionals for now, as the front-end\ndoes not support the simpler form kept in a comment next to it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288218\n", "files": ["mozglue/baseprofiler/public/BaseProfilerMarkersPrerequisites.h", "xpcom/base/CycleCollectedJSRuntime.cpp", "xpcom/base/nsDebugImpl.cpp"], "git_node": "1463dbb5ed67a8220dc9b3b8685cc236749ca3a9", "git_parents": ["75f13e6a17a62c15ca9b2268e1c2242ad580bc50"], "node": "a204c15b399e07a02a0309cde5c10d9c106a10ca", "parents": ["b07fa008670e0e41c0eb3372fe928567aa1b3e9b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "b8e9792ac862f670166edb12585b2dd50a541228", "git_parents": ["1463dbb5ed67a8220dc9b3b8685cc236749ca3a9", "61a4f8008eea8552b81923a1e0143e7c3a831c35"], "node": "50dc008af4d0a398ba82d22edcff959d96b54b17", "parents": ["a204c15b399e07a02a0309cde5c10d9c106a10ca", "f3bc7391657faaae6dfe0974911324586957927e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2026894 - Let a WebSocket upgrade fall back to the other address family when its first endpoint dies mid-handshake. r=necko-reviewers,kershaw\" for causing failures at test_faulty_server.js.\n\nThis reverts commit e41290334755fcdc09b81dc38b2e6f8314e693f4.\n", "files": ["netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/test/unit/test_websocket_ipv6_fallback.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "7b30a530f12890d14c42d89dcd4d80e4f36da52d", "git_parents": ["b8e9792ac862f670166edb12585b2dd50a541228"], "node": "45fa57d4544e630f53c2527789b7bf8e86379a9e", "parents": ["50dc008af4d0a398ba82d22edcff959d96b54b17"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 1: Add defer_import_eval pref. r=jonco\n\nAdd the experimental.defer_import_eval pref to StaticPrefList.yaml,\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294950\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "3685bf28303dde52d23a8372cb0234bcc48ec0a7", "git_parents": ["7b30a530f12890d14c42d89dcd4d80e4f36da52d"], "node": "cb48705aeaf106465fda6c057ac68e9dd4b0a79d", "parents": ["45fa57d4544e630f53c2527789b7bf8e86379a9e"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 2: Add parser syntax for import defer eval. r=arai\n\nAdd `import defer * as ns from 'mod'` and `import.defer('mod')` syntax.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294952\n", "files": ["js/public/CompileOptions.h", "js/src/builtin/ModuleObject.h", "js/src/builtin/ReflectParse.cpp", "js/src/frontend/Parser.cpp", "js/src/frontend/ReservedWords.h", "js/src/frontend/TokenKind.h", "js/src/jit-test/tests/modules/import.source-syntax.js", "js/src/vm/CommonPropertyNames.h"], "git_node": "45d97a614663e6432bc9664a95e11c91118c83df", "git_parents": ["3685bf28303dde52d23a8372cb0234bcc48ec0a7"], "node": "99c41adae7197ed2c5d6f6118c99c21f461c9fae", "parents": ["cb48705aeaf106465fda6c057ac68e9dd4b0a79d"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 3: Read the pref defer_import_eval in NIGHTLY_BUILD. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309110\n", "files": ["js/src/shell/js.cpp", "js/xpconnect/src/XPCJSContext.cpp"], "git_node": "6cc62482c3a71001994fed60b65a2586f4dd9ad3", "git_parents": ["45d97a614663e6432bc9664a95e11c91118c83df"], "node": "2db4d9e9a7db93e4c0a4dbf3a6e04b9c3cc2871b", "parents": ["99c41adae7197ed2c5d6f6118c99c21f461c9fae"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 4: Add deferred namespace data structures and update namespace creation. r=jonco\n\n- Add [[DeferredNamespace]] slot to ModuleObject\n- Add [[Deferred]] flag to ModuleNamespaceObject.\n- Update ModuleNamespaceCreate(), GetOrCreateModuleNamespace(),\n  ModuleObject::createNamespace(), and ModuleObject::createNamespaceForModule()\n  to take an ImportPhase parameter:\n    - When phase is Deferred, create or return [[DeferredNamespace]] instead of\n      [[Namespace]]; the deferred namespace excludes 'then' from its exports.\n- Add ModuleBuilder::processImportWithPhase() helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298778\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/builtin/ModuleObject.h", "js/src/shell/js.cpp", "js/src/vm/ModuleBuilder.h", "js/src/vm/Modules.cpp", "js/src/vm/Modules.h"], "git_node": "faf39fae8fa1678509ef57e829b98c25f64e64c2", "git_parents": ["6cc62482c3a71001994fed60b65a2586f4dd9ad3"], "node": "7c7289c1138b6255ad92c2cdf4cd676e2f7cb5a4", "parents": ["2db4d9e9a7db93e4c0a4dbf3a6e04b9c3cc2871b"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 5: Update module namespace proxy handlers for deferred evaluation. r=jonco\n\nImplement IsSymbolLikeNamespaceKey(), ReadyForSyncExecution(), and\nGetModuleExportsList(), IsModuleSCCEvaluated.\n\nUpdate all ModuleNamespaceObject proxy handlers to trigger EvaluateModuleSync\nfor deferred namespaces on first property access.\n\n- Add property names (DeferredModule).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298781\n", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/builtin/ModuleObject.cpp", "js/src/vm/CommonPropertyNames.h", "js/src/vm/Modules.cpp", "js/src/vm/Modules.h"], "git_node": "4c143d40fc996dcaca8c1feb90c9c48b7c2d5a30", "git_parents": ["faf39fae8fa1678509ef57e829b98c25f64e64c2"], "node": "816324fff6fcd4c2f017ebaa870f46da3657526b", "parents": ["7c7289c1138b6255ad92c2cdf4cd676e2f7cb5a4"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 6: Update InnerModuleLinking, InitializeEnvironment, and ResolveExport for import defer eval. r=jonco\n\nInnerModuleLinking: link deferred modules too (only skip source-phase).\n\nInitializeEnvironment: pass the correct phase to GetOrCreateModuleNamespace\nfor namespace imports and handle *deferred-namespace* bindings.\n\nCyclicModuleResolveExport: return *deferred-namespace* binding for namespace\nimports with deferred phase.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298779\n", "files": ["js/src/vm/Modules.cpp"], "git_node": "eee2e8102fb6b51e0310fb5b4f3a4172cf37fb93", "git_parents": ["4c143d40fc996dcaca8c1feb90c9c48b7c2d5a30"], "node": "62fcd0eabd4d4e4cc4b8b92d7c3b0b8e2f12f37b", "parents": ["816324fff6fcd4c2f017ebaa870f46da3657526b"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com