onents/aiwindow/ui/components/ai-sff-form-review/ai-sff-form-review.mjs", "browser/components/aiwindow/ui/content/smartformfill-form-review.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_filling.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_generation.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js"], "git_node": "628e643fdb9c3ed82ce40cfbb14e6a85b99e693d", "git_parents": ["27744efbd5b302775bc1c3a6656c5ba1de051d2b"], "node": "8dc1ef161b77c6853ed8f6b347b67b1760895c06", "parents": ["5f286e2e86dcd58761e7a20b0d69d3d9c0282846"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071369 - Avoid rejecting an empty holder in RemoteMediaManagerChild::EnsureCodecSupportFor. r=media-playback-reviewers,padenot\n\nThe launch-failure paths in EnsureCodecSupportFor called Reject() on the\nper-location MozPromiseHolder unconditionally. The holder can already be empty\nwhen they run: concurrent callers each attach a reject handler to the same\nholder, so the second one to fire rejected an empty holder, and SetSupported()\nmoves the holder out under the mutex in a separate critical section.\n\nUse RejectIfExists() in both paths. Also reject pending holders in Shutdown()\nso waiting callers do not hang, and stop passing a null manager thread as a\nThen() target when EnsureCodecSupportFor is called after shutdown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325887\n", "files": ["dom/media/ipc/RemoteMediaManagerChild.cpp"], "git_node": "f2b6f65c45a1a9017c69672a286259072f4cc1c9", "git_parents": ["628e643fdb9c3ed82ce40cfbb14e6a85b99e693d"], "node": "9dde1a1bd81737a91b35b779519a238c2662bf7f", "parents": ["8dc1ef161b77c6853ed8f6b347b67b1760895c06"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071602 - Document the forced-colors and prefers-contrast regimes in the CSS guidelines. r=mkennedy\n\nThe `document_color_use` Windows default in ColorsAndHighContrastMode.md said 2, against 0 in StaticPrefList.yaml, and the table added here contradicted it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325612\n", "files": ["accessible/docs/ColorsAndHighContrastMode.md", "docs/code-quality/coding-style/css_guidelines.md"], "git_node": "d117d2f01d5f16bd18b00c24679b9379df1198fb", "git_parents": ["f2b6f65c45a1a9017c69672a286259072f4cc1c9"], "node": "f4435b59aef584aa09ec07e77b13507ba3340cc2", "parents": ["9dde1a1bd81737a91b35b779519a238c2662bf7f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071602 - Document the chrome-versus-in-content differences and device-pixel rounding in the CSS guidelines. r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325613\n", "files": ["docs/code-quality/coding-style/css_guidelines.md"], "git_node": "d824424cadc9c60e2633a294757f53aa62e1ef95", "git_parents": ["d117d2f01d5f16bd18b00c24679b9379df1198fb"], "node": "030bb75d0b2dd2c9b89757a38f6359eeba118fdb", "parents": ["f4435b59aef584aa09ec07e77b13507ba3340cc2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071602 - Document the token generation pipeline and chrome's rem in the design-token docs. r=mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325614\n", "files": ["docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-design-tokens/space.md", "toolkit/themes/shared/design-system/docs/README.design-tokens.stories.md"], "git_node": "4dba3550a06ca1153dace9600c59b1fb75fd0b97", "git_parents": ["d824424cadc9c60e2633a294757f53aa62e1ef95"], "node": "c417af1a30e923fbd5a0f84aab7297616b16dc37", "parents": ["030bb75d0b2dd2c9b89757a38f6359eeba118fdb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071678 - Flip active / inactive frame color in private window theme. r=sfoster,desktop-theme-reviewers\n\nThis gets the color that Figma shows on the active window. I _think_\nthis is because Figma has some sort of rgba(0, 0, 0, .1) drop shadow\nwhich effectively makes it a bit darker?\n\nBut not an expert on our Figma stuff so please double-check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325685\n", "files": ["browser/themes/addons/privatewindow/manifest.in.json"], "git_node": "ee6af40faaaa91ce825e873902315f8ba2f5b596", "git_parents": ["4dba3550a06ca1153dace9600c59b1fb75fd0b97"], "node": "90329d0add5b251e4e590573f1687c05096182c9", "parents": ["c417af1a30e923fbd5a0f84aab7297616b16dc37"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068765 - Part 1: Parser for Declarative Web Push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323282\n", "files": ["Cargo.lock", "dom/push/moz.build", "dom/push/rust/Cargo.toml", "dom/push/rust/cbindgen.toml", "dom/push/rust/src/declarative_push.rs", "dom/push/rust/src/lib.rs", "modules/libpref/init/StaticPrefList.yaml", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "d1feca008a621751dde31cfd562bca9462263b4d", "git_parents": ["ee6af40faaaa91ce825e873902315f8ba2f5b596"], "node": "76844b5ef34d0cf6cfce765c4cc2a21cfe86bd1d", "parents": ["90329d0add5b251e4e590573f1687c05096182c9"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068765 - Part 2: Create notification from Declarative Web Push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323283\n", "files": ["dom/push/Declarative.cpp", "dom/push/Declarative.h", "dom/push/PushNotifier.cpp", "dom/push/moz.build", "testing/web-platform/mozilla/meta/push-api/__dir__.ini", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/push-api/declarative.https.any.js"], "git_node": "ddfe0fc48cad7cf5c0a5ad9c087a60fc44a90a2d", "git_parents": ["d1feca008a621751dde31cfd562bca9462263b4d"], "node": "9be66fea4955973b27c980a3d57f349b9dd648a8", "parents": ["76844b5ef34d0cf6cfce765c4cc2a21cfe86bd1d"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071129: Try an optimistic shapeguard in tryAttachIsTypedArray r=jandem\n\nThis is about a 10% improvement on a microbenchmark.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325477\n", "files": ["js/src/jit/CacheIR.cpp"], "git_node": "5583d708cbca8362a1ac9d915571bcef10fa225e", "git_parents": ["ddfe0fc48cad7cf5c0a5ad9c087a60fc44a90a2d"], "node": "bd2a6e9baa8a078eb2eb5911ebd7445c081a7015", "parents": ["9be66fea4955973b27c980a3d57f349b9dd648a8"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057685 - Part 7: Add long screenshot tests r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325223\n", "files": ["mobile/android/geckoview/src/androidTest/assets/www/fullpage.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ScreenshotTest.kt"], "git_node": "ad6acde29dcac8d214445f3d52f96bc93512768a", "git_parents": ["5583d708cbca8362a1ac9d915571bcef10fa225e"], "node": "ea1db602d93d44697acb0ef24ab50b80d021f63d", "parents": ["bd2a6e9baa8a078eb2eb5911ebd7445c081a7015"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069071: Handle esc on secondary action button and SFF for autocomplete popups r=omarg,credential-management-reviewers,tgiles,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324403\n", "files": ["toolkit/actors/AutoCompleteChild.sys.mjs", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/autocomplete/nsIAutoCompletePopup.idl", "toolkit/components/satchel/nsFormFillController.cpp", "toolkit/components/satchel/test/browser/browser_popup_secondary_action.js", "toolkit/components/satchel/test/test_form_autocomplete.html", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "86f4a02c6c403b35b27536f7a7b1c151ebbb46d4", "git_parents": ["ad6acde29dcac8d214445f3d52f96bc93512768a"], "node": "6cf99a58cae861a954886c9d44761625812fddfd", "parents": ["ea1db602d93d44697acb0ef24ab50b80d021f63d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071081 - Parse sparse profiles once in gecko_taskgraph, keeping sections and order r=taskgraph-reviewers,bhearsum\n\ngecko_taskgraph only parsed a sparse profile to check which files the taskgraph\nprofile covers, and kept unordered sets of paths and globs. Translating a\nprofile into git `sparse-checkout` patterns needs every line in order together\nwith its section, so load_sparse_profile returns the include and exclude lines\nas lists and the coverage check now reads its paths and globs from them. The\ntaskgraph profile has no excludes, so the check's result does not change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325160\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_util_sparse_profiles.py", "taskcluster/gecko_taskgraph/util/sparse_profiles.py"], "git_node": "9037caa8ffae209daacdfb5f0164f89c7a61b4ce", "git_parents": ["86f4a02c6c403b35b27536f7a7b1c151ebbb46d4"], "node": "d0467974064e9365c41d3f2913cae699f66dac86", "parents": ["6cf99a58cae861a954886c9d44761625812fddfd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071081 - Translate Mercurial sparse profiles into git sparse-checkout patterns r=taskgraph-reviewers,bhearsum\n\nEvery translated pattern is positive, so run-task can widen a cached checkout\nby appending a second profile's patterns and never has to reason about order.\nThat rules out `[exclude]` sections, which no profile uses.\n\nGlobs are spelled without a leading `**/` or a trailing `/**` where git reads\nboth spellings the same. A pattern without a slash already matches at any\ndepth, and a trailing slash already matches a whole directory.\n\nThese patterns end up in the task definition JSON, in the env var run-task\nreads them from, and the Decision task sends that JSON to the queue in a web\nrequest. With the long spelling, two neighbouring lines such as `/docs/**` and\n`**/*.rst` contain `/**` and `**/`, which looks like a SQL injection attempt\n(`/* ... */`) to Taskcluster's firewall, and it blocks the request.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325161\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_sparse_profiles.py", "taskcluster/gecko_taskgraph/util/sparse_profiles.py", "taskcluster/kinds/source-test/python.yml"], "git_node": "40c377b44b919ac67e3915d55bb2f2e6cc6a7792", "git_parents": ["9037caa8ffae209daacdfb5f0164f89c7a61b4ce"], "node": "adea568feb876a460f65acd36caa81974028b8b1", "parents": ["d0467974064e9365c41d3f2913cae699f66dac86"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071081 - Expand `re:^dir/[^/]+$` sparse profile lines into the files they match r=taskgraph-reviewers,ahal\n\nSome profiles use `re:^dir/[^/]+$` to take the files directly inside a\ndirectory without its subdirectories. Git can only express that with a\nnegation, `/dir/*` followed by `!/dir/*/`, and a negation would break the\nunion of two profiles that run-task builds by appending patterns. Those two\nwildcard lines were also slow: git tested them against every one of the 475k\nindex entries, 18 of the 19 seconds a warm checkout took.\n\nThe listing is therefore expanded into one anchored line per file, read from\nthe repository at the checked out revision with `hg files -r .` or\n`git ls-tree`, since the Decision task's own working copy is sparse and does\nnot have all of them. Anchored literals cost git about a second to match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325162\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_sparse_profiles.py", "taskcluster/gecko_taskgraph/util/sparse_profiles.py"], "git_node": "85ee89baa11d8c82d74bca38d5499b185cfb8bfb", "git_parents": ["40c377b44b919ac67e3915d55bb2f2e6cc6a7792"], "node": "481d9c8ee56475512fe06b457f8330684bdaec2e", "parents": ["adea568feb876a460f65acd36caa81974028b8b1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071081 - Make the sparse profile loader reject what Mercurial rejects r=taskgraph-reviewers,ahal\n\nMercurial aborts on a pattern line before the first section header and on an\n[include] section after an [exclude] section. The loader accepted both, so a\nprofile that passed generation could still break every hg checkout using it.\nIt now aborts on the same two things, naming the file and line.\n\nTwo more checks are for the loader itself: a %include loop no longer recurses\nuntil Python gives up, and an include that resolves outside the source\ndirectory is refused. A profile included twice through different paths stays\nallowed, since most profiles reach mach that way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325163\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_sparse_profiles.py", "taskcluster/gecko_taskgraph/util/sparse_profiles.py"], "git_node": "26b58f17a142d2e1dba705f808e5829894eec1e7", "git_parents": ["85ee89baa11d8c82d74bca38d5499b185cfb8bfb"], "node": "f0ffb10862464e69078f61368195200b6c8f5917", "parents": ["481d9c8ee56475512fe06b457f8330684bdaec2e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071092 - Hash the run-task a task actually runs into its checkout cache name r=taskgraph-reviewers,bhearsum,ahal\n\nCheckout cache names carry a hash of run-task so that a new run-task never\ninherits a cache an older one left behind. The hash was picked by the\nrepository type of the push, hg on autoland, so a task that clones with git ran\nrun-task-git but was keyed on run-task-hg, and a change to the git run-task\nnever gave those tasks fresh caches.\n\nLater commits teach run-task to give git tasks sparse checkouts and to share\none checkout cache per worker pool between sparse and full tasks. A cache only\never widens there: a full task on a sparse cache switches it to a full\ncheckout, and a sparse task on a cache with a different profile adds its\npatterns. An older run-task knows none of that. Handed a cache a newer one\nleft sparse, it would run a full task on the sparse tree without noticing,\nwith source files missing and no error. Two run-task versions must therefore\nnever share a cache, and the hash has to be the one of the run-task the task\nactually runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325174\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "8928e668fbcb08069826dad3a4a3893a917af6f5", "git_parents": ["26b58f17a142d2e1dba705f808e5829894eec1e7"], "node": "76741ed7af6269852c6639c1a0cd8502889c63aa", "parents": ["f0ffb10862464e69078f61368195200b6c8f5917"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071092 - Add the run-task hash to generic-worker checkout caches too r=taskgraph-reviewers,bhearsum,ahal\n\nDocker-worker caches carry a version and a hash of run-task in their name, so\ntwo run-task versions never share a cache. Generic-worker caches, which is\nevery Windows and macOS task and the Linux device pools, were named plainly,\n`checkouts` with nothing after it, so that guarantee never held there. The\ncache audit only looked at docker-worker caches and at commands given as a\nlist, so it could not notice, and it skipped the flags inside the single\ncommand line string Windows tasks get.\n\nGeneric-worker caches of run-task tasks now get the same suffix, and the audit\nreads cache mounts and the joined command line as well.\n\nEvery generic-worker run-task cache changes name once when this lands, so each\nWindows and mac worker does one cold clone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325175\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "51050cbd336bb28a21948072c4c1d448e3ff257e", "git_parents": ["8928e668fbcb08069826dad3a4a3893a917af6f5"], "node": "ed21a19610cf2c5d8eede44549983e43e6ed4711", "parents": ["76741ed7af6269852c6639c1a0cd8502889c63aa"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070076 - Be more conservative with frame visibility while printing. r=layout-reviewers,dshin\n\nNot sure how to best test this. The main issue is that the\nIntersectionObserver code (and such) don't deal with the print preview\ntransforms that are applied via GetTransformGetter()...\n\nBut those transforms are super weird so they can't easily be migrated to\nIsTransformed() which would make this work.\n\nThat, plus the fact that we have the fragmentation fallback stuff which\ncan also move \"invisible\" stuff into view, makes me think we should\nprobably just unconditionally treat OOP iframes as visible while\nprinting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326017\n", "files": ["dom/base/Document.cpp"], "git_node": "347f5cc74f53179119bc96989ac64013e56edd11", "git_parents": ["51050cbd336bb28a21948072c4c1d448e3ff257e"], "node": "00a00d5a89d4ec7f259d8ed8b884826c524fbc3e", "parents": ["ed21a19610cf2c5d8eede44549983e43e6ed4711"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065320 - Enable YouTube transcript extraction in PageExtractor by default r=ai-platform-reviewers,jbowser\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326012\n", "files": ["modules/libpref/init/all.js", "toolkit/components/pageextractor/YouTubeExtraction.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_youtube_extraction.js"], "git_node": "aa2f13e716cd524fd028dc59548885fe5a4b8bdb", "git_parents": ["347f5cc74f53179119bc96989ac64013e56edd11"], "node": "cbad59e459494a6a1f37d8e7d42365081ab4df81", "parents": ["00a00d5a89d4ec7f259d8ed8b884826c524fbc3e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071540 - Check out the Windows spidermonkey source inside the checkouts cache r=taskgraph-reviewers,bhearsum\n\nThe Windows spidermonkey task set GECKO_PATH to ./src, outside the build\ndirectory that holds the checkouts cache. Every run rewrote the working\ndirectory, and the cache never held one for the next task on the worker.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325579\n", "files": ["taskcluster/gecko_taskgraph/transforms/job/spidermonkey.py"], "git_node": "40edc151cb760691ba3e846151a5df633a0a7c88", "git_parents": ["aa2f13e716cd524fd028dc59548885fe5a4b8bdb"], "node": "6ead72bacd9150ae5d32fa43cbedb2b279d763ba", "parents": ["cbad59e459494a6a1f37d8e7d42365081ab4df81"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2030914 - Carry GDK's X error details into the crash reason. r=stransky\n\nAn untrapped X error goes through gdk_x_error(), which formats a report and\nhands it to g_error(). Firefox sees that message in HandleGLibMessage(), but\nIsCrashyGtkMessage() matches only the Wayland messages, so the process dies\ninside GLib's abort and the crash report says nothing about which X request\nfailed.\n\nTreat the message as crashy and crash on it with the two lines of GDK's report\nthat identify the failure: the error name, and the \"(Details: ...)\" line with\nthe serial, error, request and minor codes. The rest of the report is the\nprogram name and a paragraph about GDK_SYNCHRONIZE, which would only crowd the\ncodes out of the reason string.\n\nThis is diagnostics, not a fix. The process was already going to die, here or\na moment later inside GLib.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324759\n", "files": ["toolkit/xre/nsSigHandlers.cpp"], "git_node": "00796b0dcdb8882e5980bf67d48e33301943cf02", "git_parents": ["40edc151cb760691ba3e846151a5df633a0a7c88"], "node": "6e9bd1f7afd9db1443796abf116df2026f16d62c", "parents": ["6ead72bacd9150ae5d32fa43cbedb2b279d763ba"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068765 - Part 2: Create notification from Declarative Web Push. r=saschanaz\" for causing failures complaining about Declarative web push.\n\nThis reverts commit ddfe0fc48cad7cf5c0a5ad9c087a60fc44a90a2d.\n\nRevert \"Bug 2068765 - Part 1: Parser for Declarative Web Push. r=saschanaz\"\n\nThis reverts commit d1feca008a621751dde31cfd562bca9462263b4d.\n", "files": ["Cargo.lock", "dom/push/Declarative.cpp", "dom/push/Declarative.h", "dom/push/PushNotifier.cpp", "dom/push/moz.build", "dom/push/rust/Cargo.toml", "dom/push/rust/cbindgen.toml", "dom/push/rust/src/declarative_push.rs", "dom/push/rust/src/lib.rs", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/push-api/__dir__.ini", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/push-api/declarative.https.any.js", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "ef7de3078534064e860741d5d3fddfb8434d5712", "git_parents": ["00796b0dcdb8882e5980bf67d48e33301943cf02"], "node": "367b29d1845cc95e22945b702aa2d6fd8e02e2c1", "parents": ["6e9bd1f7afd9db1443796abf116df2026f16d62c"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062498 - Announce review dialog state changes to screen reader users r=jlewis\" for causing failures at browser_smartwindow_smartformfill_telemetry_review.js.\n\nThis reverts commit 628e643fdb9c3ed82ce40cfbb14e6a85b99e693d.\n", "files": ["browser/components/aiwindow/ui/components/ai-sff-form-review/ai-sff-form-review.mjs", "browser/components/aiwindow/ui/content/smartformfill-form-review.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_filling.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_generation.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js"], "git_node": "294e6caec94d317f0bbd91d626cc7bc7c465e3d0", "git_parents": ["ef7de3078534064e860741d5d3fddfb8434d5712"], "node": "4fa5336ef43609206d454b84d4004432f6499947", "parents": ["367b29d1845cc95e22945b702aa2d6fd8e02e2c1"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069772 - part 1: Make the `nsRange::CharacterDataChanged` stop duplicating same things for start and end boundaries r=jjaschke\n\n`nsRange::CharacterDataChanged` is the most complicated mutation\nhandler in `nsRange`.\n\nThis patch adds `RangeBoundarySide` which indicates whether the method\nshould handle `mStart` or `mEnd`. Therefore, the new handlers stop\nduplicating the same logic for each boundary.\n\nAt first, I tried to make them templated to avoid the runtime branches\nfor `mStart` and `mEnd`. However, using template methods is much slower\nthan the runtime check especially in shippable builds. The reason must\nbe that the duplicated methods in the binary are treated as different\nmethod so that they can be dropped from the host path since the running\ntime is half of the actual count. Additionally, CPU cache might not be\nused effectively. Finally, the runtime check is really cheap. Therefore,\nthis patch does the check at runtime.\n\nNext, I tried to make the handler methods `static` to avoid the cost of\ncalling instance methods. However, it's slower than using the instance\nmethods and storing the most data as members of the struct is the\nfastest as far as I checked. Therefore, this patch makes a new stack\nonly class which can be shared with `CrossShadowBoundaryRange` later.\n\nAnd `CharacterDataChanged` handling requires member variables for\nhandling a following `ContentAppended` or `ContentInserted` when the\n`CharacterDataChanged` is caused by splitting a `Text`. This patch\nmakes the data as a simple struct and make the new class return the\ninstance as the result of computation.\n\nThe performance test result including the latter patches is here:\nhttps://perf.compare/compare-lando-results?landoInstance=lando-prod-2025&baseLando=87650&newLando=87651&baseRepo=try&newRepo=try&framework=13&initialized=1\n\nLooks like it's fine to use the new classes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323940\n", "files": ["dom/base/AbstractRange.h", "dom/base/RangeBoundary.h", "dom/base/nsRange.cpp", "dom/base/nsRange.h"], "git_node": "d9e38c16be9f8fa17745f7aaa1f0c1bfc80a636f", "git_parents": ["294e6caec94d317f0bbd91d626cc7bc7c465e3d0"], "node": "deb0e238228e3e344c798de807149771a8f910e2", "parents": ["4fa5336ef43609206d454b84d4004432f6499947"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069772 - part 2: Clean up the `CharacterDataChanged` handlers r=jjaschke\n\nThis patch moves the modifying part of `nsRange` from\n`ComputeNewBoundaryOnModifyDataOrSplitText()` to align the behavior to\nits name.\n\nAdditionally, this cleans up `ComputeNewBoundaries()` to avoid to call\nunnecessary method calls when the character data is merged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323941\n", "files": ["dom/base/nsRange.cpp"], "git_node": "771a642dd8c33bacb6be3f641a56e73c22618b8f", "git_parents": ["d9e38c16be9f8fa17745f7aaa1f0c1bfc80a636f"], "node": "8b1e5e2db0be99b048ed3e2436a8854af9abea63", "parents": ["deb0e238228e3e344c798de807149771a8f910e2"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069772 - part 3: Make `nsRange::ContentAppended` and `nsRange::ContentInserted` stop duplicating same things for start and end boundaries and each other r=jjaschke\n\nThey do the same things for `NextSiblings` and\n`nsRange::ContentInserted` does the same things for start and end\nboundaries. Therefore, we can make a common handler for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323942\n", "files": ["dom/base/nsRange.cpp", "dom/base/nsRange.h"], "git_node": "4f5d94698cf2cd5e81044ad720f1d72e3ec97718", "git_parents": ["771a642dd8c33bacb6be3f641a56e73c22618b8f"], "node": "9bc42cf18ded2aec40ae6c390e8c6724b319168e", "parents": ["8b1e5e2db0be99b048ed3e2436a8854af9abea63"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069772 - part 4: Make `nsRange::ContentWillBeRemoved` stop duplicating same things for the start and end boundaries r=jjaschke\n\nFinally, we can make a handler class for `ContentWillBeRemoved` which\ndoes the same things for `mStart` and `mEnd`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323943\n", "files": ["dom/base/nsRange.cpp", "dom/base/nsRange.h"], "git_node": "043327590f92cce539fef1049e14bbefc227dd4d", "git_parents": ["4f5d94698cf2cd5e81044ad720f1d72e3ec97718"], "node": "573c3233f9fe3b5af9ff9dc45a6a73f8456fbc0a", "parents": ["9bc42cf18ded2aec40ae6c390e8c6724b319168e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2071665. Back out the local jxl_simd workaround so the 0.7.3 vendor bump is a pure upstream delta. r=saschanaz,supply-chain-reviewers\n\nThis backs out the bug 2043090 macOS x86_64 workaround.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325652\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/src/x86_64/avx.rs", "third_party/rust/jxl_simd/src/x86_64/avx512.rs"], "git_node": "7b89526bc21018fa341fd8c0108510e6ac450061", "git_parents": ["043327590f92cce539fef1049e14bbefc227dd4d"], "node": "c263cc4e2dbf7ca72f356582db579f0459161b94", "parents": ["573c3233f9fe3b5af9ff9dc45a6a73f8456fbc0a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2071665. Upgrade jxl-rs to 0.7.3. r=saschanaz,supply-chain-reviewers\n\nPlain ./mach vendor rust.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325653\n", "files": ["Cargo.lock", "image/rust/jxl/Cargo.toml", "supply-chain/imports.lock", "third_party/rust/jxl/.cargo-checksum.json", "third_party/rust/jxl/.cargo_vcs_info.json", "third_party/rust/jxl/Cargo.lock", "third_party/rust/jxl/Cargo.toml", "third_party/rust/jxl/Cargo.toml.orig", "third_party/rust/jxl/src/api/inner/box_parser.rs", "third_party/rust/jxl/src/api/inner/codestream_parser/frame_info.rs", "third_party/rust/jxl/src/api/inner/codestream_parser/mod.rs", "third_party/rust/jxl/src/api/inner/mod.rs", "third_party/rust/jxl/src/error.rs", "third_party/rust/jxl/src/features/patches.rs", "third_party/rust/jxl/src/features/spline.rs", "third_party/rust/jxl/src/frame/decode.rs", "third_party/rust/jxl/src/frame/mod.rs", "third_party/rust/jxl/src/frame/modular/decode/bitstream.rs", "third_party/rust/jxl/src/frame/modular/decode/channel.rs", "third_party/rust/jxl/src/frame/modular/decode/mod.rs", "third_party/rust/jxl/src/frame/modular/decode/specialized_trees.rs", "third_party/rust/jxl/src/frame/modular/mod.rs", "third_party/rust/jxl/src/frame/modular/transforms/apply_local.rs", "third_party/rust/jxl/src/frame/modular/transforms/palette.rs", "third_party/rust/jxl/src/frame/modular/transforms/squeeze.rs", "third_party/rust/jxl/src/frame/modular/transforms/step.rs", "third_party/rust/jxl/src/headers/encodings.rs", "third_party/rust/jxl/src/headers/transform_data.rs", "third_party/rust/jxl/src/render/low_memory_pipeline/mod.rs", "third_party/rust/jxl/src/render/stages/upsample.rs", "third_party/rust/jxl/src/util/dither.rs", "third_party/rust/jxl/src/util/vec_helpers.rs", "third_party/rust/jxl/tests/testdata/incomplete_ooo_jxlp.jxl", "third_party/rust/jxl/tests/testdata/ooo_jxlp_with_trailing_bytes.jxl", "third_party/rust/jxl_macros/.cargo-checksum.json", "third_party/rust/jxl_macros/.cargo_vcs_info.json", "third_party/rust/jxl_macros/Cargo.lock", "third_party/rust/jxl_macros/Cargo.toml", "third_party/rust/jxl_macros/Cargo.toml.orig", "third_party/rust/jxl_simd/.cargo-checksum.json", "third_party/rust/jxl_simd/.cargo_vcs_info.json", "third_party/rust/jxl_simd/Cargo.lock", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/Cargo.toml.orig", "third_party/rust/jxl_transforms/.cargo-checksum.json", "third_party/rust/jxl_transforms/.cargo_vcs_info.json", "third_party/rust/jxl_transforms/Cargo.lock", "third_party/rust/jxl_transforms/Cargo.toml", "third_party/rust/jxl_transforms/Cargo.toml.orig", "third_party/rust/jxl_transforms/src/idct_large.rs"], "git_node": "0c157d70d6c8ecd56408d4d943d56aefebc6c640", "git_parents": ["7b89526bc21018fa341fd8c0108510e6ac450061"], "node": "21f45293ea9d0b4079bb0fec9447fa331b0f54e2", "parents": ["c263cc4e2dbf7ca72f356582db579f0459161b94"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2071665. Reapply the jxl_simd macOS x86_64 workaround on top of 0.7.3. r=saschanaz,supply-chain-reviewers\n\nThis re-applies the bug 2043090 macOS x86_64 workaround.\n\njxl_simd's src/ is byte-identical between 0.7.2 and 0.7.3.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325654\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/src/x86_64/avx.rs", "third_party/rust/jxl_simd/src/x86_64/avx512.rs"], "git_node": "e78b1ea6ec5b216e6832347383fd35adc86e4deb", "git_parents": ["0c157d70d6c8ecd56408d4d943d56aefebc6c640"], "node": "d43d81813d6240319acbdc5e22f15c4cc6583041", "parents": ["21f45293ea9d0b4079bb0fec9447fa331b0f54e2"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2071665. Add a JXL wpt crashtest for an incomplete codestream with a partial trailing box. r=saschanaz\n\n0.7.3 has a fix for a hang, this adds a test that we don't hang anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325655\n", "files": ["testing/web-platform/tests/jpegxl/incomplete-codestream-trailing-box-crash.html", "testing/web-platform/tests/jpegxl/resources/incomplete-codestream-trailing-box.jxl"], "git_node": "1e3069410070cb7cc7605d0f54bc9bed06d9f027", "git_parents": ["e78b1ea6ec5b216e6832347383fd35adc86e4deb"], "node": "7253bc455d0d13b545b262d14b6cb739a351b337", "parents": ["d43d81813d6240319acbdc5e22f15c4cc6583041"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2054288 - Scale encoder input to the configured frame size on Android r=media-playback-reviewers,jolin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323821\n", "files": ["dom/media/platforms/android/AndroidDataEncoder.cpp"], "git_node": "9d4c5129efdbdec6f3eb209c5492e9525da94919", "git_parents": ["1e3069410070cb7cc7605d0f54bc9bed06d9f027"], "node": "3e59bc07286357be2a4a44a3878027c666c7a5a8", "parents": ["7253bc455d0d13b545b262d14b6cb739a351b337"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055092 - prevent click from focusing on PiP controls so that it doesn't interfere with space play/pause shortcut. r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325542\n", "files": ["toolkit/components/pictureinpicture/content/player.js", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_controlButtonClickFocus.js", "toolkit/components/pictureinpicture/tests/browser_improved_controls.js", "toolkit/components/pictureinpicture/tests/head.js"], "git_node": "7c71bb03f6611418ed69ed5c3a4131420ffccf4a", "git_parents": ["9d4c5129efdbdec6f3eb209c5492e9525da94919"], "node": "2c43e7a150ba0395bbc87f239aeb4b9ddbde2aeb", "parents": ["3e59bc07286357be2a4a44a3878027c666c7a5a8"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2062598 - Obey overscroll-behavior through the whole fling handoff chain. r=hiro\n\n1. basic flow\n\nA fling gesture at the end of a touch block arrives as a MULTITOUCH_END input\nwhile the APZC is in the PANNING state, so OnTouchEnd() goes through\nHandleEndOfPan() to APZCTreeManager::DispatchFling(). That walks the\noverscroll handoff chain and creates a fling animation on the first APZC whose\nAttemptFling() accepts the velocity.\n\nWhen that animation is sampled, GenericFlingAnimation::DoSample() applies as\nmuch of the displacement as the APZC has room for and hands whatever is left\nover to HandleFlingOverscroll(). Starting from the edge there is no room at all,\nso the entire displacement is left over on the very first sample.\n\nHandleFlingOverscroll() calls DispatchFling() again, and that call is what\ndecides whether the leftover velocity turns into an overscroll effect on this\nAPZC or into a fling animation on another one:\n\n - If this APZC is the one scrolled during the touch input, the handoff is dropped\n   (see the comment in DispatchFling(),\n    \"APZCTM dropping handoff due to disallowed immediate handoff\") and the\n   velocity comes back to be used for the overscroll effect.\n - If the container starts at its edge, because then nothing scrolled at all, the\n   loop in DispatchFling() looks for someone who can consume the leftover\n   velocity. If it finds an APZC that can take it, AttemptFling() starts a fling\n   animation there. If it finds nobody, the velocity is left over for the overscroll\n   effect.\n\n2. why bug happens?\n\nThe problem is that the loop applies the overscroll-behavior restriction of\nthe APZC only to the APZC one step above the one being offered the velocity.\nIn the nested case in the test, the middle container is handed a velocity of zero\nand so returns the full velocity as residual. This situation is, from a perspective\nof the outermost container, indistinguishable from the one where the middle\ncontainer is declined because it has no room to scroll. Because the outermost\ncontainer does not receive any restrictions of the overscroll-behavior prop, it\nconsumes the residual velocity and scrolls.\n\n3. how this patch solves that?\n\nThis patch fixes the problem by accumulating the restriction in refusedVelocity\nas the loop walks the chain, so that an APZC which disallows handoff disallows\nit for the rest of the chain instead of only for its immediate parent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324482\n", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/test/mochitest/helper_bug2062598.html", "gfx/layers/apz/test/mochitest/helper_bug2062598_with_non_scrollable_middle.html", "gfx/layers/apz/test/mochitest/helper_bug2062598_with_two_axes.html", "gfx/layers/apz/test/mochitest/test_group_touchevents-7.html"], "git_node": "20813cb93ba792f83d09ee08f5a453d8e9449c6a", "git_parents": ["7c71bb03f6611418ed69ed5c3a4131420ffccf4a"], "node": "60ac66c98258eeccd9282584c616db27e93f983d", "parents": ["2c43e7a150ba0395bbc87f239aeb4b9ddbde2aeb"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2062598 - Cancel the existing overscroll animation before HandleFlingOverscroll() starts its own. r=hiro\n\nStartOverscrollAnimation() asserts that no overscroll animation is\nrunning on this APZC. HandleFlingOverscroll() can reach it when one is\nalready running.\n\nThis can happen with two overscrolled APZCs in the handoff chain, A\ninside B:\n\n1. A's HandleFlingOverscroll() hands the fling off to B. B enters FLING.\n2. The compositor samples B. B's fling also goes into overscroll, so it\n   hands off in turn. This queues B's own HandleFlingOverscroll(), and\n   it also ends B's fling animation, so B goes back to NOTHING.\n3. A's HandleFlingOverscroll() continues and calls\n   SnapBackOverscrolledApzcForMomentum(). B is no longer in FLING, so\n   SnapBackIfOverscrolledForMomentum() does not decline, and it starts\n   an overscroll animation on B.\n4. B's queued HandleFlingOverscroll() runs and hits the assertion.\n\nThe crash needs step 2 to happen between steps 1 and 3, which is why it\nis intermittent.\n\nOf these two animations, the one from HandleFlingOverscroll() in step 4\nis the correct one. It uses B's own residual velocity, while the snap-back\none uses A's. So this patch cancels the snap-back animation and starts\na new one with the proper velocity.\n\nFYI, this assertion failure can be seen in the diagonal fling test case\nadded in the previous patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324756\n", "files": ["gfx/layers/apz/src/AsyncPanZoomController.cpp"], "git_node": "96dd7a900e04e06870c4f2c437497d61d2dc7437", "git_parents": ["20813cb93ba792f83d09ee08f5a453d8e9449c6a"], "node": "c75465c23727ea9dc3eefc603782560a40abf61e", "parents": ["60ac66c98258eeccd9282584c616db27e93f983d"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1883992: Update wpt expectations r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322934\n", "files": ["testing/web-platform/meta/webrtc-encoded-transform/__dir__.ini", "testing/web-platform/meta/webrtc/__dir__.ini", "testing/web-platform/meta/webrtc/idlharness.https.window.js.ini", "testing/web-platform/meta/webrtc/legacy/__dir__.ini", "testing/web-platform/mozilla/meta/webrtc/__dir__.ini"], "git_node": "52fbacb34e946afd1767ac35967a3b6360360070", "git_parents": ["96dd7a900e04e06870c4f2c437497d61d2dc7437"], "node": "a65e3d17012712d2a414ed3641b12e806e2ef8b2", "parents": ["c75465c23727ea9dc3eefc603782560a40abf61e"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1883992: Make RTCSessionDescription.type/sdp readonly. r=jib,webidl,smaug\n\nInvolves removing the media.peerconnection.description.legacy.enabled\npref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322935\n", "files": ["dom/media/PeerConnection.sys.mjs", "dom/media/webrtc/tests/mochitests/test_peerConnection_verifyDescriptions.html", "dom/webidl/RTCSessionDescription.webidl", "modules/libpref/init/all.js"], "git_node": "d4a17f7e4e2c693e238f7d8f745c27688d7d7b2e", "git_parents": ["52fbacb34e946afd1767ac35967a3b6360360070"], "node": "54411b5fad11af7f818207c0fb940352224a17c7", "parents": ["a65e3d17012712d2a414ed3641b12e806e2ef8b2"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070683 - Draw an image texture rasterized for its rect 1:1 when the snapped rect is a device pixel off, instead of stretching it r=gfx-reviewers,nical\n\nWebRender snaps a primitive rect edge by edge, so a rect with a fractional\ndevice extent is a pixel wider or taller depending on its sub-pixel position.\nThe producer picks the raster size from the same rect without knowing that\nposition (scroll offset and reference-frame origins shift it under\nlayout.disable-pixel-alignment, and an animated transform makes it unknowable),\nso the two sizes can disagree by a pixel, and stretching the texture to fit\nresamples and blurs the whole image. Rounding differently on either side\neither seams against neighbours or fails for animated frames.\n\nInstead, Gecko sets a new PrimitiveFlags::RASTERIZED_FOR_RECT on image items\nwhose texture was rasterized at the dest rect's snapped device size (vector\nand downscaled raster images, not intrinsic-size bitmaps, video or canvas).\nFor a flagged image drawn once under an axis-aligned transform, WebRender\nplaces the texture 1:1 from the snapped origin when it is within a device\npixel of the snapped rect: a surplus row is clipped by the bounds, a shortfall\nrepeats the edge texel via the sampler clamp. The geometry is untouched, so\nnothing seams. The size check stays as a guard since the producer cannot see\nthe final transform or guarantee which surface the cache returned.\n\nThe wrench reftest covers the surplus and shortfall cases; the Gecko reftests\ncover a fractional reference-frame origin and a fractional scroll offset.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325755\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "gfx/layers/wr/WebRenderCommandBuilder.h", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/wrench/reftests/image/one-to-one-fractional-extent-ref.yaml", "gfx/wr/wrench/reftests/image/one-to-one-fractional-extent.yaml", "gfx/wr/wrench/reftests/image/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs", "layout/base/nsLayoutUtils.cpp", "layout/base/nsLayoutUtils.h", "layout/generic/nsImageFrame.cpp", "layout/painting/nsImageRenderer.cpp", "layout/reftests/image/image-fractional-raster-1-ref.html", "layout/reftests/image/image-refframe-fractional-raster-1.html", "layout/reftests/image/image-scrolled-fractional-raster-1.html", "layout/reftests/image/reftest.list", "layout/reftests/image/stripes-fractional.svg", "layout/svg/SVGImageFrame.cpp"], "git_node": "c60a50ce57f4def037e810b0d3483cbfe405d38b", "git_parents": ["d4a17f7e4e2c693e238f7d8f745c27688d7d7b2e"], "node": "a2cb2305751107d7e0917ce1240c1eac8326f9c4", "parents": ["54411b5fad11af7f818207c0fb940352224a17c7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071098 - Test that downscaling an NV12 source keeps its chroma rows apart. r=media-playback-reviewers,padenot\n\nAn 8x8 NV12 source with a distinct chroma pair per quadrant must keep each\npair when downscaled to 4x4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325180\n", "files": ["dom/media/gtest/TestImageConversion.cpp"], "git_node": "36c6eba4768331b234c8d90bac77f13a828dfc38", "git_parents": ["c60a50ce57f4def037e810b0d3483cbfe405d38b"], "node": "0c2b1124dc4b05dabb7ba2d7f249f0a205fd29eb", "parents": ["a2cb2305751107d7e0917ce1240c1eac8326f9c4"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071098 - Give the scaled NV12 intermediate its interleaved chroma stride. r=media-playback-reviewers,padenot\n\nThe downscaled NV12 intermediate keeps its chroma interleaved, so a row is\ntwice the planar chroma width; addressing it with the planar width made the\nrows overlap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325181\n", "files": ["dom/media/ImageConversion.cpp"], "git_node": "47761a33c4ba7890745a3341c8dcaf9f870cffe2", "git_parents": ["36c6eba4768331b234c8d90bac77f13a828dfc38"], "node": "a6c760a81a3d12334ff450f8448c98992c939003", "parents": ["0c2b1124dc4b05dabb7ba2d7f249f0a205fd29eb"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2070637 - Android roles cleanup round. r=Jamie\n\nThis is not comprehensive but instead of doing this as a drive-by or\ncreating a bug for each issue I am doing it here. I compared most\nof these cases with Chrome.\n\n* Remove table/grid role descriptions. The CollectionInfo API is used to\n  surmise the nature of these nodes. I'm preserver row/column header\n  because that is actually useful. Chrome does not expose description\n  for row/column header.\n* Remove list/listitem. Same as above, the CollectionInfo details are\n  used.\n* Remove switch, button, checkbox, radio, progress bar and image. There\n  are equivalent android class names for each (except for switch but it\n  is basically a checkbox.)\n* Remove entry and password text. They also have distinguishing class\n  names plus `isPassword()`.\n* Removed form since it didn't serve any use.\n* Fixed mapping of combobox. It was mistakenly mapped to a spinner.\n* Remove section and paragraph because they are too verbose.\n\nMore to come in the future!\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324731\n", "files": ["accessible/base/RoleMap.inc", "dom/locales/en-US/chrome/accessibility/AccessFu.properties"], "git_node": "0a924645b23616f5a86c9f1fdf8766cb824c49be", "git_parents": ["47761a33c4ba7890745a3341c8dcaf9f870cffe2"], "node": "2c1fb46778f006a6baa39f1d6064839c305fc749", "parents": ["a6c760a81a3d12334ff450f8448c98992c939003"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061691: When validating ranges in DocAccessibleParent::SelectionRanges, check that the start and end accs are HyperTextAccessibles. r=accessibility-platform-reviewers,eeejay\n\nAs noted in the comment in this method, tree and selection updates happen in separate IPDL calls, so it's possible for a client selection query to arrive between them.\nWe work around this by validating the Accessibles and offsets.\nPreviously, we null checked the Accessibles.\nHowever, it's possible (albeit rare) that the same id is reused immediately when an Accessible is destroyed and another one is created.\nIn this case, the id might now be associated with an Accessible that is not a HyperTextAccessible, thus causing a null deref in TextRange::Crop.\nTo fix this, we now check IsHyperText() as well when validating selection ranges.\n\nA cleaner fix would be to remove any selection range that contains an Accessible that is being removed from the RemoteAccessible cache.\nHowever, I worry iterating selection ranges on every single removal could get expensive, especially in the (admittedly rare) case that there are a lot of noncontiguous selection ranges.\nYet another alternative could be to somehow process selection range changes atomically with tree mutations, but I think this would be quite difficult to get right and would likely be plagued by obscure edge cases.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325785\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "ba6d3daaaf1c37f979c75922861ed818d15a4628", "git_parents": ["0a924645b23616f5a86c9f1fdf8766cb824c49be"], "node": "4250f96af8948f7107559910564d85633e35a2dd", "parents": ["2c1fb46778f006a6baa39f1d6064839c305fc749"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070938: Shut down the DocAccessible for an initial about:blank whose WindowGlobal is being reused for another document. r=accessibility-platform-reviewers,morgan\n\nIt's simpler if we only ever have one PDocAccessible for a PWindowGlobal, rather than introducing messy logic in the parent process to figure out which is the current document.\nWhen a WindowGlobal is reused, the old document is about to die anyway.\n\n1. When initialising a new DocAccessible, if there's already a DocAccessibleChild associated with the same WindowGlobal, shut down its DocAccessible early.\n2. It's possible that the old DocAccessible has been created, but DoInitialUpdate hasn't been called for it yet, which means there isn't a DocAccessibleChild yet when the new DocAccessible is initialised.\n  Therefore, shut down the DocAccessible in WillRefresh if its WindowGlobal has been reused.\n3. Don't allow a DocAccessible to be created if its WindowGlobal has been reused.\n  Otherwise, a DocAccessible destroyed by (1) or (2) might be recreated.\n\nThese changes prevent two PDocAccessibles from ever existing for the same PWindowGlobal at the same time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325270\n", "files": ["accessible/base/DocManager.cpp", "accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/ipc/DocAccessibleChild.h"], "git_node": "2875bf53a03eab575bb9cea8e13e25f6bcded15b", "git_parents": ["ba6d3daaaf1c37f979c75922861ed818d15a4628"], "node": "13e4a40039a7a39a88cae06be2edc203dcaeb025", "parents": ["4250f96af8948f7107559910564d85633e35a2dd"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2071872 - Add SurfaceDescriptorAndroidHardwareBuffer handling to GLBlitHelper::BlitSdToFramebuffer() r=gfx-reviewers,lsalzman\n\nSurfaceDescriptorAndroidHardwareBuffer handling in GLBlitHelper::BlitSdToFramebuffer() is necessary for Bug 2066020. It is used to handle CanvasSurface in TexUnpackSurface::TexOrSubImage().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325872\n", "files": ["gfx/gl/GLBlitHelper.cpp", "gfx/gl/GLBlitHelper.h"], "git_node": "f1f1076997424c6316f6d65de273514acd4b5262", "git_parents": ["2875bf53a03eab575bb9cea8e13e25f6bcded15b"], "node": "723676a2e841d5bf5e53e0a6314ed890a97a50a5", "parents": ["13e4a40039a7a39a88cae06be2edc203dcaeb025"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055092 - prevent click from focusing on PiP controls so that it doesn't interfere with space play/pause shortcut. r=niklas\" for causing failures at browser_controlButtonClickFocus.js.\n\nThis reverts commit 7c71bb03f6611418ed69ed5c3a4131420ffccf4a.\n", "files": ["toolkit/components/pictureinpicture/content/player.js", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_controlButtonClickFocus.js", "toolkit/components/pictureinpicture/tests/browser_improved_controls.js", "toolkit/components/pictureinpicture/tests/head.js"], "git_node": "ed1c7572f81979bc068844e882b52af5631bbb5e", "git_parents": ["f1f1076997424c6316f6d65de273514acd4b5262"], "node": "f1ad9d975e52f66d2c6e0bdc3901c8e12b19b754", "parents": ["723676a2e841d5bf5e53e0a6314ed890a97a50a5"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070637 - Android roles cleanup round. r=Jamie\" for causing geckoview failures.\n\nThis reverts commit 0a924645b23616f5a86c9f1fdf8766cb824c49be.\n", "files": ["accessible/base/RoleMap.inc", "dom/locales/en-US/chrome/accessibility/AccessFu.properties"], "git_node": "7ae0bd0d3c572c7adc11893e265138a82a63ee08", "git_parents": ["ed1c7572f81979bc068844e882b52af5631bbb5e"], "node": "0d0d9de1b0715551124e36c53d41d57a563aba13", "parents": ["f1ad9d975e52f66d2c6e0bdc3901c8e12b19b754"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065320 - Enable YouTube transcript extraction in PageExtractor by default r=ai-platform-reviewers,jbowser\" for causing build bustages\n\nThis reverts commit aa2f13e716cd524fd028dc59548885fe5a4b8bdb.\n", "files": ["modules/libpref/init/all.js", "toolkit/components/pageextractor/YouTubeExtraction.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_youtube_extraction.js"], "git_node": "38dd46150994b7c806866cfeb199526035162757", "git_parents": ["7ae0bd0d3c572c7adc11893e265138a82a63ee08"], "node": "bca8737c308d0df876ae765300c906b76d0bb41c", "parents": ["0d0d9de1b0715551124e36c53d41d57a563aba13"], "tags": []}], "date": 1789463765, "git_changesets": ["acfc2c2fa6678f7a683c64136