dless/HeadlessClipboardData.cpp", "widget/headless/HeadlessClipboardData.h", "widget/headless/tests/test_headless_clipboard.js", "widget/tests/mochitest.toml"], "git_node": "2fffd90776ed10d13d2638feb54f90e78f4da0f8", "git_parents": ["bde41fefbf3bbf89990216d2ce855bd1a023789d"], "node": "3529bbba57606dbc95e9abae8db13824b2c1ea3c", "parents": ["030be1db50eea30aaa53caebf5b7aaf6f773822d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2023965 - gtest r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288488\n", "files": ["netwerk/test/gtest/TestSyncStreamListener.cpp", "netwerk/test/gtest/moz.build"], "git_node": "6fa52227bba4e32f96cc83d79ebbab62a7615ceb", "git_parents": ["2fffd90776ed10d13d2638feb54f90e78f4da0f8"], "node": "9a9f0cf9c6a4b075cd544b142e76febee1b753ae", "parents": ["3529bbba57606dbc95e9abae8db13824b2c1ea3c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072388 - Use run-if for single-condition manifest-wide scope conditions. r=ci-and-tooling,accessibility-platform-reviewers,dom-core-reviewers,webgpu-reviewers,saschanaz,extension-reviewers,media-playback-reviewers,search-reviewers,devtools-reviewers,dom-storage-reviewers,dom-worker-reviewers,crashreporting-reviewers,padenot,scunnane,nical,robwu,edenchuang,smaug,Jamie,aryx,jdescottes\n\nThese manifests exclude a configuration the tests were never meant to cover\nrather than one they are broken in, so the condition belongs in run-if, where\ndashboards do not read it as work to do.\n\nEach new condition is the exact inverse of the skip-if it replaces, except for\nthe enterprise policies update manifest: os == 'win' && msix reduces to !msix\nbecause the msix variant only runs on Windows. Three comments referenced bugs\nthat do not describe the condition they sat on (bug 1534855 and bug 1536217 are\nboth windows/aarch64 timeouts, bug 1662758 is resolved invalid) and were\nreplaced with the actual reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326537\n", "files": ["accessible/tests/browser/browser.toml", "accessible/tests/browser/general/browser.toml", "browser/components/enterprisepolicies/tests/browser/disable_app_update/browser.toml", "browser/components/extensions/test/mochitest/mochitest.toml", "browser/components/originattributes/test/mochitest/mochitest.toml", "browser/components/remotecontrol/test/browser/browser.toml", "browser/extensions/formautofill/test/mochitest/mochitest.toml", "devtools/client/netmonitor/test/filters/browser.toml", "devtools/client/netmonitor/test/new-resend-request/browser.toml", "devtools/client/netmonitor/test/websockets/browser.toml", "dom/cache/test/mochitest/mochitest-common.toml", "dom/fs/test/mochitest/mochitest-private.toml", "dom/indexedDB/test/browser.toml", "dom/localstorage/test/browser.toml", "dom/media/test/mochitest_media_engine.toml", "dom/push/test/xpcshell/xpcshell.toml", "dom/quota/test/browser/browser.toml", "dom/serviceworkers/test/mochitest-dFPI.toml", "dom/serviceworkers/test/mochitest-private.toml", "dom/serviceworkers/test/mochitest.toml", "dom/webgpu/tests/mochitest/mochitest-no-pref.toml", "dom/webgpu/tests/mochitest/mochitest.toml", "editor/spellchecker/tests/mochitest.toml", "extensions/spellcheck/tests/mochitest/mochitest.toml", "services/settings/test/unit/xpcshell.toml", "toolkit/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "toolkit/components/forgetaboutsite/test/unit/xpcshell.toml", "toolkit/components/media/tests/browser.toml", "toolkit/components/ml/tests/xpcshell/xpcshell.toml", "toolkit/components/satchel/test/mochitest.toml", "toolkit/components/search/tests/xpcshell/xpcshell.toml", "toolkit/components/windowwatcher/test/mochitest.toml", "toolkit/components/xulstore/tests/xpcshell/xpcshell.toml", "toolkit/crashreporter/test/unit_ipc/xpcshell-phc.toml", "toolkit/crashreporter/test/unit_ipc/x