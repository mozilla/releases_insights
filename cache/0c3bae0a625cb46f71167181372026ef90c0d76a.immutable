ts": ["b1d70109484ae032d39bbbc67a3e0d489b7d4808"], "node": "d594f7b4b8c40b7a35d35d0969fb063fee971e82", "parents": ["1b8311f77112683b0bcd94c9c60752e0e45da2ef"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2073079 - Check mStreamClosed in ChunkSteps r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327029\n", "files": ["dom/fetch/FetchStreamReader.cpp", "dom/fetch/tests/crashtests/2073079-iframe.html", "dom/fetch/tests/crashtests/2073079.html", "dom/fetch/tests/crashtests/crashtests.list"], "git_node": "f5dffba37aee83d62d87b601d07b824184b5fb67", "git_parents": ["75ee7c59a0d3b10c69271634f08caf25c16b5a65"], "node": "f52f9d0d4f1b153a0d6d2bbefcb48ec274498e8b", "parents": ["d594f7b4b8c40b7a35d35d0969fb063fee971e82"], "tags": []}, {"author": "Matt Boris \u003cmboris@mozilla.com\u003e", "branch": "default", "desc": "Bug 2017950 [wpt PR 57878] - chore: migrate to generic worker, a=testonly\n\nAutomatic update from web-platform-tests\nchore: migrate to generic worker\n\n--\n\nwpt-commits: 38f9c2744432e2c7fa85c78903f7aa4705355f2e\nwpt-pr: 57878\n", "files": ["testing/web-platform/tests/.taskcluster.yml", "testing/web-platform/tests/tools/ci/tc/tasks/test.yml"], "git_node": "1cc2687b60c1cced598d9b24dea90317fc4f5bbf", "git_parents": ["f5dffba37aee83d62d87b601d07b824184b5fb67"], "node": "4601177faa615411effe57539aafc7f9d4556c7e", "parents": ["f52f9d0d4f1b153a0d6d2bbefcb48ec274498e8b"], "tags": []}, {"author": "Minseong Kim \u003cjja08111@gmail.com\u003e", "branch": "default", "desc": "Bug 2071796 [wpt PR 62668] - [css-overflow] Support text-overflow in textarea elements, a=testonly\n\nAutomatic update from web-platform-tests\n[css-overflow] Support text-overflow in textarea elements\n\nBlink did not apply text-overflow to \u003ctextarea\u003e. The inner editor style\nskipped it for multiline controls, so ellipsis or a string was never\nshown. Add support behind the new TextOverflowInTextarea flag.\n\nKey changes:\n- Apply text-overflow style to the textarea's inner editor.\n- Propagate text-overflow to the anonymous line blocks via\n  UpdateAnonymousChildStyle(), since text-overflow is not inherited.\n- Mark truncated lines for layout invalidation when textarea scroll\n  state changes to ensure ellipsis renders correctly.\n\nFixed: 556432992\nChange-Id: I0ec7780ff59038413c357ccf1734f98dd9d7192a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8377322\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Minseong Kim \u003cjja08111@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1697130}\n\n--\n\nwpt-commits: f2d99507a2933a125cf68f28b0c73f523b75c22b\nwpt-pr: 62668\n", "files": ["testing/web-platform/tests/css/css-overflow/text-overflow-in-readonly-textarea-focused-ref.html", "testing/web-platform/tests/css/css-overflow/text-overflow-in-readonly-textarea-focused.html", "testing/web-platform/tests/css/css-overflow/text-overflow-in-textarea-notref.html", "testing/web-platform/tests/css/css-overflow/text-overflow-in-textarea.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-after-blur.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-dynamic-text-overflow.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-dynamic-value.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-dynamic-width-notref.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-dynamic-width.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-field-sizing-content-fits-ref.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-field-sizing-content-fits.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-field-sizing-content-notref.html", "testing/web-platform/tests/c