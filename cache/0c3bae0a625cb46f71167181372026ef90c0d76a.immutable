reporting/screen-wake-lock-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/serial-reporting.https.html.ini"], "git_node": "8b7328b69b8fba544bb3c048987010f11a83ceec", "git_parents": ["b5572f5cae174a1d3da7fa23b0048806fb2981e7"], "node": "0a4a9fce7dfbcd2f9b95764740fae6a27488a84d", "parents": ["bc106720fcca90621aab2dab56bfbce5d7e2a843"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072660 - Remove nightly build annotations now that skpdf is riding the trains. r=layout-reviewers,gfx-reviewers,dholbert,lsalzman\" for causing wpt failures in /monolithic-overflow-032-print.tentative.html\n\nThis reverts commit c67408d238b455a4a2f1aadb0c912fee3287d00a.\n", "files": ["testing/web-platform/meta/css/css-break/block-001-wm-vrl-print.html.ini", "testing/web-platform/meta/css/css-page/fixedpos-with-abspos-with-link-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-008-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-019-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-032-print.tentative.html.ini", "testing/web-platform/meta/css/css-page/page-name-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-landscape-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-002-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-003-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-square-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-size-015-print.tentative.html.ini", "testing/web-platform/meta/css/printing/select-combobox-print.html.ini", "testing/web-platform/mozilla/meta/html/canvas/mozPrintCallback-text-001-print.html.ini", "testing/web-platform/mozilla/meta/html/canvas/mo