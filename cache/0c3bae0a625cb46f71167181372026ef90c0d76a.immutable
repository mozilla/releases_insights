img-element/__dir__.ini"], "git_node": "24c53e55deb24bc6229a26ac541037dfb07d868e", "git_parents": ["6399208a6b0ab89af6a834648e0330367168ccd1"], "node": "a265ff9fed6d25054745e77085e5c3c3f17d583a", "parents": ["f3dab31e9ae7bb5ae5e92a3cefe344dc0894494d"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033633 - Skip density correction for fallback intrinsic height. r=dholbert\n\nTrack whether the natural height came from the fallback concrete object size and skip Y-axis density correction in that case. Remove the WPT failure annotations fixed by the change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326312\n", "files": ["dom/base/nsImageLoadingContent.cpp", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/naturalWidth-naturalHeight-width-height.html.ini"], "git_node": "da9b26b4440a48c5bf17b3bf8ae702736f4f47ff", "git_parents": ["24c53e55deb24bc6229a26ac541037dfb07d868e"], "node": "3c6dd8ae51b8e81729458e59d5b282fd1ca808e3", "parents": ["a265ff9fed6d25054745e77085e5c3c3f17d583a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071724 - Refresh the Android lint baselines. r=android-reviewers,geckoview-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325739\n", "files": ["mobile/android/android-components/samples/browser/lint-baseline.xml", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/geckoview/lint-baseline.xml"], "git_node": "ae40ee013ee44c279fbb3f879533fb74d5eae541", "git_parents": ["da9b26b4440a48c5bf17b3bf8ae702736f4f47ff"], "node": "7ac9aae86c5a4243a6f234558e01101852bb2f28", "parents": ["3c6dd8ae51b8e81729458e59d5b282fd1ca808e3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071724 - Fix the Android lint findings that have a plain fix. r=android-reviewers,tcampbell\n\nFragment.content() composes as soon as the view attaches, before onViewCreated(), so the fragments that used\nto call setContent() from there now compute what the content reads in onCreateView() instead.\n\nThe two onboarding drawables in fenix's keep.xml were listed with a .xml suffix, which the keep list does not\nmatch, so lint reported them unused even though they exist to be named from Nimbus.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325740\n", "files": ["mobile/android/android-components/components/browser/menu/lint-baseline.xml", "mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_web_extension.xml", "mobile/android/android-components/components/feature/prompts/lint-baseline.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/layout/mozac_feature_text_prompt.xml", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/NavigationGraphContractTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/SelectorContainerContractTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pbmlock/UnlockPrivateTabsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/trackingprotection/TrackingProtectionCategoryItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsDialogFragment.kt", "mobile/android/fenix/app/src/main/res/raw/keep.xml", "mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/focus-android/app/build.gradle", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/biometrics/BiometricAuthenticationFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/onboarding/OnboardingFirstFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/onboarding/OnboardingSecondFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/settings/BaseComposeFragment.kt"], "git_node": "4e5fb4627b40832216adf76a41f897dd93e55ed2", "git_parents": ["ae40ee013ee44c279fbb3f879533fb74d5eae541"], "node": "97d57f1e53bed53523099d62b4152f67d579a6a1", "parents": ["7ac9aae86c5a4243a6f234558e01101852bb2f28"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071724 - Suppress Android lint findings that report intended behaviour. r=android-reviewers,geckoview-reviewers,tcampbell\n\nA baseline entry hides a finding without saying so. These become suppressions at the site, with a comment\nonly where the reason is not visible from there.\n\nAppBundleLocaleChanges is turned off for fenix and focus in the shared config rather than at the call site,\nbecause lint reports only the first locale change it finds, so an annotation just moves the report.\n\nThe StaticFieldLeak entry for the DRM provisioning task stays: the fix there is retiring AsyncTask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325741\n", "files": ["mobile/android/android-components/components/browser/toolbar/lint-baseline.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/layout/mozac_browser_toolbar_edittoolbar.xml", "mobile/android/android-components/samples/sync-logins/lint-baseline.xml", "mobile/android/android-components/samples/sync-logins/src/main/res/layout/activity_main.xml", "mobile/android/android-components/samples/sync/lint-baseline.xml", "mobile/android/android-components/samples/sync/src/main/res/layout/activity_main.xml", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Push.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareController.kt", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/geckoview/lint-baseline.xml", "mobile/android/geckoview/src/main/AndroidManifest_overlay.jinja", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoJavaSampler.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoNetworkManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoThread.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoView.java", "mobile/android/shared-lint.xml"], "git_node": "9ed2094eaaadae2d84abeee876a4c945c912f4e4", "git_parents": ["4e5fb4627b40832216adf76a41f897dd93e55ed2"], "node": "c6d298caa3165f3572feb8f8fbafd17d1548905f", "parents": ["97d57f1e53bed53523099d62b4152f67d579a6a1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071724 - Store the Focus bitmaps that are not launcher icons as lossless WebP. r=android-reviewers,tcampbell\n\nConvertToWebp reports one file per project, so the baselined onboarding icon stood in for every PNG the check\naccepts. Each WebP decodes to the same pixels as the PNG it replaces, at about half the size. Launcher icons\nstay PNG, which the check exempts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325742\n", "files": ["mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/beta/res/drawable/ic_splash_screen.png", "mobile/android/focus-android/app/src/beta/res/drawable/ic_splash_screen.webp", "mobile/android/focus-android/app/src/debug/res/mipmap-hdpi/ic_launcher_foreground.png", "mobile/android/focus-android/app/src/debug/res/mipmap-hdpi/ic_launcher_foreground.webp", "mobile/android/focus-android/app/src/debug/res/mipmap-xhdpi/ic_launcher_foreground.png", "mobile/android/focus-android/app/src/debug/res/mipmap-xhdpi/ic_launcher_foreground.webp", "mobile/android/focus-android/app/src/debug/res/mipmap-xxhdpi/ic_launcher_foreground.png", "mobile/android/focus-android/app/src/debug/res/mipmap-xxhdpi/ic_launcher_foreground.webp", "mobile/android/focus-android/app/src/debug/res/mipmap-xxxhdpi/ic_launcher_foreground.png", "mobile/android/focus-android/app/src/debug/res/mipmap-xxxhdpi/ic_launcher_foreground.webp", "mobile/android/focus-android/app/src/main/res/drawable-hdpi/focus_search_widget.png", "mobile/android/focus-android/app/src/main/res/drawable-hdpi/focus_search_widget.webp", "mobile/android/focus-android/app/src/main/res/drawable-hdpi/focus_search_widget_promote_dialog.png", "mobile/android/focus-android/app/src/main/res/drawable-hdpi/focus_search_widget_promote_dialog.webp", "mobile/android/focus-android/app/src/main/res/drawable-night-hdpi/focus_search_widget.png", "mobile/android/focus-android/app/src/main/res/drawable-night-hdpi/focus_search_widget.webp", "mobile/android/focus-android/app/src/main/res/drawable-night-hdpi/focus_search_widget_promote_dialog.png", "mobile/android/focus-android/app/src/main/res/drawable-night-hdpi/focus_search_widget_promote_dialog.webp", "mobile/android/focus-android/app/src/main/res/drawable-nodpi/onboarding_second_screen_icon.png", "mobile/android/focus-android/app/src/main/res/drawable-nodpi/onboarding_second_screen_icon.webp", "mobile/android/focus-android/app/src/nightly/res/drawable/ic_splash_screen.png", "mobile/android/focus-android/app/src/nightly/res/drawable/ic_splash_screen.webp"], "git_node": "770c9739294de174f2b668c19e13992bc6b62549", "git_parents": ["9ed2094eaaadae2d84abeee876a4c945c912f4e4"], "node": "3a8e1d4599024ee4d7918f3ca2e19237a52a58a9", "parents": ["c6d298caa3165f3572feb8f8fbafd17d1548905f"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused environment.build fields r=TravisLong\n\n`environment.build` has the honour of being the only section of the\nEnvironment that has required fields. And some of those required fields\nmust be of specific types and/or specific patterns.\n\nThis means that \"removing\" the seven unused fields results in:\n* 2 set to \"\" to satisfy required strings\n* 2 set to \"00.\" to satisfy required strings with version patterns\n* 1 set to null as vendor is required but can be null or string\n* 2 actually removed (displayVersion and updaterAvailable)\n\nAnd it only results in one decrement of the count, for updaterAvailable,\nas the rest weren't ever mirrored in Glean inside the Environment\n(because they were either already instrumented in client_info, or they\nweren't useful data to mirror).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323061\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs"], "git_node": "6b9b468ae144d706e0252161903e1f418b0c7d0a", "git_parents": ["770c9739294de174f2b668c19e13992bc6b62549"], "node": "7cd63cd124841857506d9bf93e41c2658cb94a5b", "parents": ["3a8e1d4599024ee4d7918f3ca2e19237a52a58a9"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.settings pieces r=TravisLong\n\nThis does deliberately decrease the frequency of\nenvironment-change-reason \"main\" pings for when private browsing mode\nhas a separate search engine and that search engine's data changes.\nThis is not a currently-shipping configuration and search counts are\ndetermined by events not by this configuration, so we're fine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323062\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment_search.js"], "git_node": "f60e9688f1b4a92ce627809374091a72a04a6bae", "git_parents": ["6b9b468ae144d706e0252161903e1f418b0c7d0a"], "node": "8fbb594d6368bd0301c975434767d9dd19293d7c", "parents": ["7cd63cd124841857506d9bf93e41c2658cb94a5b"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.services r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323063\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "c3c0e110c8712150936c2a23f88fcd87ef3b50c8", "git_parents": ["f60e9688f1b4a92ce627809374091a72a04a6bae"], "node": "49139d3a40ec100212a1ce44eb17c42f9a99bbc8", "parents": ["8fbb594d6368bd0301c975434767d9dd19293d7c"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.system fields r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325164\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "31f2aaf23e789b9350744a3017ac7e6bd2f2de0b", "git_parents": ["c3c0e110c8712150936c2a23f88fcd87ef3b50c8"], "node": "fa6015b5b5d215173cee7c89ffeae3abe3a3bf8e", "parents": ["49139d3a40ec100212a1ce44eb17c42f9a99bbc8"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.system.cpu fields r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325165\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "a2c7d0884a5fbb1234b096d703fcea124e70f925", "git_parents": ["31f2aaf23e789b9350744a3017ac7e6bd2f2de0b"], "node": "4c70718ee4032380f6193a7b337ccd6e88d2abdd", "parents": ["fa6015b5b5d215173cee7c89ffeae3abe3a3bf8e"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.system.os fields r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325166\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "e80e9b8ffb81164588461615843caf5d3f861ca3", "git_parents": ["a2c7d0884a5fbb1234b096d703fcea124e70f925"], "node": "6eca17103fd8320351824b0e2171e6744e40e9f2", "parents": ["4c70718ee4032380f6193a7b337ccd6e88d2abdd"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.system.hdd fields r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325167\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "beb2cef02eee2fb73cc51be6b5b7736ad7e94f57", "git_parents": ["e80e9b8ffb81164588461615843caf5d3f861ca3"], "node": "df6f26abe88ab10f085648918ee98db497371bb2", "parents": ["6eca17103fd8320351824b0e2171e6744e40e9f2"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.system.sec section r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325168\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs"], "git_node": "0b04cfe8ac120a85f0ae3999fb4fb3621924b7cd", "git_parents": ["beb2cef02eee2fb73cc51be6b5b7736ad7e94f57"], "node": "97d3b5cbcfd790563dc39636d1467b87c938f32d", "parents": ["df6f26abe88ab10f085648918ee98db497371bb2"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Remove unused Legacy Telemetry environment.profile fields r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325169\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs"], "git_node": "b386c7380608e3f1f86585eefd6eb866f813ed28", "git_parents": ["0b04cfe8ac120a85f0ae3999fb4fb3621924b7cd"], "node": "077bdc1116669aa20830cd030fdd97e08ad0254c", "parents": ["97d3b5cbcfd790563dc39636d1467b87c938f32d"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068624 - Don't test now-removed pieces of the Legacy Environment r=beth\n\nMore generally, perhaps unconstrained access to the Legacy Telemetry\ninternals via ClientEnvironment should be discouraged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325438\n", "files": ["toolkit/components/utils/test/unit/test_ClientEnvironment.js"], "git_node": "3f8126deed98e4f4d33b950c701910f706b94afc", "git_parents": ["b386c7380608e3f1f86585eefd6eb866f813ed28"], "node": "b754b02c4bed02dae2eb430b270503ca4f4ed500", "parents": ["077bdc1116669aa20830cd030fdd97e08ad0254c"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072535 - Update test_renderer_strings's KNOWN_ON_CI strings for Metal ANGLE. r=gfx-reviewers,lsalzman\n\nWith ANGLE enabled, the renderer and vendor strings reported by the\nARM macOS 15 workers now include \"ANGLE\" and \"Google Inc.\"\nrespectively. Metal ANGLE is blocked on macOS versions older than 12,\ntherefore the strings reported by the macOS 10.15 workers are\nunaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326498\n", "files": ["dom/canvas/test/webgl-mochitest/test_renderer_strings.html"], "git_node": "a448e32208ec833632ab3134597b18992cf331e4", "git_parents": ["3f8126deed98e4f4d33b950c701910f706b94afc"], "node": "cc839ad09892190c600384ef5d9e146fed71ffef", "parents": ["b754b02c4bed02dae2eb430b270503ca4f4ed500"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072535 - Enable Metal ANGLE for WebGL on Nightly. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326499\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "63f75269265fe157bf7ef9ec56f8ae242e7f93a3", "git_parents": ["a448e32208ec833632ab3134597b18992cf331e4"], "node": "4209d9b686c553d066ea266309dec4ece9805894", "parents": ["cc839ad09892190c600384ef5d9e146fed71ffef"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072535 - Update test expectations. r=gfx-reviewers,lsalzman\n\nEnabling Metal ANGLE for WebGL causes a bunch of tests to now pass on\naarch64 macOS 15 workers.\n\nHowever, there are additionally a few tests that must now be skipped\ndue to assertion failures in debug builds. Note that these are already\nskipped on Windows for the same reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326500\n", "files": ["dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml"], "git_node": "ec0228090a7833fef42fb3a2e961b8929008d97f", "git_parents": ["63f75269265fe157bf7ef9ec56f8ae242e7f93a3"], "node": "6e7f84dbe3c8b8b97f85348d64afddde357e8bae", "parents": ["4209d9b686c553d066ea266309dec4ece9805894"], "tags": []}, {"author": "Shravan Narayan \u003cshravanrn@gmail.com\u003e", "branch": "default", "desc": "Bug 2052735 - Update rlbox to new version r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322128\n", "files": ["third_party/rlbox/crash-reporting-messages.patch", "third_party/rlbox/fix-includes.patch", "third_party/rlbox/include/rlbox.hpp", "third_party/rlbox/include/rlbox_conversion.hpp", "third_party/rlbox/include/rlbox_helpers.hpp", "third_party/rlbox/include/rlbox_policy_types.hpp", "third_party/rlbox/include/rlbox_range.hpp", "third_party/rlbox/include/rlbox_sandbox.hpp", "third_party/rlbox/include/rlbox_stdlib.hpp", "third_party/rlbox/include/rlbox_stdlib_polyfill.hpp", "third_party/rlbox/include/rlbox_struct_support.hpp", "third_party/rlbox/include/rlbox_type_traits.hpp", "third_party/rlbox/moz.yaml", "third_party/rlbox/unaligned-transfer-buffers.patch"], "git_node": "8407246446499a11e6ef40651bddc29be4bf306a",