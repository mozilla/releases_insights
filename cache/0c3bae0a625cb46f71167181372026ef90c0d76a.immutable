088d7df51c7640da0ac6bdbc36ab2ecb21bd6", "c97c572f155e34a846e6d17dda7ceb3a87343b34", "3677152c51e4ff3588af9f4e4b321a7d2609a1cd", "b29233727193bc656e0861b04073829049241542", "1e4cac5e315796e0ef885a9dbb0e8d5977c751dd", "180555f57f85ebb6f67e13d134d1962435938b25", "9218e63542cccf76054284d84f95c07f1b0b4332", "cd26e830fbd08d25651325c59cb4185d4b074605", "3091c41cccca5c9b4b39dca19471219248bbc220", "e3fd933b6b9eab9d6d9ea44f80638997d87e4c27", "ba38c8ed60ee92f9a821edb4695e9a601cb899af", "43beaeb8475b261efc31765a78aa8bf44dae5970", "5a679b379d3f18594f70fe1fc24a6c3a72d34bc6", "1528906c189e72e57ae3764cac17bf72760c5323", "3cb72c0e3c5f8c4225d980d2316b7c21985b209c", "31f6caa59401688be4069822ab59d6e9704a5657", "bc6a6aa2df09a18574315ad5eb8b8cfc49496629", "c135ecdfcbc39cbf4cb3a1497d091254f23396f0", "dad2ad4606152e22b19b1fc61cc5fd77248a10a4", "3b3a1f98dc11d7e3cbacacbe2fd132617dfb7826", "5286e4a2eb926cf946acf09cf017075c2a15e0e6", "a663f6b64c73b60eacf975aa842c962c0c3fecf0", "7f784d01219744bdf60152f16fa305c4ba8504b8", "3733b31f0f99e77537d43da43812c6d88e9016ca", "e5f751bfb47334aee27989e141b193f350a2ec73", "353e7cdc7e3e2289fd3e66d16f45dab10592611e", "ac8a2f6218c905fe6a49f953b81c83faa5b954d7", "fdf6226a55a7ea936b127788257575be949c7931", "5a6c9d88f012a7bde18ec3e6ea34b55e8ba3faee", "7d51fa9de93ad9788e088e3d85c32661a7d515b2", "79b83ef81ee8447c914a3016f4fc66d2def4581d", "aee5cb0fdb77ae062e1ba8a5169064588787032a", "fcfb26d7c6a75e1c987cb2d687fc68509906b20e", "39a7a6b364555cdbfc712dbf766c8e83dca22aac", "8d76a2ba4c3a730703578ac8f850a243cc3cda77"], "user": "amarc@mozilla.com"}, "45339": {"changesets": [{"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050422 - Give each xpcshell harness run its own `tempDir` r=ahal\n\nWithout a `tempDir`, every `XPCShellTests` writes its prefs to the same\n`user.js` in the process wide temp dir. The self tests run in parallel, so\nthey interleave writes to it, and xpcshell either fails to parse the result\nor the main suite runs with a self test's prefs.\n\nThe self tests could pass their own `tempDir`, since each already owns one.\nInstead the harness creates a private directory whenever the caller gives\nnone and removes it on every exit, so any two runs that leave the choice to\nthe harness stay apart, not only the self tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326019\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "b647e1c32aa3d44327599cf6fc7d1622bdbf8bcd", "git_parents": ["8d76a2ba4c3a730703578ac8f850a243cc3cda77"], "node": "fa664183ca6ec06520135bfea36d5197ee3eb3b7", "parents": ["83943a4ec5c46429ffd00e873a91a63da837e870"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2070547 - Enforce guard sets for activeTab r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324717\n", "files": ["toolkit/components/extensions/WebExtensionPolicy.cpp", "toolkit/components/extensions/test/xpcshell/test_WebExtensionContentScript.js"], "git_node": "ded1ba42e21ca3f75c49facbdfbd25be4f3f1829", "git_parents": ["b647e1c32aa3d44327599cf6fc7d1622bdbf8bcd"], "node": "8920e6c22f592ed00c6b293203c60ad2291a1789", "parents": ["fa664183ca6ec06520135bfea36d5197ee3eb3b7"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2062649: Construct this RTCErrorEvent properly. r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322983\n", "files": ["testing/web-platform/meta/webrtc/idlharness.https.window.js.ini", "testing/web-platform/tests/webrtc/idlharness.https.window.js"], "git_node": "b5ca36d8ea0ea8841cdb9fd98b24b4a317bbdb8b", "git_parents": ["ded1ba42e21ca3f75c49facbdfbd25be4f3f1829"], "node": "10a5657bfe7dbc86adf75d5cbc1f9f671883652a", "parents": ["8920e6c22f592ed00c6b293203c60ad2291a1789"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2072321: Remove some invalid awaits in this test. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326270\n", "files": ["testing/web-platform/tests/webrtc/RTCRtpTransceiver.https.html"], "git_node": "e088e7ac56f6d2c35b13031f58e312164c8dbec0", "git_parents": ["b5ca36d8ea0ea8841cdb9fd98b24b4a317bbdb8b"], "node": "45895e871b3f89c7162bd74eda67aac6ffc537d5", "parents": ["10a5657bfe7dbc86adf75d5cbc1f9f671883652a"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Use weak references in sLayerToBrowserParentTable and unregister in ~BrowserParent. r=dom-core-reviewers,smaug\n\nUsing weak references in sLayerToBrowserParentTable ensures that we never end\nup with dangling pointers. Clean up the table in ~BrowserParent() in case we\nskipped ActorDestroy.\n\nGetBrowserParentFromLayersId now returns an already_AddRefed because we were\nholding onto a strong reference anyways, and it is probably better anyways to\nhold strong stack references in the callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323315\n", "files": ["dom/events/EventStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": "70a0e0f3990df030cdc8919b998af57be2d4d822", "git_parents": ["e088e7ac56f6d2c35b13031f58e312164c8dbec0"], "node": "5bea9bcad755bb19467c8a03d7d31d97e04a9768", "parents": ["45895e871b3f89c7162bd74eda67aac6ffc537d5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Reject child-initiated deletion. r=dom-core-reviewers,smaug\n\nThe child should only send us the delete message after we've sent it the\nDestroy message, so if that's not the case, something has gone wrong, so\nlet's kill the child process to prevent further hijinks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323316\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "60be40f218a293aa0279b8aa9371ee5efdb10cf0", "git_parents": ["70a0e0f3990df030cdc8919b998af57be2d4d822"], "node": "7ed7403b87703ff56a336dfe56c7ee95308c038d", "parents": ["5bea9bcad755bb19467c8a03d7d31d97e04a9768"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Don't initialize rendering for an already-destroyed BrowserParent. r=dom-core-reviewers,smaug\n\nIf we can't send in nsFrameLoader::TryRemoteBrowserInternal() or\nBrowserParent::InitRendering(), then we've already started the process of\ndestroying the BrowserParent, so don't set up this rendering stuff that we may\nhave already tried to clean up.\n\nNote that mIsDestroyed is not usable here: it is only set by BrowserParent::Destroy(),\nwhich is not involved when the child initiates teardown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323317\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "82d27294cc239742b0aac22148b627b4af6e1c1e", "git_parents": ["60be40f218a293aa0279b8aa9371ee5efdb10cf0"], "node": "fc9809d77146e9f67ceeb738b4d22c5c4b1f046f", "parents": ["7ed7403b87703ff56a336dfe56c7ee95308c038d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034727 - Allow both TIMEOUT and FAIL for MediaStreamTrack-iframe-audio-transfer.https.html on macOS. r=webrtc-reviewers,ng\n\nOn macOS getDisplayMedia() either resolves with a stream lacking an audio\ntrack (harness ERROR, subtest TIMEOUT) or rejects with NotAllowedError\n(harness OK, subtest FAIL). wpt-sync has been flip-flopping the\nexpectation between the two, so accept both on all mac configurations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326338\n", "files": ["testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini"], "git_node": "bd06fdfdd728e283199307e167156ab849c63868", "git_parents": ["82d27294cc239742b0aac22148b627b4af6e1c1e"], "node": "f0baecb3fecffd1fe57778a7524e231aa97afa23", "parents": ["fc9809d77146e9f67ceeb738b4d22c5c4b1f046f"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071373 - Update opus to 503d81b138d76621aae4b12786e90de48aa8db3a r=kinetik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325452\n", "files": ["media/libopus/celt/arm/arm_celt_map.c", "media/libopus/celt/arm/celt_arm_asm.h", "media/libopus/celt/arm/celt_fft_ne10.c", "media/libopus/celt/arm/celt_mdct_ne10.c", "media/libopus/celt/arm/celt_mdct_tx.c", "media/libopus/celt/arm/celt_neon_aarch64.S", "media/libopus/celt/arm/celt_neon_intr.c", "media/libopus/celt/arm/celt_tx_neon.S", "media/libopus/celt/arm/fft_arm.h", "media/libopus/celt/arm/mdct_arm.h", "media/libopus/celt/arm/pitch_arm.h", "media/libopus/celt/celt.h", "media/libopus/celt/celt_decoder.c", "media/libopus/celt/celt_encoder.c", "media/libopus/celt/celt_tx_tables.c", "media/libopus/celt/celt_tx_tables.h", "media/libopus/celt/kiss_fft.c", "media/libopus/celt/kiss_fft.h", "media/libopus/celt/mdct.c", "media/libopus/celt/mdct.h", "media/libopus/celt/mdct_pfa.c", "media/libopus/celt/mips/mdct_mipsr1.h", "media/libopus/celt/pitch.h", "media/libopus/celt/static_modes_fixed.h", "media/libopus/celt/static_modes_fixed_arm_ne10.h", "media/libopus/celt/static_modes_float.h", "media/libopus/celt/static_modes_float_arm_ne10.h", "media/libopus/moz.build", "media/libopus/moz.yaml", "media/libopus/sources.mozbuild"], "git_node": "f181d0a7fcbf91dbde886996dc97abebad13503c", "git_parents": ["bd06fdfdd728e283199307e167156ab849c63868"], "node": "15afbbdf6e95beab22fe7d7be2e5ae5a3e32e10c", "parents": ["f0baecb3fecffd1fe57778a7524e231aa97afa23"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2069690 r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325734\n", "files": ["gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/VideoBridgeParent.cpp"], "git_node": "7f36df2f6ddcace05696ed6deb06101093facc66", "git_parents": ["f181d0a7fcbf91dbde886996dc97abebad13503c"], "node": "aaee73157cd168f21fd72cded7e5b5194a1c1f6b", "parents": ["15afbbdf6e95beab22fe7d7be2e5ae5a3e32e10c"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2071067 r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325229\n", "files": ["gfx/layers/composite/TextureHost.cpp"], "git_node": "2d6d12b38b9e8fb6350821a2c33a287c69f42552", "git_parents": ["7f36df2f6ddcace05696ed6deb06101093facc66"], "node": "11588fd9df3784365285ddc6221412d5322596ec", "parents": ["aaee73157cd168f21fd72cded7e5b5194a1c1f6b"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050422 - Give each xpcshell harness run its own `tempDir` r=ahal\" for causing xpcshell failures @ test_unix_domain\n\nThis reverts commit b647e1c32aa3d44327599cf6fc7d1622bdbf8bcd.\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "ba895c98626c0762379161604e358d685bd0bda1", "git_parents": ["2d6d12b38b9e8fb6350821a2c33a287c69f42552"], "node": "c678157b86657ac4975ad1b3224796558b938d27", "parents": ["11588fd9df3784365285ddc6221412d5322596ec"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064059 - Make MediaCapabilities validate AV1 fmtp params. r=webrtc-reviewers,media-playback-reviewers,ng,azebrowski\n\nnavigator.mediaCapabilities.decodingInfo()/encodingInfo() with type:\n'webrtc' granted AV1 support purely by codec-name match, ignoring any\nprofile/level-idx/tier parameters attached to the contentType -- unlike\nH264, which validates profile-level-id/packetization-mode via\nParseH264Fmtp and H264LevelFits.\n\nAdd the AV1 equivalents, mirroring the H264 files and call sites:\n- AV1FmtpParser.{h,cpp}: ParseAV1Fmtp validates profile (delegating to\n  webrtc::StringToAV1Profile), level-idx (restricted to the levels with\n  defined Annex A.3 parameters, or 31 \"Maximum parameters\"), and tier.\n  level-idx and tier are parsed strictly with std::from_chars, so\n  values with signs, whitespace or trailing junk are rejected.\n  AV1LevelFits checks a resolution/framerate against a level's\n  MaxHSize/MaxVSize/MaxPicSize/MaxDisplayRate, using a table\n  transcribed directly from the AV1 spec's Annex A.3 \"Levels\" table.\n- WebrtcCodecInfo's support check rejects any present-but-invalid fmtp\n  parameter, for AV1 and now also for H264's profile-level-id (it only\n  rejected an invalid packetization-mode before). This is the same\n  constraint H264 has there since no resolution is available.\n- MediaCapabilities' two WebRTC decode/encode gates are reduced to a\n  shared WebrtcVideoExceedsLevel helper that checks the requested\n  resolution/framerate against the signaled H264/AV1 level, plus\n  rejecting AV1 tier=1 with an explicit level below 4.0, for which\n  Annex A.3 defines no high tier parameters. The repeated unsupported\n  result boilerplate is factored into UnsupportedInfo.\n\nAn absent level (profile-level-id for H264, level-idx for AV1) is\ndeliberately not defaulted to the RTP payload spec's default (1.0 and\n3.1 respectively): the resolution and framerate are given explicitly, so\nthe level is inferred from them. This also means tier=1 with no\nlevel-idx is not rejected, as the inferred level is only a lower bound.\n\nThreading validated params into the actual encoder config\n(EncoderConfig::CodecSpecific has no AV1Specific variant) is a separate,\nlarger problem and not part of this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321190\n", "files": ["dom/media/gtest/TestAV1FmtpParser.cpp", "dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/gtest/moz.build", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/webrtc/AV1FmtpParser.cpp", "dom/media/webrtc/AV1FmtpParser.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/H264FmtpParser.h", "dom/media/webrtc/moz.build", "testing/web-platform/mozilla/tests/media-capabilities/decodingInfo-webrtc-av1-fmtp.any.js", "testing/web-platform/mozilla/tests/media-capabilities/encodingInfo-webrtc-av1-fmtp.any.js"], "git_node": "da051a533581b0d48319a5e7276799010dba6cde", "git_parents": ["ba895c98626c0762379161604e358d685bd0bda1"], "node": "c055f1ab386db74b4313c525008df777cc7c1ccb", "parents": ["c678157b86657ac4975ad1b3224796558b938d27"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072044 - Carry the display list normalization offset in i64 r=gfx-reviewers,lsalzman\n\nSticky frames subtract their previously applied offset from the\naccumulated offset, and an unconstrained sticky range edge is\nnscoord_MIN / 2, so four nested sticky frames overflowed i32. Such\noffsets are already past MAX_EXACT_AU, so widening loses no exactness.\n\nDo not add a doctype to the crashtest; in standards mode the elements do\nnot nest into four sticky frames.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326316\n", "files": ["gfx/wr/webrender_api/src/display_list.rs", "layout/painting/crashtests/2072044.html", "layout/painting/crashtests/crashtests.list"], "git_node": "c5ad4c2f3a6340580ee9fff803cef2de7e40f58a", "git_parents": ["da051a533581b0d48319a5e7276799010dba6cde"], "node": "50d0a34dcffd9a933546a1a722de27eb2b9072c8", "parents": ["c055f1ab386db74b4313c525008df777cc7c1ccb"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2069703. Use the correct path for three upstream filenames in parser/expat/moz.yaml's include list. r=hsivonen,RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323902\n", "files": ["parser/expat/expat/AUTHORS", "parser/expat/expat/Changes", "parser/expat/expat/README.md", "parser/expat/moz.yaml"], "git_node": "a5b65d524d484646d52a8e2bfbdd8333fe5277d8", "git_parents": ["c5ad4c2f3a6340580ee9fff803cef2de7e40f58a"], "node": "ebaebb4ad22c64210af1e1fad313671a5eeeddc0", "parents": ["50d0a34dcffd9a933546a1a722de27eb2b9072c8"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326356\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "1c95283f88aa57fa33805ec8407539eb345739b4", "git_parents": ["a5b65d524d484646d52a8e2bfbdd8333fe5277d8"], "node": "f14fec9a0b023e16a10559f5364afbb4b2f7f104", "parents": ["ebaebb4ad22c64210af1e1fad313671a5eeeddc0"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2068790 - Let image conversion select the RGB-to-YUV matrix and range r=media-playback-reviewers,alwu\n\nPreviously, the I420 or NV12 conversion from RGB sources were always\nwith BT601 limited-range matrix. This patch enables the call sites to\nselect the matrix by providing YUV color space and color range. If no\nmatrix is available. e.g., from RGB565 sources, the conversion would be\nrejected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324720\n", "files": ["dom/media/ImageConversion.cpp", "dom/media/ImageConversion.h"], "git_node": "54357db409ee35ae600919725aece69d8b360549", "git_parents": ["1c95283f88aa57fa33805ec8407539eb345739b4"], "node": "0ea3020fc5e1d7c483824f7283e3e56019155643", "parents": ["f14fec9a0b023e16a10559f5364afbb4b2f7f104"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2068790 - Test RGB-to-YUV conversion under each matrix and range r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324721\n", "files": ["dom/media/gtest/TestImageConversion.cpp"], "git_node": "1852f1c07cfb3fa629fad9a25fbfe3f67da71412", "git_parents": ["54357db409ee35ae600919725aece69d8b360549"], "node": "2845d8c968c7b6db5907a6a28a65ea3405add525", "parents": ["0ea3020fc5e1d7c483824f7283e3e56019155643"], "tags": []}, {"author": "Debadree Chatterjee \u003cdebadree333@gmail.com\u003e", "branch": "default", "desc": "Bug 2042996 - Add tests for disposal vs iterator.return() errors during generator close. r=arai\n\nThis a follow up to Bug 2063576 adding tests for 2042996 since the previous bug already solved this issue internally itself\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315810\n", "files": ["js/src/jit-test/tests/explicit-resource-management/for-of-using-generator-close-dispose-and-return-throw.js"], "git_node": "70704187993f09ac78437badc2a3f2e4f23d55e9", "git_parents": ["1852f1c07cfb3fa629fad9a25fbfe3f67da71412"], "node": "e20c1b50b8e1fc02f05fe6f384de5f2c12166430", "parents": ["2845d8c968c7b6db5907a6a28a65ea3405add525"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072428 - Prevent dropdowns from being filled for combobox in Smart Form Fill. r=omarg\n\nSkip custom combobox filter inputs, which Smart Form Fill fills with values the widget never accepts.\n\nclosest: react-select puts the role on the input, Downshift on a wrapping div \u2014 an attribute check misses 29 of 128 combobox fields in our test dataset.\ncombobox: the only signal a custom dropdown emits; a conformant select-only combobox is a button or div and never reaches #isSupportedField.\nname: form submission skips nameless controls, so filling one changes nothing \u2014 and it spares the 68 named fields like email and address1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326334\n", "files": ["browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_initialization.js", "browser/components/aiwindow/ui/test/browser/test_smartformfill_supported_fields.html"], "git_node": "fcce0d0ec7f324fc772407c72ed328775bcb1972", "git_parents": ["70704187993f09ac78437badc2a3f2e4f23d55e9"], "node": "2b8ea36b51e43635bb9c70def58ecd5991688347", "parents": ["e20c1b50b8e1fc02f05fe6f384de5f2c12166430"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070963 - Stop deriving the notification bar's top border from the toolbar separator color. r=mstriemer,desktop-theme-reviewers,fchasen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325586\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/content/widgets/infobar.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json"], "git_node": "3398aa9cdf938ac59aed68dd655aaf1c02fe4bf5", "git_parents": ["fcce0d0ec7f324fc772407c72ed328775bcb1972"], "node": "60d46ed02cbcefb79d657e40ddd1a84fba30f87f", "parents": ["2b8ea36b51e43635bb9c70def58ecd5991688347"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063642 - Record the actually granted getUserMedia source r=webrtc-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318874\n", "files": ["dom/media/MediaManager.cpp", "dom/media/webrtc/metrics.yaml", "dom/media/webrtc/tests/mochitests/mochitest_getusermedia.toml", "dom/media/webrtc/tests/mochitests/test_getUserMedia_sourceGrantedGlean.html", "dom/media/webrtc/tests/mochitests/test_getUserMedia_sourceGrantedGlean_displayCapture.html"], "git_node": "9ee36181bbc2206b0d3b1a6f1a73c85b8896950f", "git_parents": ["3398aa9cdf938ac59aed68dd655aaf1c02fe4bf5"], "node": "799518a934d17bf6e68ed9d5793a8a2fbaac3ed9", "parents": ["60d46ed02cbcefb79d657e40ddd1a84fba30f87f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071756 - Select a panel-list item by the first letter of its label. r=tgiles,omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325831\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_panel_item_first_letter.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "316982b0512f0629379b8b39272bbf4af8a2abe8", "git_parents": ["9ee36181bbc2206b0d3b1a6f1a73c85b8896950f"], "node": "96db5d22b67e6cb9a7bf8a5fab430690e19ee5ee", "parents": ["799518a934d17bf6e68ed9d5793a8a2fbaac3ed9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071753 - Drop the container menu items' accesskeys. r=daisuke,fluent-reviewers,tabbrowser-reviewers,places-reviewers,urlbar-reviewers,kcochrane,bolsson\n\n`useAccessKeys` has nothing left to suppress, so the new tab button's container menu now takes its labels from Fluent like the others.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325832\n", "files": ["browser/base/content/browser.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/utilityOverlay.js", "browser/components/contextualidentity/test/browser/browser_telemetry.js", "browser/components/contextualidentity/test/browser/browser_urlbarContainerMenu.js", "browser/components/places/tests/browser/browser_library_container_menu.js", "browser/components/tabbrowser/content/browser-allTabsMenu.inc.xhtml", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "python/l10n/fluent_migrations/bug_2071753_container_menu_accesskeys.py", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/locales/en-US/toolkit/global/contextual-identity.ftl"], "git_node": "81eb0f3295a0e19df5bea370991673d38b6aee28", "git_parents": ["316982b0512f0629379b8b39272bbf4af8a2abe8"], "node": "033ca1a2715d38a021d185604dd310fdb7ef8579", "parents": ["96db5d22b67e6cb9a7bf8a5fab430690e19ee5ee"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072328 - Mark backdrop-filter-bad-mask-image.html as a known intermittent on tsan r=gfx-reviewers,lsalzman\n\nThe test page renders correctly; it is the about:blank reference that is\ncaptured as an all-zero buffer. The harness screenshots the reference first,\nand this test sorts first in its group, so that capture is the first readback\nof a freshly started browser, where RecvGetSnapshot can return IPC_OK without\nwriting the texture. Annotate for now and fix the snapshot race separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326321\n", "files": ["testing/web-platform/meta/css/css-masking/mask-image/backdrop-filter-bad-mask-image.html.ini"], "git_node": "911fbc12e9070db5f10a73b8f1f8dce28f100b41", "git_parents": ["81eb0f3295a0e19df5bea370991673d38b6aee28"], "node": "a25a7a98f2b3ad6d9b0b6543b68c1df76c6f2119", "parents": ["033ca1a2715d38a021d185604dd310fdb7ef8579"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067865 - Create resume card component r=pdahiya,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324798\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-resume-card/smartwindow-resume-card.css", "browser/components/aiwindow/ui/components/smartwindow-resume-card/smartwindow-resume-card.mjs", "browser/components/aiwindow/ui/components/smartwindow-resume-card/smartwindow-resume-card.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_resume_card.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "2468081b0ada7266882d4f19031c60efc5bc2091", "git_parents": ["911fbc12e9070db5f10a73b8f1f8dce28f100b41"], "node": "6d71c09a6cf123187318787a1736f79d04a7ea18", "parents": ["a25a7a98f2b3ad6d9b0b6543b68c1df76c6f2119"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067866 - PUWYLO: New Tab section and layout r=pdahiya,fluent-reviewers,bolsson\n\n- Adds the \u201cJump back in\u201d section with a two-column card grid and Show more/less behavior\n- populates up to four cards from the existing memory-backed resume activities behind the pref: `browser.smartwindow.resumeCards.enabled`, until Journey Store integration is ready\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325202\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-resume-section/smartwindow-resume-section.css", "browser/components/aiwindow/ui/components/smartwindow-resume-section/smartwindow-resume-section.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_resume_section.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "8b1d05204a94ce9630f84bd46b70fd17906dcf34", "git_parents": ["2468081b0ada7266882d4f19031c60efc5bc2091"], "node": "25c8e04be8f029327d65a8f0098c84381b4141d7", "parents": ["6d71c09a6cf123187318787a1736f79d04a7ea18"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068790 - Test RGB-to-YUV conversion under each matrix and range r=media-playback-reviewers,alwu\" for causing build bustages in TestImageConversion.cpp.\n\nThis reverts commit 1852f1c07cfb3fa629fad9a25fbfe3f67da71412.\n\nThis reverts commit 54357db409ee35ae600919725aece69d8b360549.\n", "files": ["dom/media/ImageConversion.cpp", "dom/media/ImageConversion.h", "dom/media/gtest/TestImageConversion.cpp"], "git_node": "434c11a92c06664a06ef4779229aed6232c8166a", "git_parents": ["8b1d05204a94ce9630f84bd46b70fd17906dcf34"], "node": "73174bfafd2ecb8f5b51fec3ec4e87bfb85fbed6", "parents": ["25c8e04be8f029327d65a8f0098c84381b4141d7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2047721 - Clear VP9 frame-thread state on flush r=media-playback-reviewers,padenot\n\nCherry-pick of FFmpeg commit a024f8c5413d (avcodec/vp9: unref next_refs in\nvp9_decode_flush). vp9_decode_flush() releases s-\u003es.refs[] but not\ns-\u003enext_refs[], and vp9_decode_update_thread_context() seeds a worker's\nrefs[] from the source worker's next_refs[], so references from before a\nflush could survive it. Unref next_refs[] alongside refs[].\n\nThe commit is not in the FFmpeg 9.0 release branch, so it is carried as\nvp9-flush-unref-next-refs.patch and listed in README_MOZILLA to be\nre-applied on the next ffvpx update.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310961\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/vp9.c", "media/ffvpx/vp9-flush-unref-next-refs.patch"], "git_node": "f56ed02288bef1667f768d9ecfe98d0d2517543c", "git_parents": ["434c11a92c06664a06ef4779229aed6232c8166a"], "node": "ace91b8723d2cf52a5d35225c65e0321a6390839", 