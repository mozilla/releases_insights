urity/nss/lib/nss/nss.rc", "security/nss/lib/pk11wrap/exports.gyp", "security/nss/lib/pk11wrap/manifest.mn", "security/nss/lib/pk11wrap/pk11cert.c", "security/nss/lib/pk11wrap/pk11hpke.c", "security/nss/lib/pk11wrap/pk11hpke.h", "security/nss/lib/pk11wrap/pk11hpkei.h", "security/nss/lib/pk11wrap/pk11pars.c", "security/nss/lib/pk11wrap/pk11pub.h", "security/nss/lib/pk11wrap/pk11skey.c", "security/nss/lib/pk11wrap/pk11slot.c", "security/nss/lib/pk11wrap/pk11util.c", "security/nss/lib/pk11wrap/secmodi.h", "security/nss/lib/pkcs12/p12.h", "security/nss/lib/pkcs12/p12d.c", "security/nss/lib/pkcs7/p7decode.c", "security/nss/lib/pkcs7/secpkcs7.h", "security/nss/lib/pki/asymmkey.c", "security/nss/lib/pki/certificate.c", "security/nss/lib/pki/cryptocontext.c", "security/nss/lib/pki/doc/standoc.html", "security/nss/lib/pki/manifest.mn", "security/nss/lib/pki/nsspki.h", "security/nss/lib/pki/nsspkit.h", "security/nss/lib/pki/pki.gyp", "security/nss/lib/pki/pki.h", "security/nss/lib/pki/pki3hack.c", "security/nss/lib/pki/pkibase.c", "security/nss/lib/pki/pkim.h", "security/nss/lib/pki/pkit.h", "security/nss/lib/pki/pkitm.h", "security/nss/lib/pki/symmkey.c", "security/nss/lib/pki/trustdomain.c", "security/nss/lib/smime/cms.h", "security/nss/lib/smime/cmsdecode.c", "security/nss/lib/smime/smime.def", "security/nss/lib/smime/smime.rc", "security/nss/lib/softoken/jpakesftk.c", "security/nss/lib/softoken/legacydb/nssdbm.rc", "security/nss/lib/softoken/pkcs11.c", "security/nss/lib/softoken/pkcs11i.h", "security/nss/lib/softoken/pkcs11u.c", "security/nss/lib/softoken/sftkdb.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/softoken/softokn.rc", "security/nss/lib/ssl/ssl.rc", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/ssl/sslmutex.c", "security/nss/lib/ssl/sslmutex.h", "security/nss/lib/ssl/sslnonce.c", "security/nss/lib/ssl/sslsnce.c", "security/nss/lib/ssl/sslsock.c", "security/nss/lib/ssl/sslspec.c", "security/nss/lib/ssl/sslspec.h", "security/nss/lib/ssl/tls13con.c", "security/nss/lib/ssl/tls13ech.c", "security/nss/lib/ssl/tls13replay.c", "security/nss/lib/util/nssutil.def", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/nssutil.rc", "security/nss/lib/util/quickder.c", "security/nss/lib/util/secasn1.h", "security/nss/lib/util/secasn1d.c", "security/nss/lib/util/secasn1t.h", "security/nss/lib/util/secport.h", "security/nss/moz.yaml", "security/nss/taskcluster/kinds/build/linux.yml", "security/nss/taskcluster/kinds/certs/kind.yml", "security/nss/taskcluster/kinds/fuzz/kind.yml", "security/nss/taskcluster/kinds/test/cipher.yml", "security/nss/taskcluster/kinds/test/gtest.yml", "security/nss/taskcluster/kinds/test/kind.yml", "security/nss/taskcluster/nss_taskgraph/target_tasks.py", "security/nss/taskcluster/nss_taskgraph/transforms/build.py", "security/nss/tests/common/init.sh", "security/nss/tests/common/tsan_suppressions.txt", "security/nss/tests/ssl/sslstress.txt"], "git_node": "2ab4904e80bc7b917cb5682cee0929d09f396e98", "git_parents": ["f9b066a166766cd416640999dfd73d9846671872"], "node": "8c8aa5a1f539ab9cca9991ce27ee03d1f490b45c", "parents": ["377903ca3469567d0611b192a4486469befb2c82"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073991 - Stop logging FileBlockCache::mFD without mFileMutex. r=media-playback-reviewers,chunmin\n\nclang's -Wthread-safety-pointer warning warns when passing or returning\npointers to guarded data. It was added in clang 21 and will be enabled\nby default under -Wthread-safety in a future clang release.\n\n-Wthread-safety-pointer reports:\n\ndom/media/FileBlockCache.cpp: warning: passing pointer 'mFD' requires holding mutex 'mFileMutex' [-Wthread-safety-pointer]\n  |   LOG(\"Run() mFD={} mBackgroundET={}\", fmt::ptr(mFD),\n  |                                                 ^\n\nmFD is protected by mFileMutex, but PerformBlockIOs() logged it while\nholding only mDataMutex. The lock order requirements of these two\nmutexes forbid taking mFileMutex while mDataMutex is held, so the fix\ncannot simply add a lock around the LOG call.\n\nInstead, read mFD under mFileMutex before taking mDataMutex, and save\nthe formatted pointer for the later LOG call. This work happens only\nwhen the log is enabled at LogLevel::Debug.\n\nAlso rename the stale log label \"Run()\" to the function's current name,\nPerformBlockIOs().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327740\n", "files": ["dom/media/FileBlockCache.cpp"], "git_node": "51213fb610ce472b32bf6358377958163a5379a1", "git_parents": ["2ab4904e80bc7b917cb5682cee0929d09f396e98"], "node": "49e90c9e206c7713040cf196d8fb12caf83eab97", "parents": ["8c8aa5a1f539ab9cca9991ce27ee03d1f490b45c"], "tags": []}, {"author": "Dan Schomburg \u003cdschomburg@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074307 - Default identity.fxaccounts.pairing.version to 2  r=markh\n\nWe are preparing for the FxA pairing improvements rollout, also known as v2 pairing. To do so, we need to set the default pref for identity.fxaccounts.pairing.version to 2. With this set, FxA will be able to controll the rollout of the pairing flows through their server configurations. At the time of writing, pairing v2 has not yet been enabled in FxA sever configurations. We are targeting the end of the month to start rolling the v2 improvements so Android users can take advantage of the improvments. iOS users will follow a few weeks later.\n\nFor pairing v2 to be turned on, both FxA's configuration and Firefox pairing v2 pref must be turned on. This commit enables pairing v2 by default on the Firefox side only! QA has validated that this is safe to do. Even with this pref set to 2, pairing v1 flows continue to work as intended. This valided last week against train v1.345.1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328013\n", "files": ["browser/app/profile/firefox.js", "services/fxaccounts/FxAccountsWebChannel.sys.mjs"], "git_node": "906a45bc27784742fede9457c2111c8e4c2519b3", "git_parents": ["51213fb610ce472b32bf6358377958163a5379a1"], "node": "e3da219e6d677b97f9b9d7065693d6e91191dd78", "parents": ["49e90c9e206c7713040cf196d8fb12caf83eab97"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068272 - Resolve a path in the wallpaper protocol handler. r=necko-reviewers,ini,valentin\n\nThe handler could only load files directly from the wallpaper folder, so New Tab had to copy the active image out of wallpaper/library first. It can now load files inside the library and rejects unsafe paths containing empty parts, dot segments, separators or null characters. Existing wallpaper URLs still work, so older New Tab versions are unaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326757\n", "files": ["netwerk/protocol/res/MozNewTabWallpaperProtocolHandler.cpp", "netwerk/test/browser/browser.toml", "netwerk/test/browser/browser_wallpaper_protocol_library.js", "netwerk/test/unit/test_wallpaper_protocol.js"], "git_node": "c278c474255dca4cfead850689a6f79fb35fd56a", "git_parents": ["906a45bc27784742fede9457c2111c8e4c2519b3"], "node": "292f0188617e692dad9e1f712b8497ccaaf4d71b", "parents": ["e3da219e6d677b97f9b9d7065693d6e91191dd78"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058972 - Don't panic when a mix-blend picture can't be mapped into its parent surface. r=gfx-reviewers,lsalzman\" for causin wrench tests failures\n\nThis reverts commit d2ba9fe75c45836790558f269644b604ed210fbb.\n", "files": ["gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/wrench/reftests/crash/mix-blend-unmappable-transform.yaml", "gfx/wr/wrench/reftests/crash/reftest.list"], "git_node": "5e698b4bc0368870db2acc0903a37e7a1bc25168", "git_parents": ["c278c474255dca4cfead850689a6f79fb35fd56a"], "node": "4d5793ee82720f577582bf373452dacabccd79da", "parents": ["292f0188617e692dad9e1f712b8497ccaaf4d71b"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067007 - Measure grid item's block-size contribution intrinsic sizing. r=layout-reviewers,dholbert\" for causing failures on test_modal_prompts.\n\nThis reverts commit 881379c413def6b279e1884804cf32fcca6b64a4.\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/track-sizing/column-subgrid-with-row-standalone-axis-size-002.html.ini", "testing/web-platform/meta/css/css-grid/subgrid/standalone-axis-size-011.html.ini", "testing/web-platform/tests/css/css-grid/grid-items/percentage-block-size-transfer-through-item-001.html"], "git_node": "4f6dfc66ab10cfab3cc835fe033afba98fa70c03", "git_parents": ["5e698b4bc0368870db2acc0903a37e7a1bc25168"], "node": "42b8cc24124613f567952544b81eb8a073c028c4", "parents": ["4d5793ee82720f577582bf373452dacabccd79da"], "tags": []}, {"author": "Abel Kalu \u003c59095867+BlessedOneKobo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1918041 - Add missing pressed appearance to new tab button for vertical tabs. r=desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325599\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "9b595d974dd5a4073db1555d948e5c04cb0de082", "git_parents": ["4f6dfc66ab10cfab3cc835fe033afba98fa70c03"], "node": "2de8b40c5c52a6693344f35739146547a9971cfa", "parents": ["42b8cc24124613f567952544b81eb8a073c028c4"], "tags": []}, {"author": "Vanessa Prema \u003cvprema@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074592 - fix(pbw): Relay promo and basics spotlight fixes from QA r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328231\n", "files": ["browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "toolkit/modules/BrowserUtils.sys.mjs"], "git_node": "853e8033cafe52ac8a16c5e6828e66e184d3c9d7", "git_parents": ["9b595d974dd5a4073db1555d948e5c04cb0de082"], "node": "d9486f1c33172cc3b8e8a3f70dbdf690b18b9ef0", "parents": ["2de8b40c5c52a6693344f35739146547a9971cfa"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068341: Ensure container timing records are always dropped when their root element might go away. r=smaug\n\nThis avoids moving to strong references which comes with a lot of lifetime concerns while making sure that we always clear out records when their root might go away.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328162\n", "files": ["dom/base/crashtests/2068341.html", "dom/base/crashtests/crashtests.list", "dom/html/nsGenericHTMLElement.cpp"], "git_node": "e893294272b202f3a88ee498c2b3e11271dec6e5", "git_parents": ["853e8033cafe52ac8a16c5e6828e66e184d3c9d7"], "node": "7f9db9cdf01109ad625643ac1a5f16d55a4be5d8", "parents": ["d9486f1c33172cc3b8e8a3f70dbdf690b18b9ef0"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2068714 - Put the chat tab in the tab group the assistant makes r=tabbrowser-reviewers,omarg,nsharpley,gazhibekova\n\nWhen the assistant groups tabs, the chat tab it was asked from was left out of the group. This patch adds it.\n\nThe chat tab never reaches the tool, because its chrome: URL is filtered out before the model sees the tab list. It is found instead by matching the conversation id with getChatTabConversationId, which only answers for tabs showing the chat page. That keeps sidebar chats out, since a sidebar conversation's id is stored against the web page tab beside it.\n\ntabs_affected counts the tabs in the created group. A tab that is closed between the card and the confirm is dropped before grouping and never reaches failedTabs, so counting the selection instead would report it as grouped.\n\nA group can now hold every tab in the window, and deleting such a group used to close the window too. removeTabGroup now asks for the window to be kept. This needed two changes, because removeTabs and removeTab each decide on their own whether to close it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326405\n", "files": ["browser/components/aiwindow/models/ManageTabs.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_ManageTabs.js", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_tool.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolUI.js", "browser/components/sessionstore/test/browser_tab_groups_save_on_window_close.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js"], "git_node": "bcc068c1ea8a217b378f01b20afd99f912c43c93", "git_parents": ["e893294272b202f3a88ee498c2b3e11271dec6e5"], "node": "d7de60ddf26d88520f800b95af92fd8fa9fd1bb3", "parents": ["7f9db9cdf01109ad625643ac1a5f16d55a4be5d8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073962 - Remove the unused pending-deletion binding from the history view. r=android-reviewers,mcarare\n\nNothing has constructed PendingDeletionBinding since bug 1991697, so HistoryView.update(AppState) and its\nnotifyDataSetChanged never run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327727\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/state/bindings/PendingDeletionBinding.kt"], "git_node": "281872e7df7b7d31f0090788d747d44e5d124874", "git_parents": ["bcc068c1ea8a217b378f01b20afd99f912c43c93"], "node": "2f4d0547f3592dcc5ee6df96641f847831fef838", "parents": ["d7de60ddf26d88520f800b95af92fd8fa9fd1bb3"], "tags": []}], "date": 1790137288, "git_changesets": ["c89a5e061f6ea7bdb593cec1e373e8ab9ba7c6b0", "32f6b0db1b6831fcd9de985fd506dac113b1d2a1", "a80e754e53b30836212c0695060e352541c1df8d", "e73bfb2d636af44d47f45792634e0d861cf830ed", "7462548d5e7e225a24a637df76dbaf54e7a5360f", "24046b3744918ede4d25acd2fbbb06f6e75f50a9", "678e0a4d29ee8c6c7281555560a054611da35c33", "2db31763c6d102f5cdd519b50763831aaa3fc4eb", "82dddc0f382b02c996bd54e252fd281a3e3c51e8", "02d8a80d105ec621a7baf022372cd5d0879eac98", "5d3e68c56fe09ef7ca87d67a03cd2aa807a0fc34", "311f7221347e18d86ae38820f25ac27a2cbd08bc", "c131eba0efc60446310a4a4f49814c3ea2fbfc62", "8952794ea014ed502f8161105e4b3c75f784e5c4", "9ad821d952727ee005db5967714f50bf5be7b2b7", "1b34be62e38bb437f8679edba64aaa7f7e4e0d9d", "e364f93541d8c4a230aee8e5f2575d87967e55be", "06b2facda935801167a47b65807bb3ad7721b837", "60d6f25e0882df909dfae5cf689853dd070380bb", "b60f46722863c1a65b365ff700af5bdeb5747c87", "fb2c7d57dc57d21338b5a65af47e61ebfdccde78", "4f93cc8628bb730e4702283a0f8bf01a7473b232", "c059228ee48525dfec90fa9a3df704c54b097c29", "4124a39720772b266e51bbe25fe143b957d6a5d8", "fd0114b068149cdb9d57ae9d076102270035e19f", "b18691d1070e5750a6a6f44c44e1d3a8ae9f07ab", "1a6ada7dcaafe54bfb8d32fed04bbcbd3751d52b", "ed634e3eb11b53fff30f31557c631cd6bdc82694", "0a59771f32b17b47e29aeb91fc4010c25516a274", "7a1f047076bfcfa11afec49172869879c325ff0e", "950d11a50733201db4275b7751ebedb465b29201", "2c62c261d455c33347386b0c98c4973811927acb", "1d18d40da7e2486c2512ae4ef5fbeaccf6676e86", "25ed56f8cb56ab7fda4d1016a780562f8868ee76", "7f3c15fc8b8e9f4440c8b40b1553d81e72f4c5fd", "5813645774cebb259eae20a9c1b490e055246d4e", "00c8cc7be1d80238a8f041536e48e1f0f539fd0d", "e4d7feb4c0ccfefd5c2056be0e8e23485ee22c6f", "f4a8ebb1bb323516b0c7b09a7feed733290