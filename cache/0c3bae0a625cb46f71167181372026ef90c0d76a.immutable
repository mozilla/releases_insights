lbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js"], "git_node": "3bf73f3be6da08a9c176b492a820dbf836cfff60", "git_parents": ["1a3600c62abafe0ddec7df8956d947fa12a263e7"], "node": "27ed3f306e0c9f2afd99c9bd69a384e6103cff76", "parents": ["7e0aa5f6a385805b21ebf80f59627147c7a5115a"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069507 - Record trust panel opening reason r=urlbar-reviewers,timhuang,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324259\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js"], "git_node": "459f927c1bec2f71de87ba29ab07d32cb4d1010d", "git_parents": ["3bf73f3be6da08a9c176b492a820dbf836cfff60"], "node": "3ebd3757d755eec048eba1a05bb175cb3d63ef6d", "parents": ["27ed3f306e0c9f2afd99c9bd69a384e6103cff76"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069507, Bug 2069506, Bug 2069505, Bug 2066765, Bug 2066764, Bug 2066763 - Record trust panel opening reason r=urlbar-reviewers,timhuang,daleharvey\" for causing build bustages\n\nThis reverts commit 459f927c1bec2f71de87ba29ab07d32cb4d1010d.\n\nRevert \"Bug 2069506 - Add a Trust Panel close event to measure dwell time and abandonment r=urlbar-reviewers,timhuang,daleharvey\"\n\nThis reverts commit 3bf73f3be6da08a9c176b492a820dbf836cfff60.\n\nRevert \"Bug 2069505 - Add telemetry for the tracker list and per-tracker detail subviews in the Trust Panel r=urlbar-reviewers,timhuang,daleharvey\"\n\nThis reverts commit 1a3600c62abafe0ddec7df8956d947fa12a263e7.\n\nRevert \"Bug 2066765 - Add telemetry for security info subview in the new Trust Panel r=urlbar-reviewers,timhuang,daleharvey\"\n\nThis reverts commit 09054c8ebc02cedaff557b990ac1da8add123763.\n\nRevert \"Bug 2066764 - Add telemetry for Clear Cookies and Site Data option in the new Trust Panel r=urlbar-reviewers,timhuang,daleharvey\"\n\nThis reverts commit b0f37f2a6314011ac7eb5587bca85fb77a9c67b4.\n\nRevert \"Bug 2066763 - Add telemetry for deliberate ETP disablement action in the Trust Panel r=urlbar-reviewers,timhuang,jteow\"\n\nThis reverts commit e6a6e3b89f64bd9c1ca11f2107a43b17169ca46b.\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/metrics.yaml", "browser/components/controlcenter/content/components/breach-alert-panel.mjs", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_cert_exception.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js", "browser/components/urlbar/tests/browser-trustPanel/head.js", "tools/lint/rejected-words.yml"], "git_node": "ce78ddcef8cadeae556ddfa0946a84761bd7d578", "git_parents": ["459f927c1bec2f71de87ba29ab07d32cb4d1010d"], "node": "5ae95579f131623111cd844bfeb42358013b1370", "parents": ["3ebd3757d755eec048eba1a05bb175cb3d63ef6d"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072852 - [ots] Reject CFF fonts where a charstring tries to execute an excessive number of operations. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327310\n", "files": ["gfx/ots/moz.yaml", "gfx/ots/ots-cff-charstring-ops-limit.patch", "gfx/ots/src/cff_charstring.cc", "gfx/ots/src/cff_charstring.h"], "git_node": "95b394820a3542f0812b770249fa9c7ef1235d42", "git_parents": ["ce78ddcef8cadeae556ddfa0946a84761bd7d578"], "node": "c8ca625663b0c57a03ff4b79115e7e5a54bbe1c8", "parents": ["5ae95579f131623111cd844bfeb42358013b1370"], "tags": []}, {"author": "David Miculit \u003cdmiculit@mozilla.com\u003e", "branch": "default", "desc": "Bug 1824766 Parse boolean test settings properly in raptor manifest parsing r=perftest-reviewers,afinder,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327292\n", "files": ["testing/raptor/raptor/manifest.py", "testing/raptor/test/test_manifest.py"], "git_node": "f86d3418d9f6f8ccba3188478c869243d2e4c1c0", "git_parents": ["95b394820a3542f0812b770249fa9c7ef1235d42"], "node": "0974316b056d701ba9f77568fde3a587e276136d", "parents": ["c8ca625663b0c57a03ff4b79115e7e5a54bbe1c8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073663 - Open pickers in PromptDelegateTest with the user gesture and showPicker() in one content turn. r=geckoview-reviewers,ohall\n\nnotifyUserGestureActivation() and the evaluateJS(\"...showPicker()\") that followed it were two separate round\ntrips through the test-support extension. showPicker() requires transient user activation, which expires after\ndom.user_activation.transient.timeout (5 s), so on a slow emulator the second hop could land after the\nactivation had lapsed and the picker was refused with NotAllowedError. The new ShowPicker test-support message\ndoes both in the same turn in the content process, so there is no window for the activation to expire in.\ncolorTest drove its picker through a synthesized tap instead, which is lost on slow builds the same way, so it\nuses the message too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327493\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/TestSupportChild.sys.mjs", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PromptDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java"], "git_node": "9b6dbdf35adf66e56c4e2414bdbec561bf2791dd", "git_parents": ["f86d3418d9f6f8ccba3188478c869243d2e4c1c0"], "node": "8ee5a559e69ec74c164344cae037b9efa0d72f3d", "parents": ["0974316b056d701ba9f77568fde3a587e276136d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1958025 - Wait for the OHTTP fetch in WebExecutorOhttpTest with the harness timeout. r=geckoview-reviewers,ohall\n\nThe test expects the fetch to fail with WebRequestError but polled the result with a 500 ms deadline, so on a\nslow emulator the expected rejection arrived after poll() had already thrown TimeoutException.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327485\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebExecutorOhttpTest.kt"], "git_node": "6a5ffd7c4259d577bed473ebc4f237401cd29fff", "git_parents": ["9b6dbdf35adf66e56c4e2414bdbec561bf2791dd"], "node": "cc3ee96589660f6d0c9f3be9ba7690e0ee807edc", "parents": ["8ee5a559e69ec74c164344cae037b9efa0d72f3d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055366 - Keep the transient user activation alive in the user gesture navigation tests. r=geckoview-reviewers,ohall\n\nGeckoViewNavigation.onLocationChange and LoadURIDelegate report hasUserGesture from the document's transient\nuser activation at the time they run, and that activation expires after dom.user_activation.transient.timeout\n(5 s). When the tapped page takes longer than that to commit its navigation on a slow emulator the flag reads\nfalse. Raising the timeout for these two tests keeps them from depending on load speed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327486\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/NavigationDelegateTest.kt"], "git_node": "9d2f10e6a897d42e0037b1ee6a2aa88f1835b545", "git_parents": ["6a5ffd7c4259d577bed473ebc4f237401cd29fff"], "node": "8b558452243b06c774cf967a8ee9bfc1a0dba759", "parents": ["cc3ee96589660f6d0c9f3be9ba7690e0ee807edc"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069839 - [customizable-menu] Show the refresh menu item in browser screen's menu r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326868\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/RefreshMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/RefreshMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt"], "git_node": "76f530c4ed5cc4916c4b689aef10d9c52073915f", "git_parents": ["9d2f10e6a897d42e0037b1ee6a2aa88f1835b545"], "node": "1d467812d9801af11ac8d03d93c9db82a5543afd", "parents": ["8b558452243b06c774cf967a8ee9bfc1a0dba759"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2006461 - Mark the Styles marker as stack based. r=profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327758\n", "files": ["layout/base/AutoProfilerStyleMarker.h"], "git_node": "9241a228e4984d71c859575363dbca395eecb571", "git_parents": ["76f530c4ed5cc4916c4b689aef10d9c52073915f"], "node": "ff38fa33983136bbe08df76956837be0ab4a3d