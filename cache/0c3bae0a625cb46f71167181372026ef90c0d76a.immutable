desc": "Bug 2071193 - Fix TypeScript compiler information for devtools. r=devtools-reviewers,profiler-reviewers,nchevobbe,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325318\n", "files": ["devtools/client/performance-new/@types/gecko.d.ts", "devtools/client/performance-new/popup/menu-button.sys.mjs", "devtools/client/performance-new/tsconfig.json", "devtools/tsconfig.json"], "git_node": "0d6ef6356739f3f3c2a895ca68ce1b2c05e257c6", "git_parents": ["6f9495524b51a42fe71f2b16449bdfa28ddf4bb5"], "node": "e1db5b733e5d84506dd15e2da9d902d1bd03dd69", "parents": ["98b9b5fa8a47c1cb69dd94fffbaa222990d3610e"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1640971 - Rename the dom.ipc.cpow.timeout pref r=ipc-reviewers,geckoview-reviewers,mccr8,m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323846\n", "files": ["dom/ipc/ContentParent.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateTest.kt", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "88202983945259491d0b4b679958a84db8414865", "git_parents": ["0d6ef6356739f3f3c2a895ca68ce1b2c05e257c6"], "node": "fee3cf29b33ca8a873d7d67cb62607ae85a56ab8", "parents": ["e1db5b733e5d84506dd15e2da9d902d1bd03dd69"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2071629 - Use moz-src for defaultlaunchlogin r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325626\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/defaultlaunchonlogin/moz.build", "browser/components/defaultlaunchonlogin/tests/test_DefaultLaunchOnLogin.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "b8f0db59067e7353240373c7dcf8ba1c94e135fc", "git_parents": ["88202983945259491d0b4b679958a84db8414865"], "node": "dba1db02b449e2590a3b9d4269722312c3156450", "parents": ["fee3cf29b33ca8a873d7d67cb62607ae85a56ab8"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2055336 - [Monitor Agent][FE] Add Monitor cancel view r=yjamora,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325968\n", "files": ["browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "480eb3bab67a976429583e1abb68cb8468fa5f68", "git_parents": ["b8f0db59067e7353240373c7dcf8ba1c94e135fc"], "node": "a16d457ff03904e73bcf92a5f2892c8ee3e6ff23", "parents": ["dba1db02b449e2590a3b9d4269722312c3156450"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1397239 - Split reframe-based state restoration from history based scroll restoration. r=farre,layout-reviewers,dshin\n\nHistorically, ScrollContainerFrame has (ab)used the session history\nmechanism to also restore scroll positions during reframe of the same\nnode. That has a bunch of overhead of computing DOM-node-independent\nstate keys etc that we can avoid.\n\nIt's also leaky (as in, DOM removals aren't guaranteed to be caught by\nthis if something removes the layout tree first, like in this bug), and\nit requires a whole frame subtree walk on navigation and frame\nreconstruction.\n\nInstead, avoid saving / restoring scroll position from history on\nnon-root scroll containers, which needs one test change (of a test which\nI wrote) but matches other browsers, and keep the per-element scroll\nstate in the element slots, restoring in ScrollContainerFrame::Init and\nsaving in ScrollContainerFrame::Destroy.\n\nThere are some follow-up clean ups we could do, like plumbing the scroll\nstate separately from PresState now (in fact nsISHistory already does\nsome of that).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325827\n", "files": ["dom/base/Element.cpp", "dom/base/Element.h", "dom/base/FragmentOrElement.cpp", "dom/base/FragmentOrElement.h", "layout/base/PresShell.cpp", "layout/base/PresState.ipdlh", "layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h", "layout/base/nsFrameManager.cpp", "layout/base/nsFrameManager.h", "layout/base/nsLayoutHistoryState.cpp", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h", "layout/generic/ScrollState.h", "layout/generic/moz.build", "layout/generic/test/file_scroll_position_restore_no_bfcache.html", "layout/generic/test/test_scroll_position_restore_no_bfcache.html"], "git_node": "402561a9847888cf06056e6ab629beb8be820f26", "git_parents": ["480eb3bab67a976429583e1abb68cb8468fa5f68"], "node": "4da94b51a6416d99faecca673c3114e285fa480a", "parents": ["a16d457ff03904e73bcf92a5f2892c8ee3e6ff23"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069803 - Enable on-device Speech Recognition on Nightly. r=media-webspeech-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326192\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "55a34140f46c23da1e972c44de3242fdca50e55f", "git_parents": ["402561a9847888cf06056e6ab629beb8be820f26"], "node": "9a40b740a67c4ff71037a9e4a0e1183851015839", "parents": ["4da94b51a6416d99faecca673c3114e285fa480a"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2069696 - Update quinn-udp to 0.6.2 r=leggert,supply-chain-reviewers\n\nhttps://github.com/quinn-rs/quinn/releases/tag/quinn-udp-0.6.2\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323901\n", "files": ["Cargo.lock", "supply-chain/audits.toml", "third_party/rust/quinn-udp/.cargo-checksum.json", "third_party/rust/quinn-udp/.cargo_vcs_info.json", "third_party/rust/quinn-udp/Cargo.lock", "third_party/rus