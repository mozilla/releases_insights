 "media/ffvpx/libavutil/hwcontext_d3d11va.c", "media/ffvpx/libavutil/hwcontext_vulkan.c", "media/ffvpx/libavutil/hwcontext_vulkan.h", "media/ffvpx/libavutil/internal.h", "media/ffvpx/libavutil/mastering_display_metadata.c", "media/ffvpx/libavutil/moz.build", "media/ffvpx/libavutil/opt.c", "media/ffvpx/libavutil/opt.h", "media/ffvpx/libavutil/parseutils.c", "media/ffvpx/libavutil/pixdesc.c", "media/ffvpx/libavutil/rational.c", "media/ffvpx/libavutil/sha.c", "media/ffvpx/libavutil/sha.h", "media/ffvpx/libavutil/side_data.c", "media/ffvpx/libavutil/stereo3d.c", "media/ffvpx/libavutil/utils.c", "media/ffvpx/libavutil/version.h", "media/ffvpx/libavutil/vulkan.c", "media/ffvpx/libavutil/vulkan.h", "media/ffvpx/libavutil/vulkan_functions.h", "media/ffvpx/libavutil/vulkan_loader.h", "media/ffvpx/libavutil/x86/asm.h", "media/ffvpx/libavutil/x86/crc.h", "media/ffvpx/libavutil/x86/emms.asm", "media/ffvpx/libavutil/x86/moz.build", "media/ffvpx/libavutil/x86/pixelutils.asm", "media/ffvpx/libavutil/x86/pixelutils.h", "media/ffvpx/libavutil/x86/tx_float.asm", "media/ffvpx/libavutil/x86/x86util.asm", "media/ffvpx/mediacodec_force_key_frames.patch", "media/ffvpx/vp9-get-format-rollback.patch"], "git_node": "8c36c719466380222c05c8ef7793b257dbebb4c4", "git_parents": ["dde884656559a735a9c2ae80ad71e8718cff7084"], "node": "4c1819a57a33d5834c7491816b9df124dd50133f", "parents": ["4a07e6b45e30226cd95688c354fb287ad6ccd435"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Load ffmpeg functions from correct library r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324524\n", "files": ["dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp"], "git_node": "a280fd046b8dee391beee72d3a4c78442c07f422", "git_parents": ["8c36c719466380222c05c8ef7793b257dbebb4c4"], "node": "f1b0b4b05f6826188abc544bf7c62adbf2842551", "parents": ["4c1819a57a33d5834c7491816b9df124dd50133f"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Check av_hwframe_map() before use Vulkan direct mapping r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324525\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "28e6ebf2c3de917bd761d7de205d12b834a5f575", "git_parents": ["a280fd046b8dee391beee72d3a4c78442c07f422"], "node": "ac7abb323bd771c343d7f7c239609fe89fab3745", "parents": ["f1b0b4b05f6826188abc544bf7c62adbf2842551"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Add ffvpx symbol export test r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324526\n", "files": ["docs/code-quality/lint/linters/ffvpx-symbols.md", "tools/lint/ffvpx-symbols.yml", "tools/lint/ffvpx-symbols/__init__.py", "tools/lint/test/python.toml", "tools/lint/test/test_ffvpx_symbols.py"], "git_node": "dd5c919e87f583ad501338928cd776a9692c5ecb", "git_parents": ["28e6ebf2c3de917bd761d7de205d12b834a5f575"], "node": "f420b764688f21a91883e3e9036bdadc696d5c51", "parents": ["ac7abb323bd771c343d7f7c239609fe89fab3745"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2064227: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "7884d50d1e7f98a48d359b06a5ff802bc307065e", "git_parents": ["dd5c919e87f583ad501338928cd776a9692c5ecb"], "node": "1fe48327e7572ca291b557f5e4932f43759d69df", "parents": ["f420b764688f21a91883e3e9036bdadc696d5c51"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2072074 - Stop rescanning the whole index for every cache2 index write chunk. r=necko-reviewers,jesup\n\nThe index is written in buffer-sized chunks, and each chunk walked mIndex from\nthe beginning and stepped over the mSkipEntries records the previous chunks had\nalready written, re-testing IsRemoved()/IsInitialized()/IsFileEmpty() on every\none of them. kMaxBufSize is 16KB and a packed CacheIndexRecord is 45 bytes, so a\nchunk holds 364 records and writing N of them costs about N^2/728 iterations. In\nthe second profile on this bug that is 2.9% of the Cache2 I/O thread in\nWriteRecords() plus 1.6% in CacheIndexEntry::IsRemoved().\n\nCollect the entries to write once, when the write starts, and have each chunk\nindex straight into that array. mIndex is not mutated while mState is WRITING --\nAddEntry(), RemoveEntry(), InitEntry() and UpdateEntry() all stage their changes\nin mPendingUpdates -- so both the pointers and the flags that selected them are\nstable for the whole write, and testing the flags once is equivalent to testing\nthem per chunk.\n\nmProcessEntries now comes from that array rather than from\nCacheIndexStats::ActiveEntriesCount(), so the loop and the termination condition\ncan no longer disagree about how many records there are to write.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317302\n", "files": ["netwerk/cache2/CacheIndex.cpp", "netwerk/cache2/CacheIndex.h"], "git_node": "46f0efde8c1a554a02d914ef27a0bb3709e48d34", "git_parents": ["7884d50d1e7f98a48d359b06a5ff802bc307065e"], "node": "a81f1ebc001d140a4d61d15f3bd8dd6733e01f34", "parents": ["1fe48327e7572ca291b557f5e4932f43759d69df"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2045290 - Drop the redundant forced-valid check from cache2 eviction. r=necko-reviewers,jesup\n\nCacheIndex::IsForcedValidEntry() looks up the entry's file handle, builds a\ncontext+entry key string from it and hashes that against\nCacheStorageService::mForcedValidEntries. It had one caller, in\nGetEntryForEviction(), and the removed IsForcedValidEntry itself called\nGetHandle first and returned false when no handle existed, making it a strict\nsubset of the handle check added by bug 2031577 eight lines below. So no entry\nsurvives the forced-valid check and is then evicted, and the whole lookup is\ndead weight on every candidate scanned.\n\nRemove it. The string hashing was 400ms of the Cache2 I/O thread in the profile\non this bug.\n\nCacheStorageService::IsForcedValidEntry() also drops the entry when its timeout\nhas passed, so this loses one opportunistic prune. mForcedValidEntries is still\npruned in full by ForcedValidEntriesPrune() on every ForceEntryValidFor(), by\nCacheEntry's own IsForcedValidEntry() calls, and by Clear().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317303\n", "files": ["netwerk/cache2/CacheIndex.cpp", "netwerk/cache2/CacheIndex.h"], "git_node": "cf5c2ae52d8a74c194e9a9c05263fbc364f2e095", "git_parents": ["46f0efde8c1a554a02d914ef27a0bb3709e48d34"], "node": "bd5b19c1996fa7f6f8bac970049989bdf3aff3c7", "parents": ["a81f1ebc001d140a4d61d15f3bd8dd6733e01f34"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068767 - Remove legacy Telemetry mirrors for various IPC and Linux sandboxing probes. r=ipc-reviewers,sandbox-reviewers,chumphreys,mccr8,bobowen\n\nFor the benefit of future `git log --grep` users, the probes in question are:\n* `CONTENT_PROCESS_LAUNCH_MAINTHREAD_MS`\n* `CONTENT_PROCESS_LAUNCH_TOTAL_MS`\n* `CONTENT_PROCESS_SYNC_LAUNCH_MS`\n* `CONTENT_PROCESS_LAUNCH_IS_SYNC`\n* `CHILD_PROCESS_LAUNCH_MS`\n* `SANDBOX_REJECTED_SYSCALLS`\n* `IPC_TRANSACTION_CANCEL`\n\nAll except the last were added by me; that one is from IPC module owner\nemeritus billm.  I'm reasonably certain that none of these are being\nused via the old Telemetry tables.\n\nAs far as I know there aren't any tests that need to be adapted; such\ntesting wasn't standard procedure when these were added.  (It might be\nnice to add some, but that is outside the scope of this patch.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323067\n", "files": ["dom/metrics.yaml", "ipc/metrics.yaml", "security/sandbox/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "b12f688afdf3abad3fc8239dd16b637f5c82909b", "git_parents": ["cf5c2ae52d8a74c194e9a9c05263fbc364f2e095"], "node": "c5ad89c8321c0e3fb74c307f5132c22880925b92", "parents": ["bd5b19c1996fa7f6f8bac970049989bdf3aff3c7"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016622 - Use the bounding box of all fragments as the scroll snap area. r=layout-reviewers,emilio,TYLin\n\nThe CSSWG resolved [1] that a snap target split into multiple fragments snaps\nas the bounding box of the fragments, instead of each fragment generating its\nown snap position.\n\n[1] https://github.com/w3c/csswg-drafts/issues/13490#issuecomment-3134584437\n\nThis makes the multicol-001.html and multicol-002.html tests in\ncss/css-scroll-snap pass (Bug 2014322).\n\nNote that I intentionally leave this spec resolution part:\n\"but if it is bigger than the viewport, adjust the alignment [TBD] to\nkeep the element in view.\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325723\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollSnap.cpp", "testing/web-platform/meta/css/css-scroll-snap/multicol-001.html.ini", "testing/web-platform/meta/css/css-scroll-snap/multicol-002.html.ini", "testing/web-platform/tests/css/css-scroll-snap/multicol-003.html"], "git_node": "96b3981a66f600dd81c54d1156dd94b34c2f0031", "git_parents": ["b12f688afdf3abad3fc8239dd16b637f5c82909b"], "node": "466b235af1e226a23cd684f2a8228164f9bb7d06", "parents": ["c5ad89c8321c0e3fb74c307f5132c22880925b92"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2028871 - Init should clear variables. r=platform-i18n-reviewers,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322276\n", "files": ["intl/uconv/nsConverterInputStream.cpp"], "git_node": "f6f61b9766a0adb1a14551f80383be73cfe8da99", "git_parents": ["96b3981a66f600dd81c54d1156dd94b34c2f0031"], "node": "07b7f915f4f7738063623a7f7b62a8adc6f11fa5", "parents": ["466b235af1e226a23cd684f2a8228164f9bb7d06"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064227: apply code formatting via Lando\" for causing build bustages @ media/ffvpx/libavcodec/x86/vp8dsp.asm\n\nThis reverts commit 7884d50d1e7f98a48d359b06a5ff802bc307065e.\n\nRevert \"Bug 2064227 Add ffvpx symbol export test r=padenot\"\n\nThis reverts commit dd5c919e87f583ad501338928cd776a9692c5ecb.\n\nRevert \"Bug 2064227 Check av_hwframe_map() before use Vulkan direct mapping r=padenot\"\n\nThis reverts commit 28e6ebf2c3de917bd761d7de205d12b834a5f575.\n\nRevert \"Bug 2064227 Load ffmpeg functions from correct library r=padenot\"\n\nThis reverts commit a280fd046b8dee391beee72d3a4c78442c07f422.\n\nRevert \"Bug 2064227 Update ffvpx to ffmpeg 9.0.1 r=padenot\"\n\nThis reverts commit 8c36c719466380222c05c8ef7793b257dbebb4c4.\n", "files": ["docs/code-quality/lint/linters/ffvpx-symbols.md", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/bsf.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_id.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/frame.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/pixfmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/version.h", "media/ffvpx/README_MOZILLA", "media/ffvpx/config_android_x86_64.asm", "media/ffvpx/config_components_audio_only.h", "media/ffvpx/config_components_audio_video.h", "media/ffvpx/config_darwin64.asm", "med