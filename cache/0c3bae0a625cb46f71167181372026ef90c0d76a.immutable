, "testing/web-platform/tests/fenced-frame/resources/sandboxed-features-inner.sub.html.headers", "testing/web-platform/tests/fenced-frame/resources/sandboxed-features-looser-restriction.sub.html", "testing/web-platform/tests/fenced-frame/resources/sandboxed-features-looser-restriction.sub.html.headers", "testing/web-platform/tests/fenced-frame/resources/sandboxed-features.js", "testing/web-platform/tests/fenced-frame/sandbox-mandatory-flags.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-alert.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-confirm.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-documentdomain.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-pointerlock.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-presentation-request.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-printdialog.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-prompt.https.html", "testing/web-platform/tests/fenced-frame/sandboxed-features-screen-orientation-lock.https.html", "testing/web-platform/tests/fenced-frame/scroll-into-view.https.html", "testing/web-platform/tests/fenced-frame/serviceWorker-dedicated-worker.https.html", "testing/web-platform/tests/fenced-frame/serviceWorker-frameType.https.html", "testing/web-platform/tests/fenced-frame/serviceWorker-push.https.html", "testing/web-platform/tests/fenced-frame/shared-workers.https.html", "testing/web-platform/tests/fenced-frame/show-directory-picker.https.html", "testing/web-platform/tests/fenced-frame/show-open-file-picker.https.html", "testing/web-platform/tests/fenced-frame/storage-partitioning.https.html", "testing/web-platform/tests/fenced-frame/unfenced-top-navigation-default.https.html", "testing/web-platform/tests/fenced-frame/unique-cookie-partition.https.html", "testing/web-platform/tests/fenced-frame/visual-viewport.https.html", "testing/web-platform/tests/fenced-frame/web-bluetooth.https.html", "testing/web-platform/tests/fenced-frame/web-nfc.https.html", "testing/web-platform/tests/fenced-frame/web-share.https.html", "testing/web-platform/tests/fenced-frame/web-usb.https.html", "testing/web-platform/tests/fenced-frame/webrtc-peer-connection.https.html", "testing/web-platform/tests/fenced-frame/window-close.https.html", "testing/web-platform/tests/fenced-frame/window-frameElement.https.html", "testing/web-platform/tests/fenced-frame/window-navigation-204.https.html", "testing/web-platform/tests/fenced-frame/window-outer-dimensions.https.html", "testing/web-platform/tests/fenced-frame/window-parent.https.html", "testing/web-platform/tests/fenced-frame/window-top.https.html"], "git_node": "591bdb38cbc970e9bf83200b50c0b8d9f7efade6", "git_parents": ["688a4ad4c0e4f08a7a35853c9ebd8e8305b514dc"], "node": "79ff6a8ee92a28e2964ae6da0511b1960b6573de", "parents": ["432e43aa67fe1fdc207139a4bb6c4fc347af041c"], "tags": []}, {"author": "Guohui Deng \u003cguohuideng@microsoft.com\u003e", "branch": "default", "desc": "Bug 2071172 [wpt PR 62610] - Enable InitiatorUrl for worker scripts., a=testonly\n\nAutomatic update from web-platform-tests\nEnable InitiatorUrl for worker scripts.\n\nOnly for dedicated workers, because shared workers don't emit\nPerformanceResourceTiming entries.\n\nWhen a dedicated worker is created, DedicatedWorker::Start() obtains the\ninitiator URL from task attribution. The URL is carried through\nGlobalScopeCreationParams to DedicatedWorkerGlobalScope and copied into\nFetchParameters for classic and module top-level script\nloads.WorkerMainScriptLoader then transfers it to ResourceTimingInfo\nbefore publishing the worker script's PerformanceResourceTiming entry.\n\nBug: 40919714\nChange-Id: I6f263d764974267254a912d1a158c452281c7c2e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8274745\nReviewed-by: Nate Chapin \u003cjaphet@chromium.org\u003e\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Guohui Deng \u003cguohuideng@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1695662}\n\n--\n\nwpt-commits: 95e8492e2c1f5bb39300c8560374f502236886b2\nwpt-pr: 62610\n", "files": ["testing/web-platform/tests/lint.ignore", "testing/web-platform/tests/resource-timing/resources/initiator-url-dedicated-worker-start.js", "testing/web-platform/tests/resource-timing/resources/initiator-url-worker.js", "testing/web-platform/tests/resource-timing/tentative/initiator-url/dedicated-worker-script.html"], "git_node": "362c0e11d66874eb8c8f81a789890df29b62f439", "git_parents": ["591bdb38cbc970e9bf83200b50c0b8d9f7efade6"], "node": "9f24463ba0ffe528045aa63ab893f9fd7ef1ac81", "parents": ["79ff6a8ee92a28e2964ae6da0511b1960b6573de"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071172 [wpt PR 62610] - Update wpt metadata, a=testonly\n\nwpt-pr: 62610\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/resource-timing/tentative/initiator-url/dedicated-worker-script.html.ini"], "git_node": "282e6c2e98000ac85bb88d6ad244a0b197c7199a", "git_parents": ["362c0e11d66874eb8c8f81a789890df29b62f439"], "node": "0afdbf86e3194f8fb54b4e7eae2f04fcba9bae37", "parents": ["9f24463ba0ffe528045aa63ab893f9fd7ef1ac81"], "tags": []}, {"author": "Brent Fulgham \u003c44174109+brentfulgham@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071229 [wpt PR 62583] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=268275, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=268275 (#62583)\n--\n\nwpt-commits: 62499105bf7640eb75359b43fa4c19324941f158\nwpt-pr: 62583\n", "files": ["testing/web-platform/tests/css/cssom-view/scrollWidthHeight-not-scrollable-fractional-zoom.html"], "git_node": "ec341ff709e3f2aa936e08bfe718deb680602b82", "git_parents": ["282e6c2e98000ac85bb88d6ad244a0b197c7199a"], "node": "6ea4e0c22a9b44a53b9f07e8fe52945b46532fdd", "parents": ["0afdbf86e3194f8fb54b4e7eae2f04fcba9bae37"], "tags": []}, {"author": "Fran\u00e7ois Beaufort \u003cbeaufort.francois@gmail.com\u003e", "branch": "default", "desc": "Bug 2064908 [wpt PR 62069] - [WebMCP] Accept optional any inputObject in executeTool(), a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Accept optional any inputObject in executeTool()\n\nThis CL updates ModelContext.executeTool() to accept an optional `any\ninputObject` parameter instead of `DOMString inputArguments`,\naligning with the latest WebMCP specification changes.\n\nThe input object is validated and serialized to a JSON string in Blink\nbefore being passed over Mojo IPC to the target tool execution context.\nAny serialization errors (e.g. circular structures, non-serializable\ntypes, or toJSON returning undefined) reject the returned promise with a\nTypeError.\n\nSpec PRs:\nhttps://github.com/webmachinelearning/webmcp/pull/246\nhttps://github.com/webmachinelearning/webmcp/pull/251\n\nBug: 489045948\nChange-Id: I95cc00e20a84134cf5f289e689441587200555f0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8250826\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1695589}\n\n--\n\nwpt-commits: 1a21db90adf8a264370ad806ed761f39e1d435a0\nwpt-pr: 62069\n", "files": ["testing/web-platform/tests/webmcp/declarative/executeTool-abort.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-respondWith-circular-object.https.html", "testing/web-platform/tests/webmcp/declarative/execute_tool_change_event.https.html", "testing/web-platform/tests/webmcp/declarative/execute_tool_submit_from_js.https.html", "testing/web-platform/tests/webmcp/declarative/form_removal_submit_crash.https.html", "testing/web-platform/tests/webmcp/declarative/opaque-origin-tools.https.html", "testing/web-platform/tests/webmcp/declarative/select-multiple-events.https.html", "testing/web-platform/tests/webmcp/declarative/unregister-during-executeTool.https.html", "testing/web-platform/tests/webmcp/imperative/cancel-reentrancy-crash.https.html", "testing/web-platform/tests/webmcp/imperative/detached-frame-executeTool.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-abort.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-across-trees.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-error-window-onerror.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-invalid-dictionary.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-signal-cross-origin.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-target-detachment.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-target-navigation.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-unauthorized-origin.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-unregister-resolution-race.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-cross-origin-child.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-defaults-same-origin.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-invalid-origins.https.html", "testing/web-platform/tests/webmcp/imperative/object-arguments.https.html", "testing/web-platform/tests/webmcp/imperative/opaque-origin-tools.https.html", "testing/web-platform/tests/webmcp/imperative/register_tool_invalid_json_schema.https.html", "testing/web-platform/tests/webmcp/imperative/resources/document-domain-enabled-iframe.html", "testing/web-platform/tests/webmcp/imperative/resources/iframe-caller-and-target-crash.html", "testing/web-platform/tests/webmcp/imperative/resources/iframe-caller.html", "testing/web-platform/tests/webmcp/imperative/resources/iframe-register-tool.html", "testing/web-platform/tests/webmcp/imperative/unregister-during-executeTool.https.html"], "git_node": "c73b9bce58c1047837c1a6180f39522a7aae9bca", "git_parents": ["ec341ff709e3f2aa936e08bfe718deb680602b82"], "node": "264798afdd6a04d534d0a21b4585f6ecedbc55d3", "parents": ["6ea4e0c22a9b44a53b9f07e8fe52945b46532fdd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064908 [wpt PR 62069] - Update wpt metadata, a=testonly\n\nwpt-pr: 62069\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/executeTool-invalid-dictionary.https.html.ini", "testing/web-platform/meta/webmcp/imperative/register_tool_invalid_json_schema.https.html.ini"], "git_node": "d3e78592f77d9a4dee45b0dfd3a120414da23ae6", "git_parents": ["c73b9bce58c1047837c1a6180f39522a7aae9bca"], "node": "6be9a671178d8954edfdddf3e1f557e2f1a993ea", "parents": ["264798afdd6a04d534d0a21b4585f6ecedbc55d3"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2071244 [wpt PR 62544] - [css] Treat valueluess dynamic-range values as truthy, a=testonly\n\nAutomatic update from web-platform-tests\n[css] Treat valueluess dynamic-range values as truthy\n\nThe css/mediaqueries/dynamic-range WPT is actually incorrect in that it\ntreats empty dynamic-range values as falsy. This change updates the test\nand the Chromium implementation to support this.\n\nBug: 40775390\nChange-Id: Icc2948c927a9ecaa197832cbadcbffa40e4223c5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8340151\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1694671}\n\n--\n\nwpt-commits: 397b98b21a02a943f35616b7617ea22b0996ee81\nwpt-pr: 62544\n", "files": ["testing/web-platform/tests/css/mediaqueries/dynamic-range.html"], "git_node": "6f13276a8ee5507a99ac70f5f5cef79c6ae980a6", "git_parents": ["d3e78592f77d9a4dee45b0dfd3a120414da23ae6"], "node": "fd61aaa8d1cf636d22c56ae321db0e7c24fcbe3b", "parents": ["6be9a671178d8954edfdddf3e1f557e2f1a993ea"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071244 [wpt PR 62544] - Update wpt metadata, a=testonly\n\nwpt-pr: 62544\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/mediaqueries/dynamic-range.html.ini"], "git_node": "c674d624430a8b2ab9f54e77a1a17c3f3e9e350d", "git_parents": ["6f13276a8ee5507a99ac70f5f5cef79c6ae980a6"], "node": "b1aecb72e945021cb45a37e2c31d58e6e59c8690", "parents": ["fd61aaa8d1cf636d22c56ae321db0e7c24fcbe3b"], "tags": []}, {"author": "Isaac Ahouma \u003ciahouma@google.com\u003e", "branch": "default", "desc": "Bug 2071168 [wpt PR 62608] - [Gemma4 WPTs] Restrict decimal regex constraint in WPT to valid range, a=testonly\n\nAutomatic update from web-platform-tests\n[Gemma4 WPTs] Restrict decimal regex constraint in WPT to valid range\n\nThe prompt asks for a rating between -1.0 and 1.0, but the previous\nregex constraint allowed numbers outside this range (e.g. 1.5, 3.8).\nBecause constrained decoding allows any tokens matching the regex, the\nmodel occasionally produced valid floats outside [-1.0, 1.0], causing\nthe subsequent numerical assertions to fail.\n\nUpdate the regex to strictly match the requested [-1.0, 1.0] range.\n\nBug: 547951465\nChange-Id: I88f40973332c7edb1ca63e76f406c453500f4a68\nFixed: 547951465\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8390437\nAuto-Submit: Isaac Ahouma \u003ciahouma@google.com\u003e\nReviewed-by: Mike Wasserman \u003cmsw@chromium.org\u003e\nCommit-Queue: Mike Wasserman \u003cmsw@chromium.org\u003e\nCommit-Queue: Isaac Ahouma \u003ciahouma@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1695610}\n\n--\n\nwpt-commits: ef64530f9ad4e61e20b996ecc092ca9d321d7d87\nwpt-pr: 62608\n", "files": ["testing/web-platform/tests/ai/language-model/response-constraint/regex/decimal.tentative.https.window.js"], "git_node": "d2fb6314b29009499750cb3133b1add6f8c83314", "git_parents": ["c674d624430a8b2ab9f54e77a1a17c3f3e9e350d"], "node": "e67139bc506888347eb2e24bde6c2152c9891dbe", "parents": ["b1aecb72e945021cb45a37e2c31d58e6e59c8690"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2071246 [wpt PR 62511] - Account for scroll snapping in anchor adjustments, a=testonly\n\nAutomatic update from web-platform-tests\nAccount for scroll snapping in anchor adjustments\n\nSubtract the transform node snap amount from anchor-position scroll\nadjustments and stabilize the affected reftests.\n\nBug: 325613705\nChange-Id: I2a008271b74d8e0367cdb73336d591b448c905c4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8364566\nReviewed-by: Xianzhu Wang \u003cwangxianzhu@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1695697}\n\n--\n\nwpt-commits: 708a7323129e08fc5d95a221d9647512fc20955e\nwpt-pr: 62511\n", "files": ["testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-003-ref.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-004-ref.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-005-ref.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-006-ref.html"], "git_node": "b675ca0890a77130c5cbf7b18ea4010e98ca0d2c", "git_parents": ["d2fb6314b29009499750cb3133b1add6f8c83314"], "node": "6cfec6f770e67fc76ed30b93e360079d80653315", "parents": ["e67139bc506888347eb2e24bde6c2152c9891dbe"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071246 [wpt PR 62511] - Update wpt metadata, a=testonly\n\nwpt-pr: 62511\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-anchor-position/anchor-as-multicol-crash.html.ini"], "git_node": "dafcbeb294b82d9ad02ad9a1bd039a08fb79b54f", "git_parents": ["b675ca0890a77130c5cbf7b18ea4010e98ca0d2c"], "node": "b0f5362317b0566d959e4800ce2506238a226cb7", "parents": ["6cfec6f770e67fc76ed30b93e360079d80653315"], "tags": []}, {"author": "Zhou Shuangshuang \u003cshuangshuang.zhou@intel.com\u003e", "branch": "default", "desc": "Bug 2071157 [wpt PR 62604] - animation: Fix step-easing limit direction for reversed animations, a=testonly\n\nAutomatic update from web-platform-tests\nanimation: Fix step-easing limit direction for reversed animations\n\nKeyframeEffect::ApplyEffects and InertEffect::Sample picked the\nbefore/after limit from phase alone, ignoring playback direction.\nTimingCalculations::CalculateTransformedProgress already computes\nthis correctly; extracted it into LimitDirectionForPhase() and\npointed both call sites at it. This needed threading the (already\ncomputed, previously discarded) current-direction-forward bit\nthrough Timing::CalculatedTiming.\n\ncompositor_animation_curve.cc:184 has the same bug but is tracked\nseparately (crbug.com/347958668), blocked on start-delay support;\nleft alone.\n\nAdded a WPT covering both the after-phase (step-start) and\nbefore-phase (step-end) cases with direction:reverse. Confirmed on\nstable Chrome that both fail without this patch (wrong computed\nopacity at the discontinuity). Also confirmed both pass on Firefox\nNightly, i.e. the asserted values are real interoperable behavior,\nnot a Chromium-specific interpretation of the spec.\n\nBug: 347967022\nChange-Id: I7bf7fa6506432ec15ae21e8b7074d7e8d9f6caad\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8369420\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCommit-Queue: Zhou, Shuangshuang \u003cshuangshuang.zhou@intel.com\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1695760}\n\n--\n\nwpt-commits: bce2d678af82185022685f3915111e6569391f0c\nwpt-pr: 62604\n", "files": ["testing/web-platform/tests/web-animations/animation-model/keyframe-effects/effect-value-step-easing-reversed-direction.html"], "git_node": "5c04602900a67742e2fce7c7ba0157e068a1a7a7", "git_parents": ["dafcbeb294b82d9ad02ad9a1bd039a08fb79b54f"], "node": "714d0cde3d918ce4cb15f539c7480cb2f7c9c80e", "parents": ["b0f5362317b0566d959e4800ce2506238a226cb7"], "tags": []}, {"author": "Isaac Ahouma \u003ciahouma@google.com\u003e", "branch": "default", "desc": "Bug 2071250 [wpt PR 62616] - [AI WPTs] Anchor polarity in bounded JSON schema constraint tests, a=testonly\n\nAutomatic update from web-platform-tests\n[AI WPTs] Anchor polarity in bounded JSON schema constraint tests\n\nClarify the rating scale in the prompt to '-1.0 (worst) to 1.0 (best)'\nand '-10 (worst) to 10 (best)'. Without explicit polarity anchors,\nconversational models default to a 1-5 star review scale (producing\nvalues like 4.0 or 5.0) which violates the test assertions.\n\nBug: 547963762\nChange-Id: Ia42150e591e04d3e8b914d0f608fb3ed32d70e58\nFixed: 547963762\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8392837\nReviewed-by: Mike Wasserman \u003cmsw@chromium.org\u003e\nAuto-Submit: Isaac Ahouma \u003ciahouma@google.com\u003e\nCommit-Queue: Mike Wasserman \u003cmsw@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1695794}\n\n--\n\nwpt-commits: e45789f2d085dc9f1aa8314fd1f8ce0cd3768926\nwpt-pr: 62616\n", "files": ["testing/web-platform/tests/ai/language-model/response-constraint/json-schema/integer-bounded.tentative.https.window.js", "testing/web-platform/tests/ai/language-model/response-constraint/json-schema/number-bounded.tentative.https.window.js"], "git_node": "775dfc7556ec27d24b6278b1145a3a06c3d27180", "git_parents": ["5c04602900a67742e2fce7c7ba0157e068a1a7a7"], "node": "aeeda486f19aef7d94172b20061029fd216d3516", "parents": ["714d0cde3d918ce4cb15f539c7480cb2f7c9c80e"], "tags": []}, {"author": "Isaac Ahouma \u003ciahouma@google.com\u003e", "branch": "default", "desc": "Bug 2071255 [wpt PR 62614] - [AI WPTs] Assert string return type for null and undefined prompt inputs, a=testonly\n\nAutomatic update from web-platform-tests\n[AI WPTs] Assert string return type for null and undefined prompt inputs\n\nAssert typeof string for null and undefined inputs rather than matching\nliteral regex substrings.\n\nConversational models like Gemma 4 often respond to null or undefined\ninputs by asking for clarification (e.g. \"That is a very minimal\nresponse. Could you please tell me what you would like me to do?\")\nrather than echoing the literal input text. Asserting typeof string\naligns with other empty-inputs tests and avoids intermittent failures.\n\nRemove obsolete failure expectations from the AI test manifests.\n\nBug: 547959960\nChange-Id: Ia9a82c12283942d7c72ff546167d185cd03c4b3e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8390497\nCommit-Queue: Isaac Ahouma \u003ciahouma@google.com\u003e\nReviewed-by: Mike Wasserman \u003cmsw@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1695812}\n\n--\n\nwpt-commits: a4a00ffa4169e12ff641305012b023f639394543\nwpt-pr: 62614\n", "files": ["testing/web-platform/tests/ai/language-model/prompt/empty-inputs/null-input.tentative.https.window.js", "testing/web-platform/tests/ai/language-model/prompt/empty-inputs/undefined-input.tentative.https.window.js"], "git_node": "be2e80fe0ceb031e499f3a6d72c4c9f25573cf50", "git_parents": ["775dfc7556ec27d24b6278b1145a3a06c3d27180"], "node": "e7a411270daceaa3325b9ce2ec3ed1e63cd77468", "parents": ["aeeda486f19aef7d94172b20061029fd216d3516"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071245 [wpt PR 62613] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321855, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321855 (#62613)\n--\n\nwpt-commits: 04cd4a830e26add75d385f28d95a080600b5d70f\nwpt-pr: 62613\n", "files": ["testing/web-platform/tests/html/editing/dnd/datastore/datatransferitem-disabled-mode.html"], "git_node": "883b16d610c39e2312671970fb44923264db8f53", "git_parents": ["be2e80fe0ceb031e499f3a6d72c4c9f25573cf50"], "node": "a061eab49ee87a08c261816b35daaf391c8fac7e", "parents": ["e7a411270daceaa3325b9ce2ec3ed1e63cd77468"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071245 [wpt PR 62613] - Update wpt metadata, a=testonly\n\nwpt-pr: 62613\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/editing/dnd/datastore/datatransferitem-disabled-mode.html.ini"], "git_node": "41dd296b28ddc96883e5a42e96594f444c32cb4a", "git_parents": ["883b16d610c39e2312671970fb44923264db8f53"], "node": "54c357a3c1bc07ee88df4c5711b241f286ab8b8c", "parents": ["a061eab49ee87a08c261816b35daaf391c8fac7e"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2071164 [wpt PR 62607] - [HiC] Disallow SVG markers that are outside a canvas subtree, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Disallow SVG markers that are outside a canvas subtree\n\nSVG Markers may contain arbitrary HTML content through a\n\u003cforeignObject\u003e, not to mention a wide variety of images\nor filters. As with SVG patterns, we disallow the use of\nmarkers defined outside of a canvas subtree, where privacy\nprotections are not available, particularly for visited\nlinks and form control autofill.\n\nFixed: 553136980\nChange-Id: I51dd1ab951949b79824ac00ae27dc134c3bc12c9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8385141\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1695874}\n\n--\n\nwpt-commits: e0551eab00f7a5164207ad664e4f98cd7c20bba3\nwpt-pr: 62607\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg-marker-outside-subtree-ignored.tentative.html"], "git_node": "f1b95fc71c8ecf3822c93cb6588310f632d1ca50", "git_parents": ["41dd296b28ddc96883e5a42e96594f444c32cb4a"], "node": "ca21914bfa4e6342646acea52d77f0cf613155be", "parents": ["54c357a3c1bc07ee88df4c5711b241f286ab8b8c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071164 [wpt PR 62607] - Update wpt metadata, a=testonly\n\nwpt-pr: 62607\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/svg-marker-outside-subtree-ignored.tentative.html.ini"], "git_node": "28687d9972f34cc02d6d87532a93a9129a9ddad2", "git_parents": ["f1b95fc71c8ecf3822c93cb6588310f632d1ca50"], "node": "179d0428bae50ef9ae98fb5124b286ddd1b2b9e5", "parents": ["ca21914bfa4e6342646acea52d77f0cf613155be"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2071265 [wpt PR 62514] - Upstream jsdom regression tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpstream jsdom regression tests\n\nBring locally maintained jsdom regression coverage into the shared web-platform suite, covering DOM mutation and collections, CSS parsing and serialization, custom elements, HTML parsing and forms, SVG, and asynchronous APIs. Extend existing tests where the assertions belong and add focused regressions for behavior not covered by the existing suite.\n\nCheck independent parsing and serialization behavior separately. Exercise explicit undefined and numeric arguments to CSS.escape(), as well as missing arguments and the existing conversion cases. Preserve construction-time File timestamps with a delayed first property read, standalone percentage flex basis and explicit zero shorthand values, root percentage font sizes, and unchanged SVG rectangle coordinates after assigning another coordinate.\n\nKeep synchronous stylesheet availability checks for cases without fetching imports and synchronous fragment URL/history checks for several navigations in one task alongside event-based completion. Verify that JavaScript URL execution and syntax errors are delivered asynchronously, and that removing loaded stylesheet links restores the previous computed color.\n\nKeep windowless-document insertion and computed-style checks in no-browsing-context.html, with asynchronous import completion in no-browsing-context-import.html. Separate noscript raw-text parsing from serialization so each behavior can be tracked independently.\n\nAdd ElementInternals-accessibility-values.html for accessibility property defaults, setters, conversion, and getter identity, alongside the existing property-existence test. Check lh-based font-size inheritance independently of its exact resolution. Verify that disabled controls remain associated with their implicit and explicit labels, and that retained label lists update when a label subtree is removed and reinserted.\n\nSeparate immediate image completeness from completion after 404 and malformed-URL error events, so each behavior can be tracked independently. Wait for initial window focus before exercising focus and blur operations, selector matching, and document focus after removal. Keep event counts, relatedTarget checks, and assertions about focus state synchronous with the tested operations.\n\nAllow 0.02px of rounding in fractional font-size checks while requiring pixel units, since CSS leaves numeric precision implementation-defined. Check whitespace parsing in font-family values independently of quoted versus unquoted family-name serialization.\n\nUse absolute URLs to WPT image resources for background-image list parsing and serialization checks, avoiding external fetches that are forbidden in the test environment.\n\nInclude specified behavior with implementation disagreements alongside interoperable cases.\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 03f14d4780c4d981bc84c65679b18e9327a1affe\nwpt-pr: 62514\n", "files": ["testing/web-platform/tests/FileAPI/blob/Blob-array-buffer-data-isolation.html", "testing/web-platform/tests/FileAPI/file/File-lastModified.html", "testing/web-platform/tests/FileAPI/reading-data-section/filereader_readAsDataURL.html", "testing/web-platform/tests/cookies/set-and-delete-document-cookie.window.js", "testing/web-platform/tests/css/css-animations/animation-name-case-sensitive.html", "testing/web-platform/tests/css/css-backgrounds/background-border-cssText.html", "testing/web-platform/tests/css/css-backgrounds/background-shorthand-clip.html", "testing/web-platform/tests/css/css-backgrounds/background-shorthand-keyword.html", "testing/web-platform/tests/css/css-backgrounds/border-color-currentcolor.html", "testing/web-platform/tests/css/css-backgrounds/border-color.html", "testing/web-platform/tests/css/css-backgrounds/border-radius-shorthand.html", "testing/web-platform/tests/css/css-backgrounds/border-shorthand-keyword.html", "testing/web-platform/tests/css/css-backgrounds/border-shorthands.html", "testing/web-platform/tests/css/css-backgrounds/border-style-length.html", "testing/web-platform/tests/css/css-backgrounds/border-width-computed.html", "testing/web-platform/tests/css/css-backgrounds/multiple-background-images.html", "testing/web-platform/tests/css/css-box/negative-margin.html", "testing/web-platform/tests/css/css-cascade/layer-rule-invalid-name.html", "testing/web-platform/tests/css/css-cascade/layers-basic.html", "testing/web-platform/tests/css/css-cascade/scope-rule-attr-with-colons.html", "testing/web-platform/tests/css/css-color/computed-color.html", "testing/web-platform/tests/css/css-color/nested-color-mix-with-currentcolor.html", "testing/web-platform/tests/css/css-conditional/container-queries-basic.html", "testing/web-platform/tests/css/css-conditional/container-rule-malformed-prelude.html", "testing/web-platform/tests/css/css-conditional/supports-basic.html", "testing/web-platform/tests/css/css-display/display-initial.html", "testing/web-platform/tests/css/css-flexbox/parsing/flex-shorthand.html", "testing/web-platform/tests/css/css-fonts/font-family-comma.html", "testing/web-platform/tests/css/css-fonts/font-size-computed-keyword.html", "testing/web-platform/tests/css/css-fonts/font-size-computed-no-child.html", "testing/web-platform/tests/css/css-fonts/font-size-computed.html", "testing/web-platform/tests/css/css-fonts/getComputedStyle-fontFamily.html", "testing/web-platform/tests/css/css-grid/grid-template-columns-mixed-calc.html", "testing/web-platform/tests/css/css-images/gradient-specified-values.html", "testing/web-platform/tests/css/css-masking/clip.html", "testing/web-platform/tests/css/css-nesting/nested-media-in-layer.html", "testing/web-platform/tests/css/css-nesting/nesting-braces-in-strings.html", "testing/web-platform/tests/css/css-position/box-insets-top-right-bottom-left.html", "testing/web-platform/tests/css/css-sizing/aspect-ratio.html", "testing/web-platform/tests/css/css-syntax/parse-invalid-input.html", "testing/web-platform/tests/css/css-values/calc-parentheses.html", "testing/web-platform/tests/css/css-values/calc-percentage-position.html", "testing/web-platform/tests/css/css-values/calc-serialize.html", "testing/web-platform/tests/css/css-values/font-relative-length.html", "testing/web-platform/tests/css/css-variables/custom-properties-inherit.html", "testing/web-platform/tests/css/cssom-view/detached-element-geometry.window.js", "testing/web-platform/tests/css/cssom/CSS-escape-numeric-id.html", "testing/web-platform/tests/css/cssom/CSS-supports.html", "testing/web-platform/tests/css/cssom/CSSGroupingRule-insertRule-computed.html", "testing/web-platform/tests/css/cssom/CSSImportRule-insertRule-styleSheet-parentStyleSheet.html", "testing/web-platform/tests/css/cssom/CSSImportRule-layer-false-positive.html", "testing/web-platform/tes