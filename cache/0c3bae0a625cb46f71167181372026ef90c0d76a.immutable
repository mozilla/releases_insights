ntent/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/components/TileList.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.html", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_default_pin_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_kit_intro.js", "browser/locales/en-US/browser/aboutPrivateBrowsing.ftl", "browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css", "toolkit/modules/RemotePageAccessManager.sys.mjs"], "git_node": "e1adf6bbb399de26b767c75b9d242baf84ac7859", "git_parents": ["ed1f83e4ff90401e9cf4d404ca66324582c680ab"], "node": "edc42dc4034687d70cab5ecf3bacbcaa75a87b2f", "parents": ["9d2c79b3255f81b785eaeaae4ff158df0231215e"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2072680 - Support GetBBox options for tspan/textPath bounding boxes r=firefox-svg-reviewers,dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326585\n", "files": ["dom/svg/SVGGraphicsElement.cpp", "layout/svg/SVGTextFrame.cpp", "layout/svg/SVGTextFrame.h", "layout/svg/SVGUtils.cpp", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-02.html", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-05.html"], "git_node": "572b09870e397d11555c559413feb49945abb362", "git_parents": ["e1adf6bbb399de26b767c75b9d242baf84ac7859"], "node": "7dd10dbffc2fb7aeab34f743a51d6624f636b919", "parents": ["edc42dc4034687d70cab5ecf3bacbcaa75a87b2f"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045805 - part 1 - Allow showing the tabstrip at the bottom also r=android-reviewers,android-l10n-reviewers,parker,Roger\n\nThis patch only supports showing the tabstrip in the same top/bottom part of\nthe screen as the toolbar. The other scenarios are to be handled separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321581\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/crashes/CrashContentIntegration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Fragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/CustomizationFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/customization_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/crashes/CrashContentIntegrationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/FragmentTest.kt"], "git_node": "200898255db44bcda9527cf608b787f2c1f11b90", "git_parents": ["572b09870e397d11555c559413feb49945abb362"], "node": "7343f29381a159cc159c434ebd23c13fd242df1c", "parents": ["7dd10dbffc2fb7aeab34f743a51d6624f636b919"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045805 - part 2 - Support showing the tabstrip at the bottom single or with the navigation bar r=android-reviewers,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321582\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/NavbarToolbarSyncBehavior.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt"], "git_node": "6583d85e3db2bd8e1a98b78fc25a8041c939cce7", "git_parents": ["200898255db44bcda9527cf608b787f2c1f11b90"], "node": "2956910fd5edd3ed709fa0ac8d9ed4925e8b4159", "parents": ["7343f29381a159cc159c434ebd23c13fd242df1c"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045805 - part 3 - Support showing the tabstrip as a single View at the top of the screen r=android-reviewers,calu\n\nPreviously the tabstrip would be shown in the same View of the toolbar or of the navigation bar\nwhich would then be added at runtime to the XML layout.\nWhen it is to be shown single at the top of the screen it needs its own View wrapper to be\nintegrated in the XML layout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321583\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserTabStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserTabStripView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Fragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/ids.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/FragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "efffd5935322428c0e1b009305dc74951bd61f12", "git_parents": ["6583d85e3db2bd8e1a98b78fc25a8041c939cce7"], "node": "f33790a7423c400005ae7645dda8b26092a6faa8", "parents": ["2956910fd5edd3ed709fa0ac8d9ed4925e8b4159"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045805 - part 4 - Update tabstrip theming when tabstrip is shown at the bottom r=android-reviewers,calu\n\nWhen the tabstrip is shown at the bottom the status bar should not be themed and the\ntabstrip should not have a transparent background like it has when shown in the\nhomescreen (to prevent the webpage content showing through).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321584\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/StatusBarColorManager.kt"], "git_node": "fde22dc3c0dd4c958d8168e4908d0d8b9c8e356f", "git_parents": ["efffd5935322428c0e1b009305dc74951bd61f12"], "node": "0618e9152bc271eab4102b05a6d0a077444a7e78", "parents": ["f33790a7423c400005ae7645dda8b26092a6faa8"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045805 - part 5 - Hide the bottom tabstrip when entering text in a website r=android-reviewers,calu\n\nMatching the same behavior as of the navigation bar to ensure we don't take too much\nspace above the keyboard.\nUsed an animation to ensure the tabstrip + navigation bar which have ~100dp don't\nimmediately appear or disappear from the screen which could be perceived as an UI\nglitch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321585\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/TabStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt"], "git_node": "c48dcc6b28eac5d36b61455a197a455ffd4b543e", "git_parents": ["fde22dc3c0dd4c958d8168e4908d0d8b9c8e356f"], "node": "7f6943513f6e0eb58daa8251660f407534aac8db", "parents": ["0618e9152bc271eab4102b05a6d0a077444a7e78"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072965 - Ensure sidebar extension panel header is shown when 'Open tools from sidebar' is unchecked r=sidebar-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326988\n", "files": ["browser/components/sidebar/sidebar-panel-switcher.mjs", "browser/components/sidebar/tests/browser/browser_hide_sidebar.js"], "git_node": "88b81b9e07b77104608796db1f8479c915030ee6", "git_parents": ["c48dcc6b28eac5d36b61455a197a455ffd4b543e"], "node": "c68d29eb2646b8c2dde0f8bf558611489cc2035d", "parents": ["7f6943513f6e0eb58daa8251660f407534aac8db"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["browser/base/content/test/about/basic_auth_route.sjs", "browser/base/content/test/about/blank_page.sjs", "browser/base/content/test/about/browser.toml", "browser/base/content/test/about/browser_aboutCertError.js", "browser/