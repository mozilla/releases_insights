ponents/enterprisepolicies/nsIEnterprisePolicies.idl"], "git_node": "16f1aef104734dd2589cda324a1c470dc19837cc", "git_parents": ["fb92ce92dbe74e274acbf554ffaae17f4df2ffc8"], "node": "80c3d239af14b1ae983328e2ff9d5f205f7cd300", "parents": ["966f48accb06b6e03940f8fcafc467d5e4d424fb"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2045798: Support ephemeral containers in SitePolicies. r=bsmth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324911\n", "files": ["browser/components/enterprisepolicies/EphemeralContainerWatcher.sys.mjs", "browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/moz.build", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_container.js", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies_container.js"], "git_node": "ac00aa71d8fc131aec235b5b108fa759432fa1dd", "git_parents": ["16f1aef104734dd2589cda324a1c470dc19837cc"], "node": "df250962118135259433429252417a0eb58a5196", "parents": ["80c3d239af14b1ae983328e2ff9d5f205f7cd300"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2050774 - Part 1: Consider precursor origin in ValidatePrincipal, r=asuth\n\nAn extra tier is added to LoadedOriginSet to track site-origins which\nare only loaded as a null principal precursor. This is then used by\nValidatePrincipal to allow these loaded origins only during precursor\nprincipal validation.\n\nIn order to add this extra level, there are a few simplifications made\nto the LoadedOriginSet type as well, changing the signature of a few\ntypes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319631\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/LoadedOriginSet.cpp", "dom/ipc/LoadedOriginSet.h", "dom/ipc/ProcessIsolation.cpp", "dom/ipc/ProcessIsolation.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "345b6301676031288cc73d8e91b50b373ea973d3", "git_parents": ["ac00aa71d8fc131aec235b5b108fa759432fa1dd"], "node": "b51ebd337f58b8d485aa6afdddbb8647fa41b0b0", "parents": ["df250962118135259433429252417a0eb58a5196"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2050774 - Part 2: Trust PrincipalToInherit from HTTP(s) redirects, r=vhilla,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321321\n", "files": ["dom/ipc/ContentChild.cpp", "dom/security/nsContentSecurityManager.cpp", "netwerk/base/LoadInfo.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/TRRLoadInfo.cpp", "netwerk/base/nsILoadInfo.idl", "netwerk/ipc/DocumentChannelChild.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "be9aa3fb3aaa3f0ce1a9457d3114812ad3e93e29", "git_parents": ["345b6301676031288cc73d8e91b50b373ea973d3"], "node": "b31caf16827481b941d55fe7662dbdf0b6c336ee", "parents": ["b51ebd337f58b8d485aa6afdddbb8647fa41b0b0"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2071165 - Pass property declaration name through style parsing context. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325601\n", "files": ["servo/components/style/custom_properties.rs", "servo/components/style/parser.rs", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties_and_values/rule.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/queries/condition.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/stylesheets/font_feature_values_rule.rs", "servo/components/style/stylesheets/font_palette_values_rule.rs", "servo/components/style/stylesheets/mod.rs", "servo/components/style/stylesheets/rule_parser.rs", "servo/components/style/stylesheets/supports_rule.rs", "servo/components/style/stylist.rs", "servo/ports/geckolib/glue.rs"], "git_node": "a0107fb59547e4fc00348a234fc4b76954e95621", "git_parents": ["be9aa3fb3aaa3f0ce1a9457d3114812ad3e93e29"], "node": "765cd33eb83bf0f11ca10d5a549bbe250260afae", "parents": ["b31caf16827481b941d55fe7662dbdf0b6c336ee"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2071165 - Implement CSS random() function behind pref. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325602\n", "files": ["Cargo.lock", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/Cargo.toml", "servo/components/style/device/gecko.rs", "servo/components/style/device/servo.rs", "servo/components/style/parser.rs", "servo/components/style/stylesheets/mod.rs", "servo/components/style/values/computed/length_percentage.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/generics/calc.rs", "servo/components/style/values/generics/mod.rs", "servo/components/style/values/mod.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/mod.rs", "servo/components/style/values/specified/random.rs", "testing/web-platform/meta/css/css-values/__dir__.ini", "testing/web-platform/meta/css/css-values/random-computed.tentative.html.ini", "testing/web-platform/meta/css/css-values/random-in-animations.tentative.html.ini", "testing/web-platform/meta/css/css-values/random-in-container-query.tentative.html.ini", "testing/web-platform/meta/css/css-values/random-in-keyframe.html.ini", "testing/web-platform/meta/css/css-values/random-in-media.tentative.html.ini", "testing/web-platform/meta/css/css-values/random-serialize.tentative.html.ini", "testing/web-platform/meta/css/css-values/random-unresolvable-argument.tentative.html.ini", "testing/web-platform/tests/