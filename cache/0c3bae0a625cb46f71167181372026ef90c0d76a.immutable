Use inputmode=search for the search bars. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325066\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser.toml", "browser/components/urlbar/tests/browser-UrlbarInput/browser_inputmode.js", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_inputmode.js", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/components/urlbar/tests/browser/searchbar/browser_inputmode.js"], "git_node": "c0e6a2889d57714564e6626114ff63552f11744a", "git_parents": ["fa9fa6f0db0beea54892c12a0ebddd3aa963763e"], "node": "bd7f5c5b1720efe531aba1571f18653a65b72cd8", "parents": ["f32897267ae0b7ae9923dfc73489c5ed1ede46e9"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1977639 - Report slow SQL over Glean r=mak\" for causing mochitest leak failures\n\nThis reverts commit 34cb382e4c9dd17e778514050b266cbbac17480b.\n", "files": ["storage/metrics.yaml", "storage/mozStorageConnection.cpp", "storage/mozStorageConnection.h", "storage/mozStorageService.cpp", "storage/pings.yaml", "toolkit/components/glean/metrics_index.py"], "git_node": "50cac606290fe365809302d5ca532e9bcd69ff09", "git_parents": ["c0e6a2889d57714564e6626114ff63552f11744a"], "node": "1d924230b748e03b892173bbe14a4e88233d93e2", "parents": ["bd7f5c5b1720efe531aba1571f18653a65b72cd8"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1594264 - Enable sql normalization r=mak\" for causing mochitest leak failures\n\nThis reverts commit c90dbfd108f5baa2361bacf6662aaced631ef3b1.\n", "files": ["storage/moz.build", "third_party/sqlite3/src/moz.build", "third_party/sqlite3/src/sqlite.symbols"], "git_node": "482d23a87b5fec136bd41