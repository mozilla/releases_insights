esting/web-platform/tests/xhr/response-invalid-utf8.html", "testing/web-platform/tests/xhr/response-json-bom.html", "testing/web-platform/tests/xhr/response-json-during-loading.html", "testing/web-platform/tests/xhr/send-data-isolation.html", "testing/web-platform/tests/xhr/send-document-lone-surrogate.html"], "git_node": "69a6011f205c1b87168255d08c6ef165865381b0", "git_parents": ["28687d9972f34cc02d6d87532a93a9129a9ddad2"], "node": "ce5d46d6d63a397a11b6ae56b98c5f75e653ee12", "parents": ["179d0428bae50ef9ae98fb5124b286ddd1b2b9e5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071265 [wpt PR 62514] - Update wpt metadata, a=testonly\n\nwpt-pr: 62514\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/cssom/CSSKeyframeRule-keyText.html.ini", "testing/web-platform/meta/css/cssom/MediaList-parsing.html.ini", "testing/web-platform/meta/custom-elements/shadow-descendant-lifecycle-order.html.ini", "testing/web-platform/meta/dom/nodes/namespaced-attribute-mutations.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/named-access-on-the-window-object/live-collection.html.ini", "testing/web-platform/meta/html/dom/documents/dom-tree-accessors/nameditem-supported-property-names-order.html.ini", "testing/web-platform/meta/html/semantics/document-metadata/the-style-element/no-browsing-context.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-iframe-element/iframe-error-status-fires-load.html.ini", "testing/web-platform/meta/html/semantics/forms/the-datalist-element/input-list-detached.html.ini", "testing/web-platform/meta/html/semantics/forms/the-label-element/labels-live-attribute-changes.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/modulepreload-referrerpolicy.html.ini", "testing/web-platform/meta/svg/struct/scripted/element-symbol.html.ini"], "git_node": "061fd72f4fd457ea994f4e4a068633a06a573092", "git_parents": ["69a6011f205c1b87168255d08c6ef165865381b0"], "node": "c8900b60a09b89328166597521c1e722135378ae", "parents": ["ce5d46d6d63a397a11b6ae56b98c5f75e653ee12"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071274 [wpt PR 62618] - Update CODEOWNERS, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated update of CODEOWNERS\n\n--\n\nwpt-commits: 59ff8a4854a8d2d32ca0dc113760f2aaad70f4b5\nwpt-pr: 62618\n", "files": ["testing/web-platform/tests/CODEOWNERS"], "git_node": "85b0d4aa65c6cfdef9d814e6eefd673387e1ea6d", "git_parents": ["061fd72f4fd457ea994f4e4a068633a06a573092"], "node": "4179ad0a3a4ac83d18432013e68fedda7bcd9529", "parents": ["c8900b60a09b89328166597521c1e722135378ae"], "tags": []}, {"author": "Daniel Clark \u003cdaniec@microsoft.com\u003e", "branch": "default", "desc": "Bug 2071284 [wpt PR 62617] - [Reference Target] Preserve event source properties after dispatch, a=testonly\n\nAutomatic update from web-platform-tests\n[Reference Target] Preserve event source properties after dispatch\n\nThe reference target event-path implementation used Event's internal\nrelatedTarget storage for SubmitEvent.submitter and the source\nproperties of CommandEvent, ToggleEvent, and InterestEvent.\n\nDOM event dispatch clears relatedTarget after some dispatches in shadow\ntrees (see `clearTarget` in [1]). This caused these event properties now\nbacked by relatedTarget to become null after dispatch, including for\nsame-tree relationships that did not involve Reference Target.\n\nIn this CL, preserve reference target propagation while restoring the\nprevious behavior for same-tree and synthetic events, including source\nretargeting and reads after dispatch.\n\nThis is done by returning submitter/source to being backed by separate\nevent-specific fields. To preserve reference target's cross-tree\npropagation, relatedTarget will still be set on these events; it's just\nno longer used to back the properties.\n\n[1] https://dom.spec.whatwg.org/#concept-event-dispatch\n\nBug: 556160944\nChange-Id: I14c8150db4b8df9b12e7c5e64517e7ce29a01faf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8353650\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Dan Clark \u003cdaniec@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1695924}\n\n--\n\nwpt-commits: d9ce49d5f62eb3e3532833b0590ce7d27763556a\nwpt-pr: 62617\n", "files": ["testing/web-platform/tests/html/semantics/forms/form-submission-0/SubmitEvent.window.js", "testing/web-platform/tests/html/semantics/interestfor/interestevent-dispatch-shadow.tentative.html", "testing/web-platform/tests/html/semantics/interestfor/interestevent-interface.tentative.html", "testing/web-platform/tests/html/semantics/popovers/toggleevent-interface.html", "testing/web-platform/tests/html/semantics/the-button-element/command-and-commandfor/event-interface.html", "testing/web-platform/tests/html/semantics/the-button-element/command-and-commandfor/source-attribute-retargeting.html", "testing/web-platform/tests/html/semantics/the-button-element/command-and-commandfor/toggleevent-source-attribute-retargeting.html"], "git_node": "498b6046e5f5c4ea9ed31b9ecd36176e94cd2235", "git_parents": ["85b0d4aa65c6cfdef9d814e6eefd673387e1ea6d"], "node": "b680d3e7e7a0a3bdf47f5c596455bae733392480", "parents": ["4179ad0a3a4ac83d18432013e68fedda7bcd9529"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071284 [wpt PR 62617] - Update wpt metadata, a=testonly\n\nwpt-pr: 62617\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/form-submission-0/SubmitEvent.window.js.ini", "testing/web-platform/meta/html/semantics/interestfor/interestevent-interface.tentative.html.ini", "testing/web-platform/meta/html/semantics/the-button-element/command-and-commandfor/source-attribute-retargeting.html.ini", "testing/web-platform/meta/html/semantics/the-button-element/command-and-commandfor/toggleevent-source-attribute-retargeting.html.ini"], "git_node": "0ea51abc746e2117ac330017e8b8f016d4dcd6b3", "git_parents": ["498b6046e5f5c4ea9ed31b9ecd36176e94cd2235"], "node": "91bc3fcd48bc53ed577adc35a39a7fc007d5b7e4", "parents": ["b680d3e7e7a0a3bdf47f5c596455bae733392480"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071508 - [wpt-sync] Update web-platform-tests to d9ce49d5f62eb3e3532833b0590ce7d27763556a, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: d9ce49d5f62eb3e3532833b0590ce7d27763556a\nwpt-type: landing\n", "files": ["testing/web-platform/meta/css/css-animations/animation-duration-infinite.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini", "testing/web-platform/meta/fenced-frame/anchor-focus.https.html.ini", "testing/web-platform/meta/fenced-frame/autofocus-denied.https.html.ini", "testing/web-platform/meta/fenced-frame/background-fetch.https.html.ini", "testing/web-platform/meta/fenced-frame/background-sync.https.html.ini", "testing/web-platform/meta/fenced-frame/badging.https.html.ini", "testing/web-platform/meta/fenced-frame/battery_status.https.html.ini", "testing/web-platform/meta/fenced-frame/before-unload.https.html.ini", "testing/web-platform/meta/fenced-frame/change-src-attribute-after-config-installation-does-not-trigger-navigation.https.html.ini", "testing/web-platform/meta/fenced-frame/client-hints.https.html.ini", "testing/web-platform/meta/fenced-frame/compute-pressure.https.html.ini", "testing/web-platform/meta/fenced-frame/config-installation-triggers-navigation-of-navigated-fenced-frame.https.html.ini", "testing/web-platform/meta/fenced-frame/config-installation-triggers-navigation.https.html.ini", "testing/web-platform/meta/fenced-frame/config-with-empty-url-installation-unloads-navigated-fenced-frame.https.html.ini", "testing/web-platform/meta/fenced-frame/consume-user-ac