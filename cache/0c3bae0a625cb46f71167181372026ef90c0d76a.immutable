rename detection (and blame) intact.\n\n- git mv dom/base/nsRange.{h,cpp} -\u003e dom/base/Range.{h,cpp}\n- moz.build: header moves to EXPORTS.mozilla.dom (installs as\n  mozilla/dom/Range.h), source repositioned in UNIFIED_SOURCES\n- all #include \"nsRange.h\" -\u003e #include \"mozilla/dom/Range.h\"\n- Bindings.conf: add explicit headerFile for the Range interface so WebIDL and\n  XPIDL codegen emit the new header path. Part 3 removes it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307782\n", "files": ["accessible/base/nsCoreUtils.cpp", "accessible/generic/HyperTextAccessible.cpp", "dom/base/AbstractRange.cpp", "dom/base/ContentIterator.cpp", "dom/base/ContentIterator.h", "dom/base/CrossShadowBoundaryRange.cpp", "dom/base/Document.cpp", "dom/base/Element.cpp", "dom/base/FragmentDirective.cpp", "dom/base/FragmentOrElement.cpp", "dom/base/Range.cpp", "dom/base/Range.h", "dom/base/ScriptableContentIterator.cpp", "dom/base/Selection.cpp", "dom/base/Selection.h", "dom/base/SelectionChangeEventDispatcher.cpp", "dom/base/TextDirectiveCreator.cpp", "dom/base/TextDirectiveFinder.cpp", "dom/base/TextDirectiveUtil.cpp", "dom/base/moz.build", "dom/base/nsContentAreaDragDrop.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsCopySupport.cpp", "dom/base/nsDOMCaretPosition.cpp", "dom/base/nsFocusManager.cpp", "dom/base/nsINode.cpp", "dom/base/nsRange.cpp", "dom/base/nsRange.h", "dom/base/nsTextNode.cpp", "dom/bindings/Bindings.conf", "dom/events/ContentEventHandler.cpp", "dom/events/IMEContentObserver.cpp", "dom/html/HTMLFormElement.cpp", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsHTMLDocument.cpp", "dom/media/mediaelement/HTMLMediaElement.cpp", "dom/serializers/nsDocumentEncoder.cpp", "editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/AutoClonedRangeArray.h", "editor/libeditor/CompositionTransaction.cpp", "editor/libeditor/DeleteRangeTransaction.h", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorEventListener.cpp", "editor/libeditor/EditorUtils.cpp", "editor/libeditor/EditorUtils.h", "editor/libeditor/HTMLEditHelpers.cpp", "editor/libeditor/HTMLEditHelpers.h", "editor/libeditor/HTMLEditSubActionHandler.cpp", "editor/libeditor/HTMLEditorDataTransfer.cpp", "editor/libeditor/HTMLEditorDeleteHandler.cpp", "editor/libeditor/HTMLEditorEventListener.cpp", "editor/libeditor/HTMLEditorInlines.h", "editor/libeditor/HTMLEditorInsertLineBreakHandler.cpp", "editor/libeditor/HTMLEditorMutationObserver.cpp", "editor/libeditor/HTMLEditorState.cpp", "editor/libeditor/HTMLStyleEditor.cpp", "editor/libeditor/HTMLTableEditor.cpp", "editor/libeditor/SelectionState.cpp", "editor/libeditor/SelectionState.h", "editor/libeditor/TextEditorDataTransfer.cpp", "editor/libeditor/WSRunScanner.cpp", "editor/spellchecker/EditorSpellCheck.cpp", "editor/spellchecker/FilteredContentIterator.cpp", "editor/spellchecker/TextServicesDocument.cpp", "extensions/spellcheck/src/mozInlineSpellChecker.cpp", "extensions/spellcheck/src/mozInlineSpellChecker.h", "extensions/spellcheck/src/mozInlineSpellWordUtil.cpp", "layout/base/PresShell.cpp", "layout/generic/nsFrameSelection.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsImageFrame.cpp", "layout/generic/nsTextFrame.cpp", "layout/inspector/InspectorFontFace.h", "layout/inspector/InspectorUtils.cpp", "layout/printing/nsPrintJob.cpp", "toolkit/components/find/nsFind.cpp", "toolkit/components/find/nsWebBrowserFind.cpp", "toolkit/components/typeaheadfind/nsTypeAheadFind.cpp"], "git_node": "24f92fdedcb08a209b9aa37988ce250b9014fd1b", "git_parents": ["27c23d91c88145629548efd040138e596a355639"], "node": "7481783f9c1266baffcf630c4c884ac4df51b434", "parents": ["b9344c63abc3ef0472d36b047b9c4a34ebea5144"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048943 - Part 2: Qualify mozilla::Range\u003cT\u003e ahead of nsRange rename. r=dom-core-reviewers,media-playback-reviewers,webrtc-reviewers,padenot,keithamus,mjf,ipc-reviewers\n\nmozilla::dom::Range (introduced in Part 3) collides with mozilla::Range\u003cT\u003e\n(the mfbt span utility) in any translation unit with `using namespace dom`\nactive. Resolve every affected use before the rename lands:\n\n- Qualify mozilla::Range\u003cT\u003e explicitly in WebGL, WebRender, graphics layers,\n  layout and IPC code.\n- Rename NormalizedConstraintSet::Range\u003cT\u003e to ConstraintRange\u003cT\u003e in\n  MediaTrackConstraints and MediaIPCUtils to avoid the same collision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308062\n", "files": ["dom/canvas/CanvasImageCache.cpp", "dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ClientWebGLContext.h", "dom/canvas/HostWebGLContext.h", "dom/canvas/QueueParamTraits.h", "dom/canvas/WebGL2Context.h", "dom/canvas/WebGLChild.cpp", "dom/canvas/WebGLChild.h", "dom/canvas/WebGLCommandQueue.h", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLContextTextures.cpp", "dom/canvas/WebGLIpdl.h", "dom/canvas/WebGLParent.cpp", "dom/canvas/WebGLQueueParamTraits.h", "dom/canvas/WebGLTexture.h", "dom/canvas/WebGLTypes.h", "dom/media/ipc/MediaIPCUtils.h", "dom/media/webrtc/MediaTrackConstraints.cpp", "dom/media/webrtc/MediaTrackConstraints.h", "gfx/layers/NativeLayer.h", "gfx/layers/composite/TextureHost.h", "gfx/layers/wr/IpcResourceUpdateQueue.h", "gfx/layers/wr/WebRenderBridgeChild.h", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/WebRenderTypes.h", "ipc/glue/Shmem.h", "layout/generic/TextDrawTarget.h", "mfbt/Range.h"], "git_node": "ea97a01126f9af6fcea62de4a85b6e4e6f4d9dda", "git_parents": ["24f92fdedcb08a209b9aa37988ce250b9014fd1b"], "node": "4119b4a970e1ef648da9ecc9e1c1c1dc747deb39", "parents": ["7481783f9c1266baffcf630c4c884ac4df51b434"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048943 - Part 3: Rename nsRange to mozilla::dom::Range. r=dom-core-reviewers,media-playback-reviewers,layout-reviewers,padenot,dholbert,smaug\n\nRename the class to mozilla::dom::Range, matching the DOM spec's naming (the\nRange interface, as opposed to StaticRange). AbstractRange's IsDynamicRange(),\nAsDynamicRange() and mIsDynamicRange become IsRange(), AsRange() and mIsRange.\n\nWith both `using namespace mozilla` and `using namespace mozilla::dom` at\nglobal scope, an unqualified Range is ambiguous between mozilla::dom::Range\nand mozilla::Range\u003cT\u003e. Range.cpp therefore now lives inside namespace\nmozilla::dom, like AbstractRange.cpp and StaticRange.cpp. Selection.cpp\nqualifies its few global-scope uses as dom::Range.\n\nThere are no behavior changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307783\n", "files": ["accessible/base/SelectionManager.cpp", "accessible/base/TextLeafRange.cpp", "accessible/base/TextRange.cpp", "accessible/base/TextRange.h", "accessible/base/nsCoreUtils.cpp", "accessible/base/nsCoreUtils.h", "accessible/generic/HyperTextAccessible.cpp", "accessible/generic/HyperTextAccessible.h", "docshell/base/nsDocShell.cpp", "dom/base/AbstractRange.cpp", "dom/base/AbstractRange.h", "dom/base/ContentIterator.cpp", "dom/base/ContentIterator.h", "dom/base/CrossShadowBoundaryRange.cpp", "dom/base/CrossShadowBoundaryRange.h", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/FragmentDirective.cpp", "dom/base/FragmentDirective.h", "dom/base/Range.cpp", "dom/base/Range.h", "dom/base/RangeBoundary.h", "dom/base/RangeUtils.h", "dom/base/ScriptableContentIterator.cpp", "dom/base/Selection.cpp", "dom/base/Selection.h", "dom/base/SelectionChangeEventDispatcher.cpp", "dom/base/SelectionChangeEventDispatcher.h", "dom/base/StaticRange.h", "dom/base/Text.cpp", "dom/base/TextDirectiveCreator.h", "dom/base/TextDirectiveFinder.cpp", "dom/base/TextDirectiveFinder.h", "dom/base/TextDirectiveUtil.cpp", "dom/base/TextDirectiveUtil.h", "dom/base/nsContentUtils.cpp", "dom/base/nsCopySupport.cpp", "dom/base/nsDOMCaretPosition.cpp", "dom/base/nsFocusManager.cpp", "dom/base/nsINode.cpp", "dom/base/nsINode.h", "dom/base/nsIScriptableContentIterator.idl", "dom/bindings/Bindings.conf", "dom/events/ContentEventHandler.cpp", "dom/events/ContentEventHandler.h", "dom/events/EventStateManager.cpp", "dom/events/IMEContentObserver.cpp", "dom/events/TextComposition.cpp", "dom/events/TextComposition.h", "dom/html/HTMLSlotElement.cpp", "dom/html/nsGenericHTMLElement.cpp", "dom/ipc/SharedMap.cpp", "dom/media/mediaelement/HTMLMediaElement.h", "dom/serializers/nsDocumentEncoder.cpp", "editor/docs/EditorModuleStructure.md", "editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/AutoClonedRangeArray.h", "editor/libeditor/CompositionTransaction.cpp", "editor/libeditor/DeleteRangeTransaction.cpp", "editor/libeditor/DeleteRangeTransaction.h", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/EditorDOMPoint.h", "editor/libeditor/EditorUtils.h", "editor/libeditor/HTMLEditHelpers.cpp", "editor/libeditor/HTMLEditHelpers.h", "editor/libeditor/HTMLEditSubActionHandler.cpp", "editor/libeditor/HTMLEditUtils.cpp", "editor/libeditor/HTMLEditUtils.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorDataTransfer.cpp", "editor/libeditor/HTMLEditorDeleteHandler.cpp", "editor/libeditor/HTMLEditorInlines.h", "editor/libeditor/HTMLEditorInsertLineBreakHandler.cpp", "editor/libeditor/HTMLEditorMutationObserver.cpp", "editor/libeditor/HTMLEditorNestedClasses.h", "editor/libeditor/HTMLEditorState.cpp", "editor/libeditor/HTMLStyleEditor.cpp", "editor/libeditor/HTMLTableEditor.cpp", "editor/libeditor/SelectionState.cpp", "editor/libeditor/SelectionState.h", "editor/libeditor/WSRunScanner.cpp", "editor/libeditor/WSRunScanner.h", "editor/spellchecker/EditorSpellCheck.cpp", "editor/spellchecker/FilteredContentIterator.cpp", "editor/spellchecker/FilteredContentIterator.h", "editor/spellchecker/TextServicesDocument.cpp", "editor/spellchecker/TextServicesDocument.h", "extensions/spellcheck/src/mozInlineSpellChecker.cpp", "extensions/spellcheck/src/mozInlineSpellChecker.h", "extensions/spellcheck/src/mozInlineSpellWordUtil.cpp", "extensions/spellcheck/src/mozInlineSpellWordUtil.h", "layout/base/AccessibleCaretManager.cpp", "layout/base/AccessibleCaretManager.h", "layout/base/PresShell.cpp", "layout/base/PresShell.h", "layout/base/nsLayoutUtils.cpp", "layout/generic/SelectionMovementUtils.cpp", "layout/generic/nsFrameSelection.cpp", "layout/generic/nsFrameSelection.h", "layout/generic/nsImageFrame.cpp", "layout/inspector/InspectorFontFace.cpp", "layout/inspector/InspectorFontFace.h", "layout/inspector/InspectorUtils.cpp", "layout/inspector/InspectorUtils.h", "layout/printing/nsPrintJob.cpp", "toolkit/components/find/nsFind.cpp", "toolkit/components/find/nsFind.h", "toolkit/components/find/nsWebBrowserFind.cpp", "toolkit/components/find/nsWebBrowserFind.h", "toolkit/components/typeaheadfind/nsTypeAheadFind.cpp", "toolkit/components/typeaheadfind/nsTypeAheadFind.h"], "git_node": "7dfd273d8e21ba770721c192b3240537ce472273", "git_parents": ["ea97a01126f9af6fcea62de4a85b6e4e6f4d9dda"], "node": "aea9f1ef5b418cef6ad1eb8f54ae1e8066f35792", "parents": ["4119b4a970e1ef648da9ecc9e1c1c1dc747deb39"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2048943: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/base/Range.cpp", "dom/base/Selection.cpp", "dom/canvas/QueueParamTraits.h", "editor/libeditor/HTMLEditor.h", "extensions/spellcheck/src/mozInlineSpellChecker.h"], "git_node": "d522d95e1665493908d0e8a297174aa161550090", "git_parents": ["7dfd273d8e21ba770721c192b3240537ce472273"], "node": "8b88b8d68b849cd242d37bf6c2634f5dfbbdb45a", "parents": ["aea9f1ef5b418cef6ad1eb8f54ae1e8066f35792"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072946 - Remove unnecessary assertion and handle a null DB in Favicons code. r=places-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328096\n", "files": ["toolkit/components/places/FaviconHelpers.cpp"], "git_node": "dd30bf78a6867536a99f5d638baed1196b0867ee", "git_parents": ["d522d95e1665493908d0e8a297174aa161550090"], "node": "48e38176f945d976640b26a81632533bc0cdaecc", "parents": ["8b88b8d68b849cd242d37bf6c2634f5dfbbdb45a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 1: Rename FCSR rounding mode setter to camelCase. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327570\n", "files": ["js/src/jit/loong64/Simulator-loong64.h"], "git_node": "ac3564cd3e4b156107e7a57fe11ba5bd436ef424", "git_parents": ["dd30bf78a6867536a99f5d638baed1196b0867ee"], "node": "7b130385f16d7d529b20a7d94d05a70e51ead953", "parents": ["48e38176f945d976640b26a81632533bc0cdaecc"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 2: Introduce getters for Loong64-default QNaNs. r=spidermonkey-reviewers,jandem\n\nThis would be used in later parts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327571\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "ee37bc1dcd2ff33ebdb22fe9983f307ac50065a2", "git_parents": ["ac3564cd3e4b156107e7a57fe11ba5bd436ef424"], "node": "446ebeab776f10426760f6c3b8bbb05185e919c1", "parents": ["7b130385f16d7d529b20a7d94d05a70e51ead953"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 3: Normalize NaN propagation rules per ISA manual. r=spidermonkey-reviewers,jandem\n\nLoongArch ISA has explicitly defined the SNaN handling and NaN payload\npropagation behavior.\n\nFor SNaN, it's required to toggle it to QNaN and set relevant bits in\nthe FCSR.\n\nFor multi-operand operations where some of them are NaN, there is also a\npriority defined by the manual specifying which NaN's payload would be\ncarried along.\n\nLink:\n https://loongson.github.io/LoongArch-Documentation/LoongArch-Vol1-EN.html#_non_numerical_result_of_instructions\n (\"LoongArch Reference Manual Volume 1: 3.1.1.3. Non-numerical Result of\n Instructions\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327572\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "bd5359aef92d1ddda72ea386cf95ac4b009de347", "git_parents": ["ee37bc1dcd2ff33ebdb22fe9983f307ac50065a2"], "node": "2ebd8f5a42ff1c80a43ee6bc0624a7b4e7ceeb9f", "parents": ["446ebeab776f10426760f6c3b8bbb05185e919c1"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 4: Properly set {Flags,Cause}/V in FCSR for FCMP.cond.[SD]. r=spidermonkey-reviewers,jandem\n\nFCMP.cond.[SD] are not exempt from the SNaN handling process. This is\nverified on 3B6000 silicon as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327573\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "fbf419aecc24e325121393f4bb78ac0d94580459", "git_parents": ["bd5359aef92d1ddda72ea386cf95ac4b009de347"], "node": "8bae6b716cb393f260f2ca906293e517037ffce2", "parents": ["2ebd8f5a42ff1c80a43ee6bc0624a7b4e7ceeb9f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 5: Fix NaN behavior for F{MIN,MINA,MAX,MAXA}.[SD]. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327574\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "a7f0d417fca9016747e61958577ec5889a2ffcf2", "git_parents": ["fbf419aecc24e325121393f4bb78ac0d94580459"], "node": "3db7469c6d9a73ba599e289a349367cfc205fd4d", "parents": ["8bae6b716cb393f260f2ca906293e517037ffce2"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 6: Fix NaN behavior of fused multiply-add instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327575\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "d97acfcf45a841f7cd819e9a8dc919f4dbec295e", "git_parents": ["a7f0d417fca9016747e61958577ec5889a2ffcf2"], "node": "fc7e0882f2f2a34216b3d7d15c52ce0b98e12f38", "parents": ["3db7469c6d9a73ba599e289a349367cfc205fd4d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 7: Fix NaN operand behavior of FRINT.[SD]. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327576\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "9851b727906183359ecd79b67dd81f4030897013", "git_parents": ["d97acfcf45a841f7cd819e9a8dc919f4dbec295e"], "node": "147ba164313eb0765b6179055659332e256fba94", "parents": ["fc7e0882f2f2a34216b3d7d15c52ce0b98e12f38"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 8: Fix NaN behavior of FSQRT.[SD]. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327577\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "c37d973c8dc1dc37279369fbd5b598a8fe87ca4f", "git_parents": ["9851b727906183359ecd79b67dd81f4030897013"], "node": "aadfe49c237cf0b68e9758814562b5caa3e5af24", "parents": ["147ba164313eb0765b6179055659332e256fba94"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 9: Clear FCSR Cause field before every FP arithmetic instruction. r=spidermonkey-reviewers,jandem\n\nPer ISA manual:\n\n        28:24\tCause\tRW\tThe VZOUI exception caused by the last\n        floating-point operation.\n\nThus it is needed to clear the Cause field before arithmetic\ninstructions. Per in silica experimentation, all instructions except\nFMOV, FABS, FNEG, FSEL, FCOPYSIGN families that only perform bit\nmanipulation.\n\nLink:\n https://loongson.github.io/LoongArch-Documentation/LoongArch-Vol1-EN.html#definitions-of-fcsr0-register-fields\n (\"LoongArch Reference Manual Volume 1, Table 6. Definitions of FCSR0\n Register Fields\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327578\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "072115f2e82e8c81341e3c085375e3896f529492", "git_parents": ["c37d973c8dc1dc37279369fbd5b598a8fe87ca4f"], "node": "1a4d8029412de5f85d9c0b3bdd62b9faed6d297d", "parents": ["aadfe49c237cf0b68e9758814562b5caa3e5af24"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 10: Extract FCSR {Cause/Flags} bit setter into a method. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327579\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "67dae264bcceba2cb639c1018a7d07f604fff3b9", "git_parents": ["072115f2e82e8c81341e3c085375e3896f529492"], "node": "6657760767578901d8266e11e9883da74f67bf65", "parents": ["1a4d8029412de5f85d9c0b3bdd62b9faed6d297d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 11: Add trivial FCSR bits behavior and document the rest. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327580\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "a1edefe991e2e07a36d3ad9124600fbecdb0867a", "git_parents": ["67dae264bcceba2cb639c1018a7d07f604fff3b9"], "node": "4a98445a2e21c9584cdf2f93e1842cea3b573e33", "parents": ["6657760767578901d8266e11e9883da74f67bf65"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073747 - [loong64] Part 12: Remove stale MIPS64 leftovers from Loong64 simulator. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327581\n", "files": ["js/src/jit/loong64/Architecture-loong64.h", "js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "b8f001f993e75ab66172b319414827d2861ef6be", "git_parents": ["a1edefe991e2e07a36d3ad9124600fbecdb0867a"], "node": "c9e09d11f30a98822fb791165a7e2c2f644a49ae", "parents": ["4a98445a2e21c9584cdf2f93e1842cea3b573e33"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073769 - [loong64] Part 1: Reserve $f22 ($ft14) as a new FPU scratch register. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327582\n", "files": ["js/src/jit/loong64/Architecture-loong64.h", "js/src/jit/loong64/Assembler-loong64.h"], "git_node": "787d45cfe2b4468e55505234dd27caf79dffe206", "git_parents": ["b8f001f993e75ab66172b319414827d2861ef6be"], "node": "a422e30073edfce12745b84e42bb03241f8bb8fd", "parents": ["c9e09d11f30a98822fb791165a7e2c2f644a49ae"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073769 - [loong64] Part 2: Fix minMax{Double,Float32} for stricter IEEE 754-2008 compliance. r=spidermonkey-reviewers,jandem\n\nIEEE 754-2008 does not mandate the sign of the result of {min,max}Num:\n\n        minNum(x, y) is the canonicalized number x if x \u003c y, y if y \u003c x,\n        the canonicalized number if one operand is a number and the other\n        a quiet NaN. Otherwise it is either x or y, canonicalized (this\n        means results might differ among implementations).\n\nLoongArch ISA claims that the F{MIN,MAX}.[SD] implements this standard,\nso we need to fix up the result to the correct sign when needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327583\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "9fcfceafafca9109a04a9afc50586f97e4b6d326", "git_parents": ["787d45cfe2b4468e55505234dd27caf79dffe206"], "node": "65935223a058c93df47d1368d36d33432d62b120", "parents": ["a422e30073edfce12745b84e42bb03241f8bb8fd"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073769 - [loong64] Part 3: Use range analysis to elide {min,max}{Float32,Double} zero fixup when applicable. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327584\n", "files": ["js/src/jit/MacroAssembler.h", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "ac4698b70dcff90ae1b5cac1790ab568270c0b02", "git_parents": ["9fcfceafafca9109a04a9afc50586f97e4b6d326"], "node": "f53a8153a32910a19911704f9c47523454f57768", "parents": ["65935223a058c93df47d1368d36d33432d62b120"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073796 - [loong64] Implement and enable nearbyInt{Double,Float32}. r=spidermonkey-reviewers,jandem\n\nA related test is updated to reflect the new reality that WASM\n{f32,f64}.{ceil,floor,trunc,nearest} on Loong64 no longer call into C++.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327601\n", "files": ["js/src/jit-test/tests/wasm/profiling.js", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "980445b3d32ff56be251f5a6566467edbb3bc561", "git_parents": ["ac4698b70dcff90ae1b5cac1790ab568270c0b02"], "node": "71c813102932f05e70e0ced18db54a6999180f16", "parents": ["f53a8153a32910a19911704f9c47523454f57768"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073865 - [riscv64] Part 1: Fix WASM epilogue structure on riscv64. r=rhunt,spidermonkey-reviewers\n\nThe original epilogue structure is rather inexplicable, including\nmisplaced *ret=, strange nop, unreasonably-large pool forbidden zone,\netc. Clean them up here.\n\nRelated test harness is updated to match the new epilogue shape.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327681\n", "files": ["js/src/jit-test/lib/codegen-riscv64-test.js", "js/src/wasm/WasmFrameIter.cpp"], "git_node": "8a2cac5a35b643f3a2429dfa268e5fc916c061a5", "git_parents": ["980445b3d32ff56be251f5a6566467edbb3bc561"], "node": "2d644f9f2721e04789e58063d3d454d42ca68eb4", "parents": ["71c813102932f05e70e0ced18db54a6999180f16"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073865 - [riscv64] Part 2: Fix transient intermediate $ra value in CollapseWasmFrameSlow. r=rhunt,spidermonkey-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327682\n", "files": ["js/src/jit/MacroAssembler.cpp"], "git_node": "64bfe31f9932ac1206d48b00ea40afd8cb8eb063", "git_parents": ["8a2cac5a35b643f3a2429dfa268e5fc916c061a5"], "node": "f70497eb52245c4e39560cad1561b8499740871d", "parents": ["2d644f9f2721e04789e58063d3d454d42ca68eb4"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073865 - [riscv64] Part 3: Implement link register-based trampoline for riscv64 in MakeReturnCallTrampoline. r=rhunt,spidermonkey-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327683\n", "files": ["js/src/jit/MacroAssembler.cpp"], "git_node": "374282de1fd2d9eb38ce56dc5d11365ac61e44a3", "git_parents": ["64bfe31f9932ac1206d48b00ea40afd8cb8eb063"], "node": "d034c65c0e02f92678aff464604e853e4904deed", "parents": ["f70497eb52245c4e39560cad1561b8499740871d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073865 - [riscv64] Part 4: Enable single-step profiling on riscv64-simulator. r=spidermonkey-reviewers,jandem\n\nA related test is updated to account for the enablement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327684\n", "files": ["js/src/jit-test/tests/wasm/profiling.js", "js/src/shell/js.cpp", "js/src/shell/jsshell.h"], "git_node": "6842d443819b886b29c99c3e39ca54f42c85b3d3", "git_parents": ["374282de1fd2d9eb38ce56dc5d11365ac61e44a3"], "node": "ce2c26efa573c0fc482a770df949389b9c3ceacb", "parents": ["d034c65c0e02f92678aff464604e853e4904deed"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2073747, 2073769, 2073796, 2073865: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "0d9536f719ef863d5b7f3d43bbd5316625633dd2", "git_parents": ["6842d443819b886b29c99c3e39ca54f42c85b3d3"], "node": "9925a2e2e94ab41dc7ad7752be37fa99d1c82f2b", "parents": ["ce2c26efa573c0fc482a770df949389b9c3ceacb"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074373 - Don't crash in nsSHistory::Reload if mIndex = -1. r=farre\" for causing mochitests failures in browser_ghistorymaxsize_is_0.js.\n\nThis reverts commit 27c23d91c88145629548efd040138e596a355639.\n", "files": ["docshell/shistory/nsSHistory.cpp", "docshell/test/navigation/browser.toml", "docshell/test/navigation/browser_ghistorymaxsize_is_0.js", "docshell/test/navigation/file_never_responds.sjs"], "git_node": "0c4dd5224b3e0f8580fde277ad616e40e3f62169", "git_parents": ["0d9536f719ef863d5b7f3d43bbd5316625633dd2"], "node": "30577580a0f5ae6b1ae6686dcaaddf6a8bc48b2e", "parents": ["9925a2e2e94ab41dc7ad7752be37fa99d1c82f2b"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074501 - IndexedDB: update obsolete comment in Key::EncodeBinary. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328150\n", "files": ["dom/indexedDB/Key.cpp"], "git_node": "a01b83accf0d04975692591e4bdf15fd66b43e85", "git_parents": ["0c4dd5224b3e0f8580fde277ad616e40e3f62169"], "node": "34c82f1a7d4d8b26d9a67c49685a9b518aaf4dac", "parents": ["30577580a0f5ae6b1ae6686dcaaddf6a8bc48b2e"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070169 - [devtools] Use declaration substituted value to check registered property declaration validity. r=devtools-reviewers,ochameau.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326953\n", "files": ["devtools/client/inspector/rules/test/browser_rules_registered-custom-properties.js", "devtools/server/actors/style-rule.js"], "git_node": "df863ef87e391a0d07ccd3f0bd73e2affdcdb158", "git_parents": ["a01b83accf0d04975692591e4bdf15fd66b43e85"], "node": "816540cf3781cc3e0b87fe03ebd0bb8bfb697361", "parents": ["34c82f1a7d4d8b26d9a67c49685a9b518aaf4dac"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2073401 - Ensure Restore from Backup button is shown in about:welcome if easy setup page doesn't show r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328301\n", "files": ["browser/components/aboutwelcome/modules/AboutWelcomeDefaults.sys.mjs", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multistage_languageSwitcher.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multistage_mr.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_screen_targeting.js"], "git_node": "1cf696e447f53b27fc80c7bcc2ebbe3a9375723c", "git_parents": ["df863ef87e391a0d07ccd3f0bd73e2affdcdb158"], "node": "c04a993ec325ada0bcaaf80a74919957828acbfa", "parents": ["816540cf3781cc3e0b87fe03ebd0bb8bfb697361"], "tags": []}, {"author": "Nan Jiang \u003cnjiang028@gmail.com\u003e", "branch": "default", "desc": "Bug 2072845 - Extend suggest_relevance metrics to 170 r=adw,urlbar-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327855\n", "files": ["browser/components/urlbar/metrics.yaml"], "git_node": "9effb79dcb2c188842ccfa91eb918e858a519608", "git_parents": ["1cf696e447f53b27fc80c7bcc2ebbe3a9375723c"], "node": "b2ad9ddeacf87bd97d0956075907a168c84ecbb0", "parents": ["c04a993ec325ada0bcaaf80a74919957828acbfa"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067697 - Fix fragility of toggling between vertical and horizontal tabs r=sessionstore-reviewers,sidebar-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328223\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_vertical_tabs_restore_last_window.js"], "git_node": "dc08e8d52a62e60aaa54636c20cc99795f143fdb", "git_parents": ["9effb79dcb2c188842ccfa91eb918e858a519608"], "node": "0544453e8cea06f3be84902485b15418a30f4fad", "parents": ["b2ad9ddeacf87bd97d0956075907a168c84ecbb0"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1926318 - Use correct Policy-Container for javascript: documents. r=necko-reviewers,valentin,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328074\n", "files": ["dom/jsurl/nsJSProtocolHandler.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/TRRLoadInfo.cpp", "netwerk/base/nsILoadInfo.idl", "testing/web-platform/meta/content-security-policy/inheritance/inheritance-from-initiator.sub.html.ini"], "git_node": "8e238cf525b2da229dd2996fb2f105fb233bd88a", "git_parents": ["dc08e8d52a62e60aaa54636c20cc99795f143fdb"], "node": "1917a221cbb35ba2f391411e421fa632fb01d6f1", "parents": ["0544453e8cea06f3be84902485b15418a30f4fad"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1607766 - Register the action delegate before posting the port message in ExtensionActionTest. r=geckoview-reviewers,ohall\n\ntestActionApi and testBackgroundActionApi post the message that makes the extension change its action, then\nregister the ActionDelegate that waits for the resulting update. The update comes back through a content\nscript and the background script within a few milliseconds; when the UI thread is preempted for longer than\nthat, the session dispatcher has no listener yet and discards the update (\"No listener for\nGeckoView:BrowserAction:Update\" in logcat), so the wait times out after 30 seconds. Register the delegate\nfirst.\n\nFor the background variant this also orders the attach-triggered default update ahead of the real one, which\nthe counter check in the delegate already assumes.\n\nGeckoSessionTestRule now says so in the addExternalDelegateDuringNextWait docs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328322\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ExtensionActionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java"], "git_node": "36df756d3a89ccf314f3e8cb0d6114aa4cef5ba7", "git_parents": ["8e238cf525b2da229dd2996fb2f105fb233bd88a"], "node": "1d364a9c8ae2122099e02c3ab49003a727e20a6c", "parents": ["1917a221cbb35ba2f391411e421fa632fb01d6f1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064852 - Trigger the tabs-remove extension from testBrowserTabsRemove after its TabDelegate is registered. r=geckoview-reviewers,ohall\n\nThe tabs-remove background script calls tabs.remove as soon as it starts, and installBuiltIn can resolve after\nthat call has already reached Java. With no SessionTabDelegate registered yet, WebExtensionController.closeTab\ndenies the request (\"tabs.remove is not supported\") and nothing retries, so the test waits out its timeout.\nMake the extension wait for a message over a native port, and send it once the delegate is in place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328323\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/tabs-remove/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/tabs-remove/manifest.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebExtensionTest.kt"], "git_node": "8637594d9a868f6bc92d94a4d04244b59eaa3ad7", "git_parents": ["36df756d3a89ccf314f3e8cb0d6114aa4cef5ba7"], "node": "79784e3bb5f12fb5939cf3e158d38762041c7ab0", "parents": ["1d364a9c8ae2122099e02c3ab49003a727e20a6c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1607766 - Compare WebExtension ids rather than instances in extension delegate assertions. r=geckoview-reviewers,ohall\n\nWebExtension has no equals(), and the controller's extension store hands delegates whichever instance it holds\nfor an id. That instance is replaced on every list, enable, disable and update, and an action or tab event\nthat reaches the store between an uninstall and the next install's registration makes it fetch and cache a\nfresh copy that can land after the installed one. testPopupsCanCloseThemselves and testPopupMessaging then saw\na different instance for the same extension in onTogglePopup and failed; the tabs.create and tabs.remove\ndelegate assertions in WebExtensionTest rely on the same identity. Compare ids instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328325\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ExtensionActionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebExtensionTest.kt"], "git_node": "c94f03f23a135471b5a57056f5ed497bd80bc58e", "git_parents": ["8637594d9a868f6bc92d94a4d04244b59eaa3ad7"], "node": "76c69c35bcab016d41c3d2274c4ef27afa1135c2", "parents": ["79784e3bb5f12fb5939cf3e158d38762041c7ab0"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074039. Print an error to the log if the reftest window never gets focus at the start of a run. r=layout-reviewers,dshin\n\nThis helps diagnose issues like bug 2073762.\n\nnsFocusManager only dispatches focus events to the active window, so if our\nwindow never becomes active (a locked screen does this, bug 2073762) the\nlistener that starts the run never fires and we sit there until the harness\ntimes out with no output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327777\n", "files": ["layout/tools/reftest/globals.sys.mjs", "layout/tools/reftest/reftest.sys.mjs"], "git_node": "080656a0e741b7f4dda41ead7790d3e5ebeaa3a1", "git_parents": ["c94f03f23a135471b5a57056f5ed497bd80bc58e"], "node": "695d53cc48cab2d7e24e473dd917bbae9a9ce622", "parents": ["76c69c35bcab016d41c3d2274c4ef27afa1135c2"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064392 - Fix opener-after-user-interaction heuristic being run inconsistently r=timhuang\n\nThis change fixes work done with bug 1959656. The change\ncauses MaybeAllowStorageForOpenerAfterUserInteraction() to not\nbe called anymore in most circumstances.\n\nThe opener-after-user-interaction heuristic should work\nregardless of prior interaction state of the site, except\nin cases where the site is listed in the pref\nuserInteractionRequiredForHosts. For those sites we need\nto store the interaction state beforehand. So store it\nand pass it as a parameter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319468\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "toolkit/components/antitracking/StorageAccessAPIHelper.cpp", "toolkit/components/antitracking/StorageAccessAPIHelper.h", "toolkit/components/antitracking/test/browser/browser.toml", "toolkit/components/antitracking/test/browser/browser_openerAfterUserInteractionHeuristic.js", "toolkit/components/antitracking/test/browser/browser_storageAccessThirdPartyChecks.js"], "git_node": "2f48e2754b47fbb67d7252d7cf7273766fa20792", "git_parents": ["080656a0e741b7f4dda41ead7790d3e5ebeaa3a1"], "node": "39df4bee0232a8392a38ece4f0fcf1eb24abf837", "parents": ["695d53cc48cab2d7e24e473dd917bbae9a9ce622"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Add the always-on-top mini window component behind a pref. r=mconley,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322131\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/moz.build", "browser/components/moz.build", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/tabbrowser/content/tab-bar-visibility.js", "browser/modules/BrowserDOMWindow.sys.mjs", "browser/modules/BrowserWindowTracker.sys.mjs", "browser/modules/URILoadingHelper.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "08aa7e807b2cf18b76f65ffd9c06488683c6452f", "git_parents": ["2f48e2754b47fbb67d7252d7cf7273766fa20792"], "node": "0ce267ee317ce5d83d35531954fe21815376f3e3", "parents": ["39df4bee0232a8392a38ece4f0fcf1eb24abf837"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Exclude mini windows from the messaging system. r=omc-reviewers,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322133\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/InfoBar.sys.mjs"], "git_node": "f290c2c679060268b78081f5ca0f0c048d478d7f", "git_parents": ["08aa7e807b2cf18b76f65ffd9c06488683c6452f"], "node": "85f5f1becf09d2523609a40df41de5043aef1fd8", "parents": ["0ce267ee317ce5d83d35531954fe21815376f3e3"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Return mini windows when the origin window's last tab is closed. r=mconley,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322134\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "186a4d739900ac360680688247abec9683a3f9dc", "git_parents": ["f290c2c679060268b78081f5ca0f0c048d478d7f"], "node": "782f7c250fa9bd094320b3354c16b9dfec4d6d52", "parents": ["85f5f1becf09d2523609a40df41de5043aef1fd8"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Reuse and restyle the nav-bar as the mini window chrome. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322135\n", "files": ["browser/base/content/browser.xhtml", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/locales-preview/miniWindow.ftl", "browser/locales/jar.mn", "browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css", "browser/themes/shared/urlbar.css"], "git_node": "2984a645cba42de8f28cd53f9711f4aa85cb9f7f", "git_parents": ["186a4d739900ac360680688247abec9683a3f9dc"], "node": "c56452275cba9947c7c5c0e84b87608242ed45a5", "parents": ["782f7c250fa9bd094320b3354c16b9dfec4d6d52"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Add browser-chrome tests for mini window. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322137\n", "files": ["browser/components/miniwindow/moz.build", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_last_tab.js", "browser/components/miniwindow/test/browser/browser_open_close.js", "browser/components/miniwindow/test/browser/browser_origin_close.js", "browser/components/miniwindow/test/browser/browser_placement.js", "browser/components/miniwindow/test/browser/browser_restore_vs_close.js", "browser/components/miniwindow/test/browser/browser_reveal.js", "browser/components/miniwindow/test/browser/browser_sessionstore.js", "browser/components/miniwindow/test/browser/browser_toolbar.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/miniwindow/test/browser/mini-window-crop-target.html", "browser/components/miniwindow/test/browser/mini-window-redirect.html", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "browser/components/miniwindow/test/xpcshell/xpcshell.toml"], "git_node": "c0e5bcb441e33c4cd37be76bfc0b248a274d4b60", "git_parents": ["2984a645cba42de8f28cd53f9711f4aa85cb9f7f"], "node": "033e7450cc0552001ad046ad04fa3c472d953a05", "parents": ["c56452275cba9947c7c5c0e84b87608242ed45a5"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Add the Screenshots mini-window mode and toolbar button. r=mconley,fluent-reviewers,bolsson,niklas,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322138\n", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsSelectionModes.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "browser/components/screenshots/moz.build", "browser/components/screenshots/overlay/overlay.css", "browser/components/screenshots/overlayHelpers.mjs", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/toolbarbutton-icons.css", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "89ef2d1d68c423f71973ea7ce33e1b13fc7384b9", "git_parents": ["c0e5bcb441e33c4cd37be76bfc0b248a274d4b60"], "node": "1592ac04418a5ffa0616b3b4aa7d8b07894d3e76", "parents": ["033e7450cc0552001ad046ad04fa3c472d953a05"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Add a Use Mini Window item to the content context menu. r=mconley,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323857\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/webext-panels.xhtml", "browser/locales-preview/miniWindow.ftl"], "git_node": "ce83fece2540005e9d334724601e42ce0162ca66", "git_parents": ["89ef2d1d68c423f71973ea7ce33e1b13fc7384b9"], "node": "c5ea5732f4b660803cb9f854a6ef8578efe62ed4", "parents": ["1592ac04418a5ffa0616b3b4aa7d8b07894d3e76"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Test the mini window screenshots entry points. r=mconley,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322139\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_region_entry.js", "browser/components/miniwindow/test/browser/browser_toolbar_button.js", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/screenshots/tests/browser/browser_mini_window_mode.js"], "git_node": "d05913cdc38380aaeeb4d39afc27e490afe7181d", "git_parents": ["ce83fece2540005e9d334724601e42ce0162ca66"], "node": "2ebbf49153ac85b4250a08be1b62374ee98bc3cc", "parents": ["c5ea5732f4b660803cb9f854a6ef8578efe62ed4"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Separate cropped and full tab mini windows. r=mconley,fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,dao,sfoster,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323858\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_open_close.js", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/toolbarbuttons.css"], "git_node": "d961adfd742beb7cc80968eb08f88ae94f8acfd7", "git_parents": ["d05913cdc38380aaeeb4d39afc27e490afe7181d"], "node": "d82dd32ac1df0cc49dff37fb7677dde4aed2272e", "parents": ["2ebbf49153ac85b4250a08be1b62374ee98bc3cc"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Return a cropped mini window's tab home when it navigates away. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323859\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "f29579c06082464664ddae00ab0b1630f0681643", "git_parents": ["d961adfd742beb7cc80968eb08f88ae94f8acfd7"], "node": "f3bc750b35cec7ede45da2c0d10c2d007209568c", "parents": ["d82dd32ac1df0cc49dff37fb7677dde4aed2272e"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Test the mini window flavors. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323860\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_cropped_navigation.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/head.js"], "git_node": "85829e5ddd8ca7d5f066ed05e1d8ec2bd64d026e", "git_parents": ["f29579c06082464664ddae00ab0b1630f0681643"], "node": "e074baea5030f3cdb687f7916d467aa44a2a06c4", "parents": ["f3bc750b35cec7ede45da2c0d10c2d007209568c"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Restyle the mini window toolbar and suppress its sidebar. r=mconley,sidebar-reviewers,sfoster\n\nTwo bits of chrome polish that were still following the ordinary browsing\nwindow:\n\nThe reused nav-bar took its colour from the theme, which made a mini window\nread as a shrunken browsing window rather than its own surface. Pin it to\nwhite in light mode and #252428 in dark, active and inactive alike. Left alone\nunder forced colours: HCM users choose their own background, so the system\ncolours the toolbox tokens already carry are the right answer there.\n\nThe sidebar still initialised, because SidebarController.inSingleTabWindow only\nknew about Taskbar Tabs and mini windows deliberately keep toolbar.visible\ntrue. A mini window holds one tab and hides the app menu, so the sidebar and\nits launcher have nothing to offer there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325080\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_sidebar.js", "browser/components/sidebar/browser-sidebar.js", "browser/themes/shared/browser-shared.css"], "git_node": "4dc82ccdbaaa49118d30c75c7cc5f57a95de273c", "git_parents": ["85829e5ddd8ca7d5f066ed05e1d8ec2bd64d026e"], "node": "54a2e784fbababae982d9ecba93f00cb0a4ac997", "parents": ["e074baea5030f3cdb687f7916d467aa44a2a06c4"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Add a mute button to the mini window nav-bar. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson\n\nA mini window can be playing audio with no way to silence it: the tab strip's\naudio button isn't there, and the app menu is hidden. Add a button beside the\nput-tab-back control that mirrors the tab's sound state and toggles mute,\nusing the same icons the tab strip does.\n\nIt only appears while there is sound to mute, or while the tab is already\nmuted and needs a way back, so an ordinary mini window is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325081\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "f15a27950df1ebb7b3349e2ef39fa7cb4902e425", "git_parents": ["4dc82ccdbaaa49118d30c75c7cc5f57a95de273c"], "node": "dd891bc3d21d37d82e3a1b220ddc735821f979b0", "parents": ["54a2e784fbababae982d9ecba93f00cb0a4ac997"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Re-frame a mini window's crop from a ResizeObserver. r=mconley\n\nThe crop was re-framed from the window's resize event, and each pass read\nminiWin.innerWidth to do it. That read can force a synchronous layout flush,\nand resize fires continuously while a window edge is dragged, so the flush\nlanded on every event of the drag.\n\nA ResizeObserver carries the new size in its observation, so there is nothing\nto read back, and the engine batches observations per frame - a drag now costs\none re-frame per frame rather than one per event. #applyTransform still falls\nback to a non-flushing read for its other caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325228\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs"], "git_node": "b3bae43a6427abc2eb7cfac39f4f7e01a90567bd", "git_parents": ["f15a27950df1ebb7b3349e2ef39fa7cb4902e425"], "node": "5ddccecfb00b8f7c82a42298eb2111eb2eb7f66c", "parents": ["dd891bc3d21d37d82e3a1b220ddc735821f979b0"], "tags": []}, {"author": "Nikolas Wipper \u003cnwipper@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073196 - Recreate the disk cache's key when it cannot be read r=valentin,simonf,necko-reviewers\n\nThe DEK was created only when listDeks() did not have it, so getDek() failing\nfor any other reason -- most importantly a DEK the keystore will not hand back\nunder the KEK the cache asks for, which is what a changed kek_ref leaves behind\n-- left the session with browser.cache.disk.encryption.enabled on and no\ncipher. That is worse than having encryption off, since\nCacheFile::SetupEncryption then fails every new entry closed and the disk cache\nstops working altogether.\n\nAsk for the DEK first and, when it cannot be read, delete whatever is there and\ncreate a new key. Nothing has to be purged: metadata that fails to decrypt\nmakes CacheFile reinitialize the entry, so what the previous key encrypted is\ndropped as it is read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327075\n", "files": ["netwerk/cache2/CacheCrypto.cpp", "netwerk/docs/cache2/doc.md"], "git_node": "4922ca740ba85a3bf4b0fea7daf2e452915849ed", "git_parents": ["b3bae43a6427abc2eb7cfac39f4f7e01a90567bd"], "node": "b5f423bb6e7c0f7f8ebb5aec10f996eb3de66ebe", "parents": ["5ddccecfb00b8f7c82a42298eb2111eb2eb7f66c"], "tags": []}, {"author": "Nikolas Wipper \u003cnwipper@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073204 - Rename the disk cache's KEK identifier to \"profile\" r=simonf,necko-reviewers,valentin\n\nThe KEK is shared with the rest of the profile's encrypted storage, so name it\nafter the profile rather than after encryption.\n\nThe identifier is part of the kek_ref persisted in the DEK's metadata, so this\nstrands the key in profiles that already have one wrapped under\n\"profileEncryption\". The key load recreates it on the next startup, at the cost\nof what the old key encrypted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327076\n", "files": ["netwerk/cache2/CacheCrypto.cpp", "netwerk/docs/cache2/doc.md"], "git_node": "a2df7f30b62aad942dd83f20cae9e31433382d9e", "git_parents": ["4922ca740ba85a3bf4b0fea7daf2e452915849ed"], "node": "1e80613ca03d113f2de6e4b5010932920e7d7bd3", "parents": ["b5f423bb6e7c0f7f8ebb5aec10f996eb3de66ebe"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070659 - upgrade NSS to NSS_3_130_RTM. r=nss-reviewers,djackson UPGRADE_NSS_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328481\n", "files": ["security/nss/TAG-INFO", "security/nss/cmd/selfserv/selfserv.c", "security/nss/doc/src/releases/index.md", "security/nss/doc/src/releases/nss_3_130.md", "security/nss/gtests/pk11_gtest/pk11_pbkdf2_unittest.cc", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h", "security/nss/moz.yaml", "security/nss/tests/chains/chains.sh", "security/nss/tests/common/cleanup.sh", "security/nss/tests/common/init.sh", "security/nss/tests/ssl/ssl.sh"], "git_node": "a9c7b2e86a4f972e56f662fbfb3e1c1d83f6f0bd", "git_parents": ["a2df7f30b62aad942dd83f20cae9e31433382d9e"], "node": "33387270b6d5f94f7d44def30e0393c82e69258c", "parents": ["1e80613ca03d113f2de6e4b5010932920e7d7bd3"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057242 - Rename logging prefixes for ip-protection r=ip-protection-reviewers,apopov\n\nI want to unify the prefixes we use for IPP logging, so it's easy to grep for them in logfiles & traces\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314702\n", "files": ["toolkit/components/ipprotection/GuardianTypes.sys.mjs", "toolkit/components/ipprotection/IPPNetworkUtils.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/IPProtectionServerlist.sys.mjs", "toolkit/components/ipprotection/enterprise/IPPAlwaysOn.sys.mjs", "toolkit/components/ipprotection/enterprise/IPPEnterpriseAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs"], "git_node": "092b4f4e13adcff0850e3874bb0341e2437dab11", "git_parents": ["a9c7b2e86a4f972e56f662fbfb3e1c1d83f6f0bd"], "node": "450420636eb68e56a84ff8aa94d3a3d798536186", "parents": ["33387270b6d5f94f7d44def30e0393c82e69258c"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057242 - Add GeckoViewUtils.initLoggingConsole r=geckoview-reviewers,owlish\n\ninitLoggingConsole() mirrors initLogging(), but forwards to a ConsoleInstance\nnamed GeckoView.\u003cTag\u003e, so a module gets about:logging capture with stack traces\nwithout hand-rolling console.createInstance(). Interpolated values are passed as\nseparate console arguments to keep logged objects inspectable.\n\nUnlike initLogging() it is not tied to the geckoview.logging pref, which holds\n\"Fatal\" when logging is off and is therefore not a valid ConsoleLogLevel; the\nMOZ_LOG module gates debug output instead.\n\nGeckoViewIPProtection opts in; its MOZ_LOG module name changes from\nGeckoViewIPProtection to GeckoView.IPProtection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314703\n", "files": ["mobile/shared/modules/geckoview/GeckoViewIPProtection.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewUtils.sys.mjs"], "git_node": "bf90fc9976e2710a60029daaafb5fa9694839c63", "git_parents": ["092b4f4e13adcff0850e3874bb0341e2437dab11"], "node": "bc13af0a41b79dcf0b2a827b8a04185c28efef95", "parents": ["450420636eb68e56a84ff8aa94d3a3d798536186"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057242 - Add a Preset for about:logging for the VPN feature r=canova,fluent-reviewers,profiler-reviewers,bolsson\n\nThis adds a preset for the IP_Protection / Firefox-VPN feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314704\n", "files": ["toolkit/content/aboutLogging/aboutLogging.mjs", "toolkit/locales/en-US/toolkit/about/aboutLogging.ftl"], "git_node": "bcba73dcf3a0223b0ab4cd65df48842a67cb8c60", "git_parents": ["bf90fc9976e2710a60029daaafb5fa9694839c63"], "node": "a6dd131e2e6b660d4dea9ac834c2b8645378f4f0", "parents": ["bc13af0a41b79dcf0b2a827b8a04185c28efef95"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057242 - allow about:logging presets to pre-check Javascript-Tracing r=canova,profiler-reviewers\n\nFor the VPN preset, if Javascript Tracing is disabled, important pieces are not logged.\nSo i'd like to add the option for a preset, so it's auto-checked when selecting it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314705\n", "files": ["toolkit/content/aboutLogging/aboutLogging.mjs", "toolkit/content/tests/browser/browser_about_logging.js"], "git_node": "174b5b3a4cb53445f724e64e63ea721f360a84c8", "git_parents": ["bcba73dcf3a0223b0ab4cd65df48842a67cb8c60"], "node": "a96cd9fc6c227d58126aca29ff44168207e9aeca", "parents": ["a6dd131e2e6b660d4dea9ac834c2b8645378f4f0"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064404 - Accelerate early 'events' pings in FOG r=chumphreys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326741\n", "files": ["toolkit/components/glean/src/init/mod.rs", "toolkit/components/glean/tests/test_metrics.yaml", "toolkit/components/glean/tests/xpcshell/test_FOGInit.js"], "git_node": "67b32ba422d423c51e69807a19c15c96dd1d7f6f", "git_parents": ["174b5b3a4cb53445f724e64e63ea721f360a84c8"], "node": "6aa9919454fa4a531b51ef841fded41199e982ae", "parents": ["a96cd9fc6c227d58126aca29ff44168207e9aeca"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072592 - Add a grace period for negative DNS cache entries r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328157\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/dns/nsHostResolver.cpp", "netwerk/test/unit/test_dns_negative_grace.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "529ed25e6d92de473b866927f4cf624419769ed5", "git_parents": ["67b32ba422d423c51e69807a19c15c96dd1d7f6f"], "node": "192c57aa765f608c61390ee85063a80d5b88a468", "parents": ["6aa9919454fa4a531b51ef841fded41199e982ae"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072592 - Forward the stale-cache flag for negative DNS answers to Happy Eyeballs state machine, r=necko-reviewers,valentin\n\nDepends on D328157\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328158\n", "files": ["netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/test/unit/test_happy_eyeballs_negative_optimistic_dns.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "7d9725ea0765c03f29abcdf1888d14e39cf8092b", "git_parents": ["529ed25e6d92de473b866927f4cf624419769ed5"], "node": "5eb4bd40584f00e2f2380ea4193a0fd55e50817c", "parents": ["192c57aa765f608c61390ee85063a80d5b88a468"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjan-ivar@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067816 - Store desktop capture sources in an nsTArray instead of a map. r=pehrsons\n\nNothing ever looks a source up by key. The only consumers are\nNumberOfDevices() and GetDeviceName(index), so getSource() walked the map with\nstd::advance, making enumeration O(n^2).\n\nThe key was also the wrong shape. Screens and windows are keyed by SourceId,\nan intptr_t, while tabs are keyed by browserId. GenerateProcessSpecificId\npacks the content process id into the bits above kIdBits = 31, so the first\nbrowserId minted in any content process is already INT32_MAX + 1 and every\nlater one is larger. AssertedCast\u003cintptr_t\u003e therefore crashed 32-bit debug\nbuilds while enumerating tab capture sources. Bug 1962571 was the same value\noverflowing std::stoi.\n\nOrdering by that key bought nothing and cost something. getAllVisibleTabs()\nreturns tabs in window and tab-strip order, and the map regrouped them by\ncontent process. Screens and windows were ordered by display index or native\nhandle, which is arbitrary. Sources now come out in the order the platform\nenumerated them.\n\nThis drops the duplicate-id assertions. Duplicate browser ids would be a bug\nin id allocation, not something this code should police.\n\nNo new test: browser_devices_get_user_media_document_pip.js already covers\nthis. It opens a document picture-in-picture window from content, which puts\na content-allocated top-level browsing context in the visible tab list, and\ncrashed win32 debug before this change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328300\n", "files": ["dom/media/systemservices/video_engine/desktop_device_info.cc"], "git_node": "5e3436479eb74175777d4882cf9f439158e9bfcf", "git_parents": ["7d9725ea0765c03f29abcdf1888d14e39cf8092b"], "node": "666e26c9f7199e9beaa297ff7980bb46d9945cdc", "parents": ["5eb4bd40584f00e2f2380ea4193a0fd55e50817c"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjan-ivar@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067816 - Anchor the screen-sharing prompt in the document PiP window when it has focus. r=emz\n\nWhen a site calls opener.navigator.mediaDevices.getDisplayMedia() from a\ndocument picture-in-picture window, the prompt went to the opener's tab. The\nPiP window has focus, so PopupNotifications suppressed the panel and nothing\nappeared until the user refocused the opener tab.\n\nShow the prompt in the PiP window instead, matching Chrome. Only the UI moves:\npermissions, grace periods and indicators stay keyed on the opener's browser,\nwhich owns the stream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322793\n", "files": ["browser/actors/WebRTCParent.sys.mjs", "browser/base/content/test/browser-webrtc/browser_devices_get_user_media_tear_off_tab.js"], "git_node": "3b1a1e797208e01aa03022ddff6b3c40ec9a2dd1", "git_parents": ["5e3436479eb74175777d4882cf9f439158e9bfcf"], "node": "c201c092c2b9b22f94d45ef4cc7e559cabf371e4", "parents": ["666e26c9f7199e9beaa297ff7980bb46d9945cdc"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjan-ivar@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067816 - Test screen-sharing prompt placement with a document PiP window. r=emz\n\nCovers the four cases getPromptBrowser() distinguishes: a screen request on the\nopener with the PiP focused prompts in the PiP; on the PiP itself it prompts in\nthe PiP; on the opener with the opener focused it prompts in the opener; and a\ncamera request is never redirected.\n\nCapture is requested through a helper injected into the PiP document, because\ncalling getDisplayMedia() from the SpecialPowers sandbox is a privileged call\nthat skips the prompt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322794\n", "files": ["browser/base/content/test/browser-webrtc/browser.toml", "browser/base/content/test/browser-webrtc/browser_devices_get_user_media_document_pip.js", "browser/base/content/test/browser-webrtc/head.js"], "git_node": "3887d333bb41ece8a622fb0a1332c37433a98d7c", "git_parents": ["3b1a1e797208e01aa03022ddff6b3c40ec9a2dd1"], "node": "046ca93e376350fc7abf42b91791619cc34b0a6d", "parents": ["c201c092c2b9b22f94d45ef4cc7e559cabf371e4"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjan-ivar@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067816 - Deny a pending screen-sharing request when its document PiP window closes. r=emz\n\nClosing a window tears its tabs down without firing TabClose, so\nPopupNotifications never fires the removal callback that cancels the webRTC\nrequest. That went unnoticed for prompts in a tab, because closing a tab\ndestroys the requesting window too.\n\nA prompt anchored in a document PiP window is requested by the opener, which\noutlives the PiP. So the site was left holding a getDisplayMedia() promise\nthat never settled.\n\nWatch for unload on the PiP window while the prompt is up, and deny there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324753\n", "files": ["browser/actors/WebRTCParent.sys.mjs", "browser/base/content/test/browser-webrtc/browser_devices_get_user_media_document_pip.js"], "git_node": "74d2e27624b796cb316199b78774d203262fe2a2", "git_parents": ["3887d333bb41ece8a622fb0a1332c37433a98d7c"], "node": "594561e9592d6dbf47dbeb9d7f45475c29411bfa", "parents": ["046ca93e376350fc7abf42b91791619cc34b0a6d"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjan-ivar@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067816 - Keep the screen-sharing prompt in the opener while it's in DOM fullscreen. r=emz\n\nbrowser-fullScreenAndPointerLock.js exits fullscreen when a permission prompt\nshows, and cancels pending prompts when fullscreen is entered. Both only look\nat their own window's PopupNotifications, so neither would apply to a prompt\nanchored in a document PiP window.\n\nDon't redirect while the opener is in DOM fullscreen. This state is reachable:\na user clicking another window doesn't exit fullscreen, since\nfull-screen-api.exit-on.windowRaise only covers a website calling focus().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324754\n", "files": ["browser/actors/WebRTCParent.sys.mjs", "browser/base/content/test/browser-webrtc/browser_devices_get_user_media_document_pip.js"], "git_node": "40b79b7dd21ae320d1239db86da4244cabdafd7b", "git_parents": ["74d2e27624b796cb316199b78774d203262fe2a2"], "node": "052fff28dd69241912ca2cc07968fd6795dbb32d", "parents": ["594561e9592d6dbf47dbeb9d7f45475c29411bfa"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2065551 - [experiment] Schedule weekly notifications within a time window. r=android-reviewers,gmalekpour,twhite\n\nReplace periodic WorkManager scheduling with chained one-time work requests to:\n - Schedule notifications within the 12:00\u201317:00 local time window.\n - Preserve the intended notification timestamp to prevent schedule drift.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322315\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorkerTest.kt"], "git_node": "a8b1c67ffb080f18d018001ea0c56f91e4824516", "git_parents": ["40b79b7dd21ae320d1239db86da4244cabdafd7b"], "node": "60a2413bded743c1852348ae766c511038e03299", "parents": ["052fff28dd69241912ca2cc07968fd6795dbb32d"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070794 - Stop running the shopify applink startup test on p6 and s24 r=perftest-reviewers,mozperftest-reviewers,taskgraph-reviewers,sparky,ahal\n\nThe shopify applink test perma-fails its end frame validation on the bitbar p6 and s24 pools, the shopify applink test is a live site test and network reliability issues have made it an almost perma-failing test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327892\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/perftest/android.yml"], "git_node": "ad3345e309a6cb4ecb11bab2d6b6e6e4fb63f223", "git_parents": ["a8b1c67ffb080f18d018001ea0c56f91e4824516"], "node": "8cbcd366c1559379bec0b806a51e3d85db0b3987", "parents": ["60a2413bded743c1852348ae766c511038e03299"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070169 - [devtools] Use declaration substituted value to check registered property declaration validity. r=devtools-reviewers,ochameau.\" for causing devtools failures in browser_rules_registered-custom-properties.js.\n\nThis reverts commit df863ef87e391a0d07ccd3f0bd73e2affdcdb158.\n", "files": ["devtools/client/inspector/rules/test/browser_rules_registered-custom-properties.js", "devtools/server/actors/style-rule.js"], "git_node": "406c0bb4cc016f4691b0d50db9e7fc412a1fc73e", "git_parents": ["ad3345e309a6cb4ecb11bab2d6b6e6e4fb63f223"], "node": "9eac953fc34ff9abe2c6fa9040424cb640775756", "parents": ["8cbcd366c1559379bec0b806a51e3d85db0b3987"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064404 - Accelerate early 'events' pings in FOG r=chumphreys\" for causing multiple failures.\n\nThis reverts commit 67b32ba422d423c51e69807a19c15c96dd1d7f6f.\n", "files": ["toolkit/components/glean/src/init/mod.rs", "toolkit/components/glean/tests/test_metrics.yaml", "toolkit/components/glean/tests/xpcshell/test_FOGInit.js"], "git_node": "c2043fb2717748e792711a63de9b34ecf597dd2c", "git_parents": ["406c0bb4cc016f4691b0d50db9e7fc412a1fc73e"], "node": "ed46f2ad8621de2affe9f215936cf0f5bb62725e", "parents": ["9eac953fc34ff9abe2c6fa9040424cb640775756"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1632281 - Read the AutoConfig input prefs from the installation, not the profile. r=gstoll\n\nThe AutoConfig inputs are administrator settings, so nsReadConfig clears their\nuser values before evaluating the .cfg: a profile's prefs.js or user.js no\nlonger decides which file nsAutoConfig fetches or whether the vendor check\npasses. The .cfg can still set them with pref().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327889\n", "files": ["extensions/pref/autoconfig/src/nsReadConfig.cpp", "extensions/pref/autoconfig/test/unit/autoconfig-admin-pref.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-admin-url-pref.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-admin.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-remote.jsc", "extensions/pref/autoconfig/test/unit/test_autoconfig_profile_prefs.js", "extensions/pref/autoconfig/test/unit/xpcshell.toml"], "git_node": "54f2b5caa7741d01625c69f704af5072d57ee849", "git_parents": ["c2043fb2717748e792711a63de9b34ecf597dd2c"], "node": "f6e8778ae2e19f322f04f28f3954d498042d5979", "parents": ["ed46f2ad8621de2affe9f215936cf0f5bb62725e"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2073076 - Use profile count for auto-trigger default prompt  message targeting instead of single profile scope which fails intermittently r=omc-reviewers,yazan\n\nBug 2074258 was created to address intermittent failures of the `single` profile scoping mechanism. In the meantime, the targeting for the auto-trigger default prompt message that shows the first time a user lands on new tab is updated here to ensure the profile count is 0 (true on first profile), instead of relying on the single profile scope.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327910\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "e9040ec77f6679d0e966ed17368347e552dd99c7", "git_parents": ["54f2b5caa7741d01625c69f704af5072d57ee849"], "node": "c9efebafccd05b697a78735a873c7b9bb9d49f8b", "parents": ["f6e8778ae2e19f322f04f28f3954d498042d5979"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2070964 - Restore some preferences for Servo. r=firefox-style-system-reviewers,dshin\n\nGecko removed some preferences, unconditially enabling the relevant code.\nHowever, it shouldn't have been enabled for Servo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325011\n", "files": ["servo/components/style/stylesheets/rule_parser.rs", "servo/components/style/values/generics/length.rs", "servo/components/style/values/generics/position.rs", "servo/components/style/values/specified/align.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/image.rs", "servo/components/style/values/specified/length.rs", "servo/components/style/values/specified/position.rs"], "git_node": "a2c188e272fce0aea82bb491a96dc06a95d3e7d2", "git_parents": ["e9040ec77f6679d0e966ed17368347e552dd99c7"], "node": "e92fc56ce89ceebe81d3308d3bd307f4be1e1c58", "parents": ["c9efebafccd05b697a78735a873c7b9bb9d49f8b"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2070964 - Fix compile problems for Servo. r=firefox-style-system-reviewers,dshin\n\nThis is needed because cssparser was upgraded, and the style\ncrate was changed to 2024 edition.\n\nAlso warnings for unused functions and missing documentation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325012\n", "files": ["servo/components/style/properties/helpers/animated_properties.mako.rs", "servo/components/style/servo/animation.rs", "servo/components/style/servo/selector_parser.rs", "servo/components/style/stylesheets/supports_rule.rs", "servo/components/style/values/specified/box.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/position.rs"], "git_node": "26954407f3ac9c881c97df88810cecb4b08a5d19", "git_parents": ["a2c188e272fce0aea82bb491a96dc06a95d3e7d2"], "node": "52f3d2a576f7487d9c50b8906b5c5e8c7f13b89b", "parents": ["e92fc56ce89ceebe81d3308d3bd307f4be1e1c58"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2070964 - Partial revert of D316400 for Servo. r=firefox-style-system-reviewers,dshin\n\nServo has its own animation code, and the changes from D316400\nweren't compatible. So restore the previous situation for Servo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325013\n", "files": ["servo/components/style/stylesheets/keyframes_rule.rs"], "git_node": "d150e1f36b7d6546604f95b2d7f81eb5cf879530", "git_parents": ["26954407f3ac9c881c97df88810cecb4b08a5d19"], "node": "590a5b6d243c1851ddd0b4b4fff1e3d855c513b2", "parents": ["52f3d2a576f7487d9c50b8906b5c5e8c7f13b89b"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2070964 - Avoid animating `display` when the pref is disabled. r=firefox-style-system-reviewers,emilio,dshin\n\nD316339 added a bunch of checks for the layout.css.display-animations.enabled\npreference, but they weren't enough for Servo.\nReplace an assertion with another check, falling back to discrete animation if the\npref is disabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325014\n", "files": ["servo/components/style/properties/helpers/animated_properties.mako.rs"], "git_node": "7e610449d50179c0eacc20adbad59c01e82ec58f", "git_parents": ["d150e1f36b7d6546604f95b2d7f81eb5cf879530"], "node": "338aa50103a3ca94ed09597729c9137c9d4c5200", "parents": ["590a5b6d243c1851ddd0b4b4fff1e3d855c513b2"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2070964 - Implement `MallocSizeOf` for `parking_lot::RwLock\u003cT\u003e`. r=firefox-style-system-reviewers,emilio\n\nThis is needed because `Device` derives `MallocSizeOf` on Servo,\nand D322384 turned one of its fields into `parking_lot::RwLock`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325015\n", "files": ["Cargo.lock", "servo/components/malloc_size_of/Cargo.toml", "servo/components/malloc_size_of/lib.rs"], "git_node": "46d9fe9155bc0383e9cdda87d7af14fb28eab246", "git_parents": ["7e610449d50179c0eacc20adbad59c01e82ec58f"], "node": "44b1371a43d1989c0920c09e637ecfcc0089afc8", "parents": ["338aa50103a3ca94ed09597729c9137c9d4c5200"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2064871 - Add debug drawer helpers to visualize listen timeline changes r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327399\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/listentopage/ListenToPageTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/navigation/DebugDrawerRoute.kt"], "git_node": "514751de353831127fdd10b45f161d4dc1f746e5", "git_parents": ["46d9fe9155bc0383e9cdda87d7af14fb28eab246"], "node": "84672e67193b73957fb67c3014244b1cc9ff35fe", "parents": ["44b1371a43d1989c0920c09e637ecfcc0089afc8"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2064871 - Seek to a position in the article r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328018\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ProgressMapper.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueue.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ProgressMapperTest.kt"], "git_node": "7c83c07c8664f508759eaa156aa2724de1cba6d5", "git_parents": ["514751de353831127fdd10b45f161d4dc1f746e5"], "node": "ce12cf4825ba744b19a78accf23d66c1f10a29f8", "parents": ["84672e67193b73957fb67c3014244b1cc9ff35fe"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2061234 - Add bottom margin to widgets section if stories or recent activity isn't present. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328387\n", "files": ["browser/extensions/newtab/content-src/components/Base/_Grid.scss"], "git_node": "2dd1d29825aa0084c01eccb1fb4fb80e2f5bca91", "git_parents": ["7c83c07c8664f508759eaa156aa2724de1cba6d5"], "node": "a22739b6ee3bfe955343bb90fa86c5e28c71784d", "parents": ["ce12cf4825ba744b19a78accf23d66c1f10a29f8"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074849 - Fix printf platform-dependent formater r=yjuglaret\n\n\u003cinttypes.h\u003e provides macro for platform-dependent printf, let's use\nthem.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328510\n", "files": ["modules/libmar/tool/mar.c", "modules/libmar/verify/mar_verify.c"], "git_node": "4f58fcdb485d4659a31a90750d488ad1fab68aba", "git_parents": ["2dd1d29825aa0084c01eccb1fb4fb80e2f5bca91"], "node": "4780e5fa74c5d2d7b130876ed346d118ab47750e", "parents": ["a22739b6ee3bfe955343bb90fa86c5e28c71784d"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072624 - Add a websocket connection to check for notifications.r=aborondo\n\nThe core loop now checks if Firefox is running, and if it isn't, it starts a websocket connection to the configured push server. When it receives a notification message it launches Firefox to display the push notification and then waits, checking every minute if Firefox is still running before reconnecting to the push server.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327297\n", "files": ["Cargo.lock", "toolkit/mozapps/pushnotificationhelper/Cargo.toml", "toolkit/mozapps/pushnotificationhelper/src/main.rs", "toolkit/mozapps/pushnotificationhelper/src/preferences.rs", "toolkit/mozapps/pushnotificationhelper/src/pushconnection.rs", "toolkit/mozapps/pushnotificationhelper/src/widestring.rs"], "git_node": "a0abcc5b5553e73b45524648293df8a366bc9355", "git_parents": ["4f58fcdb485d4659a31a90750d488ad1fab68aba"], "node": "318bf59cfd4ac195557af438022d2c16986f8041", "parents": ["4780e5fa74c5d2d7b130876ed346d118ab47750e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074375. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328439\n", "files": ["image/encoders/png/nsPNGEncoder.cpp"], "git_node": "655cda3abf0b83495cb25576c91b77b422f46922", "git_parents": ["a0abcc5b5553e73b45524648293df8a366bc9355"], "node": "c8d99a810f33bb09fa4adbb1e6fa34a984d8f6ab", "parents": ["318bf59cfd4ac195557af438022d2c16986f8041"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073382 - Check WebsiteFilter redirects on the channel being followed. r=jmendez\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327418\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/browser/302exception.sjs", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js", "browser/components/enterprisepolicies/tests/browser/cached301.sjs", "browser/components/enterprisepolicies/tests/browser/websitefilter_sw.html", "browser/components/enterprisepolicies/tests/browser/websitefilter_sw.js"], "git_nod