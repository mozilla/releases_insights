42d46", "git_parents": ["20d2b60d6b16d72f047453fa5e1ce6d3bede3d9e"], "node": "ba0904fc9f3a725ed78f1c0b9b8fc29b68ec1ec8", "parents": ["151f9e1c41dc7625c8acbc0e964d2569393262a4"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058533 - Add a PromoCard highlighting the Collections to Tab Groups migration in the Tab Groups page r=android-reviewers,gl\" for causing fenix failures @AddressAutofillTest#verifyAddAddressViewTest.\n\nThis reverts commit 1d37bac63c89ed8d6e407bd963f1c8487107a34a.\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupsPageTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/collections/CollectionsMigrationPromoCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/action/TabGroupAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/CollectionsMigrationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupActionReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/state/TabsTrayState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabGroupList.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabGroupsPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabstray/TabsTray.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/CollectionsMigrationMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupReducerTest.kt"], "git_node": "a1ede75a778814d12cfa4e125debc6e2ffaabce0", "git_parents": ["f984cb1cff65053514566177bfafa1886ce42d46"], "node": "9c9f6ce600cdbe652e05aee8f098a7e67e011303", "parents": ["ba0904fc9f3a725ed78f1c0b9b8fc29b68ec1ec8"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2063111 - updates to align with API contract r=mshillabeer,jlewis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322800\n", "files": ["browser/components/aiwindow/models/SmartFormFillModel.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_smart_form_fill_model.js", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/UrlTokenizer.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_stored_values.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js", "browser/components/aiwindow/ui/test/xpcshell/test_UrlTokenizer.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml"], "git_node": "9a17117b7bd4e5da0081bdcdec93cfb63864c966", "git_parents": ["a1ede75a778814d12cfa4e125debc6e2ffaabce0"], "node": "327e041f2b7167012773a1a0e587caac5e9eb506", "parents": ["9c9f6ce600cdbe652e05aee8f098a7e67e011303"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2065986 - pt1. Introduce bailout stubs in the baseline interpreter and fallback ics r=jandem,iain\n\nAdd bailout stubs to the Baseline Interpreter and the Fallback IC compiler. These\nare currently a no-op - but will be jumped to by the bailout tail after copying\na single frame's contents. This allows the frame's return address, that is presently\ndirectly copied into the stack, to be materialized with an actual call - making\nbailout compatible with CET shadow stack on x86_64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320791\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineIC.cpp", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h", "js/src/jit/JitRuntime.h"], "git_node": "de748cf25a7ea6a68ce61c06a7fd0e029fb9d959", "git_parents": ["9a17117b7bd4e5da0081bdcdec93cfb63864c966"], "node": "d7cc6883723b7305f77b574d2ec861b305920cda", "parents": ["327e041f2b7167012773a1a0e587caac5e9eb506"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2065986 - pt2. Add bailout stub information to the BaselineBailoutInfo r=jandem,iain\n\nThe BaselineStackBuilder now adds BailoutStubInfo corresponding to each\nrebuilt stack frame to the BaselineBailoutInfo. The stub info tells the\nbailout tail where each frame's contents end and the bailout stub that\nwill materialize the return address for the frame's call into an outer\nframe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320792\n", "files": ["js/src/jit/BaselineBailouts.cpp", "js/src/jit/BaselineJIT.h"], "git_node": "1f504e17f70d539818dbb352533c9718d3a0380c", "git_parents": ["de748cf25a7ea6a68ce61c06a7fd0e029fb9d959"], "node": "b5ee4a72ac47abba7ad7473723ec039919e6bc31", "parents": ["d7cc6883723b7305f77b574d2ec861b305920cda"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2065986 - pt3. Use bailout stub info to reconstruct stack r=jandem,iain\n\nThe bailout process is modified to use bailout stub information to rebuild\nthe stack one frame at a time instead of the existing bulk copy.\n\n- The bailout tail uses the bailout stub information to setup the bailout\n  registers, copy contents of frames (besides the return address) and jumps\n  to the appropriate bailout stub.\n- The bailout stub is setup so that simply calling back into the bailout\n  tail materializes the expected return address - and the bailout tail can\n  continue with the next frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320793\n", "files": ["js/src/jit/Bailouts.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineIC.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/arm/Assembler-arm.h", "js/src/jit/arm64/Assembler-arm64.h", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/mips-shared/Assembler-mips-shared.h", "js/src/jit/none/Assembler-none.h", "js/src/jit/riscv64/Register-riscv64.h", "js/src/jit/wasm32/Assembler-wasm32.h", "js/src/jit/x64/Assembler-x64.h", "js/src/jit/x86/Assembler-x86.h"], "git_node": "251c0992cd1f4204e3ea188ff00c4dbf845fb077", "git_parents": ["1f504e17f70d539818dbb352533c9718d3a0380c"], "node": "45306dee8419383e2ce5c1619f3fbc613ec345f8", "parents": ["b5ee4a72ac47abba7ad7473723ec039919e6bc31"], "tags": []}], "date": 1789205649, "git_changesets": ["e173c24599a3524be313b5828c606870ae0d1980", "d489e02a8c4db6de67cd50612c3123fd594e2cc7", "186a3b9047b2d3a92365465dfda8f80e58241c7e", "367638bee9e61114e01755ff59c55d548adda36d", "065193d6071c92ad9c1e8311a35460639b7b5b4c", "70abc663a860d26b6d7faab3971d1c7f31463a28", "477e1f9b546f99ba5d0f95af4cf9038bce1daf8a", "d89caae212e8f862dad014f2d0d9d6c416f1aa0d", "2f0d4e5ac5134b04567ba0699cc8a0942090e36d", "c0682d0a705005ec89c3420b70002a64be9fbe52", "3dee287405fcbcab5ad61a2ce73a6ba89dc6d463", "767274e9d69ecb011addba36230949cd159126c8", "f88ffead06f622bc88e78948b61cc69942d64670", "7494a82306da54ae5beca9d8f317322f3c652b97", "d6f561d0061af7965598166bf16dfd9212c9f3b6", "0d8a98b84c657fceb042598861b8413ea3997bfe", "4c91297a52ff28cc4b8d190020e006e4f2bffdc6", "e10bbf0dae2f5c6033f99ccfb3edc0476ddf0dd4", "115df1170bdb67b6523bfd5c19473c322654a874", "af13762c4c1e7ebd836bdea629e166fb1180051b", "ea6b888b0b8aa968ade17700c79e06170f77ac58", "cdabea1dc908e604182ad0f463692f244d5d54c0", "59030f02670135419938f10f8d0975cccdb8858b", "7bd194b64b8b297a288a84790fd7b793a32486a1", "b9c3e085ff5be51502f464ccf6