0624770104e95", "6e25467c542cc7f5f10a2fee0d7b39cdb10fec27", "51cc646d8ba7c3ff22fed0e5cd58d42717cd77ed", "f4edbb4552983e50fc6221548a4b651b1860c3d6", "aa713c7e9955750161f4b57ea1ec86ccbb371f55", "1baa8d33849912e2fea1392f137991bd34406a29", "7f78e7686537e3cfad8bbb3ee9b62f16c52b6e41", "400daf1e15904a54d209e1ebe4822cd12cbe3c10", "eaa3a9ad2f3dce628ace1facd774bf17a47f165c", "e7ec9710451c1d24f12c17571611e21ee8fddc72", "b8ee5ff4f261d59341bb8ce35a0c6b5a20be1454", "2b76d58bc9f6676700bb9abe059d0cb07f6d308c", "ed1f83e4ff90401e9cf4d404ca66324582c680ab", "e1adf6bbb399de26b767c75b9d242baf84ac7859", "572b09870e397d11555c559413feb49945abb362", "200898255db44bcda9527cf608b787f2c1f11b90", "6583d85e3db2bd8e1a98b78fc25a8041c939cce7", "efffd5935322428c0e1b009305dc74951bd61f12", "fde22dc3c0dd4c958d8168e4908d0d8b9c8e356f", "c48dcc6b28eac5d36b61455a197a455ffd4b543e", "88b81b9e07b77104608796db1f8479c915030ee6", "383240b1c47fcbe804430e196a78f57abf4e1dfb"], "user": "asilaghi@mozilla.com"}, "45354": {"changesets": [{"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070665 - Add support for rootless direct mitmproxy playback r=perftest-reviewers,kshampur\n\nDirect mode serves recordings on unprivileged HTTP/HTTPS ports and points\nthe browser at them via DNS/port overrides, exercising a more\nrepresentative network stack than proxy mode. Not yet enabled for any\nsuite.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322928\n", "files": ["testing/mozbase/docs/mozproxy.md", "testing/mozbase/mozproxy/mozproxy/backends/mitm/desktop.py", "testing/mozbase/mozproxy/mozproxy/backends/mitm/mitm.py", "testing/mozbase/mozproxy/tests/test_proxy.py", "testing/raptor/raptor/browsertime/android.py", "testing/raptor/raptor/perftest.py", "testing/raptor/test/test_raptor.py"], "git_node": "b8551373315c9a3b694369aa434166ccd259fb8e", "git_parents": ["88b81b9e07b77104608796db1f8479c915030ee6"], "node": "bb3841a66b3011ac18639653d27702828df8190f", "parents": ["c68d29eb2646b8c2dde0f8bf558611489cc2035d"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064412 - Clone build-components tasks with Git, r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324400\n", "files": ["taskcluster/kinds/build-components/kind.yml"], "git_node": "2ea80565846e5c6066b92db9bbd91340d67d8dfc", "git_parents": ["b8551373315c9a3b694369aa434166ccd259fb8e"], "node": "e25982b201f76da346aba47e703c820b49d4249b", "parents": ["bb3841a66b3011ac18639653d27702828df8190f"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064746 - Share Firefox button should not be in help and report subview. r=nbarrett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326221\n", "files": ["browser/components/customizableui/content/panelUI.js"], "git_node": "e4ec35720eb4854c42eae8652765e7b9c69d25b7", "git_parents": ["2ea80565846e5c6066b92db9bbd91340d67d8dfc"], "node": "121b2d558060b05a603eb66540d4f3449432267b", "parents": ["e25982b201f76da346aba47e703c820b49d4249b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072747 - Pt 1 - Remove the scene builder's IsVisible trait r=gfx-reviewers,nical\n\nSince bug 2072057 the display list builder drops a fully transparent text\nrun, rectangle or line at record time, on the same quantized colour the scene\nbuilder's primitive data holds, so the is_visible check in add_primitive can\nno longer reject anything: those three predicates cannot fail, and every\nother impl returned true. Drop the trait, its eleven impls and the bound.\n\nTwo rectangles were still reaching the scene builder transparent. The solid\nmargins the radial gradient optimisation emits bypassed push_rect, so every\nrectangle item now goes through one push_rect_prim that applies the test.\nAnd a checkerboard background is deliberately recorded whatever its colour,\nsince the tile cache barrier is keyed off the flag; its rectangle was dropped\nas a primitive before and still is, by an explicit test in the Rectangle arm.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326742\n", "files": ["gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/gradient/conic.rs", "gfx/wr/webrender/src/prim_store/gradient/linear.rs", "gfx/wr/webrender/src/prim_store/gradient/radial.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/prim_store/line_dec.rs", "gfx/wr/webrender/src/prim_store/rectangle.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "db996abe6023d66e8167b38266710ad6a9fe9fc4", "git_parents": ["e4ec35720eb4854c42eae8652765e7b9c69d25b7"], "node": "67c19ca30db81e6e70cac77ad570000382c3e894", "parents": ["121b2d558060b05a603eb66540d4f3449432267b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072747 - Pt 2 - Pass the clip store to the functions that only read clips r=gfx-reviewers,nical\n\nEleven functions took the whole Interners or DataStores to reach one field.\nThe clip tree builder's complex-clip and promotability walks and the slice\nbuilder's shared-clip partitioning read the clip interner, and take it as a\nSceneClipStore; prepare_box_shadow, update_clip_task,\nadd_clip_mask_render_task and prepare_picture_clips read the clip data store,\nand take a ClipDataStore. Callers pass the field they already had.\n\nNo behaviour change. This is the shape interning clips in the display list\nbuilder wants, where the two clip stores stop being fields of the interner\ncollections.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326743\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs"], "git_node": "c850ce854f3023a27ab0cf6dadbcb497d7285b48", "git_parents": ["db996abe6023d66e8167b38266710ad6a9fe9fc4"], "node": "2ab5d208ce17bdd26584d97b06954272a9995c39", "parents": ["67c19ca30db81e6e70cac77ad570000382c3e894"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072747 - Pt 3 - Make the text run template a PrimTemplate of TextRun r=gfx-reviewers,nical\n\nTextRunTemplate duplicated TextRun's four fields beside the common data;\nevery other primitive's template is PrimTemplate\u003cData\u003e. Make it one, and\nmove the frame-time methods that lived on the template onto TextRun, which\nis what they read. Readers go through .kind for the run and .common for the\nrest, as they do for every other type, and the Deref to the common data goes.\n\nThe template grows from 112 to 120 bytes, since the generic layout cannot\ninterleave the common data with the run's fields the way the bespoke struct\nlet rustc do. One per interned run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326744\n", "files": ["gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender/src/tile_cache/mod.rs"], "git_node": "11106247ecc8f253591564ed3e4780e96c4c6d17", "git_parents": ["c850ce854f3023a27ab0cf6dadbcb497d7285b48"], "node": "349a36e5f81a9e77711538bcb69281c69b8ddcaa", "parents": ["2ab5d208ce17bdd26584d97b06954272a9995c39"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072747 - Pt 4 - Fold the repeating image item into the image item r=gfx-reviewers,nical\n\nThe two image items differed only in the tile size and spacing, and the\nscene builder already reduced both to one StretchSizeKey plus a spacing\nbefore building the same primitive. Record that form on ImageDisplayItem\nand delete RepeatingImageDisplayItem: push_image records both axes as\nfilling the bounds, push_repeating_image runs image_stretch_size, and the\nscene builder's one Image arm passes the fields straight to add_image.\npush_image and push_repeating_image keep their signatures, so no caller\nchanges.\n\nThe key the scene builder interns is unchanged: image_stretch_size only\ncompares sizes, which the scroll-offset normalisation does not alter, and\nthe fills-both case normalises to the same zero size fills_prim() produced.\nStretchSizeKey and SizeKey gain Default and PeekPoke so the item can carry\nthem.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326745\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/key_types.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "03079963273f35ecc2e1425929017b8c6d7735ab", "git_parents": ["11106247ecc8f253591564ed3e4780e96c4c6d17"], "node": "4f889cba9b6fd0bb605bacf506215671809db869", "parents": ["349a36e5f81a9e77711538bcb69281c69b8ddcaa"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072747 - Pt 5 - Give the interning memory report its own field list r=gfx-reviewers,nical\n\nInternerSubReport was generated from enumerate_interners!, so removing a type\nfrom the scene builder's interners shrank a repr(C) struct that C++ mirrors by\nhand in webrender_ffi.h, and every such removal had to touch three C++ files\nin step. Generate the report from a separate list of the same names, in the\nsame order, that a type stays on after its interner goes; a field nothing\nwrites reports zero.\n\nSame struct, same layout, no behaviour change. It exists so that moving\ninterning into the display list builder one type at a time does not touch\nthe C++ side at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326746\n", "files": ["gfx/webrender_bindings/webrender_ffi.h", "gfx/wr/webrender/src/intern.rs"], "git_node": "38fcc343cd125c6cc19b4a13aad9e363e5e2740f", "git_parents": ["03079963273f35ecc2e1425929017b8c6d7735ab"], "node": "caede3ab21a245255f8d27f8e1ff99f0efdd8039", "parents": ["4f889cba9b6fd0bb605bacf506215671809db869"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071435 - [Monitor Agent][Models] Raise the maximum number of active monitors from 5 to 15 r=yjamora,tetchart,fluent-reviewers,bolsson\n\nMonitor v1 (AIACT-155) raises the per-profile monitor cap so users can\ntrack more than five items. Product settled on 15 after re-running the\ncost math for Qwen: 15 monitors at 5 URLs checked daily stays under the\nweekly budget.\n\nThe cap now applies to active (enabled) monitors only. Paused monitors\nare unlimited and no longer count toward the limit, and resuming a\npaused monitor is rejected when it would exceed the active cap. Stored\nmonitors are no longer truncated to the cap at load time.\nTOTAL_NUM_MONITORS in Monitor.sys.mjs stays the single source of truth\nfor the create and resume paths, the chat limit message,\nabout:smartwindowtasks and the toolbar panel footer count.\n\nThe rejection is a MonitorLimitError whose code is\nMONITOR_ERROR_CODES.ACTIVE_LIMIT, with user-facing copy registered in\nmonitor-error-copy.mjs like the run error codes. The tasks actor\nforwards the code to content so the UI can show that message without\nmatching on the error text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325497\n", "files": ["browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/ui/actors/SmartWindowTasksParent.sys.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/monitor-error-copy.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "78b8117c653a6e18b254e7b3db0ffbce9cf1ab77", "git_parents": ["38fcc343cd125c6cc19b4a13aad9e363e5e2740f"], "node": "f46e27d4bb6a033bdc03af1be0268b9dc1a029e3", "parents": ["caede3ab21a245255f8d27f8e1ff99f0efdd8039"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072759 - Don't update the pointer-locked position from events which carry a movement delta; r=smaug\n\nWhile the pointer is locked, mouse events keep reporting the same position at\nwhich pointer lock was requested, PreHandleEvent() implements this by no longer\nupdating sLastScreenPoint/sLastClientPoint once PointerLockManager::IsLocked()\nis true. However, that is not enough for the initial recentering move synthesized\nby RequestLockPointer(): it can reach the content process before the IPC reply\nwhich makes IsLocked() return true there, so the center of the window gets\nrecorded.\n\nSo this patch skips the update for any event carrying a movement delta instead.\nWidgets may set mMovement to report a delta while the native pointer is locked,\nand the synthesized recentering mousemove is also marked with mMovement. In\neither case, the event should not update the recorded position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326767\n", "files": ["dom/events/EventStateManager.cpp", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini"], "git_node": "80c308ff287d6d1ec368afeac1216b2373a64cbb", "git_parents": ["78b8117c653a6e18b254e7b3db0ffbce9cf1ab77"], "node": "2f0458e444a9b74721448ebb9ffee9acd3eb90f8", "parents": ["f46e27d4bb6a033bdc03af1be0268b9dc1a029e3"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073003 - Have gen_scalar_enum.py generate self-contained headers r=marco,chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326920\n", "files": ["toolkit/components/telemetry/build_scripts/gen_scalar_enum.py"], "git_node": "f8c25c7edd6558a0eff445f90ef3b7c2a3e63384", "git_parents": ["80c308ff287d6d1ec368afeac1216b2373a64cbb"], "node": "471fbe6aba4659e569d143b00fc6f1904c412e36", "parents": ["2f0458e444a9b74721448ebb9ffee9acd3eb90f8"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073010 - Update diskarzhan to latest version - 0.1.7 r=mach-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326922\n", "files": ["third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/METADATA", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/RECORD", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/WHEEL", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/entry_points.txt", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/licenses/LICENSE", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/top_level.txt", "third_party/python/diskarzhan/diskarzhan-0.1.7.dist-info/METADATA", "third_party/python/diskarzhan/diskarzhan-0.1.7.dist-info/RECORD", "third_party/python/diskarzhan/diskarzhan-0.1.7.dist-info/WHEEL", "third_party/python/diskarzhan/diskarzhan-0.1.7.dist-info/entry_points.txt", "third_party/python/diskarzhan/diskarzhan-0.1.7.dist-info/licenses/LICENSE", "third_party/python/diskarzhan/diskarzhan-0.1.7.dist-info/top_level.txt", "third_party/python/diskarzhan/diskarzhan/diskarzhan.yaml", "third_party/python/pyproject.toml", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "739efdac7fd6a023d32e9159f76367932c9ca203", "git_parents": ["f8c25c7edd6558a0eff445f90ef3b7c2a3e63384"], "node": "46401a08a70e037edb8052611c88faa9476198e9", "parents": ["471fbe6aba4659e569d143b00fc6f1904c412e36"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073048 - Lint all accessible headers through clang-tidy r=accessibility-platform-reviewers,morgan\n\nChanges includes:\n- using C++20 type traits\n- making deleted methods public\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326935\n", "files": ["accessible/atk/nsStateMap.h", "accessible/base/Relation.h", "accessible/base/nsAccCache.h", "accessible/xpcom/xpcAccessibleMacInterface.h", "accessible/xpcom/xpcAccessibleValue.h"], "git_node": "c5c4e3ca4c52b1d54ccbc855e2420add07848378", "git_parents": ["739efdac7fd6a023d32e9159f76367932c9ca203"], "node": "39118bd7a4a05456a854e84987bc83d2bb0434a5", "parents": ["46401a08a70e037edb8052611c88faa9476198e9"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073030 - make widget/ headers compatible with clang-tidy r=gtk-reviewers,emilio\n\nChanges includes:\n- making every header self-contained\n- renaming an x-macro file using the .inc extension (see also #2010520)\n\nAll changes were detected either by header compilation failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326954\n", "files": ["widget/EventForwards.h", "widget/EventMessageList.h", "widget/EventMessageList.inc", "widget/FontRange.h", "widget/GfxDriverInfo.h", "widget/SwipeTracker.h", "widget/TextEvents.h", "widget/WidgetEventImpl.cpp", "widget/gtk/nsGtkUtils.h", "widget/gtk/nsLookAndFeel.cpp", "widget/moz.build", "widget/nsPrinterCUPS.cpp"], "git_node": "84cdfb5463d67f09514050f92395c35f6cd88884", "git_parents": ["c5c4e3ca4c52b1d54ccbc855e2420add07848378"], "node": "a946b73586ad71360a5658db0cdb70b85884ba77", "parents": ["39118bd7a4a05456a854e84987bc83d2bb0434a5"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073099 - Make all caps/ headers compatible with clang-tidy r=emilio\n\nThis basically mean making sure every headers are self-contained.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326962\n", "files": ["caps/ExpandedPrincipal.cpp", "caps/OriginAttributes.cpp"], "git_node": "15932749e311f4620db835d9addc4cedde7dedbd", "git_parents": ["84cdfb5463d67f09514050f92395c35f6cd88884"], "node": "977b4ef69e8cefae8c3234d1349b6381ff04efc6", "parents": ["a946b73586ad71360a5658db0cdb70b85884ba77"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070783 - Wait for Places async updates before querying the bookmark result in test_openURL_isAddressBarUrlNavigation_bookmark. r=mcheang,omc-reviewers,yazan\n\nThe newly-inserted bookmark wasn't guaranteed to be indexed before the\nurlbar query ran, so the result was sometimes missing from the popup.\nUrlbarTestUtils.pickResultAndWaitForLoad then got targetIndex -1 and\nspun forever in its \"select the target row\" loop, causing the perma/\nintermittent timeouts in this bug and its duplicate, Bug 2070889,\nregressed by Bug 2067175.\n\nAlso wait for frecency recalculation and accept either a plain\nbookmark match or the autofilled heuristic result for the bookmark,\nsince which one the urlbar produces depends on how quickly frecency\nfor the new URL gets computed; requiring a specific non-autofill row\nreintroduced the same targetIndex -1 hang under mach test --verify.\n\nAdditionally close the app-menu popup left open by\nIPProtection.init()/.uninit() in test_ipprotection_ready and properly\nawait popuphidden after IPProtectionPanel.close() in\ntest_ipprotection_panel_closed, both of which otherwise leaked into\nlater tests in the same file and produced an unrelated\n\"unexpected popup\" failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325110\n", "files": ["browser/components/asrouter/tests/browser/browser_trigger_listeners.js", "browser/components/asrouter/tests/browser/head.js"], "git_node": "26c004e6069b4fc1683d9ef8b28542d725a32585", "git_parents": ["15932749e311f4620db835d9addc4cedde7dedbd"], "node": "f47c04fca5640306052d0ff401014396e2ed438a", "parents": ["977b4ef69e8cefae8c3234d1349b6381ff04efc6"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073101 - Make all editor/ headers analyzable by clang-tidy r=emilio\n\nWhich basically means making sure they are self-contained.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326964\n", "files": ["editor/composer/nsEditingSession.h", "editor/spellchecker/EditorSpellCheck.cpp"], "git_node": "8b99786b4e21f7d410fd477f5d8c3563510d6ea9", "git_parents": ["26c004e6069b4fc1683d9ef8b28542d725a32585"], "node": "b144b5ca5ddcbf41fc8f860118ea4228907828ce", "parents": ["f47c04fca5640306052d0ff401014396e2ed438a"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073030 - Lint all intl/ headers through clang-tidy r=platform-i18n-reviewers,jfkthame\n\nChanges includes:\n- using C++20 type aliases and inline variables\n- making deleted methods public\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326973\n", "files": ["intl/components/src/DateIntervalFormat.h", "intl/components/src/DisplayNames.h", "intl/components/src/ListFormat.h", "intl/l10n/FileSource.h", "intl/l10n/FluentBindings.h", "intl/l10n/L10nRegistry.h", "intl/l10n/RegistryBindings.h", "intl/locale/AppDateTimeFormat.h", "intl/locale/LocaleService.cpp", "intl/locale/MozLocaleBindings.h"], "git_node": "2e9acf1fd3434804215f9841774f8eece9c0c655", "git_parents": ["8b99786b4e21f7d410fd477f5d8c3563510d6ea9"], "node": "f2a5503bf9f1979071259813e8c534820812737f", "parents": ["b144b5ca5ddcbf41fc8f860118ea4228907828ce"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073217 - Update PDF.js to 51fc21d1f803ac2bef118247197ed847644e71d9 r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327045\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "d9cb96ad432248c74082393af8ad367cbbfa458c", "git_parents": ["2e9acf1fd3434804215f9841774f8eece9c0c655"], "node": "b7c34c0358926fb19aeb5ed8b1ba655790de05c7", "parents": ["f2a5503bf9f1979071259813e8c534820812737f"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/METADATA", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/RECORD", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/WHEEL", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/entry_points.txt", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/licenses/LICENSE", "third_party/python/diskarzhan/diskarzhan-0.1.6.dist-info/top_level.txt", "widget/EventMessageList.h"], "git_node": "61a4f8008eea8552b81923a1e0143e7c3a831c35", "git_parents": ["383240b1c47fcbe804430e196a78f57abf4e1dfb", "d9cb96ad432248c74082393af8ad367cbbfa458c"], "node": "f3bc7391657faaae6dfe0974911324586957927e", "parents": ["cf79615e8a61e80335dad220a126e81b1a08fd87", "b7c34c0358926fb19aeb5ed8b1ba655790de05c7"], "tags": []}], "date": 1789723743, "git_changesets": ["b8551373315c9a3b694369aa434166ccd259fb8e", "2ea80565846e5c6066b92db9bbd91340d67d8dfc", "e4ec35720eb4854c42eae8652765e7b9c69d25b7", "db996abe6023d66e8167b38266710ad6a9fe9fc4", "c850ce854f3023a27ab0cf6dadbcb497d7285b48", "11106247ecc8f253591564ed3e4780e96c4c6d17", "03079963273f35ecc2e1425929017b8c6d7735ab", "38fcc343cd125c6cc19b4a13aad9e363e5e2740f", "78b8117c653a6e18b254e7b3db0ffbce9cf1ab77", "80c308ff287d6d1ec368afeac1216b2373a64cbb", "f8c25c7edd6558a0eff445f90ef3b7c2a3e63384", "739efdac7fd6a023d32e9159f76367932c9ca203", "c5c4e3ca4c52b1d54ccbc855e2420add07848378", "84cdfb5463d67f09514050f92395c35f6cd88884", "15932749e311f4620db835d9addc4cedde7dedbd", "26c004e6069b4fc1683d9ef8b28542d725a32585", "8b99786b4e21f7d410fd477f5d8c3563510d6ea9", "2e9acf1fd3434804215f9841774f8eece9c0c655", "d9cb96ad432248c74082393af8ad367cbbfa458c", "61a4f8008eea8552b81923a1e0143e7c3a831c35"], "user": "rperta@mozilla.com"}, "45355": {"changesets": [{"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064412 - Clone build-components tasks with Git, r=taskgraph-reviewers,bhearsum\" for causing Android Components signing exceptions.\n\nThis reverts commit 2ea80565846e5c6066b92db9bbd91340d67d8dfc.\n", "files": ["taskcluster/kinds/build-components/kind.yml"], "git_node": "73f46f2636b5677d7282764dd7afeaea7036f0ce", "git_parents": ["61a4f8008eea8552b81923a1e0143e7c3a831c35"], "node": "d5d40664e613cb36664fa3c37d65a90644d40664", "parents": ["f3bc7391657faaae6dfe097491