media/ffvpx/libavutil/pixdesc.c", "media/ffvpx/libavutil/random_seed.c", "media/ffvpx/libavutil/rational.c", "media/ffvpx/libavutil/side_data.c", "media/ffvpx/libavutil/stereo3d.c", "media/ffvpx/libavutil/utils.c", "media/ffvpx/libavutil/version.h", "media/ffvpx/libavutil/vulkan.c", "media/ffvpx/libavutil/vulkan.h", "media/ffvpx/libavutil/vulkan_functions.h", "media/ffvpx/libavutil/vulkan_loader.h", "media/ffvpx/libavutil/x86/asm.h", "media/ffvpx/libavutil/x86/crc.h", "media/ffvpx/libavutil/x86/emms.asm", "media/ffvpx/libavutil/x86/moz.build", "media/ffvpx/libavutil/x86/pixelutils.asm", "media/ffvpx/libavutil/x86/pixelutils.h", "media/ffvpx/libavutil/x86/tx_float.asm", "media/ffvpx/libavutil/x86/x86util.asm", "media/ffvpx/mediacodec_force_key_frames.patch", "media/ffvpx/parseutils-no-random-seed.patch", "media/ffvpx/vp8dsp-nasm-2.14-compat.patch", "media/ffvpx/vp9-get-format-rollback.patch"], "git_node": "4de2dc154ea39627e6ec83168c22185f2251d192", "git_parents": ["ffdeb310c3e4069830871e9550b170c1eecea80a"], "node": "9fca65578aab1bfb1465b5c6307d19d8b0fbf791", "parents": ["2bb4e077ee3fd87e5df687b17e12569e442f936c"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Load ffmpeg functions from correct library r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324524\n", "files": ["dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/ffvpx/FFVPXRuntimeLinker.cpp"], "git_node": "a2082fac802be185644d8808ec3305d4a96d958b", "git_parents": ["4de2dc154ea39627e6ec83168c22185f2251d192"], "node": "981ea208f5539f2622d282d5af64cc6bb7ac2006", "parents": ["9fca65578aab1bfb1465b5c6307d19d8b0fbf791"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Check av_hwframe_map() before use Vulkan direct mapping r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324525\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "2a7ca5bdfe2787cb1f22b6474f2c8846cb9fadbb", "git_parents": ["a2082fac802be185644d8808ec3305d4a96d958b"], "node": "86f574c7b0d9881556e8f98fabec7ef0fd98adba", "parents": ["981ea208f5539f2622d282d5af64cc6bb7ac2006"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Add ffvpx symbol export test r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324526\n", "files": ["docs/code-quality/lint/linters/ffvpx-symbols.md", "tools/lint/ffvpx-symbols.yml", "tools/lint/ffvpx-symbols/__init__.py", "tools/lint/test/python.toml", "tools/lint/test/test_ffvpx_symbols.py"], "git_node": "daa29ee85ac546265315d9bac69d61b4e26e55d1", "git_parents": ["2a7ca5bdfe2787cb1f22b6474f2c8846cb9fadbb"], "node": "8df548297f4a6cbb5f74f87ac81e9c10a6e50285", "parents": ["86f574c7b0d9881556e8f98fabec7ef0fd98adba"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073030 - Lint all extensions/ headers through clang-tidy r=permissions-reviewers,emilio,emz\n\nChanges solely includes:\n- making deleted methods public\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327147\n", "files": ["extensions/permissions/PermissionManager.h"], "git_node": "c6869837ab5b7c29983515b59d06e26370facb11", "git_parents": ["daa29ee85ac546265315d9bac69d61b4e26e55d1"], "node": "b6eb6c7385b81abdcc5587ee88afb3d1c7c4999f", "parents": ["8df548297f4a6cbb5f74f87ac81e9c10a6e50285"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072568 - Anti-alias horizontal edges in SWGL. r=lsalzman\n\nSWGL edge anti-aliasing only computes coverage along left and right edges.\naa_span derives per-pixel coverage from the horizontal distance to these\ntwo edges and the blend stage takes the minimum of the two. Nothing accounts\nfor how much of a row the polygon covers vertically, and with AA enabled the\nrow range is rounded outward, so the partially covered top and bottom rows\nof an axis-aligned quad were drawn at full opacity. Sloped edges were fine\nbecause they are traced as left or right edges. Exactly horizontal edges\nnever are, since they connect the two start vertices or the two end\nvertices of the traced edges.\n\nRow coverage:\n\nEach row is now bounded by the fraction of the row that lies between the\npolygon's anti-aliased horizontal top and bottom edges, if any. The blend\nstage clamps the per-pixel coverage to that bound instead of a constant,\nso the per-pixel cost is unchanged. Taking the minimum of the horizontal\nand vertical coverage matches what rectangle_aa_fragment does on the GPU\npath (max of the per-axis distances), so corner pixels come out the same\nas the reference. On partially covered rows the opaque region of the span\nis emptied so that every pixel goes through the AA blend stage.\n\nRow rounding:\n\nThe row range used to be rounded outward for the whole polygon as soon as\nAA was enabled, regardless of which edges were anti-aliased. This made\nhorizontal edges without AA bleed by a row, so a translucent primitive\ndrawn as a center part plus edge strips double-blended the row where the\ncenter met the bottom strip. It also skipped the bottom row entirely when\nthe bottom edge's fractional part was below 0.5, because the initial row\nlimit was not rounded outward. Rounding is now decided per edge:\noutward past an anti-aliased horizontal edge, to the nearest row across a\nhorizontal edge without AA, and unchanged for a top or bottom vertex.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326487\n", "files": ["gfx/wr/swgl/src/blend.h", "gfx/wr/swgl/src/rasterize.h", "gfx/wr/webrender/res/ps_quad.glsl", "testing/web-platform/meta/css/motion/offset-path-shape-polygon-001.html.ini", "testing/web-platform/meta/css/motion/offset-rotate-005.html.ini"], "git_node": "5a5f4660b5d019f54a75e3c935db66285b97c12d", "git_parents": ["c6869837ab5b7c29983515b59d06e26370facb11"], "node": "bc2890ed9c25d33e8eb116f6963080e325b11163", "parents": ["b6eb6c7385b81abdcc5587ee88afb3d1c7c4999f"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071583 - Add optional stylesURLs for newtab Expo component configurations to help avoid FoUC for components. r=urlbar-reviewers,thecount,daisuke\n\nWe can get into situations where the component has a chance to be painted before its stylesheet(s)\nhave had a chance to load, resulting in a FoUC, which is unpleasant. We add a new optional\nstyleURLs property for Expo components that let them declare which stylesheets they expect\nto be loaded before the component is inserted into the DOM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325918\n", "files": ["browser/components/newtab/AboutNewTabComponents.sys.mjs", "browser/components/urlbar/UrlbarNewTabComponentRegistrant.sys.mjs", "browser/extensions/newtab/content-src/components/ExternalComponentWrapper/ExternalComponentWrapper.jsx", "browser/extensions/newtab/test/jest/content-src/components/ExternalComponentWrapper.test.jsx"], "git_node": "d207f53ce7612802d79564721b25a4875bb631f1", "git_parents": ["5a5f4660b5d019f54a75e3c935db66285b97c12d"], "node": "fa9dcc6f6a2f25953ee4142b3b05f0e401acd3c1", "parents": ["bc2890ed9c25d33e8eb116f6963080e325b11163"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072370 - Update the vendored taskcluster python client to 110.0.0. r=taskgraph-reviewers,mach-reviewers,ahochheiden,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326969\n", "files": ["taskcluster/requirements.txt", "testing/manifest/test/test_manifest.in", "testing/manifest/test/test_manifest.txt", "testing/test/test_testing.in", "testing/test/test_testing.txt", "third_party/python/pyproject.toml", "third_party/python/requirements.txt", "third_party/python/taskcluster/taskcluster-110.0.0.dist-info/METADATA", "third_party/python/taskcluster/taskcluster-110.0.0.dist-info/RECORD", "third_party/python/taskcluster/taskcluster-110.0.0.dist-info/WHEEL", "third_party/python/taskcluster/taskcluster-110.0.0.dist-info/licenses/LICENSE", "third_party/python/taskcluster/taskcluster-93.1.5.dist-info/METADATA", "third_party/python/taskcluster/taskcluster-93.1.5.dist-info/RECORD", "third_party/python/taskcluster/taskcluster-93.1.5.dist-info/WHEEL", "third_party/python/taskcluster/taskcluster-93.1.5.dist-info/licenses/LICENSE", "third_party/python/taskcluster/taskcluster/generated/_client_importer.py", "third_party/python/taskcluster/taskcluster/generated/aio/_client_importer.py", "third_party/python/taskcluster/taskcluster/generated/aio/auth.py", "third_party/python/taskcluster/taskcluster/generated/aio/githubevents.py", "third_party/python/taskcluster/taskcluster/generated/aio/hooks.py", "third_party/python/taskcluster/taskcluster/generated/aio/queue.py", "third_party/python/taskcluster/taskcluster/generated/aio/queueevents.py", "third_party/python/taskcluster/taskcluster/generated/aio/secrets.py", "third_party/python/taskcluster/taskcluster/generated/aio/webserver.py", "third_party/python/taskcluster/taskcluster/generated/aio/workermanager.py", "third_party/python/taskcluster/taskcluster/generated/auth.py", "third_party/python/taskcluster/taskcluster/generated/githubevents.py", "third_party/python/taskcluster/taskcluster/generated/hooks.py", "third_party/python/taskcluster/taskcluster/generated/queue.py", "third_party/python/taskcluster/taskcluster/generated/queueevents.py", "third_party/python/taskcluster/taskcluster/generated/secrets.py", "third_party/python/taskcluster/taskcluster/generated/webserver.py", "third_party/python/taskcluster/taskcluster/generated/workermanager.py", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "d8b6520ba69ed08660c0bab6aa1fde3b416b1df3", "git_parents": ["d207f53ce7612802d79564721b25a4875bb631f1"], "node": "cdda9e3facd6e3a809a934b217a2541fac619396", "parents": ["fa9dcc6f6a2f25953ee4142b3b05f0e401acd3c1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072370 - Add a change-priority action for the unresolved tasks of a push. r=taskgraph-reviewers,releng-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326307\n", "files": ["taskcluster/gecko_taskgraph/actions/change_priority.py"], "git_node": "3b62757d3a7847b476249d7a10f3dd4234395848", "git_parents": ["d8b6520ba69ed08660c0bab6aa1fde3b416b1df3"], "node": "6fe3e844a57508a7ce831a2c3118f66119e42b33", "parents": ["cdda9e3facd6e3a809a934b217a2541fac619396"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2073126 - AddressAutofillTest: scroll the address form's lazy list per field instead of relying on soft keyboard dismissal r=isabel_rios\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327040\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAutofillRobot.kt"], "git_node": "3fbd3cbb173068de3c0eb8910d360d66bd1befec", "git_parents": ["3b62757d3a7847b476249d7a10f3dd4234395848"], "node": "81ece332d079ffe7567155aa299cb944f8e07d90", "parents": ["6fe3e844a57508a7ce831a2c3118f66119e42b33"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072590 - Support chart fields in BaseMarkerType r=profiler-reviewers,canova\n\nMarkerSchema::AddChart/AddChartColor let a marker type plot one of its numeric\npayload fields as a timeline track, but BaseMarkerType had no way to express\nthat, so any marker using it was stuck on the hand-written MarkerTypeDisplay\nsyntax.\n\nAdd an optional GraphFields array of MarkerSchema::GraphField, mirroring how\nPayloadFields works: MarkerTypeDisplay walks it and calls AddChartColor when a\ncolor is given and AddChart otherwise. A constexpr check rejects a null Key,\nand UseSpecialFrontendLocation types are barred from declaring GraphFields\nalong with the other display properties the front-end ignores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326453\n", "files": ["mozglue/baseprofiler/public/BaseProfilerMarkersPrerequisites.h", "tools/profiler/docs/markers-guide.md", "tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "5165f3a268b8ab212463b34b3ef4b3e6ed660aff", "git_parents": ["3fbd3cbb173068de3c0eb8910d360d66bd1befec"], "node": "0a142dfc1a3b931739272f130c4e236e45c1da3f", "parents": ["81ece332d079ffe7567155aa299cb944f8e07d90"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072590 - Migrate CPUSpeedMarker to BaseMarkerType r=canova,profiler-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327274\n", "files": ["tools/profiler/core/platform.cpp"], "git_node": "d75ff36bad313b4c4f89105c588040be196ebb97", "git_parents": ["5165f3a268b8ab212463b34b3ef4b3e6ed660aff"], "node": "39ec62f451c17d7ed6bc175560729fa7219711e0", "parents": ["0a142dfc1a3b931739272f130c4e236e45c1da3f"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2072590: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "09d9a4e2a8ad9b2af5311ef77c6d3c3e588f95ad", "git_parents": ["d75ff36bad313b4c4f89105c588040be196ebb97"], "node": "6809566edef84db76c5356da7756c159182833d9", "parents": ["39ec62f451c17d7ed6bc175560729fa7219711e0"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071963 - Populate OS, OSVersion, CPUArchitecture, and CrashEventID annotations in socorro/MozillaSocorroService r=crashreporting-reviewers,android-reviewers,tcampbell,gsvelto\n\nI noticed that CrashEventID was also missing here, so added it.\n\nThis moves some annotations into a separate method because detekt was\ncomplaining that the method was too long (and LongMethod can't be\nsuppressed in the a-c detekt rules(?), though the other impl does\nsuppress it).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325943\n", "files": ["mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/socorro/MozillaSocorroService.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/service/socorro/MozillaSocorroServiceTest.kt"], "git_node": "ed41a4e0cf957d9d32413bcb5682651e6dc189ce", "git_parents": ["09d9a4e2a8ad9b2af5311ef77c6d3c3e588f95ad"], "node": "54cd473aca90b4d6e9a5393b41a4c2ef106a2575", "parents": ["6809566edef84db76c5356da7756c159182833d9"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046388 - Run macOS Talos and AWSY on Apple Silicon M4 in parallel with Intel r=perftest-reviewers,sparky\n\nAdd macosx64-talos, talos-profiling and awsy to the\nmacosx1500-aarch64-shippable/opt test-sets so Talos and AWSY run on M4\nalongside the existing Intel macosx1470-64 coverage. Intel is left untouched,\nso Perfherder accumulates an M4 baseline before any cutover.\n\nThis is a reduced phase 1a. The earlier revision also added browsertime and\nbrowsertime-profiling and dropped the macosx1500-64-perftests stub; those are\ndeferred to phase 1b. Measured over 2026-08-19..08-26, gecko-t-osx-1500-m4\nruns at 73-100% weekday occupancy, and the full perf-set parity add costs ~10%\nof that pool (~18 workers' worth) while both platforms run in parallel. The\nTalos slice generates 32 task types on aarch64 against Intel's 50 and costs\n~141 wall-hours/day, ~3.3% of the pool (~6 workers). AWSY adds two scheduled\ntasks (awsy-base and awsy-tp6; the tp5 and dmd variants stay at\nrun-on-projects: [] as they are on Intel) for a further ~0.1%, so phase 1a\ntotals ~3.4% - which the pool can absorb today. Browsertime, at ~8.4%, follows\nonce capacity lands.\n\nTalos was validated on try (32/32 green, all routed to\nreleng-hardware/gecko-t-osx-1500-m4 bare metal, Perfherder data emitted): a\nfull Talos pass takes 574 minutes on M4 against 738 on Intel, a measured\n0.78x. An earlier estimate of 0.65x was weighted by browsertime, which gains\nmore on Apple Silicon than Talos does.\n\nAWSY is validated on try as of 2026-09-17, revision 6e4a5726be90, which is\nthe first time it has run on Apple Silicon. awsy-base (4 min) and awsy-tp6\n(12 min) are both green on releng-hardware/gecko-t-osx-1500-m4 bare metal,\non macmini-m4-75 and macmini-m4-243, and both emit real Perfherder data:\nfour base-content suites for awsy-base, and five suites of nine subtests\neach for awsy-tp6. source-test-mozlint-perfdocs-verify is green against the\nregenerated docs on this base.\n\nRELOPS-2423 (phase 1a: Talos and AWSY parallel add, no Intel drop).\n\nCo-Authored-By: Claude Opus 5 (1M context) \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306128\n", "files": ["taskcluster/test_configs/test-platforms.yml", "testing/perfdocs/generated/awsy.md", "testing/perfdocs/generated/talos.md"], "git_node": "63ab23d631100eaa97bf027b5d0df859eb73ecf6", "git_parents": ["ed41a4e0cf957d9d32413bcb5682651e6dc189ce"], "node": "3fe7b8961f371371201297c842fc4c9c3817399b", "parents": ["54cd473aca90b4d6e9a5393b41a4c2ef106a2575"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066486 - Added text under Wayback Button r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321305\n", "files": ["mobile/android/android-components/components/browser/errorpages/README.md", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorPages.kt", "mobile/android/android-components/components/browser/errorpages/src/main/res/values/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/test/java/mozilla/components/browser/errorpages/ErrorPagesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/WaybackMachineErrorPageTest.kt", "mobile/android/fenix/app/src/main/assets/lowMediumErrorPages.js", "mobile/android/fenix/app/src/main/assets/low_and_medium_risk_error_pages.html", "mobile/android/fenix/app/src/main/assets/low_and_medium_risk_error_style.css"], "git_node": "64501d9c2ee6674672e22f03b84936286d62f8d2", "git_parents": ["63ab23d631100eaa97bf027b5d0df859eb73ecf6"], "node": "c83017b60af446f3f3cff90350fe166310bb6d1e", "parents": ["3fe7b8961f371371201297c842fc4c9c3817399b"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2073178 - test(webgpu): apply CTS test promotions missed by various patches r=webgpu-reviewers,teoxoy\n\nApplies CTS test promotions missed by various patches (reminder to use `moz-webgpu-cts update-backlog \u2026` next time\u2026! \ud83d\ude05):\n\n- D322331 (CC @teoxoy, @nical)\n   - `webgpu:api,operation,rendering,3d_texture_slices:multiple_color_attachments,same_slice_with_diff_mip_levels:*`\n   - `webgpu:api,operation,rendering,3d_texture_slices:one_color_attachment,mip_levels:*`\n   - `webgpu:api,validation,render_pipeline,inter_stage:type:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,clearBuffer:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,computePass,dispatch:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,copyBufferToBuffer:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,copyBufferToTexture:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,copyTextureToBuffer:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,copyTextureToTexture:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,renderPass,draw:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,renderPass,renderBundle:*`\n   - `webgpu:api,validation,state,device_lost,destroy:command,resolveQuerySet:*`\n- D324946 (CC @teoxoy and myself)\n   - `webgpu:api,validation,buffer,mapping:mapAsync,state,mappingPending:*`\n- D324573 (CC @aleiserson and myself)\n   - `webgpu:api,operation,memory_sync,texture,readonly_depth_stencil:sampling_while_testing:*`\n   - `webgpu:api,validation,resource_usages,texture,in_render_common:subresources,depth_stencil_attachment_and_bind_group:*`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327013\n", "files": ["testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/memory_sync/texture/readonly_depth_stencil/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/rendering/3d_texture_slices/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/service.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/shared.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/render_pipeline/inter_stage/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/resource_usages/texture/in_render_common/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/state/device_lost/destroy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/shader_io/locations/cts.https.html.ini"], "git_node": "d482afc715b1f542e8d47a606194c1d2155f9426", "git_parents": ["64501d9c2ee6674672e22f03b84936286d62f8d2"], "node": "1bb0ce4bee39352e48a3701dc9e47609475ebc59", "parents": ["c83017b60af446f3f3cff90350fe166310bb6d1e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Add LICENSES and LICENSED_UNDER moz.build variables r=firefox-build-system-reviewers,sergesanspaille,ahochheiden\n\nLets a directory declare the third-party license notices it owns, and which\nlicenses cover its code:\n\n    LICENSES += [\"harfbuzz\"]\n    LICENSES[\"harfbuzz\"].title = \"HarfBuzz License\"\n    LICENSES[\"harfbuzz\"].text = \"LICENSE-NOTICE.txt\"\n\n    LICENSED_UNDER += [\"MIT\"]\n    LICENSED_UNDER[\"MIT\"].paths = [\"vendor/lodash.js\"]\n\nThe build backend aggregates every declaration reachable in the current\nconfiguration into \u003cobjdir\u003e/licenses.json. Because an unconfigured directory\nis never traversed, a license is only recorded in builds that ship the code\nit covers, which is what the hand-written #ifdefs in license.html did.\n\nNothing declares these yet; a later commit moves license.html onto them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325282\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/data/licenses/lib/moz.build", "python/mozbuild/mozbuild/test/backend/data/licenses/lib/notice.html", "python/mozbuild/mozbuild/test/backend/data/licenses/mit.txt", "python/mozbuild/mozbuild/test/backend/data/licenses/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/licenses-missing-text-file/moz.build", "python/mozbuild/mozbuild/test/frontend/data/licenses-missing-title/moz.build", "python/mozbuild/mozbuild/test/frontend/data/licenses-missing-title/notice.txt", "python/mozbuild/mozbuild/test/frontend/data/licenses/lib/moz.build", "python/mozbuild/mozbuild/test/frontend/data/licenses/lib/notice.txt", "python/mozbuild/mozbuild/test/frontend/data/licenses/moz.build", "python/mozbuild/mozbuild/test/frontend/data/licenses/shared/mit.txt", "python/mozbuild/mozbuild/test/frontend/data/licenses/shared/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "eec67562bd0becfbbf7cb1dfeb348ceb127cd225", "git_parents": ["d482afc715b1f542e8d47a606194c1d2155f9426"], "node": "01518ac0c1d583f2a7b58b3572b56ac0096a9ca9", "parents": ["1bb0ce4bee39352e48a3701dc9e47609475ebc59"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070545 - Use runTest's TestScope in InstallReferrerHandlingServiceTest to keep structured concurrency. r=pollymce,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325183\n", "files": ["mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingServiceTest.kt"], "git_node": "2495e404e1acec56f8605620e0a92e097edd4803", "git_parents": ["eec67562bd0becfbbf7cb1dfeb348ceb127cd225"], "node": "db312922a4045ca1df6c712c463a6ec181411f0d", "parents": ["01518ac0c1d583f2a7b58b3572b56ac0096a9ca9"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072590: apply code formatting via Lando\" for causing bustages in Perfetto.h.\n\nThis reverts commit 09d9a4e2a8ad9b2af5311ef77c6d3c3e588f95ad.\n\nRevert \"Bug 2072590 - Migrate CPUSpeedMarker to BaseMarkerType r=canova,profiler-reviewers\"\n\nThis reverts commit d75ff36bad313b4c4f89105c588040be196ebb97.\n\nRevert \"Bug 2072590 - Support chart fields in BaseMarkerType r=profiler-reviewers,canova\"\n\nThis rever