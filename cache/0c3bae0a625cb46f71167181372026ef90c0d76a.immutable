0ac6bdbc36ab2ecb21bd6"], "node": "7c3644b86b349ecbcef95dbb093c47478210d065", "parents": ["78468f5015308a16a7b1b9f2f3395689d125e58a"], "tags": []}, {"author": "Harshit \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067218 - Stop the notification helper when the pref is disabled. r=aborondo,nrishel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322521\n", "files": ["Cargo.lock", "build/workspace-hack/Cargo.toml", "toolkit/mozapps/pushnotificationhelper/Cargo.toml", "toolkit/mozapps/pushnotificationhelper/PushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/WindowsPushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/src/lifecycle.rs", "toolkit/mozapps/pushnotificationhelper/src/main.rs", "toolkit/mozapps/pushnotificationhelper/tests/xpcshell/test_push_notification_helper.js"], "git_node": "3677152c51e4ff3588af9f4e4b321a7d2609a1cd", "git_parents": ["c97c572f155e34a846e6d17dda7ceb3a87343b34"], "node": "7d78dd3992f1e598657892ed31c42cf9c7f60d65", "parents": ["7c3644b86b349ecbcef95dbb093c47478210d065"], "tags": []}, {"author": "Harshit \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067218 - Add a mutex to avoid duplicate helpers for a profile. r=aborondo,nrishel\n\ntemp: guard test\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322655\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/lifecycle.rs", "toolkit/mozapps/pushnotificationhelper/src/main.rs"], "git_node": "b29233727193bc656e0861b04073829049241542", "git_parents": ["3677152c51e4ff3588af9f4e4b321a7d2609a1cd"], "node": "7ff1aab4dfeadb3b95f9a50bc73bf02f89bb1d05", "parents": ["7d78dd3992f1e598657892ed31c42cf9c7f60d65"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996020 - use I420Buffer::CreateOrNull in VideoFrameBufferPool::CreateI420Buffer. r=bwc\n\nLooking at the crash reports, even after converting DesktopCaptureImpl::OnCaptureResult\nto use the VideoFrameBufferPool, we're still seeing occasional crashes\nin AlignedMalloc so use CreateOrNull so we don't crash in OOM situations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326269\n", "files": ["third_party/libwebrtc/common_video/video_frame_buffer_pool.cc"], "git_node": "1e4cac5e315796e0ef885a9dbb0e8d5977c751dd", "git_parents": ["b29233727193bc656e0861b04073829049241542"], "node": "93cb056a0c8220b5b364f9cd1204ac34bb0d163d", "parents": ["7ff1aab4dfeadb3b95f9a50bc73bf02f89bb1d05"], "tags": []}, {"author": "gazhibekova-hub \u003cgazhibekova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068252 - Update search_the_web telemetry for the snippets-based Exa flow r=bjohns\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323277\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/search/SearchProviders.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/models/tests/xpcshell/test_Chat.js", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs"], "git_node": "180555f57f85ebb6f67e13d134d1962435938b25", "git_parents": ["1e4cac5e315796e0ef885a9dbb0e8d5977c751dd"], "node": "097706a61f7efb2c382c4909132227788e0dd4ce", "parents": ["93cb056a0c8220b5b364f9cd1204ac34bb0d163d"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2049352 - Clear mCallback before invoking Done() in the file, color, and application pickers. r=jld,spohl,gtk-reviewers,emilio\n\nSeveral picker and chooser handlers invoke mCallback and null the member\nafterwards. Move the callback into a local before invoking it, and return\nearly when it is already null, so each handler runs at most once.\n\nHandlers updated:\n  * widget/nsFilePickerProxy.cpp (Recv__delete__, ActorDestroy)\n  * widget/gtk/nsFilePicker.cpp (DoneNonPortal, DonePortal, DoneCommon)\n  * widget/gtk/nsColorPicker.cpp (Done)\n  * widget/gtk/nsApplicationChooser.cpp (Done)\n  * widget/cocoa/nsColorPicker.mm (Done)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309753\n", "files": ["widget/cocoa/nsColorPicker.mm", "widget/gtk/nsApplicationChooser.cpp", "widget/gtk/nsColorPicker.cpp", "widget/gtk/nsFilePicker.cpp", "widget/gtk/nsFilePicker.h", "widget/nsFilePickerProxy.cpp"], "git_node": "9218e63542cccf76054284d84f95c07f1b0b4332", "git_parents": ["180555f57f85ebb6f67e13d134d1962435938b25"], "node": "47f6265d8fb56a36b083f3dd546ddc039b83d4fc", "parents": ["097706a61f7efb2c382c4909132227788e0dd4ce"], "tags": []}, {"author": "SaaSha Pina \u003csaasha@heysparkbox.com\u003e", "branch": "default", "desc": "Bug 2049273 - Apply Nova dialog backdrop radius at all UI densities and match alert dialog backdrop radius to Nova content area. r=desktop-theme-reviewers,tabbrowser-reviewers,niklas,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316986\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "cd26e830fbd08d25651325c59cb4185d4b074605", "git_parents": ["9218e63542cccf76054284d84f95c07f1b0b4332"], "node": "034ff623b0e29fc9da4ad716cfcb7a22f080755f", "parents": ["47f6265d8fb56a36b083f3dd546ddc039b83d4fc"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069399 - Hold references to the print dialog's header/footer dropdowns. r=stransky,gtk-reviewers,emilio\" for causing build bustages @ nsPrintDialogGTK\n\nThis reverts commit ac352a8c1c3b11f205c746e42935b942b8ad793c.\n", "files": ["widget/gtk/nsPrintDialogGTK.cpp"], "git_node": "3091c41cccca5c9b4b39dca19471219248bbc220", "git_parents": ["cd26e830fbd08d25651325c59cb4185d4b074605"], "node": "41a81d9096429549632a74dd4a05d0313f4b994f", "parents": ["034ff623b0e29fc9da4ad716cfcb7a22f080755f"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068434. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324819\n", "files": ["gfx/wr/swgl/src/rasterize.h"], "git_node": "e3fd933b6b9eab9d6d9ea44f80638997d87e4c27", "git_parents": ["3091c41cccca5c9b4b39dca19471219248bbc220"], "node": "d04ed4435a17f9f0a6ae53374198ff00c7298b1d", "parents": ["41a81d9096429549632a74dd4a05d0313f4b994f"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030947 - Use moz-message-bar instead of custom message bars r=fluent-reviewers,settings-reviewers,desktop-theme-reviewers,places-reviewers,hjones,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323337\n", "files": ["browser/components/places/metadataViewer/interactionsViewer.css", "browser/components/places/metadataViewer/interactionsViewer.html", "browser/components/preferences/dialogs/browserLanguages.xhtml", "browser/components/preferences/main.inc.xhtml", "browser/components/preferences/main.js", "browser/locales/en-US/browser/preferences/languages.ftl", "browser/themes/shared/preferences/preferences.css", "toolkit/themes/shared/in-content/common-shared.css"], "git_node": "ba38c8ed60ee92f9a821edb4695e9a601cb899af", "git_parents": ["e3fd933b6b9eab9d6d9ea44f80638997d87e4c27"], "node": "2adaa57f01b483aef52d5954f70d07894d5993a0", "parents": ["d04ed4435a17f9f0a6ae53374198ff00c7298b1d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069552 - Stylelint: fold no-background-without-text-color into use-paired-color-tokens r=hjones,desktop-theme-reviewers\n\nThe two checks cannot fire on the same block \u2014 the pairing check needs both halves declared and the other only fires when the text color is absent \u2014 so the merged rule reports and fixes exactly what the two rules did, under one name. The state-variant exemption stays scoped to the missing-text-color check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323811\n", "files": [".stylelintrc.js", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/themes/shared/identity-block/identity-block.css", "browser/themes/shared/tabbrowser/tabs.css", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/no-background-without-text-color.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "mobile/android/themes/geckoview/config.css", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/index.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/no-background-without-text-color.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/use-paired-color-tokens.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-background-without-text-color.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.no-text-color.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.not-paired.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.tests.mjs"], "git_node": "43beaeb8475b261efc31765a78aa8bf44dae5970", "git_parents": ["ba38c8ed60ee92f9a821edb4695e9a601cb899af"], "node": "e1f762d3758c8731b589a0b9047c9de0a58d9118", "parents": ["2adaa57f01b483aef52d5954f70d07894d5993a0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1372506 - Let skpdf ride the trains. r=layout-reviewers,gfx-reviewers,TYLin,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326234\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "5a679b379d3f18594f70fe1fc24a6c3a72d34bc6", "git_parents": ["43beaeb8475b261efc31765a78aa8bf44dae5970"], "node": "fab8592dfb65896fbdb74af09c07f2ae2ea57c48", "parents": ["e1f762d3758c8731b589a0b9047c9de0a58d9118"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072031 - Pass blocks to MARS when calling through MAC r=mconley\n\nBlocks is now a supported parameter inside of the request options.\nThis can be automatically be pulled from `unifiedAds.blockedAds`.\nThe exception is that TopSites passes in the current default search.\nIn this case, we pass in additional blocks, matching old code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326016\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsClient.js", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "1528906c189e72e57ae3764cac17bf72760c5323", "git_parents": ["5a679b379d3f18594f70fe1fc24a6c3a72d34bc6"], "node": "cf20f2525d78d2519c9773b03bb00a71c4bbb99c", "parents": ["fab8592dfb65896fbdb74af09c07f2ae2ea57c48"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071068 - Use SegmentedVector on the popup painting code. r=layout-reviewers,jfkthame\n\nTo prevent WeakFrame from being memmove()d. This is an upliftable\nlow-risk fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325322\n", "files": ["layout/xul/nsXULPopupManager.cpp"], "git_node": "3cb72c0e3c5f8c4225d980d2316b7c21985b209c", "git_parents": ["1528906c189e72e57ae3764cac17bf72760c5323"], "node": "80aa02dcfc426252aed9d24c851234c7f52497c4", "parents": ["cf20f2525d78d2519c9773b03bb00a71c4bbb99c"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068189 - Render the active group's tabs as favicon circles in the strip r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326248\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupsTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripContent.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripStore.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripReducerTest.kt"], "git_node": "31f6caa59401688be4069822ab59d6e9704a5657", "git_parents": ["3cb72c0e3c5f8c4225d980d2316b7c21985b209c"], "node": "df17ebf0536c5384483850fa276e12190ccf2272", "parents": ["80aa02dcfc426252aed9d24c851234c7f52497c4"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069986 - Create base template for HNT card-stack r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326033\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content-src/components/MultiStageAboutWelcome.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/components/asrouter-newtab-multistage/asrouter-newtab-multistage.scss", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAWProton.test.jsx", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "bc6a6aa2df09a18574315ad5eb8b8cfc49496629", "git_parents": ["31f6caa59401688be4069822ab59d6e9704a5657"], "node": "14f1d6d50f07558770eb35d4a30f131c776d4fc1", "parents": ["df17ebf0536c5384483850fa276e12190ccf2272"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072038 - Simplify nsIFrame::GetNormalRect(). r=layout-reviewers,boris\n\n`GetNormalPosition()` already falls back to `GetPosition()` when the\nframe has no `NormalPositionProperty`.\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326023\n", "files": ["layout/generic/nsIFrame.cpp"], "git_node": "c135ecdfcbc39cbf4cb3a1497d091254f23396f0", "git_parents": ["bc6a6aa2df09a18574315ad5eb8b8cfc49496629"], "node": "683207d6916055ddd42b014fa33854e7c5fbd144", "parents": ["14f1d6d50f07558770eb35d4a30f131c776d4fc1"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072038 - Don't register SVG internal frames to StickyScrollContainer since they can't be sticky positioned. r=layout-reviewers,emilio\n\nThe old code adds SVG internal frames and frames inside SVG text\nsubtree to `StickyScrollContainer`, so we did some sticky positioning\ncomputation for them. This is not needed because sticky positioning\nhas no effect on them (they don't participate in the CSS box model).\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326024\n", "files": ["layout/generic/StickyScrollContainer.cpp", "layout/generic/StickyScrollContainer.h", "layout/generic/nsIFrame.cpp"], "git_node": "dad2ad4606152e22b19b1fc61cc5fd77248a10a4", "git_parents": ["c135ecdfcbc39cbf4cb3a1497d091254f23396f0"], "node": "2bf04fbc67d3024d6a8df9719fbbd7538d6454b0", "parents": ["683207d6916055ddd42b014fa33854e7c5fbd144"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072038 - Don't recompute position for frames in an SVG text subtree. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nThis prevents setting `NormalPositionProperty` for frames with\n`position:relative` style in an SVG text subtree.\n\nPromote `NS_ASSERTION` to `MOZ_ASSERT` so that the added WPT crashtest\nwill trigger that assertion without the fix in `RecomputePosition()`.\n\nThis patch doesn't change user observable behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326025\n", "files": ["layout/generic/ReflowInput.cpp", "layout/style/RestyleManager.cpp", "testing/web-platform/tests/css/css-position/crashtests/dynamic-change-inset-svg-text-subtree.html"], "git_node": "3b3a1f98dc11d7e3cbacacbe2fd132617dfb7826", "git_parents": ["dad2ad4606152e22b19b1fc61cc5fd77248a10a4"], "node": "f5c79dac66134f7b4ca6be8503de8aa936457c53", "parents": ["2bf04fbc67d3024d6a8df9719fbbd7538d6454b0"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072038 - Don't compute the sticky position when there is no normal position. r=layout-reviewers,emilio\n\nDon't waste time calling `ComputePosition()` if it is not used.\n\nAlso drop the `NS_WARN_IF`, because we have legit cases where we\nshould bail out early, and updated the comment accordingly.\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326026\n", "files": ["layout/generic/StickyScrollContainer.cpp"], "git_node": "5286e4a2eb926cf946acf09cf017075c2a15e0e6", "git_parents": ["3b3a1f98dc11d7e3cbacacbe2fd132617dfb7826"], "node": "eb6297ba09dc50430b3bf5739a7fa4ffeb094f80", "parents": ["f5c79dac66134f7b4ca6be8503de8aa936457c53"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072038 - Remove dead code in StickyScrollContainer::UpdatePositions(). r=layout-reviewers,emilio\n\nSince bug 2031798 [1] moved the registration into\n`nsIFrame::HandlePrimaryFrameStyleChange()`, only the primary frame is\nadded to `mFrames`, so the code that removes non-primary frames in\n`UpdatePositions()` is not needed. Assert the invariant instead.\n\n[1] https://hg.mozilla.org/mozilla-central/rev/ac97bc3bb967\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326027\n", "files": ["layout/generic/StickyScrollContainer.cpp"], "git_node": "a663f6b64c73b60eacf975aa842c962c0c3fecf0", "git_parents": ["5286e4a2eb926cf946acf09cf017075c2a15e0e6"], "node": "f5e0bb2e143cbcecfa1c4d4c77d2f20aa57ba143", "parents": ["eb6297ba09dc50430b3bf5739a7fa4ffeb094f80"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062881 - Fix alignment issues with sidebar extension header r=desktop-theme-reviewers,sidebar-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325171\n", "files": ["browser/components/sidebar/sidebar-panel-header.css"], "git_node": "7f784d01219744bdf60152f16fa305c4ba8504b8", "git_parents": ["a663f6b64c73b60eacf975aa842c962c0c3fecf0"], "node": "8cf5e19c86e2508d4c039dd3ba50d909580685d9", "parents": ["f5e0bb2e143cbcecfa1c4d4c77d2f20aa57ba143"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071481 - (TS8024) Fix function calls JSDoc to match their signatures r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325536\n", "files": ["browser/extensions/new