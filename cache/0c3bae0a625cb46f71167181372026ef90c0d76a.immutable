.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchmode.js"], "git_node": "f42d319e980288de93510ecb05a0c6d2f4efc469", "git_parents": ["c430345a1760a844fdc5a16d75ce6b22098e25ed"], "node": "54fa403c0708d3ebbd8315704a7a830b4bdeb15e", "parents": ["42c6441b50305ae9d60515d3cb9db1c4d0b2d107"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073120 - Wait past the headless extraction timeout for mock engines in MockEngineManager. r=rrando,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328268\n", "files": ["browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs"], "git_node": "b35deec3a1a65fc277f9e4c16301bb620eb6b7d3", "git_parents": ["f42d319e980288de93510ecb05a0c6d2f4efc469"], "node": "fcef88f8dca03944f8615c0df30cc32af1a49c9d", "parents": ["54fa403c0708d3ebbd8315704a7a830b4bdeb15e"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074886 - Generate the decision task source bundle concurrently with graph generation. r=taskgraph-reviewers,jcristau\n\nThe bundle only needs head_rev and repository_type, and artifacts are only visible to other tasks once the decision task finishes, so there is no need to produce it on the critical path right before creating tasks.\n\nIn a try decision task, writing the bundle took 2.7s right before\ncreating tasks. With this change, the decision task waited 0.0s for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328558\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_decision.py"], "git_node": "c87544219c6cfe7d1833e43bd30fb00d699d7722", "git_parents": ["b35deec3a1a65fc277f9e4c16301bb620eb6b7d3"], "node": "59bd16921327bec1b6bbe350336c7f583725c6d6", "parents": ["fcef88f8dca03944f8615c0df30cc32af1a49c9d"], "tags": []}], "date": 1790224787, "git_changesets": ["ba7e3042d024850fbae1d21d0b67951e90457ae8