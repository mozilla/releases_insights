.mozilla.com/D325707\n", "files": ["toolkit/components/normandy/docs/suitabilities.md"], "git_node": "41bc2d41460797f1337819d68dd97e36c25f1202", "git_parents": ["951e7d9947af86909bb918639aaf64df0925cb4f"], "node": "1b8b2b8287b1ea1d774acd9b499dec1087c8f006", "parents": ["482ba0ff8ac2bbc6e237229d2d4df6b8cb9f65a6"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Name PictureInPictureChildVideoWrapper rather than link to a missing page r=kpatenio\n\nThe API reference this pointed at was never converted from the wiki.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325708\n", "files": ["toolkit/components/pictureinpicture/docs/index.md"], "git_node": "0439a0fc3cc286c81354d0064f91ad661c993130", "git_parents": ["41bc2d41460797f1337819d68dd97e36c25f1202"], "node": "8a0638d76d56463bf5e0df0a91d7e01441552ddc", "parents": ["1b8b2b8287b1ea1d774acd9b499dec1087c8f006"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2069801 - Use ViewConfiguration to get text cursor blink time. r=geckoview-reviewers,tcampbell\n\nAndroid 16 QPR2 has a new API to get text cursor blink time. This value\nwas hidden value from Android 15, and Android 15 has\n`ACCESSIBILITY_TEXT_CURSOR_BLINK_INTERVAL_MS` as secure settings. But\nthis wasn't accessible since this marked as `@hidden`.\n\nAlso, there is no way to override this from application, I could not\nfind to write a unit test for this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323984\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "widget/android/bindings/ViewConfiguration-classes.txt", "widget/android/moz.build", "widget/android/nsLookAndFeel.cpp"], "git_node": "9633cd24c5e055da3de6175c4e708cfaac19edc4", "git_parents": ["0439a0fc3cc286c81354d0064f91ad661c993130"], "node": "9777b67f6f4554e2fc6349ff44de1959cf1a618a", "parents": ["8a0638d76d56463bf5e0df0a91d7e01441552ddc"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2071810 - Treat a password field revealed by the reveal button as unmasked. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325966\n", "files": ["editor/libeditor/TextEditor.cpp", "editor/libeditor/tests/test_cut_copy_password.html"], "git_node": "748d59a2ef84911a6968cec6ec1015dc3e660d2d", "git_parents": ["9633cd24c5e055da3de6175c4e708cfaac19edc4"], "node": "dae5f4445ea2976af798dc45a917b207456694c6", "parents": ["9777b67f6f4554e2fc6349ff44de1959cf1a618a"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix broken links in the Android documentation r=android-reviewers,geckoview-reviewers,tcampbell DONTBUILD\n\nThe README, git guide and shared android links pointed outside the\ndocumentation tree or at anchors that do not exist, and ADR 0002 was missing\nfrom the toctree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325699\n", "files": ["mobile/android/docs/geckoview/contributor/for-gecko-engineers.md", "mobile/android/docs/index.md", "mobile/android/docs/shared/android/CONTRIBUTING.md", "mobile/android/docs/shared/android/CONTRIBUTING_code.md", "mobile/android/docs/shared/android/fretboard.md", "mobile/android/focus-android/docs/Architecture-Decisions.md", "mobile/android/focus-android/docs/Content-blocking.md", "mobile/android/focus-android/docs/Home.md"], "git_node": "f2835b872186ea47d47845269f366d45cda4423b", "git_parents": ["748d59a2ef84911a6968cec6ec1015dc3e660d2d"], "node": "cc64a41d0be1ff8fce35fa49ae1a24e3be68cdfe", "parents": ["dae5f4445ea2976af798dc45a917b207456694c6"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071831 - Include autofill.db (Rust store) in profile backup r=joschmidt,kpatenio\n\nDifferential Revision: https://phabrica