s/aiwindow/ui/test/browser/browser_aitab_blocks.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDate.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDelete.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml", "browser/locales-preview/aiWindow.ftl"], "git_node": "384314f38c6350ec9bfde065ba21be497d8850a8", "git_parents": ["733b79bcbba699ea8cb9ffb79847d93b58b9db58"], "node": "15d4c2c9d8d05e0d9d569e35919da8a779d7df97", "parents": ["042df16c298a6d58c517273ec058ee6ff195eaf4"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070444 - Run addon tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\" for causing build-signing timeouts\n\nThis reverts commit 1d22dc491631b38e6a1f21cbfd44fa7989dbed1b.\n\nRevert \"Bug 2070444 - Run artifact-build tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\" for causing build signing failures\n\nThis reverts commit 9bfd8889e85c3f7544217babb9796f1673e75718.\n", "files": ["taskcluster/kinds/addon/kind.yml", "taskcluster/kinds/artifact-build/kind.yml"], "git_node": "be92328f2e2fbeabd2f8b764d4d249700b27298d", "git_parents": ["384314f38c6350ec9bfde065ba21be497d8850a8"], "node": "564e0d94b8d9200b7fe332d5c5a878154081a465", "parents": ["15d4c2c9d8d05e0d9d569e35919da8a779d7df97"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1985986 - Update wpt metadata\n", "files": ["testing/web-platform/meta/css/CSS2/bidi-text/bidi-005a.xht.ini", "testing/web-platform/meta/css/CSS2/bidi-text/bidi-006a.xht.ini", "testing/web-platform/meta/css/CSS2/bidi-text/bidi-007a.xht.ini", "testing/web-platform/meta/css/CSS2/bidi-text/bidi-008a.xht.ini", "testing/web-platform/meta/css/CSS2/bidi-text/bidi-009a.xht.ini", "testing/web-platform/meta/css/CSS2/bidi-text/bidi-010a.xht.ini"], "git_node": "935b29d847f4f4650685f3d42a6f2e535379fb2e", "git_parents": ["be92328f2e2fbeabd2f8b764d4d249700b27298d"], "node": "24ec4191608c08b47f5a1f3b292dddac60e68bb7", "parents": ["564e0d94b8d9200b7fe332d5c5a878154081a465"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068188 - Use a string-literal wrapper type for simple payload marker field names. r=bas,profiler-reviewers,canova\" for causing build bustages @ ProfilerMarkers.h\n\nThis reverts commit d38eccd9a9ae399526274284ce5cea7f162ded15.\n", "files": ["tools/profiler/public/ProfilerMarkers.h"], "git_node": "52d9d7c38508f6f77746c046933bd8874fa742ff", "git_parents": ["935b29d847f4f4650685f3d42a6f2e535379fb2e"], "node": "69bee89f1ec789b4428ff96d1577052ad1004ada", "parents": ["24ec4191608c08b47f5a1f3b292dddac60e68bb7"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071423 - Make SwitchTabsBaselineProfile CUJ correctly clean up open tabs r=android-reviewers,aaronmt,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325506\n", "files": ["mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/utils/UiDevice.kt"], "git_node": "ec5923067933977f12faff96c9728f7947d977f6", "git_parents": ["52d9d7c38508f6f77746c046933bd8874fa742ff"], "node": "2a27b9ba0e2ecdd279c59ad2e5dd0a0a1dd181dd", "parents": ["69bee89f1ec789b4428ff96d1577052ad1004ada"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070984 - Use inputmode=search for the search bars. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325066\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser.toml", "browser/components/urlbar/tests/browser-UrlbarInput/browser_inputmode.js", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_inputmode.js", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/components/urlbar/tests/browser/searchbar/browser_inputmode.js"], "git_node": "e0f4201b41159dfefc0eaf7edcb58b0663e341b3", "git_parents": ["ec5923067933977f12faff96c9728f7947d977f6"], "node": "fcba543cf31b9b4559f13f209d44c580eee06e23", "parents": ["2a27b9ba0e2ecdd279c59ad2e5dd0a0a1dd181dd"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 1 - Rename ModulePaths to ModuleIdentifiers r=win-reviewers,necko-reviewers,media-playback-reviewers,padenot,gstoll\n\nRename-only, since ModuleIdentifiers will be used in later parts, instead of\njust paths.  No substantive changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324702\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPPlatform.cpp", "dom/media/gmp/GMPPlatform.h", "dom/media/gmp/PGMP.ipdl", "dom/media/ipc/PRDD.ipdl", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h"], "git_node": "75b4e31ffc30e1c9736965c18f686fa28e10891d", "git_parents": ["e0f4201b41159dfefc0eaf7edcb58b0663e341b3"], "node": "cbe89510a04b2fc063c8c69f153e75b6a79484b4", "parents": ["fcba543cf31b9b4559f13f209d44c580eee06e23"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 2 - Pass child process's module list by section handle r=win-reviewers,gstoll\n\nChild processes now report loaded DLLs to the parent by section HANDLE instead\nof by filename.  The DLL blocklist's NtMapViewOfSection hook already receives\nthe section a module is being mapped from, so it duplicates that section,\nread-only, onto the ModuleLoadInfo for the load.  The parent identifies the\nmodule from the HANDLE.\n\nBecause the section outlives the view, this also fixes reporting for two kinds\nof load: a module the blocklist rejected, which is unmapped immediately, and a\nmodule unloaded before the parent processed the batch.  Previously, either\ncould be deleted before the parent had a chance to consider them.\n\nA handle cannot be forged into a reference to a different file and a child can\nonly send one it holds.  ValidateAndResolveModuleSection sanity checks:\n\n1. The section must map, and the view must be MEM_IMAGE. A data section can\n   be made over any openable file but an image section means the kernel\n   accepted the file as a PE and the child's image-load policy applied to it.\n2. The file must not be on a remote device.\n3. The file must not carry a mandatory integrity label below medium.\n\nThese checks replicate the checks of the MITIGATION_IMAGE_LOAD_NO_REMOTE and\nMITIGATION_IMAGE_LOAD_NO_LOW_LABEL child sandbox behaviors.  A child\ncan create a non-IMAGE section over any file it can open, so what it hands us\nis not bounded by the image-load policy.  The check avoid considering such\nfiles at all.  This currently applies to all child processes: content, gpu,\nRDD, socket, utility (all kinds), and GMP.  All have these sandbox mitigations.\n\nAlso fixes a couple of ways that a version resource could misuse VerQueryValueW's\noutput in the parent: a zero length underflowing to SIZE_MAX in\nQueryStringValue and a too-short buffer dereference in GetFromImage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324703\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPPlatform.h", "mozglue/misc/NativeNt.h", "toolkit/xre/dllservices/ModuleVersionInfo.cpp", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h"], "git_node": "476da53d95d85efbe5b540f5dce3f29b425c72c5", "git_parents": ["75b4e31ffc30e1c9736965c18f686fa28e10891d"], "node": "6265b5ab33a0dbcd37856ed6b176b53a6a477ca5", "parents": ["cbe89510a04b2fc063c8c69f153e75b6a79484b4"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 3 - Test that UntrustedModulesProcessor rejects invalid modules r=win-reviewers,gstoll\n\nCheck that ValidateAndResolveModuleSection rejects descriptors that are\nnon-IMAGE sections or are for below-medium-integrity modules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324704\n", "files": ["toolkit/xre/dllservices/tests/gtest/TestModuleFileValidation.cpp", "toolkit/xre/dllservices/tests/gtest/moz.build"], "git_node": "800b21b1dbee95940b5d919bf1069ea6a7c7671d", "git_parents": ["476da53d95d85efbe5b540f5dce3f29b425c72c5"], "node": "8508d9df083abd098a0c174ac8c08c9b2a8b5cc8", "parents": ["6265b5ab33a0dbcd37856ed6b176b53a6a477ca5"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 4 - Add DLL-reporting failures to the third-party-modules ping r=win-reviewers,TravisLong,gstoll\n\nNow that the parent identifies a child process's modules from the section\nhandle the child sends, and silently skips any handle it cannot identify,\nwe will need telemetry for how often that skipping happens. This patch\nadds counters for that.\n\nunverifiableLoads: the number of module loads in child processes where the DLL\nblocklist hook reached the load but failed to duplicate the section handle.\n\nrejectedSections: the number of module section handles a child process sent\nto the parent that it refused as invalid module section handles.\n\nThe counters are per-process and are only ever incremented for child\nprocesses, so the browser process reports zero for both. The counters are\nreported by the process using the module, so their accuracy depends on\ntrusting the process itself. This is how the UntrustedModulesProcessor\nhas always worked, and is by design (for performance reasons).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324705\n", "files": ["toolkit/components/telemetry/docs/obsolete/collection/third-party-modules-ping.md", "toolkit/components/telemetry/metrics.yaml", "toolkit/components/telemetry/other/UntrustedModules.cpp", "toolkit/components/telemetry/other/UntrustedModulesDataSerializer.cpp", "toolkit/components/telemetry/tests/unit/test_ThirdPartyModulesPing.js", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/tests/gtest/TestModuleFileValidation.cpp", "toolkit/xre/dllservices/tests/gtest/TestUntrustedModules.cpp"], "git_node": "b15f195b6f9f0bc430208fea1126646503c9fc86", "git_parents": ["800b21b1dbee95940b5d919bf1069ea6a7c7671d"], "node": "50abc9c1235828d244979be71fcd7b448ebcc1aa", "parents": ["8508d9df083abd098a0c174ac8c08c9b2a8b5cc8"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071187 - Enable parallel git checkout in bootstrap and `./mach vcs-setup` r=firefox-build-system-reviewers,sergesanspaille\n\ngit writes the working tree with one thread unless `checkout.workers` is set.\nWith one worker per core my testing shows checkouts 50% to 65% faster, both\nlocally and in CI. That covers the initial checkout after the clone and any\nlater checkout that moves HEAD across at least 100 files.\n\nMy local testing showed a switch between main and beta going from 23s to 14s.\nIt's possible for this setting to be a regression on niche hardware (slow hdds\nor very few cores), so we only set it by default when it hasn't already been\nset. A user can set `checkout.workers = 1` in the repo config or the global\nconfig and they will opt out for good.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325266\n", "files": ["python/mozboot/bin/bootstrap.py", "python/mozversioncontrol/mozversioncontrol/repo/git.py"], "git_node": "8e17871d1fd7cc225f17948578b76fd3492a40ba", "git_parents": ["b15f195b6f9f0bc430208fea1126646503c9fc86"], "node": "947960580131923d0b74dcc97fd761130e3d5015", "parents": ["50abc9c1235828d244979be71fcd7b448ebcc1aa"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068164 - Stand up the Tab Groups strip Redux boilerplate and telemetry middleware r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325462\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripTelemetryMiddleware.kt"], "git_node": "033035effccf8fab4e0a2e5a705fc1e6e3985d9b", "git_parents": ["8e17871d1fd7cc225f17948578b76fd3492a40ba"], "node": "87859f6504c0c173552219f7ae9c2493ddf0b4c2", "parents": ["947960580131923d0b74dcc97fd761130e3d5015"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1868969 - [devtools] Return no scopes when the frame front is gone, r=devtools-reviewers,bomsy.\n\ngetFrameScopes dereferenced whatever getActorByID returned. ThreadFront unmanages\nevery frame front from before(\"resumed\"), while the redux state learns of the\nresume only once the thread state resource is notified, so paused() can reach\nfetchScopes with a frame that validates against the state and has no front left.\n\nAn absent scope is the shape the rest of the pipeline already expects:\ngetMappedScopes documents a null, mockCommandClient resolves with one, and\nbuildOriginalScopes was the only place that assumed otherwise.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325044\n", "files": ["devtools/client/debugger/src/actions/pause/mapScopes.js", "devtools/client/debugger/src/client/firefox/commands.js"], "git_node": "8f10694afcbe032a7b38a7ee89dc4d044a53103b", "git_parents": ["033035effccf8fab4e0a2e5a705fc1e6e3985d9b"], "node": "7309fa1aca3de17ccc89a67235b133e461099289", "parents": ["87859f6504c0c173552219f7ae9c2493ddf0b4c2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071238 - [devtools] Retire the blackboxed round's event breakpoints before unblackboxing, r=devtools-reviewers,nchevobbe.\n\nThe XHR load and the 50ms timer the blackboxed round starts can land after its\n`wait(100)`, and unblackboxing first lets the timer pause the thread. The next\nround's navigation then runs \"beforeunload\" inside that pause, where\nEnterDebuggeeNoExecute refuses the debuggee, so the breakpoint the test waits\nfor never hits and the test times out with the toolbox window leaked.\n\nBug 2070797 removed this test's macOS skips on the strength of a mechanism that\nis not macOS-specific; that still wants a macOS debug rebuild push for a real\ndenominator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325407\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-event-breakpoints.js"], "git_node": "ff977d7c66bbd795a5890254b29588a854edda8d", "git_parents": ["8f10694afcbe032a7b38a7ee89dc4d044a53103b"], "node": "f561c5285c99d976871dd866bf552ff2f63c5e1f", "parents": ["7309fa1aca3de17ccc89a67235b133e461099289"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071227 - Give the DevTools CodeMirror 6 editors an accessible name, r=devtools-reviewers,bomsy.\n\nThe contentAttributes facet is public, so this needs no bundle regeneration. The\nname is overridable because not every consumer shows source code. The annotations\nremoved here were added by Bug 1849028.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325408\n", "files": ["devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/debugger/test/mochitest/browser_qz.toml", "devtools/client/locales/en-US/sourceeditor.properties", "devtools/client/shared/sourceeditor/editor.js"], "git_node": "f93d234739b5436393fc81f3cf6f69b7a80e0b63", "git_parents": ["ff977d7c66bbd795a5890254b29588a854edda8d"], "node": "61e229a5785490d8f7bf577fb577b05c52b067df", "parents": ["f561c5285c99d976871dd866bf552ff2f63c5e1f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071231 - Name the XHR and DOM mutation breakpoint remove buttons, r=devtools-reviewers,nchevobbe.\n\nCloseButton takes its accessible name from an optional tooltip prop, and these\ntwo panes were the only callers that never passed one. Making the prop required\nstops the next caller repeating it.\n\nThe a11y_checks annotation this retires was filed as Bug 1849028.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325411\n", "files": ["devtools/client/debugger/src/components/SecondaryPanes/DOMMutationBreakpoints.js", "devtools/client/debugger/src/components/SecondaryPanes/XHRBreakpoints.js", "devtools/client/debugger/test/mochitest/browser_qz.toml", "devtools/client/locales/en-US/debugger.properties", "devtools/client/shared/components/CloseButton.js"], "git_node": "a1561b3d9d16d82f3cf375d5d28c64b61483d26d", "git_parents": ["f93d234739b5436393fc81f3cf6f69b7a80e0b63"], "node": "ca926294506fd07a2776e89fb07325644cf9867c", "parents": ["61e229a5785490d8f7bf577fb577b05c52b067df"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "no bug - Null-check getenv(\"PATH\") in relrhack (Coverity CID 1601588) r=firefox-build-system-reviewers,ahochheiden\n\nNot a big deal but one less coverity issue\n\nget_path constructed a std::stringstream directly from std::getenv(\"PATH\"),\nwhich is undefined behaviour when PATH is unset. Return an empty search path\ninstead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325332\n", "files": ["build/unix/elfhack/relrhack.cpp"], "git_node": "e9348921decfe636998059eeb457d63c4527d449", "git_parents": ["a1561b3d9d16d82f3cf375d5d28c64b61483d26d"], "node": "43deea964bc2d6269dc533eb8a26f0e528dcf6c7", "parents": ["ca926294506fd07a2776e89fb07325644cf9867c"], "tags": []}, {"author": "Ed Lee \u003celee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070268 - Remove boilerplate from Smart Form Fill page extraction. r=gcardieri?\n\nSmart Form Fill's single extraction call in `SmartFormFillParent.#getPageText` passed `removeBoilerplate: false`, so menus, headers and footers were sent to the model verbatim for both the form's own page and each selected source tab. Because `MAX_PAGE_CONTENT_LENGTH` is split across the tabs and `sufficientLength` stops the DOM walk in document order, a boilerplate-heavy tab could exhaust its share of the budget before the walk reached content the model needs.\n\nSet `removeBoilerplate: true`, matching `GetPageContent.#runExtraction` in Tools.sys.mjs. The option degrades safely: PageExtractorChild falls back to the full DOM walk when `isProbablyReaderable` fails, which is typical for the form's own page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325057\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_generation.js"], "git_node": "dd23f8a786fcfedf6edc93aaad329102244c92e3", "git_parents": ["e9348921decfe636998059eeb457d63c4527d449"], "node": "a8ad36dff1a801f34c16af9533632af8b0e7076a", "parents": ["43deea964bc2d6269dc533eb8a26f0e528dcf6c7"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063209 - [devtools] Telemetry for stylesheet usage in the style editor r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324008\n", "files": ["devtools/client/framework/toolbox.js", "devtools/client/shared/metrics.yaml", "devtools/client/styleeditor/StyleEditorUI.sys.mjs", "devtools/client/styleeditor/StyleSheetEditor.sys.mjs", "devtools/client/styleeditor/test/browser.toml", "devtools/client/styleeditor/test/browser_styleeditor_telemetry.js"], "git_node": "dbfc60d6741020e38a14879b7c850c200f6a4f60", "git_parents": ["dd23f8a786fcfedf6edc93aaad329102244c92e3"], "node": "bbdd410a5e5aecf67967d7b91ebe938c223cda9c", "parents": ["a8ad36dff1a801f34c16af9533632af8b0e7076a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070984 - Use inputmode=search for the search bars. r=mak\" for causing mochitest leak failures\n\nThis reverts commit e0f4201b41159dfefc0eaf7edcb58b0663e341b3.\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser.toml", "browser/componen