ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartwindowMonitor.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "e898c68f5a257f98efaa0d84b405acf978ab3ef7", "git_parents": ["320c7eb7a11bb22574a038ebcf7cad48253c2e23"], "node": "8c796f923c4f60d4823e109b24d0ad11908175f9", "parents": ["ae561002dedeab5828c9bcd85a331d8f525920aa"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067218 - Add a mutex to avoid duplicate helpers for a profile. r=aborondo,nrishel\" for causing multiple marionette tests failures.\n\nThis reverts commit 95a29fb0af37af641f046a617f2978e0f15eaab8.\n\nRevert \"Bug 2067218 - Stop the notification helper when the pref is disabled. r=aborondo,nrishel\"\n\nThis reverts commit 476a5071469e8711e5784f3c2e84efbfe4db66db.\n\nRevert \"Bug 2067218 - Add a Nimbus-controlled pref gating the notification helper. r=iholmes\"\n\nThis reverts commit b71eec14bfc5602de9fb9ef0360251c0dc9a5811.\n\nRevert \"Bug 2067218 - Accept a --profile argument in the notification helper. r=aborondo,nrishel\"\n\nThis reverts commit 9847f371083119e1ef5204edaf3e948b0cea518a.\n", "files": ["Cargo.lock", "browser/app/profile/firefox.js", "browser/components/BrowserComponents.manifest", "build/workspace-hack/Cargo.toml", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/library/rust/moz.build", "toolkit/mozapps/pushnotificationhelper/Cargo.toml", "toolkit/mozapps/pushnotificationhelper/PushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/WindowsPushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/moz.build", "toolkit/mozapps/pushnotificationhelper/src/lifecycle.rs", "toolkit/mozapps/pushnotificationhelper/src/main.rs", "toolkit/mozapps/pushnotificationhelper/tests/xpcshell/test_push_notification_helper.js", "toolkit/mozapps/pushnotificationhelper/tests/xpcshell/xpcshell.toml"], "git_node": "b48578dc3b36271de9a4ce8937fb502df8fcbe70", "git_parents": ["e898c68f5a257f98efaa0d84b405acf978ab3ef7"], "node": "2b669a44320974a0ef31ff0d0ea755fa69d8706d", "parents": ["8c796f923c4f60d4823e109b24d0ad11908175f9"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071475: Disable secondary sentry data sources in Fenix. r=android-reviewers,jonalmeida,jdelorenzo\n\nSentry has a complex set of options and their defaults often change so begin to\nlock down our expectations and assert them. Functionally this patch also disables\nhealth pings, ANRs and caught-exception handling. We can revisit re-enabling them\nin the future when we have been tie in to Fenix settings and more test coverage.\nThese changes are also applied to Focus via the shared lib-crash code.\n\nThis also removes the Sentry performance monitor ContentProvider from startup since\nthe feature was already disabled for us.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325521\n", "files": ["mobile/android/android-components/components/lib/crash-sentry/src/main/AndroidManifest.xml", "mobile/android/android-components/components/lib/crash-sentry/src/main/java/mozilla/components/lib/crash/sentry/SentryService.kt", "mobile/android/android-components/components/lib/crash-sentry/src/test/java/mozilla/components/lib/crash/sentry/SentryFeatureGatesTest.kt", "mobile/android/android-components/components/lib/crash-sentry/src/test/java/mozilla/components/lib/crash/sentry/SentryServiceTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Analytics.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt"], "git_node": "b524a5c2c73e444fdc0104c214c46fd540aa6b98", "git_parents": ["b48578dc3b36271de9a4ce8937fb502df8fcbe70"], "node": "cee638665ed9e5a20a66674b8e64eae3fd0c3638", "parents": ["2b669a44320974a0ef31ff0d0ea755fa69d8706d"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064041 - Let a slow Organize Tabs clustering run finish and fill the panel in instead of dropping its groups r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324449\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_model.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_suggestions.js"], "git_node": "ea433875a76403af1aac330fc2033ed0e812783d", "git_parents": ["b524a5c2c73e444fdc0104c214c46fd540aa6b98"], "node": "88d0db0345a1d2c3d631b3bbd2178b19ceba7a2c", "parents": ["cee638665ed9e5a20a66674b8e64eae3fd0c3638"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060985 - Close three gaps in the Organize Tabs tests' shared fixture r=omarg\n\nThe fixture keeps the chat sidebar shut. Navigating a Smart Window off about:aiwindow auto-opens it, and its composer then autofocuses and takes chrome focus back out of the panel the test has just opened. On try that cost the toolbar button tests 4 of 18 runs, and none once the sidebar stayed shut. Organize Tabs does not involve the sidebar, so there is nothing to gain from racing it.\n\naddWebTabs waits until clustering would look at every tab it added. A tab's load event can fire while the tab is still busy or has no title yet, and getCandidateTabs skips both, so a test could open the panel onto fewer tabs than it set up.\n\nTeardown closes the window before popping the pref env, as the file did before it was split. Popping browser.smartwindow.autoTabGrouping.enabled first flips the lazy pref getter in a live window, which destroys the toolbar widget under a panel that may still be open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316648\n", "files": ["browser/components/aiwindow/ui/test/browser/head_aiwindow_group_tabs_button.js"], "git_node": "1ddc4fc1c9f4168d54af4d46fc3357fe8877efeb", "git_parents": ["ea433875a76403af1aac330fc2033ed0e812783d"], "node": "38fd9a51ac4d0f68b55fdb165692ffc1893fbce3", "parents": ["88d0db0345a1d2c3d631b3bbd2178b19ceba7a2c"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060985 - Drop the xpcshell candidate-tabs test that another already covers r=omarg\n\ntest_getCandidateTabs_keepsOnlyUngroupedWebTabs already puts a grouped tab in the window and asserts it is left out, so test_getCandidateTabs_excludesAlreadyGroupedTabs asserted the same rule a second time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324807\n", "files": ["browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js"], "git_node": "4b8a1b7253e894723f7d0cd1d61e3e572d96418f", "git_parents": ["1ddc4fc1c9f4168d54af4d46fc3357fe8877efeb"], "node": "2a23ecf82b344ca74f225b77f3de9caf709b3851", "parents": ["38fd9a51ac4d0f68b55fdb165692ffc1893fbce3"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2063111 - updates to align with API contract r=mshillabeer,jlewis\n\nDifferential Revision: h