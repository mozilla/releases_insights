m/meta/webdriver/tests/bidi/integration/parallel_execution/browsing_context_print.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/combined/network_events.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/remove_preload_script/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/remove_preload_script/remove_preload_script.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/remove_preload_script/sandbox.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/session/status/status.py.ini", "testing/web-platform/meta/webdriver/tests/classic/accept_alert/accept.py.ini", "testing/web-platform/meta/webdriver/tests/classic/back/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/delete_cookie/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/dismiss_alert/dismiss.py.ini", "testing/web-platform/meta/webdriver/tests/classic/execute_script/execute.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_element_css_value/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_element_property/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_window_handles/get.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_window_handles/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_alwaysMatch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_firstMatch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/default_values.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/merge.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/page_load_strategy.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/response.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/timeouts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/unhandled_prompt_behavior.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/websocket_url.py.ini", "testing/web-platform/meta/webdriver/tests/classic/send_alert_text/send.py.ini", "testing/web-platform/meta/webdriver/tests/classic/switch_to_window/alerts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/switch_to_window/switch.py.ini"], "git_node": "d14dad0e8b658934b83a454d5c789fe9f9ce7d8e", "git_parents": ["60e8ebc4209c647052b62f47bd6e235733bf0304"], "node": "cab4f93bef1c960ef972a3c48e99d677d2115a01", "parents": ["1af5f227d32b360f8f3a130c329c6d3ffc2c8ce5"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2047745 - [wdspec] Cleanup wpt meta data for tsan builds. r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326009\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/context_created/original_opener.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/print/page.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/pointer_mouse_multiclick.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/wheel_events.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/add_intercept/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/before_request_sent/before_request_sent.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/continue_response/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/fetch_error/fetch_error.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/get_data/persistence.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/set_extra_headers/headers.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/evaluate/result_node.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/storage/delete_cookies/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/add_cookie/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/find_element_from_shadow_root/find.py.ini", "testing/web-platform/meta/webdriver/tests/classic/find_element_from_shadow_root/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/find_elements/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/find_elements_from_element/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_computed_label/get.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_element_text/get.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_pen.py.ini", "testing/web-platform/meta/webdriver/tests/classic/set_window_rect/set.py.ini", "testing/web-platform/meta/webdriver/tests/classic/switch_to_frame/switch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/switch_to_frame/switch_number.py.ini"], "git_node": "2a0d62e14e50e6cda91b9b519d575c835464c581", "git_parents": ["d14dad0e8b658934b83a454d5c789fe9f9ce7d8e"], "node": "5088f284cf2ec1726b7f63424de60b3c332c5f89", "parents": ["cab4f93bef1c960ef972a3c48e99d677d2115a01"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066802 - Part 0: Replace IPPExceptionsManager with SiteRuleManager r=ip-protection-reviewers,rking\n\nRetire the Bulky IPPExceptionManager with SiteRuleManager.\nRn the exceptionmanager needs to handle a lot of diffrent cases: Prefs, Permissions, LAN-access.\nFor that it already needs to manage lifecylcle, preflisteners etc.\n\nIt already supports inclusions/exclusions.\nFor the future things are planned like:\n-\u003e Rule per container\n-\u003e Rule per tab\n-\u003e Rule per window-type\n-\u003e Rules that have a ProxyInfo Attached.\n\nThat will make this class blow out ouf proportions. So i'm splitting the Rule evaluation with the rules itself.\n\nThe SiteRuleManager provides the same api, getRule(principal) -\u003e Included/Excluded/(Use whatever the modepref says), canManage(principal).\n\nThe Rules itself will be Provided by SiteRuleProviders, each implementing canManage,getRule and we evaluate them by hirachy until a decsision is made.\n\nThis patch is part of a patch chain and should not be expected to work alone, this splitting just makes it nicer to review i hope c:\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324649\n", "files": ["browser/components/ipprotection/IPProtectionHelpers.sys.mjs", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_IPPChannelFilter.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_confirmation_hints_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_card.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_viewer_site_exclusion.js", "browser/components/ipprotection/tests/browser/head.js", "toolkit/components/ipprotection/IPPChannelFilter.sys.mjs", "toolkit/components/ipprotection/IPPExceptionsManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/moz.build", "toolkit/components/ipprotection/tests/xpcshell/head.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPChannelFilter.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPExceptionsManager.js", "toolkit/components/ipprotection/tests/xpcshell/test_SiteRuleManager.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "4452c485c6dbd240d8b70289b4063607da859e82", "git_parents": ["2a0d62e14e50e6cda91b9b519d575c835464c581"], "node": "50a3b67afa84e878beae37042bf90d0095bd368c", "parents": ["5088f284cf2ec1726b7f63424de60b3c332c5f89"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066802 - Part 1: Add IPPProxyableRuleProvider r=ip-protection-reviewers,rking\n\nThis adds the first rule providers, to exclude channels that we cannot proxy via HTTP and\nrequests that are essential to the VPN working.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324650\n", "files": ["toolkit/components/ipprotection/IPPSiteRuleManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPPInfrastructureRuleProvider.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPProxyableRuleProvider.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "82952e6fc09bafe4c7c640ad65c576b383f7d82c", "git_parents": ["4452c485c6dbd240d8b70289b4063607da859e82"], "node": "f8837e0ca1fa4028d4b35cbdcb410f9cc48d2c2f", "parents": ["50a3b67afa84e878beae37042bf90d0095bd368c"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066802 - Part 2: Add MatchPatternPrefRule for the inclusion list r=ip-protection-reviewers,rking\n\nThis patch adds a Provider that allows us to construct a MatchPattern given a prefkey.\nAll matches will get the Rule provided. This is currently used by FF-Enterprise.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324651\n", "files": ["toolkit/components/ipprotection/IPPSiteRuleManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_MatchPatternPrefRule.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "2ae54c781a6c197d188db73b3e8583ce2c2f5e0a", "git_parents": ["82952e6fc09bafe4c7c640ad65c576b383f7d82c"], "node": "6c9137a5aa26b3c1b7a6787105652b8692468f74", "parents": ["f8837e0ca1fa4028d4b35cbdcb410f9cc48d2c2f"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066802 - Part 3: Add IPPPermissionRuleProvider r=ip-protection-reviewers,rking\n\nThis adds the Permission-Based Rule Provider.\n\nAny origin with an DENY permission will be Exluded, any ALLOW will be included.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324652\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_telemetry.js", "toolkit/components/ipprotection/IPPSiteRuleManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPPPermissionRuleProvider.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "bae46223b6eea34d91b94b778d54b57c287075b1", "git_parents": ["2ae54c781a6c197d188db73b3e8583ce2c2f5e0a"], "node": "f26ae2f0a6a9addc8fdf3936d556bdc30b03fbd4", "parents": ["6c9137a5aa26b3c1b7a6787105652b8692468f74"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066802 - Part 4: Test the assembled SiteRuleManager r=ip-protection-reviewers,rking\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324653\n", "files": ["browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPSiteRuleManager.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "3ff0bfaf8518c0cb0886821044bbdbb1ccb85f07", "git_parents": ["bae46223b6eea34d91b94b778d54b57c287075b1"], "node": "7750461463961567e2b865e6d8c947c468f731be", "parents": ["f26ae2f0a6a9addc8fdf3936d556bdc30b03fbd4"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066802 - Part 5: Port the ipp-activator extension to SiteRuleManager r=ip-protection-reviewers,rking\n\nThe extension's parent API asked IPPExceptionsManager whether a site was\nexcluded. Ask IPPSiteRuleManager for the site's rule instead and compare it\nagainst IPPPrincipalRules.EXCLUDED.\n\nSplit out of Part 0 so the extension API surface can be reviewed on its own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324710\n", "files": ["browser/extensions/ipp-activator/extension/api/parent/ext-ipp.js"], "git_node": "36ca3b10296d4656c42f93438e26f27c7d08857b", "git_parents": ["3ff0bfaf8518c0cb0886821044bbdbb1ccb85f07"], "node": "c34978334c05b4c210b6876115a2f707eb204cdd", "parents": ["7750461463961567e2b865e6d8c947c468f731be"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2071770 - Add AndroidImageReaderImageDescriptor handling to GLBlitHelper::BlitSdToFramebuffer() r=gfx-reviewers,jnicol,lsalzman\n\nAndroidImageReaderImageDescriptor needs to be handled in GLBlitHelper::BlitSdToFramebuffer().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325769\n", "files": ["dom/canvas/WebGLContext.cpp", "gfx/gl/GLBlitHelper.cpp", "gfx/gl/GLBlitHelper.h"], "git_node": "6bdaf5edad67b1d9ecf628137556b347e958ee09", "git_parents": ["36ca3b10296d4656c42f93438e26f27c7d08857b"], "node": "f370f75fcc12d133fa4ad8262ac88c77f9f2724e", "parents": ["c34978334c05b4c210b6876115a2f707eb204cdd"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1975960 - Add zucchini support for mingwclang builds. r=bobowen,firefox-build-system-reviewers,sergesanspaille,sandbox-reviewers\" for causing vendor lint failures\n\nThis reverts commit e0dfef7faa4b748825a0d646d44643e27edd8ff9.\n\nRevert \"Bug 1975960 - Update zucchini vendoring to prepare for mingwclang support. r=bobowen\"\n\nThis reverts commit 3b6fb72bab0b132ff8585e3e1b7c6cff15dcaa00.\n\nRevert \"Bug 1975960 - Regenerate zucchini shim patches that diverged. r=bobowen\"\n\nThis reverts commit da3f754d99a3a382ec684886aa7470e765e1ded8.\n\nRevert \"Bug 2043122 - Simulate zucchini test failures mid-patch-application. r=application-update-reviewers,iholmes\"\n\nThis reverts commit f443f6f4b2deb34600360bee6634c6381416a0f1.\n\nRevert \"Bug 2043122 - Cross-platform handling of std::bad_alloc in zucchini. r=application-update-reviewers,firefox-build-system-reviewers,sergesanspaille,cdupuis\"\n\nThis reverts commit d209f1772abff63985041d55a341fcde6ff52ac6.\n\nRevert \"Bug 2043122 - Remove Windows-only zucchini crash recovery. r=application-update-reviewers,cdupuis\"\n\nThis reverts commit 6534e47ae424e527565a405bffd1efe11539a6a9.\n\nRevert \"Bug 2046798 - Wrap zucchini crc32 computation to catch exceptions. r=application-update-reviewers,cdupuis\"\n\nThis reverts commit a05dff7e3acad0e344321eada524fdc1f15d5f4c.\n\nRevert \"Bug 2046798 - Wrap zucchini entry points to catch exceptions. r=sergesanspaille,application-update-reviewers,cdupuis\"\n\nThis reverts commit 6232332c92add46ce74efcdc32ae1ff027df678a.\n\nRevert \"Bug 2046798 - Fix a/ b/ file paths in zucchini patch 0024. r=bobowen\"\n\nThis reverts commit ffebfed54e478702e66628de0193d05d38a7444f.\n\nRevert \"Bug 2070478 - Fix macOS exception handling for child processes that don't register their own exception handler. r=crashreporting-reviewers,afranchuk\" for causing vendor lint failures\n\nThis reverts commit 9bc35258b7ad0840cc8e760b4b225d5e16f84140.\n", "files": ["browser/config/mozconfigs/win32/mingwclang", "browser/config/mozconfigs/win64/mingwclang", "mozilla-config.h.in", "security/sandbox/moz.build", "third_party/zucchini/README.md", "third_party/zucchini/chromium-shim/patches/0006-Define-only-the-required-functions