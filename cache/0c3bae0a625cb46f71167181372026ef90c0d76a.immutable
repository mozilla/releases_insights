": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 1d349a6de68c5b3e8e0db2493d871eef1926d837 with FIREFOX_157_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "39dbe878b4856a7bfd3debceb930909e7d24b66f", "git_parents": ["ab9b49297a5984782fb2a14a74c7cf227d3cc2ea"], "node": "0550c97167de1e5decb3acdf49f88ef33be7d6fd", "parents": ["ac1dabf6c3ed4041ff82625581fed475852677af"], "tags": []}], "date": 1790169052, "git_changesets": ["39dbe878b4856a7bfd3debceb930909e7d24b66f"], "user": "ffxbld@lando.moz.tools"}, "45397": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 1d349a6de68c5b3e8e0db2493d871eef1926d837 with FIREFOX-ANDROID_157_0b5_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9bba0e8e0171b458ec26c4d03e05298585649b8d", "git_parents": ["39dbe878b4856a7bfd3debceb930909e7d24b66f"], "node": "cdca8729ef50a210758f2951a3227a7c7629e620", "parents": ["0550c97167de1e5decb3acdf49f88ef33be7d6fd"], "tags": []}], "date": 1790172915, "git_changesets": ["9bba0e8e0171b458ec26c4d03e05298585649b8d"], "user": "ffxbld@lando.moz.tools"}, "45398": {"changesets": [{"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2060671 - Give the h3 fallback test a port it owns. r=necko-reviewers,kershaw\n\nMOZHTTP3_PORT_NO_RESPONSE is an ephemeral UDP bind, which reserves the\nnumber for UDP only. The test takes its own TCP port and binds a silent\nUDP socket on it, and listenAndForwardPort awaits `listening` so that a\nfailed bind rejects into the caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328129\n", "files": ["netwerk/docs/NodeServers.md", "netwerk/test/httpserver/NodeServer.sys.mjs", "netwerk/test/unit/http3_proxy_common.js"], "git_node": "c692c8994121793ce27c26b693ddb0237593b106", "git_parents": ["9e9b5f17f56187c1f5c8b9cdf79a01ff51a7b643"], "node": "d212fc45acbf9dec7abf249c19c39c7a87ea56e5", "parents": ["6d44638b635cbd69b01e21aeb96eddffcf33db0a"], "tags": []}, {"author": "elkal98 \u003ckhalid.alhaddad98@gmail.com\u003e", "branch": "default", "desc": "Bug 1933992 - [remote] PollPromise should throw an error by default and not only log a warning when it times out. r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324990\n", "files": ["remote/components/RemoteAgent.sys.mjs", "remote/marionette/server.sys.mjs", "remote/shared/BrowsingContextUtils.sys.mjs", "remote/shared/DOM.sys.mjs", "remote/shared/Sync.sys.mjs", "remote/shared/test/xpcshell/test_Sync.js"], "git_node": "3b1792bf738da9a87dd744b516112bc6b4550b9c", "git_parents": ["c692c8994121793ce27c26b693ddb0237593b106"], "node": "637fd1b99dac525780ec46bcf4c76a9e449b6950", "parents": ["d212fc45acbf9dec7abf249c19c39c7a87ea56e5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074634 - Fix WebRender clip-path origin on SVG frames. r=firefox-svg-reviewers,longsonr\n\nFactored out from bug 2070993 because we do need this for interop (see\nthe test fix), and I just realized that I had reviewed the fix for this.\n\nCo-Authored-By: Nicolas Silva \u003cnsilva@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328262\n", "files": ["layout/base/nsLayoutUtils.cpp", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/painting/nsDisplayListInvalidation.h", "layout/svg/FilterInstance.cpp", "layout/svg/SVGIntegrationUtils.cpp", "layout/svg/SVGUtils.cpp", "layout/svg/SVGUtils.h", "testing/web-platform/meta/css/css-masking/clip-path/clip-path-shape-foreignobject-non-zero-xy.html.ini"], "git_node": "32e98b92feea23735a646857b4e9fbc6e4c03e48", "git_parents": ["3b1792bf738da9a87dd744b516112bc6b4550b9c"], "node": "4b61fc62a49e3ec80046c176e6df97f5b5939ea7", "parents": ["637fd1b99dac525780ec46bcf4c76a9e449b6950"], "tags": 