, "parents": ["f42c040a0947ebd96a72099a4d1d56aeda65f006"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2070810 - Upgrade rust toolchain used to build toolchains to 1.91. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324951\n", "files": ["taskcluster/kinds/toolchain/rust.yml"], "git_node": "aacb13a2848a736670d76eb683ab2fe81675c28a", "git_parents": ["2f236d75a9f3e29df2407f9de2e002845d217a2a"], "node": "39e4e84afdcd48dacf3cb3a66cc5fcd5efc5304f", "parents": ["22db582f7847a85dc68b13ae2027c8c2fdabee15"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2070810 - Upgrade sccache to current main. r=sylvestre\n\nThis includes, among other things, a fix for cache collisions from using\nGCC with different versions of binutils.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324952\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "24615c0605757fffefad19a32e6dde3af3bc19d2", "git_parents": ["aacb13a2848a736670d76eb683ab2fe81675c28a"], "node": "9e7e3b9f63c9aa422255e5bc725e1a24e5b8b73d", "parents": ["39e4e84afdcd48dacf3cb3a66cc5fcd5efc5304f"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2065981 - Inline trivial Temporal Duration getters. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320775\n", "files": ["js/src/builtin/temporal/Duration.cpp", "js/src/jit-test/tests/cacheir/temporal-getters.js", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIR.h", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIRGenerator.h", "js/src/jit/InlinableNatives.cpp", "js/src/jit/InlinableNatives.h", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "b8f849f8a21656bcff16557fd4c47e14923145dd", "git_parents": ["24615c0605757fffefad19a32e6dde3af3bc19d2"], "node": "33b2c57958bfc5006212764504d3873ddab30e45", "parents": ["9e7e3b9f63c9aa422255e5bc725e1a24e5b8b73d"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2065981 - Inline Temporal plain time getters. r=spidermonkey-reviewers,jandem\n\nEmit unpacking code inline where no further computation is required.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320776\n", "files": ["js/src/builtin/temporal/PlainDateTime.cpp", "js/src/builtin/temporal/PlainDateTime.h", "js/src/builtin/temporal/PlainTime.cpp", "js/src/builtin/temporal/PlainTime.h", "js/src/jit-test/tests/cacheir/temporal-getters.js", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIR.h", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIRGenerator.h", "js/src/jit/CacheIROps.yaml", "js/src/jit/CodeGenerator.cpp", "js/src/jit/InlinableNatives.cpp", "js/src/jit/InlinableNatives.h", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "21bbc7d3d4e5504fee7e0b7e5e65821b1cc00f61", "git_parents": ["b8f849f8a21656bcff16557fd4c47e14923145dd"], "node": "354970cc11fc4ee56629c225a524aa673cf42bff", "parents": ["33b2c57958bfc5006212764504d3873ddab30e45"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2065981 - Inline Temporal epochMilliseconds getters. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320777\n", "files": ["js/src/builtin/temporal/Instant.cpp", "js/src/builtin/temporal/Instant.h", "js/src/builtin/temporal/ZonedDateTime.cpp", "js/src/builtin/temporal/ZonedDateTime.h", "js/src/jit-test/tests/cacheir/temporal-getters.js", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIR.h", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIRGenerator.h", "js/src/jit/CacheIROps.yaml", "js/src/jit/CodeGenerator.cpp", "js/src/jit/InlinableNatives.cpp", "js/src/jit/InlinableNatives.h", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/TypePolicy.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "ee3fa8f41632f2cfb05d787604a0ace0509b1915", "git_parents": ["21bbc7d3d4e5504fee7e0b7e5e65821b1cc00f61"], "node": "33d4f87dacc8429e9de157b817f7b1e3e2b3eb99", "parents": ["354970cc11fc4ee56629c225a524aa673cf42bff"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070871 - Reuse the pending MLS fallback when PortalLocationProvider::Watch is called again. r=geoprovider-reviewers,saschanaz\n\nWatch() runs for every new geolocation request while the provider stays\nstarted. While the portal has not delivered a position yet, each call\nreplaced the MLSFallback without shutting the previous one down, so its\nNetworkGeolocationProvider stayed alive with its repeating timer and wifi\nlistener for the rest of the session.\n\nReuse the existing fallback instead, and add a gtest that counts the armed\nfallback timers across repeated Watch() calls.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324916\n", "files": ["dom/system/linux/PortalLocationProvider.cpp", "dom/system/linux/gtest/TestPortalLocationProvider.cpp", "dom/system/linux/gtest/moz.build", "dom/system/linux/moz.build"], "git_node": "2524531b4fe14c5d19ad49cf38657cbb49ab8743", "git_parents": ["ee3fa8f41632f2cfb05d787604a0ace0509b1915"], "node": "43a314af5029cb9bd4d65429a6301ea9c4b24ac7", "parents": ["33d4f87dacc8429e9de157b817f7b1e3e2b3eb99"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069065 - Part 1: Move notification showing out of NotificationParent. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323361\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h"], "git_node": "64f3a67033aef7106504d6fbeeff6f5d504e15dc", "git_parents": ["2524531b4fe14c5d19ad49cf38657cbb49ab8743"], "node": "c06ba94d7b04fd226d31dbf7c658dc0e5b8e3176", "parents": ["43a314af5029cb9bd4d65429a6301ea9c4b24ac7"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069065 - Part 2: Move permission and Safe Browsing checks to NotificationUtils.cpp. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323362\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h"], "git_node": "118bf6e068b02265f921d0b2f2b4e12d0eb19fc3", "git_parents": ["64f3a67033aef7106504d6fbeeff6f5d504e15dc"], "node": "e76b359d483fa415a5f1903042b821152a1378bc", "parents": ["c06ba94d7b04fd226d31dbf7c658dc0e5b8e3176"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2063316: Add tests for CheckCompatibility and download ping generation. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320428\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "61da179c958409765e05611826b3570b91a358d9", "git_parents": ["118bf6e068b02265f921d0b2f2b4e12d0eb19fc3"], "node": "1326a3f05901d1b1d198b56724ef0070cd83ea63", "parents": ["e76b359d483fa415a5f1903042b821152a1378bc"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062425 - Fix split view wrapper being too wide in compact mode. r=tabbrowser-reviewers,desktop-theme-reviewers,sthompson,sfoster\n\n`#pinned-tabs-container` was mistakenly using `--tab-pinned-min-width-expanded` to size its items, even for the non-expanded case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322336\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "e702822762e303605fde3fb6837c41be118bd9ef", "git_parents": ["61da179c958409765e05611826b3570b91a358d9"], "node": "a43be864e87f42651c26c3cb0c9f032c3ad434ae", "parents": ["1326a3f05901d1b1d198b56724ef0070cd83ea63"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062425 - Fix split view tab background size when dragging between collapsed and expanded sidebar. r=tabbrowser-reviewers,desktop-theme-reviewers,sthompson,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322337\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "707b864c88ad47f2941b8837214fac66dcd587df", "git_parents": ["e702822762e303605fde3fb6837c41be118bd9ef"], "node": "19feb070d0dead984792531a321637cf698de380", "parents": ["a43be864e87f42651c26c3cb0c9f032c3ad434ae"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062425 - Round off subpixel values for split view wrapper margins and padding. r=tabbrowser-reviewers,desktop-theme-reviewers,sthompson,emilio,nsharpley\n\nWhen both sides of a split view's margin or padding are subpixel values, there is no guarantee that both sides will round to the same value when painted on-screen.\n\nTo avoid such a scenario, (e.g. having 6px of margin on the left, and 5px on the right), round off the spacing calculations before passing them off to their respective CSS properties.\n\nRemoved margins from `.tab-background`, as these caused horizontal paddings to grow longer than the vertical paddings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322338\n", "files": ["browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "2170dab6c50589e8b22c4aa1e0053410439ce806", "git_parents": ["707b864c88ad47f2941b8837214fac66dcd587df"], "node": "922716ca2c384c1683822d9f42da474663cd55a7", "parents": ["19feb070d0dead984792531a321637cf698de380"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070934 - Verify the onnxruntime dependency downloads. r=firefox-build-system-reviewers,taskgraph-reviewers,sergesanspaille,bhearsum\n\nfetch-onnxruntime-deps.sh ran curl without --fail, so an HTTP error body could be written to disk\nin place of an archive while the task still exited zero. A try run hit exactly that: abseil-cpp\narrived as a 107 byte error page, the corrupt tarball was published as the onnxruntime-deps\nartifact, and every onnxruntime toolchain then failed at configure time on the SHA1 that cmake\nverifies anyway. deps.txt already carries a SHA1 for every entry, so the download loop now checks\nit, and curl fails on HTTP errors and retries. The source tarball download gets the same curl\ntreatment.\n\nThe cached_task digest covered only the repo, revision and artifact name, so neither a fix to this\nscript nor a fresh push at the same revision could displace a bad artifact once it was indexed.\nHashing the script into the digest ties the artifact to the code that produced it. Fetch artifacts\nare kept for a thousand years on level 3, so a silent corruption there would otherwise be\npermanent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318366\n", "files": ["taskcluster/gecko_taskgraph/transforms/fetch.py", "taskcluster/scripts/misc/fetch-onnxruntime-deps.sh"], "git_node": "68f2a478457ed0d8ae352a3f859fdb31e308ba9d", "git_parents": ["2170dab6c50589e8b22c4aa1e0053410439ce806"], "node": "973737ec04bf3c4de8c4dde7d2fe925dc6e3aae5", "parents": ["922716ca2c384c1683822d9f42da474663cd55a7"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044636 - Route MediaCapabilities WebRTC and encode paths through async codec support. r=media-playback-reviewers,webrtc-reviewers,bwc,padenot\n\nAdd async support queries through the encoder stack (PlatformEncoderModule,\nRemoteEncoderModule, PEMFactory) and convert the WebRTC decode/encode glue\n(WebrtcMediaDataDecoder, WebrtcVideoCodecFactory, MediaDataCodec, CodecInfo) to\nresolve once the relevant remote process has reported accurate hardware\nsupport. The MediaCapabilities WebRTC decode and encode paths and the\nTestWebRTCCodecInfo gtests now use these; the superseded synchronous WebRTC\nsupport paths are removed. WebRTC decode support reuses the cached\nPDMFactorySupport singleton.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304787\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/gtest/TestWebrtcCodecFactory.cpp", "dom/media/ipc/RemoteEncoderModule.cpp", "dom/media/ipc/RemoteEncoderModule.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/platforms/PlatformEncoderModule.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h"], "git_node": "31fffb207c1aa8c44b76d0d4b2fe6c8f03a237ea", "git_parents": ["68f2a478457ed0d8ae352a3f859fdb31e308ba9d"], "node": "cbe92e540bfd0ddcb07bdef0c083345abe062fe4", "parents": ["973737ec04bf3c4de8c4dde7d2fe925dc6e3aae5"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044636 - Replace duplicate WebRTC codec-support pref-gating closures with shared functions. r=azebrowski,webrtc-reviewers,bwc\n\nSeveral SupportsCodec/StrictSupportsCodec call sites duplicated the same\nH264/VP8 hardware-support pref-gating logic inline, each paired with its own\nMozPromise::Then() reject continuation that did nothing but forward the\nerror. Extract the gating into named, codec-dispatched functions and use\nMozPromise::Map(), which forwards the reject value automatically, so the\npromise continuation machinery is specialized once per function-pointer type\ninstead of once per near-identical inline lambda.\n\nThis may help reduce the binary size somewhat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323393\n", "files": ["dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataEncoderCodec.cpp"], "git_node": "6081cba72fe33a29196085d015e6192c0eba6008", "git_parents": ["31fffb207c1aa8c44b76d0d4b2fe6c8f03a237ea"], "node": "16e2a9e93cf1aa7d290c13052db1bac9154ba361", "parents": ["cbe92e540bfd0ddcb07bdef0c083345abe062fe4"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068580 - Vendor the Metal backend at the pinned llama.cpp revision. r=ai-platform-reviewers,valentinp\n\nThe Metal files were taken from an older llama.cpp than the revision moz.yaml\npins, which is why they had to be in \"keep\" rather than revendored.\n\nThis vendors the backend at 74ade527 instead, matching llama.cpp. At that rev,\nit is split into a few files. The embedding of the shader source is unchanged: the\n.metal file still has the __embed_ggml-common.h__ and ggml-metal-impl.h\nplaceholders generate_metal_embed.py substitutes. etc.\n\nggml-metal-device.m and ggml-metal-device.cpp would compile to the same object\nname, so run_parser.py renames the former to ggml-metal-device-m.m, like it\nalready does for ggml.c and ggml-cpu.c.\n\nTwo patches are needed on top: \u003cmemory\u003e for std::unique_ptr in ggml-metal.cpp,\nand a guard around -[MTLSharedEvent waitUntilSignaledValue:timeoutMS:], which\nis macOS 12 while we deploy to 10.15 (11.0 on aarch64).\n\n`mach vendor --patch-mode check` now reproduces the tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322929\n", "files": ["third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-common.cpp", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-common.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-context.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-context.m", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-device-m.m", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-device.cpp", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-device.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-impl.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-ops.cpp", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-ops.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal.cpp", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal.m", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal.metal", "third_party/llama.cpp/metal-event-availability.patch", "third_party/llama.cpp/missing-includes.patch", "third_party/llama.cpp/moz.build", "third_party/llama.cpp/moz.yaml", "third_party/llama.cpp/run_parser.py"], "git_node": "a45275fb793f95e91e4ec119d2529d198dbb88aa", "git_parents": ["6081cba72fe33a29196085d015e6192c0eba6008"], "node": "f771b516e40f17028ee345f00b1f74f61f26b4d7", "parents": ["16e2a9e93cf1aa7d290c13052db1bac9154ba361"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068580 - Fall back to the general mat-vec kernel when Metal lacks the _short one. r=ai-platform-reviewers,valentinp\n\nggml_metal_library_get_pipeline_mul_mv asks for a _short kernel variant when\nne00 \u003c 32. On the macOS 15 machines the Metal compiler does not emit those\nspecializations from the vendored shader source, so the lookup fails with\n\n  MTLLibraryErrorDomain Code=5 \"Function kernel_mul_mv_f32_f32_short was not\n  found in the library\"\n\nget_pipeline_mul_mv returns a null pipeline and the caller encodes it without\nchecking.\n\nllama.cpp doesn't use this path, parakeet.cpp does, we can simply use the general\nkernel, which lives in the same source, it is emitted everywhere, and handles any size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324025\n", "files": ["third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-device-m.m", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-device.cpp", "third_party/llama.cpp/metal-mul-mv-short-fallback.patch", "third_party/llama.cpp/moz.yaml"], "git_node": "153ac773b884c9a849519c470f48a58c6c9f44d8", "git_parents": ["a45275fb793f95e91e4ec119d2529d198dbb88aa"], "node": "d9f68a527c412925edd0279205d110ab4952fc76", "parents": ["f771b516e40f17028ee345f00b1f74f61f26b4d7"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068580 - Reassemble the embedded Metal shader when it changes. r=valentinp\n\nEditing ggml-metal.metal did not change the built binary, very confusing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324026\n", "files": ["third_party/llama.cpp/generate_metal_embed.py"], "git_node": "f8396e0da6dd093719b7dd268ca4b2c8c9028bfb", "git_parents": ["153ac773b884c9a849519c470f48a58c6c9f44d8"], "node": "52cdfd8dd5f4b8389ddd728deff424f4c08613a4", "parents": ["d9f68a527c412925edd0279205d110ab4952fc76"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068758 - Don't attempt to use Metal in the Inference content process. r=valentinp,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324021\n", "files": ["config/external/mozinference/mozinference.symbols", "third_party/llama.cpp/ggml/include/ggml-metal.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal.cpp", "third_party/llama.cpp/metal-disable.patch", "third_party/llama.cpp/moz.yaml", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.cpp", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h"], "git_node": "500af56f0ad8bfbaa9b69031549d73a7ba9d9419", "git_parents": ["f8396e0da6dd093719b7dd268ca4b2c8c9028bfb"], "node": "39185fe2389b1d2cb27f2f74e7db6d00562e8d88", "parents": ["52cdfd8dd5f4b8389ddd728deff424f4c08613a4"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2069184 - Bump the minimum supported version of GCC to 11 and use libstdc++ 11 for the build r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324501\n", "files": ["build/moz.configure/toolchain.configure", "docs/code-quality/coding-style/using_cxx_in_firefox_code.md", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/hazard/kind.yml", "taskcluster/kinds/packages/debian.yml", "taskcluster/kinds/toolchain/gcc.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/node.yml", "taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "8fea00f0c6b9b4e844b6be61f0c26af53850d2c7", "git_parents": ["500af56f0ad8bfbaa9b69031549d73a7ba9d9419"], "node": "ec78c8b3d8a06a5442213fa0cc8749de75b2e496", "parents": ["39185fe2389b1d2cb27f2f74e7db6d00562e8d88"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069065 - Part 2: Move permission and Safe Browsing checks to NotificationUtils.cpp. r=saschanaz\" for causing build bustages\n\nThis reverts commit 118bf6e068b02265f921d0b2f2b4e12d0eb19fc3.\n\nRevert \"Bug 2069065 - Part 1: Move notification showing out of NotificationParent. r=saschanaz\"\n\nThis reverts commit 64f3a67033aef7106504d6fbeeff6f5d