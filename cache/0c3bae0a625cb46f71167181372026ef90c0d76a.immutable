vents/test/browser_mouse_click_screenXY.js", "dom/events/test/browser_mouse_enterleave_switch_tab.js", "dom/security/test/general/browser_test_referrer_loadInOtherProcess.js", "eslint-ignores.config.mjs", "eslint-rollouts.config.mjs", "eslint-test-paths.config.mjs", "testing/docs/tests-for-new-config/manual.md", "toolkit/components/antitracking/test/browser/browser-blocking.toml", "toolkit/components/antitracking/test/browser/browser.toml", "toolkit/components/antitracking/test/browser/browser_referrerDefaultPolicy.js", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_content_analysis.js", "toolkit/components/pageextractor/tests/browser/browser_dom_extractor.js", "toolkit/content/xul.css"], "git_node": "e8bb2745fa7ffe57075a8a7c3b824e6441bbcae3", "git_parents": ["77575f2c9645f93756f606b9f88191468320e07c"], "node": "0fc7d00175ee4be3179a7c3ff8f724a1f299e3f3", "parents": ["ac647932d98a044e5ba0de42d00ffae7e1658900"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048704 - End composition when EditContext is deactivated. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326299\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/events/TextComposition.cpp", "dom/html/EditContext.cpp", "dom/html/EditContext.h", "dom/html/nsGenericHTMLElement.cpp", "editor/libeditor/tests/edit-context/mochitest.toml", "editor/libeditor/tests/edit-context/test_editcontext_blur_in_textupdate.html", "editor/libeditor/tests/edit-context/test_editcontext_compositionend.html"], "git_node": "2a28223032af49a73782e01e2cf63355244e8112", "git_parents": ["e8bb2745fa7ffe57075a8a7c3b824e6441bbcae3"], "node": "a470c6810ede9beaffa0733ba581327f700c790a", "parents": ["0fc7d00175ee4be3179a7c3ff8f724a1f299e3f3"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2072267 - Don't evict the TRR connection when the global connection limit is hit r=acreskey,necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326932\n", "files": ["netwerk/protocol/http/nsHttpConnectionMgr.cpp"], "git_node": "d25a7e49de6af1834181698763283c48cc42cae8", "git_parents": ["2a28223032af49a73782e01e2cf63355244e8112"], "node": "517c81e478395dd614cfff529cb6d38f8c559563", "parents": ["a470c6810ede9beaffa0733ba581327f700c790a"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071018 - Update cached Attr nodes' owner document when adopting an element. r=dom-core-reviewers,smaug\n\n`nsDOMAttributeMap::SetOwnerDocument` exists but nothing calls it, so Attr nodes\ncreated before an element is adopted keep their old node document.\n\nThis change drops the dead `SetOwnerDocument` method and implements adoption via\nElement's `NodeInfoChanged` and a new `AdoptCachedAttributes`. Implementing the\nmissing \"adopt\" step 3.3.1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325083\n", "files": ["dom/base/Attr.cpp", "dom/base/Attr.h", "dom/base/AttrArray.cpp", "dom/base/AttrArray.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsDOMAttributeMap.h", "dom/base/nsINode.cpp", "testing/web-platform/tests/dom/nodes/Document-adoptNode.html"], "git_node": "6124a03a3752596558a80571d782294d0289e748", "git_parents": ["d25a7e49de6af1834181698763283c48cc42cae8"], "node": "bab452117d24ac1dd4ce102d1ae02d0443811bbe", "parents": ["517c81e478395dd614cfff529cb6d38f8c559563"], "tags": []}, {"author": "delan azabani \u003cdazabani@igalia.com\u003e", "branch": "default", "desc": "Bug 2070869 - Invalidate `\u003cinput\u003e.labels` when `\u003cinput id\u003e` changes. r=dom-core-reviewers,keithamus\n\n`\u003cinput\u003e` and other elements with `.labels` use LabelsNodeList to dynamically\nreflect the `\u003clabel\u003e` elements that reference it. while LabelsNodeList detects\nsome changes, like changes to ancestry (for implicit label association) and\nchanges to `\u003cinput type\u003e` (for `\u003cinput type=hidden\u003e`), it does not yet detect\nchanges to the `id` attribute.\n\nthis patch adds a call to SetDirty() in LabelsNodeList when AttributeChanged()\nis called for any `id` attribute in the subtrees under observation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325235\n", "files": ["dom/base/ContentList.cpp", "testing/web-platform/meta/shadow-dom/reference-target/tentative/dom-mutation.html.ini", "testing/web-platform/tests/shadow-dom/reference-target/tentative/dom-mutation.html"], "git_node": "d50c9066af37c7ea0a6c00339fbbcaf0d7a683aa", "git_parents": ["6124a03a3752596558a80571d782294d0289e748"], "node": "061c48bc2165abe0eeb6615556954858e8f88968", "parents": ["bab452117d24ac1dd4ce102d1ae02d0443811bbe"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072388 - Fold manifest-wide skip-if conditions into the run-if already present. r=ci-and-tooling,webgpu-reviewers,places-reviewers,urlbar-reviewers,marco,aleiserson,Standard8\n\nFive of these manifests carried both keys, so the reclassification is an && of\nthe two conditions rather than a new key.\n\nThe urlbar suppress-tips manifest is the exception: a test that cannot be re-run\nin one session is a limitation of the test rather than a configuration it is out\nof scope for, so its verify condition stays a skip-if and moves unchanged onto\nthe manifest's single test.\n\nThe places migration manifest also had its condprof comment split in half by\nthe skip-if sitting in the middle of it; the halves are rejoined here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326540\n", "files": ["browser/base/content/test/browser-tabcrashed/browser_aboutRestartRequired.toml", "browser/base/content/test/browser-tabcrashed/browser_aboutRestartRequired_noForkServer.toml", "browser/components