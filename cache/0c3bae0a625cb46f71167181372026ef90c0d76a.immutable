 "third_party/libwebrtc/call/version.cc"], "git_node": "2bc17517744b67a53f05ce73e330138c69b15eaf", "git_parents": ["11b17fbbd67705dbcd5b6b1fbe708e4133353753"], "node": "00c36c6ee2e462fc9f6e4497356939a227f1469e", "parents": ["0ccc11375d479157b5f6e64d3828bbfde1f57ef0"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from ea9cc47bc8\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ea9cc47bc8e751a597f5e7bcfb1fe8bb37b4e4ae\n    Change RtpHeaderExtensionId underneath type to be uint8_t\n\n    Keep 'int' in the api.\n\n    This allows to reduce memory size when storing set of such values.\n    In particular each RtpPacket keeps an id\u003c-\u003etype mapping.\n\n    Bug: webrtc:514817938\n    Change-Id: Ic260c71594bda4aa111887a6403bd6043f6993bd\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497420\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48419}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/rtp_header_extension_id.h", "third_party/libwebrtc/api/rtp_parameters.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch"], "git_node": "1615e21f3277cbb5390bf6effc1a6a48a9091669", "git_parents": ["2bc17517744b67a53f05ce73e330138c69b15eaf"], "node": "1b15e16334e0e7755d83dd8d74f8714fe9133b87", "parents": ["00c36c6ee2e462fc9f6e4497356939a227f1469e"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 5731072669\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5731072669fa92317112c3146b9147f51d2ac0d7\n    This change adds support for preserving the abandoned, nacked, and to-be-retransmitted states of outstanding data chunks during socket handover.\n\n    Bug: webrtc:477364365\n    Change-Id: I363da73bf0acbacf8eb98298fddf8a91f8bbd204\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497140\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48420}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data.cc", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data.h", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data_test.cc", "third_party/libwebrtc/net/dcsctp/tx/retransmission_queue.cc", "third_party/libwebrtc/net/dcsctp/tx/retransmission_queue_test.cc"], "git_node": "374b69b0339974fb6cbc31eb0e00a6d1a6cba3d6", "git_parents": ["1615e21f3277cbb5390bf6effc1a6a48a9091669"], "node": "c068b71b62fbf42e84c944693f70bf6e77c8f564", "parents": ["1b15e16334e0e7755d83dd8d74f8714fe9133b87"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from bac956f8dc\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bac956f8dc89fee6d666f8d3e4764645ec15ffb3\n    Remove obsolete vp9_scan.h TSan suppression\n\n    libvpx converted VP9 scan order tables in vp9_scan.h/c to static const\n    lookup tables, eliminating lazy runtime initialization and global\n    mutable state upstream.\n\n    Bug: none\n    Change-Id: I314dc45115bd380f267e8c4b67036273c9b81e85\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/496981\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Auto-Submit: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48421}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/sanitizers/tsan_suppressions_webrtc.cc"], "git_node": "f3bb3922ffb29727096fdf577e31f136c2a1ca96", "git_parents": ["374b69b0339974fb6cbc31eb0e00a6d1a6cba3d6"], "node": "b9e78fa20571f4d94df4c9546bae805e8d12e4b8", "parents": ["c068b71b62fbf42e84c944693f70bf6e77c8f564"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 8016422260\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8016422260d37e0e1422aca053030aa030a29870\n    Remove obsolete UBSan vptr suppression\n\n    third_party/protobuf renamed cpp_message.cc to message.cc. Furthermore,\n    modern Protobuf uses __builtin_offsetof on Clang to avoid invalid\n    pointer arithmetic UBSan vptr issues.\n\n    Bug: none\n    Change-Id: I727055818b39bc862b0eaa9503465fc7efb4f040\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497500\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Auto-Submit: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48422}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/sanitizers/ubsan_vptr_suppressions.txt"], "git_node": "62669e4dff5dcf828cdbb58cdbf3a9ce68a278ff", "git_parents": ["f3bb3922ffb29727096fdf577e31f136c2a1ca96"], "node": "c2391af2a6377a5b705c2c78877aa70a942ed99b", "parents": ["b9e78fa20571f4d94df4c9546bae805e8d12e4b8"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 6ded79875c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6ded79875c0aef8e08d7e79a44744736fc96cf6e\n    Avoid recreating VideoReceiveStream on decoder updates\n\n    Previously, updating receive codecs forced a full teardown and\n    recreation of VideoReceiveStream2.\n\n    Address this by dynamically updating registered codecs and decoders on\n    the existing stream using a new SetDecoders() method to avoid stream\n    recreation.\n\n    Bug: webrtc:510361625, webrtc:42233985\n    Change-Id: I75745919de627e5aa480391ebff779298889e896\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494540\n    Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48423}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/video_receive_stream.h", "third_party/libwebrtc/media/engine/fake_webrtc_call.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0036.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc"], "git_node": "88f6cfe2d30fccbc9a14fd2385e2dde3aed67061", "git_parents": ["62669e4dff5dcf828cdbb58cdbf3a9ce68a278ff"], "node": "d91fc0e6548926be384f84ed069a3cf0d495c94d", "parents": ["c2391af2a6377a5b705c2c78877aa70a942ed99b"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 (MOZ) - Stub out SetDecoders to resolve build failures.\n", "files": ["media/webrtc/signaling/gtest/MockCall.h"], "git_node": "35ea6208ebd58252dfb5ee62ea222108a8ed4d51", "git_parents": ["88f6cfe2d30fccbc9a14fd2385e2dde3aed67061"], "node": "548e3a38535752a16f588849f28bc51836386c58", "parents": ["d91fc0e6548926be384f84ed069a3cf0d495c94d"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 85838010b2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/85838010b2d6c1a24b8463b94ec3b993292a67fc\n    Make the initial prior variance p00 configurable in TimestampExtrapolator\n\n    This change moves the hardcoded kP00 constant (initial prior variance\n    for the RTP clock rate) into the TimestampExtrapolator Config struct,\n    allowing it to be configured via field trials. It also adds validation\n    to ensure p00 is positive, falling back to the default value of 1.0\n    if an invalid value is provided, and updates the unit tests accordingly.\n\n    Bug: b/428657776\n    Change-Id: Ib93ed1b007e441fa493edbd846789ae245280206\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497440\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Auto-Submit: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48424}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0061.patch", "third_party/libwebrtc/video/timing/timestamp_extrapolator.cc", "third_party/libwebrtc/video/timing/timestamp_extrapolator.h", "third_party/libwebrtc/video/timing/timestamp_extrapolator_unittest.cc"], "git_node": "74e9fee3b116c8099966e4abdd5cd6c940b9b189", "git_parents": ["35ea6208ebd58252dfb5ee62ea222108a8ed4d51"], "node": "df877443ee105bc1de59b54a40038917c07ffcd0", "parents": ["548e3a38535752a16f588849f28bc51836386c58"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from ad227b7082\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ad227b70829db592f499f60acc1ccc17a6a9cd0b\n    SCReAM: Pause video encoding when congested and pacer queue is high\n\n    This CL pauses video encoding (sets target_rate to DataRate::Zero())\n    when the connection is congested and the pacer queue delay exceeds\n    MaxPacingDelayForPushback (500 ms default).\n\n    To prevent state flapping / oscillation on single packet ACKs,\n    hysteresis is applied: encoding remains paused until the connection\n    is no longer congested and the pacer queue delay has drained below\n    MinPacingDelayForPushback (100 ms default).\n\n    Bug: webrtc:447037083\n    Change-Id: Ic6dbf80536a89b61bd5fc2907e3cfac9160d89b2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497120\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48425}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller.h", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller_unittest.cc", "third_party/libwebrtc/test/peer_scenario/bwe_integration_tests/scream_test.cc"], "git_node": "a6d200895bdeb31789c2e75f9ceea99c4e1ce863", "git_parents": ["74e9fee3b116c8099966e4abdd5cd6c940b9b189"], "node": "5c474bc0fa93101610bcba19405ea8e128890b19", "parents": ["df877443ee105bc1de59b54a40038917c07ffcd0"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from fbe73e1aba\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fbe73e1abaf6f64156fe9504901e17ae399af9c9\n    [Wayland] Allow multiple PipeWireThreadLoop instances\n\n    In commit 46ce2a180cd0 (\"Bundle PipeWire structs into a class\"),\n    PipeWireThreadLoop was introduced with a static atomic boolean\n    restricting the class to a single process-wide instance.\n\n    This breaks multi-display capture in applications like Chrome Remote\n    Desktop, which creates an independent SharedScreenCastStream instance\n    for each display/monitor. When a second display is initialized,\n    PipeWireThreadLoop::Create() fails with \"PipeWireThreadLoop already\n    exists\".\n\n    PipeWire supports multiple independent pw_thread_loop instances within\n    a single process, and SharedScreenCastStreamPrivate manages its own\n    PipeWireThreadLoop lifetime via std::unique_ptr.\n\n    This change removes the singleton restriction and updates the unit test\n    to verify that multiple concurrent stream instances can be created and\n    started.\n\n    TAG=agy\n    CONV=59917ece-33ca-4611-9b34-73907bf19758\n\n    Bug: b:551867921\n    Change-Id: Ibe9077489f8b4f89421434fd1fea685b3c43f416\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497340\n    Commit-Queue: Lambros Lambrou \u003clambroslambrou@google.com\u003e\n    Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48426}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0072.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch"], "git_node": "20ab0e75e5c33f52d46ed84fe8a65e2380ad8165", "git_parents": ["a6d200895bdeb31789c2e75f9ceea99c4e1ce863"], "node": "6c445ca39d0a3acffb1ebe7f3139fc7b8d0998c7", "parents": ["5c474bc0fa93101610bcba19405ea8e128890b19"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 15954172a1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/15954172a1f52016cffe5a24e15c558cb637a698\n    Wayland screen capture: filter failed modifiers on all early return paths\n\n    EglDrmDevice::QueryDmaBufModifiers had several early returns when\n    querying formats or modifiers from EGL (such as when\n    eglQueryDmaBufModifiersEXT returns 0 modifiers, or when a format is\n    not supported for explicit modifiers). These code paths returned\n    {DRM_FORMAT_MOD_INVALID} directly without checking failed_modifiers_.\n\n    When a DMA-BUF import fails at runtime (e.g. FBO binding failure),\n    MarkModifierFailed() records the failed modifier and triggers stream\n    renegotiation. However, during renegotiation, QueryDmaBufModifiers()\n    hit one of the early returns and advertised {DRM_FORMAT_MOD_INVALID}\n    again, ignoring the previously recorded failures in failed_modifiers_.\n    This caused PipeWire and WebRTC to renegotiate the exact same failing\n    modifier in an infinite loop.\n\n    This CL extracts the failed-modifier filtering into a helper method,\n    FilterFailedModifiers(), and routes all return paths through it. When\n    all modifiers (including DRM_FORMAT_MOD_INVALID) have failed,\n    QueryDmaBufModifiers() returns an empty list, allowing PipeWire to\n    cleanly fall back to modifier-less shared memory (MemFd) capture.\n\n    TAG=agy\n    CONV=10883bca-c03b-48fe-9e0b-d1d51b06638a\n\n    Bug: b/523248782\n    Change-Id: I57bc54d171137c86a7870ad165eeca28a891a20c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497180\n    Commit-Queue: Lambros Lambrou \u003clambroslambrou@google.com\u003e\n    Auto-Submit: Lambros Lambrou \u003clambroslambrou@google.com\u003e\n    Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Reviewed-by: Jan Grulich \u003cgrulja@gmail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48427}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/egl_dmabuf.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/egl_dmabuf.h", "third_party/libwebrtc/moz-patch-stack/s0063.patch"], "git_node": "addf45bf27b5f449058420b0fad1c09564871648", "git_parents": ["20ab0e75e5c33f52d46ed84fe8a65e2380ad8165"], "node": "c2ba848e171506da99c89dded64521bba9f69998", "parents": ["6c445ca39d0a3acffb1ebe7f3139fc7b8d0998c7"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 1e7f4c3c39\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1e7f4c3c39e1aacaf8884452f80cd82749b1f8f1\n    Update WebRTC code version (2026-08-27T04:10:02).\n\n    Bug: None\n    Change-Id: Idc360c9a61468464849874f529904216f4b1e043\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497620\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48428}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "2530aba3ab74f2bb0afe9f195bf4d84273b0e01d", "git_parents": ["addf45bf27b5f449058420b0fad1c09564871648"], "node": "261e04f4d11c44c629f2acb335c67f5ae547dbc5", "parents": ["c2ba848e171506da99c89dded64521bba9f69998"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from deb7080366\n\nUpstream commit: https://webrtc.googlesource.com/src/+/deb7080366c489c4f225d54bded52bd92f14a6a5\n    Remove obsolete MSan suppression\n\n    WebRTC third_party/zlib does not use the MOZ_Z_ prefix or mozzconf.h.\n\n    Bug: none\n    Change-Id: Ibe3a90c4969d19df0953cc1a78d1d5d28688da51\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497520\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48429}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/sanitizers/msan_suppressions.txt"], "git_node": "1d545887ab883b8c17c5de309cdd74ac987e3cb6", "git_parents": ["2530aba3ab74f2bb0afe9f195bf4d84273b0e01d"], "node": "928df659d61f396dee6da8c8bfbcd50e2908286d", "parents": ["261e04f4d11c44c629f2acb335c67f5ae547dbc5"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 5c10f93376\n\nWe cherry-picked this in bug 2054622.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5c10f93376c1e9f0ff339bd1facf5b6d7d978f25\n    PipeWire: validate fd backing size before mmap\n\n    Validate that the fd actually backs the requested mapping range\n    by calling fstat and checking mapoffset + maxsize \u003c= st_size\n    before mmap, matching what PipeWire does in its own memory pool\n    (src/pipewire/mem.c). Skip the check for DmaBuf fds where fstat\n    does not reliably report the buffer size.\n\n    Bug: chromium:548689631\n    Change-Id: I39f04c9d4744d7e56e8e19451f1cea1df8962f62\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/496760\n    Reviewed-by: Andreas Pehrson \u003capehrson@mozilla.com\u003e\n    Commit-Queue: Jan Grulich \u003cgrulja@gmail.com\u003e\n    Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48430}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/5c10f93376.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0072.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch", "third_party/libwebrtc/moz-patch-stack/s0132.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch"], "git_node": "9709f34cfb1c34fdaa0918afc2777a0884996684", "git_parents": ["1d545887ab883b8c17c5de309cdd74ac987e3cb6"], "node": "80ecb469034da7cc8f6ae0deebf9faaf4e95878d", "parents": ["928df659d61f396dee6da8c8bfbcd50e2908286d"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 153c69baf2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/153c69baf2d60aa5bf786a2d1c77aec1d8b1af76\n    Remove more obsolete Protobuf UBSan vptr suppressions\n\n    Modern Protobuf uses __builtin_offsetof on Clang to compute field\n    offsets, eliminating the legacy raw pointer offset calculations in\n    generated code that previously required UBSan vptr suppressions.\n\n    Bug: none\n    Change-Id: Ib7a4f13355fbdda5520087337ee37a1aae99e304\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497540\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48431}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/sanitizers/ubsan_vptr_suppressions.txt"], "git_node": "5654d7f8de589e47adbebf3b60c51a5099a4ba03", "git_parents": ["9709f34cfb1c34fdaa0918afc2777a0884996684"], "node": "7185a7d5251d0c6734c948a9ba662a8da6d69be2", "parents": ["80ecb469034da7cc8f6ae0deebf9faaf4e95878d"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 8009904622\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8009904622b4a5c70e701c7097110afa035c1359\n    Migrate modules_tests to be a rtc_test_suite\n\n    Change-Id: I92db5b967db5d6144a81defdaebe730d5836c95d\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497521\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48432}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/BUILD.gn", "third_party/libwebrtc/modules/audio_coding/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0045.patch", "third_party/libwebrtc/moz-patch-stack/s0055.patch", "third_party/libwebrtc/moz-patch-stack/s0082.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0098.patch", "third_party/libwebrtc/moz-patch-stack/s0100.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch"], "git_node": "dbe3521ea54785fc4be829de1483a9417c880d76", "git_parents": ["5654d7f8de589e47adbebf3b60c51a5099a4ba03"], "node": "7fa765132b923b77bdf3dd3357058c42c091ead8", "parents": ["7185a7d5251d0c6734c948a9ba662a8da6d69be2"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 27e5ff1cd0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/27e5ff1cd0c1de34b1b654856420f370d6809c92\n    pc: add tracing framework\n\n    which allows implementing chrome's webrtc-internals inside libWebRTC\n\n    Bug: webrtc:532923549\n    Change-Id: Ia3392b0a78c5fc92ddcb490e49ae6337ba85e3d1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/488260\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48433}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/peer_connection_interface.cc", "third_party/libwebrtc/api/peer_connection_interface.h", "third_party/libwebrtc/api/peer_connection_tracer_interface.h", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/data_channel_controller.cc", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/peer_connection.h", "third_party/libwebrtc/pc/peer_connection_internal.h", "third_party/libwebrtc/pc/peer_connection_tracer_unittest.cc", "third_party/libwebrtc/pc/peer_connection_wrapper.cc", "third_party/libwebrtc/pc/peer_connection_wrapper.h", "third_party/libwebrtc/pc/sdp_offer_answer.cc", "third_party/libwebrtc/pc/sdp_offer_answer.h", "third_party/libwebrtc/pc/test/fake_peer_connection_base.h", "third_party/libwebrtc/pc/test/mock_peer_connection_internal.h"], "git_node": "68bd47b214547a186e60a31c027a68eac27880d4", "git_parents": ["dbe3521ea54785fc4be829de1483a9417c880d76"], "node": "3089f3ad55c47beb0c75f817bb971b6e8c195a5e", "parents": ["7fa765132b923b77bdf3dd3357058c42c091ead8"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 529b187ca6\n\nUpstream commit: https://webrtc.googlesource.com/src/+/529b187ca65a338701098f07fc517efe0ba2333a\n    Add `VideoJitterTimingFactory` to PCLF `PeerConnectionFactoryComponents`\n\n    Bug: b/384950328\n    Change-Id: I5d0259c71582cdde5f3d4a19b8fbdea81a620ab4\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497660\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48434}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/test/pclf/BUILD.gn", "third_party/libwebrtc/api/test/pclf/media_quality_test_params.h", "third_party/libwebrtc/api/test/pclf/peer_configurer.cc", "third_party/libwebrtc/api/test/pclf/peer_configurer.h", "third_party/libwebrtc/test/pc/e2e/test_peer_factory.cc"], "git_node": "c88e46929f5794d96d3c7794c6111c7c9aeb1c0d", "git_parents": ["68bd47b214547a186e60a31c027a68eac27880d4"], "node": "9764d83679a53a89e75e0151f92709fd28688215", "parents": ["3089f3ad55c47beb0c75f817bb971b6e8c195a5e"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 84b9fc5663\n\nUpstream commit: https://webrtc.googlesource.com/src/+/84b9fc5663c90920294f7f8f6d4a7a5cb30d0b60\n    Update WebRTC code version (2026-08-28T04:09:43).\n\n    Bug: None\n    Change-Id: I62955a2e9a62a3f61585ab36bcc0b48ad93adf0d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497700\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48435}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "960dcb938eff789ce68e84e8f2ec996b8934edb2", "git_parents": ["c88e46929f5794d96d3c7794c6111c7c9aeb1c0d"], "node": "118f524b097a5abb569d53d160a2a8835f1b352f", "parents": ["9764d83679a53a89e75e0151f92709fd28688215"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 44d3a8877e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/44d3a8877e710ba2cde7c9dd76b98af65cd1a8f9\n    Fix first media packet notification\n\n    Move the notification to be issued post demuxing to make sure it's not\n    issued for discarded packets. Now when media streams receive their first\n    RTP packet, propagate a notification via the RtpTransceiver on the\n    signaling thread to bind unsignaled streams.\n\n    - Move the packet notification from the BaseChannel implementation to\n      the media receiver classes (post demuxing).\n    - Clean up ChannelCallbacks accordingly.\n    - Propagate callback from RtpTransceiver to media receive channels.\n    - Update RtpReceiver to track its SSRC on the signaling thread and bind\n      unbound receivers on first packet arrival.\n\n    Bug: webrtc:42222804, webrtc:11993, webrtc:42222976\n    Change-Id: I11e1a3c0e9743b99886d761b7125b7185ee85798\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494443\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48436}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/audio_receive_stream.cc", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive.h", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/audio_receive_stream.h", "third_party/libwebrtc/call/video_receive_stream.cc", "third_party/libwebrtc/call/video_receive_stream.h", "third_party/libwebrtc/media/BUILD.gn", "third_party/libwebrtc/media/base/fake_media_engine.cc", "third_party/libwebrtc/media/base/fake_media_engine.h", "third_party/libwebrtc/media/base/media_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0036.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0039.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0100.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/moz-patch-stack/s0144.patch", "third_party/libwebrtc/pc/audio_rtp_receiver.cc", "third_party/libwebrtc/pc/channel.cc", "third_party/libwebrtc/pc/channel.h", "third_party/libwebrtc/pc/channel_interface.h", "third_party/libwebrtc/pc/rtp_receiver.cc", "third_party/libwebrtc/pc/rtp_receiver.h", "third_party/libwebrtc/pc/rtp_sender_receiver_unittest.cc", "third_party/libwebrtc/pc/rtp_transceiver.cc", "third_party/libwebrtc/pc/rtp_transceiver.h", "third_party/libwebrtc/pc/test/mock_rtp_receiver_internal.h", "third_party/libwebrtc/pc/video_rtp_receiver.cc", "third_party/libwebrtc/video/BUILD.gn", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc", "third_party/libwebrtc/video/timing/simulator/assembler.cc", "third_party/libwebrtc/video/video_receive_stream2.cc"], "git_node": "7438656e01f3a0b6ce29f76d7f4e4268f9bf4b7d", "git_parents": ["960dcb938eff789ce68e84e8f2ec996b8934edb2"], "node": "10428b44cadb09466aadabd79c37f97a5801e3bf", "parents": ["118f524b097a5abb569d53d160a2a8835f1b352f"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - (fix-44d3a8877e) support AudioReceiveStreamInterface::Config.Copy() with move-only on_first_packet\n\nConfig::Copy() relied on a defaulted copy constructor, which upstream's\naddition of the move-only on_first_packet AnyInvocable member (in\n44d3a8877e) implicitly deletes. Rewrite Copy() to construct a fresh\nConfig and copy each field explicitly, skipping on_first_packet, the\nsame approach already used by VideoReceiveStreamInterface::Config::Copy()\nfor the same member.\n", "files": ["third_party/libwebrtc/call/audio_receive_stream.cc", "third_party/libwebrtc/call/audio_receive_stream.h"], "git_node": "371d0d406447226561a2e8c1b27d38506e68b8cf", "git_parents": ["7438656e01f3a0b6ce29f76d7f4e4268f9bf4b7d"], "node": "4012fbfca26be4d783d6e7ff46e3cf2096ed7820", "parents": ["10428b44cadb09466aadabd79c37f97a5801e3bf"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 7d97704c7b\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7d97704c7b13aa6ec41f504090008a5006c6f7f7\n    Use std::atomic for logging severity globals and remove TSan suppression\n\n    - Use std::atomic\u003cLoggingSeverity\u003e with relaxed memory ordering for\n    g_min_sev and g_dbg_sev in rtc_base/logging.cc.\n    - Remove the obsolete race:rtc_base/logging.cc suppression.\n\n    Bug: none\n    Change-Id: Ibd6a94a65f14440dbb30c3f562854ab1a98cb575\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497640\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48437}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/rtc_base/logging.cc", "third_party/libwebrtc/tools_webrtc/sanitizers/tsan_suppressions_webrtc.cc"], "git_node": "5dac3f562e8b18ead8b999842883906e46b3d2ce", "git_parents": ["371d0d406447226561a2e8c1b27d38506e68b8cf"], "node": "47fe6ee5eab9040be8450c6a4973e86a877cbaaa", "parents": ["4012fbfca26be4d783d6e7ff46e3cf2096ed7820"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from df070795f2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/df070795f2e15322388df94d7d29b9ed0fbdcf1a\n    Update WebRTC code version (2026-08-29T04:06:23).\n\n    Bug: None\n    Change-Id: Ie691dab4f24496a902b32e3c254d7c7215923d43\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497880\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48438}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "f55da91c8f00b8f9861a4a35400ad1f7ac6af1ea", "git_parents": ["5dac3f562e8b18ead8b999842883906e46b3d2ce"], "node": "428b49e5f1c16a6c46c3e397f48e2bbc95631d2f", "parents": ["47fe6ee5eab9040be8450c6a4973e86a877cbaaa"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 341526e2ca\n\nUpstream commit: https://webrtc.googlesource.com/src/+/341526e2caf9c24e856c9bbb2c57477e3c8618e4\n    [Interop 2026] Apply simulcast scaling defaults\n\n    Apply scale_resolution_down_by defaults to video encodings passed to\n    AddTransceiver. If any encoding provides a value, fill missing values\n    with 1.0 before trimming the list. Otherwise, assign descending powers\n    of two after trimming.\n\n    This aligns sender parameters with the WebRTC addTransceiver algorithm\n    and fixes two Interop 2026 WPT subtests in Chromium.\n\n    R=perkj@webrtc.org, tommi@webrtc.org\n\n    Bug: chromium:344943229\n    Change-Id: I490175e44f1b840e537d4e24718ca7cbef45389a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497360\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48439}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/peer_connection_encodings_integrationtest.cc", "third_party/libwebrtc/pc/peer_connection_rtp_unittest.cc"], "git_node": "26980d352d69e23385a55d1e1e1d0b1da0db61de", "git_parents": ["f55da91c8f00b8f9861a4a35400ad1f7ac6af1ea"], "node": "3cda4a7a4ee6127e8326df9940bd23a6a186aa87", "parents": ["428b49e5f1c16a6c46c3e397f48e2bbc95631d2f"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 812c343446\n\nUpstream commit: https://webrtc.googlesource.com/src/+/812c343446e6b2b585a2de072eb14986d6be098b\n    call: Require decoded audio in A/V sync perf tests\n\n    Pass the audio receive stream to VideoRtcpAndSyncObserver and wait for\n    received audio to be decoded before reporting synchronization success.\n\n    Bug: webrtc:42224973\n    Change-Id: Ib908582b4ef3441230487749e778e543ff8867ea\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497580\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48440}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/call_perf_tests.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch"], "git_node": "ea6ee59498fdee97bbb19485b4cd1aae515e7454", "git_parents": ["26980d352d69e23385a55d1e1e1d0b1da0db61de"], "node": "3441f5cc5e4fd2e03bd6a4b51159774fcef52c2e", "parents": ["3cda4a7a4ee6127e8326df9940bd23a6a186aa87"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 9caa922356\n\nUpstream commit: https://webrtc.googlesource.com/src/+/9caa9223562c33a4662ceccb7a3e488b268944b9\n    Update WebRTC code version (2026-08-30T04:10:43).\n\n    Bug: None\n    Change-Id: I7bb6922188f43451bd0f84a4e96ac4480b61d9bc\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497920\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48441}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "e776fc7c581abcccfd9b2fcb3ce81931f75bc188", "git_parents": ["ea6ee59498fdee97bbb19485b4cd1aae515e7454"], "node": "5eaed3486f33c8f8c0a9946d0630bc525b9e57d0", "parents": ["3441f5cc5e4fd2e03bd6a4b51159774fcef52c2e"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 5f716febe0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5f716febe001aa000b79acc4bfbe495df9d2947b\n    Update and use video_coding_modules_tests_resources in video coding modules.\n\n    Not sure where videocodec_test_av1.cc and videocodec_test_libvpx.cc found the foreman_cif.yuv resource prior to this change.\n\n    Change-Id: Icb9cd4c5764aaa91e0c4bbf0b78d775a102887da\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497900\n    Commit-Queue: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Auto-Submit: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48442}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/resources/BUILD.gn"], "git_node": "09b15255687722a6b2b173f102e010528731c23b", "git_parents": ["e776fc7c581abcccfd9b2fcb3ce81931f75bc188"], "node": "5b2a44effd83182938edad5c619e2a180a0f4273", "parents": ["5eaed3486f33c8f8c0a9946d0630bc525b9e57d0"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from c3c5cd0e94\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c3c5cd0e948564ba3d25434cba7bcdaab85ab814\n    Update WebRTC code version (2026-08-31T04:07:47).\n\n    Bug: None\n    Change-Id: Iab995637c4c3aae48eb643bdda19e8129b482d1f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497960\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48443}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "50061065670f8efaf5a9c79ec381b9da5a8eb192", "git_parents": ["09b15255687722a6b2b173f102e010528731c23b"], "node": "bd3a389e37128aa9c72c77f03b23999771ae1db2", "parents": ["5b2a44effd83182938edad5c619e2a180a0f4273"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from bb91915655\n\nWe cherry-picked this in bug 2055093\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bb91915655ac409c482e0bf25304605a06435608\n    In VideoCaptureDS use Stop instead of StopWhenReady\n\n    As reported on Firefox an Insta360 Link 2 Pro camera has a driver bug\n    that leaves the camera light on until reboot when using StopWhenReady\n    during teardown of a capture session.\n\n    See https://bugzilla.mozilla.org/show_bug.cgi?id=2055093\n\n    Using Stop instead works around the driver bug, and better matches\n    Chromium's DirectShow backend.\n\n    Bug: none\n    Change-Id: I90862fb94907638394df476abf4fcca3b532f50c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497541\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Andreas Pehrson \u003capehrson@mozilla.com\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48444}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/bb91915655.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0147.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch"], "git_node": "64d572511940ba0403a820edd6ed3ee67ac88937", "git_parents": ["50061065670f8efaf5a9c79ec381b9da5a8eb192"], "node": "a3431a17b0f2205cb75ae0877c907a2e7089c7ea", "parents": ["bd3a389e37128aa9c72c77f03b23999771ae1db2"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 24886f3cf1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/24886f3cf1c85e6d3f7f8e95848144cb70530b8f\n    make stats_timestamp_with_environment_clock defaults to true\n\n    Change-Id: Ib5aa3771a4a1a73ed9244ae1efa5b45457170c67\n    Bug: webrtc:370535296\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498020\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48445}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/stats/rtc_stats.h", "third_party/libwebrtc/media/base/media_config.h"], "git_node": "226569bb9e673c8ca38f4d8f200836cd772f9c07", "git_parents": ["64d572511940ba0403a820edd6ed3ee67ac88937"], "node": "b3ec6b48ab5c72854a64e35b8b04d722fb3c83fc", "parents": ["a3431a17b0f2205cb75ae0877c907a2e7089c7ea"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from a70221b3ab\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a70221b3abff840970d947a2618dabd46405694e\n    Add on_frame_delivered_callback to media and call layers\n\n    This is step #1 of 5 of incrementally landing the changes from:\n    https://webrtc-review.git.corp.google.com/c/src/+/494041/ (a CL that's\n    pretty big as is).\n\n    The overall goal of these CLs is to move the SourceTracker from\n    ChannelReceive (audio) and VideoReceiveStream2 (video) into\n    RtpReceiverBase and be accessible on the signaling thread rather than\n    interfere with the worker (usually joined with network) thread. This\n    offloads the worker/network thread for managing the SourceTracker and\n    also moves the tracker closer to the API layer which it implements\n    (getContributingSources).\n\n    In this CL: Introduce the on_frame_delivered_callback into\n    AudioReceiveStreamInterface::Config,\n    VideoReceiveStreamInterface::Config, and the channel creation methods in\n    media_engine.h.\n\n    Bug: chromium:463591201, webrtc:42222117\n    Change-Id: Ib6d77bd7b74b080e0cd20edec9538a54eb8c7ad3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497740\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48446}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/audio_receive_stream.h", "third_party/libwebrtc/call/video_receive_stream.cc", "third_party/libwebrtc/call/video_receive_stream.h", "third_party/libwebrtc/media/base/media_engine.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0036.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0144.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch"], "git_node": "9a2537dd0c6b6b095830918ecfda7933d7b55418", "git_parents": ["226569bb9e673c8ca38f4d8f200836cd772f9c07"], "node": "d7af1358e0a18276d476a13b18a9e92faf4ecf23", "parents": ["b3ec6b48ab5c72854a64e35b8b04d722fb3c83fc"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 57f79e8e19\n\nUpstream commit: https://webrtc.googlesource.com/src/+/57f79e8e198c946f781606df091e733f3d033c5f\n    Implement Audio Callback and Deprecate Audio GetSources\n\n    This is step #2 of 5 of incrementally landing the changes from:\n    https://webrtc-review.git.corp.google.com/c/src/+/494041/ (a CL that's\n    pretty big as is).\n\n    The overall goal of these CLs is to move the SourceTracker from\n    ChannelReceive (audio) and VideoReceiveStream2 (video) into\n    RtpReceiverBase and be accessible on the signaling thread rather than\n    interfere with the worker (usually joined with network) thread. This\n    offloads the worker/network thread for managing the SourceTracker and\n    also moves the tracker closer to the API layer which it implements\n    (getContributingSources).\n\n    In this CL: Update ChannelReceive to trigger the callback when a frame\n    is processed. Keep GetSources() functional in this layer for now so\n    higher layers don't break.\n\n    Bug: chromium:463591201, webrtc:42222117\n    Change-Id: If6a72c424da7cb36f7dcfe500b5d59cb1c1e6ef5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497760\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48447}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/BUILD.gn", "third_party/libwebrtc/audio/audio_receive_stream.cc", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive.h", "third_party/libwebrtc/call/audio_receive_stream.h", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0039.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/moz-patch-stack/s0144.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch"], "git_node": "67bbac0bc577525495399cbc70c60e9efab0f81d", "git_parents": ["9a2537dd0c6b6b095830918ecfda7933d7b55418"], "node": "6d43b11138e9bff67ec0147d397dc6d139f94ec1", "parents": ["d7af1358e0a18276d476a13b18a9e92faf4ecf23"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from c2b761bb73\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c2b761bb73f0b2ced096274abb415f6c7559a28b\n    [M154] Fix issue where codec fallback skips first codec in list.\n\n    Before this CL, `ApplyEncoderSwitch` implicitly assumed that\n    `send_codec()` is the first codec in `negotiated_codecs_`, but this is a\n    very outdated assumption that assumes that the only way to pick a codec\n    is with the SDP preference order (e.g. `SetCodecPreferences()` or SDP\n    munging).\n\n    But it has long been the case that `SetParameters()` can pick another\n    codec. This CL updates the logic to remove the `send_codec()` where\n    ever it is located, resulting in the next codec to test being the first\n    one in the list should the current one not be the first one already.\n\n    (cherry picked from commit 573c5c6224a4299603d510c0dd8e572cf0a635aa)\n\n    Bug: chromium:556170878\n    Fixed: chromium:557044346\n    Change-Id: I7c8f50537ef52cae3af2c0d460096a4b97045703\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498561\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Original-Commit-Position: refs/heads/main@{#48477}\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/500680\n    Commit-Queue: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8037@{#1}\n    Cr-Branched-From: 57f79e8e198c946f781606df091e733f3d033c5f-refs/heads/main@{#48447}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc"], "git_node": "9e4ba5f8a056a91000b369dd508c1e438e3a2192", "git_parents": ["67bbac0bc577525495399cbc70c60e9efab0f81d"], "node": "676f285ecde1b5c825bcfb6ea533abfe0e06c5f1", "parents": ["6d43b11138e9bff67ec0147d397dc6d139f94ec1"], "tags": []}], "date": 1789407367, "git_changesets": ["76cbb5410ee49d7efe3335805cabb0929ddd388e", "8ded35724bb29721fa09a19190214e7a5aacc724", "1ee5cb2eb301786a632f48ee1583f557dfa82a36", "22b7ebef5a22d9957977584fab67b5a6ef82e80c", "cf4799ab0a0d60a8e0c1a748ae0d08d271f2b76d", "93e1d01af517c176cb735c911c8853a52cd83aa3", "c0b4925905f935ac85102c068f999bae0e5d2302", "014b70caab8d7371a92002f407fca6f340432d6d", "3ed5740f6a4cbe7989166a1d1f0f0ac669f5a93a", "b91c8c30e57f20bf30866e6858a0d7a6527c1e8f", "269ca53e33be1f6891ea37627267dc4e3db92a71", "cc493557d7066bfe0fba82a4e2fdf5db1da1a49c", "13b9d76b91976d5e90d649c2f468e4f2fdc1fd87", "9e38f5376d5b29847f992a744d5ef290ce59fb04", "3596a0fa212cdef96873e9a7952f7c80e519ac23", "6708e8a5e0f30e6f95bc4cf7640c7880b5dd5226", "2c1417058b9287bb4fcb9959d8ff8007ee2212b5", "ecb0fa050e06bc97a3ea9a4ee5a691f93aaab03f", "bdd487882f48c251dafb78f628c4556e75cf3fc7", "83a6c20601eebe8a004bbb574268d4ba7d79c4d9", "29b968608feb4c8b0ea3bf305c71b31a004597a7", "2527c5815078190550a31233453d50ad07424efd", "7219b525d4f8fc8bcb008be50f804a3091c0361e", "d7bfd770e469272efae7732d52746237cdb166c3", "760f64ca604d3138c9974ad93c90e0a96da683ce", "e0215890312a377fa281c25c21bfeffd71f19eb9", "642c369e61fdfde9edac5f432a833d5c3d403d5c", "06ec4512447dc380955a7532ef624342d34e5efe", "528fc0e03132d5afbcce6942b8385d64cae06dbe", "825100f117f02b9074ef38ef280f9c3e5caba5fb", "5be974313690510221664f5af8809f00bc58fcd4", "e3244f42a797a6e99b4ee0259c1c5d9ad218b186", "59301537b5a37876e0b848dfed2d560b5b32e46d", "49b7c8a718a36269fd01f0587bb92c9046cf2e4