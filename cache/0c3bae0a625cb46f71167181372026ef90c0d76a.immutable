4ed217cc7eb8", "2ea7b98bd9116c6296d3ec3c03bc2a1acc62f4db", "4d7edbcabc03302b3a2d6faa38da4ff9b6624cd1", "7c6afa24c432f411d98637e3efe08796bdb61a1e", "3b73208458f4b9a6929e77865f0eda5113fdbb21", "b5572f5cae174a1d3da7fa23b0048806fb2981e7", "8b7328b69b8fba544bb3c048987010f11a83ceec", "5596734150ab0ed36e6744dbd3eb450fdaf912a5", "07d54308e530fa098a293c01575f60c99cde6054", "e0793a08f7e08fc35354845c86ea1a2102260fb3", "dea81647d4ebe27eca0261e05d63e9b19f1ec9d0", "224e74507b59d7542f833d2fb860c4bf6bacf2d5", "96ad2f326934d793f8b4b6ccfdd8513b24c6ec06", "c1fb2a5d83308f3aab5b0b3a08a08862c1c5775e", "a7c4439607c453e0c530cdd1273560fb5a0ae09b", "4e2d7c9adb6a6f014d0d723281ad6bfa65daffec", "ff2ca7cd1a720296b1b613c1ce47a4fe806396a2", "bde41fefbf3bbf89990216d2ce855bd1a023789d", "2fffd90776ed10d13d2638feb54f90e78f4da0f8", "6fa52227bba4e32f96cc83d79ebbab62a7615ceb", "9f08115dea2759a35e40e942c343ba27a2003e43", "39078f0345add51500f34ccfa790f93c199b796d", "931c3ad3ca3f6a257b54852874441a5fce70bedf"], "user": "ctuns@mozilla.com"}, "45350": {"changesets": [{"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072680 - Support GetBBox options for tspan/textPath bounding boxes r=firefox-svg-reviewers,dholbert\" for causing wpt failures in SVGGraphicsElement.getBBox-02.html\n\nThis reverts commit 39078f0345add51500f34ccfa790f93c199b796d.\n", "files": ["dom/svg/SVGGraphicsElement.cpp", "layout/svg/SVGTextFrame.cpp", "layout/svg/SVGTextFrame.h", "layout/svg/SVGUtils.cpp", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-02.html", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-05.html"], "git_node": "44fc868ee68037f82c428d007d2c5ca9ec429525", "git_parents": ["931c3ad3ca3f6a257b54852874441a5fce70bedf"], "node": "c7a52d1f9a789a7338af3481d88813a63e1aa528", "parents": ["577f87cc46d84de81d09b4f2051df233dad483e4"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069400 - Add test for invalid remote drag invocation; r=smaug\" for causing mochitests failures in browser_dragdrop_invalid_remote_drag.js.\n\nThis reverts commit 931c3ad3ca3f6a257b54852874441a5fce70bedf.\n", "files": ["dom/events/test/browser.toml", "dom/events/test/browser_dragdrop_invalid_remote_drag.js"], "git_node": "e3285238626d45d2ec7ee8941fc1c49615730ba5", "git_parents": ["44fc868ee68037f82c428d007d2c5ca9ec429525"], "node": "3b08ff1879d5684fb00430411a9c38ea27e1cdc2", "parents": ["c7a52d1f9a789a7338af3481d88813a63e1aa528"], "tags": []}], "date": 1789639382, "git_changesets": ["44fc868ee68037f82c428d007d2c5ca9ec429525", "e3285238626d45d2ec7ee8941fc1c49615730ba5"], "user": "sstanca@mozilla.com"}, "45351": {"changesets": [{"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2067169 - Add missing debug-mode stackmaps for wasm::Trap::NullPointerDereference.  r=yury.\n\nThis patch adds stackmaps associated with wasm-GC instructions that might trap\ndue to null pointer dereferencing.\n\nThe changes fall into two groups, the first of which is:\n\n* MacroAssembler::{callRef, returnCallRef}: make these able to use the\n  StackMapRegistry mechanism added in bug 2049604.  These get two new\n  parameters, a StackMapRegistry* that allows them to register stackmaps\n  whenever they want, and a StackMap*, which is the stackmap to be registered.\n\n* BaseCompiler::{callRef, returnCallRef}: if compiling for debug mode, create a\n  stackmap for trap associated with the dereference in the call, and pass it to\n  the MacroAssembler, along with the registry, as needed.\n\nSecond group is:\n\n* BaseCompiler::{NoNullCheck,SignalNullCheck}::emitTrapSite: also accept a\n  StackMap* to register along with the trap.\n\n* BaseCompiler::{emitGcArrayGetNumElements, emitGcGet, emitGcSetScalar,\n  emitStructGet, emitStructSet}: Create debug-only stackmaps and give them\n  to {NoNullCheck, SignalNullCheck}::emitTrapSite as required.\n\nRidealong fix:\n\n* BaseCompiler::createDebugOnlyStackMapForNonResumingTrap: make it clearer that\n  `*result` is always initialized.  No functional change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321876\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmStubs.cpp"], "git_node": "8dbe857f9c9a2f7344b5b25a0f1e544fd8859c0e", "git_parents": ["931c3ad3ca3f6a257b54852874441a5fce70bedf"], "node": "f3f7d1c82f37db13abb878133c4073247b96d5cb", "parents": ["577f87cc46d84de81d09b4f2051df233dad483e4"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072680 - Support GetBBox options for tspan/textPath bounding boxes r=firefox-svg-reviewers,dholbert\" for causing wpt failures in SVGGraphicsElement.getBBox-02.html\n\nThis reverts commit 39078f0345add51500f34ccfa790f93c199b796d.\n", "files": ["dom/svg/SVGGraphicsElement.cpp", "layout/svg/SVGTextFrame.cpp", "layout/svg/SVGTextFrame.h", "layout/svg/SVGUtils.cpp", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-02.html", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-05.html"], "git_node": "2fdf021982eb3b2de169874d71a00b95f20e1b7a", "git_parents": ["8dbe857f9c9a2f7344b5b25a0f1e544fd8859c0e"], "node": "b8fdbc44a6415ca4ee7f1cb58f49589713e4d073", "parents": ["f3f7d1c82f37db13abb878133c4073247b96d5cb"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069400 - Add test for invalid remote drag invocation; r=smaug\" for causing mochitests failures in browser_dragdrop_invalid_remote_drag.js.\n\nThis reverts commit 931c3ad3ca3f6a257b54852874441a5fce70bedf.\n", "files": ["dom/events/test/browser.toml", "dom/events/test/browser_dragdrop_invalid_remote_drag.js"], "git_node": "63d7d0ac09615124f0f64920a9bb17c5ddf19b61", "git_parents": ["2fdf021982eb3b2de169874d71a00b95f20e1b7a"], "node": "14d71bb48d0c24d9612fd424ea28a66656f0447e", "parents": ["b8fdbc44a6415ca4ee7f1cb58f49589713e4d073"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge Mozilla-central to autoland\n", "files": [], "git_node": "ce5f610bc2a2a9ef930abe08d4d0c8d7191a5b04", "git_parents": ["63d7d0ac09615124f0f64920a9bb17c5ddf19b61", "e3285238626d45d2ec7ee8941fc1c49615730ba5"], "node": "dbd907cbb8f13fe0e80384287e358eb83d2ff65a", "parents": ["14d71bb48d0c24d9612fd424ea28a66656f0447e", "3b08ff1879d5684fb00430411a9c38ea27e1cdc2"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1977540: Always override the application data directory when running Firefox from mach. r=glandium\n\nThis makes mach always override the default application directory. `run`\nsupports a `--default-appdata` argument to undo that. The previously existing\n`--appdata` argument remains allowing setting a specific directory, when passed\nbare it does nothing as that is the new default behaviour.\n\nThis change also applies to tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326418\n", "files": ["python/mozbuild/mozbuild/mach_commands.py", "testing/mozbase/mozrunner/mozrunner/base/browser.py"], "git_node": "f10901f3b25bb762a19febfee3751a4e332c4a45", "git_parents": ["ce5f610bc2a2a9ef930abe08d4d0c8d7191a5b04"], "node": "fe65bbbd4f79618d4b7cb7e76cceb4e96534b2de", "parents": ["dbd907cbb8f13fe0e80384287e358eb83d2ff65a"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2064102 - Poll on isInBFCache instead of the entry URI in browser_policy_sitepolicies_serviceworkers.js. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326397\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_serviceworkers.js"], "git_node": "fc6e7dd5d609bcb326fad01e607037f681838173", "git_parents": ["f10901f3b25bb762a19febfee3751a4e332c4a45"], "node": "26e8fd80abe344cb3c12545de7f8ff7d9d0b1e97", "parents": ["fe65bbbd4f79618d4b7cb7e76cceb4e96534b2de"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950950 - Plumb H264 profile and level into WebrtcGmpVideoCodec. r=webrtc-reviewers,media-playback-reviewers,ng,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321193\n", "files": ["dom/media/gtest/TestH264FmtpParser.cpp", "dom/media/platforms/agnostic/gmp/GMPVideoEncoder.cpp", "dom/media/webrtc/GMPH264Utils.h", "dom/media/webrtc/H264FmtpParser.cpp", "dom/media/webrtc/H264FmtpParser.h", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp", "dom/media/webrtc/moz.build"], "git_node": "d178175b4ffbf0fa12a1c308d05aeb986042e908", "git_parents": ["fc6e7dd5d609bcb326fad01e607037f681838173"], "node": "9976921482c5c7ea224de8eab2940e4642203d5a", "parents": ["26e8fd80abe344cb3c12545de7f8ff7d9d0b1e97"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950950 - Drive-by: In TestWebrtcGmpVideoEncoder wait for the GMP thread to run to completion before destroying stack objects. r=webrtc-reviewers,bwc\n\nThe Encode, BackPressure and ReUse tests resolve a stack-owned\nMozPromiseHolder from the encoder callback on the GMP thread.\nMozPromiseHolder::Resolve() dispatches the Then() callback before clearing\nits promise pointer, so the test body could return from WaitForResolve() and\ndestroy the holder before the GMP thread had cleared it, tripping\nMOZ_ASSERT(!mPromise). Wait for the GMP thread to drain before returning.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326419\n", "files": ["dom/media/gtest/TestWebrtcGmpCodec.cpp"], "git_node": "79a2175c9aaa1151f4d9ec6826430a3cfaba0ccb", "git_parents": ["d178175b4ffbf0fa12a1c308d05aeb986042e908"], "node": "4c2e5ec023000dd54d36999f4177e4b358697de5", "parents": ["9976921482c5c7ea224de8eab2940e4642203d5a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072783 - Remove NO_BORROWED_GETTER for trivial properties. r=firefox-style-system-reviewers,boris\n\nJust use the right type on the C++ side.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326807\n", "files": ["layout/style/nsStyleStruct.h", "servo/components/style/properties/data.py"], "git_node": "8d4a7915567463bae302f303ad357cafacb91c30", "git_parents": ["79a2175c9aaa1151f4d9ec6826430a3cfaba0ccb"], "node": "079169430b8cd05c2c53ebced201954811807bb1", "parents": ["4c2e5ec023000dd54d36999f4177e4b358697de5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072783 - Remove NO_BORROWED_GETTER properties that really want slices. r=firefox-style-system-reviewers,boris\n\nWe can return a slice rather than relying on the precise underlying type\nbeing generated... Alternatives would involve ugly hacks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326808\n", "files": ["servo/components/style/properties/data.py", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/properties.mako.rs"], "git_node": "69ca37468af1ff54cc2acf6a99bd6e9324caca5a", "git_parents": ["8d4a7915567463bae302f303ad357cafacb91c30"], "node": "b799cd7400f683e2c621693c4ba8b94fb30cc0e3", "parents": ["079169430b8cd05c2c53ebced201954811807bb1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072783 - Remove NO_BORROWED_GETTER for x-lang. r=firefox-style-system-reviewers,layout-reviewers,boris\n\nUse the right type, and simplify a bit some other properties while at it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326809\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "js/src/devtools/rootAnalysis/analyzeHeapWrites.js", "layout/base/nsLayoutUtils.cpp", "layout/base/nsQuoteList.cpp", "layout/forms/nsComboboxControlFrame.cpp", "layout/generic/ReflowInput.cpp", "layout/generic/nsLineLayout.cpp", "layout/generic/nsPageSequenceFrame.cpp", "layout/generic/nsTextFrame.cpp", "layout/generic/nsTextRunTransformations.h", "layout/mathml/nsMathMLChar.cpp", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/ServoBindings.toml", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/data.py", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/values/specified/font.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": "a97b525f1c80e69fbd2db1a27953dc07bb661c18", "git_parents": ["69ca37468af1ff54cc2acf6a99bd6e9324caca5a"], "node": "38feddb85788e47be9641e48c9393fbe5f29f272", "parents": ["b799cd7400f683e2c621693c4ba8b94fb30cc0e3"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2072783: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "layout/generic/nsTextFrame.cpp"], "git_node": "14270bdf315b2bc87b7a505a68fe68708d59e56f", "git_parents": ["a97b525f1c80e69fbd2db1a27953dc07bb661c18"], "node": "0eb4e2138afc3d995897dedda1cb32e4e367b1ba", "parents": ["38feddb85788e47be9641e48c9393fbe5f29f272"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072660 - Remove nightly build annotations now that skpdf is riding the trains. r=layout-reviewers,gfx-reviewers,dholbert,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326587\n", "files": ["testing/web-platform/m