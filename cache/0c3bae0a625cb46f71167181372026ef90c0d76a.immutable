", "0dab8e258f03094b29542ebf2ef6275865dd2924", "433fcf04866cd177a27d00cd0d5ed925dec8e033", "f88f105f64f93aeaceacffbc833bc0373d399112", "e68329cdfe14c6035f2b707cb6f7bf3e6518b278", "c73592233b27057012204db18a70d72d88680c43", "078cf145f2bc4a90fbbbbf22c108c02d88324844", "ada0b5fee70b94c3bdb62d4232fc608aea161309", "03df31713d6a8daa7878d7bcf2d067cf56c26ea8", "e7de89a8b2e79a0de884a07fb75bf1368f3da0d4", "96d72638c38ae1efd2f7b3347c5f340e34af91f9", "5b5f45152775f33b853d1ed48cc9522993194cb3", "ba97ecfa23af903350ae668351679868abe40129", "500cf2e43094e7b85458c218255d083365a436e9", "f21440122f5ab034c1d873182924ec972fbf11fa", "0e9fb565230de9bc96a65d8955ce19f877b3a386", "c693429a18e1fea61bc485d24db5e7c62a081e37"], "user": "abutkovits@mozilla.com"}, "45330": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069014 - Flatten 3D descendants of a flat transform in WebRender instead of forcing an isolation surface r=emilio\n\nGecko forced an isolation surface on any flat stacking context with a\nperspective or 3D-transformed descendant, to get WebRender to flatten the\ndescendant into that plane. That surface also became the backdrop root, which\nbroke backdrop-filter on every such descendant.\n\nWebRender flattens at coordinate-system boundaries, but a flat transform whose\nmatrix is a plain 2D scale/offset shared its parent's coordinate system. Reset\nthe coordinate system there instead. Dropping the isolation also restores the\nnative SVG filter path; two gaps that uncovered are fixed in bug 2070036 and\nbug 2070037.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323472\n", "files": ["gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/wrench/reftests/split/preserve3d-leaf-tight-perspective.yaml", "gfx/wr/wrench/reftests/split/preserve3d-leaf-under-flat-perspective.yaml", "gfx/wr/wrench/reftests/split/preserve3d-wrapper-under-flat-perspective.yaml", "gfx/wr/wrench/reftests/transforms/flatten-perspective-flat-2d-ref.yaml", "gfx/wr/wrench/reftests/transforms/flatten-perspective-flat-2d.yaml", "gfx/wr/wrench/reftests/transforms/reftest.list", "layout/generic/nsIFrame.cpp", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/reftests/svg/filters/css-filters/reftest.list", "layout/reftests/svg/filters/reftest.list", "layout/reftests/svg/filters/svg-filter-chains/reftest.list", "testing/web-platform/meta/css/filter-effects/backdrop-filter-nested-3d-transform-perspective.html.ini", "testing/web-platform/meta/css/filter-effects/svg-mutation-function-to-url.html.ini", "testing/web-platform/meta/css/filter-effects/svg-mutation-single-to-multiple-002.html.ini", "testing/web-platform/meta/css/filter-effects/svg-mutation-url-to-function.html.ini", "testing/web-platform/meta/css/filter-effects/svg-shorthand-hue-rotate-001.html.ini"], "git_node": "acfc2c2fa6678f7a683c64136096a37ec427d283", "git_parents": ["c693429a18e1fea61bc485d24db5e7c62a081e37"], "node": "3e4bf4eb991abd6763d9126cbed37d5059389735", "parents": ["f040509782d6f6657d250522bae9759f2ebd127a"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/engine-system/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-km/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-es/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/compose/tabstray/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/app-links/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/autofill/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/contextmenu/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/downloads/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/findinpage/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/media/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/readerview/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/lib/crash/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile