, "git_parents": ["88d9b8c5ffbb8026d42318bbd0e1c98c5c63e14b"], "node": "04a24e799546b26815680cba2018fd30371c18c7", "parents": ["ed338bd7c584296f7fa22b33ab27767b7f0edebe"], "tags": []}], "date": 1789377722, "git_changesets": ["b5b05ee64a3d5c23300a86c52559e7db66b552b7"], "user": "ffxbld@lando.moz.tools"}, "45319": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging f698bd67d5a3a3614e22ee46c8c4517be99cb566 with DEVEDITION_157_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "90783c7f985235f6037206718b719c3ea99aa3e2", "git_parents": ["b5b05ee64a3d5c23300a86c52559e7db66b552b7"], "node": "a692ef9b5992455e3a62b82c3b206cf19ff7edd1", "parents": ["04a24e799546b26815680cba2018fd30371c18c7"], "tags": []}], "date": 1789377784, "git_changesets": ["90783c7f985235f6037206718b719c3ea99aa3e2"], "user": "ffxbld@lando.moz.tools"}, "45320": {"changesets": [{"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2071169 - Reset aria-expanded on the previous anchor when a panel-list reopens by another r=dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325294\n", "files": ["toolkit/content/tests/widgets/test_panel_list_accessibility.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "a2aa1f4bc58a40bc11e228e6d1e3aa3e062f35af", "git_parents": ["535a3b47cc718316009e37b2302efa307a1915a7"], "node": "0178a86874c966a76a3d2b7a8fbc7f9f18d278f1", "parents": ["2bbfd2a79a7a581d79add528f0ea679ae7858ed6"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2065907 - fix intermittent test failures caused by browser having been set as the default in some cases. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324209\n", "files": ["browser/components/tests/browser/browser_browserGlue_fxa_client_info_ping.js"], "git_node": "eb161faade83590917d5725e244b8537f6946001", "git_parents": ["a2aa1f4bc58a40bc11e228e6d1e3aa3e062f35af"], "node": "9836639e8070f7a5aa0db1d028ece64a7c794647", "parents": ["0178a86874c966a76a3d2b7a8fbc7f9f18d278f1"], "tags": []}, {"author": "tannal \u003cmtan@igalia.com\u003e", "branch": "default", "desc": "Bug 2064615 - Add role for more MathML elements r=devtools-reviewers,nchevobbe,accessibility-platform-reviewers,Jamie\n\nThis adds a11y role mappings of MathML a, ms, annotation, annotation-xml, mphantom, mpadded, mprescripts, mspace, none and semantics element.\n\nRemove MATHML_STRING_LITERAL in favor of MATHML_TEXT, and AXSubrole for MATHML_TEXT should be AXMathText instead of AXMathRoot.\n\nSee https://github.com/w3c/mathml-aam/issues/41 for most of the added elements in details\n\nFor MathML a element, the preview of the spec is here:\nhttps://deploy-preview-2844--wai-aria.netlify.app/mathml-aam/#el-a\n\nUpdated the tests\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319703\n", "files": ["accessible/base/MathMLMarkupMap.inc", "accessible/base/RoleMap.inc", "accessible/base/nsAccessibilityService.cpp", "accessible/generic/DocAccessible.cpp", "accessible/html/HTMLLinkAccessible.cpp", "accessible/interfaces/nsIAccessibleRole.idl", "accessible/tests/browser/browser.toml", "accessible/tests/browser/doc_mathml.html", "accessible/tests/browser/role/browser.toml", "accessible/tests/browser/role/browser_link_roles.js", "accessible/tests/browser/role/browser_mathml_roles.js", "accessible/tests/mochitest/elm/test_MathMLSpec.html", "accessible/tests/mochitest/role.js", "devtools/server/actors/accessibility/walker.js"], "git_node": "bdd5cf9106982b1f77289ecda1a2ec700d657250", "git_parents": ["eb161faade83590917d5725e244b8537f6946001"], "node": "b330a738ee99bf6c66e2d5df9d9bd1ef49c7eeea", "parents": ["9836639e8070f7a5aa0db1d028ece64a7c794647"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2065704 - Block HUAWEI devices to use AFont API. r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324859\n", "files": ["gfx/thebes/gfxAndroidPlatform.cpp"], "git_node": "616fc3496f70afb99ee8e0a1caa2ff1cfd52427e", "git_parents": ["bdd5cf9106982b1f77289ecda1a2ec700d657250"], "node": "ccb2cbcdfcb36da2fd366fac6a6a760213a79580", "parents": ["b330a738ee99bf6c66e2d5df9d9bd1ef49c7eeea"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2059000 r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325743\n", "files": ["gfx/layers/AndroidImageReader.cpp", "gfx/layers/AndroidImageReader.h"], "git_node": "be1400a6c2e3d4a8f69d206bb66ecafb011891bc", "git_parents": ["616fc3496f70afb99ee8e0a1caa2ff1cfd52427e"], "node": "571e39add7753dc7fdb974a37a49ef2e31937ef3", "parents": ["ccb2cbcdfcb36da2fd366fac6a6a760213a79580"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "638e7c695938206ea95fed8984ea10bfa392488c", "git_parents": ["be1400a6c2e3d4a8f69d206bb66ecafb011891bc", "b03f31aff2279c01ae4729e76c7a69ebd4e9cee1"], "node": "f22d6ddc8f8c006f869ba06b51e735d2b111aafa", "parents": ["571e39add7753dc7fdb974a37a49ef2e31937ef3", "0d6c4739c7b6693b2164401f74f71ea46425906a"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2062112 - [Monitor Agent][FE] Create monitor component in tool bar panel r=ngrato,fluent-reviewers,desktop-theme-reviewers,sfoster,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321407\n", "files": ["browser/base/content/browser.js", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartwindowMonitor.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "5a2bdaf2b5a46434be0dc72ba78928e0fd92ccd8", "git_parents": ["638e7c695938206ea95fed8984ea10bfa392488c"], "node": "06cd33cdd4cbbb370889259cf261339b8d333cbe", "parents": ["f22d6ddc8f8c006f869ba06b51e735d2b111aafa"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059195 - Clear WebRenderScrollData referent ids that the sender doesn't actually embed. r=botond\" for causing mochitest failures @test_group_zoom-2.html.\n\nThis reverts commit f0927ac7fabc3059684d3cda4e327af8858a9384.\n\nRevert \"Bug 2059195 - Track each pipeline's embedder LayersId in CompositorBridgeParent::LayerTreeState. r=gfx-reviewers,aosmond\"\n\nThis reverts commit a53710780cc491a20f11c04911ba82e6ae44cebd.\n", "files": ["gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeChild.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.h", "gfx/layers/ipc/PCompositorBridge.ipdl", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderScrollData.cpp", "gfx/layers/wr/WebRenderScrollData.h", "layout/ipc/RemoteLayerTreeOwner.cpp"], "git_node": "3de5e7f93770e1db5a888a8de5d3b460109d8879", "git_parents": ["5a2bdaf2b5a46434be0dc72ba78928e0fd92ccd8"], "node": "8ea86528d61fb5006efc896995b1708d5dc3e3a2", "parents": ["06cd33cdd4cbbb370889259cf261339b8d333cbe"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062112 - [Monitor Agent][FE] Create monitor component in tool bar panel r=ngrato,fluent-reviewers,desktop-theme-reviewers,sfoster,bolsson\" for causing bc failures @MouseEvent.cpp.\n\nThis reverts commit 5a2bdaf2b5a46434be0dc72ba78928e0fd92ccd8.\n", "files": ["browser/base/content/browser.js", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartwindowMonitor.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "92b7c0614ff117a55e59efefa6dfa469de0d020b", "git_parents": ["3de5e7f93770e1db5a888a8de5d3b460109d8879"], "node": "cc921f4f5a36313df384285f85f7a6db4c629ef4", "parents": ["8ea86528d61fb5006efc896995b1708d5dc3e3a2"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071737 - Use a non-moving tap in pointerevent_touch_target_after_pointerdown_target_removed.tentative.html. r=masayuki\n\nA user agent may suppress touchmove while the touch point stays within a tap\ntolerance, and beyond that tolerance the gesture is no longer a tap, so one\ngesture cannot produce both a touchmove and a click.  Drop the movement and the\ntouchmove expectations; touchend at the removed target covers the same rule.\n\nAlso compare against expectedEvents in the \"removes but appends the target to\nsame position again\" case, where all three assertions passed events as both\narguments.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325756\n", "files": ["testing/web-platform/tests/pointerevents/compat/pointerevent_touch_target_after_pointerdown_target_removed.tentative.html"], "git_node": "d7973ff41988a12f498cde0a1e8fb21fa3b7c28f", "git_parents": ["92b7c0614ff117a55e59efefa6dfa469de0d020b"], "node": "fc349463c8491ba3f696f2849d8b044ce92fc572", "parents": ["cc921f4f5a36313df384285f85f7a6db4c629ef4"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056813 - Wait for \"pointerup\" before synthesizing the next tap in test_pointerevent_altitude_azimuth_angle.html. r=edgar\n\nAwaiting only \"pointerdown\" let the next tap start while the previous\n\"touchend\" was still in flight through APZ.  While the stale touch is still in\nTouchManager::sCaptureTouchList, ShouldConvertTouchToPointer() suppresses the\nnew session's \"pointerdown\", so the test waited for an event which never came.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324875\n", "files": ["dom/events/test/pointerevents/test_pointerevent_altitude_azimuth_angle.html"], "git_node": "8b01cbd53910c9afe432d125a4f27438ff735ad6", "git_parents": ["d7973ff41988a12f498cde0a1e8fb21fa3b7c28f"], "node": "bd6175e0019a944bab009d78ef34ca0a6738b95a", "parents": ["fc349463c8491ba3f696f2849d8b044ce92fc572"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053678 part 1 - Rename MIR needsBarrier_ flags to needsPreBarrier_. r=iain\n\nAlso renames `NewUnbarriered` to `NewNoPreBarrier`.\n\nThe `MStoreDynamicSlotFromOffset` constructor had an unused `barrier` argument.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325302\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/IonAnalysis.cpp", "js/src/jit/MIR.h", "js/src/jit/ScalarReplacement.cpp", "js/src/jit/WarpBuilder.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "7883828ae458ecba0d30ed913e70b0b3eb44af0c", "git_parents": ["8b01cbd53910c9afe432d125a4f27438ff735ad6"], "node": "9a91742da33b6748fd8c2da5b02686767e99bf76", "parents": ["bd6175e0019a944bab009d78ef34ca0a6738b95a"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053678 part 2 - Use a MIR pass for inserting post write barriers. r=iain\n\nWe implement the post barrier for store instructions as a separate MIR instruction.\nThe store and the barrier should execute as a single unit (no GC or unexpected\nbailout in between) but some optimization passes can move or insert instructions,\nand this makes it hard to reason about these barriers.\n\nWith this patch we insert the post barrier MIR instructions after all optimization\npasses. It avoids the code motion problem and simplifies the code in a number of\nplaces. It also gives us a single place to insert `MAssertCanElidePostWriteBarrier`\nin debug builds.\n\nThis only changes the JS post barriers. Wasm code could probably use the same\nmechanism in the future, but it also has some post barrier code that's more\ncomplicated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325303\n", "files": ["js/src/jit/Ion.cpp", "js/src/jit/IonAnalysis.cpp", "js/src/jit/IonAnalysis.h", "js/src/jit/MIR.h", "js/src/jit/ScalarReplacement.cpp", "js/src/jit/WarpBuilder.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "9842f02e9295488eb4a667e25fdf4284dec45432", "git_parents": ["7883828ae458ecba0d30ed913e70b0b3eb44af0c"], "node": "833110af3c3babd0b117242e73342e1cb06b8576", "parents": ["9a91742da33b6748fd8c2da5b02686767e99bf76"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053678 part 3 - Remove dead code for handling Ion post write barriers. r=iain\n\nEarlier passes no longer have to handle `MPostWriteBarrier` and `MPostWriteElementBarrier`\nbecause these instructions are now only created after the other MIR optimizations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325304\n", "files": ["js/src/jit/IonAnalysis.cpp", "js/src/jit/MIR.cpp", "js/src/jit/MIR.h", "js/src/jit/ScalarReplacement.cpp"], "git_node": "ecf18b29efb90c1e61ea27a40caec9daa30e4e43", "git_parents": ["9842f02e9295488eb4a667e25fdf4284dec45432"], "node": "d122051c51cd9183734d5df392c27741daad6ab6", "parents": ["833110af3c3babd0b117242e73342e1cb06b8576"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053678 part 4 - Use ValueNeedsPostBarrier in AddPostWriteBarriers. r=iain\n\nThis also adds a check for `MConstant` to `ValueNeedsPostBarrier`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325305\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/IonAnalysis.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MIR.h"], "git_node": "66ede4498be5ab829ecc8321ab29761168559d74", "git_parents": ["ecf18b29efb90c1e61ea27a40caec9daa30e4e43"], "node": "64d32faf494f4eb6be752fac55d7396517e90395", "parents": ["d122051c51cd9183734d5df392c27741daad6ab6"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070928 - Guard the HTML parser's LinkStyle lookup with the already-available tag atom, so only link and style elements perform the secondary element-name lookup and type checks. r=hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324963\n", "files": ["parser/html/nsHtml5TreeOperation.cpp"], "git_node": "ddb5a3c0706ba6337b79709667729fd382e40057", "git_parents": ["66ede4498be5ab829ecc8321ab29761168559d74"], "node": "97437f773170edcc1086492243e6dc6efea7a5b4", "parents": ["64d32faf494f4eb6be752fac55d7396517e90395"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018511 - Show media play icon when the tab has a sound coming from it. r=android-reviewers,007,android-l10n-reviewers,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312033\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupCardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupRowTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/t