com/D326237\n", "files": ["third_party/libwebrtc/api/video/i420_buffer.cc", "third_party/libwebrtc/api/video/i420_buffer.h", "third_party/libwebrtc/api/video/video_frame_buffer.cc"], "git_node": "ed79914e7ff18c34f2f2039e2264ec3360733a27", "git_parents": ["b3b675d0cfa10079e2568737ab1a2cd70ba4fdf5"], "node": "b19588c8c0fc39e71f452321310965ab187e1f9b", "parents": ["775b45f4083d575a085410ddb418befa261e5955"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996020 - Cleanup remaining usages of VideoFrameBuffer::CropAndScale that should check for nullptr. r=bwc\n\nNote that while RTCNativeI420Buffer.mm's cropAndScaleWith: uses\nCropAndScale, cropAndScaleWith: is only used in upstream unittests\nand objc_frame_buffer.mm which Mozilla doesn't build.  Since all of\nthe crashes we see in Bug 1996020 are Windows related, the point is\nprobably moot for objective-c.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326238\n", "files": ["third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder.cc", "third_party/libwebrtc/modules/video_coding/codecs/vp8/libvpx_vp8_encoder.cc", "third_party/libwebrtc/modules/video_coding/codecs/vp9/libvpx_vp9_encoder.cc"], "git_node": "550c7abc822ce53a0b98222b3e0213c8205638ed", "git_parents": ["ed79914e7ff18c34f2f2039e2264ec3360733a27"], "node": "7fc0f681f70e21f6f4ccbb4460141b1f226cc0b7", "parents": ["b19588c8c0fc39e71f452321310965ab187e1f9b"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2065236 - Remove EmbedderInnerWindowId field from BrowsingContext, r=dom-core-reviewers,smaug\n\nThis field has been redundant since WindowContext was introduced, and\ncan be removed.\n\nThis also improves the behaviour of GetEmbedderWindowGlobal to not\nreturn null when GetParentWindowContext wouldn't if the parent\nWindowContext is discarded due to navigation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320240\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/base/WindowContext.cpp", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "76b7efea67d7bc79940c71d049a59a33d92f5726", "git_parents": ["550c7abc822ce53a0b98222b3e0213c8205638ed"], "node": "5e0e923fa103a02736d4389eaeb557b7ddf7b2f6", "parents": ["7fc0f681f70e21f6f4ccbb4460141b1f226cc0b7"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068765 - Part 1: Parser for Declarative Web Push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323282\n", "files": ["Cargo.lock", "dom/push/moz.build", "dom/push/rust/Cargo.toml", "dom/push/rust/cbindgen.toml", "dom/push/rust/src/declarative_push.rs", "dom/push/rust/src/lib.rs", "modules/libpref/init/StaticPrefList.yaml", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "8361a910503b878c9bd943fc7bc0bca2c3f69b52", "git_parents": ["76b7efea67d7bc79940c71d049a59a33d92f5726"], "node": "d4994aa76b561d1ae98ef6c09805cc896b0d6f81", "parents": ["5e0e923fa103a02736d4389eaeb557b7ddf7b2f6"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068765 - Part 2: Create notification from Declarative Web Push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323283\n", "files": ["dom/push/Declarative.cpp", "dom/push/Declarative.h", "dom/push/PushNotifier.cpp", "dom/push/moz.build", "testing/web-platform/mozilla/meta/push-api/__dir__.ini", "testing/web-platform/mozilla/meta/push-api/declarative.https.any.js.ini", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/push-api/declarative.https.any.js"], "git_node": "8cf5940d270682c3689c287b6f3a84e568dcb5a6", "git_parents": ["8361a910503b878c9bd943fc7bc0bca2c3f69b52"], "node": "c44bcf352328867b6e64f7e93c71b62fa4b3102f", "parents": ["d4994aa76b561d1ae98ef6c09805cc896b0d6f81"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069123 - Improve tab relevance for Smart Form Fill. r=omarg,gcardieri\n\nThis patch adds a filter to remove \"low\" tab relevance and should help finding more\nrelevant tabs. If this problem persists, we'll have to do more prompt tuning.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325903\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillTelemetry.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_metadata.js"], "git_node": "cace58bc516ba65b4ea8176f20cf0081c797de95", "git_parents": ["8cf5940d270682c3689c287b6f3a84e568dcb5a6"], "node": "7eb154dbac81456ef61723d2743520d4c95451ba", "parents": ["c44bcf352328867b6e64f7e93c71b62fa4b3102f"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071972 - Fix vertical tab alignment and scrolling r=tabbrowser-reviewers,desktop-theme-reviewers,sidebar-reviewers,sfoster,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326254\n", "files": ["browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "b5607f2c4ff6845de151155c6c8fb425c512ff02", "git_parents": ["cace58bc516ba65b4ea8176f20cf0081c797de95"], "node": "f4bacda4084fba9661320c9d09f5ebf7572eb08a", "parents": ["7eb154dbac81456ef61723d2743520d4c95451ba"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055092 - prevent click from focusing on PiP controls so that it doesn't interfere with space play/pause shortcut. r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325542\n", "files": ["toolkit/components/pictureinpicture/content/player.js", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_controlButtonClickFocus.js", "toolkit/components/pictureinpicture/tests/browser_improved_controls.js", "toolkit/components/pictureinpicture/tests/head.js"], "git_node": "2fa97ad230714715f38196b807dc51a18ea49229", "git_parents": ["b5607f2c4ff6845de151155c6c8fb425c512ff02"], "node": "739d84312a782f9568f5662909fa1cb46695079b", "parents": ["f4bacda4084fba9661320c9d09f5ebf7572eb08a"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070102 - Update wallpaper selection for better screenreader accessibility. r=fluent-reviewers,Dre,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323962\n", "files": ["browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/_WallpaperCategories.scss", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "656e487068ace017c2b7d2af22d56b9618be8a3c", "git_parents": ["2fa97ad230714715f38196b807dc51a18ea49229"], "node": "8e9377f2ff25d9702470a020684a70397fab9389", "parents": ["739d84312a782f9568f5662909fa1cb46695079b"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981175 - Only intercept about home request on BrowserFragment r=android-reviewers,gl\n\n* Convert the block list of fragment IDs in AppRequestInterceptor to an allow list of fragment IDs\n* The allow list only needs browser fragment because other places where about:home can be, such as a bookmark, still navigate to browser fragment explicitly\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325978\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/AppRequestInterceptorTest.kt"], "git_node": "d6afc215394a0d225155c9140a0ab83e6b20e6dd", "git_parents": ["656e487068ace017c2b7d2af22d56b9618be8a3c"], "node": "8097fb17da9fb273a402ccf05e2075a6dc794c51", "parents": ["8e9377f2ff25d9702470a020684a70397fab9389"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045456: Emit overrecursed check for CloseIterCache r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326028\n", "files": ["js/src/jit-test/tests/ion/bug2045456.js", "js/src/jit/Lowering.cpp"], "git_node": "201e76df9e92382fc88c88382d9eca206c524ecd", "git_parents": ["d6afc215394a0d225155c9140a0ab83e6b20e6dd"], "node": "05bd2081a02fe432aad1ca0bbe72757f30338047", "parents": ["8097fb17da9fb273a402ccf05e2075a6dc794c51"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067211 - Render Organize Tabs button to the left of the Smart Window switcher r=yjamora,sfoster\n\nThe button is created at runtime through CustomizableUI.createWidget, so a profile with saved toolbar state never gets its default slot: CustomizableUI appends it to the end of its default area instead. With horizontal tabs that is the tab strip, right after the switcher. With vertical tabs it was the hidden tab strip until bug 2066894, and is the end of the nav-bar since.\n\nAdd a CustomizableUI state migration that swaps the two buttons when the Organize Tabs button sits immediately after the switcher, reserves the slot for profiles that have neither created nor placed the button anywhere, and pulls a button stranded in the hidden tab strip into the nav-bar under vertical tabs. The sidebar button is pinned to the end of the nav-bar while the sidebar is on the right, so an appended button can land just past it; that counts as appended too. Any other arrangement is treated as a customized layout and left alone. The horizontal and vertical-nav-bar snapshots get the same treatment so the button does not come back on the wrong side after a tab orientation switch.\n\nAlso drop the _introducedByPref on the widget definition; CustomizableUI only honours it for built-in widgets, so it never did anything here.\n\nensure `browser.smartwindow.autoTabGrouping.enabled` in SW\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321939\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_model.js", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/test/unit/test_organize_tabs_migration.js", "browser/components/customizableui/test/unit/xpcshell.toml"], "git_node": "3502f1479fbc64da7f0ea7e86ae6fb282b285719", "git_parents": ["201e76df9e92382fc88c88382d9eca206c524ecd"], "node": "ec9ca5659502e4da9c2f66c0d6ed5211a2a94587", "parents": ["05bd2081a02fe432aad1ca0bbe72757f30338047"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2057007 - [Monitor Agent][FE] When monitor agent fails in a run, there should be some warning sent to the user r=fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323000\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/monitor-error-copy.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/test_agent_monitor_item_page.html", "browser/components/aiwindow/ui/test/xpcshell/test_MonitorErrorCopy.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml", "browser/locales-preview/aiWindow.ftl"], "git_node": "eb23a30d3295147442ce207ca1982cc1de7e4953", "git_parents": ["3502f1479fbc64da7f0ea7e86ae6fb282b285719"], "node": "86a7b288d5e41652a6025e128eb48261c51f0df2", "parents": ["ec9ca5659502e4da9c2f66c0d6ed5211a2a94587"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2072280 - Add a new custom annotation for defining a critical test r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326226\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/customannotations/Critical.kt"], "git_node": "fed5c6fdd1c6ed3a6608504b443e4f44fd87278f", "git_parents": ["eb23a30d3295147442ce207ca1982cc1de7e4953"], "node": "af3193269341f02a62f0da523b44cf8e5923062c", "parents": ["86a7b288d5e41652a6025e128eb48261c51f0df2"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069364 p1 - Use toolkit.telemetry.server in the crashreporter client r=gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323814\n", "files": ["toolkit/components/crashes/CrashManager.in.sys.mjs", "toolkit/crashreporter/client/app/src/glean.rs", "toolkit/crashreporter/client/app/src/send_ping.rs"], "git_node": "6379ebef70e4f115cf994e12c7fef3db91e61c8a", "git_parents": ["fed5c6fdd1c6ed3a6608504b443e4f44fd87278f"], "node": "f5c99adc4c97754b52eb8beff23fafe438ad580a", "parents": ["af3193269341f02a62f0da523b44cf8e5923062c"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069364 p2 - Use telemetry server configuration for crash pings on Android r=gsvelto,android-reviewers,crashreporting-reviewers,schopin,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323815\n", "files": ["mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/NativeCrashTools.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/GleanCrashReporterService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Analytics.kt", "toolkit/crashreporter/android/export/lib.rs", "toolkit/crashreporter/android/lib.cpp"], "git_node": "e83ac7201c4e2980b13976aa94c62e6921a7fef0", "git_parents": ["6379ebef70e4f115cf994e12c7fef3db91e61c8a"], "node": "09841fa9a47426328965d7228a1ad1e13546e8b0", "parents": ["f5c99adc4c97754b52eb8beff23fafe438ad580a"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071420 - Remove progress from curl output in crashreporter client r=crashreporting-reviewers,schopin\n\nThere is a better option since 2019, but we'd probably be most\ninterested in the error message anyway, so this supports older `curl`\nversions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325513\n", "files": ["toolkit/crashreporter/client/app/src/net/http.rs", "toolkit/crashreporter/client/app/src/test.rs"], "git_node": "4c9987ba66d287d1ab07834fcc9b0dff41457833", "git_parents": ["e83ac7201c4e2980b13976aa94c62e6921a7fef0"], "node": "59aa93576ae3d9495e47f0f8a3ce9e52a05452e7", "parents": ["09841fa9a47426328965d7228a1ad1e13546e8b0"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069626 - Improve WM_DESTROY message handling in the windows UI r=crashreporting-reviewers,schopin\n\nAside from adding logic to only drop the attached data once (in the\nunlikely, though apparently possible, event of handling WM_DESTROY\nmultiple times), this also returns 0 indicating that the message was\nhandled (rather than forwarding to `DefWindowProcW`).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324832\n", "files": ["toolkit/crashreporter/client/app/src/ui/windows/window.rs"], "git_node": "8fde8d2ff7be06d29151303edf41d990c075754d", "git_parents": ["4c9987ba66d287d1ab07834fcc9b0dff41457833"], "node": "1aab98088f7d10e0de325e3f60cd11718cc39c4d", "parents": ["59aa93576ae3d9495e47f0f8a3ce9e52a05452e7"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2070909 - Name an active descendant on the DevTools trees that manage focus, r=devtools-reviewers,ochameau,nchevobbe.\n\nTree.js and VirtualizedTree.js emitted aria-activedescendant only once an item\nhad been focused, so until then the tree was a tab stop with no current item.\nName the first rendered node, but only where the container passes onFocus:\nwithout one nothing ever becomes focused, so claiming the pattern would hide a\nkeyboard defect rather than fix one. The attribute exempts these trees'\nnegative-tabindex rows from the keyboard-focusability check, which is what the\nannotations removed here absorbed; they cite Bug 1849028 and Bug 1858041.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325020\n", "files": ["devtools/client/debugger/src/components/PrimaryPanes/ProjectSearch.js", "devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/debugger/test/mochitest/browser_gp.toml", "devtools/client/debugger/test/mochitest/browser_qz.toml", "devtools/client/debugger/test/mochitest/integration/browser.toml", "devtools/client/debugger/test/mochitest/sourcemaps/browser.toml", "devtools/client/debugger/test/mochitest/tracer/browser.toml", "devtools/client/inspector/extensions/test/browser.toml", "devtools/client/memory/test/browser/browser.toml", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/shared/components/Tree.js", "devtools/client/shared/components/VirtualizedTree.js", "devtools/client/shared/components/test/node/components/tree.test.js", "devtools/client/webconsole/test/browser/_jsterm.toml", "devtools/client/webconsole/test/browser/_webconsole_ak.toml", "devtools/client/webconsole/test/browser/_webconsole_lz.toml", "devtools/client/webconsole/test/browser/_webconsole_object_inspector.toml"], "git_node": "c1895a114ea561958815f0cf5b0c560789c9d43d", "git_parents": ["8fde8d2ff7be06d29151303edf41d990c075754d"], "node": "b460b39b2a3448114a4a8c9f96b0db0bf57152f6", "parents": ["1aab98088f7d10e0de325e3f60cd11718cc39c4d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2070914 - Let a focusable ARIA separator satisfy the mochitest accessibility checks, r=Jamie,devtools-reviewers,nchevobbe.\n\nARIAMap.cpp gives separator and scrollbar eNoAction, so the action count rule\ncan never pass for them, and findInteractiveAccessible walks past them because\nit consults INTERACTIVE_ROLES only. Bug 1860733 makes the DevTools SplitBox\nsplitter a focusable separator, so adjust both the action count rule and\nfindInteractiveAccessible to handle this case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325025\n", "files": ["devtools/client/framework/test/browser.toml", "testing/mochitest/tests/SimpleTest/AccessibilityUtils.js"], "git_node": "9fbac5a6e20eaa70f0c258f649853b8898650d0b", "git_parents": ["c1895a114ea561958815f0cf5b0c560789c9d43d"], "node": "d7bc071addea4c2125b9516d1654195b748c8c15", "parents": ["b460b39b2a3448114a4a8c9f96b0db0bf57152f6"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071232 - Give the editor's column breakpoint markers an accessible name, r=devtools-reviewers,bomsy.\n\nThe marker is a button holding only an SVG, so it had no accessible name at\nall. A line can hold several and they are identical but for their position, so\nthe name gives the line and column. aria-pressed carries the state the\nactive class shows visually.\n\nThe a11y_checks annotations this retires were filed as Bug 1849028.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325413\n", "files": ["devtools/client/debugger/src/components/Editor/ColumnBreakpoints.js", "devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/locales/en-US/debugger.properties"], "git_node": "6acfcf358b3e2f9bd70787f8e25db1102e875708", "git_parents": ["9fbac5a6e20eaa70f0c258f649853b8898650d0b"], "node": "2696cb53eee90024e22ab4c20550f6be02f7fdf4", "parents": ["d7bc071addea4c2125b9516d1654195b748c8c15"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072308 - Newtab move grouped pin to beta r=ini\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326239\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs"], "git_node": "7fbf2c782e7eac74bb61dd089721a3955ac1d7b3", "git_parents": ["6acfcf358b3e2f9bd70787f8e25db1102e875708"], "node": "b824c9a829990f2190b9abdb8764538e38aa1648", "parents": ["2696cb53eee90024e22ab4c20550f6be02f7fdf4"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061043 - Add AI Tab menu triggers to the tab, tab group and page context menus r=tabbrowser-reviewers,fluent-reviewers,omarg,bolsson,nsharpley\n\nThis patch is technically landable as-is, but depends on https://bugzilla.mozilla.org/show_bug.cgi?id=2066287 and https://bugzilla.mozilla.org/show_bug.cgi?id=2065560 for proper functionality\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321710\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/webext-panels.xhtml", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_menu_triggers.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/content/tabgroup-menu.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "e3e8d0e9f5073c5c0bdb5bac09231c41451c30cb", "git_parents": ["7fbf2c782e7eac74bb61dd089721a3955ac1d7b3"], "node": "df2afae5c5c9db08f082990a145601851096eefb", "parents": ["b824c9a829990f2190b9abdb8764538e38aa1648"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064527 - Add error states to Smart Window Monitor create card r=ngrato,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324430\n", "files": ["browser/components/aiwindow/ui/assets/error-outline.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "7e363058878bab4d1d716fd6bb6284912b7329c0", "git_parents": ["e3e8d0e9f5073c5c0bdb5bac09231c41451c30cb"], "node": "98feaccc6885606d0ddb0a45abcd679856863da6", "parents": ["df2afae5c5c9db08f082990a145601851096eefb"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068422 - Fix fullscreen subdocument handling; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325085\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h"], "git_node": "c7fe9b54756868401d93ee2338087eb5ae7b3dda", "git_parents": ["7e363058878bab4d1d716fd6bb6284912b7329c0"], "node": "966a27e0d3065ca2bfe28d8ae5822f900c203b39", "parents": ["98feaccc6885606d0ddb0a45abcd679856863da6"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072057 - Pt 1 - Drop the unread clip polygon handle and the unreachable IsVisible impls r=gfx-reviewers,nical\n\nClipItemKind::Image copies the polygon handle from the key, but nothing at\nframe time reads it; the hit tester reads the key. Picture, BackdropCapture\nand BackdropRender only go through create_primitive, which has no IsVisible\nbound, so their impls have no caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326051\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/backdrop.rs", "gfx/wr/webrender/src/prim_store/picture.rs"], "git_node": "cb30cbb4603d4e191ec9b60fb10900e19487e2fb", "git_parents": ["c7fe9b54756868401d93ee2338087eb5ae7b3dda"], "node": "2e6133acb638241a2e110fcf61b2cb21b16afd9b", "parents": ["966a27e0d3065ca2bfe28d8ae5822f900c203b39"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072057 - Pt 2 - Move the remaining PrimKey aliases into webrender_api r=gfx-reviewers,nical\n\nDeclare the box shadow, border, image, yuv image, rectangle and line\ndecoration keys next to their values, as the gradient keys already are, and\nre-export them from the old modules. The image key becomes ImagePrimKey to\nstay clear of the resource ImageKey it contains. PrimKeyCommonData derives\nCopy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326052\n", "files": ["gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/prim_store/line_dec.rs", "gfx/wr/webrender/src/prim_store/rectangle.rs", "gfx/wr/webrender_api/src/interned_prims.rs", "gfx/wr/webrender_api/src/key_types.rs"], "git_node": "e6c9f8f2cf08fc6b422c3ab4c4284dd21d8261c6", "git_parents": ["cb30cbb4603d4e191ec9b60fb10900e19487e2fb"], "node": "7efe5a7746be8866ea27cb46d20041155e2b0ca3", "parents": ["2e6133acb638241a2e110fcf61b2cb21b16afd9b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072057 - Pt 3 - Move the image stretch-size derivation into webrender_api r=gfx-reviewers,nical\n\nprocess_image_stretch_size becomes prim_geometry::image_stretch_size and\nStretchSizeKey gains resolve() for the per-axis expansion add_image did\ninline. The image_tiling re-export of simplify_repeated_primitive had one\nuser, the scene builder, which now imports it from the api.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326053\n", "files": ["gfx/wr/webrender/src/image_tiling.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/key_types.rs", "gfx/wr/webrender_api/src/prim_geometry.rs"], "git_node": "504eb7b9089fb69f7e909fd915df86b529e3e608", "git_parents": ["e6c9f8f2cf08fc6b422c3ab4c4284dd21d8261c6"], "node": "6e6ef55b07035afda511b109d774132b029255ae", "parents": ["7efe5a7746be8866ea27cb46d20041155e2b0ca3"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072057 - Pt 4 - Give YuvData a planes() accessor r=gfx-reviewers,nical\n\nThe padded three-plane array the scene builder derived is a property of the\nYuvData itself. Validation and add_yuv_image keep using the same list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326054\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs"], "git_node": "7fa52a010c5d1c5c8b7644aa46ceb30e8b085f86", "git_parents": ["504eb7b9089fb69f7e909fd915df86b529e3e608"], "node": "d39bb407bfe4563c9dea56702d71897bf64c0e7c", "parents": ["6e6ef55b07035afda511b109d774132b029255ae"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072057 - Pt 5 - Drop invisible text, rectangles and lines at record time r=gfx-reviewers,nical\n\nApply the scene builder's IsVisible predicate in the display list builder,\non the same quantized colour, so a fully transparent item is never recorded.\nInside a shadow scope the original is still captured so it can cast its\nshadow, and dropped again on re-emission. A CHECKERBOARD_BACKGROUND rectangle\nis always recorded, since the scene builder marks a tile cache barrier off\nthe flag whatever the colour.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326055\n", "files": ["gfx/wr/webrender_api/src/display_list.rs"], "git_node": "a1d24e139bf3a6bfba47bad5d3cbc8b393b5c7fa", "git_parents": ["7fa52a010c5d1c5c8b7644aa46ceb30e8b085f86"], "node": "b8bb2efd2247f041f2d6ff5c5c0eb3d9e79eb373", "parents": ["d39bb407bfe4563c9dea56702d71897bf64c0e7c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072057 - Pt 6 - Add pipeline removal and a fresh-builder option to wrench's invalidation tests r=gfx-reviewers,nical\n\nremove-pipelines sends the removals as their own transaction before the\nframe's display lists, as Gecko does, and three steps retire the previous\niframe pipeline in turn. new-builder drops the retained display list\nbuilders between the two files, modelling a replaced content process;\nidentical content from a fresh builder must not invalidate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326056\n", "files": ["gfx/wr/wrench/invalidation/invalidation.list", "gfx/wr/wrench/invalidation/recycle_pipeline_1.yaml", "gfx/wr/wrench/invalidation/recycle_pipeline_2.yaml", "gfx/wr/wrench/invalidation/recycle_pipeline_3.yaml", "gfx/wr/wrench/src/test_invalidation.rs", "gfx/wr/wrench/src/wrench.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "066c7f80653c4d77da8cb49884f352d1d36a4c38", "git_parents": ["a1d24e139bf3a6bfba47bad5d3cbc8b393b5c7fa"], "node": "908e567b17889fce9490784b5e743ebb5574fd32", "parents": ["b8bb2efd2247f041f2d6ff5c5c0eb3d9e79eb373"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2047745 - [wdspec] Cleanup wpt meta data for Linux non-Wayland jobs. r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326204\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browser/get_client_windows/get_client_windows.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/remove_user_context/user_context.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/context_destroyed/context_destroyed.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/download_end/download_end.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/download_will_begin/download_will_begin.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/download_will_begin/user_context_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/fragment_navigated/user_context_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/get_tree/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/navigate/wait.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/navigation_committed/navigation_committed.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/navigation_started/navigation_started.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_timezone_override/timezone.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/fetch_error/fetch_error.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/session/capabilities/unhandled_prompt_behavior/file/dismiss.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/session/capabilities/unhandled_prompt_behavior/file/ignore.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/storage/delete_cookies/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/add_cookie/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/back/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/delete_session/delete.py.ini", "testing/web-platform/meta/webdriver/tests/classic/execute_async_script/arguments.py.ini", "testing/web-platform/meta/webdriver/tests/classic/execute_script/window.py.ini", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/remove_virtual_authenticator/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/find_element_from_shadow_root/find.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_page_source/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_alwaysMatch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/unhandled_prompt_behavior.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_modifiers.py.ini", "testing/web-platform/meta/webdriver/tests/classic/release_actions/release.py.ini", "testing/web-platform/meta/webdriver/tests/classic/switch_to_frame/switch.py.ini"], "git_node": "da2e2ddb3f8e7c4d508828c089cf54bc788d7309", "git_parents": ["066c7f80653c4d77da8cb49884f352d1d36a4c38"], "node": "69ac15f8e1de5488303940b0303b767ec9fa859d", "parents": ["908e567b17889fce9490784b5e743ebb5574fd32"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2067202 - test offline sw bug r=dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323658\n", "files": ["dom/serviceworkers/test/mochitest-common.toml", "dom/serviceworkers/test/offline_worker_fetch/