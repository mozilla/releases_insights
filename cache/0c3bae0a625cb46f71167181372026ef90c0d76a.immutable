4ce7a72cba0965ad", "git_parents": ["8aaae78ffa0a9120248b13e808f6836f389793b2"], "node": "891accafd8fa7d676bf8aa4225d205962da99b68", "parents": ["703d913407e16bcccc6345ccf2a9bf8d1088390f"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2065088 - [geckodriver] Merge default Android intent arguments with client-supplied ones. r=geckodriver-reviewers,jgraham\n\nWhen \"androidIntentArguments\" was set via the capabilities, geckodriver\nonly used the client's values and skipped the default arguments\nrequired to launch a GeckoView based application into a blank Gecko\nwindow (\"-a android.intent.action.VIEW\", \"-d about:blank\", and for\nthe Fenix-family \"--ez automationtest true\" from bug 2064609).\n\nThe defaults are now merged in front of the client arguments, and each\ndefault is only added when the client did not already provide the\ncorresponding flag, so explicit client values are never overridden.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322851\n", "files": ["testing/geckodriver/src/capabilities.rs"], "git_node": "dbf0bb65cd73dff2c9ced6853a4f69a5ff900255", "git_parents": ["03eba19644024c9d51557eac4ce7a72cba0965ad"], "node": "888741e0409707c82bfeb6094830923a17db45d1", "parents": ["891accafd8fa7d676bf8aa4225d205962da99b68"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070969 - Fix inactive perf and Nova overrides for nativeTheme r=emilio,desktop-theme-reviewers\n\nRegressions from bug 2069497\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325048\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/browser-shared.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/components/sidebar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "75c73b2256a97cc854f1aaa27291b139a240a1d3", "git_parents": ["dbf0bb65cd73dff2c9ced6853a4f69a5ff900255"], "node": "e14ec38a0d524453ad9f3a646ebdd03e8d87e438", "parents": ["888741e0409707c82bfeb6094830923a17db45d1"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2068448 - Call MaybeBecomeUntrusted in RedirectToRealChannel, r=mccr8,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324426\n", "files": ["netwerk/ipc/DocumentChannelChild.cpp"], "git_node": "310011c82195020f9ead76fa485fb7e5dd94b0d6", "git_parents": ["75c73b2256a97cc854f1aaa27291b139a240a1d3"], "node": "6560ef2dc42eb06ac0d2997cf231c004efe493d2", "parents": ["e14ec38a0d524453ad9f3a646ebdd03e8d87e438"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069735. r=webgpu-reviewers,aleiserson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324991\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "74d2c26c85d6598ef7139932245ea0e37ef89ef1", "git_parents": ["310011c82195020f9ead76fa485fb7e5dd94b0d6"], "node": "933a88aba156ec5655ac755fab395efa260de52b", "parents": ["6560ef2dc42eb06ac0d2997cf231c004efe493d2"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058886 - Fix screen reader announcement and labeling in theme picker r=fluent-reviewers,extension-reviewers,hjones,bolsson,rpl\n\nThe light/dark/device group in the theme picker had no accessible name for screen readers, and its buttons had their role and selected state on a wrapper element instead of the button that gets focused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323767\n", "files": ["toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/tests/widgets/test_segmented_control.html", "toolkit/content/widgets/moz-button/moz-button.mjs", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.mjs", "toolkit/content/widgets/theme-picker/theme-picker.mjs", "toolkit/locales/en-US/toolkit/about/aboutAddons.ftl", "toolkit/locales/en-US/toolkit/global/theme-picker.ftl", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-mode.mjs"], "git_node": "48a78de4738ff6e974b40807e209ff53800d1acf", "git_parents": ["74d2c26c85d6598ef7139932245ea0e37ef89ef1"], "node": "65b47b9e7b1279c164136c8974e835a215e302cf", "parents": ["933a88aba156ec5655ac755fab395efa260de52b"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064563 - Add explicit test assertion to ensure the expected fluent id is set on the aboutaddons-themes-mode moz-segmented-control element. r=fluent-reviewers,bolsson,mkennedy\n\nThis patch is adding only an additional test assertion to verify that\nthe aboutaddons-themes-mode moz-segmented-control does have the expected\nfluent id (which is something that the parent patch, D323767, is taking care of).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323037\n", "files": ["toolkit/mozapps/extensions/test/browser/browser_html_themes_mode.js"], "git_node": "c74e9c907ad6493f45544a946e26ed0622fb3145", "git_parents": ["48a78de4738ff6e974b40807e209ff53800d1acf"], "node": "d6fc6ad71b837c539feb949cb494270d059e44ff", "parents": ["65b47b9e7b1279c164136c8974e835a215e302cf"], "tags": []}, {"author": "Jocelyne \u003cjocelyne.ah1@gmail.com\u003e", "branch": "default", "desc": "Bug 1722091 - Remove dead sys.version_info checks for Python \u003c 3.9 r=sylvestre,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311684\n", "files": ["config/tests/unit-nsinstall.py", "python/mach/mach/test/test_config.py", "security/manager/tools/crtshToIdentifyingStruct/crtshToIdentifyingStruct.py", "testing/condprofile/condprof/check_install.py", "testing/mozbase/mozfile/mozfile/mozfile.py", "testing/mozbase/mozprocess/mozprocess/processhandler.py", "testing/mozbase/mozprofile/tests/test_profile_view.py", "testing/mozbase/mozserve/mozserve/servers.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/mozharness/scripts/awsy_script.py", "testing/webcompat/mach_commands.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "f32737c6656f7c30cc8e7ae14b112d7cec55e398", "git_parents": ["c74e9c907ad6493f45544a946e26ed0622fb3145"], "node": "f4ebede8c0ae52b3707a5b854653b93196fc0364", "parents": ["d6fc6ad71b837c539feb949cb494270d059e44ff"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037111 - Rename tab tokens for naming consistency r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,tgiles,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321985\n", "files": ["browser/components/sidebar/sidebar-main.css", "browser/themes/ThemeVariableMap.sys.mjs", "browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/figma-import.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/config.mjs"], "git_node": "4129f25d1208b355ccac291f362b5ea98ced738f", "git_parents": ["f32737c6656f7c30cc8e7ae14b112d7cec55e398"], "node": "b5867d818d6c14c571327d91d0febd935f8e92fc", "parents": ["f4ebede8c0ae52b3707a5b854653b93196fc0364"], "tags": []}, {"author": "Danny Chen \u003cDanny@Dannys-MacBook-Air.local\u003e", "branch": "default", "desc": "Bug 1967034 - Implement aria-grabbed support for macOS accessibility. r=morgan\n\nImplemented aria-grabbed to AXGrabbed mapping in accordance with existing implementations (e.g. AxExpanded, AXVisited).\nGetter reads the aria-grabbed DOM attribute as a string and compares it against \"true\"; any other value is \"false\", or the attribute being absent falls through to NO (0), so removing the attribute degrades safely instead of returning an unhandled value.\n\nAdded a browser test that queries the native accessibility interface for AXGrabbed and checks it returns YES (1) when aria-grabbed=\"true\" is set, correctly flips to NO (0) after the attribute is mutated to \"false\", and stays NO (0) after the attribute is removed outright.\n\nManually tested with both Firefox's Accessibility Inspector and Xcode's Accessibility Inspector, AXGrabbed doesn't surface in either tool's UI even with the mapping in place, consistent with reporter's note that VO doesn't appear to expose this attribute in Safari either. Non-appearance looks like an inspector display limitation rather than a bug in this patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322694\n", "files": ["accessible/mac/MOXAccessibleProtocol.h", "accessible/mac/mozAccessible.h", "accessible/mac/mozAccessible.mm", "accessible/tests/browser/mac/browser.toml", "accessible/tests/browser/mac/browser_aria_grabbed.js"], "git_node": "c43f0b0acec793f1b75dc511f21d507f7a0fd020", "git_parents": ["4129f25d1208b355ccac291f362b5ea98ced738f"], "node": "832cbc8add3542f442885b973ca5057a5cb1cfd2", "parents": ["b5867d818d6c14c571327d91d0febd935f8e92fc"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069065 - Part 1: Move notification showing out of NotificationParent. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323361\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h"], "git_node": "9273ce93b44d2cb360364cb4e0582b47ba16359f", "git_parents": ["c43f0b0acec793f1b75dc511f21d507f7a0fd020"], "node": "08b7f91fb15762e206e3d67c7faaf416a17c5d3e", "parents": ["832cbc8add3542f442885b973ca5057a5cb1cfd2"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069065 - Part 2: Move permission and Safe Browsing checks to NotificationUtils.cpp. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323362\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h"], "git_node": "7878df76762bf41733dcd528751b01eb553d4910", "git_parents": ["9273ce93b44d2cb360364cb4e0582b47ba16359f"], "node": "817ca967a0240c76930d2946713095f2efe9eab6", "parents": ["08b7f91fb15762e206e3d67c7faaf416a17c5d3e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010541 - Stop exporting undefined disassembler symbols from clang 14's libLTO and libRemarks. r=firefox-build-system-reviewers,sergesanspaille\n\nBackport llvm-project c294bdd64768 and bf07de38b05e.\n\nLTODisassembler.cpp only forces the target disassembler registries into\nthe link; the LLVMCreateDisasm* entry points themselves live in\nLLVMMCDisassembler. With LLVM_LINK_LLVM_DYLIB, which we enable\neverywhere but Windows, they end up in libLLVM-14.so, so lto.exports\nnames six symbols libLTO.so.14 does not define. lld defaults to\n--no-undefined-version since llvm D135402 and rejects that.\n\nlibRemarks.so has the same problem, more so: Remarks.exports lists 25\nsymbols and libremarks.cpp defines exactly one.\n\nBoth upstream fixes landed for LLVM 16, so clang 19 and later already\nhave them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320155\n", "files": ["build/build-clang/clang-14.json", "build/build-clang/llvmorg-17-init-946-gc294bdd64768_clang_14.patch", "build/build-clang/llvmorg-17-init-947-gbf07de38b05e_clang_14.patch"], "git_node": "4300da9b2aa70d1e45185d982653ebbd4c5a9ff7", "git_parents": ["7878df76762bf41733dcd528751b01eb553d4910"], "node": "49031b2b3d80a4a668f566d586bb8702cfd99518", "parents": ["817ca967a0240c76930d2946713095f2efe9eab6"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010574 - Install libzstd-dev in the toolchain-build image, and don't autodetect zstd when building against a sysroot. r=firefox-build-system-reviewers,sergesanspaille\n\nlibcrypto in Debian 13 pulls in libzstd, so xar fails to link without\nlibzstd-dev in the image.\n\nInstalling it in turn makes LLVM and binutils pick up the system zstd,\nwhich isn't in the sysroots they link against, so turn it off explicitly.\nThis covers both build-clang.py and build-llvm-common.sh; the latter\nconfigures llvm proper for llvm-symbolizer. build-cctools-port.sh already\npasses -DLLVM_ENABLE_ZSTD=OFF for the same reason.\n\nLLVM_ENABLE_ZSTD=ON really means autodetect, so this only pins behaviour\nwe already had: no image shipped libzstd-dev until now.\n\nEventually we should either build xar against the sysroot or link\nstatically, but this is the smaller fix for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320156\n", "files": ["build/build-clang/build-clang.py", "build/unix/build-binutils/build-binutils.sh", "taskcluster/docker/toolchain-build/Dockerfile", "taskcluster/scripts/misc/build-llvm-common.sh"], "git_node": "53e0ccfdc36a2fc05efd7e0dd990e64a0ff465e0", "git_parents": ["4300da9b2aa70d1e45185d982653ebbd4c5a9ff7"], "node": "a295037c16598e31234afdfe6b42cb4773a37ee9", "parents": ["49031b2b3d80a4a668f566d586bb8702cfd99518"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010555 - Disable gcc's c++tools when building against a sysroot. r=firefox-build-system-reviewers,sylvestre\n\nlibcody is a bootstrapped host module, and POSTSTAGE1_CXX_EXPORT does not\npass the build sysroot's flags, so it is compiled against the image's\nheaders. c++tools is not bootstrapped and is built in the post-bootstrap\npass, where TARGET_FLAGS_TO_PASS sets CXX to the target compiler with\n--sysroot, so g++-mapper-server links against the sysroot's libc.\n\nWith glibc \u003e= 2.38 the image's stdlib.h redirects strtoul to\n__isoc23_strtoul, which the jessie sysroot's glibc 2.19 doesn't provide,\nand linking g++-mapper-server fails.\n\nNothing uses the standalone C++ module mapper server: gcc defaults to the\nin-process mapper. libcody itself is still built and linked into cc1plus,\nwhich is consistent since that link also happens without the sysroot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320157\n", "files": ["build/unix/build-gcc/build-gcc.sh"], "git_node": "639dd71a78ddae03d27d5d2e925cd9eb6f05fdb6", "git_parents": ["53e0ccfdc36a2fc05efd7e0dd990e64a0ff465e0"], "node": "4fe16d1d3f23fe33a06a7cfa41e11dbb81a937db", "parents": ["a295037c16598e31234afdfe6b42cb4773a37ee9"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010489 - Switch toolchain tasks to Debian 13-based docker image. r=taskgraph-reviewers,ahal\n\nAdd gpgv to the toolchain-build image, required by build-sysroot.sh via\nthe gpgvnoexpkeysig script.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279110\n", "files": ["build/build-clang/use-system-clang.json", "taskcluster/docker/toolchain-build/Dockerfile", "taskcluster/gecko_taskgraph/transforms/job/toolchain.py"], "git_node": "2b29af197fcb05f14b92efcad61fbdf3e81ace03", "git_parents": ["639dd71a78ddae03d27d5d2e925cd9eb6f05fdb6"], "node": "8d5279b529885c80920c96987155bdd73e50f4ca", "parents": ["4fe16d1d3f23fe33a06a7cfa41e11dbb81a937db"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070120 - Build upx against the sysroot. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nupx was built with the docker image's headers and libraries, so the\nshipped binary's glibc floor followed the image: moving to Debian 13\ntook it from GLIBC_2.14 to GLIBC_2.38, which excludes Ubuntu 22.04,\nDebian 12 and Rocky 9. It is a local-toolchain, so mach bootstrap hands\nit to developers on arbitrary distributions.\n\nupx links nothing externally -- UCL and zlib are vendored and built\nstatic, and bzip2, zstd and threads are disabled in its CMakeLists --\nso pointing cmake at the sysroot is enough. Follows the same pattern as\nbuild-dmg-hfsplus.sh.\n\nwin64-upx shares the script and is unaffected: the new flags are in the\nnon-Msys branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324245\n", "files": ["taskcluster/kinds/toolchain/upx.yml", "taskcluster/scripts/misc/build-upx.sh"], "git_node": "806f31014c5dd864d58e207a1ab3244b66bf0f4f", "git_parents": ["2b29af197fcb05f14b92efcad61fbdf3e81ace03"], "node": "ef8d1477898ee6264e56273236ca7f4db02e7ceb", "parents": ["8d5279b529885c80920c96987155bdd73e50f4ca"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070120 - Build mkbom against the sysroot. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nmkbom was built with the docker image's compiler, so the shipped\nbinary's glibc floor followed the image: moving to Debian 13 took it\nfrom GLIBC_2.34 to GLIBC_2.38. It is a local-toolchain, so mach\nbootstrap hands it to developers on arbitrary distributions.\n\nbomutils assigns CXXFLAGS and LDFLAGS with = rather than ?= in its\nMakefile, so overriding them on the make command line would drop its\nown hardening flags. The sysroot flags go into CXX instead.\n\nThe task already fetched clang and the sysroot; it just wasn't using\nthem. Measured locally: GLIBC_2.38 -\u003e GLIBC_2.14.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324246\n", "files": ["taskcluster/scripts/misc/build-mkbom-linux.sh"], "git_node": "64ff9411a29ebc90b9047cb44d558cadd2dd028c", "git_parents": ["806f31014c5dd864d58e207a1ab3244b66bf0f4f"], "node": "0247d847e764b7e18d353ee1480d1177df30f8cb", "parents": ["ef8d1477898ee6264e56273236ca7f4db02e7ceb"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070120 - Build winchecksec against the sysroot. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nwinchecksec was built with the docker image's headers and libraries, so\nthe shipped binary's glibc floor followed the image: moving to Debian 13\ntook it from GLIBC_2.14 to GLIBC_2.34. It is a local-toolchain, so mach\nbootstrap hands it to developers on arbitrary distributions.\n\nThe task fetched neither clang nor a sysroot, and build-winchecksec.sh\nhad no case for x86_64-unknown-linux-gnu, so the linux build fell\nthrough with no cmake flags at all. Add the fetches and a linux case\nmirroring build-msix-packaging.sh.\n\nwin64-winchecksec shares the script and is unaffected. Measured locally:\nGLIBC_2.34 -\u003e GLIBC_2.14, and pe-parse's -Werror block still compiles\nclean under clang with the sysroot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324247\n", "files": ["taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/build-winchecksec.sh"], "git_node": "dd45a84324c8e06605c4998c9c94306023e3cca7", "git_parents": ["64ff9411a29ebc90b9047cb44d558cadd2dd028c"], "node": "f864c8fa9ebe503ee4eebae1963922dd514f0db9", "parents": ["0247d847e764b7e18d353ee1480d1177df30f8cb"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070120 - Build gn against the sysroot. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\ngn was built with the docker image's gcc, so the shipped binary's glibc\nfloor followed the image: moving to Debian 13 took it from GLIBC_2.18 to\nGLIBC_2.38. That broke source-test-vendor-verify-gfx, which runs gn to\nre-vendor gfx/angle on the static-analysis-build image; bug 2065412\nworked around it by moving that image to Debian 13, but the binary is\nalso a local-toolchain handed to developers on arbitrary distributions.\n\nThe symbols pulling in GLIBC_2.38 are the __isoc23_str* redirects glibc\napplies to strtol and friends for __cplusplus \u003e= 202302L, and gn is\nbuilt as C++23. Building against older headers removes the redirect\nrather than papering over it.\n\ngn needs linux64-toolchain-sysroot-gcc10 rather than\nlinux64-toolchain-sysroot: it uses \u003cconcepts\u003e and \u003cranges\u003e, which the\nlibstdc++ 8 in the latter does not have. cctools-port and node-22\nalready use the gcc10 sysroot for the same reason.\n\nbuild/gen.py bakes CXX, CFLAGS+CXXFLAGS and LDFLAGS into build.ninja at\ngeneration time and has no cxx-vs-cc distinction, so the environment\nvariables have to be set before it runs. The mac and win64 gn builds set\ntheir own and are unaffected; build-gn-common.sh is untouched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324248\n", "files": ["taskcluster/kinds/toolchain/gn.yml", "taskcluster/scripts/misc/build-gn-linux.sh"], "git_node": "96ec88b22c5ed403f286bf8d71b3793a9a0be079", "git_parents": ["dd45a84324c8e06605c4998c9c94306023e3cca7"], "node": "86b6471c58199788e2630e39b955cc0021dca825", "parents": ["f864c8fa9ebe503ee4eebae1963922dd514f0db9"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070120 - Build xar against the sysroot. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nxar was built with the docker image's headers and libraries even though\nits task already fetched clang and a sysroot. Moving to Debian 13 took\nthe shipped binary from GLIBC_2.34 to GLIBC_2.38 and added a\nlibzstd.so.1 dependency, by way of deb13's openssl pulling zstd into\npkg-config --static --libs libcrypto. It is a local-toolchain, so mach\nbootstrap hands it to developers on arbitrary distributions.\n\nxar's configure can only locate libxml2 through xml2-config, which\nsysroots do not ship because they contain no /usr/bin. Left alone it\ncombines the host's libxml2 headers with the sysroot's library, so pass\na small shim backed by pkg-config.\n\nThe sysroot's openssl is 1.0.1t, which does not pull in zstd, so\nlibzstd-dev is no longer needed in the image; bug 2010574 only added it\nfor xar. Dropping it also stops gcc autodetecting zstd, which was\nsilently adding a libzstd.so.1 dependency to the gcc toolchains. The\nexplicit -DLLVM_ENABLE_ZSTD=OFF and --without-zstd stay: they pin\nautodetection that would otherwise vary with the image's contents.\n\nOther consequences worth knowing:\n - the statically linked libcrypto becomes the sysroot's openssl 1.0.1t.\n   xar only uses the EVP digest functions, no TLS or certificate code.\n - that libcrypto.a is not built PIC, so the binary can no longer be a\n   PIE.\n - the sysroot has lzma.h where the image did not, so xar gains lzma\n   support and a liblzma.so.5 dependency.\n\nMeasured locally: GLIBC_2.38 -\u003e GLIBC_2.14, configure resolves libxml\n2.9.1 with no host/sysroot split, and create/extract roundtrips pass for\nsha1, sha256 and md5 with gzip, bzip2 and no compression.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324249\n", "files": ["taskcluster/docker/toolchain-build/Dockerfile", "taskcluster/scripts/misc/build-xar-linux.sh"], "git_node": "79403252a5841c28ea10d316373858bf9645586d", "git_parents": ["96ec88b22c5ed403f286bf8d71b3793a9a0be079"], "node": "75ced0b58195c1f3f50a4bb89c77442f103da5c6", "parents": ["86b6471c58199788e2630e39b955cc0021dca825"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070120 - Build the breakpad injector against the sysroot. r=firefox-build-system-reviewers,ahochheiden\n\nThe task already fetched a sysroot but never used it: build-breakpad-injector.sh\nwrites a mozconfig with no --with-sysroot, and the bootstrapped sysroot only\napplies when bootstrap is enabled, which it isn't under MOZ_AUTOMATION. So the\nbuild used the docker image's libstdc++ headers and the library's ABI floor\nfollowed the image, going from GLIBCXX_3.4.29 to GLIBCXX_3.4.31 on Debian 13.\n\nDebian 12 provides GLIBCXX_3.4.30, so the resulting libbreakpadinjector.so\ncould not be dlopen'd there, and every jit-test that injects it failed with\nMOZ_CRASH(Failed to load library).\n\nUse sysroot-x86_64-linux-gnu rather than linux64-toolchain-sysroot: the\ninjector is built as C++20 and the latter only has libstdc++ 8. That also\nmatches the sibling minidump-stackwalk task and ordinary Firefox builds.\n\nThe resulting library needs GLIBC_2.14 and GLIBCXX_3.4, i.e. rather better\nthan the GLIBC_2.34 and GLIBCXX_3.4.29 it needed before Debian 13.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324562\n", "files": ["taskcluster/kinds/toolchain/minidump-stackwalk.yml", "taskcluster/scripts/misc/build-breakpad-injector.sh"], "git_node": "284996810d73f82346c21d4905d2da84971a6ec1", "git_parents": ["79403252a5841c28ea10d316373858bf9645586d"], "node": "37b80b85bc4452c6abd555f33857090da88ffcc5", "parents": ["75ced0b58195c1f3f50a4bb89c77442f103da5c6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070985 - Align the onnxruntime build with upstream's security flags. r=firefox-build-system-reviewers,sergesanspaille\n\nonnxruntime has a --use_binskim_compliant_compile_flags option that turns on the hardening flags it\nuses for its own compliance builds. Most of those overlap with what Firefox already applies to its own\ncode, but two gaps had gone unnoticed: macOS was the only platform building libonnxruntime without\n-fstack-protector-strong, and _FORTIFY_SOURCE was missing everywhere.\n\nRather than passing the upstream option, set the flags directly. The option also replaces\nCMAKE_CXX_FLAGS wholesale, which would collide with the flags this script passes, and it\ngates -fstack-clash-protection on the host architecture rather than the target, which is wrong for\ncross-compiled builds.\n\nAdded, following both upstream and Firefox:\n\n  macOS   -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2\n  Linux   the same, plus -Wp,-D_GLIBCXX_ASSERTIONS and -Wl,-Bsymbolic-functions\n  Linux   -fcf-protection, on x64 only since CET is x86-specific\n  Windows /guard:cf, at both compile and link\n\nMSVC already gives us the rest of what Windows would want: /GS, /DYNAMICBASE and /NXCOMPAT are on by\ndefault, so Control Flow Guard was the only gap. Passing it at link puts a space in the shared linker\nflags, which the unquoted extra_args string could not carry, so extra_args becomes an array.\nCMAKE_SHARED_LINKER_FLAGS stays unset on the other platforms because cmake seeds it from $LDFLAGS,\nwhich the Linux build relies on for -fuse-ld=lld.\n\nThe compile-time flags go into the C flags as well as the C++ flags. cpuinfo is C and is linked into\nthe library, and upstream's option sets both languages.\n\nThey are passed as CMAKE_C_FLAGS_INIT and CMAKE_CXX_FLAGS_INIT rather than CMAKE_C_FLAGS and\nCMAKE_CXX_FLAGS. A cache value for the latter replaces whatever the toolchain file would have\nsupplied, and the Android NDK supplies its hardening that way, so libonnxruntime.so on Android has\nbeen built without the NDK's -D_FORTIFY_SOURCE=2, -funwind-tables, -fdata-sections or\n-Wformat -Werror=format-security for as long as the script has set CMAKE_CXX_FLAGS. The _INIT form\nis prepended to those defaults instead. On MSVC it also restores cmake's default /EHsc, which is\nwhat upstream's exception-disabling code rewrites to /EHs-c-, and the /DWIN32 /D_WINDOWS defines\nthat upstream's own compliance flags add by hand. For the same reason the Linux sysroot moves from a\n--sysroot flag in CMAKE_C_FLAGS and CMAKE_CXX_FLAGS to CMAKE_SYSROOT: a cache value for CMAKE_C_FLAGS\nwould make cmake ignore the _INIT flags for C, and CMAKE_SYSROOT applies to every language and to the\nlink step anyway.\n\nOn Windows, nothing this script passed through CMAKE_CXX_FLAGS had ever reached the compiler. With\n--parallel, build.py appends its own -DCMAKE_C_FLAGS=/MP -DCMAKE_CXX_FLAGS=/MP after the extra\ndefines, and cmake keeps the last definition of a variable. /MP does nothing under Ninja, so that\nblock is disabled, which is also what lets the _INIT values take effect there: a cache value for\nCMAKE_CXX_FLAGS makes cmake ignore them.\n\nDeliberately not taken:\n\n  -Wp,-D_GLIBCXX_ASSERTIONS is libstdc++ only, so it is set for Linux and not for Android or macOS,\n  which use libc++. Upstream passes it there too, where it does nothing.\n\n  /Qspectre is skipped. The ONNX interface is gated on InferenceSession::InInferenceProcess, so it\n  only exists inside the dedicated inference process, and its callers are chrome features rather than\n  web content. A speculative read there exposes model data the caller already holds, which does not\n  justify the code size and speculation barriers on a compute library. This reasoning depends on that\n  process staying single-purpose and chrome-only.\n\n  -fstack-clash-protection is not added for macOS, which Firefox excludes along with Windows, OpenBSD\n  and iOS.\n\n  Android gets nothing beyond its existing flags now covering C too. Upstream excludes it from these\n  flags entirely and the NDK fortifies by default, which the _INIT change lets it do again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317820\n", "files": ["taskcluster/scripts/misc/build-onnxruntime.sh"], "git_node": "b2de416380879353cbc6db567ba702ead26c4c72", "git_parents": ["284996810d73f82346c21d4905d2da84971a6ec1"], "node": "a18cc79933b0f392119b7aa448c2f7a46cdf00ba", "parents": ["37b80b85bc4452c6abd555f33857090da88ffcc5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070985 - Disable C++ exceptions in the Windows onnxruntime build. r=firefox-build-system-reviewers,ahochheiden\n\nThe Windows toolchain has been building libonnxruntime with exceptions enabled, unlike every other\nplatform. --disable_exceptions is inert at the cmake level: onnxruntime_DISABLE_EXCEPTIONS is a\ndependent option that cmake forces off without onnxruntime_MINIMAL_BUILD, so the explicit\n-fno-exceptions and *_NO_EXCEPTIONS flags this script passed were the only thing turning exceptions\noff on Linux, macOS and Android, and nothing did the MSVC equivalent. A flags-only fix cannot work on\nMSVC either, since cmake appends /EHsc after the caller's flags whenever the option is off.\n\nThe local patch that already lets build.py accept --disable_exceptions on its own now does the same\nfor cmake by making the option plain. Upstream's own handling then applies everywhere: -fno-exceptions\non clang, dropping /EHsc and setting _HAS_EXCEPTIONS=0 on MSVC, and the ORT, ONNX, MLAS and json\nno-exception defines, so the script stops passing them itself. The patch also keeps unwind tables,\nwhich upstream drops alongside exceptions. Firefox builds with -funwind-tables so the crash reporter\ncan walk stacks, and frames inside libonnxruntime should stay walkable too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325059\n", "files": ["taskcluster/scripts/misc/build-onnxruntime.sh", "taskcluster/scripts/misc/onnxruntime.patches/0005-Allow-disable_exceptions-without-minimal_build.patch", "taskcluster/scripts/misc/onnxruntime.patches/0005-Disable-check-for-disable_exceptions-and-minimal_bui.patch"], "git_node": "3116837a30ad1222f44b6da01b79b3508d59a717", "git_parents": ["b2de416380879353cbc6db567ba702ead26c4c72"], "node": "cf0a5c935d476119104d28180c189116a3ffc3b5", "parents": ["a18cc79933b0f392119b7aa448c2f7a46cdf00ba"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069163 - Support CSS Module Scripts in Storybook r=jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323433\n", "files": ["browser/components/storybook/.storybook/main.js", "browser/components/storybook/.storybook/moz-styles-loader.js"], "git_node": "c184010ed1dbdc22563fd6f194c3fdd2d0c5474c", "git_parents": ["3116837a30ad1222f44b6da01b79b3508d59a717"], "node": "989890c591862f6f0b5c7a3f590235214c81038a", "parents": ["cf0a5c935d476119104d28180c189116a3ffc3b5"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068791 - Always avoid text wrapping moz-support-links r=desktop-theme-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323122\n", "files": ["browser/themes/shared/preferences/preferences.css", "toolkit/content/jar.mn", "toolkit/content/widgets/moz-fieldset/moz-fieldset.css", "toolkit/content/widgets/moz-input-common.css", "toolkit/content/widgets/moz-label/moz-label.mjs", "toolkit/content/widgets/moz-support-link/moz-support-link.css", "toolkit/content/widgets/moz-support-link/moz-support-link.mjs", "toolkit/content/widgets/styles-mixin.mjs"], "git_node": "09ee00fd9976507707413e278b3cbc940f4d8d65", "git_parents": ["c184010ed1dbdc22563fd6f194c3fdd2d0c5474c"], "node": "c633c506682193446f13b9b65e3670b309721bf2", "parents": ["989890c591862f6f0b5c7a3f590235214c81038a"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064736 - Expose --font-size-small to chrome documents r=dao,morgan,desktop-theme-reviewers,webcompat-reviewers,twisniewski\n\nProvide `--font-size-small` in chrome documents and target its relative\nfont size to be \u003e= 11px. On macOS this means using 1rem, on Windows it's\n(11 / 12)rem and Linux is left unchanged at expected 12.72px (14.6719 * 0.867)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319833\n", "files": ["browser/components/reportbrokensite/content/reportBrokenSitePanel.inc.xhtml", "toolkit/themes/linux/global/global.css", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/base/font.tokens.json"], "git_node": "c029c1ba18d16182c46f461653fe18a1e3f289af", "git_parents": ["09ee00fd9976507707413e278b3cbc940f4d8d65"], "node": "83190de2d15f1d976742b120466b17bebaa81cdb", "parents": ["c633c506682193446f13b9b65e3670b309721bf2"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062774 - Use design tokens for Account menu small fonts r=nsharpley,desktop-theme-reviewers,dao\n\nUse --font-size-small and .text-deemphasized rather than rolling the\ncustom 0.9em font size and helper styles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321738\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "64c67d806f3d2498ebe23fdabe8e91cc81de4800", "git_parents": ["c029c1ba18d16182c46f461653fe18a1e3f289af"], "node": "2398216fe5b65b7f76a2010afb842e5279e076dd", "parents": ["83190de2d15f1d976742b120466b17bebaa81cdb"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061366 - Remove legacy contentblocking probes r=timhuang,chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318127\n", "files": ["browser/components/protections/test/browser/browser_protections_telemetry.js", "toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "4f7f2820777caf6a3bb47f1d95f10b79a2f90d62", "git_parents": ["64c67d806f3d2498ebe23fdabe8e91cc81de4800"], "node": "fa25e69437236a431fea9e721db1a73a6f000107", "parents": ["2398216fe5b65b7f76a2010afb842e5279e076dd"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070120 - Use the gcc11 sysroot for gn builds. r=bustage\n", "files": ["taskcluster/kinds/toolchain/gn.yml"], "git_node": "486d9dec5eeffe15efae707ff640888ff4dc4ce7", "git_parents": ["4f7f2820777caf6a3bb47f1d95f10b79a2f90d62"], "node": "cf7bf384b19106e3ff8d0d3c85f9cad5fc38a915", "parents": ["fa25e69437236a431fea9e721db1a73a6f000107"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065181: Extend SyncStateStorage to add reset() API and make syncConnected nullable and observable r=android-reviewers,cbect\n\nThis commit makes two changes\n\n1. Adds reset() - to handle updating the state to what would indicate that sync values have been reset. This includes resetting the last synced time, \"is sync connected\", and \"persisted sync state\"\n  Reset is different from clear because clear removes the entries from the storage. Reset merely sets them back to a default state.\n\n2. SyncStateStorage.syncEnabled becomes SyncStateStorage.syncConnected, is now nullable, and has an observable variant. `null` indicates that the value has never been set.\n  It also adds a `storeSyncConnected` for setting that value.\n\n  \"Connected\" rather than \"enabled\" because this preference records whether sync was connected on this device through an explicit action, which kinda sounds better with the planned `connect()` / `disconnect()` APIs on `SyncManager`.\n\n  The resolution of `SyncStateStorage.syncConnected` to true/false falls outside the storage layer, and this only tells us if any value has been set or not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324593\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/SyncStateStorage.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/SharedPrefsSyncStateStorageTest.kt"], "git_node": "51e7705f84e9d487141a1f5a6b4b23db8e71de15", "git_parents": ["486d9dec5eeffe15efae707ff640888ff4dc4ce7"], "node": "fa7b7f42eb7c2bb92a1899e205dfcdec93076a0c", "parents": ["cf7bf384b19106e3ff8d0d3c85f9cad5fc38a915"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065181 - Add a flag for enabling sync decoupling to SyncConfig r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324594\n", "files": ["mobile/android/android-components/components/concept/sync/src/main/java/mozilla/components/concept/sync/SyncConfig.kt"], "git_node": "9fa59f96139869fb6d69cab979ab7d434482d52d", "git_parents": ["51e7705f84e9d487141a1f5a6b4b23db8e71de15"], "node": "35813eb14cc87be25b79544d32f0f0658b913a9a", "parents": ["fa7b7f42eb7c2bb92a1899e205dfcdec93076a0c"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058260 - Measure auto-compact against the area a maximized window is about to fill. r=emilio,dholbert\n\nA window opened maximized is laid out at its persisted *restored*\nsize: AppWindow::UpdateWindowStateFromMiscXULAttributes applies the sizemode\nattribute from xulstore before initial layout, but the size persisted alongside\nit is the un-maximized one (MaybeSavePersistentPositionAndSize stores\nGetRestoredBounds()), and the widget only learns its real size from the OS\nafterwards. gUIDensity.init() runs at browser-window-load in between, so\n_shouldAutoCompact() measures that smaller size and latches uidensity=\"compact\".\nThe window is then reflowed and painted at its real size while still carrying\ncompact, and only the DOM resize event that follows corrects the density: a\nvisible jump in toolbar height, corner rounding and content offset.\n\nMeasure the area such a window is about to fill instead. It is known up front\nand gives the same answer before and after the maximize transition, so there is\nnothing left to correct after the first paint. Unlike exempting a non-normal\nsizemode from auto-compact outright, this keeps compact mode for users whose\nscreen is genuinely small enough to warrant it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324960\n", "files": ["browser/base/content/browser.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js"], "git_node": "ad77e36a80787cc4cb1f73805f49157040928015", "git_parents": ["9fa59f96139869fb6d69cab979ab7d434482d52d"], "node": "51b6ed5c33f20a59e7d4ac27f6d50dba793b18d6", "parents": ["35813eb14cc87be25b79544d32f0f0658b913a9a"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2069235 - Allow pdf.js to load chrome: scripts under inherited CSPs. r=tschuster\n\nblob: and data: documents inherit their creator's CSP, which can block\nchrome: modules loaded by the pdf.js viewer. Scripts under resource://pdf.js/\nare already exempt.\n\nApply the same exemption to chrome: script loads whose loading principal is\npdf.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324064\n", "files": ["dom/security/nsCSPService.cpp", "dom/security/test/csp/browser_pdfjs_not_subject_to_csp.js"], "git_node": "edcc585c6050eeb587092d83c1d286042b5649cc", "git_parents": ["ad77e36a80787cc4cb1f73805f49157040928015"], "node": "bc0978d853c23f9261c6ec16b8c30c37181d2868", "parents": ["51b6ed5c33f20a59e7d4ac27f6d50dba793b18d6"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069235 - Update PDF.js to 716aff9d50c08b4bec3e350540a3f05aea89dedc r=fluent-reviewers,bolsson,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323500\n", "files": ["toolkit/components/aboutpdf/content/pdfFeaturesNotification.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.html", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/jar.mn", "toolkit/components/pdfjs/moz.yaml", "toolkit/locales/en-US/toolkit/about/pdfFeaturesNotification.ftl"], "git_node": "fc088effac46d8f5f1906be6502dfc903a1b79ff", "git_parents": ["edcc585c6050eeb587092d83c1d286042b5649cc"], "node": "e04c0bbd51fb11f1a136ba47fb3747aae9a65dc8", "parents": ["bc0978d853c23f9261c6ec16b8c30c37181d2868"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040802: Rename ENABLE_WASM_SIMD to ENABLE_JIT_SIMD r=yury\n\nBased on Element discussions with Ryan and Yury, I am removing the outdated wasm-no-experimental dependency. Wasm SIMD is no longer experimental.\n\nThis also changes ENABLE_WASM_AVX to ENABLE_JIT_AVX, and updates the two uses. I didn't change ENABLE_WASM_RELAXED_SIMD, because relaxing strict determinism is wasm-specific, and it isn't used outside of wasm code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301943\n", "files": ["js/moz.configure", "js/public/Initialization.h", "js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/wasm/simd/disabled.js", "js/src/jit/CodeGenerator.cpp", "js/src/jit/JitContext.cpp", "js/src/jit/LIR.cpp", "js/src/jit/LIR.h", "js/src/jit/Lowering.cpp", "js/src/jit/MIR-wasm.cpp", "js/src/jit/MIR-wasm.h", "js/src/jit/MacroAssembler.h", "js/src/jit/ShuffleAnalysis.cpp", "js/src/jit/ShuffleAnalysis.h", "js/src/jit/arm/Architecture-arm.cpp", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/arm/MacroAssembler-arm.cpp", "js/src/jit/arm/Trampoline-arm.cpp", "js/src/jit/arm64/Assembler-arm64.cpp", "js/src/jit/arm64/Assembler-arm64.h", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.h", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/mips-shared/Lowering-mips-shared.cpp", "js/src/jit/mips64/Architecture-mips64.cpp", "js/src/jit/mips64/MacroAssembler-mips64.cpp", "js/src/jit/riscv64/Architecture-riscv64.cpp", "js/src/jit/riscv64/Architecture-riscv64.h", "js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/Register-riscv64.h", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/Lowering-shared-inl.h", "js/src/jit/shared/Lowering-shared.h", "js/src/jit/x64/Lowering-x64.cpp", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86-shared/Architecture-x86-shared.cpp", "js/src/jit/x86-shared/Assembler-x86-shared.cpp", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp", "js/src/jit/x86/Lowering-x86.cpp", "js/src/jit/x86/Trampoline-x86.cpp", "js/src/shell/js.cpp", "js/src/vm/Initialization.cpp", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCCodegen-inl.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBCFrame.h", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmBCRegDefs-inl.h", "js/src/wasm/WasmBCRegDefs.h", "js/src/wasm/WasmBCRegMgmt-inl.h", "js/src/wasm/WasmBCStk.h", "js/src/wasm/WasmBCStkMgmt-inl.h", "js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmBinary.h", "js/src/wasm/WasmDebugFrame.cpp", "js/src/wasm/WasmDebugFrame.h", "js/src/wasm/WasmFeatures.h", "js/src/wasm/WasmInitExpr.cpp", "js/src/wasm/WasmIonCompile.cpp", "js/src/wasm/WasmOpIter.cpp", "js/src/wasm/WasmOpIter.h", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h", "js/src/wasm/WasmValType.cpp", "js/src/wasm/WasmValType.h", "js/src/wasm/WasmValidate.cpp", "js/xpconnect/src/nsXPConnect.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "83fa1f349c132b7ea473106cd6f1946bcfb6da81", "git_parents": ["fc088effac46d8f5f1906be6502dfc903a1b79ff"], "node": "b8799bc51d030b3c70b1f1c699f589be7bec160d", "parents": ["e04c0bbd51fb11f1a136ba47fb3747aae9a65dc8"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929128: Use SIMD for SkipUntilBitInTable r=jandem\n\nClaude wrote a prototype of this patch, then I rewrote it by hand and polished up a bunch of stuff.\n\nV8 has two other ops that it implements using SIMD (SkipUntilOneOfMasked and SkipUntilOneOfMasked3), but the latter was disabled because it regressed TodoMVC-jquery, and despite my best efforts, I can't write a single testcase that triggers the former in V8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301944\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h"], "git_node": "f6fb93ca3422659bbc2311fdb0e4c7439776c86a", "git_parents": ["83fa1f349c132b7ea473106cd6f1946bcfb6da81"], "node": "d561fea5a308188571895eb38410708594760ef7", "parents": ["b8799bc51d030b3c70b1f1c699f589be7bec160d"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042565: Improve non-AVX support in simple three-operand SIMD operations r=yury\n\nThis patch adds new helpers to handle register shuffling when AVX is not available. The choice between commutative vs non-commutative for each op was copied from WasmIonCompile.cpp.\n\nThe FMA code uses ScratchSimd128Scope and then calls helpers that now need it themselves, so I rewrote it to use the underlying instructions directly. This is more consistent with other code that uses the scratch register in this file (eg reverseInt16x8).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303160\n", "files": ["js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.h"], "git_node": "cde052376a1eddc3305f624bb734527334b44c22", "git_parents": ["f6fb93ca3422659bbc2311fdb0e4c7439776c86a"], "node": "b6bdf39fa159b72690032a430d19b2f6d760dcad", "parents": ["d561fea5a308188571895eb38410708594760ef7"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042565: Enable SIMD for SkipUntilBitInTable without AVX r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303161\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/jit-test/tests/regexp/non-avx.js"], "git_node": "8f791a67d0b629af263045e49589871b2f10a7fa", "git_parents": ["cde052376a1eddc3305f624bb734527334b44c22"], "node": "bfc45551f7579d34ced4a0373cbd4cab9e028212", "parents": ["b6bdf39fa159b72690032a430d19b2f6d760dcad"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070949: Check for SSSE3, not SSE3, for pshufb r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325073\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/jit-test/tests/regexp/non-ssse3.js"], "git_node": "a20f92752fbc43b99e91d8c2391fb6ad66e22c72", "git_parents": ["8f791a67d0b629af263045e49589871b2f10a7fa"], "node": "95b81489e2ebc994d3c4695408e1155a86f553ca", "parents": ["bfc45551f7579d34ced4a0373cbd4cab9e028212"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069519 - Record every theme-picker shown event. r=mstriemer\n\nRemove shared client-side deduplication so every ThemePicker.shown()\ncall records one event with source and layout.\n\nConsumers still decide when a picker is shown. Reporting can aggregate\nrepeated events later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324461\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs"], "git_node": "e638419e1b4ce1b8e0c71cb8ad3163c4f271d654", "git_parents": ["a20f92752fbc43b99e91d8c2391fb6ad66e22c72"], "node": "4db9c012be65069d47abdc90b9e3c154ee4aeb37", "parents": ["95b81489e2ebc994d3c4695408e1155a86f553ca"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069172 - Record appearance and native-theme changes from the theme picker. r=omc-reviewers,mstriemer,jprickett\n\nRecord each appearance and native-theme change with its selected value,\nsource, and layout.\n\nRecord direct updates locally. Record remote updates after the parent\napplies them.\n\nKeep theme selection in ThemesList and preserve its per-source\nattribution.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324462\n", "files": ["browser/actors/ThemePickerParent.sys.mjs", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_theme_picker.js", "browser/modules/metrics.yaml", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs"], "git_node": "85c4f8447ee9456da045239e26518541aa3f2cc3", "git_parents": ["e638419e1b4ce1b8e0c71cb8ad3163c4f271d654"], "node": "4a58e89e7343f38573e6177402330a2710ff592b", "parents": ["4db9c012be65069d47abdc90b9e3c154ee4aeb37"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069127 - Record theme-picker shown telemetry for Profiles. r=jhirsch,mstriemer\n\nBug 2052547 landed the `theme_picker.shown` event and left each surface\nto add its own caller. Profiles needs that caller so\n`profiles.existing.theme` and `profiles.new.theme` have an impression\ncount to compare against.\n\n`EditProfileCard.maybeRecordThemePickerShown()` records after the Nova\npicker is rendered, initialized, and visible. `NewProfileCard` inherits\nthis flow, so the same logic covers about:newprofile.\n`ThemePickerInitialState` handles readiness completing after visibility,\nwhile `visibilitychange` handles visibility completing after readiness.\nSuccessful recording removes both listeners. A final check after both\nrender waits prevents hidden or disconnected cards and overlapping calls\nfrom recording.\n\nThe visibility check is tab-level rather than viewport-level, which\nkeeps the impression denominator comparable to about:welcome, New Tab,\nand about:addons.\n\nNova renders `theme-picker` independently of legacy `this.themes`. The\nlegacy picker keeps its existing `this.themes` availability check.\n\nThe focused browser test covers active loading, background-tab deferral,\nvisibility changes during rendering, and per-document recording.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324463\n", "files": ["browser/components/profiles/content/edit-profile-card.mjs", "browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/browser/browser_profiles_theme_picker_shown_telemetry_test.js"], "git_node": "72761ed8df97ba357504f52b7b1365372f77ba04", "git_parents": ["85c4f8447ee9456da045239e26518541aa3f2cc3"], "node": "5fe70696273c9fd39ef0d916865d547d811f0082", "parents": ["4a58e89e7343f38573e6177402330a2710ff592b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070766 - Update AndroidX Benchmark to version 1.5.0. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324825\n", "files": ["gradle/libs.versions.toml"], "git_node": "17b3e05d0c3edbf47daccfe3b551e1831686db08", "git_parents": ["72761ed8df97ba357504f52b7b1365372f77ba04"], "node": "251c45fd0c03c143552338eae84919327247ef9e", "parents": ["5fe70696273c9fd39ef0d916865d547d811f0082"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070766 - Update AndroidX Compose BOM to 2026.09.00. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324826\n", "files": ["gradle/libs.versions.toml"], "git_node": "55783d0ddbc16b3e6fb31d582d2ecbb9b45a1d9a", "git_parents": ["17b3e05d0c3edbf47daccfe3b551e1831686db08"], "node": "3dcc1e441a821689c87ceece4fc9882ec8ba41cf", "parents": ["251c45fd0c03c143552338eae84919327247ef9e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070766 - Update AndroidX Navigation to version 2.10.1. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324827\n", "files": ["gradle/libs.versions.toml"], "git_node": "e943a5a682e686c3186796c60d57201a24c80ac7", "git_parents": ["55783d0ddbc16b3e6fb31d582d2ecbb9b45a1d9a"], "node": "81c0b2bab7cb9ef738454f742a3a54b1258cf910", "parents": ["3dcc1e441a821689c87ceece4fc9882ec8ba41cf"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070766 - Update AndroidX Room to version 2.8.5. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324828\n", "files": ["gradle/libs.versions.toml"], "git_node": "8ccc13a1df178436cf5aef4ee3cf2470a953d034", "git_parents": ["e943a5a682e686c3186796c60d57201a24c80ac7"], "node": "3b57ea519c4b539e93eb8af9d8779cd8650b7c88", "parents": ["81c0b2bab7cb9ef738454f742a3a54b1258cf910"], "tags": []}, {"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041980 - Remove the cfr_doorhanger, milestone_message and cfr_urlbar_chiclet message templates. r=omc-reviewers,desktop-theme-reviewers,frontend-codestyle-reviewers,urlbar-reviewers,mossop,andhuang,dao,mtigley,credential-management-reviewers\n\nCFRPageActions exists only to render these three templates, so it is removed\nalong with CFRMessageProvider, the CFR schemas, the\ncontextual-feature-recommendation popupnotification, the urlbar chiclet and their\nstylesheets, plus MILESTONE_MESSAGE_87 now that the felt-privacy milestone\nexperiment detected no effect. ASRouter.observe() now calls\nRemoteL10n.reloadL10n() directly instead of going through CFRPageActions, which\nmeans the useRemoteL10n pref actually invalidates the l10n cache where the old\nCFR-gated path never fired.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318365\n", "files": ["browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/popup-notifications.inc.xhtml", "browser/components/BrowserComponents.manifest", "browser/components/aboutlogins/content/icons/intro-illustration.svg", "browser/components/aboutlogins/jar.mn", "browser/components/asrouter/bin/import-rollouts.js", "browser/components/asrouter/content-src/components/ASRouterAdmin/ASRouterAdmin.jsx", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/schemas/extract-test-corpus.js", "browser/components/asrouter/content-src/schemas/make-schemas.py", "browser/components/asrouter/content-src/schemas/provider-response.schema.json", "browser/components/asrouter/content-src/templates/CFR/templates/CFRUrlbarChiclet.schema.json", "browser/components/asrouter/content-src/templates/CFR/templates/ExtensionDoorhanger.schema.json", "browser/components/asrouter/content/asrouter-admin.bundle.js", "browser/components/asrouter/content/assets/glyph-cfr-feature-16.svg", "browser/components/asrouter/content/assets/glyph-webextension-16.svg", "browser/components/asrouter/docs/cfr-doorhanger.png", "browser/components/asrouter/docs/cfr_doorhanger_screenshot.png", "browser/components/asrouter/docs/contextual-feature-recommendation.md", "browser/components/asrouter/docs/index.md", "browser/components/asrouter/docs/messaging-surfaces.md", "browser/components/asrouter/docs/remote_cfr.md", "browser/components/asrouter/jar.mn", "browser/components/asrouter/karma.mc.config.js", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/CFRMessageProvider.sys.mjs", "browser/components/asrouter/modules/CFRPageActions.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/moz.build", "browser/components/asrouter/tests/browser/browser.toml", "browser/components/asrouter/tests/browser/browser_asrouter_cfr.js", "browser/components/asrouter/tests/browser/browser_asrouter_keyboard_cfr.js", "browser/components/asrouter/tests/browser/browser_asrouter_milestone_message_cfr.js", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/asrouter/tests/unit/CFRMessageProvider.test.js", "browser/components/asrouter/tests/unit/CFRPageActions.test.js", "browser/components/asrouter/tests/unit/constants.js", "browser/components/asrouter/tests/unit/templates/ExtensionDoorhanger.test.jsx", "browser/components/asrouter/tests/xpcshell/head.js", "browser/components/asrouter/tests/xpcshell/test_CFRMessageProvider.js", "browser/components/asrouter/tests/xpcshell/xpcshell.toml", "browser/components/messagepreview/actors/AboutMessagePreviewParent.sys.mjs", "browser/components/messagepreview/tests/browser/browser.toml", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_cfr.js", "browser/installer/allowed-dupes.mn", "browser/themes/shared/addons/addon-install-downloading.svg", "browser/themes/shared/browser-colors.css", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/urlbar.css", "taskcluster/kinds/source-test/python.yml", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_cfrmessageprovider.js", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/test/browser/browser_asrouter_trigger_docs.js", "toolkit/components/messaging-system/schemas/index.md"], "git_node": "77368d77d08d47bfdd4bc4735a677e02327c7c41", "git_parents": ["8ccc13a1df178436cf5aef4ee3cf2470a953d034"], "node": "650ea27a6d0a00d7585276fb0483a39936072cc6", "parents": ["3b57ea519c4b539e93eb8af9d8779cd8650b7c88"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976766 - Stop assuming a buffer is still mapped in the GPU process. r=webgpu-reviewers,ErichDonGubler\n\n`MapCallback`, `BufferUnmap`, `ReadbackPresentCallback` and\n`ReadbackSnapshotCallback` all read a buffer's mapped range while\nassuming it is still mapped. `MapCallback` is not invoked by wgpu-core\ndirectly but from a task, so content can destroy or unmap the buffer, or\nits device, before it runs. And once a device is lost or destroyed\nwgpu-core destroys all of its buffers in `release_gpu_resources`, at the\nend of whichever poll drains the device's queue; that poll is driven by\nthe GPU process, with no content involvement and no ordering against\ncontent's messages.\n\nReturn a null ptr for `DestroyedResource` and `NotMapped` rather\nthan panicking, and handle that at each call site: send a map error to\ncontent, skip the write-back flush, or skip the readback. `MapCallback`\nalso has to tolerate the parent's `mapData` for the buffer being gone,\nwhich can be caused by content destroying or dropping the buffer.\n\nRelated fixes:\n\n- moved `MapCallback`'s `get_mapped_range` call out of the read-only\n  branch so every map is checked.\n\n- `Buffer::Unmap` previously cancelled a pending map without telling the\n  GPU process, so content saw the buffer as unmapped while wgpu-core\n  still\n  had it mapped. Forwarding that unmap is what makes the `NotMapped`\n  race\n  above reachable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324946\n", "files": ["dom/webgpu/Buffer.cpp", "dom/webgpu/ipc/WebGPUParent.cpp", "gfx/wgpu_bindings/src/server.rs", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/service.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/shared.https.html.ini"], "git_node": "30e739ff4faf37889c8da08f23d9c76d7abe1398", "git_parents": ["77368d77d08d47bfdd4bc4735a677e02327c7c41"], "node": "2c474325a7d6d4375d602cd7774a03032df02b44", "parents": ["650ea27a6d0a00d7585276fb0483a39936072cc6"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069920 - Enable Notification.navigate for all channels. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324368\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "619ae0e54e5462be586b30c8c91fd677cdde12e7", "git_parents": ["30e739ff4faf37889c8da08f23d9c76d7abe1398"], "node": "2ffa1626ec4c3b97aa59775729045b8999245a9d", "parents": ["2c474325a7d6d4375d602cd7774a03032df02b44"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065105 - Warn instead of crashing when ServiceWorkerPrivate::Initialize() fails. r=asuth,dom-worker-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323931\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp"], "git_node": "88478408e30241c38b5e226b9829a9e7ccd43942", "git_parents": ["619ae0e54e5462be586b30c8c91fd677cdde12e7"], "node": "fb85319aadfc08b9f4f15b536a881c940fae4cb7", "parents": ["2ffa1626ec4c3b97aa59775729045b8999245a9d"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2061851 - Open a new tab with the address bar focused from the search widget when Homepage as New Tab is enabled r=android-reviewers,npoon\n\n- When Homepage as New Tab is enabled, starting a search from the search widget will add a new homepage tab in the current browsing mode before navigating home with the address bar focused, so the widget lands on the zero search state in its own tab.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321966\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/StartSearchIntentProcessor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/browsingmode/fakes/FakeBrowsingModeManager.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/AssistIntentProcessorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/OpenHomeIntentProcessorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/StartSearchIntentProcessorTest.kt"], "git_node": "b6ea34b11ee11bd51e41c74529469fa2acb1a763", "git_parents": ["88478408e30241c38b5e226b9829a9e7ccd43942"], "node": "c022715c888f238c5191d768759d6d1b26b18550", "parents": ["fb85319aadfc08b9f4f15b536a881c940fae4cb7"], "tags": []}, {"author": "Osmond Arnesto \u00