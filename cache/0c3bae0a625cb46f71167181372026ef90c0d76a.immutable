uter-newtab-multistage.scss", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAWProton.test.jsx", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "e2874c33e74b1ed94fafffae4c9eb66f38dee0e7", "git_parents": ["5731b377bc517d56117f4cc98c42d60828c927c2"], "node": "c836ee0cc2d67974721674b31c794854d4c09e7f", "parents": ["15c35db5de446a949dba2d8a9795e9bcaca56d26"], "tags": []}, {"author": "Bob Hood \u003cbhood@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072713: Add new Platform Graphics component references r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326609\n", "files": ["gfx/angle/moz.yaml", "gfx/cairo/moz.yaml", "gfx/moz.build", "third_party/moz.build"], "git_node": "9240dd3b399ea060ecbfeee918cf2aa0735b0cc0", "git_parents": ["e2874c33e74b1ed94fafffae4c9eb66f38dee0e7"], "node": "ca5c1013fa3d48d86f6423d680372002600f7f28", "parents": ["c836ee0cc2d67974721674b31c794854d4c09e7f"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2072475 - Update libcubeb to e13d9c88. r=cubeb-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326366\n", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_aaudio.cpp", "media/libcubeb/src/cubeb_triple_buffer.h", "media/libcubeb/src/cubeb_utils.h", "media/libcubeb/test/test_sanity.cpp", "media/libcubeb/test/test_triple_buffer.cpp"], "git_node": "db79f19deecfc289904cabfbc64a2b2bd6d0c01b", "git_parents": ["9240dd3b399ea060ecbfeee918cf2aa0735b0cc0"], "node": "61e9e31ced4a2c27462f311dc02e7f3ba6f81e59", "parents": ["ca5c1013fa3d48d86f6423d680372002600f7f28"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2072460 - Vendor latest mp4parse-rust. r=media-playback-reviewers,alwu\n\nUpdate mp4parse and mp4parse_capi from\n215e238e633fa0df42cc25bfcf43a0f902692691 to\nf0c80783227a1fb46f34cb04e10607045eac4297.\n\nIncludes the fix for bug 2026607: use the stsz sample count to ignore\nsurplus stco chunks once all samples have been accounted for.\n\nUpstream PR: https://github.com/mozilla/mp4parse-rust/pull/455\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326357\n", "files": [".cargo/config.toml.in", "Cargo.lock", "third_party/rust/mp4parse/.cargo-checksum.json", "third_party/rust/mp4parse/src/lib.rs", "third_party/rust/mp4parse/src/unstable.rs", "third_party/rust/mp4parse_capi/.cargo-checksum.json", "third_party/rust/mp4parse_capi/tests/test_sample_table.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "f04c43deff17a2722bfa4a89efbb29e8901dfa44", "git_parents": ["db79f19deecfc289904cabfbc64a2b2bd6d0c01b"], "node": "2ddbd65689d1613df24c457d69775779feedee60", "parents": ["61e9e31ced4a2c27462f311dc02e7f3ba6f81e59"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072660 - Remove nightly build annotations now that skpdf is riding the trains. r=layout-reviewers,gfx-reviewers,dholbert,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326587\n", "files": ["testing/web-platform/meta/css/css-break/block-001-wm-vrl-print.html.ini", "testing/web-platform/meta/css/css-page/fixedpos-with-abspos-with-link-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-008-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-019-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-032-print.tentative.html.ini", "testing/web-platform/meta/css/css-page/page-name-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-landscape-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-002-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-003-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-square-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-size-015-print.tentative.html.ini", "testing/web-platform/meta/css/printing/select-combobox-print.html.ini", "testing/web-platform/mozilla/meta/html/canvas/mozPrintCallback-text-001-print.html.ini", "testing/web-platform/mozilla/meta/html/canvas/mozPrintCallback-text-002-print.html.ini"], "git_node": "c67408d238b455a4a2f1aadb0c912fee3287d00a", "git_parents": ["f04c43deff17a2722bfa4a89efbb29e8901dfa44"], "node": "83b780006ab22aac823f3635012dfcd61a87e139", "parents": ["2ddbd65689d1613df24c457d69775779feedee60"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2072214 - Don't trunscate search widget results before hover. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326410\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/RecentSearches/_RecentSearches.scss"], "git_node": "ac3e9bab0a98a53c891ae511df76c4de73dfdf04", "git_parents": ["c67408d238b455a4a2f1aadb0c912fee3287d00a"], "node": "42692bf698c3db7f4ea36cc8171558a3a505895f", "parents": ["83b780006ab22aac823f3635012dfcd61a87e139"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072405 - Make preference for WPTs clearer in layout/AGENTS.md. r=dholbert,layout-reviewers,ai4dev-reviewers,emilio,suhaib DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326339\n", "files": ["layout/AGENTS.md"], "git_node": "7e053542001bb3d03618524242459ab573993ac0", "git_parents": ["ac3e9bab0a98a53c891ae511df76c4de73dfdf04"], "node": "900664825664f8b6bdb4767456db34589bfa93ba", "parents": ["42692bf698c3db7f4ea36cc8171558a3a505895f"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2072728 - Intermittent failure in verifyTheExtensionInstallationTest: recommended-addon allowlist races AMO's async extension list r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326704\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/MainMenuPage.kt"], "git_node": "702308336cbcbb7433ae48d6dd1d8c9c6d6decf7", "git_parents": ["7e053542001bb3d03618524242459ab573993ac0"], "node": "294ce625a1ef4647533885f1fc5e83dad12cb234", "parents": ["900664825664f8b6bdb4767456db34589bfa93ba"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2033336 - Unpack GCNO files to topobjdir. r=marco\n\nThe GCNO files contains relative paths, so they should be unpacked to\nthe same location they were originally packed from for grcov to work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325660\n", "files": ["testing/mozharness/mozharness/mozilla/testing/codecoverage.py"], "git_node": "41b974a21cd8549a7ecc926924f78488e95582cd", "git_parents": ["702308336cbcbb7433ae48d6dd1d8c9c6d6decf7"], "node": "1aa2ec78490da7fa8573d021afa1c6e5c71c5c49", "parents": ["294ce625a1ef4647533885f1fc5e83dad12cb234"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070264 - Guard mFontFace//mFontFace5 members with the font-entry lock. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326447\n", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "3d87e25210a843d5f5cf28a3377fb689ff1ce7ba", "git_parents": ["41b974a21cd8549a7ecc926924f78488e95582cd"], "node": "a1d1c4e8dfc514ee68d005e1ce594181368d383a", "parents": ["1aa2ec78490da7fa8573d021afa1c6e5c71c5c49"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1709529 - Only allow toggling the `watchedByDevTools` flag from the parent process. r=devtools-reviewers,nchevobbe,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324045\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/test/browser/browser_watchedByDevTools_canset.js"], "git_node": "87cc1393dbb1c4474bf9e67385e4a76dc2491d97", "git_parents": ["3d87e25210a843d5f5cf28a3377fb689ff1ce7ba"], "node": "8f95a49bd055cf98c67078d3d29f13e02dde4eb7", "parents": ["a1d1c4e8dfc514ee68d005e1ce594181368d383a"], "tags": []}, {"author": "Lavindeep Dhillon \u003c62158930+lavindeep@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069768 - Declare subprocess fcntl as variadic and pass typed flags. r=robwu\n\nfcntl takes two fixed arguments followed by variadic arguments. Declaring\nthe third argument as a fixed int passes it with the wrong calling\nconvention on Apple silicon, so the subprocess pipes end up with\nincorrect descriptor and file status flags.\n\nDeclare fcntl with \"...\" and pass ctypes.int values at the call sites.\nAdd an xpcshell test that checks the pipe flags on Unix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323933\n", "files": ["toolkit/modules/subprocess/subprocess_shared_unix.js", "toolkit/modules/subprocess/subprocess_unix.sys.mjs", "toolkit/modules/subprocess/subprocess_unix.worker.js", "toolkit/modules/subprocess/test/xpcshell/test_subprocess_pipe_flags.js", "toolkit/modules/subprocess/test/xpcshell/xpcshell.toml"], "git_node": "a02295e05498b8b0597584e84598c8f047cdf248", "git_parents": ["87cc1393dbb1c4474bf9e67385e4a76dc2491d97"], "node": "fb5b25f2368c154c9667d8450a31fb8fa3b0f982", "parents": ["8f95a49bd055cf98c67078d3d29f13e02dde4eb7"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068173: apply tigher rules for SFF autocomplete provider r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325551\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_initialization.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_mutations.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_metadata_lifecycle.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_telemetry.js", "browser/components/aiwindow/ui/test/browser/test_smartformfill_supported_fields.html"], "git_node": "61173e705c18aa68b36594d69ff764cf51a5ab09", "git_parents": ["a02295e05498b8b0597584e84598c8f047cdf248"], "node": "819ebd617e5cd6f4a1bbcb529c20f9bd6c82ac29", "parents": ["fb5b25f2368c154c9667d8450a31fb8fa3b0f982"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070289 - Parameterize theme preview images. r=rpl,desktop-theme-reviewers,firefox-style-system-reviewers,kcochrane,dshin\n\nYour call if we want to do this, but seems nicer since we have the\ngradients already there for the theme picker.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324379\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/themes/ThemesList.sys.mjs", "browser/themes/addons/extra-themes-previews/nova-ash@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-dusk@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-flame@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-flare@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-lagoon@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-lavender@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-pine@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-smoke@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-spark@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-sun@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-tide@mozilla.org-preview.svg", "browser/themes/addons/jar.mn", "browser/themes/test/unit/test_ThemesList.js", "servo/components/style/properties/longhands.toml", "toolkit/mozapps/extensions/content/aboutaddons-utils.mjs", "toolkit/mozapps/extensions/content/components/theme-preview.mjs", "toolkit/mozapps/extensions/default-theme/preview-nova.svg", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "a262ed271adb32c6253f2f454965e966577c9c8a", "git_parents": ["61173e705c18aa68b36594d69ff764cf51a5ab09"], "node": "0a0d605f6c60d18b9fff00d1f8c58684889c36df", "parents": ["819ebd617e5cd6f4a1bbcb529c20f9bd6c82ac29"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2068782 - Add base styling for AITab components - r=jlewis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325221\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-shared.css", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn"], "git_node": "e25c942383d5e8a935557032ca569136eecbe90f", "git_parents": ["a262ed271adb32c6253f2f454965e966577c9c8a"], "node": "3303935e13a131013ac1265c3e77733cd0694bed", "parents": ["0a0d605f6c60d18b9fff00d1f8c58684889c36df"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072388 - Remove os == 'android' skip-if from browser-chrome and chrome manifests. r=ci-and-tooling,marco\n\nThe android14-x86_64 test set schedules neither mochitest-browser-chrome nor\nmochitest-chrome, so these manifest-wide conditions have never matched anything.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326534\n", "files": ["browser/extensions/formautofill/test/browser/heuristics/browser.toml", "browser/extensions/formautofill/test/browser/heuristics/third_party/browser.toml", "dom/broadcastchannel/tests/browser.toml", "dom/serviceworkers/test/chrome-common.toml", "editor/libeditor/tests/browser.toml", "toolkit/components/nimbus/test/browser/browser.toml", "widget/tests/browser/browser.toml"], "git_node": "bac819e1c3be4c5d83819f9c061b483d37dbba0b", "git_parents": ["e25c942383d5e8a935557032ca569136eecbe90f"], "node": "391bce5e7bcaa9ed6654027215b9bec16f0f8493", "parents": ["3303935e13a131013ac1265c3e77733cd0694bed"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072388 - Remove dead socketprocess_networking conditions from test manifests. r=ci-and-tooling,extension-reviewers,marco,robwu\n\nBug 2004381 removed the socketprocess_networking variant from variants.yml and\nfrom every job that used it, so these conditions can no longer be true. The\nnotes they carried are recorded here in case the variant comes back: the doh\nbrowser tests were a high-frequency intermittent (bug 1849304), resetPrefs() is\nracy in the socket process, and the extensions conditions came from bug 1759035.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326535\n", "files": ["modules/libpref/test/unit/xpcshell.toml", "toolkit/components/doh/test/browser/browser.toml", "toolkit/components/extensions/test/xpcshell/xpcshell-e10s.toml", "toolkit/components/extensions/test/xpcshell/xpcshell-remote.toml"], "git_node": "aec6526d81fbbac34e0c1ed9c644b237fa3f7216", "git_parents": ["bac819e1c3be4c5d83819f9c061b483d37dbba0b"], "node": "13a478880bc3f45880fbe0f28f111cf84451aad8", "parents": ["391bce5e7bcaa9ed6654027215b9bec16f0f8493"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072388 - Remove the tsan skip-if from the accessibility perftest manifest. r=ci-and-tooling,marco\n\nBug 1963506, the data race it worked around, is fixed, and every test in the\nmanifest carries disabled so none of them runs in CI regardless.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326536\n", "files": ["accessible/tests/browser/performance/perftest.toml"], "git_node": "c466807a0015a58da1dad1db80b0fa9151fec7cf", "git_parents": ["aec6526d81fbbac34e0c1ed9c644b237fa3f7216"], "node": "0edfa2090c7d0cb58145566d40f7451db45640bb", "parents": ["13a478880bc3f45880fbe0f28f111cf84451aad8"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1989470 - Combine a [DEFAULT] run-if with a per-test run-if. r=ci-and-tooling,keeler,marco\n\nA per-test run-if replaced the manifest default rather than narrowing it, so a\nmanifest-wide condition silently stopped applying to any test that had its own\nrun-if.\n\nThe conditions within one run-if are OR'd, so combining the two levels is the &&\ncross product rather than the newline join skip-if uses. The earlier attempt\nhere also changed run_if() to require every line to match, which turned that\nwithin-list OR into an AND and stopped multi-entry conditions from ever\nmatching, so filters.py is left alone this time.\n\nThe PSM unit manifest's msix condition moves to skip-if as part of this: bug\n1809477 is an unfixed timeout under msix rather than a statement about scope,\nand left in run-if it would be the only place in the tree where this change\nstops tests that run today. The autoconfig comment is reworded because \"does not\nwork in MSIX builds\" reads as breakage, while bug 1807926 records a\nconfiguration we deliberately do not support, which is why run-if is right\nthere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326541\n", "files": ["extensions/pref/autoconfig/test/unit/xpcshell.toml", "security/manager/ssl/tests/unit/xpcshell.toml", "testing/mozbase/manifestparser/manifestparser/ini.py", "testing/mozbase/manifestparser/tests/default-runif-multi.toml", "testing/mozbase/manifestparser/tests/default-runif.toml", "testing/mozbase/manifestparser/tests/runif-no-default.toml", "testing/mozbase/manifestparser/tests/test_default_overrides.py", "testing/mozbase/manifestparser/tests/test_filters.py"], "git_node": "2fd1e69b5f7d7d1a02ec5e3b1026c72ebf0f5258", "git_parents": ["c466807a0015a58da1dad1db80b0fa9151fec7cf"], "node": "29f563b814c4395aa3506644162fb9bb530e155d", "parents": ["0edfa2090c7d0cb58145566d40f7451db45640bb"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070977 - add hashes arg to the openNewtab function r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325053\n", "files": ["browser/components/uitour/UITour-lib.js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_showNewTab.js"], "git_node": "97d8b91d9832f196d563904ea4474e9283bdf149", "git_parents": ["2fd1e69b5f7d7d1a02ec5e3b1026c72ebf0f5258"], "node": "9dcb61c697911a6705c890791710c171331de795", "parents": ["29f563b814c4395aa3506644162fb9bb530e155d"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069931 - Enabling prefs for Permissions-Policy WPTs and updating expectations r=simonf\" for causing wpt failures @ /permissions-policy/idlharness.window\n\nThis reverts commit 138803db276022b86ff3826637a029a4f5278dbe.\n", "files": ["testing/web-platform/meta/permissions-policy/__dir__.ini", "testing/web-platform/meta/permissions-policy/historical.html.ini", "testing/web-platform/meta/permissions-policy/idlharness.window.js.ini", "testing/web-platform/meta/permissions-policy/payment-supported-by-permissions-policy.tentative.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-self.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-some-override.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-some.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-disallowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-malformed-wildcard.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-self.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-some.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-wildcard.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-declined.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-disallowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-nested-header-policy-allowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-nested-header-policy-allowed-for-self.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-nested-header-policy-disallowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/picture-in-picture-disabled-by-permissions-policy.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/picture-in-picture-supported-by-permissions-policy.html.ini", "testing/web-platform/meta/permissions-policy/reporting/camera-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/encrypted-media-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/fullscreen-reporting.html.ini", "testing/web-platform/meta/permissions-policy/reporting/geolocation-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/microphone-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/midi-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/picture-in-picture-reporting.html.ini", "testing/web-platform/meta/permissions-policy/reporting/report-only-and-enforce.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/reporting/report-to-multiple-endpoints.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/reporting/report-to-single-endpoint.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/reporting/screen-wake-lock-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/serial-reporting.https.html.ini"], "git_node": "a90268f2cd3c33e9fc19cb28eacc0bf367684d3c", "git_parents": ["97d8b91d9832f196d563904ea4474e9283bdf149"], "node": "c5da88ae9228a92ae7b6a67c4103720ccb4a26c7", "parents": ["9dcb61c697911a6705c890791710c171331de795"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2050380 Test non cross-origin isolated shared memory clone error in AudioWorkletNodeOptions processorOptions r=baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312654\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-audioworklet-interface/audioworkletnode-constructor-no-coop-coep.https.html"], "git_node": "3ac2eb60dc998dd40aaa832b6538cdfb41952afd", "git_parents": ["a90268f2cd3c33e9fc19cb28eacc0bf367684d3c"], "node": "dba10c7ee6cf0a4306da232188c2c9fb477254d1", "parents": ["c5da88ae9228a92ae7b6a67c4103720ccb4a26c7"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 2006226 - Treat HEVC CRA and BLA as keyframes in MatroskaDemuxer. r=karlt,media-playback-reviewers\n\nMatroskaDemuxer::CheckKeyFrameByExamineByteStream used H265::IsKeyFrame,\nwhich only recognizes IDR (19, 20). Files encoded with open GOP\n(libx265 default) use CRA (21) for random access points after the first\nIDR, so seeking landed on a CRA frame flagged as non-keyframe. The\nreader then found no keyframe to decode from and hit premature EOS:\nvideo froze (audio continued when present, full stall for video-only).\n\nFix by adding H265::IsRandomAccessPoint (IDR/CRA/BLA, i.e. IRAP\n16-21), sharing the NALU scan loop with IsKeyFrame, and using it for\nHEVC in MatroskaDemuxer. Keep IDR-only on Apple platforms where\nVideoToolbox can only start from IDR, mirroring MP4Demuxer.\n\nAdd TEST(MatroskaDemuxer, SeekHEVC) with an open-GOP HEVC MKV\n(test_hevc_open_gop.mkv, mirroring test_hevc_open_gop.mp4): seek to\n2.0s and assert the first sample is a keyframe.\n\nVerified with the bug attachment fish.mkv and local HEVC MKV files:\nfirst sample after seek is now kf=true and playback continues.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323903\n", "files": ["dom/media/gtest/TestWebMDemuxer.cpp", "dom/media/gtest/moz.build", "dom/media/gtest/test_hevc_open_gop.mkv", "dom/media/platforms/agnostic/bytestreams/H265.cpp", "dom/media/platforms/agnostic/bytestreams/H265.h", "dom/media/webm/MatroskaDemuxer.cpp"], "git_node": "616da05287312036775f0e386ec1f22ad1b791fa", "git_parents": ["3ac2eb60dc998dd40aaa832b6538cdfb41952afd"], "node": "a1f5e8b29078a46bca6a6ca4b8cf31c7c2a2295d", "parents": ["dba10c7ee6cf0a4306da232188c2c9fb477254d1"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064934 -  Fix to save a PDF from a local PDF on Android r=android-reviewers,gmalekpour\n\nThe patch adjusts \"save as PDF\" to use the PDF viewer web response when on a PDF to recieve a `blob://` schema response.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326177\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt"], "git_node": "acd6a2204ce11e5d1a8f5908c9759599f726d2a3", "git_parents": ["616da05287312036775f0e386ec1f22ad1b791fa"], "node": "74c4f3066c001a0b3ec4ba659eb7c3a506437735", "parents": ["a1f5e8b29078a46bca6a6ca4b8cf31c7c2a2295d"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2071638 - Use moz-src for installerprefs r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325632\n", "files": ["browser/components/installerprefs/components.conf", "browser/components/installerprefs/moz.build", "browser/components/installerprefs/test/unit/head.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "945877a28df6e7460d1d74822e139cf30e0b042a", "git_parents": ["acd6a2204ce11e5d1a8f5908c9759599f726d2a3"], "node": "568bd5270dc406e1496d5fcee406fca461c14a72", "parents": ["74c4f3066c001a0b3ec4ba659eb7c3a506437735"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072049 - Update snappy to 1.3.0. r=dom-storage-reviewers,dom-worker-reviewers,edenchuang\n\nAlso adds a moz.yaml so future updates go through `./mach vendor other-licenses/snappy/moz.yaml` instead of\nthe manual README steps: it fetches the tagged release into src/, applies 01-explicit.patch and runs\nupdate-version.py to stamp the version into snappy-stubs-public.h and the SNAPPY_VERSION static_asserts in\ndom/. Re-vendoring 1.3.0 through it reproduces this tree byte for byte.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326031\n", "files": ["dom/cache/FileUtils.cpp", "dom/indexedDB/ActorsParentCommon.cpp", "dom/localstorage/SnappyUtils.cpp", "other-licenses/snappy/01-explicit.patch", "other-licenses/snappy/README", "other-licenses/snappy/moz.yaml", "other-licenses/snappy/snappy-stubs-public.h", "other-licenses/snappy/src/README.md", "other-licenses/snappy/src/format_description.txt", "other-licenses/snappy/src/snappy-c.cc", "other-licenses/snappy/src/snappy-c.h", "other-licenses/snappy/src/snappy-internal.h", "other-licenses/snappy/src/snappy-stubs-internal.h", "other-licenses/snappy/src/snappy-test.cc", "other-licenses/snappy/src/snappy.cc", "other-licenses/snappy/src/snappy.h", "other-licenses/snappy/src/snappy_unittest.cc", "other-licenses/snappy/update-version.py"], "git_node": "fe38e5a5246de5a14d83973d8a8423690e72a40b", "git_parents": ["945877a28df6e7460d1d74822e139cf30e0b042a"], "node": "5f88da032de4b687618e83d0ecba175b3b8e2dd3", "parents": ["568bd5270dc406e1496d5fcee406fca461c14a72"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071158 - Remove the unused colors parameter from the compose-base TextField. r=android-reviewers,007\n\nThe parameter was accepted and documented but never forwarded to OutlinedTextField, so anything passed to it\nwas silently ignored. No caller has ever passed it, and the wrapper exists to give every field the Acorn\nstyling, so drop it rather than start honoring per-call overrides.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325230\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/textfield/TextField.kt"], "git_node": "c54ed02c4705d3877c75ddbda7dde26e32f7225e", "git_parents": ["fe38e5a5246de5a14d83973d8a8423690e72a40b"], "node": "7e3c3a35015903d6b36f7876af3e49fe215f92a7", "parents": ["5f88da032de4b687618e83d0ecba175b3b8e2dd3"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2066620 - Ensure isKnownSuffix throws for invalid hostnames r=robwu\n\nThe `browser.publicSuffix.isKnownSuffix` extension API should throw when the\ngiven hostname is invalid, instead of returning false.\n\nSee https://github.com/w3c/webextensions/blob/main/proposals/public-suffix.md#4-invalid-hostname\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324917\n", "files": ["toolkit/components/extensions/child/ext-publicSuffix.js", "toolkit/components/extensions/test/xpcshell/test_ext_publicSuffix.js"], "git_node": "f131b78069bfa40208b44769feab6288d72d615c", "git_parents": ["c54ed02c4705d3877c75ddbda7dde26e32f7225e"], "node": "83fbfef2e78ce1a0c8068d4c98423df48beeb8c5", "parents": ["7e3c3a35015903d6b36f7876af3e49fe215f92a7"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060386 - Part 1 - Stand-up tab data coordinator module r=android-reviewers,jdelorenzo\n\nThis module intentionally does not depend upon `browser-state` as it's a very heavy module dependency when this module only actually needs a Flow of the `TabSessionState` data model. Instead, this module exposes the `TabRepository` interface, and Fenix will implement a  `DefaultTabRepository` that wraps `BrowserStore`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320592\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/tabdata-coordinator/README.md", "mobile/android/android-components/components/feature/tabdata-coordinator/build.gradle", "mobile/android/android-components/components/feature/tabdata-coordinator/lint-baseline.xml", "mobile/android/android-components/components/feature/tabdata-coordinator/proguard-rules.pro", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/AndroidManifest.xml", "taskcluster/config.yml"], "git_node": "c1ba016c045dbf07dcdf44f52c65c6b9f0e5cfbc", "git_parents": ["f131b78069bfa40208b44769feab6288d72d615c"], "node": "8a6433948099dd5a4078d653911da1c69d70c59b", "parents": ["83fbfef2e78ce1a0c8068d4c98423df48beeb8c5"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060386 - Part 2 - Move TabGroupRepository into feature-tabgroups-storage module r=android-reviewers,jdelorenzo\n\nStand up a new android-components module, feature-tabgroups-storage, and move\nthe tab group storage layer into it: TabGroupRepository and its Room database,\nentities, DAOs and data models, along with their tests and Room schemas.\n\nThe database, entities and DAOs stay internal to the new module, so consumers\nnow only depend on the TabGroupRepository abstraction and the TabGroup /\nTabGroupData models.\n\n`TabGroupDatabaseMigrationTest` is now a robolectric test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320593\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/tabgroups-storage/README.md", "mobile/android/android-components/components/feature/tabgroups-storage/build.gradle", "mobile/android/android-components/components/feature/tabgroups-storage/lint-baseline.xml", "mobile/android/android-components/components/feature/tabgroups-storage/proguard-rules.pro", "mobile/android/android-components/components/feature/tabgroups-storage/schemas/mozilla.components.feature.tabgroups.storage.database.TabGroupDatabase/1.json", "mobile/android/android-components/components/feature/tabgroups-storage/schemas/mozilla.components.feature.tabgroups.storage.database.TabGroupDatabase/2.json", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/AndroidManifest.xml", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/data/TabGroupData.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/data/TabGroupDataTransforms.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/database/StoredTabGroup.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/database/StoredTabGroupDao.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/database/StoredTabGroupWithAssignments.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/database/TabGroupAssignment.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/database/TabGroupAssignmentDao.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/database/TabGroupDatabase.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/database/TabGroupOperationsDao.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/repository/TabGroupRepository.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/test/java/mozilla/components/feature/tabgroups/storage/data/TabGroupDataTransformsTest.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/test/java/mozilla/components/feature/tabgroups/storage/database/TabGroupDatabaseMigrationTest.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/test/java/mozilla/components/feature/tabgroups/storage/repository/DefaultTabGroupRepositoryTest.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/tabgroups-storage/src/testFixtures/kotlin/mozilla/components/feature/tabgroups/storage/database/TabGroupDatabaseTestFixtures.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/testFixtures/kotlin/mozilla/components/feature/tabgroups/storage/repository/TabGroupRepositoryTestFixtures.kt", "mobile/android/fenix/.buildconfig.yml", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/schemas/org.mozilla.fenix.tabgroups.storage.database.TabGroupDatabase/1.json", "mobile/android/fenix/app/schemas/org.mozilla.fenix.tabgroups.storage.database.TabGroupDatabase/2.json", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/storage/database/TabGroupDatabaseMigrationTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/navigation/DebugDrawerRoute.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/tabs/TabGroupTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/ui/FenixOverlay.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/collections/migration/CollectionsToTabGroupsMigration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/fakes/FakeTabGroupRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/middleware/TabGroupMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/data/TabGroupData.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/data/TabGroupDataTransforms.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/StoredTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/StoredTabGroupDao.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/StoredTabGroupWithAssignments.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/TabGroupAssignment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/TabGroupAssignmentDao.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/TabGroupDatabase.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/TabGroupOperationsDao.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/redux/middleware/TabGroupMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/repository/TabGroupRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/collections/migration/CollectionsToTabGroupsMigrationIntegrationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/collections/migration/CollectionsToTabGroupsMigrationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/fixtures/FakeTabGroupRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/middleware/TabGroupMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/storage/DefaultTabGroupRepositoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/storage/data/TabGroupDataTransformsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt", "taskcluster/config.yml"], "git_node": "263328c99329921ac6282374e2ab2c6bdd723501", "git_parents": ["c1ba016c045dbf07dcdf44f52c65c6b9f0e5cfbc"], "node": "8d90b89b1dfc6169f74bb19476182565f9a45fd5", "parents": ["8a6433948099dd5a4078d653911da1c69d70c59b"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060386 - Part 3 - Stand up a tab data coordinator r=android-reviewers,jdelorenzo\n\nMove the tab data coordinator into the feature-tabdata-coordinator component:\nTabDataCoordinator and its DefaultTabDataCoordinator implementation, the\nTabRepository abstraction, and the Tab, TabGroup and TabsState models.\n\nThe component deliberately does not depend on browser-state. TabRepository is\ndeclared here but implemented by the embedder: TabRepository.Data carries the\ncomponent's own Tab model, and Fenix's DefaultTabRepository maps TabSessionState\nonto it. Group membership is not known to the repository, so the coordinator\nfills in Tab.tabGroupId from the tab group assignments.\n\n`TabGroup.theme` and the `isHomepageTab` check are delegated to the application layer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320594\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/tabdata-coordinator/README.md", "mobile/android/android-components/components/feature/tabdata-coordinator/build.gradle", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/TabDataCoordinator.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/data/Tab.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/data/TabGroup.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/data/TabsSnapshot.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/repository/TabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/DefaultTabDataCoordinatorTest.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabRepository.kt", "mobile/android/android-components/components/feature/tabgroups-storage/build.gradle", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/data/TabGroupData.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/data/TabGroupDataTransforms.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/mai