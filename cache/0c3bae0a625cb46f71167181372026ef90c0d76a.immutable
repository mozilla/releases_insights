ia/ffvpx/libavutil/vulkan.h", "media/ffvpx/libavutil/vulkan_functions.h", "media/ffvpx/libavutil/vulkan_loader.h", "media/ffvpx/libavutil/x86/asm.h", "media/ffvpx/libavutil/x86/crc.h", "media/ffvpx/libavutil/x86/emms.asm", "media/ffvpx/libavutil/x86/moz.build", "media/ffvpx/libavutil/x86/pixelutils.asm", "media/ffvpx/libavutil/x86/pixelutils.h", "media/ffvpx/libavutil/x86/tx_float.asm", "media/ffvpx/libavutil/x86/x86util.asm", "media/ffvpx/mediacodec_force_key_frames.patch", "media/ffvpx/vp8dsp-nasm-2.14-compat.patch", "media/ffvpx/vp9-get-format-rollback.patch"], "git_node": "5ae287c0d4d55b9d797a65cf391beb6104c02057", "git_parents": ["2ec2a95db2e346a11c352c739362d0505f7e2669"], "node": "a4a9bcbc1240bceacb8ffc7f9ab230958402d20c", "parents": ["12c51bbb267076a26cc5403ebd7acae04592b2af"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Load ffmpeg functions from correct library r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324524\n", "files": ["dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp"], "git_node": "8b41acb45348f13e5278112418d9e5c4ddc2a93a", "git_parents": ["5ae287c0d4d55b9d797a65cf391beb6104c02057"], "node": "aa9505032a12ed8e1250246bb7b419a42e4d5527", "parents": ["a4a9bcbc1240bceacb8ffc7f9ab230958402d20c"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Check av_hwframe_map() before use Vulkan direct mapping r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324525\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "3a31f84c1e7d3447b9ad7fb0cebdf6662829ba6d", "git_parents": ["8b41acb45348f13e5278112418d9e5c4ddc2a93a"], "node": "92b12f854ef8d4005b8479225e77757ba521df68", "parents": ["aa9505032a12ed8e1250246bb7b419a42e4d5527"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Add ffvpx symbol export test r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324526\n", "files": ["docs/code-quality/lint/linters/ffvpx-symbols.md", "tools/lint/ffvpx-symbols.yml", "tools/lint/ffvpx-symbols/__init__.py", "tools/lint/test/python.toml", "tools/lint/test/test_ffvpx_symbols.py"], "git_node": "15999c422d212a0c31bb106f6c867a27658a6255", "git_parents": ["3a31f84c1e7d3447b9ad7fb0cebdf6662829ba6d"], "node": "daf9713db6530d84a68ed9df93e7fe9251e407f3", "parents": ["92b12f854ef8d4005b8479225e77757ba521df68"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2064227: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "894aeef4be1b6e07bd649eed77ae4d920f4369e1", "git_parents": ["15999c422d212a0c31bb106f6c867a27658a6255"], "node": "65109234b2e6eefc545b8468b4bc307521e6c15d", "parents": ["daf9713db6530d84a68ed9df93e7fe9251e407f3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072107 - Center narrow Mermaid diagrams horizontally within the page. r=firefox-source-docs-reviewers,sylvestre\n\nThe page section documents the intrinsic size from bug 2071258 and the scroll fade from bug 2071267 as well, which landed undocumented.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326078\n", "files": ["docs/_static/custom_theme.css", "tools/moztreedocs/docs/mermaid-integration.md"], "git_node": "1a9163e47b88049d9f0ebbc5c559a3fc2f6c2162", "git_parents": ["894aeef4be1b6e07bd649eed77ae4d920f4369e1"], "node": "eccb8a700361b0a68f0f41089e02b7aa74382c9b", "parents": ["65109234b2e6eefc545b8468b4bc307521e6c15d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060887 - Deal with mozPrintCallback in OOP iframes. r=gfx-reviewers,lsalzman\n\nFactor the mozPrintCallback code from nsPageSequenceFrame into a\nhopefully-not-too-ugly helper (MozPrintCallbackRunner).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325971\n", "files": ["dom/ipc/WindowGlobalChild.cpp", "layout/generic/MozPrintCallbackRunner.cpp", "layout/generic/MozPrintCallbackRunner.h", "layout/generic/moz.build", "layout/generic/nsHTMLCanvasFrame.cpp", "layout/generic/nsPageSequenceFrame.cpp", "layout/generic/nsPageSequenceFrame.h", "layout/printing/nsPrintJob.cpp", "layout/printing/nsPrintJob.h", "testing/web-platform/mozilla/tests/dom/mozPrintCallback/mozPrintCallback-oop-iframe-001-print-ref.html", "testing/web-platform/mozilla/tests/dom/mozPrintCallback/mozPrintCallback-oop-iframe-001-print.sub.html", "testing/web-platform/mozilla/tests/dom/mozPrintCallback/support/mozPrintCallback-oop-iframe-frame.html"], "git_node": "6490a99c0648ce5d72b69aa26d844c9baad7246c", "git_parents": ["1a9163e47b88049d9f0ebbc5c559a3fc2f6c2162"], "node": "179da3c20d839c7b14a965ec6080ab6e6322fe3c", "parents": ["eccb8a700361b0a68f0f41089e02b7aa74382c9b"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 1990135 - Ensure exceptions are serialized as ByteArray to support Throwables that are Parcelable like ForegroundServiceStartNotAllowedException r=android-reviewers,pollymce,crashreporting-reviewers\n\nThe previous implementation writes throwables as `Serializable` but the Android OS treats them as `Parcelable` if they implement the interface. So, exceptions that are both Parcelable and Serializable automaticaly get treated as Parcelable.\n\nWhen the exceptions are sent across processes through the intent, they don't reference the same object, and so the system would have to parcel and unparcel it. The process of parcing ForegroundServiceStartNotAllowedException ends up calling Throwable's `fillInStackTrace()`. That then causes the restored exception to contain the stack frame of \"where we are restoring\" it.\n\nThis commit ensures that we write them to ByteArray using our existing serialize() and deserialize() functions\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323209\n", "files": ["mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/Crash.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/ThrowableSerializationExt.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/db/CrashEntity.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/CrashTest.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/UncaughtExceptionCrashTest.kt"], "git_node": "50d29db827816e2d15bd14aec1cfb9975df23ef1", "git_parents": ["6490a99c0648ce5d72b69aa26d844c9baad7246c"], "node": "c6f27574c7bd9a630819055391e1843acbc5c756", "parents": ["179da3c20d839c7b14a965ec6080ab6e6322fe3c"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2071725 [Wayland] Factor out nsMenuPopupFrame::FlipAnchorForRTL() and use it for WaylandPopupGetPositionFromLayout() r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325857\n", "files": ["layout/xul/nsMenuPopupFrame.cpp", "layout/xul/nsMenuPopupFrame.h", "widget/gtk/nsWindowWayland.cpp"], "git_node": "0c6e6ebf1568bf2d1aa66bed827b3fd6c2e7f3dc", "git_parents": ["50d29db827816e2d15bd14aec1cfb9975df23ef1"], "node": "325325c67ab680962bb362a2e8ad55d2cd11b9d6", "parents": ["c6f27574c7bd9a630819055391e1843acbc5c756"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062308 - Part 1: Fix smartbar submission when suggestions view is closed r=urlbar-reviewers,jlewis,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318695\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_ask.js", "browser/components/multilineeditor/multiline-editor.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildTelemetry.mjs"], "git_node": "81b4eedf82c6cce0db69bf630b896108bf39f327", "git_parents": ["0c6e6ebf1568bf2d1aa66bed827b3fd6c2e7f3dc"], "node": "d1b8b15be6d1e9474f8f83cd9ae2e955b9b789ac", "parents": ["325325c67ab680962bb362a2e8ad55d2cd11b9d6"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062308 - Part 2: Fix smartbar submission when suggestions view is closed r=jlewis\n\nHide the smart cursor for smartbar selection and add a pref for the display debounce value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324914\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_shortcuts.js", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "25cd7fc4daa31f35d4bc006f9ae100f048000590", "git_parents": ["81b4eedf82c6cce0db69bf630b896108bf39f327"], "node": "c33e7755d16fc3ade7390cf7453fa9cde2470366", "parents": ["d1b8b15be6d1e9474f8f83cd9ae2e955b9b789ac"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054470 - Create NavigationEvent to handle view-level navigations and fix MenuDialogMiddleware memory leaks r=android-reviewers,marcin\n\nMenuDialogMiddleware and MenuDialogNavigationMiddleware had callback references which are captured by the enclosing MenuDialogFragment. This meant that whenever the request to add-ons did not complete before the menu was closed, then we would end up having those references retained until the requested completed or failed, and causing a memory leak.\n\nThe solution is to create a NavigationEvent - that is emitted via the store reference, and collected in the fragment.\n\nThis is not a widely adopted pattern in the project, but it exists in the WebCompatReporterStore. I believe this is how we should handle \"effects\" such as navigations that require a reference to the enclosing \"view-level\" components (fragments, activities, composables, etc)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325661\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuDialogMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/NavigationEvent.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuDialogMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuNavigationMiddlewareTest.kt"], "git_node": "890cd5bd4ee6f82e960b18db4c358da826677d01", "git_parents": ["25cd7fc4daa31f35d4bc006f9ae100f048000590"], "node": "46e2f4803f13a78cecbc0db1717a361fc470a97c", "parents": ["c33e7755d16fc3ade7390cf7453fa9cde2470366"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031498 - Fix accounts UI showing up as signed out when we have not yet loaded the profile r=android-reviewers,jonalmeida\n\nThe Accounts UI was not shown when Firefox Accounts authentication succeeded but the profile was not available yet. This patch marks the Sync account state as authenticated as soon as onAuthenticated is observed, even if profile/account is not yet loaded. Whenever profile is updated, then the account is updated too.Profile data is then populated updated, then the account is updated.\n\nThis patch also refreshes profile every time an explicit \"sync now\" action is received - this helps us meet th euser expectation of sync now fixing whatever \"stuck\" state the account is in. This is also the only surface where it looks like the user can force refresh some account state\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325779\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/store/SyncStoreSupport.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/store/SyncStoreSupportTest.kt"], "git_node": "ad9dda293b8853e437dfe65cbad5b6ec8217ce18", "git_parents": ["890cd5bd4ee6f82e960b18db4c358da826677d01"], "node": "bb9bd6250adbf4d3caedc6b83853a9a77d4dfbc0", "parents": ["46e2f4803f13a78cecbc0db1717a361fc470a97c"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065320 - Enable YouTube transcript extraction in PageExtractor by default r=ai-platform-reviewers,jbowser\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326012\n", "files": ["modules/libpref/init/all.js", "toolkit/components/pageextractor/YouTubeExtraction.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_youtube_extraction.js"], "git_node": "6142708b39c6af13596c99477c413f2941cc8c92", "git_parents": ["ad9dda293b8853e437dfe65cbad5b6ec8217ce18"], "node": "c68e16605ee0627f4ee9d3b204e116d8a44ec427", "parents": ["bb9bd6250adbf4d3caedc6b83853a9a77d4dfbc0"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062047 - Latent correctness and hardening cleanups r=dmehic\n\nUpdate links to use firefox-main;\nRender footnotes once at the end instead of per-table;\nStrip only the comment marker instead of eating leading '#' in comment text;\nStop a neighboring pref's #ifdef/#endif line leaking into a comment;\nValidate OTHER_PRIVACY_PREFS pref names too, across all pref sources:\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325853\n", "files": ["docs/_addons/etp_matrix.py"], "git_node": "2b91f6608e884fa8197f9f239f4e4ed478ccf7ce", "git_parents": ["6142708b39c6af13596c99477c413f2941cc8c92"], "node": "d2adbd58ef72e7909aaf2fdf66f27dd9b616130d", "parents": ["c68e16605ee0627f4ee9d3b204e116d8a44ec427"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071618 - Disable tab-to-search from the urlbar unit manifest instead of testEngine_setup. r=mak,urlbar-reviewers\n\ntest_trimming.js and test_autofill_functional.js have their own add_setup and never called testEngine_setup, so they kept counting the MDN row.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326106\n", "files": ["browser/components/urlbar/tests/unit/head.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "c35e3061b76a1743d6eb1b3db64558beb0587f2e", "git_parents": ["2b91f6608e884fa8197f9f239f4e4ed478ccf7ce"], "node": "39d888168b00873c676e85b151f135079e6a8d5c", "parents": ["d2adbd58ef72e7909aaf2fdf66f27dd9b616130d"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Wire up AA for primitives that have the ANTIALIASING flag. r=gfx-reviewers,lsalzman\n\nThis used to work and got lost at some point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310361\n", "files": ["gfx/wr/webrender/src/scene_building.rs"], "git_node": "83d1c3e17ea10740fe03197bc09566104ffe539b", "git_parents": ["c35e3061b76a1743d6eb1b3db64558beb0587f