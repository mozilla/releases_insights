8f7f1c22267300026", "git_parents": ["3b87acb3429a51440ae4bf939e78a8ab1f047f71"], "node": "7765ee98ac1b204e0b40c9a6c85bada5b4ee1dd8", "parents": ["47ac13122026d100ca09f43748a1f37aba6610c4"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2049797 - Keep unknown live stream durations infinite until the download ends. r=media-playback-reviewers,alwu\n\nSince bug 2035059 the MP3 and ADTS demuxers no longer report Infinity as\nthe metadata duration, so the estimate BufferedRangeUpdated derives from\nbuffered ranges became the duration of live streams.\n\nSkip that estimate while the resource length is unknown, refresh it when\nthe download completes, treat non-HTTP resources with a known content\nlength as bounded, and keep seekable limited to the buffered ranges while\nthe duration is unknown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326347\n", "files": ["dom/media/ChannelMediaDecoder.cpp", "dom/media/ChannelMediaResource.cpp", "dom/media/MediaDecoder.cpp", "dom/media/MediaDecoderStateMachine.cpp", "dom/media/MediaDecoderStateMachineBase.cpp", "dom/media/test/live_duration.sjs", "dom/media/test/mochitest.toml", "dom/media/test/test_live_duration.html"], "git_node": "d0302089a3bc9c48e4f50c85c702c0e047b60668", "git_parents": ["b1ee20bc29051ac7a41a5358f7f1c22267300026"], "node": "10155d93b17a1c952e720fe89d54654fa0605810", "parents": ["7765ee98ac1b204e0b40c9a6c85bada5b4ee1dd8"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072146 - [devtools] add pref and toggle settings panel redesign r=devtools-reviewers,nchevobbe,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326127\n", "files": ["browser/app/profile/firefox.js", "devtools/client/definitions.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_settings_redesign_enabled.js", "devtools/client/jar.mn", "devtools/client/locales-preview/settings.ftl", "devtools/client/locales/jar.mn", "devtools/client/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/moz.build", "devtools/client/settings/panel.js"], "git_node": "af49390bed7672aecfa8930b106e8071076dc8e3", "git_parents": ["d0302089a3bc9c48e4f50c85c702c0e047b60668"], "node": "d0fc6089cad7ac18210e9a78f36e9a3d4f9e4015", "parents": ["10155d93b17a1c952e720fe89d54654fa0605810"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072216 - [devtools] Add type checking to new settings panel r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326155\n", "files": ["devtools/client/settings/panel.js", "devtools/client/settings/tsconfig.json", "eslint-rollouts.config.mjs", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/typescript.yml"], "git_node": "31d19efa54330e9718b4c4dcb9abec1c44394624", "git_parents": ["af49390bed7672aecfa8930b106e8071076dc8e3"], "node": "99f49047dc61bfc4e513d191a2e8a40717646810", "parents": ["d0fc6089cad7ac18210e9a78f36e9a3d4f9e4015"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064873 - Add the metadata and controls to the playback notification r=android-reviewers,android-l10n-reviewers,matt-tighe,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327852\n", "files": ["mobile/android/android-components/components/feature/listentopage/build.gradle", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionServiceTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenPlayerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/PlaybackControllerTest.kt"], "git_node": "777197de94997705c6092a46d570114b33ef9222", "git_parents": ["31d19efa54330e9718b4c4dcb9abec1c44394624"], "node": "14262544a455dc3d763c51be413e0967da679fe2", "parents": ["99f49047dc61bfc4e513d191a2e8a40717646810"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2036862 - Make sure to use a fresh connection for each captive portal check r=necko-reviewers,sunil\n\nIf the interception is only achieved via DNS, and the captive portal does not forward traffic when\nunlocked, we might think the captive portal is still locked because we're reusing the connection\nwe obtained before logging in.\n\nThis patch adds LOAD_FRESH_CONNECTION + LOAD_INITIAL_DOCUMENT_URI to the CP detector\nso that we always use a new connection and refresh DNS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327801\n", "files": ["toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/t