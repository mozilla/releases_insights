7aee53133eeb0"], "node": "b391d198db07925f1ceb528030a6f5cca2b979a5", "parents": ["1d7a5c49ddb3b6b1c8416aabcf91aa24d1cf83e0"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072680 - Support GetBBox options for tspan/textPath bounding boxes r=firefox-svg-reviewers,dholbert\" for causing build bustages\n\nThis reverts commit 97809a49ba6d043feb84985f8d73b6441c1a4694.\n", "files": ["dom/svg/SVGGraphicsElement.cpp", "layout/svg/SVGTextFrame.cpp", "layout/svg/SVGTextFrame.h", "layout/svg/SVGUtils.cpp", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-05.html"], "git_node": "7c962ff151a3af23383fcd697e554b237c7b98dc", "git_parents": ["b704fc7f30cc52dc441ed6cc6d83230295a08230"], "node": "c71f5ffdd5880ca02080d0e982e6326e315d1e0a", "parents": ["b391d198db07925f1ceb528030a6f5cca2b979a5"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066543 - VoiceOver support for About Firefox \u003e Share Firefox link r=nbarrett\" for causing bc failures @ browser_aboutDialog_referrals.js\n\nThis reverts commit fd745237b84b0324665112898754a0c49efd76ed.\n", "files": ["browser/base/content/aboutDialog.js", "browser/base/content/test/about/browser_aboutDialog_referrals.js"], "git_node": "42e583b42580c5201fc031f5e234540a490e4342", "git_parents": ["7c962ff151a3af23383fcd697e554b237c7b98dc"], "node": "2d07178fc5da84e176bc9140b78ffe8d54d08eaf", "parents": ["c71f5ffdd5880ca02080d0e982e6326e315d1e0a"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2019461: Test cases for DTLS restart. r=mjf\n\nFixes bug in existing test-cases that attempt a DTLS restart without an\nICE restart. Adds some more demanding tests too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325135\n", "files": ["testing/web-platform/meta/webrtc/protocol/handover-datachannel.html.ini", "testing/web-platform/meta/webrtc/protocol/handover.html.ini", "testing/web-platform/tests/webrtc/protocol/fingerprint-change-requires-ice-restart.html", "testing/web-platform/tests/webrtc/protocol/handover-datachannel.html", "testing/web-platform/tests/webrtc/protocol/handover-failure.html", "testing/web-platform/tests/webrtc/protocol/handover-media.html", "testing/web-platform/tests/webrtc/protocol/handover-torture.html", "testing/web-platform/tests/webrtc/protocol/handover.html"], "git_node": "6c497ba28906e61acc0edb0914cba3894386b095", "git_parents": ["42e583b42580c5201fc031f5e234540a490e4342"], "node": "1fe234bbc453add35e591915b04fba0bc7f8ffec", "parents": ["2d07178fc5da84e176bc9140b78ffe8d54d08eaf"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2019461: Create MediaPacket before firing signals. r=mjf\n\nSubsequent patch has to do fanout to multiple TransportFlows before\ncreating the MediaPacket, so we move that MediaPacket creation earlier\nto avoid needing to do it more than once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325136\n", "files": ["dom/media/webrtc/transport/nricectx.cpp", "dom/media/webrtc/transport/nricemediastream.cpp", "dom/media/webrtc/transport/nricemediastream.h", "dom/media/webrtc/transport/test/ice_unittest.cpp", "dom/media/webrtc/transport/transportlayerice.cpp", "dom/media/webrtc/transport/transportlayerice.h"], "git_node": "95a3fcbb0ace25ad1f3275bd7c1c8ff2856391be", "git_parents": ["6c497ba28906e61acc0edb0914cba3894386b095"], "node": "ba5c1f0ac05a96d093ebdc9322f9eb3ce1dc190e", "parents": ["1fe234bbc453add35e591915b04fba0bc7f8ffec"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2019461: Implement DTLS restart. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325137\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/sdp/SdpAttribute.h", "dom/media/webrtc/sdp/SdpHelper.cpp", "dom/media/webrtc/sdp/SdpHelper.h", "dom/media/webrtc/transport/nricemediastream.cpp", "dom/media/webrtc/transport/nricemediastream.h", "dom/media/webrtc/transport/test/ice_unittest.cpp", "dom/media/webrtc/transport/transportlayerice.cpp", "dom/media/webrtc/transport/transportlayerice.h"], "git_node": "5c83911a80819842e851de99b1e0cf7db575b81c", "git_parents": ["95a3fcbb0ace25ad1f3275bd7c1c8ff2856391be"], "node": "a1a92359d6fb6182fdb1b28b25a94833bcf1a936", "parents": ["ba5c1f0ac05a96d093ebdc9322f9eb3ce1dc190e"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2072410: Work around bug 2063569. r=pehrsons\n\n(That bug's title is \"web platform tests executed on macOS AArch64\nshippable use processor 'x86_64'\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326346\n", "files": ["testing/web-platform/mozilla/meta/webrtc/mdns-candidate-obfuscation.html.ini"], "git_node": "061191b9d32d1a0ffa06c692d9a76300de9170e0", "git_parents": ["5c83911a80819842e851de99b1e0cf7db575b81c"], "node": "6aa08b4e45cb6ed63a4156b48ea19444aaaed4bd", "parents": ["a1a92359d6fb6182fdb1b28b25a94833bcf1a936"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050421: Add type primary to Summarize button in the Chatbot sidebar r=mlucks\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326538\n", "files": ["browser/components/genai/chat.html"], "git_node": "12ac7f9b186997314ebfcf51b751f5627e51a03a", "git_parents": ["061191b9d32d1a0ffa06c692d9a76300de9170e0"], "node": "41491941a860a1371a45eb15259158a8bac3f058", "parents": ["6aa08b4e45cb6ed63a4156b48ea19444aaaed4bd"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2040977 - Add a ClearOnShutdown policy. r=jmendez,fluent-reviewers,bolsson\n\nSanitizeOnShutdown's object members were written against the old Clear History\ndialog. Shutdown only reads privacy.clearOnShutdown_v2.*, so Downloads, Sessions\nand OfflineApps now write prefs nothing looks at.\n\nClearOnShutdown has one member per category the dialog actually offers, mapped\n1:1 to the pref behind it. Naming a category enforces it and anything left out\nstays the user's, so the categories an admin does not care about remain\neditable. As a boolean it enforces all of them, or none of them for false.\n\nThere is no Locked. An unlocked pref loses to any user value, and Sanitizer's\nmigration gives every profile a user value for all five of these, so a default\nalone would be a policy that quietly does nothing. Chrome's\nClearBrowsingDataOnExitList is mandatory only for the same reason.\n\nSanitizeOnShutdown is unchanged, so existing configurations keep working. When\nboth are set ClearOnShutdown wins and the old one logs an error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321674\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_clear_on_shutdown.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": "ffed44266f0366911e8db3ee5ebde48bb18b5604", "git_parents": ["12ac7f9b186997314ebfcf51b751f5627e51a03a"], "node": "0085a3d23b9fb1a2ddf9964201e1f039b6a5aa4e", "parents": ["41491941a860a1371a45eb15259158a8bac3f058"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072263 - Remove unnecessary Metrics& params from gfxFont::InitMetrics... methods. r=gfx-reviewers,lsalzman\n\nAll these methods are operating on the font instance's mMetrics field, so there's\nno need to pass around a reference to it.\n\n(This pattern is a leftover from when some subclasses allocated their Metrics\nrecord differently, but now it's just redundant.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326212\n", "files": ["gfx/thebes/gfxDWriteFonts.cpp", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxMacFont.cpp"], "git_node": "42646bb7816aeb9bfa1fd7dfc303480df4ee9334", "git_parents": ["ffed44266f0366911e8db3ee5ebde48bb18b5604"], "node": "edd0b637d571dc2f0049e9cc9be8917cb8815c5b", "parents": ["0085a3d23b9fb1a2ddf9964201e1f039b6a5aa4e"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2072652 - Fix perma failure on random-computed.tentative.html by adding required prefs. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326581\n", "files": ["testing/web-platform/meta/css/css-values/random-computed.tentative.html.ini"], "git_node": "3ab773eccec788ed9adee1cd59ce8e321dc4e2b6", "git_parents": ["42646bb7816aeb9bfa1fd7dfc303480df4ee9334"], "node": "28ebaad0c8d2ea125dc6771d2f40f4507acb0fa9", "parents": ["edd0b637d571dc2f0049e9cc9be8917cb8815c5b"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2065571 - DisableLaunchOnLogin policy description, compat notes. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326104\n", "files": ["browser/components/enterprisepolicies/docs/index.md", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/schemas/policies-schema.meta.json", "browser/components/enterprisepolicies/tests/xpcshell/test_policies_schema.js"], "git_node": "6f6a8475297b59c6faa01c4fb3e356b4aacd8f7d", "git_parents": ["3ab773eccec788ed9adee1cd59ce8e321dc4e2b6"], "node": "71aeaa13932458ab217c91b07c4d5511f72e9e9f", "parents": ["28ebaad0c8d2ea125dc6771d2f40f4507acb0fa9"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937556 - Remove reftest-wait even when getDisplayMedia() rejects. r=bwc\n\nThese screen capture crashtests await navigator.mediaDevices.getDisplayMedia()\non a path where a rejected promise skips calling removeAttribute(\"class\").\nIn the rejection case, the reftest-wait is never cleared causing the test to hit\nthe 300s reftest timeout instead of completing.  Currently unknown is why\ngetDisplayMedia() seems to intermittently reject with NotAllowedError for an\nentire browser session when on macosx1500-aarch64 workers.  When that happens,\nit makes all three tests time out in the same run.\n\nWrap each test body in try/finally, as 1991492_1.html already does so a\nrejected getDisplayMedia() doesn't cause a timeout.\n\nAlso fixes bug 2055128 (1991492_2.html) and the same hang in 1991494.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326590\n", "files": ["dom/media/tests/crashtests/1920264.html", "dom/media/webrtc/tests/crashtests/1991492_2.html", "dom/media/webrtc/tests/crashtests/1991494.html"], "git_node": "01965425958b4df7a1eaefb510bc63270cf73fa7", "git_parents": ["6f6a8475297b59c6faa01c4fb3e356b4aacd8f7d"], "node": "5633372d676cbd420274ae317ab106c5d9118953", "parents": ["71aeaa13932458ab217c91b07c4d5511f72e9e9f"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061792 - Gate CVV storage on a rollout pref as well as the user's choice. r=dimi\n\nPer review, split the single extensions.formautofill.creditCards.cvv.enabled\npref into the pair the addresses feature already uses: creditCards.cvv.supported\nsays whether the feature has been rolled out to this user, and\ncreditCards.cvv.enabled stays as the user's own choice, defaulting on the way\naddresses.enabled does. The supported pref takes the same \"on\"/\"off\" values as\nthe other supported prefs, so isAutofillCreditCardCVVSupported reads the string\nand hands callers a boolean.\n\nRather than make every caller test both, isAutofillCreditCardCVVEnabled now\ncomposes the two, the way isAutofillTypeEnabled composes isAutofillTypeAvailable\nwith a type's enabled pref. Storage and the existing callers are unchanged and\nsimply get the tighter meaning. isAutofillCreditCardCVVSupported is exposed\nseparately for UI that differs purely by whether the feature has shipped, such\nas whether to offer the setting that turns capture on or off at all.\n\nThe rollout pref is driven by a new creditcards-cvv-capture Nimbus feature,\nalongside creditcards-autofill-enabled. Only the rollout half is exposed;\nwhether a user wants their security codes captured is their own choice, and\nsetting it from an experiment would override that, so it is left out on purpose.\n\ntest_creditCardCVVPrefs.js covers the truth table directly: security codes are\nonly offered when the rollout says \"on\" and the user has not declined, and any\nother supported value (there is no regional \"detect\" for this feature) counts\nas not rolled out. The existing CVV tests roll the feature out for themselves. The patches that\nfollow it in this stack cover a user who is not in the rollout yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324813\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/unit/test_creditCardCVVPrefs.js", "browser/extensions/formautofill/test/unit/xpcshell.toml", "modules/libpref/init/all.js", "toolkit/components/formautofill/FormAutofill.sys.mjs", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "96b347da7dedb01e9895fe7a2451e7b16fe8d54e", "git_parents": ["01965425958b4df7a1eaefb510bc63270cf73fa7"], "node": "4d4655cad825c14b2c586febb1bdcb430230285d", "parents": ["5633372d676cbd420274ae317ab106c5d9118953"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061792 - Capture the security code with the rest of the card when CVV capture is enabled. r=dimi\n\nBefore the capture and update doorhangers can say anything about a security\ncode, something has to answer whether one came with the submitted form.\n\ncreateRecord() stops dropping cc-csc unconditionally and gates it on the CVV\nprefs instead, the same way shouldAutofillField() gates autofilling it. So a\nsubmitted code is simply part of the record, and the doorhanger reads it from\nthere: CreditCardSaveDoorhanger.hasSubmittedSecurityCode is\n`!!this.newRecord[\"cc-csc\"]`, and CreditCardUpdateDoorhanger inherits it.\nNothing renders it yet; Bug 2067943 adds the doorhanger copy.\n\nA form that asks for a code but is submitted without one records the empty\nstring, like every other empty field, so it reports no security code.\n\ncc-csc is still absent from VALID_CREDIT_CARD_FIELDS, so it round trips as an\nunknown field, exactly as the saved-code indication added by Bug 2061790\nexpects to find it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322482\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillSection.sys.mjs"], "git_node": "0e32bf225fb78836e5ca1f5d35d29dc463c16221", "git_parents": ["96b347da7dedb01e9895fe7a2451e7b16fe8d54e"], "node": "12b993ec349aba4292d1724ab3e353b52c8b0a89", "parents": ["4d4655cad825c14b2c586febb1bdcb430230285d"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072425: Propagate regexp interrupt termination immediately r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326348\n", "files": ["js/src/jit-test/tests/regexp/bug2072425.js", "js/src/vm/RegExpObject.cpp"], "git_node": "d259a241a7ede566e91a8d8732fecebd792da52e", "git_parents": ["0e32bf225fb78836e5ca1f5d35d29dc463c16221"], "node": "82333bc598c616e1d6ca3a1aba29d8583e6d538e", "parents": ["12b993ec349aba4292d1724ab3e353b52c8b0a89"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070953 - Add suggestion_id to the fx-suggest ping for Offline Suggest r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325460\n", "files": ["mobile/android/android-components/components/feature/fxsuggest/src/main/java/mozilla/components/feature/fxsuggest/FxSuggestSuggestionProvider.kt", "mobile/android/android-components/components/feature/fxsuggest/src/test/java/mozilla/components/feature/fxsuggest/FxSuggestFactsMiddlewareTest.kt", "mobile/android/android-components/components/feature/fxsuggest/src/test/java/mozilla/components/feature/fxsuggest/FxSuggestFactsTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/MetricController.kt"], "git_node": "39cd8026d1a76800c162d07b847ff4564df30298", "git_parents": ["d259a241a7ede566e91a8d8732fecebd792da52e"], "node": "24e45c47ad7690fe0b9160a8fe53a3035273baff", "parents": ["82333bc598c616e1d6ca3a1aba29d8583e6d538e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2049069 - Look at innermost URL to determine view-source flags r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326502\n", "files": ["browser/components/extensions/test/browser/browser_ext_tabs_create_invalid_url.js", "netwerk/protocol/viewsource/nsViewSourceHandler.cpp"], "git_node": "4d5fb902acb32890daaf1b674f6ce9277c4fea31", "git_parents": ["39cd8026d1a76800c162d07b847ff4564df30298"], "node": "b606af2b1dd624e7c0451b5c8e88d12c64fa6d61", "parents": ["24e45c47ad7690fe0b9160a8fe53a3035273baff"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072535 - Update test expectations. r=gfx-reviewers,lsalzman\" for causing reftest assertion failures LayersTypes.cpp\n\nThis reverts commit a5639339a8df8862403781b270b9554c00346bba.\n\nRevert \"Bug 2072535 - Enable Metal ANGLE for WebGL on Nightly. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit b6e0f6d72cbbb5e277ef4ba00231d58536bbc684.\n\nRevert \"Bug 2072535 - Update test_renderer_strings's KNOWN_ON_CI strings for Metal ANGLE. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit e0cb3fb487b82ceddbbd0f0abaf3b43eb8740843.\n", "files": ["dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/canvas/test/webgl-mochitest/test_renderer_strings.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "522415928bec8dc39de3f15e6fea2ceb0391d0a9", "git_parents": ["4d5fb902acb32890daaf1b674f6ce9277c4fea31"], "node": "22c6024900c40e7348a4caf2319733d5e1da6f05", "parents": ["b606af2b1dd624e7c0451b5c8e88d12c64fa6d61"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071837 - Add test coverage for the addresses.storage.rust.enabled pref r=joschmidt,credential-management-reviewers\" for causing bc failures @ browser_autofill_address_name.js & browser_address_migration.js\n\nThis reverts commit 94680093d2357a635eb94a256270f258a431d20e.\n", "files": ["browser/extensions/formautofill/moz.build", "browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_address_migration.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/browser/rust/browser.toml", "browser/extensions/formautofill/test/browser/rust/browser_address_migration.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_housenumber.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_level.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_name.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_select.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_select_inexact.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_select_match_isoid.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_textarea.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_duplicate_fields.js", "browser/extensions/formautofill/test/browser/rust/browser_clearPopulatedForm.js", "browser/extensions/formautofill/test/browser/rust/browser_editAddressDialog.js", "browser/extensions/formautofill/test/browser/rust/browser_fillclear_events.js", "browser/extensions/formautofill/test/browser/rust/browser_manageAddressesDialog.js", "browser/extensions/formautofill/test/browser/rust/browser_previewFormFields.js", "browser/extensions/formautofill/test/browser/rust/head.js", "browser/extensions/formautofill/test/unit/head.js", "browser/extensions/formautofill/test/unit/xpcshell_rust.toml"], "git_node": "4bb3cb2c5b49947050e936da3606558625df2c87", "git_parents": ["522415928bec8dc39de3f15e6fea2ceb0391d0a9"], "node": "d0cb2c35ec74eb924b504b2aca515903a208788a", "parents": ["22c6024900c40e7348a4caf2319733d5e1da6f05"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072425: Propagate regexp interrupt termination immediately r=spidermonkey-reviewers,jandem\" for causing assertion failures @ RegExpObject.cpp\n\nThis reverts commit d259a241a7ede566e91a8d8732fecebd792da52e.\n", "files": ["js/src/jit-test/tests/regexp/bug2072425.js", "js/src/vm/RegExpObject.cpp"], "git_node": "53c633eb20dd05e4e1d64570da313ab8abbe933a", "git_parents": ["4bb3cb2c5b49947050e936da3606558625df2c87"], "node": "af6c216d1bd2a996584c0758f0ae5d919022acc4", "parents": ["d0cb2c35ec74eb924b504b2aca515903a208788a"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058785 - Gate HLS resource and demuxer callbacks on the GeckoHlsPlayer monitor. r=media-playback-reviewers,geckoview-reviewers,padenot,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323792\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoHlsPlayer.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/HttpChannelDataSource.java"], "git_node": "fa027452d15289f72f832e72748931251f2dba6d", "git_parents": ["53c633eb20dd05e4e1d64570da313ab8abbe933a"], "node": "2b571a713e19b8da0063dff0e199907e18cbeb50", "parents": ["af6c216d1bd2a996584c0758f0ae5d919022acc4"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2028727 - Use strong ref for animation mutation observer batch targets. r=layout-reviewers,emilio\n\nWe can control the scope of AnimationMutationBatch for each animation\nfunctions. However, it is tedious, so we use nsCOMPtr to hold the\ntargets instead.\n\nThis is a devtool feature (ChromeOnly) so it shouldn't have much impact\non the performance for the common usage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326341\n", "files": ["dom/base/nsDOMMutationObserver.h"], "git_node": "a06b9ac67b35b73724b122664c149d300efc78a8", "git_parents": ["fa027452d15289f72f832e72748931251f2dba6d"], "node": "82f55fc58e76e2b7d2bb42d2d4e956393ae104f8", "parents": ["2b571a713e19b8da0063dff0e199907e18cbeb50"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2055392 - Noise channel implementation for caBLE r=jschanck\n\nThis provides a minimal CTAP caBLE/Hybrid channel implementation, intended\nfor communication with authenticators in the post-Noise-handshake phase of\nthe connection.\n\nThe channel object is exposed over XPCOM for integration and use by the\nFirefox WebAuthn stack from the browser's chrome.  It isn't intended for use\nin a web context.\n\nThe handshake part of the protocol will be implemented in a later change.\n\nReferences:\n\n* Noise CipherState object: https://noiseprotocol.org/noise.html#the-cipherstate-object\n\n* CTAP 2.3 Hybrid transports:\n  https://fidoalliance.org/specs/fido-v2.3-ps-20260226/fido-client-to-authenticator-protocol-v2.3-ps-20260226.html#sctn-hybrid\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313129\n", "files": ["Cargo.lock", "security/manager/ssl/components.conf", "security/manager/ssl/moz.build", "security/manager/ssl/noise/Cargo.toml", "security/manager/ssl/noise/gtest/Cargo.toml", "security/manager/ssl/noise/gtest/test.rs", "security/manager/ssl/noise/noise_channel.h", "security/manager/ssl/noise/src/channel.rs", "security/manager/ssl/noise/src/lib.rs", "security/manager/ssl/noise/src/padding.rs", "security/manager/ssl/nsICtapCableChannel.idl", "security/manager/ssl/tests/gtest/NoiseTest.cpp", "security/manager/ssl/tests/gtest/moz.build", "security/manager/ssl/tests/unit/test_ctap_cable_channel.js", "security/manager/ssl/tests/unit/xpcshell.toml", "toolkit/library/gtest/rust/Cargo.toml", "toolkit/library/gtest/rust/lib.rs", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "46f42bad299c0b9d6aaf20d95d587bb4c93d1b8b", "git_parents": ["a06b9ac67b35b73724b122664c149d300efc78a8"], "node": "3b0bd32ca2e629156de16d2c7fd894cf5eddc94e", "parents": ["82f55fc58e76e2b7d2bb42d2d4e956393ae104f8"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2055392 - Noise handshake implementation for caBLE r=jschanck\n\nThe Rust API implements Noise `{KN,NK}psk0_P256_AESGCM_SHA256` handshakes,\nand the XPCOM API exposes just `KNpsk0`.\n\nThese are intended to encrypt messages during the data transfer phase\n(\u00a711.5.1.2) of caBLE/Hybrid CTAP authenticator connection.\n\nBoth the Rust and XPCOM APIs can act as both the initiator and responder\n(authenticator), and the tests use both to talk to themselves.\n\nNoise handshakes can use many hash algorithms, but this only implements\nSHA256, as it's the only one used in caBLE.\n\nI used RustCrypto for hashing (like `crypto_hash` does), as `nss-rs` doesn't\nhave an equivalent to `Digest::update()` (for `h = HASH(h || data)`), and it\nhas reusable exact-size types (avoiding a small overhead from `Vec\u003cu8\u003e`).\nAll other key derivation and encryption is done with NSS.\n\nReferences:\n\n* CTAP 2.3 Hybrid transports:\n  https://fidoalliance.org/specs/fido-v2.3-ps-20260226/fido-client-to-authenticator-protocol-v2.3-ps-20260226.html#sctn-hybrid\n\n* Noise PSK handshakes:\n  https://noiseprotocol.org/noise.html#pre-shared-symmetric-keys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312427\n", "files": ["Cargo.lock", "security/manager/ssl/components.conf", "security/manager/ssl/moz.build", "security/manager/ssl/noise/Cargo.toml", "security/manager/ssl/noise/gtest/test.rs", "security/manager/ssl/noise/noise_handshake.h", "security/manager/ssl/noise/src/channel.rs", "security/manager/ssl/noise/src/ec.rs", "security/manager/ssl/noise/src/handshake/initiator.rs", "security/manager/ssl/noise/src/handshake/mod.rs", "security/manager/ssl/noise/src/handshake/responder.rs", "security/manager/ssl/noise/src/hash.rs", "security/manager/ssl/noise/src/lib.rs", "security/manager/ssl/noise/src/symmetric_state.rs", "security/manager/ssl/nsICtapCableChannel.idl", "security/manager/ssl/nsICtapCableHandshake.idl", "security/manager/ssl/tests/gtest/NoiseTest.cpp", "security/manager/ssl/tests/unit/test_ctap_cable_handshake.js", "security/manager/ssl/tests/unit/xpcshell.toml"], "git_node": "99c4afd06fe439332e434b75eaac1e0144f9223c", "git_parents": ["46f42bad299c0b9d6aaf20d95d587bb4c93d1b8b"], "node": "2c731c24e724133fe44d8f3ae2f295570dd0bc44", "parents": ["3b0bd32ca2e629156de16d2c7fd894cf5eddc94e"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2057377 - caBLE Base10 encoder/decoder r=jschanck\n\nFor QR-initated transactions, the initiator needs to generate a QR code\ncontaining some request parameters and key material.  These parameters are\nencoded in CBOR, then encoded as Base10, which allows the QR code to use a\nmore efficient numeric encoding.\n\nThe Base10 payloads are around 170 bytes, so there's no value to having an\nincremental encoder/decoder.\n\nReferences:\n\n- CTAP 2.3 Hybrid transports:\n  https://fidoalliance.org/specs/fido-v2.3-ps-20260226/fido-client-to-authenticator-protocol-v2.3-ps-20260226.html#sctn-hybrid\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315179\n", "files": ["security/manager/ssl/noise/gtest/test.rs", "security/manager/ssl/noise/src/base10.rs", "security/manager/ssl/noise/src/lib.rs", "security/manager/ssl/tests/gtest/NoiseTest.cpp"], "git_node": "6af94d5846f28373d237a758d2450a5ebe7a6a04", "git_parents": ["99c4afd06fe439332e434b75eaac1e0144f9223c"], "node": "b68488d59aca1d9d0a2284b6882f7568959878d8", "parents": ["2c731c24e724133fe44d8f3ae2f295570dd0bc44"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2055392 - Make `xpcom` a feature, use normal tests r=jschanck\n\nNormal Rust tests don't work for crates that depend on `nserror` and `xpcom`\n[0]. This makes these an optional dependency, behind the `xpcom` feature:\n\n* Created a new error type, migrated everything to that.\n\n* Migrated `gtests` to regular Rust tests, wired it up to `./mach rusttests`.\n\n[0]: https://firefox-source-docs.mozilla.org/testing-rust-code/index.html#rust-tests\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316170\n", "files": ["Cargo.lock", "security/manager/ssl/noise/Cargo.toml", "security/manager/ssl/noise/build.rs", "security/manager/ssl/noise/gtest/Cargo.toml", "security/manager/ssl/noise/gtest/test.rs", "security/manager/ssl/noise/src/base10.rs", "security/manager/ssl/noise/src/channel.rs", "security/manager/ssl/noise/src/ec.rs", "security/manager/ssl/noise/src/error.rs", "security/manager/ssl/noise/src/handshake/initiator.rs", "security/manager/ssl/noise/src/handshake/mod.rs", "security/manager/ssl/noise/src/handshake/responder.rs", "security/manager/ssl/noise/src/handshake/service.rs", "security/manager/ssl/noise/src/hash.rs", "security/manager/ssl/noise/src/lib.rs", "security/manager/ssl/noise/src/padding.rs", "security/manager/ssl/noise/src/symmetric_state.rs", "security/manager/ssl/noise/tests/base10.rs", "security/manager/ssl/noise/tests/channel.rs", "security/manager/ssl/noise/tests/handshake.rs", "security/manager/ssl/tests/gtest/NoiseTest.cpp", "security/manager/ssl/tests/gtest/moz.build", "security/manager/ssl/tests/unit/test_ctap_cable_handshake.js", "toolkit/library/gtest/rust/Cargo.toml", "toolkit/library/gtest/rust/lib.rs", "toolkit/library/rust/gkrust-features.mozbuild", "toolkit/library/rust/moz.build", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "32c7a389b5415e369630356b1249bd9c7ac2cd98", "git_parents": ["6af94d5846f28373d237a758d2450a5ebe7a6a04"], "node": "a9110e6b1107d68687af13c9132907ba71c83ad0", "parents": ["b68488d59aca1d9d0a2284b6882f7568959878d8"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057113 - Part 1: Reject re-entrant native Windows clipboard mutations. r=edgar,win-reviewers,gstoll\n\nNative clipboard writes can spin a nested event loop or pump the native message\nqueue. A clipboard write dispatched during that period re-enters the platform's\nbackend and mutates state the suspended commit is still using.  This exposed\na case where the clipboard cache gets out-of-sync due to re-entrant SetData.\nThe older write would win the cache but the native clipboard holds the newer\nwrite's contents.  Re-entrant requests are now rejected (neither interleaved\nnor queued).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326255\n", "files": ["widget/nsBaseClipboard.cpp", "widget/nsBaseClipboard.h"], "git_node": "32274b92a4311d08e87557684154fa47d9ed70e5", "git_parents": ["32c7a389b5415e369630356b1249bd9c7ac2cd98"], "node": "3def2f33a67a0d58377c946c7222b1ea8130f67c", "parents": ["a9110e6b1107d68687af13c9132907ba71c83ad0"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057113 - Part 2: Don't force a synchronous clipboard flush for file promises. r=win-reviewers,gstoll\n\nSetNativeClipboardData flushes clipboard writes when text/plain is on the\ntransferable on Windows 11 22H2+. Flushing was added to clipboard write in\nbug 1774285, because delayed rendering makes Windows Suggested Actions walk\nthe a11y tree, and immediate rendering of data to the clipboard was the lesser\nevil.\n\nRendering a file promise maps to CF_HDROP, whose renderer is\nnsDataObj::DropTempFile (which is unintuitively _not_ used for drag and drop,\nonly clipboard).  It opens a channel to the promised URL and runs a nested\nevent loop in CStream::WaitForCompletion until it completes, so forcing the\nflush runs a network fetch in a nested event loop inside the clipboard commit.\nThe duration of the nest is unpredictable but can be as long as the device\nmaintains the connection (modulo any timeout limits).   This patch skips the\nflush if there is a file (or no text) in the payload, avoiding the nested loop\naltogether when this happens.\n\nWithout a pref flip (clipboard.imageAsFile.enabled = true), writing both\na file and text to clipboard should not be possible, so this case does not\noccur.  This is because only images can be written to the clipboard as files.\nSee [the MDN page for mandatory types](https://www.w3.org/TR/clipboard-apis/#mandatory-data-types)\nand the comment in ClipboardItem::Supports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326256\n", "files": ["widget/windows/nsClipboard.cpp"], "git_node": "98ca727cca53a5596d625abd9b742f0633c681b4", "git_parents": ["32274b92a4311d08e87557684154fa47d9ed70e5"], "node": "15c16787087a00975185ab086f9b75e7e17e00f4", "parents": ["3def2f33a67a0d58377c946c7222b1ea8130f67c"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2069395 - Lock during nsComponentManager memory reports, r=xpcom-reviewers,mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326592\n", "files": ["xpcom/components/nsComponentManager.cpp", "xpcom/components/nsComponentManager.h"], "git_node": "9dff34998bd129f229a84eeb84ad8e1a5ed78e7d", "git_parents": ["98ca727cca53a5596d625abd9b742f0633c681b4"], "node": "d63a13f91008f7aa682a9938522c8515104b2274", "parents": ["15c16787087a00975185ab086f9b75e7e17e00f4"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072676 - Enable VPN location secret settings for Beta. r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326560\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt"], "git_node": "01f08dd1d153bfa5299bbfbf3c672323e8fe98eb", "git_parents": ["9dff34998bd129f229a84eeb84ad8e1a5ed78e7d"], "node": "1000fe8e5b98dc425a593646244e415ebe75ce9e", "parents": ["d63a13f91008f7aa682a9938522c8515104b2274"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072487 - Build 7-zip against the sysroot. r=firefox-build-system-reviewers,glandium\n\nThe task already fetched clang and the sysroot but the build used the docker image's g++, which is what\nmade the binary depend on Debian 13's libstdc++. Building against the sysroot makes the static link\nunnecessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326371\n", "files": ["taskcluster/scripts/misc/build-7zz.sh"], "git_node": "f29ea6e9eb4573d61d8b23df0fa21e00266aec24", "git_parents": ["01f08dd1d153bfa5299bbfbf3c672323e8fe98eb"], "node": "81d9858e19ea9473549a2a300f59b8a24f281e71", "parents": ["1000fe8e5b98dc425a593646244e415ebe75ce9e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072487 - Build cabextract against the sysroot. r=firefox-build-system-reviewers,glandium\n\nThe task fetches clang and the sysroot but the script ignored both and built with the docker image's gcc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326372\n", "files": ["taskcluster/scripts/misc/build-cabextract.sh"], "git_node": "55c59ed9153c98077b9ac13e7312c2abc051bb38", "git_parents": ["f29ea6e9eb4573d61d8b23df0fa21e00266aec24"], "node": "37bbb0f0a3553220efe1eb9ebe4706d529450e60", "parents": ["81d9858e19ea9473549a2a300f59b8a24f281e71"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072487 - Build wine against the sysroot. r=firefox-build-system-reviewers,glandium\n\nThe current binaries require glibc 2.38 symbols, so they only run on hosts at least as new as the docker\nimage that built them. The non-PE build needs -mabi=ms, which clang does not support, so this uses the\ngcc toolchain the way the node build does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326373\n", "files": ["taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/build-wine.sh"], "git_node": "f9ad0a3dbc2fa97f4ff7b9c72bc22ef27c358ef0", "git_parents": ["55c59ed9153c98077b9ac13e7312c2abc051bb38"], "node": "77444a5caf912092219f68221f8823df0cc29189", "parents": ["37bbb0f0a3553220efe1eb9ebe4706d529450e60"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072487 - Build hfsplus against the sysroot. r=firefox-build-system-reviewers,glandium\n\nThe toolchain sysroot is the one with libssl-dev for the static libcrypto link, which is why it gains\nuuid-dev here. That libcrypto is not PIE, hence -no-pie.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326374\n", "files": ["build/unix/build-hfsplus/build-hfsplus.sh", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "b4dcf3b06e9b2688a1535ef7c245348dc7b82585", "git_parents": ["f9ad0a3dbc2fa97f4ff7b9c72bc22ef27c358ef0"], "node": "d964414e48e79965f20e9530097c4ff4b393ab3a", "parents": ["77444a5caf912092219f68221f8823df0cc29189"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072487 - Build mar-tools against the sysroot. r=firefox-build-system-reviewers,glandium\n\nmar and mbsdiff are host programs, so the host sysroot is the one that applies.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326375\n", "files": ["taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/build-mar-tools.sh"], "git_node": "b261f9556ad84d39e2dd271a703ff063cff43feb", "git_parents": ["b4dcf3b06e9b2688a1535ef7c245348dc7b82585"], "node": "6847eae6661d403b8cc2243ebe0b9a6f47f3a263", "parents": ["d964414e48e79965f20e9530097c4ff4b393ab3a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072487 - Build zucchini against the sysroot. r=firefox-build-system-reviewers,glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326376\n", "files": ["taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/build-zucchini.sh"], "git_node": "17be21c2341b9b7c6b2a7f52779be5f3ec59bb68", "git_parents": ["b261f9556ad84d39e2dd271a703ff063cff43feb"], "node": "a6d0ed939511a58065e6a48dde8ec4384c2b894e", "parents": ["6847eae6661d403b8cc2243ebe0b9a6f47f3a263"], "tags": []}, {"author": "Daniel Mungai \u003cchegedan699@gmail.com\u003e", "branch": "default", "desc": "Bug 2072565 - Avoid overwriting loop variables in mozbuild. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326566\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/vendor/vendor_manifest.py"], "git_node": "8efb69491b74d91e5dacef7c84b9d96c92bec37a", "git_parents": ["17be21c2341b9b7c6b2a7f52779be5f3ec59bb68"], "node": "2612a9b7b007313a696fd09fcd7b2b1cb01d6cf3", "parents": ["a6d0ed939511a58065e6a48dde8ec4384c2b894e"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068456. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326370\n", "files": ["gfx/thebes/gfxOTSUtils.h"], "git_node": "5dc20810c0d1286f1c43a29c6d5d7dfa3459e444", "git_parents": ["8efb69491b74d91e5dacef7c84b9d96c92bec37a"], "node": "f580ef75f58f14ece74249de42d5e18cfb718f32", "parents": ["2612a9b7b007313a696fd09fcd7b2b1cb01d6cf3"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2071727 - Perform CustomFreeTransferHandler bounds checks outside of fuzzing, r=dom-core-reviewers,mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326661\n", "files": ["dom/base/StructuredCloneHolder.cpp"], "git_node": "f7e3aeb234aff0d9c18948cf066b24206ac7700e", "git_parents": ["5dc20810c0d1286f1c43a29c6d5d7