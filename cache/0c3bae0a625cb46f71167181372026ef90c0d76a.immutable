tml.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-014.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-015.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-016.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-017.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-021.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-022.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-023.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-024.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-025.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-026.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-027.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-028.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/dynamic-grid-track-direction.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-flex-sizing-rows-min-max-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-fr-rows-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-check-grid-height-on-resize.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini"], "git_node": "6654b23b3026d2d53cfa195e3157822f76abc04a", "git_parents": ["1b5a8c5dec6488a360b5714cd02fb6a2dc4695e2"], "node": "1a79dc2e06241cd305b798cdcf8cf4f8cc260ab2", "parents": ["8822d3828276c3eb7b1d14f28ff5bb72bdeed908"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2074018 - Ignore RUSTSEC-2026-0293 for ringbuf. r=supply-chain-reviewers,afranchuk DONTBUILD\n\nThe advisory reports a double free in Consumer::skip and Consumer::clear\nwhen an element's Drop panics. Gecko vendors ringbuf 0.2.8, where the\nequivalent entry point is Consumer::discard: it drops the elements inside\nthe pop_access closure, and pop_access only stores the new head after the\nclosure returns, so a panic leaves the read index on already-dropped slots.\n\nThe bug is not reachable here. The only callers of discard are in\ncubeb-coreaudio's buffer_manager, on Consumer\u003ci16\u003e and Consumer\u003cf32\u003e;\ncubeb-pulse instantiates the same two element types and never calls\ndiscard. Primitive elements have no destructor, so no Drop can panic.\n\nFixing this for real means moving to ringbuf 0.5, an API break that has to\nland upstream in cubeb-coreaudio-rs and cubeb-pulse-rs first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327856\n", "files": [".cargo/audit.toml"], "git_node": "c25f6b27d7ed72c7f9220013e3ac18fbd43992be", "git_parents": ["6654b23b3026d2d53cfa195e3157822f76abc04a"], "node": "dac89c00db05d89607b1e5de6d95d7aa74fb0dc5", "parents": ["1a79dc2e06241cd305b798cdcf8cf4f8cc260ab2"], "tags": []}, {"author": "Amir Habibi \u003cahabibi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068815 - Extend expiry of browser.engagement.windows_start_search_activation_count to 163. r=hsohaney\n\nThe metric is a proxy for Firefox activations originating from Windows Start\nmenu search and product still wants the data. Expiring in 159 would end\ncollection when 159 ships on 2026-10-27; 162 is the last release of 2026, so\nexpiring in 163 keeps it recording on release until 2027-01-12.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324674\n", "files": ["browser/base/content/metrics.yaml"], "git_node": "ccd0da1ef5b0f900068bec3e3855e0089087f190", "git_parents": ["c25f6b27d7ed72c7f9220013e3ac18fbd43992be"], "node": "d58f0e3ec77ff49da5a803ef28b88c1ab21ba8f8", "parents": ["dac89c00db05d89607b1e5de6d95d7aa74fb0dc5"], "tags": []}, {"author": "celenity \u003ccelenity@celenity.dev\u003e", "branch": "default", "desc": "Bug 1961408 - Mock navigator.sendBeacon when Beacon is disabled r=webidl,emilio,emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257919\n", "files": ["dom/base/Navigator.cpp", "dom/tests/mochitest/beacon/mochitest.toml", "dom/tests/mochitest/beacon/test_beaconDisabled.html", "dom/webidl/Navigator.webidl", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "d30f3b5126159797e881155e3f717eca962c40a5", "git_parents": ["ccd0da1ef5b0f900068bec3e3855e0089087f190"], "node": "cbf8db52fa4ae92106e1ecb926b2feaadffe0eae", "parents": ["d58f0e3ec77ff49da5a803ef28b88c1ab21ba8f8"], "tags": []}, {"author": "Coll76 \u003ccollins.kubu@gmail.com\u003e", "branch": "default", "desc": "Bug 2069323 - Remove stale --fixup hint from check_spidermonkey_style.py failure message r=sylvestre DONTBUILD\n\nThe --fixup implementation was removed from check_spidermonkey_style.py\nin bug 2054311, along with the #include alphabetical ordering check it\nwas meant to fix. The failure message still pointed contributors at\n`check_spidermonkey_style.py --fixup`, which no longer exists and just\nerrors out with \"unexpected command line options\" if you try it.\n\nDrop the obsolete hint. The remaining failure message is still accurate\non its own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326472\n", "files": ["tools/lint/spidermonkey/check_spidermonkey_style.py"], "git_node": "c0240e1a5c97f6e30149544f9df80109ed7aa42c", "git_parents": ["d30f3b5126159797e881155e3f717eca962c40a5"], "node": "de42aba88847f39197c52577eb7ad2532494e985", "parents": ["cbf8db52fa4ae92106e1ecb926b2feaadffe0eae"], "tags": []}, {"author": "halemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069479 - Split the notification helper gate from the user's own switch. r=hsohaney\n\nThe helper was gated on one pref that the pushNotificationHelper Nimbus feature\nset. Nimbus unenrolls any client that writes a pref it set, so the opt-out the\nexperiment needs would have silently unenrolled the user.\n\napp.backgroundNotifications.helper.available is now the Nimbus-owned gate, and\napp.backgroundNotifications.helper.enabled stays as the user's own switch that\nNimbus never writes. The helper runs only when both are true, and survives\ngraduation on the user's switch alone.\n\nThe gate is set on the user branch rather than the default branch. PrefUtils\ncannot reset a default branch pref in the running session, so on that branch\nunenrollment would leave the helper running until the next restart. A helper\noutlives a Firefox session, so that is not an acceptable kill switch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326190\n", "files": ["browser/app/profile/firefox.js", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/mozapps/pushnotificationhelper/PushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/tests/xpcshell/test_push_notification_helper.js"], "git_node": "123496bd458b2b22b20d3a257c61f3db2fd46f9b", "git_parents": ["c0240e1a5c97f6e30149544f9df80109ed7aa42c"], "node": "0fa2ec896628e906ae96ae71ac29a61d12d34149", "parents": ["de42aba88847f39197c52577eb7ad2532494e985"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055094 - Remove Fxa-Tokens on Error rather then after use r=ip-protection-reviewers,apopov\n\nRN IP-Protections destroys fxa-tokens after use, we should rather do that after guardian\nhas told us they are not valid.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316980\n", "files": ["toolkit/components/ipprotection/GuardianTypes.sys.mjs", "toolkit/components/ipprotection/enterprise/IPPEnterpriseAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/fxa/IPPAndroidAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_GuardianClient.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPFxaActivateAuthProvider.js"], "git_node": "c623f85bf2c418d63e44981baca686ebbe3021bd", "git_parents": ["123496bd458b2b22b20d3a257c61f3db2fd46f9b"], "node": "e853c225bc4a0df2b3d610122546ed0001f85b47", "parents": ["0fa2ec896628e906ae96ae71ac29a61d12d34149"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072723 - Part 1: Add onBufferEdge method to JSTracer r=spidermonkey-reviewers,jandem\n\nThis adds a new virtual method to JSTracer which is called on buffer edges. The\ndefault implementation is to do nothing so most existing tracers are not\naffected.\n\nThis also changes the signature of TraceBufferEdge to return void like TraceEdge.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326896\n", "files": ["js/public/TracingAPI.h", "js/src/gc/Allocator.h", "js/src/gc/BufferAllocator-inl.h", "js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp", "js/src/gc/Tenuring.cpp", "js/src/gc/Tenuring.h", "js/src/gc/Tracer.h"], "git_node": "5de31c5a79f444e78adfe42a911f7d4ebff8a83f", "git_parents": ["c623f85bf2c418d63e44981baca686ebbe3021bd"], "node": "06c3536ee53fbdbe51779db4ae1743264de0f0ac", "parents": ["e853c225bc4a0df2b3d610122546ed0001f85b47"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072723 - Part 2: Use tracer dispatch to call the relevant buffer allocator methods r=spidermonkey-reviewers,jandem\n\nCurrently the buffer allocator switches on the tracer kind when tracing a\nbuffer edge. The patch changes this to use virtual dispatch on the tracer to\ndecide what to do.\n\nThis splits BufferAllocator::TraceEdge into MarkBuffer and PromoteBuffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326897\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/Marking.cpp", "js/src/gc/Tenuring.cpp", "js/src/gc/Tenuring.h"], "git_node": "0d090cfbbe8d7e52b59470d5c704f654785b5762", "git_parents": ["5de31c5a79f444e78adfe42a911f7d4ebff8a83f"], "node": "465d51b040669888154ca0c8e15c8809135440df", "parents": ["06c3536ee53fbdbe51779db4ae1743264de0f0ac"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072723 - Part 3: Move marking barrier into alloc functions r=spidermonkey-reviewers,jandem\n\nCurrently we call the buffer marking functions when allocating nursery buffers\nduring GC, to ensure the new buffer survives. This changes things so we set the\nmarked flag directly when necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326898\n", "files": ["js/src/gc/BufferAllocator.cpp"], "git_node": "2bf8cdeb2095d354ab501c5785518527857e2778", "git_parents": ["0d090cfbbe8d7e52b59470d5c704f654785b5762"], "node": "01da6a89a9982afcdb402824686d09e346620d27", "parents": ["465d51b040669888154ca0c8e15c8809135440df"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072723 - Part 4: Rename some buffer allocator marking methods to 'promote' r=spidermonkey-reviewers,jandem\n\nFinally we can rename marking methods that are only used to promote nursery\nowned buffers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326899\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/Nursery.cpp"], "git_node": "9a10c492e29988124c15fe97c51a864b720c03e2", "git_parents": ["2bf8cdeb2095d354ab501c5785518527857e2778"], "node": "428690fb684f2fdd210018684afacd9811a1fd9d", "parents": ["01da6a89a9982afcdb402824686d09e346620d27"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069150 - Show the selection menu without a configured chatbot provider r=omarg\n\nFor background on the new Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nThe selection menu only appeared once a chatbot provider was set, so a user who\nnever chose one never saw it. It now appears without a provider, and clicking\nits AI action starts onboarding. The menu also stays hidden in the contexts\nthat already hide the chatbot entrypoints, such as extension pages and popup\nwindows. All of this is off by default, behind\nbrowser.highlightToSearch.featureGate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326722\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/genai/tests/xpcshell/test_show_chat_entrypoint.js"], "git_node": "a4f748076f6cee37b10a84d913f9d00ae845565a", "git_parents": ["9a10c492e29988124c15fe97c51a864b720c03e2"], "node": "cc1a9c1960de497ab2bccae2c0ba5432c6286396", "parents": ["428690fb684f2fdd210018684afacd9811a1fd9d"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068772 - Quota manager UnloadQuota: wrap all SQL statements into a single commit to avoid potentially flushing to disk at each loop iteration r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323105\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "5d8e3b5c1005f98b59bc698e3130c0a1c9c49084", "git_parents": ["a4f748076f6cee37b10a84d913f9d00ae845565a"], "node": "976914e0a156bb974aaa36d648b32b9480686c1b", "parents": ["cc1a9c1960de497ab2bccae2c0ba5432c6286396"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068344: Make GetCurrentFontStyle destroy a stale fontGroup. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324763\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "bc2c73631a14b00df08e989dca4f08e0e2881817", "git_parents": ["5d8e3b5c1005f98b59bc698e3130c0a1c9c49084"], "node": "88b26fd7d8b227f248029da7a0052c73c9704d84", "parents": ["976914e0a156bb974aaa36d648b32b9480686c1b"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030138 - Require aligned float matrices in mozIntGemm prepare-bias builtins. r=rhunt\n\nIntrI8PrepareBias and IntrI8MultiplyAndAddBias validated their float matrix\noffsets (output, inputBias, inputBiasPrepared) with CheckMatrixBound, which\nchecks bounds only, unlike every other matrix parameter in the file. The\ngemmology callbacks access these through aligned SIMD loads and stores, so\nrequire the same alignment that the sibling Prepare* intrinsics already\nenforce via ARRAY_ALIGNMENT. A misaligned offset now returns -1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313819\n", "files": ["js/src/intgemm/IntegerGemmIntrinsic.cpp", "js/src/jit-test/tests/wasm/builtin-modules/integer-gemm/I8MultiplyAndAddBias.js", "js/src/jit-test/tests/wasm/builtin-modules/integer-gemm/I8PrepareBias.js"], "git_node": "7133d99bb540dbd073ab21294c88de60031d9b77", "git_parents": ["bc2c73631a14b00df08e989dca4f08e0e2881817"], "node": "2d99cf0e0da6a2e479d7adbafb2e1e26050e45e9", "parents": ["88b26fd7d8b227f248029da7a0052c73c9704d84"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044192 - Remove image.natural-size-fallback.enabled. r=dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326311\n", "files": ["dom/base/nsImageLoadingContent.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/__dir__.ini"], "git_node": "897c709f2d9a6c970a49b48bb16c71a4f8c93263", "git_parents": ["7133d99bb540dbd073ab21294c88de60031d9b77"], "node": "26080a2726290dc365220366ade1fb0db3e3c7cf", "parents": ["2d99cf0e0da6a2e479d7adbafb2e1e26050e45e9"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033633 - Skip density correction for fallback intrinsic height. r=dholbert\n\nTrack whether the natural height came from the fallback concrete object size and skip Y-axis density correction in that case. Remove the WPT failure annotations fixed by the change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326312\n", "files": ["dom/base/nsImageLoadingContent.cpp", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/naturalWidth-naturalHeight-width-height.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/svg-img-density-vs-zoom.html.ini"], "git_node": "c27fe2149791cca4f90abbd0c4fe2b0af0c73aa2", "git_parents": ["897c709f2d9a6c970a49b48bb16c71a4f8c93263"], "node": "2a2cd5bded3e052afb3a770bb420b99a8849b3fa", "parents": ["26080a2726290dc365220366ade1fb0db3e3c7cf"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2073569: De-duplicate redundant WPT pref-toggle for css calc-typed-arithmetic (fixing the misspelled one). r=layout-reviewers,emilio\n\nWe don't need the pref to be set in the top-level WPT directory, so we can\nremove that one.\n\nAnd the pref-assignment in the CSS directory was misspelled (\"calc.typed\"\nshould have a hyphen instead of a period), so let's fix that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327430\n", "files": ["testing/web-platform/meta/__dir__.ini", "testing/web-platform/meta/css/__dir__.ini"], "git_node": "fd1ac7b16d8c76528e594d00a5f0d7150d850416", "git_parents": ["c27fe2149791cca4f90abbd0c4fe2b0af0c73aa2"], "node": "9d132a8e80ee72c3ca27b1e22503f5b24c7ea8cc", "parents": ["2a2cd5bded3e052afb3a770bb420b99a8849b3fa"], "tags": []}, {"author": "Raul Salvat \u003crootzero.brain@gmail.com\u003e", "branch": "default", "desc": "Bug 2062651 - Remove dead PanelUI-fxa-menu-setup-sync-container from the account panel r=nsharpley,desktop-theme-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323174\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/icons/sync-off.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "625df5a8304c99f41ec873f77e4c7415aefb9a1d", "git_parents": ["fd1ac7b16d8c76528e594d00a5f0d7150d850416"], "node": "17307e66fe8e6abf045477a5281f56f122a1b3b2", "parents": ["9d132a8e80ee72c3ca27b1e22503f5b24c7ea8cc"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Plumb H264 profile and level into AndroidDataEncoder, matching the GMP/FFmpeg/Apple/WMF encoder backends. r=media-playback-reviewers,geckoview-reviewers,padenot,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321194\n", "files": ["dom/media/platforms/android/AndroidDataEncoder.cpp", "widget/android/bindings/MediaCodec-classes.txt"], "git_node": "3de8bed1c06901ee49f87cc119b4c8e16734801e", "git_parents": ["625df5a8304c99f41ec873f77e4c7415aefb9a1d"], "node": "2cec9eaf0ccc550e806ec074a9989ac51816eef6", "parents": ["17307e66fe8e6abf045477a5281f56f122a1b3b2"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Balance the leaked active-request count when RemoteManager.createCodec() fails to init a codec. r=media-playback-reviewers,geckoview-reviewers,jolin,tcampbell\n\nIf CodecProxy.init() fails (e.g. Codec.configure() found no matching codec\nfor the requested profile/level/resolution), createCodec() returns null\nwithout ever calling IMediaManager.endRequest() to balance the\ncreateCodec() call already made on the remote. releaseCodec(), which is\nthe only other endRequest() call site, is never reached for a codec that\nwas never added to mCodecs.\n\nThis leaves the :media process's mNumActiveRequests permanently\nover-counted by one. The next time the client unbinds the service (e.g.\nbecause its last successfully-created codec was released and\nreleaseIfNeeded() unbound), MediaManager.onUnbind() sees a nonzero\nmNumActiveRequests and calls Process.killProcess() on itself, believing\nthe caller died abnormally. Android then respawns the :media process,\nwhich looks like a bind/unbind/process-restart cycle with no obvious\ntrigger. Failing codec creations (e.g. by requesting an H264 level 5/6\nresolution the platform's encoder doesn't support) reliably reproduce\nthis.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321195\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteManager.java"], "git_node": "b3668c3b986e0ab41df32e8d3633d1f79432d300", "git_parents": ["3de8bed1c06901ee49f87cc119b4c8e16734801e"], "node": "73176481853907f3ca599b339cbdf7d6841c793b", "parents": ["2cec9eaf0ccc550e806ec074a9989ac51816eef6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Report H264 QP thresholds from WebrtcMediaDataEncoder so libwebrtc's QualityScaler can track it. r=webrtc-reviewers,ng\n\nWebrtcMediaDataEncoder::GetEncoderInfo() never populated scaling_settings,\nleaving it at ScalingSettings::kOff. This means libwebrtc's\nQualityScalerResource cannot be kept alive across a switch onto this\nencoder: VideoStreamEncoderResourceManager::UpdateQualityScalerSettings()\nsees no QP thresholds and calls RemoveResource(), which -- if quality\nscaling was the only resource currently imposing a resolution\nrestriction -- resets restrictions to unconstrained via\nVideoStreamAdapter::ClearRestrictions().\n\nOn Android this produces an unbounded retry loop for resolutions beyond\nwhat the hardware MediaCodec encoder actually supports: the hardware\nencoder fails to configure, libwebrtc falls back to a software encoder\n(which reports QP thresholds and gets downscaled by the QualityScaler\nafter seeing 100% frame drop), and the moment that downscaled resolution\nlets the hardware encoder succeed again, its lack of QP thresholds tears\ndown the QualityScalerResource and wipes the very restriction that made\nit succeed -- so the next frame is requested at the full, unconstrained\nresolution again, repeating forever.\n\nReporting the same QP thresholds WebrtcGmpVideoEncoder already uses lets\nthe single, long-lived QualityScalerResource survive the switch (only\nSetQpThresholds() runs, not Remove/AddResource), so a resolution\nrestriction earned via the fallback encoder persists once the hardware\nencoder takes back over.\n\nMove the threshold constants into WebrtcGmpVideoCodec.h (as constexpr,\nshared by both encoder wrappers) instead of duplicating them: as\nstatic const int in each .cpp they collided under unified builds, which\nconcatenate both files into one translation unit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321196\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataEncoderCodec.cpp"], "git_node": "d9a74ad9e1ae59fa0df05c844563ed0f88c79770", "git_parents": ["b3668c3b986e0ab41df32e8d3633d1f79432d300"], "node": "2f209391e82b5fc225215d545bdba93e880dc2c2", "parents": ["73176481853907f3ca599b339cbdf7d6841c793b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Add gtest coverage for encoding below Android's real per-frame macroblock cap at a Level 5-implied resolution. r=media-playback-reviewers,jolin\n\nMediaDataEncoderTest.H264Encodes4K* already covers the previously-documented\n4K resolution limit, but the actual platform limit turned out to be a\ntighter, ~8192-macroblock-per-frame budget (roughly Level 4-equivalent) --\nindependent of the declared H264 level -- discovered while investigating\nthe Level 5/6 profile-levels WPT hang. Add a resolution below the 4K\nthreshold but still over that macroblock budget, once with a deliberately\nmismatched (too-low) declared level and once with a level that actually\nmatches it, to cover both axes.\n\nOn macOS 15 aarch64 the VideoToolbox realtime encoder drops most frames at\nthis resolution, so the two new tests are skipped there pending bug 2074146,\nwhich adds a pref to disable frame dropping for tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321197\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": "e3721994177f51ce9c0eb4041152b34ee7d7d05c", "git_parents": ["d9a74ad9e1ae59fa0df05c844563ed0f88c79770"], "node": "3999456d935e8c2082d4b9e9e90026b6121610ab", "parents": ["2f209391e82b5fc225215d545bdba93e880dc2c2"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072062 - Enable the wallpaper library on all channels. r=nina-py,maxx\n\nThis enables \u201cYour images\u201d in `firefox.js`, so it ships with Firefox 158 rather than an add-on update.\n\nThe add-on default stays `false` because full wallpaper backup requires Firefox 157. Older versions only back up the active wallpaper. The `trainhopConfig` override is removed; disabling the feature remotely would use `prefFlips`.\n\nThe `PREFS_CONFIG` entry stays because `PrefsFeed` uses its keys to send prefs to the page. Without it, \u201cYour images\u201d would never appear.\n\nValidation: all 3,980 New Tab Jest tests and all 37 New Tab xpcshell files pass, including 225 subtests in `test_WallpaperFeed.js`. Two new tests check the shipped default and confirm the add-on leaves it unchanged. Removing the `firefox.js` line and rebuilding makes the default test fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326277\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperLibraryPref.mjs", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "5827051d4606334dd8d9c8a6f3567586dba7afa7", "git_parents": ["e3721994177f51ce9c0eb4041152b34ee7d7d05c"], "node": "929a8a0e48530b73fedc6ea13ca9ded273b52fb3", "parents": ["3999456d935e8c2082d4b9e9e90026b6121610ab"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069783 - Type-check TabGroupState.sys.mjs. r=jswinarton\n\n`savedInClosedWindow` returns a new object rather than mutating and returning its argument. Its callers in `SessionMigration.convertState` and `#prepDataForDeferredRestore` keep that argument in a window's `groups`, where the saved group's `saved`, `closedAt`, `tabs` and `splitViews` used to appear, sharing the tabs array with the saved copy. Neither path is covered by a test, hence the xpcshell one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323952\n", "files": ["browser/components/sessionstore/TabGroupState.sys.mjs", "browser/components/sessionstore/test/unit/test_tab_group_state.js", "browser/components/sessionstore/test/unit/xpcshell.toml", "browser/components/sessionstore/tsconfig.json"], "git_node": "56ec72d813ea97c0915a6494488f4475e561b6de", "git_parents": ["5827051d4606334dd8d9c8a6f3567586dba7afa7"], "node": "803288776d539a96e446804b6fa7f1623c77d1f8", "parents": ["929a8a0e48530b73fedc6ea13ca9ded273b52fb3"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070687 - Implement dismissible Sign in promo in the app menu r=desktop-theme-reviewers,fluent-reviewers,emilio,bolsson\n\nIn the app menu only:\n- adds a dismiss button and updates the sign in button to be a link\n- once dismissed, the user should never see the promo again\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326689\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "9750a49bda047f77e3edd5df5c5c08c1a3f422a8", "git_parents": ["56ec72d813ea97c0915a6494488f4475e561b6de"], "node": "23cc54cfd7b1249036c62376241c6923438d7457", "parents": ["803288776d539a96e446804b6fa7f1623c77d1f8"], "tags": []}, {"author": "aurora \u003caurora@starsinthesky.ca\u003e", "branch": "default", "desc": "Bug 2051745 - Add browser.shell.desktop-entry-api to control whether/how Linux desktop entries are made. r=nrishel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309709\n", "files": ["browser/app/profile/firefox.js", "browser/components/shell/ShellService.sys.mjs", "browser/components/shell/test/unit/test_linuxDesktopEntry.js", "browser/components/shell/test/unit/xpcshell.toml"], "git_node": "7eb597d727472249198132604381f3781041661b", "git_parents": ["9750a49bda047f77e3edd5df5c5c08c1a3f422a8"], "node": "1651093d229b1b82d413c3e26d508a31291a2cb2", "parents": ["23cc54cfd7b1249036c62376241c6923438d7457"], "tags": []}, {"author": "aurora \u003caurora@starsinthesky.ca\u003e", "branch": "default", "desc": "Bug 2051745 - Post: Hide the Taskbar Tabs page action if creating Linux desktop entries is disabled. r=nrishel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314449\n", "files": ["browser/components/taskbartabs/TaskbarTabsPageAction.sys.mjs", "browser/components/taskbartabs/test/browser/browser.toml", "browser/components/taskbartabs/test/browser/browser_taskbarTabs_pageAction.js"], "git_node": "e934321a25dc6acf623eaf2a7210e1137644ccf2", "git_parents": ["7eb597d727472249198132604381f3781041661b"], "node": "ba133c65923b577176eb50c84f37eb2db8c9e90a", "parents": ["1651093d229b1b82d413c3e26d508a31291a2cb2"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2073621 - Wait for SVG appearances to decode before printing to PDF. r=dholbert\n\nPrinting could start before SVG appearances had decoded and produce blank pages. Await each image's decode() promise before requesting print-to-PDF; failures return null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327478\n", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/test/browser_pdfjs_printtopdf.js"], "git_node": "4ddc4f352915351b1d2677114b8c8f7666ce7fdf", "git_parents": ["e934321a25dc6acf623eaf2a7210e1137644ccf2"], "node": "c99ebce6b64e40610be9a8a60201ef54ece18be0", "parents": ["ba133c65923b577176eb50c84f37eb2db8c9e90a"], "tags": []}, {"author": "Federico Cucinotta \u003cgithub@fedec.online\u003e", "branch": "default", "desc": "Bug 2047195 - Skip the initial about:blank load when restoring a single tab from about:sessionrestore. r=sthompson,jswinarton\n\nThe about:blank load of the tab created by addWebTab races with the\nsession state applied by SessionStore.setTabState and clobbers it when\nthe pending tab gets selected, leaving a blank tab.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306439\n", "files": ["browser/components/sessionstore/content/aboutSessionRestore.js", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_2047195_restore_single_tab.js"], "git_node": "91cd09eeb92a4d6acf79ce50ae1e0bece5e35642", "git_parents": ["4ddc4f352915351b1d2677114b8c8f7666ce7fdf"], "node": "27eb4259a41261c59b232778da46582668576d1f", "parents": ["c99ebce6b64e40610be9a8a60201ef54ece18be0"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2060936 - Disabling password and credit card sync for Android Automotive OS r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326287\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/BackgroundServices.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/BackgroundServicesTest.kt"], "git_node": "f3ee7345f8cb1fa7a7774745cbd139991137a481", "git_parents": ["91cd09eeb92a4d6acf79ce50ae1e0bece5e35642"], "node": "f0f2b59bdf5af950c37326510461d77c1d3d9329", "parents": ["27eb4259a41261c59b232778da46582668576d1f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073428 - Give `JarFileReader` the flush method `BufferedReader.close` expects r=firefox-build-system-reviewers,sergesanspaille\n\nPython 3.13 reports the missing method as a soft error, and older\nversions ignore it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327435\n", "files": ["python/mozbuild/mozpack/mozjar.py"], "git_node": "726806a7ab2516bb89cdb9e50b89b12ebdf25fc3", "git_parents": ["f3ee7345f8cb1fa7a7774745cbd139991137a481"], "node": "ced9b63a0f8fb287fbc64664d22c6a63198696c7", "parents": ["f0f2b59bdf5af950c37326510461d77c1d3d9329"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2070599 - Say 'Delete' instead of 'Remove' in the autocomplete removal confirmation dialogs. r=mtigley,fluent-reviewers,credential-management-reviewers,bolsson\n\nAutocomplete removal is hidden behind `browser.autocomplete.removeRecords.enabled` pref.\n\nDeletion from the dropdown is permanent, so `Delete` describes it more\naccurately than `Remove`. This also matches the flyout item that opens\nthe dialog.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327439\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/AutocompleteRemoveRecord.sys.mjs", "toolkit/locales/en-US/toolkit/main-window/autocomplete.ftl"], "git_node": "7cd70f89528e606792a99dd476b4ff0e5586d361", "git_parents": ["726806a7ab2516bb89cdb9e50b89b12ebdf25fc3"], "node": "88a0d716aa696dc55907b908a6775ad719e6d2cb", "parents": ["ced9b63a0f8fb287fbc64664d22c6a63198696c7"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066678 - Show cached tab preview while a tab is reloading. r=android-reviewers,pollymce\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324179\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/CoverPresenter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeature.kt", "mobile/android/fenix/app/src/main/res/layout/fragment_browser.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeatureTest.kt"], "git_node": "5aa3046f8ab1f1b0249ba3537eeb20d7affe6990", "git_parents": ["7cd70f89528e606792a99dd476b4ff0e5586d361"], "node": "dbb60488a1a6635270b109e8ef4260f540c950ca", "parents": ["88a0d716aa696dc55907b908a6775ad719e6d2cb"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066678 - Show cached URL indicator and live-page toast for the tab reload cover. r=android-reviewers,android-l10n-reviewers,flod,pollymce\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324180\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/CoverPresenter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/store/BrowserScreenAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/store/BrowserScreenState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/store/BrowserScreenStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/res/drawable/tab_reload_toast_background.xml", "mobile/android/fenix/app/src/main/res/layout/tab_reload_toast.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeatureTest.kt"], "git_node": "6122a2f3508fc3b20f48bc6d2211a1625ff32e01", "git_parents": ["5aa3046f8ab1f1b0249ba3537eeb20d7affe6990"], "node": "6191a3c3c6ce6d479489e706334e9ff9080a67ba", "parents": ["dbb60488a1a6635270b109e8ef4260f540c950ca"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066678 - Refresh selected tab thumbnail on scroll changes before backgrounding. r=android-reviewers,pollymce\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324181\n", "files": ["mobile/android/android-components/components/browser/thumbnails/src/main/java/mozilla/components/browser/thumbnails/facts/BrowserThumbnailsFacts.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ScrollAwareThumbnailFeature.kt"], "git_node": "a8b9f788a8f185c6e70c3ed5e4f33102caa899cb", "git_parents": ["6122a2f3508fc3b20f48bc6d2211a1625ff32e01"], "node": "b51247f667a393c83e8e7718511f243aac131bdb", "parents": ["6191a3c3c6ce6d479489e706334e9ff9080a67ba"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066678 - Gate the tab reload cover behind Nimbus with secret-settings overrides. r=android-reviewers,pollymce\n\nAdds SecretSettingsFragment toggles so developers can override the Nimbus rollout locally without a config change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324182\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverGating.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverGatingTest.kt"], "git_node": "f5a55ff7a3c77043ec326d2c55810ae29bec7c13", "git_parents": ["a8b9f788a8f185c6e70c3ed5e4f33102caa899cb"], "node": "f8b6fa77f38d232ca87991a70a558c679f14c449", "parents": ["b51247f667a393c83e8e7718511f243aac131bdb"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066678 - Record shown counter and exited event for the tab reload cover. r=android-reviewers,pollymce\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324183\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverTelemetry.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverTelemetryTest.kt"], "git_node": "3a7aec56d4736bdbad03959ca12887d9c655d3ea", "git_parents": ["f5a55ff7a3c77043ec326d2c55810ae29bec7c13"], "node": "1eb94638591cc8ffd811cb0f568d2b402e64619d", "parents": ["f8b6fa77f38d232ca87991a70a558c679f14c449"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066678 - Skip the tab reload cover reveal and thumbnail capture when offline. r=android-reviewers,pollymce\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324184\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ScrollAwareThumbnailFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverTelemetry.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/reloadcover/TabReloadCoverTelemetryTest.kt"], "git_node": "2df5ecdf8d5d3dcc3e40beeef17e4d723d0108a6", "git_parents": ["3a7aec56d4736bdbad03959ca12887d9c655d3ea"], "node": "ece7df5d5b3c74b6727ed1bb2da5be637bb8b3aa", "parents": ["1eb94638591cc8ffd811cb0f568d2b402e64619d"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072399 - [Monitor Agent][Models] Record monitor counts, run outcome, timing and model in telemetry r=ngrato,tetchart\n\nTwo gaps kept the monitor telemetry from answering how the feature is\ndoing: nothing reported how many monitors users keep, and monitor_complete\nonly said whether a run threw, so the condition-met rate, check duration\nand model latency were not measurable.\n\nAdds smart_window.monitor_active_count and smart_window.monitor_paused_count\nquantity metrics, set when the store is loaded at startup and after every\nsave or delete, with the application lifetime so each metrics ping carries\nthe counts of that session. This is the active-count metric expedited from\nthe Smart Window Agentic Actions telemetry spec (Jira AIACT-147).\n\nAdds outcome, duration, latency, model and (for scheduled runs) delay to\nmonitor_complete, delay to monitor_run_scheduled, and action_id to every\nmonitor event so runs, notifications and clicks can be joined per monitor.\nThe model call is timed on its own, after the account token fetch, and the\ntwo copies of the extra-key builder are consolidated into one. The\nerror_code and source descriptions now list their closed value sets, and\nsource is validated against that set since it arrives from the tasks page\nin the content process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327196\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/models/tests/browser/browser_monitor_telemetry.js"], "git_node": "40eacbc882fa15a0d1920a14b6869b290cc01f32", "git_parents": ["2df5ecdf8d5d3dcc3e40beeef17e4d723d0108a6"], "node": "85a95233d3d9a376ef4fc35e4f170aa09c961902", "parents": ["ece7df5d5b3c74b6727ed1bb2da5be637bb8b3aa"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055094 - Remove Fxa-Tokens on Error rather then after use r=ip-protection-reviewers,apopov\" for causing xpc failures @ test_GuardianClient.js\n\nThis reverts commit c623f85bf2c418d63e44981baca686ebbe3021bd.\n", "files": ["toolkit/components/ipprotection/GuardianTypes.sys.mjs", "toolkit/components/ipprotection/enterprise/IPPEnterpriseAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/fxa/IPPAndroidAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_GuardianClient.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPFxaActivateAuthProvider.js"], "git_node": "b382a87a085563635380387bb6089ca23894c0f2", "git_parents": ["40eacbc882fa15a0d1920a14b6869b290cc01f32"], "node": "5624cfb7e30329fe632c83275868407c76bd5361", "parents": ["85a95233d3d9a376ef4fc35e4f170aa09c961902"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072037 - Sort sponsored tiles in TopSitesFeed r=mconley\n\nEnsure that sponsored tiles are sorted in TopSitesFeed.\nSort order is determined by location in placements array.\nThis was the implicit behavior before, relying upon\nMARS responsing with JSON keys in order, and then JS objects\nmaintaining iteration in insertion order.\nWhen calling through MAC the interop does not maintain this.\nInstead TopSitesFeed makes sure the order is as desired.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326297\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "9d1ee51a9a043bbdae9c7c731dd7b0c0b028dfd4", "git_parents": ["b382a87a085563635380387bb6089ca23894c0f2"], "node": "0a26150bce136b6a43c83976867148cd8815302e", "parents": ["5624cfb7e30329fe632c83275868407c76bd5361"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074166 - Avoid making all of gkrust depend on nss builds. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327877\n", "files": ["toolkit/library/rust/moz.build"], "git_node": "ecd323dc71d74f93eececa08109185604d4f956b", "git_parents": ["9d1ee51a9a043bbdae9c7c731dd7b0c0b028dfd4"], "node": "dd25bb7675d48a00addb6ee4d396631856693cf9", "parents": ["0a26150bce136b6a43c83976867148cd8815302e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064678 - Add gtest coverage for encoding below Android's real per-frame macroblock cap at a Level 5-implied resolution. r=media-playback-reviewers,jolin\" for causing build bustages @ TestMediaDataEncoder.cpp\n\nThis reverts commit e3721994177f51ce9c0eb4041152b34ee7d7d05c.\n\nRevert \"Bug 2064678 - Report H264 QP thresholds from WebrtcMediaDataEncoder so libwebrtc's QualityScaler can track it. r=webrtc-reviewers,ng\"\n\nThis reverts commit d9a74ad9e1ae59fa0df05c844563ed0f88c79770.\n\nRevert \"Bug 2064678 - Balance the leaked active-request count when RemoteManager.createCodec() fails to init a codec. r=media-playback-reviewers,geckoview-reviewers,jolin,tcampbell\"\n\nThis reverts commit b3668c3b986e0ab41df32e8d3633d1f79432d300.\n\nRevert \"Bug 2064678 - Plumb H264 profile and level into AndroidDataEncoder, matching the GMP/FFmpeg/Apple/WMF encoder backends. r=media-playback-reviewers,geckoview-reviewers,padenot,tcampbell\"\n\nThis reverts commit 3de8bed1c06901ee49f87cc119b4c8e16734801e.\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp", "dom/media/platforms/android/AndroidDataEncoder.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataEncoderCodec.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteManager.java", "widget/android/bindings/MediaCodec-classes.txt"], "git_node": "9de008e71cdf2d13144df3ce28020fbc145a81d2", "git_parents": ["ecd323dc71d74f93eececa08109185604d4f956b"], "node": "84c441eb7b118f0b84f751294fbfde8bdd2a21d4", "parents": ["dd25bb7675d48a00addb6ee4d396631856693cf9"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074159 - Handle null values in policy objects. r=joporter\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327872\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/tests/xpcshell/test_null_policy_value.js", "toolkit/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "22eb89c0d49cdf8a52772a177ce511ef7752d612", "git_parents": ["9de008e71cdf2d13144df3ce28020fbc145a81d2"], "node": "dd9e0f413117aacded0357eeb01d068c369d26c0", "parents": ["84c441eb7b118f0b84f751294fbfde8bdd2a21d4"], "tags": []}, {"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066543 - VoiceOver support for About Firefox \u003e Share Firefox link r=nbarrett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325134\n", "files": ["browser/base/content/aboutDialog.js", "browser/base/content/test/browser-about/browser_aboutDialog_referrals.js"], "git_node": "ad27e8fce178235eb80ec0f489eb30857d90700b", "git_parents": ["22eb89c0d49cdf8a52772a177ce511ef7752d612"], "node": "0c6e50a5dee89112aee77eaad75583f50ff5d8ff", "parents": ["dd9e0f413117aacded0357eeb01d068c369d26c0"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068338: Destroy a stale fontGroup in SetFontInternalDisconnected. r=lsalzman\n\nThis ensures that the fontGroup is not pointing at a dead PresContext.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324734\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "86f03e3bc75fb813ef27c2cbc94e47e846de1954", "git_parents": ["ad27e8fce178235eb80ec0f489eb30857d90700b"], "node": "32ac7bc8a0db79800452929488424a0a9470fccf", "parents": ["0c6e50a5dee89112aee77eaad75583f50ff5d8ff"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069638 - Keep SQLite temporary storage in memory for encrypted storage connections. r=dom-storage-reviewers,jari\n\nEncrypted connections now set PRAGMA temp_store = 2 in\nConnection::initializeInternal so statement subjournals, sorter runs and\ntemp tables never go through the unencrypted temp-file path on builds that\ndo not default SQLITE_TEMP_STORE to memory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326736\n", "files": ["storage/mozStorageConnection.cpp", "third_party/sqlite3/src/moz.build"], "git_node": "7214bbf13592454ca5b9d9af33418e8afcc5e3c8", "git_parents": ["86f03e3bc75fb813ef27c2cbc94e47e846de1954"], "node": "1f57edab30c74c5b173986d48ad64c0f3b4d5e83", "parents": ["32ac7bc8a0db79800452929488424a0a9470fccf"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2071069 - Update buffer calcs in nsStorageStream, r=xpcom-reviewers,mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327888\n", "files": ["xpcom/io/nsStorageStream.cpp"], "git_node": "9b473c3cc2b16e091d533f97e5d26c0bcb21cc74", "git_parents": ["7214bbf13592454ca5b9d9af33418e8afcc5e3c8"], "node": "1741efb72eb45b8e2473b7256f27c6ab701684dc", "parents": ["1f57edab30c74c5b173986d48ad64c0f3b4d5e83"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071446 - Fix test failure in browser_localSearchShortcuts_xul.js caused when too many search engines are listed. r=settings-reviewers,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327419\n", "files": ["browser/components/preferences/tests/search/browser_localSearchShortcuts_xul.js"], "git_node": "fe9709f14a7154a529767f2e0f51e7f78849c988", "git_parents": ["9b473c3cc2b16e091d533f97e5d26c0bcb21cc74"], "node": "43c6f112f1b3c8ad5a5a633b498029aa088cc35c", "parents": ["1741efb72eb45b8e2473b7256f27c6ab701684dc"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069848 - Show the more settings menu item in browser screen's menu r=android-reviewers,giorga\n\nThis will later be configured to shows other menu items when expanded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326408\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/ExpandableHeaderItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/menu/MoreMenuItemsProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/menu/MoreMenuItemsProviderTest.kt"], "git_node": "10aec4d1de19808fb366bdaa38ff0b8d1207c97c", "git_parents": ["fe9709f14a7154a529767f2e0f51e7f78849c988"], "node": "c9e4ecb5b33eeff9833feb4a103cadaeeab1fc04", "parents": ["43c6f112f1b3c8ad5a5a633b498029aa088cc35c"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069849 - Show the translations menu item in browser screen's menu r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326409\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/ExpandableHeaderItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/BrowserMenuBuilderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/translations/TranslationsMenuItemProviderTest.kt"], "git_node": "78e7b25bff0c4424171d337f88d8e63c4020af27", "git_parents": ["10aec4d1de19808fb366bdaa38ff0b8d1207c97c"], "node": "8ad208c86055e945858bc0fe31cb0df495a5eb55", "parents": ["c9e4ecb5b33eeff9833feb4a103cadaeeab1fc04"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069851 - part 1 - Show the \"Summarize page\" menu item in browser screen's menu r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326507\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/ExpandableHeaderItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProvider.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProviderTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "b96831df415cce28dd25bd9f122b36bcab17356a", "git_parents": ["78e7b25bff0c4424171d337f88d8e63c4020af27"], "node": "b8016304bf8dd7863eac7ec4b137cf73363c78cf", "parents": ["8ad208c86055e945858bc0fe31cb0df495a5eb55"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069851 - part 2 - Highlight \"More\" to drag attention to the summarize page menu item r=android-reviewers,giorga\n\nSome constraints needed to be supported:\n- what subMenu items are shown in \"More\" is only known after \"More\" is built\n- the \"Summarize page\" menu item may be moved out / removed by the user (to be supported later)\n- whether to highlight \"Summarize page\" and \"More\" uses different conditions\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326508\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/menu/MoreMenuItemsProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/ExpandableMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProvider.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/menu/MoreMenuItemsProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/BrowserMenuBuilderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt"], "git_node": "157068d02b3d769ff3af92bd90dca350138e6344", "git_parents": ["b96831df415cce28dd25bd9f122b36bcab17356a"], "node": "c15b29115e18447b420e176610d4dfd0e57711f2", "parents": ["b8016304bf8dd7863eac7ec4b137cf73363c78cf"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069852 - Show the \"Move to non-private tab\" menu item in browser screen's menu r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326557\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/menu/MoveToNormalTabsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/menu/MoveToNormalTabsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt"], "git_node": "90dbf8787f048b51b72285bd70f99c3b2937d5f5", "git_parents": ["157068d02b3d769ff3af92bd90dca350138e6344"], "node": "bec74828c64262cd78fa5655f6e0472abc73c02c", "parents": ["c15b29115e18447b420e176610d4dfd0e57711f2"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "des