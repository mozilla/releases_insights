//phabricator.services.mozilla.com/D325830\n", "files": ["dom/ipc/FilePickerParent.cpp", "widget/gtk/nsFilePicker.cpp", "widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h"], "git_node": "3d39d95ab1c8224b0656cef64e952d9d380ab957", "git_parents": ["ce1623da27625b0414b3a73a001467063520fde3"], "node": "254ef03b837664857a790e6a4efd98f00e0eb45e", "parents": ["2c6dc4b6cf607b9552273f94f2eeaa8a561c8923"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070833 - sign linux64 langpacks. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nBug 2069240 added the ability to sign l10n repacks from non-shippable\nbuilds, but missed a list of platforms where langpacks are signed.  Add\nlinux64/opt so it behaves the same as its shippable friend.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325344\n", "files": ["taskcluster/gecko_taskgraph/util/signed_artifacts.py"], "git_node": "4ee009668ab9514e9d94d7a858a60134ad8b9399", "git_parents": ["3d39d95ab1c8224b0656cef64e952d9d380ab957"], "node": "8de4f5184c2b2e9eb7e5135941d78f4b5113336b", "parents": ["254ef03b837664857a790e6a4efd98f00e0eb45e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070833 - enable repackage-deb-l10n for regular opt builds. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nHandle non-chunked l10n-signing, and avoid inheriting the build's\nrun-on-projects so the new tasks only run on-demand.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325345\n", "files": ["taskcluster/gecko_taskgraph/transforms/l10n_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_l10n.py", "taskcluster/kinds/repackage-deb-l10n/kind.yml"], "git_node": "c70328a227e1d50c695dc3f8a688d8e23c9e9e69", "git_parents": ["4ee009668ab9514e9d94d7a858a60134ad8b9399"], "node": "61bfc3593fcd1016cc56dfec63d562df39bc8ccb", "parents": ["8de4f5184c2b2e9eb7e5135941d78f4b5113336b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070833 - run deb repackage as non-root. r=releng-reviewers,bhearsum\n\nUse unshare so chroot is available as an unprivileged user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325346\n", "files": ["python/mozbuild/mozbuild/repackaging/deb.py", "python/mozbuild/mozbuild/test/repackaging/test_deb.py", "taskcluster/kinds/repackage-deb-l10n/kind.yml", "taskcluster/kinds/repackage-deb/kind.yml"], "git_node": "72b421e4a7a0e6f54c2dac5e5d9b2ac949c928ba", "git_parents": ["c70328a227e1d50c695dc3f8a688d8e23c9e9e69"], "node": "a171e6d1e7ec7a31cd03d2641a04bfdfcec8e5ed", "parents": ["61bfc3593fcd1016cc56dfec63d562df39bc8ccb"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070833 - run rpm repackage as non-root. r=releng-reviewers,bhearsum\n\nUse unshare to be able to chroot as an unprivileged user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325347\n", "files": ["python/mozbuild/mozbuild/repackaging/rpm.py", "python/mozbuild/mozbuild/test/repackaging/test_rpm.py", "taskcluster/kinds/repackage-rpm/kind.yml"], "git_node": "e7ed4bef52fbd6a2739d6beaf888e1249f47ebe5", "git_parents": ["72b421e4a7a0e6f54c2dac5e5d9b2ac949c928ba"], "node": "2e16aad9fec586d0861fbd2859f362b5536656e3", "parents": ["a171e6d1e7ec7a31cd03d2641a04bfdfcec8e5ed"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2070833 - Add gecko cache to repackage-{deb,rpm} r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324896\n", "files": ["taskcluster/docker/debian-repackage/Dockerfile", "taskcluster/docker/rpm-repackage/Dockerfile", "taskcluster/kinds/repackage-deb-l10n/kind.yml", "taskcluster/kinds/repackage-deb/kind.yml", "taskcluster/kinds/repackage-rpm/kind.yml"], "git_node": "db823a82d13517c239e9130723b2e1f6d5097a23", "git_parents": ["e7ed4bef52fbd6a2739d6beaf888e1249f47ebe5"], "node": "8aabe2366fb14f1fb1523b31628831dbc91a2da5", "parents": ["2e16aad9fec586d0861fbd2859f362b5536656e3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071695 - build funsize-update-generator image on top of debian12-base. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nUse our own base image instead of pulling from docker hub, to get\nreproducible/snapshotted packages; update from debian 11 to 12.\n\nReplace /home/worker paths with /builds/worker following the base image's $HOME.\n\nUpdate funsize's requirements.txt for python 3.11.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326082\n", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile", "taskcluster/docker/funsize-update-generator/requirements.txt", "taskcluster/docker/funsize-update-generator/runme.sh", "taskcluster/gecko_taskgraph/transforms/partials.py", "taskcluster/kinds/docker-image/kind.yml"], "git_node": "a1153607aafd0098143c9c032f25f015d69c6dd6", "git_parents": ["db823a82d13517c239e9130723b2e1f6d5097a23"], "node": "a78fc9a739a9206cde3c031b0aca45d08633c8ab", "parents": ["8aabe2366fb14f1fb1523b31628831dbc91a2da5"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069288 - Make tests using XSLT flip the pref on. r=dom-core-reviewers,layout-reviewers,dom-worker-reviewers,emilio,smaug,edenchuang\" for causing reftests failures\n\nThis reverts commit 6e0998406503c7df86c96826fc0dc9cc76b6b87e.\n", "files": ["browser/components/resistfingerprinting/test/browser/browser-xslt.toml", "browser/components/resistfingerprinting/test/browser/browser.toml", "docshell/test/chrome/chrome-xslt.toml", "docshell/test/chrome/chrome.toml", "dom/base/test/mochitest-bug1.toml", "dom/base/test/mochitest-bug2.toml", "dom/base/test/mochitest-xslt.toml", "dom/events/test/mochitest-xslt.toml", "dom/events/test/mochitest.toml", "dom/html/test/mochitest-bug1.toml", "dom/html/test/mochitest-xslt.toml", "dom/security/permissionspolicy/test/mochitest/mochitest-xslt.toml", "dom/security/permissionspolicy/test/mochitest/mochitest.toml", "dom/security/test/csp/mochitest-xslt.toml", "dom/security/test/csp/mochitest.toml", "dom/serviceworkers/test/mochitest-common.toml", "dom/tests/mochitest/bugs/mochitest-xslt.toml", "dom/tests/mochitest/bugs/mochitest.toml", "dom/tests/mochitest/general/mochitest-xslt.toml", "dom/tests/mochitest/general/mochitest.toml", "dom/tests/reftest/reftest.list", "dom/tests/reftest/xml-stylesheet/reftest.list", "dom/xml/test/mochitest-xslt.toml", "dom/xml/test/mochitest.toml", "dom/xslt/crashtests/crashtests.list", "dom/xslt/tests/browser/browser.toml", "dom/xslt/tests/mochitest/mochitest.toml", "layout/reftests/bugs/reftest.list", "testing/web-platform/meta/content-security-policy/xslt/__dir__.ini", "testing/web-platform/meta/dom/idlharness.window.js.ini", "testing/web-platform/meta/service-workers/service-worker/xsl-base-url.https.html.ini", "testing/web-platform/meta/xml/xslt/__dir__.ini"], "git_node": "1cdd9f41996b50e669a8042832c7e02083653ece", "git_parents": ["a1153607aafd0098143c9c032f25f015d69c6dd6"], "node": "ed72a86ddcf5a7dd7bd2a7dad7e8ca3c1b8c8372", "parents": ["a78fc9a739a9206cde3c031b0aca45d08633c8ab"], "tags": []}, {"author": "Antti Koivisto \u003cantti@apple.com\u003e", "branch": "default", "desc": "Bug 2071296 [wpt PR 62619] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323871, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=323871 (#62619)\n--\n\nwpt-commits: de5e915b9c4f9b7a7f40ee47127639d793acc33e\nwpt-pr: 62619\n", "files": ["testing/web-platform/tests/css/selectors/attribute-selectors/attribute-case/cssom.html"], "git_node": "af569b7c4d8420812665771a9e3ad1ddba517e7a", "git_parents": ["1cdd9f41996b50e669a8042832c7e02083653ece"], "node": "92e027dda44859df7d019ce7ce92e3d516568c95", "parents": ["ed72a86ddcf5a7dd7bd2a7dad7e8ca3c1b8c8372"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2071305 [wpt PR 62620] - Revert \"Silently ignore unknown CSS URL modifiers\", a=testonly\n\nAutomatic update from web-platform-tests\nRevert \"Silently ignore unknown CSS URL modifiers\"\n\nThis reverts commit b4f711bd71df7e0d3079f359bad36cfb744ed9e4.\n\nThe CSSWG[1] resolved to making url() values invalid for unknown modifiers.\n\nNot adding a kill-switch since this was recently shipped.\n\n[1] https://github.com/w3c/csswg-drafts/issues/14056#issuecomment-5605312744\n\nBug: 559175801\nChange-Id: I0b4786fce8ccd95e2d59ec18f2c3feb70a5d872f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8397686\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nReviewed-by: jj \u003cjj@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1696057}\n\n--\n\nwpt-commits: 85235b8e6ee3d09e14a98108a2baf612d6b47b08\nwpt-pr: 62620\n", "files": ["testing/web-platform/tests/css/css-values/urls/url-request-modifiers-font-face-parsing.html", "testing/web-platform/tests/css/css-values/urls/url-request-modifiers-invalid.sub.html", "testing/web-platform/tests/css/css-values/urls/url-request-modifiers-serialize.sub.html"], "git_node": "aad5b73f80ceec7f1869a0068a498bef32245696", "git_parents": ["af569b7c4d8420812665771a9e3ad1ddba517e7a"], "node": "691d901054d887290768a044662a3a87fa899482", "parents": ["92e027dda44859df7d019ce7ce92e3d516568c95"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071305 [wpt PR 62620] - Update wpt metadata, a=testonly\n\nwpt-pr: 62620\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/urls/url-request-modifiers-font-face-parsing.html.ini"], "git_node": "01fc6fd5aa53f6be86e941b6ee09b4664238887f", "git_parents": ["aad5b73f80ceec7f1869a0068a498bef32245696"], "node": "b8c4786a7b0e912bd95adf0345fc6baca5813eb8", "parents": ["691d901054d887290768a044662a3a87fa899482"], "tags": []}, {"author": "pchodur \u003cpchodur@google.com\u003e", "branch": "default", "desc": "Bug 2071344 [wpt PR 62628] - [AWC] Add resizable media query feature boolean evaluation, a=testonly\n\nAutomatic update from web-platform-tests\n[AWC] Add resizable media query feature boolean evaluation\n\nThis commit modifies the resizable media query feature to evaluate to\nfalse in the boolean context for non-resizable windows. Before the\nchange, it always evaluated to true no matter whether the window was\nresizable or not. This is related with the Window Management feature\nspecification changes which explicitly define such evaluation.\n\nBug: 288265319\nChange-Id: Iceabf6c131e28dfdf6994187a1b11e796a6a6964\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8379991\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCommit-Queue: Patryk Chodur \u003cpchodur@google.com\u003e\nReviewed-by: Jan Keitel \u003cjkeitel@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1696107}\n\n--\n\nwpt-commits: 9cfc99b56257508c6252b204b286787f3dd16020\nwpt-pr: 62628\n", "files": ["testing/web-platform/tests/css/mediaqueries/resizable.tentative.html"], "git_node": "75c18497ab30249442c16a87365424dbc0508153", "git_parents": ["01fc6fd5aa53f6be86e941b6ee09b4664238887f"], "node": "3d73098e5d7bb246add9dc8ecea8d87e717f26d0", "parents": ["b8c4786a7b0e912bd95adf0345fc6baca5813eb8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071344 [wpt PR 62628] - Update wpt metadata, a=testonly\n\nwpt-pr: 62628\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/mediaqueries/resizable.tentative.html.ini"], "git_node": "91392b7a9212ae56a70713958f8f4d73262c8202", "git_parents": ["75c18497ab30249442c16a87365424dbc0508153"], "node": "7772a8bedd407806b76c23768817bad85516fda7", "parents": ["3d73098e5d7bb246add9dc8ecea8d87e717f26d0"], "tags": []}, {"author": "Daniil Sakhapov \u003csakhapov@chromium.org\u003e", "branch": "default", "desc": "Bug 2071353 [wpt PR 62625] - Untentative CSSPseudoElement WPT test, a=testonly\n\nAutomatic update from web-platform-tests\nUntentative CSSPseudoElement WPT test\n\nThe spec now supports '::backdrop':\nhttps://drafts.csswg.org/css-pseudo-4/#ref-for-dom-csspseudoelement-type\n\nChange-Id: I1004f4f204f8ece2fb85b652ece5b068b494aa4d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8391917\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Daniil Sakhapov \u003csakhapov@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1696128}\n\n--\n\nwpt-commits: 129bedbd2471f6065eea146c0c1ac302dd25141c\nwpt-pr: 62625\n", "files": ["testing/web-platform/tests/css/css-pseudo/backdrop-pseudo-element-click.html", "testing/web-platform/tests/css/css-pseudo/backdrop-pseudo-element-click.tentative.html"], "git_node": "2d876273daf4af4911181543bdd9529c0b1ede7c", "git_parents": ["91392b7a9212ae56a70713958f8f4d73262c8202"], "node": "445174a273e3932028705c86d968fd8f3fffa4c6", "parents": ["7772a8bedd407806b76c23768817bad85516fda7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071353 [wpt PR 62625] - Update wpt metadata, a=testonly\n\nwpt-pr: 62625\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-pseudo/backdrop-pseudo-element-click.html.ini", "testing/web-platform/meta/css/css-pseudo/backdrop-pseudo-element-click.tentative.html.ini"], "git_node": "3e6f46812e8c2ee2c03812c9030f3057f136f63a", "git_parents": ["2d876273daf4af4911181543bdd9529c0b1ede7c"], "node": "76d1311c85705d4bb4c637dc47417f5dee8d76c5", "parents": ["445174a273e3932028705c86d968fd8f3fffa4c6"], "tags": []}, {"author": "Ari Chivukula \u003carichiv@chromium.org\u003e", "branch": "default", "desc": "Bug 2061025 [wpt PR 61761] - Fix typos in GPC docs, a=testonly\n\nAutomatic update from web-platform-tests\nFix typos in GPC docs\n--\n\nwpt-commits: 433b7dda826de47f9a23879dbb4abaf61f45d555\nwpt-pr: 61761\n", "files": ["testing/web-platform/tests/docs/writing-tests/testdriver.md", "testing/web-platform/tests/resources/testdriver.js"], "git_node": "60c77e55f7d8ce139b8f2b6dc182af4d5726bd91", "git_parents": ["3e6f46812e8c2ee2c03812c9030f3057f136f63a"], "node": "e9f4a28c9f825163cf2c80447af0b05a2074b11f", "parents": ["76d1311c85705d4bb4c637dc47417f5dee8d76c5"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2071048 [wpt PR 62593] - HTML parser: additional CDATA coverage, a=testonly\n\nAutomatic update from web-platform-tests\nHTML parser: additional CDATA coverage\n\n--\n\nwpt-commits: cd67e0a5758a54300b90c480b678956ee9b475a0\nwpt-pr: 62593\n", "files": ["testing/web-platform/tests/html/syntax/parsing/cdata-in-integration-point-fragment.html"], "git_node": "12a67d4c3eba9cb8cbe64243fd538ca4a4565e69", "git_parents": ["60c77e55f7d8ce139b8f2b6dc182af4d5726bd91"], "node": "195bdf59953b4ab3508f18ecdfe7d08dabd5b2b3", "parents": ["e9f4a28c9f825163cf2c80447af0b05a2074b11f"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2071144 [wpt PR 62599] - HTML parser: more U+0000 tests, a=testonly\n\nAutomatic update from web-platform-tests\nHTML parser: more U+0000 tests\n\n--\n\nwpt-commits: 12093d1ba7ef01a87eae26be626db72489e55ddf\nwpt-pr: 62599\n", "files": ["testing/web-platform/tests/html/syntax/parsing/resources/plain-text-unsafe.dat"], "git_node": "351b0f41931ca801f93f2c4d0c8a3b01eb8fa8ec", "git_parents": ["12a67d4c3eba9cb8cbe64243fd538ca4a4565e69"], "node": "49bf1e5856216015e73e786ff715e8ed30d552c6", "parents": ["195bdf59953b4ab3508f18ecdfe7d08dabd5b2b3"], "tags": []}, {"author": "Ari Chivukula \u003carichiv@chromium.org\u003e", "branch": "default", "desc": "Bug 2071452 [wpt PR 62631] - Prevent flood/lighting/stop-color from leaking :visited, a=testonly\n\nAutomatic update from web-platform-tests\nPrevent flood/lighting/stop-color from leaking :visited\n\nAs demonstrated in the added tests, it was possible to use\nanimations/transitions to extract :visited status of links via\nproperties readable in JavaScript. This is disallowed per:\nhttps://drafts.csswg.org/css-pseudo/#highlight-security\n\nThis CL splits off visited properties into their own internal records,\nfollowing the pattern for all other properties in Set/GetVisitedColor.\n\nNO_IFTTT=No enums generated for internal entries\n\nSkip-Clang-Tidy-Checks: google-default-arguments\nFixed: 517708426\nChange-Id: I02b4862843723b5d76e391d7dcf39a001ed9af63\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8373342\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCommit-Queue: Ari Chivukula \u003carichiv@chromium.org\u003e\nAuto-Submit: Ari Chivukula \u003carichiv@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1696291}\n\n--\n\nwpt-commits: 312e7469235daf55e5a4baa7d227c1636ce34349\nwpt-pr: 62631\n", "files": ["testing/web-platform/tests/css/css-animations/svg-color-visited-currentcolor.html", "testing/web-platform/tests/css/css-color/color-svg-visited-ref.html", "testing/web-platform/tests/css/css-color/color-svg-visited.html"], "git_node": "273209da1fed1fb2c2a80bce69be1f51f53d1d86", "git_parents": ["351b0f41931ca801f93f2c4d0c8a3b01eb8fa8ec"], "node": "2eeee9d9aef8d4918c406ec2855d999b603b2172", "parents": ["49bf1e5856216015e73e786ff715e8ed30d552c6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071452 [wpt PR 62631] - Update wpt metadata, a=testonly\n\nwpt-pr: 62631\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color/color-svg-visited.html.ini"], "git_node": "4dfd992e2c29823fa4b29d451a846b93f063ca98", "git_parents": ["273209da1fed1fb2c2a80bce69be1f51f53d1d86"], "node": "0d3246effdfef77fc652ae129008f9773f0aff24", "parents": ["2eeee9d9aef8d4918c406ec2855d999b603b2172"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2071453 [wpt PR 62633] - Roll jxl: 0.7.1 =\u003e 0.7.2 in //third_party/rust, a=testonly\n\nAutomatic update from web-platform-tests\nRoll jxl: 0.7.1 =\u003e 0.7.2 in //third_party/rust\n\nUpdate the jxl crate family to 0.7.2 and regenerate the vendored\nsources and GN metadata.\n\nBug: None\nChange-Id: I25317e0b8a1451e4ef89d25ac89f791189ee1649\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8390637\nReviewed-by: Manish Goregaokar \u003cmanishearth@google.com\u003e\nAuto-Submit: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: \u0141ukasz Anforowicz \u003clukasza@chromium.org\u003e\nCommit-Queue: \u0141ukasz Anforowicz \u003clukasza@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1696297}\n\n--\n\nwpt-commits: db5eaa9bc4aab9b35bd9fb051a3a980f0088f751\nwpt-pr: 62633\n", "files": ["testing/web-platform/tests/jpegxl/resources/progressive-1-ref.png"], "git_node": "52d0f89059d09441ea197e1d16eefdf5141d4530", "git_parents": ["4dfd992e2c29823fa4b29d451a846b93f063ca98"], "node": "369b56e29ba4b614b4fcf71025482e24035bf54c", "parents": ["0d3246effdfef77fc652ae129008f9773f0aff24"], "tags": []}, {"author": "Kevin Ellis \u003ckevers@google.com\u003e", "branch": "default", "desc": "Bug 2071170 [wpt PR 62609] - [sda] Sanitize web exposed timeline subject, a=testonly\n\nAutomatic update from web-platform-tests\n[sda] Sanitize web exposed timeline subject\n\nPreviously fixed for timeline source, but the same fix is required\nfor the timeline subject.\n\nBug: 559141765\nChange-Id: Idfcf8d80a04c27bbaadb13485f5efd249ff53430\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8323087\nReviewed-by: Free Debreuil \u003cfreedebreuil@google.com\u003e\nCommit-Queue: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1696332}\n\n--\n\nwpt-commits: 6bb72142cd13290ab35e1638c937d154318104ce\nwpt-pr: 62609\n", "files": ["testing/web-platform/tests/scroll-animations/crashtests/remove-pseudo-element-subject.html", "testing/web-platform/tests/scroll-animations/css/view-timeline-on-pseudo.html"], "git_node": "28be02f3e0acdab17658bb82b6f2fed50eaf72e3", "git_parents": ["52d0f89059d09441ea197e1d16eefdf5141d4530"], "node": "5bc05c567ef91bd2e886c210cf3cc5e8a5380640", "parents": ["369b56e29ba4b614b4fcf71025482e24035bf54c"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2071177 [wpt PR 62612] - [FlexLayout] Ensure `flow-start` and `flow-end` have the same behavior as `flex-start` and `flex-end`, a=testonly\n\nAutomatic update from web-platform-tests\n[FlexLayout] Ensure `flow-start` and `flow-end` have the same behavior as `flex-start` and `flex-end`\n\nEnsure that `flow-start` and `flow-end` has the same behavior as\n`flex-start` and `flex-end` in all layouts as resolved in the CSSWG [1].\nNote that `flow-start/end` are gated behind the `CSSFlowStartAndEnd`\nflag.\n\nThere will be a follow-up change to have `kFlowStart/End` actually\nresolve to `kFlexStart/End` in the codebase, as well as to correctly\nimplement the expected behavior in Grid-Lanes when reversals are\npresent, as specified in the CSSWG issue [1].\n\n[1] https://github.com/w3c/csswg-drafts/issues/14052\n\nBug: 555299635\nChange-Id: I3ac19c52fe1e92f8c0a8448b4758d4a46bcba5e6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8331927\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1696453}\n\n--\n\nwpt-commits: a4a3b788edf0c4935081c95d5309fb7b39a8eaa8\nwpt-pr: 62612\n", "files": ["testing/web-platform/tests/css/css-flexbox/alignment/f