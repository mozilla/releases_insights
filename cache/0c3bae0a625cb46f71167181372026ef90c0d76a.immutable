ents": ["442640e69a2e6db36345c194316398e3edf740d0"], "node": "d3d791bb19cd84020fc0428f10a0dd93d36b53a4", "parents": ["8e5c5f599b04ea5e25b63facdc18cc6c1d68e3fc"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070977 - add hashes arg to the openNewtab function r=omc-reviewers,emcminn\" for causing doc generate failures.\n\nThis reverts commit c7f4c2a16cc1373e34d5182a835665aeebaddb3d.\n", "files": ["browser/components/uitour/UITour-lib.js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_showNewTab.js"], "git_node": "10bec2a6bc2b1c28228725e9e731581a11fcd978", "git_parents": ["a0a15400ddadfc1273f1d03b803786fc2fb013bb"], "node": "0c7006ce1f41498538f7134af5b0449644f39418", "parents": ["d3d791bb19cd84020fc0428f10a0dd93d36b53a4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060887 - Fix iOS builds.\n", "files": ["dom/ipc/WindowGlobalChild.cpp"], "git_node": "9a6694c9c23da580518939aa072a4ce903c24ced", "git_parents": ["10bec2a6bc2b1c28228725e9e731581a11fcd978"], "node": "1abedae9b9e64714d91d2c2f04873fda25c9f3c9", "parents": ["0c7006ce1f41498538f7134af5b0449644f39418"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060887 - Fix iOS builds.\"\n\nThis reverts commit 9a6694c9c23da580518939aa072a4ce903c24ced.\n", "files": ["dom/ipc/WindowGlobalChild.cpp"], "git_node": "08cafcb8206811562089b26914460a4c2fbeb233", "git_parents": ["9a6694c9c23da580518939aa072a4ce903c24ced"], "node": "24ae016deba6a37811d76c659ecacc00f3142d2b", "parents": ["1abedae9b9e64714d91d2c2f04873fda25c9f3c9"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060887 - Deal with mozPrintCallback in OOP iframes. r=gfx-reviewers,lsalzman\" for causing bustages in MozPrintCallbackRunner.h\n\nThis reverts commit 442640e69a2e6db36345c194316398e3edf740d0.\n", "files": ["dom/ipc/WindowGlobalChild.cpp", "layout/generic/nsHTMLCanvasFrame.cpp", "layout/generic/nsPageSequenceFrame.cpp", "layout/generic/nsPageSequenceFrame.h", "layout/printing/MozPrintCallbackRunner.cpp", "layout/printing/MozPrintCallbackRunner.h", "layout/printing/moz.build", "layout/printing/nsPrintJob.cpp", "layout/printing/nsPrintJob.h", "testing/web-platform/mozilla/meta/dom/mozPrintCallback/window-print-mozPrintCallback-oop-iframe-001.sub.html.ini", "testing/web-platform/mozilla/tests/dom/mozPrintCallback/support/mozPrintCallback-oop-iframe-frame.html", "testing/web-platform/mozilla/tests/dom/mozPrintCallback/window-print-mozPrintCallback-oop-iframe-001.sub.html"], "git_node": "ffc94962c1f15f4e096218abf5083df36f8fe176", "git_parents": ["08cafcb8206811562089b26914460a4c2fbeb233"], "node": "362abe64d538ac8922b920f745265cad67e779cf", "parents": ["24ae016deba6a37811d76c659ecacc00f3142d2b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge Mozilla-central to autoland\n", "files": ["third_party/libwebrtc/moz-patch-stack/3ce78cdbd8.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/5c10f93376.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/9b33b6c524.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/bb91915655.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/c84dbe590a.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/f93c4fefee.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/moz-patch-stack/s0149.patch", "third_party/libwebrtc/moz-patch-stack/s0150.patch", "third_party/libwebrtc/rtc_base/experiments/psnr_experiment.cc", "third_party/libwebrtc/rtc_base/experiments/psnr_experiment.h", "third_party/libwebrtc/rtc_base/experiments/psnr_experiment_gn/moz.build", "third_party/libwebrtc/rtc_base/experiments/psnr_experiment_unittest.cc"], "git_node": "3991894e6417bf24abb668f880a34350a2f6f5c9", "git_parents": ["ffc94962c1f15f4e096218abf5083df36f8fe176", "6c74efe2fcddf84b6f320959064a66946b4a1759"], "node": "76c8d61b641c47b8f0942d5dabb39e5e8f110551", "parents": ["362abe64d538ac8922b920f745265cad67e779cf", "8c1187b2fe37c2780372efe712c41586a01154b6"], "tags": []}, {"author": "Molly Shillabeer \u003cmshillabeer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064098 - Extend Smart Form Fill telemetry with review dialog, tab selection, and pre-llm data r=gcardieri,omarg,vazish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325479\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/SmartFormFillModel.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillTelemetry.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_generation.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_metadata.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_outcomes.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_review.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_tab_selection.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_telemetry.js"], "git_node": "1ab4eb011448064de9991ac675340ced3308d4fb", "git_parents": ["3991894e6417bf24abb668f880a34350a2f6f5c9"], "node": "c9532616be2971af5b3d1966fd980439811152e3", "parents": ["76c8d61b641c47b8f0942d5dabb39e5e8f110551"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Resolve shader compile errors back to their .glsl file and line. r=gfx-reviewers,lsalzman\n\nShaderSourceMap records, for every line of the #include-expanded source, the\nfile and line it came from, and is built on every shader compile. Nothing read\nit: process_log had no callers, so a compile failure reported line numbers in\nthe expanded source, which corresponds to no file that can be opened.\n\nPlumb the map from build_shader_string through compute_source into\ncompile_shader, and parse the driver log through it. ShaderError now carries\nthe parsed diagnostics alongside the raw log so callers other than the log can\nreport them.\n\nThe log parser previously only understood Mesa's format; add the NVIDIA and\nANGLE forms and keep unrecognized lines verbatim rather than dropping them, so\nan unknown driver loses the location and not the message. This replaces\nprint_shader_errors, which guessed at a line number by parsing the log prefix\nby hand and only ran in debug builds.\n\nTwo failure-path fixes that the above makes reachable:\n\n- A failed link deleted the program object but left its id in the Program, so\n  the next frame re-linked a dead GL name and deinit double-deleted it. Clear\n  the id and drop the program, so the next bind builds a fresh one.\n- delete_program left the deleted id in Device::bound_program. GL recycles\n  names, so a program created afterwards could be handed the same id and\n  bind_program would skip its use_program call. Unbind on delete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325440\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader.rs"], "git_node": "71553df29ce6c7222e854bcce2afb610fcc5fe08", "git_parents": ["1ab4eb011448064de9991ac675340ced3308d4fb"], "node": "892f720adac73865b9ba79a08f66cab26fee33ea", "parents": ["c9532616be2971af5b3d1966fd980439811152e3"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Let shader sources be overridden in memory at runtime. r=gfx-reviewers,lsalzman\n\nDevice gains a map of .glsl sources keyed by file stem, consulted ahead of\nresource_override_path and the sources built into the binary. Because the\nlookup runs for every #include as well as the base file, overriding a shared\nfile such as shared.glsl or gpu_buffer.glsl reaches every shader that includes\nit.\n\nThree things have to follow the override rather than the built-in source:\n\n- ProgramSourceInfo must take the unoptimized path. The optimized variant is\n  preprocessed at build time and exists only for the built-in source, so\n  leaving it selected would silently ignore the override wherever optimized\n  shaders are enabled - which is the default in Firefox.\n- The source digest must be recomputed from the real source instead of reusing\n  the build-time one, and the debug assertion that compares the two has to\n  tolerate an override, exactly as it already does for resource_override_path.\n- The binary program cache must not be written, so that a throwaway edit\n  cannot outlive the session it was made in. Reads miss on their own, since\n  the digest differs.\n\nDeciding whether a variant is affected needs the set of files it pulls in, so\nwebrender_build gains shader_include_closure, built on the same #include walk\nas ShaderSourceParser. Device caches the result per shader while overrides are\ninstalled, and drops the cache when the override set changes, since an edit can\nadd or remove an #include. With no overrides installed the include graph is\nnever walked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325441\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender_build/src/shader.rs"], "git_node": "e310c4670c2d20c3c26e3e3b70419d07e644ffb9", "git_parents": ["71553df29ce6c7222e854bcce2afb610fcc5fe08"], "node": "6522a9eb424f01f169f745f5bc23fbd58d3ef936", "parents": ["892f720adac73865b9ba79a08f66cab26fee33ea"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Add a shader reload path that swaps programs atomically. r=gfx-reviewers,lsalzman\n\nShaderLoader::reload rebuilds every linked shader whose #include closure\ncontains the edited file, from whatever sources are currently in effect. The\nnew programs are built into a scratch list first and swapped in only once all\nof them have compiled and linked; a single failure deletes the scratch\nprograms and leaves the live ones alone, so a broken edit cannot stop the\ninstance from rendering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325442\n", "files": ["gfx/wr/webrender/src/renderer/shade.rs"], "git_node": "2fc2f5ad817e0c18f30eb5990b420b4903fe5d96", "git_parents": ["e310c4670c2d20c3c26e3e3b70419d07e644ffb9"], "node": "3333f4b9cb9784dd2a26471cb67cf08e19717dcc", "parents": ["6522a9eb424f01f169f745f5bc23fbd58d3ef936"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Expose shader sources and reloading over the debugger protocol. r=gfx-reviewers,lsalzman\n\nThree endpoints, all served from the render thread since they need the device\nand the shader list:\n\n- GET /query?type=shaders lists the .glsl files built into the instance, which\n  of them are overridden, and every shader variant with whether it has a\n  linked program. `supported` is false when the instance cannot recompile at\n  runtime.\n- GET /shader-source?name=X returns the source currently in effect for one\n  file. Adding &features=A,B returns the preprocessed source of that variant\n  instead, which is the text a driver log's line numbers refer to when the\n  location could not be resolved. The requested features are matched against\n  the registered variants rather than trusted, since expanding a variant needs\n  the 'static feature strings it was registered with.\n- POST /shader-source replaces a file's source, or drops the override when\n  `source` is null, and rebuilds the shaders it affects. A successful swap is\n  followed by GenerateFrame, so the next frame shows the edit. On failure the\n  override is rolled back, so the shaders still in use and the source the\n  client reads next stay in agreement.\n\nSWGL is rejected up front: it discards the GLSL it is handed and dispatches to\na program transpiled to C++ at build time, so there is nothing to recompile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325443\n", "files": ["gfx/wr/webrender/src/debugger.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_api/src/debugger.rs"], "git_node": "f31e3e2eb5202ac302fb674c5d0d219852aedee8", "git_parents": ["2fc2f5ad817e0c18f30eb5990b420b4903fe5d96"], "node": "71ad02744b09dfa38bbc9328594008bae76b749c", "parents": ["3333f4b9cb9784dd2a26471cb67cf08e19717dcc"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Stream shader build failures to connected debugger clients. r=gfx-reviewers,lsalzman\n\nPushing a source only rebuilds the variants that had already been compiled, so\na variant that had not been compiled yet fails when it is first used instead -\npossibly many frames after the push, with nothing left to reply to. Those\nfailures previously only reached the log of the process being debugged.\n\nCollect the shader errors accumulated while drawing each frame and forward them\nover the websocket as a new DebuggerMessage, which wrshell appends to its log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325444\n", "files": ["gfx/wr/webrender/src/debugger.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender_api/src/debugger.rs", "gfx/wr/wrshell/src/gui/mod.rs"], "git_node": "0dab8e258f03094b29542ebf2ef6275865dd2924", "git_parents": ["f31e3e2eb5202ac302fb674c5d0d219852aedee8"], "node": "031f3e09e3508b93679eb2c1c9b743f31d9f2aa3", "parents": ["71ad02744b09dfa38bbc9328594008bae76b749c"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Add a shader editor panel to the wrshell GUI. r=gfx-reviewers,lsalzman\n\nThe panel lists the .glsl files the connected instance was built with, marking\nthe ones that are overridden, opens one in a monospace editor, and pushes it\nback with Apply or Ctrl+Enter. Diagnostics from the reply are listed at the\nbottom, each quoting the line it points at, and the lines they refer to are\nunderlined in the editor.\n\nEdits are buffered per file, so switching files keeps them, and selecting a\nfile that is already buffered does not refetch it. Revert goes back to the\nsource WR last reported; Reset override drops the override in WR and restores\nthe source built into the binary.\n\nEach variant of the selected file is listed with whether it has a linked\nprogram, since only those are rebuilt by a push. Its preprocessed source can\nbe opened as a document, which is what a driver log's line numbers refer to\nwhen the location could not be resolved back to a file. An instance that\nprecaches asynchronously has nothing linked until it draws, so a push right\nafter startup rebuilds nothing; the panel says the override is installed\nrather than reporting a count of zero, which would read as a failure.\n\nDiagnostics streamed from a later frame are appended to the same list, so a\nvariant that was not linked at push time and failed when it was first used\nshows up in the panel rather than only in the shell log.\n\nThe saved layout version is bumped so existing configurations pick the new pane\nup instead of silently omitting it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325445\n", "files": ["gfx/wr/wrshell/src/gui/mod.rs", "gfx/wr/wrshell/src/gui/shaders.rs"], "git_node": "433fcf04866cd177a27d00cd0d5ed925dec8e033", "git_parents": ["0dab8e258f03094b29542ebf2ef6275865dd2924"], "node": "b2cb478560138b4c641068a661604f58c4259043", "parents": ["031f3e09e3508b93679eb2c1c9b743f31d9f2aa3"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Add shell commands for reading and replacing shader sources. r=gfx-reviewers,lsalzman\n\nget-shaders lists the files and variants, get-shader-source prints one file's\nsource (or, given a feature list, the preprocessed source of that variant),\nset-shader-source sends a local file and recompiles, and reset-shader-source\ndrops an override. Alongside the GUI panel this gives an edit-on-disk workflow\nand makes a shader change scriptable, which is what bisecting one needs.\n\nThese are the first commands to take parameters, which exposes a gap:\nCommandContext::arg_string indexes the argument map directly, and the GUI runs\nevery command with an empty map, so reading a parameter there panics even for\none the REPL treats as required. Add arg_opt and use it, reporting usage rather\nthan panicking when an argument is missing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325446\n", "files": ["gfx/wr/wrshell/src/command.rs", "gfx/wr/wrshell/src/debug_commands.rs"], "git_node": "f88f105f64f93aeaceacffbc833bc0373d399112", "git_parents": ["433fcf04866cd177a27d00cd0d5ed925dec8e033"], "node": "bf0bc02340bf874e838fd9a010998fdd2cbe5c52", "parents": ["b2cb478560138b4c641068a661604f58c4259043"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Document shader hot reloading in the wrshell README. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325447\n", "files": ["gfx/wr/wrshell/README.md"], "git_node": "e68329cdfe14c6035f2b707cb6f7bf3e6518b278", "git_parents": ["f88f105f64f93aeaceacffbc833bc0373d399112"], "node": "c4348d84a3612b3fb3481ac6cb971fbe5c7f4cd7", "parents": ["bf0bc02340bf874e838fd9a010998fdd2cbe5c52"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2071365 - Build the shader reloading state and API only with the debugger. r=gfx-reviewers,lsalzman\n\nNothing can install a source override unless the remote debugger is built in,\nso gate Device's override map and #include-closure cache, the API around them,\nand the reload path. The three of these reached from code that is not itself\ndebugger-only - get_shader_source, has_shader_source_override_for and\nProgramSourceInfo::from_source_override - get a second implementation for\nbuilds without the feature, so their callers need no cfg of their own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325893\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/shade.rs"], "git_node": "c73592233b27057012204db18a70d72d88680c43", "git_parents": ["e68329cdfe14c6035f2b707cb6f7bf3e6518b278"], "node": "02ad0bda6ab30eea2c9b2c30e6d236f7421cbcc3", "parents": ["c4348d84a3612b3fb3481ac6cb971fbe5c7f4cd7"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071426 - Fix nine-patch corner radius when the clip's space is flipped. r=gw\n\nget_prim_render_strategy maps the rounded rect clip's corner radius into the\nprimitive's space. Two spaces can share a coordinate system while being flipped\nwith respect to one another (for example with transform: rotate(180deg)), in\nwhich case the mapped vector has negative components.\n\nprepare_nine_patch builds the corner rects as min..min+radius and\nmax-radius..max, so a negative radius places the four masked corner segments\noutside of the nine-patch rect. The unmasked center segment then covers the\nrounded corners, which is why they were rendered sharp.\n\nThe tiled path has the same constraint and already takes the absolute value of\nits mapped radii.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325784\n", "files": ["gfx/wr/webrender/src/quad.rs", "gfx/wr/wrench/reftests/clip/flipped-rounded-rect-ref.yaml", "gfx/wr/wrench/reftests/clip/flipped-rounded-rect.yaml", "gfx/wr/wrench/reftests/clip/reftest.list"], "git_node": "078cf145f2bc4a90fbbbbf22c108c02d88324844", "git_parents": ["c73592233b27057012204db18a70d72d88680c43"], "node": "cd778d4f5f53e3c97e75252bd0c7875700be1cf8", "parents": ["02ad0bda6ab30eea2c9b2c30e6d236f7421cbcc3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070849 - Turn the tab strip element into a module. r=tabbrowser-reviewers,jsudiaman\n\nDropping the indentation-preserving block re-indents the whole file, so git diff -w is the actual change: the export, and the import that replaces the subscript load.\n\nThe three cannot be separated. export is top-level only, so it needs the block gone; and once the block is gone the file's own top-level names collide with the browser-window globals harvested from browser-main.js's loadSubScript line, which only the import removes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325113\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/content/tabs.mjs"], "git_node": "ada0b5fee70b94c3bdb62d4232fc608aea161309", "git_parents": ["078cf145f2bc4a90fbbbbf22c108c02d88324844"], "node": "734f34d74cdb5ba00159dbe2a1ba79c292a3a19f", "parents": ["cd778d4f5f53e3c97e75252bd0c7875700be1cf8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070849 - Declare MozElements.TabsBase for TypeScript. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325114\n", "files": ["tools/@types/lib.gecko.augmentations.d.ts"], "git_node": "03df31713d6a8daa7878d7bcf2d067cf56c26ea8", "git_parents": ["ada0b5fee70b94c3bdb62d4232fc608aea161309"], "node": "3c676a88105c12d0316b6fab87278a472e2aa3ec", "parents": ["734f34d74cdb5ba00159dbe2a1ba79c292a3a19f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070849 - Type the tab strip from its class. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325115\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tabs.mjs", "browser/components/tabbrowser/types/elements.ts"], "git_node": "e7de89a8b2e79a0de884a07fb75bf1368f3da0d4", "git_parents": ["03df31713d6a8daa7878d7bcf2d067cf56c26ea8"], "node": "72c8ebe25e961a70f2575a5e797c1a3854b0d679", "parents": ["3c676a88105c12d0316b6fab87278a472e2aa3ec"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071391 - Ensure FOG's init-ed before testing the 'update' ping r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325977\n", "files": ["toolkit/components/telemetry/tests/browser/browser_UpdatePingSuccess.js"], "git_node": "96d72638c38ae1efd2f7b3347c5f340e34af91f9", "git_parents": ["e7de89a8b2e79a0de884a07fb75bf1368f3da0d4"], "node": "78834eb3f891ab836c5ed617dee023dca98ab417", "parents": ["72c8ebe25e961a70f2575a5e797c1a3854b0d679"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064466 - Update link focus outline border radius in Nova r=desktop-theme-reviewers,fchasen,dao,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321429\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/figma-variables-all.json", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/components/link.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/link.tokens.json", "toolkit/themes/shared/in-content/common-shared.css"], "git_node": "5b5f45152775f33b853d1ed48cc9522993194cb3", "git_parents": ["96d72638c38ae1efd2f7b3347c5f340e34af91f9"], "node": "526db52cb5c4ca3da6ce7b5b19d746820f7b331a", "parents": ["78834eb3f891ab836c5ed617dee023dca98ab417"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070266: update threshold of model generated values to medium in SFF r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325970\n", "files": ["browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_generation.js"], "git_node": "ba97ecfa23af903350ae668351679868abe40129", "git_parents": ["5b5f45152775f33b853d1ed48cc9522993194cb3"], "node": "bff4eb4fb32b74ad143fe2d5359fbf7c63227696", "parents": ["526db52cb5c4ca3da6ce7b5b19d746820f7b331a"], "tags": []}, {"author": "Steven Michaud \u003csmichaud@pobox.com\u003e", "branch": "default", "desc": "Bug 2071378 - Allow sched_getaffinity() for GMP plugins on Linux. r=sandbox-reviewers,jld\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325507\n", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": "500cf2e43094e7b85458c218255d083365a436e9", "git_parents": ["ba97ecfa23af903350ae668351679868abe40129"], "node": "eb26877d7e117d6d5cb9f33fc787903ec7f50b80", "parents": ["bff4eb4fb32b7