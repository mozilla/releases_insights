20 - Use .inc extension for header file that are actually X macro files r=valentin,fluent-reviewers,ipc-reviewers,sandbox-reviewers,crashreporting-reviewers,TravisLong,gsvelto,bolsson,nika,bobowen\n\nRename X-macro file GeckoProcessTypes.h -\u003e GeckoProcessTypes.inc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326921\n", "files": ["dom/base/ChromeUtils.cpp", "gfx/ipc/GfxMessageUtils.h", "ipc/glue/CrashReporterHost.cpp", "mozglue/misc/ProcessType.cpp", "mozglue/misc/ProcessType.h", "netwerk/docs/necko_lingo.md", "security/sandbox/test/browser_sandbox_test.js", "toolkit/components/processtools/ProcInfo.h", "toolkit/components/telemetry/docs/obsolete/collection/third-party-modules-ping.md", "toolkit/components/telemetry/metrics.yaml", "toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/mozwer-rust/lib.rs", "toolkit/locales/en-US/toolkit/global/processTypes.ftl", "toolkit/modules/ProcessType.sys.mjs", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsEmbedFunctions.cpp", "xpcom/build/moz.build", "xpcom/build/nsXULAppAPI.h"], "git_node": "8abc0ada929db1a4a3130b0a5add4a600eafe93e", "git_parents": ["870d8e9d5932e8324320c71a773a2ca43c9fd5a3"], "node": "fa6d942e0aa880802d547187f54b54931f4eb62d", "parents": ["990fec84904917faebc31b05b1a833e55c56306a"], "tags": []}, {"author": "SMRehan \u003crio.syed@gmail.com\u003e", "branch": "default", "desc": "Bug 1688932 - Float the Picture-in-Picture window over native-fullscreen Spaces on macOS. r=bradwerth,mac-reviewers,kpatenio,spohl,smaug,emilio\n\nAppKit strips NSWindowStyleMaskNonactivatingPanel from any window whose class is not an NSPanel, in +[NSWindow _validateStyleMask:]. BaseWindow overrides that method to keep the bit, so the player carries it on a plain window. The window server gates compositing onto another application's fullscreen Space on that bit and on FullScreenAuxiliary, never on the class, so no panel class is needed.\n\nAn Auxiliary window cannot use AppKit fullscreen, so the player borrows FullScreenPrimary for its own fullscreen. Because it is non-activating, key, main and \"back to tab\" activation are handled explicitly, and GeckoNSApplication answers accessibility frontmost requests in process so they do not pull the user off the Space. A pref disables that override.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324239\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/pictureinpicture/PictureInPicture.sys.mjs", "toolkit/components/pictureinpicture/content/player.xhtml", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_changePiPSrcInFullscreen.js", "toolkit/components/pictureinpicture/tests/browser_close_unpip_focus.js", "toolkit/components/pictureinpicture/tests/browser_playerFullscreenFocus.js", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "widget/cocoa/nsAppShell.mm", "widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsWindowMap.mm", "widget/tests/gtest/TestPiPWindowSpaceBehavior.mm", "widget/tests/gtest/moz.build", "xpfe/appshell/nsAppShellService.cpp"], "git_node": "21687f2f328475cf1e8e36055d63d3be08259b15", "git_parents": ["8abc0ada929db1a4a3130b0a5add4a600eafe93e"], "node": "07ff2162915f3d9d9d01d5108c049e0964bc1975", "parents": ["fa6d942e0aa880802d547187f54b54931f4eb62d"], "tags": []}, {"author": "Tom Schuster \u003cevilpies@gmail.com\u003e", "branch": "default", "desc": "Bug 1854003 - Implement EXT_polygon_offset_clamp. r=gfx-reviewers,webidl,smaug,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327495\n", "files": ["dom/bindings/Bindings.conf", "dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ClientWebGLContext.h", "dom/canvas/ClientWebGLExtensions.cpp", "dom/canvas/ClientWebGLExtensions.h", "dom/canvas/HostWebGLContext.h", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextExtensions.cpp", "dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLContextState.cpp", "dom/canvas/WebGLExtensions.cpp", "dom/canvas/WebGLExtensions.h", "dom/canvas/WebGLMethodDispatcher.h", "dom/canvas/WebGLTypes.h", "dom/canvas/test/webgl-mochitest/ensure-exts/test_common.html", "dom/webidl/WebGLRenderingContext.webidl", "gfx/gl/GLContext.cpp", "gfx/gl/GLContext.h", "gfx/gl/GLContextFeatures.cpp", "gfx/gl/GLContextSymbols.h"], "git_node": "0d9881f7e33c8e23d991f6c875f3db6b4ff9e1bd", "git_parents": ["21687f2f328475cf1e8e36055d63d3be08259b15"], "node": "90ca1255eb397c8ceddd6bf7fb349496a943a980", "parents": ["07ff2162915f3d9d9d01d5108c049e0964bc1975"], "tags": []}, {"author": "SaaSha Pina \u003csaasha@heysparkbox.com\u003e", "branch": "default", "desc": "Bug 2048043 - Fully deprecate --warning-icon-bgcolor. r=desktop-theme-reviewers,emilio\n\nReplace the remaining uses of --warning-icon-bgcolor with\n--icon-color-warning and remove the token definition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323338\n", "files": ["browser/themes/shared/browser-colors.css", "browser/themes/shared/downloads/indicator.css", "browser/themes/shared/notification-icons.css"], "git_node": "81f1729ced2b7214482bf91c686b9028994dc0cc", "git_parents": ["0d9881f7e33c8e23d991f6c875f3db6b4ff9e1bd"], "node": "2847998bf6b82698774cbc4c8800dc7e12a87511", "parents": ["90ca1255eb397c8ceddd6bf7fb349496a943a980"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063680 - Destroy CacheIndexRecordWrapper via its refcount r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327035\n", "files": ["netwerk/cache2/CacheIndex.cpp", "netwerk/cache2/CacheIndex.h"], "git_node": "99f2f8d691af521b71ef2ada549f4da708aa2f0d", "git_parents": ["81f1729ced2b7214482bf91c686b9028994dc0cc"], "node": "af7de80ceb4e68b527438cb03aa27193c978a5ca", "parents": ["2847998bf6