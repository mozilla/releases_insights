, "dom/base/nsFrameMessageManager.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ProcessPriorityManager.cpp", "dom/ipc/jsactor/JSActor.cpp", "dom/media/AsyncLogger.h", "dom/media/mediasink/VideoSink.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp"], "git_node": "6d61bd55731ab799c0dfc57e88285710f0329985", "git_parents": ["9c78b2424b9283279db8bf852aaec31a8cc1da49"], "node": "1832c89069e411d352044b14e1730897e139ae56", "parents": ["05a426bf07a8e0f905467edcd7af61f39f0eb9b0"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071002 - Fix toggle color contrast in platform r=desktop-theme-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325129\n", "files": ["toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/base/border.tokens.json"], "git_node": "eb14c77916b78f003668e3f041a4f1b9e7aeebd0", "git_parents": ["6d61bd55731ab799c0dfc57e88285710f0329985"], "node": "9f0fa7eb9c15145622ae1adc03fb0ea25d988296", "parents": ["1832c89069e411d352044b14e1730897e139ae56"], "tags": []}, {"author": "Devin Rousso \u003chi@devinrousso.com\u003e", "branch": "default", "desc": "Bug 325891 - Dispatch `DOMContentLoaded` for XSLT result documents r=smaug\n\nDocuments created by XSLT skip the normal lifecycle so they reach `load` without dispatching `DOMContentLoaded`.\n\nBegin and end the load around the transform and complete script deferral for text output so lifecycle events remain ordered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321704\n", "files": ["dom/html/test/test_bug347174_xsl.html", "dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xslt/tests/mochitest/mochitest.toml", "dom/xslt/tests/mochitest/test_bug325891.html", "dom/xslt/xslt/txMozillaTextOutput.cpp", "dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "a3e003193f380cae33e574c25391934b9b4e3104", "git_parents": ["eb14c77916b78f003668e3f041a4f1b9e7aeebd0"], "node": "e01dd8bcfc0ec747dcf62dbdd1aeb5122753c261", "parents": ["9f0fa7eb9c15145622ae1adc03fb0ea25d988296"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071827 - Hide a country code with no address metadata on the Rust address store's read path. r=credential-management-reviewers,NeilDeakin\n\nAddressesBase._recordReadProcessor deletes country and country-name from every\nrecord the JSON store hands out when the code is absent from\nFormAutofill.countries. The code stays on disk; only the read hides it.\nRustAutofillAddressesAdapter had no equivalent, so a migrated profile started\nexposing a code the JSON store suppressed, and the migration reported\n`added: country` for comparing a copy of the raw rows against the filtered read.\n\nThe rule lives in AddressRecord.hideCountryWithoutMetaData, alongside the\ncomputeFields and normalizeFields it runs between, and both stores call it: a\nstore that serves addresses has one definition to apply rather than a copy to\nkeep in step. It runs after the derived fields are computed, so the telephone\nand street components still come from the stored code, as they do in the JSON\nstore, which computes them at write time.\n\nA store that hides a field on read cannot be copied out of through that read:\nthe copy back would write the code out of existence for a record only Rust\nholds. getAll() therefore takes rawData -- narrower than the JSON collection's\noption of the same name, which also strips the computed fields -- and the copy\nstep uses it while the verification keeps comparing the reads a consumer gets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325863\n", "files": ["browser/extensions/formautofill/test/browser/address/browser.toml", "browser/extensions/formautofill/test/browser/address/browser_address_unsupported_country.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_migration.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_parity.js", "toolkit/components/formautofill/AddressStorageMigrator.sys.mjs", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/RustAutofillAdapterBase.sys.mjs", "toolkit/components/formautofill/RustAutofillAddressStorage.sys.mjs", "toolkit/components/formautofill/shared/AddressRecord.sys.mjs"], "git_node": "66df203037a9b549768da2aa0e07c3e5006def12", "git_parents": ["a3e003193f380cae33e574c25391934b9b4e3104"], "node": "469bd8dc80b520ba9c419e9b40e050eb3f47bf31", "parents": ["e01dd8bcfc0ec747dcf62dbdd1aeb5122753c261"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071965 - Remove unused triggeringStorageAccess from nsILoadInfo r=necko-reviewers,emz,dom-core-reviewers,ipc-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325940\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h", "dom/base/nsFrameLoader.cpp", "dom/chrome-webidl/LoadURIOptions.webidl", "dom/ipc/DOMTypes.ipdlh", "ipc/glue/BackgroundUtils.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/nsILoadInfo.idl", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/NeckoChannelParams.ipdlh", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "tools/@types/generated/lib.gecko.dom.d.ts", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "06c01afeb060df3ece516a9067ef505f68f99244", "git_parents": ["66df203037a9b549768da2aa0e07c3e5006def12"], "node": "ff1dc76aa0434ab7b6776e36a16cf722a374ff2e", "parents": ["469bd8dc80b520ba9c419e9b40e050eb3f47bf31"], "tags": []}, {"author": "aurora \u003caurora@starsinthesky.ca\u003e", "branch": "default", "desc": "Bug 2066209 - Preserve the path in the start URL for moz-extension taskbar tabs. r=nrishel,hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321032\n", "files": ["browser/components/taskbartabs/TaskbarTabsRegistry.sys.mjs", "browser/components/taskbartabs/test/browser/browser_taskbarTabs_pageAction.js"], "git_node": "568c400cac525393f077e3057b4066b250ede649", "git_parents": ["06c01afeb060df3ece516a9067ef505f68f99244"], "node": "1b7b9b69fece028c74cca7b7f567172359911426", "parents": ["ff1dc76aa0434ab7b6776e36a16cf722a374ff2e"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071404 - Enable adaptive autofill in browser_originInView.js - r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325909\n", "files": ["browser/components/urlbar/tests/browser-autofill/browser_originInView.js"], "git_node": "5d5746d721eed9746dc6cefc515433b1f2ac47c1", "git_parents": ["568c400cac525393f077e3057b4066b250ede649"], "node": "506475278888970054472a87501ff84f584282b3", "parents": ["1b7b9b69fece028c74cca7b7f567172359911426"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 1990135 - Ensure exceptions are serialized as ByteArray to support Throwables that are Parcelable like ForegroundServiceStartNotAllowedException r=android-reviewers,pollymce,crashreporting-reviewers\n\nThe previous implementation writes throwables as `Serializable` but the Android OS treats them as `Parcelable` if they implement the interface. So, exceptions that are both Parcelable and Serializable automaticaly get treated as Parcelable.\n\nWhen the exceptions are sent across processes through the intent, they don't reference the same object, and so the system would have to parcel and unparcel it. The process of parcing ForegroundServiceStartNotAllowedException ends up calling Throwable's `fillInStackTrace()`. That then causes the restored exception to contain the stack frame of \"where we are restoring\" it.\n\nThis commit ensures that we write them to ByteArray using our existing serialize() and deserialize() functions\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323209\n", "files": ["mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/Crash.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/ThrowableSerializationExt.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/db/CrashEntity.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/CrashTest.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/UncaughtExceptionCrashTest.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/prompt/CrashReporterActivityTest.kt"], "git_node": "6d5dc6564198de6d8807691ba8727a5af2185ab9", "git_parents": ["5d5746d721eed9746dc6cefc515433b1f2ac47c1"], "node": "cea57f2c1eae788f2942086be954002e9b0b06c9", "parents": ["506475278888970054472a87501ff84f584282b3"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2043208 - Extract loading breach data from RemoteSettings into separate class r=mtigley,credential-management-reviewers,dimi,joschmidt,firefox-desktop-core-reviewers ,urlbar-reviewers,mossop,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292818\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/BrowserGlue.sys.mjs", "browser/components/aboutlogins/LoginBreaches.sys.mjs", "browser/components/aboutlogins/tests/browser/head.js", "browser/components/aboutlogins/tests/unit/test_getPotentialBreachesByLoginGUID.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "toolkit/components/passwordmgr/BreachAlertsData.sys.mjs", "toolkit/components/passwordmgr/moz.build", "toolkit/components/passwordmgr/test/unit/test_BreachAlertsData.js", "toolkit/components/passwordmgr/test/unit/xpcshell.toml", "toolkit/components/satchel/megalist/aggregator/tests/unit/test_loginDataSourceOriginPrototype.js", "toolkit/components/satchel/megalist/aggregator/tests/unit/test_loginDataSourceSortLines.js", "toolkit/components/satchel/megalist/content/tests/browser/head.js"], "git_node": "eb481a3b3f5018b632468ef25e527d60a62609bd", "git_parents": ["6d5dc6564198de6d8807691ba8727a5af2185ab9"], "node": "3dfb3f77ea320c5b8951396660388fcca1b58f10", "parents": ["cea57f2c1eae788f2942086be954002e9b0b06c9"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2072075 - Remove the unused dynamic toolbar max height compositor channel. r=geckoview-reviewers,hiro\n\nThe last caller of GeckoSession.Compositor.setMaxToolbarHeight was\nremoved in April 2020 in bug 1627716 when we deleted DynamicToolbarAnimator.\n\nThe method is not in api.txt, so I think that means that this doesn't\naffect the GeckoView API surface.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326058\n", "files": ["gfx/layers/ipc/PUiCompositorController.ipdl", "gfx/layers/ipc/UiCompositorControllerChild.cpp", "gfx/layers/ipc/UiCompositorControllerChild.h", "gfx/layers/ipc/UiCompositorControllerParent.cpp", "gfx/layers/ipc/UiCompositorControllerParent.h", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "widget/android/nsWindow.cpp"], "git_node": "d6590d8e558813b75e9325a8f52bf91044ba9aec", "git_parents": ["eb481a3b3f5018b632468ef25e527d60a62609bd"], "node": "10cb6df941b0dbfc239091e2ee07f3808bf1c484", "parents": ["3dfb3f77ea320c5b8951396660388fcca1b58f10"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071316 - Document that Format::UniqueString marker fields are URL-sanitized. r=profiler-reviewers,canova DONTBUILD\n\nEvery other string format in MarkerSchema::Format states its sanitization\nbehaviour, but UniqueString said nothing, leaving marker authors to guess\nwhether it behaves like String (not sanitized at all) or like SanitizedString.\n\nIt sits in between: the front-end scrubs URLs out of the whole string table\nwhile sanitizing a profile for upload, so a unique string is URL-sanitized\nwhatever its schema field declares. But that is the only scrubbing it gets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325417\n", "files": ["mozglue/baseprofiler/public/BaseProfilerMarkersPrerequisites.h", "tools/profiler/docs/markers-guide.md"], "git_node": "319d86bcfdbdfb5761418560c184aefe360debd7", "git_parents": ["d6590d8e558813b75e9325a8f52bf91044ba9aec"], "node": "65ddc0ac74ac9fe8a832defc7998ab57eba9739f", "parents": ["10cb6df941b0dbfc239091e2ee07f3808bf1c484"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2072076 - Unskip four dynamic toolbar reftests on desktop. r=layout-reviewers,hiro\n\nThese appear to pass at least on macOS so let's turn them on everywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326059\n", "files": ["layout/reftests/async-scrolling/reftest.list"], "git_node": "36c66486357ec741f200329017e24e60498c6c27", "git_parents": ["319d86bcfdbdfb5761418560c184aefe360debd7"], "node": "402e8548065798ffbdbb1a17441bc3877d38ea66", "parents": ["65ddc0ac74ac9fe8a832defc7998ab57eba9739f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072208 - Remove NS_PRINTING / --disable-printing. r=firefox-build-system-reviewers,layout-reviewers,dshin,sergesanspaille\n\nAll platforms support printing one way or another, and it doesn't seem\nlike something you'd want to disable for code size, it's not all that\nmuch code.\n\niOS disables it by default right now but it builds just fine with it\nenabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326149\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "dom/base/nsFrameLoader.cpp", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowOuter.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/ContentChild.cpp", "gfx/cairo/cairo/src/moz.build", "layout/base/nsDocumentViewer.cpp", "layout/moz.build", "toolkit/components/browser/nsWebBrowser.cpp", "toolkit/components/moz.build", "toolkit/moz.configure", "widget/gtk/components.conf", "widget/gtk/moz.build", "widget/moz.build", "widget/windows/components.conf", "widget/windows/moz.build"], "git_node": "2418fad89c2aad348e89b9cc755ef47f8e95bb3a", "git_parents": ["36c66486357ec741f200329017e24e60498c6c27"], "node": "f36f15bb328097abfb423890dd4e412f82126e37", "parents": ["402e8548065798ffbdbb1a17441bc3877d38ea66"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070874 - Ignore the Rust store's locked primary password error in the about:logins tests r=mtigley,credential-management-reviewers\n\nStore operations that race an unanswered primary password prompt reject with\nNS_ERROR_ABORT \"Primary password locked\", and about:logins does not catch that\non its breach alert path. In chaos mode the rejection reaches both the console\nlistener and the harness's uncaught rejection check, so browser_primaryPassword.js\nfails test-verify.\n\nIgnore the message the way these tests already ignore crypto-SDR's decryption\nfailure. The unhandled rejection itself still needs fixing in about:logins.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325428\n", "files": ["browser/components/aboutlogins/tests/browser/head.js"], "git_node": "bbbca388884d0fd5221e3594bf48089b2fc0904c", "git_parents": ["2418fad89c2aad348e89b9cc755ef47f8e95bb3a"], "node": "dc628faa3a6af72734c8779eb1bcf45e3dfcfb2a", "parents": ["f36f15bb328097abfb423890dd4e412f82126e37"], "tags": []}, {"author": "SaaSha Pina \u003csaasha@heysparkbox.com\u003e", "branch": "default", "desc": "Bug 2060287 - Use design-system focus outline on moz-input-text. r=desktop-theme-reviewers,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320280\n", "files": ["toolkit/content/tests/widgets/test_moz_input_text.html", "toolkit/content/widgets/moz-input-text/moz-input-text.css"], "git_node": "cb1c6b721f8159ae3ce7ba074a71ad63002d2431", "git_parents": ["bbbca388884d0fd5221e3594bf48089b2fc0904c"], "node": "747c4a6523dd7fc7b3b747ed535140e6506132bf", "parents": ["dc628faa3a6af72734c8779eb1bcf45e3dfcfb2a"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069840 - Show the customize reader view menu item in browser screen's menu r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324377\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/store/MenuAction.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/store/MenuStore.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuGridItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItem.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/dimens.xml", "mobile/android/fenix/app/src/main/java/org/