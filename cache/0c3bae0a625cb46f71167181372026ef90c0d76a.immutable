ifier/etp_engine/src/flatbuffers/unsafe_tools.rs", "toolkit/components/content-classifier/etp_engine/src/lib.rs", "toolkit/components/content-classifier/etp_engine/src/lists.rs", "toolkit/components/content-classifier/etp_engine/src/network_filter_list.rs", "toolkit/components/content-classifier/etp_engine/src/optimizer.rs", "toolkit/components/content-classifier/etp_engine/src/regex_manager.rs", "toolkit/components/content-classifier/etp_engine/src/request.rs", "toolkit/components/content-classifier/etp_engine/src/resources/mod.rs", "toolkit/components/content-classifier/etp_engine/src/resources/resource_assembler.rs", "toolkit/components/content-classifier/etp_engine/src/resources/resource_storage.rs", "toolkit/components/content-classifier/etp_engine/src/url_parser/mod.rs", "toolkit/components/content-classifier/etp_engine/src/url_parser/parser.rs", "toolkit/components/content-classifier/etp_engine/src/utils.rs"], "git_node": "0fce499afa572adde3fe5476683ccd095d796fb9", "git_parents": ["02a23fc5b1e9a1f3c97794a662aaee0943a73458"], "node": "a77e893cc5b0806a0e6d90d5ab98f34740411bb8", "parents": ["c54dfbf312703e6fd7352a9cc3e831e3ac7c2971"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053161 - Part 2: Introduce moz.yaml to track upstream releases using updatebot. r=emz\n\nRecords provenance for the code and configures updatebot to\nwatch upstream releases: a commit-alert task with frequency release.\nWhen a new release is tagged, updatebot files a bug and needinfos the\nmaintainer.\n\nThe vendoring block is a stub. Nothing in it is used to update this directory:\nupdates are done by hand, applying upstream's own diff between the recorded\nrevision and the new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318429\n", "files": ["toolkit/components/content-classifier/etp_engine/moz.yaml"], "git_node": "dc5fc101f3b91f382b55ed681201e2a1e96ddd1f", "git_parents": ["0fce499afa572adde3fe5476683ccd095d796fb9"], "node": "11d5a5fd359f8ec9c046af1d4de5caac968bdf8e", "parents": ["a77e893cc5b0806a0e6d90d5ab98f34740411bb8"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053161 - Part 3: Adapt the imported engine for mozilla-central r=emz\n\nAdapts the imported code so it builds inside mozilla-central. All of it\nis local change on top of a pristine import, so each one reads as a diff against\nupstream.\n\nUpstream's optional cssparser, selectors and addr dependencies are dropped.\nThe features that guarded them -- css-validation and embedded-domain-resolver --\nare therefore kept declared but empty.\n\nUpstream's dev-dependencies are dropped outright, so this crate's own unit tests\nare not built in tree. README.md says what enabling the unit tests would cost.\n\ntest_get_hash asserts 5391703202028078439 where upstream asserts\n15102204115509201409. get_hash() hashes with rustc_hash::FxHasher; upstream pins\nrustc-hash 1.1.0 deliberately, but the root Cargo.toml patches that to 2.1.1 via\nbuild/rust/rustc-hash, and FxHasher's algorithm differs between the two. So the\nnumber upstream records is simply not the number this tree computes, and the\nassertion has to be retargeted rather than ignored.\n\n40 of the 42 .rs files under src/ gain the standard MPL header; the code is already\nMPL-2.0 upstream, so this only satisfies the tree's per-file convention.\nsrc/url_parser/parser.rs is left alone because it is derived from Servo's rust-url\nand carries an Apache-2.0 / MIT notice, and\nsrc/flatbuffers/fb_network_filter_generated.rs because it carries the FlatBuffers\ndo-not-modify banner.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318430\n", "files": ["toolkit/components/content-classifier/etp_engine/Cargo.toml", "toolkit/components/content-classifier/etp_engine/README.md", "toolkit/components/content-classifier/etp_engine/src/blocker.rs", "toolkit/components/content-classifier/etp_engine/src/content_blocking.rs", "toolkit/components/content-classifier/etp_engine/src/cosmetic_filter_cache.rs", "toolkit/components/content-classifier/etp_engine/src/cosmetic_filter_cache_builder.rs", "toolkit/components/content-classifier/etp_engine/src/cosmetic_filter_utils.rs", "toolkit/components/content-classifier/etp_engine/src/data_format/mod.rs", "toolkit/components/content-classifier/etp_engine/src/engine.rs", "toolkit/components/content-classifier/etp_engine/src/filters/abstract_network.rs", "toolkit/components/content-classifier/etp_engine/src/filters/cosmetic.rs", "toolkit/components/content-classifier/etp_engine/src/filters/fb_builder.rs", "toolkit/components/content-classifier/etp_engine/src/filters/fb_network.rs", "toolkit/components/content-classifier/etp_engine/src/filters/fb_network_builder.rs", "toolkit/components/content-classifier/etp_engine/src/filters/filter_data_context.rs", "toolkit/components/content-classifier/etp_engine/src/filters/mod.rs", "toolkit/components/content-classifier/etp_engine/src/filters/network.rs", "toolkit/components/content-classifier/etp_engine/src/filters/network_matchers.rs", "toolkit/components/content-classifier/etp_engine/src/filters/token_selector.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/fb_index.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/flat_map.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/flat_multimap.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/flat_serialize.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/flat_set.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/hash_index.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/hash_map.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/containers/hash_set.rs", "toolkit/components/content-classifi