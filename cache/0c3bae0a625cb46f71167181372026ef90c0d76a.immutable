a6cae2f3d8d68ddd79f154fdd66d388fa972afe", "3a6e41221f9cc961fb893f39b7fef368f5bb16cb", "82ceca993e15ac7ebebd6838a5ccce0834a262b2", "0aed3ffbbaa920a411912f1767d76f31f25198e4", "dba46a1d11e89285ec42bb9a798fe740de21e566"], "user": "abutkovits@mozilla.com"}, "45363": {"changesets": [{"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1977540: Always override the application data directory when running Firefox from mach. r=glandium,jdescottes,webdriver-reviewers\n\nThis makes mach always override the default application directory. `run`\nsupports a `--default-appdata` argument to undo that. The previously existing\n`--appdata` argument remains allowing setting a specific directory, when passed\nbare it does nothing as that is the new default behaviour.\n\nThis change also applies to tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326418\n", "files": ["python/mozbuild/mozbuild/mach_commands.py", "testing/marionette/client/marionette_driver/geckoinstance.py", "testing/mozbase/mozrunner/mozrunner/base/browser.py"], "git_node": "e65842fb834a4b6623845baaff176290ae5a95d6", "git_parents": ["0aed3ffbbaa920a411912f1767d76f31f25198e4"], "node": "0d462477434d10d887bcb1da9ed7476d42880733", "parents": ["d1bc1e94aba57c7fa647f0e45d94815d45a82214"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2040905 - nsStandardURL::Deserialize should reparse the URL r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309064\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/base/nsStandardURL.cpp", "netwerk/test/gtest/TestStandardURL.cpp"], "git_node": "01997aa6ead970714548a75b972c2606b29d18e4", "git_parents": ["e65842fb834a4b6623845baaff176290ae5a95d6"], "node": "8559f5c1fb69d4286adee6d4b3124fb8061e7e9f", "parents": ["0d462477434d10d887bcb1da9ed7476d42880733"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Do not restore URL state on failure r=necko-reviewers,kershaw\n\nPreviously, when URLs were mutable, we'd need to restore URL state\nwhen a setter operation failed. However, this copy of the URL state is now\nredundant, as any mutator operation that fails will simply throw away\nthe state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308229\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/test/unit/test_standardurl.js"], "git_node": "8b233c8df7bad7ca5fd88a0efd5082eccfc3a440", "git_parents": ["01997aa6ead970714548a75b972c2606b29d18e4"], "node": "b51de83ce3ee22ef5a79372e5feb7986d464cea9", "parents": ["8559f5c1fb69d4286adee6d4b3124fb8061e7e9f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - avoid strlen call r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308230\n", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": "e55007c03bb3bca68f96057677bed9ca3334a2fd", "git_parents": ["8b233c8df7bad7ca5fd88a0efd5082eccfc3a440"], "node": "e5a4fdb793580778a840a71b159bc47c8162c087", "parents": ["b51de83ce3ee22ef5a79372e5feb7986d464cea9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Optimize IsSpecialProtocol r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308231\n", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": "3a508e60bbdfdb407f6ca009a6a45c783f7020bb", "git_parents": ["e55007c03bb3bca68f96057677bed9ca3334a2fd"], "node": "373c58adc60f82b672b23c7b223aaa1af55a9b72", "parents": ["e5a4fdb793580778a840a71b159bc47c8162c087"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Optimize coalescePath r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308232\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/test/unit/test_standardurl.js"], "git_node": "1c684092322f515c669e7e1bf3df7bddca7588fa", "git_parents": ["3a508e60bbdfdb407f6ca009a6a45c783f7020bb"], "node": "38d3d0d07dd7072a9a983ca279f70342769261a1", "parents": ["373c58adc60f82b672b23c7b223aaa1af55a9b72"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Optimize SegmentIs r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308233\n", "files": ["netwerk/base/nsStandardURL.h"], "git_node": "54c5893e042a1f405cbedda625e599c0377ab01b", "git_parents": ["1c684092322f515c669e7e1bf3df7bddca7588fa"], "node": "524e6bca8afc0053921ba68be5faece2c5a179b6", "parents": ["38d3d0d07dd7072a9a983ca279f70342769261a1"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Optimize CalculateParity r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308234\n", "files": ["netwerk/base/nsStandardURL.h"], "git_node": "941543ea2ea6f49822f9ea29fc24663a8e01559f", "git_parents": ["54c5893e042a1f405cbedda625e599c0377ab01b"], "node": "62a6bb2e2598b3deb8bf1340c629cbf7f2a8fd84", "parents": ["524e6bca8afc0053921ba68be5faece2c5a179b6"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Fewer string passes r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308235\n", "files": ["netwerk/base/nsURLHelper.cpp"], "git_node": "917afb7c6f0c3f38d7db0a771c4cbc6161d42d70", "git_parents": ["941543ea2ea6f49822f9ea29fc24663a8e01559f"], "node": "f2d2df5dc03eb32718f044e4f787cf7fcad9db1a", "parents": ["62a6bb2e2598b3deb8bf1340c629cbf7f2a8fd84"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Fast path for BuildNormalized r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308236\n", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": "9966449ae64a144d0956e6f850e981f1e2ee431e", "git_parents": ["917afb7c6f0c3f38d7db0a771c4cbc6161d42d70"], "node": "4a1306407541b178fd440bd00a94d68c000620c6", "parents": ["f2d2df5dc03eb32718f044e4f787cf7fcad9db1a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Add nonXPCOM ParseAll method to nsBaseURLParser r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308237\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/base/nsStandardURL.h", "netwerk/base/nsURLHelper.cpp", "netwerk/base/nsURLHelper.h", "netwerk/base/nsURLParsers.cpp", "netwerk/base/nsURLParsers.h", "toolkit/components/backgroundtasks/tests/browser/browser_xpcom_graph_wait.js"], "git_node": "dd7ca71a3cefdd7dadf627e1d973d3055d000052", "git_parents": ["9966449ae64a144d0956e6f850e981f1e2ee431e"], "node": "bc7172cc5771b6b2357e83d1f449f84c2f22f592", "parents": ["4a1306407541b178fd440bd00a94d68c000620c6"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049622 - Don't assert on non-UTF-8 input in nsSegmentEncoder r=necko-reviewers,kershaw\n\nnsStandardURL's setters take nsACString, which carries no UTF-8 guarantee, so\nthe MOZ_ASSERT_UNREACHABLE in EncodeSegmentCount asserts on something callers\ncan legitimately do. SetQueryWithEncoding reaches it on its own: a legacy\ncharset makes mEncoding non-null, and any non-UTF-8 byte in the query then\nlands in that branch.\n\nThe code immediately below already handles the case correctly, decoding the\ninput to UTF-8 and substituting U+FFFD for invalid sequences, so the assertion\nonly turns a handled input into a debug-build crash. Drop it and add a gtest\nthat pins the resulting normalization.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325944\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/test/gtest/TestStandardURL.cpp"], "git_node": "2f90624fe7acc7982031476c8aebeda3703055c8", "git_parents": ["dd7ca71a3cefdd7dadf627e1d973d3055d000052"], "node": "d4c4523e5fd9d52cafa26138ff595fd1bb0b864b", "parents": ["bc7172cc5771b6b2357e83d1f449f84c2f22f592"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053167 - Part 1: Ensure every engine consumer holds mLock r=emz\n\nClassifyForCancel, ClassifyForAnnotate and ProbeBlocking all hold mLock across\nmatching. ProbeFeature took it only to look the engine up and then matched with\nthe lock released.\n\nNothing goes wrong today, because every engine consumer runs on the\nurl-classifier background thread and so cannot overlap. Closing the gap makes\nthe invariant hold everywhere: an engine is only ever used with mLock held.\n\nThe later parts of this bug depend on that. Reporting an engine's memory reads\nit from the main thread while the background thread may be matching, so an\nengine that is reachable without the lock would be read without one.\n\nClassifyWithEngines gains MOZ_REQUIRES(mLock) to match the other members that\nalready carry it. It previously relied on mLock.AssertCurrentThreadOwns(), which\nis declared MOZ_ASSERT_CAPABILITY and so tells the analyser the lock is held\nrather than asking callers to prove it; the annotation moves that obligation to\nthe callers, where the gap was.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320906\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/ContentClassifierService.h"], "git_node": "635e71bd8b9cf66de61d0eadda0a3cf83c6ad682", "git_parents": ["2f90624fe7acc7982031476c8aebeda3703055c8"], "node": "85d5a1df4a4eabe73194b8b7a1b4172af1738df9", "parents": ["d4c4523e5fd9d52cafa26138ff595fd1bb0b864b"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053167 - Part 2: Report the content classifier engines to about:memory r=emz,mccr8\n\nThis part wires up the Gecko half of the reporting and leaves etp_engine\nuntouched. ContentClassifierService already keeps one engine per feature, so it\nimplements nsIMemoryReporter and emits a leaf under\nexplicit/content-classifier/engines/\u003cfeature\u003e/, which about:memory sums back\ninto a per-feature node. Keeping the per-feature path an interior node also\nmakes it visible when several engines end up holding the same rules.\n\nOnly the engine objects are measured here. Everything they point to lives behind\nprivate etp_engine types, which later parts measure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320907\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/ContentClassifierService.h", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.h", "toolkit/components/content-classifier/content_classifier_engine/src/lib.rs"], "git_node": "c918a50497d1186f03413b0213cc160bc80ed97b", "git_parents": ["635e71bd8b9cf66de61d0eadda0a3cf83c6ad682"], "node": "b27f521ad5629b9a52003778835a3a1bc429a9c8", "parents": ["85d5a1df4a4eabe73194b8b7a1b4172af1738df9"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053167 - Part 3: Attribute the content classifier engines' filter data in about:memory r=emz,mccr8\n\nThis part introduces an optional malloc-size-of feature and an\nEngineMemoryBreakdown to etp_engine, splitting an engine's heap by what holds\nit.\n\nThe most of measure code lives in a new file to keep the diff to upstream\nminimal. The measure code in Engine is still required to reach the\nfilter_data_context.\n\nThe reported total excludes compiled regexes, which regex::bytes::Regex does not\nexpose.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320908\n", "files": ["Cargo.lock", "toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/content_classifier_engine/Cargo.toml", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.h", "toolkit/components/content-classifier/content_classifier_engine/src/lib.rs", "toolkit/components/content-classifier/etp_engine/Cargo.toml", "toolkit/components/content-classifier/etp_engine/src/engine.rs", "toolkit/components/content-classifier/etp_engine/src/flatbuffers/unsafe_tools.rs", "toolkit/components/content-classifier/etp_engine/src/lib.rs", "toolkit/components/content-classifier/etp_engine/src/malloc_size_of_impls.rs"], "git_node": "8704e2a1d01a307808a78a09563ad7b386cb9be6", "git_parents": ["c918a50497d1186f03413b0213cc160bc80ed97b"], "node": "c6ac4e0e375ce6604cb71fa46897efa45d2e0960", "parents": ["b27f521ad5629b9a52003778835a3a1bc429a9c8"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053167 - Part 4: Attribute the content classifier engines' blocker memory r=emz,mccr8\n\nThis part measures what the blocker owns: enabled-tags, the set of tag names\ngating tagged filters, and regex-table, the lookup table the matcher compiles\nregexes into. Nothing in Gecko enables a tag today, so enabled-tags reads zero,\nbut it is measured rather than assumed so that it cannot become an unnoticed\ngap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320909\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/content_classifier_engine/src/lib.rs", "toolkit/components/content-classifier/etp_engine/src/engine.rs", "toolkit/components/content-classifier/etp_engine/src/malloc_size_of_impls.rs", "toolkit/components/content-classifier/etp_engine/src/regex_manager.rs"], "git_node": "2471324096b6a134c064831ed497e40733ea6906", "git_parents": ["8704e2a1d01a307808a78a09563ad7b386cb9be6"], "node": "23c4e8f56545a7aafb6f520319be9a23c4222bb3", "parents": ["c6ac4e0e375ce6604cb71fa46897efa45d2e0960"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053167 - Part 5: Attribute the content classifier engines' cosmetic cache r=emz,mccr8\n\nThis part measures CosmeticFilterCache, which holds nothing but a clone of the\nreference Engine already measures, so the leaf reads zero. It is measured anyway\nso that a field added to the type is not silently dropped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320910\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/content_classifier_engine/src/lib.rs", "toolkit/components/content-classifier/etp_engine/src/engine.rs", "toolkit/components/content-classifier/etp_engine/src/malloc_size_of_impls.rs"], "git_node": "26638fa3172aa89c771e389995159a757f10adfe", "git_parents": ["2471324096b6a134c064831ed497e40733ea6906"], "node": "c9e3d8946f1ea2e606407689e886658cf09e7107", "parents": ["23c4e8f56545a7aafb6f520319be9a23c4222bb3"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053167 - Part 6: Attribute the content classifier engines' resource backend r=emz,mccr8\n\nThis part measures the boxed backend of ResourceStorage. The box is allocated\nwhether or not the backend holds anything, so the leaf reports a non-zero size\neven though Gecko never puts anything in it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320911\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/content_classifier_engine/src/lib.rs", "toolkit/components/content-classifier/etp_engine/src/engine.rs", "toolkit/components/content-classifier/etp_engine/src/malloc_size_of_impls.rs", "toolkit/components/content-classifier/etp_engine/src/resources/resource_storage.rs"], "git_node": "31638915b6a27587d7b612b2e853ff4f4f322116", "git_parents": ["26638fa3172aa89c771e389995159a757f10adfe"], "node": "4238ea61ae95b398a891534f0202b3d509e6d331", "parents": ["c9e3d8946f1ea2e606407689e886658cf09e7107"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053167 - Part 7: Test the content classifier engines' memory reporting r=emz\n\nCovers what the earlier parts built:\n\n - a live engine is reported, with the kind and units about:memory expects\n - each active feature reports under its own path, so two engines do not\n   collapse into one node\n - the reported flatbuffer and domain index grow with the size of the list the\n   engine was built from, which is what distinguishes them from the fixed cost\n   of the engine objects\n - the regex table is attributed once a request has actually been matched\n   against a filter needing a regex\n - every field of ContentClassifierEngineSizes reaches a leaf, so one that stops\n   being reported fails the suite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320912\n", "files": ["toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_memory_reporter.js"], "git_node": "71aa02e0553f71bd61630eab4768abb6864bf302", "git_parents": ["31638915b6a27587d7b612b2e853ff4f4f322116"], "node": "43418b052111145009bc0e95cf0de89a9e575309", "parents": ["4238ea61ae95b398a891534f0202b3d509e6d331"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1727636 - Only report fatal EXC_RESOURCE exceptions on macOS r=crashreporting-reviewers,afranchuk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326496\n", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/exception_handler.cc", "toolkit/crashreporter/breakpad-client/mac/handler/exception_handler.h", "toolkit/crashreporter/test/gtest/TestMacExcResource.cpp", "toolkit/crashreporter/test/gtest/moz.build"], "git_node": "fffe8be391e40c8936bec8220b935914b93e0640", "git_parents": ["71aa02e0553f71bd61630eab4768abb6864bf302"], "node": "24eec16271ace84b9f4a52b88974942763dc1afb", "parents": ["43418b052111145009bc0e95cf0de89a9e575309"], "tags": []}, {"author": "Syed \u003csfshah@zohomail.eu\u003e", "branch": "default", "desc": "Bug 1918915 - Don't upgrade mixed content for hosts on dom.securecontext.allowlist. r=freddyb,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324647\n", "files": ["caps/BasePrincipal.cpp", "caps/BasePrincipal.h", "caps/nsIPrincipal.idl", "dom/security/nsMixedContentBlocker.cpp", "dom/security/nsMixedContentBlocker.h", "dom/security/test/mixedcontentblocker/browser.toml", "dom/security/test/mixedcontentblocker/browser_securecontext_allowlist_no_upgrade.js", "dom/security/test/mixedcontentblocker/file_scheme_probe.sjs", "dom/security/test/mixedcontentblocker/file_securecontext_allowlist_https_page.html", "dom/security/test/mixedcontentblocker/file_securecontext_allowlist_page.html", "netwerk/base/LoadInfo.cpp", "netwerk/base/nsNetUtil.cpp"], "git_node": "0e6ade50639b78b916ff9d81fbcbba65ff439916", "git_parents": ["fffe8be391e40c8936bec8220b935914b93e0640"], "node": "0801123ca64a3338c38b4c446e247ed52085f2bb", "parents": ["24eec16271ace84b9f4a52b88974942763dc1afb"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2070729 [Wayland] Force toplevel window repaint by positioning child subsurface r=emilio,gtk-reviewers\n\nForce commit to toplevel GdkWindow (mShell) to propagate\nchanges made to mContainer. There's only way how to force Gtk3 to\ndo the commit without actual painting (Bug 2070729) and that's child\nsubsurface position change.\n\nWe create a temporary child window located outside of the window\norigin without any content and move it to issue synced commit to toplevel\nwindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326465\n", "files": ["widget/gtk/IMContextWrapper.cpp", "widget/gtk/MozContainerWayland.cpp", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "3cb2190a6131804c01f087ab99bfdf2ed7e040d0", "git_parents": ["0e6ade50639b78b916ff9d81fbcbba65ff439916"], "node": "d4eba984bd6acad2782da4ffc5cc8be527649012", "parents": ["0801123ca64a3338c38b4c446e247ed52085f2bb"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073399 - Stop reading one byte past a string literal ETW marker payload. r=canova,profiler-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327254\n", "files": ["tools/profiler/public/ETWTools.h"], "git_node": "daeb5c16e4b0c88c89af09c5d951dd66c0514f2b", "git_parents": ["3cb2190a6131804c01f087ab99bfdf2ed7e040d0"], "node": "43d5b325656cedbd49938066f045cebc86feb689", "parents": ["d4eba984bd6acad2782da4ffc5cc8be527649012"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068337 - default-initialize ReportingHeader group r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327275\n", "files": ["dom/reporting/ReportDeliver.h", "dom/reporting/ReportingHeader.h"], "git_node": "03950089936e430095a121ee0d181c4def0f9185", "git_parents": ["daeb5c16e4b0c88c89af09c5d951dd66c0514f2b"], "node": "1985961e057e8e30c5caa5c194459bcc4c7b7aed", "parents": ["43d5b325656cedbd49938066f045cebc86feb689"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073081 - Remove useless includes from the crash reporting code r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326948\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "9d587d14712cdcc5d4fdc1f033e49c763c45990a", "git_parents": ["03950089936e430095a121ee0d181c4def0f9185"], "node": "a8af0caf4fb51657e7ee0b5b0f79babe571f1462", "parents": ["1985961e057e8e30c5caa5c194459bcc4c7b7aed"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071579 - [devtools] Force the script navigation cache on in browser_dbg-reloading.js, r=devtools-reviewers,jdescottes.\n\nWith `dom.script_loader.experimental.navigation_cache` off, reloading the bundle\nhands the debugger a source-map mapping to an original source the sources\nreducer has not been told about yet: `checkSelectedSource` runs from within\n`newGeneratedSources`, before `loadSourceMapsForSourceActors`, while the Source\nMap Loader still answers from the previous load because its generated source id\nis derived from the URL and is stable across reloads.\n`sourceMapToDebuggerLocation` then throws, the rejection skips\n`loadSourceMapsForSourceActors`, the reloaded original sources are never\nregistered, and the frame mapping the test waits on never completes.\n\nThe pref defaults to `@IS_NIGHTLY_BUILD@`, which is why the test only fails once\ncentral is built as beta.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327246\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-reloading.js"], "git_node": "c747abc7ec3402d0732a02b5c8b7259e62443abc", "git_parents": ["9d587d14712cdcc5d4fdc1f033e49c763c45990a"], "node": "073366b8b7fe8f9db7e4b2d393fe9201cc2a7f6f", "parents": ["a8af0caf4fb51657e7ee0b5b0f79babe571f1462"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069131 - Rename remaining browser/base/content/test browser-chrome directories to match eslint-test-paths conventions r=frontend-codestyle-reviewers,webcompat-reviewers,fxview-reviewers,places-reviewers,android-reviewers,urlbar-rev