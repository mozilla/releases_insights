vutil/side_data.c", "media/ffvpx/libavutil/stereo3d.c", "media/ffvpx/libavutil/utils.c", "media/ffvpx/libavutil/version.h", "media/ffvpx/libavutil/vulkan.c", "media/ffvpx/libavutil/vulkan.h", "media/ffvpx/libavutil/vulkan_functions.h", "media/ffvpx/libavutil/vulkan_loader.h", "media/ffvpx/libavutil/x86/asm.h", "media/ffvpx/libavutil/x86/crc.h", "media/ffvpx/libavutil/x86/emms.asm", "media/ffvpx/libavutil/x86/moz.build", "media/ffvpx/libavutil/x86/pixelutils.asm", "media/ffvpx/libavutil/x86/pixelutils.h", "media/ffvpx/libavutil/x86/tx_float.asm", "media/ffvpx/libavutil/x86/x86util.asm", "media/ffvpx/mediacodec_force_key_frames.patch", "media/ffvpx/vp8dsp-nasm-2.14-compat.patch", "media/ffvpx/vp9-get-format-rollback.patch", "tools/lint/ffvpx-symbols.yml", "tools/lint/ffvpx-symbols/__init__.py", "tools/lint/test/python.toml", "tools/lint/test/test_ffvpx_symbols.py"], "git_node": "7d98fe3096a9bbb060719fa403f66c9e384bf9f4", "git_parents": ["b80ea88aa8d430c81e76a88740918a70aa4e8d17"], "node": "e54321cbdfc15292b229fdd68313e5d0e4bbd358", "parents": ["bc598fade3c89848695e08e3c53d5b14cf246b5a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050211 - Wire up AA for primitives that have the ANTIALIASING flag. r=gfx-reviewers,lsalzman\" for causing reftest failures\n\nThis reverts commit 83d1c3e17ea10740fe03197bc09566104ffe539b.\n", "files": ["gfx/wr/webrender/src/scene_building.rs"], "git_node": "a7f1d35aa6e5e4ec626919d3c9c6b519287c7fe9", "git_parents": ["7d98fe3096a9bbb060719fa403f66c9e384bf9f4"], "node": "de709eaee7343c57df253181873ae934be85e6e5", "parents": ["e54321cbdfc15292b229fdd68313e5d0e4bbd358"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054470 - Create NavigationEvent to handle view-level navigations and fix MenuDialogMiddleware memory leaks r=android-reviewers,marcin\" for causing fenix failures\n\nThis reverts commit 890cd5bd4ee6f82e960b18db4c358da826677d01.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuDialogMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/NavigationEvent.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuDialogMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuNavigationMiddlewareTest.kt"], "git_node": "c81fe73c19e917fdd7912bf70d96b2ab4ac4180f", "git_parents": ["a7f1d35aa6e5e4ec626919d3c9c6b519287c7fe9"], "node": "20730cc75d1ae78aeb51f29346b1cb58720b137e", "parents": ["de709eaee7343c57df253181873ae934be85e6e5"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1990135 - Ensure exceptions are serialized as ByteArray to support Throwables that are Parcelable like ForegroundServiceStartNotAllowedException r=android-reviewers,pollymce,crashreporting-reviewers\" for causing android bustages\n\nThis reverts commit 50d29db827816e2d15bd14aec1cfb9975df23ef1.\n", "files": ["mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/Crash.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/ThrowableSerializationExt.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/db/CrashEntity.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/CrashTest.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/UncaughtExceptionCrashTest.kt"], "git_node": "2431e0f201c9d8c69828bf026211e914240d2040", "git_parents": ["c81fe73c19e917fdd7912bf70d96b2ab4ac4180f"], "node": "111a74e163e107a2fe87c4b624f857da65af49f2", "parents": ["20730cc75d1ae78aeb51f29346b1cb58720b137e"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2070237 - Show long-form tracker count for every site's entry page. r=urlbar-reviewers,desktop-theme-reviewers,emilio,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324654\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "61b3f6dd863ca173237e7ddc4dd7f6cf143d6a77", "git_parents": ["2431e0f201c9d8c69828bf026211e914240d2040"], "node": "1971e7bacea7fda86273fd326627b543f912f112", "parents": ["111a74e163e107a2fe87c4b624f857da65af49f2"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2071633 - Use moz-src for genai r=settings-reviewers,tabbrowser-reviewers,sidebar-reviewers,akulyk,sclements,mlucks,omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325630\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/components/BrowserComponents.manifest", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/genai/GenAIParent.sys.mjs", "browser/components/genai/chat.js", "browser/components/genai/moz.build", "browser/components/genai/tests/browser/browser_chat_contextmenu.js", "browser/components/genai/tests/browser/browser_chat_page.js", "browser/components/genai/tests/browser/browser_chat_prompt.js", "browser/components/genai/tests/browser/browser_chat_request.js", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/genai/tests/browser/browser_chat_telemetry.js", "browser/components/genai/tests/browser/browser_genai_init.js", "browser/components/genai/tests/browser/browser_link_preview.js", "browser/components/genai/tests/xpcshell/test_contextual_prompts.js", "browser/components/genai/tests/xpcshell/test_provider_id.js", "browser/components/genai/tests/xpcshell/test_show_chat_entrypoint.js", "browser/components/preferences/OnDeviceModelManager.mjs", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/tabbrowser/content/tab-context-menu.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_summarize_page.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "42f3e5a4923398d1058c09366e813656c8bc9aa6", "git_parents": ["61b3f6dd863ca173237e7ddc4dd7f6cf143d6a77"], "node": "bd41d54698aa53cfa12feb301f77c939f3534c9d", "parents": ["1971e7bacea7fda86273fd326627b543f912f112"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071856 - Include mots review groups in `mach file-info reviewer-groups`. r=shtrom\n\nThe subcommand only listed the groups referenced by Phabricator's Herald\nrules, so groups declared only through a module's `review_group` in\nmots.yaml (e.g. `linter-reviewers`) were missing, even though\n`mach file-info reviewers` suggests them. Union both sources, and factor\nthe mots walk out of `known_review_groups` into `mots_review_groups`.\n\nHerald rules being unavailable is no longer fatal as long as mots.yaml\ncan be read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325852\n", "files": ["python/mozbuild/mozbuild/frontend/mach_commands.py", "python/mozbuild/mozbuild/frontend/reviewers.py", "python/mozbuild/mozbuild/test/frontend/test_file_info_reviewers.py"], "git_node": "4d049a01c938cc971a925e5c6ccabc1812cf334b", "git_parents": ["42f3e5a4923398d1058c09366e813656c8bc9aa6"], "node": "4e764dbc6ce3ba762caadb07964ecb54a4e2e8f6", "parents": ["bd41d54698aa53cfa12feb301f77c939f3534c9d"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070567 - Use nsCString in ReportDeliver and ReportingHeader. r=necko-reviewers,jjaschke,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324656\n", "files": ["dom/reporting/CrashReport.cpp", "dom/reporting/ReportDeliver.cpp", "dom/reporting/ReportDeliver.h", "dom/reporting/ReportingHeader.cpp", "dom/reporting/ReportingHeader.h", "dom/reporting/ReportingUtils.cpp", "dom/reporting/tests/gtest/TestReportingEndpointsParser.cpp", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "b67c90c4bad98de62fe0bfd605a21273e4b49a9f", "git_parents": ["4d049a01c938cc971a925e5c6ccabc1812cf334b"], "node": "b8181026c8b16b497d523e7e7c7c81e3d9cf8058", "parents": ["4e764dbc6ce3ba762caadb07964ecb54a4e2e8f6"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070567 - Use nsCString for ReportingUtils::Report. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324657\n", "files": ["dom/base/nsContentUtils.cpp", "dom/reporting/ReportingUtils.cpp", "dom/reporting/ReportingUtils.h", "dom/reporting/TestReportGenerator.cpp", "dom/security/IntegrityPolicyService.cpp", "dom/security/IntegrityPolicyWAICT.cpp", "dom/security/nsCSPContext.cpp", "dom/security/permissionspolicy/PermissionsPolicyUtils.cpp"], "git_node": "cebb04d148e00a84c7989dae274731dc62c5b97f", "git_parents": ["b67c90c4bad98de62fe0bfd605a21273e4b49a9f"], "node": "371df82bee97cb597705b8d97eb240ed89e94fc9", "parents": ["b8181026c8b16b497d523e7e7c7c81e3d9cf8058"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070567 - Use UTF8String for the Report interface. r=dom-core-reviewers,webidl,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324658\n", "files": ["dom/base/nsIGlobalObject.cpp", "dom/base/nsIGlobalObject.h", "dom/reporting/Report.cpp", "dom/reporting/Report.h", "dom/reporting/ReportingObserver.cpp", "dom/reporting/ReportingUtils.cpp", "dom/webidl/Reporting.webidl"], "git_node": "95a49a08c09e5a5763e2cd7f7d1b764783d31883", "git_parents": ["cebb04d148e00a84c7989dae274731dc62c5b97f"], "node": "c18d973c2f7004101bfac0b8d53c2790a52df9fc", "parents": ["371df82bee97cb597705b8d97eb240ed89e94fc9"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070965 - Make UserAgent a nsCString everywhere. r=jjaschke,necko-reviewers,webidl,dom-worker-reviewers,emilio,valentin,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324998\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/nsDocShell.cpp", "docshell/base/nsIDocShell.idl", "dom/base/Navigator.cpp", "dom/base/Navigator.h", "dom/chrome-webidl/BrowsingContext.webidl", "dom/reporting/CrashReport.cpp", "dom/reporting/ReportDeliver.cpp", "dom/webidl/Navigator.webidl", "dom/workers/WorkerNavigator.cpp", "dom/workers/WorkerNavigator.h", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "ae88a255d2cb57f73a1e3cd783b472a53d41a233", "git_parents": ["95a49a08c09e5a5763e2cd7f7d1b764783d31883"], "node": "f7a2f98de4b7df3f138fea1d66e53888d215e29d", "parents": ["c18d973c2f7004101bfac0b8d53c2790a52df9fc"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070478 - Fix macOS exception handling for child processes that don't register their own exception handler. r=crashreporting-reviewers,afranchuk\n\nWhen we receive an exception that is not meant for us, we claim we\nwant to ignore the exception. However, what we actually tell the\nkernel is that we handled the exception and it can resume the thread\nthat crashed. This causes a crash loop where the process gets\ncontinually resumed at the crashing point, generating a new\nexception and then getting resumed again. It never gets terminated\nby the kernel.\n\nFix that by telling the kernel we didn't handle the exception, so\nthat the exception continues to propagate and the process crashes.\n\nDiscovered while writing tests where the updater binary crashes as\na child of xpcshell. The updater binary does not register an\nexception handler. The tests were failing with a timeout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324566\n", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/exception_handler.cc", "toolkit/crashreporter/test/gtest/TestMacExceptionHandler.cpp", "toolkit/crashreporter/test/gtest/moz.build"], "git_node": "9bc35258b7ad0840cc8e760b4b225d5e16f84140", "git_parents": ["ae88a255d2cb57f73a1e3cd783b472a53d41a233"], "node": "7776e02ecdf8475b574d4601d33a8c70f23eda24", "parents": ["f7a2f98de4b7df3f138fea1d66e53888d215e29d"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046798 - Fix a/ b/ file paths in zucchini patch 0024. r=bobowen\n\nThe a/ b/ paths in vendored patch 0024 were incorrectly prefixed\nwith third_party/zucchini/chromium/. Correct them to the\nupstream-relative paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310325\n", "files": ["third_party/zucchini/chromium-shim/patches/0024-Detect-OOM-when-memory-mapping-fails-in-MappedFileRe.patch"], "git_node": "ffebfed54e478702e66628de0193d05d38a7444f", "git_parents": ["9bc35258b7ad0840cc8e760b4b225d5e16f84140"], "node": "3c1192818f77781f28a67b09873059a3c4cc64dc", "parents": ["7776e02ecdf8475b574d4601d33a8c70f23eda24"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046798 - Wrap zucchini entry points to catch exceptions. r=sergesanspaille,application-update-reviewers,cdupuis\n\nIn the previous exception handling design, our SEH __try/__except only\ncovered the bodies of MappedPatch::Load and MappedPatch::ApplyUnsafe,\nand only partially.\n\nThis patch instead splits exception handling into two layers, each\ncovering a different concern:\n\n1. BEGIN_ENTRY_POINT / END_ENTRY_POINT: Wraps every entry point from\n   updater.cpp, catching any potential std::bad_alloc exception. Ensures\n   wrapped zucchini code returns an OOM status code upon standard\n   library allocation failures instead of crashing the process.\n\n2. BEGIN_PAGE_ERROR_TRY_EXCEPT / END_PAGE_ERROR_TRY_EXCEPT: Mirrors the\n   exception catching present in upstream zucchini::ApplyCommon to catch\n   page errors from mapped file I/O.\n\nWith the follow-up patch covering crc32, this ensures that our exception\nhandling covers as much zucchini surface as possible. This two-layer\nstructure also helps implement the follow-up patch that transitions to\nC++ exceptions, where layer 1 gets a cross-platform implementation\nwhereas layer 2 stays Windows-only.\n\nIn the current patch, layer 1 also covers CHECK failures, but it gets\nrestricted to C++ exceptions in a later patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308183\n", "files": ["third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "6232332c92add46ce74efcdc32ae1ff027df678a", "git_parents": ["ffebfed54e478702e66628de0193d05d38a7444f"], "node": "c9e8123c811e6592302e62cfd89f20225977c069", "parents": ["3c1192818f77781f28a67b09873059a3c4cc64dc"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046798 - Wrap zucchini crc32 computation to catch exceptions. r=application-update-reviewers,cdupuis\n\nThis patch extends the entry-point wrapping from the previous patch to\nalso cover crc32 computation. This requires changing the abstract\ninterface used by the updater for crc32 computations, so that we can\npropagate updater status codes that match with the failures raised from\nzucchini.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308184\n", "files": ["third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "a05dff7e3acad0e344321eada524fdc1f15d5f4c", "git_parents": ["6232332c92add46ce74efcdc32ae1ff027df678a"], "node": "65ea5e8c60dc713364bb584d13b85f3377d648b8", "parents": ["c9e8123c811e6592302e62cfd89f20225977c069"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043122 - Remove Windows-only zucchini crash recovery. r=application-update-reviewers,cdupuis\n\nThe updater is now resilient to crashes that occur while drafting a\npatch. We can safely remove the zucchini workaround that previously\ntried to mitigate these crashes at the zucchini level on Windows.\n\nThis workaround was less reliable than it pretended to be anyway,\nbecause moving the failure location around (like we do further in the\npatch stack) would make the CheckDestructor test fail. The root cause\nbeing that SEH has weaker guarantees on calling destructors than C++\nexception handling.\n\nUpdate tests accordingly. Now, only recovering from C++ std::bad_alloc\nexceptions must ensure that destructors are called and that we fail\ngracefully. CHECK failures are now immediate crashes that bypass updater\nrollback, so they are expected to leave .moz-draft files behind in\nnon-staged updates. It is the updater's responsibility to clean stale\n.moz-draft files during the next update.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324342\n", "files": ["third_party/zucchini/moz_zucchini.cc", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAllocDestructor_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheckDestructor_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "6534e47ae424e527565a405bffd1efe11539a6a9", "git_parents": ["a05dff7e3acad0e344321eada524fdc1f15d5f4c"], "node": "2989fe337dcff534228f6904769aa59755ea348f", "parents": ["65ea5e8c60dc713364bb584d13b85f3377d648b8"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043122 - Cross-platform handling of std::bad_alloc in zucchini. r=application-update-reviewers,firefox-build-system-reviewers,sergesanspaille,cdupuis\n\nThis patch extends std::bad_alloc recovery to macOS and Linux platforms,\nby replacing the previous Windows-only SEH-based zucchini crash recovery\nwith one based on C++ exceptions instead. To this end, we enable C++\nexceptions when compiling the zucchini library on all platforms,\nincluding Windows.\n\nWe make the updater fail with an OOM status code when std::bad_alloc\nfailures occur, allowing the updater to correctly assess the reason\nzucchini failed -- the updater behaves differently upon OOM failures.\n\nThis makes Windows crash recovery more reliable as well, because the\nguarantees around calling the destructors of C++ objects when unwinding\nare stronger with C++ exceptions than with SEH.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324343\n", "files": ["third_party/zucchini/moz.build", "third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAlloc.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAllocDestructor.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAllocDestructor_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAlloc_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "d209f1772abff63985041d55a341fcde6ff52ac6", "git_parents": ["6534e47ae424e527565a405bffd1efe11539a6a9"], "node": "dc354587246a4f24555aa1f2444ddae41e7e220e", "parents": ["2989fe337dcff534228f6904769aa59755ea348f"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043122 - Simulate zucchini test failures mid-patch-application. r=application-update-reviewers,iholmes\n\nMove the zucchini failure simulation used by updater tests into the\npatch-application loop, so tests exercise failures while the new image\nis still open and mapped. This is the worst case for updater recovery,\nso this patch increases our confidence in the recovery mechanisms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310327\n", "files": ["third_party/zucchini/moz_zucchini.cc", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck.js"], "git_node": "f443f6f4b2deb34600360bee6634c6381416a0f1", "git_parents": ["d209f1772abff63985041d55a341fcde6ff52ac6"], "node": "a49b5fd567a1dd235eb26817422622011d16fedd", "parents": ["dc354587246a4f24555aa1f2444ddae41e7e220e"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975960 - Regenerate zucchini shim patches that diverged. r=bobowen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324878\n", "files": ["third_party/zucchini/chromium-shim/patches/0006-Define-only-the-required-functions-from-file_util.h.patch", "third_party/zucchini/chromium-shim/patches/0009-Limit-dependencies-in-file_path.cc.patch", "third_party/zucchini/chromium-shim/patches/0020-Limit-dependencies-in-foundation_util.mm.patch"], "git_node": "da3f754d99a3a382ec684886aa7470e765e1ded8", "git_parents": ["f443f6f4b2deb34600360bee6634c6381416a0f1"], "node": "5007628c748b474fff8f6cd60f399f4ea900180a", "parents": ["a49b5fd567a1dd235eb26817422622011d16fedd"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975960 - Update zucchini vendoring to prepare for mingwclang support. r=bobowen\n\n- base/files/file_util_win.cc: OpenFile() uses _SH_DENYNO, which the MSVC CRT\n  headers happen to expose transitively but mingw-w64 only declares in\n  \u003cshare.h\u003e.\n\n- base/base_paths_win.cc: \u003cKnownFolders.h\u003e is not found when cross-compiling,\n  as mingw-w64 spells the header knownfolders.h and the build host can have a\n  case-sensitive filesystem. Its only user, FOLDERID_ApplicationShortcuts in\n  the DIR_APP_SHORTCUTS case is already excluded under MOZ_ZUCCHINI.\n\n- components/zucchini/suffix_array_unittest.cc: libc++ ships no\n  std::char_traits\u003cunsigned char\u003e specialization, so\n  std::basic_string\u003cunsigned char\u003e cannot be instantiated. The test only ever\n  uses the alias as a sized random-access container (construction from an\n  iterator pair, begin/end/size), so under MOZ_ZUCCHINI it becomes\n  std::vector\u003cunsigned char\u003e.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324879\n", "files": ["third_party/zucchini/chromium-shim/patches/0025-Prepare-zucchini-sources-for-mingwclang-builds.patch", "third_party/zucchini/chromium/base/base_paths_win.cc", "third_party/zucchini/chromium/base/files/file_util_win.cc", "third_party/zucchini/chromium/components/zucchini/suffix_array_unittest.cc"], "git_node": "3b6fb72bab0b132ff8585e3e1b7c6cff15dcaa00", "git_parents": ["da3f754d99a3a382ec684886aa7470e765e1ded8"], "node": "6eaacb72b7f51ccd50bdca4337e8c183d52c9f3f", "parents": ["5007628c748b474fff8f6cd60f399f4ea900180a"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975960 - Add zucchini support for mingwclang builds. r=bobowen,firefox-build-system-reviewers,sergesanspaille,sandbox-reviewers\n\nZucchini uses SEH to catch the EXCEPTION_IN_PAGE_ERROR exceptions that\nWindows raises when an I/O error occurs while accessing a memory-mapped\nfile. MinGW compilers do not support SEH, which is why we were disabling\nzucchini in mingwclang builds.\n\nWe now deal with this the same way as our sandbox code: mozilla-config.h\nreplaces __try with if (true) and __except with else when compiling\nzucchini code. In MinGW builds, an I/O error on the mapped files thus\ncrashes updater.exe rather than making zucchini return an error status.\nThis is acceptable now that the updater is resilient to crashes that\noccur while drafting a patch (bug 2060275).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324618\n", "files": ["browser/config/mozconfigs/win32/mingwclang", "browser/config/mozconfigs/win64/mingwclang", "mozilla-config.h.in", "security/sandbox/moz.build", "third_party/zucchini/README.md", "third_party/zucchini/moz.build", "third_party/zucchini/moz_zucchini.cc"], "git_node": "e0dfef7faa4b748825a0d646d44643e27edd8ff9", "git_parents": ["3b6fb72bab0b132ff8585e3e1b7c6cff15dcaa00"], "node": "cb38444616bd7dc930ce5a69cf1271f475fdf6f4", "parents": ["6eaacb72b7f51ccd50bdca4337e8c183d52c9f3f"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071978 - Move the mMetrics field and GetHorizontalMetrics accessor into the base gfxFont class. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325946\n", "files": ["gfx/thebes/gfxDWriteFonts.h", "gfx/thebes/gfxFT2FontBase.h", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxMacFont.h"], "git_node": "59e315de3604bf656d1d7d86c8fafc1627f28443", "git_parents": ["e0dfef7faa4b748825a0d646d44643e27edd8ff9"], "node": "8c11f4ba902bc684400104fb134c5d8a6fe75bfd", "parents": ["cb38444616bd7dc930ce5a69cf1271f475fdf6f4"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072048 - Make nsHostRecord::mFromStaleCache atomic, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326137\n", "files": ["netwerk/dns/nsHostRecord.h"], "git_node": "60e8ebc4209c647052b62f47bd6e235733bf0304", "git_parents": ["59e315de3604bf656d1d7d86c8fafc1627f28443"], "node": "1af5f227d32b360f8f3a130c329c6d3ffc2c8ce5", "parents": ["8c11f4ba902bc684400104fb134c5d8a6fe75bfd"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2047745 - [wdspec] Cleanup wpt meta data for Android. r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325881\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browser/get_client_windows/get_client_windows.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/remove_user_context/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/remove_user_context/user_context.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/activate/activate.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/create/background.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/create/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/create/reference_context.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/create/type.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/fragm