af5a9c79ec381b9da5a8eb192", "64d572511940ba0403a820edd6ed3ee67ac88937", "226569bb9e673c8ca38f4d8f200836cd772f9c07", "9a2537dd0c6b6b095830918ecfda7933d7b55418", "67bbac0bc577525495399cbc70c60e9efab0f81d", "9e4ba5f8a056a91000b369dd508c1e438e3a2192"], "user": "archaeopteryx@coole-files.de"}, "45328": {"changesets": [{"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070927 - Enable CSS corner-shape in Nightly. r=gfx-reviewers,bradwerth\n\nEnable the pref 'layout.css.corner-shape.enabled' in Nightly-only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325458\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "fd608afe810cd1c569e080a2e7fa6a44829c1a58", "git_parents": ["5b7e5a4dfe77edefea01bc1fa95e663211091907"], "node": "39d874e5dc3745cb6ef8f07448de19132a394190", "parents": ["2cca38bf6e363b3dc90b6111bd1f6f9caab85aab"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068585 - Get rid of collections.OrderedDict r=jgraham\n\ndict is ordered since 3.6\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322952\n", "files": ["testing/web-platform/tests/common/security-features/tools/format_spec_src_json.py", "testing/web-platform/tests/common/security-features/tools/generate.py", "testing/web-platform/tests/common/security-features/tools/util.py", "testing/web-platform/tests/import-maps/data-driven/tools/format_json.py", "testing/web-platform/tests/tools/ci/tc/decision.py", "testing/web-platform/tests/tools/ci/tc/taskgraph.py", "testing/web-platform/tests/tools/manifest/XMLParser.py", "testing/web-platform/tests/tools/serve/serve.py", "testing/web-platform/tests/tools/web_features/web_feature_map.py", "testing/web-platform/tests/tools/websocket/h3/headers.py", "testing/web-platform/tests/tools/wpt/testfiles.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/config.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/pytestrunner/runner.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/stability.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_stability.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptcommandline.py", "testing/web-platform/tests/tools/wptserve/wptserve/response.py", "testing/web-platform/tests/tools/wptserve/wptserve/server.py", "testing/web-platform/tests/webdriver/tests/support/keys.py"], "git_node": "48d2f2fb1f485174cea7eef40f641bd5d5bbda77", "git_parents": ["fd608afe810cd1c569e080a2e7fa6a44829c1a58"], "node": "281831f97ab039cda8f7478072dcc8dd3f80241f", "parents": ["39d874e5dc3745cb6ef8f07448de19132a394190"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2071840 - Update sccache to 0.18.0 r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325835\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "5119866d056a61c961584936e7ab317aec409218", "git_parents": ["48d2f2fb1f485174cea7eef40f641bd5d5bbda77"], "node": "d2094ba84cad4da3e60dc01926db092ff0e54ef6", "parents": ["281831f97ab039cda8f7478072dcc8dd3f80241f"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071537 - Support stackless Exceptions in fenix Socorro client. r=android-reviewers,crashreporting-reviewers,gsvelto,sfamisa DONTBUILD\n\nA kotlinx.coroutines.JobCancellationException clears its stackTrace field which throws off\nour Socorro client to lose the throwable entirely. This patch introduces a synthetic stack\nso that the throwable is kept and processed by socorro. Fix both MozillaSocorroService.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325584\n", "files": ["mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/MozillaSocorroService.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/socorro/MozillaSocorroService.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/service/MozillaSocorroServiceTest.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/service/socorro/MozillaSocorroServiceTest.kt"], "git_node": "8cef8a1508c77fdc499f313e2d751d9fedc5a2f3", "git_parents": ["5119866d056a61c961584936e7ab317aec409218"], "node": "00c6357bfca68f3943e389d847125f68facec776", "parents": ["d2094ba84cad4da3e60dc01926db092ff0e54ef6"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2071096 - Use a pref observer to recalculate site categories. r=saschanaz\n\nSiteCategory parsed toolkit.telemetry.site_categories once, on creation, so a\ntest that changed that pref had to force a fresh instance to be created. The WPT\nhelper did that by looking up the existing factory with the deprecated\ngetClassObject and re-registering it under a second CID, which left\nnsFactoryEntry::mServiceObject null so that the next do_GetService built a new\nobject.\n\nInstead, have SiteCategory implement nsIObserver and register itself on\nnsIPrefBranch for that pref. Observe() drops the cached map so that the next\ngetCategory reparses. Recalculating eagerly in Observe() would work too, because\nPreferencesImpl::NotifyCallbacks fires the static pref mirror before any\nobserver, but there is no reason to do the work before it is needed.\n\npushPrefEnv is now enough on its own, so resources/SiteCategory.js goes away\nentirely and telemetry.sub.https.window.js no longer registers anything.\n\nAlso mark the component singleton in components.conf. Every consumer already\ngoes through the service manager, and the only caller that wanted a second\ninstance was the test helper removed here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325475\n", "files": ["testing/web-platform/mozilla/tests/notifications/resources/SiteCategory.js", "testing/web-platform/mozilla/tests/notifications/telemetry.sub.https.window.js", "toolkit/components/sitecategories/components.conf", "toolkit/components/sitecategories/src/lib.rs"], "git_node": "3850bc03b1265de5980f09491599c8899995b185", "git_parents": ["8cef8a1508c77fdc499f313e2d751d9fedc5a2f3"], "node": "49b18013d1b47e17960e1fed4fbc4d0e74c88f20", "parents": ["00c6357bfca68f3943e389d847125f68facec776"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2068590: Report the time since install and update in the new-profile ping. r=jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322906\n", "files": ["toolkit/profile/ProfileMetrics.sys.mjs", "toolkit/profile/metrics.yaml", "toolkit/profile/test/xpcshell/test_profile_metrics_time_since_install.js", "toolkit/profile/test/xpcshell/test_profile_metrics_time_since_no_files.js", "toolkit/profile/test/xpcshell/test_profile_metrics_time_since_update.js", "toolkit/profile/test/xpcshell/xpcshell.toml"], "git_node": "f24128ee8675568354078f2e720a7abaef4a3da1", "git_parents": ["3850bc03b1265de5980f09491599c8899995b185"], "node": "5f5f7ff3f129eb1f146cce9882d60d7b43d6af27", "parents": ["49b18013d1b47e17960e1fed4fbc4d0e74c88f20"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2070494: Mark this as intermittent on macos debug too. r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324621\n", "files": ["testing/web-platform/meta/webrtc-encoded-transform/RTCRtpScriptTransform-padding.https.html.ini"], "git_node": "e43f3b21287fa2bfe916cc11b4c2d72275764cc4", "git_parents": ["f24128ee8675568354078f2e720a7abaef4a3da1"], "node": "275d5b4c6c4f23b2c4da679049133d91dc13bf84", "parents": ["5f5f7ff3f129eb1f146cce9882d60d7b43d6af27"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2071880: Stop writing update_telemetry.json on macOS. r=application-update-reviewers,iholmes\n\nThis is affecting code signatures and while things appear to run that seems likely to cause issues somewhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325895\n", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "c6a7ce4594c154e1e97bf0353dcc40e198c1be5e", "git_parents": ["e43f3b21287fa2bfe916cc11b4c2d72275764cc4"], "node": "c81937908f480fd6e63a891e94ec1c0ba2e791fc", "parents": ["275d5b4c6c4f23b2c4da679049133d91dc13bf84"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068225 - Detect pairing campaign installs via utm_content. r=android-reviewers,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324909\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingServiceTest.kt"], "git_node": "a676d6b4920c81eaaefe21f0cb93687bf18babad", "git_parents": ["c6a7ce4594c154e1e97bf0353dcc40e198c1be5e"], "node": "14a25607c783315563fd7ab1c9cd74de5950437a", "parents": ["c81937908f480fd6e63a891e94ec1c0ba2e791fc"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066171 - Gate adaptive autofill page results behind a minimum use count threshold - r=mak,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322234\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/docs/preferences.md", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal_telemetry.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_reintegration.js", "browser/components/urlbar/tests/browser-autofill/browser_inputHistory_autofill.js", "browser/components/urlbar/tests/browser-autofill/browser_placeholder.js", "browser/components/urlbar/tests/browser-autofill/browser_reintegration_telemetry.js", "browser/components/urlbar/tests/browser-autofill/browser_resultMenu_dismissal.js", "browser/components/urlbar/tests/browser-autofill/head.js", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_selected_result.js", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_type.js", "browser/components/urlbar/tests/browser-telemetry/browser_autofill.js", "browser/components/urlbar/tests/unit/test_autofill_adaptiveHistory.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "e85f8154cf049550cdf2ea08cc1f537adb02aa10", "git_parents": ["a676d6b4920c81eaaefe21f0cb93687bf18babad"], "node": "8e4568744c4cb6857be7e4ab49be54d28617f069", "parents": ["14a25607c783315563fd7ab1c9cd74de5950437a"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057685 - Part 5: Add GeckoView API surface for obtaining full page screenshot r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318617\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoDisplay.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoView.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "5e9151c805e166de3fb96e8323c8843e2ffd7f36", "git_parents": ["e85f8154cf049550cdf2ea08cc1f537adb02aa10"], "node": "390d355097ad2b46117a88edd4044ce9ab512fc5", "parents": ["8e4568744c4cb6857be7e4ab49be54d28617f069"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2057988 - Reject a duplicate conduit id. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325089\n", "files": ["toolkit/components/extensions/ConduitsParent.sys.mjs"], "git_node": "ade6f27ca1b112b592b9c4da2c4f553988d716b4", "git_parents": ["5e9151c805e166de3fb96e8323c8843e2ffd7f36"], "node": "0debc05f8bc42fd4ab375e90b7aead5471b94d97", "parents": ["390d355097ad2b46117a88edd4044ce9ab512fc5"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071643: ignore `update_telemetry.json` differences in the install directory during update verification r=releng-reviewers,hneiva\n\nThis file is created at update time, and is only expected to exist in install directory where an update has been applied. This is an expected difference when comparing such a directory to an unpacked target installer, and we must ignore it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325896\n", "files": ["tools/update-verify/release/common/check_updates.sh"], "git_node": "66dfff6b82e22cf521f6cfc23373ec82d5ccef16", "git_parents": ["ade6f27ca1b112b592b9c4da2c4f553988d716b4"], "node": "bbd76c50b92960fa86cbbdde063aa1ab091f44b0", "parents": ["0debc05f8bc42fd4ab375e90b7aead5471b94d97"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071805 - Remove nsIStatefulFrame. r=layout-reviewers,dshin\n\nWe only have a single implementation for ScrollContainerFrame. Collapse\nit down in preparation for bigger changes to how scroll state is saved\nand restored, see bug 1397239.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325792\n", "files": ["layout/base/nsFrameManager.cpp", "layout/base/nsFrameManager.h", "layout/generic/FrameClasses.py", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h", "layout/generic/moz.build", "layout/generic/nsIStatefulFrame.h"], "git_node": "2cb306b1530b4364b75b39a8efbb48983b487fb2", "git_parents": ["66dfff6b82e22cf521f6cfc23373ec82d5ccef16"], "node": "e602fc8b5180215687db51892cc962a88f0bfa4f", "parents": ["bbd76c50b92960fa86cbbdde063aa1ab091f44b0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071805 - Move more state save / restore to ScrollContainerFrame. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325800\n", "files": ["layout/base/nsFrameManager.cpp", "layout/base/nsFrameManager.h", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h"], "git_node": "93605e884a390ba88e3bbb82b9886a60887cf2aa", "git_parents": ["2cb306b1530b4364b75b39a8efbb48983b487fb2"], "node": "fe79cddf4b76d472f98cc4afdd9a1c7313416a45", "parents": ["e602fc8b5180215687db51892cc962a88f0bfa4f"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2028961 - Remove pref for Temporal. r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325625\n", "files": ["js/src/shell/js.cpp", "js/src/vm/GlobalObject.cpp", "js/src/vm/JSObject.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "476d0d5c984fffbecf67cc3b90efeb6385767b4f", "git_parents": ["93605e884a390ba88e3bbb82b9886a60887cf2aa"], "node": "6e83a5afa1c32baeae3a9d4327f547ad979dc858", "parents": ["fe79cddf4b76d472f98cc4afdd9a1c7313416a45"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055929 - Fix dohCustomProvider resetting URL when switching back from custom URL r=mkennedy,emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312800\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_dnsoverhttps_srd.js"], "git_node": "cbdcc16c916e95c2578b99103a7c407e5b2c811d", "git_parents": ["476d0d5c984fffbecf67cc3b90efeb6385767b4f"], "node": "08211fe83b276beb000831884fb4d4f7566fe97c", "parents": ["6e83a5afa1c32baeae3a9d4327f547ad979dc858"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071505 - [devtools] Expect browser_styleeditor_telemetry.js fail for a11y r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325836\n", "files": ["devtools/client/styleeditor/test/browser.toml"], "git_node": "bda5163f45bd16af7d3bc68fad8d1de77437153a", "git_parents": ["cbdcc16c916e95c2578b99103a7c407e5b2c811d"], "node": "08cf758d9b2e96e77ff30876c014a25e4bfec183", "parents": ["08211fe83b276beb000831884fb4d4f7566fe97c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2062329 - Add use counters for the SpeechRecognition API. r=dom-core-reviewers,webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319563\n", "files": ["dom/base/UseCounters.conf", "dom/base/use_counter_metrics.yaml", "dom/webidl/SpeechRecognition.webidl"], "git_node": "6a95950cec0baf67a1c073a85b2ef7c61a977d24", "git_parents": ["bda5163f45bd16af7d3bc68fad8d1de77437153a"], "node": "3d9e2eadbf43cda2620158f3706b58c813bc47cd", "parents": ["08cf758d9b2e96e77ff30876c014a25e4bfec183"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2062329 - Record speech recognition usage, outcomes and errors with Glean. r=media-playback-reviewers,alwu,TravisLong\n\nsession_ended is recorded from Reset(), the one path every teardown goes\nthrough. No transcript text or audio is recorded.\n\nA session_id on both events pairs them, so a start and its outcome can be\njoined instead of subtracted as two populations across a day boundary.\n\nsession_started also reports the model and locale the session negotiated to,\nnot just the tag the page asked for: en, en-US and en-us all run the same\nmodel, and only the negotiated locale can be grouped on.\n\ninit_failure records the start failures whose cause content knows, because\nthe error codes the spec makes us fire are coarser: service-not-allowed alone\ncovers four distinct causes. The unsupported-language one is rejected before\n[[started]], so it records no session events at all and would otherwise be\ninvisible; it is also exactly why error and session_ended do not add up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319564\n", "files": ["dom/media/webspeech/metrics.yaml", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/test/browser.toml", "dom/media/webspeech/recognition/test/browser_speech_recognition_telemetry.js", "toolkit/components/glean/metrics_index.py"], "git_node": "e50a4acd7619c2436a624538a1540dc27cbbb9d4", "git_parents": ["6a95950cec0baf67a1c073a85b2ef7c61a977d24"], "node": "83e4f40b5a4ca3d58c030f1faaa8252fd835de21", "parents": ["3d9e2eadbf43cda2620158f3706b58c813bc47cd"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2062329 - Measure speech recognition latency in the content process. r=media-playback-reviewers,alwu\n\nTwo timing distributions are recorded content-side:\n\n- session_init_time measures the page-visible wait between start() and the\n  model becoming ready for recognition. It only has a sample when init\n  succeeded, so its description says to read it against init_failure: a\n  regression turning slow inits into failures would otherwise look like an\n  improvement.\n- result_latency records one sample per session: the mean capture-to-JS\n  latency of its results, using the capture timestamps already plumbed end to\n  end by AudioCaptureTiming.h.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319565\n", "files": ["dom/media/webspeech/metrics.yaml", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/test/browser_speech_recognition_telemetry.js", "dom/media/webspeech/recognition/test/test_parakeet_e2e.html"], "git_node": "bcb8676f4a7218d9abc8ed960025c91ca99b9198", "git_parents": ["e50a4acd7619c2436a624538a1540dc27cbbb9d4"], "node": "a6cec24d07741e492d90802878203bd5f53a0513", "parents": ["83e4f40b5a4ca3d58c030f1faaa8252fd835de21"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2062329 - Measure inference cost and init failures in the HWInference process. r=media-playback-reviewers,alwu\n\nRecorded in the utility process, where inference happens:\n\n- model_load_time measures reading the GGUF into memory. Like\n  session_init_time it only has a sample on success, which its description\n  now says.\n- inference_realtime_factor records one per-session mean of per-chunk\n  throughput as audio duration divided by compute time, times 100 (400 means\n  4x faster than real time). Recognition happens continuously on chunks of\n  similar size, so getting the average is meaningful here. The range reaches\n  100x rather than 20x, because hardware that runs this model comfortably\n  sits above 20x and would otherwise land entirely in the top bucket; the\n  bounds also put a bucket boundary exactly at 100, so falling behind real\n  time is a clean cut.\n- init_failure gains the inference-process labels, one per step that can\n  fail, so a spike says where init broke rather than only that it did. The\n  previous model_load_failed covered six unrelated steps, two of which were\n  not model loads at all, and other covered four.\n\nThe tests verify that starting without an installed model reaches the\ncorresponding failure label and run real recognition end-to-end. They check\nthat the timing metrics have one session-level sample and log values rather\nthan asserting timings, since those depend on the machine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319566\n", "files": ["dom/media/webspeech/metrics.yaml", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/test/browser.toml", "dom/media/webspeech/recognition/test/browser_speech_recognition_inference_telemetry.js", "dom/media/webspeech/recognition/test/browser_speech_recognition_telemetry.js"], "git_node": "653de47c22f3bdedf386faae28c169c4e989523f", "git_parents": ["bcb8676f4a7218d9abc8ed960025c91ca99b9198"], "node": "b19693064953cb7a6eaa8e96c24fedff79a95c1d", "parents": ["a6cec24d07741e492d90802878203bd5f53a0513"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2062329 - Attribute MLModelHubService downloads to the requesting task. r=ai-platform-reviewers,valentinp\n\nMLModelHubService used the constant \"ml-model-hub-service\" as the feature ID for every native caller, so the existing firefox_ai_runtime.model_download events could not be selected by feature.\n\nPass the caller-provided task name as featureId, matching getModelBlob(). The browser test downloads through nsIMLModelHub and checks that every lifecycle event is attributed to speech-recognition.\n\nRemove an attribute that was wrongly added and causes this to fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322658\n", "files": ["toolkit/components/ml/MLModelHubService.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_telemetry.js"], "git_node": "8e24ac8fea44d233fc65cb6880615defb56bc3c2", "git_parents": ["653de47c22f3bdedf386faae28c169c4e989523f"], "node": "d607e1d2efcf112f342c63b81542e06923dd0712", "parents": ["b19693064953cb7a6eaa8e96c24fedff79a95c1d"], "tags": []}, {"author": "Tyler Etchart \u003ctetchart@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065119 - fixed Crash in [@ AsyncShutdownTimeout | profile-before-change | MonitorStore: Shutdown] r=ngrato,again\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323392\n", "files": ["browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/agents/MonitorStore.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/models/tests/browser/browser_monitor_store.js"], "git_node": "1a1921e3ddd0282b1b1a9d60cae5514b1bde2f0d", "git_parents": ["8e24ac8fea44d233fc65cb6880615defb56bc3c2"], "node": "e37b579723a02482b1a33737e61dfce26652ca7a", "parents": ["d607e1d2efcf112f342c63b81542e06923dd0712"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070927 - Enable CSS corner-shape in Nightly. r=gfx-reviewers,bradwerth\" for causing mochitest failures @test_property_syntax_errors.html.\n\nThis reverts commit fd608afe810cd1c569e080a2e7fa6a44829c1a58.\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "07e78c38a6cdaf7600ca3c078c1cd115d1f4c9c7", "git_parents": ["1a1921e3ddd0282b1b1a9d60cae5514b1bde2f0d"], "node": "d38afc85bc80d9b404fe2dd3fab806186458e702", "parents": ["e37b579723a02482b1a33737e61dfce26652ca7a"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057988 - Reject a duplicate conduit id. r=robwu\" for causing mochitest failures @test_ext_subframes_privileges.html.\n\nThis reverts commit ade6f27ca1b112b592b9c4da2c4f553988d716b4.\n", "files": ["toolkit/components/extensions/ConduitsParent.sys.mjs"], "git_node": "f0fa19350497b5579a87d48f264a9a75b6f2170e", "git_parents": ["07e78c38a6cdaf7600ca3c078c1cd115d1f4c9c7"], "node": "a4484497e997deb937031bed2fb38fd766c4de92", "parents": ["d38afc85bc80d9b404fe2dd3fab806186458e702"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["layout/generic/nsIStatefulFrame.h", "testing/web-platform/mozilla/tests/notifications/resources/SiteCategory.js"], "git_node": "6c74efe2fcddf84b6f320959064a66946b4a1759", "git_parents": ["9e4ba5f8a056a91000b369dd508c1e438e3a2192", "f0fa19350497b5579a87d48f264a9a75b6f2170e"], "node": "8c1187b2fe37c2780372efe712c41586a01154b6", "parents": ["676f285ecde1b5c825bcfb6ea533abfe0e06c5f1", "a4484497e997deb937031bed2fb38fd766c4de92"], "tags": []}], "date": 1789422202, "git_changesets": ["fd608afe810cd1c569e080a2e7fa6a44829c1a58", "48d2f2fb1f485174cea7eef40f641bd5d5bbda77", "5119866d056a61c961584936e7ab317aec409218", "8cef8a1508c77fdc499f313e2d751d9fedc5a2f3", "3850bc03b1265de5980f09491599c8899995b185", "f24128ee8675568354078f2e720a7abaef4a3da1", "e43f3b21287fa2bfe916cc11b4c2d72275764cc4", "c6a7ce4594c154e1e97bf0353dcc40e198c1be5e", "a676d6b4920c81eaaefe21f0cb93687bf18babad", "e85f8154cf049550cdf2ea08cc1f537adb02aa10", "5e9151c805e166de3fb96e8323c8843e2ffd7f36", "ade6f27ca1b112b592b9c4da2c4f553988d716b4", "66dfff6b82e22cf521f6cfc23373ec82d5ccef16", "2cb306b1530b4364b75b39a8efbb48983b487fb2", "93605e884a390ba88e3bbb82b9886a60887cf2aa", "476d0d5c984fffbecf67cc3b90efeb6385767b4f", "cbdcc16c916e95c2578b99103a7c407e5b2c811d", "bda5163f45bd16af7d3bc68fad8d1de77437153a", "6a95950cec0baf67a1c073a85b2ef7c61a977d24", "e50a4acd7619c2436a624538a1540dc27cbbb9d4", "bcb8676f4a7218d9abc8ed960025c91ca99b9198", "653de47c22f3bdedf386faae28c169c4e989523f", "8e24ac8fea44d233fc65cb6880615defb56bc3c2", "1a1921e3ddd0282b1b1a9d60cae5514b1bde2f0d", "07e78c38a6cdaf7600ca3c078c1cd115d1f4c9c7", "f0fa19350497b5579a87d48f264a9a75b6f2170e", "6c74efe2fcddf84b6f320959064a66946b4a1759"], "user": "ctuns@mozilla.com"}, "45329": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071030 - Merge directions when an RTP header extension is registered again with a different direction. r=webrtc-reviewers,bwc\n\nRegistering the same extension URI with different directions used to create\ntwo extmap entries with different ids for the same URI. Merge the directions\ninto the existing entry instead, so that a URI always maps to a single id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325876\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "38b41b6b51390ed5cc2a22f42d5b9f33e49c6c30", "git_parents": ["f0fa19350497b5579a87d48f264a9a75b6f2170e"], "node": "bccf9519e829da843a0fd4afa3dc28c73749a593", "parents": ["a4484497e997deb937031bed2fb38fd766c4de92"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071030 - Negotiate the dependency descriptor RTP header extension for receiving video. r=webrtc-reviewers,bwc\n\nlibwebrtc 152 rejects temporal units whose spatial indices are not strictly\nincreasing. Without the dependency descriptor, AV1 frames are handled by the\nsequence-number-only reference finder which stamps every frame with spatial\nindex 0, so layered AV1 streams (e.g. L2T3_KEY) never decode. Always offer the\ndependency descriptor for receiving video, and keep sending it for simulcast.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325877\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/tests/mochitests/test_peerConnection_basicAudioVideoVerifyExtmap.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_basicAudioVideoVerifyExtmapSendonly.html", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "5458391c4313e323f9cf669393595bde2afffd5c", "git_parents": ["38b41b6b51390ed5cc2a22f42d5b9f33e49c6c30"], "node": "f3e80405ec261da24b3e0d548cf167b457eb61ce", "parents": ["bccf9519e829da843a0fd4afa3dc28c73749a593"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069142 - Register the new text_selection search access point. r=Standard8\n\nAdds text_selection to BrowserSearchTelemetry.KNOWN_SEARCH_SOURCES, the\nsap.counts and serp.impression source values, a\nbrowser.engagement.navigation.text_selection counter, and the matching SAP\nlists in the search telemetry docs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324773\n", "files": ["browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/docs/telemetry.md", "browser/components/search/metrics.yaml"], "git_node": "a0e561d63140c08f32f36b0840c950500d30608b", "git_parents": ["5458391c4313e323f9cf669393595bde2afffd5c"], "node": "039f042146c76702f9ca2602b5534bd027f80335", "parents": ["f3e80405ec261da24b3e0d548cf167b457eb61ce"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047968 - Don't send the ML-KEM key share for WebRTC DTLS by default r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325844\n", "files": ["dom/media/webrtc/tests/mochitests/test_peerConnection_glean.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "6ac277500440a6c7bf7ae6e8f1d592717f134262", "git_parents": ["a0e561d63140c08f32f36b0840c950500d30608b"], "node": "36e490d29a10dc82fb75617102e933deddb09c11", "parents": ["039f042146c76702f9ca2602b5534bd027f80335"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061808 - Make private browsing shortcut open a new private tab when HNT is enabled r=android-reviewers,gl\n\n* Skip the StartSearchIntentProcessor and use the new OpenHomeIntentProcessor when homepage as new tab is enabled and the user presses the private browsing shortcut\n* Since the handling is in the intent processor and we aren't changing the actual app launcher intent, we don't need to worry about a stale shortcut opening to the wrong place\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323585\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/PrivateShortcutCreateManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/OpenHomeIntentProcessor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/StartSearchIntentProcessor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/OpenHomeIntentProcessorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/StartSearchIntentProcessorTest.kt"], "git_node": "11f2700e35f49723c27ba8c9db2c1013b351c99f", "git_parents": ["6ac277500440a6c7bf7ae6e8f1d592717f134262"], "node": "96164407cc9ff1bf81da6d5160ceecb6a5aa9165", "parents": ["36e490d29a10dc82fb75617102e933deddb09c11"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066918 - Make the navigational-prefetch activation flag actually reach content r=necko-reviewers,acreskey,avandolder,jesup\n\nTryActivateFromPrefetch() sets the flag on mTiming, but nothing could observe\nit: Open() assigned mTiming after the call, the parent only hands its timing\nback on a process switch, and the copy constructor on that path dropped the\nfield. The same-process path now reads nsILoadInfo (bug 2060983) instead of\nadding a second IPC representation.\n\ndeliveryType also requires a cache hit now: a matching record does not mean the\nprefetched response was served, since the cache entry is not pinned.\n\nPatch 1 of 2; the pageload-event document_features bit follows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318192\n", "files": ["dom/base/nsDOMNavigationTiming.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_prefetch_delivery_type.js", "dom/base/test/file_pageload_prefetch_plain.html", "dom/base/test/file_pageload_prefetch_source.html", "dom/base/test/file_pageload_prefetch_target.sjs", "dom/performance/PerformanceMainThread.cpp", "netwerk/ipc/DocumentChannelChild.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-delivery-type.https.html.ini"], "git_node": "4c9281d78c70d20d2db9a649a22b9427cf535641", "git_parents": ["11f2700e35f49723c27ba8c9db2c1013b351c99f"], "node": "73ca121782b2facc335560d119d28faad003f98a", "parents": ["96164407cc9ff1bf81da6d5160ceecb6a5aa9165"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2064102 - Wait for previous entries to enter the BFCache in browser_policy_sitepolicies_serviceworkers.js. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325803\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_serviceworkers.js"], "git_node": "4cbfe67983ba6bf4d07515da28642d551047f87d", "git_parents": ["4c9281d78c70d20d2db9a649a22b9427cf535641"], "node": "accbcbbbf2454265fe87d1eba699110013e401d0", "parents": ["73ca121782b2facc335560d119d28faad003f98a"], "tags": []}, {"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070466 - Record form_autocomplete.show_logins once per input element r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324574\n", "files": ["toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_footer.js", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_password_generation_telemetry.html"], "git_node": "7510f6b1b78516c0c1839cf54137a4fcced68186", "git_parents": ["4cbfe67983ba6bf4d07515da28642d551047f87d"], "node": "cb37ad21da85d42eb54c399c8e8a3a272966f5fb", "parents": ["accbcbbbf2454265fe87d1eba699110013e401d0"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069163 - Support CSS Module Scripts in Storybook r=jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323433\n", "files": ["browser/components/storybook/.storybook/main.js", "browser/components/storybook/.storybook/moz-styles-loader.js"], "git_node": "4a68d07d30fca3bf1738b6b1413171b46b3d21ab", "git_parents": ["7510f6b1b78516c0c1839cf54137a4fcced68186"], "node": "95156030d1b058635233fb92a4f6c70d4a87ff3d", "parents": ["cb37ad21da85d42eb54c399c8e8a3a272966f5fb"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068791 - Always avoid text wrapping moz-support-links r=desktop-theme-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323122\n", "files": ["browser/themes/shared/preferences/preferences.css", "toolkit/content/jar.mn", "toolkit/content/widgets/moz-fieldset/moz-fieldset.css", "toolkit/content/widgets/moz-input-common.css", "toolkit/content/widgets/moz-label/moz-label.mjs", "toolkit/content/widgets/moz-support-link/moz-support-link.css", "toolkit/content/widgets/moz-support-link/moz-support-link.mjs", "toolkit/content/widgets/styles-mixin.mjs"], "git_node": "7f7f252f29a3dc395c406fbaffee69ea621838c6", "git_parents": ["4a68d07d30fca3bf1738b6b1413171b46b3d21ab"], "node": "9818ac097e398b620a6d74f137dd6d1d5172eba0", "parents": ["95156030d1b058635233fb92a4f6c70d4a87ff3d"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064736 - Expose --font-size-small to chrome documents r=dao,morgan,desktop-theme-reviewers,webcompat-reviewers,twisniewski\n\nProvide `--font-size-small` in chrome documents and target its relative\nfont size to be \u003e= 11px. On macOS this means using 1rem, on Windows it's\n(11 / 12)rem and Linux is left unchanged at expected 12.72px (14.6719 * 0.867)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319833\n", "files": ["browser/components/reportbrokensite/content/reportBrokenSitePanel.inc.xhtml", "toolkit/themes/linux/global/global.css", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/base/font.tokens.json"], "git_node": "815baf80281bbf65b258008399f43a611a86a8ec", "git_parents": ["7f7f252f29a3dc395c406fbaffee69ea621838c6"], "node": "12705986a0d85198e99f353ddb63ca19cbd45f67", "parents": ["9818ac097e398b620a6d74f137dd6d1d5172eba0"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062774 - Use design tokens for Account menu small fonts r=nsharpley,desktop-theme-reviewers,dao\n\nUse --font-size-small and .text-deemphasized rather than rolling the\ncustom 0.9em font size and helper styles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321738\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "31ca054b4b65b3b9f33ded854974efdbdd9c0cd4", "git_parents": ["815baf80281bbf65b258008399f43a611a86a8ec"], "node": "c4a37c4149ee7f716af72f2a927eaa0754940520", "parents": ["12705986a0d85198e99f353ddb63ca19cbd45f67"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071370 - Update AndroidX Media3 to version 1.11.1. r=android-reviewers,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325485\n", "files": ["gradle/libs.versions.toml"], "git_node": "11adae5dd72dc7cef357ff4fe514c2973d2b6f92", "git_parents": ["31ca054b4b65b3b9f33ded854974efdbdd9c0cd4"], "node": "85a6d625fc93c26028ab45a3030442d66987416b", "parents": ["c4a37c4149ee7f716af72f2a927eaa0754940520"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2065295 - Do not grey out the clear-on-shutdown sub-settings when a policy locks clearing on. r=mstriemer\n\nSanitizeOnShutdown locks privacy.sanitize.sanitizeOnShutdown, which disables the\n\"Clear history when Firefox closes\" checkbox. Manage Exceptions and the button\nthat picks which categories to clear were disabled along with it, because both\nkeyed off alwaysClear.disabled.\n\nNeither of those belongs to the policy. Exceptions are not a pref at all, and\nthe categories a policy leaves unset are deliberately left unlocked. Both now\nkey off whether clearing is going to happen, rather than off whether the\ncheckbox happens to be editable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321561\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_sanitize_on_shutdown.js", "browser/components/preferences/config/privacy.mjs"], "git_node": "6db1b82dfea7c3e961d813e19303e0c80be0f15c", "git_parents": ["11adae5dd72dc7cef357ff4fe514c2973d2b6f92"], "node": "e92cb95650aa7e9d2703f5193ba02dcc0ff52daf", "parents": ["85a6d625fc93c26028ab45a3030442d66987416b"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057685 - Part 6: Use the full page screenshot API in GVE r=geckoview-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318623\n", "files": ["mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/GeckoViewActivity.java"], "git_node": "af1b1beeb1306d2e95017136185c8adb66a1bc3d", "git_parents": ["6db1b82dfea7c3e961d813e19303e0c80be0f15c"], "node": "47e8eccd5384708f78fdd9784d10a552910911aa", "parents": ["e92cb95650aa7e9d2703f5193ba02dcc0ff52daf"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071627 - Shape the audio-focus request made after startForeground() after the tab's audio-session type. r=android-reviewers,owlish\n\nBug 2047296 mapped each audio-session type to a matching platform focus request, but only the\nalready-in-foreground branch of handleMediaPlaying() passes the tab's type. The request issued once the\nforeground service has started, which is the one made on every playback start, still uses the PLAYBACK\ndefault, so a transient or ambient tab claims durable media focus until its next playing transition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325622\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt"], "git_node": "1672e474c2e14db63c2e158b6234064a2ee18101", "git_parents": ["af1b1beeb1306d2e95017136185c8adb66a1bc3d"], "node": "21535d99e5f0a906056de79a2b072525e65dd665", "parents": ["47e8eccd5384708f78fdd9784d10a552910911aa"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2071805 - Remove dead ScrollContainerFrame::SaveState case. r=layout-reviewers,dshin\n\nThe only frames that implement nsIScrollbarMediator are\nScrollContainerFrame and nsTreeBodyFrame, none of which can end up\ndirectly as the scrolled frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325802\n", "files": ["layout/generic/ScrollContainerFrame.cpp"], "git_node": "076117aca756cf6d8165c25e37bddb2dc89e199f", "git_parents": ["1672e474c2e14db63c2e158b6234064a2ee18101"], "node": "0543b74788283a7dc36d075a75f011f3180caa2f", "parents": ["21535d99e5f0a906056de79a2b072525e65dd665"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028375: Improve IDB Cursor Tests. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291432\n", "files": ["dom/indexedDB/test/crashtests/2028375-1.html", "dom/indexedDB/test/crashtests/crashtests.list"], "git_node": "e61172bc5ec5c5cb4c99f2f6ceb68ddadd440220", "git_parents": ["076117aca756cf6d8165c25e37bddb2dc89e199f"], "node": "80f024672fdaafb4b5097c37cd59491991eb837d", "parents": ["0543b74788283a7dc36d075a75f011f3180caa2f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071126 - Update Robolectric to 4.17. r=android-reviewers,adhingra\n\nAlso migrate LifecycleAwareSensorManagerAccelerometerTest off the deprecated ShadowSensor.newInstance\nand SensorEventBuilder.newBuilder() APIs to SensorBuilder and SensorEventBuilder.newBuilder(sensor,\nvalues), which were removed in Robolectric 4.17.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325207\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/components/lib/accelerometer-sensormanager/src/test/java/mozilla/components/lib/accelerometer/sensormanager/LifecycleAwareSensorManagerAccelerometerTest.kt"], "git_node": "2246c28dfdf42b1c7f5986b6a53c55456df3c3c5", "git_parents": ["e61172bc5ec5c5cb4c99f2f6ceb68ddadd440220"], "node": "03de0075ac8550d5f5bc145061636f32a826d859", "parents": ["80f024672fdaafb4b5097c37cd59491991eb837d"], "tags": []}, {"author": "Alan Liu \u003chaoping.liu@amd.com\u003e", "branch": "default", "desc": "Bug 2070077 - Skip the GL context when locking DMABUF images on the layer compositor path r=lsalzman,gfx-reviewers\n\nRenderCompositorNativeOGL::AttachExternalImage already passes a null GL\ncontext for DMABUF hosts so that direct scanout does not pay for a\nper-frame EGLImage import and BO mapping. RenderCompositorLayerNativeOGL\nis a parallel implementation of the same operation and was left\nunchanged, so it still imports and releases the video buffer on every\nframe.\n\nThe layer compositor is what Linux actually uses and the earlier fix for\nbug 2011821 does not apply there. So apply the same\nAsRenderDMABUFTextureHost() gate here. Hosts that need a real context,\nsuch as RenderMacIOSurfaceTextureHost, keep receiving one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324203\n", "files": ["gfx/webrender_bindings/RenderCompositorLayerNative.cpp"], "git_node": "f8744b458ca5ca9d7f4c18f9cfbaeb162813ce5f", "git_parents": ["2246c28dfdf42b1c7f5986b6a53c55456df3c3c5"], "node": "6a9f967beecd41a6c907a3e7b8ff67b0c995b08d", "parents": ["03de0075ac8550d5f5bc145061636f32a826d859"], "tags": []}, {"author": "Mathew Hodson \u003cmathew.hodson@gmail.com\u003e", "branch": "default", "desc": "Bug 2068805 - Move MASM debug flags to configure r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323139\n", "files": ["build/moz.configure/toolchain.configure", "python/mozbuild/mozbuild/frontend/context.py"], "git_node": "7d261dde4434d9449a18932ed43aff4edaf93e06", "git_parents": ["f8744b458ca5ca9d7f4c18f9cfbaeb162813ce5f"], "node": "311d88c71b9128b730604d759b585d86abfe358c", "parents": ["6a9f967beecd41a6c907a3e7b8ff67b0c995b08d"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071221 - Rerun typescript type definition generation again r=Standard8\n\nmach ts build && mach ts update\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325358\n", "files": ["tools/@types/generated/lib.gecko.glean.d.ts", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "8733d0ceae0f15c1c23cbff1681274876c427aaa", "git_parents": ["7d261dde4434d9449a18932ed43aff4edaf93e06"], "node": "de294626a5e1df926b3c5b9d84eeec52116df367", "parents": ["311d88c71b9128b730604d759b585d86abfe358c"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071921 - Use fallible allocation for color-font palettes to avoid a potential OOM crash with large fonts. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325911\n", "files": ["gfx/thebes/COLRFonts.cpp"], "git_node": "f14b51895e5fdef7dae2abc4778a86d11d84a3ef", "git_parents": ["8733d0ceae0f15c1c23cbff1681274876c427aaa"], "node": "efdad5a6ceba9193ac92b2bba0dee0884f628d3f", "parents": ["de294626a5e1df926b3c5b9d84eeec52116df367"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065486 - Update illustration for sync disconnected state in sidebar r=fxview-reviewers,desktop-theme-reviewers,nsharpley,emilio\n\n* Add asset property for sync error map and consolidate the getMessageCardForState logic\n* Remove height and width from new svgs so they scale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321595\n", "files": ["browser/components/firefoxview/SyncedTabsController.sys.mjs", "browser/components/firefoxview/firefox-view-synced-tabs-error-handler.sys.mjs", "browser/components/firefoxview/tests/browser/browser_syncedtabs_errors_firefoxview.js", "browser/themes/shared/sidebar/kit-page-history.svg", "browser/themes/shared/sidebar/kit-qr-tabs-devices-empty.svg", "browser/themes/shared/sidebar/kit-tabs-devices-error.svg", "browser/themes/shared/sidebar/kit-tabs-devices.svg"], "git_node": "9487af84c0935d6c7e8aff411e1c6ee6db4c81b3", "git_parents": ["f14b51895e5fdef7dae2abc4778a86d11d84a3ef"], "node": "8dd13c624a48298b44cd1b5ef23ee9829392050f", "parents": ["efdad5a6ceba9193ac92b2bba0dee0884f628d3f"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 5841f94386cb0f98be9b40f499edc8b791a29bff\naf -\u003e 584