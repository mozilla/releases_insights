idump-writer/src/linux/dso_debug.rs", "third_party/rust/minidump-writer/src/linux/dumper_cpu_info/arm.rs", "third_party/rust/minidump-writer/src/linux/dumper_cpu_info/x86.rs", "third_party/rust/minidump-writer/src/linux/maps_reader.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/app_memory.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/errors.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/handle_data_stream.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/mappings.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/memory_info_list_stream.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/mod.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/systeminfo_stream.rs", "third_party/rust/minidump-writer/src/linux/minidump_writer/thread_list_stream.rs", "third_party/rust/minidump-writer/src/linux/mod.rs", "third_party/rust/minidump-writer/src/linux/module_list.rs", "third_party/rust/minidump-writer/src/linux/module_reader.rs", "third_party/rust/minidump-writer/src/linux/process_inspection/mod.rs", "third_party/rust/minidump-writer/src/linux/process_inspection/process_reader.rs", "third_party/rust/minidump-writer/src/linux/thread_info/aarch64.rs", "third_party/rust/minidump-writer/src/linux/thread_info/arm.rs", "third_party/rust/minidump-writer/src/linux/thread_info/mod.rs", "third_party/rust/minidump-writer/src/linux/thread_info/x86.rs", "third_party/rust/minidump-writer/src/mac/mach.rs", "third_party/rust/minidump-writer/src/mac/streams/exception.rs", "third_party/rust/minidump-writer/src/mac/streams/memory_list.rs", "third_party/rust/minidump-writer/src/mac/streams/module_list.rs", "third_party/rust/minidump-writer/tests/common/mod.rs", "third_party/rust/minidump-writer/tests/linux_minidump_writer.rs", "third_party/rust/minidump-writer/tests/linux_minidump_writer_soft_error.rs", "third_party/rust/minidump-writer/tests/mac_minidump_writer.rs", "third_party/rust/minidump-writer/tests/ptrace_dumper.rs", "third_party/rust/minidump-writer/tests/windows_minidump_writer.rs", "third_party/rust/process-backend/.cargo-checksum.json", "third_party/rust/process-backend/CHANGELOG.md", "third_party/rust/process-backend/Cargo.toml", "third_party/rust/process-backend/LICENSE", "third_party/rust/process-backend/release.toml", "third_party/rust/process-backend/src/drop_fail_handler.rs", "third_party/rust/process-backend/src/lib.rs", "third_party/rust/process-backend/src/local/error.rs", "third_party/rust/process-backend/src/local/mod.rs", "third_party/rust/process-backend/src/local/module_reader.rs", "third_party/rust/process-backend/src/local/syscall_invoker.rs", "third_party/rust/process-backend/src/regs.rs", "third_party/rust/process-backend/src/wrapper.rs", "third_party/rust/process-reader/.cargo-checksum.json", "third_party/rust/process-reader/CHANGELOG.md", "third_party/rust/process-reader/Cargo.toml", "third_party/rust/process-reader/LICENSE", "third_party/rust/process-reader/release.toml", "toolkit/crashreporter/crash_helper_client/Cargo.toml", "toolkit/crashreporter/crash_helper_common/Cargo.toml", "toolkit/crashreporter/crash_helper_server/Cargo.toml", "toolkit/crashreporter/process_reader/Cargo.toml", "toolkit/crashreporter/rust_minidump_writer_linux/Cargo.toml", "toolkit/crashreporter/rust_minidump_writer_linux/src/lib.rs"], "git_node": "02a85845eb021a33a9de9870a2710c50f05644a1", "git_parents": ["0a7d8cbbbf66e001206ee9d536416eadbb5927cb"], "node": "a20715dc80a5ad414e51e67b6310e42d7c753da8", "parents": ["314502c4e3fbd70c1c1c74aad379825b9768067d"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2070227 - Enable Show more Shortcuts by default in all channels r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324370\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "94eea9fef7b8512e65771d3932e031fe29f6d04d", "git_parents": ["02a85845eb021a33a9de9870a2710c50f05644a1"], "node": "a62fa4e2a84c4e1e760ec21546126aed7f19e524", "parents": ["a20715dc80a5ad414e51e67b6310e42d7c753da8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069604 - Split --menuitem-padding into --menuitem-padding-block and --menuitem-padding-inline. r=emilio,desktop-theme-reviewers\n\nBehavior-neutral: every site that set the shorthand now sets the pair, and the shorthand is gone, so an override can no longer set padding that the block value doesn't see.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324633\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/sidebar.css", "toolkit/themes/shared/global-shared.css", "toolkit/themes/shared/menu.css"], "git_node": "e5f2417658b937b6585d1d2989c316c5ef00b32a", "git_parents": ["94eea9fef7b8512e65771d3932e031fe29f6d04d"], "node": "0018a607d81bfa95a0a88518b33d9931ef391df5", "parents": ["a62fa4e2a84c4e1e760ec21546126aed7f19e524"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069604 - Drop the always-zero --panel-menuitem-margin-block. r=emilio,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324634\n", "files": ["toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/panel-menuitem.tokens.json"], "git_node": "2187cb158e0f757edb289e8933818125e8674720", "git_parents": ["e5f2417658b937b6585d1d2989c316c5ef00b32a"], "node": "55d327b1a306d109f54a71efab92bfc17e99cf16", "parents": ["0018a607d81bfa95a0a88518b33d9931ef391df5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069604 - Scroll a menupopup by whole menuitems. r=emilio,desktop-theme-reviewers\n\nRouting the padding and margins through variables computes to the values they had, except that the Windows menu icon's block margin is now split evenly across both sides so that a single variable can carry it, which leaves the item height alone and centers the icon in the line box.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324636\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/test_menupopup_scroll_amount.xhtml", "toolkit/themes/shared/menu.css", "toolkit/themes/windows/global/global.css"], "git_node": "b70e89a55cd19b7017f73e43474f90e820d48f60", "git_parents": ["2187cb158e0f757edb289e8933818125e8674720"], "node": "ac7f3f0184c0950b4484199ddf70084bfcf6de0a", "parents": ["55d327b1a306d109f54a71efab92bfc17e99cf16"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070770 - [loong64] Part 1: Optimize zero immediate cases in ma_add_d(Register, Register, Imm{32,Word}). r=jandem\n\nThis simplifies the implementation of the Imm32 variant with the new\nma_move, then add special-casing for ImmWord variant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324822\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "8a88bbc810e4a662f96ad741204a6337f4938b14", "git_parents": ["b70e89a55cd19b7017f73e43474f90e820d48f60"], "node": "c24785c4b30d2763a4307c971aedf7bbbaef713b", "parents": ["ac7f3f0184c0950b4484199ddf70084bfcf6de0a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070770 - [loong64] Part 2: Optimize zero immediate cases in ma_or(Register, Register, Imm32). r=jandem\n\nAccording to LoongLint, this elides ~2500 instructions (excluding\nma_liPatchable sites) on JetStream 3 and ~100 on Octane.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324823\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "3e5acbf46ca0d1153bdc06aafaea0f5a20b8d20e", "git_parents": ["8a88bbc810e4a662f96ad741204a6337f4938b14"], "node": "f61934b3e711025e583a2d6a164f41abd6554fe2", "parents": ["c24785c4b30d2763a4307c971aedf7bbbaef713b"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070770 - [loong64] Part 3: Optimize zero immediate cases in ma_sub_d(Register, Register, Imm{32,Word}). r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324824\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "af9b99c7462ef7bb9603da34be4baa4be11e89e2", "git_parents": ["3e5acbf46ca0d1153bdc06aafaea0f5a20b8d20e"], "node": "01ed958faaa52730f91da8e09c0596185b0123ea", "parents": ["f61934b3e711025e583a2d6a164f41abd6554fe2"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070557 - [riscv64] Part 1: Switch to explicit addi in MacroAssembler::wasmMarkCallAsSlow(). r=jandem\n\nThis helps later elision of self-moves.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324639\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "3aea2ef8711f7238fd05ddaafdef3954c6273834", "git_parents": ["af9b99c7462ef7bb9603da34be4baa4be11e89e2"], "node": "43a089a7f75a77268c624f727b9e31e0a7d74916", "parents": ["01ed958faaa52730f91da8e09c0596185b0123ea"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070557 - [riscv64] Part 2: Introduce ma_mv for elidable moves. r=jandem\n\nThis function will be used in later parts. Keep AssemblerRISCVI::mv()\nintact since it corresponds to an actual RISC-V pseudo-instruction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324640\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h"], "git_node": "cf5bdde07db883c1774ddb04e9b6cc89eaa04df5", "git_parents": ["3aea2ef8711f7238fd05ddaafdef3954c6273834"], "node": "db02850efbbafc963277df9be33539c8b276f201", "parents": ["43a089a7f75a77268c624f727b9e31e0a7d74916"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070557 - [riscv64] Part 3: Switch to ma_mv when applicable. r=jandem\n\nPer LoongLint for RISC-V, this eliminates 9 (out of 206) non-canonical\nnops on Octane with codegen profile RVA23U64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324641\n", "files": ["js/src/jit-test/tests/wasm/binop-divrem-with-constant-riscv64-ion-codegen.js", "js/src/jit/riscv64/CodeGenerator-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jit/riscv64/Trampoline-riscv64.cpp"], "git_node": "b58508c62abb0948ae11ff5dc3db403270ffc59f", "git_parents": ["cf5bdde07db883c1774ddb04e9b6cc89eaa04df5"], "node": "a5ba46738f1ab22ce3a9e7efe3a04644499eb6f9", "parents": ["db02850efbbafc963277df9be33539c8b276f201"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070557 - [riscv64] Part 4: Optimize zero immediate cases in ma_add64(Register, Register, Imm64). r=jandem\n\nPer LoongLint for RISC-V, this further eliminates 91 (out of 206)\nno-ops on Octane.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324642\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "9493753816b902259bc4fac4e80d1cd55c318c72", "git_parents": ["b58508c62abb0948ae11ff5dc3db403270ffc59f"], "node": "1f3f049aaade1b94331ca687c36448211a423ac9", "parents": ["a5ba46738f1ab22ce3a9e7efe3a04644499eb6f9"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070557 - [riscv64] Part 5: Optimize zero immediate cases in ma_or(Register, Register, Imm64). r=jandem\n\nPer LoongLint for RISC-V, this further eliminates 106 (out of 206)\nno-ops on Octane.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324643\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "0c14642b2adaebe102946189aa13c68d124c80af", "git_parents": ["9493753816b902259bc4fac4e80d1cd55c318c72"], "node": "769a3b9b835f93e05b206a8fe32c3457c4556e05", "parents": ["1f3f049aaade1b94331ca687c36448211a423ac9"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2070557 - [riscv64] Part 6: Optimize zero immediate cases in ma_sub64(Register, Register, Imm64). r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324839\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "aa9130393f2ea5040684f4ac7048308f1a317d3b", "git_parents": ["0c14642b2adaebe102946189aa13c68d124c80af"], "node": "702064d2d252465ab4f57b9bdaa30e2ac3fa9997", "parents": ["769a3b9b835f93e05b206a8fe32c3457c4556e05"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2061795 - Reflect the document CSP for imported modules. r=allstarschh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324517\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_module_csp.js", "dom/base/test/file_js_cache_module_csp.sjs", "dom/script/ScriptLoader.cpp"], "git_node": "75438996a6d8c5ee1141b01fb49854b48bf4e007", "git_parents": ["aa9130393f2ea5040684f4ac7048308f1a317d3b"], "node": "a81326127f03aca8c03d769cc16a24e8bada61ee", "parents": ["702064d2d252465ab4f57b9bdaa30e2ac3fa9997"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070130 - Check final URI in CSS loader mime type quirk. r=dshin\n\nThis fixes the Firefox failures in web-platform-tests/wpt#62516.\n\nImplement it behind a pref just-in case. Also, unfortunately we need to\ndo the same-origin check up-front, because the mime type check can\nhappen off the main thread.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/364\n", "files": ["layout/style/Loader.cpp", "layout/style/SheetLoadData.h", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/links/stylesheet/quirk-origin-check-recursive-import.html.ini", "testing/web-platform/meta/html/links/stylesheet/quirk-origin-check.html.ini", "testing/web-platform/meta/html/semantics/document-metadata/the-link-element/link-style-data-url-quirks.html.ini"], "git_node": "6d5a2bbbcc028f32cbf580983918cae3ebd92115", "git_parents": ["75438996a6d8c5ee1141b01fb49854b48bf4e007"], "node": "8cfee9ad61c82d875694804f5676eff19ff97462", "parents": ["a81326127f03aca8c03d769cc16a24e8bada61ee"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069053 - Keep a custom-date BHR aggregation off the cron's index routes and roll-up state r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nA run triggered through the bhr-aggregate action inherits the index\nroutes of the push it was triggered from, which include\ngecko.v2.mozilla-central.latest.firefox.bhr-aggregate and that day's\npushdate route. The first is the build the dashboard shows by default\nand the artifact the next cron run reads its timeseries state from; the\nsecond is how the dashboard resolves a build date. Backfilling a past\nday would therefore displace the real run for the day it was triggered\non. Strip the index routes and, when a date was given, publish under\ngecko.v2.mozilla-central.bhr-aggregate.build.\u003cYYYYMMDD\u003e instead.\n\nThe roll-up is worse: build_timeseries ends the 365-day window at the\nbuild date and deletes every state day outside it, so aggregating\n20260802 today would drop three weeks of days from the state the cron\npublishes, with no way to refill them -- those days' artifacts are not\nlocal to the run. Custom-date runs now always set BHR_SKIP_TIMESERIES,\nleaving the roll-up to a deliberate separate step.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323653\n", "files": ["taskcluster/gecko_taskgraph/actions/bhr_aggregate.py", "taskcluster/gecko_taskgraph/test/test_actions.py"], "git_node": "1b2833b1afa91b93d09c5e916c75ef8427f1a4a5", "git_parents": ["6d5a2bbbcc028f32cbf580983918cae3ebd92115"], "node": "b43d4e100116c8fdd46b63ee90f0da9584ee4e6b", "parents": ["8cfee9ad61c82d875694804f5676eff19ff97462"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069053 - Let the BHR roll-up recompute a day that was backfilled or re-run r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nThe timeseries state keeps whatever a day's first run produced:\nbuild_timeseries fills a window day only when it is absent from state.\nThat is right for the daily cron, where each day is seen once, but it\nmeans re-running a day never reaches the roll-up -- the artifact is\nreplaced and the chart keeps the old numbers.\n\nAdd refill_dates, naming days to recompute from their artifacts, and\n--timeseries-refill-dates on the task script to go with it. Those days'\nartifacts are not local to the run, so the script fetches each from the\nindex first, preferring the build-date route a backfill publishes under\nand falling back to the cron's pushdate routes. A day it cannot fetch is\nskipped with a note rather than failing the run, leaving its state as it\nwas.\n\nExposed on the action as refill_dates. That run keeps the cron's index\nroutes and its timeseries step, since recomputing shared state is only\nmeaningful from a run that publishes it, and is refused alongside a\npinned date: a run for a past build date must not publish a roll-up\nending at that date.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323654\n", "files": ["taskcluster/gecko_taskgraph/actions/bhr_aggregate.py", "taskcluster/gecko_taskgraph/test/test_actions.py", "taskcluster/scripts/bhr-aggregate.py", "toolkit/components/backgroundhangmonitor/aggregation/bhr_timeseries.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_timeseries.py"], "git_node": "6ccdbb9f4f07fde9adb50cbb18e36a9d779950a0", "git_parents": ["1b2833b1afa91b93d09c5e916c75ef8427f1a4a5"], "node": "9a79f131b5adaa18ed364c0692e7247f853860cc", "parents": ["b43d4e100116c8fdd46b63ee90f0da9584ee4e6b"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068848 - Use backgroundTint to color Material dialogs r=android-reviewers,twhite\n\nSelecting text inside a dialog drew a large opaque rectangle over the dialog and was hiding its content. The rectangle only appears when the text selection toolbar doesn't have enough space to display all actions, and draws an overflow menu at the end of the toolbar.\n\n`BaseDialogStyle` sets `android:background` property, which is a View attribute. So every view created with the dialog's theme that does not set its own background inherits this background property. This has two visible effects:\n\n- It paints the views inside the dialog and actually gives the dialog its expected color. It does not paint the dialog window background though, it looks like it does, because colored views are drawn on top of that background\n- It paints the popup content view of the text selection toolbar. `LocalFloatingToolbarPopup` builds the popup content view as a LinearLayout and expects it to stay transparent. This view is drawn on top of the dialog and its size depends on how the toolbar overflows. It's the unexpected rectangle\n\nIt looks like the issue started with Bug 1974873 which changed `android:colorBackground` to `android:background` in both `BaseDialogStyle` and `BaseDialogStyle.Private`. With that change, every view in the dialog that doesn't have its own background color inherits this `android:background` value.\n\nThis patch moves the background color logic to a separate `alertDialogStyle`, which sets `backgroundTint`. Material 3 dialogs read this property and apply the color to the dialog window background only. No view inherits it, so this fixes the rectangle issue while preserving the dialog color.\n\n- Light and dark modes rely on `BaseDialogStyle`, which is based on `ThemeOverlay.Material3.MaterialAlertDialog`. This theme sets a style (`alertDialogStyle`) whose `backgroundTint` defaults to `colorSurfaceContainerHigh`, so it is not needed to override the background tint in that case\n- Private navigation mode (`BaseDialogStyle.Private`) must set `layer2` as the background color, which differs from the default color so an override (`MaterialAlertDialog.App.Private`) is needed\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324623\n", "files": ["mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "e8d78b28ba67076c6b39592628eaad5f74459933", "git_parents": ["6ccdbb9f4f07fde9adb50cbb18e36a9d779950a0"], "node": "09792d341a4abbb634f429bccc1fe0f89ecdf785", "parents": ["9a79f131b5adaa18ed364c0692e7247f853860cc"], "tags": []}, {"author": "Jason Birchall \u003cjason.birchall@pm.me\u003e", "branch": "default", "desc": "Bug 2007944 - Make browser_ext_browserAction_theme_icons.js independent of the system color scheme. r=rpl\n\nThe dynamic theme task assumed a light system theme and failed on systems\nusing a dark theme. Pin ui.systemUsesDarkTheme with pushPrefEnv and run the\ntask once per system color scheme, per the suggestion in bug 2007944 comment 3.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324900\n", "files": ["browser/components/extensions/test/browser/browser_ext_browserAction_theme_icons.js"], "git_node": "e30ddc7a777d82f97053668be05c99baaf670df3", "git_parents": ["e8d78b28ba67076c6b39592628eaad5f74459933"], "node": "b8bc4777b62b0b027a8f6f30bbb77801970911f7", "parents": ["09792d341a4abbb634f429bccc1fe0f89ecdf785"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2070913 - Remove unnecessary setForModulePreload call in ModuleLoaded. r=arai\n\nThe code in https://searchfox.org/firefox-main/rev/8db09b47689dcfc25671b178619b03ad214c6369/js/loader/ModuleLoadRequest.cpp#117\nalready does the work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324958\n", "files": ["js/loader/ModuleLoadRequest.cpp"], "git_node": "7129617484d93e7fda299dc44590bb3d5e21c7fe", "git_parents": ["e30ddc7a777d82f97053668be05c99baaf670df3"], "node": "7342839c0699ece7d49edf3d59fd351be10122e7", "parents": ["b8bc4777b62b0b027a8f6f30bbb77801970911f7"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070362 - Add section variantId and sourceSectionId telemetry to newtab content impression & click events. r=jbrown,mlplyler,thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324442\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/DSCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamImpressionStats/ImpressionStats.jsx", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/lib/NewTabContentPing.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/unit/content-src/components/DiscoveryStreamComponents/DSCard.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/DiscoveryStreamComponents/ImpressionStats.test.jsx", "browser/extensions/newtab/test/unit/lib/DiscoveryStreamFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "30dc86a18f24e4436396b709ced35376b604b470", "git_parents": ["7129617484d93e7fda299dc44590bb3d5e21c7fe"], "node": "9b5e795757202c3c5afbdddccc440b01d29b732c", "parents": ["7342839c0699ece7d49edf3d59fd351be10122e7"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064985 - Update webrtcdtls.KEA to FF 164 r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324907\n", "files": ["dom/media/webrtc/metrics.yaml"], "git_node": "c206f87af0aed06a378fa2316670b4c9af70387c", "git_parents": ["30dc86a18f24e4436396b709ced35376b604b470"], "node": "a8992859f0c21d8669d6e5d5b6d9721308c71f7c", "parents": ["9b5e795757202c3c5afbdddccc440b01d29b732c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2033213 - Actually make the fuzzy annotation cover our Windows fuzz. r=layout-reviewers,dshin\n\nOn the previous commit, I swapped the pixel count vs max diff. We get\nvery few pixels but with a bit more fuzz than WebKit.\n\nI guess I could also just remove some of the font dependencies here,\nthey seem unfortunate and not the point of the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324910\n", "files": ["testing/web-platform/tests/fullscreen/rendering/exit-fullscreen-scroll-to-unscrollable-area-overflow-x-hidden.html"], "git_node": "279049d4d24358fd42cab1fb98de3cd3d62dca2a", "git_parents": ["c206f87af0aed06a378fa2316670b4c9af70387c"], "node": "42ef48c108deb4f36c0d2fa60a654be1b9d64b67", "parents": ["a8992859f0c21d8669d6e5d5b6d9721308c71f7c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2015089 - Remove dead scroll event tracking code. r=layout-reviewers,dshin\n\nWe disabled this a while ago, so it can go.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324912\n", "files": ["layout/generic/ScrollAnchorContainer.cpp", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a3a4ed561d0b424ceae005d2676dcd1eb54da5de", "git_parents": ["279049d4d24358fd42cab1fb98de3cd3d62dca2a"], "node": "8ebb5140e89433f2e2c0d3de008a04388e6b2ee1", "parents": ["42ef48c108deb4f36c0d2fa60a654be1b9d64b67"], "tags": []}, {"author": "Caleb P \u003ccaleb.pickard@gmail.com\u003e", "branch": "default", "desc": "Bug 2070951 - Fix typo in phrase \"The count URI loads...\" in telemetry yaml files. r=scunnane DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324989\n", "files": ["browser/components/search/metrics.yaml", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "9180865e15ef91200ab520e70c33fdca06d2f477", "git_parents": ["a3a4ed561d0b424ceae005d2676dcd1eb54da5de"], "node": "cda07006bb1877fa6692ec08981e0e05f073d947", "parents": ["8ebb5140e89433f2e2c0d3de008a04388e6b2ee1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070876 - Open the prefilled bug form instead of printing its URL in the bug-filing skills. r=ai4dev-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324980\n", "files": [".agents/skills/bug-filing/SKILL.md", ".agents/skills/bug-filing/file-bug.py", ".agents/skills/file-good-first-bug/SKILL.md", ".agents/skills/file-good-first-bug/scripts/build_url.py", ".claude/skills/bug-filing/SKILL.md", ".claude/skills/bug-filing/file-bug.py", ".claude/skills/file-good-first-bug/SKILL.md", ".claude/skills/file-good-first-bug/scripts/build_url.py"], "git_node": "fe8a160b953231ea69acf3fd7f19f477539c3b3f", "git_parents": ["9180865e15ef91200ab520e70c33fdca06d2f477"], "node": "d9a51e409e5139cfc16637c4953e1e4e90eed613", "parents": ["cda07006bb1877fa6692ec08981e0e05f073d947"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 661957 - Use PodCopy for same-type POD copyConstruct in Vector. r=sergesanspaille\n\nVectorImpl's POD specialization copies appended ranges with a per-element\nloop, on the grounds that append is usually given small ranges. It is also\nhow JSStringBuilder copies string segments: a samply profile of a\n60000-char str.replaceAll spends 57.9% of the call in copyConstruct at\nroughly 1.4 GB/s, against about 20 GB/s for the equivalent rope flatten.\n\nUse PodCopy when T and U are the same type, which is the patch proposed in\ncomment 2 of this bug in 2012. PodCopy already carries the size and platform\nheuristic measured in bug 933149 and bug 1967062, so ranges under 128\nelements on Linux keep the loop they have today.\n\nNo caller can pass overlapping ranges to PodCopy's new assertion: every\nmoveConstruct site targets a fresh allocation or the opposite of inline and\nheap storage, and an append whose source lies in the vector's own live range\nends at or before the destination, since the source must end by mLength and\nthe destination starts there.\n\nSuppress a GCC 10 -Werror=stringop-overflow= false positive in PodCopy's\nmemcpy call. When Vector\u003cchar,32\u003e::convertToHeapStorage inlines through\ncopyConstruct, GCC's value range propagation cannot prove mLength is bounded\nby the 64-byte heap allocation, and _FORTIFY_SOURCE's __builtin___memcpy_chk\nreports a spurious overflow. A diagnostic pragma on the memcpy call site is\nthe narrowest fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323825\n", "files": ["mfbt/PodOperations.h", "mfbt/Vector.h"], "git_node": "1d3eebcd6c22d0bc4a271dcfbc7890f87a7fd7fb", "git_parents": ["fe8a160b953231ea69acf3fd7f19f477539c3b3f"], "node": "a1eb90ff4ba821e5f39338afbc4587704ecd26a6", "parents": ["d9a51e409e5139cfc16637c4953e1e4e90eed613"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069371 - Increase app menu width to fit sign in promo r=desktop-theme-reviewers,kcochrane,webcompat-reviewers,twisniewski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323607\n", "files": ["browser/components/reportbrokensite/test/browser/head.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "3197ed19a666d1a5acfb465baeff63991189d468", "git_parents": ["1d3eebcd6c22d0bc4a271dcfbc7890f87a7fd7fb"], "node": "73112e93308f47dac6ffbc8f8600e26f1e84be57", "parents": ["a1eb90ff4ba821e5f39338afbc4587704ecd26a6"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066341 - Keep the origin in view when autofill selects a long value in the URL bar - r=mak,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322211\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-autofill/browser.toml", "browser/components/urlbar/tests/browser-autofill/browser_originInView.js"], "git_node": "77bab9c025fb6060cd064d9a6a04a2493d7f0e20", "git_parents": ["3197ed19a666d1a5acfb465baeff63991189d468"], "node": "38518f9c746ff872c3393090fb45667a5239e2d3", "parents": ["73112e93308f47dac6ffbc8f8600e26f1e84be57"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2068336 - Add Promise::MaybeSafeResolve and use it for Streams r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324569\n", "files": ["dom/promise/Promise.cpp", "dom/promise/Promise.h", "dom/streams/ReadableByteStreamController.cpp", "dom/streams/ReadableStream.cpp", "dom/streams/ReadableStreamBYOBReader.cpp", "dom/streams/ReadableStreamDefaultController.cpp", "dom/streams/ReadableStreamDefaultReader.cpp", "dom/streams/ReadableStreamTee.cpp", "dom/streams/TransformStream.cpp", "dom/streams/WritableStreamDefaultController.cpp", "js/public/Promise.h", "js/src/builtin/Promise.cpp", "js/src/builtin/Promise.h", "js/src/jsapi.cpp", "testing/web-platform/meta/streams/readable-byte-streams/patched-global.any.js.ini"], "git_node": "4b049ce79f7ab81e968f44c8e22729a3f6f6ce6d", "git_parents": ["77bab9c025fb6060cd064d9a6a04a2493d7f0e20"], "node": "bc979025d674ec41d4aa9bc2df92d02041668088", "parents": ["38518f9c746ff872c3393090fb45667a5239e2d3"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067076: Add z-index and cursor pointer to jump to bottom button in chat r=czhou\n\nIssue: the jump to bottom chat button stops working after we send a second message.\n\nSolution: it was behind the blur and needed a z-index to come to the top layer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324437\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_jump_to_bottom.js"], "git_node": "73e23aa0ccec71a5290db1a0b0200538df166884", "git_parents": ["4b049ce79f7ab81e968f44c8e22729a3f6f6ce6d"], "node": "a9b4987029316dcdabb1b132bda118ac01a50a34", "parents": ["bc979025d674ec41d4aa9bc2df92d02041668088"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040812 - show passkeys in autocomplete=\"webauthn\" autofill dropdown. r=credential-management-reviewers,mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301432\n", "files": ["dom/html/HTMLInputElement.cpp", "toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_basic_form.html", "toolkit/components/passwordmgr/test/unit/test_isInferredUsernameField.js"], "git_node": "f3c0eac8f691a0eafcf7568cc0d04ce070927c41", "git_parents": ["73e23aa0ccec71a5290db1a0b0200538df166884"], "node": "a5d086e4373ade1d84201f577889dc2ddbbd7be0", "parents": ["a9b4987029316dcdabb1b132bda118ac01a50a34"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068046 - Ensure avatar background color is set when picking default theme with Nova enabled r=mkennedy,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323055\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_test.js"], "git_node": "fd00da617653f6ee8067abea33e2912c31dd25bd", "git_parents": ["f3c0eac8f691a0eafcf7568cc0d04ce070927c41"], "node": "955eec9aa027ba656d1c7df2403cc44283b8d271", "parents": ["a5d086e4373ade1d84201f577889dc2ddbbd7be0"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068917 - revert to old theme color selection for non-Nova themes r=rpl,desktop-theme-reviewers,mkennedy,tgiles,mossop\n\nWe switched how we're selecting theme foreground and background colors to make the profile avatars look the best for Nova specific themes. It turns out this causes contrast issues with some legacy/user generated themes, so this patch adds a check to determine which color selection logic we should follow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324415\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs"], "git_node": "d5867b788ec02dd5dab0a8d9354d6e4e93aa5454", "git_parents": ["fd00da617653f6ee8067abea33e2912c31dd25bd"], "node": "ce118fc329deeb55e474c8f7c2a83ecf3bdbada5", "parents": ["955eec9aa027ba656d1c7df2403cc44283b8d271"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031836 - Rename separate private default search engine preferences and don't turn on the split by default. r=Standard8,firefox-desktop-core-reviewers ,urlbar-reviewers,akulyk,hsohaney,chutten\n\nbrowser.search.separatePrivateDefault is renamed to\nbrowser.search.separatePrivateDefault.enabled, and its default is\nintentionally changed from true to false as part of this rename. This\ndoes not change behaviour: the feature remains gated behind\nbrowser.search.separatePrivateDefault.featureGate (renamed from\n.ui.enabled), which defaults to false, so .enabled is only consulted\nonce the feature gate is turned on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321634\n", "files": ["browser/actors/AboutPrivateBrowsingParent.sys.mjs", "browser/app/profile/firefox.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/about/browser_aboutNetError_searchCTA_pbm.js", "browser/base/content/test/contextMenu/browser_contextmenu.js", "browser/components/BrowserGlue.sys.mjs", "browser/components/ProfileDataUpgrader.sys.mjs", "browser/components/backup/tests/xpcshell/test_PreferencesBackupResource_searchEngines.js", "browser/components/preferences/config/search.mjs", "browser/components/preferences/search.js", "browser/components/preferences/tests/search/browser_searchDefaultEngine.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_search_banner.js", "browser/components/search/SearchOneOffs.sys.mjs", "browser/components/search/test/browser/browser_contentContextMenu.js", "browser/components/search/test/browser/browser_contentContextMenu_visualSearch.js", "browser/components/search/test/browser/browser_contentSearch.js", "browser/components/search/test/browser/browser_contextmenu.js", "browser/components/search/test/browser/browser_defaultPrivate_nimbus.js", "browser/components/search/test/browser/browser_oneOffContextMenu_setDefault.js", "browser/components/search/test/browser/browser_searchRestrictToken_privateWindow.js", "browser/components/search/test/browser/browser_searchbar_default.js", "browser/components/tests/unit/test_profileDataUpgrade_separatePrivateDefault.js", "browser/components/tests/unit/xpcshell.toml", "browser/components/urlbar/UrlbarSearchUtils.sys.mjs", "browser/components/urlbar/tests/browser-search/browser_action_searchengine.js", "browser/components/urlbar/tests/browser-search/browser_oneOffs.js", "browser/components/urlbar/tests/browser-search/browser_oneOffs_keyModifiers.js", "browser/components/urlbar/tests/browser-search/browser_placeholder.js", "browser/components/urlbar/tests/browser-search/browser_separatePrivateDefault.js", "browser/components/urlbar/tests/browser-search/browser_separatePrivateDefault_differentEngine.js", "browser/components/urlbar/tests/browser-searchMode/browser_indicator.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser-searchMode/browser_suggestions.js", "browser/components/urlbar/tests/browser/browser_tokenAlias.js", "browser/components/urlbar/tests/browser/searchbar/browser_search.js", "browser/components/urlbar/tests/unit/head.js", "browser/components/urlbar/tests/unit/test_providerHeuristicFallback.js", "browser/components/urlbar/tests/unit/test_providerTabToSearch_partialHost.js", "browser/components/urlbar/tests/unit/test_searchEngineStore.js", "browser/components/urlbar/tests/unit/test_search_suggestions.js", "browser/components/urlbar/tests/unit/test_search_suggestions_aliases.js", "browser/components/urlbar/tests/unit/test_search_suggestions_tail.js", "docshell/test/browser/browser_uriFixupIntegration.js", "docshell/test/unit/test_URIFixup_info.js", "docshell/test/unit/test_URIFixup_search.js", "modules/libpref/init/all.js", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/search/SearchService.sys.mjs", "toolkit/components/search/docs/Preferences.md", "toolkit/components/search/metrics.yaml", "toolkit/components/search/tests/xpcshell/searchconfigs/xpcshell.toml", "toolkit/components/search/tests/xpcshell/test_config_loading_uses_env.js", "toolkit/components/search/tests/xpcshell/test_defaultEngine.js", "toolkit/components/search/tests/xpcshell/test_defaultEngine_experiments.js", "toolkit/components/search/tests/xpcshell/test_defaultEngine_fallback.js", "toolkit/components/search/tests/xpcshell/test_defaultPrivateEngine.js", "toolkit/components/search/tests/xpcshell/test_initialization_with_region.js", "toolkit/components/search/tests/xpcshell/test_notifications.js", "toolkit/components/search/tests/xpcshell/test_policyEngine.js", "toolkit/components/search/tests/xpcshell/test_reload_engines.js", "toolkit/components/search/tests/xpcshell/test_sort_orders-no-hints.js", "toolkit/components/search/tests/xpcshell/test_sort_orders.js", "toolkit/components/search/tests/xpcshell/test_telemetry_default.js", "toolkit/components/search/tests/xpcshell/test_telemetry_default_changed_startup.js", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment_search.js"], "git_node": "c3965fa0d5955a5d847975e4fa2f3fb3a41be230", "git_parents": ["d5867b788ec02dd5dab0a8d9354d6e4e93aa5454"], "node": "903c4b53ff3cb9f36751084f7d5bf8496551ed16", "parents": ["ce118fc329deeb55e474c8f7c2a83ecf3bdbada5"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070497 - Enable sanitize while parsing in nightly builds r=hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324897\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "47f12fb37f2d3b562cacbee876cb0c6425fba6aa", "git_parents": ["c3965fa0d5955a5d847975e4fa2f3fb3a41be230"], "node": "fc42210025fa130f48c9c8593fcaeb7139ab19ca", "parents": ["903c4b53ff3cb9f36751084f7d5bf8496551ed16"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069895 - Retrim and normalize the speech recognition test clip, and add its transcript. r=media-playback-reviewers,alwu\n\nIt opened on a roll call of proper nouns at -36dB mean, which the recognizer\nmostly dropped. It now starts at \"I am delighted to be here\", and is\ntranscribed word for word.\n\ntest_parakeet_e2e.html fetched transcript.txt from the model server root,\nwhich resolves to the repository root rather than here, so it never found it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324035\n", "files": ["dom/media/webspeech/recognition/test/kennedy-appolo.opus", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_parakeet_e2e.html", "dom/media/webspeech/recognition/test/transcript.txt"], "git_node": "7e0348e8a60e3971338cc70691059c1edc51a6bc", "git_parents": ["47f12fb37f2d3b562cacbee876cb0c6425fba6aa"], "node": "293b833cd1d8f2755b79b92904d4430d63272aff", "parents": ["fc42210025fa130f48c9c8593fcaeb7139ab19ca"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069895 - Expose the recognition engine's perf counters to chrome. r=media-playback-reviewers,webidl,saschanaz,alwu\n\nSpeechRecognition.getPerfStats(), ChromeOnly, for perf tests: start() to the\nengine being ready, to the first result, stop() to the end event, and the\naudio fed to the model against the wall clock spent inside it.\n\nThe data is sent back on session end, which is enough for our purpose here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324036\n", "files": ["dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "dom/webidl/SpeechRecognition.webidl"], "git_node": "bf23a5852478614c3ffa897c6d0ef54db08f2ac0", "git_parents": ["7e0348e8a60e3971338cc70691059c1edc51a6bc"], "node": "7fe38c947c1efcef2df889c7162846bfcfe07429", "parents": ["293b833cd1d8f2755b79b92904d4430d63272aff"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069895 - Run the parakeet streaming loop in its own runnable. r=media-playback-reviewers,alwu\n\nIt was called directly from InitializeParakeetContext() and runs until the\nsession ends, so a profile showed a multi-second \"Initialize parakeet\ncontext\" covering everything.\n\nThe thread isn't busy, this is just cosmetics, we don't expect more latency\nbecause of this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324037\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionParent.cpp"], "git_node": "6a26c644be5cb127c880a7957ed747ee825d83ab", "git_parents": ["bf23a5852478614c3ffa897c6d0ef54db08f2ac0"], "node": "8135df2080a1d729f17c755d5ed37bca7a16ff53", "parents": ["7fe38c947c1efcef2df889c7162846bfcfe07429"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069895 - Add profiler markers for the parakeet engine. r=media-playback-reviewers,alwu\n\nWe had very little markers, of little value, this is better.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324038\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionParent.cpp"], "git_node": "781f2f3b6a2ffc55766c5547ad5b196624fc6fb5", "git_parents": ["6a26c644be5cb127c880a7957ed747ee825d83ab"], "node": "24c2b4b033826531f279b9afc5e12bf815a48533", "parents": ["8135df2080a1d729f17c755d5ed37bca7a16ff53"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069895 - Add a perf test for on-device speech recognition. r=media-playback-reviewers,perftest-reviewers,mozperftest-reviewers,alwu,sparky\n\nReports engine-ready, time to first word, end-of-stream flush latency,\nreal-time factor, and HWInference RSS, with the first session separated out as\nit pays for the process starting up. Boot time is very small, cold vs. hot isn't\nvery large, but we want to know if we regress.\n\nAudio is fed in real time over a MediaStreamTrack, so the real-time factor\ncomes from the engine's counters, not a wall clock the feed rate caps at 1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324039\n", "files": ["dom/media/webspeech/recognition/moz.build", "dom/media/webspeech/recognition/test/browser_speech_recognition_perf.js", "dom/media/webspeech/recognition/test/perftest.toml", "python/mozperftest/mozperftest/tests/test_utils.py", "python/mozperftest/mozperftest/utils.py", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "29ff5d099ba14325d4e3e78e50254e2d9e5a8688", "git_parents": ["781f2f3b6a2ffc55766c5547ad5b196624fc6fb5"], "node": "324903f5ee4b6c1e630aa0424d032ab4d03776fd", "parents": ["24c2b4b033826531f279b9afc5e12bf815a48533"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069895 - Report the speech recognition model's memory in about:memory. r=media-playback-reviewers,ai-platform-reviewers,alwu,valentinp\n\nThe HWInference process' footprint was more or less entirely unaccounted for.\n\nThe size comes from the loader, through a new parakeet_capi_weights_bytes(),\nand is kept in one process-wide number: only one session runs at a time. We'll\nneed to do something similar for llama.cpp, but it's clearer labeled as such, tying\nthe memory usage to the feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324040\n", "files": ["config/external/mozinference/mozinference.symbols", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_parakeet_memory_reporter.html", "third_party/parakeet.cpp/include/parakeet_capi.h", "third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-weights-bytes.patch", "third_party/parakeet.cpp/src/model.hpp", "third_party/parakeet.cpp/src/model_loader.cpp", "third_party/parakeet.cpp/src/model_loader.hpp", "third_party/parakeet.cpp/src/parakeet_capi.cpp", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h"], "git_node": "6c31aafac73663169d636096210108264a1f3f1c", "git_parents": ["29ff5d099ba14325d4e3e78e50254e2d9e5a8688"], "node": "adf331efdd542d956c1675eb7eea01929ad8b148", "parents": ["324903f5ee4b6c1e630aa0424d032ab4d03776fd"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069895 - Release the speech recognition model's host weights once uploaded. r=media-playback-reviewers,alwu\n\nWhen Metal is used, the tensors are uploaded to the device in use. We don't\nNeed to keep the host copy.\n\nThis does wonder to RSS (roughly divides by two).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324041\n", "files": ["third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-free-host-weights.patch", "third_party/parakeet.cpp/src/model_loader.cpp"], "git_node": "5ee025414f1406d324cac66e6d7503f6d626db07", "git_parents": ["6c31aafac73663169d636096210108264a1f3f1c"], "node": "40f2d13446d8c0db6f8415e6c5aaeb1f825c0e22", "parents": ["adf331efdd542d956c1675eb7eea01929ad8b148"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2069895: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionParent.cpp"], "git_node": "7893faf5f7ddcc4bdb1ae34065982f92fd6e8426", "git_parents": ["5ee025414f1406d324cac66e6d7503f6d626db07"], "node": "c3c43ad523264e3725034a29a48636c4daa1e409", "parents": ["40f2d13446d8c0db6f8415e6c5aaeb1f825c0e22"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2047745 - [wdspec] Cleanup wpt meta data for macOS. r=webdriver-reviewers,Sasha\n\nD