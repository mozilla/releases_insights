st/sanitize/browser_sanitize-timespans.js", "browser/base/content/test/sanitize/browser_sanitize-timespans_v2.js", "browser/base/content/test/sanitize/browser_sanitizeDialog_v2.js", "browser/base/content/test/sanitize/browser_sanitizeDialog_v2_dataSizes.js", "browser/base/content/test/sanitize/browser_sanitizeOnShutdown_migration.js", "browser/base/content/test/sanitize/dummy.js", "browser/base/content/test/sanitize/dummy_page.html", "browser/base/content/test/sanitize/head.js", "browser/base/content/test/sanitize/site_data_test.html", "browser/base/content/test/scroll-to-text-fragment/browser.toml", "browser/base/content/test/scroll-to-text-fragment/browser_scroll-to-text-fragment-from-browser-chrome.js", "browser/base/content/test/scroll-to-text-fragment/browser_scroll-to-text-fragment-from-context-menu.js", "browser/base/content/test/scroll-to-text-fragment/browser_scroll-to-text-fragment-from-window-open.js", "browser/base/content/test/scroll-to-text-fragment/dummy_page.html", "browser/base/content/test/scroll-to-text-fragment/scroll-to-text-fragment-from-browser-chrome-target.html", "browser/base/content/test/startup/browser.toml", "browser/base/content/test/startup/browser_preXULSkeletonUIRegistry.js", "browser/base/content/test/tabcrashed/browser.toml", "browser/base/content/test/tabcrashed/browser_aboutRestartRequired.toml", "browser/base/content/test/tabcrashed/browser_aboutRestartRequired_basic.js", "browser/base/content/test/tabcrashed/browser_aboutRestartRequired_buildid_false-positive.js", "browser/base/content/test/tabcrashed/browser_aboutRestartRequired_buildid_true.js", "browser/base/content/test/tabcrashed/browser_aboutRestartRequired_noForkServer.toml", "browser/base/content/test/tabcrashed/browser_autoSubmitRequest.js", "browser/base/content/test/tabcrashed/browser_launchFail.js", "browser/base/content/test/tabcrashed/browser_multipleCrashedTabs.js", "browser/base/content/test/tabcrashed/browser_noPermanentKey.js", "browser/base/content/test/tabcrashed/browser_printpreview_crash.js", "browser/base/content/test/tabcrashed/browser_showForm.js", "browser/base/content/test/tabcrashed/browser_shown.js", "browser/base/content/test/tabcrashed/browser_shownRestartRequired.js", "browser/base/content/test/tabcrashed/browser_withoutDump.js", "browser/base/content/test/tabcrashed/file_contains_emptyiframe.html", "browser/base/content/test/tabcrashed/file_iframe.html", "browser/base/content/test/tabcrashed/head.js", "browser/base/content/test/tabdialogs/browser.toml", "browser/base/content/test/tabdialogs/browser_multiple_dialog_navigation.js", "browser/base/content/test/tabdialogs/browser_subdialog_esc.js", "browser/base/content/test/tabdialogs/browser_tabdialogbox_content_prompts.js", "browser/base/content/test/tabdialogs/browser_tabdialogbox_focus.js", "browser/base/content/test/tabdialogs/browser_tabdialogbox_navigation.js", "browser/base/content/test/tabdialogs/loadDelayedReply.sjs", "browser/base/content/test/tabdialogs/subdialog.xhtml", "browser/base/content/test/tabdialogs/test_page.html", "browser/base/content/test/touch/browser.toml", "browser/base/content/test/touch/browser_menu_touch.js", "browser/base/content/test/utilityOverlay/browser.toml", "browser/base/content/test/utilityOverlay/browser_openWebLinkIn.js", "browser/base/content/test/zoom/browser.toml", "browser/base/content/test/zoom/browser_background_link_zoom_reset.js", "browser/base/content/test/zoom/browser_background_zoom.js", "browser/base/content/test/zoom/browser_default_zoom.js", "browser/base/content/test/zoom/browser_default_zoom_fission.js", "browser/base/content/test/zoom/browser_default_zoom_multitab.js", "browser/base/content/test/zoom/browser_default_zoom_sitespecific.js", "browser/base/content/test/zoom/browser_image_zoom_tabswitch.js", "browser/base/content/test/zoom/browser_keyboard_mousewheel_zoom_consistency.js", "browser/base/content/test/zoom/browser_mousewheel_zoom.js", "browser/base/content/test/zoom/browser_sitespecific_background_pref.js", "browser/base/content/test/zoom/browser_sitespecific_image_zoom.js", "browser/base/content/test/zoom/browser_sitespecific_video_zoom.js", "browser/base/content/test/zoom/browser_subframe_textzoom.js", "browser/base/content/test/zoom/browser_tabswitch_zoom_flicker.js", "browser/base/content/test/zoom/browser_tooltip_zoom.js", "browser/base/content/test/zoom/browser_zoom_commands.js", "browser/base/content/test/zoom/head.js", "browser/base/content/test/zoom/zoom_test.html", "browser/base/moz.build", "eslint-rollouts.config.mjs", "eslint-test-paths.config.mjs", "tools/@types/generated/tspaths.json"], "git_node": "a0364d50fd40e47a4b8fa635efa2383f36bc3f13", "git_parents": ["23f8b955a3a77c25765aa4a2b9735cc7893178cc"], "node": "421060ea48f5e00b771c490cfff799f9d0f9a7b4", "parents": ["0f22c594f1f020517d85be4022c8b65acec6e93b"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063292 - Report certificate duplication in about:networking tokens r=fluent-reviewers,bolsson,leggert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318474\n", "files": ["toolkit/content/aboutNetworking.js", "toolkit/locales/en-US/toolkit/about/aboutNetworking.ftl"], "git_node": "23fc182891051e607aeeb19e01b09a16edb388af", "git_parents": ["a0364d50fd40e47a4b8fa635efa2383f36bc3f13"], "node": "07e92637f80342dcea5be3599b4b20e3f53263f2", "parents": ["421060ea48f5e00b771c490cfff799f9d0f9a7b4"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062203 - Null-check node before deref in nsNavHistoryFolderResultNode::OnItemMoved (Coverity CID 1644887) r=places-reviewers,Standard8\n\nThe same-folder branch dereferenced `node` for `mBookmarkIndex` and passed it\nto ReindexRange before reaching the null check that already guarded the rest of\nthe branch. `node` comes from FindChildById and is only known to be non-null\nwhen it was returned, so move the existing assertion and check above the first\ndereference rather than leaving them in the middle of the branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317484\n", "files": ["toolkit/components/places/nsNavHistoryResult.cpp"], "git_node": "aed6a14648e78d4db5f41799ecb362cb3d2b664c", "git_parents": ["23fc182891051e607aeeb19e01b09a16edb388af"], "node": "61041457c693634d56a8459984c63f336dcc8b14", "parents": ["07e92637f80342dcea5be3599b4b20e3f53263f2"], "tags": []}, {"author": "Eemeli Aro \u003ceemeli@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067107 - Check string allocation in ModuleLoader::CreateTextModule. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325000\n", "files": ["dom/script/ModuleLoader.cpp"], "git_node": "8398fd4d3294a98be2dcac24d467be0eafaa46af", "git_parents": ["aed6a14648e78d4db5f41799ecb362cb3d2b664c"], "node": "0a1d79f8baf1d0426176fe7806d9bc6eb05df24d", "parents": ["61041457c693634d56a8459984c63f336dcc8b14"], "tags": []}, {"author": "Eemeli Aro \u003ceemeli@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067108 - Check string allocation in WorkerModuleLoader::CreateTextModule. r=edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325001\n", "files": ["dom/workers/loader/WorkerModuleLoader.cpp"], "git_node": "c81b3051a4c9216819996baccd7c6451c6c995a4", "git_parents": ["8398fd4d3294a98be2dcac24d467be0eafaa46af"], "node": "75442c671a14a838cb04dc70bfda6f75c6dfa4e2", "parents": ["0a1d79f8baf1d0426176fe7806d9bc6eb05df24d"], "tags": []}, {"author": "Eemeli Aro \u003ceemeli@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067109 - Check string allocation in WorkletModuleLoader::CreateTextModule. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325002\n", "files": ["dom/worklet/loader/WorkletModuleLoader.cpp"], "git_node": "62803d7584e0e20e95795cf95b1f34dc9d49e5e3", "git_parents": ["c81b3051a4c9216819996baccd7c6451c6c995a4"], "node": "398d21e1be75f83396034e9ef67ad4aef076f720", "parents": ["75442c671a14a838cb04dc70bfda6f75c6dfa4e2"], "tags": []}, {"author": "Eemeli Aro \u003ceemeli@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067110 - Check string allocation in mozJSModuleLoader::CreateTextModuleFromSource. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325003\n", "files": ["js/xpconnect/loader/mozJSModuleLoader.cpp"], "git_node": "0482e9a63eac05af2ad2b5e921c61046c0cbf7ca", "git_parents": ["62803d7584e0e20e95795cf95b1f34dc9d49e5e3"], "node": "2b063e4b696b1aa74e0b35663dd62175c5e5ba9d", "parents": ["398d21e1be75f83396034e9ef67ad4aef076f720"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 1883400 - Add new component for listing hardware info in perfdocs. r=perftest-reviewers,mozperftest-reviewers,aglavic\n\nThis patch adds a new class that will be used to gather, and build the documentation for hardware information across all performance tests. The existing content here is based on the platforms wiki found here: https://wiki.mozilla.org/Performance/Platforms\n\nA new YAML file is added in the main perfdocs directory to track all the hardware along with their mapping to worker pools. The platform labels are gathered dynamically and added to these new docs so they don't need to be included in the YAML either. The new class is a singleton to make it simpler to use in multiple different places.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323367\n", "files": ["python/mozperftest/mozperftest/perfdocs/hardware.py", "python/mozperftest/mozperftest/perfdocs/hardware.yml", "python/mozperftest/mozperftest/tests/test_perfdocs_hardware.py"], "git_node": "03ea427c40ceabf7acf67c3a7c67f45dad3461b3", "git_parents": ["0482e9a63eac05af2ad2b5e921c61046c0cbf7ca"], "node": "e2eed5a897f9002e2a7bf64714aa9fdaaa217e6d", "parents": ["2b063e4b696b1aa74e0b35663dd62175c5e5ba9d"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 1883400 - Integrate hardware info into perfdocs checks and generation. r=perftest-reviewers,mozperftest-reviewers,aglavic\n\nThis patch integrates the new hardware doc generation into perfdocs. It adds the ability to list all of our hardware info in the performance-infrstructure docs, and also provides links from the test documentation to it.\n\nWith this change, any new tasks with undocumented tools will trigger failures in perfdocs. Those pools will need to either be listed under an existing hardware type, or will need a new hardware section added for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323368\n", "files": ["python/mozperftest/mozperftest/perfdocs/framework_gatherers.py", "python/mozperftest/mozperftest/perfdocs/generator.py", "python/mozperftest/mozperftest/perfdocs/verifier.py", "python/mozperftest/mozperftest/tests/test_perfdocs_framework_gatherers.py", "testing/perfdocs/generated/awsy.md", "testing/perfdocs/generated/performance-infrastructure.md", "testing/perfdocs/generated/raptor.md", "testing/perfdocs/generated/talos.md", "testing/performance/performance-infrastructure/perfdocs/config.yml", "testing/performance/performance-infrastructure/perfdocs/index.md"], "git_node": "df4afcdd3f5c1d39586e46a776ca668072907488", "git_parents": ["03ea427c40ceabf7acf67c3a7c67f45dad3461b3"], "node": "50afd360f0a60f22feb1e7a9fd8815c9dd6407d0", "parents": ["e2eed5a897f9002e2a7bf64714aa9fdaaa217e6d"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070734 - Document the contextmenu_visual SAP in the search telemetry docs. r=search-reviewers,Standard8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324790\n", "files": ["browser/components/search/docs/telemetry.md"], "git_node": "fe3550cd24b33bb8b0d45a84e7a380f3e4c70453", "git_parents": ["df4afcdd3f5c1d39586e46a776ca668072907488"], "node": "0ebdfc4a419708a7a88692b3e2b6597592009c86", "parents": ["50afd360f0a60f22feb1e7a9fd8815c9dd6407d0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071075 - Build the macOS Android repack toolchains on Linux workers. r=jcristau\n\nThe macOS Android toolchains (JDK, SDK, arm64 AVD and arm64 system images) only download and repack upstream\narchives, so they don't need a macOS worker. The JDK is downloaded for macOS/arm64 via new --os-name/--os-arch\noverrides for android.py --jdk-only. sdkmanager selects packages by matching the host OS and CPU architecture,\nso downloading the macOS/arm64 packages from this Linux/x86_64 host needs both REPO_OS_OVERRIDE=macosx and\n-Dos.arch=aarch64. The AVD prewarm was already a no-op because arm64.json sets emulator_prewarm to false, and\nsystem images are host-independent, so neither of those two repacks needs either override.\n\nThey were also in the TL Treeherder group despite targeting macOS arm64; move them to TMA64 to match the other\ncross-built toolchains.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325154\n", "files": ["python/mozboot/mozboot/android.py", "taskcluster/kinds/toolchain/android-macos.yml", "taskcluster/scripts/misc/repack-android-avd-macos.sh", "taskcluster/scripts/misc/repack-android-sdk-macos.sh", "taskcluster/scripts/misc/repack-android-system-images-macos.sh", "taskcluster/scripts/misc/repack-jdk-macos.sh"], "git_node": "714d1f97e1347414d7c3985bdee1ada3b1ee558f", "git_parents": ["fe3550cd24b33bb8b0d45a84e7a380f3e4c70453"], "node": "152812359a6121f7e402fd29be8b5261c330b975", "parents": ["0ebdfc4a419708a7a88692b3e2b6597592009c86"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071075 - Build the win32 and aarch64 WindowsAppSDK repack toolchains on Linux workers. r=jcristau\n\nThe win32 and aarch64 WindowsAppSDK repacks only unzip and re-tar an MSIX, exactly like the x86_64 one that\nalready runs on Linux; drop their Windows worker override.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325155\n", "files": ["taskcluster/kinds/toolchain/misc.yml"], "git_node": "684471d51ca8564965af5b6aa38979f8d3c73bd5", "git_parents": ["714d1f97e1347414d7c3985bdee1ada3b1ee558f"], "node": "860c2b00a8d8c5f916f74fd7f7db09edb96a345a", "parents": ["152812359a6121f7e402fd29be8b5261c330b975"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071075 - Build the macOS openssl and xz cpython dependencies on Linux workers. r=jcristau\n\nmacosx64-xz, macosx64-aarch64-xz and macosx64-aarch64-openssl never execute what they compile and already\nfetch macosx64-sdk-toolchain, so they only need linux64-clang-toolchain instead of the Mach-O macosx64-clang,\nplus --target/--host.\n\nlibtool picks its linker with its own PATH search rather than honoring -fuse-ld, so xz also gets LD=ld64.lld,\nand -Wno-unused-command-line-argument keeps its -Werror configure probe from rejecting -fuse-ld. Both scripts\npin AR/RANLIB to llvm-ar/llvm-ranlib so the static archives get a symbol index.\n\npack.sh is now located via $GECKO_PATH: $(dirname $0) breaks on the Linux worker, which invokes scripts with a\npath relative to the initial directory, once build-xz.sh has cd'd elsewhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325156\n", "files": ["taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/build-openssl.sh", "taskcluster/scripts/misc/build-xz.sh"], "git_node": "0f715ac1015137ba33a44f3ee3a11b46325c9d9e", "git_parents": ["684471d51ca8564965af5b6aa38979f8d3c73bd5"], "node": "ab58afd70ff1383bb6e0de4d43a8d5eb84624e30", "parents": ["860c2b00a8d8c5f916f74fd7f7db09edb96a345a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071075 - Build the macOS onnxruntime toolchains on Linux workers. r=jcristau\n\nThe aarch64 task was already a cross build on the Intel b-osx-1015 workers, so neither build executes what it\ncompiles. build.py's --osx_arch only acts on a macOS host, so the Darwin cmake variables are passed directly,\nthe way build-llvm-common.sh does for compiler-rt, with linux64-clang-toolchain replacing the Mach-O\nmacosx64-clang and the mac cmake/ninja fetches. Deployment targets are set explicitly to Firefox's (10.15\nx86_64, 11.0 arm64).\n\n-fuse-ld=lld goes in the compile flags because cmake's try_compile checks, including the one behind\n--enable_lto, don't inherit CMAKE_*_LINKER_FLAGS and would silently disable LTO. CMAKE_ASM_COMPILER_TARGET is\nneeded or the .S files are assembled for the host.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325157\n", "files": ["taskcluster/kinds/toolchain/onnx.yml", "taskcluster/scripts/misc/build-onnxruntime.sh"], "git_node": "1dfefda0692b4b53a104f92160c60649e9e84eba", "git_parents": ["0f715ac1015137ba33a44f3ee3a11b46325c9d9e"], "node": "66d80a08e0fee9e17fd8c408c6059391cf3328ce", "parents": ["ab58afd70ff1383bb6e0de4d43a8d5eb84624e30"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071064 - Call ClearForm when unlinking form controls. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325435\n", "files": ["dom/html/HTMLImageElement.cpp", "dom/html/nsGenericHTMLElement.cpp"], "git_node": "09c4a957c1857a468bd629b018c0be91ff651771", "git_parents": ["1dfefda0692b4b53a104f92160c60649e9e84eba"], "node": "0a7d4e797e0d373cb8fd1ce4bf7b2b9fb51c445b", "parents": ["66d80a08e0fee9e17fd8c408c6059391cf3328ce"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071368 - Format DiscoveryStreamFeed.test.js with Prettier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325449\n", "files": ["browser/extensions/newtab/test/jest/lib/DiscoveryStreamFeed.test.js"], "git_node": "1ef27a4b11ea7e85bdc01a2d556846917e6e7115", "git_parents": ["09c4a957c1857a468bd629b018c0be91ff651771"], "node": "7cabb7801fa8fa1905837f9ac240cda850225eff", "parents": ["0a7d4e797e0d373cb8fd1ce4bf7b2b9fb51c445b"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071004 - Update wpt metadata for /html/canvas/element/manual/imagebitmap/createImageBitmap-resolves-in-task.any.html\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/imagebitmap/createImageBitmap-resolves-in-task.any.js.ini"], "git_node": "2cc9db3b01a811342c27356e70f966634d1f8e78", "git_parents": ["1ef27a4b11ea7e85bdc01a2d556846917e6e7115"], "node": "3761c2a14abee79ba74ab3d037618b92ffab0b81", "parents": ["7cabb7801fa8fa1905837f9ac240cda850225eff"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062329 - Attribute MLModelHubService downloads to the requesting task. r=ai-platform-reviewers,valentinp\" for causing bc failures @ browser_speech_recognition_telemetry.js\n\nThis reverts commit 62a4a5d638f3fd31af6fe9e06a8b49676d98c1b9.\n\nRevert \"Bug 2062329 - Measure inference cost and init failures in the HWInference process. r=media-playback-reviewers,alwu\"\n\nThis reverts commit 7783c6fb9ede108cb441318523ec67230fb499f1.\n\nRevert \"Bug 2062329 - Measure speech recognition latency in the content process. r=media-playback-reviewers,alwu\"\n\nThis reverts commit 189550601ac9731dd888abdb513584a543755cc9.\n\nRevert \"Bug 2062329 - Record speech recognition usage, outcomes and errors with Glean. r=media-playback-reviewers,alwu,TravisLong\"\n\nThis reverts commit 39db08efe30cc8bcaac479f1c73975d78d3c39e7.\n\nRevert \"Bug 2062329 - Add use counters for the SpeechRecognition API. r=dom-core-reviewers,webidl,smaug\"\n\nThis reverts comm