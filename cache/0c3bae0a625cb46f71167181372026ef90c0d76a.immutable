droid/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabReorderAccessibilityActions.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabstray/TabsTray.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractableGridTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractableListTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/legacy/ReorderableGridTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/legacy/ReorderableListTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayoutTest.kt"], "git_node": "de5e447b42f4c1cfe4585c17580985e71795bff8", "git_parents": ["a2dcdc247f79e92756a72f76fb4443d9eb285d6f"], "node": "54711e98ad50525b8f8f674498c68ba3a08b5bd9", "parents": ["8a1fb6d896374b124a729bf00ecb36f621ade711"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072760:  Extract group entrance animation logic into a Decorator pattern r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327028\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/browser/compose/ItemInteractionState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/browser/compose/interactable/InteractableGrid.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/browser/compose/interactable/InteractableList.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/TabItemAnimations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractableDragItemContainerTest.kt", "mobile/android/fenix/docs/Tabs-Tray-Item-Animations.md"], "git_node": "9b7a3c90982db53429ac807b396537dbb890f64f", "git_parents": ["de5e447b42f4c1cfe4585c17580985e71795bff8"], "node": "6eabc5d28eb92dd69edbc335de951a94e221b9cb", "parents": ["54711e98ad50525b8f8f674498c68ba3a08b5bd9"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1766397 - Align drop shadow sources to the blur downscaling grid. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328309\n", "files": ["gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/wrench/reftests/filters/filter-drop-shadow-clip-3.png", "gfx/wr/wrench/reftests/filters/filter-drop-shadow-clip.png", "gfx/wr/wrench/reftests/filters/filter-drop-shadow-on-viewport-edge.png"], "git_node": "2443cf3b5b3967b0b811918b057b6bf689f8e0ab", "git_parents": ["9b7a3c90982db53429ac807b396537dbb890f64f"], "node": "ca883c76c9b7e70b0a4c68776bf2835143406c80", "parents": ["6eabc5d28eb92dd69edbc335de951a94e221b9cb"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1980357 - Only treat drop shadows as a no-op when they are fully transparent. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328307\n", "files": ["gfx/wr/webrender/src/internal_types.rs", "gfx/wr/wrench/reftests/filters/filter-drop-shadow-zero-offset-ref.yaml", "gfx/wr/wrench/reftests/filters/filter-drop-shadow-zero-offset.yaml", "gfx/wr/wrench/reftests/filters/reftest.list"], "git_node": "eed5fac536ef290eb00f8dedca3160d4a16e721c", "git_parents": ["2443cf3b5b3967b0b811918b057b6bf689f8e0ab"], "node": "9d789098751ab2ae6e79c524bf320f766db8f55a", "parents": ["ca883c76c9b7e70b0a4c68776bf2835143406c80"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061790 - Indicate whether a CVV is saved in read-only payment methods lists. r=dimi,fluent-reviewers,bolsson\n\nBoth read-only lists of saved payment methods now note when a card has a\nsecurity code stored alongside it. The code itself is never displayed.\n\nThe redesigned settings pane (browser.settings-redesign.enabled, the default)\nbuilds its rows in makePaymentsListItems() from payment-moz-box-item, so it\ngets sibling strings that append the indication to the description. A separate\nindicator-only string covers a card with no expiry date, which would otherwise\nrender a stray leading separator.\n\nThe manageCreditCards.xhtml dialog, still reachable with the redesign pref off,\nformats its rows through CreditCard.getLabelInfo(). Rather than doubling the\nfour combinatorial credit-card-label-* strings, a wrapping string takes the\nformatted label and its aria-label as arguments. The visible label separates\nthem with a vertical bar to match the design, while the aria-label uses a comma\nso it reads as one sentence and still names the card network.\n\nBoth paths require a non-empty cc-csc. cc-csc is not yet in\nVALID_CREDIT_CARD_FIELDS, so it round trips as an unknown field, and\n_normalizeRecord() skips those before it drops empty values -- a cleared\nsecurity code stays on the record as an empty string.\n\nBoth call sites read FormAutofill.isAutofillCreditCardCVVEnabled, which since\nbug 2061792 means creditCards.cvv.supported and creditCards.cvv.enabled\ntogether, so a security code is only ever indicated to a user who is in the\nrollout and has left capture on. The tests roll the feature out for themselves\nand cover a user who is not in the rollout yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322817\n", "files": ["browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/locales/en-US/browser/preferences/preferences.ftl", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/locales/en-US/toolkit/payments/payments.ftl"], "git_node": "04b376b34b09fb291dbfa65ff8b524ad07e3102e", "git_parents": ["eed5fac536ef290eb00f8dedca3160d4a16e721c"], "node": "334f970412482748127bcb300e5d66874890d16f", "parents": ["9d789098751ab2ae6e79c524bf320f766db8f55a"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055767: Mark content not associated with an accessibility node as an artifact so it is ignored by accessibility consumers. r=accessibility-platform-reviewers,layout-reviewers,emilio,eeejay\n\nWe already disassociate page headers and footers from any accessibility node so that they aren't included in the struct tree.\nHowever, the text still exists for an accessibility consumer.\nFor example, it gets rendered at the bottom of the page with pdf.js.\nWe now mark these as artifacts so that they are correctly ignored by accessibility consumers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328414\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/pdf/PdfStructTreeBuilder.h", "accessible/tests/browser/pdfOutput/browser.toml", "accessible/tests/browser/pdfOutput/browser_artifacts.js", "gfx/2d/2D.h", "layout/generic/nsPageFrame.cpp"], "git_node": "7d6a46b954ff578380e02c8a54eac2e26d5ca553", "git_parents": ["04b376b34b09fb291dbfa65ff8b524ad07e3102e"], "node": "5c5a5ccec41580ae6991e0ac93d0c095baa3ae86", "parents": ["334f970412482748127bcb300e5d66874890d16f"], "tags": []}], "date": 1790240056, "git_changesets": ["cccc40f0d4290aecfe31a8b41abdbb63a3850101", "cd088b1c825fd7c33fb698d7102b9a14b8878f3b", "bf15f4456fa29a041a98ee98549c88d9c101dc5f", "eb00355d1c79078e0b3fa26a24e11ceabf0cf060", "e6ce8ee35bd719e28ee9e33b4c405046bfa8b385", "d2f775ee788af1c0163cb296cc04a4