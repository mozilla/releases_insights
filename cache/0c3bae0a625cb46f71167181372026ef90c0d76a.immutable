web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-006.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-007.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-008.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-009.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-010.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-011.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-012.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-013.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-014.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-015.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-016.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-017.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-021.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-022.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-023.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-024.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-025.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-026.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-027.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-028.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/dynamic-grid-track-direction.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-flex-sizing-rows-min-max-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-fr-rows-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-check-grid-height-on-resize.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini"], "git_node": "49ae0e590a022d33fd1bebb8e4226c2483425ae2", "git_parents": ["14c85482d3d9e4330e9c5678a41abd498b2ffd68"], "node": "2e8c0bd6f4d15a390a2f65376a4be07b29fcc105", "parents": ["3da57f3e8e24e1078662ac80ab4c9b88517ef81d"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047195 - Skip the initial about:blank load when restoring a single tab from about:sessionrestore. r=sthompson,jswinarton\" for causing bc failures @ browser_2047195_restore_single_tab.js\n\nThis reverts commit 91cd09eeb92a4d6acf79ce50ae1e0bece5e35642.\n", "files": ["browser/components/sessionstore/content/aboutSessionRestore.js", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_2047195_restore_single_tab.js"], "git_node": "bab77bbf75c2f001404755a15aab4fcf040fb5ea", "git_parents": ["49ae0e590a022d33fd1bebb8e4226c2483425ae2"], "node": "bd0046a245a3aafbc61fc563e2b0d72a84deeaa7", "parents": ["2e8c0bd6f4d15a390a2f65376a4be07b29fcc105"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070687 - Implement dismissible Sign in promo in the app menu r=desktop-theme-reviewers,fluent-reviewers,emilio,bolsson\" for causing bc failures @ browser_sync.js\n\nThis reverts commit 9750a49bda047f77e3edd5df5c5c08c1a3f422a8.\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "30afdd48e11827ee37d662cac141a217c3efab9b", "git_parents": ["bab77bbf75c2f001404755a15aab4fcf040fb5ea"], "node": "2eec7f4d2016145b153e3f493138c31f8ad1c20d", "parents": ["bd0046a245a3aafbc61fc563e2b0d72a84deeaa7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2033633 - Skip density correction for fallback intrinsic height. r=dholbert\" for causing wpt failures @ naturalWidth-naturalHeight-width-height.html\n\nThis reverts commit c27fe2149791cca4f90abbd0c4fe2b0af0c73aa2.\n", "files": ["dom/base/nsImageLoadingContent.cpp", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/naturalWidth-naturalHeight-width-height.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/svg-img-density-vs-zoom.html.ini"], "git_node": "f75d1fa5f30d9687f51d8493a7fd60311957063d", "git_parents": ["30afdd48e11827ee37d662cac141a217c3efab9b"], "node": "941c3452e8ab59d893c1b7b7b0aa743068107118", "parents": ["2eec7f4d2016145b153e3f493138c31f8ad1c20d"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044192 - Remove image.natural-size-fallback.enabled. r=dholbert\" for causing wpt failures @ naturalWidth-naturalHeight-width-height.html\n\nThis reverts commit 897c709f2d9a6c970a49b48bb16c71a4f8c93263.\n", "files": ["dom/base/nsImageLoadingContent.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/__dir__.ini"], "git_node": "e1ff9de076c4d73d48d07e7825257ac0daca7034", "git_parents": ["f75d1fa5f30d9687f51d8493a7fd60311957063d"], "node": "412e14f227a557fe3f154ca881020f1558ef5ccf", "parents": ["941c3452e8ab59d893c1b7b7b0aa743068107118"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2072664 - edit sources button not available if there are no tabs to choose from r=reusable-components-reviewers,mkennedy,vazish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327206\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_autocomplete.js"], "git_node": "aceda55418d32cf74271dc41a1bccec9d98d0583", "git_parents": ["e1ff9de076c4d73d48d07e7825257ac0daca7034"], "node": "f004961b46cfb1681b2f217196f8d3ef3b2430b2", "parents": ["412e14f227a557fe3f154ca881020f1558ef5ccf"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2072664 - Clean up SmartFormFillParent controller guards r=vazish,gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327541\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs"], "git_node": "306d2d5a909f8de220a1e33ac68827ce3389254b", "git_parents": ["aceda55418d32cf74271dc41a1bccec9d98d0583"], "node": "112a52d745999a4a089e616237d0012a29953926", "parents": ["f004961b46cfb1681b2f217196f8d3ef3b2430b2"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072403 - Local storage: recompute usage from the actual values when the cache value (usage) is found to be wrong/corrupted. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326335\n", "files": ["dom/localstorage/ActorsParent.cpp", "dom/localstorage/test/unit/test_usageNegativeFile.js", "dom/localstorage/test/unit/xpcshell.toml"], "git_node": "3d508df4ba6d45f0b1645a58712fab43ee2fa694", "git_parents": ["306d2d5a909f8de220a1e33ac68827ce3389254b"], "node": "4bb778f39abec15122483af81653251181b3b4b3", "parents": ["112a52d745999a4a089e616237d0012a29953926"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2072692 - [Monitor Agent] [FE] Notificaiton when error happens r=fluent-reviewers,tetchart,echa,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326691\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorAttention.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/xpcshell/test_MonitorAttention.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "8a3c712e4f61c5977d9175525da1a31bd59a5a31", "git_parents": ["3d508df4ba6d45f0b1645a58712fab43ee2fa694"], "node": "04c12a7e3f7863e2ec2bb40f6034a66454c2263f", "parents": ["4bb778f39abec15122483af81653251181b3b4b3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2064559 - Make waitForPreloaded's guard and its wait the same transition, r=mconley.\n\nwaitForPreloaded's guard could observe a browser as still loading after the\nload event it then waited for had already been dispatched, and the wait never\nresolved: the load event rides STATE_STOP|STATE_IS_DOCUMENT, while\nBrowsingContextWebProgress clears isLoadingDocument on the later\nSTATE_STOP|STATE_IS_WINDOW.\n\nBrowserTestUtils.browserStopped waits on that later notification, so the guard\nand the wait cover the same transition. checkAborts, because an aborted stop\nclears the flag too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327082\n", "files": ["browser/extensions/newtab/test/browser/head.js"], "git_node": "a7b574325b08e377a653cc716bad1b356f0b1788", "git_parents": ["8a3c712e4f61c5977d9175525da1a31bd59a5a31"], "node": "7d5a3c186ebe2dadc754580a901027fee566dba6", "parents": ["04c12a7e3f7863e2ec2bb40f6034a66454c2263f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2031557 - Wait for the configured top site, and for it to be unpinned, before opening its menu, r=mconley.\n\nWhich menu a tile renders depends on the tile: a site the feed has not resolved\nto one of the configured defaults carries Delete from History as a seventh\noption, and a pinned site offers Unpin rather than Pin. These three tests\nopened whichever tile was first and then asserted an exact option count or\nclicked a fixed item, without waiting for the top sites their `before` hook\nconfigured. Pinning writes browser.newtabpage.pinned, a real pref that no pref\nenvironment pops, so a site an earlier test pinned is still pinned here.\n\nThe tests now unpin everything before configuring their top sites, wait for the\ntile of the site they mean by URL, and name the menu item they want.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327100\n", "files": ["browser/extensions/newtab/test/browser/browser_topsites_contextMenu_options.js", "browser/extensions/newtab/test/browser/browser_topsites_section.js", "browser/extensions/newtab/test/browser/head.js"], "git_node": "9505aaf028f07a4a6a87600c3739a9f52615d8c8", "git_parents": ["a7b574325b08e377a653cc716bad1b356f0b1788"], "node": "7e93f773260d2e5428ba5f92e508f39998752953", "parents": ["7d5a3c186ebe2dadc754580a901027fee566dba6"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2025752 - Address the top site and the menu item by name in browser_topsites_section.js's edit and add tests, r=mconley.\n\nEvery tile renders its panel-list and all of its items up front, so\n`.top-sites panel-list panel-item` enumerates every tile's menu in DOM order\nand an index runs off the end of the first tile's list into the next tile's.\nBoth tests now wait for the tile of the site setTestTopSites configures and\ntake the menu item by its Fluent id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327110\n", "files": ["browser/extensions/newtab/test/browser/browser_topsites_section.js", "browser/extensions/newtab/test/browser/head.js"], "git_node": "9ce6182275575db1b3f4b25afe0ee6a54804e067", "git_parents": ["9505aaf028f07a4a6a87600c3739a9f52615d8c8"], "node": "4c44ff58e6c4c006bae7763ecd1dfd0daccceefa", "parents": ["7e93f773260d2e5428ba5f92e508f39998752953"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072915 - Clear the pinned top sites before every newtab browser test file, r=mconley.\n\nPinning writes browser.newtabpage.pinned through NewTabUtils.pinnedLinks, not\nthrough a test's pref environment, so popPrefEnv does not restore it and every\nfile in the folder inherits the row the previous one left behind. Calling the\nexisting clearPinnedTopSites() helper from head.js makes that inheritance stop\nat the file boundary, instead of each test having to opt out of it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327138\n", "files": ["browser/extensions/newtab/test/browser/head.js"], "git_node": "9a38683f835bd7f703deb39bb5700f59986dba57", "git_parents": ["9ce6182275575db1b3f4b25afe0ee6a54804e067"], "node": "80f6614536cccecb50f295f409459740659e55ac", "parents": ["4c44ff58e6c4c006bae7763ecd1dfd0daccceefa"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2031557 - Broadcast the top sites update when a refresh supersedes a broadcasting one, r=mconley.\n\nTopSitesFeed.refresh lets only the newest refresh dispatch, so a refresh\nstarted while a broadcasting one is in flight drops the superseded dispatch and\nevery open about:newtab keeps the top sites it had before the change that asked\nto broadcast. That is how dismissing a top site leaves the dismissed tile on\nscreen: PlacesFeed's placesChangedTimer fires a few milliseconds after\nnewtab-linkBlocked, and its non-broadcasting refresh wins.\n\nRegressed by bug 2026185, which added the generation guard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327111\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "6542bfdc700c8fa57846f6199eb82813f6df0c8e", "git_parents": ["9a38683f835bd7f703deb39bb5700f59986dba57"], "node": "d516f117729a9de3bdf6d70e184af99eddf9c4aa", "parents": ["80f6614536cccecb50f295f409459740659e55ac"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2031557 - Wait for the default top sites row to finish rendering before counting it in browser_topsites_contextMenu_options.js, r=mconley.\n\ndefaultTopSites_dismiss waited for the first `.top-site-outer` and then read\n`querySelectorAll(siteSelector).length`, so a row that had rendered one tile of\nfive was counted as one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327098\n", "files": ["browser/extensions/newtab/test/browser/browser_topsites_contextMenu_options.js"], "git_node": "0e0c0ea76ec125dcfd205d4f7d3b317f1fbe7e71", "git_parents": ["6542bfdc700c8fa57846f6199eb82813f6df0c8e"], "node": "53d576ce0c25ebc0e4a388d57e7eb17995281922", "parents": ["d516f117729a9de3bdf6d70e184af99eddf9c4aa"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2073461 - The First time option from the top of the Time dropdown panel cannot be selected inside the Create a task modal in the sidebar r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327512\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js"], "git_node": "f9e2d49b6a385753136369a67872582055bfcfff", "git_parents": ["0e0c0ea76ec125dcfd205d4f7d3b317f1fbe7e71"], "node": "9edc0c87b0473b4d7cf23a7f4a401728ea920928", "parents": ["53d576ce0c25ebc0e4a388d57e7eb17995281922"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Make Rust library Cargo profiles and crate types explicit in `moz.build` r=firefox-build-system-reviewers,sergesanspaille\n\nThe megazord is currently the only Rust library that declares either value, so\nthe generated command lines and artifact paths do not change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320787\n", "files": ["build/templates.mozbuild", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/rust-library-cargo-profile/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-library-cargo-profile/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/rust-library-invalid-cargo-crate-type/Cargo.toml", "python/mozbuild/mozbuild/test/frontend/data/rust-library-invalid-cargo-crate-type/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/util.py", "third_party/application-services/megazords/full/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py"], "git_node": "890322783ced531412b38a8d0a6d1953f54a1499", "git_parents": ["f9e2d49b6a385753136369a67872582055bfcfff"], "node": "1b50f8914db6c7d8949f4224aaf9e46609923d0a", "parents": ["9edc0c87b0473b4d7cf23a7f4a401728ea920928"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Move the Cargo build argument computation from `rust.mk` to `moz.configure` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322825\n", "files": ["build/moz.configure/rust.configure", "config/makefiles/rust.mk"], "git_node": "93b46fb3da37ac143e23111662fba3425c705bdb", "git_parents": ["890322783ced531412b38a8d0a6d1953f54a1499"], "node": "0e5d1078c9cee25003cf9b6041554a22df22f004", "parents": ["1b50f8914db6c7d8949f4224aaf9e46609923d0a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Move the Rust compiler flag computation from `rust.mk` to `moz.configure` r=firefox-build-system-reviewers,sergesanspaille\n\nThe llvm-dlltool detection moves to `toolchain.configure` because the target\nflags depend on it and `rust.configure` is processed before\n`toolkit/moz.configure`.\n\nTwo behaviors change on the legacy path. `-C dlltool=` is only added when\nllvm-dlltool was found, where an empty path was passed before. The NEON target\nfeature flags now reach target builds for NEON targets other than thumbv7neon,\nwhere the Make filter matched no real triple and never added them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322826\n", "files": ["build/moz.configure/rust.configure", "build/moz.configure/toolchain.configure", "config/makefiles/rust.mk", "js/moz.configure", "toolkit/moz.configure"], "git_node": "cc9f7f581f6030814a8157512cd69208993ac866", "git_parents": ["93b46fb3da37ac143e23111662fba3425c705bdb"], "node": "2c01b6c0de921976791e0c92767f576e41dd8eec", "parents": ["0e5d1078c9cee25003cf9b6041554a22df22f004"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Move the cc-rs compiler environment computation from `rust.mk` to `moz.configure` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322827\n", "files": ["build/moz.configure/rust.configure", "config/makefiles/rust.mk"], "git_node": "910650ed2d5af951a38d95f1cab7f355a338351b", "git_parents": ["cc9f7f581f6030814a8157512cd69208993ac866"], "node": "f63936b6f76c9f153dbce0c64590c3128f419a17", "parents": ["2c01b6c0de921976791e0c92767f576e41dd8eec"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Move the Cargo linker and build script environment computation from `rust.mk` to `moz.configure` r=firefox-build-system-reviewers,sergesanspaille\n\n`MOZ_LTO_OBJECT_PATH` replaces the LTO and Darwin conditions around the\n`-object_path_lto` linker flag so the same decision is available to the Rust\nlinker flags.\n\nAn iOS build put `build/macosx` first in `PATH` inside the Rust recipes so\nCargo found the `xcrun` shim. That prepend now happens in the `PATH` subst, so\nevery recipe sees it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322828\n", "files": ["build/moz.configure/lto-pgo.configure", "build/moz.configure/rust.configure", "build/moz.configure/toolchain.configure", "config/config.mk", "config/makefiles/rust.mk"], "git_node": "d061aa5e737200b099343ccfd1e66d702488abd0", "git_parents": ["910650ed2d5af951a38d95f1cab7f355a338351b"], "node": "f8f90d1e78dd47ac42c00d6930faa9aa9f99cbcf", "parents": ["f63936b6f76c9f153dbce0c64590c3128f419a17"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Declare the gkrust-gtest link time optimization opt out in `moz.build` r=firefox-build-system-reviewers,sergesanspaille\n\nWhether a Rust library is built with `-Clto` was decided by matching\n`gkrust_gtest` against the library file name in the recipe. The library\ndeclares it, the backend writes the one `RUST_LIBRARY_LTO` decision, and the\nrecipe reads it for both the flag and the networking check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323088\n", "files": ["build/templates.mozbuild", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/rust-library-no-lto/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-library-no-lto/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/rust-library-no-lto/Cargo.toml", "python/mozbuild/mozbuild/test/frontend/data/rust-library-no-lto/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "toolkit/library/gtest/rust/moz.build"], "git_node": "37c89271920690d11aa79605a19cae0a3c55027a", "git_parents": ["d061aa5e737200b099343ccfd1e66d702488abd0"], "node": "cdcc8652edf877cba405bbd0fe0ca7ac112ae07b", "parents": ["f8f90d1e78dd47ac42c00d6930faa9aa9f99cbcf"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Make the `dmgInstallHelper` link depend on its plist inputs r=firefox-build-system-reviewers,sergesanspaille\n\nThe build system does not parse `LDFLAGS`, so neither plist was a declared\nprerequisite of the link. Tier ordering happened to produce the generated one\nin time, and edits to `Launchd.plist` never forced a relink.\n\nThe generated plist is consumed only by the link. `Info.plist.in` does not\nreference `MOZ_MACBUNDLE_ID`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321371\n", "files": ["toolkit/mozapps/dmgInstallHelper/Makefile.in", "toolkit/mozapps/dmgInstallHelper/moz.build"], "git_node": "8a7f0426bb340e666ec4dfd527b6f276fe0a3790", "git_parents": ["37c89271920690d11aa79605a19cae0a3c55027a"], "node": "51c7f3feb3034f2af2bb4788c2243127add97845", "parents": ["cdcc8652edf877cba405bbd0fe0ca7ac112ae07b"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068895: Skip the startup profile dialogs when macOS launched Firefox to handle a web authentication request. r=mossop,mac-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327560\n", "files": ["toolkit/xre/ASWebAuthSessionHandler.h", "toolkit/xre/ASWebAuthSessionHandler.mm", "toolkit/xre/nsAppRunner.cpp"], "git_node": "11994fee6a9f1ed3d2c3dbab4d139accd0088396", "git_parents": ["8a7f0426bb340e666ec4dfd527b6f276fe0a3790"], "node": "fa86de7a15623fc9f0032fc39e555845e291f26b", "parents": ["51c7f3feb3034f2af2bb4788c2243127add97845"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070687 - Implement dismissible Sign in promo in the app menu r=desktop-theme-reviewers,fluent-reviewers,emilio,bolsson\n\nIn the app menu only:\n- adds a dismiss button and updates the sign in button to be a link\n- once dismissed, the user should never see the promo again\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326689\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "5ca0134605ca22287833e1c92f7b8dfe5c515fa0", "git_parents": ["11994fee6a9f1ed3d2c3dbab4d139accd0088396"], "node": "492f0d472bd5a8eea821e03c5e99fafa90ceab57", "parents": ["fa86de7a15623fc9f0032fc39e555845e291f26b"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2037801 - [geckodriver] Update tests for unzipping zip archives. r=geckodriver-reviewers,jgraham\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300043\n", "files": ["testing/geckodriver/src/browser.rs", "testing/geckodriver/src/capabilities.rs", "testing/geckodriver/src/test.rs", "testing/geckodriver/src/tests/profile.zip"], "git_node": "72099406ea07c5448750f435a3884b5cf95a8ed4", "git_parents": ["5ca0134605ca22287833e1c92f7b8dfe5c515fa0"], "node": "96b6350ba5236106d23d747645b7dc2f278b964d", "parents": ["492f0d472bd5a8eea821e03c5e99fafa90ceab57"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "7a422a8139ba08ce0912b540ca06d9754ba22ad6", "git_parents": ["72099406ea07c5448750f435a3884b5cf95a8ed4", "a4d4f7ecfae304e10b0f6724595f9c931d7c919b"], "node": "2123c426ae7ffbe1a6a59fa35b8b8cfc489c5817", "parents": ["96b6350ba5236106d23d747645b7dc2f278b964d", "f1cfb0e0b987d324d7513011ecad2f40f89bb9b2"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2074089 - Only call update_clip_task for text runs. r=gw\n\nThe main change in this patch is that YUV image primitives and backdrop captures were going through update_clip_task and now they don't. Also simplify the surrounding logic a bit. use_legacy_path is now only used to set should_update_clip_task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327813\n", "files": ["gfx/wr/webrender/src/prepare.rs"], "git_node": "687af813aff099c209233a289c4699aa38511094", "git_parents": ["7a422a8139ba08ce0912b540ca06d9754ba22ad6"], "node": "022973f2fcc2907ab41da11e89de0d1ef357e5ef", "parents": ["2123c426ae7ffbe1a6a59fa35b8b8cfc489c5817"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2074162: Add fuzzy annotation for content-visibility-with-top-layer-in-auto-subtree-removal.html to account for observed failures on Windows. r=intermittent-reviewers,aryx\n\nThe fuzzy pixels appear to be subpixel antialiasing artifacts alongside the\nedge of a 'y' glyph, and they're not visually perceptible, nor are they\nimportant to what the test is testing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327871\n", "files": ["testing/web-platform/meta/css/css-contain/content-visibility/content-visibility-with-top-layer-in-auto-subtree-removal.html.ini"], "git_node": "77346b6ba678fa9800e95325d2b87c06084e63f8", "git_parents": ["687af813aff099c209233a289c4699aa38511094"], "node": "3b3d54a129f508f684a28195990c5b1e539b293b", "parents": ["022973f2fcc2907ab41da11e89de0d1ef357e5ef"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067701 - Package the notification helper with the Firefox installer r=iholmes,cdupuis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322361\n", "files": ["browser/installer/package-manifest.in", "browser/moz.configure", "build/moz.configure/update-programs.configure", "toolkit/moz.build"], "git_node": "0cbacd989030244c44357fc20445e6b467765fa3", "git_parents": ["77346b6ba678fa9800e95325d2b87c06084e63f8"], "node": "cc73c9e433e457a71bc6a21d84495e6a4ee94f1f", "parents": ["3b3d54a129f508f684a28195990c5b1e539b293b"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067701 - Signal the notification helper to stop during install and uninstall r=hsohaney,browser-installer-reviewers,cdupuis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323224\n", "files": ["browser/installer/windows/moz.build", "browser/installer/windows/nsis/defines.nsi.in", "browser/installer/windows/nsis/installer.nsi", "browser/installer/windows/nsis/shared.nsh", "browser/installer/windows/nsis/stub.nsh", "browser/installer/windows/nsis/telemetry.nsh", "browser/installer/windows/nsis/uninstaller.nsi", "toolkit/mozapps/installer/windows/nsis/common.nsh"], "git_node": "31aae89dab8c3a911b0bd34451ce43f768338305", "git_parents": ["0cbacd989030244c44357fc20445e6b467765fa3"], "node": "beeae3718cd664a5ec66bcab01ecedfd44fdd1bc", "parents": ["cc73c9e433e457a71bc6a21d84495e6a4ee94f1f"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067701 - Signal the notification helper to stop before applying an update r=iholmes,hsohaney,application-update-reviewers,cdupuis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323225\n", "files": ["toolkit/xre/moz.build", "toolkit/xre/nsUpdateDriver.cpp"], "git_node": "6444b074746c84c6088df22fed100ffc479cb537", "git_parents": ["31aae89dab8c3a911b0bd34451ce43f768338305"], "node": "f832556f65d0e2c58c6644e68d3b3426da1c6756", "parents": ["beeae3718cd664a5ec66bcab01ecedfd44fdd1bc"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2073850 - Scale the vis culling rect round-trip tolerance with the mapping translation. r=gfx-reviewers,gw\n\nA picture cache slice that sits far from the origin (a large scroll or\npinch-zoom offset) cannot round-trip its culling rect through the f32\nscale+offset exactly: `unmap` divides the screen by the mapping and `map`\nmultiplies it back, each rounding at the magnitude of the translation. In\nthe bug the loss is exactly one ulp (0.0625 at an offset of ~673405),\nwhich is just past the fixed 0.05 tolerance, so the assertion fired because\nof precision issue with the assertion itself rather than the invariant it\nwas trying to check.\n\nI almost removed the assertion. It was added in an abundance of caution\nto validate a complex change that was made recently but if it doesn't\nuncover real issues for a month or two we should take it as signal that\nthe change was good and we don't need to keep checking it forever.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327812\n", "files": ["gfx/wr/webrender/src/surface.rs", "gfx/wr/wrench/reftests/crash/culling-rect-large-offset.yaml", "gfx/wr/wrench/reftests/crash/reftest.list"], "git_node": "e00f22e0c8bb8967fd555c6c0275e927d764e0f7", "git_parents": ["6444b074746c84c6088df22fed100ffc479cb537"], "node": "7f6fe90ce9f8e77c2a7134821d82150b4fd88a6e", "parents": ["f832556f65d0e2c58c6644e68d3b3426da1c6756"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074010 - Add pan/zoom and PNG export to the wrshell texture viewer. r=gfx-reviewers,lsalzman\n\nThe texture preview was a scroll area around a 1:1 image, which made it\nhard to inspect small atlas entries or get an overview of a large target.\n\nReplace it with a painter-based canvas: drag to pan, wheel or pinch to\nzoom anchored at the pointer, plus toolbar buttons for zoom in/out, 1:1\nand fit to view. Pan and zoom are stored per document so they survive\nswitching textures. Textures are uploaded with nearest magnification so\ntexels stay crisp when zoomed in.\n\nThe toolbar also gets a \"Save as PNG\" button. The format conversion used\nby the GPU upload is factored out into texture_to_rgba and shared with\nthe PNG encoder, so BGRA8 and R8 textures are written with correct\ncolors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327759\n", "files": ["gfx/wr/wrshell/src/gui/mod.rs", "gfx/wr/wrshell/src/gui/textures.rs"], "git_node": "d1ea46ba6534d9ff80ace6875f430d79b49f39dd", "git_parents": ["e00f22e0c8bb8967fd555c6c0275e927d764e0f7"], "node": "fee7bc725ddbe592134d4a9f5ca7a33454b147f6", "parents": ["7f6fe90ce9f8e77c2a7134821d82150b4fd88a6e"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074010 - Show the hovered texel's color in the wrshell texture viewer. r=gfx-reviewers,gw\n\nAdd a readout to the texture viewer toolbar with the coordinates and the\nunmultiplied RGBA value of the texel under the pointer. The value is read\nstraight from the texture data rather than from the uploaded image, and\nBGRA8 and R8 are normalized to RGBA so the numbers match what the viewer\ndraws.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327760\n", "files": ["gfx/wr/wrshell/src/gui/textures.rs"], "git_node": "a6f6fb43e62f17f44cc003b05f86ca8e82f1d43f", "git_parents": ["d1ea46ba6534d9ff80ace6875f430d79b49f39dd"], "node": "7b9f5e83ee07afa9441eb3359876b357eb6ff558", "parents": ["fee7bc725ddbe592134d4a9f5ca7a33454b147f6"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Delete the release automation scripts and configs that no task runs. r=ahal\n\n`repo_manipulation.py` and `bouncer/submitter.py` are Python 2 only and\nnothing imports them. The `updates`, `dev_updates` and `dev_postrelease`\nconfigs fed scripts that were deleted with the buildbot release\nautomation, and `configs/servo` has had no script since the servo\nintegration ended. The five `bouncer_firefox` configs stay because\n`bouncer_check.py` still reads them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327635\n", "files": ["testing/mozharness/configs/releases/dev_postrelease_fennec_beta.py", "testing/mozharness/configs/releases/dev_postrelease_fennec_release.py", "testing/mozharness/configs/releases/dev_postrelease_firefox_beta.py", "testing/mozharness/configs/releases/dev_postrelease_firefox_release.py", "testing/mozharness/configs/releases/dev_postrelease_firefox_release_birch.py", "testing/mozharness/configs/releases/dev_updates_firefox_beta.py", "testing/mozharness/configs/releases/dev_updates_firefox_devedition.py", "testing/mozharness/configs/releases/dev_updates_firefox_release.py", "testing/mozharness/configs/releases/dev_updates_firefox_release_birch.py", "testing/mozharness/configs/releases/updates_firefox_beta.py", "testing/mozharness/configs/releases/updates_firefox_devedition.py", "testing/mozharness/configs/releases/updates_firefox_release.py", "testing/mozharness/configs/servo/mac.py", "testing/mozharness/mozharness/mozilla/bouncer/__init__.py", "testing/mozharness/mozharness/mozilla/bouncer/submitter.py", "testing/mozharness/mozharness/mozilla/repo_manipulation.py"], "git_node": "42eb6a9f7667ab420607fb7bb5278bc820ce0e83", "git_parents": ["a6f6fb43e62f17f44cc003b05f86ca8e82f1d43f"], "node": "90a108448d6cf7bb470b1c483ebf3a61773d411e", "parents": ["7b9f5e83ee07afa9441eb3359876b357eb6ff558"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Delete the transfer, parallel and diskutils helpers that nothing calls. r=ahal\n\n`TransferMixin` only served `MercurialVCS.query_pushinfo`, which no\nscript calls, so the mixin, the method and the `vcs_query_pushinfo`\nwrapper go together. `ChunkingMixin` and the `diskutils` module have no\nimporter outside their own unit tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327636\n", "files": ["testing/mozharness/mozharness/base/diskutils.py", "testing/mozharness/mozharness/base/parallel.py", "testing/mozharness/mozharness/base/transfer.py", "testing/mozharness/mozharness/base/vcs/mercurial.py", "testing/mozharness/mozharness/base/vcs/vcsbase.py", "testing/mozharness/scripts/marionette.py", "testing/mozharness/test/python.toml", "testing/mozharness/test/test_base_diskutils.py", "testing/mozharness/test/test_base_parallel.py"], "git_node": "e5e81f404777adfd287b15c6afdf621c5c044062", "git_parents": ["42eb6a9f7667ab420607fb7bb5278bc820ce0e83"], "node": "a80749a171a53e0c0b904f0da590242d669a0a1d", "parents": ["90a108448d6cf7bb470b1c483ebf3a61773d411e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Delete the Python 3 virtualenv mixin, the site packages query and the Raptor chrome download. r=ahal\n\n`Python3Virtualenv` is listed as a base class of `Raptor` and `Talos`\nbut neither calls any of its methods, since both create their virtualenv\nthrough `VirtualenvMixin`. `query_python_site_packages_path` has no\ncaller and the Python snippet it runs is a `SyntaxError`.\n`download_chrome_android` is not in any action list and no config or\ntransform names it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327637\n", "files": ["testing/mozharness/mozharness/base/python.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/mozharness/mozharness/mozilla/testing/talos.py"], "git_node": "cee5d5dc81ee85b8057826e349e7878c77631e77", "git_parents": ["e5e81f404777adfd287b15c6afdf621c5c044062"], "node": "197425a36083a661f4873e71ed5299815b727268", "parents": ["a80749a171a53e0c0b904f0da590242d669a0a1d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Delete the setuptools packaging, the nose runner and the orphaned Sphinx project. r=ahal\n\nmozharness is only ever imported from the tree, so `setup.py` and\n`setup.cfg` have nothing to install. `unit.sh` and `.noserc` drive nose,\nwhile the tests run under `mach python-test`. The `docs` directory is\nnot in any Sphinx tree and documents modules that no longer exist.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327638\n", "files": ["pyproject.toml", "testing/mozharness/docs/Makefile", "testing/mozharness/docs/android_emulator_build.md", "testing/mozharness/docs/android_emulator_unittest.md", "testing/mozharness/docs/bouncer_submitter.md", "testing/mozharness/docs/conf.py", "testing/mozharness/docs/configtest.md", "testing/mozharness/docs/desktop_l10n.md", "testing/mozharness/docs/desktop_unittest.md", "testing/mozharness/docs/fx_desktop_build.md", "testing/mozharness/docs/index.md", "testing/mozharness/docs/marionette.md", "testing/mozharness/docs/mobile_partner_repack.md", "testing/mozharness/docs/modules.md", "testing/mozharness/docs/mozharness.base.md", "testing/mozharness/docs/mozharness.base.vcs.md", "testing/mozharness/docs/mozharness.md", "testing/mozharness/docs/mozharness.mozilla.building.md", "testing/mozharness/docs/mozharness.mozilla.l10n.md", "testing/mozharness/docs/mozharness.mozilla.md", "testing/mozharness/docs/mozharness.mozilla.testing.md", "testing/mozharness/docs/multil10n.md", "testing/mozharness/docs/scripts.md", "testing/mozharness/docs/talos_script.md", "testing/mozharness/docs/web_platform_tests.md", "testing/mozharness/setup.cfg", "testing/mozharness/setup.py", "testing/mozharness/test/helper_files/.noserc", "testing/mozharness/unit.sh"], "git_node": "6a83c6161eba562d614154be64912f509b4a8196", "git_parents": ["cee5d5dc81ee85b8057826e349e7878c77631e77"], "node": "4b08fe2127f5fca93a43e24c0ed0d545cc7c64a5", "parents": ["197425a36083a661f4873e71ed5299815b727268"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Drop the retry strings that nothing emits. r=ahal\n\nNo harness or script in the tree prints `FAIL-SHOULD-RETRY` or `program\nfinished with exit code 80`, so matching them in the harness retry regex\nonly costs a longer pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327639\n", "files": ["testing/mozharness/mozharness/mozilla/testing/errors.py"], "git_node": "1c8c83dfd9ad50ef1832dc39fdf0e9459d4ac966", "git_parents": ["6a83c6161eba562d614154be64912f509b4a8196"], "node": "b4b62564bac7efda8e1c63058e8c81723a7a8dbf", "parents": ["4b08fe2127f5fca93a43e24c0ed0d545cc7c64a5"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Drop the taskgraph and test archive entries that have no effect. r=ahal,taskgraph-reviewers\n\n`set_tag` never sets its tag, so it yields every task unchanged.\n`MOZILLA_BUILD_URL` has no reader in the tree. The perftests archive\nalready ships `python/**` so the three `python/sites` entries add\nnothing, and `mach/**` matches no path because `mach` is a file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327640\n", "files": ["python/mozbuild/mozbuild/action/test_archive.py", "taskcluster/gecko_taskgraph/transforms/job/mozharness_test.py", "taskcluster/gecko_taskgraph/transforms/test/other.py"], "git_node": "d2c069c59adf38920da9fcff2f053cb9aedd6d8d", "git_parents": ["1c8c83dfd9ad50ef1832dc39fdf0e9459d4ac966"], "node": "3cf038a0889a2bd76dba5554365484bd607ed687", "parents": ["b4b62564bac7efda8e1c63058e8c81723a7a8dbf"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Delete three test configs that no task or transform loads. r=ahal\n\n`raptor/windows_external_browser_config.py` is byte identical to\n`windows_config.py`, so the raptor transform now names the latter.\n`firefox_ui_tests/qa_jenkins.py` and `marionette/windows_config.py` are\nreferenced by nothing and point at buildbot era `python27` paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327641\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py", "testing/mozharness/configs/firefox_ui_tests/qa_jenkins.py", "testing/mozharness/configs/marionette/windows_config.py", "testing/mozharness/configs/raptor/windows_external_browser_config.py"], "git_node": "77c38c4419b61d7653460af562db5379dd2fc0e6", "git_parents": ["d2c069c59adf38920da9fcff2f053cb9aedd6d8d"], "node": "6c42d922bb84732eeaf44e285abdc1dd45c6e47f", "parents": ["3cf038a0889a2bd76dba5554365484bd607ed687"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Delete the buildbase helpers that nothing calls. r=ahal\n\n`generate_build_ID` and `generate_build_UID` have no callers.\n`query_is_nightly_promotion` reads `enable_nightly_promotion`, which no\nconfig sets, so its only call site collapses to `query_is_nightly` and\nthe `nightly_promotion_branches` default goes with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327642\n", "files": ["testing/mozharness/mozharness/mozilla/building/buildbase.py", "testing/mozharness/scripts/fx_desktop_build.py"], "git_node": "504526720a6e44a9fe4c3eb121816349f7921332", "git_parents": ["77c38c4419b61d7653460af562db5379dd2fc0e6"], "node": "6bd211afe86a938e26c760d1297ea0d75ba7c194", "parents": ["6c42d922bb84732eeaf44e285abdc1dd45c6e47f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Drop the `src_mozconfig_manifest` way of naming a mozconfig. r=ahal\n\nNo config or kind sets `src_mozconfig_manifest`, so `get_mozconfig_path`\nonly needs the composite keys and `src_mozconfig`. The test for the\nmanifest branch and its helper file go with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327643\n", "files": ["testing/mozharness/mozharness/mozilla/building/buildbase.py", "testing/mozharness/test/helper_files/mozconfig_manifest.json", "testing/mozharness/test/test_mozilla_building_buildbase.py"], "git_node": "3e14ce03dfe26c97ee4ae007f3e572492860a8a6", "git_parents": ["504526720a6e44a9fe4c3eb121816349f7921332"], "node": "078e00668cf9e6d5baa11662038fb8f33ab0dcbe", "parents": ["6bd211afe86a938e26c760d1297ea0d75ba7c194"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Delete the build config keys that nothing reads. r=ahal\n\n`stage_platform` is written by every build config and 32 kind entries\nand read only by an existence check in `BuildScript.__init__`.\n`publish_nightly_en_US_routes`,\n`platform_supports_post_upload_to_latest`, `enable_max_vsize`,\n`enable_check_test` and `artifact_flag_build_variant_in_try` are written\nby four configs and read nowhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327644\n", "files": ["taskcluster/kinds/build/ios.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx-native.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "testing/mozharness/configs/builds/releng_base_android_64_builds.py", "testing/mozharness/configs/builds/releng_base_linux_64_builds.py", "testing/mozharness/configs/builds/releng_base_mac_64_cross_builds.py", "testing/mozharness/configs/builds/releng_base_windows_32_mingw_builds.py", "testing/mozharness/configs/builds/releng_base_windows_64_mingw_builds.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_fenix_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_asan_tc.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_geckoview_docs.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_ccov.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug_isolated_process.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_fuzzing_asan_tc.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_fuzzing_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_asan_tc.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_asan_tc_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_code_coverage_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_code_coverage_opt.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_fuzzing_asan_tc.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_fuzzing_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_fuzzing_tsan_tc.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_noopt_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_opt.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_source.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_tsan_tc.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_valgrind.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_fuzzing_asan.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_fuzzing_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_noopt_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_opt_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/rusttests.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_mingwclang.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_mingwclang.py", "testing/mozharness/configs/builds/taskcluster_sub_win32/debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win32/noopt_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/asan_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/ccov_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/noopt_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/plain_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/rusttests_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_opt.py", "testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": "f8299ebb050cca7fb6cbf7ea3c9f1b108d11f034", "git_parents": ["3e14ce03dfe26c97ee4ae007f3e572492860a8a6"], "node": "961cee0d8eae6689affd8d99f1e5329ba9d10af8", "parents": ["078e00668cf9e6d5baa11662038fb8f33ab0dcbe"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073825 - Drop the `clobber` action from the build configs. r=ahal\n\n`clobber` sits in the `default_actions` of twelve build configs and in\nthe `fx_desktop_build.py` action list, but `MOZHARNESS_ACTIONS`\noverrides that list in every CI task, so no task has run it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327645\n", "files": ["testing/mozharness/configs/builds/releng_base_linux_64_builds.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_opt.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_valgrind.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_opt_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_debug.py", "testing/mozharness/scripts/fx_desktop_build.py"], "git_node": "0549b2bd9076d1ecf7e263b2fb6b9c9babe60703", "git_parents": ["f8299ebb050cca7fb6cbf7ea3c9f1b108d11f034"], "node": "84a3586c3299031263041bd25a711b17937c6754", "parents": ["961cee0d8eae6689affd8d99f1e5329ba9d10af8"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070819 - Dump symbols for `RUST_PROGRAMS` r=firefox-build-system-reviewers,sergesanspaille\n\nSymbol dumping is driven by `syms_targets` in root.mk, which picks the\ndirectories the `syms` tier visits, and by `DUMP_SYMS_TARGETS` in rules.mk,\nwhich names the files to dump once there. Both were fed from the C++ object\nkinds only. `RustProgram` never added its directory to `_no_skip[\"syms\"]`, so\nmake never entered the directory, which is why adding `RUST_PROGRAMS` to\n`DUMP_SYMS_TARGETS` alone changes nothing.\n\n`make_cargo_rule` already declares the cargo output as a target, so `syms`\ncan depend on it like any other program. A program with\n`RUST_PROGRAM_OUTPUT_CATEGORY` is built by its own tier, so its directory is\nskipped as for `SharedLibrary`, and the make list filters it through\n`MOZBUILD_NON_DEFAULT_TARGETS` as `target::` does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325250\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/mixed/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/mixed/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/with-output-category/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/with-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/without-output-category/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/without-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "a47721ed7f45dcbe3a7020bad05df4e671a11167", "git_parents": ["0549b2bd9076d1ecf7e263b2fb6b9c9babe60703"], "node": "45af054020e6e6dd72243b37262a153d3b640006", "parents": ["84a3586c3299031263041bd25a711b17937c6754"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070819 - Keep debug info in Rust executables when debug symbols are enabled r=firefox-build-system-reviewers,sergesanspaille\n\nCargo's release profile sets no debug level, so cargo passes\n`-C strip=debuginfo` and leaves macOS on packed split debug info. The linked\nexecutable then has no DWARF on Linux, and on macOS the objects dsymutil\nneeds are deleted at link time, so the dumped symbols carry no functions or\nline numbers. RUSTFLAGS come after the profile flags, so `-C strip=none` and\n`-C split-debuginfo=unpacked` win.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325251\n", "files": ["build/moz.configure/rust.configure"], "git_node": "591422487976a74e25b9540d6993f8be59bc6071", "git_parents": ["a47721ed7f45dcbe3a7020bad05df4e671a11167"], "node": "53276060f5d7e4b5b9f9175df70d4db6afad086f", "parents": ["45af054020e6e6dd72243b37262a153d3b640006"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070819 - Locate the PDB before running `pdbstr` in `symbolstore.py` r=crashreporting-reviewers,afranchuk\n\n`pdbstr` writes a table into the PDB that tells a debugger where to fetch\neach source file from. `SourceServerIndexing` ran it on the PDB name\n`dump_syms` reported, relative to the current directory, which only finds a\nPDB the C++ link rules put in the build directory. Cargo writes the\ncrashreporter's PDB next to the executable, so `pdbstr` failed, its exit\ncode was ignored, and the copied PDB had no source information. The PDB is\nnow resolved with `locate_pdb`, as the copy step already does, and `pdbstr`\nruns from its directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325252\n", "files": ["toolkit/crashreporter/tools/symbolstore.py", "toolkit/crashreporter/tools/unit-symbolstore.py"], "git_node": "ccaab662be13efaa8be72436d8ac98dd885542f1", "git_parents": ["591422487976a74e25b9540d6993f8be59bc6071"], "node": "c1dcdd4dca8bd5bab89ccd6396d131633f7d7fe6", "parents": ["53276060f5d7e4b5b9f9175df70d4db6afad086f"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073819: Close the parent's pipe ends when Subprocess fails to launch the child on Unix. r=robwu\n\nWhen IOUtils.launchProcess() throws, spawn() disposed only the child's ends of the pipes it had just created. The parent's ends of stdin, stdout, stderr and the exit sentinel stayed open until the worker garbage-collected them, four descriptors per failed launch. An extension that keeps retrying a native messaging host whose launch fails can exhaust the process's descriptors this way. The Windows worker already closes its pipes on failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327609\n", "files": ["toolkit/modules/subprocess/subprocess_unix.worker.js", "toolkit/modules/subprocess/test/xpcshell/test_subprocess.js"], "git_node": "d3e70cfe88a223d4c83281ded22cbe86243a31dc", "git_parents": ["ccaab662be13efaa8be72436d8ac98dd885542f1"], "node": "faa2abf86d5147e905aecd04d30f48dbaa949b56", "parents": ["c1dcdd4dca8bd5bab89ccd6396d131633f7d7fe6"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073711 - Split browser_aboutwelcome_configurable_ui.js into separate files. r=omc-reviewers,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327868\n", "files": ["browser/components/aboutwelcome/tests/browser/browser.toml", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_corner_image.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_layout.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_logo.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_navigation.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_theming.js", "browser/components/aboutwelcome/tests/browser/head.js"], "git_node": "2b5b7daa408949f4aa3f6742d32033d42992e003", "git_parents": ["d3e70cfe88a223d4c83281ded22cbe86243a31dc"], "node": "ae6bdd9449cf513311c47e2db28b0059c74d7a30", "parents": ["faa2abf86d5147e905aecd04d30f48dbaa949b56"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710901 - Replace waitForCondition with TestUtils.waitForCondition in various directories. r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325386\n", "files": ["browser/base/content/test/browser-about/head.js", "browser/base/content/test/browser-general/browser_bug624734.js", "browser/base/content/test/browser-general/head.js", "browser/base/content/test/browser-plugins/head.js", "browser/modules/test/browser/head.js", "toolkit/content/tests/chrome/file_autocomplete_with_composition.js", "toolkit/content/tests/chrome/file_editor_with_autocomplete.js", "toolkit/content/tests/chrome/test_editor_for_input_with_autocomplete.html", "toolkit/content/tests/widgets/head.js", "toolkit/content/tests/widgets/test_videocontrols_standalone.html"], "git_node": "2b1dd4b3b333af4f16d59e7437370a8c9e32f109", "git_parents": ["2b5b7daa408949f4aa3f6742d32033d42992e003"], "node": "379ddbca11cedef39a44fe52ad5edecd2161cdf4", "parents": ["ae6bdd9449cf513311c47e2db28b0059c74d7a30"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710901 - Replace waitForCondition with TestUtils.waitForCondition in browser/components/multilineeditor/tests. r=flozia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325392\n", "files": ["browser/components/multilineeditor/tests/chrome/test_multiline_editor_aria.html"], "git_node": "af01b30e6da3f255895c387f4cca4379c821ef90", "git_parents": ["2b1dd4b3b333af4f16d59e7437370a8c9e32f109"], "node": "e0b0611c531e338264179d95744013b70836f481", "parents": ["379ddbca11cedef39a44fe52ad5edecd2161cdf4"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038325: Make a masked SVG group active when a child should be active. r=nical\n\nInside an \u003csvg\u003e, a masked group only left the blob image when a child had to be active. With a luminance mask over a large \u003cimage\u003e and an animated sibling, every frame rasterized the masked image and the luminance mask again on the CPU, which is what keeps the GPU process busy on Google search pages with an AI overview. Letting a child that should be active (a large image or shape, an animated transform) pull the group out of the blob keeps the mask image cached and lets the image stay a WebRender primitive. The same content without the mask already took that path and measured about five times cheaper locally.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327672\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/reftests/svg/mask-large-child-01-ref.svg", "layout/reftests/svg/mask-large-child-01.svg", "layout/reftests/svg/mask-large-image-01-ref.html", "layout/reftests/svg/mask-large-image-01.html", "layout/reftests/svg/mask-large-image-no-paint-01-ref.html", "layout/reftests/svg/mask-large-image-no-paint-01.html", "layout/reftests/svg/reftest.list"], "git_node": "2c558f13263b8bbff9d0a13e91862f64a54cdc86", "git_parents": ["af01b30e6da3f255895c387f4cca4379c821ef90"], "node": "863a3197e4a7240a194cf23f013eb0dce13ca9d1", "parents": ["e0b0611c531e338264179d95744013b70836f481"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073992 - Assert the I/O thread before registering the write watcher. r=ipc-reviewers,nika\n\nclang's -Wthread-safety-pointer warning warns when passing or returning\npointers to guarded data. It was added in clang 21 and will be enabled\nby default under -Wthread-safety in a future clang release.\n\n-Wthread-safety-pointer reports:\n\nipc/chromium/src/chrome/common/ipc_channel_posix.cc: warning: passing pointer to variable\n  'write_watcher_' requires holding event target 'chan_cap_.mTarget' [-Wthread-safety-pointer]\n  |             MessageLoopForIO::WATCH_WRITE, &write_watcher_, this);\n  |                                             ^\n\nPassing &write_watcher_ to WatchFileDescriptor(), which may modify the\nwatcher, triggers -Wthread-safety-pointer. write_watcher_ may only be\naccessed on the IOThread. This function checks for IOThread(), but\nclang can't infer the access is safe from IsOnCurrentThread() alone,\nso explicitly AssertOnCurrentThread() to satisfy clang.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327739\n", "files": ["ipc/chromium/src/chrome/common/ipc_channel_posix.cc"], "git_node": "7abe9016e512c1cef3f6d8035507a5ed867b9899", "git_parents": ["2c558f13263b8bbff9d0a13e91862f64a54cdc86"], "node": "3106ac6958b6a35693ec59b1c668084b3f999dd8", "parents": ["863a3197e4a7240a194cf23f013eb0dce13ca9d1"], "tags": []}, {"author": "David \u003cnone@example.com\u003e", "branch": "default", "desc": "Bug 1973441 - Include saved tab groups on session restore. r=sessionstore-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327558\n", "files": ["browser/components/sessionstore/SessionStartup.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": "35741618a339df02a2d55ef5100a3a8fca14807d", "git_parents": ["7abe9016e512c1cef3f6d8035507a5ed867b9899"], "node": "77e8f055ea09204bb8f29bab69a28bd25e2aed1a", "parents": ["3106ac6958b6a35693ec59b1c668084b3f999dd8"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2073976 - Pt 1 - Add the content-side interner for the display list builder r=gfx-reviewers,nical\n\nA lean interning structure for the display list builder, standalone and unit\ntested; not wired into the builder yet.\n\nRetained across builds rather than reset, so it de-duplicates both within a\nsingle display list and across consecutive ones. The display list carries a\nHandle - a store slot plus the build the item was first interned in - instead\nof the item data. The handle is stable while the entry lives, so unchanged\ncontent produces identical display list bytes from one build to the next.\n\nend_build garbage collects entries absent from RETAIN_BUILDS consecutive\ndisplay lists and returns the InternOps delta: the adds minted this build plus\nthe slots GC freed. DlInterners gathers one interner per interned type behind\na single build counter and a BuilderId, and closes them together into one\nDlDelta per display list, which is what will cross IPC. The type list,\nenumerate_dl_interned_types!, is empty: the machinery lands first and the\nprimitive types move over one at a time, each adding one line to it.\n\nCollection frees entries, not the capacity they occupied, so one very large\nscene would otherwise leave the containers sized for it for the life of the\nbuilder. end_build counts the builds an interner has spent below half its\ncapacity and, after SHRINK_AFTER_BUILDS of them in a row, reallocates the\ncontainers down to what is live. The wait is hysteresis against a scene that\nalternates between large and small.\n\nTwo things the delta deliberately does not promise. It says nothing about the\norder of adds against removes beyond \"apply adds first\", because a receiver\nthat needs more than that is a receiver that can desynchronise. And a build\nthat is started and abandoned must not carry its adds into the next delta: an\nadd that survives into a build the receiver never sees is an entry the two\nsides disagree about for good. The interners alone cannot detect that - they\nonly see the build number, which only advances when a build ends - so\nDlInterners brackets each build with begin_build and end_build and asserts\nthe previous build was closed before opening the next.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327731\n", "files": ["gfx/wr/webrender_api/src/interning.rs", "gfx/wr/webrender_api/src/lib.rs"], "git_node": "f4d25068c5d83350fe9866c7715b13504a6c8cd7", "git_parents": ["35741618a339df02a2d55ef5100a3a8fca14807d"], "node": "bcf41ed1c25b31667d6697819a2edbf10c55e191", "parents": ["77e8f055ea09204bb8f29bab69a28bd25e2aed1a"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069075 - Stocks: switch Merino calls to the new API r=maxx\n\nThe Stocks widget now looks up each saved watchlist symbol with a single\nMerino quote request. The extra request that prefixed the symbol with a\ndollar sign has been dropped, as it's no longer needed.\n\nThe placeholder for a pending row is now dimmed on the row itself rather\nthan on the whole list, so it looks the same whether or not the rest of\nthe watchlist has data. A saved symbol that Merino returns no data for\nno longer flashes a placeholder whenever the watchlist changes. Some of\nthe widget's CSS has also moved to the design system's default values\nand available tokens, so the loading and disabled states follow the\nsystem settings in High Contrast Mode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326392\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/StockTicker.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/lib/Widgets/StocksFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StockTicker.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/extensions/newtab/test/xpcshell/test_StocksFeed.js"], "git_node": "cda67b9b05bb1d0a1f7f1642c6d2a2aefe6e917f", "git_parents": ["f4d25068c5d83350fe9866c7715b13504a6c8cd7"], "node": "1ae4b7761fac3131e659640a8e887e256c99853e", "parents": ["bcf41ed1c25b31667d6697819a2edbf10c55e191"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069512 - Part 1: Add the Stocks widget search entry point strings r=fluent-reviewers,maxx,bolsson\n\nFour Fluent messages have been added for the Stocks widget's new search\nbutton, its Watchlist empty state and the hint shown in the search panel\nuntil the user searches. A migration recipe copies the existing\ntranslations into the two button messages: \"Search by name or symbol\"\nfrom the widget's own search field, and \"Search\" from the New Tab search\nbox button, which has the identical intent of a verb on a button that\nstarts a search. The source strings have been in the tree for five weeks\nand the Stocks one is translated in 46 locales. The other two messages\nare new copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327767\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl", "python/l10n/fluent_migrations/bug_2069512_stocks_search_entry_point.py"], "git_node": "4a60ef3e4f802f5234f8e2deb34b24a72fe88bd7", "git_parents": ["cda67b9b05bb1d0a1f7f1642c6d2a2aefe6e917f"], "node": "6261e2f56170716f6da2789a96a203d4c47db84a", "parents": ["1ae4b7761fac3131e659640a8e887e256c99853e"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069512 - Part 2: Add the Stocks widget search entry point r=maxx\n\nSearch has become a main action on the Stocks widget at medium and large,\nfollowing the Variant A design. A \"Search\" button now sits in the toolbar\nnext to the list dropdown, collapsed to an icon until it is hovered or\nfocused, and an empty Watchlist shows an empty state with Kit, a short\nmessage and a \"Search\" button of its own. Both open the same search panel\nas the context menu item, and focus returns to whichever control opened\nsearch when it closes. The search panel shows a hint until the user searches.\n\nThe dropdown has moved from the ghost to the default button type to match\nthe design, and stock rows at medium and large have gained a tooltip with\nthe full stock name.\n\nRemoving the last Watchlist row now keeps the user on the Watchlist,\nshowing the empty state, instead of switching back to Markets.\n\nEach entry point records `search_tickers` with its own `widget_source`\n(`widget`, `empty_state` and the existing `context_menu`).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327768\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/StockSearch.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/StockTicker.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/content-src/components/Widgets/Stocks/useStockSearch.jsx", "browser/extensions/newtab/data/content/assets/kit-stocks-watchlist.svg", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StockSearch.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StockTicker.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx"], "git_node": "3d4729d54b2db4cec53f6bb82ffbcca233b745ef", "git_parents": ["4a60ef3e4f802f5234f8e2deb34b24a72fe88bd7"], "node": "59d1b15c26eae1ff4fb4bef797eef686077ca23e", "parents": ["6261e2f56170716f6da2789a96a203d4c47db84a"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060156: End drag sessions on macOS that lost their native drag session. r=mac-reviewers,bradwerth\n\nA drag session only ends once something reports that the native drag is over, so a session that never gets such a report stays alive until shutdown and blocks every later drag. Two paths leave one behind: beginDraggingSessionWithItems:event:source: returning nil, which we reported as success, and a native drag whose end never reaches us.\n\nnsIDragService::unsuppress also decremented an unsigned level without checking it first, so an unbalanced call would wrap the level around and suppress drag and drop for the rest of the session.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327660\n", "files": ["widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/nsBaseDragService.cpp", "widget/tests/gtest/TestCocoaStaleDragSession.mm", "widget/tests/gtest/moz.build"], "git_node": "c112d527a3cd61b4a309721213ce78a9759b4056", "git_parents": ["3d4729d54b2db4cec53f6bb82ffbcca233b745ef"], "node": "6590769f8df70a395a20934bdb73386512ed1cf5", "parents": ["59d1b15c26eae1ff4fb4bef797eef686077ca23e"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073512 - Add image backdrop to newtab card stack r=emcminn,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327443\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "0a5d359ea2ecd7078e274786b600a88e941e62b8", "git_parents": ["c112d527a3cd61b4a309721213ce78a9759b4056"], "node": "5c79c8ea00d689cbb1204dd945d50f2c7efda67a", "parents": ["6590769f8df70a395a20934bdb73386512ed1cf5"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070819 - Locate the PDB before running `pdbstr` in `symbolstore.py` r=crashreporting-reviewers,afranchuk\" for causing build bustages\n\nThis reverts commit ccaab662be13efaa8be72436d8ac98dd885542f1.\n\nRevert \"Bug 2070819 - Keep debug info in Rust executables when debug symbols are enabled r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 591422487976a74e25b9540d6993f8be59bc6071.\n\nRevert \"Bug 2070819 - Dump symbols for `RUST_PROGRAMS` r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit a47721ed7f45dcbe3a7020bad05df4e671a11167.\n", "files": ["build/moz.configure/rust.configure", "config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/mixed/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/mixed/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/with-output-category/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/with-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/without-output-category/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/without-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "toolkit/crashreporter/tools/symbolstore.py", "toolkit/crashreporter/tools/unit-symbolstore.py"], "git_node": "1cb53e206e9f3a57fc7716691d7473b3b7693ef7", "git_parents": ["0a5d359ea2ecd7078e274786b600a88e941e62b8"], "node": "576a9f9ba0e47df7abe88429d12bdeb3abc7c78f", "parents": ["5c79c8ea00d689cbb1204dd945d50f2c7efda67a"], "tags": []}, {"author": "Maile Lucks \u003cmlucks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069516 - Use documentGlobal instead of the removed ownerGlobal in SidebarChatBotPromo r=omc-reviewers,dmose\n\n`Node.ownerGlobal` was removed and renamed to `documentGlobal`. Reading `browser?.ownerGlobal` now returns `undefined`, so the `topChromeWindow ?? ownerGlobal` fallback in `SidebarChatBotPromo.getPromoElement` can never resolve a window and the method returns null instead of falling back. Rename the read to `browser?.documentGlobal`, matching sibling asrouter modules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327857\n", "files": ["browser/components/asrouter/modules/SidebarChatBotPromo.sys.mjs"], "git_node": "e3489457b64ccf9d1643bb442df4a848a7fd1502", "git_parents": ["1cb53e206e9f3a57fc7716691d7473b3b7693ef7"], "node": "5c36da36e9b75402e2968fa1959fe005e4efe994", "parents": ["576a9f9ba0e47df7abe88429d12bdeb3abc7c78f"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073431: Remove the out parameter of nsIAppStartup::quit. r=haik,firefox-desktop-core-reviewers ,ipc-reviewers,gtk-reviewers,crashreporting-reviewers,mossop,gsvelto,emilio\n\napplicationShouldTerminate: in MacApplicationDelegate.mm was the only reader and now checks shuttingDown after calling Quit, which is set on the same path that set the parameter to true.\n\nThe one behavior difference is a quit request from macOS arriving while a shutdown is already underway, which now returns NSTerminateNow instead of NSTerminateCancel. This has no real-world consequences: the swizzled terminate: only posts NSApplicationWillTerminateNotification, as for any quit from the Dock, and Firefox finishes its own shutdown either way. In the log-out case it is desirable, since macOS no longer treats Firefox as refusing to quit while it is in fact exiting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327506\n", "files": ["extensions/pref/autoconfig/src/nsReadConfig.cpp", "ipc/glue/CrashReporterHelper.h", "toolkit/components/startup/nsAppStartup.cpp", "toolkit/components/startup/public/nsIAppStartup.idl", "toolkit/xre/MacApplicationDelegate.mm", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsNativeAppSupportUnix.cpp", "tools/@types/generated/lib.gecko.xpcom.d.ts", "widget/android/nsAppShell.cpp", "widget/cocoa/nsMenuBarX.mm", "widget/gtk/nsWaylandDisplay.cpp", "widget/uikit/nsAppShell.mm"], "git_node": "e7283de0a0a9e122155e9843dec4ddc83cdd0a01", "git_parents": ["e3489457b64ccf9d1643bb442df4a848a7fd1502"], "node": "6b7af8d3d995ffbf9f88373240d9e2fce47e9e67", "parents": ["5c36da36e9b75402e2968fa1959fe005e4efe994"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046503 - Widgets listed in about:preferences should be dynamically rendered from WidgetsRegistry.mjs r=maxx\n\nThe Firefox Home \u003e Widgets group in `about:preferences` is now generated from\n`WIDGET_REGISTRY` instead of being written out widget by widget. Each registry\nentry gained a `prefsL10nId` naming its label, and that is all a new widget\nneeds to appear there; a retired widget disappears on its own.\n\nWeather keeps a small hand-written part: with Nova off its toggle still uses\nthe legacy weather prefs, and it is the one widget that can sit outside the\nWidgets group as its own row. The legacy branch is marked for Nova cleanup.\n\nOne visible change: the checkboxes now follow registry order, the same order\nNew Tab uses by default, Weather included. Two setting ids changed under the\nhood, the Timer toggle's from `timer` to its registry id `focusTimer` and\nWeather's own row to `weatherStandalone`, leaving `weather` for its checkbox\ninside the group; the preferences mochitests were updated to match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327213\n", "files": ["browser/components/preferences/tests/home/browser_homepage_firefox_home.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_disabled_both_off.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_disabled_tabs_on.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_disabled_windows_on.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_widgets.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_widgets_2.js", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/AboutPreferences.test.js"], "git_node": "c3ce3bf0c5ce50049bd5798431cd0d4fb1700c71", "git_parents": ["e7283de0a0a9e122155e9843dec4ddc83cdd0a01"], "node": "8abe9f7e2ae1b82cd2d4d1458907e6c941a79f6e", "parents": ["6b7af8d3d995ffbf9f88373240d9e2fce47e9e67"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066334 - Part 1: Build the customize panel widget toggles from WidgetsRegistry.mjs r=fluent-reviewers,maxx,bolsson\n\nThe Manage widgets list in the New Tab customize panel is now generated from\n`WIDGET_REGISTRY` instead of being written out toggle by toggle. Each registry\nentry gained a `customizeL10nId` naming its panel label and a\n`customizeEventSource` carrying its telemetry source, so a new widget needs no\nedit to the panel and a retired widget drops out on its own. Crossword gained\na Fluent string of its own for the first time; a migration recipe copies its\ntranslations from the about:preferences Crossword label, and the classic\ncustomize menu switched to the same string.\n\nThe classic (Nova off) customize menu still renders its own widget toggles from\nthe `mayHave*` and `enabledWidgets` props, so that prop chain stayed and has\nbeen marked for Nova cleanup; only its retired Sports links were removed. The\ncheck that decides whether Weather may be shown moved out of Base.jsx into the\nregistry as `isWeatherAvailable`, where the panel shares it.\n\nEach flip now records one `PREF_CHANGED` and one `widgets_enabled` event.\nBefore, the outer Widgets toggle's handler also ran for the nested toggles,\nsince `moz-toggle` events bubble, and recorded a second pair with a size\ntaken from the maximised state rather than the widget's size pref; the\nsubpanel's handler now stops the event. The Weather toggle follows the\nwidget's own conditions: it needs `widgets.system.weather.enabled` as well\nas the legacy `showWeather` prefs, so it leaves the subpanel with its system\npref like the others. Three toggle ids changed to their registry ids\n(`focusTimer-toggle`, `pictureOfTheDay-toggle`, `recentSearches-toggle`), and\nthe browser test now finds the Weather toggle by its own id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327214\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/test/browser/browser_customize_menu_content.js", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl", "python/l10n/fluent_migrations/bug_2066334_newtab_customize_panel_crossword_label.py"], "git_node": "a7b8520dca3202217a84dccbf5b1f22b94ce66e6", "git_parents": ["c3ce3bf0c5ce50049bd5798431cd0d4fb1700c71"], "node": "ba723c91bdea3639c27745f592cd10eb58a14786", "parents": ["8abe9f7e2ae1b82cd2d4d1458907e6c941a79f6e"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066334 - Part 2: Sort the widget toggle lists alphabetically by localised label r=maxx\n\nBoth widget toggle lists now sort A-Z by the label the user sees, in the app\nlocale: the Firefox Home \u003e Widgets group in `about:preferences` and the\n\"Manage widgets\" subpanel of the New Tab customize panel. Part 1 put both\nlists in registry order; this patch replaces that with an order users can\nscan.\n\nEach surface sorts by its own strings. The `about:preferences` labels and\nthe customize panel labels are separate string sets, kept so that either\ncan be retired later, so a locale that translated the two sets differently\ncan order the two lists differently; in en-US they agree. The comparison is\n`localeCompare` with no arguments, which collates in the app locale on both\nsurfaces, and a label with no message sorts under its widget id, so the\norder is always defined.\n\nSetting registration order and the standalone Weather row are unchanged;\nnested Weather sorts among the other widgets. The \"Manage widgets\" subpanel\nrenders no toggles until its labels have resolved, which happens when the\npage loads and before the subpanel can be opened, so an unsorted list is\nnever shown. Tests on both surfaces pin hand-written orders for English,\nGerman, Greek and Japanese labels taken from Firefox's own translations,\nplus a reduced set, a missing label and a failing lookup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327215\n", "files": ["browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/useWidgetLabels.jsx", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/useWidgetLabels.test.jsx", "browser/extensions/newtab/test/jest/lib/AboutPreferences.test.js"], "git_node": "c5fc0e529924043fb7da81e3e96c32992897c2e1", "git_parents": ["a7b8520dca3202217a84dccbf5b1f22b94ce66e6"], "node": "ac08d6cbc9b71c4de85f72bc7457959ee2aed33b", "parents": ["ba723c91bdea3639c27745f592cd10eb58a14786"], "tags": []}, {"author": "Artem Popov \u003cart@artfwo.net\u003e", "branch": "default", "desc": "Bug 2063725 - Record the reason for IP Protection enrollment and proxy failures r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327753\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/metrics.yaml", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs", "toolkit/components/ipprotection/metrics.yaml"], "git_node": "05b373f0040503868392b2f0fd795ff9ce5128d5", "git_parents": ["c5fc0e529924043fb7da81e3e96c32992897c2e1"], "node": "cd80411e537e675a6d08a8ffe720b6f68dd309df", "parents": ["ac08d6cbc9b71c4de85f72bc7457959ee2aed33b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2072095 - Make `nsRange::CharacterDataChanged` maintain selection state of new `Text` and its closest common inclusive ancestor at split correctly r=jjaschke\n\nIf the range starts from the old `Text` and ends in new `Text`, the\nclosest common inclusive ancestor is the parent element, but current\ncode always treats the new `Text` as the closest common inclusive\nancestor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326764\n", "files": ["dom/base/nsRange.cpp", "dom/base/test/mochitest.toml", "dom/base/test/test_node_selected_flag_after_splitText.html", "testing/web-platform/tests/selection/selection-range-painting-after-splitText-ref.html", "testing/web-platform/tests/selection/selection-range-painting-after-splitText.html"], "git_node": "26694a6cbac7b96b25b23f09684788a1f70cdb39", "git_parents": ["05b373f0040503868392b2f0fd795ff9ce5128d5"], "node": "a4dffbf0b408777759c4c18610166c4051adf31b", "parents": ["cd80411e537e675a6d08a8ffe720b6f68dd309df"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062994 - Update Continue card to match story card r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325176\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/recenttabs/view/RecentTabs.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt"], "git_node": "5cb02c38d162096905101ec4562e328516e7daf3", "git_parents": ["26694a6cbac7b96b25b23f09684788a1f70cdb39"], "node": "0f8d1b7febf260bd45c2b4cdad9d100bd601a4f0", "parents": ["a4dffbf0b408777759c4c18610166c4051adf31b"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2073073 - wait to dismiss import fragment until lifecycle is started r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327200\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/ImportBookmarksDialogFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/ImportBookmarksDialogFragmentTest.kt"], "git_node": "3b01faae50ab7322c2f55f3130c906ff567a16ae", "git_parents": ["5cb02c38d162096905101ec4562e328516e7daf3"], "node": "709ba7cf5ec4b653b28ecb4987015bea8e49751a", "parents": ["0f8d1b7febf260bd45c2b4cdad9d100bd601a4f0"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070819 - Dump symbols for `RUST_PROGRAMS` r=firefox-build-system-reviewers,sergesanspaille\n\nSymbol dumping is driven by `syms_targets` in root.mk, which picks the\ndirectories the `syms` tier visits, and by `DUMP_SYMS_TARGETS` in rules.mk,\nwhich names the files to dump once there. Both were fed from the C++ object\nkinds only. `RustProgram` never added its directory to `_no_skip[\"syms\"]`, so\nmake never entered the directory, which is why adding `RUST_PROGRAMS` to\n`DUMP_SYMS_TARGETS` alone changes nothing.\n\n`make_cargo_rule` already declares the cargo output as a target, so `syms`\ncan depend on it like any other program. A program with\n`RUST_PROGRAM_OUTPUT_CATEGORY` is built by its own tier, so its directory is\nskipped as for `SharedLibrary`, and the make list filters it through\n`MOZBUILD_NON_DEFAULT_TARGETS` as `target::` does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325250\n", "files": ["config/makefiles/rust.mk", "config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/mixed/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/mixed/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/with-output-category/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/with-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/without-output-category/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-program-output-category/without-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "e91021bc244a7c88ae4bb158331a681215c81339", "git_parents": ["3b01faae50ab7322c2f55f3130c906ff567a16ae"], "node": "20579fde7859ff8f1dfcda62132d7292133f4a3e", "parents": ["709ba7cf5ec4b653b28ecb4987015bea8e49751a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070819 - Keep debug info in Rust executables when debug symbols are enabled r=firefox-build-system-reviewers,sergesanspaille\n\nCargo's release profile sets no debug level, so cargo passes\n`-C strip=debuginfo` and leaves macOS on packed split debug info. The linked\nexecutable then has no DWARF on Linux, and on macOS the objects dsymutil\nneeds are deleted at link time, so the dumped symbols carry no functions or\nline numbers. RUSTFLAGS come after the profile flags, so `-C strip=none` and\n`-C split-debuginfo=unpacked` win.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325251\n", "files": ["build/moz.configure/rust.configure"], "git_node": "22f86b119611651bbb3e9d2936b6675d9c94dec8", "git_parents": ["e91021bc244a7c88ae4bb158331a681215c81339"], "node": "918e38d80a3cfe811bc9e9675a648ac61059503f", "parents": ["20579fde7859ff8f1dfcda62132d7292133f4a3e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070819 - Locate the PDB before running `pdbstr` in `symbolstore.py` r=crashreporting-reviewers,afranchuk\n\n`pdbstr` writes a table into the PDB that tells a debugger where to fetch\neach source file from. `SourceServerIndexing` ran it on the PDB name\n`dump_syms` reported, relative to the current directory, which only finds a\nPDB the C++ link rules put in the build directory. Cargo writes the\ncrashreporter's PDB next to the executable, so `pdbstr` failed, its exit\ncode was ignored, and the copied PDB had no source information. The PDB is\nnow resolved with `locate_pdb`, as the copy step already does, and `pdbstr`\nruns from its directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325252\n", "files": ["toolkit/crashreporter/tools/symbolstore.py", "toolkit/crashreporter/tools/unit-symbolstore.py"], "git_node": "e10fd87729f7f8375b36b68cfdfbc9dbd335fe9c", "git_parents": ["22f86b119611651bbb3e9d2936b6675d9c94dec8"], "node": "1a5118fa06b1cb84feb2b611defcad11a1ecd6fe", "parents": ["918e38d80a3cfe811bc9e9675a648ac61059503f"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794663 - Make `concept-engine` not depend on `browser-errorpages`. r=android-reviewers,petru\n\nThis is fairly straightforward:\n\n* we lift the `ErrorType` definition up to `concept-engine`;\n* we make `browser-errorpages` expose the mapping from `ErrorType` to\n  concrete strings encapsulated in an `ErrorStrings` type via an\n  `ErrorStringsProvider` abstraction;\n* we implement a `DefaultErrorStringsProvider` that can be replaced or\n  extended by consumers.\n\nAlong the way, we replace some `*Override` functions by using the\nprovider.  And we harmonize how optional parts of the error page (for\narchiving, for certificate errors, and continuing to HTTP sites) work\nby introducing optional `*Details` objects to augment `ErrorStrings`.\n\nThis work was scoped to not change the underlying error page HTML.  As\na result, the detail augmentation approach is not particularly\ngraceful.  If we wanted to invest further, we might expose a more\ngeneral interface to the error page content that is less tied to\nspecific errors, and reduce the special cases inherent in both the\nHTML layer and the JVM layer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295734\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/android-components/components/browser/engine-system/src/main/java/mozilla/components/browser/engine/system/SystemEngineSession.kt", "mobile/android/android-components/components/browser/engine-system/src/main/java/mozilla/components/browser/engine/system/SystemEngineView.kt", "mobile/android/android-components/components/browser/engine-system/src/test/java/mozilla/components/browser/engine/system/SystemEngineSessionTest.kt", "mobile/android/android-components/components/browser/engine-system/src/test/java/mozilla/components/browser/engine/system/SystemEngineViewTest.kt", "mobile/android/android-components/components/browser/errorpages/README.md", "mobile/android/android-components/components/browser/errorpages/build.gradle", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/DefaultErrorStringsProvider.kt", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorPages.kt", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorStringsProvider.kt", "mobile/android/android-components/components/browser/errorpages/src/test/java/mozilla/components/browser/errorpages/ErrorPagesTest.kt", "mobile/android/android-components/components/concept/engine/build.gradle", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/request/ErrorType.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/request/RequestInterceptor.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/request/RequestInterceptorTest.kt", "mobile/android/android-components/components/service/nimbus/build.gradle", "mobile/android/android-components/config/detekt-baseline.xml", "mobile/android/android-components/samples/browser/build.gradle", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/request/SampleUrlEncodedRequestInterceptor.kt", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixErrorStringsProvider.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/AppRequestInterceptorTest.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/engine/AppContentInterceptor.kt"], "git_node": "e251bb1ebbf66b6297b6551d8ef2037c6c6e5d11", "git_parents": ["e10fd87729f7f8375b36b68cfdfbc9dbd335fe9c"], "node": "a62156b77be6e46473b3913a4e16d78b3995a57f", "parents": ["1a5118fa06b1cb84feb2b611defcad11a1ecd6fe"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794663 - Post: Fix HTTPS-Only back button. r=petru,parker,android-reviewers,android-l10n-reviewers\n\nThe previous patch models more of the data domain of the error pages,\nincluding _not_ including the \"bad cert\" strings when they shouldn't\nbe shown.  However, Fenix re-used the `badCertGoBack` string for the\nHTTPS-Only back button.  That's not best practice, so we duplicate the\nstring and interpolate the new string appropriately, fixing\n`SettingsHTTPSOnlyModeTest`.\n\nThe `a-c` error pages don't show a \"Go Back\" button; instead, they\nhide the button entirely.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327612\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/DefaultErrorStringsProvider.kt", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorPages.kt", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorStringsProvider.kt", "mobile/android/android-components/components/browser/errorpages/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/assets/lowMediumErrorPages.js"], "git_node": "50cf6fca8f6b142d510ba73819f42196115070fd", "git_parents": ["e251bb1ebbf66b6297b6551d8ef2037c6c6e5d11"], "node": "55e715502f0feeb39579b39acaad35126a5357e2", "parents": ["a62156b77be6e46473b3913a4e16d78b3995a57f"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014830 - Add a crashtest for the normalized timing overflow r=boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316989\n", "files": ["testing/web-platform/tests/scroll-animations/crashtests/scroll-timeline-with-long-duration.html"], "git_node": "197921732a9847be1e116cdb25a4c60b7cd9c8df", "git_parents": ["50cf6fca8f6b142d510ba73819f42196115070fd"], "node": "11a1cb10787cebb17323e430ba3090b0b2e1b3ef", "parents": ["55e715502f0feeb39579b39acaad35126a5357e2"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946610 - Flip layout.scroll.disable-pixel-alignment. r=botond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246874\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "ef07bfdf13988b2c3cf13cf06d2311d9e79fd78e", "git_parents": ["197921732a9847be1e116cdb25a4c60b7cd9c8df"], "node": "49f91df26c18422b904b2c4bfddb4882b54b6713", "parents": ["11a1cb10787cebb17323e430ba3090b0b2e1b3ef"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Plumb H264 profile and level into AndroidDataEncoder, matching the GMP/FFmpeg/Apple/WMF encoder backends. r=media-playback-reviewers,geckoview-reviewers,padenot,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321194\n", "files": ["dom/media/platforms/android/AndroidDataEncoder.cpp", "widget/android/bindings/MediaCodec-classes.txt"], "git_node": "85f324405c0f1726d980a123a5de73985f1a2ff9", "git_parents": ["ef07bfdf13988b2c3cf13cf06d2311d9e79fd78e"], "node": "c3d0b54328bc452ef76ed9498363beed0d51caed", "parents": ["49f91df26c18422b904b2c4bfddb4882b54b6713"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Balance the leaked active-request count when RemoteManager.createCodec() fails to init a codec. r=media-playback-reviewers,geckoview-reviewers,jolin,tcampbell\n\nIf CodecProxy.init() fails (e.g. Codec.configure() found no matching codec\nfor the requested profile/level/resolution), createCodec() returns null\nwithout ever calling IMediaManager.endRequest() to balance the\ncreateCodec() call already made on the remote. releaseCodec(), which is\nthe only other endRequest() call site, is never reached for a codec that\nwas never added to mCodecs.\n\nThis leaves the :media process's mNumActiveRequests permanently\nover-counted by one. The next time the client unbinds the service (e.g.\nbecause its last successfully-created codec was released and\nreleaseIfNeeded() unbound), MediaManager.onUnbind() sees a nonzero\nmNumActiveRequests and calls Process.killProcess() on itself, believing\nthe caller died abnormally. Android then respawns the :media process,\nwhich looks like a bind/unbind/process-restart cycle with no obvious\ntrigger. Failing codec creations (e.g. by requesting an H264 level 5/6\nresolution the platform's encoder doesn't support) reliably reproduce\nthis.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321195\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteManager.java"], "git_node": "1cd1e9c6d767029c3df46212e4b075e8b2d697ca", "git_parents": ["85f324405c0f1726d980a123a5de73985f1a2ff9"], "node": "958de9ac189060607c0eedb57fca860a21880243", "parents": ["c3d0b54328bc452ef76ed9498363beed0d51caed"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Report H264 QP thresholds from WebrtcMediaDataEncoder so libwebrtc's QualityScaler can track it. r=webrtc-reviewers,ng\n\nWebrtcMediaDataEncoder::GetEncoderInfo() never populated scaling_settings,\nleaving it at ScalingSettings::kOff. This means libwebrtc's\nQualityScalerResource cannot be kept alive across a switch onto this\nencoder: VideoStreamEncoderResourceManager::UpdateQualityScalerSettings()\nsees no QP thresholds and calls RemoveResource(), which -- if quality\nscaling was the only resource currently imposing a resolution\nrestriction -- resets restrictions to unconstrained via\nVideoStreamAdapter::ClearRestrictions().\n\nOn Android this produces an unbounded retry loop for resolutions beyond\nwhat the hardware MediaCodec encoder actually supports: the hardware\nencoder fails to configure, libwebrtc falls back to a software encoder\n(which reports QP thresholds and gets downscaled by the QualityScaler\nafter seeing 100% frame drop), and the moment that downscaled resolution\nlets the hardware encoder succeed again, its lack of QP thresholds tears\ndown the QualityScalerResource and wipes the very restriction that made\nit succeed -- so the next frame is requested at the full, unconstrained\nresolution again, repeating forever.\n\nReporting the same QP thresholds WebrtcGmpVideoEncoder already uses lets\nthe single, long-lived QualityScalerResource survive the switch (only\nSetQpThresholds() runs, not Remove/AddResource), so a resolution\nrestriction earned via the fallback encoder persists once the hardware\nencoder takes back over.\n\nMove the threshold constants into WebrtcGmpVideoCodec.h (as constexpr,\nshared by both encoder wrappers) instead of duplicating them: as\nstatic const int in each .cpp they collided under unified builds, which\nconcatenate both files into one translation unit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321196\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataEncoderCodec.cpp"], "git_node": "1faae7e52cd2df29f0961e437c354322e3a1e098", "git_parents": ["1cd1e9c6d767029c3df46212e4b075e8b2d697ca"], "node": "26357c4e5bc7724d8b5db859650231bfd033135d", "parents": ["958de9ac189060607c0eedb57fca860a21880243"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064678 - Add gtest coverage for encoding below Android's real per-frame macroblock cap at a Level 5-implied resolution. r=media-playback-reviewers,jolin\n\nMediaDataEncoderTest.H264Encodes4K* already covers the previously-documented\n4K resolution limit, but the actual platform limit turned out to be a\ntighter, ~8192-macroblock-per-frame budget (roughly Level 4-equivalent) --\nindependent of the declared H264 level -- discovered while investigating\nthe Level 5/6 profile-levels WPT hang. Add a resolution below the 4K\nthreshold but still over that macroblock budget, once with a deliberately\nmismatched (too-low) declared level and once with a level that actually\nmatches it, to cover both axes.\n\nOn macOS 15 aarch64 the VideoToolbox realtime encoder drops most frames at\nthis resolution, so the two new tests are skipped there pending bug 2074146,\nwhich adds a pref to disable frame dropping for tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321197\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": "5230e2270247a6d54bb621df16deea0504575f5e", "git_parents": ["1faae7e52cd2df29f0961e437c354322e3a1e098"], "node": "0bbbedcfa6f552105432ae040aed5c04455f6b07", "parents": ["26357c4e5bc7724d8b5db859650231bfd033135d"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067976 - Clean up some unnecessary string copies in SandboxBroker. r=Thinker,sandbox-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326377\n", "files": ["security/sandbox/linux/broker/SandboxBroker.cpp", "security/sandbox/linux/broker/SandboxBroker.h"], "git_node": "87d0b8421a102b30e277a4ed60a7df7d6b50e89c", "git_parents": ["5230e2270247a6d54bb621df16deea0504575f5e"], "node": "17283dd5b6750ff065168d0aef7614cf922cda15", "parents": ["0bbbedcfa6f552105432ae040aed5c04455f6b07"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 15 - Remove the legacy l10n driver r=firefox-build-system-reviewers,geckoview-reviewers,owlish,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322824\n", "files": ["browser/defs.mk", "browser/locales/Makefile.in", "browser/themes/shared/app-marketplace-icons/Makefile.in", "build/docs/locales.md", "config/config.mk", "config/rules.mk", "mobile/android/locales/Makefile.in", "mobile/android/moz.build", "mobile/locales/Makefile.in", "moz.configure", "python/mozbuild/mozbuild/controller/building.py", "python/mozbuild/mozbuild/jar.py", "toolkit/locales/Makefile.in", "toolkit/locales/l10n.mk", "toolkit/mozapps/installer/l10n-repack.py", "toolkit/mozapps/installer/packager.mk"], "git_node": "30dd2a71a5e8969d4f73a6844f5f1363384b4aa6", "git_parents": ["87d0b8421a102b30e277a4ed60a7df7d6b50e89c"], "node": "f3792e398a27eff95a3445f0119d5bf7f1f2760f", "parents": ["17283dd5b6750ff065168d0aef7614cf922cda15"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072116 - Use a record-system-perf wrapper for raptor perf profiling on Linux CI. r=perftest-reviewers,aglavic\n\nLinux talos workers now provide a perf wrapper. This is a similar\napproach that we already do with windows ETW traces.\n\nThis patch switches the Raptor CI path to that wrapper. It runs a fixed,\nsystem-wide perf record.\n\nProcess handling is handled a bit better compared to before: perf's\nstderr is captured in a temp file and logged after stop, a stop timeout\nescalates to SIGTERM then SIGKILL, and samply only runs if the recording\nexists cleanly.\n\nCo-authored-by: Andrew Erickson \u003caerickson@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326594\n", "files": ["testing/raptor/raptor/browsertime/base.py", "testing/raptor/raptor/perf_profile.py"], "git_node": "33ec18daef35aea53c493c051ee38f7dace8b59e", "git_parents": ["30dd2a71a5e8969d4f73a6844f5f1363384b4aa6"], "node": "0279dd4f0cc4f6107e7095809b94b31ea4d1b457", "parents": ["f3792e398a27eff95a3445f0119d5bf7f1f2760f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054180 - Move the macOS TAR packaging shortcut into configure r=firefox-build-system-reviewers,sergesanspaille\n\nThe `MOZ_PKG_FORMAT=TAR` hack in `./mach repackage-single-locales` that sped up\ndeveloper packaging stopped working once the format moved out of make. There is\nno real way to revive this hack. The only option is to go through configure\nexplicitly, with the right conditions. Developer builds get TAR, release and CI\nbuilds keep DMG, and `MOZ_PKG_FORMAT=DMG` still overrides. It's a behavior change\nrelative to before, but it's probably the closest we can get to matching its intent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326259\n", "files": ["docs/setup/macos_build.md", "python/mozbuild/mozbuild/mach_commands.py", "toolkit/moz.configure"], "git_node": "11096a257ce322a67834e89b372bb6adb99fd61b", "git_parents": ["33ec18daef35aea53c493c051ee38f7dace8b59e"], "node": "2402f562bdabebec2f8e37317d98fe6b37bfab6c", "parents": ["0279dd4f0cc4f6107e7095809b94b31ea4d1b457"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054180 - Fix locale repacks discarding local build changes r=firefox-build-system-reviewers,nalexander\n\n`./mach build installers-\u003clocale\u003e` unpacked a CI package matching the pushhead\nregardless of what the objdir had built, so a developer's local `en-US`\npackage and any uncommitted changes in it were silently ignored.\n\nA build with a compile environment now unpacks its own `en-US` package and\nfails when that package is missing. Setting `MOZ_ARTIFACT_FILE`,\n`MOZ_ARTIFACT_URL`, `MOZ_ARTIFACT_REVISION` or `MOZ_ARTIFACT_TASK` selects\nthat source instead. Objdirs without a compile environment, which covers\nartifact builds and the CI repack tasks, keep downloading the package. A local\npackage, or a file named by `MOZ_ARTIFACT_FILE`, is unpacked with\n`--skip-cache`, since the processed archive is cached under the package name\nand a rebuilt package keeps its name. The repack refuses to run when the en-US\npackage path is also its output path, which `MOZ_SIMPLE_PACKAGE_NAME` makes\ntrue for every locale.\n\n`./mach repackage-single-locales` forces `MOZ_SIMPLE_PACKAGE_NAME`, so `en-US`\nand every locale share one package filename that each repack overwrites in\nplace. It builds the `en-US` package under that name when it is missing,\ncopies it aside once, points `MOZ_ARTIFACT_FILE` at the copy for every locale,\nand moves the copy back when done.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314585\n", "files": ["python/mozbuild/mozbuild/action/l10n_repackage.py", "python/mozbuild/mozbuild/mach_commands.py", "toolkit/locales/l10n.mk"], "git_node": "b5f8617b48e97ccb9ae6dcc2805dfdcf317010f8", "git_parents": ["11096a257ce322a67834e89b372bb6adb99fd61b"], "node": "b144892189dda324bc293a88e6746b840fc00ec3", "parents": ["2402f562bdabebec2f8e37317d98fe6b37bfab6c"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049043 - Add telemetry for VPN location feature. r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326740\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddlewareTest.kt"], "git_node": "00c4095d8d43700f5c87b1720044c5b3554cec7c", "git_parents": ["b5f8617b48e97ccb9ae6dcc2805dfdcf317010f8"], "node": "dd9418c400a7c98dbda6e6217c1c7f76f443e306", "parents": ["b144892189dda324bc293a88e6746b840fc00ec3"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bg/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-dsb/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-en-rGB/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-gl/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hsb/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ia/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-it/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-iw/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nb-rNO/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nn-rNO/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pt-rPT/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ru/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sr/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sv-rSE/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-zh-rTW/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sr/strings.xml"], "git_node": "cdaf0856029bf62d6d17de39f6b34182eea1192b", "git_parents": ["00c4095d8d43700f5c87b1720044c5b3554cec7c"], "node": "b93d761e2b9227bb20f3e146f14bbead2890da43", "parents": ["dd9418c400a7c98dbda6e6217c1c7f76f443e306"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074002 - Dirty frames after measuring reflows for intrinsic sizing. r=TYLin,layout-reviewers\n\nWhat's going on is:\n\n 1. Row sizing of the outer grid needs the block-size contribution of\n    .wrapper, so it does a grid MeasuringReflow of .wrapper. That\n    reflows the whole subtree, so far so good.\n\n 2. The outer grid then reflows .wrapper for real in ReflowInFlowChild.\n    Just constructing that ReflowInput runs nsIFrame::ComputeSize with\n    IApplyAutoMinSize. That goes into intrinsic size computation of\n    the block and eventually of the nested grid, which ends up calling\n    MeasuringReflow on the input with a small column size, leaving it\n    with a 0 content box size and with the dirty bits cleared.\n\n 3. When we actually reflow the block, the block doesn't reflow the\n    input, because it's not dirty, and the block has already been\n    reflowed with the right size.\n\nSo we do need to make sure that the final block reflow ends up reflowing\nthe nested grid again, unfortunately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327979\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/tests/css/css-grid/alignment/grid-align-baseline-nested-intrinsic-sizing-001.html"], "git_node": "f88b762877c752343d567dbadfff0760a1461eee", "git_parents": ["cdaf0856029bf62d6d17de39f6b34182eea1192b"], "node": "e907a6f52a1b7c948b435e18646fba4dfae137f7", "parents": ["b93d761e2b9227bb20f3e146f14bbead2890da43"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064870 - Added class to map playback progress r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327121\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ProgressMapper.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueue.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ProgressMapperTest.kt"], "git_node": "359d77fb0c49f3387fbea69908ae4d30a9c246d8", "git_parents": ["f88b762877c752343d567dbadfff0760a1461eee"], "node": "4d5216592535badef64a33022512c562e3d4f946", "parents": ["e907a6f52a1b7c948b435e18646fba4dfae137f7"], "tags": []}], "date": 1790051623, "git_changesets": ["6654b23b3026d2d53cfa195e3157822f76abc04a", "c25f6b27d7ed72c7f9220013e3ac18fbd43992be", "ccd0da1ef5b0f900068bec3e3855e0089087f190", "d30f3b5126159797e881155e3f717eca962c40a5", "c0240e1a5c97f6e30149544f9df80109ed7aa42c", "123496bd458b2b22b20d3a257c61f3db2fd46f9b", "c623f85bf2c418d63e44981baca686ebbe3021bd", "5de31c5a79f444e78adfe42a911f7d4ebff8a83f", "0d090cfbbe8d7e52b59470d5c704f654785b5762", "2bf8cdeb2095d354ab501c5785518527857e2778", "9a10c492e29988124c15fe97c51a864b720c03e2", "a4f748076f6cee37b10a84d913f9d00ae845565a", "5d8e3b5c1005f98b59bc698e3130c0a1c9c49084", "bc2c73631a14b00df08e989dca4f08e0e2881817", "7133d99bb540dbd073ab21294c88de60031d9b77", "897c709f2d9a6c970a49b48bb16c71a4f8c93263", "c27fe2149791cca4f90abbd0c4fe2b0af0c73aa2", "fd1ac7b16d8c76528e594d00a5f0d7150d850416", "625df5a8304c99f41ec873f77e4c7415aefb9a1d", "3de8bed1c06901ee49f87cc119b4c8e16734801e", "b3668c3b986e0ab41df32e8d3633d1f79432d300", "d9a74ad9e1ae59fa0df05c844563ed0f88c79770", "e3721994177