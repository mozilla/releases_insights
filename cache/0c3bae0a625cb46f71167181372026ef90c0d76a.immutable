590"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009386 - [devtools] Wait for specific mutation counts in browser_markup_pseudo.js r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D293063\n", "files": ["devtools/client/inspector/markup/test/browser_markup_pseudo.js"], "git_node": "111b121a47893de7031eb80e7746c565c9f51f2e", "git_parents": ["08bd8d92171622e4280714f63fec73512d6fa0ea"], "node": "ae55bad4ca3fbb0c282b78048c011ab99ebd627d", "parents": ["a2aacc67f453e0dcbb6c3a1afa069987f0b16d69"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068336 - Add Promise::MaybeSafeResolve and use it for Streams r=mgaudet\" for causing nightly as release bustages on Promise.cpp.\n\nThis reverts commit 7bcd60957cb3d5c08c326ede1b4824880092127c.\n", "files": ["dom/promise/Promise.cpp", "dom/promise/Promise.h", "dom/streams/ReadableByteStreamController.cpp", "dom/streams/ReadableStream.cpp", "dom/streams/ReadableStreamBYOBReader.cpp", "dom/streams/ReadableStreamDefaultController.cpp", "dom/streams/ReadableStreamDefaultReader.cpp", "dom/streams/ReadableStreamTee.cpp", "dom/streams/TransformStream.cpp", "dom/streams/WritableStreamDefaultController.cpp", "js/src/builtin/Promise.cpp", "js/src/builtin/Promise.h", "js/src/jsapi.cpp", "testing/web-platform/meta/streams/readable-byte-streams/patched-global.any.js.ini", "testing/web-platform/meta/streams/transferable/transform-stream.html.ini"], "git_node": "1fb7ef34ce5df5dfaaa6a68d19ec2424ab3935f3", "git_parents": ["111b121a47893de7031eb80e7746c565c9f51f2e"], "node": "3933965e1d5fd6c6e36f50f18dbd51ed071370c7", "parents": ["ae55bad4ca3fbb0c282b78048c011ab99ebd627d"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068585 - Get rid of collections.OrderedDict r=jgraham\n\ndict is ordered since 3.6\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322952\n", "files": ["testing/web-platform/tests/common/security-features/tools/format_spec_src_json.py", "testing/web-platform/tests/common/security-features/tools/generate.py", "testing/web-platform/tests/common/security-features/tools/util.py", "testing/web-platform/tests/import-maps/data-driven/tools/format_json.py", "testing/web-platform/tests/tools/ci/tc/decision.py", "testing/web-platform/tests/tools/ci/tc/taskgraph.py", "testing/web-platform/tests/tools/manifest/XMLParser.py", "testing/web-platform/tests/tools/serve/serve.py", "testing/web-platform/tests/tools/web_features/web_feature_map.py", "testing/web-platform/tests/tools/websocket/h3/headers.py", "testing/web-platform/tests/tools/wpt/testfiles.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/config.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/pytestrunner/runner.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/stability.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_stability.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptcommandline.py", "testing/web-platform/tests/tools/wptserve/wptserve/response.py", "testing/web-platform/tests/tools/wptserve/wptserve/server.py", "testing/web-platform/tests/webdriver/tests/support/keys.py"], "git_node": "7b3b5fd330823988b8e2214912a3884a5df0447d", "git_parents": ["1fb7ef34ce5df5dfaaa6a68d19ec2424ab3935f3"], "node": "64e77afd5ad68b4fc5ab08099b082189e7aee222", "parents": ["3933965e1d5fd6c6e36f50f18dbd51ed071370c7"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070537 - Restore StoreName on marker types that lost it when they were migrated to BaseMarkerType. r=canova\n\n- TimerMarker and AddRemoveTimerMarker, migrated in Bug 2040410\n  (105b050a1ece).\n- LogMarker, migrated in Bug 2022540 (62c1ad5e7db6).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324624\n", "files": ["xpcom/base/Logging.cpp", "xpcom/threads/TimerThread.cpp"], "git_node": "4400b8967ba3a30a753d10c7234c3a76ba760082", "git_parents": ["7b3b5fd330823988b8e2214912a3884a5df0447d"], "node": "f5be6fe05315c8efceeb705757d90807064b6d47", "parents": ["64e77afd5ad68b4fc5ab08099b082189e7aee222"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2068505 - Inject WebExtension content scripts into Thunderbird's mail-message browsers. r=extension-reviewers,robwu DONTBUILD\n\nIsTabOrExtensionBrowser gates content script injection on the top browsing\ncontext's message manager group. Thunderbird's message pane browser moved from\nthe \"single-page\" group to a new \"mail-message\" group in bug 2058761, which was\nnot on the list, so extensions stopped seeing documents loaded there.\n\nThat browser is what feed messages displayed as \"Full Web Page\" load into, so\nadd-ons like uBlock Origin and Dark Reader lost cosmetic filtering, element\npicking and CSS injection in that view.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324888\n", "files": ["toolkit/components/extensions/ExtensionPolicyService.cpp"], "git_node": "869c36aae3f47f36109183149d274db7d7a0bf91", "git_parents": ["4400b8967ba3a30a753d10c7234c3a76ba760082"], "node": "fac2c46e53a4f6d1283ce162e5c66ff3e6447b7b", "parents": ["f5be6fe05315c8efceeb705757d90807064b6d47"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2063316: Add tests for CheckCompatibility and download ping generation. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320428\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "9cb39f05e934d32ed9aa3ef7e1d64a32c6e5a7b6", "git_parents": ["869c36aae3f47f36109183149d274db7d7a0bf91"], "node": "6c9aa24d5657c4f8fee9ae0fe94b3cc8536b0b07", "parents": ["fac2c46e53a4f6d1283ce162e5c66ff3e6447b7b"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070537 - Restore StoreName on marker types that lost it when they were migrated to BaseMarkerType. r=canova\" for causing build bustages @Logging.cpp.\n\nThis reverts commit 4400b8967ba3a30a753d10c7234c3a76ba760082.\n", "files": ["xpcom/base/Logging.cpp", "xpcom/threads/TimerThread.cpp"], "git_node": "88e91522aa4e2ca1a0094055a1d789db16d71b97", "git_parents": ["9cb39f05e934d32ed9aa3ef7e1d64a32c6e5a7b6"], "node": "cd2f8880fafa249490eeae04d58f7edb3aadd739", "parents": ["6c9aa24d5657c4f8fee9ae0fe94b3cc8536b0b07"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063316: Add tests for CheckCompatibility and download ping generation. r=nika\" for causing build bustages @TestDowngradePing.cpp.\n\nThis reverts commit 9cb39f05e934d32ed9aa3ef7e1d64a32c6e5a7b6.\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "3102632a056c5ec04f3a1a6d352eb607893d5ab4", "git_parents": ["88e91522aa4e2ca1a0094055a1d789db16d71b97"], "node": "91c33b5369b5429a2a0643a36735e4cdf94ac556", "parents": ["cd2f8880fafa249490eeae04d58f7edb3aadd739"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068585 - Get rid of collections.OrderedDict r=jgraham\" for casuing wd failures @key_events.py.\n\nThis reverts commit 7b3b5fd330823988b8e2214912a3884a5df0447d.\n", "files": ["testing/web-platform/tests/common/security-features/tools/format_spec_src_json.py", "testing/web-platform/tests/common/security-features/tools/generate.py", "testing/web-platform/tests/common/security-features/tools/util.py", "testing/web-platform/tests/import-maps/data-driven/tools/format_json.py", "testing/web-platform/tests/tools/ci/tc/decision.py", "testing/web-platform/tests/tools/ci/tc/taskgraph.py", "testing/web-platform/tests/tools/manifest/XMLParser.py", "testing/web-platform/tests/tools/serve/serve.py", "testing/web-platform/tests/tools/web_features/web_feature_map.py", "testing/web-platform/tests/tools/websocket/h3/headers.py", "testing/web-platform/tests/tools/wpt/testfiles.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/config.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/pytestrunner/runner.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/stability.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_stability.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptcommandline.py", "testing/web-platform/tests/tools/wptserve/wptserve/response.py", "testing/web-platform/tests/tools/wptserve/wptserve/server.py", "testing/web-platform/tests/webdriver/tests/support/keys.py"], "git_node": "1059428cb6431d07d76250f95576b2728ae45dab", "git_parents": ["3102632a056c5ec04f3a1a6d352eb607893d5ab4"], "node": "362169331eae5d069f2855b0691c9c04badbb5ea", "parents": ["91c33b5369b5429a2a0643a36735e4cdf94ac556"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2063658 - [devtools] Only set cors disabling headers for network overrides. r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324090\n", "files": ["devtools/shared/network-observer/NetworkObserver.sys.mjs", "devtools/shared/network-observer/NetworkOverride.sys.mjs"], "git_node": "6da54da69ef12604319984a7126d6f05a040122f", "git_parents": ["1059428cb6431d07d76250f95576b2728ae45dab"], "node": "4abf557ddd92662ee040be6993b4da9347cd726f", "parents": ["362169331eae5d069f2855b0691c9c04badbb5ea"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2063658 - [devtools] Assert that local mode requests are blocked by CORS. r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324091\n", "files": ["devtools/shared/network-observer/test/browser/browser_networkobserver_localMode.js"], "git_node": "dc61551c7e36ae1035c48f4426c07850e35afbeb", "git_parents": ["6da54da69ef12604319984a7126d6f05a040122f"], "node": "3c354be73c33e045771fd219534463420f089b45", "parents": ["4abf557ddd92662ee040be6993b4da9347cd726f"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2066432 - [devtools] Only toggle watchedByDevTools when DevTools are opened. r=devtools-reviewers,farre,nchevobbe\n\nAlways allow toggling DevTools from the content process,\nbut check if DevTools are active in the parent process\nand reject the update if they aren't.\n\nDo that, until we are able to only toggle this flag from the parent\nprocess.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321346\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-slow-script.js", "docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/test/browser/browser.toml", "docshell/test/browser/browser_watchedByDevTools_canset.js"], "git_node": "3f452d6ad12ad23c923b8c9a304739adbb9f8f4f", "git_parents": ["dc61551c7e36ae1035c48f4426c07850e35afbeb"], "node": "f0b66ed64e81c964b9881493c570b448aee0a0a9", "parents": ["3c354be73c33e045771fd219534463420f089b45"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2066552 - [devtools] Keep watchedByDevTools flag enabled on cross group navigations. r=dom-core-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321347\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/test/browser/WatchedByDevToolsTestChild.sys.mjs", "docshell/test/browser/browser.toml", "docshell/test/browser/browser_watchedByDevTools.js"], "git_node": "613e9969b933e6f9e2194efd83481cf2119ec38d", "git_parents": ["3f452d6ad12ad23c923b8c9a304739adbb9f8f4f"], "node": "07dad8e98faeb78c092d696473abf2d57f6dd20e", "parents": ["f0b66ed64e81c964b9881493c570b448aee0a0a9"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2066868 - [devtools] Ensure preserving sourceActor when selecting another location in the same source. r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321593\n", "files": ["devtools/client/debugger/src/actions/breakpoints/index.js", "devtools/client/debugger/src/actions/pause/continueToHere.js", "devtools/client/debugger/src/components/Editor/FileSearch.js", "devtools/client/debugger/src/components/Editor/index.js"], "git_node": "4ec5f6c24d3ec258c8426a07ccf02cd2eaedcf0d", "git_parents": ["613e9969b933e6f9e2194efd83481cf2119ec38d"], "node": "5c0754b71ab447270fa7589951570f1c0ecdb66f", "parents": ["07dad8e98faeb78c092d696473abf2d57f6dd20e"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2066868 - [devtools] Avoid selecting the source in helpers asserting breakable lines/columns. r=devtools-reviewers,bomsy\n\nThis will help select a precise source actor. Also the file argument\nwasn't so useful in assertLineIsBreakable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322565\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-inline-script-offset.js", "devtools/client/debugger/test/mochitest/browser_dbg-pretty-print-inline-scripts.js", "devtools/client/debugger/test/mochitest/head.js", "devtools/client/debugger/test/mochitest/integration/browser_dbg-features-breakable-lines.js", "devtools/client/debugger/test/mochitest/integration/browser_dbg-features-breakable-positions.js", "devtools/client/debugger/test/mochitest/integration/browser_dbg-features-wasm.js", "devtools/client/debugger/test/mochitest/shared-head.js"], "git_node": "bc3887eb4e1e4f0b010ed33c3804a3baf57805c1", "git_parents": ["4ec5f6c24d3ec258c8426a07ccf02cd2eaedcf0d"], "node": "de7fc90b1b7a7de9a11cc14a9b3bfd4ae818e692", "parents": ["5c0754b71ab447270fa7589951570f1c0ecdb66f"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2066868 - [devtools] Improve breakable lines/columns when having many script instances with the same URL. r=devtools-reviewers,bomsy\n\nColumn breakpoints are now collected per \"actual\" source.\n\"Source objects\" are unique per URL, so that we may have various\ninstance of it in distinct threads, or multiple evaluations of it.\n\nColumn breakpoints (aka breakpoint positions) are moved to source actors\nas they are now keyed by \"source key\".\nSource key is a conbination of:\n* original source id (if that's about an original source)\n* then either:\n  * many source actors if that's about an HTML page with many inline\n    \u003cscript\u003e's\n  * or a unique source actor. It help differentiate the possible\n    multiple evaluation (same or distinct threads).\n\nColumn breakpoint is now based on the location rather than the only the source.\nLocation may specify a precise source actor, which help display the\nexact data related to the precise source instance being displayed.\n\nThis helps show the exact information if the multiple evaluations\nof the source have different breakpoints.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321594\n", "files": ["devtools/client/debugger/src/actions/breakpoints/breakpointPositions.js", "devtools/client/debugger/src/actions/breakpoints/modify.js", "devtools/client/debugger/src/actions/sources/breakableLines.js", "devtools/client/debugger/src/actions/sources/prettyPrint.js", "devtools/client/debugger/src/actions/sources/removeSources.js", "devtools/client/debugger/src/reducers/source-actors.js", "devtools/client/debugger/src/reducers/sources.js", "devtools/client/debugger/src/selectors/breakpointAtLocation.js", "devtools/client/debugger/src/selectors/source-actors.js", "devtools/client/debugger/src/selectors/sources.js", "devtools/client/debugger/src/selectors/visibleColumnBreakpoints.js", "devtools/client/debugger/src/utils/dbg.js", "devtools/client/debugger/test/mochitest/browser_dbg-reducer-cleanup-on-target-removal.js", "devtools/client/debugger/test/mochitest/browser_dbg-sources-with-many-actors.js", "devtools/client/debugger/test/mochitest/browser_gp.toml", "devtools/client/debugger/test/mochitest/integration/browser_dbg-features-breakable-positions.js", "devtools/client/debugger/test/mochitest/shared-head.js"], "git_node": "7f3e83872fd2a9fd16ce92c8d35468b6c4b29999", "git_parents": ["bc3887eb4e1e4f0b010ed33c3804a3baf57805c1"], "node": "e9c8c431cde4978e72afc4ad54158a733e0a8625", "parents": ["de7fc90b1b7a7de9a11cc14a9b3bfd4ae818e692"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2063316: Add tests for CheckCompatibility and download ping generation. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320428\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "82d5ddd137dc3f1e61d3bf0935eaadebe29c007a", "git_parents": ["7f3e83872fd2a9fd16ce92c8d35468b6c4b29999"], "node": "02c9910cd9f675f468df29d9192c254b448171e0", "parents": ["e9c8c431cde4978e72afc4ad54158a733e0a8625"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070805 - Null-check the root pres context and the window renderer in nsXULPopupManager::PaintPopups (Coverity CID 1696739) r=emilio,layout-reviewers\n\nframe-\u003ePresContext()-\u003eGetRootPresContext() can return null for a popup that is\nstill in the menu chain. Bug 1876009 was a real crash from exactly that, in\nRemoveMenuChainItem in this file: an open popup's pres shell gets destroyed, the\npopup is still in the chain when its root pres context is requested, and the\nfix was to null-check it. Every other caller here and in nsMenuPopupFrame.cpp\nguards it; PaintPopups did not.\n\nAlso guard nsIWidget::GetWindowRenderer(). It deliberately returns null once\nmShutdownObserver is gone, so that a LayerManager is not re-created during\nshutdown, and renderer-\u003eAsFallback() derefs it unconditionally. No CID covers\nthat one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324885\n", "files": ["layout/xul/nsXULPopupManager.cpp"], "git_node": "b25967cc727b721abf8053a49091ee5f8d840750", "git_parents": ["82d5ddd137dc3f1e61d3bf0935eaadebe29c007a"], "node": "a770ef020b06c41a3a604d552ac674e6fb7f61b7", "parents": ["02c9910cd9f675f468df29d9192c254b448171e0"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070682 - Disable html/syntax/parsing/adoption-agency-reparenting-shadow-cycle.html to avoid crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324901\n", "files": ["testing/web-platform/meta/html/syntax/parsing/adoption-agency-reparenting-shadow-cycle.html.ini"], "git_node": "5666cb8620a20110a557f5980e361c6d53863e77", "git_parents": ["b25967cc727b721abf8053a49091ee5f8d840750"], "node": "ee3d0a1a7caf7c443c57bdb007662a59d7f3ae2e", "parents": ["a770ef020b06c41a3a604d552ac674e6fb7f61b7"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068957 - Remove the Legacy Telemetry mirrors of the ServiceWorker probes. r=dom-worker-reviewers,TravisLong,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323256\n", "files": ["dom/serviceworkers/docs/telemetry.md", "dom/serviceworkers/metrics.yaml", "dom/workers/metrics.yaml", "dom/workers/test/browser_serviceworker_fetch_new_process.js", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "a0108faa89f5864acc0f28ee7a873f038198ec42", "git_parents": ["5666cb8620a20110a557f5980e361c6d53863e77"], "node": "7e111c2e3b88afce989e73e8086d195db037a198", "parents": ["ee3d0a1a7caf7c443c57bdb007662a59d7f3ae2e"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068957 - Remove the Legacy Telemetry mirrors of the Worker probes. r=dom-worker-reviewers,TravisLong,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323257\n", "files": ["dom/workers/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "2a9283583b78362f46705ba2c8d7b80407b0b377", "git_parents": ["a0108faa89f5864acc0f28ee7a873f038198ec42"], "node": "62f399a0077f317c29cfabe90d5ed612877e2074", "parents": ["7e111c2e3b88afce989e73e8086d195db037a198"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070108 - Record every Primary Password prompt with its result r=credential-management-reviewers,dimi\n\nThe only prompt-related probe so far is pwmgr.reauthenticate_master_password.\nIt is built by LoginHelper.requestReauth() and recorded by its callers, so it\nonly covers the explicit re-authentication gate, and only where the caller\nbothers to record the event it gets back. The prompts that come out of the\nstorage back-ends, which is where most of them happen, are not measured at\nall: neither crypto-SDR nor the Rust store's PrimaryPasswordAuthenticator\nrecord anything.\n\nAdd pwmgr.primary_password_prompt, recorded at all three places that can put\nthe dialog on screen, with a `source` telling them apart and the result of the\nprompt. reauthenticate_master_password is left alone.\n\nThe Rust key manager asks getPrimaryPassword() for a new password after a wrong\none, so each of its dialogs is recorded separately, including the wrong_password\nattempts. NSS re-prompts internally on the other two paths, so a single event\nthere can stand for several dialogs; the metric description spells that out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324586\n", "files": ["browser/components/aboutlogins/tests/browser/browser_primaryPassword.js", "toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/components/passwordmgr/crypto-SDR.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_rust_storage_primary_password.js", "toolkit/components/passwordmgr/test/unit/test_crypto_SDR_primary_password.js", "toolkit/components/passwordmgr/test/unit/xpcshell.toml"], "git_node": "b8c8ba90e9c3fb5596550cae8b368b76888178aa", "git_parents": ["2a9283583b78362f46705ba2c8d7b80407b0b377"], "node": "82718736888557a9c1e863318fe69b0d2ed5de35", "parents": ["62f399a0077f317c29cfabe90d5ed612877e2074"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070108 - Do not record a re-authentication event that does not exist r=credential-management-reviewers,mtigley\n\nLoginHelper.requestReauth() returns without a `telemetryEvent` when it gives\nup because a primary password prompt is already open. Two of its callers\ndestructure that value unconditionally and throw a TypeError instead of\nexporting the passwords, in about:logins and in the contextual password\nmanager.\n\nMove the recording into LoginHelper next to requestReauth(), where it can skip\nthe missing event, and use it from both callers.\n\nNo test: reproducing this needs a second primary password prompt to be open at\nthe moment the export is started.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324587\n", "files": ["browser/components/aboutlogins/AboutLoginsParent.sys.mjs", "toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/components/satchel/megalist/aggregator/datasources/LoginDataSource.sys.mjs"], "git_node": "76334a3ebd90f5728755dd32467ca0ab6496a17d", "git_parents": ["b8c8ba90e9c3fb5596550cae8b368b76888178aa"], "node": "8518f4c3c8ad8ea6e0120d569ec5656b6191c91b", "parents": ["82718736888557a9c1e863318fe69b0d2ed5de35"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069925 - Apply response headers before handling redirects in HandleOverrideResponse r=necko-reviewers,valentin,webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324631\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/browser/browser_set_response_override.js", "testing/web-platform/tests/webdriver/tests/bidi/network/provide_response/cookies.py"], "git_node": "8b29b563e4cdc4e01e4d7b155fbdd2373c6244e5", "git_parents": ["76334a3ebd90f5728755dd32467ca0ab6496a17d"], "node": "b31f98083b23b53b710fa4afed4388a824682ec0", "parents": ["8518f4c3c8ad8ea6e0120d569ec5656b6191c91b"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2069928 - style(webgpu): run `cargo fmt` on `wgpu_bindings` r=webgpu-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324571\n", "files": ["gfx/wgpu_bindings/src/lib.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "d9e39d91f400ef8c8a7a3c3d35c307aa3666d3b5", "git_parents": ["8b29b563e4cdc4e01e4d7b155fbdd2373c6244e5"], "node": "70e17544048f20826bd746d297f046d092972459", "parents": ["b31f98083b23b53b710fa4afed4388a824682ec0"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2070300 - [remote] Throw \"NavigationError\" instead of a plain \"Error\" in ProgressListener. r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324385\n", "files": ["remote/shared/Navigate.sys.mjs", "remote/shared/RemoteError.sys.mjs", "remote/shared/test/xpcshell/test_Navigate.js", "remote/shared/test/xpcshell/test_RemoteError.js", "remote/shared/test/xpcshell/xpcshell.toml"], "git_node": "7cadebb85c004d528424beae3b12cef44bd516b2", "git_parents": ["d9e39d91f400ef8c8a7a3c3d35c307aa3666d3b5"], "node": "c667968a3ec36e2c37660bed1bfc87904c15c051", "parents": ["70e17544048f20826bd746d297f046d092972459"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063316: Add tests for CheckCompatibility and download ping generation. r=nika\" for causing build bustages @TestDowngradePing.cpp.\n\nThis reverts commit 82d5ddd137dc3f1e61d3bf0935eaadebe29c007a.\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "18c5302930120e291f9a05a2174f60ea432fb57f", "git_parents": ["7cadebb85c004d528424beae3b12cef44bd516b2"], "node": "bf1c77e6b236bfb7c5fa3b62a3aa4730ff7a403e", "parents": ["c667968a3ec36e2c37660bed1bfc87904c15c051"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069948 - Make cookieStore.delete() remove only the cookie it targets r=valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324620\n", "files": ["dom/cookiestore/CookieStoreParent.cpp", "testing/web-platform/tests/cookiestore/cookieStore_delete_domain.sub.https.html", "testing/web-platform/tests/cookiestore/resources/delete_domain-child.sub.https.html", "testing/web-platform/tests/cookiestore/resources/domain_parsing-child.sub.https.html", "testing/web-platform/tests/cookiestore/serviceworker_cookieStore_cross_origin.https.sub.html"], "git_node": "7161736d20c250f4dfa8304c34b429ca7e602103", "git_parents": ["18c5302930120e291f9a05a2174f60ea432fb57f"], "node": "4fee2888621eb86832222bd98aebcce3214525ad", "parents": ["bf1c77e6b236bfb7c5fa3b62a3aa4730ff7a403e"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 1: Port module initialization in _schedulePerWindowIdleTasks to use category-manager invocation r=Gijs,frontend-codestyle-reviewers,mossop\n\nMove the per-window idle inits in gBrowserInit._schedulePerWindowIdleTasks to a\nnew browser-window-idle-tasks category, continuing Bug 2036714, Bug 2039199 and\nBug 2045665. The category is invoked with idleDispatch: true.\n\ncallModulesFromCategory now drops a consumer when its jsGlobal is a window that\nhas closed by the time the idle task runs. Without this, a window that closes\nbefore its idle inits run gets re-initialized after its unload teardown and\nleaks (browser_windowclose.js / browser_tabdetach.js).\n\nTeardown moves to the browser-window-unload categories, and the download init\nmoves into DownloadsCommon.initializeForWindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310625\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/base/content/test/general/browser_gestureSupport.js", "browser/components/BrowserComponents.manifest", "browser/components/downloads/DownloadsCommon.sys.mjs", "browser/docs/BrowserStartup.md", "browser/modules/test/browser/browser_taskbar_preview.js", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js"], "git_node": "a3a4a9698dff6aea11e9c0a1c8e91c945cd52bce", "git_parents": ["7161736d20c250f4dfa8304c34b429ca7e602103"], "node": "52645354f47a4eb35652d47d74074a5a0e027285", "parents": ["4fee2888621eb86832222bd98aebcce3214525ad"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 2: Allowlist the pre-existing urlbar focus-ring startup flicker exposed by the idle-task port r=Gijs\n\nInvoking browser-window-idle-tasks with idleDispatch changes when\nbrowser-startup-idle-tasks-finished fires, so the urlbar focus-ring settle now\nsometimes lands inside the window that browser_startup_flicker.js records. The\nflicker is pre-existing and intermittent (~15% on linux debug); add a targeted\nallowlist entry matching the urlbar box, and track removal in a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321518\n", "files": ["browser/base/content/test/performance/browser_startup_flicker.js"], "git_node": "6b51d23be04ea7d1c4395c5a988e8eb2cbafe8e0", "git_parents": ["a3a4a9698dff6aea11e9c0a1c8e91c945cd52bce"], "node": "4b6ee35a968017aebc7c510fcef29a9335a0efcf", "parents": ["52645354f47a4eb35652d47d74074a5a0e027285"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 3: Expose nsIFOG.initialized and wait for it before reading Glean in marionette tests r=search-reviewers,sclements,janerik,jteow\n\ntest_ping_submitted and test_new_tab_on_restore read Glean metrics as soon as\nthe browser reports itself started up. That signal\n(browser-idle-startup-tasks-finished, which is what Marionette waits on) says\nnothing about FOG, which is initialized from a startup idle task, so the read\ncan land while Glean is still pre-init.\n\nThat is not a slow read, it is an unrecoverable hang: block_on_dispatcher posts\nits barrier to the unbounded queue while the dispatcher worker is still parked\non the pre-init channel, and the queue is only flushed by initializeFOG, which\nneeds the main thread. So a blocking Glean read from the main thread in that\nwindow deadlocks the browser, with no crash and no stack.\n\nThe race itself is pre-existing: FOG is initialized by StartupTelemetry's\nbrowser-idle-startup consumer, behind awaits on UsageReporting and\nTelemetryReportingPolicy, so it could always finish after the notification.\nPart 1 is what makes it reproduce. Porting _schedulePerWindowIdleTasks to\ncategory-manager invocation replaces window.requestIdleCallback with\nChromeUtils.idleDispatch, so the per-window tasks and the notification that\nfollows them move off the window's idle callback list and onto the\nthread-level idle queue that browser-idle-startup already uses. That changes\nwhen the notification fires relative to initializeFOG, and the tests started\nhanging instead of racing benignly.\n\nExpose whether initializeFOG has been called, and wait for it before each read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323262\n", "files": ["browser/components/search/test/marionette/telemetry/test_ping_submitted.py", "browser/components/sessionstore/test/marionette/test_new_tab_on_restore.py", "toolkit/components/glean/xpcom/FOG.cpp", "toolkit/components/glean/xpcom/nsIFOG.idl"], "git_node": "6a75c302a4fee918e17fbd0cbac473ff82a23b74", "git_parents": ["6b51d23be04ea7d1c4395c5a988e8eb2cbafe8e0"], "node": "ca44054fb54cbe60f7fb52c66e843f1085687518", "parents": ["4b6ee35a968017aebc7c510fcef29a9335a0efcf"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 4: Wait for FOG init before reading Glean in the startup_about_home_paint talos addon r=perftest-reviewers,sparky\n\nThe addon reads its Glean metric as soon as browser-idle-startup-tasks-finished\nfires. That notification says nothing about FOG, which is initialized by a\nseparate startup idle task, so the read can land before initializeFOG has run.\nA blocking Glean read that early does not return nothing, it deadlocks the main\nthread. The browser then sits in startup_about_home_paint cycle 1/20 until the\ntask is killed, with no crash and no stack. The race is pre-existing, but Part 1\nmakes it reliable: it moves the notification onto the thread-level idle queue,\nwhich puts it ahead of initializeFOG.\n\nWait on nsIFOG.initialized from Part 3 before the read; recording is buffered,\nso the measurement survives. Bounded at 15s, half the outputTimeout ffsetup\ngives the warmup run that also loads this addon, and gives up with\nTEST-UNEXPECTED-FAIL rather than burning the task. The cached and\nrealworld_webextensions suites share the addon and are fixed too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324617\n", "files": ["testing/talos/talos/startup_test/startup_about_home_paint/addon/api.js"], "git_node": "4e48c28beb126815d9564d2670bd82603a06c3c3", "git_parents": ["6a75c302a4fee918e17fbd0cbac473ff82a23b74"], "node": "7c398108943d882b3ce40ca8655a4bbd23225f92", "parents": ["ca44054fb54cbe60f7fb52c66e843f1085687518"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069100 - [devtools] Ignore getGridFragments errors if gridFront/nodeFront is destroyed r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324892\n", "files": ["devtools/client/inspector/grids/grid-inspector.js"], "git_node": "eedef57a61e1c7d65215b1a9d4a7f23ee8af095d", "git_parents": ["4e48c28beb126815d9564d2670bd82603a06c3c3"], "node": "6c701e21858909b2fccae21dc2669cce29fab213", "parents": ["7c398108943d882b3ce40ca8655a4bbd23225f92"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015089 - Post the visual viewport's scroll and scrollend events exactly once. r=emilio\n\nVisualViewportScrollEvent's constructor posted itself to the pres shell, and so\ndid the constructor of its base class VisualViewportScrollEndEvent, so every\nvisual viewport scroll event landed in the pending scroll events twice. The\nduplicate is harmless today only because firing the first copy revokes the\nevent. Post from PostScrollEvent()/PostScrollEndEvent() instead, once per\nevent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324809\n", "files": ["dom/base/VisualViewport.cpp"], "git_node": "3f2e441d843b199bbdb5ff2d6455772231ca9561", "git_parents": ["eedef57a61e1c7d65215b1a9d4a7f23ee8af095d"], "node": "d32a6bfe0aa261cc0930105fbe98e7464b3d492c", "parents": ["6c701e21858909b2fccae21dc2669cce29fab213"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2063316: Add tests for CheckCompatibility and download ping generation. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320428\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "02eb3b39c996ebcdfde221060349785955af59c0", "git_parents": ["3f2e441d843b199bbdb5ff2d6455772231ca9561"], "node": "dbecd3873c5624bada6b2b4aa8b27368b9ed84d5", "parents": ["d32a6bfe0aa261cc0930105fbe98e7464b3d492c"], "tags": []}, {"author": "Antoine Quint \u003cgraouts@apple.com\u003e", "branch": "default", "desc": "Bug 2068737 [wpt PR 62351] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322936, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=322936 (#62351)\n--\n\nwpt-commits: b1a7025f8bc16454e18604c9e195038aa5cf1d94\nwpt-pr: 62351\n", "files": ["testing/web-platform/tests/web-animations/timing-model/animations/playing-an-animation.html"], "git_node": "41f459c084a948bd365c1bb4fa86dad302585bd4", "git_parents": ["02eb3b39c996ebcdfde221060349785955af59c0"], "node": "281f6c592ac84a737c17f257f0790efaea85167e", "parents": ["dbecd3873c5624bada6b2b4aa8b27368b9ed84d5"], "tags": []}, {"author": "Manuel Rego Casasnovas \u003crego@igalia.com\u003e", "branch": "default", "desc": "Bug 1773982 [wpt PR 34396] - Add new tests to check that thresholds is FrozenArray, a=testonly\n\nAutomatic update from web-platform-tests\nAdd new tests to check that thresholds is FrozenArray\n\nFixes https://github.com/w3c/IntersectionObserver/issues/162\n\n--\n\nwpt-commits: 7addae03195ff8f409cac611bf46351131d320f0\nwpt-pr: 34396\n", "files": ["testing/web-platform/tests/intersection-observer/thresholds-frozen-array.html"], "git_node": "7e3bc40a2215d482c55c2636311235ae31530f00", "git_parents": ["41f459c084a948bd365c1bb4fa86dad302585bd4"], "node": "8feb52b516800723fee282c70af588bbeb525d8d", "parents": ["281f6c592ac84a737c17f257f0790efaea85167e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 1773982 [wpt PR 34396] - Update wpt metadata, a=testonly\n\nwpt-pr: 34396\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/intersection-observer/thresholds-frozen-array.html.ini"], "git_node": "5ee75e1bdab1d7b1f601a2001caeaec7123fbb25", "git_parents": ["7e3bc40a2215d482c55c2636311235ae31530f00"], "node": "b824d021f726a6a5af8ab087db34ea6e35b6c812", "parents": ["8feb52b516800723fee282c70af588bbeb525d8d"], "tags": []}, {"author": "Christopher Cameron \u003cccameron@google.com\u003e", "branch": "default", "desc": "Bug 2068933 [wpt PR 62380] - Add parameterized toBlob color conversion WPT test, a=testonly\n\nAutomatic update from web-platform-tests\nAdd parameterized toBlob color conversion WPT test\n\nUse the same parameter set and test pattern as the getImageData tests.\n\nRemove individual redundant toBlob tests superseded by this unified\ntest.\n\nTAG=agy\nCONV=3da4bac4-8ad7-46e9-969f-5aa84b7a5620\n\nBug: 454152417\nChange-Id: I170424c0de4c318d5528efc957795903cc63cc6d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8312949\nCommit-Queue: ccameron chromium \u003cccameron@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690326}\n\n--\n\nwpt-commits: 13a6aa64b41cdbac83569ba7665f3a81e658fc4d\nwpt-pr: 62380\n", "files": ["testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.p3.canvas.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.with.putImageData.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.toBlob.convert.html", "testing/web-platform/tests/html/canvas/tools/yaml/color_space.yaml"], "git_node": "8c9f67eea9c6f465f90f7585da5b1484aae35a23", "git_parents": ["5ee75e1bdab1d7b1f601a2001caeaec7123fbb25"], "node": "4578364499aac8669980a010efc6648456c61b31", "parents": ["b824d021f726a6a5af8ab087db34ea6e35b6c812"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068933 [wpt PR 62380] - Update wpt metadata, a=testonly\n\nwpt-pr: 62380\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.p3.canvas.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toBlob.with.putImageData.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.toBlob.convert.html.ini"], "git_node": "f2e596b815db6885d8f33ee85d811c01fae98337", "git_parents": ["8c9f67eea9c6f465f90f7585da5b1484aae35a23"], "node": "6ef86656cddd0f5199125a77159e7f2a4cdb482d", "parents": ["4578364499aac8669980a010efc6648456c61b31"], "tags": []}, {"author": "Koji Ishii \u003ckojii@chromium.org\u003e", "branch": "default", "desc": "Bug 2068935 [wpt PR 62378] - Disable the `FirstLineTextMetrics` runtime flag, a=testonly\n\nAutomatic update from web-platform-tests\nDisable the `FirstLineTextMetrics` runtime flag\n\nThis runtime flag was introduced by crrev.com/c/6792103 to\nmatch CSS2 and Gecko. But discussion[1] discovered that the\nspec was changed to match old Blink (before the flag) and\nWebKit[2][3].\n\nThis patch disables the flag to match the current spec and\nWebKit.\n\nThe flag was enabled one year ago, and no regressions were\nreported so far.\n\nAdjusted `first-line-line-height-002` test to match the\ncurrent spec. This test was added to help interop of the old\nbehavior by [4].\n\n`first-line-line-height-003` added by the CL above was\nremoved, as `002` covers the behavior.\n\n[1]: https://github.com/web-platform-tests/wpt/pull/62271\n[2]: https://github.com/w3c/csswg-drafts/issues/2282\n[3]: https://github.com/w3c/csswg-drafts/issues/1384\n[4]: https://bugzilla.mozilla.org/show_bug.cgi?id=1742586\n\nBug: 41362700, 548482066\nChange-Id: I06dec00a9d9f823f394bdc7bbd22c6d8c2e6bb50\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8315592\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690441}\n\n--\n\nwpt-commits: 05fffeacb7c7d7bdafac267ff3946f2f923a737a\nwpt-pr: 62378\n", "files": ["testing/web-platform/tests/css/css-pseudo/first-line-line-height-002-ref.html", "testing/web-platform/tests/css/css-pseudo/first-line-line-height-003-ref.html", "testing/web-platform/tests/css/css-pseudo/first-line-line-height-003.html"], "git_node": "b5ca4cf7efe07dab4667bb98eea16d4e024e423d", "git_parents": ["f2e596b815db6885d8f33ee85d811c01fae98337"], "node": "4c936022cf807456200c20fa6c177d1273ccb156", "parents": ["6ef86656cddd0f5199125a77159e7f2a4cdb482d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068935 [wpt PR 62378] - Update wpt metadata, a=testonly\n\nwpt-pr: 62378\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-pseudo/first-line-line-height-002.html.ini"], "git_node": "86ce923b39491009a5f3b4f99097fef6df3380c5", "git_parents": ["b5ca4cf7efe07dab4667bb98eea16d4e024e423d"], "node": "5908e008a1746547b9bfa51ee7c5cc39f20a321d", "parents": ["4c936022cf807456200c20fa6c177d1273ccb156"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2068938 [wpt PR 62388] - Add tests for the origin of documents created by the parsing APIs, a=testonly\n\nAutomatic update from web-platform-tests\nAdd tests for the origin of documents created by the parsing APIs\n\ndocument.domain is the only way to directly observe the origin of a document\nwithout a browsing context, and it was untested for these APIs.\n\nFor https://github.com/whatwg/html/pull/12881\n\n--\n\nwpt-commits: 7b4baa3afff1c313269dd778c47ce1eeb93f2c61\nwpt-pr: 62388\n", "files": ["testing/web-platform/tests/domparsing/parsed-document-origin.window.js"], "git_node": "d5872149be4a7706375cf7858f66ddf1446dbe88", "git_parents": ["86ce923b39491009a5f3b4f99097fef6df3380c5"], "node": "12b897f1dd3b2956cf2131ba038a436083adb84c", "parents": ["5908e008a1746547b9bfa51ee7c5cc39f20a321d"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2061557 [wpt PR 61789] - Fix malformed markup in CSS WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nFix malformed markup in CSS WPTs (#61789)\n\nCorrect mismatched closing tags and a misspelled link element in CSS and\nforced-colors WPTs. This restores the intended DOM structure without\nchanging the tests' coverage.\n\nBug: 542686202\nChange-Id: I73d6234d78564185fee66b8913636c91ed8e61ac\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8200955\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Munira Tursunova \u003cmoonira@google.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1675033}\n\nCo-authored-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\n--\n\nwpt-commits: a6218de354fb805968c13f8f825ca536acc0d438\nwpt-pr: 61789\n", "files": ["testing/web-platform/tests/css/css-cascade/all-prop-initial-visited-ref.html", "testing/web-platform/tests/css/css-cascade/layer-slotted-rule.html", "testing/web-platform/tests/css/css-color/system-color-consistency.html", "testing/web-platform/tests/css/css-fonts/animations/font-size-adjust-interpolation.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/auto-margins-ignored-during-track-sizing-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/references/auto-margins-ignored-during-track-sizing-001-ref.html", "testing/web-platform/tests/css/css-multicol/nested-past-fragmentation-line.html", "testing/web-platform/tests/css/css-size-adjust/animations/text-size-adjust-interpolation.html", "testing/web-platform/tests/css/css-sizing/aspect-ratio/replaced-element-002.html", "testing/web-platform/tests/css/css-tables/tentative/paint/overflow-hidden-table-ref.html", "testing/web-platform/tests/css/css-values/attr-style-sharing-2.html", "testing/web-platform/tests/css/css-view-transitions/nested/normal-goes-up.tentative.html", "testing/web-platform/tests/css/css-writing-modes/float-vlr-014.html", "testing/web-platform/tests/css/css-writing-modes/wm-propagation-body-contain-root-ref.html", "testing/web-platform/tests/css/cssom/cssstyledeclaration-mutability.html", "testing/web-platform/tests/forced-colors-mode/forced-colors-mode-43-ref.html", "testing/web-platform/tests/forced-colors-mode/forced-colors-mode-43.html", "testing/web-platform/tests/forced-colors-mode/forced-colors-mode-45-ref.html", "testing/web-platform/tests/forced-colors-mode/forced-colors-mode-45.html"], "git_node": "3d88f4dd9c220b711d4abad8a4456c233f2fc2e9", "git_parents": ["d5872149be4a7706375cf7858f66ddf1446dbe88"], "node": "bd18061d3977a53da0fab9c2cbbe3912c17c6f31", "parents": ["12b897f1dd3b2956cf2131ba038a436083adb84c"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2061154 [wpt PR 61781] - Fix mismatched tags in inert WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nFix mismatched tags in inert WPTs (#61781)\n\nCorrect mismatched closing tags in inert focus tests so their containers\nhave the intended DOM structure. This exposes obsolete Chromium-specific\nBlink plugin elements that are no longer focusable after inertness is\nremoved. Remove those non-portable elements while retaining coverage\nthrough standard focusable HTML controls.\n\nBug: 542686202\nChange-Id: I61b14405d06423459f8601ccbf1f17c77a55e82b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8197604\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1675028}\n\nCo-authored-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\n--\n\nwpt-commits: 0fa3a989dc092fbac8b93653b0cbad492e685187\nwpt-pr: 61781\n", "files": ["testing/web-platform/tests/html/semantics/interactive-elements/the-dialog-element/inert-node-is-unfocusable.html", "testing/web-platform/tests/inert/inert-iframe-tabbing.html", "testing/web-platform/tests/inert/inert-node-is-unfocusable.html"], "git_node": "22172a678cafb50c91d3728bdb3892df5a3d10c3", "git_parents": ["3d88f4dd9c220b711d4abad8a4456c233f2fc2e9"], "node": "3d7cf48c916605938d64b1e18fc4d037150fc487", "parents": ["bd18061d3977a53da0fab9c2cbbe3912c17c6f31"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2058769 [wpt PR 61589] - Add DownloadObserver to Semantic Embedder, a=testonly\n\nAutomatic update from web-platform-tests\nAdd DownloadObserver to Semantic Embedder (#61589)\n\nThis CL implements the DownloadObserver and on-demand downloading\nfor the Semantic Embedder API.\n\nKey changes:\n\n1. Download Progress Observer: Connects the Blink CreateMonitor down\n   through the AIManager Mojo interface to the\n   AISemanticEmbedderServiceLauncher, allowing the web page to track\n   component download progress.\n\n2. On-Demand Downloading: Removes the unconditional startup\n   registration of the AI Embeddings Component. The component is now\n   dynamically registered and downloaded on-demand only when a website\n   explicitly calls SemanticEmbedder.create().\n\n3. Background Download Resumption: Introduces the\n   prefs::kIsAIEmbeddingsDownloadEligible local state preference.\n   Once a user initiates a download, this pref ensures the component\n   is registered on subsequent browser startups, allowing the\n   Component Update Service to automatically resume and finish the\n   download in the background.\n\n4. Robust Error Handling: Updates the on-demand update callback to\n   properly propagate update_client::Error codes. If a download\n   fails, the error is caught and Javascript promises are immediately\n   rejected, preventing hangs.\n\n5. WPT Timeout Fixes: Rewrites testCreateMonitorWithAbortAt in util.js\n   to trigger based on event counts rather than brittle hardcoded mock\n   byte values.\n\nBug: 428233906\nChange-Id: I9bfe293f33a47263e7a534ce2bfc7fa4119bb936\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8092081\nReviewed-by: Jingyun Liu \u003cjingyun@google.com\u003e\nReviewed-by: Noah Rose Ledesma \u003cnoahrose@google.com\u003e\nCommit-Queue: Ian Zhao \u003cyinguang@google.com\u003e\nReviewed-by: Mike Wasserman \u003cmsw@chromium.org\u003e\nReviewed-by: Fred Shih \u003cffred@chromium.org\u003e\nReviewed-by: Steven Holte \u003cholte@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669825}\n\nCo-authored-by: Ian Zhao \u003cyinguang@google.com\u003e\n--\n\nwpt-commits: bd6829a4066abc9603c167271fed0b233638b4f4\nwpt-pr: 61589\n", "files": ["testing/web-platform/tests/ai/resources/util.js", "testing/web-platform/tests/ai/semantic_embedder/semantic-embedder-downloadprogress-abort.tentative.https.window.js", "testing/web-platform/tests/ai/semantic_embedder/semantic-embedder-downloadprogress.tentative.https.window.js"], "git_node": "20a07b7fa1601f235c9aff2965c9fa7a72c50ccd", "git_parents": ["22172a678cafb50c91d3728bdb3892df5a3d10c3"], "node": "90b51adfa8862c664d7285e39c7e3d22f0005db6", "parents": ["3d7cf48c916605938d64b1e18fc4d037150fc487"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058769 [wpt PR 61589] - Update wpt metadata, a=testonly\n\nwpt-pr: 61589\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/semantic_embedder/semantic-embedder-downloadprogress-abort.tentative.https.window.js.ini", "testing/web-platform/meta/ai/semantic_embedder/semantic-embedder-downloadprogress.tentative.https.window.js.ini"], "git_node": "bb7aeea44e665920de1ce5b2c75b0aa07573ff25", "git_parents": ["20a07b7fa1601f235c9aff2965c9fa7a72c50ccd"], "node": "5abb41d451fe077122847e3c49c53376a59a061a", "parents": ["90b51adfa8862c664d7285e39c7e3d22f0005db6"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2068947 [wpt PR 62382] - Reset pending selected scrollmarker on removal, a=testonly\n\nAutomatic update from web-platform-tests\nReset pending selected scrollmarker on removal\n\nA removed ScrollMarkerPseudoElement cleared the selected_marker_ of the\ngroup if that matched the removed marker. We did not check\npending_selected_marker_, which could lead to a disconnected pending\nmarker being promoted as the selected marker in\nApplyPendingScrollMarker().\n\nThis lead to a crash when calling\nLayoutTreeBuilderTraversal::ComparePreorderTreePosition on elements not\nin the flat tree.\n\nBug: 533050757\nChange-Id: I8540787e3aa7fc6da7376daae027e4e91079a351\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8331127\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690507}\n\n--\n\nwpt-commits: 8a0ace20bde348b1e5bda0ddd1527b161603b278\nwpt-pr: 62382\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-click-remove-crash.html"], "git_node": "a797e2810dcabc550fe3b435b34b3bab11110340", "git_parents": ["bb7aeea44e665920de1ce5b2c75b0aa07573ff25"], "node": "f5872c5816dae3f86ebe64ec546fe849678873bc", "parents": ["5abb41d451fe077122847e3c49c53376a59a061a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068947 [wpt PR 62382] - Update wpt metadata, a=testonly\n\nwpt-pr: 62382\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-marker-click-remove-crash.html.ini"], "git_node": "154b9150270dc14515c0c95749f4abf4162d680c", "git_parents": ["a797e2810dcabc550fe3b435b34b3bab11110340"], "node": "fcb61859323862db53d77c30f3e782efeae762e5", "parents": ["f5872c5816dae3f86ebe64ec546fe849678873bc"], "tags": []}, {"author": "SeungJun Lee \u003cmps756@gmail.com\u003e", "branch": "default", "desc": "Bug 2068951 [wpt PR 62349] - FileReader: Suppress stale loadend after reentrant read, a=testonly\n\nAutomatic update from web-platform-tests\nFileReader: Suppress stale loadend after reentrant read\n\nDo not fire loadend for a completed, aborted, or failed read when its terminal event handler starts a new read on the same FileReader.\n\nAdd regression coverage for reentrant reads from abort, load, and error handlers.\n\nBug: 40763894\nChange-Id: Ie51c5c9652f85e3feaeccc5f9591ddea35f72801\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8300812\nReviewed-by: Rakina Zata Amni \u003crakina@chromium.org\u003e\nCommit-Queue: Amos Lim \u003camoseui@chromium.org\u003e\nReviewed-by: Fergal Daly \u003cfergal@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690598}\n\n--\n\nwpt-commits: 666797a05cd728e328bc2161fe58a46ad11bfcb8\nwpt-pr: 62349\n", "files": ["testing/web-platform/tests/FileAPI/reading-data-section/FileReader-multiple-reads.any.js"], "git_node": "3dc16aff5ef3deac8923cedec6ca14b41b6c611f", "git_parents": ["154b9150270dc14515c0c95749f4abf4162d680c"], "node": "a4f5c7927b5f926133a7502f8a3f103704de68a3", "parents": ["fcb61859323862db53d77c30f3e782efeae762e5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068951 [wpt PR 62349] - Update wpt metadata, a=testonly\n\nwpt-pr: 62349\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/FileAPI/reading-data-section/FileReader-multiple-reads.any.js.ini"], "git_node": "f4b871fb74b9e8f16a29e589582cbca4199baa27", "git_parents": ["3dc16aff5ef3deac8923cedec6ca14b41b6c611f"], "node": "4f40557b41e73d5c1e35c4ec33cef4fdecfc55a1", "parents": ["a4f5c7927b5f926133a7502f8a3f103704de68a3"], "tags": []}, {"author": "J\u00falio Piubello \u003cjulio@gitstart.com\u003e", "branch": "default", "desc": "Bug 2068953 [wpt PR 62383] - WebDriver BiDi: Await user-context file dialog assertions, a=testonly\n\nAutomatic update from web-platform-tests\nWebDriver BiDi: Await user-context file dialog assertions\n\nAwait the asynchronous file-dialog assertion helpers in the\nbrowser.createUserContext unhandled prompt behavior WPT.\n\nPreviously, the test returned coroutine objects without executing their\nbodies, so the accept, dismiss, and ignore cases could report success\nwithout checking whether the picker was canceled. Running the assertions\nalso exposes existing host behavior for ignore; this CL does not change\nproduct behavior or expectations.\n\nBug: 539194312\nChange-Id: I0af5a6f080aea3bd27795391f5ce50f857722aaa\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8152279\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCommit-Queue: Julio Piubello \u003cjulio@gitstart.com\u003e\nReviewed-by: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690634}\n\n--\n\nwpt-commits: 3f6b09ae3ed55280074645ce38e9002f52fc60a8\nwpt-pr: 62383\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browser/create_user_context/unhandled_prompt_behavior.py"], "git_node": "bb5229a1569b453fb5176ed268b7393df936dc57", "git_parents": ["f4b871fb74b9e8f16a29e589582cbca4199baa27"], "node": "210aecdd1d8d9c0a38eba4227d87cd7ba30b1c63", "parents": ["4f40557b41e73d5c1e35c4ec33cef4fdecfc55a1"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2068958 [wpt PR 62392] - sttf: Split find-range-from-text-directive.html into subtests., a=testonly\n\nAutomatic update from web-platform-tests\nsttf: Split find-range-from-text-directive.html into subtests.\n\nThis is flaky timing out on the bots. Locally each run for the one test\ntakes about 17 seconds. After the split, each of the subtests takes\nabout 1.5 seconds. This should prevent bot timeouts.\n\nR=bokan@chromium.org\n\nBug: 553338116\nChange-Id: Iabf45f590d4318b88b6296b335ce3ab1ae45bc3d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8329047\nReviewed-by: Rick Byers \u003crbyers@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: David Bokan \u003cbokan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690710}\n\n--\n\nwpt-commits: 6ec9fd59f6526960bfdda514afd2325511d766fe\nwpt-pr: 62392\n", "files": ["testing/web-platform/tests/scroll-to-text-fragment/find-range-from-text-directive.html"], "git_node": "f3ef4fc3acc3c42e8aa90e7e77b80c111045755b", "git_parents": ["bb5229a1569b453fb5176ed268b7393df936dc57"], "node": "116f73dc40e20e933cffe642d6abb3a0301efb5b", "parents": ["210aecdd1d8d9c0a38eba4227d87cd7ba30b1c63"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068958 [wpt PR 62392] - Update wpt metadata, a=testonly\n\nwpt-pr: 62392\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/scroll-to-text-fragment/find-range-from-text-directive.html.ini"], "git_node": "f44da51395aae176f1632a9481ab93c30f8e8b3a", "git_parents": ["f3ef4fc3acc3c42e8aa90e7e77b80c111045755b"], "node": "14b09de33bfa834f1a0436fff39ef19a35bde94d", "parents": ["116f73dc40e20e933cffe642d6abb3a0301efb5b"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2068962 [wpt PR 62390] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322976, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=322976 (#62390)\n--\n\nwpt-commits: f8e0ed6a9da43fdaa16fa6e2a551d8c672b3ea0d\nwpt-pr: 62390\n", "files": ["testing/web-platform/tests/svg/types/scripted/SVGList-animVal-reflects-base-value.html", "testing/web-platform/tests/svg/types/scripted/SVGList-reflected-attribute-synchronize.html"], "git_node": "89e50faf208f29defd183a60796dd0761df657b5", "git_parents": ["f44da51395aae176f1632a9481ab93c30f8e8b3a"], "node": "c4e68eadb9a3cf8b5c17df80238c3182e205c1a3", "parents": ["14b09de33bfa834f1a0436fff39ef19a35bde94d"], "tags": []}, {"author": "Sam Sneddon \u003cgsnedders@apple.com\u003e", "branch": "default", "desc": "Bug 2068967 [wpt PR 62374] - Give each GitHub Actions wptreport a unique basename, a=testonly\n\nAutomatic update from web-platform-tests\nFix #62372: give each GitHub Actions wptreport a unique basename\n\nThis \"regressed\" with 10a4cd69c6, when we started sharding by test\ntype, which meant we now had multiple chunks numbered 1.\n\n(\"Regressed\" in quotation marks because this isn't really a bug on our\nside: it's a bug on the consuming side.)\n\n--\n\nwpt-commits: 7e3d005d7769cdcd196344ba39f27e74c99ccda7\nwpt-pr: 62374\n", "files": ["testing/web-platform/tests/.github/workflows/safari-wptrunner.yml"], "git_node": "2b7d23c656f07b7afb09724a4a901707e87a3533", "git_parents": ["89e50faf208f29defd183a60796dd0761df657b5"], "node": "49f4cb14057e5f32aa536ebdf19d706f5d7bc7de", "parents": ["c4e68eadb9a3cf8b5c17df80238c3182e205c1a3"], "tags": []}, {"author": "Christopher Cameron \u003cccameron@google.com\u003e", "branch": "default", "desc": "Bug 2068968 [wpt PR 62393] - Add parameterized toDataURL color conversion WPT test, a=testonly\n\nAutomatic update from web-platform-tests\nAdd parameterized toDataURL color conversion WPT test\n\nUse the same parameter set and test pattern as the getImageData tests.\n\nRemove individual redundant toDataURL tests superseded by this unified\ntest.\n\nTAG=agy\nCONV=3da4bac4-8ad7-46e9-969f-5aa84b7a5620\n\nBug: 454152417\nChange-Id: Ic2be8b406008168419241eef199e16a3ffbbc969\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8314209\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: ccameron chromium \u003cccameron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690327}\n\n--\n\nwpt-commits: 2b4dfe72cc8b66ab100b8b659e8881facd6c4e0f\nwpt-pr: 62393\n", "files": ["testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.jpeg.p3.canvas.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.p3.canvas.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.with.putImageData.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.toDataURL.convert.html", "testing/web-platform/tests/html/canvas/tools/yaml/color_space.yaml"], "git_node": "637e240804f43dea2d04acf92779bc048ebf5f1c", "git_parents": ["2b7d23c656f07b7afb09724a4a901707e87a3533"], "node": "39eb6c97e624c3bd17320b3e70921d8c5cb2f48c", "parents": ["49f4cb14057e5f32aa536ebdf19d706f5d7bc7de"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068968 [wpt PR 62393] - Update wpt metadata, a=testonly\n\nwpt-pr: 62393\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.jpeg.p3.canvas.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.p3.canvas.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.toDataURL.with.putImageData.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.toDataURL.convert.html.ini"], "git_node": "d22220d4b341f2761809aa9a57ce121733fc5c1f", "git_parents": ["637e240804f43dea2d04acf92779bc048ebf5f1c"], "node": "089c136f8998aac46cda8d398472141b72c9c254", "parents": ["39eb6c97e624c3bd17320b3e70921d8c5cb2f48c"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2068969 [wpt PR 62385] - WPT: Fix navigation-during-beforeunload test, a=testonly\n\nAutomatic update from web-platform-tests\nWPT: Fix navigation-during-beforeunload test\n\nhttps://wpt.fyi/results/html/browsers/browsing-the-web/unloading-documents/navigation-during-beforeunload.html\nshows that WebKit (Safari Tech Preview) passes all three tests. But on\nolder versions of WebKit that failed, the first hits a test harness\ntimeout, and the other two tests don't run.\n\nThis PR makes the first test fail more reasonably in broken\nimplementations (now, old versions of Safari). This was discovered in\nhttps://github.com/whatwg/html/issues/12800, and all of this is subject\nto change in the resolution of that issue.\n\nR=nrosenthal\n\nBug: N/A\nChange-Id: Iac34406a7323f7280029638db604e4c3da6b638e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8314432\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690719}\n\n--\n\nwpt-commits: a8b466b153dba98f0eede257d177d939025ae203\nwpt-pr: 62385\n", "files": ["testing/web-platform/tests/html/browsers/browsing-the-web/unloading-documents/navigation-during-beforeunload.html"], "git_node": "7eda12ac6a62e2374902f280dd45c0e9c2092168", "git_parents": ["d22220d4b341f2761809aa9a57ce121733fc5c1f"], "node": "54c8833c2c074f87cb55f8f2a867830e64de1a33", "parents": ["089c136f8998aac46cda8d398472141b72c9c254"], "tags": []}, {"author": "Yanling Wang \u003cyanlingwang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2063790 [wpt PR 61957] - [Masonry] Implement baseline alignment for subgridded items, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Implement baseline alignment for subgridded items\n\nThis CL implements baseline alignment for items subgridded into a\ngrid-lanes container along its grid (subgridded) axis, so they\nparticipate in the container's baseline alignment.\n\nSubgridded items are skipped by the container's placement loop because\nthey are laid out later by their own subgrid, so their baselines are\nnever gathered there. This CL measures and stores those baselines\nseparately during the baseline calculation phase, so the subgridded\nitems are aligned to the container's shared grid-axis baseline.\n\nAdds nested subgrids baseline tests, and clears the now-passing entries\nfrom TestExpectations.\n\nBug: 343257585\nChange-Id: Ief1de5fbe76aa3a6efd747c7f49f0955de3ff47b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8223162\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nReviewed-by: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1683558}\n\n--\n\nwpt-commits: 88da41daeb1bfcdc75d000c1edf9f4f9a7b6bfae\nwpt-pr: 61957\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-nested-subgrid-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-nested-subgrid-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-nested-subgrid-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-nested-subgrid-002.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-nested-subgrid-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-nested-subgrid-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-nested-subgrid-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-nested-subgrid-002.html"], "git_node": "e1b4159dc20b2a4800651ca1dde7c83bd34ed002", "git_parents": ["7eda12ac6a62e2374902f280dd45c0e9c2092168"], "node": "06558c064af9dd07d832fcecc2ff39f2483483db", "parents": ["54c8833c2c074f87cb55f8f2a867830e64de1a33"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063790 [wpt PR 61957] - Update wpt metadata, a=testonly\n\nwpt-pr: 61957\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-nested-subgrid-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-nested-subgrid-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-nested-subgrid-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-nested-subgrid-002.html.ini"], "git_node": "1792840e54a26edd1ccb31ba82b283ce51aad358", "git_parents": ["e1b4159dc20b2a4800651ca1dde7c83bd34ed002"], "node": "0b491109e75ced05d9db88e438886030c6be8da2", "parents": ["06558c064af9dd07d832fcecc2ff39f2483483db"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2068975 [wpt PR 62389] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323065, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=323065 (#62389)\n--\n\nwpt-commits: 508cc6a6247fcbc808e42e75ba99dfa9d9cc74ff\nwpt-pr: 62389\n", "files": ["testing/web-platform/tests/svg/types/scripted/SVGList-getItem-identity.tentative.html", "testing/web-platform/tests/svg/types/scripted/SVGList-identity-across-attribute-change.tentative.html", "testing/web-platform/tests/svg/types/scripted/SVGList-mutator-return-identity.tentative.html"], "git_node": "912b4c4380280c83ba16ddc958833a59d65332f0", "git_parents": ["1792840e54a26edd1ccb31ba82b283ce51aad358"], "node": "c7a9a888b68068dcb344f6e9991dd5d9cdd67d51", "parents": ["0b491109e75ced05d9db88e438886030c6be8da2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068975 [wpt PR 62389] - Update wpt metadata, a=testonly\n\nwpt-pr: 62389\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/types/scripted/svglength-value-access-when-in-detached-document-crash.html.ini"], "git_node": "a9deea3e493710f368df9f602ff51c9fe773cb23", "git_parents": ["912b4c4380280c83ba16ddc958833a59d65332f0"], "node": "ea1c2497a4ced8c36a90db28006d16944606957d", "parents": ["c7a9a888b68068dcb344f6e9991dd5d9cdd67d51"], "tags": []}, {"author": "Andreu Botella \u003cabotella@igalia.com\u003e", "branch": "default", "desc": "Bug 2068977 [wpt PR 62395] - [line-clamp] In displaced ellipses, only root inlines have a strut, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] In displaced ellipses, only root inlines have a strut\n\nLine-clamp ellipses behave as if they had `line-height: 0`, so they\nnever grow the line they're added to. However, when the ellipsis\ndisplaces a whole line, to avoid that line having zero size, the root\ninline box has a strut (i.e. it adds a corresponding height to the\nline), but other open inline boxes don't.\n\nIn our implementation of displaced ellipses, however, we were\ntriggering strict line height, meaning that all struts corresponding\nto open inline boxes had a strut. Instead, this CL changes the\n`line_height_quirk` boolean argument of\n`InlineLayoutStateStack::OnBeginPlaceItems` to a `LineHeightMode` enum\nwith a variant for the line-clamp displaced ellipsis, which behaves\nlike the line-height quirk (not adding struts) except for the root\ninline box.\n\nBug: 40336192, 543375422\nChange-Id: Ie57e81086826032d6301c8bb4931b0e31ec565a9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8287666\nCommit-Queue: Andreu Botella \u003cabotella@igalia.com\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690876}\n\n--\n\nwpt-commits: ed1909ed6cd48167b3fa0f01f38538bcc9cd3090\nwpt-pr: 62395\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/block-ellipsis-039.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/block-ellipsis-039-ref.html"], "git_node": "221858dc6c74a032166aed8a12dd073af9c88c39", "git_parents": ["a9deea3e493710f368df9f602ff51c9fe773cb23"], "node": "16cd99a5a0b58f725e26fe59f511e2c5c4850177", "parents": ["ea1c2497a4ced8c36a90db28006d16944606957d"], "tags": []}, {"author": "Justin Lulejian \u003cjlulejian@chromium.org\u003e", "branch": "default", "desc": "Bug 2068978 [wpt PR 62407] - [Extensions] Implement runtime.onEnabled lifecycle event, a=testonly\n\nAutomatic update from web-platform-tests\n[Extensions] Implement runtime.onEnabled lifecycle event\n\nCurrently, extensions have no standard lifecycle event to detect when\nthey are re-enabled after being disabled by the user or system. While\nruntime.onInstalled fires on installation and update and\nruntime.onStartup fires on browser profile startup, enabling an\nextension does not trigger a dedicated notification to the extension.\n\nWith this change, extensions can listen to runtime.onEnabled, which\nfires whenever an extension transitions from a disabled state to an\nenabled state while the browser is running.\n\nTAG=agy\nCONV=852bdb46-5859-4cdd-9d25-ef2e63da3746\n\nLow-Coverage-Reason: COVERAGE_UNDERREPORTED logic executed via extension doesn't seem to get reported.\nFixed: 550432518\nChange-Id: I277fd4e05aa4e1e15929b006f6d95347fc510057\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8275812\nAuto-Submit: Justin Lulejian \u003cjlulejian@chromium.org\u003e\nCommit-Queue: Justin Lulejian \u003cjlulejian@chromium.org\u003e\nReviewed-by: Tim \u003ctjudkins@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690907}\n\n--\n\nwpt-commits: d0c38285b53a93f9cd0774726807a49b1df851c7\nwpt-pr: 62407\n", "files": ["testing/web-platform/tests/web-extensions/resources/runtime/background.js"], "git_node": "2444038098f40b3e9a84ced5df80e246eb59d1d6", "git_parents": ["221858dc6c74a032166aed8a12dd073af9c88c39"], "node": "334731bb2595a6b5305a11af093d7cc4a3b8e0c7", "parents": ["16cd99a5a0b58f725e26fe59f511e2c5c4850177"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2068981 [wpt PR 62409] - Deflake two wpt/svg/animations/animateMotion-path-*.html tests, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake two wpt/svg/animations/animateMotion-path-*.html tests\n\nWait for 'load' before running any promise_test()s to ensure that the\nSMIL timeline has started.\n\nFixed: 555949816\nChange-Id: I2107b0b79d78bcc7b193c318e48689d153af293a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8347167\nAuto-Submit: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690955}\n\n--\n\nwpt-commits: 8fdda8ce4c5b08230b596f97e86ed509c408d065\nwpt-pr: 62409\n", "files": ["testing/web-platform/tests/svg/animations/animateMotion-path-moveto-only.html", "testing/web-platform/tests/svg/animations/animateMotion-path-zero-length-subpaths.html"], "git_node": "9ec35b6c254b07a62075d75b924b6e109311ef4c", "git_parents": ["2444038098f40b3e9a84ced5df80e246eb59d1d6"], "node": "872ba3eea132087b6eebcf681534433b504027bf", "parents": ["334731bb2595a6b5305a11af093d7cc4a3b8e0c7"], "tags": []}, {"author": "Thomas Nguyen \u003ctungnh@chromium.org\u003e", "branch": "default", "desc": "Bug 2068984 [wpt PR 62408] - [CE] Restrict script-initiated focus on capability elements, a=testonly\n\nAutomatic update from web-platform-tests\n[CE] Restrict script-initiated focus on capability elements\n\nInternal programmatic focus paths, such as modal dialog transitions or\npopover autofocus, reach this method with `FocusType::kNone`. This\nallowed capability elements to acquire focus without transient user\nactivation, bypassing safeguards. By tracking `FocusTrigger` instead,\ninternal script-driven invocations are properly captured and blocked\nunless user activation is present.\n\nFixed: 540076586, 344739595\nChange-Id: I5caec2bab0d2817f17b3e9f458e6da773b6761de\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8328459\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Thomas Nguyen \u003ctungnh@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1691080}\n\n--\n\nwpt-commits: a4fcd77aaa840712ae63c226a2256715d8e1a3d6\nwpt-pr: 62408\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/usermedia/no-focus.html"], "git_node": "c838a87385121180bc11cfe1eb8c199fa78ca1ea", "git_parents": ["9ec35b6c254b07a62075d75b924b6e109311ef4c"], "node": "e807d6a0f301a93f7e6109ec118ab30df2ffe08a", "parents": ["872ba3eea132087b6eebcf681534433b504027bf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068984 [wpt PR 62408] - Update wpt metadata, a=testonly\n\nwpt-pr: 62408\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/usermedia/no-focus.html.ini"], "git_node": "959d0da13190a9e84240c6b6286bacdc5365226a", "git_parents": ["c838a87385121180bc11cfe1eb8c199fa78ca1ea"], "node": "c33b7d375e67568a66cedc5ccbd813edc0d5120e", "parents": ["e807d6a0f301a93f7e6109ec118ab30df2ffe08a"], "tags": []}, {"author": "Dale Curtis \u003cdalecurtis@chromium.org\u003e", "branch": "default", "desc": "Bug 2068987 [wpt PR 62410] - Revert wpt import changes for webcodecs image decoder utilities, a=testonly\n\nAutomatic update from web-platform-tests\nRevert wpt import changes for webcodecs image decoder utilities\n\nImageDecoder implementations must support image-orientation: none,\nso tagged rotation is required.\n\nThe WPT changes in https://github.com/WebKit/WebKit/pull/71825 are\nincorrect. This reverts the WebCodecs changes from the wpt auto-roll\nin https://crrev.com/c/8337247\n\nR=tguilbert\n\nFixed: 555812369\nChange-Id: Ie86086cb017b4252ad8ca5870aa6b7bdb80ef2e2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8341575\nReviewed-by: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCommit-Queue: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCommit-Queue: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nAuto-Submit: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1691094}\n\n--\n\nwpt-commits: cc4d45aa0bd75e0dd1f341f122fd099d90a0aa8b\nwpt-pr: 62410\n", "files": ["testing/web-platform/tests/webcodecs/image-decoder-utils.js"], "git_node": "10a8ca52eac8c42d076b212b2588cc95f578ed7b", "git_parents": ["959d0da13190a9e84240c6b6286bacdc5365226a"], "node": "32acb27685bb764beaf2c7bdf125788aaf128e18", "parents": ["c33b7d375e67568a66cedc5ccbd813edc0d5120e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068987 [wpt PR 62410] - Update wpt metadata, a=testonly\n\nwpt-pr: 62410\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/image-decoder-image-orientation-none.https.html.ini"], "git_node": "1c788ef99785dd566934252bbd3776c1b04762e1", "git_parents": ["10a8ca52eac8c42d076b212b2588cc95f578ed7b"], "node": "b307eca9a979d259c76d3251fc09cddaf51ce6c9", "parents": ["32acb27685bb764beaf2c7bdf125788aaf128e18"], "tags": []}, {"author": "Charles Zhang \u003ccsalinezh@gmail.com\u003e", "branch": "default", "desc": "Bug 2068988 [wpt PR 62411] - Fix missing line break before entering unicode-bidi scope, a=testonly\n\nAutomatic update from web-platform-tests\nFix missing line break before entering unicode-bidi scope\n\nPrior to this patch, LayoutNG's LineBreaker::HandleBidiControlItem()\ninvokes ICU to find the break opportunity only when exiting a bidi\nscope. It ignores opportunities when entering such a scope, e.g. at\nunicode-bidi: isolate or \u003cbdi\u003e boundaries.\n\nThat's fine when preceded by a breakable space, but is problematic when\na character that allows a break to follow is used, such as the hyphen-\nminus. The bidi control characters injected by inline_items_builder.cc\nbelong to UAX#14 line break class CM, which should get combined with the\npreceding base characters and ignored per UAX#14 LB9.\n\nThis patch adds the line break opportunity check when entering a bidi\nscope, gated by feature flag LineBreakBidiControlEnter.\n\nFixed: 477829708\nChange-Id: Ie6bcfc3c77a6afb967d5348e45be3d3dde3849a3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8284218\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nAuto-Submit: Charles Zhang \u003ccsalinezh@gmail.com\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1691195}\n\n--\n\nwpt-commits: 0ea9f2aac339023384f279aca8a034775117445f\nwpt-pr: 62411\n", "files": ["testing/web-platform/tests/css/css-writing-modes/bidi-line-break-001.html"], "git_node": "8c398540b8bcd59262e841d0b62f894670a471b2", "git_parents": ["1c788ef99785dd566934252bbd3776c1b04762e1"], "node": "6e5f327636a9f1de487a513c9f3006a053038ff9", "parents": ["b307eca9a979d259c76d3251fc09cddaf51ce6c9"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2069295 [wpt PR 62270] - [Interop 2026] Advance MediaStream currentTime during playback, a=testonly\n\nAutomatic update from web-platform-tests\n[Interop 2026] Advance MediaStream currentTime during playback (#62270)\n\nTrack elapsed playback time for MediaStream-backed media elements instead\nof deriving currentTime from the latest received media frame. This keeps\ncurrentTime advancing while the element plays even when a remote sender is\ninactive, and preserves the accumulated time across pauses.\n\nCorrect the WPT helper so its audio cases create an audio track, and add\nunit coverage for play, pause, and resume behavior.\n\nBug: None\nChange-Id: I6e718c08395aaab82586b5a4225c0f029d8b8e84\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8309752\nReviewed-by: Johannes Kron \u003ckron@chromium.org\u003e\nReviewed-by: Guido Urdaneta \u003cguidou@chromium.org\u003e\nCommit-Queue: Guido Urdaneta \u003cguidou@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1687921}\n\nCo-authored-by: Michael Reeves \u003cmichael.reeves077@gmail.com\u003e\n--\n\nwpt-commits: d97bbe4aed91b88c94fe26800a13e004e337a02b\nwpt-pr: 62270\n", "files": ["testing/web-platform/tests/webrtc/RTCPeerConnection-remote-track-currentTime.https.html"], "git_node": "73a3f9fceac40b2e334a4e2a08227e97ab910fca", "git_parents": ["8c398540b8bcd59262e841d0b62f894670a471b2"], "node": "6754a94bfe8f5c959c63e1bc9acb4e9af45a2017", "parents": ["6e5f327636a9f1de487a513c9f3006a053038ff9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069295 [wpt PR 62270] - Update wpt metadata, a=testonly\n\nwpt-pr: 62270\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webrtc/RTCPeerConnection-addTransceiver.https.html.ini"], "git_node": "ef5701653896eb53ba4ee10789e82450bbf6dbae", "git_parents": ["73a3f9fceac40b2e334a4e2a08227e97ab910fca"], "node": "5cd41c7bef8c58225d17ffa80b9ff4419bcd3688", "parents": ["6754a94bfe8f5c959c63e1bc9acb4e9af45a2017"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069296 [wpt PR 62313] - sw.https.window.js is expecting a specific range request generation behaviour from media loading engines., a=testonly\n\nAutomatic update from web-platform-tests\nsw.https.window.js is expecting a specific range request generation behaviour from media loading engines. (#62313)\n\nWebKit engine does not behave as expected by the test, hence a timeout.\nWe update the test to move from a timeout to a failure.\n--\n\nwpt-commits: 41398349193defe47d2325f8aaaa0088d04fc2a4\nwpt-pr: 62313\n", "files": ["testing/web-platform/tests/fetch/range/sw.https.window.js"], "git_node": "4269ac3b5b63019e7b0fd37e019dfee30e5f92d6", "git_parents": ["ef5701653896eb53ba4ee10789e82450bbf6dbae"], "node": "21ad9f0b6be89f8bb4ee034315b5217d4199a314", "parents": ["5cd41c7bef8c58225d17ffa80b9ff4419bcd3688"], "tags": []}, {"author": "Christopher Cameron \u003cccameron@google.com\u003e", "branch": "default", "desc": "Bug 2069298 [wpt PR 62379] - WebGL: Add drawingBufferToneMapping interface, a=testonly\n\nAutomatic update from web-platform-tests\nWebGL: Add drawingBufferToneMapping interface\n\nImplement the WebGL drawingBufferToneMapping interface, gated on the\nexperimental WebGLToneMapping runtime feature flag.\n\nThe feature is described at:\nhttps://github.com/w3c-cg/ColorWeb-CG/blob/main/webgl-drawing-buffer-tone-map.md\n\nIt is a part of the larger HDR proposal at:\nhttps://github.com/w3c-cg/ColorWeb-CG/blob/main/hdr-big-picture.md\n\nThe function is a combined getter-setter (takes an optional\nCanvasToneMapping argument, returns the state).\n\nThe function is expected to destroy the color buffer's contents. This\nmay not be strictly necessary, but mirrors the capabilities in WebGPU,\nand the behavior of setting the drawingBufferColorSpace attribute. Add a\ntest for this (mirroring the color space test).\n\nAdd WPT test external/wpt/webgl/drawingBufferToneMapping.html and update\nwebexposed global interface expectations.\n\nTAG=agy\nCONV=9f2c857b-3ae8-4048-ab49-db1109f50272\n\nBug: 555806830\nChange-Id: If5908fcb910ee110a949b47663d905e526ca53e9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8330328\nReviewed-by: Philip J\u00e4genstedt \u003cfoolip@chromium.org\u003e\nCommit-Queue: ccameron chromium \u003cccameron@chromium.org\u003e\nReviewed-by: Kai Ninomiya \u003ckainino@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690875}\n\n--\n\nwpt-commits: 341432dac3fa5d5edc9fef9c7977bf51cd325078\nwpt-pr: 62379\n", "files": ["testing/web-platform/tests/webgl/drawingBufferToneMapping.html"], "git_node": "e8a995668ce216d6b1194e92604b8263acd7c849", "git_parents": ["4269ac3b5b63019e7b0fd37e019dfee30e5f92d6"], "node": "fce982e083a541f4855bf5af83b0f84d99f69035", "parents": ["21ad9f0b6be89f8bb4ee034315b5217d4199a314"], "tags": []}, {"author": "Hoch Hochkeppel (HE/HIM) \u003cmhochk@microsoft.com\u003e", "branch": "default", "desc": "Bug 2069299 [wpt PR 62381] - Fix crash on RTL caret offset before a run's first glyph, a=testonly\n\nAutomatic update from web-platform-tests\nFix crash on RTL caret offset before a run's first glyph\n\nIf a ligature glyph is composed across an inline boundary, the glyph\nwill end up getting owned by the first character (outside the boundary),\nleaving the others without an owner within their run. The RTL walking\nlogic did not account for this (edge) case, so this change adds a simple\ncheck to handle it, and a test that checks basic cursor validity in this\nscenario (which crashes without this fix).\n\nBUG: 472563267\nChange-Id: I67e644c8f00b5541777cd41ba9dc92aed5192ac5\nFIXED: 483936080\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8309212\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690877}\n\n--\n\nwpt-commits: 105b6a3a5d94003cac94dec460f017e47ea77b4d\nwpt-pr: 62381\n", "files": ["testing/web-platform/tests/css/cssom-view/range-bounding-client-rect-rtl-ligature-split.html"], "git_node": "e2b339143a4e15ba179b3b4425c00decf448e950", "git_parents": ["e8a995668ce216d6b1194e92604b8263acd7c849"], "node": "fee99780f7eb6908b7649387d4ffc884d857f4e6", "parents": ["fce982e083a541f4855bf5af83b0f84d99f69035"], "tags": []}, {"author": "Monica Chintala \u003cmonicach@microsoft.com\u003e", "branch": "default", "desc": "Bug 2069303 [wpt PR 62362] - WebTransport: Implement WebTransport reliability attributes, a=testonly\n\nAutomatic update from web-platform-tests\nWebTransport: Implement WebTransport reliability attributes\n\nExpose WebTransport.reliability with the state transitions required by\nthe WebTransport specification. The value starts as pending and changes\nto supports-unreliable after Chromium establishes its HTTP/3 transport.\n\nAlso expose WebTransport.supportsReliableOnly as false because Chromium\ndoes not currently implement WebTransport over a reliable-only\ntransport. Gate both attributes behind the experimental\nWebTransportReliability runtime feature. Update the IDL harness,\nWeb-exposed interface, and Android WebView expectations.\n\nchrome status entry - https://chromestatus.com/feature/5094058497277952\n\nBug: 545636884\nChange-Id: I73f603e6d43506efe2a5e1de1e1c77fc90c12bad\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8237894\nReviewed-by: Nidhi Jaju \u003cnidhijaju@chromium.org\u003e\nCommit-Queue: Monica Chintala \u003cmonicach@microsoft.com\u003e\nReviewed-by: Liang Zhao \u003clzhao@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1690895}\n\n--\n\nwpt-commits: ddfa5ac3420c3ebf7b8d19e9b1945ca37ed773cd\nwpt-pr: 62362\n", "files": ["testing/web-platform/tests/webtransport/reliability.https.any.js", "testing/web-platform/tests/webtransport/reliability.https.window.js"], "git_node": "df5ddcbb9fe7165cb976e91016430b3e5ab1b6b3", "git_parents": ["e2b339143a4e15ba179b3b4425c00decf448e950"], "node": "f43dfd1f84c68ff24c3e6c3d3bdaa266203c7ae1", "parents": ["fee99780f7eb6908b7649387d4ffc884d857f4e6"], "tags": []}, {"author": "Ningxin Hu \u003cningxin.hu@intel.com\u003e", "branch": "default", "desc": "Bug 2069307 [wpt PR 62412] - WebNN: Mark GATHER as float16-capable on LiteRT GPU delegate, a=testonly\n\nAutomatic update from web-platform-tests\nWebNN: Mark GATHER as float16-capable on LiteRT GPU delegate\n\nGATHER was serialized as not supporting float16, so a float16 input\ngot a DEQUANTIZE inserted in front of it. The ML Drift delegate folds\nthat DEQUANTIZE away, which leaves GATHER reading a float16 input into\nthe float32 destination the graph declared. Its model builder rejects\nthat with \"Input / output dtype mismatch\", so the node and its\nDEQUANTIZE drop to CPU and the delegated partition is split.\n\nGATHER in ML Drift is a pure lookup [1]: it copies input elements\nthrough unchanged, so it can carry float16 the way reshape already\ndoes. Marking it float16-capable leaves the conversion on the output,\nwhere the delegate fuses it into the gather kernel instead of\nmaterializing a float32 copy of the whole input.\n\nAdds a \"conv2d default + gather / float16\" WPT case. Conv2d is not\nfloat16-capable, so its float16 output is serialized as float32;\ngather then reads a float32 input while its own output operand is\nfloat16 and is the graph output, which is the case the output type\noverride covers.\n\n[1]: https://github.com/google-ai-edge/LiteRT/pull/9682\n\nBug: 534847488\nChange-Id: I2758cb3e305e02edb568ba3a302adb5409cfafc1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8345429\nCommit-Queue: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1691345}\n\n--\n\nwpt-commits: c4781704fb6f7829bab44c1dbbad3cca8cc7140e\nwpt-pr: 62412\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/subgraph.https.any.js"], "git_node": "0999b6dd7eb7890cf17a8efdbdcb982b6df44d0b", "git_parents": ["df5ddcbb9fe7165cb976e91016430b3e5ab1b6b3"], "node": "83abe78f342d4104c45d9f2b1adf1de489d7854b", "parents": ["f43dfd1f84c68ff24c3e6c3d3bdaa266203c7ae1"], "tags": []}, {"author": "Marcos C\u00e1ceres \u003ccaceres_m@apple.com\u003e", "branch": "default", "desc": "Bug 2069310 [wpt PR 62348] - Credential Management: test opaque-origin rejection for origin-bound credentials, a=testonly\n\nAutomatic update from web-platform-tests\nCredential Management: test opaque-origin rejection for origin-bound credentials (#62348)\n--\n\nwpt-commits: 476394464d0bd41775b2ad0f1e5925548f805e9b\nwpt-pr: 62348\n", "files": ["testing/web-platform/tests/credential-management/origin-bound-opaque-origin-top-level-allow-same-origin.https.html", "testing/web-platform/tests/credential-management/origin-bound-opaque-origin-top-level-allow-same-origin.https.html.headers", "testing/web-platform/tests/credential-management/origin-bound-opaque-origin-top-level.https.html", "testing/web-platform/tests/credential-management/origin-bound-opaque-origin-top-level.https.html.headers", "testing/web-platform/tests/credential-management/origin-bound-opaque-origin.https.html", "testing/web-platform/tests/credential-management/support/origin-bound-report-csp-sandbox.html", "testing/web-platform/tests/credential-management/support/origin-bound-report-csp-sandbox.html.headers", "testing/web-platform/tests/credential-management/support/origin-bound-report.html", "testing/web-platform/tests/credential-management/support/origin-bound-report.js"], "git_node": "ca7e02060518a9d53665998d075ca311f219f102", "git_parents": ["0999b6dd7eb7890cf17a8efdbdcb982b6df44d0b"], "node": "db1f489df982dc86ac96f6fd30f17a38d6fd6119", "parents": ["83abe78f342d4104c45d9f2b1adf1de489d7854b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069310 [wpt PR 62348] - Update wpt metadata, a=testonly\n\nwpt-pr: 62348\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/credential-management/origin-bound-opaque-origin-top-level-allow-same-origin.https.html.ini", "testing/web-platform/meta/credential-management/origin-bound-opaque-origin-top-level.https.html.ini", "testing/web-platform/meta/credential-management/origin-bound-opaque-origin.https.html.ini"], "git_node": "e48b39d6acb64a9e6a7b9bf2e12d30e5dccb63d2", "git_parents": ["ca7e02060518a9d53665998d075ca311f219f102"], "node": "4501c640e7ee3ab427337979f79cde779cc2656e", "parents": ["db1f489df982dc86ac96f6fd30f17a38d6fd6119"], "tags": []}, {"author": "Kent Tamura \u003ctkent@chromium.org\u003e", "branch": "default", "desc": "Bug 2069316 [wpt PR 62422] - ruby: Propagate block-end annotation space in multicol containers, a=testonly\n\nAutomatic update from web-platform-tests\nruby: Propagate block-end annotation space in multicol containers\n\nPreviously, block-end annotation space propagation was disabled for\nchildren of balanced multicol containers to avoid issues in an existing\nWPT test about column balancing. This CL enables it.\n\nThis CL fixes BlockLayoutAlgorithm::FinishLayout() so that to compute\nthe available annotation space correctly for fragmented containers.\n\nBug: 445727139, 538260158\nChange-Id: I27848eba96cb7f8ae8eb775d725455e0bc8d8748\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8294040\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nAuto-Submit: Kent Tamura \u003ctkent@chromium.org\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1691451}\n\n--\n\nwpt-commits: a1e944e7a879854494e1a041a8ad1e4a8ae28ab1\nwpt-pr: 62422\n", "files": ["testing/web-platform/tests/css/css-ruby/line-spacing-on-edges.tentative.html"], "git_node": "ad87d0e4f318865364b6068ae3f89dd614c2f590", "git_parents": ["e48b39d6acb64a9e6a7b9bf2e12d30e5dccb63d2"], "node": "09327f48c09c43e9add3859ea7eabfe2d9877bd0", "parents": ["4501c640e7ee3ab427337979f79cde779cc2656e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069316 [wpt PR 62422] - Update wpt metadata, a=testonly\n\nwpt-pr: 62422\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-ruby/line-spacing-on-edges.tentative.html.ini"], "git_node": "7207afe80664628287e2ecc8c12214c5c60baf89", "git_parents": ["ad87d0e4f318865364b6068ae3f89dd614c2f590"], "node": "214f7dddd51023797e8b2d3c23f81870ab0717d3", "parents": ["09327f48c09c43e9add3859ea7eabfe2d9877bd0"], "tags": []}, {"author": "Isaac Ahouma \u003ciahouma@google.com\u003e", "branch": "default", "desc": "Bug 2064992 [wpt PR 62073] - Built-In AI: Guard Translator creation with availability check in WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nBuilt-In AI: Guard Translator creation with availability check in WPTs\n\nAdd an `assert_implements_optional` guard to `createTranslator()` so\nthat WPT tests yield `PRECONDITION_FAILED` instead of failing with\nunhandled `NotSupportedError` rejections in environments without\nlanguage packages installed.\n\nBug: 545757079, 376789810\nChange-Id: Iccda190677dea6022444c82d307aa3e94cacc0c9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8263570\nAuto-Submit: Isaac Ahouma \u003ciahouma@google.com\u003e\nReviewed-by: Jingyun Liu \u003cjingyun@google.com\u003e\nCommit-Queue: Isaac Ahouma \u003ciahouma@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1683346}\n\n--\n\nwpt-commits: 07d3da1faedd53a4c35d0d675d7da1282f4f441d\nwpt-pr: 62073\n", "files": ["testing/web-platform/tests/ai/translator/resources/util.js"], "git_node": "1c8388b9b297ac7ed890571540a4674afc0a2690", "git_parents": ["7207afe80664628287e2ecc8c12214c5c60baf89"], "node": "e4dc4c1015de575192594d694e82e1a715fb8e59", "parents": ["214f7dddd51023797e8b2d3c23f81870ab0717d3"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2069320 [wpt PR 62423] - Avoid passing resource timing information for post-redirect errors, a=testonly\n\nAutomatic update from web-platform-tests\nAvoid passing resource timing information for post-redirect errors\n\nIn these cases \"allow timing pass\" could be true but the response is\n\"null\" (https://fetch.spec.whatwg.org/#create-an-opaque-timing-info)\n\nAdded more cases to WPT\n\nBug: 40057919\nChange-Id: I6aa11913dd1214a192adb62987baca1e49b4d94f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8345384\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Yoav Weiss (@Shopify) \u003cyoavweiss@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1691506}\n\n--\n\nwpt-commits: 4fbf9ef4d7d371418f644ac5e0e8c0e8da9557b9\nwpt-pr: 62423\n", "files": ["testing/web-platform/tests/resource-timing/entries-for-network-errors.sub.https.html", "testing/web-platform/tests/resource-timing/resources/entry-invariants.js"], "git_node": "e3275c9c9204ae992ea9324607527a0a2ee84058", "git_parents": ["1c8388b9b297ac7ed890571540a4674afc0a2690"], "node": "f9f712fab11949b30a501fe8fe6ef4c22b439cf3", "parents": ["e4dc4c1015de575192594d694e82e1a715fb8e59"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069320 [wpt PR 62423] - Update wpt metadata, a=testonly\n\nwpt-pr: 62423\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/resource-timing/entries-for-network-errors.sub.https.html.ini"], "git_node": "49291dc270d593425c3b3b7a624cd5ec75943d2e", "git_parents": ["e3275c9c9204ae992ea9324607527a0a2ee84058"], "node": "34af9d1c2164f1e716ee77cdf9315c1cd06f2830", "parents": ["f9f712fab11949b30a501fe8fe6ef4c22b439cf3"], "tags": []}, {"author": "Arnold Loubriat \u003cdatatriny@gmail.com\u003e", "branch": "default", "desc": "Bug 2069322 [wpt PR 62251] - [core-aam] Find the test document without the embeds relation, a=testonly\n\nAutomatic update from web-platform-tests\n[core-aam] Find the test document without the embeds relation (#62251)\n\nLook the document up with a Collection query for the document roles,\nfalling back to a tree walk when a browser does not answer\nCollection queries, and use the document url to tell the test\ndocument apart from the other documents a browser exposes.\n--\n\nwpt-commits: 223b3686e9c2d445b1accaa4d5c82f687c997ac3\nwpt-pr: 62251\n", "files": ["testing/web-platform/tests/core-aam/aamtests/support/atspi_wrapper.py"], "git_node": "cc575b8acce1368b7c0593cfefcbb893f6e64622", "git_parents": ["49291dc270d593425c3b3b7a624cd5ec75943d2e"], "node": "6266564c8ad7bdfcee4805fe4472c0a960c70014", "parents": ["34af9d1c2164f1e716ee77cdf9315c1cd06f2830"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2069325 [wpt PR 62428] - [compression-dictionary] Add a test for same-origin no-cors fetch, a=testonly\n\nAutomatic update from web-platform-tests\n[compression-dictionary] Add a test for same-origin no-cors fetch\n\nAs of 2026/09/03, the PR against the fetch spec [1] says that\n\"HTTP-network compression-dictionary fetch\" should fallback to\n\"HTTP-network fetch\" if request's mode is \"no-cors\". However,\nthis seems to be a mistake since Chromium allows using compression\ndictionaries for same-origin [2]. Chromium's behavior is already\nimplicitly covered by compressed-large-resources-001.tentative, which\nchecks \"no-cors\" fetches via img/script/link tags but this CL adds a\nmore straightforward test that is easier to compare against its\ncross-origin version. The CL also adds dictionary ids to make the\ntest a bit more robust.\n\n[1] https://github.com/whatwg/fetch/pull/1854\n[2] https://source.chromium.org/chromium/chromium/src/+/main:services/network/cors/cors_url_loader.cc;l=366?q=LOAD_CAN_USE_SHARED_DICTIONARY&ss=chromium%2Fchromium%2Fsrc\n\nBug: 40255884\nChange-Id: I879382048ed18d45b629a1b8ae2b5d0461d06cb3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8353624\nReviewed-by: Patrick Meenan \u003cpmeenan@chromium.org\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1691778}\n\n--\n\nwpt-commits: 2c385f65e4a4340bc6320b2745e86641b5710346\nwpt-pr: 62428\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/dictionary-fetch-no-cors.tentative.https.html"], "git_node": "83193a2a961353de660e473d34f81b593cb920ce", "git_parents": ["cc575b8acce1368b7c0593cfefcbb893f6e64622"], "node": "18cd97ddcc4a7bedda438f7004c27a222a6a2630", "parents": ["6266564c8ad7bdfcee4805fe4472c0a960c70014"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2069330 [wpt PR 62427] - Fix flakiness in compression-dictionary/compressed-large-*.https.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix flakiness in compression-dictionary/compressed-large-*.https.html\n\nUse UUIDs in URLs to prevent potential race conditions with dictionary\nregistration, resource loading and cache clearing between\n`compression_dictionary_promise_test`s.\n\nEven with `run_wpt_tests.py --repeat=20`, I was enable to reproduce any\nfailure with compressed-large-resources-002.tentative.https.html, but\nlet's tentatively remove the failure annotation.\n\nA similar issue was however observable in WebKit with equivalent command\n`run-webkit-tests --repeat=4` and is fixed by this change.\n\nBug: 538228192, 40255884\nChange-Id: Ib72f80f02a7a9b539cdb4c3627c1d4cabee684e4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8341989\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nReviewed-by: Patrick Meenan \u003cpmeenan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1691847}\n\n--\n\nwpt-commits: 9298d21d24c022a57b8c0b60b9a609fe6b684c62\nwpt-pr: 62427\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/compressed-large-resources-001.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/compressed-large-resources-002.tentative.https.html"], "git_node": "d6d33568b43f5fd79a0895b133ddee1f28829601", "git_parents": ["83193a2a961353de660e473d34f81b593cb920ce"], "node": "8303b031b9664d6b2cf359f6c575a454b009c8c4", "parents": ["18cd97ddcc4a7bedda438f7004c27a222a6a2630"], "tags": []}, {"author": "Stephen McGruer \u003csmcgruer@chromium.org\u003e", "branch": "default", "desc": "Bug 2069335 [wpt PR 62429] - Add Payment Method Manifest WPTs for fetch options and status codes, a=testonly\n\nAutomatic update from web-platform-tests\nAdd Payment Method Manifest WPTs for fetch options and status codes\n\nThis adds tests covering Payment Method Manifest fetch options\n(credentials omission and Referer header) and HTTP response status code\nhandling. Tests added:\n\n   - PMI HEAD request omits credentials (cookies and authorization)\n   - Manifest GET request omits credentials (cookies and authorization)\n   - Manifest GET request sets Referer header to match PMI URL\n       - This test fails in Chrome, which is crbug.com/545843241\n   - HTTP 204 No Content response on initial PMI HEAD request succeeds\n   - HTTP 404 response on initial PMI HEAD request aborts manifest fetching\n   - HTTP 500 response on initial PMI HEAD request aborts manifest fetching\n\nBug: 552832440, 545843241\nChange-Id: I8762c379aab36f272dcbf15feba270851a9fd856\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8328669\nCommit-Queue: Stephen McGruer \u003csmcgruer@chromium.org\u003e\nAuto-Submit: Stephen McGruer \u003csmcgruer@chromium.org\u003e\nReviewed-by: Xuehui Chen \u003cxuehuichen@google.com\u003e\nCommit-Queue: Xuehui Chen \u003cxuehuichen@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1691947}\n\n--\n\nwpt-commits: a1690333b93590aae0ca7942edaa31b118a0e608\nwpt-pr: 62429\n", "files": ["testing/web-platform/tests/payment-method-manifest/fetch-options.https.window.js", "testing/web-platform/tests/payment-method-manifest/pmi-http-status.https.window.js", "testing/web-platform/tests/payment-method-manifest/resources/helpers.js", "testing/web-platform/tests/payment-method-manifest/resources/payment-method-identifier.py", "testing/web-platform/tests/payment-method-manifest/resources/payment-method-manifest.py"], "git_node": "e5f4e11b8f6631ecd1cff41271423e20e12d42cd", "git_parents": ["d6d33568b43f5fd79a0895b133ddee1f28829601"], "node": "bd9615c97e1f7bcb6d717f668ed22c3c34c5aafe", "parents": ["8303b031b9664d6b2cf359f6c575a454b009c8c4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069335 [wpt PR 62429] - Update wpt metadata, a=testonly\n\nwpt-pr: 62429\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/payment-method-manifest/fetch-options.https.window.js.ini", "testing/web-platform/meta/payment-method-manifest/pmi-http-status.https.window.js.ini"], "git_node": "4b811d5a86b8fb44079e04fd1d93a51329b1456c", "git_parents": ["e5f4e11b8f6631ecd1cff41271423e20e12d42cd"], "node": "7ee2230aae3ff7b6fe46be7389e82d1502a12793", "parents": ["bd9615c97e1f7bcb6d717f668ed22c3c34c5aafe"], "tags": []}, {"author": "Stefan Zager \u003cszager@chromium.org\u003e", "branch": "default", "desc": "Bug 2069336 [wpt PR 62436] - [HiC] Implement geometry update events for offscreen canvas, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Implement geometry update events for offscreen canvas\n\nSee: https://github.com/WICG/html-in-canvas/issues/135\n\nBug: 532229486\nChange-Id: Ic3d0b4be42105dd50e34b26c6f018c99ddfc7b89\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8339821\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1692090}\n\n--\n\nwpt-commits: 7fcff3881cae3f9fc3a14ff40ab5d9b157006ace\nwpt-pr: 62436\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/canvas-transform-update-element-image.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry-offscreen.tentative.html", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/canvas-transform-update-worker.tentative.html"], "git_node": "d79893fd237a4f1574962871d743b046687cb9c7", "git_parents": ["4b811d5a86b8fb44079e04fd1d93a51329b1456c"], "node": "dc0140533534ac8ce31e361a484ff29c0024449c", "parents": ["7ee2230aae3ff7b6fe46be7389e82d1502a12793"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069336 [wpt PR 62436] - Update wpt metadata, a=testonly\n\nwpt-pr: 62436\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-update-element-image.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry-offscreen.tentative.html.ini", "testing/web-platform/meta/html/canvas/offscreen/manual/draw-element-image/canvas-transform-update-worker.tentative.html.ini"], "git_node": "04b514079d762e933fd9b02196e70071f711f84d", "git_parents": ["d79893fd237a4f1574962871d743b046687cb9c7"], "node": "64e93ad6759bea800abbee6ca9280c75c4809451", "parents": ["dc0140533534ac8ce31e361a484ff29c0024449c"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2069338 [wpt PR 62391] - Reland \"Scroll anchor-positioned fixed boxes into view on focus\", a=testonly\n\nAutomatic update from web-platform-tests\nReland \"Scroll anchor-positioned fixed boxes into view on focus\"\n\nThis is a reland of commit a960d664cc91883da1ae77f1c27196cacc51c82b\n\nThe original CL was reverted due to flaky failures only in\nvirtual/fragmented-oof-in-cb. Added TestExpectations entries for those\ntests.\n\nOriginal change's description:\n\u003e Scroll anchor-positioned fixed boxes into view on focus\n\u003e\n\u003e Anchor-positioned fixed boxes still need to move with the anchor when\n\u003e the frame scrolls. scroll-into-view stopped bubbling as soon as it hit a\n\u003e position:fixed box, so the frame never got scrolled. This CL excludes\n\u003e anchor-positioned fixed boxes from that check.\n\u003e\n\u003e Bug: 469481151\n\u003e Change-Id: I01cc730bd029b58af43857b35749d39aba42ea6f\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8123394\n\u003e Reviewed-by: David Bokan \u003cbokan@chromium.org\u003e\n\u003e Commit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1686828}\n\nBug: 469481151\nChange-Id: I28bec015142bf4bdd2a15dc4bac60ea07482430f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8311148\nReviewed-by: David Bokan \u003cbokan@chromium.org\u003e\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1692098}\n\n--\n\nwpt-commits: 4a01b83e3b93b3e394f9f4f503b3152cf54098b8\nwpt-pr: 62391\n", "files": ["testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-001.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-002.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-003.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-004.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-005.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-006.html"], "git_node": "47ce10e32d84f44cfcbd0df92cee8c4e77a9b7f6", "git_parents": ["04b514079d762e933fd9b02196e70071f711f84d"], "node": "1addae7d2b252d120e4e2f3aedeecd22d914bbcc", "parents": ["64e93ad6759bea800abbee6ca9280c75c4809451"], "tags": []}, {"author": "Barry Pollard \u003cbarrypollard@google.com\u003e", "branch": "default", "desc": "Bug 2069340 [wpt PR 62433] - Add more `\u003ctemplate for\u003e` web features mappings, a=testonly\n\nAutomatic update from web-platform-tests\nAdd more `\u003ctemplate for\u003e` web features mappings (#62433)\n\n* Create WEB_FEATURES.yml\n\n* Rename html/semantics/scripting-1/the-template-element/template-for/html/dom/partial-updates/tentative/WEB_FEATURES.yml to html/semantics/scripting-1/the-template-element/template-for/html/dom/partial-updates/WEB_FEATURES.yml\n\n* Rename html/semantics/scripting-1/the-template-element/template-for/html/dom/partial-updates/WEB_FEATURES.yml to html/semantics/scripting-1/the-template-element/template-for/WEB_FEATURES.yml\n--\n\nwpt-commits: e7122b73fb2a5a1bf3a6070033a76656a57baaeb\nwpt-pr: 62433\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-template-element/template-for/WEB_FEATURES.yml"], "git_node": "e25d7d5656aeed34605a9d1ed939b025c505c055", "git_parents": ["47ce10e32d84f44cfcbd0df92cee8c4e77a9b7f6"], "node": "eb141b54a17ece25d2d6538c2ba2745ad2781e6e", "parents": ["1addae7d2b252d120e4e2f3aedeecd22d914bbcc"], "tags": []}, {"author": "Barry Pollard \u003cbarrypollard@google.com\u003e", "branch": "default", "desc": "Bug 2069361 [wpt PR 62437] - Container timing, a=testonly\n\nAutomatic update from web-platform-tests\nAdd Container Timing Web Features mapping (#62437)\n--\n\nwpt-commits: 0c9001c535943a63dd45c56aa60ec14010835c42\nwpt-pr: 62437\n", "files": ["testing/web-platform/tests/container-timing/WEB_FEATURES.yml"], "git_node": "e172713293c6210f6c7cfa9b75b020862743aa7d", "git_parents": ["e25d7d5656aeed34605a9d1ed939b025c505c055"], "node": "c1f1156ae7c722cce14dd3ee4863b5edb547b8fd", "parents": ["eb141b54a17ece25d2d6538c2ba2745ad2781e6e"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2052766 [wpt PR 61080] - HTML: img width/height when not rendered are density-corrected, a=testonly\n\nAutomatic update from web-platform-tests\nHTML: img width/height when not rendered are density-corrected\n\nSee https://github.com/whatwg/html/pull/12840\n--\n\nwpt-commits: 18be932359511b7ad1c97e1af6b87997b25cbc4e\nwpt-pr: 61080\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/naturalWidth-naturalHeight-width-height.html", "testing/web-platform/tests/html/semantics/embedded-content/the-img-element/width-height-attribute-parsing.html", "testing/web-platform/tests/html/semantics/forms/the-input-element/image-width-height.html"], "git_node": "c1e8f46acfb6ced6544b62c19931e785cc85c9d4", "git_parents": ["e172713293c6210f6c7cfa9b75b020862743aa7d"], "node": "499e10c9bcea4e1fd42c619183788d757603e0f7", "parents": ["c1f1156ae7c722cce14dd3ee4863b5edb547b8fd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052766 [wpt PR 61080] - Update wpt metadata, a=testonly\n\nwpt-pr: 61080\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-img-element/naturalWidth-naturalHeight-width-height.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/width-height-attribute-parsing.html.ini", "testing/web-platform/meta/html/semantics/forms/the-input-element/image-width-height.html.ini"], "git_node": "cdf6ea221219ece3b9e0431396ccb33f6008f029", "git_parents": ["c1e8f46acfb6ced6544b62c19931e785cc85c9d4"], "node": "0dbe6e529a885a5e46b903c52a51af6aa71f24ce", "parents": ["499e10c9bcea4e1fd42c619183788d757603e0f7"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2069381 [wpt PR 62235] - Implement ::highlight(*), a=testonly\n\nAutomatic update from web-platform-tests\nImplement ::highlight(*) (#62235)\n\nCSSWG decided to allow '*' as the argument of the ::highlight(); that\ncan style every registered custom highlight [1].\n\nParse the '*' delimiter token as the ::highlight() argument, store it as\nCSSSelector::UniversalSelectorAtom(), which contributes 0 specificity.\nTherefore, named custom highlights win conflicting declarations\nregardless of source order.\n\nMake ::highlight(*) match every named custom highlight under the normal\ncascade algorithm. A new HasCustomHighlightUniversalSelector field in\ncomputed_style_extra_fields records whether an element has a universal\nselector, and StyleHighlightData stores the resolved related style.\n\nHandle some extra cases explicitly:\n- When the parent has no style for the named highlight but does have\n  ::highlight(*), inherit from that.\n\n[1] https://github.com/w3c/csswg-drafts/issues/9091\n\nSpec PR: https://github.com/w3c/csswg-drafts/pull/14301\nIntent to Prototype: https://groups.google.com/a/chromium.org/g/blink-dev/c/hEy4cr4iowU/m/ZW5l_bikAwAJ\nFeature Entry: https://chromestatus.com/feature/5174965228929024\n\nBug: 408003366\nChange-Id: I9c77fef6710a2450084d2cfcb70caceaeda8b988\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8235619\nCommit-Queue: Seokho Song \u003cseokho@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1689587}\n\nCo-authored-by: Seokho Song \u003cseokho@chromium.org\u003e\n--\n\nwpt-commits: 336915ca98b55be589fe4b61812f2c205cbb84f7\nwpt-pr: 62235\n", "files": ["testing/web-platform/tests/css/css-highlight-api/custom-highlight-escaped-star-001.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-deep-chain-001.tentative-ref.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-deep-chain-001.tentative.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-inheritance-001.tentative-ref.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-inheritance-001.tentative.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-no-named-rule-001.tentative.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-no-named-rule-002.tentative-ref.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-no-named-rule-002.tentative.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-painting-001-ref.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-painting-001.tentative.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-painting-002.tentative.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-painting-003.tentative-ref.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-painting-003.tentative.html", "testing/web-platform/tests/css/css-highlight-api/custom-highlight-universal-parsing-and-computed-style.tentative.html", "testing/web-platform/tests/css/css-highlight-api/highlight-pseudo-parsing.html"], "git_node": "ce10b199365e39f5675309774c3159b009ab5ffd", "git_parents": ["cdf6ea221219ece3b9e0431396ccb33f6008f029"], "node": "e0bf249125482