c4aabbba55e2a11bff06d69c39913f9308aa864e\nzh-TW -\u003e c4aabbba55e2a11bff06d69c39913f9308aa864e\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "2310ec4e3acd91ec393fa85345224862c9a326f5", "git_parents": ["2b7b0153120bc1af6f3ef1d9493847efec54f47c"], "node": "faedc7e2db4191703abaa916be980645b7d00ca2", "parents": ["8e26827ccc53b7375bc2482d5b809df066684cba"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037105 - Migrate markers in gfx/ layout/ modules/ mozglue/ widget/ to the new api. r=canova,profiler-reviewers,win-reviewers,layout-reviewers,jfkthame,gstoll\n\nIn CompositorAnimationMarker, nsCSSProps::GetStringValue returns a non null-terminated string coming from rust but ETW does not support non null-terminated string. Tracked in Bug 2072225.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298557\n", "files": ["gfx/layers/CompositorAnimationStorage.cpp", "gfx/layers/ipc/CompositorBridgeParent.cpp", "layout/base/AutoProfilerStyleMarker.h", "modules/libpref/Preferences.cpp", "mozglue/baseprofiler/public/BaseProfilerMarkerTypes.h", "mozglue/baseprofiler/public/BaseProfilerMarkersDetail.h", "mozglue/tests/TestBaseProfiler.cpp", "widget/windows/nsWindowDbg.cpp"], "git_node": "b8ab5304fe721c16dbb53d1dd52c5f314cd2a2db", "git_parents": ["2310ec4e3acd91ec393fa85345224862c9a326f5"], "node": "b6b499ed6e29635bde8b93195233cf5d54ab40f6", "parents": ["faedc7e2db4191703abaa916be980645b7d00ca2"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1456885 - Rename SpeechGrammarList.addFromURI to SpeechGrammarList.addFromUri to match Chrome r=webidl,media-webspeech-reviewers,pehrsons,smaug\n\nThis is an inert interface that exist solely for web compat, and it\ndoesn't do anything to the Speech Recognition process.\n\nWe don't need to implement it for Web Compat. I have implemented some\nbits of the rest of the interface so it returns things that are\nmeaningful, but that is apparently not needed either. We might be able\nto remove that when we're a bit more confident.\n\nBecause of the wrong capitalization, it was not found, breaking Google\nDocs. I also removed exception throwing that weren't necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326946\n", "files": ["dom/media/webspeech/recognition/SpeechGrammar.cpp", "dom/media/webspeech/recognition/SpeechGrammar.h", "dom/media/webspeech/recognition/SpeechGrammarList.cpp", "dom/media/webspeech/recognition/SpeechGrammarList.h", "dom/webidl/SpeechGrammar.webidl", "dom/webidl/SpeechGrammarList.webidl", "testing/web-platform/tests/speech-api/idlharness.https.window.js"], "git_node": "6313be64d46fbe13f94711be6ee39d26f85c5ea1", "git_parents": ["b8ab5304fe721c16dbb53d1dd52c5f314cd2a2db"], "node": "abab50dc7c4451c5b17dd6d7ad42b8d2fc1be416", "parents": ["b6b499ed6e29635bde8b93195233cf5d54ab40f6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039862 - Update onnxruntime toolchain to v1.30.0. r=firefox-build-system-reviewers,ai-platform-reviewers,sergesanspaille,valentinp\n\nThe patch directory is declared as a toolchain resource so that editing a patch changes the task digest\nand triggers a rebuild instead of reusing the cached artifact.\n\nThe build passes --no_telemetry. Telemetry is on by default in this release, including a non-Windows\nclient that uploads to mobile.events.data.microsoft.com. Our build only escapes it because\n--disable_exceptions makes upstream treat the target as telemetry-unsupported, so the opt-out is stated\nexplicitly and the configured value is read back from CMakeCache.txt after cmake runs, so a renamed flag\nor a future default change fails the build rather than silently shipping the client.\n\nA new patch disables the Windows device-discovery code path (DXGI/D3D12/DXCore probe), which crashes on\ndisplay-less CI workers and is irrelevant to a CPU-only build.\n\nThe exception-handling patches are updated for the new raw try/catch blocks in this release. Two new\npatches cover code that can't use ORT_TRY/ORT_CATCH: the onnx dependency's tensor.h and the new\nstandalone model_package library, which has no ORT dependency.\n\ndom/onnx/onnxruntime_c_api.h is refreshed, and the onnxruntime_ep_c_api.h and onnxruntime_error_code.h\nheaders that upstream split out of it are vendored alongside it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300775\n", "files": ["dom/onnx/Tensor.cpp", "dom/onnx/moz.build", "dom/onnx/onnxruntime_c_api.h", "dom/onnx/onnxruntime_ep_c_api.h", "dom/onnx/onnxruntime_error_code.h", "taskcluster/kinds/fetch/onnxruntime.yml", "taskcluster/kinds/toolchain/onnx.yml", "taskcluster/scripts/misc/build-onnxruntime.sh", "taskcluster/scripts/misc/fetch-onnxruntime-deps.sh", "taskcluster/scripts/misc/onnxruntime.patches/0001-Decrease-CMake-minimal-version-requirement.patch", "taskcluster/scripts/misc/onnxruntime.patches/0001-Disable-Windows-device-discovery-to-avoid-DXGI-probe.patch", "taskcluster/scripts/misc/onnxruntime.patches/0002-Replace-gsl-narrow-by-static_cast-as-the-former-can-.patch", "taskcluster/scripts/misc/onnxruntime.patches/0003-Replace-exception-throwing-code-by-abort-and-remove-.patch", "taskcluster/scripts/misc/onnxruntime.patches/0004-Disable-ORT-Stream.patch", "taskcluster/scripts/misc/onnxruntime.patches/0005-Allow-disable_exceptions-without-minimal_build.patch", "taskcluster/scripts/misc/onnxruntime.patches/0006-Fix-onnx-tensor.h-raw-throw-with-exceptions-disabled.patch", "taskcluster/scripts/misc/onnxruntime.patches/0006-Separate-provider-compilation-from-its-archive-on-MS.patch", "taskcluster/scripts/misc/onnxruntime.patches/0007-Avoid-exceptions-in-the-standalone-model_package-lib.patch", "tools/lint/header-guards.yml", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "28030c037bf16c2af597ca4ecb6d395d5766ba0c", "git_parents": ["6313be64d46fbe13f94711be6ee39d26f85c5ea1"], "node": "e51dd1e585412c3cb0e6c44747ab4d5b6fc186a7", "parents": ["abab50dc7c4451c5b17dd6d7ad42b8d2fc1be416"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039862 - Enable onnxruntime toolchains for Linux and Windows aarch64. r=firefox-build-system-reviewers,sergesanspaille\n\nAdds onnxruntime toolchain tasks for Windows and Linux aarch64, wires build-onnxruntime.sh to\ncross-compile, and wires the linux64-aarch64 and win64-aarch64 desktop builds to fetch the new\nartifacts.\n\nAlso drops the stale reference to deferring 32-bit Linux support since support was dropped.\n\nThe aarch64 link needs lld, since the build image's binutils only knows x86 emulations. It goes in\nTARGET_FLAGS the way the macOS cross build does it, and both Linux arches use it so they build the\nsame way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300776\n", "files": ["taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/toolchain/onnx.yml", "taskcluster/scripts/misc/build-onnxruntime.sh"], "git_node": "6ce4621fe794bff77d0ebfc3f6cc665aed4a5ae2", "git_parents": ["28030c037bf16c2af597ca4ecb6d395d5766ba0c"], "node": "d80c869260636a2e4feada656c394f1cfc522f84", "parents": ["e51dd1e585412c3cb0e6c44747ab4d5b6fc186a7"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071438 - [Monitor Agent][Models] Show a desktop notification when a monitor is created r=fluent-reviewers,tetchart,ngrato,bolsson\n\nFires once from MonitorAgent.createMonitor through the same nsIAlertsService\npath the condition-met alerts use, so users learn up front how a match will be\nannounced. It names the monitor and the first watched site, is not repeated on\nedit, pause/resume or startup restore, and clicking it opens\nabout:smartwindowtasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325498\n", "files": ["browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "1739e4add846fba9284ff772f96bd6da5304f516", "git_parents": ["6ce4621fe794bff77d0ebfc3f6cc665aed4a5ae2"], "node": "4a8386ee966a2e04fb1fe2e8f77345a93f23aa56", "parents": ["d80c869260636a2e4feada656c394f1cfc522f84"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix broken links in the DevTools user documentation r=devtools-reviewers,nchevobbe DONTBUILD\n\nThe Call Tree, paint flashing and event listener pages these referred to no\nlonger exist or moved under page_inspector/how_to. The console message icons\nwere rST substitutions defined inside an eval-rst block, which the nested\nparse discards, so the table is now a MyST list-table with markdown images.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325695\n", "files": ["devtools/docs/user/debugger-api/index.md", "devtools/docs/user/memory/aggregate_view/index.md", "devtools/docs/user/migrating_from_firebug/index.md", "devtools/docs/user/page_inspector/how_to/work_with_animations/index.md", "devtools/docs/user/tips/index.md", "devtools/docs/user/tools_toolbox/index.md", "devtools/docs/user/web_console/console_messages/index.md"], "git_node": "e1b70c2a61ebc97ec680afd6d2791627e01355e5", "git_parents": ["1739e4add846fba9284ff772f96bd6da5304f516"], "node": "c819b7079094ddd31da83ca320f211f700e75cb8", "parents": ["4a8386ee966a2e04fb1fe2e8f77345a93f23aa56"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066040 - Update the crashreporter docs r=gsvelto,crashreporting-reviewers,schopin DONTBUILD\n\nThis updates a few things related to how crash pings and the crash\nreporter client work.\n\nThese docs could use a lot more updating (e.g., discussion of the crash\nhelper).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326060\n", "files": ["toolkit/crashreporter/docs/index.md"], "git_node": "596a68ee81ee3591c807b873edf5446f1493b980", "git_parents": ["e1b70c2a61ebc97ec680afd6d2791627e01355e5"], "node": "2422f6676cad84c26320ea1a5555274cd4a239fe", "parents": ["c819b7079094ddd31da83ca320f211f700e75cb8"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066867 - Get rid of dom.pointer-lock.reset-to-center-from-parent; r=smaug\n\nThe pref has been enabled by default, so drop it together with the code paths\nwhich recentered the pointer from the content process.\n\nThe native pointer is therefore always locked by the parent process itself,\nso the LockNativePointer/UnlockNativePointer IPC can be removed.\n\nSynthesizeNativeMouseMove IPC can also be restricted to automation, too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326166\n", "files": ["dom/base/PointerLockManager.cpp", "dom/events/EventStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "dom/tests/mochitest/pointerlock/test_pointerlock_xorigin_iframe_movementXY.html", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/pointerlock/pointerlock-maintains-mousedown.html.ini", "widget/PuppetWidget.cpp"], "git_node": "7100ef052864af0a89a43e6717307cc5d9b39034", "git_parents": ["596a68ee81ee3591c807b873edf5446f1493b980"], "node": "695382655afeb87a8b7d9265f7dc24c217429c81", "parents": ["2422f6676cad84c26320ea1a5555274cd4a239fe"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072646 - Make HostRecordQueue eviction-queue checks O(1) r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326522\n", "files": ["netwerk/dns/HostRecordQueue.cpp", "netwerk/dns/HostRecordQueue.h", "netwerk/dns/nsHostRecord.h"], "git_node": "810aa7f0807b5e47abd2dd042740a29a9b35839b", "git_parents": ["7100ef052864af0a89a43e6717307cc5d9b39034"], "node": "09b7acee46e734ddf915bf1f5b6d07135bc304c9", "parents": ["695382655afeb87a8b7d9265f7dc24c217429c81"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072856 - CookieStore should check if a path attribute is empty, r=valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326974\n", "files": ["dom/cookiestore/CookieStore.cpp", "testing/web-platform/tests/cookiestore/cookieStore_set_path.https.window.js"], "git_node": "11e772f16378c0acc23e8e10943e08e3955df4b9", "git_parents": ["810aa7f0807b5e47abd2dd042740a29a9b35839b"], "node": "2be50611517ac0a7a0868af6c78f309b9043b2c9", "parents": ["09b7acee46e734ddf915bf1f5b6d07135bc304c9"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071018 - Update cached Attr nodes' owner document when adopting an element. r=dom-core-reviewers,smaug\" for causing wpt failures at adoptNode.html\n\nThis reverts commit 6124a03a3752596558a80571d782294d0289e748.\n", "files": ["dom/base/Attr.cpp", "dom/base/Attr.h", "dom/base/AttrArray.cpp", "dom/base/AttrArray.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsDOMAttributeMap.h", "dom/base/nsINode.cpp", "testing/web-platform/tests/dom/nodes/Document-adoptNode.html"], "git_node": "e097da4aa9d90150d1816fba94cbe19f29701c70", "git_parents": ["11e772f16378c0acc23e8e10943e08e3955df4b9"], "node": "8b86744d3b2ab93e84bea5ff116f5c137d1759a4", "parents": ["2be50611517ac0a7a0868af6c78f309b9043b2c9"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071415 - Parse more options for Declarative Web Push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326706\n", "files": ["dom/push/Declarative.cpp", "dom/push/rust/src/declarative_push.rs", "testing/web-platform/mozilla/meta/push-api/__dir__.ini", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/push-api/declarative.https.any.js"], "git_node": "4f997b5663c38184cbd219321b7aff1845547b46", "git_parents": ["e097da4aa9d90150d1816fba94cbe19f29701c70"], "node": "3ee0f7a6a56be0497dcca53abe6d6eca67f126b1", "parents": ["8b86744d3b2ab93e84bea5ff116f5c137d1759a4"], "tags": []}, {"author": "Denis Palmeiro \u003cdpalmeiro@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070220: Use a futex-backed allocator mutex on Windows. r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324361\n", "files": ["memory/build/Mutex.cpp", "memory/build/Mutex.h", "memory/replace/logalloc/replay/moz.build", "mozglue/misc/Mutex_futex.cpp", "mozglue/misc/PlatformMutex.h", "xpcom/base/nsTraceRefcnt.cpp"], "git_node": "256287a54f5107ca8407328d9734f4e859208c07", "git_parents": ["4f997b5663c38184cbd219321b7aff1845547b46"], "node": "b3cf98f47353c5d1496eccd83d50ed8b6959344d", "parents": ["3ee0f7a6a56be0497dcca53abe6d6eca67f126b1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1554779 - Raise the geckoview-junit suite timeout to 4800s on debug and ccov builds. r=releng-reviewers,jcristau\n\nThe debug junit suite has been taking 2500-3000s since bug 1958658 made TextInputDelegateTest launch an\nActivity per test, so the unchunked job now regularly runs past runjunit's 3000s --max-time while tests are\nstill passing. Opt runs take about half that, so only debug and ccov get the extra headroom; a hang still\nfails through runjunit before the task max-run-time. This adds a --max-time passthrough to the mozharness\nAndroid script so the value can vary by platform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326820\n", "files": ["taskcluster/kinds/test/misc.yml", "testing/mozharness/scripts/android_emulator_unittest.py"], "git_node": "130c91140d95f6be79e0985d92f24c2950a38710", "git_parents": ["256287a54f5107ca8407328d9734f4e859208c07"], "node": "1e36cdbf9f5e3ea1b21143ed1feb82563f4fc721", "parents": ["b3cf98f47353c5d1496eccd83d50ed8b6959344d"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069149 - Build out the selection shortcuts panel to hold multiple actions. r=fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,pdahiya,jsudiaman,kcochrane,bolsson\n\nFor background on the new Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nCurrently only the AI control is visible. The search, copy and 3-dot menu\ncontrols are hidden for now until their behavior is hooked up in later\npatches.\n\nYou can manually test this patch to see the layout before the behavior has\nbeen hooked up. In `main-popupset.inc.xhtml`, remove `hidden=\"true\"` for\neach of the 3 new `moz-button`s. Then set `browser.ml.chat.provider` to\n`https://chatgpt.com`, add `aichat` to `sidebar.main.tools`, and select\nsome text on a page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325917\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/locales/en-US/browser/genai.ftl", "browser/themes/shared/tabbrowser/content-area.css", "python/l10n/fluent_migrations/bug_2069149_genai_shortcut_button_tooltip.py"], "git_node": "dc341eb6391e8154291ddd744639ffe76b16bdff", "git_parents": ["130c91140d95f6be79e0985d92f24c2950a38710"], "node": "edaf50f030966b8c505bf41736606d2e667a2eb3", "parents": ["1e36cdbf9f5e3ea1b21143ed1feb82563f4fc721"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071928 - Flipped pref toolbar panel enabled on for Smart Window Monitor r=ngrato\" for causing failures on browser_876926_customize_mode_wrapping.\n\nThis reverts commit 75c7e30562330e7a71b27e604bf747c60ceaf1e5.\n", "files": ["browser/app/profile/firefox.js"], "git_node": "f8b06b3ba05dfbec7f53a6ed7f5daa89158d5330", "git_parents": ["dc341eb6391e8154291ddd744639ffe76b16bdff"], "node": "00e453d9a8f1208fc2c38cb1299c691e35862b8f", "parents": ["edaf50f030966b8c505bf41736606d2e667a2eb3"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1456885 - Rename SpeechGrammarList.addFromURI to SpeechGrammarList.addFromUri to match Chrome r=webidl,media-webspeech-reviewers,pehrsons,smaug\" for causing wpt and TVw failures at SpeechGrammarList\n\nThis reverts commit 6313be64d46fbe13f94711be6ee39d26f85c5ea1.\n", "files": ["dom/media/webspeech/recognition/SpeechGrammar.cpp", "dom/media/webspeech/recognition/SpeechGrammar.h", "dom/media/webspeech/recognition/SpeechGrammarList.cpp", "dom/media/webspeech/recognition/SpeechGrammarList.h", "dom/webidl/SpeechGrammar.webidl", "dom/webidl/SpeechGrammarList.webidl", "testing/web-platform/tests/speech-api/idlharness.https.window.js"], "git_node": "26b59a80d97cf62e15ade331ad4ce2db29c159b7", "git_parents": ["f8b06b3ba05dfbec7f53a6ed7f5daa89158d5330"], "node": "01ef864aac57c47849c00c25cde5402afebdf2f9", "parents": ["00e453d9a8f1208fc2c38cb1299c691e35862b8f"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072255 Hide ListenSheet when switching tabs. r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326219\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/listentopage/build.gradle", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/readerview/src/test/java/mozilla/components/feature/readerview/internal/ReaderViewControlsInteractorTest.kt", "mobile/android/android-components/components/feature/readerview/src/test/java/mozilla/components/feature/readerview/view/ReaderViewControlsBarTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenSheetIntegration.kt"], "git_node": "5e556c7b8183a0c481c6501ca7c12087543edb2c", "git_parents": ["26b59a80d97cf62e15ade331ad4ce2db29c159b7"], "node": "a2f22e74386463a1260b564e6c8544d9df54c85d", "parents": ["01ef864aac57c47849c00c25cde5402afebdf2f9"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2067283 - Wire removal from autocomplete dropdown for form history. r=mtigley,credential-management-reviewers,dimi\n\nTo get the trashcan icon to appear in the dropdown, enable the pref `browser.autocomplete.removeRecords.enabled`.\n\nDispatch the trash button's secondary action through the existing `fillMessageName`\npath rather than a dedicated `removeEntry` flag, so every provider removes a record\nthe same way. The row carries the entry's identity in `fillMessageData`,\n`FormHistoryParent` performs the removal, and the child re-runs the search so the\nremoved row leaves the open popup.\n\nAlso drop `FormHistoryParent`'s cached incremental search result on removal.\nOtherwise `incrementalSearch` keeps filtering the stale array and serves the removed\nentry back for every longer search string, which also affects the\nDelete/Shift+Backspace shortcut.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325487\n", "files": ["toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/FormHistoryAutoComplete.sys.mjs", "toolkit/components/satchel/FormHistoryChild.sys.mjs", "toolkit/components/satchel/FormHistoryParent.sys.mjs", "toolkit/components/satchel/test/browser/browser_popup_secondary_action.js"], "git_node": "70b67352b9e5ba29b7e9baa39d299589fce73d4a", "git_parents": ["5e556c7b8183a0c481c6501ca7c12087543edb2c"], "node": "e912c1b857f2190a27a9896d170aa5d28febc13e", "parents": ["a2f22e74386463a1260b564e6c8544d9df54c85d"], "tags": []}, {"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2070482 - Fix enlarged Firefox logo in splash screen when animations disabled r=emcminn,omc-reviewers\n\n- Updated the svg's viewBox\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326559\n", "files": ["browser/components/aboutwelcome/assets/splash-logo.svg"], "git_node": "b54b5e5558ffd7c6b9c7e9a764d486e99fb00de0", "git_parents": ["70b67352b9e5ba29b7e9baa39d299589fce73d4a"], "node": "77a3e32820056991b826f3e09a303c5fb7b51f04", "parents": ["e912c1b857f2190a27a9896d170aa5d28febc13e"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072213 - Consider speculative loads on links changes. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326223\n", "files": ["dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini"], "git_node": "f0d4b2436bec9cd911c801370e4bab691788c02f", "git_parents": ["b54b5e5558ffd7c6b9c7e9a764d486e99fb00de0"], "node": "b9aa603e7b62d341b55968966b079b77517f71fc", "parents": ["77a3e32820056991b826f3e09a303c5fb7b51f04"], "tags": []}, {"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2070459 - Fix focus outline overlap in FRO Terms of Use screen r=emcminn,omc-reviewers\n\n- Add extra bottom margin, tweak bottom border radius of Manage data collection settings button\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326303\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "a4453aa5d7e1015daa9c66673d21c8bc71559ed9", "git_parents": ["f0d4b2436bec9cd911c801370e4bab691788c02f"], "node": "35f2accdfb46c0d8cfe68d4e3851d894ae584a67", "parents": ["b9aa603e7b62d341b55968966b079b77517f71fc"], "tags": []}, {"author": "Thomas Nibler \u003cdev@tnibler.de\u003e", "branch": "default", "desc": "Bug 2071644 - Check Recovery SEI exact_match_flag is 1, not 0 r=alwu,media-playback-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325642\n", "files": ["dom/media/platforms/agnostic/bytestreams/H264.cpp", "dom/media/platforms/agnostic/bytestreams/gtest/TestByteStreams.cpp"], "git_node": "94d942143ea6bc3e8c6c05ccf8e206c5f9ad136f", "git_parents": ["a4453aa5d7e1015daa9c66673d21c8bc71559ed9"], "node": "dad2bf4c2b5c1b099f9a693497fdbb6337f2d917", "parents": ["35f2accdfb46c0d8cfe68d4e3851d894ae584a67"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065937 - Tag enumerated shortcuts with their location, and never overwrite shortcuts pointing to a different install. r=nrishel,hsohaney\n\nModified the enumerateInstallShortcuts function to also return the system-wide (common) start menu shortcut, which gets filtered out\nwhen applying icons. This is so that we ensure that the start menu shortcut we are looking up belongs to the same install, when checking\nif we need to create a copy of it in APPDATA's start menu. Previous version erroneously checked the file name without accounting for AUMID.\n\nIn the case where we must create the shortcut, but one already exists named \u003cMOZ_BRAND_NAME\u003e.lnk and belongs to a different install, we\nabort and disable the custom icon feature, to avoid overwriting existing shortcuts.\n\nThe follow-on work intended for https://bugzilla.mozilla.org/show_bug.cgi?id=2065599 is also consolidated in this patch.\n\nFor reference this is the invocation point of the functions modified: https://searchfox.org/firefox-main/rev/298cf786229591e2159a3933605df11e07709d6f/browser/components/shell/StartupOSIntegration.sys.mjs#189-192\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322371\n", "files": ["browser/components/shell/CustomIconManager.sys.mjs", "browser/components/shell/nsIWindowsShellService.idl", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/test/unit/test_customIconManager.js"], "git_node": "53c2162c6ff4e593d798f000a0d4a1203a978d02", "git_parents": ["94d942143ea6bc3e8c6c05ccf8e206c5f9ad136f"], "node": "2903e6c049bc4bdc166906909c753f482d0141e3", "parents": ["dad2bf4c2b5c1b099f9a693497fdbb6337f2d917"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2047496 - Make mozilla::Maybe\u003cT\u003e formattable. r=sergesanspaille\n\nAdds a fmt::formatter specialization for mozilla::Maybe\u003cT\u003e, enabled when T\nis itself formattable. Nothing formats as \"\u003cNothing\u003e\"; Some(t) formats as t.\n\nUsing fmt::ostream_formatter (the simpler approach) would delegate to\noperator\u003c\u003c, which has different semantics from fmt for primitive types: bool\nformats as \"1\" instead of \"true\", and floats use 6-decimal precision instead\nof shortest round-trip. A full specialization forwarding parse() and format()\nto fmt::formatter\u003cT\u003e is needed for correct output.\n\nfmt/base.h is included after the mozilla headers because it uses MFBT_API,\nwhich requires mozilla/Types.h to be included first.\n\nBased on an initial patch by Masayuki Nakano.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306783\n", "files": ["mfbt/MaybeFmt.h", "mfbt/api.yml", "mfbt/moz.build", "mfbt/tests/gtest/TestFormattingAndStreaming.cpp"], "git_node": "6e35cf6ac5c34ad781febbb63c1da638f76595b4", "git_parents": ["53c2162c6ff4e593d798f000a0d4a1203a978d02"], "node": "cbce3ea562ed2de6ee91d9f98edd45c6fb7faf5c", "parents": ["2903e6c049bc4bdc166906909c753f482d0141e3"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072978 - Wait for about:logins to be initialized in browser_loginListChanges.js r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326895\n", "files": ["browser/components/aboutlogins/tests/browser/browser_loginListChanges.js"], "git_node": "e3790df3326ce0eff8010c7043b5dc33cba423d2", "git_parents": ["6e35cf6ac5c34ad781febbb63c1da638f76595b4"], "node": "60bb75d2ea208d0b403f5e8c53cbbec6fe3478b7", "parents": ["cbce3ea562ed2de6ee91d9f98edd45c6fb7faf5c"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035395 - Rebuild IPProtectionMenuItem on IconListItem r=android-reviewers,tthibaud\n\nConvert IPProtectionMenuItem to use the existing IconListItem from the design system. The implementation is based on IconListItem instead of MenuItem because MenuItem calls clearAndSetSemantics on the whole row, merging it into one node. That's ok for a row with a single action, but here the row has two actions:\n- Toggle IP protection (row click)\n- Navigate to settings (chevron click)\n\nSo merging would break the click event on the chevron icon. IconListItem is the underlying component MenuItem is built on, so the row keeps design system styling while the chevron remains accessible through TalkBack.\n\nThe data limit string now uses IconListItem description instead of a caption Text, matching ExtensionsMenuItem and other menu items.\n\nThis patches also fixes debouncedClickable, which started lastClickTime at 0 and so swallowed the first click in tests, as Robolectric initializes SystemClock at 0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321591\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/modifier/Modifier.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItemTest.kt"], "git_node": "0d80e0ff94531f3f3e5652ed2a82020bf7e3ba20", "git_parents": ["e3790df3326ce0eff8010c7043b5dc33cba423d2"], "node": "03770316959876fb3139718f1e43f1b8f197ca68", "parents": ["60bb75d2ea208d0b403f5e8c53cbbec6fe3478b7"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071099 - update panel border and footer clipping. r=sfoster,desktop-theme-reviewers,tabbrowser-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326271\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "d3e7209270e80f1afaf7945fe2cab47018fe0f6f", "git_parents": ["0d80e0ff94531f3f3e5652ed2a82020bf7e3ba20"], "node": "98bdb8213106035b828fa7f3862cc626b8907579", "parents": ["03770316959876fb3139718f1e43f1b8f197ca68"], "tags": []}, {"author": "Mubashshir \u003cahmubashshir@gmail.com\u003e", "branch": "default", "desc": "Bug 2072519 - Use icon URL for sidebar extension switcher r=sidebar-reviewers,jsudiaman\n\nUse the sidebar's icon URL when setting the extension menu item\nimage so the icon is displayed in the old sidebar switcher.\n\nThis restores icon visibility for sidebar extensions when the sidebar\nrevamp is disabled.\n\nSigned-off-by: Mubashshir \u003cahmubashshir@gmail.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326401\n", "files": ["browser/components/sidebar/browser-sidebar.js"], "git_node": "a97ee806bac05726513dbc44b1a98afa318912b4", "git_parents": ["d3e7209270e80f1afaf7945fe2cab47018fe0f6f"], "node": "e89b72760469877d92cef80a53cc6c07823588e9", "parents": ["98bdb8213106035b828fa7f3862cc626b8907579"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2068782 - Add base styling for AITab components - r=jlewis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325221\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-shared.css", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn"], "git_node": "305b2f30926fd1385128c414219b41b4a66deec9", "git_parents": ["a97ee806bac05726513dbc44b1a98afa318912b4"], "node": "a116de0ae582db046470ad394cd847a6dd265177", "parents": ["e89b72760469877d92cef80a53cc6c07823588e9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2015990 - Make SVG intrinsic sizing a bit more sensible. r=layout-reviewers,firefox-svg-reviewers,dholbert\n\nmax-content and min-content should match except maybe on the weird case\nwhere we return the fallback intrinsic size... But other browsers do\nmatch that, so let's do it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326903\n", "files": ["layout/generic/AspectRatio.h", "layout/svg/SVGOuterSVGFrame.cpp", "testing/web-platform/tests/css/css-sizing/svg-intrinsic-size-009.html", "testing/web-platform/tests/css/css-sizing/svg-intrinsic-size-010.html"], "git_node": "365a6c9a7f990ba9c50146554db60f8f42d2d148", "git_parents": ["305b2f30926fd1385128c414219b41b4a66deec9"], "node": "6e1d83cbc8f32f1df93151f1b542178b5c870915", "parents": ["a116de0ae582db046470ad394cd847a6dd265177"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071645. r=Standard8,places-reviewers,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326209\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser/browser_dragdropURL.js", "toolkit/components/places/BookmarkHTMLUtils.sys.mjs", "toolkit/components/places/PlacesUtils.sys.mjs"], "git_node": "ee0057543d741f9a3a346514b8ba67ea65932a5b", "git_parents": ["365a6c9a7f990ba9c50146554db60f8f42d2d148"], "node": "ad477655dc820ebc0485ed9598435596cadb96eb", "parents": ["6e1d83cbc8f32f1df93151f1b542178b5c870915"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047496 - Make mozilla::Maybe\u003cT\u003e formattable. r=sergesanspaille\" for causing build bustages\n\nThis reverts commit 6e35cf6ac5c34ad781febbb63c1da638f76595b4.\n", "files": ["mfbt/MaybeFmt.h", "mfbt/api.yml", "mfbt/moz.build", "mfbt/tests/gtest/TestFormattingAndStreaming.cpp"], "git_node": "c1d4a1d722ad9bb23de5b47e234a64add5e5de73", "git_parents": ["ee0057543d741f9a3a346514b8ba67ea65932a5b"], "node": "4080997c447f28cf36f550cec6f6ce90836c8424", "parents": ["ad477655dc820ebc0485ed9598435596cadb96eb"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2015990 - Make SVG intrinsic sizing a bit more sensible. r=layout-reviewers,firefox-svg-reviewers,dholbert\" for causing devtools failures at timeline-tick.js\n\nThis reverts commit 365a6c9a7f990ba9c50146554db60f8f42d2d148.\n", "files": ["layout/generic/AspectRatio.h", "layout/svg/SVGOuterSVGFrame.cpp", "testing/web-platform/tests/css/css-sizing/svg-intrinsic-size-009.html", "testing/web-platform/tests/css/css-sizing/svg-intrinsic-size-010.html"], "git_node": "5d56b220108420b17092cffd0f9d03b61405f711", "git_parents": ["c1d4a1d722ad9bb23de5b47e234a64add5e5de73"], "node": "32dfcb8826fe92037815f0923090f12e32334687", "parents": ["4080997c447f28cf36f550cec6f6ce90836c8424"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066545 - Part 1: Extract shared media sink gtest helpers into a common header. r=padenot,media-playback-reviewers\n\nMove the tail-dispatch macro and the audio sink wrapper builder into a shared\nheader, and use it from the audio sink wrapper and decoded stream tests.\n\nBoth tests carried their own copy of each. A gtest body runs outside a\nprocessed event and so has no tail dispatcher, which means every sink test\nneeds the same re-entry macro before it can order work the way production\ndoes, and a further sink test could not be added without a third copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323706\n", "files": ["dom/media/gtest/MediaSinkTestUtils.h", "dom/media/gtest/TestAudioSinkWrapper.cpp", "dom/media/gtest/TestDecodedStream.cpp"], "git_node": "1f664586e471ffcb75c646b84f0d06ab1ccd070a", "git_parents": ["5d56b220108420b17092cffd0f9d03b61405f711"], "node": "1c44a2b1609ad802c1539b17950328b08e41d87f", "parents": ["32dfcb8826fe92037815f0923090f12e32334687"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066545 - Part 2: Add a gtest asserting A/V sync for the default playback sink pair. r=padenot,media-playback-reviewers\n\nAdd a new test covering VideoSink with AudioSinkWrapper for A/V sync. The sink\nplaces each frame at a wall-clock instant derived from the audio clock and the\nplayback rate, so being in sync means every queued frame sits on that line. A\nschedule left anchored to a superseded clock, as a seek, a stream handoff or a\nrate change can leave, shows up directly, and a second check holds the frame\ncadence to the rate.\n\nThe clock is driven by hand, which keeps real time out of the measurement.\nSampling live playback could not be stabilised: the mock backend drifts from\nthe wall clock by an amount set by the machine rather than by the code, and no\ntolerance separates that drift from a real desync.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323707\n", "files": ["dom/media/gtest/MediaSinkTestUtils.h", "dom/media/gtest/TestAVSync.cpp", "dom/media/gtest/moz.build"], "git_node": "b9c463acfa6e3106073388df2e90f82a2929ac44", "git_parents": ["1f664586e471ffcb75c646b84f0d06ab1ccd070a"], "node": "370ac6d4345ce9309b39525730e45691ec416c83", "parents": ["1c44a2b1609ad802c1539b17950328b08e41d87f"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066545 - Part 3: Add A/V sync tests for a seek and resume. r=padenot,media-playback-reviewers\n\nA seek rebases the clock the video schedule is derived from, so it is where the\npicture is most likely to end up away from the sound. Each case below runs\ntwice, once with the audio stream reused across the seek and once with a fresh\none, because only the reused path carries a clock baseline over.\n\nTwo cases. The first seeks mid-playback and requires the schedule to be rebased\nonto the resumed clock rather than left on the pre-seek one. The second drains\nthe audio the device has not played yet, with no callback in between, and\nrequires the clock to follow what was rendered instead of stepping only once\nper callback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323708\n", "files": ["dom/media/gtest/TestAVSync.cpp"], "git_node": "3587a9d124cf96c9141231fadd1878d74030514c", "git_parents": ["b9c463acfa6e3106073388df2e90f82a2929ac44"], "node": "f43f6db2c8e0ac1dcf857bd591f992225952e9e2", "parents": ["370ac6d4345ce9309b39525730e45691ec416c83"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066545 - Part 4: Bound the A/V sync schedule check by direction rather than by distance. r=padenot,media-playback-reviewers\n\nThe schedule check fails intermittently on CI, because the sink and the check\neach read the audio clock and there is a delay between the two reads.\n\nThe problem. The sink reads the clock once and places every frame relative to\nthat reading. The check reads the clock again and confirms each frame landed\nwhere that reading calls for. A test drives the clock by hand, so between the\ntwo reads the clock stands still while real time keeps moving:\n\n  sink  reads clock=0.5s at 10:00:00.000  -\u003e  places frame at 10:00:00.500\n  check reads clock=0.5s at 10:00:00.008  -\u003e  expects frame at 10:00:00.508\n                                                            ^^^ 8ms apart\n\nThat 8ms is only how long the machine took to get from one read to the other,\nand nothing is out of sync. The old check allowed 20ms of slack either way, so\nit passed until a busy machine took longer; 22.55ms right after a build was\nenough to fail.\n\nThe fix. The delay leaves the instant a schedule implies in the past, while a\nsuperseded clock leaves it in the future, and no correct schedule is anchored\nin the future since the sink can only read a clock that has already happened.\nThe two are opposites, so they get separate bounds: 250ms into the past, which\nno defect can reach, and 2ms into the future, where the right answer is zero.\n\nThis is sharper as well as steadier. A schedule left 5ms stale now fails,\nwhere 20ms both ways let it pass, and the tests hold with every core busy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326990\n", "files": ["dom/media/gtest/TestAVSync.cpp"], "git_node": "5efd75cc5566e4666ae8c553ad31a4211be7c522", "git_parents": ["3587a9d124cf96c9141231fadd1878d74030514c"], "node": "62a49e840252a257a42f597837dcdfc6db89a23c", "parents": ["f43f6db2c8e0ac1dcf857bd591f992225952e9e2"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049285 - Fix issue for 'Show in Folder' for virtualized bookmark items when there are many bookmarks r=sidebar-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326260\n", "files": ["browser/components/sidebar/sidebar-bookmark-list.mjs", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_bookmarks_show_in_folder_virtualized.js"], "git_node": "04ed2f7551053cd8f05988bd3465efe7e6c00673", "git_parents": ["5efd75cc5566e4666ae8c553ad31a4211be7c522"], "node": "8a2b5f42b4389b14d452b9b41a446cd46b5ba6b6", "parents": ["62a49e840252a257a42f597837dcdfc6db89a23c"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070768 - quotation mark in host name should make URIFixup resolve the string as a possible search. r=jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326288\n", "files": ["docshell/base/URIFixup.sys.mjs", "docshell/test/unit/test_URIFixup_search.js"], "git_node": "8400c8b8d434ab4a88d24e925ab09ccd9c7e3754", "git_parents": ["04ed2f7551053cd8f05988bd3465efe7e6c00673"], "node": "e89a4f8b7f413b0bc8259bedb71151836c4645ad", "parents": ["8a2b5f42b4389b14d452b9b41a446cd46b5ba6b6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069910: Have nsHttpTransaction read a clone of the upload stream r=nika,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326725\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "9c1a3bcac63b92db8408d44244d062952853ba81", "git_parents": ["8400c8b8d434ab4a88d24e925ab09ccd9c7e3754"], "node": "49eabb956bbb1f9eea1da7fffd7babfb9ee817f2", "parents": ["e89a4f8b7f413b0bc8259bedb71151836c4645ad"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2070651 - chore(webgpu): update CTS to a2134bc7916dc6004781a137690b8741aef9aae1 r=webgpu-reviewers,aleiserson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324727\n", "files": ["dom/webgpu/tests/cts/checkout/.eslintrc.cjs", "dom/webgpu/tests/cts/checkout/.eslintrc.json", "dom/webgpu/tests/cts/checkout/package-lock.json", "dom/webgpu/tests/cts/checkout/package.json", "dom/webgpu/tests/cts/checkout/src/webgpu/api/operation/vertex_state/correctness.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/capability_info.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/expression/access/vector.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/extension/subgroup_size_control.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/parse/requires.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/util/texture/color_space_conversions.spec.ts", "dom/webgpu/tests/cts/checkout/tools/gen_version", "dom/webgpu/tests/cts/moz.yaml", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/vertex_state/correctness/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/render_pipeline/vertex_state/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/expression/access/vector/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/parse/requires/cts.https.html.ini", "testing/web-platform/mozilla/tests/webgpu/common/internal/version.js", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/shader/validation/expression/access/vector/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/shader/validation/parse/requires/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/webgpu/api/operation/vertex_state/correctness.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/capability_info.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/expression/access/vector.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/extension/subgroup_size_control.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/parse/requires.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/util/texture/color_space_conversions.spec.js"], "git_node": "7e9ba94ba416ff52ac549b42fd59c8eed2dd4e13", "git_parents": ["9c1a3bcac63b92db8408d44244d062952853ba81"], "node": "519270ef93a9cef1bd39d1b748fd0ddd3cc835de", "parents": ["49eabb956bbb1f9eea1da7fffd7babfb9ee817f2"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071194 - Compare cache free-space guards in consistent units (kB), r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326194\n", "files": ["netwerk/cache2/CacheFileIOManager.cpp"], "git_node": "4fb978b3d3c3b441f3d1e2b332fa89747f53558f", "git_parents": ["7e9ba94ba416ff52ac549b42fd59c8eed2dd4e13"], "node": "b430336a1cf5ba200cddbe9419d65c416faf175c", "parents": ["519270ef93a9cef1bd39d1b748fd0ddd3cc835de"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072873 - Make `./mach install-moz-phab --force` recreate the uv tool environment r=firefox-build-system-reviewers,sylvestre\n\n`uv tool install --force` only replaces the shim. When the Python behind the\ntool environment is upgraded in place, compiled dependencies such as rpds\nfail to import until the environment is rebuilt, which needs `--reinstall`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326833\n", "files": ["tools/phabricator/mach_commands.py"], "git_node": "496d03936d9e053a316fe21f85e167b63a9efd50", "git_parents": ["4fb978b3d3c3b441f3d1e2b332fa89747f53558f"], "node": "3d7569eb13e42a519daeef4b6581b831ccd88f64", "parents": ["b430336a1cf5ba200cddbe9419d65c416faf175c"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072213 - Consider speculative loads on links changes. r=dom-core-reviewers,jjaschke\" for causing wpt failures at Document.h\n\nThis reverts commit f0d4b2436bec9cd911c801370e4bab691788c02f.\n", "files": ["dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini"], "git_node": "ca946e41c73c037409b841a9cfaf324d494de139", "git_parents": ["496d03936d9e053a316fe21f85e167b63a9efd50"], "node": "cf401ba38c199f31167a82cccbd28570f41fa3bc", "parents": ["3d7569eb13e42a519daeef4b6581b831ccd88f64"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045704: Validate LoadInfoArgs and HTTP channel flags r=necko-reviewers,nika,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305263\n", "files": ["netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h"], "git_node": "91f409f7391cf7e2587dcfa48570e2b7007a5c3f", "git_parents": ["ca946e41c73c037409b841a9cfaf324d494de139"], "node": "1ff3ffd34ab8c5e5ff7c46164bf01affe1bbaa57", "parents": ["cf401ba38c199f31167a82cccbd28570f41fa3bc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Stop installing the `nsinstall` into `dist/bin` r=firefox-build-system-reviewers,sergesanspaille\n\nThis was redundant because everything gets it from `NSINSTALL`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325638\n", "files": ["config/Makefile.in", "python/mozbuild/mozbuild/packaging.py"], "git_node": "ad497987168e3510485f8d3d1b02cb45090854aa", "git_parents": ["91f409f7391cf7e2587dcfa48570e2b7007a5c3f"], "node": "9fd831774a8c0819797cfcc6eec23108c6696d19", "parents": ["1ff3ffd34ab8c5e5ff7c46164bf01affe1bbaa57"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069684: Add flexible space even when the user had removed the all tabs button r=Gijs\n\nAdded a new migration (28) that adds the flexible space even when the all tabs button is removed or if the user doesn't have a spring/flexible space after the `tabbrowser-tabs`\nUpdated tests to include this regression.\n\nFew examples:\n[tabbrowser-tabs][new-tab][FLEX SPACE][alltabs][organize][switcher] \u2502 window controls\n\nOr when smart window is disabled:\n[tabbrowser-tabs][new-tab*][FLEX SPACE] \u2502 window controls\n\nOr if the user added a custom spring/flex space:\n\n[tabs][new-tab][custom spring] -\u003e doesn\u2019t do anything\n[custom spring][tabs][new-tab][FLEX SPACE]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326685\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/test/unit/test_organize_tabs_migration.js", "browser/components/customizableui/test/unit/test_titlebar_spacer_migration.js"], "git_node": "432b20aecff0fc6bd6680aaad3357bff90eef5ed", "git_parents": ["ad497987168e3510485f8d3d1b02cb45090854aa"], "node": "f85a59548cdf08327fd888c69ffaa6104293f38b", "parents": ["9fd831774a8c0819797cfcc6eec23108c6696d19"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2069992 - Remove the legacy content recommendations endpoint and the Merino client flag r=android-reviewers,skhan\n\n- Delete ContentRecommendationEndpointRaw, ContentRecommendationsEndpoint, their tests and JSON fixtures\n- Drop useMerinoClient and the concept-fetch client that only the legacy endpoint needed\n- Remove the merino-client Nimbus feature and its secret setting\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324118\n", "files": ["mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/PocketStoriesConfig.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/PocketStoriesService.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/ContentRecommendationsUseCases.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationEndpointRaw.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpoint.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsResponse.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/PocketStoriesConfigTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/helpers/PocketTestResources.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/ContentRecommendationsUseCasesTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpointRawTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpointTest.kt", "mobile/android/android-components/components/service/pocket/src/test/resources/pocket/content_recommendations_null_url_response.json", "mobile/android/android-components/components/service/pocket/src/test/resources/pocket/content_recommendations_response.json", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/docs/Secret-settings-debug-menu-instructions.md"], "git_node": "da57a8f8b63fbaab0de1ec0bf255e14546b9d513", "git_parents": ["432b20aecff0fc6bd6680aaad3357bff90eef5ed"], "node": "2f0bd86b184e2957e8213147882a15cc315e07d4", "parents": ["f85a59548cdf08327fd888c69ffaa6104293f38b"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072258 - Use currentColor to accent default nativeTheme buttons r=desktop-theme-reviewers,jules,dao,emilio,nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326274\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "e9de90e46ea0fda1a9e8d0a22384b94f67369974", "git_parents": ["da57a8f8b63fbaab0de1ec0bf255e14546b9d513"], "node": "7a3efdd048100a581a4956ff7142e51574f2394b", "parents": ["2f0bd86b184e2957e8213147882a15cc315e07d4"], "tags": []}, {"author": "Diego \u003cdiegodaf@gmail.com\u003e", "branch": "default", "desc": "Bug 2068108 - Revert the Ctrl+Shift+Home/End move tab shortcuts from bug 2018728. r=sthompson,tabbrowser-reviewers\n\nThe shortcuts consume Ctrl+Shift+Home/End before the keydown reaches content,\nwhich breaks web apps that bind that combination. Bug 2071299 reports a web app\nusing it for spreadsheet selection, chosen for its similarity to the text\nediting shortcuts.\n\nAffected sites have no simple workaround. The IMEStatus guard only covers a\nfocused editable field, and content cannot defend itself with preventDefault\nbecause the parent process does not wait for the content process to reply.\n\nThis backs out all of bug 2018728: the ShortcutUtils constants and key\ndetection, the keydown handler cases, and the tests. The handler moved from\ntabbrowser.js to Tabbrowser.sys.mjs after the original patch landed, so that\nhunk is reverted by hand. The other two files revert cleanly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326933\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tab_move_active_tab.js", "toolkit/modules/ShortcutUtils.sys.mjs"], "git_node": "3e8db9f0ec5d19e26fec5dd155db792638fad78f", "git_parents": ["e9de90e46ea0fda1a9e8d0a22384b94f67369974"], "node": "7efcbda0ef047cc1881903b4316200fce91ef4da", "parents": ["7a3efdd048100a581a4956ff7142e51574f2394b"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057573 - Smart Window Monitor feature callout r=fluent-reviewers,omc-reviewers,bolsson,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325515\n", "files": ["browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md"], "git_node": "1226b3963f72428bbd780cc89a1ff79e4ecdeba9", "git_parents": ["3e8db9f0ec5d19e26fec5dd155db792638fad78f"], "node": "93cd60ebd99d7eda9b2fd58180229f7217ddde30", "parents": ["7efcbda0ef047cc1881903b4316200fce91ef4da"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070255 - Part 1: Split the smooth heuristic out of IsWebRTCSWEncodeSmooth so the record type can reuse it. r=pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326318\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp"], "git_node": "4d566de9a17c0b5a18815703ee2d2830f9cc86db", "git_parents": ["1226b3963f72428bbd780cc89a1ff79e4ecdeba9"], "node": "3ad056c22f30796af9142cd5d414c80fdd10ee24", "parents": ["93cd60ebd99d7eda9b2fd58180229f7217ddde30"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070255 - Part 2: Avoid routing record MediaCapabilities queries through WebRTC encoder factories. r=pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325098\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/mediacapabilities/MediaCapabilities.h"], "git_node": "9ac380022db945957af45f97edc21d2f5e8054b1", "git_parents": ["4d566de9a17c0b5a18815703ee2d2830f9cc86db"], "node": "d57e936a3259adbf1b4191052c20f1d4ad15d5c2", "parents": ["3ad056c22f30796af9142cd5d414c80fdd10ee24"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070255 - Part 3: Add a regression test for record VP8 MediaCapabilities encoding support. r=pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325099\n", "files": ["testing/web-platform/mozilla/tests/media-capabilities/encodingInfo-record.any.js"], "git_node": "fa01ca16e0aa53c6b070509d391b9a1c96ab1a4f", "git_parents": ["9ac380022db945957af45f97edc21d2f5e8054b1"], "node": "426333f3208bf8bff5e147e325fa4a7441e005e5", "parents": ["d57e936a3259adbf1b4191052c20f1d4ad15d5c2"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068817 - Bump extensions.data.storage_local_corrupted_reset expiring version to 166. r=kzar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326546\n", "files": ["toolkit/components/extensions/metrics.yaml"], "git_node": "d43004df7eddbe6144f0cf96c0cfaca553a6dc88", "git_parents": ["fa01ca16e0aa53c6b070509d391b9a1c96ab1a4f"], "node": "204219235adb40a7aa5473270244c262c424fcc7", "parents": ["426333f3208bf8bff5e147e325fa4a7441e005e5"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2072653 - Fix missing updated search widget title r=fluent-reviewers,nina-py,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326738\n", "files": ["browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "f4bfca94bd965dafce3867a73b88664db53aa84d", "git_parents": ["d43004df7eddbe6144f0cf96c0cfaca553a6dc88"], "node": "aee7b4162f5e5b86ab0afdd81a30c660b4f79455", "parents": ["204219235adb40a7aa5473270244c262c424fcc7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071753 - Drop the container menu items' accesskeys. r=daisuke,fluent-reviewers,tabbrowser-reviewers,places-reviewers,urlbar-reviewers,kcochrane,bolsson\n\n`useAccessKeys` has nothing left to suppress, so the new tab button's container menu now takes its labels from Fluent like the others.\n\nThe default identities' Fluent ids are stored in containers.json, so the rename comes with a migration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325832\n", "files": ["browser/base/content/browser.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/utilityOverlay.js", "browser/components/contextualidentity/test/browser/browser_telemetry.js", "browser/components/contextualidentity/test/browser/browser_urlbarContainerMenu.js", "browser/components/places/tests/browser/browser_library_container_menu.js", "browser/components/tabbrowser/content/browser-allTabsMenu.inc.xhtml", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "python/l10n/fluent_migrations/bug_2071753_container_menu_accesskeys.py", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_migratedFile.js", "toolkit/locales/en-US/toolkit/global/contextual-identity.ftl"], "git_node": "54ffa0d71217cf3fadedaa27fab56b54a16316c6", "git_parents": ["f4bfca94bd965dafce3867a73b88664db53aa84d"], "node": "09c9805c40b7982f205ef11e197fbb36b9baa298", "parents": ["aee7b4162f5e5b86ab0afdd81a30c660b4f79455"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072625 - Stop storing the default containers' Fluent ids in containers.json. r=baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326552\n", "files": ["browser/base/content/utilityOverlay.js", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_migratedFile.js"], "git_node": "f96e5fa4d0d23960a3557e9444e252aeee78652d", "git_parents": ["54ffa0d71217cf3fadedaa27fab56b54a16316c6"], "node": "334ee7fd7981e65a9c194a620fbf9177be6c3c74", "parents": ["09c9805c40b7982f205ef11e197fbb36b9baa298"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072625 - Label the container menu items with getUserContextLabel rather than a Fluent id. r=baku\n\nThe label is set before the popup paints, and the content-hosted address bar no longer needs contextual-identity.ftl for its container submenu. The four default containers' -panel-item strings go unused, so the recipe from bug 2071753, not yet landed, stops producing them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326882\n", "files": ["browser/base/content/utilityOverlay.js", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "python/l10n/fluent_migrations/bug_2071753_container_menu_accesskeys.py", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_migratedFile.js", "toolkit/locales/en-US/toolkit/global/contextual-identity.ftl"], "git_node": "54b95a7f45998e7b78dc59d50ace1d4b35b13114", "git_parents": ["f96e5fa4d0d23960a3557e9444e252aeee78652d"], "node": "740c72f7db25f3d3313cb6c87506a8a5260c2004", "parents": ["334ee7fd7981e65a9c194a620fbf9177be6c3c74"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-sr/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-sr/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-sr/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-is/strings.xml", "mobile/android/fenix/app/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-is/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sr/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml"], "git_node": "cd78f7b26313653fb290fd6f1b0a1c9afda06c1e", "git_parents": ["54b95a7f45998e7b78dc59d50ace1d4b35b13114"], "node": "56a38bf294c09687e922db0f022fc17c7c7f4b06", "parents": ["740c72f7db25f3d3313cb6c87506a8a5260c2004"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045704: Validate LoadInfoArgs and HTTP channel flags r=necko-reviewers,nika,valentin\" for causing mochitests failures\n\nThis reverts commit 91f409f7391cf7e2587dcfa48570e2b7007a5c3f.\n", "files": ["netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h"], "git_node": "1b524754d59f9f30fd877228f14e5f165dab2934", "git_parents": ["cd78f7b26313653fb290fd6f1b0a1c9afda06c1e"], "node": "8adf8061e9674594e3c125677bde9aa213f3663a", "parents": ["56a38bf294c09687e922db0f022fc17c7c7f4b06"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073207 - Fix Environment migration counts r=TravisLong DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327031\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs"], "git_node": "ce5e4a5d345724d7ba0868d4e9fbedab0f72e1ea", "git_parents": ["1b524754d59f9f30fd877228f14e5f165dab2934"], "node": "696dc991a7fa3def0fb7f774ddaf099b9f23e3c2", "parents": ["8adf8061e9674594e3c125677bde9aa213f3663a"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062281 - Self-heal a cache entry wedged in REVALIDATING r=necko-reviewers,valentin\n\nFollow-up to bug 2052908, which fixed the analogous READY/WRITING case.\nIf the consumer that put a cache entry into REVALIDATING never calls\nSetValid()/SetInvalid() on its handle (e.g. it is cancelled or crashes\nwithout releasing it), the entry stays wedged forever, and every later\nrequest for the same URL has to wait out nsHttpChannel's independent\nnetwork.cache.entry_wait_timeout_ms backstop before it can fall back to\nthe network.\n\nTrack when an entry enters REVALIDATING, and once it has been stuck\nthere longer than network.cache.entry_wait_timeout_ms, revert it to\nREADY the next time a callback is invoked instead of bailing out again,\nso later consumers are serviced immediately rather than each paying\ntheir own backstop timeout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323728\n", "files": ["netwerk/cache2/CacheEntry.cpp", "netwerk/cache2/CacheEntry.h", "netwerk/test/unit/test_cache2-44-no_cache_revalidating_hang.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "034b14931fcad173beb3ddca41f0624770104e95", "git_parents": ["ce5e4a5d345724d7ba0868d4e9fbedab0f72e1ea"], "node": "bbeb6b9645dd4c9b7aa043aeac98549b75837ab0", "parents": ["696dc991a7fa3def0fb7f774ddaf099b9f23e3c2"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061543 - Rename TabAddedToGroup to TabAddedToExistingTabGroup r=android-reviewers,007\n\nRename for consistency, since we need a TabAddedToNewTabGroup action.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324458\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/action/TabGroupAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupActionReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/TabsTrayTelemetryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupReducerTest.kt"], "git_node": "6e25467c542cc7f5f10a2fee0d7b39cdb10fec27", "git_parents": ["034b14931fcad173beb3ddca41f0624770104e95"], "node": "33b6b20376fba4f02c200e1a1878dddaed547286", "parents": ["bbeb6b9645dd4c9b7aa043aeac98549b75837ab0"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061543 - Extract tab group telemetry into a TabGroupTelemetry class r=android-reviewers,calu\n\nTabsTrayTelemetryMiddleware recorded tab group events inline. Move that\nrecording into a TabGroupTelemetry class parameterized by access point,\nso a second entry point outside the tabs tray can reuse it.\n\nTabGroupTelemetryContext lets a state object supply the group list and\nform state that the save and theme events branch on;\nTabsTrayState.TabGroupState implements it. No change to which events are\nrecorded or to their extras.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324459\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/MetricsUtils.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupTelemetry.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/state/TabsTrayState.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/TabGroupTelemetryTest.kt"], "git_node": "51cc646d8ba7c3ff22fed0e5cd58d42717cd77ed", "git_parents": ["6e25467c542cc7f5f10a2fee0d7b39cdb10fec27"], "node": "112c62386ebbbb43c7f21671d0c6d1e45599b040", "parents": ["33b6b20376fba4f02c200e1a1878dddaed547286"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061543 - Extract TabManagementFragment's entryProvider into named composables r=android-reviewers,007\n\nThe entryProvider block had grown to roughly 300 lines nested inside\nonCreateView and the whole block was suppressed by a LongMethod exception, which we no longer allow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324460\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt"], "git_node": "f4edbb4552983e50fc6221548a4b651b1860c3d6", "git_parents": ["51cc646d8ba7c3ff22fed0e5cd58d42717cd77ed"], "node": "2b7d7f91542ccc00f1555d6c35249c632df6a04b", "parents": ["112c62386ebbbb43c7f21671d0c6d1e45599b040"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061543 - Stand up a fragment to host the Tab Group flow r=android-reviewers,android-l10n-reviewers,parker,007\n\nAdd TabGroupFlowFragment to host the TabGroup bottom sheets outside the TabsTray.\nFragment has its own store, reducer, middleware objects.\nCurrently adds an only-on-debug Add to group browser menu item.\n\nHooking up the storage layer is tracked by bug 2069535.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323060\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupCardTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MoreSettingsSubmenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/flow/TabGroupFlowDestination.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/flow/TabGroupFlowEntryPoint.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/flow/TabGroupFlowFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/flow/TabGroupFlowReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/flow/TabGroupFlowState.kt", "mobile/andro