bld@lando.moz.tools"}, "45334": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3b49a44994fb7ff6902f7df5a3bd5f689a4fb4e9 with FIREFOX_153_3_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4cea99f2ad9c131bf5c82fb3d4b5240c52afaddf", "git_parents": ["9d5af75f2c3d60e7c992fc38edf45fa3d161fb99"], "node": "74782f39ae1efcc13207a070b47892ec3bce2145", "parents": ["ed6e9e71ef866d27f035b16c787adec0499d6f0b"], "tags": []}], "date": 1789475952, "git_changesets": ["4cea99f2ad9c131bf5c82fb3d4b5240c52afaddf"], "user": "ffxbld@lando.moz.tools"}, "45335": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a80bd15ddee3b4bf3679aeba340e9d2db933c467 with FIREFOX-ANDROID_156_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "2c8440f53c558afd7a287f7e0a8d945c8ec01cbc", "git_parents": ["4cea99f2ad9c131bf5c82fb3d4b5240c52afaddf"], "node": "55005b10cc2f80281acf72ec3eec5dc12d4d960f", "parents": ["74782f39ae1efcc13207a070b47892ec3bce2145"], "tags": []}], "date": 1789476042, "git_changesets": ["2c8440f53c558afd7a287f7e0a8d945c8ec01cbc"], "user": "ffxbld@lando.moz.tools"}, "45336": {"changesets": [{"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071327 - only filter discarded tabs when blurring. r=jswinarton,tabbrowser-reviewers\n\nThe regressor bug filtered out all pending tabs which is much too heavy handed given that the discarded status exists, and it makes more sense that we only want to ignore explicitly discarded tabs. The filter has been updated to be more specific, and a test case added to assert that simply pending tabs are not skipped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325668\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_selectMRUOnClose.js"], "git_node": "ffa442b04f17eef98354a28a0558429241f71ee8", "git_parents": ["38dd46150994b7c806866cfeb199526035162757"], "node": "c570c4467b6060df5f93e3d0220fc42990f74f0d", "parents": ["bca8737c308d0df876ae765300c906b76d0bb41c"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049027 - Part 1: Cleanup all code related to the old \"Home\" pane in about:preferences r=mconley,settings-reviewers,desktop-theme-reviewers,frontend-codestyle-reviewers,sfoster\n\nThe legacy Home pane and its New Tab half have been removed: `home.js`,\n`home.inc.xhtml`, the renderer in `AboutPreferences.sys.mjs`, the\n`SectionsManager.sys.mjs` section metadata that only fed that renderer, the\nHome styles and the superseded tests. Tests that checked both UIs, including\nthe enterprise policy helpers, now cover only the redesign path.\n\nThe search hint that made the \"Set Home Page\" bookmark dialog findable in\nsettings search has moved from the legacy pane to the \"Bookmarks\u2026\" button in the\nCustom Homepage subpage, with a search test under the redesign manifest.\n\nMerging the two test manifests in `tests/home/` has also restored twelve\n`browser_homepage_extension_*.js` tests that bug 2037657 dropped from every\nmanifest so they run again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325726\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_firefoxhome.js", "browser/components/enterprisepolicies/tests/browser/head.js", "browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/home.inc.xhtml", "browser/components/preferences/home.js", "browser/components/preferences/jar.mn", "browser/components/preferences/moz.build", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/addons/set_homepage.xpi", "browser/components/preferences/tests/addons/set_newtab.xpi", "browser/components/preferences/tests/browser-srd.toml", "browser/components/preferences/tests/browser.toml", "browser/components/preferences/tests/browser_bug1579418.js", "browser/components/preferences/tests/browser_extension_controlled.js", "browser/components/preferences/tests/home/browser-srd.toml", "browser/components/preferences/tests/home/browser.toml", "browser/components/preferences/tests/home/browser_home_pane_late_group_registration.js", "browser/components/preferences/tests/home/browser_homepage_default.js", "browser/components/preferences/tests/home/browser_homepage_extension_combined.js", "browser/components/preferences/tests/home/browser_homepage_extension_custom_url_fallback.js", "browser/components/preferences/tests/home/browser_homepage_extension_custom_url_label.js", "browser/components/preferences/tests/home/browser_homepage_extension_custom_url_lifecycle.js", "browser/components/preferences/tests/home/browser_homepage_extension_disable.js", "browser/components/preferences/tests/home/browser_homepage_extension_multiple.js", "browser/components/preferences/tests/home/browser_homepage_extension_multiple_homepage.js", "browser/components/preferences/tests/home/browser_homepage_extension_newtab.js", "browser/components/preferences/tests/home/browser_homepage_extension_restore_defaults.js", "browser/components/preferences/tests/home/browser_homepage_extension_switch_back.js", "browser/components/preferences/tests/home/browser_homepage_extension_uninstall.js", "browser/components/preferences/tests/home/browser_homepage_extension_windows.js", "browser/components/preferences/tests/home/browser_homepage_homepage.js", "browser/components/preferences/tests/home/browser_homepages_filter_aboutpreferences.js", "browser/components/preferences/tests/home/browser_homepages_use_bookmark.js", "browser/components/preferences/tests/home/browser_hometab_restore_defaults.js", "browser/components/preferences/tests/home/browser_newtab_menu.js", "browser/components/preferences/tests/home/browser_startup_browser_restore_session.js", "browser/components/preferences/tests/searchResults/browser-srd.toml", "browser/components/preferences/tests/searchResults/browser_search_homepage_bookmark_dialog.js", "browser/components/preferences/tests/searchResults/browser_search_subdialogs_within_preferences_1.js", "browser/extensions/newtab/docs/v2-system-addon/sections.md", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/lib/SectionsManager.sys.mjs", "browser/extensions/newtab/test/jest/lib/AboutPreferences.test.js", "browser/themes/shared/preferences/preferences.css", "eslint-rollouts.config.mjs"], "git_node": "fed41a8bfa615bf3a8b601db846b58b277037206", "git_parents": ["ffa442b04f17eef98354a28a0558429241f71ee8"], "node": "d5b705fa5defbe29f252f5e158f8970f717f22cf", "parents": ["c570c4467b6060df5f93e3d0220fc42990f74f0d"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049027 - Part 2: Remove Fluent strings orphaned by the legacy Home pane removal r=fluent-reviewers,flod\n\nTwenty-nine of these are orphaned by part 1. The other six were already unused,\nleft behind by bugs 1998829, 2003204, 2009106 and 2039925.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325727\n", "files": ["browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "ee0cb5561d0fad3869852ddf99476640c41939a1", "git_parents": ["fed41a8bfa615bf3a8b601db846b58b277037206"], "node": "7350839fadc9d91858161c8a2bb210da204f8843", "parents": ["d5b705fa5defbe29f252f5e158f8970f717f22cf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071753 - Drop the container submenu items' accesskeys. r=daisuke,urlbar-reviewers\n\nThe rest of the bug removes the accesskeys from the messages; this is the half that sits on top of D324483, which added them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325833\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js"], "git_node": "432eabb6933962bf45f1746a7ce0cf8fecc12918", "git_parents": ["ee0cb5561d0fad3869852ddf99476640c41939a1"], "node": "3f9ceff4a46d50c88faece4419afb85404beb1d8", "parents": ["7350839fadc9d91858161c8a2bb210da204f8843"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071657 - Release the space reserved for a tab group dropped in another window. r=sthompson,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325990\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_tab_group_overflow.js"], "git_node": "3af1a7cdae135c269f3639fc9e8e3255b141fd4e", "git_parents": ["432eabb6933962bf45f1746a7ce0cf8fecc12918"], "node": "a5d655b228590ba56b4c2afd0b28d47c7830f27d", "parents": ["3f9ceff4a46d50c88faece4419afb85404beb1d8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071730 - Let --border-color-deemphasized have transparency across brand and platform. r=desktop-theme-reviewers,akulyk,emilio\n\nThe value moves to the shared foundation layer, so --panel-border-color and --popup-border-color in content under Nova follow it.\n\nThe Nova block repeats the color-mix because the Figma export writes transparent for a brand value it doesn't find.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325753\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/base/border.tokens.json"], "git_node": "df79ccd817098a3d2b437de3d9622cdeb605d11a", "git_parents": ["3af1a7cdae135c269f3639fc9e8e3255b141fd4e"], "node": "dd31025fe6a5c7f854ca9ba66970b1deeaa521cd", "parents": ["a5d655b228590ba56b4c2afd0b28d47c7830f27d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071730 - Use the deemphasized border color for the in-page search bar. r=urlbar-reviewers,mak\n\nThe background is clipped to the padding box so it no longer shows through the border, which is translucent now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325754\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "1798e04cb65cb29df739735c8bcab4e3d4199b7f", "git_parents": ["df79ccd817098a3d2b437de3d9622cdeb605d11a"], "node": "97289f99ed1896519de507213577365ccfaedf9a", "parents": ["dd31025fe6a5c7f854ca9ba66970b1deeaa521cd"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2057988 - Reject a duplicate conduit id. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325089\n", "files": ["toolkit/components/extensions/ConduitsParent.sys.mjs", "toolkit/components/extensions/test/mochitest/test_ext_subframes_privileges.html"], "git_node": "1711435eb646d2efbc68285271a326253a4bffc3", "git_parents": ["1798e04cb65cb29df739735c8bcab4e3d4199b7f"], "node": "54182ca3ab395231b066a361416d544838df5250", "parents": ["97289f99ed1896519de507213577365ccfaedf9a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072054 - Pass --no-column to git tag in mach vendor so tag lookup survives column.ui=always. r=firefox-build-system-reviewers,ahochheiden\n\nupstream_tag takes the last line of `git tag -l --sort=creatordate` as the tag. With column.ui=always in the\nuser's git config the tags come out in columns, so a whole row is passed to `git log` and the vendor fails\nwith exit 128 for every tracking: tag manifest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326034\n", "files": ["python/mozbuild/mozbuild/vendor/host_base.py"], "git_node": "aa254ff4bdeea252a7154ada6bf1709aa2c265b2", "git_parents": ["1711435eb646d2efbc68285271a326253a4bffc3"], "node": "ea502f34768037736021cc10f50641e03cdbe142", "parents": ["54182ca3ab395231b066a361416d544838df5250"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1889510 - Intercept AtomRef strings in promoteString and forward to tenured atom r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320630\n", "files": ["js/src/gc/Tenuring.cpp", "js/src/jit-test/tests/gc/atomref-promotion.js"], "git_node": "dde884656559a735a9c2ae80ad71e8718cff7084", "git_parents": ["aa254ff4bdeea252a7154ada6bf1709aa2c265b2"], "node": "4a07e6b45e30226cd95688c354fb287ad6ccd435", "parents": ["ea502f34768037736021cc10f50641e03cdbe142"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Update ffvpx to ffmpeg 9.0.1 r=padenot\n\nThis commit updates local ffvpx copy to official ffmpeg 9.0.1 release with Mozilla specific changes applied.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321843\n", "files": ["dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/bsf.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_id.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/frame.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/pixfmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/version.h", "media/ffvpx/README_MOZILLA", "media/ffvpx/config_android_x86_64.asm", "media/ffvpx/config_components_audio_only.h", "media/ffvpx/config_components_audio_video.h", "media/ffvpx/config_darwin64.asm", "media/ffvpx/config_darwin64.h", "media/ffvpx/config_unix64.asm", "media/ffvpx/config_win32.asm", "media/ffvpx/config_win64.asm", "media/ffvpx/libavcodec/aarch64/vp9lpf_16bpp_neon.S", "media/ffvpx/libavcodec/aarch64/vp9lpf_neon.S", "media/ffvpx/libavcodec/allcodecs.c", "media/ffvpx/libavcodec/aom_film_grain.c", "media/ffvpx/libavcodec/aom_film_grain.h", "media/ffvpx/libavcodec/aom_film_grain_template.c", "media/ffvpx/libavcodec/arm/hpeldsp_arm.S", "media/ffvpx/libavcodec/arm/jrevdct_arm.S", "media/ffvpx/libavcodec/arm/simple_idct_arm.S", "media/ffvpx/libavcodec/arm/simple_idct_armv5te.S", "media/ffvpx/libavcodec/arm/simple_idct_armv6.S", "media/ffvpx/libavcodec/arm/startcode_armv6.S", "media/ffvpx/libavcodec/arm/vp9itxfm_16bpp_neon.S", "media/ffvpx/libavcodec/arm/vp9itxfm_neon.S", "media/ffvpx/libavcodec/arm/vp9lpf_16bpp_neon.S", "media/ffvpx/libavcodec/arm/vp9mc_16bpp_neon.S", "media/ffvpx/libavcodec/arm/vp9mc_neon.S", "media/ffvpx/libavcodec/atsc_a53.c", "media/ffvpx/libavcodec/av1dec.c", "media/ffvpx/libavcodec/avcodec.c", "media/ffvpx/libavcodec/avcodec.h", "media/ffvpx/libavcodec/avcodec.symbols", "media/ffvpx/libavcodec/avdct.h", "media/ffvpx/libavcodec/bitstream.h", "media/ffvpx/libavcodec/bitstream_filters.c", "media/ffvpx/libavcodec/bitstream_template.h", "media/ffvpx/libavcodec/bsf/aac_adtstoasc.c", "media/ffvpx/libavcodec/bsf/av1_frame_split.c", "media/ffvpx/libavcodec/bsf/null.c", "media/ffvpx/libavcodec/bsf/vp9_superframe_split.c", "media/ffvpx/libavcodec/cbs.c", "media/ffvpx/libavcodec/cbs.h", "media/ffvpx/libavcodec/cbs_av1.c", "media/ffvpx/libavcodec/cbs_av1_syntax_template.c", "media/ffvpx/libavcodec/codec.h", "media/ffvpx/libavcodec/codec_desc.c", "media/ffvpx/libavcodec/codec_id.h", "media/ffvpx/libavcodec/codec_internal.h", "media/ffvpx/liba