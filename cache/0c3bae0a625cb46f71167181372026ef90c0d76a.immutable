-\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nko -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nlij -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nlo -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nlt -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nltg -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nlv -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nmeh -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nmix -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nml -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nmr -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nms -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nmy -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nnb-NO -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nne-NP -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nnl -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nnn-NO -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\noc -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\npa-IN -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\npl -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\npt-BR -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\npt-PT -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nrm -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nro -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nru -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nsk -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nsl -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nson -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nsq -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nsr -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nsv-SE -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nta -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nte -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nth -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\ntl -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\ntr -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\ntrs -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nuk -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nur -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nuz -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nvi -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nwo -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nxh -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nzam -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nzh-CN -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\nzh-TW -\u003e a82668d1e521bade6611c38511c0f3215dcdbadc\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "f31bac1ec4918a542d88239753e475b11676375c", "git_parents": ["7be0c12bb74dcdebeb841f900968df8bfb9bad47"], "node": "9f5da34bf55807f3db81cc59ff6f1c1f34cdbdce", "parents": ["eef95ac626354854a23ac9a7d1435d60852713de"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070683 - Snap reference-frame origins, and pick image raster sizes at the snapped phase r=gfx-reviewers,nical\n\nAn image's raster size comes from rounding its destination rect, so it has to\nbe rounded at the sub-pixel phase that rect is snapped at. Two things shift\nthat phase, and either alone makes WebRender resample the whole image to close\na one-pixel gap.\n\nShouldSnapToGrid leaves reference-frame origins for WebRender to round under\nlayout.disable-pixel-alignment, but WebRender rounds one only when the frame\nasks to be snapped, which only zoom, fixed and scrollbar layers did. Ask for it\non the translate-only reference frame, and add snap_origin for the frames that\ncarry a transform as well: there, rounding the offset the frame composes to\nwould round the transform's own translation with it, so the origin has to be\nrounded before the transform is applied. That is what Gecko itself assumes -\nGetTransform still rounds the origin, so hit testing and the non-WebRender\npaint path already place content there.\n\nThe display list is also normalized by the external scroll offset in whole app\nunits while WebRender re-applies it in whole device pixels, so apply that\noffset before choosing the size. Read it back from the builder rather than\nre-summing it, so the two cannot drift apart.\n\nOne reftest per phase shift; each fails without its own half. The transform\nhalf is covered by gfx/tests/reftest/1501195.html, which asserts that adding\nan identity translate3d changes nothing: it snapped the origin-only reference\nframe Gecko creates for the stripped identity transform, but not the same\norigin arriving on a transformed frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325204\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/example-compositor/compositor/src/main.rs", "gfx/wr/examples/animation.rs", "gfx/wr/examples/iframe.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/space.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs", "layout/generic/nsImageFrame.cpp", "layout/reftests/image/image-refframe-fractional-raster-1.html", "layout/reftests/image/image-scrolled-fractional-raster-1.html", "layout/reftests/image/reftest.list", "layout/reftests/image/stripes-fractional.svg", "testing/web-platform/meta/css/css-transforms/backface-visibility-hidden-animated-002.html.ini", "testing/web-platform/meta/css/css-transforms/individual-transform/animation/individual-transform-combine.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-002.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-003.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-004.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-006.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-007.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-008.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-010.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-012.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-014.html.ini"], "git_node": "88ae0340c4b10814a44cce6abfa2b1a91a6268c3", "git_parents": ["f31bac1ec4918a542d88239753e475b11676375c"], "node": "973c9268a4c94dd4aa7c06ea4f7034d4301762c7", "parents": ["9f5da34bf55807f3db81cc59ff6f1c1f34cdbdce"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix broken links in the DOM documentation r=dom-core-reviewers,smaug DONTBUILD\n\nThe WebIDL bindings page linked to eleven anchors whose slugs never matched\ntheir headings, so those headings now carry an explicit MyST target.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325698\n", "files": ["dom/docs/navigation/nav_replace.md", "dom/docs/push/index.md", "dom/docs/webIdlBindings/index.md"], "git_node": "b72e07232e6fbe35a344d9e97cd3d94ad65bf0df", "git_parents": ["88ae0340c4b10814a44cce6abfa2b1a91a6268c3"], "node": "0f055c679c3a94168165f716743586e5212a2a7d", "parents": ["973c9268a4c94dd4aa7c06ea4f7034d4301762c7"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix the Early Hints anchor in the netwerk documentation r=necko-reviewers,valentin DONTBUILD\n\nThe heading is `103 Early Hints` Response on Main Document Load, so its slug\nstarts with 103.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325700\n", "files": ["netwerk/docs/early_hints.md"], "git_node": "9721b6fdbbf911dd03348ce39b003d693ec9e155", "git_parents": ["b72e07232e6fbe35a344d9e97cd3d94ad65bf0df"], "node": "227c8645ec135d1507c5b25b58083a122077e3d3", "parents": ["0f055c679c3a94168165f716743586e5212a2a7d"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070683 - Snap reference-frame origins, and pick image raster sizes at the snapped phase r=gfx-reviewers,nical\" for causing wr failures at backface-visibility-hidden-animated-002.html\n\nThis reverts commit 88ae0340c4b10814a44cce6abfa2b1a91a6268c3.\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/example-compositor/compositor/src/main.rs", "gfx/wr/examples/animation.rs", "gfx/wr/examples/iframe.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/space.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs", "layout/generic/nsImageFrame.cpp", "layout/reftests/image/image-refframe-fractional-raster-1.html", "layout/reftests/image/image-scrolled-fractional-raster-1.html", "layout/reftests/image/reftest.list", "layout/reftests/image/stripes-fractional.svg", "testing/web-platform/meta/css/css-transforms/backface-visibility-hidden-animated-002.html.ini", "testing/web-platform/meta/css/css-transforms/individual-transform/animation/individual-transform-combine.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-002.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-003.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-004.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-006.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-007.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-008.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-010.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-012.html.ini", "testing/web-platform/meta/css/css-transforms/transform-input-014.html.ini"], "git_node": "6433953dde21e59a6c1651847520b23132708417", "git_parents": ["9721b6fdbbf911dd03348ce39b003d693ec9e155"], "node": "c0973a7f8e25c14f954c07d07f8f12c01177bc6a", "parents": ["227c8645ec135d1507c5b25b58083a122077e3d3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071699 - Bump the timeout for deb10-arm64-gcc-11 jobs to 90min. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325688\n", "files": ["taskcluster/kinds/packages/debian.yml"], "git_node": "fe0c24b3c7a8b7954be8c28bd1a7ba3835f0b623", "git_parents": ["6433953dde21e59a6c1651847520b23132708417"], "node": "4ac341c636a28776578bd1e2a4beb47631fb3022", "parents": ["c0973a7f8e25c14f954c07d07f8f12c01177bc6a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071691 - Clean up the treeherder groups and symbols of toolchain tasks. r=firefox-build-system-reviewers,ahochheiden DONTBUILD\n\nDrop the platform suffixes that repeat what the group already says (-linux in TL, -macos in TMA64, mingw in\nTMW), put the arch after the variant in the TA symbols like every other group does, and move the aarch64 macOS\ngn and custom-car tasks and the Android custom-car and onnxruntime tasks into the groups their targets belong\nto. The WASI compiler-rt and sysroot tasks get their own WASI group instead of squatting in TL, and TMW is\nrenamed TWM so it reads as a sibling of TW32/TW64/TWA64 rather than of the TM groups.\n\nThe tasks named as if they were x64 macOS but building aarch64 artifacts, plus the i686 compiler-rt tasks, are\nrenamed to the prefixes the rest of the kind uses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325670\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/transforms/artifact.py", "taskcluster/gecko_taskgraph/transforms/custom_car.py", "taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/browsertime/kind.yml", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/kinds/perftest/android-emulator.yml", "taskcluster/kinds/toolchain/android-macos.yml", "taskcluster/kinds/toolchain/android.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/compiler-rt.yml", "taskcluster/kinds/toolchain/custom-car.yml", "taskcluster/kinds/toolchain/gn.yml", "taskcluster/kinds/toolchain/libunwind.yml", "taskcluster/kinds/toolchain/mingw.yml", "taskcluster/kinds/toolchain/onnx.yml", "taskcluster/kinds/toolchain/rust.yml", "taskcluster/kinds/toolchain/sysroot.yml", "tools/tryselect/task_config.py"], "git_node": "6214700fed877d7d86769eb0f430cf94f19e1176", "git_parents": ["fe0c24b3c7a8b7954be8c28bd1a7ba3835f0b623"], "node": "7aae073411923750434776e67952b6797bbfabe3", "parents": ["4ac341c636a28776578bd1e2a4beb47631fb3022"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update NASM to version 3.02. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325673\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/nasm.yml"], "git_node": "ab6e81eb25b549070cf27a7144bf15caa914bfd0", "git_parents": ["6214700fed877d7d86769eb0f430cf94f19e1176"], "node": "63d17bd04f9b25a13a6a61fcbb9fc6cf4dd9d1a1", "parents": ["7aae073411923750434776e67952b6797bbfabe3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update UPX to version 5.2.1. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325674\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "3f8f83019eace2bed56f7961916ea9ec95681281", "git_parents": ["ab6e81eb25b549070cf27a7144bf15caa914bfd0"], "node": "a9c07320388715af108a8516a32b747cf547d9a4", "parents": ["63d17bd04f9b25a13a6a61fcbb9fc6cf4dd9d1a1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update Wine to version 11.17. r=firefox-build-system-reviewers,sylvestre\n\nWine 11.16 made a non-PE build a configure error unless --without-mingw is passed (upstream commit\n06ea7ffe). The toolchain image has no mingw or clang, so our build was already non-PE; pass the flag to\nkeep that behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325675\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/scripts/misc/build-wine.sh"], "git_node": "56733de21a9cd43ce479fd98f2b6a9ae4f6e6cfa", "git_parents": ["3f8f83019eace2bed56f7961916ea9ec95681281"], "node": "dc231479edaa1b474aa8c1ab1ba9665931c0571b", "parents": ["a9c07320388715af108a8516a32b747cf547d9a4"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update CMake to version 4.4.3. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325676\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "0200039157377d0afd38b9b3597694dced3df81f", "git_parents": ["56733de21a9cd43ce479fd98f2b6a9ae4f6e6cfa"], "node": "5d64f8d8c51e24c49633a24619d8365a896ea85d", "parents": ["dc231479edaa1b474aa8c1ab1ba9665931c0571b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update 7-Zip to version 26.03. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325677\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "3b14ca1ccf60ad3de18bb6056bcb0d2f8735dbba", "git_parents": ["0200039157377d0afd38b9b3597694dced3df81f"], "node": "26a060a8da41f6d019f47627d438e93fe86cfda9", "parents": ["5d64f8d8c51e24c49633a24619d8365a896ea85d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update pkgconf to version 3.0.7. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325678\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "e3d3044f9136a670a63c0f5a417a63ca34bc7f3d", "git_parents": ["3b14ca1ccf60ad3de18bb6056bcb0d2f8735dbba"], "node": "8bd80d0bdee9cc5659afa89f5de1f33a3b5ec3db", "parents": ["26a060a8da41f6d019f47627d438e93fe86cfda9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update XZ to version 5.8.4. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325679\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "1cbb9a4afd14ae9dcb6948cee2fae9bec43643b8", "git_parents": ["e3d3044f9136a670a63c0f5a417a63ca34bc7f3d"], "node": "b07c52cb9090fb5a0338575ee6f93ae077e07cc6", "parents": ["8bd80d0bdee9cc5659afa89f5de1f33a3b5ec3db"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update libxml2 to version 2.15.4. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325680\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "cec22bbbe26db0030cd4e513f55e2b7b737b1a4d", "git_parents": ["1cbb9a4afd14ae9dcb6948cee2fae9bec43643b8"], "node": "3b90f61663c0bd6af217df0e95c62cf09f43f432", "parents": ["b07c52cb9090fb5a0338575ee6f93ae077e07cc6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update Windows App SDK to version 2.4.0. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325681\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "f37a993b557efbabba330c81bb045164e33c2b32", "git_parents": ["cec22bbbe26db0030cd4e513f55e2b7b737b1a4d"], "node": "8c22152476476f5c0811dd1c884ed73fc29ecf32", "parents": ["3b90f61663c0bd6af217df0e95c62cf09f43f432"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071690 - Update MinGW to upstream revision 85c7dd4cce5ab74b679f9ca74efa49a7f5e4bd5a. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325682\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "1f1cecc1746351ea1b2a7221ee509474679353b6", "git_parents": ["f37a993b557efbabba330c81bb045164e33c2b32"], "node": "9c9783cde98a1954e5160335e951b5d4aa26298b", "parents": ["8c22152476476f5c0811dd1c884ed73fc29ecf32"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066409 - Don't fire a scroll event when restoring a non-root scroll position. r=layout-reviewers,emilio\n\nA non-root position is only restored across a reframe, which re-establishes a\nposition the content already had, so nothing scrolled. Chrome fires nothing\nthere either. The root scroller is also restored from session history, a real\nscroll that pages rely on, so it keeps firing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325227\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "testing/web-platform/tests/dom/events/scrolling/scroll-event-not-fired-on-ancestor-style-change.html"], "git_node": "77f86bec3345d979b741971ccb740d71c6a53287", "git_parents": ["1f1cecc1746351ea1b2a7221ee509474679353b6"], "node": "31ffe32f402f029b66a40f88f8dcf81769e07d87", "parents": ["9c9783cde98a1954e5160335e951b5d4aa26298b"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2066020 - Enable SharedSurface_AndroidHardwareBuffer with WebGL on Android r=gfx-reviewers,lsalzman\n\nMove AndroidHardwareBuffer to higher priority.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320845\n", "files": ["gfx/layers/CanvasRenderer.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "e9d9b51aac5d385bdb8936edda813661a81c1462", "git_parents": ["77f86bec3345d979b741971ccb740d71c6a53287"], "node": "7a4f50a624e363fa005bf9062646e1a8ab5705fe", "parents": ["31ffe32f402f029b66a40f88f8dcf81769e07d87"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059195 - Track each pipeline's embedder LayersId in CompositorBridgeParent::LayerTreeState. r=gfx-reviewers,aosmond\n\nExtend NotifyChildCreated, MapAndNotifyChildCreated, and NotifyChildRecreated\nto carry the LayersId of the pipeline that embeds the newly (re)created one,\nand record it on LayerTreeState as mEmbedderLayersId. It is derived in\nRemoteLayerTreeOwner::Initialize(), once the embedding widget's WindowRenderer\nexists: from the embedding document's BrowserParent for a nested remote frame,\nand from the hosting chrome window's widget otherwise.\n\nAlso extend AdoptChild to carry a freshly-recomputed embedder id, rather than\npreserving whatever was previously recorded: adopting a child under a new\nCompositorBridgeParent can mean a tab was moved to a different top-level\nwindow, which does change who embeds it, so the old value would otherwise go\nstale.\n\nThis establishes a parent-process-trusted ground truth for which LayersId\nembeds which, to be used by a follow-up change to validate scroll-data\nreferent claims from content.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316408\n", "files": ["gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeChild.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.h", "gfx/layers/ipc/PCompositorBridge.ipdl", "layout/ipc/RemoteLayerTreeOwner.cpp"], "git_node": "a53710780cc491a20f11c04911ba82e6ae44cebd", "git_parents": ["e9d9b51aac5d385bdb8936edda813661a81c1462"], "node": "06c8cdc2f4862d143e981b1da49deb69f65aa258", "parents": ["7a4f50a624e363fa005bf9062646e1a8ab5705fe"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059195 - Clear WebRenderScrollData referent ids that the sender doesn't actually embed. r=botond\n\nValidate every referent claim in WebRenderBridgeParent::ProcessDisplayListData\nagainst the parent process's own record of the frame tree (LayerTreeState's\nnew mEmbedderLayersId), and clear the claims it doesn't confirm.\n\nClearing rather than dropping the transaction, because a referent can\nlegitimately be gone by the time the claim is validated: DeallocateLayerTreeId\nerases the entry via a dispatched runnable while the embedder still has a\ntransaction in flight naming it. Registration is synchronous and completes\nbefore content learns the id, so an unconfirmed referent is never a link that\nshould have existed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316409\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderScrollData.cpp", "gfx/layers/wr/WebRenderScrollData.h"], "git_node": "f0927ac7fabc3059684d3cda4e327af8858a9384", "git_parents": ["a53710780cc491a20f11c04911ba82e6ae44cebd"], "node": "dd3fbaf4bc721a82f9941f4a413f3f844f055c15", "parents": ["06c8cdc2f4862d143e981b1da49deb69f65aa258"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/res/values-en-rCA/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-vi/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-en-rCA/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-es-rES/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-ja/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-vi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-en-rCA/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rCA/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rES/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml"], "git_node": "535a3b47cc718316009e37b2302efa307a1915a7", "git_parents": ["f0927ac7fabc3059684d3cda4e327af8858a9384"], "node": "2bbfd2a79a7a581d79add528f0ea679ae7858ed6", "parents": ["dd3fbaf4bc721a82f9941f4a413f3f844f055c15"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": [], "git_node": "b03f31aff2279c01ae4729e76c7a69ebd4e9cee1", "git_parents": ["a263d135c6f54af9c7fd75da47bd50b2f67910cf", "535a3b47cc718316009e37b2302efa307a1915a7"], "node": "0d6c4739c7b6693b2164401f74f71ea46425906a", "parents": ["ec80430e999eb88f8861abb6d191480fece69a3f", "2bbfd2a79a7a581d79add528f0ea679ae7858ed6"], "tags": []}], "date": 1789359971, "git_changesets": ["7be0c12bb74dcdebeb841f90