onents/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "cccc40f0d4290aecfe31a8b41abdbb63a3850101", "git_parents": ["c87544219c6cfe7d1833e43bd30fb00d699d7722"], "node": "8a0464b3e2d4f6d9cd51e6b1b956e1f1815f7e6b", "parents": ["59bd16921327bec1b6bbe350336c7f583725c6d6"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070853 - P2. Give build scripts a glean_parser virtualenv on every build r=firefox-build-system-reviewers,sylvestre\n\nBuilding the application-services megazord fails with \"No module named\nglean_parser\" now that the places component runs its Glean codegen for the host\ntoo: application-services 5ff8ba498eb09c89f494706dd2106274c7e0a1ad (bug 2053207)\ndropped the CARGO_CFG_TARGET_OS android/ios guard around it. rust.mk takes\nGLEAN_PYTHON_VENV_DIR from GRADLE_GLEAN_PARSER_VENV, which\nmobile/android/gradle.configure only sets for Android, so every other build\nexports it empty, and glean-build reads an empty value as a virtualenv path\nrather than as unset.\n\nGLEAN_PARSER_VENV carries that value, the configure virtualenv that has\nglean_parser, for every build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328432\n", "files": ["build/moz.configure/rust.configure", "config/makefiles/rust.mk"], "git_node": "cd088b1c825fd7c33fb698d7102b9a14b8878f3b", "git_parents": ["cccc40f0d4290aecfe31a8b41abdbb63a3850101"], "node": "857a18f9ecf15aa219c512ddddbb715b2d31d72f", "parents": ["8a0464b3e2d4f6d9cd51e6b1b956e1f1815f7e6b"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070853 - P3. Move logins encryption API to db_crypto r=joschmidt,credential-management-reviewers,android-reviewers,jonalmeida\n\nThe crypto primitives now live in the db_crypto namespace, so their callers move\nwith them.\n\nDesktop: storage-rust.sys.mjs takes PrimaryPasswordAuthenticator and\nAuthenticationCanceled from RustDbCrypto.sys.mjs. LoginsApiError has an\nAuthenticationCanceled of its own, but getPrimaryPassword has to throw the\nDbCryptoApiError one, because that is what the callback interface declares.\n\nAndroid: the primitives now throw DbCryptoApiException, a separate sealed class\nrather than a subclass of LoginsApiException, so catches that stop matching are\nnot flagged at compile time. LoginsCrypto catches it in isKeyRecoveryNeeded and\nwraps it in createKey and storeKeyAndCanary, keeping db_crypto errors inside the\nkey manager, since SyncableLoginsStorage and its Fenix callers catch only\nLoginsApiException. LoginsCryptoTest covers both paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324942\n", "files": ["mobile/android/android-components/components/service/sync-logins/build.gradle", "mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/LoginsCrypto.kt", "mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/SyncableLoginsStorage.kt", "mobile/android/android-components/components/service/sync-logins/src/test/java/mozilla/components/service/sync/logins/LoginsCryptoTest.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt", "toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "bf15f4456fa29a041a98ee98549c88d9c101dc5f", "git_parents": ["cd088b1c825fd7c33fb698d7102b9a14b8878f3b"], "node": "cc30ff314bc8122f1c38e3a64860a09119a53f48", "parents": ["857a18f9ecf15aa219c512ddddbb715b2d31d72f"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074953 - Update android nightly application-services version bump to 734e6daa16503b4d2279e6ea5d7aef1fda881258 r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328601\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "eb00355d1c79078e0b3fa26a24e11ceabf0cf060", "git_parents": ["bf15f4456fa29a041a98ee98549c88d9c101dc5f"], "node": "ec8026ffe491f9956d6cca661520f6cfb69fa82a", "parents": ["cc30ff314bc8122f1c38e3a64860a09119a53f48"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074631 - Add Nimbus Configs for Auto Tab Grouping, update minTabs floor. r=omarg\n\nThis patch updates the ATG prefs to use the nimbus prefs and updates the minimum\ntabs floor from 4 -\u003e 2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328547\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "e6ce8ee35bd719e28ee9e33b4c405046bfa8b385", "git_parents": ["eb00355d1c79078e0b3fa26a24e11ceabf0cf060"], "node": "91cf4a3ba19f950b5a84c4faebf9eb454e8d1232", "parents": ["ec8026ffe491f9956d6cca661520f6cfb69fa82a"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068158 - Host tab groups strip composable in home and browser fragments r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322994\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Fragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupsStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabManagementFeatureHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/dimens.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/FragmentTest.kt"], "git_node": "d2f775ee788af1c0163cb296cc04a4a0eabb9861", "git_parents": ["e6ce8ee35bd719e28ee9e33b4c405046bfa8b385"], "node": "6bc122c7c65f75bb2dcf36d6bfb54351668c3cfc", "parents": ["91cf4a3ba19f950b5a84c4faebf9eb454e8d1232"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072034 - Add per device CWTS pref and expose public accessor. r=markh,sync-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327220\n", "files": ["modules/libpref/init/all.js", "services/sync/modules/main.sys.mjs", "services/sync/tests/unit/test_service_startup.js"], "git_node": "372479b5b7e91d55c1cb8088e63b881071ef1859", "git_parents": ["d2f775ee788af1c0163cb296cc04a4a0eabb9861"], "node": "ab0f6febaab1c44d9e3739e851a29d55d243c7e2", "parents": ["6bc122c7c65f75bb2dcf36d6bfb54351668c3cfc"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070169 - [devtools] Use declaration substituted value to check registered property declaration validity. r=devtools-reviewers,ochameau.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326953\n", "files": ["devtools/client/inspector/rules/test/browser_rules_registered-custom-properties.js", "devtools/server/actors/style-rule.js"], "git_node": "65f22d886e2d45dc415122dc878c03748f7599e1", "git_parents": ["372479b5b7e91d55c1cb8088e63b881071ef1859"], "node": "b932ebd195dfca638a74fcb2ef0c3f945d3901c8", "parents": ["ab0f6febaab1c44d9e3739e851a29d55d243c7e2"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067207 - Pin newtab's runtime-metrics files to each version's base tag. r=ini\n\nruntime-metrics-N.json is named for the browser version it is installed on, but\nits contents were originally diffed against refs/heads/beta or refs/heads/release.\nThose branches take the _next_ cycle's content on merge day, days before the builds in\nthe field do, so during certain periods, the payload could describe a different version\nthan its name.\n\nFIREFOX_BETA_N_BASE never moves and every build calling itself N descends from\nit, so the diff is a correct superset for N's betas, RC, release and dot\nreleases.\n\nWe also create three runtime-metrics-N.json payloads rather than two, to cover the\nrelease still in the field between merge day and the release that follows it, just\nin case we end up needing to fast-track a trainhop at some point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328254\n", "files": ["browser/extensions/newtab/docs/v2-system-addon/train_hopping.md", "browser/extensions/newtab/mach_commands.py", "browser/extensions/newtab/webext-glue/metrics/gen_runtime_metrics.py", "browser/extensions/newtab/webext-glue/moz.build"], "git_node": "d8b80c28b82f6c828f2b000d72baecc5aab4c986", "git_parents": ["65f22d886e2d45dc415122dc878c03748f7599e1"], "node": "c0c336fafe73996ed4c17cdc60197e8e420e8edd", "parents": ["b932ebd195dfca638a74fcb2ef0c3f945d3901c8"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2073703, part 1 - Make the ContentProcessManager remote frame registration functions more resilient. r=nika\n\nMake all of the callers of RegisterRemoteFrame check the return value. If this\nfailed, then if we keep going things will probably be in a weird state.\n\nChange UnregisterRemoteFrame to take a BrowserParent, and confirm that the\nvalue in mBrowserParentMap is what we expect. This will prevent the map\nbeing in a bad state from removing too many keep alives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327515\n", "files": ["dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentProcessManager.cpp", "dom/ipc/ContentProcessManager.h"], "git_node": "65fb3f0a2d0f65bc9d10c8d063f4c9c9681987aa", "git_parents": ["d8b80c28b82f6c828f2b000d72baecc5aab4c986"], "node": "3a9a64999b62f75628ea5babbf6c0ffd2ff4bd0f", "parents": ["c0c336fafe73996ed4c17cdc60197e8e420e8edd"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2073703, part 2 - Unregister the new remote frame if BindPBrowserEndpoint fails. r=nika\n\nBe defensive and unregister if the bind call fails.\n\nThe call to Bind, which ends up as UntypedManagedEndpoint::BindCommon, shouldn't fail:\n\n* aActor was just created, so it won't be null.\n\n* IsForProtocol was already checked by ParamTraits\u003cManagedEndpoint\u003cPFooSide\u003e\u003e::Read.\n\n* IsValidForManager is checked at the top of RecvConstructPopupBrowser.\n\n* We're in a Recv method and haven't returned to the event loop so CanSend() and\n  GetIPCChannel() should still be true.\n\n* This endpoint was sent over IPC so mTopLevel should be set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327516\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "c35b1c75bd53f8aeeba47bb671399d547853adfd", "git_parents": ["65fb3f0a2d0f65bc9d10c8d063f4c9c9681987aa"], "node": "b8995e0d12f4e1cbfa3c7e48391078f804ce28e2", "parents": ["3a9a64999b62f75628ea5babbf6c0ffd2ff4bd0f"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2067688 - Consume the touch begin that rolls up a popup instead of handing it back to GTK. r=gtk-reviewers,emilio\n\nTapping a toolbar button to close its open panel closes it and reopens it\non a touchscreen. nsWindow::OnTouchEvent() rolls the panel up on\nGDK_TOUCH_BEGIN and returns FALSE, but that return value is also the\ntouch-event signal result, and FALSE means \"unhandled\" to GTK. GTK's\ndefault handler, gtk_widget_real_touch_event(), then replays a\npointer-emulating touch as a GDK_BUTTON_PRESS. That press reaches\nnsWindow::OnButtonPressEvent(), where CheckForRollup() finds nothing left\nto roll up, so the mousedown goes to the toolbar button and reopens the\npanel. The mouse path never has this problem because\nOnButtonPressEvent() returns without dispatching after a rollup.\n\nReturn TRUE when CheckForRollup() asks for the press to be consumed. The\nrest of the sequence still goes through the normal path, which returns\nTRUE, so GTK does not replay its end as a button release either; Gecko\ngets a touchend with no touchstart, the same way the mouse path sends a\nmouseup after a consumed press.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326275\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "cdcebe2264b6113716070cd6459bd085c6eeae4a", "git_parents": ["c35b1c75bd53f8aeeba47bb671399d547853adfd"], "node": "269066a346311cc238fc18d350b9cbbc25805d5a", "parents": ["b8995e0d12f4e1cbfa3c7e48391078f804ce28e2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073853 - Report an error when a menupopup or panel-list has duplicate access keys or mixes items with and without access keys. r=firefox-desktop-core-reviewers ,reusable-components-reviewers,tgiles,Gijs\n\nThe check runs in automation only. The browser-chrome harness fails the running test on an AccessKeyConflictError reported from any process, the way it already fails on an unhandled rejection; an ordinary console error only gets logged.\n\nA popup with accesskey-conflicts-bug is skipped while that attribute names the bug tracking its conflicts. An item that shares its accesskey on purpose carries intended-duplicate-accesskey and is left out of the shared-key check. The message ends with the remedies for each problem it found, in order of preference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327677\n", "files": ["testing/mochitest/browser-test.js", "toolkit/content/jar.mn", "toolkit/content/tests/chrome/chrome-nova.toml", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/test_menu_accesskey_conflicts.xhtml", "toolkit/content/tests/widgets/chrome-nova.toml", "toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/mochitest.toml", "toolkit/content/tests/widgets/test_panel_list_accesskey_conflicts.html", "toolkit/content/widgets/menupopup.js", "toolkit/content/widgets/panel-list/accesskey-check.mjs", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "313f3676521af99476545c8f29ad0eeb2e4460b6", "git_parents": ["cdcebe2264b6113716070cd6459bd085c6eeae4a"], "node": "bbbaaccb1a332d04bbe2b8fe067af839ea4f7e8f", "parents": ["269066a346311cc238fc18d350b9cbbc25805d5a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073853 - Skip WebExtension items in the menu accesskey conflict check. r=reusable-components-reviewers,extension-reviewers,tgiles,robwu\n\nAn extension chooses its own accesskeys, so its items are marked and left out of the check whether or not they carry one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327705\n", "files": ["browser/components/extensions/parent/ext-menus.js", "toolkit/content/tests/chrome/test_menu_accesskey_conflicts.xhtml", "toolkit/content/widgets/panel-list/accesskey-check.mjs"], "git_node": "c30afab2b5078ac527344208de88ae4c7eb58866", "git_parents": ["313f3676521af99476545c8f29ad0eeb2e4460b6"], "node": "cca2b76192ff6792195435262c36ae725c4e8ff5", "parents": ["bbbaaccb1a332d04bbe2b8fe067af839ea4f7e8f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073853 - Mark the menus with known accesskey conflicts. r=firefox-desktop-core-reviewers ,devtools-reviewers,places-reviewers,urlbar-reviewers,nchevobbe,mak,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327706\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-menubar.inc.xhtml", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/webext-panels.xhtml", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/places/content/browserPlacesViews.js", "browser/components/search/content/searchbar.js", "browser/components/sharing/SharingUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "devtools/client/debugger/src/actions/context-menus/breakpoint.js", "devtools/client/debugger/src/actions/context-menus/editor-breakpoint.js", "devtools/client/debugger/src/actions/context-menus/editor.js", "devtools/client/debugger/src/actions/context-menus/source-tree-item.js", "devtools/client/debugger/src/actions/context-menus/tab.js", "devtools/client/debugger/src/context-menu/menu.js", "devtools/client/framework/menu.js", "devtools/client/framework/test/browser_menu_api.js", "devtools/client/inspector/changes/ChangesContextMenu.js", "devtools/client/inspector/markup/markup-context-menu.js", "devtools/client/inspector/shared/style-inspector-menu.js", "devtools/client/netmonitor/src/widgets/RequestListContextMenu.js", "devtools/client/shared/components/menu/utils.js", "devtools/client/webconsole/utils/context-menu.js"], "git_node": "985f6736f412950f6dcda200b0d36b23cfa984d9", "git_parents": ["c30afab2b5078ac527344208de88ae4c7eb58866"], "node": "07e5114fa84e9eca7364e89d28ab38a61046b99f", "parents": ["cca2b76192ff6792195435262c36ae725c4e8ff5"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058679 - Add a fenix nightly as release build and run SP3 on it r=perftest-reviewers,releng-reviewers,aglavic,ahal,taskgraph-reviewers\n\nThis patch adds an android version of the desktop nightly-as-release\nperf config. This gies android the same coverage that we have on macOS,\nwindows, and linux. This analog ensures we excercise code paths that are\notherwise gated behind nightly only flags.\n\nFor now it is restricted to running the Speedometer 3 benchmark.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324802\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/kinds/build-apk/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build-signing/kind.yml", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/generate-profile/kind.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "testing/perfdocs/generated/performance-infrastructure.md", "testing/perfdocs/generated/raptor.md"], "git_node": "a236e44ae536bb38321636f4ca4db7832b51a494", "git_parents": ["985f6736f412950f6dcda200b0d36b23cfa984d9"], "node": "06d9177f8939183305a61a4be7e0c3fccea99179", "parents": ["07e5114fa84e9eca7364e89d28ab38a61046b99f"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2054343 - Avoid calculating inf + -inf when calculating the scheduled event time for animationstart. r=layout-reviewers,dshin\n\nThe assertion in this bug happens when we are calculating `inf + -inf`,\nwhich results in an unexpected value, so we just try to avoid it.\n\nNote that there is a known issue for `AnimationEvent.elapsedTime` if the\ndelay is negative infinite. We may get an incorrect negative elapsedTime\nbecause the calculation of `mActiveTime` is overflow. However, it seems\nother browsers have different behavior and it's an undefined behavior,\nso we just keep it as it is for now because it is outside the\nscope of this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328649\n", "files": ["dom/animation/Animation.cpp", "dom/animation/AnimationEffect.cpp", "dom/animation/CSSAnimation.cpp", "testing/web-platform/meta/css/css-animations/animation-delay-012.html.ini"], "git_node": "87b2c99876e67ca83f3d20569a4959e74561af28", "git_parents": ["a236e44ae536bb38321636f4ca4db7832b51a494"], "node": "fed211c67a280a9fb98521c3804a79c48f8275db", "parents": ["06d9177f8939183305a61a4be7e0c3fccea99179"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060572 - Part 1: Refactor the NetworkGeolocationProvider request cache. r=geoprovider-reviewers,jjaschke,saschanaz\n\nCachedRequest/CachedResponse refactor.  No functional change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327052\n", "files": ["dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "864c6faa302daeb3d59727f69777120d55053c77", "git_parents": ["87b2c99876e67ca83f3d20569a4959e74561af28"], "node": "4250d0cd35173345b2e7cdb2de58c52a7b9bd3cd", "parents": ["fed211c67a280a9fb98521c3804a79c48f8275db"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060572 - Part 2: Invalidate the NetworkGeolocationProvider request cache on network link changes. r=geoprovider-reviewers,saschanaz\n\nObserve network:link-status-changed and invalidate the network geolocation\ncache on \"changed\"/\"up\".  A cached location is only valid on the network it\ncame from. The observer lives on the cache, so invalidation also works while\nthe provider is shut down.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326728\n", "files": ["dom/geolocation/test/unit/test_geolocation_network_cache.js", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "ba987011e3b7e39726ffe2909d528d9cf2092e45", "git_parents": ["864c6faa302daeb3d59727f69777120d55053c77"], "node": "374666d46eaf07817e0520c9db12b95b64058b03", "parents": ["4250d0cd35173345b2e7cdb2de58c52a7b9bd3cd"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060572 - Part 3: Add telemetry for the network changes that geolocation sees. r=geoprovider-reviewers,saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326729\n", "files": ["dom/geolocation/metrics.yaml", "dom/geolocation/test/unit/test_geolocation_network_cache.js", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "5fa7c2e9a3a29d5cab13acbdd3fdf61bd4700040", "git_parents": ["ba987011e3b7e39726ffe2909d528d9cf2092e45"], "node": "117abd42dc4eda8802f788a0d2b4f3b74017959c", "parents": ["374666d46eaf07817e0520c9db12b95b64058b03"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074859 - Replace std::string::find(...) == 0 by std::string::starts_with r=webrtc-reviewers,crashreporting-reviewers,TravisLong,pehrsons\n\nSince we're now on C++20.\n\nAnecdotally fixes cpp-check warning on that topic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328516\n", "files": ["dom/canvas/SanitizeRenderer.cpp", "dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLProgram.cpp", "dom/canvas/WebGLValidateStrings.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/sdp/ParsingResultComparer.cpp", "gfx/gl/GLContext.cpp", "toolkit/components/telemetry/pingsender/pingsender_unix_common.cpp", "toolkit/crashreporter/breakpad-client/linux/microdump_writer/microdump_writer_unittest.cc"], "git_node": "707eaad80251c02e1f740b4594de36503edacb1f", "git_parents": ["5fa7c2e9a3a29d5cab13acbdd3fdf61bd4700040"], "node": "147ff97763d675629f3b1efe3869a6efbb71bde6", "parents": ["117abd42dc4eda8802f788a0d2b4f3b74017959c"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074390 - IndexedDB: reject resizable array buffers (or view on such buffers) used as keys. r=dom-storage-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328135\n", "files": ["dom/indexedDB/Key.cpp", "dom/indexedDB/test/unit/test_keys.js"], "git_node": "a23a6b00555d371f9dd259e37d0147f50be45b10", "git_parents": ["707eaad80251c02e1f740b4594de36503edacb1f"], "node": "d94056a9cb9c32d801091e1c436e6290e87f74dd", "parents": ["147ff97763d675629f3b1efe3869a6efbb71bde6"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072101 part 1: Make Accessible support RefPtr. r=accessibility-platform-reviewers,eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326834\n", "files": ["accessible/atk/nsMaiInterfaceComponent.cpp", "accessible/basetypes/Accessible.h", "accessible/ipc/RemoteAccessible.h", "accessible/mac/mozAccessible.mm", "accessible/windows/ia2/ia2Accessible.cpp", "accessible/windows/uia/uiaRawElmProvider.cpp", "accessible/xpcom/xpcAccessible.cpp"], "git_node": "d4dd57c4781e740339545bde864003bd4aaf2937", "git_parents": ["a23a6b00555d371f9dd259e37d0147f50be45b10"], "node": "0666f7ad6cf8acb6fd238ddfe069266cf1dad909", "parents": ["d94056a9cb9c32d801091e1c436e6290e87f74dd"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072101 part 2: Fix RemoteAccessible ref counting assertions to handle access from the Android UI thread. r=accessibility-platform-reviewers,eeejay\n\nRemoteAccessible previously used NS_INLINE_DECL_VIRTUAL_REFCOUNTING_WITH_DESTROY, whose NS_ASSERT_OWNINGTHREAD assumes a single owning thread.\nIn the next patch, we will use RefPtr\u003cAccessible\u003e in CachedTableAccessible, and CachedTableAccessible is built lazily when first requested.\nThis means it could be built from the Android UI thread.\nOn Android, it's expected and safe to touch the RemoteAccessible tree from either the main thread or the Android UI thread because we always hold an exclusive lock when accessing or mutating the RemoteAccessible tree.\nTherefore, reimplement ref counting for RemoteAccessible to assert that this lock is held on Android, rather than asserting the main thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328383\n", "files": ["accessible/ipc/RemoteAccessible.cpp", "accessible/ipc/RemoteAccessible.h"], "git_node": "11ece668098f6704faa5f0bf1ff10d35809257c5", "git_parents": ["d4dd57c4781e740339545bde864003bd4aaf2937"], "node": "1bbe9c29044b1421c8891f2c4f18841f40e21fe5", "parents": ["0666f7ad6cf8acb6fd238ddfe069266cf1dad909"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072101 part 3: Use RefPtr for CachedTableAccessible. r=accessibility-platform-reviewers,eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326835\n", "files": ["accessible/base/CachedTableAccessible.h"], "git_node": "33db56b6aef731ed24af2456be7986d84d49c6fb", "git_parents": ["11ece668098f6704faa5f0bf1ff10d35809257c5"], "node": "c2ff5d90f375c71908423850b3f11fa69d5ab507", "parents": ["1bbe9c29044b1421c8891f2c4f18841f40e21fe5"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072320 - Move the  promo section above resume PUWYLO cards r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328194\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_footer.js"], "git_node": "66ec76aeaea191123319a466889ca6c327bf64c0", "git_parents": ["33db56b6aef731ed24af2456be7986d84d49c6fb"], "node": "ad5c31d80a9363136e23db099e129e378ca262a1", "parents": ["c2ff5d90f375c71908423850b3f11fa69d5ab507"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Do not let a closing window clobber another notification's active infobar r=omc-reviewers,hanna_a\n\nThe per-window unload listener could overwrite `_activeInfobar` after its notification had been replaced. Its universal handoff also used the wrong property name and a DOM element instead of the owning `InfoBarNotification`.\n\nA universal notification keeps the same owner while any of its bars remain visible. Leave that active state in place, and allow an unload listener to update it only while its notification is still active.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320930\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "e6b2e656233ff31ebe2dbaa82cfd13c666dbbfac", "git_parents": ["66ec76aeaea191123319a466889ca6c327bf64c0"], "node": "7f818c2bb8f6caa96f284a7a2b67ef078f0bcc62", "parents": ["ad5c31d80a9363136e23db099e129e378ca262a1"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Track active infobars by notification identity r=omc-reviewers,hanna_a\n\nAn animated bar's delayed `removed` callback can run after another notification with the same message ID becomes active. Comparing IDs lets the old callback clear the new notification's tracking, so compare `InfoBarNotification` identity instead.\n\nReuse the active notification when adding a universal bar to a newly opened window so dismissing it from any window removes every copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320931\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "af23260665dbad3ce3652c42f0b4170c72d9cbf1", "git_parents": ["e6b2e656233ff31ebe2dbaa82cfd13c666dbbfac"], "node": "6f1a0b0ed8fb699e4c07b20150291e452030ee3c", "parents": ["7f818c2bb8f6caa96f284a7a2b67ef078f0bcc62"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Release the active infobar slot when a show fails r=omc-reviewers,hanna_a\n\n`_activeInfobar` is reserved before display begins. If localization or `appendNotification()` fails, stale state can block later messages and a universal show may leave bars in only some windows.\n\nWhen the failed notification still owns the slot, remove any partial universal display and clear the slot. The ownership check prevents a superseded show from cleaning up its successor's state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320932\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "4493e938014d39cb96cc006a5ebd3750dfc68a9d", "git_parents": ["af23260665dbad3ce3652c42f0b4170c72d9cbf1"], "node": "daf9f2c401c9d4803194b4682aad453759439b92", "parents": ["6f1a0b0ed8fb699e4c07b20150291e452030ee3c"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Remove a bar appended by a superseded show r=omc-reviewers,hanna_a\n\nA replacement can become active while an earlier show is waiting for `appendNotification()`. When the earlier append completes, its bar would remain visible but untracked.\n\nIf the notification no longer owns the active slot, remove the appended bar immediately and do not record an impression.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320933\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "4ebad1e2b16f893434c0962d98f4c4b5b8a54dac", "git_parents": ["4493e938014d39cb96cc006a5ebd3750dfc68a9d"], "node": "66865f3fccef81a12199c0ef227a5aaada610de8", "parents": ["daf9f2c401c9d4803194b4682aad453759439b92"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Translate \u003cremote-text\u003e whenever it renders r=omc-reviewers,hanna_a\n\n`RemoteL10n` does not observe the element's shadow root, so changing its message ID or variables updates Fluent attributes without updating the visible text. Translate from `render()` and add `setVariable()` for updating rendered messages.\n\nAn existing shadow root already contains changes made while disconnected, so reconnection does not render again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320934\n", "files": ["browser/components/asrouter/content/components/remote-text.js", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js"], "git_node": "9346d4a16d20831aca3ef36411f86ce545b65124", "git_parents": ["4ebad1e2b16f893434c0962d98f4c4b5b8a54dac"], "node": "275cc7d900a9394ac20e1578bd17faa2947d68c1", "parents": ["66865f3fccef81a12199c0ef227a5aaada610de8"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Sequence \u003cremote-text\u003e translations and handle failures r=omc-reviewers,hanna_a\n\nOverlapping translations can finish out of order and restore stale text. Queue each element's `translateFragment()` calls so they run in render order.\n\nCatch and report rejected translations instead of leaving them as unhandled promise rejections.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320935\n", "files": ["browser/components/asrouter/content/components/remote-text.js", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js"], "git_node": "c86259f1d4c19183e0949ad1810779fb53be4fcf", "git_parents": ["9346d4a16d20831aca3ef36411f86ce545b65124"], "node": "3c5e775cfbd015104bb9ed2d866a3a4f9fc50ee2", "parents": ["275cc7d900a9394ac20e1578bd17faa2947d68c1"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Match universal infobar entries against their window r=omc-reviewers,hanna_a\n\nUniversal infobar entries were matched to windows through NotificationBox.documentGlobal, which does not exist. This kept closed-window entries alive.\n\nStore the window with each entry and match it directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321897\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "497f9ed12d1bcaf7a1efbb241fe52b694843818d", "git_parents": ["c86259f1d4c19183e0949ad1810779fb53be4fcf"], "node": "f78b8b306e7e6446e1d9e178a345d732ca59f766", "parents": ["3c5e775cfbd015104bb9ed2d866a3a4f9fc50ee2"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066128 - Show a universal infobar in a window that is still loading r=omc-reviewers,hanna_a\n\nA window already loading when a universal infobar is shown is skipped and missed by the new-window observer.\n\nShow the infobar when the window finishes loading.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324384\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "e7118cc698366fc10b865d5264327a9dc0e334f5", "git_parents": ["497f9ed12d1bcaf7a1efbb241fe52b694843818d"], "node": "e05f835913e604b96d5ec7f39dbb353546fd28bc", "parents": ["f78b8b306e7e6446e1d9e178a345d732ca59f766"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2074823 - Don't set contentDescription to space. r=accessibility-platform-reviewers,geckoview-reviewers,morgan,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328622\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "c950daa5f7f48a6d206f1fcc9f19b3176baa556e", "git_parents": ["e7118cc698366fc10b865d5264327a9dc0e334f5"], "node": "90af375a8e2e2f52ed993f9863f759542584fce7", "parents": ["e05f835913e604b96d5ec7f39dbb353546fd28bc"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057687 - Add telemetry to scrollable screenshot API to track failure rate r=android-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327498\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineView.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/facts/GeckoEngineViewFacts.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineViewTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/MetricController.kt"], "git_node": "aa6ca6b5911cf9caf74a993b1a1d12952df5dc9f", "git_parents": ["c950daa5f7f48a6d206f1fcc9f19b3176baa556e"], "node": "966a389af387ef39ad26f25e4050b6061a9d7e26", "parents": ["90af375a8e2e2f52ed993f9863f759542584fce7"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071024 - Part 1: Support synthesizing mouse event with movement delta; r=smaug,webidl\n\nmovementX and movementY are optional and have to be specified together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327428\n", "files": ["dom/base/nsContentUtils.cpp", "dom/events/test/pointerevents/mochitest.toml", "dom/events/test/pointerevents/test_synthesized_mouse.html", "dom/webidl/Window.webidl", "testing/mochitest/tests/SimpleTest/EventUtils.js"], "git_node": "55cbc56fd92642416f037f056b52694895b6e1da", "git_parents": ["aa6ca6b5911cf9caf74a993b1a1d12952df5dc9f"], "node": "c672294d2d75188fb7370bb603970d98be90565d", "parents": ["966a389af387ef39ad26f25e4050b6061a9d7e26"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071024 - Part 2: Add test for movementX/Y during pointer lock; r=smaug\n\nThe expected result for coalesced event is based on current behavior, which may\nbe incorrect and will be fixed in subsequent patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327917\n", "files": ["dom/tests/mochitest/pointerlock/mochitest.toml", "dom/tests/mochitest/pointerlock/test_pointerlock_coalesced_movementXY.html"], "git_node": "efcc9087b49f4359dd28ca1dfc5de3a0f739ffa4", "git_parents": ["55cbc56fd92642416f037f056b52694895b6e1da"], "node": "3c0523a2373028d1516e71191fe366c78c5d91ff", "parents": ["c672294d2d75188fb7370bb603970d98be90565d"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071024 - Part 3: Propagate mMovement to the coalesced pointer event; r=smaug\n\nePointerRawUpdate never has coalesced widget events to report, so\nEnsureFillingCoalescedEvents() creates a single entry from the dispatched\nevent via InitCoalescedEventFromPointerEvent(), which copied every member but\nmMovement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326985\n", "files": ["dom/events/PointerEventHandler.cpp", "dom/tests/mochitest/pointerlock/test_pointerlock_coalesced_movementXY.html"], "git_node": "3d4fb7a1cf19c276a5b8b214f890bb3c4dc423b7", "git_parents": ["efcc9087b49f4359dd28ca1dfc5de3a0f739ffa4"], "node": "c91e97674283b37e70e4ed3f58cf450c1489e7b6", "parents": ["3c0523a2373028d1516e71191fe366c78c5d91ff"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071024 - Part 4: Allow mousemove events that carry movement deltas to be coalesced; r=smaug\n\nCanCoalesce() incorrectly required the movement deltas of both events to be\nequal, so mousemove events carrying movement deltas were effectively never\ncoalesced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327922\n", "files": ["dom/ipc/CoalescedMouseData.cpp", "dom/tests/mochitest/pointerlock/test_pointerlock_coalesced_movementXY.html"], "git_node": "df43b134c3daaefc7ca87d50547e94189ea4bf5b", "git_parents": ["3d4fb7a1cf19c276a5b8b214f890bb3c4dc423b7"], "node": "b42c0de1a8567eeb014cb0c334b45704b17a6580", "parents": ["c91e97674283b37e70e4ed3f58cf450c1489e7b6"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067198 - Update HomepageHeader to the latest designs, and set the entry points experiment to false by default r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326013\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/ExperimentalHomepageHeader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/HomepageHeader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/MiddleSearchHomepage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Wordmark.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/WordmarkAndLogo.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/ui/WordmarkTest.kt"], "git_node": "9ef11a7a0b66188a866a84db766361ef2c844e49", "git_parents": ["df43b134c3daaefc7ca87d50547e94189ea4bf5b"], "node": "ada440e46af68b76bd54d1b261744afd9291609c", "parents": ["b42c0de1a8567eeb014cb0c334b45704b17a6580"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072025 - Remove stories section from homepage r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326014\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/MiddleSearchHomepage.kt"], "git_node": "c2904da4c0f154c0fb80a0391b28a31807816791", "git_parents": ["9ef11a7a0b66188a866a84db766361ef2c844e49"], "node": "80ebd02e2a0b5c04029d1e6d02771836bf23b444", "parents": ["ada440e46af68b76bd54d1b261744afd9291609c"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074758 - Clarify implementation detail in DequantizeMonotonic r=gfx-reviewers,bradwerth\n\n*SeekNeq(*part_first, part_first, tail_begin) is only valid if the\noptional value returned by SeekNeq actually holds a value.\n\ntail_begin is initialized in such a way that this should always happen,\nbut let's assert this to make it clear to the reader and to linters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328435\n", "files": ["gfx/gl/Colorspaces.h"], "git_node": "843598e2e245456e3353b8391a8539156bd6554a", "git_parents": ["c2904da4c0f154c0fb80a0391b28a31807816791"], "node": "abead94a5cedae82f837d35ebac49c865be5ef69", "parents": ["80ebd02e2a0b5c04029d1e6d02771836bf23b444"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/streams, dom/network & dom/origin-trials headers through clang-tidy r=saschanaz\n\nActually only make every header self-contained so that they can be\nanalyzed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327964\n", "files": ["dom/network/Constants.h", "dom/origin-trials/OriginTrialsIPCUtils.h", "dom/streams/ReadableStreamDefaultReader.cpp", "dom/streams/ReadableStreamGenericReader.h", "dom/streams/WritableStreamDefaultWriter.cpp", "dom/streams/WritableStreamDefaultWriter.h"], "git_node": "ae7734b2b78166c29c52d69cfb2af51512b818f8", "git_parents": ["843598e2e245456e3353b8391a8539156bd6554a"], "node": "d3dacb1886ba4018f11292f1cc183ae757811836", "parents": ["abead94a5cedae82f837d35ebac49c865be5ef69"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070905 - Teach GMP scripts to generate yml for Widevine artifacts used in CI. r=media-playback-reviewers,chunmin\n\nAdds a new --yml switch used to generate the output required to\noverwrite taskcluster/kinds/fetch/widevine.yml to update the\nartifacts pulled from the Chromium component update service:\n\ngenerateGmpJson.py --yml [--testrequest] widevine\n\nThis can be used in conjunction with --testrequest to pull the beta\nplugins as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324955\n", "files": ["dom/media/tools/generateGmpJson.py"], "git_node": "92db4f0480e8d736e36efbca3946c4515f988ad4", "git_parents": ["ae7734b2b78166c29c52d69cfb2af51512b818f8"], "node": "1b464446e26358f2bda25a9cbabeb904893c5dcd", "parents": ["d3dacb1886ba4018f11292f1cc183ae757811836"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Run the bouncer check from a mozrelease script and delete the mozharness one. r=ahal,taskgraph-reviewers,releng-reviewers,jcristau\n\n`bouncer_check.py` used mozharness only for option parsing, logging and\nthe layered config. The argparse script in `python/mozrelease` does the\nsame check. It HEADs each URL with three retries, requires an https\nresult on an allowed CDN host and exits 1 when any URL fails. The five\nproduct dictionaries from `configs/releases` become YAML data next to\nit, and the bouncer prefix, locales and CDN hosts that came through\n`EXTRA_MOZHARNESS_CONFIG` are command line arguments the transform\nbuilds from run fields the kinds now carry. Both kinds check out with\nthe `mach` sparse profile since nothing under `testing/mozharness` is\nneeded anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327649\n", "files": ["python/mozrelease/mozrelease/bouncer/firefox_beta.yml", "python/mozrelease/mozrelease/bouncer/firefox_devedition.yml", "python/mozrelease/mozrelease/bouncer/firefox_esr.yml", "python/mozrelease/mozrelease/bouncer/firefox_nightly.yml", "python/mozrelease/mozrelease/bouncer/firefox_release.yml", "python/mozrelease/mozrelease/bouncer_check.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_bouncer_check.py", "taskcluster/gecko_taskgraph/transforms/bouncer_check.py", "taskcluster/kinds/cron-bouncer-check/kind.yml", "taskcluster/kinds/release-bouncer-check/kind.yml", "testing/mozharness/configs/releases/bouncer_firefox_beta.py", "testing/mozharness/configs/releases/bouncer_firefox_devedition.py", "testing/mozharness/configs/releases/bouncer_firefox_esr.py", "testing/mozharness/configs/releases/bouncer_firefox_nightly.py", "testing/mozharness/configs/releases/bouncer_firefox_release.py", "testing/mozharness/scripts/release/bouncer_check.py"], "git_node": "d7c01fb67706a632ae840830eac97039e9ae7b04", "git_parents": ["92db4f0480e8d736e36efbca3946c4515f988ad4"], "node": "cec02ee161d380cedac836ff893aa7a3c8acad8a", "parents": ["1b464446e26358f2bda25a9cbabeb904893c5dcd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Move the update verify config creator to mozrelease and drop `BaseScript`. r=taskgraph-reviewers,releng-reviewers,jcristau\n\nThe script already ran under `mach python` and imported mozrelease for\nevery release path helper, so it becomes a plain argparse script next to\nthem. Option parsing, logging and the retrying download are the only\nmozharness pieces it used. The retry keeps the same exception list and\nattempt counts, hg fallback to GitHub included, and the config it writes\nis unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327651\n", "files": ["python/mozrelease/mozrelease/update_verify_config_creator.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_update_verify_config_creator.py", "taskcluster/gecko_taskgraph/transforms/update_verify_config.py", "taskcluster/kinds/release-update-verify-config-next/kind.yml", "taskcluster/kinds/release-update-verify-config/kind.yml", "testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": "982955c55b3cd333710f48cc37d824141d0cb9ca", "git_parents": ["d7c01fb67706a632ae840830eac97039e9ae7b04"], "node": "d8e13aed455129e372c1d6517c872e962b17e94b", "parents": ["cec02ee161d380cedac836ff893aa7a3c8acad8a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Move the Merkle tree and checksums file helpers to mozrelease. r=ahal\n\n`merkle.py` and `checksums.py` are release tooling with no mozharness\ndependency. They move unchanged together with the Merkle unit test,\nwhose vectors `BTVerificationTest.cpp` cites. The checksum generator\nimports them from the new place so the task keeps working at this\ncommit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327652\n", "files": ["python/mozrelease/mozrelease/checksums.py", "python/mozrelease/mozrelease/merkle.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_merkle.py", "security/ct/tests/gtest/BTVerificationTest.cpp", "testing/mozharness/mozharness/mozilla/checksums.py", "testing/mozharness/mozharness/mozilla/merkle.py", "testing/mozharness/scripts/release/generate-checksums.py", "testing/mozharness/test/python.toml", "testing/mozharness/test/test_mozilla_merkle.py"], "git_node": "fd9a379b5881df6d81048e12f09cb2e545318c1f", "git_parents": ["982955c55b3cd333710f48cc37d824141d0cb9ca"], "node": "8fd64af323a65f7b676c1b7e601b7f88d5dc54ce", "parents": ["d8e13aed455129e372c1d6517c872e962b17e94b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Generate the release checksums from mozrelease without mozharness or boto3. r=taskgraph-reviewers,releng-reviewers,jcristau\n\n`generate-checksums.py` used mozharness for option parsing, logging and\na virtualenv whose only purpose was boto3. The bucket is read unsigned\nthrough the S3 compatible XML listing and plain object fetches, so\n`requests` from the common site covers it and no virtualenv step\nremains. The kind runs the script under mach with the build image and\nwrites the SUMS and SUMMARY files to the artifact directory. The output\nfor 155.0.1 build1 is byte identical to the published files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327653\n", "files": ["python/mozrelease/mozrelease/generate_checksums.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_generate_checksums.py", "taskcluster/gecko_taskgraph/transforms/release_generate_checksums.py", "taskcluster/kinds/release-generate-checksums/kind.yml", "testing/mozharness/scripts/release/generate-checksums.py"], "git_node": "4dd6afacd4f9046ee61dfabb93bc4a1664b34b8f", "git_parents": ["fd9a379b5881df6d81048e12f09cb2e545318c1f"], "node": "16659775eba60958de731063022e9684dd848983", "parents": ["8fd64af323a65f7b676c1b7e601b7f88d5dc54ce"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073829 - Run the desktop partner repacks from a run-task script. r=ahal,taskgraph-reviewers,releng-reviewers\n\n`desktop_partner_repacks.py` only fetched the GitHub ssh key, downloaded\nthe `repo` tool, ran `repo init` and `repo sync` with retries, and then\ninvoked `mach python partner_repack.py`. `partner-repack.sh` does the\nsame four steps with the task environment the transform already\nprovided, plus `REPACK_*` variables for the version, build number,\nplatform, partners and locale limit that used to travel as\n`MOZHARNESS_OPTIONS`. The ssh key comes from the same secret through the\ntaskcluster proxy, which `run-task` tasks with an hg checkout already\nenable. The `public/logs` artifact goes with the mozharness log. The\ntask graph for `mr-promote-firefox` is otherwise unchanged in scopes,\ndependencies and features.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327654\n", "files": ["taskcluster/docs/partner-repacks.md", "taskcluster/gecko_taskgraph/transforms/partner_repack.py", "taskcluster/kinds/release-eme-free-repack/kind.yml", "taskcluster/kinds/release-partner-repack/kind.yml", "taskcluster/scripts/release/partner-repack.sh", "testing/mozharness/configs/partner_repacks/release_mozilla-release_desktop.py", "testing/mozharness/configs/partner_repacks/release_mozilla-release_desktop_EME-free.py", "testing/mozharness/configs/partner_repacks/staging_release_mozilla-release_desktop.py", "testing/mozharness/scripts/desktop_partner_repacks.py"], "git_node": "bbdc31c438420093f3023bfeb871cb8b0a7ed7e0", "git_parents": ["4dd6afacd4f9046ee61dfabb93bc4a1664b34b8f"], "node": "5c43adfac2f431194a622d6f5c0fc574ac4c4ae2", "parents": ["16659775eba60958de731063022e9684dd848983"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073826 - Move `does_it_crash.py` to `taskcluster/scripts/tests` and drop `BaseScript`. r=taskgraph-reviewers,jcristau\n\nThe startup test is pure CI glue with no local use. It already ran under\n`mach python`, imported `mozinstall` and `mozprocess` directly and used\nmozharness only for option parsing and logging, so it becomes an\nargparse script that exits 1 when the binary does not survive the run\nand still prints the `TEST-UNEXPECTED-FAIL` line Treeherder keys on. The\n`startup-test` sparse profile no longer needs `testing/mozharness`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327655\n", "files": ["build/sparse-profiles/startup-test", "taskcluster/gecko_taskgraph/transforms/startup_test.py", "taskcluster/scripts/tests/does_it_crash.py", "testing/mozharness/scripts/does_it_crash.py"], "git_node": "9fd335717fa334a13246cc67e25da6ba197b3f55", "git_parents": ["bbdc31c438420093f3023bfeb871cb8b0a7ed7e0"], "node": "e011e2307d43fa4f3e9f44a1e116bb4fa5be0339", "parents": ["5c43adfac2f431194a622d6f5c0fc574ac4c4ae2"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Set `MOZCONFIG` in the environment of mozharness build tasks from taskgraph. r=ahal,taskgraph-reviewers,releng-reviewers\n\nThe mozconfig a build uses is task configuration, and taskgraph already\nresolves the variant, so it computes the path and passes it to the task\nas `MOZCONFIG`. The platform defaults to the longest mozconfig directory\nname that prefixes the task name, the application to `browser` or to\n`mobile/android` for Android platforms. A task with `config-paths` has\nto name its application, so comm-central fails at graph generation\ninstead of building from Firefox mozconfigs. Kinds that took a variant,\nplatform or application from a mozharness config now say so in their\nkind definitions. `artifact-build` and `valgrind` do not run the build\ntransforms and set the variable directly. The macOS unify tasks never\nrun mozharness and get nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327665\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_build.py", "taskcluster/gecko_taskgraph/transforms/build.py", "taskcluster/kinds/artifact-build/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build/android-asan.yml", "taskcluster/kinds/build/android-stuff.yml", "taskcluster/kinds/build/fenix.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx-native.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/release-source/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/valgrind/kind.yml"], "git_node": "7fff2c4913312b460004ca162e548c7232b0e2af", "git_parents": ["9fd335717fa334a13246cc67e25da6ba197b3f55"], "node": "4ad924813fdf26c9811ed8e8353adf18374a2c1b", "parents": ["e011e2307d43fa4f3e9f44a1e116bb4fa5be0339"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Take the mozconfig path from `MOZCONFIG` in mozharness builds. r=ahal\n\nThe task environment's `MOZCONFIG` is the source path relative to the\ncheckout, which mozharness copies to `.mozconfig` with\n`extra_mozconfig_content` appended. mozharness then points the build\nenvironment's `MOZCONFIG` at that `.mozconfig`, since mach reads\n`MOZCONFIG` before `.mozconfig` and the extra content would otherwise be\ndropped. `get_mozconfig_path` stays for `desktop_l10n.py`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327666\n", "files": ["testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": "8be914ff1e59962aac996de0d8de2dddf4f66238", "git_parents": ["7fff2c4913312b460004ca162e548c7232b0e2af"], "node": "5d4bf7f7aa09c48a935def7499bce52fbbd5680c", "parents": ["4ad924813fdf26c9811ed8e8353adf18374a2c1b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Drop the mozconfig keys from the mozharness build configs. r=ahal\n\nNothing reads `app_name`, `mozconfig_platform`, `mozconfig_variant` or\n`src_mozconfig` from these files any more. The variant configs stay\nbecause most of them still carry `debug_build`, `env`,\n`disable_package_metrics` or `postflight_build_mach_commands`, and the\nAndroid ones that end up empty keep `--custom-build-variant-cfg` set,\nwhich `_is_configuration_shipped` checks through `build_variant`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327667\n", "files": ["testing/mozharness/configs/builds/releng_base_android_64_builds.py", "testing/mozharness/configs/builds/releng_base_firefox.py", "testing/mozharness/configs/builds/releng_base_linux_64_builds.py", "testing/mozharness/configs/builds/releng_base_mac_64_cross_builds.py", "testing/mozharness/configs/builds/releng_base_windows_32_mingw_builds.py", "testing/mozharness/configs/builds/releng_base_windows_64_mingw_builds.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_fenix_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_asan_tc.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_geckoview_docs.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_ccov.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug_isolated_process.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_opt.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_source.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_valgrind.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_opt_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/rusttests.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_mingwclang.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_mingwclang.py", "testing/mozharness/configs/builds/taskcluster_base_win32.py", "testing/mozharness/configs/builds/taskcluster_base_win64.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/plain_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/rusttests_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_opt.py"], "git_node": "6b7428c2d74c44134278c104d05e70f37c7dfb5a", "git_parents": ["8be914ff1e59962aac996de0d8de2dddf4f66238"], "node": "4899fbd90ba52e5f8ee33320ede82dc73679633c", "parents": ["5d4bf7f7aa09c48a935def7499bce52fbbd5680c"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063550 - Fix tracker numbers not being announced on NVDA screen reader mouse over. r=Dre,Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328396\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx"], "git_node": "c09d4fdca0242ec16dad33287f5f36897f586779", "git_parents": ["6b7428c2d74c44134278c104d05e70f37c7dfb5a"], "node": "151013c499b07e8af3b95c6a9272a43e8b1e78de", "parents": ["4899fbd90ba52e5f8ee33320ede82dc73679633c"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074691 - Add a JS::NewArrayBuffer() overload that copies the data given r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328310\n", "files": ["js/public/ArrayBuffer.h", "js/public/experimental/TypedData.h", "js/src/jsapi-tests/testArrayBuffer.cpp", "js/src/vm/ArrayBufferObject.cpp", "js/src/vm/ArrayBufferObject.h"], "git_node": "bdd1884fa9f3dd72cec505ebd1ae1199e667b94e", "git_parents": ["c09d4fdca0242ec16dad33287f5f36897f586779"], "node": "ce14b362fd961c61a41d94b75b1c5c802be4fe49", "parents": ["151013c499b07e8af3b95c6a9272a43e8b1e78de"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072006 - PBW Fade in animation. r=omc-reviewers,desktop-theme-reviewers,akulyk,emcminn\n\nThe redesigned private browsing page reveals its components one at a time: the\nkit animation, then the mask and \"You're off the record\" together, the\nsub-header, the search bar, and the \"Private window basics\" link. An\n`intro-playing` class drives it, so it is gated on the same once-per-profile\nflag and reduced-motion check as the kit animation. Elements are hidden with\n`visibility`, so nothing is clickable or focusable before it appears.\n\nNo pb_newtab message is served while the intro plays, without spending the\nmessage's frequency allocation.\n\nTo test:\n\n- Set `browser.privateWindowRedesign.enabled` to true\n- Set `browser.privatebrowsing.introAnimationShown` to false\n- Open a private window. Reset the second pref to replay it\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327513\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.js", "browser/components/privatebrowsing/content/private-browsing-mask-intro.css", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_kit_intro.js", "browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css"], "git_node": "9cc233991ae7112c1a31b44cf1cd54f233b1b868", "git_parents": ["bdd1884fa9f3dd72cec505ebd1ae1199e667b94e"], "node": "6c87aa4f178ce289be3b254622ae8eea23b939dc", "parents": ["ce14b362fd961c61a41d94b75b1c5c802be4fe49"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2069111 - AITab Timeline component - r=omarg,gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327986\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-timeline/aitab-timeline.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-timeline/aitab-timeline.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-timeline/aitab-timeline.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js"], "git_node": "18706015212dcb16aba674791faf5313f58376c4", "git_parents": ["9cc233991ae7112c1a31b44cf1cd54f233b1b868"], "node": "515c3d48a854cc692c9a3399a853da1fda685a54", "parents": ["6c87aa4f178ce289be3b254622ae8eea23b939dc"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073840 - Add lifecycle diagrams to the async tab switcher docs. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327664\n", "files": ["browser/components/tabbrowser/docs/async-tab-switcher.md"], "git_node": "ee0169b77277ad86f9c5e8840580ed915af51455", "git_parents": ["18706015212dcb16aba674791faf5313f58376c4"], "node": "d529a48048fc8ff8e1e87171bf7106b96dac130e", "parents": ["515c3d48a854cc692c9a3399a853da1fda685a54"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073844, Bug 2073826, Bug 2073829, Bug 2073828 - Drop the mozconfig keys from the mozharness build configs. r=ahal\" for causing Gecko Decision bustage\n\nThis reverts commit 6b7428c2d74c44134278c104d05e70f37c7dfb5a.\n\nRevert \"Bug 2073844 - Take the mozconfig path from `MOZCONFIG` in mozharness builds. r=ahal\"\n\nThis reverts commit 8be914ff1e59962aac996de0d8de2dddf4f66238.\n\nRevert \"Bug 2073844 - Set `MOZCONFIG` in the environment of mozharness build tasks from taskgraph. r=ahal,taskgraph-reviewers,releng-reviewers\"\n\nThis reverts commit 7fff2c4913312b460004ca162e548c7232b0e2af.\n\nRevert \"Bug 2073826 - Move `does_it_crash.py` to `taskcluster/scripts/tests` and drop `BaseScript`. r=taskgraph-reviewers,jcristau\"\n\nThis reverts commit 9fd335717fa334a13246cc67e25da6ba197b3f55.\n\nRevert \"Bug 2073829 - Run the desktop partner repacks from a run-task script. r=ahal,taskgraph-reviewers,releng-reviewers\"\n\nThis reverts commit bbdc31c438420093f3023bfeb871cb8b0a7ed7e0.\n\nRevert \"Bug 2073828 - Generate the release checksums from mozrelease without mozharness or boto3. r=taskgraph-reviewers,releng-reviewers,jcristau\"\n\nThis reverts commit 4dd6afacd4f9046ee61dfabb93bc4a1664b34b8f.\n\nRevert \"Bug 2073828 - Move the Merkle tree and checksums file helpers to mozrelease. r=ahal\"\n\nThis reverts commit fd9a379b5881df6d81048e12f09cb2e545318c1f.\n\nRevert \"Bug 2073828 - Move the update verify config creator to mozrelease and drop `BaseScript`. r=taskgraph-reviewers,releng-reviewers,jcristau\"\n\nThis reverts commit 982955c55b3cd333710f48cc37d824141d0cb9ca.\n\nRevert \"Bug 2073828 - Run the bouncer check from a mozrelease script and delete the mozharness one. r=ahal,taskgraph-reviewers,releng-reviewers,jcristau\"\n\nThis reverts commit d7c01fb67706a632ae840830eac97039e9ae7b04.\n", "files": ["build/sparse-profiles/startup-test", "python/mozrelease/mozrelease/bouncer/firefox_beta.yml", "python/mozrelease/mozrelease/bouncer/firefox_devedition.yml", "python/mozrelease/mozrelease/bouncer/firefox_esr.yml", "python/mozrelease/mozrelease/bouncer/firefox_nightly.yml", "python/mozrelease/mozrelease/bouncer/firefox_release.yml", "python/mozrelease/mozrelease/bouncer_check.py", "python/mozrelease/mozrelease/checksums.py", "python/mozrelease/mozrelease/generate_checksums.py", "python/mozrelease/mozrelease/merkle.py", "python/mozrelease/mozrelease/update_verify_config_creator.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_bouncer_check.py", "python/mozrelease/test/test_generate_checksums.py", "python/mozrelease/test/test_merkle.py