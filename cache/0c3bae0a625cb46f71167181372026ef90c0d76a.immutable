410cde1c2d6", "parents": ["d9ec331fb046313ef977b648a942d1795ee6ce01"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072213 - Consider speculative loads on links changes. r=dom-core-reviewers,jjaschke\" for causing bc failures @ browser_ext_url_overrides_newtab.js\n\nThis reverts commit f8941394ea376f1d5471b37d72ce2fb82dcb44eb.\n", "files": ["dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini"], "git_node": "7fa6e49ce9b56a27ebd0219e524c1091043ec732", "git_parents": ["ccbde0e14438c87c2fb2670631374ff5c30682f2"], "node": "f0afea574f8955ed7ca93911ddb8b9fca4778c5a", "parents": ["ae6ac816e7a83961051867e5a280c410cde1c2d6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071753 - Drop the container submenu items' accesskeys. r=daisuke,urlbar-reviewers\n\nThe rest of the bug removes the accesskeys from the messages; this is the half that sits on top of D324483, which added them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325833\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js"], "git_node": "96aff1dfb7d0abcba4b6581abf99497edfe5e703", "git_parents": ["7fa6e49ce9b56a27ebd0219e524c1091043ec732"], "node": "0a38c55632fe59d546f460607a708306fca157ee", "parents": ["f0afea574f8955ed7ca93911ddb8b9fca4778c5a"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064849 - Build the synthesis queue r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325920\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/content/TextChunker.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ChunkAudio.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/ChunkSizing.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SpeechSynthesizer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SplitArticle.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueue.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/content/TextChunkerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ChunkAudioTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/synthesis/ChunkSizingTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueueTest.kt"], "git_node": "be7e9744d84af2406c96396965b838163fe86c52", "git_parents": ["96aff1dfb7d0abcba4b6581abf99497edfe5e703"], "node": "461507083f38197e6f5a20524d989506661b2c5e", "parents": ["0a38c55632fe59d546f460607a708306fca157ee"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062640 - Fix idlharness nullable-typedef attribute ordering. r=webidl,webrtc-reviewers,firefox-style-system-reviewers,ng,bwc,farre,emilio\n\nassert_type_is() substituted typedefs before checking nullability, so a\nnullable attribute whose type is a typedef (e.g. DOMHighResTimeStamp?)\nlost its own nullability and was checked against the typedef's\nnon-nullable declaration instead. This made RTCRtpReceiver's\njitterBufferTarget, PerformancePaintTiming's presentationTime,\nCSSImportRule's layerName/supportsText, and similar attributes fail\nidlharness even when correctly returning null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326327\n", "files": ["testing/web-platform/meta/css/cssom/idlharness.html.ini", "testing/web-platform/meta/paint-timing/idlharness.window.js.ini", "testing/web-platform/meta/webrtc/idlharness.https.window.js.ini", "testing/web-platform/tests/resources/idlharness.js"], "git_node": "3523cbf7a5dcb9a30ef9e81fe5031ba56db79ce7", "git_parents": ["be7e9744d84af2406c96396965b838163fe86c52"], "node": "44a9ce387386d1ec99ddb5c591ad07dde0af391b", "parents": ["461507083f38197e6f5a20524d989506661b2c5e"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071957 - Fix crash when tapping the VPN location row while the unavailable dialog opens r=android-reviewers,pollymce\n\nThe navigation action `action_ipProtectionFragment_to_ipProtectionLocationFragment` is scoped to `ipProtectionFragment`in `nav_graph.xml` so this destination is only resolved when that fragment is the current destination. `IPProtectionFragment` sets up `IPProtectionWarningBinding`, which triggers a navigation event to the unavailable dialog as soon as the proxy raises a `Authorized.ConnectionError`.\n\nWhen the proxy reports an error, `findNavController().navigate(HomeFragmentDirections.actionGlobalIpProtectionUnavailableDialog())` makes the dialog the current destination synchronously. There is a short time window where the current destination is now the dialog, but the fragment transaction is still pending and the dialog is not displayed on top of `IPProtectionFragment`. If a tap on the location row is done in that window, `handleOnLocationClicked` tries to navigate to `IPProtectionLocationsFragment` with the dialog as the current destination so it crashes. This crash can be reproduced by adjusting `handleOnLocationClicked` as follows:\n\n```\nprivate fun handleOnLocationClicked() {\n    findNavController().navigate(HomeFragmentDirections.actionGlobalIpProtectionUnavailableDialog())\n    findNavController().navigate(IPProtectionFragmentDirections.actionIpProtectionFragmentToIpProtectionLocationFragment())\n}\n```\n\nThe fix consists in using the helper `NavController.nav`, which verifies that the current destination is the expected one. If it's not the case, the navigation event is ignored so that `NavController` does not crash. By the way, `NavControllerTest` didn't have a test for the non matching id path, so a test has been added to cover this case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326411\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/NavControllerTest.kt"], "git_node": "0baef60f1e0c1239a7b949cfe8f19a05ad1a1dd3", "git_parents": ["3523cbf7a5dcb9a30ef9e81fe5031ba56db79ce7"], "node": "9d958310cc2812cf81eb002853841fdc244638db", "parents": ["44a9ce387386d1ec99ddb5c591ad07dde0af391b"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix broken links in the testing documentation r=geckodriver-reviewers,webdriver-reviewers,whimboo\n\nThe manifest keyword links now point at manifest-sandbox, the BrowserTestUtils\nand TestUtils links use the js:meth role so sphinx-js resolves them, and the\nRaptor and mach-try-perf static pages are in a toctree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325703\n", "files": ["testing/docs/browser-chrome/writing.md", "testing/docs/tests-for-new-config/manual.md", "testing/docs/xpcshell/index.md", "testing/geckodriver/doc/Support.md", "testing/perfdocs/generated/mach-try-perf.md", "testing/perfdocs/generated/raptor.md", "testing/perfdocs/generated/talos.md", "testing/performance/mach-try-perf/perfdocs/index.md", "testing/raptor/raptor/perfdocs/index.md", "testing/talos/perfdocs/index.md"], "git_node": "6399208a6b0ab89af6a834648e0330367168ccd1", "git_parents": ["0baef60f1e0c1239a7b949cfe8f19a05ad1a1dd3"], "node": "f3dab31e9ae7bb5ae5e92a3cefe344dc0894494d", "parents": ["9d958310cc2812cf81eb002853841fdc244638db"], "tags": []}], "date": 1789590119, "git_changesets": ["4d9e5cec8bc77232f468bcc6e9b58f531a6c9dce", "a80551b58d8fd195f0b1762ce1e2d57533e6f6bf", "9cc6b6e71d2974589ae0a53655665ce1cfe9ff34", "73a03f2aa274037c93dfb0fde205fca2c30556af", "f078847f3de1f1ad15451772bfae5bb1ab8825a8", "3e725f99477e40f64e8db8d13c460ef3645ab46f", "083539c4c58df1bb8c8a578aa0d3d0e5e2224d5c", "c53ad26a74634b0ad878e70e6a9b6b79bb2f17b6", "46ec8405bc350a5f56afe33f0194d6a149828ca5", "62a9c423475eb09658398239fe5c4db79d02f7da", "ccfcb5b87b1e43ea95bd786342d8f94563fbedcb", "ef7abde7418202801a6393d6ea6977a7d8b2f752", "d5e2da8bc148b85f32cb5830064f3fd8d804ac3d", "1febb8b9262150bb133d3ea68d56fbadc7b136ff", "d135288bc6195333190f8c924ebae4080f87c809", "662a2f7034eedb28babba416d155e826b80872ae", "920a85e3498f6