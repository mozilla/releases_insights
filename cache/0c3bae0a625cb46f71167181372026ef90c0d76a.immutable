zilla.com"}, "45327": {"changesets": [{"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - updated default_config_env for v154\n", "files": ["dom/media/webrtc/third_party_build/default_config_env"], "git_node": "76cbb5410ee49d7efe3335805cabb0929ddd388e", "git_parents": ["5b7e5a4dfe77edefea01bc1fa95e663211091907"], "node": "8bd77889507b04ba4a691ba3ec16bee373c6b693", "parents": ["2cca38bf6e363b3dc90b6111bd1f6f9caab85aab"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - updated libwebrtc patch stack\n", "files": ["third_party/libwebrtc/moz-patch-stack/s0151.patch"], "git_node": "8ded35724bb29721fa09a19190214e7a5aacc724", "git_parents": ["76cbb5410ee49d7efe3335805cabb0929ddd388e"], "node": "97fc718396a1801765cfb713d729c6a2d01bb8ea", "parents": ["8bd77889507b04ba4a691ba3ec16bee373c6b693"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 3ce78cdbd8\n\nWe cherry-picked this in bug 2058627.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3ce78cdbd865ad8837d1ffae21553791e8ec491d\n    Screen capture: check n_datas before accessing buffer data planes\n\n    Return early from ProcessBuffer when spa_buffer-\u003en_datas is zero\n    to avoid out-of-bounds access on metadata-only buffers that carry\n    no data planes.\n\n    Bug: chromium:547675865\n    Change-Id: Ib80c88c9bbcd8b7aaf155e620d31e4ea19f51b1a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/496360\n    Reviewed-by: Andreas Pehrson \u003capehrson@mozilla.com\u003e\n    Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Commit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48369}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/3ce78cdbd8.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0072.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/moz-patch-stack/s0149.patch", "third_party/libwebrtc/moz-patch-stack/s0150.patch", "third_party/libwebrtc/moz-patch-stack/s0151.patch"], "git_node": "1ee5cb2eb301786a632f48ee1583f557dfa82a36", "git_parents": ["8ded35724bb29721fa09a19190214e7a5aacc724"], "node": "275b867c532a4b4cadd4613807fc9636fea2b034", "parents": ["97fc718396a1801765cfb713d729c6a2d01bb8ea"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 45a54bd886\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in 0fb9275433.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/45a54bd88620504498cc47fc9bb77517da9a108d\n    Include outstanding data in RetransmissionQueue handover state.\n\n    This adds enable_handover_with_outstanding_data,\n    and wires up outstanding data and send queue handover.\n\n    Bug: webrtc:477364365\n    Change-Id: I70433e4f7b88e7870ae9641993fabea38f4641a3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/452060\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Commit-Queue: Priya Rajarathinam \u003crajarathinam@google.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48370}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/0fb9275433.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "22b7ebef5a22d9957977584fab67b5a6ef82e80c", "git_parents": ["1ee5cb2eb301786a632f48ee1583f557dfa82a36"], "node": "253353659edc9c67b1c33659dd765742bd9d373b", "parents": ["275b867c532a4b4cadd4613807fc9636fea2b034"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 44e38ef0f7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/44e38ef0f75e92f00b98c428b396db3028740ddb\n    Update WebRTC code version (2026-08-18T04:11:55).\n\n    Bug: None\n    Change-Id: I9593e3617d0f8f27af8abbd958b2b26db1f93bd0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/496440\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48371}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "cf4799ab0a0d60a8e0c1a748ae0d08d271f2b76d", "git_parents": ["22b7ebef5a22d9957977584fab67b5a6ef82e80c"], "node": "fe477105a0085b9bb430dd5c11d13422305b6b19", "parents": ["253353659edc9c67b1c33659dd765742bd9d373b"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from f93c4fefee\n\nWe cherry-picked this in bug 2055703.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f93c4fefee56b60876629d03df1ad01e203cc8c3\n    Screen capture: reject negative videocrop position values\n\n    Validate that SPA_META_VideoCrop position coordinates are\n    non-negative before using them as offsets into the frame buffer.\n\n    Bug: chromium:547675861\n    Change-Id: I34e3eeae983e4413c891205b2ea95ec51aeab104\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/496320\n    Reviewed-by: Andreas Pehrson \u003capehrson@mozilla.com\u003e\n    Commit-Queue: Jan Grulich \u003cgrulja@gmail.com\u003e\n    Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48372}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/f93c4fefee.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0072.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/moz-patch-stack/s0149.patch", "third_party/libwebrtc/moz-patch-stack/s0150.patch"], "git_node": "93e1d01af517c176cb735c911c8853a52cd83aa3", "git_parents": ["cf4799ab0a0d60a8e0c1a748ae0d08d271f2b76d"], "node": "8be0b9fbe68d9b4019765bcf3049cf7a319a4f42", "parents": ["fe477105a0085b9bb430dd5c11d13422305b6b19"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069067 - Vendor libwebrtc from 31649659ba\n\nUpstream commit: https://webrtc.googlesource.com/src/+/31649659badc2d4afdd2c7be5ac2e83488114784\n    Roll chromium_revision 86ca5f98b6..fd4ce00a99 (1679463:1681235)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/86ca5f98b6..fd4ce00a99\n    Full diff: https://chromium.googlesource.com/chromium/src/+/86ca5f98b6..fd4ce00a99\n\n    Changed dependencies\n    * fuchsia_version: version:33.20260807.3.1..version:33.20260814.3.1\n    * siso_version: git_revision:1b1109fc6f5e177a439a195b87931224efc7a007..git_revision:bc45e8f67ae0f37d337190ad64aa8bb440c791eb\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/ebfc64fde3..8f616df949\n    * src/buildtools/linux64: git_revision:0db00fc0fb75adf816104951b415769a087144c1..git_revision:1c79e13d17a1760d6c6401c90061411842bd4881\n    * src/buildtools/mac: git_revision:0db00fc0fb75adf816104951b415769a087144c1..git_revision:1c79e13d17a1760d6c6401c90061411842bd4881\n    * src/buildtools/win: git_revision:0db00fc0fb75adf816104951b415769a087144c1..git_revision:1c79e13d17a1760d6c6401c90061411842bd4881\n    * src/ios: https://chromium.google