87b2d5aa73d24f71538dc63cf006dede52dc9", "parents": ["64d41e8853e89a5dce6bbdb0969b6e80b6b5f591"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2071752 - Distinguish List all tabs icon from Minimise on Breeze. r=desktop-theme-reviewers,tabbrowser-reviewers,dao,emilio\n\nOn KDE's default theme Breeze, the Minimize button is a\ndownwards-pointing chevron. With horizontal tabs, the \"List all tabs\"\nbutton is too. Thus, on Breeze, it's better to use the icon we already\nuse when using vertical tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325775\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "f2de5ace1c2a0e760a171f98c6077d286698373f", "git_parents": ["1bb4446d62478b329b9b104570b62f73686679f6"], "node": "524d610a3b29717bd339b1d7c701b05a98579fbf", "parents": ["d4487b2d5aa73d24f71538dc63cf006dede52dc9"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072253 - Add a profiler marker when a new HTTP connection hits the global connection limit r=necko-reviewers,valentin\n\nUseful to be able to catch these situations without MOZ_LOGs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326208\n", "files": ["netwerk/protocol/http/nsHttpConnectionMgr.cpp"], "git_node": "54cbcb5a77aa3b8443b6fd020dc691cc6d97fd11", "git_parents": ["f2de5ace1c2a0e760a171f98c6077d286698373f"], "node": "ea906506c142c34d6a43ed62ec631f98ca74085a", "parents": ["524d610a3b29717bd339b1d7c701b05a98579fbf"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2071658 - Hold refptrs in nsSyncStreamListener::Read / ::ReadSegments r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326873\n", "files": ["netwerk/base/nsSyncStreamListener.cpp"], "git_node": "eff2deda39de271a95a53a777e72a620f29b7e22", "git_parents": ["54cbcb5a77aa3b8443b6fd020dc691cc6d97fd11"], "node": "541622deedd7dd0d7f441ac83155ab2d5211668c", "parents": ["ea906506c142c34d6a43ed62ec631f98ca74085a"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 1931630 - feat(webgpu): wire up reporting of `float32-blendable` device feature r=webgpu-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280997\n", "files": ["dom/webgpu/Adapter.cpp"], "git_node": "7f04279905ca6e6dae4a67d6344e68fe5d748807", "git_parents": ["eff2deda39de271a95a53a777e72a620f29b7e22"], "node": "257d577ad260c54223fc928453c5091772be5c8d", "parents": ["541622deedd7dd0d7f441ac83155ab2d5211668c"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 1931629 - feat(webgpu): enable `clip-distances` when reported as available r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288943\n", "files": ["dom/webgpu/Adapter.cpp"], "git_node": "aeb46cf02b6d9222fb70384fccaf0fbf468b9c13", "git_parents": ["7f04279905ca6e6dae4a67d6344e68fe5d748807"], "node": "d1f187620f6e8b18f2c01307d31e56591f8aa20b", "parents": ["257d577ad260c54223fc928453c5091772be5c8d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2072629 - Remove the URI_LOADABLE_BY_ANYONE flag from the jar: protocol r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326588\n", "files": ["modules/libjar/components.conf", "modules/libjar/test/unit/test_jar_protocol_flags.js", "modules/libjar/test/unit/xpcshell.toml"], "git_node": "da94451bc2f23acbf042958539443af2344ee363", "git_parents": ["aeb46cf02b6d9222fb70384fccaf0fbf468b9c13"], "node": "577710550df33d9dd07db073c33c121c0ddfa7be", "parents": ["d1f187620f6e8b18f2c01307d31e56591f8aa20b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072783 - Use the same representation for style and graphics variation settings. r=layout-reviewers,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326818\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "gfx/2d/FontFeature.h", "gfx/2d/moz.build", "gfx/fontations_glue/lib.rs", "gfx/src/nsFont.cpp", "gfx/src/nsFont.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2Utils.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontFeatures.h", "gfx/thebes/gfxFontVariations.h", "gfx/thebes/gfxHarfBuzzShaper.cpp", "gfx/thebes/gfxMacFont.cpp", "gfx/thebes/gfxUserFontSet.h", "layout/generic/MathMLTextRunFactory.cpp", "layout/inspector/InspectorFontFace.cpp", "layout/style/ServoBindings.toml", "layout/style/ServoStyleConstsForwards.h", "servo/components/style/properties/data.py", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/values/animated/font.rs", "servo/components/style/values/computed/font.rs", "servo/components/style/values/generics/font.rs", "servo/ports/geckolib/cbindgen.toml", "servo/ports/geckolib/glue.rs"], "git_node": "87bb348650d8d9c98722ddfcf465b073312bba87", "git_parents": ["da94451bc2f23acbf042958539443af2344ee363"], "node": "91b81b420feb5becbf01cb963cfd4bb80e05b07d", "parents": ["577710550df33d9dd07db073c33c121c0ddfa7be"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071837 - Add test coverage for the addresses.storage.rust.enabled pref r=joschmidt,credential-management-reviewers\n\nTwo manifests run existing address tests a second time, with the Rust store\nserving every address read and write:\n\n- test/browser/rust/browser.toml includes test/browser/address/ wholesale, so\n  those tests and their skip-if annotations are inherited rather than copied.\n  The entries it lists are the address tests that live in test/browser/ instead,\n  whose manifest also holds credit card, passport and ML tests that must not run\n  against this store; each of those is a shim that loads its original.\n\n- test/unit/xpcshell_rust.toml does the same for test_getRecords.js, and names\n  the storage tests that cannot be shared: they reach either for sync APIs the\n  Rust adapter does not answer, since its sync goes through a bridged engine, or\n  past the collection API into the JSON store.\n\nrust/browser.toml pins rust.active as well as rust.enabled, so the store is\nhanded over before the first test runs rather than by a migration during it.\nMochitest restores every pref Firefox writes during a test back to its startup\nvalue afterwards (SpecialPowersParent.comparePrefsToBaseline), which would clear\nrust.active and hand every test after the first one back to the JSON store.\nxpcshell_rust.toml needs no such pin, since each test there gets its own\nprocess. Both head.js files assert rust.active after the test, so nothing that\nclears it mid-run can leave a suite passing against JSON.\n\nbrowser_address_migration.js moves out of test/browser/rust/, because it covers\nthe migration rather than re-running a test under a different pref. Its fixture\nnow carries a multi-line street address and a phone number, so the fields Rust\nderives on read from the single column it stores are asserted against a record\nthe migration copied. It awaits initialize() before the first flip, since\nFormAutofillStorage registers the rust.enabled observer that its switchTo()\nhelper waits on at the end of that chain.\n\nEverything left under test/browser/rust/, and every entry in xpcshell_rust.toml,\nis a second run of a test that lives elsewhere, so both can be deleted whole\nonce the Rust store is the only one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325843\n", "files": ["browser/extensions/formautofill/moz.build", "browser/extensions/formautofill/test/browser/address/browser_address_doorhanger_non_mergeable_fields.js", "browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_address_migration.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/browser/rust/browser.toml", "browser/extensions/formautofill/test/browser/rust/browser_address_migration.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_housenumber.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_level.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_name.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_select.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_select_inexact.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_select_match_isoid.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_address_textarea.js", "browser/extensions/formautofill/test/browser/rust/browser_autofill_duplicate_fields.js", "browser/extensions/formautofill/test/browser/rust/browser_clearPopulatedForm.js", "browser/extensions/formautofill/test/browser/rust/browser_editAddressDialog.js", "browser/extensions/formautofill/test/browser/rust/browser_fillclear_events.js", "browser/extensions/formautofill/test/browser/rust/browser_manageAddressesDialog.js", "browser/extensions/formautofill/test/browser/rust/browser_previewFormFields.js", "browser/extensions/formautofill/test/browser/rust/head.js", "browser/extensions/formautofill/test/unit/head.js", "browser/extensions/formautofill/test/unit/xpcshell_rust.toml"], "git_node": "289247901327fe1bbfbdaf774000cd6615947d87", "git_parents": ["87bb348650d8d9c98722ddfcf465b073312bba87"], "node": "327610ba2afb86a1bfd9f6b4a17c09ed0919aaf5", "parents": ["91b81b420feb5becbf01cb963cfd4bb80e05b07d"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070319 - Define the default dirty page allowance in bytes. r=pbone\n\nDIRTY_MAX_DEFAULT is a page count, so on 16 KiB pages every arena holds four\ntimes as many bytes before it is purged and drains to four times the floor.\nDerive the page count from a byte allowance once the page size is known.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324392\n", "files": ["memory/build/Globals.cpp", "memory/build/Globals.h", "memory/build/mozjemalloc.cpp"], "git_node": "26a543fb62aba8f13ca7a611085953e83eb278ef", "git_parents": ["289247901327fe1bbfbdaf774000cd6615947d87"], "node": "acbb000ab6ce6641be9ac33e4cc2a7f700a1df74", "parents": ["327610ba2afb86a1bfd9f6b4a17c09ed0919aaf5"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071018 - Update cached Attr nodes' owner document when adopting an element. r=dom-core-reviewers,smaug\n\n`nsDOMAttributeMap::SetOwnerDocument` exists but nothing calls it, so Attr nodes\ncreated before an element is adopted keep their old node document.\n\nThis change drops the dead `SetOwnerDocument` method and implements adoption via\nElement's `NodeInfoChanged` and a new `AdoptCachedAttributes`. Implementing the\nmissing \"adopt\" step 3.3.1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325083\n", "files": ["dom/base/Attr.cpp", "dom/base/Attr.h", "dom/base/AttrArray.cpp", "dom/base/AttrArray.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsDOMAttributeMap.h", "dom/base/nsINode.cpp", "testing/web-platform/tests/dom/nodes/Document-adoptNode.html"], "git_node": "f0b116820ad82b6c544b8575b912ec0b97a5e44a", "git_parents": ["26a543fb62aba8f13ca7a611085953e83eb278ef"], "node": "1b89df777e6bda49ef3024420844b99382bf90b2", "parents": ["acbb000ab6ce6641be9ac33e4cc2a7f700a1df74"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069294 - Loop that launches Fx headless every 5 minutes if profile lock isn't taken.r=aborondo,hsohaney,mossop,supply-chain-reviewers,afranchuk\n\nAdd a loop that checks for Firefox running every 5 minutes and launches it headless if it isn't.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323573\n", "files": ["Cargo.lock", "toolkit/mozapps/pushnotificationhelper/Cargo.toml", "toolkit/mozapps/pushnotificationhelper/src/main.rs"], "git_node": "75abf4e7fb8ad0290d484fc7d0c794ed653f5f41", "git_parents": ["f0b116820ad82b6c544b8575b912ec0b97a5e44a"], "node": "d46f65971ff6606d619ac964ea42dc3f98cdc009", "parents": ["1b89df777e6bda49ef3024420844b99382bf90b2"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072783 - Use the same representation for style and graphics variation settings. r=layout-reviewers,jfkthame\" for causing build bustages in gfxMacFont.cpp\n\nThis reverts commit 87bb348650d8d9c98722ddfcf465b073312bba87.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "gfx/2d/FontFeature.h", "gfx/2d/moz.build", "gfx/fontations_glue/lib.rs", "gfx/src/nsFont.cpp", "gfx/src/nsFont.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2Utils.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontFeatures.h", "gfx/thebes/gfxFontVariations.h", "gfx/thebes/gfxHarfBuzzShaper.cpp", "gfx/thebes/gfxMacFont.cpp", "gfx/thebes/gfxUserFontSet.h", "layout/generic/MathMLTextRunFactory.cpp", "layout/inspector/InspectorFontFace.cpp", "layout/style/ServoBindings.toml", "layout/style/ServoStyleConstsForwards.h", "servo/components/style/properties/data.py", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/values/animated/font.rs", "servo/components/style/values/computed/font.rs", "servo/components/style/values/generics/font.rs", "servo/ports/geckolib/cbindgen.toml", "servo/ports/geckolib/glue.rs"], "git_node": "93205ced0e6c6a89f702f8769bdd2aae1bcf8559", "git_parents": ["75abf4e7fb8ad0290d484fc7d0c794ed653f5f41"], "node": "58f5747689717accbbe3fe849e6cce2afcdc49bb", "parents": ["d46f65971ff6606d619ac964ea42dc3f98cdc009"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2062317, be more synchronous with DOMContentLoaded, r=farre,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321732\n", "files": ["docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/test/file_domcontentloaded_document_open.html", "dom/base/test/file_domcontentloaded_terminated_parse.html", "dom/base/test/mochitest.toml", "dom/base/test/test_domcontentloaded_document_open.html", "dom/base/test/test_domcontentloaded_terminated_parse.html", "dom/base/test/unit/test_blockParsing.js", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/xml/XMLDocument.cpp", "dom/xml/XMLDocument.h", "dom/xml/nsXMLContentSink.cpp", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5TreeOpExecutor.cpp", "testing/web-platform/meta/html/browsers/the-window-object/named-access-on-the-window-object/navigated-named-objects.window.js.ini", "testing/web-platform/meta/html/syntax/parsing/DOMContentLoaded-defer-task-order.tentative.html.ini", "testing/web-platform/meta/html/syntax/parsing/DOMContentLoaded-defer.html.ini", "testing/web-platform/tests/html/syntax/parsing/DOMContentLoaded-defer-task-order.tentative.html", "testing/web-platform/tests/svg/linking/scripted/a.rel-noreferrer-policy.html", "testing/web-platform/tests/svg/linking/scripted/resources/a.rel-noreferrer-policy-frame.html", "testing/web-platform/tests/svg/linking/scripted/resources/a.rel-noreferrer-policy-target.html", "toolkit/components/extensions/test/xpcshell/test_ext_contentscript_order.js", "toolkit/content/tests/browser/browser_about_restricted.js", "widget/tests/test_dnd_ignoreNuls.html"], "git_node": "6027a6b51d27b0882fdd9eb68eeec9f2171a3683", "git_parents": ["93205ced0e6c6a89f702f8769bdd2aae1bcf8559"], "node": "804c6b6730e65a1fff654de5eb38aea90bf0db6d", "parents": ["58f5747689717accbbe3fe849e6cce2afcdc49bb"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2062317 - Fix tests that synthesize input before the window is positioned, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326320\n", "files": ["layout/base/tests/accessiblecaret_magnifier.html", "layout/base/tests/bug1448730.html"], "git_node": "c46134b6740fb9ea279a3598779d4e9acd35b8dc", "git_parents": ["6027a6b51d27b0882fdd9eb68eeec9f2171a3683"], "node": "9944515fa1ff25b31af077bc154eefce333a43bb", "parents": ["804c6b6730e65a1fff654de5eb38aea90bf0db6d"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2072433, don't leak elements with animated classes, r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326773\n", "files": ["dom/base/ContentList.cpp", "dom/base/ContentList.h", "dom/base/nsContentUtils.h"], "git_node": "caed6fbebca0a74a5510b885d4610eebcf4eec3b", "git_parents": ["c46134b6740fb9ea279a3598779d4e9acd35b8dc"], "node": "ee518e83b93a8760763e8b7691e69d8b90dfe5e3", "parents": ["9944515fa1ff25b31af077bc154eefce333a43bb"], "tags": []}, {"author": "f3tch \u003cf3tch.169@gmail.com\u003e", "branch": "default", "desc": "Bug 2068045 - Add webExtension.moz:listExtensions WebDriver BiDi command. r=jdescottes,webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322968\n", "files": ["remote/doc/webdriver-bidi/Extensions.md", "remote/shared/Addon.sys.mjs", "remote/shared/test/browser/browser_Addon.js", "remote/webdriver-bidi/modules/root/webExtension.sys.mjs", "testing/web-platform/mozilla/meta/webdriver/bidi/web_extension/moz/list_extensions/list_extensions.py.ini", "testing/web-platform/mozilla/tests/webdriver/bidi/web_extension/moz/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/web_extension/moz/list_extensions/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/web_extension/moz/list_extensions/list_extensions.py", "testing/web-platform/mozilla/tests/webdriver/support/addons.py"], "git_node": "359efe142a63becb8e78a3eab163b8c9aa35e10d", "git_parents": ["caed6fbebca0a74a5510b885d4610eebcf4eec3b"], "node": "9499bb31636dbb93450bd025446d1b1d3da44d82", "parents": ["ee518e83b93a8760763e8b7691e69d8b90dfe5e3"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2067652 - Include ERROR/CRITICAL log records in TestSummaryFormatter output r=jgraham\n\nFailures that are not tied to a test (LeakSanitizer/TSan reports, shutdown\nleakcheck, assertion-count mismatches, harness errors) are reported as `log`\nrecords of level ERROR/CRITICAL. ErrorSummaryFormatter keeps them, but\nTestSummaryFormatter dropped every `log` action, so a job failing only on\nsuch an error ended up with a summary.jsonl that contained no failure at all\n(e.g. LSan leaks after netwerk/test/browser/browser.toml on linux asan bc).\nMirror errorsummary and pass those two levels through, stripped like every\nother record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322250\n", "files": ["testing/mozbase/mozdevice/mozdevice/remote_process_monitor.py", "testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "6b593c7666c270cc51293e7147dcdf737ba6e61e", "git_parents": ["359efe142a63becb8e78a3eab163b8c9aa35e10d"], "node": "2caa4d8742aa811447340c0ed00951308d2356e2", "parents": ["9499bb31636dbb93450bd025446d1b1d3da44d82"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2067652 - Keep failing mozleak_total records in TestSummaryFormatter output r=jgraham\n\nmozleak reports the refcount leak total of each process log through the\nmozleak_total action, not as a log line: only the TBPL formatter turns it\ninto the \"TEST-UNEXPECTED-FAIL | leakcheck | \u003cprocess\u003e N bytes leaked (...)\"\nline Treeherder's log parser picks up. The ERROR/CRITICAL pass-through added\nbefore this therefore still leaves a job failing only on such a leak with a\nsummary.jsonl that holds no failure (e.g. the standalone browser-chrome task\nQfyeKj9uTiy2MXxYmHEkzg on try, whose default process leaked 856 bytes twice).\n\nKeep the mozleak_total records the TBPL formatter would print as a failure:\na total past its threshold, or a process log with no total line unless the\nprocess crashed on purpose or the harness asked to ignore it. The record\nstays structured (process, bytes, threshold, objects, scope); consumers build\nthe line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326867\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "5fa015ff573002ebdd50f3c7871d766137f7b20e", "git_parents": ["6b593c7666c270cc51293e7147dcdf737ba6e61e"], "node": "439e02a62b6555e310a5969b7763c1e36b0776f8", "parents": ["2caa4d8742aa811447340c0ed00951308d2356e2"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2070410 - Disable pdf.js selection rendering in Thunderbird. r=pdfjs-reviewers,robwu DONTBUILD\n\nThis is a mitigation, not the fix. The underlying WebRender defect is bug\n2070962: a backdrop-filter in the root pipeline is silently dropped when an\niframe precedes it in the display list, which is what the pdf.js page canvas\ndoes. Remove this override once that is fixed.\n\nNote that the override has to live here rather than in Thunderbird's own\nall-thunderbird.js: both files ship through JS_PREFERENCE_PP_FILES into\ndefaults/pref/, which is loaded in descending filename order, so\nPdfJsDefaultPrefs.js is read last and clobbers anything all-thunderbird.js\nsets. PdfJsOverridePrefs.js is #included at the end of PdfJsDefaultPrefs.js,\nwhich is why it wins.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326889\n", "files": ["toolkit/components/pdfjs/PdfJsOverridePrefs.js"], "git_node": "23d26565c72bd38548ac75bed7949b6a151f424f", "git_parents": ["5fa015ff573002ebdd50f3c7871d766137f7b20e"], "node": "1697b11f619429f6265bd26edc138a33d81b27e8", "parents": ["439e02a62b6555e310a5969b7763c1e36b0776f8"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069837 - [customizable-menu] Show the forward menu item in browser screen's menu r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326450\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ForwardMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/ForwardMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt"], "git_node": "bcd8165f766494ad093d508b01748531fe5890b9", "git_parents": ["23d26565c72bd38548ac75bed7949b6a151f424f"], "node": "13c5440b9e816e06c329a35c7401d912003bfde3", "parents": ["1697b11f619429f6265bd26edc138a33d81b27e8"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071386 - Autocorrect should not be available for Android SignatureDialog r=android-reviewers,pollymce\n\nUI review specified that autocorrect should not be available for the signature field.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325867\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/ui/SignatureDialog.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/ui/SignatureDialogTest.kt"], "git_node": "5f83f3908b06a27c6a1532ea9e62aa15ddd96b59", "git_parents": ["bcd8165f766494ad093d508b01748531fe5890b9"], "node": "a046da5e1022911761f3563dff4520d7f2b4430a", "parents": ["13c5440b9e816e06c329a35c7401d912003bfde3"], "tags": []}, {"author": "Thomas Nibler \u003cdev@tnibler.de\u003e", "branch": "default", "desc": "Bug 2072008 - Reset SPSC producer thread on AudioSink reuse r=media-playback-reviewers,padenot\n\nThe thread id may have changed between PrepareForReuse and\nResetForReuse, specifically when AudioSinkWrapper stashes and recycles\nits AudioSink.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325987\n", "files": ["dom/media/mediasink/AudioSink.cpp"], "git_node": "794b0307aaaac4c656ff41db06b687b8693d4959", "git_parents": ["5f83f3908b06a27c6a1532ea9e62aa15ddd96b59"], "node": "bd4d346997aba31e7522bd8e106a038867e45a11", "parents": ["a046da5e1022911761f3563dff4520d7f2b4430a"], "tags": []}, {"author": "Thomas Nibler \u003cdev@tnibler.de\u003e", "branch": "default", "desc": "Bug 2072750 - Avoid gaps in linear gradients at large coordinates r=gfx-reviewers,nical\n\nCompute the segment end edge directly from the prim origin instead of\nstart + length, ensuring that start and end edges are shared between\nadjacent rectangles even after rounding.\nAlso compute length without adding the same offset to both terms, which\nrisks catastrophic cancellation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326750\n", "files": ["gfx/wr/webrender/src/prim_store/gradient/linear.rs"], "git_node": "aa711c7b3ec3ed03e42c284eecaa82a2efadd8ec", "git_parents": ["794b0307aaaac4c656ff41db06b687b8693d4959"], "node": "cda0d09659c2b77eb404fb61b33e465c30798650", "parents": ["bd4d346997aba31e7522bd8e106a038867e45a11"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072750 - Add a wrench reftest for gradient seams at large offsets r=gfx-reviewers,jnicol\n\nA 100-stop gradient placed at x = 1116000 inside a reference frame that\ntranslates it back into view, compared against the same gradient at the\norigin. Before the segment rects were derived from the prim origin, the\nsegments rounded apart in device space and the background showed through\nas thin vertical seams.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326870\n", "files": ["gfx/wr/wrench/reftests/gradient/linear-large-offset-seam-ref.yaml", "gfx/wr/wrench/reftests/gradient/linear-large-offset-seam.yaml", "gfx/wr/wrench/reftests/gradient/reftest.list"], "git_node": "1d99e89beb54c30e2e4d1e70f36ea06ab660ed87", "git_parents": ["aa711c7b3ec3ed03e42c284eecaa82a2efadd8ec"], "node": "f3a40dc4a24fa11b2c591775187cc21d2f297f02", "parents": ["cda0d09659c2b77eb404fb61b33e465c30798650"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2058800 - Validate mlGuess IPC payloads r=tjr\n\nThe all-frame Pdfjs actor previously forwarded `_mlGuess` requests unchanged to the ML image-to-text pipeline, where a `url` property selects `RawImage.fromURL()` instead of the viewer pixel buffer.\n\nAccept only `{data, width, height, channels}` with byte data, positive integer dimensions, one to four channels, and a matching data length. Malformed payloads return null.\n\nTests cover the validator and direct actor queries from a non-PDF page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317738\n", "files": ["toolkit/components/pdfjs/content/PdfJsParent.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_mlguess_validation.js", "toolkit/components/pdfjs/test/unit/test_ml_guess_request.js", "toolkit/components/pdfjs/test/unit/xpcshell.toml"], "git_node": "951468630aac37f2b5f46f38289cb505f5fae8f5", "git_parents": ["1d99e89beb54c30e2e4d1e70f36ea06ab660ed87"], "node": "73dd6fc9ce7760e51fa39d9bde609c778e6b2b24", "parents": ["f3a40dc4a24fa11b2c591775187cc21d2f297f02"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2072388 - Use run-if for multi-condition manifest-wide scope conditions. r=ci-and-tooling,accessibility-platform-reviewers,dom-core-reviewers,necko-reviewers,credential-management-reviewers,device-api-reviewers,gstoll,smaug,Jamie,aryx,dimi\n\nSame reclassification as the previous patch, for the manifests whose skip-if\nlisted more than one condition. Entries in a run-if list are OR'd, just as in\nskip-if, so each inverted list becomes a single && expression rather than\nseveral entries.\n\nThe search config manifest's whole list moves to run-if, since every condition\nin it describes a configuration these tests are not meant for. One opt condition\ncovers the build types, opt being defined in mozbuild/mozinfo.py as none of\ndebug, asan, tsan or ccov. That also stops running them on Linux ccov, which the\nprevious expression allowed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326539\n", "files": ["accessible/tests/browser/atk/browser.toml", "accessible/tests/browser/windows/uia/browser.toml", "browser/extensions/formautofill/test/mochitest/creditCard/mochitest.toml", "dom/origin-trials/tests/mochitest/mochitest.toml", "dom/security/test/https-first/mochitest.toml", "dom/webserial/tests/mochitest/mochitest.toml", "dom/websocket/tests/mochitest.toml", "dom/websocket/tests/websocket_hybi/mochitest.toml", "security/manager/ssl/tests/mochitest/mixedcontent/mochitest.toml", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml", "toolkit/components/nimbus/test/unit/xpcshell.toml", "toolkit/components/search/tests/xpcshell/searchconfigs/xpcshell.toml", "toolkit/components/url-classifier/tests/mochitest/mochitest.toml"], "git_node": "c9bc4df527eda91bbb3015bf828bfd41f529967e", "git_parents": ["951468630aac37f2b5f46f38289cb505f5fae8f5"], "node": "5a15fc89c4db0fbdd1f1879488c3baa78dba3e6a", "parents": ["73dd6fc9ce7760e51fa39d9bde609c778e6b2b24"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069288 - Make tests using XSLT flip the pref on. r=dom-core-reviewers,layout-reviewers,dom-worker-reviewers,emilio,smaug,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323551\n", "files": ["browser/components/resistfingerprinting/test/browser/browser-xslt.toml", "browser/components/resistfingerprinting/test/browser/browser.toml", "docshell/test/chrome/chrome-xslt.toml", "docshell/test/chrome/chrome.toml", "dom/base/test/mochitest-bug1.toml", "dom/base/test/mochitest-bug2.toml", "dom/base/test/mochitest-xslt.toml", "dom/events/test/mochitest-xslt.toml", "dom/events/test/mochitest.toml", "dom/html/test/mochitest-bug1.toml", "dom/html/test/mochitest-xslt.toml", "dom/security/permissionspolicy/test/mochitest/mochitest-xslt.toml", "dom/security/permissionspolicy/test/mochitest/mochitest.toml", "dom/security/test/csp/mochitest-xslt.toml", "dom/security/test/csp/mochitest.toml", "dom/serviceworkers/test/mochitest-common.toml", "dom/tests/mochitest/bugs/mochitest-xslt.toml", "dom/tests/mochitest/bugs/mochitest.toml", "dom/tests/mochitest/general/mochitest-xslt.toml", "dom/tests/mochitest/general/mochitest.toml", "dom/tests/reftest/reftest.list", "dom/tests/reftest/xml-stylesheet/reftest.list", "dom/xml/test/mochitest-xslt.toml", "dom/xml/test/mochitest.toml", "dom/xslt/crashtests/crashtests.list", "dom/xslt/tests/browser/browser.toml", "dom/xslt/tests/mochitest/mochitest.toml", "layout/reftests/bugs/reftest.list", "testing/web-platform/meta/content-security-policy/xslt/__dir__.ini", "testing/web-platform/meta/dom/idlharness.window.js.ini", "testing/web-platform/meta/service-workers/service-worker/xsl-base-url.https.html.ini", "testing/web-platform/meta/xml/xslt/__dir__.ini"], "git_node": "164755da5c049b9a457bd0af9e8dd7383e972a60", "git_parents": ["c9bc4df527eda91bbb3015bf828bfd41f529967e"], "node": "e0d4a475d8374fececd4c888ff66037cb0398a13", "parents": ["5a15fc89c4db0fbdd1f1879488c3baa78dba3e6a"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072940 - Relax current process assertion in CompositeProcessFencesHolderId::GetNext() r=gfx-reviewers,nical\n\nTo allow execution in the parent process as well. This is required\nwhen running WebGL on Metal ANGLE when the GPU process is disabled by\ndefault (and WebGL therefore runs in the parent process).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326848\n", "files": ["gfx/layers/LayersTypes.cpp"], "git_node": "64e854d7e19206934e867173c09a408363f810c0", "git_parents": ["164755da5c049b9a457bd0af9e8dd7383e972a60"], "node": "8906b7e10e6b791843a3570a622b5b15acdfc50a", "parents": ["e0d4a475d8374fececd4c888ff66037cb0398a13"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067465. r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326584\n", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": "6d5482eb7d4a4b785ecd0e4607d644237dcf197e", "git_parents": ["64e854d7e19206934e867173c09a408363f810c0"], "node": "e5ee27be499402bd70e5fb299d81164e843cd259", "parents": ["8906b7e10e6b791843a3570a622b5b15acdfc50a"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071018 - Update cached Attr nodes' owner document when adopting an element. r=dom-core-reviewers,smaug\" for causing build bustages in nsDOMAttributeMap.h.\n\nThis reverts commit f0b116820ad82b6c544b8575b912ec0b97a5e44a.\n", "files": ["dom/base/Attr.cpp", "dom/base/Attr.h", "dom/base/AttrArray.cpp", "dom/base/AttrArray.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsDOMAttributeMap.h", "dom/base/nsINode.cpp", "testing/web-platform/tests/dom/nodes/Document-adoptNode.html"], "git_node": "5e65b268b49f35ff4030f2994d0e38678f5d2de9", "git_parents": ["6d5482eb7d4a4b785ecd0e4607d644237dcf197e"], "node": "234a6d474a99e8a225ee518d4463efca9feba8ba", "parents": ["e5ee27be499402bd70e5fb299d81164e843cd259"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1995348 - Implement the \"grid-lanes\" value for the \"display\" property r=layout-reviewers,firefox-style-system-reviewers,dholbert,emilio\" for causing wpt failures.\n\nThis reverts commit b950c0cea5ca8d61d210c917a4f873da099b7bb6.\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsGridContainerFrame.cpp", "layout/inspector/tests/test_bug877690.html", "layout/style/test/property_database.js", "layout/style/test/test_position_float_display.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/values/specified/box.rs", "testing/web-platform/meta/css/css-anchor-position/__dir__.ini", "testing/web-platform/meta/css/css-anchor-position/grid-lanes-position-area-basic.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/__dir__.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-001.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column