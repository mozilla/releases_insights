riggers/ignore-symbol-other-get.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/ignore-symbol-other-getOwnProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/ignore-symbol-other-hasProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/ignore-symbol-toStringTag-defineOwnProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/ignore-symbol-toStringTag-delete.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/ignore-symbol-toStringTag-get.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/ignore-symbol-toStringTag-getOwnProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/ignore-symbol-toStringTag-hasProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-exported-string-defineOwnProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-exported-string-delete.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-exported-string-get.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-exported-string-getOwnProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-exported-string-hasProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-not-exported-string-defineOwnProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-not-exported-string-delete.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-not-exported-string-get.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-not-exported-string-getOwnProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-not-exported-string-hasProperty.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-ownPropertyKey-names.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-ownPropertyKeys-symbols.js", "js/src/tests/test262/language/import/import-defer/evaluation-triggers/trigger-ownPropertyKeys.js", "js/src/tests/test262/language/import/import-defer/syntax/import-attributes.js", "js/src/tests/test262/language/import/import-defer/syntax/invalid-default-and-defer-namespace.js", "js/src/tests/test262/language/import/import-defer/syntax/invalid-defer-as-with-no-asterisk.js", "js/src/tests/test262/language/import/import-defer/syntax/invalid-defer-default-and-namespace.js", "js/src/tests/test262/language/import/import-defer/syntax/invalid-defer-default.js", "js/src/tests/test262/language/import/import-defer/syntax/invalid-defer-named.js", "js/src/tests/test262/language/import/import-defer/syntax/invalid-export-defer-namespace.js", "js/src/tests/test262/language/import/import-defer/syntax/valid-default-binding-named-defer.js", "js/src/tests/test262/language/import/import-defer/syntax/valid-defer-namespace.js"], "git_node": "7961d2cc61132c878f0ad762cb18db91f8d8e391", "git_parents": ["e34a7ccde03b80ec8dfdf56052157cd0b3af3ff9"], "node": "d7c7e9d308a6340a89794e5c8da7854081fa9049", "parents": ["243228d1bc2e522feec7a25d49650e2f48873b7a"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 9: Update WPT ini for import defer eval. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309112\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/basic-deferred-evaluation.tentative.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/cyclic-tla-defer-eval.tentative.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/tla-deferred-evaluation.tentative.html.ini"], "git_node": "cbb97ca56d7d83dcd72774c77ab8ac410cb726fa", "git_parents": ["7961d2cc61132c878f0ad762cb18db91f8d8e391"], "node": "c89e04e727f71f4b24ef6f1d3786c31cd5338f1f", "parents": ["d7c7e9d308a6340a89794e5c8da7854081fa9049"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1952263 - Part 10: Update Reflect.parse for import defer. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310047\n", "files": ["js/src/jit-test/tests/modules/import-defer-syntax.js", "js/src/jit-test/tests/modules/import.defer-syntax.js"], "git_node": "5bafd78fe836f19fd83aea32a849e3c241391dc6", "git_parents": ["cbb97ca56d7d83dcd72774c77ab8ac410cb726fa"], "node": "1ac7d0fb315e0974abfa5ac091001e312276ca51", "parents": ["c89e04e727f71f4b24ef6f1d3786c31cd5338f1f"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1952263: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/public/CompileOptions.h", "js/src/frontend/ReservedWords.h"], "git_node": "8f9f8450d84d16c611821f1aadc6ecab9fc3d33e", "git_parents": ["5bafd78fe836f19fd83aea32a849e3c241391dc6"], "node": "de71c2d1d0419a9cedadc84291353b077acb32db", "parents": ["1ac7d0fb315e0974abfa5ac091001e312276ca51"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073140 - Lint all netwerk/ headers through clang-tidy r=cookie-reviewers,necko-reviewers,valentin\n\nChanges includes:\n- making deleted methods public\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326980\n", "files": ["netwerk/base/SimpleURIUnknownSchemes.cpp", "netwerk/base/nsIURIWithSizeOf.h", "netwerk/cache2/CacheFile.cpp", "netwerk/cache2/CacheFileContextEvictor.cpp", "netwerk/cookie/CookiePrivateStorage.h", "netwerk/cookie/CookieStorage.h", "netwerk/protocol/http/nsHttpHeaderArray.h", "netwerk/protocol/websocket/WebSocketConnectionListener.h", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/system/android/nsAndroidNetworkLinkService.cpp", "netwerk/system/win32/nsNotifyAddrListener.cpp"], "git_node": "16dc9fbf3a3a83f7602a3b5f90c70f8c9eec8553", "git_parents": ["8f9f8450d84d16c611821f1aadc6ecab9fc3d33e"], "node": "2756236a5cd18a6c1f97e6cd4d439d406c12ff7a", "parents": ["de71c2d1d0419a9cedadc84291353b077acb32db"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069874 - Combine strategies against stack walking deadlocks. r=win-reviewers,handyman\n\nRestore stack walk suppressions as the primary defense against stack walking\ndeadlocks (strategy (2)). Keep checking ntdll SRW locks (strategy (1)) as\ndefense-in-depth. This restores stackless samples during suppression windows\nas the cost of suppressing more deadlocks. In particular, no stack can be\ncollected while any thread is (un)loading a DLL.\n\nNote that neither mechanism proves that unwinding is deadlock-free, this is\nstill best-effort.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325342\n", "files": ["mozglue/misc/StackWalk.cpp", "mozglue/misc/StackWalk_windows.h", "toolkit/xre/dllservices/mozglue/WindowsStackWalkInitialization.cpp"], "git_node": "ab69ba092537ca9d56ca0799812515093fc6b403", "git_parents": ["16dc9fbf3a3a83f7602a3b5f90c70f8c9eec8553"], "node": "e0f5bb0704f5d092558296609d54f82b93f2bc60", "parents": ["2756236a5cd18a6c1f97e6cd4d439d406c12ff7a"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069874 - Test conjunctive stack-walk safety checks. r=win-reviewers,handyman\n\nTest that strategy (2) kicks in even when strategy (1) says we are safe to\nproceed with stack walking and vice versa. This protects us against the\ndeadlock scenarios that only one of the two strategies stops, like the one\ndiscussed in the bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325343\n", "files": ["toolkit/xre/dllservices/tests/TestStackWalkInitialization.cpp"], "git_node": "7cbd68ceafb7b67f3bd677ccbe33760787de0c9b", "git_parents": ["ab69ba092537ca9d56ca0799812515093fc6b403"], "node": "99fbced44fb648847cd9501f1fd87c68df021724", "parents": ["e0f5bb0704f5d092558296609d54f82b93f2bc60"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069874 - Add missing stack walk suppression path (RtlAddFunctionTable). r=win-reviewers,handyman\n\nRtlAddFunctionTable takes risky locks, so we must suppress stack walking\nwhile we call it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325340\n", "files": ["toolkit/xre/dllservices/mozglue/interceptor/MMPolicies.h"], "git_node": "46b6aaab2bf854d2a42732ae0f8c93da2847f3ba", "git_parents": ["7cbd68ceafb7b67f3bd677ccbe33760787de0c9b"], "node": "622b3b8a830e52022ca3468fd2ec05b45d42c29b", "parents": ["99fbced44fb648847cd9501f1fd87c68df021724"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069874 - Install stack-walk suppression hooks before sandbox lockdown. r=win-reviewers,sandbox-reviewers,handyman\n\nThe delayed mitigations of the socket, utility, GPU and RDD sandboxes\ninclude MITIGATION_DYNAMIC_CODE_DISABLE. Once arbitrary code guard is\nenabled the interceptor cannot apply hooks, so stack walking hooks\ncannot be installed on demand as the profiler or background hang\nreporter starts in these processes.\n\nSplit the hook installation out of WindowsStackWalkInitialization() into\nInstallStackWalkSuppressionHooks() and call it from StartSandbox()\nbefore LowerToken(). This is the single choke point for token lowering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325341\n", "files": ["security/sandbox/win/src/sandboxtarget/sandboxTarget.cpp", "toolkit/xre/dllservices/mozglue/WindowsStackWalkInitialization.cpp", "toolkit/xre/dllservices/mozglue/WindowsStackWalkInitialization.h"], "git_node": "6010b465a937a65bb24531db4a0f3b0eff193cb4", "git_parents": ["46b6aaab2bf854d2a42732ae0f8c93da2847f3ba"], "node": "034d32f2c533eca300bc439eec6a8be4f9134c9e", "parents": ["622b3b8a830e52022ca3468fd2ec05b45d42c29b"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068982 - P1. Add a shared autofill storage migrator and port addresses to it r=joschmidt,credential-management-reviewers\n\nCredit cards need the copy addresses already have, and it does not depend on\nthe collection: the same seven methods, differing only in the prefs that budget\nthe run, the Glean category it reports to, and how two records are compared.\n\nSo AddressStorageMigrator becomes AutofillStorageMigrator, and a subclass at the\nfoot of the file supplies the rest as members -- the way RustAutofillAdapterBase\nand the JSON store's AutofillRecords both parameterise. Addresses behave as\nbefore, except that a few log messages no longer name the collection: the logger\nprefix already does.\n\n_report moves to the shared class, so the address migration test stubs it there.\nAssigning to the subclass prototype would shadow the real method and restoring\nwould leave undefined in its place. It keeps its underscore because that test\nreaches it from another module, which is not true of the new members.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324550\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_address_migration.js", "toolkit/components/formautofill/AddressStorageMigrator.sys.mjs", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs"], "git_node": "696270020e3e429a31dd28d9b84cf4e315824fbd", "git_parents": ["6010b465a937a65bb24531db4a0f3b0eff193cb4"], "node": "f50900a721e96ebf342d73d7b3d601f141741456", "parents": ["034d32f2c533eca300bc439eec6a8be4f9134c9e"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068982 - P2. Support migrating credit cards to the Rust store and serving them from it r=joschmidt,credential-management-reviewers\n\nServes credit cards from the Rust store once a profile has copied them across,\nbehind extensions.formautofill.creditCards.storage.rust.enabled, with the shape\naddresses use: a dry run that measures and discards, a real run budgeted to\nthree attempts, and a copy back when the pref is turned off.\n\nThe copy is P1's AutofillStorageMigrator; this adds the credit card subclass.\nTwo parts of it are new rather than a rename of the address version:\n\n  - fieldDiffers goes through creditCardFieldDiffers. cc-number is a mask, and\n    the two stores build it at different widths, so only the last four digits\n    compare; cc-number-encrypted compares by presence, encryption not being\n    deterministic.\n  - #migrate asks the source to export each record first, so the number crosses\n    in the clear and the target encrypts it under its own scheme rather than\n    inheriting ciphertext it cannot read. A record that will not export is\n    counted failed rather than copied without its number, and the exported\n    records are dropped once the write is done rather than held for the rest\n    of the copy. This runs for addresses too, where the source has no\n    _recordForMigrationExport and the record comes back unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324551\n", "files": ["modules/libpref/init/all.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "162d8c1d7d1e3ec6ade76a4f687ed069c4b86b71", "git_parents": ["696270020e3e429a31dd28d9b84cf4e315824fbd"], "node": "67d44b471113e56410f764004d013225a8ea743c", "parents": ["f50900a721e96ebf342d73d7b3d601f141741456"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068982 - P3. Test the credit card migration r=joschmidt,credential-management-reviewers\n\nCovers the copy in both directions, and what is specific to cards: the number\narrives re-encrypted by the target rather than as the bytes it was handed.\n\nThe two failure tests are the point. A decrypt that starts working and then\nstops, as a keychain locking mid-run would, must leave the profile where it is\nand the source records byte-identical, so a later launch can still copy them. A\nkey store that will not open at all must defer without spending the retry\nbudget. Both failures are transient on purpose: a permanently lost key is lost\nwhichever way the copy is written, so only a recoverable one tells refusing a\nrecord apart from copying it without its number.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324552\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "browser/extensions/formautofill/test/unit/xpcshell.toml"], "git_node": "059c0a1dfc84f4a922f6c68fdc4ef618b0154972", "git_parents": ["162d8c1d7d1e3ec6ade76a4f687ed069c4b86b71"], "node": "00c4a3da16ca9f3afa887e05007d3bc669d7c6f6", "parents": ["67d44b471113e56410f764004d013225a8ea743c"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071852 - Convert openHistoryItemTest regression UI test to efficiency framework r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325850\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/HistoryTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Relations.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HistoryTest.kt"], "git_node": "611cf6a5efae39d72352872ebddee109b5740ffd", "git_parents": ["059c0a1dfc84f4a922f6c68fdc4ef618b0154972"], "node": "2d82af2703d952cc5df31fbecdd09c2a19a484ca", "parents": ["00c4a3da16ca9f3afa887e05007d3bc669d7c6f6"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2073004 - Create new verifyTheSiteIsDeceptiveReasonTest and verifyTheSomethingElseReasonTest regression UI tests r=aaronmt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326949\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/WebCompatReporterSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "79e12b4a3312c518d8747021c556c49729c1a042", "git_parents": ["611cf6a5efae39d72352872ebddee109b5740ffd"], "node": "f702c3f1f89756e8a5245f8651d5719c54f0db0a", "parents": ["2d82af2703d952cc5df31fbecdd09c2a19a484ca"], "tags": []}, {"author": "Josh Aas \u003cjaas@kflag.net\u003e", "branch": "default", "desc": "Bug 2071959 - Fix incorrect semicolon mapping. r=mac-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325935\n", "files": ["widget/cocoa/nsCocoaUtils.mm"], "git_node": "9b01aba025bf28c6d3c484dcf78d19d7db601a64", "git_parents": ["79e12b4a3312c518d8747021c556c49729c1a042"], "node": "5c3ef8f65b8809bddb25473953eb3c3af61ecec0", "parents": ["f702c3f1f89756e8a5245f8651d5719c54f0db0a"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071018 - Update cached Attr nodes' owner document when adopting an element. r=dom-core-reviewers,smaug\n\n`nsDOMAttributeMap::SetOwnerDocument` exists but nothing calls it, so Attr nodes\ncreated before an element is adopted keep their old node document.\n\nThis change drops the dead `SetOwnerDocument` method and implements adoption via\nElement's `NodeInfoChanged` and a new `AdoptCachedAttributes`. Implementing the\nmissing \"adopt\" step 3.3.1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325083\n", "files": ["dom/base/Attr.cpp", "dom/base/Attr.h", "dom/base/AttrArray.cpp", "dom/base/AttrArray.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsDOMAttributeMap.h", "dom/base/nsINode.cpp", "testing/web-platform/meta/dom/nodes/Node-mutation-adoptNode.html.ini", "testing/web-platform/tests/dom/nodes/Document-adoptNode.html"], "git_node": "88d9fd823a52d4fa9cb34bd9aa276a473fc8ddd3", "git_parents": ["9b01aba025bf28c6d3c484dcf78d19d7db601a64"], "node": "3801a1b9bb249e941f5d2fffc687dfc7e274f1f7", "parents": ["5c3ef8f65b8809bddb25473953eb3c3af61ecec0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071286 - Fail the docs build on a mermaid block that opens with a wrapped directive option. r=firefox-source-docs-reviewers,sylvestre\n\nThe check reads the indentation MyST keeps on the wrapped continuation, so a continuation written flush with the diagram still passes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325879\n", "files": ["docs/_addons/mermaid_wrapped_option.py", "docs/conf.py", "tools/moztreedocs/docs/mermaid-integration.md"], "git_node": "5a6cae2f3d8d68ddd79f154fdd66d388fa972afe", "git_parents": ["88d9fd823a52d4fa9cb34bd9aa276a473fc8ddd3"], "node": "f8bbccb471e6188848438071e10379a9ad95c4b4", "parents": ["3801a1b9bb249e941f5d2fffc687dfc7e274f1f7"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072616 - [webdriver-bidi] Add support for the \"destinationFolder\" argument to the \"browsingContext.startScreencast\" command. r=jdescottes,webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326854\n", "files": ["remote/webdriver-bidi/modules/root/browsingContext.sys.mjs"], "git_node": "3a6e41221f9cc961fb893f39b7fef368f5bb16cb", "git_parents": ["5a6cae2f3d8d68ddd79f154fdd66d388fa972afe"], "node": "b7f411d03e1617d8507a863c3ddff06ab7bcb615", "parents": ["f8bbccb471e6188848438071e10379a9ad95c4b4"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072616 - [wpt] Add support for the \"destinationFolder\" argument to the \"browsingContext.startScreencast\" command in the webdriver-bidi client. r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326855\n", "files": ["testing/web-platform/tests/tools/webdriver/webdriver/bidi/modules/browsing_context.py"], "git_node": "82ceca993e15ac7ebebd6838a5ccce0834a262b2", "git_parents": ["3a6e41221f9cc961fb893f39b7fef368f5bb16cb"], "node": "060ec6b0ebad66c09fb5e3e880efc8eb257a0163", "parents": ["b7f411d03e1617d8507a863c3ddff06ab7bcb615"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072616 - [wdspec] Add tests for the \"destinationFolder\" argument in the \"browsingContext.startScreencast\" command. r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326856\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/start_screencast/destination_folder.py.ini", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/start_screencast/destination_folder.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/start_screencast/invalid.py"], "git_node": "0aed3ffbbaa920a411912f1767d76f31f25198e4", "g