Registry.sys.mjs", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsSelectionModes.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "browser/components/screenshots/moz.build", "browser/components/screenshots/overlay/overlay.css", "browser/components/screenshots/overlayHelpers.mjs", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/toolbarbutton-icons.css"], "git_node": "a038c51ebc999639ed9214ddfbaddfc5dc9bb8b3", "git_parents": ["88494b27ad8279f1a356e73ada5394b3790582aa"], "node": "1e22014134ba727db389ab0dac7ac747b204509e", "parents": ["20d725274ea8524a13e0ae408ebad251560d5ec2"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Add a Use Mini Window item to the content context menu. r=mconley,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323857\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/webext-panels.xhtml", "browser/locales-preview/miniWindow.ftl"], "git_node": "be6eb15fad067cb8cb1d2038d34bdc98bf3f6ed4", "git_parents": ["a038c51ebc999639ed9214ddfbaddfc5dc9bb8b3"], "node": "9e73a2cb05f0f1f52a913c0ea1ae37d473836aae", "parents": ["1e22014134ba727db389ab0dac7ac747b204509e"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066607 - Test the mini window screenshots entry points. r=mconley,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322139\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_region_entry.js", "browser/components/miniwindow/test/browser/browser_toolbar_button.js", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/screenshots/tests/browser/browser_mini_window_mode.js"], "git_node": "52d950c565138fb2733fe40f76184c29dfd4f88f", "git_parents": ["be6eb15fad067cb8cb1d2038d34bdc98bf3f6ed4"], "node": "b81e027339f92b6e900472467fa4316da5737e92", "parents": ["9e73a2cb05f0f1f52a913c0ea1ae37d473836aae"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Separate cropped and full tab mini windows. r=mconley,fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,dao,sfoster,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323858\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_open_close.js", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/toolbarbuttons.css"], "git_node": "631261a3917a9081ef29b7e041bcdf81b28d6f25", "git_parents": ["52d950c565138fb2733fe40f76184c29dfd4f88f"], "node": "8db47d8f2f8c4681dc37318086f91ec6bbe89e79", "parents": ["b81e027339f92b6e900472467fa4316da5737e92"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Return a cropped mini window's tab home when it navigates away. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323859\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "d489e8325602d1ee0ee84a2e0d0f234ac3729f89", "git_parents": ["631261a3917a9081ef29b7e041bcdf81b28d6f25"], "node": "b1a798313cc1a9e55dbc29aae968ffaa2491c133", "parents": ["8db47d8f2f8c4681dc37318086f91ec6bbe89e79"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Test the mini window flavors. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323860\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_cropped_navigation.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/head.js"], "git_node": "c3f78b5de240222eb9f422b677260c39ff9dbab6", "git_parents": ["d489e8325602d1ee0ee84a2e0d0f234ac3729f89"], "node": "df5e11243dd9735a26db7d33cb364c75788e8d2e", "parents": ["b1a798313cc1a9e55dbc29aae968ffaa2491c133"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Restyle the mini window toolbar and suppress its sidebar. r=mconley,sidebar-reviewers,sfoster\n\nTwo bits of chrome polish that were still following the ordinary browsing\nwindow:\n\nThe reused nav-bar took its colour from the theme, which made a mini window\nread as a shrunken browsing window rather than its own surface. Pin it to\nwhite in light mode and #252428 in dark, active and inactive alike. Left alone\nunder forced colours: HCM users choose their own background, so the system\ncolours the toolbox tokens already carry are the right answer there.\n\nThe sidebar still initialised, because SidebarController.inSingleTabWindow only\nknew about Taskbar Tabs and mini windows deliberately keep toolbar.visible\ntrue. A mini window holds one tab and hides the app menu, so the sidebar and\nits launcher have nothing to offer there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325080\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_sidebar.js", "browser/components/sidebar/browser-sidebar.js", "browser/themes/shared/browser-shared.css"], "git_node": "f5caf011b1518e59421e5ebfc42352977e816c7d", "git_parents": ["c3f78b5de240222eb9f422b677260c39ff9dbab6"], "node": "ff55ed56ffd2e66a69be0c991ed17f9e1d4929c0", "parents": ["df5e11243dd9735a26db7d33cb364c75788e8d2e"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Add a mute button to the mini window nav-bar. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson\n\nA mini window can be playing audio with no way to silence it: the tab strip's\naudio button isn't there, and the app menu is hidden. Add a button beside the\nput-tab-back control that mirrors the tab's sound state and toggles mute,\nusing the same icons the tab strip does.\n\nIt only appears while there is sound to mute, or while the tab is already\nmuted and needs a way back, so an ordinary mini window is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325081\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "953ec150388846e8d84b3cd567cab06953f4e1a9", "git_parents": ["f5caf011b1518e59421e5ebfc42352977e816c7d"], "node": "6c933ce3e012f6df92692b08b80db3996af0a449", "parents": ["ff55ed56ffd2e66a69be0c991ed17f9e1d4929c0"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066606 - Re-frame a mini window's crop from a ResizeObserver. r=mconley\n\nThe crop was re-framed from the window's resize event, and each pass read\nminiWin.innerWidth to do it. That read can force a synchronous layout flush,\nand resize fires continuously while a window edge is dragged, so the flush\nlanded on every event of the drag.\n\nA ResizeObserver carries the new size in its observation, so there is nothing\nto read back, and the engine batches observations per frame - a drag now costs\none re-frame per frame rather than one per event. #applyTransform still falls\nback to a non-flushing read for its other caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325228\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs"], "git_node": "b8bb2bee3bac1708816327ddf668e62e9e860e05", "git_parents": ["953ec150388846e8d84b3cd567cab06953f4e1a9"], "node": "3448ca90a7b04c62f2719626842f34753d538cad", "parents": ["6c933ce3e012f6df92692b08b80db3996af0a449"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066606, Bug 2066607 - Re-frame a mini window's crop from a ResizeObserver. r=mconley\" for causing node failures.\n\nThis reverts commit b8bb2bee3bac1708816327ddf668e62e9e860e05.\n\nRevert \"Bug 2066606 - Add a mute button to the mini window nav-bar. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson\"\n\nThis reverts commit 953ec150388846e8d84b3cd567cab06953f4e1a9.\n\nRevert \"Bug 2066606 - Restyle the mini window toolbar and suppress its sidebar. r=mconley,sidebar-reviewers,sfoster\"\n\nThis reverts commit f5caf011b1518e59421e5ebfc42352977e816c7d.\n\nRevert \"Bug 2066606 - Test the mini window flavors. r=mconley\"\n\nThis reverts commit c3f78b5de240222eb9f422b677260c39ff9dbab6.\n\nRevert \"Bug 2066606 - Return a cropped mini window's tab home when it navigates away. r=mconley\"\n\nThis reverts commit d489e8325602d1ee0ee84a2e0d0f234ac3729f89.\n\nRevert \"Bug 2066606 - Separate cropped and full tab mini windows. r=mconley,fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,dao,sfoster,bolsson\"\n\nThis reverts commit 631261a3917a9081ef29b7e041bcdf81b28d6f25.\n\nRevert \"Bug 2066607 - Test the mini window screenshots entry points. r=mconley,niklas\"\n\nThis reverts commit 52d950c565138fb2733fe40f76184c29dfd4f88f.\n\nRevert \"Bug 2066607 - Add a Use Mini Window item to the content context menu. r=mconley,fluent-reviewers,bolsson\"\n\nThis reverts commit be6eb15fad067cb8cb1d2038d34bdc98bf3f6ed4.\n\nRevert \"Bug 2066607 - Add the Screenshots mini-window mode and toolbar button. r=mconley,fluent-reviewers,bolsson,niklas,flod\"\n\nThis reverts commit a038c51ebc999639ed9214ddfbaddfc5dc9bb8b3.\n\nRevert \"Bug 2066606 - Add browser-chrome tests for mini window. r=mconley\"\n\nThis reverts commit 88494b27ad8279f1a356e73ada5394b3790582aa.\n\nRevert \"Bug 2066606 - Reuse and restyle the nav-bar as the mini window chrome. r=mconley,fluent-reviewers,desktop-theme-reviewers,dao,bolsson,urlbar-reviewers\"\n\nThis reverts commit 1d576c1ff8858d2029004e0f71ced43ab8320840.\n\nRevert \"Bug 2066606 - Return mini windows when the origin window's last tab is closed. r=mconley,tabbrowser-reviewers,dao\"\n\nThis reverts commit bb30d5a989cfab37eb626389077f9170839c4be6.\n\nRevert \"Bug 2066606 - Exclude mini windows from the messaging system. r=omc-reviewers,mimi\"\n\nThis reverts commit 89d6a64ee4db8b0b8ebc9804f99c56ee55343e56.\n\nRevert \"Bug 2066606 - Add the always-on-top mini window component behind a pref. r=mconley,tabbrowser-reviewers,dao\"\n\nThis reverts commit 5d24b52566c316f35baed6c31fbcf0c4a9547103.\n", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/app/profile/firefox.js", "browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/base/content/browser.xhtml", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/webext-panels.xhtml", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/moz.build", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_cropped_navigation.js", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_last_tab.js", "browser/components/miniwindow/test/browser/browser_open_close.js", "browser/components/miniwindow/test/browser/browser_origin_close.js", "browser/components/miniwindow/test/browser/browser_placement.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/browser_region_entry.js", "browser/components/miniwindow/test/browser/browser_restore_vs_close.js", "browser/components/miniwindow/test/browser/browser_reveal.js", "browser/components/miniwindow/test/browser/browser_sessionstore.js", "browser/components/miniwindow/test/browser/browser_sidebar.js", "browser/components/miniwindow/test/browser/browser_toolbar.js", "browser/components/miniwindow/test/browser/browser_toolbar_button.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/miniwindow/test/browser/mini-window-crop-target.html", "browser/co