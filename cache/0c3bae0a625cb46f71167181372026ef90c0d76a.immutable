toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/canvas/test/webgl-mochitest/test_renderer_strings.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "764f6a9dfb7f9e56d755b0bdeb7b47311801f4da", "git_parents": ["393f592ef2c0e9661883426b30122f85db345ae8"], "node": "9db2d002319007342efbe3a0054e022248312a13", "parents": ["8026f7d6b996a385a547b532829040d53f332034"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072535 - Update test_renderer_strings's KNOWN_ON_CI strings for Metal ANGLE. r=gfx-reviewers,lsalzman\n\nWith ANGLE enabled, the renderer and vendor strings reported by the\nARM macOS 15 workers now include \"ANGLE\" and \"Google Inc.\"\nrespectively. Metal ANGLE is blocked on macOS versions older than 12,\ntherefore the strings reported by the macOS 10.15 workers are\nunaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326498\n", "files": ["dom/canvas/test/webgl-mochitest/test_renderer_strings.html"], "git_node": "e0cb3fb487b82ceddbbd0f0abaf3b43eb8740843", "git_parents": ["764f6a9dfb7f9e56d755b0bdeb7b47311801f4da"], "node": "e20347a9ffb12baff85d256ac8d54e63a0780ba2", "parents": ["9db2d002319007342efbe3a0054e022248312a13"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072535 - Enable Metal ANGLE for WebGL on Nightly. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326499\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "b6e0f6d72cbbb5e277ef4ba00231d58536bbc684", "git_parents": ["e0cb3fb487b82ceddbbd0f0abaf3b43eb8740843"], "node": "ca8d60a72001f660fc107f1fe17af11a9bb41f4e", "parents": ["e20347a9ffb12baff85d256ac8d54e63a0780ba2"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072535 - Update test expectations. r=gfx-reviewers,lsalzman\n\nEnabling Metal ANGLE for WebGL causes a bunch of tests to now pass on\naarch64 macOS 15 workers.\n\nHowever, there are additionally a few tests that must now be skipped\ndue to assertion failures in debug builds. Note that these are already\nskipped on Windows for the same reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326500\n", "files": ["dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml"], "git_node": "a5639339a8df8862403781b270b9554c00346bba", "git_parents": ["b6e0f6d72cbbb5e277ef4ba00231d58536bbc684"], "node": "d1bfdc8f5fb652bb1482de4e8d487b818ea9bcf4", "parents": ["ca8d60a72001f660fc107f1fe17af11a9bb41f4e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071175 - Part 7: Use {Pop,pop}Regs when applicable. r=jandem\" for causing crashtest failures\n\nThis reverts commit abe32ad1d3c5fe8ba2aba3c35fd3488eef6d4e05.\n\nRevert \"Bug 2071175 - Part 6: Use {Push,push}Regs in various other locations. r=jandem\"\n\nThis reverts commit c96a5a29f6554af39f1940eb409dbc6fd94a4042.\n\nRevert \"Bug 2071175 - Part 5: Use PushRegs when setting up call arguments. r=jandem\"\n\nThis reverts commit e1ce6877fb6cb91c1663ac6e31e4a339322e6a60.\n\nRevert \"Bug 2071175 - Part 4: Use {Push,Pop}Regs in {Push,Pop}ICFrameRegs. r=jandem\"\n\nThis reverts commit 72ba7f79c7792e8e616d7ed7f86078f6c7930491.\n\nRevert \"Bug 2071175 - Part 3: Use burst {Push,push}Regs in prologues. r=jandem\"\n\nThis reverts commit bf92aad168edb00ada43481a62d9f9c6fb44b476.\n\nRevert \"Bug 2071175 - Part 2: Define link register constant on supported archs. r=jandem\"\n\nThis reverts commit 4396a75318a365d54a46b0c58e4a57ac66adcbff.\n\nRevert \"Bug 2071175 - Part 1: Introduce burst (batched) {push,Push,pop,Pop}Regs(...). r=jandem\"\n\nThis reverts commit 83cd3a2dcd5e4de07cdef4a067b27f9f9988ffa4.\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineIC.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/InterpreterEntryTrampoline.cpp", "js/src/jit/IonCacheIRCompiler.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/TrampolineNatives.cpp", "js/src/jit/arm/Assembler-arm.h", "js/src/jit/arm/MacroAssembler-arm.h", "js/src/jit/arm/SharedICHelpers-arm-inl.h", "js/src/jit/arm/SharedICHelpers-arm.h", "js/src/jit/arm/Trampoline-arm.cpp", "js/src/jit/arm64/Assembler-arm64.h", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/arm64/SharedICHelpers-arm64-inl.h", "js/src/jit/arm64/Trampoline-arm64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/MacroAssembler-loong64.h", "js/src/jit/loong64/SharedICHelpers-loong64-inl.h", "js/src/jit/loong64/SharedICHelpers-loong64.h", "js/src/jit/loong64/Trampoline-loong64.cpp", "js/src/jit/mips-shared/Assembler-mips-shared.h", "js/src/jit/mips-shared/SharedICHelpers-mips-shared-inl.h", "js/src/jit/mips-shared/SharedICHelpers-mips-shared.h", "js/src/jit/mips64/MacroAssembler-mips64.h", "js/src/jit/mips64/Trampoline-mips64.cpp", "js/src/jit/none/MacroAssembler-none.h", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jit/riscv64/Register-riscv64.h", "js/src/jit/riscv64/SharedICHelpers-riscv64-inl.h", "js/src/jit/riscv64/SharedICHelpers-riscv64.h", "js/src/jit/riscv64/Trampoline-riscv64.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/wasm32/Assembler-wasm32.h", "js/src/jit/wasm32/MacroAssembler-wasm32.h", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86-shared/Assembler-x86-shared.h", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/Trampoline-x86.cpp"], "git_node": "69944bef9cf177778674cad9c2295fc51314cd13", "git_parents": ["a5639339a8df8862403781b270b9554c00346bba"], "node": "a7a3e600948a0edd40679114c06f47625bdaeeec", "parents": ["d1bfdc8f5fb652bb1482de4e8d487b818ea9bcf4"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2033633 - Skip density correction for fallback intrinsic height. r=dholbert\" for causing wpt failures\n\nThis reverts commit da9b26b4440a48c5bf17b3bf8ae702736f4f47ff.\n", "files": ["dom/base/nsImageLoadingContent.cpp", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/naturalWidth-naturalHeight-width-height.html.ini"], "git_node": "072b40142a40b05281db90eeab623b6956ec7ab8", "git_parents": ["69944bef9cf177778674cad9c2295fc51314cd13"], "node": "3408d8421df4040549c766a40452dfa29785d30e", "parents": ["a7a3e600948a0edd40679114c06f47625bdaeeec"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044192 - Remove image.natural-size-fallback.enabled. r=dholbert\" for causing wpt failures\n\nThis reverts commit 24c53e55deb24bc6229a26ac541037dfb07d868e.\n", "files": ["dom/base/nsImageLoadingContent.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/__dir__.ini"], "git_node": "5ac5fc0b11de5d6148f02b42e5e3cf15008f0b8d", "git_parents": ["072b40142a40b05281db90eeab623b6956ec7ab8"], "node": "5485fd26a493f03aeabcb83d43df3bccbee0151c", "parents": ["3408d8421df4040549c766a40452dfa29785d30e"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2071175 - Part 1: Introduce burst (batched) {push,Push,pop,Pop}Regs(...). r=jandem\n\nThese helpers accept anything static_cast-able to Register.\n\n- x86, x64, arm: These expands to raw push() and pop() calls.\n- arm64: It accepts 1 to 4 arguments, and delegate to the corresponding\n  overload.\n- riscv64, mips64, loong64: It accepts arbitrary number of arguments,\n  and expands to one stack pointer adjustment instruction and a series\n  of loads/stores.\n\nThe naming follows existing convention of plain push()/pop() and\nframePushed_-adjusting Push()/Pop().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325309\n", "files": ["js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm.h", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/loong64/MacroAssembler-loong64.h", "js/src/jit/mips64/MacroAssembler-mips64.h", "js/src/jit/none/MacroAssembler-none.h", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jit/wasm32/MacroAssembler-wasm32.h", "js/src/jit/x86-shared/Assembler-x86-shared.h"], "git_node": "ba14a6b634a18b4d13ad6babf4118251828b36d3", "git_parents": ["5ac5fc0b11de5d6148f02b42e5e3cf15008f0b8d"], "node": "07c3e95dd11e00ea0eda3c39fbf1a420efc968cf", "parents": ["5485fd26a493f03aeabcb83d43df3bccbee0151c"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2071175 - Part 2: Define link register constant on supported archs. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325310\n", "files": ["js/src/jit/arm/Assembler-arm.h", "js/src/jit/arm64/Assembler-arm64.h", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/mips-shared/Assembler-mips-shared.h", "js/src/jit/riscv64/Register-riscv64.h", "js/src/jit/wasm32/Assembler-wasm32.h"], "git_node": "7523ba7af92a539bb7278502cbfe5bf0343e4b5e", "git_parents": ["ba14a6b634a18b4d13ad6babf4118251828b36d3"], "node": "c75134bf2eabf293173eb7c7c6374c56fa3c56b4", "parents": ["07c3e95dd11e00ea0eda3c39fbf1a420efc968cf"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2071175 - Part 3: Use burst {Push,push}Regs in prologues. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325311\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/InterpreterEntryTrampoline.cpp", "js/src/jit/TrampolineNatives.cpp", "js/src/jit/arm/SharedICHelpers-arm-inl.h", "js/src/jit/arm/Trampoline-arm.cpp", "js/src/jit/arm64/SharedICHelpers-arm64-inl.h", "js/src/jit/loong64/SharedICHelpers-loong64-inl.h", "js/src/jit/loong64/Trampoline-loong64.cpp", "js/src/jit/mips-shared/SharedICHelpers-mips-shared-inl.h", "js/src/jit/mips64/Trampoline-mips64.cpp", "js/src/jit/riscv64/SharedICHelpers-riscv64-inl.h", "js/src/jit/riscv64/Trampoline-riscv64.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86/Trampoline-x86.cpp"], "git_node": "36e784b39a59fa7503ea5e580199fa192bcc49fa", "git_parents": ["7523ba7af92a539bb7278502cbfe5bf0343e4b5e"], "node": "b8c58103968928758b93f8dfbb438972032fb474", "parents": ["c75134bf2eabf293173eb7c7c6374c56fa3c56b4"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2071175 - Part 4: Use {Push,Pop}Regs in {Push,Pop}ICFrameRegs. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325312\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp"], "git_node": "379d87754c938fb765f51cf8e2dc0e5db42919de", "git_parents": ["36e784b39a59fa7503ea5e580199fa192bcc49fa"], "node": "45e231fa36ce93514f0ca99566b382c202775527", "parents": ["b8c58103968928758b93f8dfbb438972032fb474"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2071175 - Part 5: Use PushRegs when setting up call arguments. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325313\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineIC.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/IonCacheIRCompiler.cpp"], "git_node": "919d0434585cbe22bdbb5efbd33923d5a2cf877f", "git_parents": ["379d87754c938fb765f51cf8e2dc0e5db42919de"], "node": "492d94ba96bc5d7d91b5ec74a0d123ba1de0f78e", "parents": ["45e231fa36ce93514f0ca99566b382c202775527"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2071175 - Part 6: Use {Push,push}Regs in various other locations. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325314\n", "files": ["js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/arm/Trampoline-arm.cpp", "js/src/jit/arm64/Trampoline-arm64.cpp", "js/src/jit/loong64/Trampoline-loong64.cpp", "js/src/jit/mips64/Trampoline-mips64.cpp", "js/src/jit/riscv64/Trampoline-riscv64.cpp", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/Trampoline-x86.cpp"], "git_node": "a973779b97dd33ae6ecb247b6bdca4f558201932", "git_parents": ["919d0434585cbe22bdbb5efbd33923d5a2cf877f"], "node": "047f2ce39578cf3ad147daaaa6fb685036bce565", "parents": ["492d94ba96bc5d7d91b5ec74a0d123ba1de0f78e"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2071175 - Part 7: Use {Pop,pop}Regs when applicable. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325315\n", "files": ["js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/arm/SharedICHelpers-arm.h", "js/src/jit/arm/Trampoline-arm.cpp", "js/src/jit/arm64/Trampoline-arm64.cpp", "js/src/jit/loong64/SharedICHelpers-loong64.h", "js/src/jit/loong64/Trampoline-loong64.cpp", "js/src/jit/mips-shared/SharedICHelpers-mips-shared.h", "js/src/jit/mips64/Trampoline-mips64.cpp", "js/src/jit/riscv64/SharedICHelpers-riscv64.h", "js/src/jit/riscv64/Trampoline-riscv64.cpp", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/Trampoline-x86.cpp"], "git_node": "45a4151ab18e3d1e4cfbf7d66c7eef9e3d4c67b4", "git_parents": ["a973779b97dd33ae6ecb247b6bdca4f558201932"], "node": "496a9cd582db7f14c719da4511fa49a38996b96f", "parents": ["047f2ce39578cf3ad147daaaa6fb685036bce565"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066486 - Added text under Wayback Button r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321305\n", "files": ["mobile/android/android-components/components/browser/errorpages/README.md", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorPages.kt", "mobile/android/android-components/components/browser/errorpages/src/main/res/values/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/test/java/mozilla/components/browser/errorpages/ErrorPagesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/WaybackMachineErrorPageTest.kt", "mobile/android/fenix/app/src/main/assets/lowMediumErrorPages.js", "mobile/android/fenix/app/src/main/assets/low_and_medium_risk_error_pages.html", "mobile/android/fenix/app/src/main/assets/low_and_medium_risk_error_style.css"], "git_node": "ac6a76590fd15fefda57a7eebaeb501dc863992a", "git_parents": ["45a4151ab18e3d1e4cfbf7d66c7eef9e3d4c67b4"], "node": "a28f8a9dade0dcb6c07e9ac31ec28a62cb374c38", "parents": ["496a9cd582db7f14c719da4511fa49a38996b96f"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072599 - Pass the request hostname instead of the schemeless site to the content classifier engine. r=emz\n\nContentClassifierRequest passed the base domain as the hostname,\nso ||host^ rules below the base domain and $domain= options\nkeyed on a subdomain could never match. Keep the full hosts alongside\nthe site fields and pass those to the engine; the sites still drive the\nthird-party comparisons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326488\n", "files": ["toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.cpp", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.h", "toolkit/components/content-classifier/content_classifier_engine/src/lib.rs", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_subdomain_rules.js"], "git_node": "76d6c8bff7f5371c6379b39f7350bb64b5d4bcf4", "git_parents": ["ac6a76590fd15fefda57a7eebaeb501dc863992a"], "node": "2f29357b363830e774285b43536abbfe40ea648f", "parents": ["a28f8a9dade0dcb6c07e9ac31ec28a62cb374c38"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068217 - Let a test shorten the terminator's watchdog deadline instead of waiting it out. r=xpcom-reviewers,nika\n\ntest_crash_terminator.js needs its watchdog deadline both long enough that the\nphase notifications in its setup cannot be overtaken and short enough that the\ntest does not spend it idling. Bug 2065080 widened the margin the terminator\nkeeps for real shutdowns from 3 to 10 seconds, the test inherited it, and that\npushed it over the harness timeout on the slower macOS machines.\n\nMake the deadline a value the watchdog re-reads on every tick and let a test\nlower it once it has reached the phase it wants to hang in. StartWatchdog sets\nit on the main thread before the watchdog thread exists, so it cannot race with\na later SetTicksBeforeCrash. The test now crashes at the next heartbeat rather\nthan waiting out a margin it never needed, and no delay between its phase\nnotifications can make the watchdog fire against the wrong phase.\n\nWhile here, check MozCrashReason too. crasher_subprocess_tail.js crashes the\nprocess unconditionally once our setup returns, so the test passed even when\nthe terminator never fired at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322833\n", "files": ["toolkit/components/terminator/nsITerminatorTest.idl", "toolkit/components/terminator/nsTerminator.cpp", "toolkit/crashreporter/test/unit/test_crash_terminator.js"], "git_node": "39809681a7f9f62994d4859c2006c394e9392d63", "git_parents": ["76d6c8bff7f5371c6379b39f7350bb64b5d4bcf4"], "node": "b27782e37848250fa17a429fcc3dfcd94693fc5f", "parents": ["2f29357b363830e774285b43536abbfe40ea648f"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061802 - Update attention dot color (light and dark modes) r=desktop-theme-reviewers,thecount,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325502\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/content/widgets/moz-button/moz-button.stories.mjs", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/figma-variables-all.json", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/base/color.nova.tokens.json"], "git_node": "f554607d13d4aabd38ecc8dab191a522711b08d2", "git_parents": ["39809681a7f9f62994d4859c2006c394e9392d63"], "node": "6037f6e2ab92051b27ef4141e31d7ff51e8697a1", "parents": ["b27782e37848250fa17a429fcc3dfcd94693fc5f"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072304 - Add QuadClipStack, a self-contained clip description for the quad path. r=gfx-reviewers,gw\n\nThe quad path currently resolves its clips out of ClipStore and the clip\ninterner at every consumer. Splitting the low-level 2D rendering code into\nits own crate means the quad code can no longer know about those.\n\nQuadClipStack holds the clipping information already pulled from the stores\nin a plain Vec, so consumers never resolve a handle or an index range. It is\nthe clip-side analogue of QuadTransformState. ClipStore::fill_quad_clips is\nthe bridge, placed on the clip side of the eventual split.\n\nNothing consumes it yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326242\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/quad_clip.rs"], "git_node": "137b160e02c69b838b0bcf0ae5570a3f7087dc31", "git_parents": ["f554607d13d4aabd38ecc8dab191a522711b08d2"], "node": "0fcce915f676bf1ff9d3c4d625077160079acc52", "parents": ["6037f6e2ab92051b27ef4141e31d7ff51e8697a1"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072304 - Pass a QuadClipStack to the quad path, and read the render strategy from it. r=gfx-reviewers,gw\n\nThreads a QuadClipStack through the prepare_quad entry points, built once per\nprimitive from the primitive's clip chain. get_prim_render_strategy and\ncache_key now read it instead of walking ClipNodeRange through ClipStore and\nthe clip interner, so both drop their store arguments.\n\nThe rest of quad.rs still takes the ClipChainInstance and the interned clips.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326243\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/quad.rs"], "git_node": "e0591753d74e45f907471d3ab85aa3927bb6882a", "git_parents": ["137b160e02c69b838b0bcf0ae5570a3f7087dc31"], "node": "b8284eaab294d3adde52bed4c4ecdddc81c85539", "parents": ["0fcce915f676bf1ff9d3c4d625077160079acc52"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072304 - Emit quad clip masks from the QuadClipStack instead of the clip stores. r=gfx-reviewers,gw\n\nThe mask path (prepare_clip_range, prepare_clip_task, add_render_task_with_mask,\nprepare_indirect_pattern, prepare_nine_patch, prepare_tiles) reads its clips off\nthe stack, so quad.rs no longer takes the interned clips or reaches into\nframe_state.clip_store.\n\nThe two mask paths in prepare_picture_clips used to fabricate a contiguous\nClipNodeRange by cloning selected instances onto the end of the global\nclip_node_instances. They collect into a local QuadClipStack instead, so the\nglobal store no longer grows for them.\n\nquad.rs still takes the ClipChainInstance for its local clip rect, coverage\nrect and needs_mask flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326244\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/quad.rs"], "git_node": "4fb7b2f3e3f6fa744deb579849663a23d7e92573", "git_parents": ["e0591753d74e45f907471d3ab85aa3927bb6882a"], "node": "dc516e065b63a605727d9815310263989367a1c4", "parents": ["b8284eaab294d3adde52bed4c4ecdddc81c85539"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072304 - Drop ClipChainInstance from the quad path. r=gfx-reviewers,gw\n\nThe local clip rect, coverage rect and needs_mask flag move onto QuadClipStack,\nwhich was already carrying them for get_prim_render_strategy. quad.rs now\nimports nothing from clip.rs but clamped_radius.\n\ncompute_surface_visible_rect took a clip chain only to read its coverage rect,\nso it takes the rect. prepare_picture_primitive's clip chain argument was\nalready unused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326245\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "334928be48876b63753570caf448fb73d7cf50ea", "git_parents": ["4fb7b2f3e3f6fa744deb579849663a23d7e92573"], "node": "0ed73ce61672502a123f2e3b453cb635d7523013", "parents": ["dc516e065b63a605727d9815310263989367a1c4"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2072304 - Store QuadClipStack's coverage rect in device space. r=gfx-reviewers,gw\n\nBoth reads of the coverage rect in prepare_quad_impl fed map_to_device_rect\nimmediately, so the mapping moves to where the stack is filled. The callers map\nit through the surface the primitive is drawn into, which is the surface both\nold call sites used and the space every quad render task and scissor rect\nalready lives in. fill_quad_clips takes the mapped rect rather than a\nSurfaceInfo so that clip.rs stays out of surface space.\n\ncompute_surface_visible_rect intersects in device space too, which drops the\nclipping_rect_in_picture_space max_rect special case from its path: scaling\nmax_rect overflows, intersecting against it does not. The mapping is a 2D\nscale+offset and so distributes over the intersection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326246\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/quad_clip.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "f34cf6acb88083dfd6ccc629695dc5e8e75d9cd3", "git_parents": ["334928be48876b63753570caf448fb73d7cf50ea"], "node": "50236f73b8fa0d01d6249bbb64beb28a85d1342d", "parents": ["0ed73ce61672502a123f2e3b453cb635d7523013"], "tags": []}, {"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066543 - VoiceOver support for About Firefox \u003e Share Firefox link r=nbarrett\n\nAdds aria-describedby attribute to the sharefirefox button so that\nscreen readers can pick it up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325134\n", "files": ["browser/base/content/aboutDialog.js", "browser/base/content/test/about/browser_aboutDialog_referrals.js"], "git_node": "fd745237b84b0324665112898754a0c49efd76ed", "git_parents": ["f34cf6acb88083dfd6ccc629695dc5e8e75d9cd3"], "node": "a4a606f1be6fcac50ffa48aad0b08033b2dda53a", "parents": ["50236f73b8fa0d01d6249bbb64beb28a85d1342d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050422 - Give each xpcshell harness run its own `tempDir` r=ahal\n\nWithout a `tempDir`, every `XPCShellTests` writes its prefs to the same\n`user.js` in the process wide temp dir. The self tests run in parallel, so\nthey interleave writes to it, and xpcshell either fails to parse the result\nor the main suite runs with a self test's prefs.\n\nThe self tests could pass their own `tempDir`, since each already owns one.\nInstead the harness creates a private directory whenever the caller gives\nnone and removes it once `runTests` returns, so any two runs that leave the\nchoice to the harness stay apart, not only the self tests. Cleanup has to\nwait for `runTests` because `--verify` calls `runTestList` several times on\nthe same instance.\n\nThe directory name is kept short because it sits between `$TMPDIR` and the\nper test `xpc-other-` directory. macOS unix domain socket paths are limited\nto 103 bytes and `test_unix_domain.js` was one byte over with a longer name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326019\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "1f18280ca9191f42c764cb6107000916780f6795", "git_parents": ["fd745237b84b0324665112898754a0c49efd76ed"], "node": "8021816f672cc31d3bc47428e0b57d88c1c75274", "parents": ["a4a606f1be6fcac50ffa48aad0b08033b2dda53a"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2068858: Test WebAuthn flow with password manager autofill r=jschanck,credential-management-reviewers,dimi\n\nThis adds a new WebAuthn browser test that triggers a password manager\nprompt.  This test fails with D311392 (copied to child change D324489), and\npasses without it.\n\nTest run with change: https://treeherder.mozilla.org/jobs?repo=try&revision=3d87ddfca012acd80669724c4a76fb26ec46543c\n\nTest run with D311392 reapplied: https://treeherder.mozilla.org/jobs?repo=try&revision=317241fb4cc0b78ac4ed35380c4441883eae8d99\n\nNew test failures: https://tests.firefox.dev/try.html?rev=317241fb4cc0b78ac4ed35380c4441883eae8d99&filter=webauthn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324226\n", "files": ["dom/webauthn/tests/browser/browser.toml", "dom/webauthn/tests/browser/browser_webauthn_prompts.js", "dom/webauthn/tests/browser/head.js", "dom/webauthn/tests/browser/tab_login_form.html"], "git_node": "4155314efa17e31943cbd12ee65685969ab468a9", "git_parents": ["1f18280ca9191f42c764cb6107000916780f6795"], "node": "3e122a4a07c19133cbc18e0b1d2d1071bc107cb6", "parents": ["8021816f672cc31d3bc47428e0b57d88c1c75274"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069744 - Don't assume instance creation succeeded on windows. r=webgpu-reviewers,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326509\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "5264690decb00122b2083eac079ff40345fa694b", "git_parents": ["4155314efa17e31943cbd12ee65685969ab468a9"], "node": "85e972a4648004e5279e9121b567d95812f37753", "parents": ["3e122a4a07c19133cbc18e0b1d2d1071bc107cb6"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067756 - Remove the version 155 train-hop host gate for the New Tab theme picker r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322507\n", "files": ["browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "8c8e2f0900c237afd7ccafe3268d941f6ebccb54", "git_parents": ["5264690decb00122b2083eac079ff40345fa694b"], "node": "b03a4be50b6838ef84fae4642be7047728ce065a", "parents": ["85e972a4648004e5279e9121b567d95812f37753"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 1: Add duplex to Request and a pref for streaming upload r=webidl,emilio\n\nThe duplex getter always returns \"half\" per\nhttps://fetch.spec.whatwg.org/#dom-request-duplex, and RequestDuplex has only\nthat one value, so nothing needs to be stored or carried across IPC. init\nduplex is only inspected for presence, which the constructor validation does\ndirectly.\n\nAlso add the InternalRequest flag recording that the body is a ReadableStream,\nand the pref gating the feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325141\n", "files": ["dom/fetch/InternalRequest.cpp", "dom/fetch/InternalRequest.h", "dom/fetch/Request.h", "dom/webidl/Request.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/fetch/api/idlharness.https.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-init-stream.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-structure.any.js.ini"], "git_node": "f5c91be891ec94cf5edd0d961567a4b5a810a891", "git_parents": ["8c8e2f0900c237afd7ccafe3268d941f6ebccb54"], "node": "98695e7743d3aaa559c93d3344ec8ded256d6fd1", "parents": ["b03a4be50b6838ef84fae4642be7047728ce065a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 2: Add IPC serialization for hasStreamBody r=necko-reviewers,dom-worker-reviewers,jesup,edenchuang\n\nA worker fetch is driven from the parent process, so without this flag\nFetchDriver there would not know to take the streaming upload path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325142\n", "files": ["dom/fetch/FetchTypes.ipdlh", "dom/fetch/InternalRequest.cpp", "dom/serviceworkers/ServiceWorkerPrivate.cpp"], "git_node": "b5145b46cc99a282f7fa3c4c8695d4e275e4a9b8", "git_parents": ["f5c91be891ec94cf5edd0d961567a4b5a810a891"], "node": "73da1abc32b7f54d7562fb7ceedd5f4ac4d4f2b9", "parents": ["98695e7743d3aaa559c93d3344ec8ded256d6fd1"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 3: Add Request constructor duplex validation r=necko-reviewers,jesup\n\nAdd duplex parameter validation in Request constructor following Fetch spec steps 36-38.\nSet duplex mode from RequestInit if provided.\nAdd validation that duplex is required when body is ReadableStream.\n\nThis implements spec-compliant validation for the duplex parameter, preparing for\nReadableStream body support.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295245\n", "files": ["dom/fetch/FetchDriver.cpp", "dom/fetch/Request.cpp"], "git_node": "e09f150651ca3929139ae6d0642d880344b19766", "git_parents": ["b5145b46cc99a282f7fa3c4c8695d4e275e4a9b8"], "node": "e6b647101a77e91eeef1d33b802326d1ba9d1390", "parents": ["73da1abc32b7f54d7562fb7ceedd5f4ac4d4f2b9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 4: Add ReadableStream body support to Request r=webidl,saschanaz,emilio\n\nUpdate BodyInit typedef in Fetch.webidl to include ReadableStream.\nUpdate Fetch.h type aliases for BodyInit and OwningBodyInit.\nAdd ReadableStream handling in Request constructor following Response pattern.\nHandle locked/disturbed streams and create FetchStreamReader for JS streams.\nMark HasStreamBody flag when ReadableStream body is used.\nRemove duplicate ResponseBodyInit overload (now same as BodyInit).\n\nThis enables Request constructor to accept ReadableStream bodies with duplex parameter,\nimplementing the core of Fetch upload streaming support per the Fetch Standard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295246\n", "files": ["dom/base/Navigator.cpp", "dom/fetch/Fetch.cpp", "dom/fetch/Fetch.h", "dom/fetch/Request.cpp", "dom/webidl/Fetch.webidl", "dom/webidl/Response.webidl", "testing/web-platform/meta/beacon/beacon-basic.https.window.js.ini", "testing/web-platform/meta/fetch/api/__dir__.ini", "testing/web-platform/mozilla/meta/fetch/api/request/request-init-stream-pref-off.any.js.ini", "testing/web-platform/mozilla/tests/fetch/api/request/request-init-stream-pref-off.any.js"], "git_node": "93303a6b3c5395da6e58b52a1b45725d5b62d474", "git_parents": ["e09f150651ca3929139ae6d0642d880344b19766"], "node": "356ef39685508c99bb48c4a5bf970a0d58574910", "parents": ["e6b647101a77e91eeef1d33b802326d1ba9d1390"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 5: Reject streaming uploads that cannot be carried or replayed r=necko-reviewers,jesup\n\nA ReadableStream request body has a null source, so it can be neither sent\nover HTTP/1.1 nor replayed on a redirect. Enforce both in FetchDriver:\n\n- In OnStartRequest, fail the fetch with a network error unless the response\n  came over h2 or h3. Responses synthesized by a service worker never reached\n  the network and carry no protocol version, so they are exempt.\n- In AsyncOnChannelRedirect, fail any redirect other than 303. Per\n  https://fetch.spec.whatwg.org/#http-redirect-fetch step 11 a non-303\n  redirect of a body whose source is null is a network error, and that check\n  precedes the step 12 rewrite that would otherwise drop the body on a\n  301/302 POST. A 303 is allowed because it turns the request into a GET with\n  no body.\n\nThe network layer changes that let such a body reach the wire at all are in\nthe next part.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325143\n", "files": ["dom/fetch/FetchDriver.cpp"], "git_node": "36c70f4bac1b0f849cefebd1edce108623d5ee4e", "git_parents": ["93303a6b3c5395da6e58b52a1b45725d5b62d474"], "node": "d5c957cb4e4f8563abc734fa9950d95c35364536", "parents": ["356ef39685508c99bb48c4a5bf970a0d58574910"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 7: Let a channel carry a length-less streaming upload r=necko-reviewers,jesup\n\nA ReadableStream request body reaches the channel as an async pipe whose\nlength is not known when the request is set up, which the upload paths were\nnot prepared for.\n\n- Add an UploadStreamIsStreaming flag to HttpBaseChannel, set by FetchDriver\n  before ExplicitSetUploadStream, propagated to the parent process through\n  HttpChannelOpenArgs and preserved across channel replacement in\n  ReplacementChannelConfig.\n- InternalSetUploadStream skips normalization for such a body, since a pipe\n  can neither be buffered into a StorageStream nor seeked, and leaves\n  mReqContentLength at 0 because the length genuinely is not known yet.\n- Give the transaction the same knowledge, so that nsHttpTransaction::Init\n  does not read a zero content length as \"no body\" and drop it. Without this\n  the request would be sent with no body at all.\n- CloneUploadStream reports no clone. Teeing the pipe would let a service\n  worker read event.request.body while the network layer still got a full\n  copy, but only by buffering an upload of unbounded size in memory and\n  discarding the back-pressure that streaming uploads exist to provide. A\n  service worker therefore sees a null request body for now; making that work\n  without the buffering is left to a follow-up, and the affected\n  fetch-event.https.h2.html expectations are kept.\n- Reject a streaming upload to a non-https URL early in FetchDriver: browsers\n  only speak HTTP/2 over TLS, so any other scheme implies HTTP/1.1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325144\n", "files": ["dom/fetch/FetchDriver.cpp", "dom/ipc/DOMTypes.ipdlh", "netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h", "netwerk/protocol/http/HttpTransactionShell.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": "19b1c53c33e234b69a3f837d5cb876d6d74c1a40", "git_parents": ["36c70f4bac1b0f849cefebd1edce108623d5ee4e"], "node": "4fc903d402cd9e368479253609335c0c60e56e7e", "parents": ["d5c957cb4e4f8563abc734fa9950d95c35364536"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 8: Frame a length-less request body on HTTP/2 and HTTP/3 r=necko-reviewers,jesup\n\nWith no Content-Length, the transaction and framing layers had no way to tell\n\"no body\" from \"a body whose length is not known yet\".\n\n- nsHttpTransaction refuses to restart on a 421 because the body cannot be\n  replayed. nsHttpChannel likewise fails a 401 with\n  NS_ERROR_NET_BODY_NOT_REPLAYABLE instead of resubmitting the request with\n  credentials, except on an anonymous load, which never authenticates and so\n  receives the 401 as its response.\n- Such a body also cannot be framed on HTTP/1.x, so ReadSegments() fails once\n  the negotiated version is known and before any of it is written. Leaving\n  this to the protocol check in FetchDriver::OnStartRequest meant an https\n  origin that turned out to be HTTP/1.1 received the entire upload and only\n  then had the fetch rejected. The failure uses the same non-replayable error\n  so that the connection-level retries do not reconnect just to fail again.\n- Restart() also refuses once a streaming body has started going out. The\n  rewind it performs is a nsISeekableStream QI that silently does nothing on a\n  pipe, so the generic connection-level retries (ECH and HTTPS-RR fallback,\n  H2 to H1 fallback, 0-RTT rejection) would otherwise resume from mid-request\n  and put a headerless request on the wire. A restart before the first read\n  stays allowed, so a retry of a request that never reached the server still\n  works.\n- Http2Stream sets mRequestBodyLenRemaining to -1 for a streaming upload, so\n  END_STREAM is driven by the zero-byte read that ends the body rather than by\n  a byte count reaching zero. Left at 0, HTTP/2 treated the request as\n  bodyless and closed the stream on the HEADERS frame. Only a streaming upload\n  takes the sentinel, so CONNECT tunnels keep the previous meaning; an earlier\n  iteration keyed on the missing Content-Length instead and thereby broke the\n  NS_NET_STATUS_WAITING_FOR notification for GETs.\n- Http3Stream only cross-checks bytes sent against the expected length when a\n  length was actually known.\n\nAlso teach the h3 test server to answer a POST whose body ends on the HEADERS\nframe; it previously left such requests hanging because no Data event ever\narrived.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325145\n", "files": ["netwerk/protocol/http/Http2Stream.cpp", "netwerk/protocol/http/Http2StreamBase.cpp", "netwerk/protocol/http/Http3Stream.cpp", "netwerk/protocol/http/Http3Stream.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/test/gtest/TestHttpTransactionRestart.cpp", "netwerk/test/gtest/moz.build", "netwerk/test/http3server/src/main.rs", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-methods.h2.any.js", "xpcom/base/ErrorList.py"], "git_node": "57b54e6042553a196cf274597ef09e7d5277ef0e", "git_parents": ["19b1c53c33e234b69a3f837d5cb876d6d74c1a40"], "node": "4ba016db4f384fb89499f35fc5a1c76c0f8aae96", "parents": ["4fc903d402cd9e368479253609335c0c60e56e7e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 9: Tie the FetchStreamReader lifetime to the fetch and its global r=necko-reviewers,jesup\n\n- Follow the fetch signal, so aborting a fetch cancels the underlying\n  ReadableStream with the signal reason rather than leaving it running.\n- Close the pipe when the global is torn down, via GlobalTeardownObserver.\n  Waiting for cycle collection left the close until XPCOM shutdown, by which\n  point the pipe notification is never delivered and the pipe, its callback\n  and the reader are all reported as leaked. Workers were already covered by\n  a StrongWorkerRef; windows had no equivalent hook.\n- Refuse to start consuming once the reader has been closed. Nothing reaches\n  that today, because every close path that script can drive also disturbs\n  the stream and so trips the body-used check first, but IsConsuming() only\n  tracks mReader and CloseAndRelease() drops mOutput too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325146\n", "files": ["dom/fetch/FetchStreamReader.cpp", "dom/fetch/FetchStreamReader.h", "dom/fetch/Request.cpp", "testing/web-platform/meta/fetch/api/abort/general.any.js.ini"], "git_node": "22f57e5a642d9129ffe7fc0dbcbbcfca758fd8b7", "git_parents": ["57b54e6042553a196cf274597ef09e7d5277ef0e"], "node": "9ac36beec3ab9abdb17bd060e5c2b677f244518d", "parents": ["4ba016db4f384fb89499f35fc5a1c76c0f8aae96"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 10: Enable the streaming upload tests r=necko-reviewers,jesup\n\nAdd an end-to-end xpcshell test covering fetch() with a ReadableStream body\nover both HTTP/2 and HTTP/3, with dom.fetch.streaming_upload set since the\npref is nightly-only by default, and drop the WPT expectations for the tests\nthe preceding parts make pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325148\n", "files": ["netwerk/test/unit/test_fetch_streaming_upload.js", "netwerk/test/unit/xpcshell.toml", "testing/web-platform/meta/fetch/api/basic/keepalive.any.js.ini", "testing/web-platform/meta/fetch/api/basic/request-referrer-redirected-worker.html.ini", "testing/web-platform/meta/fetch/api/basic/request-upload.any.js.ini", "testing/web-platform/meta/fetch/api/basic/request-upload.h2.any.js.ini", "testing/web-platform/meta/fetch/api/basic/scheme-data.any.js.ini", "testing/web-platform/meta/fetch/api/redirect/redirect-upload.h2.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-clone-readable-stream-body.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-init-contenttype.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-init-stream.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-keepalive.any.js.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-event.https.h2.html.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-event.https.html.ini", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-redirect.h2.any.js"], "git_node": "681ed933ab4489430db06cac4298f74822f94cba", "git_parents": ["22f57e5a642d9129ffe7fc0dbcbbcfca758fd8b7"], "node": "9e4472d821af68a9cdeb7c69acd2d77b45bf7f0d", "parents": ["9ac36beec3ab9abdb17bd060e5c2b677f244518d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 11: Expose Request.body as a ReadableStream r=necko-reviewers,webidl,emilio,jesup\n\nAdd the body attribute to Request, gated on dom.fetch.streaming_upload, so\nthat a request built from a ReadableStream can be read back. Response has\nalways declared its own copy of this attribute because the Body mixin could\nnot be included wholesale; refresh that comment now that the split exists\nbecause Request is pref-gated rather than because Request lacks the\nattribute.\n\nRequest::Constructor now hands the exact ReadableStream from init[\"body\"] to\nthe new Request, so that request.body is reference-equal to the stream the\ncaller passed, as the spec requires.\n\nA Request built from a ReadableStream already starts consuming it during\nconstruction, so add FetchStreamReader::IsConsuming() and check it in\nSetBodyUsed() to stop a later consumer from acquiring a second reader on the\nsame stream.\n\nThe body getter needs a JSContext, so add it to the implicitJSContext list\nfor Request in Bindings.conf.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325149\n", "files": ["dom/bindings/Bindings.conf", "dom/fetch/Fetch.cpp", "dom/fetch/FetchStreamReader.h", "dom/fetch/Request.cpp", "dom/webidl/Request.webidl", "dom/webidl/Response.webidl", "testing/web-platform/meta/fetch/api/body/textstream.any.js.ini", "testing/web-platform/meta/fetch/api/idlharness.https.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-constructor-init-body-override.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-disturbed.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-init-stream.any.js.ini"], "git_node": "c98056bddfd312899ba1330963072f8b8f052ee0", "git_parents": ["681ed933ab4489430db06cac4298f74822f94cba"], "node": "527e880218b1de69be5cda5739dbc84af58f9c48", "parents": ["9e4472d821af68a9cdeb7c69acd2d77b45bf7f0d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 12: Remove intermittent WPT expectations r=necko-reviewers,jesup\n\nDrop the [PASS, FAIL] and [OK, ERROR] allowances for streaming upload\nsubtests on mac and android, now that the preceding parts make them pass\nreliably.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325150\n", "files": ["testing/web-platform/meta/fetch/api/redirect/redirect-upload.h2.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-init-contenttype.any.js.ini", "testing/web-platform/meta/fetch/api/request/request-init-stream.any.js.ini", "testing/web-platform/meta/fetch/range/general.any.js.ini", "testing/web-platform/meta/fetch/range/general.window.js.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-event.https.h2.html.ini"], "git_node": "20ef003931df3555e3428c07936df4c7530a0d5a", "git_parents": ["c98056bddfd312899ba1330963072f8b8f052ee0"], "node": "f12e0adaffbd54d06d6d6fff6f68930526229fd8", "parents": ["527e880218b1de69be5cda5739dbc84af58f9c48"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 13: Test that a failed Request construction leaves the stream alone r=necko-reviewers,jesup\n\nExtracting a body does not read a ReadableStream, so a constructor that\nthrows for a missing duplex must leave the stream neither locked nor\ndisturbed and still usable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325152\n", "files": ["testing/web-platform/mozilla/meta/fetch/api/request/__dir__.ini", "testing/web-platform/mozilla/tests/fetch/api/request/request-init-stream-not-disturbed.any.js", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-cors.h2.any.js"], "git_node": "df998b8db9b8d2199c7eecbea9c99cf02181203b", "git_parents": ["20ef003931df3555e3428c07936df4c7530a0d5a"], "node": "0669141fd724717d018f06e64dcc730cb6b3c167", "parents": ["f12e0adaffbd54d06d6d6fff6f68930526229fd8"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 14: Defer Request stream consumption until the body is used r=necko-reviewers,kershaw\n\nConstructing a Request from a ReadableStream acquired a reader immediately,\nlocking the supplied stream and allowing the upload pump to disturb it before\nthe Request was consumed. Leave extraction lazy and start the pump when fetch()\nor a body-consumption method uses the body.\n\nUse an identity TransformStream proxy when inheriting a JS stream from another\nRequest, preserving backpressure with a single consumer. Tee the JS stream only\nfor an explicit clone(). Attach upload cancellation when fetch starts, using\nthat fetch's signal and reason, rather than canceling an unused Request's body.\n\nAdd regression tests for direct reading, deferred consumption and uploads,\ncloning, proxy backpressure, and cancellation with an overridden signal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325839\n", "files": ["dom/bindings/Bindings.conf", "dom/fetch/Fetch.cpp", "dom/fetch/Fetch.h", "dom/fetch/FetchStreamReader.cpp", "dom/fetch/FetchStreamReader.h", "dom/fetch/Request.cpp", "dom/fetch/Request.h", "testing/web-platform/mozilla/tests/fetch/api/request/request-init-stream-lazy.any.js", "testing/web-platform/mozilla/tests/fetch/api/request/request-init-stream-not-disturbed.any.js", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-lazy.h2.any.js"], "git_node": "c50227a777c3e06789216c404d7857fce1b4ac74", "git_parents": ["df998b8db9b8d2199c7eecbea9c99cf02181203b"], "node": "659e17d907606068a0f4fdbbec8280607e8dfd71", "parents": ["0669141fd724717d018f06e64dcc730cb6b3c167"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1594633 - Part 15: Propagate streaming upload state to socket-process transactions r=necko-reviewers,kershaw\n\nHttpTransactionParent inherited a no-op streaming-body setter, so socket-side\ntransactions treated lengthless uploads as empty bodies. Carry the flag in\nPHttpTransaction::Init and set it before initializing nsHttpTransaction.\nRequire both transaction-shell implementations to provide the setter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325840\n", "files": ["netwerk/protocol/http/HttpTransactionChild.cpp", "netwerk/protocol/http/HttpTransactionChild.h", "netwerk/protocol/http/HttpTransactionParent.cpp", "netwerk/protocol/http/HttpTransactionParent.h", "netwerk/protocol/http/HttpTransactionShell.h", "netwerk/protocol/http/PHttpTransaction.ipdl"], "git_node": "e031c70c09d86431376d7b1c7ba52851638256da", "git_parents": ["c50227a777c3e06789216c404d7857fce1b4ac74"], "node": "5188d70e5c3f476a3166f86a8c17b75a55c94da1", "parents": ["659e17d907606068a0f4fdbbec8280607e8dfd71"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1864152 - Reject an aborted worker fetch with the signal reason r=necko-reviewers,jesup\n\nFetchChild rejected the fetch promise with a bare AbortError, losing the\nreason the AbortSignal was aborted with, so a worker fetch rejected with a\ndifferent value than the equivalent window fetch.\n\nThe reason has to be recovered on the worker thread: OnResponseEnd runs on the\nmain thread and ResponseEndArgs carries only the end reason, not a JS value.\nBoth rejection sites need it, because an abort that races the fetch op is\nreported by the parent as a bare nsresult through __delete__ rather than\nthrough OnResponseEnd.\n\nThis fixes the worker, sharedworker and serviceworker variants of\nfetch/api/abort/general.any.js \"Aborting rejects with abort reason when\naborted after fetch() called\", whose expectations are removed here. The\nstreaming upload tests also assert the exact rejection value in their worker\nvariants.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325153\n", "files": ["dom/fetch/FetchChild.cpp", "dom/fetch/FetchChild.h", "testing/web-platform/meta/fetch/api/abort/general.any.js.ini"], "git_node": "07a19a61ecd78c4720486e920d5aa0fc9aa2425b", "git_parents": ["e031c70c09d86431376d7b1c7ba52851638256da"], "node": "fe1f70b776d7effd77e20d35763ad1a573eb75e3", "parents": ["5188d70e5c3f476a3166f86a8c17b75a55c94da1"], "tags": []}, {"author": "zhuangxiaosen \u003cxiaosen.zhuang@speediance.com\u003e", "branch": "default", "desc": "Bug 2044165 - Remove Debugger.findObjects r=bthrall\n\nThe DevTools do not use findObjects; remove its documentation, tests,\nand implementation.\n\n- docs: findObjects section in js/src/doc/Debugger/Debugger.md and its\n  mirror in devtools/docs/user/debugger-api/debugger/index.md\n- impl: ObjectQuery class, CallData::findObjects(), the JS_DEBUG_FN\n  registration and the method declaration in js/src/debugger/Debugger.cpp\n- tests: the 20 dedicated Debugger-findObjects-*.js tests\n- tests: four regression tests that merely used findObjects as a trigger\n  for assertions in other bugs; their guarded code paths disappear with\n  the API, so they are deleted rather than kept as inert fragments:\n  bug-1103813.js, bug-1110327.js, bug1934430.js, gc/bug-1620209.js\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326369\n", "files": ["devtools/docs/user/debugger-api/debugger/index.md", "js/src/debugger/Debugger.cpp", "js/src/doc/Debugger/Debugger.md", "js/src/jit-test/tests/debug/Debugger-findObjects-01.js", "js/src/jit-test/tests/debug/Debugger-findObjects-02.js", "js/src/jit-test/tests/debug/Debugger-findObjects-03.js", "js/src/jit-test/tests/debug/Debugger-findObjects-04.js", "js/src/jit-test/tests/debug/Debugger-findObjects-05.js", "js/src/jit-test/tests/debug/Debugger-findObjects-06.js", "js/src/jit-test/tests/debug/Debugger-findObjects-07.js", "js/src/jit-test/tests/debug/Debugger-findObjects-08.js", "js/src/jit-test/tests/debug/Debugger-findObjects-09.js", "js/src/jit-test/tests/debug/Debugger-findObjects-10.js", "js/src/jit-test/tests/debug/Debugger-findObjects-11.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-basic.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-ccwProto.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-ctor-getter.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-dead-wrapper.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-incompatible.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-nullProto.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-proxy.js", "js/src/jit-test/tests/debug/Debugger-findObjects-classObj-userClass.js", "js/src/jit-test/tests/debug/Debugger-findObjects-fuzzing.js", "js/src/jit-test/tests/debug/bug-1103813.js", "js/src/jit-test/tests/debug/bug-1110327.js", "js/src/jit-test/tests/debug/bug1934430.js", "js/src/jit-test/tests/gc/bug-1620209.js"], "git_node": "2d089570c3dda4ae4ca700eafb62937c14267b17", "git_parents": ["07a19a61ecd78c4720486e920d5aa0fc9aa2425b"], "node": "0f55bf923d47c24ca41ea6209006671d9758c7dd", "parents": ["fe1f70b776d7effd77e20d35763ad1a573eb75e3"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072381 - Initialize ML performance utilities with context r=valentinp\n\nThis commit initializes MLPerfTestUtils with the calling test's context so that\nperformance scenarios no longer pass their logger and assertions on each invocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326298\n", "files": ["browser/components/genai/tests/browser/browser_link_preview_perf.js", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/browser_smart_tab_grouping_perf.js", "browser/components/urlbar/tests/browser-ml/browser_quicksuggest_ml_perf.js", "browser/components/urlbar/tests/browser-ml/browser_urlbar_semantic_history_perf.js", "browser/extensions/formautofill/test/browser/performance/browser_formautofill_ml_perf.js", "toolkit/components/ml/ml.d.ts", "toolkit/components/ml/tests/MLPerfTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_perf_test_utils.js"], "git_node": "d8d45bf6721a136db8732f716abd4a68368aee5c", "git_parents": ["2d089570c3dda4ae4ca700eafb62937c14267b17"], "node": "9fb066c9085e4b17d47f28859e7b096c9fe5e3b8", "parents": ["0f55bf923d47c24ca41ea6209006671d9758c7dd"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2065250 - Fix blurry Google Lens camera preview by matching preview aspect ratio with a tolerance r=android-reviewers,rebecatudor273\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320241\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraFragmentTest.kt"], "git_node": "88a09b7c4ec2abb2386a7b3ea71e6f69a27625e0", "git_parents": ["d8d45bf6721a136db8732f716abd4a68368aee5c"], "node": "a71c85bf6164b92f87ca3027078156390715aee6", "parents": ["9fb066c9085e4b17d47f28859e7b096c9fe5e3b8"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2065250 - Prefer a QR analysis size matching the Google Lens preview aspect ratio r=android-reviewers,rebecatudor273\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320242\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraFragmentTest.kt"], "git_node": "46b53b219d6b1b458ceb83b314fd39838f553a2e", "git_parents": ["88a09b7c4ec2abb2386a7b3ea71e6f69a27625e0"], "node": "bd2a405bf46ce7a9b1051c341ae24b51a0a4bc43", "parents": ["a71c85bf6164b92f87ca3027078156390715aee6"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2065250 - Only target the QR stream in QR mode and keep the Lens preview buffer size r=android-reviewers,rebecatudor273\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320243\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraFragmentTest.kt"], "git_node": "2c11bb3a624ccaf527905880dd3df10f564efdae", "git_parents": ["46b53b219d6b1b458ceb83b314fd39838f553a2e"], "node": "d304bb509882ed3efcae3cfcccbb0d69eb7c97c0", "parents": ["bd2a405bf46ce7a9b1051c341ae24b51a0a4bc43"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2059230 r=device-api-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323614\n", "files": ["dom/webserial/PSerialPort.ipdl", "dom/webserial/SerialPort.cpp", "dom/webserial/SerialPort.h", "dom/webserial/SerialPortParent.cpp", "dom/webserial/SerialPortParent.h", "dom/webserial/tests/browser/browser_webserial_permission_revoke.js", "dom/webserial/tests/browser/browser_webserial_sharing_icon.js"], "git_node": "808830dead0a21be610653e0928f1cefe24c4565", "git_parents": ["2c11bb3a624ccaf527905880dd3df10f564efdae"], "node": "61edeaf7f10417244109b065a00f31be4dccdd80", "parents": ["d304bb509882ed3efcae3cfcccbb0d69eb7c97c0"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2068142 - Skip the about:preferences load in check_homepage when there is no UI to verify. r=bsmth\n\nFive of the seven loads in browser_policy_set_homepage.js re-asserted