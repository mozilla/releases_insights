0015.\n\nRevert \"Bug 2068624 - Remove unused Legacy Telemetry environment.settings pieces r=TravisLong\"\n\nThis reverts commit a34a04ddefbf8ff25ee7f7333934b9fc47601b55.\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment_search.js"], "git_node": "c467928188ba8ede05fdb40b68961f470fbeb2e5", "git_parents": ["fbae83314c244b9f86dd88c76234b1d7b3ae13d2"], "node": "02ad9ed63162159e4e1583659886c13dd6e552c8", "parents": ["bcd7ed5019fbf0881d3b174f7f01f1a250b06ad0"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068624 - Remove unused environment.build fields r=TravisLong\"\n\nThis reverts commit 96ff9e8d845eb6783ad4897960d86eab1c286144.\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs"], "git_node": "70c19d552196c8ec8277f80e4465398c6c9cba85", "git_parents": ["c467928188ba8ede05fdb40b68961f470fbeb2e5"], "node": "e52c140b7e063ec10df0fd79cfeabded1a3af0bb", "parents": ["02ad9ed63162159e4e1583659886c13dd6e552c8"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2070160 [wpt PR 62406] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323179, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=323179 (#62406)\n--\n\nwpt-commits: 5c0dc39b95cba49532a6c593ef04d078fb21a8c8\nwpt-pr: 62406\n", "files": ["testing/web-platform/tests/html/dom/documents/resource-metadata-management/load-event-after-readystatechange-starts-load.html"], "git_node"