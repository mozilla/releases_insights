n_silencing.js", "browser/base/content/test/webrtc/browser_stop_sharing_button.js", "browser/base/content/test/webrtc/browser_stop_streams_on_indicator_close.js", "browser/base/content/test/webrtc/browser_tab_switch_warning.js", "browser/base/content/test/webrtc/browser_webrtc_hooks.js", "browser/base/content/test/webrtc/get_user_media.html", "browser/base/content/test/webrtc/get_user_media2.html", "browser/base/content/test/webrtc/get_user_media_in_frame.html", "browser/base/content/test/webrtc/get_user_media_in_xorigin_frame.html", "browser/base/content/test/webrtc/gracePeriod/browser.toml", "browser/base/content/test/webrtc/head.js", "browser/base/content/test/webrtc/peerconnection_connect.html", "browser/base/content/test/webrtc/single_peerconnection.html", "python/l10n/fluent_migrations/bug_2071753_container_menu_accesskeys.py", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs"], "git_node": "b0d13127044c5c0a57d2a8e821efa4b1f8875a78", "git_parents": ["1218053f45174bc172a464ed9038c38d55171518", "2d44bba4362947e140c312de517d8d95be3bf211"], "node": "59e5bf2b685b88bba61775134937f5e45939a0d5", "parents": ["c6aabd3b2dc8ed1a9eed52d117b97ec066bc2fdb", "3aa32e58a70bb5c7a62c2cb759d408705f26e8f0"], "tags": []}, {"author": "Abel Kalu \u003c59095867+BlessedOneKobo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067180 - Remove unused WebsiteFilter module getter from browser.js. r=firefox-desktop-core-reviewers ,frontend-codestyle-reviewers,mossop\n\nWe are removing WebsiteFilter from the module getters declared in browser/base/content/browser.js\nbecause it is no longer used. It was initially added to disable \"Save Link As\" for links blocked\nby the WebsiteFilter enterprise policy. That check was moved to nsContextMenu.sys.mjs which\nimports WebsiteFilter itself\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322573\n", "files": ["browser/base/content/browser.js", "browser/base/content/browser.js.globals"], "git_node": "0ddf76e37ee1a3c6b3a0fb3321e1bde49005106e", "git_parents": ["b0d13127044c5c0a57d2a8e821efa4b1f8875a78"], "node": "287621fc46bf9b510ba261e5c9fd603dfc13283a", "parents": ["59e5bf2b685b88bba61775134937f5e45939a0d5"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2063678 - Allow NVIDIA CUDA/UVM init in the RDD sandbox for Vulkan video decode. r=jld,sandbox-reviewers\n\nNewer FFmpeg (e7976dd12f, 29 Aug 2026) enables VK_NV_optical_flow on every vkCreateDevice. The loader then loads NVIDIA's ICD (libGLX_nvidia.so.0), which pulls libcuda. CUDA init in sandboxed RDD needs timerfd, an abstract AF_UNIX bind for cuda-uvmfd-*, EEXIST on existing /dev/char nvidia symlinks, and a few NVIDIA/sysfs reads. Allow that bind in-process for the cuda-uvmfd- prefix and add the matching RDD seccomp/broker grants so device creation can succeed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325986\n", "files": ["security/sandbox/linux/SandboxFilter.cpp", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": "19d6aca246084c45af2c738461425efe5b5c470f", "git_parents": ["0ddf76e37ee1a3c6b3a0fb3321e1bde49005106e"], "node": "11aced3104821ff2df7c5e0762e6033f38b9df49", "parents": ["287621fc46bf9b510ba261e5c9fd603dfc13283a"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069131 - Rename browser/base/content/test general, about, webrtc, popups and tabPrompts directories to match eslint-test-paths conventions r=frontend-codestyle-reviewers,webcompat-reviewers,fxview-reviewers,tabbrowser-reviewers,places-reviewers,urlbar-reviewers,ai-platform-reviewers,timhuang,dao,mossop,twisniewski,nsharpley,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324575\n", "files": [".prettierignore", "browser/base/content/moz.build", "browser/base/content/test/about/basic_auth_route.sjs", "browser/base/content/test/about/blank_pa