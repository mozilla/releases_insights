"}, "45385": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging bd396a1cf6b78bbba84520688be5dc9118e6bf4f with FIREFOX_140_17_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "fc516d2117d8313e2df4f42bea71cbfd6edce8bf", "git_parents": ["6860693b6fe005331d8a5d0880ed9981ffde65b3"], "node": "189a085df1ff5b0d041f77a584eb9f1f7136044f", "parents": ["2981cf3b1d3f5ff2fa940554e0faea2d2db15073"], "tags": []}], "date": 1790104776, "git_changesets": ["fc516d2117d8313e2df4f42bea71cbfd6edce8bf"], "user": "ffxbld@lando.moz.tools"}, "45386": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging f5bb60e996cf17c98a91164bc787d32566f036b5 with FIREFOX_153_4_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "158e5076b88609556edd6cbe5580a1d3062d7b01", "git_parents": ["fc516d2117d8313e2df4f42bea71cbfd6edce8bf"], "node": "c852acf37d964d2bd28a222fbb9982ed0c600649", "parents": ["189a085df1ff5b0d041f77a584eb9f1f7136044f"], "tags": []}], "date": 1790105325, "git_changesets": ["158e5076b88609556edd6cbe5580a1d3062d7b01"], "user": "ffxbld@lando.moz.tools"}, "45387": {"changesets": [{"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072480 - Move the default value comment in `nsRange::DoSetRange` onto its own line so clang-format can fit the parameter list r=masayuki DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328044\n", "files": ["dom/base/nsRange.cpp"], "git_node": "3ce1f2ac0b7d9230a698c794a8ffae69025d3e01", "git_parents": ["f9a73919fe039381777330403e5f94918735a5e7"], "node": "199e9729a7b50d4f72cd98063828946dcaeeaf10", "parents": ["e089cf67542197b4bea0e63d991a3d1d362e4b0a"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073969. r=gfx-reviewers,tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328048\n", "files": ["dom/canvas/OffscreenCanvas.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.h"], "git_node": "91b817d70c381be381cfc282065c5fea86a605bb", "git_parents": ["3ce1f2ac0b7d9230a698c794a8ffae69025d3e01"], "node": "834e72979e0d5b8ba32a3ed1cb0ed338624ec47e", "parents": ["199e9729a7b50d4f72cd98063828946dcaeeaf10"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1997056 - Round border-image-slice values to app units instead of truncating. r=layout-reviewers,gfx-reviewers,tnikkel\n\nTwo percentage slices that add up to exactly 100% of a dimension with an odd\nnumber of app units each truncated down, leaving a 1 app unit middle band.\nDrawBorderImage treated that band as non-empty and stretched it across the\nfull left/right (or top/bottom) edge segments, so the segments appeared and\ndisappeared as a transitioning height crossed odd and even app unit values.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328033\n", "files": ["layout/painting/nsCSSRenderingBorders.cpp", "layout/reftests/border-image/border-image-slice-odd-dimension-ref.html", "layout/reftests/border-image/border-image-slice-odd-dimension.html", "layout/reftests/border-image/reftest.list"], "git_node": "7dbebbb851082c5af7b26ff78dff5ae2343a10b2", "git_parents": ["91b817d70c381be381cfc282065c5fea86a605bb"], "node": "d0cf925f3b62586a1e549b071c191d949fa6098d", "parents": ["834e72979e0d5b8ba32a3ed1cb0ed338624ec47e"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 2f8bdf4011d33232d21aebbe3f895895924f7dd7\naf -\u003e 2f8bdf4011d33232d21aebbe3f895895924f7dd7\nan -\u003e 2f8bdf4011d33232d21aebbe3f895895924f7dd7\nar -\u003e 2f8bdf4011