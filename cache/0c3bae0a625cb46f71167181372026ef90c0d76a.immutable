ath-path-attr-pathlength-ignored.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-rtl-ref.html", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-rtl.html", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-side-right-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-side-right-ref.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-side-right.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-truncated-coordinate-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-truncated-coordinate.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-two-textpaths-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-two-textpaths-ref.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-two-textpaths.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-user-space-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-user-space-ref.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-user-space.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-whitespace-fallback-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-path-attr-whitespace-fallback.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-percentage-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-percentage-ref.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-percentage.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-positive-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-positive-ref.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-positive.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-zero-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-zero-ref.svg", "testing/web-platform/tests/svg/text/reftests/textpath-pathlength-zero-offset-zero.svg", "testing/web-platform/tests/svg/text/scripted/textpath-path-attr-dynamic.html", "testing/web-platform/tests/svg/text/scripted/textpath-path-attr-idl.html", "testing/web-platform/tests/svg/text/scripted/textpath-path-attr-moveto-only.html", "testing/web-platform/tests/svg/text/scripted/textpath-path-attr-positions.html", "testing/web-platform/tests/svg/text/scripted/textpath-path-attr-smil.tentative.html", "testing/web-platform/tests/svg/text/scripted/textpath-path-attr-startoffset.html", "testing/web-platform/tests/svg/text/scripted/textpath-pathlength-zero-startoffset.html"], "git_node": "8f9c4526ce263196522e69e62e614e67a68df778", "git_parents": ["6b25220786333d6ea6a5675a7f0d53bb31ea97d9"], "node": "b8a5db1fcdf92c00c4461c0a809c25ac2826ebf4", "parents": ["d8844f492989e21550c57cc7159f2cf661f90b4c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071765 [wpt PR 62667] - Update wpt metadata, a=testonly\n\nwpt-pr: 62667\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/text/reftests/textpath-pathlength-zero-offset-percentage.svg.ini", "testing/web-platform/meta/svg/text/scripted/textpath-pathlength-zero-startoffset.html.ini"], "git_node": "9a72a6b8b3792b12d571912bdf78da0b4dd29787", "git_parents": ["8f9c4526ce263196522e69e62e614e67a68df778"], "node": "9333c82ec2b3d19574bbfe0e7f2ffa4cf091bb76", "parents": ["b8a5db1fcdf92c00c4461c0a809c25ac2826ebf4"], "tags": []}, {"author": "Jose Dapena Paz \u003cjdapena@igalia.com\u003e", "branch": "default", "desc": "Bug 2071523 [wpt PR 62637] - ContainerTiming: report the largest element as lastPaintedElement, a=testonly\n\nAutomatic update from web-platform-tests\nContainerTiming: report the largest element as lastPaintedElement\n\nlastPaintedElement named whichever element happened to be the last one\nwhose paint grew the container's painted area. That is an artifact of the\norder paints are processed in, not a useful answer to what is driving\nupdates on a large container root.\n\nReport the largest element painted since the previous entry instead,\nselected by its own clipped area, the way largest contentful paint selects\nits candidates. Ties keep the earlier element, and the running maximum\nresets on emission, so every entry reports the largest element painted\nsince the previous one.\n\nSelecting instead by the area each element newly contributed to the\ncontainer was the other option, and is deliberately not used: the overlap\nbetween two elements would go to whichever happened to paint first, which\nvaries both within a frame and across loads of the same page. An element's\nown area does not.\n\nNomination happens before the region-containment check, so content painting\nentirely inside the region painted so far can still be reported: it is a\ncontentful paint, it just grows nothing, so on its own it emits no entry.\nNothing re-nominates on a repaint, which is what makes that safe: each\nelement reaches container timing only once per content it paints, images\nbeing deduplicated per (layout object, image resource) and text per\naggregating layout object.\n\nDiscussed in https://github.com/WICG/container-timing/issues/53, which asks\nfor exactly this and additionally suggests restricting candidates to the\nelements that do grow the painted region. That restriction is deliberately\nnot applied, so that a single rule - largest by its own area - covers both\nthis per-entry maximum and the container's lifetime maximum added in a\nlater commit. The lifetime largest is then the maximum of the per-entry\nones, which it would not be if the two used different candidate sets.\n\nBug: 489959278\nChange-Id: I4d0e707670b6cbdb56599b51ccee2bbf0412ce34\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8274795\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Jos\u00e9 Dapena Paz \u003cjdapena@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1697075}\n\n--\n\nwpt-commits: 3d19c0c7bfa17583635a04bd06aab5c03b2f971c\nwpt-pr: 62637\n", "files": ["testing/web-platform/tests/container-timing/tentative/containertiming-largest-painted-element-own-area.html", "testing/web-platform/tests/container-timing/tentative/containertiming-largest-painted-element.html", "testing/web-platform/tests/container-timing/tentative/containertiming-two-overlapping-imgs.html"], "git_node": "a3f1147d137674adef0ce652e41375c56d2c22fa", "git_parents": ["9a72a6b8b3792b12d571912bdf78da0b4dd29787"], "node": "e4285304aaf0ec1a93d142fcca195696dd981f9b", "parents": ["9333c82ec2b3d19574bbfe0e7f2ffa4cf091bb76"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071523 [wpt PR 62637] - Update wpt metadata, a=testonly\n\nwpt-pr: 62637\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/container-timing/tentative/containertiming-largest-painted-element-own-area.html.ini"], "git_node": "b8fb63cee2b04a2d8a0b8468e765f4706fbe03c9", "git_parents": ["a3f1147d137674adef0ce652e41375c56d2c22fa"], "node": "21ff3a1cd505182d1a741b346c755ea774676169", "parents": ["e4285304aaf0ec1a93d142fcca195696dd981f9b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071976 - [wpt-sync] Update web-platform-tests to 3d19c0c7bfa17583635a04bd06aab5c03b2f971c, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 3d19c0c7bfa17583635a04bd06aab5c03b2f971c\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/async-unsanitized-plaintext-formats-write-read.tentative.https.html.ini", "testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini", "testing/web-platform/meta/css/css-animations/animation-duration-infin