.com\u003e", "branch": "default", "desc": "Bug 2074374 - Main VPN panel is broken when Light theme and HCM are active - r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328559\n", "files": ["browser/components/ipprotection/content/ipprotection-status-box.css"], "git_node": "7de39e901693dc36fce22cb6fe21e2f4aa152778", "git_parents": ["1f7afe67a4b21ab00e705ae41b4cd8f4353af905"], "node": "5932af3b8cc2e02cc624bc6f494f2f8d95d14fd0", "parents": ["a6437d99ead2ce4600bad48df34dd64ba24e6d7b"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072006 - PBW Fade in animation. r=omc-reviewers,desktop-theme-reviewers,akulyk,emcminn\n\nThe redesigned private browsing page reveals its components one at a time: the\nkit animation, then the mask and \"You're off the record\" together, the\nsub-header, the search bar, and the \"Private window basics\" link. An\n`intro-playing` class drives it, so it is gated on the same once-per-profile\nflag and reduced-motion check as the kit animation. Elements are hidden with\n`visibility`, so nothing is clickable or focusable before it appears.\n\nNo pb_newtab message is served while the intro plays, without spending the\nmessage's frequency allocation.\n\nTo test:\n\n- Set `browser.privateWindowRedesign.enabled` to true\n- Set `browser.privatebrowsing.introAnimationShown` to false\n- Open a private window. Reset the second pref to replay it\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327513\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.js", "browser/components/privatebrowsing/content/private-browsing-mask-intro.css", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_kit_intro.js", "browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css"], "git_node": "bdff6e352b7e600395ba857f7dc48715f55dc9dd", "git_parents": ["7de39e901693dc36fce22cb6fe21e2f4aa152778"], "node": "6ad459bf50654caa3110528ad8a0a66b03f88b46", "parents": ["5932af3b8cc2e02cc624bc6f494f2f8d95d14fd0"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2061051 - AITab List Component and UI tweaks - r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327538\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-list/aitab-list.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-list/aitab-list.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-list/aitab-list.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js"], "git_node": "e2d73cc04ce1905a2454a97b2db0a5aebf66c2f5", "git_parents": ["bdff6e352b7e600395ba857f7dc48715f55dc9dd"], "node": "a981aef08f513372ea09eb68e420176e7ca7ba98", "parents": ["6ad459bf50654caa3110528ad8a0a66b03f88b46"], "tags": []}, {"author": "virsworld \u003cvirpatel71@gmail.com\u003e", "branch": "default", "desc": "Bug 2073619 - Remove unused PKCS#11 parameters support from LoadUserModuleAt. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328298\n", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp"], "git_node": "bb0c68bacc87056bc4da686acf1322387a0a8a19", "git_parents": ["e2d73cc04ce1905a2454a97b2db0a5aebf66c2f5"], "node": "a0f2d4eb5d2e1cd476613c23f51fcd7989041aff", "parents": ["a981aef08f513372ea09eb68e420176e7ca7ba98"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2074033: Override shared application data directories in xpcshell tests. r=ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327775\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "8152b5d315b8d857f9fa539126845e37704265cc", "git_parents": ["bb0c68bacc87056bc4da686acf1322387a0a8a19"], "node": "347e5327d26b7711382b6eb812fbfb4314b18b21", "parents": ["a0f2d4eb5d2e1cd476613c23f51fcd7989041aff"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074478 - Don't prefetch for speculative candidate whose URI differs from the current document only by the fragment. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328226\n", "files": ["dom/base/SpeculationRules.cpp", "testing/web-platform/meta/speculation-rules/prefetch/fragment.https.html.ini"], "git_node": "6543439deea5a4bee8ab0af5f267e8818ca9f966", "git_parents": ["8152b5d315b8d857f9fa539126845e37704265cc"], "node": "454cd8b14b21700564f33704a7d92b89e6550572", "parents": ["347e5327d26b7711382b6eb812fbfb4314b18b21"], "tags": []}, {"author": "Artem Popov \u003cart@artfwo.net\u003e", "branch": "default", "desc": "Bug 2063725 - Fix the empty reason reported for failed IP Protection activations r=ip-protection-reviewers,sstreich\n\nFollow-up to https://phabricator.services.mozilla.com/D327753\n\nNightly 20260922 shows 18 of 39 error events blank:\n\nhttps://sql.telemetry.mozilla.org/queries/127291\n\nI think the problem here is that updateState() runs first on the non-active path and sets that field to null, so a lot of failed activations reported an empty reason. This captures the error type in a local variable instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328433\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs"], "git_node": "821f12424a01ed0e295ad42582a57ef354e778ea", "git_parents": ["6543439deea5a4bee8ab0af5f267e8818ca9f966"], "node": "36e86d8a88f4911c5bc89ca1df03da419b296a65", "parents": ["454cd8b14b21700564f33704a7d92b89e6550572"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068819 - extend the probe 'media.capture_stream_usage'. r=media-playback-reviewers,chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328211\n", "files": ["dom/media/metrics.yaml"], "git_node": "cff09884cb15f7ba00b8a0a2e496778b517260b2", "git_parents": ["821f12424a01ed0e295ad42582a57ef354e778ea"], "node": "1525655be05a163c5dbbf694f2be4cd302c64fc7", "parents": ["36e86d8a88f4911c5bc89ca1df03da419b296a65"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067571 - add a process type restriction for extension-specific RP ID claims. r=robwu,mfarrell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326343\n", "files": ["dom/webauthn/WebAuthnUtil.cpp", "toolkit/components/extensions/test/mochitest/test_ext_webauthn.html"], "git_node": "57fb9c11807bec16bc80c182bb0b5b987cfac4a5", "git_parents": ["cff09884cb15f7ba00b8a0a2e496778b517260b2"], "node": "d57309b1c4bcea22ddab0b2dcd47b7434d26431f", "parents": ["1525655be05a163c5dbbf694f2be4cd302c64fc7"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2069536: Allow Firefox to start if the profile data directories are inaccessible. r=jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326501\n", "files": ["toolkit/profile/metrics.yaml", "toolkit/profile/nsToolkitProfileService.cpp", "toolkit/profile/nsToolkitProfileService.h", "toolkit/profile/test/xpcshell/test_unreadable_ini.js", "toolkit/profile/test/xpcshell/test_unreadable_ini_createprofile.js", "toolkit/profile/test/xpcshell/test_unreadable_ini_no_profile.js", "toolkit/profile/test/xpcshell/test_unreadable_ini_p.js", "toolkit/profile/test/xpcshell/test_unreadable_ini_profilemanager.js", "toolkit/profile/test/xpcshell/xpcshell.toml"], "git_node": "fdcdc272da9de85178ff5a50e661769b10f42b9c", "git_parents": ["57fb9c11807bec16bc80c182bb0b5b987cfac4a5"], "node": "89d3425637891f8d883bdaab0ee204628ff34531", "parents": ["d57309b1c4bcea22ddab0b2dcd47b7434d26431f"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2066484 - Connect Conversation to its store and set security properties in AITab - r=omarg,rrando\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326022\n", "files": ["browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js", "browser/components/aiwindow/models/tests/browser/browser_conversation.js", "browser/components/aiwindow/ui/test/xpcshell/test_ConversationStore.js"], "git_node": "60c585886e0fda4194915daf8ff72d57199c057d", "git_parents": ["fdcdc272da9de85178ff5a50e661769b10f42b9c"], "node": "ea1aed3d2a247c663693587b3072aa19a24e4b86", "parents": ["89d3425637891f8d883bdaab0ee204628ff34531"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072730 - Parse data member of declarative web push. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328185\n", "files": ["dom/push/Declarative.cpp", "dom/push/rust/src/declarative_push.rs", "testing/web-platform/mozilla/tests/push-api/declarative.https.any.js"], "git_node": "cde9fa43cb66f266fefb541280c2908a9262999a", "git_parents": ["60c585886e0fda4194915daf8ff72d57199c057d"], "node": "3fb9b08e1cb54331be61cfe7b8f6d659efaf7872", "parents": ["ea1aed3d2a247c663693587b3072aa19a24e4b86"], "tags": []}, {"author": "Corey Bryant \u003ccorey@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2074917 - Enable missing depends epoch for all thunderbird l10n packages. r=releng-reviewers,jcristau,dandarnell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328576\n", "files": ["python/mozbuild/mozbuild/repackaging/deb.py"], "git_node": "fde5c4a9ea3eb6794192a9436c1acccda3121ae8", "git_parents": ["cde9fa43cb66f266fefb541280c2908a9262999a"], "node": "0a2cb48553730d1cc23a828bf9fe76e321050632", "parents": ["3fb9b08e1cb54331be61cfe7b8f6d659efaf7872"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2060057 - Move ThreadSafeCodeBlockMap to WasmProcess.h. r=jseward\n\nPure code motion, so that a following patch can add an inlineable accessor for\nthe process-wide map. The method bodies move to WasmProcess.cpp to keep\nWasmProcess.h from needing the complete CodeBlock type.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320539\n", "files": ["js/src/wasm/WasmCode.h", "js/src/wasm/WasmProcess.cpp", "js/src/wasm/WasmProcess.h"], "git_node": "992bc2d0c4eb7db777a70ebcd7f233ccb07124f4", "git_parents": ["fde5c4a9ea3eb6794192a9436c1acccda3121ae8"], "node": "a08ecf21b0845ed322aae3e5552093eddf8d92ad", "parents": ["0a2cb48553730d1cc23a828bf9fe76e321050632"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2060057 - Update wasm::CodeExists inside the code block map's critical section. r=jseward\n\nRegisterCodeBlock and UnregisterCodeBlock updated wasm::CodeExists after the\nmap's lock was released, so a concurrent register and unregister could leave the\nflag false while code blocks were still registered.\n\nReplace the global with an `empty_` member of ThreadSafeCodeBlockMap, maintained\nby insert() and remove() while mutatorsMutex_ is held, and make\nwasm::CodeExists() an inline accessor for the process-wide map.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320540\n", "files": ["js/src/jit/arm/Simulator-arm.cpp", "js/src/jit/arm/Simulator-arm.h", "js/src/jit/arm64/vixl/Simulator-vixl.h", "js/src/jit/loong64/Simulator-loong64.h", "js/src/jit/mips64/Simulator-mips64.h", "js/src/jit/riscv64/Simulator-riscv64.h", "js/src/wasm/WasmCodegenTypes.cpp", "js/src/wasm/WasmProcess.cpp", "js/src/wasm/WasmProcess.h", "js/src/wasm/WasmSerialize.cpp"], "git_node": "bee0963d9c82ded81ba314cf64956038cc83f0aa", "git_parents": ["992bc2d0c4eb7db777a70ebcd7f233ccb07124f4"], "node": "382838ef52f0d55760135fcf63983f20f85b92cf", "parents": ["a08ecf21b0845ed322aae3e5552093eddf8d92ad"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2061439 - Install ExtensionSettings add-ons from update_url when install_url is absent r=joporter,extension-reviewers,rpl\n\nEntries with only update_url fell through to the AMO lookup, which fails for a\nself-hosted add-on. Resolve the XPI from the update manifest instead, and drop\nany update_url naming Firefox's own update service, which also overrides the\nmanifest and default URLs for later update checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322423\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_extensionsettings_install_without_url.js", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs"], "git_node": "278d47d09212d72abd123c1ddf98187292df290f", "git_parents": ["bee0963d9c82ded81ba314cf64956038cc83f0aa"], "node": "326845f877fab09eebe54608d8bb725ce74d1710", "parents": ["382838ef52f0d55760135fcf63983f20f85b92cf"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074920 - Explicitly use mozilla/dom/Link.h in #include statements to avoid ambiguity with link.h on case-insensitive filesystem. r=firefox-svg-reviewers,dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328578\n", "files": ["docshell/base/nsDocShellTreeOwner.cpp", "dom/base/Link.cpp", "dom/base/nsContentSink.cpp", "dom/mathml/MathMLElement.h", "dom/svg/SVGAElement.h"], "git_node": "dc247697da5b712c525cbc0b4be7a76ce02fd390", "git_parents": ["278d47d09212d72abd123c1ddf98187292df290f"], "node": "87ef458ae1d0b72fa961b43c31b94b31e66c1542", "parents": ["326845f877fab09eebe54608d8bb725ce74d1710"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072624 - Add a websocket connection to check for notifications.r=aborondo\n\nThe core loop now checks if Firefox is running, and if it isn't, it starts a websocket connection to the configured push server. When it receives a notification message it launches Firefox to display the push notification and then waits, checking every minute if Firefox is still running before reconnecting to the push server.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327297\n", "files": ["Cargo.lock", "toolkit/mozapps/pushnotificationhelper/Cargo.toml", "toolkit/mozapps/pushnotificationhelper/src/main.rs", "toolkit/mozapps/pushnotificationhelper/src/preferences.rs", "toolkit/mozapps/pushnotificationhelper/src/pushconnection.rs", "toolkit/mozapps/pushnotificationhelper/src/widestring.rs"], "git_node": "d68c04e838e6937e378b77136bb76103effc5783", "git_parents": ["dc247697da5b712c525cbc0b4be7a76ce02fd390"], "node": "aa6bdac9581edbb6341e65bc3d68d11a79d2573d", "parents": ["87ef458ae1d0b72fa961b43c31b94b31e66c1542"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 780014 - Add startup_session_availability telemetry to help answer was there anything to restore? r=sessionstore-reviewers,sthompson\n\n- noFilesFound now also includes no legacy .js files found\n- Log and record telemetry for which session files we examined (stat-ing them all would regress startup performance)\n- New xpcshell test for SessionFile.read to verify it gives back the expected results given the files in the profile\n- New marionette test to check the telemtry for clean session restore and restore_session_once behavior is as expected\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326800\n", "files": ["browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/SessionStartup.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_session_availability.py", "browser/components/sessionstore/test/unit/test_session_availability.js", "browser/components/sessionstore/test/unit/xpcshell.toml"], "git_node": "e6cf756b98f864ac2ace3b3cbd00d8f49837413e", "git_parents": ["d68c04e838e6937e378b77136bb76103effc5783"], "node": "ec7c732f91372e83f7b453af596bbadf1b6ba15e", "parents": ["aa6bdac9581edbb6341e65bc3d68d11a79d2573d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074625 - Avoid updating properties with retargeted animation. r=firefox-style-system-reviewers,dshin\n\nThis is the low risk fix. I think we need to figure out whether we even\nwant to use that retargeted effect at all? But that seems like a\nfollow-up bug.\n\nRule tree changes are just assertions that catch this earlier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328567\n", "files": ["layout/style/nsAnimationManager.cpp", "servo/components/style/rule_tree/core.rs", "testing/web-platform/tests/web-animations/crashtests/keyframe-effect-cross-doc-target.html"], "git_node": "d4dd520d145bbd1d1ee300e2570c446e83faec9c", "git_parents": ["e6cf756b98f864ac2ace3b3cbd00d8f49837413e"], "node": "fad6d3c4978a7139e7e88daf76213ad4017adab9", "parents": ["ec7c732f91372e83f7b453af596bbadf1b6ba15e"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074373 - Don't crash in nsSHistory::Reload if mIndex = -1. r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328100\n", "files": ["docshell/shistory/nsSHistory.cpp", "docshell/test/navigation/browser.toml", "docshell/test/navigation/browser_ghistorymaxsize_is_0.js", "docshell/test/navigation/file_never_responds.sjs"], "git_node": "097875cf577d612b8e07a72d0b15dd41d3a4e1e4", "git_parents": ["d4dd520d145bbd1d1ee300e2570c446e83faec9c"], "node": "eb32398b7beebe932336bbf2198e12babc56436b", "parents": ["fad6d3c4978a7139e7e88daf76213ad4017adab9"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051182 - Correct ARIA attributes and selection logic for the sidebar launcher buttons. r=sidebar-reviewers,mkennedy,nsharpley\n\n- Flatten the a11y tree of the tablist items (History, Synced Tabs, etc.), and give them a role of \"tab\" rather than \"button\".\n- Ensure that the button linked to the active panel receives focus when the \u003cbutton-group\u003e is focused.\n- Fix aria-label attributes so they describe the panel (i.e. \"History\"), rather than the action (i.e. \"Open History\").\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326504\n", "files": ["browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/SidebarTestUtils.sys.mjs", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "testing/mochitest/tests/SimpleTest/AccessibilityUtils.js", "toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/widgets/moz-button/moz-button.css", "toolkit/content/widgets/moz-button/moz-button.mjs"], "git_node": "796d56970a0e9c66728a9a9fcfa50ff06cfc67bf", "git_parents": ["097875cf577d612b8e07a72d0b15dd41d3a4e1e4"], "node": "d4eb1e60da6ce60711eb335404456e8d9656de9d", "parents": ["eb32398b7beebe932336bbf2198e12babc56436b"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072399 - [Monitor Agent][Models] Move monitor telemetry to the agentic action event schema r=tetchart,ngrato\n\nCurrent telemetry state from landed phab: https://phabricator.services.mozilla.com/D327196 (landed, Fx158)\n- Corrected active monitor count: Differentiates between active and paused\n- Condition-met outcomes of runs logged\n- Completion time durations logged, differentiated by model call and monitor duration\n- Action ids on all monitor events now, so we can group events per monitor and per action type\n\nThis phab adds to the above to address gaps between it and the telemetry spec sheet.\n\nThis adds and addresses:\n- Renames all events named `monitor_*` to `agentic_action_*.\n    - Allow reuse across other agents (e.g. the Research agent)\n- Failed creation events now logged properly\n- Mid-run stop or crash event logging now handled more properly (e.g. deleted or shutdown)\n- Notifications shown and click events now correctly logged for Expired and Created\n- Additional detail on schedule logging (time and weekday added)\n- A couple fixes on pause counting duplication and differentiation from expiry\n- Monitor run count logged and tied per run\n- Lets frontend pass chat context on create, edit, pause, and delete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327198\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/agents/MonitorStore.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/models/tests/browser/browser_monitor_errors.js", "browser/components/aiwindow/models/tests/browser/browser_monitor_store.js", "browser/components/aiwindow/models/tests/browser/browser_monitor_telemetry.js", "browser/components/aiwindow/models/tests/browser/head.js"], "git_node": "accccc3fa643d20feb18534edf1ed70b91f22a97", "git_parents": ["796d56970a0e9c66728a9a9fcfa50ff06cfc67bf"], "node": "80972b74a3c1060fcad657e2725d0e2470780d0c", "parents": ["d4eb1e60da6ce60711eb335404456e8d9656de9d"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072356 - [HNT] Add a new homepage tab on cold start when user sets opening screen as homepage r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327412\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt"], "git_node": "7f3aa4f478f9f057718571924bce1bbcfc1d4a8f", "git_parents": ["accccc3fa643d20feb18534edf1ed70b91f22a97"], "node": "bb7dbcbe7ecfe181740438e530e42f2418b43fb2", "parents": ["80972b74a3c1060fcad657e2725d0e2470780d0c"], "tags": []}, {"author": "Nick Grato \u003cngrato@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073449 - Make the sidebar /watch task panel reachable and auto-focused via keyboard r=yjamora\n\nSubmitting a `/watch` agent command in the Smart Window sidebar left the \"Create a task\" panel unreachable by keyboard until the user clicked it, and never moved focus to the Task name field.\n\nTwo gaps caused this:\n\n1. In `ai-window.mjs`, the agent-command branch of `#handleSmartbarSubmit` only called `#initActiveChatlayout()` when `mode === MODE.FULLPAGE`. The regular chat path (`#generatePrompt`) calls `#setBrowserContainerActiveState(true)` in every mode, so this gate was the outlier: in the sidebar `chat-active` was never applied, and `#updateBrowserTabbable` kept `tabindex=\"-1\"` on the `#aichat-browser` that hosts the card, taking the whole panel out of the tab cycle. The fix removes the mode gate so the command path activates the chat layout in every mode, matching the regular chat path; `clearChat` still resets it for non-fullpage.\n\n2. In `ai-chat-content.mjs`, nothing focused the Task name field on the chat path (`agent-monitor-item.focusName()`'s only caller was the toolbar `agent-monitor-panel`). The fix focuses the freshly seeded \"create\" card's name input once its `updateComplete` resolves, mirroring `agent-monitor-panel`'s `#focusCreateForm()`. Each card is focused at most once and restored cards (from switching conversations) do not steal focus.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327539\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_chat_browser_tabbable.js"], "git_node": "de66824ce41b4678e4489a8436974e4eaa003a62", "git_parents": ["7f3aa4f478f9f057718571924bce1bbcfc1d4a8f"], "node": "33e37175e9ad475289e49b2a6ee7343433f888e2", "parents": ["bb7dbcbe7ecfe181740438e530e42f2418b43fb2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073838 - Keep the urlbar view closed when a search mode query has no results and no one-offs to show. r=daleharvey\n\npromiseSearchComplete no longer waits for the view to open, since a query without results now leaves it closed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327663\n", "files": ["browser/components/urlbar/UrlbarSearchOneOffs.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_popover_state.js", "browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js", "browser/components/urlbar/tests/browser-search/browser_search_bookmarks_from_bookmarks_menu.js", "browser/components/urlbar/tests/browser-searchMode/browser_newWindow.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser/browser_tabKeyBehavior.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchmode.js"], "git_node": "9a70bd4189a6ac8efc46343b1c01412e8e44c16d", "git_parents": ["de66824ce41b4678e4489a8436974e4eaa003a62"], "node": "b45a0cce93bf805a049633b6afded628881d201c", "parents": ["33e37175e9ad475289e49b2a6ee7343433f888e2"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073965 - Use the mozac IconButton in the remaining Fenix Compose sites. r=007,android-reviewers\n\nThe content descriptions move from the inner Icon to the button, which is where the mozac wrapper announces\nthem; sites that clear semantics pass null, and the after-icon site drops its manual Button role since the\nwrapper sets one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327728\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/TabStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/compose/list/ListItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/downloadlanguages/DownloadLanguagesPreference.kt"], "git_node": "2a001547ba4ae61c8e51d00d20fae9b0fe2e7806", "git_parents": ["9a70bd4189a6ac8efc46343b1c01412e8e44c16d"], "node": "8afeab7625a75482fdfdd927060e7134d509feb2", "parents": ["b45a0cce93bf805a049633b6afded628881d201c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073967 - Declare backup and data extraction rules for Fenix and Focus. r=android-reviewers,mcarare\n\nallowBackup=\"false\" still disables cloud backup, but on some Android 12+ devices it no longer covers\ndevice-to-device transfer. The rules exclude everything from both, and fullBackupContent=\"false\" states the\nsame for older releases, so the manifest matches the intent on every version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327729\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/main/res/xml/data_extraction_rules.xml", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/main/AndroidManifest.xml", "mobile/android/focus-android/app/src/main/res/xml/data_extraction_rules.xml"], "git_node": "be50675d19d02420cce191b0601eb2796313aa7f", "git_parents": ["2a001547ba4ae61c8e51d00d20fae9b0fe2e7806"], "node": "d0c209d7038f7f809c4c03e681e7703077c6ea24", "parents": ["8afeab7625a75482fdfdd927060e7134d509feb2"], "tags": []}, {"author": "jsimplicio \u003cjsimplicio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072199 - Fix message-bar close button clipping in narrow containers r=reusable-components-reviewers,desktop-theme-reviewers,mstriemer\n\n.content's default flex min-width:auto was stopping it from shrinking\npast its own content size, so in narrow contexts (e.g. the contextual\npassword manager sidebar at minimum width) the row overflowed and\npushed the close button out past the container, clipping its hover\nand focus states against the ancestor's overflow:hidden.\n\nRegressed by Bug 2054561, which added padding to .content that ate\ninto the room it had to shrink into.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326786\n", "files": ["toolkit/content/widgets/moz-message-bar/moz-message-bar.css"], "git_node": "9256161fa65b63bfe2f268bd6934025c871ecd60", "git_parents": ["be50675d19d02420cce191b0601eb2796313aa7f"], "node": "2c65a02cb3d538c5c0366582ee89fa2fe364d715", "parents": ["d0c209d7038f7f809c4c03e681e7703077c6ea24"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056922 - Part 1: Migrate ShareViewModel to ShareUiStore r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317929\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/ShareUiDevicesObserver.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/store/ShareUiStore.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/share/ShareUiDevicesObserverTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/share/store/ShareUiReducerTest.kt"], "git_node": "5bd843e56d5c5dcd89b78f2a56b4bdc86e3c4d51", "git_parents": ["9256161fa65b63bfe2f268bd6934025c871ecd60"], "node": "ca15b228f37b8ac4ff8973f4c7f4ac004233a6d9", "parents": ["2c65a02cb3d538c5c0366582ee89fa2fe364d715"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056922 - Part 2: Enable multi-selection for send to device on native share sheet r=android-reviewers,android-l10n-reviewers,parker,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313894\n", "files": ["mobile/android/android-components/components/feature/accounts-push/src/main/java/mozilla/components/feature/accounts/push/SendTabUseCases.kt", "mobile/android/android-components/components/feature/accounts-push/src/test/java/mozilla/components/feature/accounts/push/SendTabUseCasesTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/store/ShareUiStore.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/share/store/ShareUiReducerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/share/ShareControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/snackbar/SnackbarBindingTest.kt"], "git_node": "2a78037a4e70425d24d4d7c9b035ec052f3c104e", "git_parents": ["5bd843e56d5c5dcd89b78f2a56b4bdc86e3c4d51"], "node": "3bb8da4b88c543bbaede014202855414286188a1", "parents": ["ca15b228f37b8ac4ff8973f4c7f4ac004233a6d9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1906135 - Wait for the fill before AutocompleteTest reads or submits a form. r=geckoview-reviewers,ohall\n\nThe selection tests read the form a fixed 100 ms after confirming the prompt, and loginUsed submits the form\nright after the page stops loading. The fill reaches content asynchronously, so on a busy emulator a field can\nstill be empty when it is read, or the form goes out before the saved login is filled in. Wait until a field\nthe fill writes is non-empty instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328486\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AutocompleteTest.kt"], "git_node": "3804137d938c130435592a9f3545e913690f30ce", "git_parents": ["2a78037a4e70425d24d4d7c9b035ec052f3c104e"], "node": "aa41f0884ecfeeff38ab267a7b56fc9d1e406d3c", "parents": ["3bb8da4b88c543bbaede014202855414286188a1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2073928 - Slice per-test chunks from a deterministically ordered list, r=ahal.\n\nfind_modified_tests builds its test list by iterating a set of paths, whose\norder varies between processes, so each chunk of a push sliced a different\nordering and the chunks together covered only part of the modified tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327710\n", "files": ["testing/mozharness/mozharness/mozilla/testing/per_test_base.py", "testing/mozharness/test/test_mozilla_per_test_base.py"], "git_node": "cfe9d80ef08502d063e1e7fbf8cfa32eadb21713", "git_parents": ["3804137d938c130435592a9f3545e913690f30ce"], "node": "db55a1ea807ae06ec4b0c3bc39edba808940ee56", "parents": ["aa41f0884ecfeeff38ab267a7b56fc9d1e406d3c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2073930 - Keep every chunk of a per-test task when try requests test paths, r=taskgraph-reviewers,ahal.\n\nfind_modified_tests slices the requested tests across chunks, so unlike the\nsuites whose whole set the harness filters down, a test-verify chunk past the\nfirst does not run the same tests as the first one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327711\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py"], "git_node": "30274fa615b1c459371e594278d28e94419119fc", "git_parents": ["cfe9d80ef08502d063e1e7fbf8cfa32eadb21713"], "node": "e019e512288114765890e394a264064ac9b66f78", "parents": ["db55a1ea807ae06ec4b0c3bc39edba808940ee56"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2073931 - Read the requested test paths from the try config key that is written, r=taskgraph-reviewers,ahal.\n\nNothing writes a \"templates\" key: mach try emits the try config with \"env\" at\nthe top level. The lookup in confirm_failure.py never used its result at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327712\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/chunk.py", "taskcluster/gecko_taskgraph/transforms/test/confirm_failure.py"], "git_node": "5a3fef9cba43a92d2a547773e4d4753fbf14d692", "git_parents": ["30274fa615b1c459371e594278d28e94419119fc"], "node": "09c67b37cecbb8cded368aaaab40b634d50eeea0", "parents": ["e019e512288114765890e394a264064ac9b66f78"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2073931 - Duplicate a chunked task that try selected before it was chunked, r=taskgraph-reviewers,ahal.\n\nA task's chunk count is only known once the decision task has resolved it, so\nmach try fuzzy names test-verify unchunked and --rebuild stopped matching it\nonce the requested paths started driving the count.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327713\n", "files": ["taskcluster/gecko_taskgraph/morph.py", "taskcluster/gecko_taskgraph/test/test_morph.py"], "git_node": "c82eac42c3ee9765ab81dcd7282e8606d769f683", "git_parents": ["5a3fef9cba43a92d2a547773e4d4753fbf14d692"], "node": "3892949623a05cd35a4ad2d21360397f20bb3863", "parents": ["09c67b37cecbb8cded368aaaab40b634d50eeea0"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 780014 - Add startup_session_availability telemetry to help answer was there anything to restore? r=sessionstore-reviewers,sthompson\" for causing TSC failures\n\nThis reverts commit e6cf756b98f864ac2ace3b3cbd00d8f49837413e.\n", "files": ["browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/SessionStartup.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_session_availability.py", "browser/components/sessionstore/test/unit/test_session_availability.js", "browser/components/sessionstore/test/unit/xpcshell.toml"], "git_node": "5cc3479721b39e5fc80defd6d868be00da5cff70", "git_parents": ["c82eac42c3ee9765ab81dcd7282e8606d769f683"], "node": "b2e8be5d3c0179547498e4b081fec4057fa3e5e3", "parents": ["3892949623a05cd35a4ad2d21360397f20bb3863"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074033: Override shared application data directories in xpcshell tests. r=ahal\" for causing multiple xpcshell failures\n\nThis reverts commit 8152b5d315b8d857f9fa539126845e37704265cc.\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "66b3e20faca66d595e5e536bcafdc516b26a34e9", "git_parents": ["5cc3479721b39e5fc80defd6d868be00da5cff70"], "node": "9c80c39dcba32b179c1f05858cd3464f36754ddc", "parents": ["b2e8be5d3c0179547498e4b081fec4057fa3e5e3"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072006 - PBW Fade in animation. r=omc-reviewers,desktop-theme-reviewers,akulyk,emcminn\" for causing bc failures @ browser_parsable_css.js\n\nThis reverts commit bdff6e352b7e600395ba857f7dc48715f55dc9dd.\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.js", "browser/components/privatebrowsing/content/private-browsing-mask-intro.css", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_kit_intro.js", "browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css"], "git_node": "a5473a7f4525dd85b9bccae968be44142dfcd05a", "git_parents": ["66b3e20faca66d595e5e536bcafdc516b26a34e9"], "node": "fa415b2498fbeaf8edd413e46064b47d7a2f793f", "parents": ["9c80c39dcba32b179c1f05858cd3464f36754ddc"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074922 - Use Python to extract Talos webroot archives r=ahal\n\nReplace external unzip with shutil.unpack_archive so Talos archives can be extracted on long Windows paths. This uses the Python standard library and leaves shared mozharness helpers unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328593\n", "files": ["testing/mozharness/mozharness/mozilla/testing/talos.py"], "git_node": "97adecde2b6f8e1ab189da126acece20430aec8c", "git_parents": ["a5473a7f4525dd85b9bccae968be44142dfcd05a"], "node": "28f0e1b800c4eee6a7e0daf1821c4d57034d5578", "parents": ["fa415b2498fbeaf8edd413e46064b47d7a2f793f"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069942 - Fix text overflow in SW Watch Task content r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328579\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css"], "git_node": "3d967ff256619b865e1631170fbc4c8b18085f3d", "git_parents": ["97adecde2b6f8e1ab189da126acece20430aec8c"], "node": "480ecea0befb77709bf28c43fd0331204101bcb0", "parents": ["28f0e1b800c4eee6a7e0daf1821c4d57034d5578"], "tags": []}, {"author": "War004 \u003charrysn1234@gmail.com\u003e", "branch": "default", "desc": "Bug 2069980 - Move SearchEnded dispatch to onTap in AwesomeBarComposable. r=android-reviewers,jonalmeida\n\nonPress fires eagerly on ACTION_DOWN, before the gesture (tap vs. drag\nvs. edge-swipe) is resolved. This caused SearchEnded to dispatch and\nAwesomeBarComposable to unmount on initial contact, which broke the\nAndroid 16 edge back-swipe: touching the empty surface to begin the\nswipe was enough to tear down the search session and drop the user on\nHomeFragment before the swipe completed.\n\nSplit the handling: onPress now only hides the keyboard (safe even if\nthe gesture turns out to be a drag/hold/swipe). onTap now owns the\ndestructive cleanup (clearFocus + SearchEnded dispatch), so it only\nfires once a tap is confirmed on ACTION_UP.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324112\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/AwesomeBarComposable.kt"], "git_node": "c0359ea2ea40b51346b05ba3cd9227ca861d5665", "git_parents": ["3d967ff256619b865e1631170fbc4c8b18085f3d"], "node": "53dd0a258b29e98cb76219fe0115edb79587fc28", "parents": ["480ecea0befb77709bf28c43fd0331204101bcb0"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074972 - update libdrm;r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328608\n", "files": ["third_party/drm/drm/xf86drm.h", "third_party/drm/moz.yaml"], "git_node": "143e2d7ffa6a788c97cf4bbf88ef7c3755823157", "git_parents": ["c0359ea2ea40b51346b05ba3cd9227ca861d5665"], "node": "1833c81eb487337fe03492c7be73b1eb7299b37f", "parents": ["53dd0a258b29e98cb76219fe0115edb79587fc28"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074164: Resolve primitive object constructors in WarpOracle r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328316\n", "files": ["js/src/jit/WarpOracle.cpp", "js/src/vm/JSObject.cpp"], "git_node": "c317f45e0f3d70e3ac477ed5f9b15ca91eef77c7", "git_parents": ["143e2d7ffa6a788c97cf4bbf88ef7c3755823157"], "node": "d45c11fc0c7a6d7fa0da6b7996df67f5430e0d44", "parents": ["1833c81eb487337fe03492c7be73b1eb7299b37f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074164: Add test r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328317\n", "files": ["js/src/jit-test/tests/warp/bug2074164.js"], "git_node": "d87f2546223291d19894f028f64b5cda28ff8639", "git_parents": ["c317f45e0f3d70e3ac477ed5f9b15ca91eef77c7"], "node": "0c779d839af349cd20f3a43c561ceabe2d8f5882", "parents": ["d45c11fc0c7a6d7fa0da6b7996df67f5430e0d44"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073545 - [HNT] Open QR code search in the current homepage tab r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327458\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/BrowserToolbarSearchMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/BrowserToolbarSearchMiddlewareTest.kt"], "git_node": "46b1698a332c3daa15a457eb18847bc8b4133ff9", "git_parents": ["d87f2546223291d19894f028f64b5cda28ff8639"], "node": "896c076422d89fc4c6a7d846a800f57fe2ec9160", "parents": ["0c779d839af349cd20f3a43c561ceabe2d8f5882"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1705002 - Clamp oversized window/document sizes instead of panicking. r=gfx-reviewers,bradwerth\n\nWidgets occasionally report client sizes far beyond what WebRender can render\n(popups tens of thousands of pixels wide, or garbage values), and\nwindow_size_sanity_check turned each of these into a crash when creating or\nresizing a document. Surfaces sized to such a screen rect would still exceed\nMAX_RENDER_TASK_SIZE later on, so clamp the document size to it rather than\ndropping the check. Content beyond the clamped area is not rendered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328277\n", "files": ["gfx/wr/webrender/src/render_api.rs"], "git_node": "e59a572edd13da6af08186ecb067feaf9d45d372", "git_parents": ["46b1698a332c3daa15a457eb18847bc8b4133ff9"], "node": "8938a09f07954d329bc9793cad9c678d7f375d98", "parents": ["896c076422d89fc4c6a7d846a800f57fe2ec9160"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2049797 - Handle a missing temporary directory in clipboard cache tests. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328342\n", "files": ["widget/tests/browser/browser_test_clipboardcache.js", "widget/tests/test_bug1123480.xhtml"], "git_node": "d4231c05978e401655d31d930dcd6237b0faf235", "git_parents": ["e59a572edd13da6af08186ecb067feaf9d45d372"], "node": "7582bc003ca864ef0b1d2367b7c6bec503075c13", "parents": ["8938a09f07954d329bc9793cad9c678d7f375d98"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2049797 - Keep unknown live stream durations infinite until the download ends. r=media-playback-reviewers,alwu\n\nSince bug 2035059 the MP3 and ADTS demuxers no longer report Infinity as\nthe metadata duration, so the estimate BufferedRangeUpdated derives from\nbuffered ranges became the duration of live streams.\n\nSkip that estimate while the resource length is unknown, refresh it when\nthe download completes, treat non-HTTP resources with a known content\nlength as bounded, and keep seekable limited to the buffered ranges while\nthe duration is unknown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326347\n", "files": ["dom/media/ChannelMediaDecoder.cpp", "dom/media/ChannelMediaResource.cpp", "dom/media/MediaDecoder.cpp", "dom/media/MediaDecoderStateMachine.cpp", "dom/media/MediaDecoderStateMachineBase.cpp", "dom/media/test/live_duration.sjs", "dom/media/test/mochitest.toml", "dom/media/test/test_live_duration.html"], "git_node": "75e04cf4cbe1e9660ded93dcc501ba9484079e71", "git_parents": ["d4231c05978e401655d31d930dcd6237b0faf235"], "node": "9a5cd89d539933488039604abbcc976a1ddd6b39", "parents": ["7582bc003ca864ef0b1d2367b7c6bec503075c13"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073267: Add GuardSpecificObject for global lexical SetGName r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328386\n", "files": ["js/src/jit-test/tests/environments/bug2073267.js", "js/src/jit/CacheIR.cpp"], "git_node": "4d39f1257ff925e4d6139205800cfee4cc422610", "git_parents": ["75e04cf4cbe1e9660ded93dcc501ba9484079e71"], "node": "6b3182b5eee7224a283687ccac43671b3f56c83f", "parents": ["9a5cd89d539933488039604abbcc976a1ddd6b39"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065640 - Tabs setting menu refinements r=android-reviewers,007,android-l10n-reviewers,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326302\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsGeneralTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsTabsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuTabsRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/TabsSettingsFragment.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/tabs_preferences.xml"], "git_node": "cda386c497b3903962a4c5dec5f8a531da794c49", "git_parents": ["4d39f1257ff925e4d6139205800cfee4cc422610"], "node": "927ebf6a080e42f39b903d5fffebbf1d4a0d0767", "parents": ["6b3182b5eee7224a283687ccac43671b3f56c83f"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2073976 - Pt 2 - Add the follower stores for display list builder interning r=gfx-reviewers,lsalzman\n\nContent mints slot numbers per builder starting at zero, so two pipelines\ncollide in a single store. The scene builder will hand each pipeline a dense\nDlNamespace on first sight of one of its display lists, and a DlHandle is that\nnamespace plus the content slot, which lets one batch reference items from\nseveral pipelines.\n\nDlBuilderMap tracks per pipeline which builder's delta stream is being\nfollowed and where it has got to. A delta is applied when it is the next in\nthat stream; a non-empty delta from a different builder is a takeover, which\ncloses and reopens the namespace since the new builder's slot numbering\nstarts again; an empty delta from a stranger is ignored, since Gecko clears a\npipeline by sending an empty list from a throwaway builder; a displaced\nbuilder coming back panics. A removed pipeline's namespace is only released at\nthe next scene build, since the render backend goes on drawing the scene that\nstill references it until then.\n\nDlStore is the two-level follower: an outer array indexed by namespace, an\ninner one indexed by slot, changed only by replaying an ordered DlOp list so\nnamespace lifetime cannot be seen out of order with its contents. The inner\nlevel has no free list on purpose, since content owns slot allocation. Each\nentry gets a uid from a counter, which is what the tile cache needs: stable\nfor the entry's life and never shared, which nothing about the addressing can\nsupply once slot numbering can restart. In debug builds a handle carries the\ngeneration of the namespace it was minted against, so a stale handle into a\nrecycled namespace panics rather than reading another pipeline's data.\n\nNothing drives it yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328334\n", "files": ["gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/lib.rs"], "git_node": "0b961b0e3a839bf10b0b6de40a30406fdf50c655", "git_parents": ["cda386c497b3903962a4c5dec5f8a531da794c49"], "node": "af16c03734e0177730c0896197f8689f44a19a89", "parents": ["927ebf6a080e42f39b903d5fffebbf1d4a0d0767"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Add a `license-declarations` linter for the license declarations r=linter-reviewers,sergesanspaille,ahal\n\nChecks the LICENSES and LICENSED_UNDER declarations across the tree without\nrunning a build: every LICENSED_UNDER id must have a matching LICENSES\ndeclaration somewhere, and every `spdx` flag must be a valid SPDX expression.\nAn id declared twice is rejected by mozbuild.licenses, where the two\ndeclarations are still distinguishable, and is not checked again here.\n\nIt lives in tools/lint/license.yml, next to the `license` header check, rather\nthan in a `licenses.yml` a letter away from it: mozlint selects linters by\nconfiguration file name, so both run under `mach lint -l license` and in the\none taskgraph task, the way file-perm.yml groups its two checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325283\n", "files": ["docs/code-quality/lint/linters/license.md", "python/sites/lint.txt", "taskcluster/config.yml", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/files/license-declarations/bad/bad.build", "tools/lint/test/files/license-declarations/bad/computed.build", "tools/lint/test/files/license-declarations/bad/duplicate.build", "tools/lint/test/files/license-declarations/bad/repeated.build", "tools/lint/test/files/license-declarations/bad/syntax.build", "tools/lint/test/files/license-declarations/good/assigned.mozbuild", "tools/lint/test/files/license-declarations/good/good.build", "tools/lint/test/python.toml", "tools/lint/test/test_file_license.py", "tools/lint/test/test_license_declarations.py"], "git_node": "1e384c9ff012bdcef897b2db1a4bad22a2368daf", "git_parents": ["0b961b0e3a839bf10b0b6de40a30406fdf50c655"], "node": "f2cb116b930cc5270585daea351a7af4f21c0205", "parents": ["af16c03734e0177730c0896197f8689f44a19a89"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Declare every about:license notice in moz.build r=firefox-build-system-reviewers,ipc-reviewers,application-update-reviewers,media-playback-reviewers,credential-management-reviewers,webrtc-reviewers,devtools-reviewers,cubeb-reviewers,profiler-reviewers,win-reviewers,frontend-codestyle-reviewers,ai-platform-reviewers,sandbox-reviewers,crashreporting-reviewers,media-webspeech-reviewers,bobowen,dimi,canova,padenot,nchevobbe,mccr8,yjuglaret,bwc,ahochheiden\n\ntoolkit/content/license.html is a 6451-line preprocessed file holding all 96\nlicense notices, their path lists and their #ifdefs by hand. This moves that\ncontent to the directories that own the code; the page itself is still the\nchecked-in file until the next commits replace it.\n\nEach notice becomes a file next to the code it covers, or in\ntoolkit/content/licenses/ when the text is shared across the tree, plus a\nLICENSES declaration in the owning moz.build. Where one directory owns two\nnotices, gfx/skia owning both android and skia among them, the filename is\nqualified with the license id.\n\nThe per-entry #ifdefs are gone. Six block-level guards became CONFIG\nconditionals; the rest were guarding individual paths and are now implicit,\nsince a directory that is not built is never traversed.\n\nOf the 241 path entries, 52 are attributed by the directory itself and 112 by\ntheir nearest built ancestor. The remaining 77 live under third_party/ and\nnsprpub/, which the build system does not traverse, so they stay as explicit\npaths in toolkit/content/licenses/moz.build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325284\n", "files": [".prettierignore", "browser/extensions/formautofill/moz.build", "build/moz.build", "devtools/client/debugger/dist/LICENSE-NOTICE-babel.txt", "devtools/client/debugger/dist/LICENSE-NOTICE-babylon.txt", "devtools/client/debugger/dist/moz.build", "devtools/client/debugger/moz.build", "devtools/client/inspector/markup/moz.build", "devtools/client/netmonitor/src/components/messages/parsers/moz.build", "devtools/client/netmonitor/src/utils/moz.build", "devtools/client/shared/sourceeditor/codemirror6/LICENSE-NOTICE.txt", "devtools/client/shared/sourceeditor/codemirror6/moz.build", "devtools/client/shared/sourceeditor/moz.build", "devtools/client/shared/vendor/LICENSE-NOTICE.txt", "devtools/client/shared/vendor/moz.build", "devtools/client/shared/widgets/moz.build", "devtools/shared/jsbeautify/moz.build", "devtools/shared/moz.build", "devtools/shared/network-observer/moz.build", "devtools/shared/storage/vendor/stringvalidator/LICENSE-NOTICE.txt", "devtools/shared/storage/vendor/stringvalidator/moz.build", "dom/media/systemservices/moz.build", "dom/media/webaudio/blink/moz.build", "dom/media/webrtc/transport/moz.build", "dom/media/webrtc/transport/test/moz.build", "dom/media/webspeech/recognition/moz.build", "dom/moz.build", "editor/libeditor/moz.build", "extensions/auth/moz.build", "extensions/spellcheck/hunspell/LICENSE-NOTICE.txt", "extensions/spellcheck/hunspell/moz.build", "extensions/spellcheck/moz.build", "gfx/angle/LICENSE-NOTICE.txt", "gfx/angle/moz.build", "gfx/cairo/LICENSE-NOTICE.txt", "gfx/cairo/moz.build", "gfx/moz.build", "gfx/pixman/moz.build", "gfx/qcms/LICENSE-NOTICE.txt", "gfx/qcms/moz.build", "gfx/skia/LICENSE-NOTICE-android.txt", "gfx/skia/LICENSE-NOTICE-skia.txt", "gfx/skia/moz.build", "gfx/thebes/LICENSE-NOTICE.txt", "gfx/thebes/moz.build", "gfx/vr/service/openvr/LICENSE-NOTICE.txt", "gfx/vr/service/openvr/moz.build", "gfx/ycbcr/moz.build", "intl/components/src/calendar/moz.build", "intl/moz.build", "ipc/chromium/moz.build", "ipc/chromium/src/third_party/moz.build", "js/src/builtin/moz.build", "js/src/ctypes/moz.build", "js/src/irregexp/moz.build", "js/src/jit/moz.build", "js/src/util/moz.build", "js/src/vm/moz.build", "js/src/vtune/moz.build", "js/src/xsum/moz.build", "js/src/zydis/moz.build", "media/libcubeb/LICENSE-NOTICE.txt", "media/libcubeb/moz.build", "media/libnestegg/LICENSE-NOTICE.txt", "media/libnestegg/moz.build", "media/libnestegg/src/LICENSE-NOTICE.txt", "media/libnestegg/src/moz.build", "media/libogg/moz.build", "media/libsoundtouch/src/LICENSE-NOTICE.txt", "media/libsoundtouch/src/moz.build", "media/libspeex_resampler/moz.build", "media/libvorbis/moz.build", "media/libvpx/LICENSE-NOTICE.txt", "media/libvpx/moz.build", "media/libyuv/LICENSE-NOTICE.txt", "media/libyuv/moz.build", "memory/build/LICENSE-NOTICE.txt", "memory/build/moz.build", "mfbt/moz.build", "mfbt/tests/gtest/moz.build", "modules/fdlibm/src/moz.build", "modules/woff2/moz.build", "mozglue/baseprofiler/moz.build", "netwerk/dns/LICENSE-NOTICE.txt", "netwerk/dns/moz.build", "netwerk/sctp/src/LICENSE-NOTICE.txt", "netwerk/sctp/src/moz.build", "netwerk/wifi/moz.build", "other-licenses/snappy/LICENSE-NOTICE.txt", "other-licenses/snappy/moz.build", "parser/expat/LICENSE-NOTICE.txt", "parser/expat/moz.build", "python/mozbuild/mozbuild/vendor/vendor_manifest.py", "security/moz.build", "security/sandbox/moz.build", "third_party/js/prosemirror/moz.build", "third_party/libwebrtc/moz.build", "third_party/llama.cpp/moz.build", "third_party/msgpack/moz.build", "third_party/perfetto/moz.build", "third_party/zstd/moz.build", "third_party/zucchini/moz.build", "toolkit/components/formautofill/moz.build", "toolkit/components/jsoncpp/moz.build", "toolkit/components/ml/moz.build", "toolkit/components/passwordmgr/moz.build", "toolkit/components/protobuf/moz.build", "toolkit/components/reputationservice/moz.build", "toolkit/components/resistfingerprinting/moz.build", "toolkit/components/url-classifier/moz.build", "toolkit/content/licenses/acorn.txt", "toolkit/content/licenses/apache-llvm.txt", "toolkit/content/licenses/apache.txt", "toolkit/content/licenses/apple-password-rules-parser.txt", "toolkit/content/licenses/apple.txt", "toolkit/content/licenses/arm.txt", "toolkit/content/licenses/boost.txt", "toolkit/content/licenses/bsd2clause.txt", "toolkit/content/licenses/bsd3clause.txt", "toolkit/content/licenses/bspatch.txt", "toolkit/content/licenses/chromium.txt", "toolkit/content/licenses/codemirror.txt", "toolkit/content/licenses/cryptogams.txt", "toolkit/content/licenses/cubic-bezier.txt", "toolkit/content/licenses/d3.txt", "toolkit/content/licenses/dagre-d3.txt", "toolkit/content/licenses/diff.txt", "toolkit/content/licenses/disconnect.me.html", "toolkit/content/licenses/dtoa.txt", "toolkit/content/licenses/dxcompiler-deps.html", "toolkit/content/licenses/firebug.txt", "toolkit/content/licenses/gears-istumbler.txt", "toolkit/content/licenses/gfx-font-list.txt", "toolkit/content/licenses/google-bsd.txt", "toolkit/content/licenses/gyp.txt", "toolkit/content/licenses/harfbuzz.txt", "toolkit/content/licenses/hunspell-ee.txt", "toolkit/content/licenses/hunspell-en.html", "toolkit/content/licenses/hunspell-lt.txt", "toolkit/content/licenses/hunspell-nl.txt", "toolkit/content/licenses/hunspell-ru.txt", "toolkit/content/licenses/immutable.txt", "toolkit/content/licenses/jquery.txt", "toolkit/content/licenses/k_exp.txt", "toolkit/content/licenses/lgpl-3.0.html", "toolkit/content/licenses/lgpl.html", "toolkit/content/licenses/libc++.txt", "toolkit/content/licenses/libevent.txt", "toolkit/content/licenses/libffi.txt", "toolkit/content/licenses/libjingle.txt", "toolkit/content/licenses/llvm.txt", "toolkit/content/licenses/lodash.txt", "toolkit/content/licenses/mit.txt", "toolkit/content/licenses/moz.build", "toolkit/content/licenses/mpl.html", "toolkit/content/licenses/nicer.txt", "toolkit/content/licenses/nom.txt", "toolkit/content/licenses/nrappkit-cont-1.html", "toolkit/content/licenses/nrappkit-cont-2.txt", "toolkit/content/licenses/nrappkit-cont-3.txt", "toolkit/content/licenses/nrappkit.txt", "toolkit/content/licenses/openvision.txt", "toolkit/content/licenses/praton.txt", "toolkit/content/licenses/praton1.txt", "toolkit/content/licenses/prosemirror.html", "toolkit/content/licenses/qrcode-generator.txt", "toolkit/content/licenses/react-redux.txt", "toolkit/content/licenses/react.txt", "toolkit/content/licenses/redux.txt", "toolkit/content/licenses/sprintf.js.txt", "toolkit/content/licenses/sunsoft.txt", "toolkit/content/licenses/superfasthash.txt", "toolkit/content/licenses/twemoji.txt", "toolkit/content/licenses/ucal.html", "toolkit/content/licenses/unicase.txt", "toolkit/content/licenses/unicode-v3.txt", "toolkit/content/licenses/unicode.txt", "toolkit/content/licenses/v8.txt", "toolkit/content/licenses/vtune.txt", "toolkit/content/licenses/webrtc.txt", "toolkit/content/licenses/x264.txt", "toolkit/content/licenses/xdg.txt", "toolkit/content/licenses/xiph.txt", "toolkit/content/moz.build", "toolkit/crashreporter/moz.build", "toolkit/mozapps/update/updater/bspatch/moz.build", "tools/lint/file-whitespace.yml", "tools/lint/license.yml", "tools/profiler/moz.build", "widget/cocoa/moz.build", "widget/windows/moz.build", "xpcom/base/moz.build", "xpcom/io/moz.build"], "git_node": "23ac933ec4f973ef716bad36adf8ce43cab6e480", "git_parents": ["1e384c9ff012bdcef897b2db1a4bad22a2368daf"], "node": "8c3e4646da20ca37018e0f329372fd4fa35e5276", "parents": ["f2cb116b930cc5270585daea351a7af4f21c0205"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Render about:license from the LICENSES declarations r=firefox-build-system-reviewers,sergesanspaille\n\nlicense.html.mako and gen_license_html.py render the page from licenses.json\nthrough GENERATED_FILES, so jar.mn no longer needs the preprocessor. Firefox\nkeeps its own copy, the shared page plus the Mozilla binaries notice, which\njar.mn goes on overriding chrome://global/content/license.html with.\n\nThe blocks an application splices into the page come in as extra inputs rather\nthan through APP_LICENSE_BLOCK and its siblings. Those were an #includesubst of\na path held in a per-directory DEFINE, which a script driven by GENERATED_FILES\ncannot read: buildconfig carries the global configuration, not what one\nmoz.build defined. Passing the file as an input also puts it in the dependency\nset, so editing the notice rebuilds the page.\n\nA notice stored as a .txt is wrapped in \u003cpre\u003e and escaped; one that carries\nmarkup of its own is stored as .html and emitted verbatim. Nine do, including\nthe MPL and the LGPLs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325285\n", "files": ["browser/base/jar.mn", "browser/base/moz.build", "toolkit/content/gen_license_html.py", "toolkit/content/jar.mn", "toolkit/content/license.html.mako", "toolkit/content/moz.build", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/files/license-declarations/bad/bad.build", "tools/lint/test/test_license_declarations.py"], "git_node": "57b44e494a6666dbc9e77053fb58eeecdcff5456", "git_parents": ["23ac933ec4f973ef716bad36adf8ce43cab6e480"], "node": "fbc74f02e66433ac78750f473d28586e2e113732", "parents": ["8c3e4646da20ca37018e0f329372fd4fa35e5276"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Remove the hand-maintained license.html r=firefox-build-system-reviewers,sergesanspaille,frontend-codestyle-reviewers\n\nThe page is generated now, so the preprocessed file goes away.\n\nIt carries the same data as before. Comparing the union across all four\nplatforms the old file knew about, with every feature flag on, against the\nunion rendered from licenses.json: same 96 rows, no title changed, no path\ndropped, and every license body preserved, modulo ten notices where a named\ncharacter entity is now stored decoded (&copy; as the literal character),\nwhich renders identically.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325286\n", "files": [".prettierignore", "toolkit/content/license.html"], "git_node": "eaadd78ec4c2b1dd4206b504ae5a3c0c7503d939", "git_parents": ["57b44e494a6666dbc9e77053fb58eeecdcff5456"], "node": "8e91f2c0145beea70c38ff36208966cc61c40976", "parents": ["fbc74f02e66433ac78750f473d28586e2e113732"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070827 - Attach the moz.build license notices to the SBOM components r=mach-reviewers,ahochheiden\n\nmoz.yaml carries a license field but no notice text, and it only exists for\nvendored libraries; the LICENSES declarations cover directories moz.yaml knows\nnothing about. Where both describe the same code, the notice ids are recorded\non the component as a moz:license.notice-ids property, matching on exact,\nparent-directory and glob paths. Where moz.yaml declared no license at all,\nthe notice's SPDX expression fills the gap.\n\nWhere a notice names paths inside the component -- one file of a vendored\nlibrary rather than the library -- those paths are kept as CycloneDX evidence\noccurrences. The notice ids alone would lose which files the attribution came\nfrom.\n\nlicenses.json is written by the build backend, so it is absent in an\nunconfigured tree; the SBOM is then built from moz.yaml alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325287\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/vendor/sbom.py"], "git_node": "f9b8523a4334df9cc60396f79a44288e97457964", "git_parents": ["eaadd78ec4c2b1dd4206b504ae5a3c0c7503d939"], "node": "e54a2de1161b497a8dafdb3dd1fb7d30b84abd17", "parents": ["8e91f2c0145beea70c38ff36208966cc61c40976"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070824 - Add `mach licenses` to render about:license without a build r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahochheiden\n\nRenders the page straight from the tree's LICENSES declarations, so a change to\na notice or to the template can be checked without building:\n\n    ./mach licenses -o /tmp/license.html\n\nThe tree has to be configured, since the configuration decides which\ndirectories are traversed and so which notices exist, but nothing beyond\n./mach configure is needed: the command reads the moz.builds itself rather than\nwaiting for the backend to write licenses.json. An unconfigured tree is\nrefused rather than rendered as a silent subset.\n\nIt joins `mach sbom` in mozbuild/licensing_commands.py and runs in the same\n`build` site, which is where mako already is because GENERATED_FILES renders\nthe page from the same template during a build.\n\nMachine-readable output is deliberately not offered here; that is what\n`mach sbom` is for.\n\nThe aggregation moves to mozbuild/licenses.py, shared with the build backend so\nthe command and licenses.json cannot drift, and the per-context extraction moves\nthere too: the command cannot run the full emitter, since objects like Library\nneed an objdir it does not have.\n\nThe page rendered is the application's own copy, the one Firefox ships: the\nblocks browser/base splices in, the Mozilla binaries notice among them, are\nread back off that directory's GENERATED_FILES[\"license.html\"] inputs rather\nthan named again here, so the command and the build cannot disagree about\nthem.\n\ngen_license_html.py grows a render() that takes substs as an argument, leaving\nbuildconfig to main(), which is the GENERATED_FILES entry point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325288\n", "files": ["python/mach/mach/command_util.py", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/licenses.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/frontend/data/licenses-declared-twice/moz.build", "python/mozbuild/mozbuild/test/frontend/data/licenses-declared-twice/notice.txt", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_license_collection.py", "toolkit/content/gen_license_html.py", "tools/lint/license.yml"], "git_node": "0e864951c40eaf33d2135374d91b37385a267ad4", "git_parents": ["f9b8523a4334df9cc60396f79a44288e97457964"], "node": "cfb68f86a6196f2e0aff3db84a13f7f1b1a292f3", "parents": ["e54a2de1161b497a8dafdb3dd1fb7d30b84abd17"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Give artifact builds the license records of their compiled build r=firefox-build-system-reviewers,sergesanspaille\n\nAn artifact build does not traverse the directories only a compiling build\ndoes, and those moz.build files cannot be read without compile checks, so its\nabout:license lacked notices the diffoscope artifact validation caught. It now\nmerges in the licenses.json of the build its binaries come from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328540\n", "files": ["python/mozbuild/mozbuild/artifacts.py", "python/mozbuild/mozbuild/test/test_artifacts.py", "toolkit/content/gen_license_html.py", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "0030fbad39bd8a137056cfd5e1652dfbdd6a5731", "git_parents": ["0e864951c40eaf33d2135374d91b37385a267ad4"], "node": "d061936c5b5a70dd0c940e28518ccfbd3e56c440", "parents": ["cfb68f86a6196f2e0aff3db84a13f7f1b1a292f3"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070827 - Represent every about:license notice in the SBOM r=mach-reviewers,ahochheiden\n\nAttaching notices to the moz.yaml components covered only 38 of the 96\nlicenses and 70 of the 248 attributed paths, because moz.yaml exists only for\nvendored libraries. The SBOM therefore described considerably less than\nabout:license did.\n\nLicensed paths that no manifest covers now become components of their own,\ncarrying the notice ids and the SPDX expression where one is known. They are\nshipped third-party code we simply hold less metadata about, so a component\nwith a name and a license beats no record at all.\n\nThe notices about:license reproduces without naming a path, the MPL, the\nbundled spellchecking dictionaries, jQuery and React among them, cannot attach\nto a component. Those go on the root, whose licenses and moz:license.notice-ids\nproperty now name them.\n\nThe SBOM is a superset of about:license: all 96 notice ids and all 248 paths\nare represented, across 293 components, 289 of which carry a license.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325289\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_cyclonedx.py", "python/mozbuild/mozbuild/vendor/sbom.py", "python/mozbuild/mozbuild/vendor/sbom_cyclonedx.py"], "git_node": "876804490ffdcdcc8b8b20dd0ba481b58d21f349", "git_parents": ["0030fbad39bd8a137056cfd5e1652dfbdd6a5731"], "node": "40a28316c80e6918ac14febd108933a3579e02e9", "parents": ["d061936c5b5a70dd0c940e28518ccfbd3e56c440"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070828 - Generate the SBOM on shippable builds r=firefox-build-system-reviewers,taskgraph-reviewers,ahochheiden,sergesanspaille,ahal\n\nNothing in automation produced the bill of materials, so it existed only for\nwhoever ran `mach sbom` locally.\n\nThe document is a GENERATED_FILES entry on the top level moz.build, guarded by\nthe new MOZ_GENERATE_SBOM configure option, so the normal build graph schedules\nit: `licenses.json`, `.cargo/config.toml` and `Cargo.lock` are its extra_deps,\nand the result lands in `\u003cobjdir\u003e/sbom.json`, which automation/upload picks up\nthe way it already picks up config.status. No new automation tier, and nothing\nnew in Makefile.in.\n\n`force` because the generator also reads every tracked moz.yaml and the whole\nCargo.lock graph. Enumerating that as prerequisites would buy little for a\ndocument only the builds that ask for one produce; proper dependency tracking\nis what enabling this by default for local builds would need.\n\nThe build is the right place for this rather than a source-test task, because\nwhich LICENSES declarations are reachable depends on the configuration: a\ndirectory the configuration does not traverse contributes no notice. A single\ntask could only ever describe one platform, and configuring the tree just to\nread it back needs a compile environment to be honest -- without one the tree\nyields 90 of 96 notices and 197 of 248 attributed paths.\n\nMOZ_GENERATE_SBOM is set per task in taskcluster/kinds/build rather than\nderived in the build transform, so whether a given build produces an SBOM is\nvisible where the build is defined. That covers the 20 shippable build tasks\nthat run a build of their own: Linux, Windows and Android, plus devedition,\nand on macOS the per-architecture tasks rather than the universal task that\nonly recombines their output. Artifact builds have no licenses.json, and\nbuild-fat-aar and release-source run no build to describe.\n\nThe generator is strict there: an unparseable moz.yaml fails the build rather\nthan silently shrinking the SBOM. `generate()` and the new `generate_file()`\nentry point share build_document(), so the document `mach sbom` writes is the\none the build writes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325290\n", "files": ["moz.build", "moz.configure", "python/mozbuild/mozbuild/action/generate_sbom.py", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "99a86b731af6bc99c647b4374c96fae904d48a58", "git_parents": ["876804490ffdcdcc8b8b20dd0ba481b58d21f349"], "node": "f293d0537ef030a650c92947f9516e43abf87162", "parents": ["40a28316c80e6918ac14febd108933a3579e02e9"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070828 - Document the license declarations and the SBOM\n\nThe LICENSES and LICENSED_UNDER variables carry reference documentation\nthrough the mozbuild symbol list, but nothing explained how the pieces fit:\nthat about:license and the SBOM read the same declarations, that licenses.json\nis the seam between them, why `mach vendor licenses` on an unconfigured tree\nreturns a subset, or what the moz: properties on a component mean.\n\nA new page under the vendoring docs covers declaring a notice, both commands,\nwhat becomes a component and why the two sources are merged, the\nreproducibility guarantees, and where to fetch the per-platform SBOM shippable\nbuilds upload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325291\n", "files": ["python/mozbuild/mozbuild/vendor/docs/index.md", "python/mozbuild/mozbuild/vendor/docs/licensing.md"], "git_node": "4ab701436e39510de99f1b5cb11ddb48507221ee", "git_parents": ["99a86b731af6bc99c647b4374c96fae904d48a58"], "node": "fbf6038cd55d9f22fa795066da112ad32fe8fb41", "parents": ["f293d0537ef030a650c92947f9516e43abf87162"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Stop repeating moz.yaml in the license declarations r=firefox-build-system-reviewers,linter-reviewers,webrtc-reviewers,gfx-reviewers,media-playback-reviewers,bwc,nical,sergesanspaille,alwu\n\nA vendored library already states its license in moz.yaml, and that is the\nfield `mach sbom` reports; the `spdx` flag on a LICENSES declaration in the\nsame directory is a second copy of it with nothing keeping the two equal. They\nhad already drifted: media/libyuv declared BSD-3-Clause in moz.build against\nBSD-3-Clause-Clear in moz.yaml, and since the SBOM prefers moz.yaml the wrong\ncopy was the one nobody read.\n\nDrop the flag from the six declarations a moz.yaml already covers. A notice for\ncode whose license differs from the library's own is not a duplicate and keeps\nits flag, now saying so with `subcomponent = True`: the MySpell files inside\nhunspell, whose moz.yaml declares MPL-1.1 for the library itself. The\n`license-declarations` linter reports the rest, so a new declaration cannot\nreintroduce the drift.\n\n`origin.license-file` is the same story. It names the file the library ships\nits license in, and `mach vendor` is what checks that file against upstream, so\na `text` flag naming the same file is a second copy only the manifest keeps\ncurrent. `text` is optional now -- a declaration without one reads its notice\nfrom the `license-file` of the covering moz.yaml -- and the linter reports one\nthat repeats it. That drops the flag from expat and libyuv, and deletes the\nLICENSE-NOTICE.txt copies in gfx/angle, gfx/vr/service/openvr, media/libcubeb\nand media/libnestegg, whose moz.yaml gains the `license-file` it was missing.\nThree of those four were byte-for-byte the shipped file; angle's was the\n2002-2010 text where third_party/angle/LICENSE reads 2018, so about:license\nreproduces the file ANGLE actually ships now, comment markers and all.\n\nThree notice files stay, because none is a copy of a single shipped file, and\neach says why in place: media/libvpx's is LICENSE plus the VP8 patent grant\nupstream keeps in libvpx/PATENTS; netwerk/sctp's reproduces the FreeBSD, Cisco\nand WIDE copyright headers its sources carry, which upstream's LICENSE.md,\ncovering the usrsctp code alone, does not; hunspell's is the MySpell license\nthe files in src/ carry, which upstream ships only as the comment header in\nsrc/license.myspell, and not the library's own COPYING.MPL. Their moz.yaml\nstill gains the `license-file` where it was missing, since the SBOM and\n`mach vendor` want it either way.\n\nmedia/libnestegg/src declared a halloc notice and halloc is no longer in the\ntree: nestegg.c is the only file under it, ISC like the rest of the library,\nas media/libnestegg/moz.yaml already says. Delete the declaration and its\ncopied text rather than keep a heading for code the product does not ship.\n\nThe `subcomponent` flag is carried through to licenses.json and read by the\nSBOM, where the enclosing library's component gains the subcomponent's\nexpression alongside the one moz.yaml declares -- hunspell is MPL-1.1 and\nBSD-2-Clause, not MPL-1.1 alone.\n\nabout:license does not render `spdx`, so the page changes only where the notice\ntext does: it reproduces the license the library actually ships, and loses the\nhalloc heading.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326291\n", "files": ["docs/code-quality/lint/linters/license.md", "extensions/spellcheck/hunspell/moz.build", "gfx/angle/LICENSE-NOTICE.txt", "gfx/angle/moz.build", "gfx/angle/moz.yaml", "gfx/vr/service/openvr/LICENSE-NOTICE.txt", "gfx/vr/service/openvr/moz.build", "gfx/vr/service/openvr/moz.yaml", "media/libcubeb/LICENSE-NOTICE.txt", "media/libcubeb/moz.build", "media/libcubeb/moz.yaml", "media/libnestegg/LICENSE-NOTICE.txt", "media/libnestegg/moz.build", "media/libnestegg/moz.yaml", "media/libnestegg/src/LICENSE-NOTICE.txt", "media/libnestegg/src/moz.build", "media/libvpx/moz.build", "media/libyuv/LICENSE-NOTICE.txt", "media/libyuv/moz.build", "netwerk/sctp/src/moz.build", "netwerk/sctp/src/moz.yaml", "parser/expat/LICENSE-NOTICE.txt", "parser/expat/moz.build", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/licenses.py", "python/mozbuild/mozbuild/test/frontend/data/licenses-no-text/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/test/test_license_collection.py", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/sbom.py", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/files/license-declarations/bad/notice/moz.yaml", "tools/lint/test/files/license-declarations/bad/notice/notice.build", "tools/lint/test/files/license-declarations/bad/vendored/moz.yaml", "tools/lint/test/files/license-declarations/bad/vendored/vendored.build", "tools/lint/test/files/license-declarations/good/notice/moz.yaml", "tools/lint/test/files/license-declarations/good/notice/notice.build", "tools/lint/test/files/license-declarations/good/unlicensed/moz.yaml", "tools/lint/test/files/license-declarations/good/unlicensed/unlicensed.build", "tools/lint/test/files/license-declarations/good/vendored/moz.yaml", "tools/lint/test/files/license-declarations/good/vendored/vendored.build", "tools/lint/test/test_license_declarations.py"], "git_node": "417b6ecd5b35584992106004dda9a57214ec8ee6", "git_parents": ["4ab701436e39510de99f1b5cb11ddb48507221ee"], "node": "1b500976c15d083edd90978da1fb6e455efdb252", "parents": ["fbf6038cd55d9f22fa795066da112ad32fe8fb41"], "tags": []}, {"author": "S