txt", "toolkit/content/licenses/hunspell-ee.txt", "toolkit/content/licenses/hunspell-en.html", "toolkit/content/licenses/hunspell-lt.txt", "toolkit/content/licenses/hunspell-nl.txt", "toolkit/content/licenses/hunspell-ru.txt", "toolkit/content/licenses/immutable.txt", "toolkit/content/licenses/jquery.txt", "toolkit/content/licenses/k_exp.txt", "toolkit/content/licenses/lgpl-3.0.html", "toolkit/content/licenses/lgpl.html", "toolkit/content/licenses/libc++.txt", "toolkit/content/licenses/libevent.txt", "toolkit/content/licenses/libffi.txt", "toolkit/content/licenses/libjingle.txt", "toolkit/content/licenses/llvm.txt", "toolkit/content/licenses/lodash.txt", "toolkit/content/licenses/mit.txt", "toolkit/content/licenses/moz.build", "toolkit/content/licenses/mpl.html", "toolkit/content/licenses/nicer.txt", "toolkit/content/licenses/nom.txt", "toolkit/content/licenses/nrappkit-cont-1.html", "toolkit/content/licenses/nrappkit-cont-2.txt", "toolkit/content/licenses/nrappkit-cont-3.txt", "toolkit/content/licenses/nrappkit.txt", "toolkit/content/licenses/openvision.txt", "toolkit/content/licenses/praton.txt", "toolkit/content/licenses/praton1.txt", "toolkit/content/licenses/prosemirror.html", "toolkit/content/licenses/qrcode-generator.txt", "toolkit/content/licenses/react-redux.txt", "toolkit/content/licenses/react.txt", "toolkit/content/licenses/redux.txt", "toolkit/content/licenses/sprintf.js.txt", "toolkit/content/licenses/sunsoft.txt", "toolkit/content/licenses/superfasthash.txt", "toolkit/content/licenses/twemoji.txt", "toolkit/content/licenses/ucal.html", "toolkit/content/licenses/unicase.txt", "toolkit/content/licenses/unicode-v3.txt", "toolkit/content/licenses/unicode.txt", "toolkit/content/licenses/v8.txt", "toolkit/content/licenses/vtune.txt", "toolkit/content/licenses/webrtc.txt", "toolkit/content/licenses/x264.txt", "toolkit/content/licenses/xdg.txt", "toolkit/content/licenses/xiph.txt", "toolkit/content/moz.build", "toolkit/crashreporter/moz.build", "toolkit/mozapps/installer/upload-files.mk", "toolkit/mozapps/update/updater/bspatch/moz.build", "tools/lint/file-whitespace.yml", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/files/license-declarations/bad/bad.build", "tools/lint/test/files/license-declarations/bad/computed.build", "tools/lint/test/files/license-declarations/bad/duplicate.build", "tools/lint/test/files/license-declarations/bad/notice/moz.yaml", "tools/lint/test/files/license-declarations/bad/notice/notice.build", "tools/lint/test/files/license-declarations/bad/repeated.build", "tools/lint/test/files/license-declarations/bad/syntax.build", "tools/lint/test/files/license-declarations/bad/vendored/moz.yaml", "tools/lint/test/files/license-declarations/bad/vendored/vendored.build", "tools/lint/test/files/license-declarations/good/assigned.mozbuild", "tools/lint/test/files/license-declarations/good/good.build", "tools/lint/test/files/license-declarations/good/notice/moz.yaml", "tools/lint/test/files/license-declarations/good/notice/notice.build", "tools/lint/test/files/license-declarations/good/unlicensed/moz.yaml", "tools/lint/test/files/license-declarations/good/unlicensed/unlicensed.build", "tools/lint/test/files/license-declarations/good/vendored/moz.yaml", "tools/lint/test/files/license-declarations/good/vendored/vendored.build", "tools/lint/test/python.toml", "tools/lint/test/test_file_license.py", "tools/lint/test/test_license_declarations.py", "tools/profiler/moz.build", "widget/cocoa/moz.build", "widget/windows/moz.build", "xpcom/base/moz.build", "xpcom/io/moz.build"], "git_node": "28b1c26e4bc9a13ad3968a4a7cb325b59fdb9106", "git_parents": ["21ca9eda62399406776588c52108602f57771688"], "node": "80799da3acbe33ab229e0f0d188e527fa6b9a9d3", "parents": ["5586782b36490e1fc5c05b52424ccf6ac3bff971"], "tags": []}, {"author": "Sarah Chung \u003csachung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071429 - create carousel card type for single-select tiles r=omc-reviewers,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326317\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/SingleSelect.jsx", "browser/components/asrouter/content-src/components/TileButton.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/about-welcome.md", "browser/components/asrouter/docs/carousel-card.png", "browser/components/asrouter/modules/ASRouterScreenUtils.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/TileButton.test.jsx", "browser/components/asrouter/tests/unit/modules/ASRouterScreenUtils.test.jsx"], "git_node": "8ae1afe6ee2f7b3b8c763d2d677846f7ade9993a", "git_parents": ["28b1c26e4bc9a13ad3968a4a7cb325b59fdb9106"], "node": "7b2c4fe8123f56c169744105ad116a7fd8377ba4", "parents": ["80799da3acbe33ab229e0f0d188e527fa6b9a9d3"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066778: Android testForceEnabledByPrefSurvivesNewSessionAttach: Wait for focus to check that accessibility is enabled. r=accessibility-platform-reviewers,geckoview-reviewers,morgan,tcampbell\n\nThe root node falls back to class name \"android.webkit.WebView\" even if the session isn't attached yet, so we could falsely proceed as if accessibility was enabled when it wasn't.\nLoad a test page and wait for focus as we do in other tests to avoid this race.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328061\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "2fc9b964f6e60d6394db57e3b4d44c3cd3c415c8", "git_parents": ["8ae1afe6ee2f7b3b8c763d2d677846f7ade9993a"], "node": "054a8735af454071e451f7da68d0b78214b10148", "parents": ["7b2c4fe8123f56c169744105ad116a7fd8377ba4"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074153 - Reduce the alert threshold to 0.5% for Speedometer overall score r=perftest-reviewers,sparky\n\nspeedometer3 on desktop is pretty stable and low variance now. There is\ninterest in catching even smaller regressions/improvements. This patch\nadjusts the threshold for the overall score to 0.5%, and keeps subtests\nat 2%\n\nOnly for desktop platforms right now\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328237\n", "files": ["testing/perfdocs/generated/raptor.md", "testing/raptor/browsertime/support-scripts/speedometer3.py", "testing/raptor/raptor/tests/benchmarks/speedometer-desktop.toml"], "git_node": "3dad894f70fbfbc82cbfece57c9355f836760bfe", "git_parents": ["2fc9b964f6e60d6394db57e3b4d44c3cd3c415c8"], "node": "79b685013ea5b517fb04ae77535ed53e218fc085", "parents": ["054a8735af454071e451f7da68d0b78214b10148"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070277 - Let a mouse release over a panel-list item choose it in content documents. r=mstriemer,urlbar-reviewers,daleharvey\" for causing bc and TV tests failures at ContentDocument\n\nThis reverts commit c8c1ee29660914960c09f059ed25ea2c52ea9807.\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js", "toolkit/content/tests/widgets/browser.toml", "toolkit/content/tests/widgets/browser_panel_item_click_on_mouseup.js", "toolkit/content/tests/widgets/test_panel_item_mouseup_click.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "8a967cd25fcceb262f3ea87bacf5e01d0c59e55a", "git_parents": ["3dad894f70fbfbc82cbfece57c9355f836760bfe"], "node": "74adbfb637bd14140df32bb3c58de59ebfdaf7ca", "parents": ["79b685013ea5b517fb04ae77535ed53e218fc085"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2074155 - Make `nsWindow::InsertEmoji` use `TextEventDispatcher` r=ltenenbaum\n\n`WidgetContentCommandEvent` should be dispatched by\n`TextEventDispatcher`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327998\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "31151784af1b367f4cbf361c02c77b44393f6658", "git_parents": ["8a967cd25fcceb262f3ea87bacf5e01d0c59e55a"], "node": "0ab2a8353f2046f77ce45e4355c69ddff47dce9f", "parents": ["74adbfb637bd14140df32bb3c58de59ebfdaf7ca"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2074320 - Make `nsWindow::DispatchContentCommandEvent` use `TextEventDispatcher` r=ltenenbaum\n\n`WidgetContentCommand` event should be dispatched via\n`TextEventDispatcher`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328023\n", "files": ["widget/gtk/nsGtkKeyUtils.cpp", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": "21e483cc61a2ef47dd8546d7d0810c8614ae4ff0", "git_parents": ["31151784af1b367f4cbf361c02c77b44393f6658"], "node": "2553d455b6441d592659f4a98e3c700180243736", "parents": ["0ab2a8353f2046f77ce45e4355c69ddff47dce9f"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1839001 - Don't rasterize blob images deleted later in the same transaction. r=gfx-reviewers,lsalzman\n\nApiResources::update queues a blob key for rasterization when the image is added,\nupdated or has its visible area changed, but deleting the image only removed its\ntemplate. A transaction that touched a blob image and then deleted it therefore\nreached create_blob_scene_builder_requests with a key that had no template, and\npanicked with \"no blob image template\". Drop the key from the rasterization list\nwhen the image is deleted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328259\n", "files": ["gfx/wr/webrender/src/api_resources.rs", "gfx/wr/webrender/src/render_api.rs"], "git_node": "6faf7d9af2788cfac8c6714af48b2e85c0899f34", "git_parents": ["21e483cc61a2ef47dd8546d7d0810c8614ae4ff0"], "node": "38dbf93ba5bda2e77cae1f7e0c254567f9c8c738", "parents": ["2553d455b6441d592659f4a98e3c700180243736"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1903244 - Don't overflow when a WebRender profiler timer ends before it starts. r=gfx-reviewers,lsalzman\n\nTransactionProfile timers are started and ended on different threads, and a\nclock that isn't consistent across CPUs (seen in a VM) can hand back an end\ntimestamp that is earlier than the start, overflowing the subtraction. Clamp\nthe elapsed time to zero instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328269\n", "files": ["gfx/wr/webrender/src/profiler.rs"], "git_node": "81a2ba5feb7f0788503c8810576957f973bfac2d", "git_parents": ["6faf7d9af2788cfac8c6714af48b2e85c0899f34"], "node": "25a189c739ee04459f47588cb3584961688383f8", "parents": ["38dbf93ba5bda2e77cae1f7e0c254567f9c8c738"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058972 - Don't panic when a mix-blend picture can't be mapped into its parent surface. r=gfx-reviewers,lsalzman\n\nprepare_composite_mode expected the mix-blend picture rect to always map into\nthe parent surface, but a degenerate transform can make that mapping fail.\nTreat that case like a backdrop that doesn't intersect the parent's clipping\nrect and fall back to the placeholder readback task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328263\n", "files": ["gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/wrench/reftests/crash/mix-blend-unmappable-transform.yaml", "gfx/wr/wrench/reftests/crash/reftest.list"], "git_node": "d2ba9fe75c45836790558f269644b604ed210fbb", "git_parents": ["81a2ba5feb7f0788503c8810576957f973bfac2d"], "node": "0d39e260ab0084e0a372503e4c5cb401e9cc751b", "parents": ["25a189c739ee04459f47588cb3584961688383f8"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057979 - Part 7 - Build the Windows installer with `nsis_stage` and `nsis_build` by default r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325634\n", "files": ["moz.configure"], "git_node": "91952c96711d3c12a12e711079f9dbb48009c021", "git_parents": ["d2ba9fe75c45836790558f269644b604ed210fbb"], "node": "0c30de052fe8027476ebe9916a9a21c1973469bb", "parents": ["0d39e260ab0084e0a372503e4c5cb401e9cc751b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068610 - Let a panel-list select an item by its first letter while focus is outside the panel. r=tgiles,reusable-components-reviewers\n\nThe Smartbar's mention panel moves focus to its editor before this runs, which is why the check asks what kind of element has focus and not where it sits; a XUL panel opened by mouse leaves focus on the body and keeps the letters.\n\nAn outer list and its open submenu both hear a keystroke made outside them through their document listeners, so the outer list leaves the letter to the submenu.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327661\n", "files": ["toolkit/content/tests/widgets/test_panel_item_first_letter.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "70b104f0bc818c11e95fce8723ac72727483cd41", "git_parents": ["91952c96711d3c12a12e711079f9dbb48009c021"], "node": "7e4a59fede40db4ebf1f2279fb914d1d78378dfd", "parents": ["0c30de052fe8027476ebe9916a9a21c1973469bb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068610 - Drop the search mode switcher items' accesskeys. r=daleharvey,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327662\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_keyNavigation.js", "browser/locales/en-US/browser/browser.ftl", "python/l10n/fluent_migrations/bug_2068610_searchmode_switcher_accesskeys.py"], "git_node": "8a4cce3a21f2a0663889fde41caf861cde42bc1a", "git_parents": ["70b104f0bc818c11e95fce8723ac72727483cd41"], "node": "bb67d5fdf7ce5f40d9279b7cb6319ed6bbad64c7", "parents": ["7e4a59fede40db4ebf1f2279fb914d1d78378dfd"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073863 - Give the Places context menu items unique accesskeys. r=fluent-reviewers,places-reviewers,bolsson,mak\n\nAdd Bookmark\u2026 avoids A because the Library's Organize menu also shows Select All, and Share Folder avoids h because the menu on the bookmarks toolbar also shows Show Other Bookmarks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327704\n", "files": ["browser/components/places/content/browserPlacesViews.js", "browser/components/places/content/placesContextMenu.inc.xhtml", "browser/components/sharing/tests/browser/browser_testShareFolderEmpties.js", "browser/locales/en-US/browser/places.ftl"], "git_node": "98775b6ba11154583a344a734cb30eeff6bf9f80", "git_parents": ["8a4cce3a21f2a0663889fde41caf861cde42bc1a"], "node": "dcb79d4eb98fb6d6c955548c9768e5fcc3e83d6a", "parents": ["bb67d5fdf7ce5f40d9279b7cb6319ed6bbad64c7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074680 - Update Windows App SDK to version 2.5.1. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328302\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "bd7cf6d65792f20c1b6010d6db2d269c1e00b0ee", "git_parents": ["98775b6ba11154583a344a734cb30eeff6bf9f80"], "node": "c6b0d88fead71fdb5cc343a8c8ae5502b233839d", "parents": ["dcb79d4eb98fb6d6c955548c9768e5fcc3e83d6a"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071281 - fix missing and small folder icons in bookmarks sidebar panel if title is long. Also fix icon misalignment for empty folders. r=sidebar-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328026\n", "files": ["browser/components/sidebar/sidebar-bookmark-list.css", "browser/components/sidebar/sidebar-bookmark-list.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js"], "git_node": "f9b066a166766cd416640999dfd73d9846671872", "git_parents": ["bd7cf6d65792f20c1b6010d6db2d269c1e00b0ee"], "node": "377903ca3469567d0611b192a4486469befb2c82", "parents": ["c6b0d88fead71fdb5cc343a8c8ae5502b233839d"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070659 - upgrade NSS to b1e4a16efc8e10e8c53816660e785952c27fd71f. r=nss-reviewers,jschanck UPGRADE_NSS_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328187\n", "files": ["security/nss/Makefile", "security/nss/automation/abi-check/expected-report-libnssutil3.so.txt", "security/nss/automation/abi-check/expected-report-libsmime3.so.txt", "security/nss/automation/abi-check/previous-nss-release", "security/nss/automation/release/README.md", "security/nss/automation/release/generate_release_email.py", "security/nss/automation/release/nss-release-helper.py", "security/nss/build.sh", "security/nss/cmd/crlutil/crlutil.c", "security/nss/cmd/modutil/pk11jar.html", "security/nss/cmd/multinit/multinit.c", "security/nss/cmd/selfserv/selfserv.c", "security/nss/cmd/sm