"pushes": {"45296": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3acccbc5c968e491efe28b67121a6207565714fb with FIREFOX_BETA_156_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c330ce02ff79317e77f6d89cd1b5e44d44174833", "git_parents": ["aa3cc94dfde1e9f9e5e5f8cc155c6ec8e6ba0181"], "node": "fbd3971d971b919b0cd7f405d2caa9682c8f7b3b", "parents": ["894d9c380bc6d3031015fa681ae36f2d74e5d2d2"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b6333e929676d16c92d709c6705bc685d40c5f1d with FIREFOX_BETA_157_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "b1a827dfc945620fb0328e07255513220402f3c5", "git_parents": ["c330ce02ff79317e77f6d89cd1b5e44d44174833"], "node": "b0db5de45c3673537a6eb7a9e6046b5db61f1b9a", "parents": ["fbd3971d971b919b0cd7f405d2caa9682c8f7b3b"], "tags": []}], "date": 1789040086, "git_changesets": ["c330ce02ff79317e77f6d89cd1b5e44d44174833", "b1a827dfc945620fb0328e07255513220402f3c5"], "user": "ffxbld@lando.moz.tools"}, "45297": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/version.txt"], "git_node": "d3bf656bd76549825358f28e675da7d033cc8c06", "git_parents": ["4161a38c1ff2744303d6aaee05bd54a3287ddf15"], "node": "5b2a4296f223a83011312c1798f116ca4350bf07", "parents": ["b6333e929676d16c92d709c6705bc685d40c5f1d"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER", "browser/extensions/newtab/manifest.json", "browser/extensions/webcompat/manifest.json", "services/sync/modules/constants.sys.mjs"], "git_node": "dbe1f6c27b5694cd8afa154980a710ff0bb84969", "git_parents": ["d3bf656bd76549825358f28e675da7d033cc8c06"], "node": "da701896fcd0ab7e3a991469bec7de3f404e488d", "parents": ["5b2a4296f223a83011312c1798f116ca4350bf07"], "tags": []}], "date": 1789040308, "git_changesets": ["d3bf656bd76549825358f28e675da7d033cc8c06", "dbe1f6c27b5694cd8afa154980a710ff0bb84969"], "user": "ffxbld@lando.moz.tools"}, "45298": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b6333e929676d16c92d709c6705bc685d40c5f1d with FIREFOX_NIGHTLY_157_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9696515a0405c9677725aa8cfd274b7ee14be6be", "git_parents": ["b1a827dfc945620fb0328e07255513220402f3c5"], "node": "3a1bfd4822bbad13a8dc9f0356d984402e6a602f", "parents": ["b0db5de45c3673537a6eb7a9e6046b5db61f1b9a"], "tags": []}], "date": 1789040325, "git_changesets": ["9696515a0405c9677725aa8cfd274b7ee14be6be"], "user": "ffxbld@lando.moz.tools"}, "45299": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9aab87fe74fb2d7088360567512e0e7b5dc86d47 with FIREFOX-ANDROID_157_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "384794c2ee0b430359ca3b95def8fe4310ced294", "git_parents": ["9696515a0405c9677725aa8cfd274b7ee14be6be"], "node": "cf8b2112ae6308e54b2f2ba238332d1da3d4046d", "parents": ["3a1bfd4822bbad13a8dc9f0356d984402e6a602f"], "tags": []}], "date": 1789046834, "git_changesets": ["384794c2ee0b430359ca3b95def8fe4310ced294"], "user": "ffxbld@lando.moz.tools"}, "45300": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3a21c1f6b3cdb7033022525980fb181461acd334 with DEVEDITION_157_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "5969f37bfe792d19dd89dddcb5ef680732a0faf5", "git_parents": ["384794c2ee0b430359ca3b95def8fe4310ced294"], "node": "cbb020eef78d1f055070fdf4de06cca0fb195f70", "parents": ["cf8b2112ae6308e54b2f2ba238332d1da3d4046d"], "tags": []}], "date": 1789046897, "git_changesets": ["5969f37bfe792d19dd89dddcb5ef680732a0faf5"], "user": "ffxbld@lando.moz.tools"}, "45301": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3a21c1f6b3cdb7033022525980fb181461acd334 with FIREFOX_157_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d1f7dfb1a7daa2e9c7f8f414268b2d1ec47dfc65", "git_parents": ["5969f37bfe792d19dd89dddcb5ef680732a0faf5"], "node": "2854179d5183a4a0fa2ae364e863dd1322075d9c", "parents": ["cbb020eef78d1f055070fdf4de06cca0fb195f70"], "tags": []}], "date": 1789046960, "git_changesets": ["d1f7dfb1a7daa2e9c7f8f414268b2d1ec47dfc65"], "user": "ffxbld@lando.moz.tools"}, "45302": {"changesets": [{"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2042565, Bug 1929128, Bug 2040802: Enable SIMD for SkipUntilBitInTable without AVX r=yury\" for causing crashes related to regular expressions in the javascript engine.\n\nThis reverts commit fe1a8df6cc30a1db1c8172b024492fcad5d060b7.\n\nRevert \"Bug 2042565: Improve non-AVX support in simple three-operand SIMD operations r=yury\"\n\nThis reverts commit 97f332ce432d11afb922cfef660a40b8a18a7324.\n\nRevert \"Bug 1929128: Use SIMD for SkipUntilBitInTable r=jandem\"\n\nThis reverts commit cbebf91f76a0995dbf2ac93bf16578b7817903fc.\n\nRevert \"Bug 2040802: Rename ENABLE_WASM_SIMD to ENABLE_JIT_SIMD r=yury\"\n\nThis reverts commit f785e771e7050dca044555ef4b70fb17c67ba98c.\n", "files": ["js/moz.configure", "js/public/Initialization.h", "js/src/builtin/TestingFunctions.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h", "js/src/jit-test/tests/re