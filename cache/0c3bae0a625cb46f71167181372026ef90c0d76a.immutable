er/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_filling.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_generation.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry_review.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_telemetry.js"], "git_node": "4d9e5cec8bc77232f468bcc6e9b58f531a6c9dce", "git_parents": ["f56ed02288bef1667f768d9ecfe98d0d2517543c"], "node": "2f3f7a9aa8c4b146a7eb7c83b0895bd6f00caf85", "parents": ["ace91b8723d2cf52a5d35225c65e0321a6390839"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2068790 - Let image conversion select the RGB-to-YUV matrix and range r=media-playback-reviewers,alwu\n\nPreviously, the I420 or NV12 conversion from RGB sources were always\nwith BT601 limited-range matrix. This patch enables the call sites to\nselect the matrix by providing YUV color space and color range. If no\nmatrix is available. e.g., from RGB565 sources, the conversion would be\nrejected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324720\n", "files": ["dom/media/ImageConversion.cpp", "dom/media/ImageConversion.h"], "git_node": "a80551b58d8fd195f0b1762ce1e2d57533e6f6bf", "git_parents": ["4d9e5cec8bc77232f468bcc6e9b58f531a6c9dce"], "node": "56d7b1109bfa597e8c953c42df65641b1fd524ae", "parents": ["2f3f7a9aa8c4b146a7eb7c83b0895bd6f00caf85"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2068790 - Test RGB-to-YUV conversion under each matrix and range r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324721\n", "files": ["dom/media/gtest/TestImageConversion.cpp"], "git_node": "9cc6b6e71d2974589ae0a53655665ce1cfe9ff34", "git_parents": ["a80551b58d8fd195f0b1762ce1e2d57533e6f6bf"], "node": "62d2dda5ed7ca527d5fcdc6fc96357c3deab5b87", "parents": ["56d7b1109bfa597e8c953c42df65641b1fd524ae"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044909 - Add strict create-and-probe WebRTC decode support path for MediaCapabilities. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309894\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h"], "git_node": "73a03f2aa274037c93dfb0fde205fca2c30556af", "git_parents": ["9cc6b6e71d2974589ae0a53655665ce1cfe9ff34"], "node": "db02bd5c842670b30645343a2c5dc01e626b76ac", "parents": ["62d2dda5ed7ca527d5fcdc6fc96357c3deab5b87"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044909 - Add PEMFactory::StrictSupportsAsync and strict WebRTC encode support path for MediaCapabilities. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309895\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h", "testing/gtest/mozilla/ScopedPrefSetter.h", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-webrtc-smooth.any.js.ini"], "git_node": "f078847f3de1f1ad15451772bfae5bb1ab8825a8", "git_parents": ["73a03f2aa274037c93dfb0fde205fca2c30556af"], "node": "53b79ac2c9962c76e00a87b976d11903e8bdc573", "parents": ["db02bd5c842670b30645343a2c5dc01e626b76ac"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044909 - Serialize MediaCapabilities encode-support probes through an encoder AllocPolicy. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\n\nGeneralize GlobalAllocPolicy and SingleAllocPolicy to encoders, mirroring how\nCheckVideoDecodingInfo serializes its strict decoder probes. Decoders and\nencoders are counted separately. PEMFactory::StrictSupportsAsync takes an\noptional AllocPolicy, allocates the probe encoder through it (or the global\nencoder policy) and holds the token until the encoder has shut down, so at most\none MediaCapabilities probe encoder exists at a time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324287\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/AllocationPolicy.cpp", "dom/media/platforms/AllocationPolicy.h", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h"], "git_node": "3e725f99477e40f64e8db8d13c460ef3645ab46f", "git_parents": ["f078847f3de1f1ad15451772bfae5bb1ab8825a8"], "node": "97c05074159f417a7f5b42ba652c2581c01269ef", "parents": ["53b79ac2c9962c76e00a87b976d11903e8bdc573"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044909 - Serialize MediaCapabilities encode-support probes through an encoder AllocPolicy. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\" for causing build bustages at SanityTest.cpp\n\nThis reverts commit 3e725f99477e40f64e8db8d13c460ef3645ab46f.\n\nRevert \"Bug 2044909 - Add PEMFactory::StrictSupportsAsync and strict WebRTC encode support path for MediaCapabilities. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\"\n\nThis reverts commit f078847f3de1f1ad15451772bfae5bb1ab8825a8.\n\nRevert \"Bug 2044909 - Add strict create-and-probe WebRTC decode support path for MediaCapabilities. r=media-playback-reviewers,webrtc-reviewers,padenot,bwc\"\n\nThis reverts commit 73a03f2aa274037c93dfb0fde205fca2c30556af.\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/AllocationPolicy.cpp", "dom/media/platforms/AllocationPolicy.h", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h", "testing/gtest/mozilla/ScopedPrefSetter.h", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-webrtc-smooth.any.js.ini"], "git_node": "083539c4c58df1bb8c8a578aa0d3d0e5e2224d5c", "git_parents": ["3e725f99477e40f64e8db8d13c460ef3645ab46f"], "node": "4e69458ce828a2f2f8616d78c01511dc0e9f0e1e", "parents": ["97c05074159f417a7f5b42ba652c2581c01269ef"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2071235 - Null-check the window before detaching the editor in nsDocShellEditorData (Coverity CID 1639512) r=dom-core-reviewers,smaug\n\nDetachFromWindow derived domWindow from a ternary that already admits mDocShell\ncan be null, then dereferenced the result twice without checking it:\nnsEditingSession::DetachFromWindow calls aWindow-\u003eGetCurrentInnerWindow()\nunconditionally, and the following lines call domWindow-\u003eGetDoc().\n\nThe ternary is not the only null source. nsDocShell::GetWindow() returns nullptr\nwhenever EnsureScriptEnvironment() fails, which it does with\nNS_ERROR_NOT_AVAILABLE when mIsBeingDestroyed is set or when there is no\nnsIWebBrowserChrome. Editor detach runs during teardown, so a non-null mDocShell\nwith a null window is reachable.\n\nReturn NS_ERROR_NOT_AVAILABLE instead, mirroring what the underlying call\nreports.\n\nnsDocShellEditorData::ReattachToWindow immediately below had the identical\nshape and the same unguarded dereferences, but it has no callers at all, so\nremove it rather than guarding it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325336\n", "files": ["docshell/base/nsDocShellEditorData.cpp", "docshell/base/nsDocShellEditorData.h"], "git_node": "c53ad26a74634b0ad878e70e6a9b6b79bb2f17b6", "git_parents": ["083539c4c58df1bb8c8a578aa0d3d0e5e2224d5c"], "node": "315b04a889dc9ee79bd1ae12b792aaae6f803369", "parents": ["4e69458ce828a2f2f8616d78c01511dc0e9f0e1e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2071235 - Remove the now-dead editor reattach path r=dom-core-reviewers,smaug\n\nWith nsDocShellEditorData::ReattachToWindow gone, nsEditingSession::ReattachToWindow\nhas no callers left, and the state nsDocShellEditorData only kept for the\nreattach is dead: mDetachedMakeEditable and mDetachedEditingState were written\nbut never read, and mIsDetached was only ever read by an assertion in\nEnsureEditingSession guarding against a reattach that can no longer happen.\nRemove all of them, along with the doc-\u003eGetEditingState() call in\nDetachFromWindow that existed solely to fill mDetachedEditingState.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326117\n", "files": ["docshell/base/nsDocShellEditorData.cpp", "docshell/base/nsDocShellEditorData.h", "editor/composer/nsEditingSession.cpp", "editor/composer/nsEditingSession.h"], "git_node": "46ec8405bc350a5f56afe33f0194d6a149828ca5", "git_parents": ["c53ad26a74634b0ad878e70e6a9b6b79bb2f17b6"], "node": "02eeaa3b4c3f8ea57e97803b9b2f21ce5a99af4b", "parents": ["315b04a889dc9ee79bd1ae12b792aaae6f803369"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2071708 - Guard both wasm truncate trap stackmaps on stackMapRegistry in the x86 backend r=yury\n\nAutoHandleWasmTruncateToIntErrors in MacroAssembler-x86-shared.cpp guarded its\nfirst addMap() call with stackMapRegistry and its second with stackMapForTraps.\nThe arm, arm64 and riscv64 backends use stackMapRegistry for both, so x86 was\nthe only backend that would skip registering the stackmap for the\nInvalidConversionToInteger trap when a registry is supplied without a map.\n\nThe constructor asserts that a stackmap implies a registry, so the null\ndereference Coverity reports as CID 1701163 cannot actually happen. This only\nmakes the two paths consistent with each other and with the other backends.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325721\n", "files": ["js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp"], "git_node": "62a9c423475eb09658398239fe5c4db79d02f7da", "git_parents": ["46ec8405bc350a5f56afe33f0194d6a149828ca5"], "node": "d604f992f924a1c15754e99a26a4f9a62c859331", "parents": ["02eeaa3b4c3f8ea57e97803b9b2f21ce5a99af4b"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix broken links in the tryselect and sanitizer documentation r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nBoth used .html link targets where the source file is .md.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325714\n", "files": ["tools/sanitizer/docs/asan.md", "tools/tryselect/docs/index.md"], "git_node": "ccfcb5b87b1e43ea95bd786342d8f94563fbedcb", "git_parents": ["62a9c423475eb09658398239fe5c4db79d02f7da"], "node": "6199719f2d9763b290032e39cfe4dd6862d14b49", "parents": ["d604f992f924a1c15754e99a26a4f9a62c859331"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix the NSPR reference cross-links r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nThese are MDN wiki links that outlived the conversion to Sphinx: bare page\nnames, en/ and NSPR_API_Reference/ prefixes, and anchors written in the wiki\nform (#Threading_Types_and_Constants). They now name the .md file and the\nheading slug MyST generates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325696\n", "files": ["docs/nspr/reference/anonymous_shared_memory.md", "docs/nspr/reference/cached_monitors.md", "docs/nspr/reference/condition_variables.md", "docs/nspr/reference/date_and_time.md", "docs/nspr/reference/dynamic_library_linking.md", "docs/nspr/reference/hash_tables.md", "docs/nspr/reference/i_o_functions.md", "docs/nspr/reference/i_o_types.md", "docs/nspr/reference/interval_timing.md", "docs/nspr/reference/introduction_to_nspr.md", "docs/nspr/reference/ipc_semaphores.md", "docs/nspr/reference/linked_lists.md", "docs/nspr/reference/locks.md", "docs/nspr/reference/logging.md", "docs/nspr/reference/memory_management_operations.md", "docs/nspr/reference/monitors.md", "docs/nspr/reference/named_shared_memory.md", "docs/nspr/reference/network_addresses.md", "docs/nspr/reference/nspr_error_handling.md", "docs/nspr/reference/nspr_types.md", "docs/nspr/reference/pl_strdup.md", "docs/nspr/reference/pr_createthread.md", "docs/nspr/reference/pr_geterror.md", "docs/nspr/reference/pr_open.md", "docs/nspr/reference/pr_seek.md", "docs/nspr/reference/praccesshow.md", "docs/nspr/reference/prdir.md", "docs/nspr/reference/prerrorcode.md", "docs/nspr/reference/prfiledesc.md", "docs/nspr/reference/prlock.md", "docs/nspr/reference/prnetaddr.md", "docs/nspr/reference/process_initialization.md", "docs/nspr/reference/process_management_and_interprocess_communication.md", "docs/nspr/reference/prthreadpriority.md", "docs/nspr/reference/threads.md"], "git_node": "ef7abde7418202801a6393d6ea6977a7d8b2f752", "git_parents": ["ccfcb5b87b1e43ea95bd786342d8f94563fbedcb"], "node": "ef68bb6cecdbb0ad23c8eddab65e119a049ea769", "parents": ["6199719f2d9763b290032e39cfe4dd6862d14b49"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071683 - Fix broken links in the main documentation tree r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nMostly .html link targets where the source file is .md, plus dangling\nreferences to a Fission page, a symbol-downloading section and MDN pages that\nno longer exist. Two headings whose generated slug drops punctuation gained an\nexplicit MyST target so the links stay readable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325697\n", "files": ["docs/_addons/etp_matrix.py", "docs/code-quality/coding-style/format_cpp_code_with_clang-format.md", "docs/code-quality/lint/linters/eslint.md", "docs/code-quality/lint/linters/eslint/enabling-rules.md", "docs/code-quality/lint/linters/stylelint/enabling-rules.md", "docs/code-quality/lint/usage.md", "docs/contributing/build/building_mobile_firefox.md", "docs/contributing/debugging/capturing_minidump.md", "docs/contributing/debugging/debugging_a_minidump.md", "docs/contributing/debugging/debugging_firefox_with_gdb.md", "docs/contributing/debugging/debugging_on_windows.md", "docs/contributing/debugging/debugging_webrtc_calls.md", "docs/contributing/directory_structure.md", "docs/contributing/jujutsu.md", "docs/crash-reporting/searching_crash_reports.md", "docs/performance/memory/memory_reporting.md", "docs/performance/power_profiling_overview.m