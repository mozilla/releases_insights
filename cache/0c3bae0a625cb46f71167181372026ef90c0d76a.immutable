, "gfx/layers/NativeLayerWayland.h", "gfx/webrender_bindings/RenderCompositorNative.cpp"], "git_node": "0ac328a9b4a47b3a5406b1e22783a34b41cdd3e3", "git_parents": ["a11cf681f30044901a6d3bbd83a611044888e621"], "node": "cd47adb7a6d22b6e8c9c7ea8a8a74eac233e9d48", "parents": ["f954098ce790bce2aeca6d0251934e6614492575"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2066397 [Wayland] Update color management for RGB/HDR surfaces r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326892\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "widget/gtk/BufferSurface.cpp", "widget/gtk/BufferSurface.h", "widget/gtk/DMABufSurface.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h"], "git_node": "538319d56bbaa8fa22354455c172a560d4fd74a2", "git_parents": ["0ac328a9b4a47b3a5406b1e22783a34b41cdd3e3"], "node": "db378e420987b8aff5d7a78ba3563e146370ad32", "parents": ["cd47adb7a6d22b6e8c9c7ea8a8a74eac233e9d48"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2066397: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "widget/gtk/BufferSurface.cpp", "widget/gtk/BufferSurface.h", "widget/gtk/DMABufSurface.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h"], "git_node": "745952ea863ba23719398df66915578e88605b5f", "git_parents": ["538319d56bbaa8fa22354455c172a560d4fd74a2"], "node": "e01603b357091d699397dc42b5e400e7b294b5e4", "parents": ["db378e420987b8aff5d7a78ba3563e146370ad32"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073341 - Recycle Path storage into PathBuilder. r=gfx-reviewers,gw\n\nPathBuilderRecording gives its storage to PathRecording on Finish. PathBuilderRecording\nmust then reallocate the storage again for the next path, even if the builder is reused.\nIn cases where we know the path is no longer used, this storage can be recycled back to\nthe builder, reducing another potential source of frequent reallocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327233\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "gfx/2d/2D.h", "gfx/2d/Path.cpp", "gfx/2d/PathCairo.cpp", "gfx/2d/PathCairo.h", "gfx/2d/PathRecording.cpp", "gfx/2d/PathRecording.h", "gfx/2d/PathSkia.cpp", "gfx/2d/PathSkia.h", "gfx/2d/ScaledFontBase.cpp", "gfx/2d/ScaledFontBase.h"], "git_node": "181d24c0c6772d4de414a58c4fd83e0162e0a05f", "git_parents": ["745952ea863ba23719398df66915578e88605b5f"], "node": "0d38c1013d2b7b2db48f32b639f8ba75b7ad1500", "parents": ["e01603b357091d699397dc42b5e400e7b294b5e4"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073341 - Remove duplicate StrokeCircle and StrokeLine optimizations. r=gfx-reviewers,gw\n\nNow that PathRecording construction costs are much lower, there is no need to have duplicate\nchecks for StrokeLine and StrokeCircle higher up on PathBuilderRecording to avoid the PathRecording\nconstruction cost. Remove the duplicate optimizations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327697\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "gfx/2d/DrawTargetRecording.cpp"], "git_node": "51444430ec6a8a6817bf1f1b41071c5acd541a45", "git_parents": ["181d24c0c6772d4de414a58c4fd83e0162e0a05f"], "node": "32e659f7d3be20a39b43109b94f652e108b27ec9", "parents": ["0d38c1013d2b7b2db48f32b639f8ba75b7ad1500"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073475 - Lint all ipc/ headers through clang-tidy r=ipc-reviewers,nika\n\nChanges includes:\n- making deleted methods public\n- preventing the deletion of private classes that are actually\n  implemented in source files\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327332\n", "files": ["ipc/glue/CrossProcessMutex.h", "ipc/glue/CrossProcessSemaphore.h", "ipc/glue/Neutering.h", "ipc/glue/ProtocolUtils.h", "ipc/glue/SharedMemoryHandle.h", "ipc/glue/SharedMemoryMapping.h"], "git_node": "842c25360bfd71ae43bce4040b5ab5b49260b19c", "git_parents": ["51444430ec6a8a6817bf1f1b41071c5acd541a45"], "node": "33fb450f38182272074552a7ae639b8b7fa9eb49", "parents": ["32e659f7d3be20a39b43109b94f652e108b27ec9"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes ct-logs - r=release-managers,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327709\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "78496726a623c9c1851284d006ee80116b90362e", "git_parents": ["842c25360bfd71ae43bce4040b5ab5b49260b19c"], "node": "4d9b32cd4adbd9e89312249fd50a292f983e873a", "parents": ["33fb450f38182272074552a7ae639b8b7fa9eb49"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069838 - [customizable-menu] Show the share menu item in browser screen's menu r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326928\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ShareMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/ShareMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt"], "git_node": "dd801137cc3d625dfe2050a093ee83b12caba33b", "git_parents": ["78496726a623c9c1851284d006ee80116b90362e"], "node": "7b421444ec81d0c27a8174425e5f4f105c821f0c", "parents": ["4d9b32cd4adbd9e89312249fd50a292f983e873a"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037346 - RemoveFrameEntries on force reload from browser UI. r=dom-core-reviewers,sthompson,smaug\n\nUnlike CanonicalBrowsingContext::NotifyOnHistoryReload, nsSHistory::Reload\nnever removed entries on force reload, while not adopting the docshell ID onto\nthe new entry. This leaves stale entries behind and produces confusing\nback/forward interactions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323222\n", "files": ["docshell/shistory/nsSHistory.cpp", "docshell/test/navigation/browser.toml", "docshell/test/navigation/browser_reload_subframe_history.js", "docshell/test/navigation/file_reload_subframe_history.html"], "git_node": "e200ffc0cfbb62b32039cae307db03895016e952", "git_parents": ["dd801137cc3d625dfe2050a093ee83b12caba33b"], "node": "1396d971b8afc108c5b9bec6e7d247d452d1e276", "parents": ["7b421444ec81d0c27a8174425e5f4f105c821f0c"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037346 - Adopt docshell ID and remove child if parent SH entry expired. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323223\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/test/navigation/browser.toml", "docshell/test/navigation/browser_reload_subframe_history.js", "docshell/test/navigation/file_reload_subframe_history_expired.html", "docshell/test/navigation/file_reload_subframe_history_expired.html^headers^", "testing/web-platform/tests/html/browsers/browsing-the-web/history-traversal/iframe-history-restore-on-container-traversal.tentative.html"], "git_node": "00b80abff95cc5a24433f20af6e5e9cd40a26de6", "git_parents": ["e200ffc0cfbb62b32039cae307db03895016e952"], "node": "c25cc17e923c247eb42afed724098ec9c3764ac5", "parents": ["1396d971b8afc108c5b9bec6e7d247d452d1e276"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037346 - Don't restore child entries when parent is reloaded. r=smaug,dom-core-reviewers,dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299053\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/test/navigation/browser_reload_subframe_history.js", "docshell/test/navigation/test_bug1375833.html", "docshell/test/navigation/test_bug1536471.html", "dom/serviceworkers/test/browser_initial_about_blank_subframe_history.js", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/browsers/browsing-the-web/history-traversal/iframe-history-restore-on-container-traversal.tentative.html.ini"], "git_node": "aa9e56406ea3a4ea82b6d1d568e9bebb245a1676", "git_parents": ["00b80abff95cc5a24433f20af6e5e9cd40a26de6"], "node": "93b142c8632673669e4a125d0ed17971e741611b", "parents": ["c25cc17e923c247eb42afed724098ec9c3764ac5"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037346 - Refactor GetLoadingSessionHistoryInfoFromParent and send aReloadFlags. r=sfarre\n\nThis change does some cleanup after the previous parts.\n- Rename GetLoadingSessionHistoryInfoFromParent to AdoptChildSHEntry\n  to highlight the side-effect.\n- Inline GetChildSHEntryIfHasNoDynamicallyAddedChild to make it more clear\n  if we leave child entries behind.\n- Pass the full reload flags through NotifyOnHistoryReload, so the load type is\n  set correctly on the entry for all reload paths.\n- Fix RemoveFrameEntries to handle mIndex \u003c 0 when max_entries=0 to avoid\n  an assertion from failing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326515\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/base/nsDocShell.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/shistory/nsISHEntry.idl", "docshell/shistory/nsISHistory.idl", "docshell/shistory/nsSHEntryShared.h", "docshell/shistory/nsSHistory.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl"], "git_node": "4195eded6e7d309637a1b514740a19520e75b217", "git_parents": ["aa9e56406ea3a4ea82b6d1d568e9bebb245a1676"], "node": "5bb8a48d220bc5539c2bbd3c5eb688a9cf55f5a6", "parents": ["93b142c8632673669e4a125d0ed17971e741611b"], "tags": []}, {"author": "Benjamin Beurdouche \u003cbbeurdouche@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069107 - Update mls-platform-api to 0.42.0 and mls-rs to 0.56 r=supply-chain-reviewers\n\nUpdates the vendored MLS stack:\n\n  mls-rs                 0.54.0 -\u003e 0.56.0\n  mls-rs-core            0.26.0 -\u003e 0.27.0\n  mls-rs-crypto-hpke     0.20.0 -\u003e 0.21.0\n  mls-rs-crypto-traits   0.21.0 -\u003e 0.22.0\n  mls-rs-identity-x509   0.20.0 -\u003e 0.21.0\n  mls-rs-provider-sqlite 0.22.0 -\u003e 0.23.0\n  mls-platform-api       0.2.0  -\u003e 0.42.0\n\nmls-platform-api, mls-rs-crypto-nss and mls-rs-provider-sqlite are now\npinned by tag (0.42.0) instead of by revision.\n\nmls-rs-core 0.27 adds hpke_seal_psk and hpke_open_psk as required methods\non CipherSuiteProvider, so mls-rs-crypto-nss implements them on top of the\nexisting HPKE seal and open.\n\nAlso drops the unused sha2 dependency, moves mls-rs-crypto-nss from\ngetrandom 0.2 to 0.3 (removing rand_core), and fixes the sqlite provider's\nmax_epoch_id so it applies the state context like every other lookup.\n\nNotes on the crypto-relevant parts of the mls-rs delta, for reviewers:\n\n  - mls-rs-crypto-traits, mls-rs-identity-x509 and the crates.io bump of\n    mls-rs-provider-sqlite contain no source changes at all.\n  - mls-rs-crypto-hpke 0.21 only relocates its Psk type into mls-rs-core as\n    HpkePsk. The 32-byte minimum PSK length check and the PSK mode selection\n    are unchanged.\n  - mls-rs 0.56 replaces Group::new with a GroupBuilder. The refactor keeps\n    every validation step, including the leaf node validity check.\n  - 0.56 relaxes two defence-in-depth checks for proposals whose source is\n    ProposalSource::Local. Only an application's own MlsRules can produce\n    that source; wire-decoded proposals are always ByValue or ByReference,\n    and Gecko uses DefaultMlsRules, so neither is reachable here.\n  - 0.56 tightens ratchet tree import validation, parent hash chain\n    coverage, and prior-epoch sender key checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323403\n", "files": [".cargo/config.toml.in", "Cargo.lock", "security/mls/mls_gk/Cargo.toml", "supply-chain/audits.toml", "third_party/rust/mls-platform-api/.cargo-checksum.json", "third_party/rust/mls-platform-api/Cargo.toml", "third_party/rust/mls-rs-core/.cargo-checksum.json", "third_party/rust/mls-rs-core/.cargo_vcs_info.json", "third_party/rust/mls-rs-core/Cargo.lock", "third_party/rust/mls-rs-core/Cargo.toml", "third_party/rust/mls-rs-core/Cargo.toml.orig", "third_party/rust/mls-rs-core/src/crypto.rs", "third_party/rust/mls-rs-core/src/crypto/test_suite.rs", "third_party/rust/mls-rs-crypto-hpke/.cargo-checksum.json", "third_party/rust/mls-rs-crypto-hpke/.cargo_vcs_info.json", "third_party/rust/mls-rs-crypto-hpke/Cargo.lock", "third_party/rust/mls-rs-crypto-hpke/Cargo.toml", "third_party/rust/mls-rs-crypto-hpke/Cargo.toml.orig", "third_party/rust/mls-rs-crypto-hpke/src/hpke.rs", "third_party/rust/mls-rs-crypto-nss/.cargo-checksum.json", "third_party/rust/mls-rs-crypto-nss/Cargo.toml", "third_party/rust/mls-rs-crypto-nss/src/ec.rs", "third_party/rust/mls-rs-crypto-nss/src/lib.rs", "third_party/rust/mls-rs-crypto-traits/.cargo-checksum.json", "third_party/rust/mls-rs-crypto-traits/.cargo_vcs_info.json", "third_party/rust/mls-rs-crypto-traits/Cargo.lock", "third_party/rust/mls-rs-crypto-traits/Cargo.toml", "third_party/rust/mls-rs-crypto-traits/Cargo.toml.orig", "third_party/rust/mls-rs-identity-x509/.cargo-checksum.json", "third_party/rust/mls-rs-identity-x509/.cargo_vcs_info.json", "third_party/rust/mls-rs-identity-x509/Cargo.lock", "third_party/rust/mls-rs-identity-x509/Cargo.toml", "third_party/rust/mls-rs-identity-x509/Cargo.toml.orig", "third_party/rust/mls-rs-provider-sqlite/.cargo-checksum.json", "third_party/rust/mls-rs-provider-sqlite/Cargo.toml", "third_party/rust/mls-rs-provider-sqlite/src/group_state.rs", "third_party/rust/mls-rs-provider-sqlite/src/test_utils.rs", "third_party/rust/mls-rs/.cargo-checksum.json", "third_party/rust/mls-rs/.cargo_vcs_info.json", "third_party/rust/mls-rs/Cargo.lock", "third_party/rust/mls-rs/Cargo.toml", "third_party/rust/mls-rs/Cargo.toml.orig", "third_party/rust/mls-rs/examples/basic_usage.rs", "third_party/rust/mls-rs/src/client.rs", "third_party/rust/mls-rs/src/crypto.rs", "third_party/rust/mls-rs/src/external_client/group.rs", "third_party/rust/mls-rs/src/group/builder.rs", "third_party/rust/mls-rs/src/group/commit.rs", "third_party/rust/mls-rs/src/group/exported_tree.rs", "third_party/rust/mls-rs/src/group/framing.rs", "third_party/rust/mls-rs/src/group/interop_test_vectors/passive_client.rs", "third_party/rust/mls-rs/src/group/message_processor.rs", "third_party/rust/mls-rs/src/group/mls_rules.rs", "third_party/rust/mls-rs/src/group/mod.rs", "third_party/rust/mls-rs/src/group/proposal_cache.rs", "third_party/rust/mls-rs/src/group/proposal_filter.rs", "third_party/rust/mls-rs/src/group/proposal_filter/filtering.rs", "third_party/rust/mls-rs/src/group/resumption.rs", "third_party/rust/mls-rs/src/group/secret_tree.rs", "third_party/rust/mls-rs/src/group/test_utils.rs", "third_party/rust/mls-rs/src/group/util.rs", "third_party/rust/mls-rs/src/test_utils/mod.rs", "third_party/rust/mls-rs/src/tree_kem/leaf_node.rs", "third_party/rust/mls-rs/src/tree_kem/leaf_node_validator.rs", "third_party/rust/mls-rs/src/tree_kem/mod.rs", "third_party/rust/mls-rs/src/tree_kem/node.rs", "third_party/rust/mls-rs/src/tree_kem/parent_hash.rs", "third_party/rust/mls-rs/src/tree_kem/tree_hash.rs", "third_party/rust/mls-rs/src/tree_kem/tree_index.rs", "third_party/rust/mls-rs/src/tree_kem/tree_validator.rs", "third_party/rust/mls-rs/tests/client_tests.rs", "third_party/rust/mls-rs/webdriver.json"], "git_node": "15f486a24954bdcbe7a61ab186bd64262082d0ca", "git_parents": ["4195eded6e7d309637a1b514740a19520e75b217"], "node": "5aeb3842e218ab6a75f5a64eab7003c522cc71c0", "parents": ["5bb8a48d220bc5539c2bbd3c5eb688a9cf55f5a6"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071912 - part 1: Extract the release promotion artifact mocks in test_actions.py r=bhearsum,taskgraph-reviewers,releng-reviewers\n\ntest_release_promotion registered every artifact fetch by hand as a 303 plus a\n200 on the redirect target. Pull that into helpers so the next patch, which adds\nthree more release promotion tests, does not repeat it five more times.\n\nNo behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326485\n", "files": ["taskcluster/gecko_taskgraph/test/test_actions.py"], "git_node": "4cfedcdcea7b62092a40bf47e0c7a354e5e3e2e9", "git_parents": ["15f486a24954bdcbe7a61ab186bd64262082d0ca"], "node": "4efc4bdc1ea5a4f4ae36adb759e6fbf7fc86e3aa", "parents": ["5aeb3842e218ab6a75f5a64eab7003c522cc71c0"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071912 - part 2: Re-use the partner config resolved by an earlier release phase r=bhearsum,taskgraph-reviewers,releng-reviewers\n\nI took a stab at this bug. This is not the fix suggested in the bug. Instead of\npinning a repack-manifests revision, I propose a solution that looks simpler:\nhaving the promote action task to fetch the partner config and downstream phases\nreuse it. Let me know what you think @bhearsum.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326486\n", "files": ["taskcluster/docs/partner-repacks.md", "taskcluster/gecko_taskgraph/actions/release_promotion.py", "taskcluster/gecko_taskgraph/test/test_actions.py"], "git_node": "47da738becf657528b75e980cb98c7a9af70bfc8", "git_parents": ["4cfedcdcea7b62092a40bf47e0c7a354e5e3e2e9"], "node": "fe4855f1577fae404d1bbbca95ae4358c09603a0", "parents": ["4efc4bdc1ea5a4f4ae36adb759e6fbf7fc86e3aa"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2071919 - Call ClientOpenWindow asynchronously in OpenWindowFor r=ltenenbaum\n\nSee also https://bugzilla.mozilla.org/show_bug.cgi?id=2071777.\n\nDoing this does not regress any notification/push mochitest nor WPT.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325931\n", "files": ["dom/notification/NotificationHandler.cpp"], "git_node": "108b19d01fb22718cf099e3a734032e5af8004e8", "git_parents": ["47da738becf657528b75e980cb98c7a9af70bfc8"], "node": "3e40c1953a57eb9d0606d999202fd1c00