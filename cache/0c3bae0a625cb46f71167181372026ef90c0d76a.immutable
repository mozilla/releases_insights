 FOG r=chumphreys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326741\n", "files": ["toolkit/components/glean/src/init/mod.rs", "toolkit/components/glean/tests/test_metrics.yaml", "toolkit/components/glean/tests/xpcshell/test_FOGInit.js"], "git_node": "9cba979c4d70dffbe601d09974a0ddcdbc34a312", "git_parents": ["9a8d031cbf1a3a4a2836c48671f07e6cae2eca49"], "node": "efb104f397f7e64b5cc665dcb3389676c1b799ea", "parents": ["2ddabc13a4909fd6168fb57f46e30715677ff30e"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045846: Fix CSS zoom for translations. r=layout-reviewers,firefox-style-system-reviewers,emilio,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326739\n", "files": ["gfx/layers/AnimationInfo.cpp", "layout/generic/nsIFrame.cpp", "layout/painting/ActiveLayerTracker.cpp", "layout/painting/nsDisplayList.cpp", "layout/style/StyleAnimationValue.cpp", "layout/style/nsComputedDOMStyle.cpp", "layout/style/nsStyleTransformMatrix.cpp", "layout/style/nsStyleTransformMatrix.h", "layout/svg/SVGUtils.cpp", "testing/web-platform/tests/css/css-viewport/zoom/reference/translate-zoom-anim-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-matrix-zoom-anim-accumulate.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-matrix-zoom-anim-accumulated-computed.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-zoom-anim-calc.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-zoom-anim-computed.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-zoom-anim.html"], "git_node": "3b6da5ad431b087febe7df13e610fbae912651a2", "git_parents": ["9cba979c4d70dffbe601d09974a0ddcdbc34a312"], "node": "c28394f7881d395f7f124837cefb62d4f87fa4fb", "parents": ["efb104f397f7e64b5cc665dcb3389676c1b799ea"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057686 - Add scrollable screenshot API to Android Components r=android-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327205\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineView.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineViewTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/EngineView.kt"], "git_node": "b6fd0a7f635086383aee3d0b8339c605a6dbefcb", "git_parents": ["3b6da5ad431b087febe7df13e610fbae912651a2"], "node": "f5f50e224da87abad4ef5a688816111567b4a2c5", "parents": ["c28394f7881d395f7f124837cefb62d4f87fa4fb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073608 - Tweak new tab search bar border radius. r=daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327447\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "5d5734b57bafb2d5dc40bb8d024599d60ff24251", "git_parents": ["b6fd0a7f635086383aee3d0b8339c605a6dbefcb"], "node": "82a2c1a36466dab2daf3e2afaae02d2783dc24c7", "parents": ["f5f50e224da87abad4ef5a688816111567b4a2c5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072670 - Implement HNT Search Logos Experiment Variant B. r=daleharvey,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327337\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarNewTabComponentRegistrant.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_engineWordmark.js", "browser/components/urlbar/tests/browser-newtab/browser_variantB.js", "browser/themes/shared/urlbar.css", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "ba73db6745d8fca8615e3bd0e8d9783c2229f1fc", "git_parents": ["5d5734b57bafb2d5dc40bb8d024599d60ff24251"], "node": "7938cffbb46ed90ca63dbf023ea5afdcbfd1b575", "parents": ["82a2c1a36466dab2daf3e2afaae02d2783dc24c7"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073030 - Lint all startupcache headers through clang-tidy r=emilio\n\nChanges includes:\n- using C++20 type aliases and inline variables\n\nAll changes were detected and fixed by clang-tidy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327359\n", "files": ["startupcache/StartupCache.h"], "git_node": "fce1b189572e6d3b916d2c37b2a399aacfdb4bd0", "git_parents": ["ba73db6745d8fca8615e3bd0e8d9783c2229f1fc"], "node": "e61ef4a3b91932a52c2b8eb86d9fb149127b7b45", "parents": ["7938cffbb46ed90ca63dbf023ea5afdcbfd1b575"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073480 - Lint all mozglue/ headers through clang-tidy r=profiler-reviewers,canova\n\nChanges includes:\n- using C++20 type aliases and inline variables\n- making deleted methods public\n- making some methods default\n- use nullptr instead of plain zeroes\n- rework some include dependencies to make header self contained\n- do *not* use = delete for private constructors that actually have an\n  implementation in cpp files.\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327341\n", "files": ["mozglue/baseprofiler/public/BaseProfiler.h", "mozglue/baseprofiler/public/BaseProfilingStack.h", "mozglue/baseprofiler/public/ModuloBuffer.h", "mozglue/baseprofiler/public/ProfileBufferChunkManagerSingle.h", "mozglue/baseprofiler/public/ProfileBufferEntrySerialization.h", "mozglue/baseprofiler/public/ProfileBufferIndex.h", "mozglue/interposers/pthread_atfork.h", "mozglue/misc/PlatformConditionVariable.h", "mozglue/misc/PlatformMutex.h", "mozglue/misc/PlatformRWLock.h", "mozglue/misc/Printf.h", "mozglue/misc/TimeStamp.h"], "git_node": "f0b2999971b1b3469c53cb769d818052692fce1b", "git_parents": ["fce1b189572e6d3b916d2c37b2a399aacfdb4bd0"], "node": "c0ab04a87ab295a7df8547fa12103a13554ed538", "parents": ["e61ef4a3b91932a52c2b8eb86d9fb149127b7b45"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073479 - Make all modules/ headers compatible with clang-tidy r=lsalzman,gstoll\n\nIn that specific cases, it boils down to making every header\nself-contained.\n\nAll changes were detected either by header compilation failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327333\n", "files": ["modules/libmar/src/mar_cmdline.h", "modules/libpref/nsRelativeFilePref.h"], "git_node": "5ac4b94adc9c139e053c6b2d27c890fd705985cb", "git_parents": ["f0b2999971b1b3469c53cb769d818052692fce1b"], "node": "4bbfc0ac9bf66fff4a4314fda67c621998c1331e", "parents": ["c0ab04a87ab295a7df8547fa12103a13554ed538"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073471 - Lint all hal/ headers through clang-tidy r=gsvelto\n\nChanges includes:\n- using for-range loops\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327329\n", "files": ["hal/HalWakeLock.h", "hal/linux/UdevLib.h"], "git_node": "91e19c6d8f945339d8d9c81db672d41b59ca5a46", "git_parents": ["5ac4b94adc9c139e053c6b2d27c890fd705985cb"], "node": "0ee0769cbfa4c326b24a64e81234d46c364410dc", "parents": ["4bbfc0ac9bf66fff4a4314fda67c621998c1331e"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073266 - Recover the stack pointer after the import wrapper's call. r=rhunt\n\nThe wasm import wrapper reads its instance slot and runs its epilogue at\nframe-pointer-relative offsets computed from framePushed, which assumes the\nstack pointer is unchanged across the call. A callee that ends in a return\ncall collapses frames and can leave the stack pointer elsewhere, so restore\nit from the frame pointer before reading those slots.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327347\n", "files": ["js/src/wasm/WasmStubs.cpp"], "git_node": "d0818e33a9a72c3c0b46e6a141a09c174f87b935", "git_parents": ["91e19c6d8f945339d8d9c81db672d41b59ca5a46"], "node": "f4242b6d13f807edd7a25ed8f481fc7243359dff", "parents": ["0ee0769cbfa4c326b24a64e81234d46c364410dc"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068340 - Plumb aFromParser through nsXMLContentSink r=dom-core-reviewers,smaug\n\nThis change ensures that nsXMLContentSink::HandleStartElement properly\npasses through the parser origin.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325403\n", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xml/nsXMLFragmentContentSink.cpp"], "git_node": "4edd1f2de2584ee6f34e09fd30ff0d66c52ea216", "git_parents": ["d0818e33a9a72c3c0b46e6a141a09c174f87b935"], "node": "8376abdfd147b73b3166ac5dac17043eef8632b0", "parents": ["f4242b6d13f807edd7a25ed8f481fc7243359dff"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073656 - PageExtractor telemetry bypasses OHTTP and includes automatic client metadata r=ai-platform-reviewers,nordzilla,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327501\n", "files": ["toolkit/components/pageextractor/pings.yaml"], "git_node": "dfcfebc69d9a2edd76d66beeefa3cd78842f934c", "git_parents": ["4edd1f2de2584ee6f34e09fd30ff0d66c52ea216"], "node": "779c26b4c7dc6802ba7d1f8ca50ffdde8dfe1e12", "parents": ["8376abdfd147b73b3166ac5dac17043eef8632b0"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066062 - Don't report signed-in FxA status when accounts are disabled. r=skhamis\n\nupdateFxaToolbarMenu() in browser.js set fxastatus=\"signed_in\" whenever\nidentity.fxaccounts.account.device.name was non-empty, without checking identity.fxaccounts.enabled.\nA device name can be persisted without ever signing in (getLocalName persists a default on first read;\nBackupService reads it when building a backup manifest, possibly others), so a profile with Mozilla\naccounts disabled (e.g. by enterprise policy) reported fxastatus=\"signed_in\". gSync.init() also\nreturns through onFxaDisabled() before updateAllUI() can correct the attribute.\n\nThis patch gates the startup guess on syncEnabled (identity.fxaccounts.enabled) so a disabled\nprofile stays not_configured, and sets fxastatus=\"not_configured\" in onFxaDisabled() so a window\nstill converges to the expected state when the pref is flipped after startup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327053\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/browser.js", "browser/base/content/test/browser-sync/browser_sync.js"], "git_node": "a532f74b0624c2ce634cdb06cfe989564e281dea", "git_parents": ["dfcfebc69d9a2edd76d66beeefa3cd78842f934c"], "node": "40c6cce100da6fc4f682f97e208594e7ec5dd750", "parents": ["779c26b4c7dc6802ba7d1f8ca50ffdde8dfe1e12"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064404 - Accelerate early 'events' pings in FOG r=chumphreys\" for causing xpc failures @est_FOGInit.js.\n\nThis reverts commit 9cba979c4d70dffbe601d09974a0ddcdbc34a312.\n", "files": ["toolkit/components/glean/src/init/mod.rs", "toolkit/components/glean/tests/test_metrics.yaml", "toolkit/components/glean/tests/xpcshell/test_FOGInit.js"], "git_node": "454e0b8e1017aea8e8cfe224e1165e702e326bd2", "git_parents": ["a532f74b0624c2ce634cdb06cfe989564e281dea"], "node": "577d3299f0e4fbcfa225aca39b23c4e17a37beed", "parents": ["40c6cce100da6fc4f682f97e208594e7ec5dd750"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045846: Fix CSS zoom for translations. r=layout-reviewers,firefox-style-system-reviewers,emilio,dshin\" for causing mochitest failures @test_all_shorthand.html.\n\nThis reverts commit 3b6da5ad431b087febe7df13e610fbae912651a2.\n", "files": ["gfx/layers/AnimationInfo.cpp", "layout/generic/nsIFrame.cpp", "layout/painting/ActiveLayerTracker.cpp", "layout/painting/nsDisplayList.cpp", "layout/style/StyleAnimationValue.cpp", "layout/style/nsComputedDOMStyle.cpp", "layout/style/nsStyleTransformMatrix.cpp", "layout/style/nsStyleTransformMatrix.h", "layout/svg/SVGUtils.cpp", "testing/web-platform/tests/css/css-viewport/zoom/reference/translate-zoom-anim-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-matrix-zoom-anim-accumulate.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-matrix-zoom-anim-accumulated-computed.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-zoom-anim-calc.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-zoom-anim-computed.html", "testing/web-platform/tests/css/css-viewport/zoom/translate-zoom-anim.html"], "git_node": "5bb1768d5f68f5982feb7929eb59198a63884f0d", "git_parents": ["454e0b8e1017aea8e8cfe224e1165e702e326bd2"], "node": "9d96d737aee818824fcadee4f0e64206c563d3bc", "parents": ["577d3299f0e4fbcfa225aca39b23c4e17a37beed"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069430 - Enable different number of cards per col breakpoint for New Tab sections. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325532\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/CardSections.test.jsx"], "git_node": "0a0f57b99038b5df2a81c83ac9df6491f111260a", "git_parents": ["5bb1768d5f68f5982feb7929eb59198a63884f0d"], "node": "584d2fe63c2f28dcf9cd8d2c10b1707c963ed7a0", "parents": ["9d96d737aee818824fcadee4f0e64206c563d3bc"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072394 - Keep New Tab hidden story cards out of roving tabindex for keyboard navigation. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326315\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/CardSections.test.jsx"], "git_node": "af3b4127aeb3712cfceeaad1ed6d78041cea0c57", "git_parents": ["0a0f57b99038b5df2a81c83ac9df6491f111260a"], "node": "b914b6f42be3a000eabba7428031b27a824fe1ae", "parents": ["584d2fe63c2f28dcf9cd8d2c10b1707c963ed7a0"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2072429 r=dholbert,firefox-svg-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327149\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "layout/svg/SVGObserverUtils.cpp", "layout/svg/SVGObserverUtils.h"], "git_node": "0dcb137827c7a04f4b71cb46fc94857a4c09d37b", "git_parents": ["af3b4127aeb3712cfceeaad1ed6d78041cea0c57"], "node": "8c04aca58d96d245a9798e7ded84e1226850eb68", "parents": ["b914b6f42be3a000eabba7428031b27a824fe1ae"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327475\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "f9a35ab4661499d0cf0e5eeabfe6e86a17f36dce", "git_parents": ["0dcb137827c7a04f4b71cb46fc94857a4c09d37b"], "node": "e5c93ef2e40db79217d04d271cda31588ab9a0bd", "parents": ["8c04aca58d96d245a9798e7ded84e1226850eb68"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069400 - Add test for invalid remote drag invocation; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322379\n", "files": ["dom/events/test/browser.toml", "dom/events/test/browser_dragdrop_invalid_remote_drag.js"], "git_node": "b4a5b9b9defc32d7ec97dee900e4a716a44fe247", "git_parents": ["f9a35ab4661499d0cf0e5eeabfe6e86a17f36dce"], "node": "02e983bd90d47e4a8fca99228bef5f48800f2071", "parents": ["e5c93ef2e40db79217d04d271cda31588ab9a0bd"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072413 - wasm: Change rooting of throw-stub owner during an exception. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327156\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2072413.js", "js/src/jit/JitFrames.cpp"], "git_node": "35f14689b416e9d175c0114b90c9e7f835a7d9e3", "git_parents": ["b4a5b9b9defc32d7ec97dee900e4a716a44fe247"], "node": "2fca69ad1e12e674557e93e1b710335a3f223f1f", "parents": ["02e983bd90d47e4a8fca99228bef5f48800f2071"], "tags": []}, {"author": "Ben Chatterton \u003cbchatterton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071001: Cut over to better workflow DTE tests, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327011\n", "files": ["taskcluster/gecko_taskgraph/transforms/dte_test.py", "taskcluster/kinds/dte-test/kind.yml", "taskcluster/scripts/tests/run_dte_github_tests.py"], "git_node": "c12911ea9ddbf1c993a318f7132c46fda3eca954", "git_parents": ["35f14689b416e9d175c0114b90c9e7f835a7d9e3"], "node": "c239b6e116871b6d86d283ab54c588d44091c72b", "parents": ["2fca69ad1e12e674557e93e1b710335a3f223f1f"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069362 - Quota manager file streams: restore quota value in case of write failure. r=dom-storage-reviewers,jari\n\nThis prevents quota value drifting: accounting for bytes we aren't actually using.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323789\n", "files": ["dom/quota/FileStreams.cpp"], "git_node": "6755c2d762921e04ae986473276a6af52ceec9a5", "git_parents": ["c12911ea9ddbf1c993a318f7132c46fda3eca954"], "node": "907cca3e9de82a1fa86fe6e94884ca62df4a7e3e", "parents": ["c239b6e116871b6d86d283ab54c588d44091c72b"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069826 - Quota manager: remove legacy telemetry probes. r=dom-storage-reviewers,janerik,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325983\n", "files": ["dom/quota/FirstInitializationAttemptsImpl.h", "dom/quota/QuotaCommon.cpp", "dom/quota/metrics.yaml", "dom/quota/test/gtest/TestTelemetry.cpp", "dom/quota/test/xpcshell/telemetry/test_dom_quota_try.js", "dom/quota/test/xpcshell/telemetry/test_qm_first_initialization_attempt.js", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "3ec562aab5088580f436f989c5b57ef3aab2fdb8", "git_parents": ["6755c2d762921e04ae986473276a6af52ceec9a5"], "node": "c1e21e98070092584873fe8c940d49a2d9d97bdd", "parents": ["907cca3e9de82a1fa86fe6e94884ca62df4a7e3e"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068369 - read-barrier Symbol.description when recording a ref r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325565\n", "files": ["js/src/gc/AtomMarking.cpp", "js/src/jit-test/tests/gc/bug2068369.js", "js/src/vm/Compartment-inl.h"], "git_node": "d38c39a7d611f9f902ef8623d56629bfde6e59ff", "git_parents": ["3ec562aab5088580f436f989c5b57ef3aab2fdb8"], "node": "9ccaa249ea99862fbd4e979f9b727647db196cb8", "parents": ["c1e21e98070092584873fe8c940d49a2d9d97bdd"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064830: Associate the caret with the line after a paragraph's terminating newline. r=masayuki\n\nnsIFrame::PeekOffsetForParagraph never set PeekOffsetStruct::mAttach on the branch that resolves a paragraph boundary, so it inherited the constructor default of CaretAssociationHint::Before while every other peek path sets it explicitly. When the boundary is a newline inside a text node, the resolved offset falls on the edge between the text frame ending with that newline and the one starting the next line, and the default tied the caret to the former.\n\nThat stale association broke repeated Shift+Option+ArrowDown on macOS, which bug 2049117 implements as a character selection command followed by a paragraph selection command. Starting from the end of the preceding line, the character command hits the \"jumped line counts as a character\" shortcut in PeekOffsetForCharacter, returns the same content offset and only re-associates the caret. The paragraph command then starts from an unchanged offset, so the key press does nothing and every later press repeats it. Only the logical character move takes that shortcut, which is why this reproduced on every channel except macOS Nightly: bidi.edit.caret_movement_style defaults to 1 there and to 2 elsewhere.\n\nSet the hint only for a newline inside a text node, leaving a \u003cbr\u003e or a block frame boundary with the association it had before, since those do not sit on a text frame edge.\n\nRewrite the test to press repeatedly from the start of the value rather than once from a caret the test placed itself, and to run every case under bidi.edit.caret_movement_style 0, 1 and 2. Pressing once from a caret set by the test resets the association this depends on, and CI only ever exercised the value that already worked. Cover a plaintext-only editing host as well as a textarea, because it keeps the newlines in a single text node and reaches the same boundaries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322737\n", "files": ["layout/generic/nsIFrame.cpp", "widget/tests/test_paragraph_selection_with_alt_arrow_on_mac.html"], "git_node": "979996e5172983bb7245e0f7c682fd54dc506a33", "git_parents": ["d38c39a7d611f9f902ef8623d56629bfde6e59ff"], "node": "d6c4edd840d3d7353881df47e1517920284a21ce", "parents": ["9ccaa249ea99862fbd4e979f9b727647db196cb8"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010745: Derive the shortcut key from the key code when AltGraph is held while assigning a shortcut in about:keyboard. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322608\n", "files": ["browser/components/customkeys/CustomKeysParent.sys.mjs", "browser/components/customkeys/tests/browser/browser_aboutKeyboard.js", "browser/components/customkeys/tests/browser/head.js"], "git_node": "96e86d556ca2abb0c72780b6a7ab26569e492e50", "git_parents": ["979996e5172983bb7245e0f7c682fd54dc506a33"], "node": "63b9c2521cc3aea4886102937e213d43b1f2593a", "parents": ["d6c4edd840d3d7353881df47e1517920284a21ce"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2072853. Add layout/ to the root AGENTS.md directory list and point security/nss/ at its CLAUDE.md. r=ai4dev-reviewers,padenot\n\nlayout/AGENTS.md has existed since bug 2053199 but isn't in the list, so nothing\npoints at it. security/nss/ has no AGENTS.md: its CLAUDE.md is imported from\nupstream NSS, so the entry for it has to name CLAUDE.md. Also fixes a typo in\nthe same paragraph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326821\n", "files": ["AGENTS.md"], "git_node": "989eb9e4b03acaf1288ca425b5d8c5cc721810ed", "git_parents": ["96e86d556ca2abb0c72780b6a7ab26569e492e50"], "node": "dd6f8625c0ac5b48d034c789408cfddc6101be24", "parents": ["63b9c2521cc3aea4886102937e213d43b1f2593a"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-is/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "34d7e327cd6dac3dc37ef9043e1f28b261bb0ad2", "git_parents": ["989eb9e4b03acaf1288ca425b5d8c5cc721810ed"], "node": "e0f6d1b0d4a4b2a3616dcec3032748b03d3be012", "parents": ["dd6f8625c0ac5b48d034c789408cfddc6101be24"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073339 Part 1 - Don't self-steal nextFrame in current absCB's pushed child list. r=layout-reviewers,emilio\n\nIf `nextFrame`'s parent is `aDelegatingFrame`, `nextFrame` is guaranteed to be\nin the pushed absolute list, because `kidFrame` and its next-in-flow `nextFrame`\nnever co-exist in the absolute list, which is enforced in\n`PrepareAbsoluteFrames`. That is, `nextFrame` is already in the correct child\nlist. Stealing and appending it to the pushed child list makes the frame order\nwrong. (Yes, it is possible the pushed absolute child contains multiple\ncontinuations of an absolute element.)\n\nWithout this patch,\ncss/css-position/crashtests/inline-containing-block-multicol-balancing-002.html\nand css/css-break/firefox-bug-2021187-crash.html will trigger the following\nassertions when the next part adds the child list sanity check at the end of\n`AbsoluteContainingBlock::Reflow()` .\n\n```\nAssertion failure: seen.Contains(prev)\n(A frame's continuation appears before the frame in mAbsoluteFrames + mPushedAbsoluteFrames!)\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327227\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp"], "git_node": "27b606874da50aa57ba8a1972d16be0758a8b1a4", "git_parents": ["34d7e327cd6dac3dc37ef9043e1f28b261bb0ad2"], "node": "453c5cbe32fd9861afffae49115ca7b53376aee9", "parents": ["e0f6d1b0d4a4b2a3616dcec3032748b03d3be012"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073339 Part 2 - Sanity-check the child list invariants at the end of AbsoluteContainingBlock::Reflow(). r=layout-reviewers,emilio\n\nDuring Reflow(), the absolute containing block can create or move next-in-flows.\nWe'd want to make sure the child lists are still sane at the end of Reflow().\n\nAlso, split the empty child lists check into two, making it easier to identify\nthe problem.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327228\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp", "layout/generic/AbsoluteContainingBlock.h"], "git_node": "d38c49ffcf9643e0646f40118374b50b08a5f50c", "git_parents": ["27b606874da50aa57ba8a1972d16be0758a8b1a4"], "node": "8651ee0151eb146878723f7890ad5e0fe94b602f", "parents": ["453c5cbe32fd9861afffae49115ca7b53376aee9"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073465 - Tweak font-size quantization to prefer snapping to integer appUnit sizes. r=firefox-style-system-reviewers,dshin\" for causing wpt failures @update-subpixel-rem-unit.html.\n\nThis reverts commit 1056773d7e9917a214ae88a257c43c5d162234f9.\n", "files": ["servo/components/style/values/specified/font.rs", "testing/web-platform/tests/css/css-inline/firefox-bug-2073465-ref.html", "testing/web-platform/tests/css/css-inline/firefox-bug-2073465.html"], "git_node": "038f1182feae8bc738195a4631e61553095a79e2", "git_parents": ["d38c49ffcf9643e0646f40118374b50b08a5f50c"], "node": "a2ee95ab9f82df3e56e56757e4a79f2a866eaa7e", "parents": ["8651ee0151eb146878723f7890ad5e0fe94b602f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073313: Convert GuardNoAllocationMetadataBuilder into an assertion r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327201\n", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "fa901841c8db10d27810b7b0cf68e553329e2483", "git_parents": ["038f1182feae8bc738195a4631e61553095a79e2"], "node": "4ad781ac1058c32a1f9e48d87b286003a95a1be4", "parents": ["a2ee95ab9f82df3e56e56757e4a79f2a866eaa7e"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068369 - read-barrier Symbol.description when recording a ref r=jonco\" for causing SM bustages\n\nThis reverts commit d38c39a7d611f9f902ef8623d56629bfde6e59ff.\n", "files": ["js/src/gc/AtomMarking.cpp", "js/src/jit-test/tests/gc/bug2068369.js", "js/src/vm/Compartment-inl.h"], "git_node": "31c84fcd58ff0a8cad7e31c57713c4681b58e0b3", "git_parents": ["fa901841c8db10d27810b7b0cf68e553329e2483"], "node": "0b597f199db68717f5dbd8ad372e3009365724d6", "parents": ["4ad781ac1058c32a1f9e48d87b286003a95a1be4"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072025, Bug 2067198 - Remove stories section from homepage r=android-reviewers,npoon\" for causing ui-test failure\n\nThis reverts commit 735bb8049ed127a23504250e6a59bbbf24c9f5d5.\n\nRevert \"Bug 2067198 - Update HomepageHeader to the latest designs, and set the entry points experiment to false by default r=android-reviewers,npoon\"\n\nThis reverts commit 247d2295e1c911362d44985b3dfdec1a59b07ec3.\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/