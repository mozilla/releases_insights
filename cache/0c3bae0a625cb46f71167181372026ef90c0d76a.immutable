ting/web-platform/meta/permissions-policy/reporting/screen-wake-lock-reporting.https.html.ini", "testing/web-platform/meta/permissions-policy/reporting/serial-reporting.https.html.ini"], "git_node": "138803db276022b86ff3826637a029a4f5278dbe", "git_parents": ["03045c9fbf609e3e0b78644fff6c719acf16161c"], "node": "77fac5289c04cfa0776864e52d161923e477f429", "parents": ["a298af7da06a60eee5b4d01de7d834651ec69af4"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071913 - Report deliveryType \"cache\" for responses served from the HTTP cache r=avandolder,webidl,smaug\n\nResource Timing sets deliveryType to \"cache\" when the response cache mode is\n\"local\" or \"validated\" and the timing-allow check passed. Derive that from the\nchannel cache disposition so cache hits and 304 revalidations both report it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326293\n", "files": ["dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceResourceTiming.h", "dom/performance/PerformanceTiming.cpp", "dom/performance/PerformanceTiming.h", "dom/performance/PerformanceTimingTypes.ipdlh", "dom/webidl/PerformanceResourceTiming.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/resource-timing/delivery-type.tentative.any.js.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-uses-cache.sub.https.html.ini"], "git_node": "b33d077e43845ae8e0bafdd14bcb05a977a948e2", "git_parents": ["138803db276022b86ff3826637a029a4f5278dbe"], "node": "74bd5f841a67e5abbb1feab14f3cae3b5e99b28f", "parents": ["77fac5289c04cfa0776864e52d161923e477f429"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914120 - Enable PerformanceResourceTiming.deliveryType by default r=avandolder\n\nWith \"cache\" implemented, deliveryType now covers every value the spec\ndefines, so the pref can ship enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326294\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/resource-timing/delivery-type.tentative.any.js.ini", "testing/web-platform/meta/resource-timing/idlharness.any.js.ini", "testing/web-platform/meta/server-timing/idlharness.https.any.js.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-delivery-type.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-uses-cache.sub.https.html.ini"], "git_node": "02a23fc5b1e9a1f3c97794a662aaee0943a73458", "git_parents": ["b33d077e43845ae8e0bafdd14bcb05a977a948e2"], "node": "c54dfbf312703e6fd7352a9cc3e831e3ac7c2971", "parents": ["74bd5f841a67e5abbb1feab14f3cae3b5e99b28f"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053161 - Part 1: Check brave/adblock-rust into mozilla-central r=emz\n\nHard forks the adblock-rust crate at version 0.12.1\n(b8013ec56e5b29d79c6afaf92c181b11055e5fa8). This commit is pristine upstream: the\nfiles are byte-identical to that revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318428\n", "files": ["toolkit/components/content-classifier/etp_engine/Cargo.toml", "toolkit/components/content-classifier/etp_engine/LICENSE", "toolkit/components/content-classifier/etp_engine/README.md", "toolkit/components/content-classifier/etp_engine/rustfmt.toml", "toolkit/components/content-classifier/etp_engine/src/blocker.rs", "toolkit/components/content-classifier/etp_engine/src/content_blocking.rs", "toolkit/components/content-classifier/etp_engine/src/cosmetic_filter_cache.rs", "toolkit/components/content-classifier/etp_engine/src/cosmetic_filter_cache_builder.rs", "toolkit/components/content-classifier/etp_engine/src/cosmetic_filter_utils.rs", "toolkit/components/content-classifier/etp_engine/src/data_format/mod.rs", "toolkit/components/content-classifier/etp_engine/src/engine.rs", "toolkit/components/