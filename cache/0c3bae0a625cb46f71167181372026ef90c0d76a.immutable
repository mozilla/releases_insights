/cyclonedx_python_lib-11.11.0.dist-info/METADATA", "third_party/python/cyclonedx_python_lib/cyclonedx_python_lib-11.11.0.dist-info/RECORD", "third_party/python/cyclonedx_python_lib/cyclonedx_python_lib-11.11.0.dist-info/WHEEL", "third_party/python/cyclonedx_python_lib/cyclonedx_python_lib-11.11.0.dist-info/licenses/LICENSE", "third_party/python/cyclonedx_python_lib/cyclonedx_python_lib-11.11.0.dist-info/licenses/NOTICE", "third_party/python/defusedxml/defusedxml-0.7.1.dist-info/LICENSE", "third_party/python/defusedxml/defusedxml-0.7.1.dist-info/METADATA", "third_party/python/defusedxml/defusedxml-0.7.1.dist-info/RECORD", "third_party/python/defusedxml/defusedxml-0.7.1.dist-info/WHEEL", "third_party/python/defusedxml/defusedxml-0.7.1.dist-info/top_level.txt", "third_party/python/defusedxml/defusedxml/ElementTree.py", "third_party/python/defusedxml/defusedxml/__init__.py", "third_party/python/defusedxml/defusedxml/cElementTree.py", "third_party/python/defusedxml/defusedxml/common.py", "third_party/python/defusedxml/defusedxml/expatbuilder.py", "third_party/python/defusedxml/defusedxml/expatreader.py", "third_party/python/defusedxml/defusedxml/lxml.py", "third_party/python/defusedxml/defusedxml/minidom.py", "third_party/python/defusedxml/defusedxml/pulldom.py", "third_party/python/defusedxml/defusedxml/sax.py", "third_party/python/defusedxml/defusedxml/xmlrpc.py", "third_party/python/license_expression/license_expression-30.4.4.dist-info/METADATA", "third_party/python/license_expression/license_expression-30.4.4.dist-info/RECORD", "third_party/python/license_expression/license_expression-30.4.4.dist-info/WHEEL", "third_party/python/license_expression/license_expression-30.4.4.dist-info/licenses/AUTHORS.rst", "third_party/python/license_expression/license_expression-30.4.4.dist-info/licenses/CHANGELOG.rst", "third_party/python/license_expression/license_expression-30.4.4.dist-info/licenses/CODE_OF_CONDUCT.rst", "third_party/python/license_expression/license_expression-30.4.4.dist-info/licenses/NOTICE", "third_party/python/license_expression/license_expression-30.4.4.dist-info/licenses/README.rst", "third_party/python/license_expression/license_expression-30.4.4.dist-info/licenses/apache-2.0.LICENSE", "third_party/python/license_expression/license_expression-30.4.4.dist-info/top_level.txt", "third_party/python/license_expression/license_expression/__init__.py", "third_party/python/license_expression/license_expression/_pyahocorasick.ABOUT", "third_party/python/license_expression/license_expression/_pyahocorasick.py", "third_party/python/license_expression/license_expression/data/cc-by-4.0.LICENSE", "third_party/python/license_expression/license_expression/data/license_key_index.json.ABOUT", "third_party/python/license_expression/license_expression/data/scancode-licensedb-index.json", "third_party/python/packageurl_python/packageurl/__init__.py", "third_party/python/packageurl_python/packageurl/contrib/__init__.py", "third_party/python/packageurl_python/packageurl/contrib/django/__init__.py", "third_party/python/packageurl_python/packageurl/contrib/django/filters.py", "third_party/python/packageurl_python/packageurl/contrib/django/models.py", "third_party/python/packageurl_python/packageurl/contrib/django/utils.py", "third_party/python/packageurl_python/packageurl/contrib/purl2url.py", "third_party/python/packageurl_python/packageurl/contrib/route.py", "third_party/python/packageurl_python/packageurl/contrib/sqlalchemy/mixin.py", "third_party/python/packageurl_python/packageurl/contrib/url2purl.py", "third_party/python/packageurl_python/packageurl/py.typed", "third_party/python/packageurl_python/packageurl/utils.py", "third_party/python/packageurl_python/packageurl/validate.py", "third_party/python/packageurl_python/packageurl_python-0.17.6.dist-info/METADATA", "third_party/python/packageurl_python/packageurl_python-0.17.6.dist-info/RECORD", "third_party/python/packageurl_python/packageurl_python-0.17.6.dist-info/WHEEL", "third_party/python/packageurl_python/packageurl_python-0.17.6.dist-info/top_level.txt", "third_party/python/py_serializable/py_serializable-2.1.0.dist-info/LICENSE", "third_party/python/py_serializable/py_serializable-2.1.0.dist-info/METADATA", "third_party/python/py_serializable/py_serializable-2.1.0.dist-info/RECORD", "third_party/python/py_serializable/py_serializable-2.1.0.dist-info/WHEEL", "third_party/python/py_serializable/py_serializable/__init__.py", "third_party/python/py_serializable/py_serializable/formatters.py", "third_party/python/py_serializable/py_serializable/helpers.py", "third_party/python/py_serializable/py_serializable/json.py", "third_party/python/py_serializable/py_serializable/py.typed", "third_party/python/py_serializable/py_serializable/xml.py", "third_party/python/pyproject.toml", "third_party/python/requirements.txt", "third_party/python/sortedcontainers/sortedcontainers-2.4.0.dist-info/LICENSE", "third_party/python/sortedcontainers/sortedcontainers-2.4.0.dist-info/METADATA", "third_party/python/sortedcontainers/sortedcontainers-2.4.0.dist-info/RECORD", "third_party/python/sortedcontainers/sortedcontainers-2.4.0.dist-info/WHEEL", "third_party/python/sortedcontainers/sortedcontainers-2.4.0.dist-info/top_level.txt", "third_party/python/sortedcontainers/sortedcontainers/__init__.py", "third_party/python/sortedcontainers/sortedcontainers/sorteddict.py", "third_party/python/sortedcontainers/sortedcontainers/sortedlist.py", "third_party/python/sortedcontainers/sortedcontainers/sortedset.py", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "fd334e02303459a09cb81d76593d8f85d72292e1", "git_parents": ["423c9e4d8f92a70804171a9086e6389cd3c08105"], "node": "807a48429305d8eff8e8ea737b2b0b91ddd1ada1", "parents": ["c373049113ef0cafd5b20b0d0029ffe673fdd767"], "tags": []}, {"author": "tannal \u003cmtan@igalia.com\u003e", "branch": "default", "desc": "Bug 2068934 - Support javascriptURLs in the configuration of sanitizer. r=tschuster,webidl,smaug,keithamus\n\nWhen javascriptURLs is set to false, unsafe methods will remove javascript URLs from the input.\n\nIn Safe methods javascript URLs always be removed regardless of config.\n\nUpdated related comments in the sanitizer.\n\nImplements https://github.com/whatwg/html/pull/12898\n\nWPT: https://github.com/web-platform-tests/wpt/pull/62421\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324577\n", "files": ["dom/security/sanitizer/Sanitizer.cpp", "dom/security/sanitizer/Sanitizer.h", "dom/webidl/Sanitizer.webidl", "testing/web-platform/meta/sanitizer-api/sanitizer-boolean-defaults.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-config.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-default-config.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-modifiers.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-removeUnsafe.html.ini"], "git_node": "55c2874c6973d4114c2bbeebeb20f881b5820c99", "git_parents": ["fd334e02303459a09cb81d76593d8f85d72292e1"], "node": "4ea3045980a2783159c7bd7d495a0b5c3134cd95", "parents": ["807a48429305d8eff8e8ea737b2b0b91ddd1ada1"], "tags": []}, {"author": "Perf AI Bot \u003cperf-ai-bot@bmo.tld\u003e", "branch": "default", "desc": "Bug 2066583 - Add compile-time-length overloads for HTML parser ASCII literal comparisons, using an exact-length check and bounded character comparison. r=hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321375\n", "files": ["parser/html/nsHtml5String.h"], "git_node": "05924a8db751fce4d6ed08a39911c076ba6a7af4", "git_parents": ["55c2874c6973d4114c2bbeebeb20f881b5820c99"], "node": "ae614284d88f761d1fc54b8c95fd36e3dd2139c4", "parents": ["4ea3045980a2783159c7bd7d495a0b5c3134cd95"], "tags": []}, {"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069954 - Add Glean telemetry for login storage operation timings and initialization phases r=joschmidt,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324390\n", "files": ["toolkit/components/passwordmgr/LoginManager.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/storage-desktop.sys.mjs", "toolkit/components/passwordmgr/storage-geckoview.sys.mjs", "toolkit/components/passwordmgr/storage-json.sys.mjs", "toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_login_storage_migrator.js"], "git_node": "8bd3b051959a87acb8df94d1cdb6b3b1f1b1207b", "git_parents": ["05924a8db751fce4d6ed08a39911c076ba6a7af4"], "node": "36ee54c2cf6f8a8d0b067af995097bb7d0bb089c", "parents": ["ae614284d88f761d1fc54b8c95fd36e3dd2139c4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2070936 - Stop the async-storage setItem error handler retaining the stored value, r=devtools-reviewers,nchevobbe.\n\nThe debugger writes pending breakpoints, blackboxed ranges and opened URLs\nthrough asyncStorage.setItem() without awaiting the result, so a write can still\nbe in flight when the toolbox is destroyed. setItemOnError does not use the\nvalue, but it is created in setItem()'s scope and so keeps it alive, and the\nvalue reaches the debugger window through the browser loader sandbox it was\ncreated in and that sandbox's window.console. That is the \"leaked 1 window(s)\nuntil shutdown [url = about:devtools-toolbox]\" failure on\nbrowser_dbg-editor-gutter.js and browser_dbg-expressions.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325042\n", "files": ["devtools/shared/async-storage.js"], "git_node": "e5383ed9525a04cb2d0e5d2f498c5b6ed5a0c141", "git_parents": ["8bd3b051959a87acb8df94d1cdb6b3b1f1b1207b"], "node": "8c4f1c24d5ad8476dd6af5c734e59fcc2d4102d8", "parents": ["36ee54c2cf6f8a8d0b067af995097bb7d0bb089c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071237 - [devtools] Let the object inspector tolerate an object actor that has gone away, r=devtools-reviewers,nchevobbe.\n\n`loadItemProperties` issues its requests in one `Promise.all`, where the five\n`enum*` helpers treat a failed request as \"no data\" and `getPrototype`,\n`getGlobal`, `getPromiseState` and `getProxySlots` reject. Inline previews run\nfrom a floating promise in `fetchScopes`, so an object actor released under\n`getPrototype` leaves an unhandled `Protocol error (noSuchActor)`, which fails\nbrowser_dbg-reloading.js on linux tsan.\n\nThe catches swallow every error rather than only actor death, in a helper the\nconsole, inspector and netmonitor share too; that is what the five `enum*`\nsiblings already do, so this makes the four outliers consistent rather than\nadding a behaviour.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325406\n", "files": ["devtools/client/shared/components/object-inspector/utils/client.js"], "git_node": "0fb28da138195cb0a96f9588369d9fca8b6050bd", "git_parents": ["e5383ed9525a04cb2d0e5d2f498c5b6ed5a0c141"], "node": "2884a072bc47dea444c600c840c38127deb13b03", "parents": ["8c4f1c24d5ad8476dd6af5c734e59fcc2d4102d8"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071230 - Move the rules view source link click handler onto the link, r=nchevobbe.\n\nThe handler was on the wrapper div rather than the anchor it wraps, so\ngetRuleViewLinkByIndex handed tests a click target with no accessible,\nwhich is what the Bug 1849028 annotations absorbed. Moving it makes the\nhandler and the click target coincide; the helper now returns the anchor\nand the seven tests that reached through it follow.\n\nbrowser_dbg-telemetry-stylesheets.js also fails on the debugger's source\ntree, so its annotation only retires once Bug 2070909 has landed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325409\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-telemetry-stylesheets.js", "devtools/client/framework/browser-toolbox/test/browser_browser_toolbox_ruleview_stylesheet.js", "devtools/client/inspector/rules/test/browser_part2.toml", "devtools/client/inspector/rules/test/browser_rules_invalid-source-map.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link2.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/views/rule-editor.js", "devtools/client/inspector/test/shared-head.js", "devtools/client/styleeditor/test/browser_styleeditor_telemetry.js"], "git_node": "86c5a3759970b93946280f0516e1d8b2900c6003", "git_parents": ["0fb28da138195cb0a96f9588369d9fca8b6050bd"], "node": "76e004e4525e0b72d733cb0549b7222d502b032c", "parents": ["2884a072bc47dea444c600c840c38127deb13b03"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071228 - Name the custom formatter collapse button, r=devtools-reviewers,nchevobbe.\n\nThe button is image-only and had no accessible name, which is what the\nBug 1849028 annotations absorbed. Reps has no localization, so the string\nis untranslated like the others in that directory.\n\nbrowser_dbg-custom-formatters.js also clicks the button inside the Scopes\ntree, where it is unfocusable until Bug 2070909 lands, so its annotation\nonly retires after that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325410\n", "files": ["devtools/client/shared/components/reps/reps/custom-formatter.mjs", "devtools/client/webconsole/test/browser/_webconsole_ak.toml"], "git_node": "981317c3730b8f5b8709c8e3d4d28532ca39d1c1", "git_parents": ["86c5a3759970b93946280f0516e1d8b2900c6003"], "node": "bc380ae3aa70cf6146a23201d4ac12546fb3f3ce", "parents": ["76e004e4525e0b72d733cb0549b7222d502b032c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071233 - Label the DOM mutation breakpoint checkboxes, r=devtools-reviewers,nchevobbe.\n\nThe enable checkbox of a DOM mutation breakpoint had no accessible name. The\nname has to carry the node as well as the mutation type, or every checkbox in\nthe pane sharing a type reads the same. It cannot be borrowed from the row with\naria-labelledby, because the node label is a Rep which renders an \"open in\ninspector\" button whose title would be pulled in, so it is composed from the\nnode front instead.\n\nThe a11y_checks annotations this retires were filed as Bug 1849028.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325412\n", "files": ["devtools/client/debugger/src/components/SecondaryPanes/DOMMutationBreakpoints.js", "devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/locales/en-US/debugger.properties"], "git_node": "2b4123ea84a47a35f923ece4135a82f90e67c865", "git_parents": ["981317c3730b8f5b8709c8e3d4d28532ca39d1c1"], "node": "25f0cc0ef1970c1a08af5e3aa2529f278c32359f", "parents": ["bc380ae3aa70cf6146a23201d4ac12546fb3f3ce"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071236 - Make the debugger's thread list rows real buttons, r=nchevobbe.\n\nA row in the Threads pane was a clickable div, so it had no interactive\naccessible and no way to reach it from the keyboard. A button gets both for\nfree, and aria-pressed carries the selection, for assistive technology and for\nthe styling alike.\n\nThe a11y_checks annotations this retires were filed as Bug 1849028.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325414\n", "files": ["devtools/client/debugger/src/components/SecondaryPanes/Thread.js", "devtools/client/debugger/src/components/SecondaryPanes/Threads.css", "devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/debugger/test/mochitest/browser_dbg-inspector-integration.js", "devtools/client/debugger/test/mochitest/browser_dbg-windowless-workers.js", "devtools/client/debugger/test/mochitest/browser_gp.toml"], "git_node": "2e837086a5d07aba881e86960d5009a607f977a1", "git_parents": ["2b4123ea84a47a35f923ece4135a82f90e67c865"], "node": "d6d44a3b78438a0ea364cf30fa23c87cbc666fe3", "parents": ["25f0cc0ef1970c1a08af5e3aa2529f278c32359f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2067078 - Name the clicked node when an a11y check falls back to another node, r=Jamie.\n\nfindInteractiveAccessible() walks up from the clicked node until it finds an\ninteractive accessible, so the five checks in assertCanBeClicked often report on\na node the test never clicked, with nothing in the failure to connect the two.\nName the clicked node as well.\n\nThe clause is added in buildMessage rather than at one failure site because all\nfive checks mislead identically. Only the message changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321903\n", "files": ["testing/mochitest/tests/SimpleTest/AccessibilityUtils.js"], "git_node": "81d7809c0533e77e52f9c6714a7d200785fdc838", "git_parents": ["2e837086a5d07aba881e86960d5009a607f977a1"], "node": "91565d4c5dc6fdc26599949860e2126f3ff80985", "parents": ["d6d44a3b78438a0ea364cf30fa23c87cbc666fe3"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071182 - Keep NetworkGeolocationProvider shut down when a request settles after shutdown(). r=geoprovider-reviewers,saschanaz,handyman\n\nThe backoff handling added in bug 2048118 calls resetTimer() from the\nrequest completion paths. Neither checks whether the provider is still\nstarted, so a request that was in flight when shutdown() ran re-armed the\nrepeating timer and the provider kept issuing requests with no listener for\nthe rest of the session. Every system-provider fallback start/cancel cycle\ncould leave one such instance behind.\n\nMake resetTimer() a no-op once the provider is shut down, and abort in-flight\nrequests from shutdown() so they settle right away. Add an xpcshell test that\nshuts the provider down mid-request and checks that no provider timer\nremains once the request completes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325308\n", "files": ["dom/geolocation/test/unit/test_geolocation_provider_shutdown.js", "dom/geolocation/test/unit/xpcshell.toml", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "7a352ac1f472cb4adee9a4f04e7213d92831d6fa", "git_parents": ["81d7809c0533e77e52f9c6714a7d200785fdc838"], "node": "c34eb80173d0274eda3fb31d874b12b7a844e6f9", "parents": ["91565d4c5dc6fdc26599949860e2126f3ff80985"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068713 - Build the desktop select popup from the DOM's option list r=emilio,dom-core-reviewers,webidl,smaug\n\nSelectChild reimplemented the option list traversal in JS, so it diverged from\nHTMLSelectElement whenever that changed, such as the recent change to find\noptions nested inside wrapper elements.\n\nExpose two chrome-only APIs, HTMLOptionElement.renderedLabel and\nHTMLSelectElement.getListItems, so the UA popups can ask the DOM for the list\nrather than reimplement it. What is left in SelectChild is a mapping onto the\ninfo the parent process needs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323015\n", "files": ["browser/base/content/test/forms/browser.toml", "browser/base/content/test/forms/browser_selectpopup_option_list.js", "dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h", "dom/html/test/forms/mochitest.toml", "dom/html/test/forms/test_select_list_items.html", "dom/webidl/HTMLOptionElement.webidl", "dom/webidl/HTMLSelectElement.webidl", "toolkit/actors/SelectChild.sys.mjs"], "git_node": "c75fe7db4cc2e932f198916dbd53f1fc35cf8cd3", "git_parents": ["7a352ac1f472cb4adee9a4f04e7213d92831d6fa"], "node": "2ea68ab4b62d29e331d442b6766799f015de6607", "parents": ["c34eb80173d0274eda3fb31d874b12b7a844e6f9"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068711 - Build the Android select prompt from the DOM's option list r=emilio,geckoview-reviewers,tcampbell\n\nGeckoViewPrompt walked the select's direct children plus one level of optgroup,\nso an \u003coption\u003e inside a wrapper element was dropped from the choice dialog\nentirely rather than merely mis-rendered. It was the last copy of the option\nlist traversal, and the reason nested options never worked on Android.\n\nUse getListItems and renderedLabel, as the desktop popup now does, which leaves\nthis as a mapping onto the native choice items.\n\nDrive-by: assign each item's id before recursing into an optgroup. It was\nassigned afterwards, so an optgroup and its first member ended up with the same\nid, and the id-to-element map disagreed with the item that carried it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323014\n", "files": ["mobile/android/geckoview/src/androidTest/assets/www/select-nested.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PromptDelegateTest.kt", "mobile/shared/components/geckoview/GeckoViewPrompt.sys.mjs"], "git_node": "954e4abb122da46489dcd7b2745642af358bfb63", "git_parents": ["c75fe7db4cc2e932f198916dbd53f1fc35cf8cd3"], "node": "1fb1ac00ef2c7594325a7245739d4ac5bba388be", "parents": ["2ea68ab4b62d29e331d442b6766799f015de6607"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068934 - delete sanitizer-javascript-url.html.ini manifest because test are passing r=mtan\n", "files": ["testing/web-platform/meta/sanitizer-api/sanitizer-javascript-url.html.ini"], "git_node": "d1c4c600e21f24ed87c37edcc6d741abf46917cf", "git_parents": ["954e4abb122da46489dcd7b2745642af358bfb63"], "node": "503330b78094ffa4bc02f7ce82d9d04d21cf086f", "parents": ["1fb1ac00ef2c7594325a7245739d4ac5bba388be"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071236 - Make the debugger's thread list rows real buttons, r=nchevobbe.\" for causing dt failures @ browser_markup_dom_mutation_breakpoints.js & browser_styleeditor_telemetry.js\n\nThis reverts commit 2e837086a5d07aba881e86960d5009a607f977a1.\n", "files": ["devtools/client/debugger/src/components/SecondaryPanes/Thread.js", "devtools/client/debugger/src/components/SecondaryPanes/Threads.css", "devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/debugger/test/mochitest/browser_dbg-inspector-integration.js", "devtools/client/debugger/test/mochitest/browser_dbg-windowless-workers.js", "devtools/client/debugger/test/mochitest/browser_gp.toml"], "git_node": "3f2ac22ca29714bc360b6a9c32b41f497168a3b4", "git_parents": ["d1c4c600e21f24ed87c37edcc6d741abf46917cf"], "node": "a4a72a81ee97f7ab468deb6e1a3dd47cabc7d1e5", "parents": ["503330b78094ffa4bc02f7ce82d9d04d21cf086f"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071233 - Label the DOM mutation breakpoint checkboxes, r=devtools-reviewers,nchevobbe.\" for causing dt failures @ browser_markup_dom_mutation_breakpoints.js & browser_styleeditor_telemetry.js\n\nThis reverts commit 2b4123ea84a47a35f923ece4135a82f90e67c865.\n", "files": ["devtools/client/debugger/src/components/SecondaryPanes/DOMMutationBreakpoints.js", "devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/locales/en-US/debugger.properties"], "git_node": "ac1007e55191acfae22842210466391008ed387c", "git_parents": ["3f2ac22ca29714bc360b6a9c32b41f497168a3b4"], "node": "580bd24ece2bf056b8dfb7b42d3c8b85337283c1", "parents": ["a4a72a81ee97f7ab468deb6e1a3dd47cabc7d1e5"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071228 - Name the custom formatter collapse button, r=devtools-reviewers,nchevobbe.\" for causing dt failures @ browser_markup_dom_mutation_breakpoints.js & browser_styleeditor_telemetry.js\n\nThis reverts commit 981317c3730b8f5b8709c8e3d4d28532ca39d1c1.\n", "files": ["devtools/client/shared/components/reps/reps/custom-formatter.mjs", "devtools/client/webconsole/test/browser/_webconsole_ak.toml"], "git_node": "b0870de4ab86a5d01c88698ce4c06430ca790788", "git_parents": ["ac1007e55191acfae22842210466391008ed387c"], "node": "904c9307a368f574b0249b90a08a578f191f0b25", "parents": ["580bd24ece2bf056b8dfb7b42d3c8b85337283c1"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071230 - Move the rules view source link click handler onto the link, r=nchevobbe.\" for causing dt failures @ browser_markup_dom_mutation_breakpoints.js & browser_styleeditor_telemetry.js\n\nThis reverts commit 86c5a3759970b93946280f0516e1d8b2900c6003.\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-telemetry-stylesheets.js", "devtools/client/framework/browser-toolbox/test/browser_browser_toolbox_ruleview_stylesheet.js", "devtools/client/inspector/rules/test/browser_part2.toml", "devtools/client/inspector/rules/test/browser_rules_invalid-source-map.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link2.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/views/rule-editor.js", "devtools/client/inspector/test/shared-head.js", "devtools/client/styleeditor/test/browser_styleeditor_telemetry.js"], "git_node": "817a4264167c3984fbc007bc96b0392940a2e0b0", "git_parents": ["b0870de4ab86a5d01c88698ce4c06430ca790788"], "node": "f26459fd68cc5bd3a52d26875a23f46ef87ffec7", "parents": ["904c9307a368f574b0249b90a08a578f191f0b25"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071237 - [devtools] Let the object inspector tolerate an object actor that has gone away, r=devtools-reviewers,nchevobbe.\" for causing dt failures @ browser_markup_dom_mutation_breakpoints.js & browser_styleeditor_telemetry.js\n\nThis reverts commit 0fb28da138195cb0a96f9588369d9fca8b6050bd.\n", "files": ["devtools/client/shared/components/object-inspector/utils/client.js"], "git_node": "724b34895fd3a6aa37b345c6ded821e03e888caf", "git_parents": ["817a4264167c3984fbc007bc96b0392940a2e0b0"], "node": "639209075e58684c7a2ce12f8840f12e6aa1f2c0", "parents": ["f26459fd68cc5bd3a52d26875a23f46ef87ffec7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070936 - Stop the async-storage setItem error handler retaining the stored value, r=devtools-reviewers,nchevobbe.\" for causing dt failures @ browser_markup_dom_mutation_breakpoints.js & browser_styleeditor_telemetry.js\n\nThis reverts commit e5383ed9525a04cb2d0e5d2f498c5b6ed5a0c141.\n", "files": ["devtools/shared/async-storage.js"], "git_node": "0f63b53912513c70a4fd8a83c3d63deb14842144", "git_parents": ["724b34895fd3a6aa37b345c6ded821e03e888caf"], "node": "4637c397d91284f836a28efcb7811d6dac3c16a5", "parents": ["639209075e58684c7a2ce12f8840f12e6aa1f2c0"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062203 - Handle a null wrapper target in UncheckedUnwrapWithoutExpose (Coverity CID 1412072) r=spidermonkey-reviewers,sfink\n\nThe loop dereferenced `wrapped` at the top of the next iteration without\nrechecking it, even though `WrapperObject::target()` can return null: this\nhappens when getting a weakmap key delegate() on a wrapper whose referent has\nbeen moved while it is still unmarked, which is exactly the case the existing\ncomment describes.\n\nFold the two exit conditions into the loop condition so the null check also\ncovers the next iteration. As a side effect the function no longer crashes when\nhanded a null argument.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317483\n", "files": ["js/src/proxy/Wrapper.cpp"], "git_node": "2ec2a95db2e346a11c352c739362d0505f7e2669", "git_parents": ["0f63b53912513c70a4fd8a83c3d63deb14842144"], "node": "12c51bbb267076a26cc5403ebd7acae04592b2af", "parents": ["4637c397d91284f836a28efcb7811d6dac3c16a5"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064227 Update ffvpx to ffmpeg 9.0.1 r=padenot\n\nThis commit updates local ffvpx copy to official ffmpeg 9.0.1 release with Mozilla specific changes applied.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321843\n", "files": ["dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/bsf.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_id.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/frame.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/pixfmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/version.h", "media/ffvpx/README_MOZILLA", "media/ffvpx/config_android_x86_64.asm", "media/ffvpx/config_components_audio_only.h", "media/ffvpx/config_components_audio_video.h", "media/ffvpx/config_darwin64.asm", "media/ffvpx/config_darwin64.h", "media/ffvpx/config_unix64.asm", "media/ffvpx/config_win32.asm", "media/ffvpx/config_win64.asm", "media/ffvpx/libavcodec/aarch64/vp9lpf_16bpp_neon.S", "media/ffvpx/libavcodec/aarch64/vp9lpf_neon.S", "media/ffvpx/libavcodec/allcodecs.c", "media/ffvpx/libavcodec/aom_film_grain.c", "media/ffvpx/libavcodec/aom_film_grain.h", "media/ffvpx/libavcodec/aom_film_grain_template.c", "media/ffvpx/libavcodec/arm/hpeldsp_arm.S", "media/ffvpx/libavcodec/arm/jrevdct_arm.S", "media/ffvpx/libavcodec/arm/simple_idct_arm.S", "media/ffvpx/libavcodec/arm/simple_idct_armv5te.S", "media/ffvpx/libavcodec/arm/simple_idct_armv6.S", "media/ffvpx/libavcodec/arm/startcode_armv6.S", "media/ffvpx/libavcodec/arm/vp9itxfm_16bpp_neon.S", "media/ffvpx/libavcodec/arm/vp9itxfm_neon.S", "media/ffvpx/libavcodec/arm/vp9lpf_16bpp_neon.S", "media/ffvpx/libavcodec/arm/vp9mc_16bpp_neon.S", "media/ffvpx/libavcodec/arm/vp9mc_neon.S", "media/ffvpx/libavcodec/atsc_a53.c", "media/ffvpx/libavcodec/av1dec.c", "media/ffvpx/libavcodec/avcodec.c", "media/ffvpx/libavcodec/avcodec.h", "media/ffvpx/libavcodec/avcodec.symbols", "media/ffvpx/libavcodec/avdct.h", "media/ffvpx/libavcodec/bitstream.h", "media/ffvpx/libavcodec/bitstream_filters.c", "media/ffvpx/libavcodec/bitstream_template.h", "media/ffvpx/libavcodec/bsf/aac_adtstoasc.c", "media/ffvpx/libavcodec/bsf/av1_frame_split.c", "media/ffvpx/libavcodec/bsf/null.c", "media/ffvpx/libavcodec/bsf/vp9_superframe_split.c", "media/ffvpx/libavcodec/cbs.c", "media/ffvpx/libavcodec/cbs.h", "media/ffvpx/libavcodec/cbs_av1.c", "media/ffvpx/libavcodec/cbs_av1_syntax_template.c", "media/ffvpx/libavcodec/codec.h", "media/ffvpx/libavcodec/codec_desc.c", "media/ffvpx/libavcodec/codec_id.h", "media/ffvpx/libavcodec/codec_internal.h", "media/ffvpx/libavcodec/codec_list.c", "media/ffvpx/libavcodec/codec_par.c", "media/ffvpx/libavcodec/codec_par.h", "media/ffvpx/libavcodec/decode.c", "media/ffvpx/libavcodec/decode.h", "media/ffvpx/libavcodec/dovi_rpu.h", "media/ffvpx/libavcodec/dxva2_internal.h", "media/ffvpx/libavcodec/dynamic_hdr_vivid.c", "media/ffvpx/libavcodec/dynamic_hdr_vivid.h", "media/ffvpx/libavcodec/encode.c", "media/ffvpx/libavcodec/exif.c", "media/ffvpx/libavcodec/exif.h", "media/ffvpx/libavcodec/exif_internal.h", "media/ffvpx/libavcodec/fffjni.c", "media/ffvpx/libavcodec/ffjni.c", "media/ffvpx/libavcodec/flacdsp_lpc_template.c", "media/ffvpx/libavcodec/get_b