27d6b45915552f4\nuz -\u003e 216c39367cb2cd334f576798727d6b45915552f4\nvi -\u003e 216c39367cb2cd334f576798727d6b45915552f4\nwo -\u003e 216c39367cb2cd334f576798727d6b45915552f4\nxh -\u003e 216c39367cb2cd334f576798727d6b45915552f4\nzam -\u003e 216c39367cb2cd334f576798727d6b45915552f4\nzh-CN -\u003e 216c39367cb2cd334f576798727d6b45915552f4\nzh-TW -\u003e 216c39367cb2cd334f576798727d6b45915552f4\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "e0793a08f7e08fc35354845c86ea1a2102260fb3", "git_parents": ["07d54308e530fa098a293c01575f60c99cde6054"], "node": "420b2cc514d95839451b4effed8ead539904fae5", "parents": ["84fbb536a1282defe28b452ba331bc4a2d34ef62"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058644 - Test that a trailing-dot callback domain skips its stem pref. r=gstoll\n\nCover the three shapes the previous patch changes: a single-string prefix\ndomain, an array registration mixing a trailing-dot entry with a bare one, and\na pref branch observer, where the notified name is also shorter than the root\nthe observer registered.\n\nEach of these fails without that patch: the callback fires for the stem pref,\nand the branch observer is handed a topic that is not a suffix of the pref name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315234\n", "files": ["modules/libpref/test/gtest/Basics.cpp"], "git_node": "dea81647d4ebe27eca0261e05d63e9b19f1ec9d0", "git_parents": ["e0793a08f7e08fc35354845c86ea1a2102260fb3"], "node": "3cb8856d1f5cbe8b7b59ab5cd3a317ba54a53386", "parents": ["420b2cc514d95839451b4effed8ead539904fae5"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070827 - Add `mach sbom` generating CycloneDX 1.6 from moz.yaml r=mach-reviewers,ahochheiden\n\nMaps the in-tree moz.yaml manifests onto a CycloneDX 1.6 document. sbom.py\nholds the ecosystem-neutral mapping rules and deliberately does not import\ncyclonedx, so they stay unit testable from sites that do not vendor it;\nsbom_cyclonedx.py is the serialization half.\n\nThe document is generated during a build as well as on demand, so the\norchestration lives in mozbuild/action/generate_sbom.py: a py_action a later\ncommit wires into the build's automation steps, and whose generate() the\n`mach sbom` command calls with the same arguments. Both run in the `build`\nsite, which is where cyclonedx is registered for that reason.\n\nOutput is reproducible for a given checkout: the BOM serial number is\nderived from the source revision and the timestamp defaults to the head\ncommit time, with SOURCE_DATE_EPOCH taking precedence.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325281\n", "files": ["python/mach/mach/command_util.py", "python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_cargo.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_cyclonedx.py", "python/mozbuild/mozbuild/vendor/sbom.py", "python/mozbuild/mozbuild/vendor/sbom_cargo.py", "python/mozbuild/mozbuild/vendor/sbom_cyclonedx.py", "python/sites/build.txt", "python/sites/python-test.txt"], "git_node": "224e74507b59d7542f833d2fb860c4bf6bacf2d5", "git_parents": ["dea81647d4ebe27eca0261e05d63e9b19f1ec9d0"], "node": "72d1608b6cf25aad5af2273c5bdf3bae6667c50c", "parents": ["3cb8856d1f5cbe8b7b59ab5cd3a317ba54a53386"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072802 - Update PDF.js to ee470d5db4c8517ea3ccbfc489deab9311cc3a81 r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326805\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "