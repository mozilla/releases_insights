eral/mochitest-xslt.toml", "dom/tests/mochitest/general/mochitest.toml", "dom/tests/reftest/reftest.list", "dom/tests/reftest/xml-stylesheet/reftest.list", "dom/xml/test/mochitest-xslt.toml", "dom/xml/test/mochitest.toml", "dom/xslt/crashtests/crashtests.list", "dom/xslt/tests/browser/browser.toml", "dom/xslt/tests/mochitest/mochitest.toml", "layout/reftests/bugs/reftest.list", "testing/web-platform/meta/content-security-policy/xslt/__dir__.ini", "testing/web-platform/meta/dom/idlharness.window.js.ini", "testing/web-platform/meta/service-workers/service-worker/xsl-base-url.https.html.ini", "testing/web-platform/meta/xml/xslt/__dir__.ini"], "git_node": "572cbc53633d3ed8a0b1390828611752f0317938", "git_parents": ["a336b4db4bae7880ca8cefb2fabecad2ca612ac7"], "node": "24b31c98c7b9663cc0c098ee2bb81a7047f7479f", "parents": ["f3c832bbe9df53f45e7efe140af8291ede90ab9d"], "tags": []}], "date": 1789677293, "git_changesets": ["572cbc53633d3ed8a0b1390828611752f0317938"], "user": "csabou@mozilla.com"}, "45353": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072432 - Use AppendChild instead of AppendChildTo in txMozillaXMLOutput. r=smaug,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326562\n", "files": ["dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "4a848b8fb3fed4fde8dd3db6ccb6ce7e12cf2994", "git_parents": ["a336b4db4bae7880ca8cefb2fabecad2ca612ac7"], "node": "29d449b2fb2bfccfee166b39f4e73892778c96b3", "parents": ["f3c832bbe9df53f45e7efe140af8291ede90ab9d"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Introduce a platform-specific thread handle r=afranchuk,crashreporting-reviewers\n\nThis is supposed to mirror the native representation of a thread on each\nplatform, which would make it a HANDLE on Windows. However we're\nsticking with a thread id there for compatibility with Breakpad's\ninterfaces. Once we drop Breakpad in favor of a bare minidump-writer\nbackend it can be changed to a HANDLE. As for Linux we stick with a tid\nbut leave the possibility of making it a pidfd in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323671\n", "files": ["toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/platform.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/mach.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs"], "git_node": "330aa622b7124ae40c5c71ef9ea6140ecba8e894", "git_parents": ["4a848b8fb3fed4fde8dd3db6ccb6ce7e12cf2994"], "node": "50e2386433329402f00e10e7caa67142369f3bcb", "parents": ["29d449b2fb2bfccfee166b39f4e73892778c96b3"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Replace the ProcessReaderHandle type with a proper raw representation of the crash helper process handle abstract type r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323672\n", "files": ["toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_common/src/platform.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/mach.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/lib.rs"], "git_node": "82f769f9c76cbc37b70ef39153e56c8fb034fc74", "git_parents": ["330aa622b7124ae40c5c71ef9ea6140ecba8e894"], "node": "eb27f3cc636c685743cc049ea492f393e8931182", "parents": ["50e2386433329402f00e10e7caa67142369f3bcb"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Introduce an IPC message for minidump generation r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323673\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs"], "git_node": "9be98fd8af1889f240f7ffb37b3e701107941066", "git_parents": ["82f769f9c76cbc37b70ef39153e56c8fb034fc74"], "node": "cf2a16df80c5a92fa251efc236405e26264d26d4", "parents": ["eb27f3cc636c685743cc049ea492f393e8931182"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Fix type used for looking up auxiliary vector information r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323674\n", "files": ["toolkit/crashreporter/breakpad_wrapper/breakpad_wrapper.cpp"], "git_node": "7843b18fe8afb238515031cf3fab3cf8d12bdc41", "git_parents": ["9be98fd8af1889f240f7ffb37b3e701107941066"], "node": "92e67c74283ca1133429842fa195592d693ad82e", "parents": ["cf2a16df80c5a92fa251efc236405e26264d26d4"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Add a wrapper function to generate a minidump on demand rather than via the exception handler r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323675\n", "files": ["toolkit/crashreporter/breakpad_wrapper/breakpad_wrapper.cpp"], "git_node": "8c2caf58d424e37ca99db12d928da1756a6fc762", "git_parents": ["7843b18fe8afb238515031cf3fab3cf8d12bdc41"], "node": "638bbde9b51447179dcf0bfda319809d428debc6", "parents": ["92e67c74283ca1133429842fa195592d693ad82e"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Make the crash helper handle and respond to minidump generation messages r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323676\n", "files": ["toolkit/crashreporter/crash_helper_common/src/breakpad/unix_strings.rs", "toolkit/crashreporter/crash_helper_common/src/breakpad/windows_strings.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_server/cbindgen.toml", "toolkit/crashreporter/crash_helper_server/src/breakpad_crash_generator.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs"], "git_node": "49b8301445a68adc5b525261f317e911aa35120f", "git_parents": ["8c2caf58d424e37ca99db12d928da1756a6fc762"], "node": "c27dc03773e0aacc4b36b989be8a98a796ce7bfd", "parents": ["638bbde9b51447179dcf0bfda319809d428debc6"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Add support for generating minidumps via the crash helper client code r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323677\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs"], "git_node": "d6f55edeabb5a90aa275d4ed357c9e87dfbcda55", "git_parents": ["49b8301445a68adc5b525261f317e911aa35120f"], "node": "f6441079b40986e63c62d35368353c2dd2a31232", "parents": ["c27dc03773e0aacc4b36b989be8a98a796ce7bfd"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Re-enable capturing child process shutdown hangs r=afranchuk,ipc-reviewers,crashreporting-reviewers\n\nWhile this change re-enables pre-existing functionality it changes both\nits implementation and interface. We now request dumping a process via\nits Gecko process id rather than via its PID, this avoids races that\ncould be caused by PID reuse. Additionally the dumping process still\nblocks the calling thread but takes place entirely in the crash helper\nprocess, not in the main process anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323678\n", "files": ["ipc/glue/CrashReporterHost.cpp", "ipc/glue/CrashReporterHost.h", "toolkit/crashreporter/nsDummyExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.h"], "git_node": "56c8ed14a57b7c6dde03fb4b352e8deebb2c8370", "git_parents": ["d6f55edeabb5a90aa275d4ed357c9e87dfbcda55"], "node": "40a64974956f4766415a703fccf7ecb26983ed25", "parents": ["f6441079b40986e63c62d35368353c2dd2a31232"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949178 - Remove some needless includes of CrashReporterHost.h r=afranchuk,ipc-reviewers,media-playback-reviewers,padenot,nika,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324067\n", "files": ["dom/media/gmp/GMPParent.cpp", "dom/media/ipc/RDDChild.cpp", "ipc/glue/CrashReporterHost.h", "xpcom/base/AvailableMemoryWatcher.h", "xpcom/base/AvailableMemoryWatcherLinux.cpp", "xpcom/base/AvailableMemoryWatcherMac.cpp"], "git_node": "77575f2c9645f93756f606b9f88191468320e07c", "git_parents": ["56c8ed14a57b7c6dde03fb4b352e8deebb2c8370"], "node": "ac647932d98a044e5ba0de42d00ffae7e1658900", "parents": ["40a64974956f4766415a703fccf7ecb26983ed25"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069131 - Rename browser/base/content/test general, about, webrtc, popups and tabPrompts directories to match eslint-test-paths conventions r=frontend-codestyle-reviewers,webcompat-reviewers,fxview-reviewers,tabbrowser-reviewers,places-reviewers,urlbar-reviewers,ai-platform-reviewers,timhuang,dao,mossop,twisniewski,nsharpley,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/