[{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-301 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "609e278cf9cd5606663985c57236f316a2c36c1a", "parents": ["6f5c8df1925d8dbeea2710238d28e6cac1946226"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-301 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "0b1e71ba94644f5c0a4253e411098d5ece77af14", "parents": ["609e278cf9cd5606663985c57236f316a2c36c1a"], "tags": []}], "date": 1515614122, "git_changesets": [null, null], "user": "ffxbld"}, "7490": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "a4ceb3b5de93a39078508e162dbd0805d759c063", "parents": ["0b1e71ba94644f5c0a4253e411098d5ece77af14"], "tags": []}], "date": 1515695975, "git_changesets": [null], "user": "Callek@gmail.com"}, "7491": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-327 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "4a08990e7d126e9a51859e25132205a37442c8fa", "parents": ["a4ceb3b5de93a39078508e162dbd0805d759c063"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-327 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "f895726ace24f4eee164c3dd000d7fdd121b4821", "parents": ["4a08990e7d126e9a51859e25132205a37442c8fa"], "tags": []}], "date": 1515699656, "git_changesets": [null, null], "user": "ffxbld"}, "7492": {"changesets": [{"author": "Ted Mielczarek \u003cted@mielczarek.org\u003e", "branch": "default", "desc": "Bug 1422735 - Change symbol upload URL from Socorro to Tecken. r=nalexander, a=gchang\n\nMozReview-Commit-ID: BBs6G8dFfPz", "files": ["toolkit/crashreporter/tools/upload_symbols.py"], "git_node": null, "git_parents": [null], "node": "b88ef76f56878f890f4257616c47c4ec5d1cac8c", "parents": ["f895726ace24f4eee164c3dd000d7fdd121b4821"], "tags": []}, {"author": "Josh Aas \u003cjaas@kflag.net\u003e", "branch": "default", "desc": "Bug 1394654 - Remove OS X opengl workaround from Mozilla bug 603134. r=mstange, a=ritu", "files": ["widget/cocoa/nsChildView.h", "widget/cocoa/nsChildView.mm"], "git_node": null, "git_parents": [null], "node": "d420bca2b42f2b19b5cdd23f0e1e0f73d1a6c8d4", "parents": ["b88ef76f56878f890f4257616c47c4ec5d1cac8c"], "tags": []}, {"author": "Bob Silverberg \u003cbsilverberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1261963 - createData should be optional for browser.windows.create. r=aswan, a=ritu", "files": ["browser/components/extensions/schemas/windows.json", "browser/components/extensions/test/browser/browser_ext_windows_create.js"], "git_node": null, "git_parents": [null], "node": "d0c98f5b6c12f587eb7e5a224af504f510ca4bd5", "parents": ["d420bca2b42f2b19b5cdd23f0e1e0f73d1a6c8d4"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1428880 - Switch ESR to use new search engine. r=florian, a=ritu\n\nMozReview-Commit-ID: APuROFXDd6d", "files": ["browser/app/profile/firefox.js", "browser/components/search/test/browser_google.js", "browser/components/search/test/browser_google_behavior.js", "browser/locales/search/list.json", "browser/locales/searchplugins/google-2018.xml"], "git_node": null, "git_parents": [null], "node": "fc71b0eef98d579fb5296fcad51e350787c4cf86", "parents": ["d0c98f5b6c12f587eb7e5a224af504f510ca4bd5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1428589 - Don't read a destroyed cookie list if the last cookie in the entry expired. r=jdm, a=ritu\n\nConsider the following situation, which is what causes the failure:\n\n * `cookies` is an array of length 1 (either from the beginning, or because\n   other cookies have been expired while in this loop).\n * the only cookie that remains is expired.\n\nWe append the cookie to removedList, and then we call\ngCookieService-\u003eRemoveCookieFromList, which has the following code:\n\n  if (aIter.entry-\u003eGetCookies().Length() == 1) {\n    mDBState-\u003ehostTable.RawRemoveEntry(aIter.entry);\n  } else {\n    aIter.entry-\u003eGetCookies().RemoveElementAt(aIter.index);\n  }\n\nIf we enter the first branch, as it's the case, that will destroy the array.\n\nWe're effectively removing stuff from the array while mutating it, which is\nscary. It's fine if we don't delete the array, since we iterate through it using\nindices, but still it's dangerous as heck.\n\nIf we're the last element in the array though, we're doomed, because `cookies`\nis now destroyed. We not only try to access the array length again, but also we\ntry to index on it the next time because we never stopped the loop (`i` is still\nzero, and the length may very well be garbage).\n\nFix it by keeping the length in sync from the stack and breaking out from the\nloop if appropriately.\n\nMozReview-Commit-ID: 6qaC9yclvP2", "files": ["netwerk/cookie/nsCookieService.cpp"], "git_node": null, "git_parents": [null], "node": "f7865afb1fe6120b780ab1ae9db1f27ce10b040e", "parents": ["fc71b0eef98d579fb5296fcad51e350787c4cf86"], "tags": []}], "date": 1515705311, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7493": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1387427 - Don't insert source content into the document for XSLT transforms. r=smaug, a=gchang", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xslt/base/txURIUtils.cpp", "dom/xslt/base/txURIUtils.h", "dom/xslt/nsIDocumentTransformer.h", "dom/xslt/xslt/txExecutionState.cpp", "dom/xslt/xslt/txExecutionState.h", "dom/xslt/xslt/txMozillaTextOutput.cpp", "dom/xslt/xslt/txMozillaXMLOutput.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.h"], "git_node": null, "git_parents": [null], "node": "9fb7614319df619a28ad97faf9b9ef94247b7692", "parents": ["f7865afb1fe6120b780ab1ae9db1f27ce10b040e"], "tags": []}], "date": 1515706210, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7494": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1427870 - Change resolution of .now() to 20us. r=bkelly, a=ritu\n\nThe comment about workers was introduced in Bug 1186489 but became obsolete some time after that\n(definitely by Bug 1278838)", "files": ["dom/performance/Performance.cpp"], "git_node": null, "git_parents": [null], "node": "81d6465bd7c229bf55dbadbbb609da6eae83c289", "parents": ["9fb7614319df619a28ad97faf9b9ef94247b7692"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425780 - Don't allow queue-jumping for gathering state change events. r=bwc, a=ritu", "files": ["media/webrtc/signaling/src/peerconnection/PeerConnectionImpl.cpp"], "git_node": null, "git_parents": [null], "node": "5f753161df2523a86a2ade556e853454f07ef349", "parents": ["81d6465bd7c229bf55dbadbbb609da6eae83c289"], "tags": []}, {"author": "Samael Wang \u003cfreesamael@gmail.com\u003e", "branch": "default", "desc": "Bug 1416878 - Move the implementation of nsIWidgetListener from nsWebBrowser / nsWebShellWindow to a separate object. r=bz, a=ritu\n\nMozReview-Commit-ID: 5QV6lkCCGW5", "files": ["embedding/browser/nsWebBrowser.cpp", "embedding/browser/nsWebBrowser.h", "xpfe/appshell/nsWebShellWindow.cpp", "xpfe/appshell/nsWebShellWindow.h"], "git_node": null, "git_parents": [null], "node": "b95d654de120bd398d712a6189c33f6fa83dcf66", "parents": ["5f753161df2523a86a2ade556e853454f07ef349"], "tags": []}], "date": 1515782651, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "7495": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "fbc51ab41064e29c615318c7bb16aa67777939a0", "parents": ["b95d654de120bd398d712a6189c33f6fa83dcf66"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-306 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "d64c803c3cab8b7f8509a1f272a67f33ea37320d", "parents": ["fbc51ab41064e29c615318c7bb16aa67777939a0"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-306 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "793e1f65b3e2a22eac872e14f0c9e8d2837907a4", "parents": ["d64c803c3cab8b7f8509a1f272a67f33ea37320d"], "tags": []}], "date": 1515786216, "git_changesets": [null, null, null], "user": "ffxbld"}, "7496": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-325 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_p