14113ac4b228ad49f084b0a1c17ba461f6ad65e", "git_parents": ["f976b19b3825cb77bc9ecb26fec27b6e9827bb22"], "node": "4781242c0d823dd8fafcd291a9f68259055750ed", "parents": ["ad1add4e317e20fdf11832c7403cb1a72ee75a14"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2079889 - Distinguish Smart Page updates from creation in the action log. r=fluent-reviewers,ngrato,gazhibekova,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333067\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.mjs", "browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.stories.mjs", "browser/components/aiwindow/ui/modules/ToolActionLog.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolActionLog.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "000f7b29f0d963572dc25b972dd8a38f15863221", "git_parents": ["814113ac4b228ad49f084b0a1c17ba461f6ad65e"], "node": "7b5e6feeedd8bf3b2b8331237d4d9bb5845d173d", "parents": ["4781242c0d823dd8fafcd291a9f68259055750ed"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083043 - Swap in correct warning icon for delete error dialog in VPN site rules - r=ip-protection-reviewers,mcleinman\" for causing build bustages\n\nThis reverts commit 2f6c32a996d585e709ec19561f7c66fb528fd7d6.\n", "files": ["browser/components/ipprotection/assets/warning.svg", "browser/components/ipprotection/content/vpn-site-rules-list.mjs"], "git_node": "0ef95bd3524999649325d769594e6496ec930ada", "git_parents": ["000f7b29f0d963572dc25b972dd8a38f15863221"], "node": "6e11fa26faa1ee1bfa68befe6e568316e91f4c5a", "parents": ["7b5e6feeedd8bf3b2b8331237d4d9bb5845d173d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084337 - Notify MediaKeys that the CDM terminated before shutting down the proxy. r=media-playback-reviewers,alwu\n\nShutdown() asks the ChromiumCDMProxy to shut down, which clears its\nMediaKeys reference before the Terminated() runnable runs, so sessions\nwere never closed and the media element was never notified when the CDM\nprocess crashed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335768\n", "files": ["dom/media/gmp/ChromiumCDMParent.cpp"], "git_node": "d3ddf4c0519a90cb174d846612599befa6feef10", "git_parents": ["0ef95bd3524999649325d769594e6496ec930ada"], "node": "ffdbec84018e18b18b8a01f8cbb24752d39ed016", "parents": ["6e11fa26faa1ee1bfa68befe6e568316e91f4c5a"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2082129 - update loadURI idl definition based on recent changes, r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333900\n", "files": ["uriloader/exthandler/nsIExternalProtocolService.idl"], "git_node": "8682697642ecc8fd1976944a5cf5c90c51818464", "git_parents": ["d3ddf4c0519a90cb174d846612599befa6feef10"], "node": "376c91d18b873d8639ea6b73a2428283457f7d8a", "parents": ["ffdbec84018e18b18b8a01f8cbb24752d39ed016"], "tags": []}, {"author": "Vijay Budhram \u003cvbudhram@gmail.com\u003e", "branch": "default", "desc": "Bug 2084297 - Refresh the FxA profile only on an explicit full sync. r=sfamisa,android-reviewers\n\nBug 2031498 made FxaAccountManager.syncNow() refresh the profile with\nignoreCache = true. SyncedTabsStorage calls syncNow() for the tabs engine\neach time the open tabs change, so each tab change sent a GET /v1/profile\nand a POST /v1/verify to FxA.\n\nThis patch refreshes the profile only for a full sync that the user asks\nfor, which is when the reason is SyncReason.User and customEngineSubset is\nempty. WorkManagerSyncManager uses the same check for a user full sync.\nA startup sync no longer skips the profile cache, because the account\nstart already fetches the profile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335742\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt"], "git_node": "a97c9d646234b385e6336bfdac4092d52e384c60", "git_parents": ["8682697642ecc8fd1976944a5cf5c90c51818464"], "node": "4b89b0bcd69caee0527a3a5bcf6d87455d2276e8", "parents": ["376c91d18b873d8639ea6b73a2428283457f7d8a"], "tags": []}, {"author": "Brendan Birdsong \u003cbbirdsong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079020 - Send sponsored top sites relevance scores in the New Tab MARS tiles request. r=mconley\n\nDepends on D334711\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335437\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsClient.js", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "b3435bba52990617311fe117eefb89351e7d84b8", "git_parents": ["a97c9d646234b385e6336bfdac4092d52e384c60"], "node": "be38d89bfa0231bcc6ced2348981421446c73b8d", "parents": ["4b89b0bcd69caee0527a3a5bcf6d87455d2276e8"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083167 - Don't capture a tab preview thumbnail of a browser without content to draw. r=firefox-desktop-core-reviewers ,reusable-components-reviewers,jules,mossop\n\nWhen the content has no width or document height, the computed scale wasn't\nfinite and drawSnapshot threw. browser.drawSnapshot is also meant to return\nfalse on failure, but it returned the promise without awaiting it, so its\ncatch never ran.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335272\n", "files": ["toolkit/components/thumbnails/PageThumbs.sys.mjs", "toolkit/content/tests/browser/browser.toml", "toolkit/content/tests/browser/browser_drawSnapshot_failure.js", "toolkit/content/widgets/browser-custom-element.mjs"], "git_node": "ef3f20987474db5a9f845ee0858fe5848ff4888c", "git_parents": ["b3435bba52990617311fe117eefb89351e7d84b8"], "node": "37f90373fa2fb58fab6b7301cb6dced68863294a", "parents": ["be38d89bfa0231bcc6ced2348981421446c73b8d"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083798 - Pass locale to system prompt for ATG. r=jlewis,cdipersio,remote-settings-reviewers,gbeckley\n\nThis patch adds the locale (e.g. fr-FR) to the system prompt so it's\nused for the group naming. The previous behaviour used the language that\nwas found in the most title but we want to default to the locale language\nfrom now on.\n\nPrompt Tuning PR is here: https://github.com/Firefox-AI/ai-window-remote-settings-prompts/pull/233\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335305\n", "files": ["browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_auto_tab_grouping_labeling.js", "browser/components/aiwindow/ui/test/browser/head.js", "services/settings/dumps/main/ai-window-prompts.json"], "git_node": "3064c201798512afeb5397a8350e52ed4f349fe0", "git_parents": ["ef3f20987474db5a9f845ee0858fe5848ff4888c"], "node": "98d5dfe8ba4d60a0a25e763a67d2dbed507cbb9a", "parents": ["37f90373fa2fb58fab6b7301cb6dced68863294a"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083945 - Add documentation explaining the new newtabPreview.ftl file. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335450\n", "files": ["browser/extensions/newtab/docs/v2-system-addon/train_hopping.md"], "git_node": "449a5c926840f3f043b3d47012cbeffdd793434c", "git_parents": ["3064c201798512afeb5397a8350e52ed4f349fe0"], "node": "226d0dd432c8b6c208b9f4e2d1a14d622090b60c", "parents": ["98d5dfe8ba4d60a0a25e763a67d2dbed507cbb9a"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074990 - Make the autocomplete popup padding even and keep row corners concentric with the panel. r=mtigley,desktop-theme-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333633\n", "files": ["browser/themes/shared/autocomplete.css"], "git_node": "888fb9911cf589058b246351941c0ddd32ed6f6e", "git_parents": ["449a5c926840f3f043b3d47012cbeffdd793434c"], "node": "b96e2423b7802ef8a722416abf980483c6cc2017", "parents": ["226d0dd432c8b6c208b9f4e2d1a14d622090b60c"], "tags": []}, {"author": "Tin La \u003ctinsila1@gmail.com\u003e", "branch": "default", "desc": "Bug 2071324 - dedupe actions/cancel_all.py between gecko_taskgraph and taskgraph r=ahal,taskgraph-reviewers,releng-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335746\n", "files": ["taskcluster/gecko_taskgraph/actions/cancel_all.py", "taskcluster/gecko_taskgraph/util/taskcluster.py"], "git_node": "c401cfd9eb683802fa5507b45e8d5e5bf5e71230", "git_parents": ["888fb9911cf589058b246351941c0ddd32ed6f6e"], "node": "7c7481787171a6be665bbe7023c29f196bee62d0", "parents": ["b96e2423b7802ef8a722416abf980483c6cc2017"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072688 - Disable test_speech_recognition_cross_origin.html on macOS 15 aarch64 opt for frequent failures. r=media-webspeech-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335796\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml"], "git_node": "54864e66c80b5fec95c5ef87edc2f47c6b895e8b", "git_parents": ["c401cfd9eb683802fa5507b45e8d5e5bf5e71230"], "node": "4bd4f418c31d17601574b2574017647aae2902e9", "parents": ["7c7481787171a6be665bbe7023c29f196bee62d0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083847 - Remove HSTS preload entries for host names that no longer exist. r=keeler\n\nRemoves every entry that is not on Chromium's current preload list, returns an authoritative NXDOMAIN from\npublic resolvers and was unknown-host in two pinning-update runs on different days. Names that exist without\nan address record, return SERVFAIL or never answered stay, since a no-address apex can front a live www. host\nunder includeSubdomains.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335314\n", "files": ["security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "732ec6f9334d66fad15dc2af5ad778c1c390472d", "git_parents": ["54864e66c80b5fec95c5ef87edc2f47c6b895e8b"], "node": "7c27fb6b2cea9a6b4e05645b7fddc4f74b95c053", "parents": ["4bd4f418c31d17601574b2574017647aae2902e9"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2053909 - [Part 2] Add a function that transfers screenshot onto Android Surface r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334362\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "widget/android/GeckoViewSupport.h", "widget/android/nsWindow.cpp"], "git_node": "1d261f626eadecc43d65f89d65a76651e3ada8af", "git_parents": ["732ec6f9334d66fad15dc2af5ad778c1c390472d"], "node": "565ba5234a8a2cacc12011721f434dec0dedc18c", "parents": ["7c27fb6b2cea9a6b4e05645b7fddc4f74b95c053"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083682 - Show an empty about:loginsimportreport when no import happened. r=mtigley,credential-management-reviewers\n\nOpening the page directly, without importing logins first, threw since there\nis no report to show.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335239\n", "files": ["browser/components/aboutlogins/content/aboutLoginsImportReport.mjs"], "git_node": "4b72e6d754771025322156abb74eae9304eeea37", "git_parents": ["1d261f626eadecc43d65f89d65a76651e3ada8af"], "node": "0c9c6fe266341ab3423436d1f901bae2f77fbdc4", "parents": ["565ba5234a8a2cacc12011721f434dec0dedc18c"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083160 - Add translateFragment to the document.l10n mock in the about:logins chrome tests. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335240\n", "files": ["browser/components/aboutlogins/tests/chrome/aboutlogins_common.js"], "git_node": "1e5fb32bd5359827bd91ce2c136bf04d1004373a", "git_parents": ["4b72e6d754771025322156abb74eae9304eeea37"], "node": "61f41a9b1376a16ef8352277cf9cb342ac075e45", "parents": ["0c9c6fe266341ab3423436d1f901bae2f77fbdc4"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083675 - Make ContentChild::mProcessPriority atomic. r=dom-core-reviewers,canova,smaug\n\nIt's written on the main thread and read on the profiler thread when the\nprofiler starts, which TSan reports as a data race, crashing the content\nprocess in TSan builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335243\n", "files": ["dom/ipc/ContentChild.h"], "git_node": "f3ce02da9947bb55e942135cb05cbb3deba8049b", "git_parents": ["1e5fb32bd5359827bd91ce2c136bf04d1004373a"], "node": "02ba93f75c649720e8a9e5a3a393c7999ba3114c", "parents": ["61f41a9b1376a16ef8352277cf9cb342ac075e45"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083681 - Don't update the sidebar menus from pref observers once the window is closing. r=sidebar-reviewers,kcochrane\n\nThe pref observers that hide a sidebar panel when its pref is turned off\noutlive the window. Turning such a pref off after closing a window that had the\npanel open threw, since hiding the sidebar used state cleared on uninit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335271\n", "files": ["browser/components/sidebar/browser-sidebar.js"], "git_node": "e007c7b9f5060c9add0c9594105246c6abe73517", "git_parents": ["f3ce02da9947bb55e942135cb05cbb3deba8049b"], "node": "053b89cd82e76922e410c61477ee3edc5c93c492", "parents": ["02ba93f75c649720e8a9e5a3a393c7999ba3114c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084357 - Skip backdrop chains with a picture not drawn this frame. r=gfx-reviewers,bradwerth\n\nA culled picture keeps the raster config of the last frame it was drawn in, whose surface index can be past the end of this frame's surfaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335774\n", "files": ["gfx/wr/webrender/src/picture_graph.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/wrench/src/rawtest.rs"], "git_node": "0f3d43972e91b73fdaaa5b315014283553126446", "git_parents": ["e007c7b9f5060c9add0c9594105246c6abe73517"], "node": "e48f23101298272cb1aa9f8c25b9493e8e0c1eb2", "parents": ["053b89cd82e76922e410c61477ee3edc5c93c492"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 10: Fix 119 'misc-unused-parameters' warnings under /ipc r=ipc-reviewers,crashreporting-reviewers,nika\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nEverything found by ./mach static-analysis was manually inspected and changed if needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332955\n", "files": ["ipc/chromium/src/base/message_pump_glib.cc", "ipc/chromium/src/chrome/common/ipc_message.h", "ipc/chromium/src/chrome/common/ipc_message_utils.h", "ipc/glue/BackgroundChildImpl.cpp", "ipc/glue/BackgroundImpl.cpp", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/CrashReporterHost.cpp", "ipc/glue/DataPipe.cpp", "ipc/glue/ForkServiceChild.cpp", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/IPCMessageUtilsSpecializations.h", "ipc/glue/IdleSchedulerChild.cpp", "ipc/glue/IdleSchedulerParent.cpp", "ipc/glue/MessageChannel.cpp", "ipc/glue/MessagePump.cpp", "ipc/glue/NodeController.cpp", "ipc/glue/ProcessUtils_common.cpp", "ipc/glue/ProtocolUtils.cpp", "ipc/glue/SharedMemoryHandle.cpp", "ipc/glue/SharedMemoryMapping.cpp", "ipc/glue/Shmem.cpp", "ipc/glue/UtilityMediaServiceChild.cpp", "ipc/glue/UtilityProcessChild.cpp", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/test/gtest/TestAsyncBlockers.cpp", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp", "ipc/ipdl/test/gtest/TestAsyncReturns.cpp", "ipc/ipdl/test/gtest/TestDestroyNested.cpp", "ipc/ipdl/test/gtest/TestEndpointOpens.cpp", "ipc/ipdl/test/gtest/TestHangs.cpp", "ipc/testshell/TestShellChild.cpp", "ipc/testshell/TestShellParent.cpp", "ipc/testshell/XPCShellEnvironment.cpp"], "git_node": "87513987a50fdb66d130784962aa02ff8fa34947", "git_parents": ["0f3d43972e91b73fdaaa5b315014283553126446"], "node": "7250160e595a49810ee76344bae3af5138d7d835", "parents": ["e48f23101298272cb1aa9f8c25b9493e8e0c1eb2"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081380:. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335800\n", "files": ["la