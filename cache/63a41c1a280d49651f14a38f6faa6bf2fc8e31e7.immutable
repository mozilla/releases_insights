sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/modules/A2UI.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_store_integration.js", "browser/components/aiwindow/ui/test/browser/head_aitab.js"], "git_node": "dc5db28e6a4e4736470f90c3cefa227f11450bbd", "git_parents": ["e7249616c7e865bca39041c0661b59bb5b98aa51"], "node": "c3dc25fda8f8b6a0f8c975fb748d40e65aa22a35", "parents": ["bad887f873c5e9e948443e0f81b231cbdee97202"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084311 - ensure OneCRL bundle is loaded at init r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335790\n", "files": ["security/manager/ssl/RemoteSecuritySettings.sys.mjs", "security/manager/ssl/tests/unit/test_onecrl_loads_bundle.js", "security/manager/ssl/tests/unit/xpcshell.toml", "toolkit/components/push/test/browser/browser.toml"], "git_node": "2fcb729c3560b2b0f6a918374b813b749cf8a75c", "git_parents": ["dc5db28e6a4e4736470f90c3cefa227f11450bbd"], "node": "9cef2361eadc2c7bc5411b728a2bd690b6793c22", "parents": ["c3dc25fda8f8b6a0f8c975fb748d40e65aa22a35"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076655 - Remove `userTypedClear` from the lazy tab state. r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335599\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/docs/lazy-browsers.md"], "git_node": "68a6e7acd818b79ba205670e9cdf73e8f22ffc98", "git_parents": ["2fcb729c3560b2b0f6a918374b813b749cf8a75c"], "node": "2a4757d038d76453c44c398b4e51fd323cf164b9", "parents": ["9cef2361eadc2c7bc5411b728a2bd690b6793c22"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2013247 - Don't promote overlays whose rounded clip is outside the root coordinate system. r=gfx-reviewers,nical\n\nThe compositor clip is mapped to device space with a scale and offset, so a\nclip in another coordinate system hit an unreachable!() even when the\nprimitive's own transform was axis-aligned.\n\nThe test runs with a new null layer compositor in wrench, used by --compositor\non platforms other than Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335780\n", "files": ["gfx/wr/ci-scripts/linux-release-tests.sh", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/wrench/reftests/compositor-layer/overlay-clip-coord-system-ref.yaml", "gfx/wr/wrench/reftests/compositor-layer/overlay-clip-coord-system.yaml", "gfx/wr/wrench/reftests/compositor-layer/reftest.list", "gfx/wr/wrench/reftests/reftest.list", "gfx/wr/wrench/src/args.yaml", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/null_compositor.rs"], "git_node": "def39d5452fe0fd352e3697316a0f2a4b0a19a52", "git_parents": ["68a6e7acd818b79ba205670e9cdf73e8f22ffc98"], "node": "d53d16943a044e21a1dc66299157aeca5432d15a", "parents": ["2a4757d038d76453c44c398b4e51fd323cf164b9"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081477 - Add a MozWidgetCard React wrapper around moz-widget. r=nina-py\n\n- Adds a header with the shared widget menu to moz-widget cards.\n- Passes telemetryName and validSizes to ExtensionWidgets.\n- Includes extension widgets in Hide all.\n- Animates moz-widget size changes.\n- Moves the menu slot to moz-widget.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333800\n", "files": ["browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-w