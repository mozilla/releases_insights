": "3641648a0b216e2f71216a55473432b9f4f27717", "git_parents": ["c922d546a0a5774fc074bd3ae84c64003e2cb4ae"], "node": "1ec29e1dcb3a7f1f7a6582aed1c4d639acb5fb2e", "parents": ["f87ba404a73eb64aa3fa9962ef96554009cbccd6"], "tags": []}, {"author": "Felix S \u003cfelstr@web.de\u003e", "branch": "default", "desc": "Bug 2081010 - Pass '/'-separated package paths to sdkmanager on Windows. r=android-reviewers,nalexander,android-build-system-reviewers\n\nSince command-line tools 23.0, sdkmanager.bat is a batch wrapper that cmd.exe\nfeeds arguments split on ';', so 'system-images;android-34;...' arrived as\nseparate packages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333058\n", "files": ["python/mozboot/mozboot/android.py"], "git_node": "2ccc96fbb93dc93238888c1e60bebd36c86f29c9", "git_parents": ["3641648a0b216e2f71216a55473432b9f4f27717"], "node": "06c1e6db58801fad89d917a9d1ea753f1d1499f6", "parents": ["1ec29e1dcb3a7f1f7a6582aed1c4d639acb5fb2e"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070369 - Prevent crash retrieving string to show Snackbars in TabManagementFragment r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335726\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/helpers/ExceptionAssertions.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/TabManagementFragmentTest.kt"], "git_node": "2a3bd5b62ca9af2cf4a3818dfd27dcc65e9525e7", "git_parents": ["2ccc96fbb93dc93238888c1e60bebd36c86f29c9"], "node": "1e03327faa4e8864ce819ef0983cd2f32bdec33c", "parents": ["06c1e6db58801fad89d917a9d1ea753f1d1499f6"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2080127 [Linux] Handle audio-playing as background lock r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334573\n", "files": ["widget/gtk/WakeLockListener.cpp", "widget/gtk/WakeLockListener.h"], "git_node": "0f01d6e903e22d5117f14fe93302c0bcd8953b3b", "git_parents": ["2a3bd5b62ca9af2cf4a3818dfd27dcc65e9525e7"], "node": "2c415db636052147c03ea01300d5d866468d7f4a", "parents": ["1e03327faa4e8864ce819ef0983cd2f32bdec33c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079160 - Include panel-item's shortcut text in its accessible name. r=reusable-components-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335711\n", "files": ["toolkit/content/tests/widgets/test_panel_item_shortcut.html", "toolkit/content/widgets/panel-list/README.stories.md", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "379af0289625a8b2ed43e512c44729a958ab8022", "git_parents": ["0f01d6e903e22d5117f14fe93302c0bcd8953b3b"], "node": "cfe500534efc9ba3c1b36c644658a501d03c0762", "parents": ["2c415db636052147c03ea01300d5d866468d7f4a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083069 - Name the viewport height above which the New Tab search sticks. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335519\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/TopicNavigation/_TopicNavigation.scss", "browser/extensions/newtab/content-src/components/Search/_Search.scss", "browser/extensions/newtab/content-src/styles/_variables.scss"], "git_node": "3b3083ffa9225d5cda7f3bb3dcf04c208af82d1a", "git_parents": ["379af0289625a8b2ed43e512c44729a958ab8022"], "node": "a166035c151efcb59afe7eac1e0bb3ddfb017aca", "parents": ["cfe500534efc9ba3c1b36c644658a501d03c0762"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083069 - Start the New Tab search bar lower in HNT Search Logos Experiment Variant B when the page has no stories or content widgets. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335520\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/Base/_Grid.scss", "browser/extensions/newtab/content-src/components/Search/_Search.scss", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx"], "git_node": "8301969b3bef125841b7bd16311f5dd8d0775162", "git_parents": ["3b3083ffa9225d5cda7f3bb3dcf04c208af82d1a"], "node": "704fa5aa52e70213c68afd306ce7d217871a5f36", "parents": ["a166035c151efcb59afe7eac1e0bb3ddfb017aca"], "tags": []}, {"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073599 - Add a Notifications page to Settings listing the sites with a stored notification decision. r=settings-reviewers,fluent-reviewers,tgiles,desktop-theme-reviewers,bolsson\n\nAdds a Notifications card at the top of Permissions and data linking to a sub-page that lists every origin with a stored web-notification decision, with search, an empty state and a distinct no-results state. Rows are read-only: a 24px favicon, the host with a leading www. stripped, and the stored state in a column headed \"Allow notifications\", with blocked sites inline and locale-aware sorting. Private-window grants never persist, so they are excluded from the list and the count. The allowed state reads \"Always\" where app.backgroundNotifications.helper.available is set and \"Allow\" otherwise; product confirmed keeping \"Allow\" on platforms without closed-browser delivery. When the list has no rows, the header reads \"Websites\" over a single message row: \"No website notifications added.\" when nothing is stored, or \"No website notifications match your search.\" when a search finds nothing. The entry row reads \"Manage notification settings\" with a site count, or \"Manage website notification settings\" with no subtitle when there are none. browser.preferences.notifications-section.enabled, false by default, gates both the sub-page and the entry card.\n\n[[ https://www.figma.com/design/w6CSYHizzAn3b7lQnKX16u/Engagement-Experiments?node-id=7702-50679&m=dev | Figma ]]\n\n{F84107657}\n\n{F84107658}\n\n{F84107659}\n\n{F84107660}\n\n{F84107661}\n\n{F84107663}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328574\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/config/notification-permissions.mjs", "browser/components/preferences/config/notifications.mjs", "browser/components/preferences/config/permissions-data.mjs", "browser/components/preferences/jar.mn", "browser/components/preferences/preferences.js", "browser/components/preferences/tests/permissions/browser-srd.toml", "browser/components/preferences/tests/permissions/browser_notifications_pane.js", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/preferences/preferences.css"], "git_node": "99972ae58137c0e89d74c519f7800b0f48886167", "git_parents": ["8301969b3bef125841b7bd16311f5dd8d0775162"], "node": "7b6f243da7459f117a93c7ee5dadcd6930679629", "parents": ["704fa5aa52e70213c68afd306ce7d217871a5f36"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2081700 - restoring session should restore tab with url and conversation with response card r=jlewis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334799\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/modules/AIWindowTabStatesManager.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_session_restore.js"], "git_node": "66bdeff6b17c1d3f21c149dc0201c9e7e7983501", "git_parents": ["99972ae58137c0e89d74c519f7800b0f48886167"], "node": "2247bb9c7c4ec46c5602b0cd0c9812975f05ec03", "parents": ["7b6f243da7459f117a93c7ee5dadcd69306