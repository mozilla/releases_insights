/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "54bb178fe62aefea0533589cb22f06ddd995f08c", "git_parents": ["ca379fc24380941bce9debca05d51e3da9142354"], "node": "fdbaca4a83c7854b585edb543e405b9ad3fda2fd", "parents": ["df4522bca8b33b84e8bcb7768cddb9edf47047f8"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083742 - Update date of end of promo in the holiday promo CFR string - r=ip-protection-reviewers,fluent-reviewers,mcleinman,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335156\n", "files": ["browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "0a4427aca70f3a50caf5945c83d9c39a6eb78949", "git_parents": ["54bb178fe62aefea0533589cb22f06ddd995f08c"], "node": "f2caae506a5896498df934decde29f2a1a30b84a", "parents": ["fdbaca4a83c7854b585edb543e405b9ad3fda2fd"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083697 - Convert verifyPDFViewerDownloadButtonTest regression UI test to the efficiency framework r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335131\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/PDFViewerTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/PDFViewerTest.kt"], "git_node": "e83084451efd80df3113b344fd30881b375e5830", "git_parents": ["0a4427aca70f3a50caf5945c83d9c39a6eb78949"], "node": "5aef71c7242658bc3a432e679f77dd771ba5319d", "parents": ["f2caae506a5896498df934decde29f2a1a30b84a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083469 - Fix translator ReferenceDrawTargetTransform handling for PushLayerWithBlend and CreateClippedDrawTarget. r=lsalzman\n\nSince we can replay it with a different transform applied, we can't\nquite just record device space bounds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334891\n", "files": ["gfx/2d/2D.h", "gfx/2d/DrawTarget.cpp", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetRecording.h", "gfx/2d/RecordedEventImpl.h", "testing/web-platform/tests/css/css-masking/mask-image/mask-image-cross-site-iframe-offset-ref.html", "testing/web-platform/tests/css/css-masking/mask-image/mask-image-cross-site-iframe-offset.sub.html", "testing/web-platform/tests/css/css-masking/mask-image/support/mask-image-cross-site-iframe-offset-frame.html"], "git_node": "3b0edac55fd90209e57b6d51713ffc93b03c331e", "git_parents": ["e83084451efd80df3113b344fd30881b375e5830"], "node": "446618a76e323dd8c6010457c9861b492d7ddbbb", "parents": ["5aef71c7242658bc3a432e679f77dd771ba5319d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2083828 - Don't launch a GPU process in xpcshell tests, r=firefox-desktop-core-reviewers ,Gijs,gfx-reviewers,sotaro.\n\nThis also applies to Windows, except in test_gpuprocess.js, which needs it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335333\n", "files": ["testing/profiles/xpcshell/user.js", "toolkit/components/aboutmemory/tests/xpcshell/xpcshell.toml"], "git_node": "d351703e0798be1cfbc370adb95866c57c7a1efb", "git_parents": ["3b0edac55fd90209e57b6d51713ffc93b03c331e"], "node": "dbf4f9f067b5ef7f881682cfe15540e71e9442f2", "parents": ["446618a76e323dd8c6010457c9861b492d7ddbbb"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075241 - [HNT] Show tabs tray when closing last tab on tab strip r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334734\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/TabStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/ext/LastTabClose.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/ext/LastTabCloseTest.kt"], "git_node": "0be6334febe12a0d2c95c8e3a0d924eb0495ae00", "git_parents": ["d351703e0798be1cfbc370adb95866c57c7a1efb"], "node": "1888735c1abf9cf1904dcb2dc5aa3b7d3c614bd4", "parents": ["dbf4f9f067b5ef7f881682cfe15540e71e9442f2"], "tags": []}, {"author": "Vanessa Prema \u003cvprema@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083099 - fix(pbw): spotlight HCM and animation fixes r=omc-reviewers,desktop-theme-reviewers,kcochrane,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334694\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/privatebrowsing/content/private-browsing-mask-intro.css", "browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css"], "git_node": "2ae31c25cc697708ed369aedbeb479938e94f92e", "git_parents": ["0be6334febe12a0d2c95c8e3a0d924eb0495ae00"], "node": "2a234ddc9de56aefbd58412ff921ff3ccb6970c2", "parents": ["1888735c1abf9cf1904dcb2dc5aa3b7d3c614bd4"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2080676 - jit/arm64: add the high bits of a large load/store offset to the base. r=yury\n\nWhen the immediate offset of a load or store does not fit the instruction,\nvixl's LoadStoreMacro materializes the whole offset and uses register-offset\naddressing. Wasm code does this for every instance data field beyond the\nscaled immediate range:\n\n  movz x16, #0x5ff0\n  movk x16, #0x2, lsl #16\n  ldr  w0, [x23, x16]\n\nIf the offset without its low 12 bits is an add/sub immediate and the low 12\nbits can be encoded in the access, add the high bits to the base instead:\n\n  add  x16, x23, #0x25, lsl #12\n  ldr  w0, [x16, #0xff0]\n\nApply the same split to the constant addresses of Ion's wasmLoadAbsolute and\nwasmStoreAbsolute, whose comment assumed that a single MOV would almost always\nsuffice.\n\nOn a JetStream 3 run on arm64 this removes 199,889 instructions from Wasm\ncode and 199 from Ion code. The remaining large constant addresses come from\nthe wasm baseline compiler, which moves the whole address into the pointer\nregister.\n\nIn 20 interleaved runs of the JetStream 3 wasm tests on an Apple M-series\nmachine, dotnet-aot-wasm improved by 1.9% and 8bitbench-wasm by 0.9%, with\nalmost no overlap between the before and after scores. The other tests did\nnot change measurably, and the wasm geometric mean rose by 0.4%.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332781\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/vixl/MacroAssembler-vixl.cpp"], "git_node": "40bfaf04391b50bbf98388f595cb877dcd5a73fe", "git_parents": ["2ae31c25cc697708ed369aedbeb479938e94f92e"], "node": "596f057a1860acdca107b4ced56d84f81b840183", "parents": ["2a234ddc9de56aefbd58412ff921ff3ccb6970c2"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2076754 - Update SkipTermsOfUse.description r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335566\n", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": "d14ffcfcd1f0dd0afe286b553ce7fcec44155bfb", "git_parents": ["40bfaf04391b50bbf98388f595cb877dcd5a73fe"], "node": "b434d97ab304ff204657f36333f9387c8d016fb8", "parents": ["596f057a1860acdca107b4ced56d84f81b840183"], "tags": []}, {"author": "def00111 \u003ckernp@gmx.de\u003e", "branch": "default", "desc": "Bug 2083921 - Refactor userChromeJS URI prefix checks. r=emilio\n\nMove userChromeJS URI prefixes into constexpr arrays and use `std::any_of` to check them, avoiding duplicated prefix checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335362\n", "files": ["dom/security/nsContentSecurityUtils.cpp"], "git_node": "a8e111f7405e67a060f66946b40217c9f412600b", "git_parents": ["d14ffcfcd1f0dd0afe286b553ce7fcec44155bfb"], "node": "b64882e361174b823e485091e0e1fc01011876e3", "parents": ["b434d97ab304ff204657f36333f9387c8d016fb8"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083677 - Only warn about a missing printer name when printer specific prefs were requested. r=emilio\n\nCallers that don't want printer specific prefs, e.g. content processes which\ndon't get to know the printer name, deliberately get an empty printer name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335269\n", "files": ["widget/nsPrintSettingsService.cpp"], "git_node": "f7c83c8e42bb5530cf43db1c97c758243216a4e5", "git_parents": ["a8e111f7405e67a060f66946b40217c9f412600b"], "node": "4333856e6a49b1537a4f48de982987eb9a715c45", "parents": ["b64882e361174b823e485091e0e1fc01011876e3"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077673 - Add a zero prefix urlbar providers for tests that need the urlbar to open when empty. r=urlbar-reviewers,daleharvey\n\nThe approach is copied from bug 2081576.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335160\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_popover_state.js", "browser/components/urlbar/tests/browser-editing/browser_deleteAllText.js", "browser/components/urlbar/tests/browser-editing/browser_less_common_selection_manipulations.js", "browser/components/urlbar/tests/browser-editing/browser_readOnly.js", "browser/components/urlbar/tests/browser-results/browser_retainedResultsOnFocus.js", "browser/components/urlbar/tests/browser-searchMode/browser_clickLink.js", "browser/components/urlbar/tests/browser-searchMode/browser_no_results.js", "browser/components/urlbar/tests/browser-searchMode/browser_omnibox.js", "browser/components/urlbar/tests/browser-searchMode/browser_oneOffButton.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_dynamicUnifiedSearchButton.js", "browser/components/urlbar/tests/browser-searchMode/browser_setURI.js", "browser/components/urlbar/tests/browser-tabs/browser_switchToTab_chiclet.js", "browser/components/urlbar/tests/browser/browser_autoOpen.js", "browser/components/urlbar/tests/browser/browser_close_other_panels.js", "browser/components/urlbar/tests/browser/browser_locationBarCommand.js", "browser/components/urlbar/tests/browser/browser_tabKeyBehavior.js"], "git_node": "5043b7a4a9d77f2934e039c196aba66d00dd06d0", "git_parents": ["f7c83c8e42bb5530cf43db1c97c758243216a4e5"], "node": "278344372b97c8cb2d24f4cb8946dc961e9c90b1", "parents": ["4333856e6a49b1537a4f48de982987eb9a715c45"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083666 - Remove the now-redundant Expat version-limit patch. r=hsivonen\n\nExpat 2.8.5 added its own `checkXmlDeclVersionNum` check that accepts the XML Fifth Edition's \"1.[0-9]+\"\nVersionNum grammar. Our local 09_version_limit.patch ran its own, stricter \"1.0\" exact match right after it,\nso the new upstream check had no effect and xml-prolog-accepted-versions.html stayed failing after the 2.8.5\nupdate.\n\nRemoving our check (rather than disabling upstream's) takes the Fifth Edition behavior upstream already\nimplements, which is also closer to Chrome's.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335343\n", "files": ["parser/expat/09_version_limit.patch", "parser/expat/expat/lib/xmltok.c", "parser/expat/moz.yaml", "testing/web-platform/meta/xml/xml-prolog-accepted-versions.html.ini"], "git_node": "dacbc1875cb79d1f26a24233e51566a56974a1cd", "git_parents": ["5043b7a4a9d77f2934e039c196aba66d00dd06d0"], "node": "2a5d6e20961915d9887847fbf9b26584f5e1d6b8", "parents": ["278344372b97c8cb2d24f4cb8946dc961e9c90b1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083667 - Add a WPT for XML innerHTML rejecting a lone unpaired surrogate. r=hsivonen\n\nExpat 2.8.5 (bug 2074541) rejects a lone UTF-16 high surrogate as not well-formed, so setting innerHTML on an\nXML document to one now throws a SyntaxError DOMException instead of inserting the raw surrogate and part of\nthe markup after it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335344\n", "files": ["testing/web-platform/tests/xml/xml-innerHTML-unpaired-surrogate.html"], "git_node": "d58b30ec6db5f4e1d04accea63b3038cbeb02239", "git_parents": ["dacbc1875cb79d1f26a24233e51566a56974a1cd"], "node": "3e4ad64ceda67e1cb8b73e578638c4ecd50ecf45", "parents": ["2a5d6e20961915d9887847fbf9b26584f5e1d6b8"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082039 - Hold strong reference to ImageListener and requests during OnStartRequest r=smaug\" for causing crashtest failures at image/imgLoader.cpp\n\nThis reverts commit 4