com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48713}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "f87d03f697f80d4a21789e7b9f26ca532dadef8d", "git_parents": ["15998740fb417573586f0caac50cd363223c9d97"], "node": "ba4ec50e193e00d17e9d3191ef9c3340642260ce", "parents": ["c1c9ccbd08ae0c2e1b33e0206880c55a1685a3a3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from fc12d47a84\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fc12d47a84b7fbc54ddbaf6b520f9e80f2bdff66\n    Cleanup expired field trial WebRTC-LegacyFrameIdJumpBehavior\n\n    Bug: webrtc:42223541, b/493520221\n    Change-Id: I7842e4e12697adbb6d1595da90dd8f5fc764c046\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505420\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48714}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video/frame_buffer.cc", "third_party/libwebrtc/api/video/frame_buffer.h", "third_party/libwebrtc/api/video/frame_buffer_unittest.cc", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch"], "git_node": "2e3b09288df20570b8fe918d8094dca0f6519adf", "git_parents": ["f87d03f697f80d4a21789e7b9f26ca532dadef8d"], "node": "c53b4db1d260f6273e7b1a3cb84f45137c105b4b", "parents": ["ba4ec50e193e00d17e9d3191ef9c3340642260ce"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 244d513bd2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/244d513bd224f6684d209b7ceb47bf4a9bb774b8\n    Update AUTHORS\n\n    Switch from personal to work profile account for Jan Grulich.\n\n    Bug: none\n    Change-Id: Ia861cd234c18ef81169dc857eb6716dcf78621b0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505640\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Commit-Queue: Jan Grulich \u003cjgrulich@redhat.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48715}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "08fbbc1d7ab4722cf1011fd8ea8aae0fe30a01b2", "git_parents": ["2e3b09288df20570b8fe918d8094dca0f6519adf"], "node": "9ab621f9cc2fb85372e1de5e46331bb138dca46a", "parents": ["c53b4db1d260f6273e7b1a3cb84f45137c105b4b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 24e5a24506\n\nUpstream commit: https://webrtc.googlesource.com/src/+/24e5a24506bdd37a7894c9fee446b9db9e4b64df\n    Ignore binding requests on ports without ICE role\n\n    A port that was never handed over to an ICE agent, e.g. a TURN port\n    pruned before becoming ready, can still receive STUN binding requests.\n    Without an ICE role, handling such a request hits a DCHECK in\n    Port::MaybeIceRoleConflict(), and nothing would act on it anyway.\n\n    Drop binding requests from unknown addresses in Port::OnReadPacket()\n    while the port's ICE role is ICEROLE_UNKNOWN.\n\n    Bug: none\n    Change-Id: Ic731818c2de5081600affe6256cfaa5ba03856fa\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505500\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Jonas Oreland \u003cjonaso@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48716}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/base/port.cc", "third_party/libwebrtc/p2p/base/port_unittest.cc"], "git_node": "a71d13c69d60196c45f87a61186bd8f8d62037cc", "git_parents": ["08fbbc1d7ab4722cf1011fd8ea8aae0fe30a01b2"], "node": "30993cfa720ce9c0a30b90308889620bceb58359", "parents": ["9ab621f9cc2fb85372e1de5e46331bb138dca46a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 06d0908f5f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/06d0908f5f28d7087f2cb9e6cc62e90c295f0145\n    Cleanup deprecated WebRTC-DisableRtxRateLimiter field trial\n\n    It was enabled by default for more than two years.\n\n    Bug: webrtc:42225500\n    Change-Id: I2c1f1a906bef6524752666c58db6dcdda4f9aa73\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/504480\n    Reviewed-by: Ying Wang \u003cyinwa@webrtc.org\u003e\n    Commit-Queue: Ying Wang \u003cyinwa@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48717}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/BUILD.gn", "third_party/libwebrtc/audio/channel_receive.h", "third_party/libwebrtc/audio/channel_send.cc", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/rtp_transport_controller_send.cc", "third_party/libwebrtc/call/rtp_transport_controller_send.h", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0029.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0069.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0122.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch"], "git_node": "1e41e992691af41595533f00c1807229929fbbf8", "git_parents": ["a71d13c69d60196c45f87a61186bd8f8d62037cc"], "node": "31b7decbabb471395378b67f5645d8cf9bee13a6", "parents": ["30993cfa720ce9c0a30b90308889620bceb58359"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from ff049e0b33\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ff049e0b33adabb36ac462b6b2b35acd8f4e3c63\n    Add RetransmitFlushedPacketsSettings and field trial registry entry.\n\n    Introduces `WebRTC-RetransmitFlushedPackets` field trial and helper\n    parser `RetransmitFlushedPacketsSettings` to configure whether flushed\n    packets on keyframe are allowed to be retransmitted and the RTT\n    multiplier to use for delayed retransmission.\n\n    Bug: webrtc:564720400\n    Change-Id: Ie7537401e38809cda830a93e9c15f29e2cf1ce9b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505460\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48718}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/rtc_base/experiments/BUILD.gn", "third_party/libwebrtc/rtc_base/experiments/retransmit_flushed_packets_settings.cc", "third_party/libwebrtc/rtc_base/experiments/retransmit_flushed_packets_settings.h", "third_party/libwebrtc/rtc_base/experiments/retransmit_flushed_packets_settings_unittest.cc"], "git_node": "ed36ba09b02bf6cc88c88feea96db3c53d7fbb83", "git_parents": ["1e41e992691af41595533f00c1807229929fbbf8"], "node": "b1f065d18ce5d3440c6d4f91b3702c91df03865f", "parents": ["31b7decbabb471395378b67f5645d8cf9bee13a6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 0fed1da7ea\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0fed1da7ea12fadf7a1f205d275bf4010f518bdb\n    Align cl-description skill with Chromium's version\n\n    The skill lacked guidance on when to ask the user for missing\n    information, did not reflect WebRTC's presubmit rules for bug footers,\n    and relied on the model to wrap lines at 72 columns, which it does\n    unreliably.\n\n    - Restructure the skill after Chromium's cl-description skill:\n      pre-flight questions, formatting constraints, body and footer rules.\n    - Document WebRTC-specific footer rules (tracker prefix, Bug: none),\n      optional subject prefixes, reverts and relands.\n    - Add conciseness guidelines to keep descriptions short.\n    - Add wrap_lines.py to wrap drafts at 72 columns deterministically.\n\n    Bug: webrtc:465491622\n    Change-Id: I9a7640ec95ee2345d3fb8de2e26913e0e9a3d5f2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505380\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48719}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/agents/skills/cl-description/SKILL.md", "third_party/libwebrtc/agents/skills/cl-description/scripts/wrap_lines.py", "third_party/libwebrtc/agents/skills/cl-description/scripts/wrap_lines_test.py"], "git_node": "69d96397f9d0c72b92205d22cb8f84eb91ef2856", "git_parents": ["ed36ba09b02bf6cc88c88feea96db3c53d7fbb83"], "node": "5aac82956bce860b8049bdab87d11d317e3fac98", "parents": ["b1f065d18ce5d3440c6d4f91b3702c91df03865f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 09d033248a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/09d033248a1a087d9f7ad7f3aa4e33f3de4c4ba4\n    Implement safe reset on route change in ScreamNetworkController\n\n    When a route change occurs with restart_bwe = true, cap the starting rate\n    to min(current_target_rate, configured_start_rate) so degraded paths\n    do not jump back up to the default start rate.\n\n    Guarded by the SafeResetOnRouteChange field trial in WebRTC-Bwe-ScreamV2\n    (default enabled).\n\n    Bug: webrtc:447037083\n    Change-Id: Icc4442b8d023bb4258830d39fc16db5e7be46a1b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505123\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48720}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller_unittest.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.h", "third_party/libwebrtc/rtc_tools/BUILD.gn", "third_party/libwebrtc/rtc_tools/rtc_event_log_visualizer/log_scream_simulation.cc", "third_party/libwebrtc/rtc_tools/rtc_event_log_visualizer/log_scream_simulation.h"], "git_node": "e30ef8b1907a1566551c4e7f2ebc8a51a9484b42", "git_parents": ["69d96397f9d0c72b92205d22cb8f84eb91ef2856"], "node": "3e2d07c09c082dc96c353096e417e44dfc402b20", "parents": ["5aac82956bce860b8049bdab87d11d317e3fac98"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 3dab3847be\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3dab3847be58a80e542b9d65181e5595eb5d7cc6\n    Avoid unintended IllegalStateExceptions on disposed Android WebRTC objects\n\n    Recent UAF fixes introduced NativeLifecycleLock checks that throw\n    IllegalStateException whenever a method is called on a disposed Java\n    wrapper. However, several cleanup and teardown paths (such as\n    VideoTrack.removeSink, MediaStream.removeTrack, VideoSource\n    capturer callbacks, DataChannel.close/unregisterObserver,\n    RtpSender.setTrack, and PeerConnection methods) previously acted as\n    no-ops or returned default values when called after disposal, or are\n    invoked when C++ automatically disposes Java wrappers during callbacks\n    (e.g. onRemoveStream, getSenders, getReceivers, getTransceivers).\n\n    Add non-throwing helpers to NativeLifecycleLock (callOrDefault,\n    runIfAlive, getNativePointerOrZero) that log a warning and return a\n    fallback value when disposed while still holding the read lock to\n    prevent UAF races with concurrent disposal. Restore non-throwing\n    behavior on methods that previously did not throw IllegalStateException.\n\n    Bug: b/533453798, b/564970616\n    Change-Id: I2c3f46e97c8ec63861d8651620a5673315844f95\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505580\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Linus Nilsson \u003clnilsson@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48721}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/sdk/android/api/org/webrtc/DataChannel.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoSource.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoTrack.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/NativeLifecycleLock.java"], "git_node": "ff226fbed759298b918f949afbf7232846a7806b", "git_parents": ["e30ef8b1907a1566551c4e7f2ebc8a51a9484b42"], "node": "70a80fcb39a92d361f401ce68704e7bf2ea62472", "parents": ["3e2d07c09c082dc96c353096e417e44dfc402b20"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 82df4ce422\n\nUpstream commit: https://webrtc.googlesource.com/src/+/82df4ce4226de25e1682351d7ba2e9bf9a198790\n    Ensure stopped transceivers do not hold a channel\n\n    Make sure that a transceiver that has been stopped does not get a\n    channel during negotiation, and that any channel is cleared before a\n    stopped transceiver is removed from the transceiver list.\n\n    Bug: chromium:565742177\n    Change-Id: I63251adef97c03644d499ad95baa244033f6678e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505661\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48722}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/sdp_offer_answer.cc", "third_party/libwebrtc/pc/sdp_offer_answer_unittest.cc"], "git_node": "d1af983e76eb3037148b68f3d3e9ca7f56e8b1ee", "git_parents": ["ff226fbed759298b918f949afbf7232846a7806b"], "node": "ca909c9c89059079c693cb73e50b743b6a78286d", "parents": ["70a80fcb39a92d361f401ce68704e7bf2ea62472"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from cae4027d86\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cae4027d86edc8f1278098c4aa1fea909a23c6f4\n    Roll chromium_revision c67a753d3c..d7aeebe574 (1704261:1704344)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/c67a753d3c..d7aeebe574\n    Full diff: https://chromium.googlesource.com/chromium/src/+/c67a753d3c..d7aeebe574\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/2d1798e676..8f4d213ca2\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/b41450aa61..fcc3c72143\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/af9cdcb167..e0ff46a43c\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/b71bc411fe..6eabe54fa1\n    * src/third_party/android_deps/autorolled/cipd: gDS_f-3foKUmcuifytnd9_t-5Jp8XmWll0MIbRY0CP4C..-VG0wmSq86E_kYUtjovcWcZ9CHJExiXYLZW21pDxZ6sC\n    * src/third_party/androidx/cipd: Xeu8AlvK0qfOypyiuDxFDtrPzC23MBIV78p1Qj72NFIC..yfMv1nBbg8hNa256uWCMTnYDmyQtGnHL5qM6wyU0CTYC\n    * src/third_party/depot_tools: https://chromium.googlesource.com/chromium/tools/depot_tools.git/+log/91b9ca4db8..349b317591\n    * src/third_party/perfetto: https://chromium.googlesource.com/external/github.com/google/perfetto.git/+log/084ed71c4e..f6966cacc0\n    * src/third_party/sframe/src: https://chromium.googlesource.com/external/github.com/cisco/sframe/+log/b140909044..db604c8f19\n    * src/tools: https://chromium.googlesource.com/chromium/src/tools/+log/696ac5c235..0d9c7e8905\n    DEPS diff: https://chromium.googlesource.com/chromium/src/+/c67a753d3c..d7aeebe574/DEPS\n\n    Bug: webrtc:479862368\n    Change-Id: Ifda4e89700b2e6be9c4d1ce3097179d7b8a8c1c0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505700\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48723}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/sframe/sframe_encryptor_decryptor_unittest.cc"], "git_node": "8b9b6a76096503342bf387c0f887a6cb8e32e040", "git_parents": ["d1af983e76eb3037148b68f3d3e9ca7f56e8b1ee"], "node": "449698ed80988a35f955f14ff1a06c3a10904635", "parents": ["ca909c9c89059079c693cb73e50b743b6a78286d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 79f0ad8d65\n\nWe already cherry-picked this when we vendored 6808fa893a.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/79f0ad8d65c358eeadbc59a4985b9a792ca59555\n    Revert \"Prepare VideoSendStreamImpl for asynchronous Stop\"\n\n    This reverts commit 6808fa893ae9f02258bd28628e3a9b59a6c950a8.\n\n    Reason for revert: b/565721208\n\n    Failure Link: b/565721208\n\n    Original change's description:\n    \u003e Prepare VideoSendStreamImpl for asynchronous Stop\n    \u003e\n    \u003e ~VideoSendStreamImpl destroys rtp_video_sender_ in the destructor body,\n    \u003e before member destruction reaches video_stream_encoder_. Because the\n    \u003e encoder holds raw pointers to rtp_video_sender_ (as EncoderSink and\n    \u003e FecControllerOverride), making VideoStreamEncoder::Stop() non-blocking\n    \u003e would leave those pointers dangling until ~VideoStreamEncoder finishes\n    \u003e draining the encoder queue.\n    \u003e\n    \u003e Reset video_stream_encoder_ before destroying rtp_video_sender_, and\n    \u003e deactivate rtp_video_sender_ before stopping the encoder in\n    \u003e StopPermanentlyAndGetRtpStates.\n    \u003e\n    \u003e Bug: webrtc:564441352\n    \u003e Change-Id: I90c553d6c8778e7ad4159d352f8f3060f95ac1dd\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/504481\n    \u003e Commit-Queue: Markus Handell \u003chandellm@webrtc.org\u003e\n    \u003e Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48674}\n\n    No-Try: True\n    Bug: webrtc:564441352\n    Change-Id: If4ed11a4efa0e848146ee5ba8aeba172e4bb4466\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505720\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Markus Handell \u003chandellm@webrtc.org\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48724}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/79f0ad8d65.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "652b83a72675bf2f3bde710689308d27f1ba960f", "git_parents": ["8b9b6a76096503342bf387c0f887a6cb8e32e040"], "node": "b96cd0ba33bd1965fc9aa59c2a2cb6adfe97f51f", "parents": ["449698ed80988a35f955f14ff1a06c3a10904635"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 296b10a7cd\n\nUpstream commit: https://webrtc.googlesource.com/src/+/296b10a7cde3ed1007d22bb9b579a9ea394f85ed\n    Return removed packets from PrioritizedPacketQueue::RemovePacketsForSsrc\n\n    Updates RemovePacketsForSsrc to return a vector containing the removed\n    packets instead of discarding them internally, so callers can process\n    flushed packets.\n\n    Bug: webrtc:564720400\n    Change-Id: I21fa455993d83a3c0cce6dfc3207efb664d6aaad\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505740\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48725}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/pacing/prioritized_packet_queue.cc", "third_party/libwebrtc/modules/pacing/prioritized_packet_queue.h", "third_party/libwebrtc/modules/pacing/prioritized_packet_queue_unittest.cc"], "git_node": "1b8c721ea61502b0e1d508832033202a76cb3798", "git_parents": ["652b83a72675bf2f3bde710689308d27f1ba960f"], "node": "e4ec12e68f165e227603e838f1ffe1e3a7d2b772", "parents": ["b96cd0ba33bd1965fc9aa59c2a2cb6adfe97f51f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 34dcecc3a9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/34dcecc3a977c4bec59c6f27aed634976429191f\n    [agc2] Reset SpeechLevelEstimatorExperimental state after timeout\n\n    Once initial speech level confidence is reached, enforce a time limit\n    (kDefaultMaxTimeToUpdateMs) for accumulating kFramesPerUpdate reliable speech frames. If the threshold is not met within the time limit, reset the estimator state and flag a background speaker. This prevents sporadic background utterances from slowly accumulating and corrupting the tracked level.\n\n    Additionally, kDefaultBackgroundSpeakerOffsetDbfs is retuned to a value equal to 7.\n\n    Bug: webrtc:42232605\n    Change-Id: I13efbcf1dff7effd3e6201631d5826ed925ad1d4\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505660\n    Reviewed-by: Sam Zackrisson \u003csaza@webrtc.org\u003e\n    Commit-Queue: Jesus de Vicente Pena \u003cdevicentepena@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48726}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_processing/agc2/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator.cc", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator_experimental_impl.cc", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator_experimental_impl.h", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator_experimental_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0094.patch"], "git_node": "2b31e5e66c94545b4bc5508b8de34190ab4177e7", "git_parents": ["1b8c721ea61502b0e1d508832033202a76cb3798"], "node": "95df359388c5bc3c5c6e7db3440e9c783dabbbeb", "parents": ["e4ec12e68f165e227603e838f1ffe1e3a7d2b772"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from ba511622a2\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in afaafbd652.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ba511622a24945fdd2b5b26b5a9275f0c6daff5e\n    Reject corrupted frames in the VP8 video decoder.\n\n    The libvpx VP8 decoder has always returned error on malformed keyframes\n    but it turns out that corrupted delta frames may actually decode with\n    error, upon which the decoder still returns `VPX_CODEC_OK`. It is then\n    up to the user to poll the `VP8D_GET_FRAME_CORRUPTED` flag to see if it\n    was indeed OK.\n\n    This CL adds a unit test the demonstrated this condition and shows that\n    we now reject the corrupted frame instead of continuing with error.\n\n    Bug: chromium:561396583\n    Change-Id: I1e5c65225fc389be8b37d4c7da9a2cbf9a0c6ec2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505800\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48727}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/afaafbd652.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "d3b045f3a3ae44625c37d3918c20b6f9e984befc", "git_parents": ["2b31e5e66c94545b4bc5508b8de34190ab4177e7"], "node": "876470ba3732b46e8224fb6993659359ea4a2e8e", "parents": ["95df359388c5bc3c5c6e7db3440e9c783dabbbeb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 18bd403e01\n\nUpstream commit: https://webrtc.googlesource.com/src/+/18bd403e018cbe835eb7352649ade5b312cbf326\n    Turn webrtc_perf_tests into a rtc_test_suite\n\n    Change-Id: I9af30cfd278b931df2b52b5bb011a047383da880\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505620\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48728}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/modules/audio_coding/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0091.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/video/BUILD.gn"], "git_node": "e6794d3b602d908d0ddc41fe2db495648146fac5", "git_parents": ["d3b045f3a3ae44625c37d3918c20b6f9e984befc"], "node": "047e2ef531f1d1cbe5b7b3862d205e6590642a19", "parents": ["876470ba3732b46e8224fb6993659359ea4a2e8e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 6cf6bcb585\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6cf6bcb585b31414aac02377df2bc8fec770d0e8\n    Update WebRTC code version (2026-09-26T04:08:04).\n\n    Bug: None\n    Change-Id: I77d7d2bcd873edf592c878f8fbf7cd8cae4447ef\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505840\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48729}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "bea4485fee0fb8ee59f0a8a978bf3e622b03409a", "git_parents": ["e6794d3b602d908d0ddc41fe2db495648146fac5"], "node": "b0f081eb1f8e65cf83775b7476c17bc679be8c07", "parents": ["047e2ef531f1d1cbe5b7b3862d205e6590642a19"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 2bd77bd0d9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2bd77bd0d91b5bde63ca63991b649492169667f7\n    Adding missing checks for runtime settings in protobuf\n\n    Bug: webrtc:5298\n    Change-Id: I207822059c099dedd726ba604cf1b58d371bf20d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/182000\n    Reviewed-by: Alessio Bazzica \u003calessiob@webrtc.org\u003e\n    Commit-Queue: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Reviewed-by: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Reviewed-by: Gustaf Ullberg \u003cgustaf@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48730}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_processing/test/runtime_setting_util.cc"], "git_node": "6cf9e2cb8bbc24bee01cfae280c2a243141da615", "git_parents": ["bea4485fee0fb8ee59f0a8a978bf3e622b03409a"], "node": "fac064f600ef59fcd1166a5af161def8be9c2a34", "parents": ["b0f081eb1f8e65cf83775b7476c17bc679be8c07"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 27a27ee348\n\nUpstream commit: https://webrtc.googlesource.com/src/+/27a27ee348549c7d5ae3ae95c571d1bc525dfb51\n    Avoid duplicate TCP allocations during gathering\n\n    A network change notification can start another TCP allocation\n    before an existing sequence creates its TCP port.\n\n    Bug: webrtc:566467875\n    Change-Id: Ic02184894f33ab8ffae94cbdefaad988b6ea471c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505980\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48731}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/client/basic_port_allocator.cc", "third_party/libwebrtc/p2p/client/basic_port_allocator_unittest.cc"], "git_node": "5c7e97690a79425aa819c5f01d21ffb537a27d33", "git_parents": ["6cf9e2cb8bbc24bee01cfae280c2a243141da615"], "node": "838e6209f9690ad85264f3796fdb6d9951db9cc2", "parents": ["fac064f600ef59fcd1166a5af161def8be9c2a34"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 43f5a1c963\n\nUpstream commit: https://webrtc.googlesource.com/src/+/43f5a1c963381978d29a2f2b85633bb9ad7303f5\n    Report parsed key id on SFrame unknown-key decrypt failures\n\n    `ToSframeDecryptFailure` previously mapped `invalid_parameter_error` to\n    a `kKeyId` failure with an empty key id, because the Cisco Sframe\n    library did not surface the key id parsed from the SFrame header.\n\n    The library now returns a dedicated\n    `SFrameErrorType::unknown_key_id_error` carrying the parsed key id, so\n    the mapping is switched over to it and the key id is propagated into\n    `SframeDecryptFailure::KeyId`. Applications listening for\n    `SframeDecryptErrorCallback` can now tell *which* key is missing,\n    matching\n    [SFrameTransformErrorEvent.keyID](https://w3c.github.io/webrtc-encoded-transform/#dom-sframetransformerrorevent-keyid).\n\n    `invalid_parameter_error` now falls through to the `kSyntax` default,\n    which is the correct classification for a malformed header.\n\n    Additional changes:\n    - Re-enabled `SframeEncryptorDecryptorTest.DISABLED_DecryptReportsKeyIdErrorForUnknownKey`\n      and tightened it to assert the reported key id equals the encryption key id.\n\n    Bug: webrtc:479862368\n    Change-Id: I5af6c6b42f1fe46acbdeba6168d4a20f1f8a0869\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506020\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48732}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/sframe/sframe_decryptor.cc", "third_party/libwebrtc/modules/sframe/sframe_encryptor_decryptor_unittest.cc"], "git_node": "10f92e19a3dea2ff2795dfd9c2605c81cc8842d1", "git_parents": ["5c7e97690a79425aa819c5f01d21ffb537a27d33"], "node": "9d7286ab04d53c4e51081b88228ed7240ccd0830", "parents": ["838e6209f9690ad85264f3796fdb6d9951db9cc2"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 656517acd3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/656517acd38c2621edc4905caf0efe389843bb8c\n    Remove dead HAVE_NO_MEDIA branch from RTCPeerConnectionFactory\n\n    Nothing has defined HAVE_NO_MEDIA since\n    https://webrtc-review.googlesource.com/c/src/+/266741, so the branch in\n    initWithEncoderFactory:decoderFactory:audioDevice: is dead code.\n    initWithNoMedia stays, since it is declared in\n    RTCPeerConnectionFactory+Native.h.\n\n    Bug: webrtc:546793420\n    Change-Id: Ib8d4b98f6ed34d771097c1d2e650bcee86c947fc\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506041\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48733}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/sdk/objc/api/peerconnection/RTCPeerConnectionFactory.mm"], "git_node": "b1cc12d472c0862bd85462de384a268ce725d9f3", "git_parents": ["10f92e19a3dea2ff2795dfd9c2605c81cc8842d1"], "node": "19f63e9ad8fe0610133d2bce953055fac579c8b1", "parents": ["9d7286ab04d53c4e51081b88228ed7240ccd0830"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 401392b7e6\n\nUpstream commit: https://webrtc.googlesource.com/src/+/401392b7e6bd71a275738dc99a3e448cf7bd8fe3\n    Remove Fieldtrial WebRTC-Aec3EchoSaturationDetectionKillSwitch\n\n    Bug: webrtc:5298\n    Change-Id: I34c2494691cec5feb6565879c86b01cdb07cd1a1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505260\n    Reviewed-by: Jesus de Vicente Pena \u003cdevicentepena@webrtc.org\u003e\n    Commit-Queue: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48734}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_processing/aec3/echo_canceller3.cc"], "git_node": "c0d3591f1f31b1fccc4c7502d1d77cd58948a19b", "git_parents": ["b1cc12d472c0862bd85462de384a268ce725d9f3"], "node": "9367b0b470cafdce4a4aeb5be5316d34654e6f63", "parents": ["19f63e9ad8fe0610133d2bce953055fac579c8b1"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 (MOZ) - Add a header to libwebrtc's third_party/dav1d trampoline setup\n", "files": ["third_party/libwebrtc/third_party/dav1d/libdav1d/include/dav1d/common.h"], "git_node": "dac99abead46ad249cbed354ffd60368273349ab", "git_parents": ["c0d3591f1f31b1fccc4c7502d1d77cd58948a19b"], "node": "e3812e1fd740c8a84898b9f5f12f878389179c53", "parents": ["9367b0b470cafdce4a4aeb5be5316d34654e6f63"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 574c6a5c27\n\nUpstream commit: https://webrtc.googlesource.com/src/+/574c6a5c276b560896dbc6d1aa9530b7cf1f6a29\n    dav1d: drain instead of failing on EAGAIN\n\n    dav1d keeps the tail of a temporal unit buffered once a picture is ready\n    and rejects new input with EAGAIN until it is drained. Decode() treated\n    that EAGAIN as fatal, so a trailing OBU would make every later Decode()\n    fail.\n\n    Drain with dav1d_get_picture() until it returns EAGAIN and retry the\n    send, similar to Chromium's dav1d decoder. A unit without a picture now\n    returns WEBRTC_VIDEO_CODEC_NO_OUTPUT.\n\n    Bug: webrtc:561877904\n    Change-Id: Ic8545a60f97f29ac4dd1a23c4da8f83b02960792\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/503960\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48735}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/codecs/av1/dav1d_decoder.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/dav1d_decoder_unittest.cc"], "git_node": "1d175afd258d8deab33b42199ce5efb72a761272", "git_parents": ["dac99abead46ad249cbed354ffd60368273349ab"], "node": "937271528e4eb1071e7ac284bf51c746bb4b6999", "parents": ["e3812e1fd740c8a84898b9f5f12f878389179c53"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from afaafbd652\n\nWe already cherry-picked this when we vendored ba511622a2.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/afaafbd652b0cfd173f1fc16c8b5cc87636477ec\n    Revert \"Reject corrupted frames in the VP8 video decoder.\"\n\n    This reverts commit ba511622a24945fdd2b5b26b5a9275f0c6daff5e.\n\n    Reason for revert: breaks downstream test\n\n    Original change's description:\n    \u003e Reject corrupted frames in the VP8 video decoder.\n    \u003e\n    \u003e The libvpx VP8 decoder has always returned error on malformed keyframes\n    \u003e but it turns out that corrupted delta frames may actually decode with\n    \u003e error, upon which the decoder still returns `VPX_CODEC_OK`. It is then\n    \u003e up to the user to poll the `VP8D_GET_FRAME_CORRUPTED` flag to see if it\n    \u003e was indeed OK.\n    \u003e\n    \u003e This CL adds a unit test the demonstrated this condition and shows that\n    \u003e we now reject the corrupted frame instead of continuing with error.\n    \u003e\n    \u003e Bug: chromium:561396583\n    \u003e Change-Id: I1e5c65225fc389be8b37d4c7da9a2cbf9a0c6ec2\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505800\n    \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48727}\n\n    Bug: chromium:561396583, b/566204684\n    Change-Id: I862d07778dfa77aa9615ddda1e96c4b2925d25b7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505880\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48736}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/afaafbd652.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "53f95a6a8005f1c414f472c50170062459319a73", "git_parents": ["1d175afd258d8deab33b42199ce5efb72a761272"], "node": "fd232cdaf6d8762169f0fe9803ce764ed6927a97", "parents": ["937271528e4eb1071e7ac284bf51c746bb4b6999"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 3225248425\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3225248425fe2b3cafe389465b94ebc24968d9ba\n    Add a spatial layer rate allocation test for V2 VideoEncoderInterface.\n\n    Drives the encoder through SxT1 structures, for every spatial layer\n    count it supports, and checks that the stream hits its target bitrate\n    and that each spatial layer gets the share it was allocated. Each layer\n    is predicted from its own previous frame and from the layer below in\n    the same temporal unit.\n\n    Unlike the scalability modes of that name, all layers use the same\n    resolution: only the bitrate allocation is of interest here.\n\n    The keyframe is counted towards the base layer rather than left out, so\n    the per layer checks also cover how the encoder pays for it. The same\n    now applies to the temporal layer test. With libaom this costs the base\n    layer about three percentage points: the worst spatial base layer goes\n    from 3.2% to 6.2% off, hence an 8% tolerance, and the worst temporal\n    base layer to 5.1%, well within its existing tolerance.\n\n    Spatio-temporal structures, and ones where not every spatial layer is\n    present in every temporal unit, are left as a TODO; the latter are known\n    to reset the rate control state of the missing layers in libaom.\n\n    Bug: webrtc:496266459\n    Change-Id: Ib013e79fb99927d4305595ae44cc6b8abe02fa31\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505680\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48737}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/test/video_encoder_rate_control_unittest.cc"], "git_node": "3bc43e38aa64987f952a96900e867bf6717c55ab", "git_parents": ["53f95a6a8005f1c414f472c50170062459319a73"], "node": "e1e2af4a6976159e18cfd817a54911fae575adcb", "parents": ["fd232cdaf6d8762169f0fe9803ce764ed6927a97"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 8c12eb54fe\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8c12eb54fe9acf73684316880913d677ceccf1cb\n    [M156] Harden payload capacity and reduction checks in RTP packetizers\n\n    Original change's description:\n    \u003e Harden payload capacity and reduction checks in RTP packetizers\n    \u003e\n    \u003e Ensure packet reduction lengths cannot be negative when computing\n    \u003e payload limits in RTPSenderVideo and when determining needed payload\n    \u003e sizes during aggregation. Additionally, add a bounds check against\n    \u003e available payload capacity before copying aggregated fragments in\n    \u003e RtpPacketizerH265.\n    \u003e\n    \u003e Bug: chromium:567088927\n    \u003e Change-Id: Ibd57aacce9ef79379fa627903d4aed89c9fbf489\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506260\n    \u003e Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48750}\n\n    (cherry picked from commit fc6666263eafa63878d02102189e3dabe9c90455)\n\n    Bug: chromium:567088927\n    Fixed: chromium:567813289\n    Change-Id: Ibd57aacce9ef79379fa627903d4aed89c9fbf489\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506561\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8078@{#1}\n    Cr-Branched-From: 3225248425fe2b3cafe389465b94ebc24968d9ba-refs/heads/main@{#48737}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_h264.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_h264_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packetizer_h265.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packetizer_h265_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/moz-patch-stack/s0120.patch"], "git_node": "6d07caf0c6f3f11233723d7e171eb30a7b3330a3", "git_parents": ["3bc43e38aa64987f952a96900e867bf6717c55ab"], "node": "fba23683880c8dfa08db3ccc5d5bbce221838000", "parents": ["e1e2af4a6976159e18cfd817a54911fae575adcb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 6306c66dfc\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6306c66dfc3d67d833070761467fbfe9715c86a2\n    [M156] Keep transceiver MID in sync with its channel\n\n    Original change's description:\n    \u003e Keep transceiver MID in sync with its channel\n    \u003e\n    \u003e When applying a local description, a transceiver could be matched to an\n    \u003e m= section by its index even if it was already associated with a\n    \u003e different MID. The channel of the transceiver keeps using the MID it was\n    \u003e created for, so the two could get out of sync.\n    \u003e\n    \u003e - Only match transceivers that are not yet associated by m= section\n    \u003e   index.\n    \u003e - Route transport changes to a transceiver based on the MID of its\n    \u003e   channel.\n    \u003e\n    \u003e Bug: chromium:567160162\n    \u003e Change-Id: Ic9f29b66a8f9f181fd414009f5c1e5cebfa9ca54\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506421\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48768}\n\n    (cherry picked from commit 7a25e1c85a0af15cae8a2d55bf02e5610bf1af53)\n\n    Bug: chromium:567160162\n    Fixed: chromium:569046146\n    Change-Id: Ic9f29b66a8f9f181fd414009f5c1e5cebfa9ca54\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507101\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8078@{#2}\n    Cr-Branched-From: 3225248425fe2b3cafe389465b94ebc24968d9ba-refs/heads/main@{#48737}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/rtp_transceiver.cc", "third_party/libwebrtc/pc/rtp_transceiver.h", "third_party/libwebrtc/pc/sdp_offer_answer.cc", "third_party/libwebrtc/pc/sdp_offer_answer_unittest.cc", "third_party/libwebrtc/pc/transceiver_list.cc", "third_party/libwebrtc/pc/transceiver_list.h"], "git_node": "a6082889669aaa88b8138f25922f66219b3a9cb2", "git_parents": ["6d07caf0c6f3f11233723d7e171eb30a7b3330a3"], "node": "37ef8ed73cb84e5e179ac1391144e721ed5f8ed2", "parents": ["fba23683880c8dfa08db3ccc5d5bbce221838000"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 3987dfb7b9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3987dfb7b952b5c86cb7d93370d48416a81d6397\n    [M156] Reland \"Reject corrupted frames in the VP8 video decoder.\"\n\n    This is a reland of commit ba511622a24945fdd2b5b26b5a9275f0c6daff5e. The\n    original CL was reverted due to a downstream test which has now been\n    updated.\n\n    Original change's description:\n    \u003e Reject corrupted frames in the VP8 video decoder.\n    \u003e\n    \u003e The libvpx VP8 decoder has always returned error on malformed keyframes\n    \u003e but it turns out that corrupted delta frames may actually decode with\n    \u003e error, upon which the decoder still returns `VPX_CODEC_OK`. It is then\n    \u003e up to the user to poll the `VP8D_GET_FRAME_CORRUPTED` flag to see if it\n    \u003e was indeed OK.\n    \u003e\n    \u003e This CL adds a unit test the demonstrated this condition and shows that\n    \u003e we now reject the corrupted frame instead of continuing with error.\n    \u003e\n    \u003e Bug: chromium:561396583\n    \u003e Change-Id: I1e5c65225fc389be8b37d4c7da9a2cbf9a0c6ec2\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505800\n    \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48727}\n\n    (cherry picked from commit 32e8bb9eed5d58488cecbfb79a01b62f4d9d015f)\n\n    Bug: chromium:561396583\n    Change-Id: I823057c845b262a4efbcdb022d44b95f6bf8b147\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506140\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Original-Commit-Position: refs/heads/main@{#48743}\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506640\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8078@{#3}\n    Cr-Branched-From: 3225248425fe2b3cafe389465b94ebc24968d9ba-refs/heads/main@{#48737}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/codecs/vp8/libvpx_vp8_decoder.cc", "third_party/libwebrtc/modules/video_coding/codecs/vp8/test/vp8_impl_unittest.cc", "third_party/libw