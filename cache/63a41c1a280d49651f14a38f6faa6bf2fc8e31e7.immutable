.mozilla.com/D333762\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "82c8caad80fc1df014b094c4bc96ee66215bc19e", "git_parents": ["a9bcde63493bc64b6839f0281db22fe148423bef"], "node": "6b2beb9cafa367dba9104e53dd53c7b4427faf5a", "parents": ["bb82035bd557d977ab2a95af443d3fb6592c1d22"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079204 - Type Session Restore's browser windows as BrowserWindow. r=sessionstore-reviewers,sclements\n\nThe macOS hidden window and getWindowsFragment's window stay typed as Window, since neither is necessarily a browser window. Passing \"about:blank\" to addWebTab is behavior-neutral: addTab replaces a missing URI with it before reading it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333763\n", "files": ["browser/components/sessionstore/RecentlyClosedTabsAndWindowsMenuUtils.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/content/aboutSessionRestore.js", "browser/components/sessionstore/tsconfig.json"], "git_node": "4f02934f1a9ec0c2fa506b440e81062c65f0bbb1", "git_parents": ["82c8caad80fc1df014b094c4bc96ee66215bc19e"], "node": "10502eb8b2eb3f659c2a17333b99f7a38f54aa9f", "parents": ["6b2beb9cafa367dba9104e53dd53c7b4427faf5a"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070361 - Additional test fixes for search-config-v3. r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334247\n", "files": ["browser/base/content/test/browser-about/browser_aboutNetError_searchCTA_telemetry.js", "browser/components/search/test/unit/test_search_telemetry_config_validation.js", "toolkit/components/search/SearchEngineSelector.sys.mjs"], "git_node": "c5fc8001ab0b99fdf2537c4277b3150db2fcdccb", "git_parents": ["4f02934f1a9ec0c2fa506b440e81062c65f0bbb1"], "node": "1100069be4f61b948035a13d4848ea3eff1fb35d", "parents": ["10502eb8b2eb3f659c2a17333b99f7a38f54aa9f"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082762 - Cache component bounds to avoid exponential work traversing COLRv1 paint graph. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334765\n", "files": ["gfx/thebes/COLRFonts.cpp"], "git_node": "7f91ca274da616e9cfa0fcdc4ac2ced318cd8dbd", "git_parents": ["c5fc8001ab0b99fdf2537c4277b3150db2fcdccb"], "node": "44cae50e9fb66125cc9b371440f20843c992bd19", "parents": ["1100069be4f61b948035a13d4848ea3eff1fb35d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081994 - Report all weakmap entries via TraceWeakMaps API r=mccr8,spidermonkey-reviewers,iain\n\nCurrently this skips entries where the value is not a GC thing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334546\n", "files": ["js/public/friend/CycleCollector.h", "js/src/builtin/WeakSetObject.cpp", "js/src/builtin/WeakSetObject.h", "js/src/gc/WeakMap-inl.h", "js/src/jsapi-tests/testWeakMap.cpp", "xpcom/base/CycleCollectedJSRuntime.cpp"], "git_node": "be3b513d61bb5f6084eb520aa51b1533994f23fd", "git_parents": ["7f91ca274da616e9cfa0fcdc4ac2ced318cd8dbd"], "node": "2baf464615c18ad3eaf908234808e8ec9268885b", "parents": ["44cae50e9fb66125cc9b371440f20843c992bd19"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079466 - Tell the cycle collector about Symbols reachable through PropMaps r=mccr8,spidermonkey-reviewers,iain\n\nThe TODO comment correctly pointed out that this was missing although it\nunderestimated its importance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334593\n", "files": ["js/src/gc/Tracer.cpp", "xpcom/tests/crashtests/bug-2079466.html", "xpcom/tests/crashtests/crashtests.list"], "git_node": "0fc7ddce411f456fa9e3c0fedc5e63c2efccb9f1", "git_parents": ["be3b513d61bb5f6084eb520aa51b1533994f23fd"], "node": "fd7221446c61858d949e7dd48abe07f403fe5e6f", "parents": ["2baf464615c18ad3eaf908234808e8ec9268885b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082892 - Change NativeObject::maybeDensifySparseElements return type to bool. r=spidermonkey-reviewers,jonco\n\nBug 2068395 restructured the code so that we no longer need to distinguish `Incomplete`\nvs `Success`.\n\nThe assertion in the caller is no longer needed. It was there before bug 2068395\nbecause we called `desc.value()` after it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334530\n", "files": ["js/src/vm/NativeObject.cpp", "js/src/vm/NativeObject.h"], "git_node": "3602bafa14de0b2aec3124852af34b23f23f5337", "git_parents": ["0fc7ddce411f456fa9e3c0fedc5e63c2efccb9f1"], "node": "bbfe27e12aed8c51d38fbbe3d457ce53e176f8ef", "parents": ["fd7221446c61858d949e7dd48abe07f403fe5e6f"], "tags": []}, {"author": "Jaron Kramer \u003cinfo@jkramertech.com\u003e", "branch": "default", "desc": "Bug 2074906 - Use disabled toolbar button tokens in forced colors. r=desktop-theme-reviewers,dao,places-reviewers,reusable-components-reviewers,mstriemer,mak\n\nDefine forced-colors opacity, disabled icon fill, and disabled outline tokens for toolbar buttons. Apply disabled colors to primary toolbar buttons, tab-strip and menu scroll buttons, the Library toolbar, and overflow and subview buttons. Keep ordinary toolbar buttons draggable during customization, with the overflow and menu button exceptions. Preserve the enabled outline and hover icon fill for the temporarily disabled reload button.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330167\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css", "browser/themes/windows/places/organizer.css", "toolkit/themes/shared/arrowscrollbox.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.tokens.json"], "git_node": "5637f739eb9d943b02b30bb7d08c85bcdcb5c5bf", "git_parents": ["3602bafa14de0b2aec3124852af34b23f23f5337"], "node": "b0d6d2bc5c8ad6dfe169d29e4e4c5b32df5cbdb4", "parents": ["bbfe27e12aed8c51d38fbbe3d457ce53e176f8ef"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2081713 - Use moz-src for dom/media/webvtt r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333616\n", "files": ["dom/media/webvtt/WebVTTParserWrapper.sys.mjs", "dom/media/webvtt/components.conf", "dom/media/webvtt/moz.build", "dom/media/webvtt/test/mochitest/test_webvtt_process_cues_exception.html", "dom/media/webvtt/test/xpcshell/test_parser.js", "toolkit/actors/PictureInPictureChild.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "bf2e60bd041b5ec3e07db5ec853f0175a7f51ea9", "git_parents": ["5637f739eb9d943b02b30bb7d08c85bcdcb5c5bf"], "node": "d004ac95db4d7d49f5123b437c42244c51ff13d3", "parents": ["b0d6d2bc5c8ad6dfe169d29e4e4c5b32df5cbdb4"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2081711 - Use moz-src for dom/media/webspeech/recognition r=settings-reviewers,media-webspeech-reviewers,akulyk,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333606\n", "files": ["browser/components/preferences/OnDeviceModelManager.mjs", "dom/media/webspeech/recognition/moz.build", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "768c2fd060b3c3986bf7d3c8acec1b114a622b62", "git_parents": ["bf2e60bd041b5ec3e07db5ec853f0175a7f51ea9"], "node": "e506de5e3c7e2dae2ce0cf3926bcfd3e682b0569", "parents": ["d004ac95db4d7d49f5123b437c42244c51ff13d3"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074209 - Attach color-font palette cache to the individual gfxFontEntry for color fonts. r=gfx-reviewers,layout-reviewers,emilio,lsalzman\n\nThis is instead of having a shared cache attached to the presContext, and means the\nlifetime of the cache is directly tied to the font entry that owns it.\n\nCache lookups and modifications are guarded by the gfxFontEntry's RWLock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334249\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "gfx/src/nsFontMetrics.cpp", "gfx/thebes/FontPaletteCache.cpp", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/generic/TextOverflow.cpp", "layout/generic/nsTextFrame.cpp", "layout/mathml/nsMathMLChar.cpp"], "git_node": "9ec475eae525ef894e4e3556f0e999587b8cfb9f", "git_parents": ["768c2fd060b3c3986bf7d3c8acec1b114a622b62"], "node": "2d9a58e847f4e999384877792392a76ec6700d3c", "parents": ["e506de5e3c7e2dae2ce0cf3926bcfd3e682b0569"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083015 - Create the Java MediaCodec decoder before resolving AndroidDecoderModule::AsyncCreateDecoder. r=media-playback-reviewers,alwu\n\nRemoteDataDecoder now owns its task queue, so the Java codec can be created and\nconfigured during decoder creation. If that fails, PDMFactory can fall back to\nanother decoder module, as it does for the FFmpeg MediaCodec decoder.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334627\n", "files": ["dom/media/platforms/android/AndroidDecoderModule.cpp", "dom/media/platforms/android/AndroidDecoderModule.h", "dom/media/platforms/android/RemoteDataDecoder.cpp", "dom/media/platforms/android/RemoteDataDecoder.h", "testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini"], "git_node": "1439ec7644bd428a43c00eeea0d939067ea91492", "git_parents": ["9ec475eae525ef894e4e3556f0e999587b8cfb9f"], "node": "bd263aa44ca05a76e0ce5d5c6aa60ce01badab34", "parents": ["2d9a58e847f4e999384877792392a76ec6700d3c"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074209 - Attach color-font palette cache to the individual gfxFontEntry for color fonts. r=gfx-reviewers,layout-reviewers,emilio,lsalzman\" for causing failures at 1873708-emoji-canvas-filter.html.\n\nThis reverts commit 9ec475eae525ef894e4e3556f0e999587b8cfb9f.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "gfx/src/nsFontMetrics.cpp", "gfx/thebes/FontPaletteCache.cpp", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/generic/TextOverflow.cpp", "layout/generic/nsTextFrame.cpp", "layout/mathml/nsMathMLChar.cpp"], "git_node": "b20c3b7b95707b9d55335a0219905bc76938d380", "git_parents": ["1439ec7644bd428a43c00eeea0d939067ea91492"], "node": "76a023ad0cbcec7f241b8f8ddada49f7bd766148", "parents": ["bd263aa44ca05a76e0ce5d5c6aa60ce01badab34"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080914 - Vendor latest OTS code from upstream. r=gfx-reviewers,tnikkel\n\nMerged result of running\n  ./mach vendor gfx/ots/moz.yaml --patch-mode none\n  ./mach vendor gfx/ots/moz.yaml --patch-mode only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334828\n", "files": ["gfx/ots/moz.yaml", "gfx/ots/src/ots.cc"], "git_node": "c35bf235712876a991b66402187103737e7b8fb9", "git_parents": ["b20c3b7b95707b9d55335a0219905bc76938d380"], "node": "6dc9635fd4ca52622b6d3b10081e27bd851abacf", "parents": ["76a023ad0cbcec7f241b8f8ddada49f7bd766148"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083274 - Update android nightly application-services version bump to cb05b484d15d9339de7ee2546d48feab36e3a3ed r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334805\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "9e382c3456f8d24bed17834c24ed579899b85d7e", "git_parents": ["c35bf235712876a991b66402187103737e7b8fb9"], "node": "ae2f9d382b20df0eb636c79967707de56a9186a9", "parents": ["6dc9635fd4ca52622b6d3b10081e27bd851abacf"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2083226 - [Linux][Vulkan Video] Keep VIDEO_DECODE_DPB off the exported image when the DPB is distinct. r=stransky,media-playback-reviewers\n\nDirect export was forcing VIDEO_DECODE_DPB onto every decode image. Drivers that report DPB_AND_OUTPUT_DISTINCT keep references on a second image; that extra usage made the compositor sample a DPB surface. Keep the bit only when get_hw_frames_parameters already set it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334789\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "3b670edde712855bc86a574f5c1881888dc139e9", "git_parents": ["9e382c3456f8d24bed17834c24ed579899b85d7e"], "node": "0e9b59db9d3ad32a6fdd9f307374098113558f8a", "parents": ["ae2f9d382b20df0eb636c79967707de56a9186a9"], "tags": []}, {"author": "def00111 \u003ckernp@gmx.de\u003e", "branch": "default", "desc": "Bug 2075956 - Add SchemeIsHttpOrHttps helper for principals. r=valentin,emilio,necko-reviewers,places-reviewers,dom-worker-reviewers,timhuang,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329491\n", "files": ["docshell/base/BrowsingContextGroup.cpp", "dom/base/Document.h", "dom/cache/TypeUtils.cpp", "dom/fetch/FetchDriver.cpp", "dom/ipc/ProcessIsolation.cpp", "dom/ipc/WindowGlobalChild.cpp", "dom/script/ScriptLoader.cpp", "extensions/permissions/PermissionManager.cpp", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/ipc/DocumentLoadListener.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/places/nsFaviconService.cpp"], "git_node": "4523d65b575546e2b588dfb8b91e3d94ebeec19a", "git_parents": ["3b670edde712855bc86a574f5c1881888dc139e9"], "node": "b3e4f012334cf974819be5ed7a6be5c7ae4d2bed", "parents": ["0e9b59db9d3ad32a6fdd9f307374098113558f8a"], "tags": []}], "date": 1792271016, "git_changesets": ["16793c29e62cf8d73cab7225901540eb1f859680", "b18f224866c5611b343d15558749d966f55458d3", "1fb5606f16d9977294b432464085ac788e83623f", "a9bcde63493bc64b6839f0281db22fe148423bef", "82c8caad80fc1df014b094c4bc96ee66215bc19e", "4f02934f1a9ec0c2fa506b440e81062c65f0bbb1", "c5fc8001ab0b99fdf2537c4277b3150db2fcdccb", "7f91ca274da616e9cfa0fcdc4ac2ced318cd8dbd", "be3b513d61bb5f6084eb520aa51b1533994f23fd", "0fc7ddce411f456fa9e3c0fedc5e63c2efccb9f1", "3602bafa14de0b2aec3124852af34b23f23f5337", "5637f739eb9d943b02b30bb7d08c85bcdcb5c5bf", "bf2e60bd041b5ec3e07db5ec853f0175a7f51ea9", "768c2fd060b3c3986bf7d3c8acec1b114a622b62", "9ec475eae525ef894e4e3556f0e999587b8cfb9f", "1439ec7644bd428a43c00eeea0d939067ea91492", "b20c3b7b95707b9d55335a0219905bc76938d380", "c35bf235712876a991b66402187103737e7b8fb9", "9e382c3456f8d24bed17834c24ed579899b85d7e", "3b670edde712855bc86a574f5c1881888dc139e9", "4523d65b575546e2b588dfb8b91e3d94ebeec19a"], "user": "agoloman@mozilla.com"}, "45583": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081016 - Fix root scroll restoration when repeatedly reframing. r=layout-reviewers,TYLin\n\nSo the reason this doesn't happen on the first reframe is because we hit\nthe \"visual viewport is set\" case. It's unclear to me why we're clearing\nthe visual viewport when removing the root scrollframe, fwiw, but that\nhappened before, and I want this patch to be safe to uplift.\n\nWhat happen now is that by the time the root\nScrollContainerFrame::Destroy() runs, if the visual viewport is not set,\nwe fall through PresShell::GetLayoutViewportOffset(), which no longer\nfinds the root scrollframe. Before the regression, in\nContentWillBeRemoved we still hadn't cleared the root scrollframe.\n\nSince that is all just a very roundabout way of doing\nGetScrollPosition(), restore the behavior by just falling through when\nthe visual viewport offset is not set.\n\nI'll follow-up with why do we reframe here (ideally we shouldn't need\nto, at least on this reduced test-case...).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334850\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "testing/web-platform/tests/css/cssom-view/scroll-position-root-child-ib-split-insertion.html"], "git_node": "c7a285ba3d2755537be37ef2b273a3f7825e5c67", "git_parents": ["4523d65b575546e2b588dfb8b91e3d94ebeec19a"], "node": "d3966cab5a03c35069ca11033abe05ee67deb167", "parents": ["b3e4f012334cf974819be5ed7a6be5c7ae4d2bed"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082450 - Avoid leaving unreflowed continuations. r=TYLin\n\nMuch like bug 2045606. Normalizing the children is not enough\nunfortunately because of nested ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334854\n", "files": ["layout/generic/nsFlexContainerFrame.cpp", "layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/tests/css/css-position/crashtests/content-visibility-abspos-continuations-crash.html"], "git_node": "e70bde08449454a4a34805b7172e380233bbd881", "git_parents": ["c7a285ba3d2755537be37ef2b273a3f7825e5c67"], "node": "acbd7bbab45c8ec19129f5a6cdabf8506f321fc9", "parents": ["d3966cab5a03c35069ca11033abe05ee67deb167"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079035 - Pull all abspos children from later fragmentainers before destroying inline frame continuations. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334855\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp", "layout/generic/AbsoluteContainingBlock.h", "layout/generic/nsLineLayout.cpp", "testing/web-platform/tests/css/css-position/crashtests/inline-containing-block-delete-continuations-001.html"], "git_node": "586ae990b6b1ec6a61d710c431608dfa87762c67", "git_parents": ["e70bde08449454a4a34805b7172e380233bbd881"], "node": "f9ef6388802e6e08386faa5e3eeacb23c8b6e506", "parents": ["acbd7bbab45c8ec19129f5a6cdabf8506f321fc9"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071132 - Add ImagePixelFormat to hold the image format from layers::Image r=media-playback-reviewers,padenot\n\nThis patch introduces `ImagePixelFormat`, which would be the internal\nvocabulary for the image format converted from the layers::Image for\nmedia applications. This new format class provides more types the\nWebCodecs needs, such as I420P10, which is absent in `ImageBitmapFormat`.\n\nInstead of extending types in `ImageBitmapFormat`, introducing a new\nclass is preferred since `ImageBitmapFormat` was added by Bug\n1141979 for a canceled project (FoxEye), and most of its usages were\nremoved by Bug 1500733. Previously, it was used in WebCodecs and related\nmedia applications to hold the image format we need. However, its role\nduplicates with the `VideoPixelFormat` today, and also makes its caller\ntouch unnecessary `dom` layer they don't really need since it was\ndefined in webidl.\n\nTo solve this issue, this patch introduces a thin layer holding the\nimage formats we need in media space, provides a conversion method to\nWebCodecs' type, and removes all the unnecessary types that have no users\nat all.\n\nThe whole `ImageBitmapFormat` replacement will be done in bug 2071133.\nBug 2071132 focuses on removing all of its usages in WebCodecs space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325215\n", "files": ["dom/media/ImagePixelFormat.cpp", "dom/media/ImagePixelFormat.h", "dom/media/gtest/MockGPUVideoSurfaceManager.h", "dom/media/gtest/TestImagePixelFormat.cpp", "dom/media/gtest/TestRemoteImageHolder.cpp", "dom/media/gtest/TestYUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.h", "dom/media/gtest/moz.build", "dom/media/moz.build"], "git_node": "a9666788caf37a53811eb0ae8614116e10dc721d", "git_parents": ["586ae990b6b1ec6a61d710c431608dfa87762c67"], "node": "c95a70f7266876c4dbc249b8b27bb9ae8d64755d", "parents": ["f9ef6388802e6e08386faa5e3eeacb23c8b6e506"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071132 - Name WebCodecs VideoFrames from their ImagePixelFormat r=media-playback-reviewers,padenot\n\nEvery VideoFrame now derives its format from its layers::Image through\nGuessVideoPixelFormat, and ToVideoPixelFormat is the only mapping from\nthe internal names to the web enum.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325216\n", "files": ["dom/media/webcodecs/AudioDecoder.cpp", "dom/media/webcodecs/ImageTrack.cpp", "dom/media/webcodecs/VideoDecoder.cpp", "dom/media/webcodecs/VideoEncoder.cpp", "dom/media/webcodecs/VideoFrame.cpp", "dom/media/webcodecs/WebCodecsUtils.cpp", "dom/media/webcodecs/WebCodecsUtils.h", "dom/media/webcodecs/gtest/TestWebCodecsUtils.cpp", "dom/media/webcodecs/gtest/moz.build", "dom/media/webcodecs/test/generate_quadrants_fixtures.py", "dom/media/webcodecs/test/mochitest.toml", "dom/media/webcodecs/test/quadrants-vp9.webm", "dom/media/webcodecs/test/test_videoFrame_video_element.html", "dom/media/webcodecs/test/videoFrameFormatChecks.js"], "git_node": "82e458a378eebb4705aa51bce50dbaaba95fab5f", "git_parents": ["a9666788caf37a53811eb0ae8614116e10dc721d"], "node": "91406a62e2310ab2589698de557821c2adfded0a", "parents": ["c95a70f7266876c4dbc249b8b27bb9ae8d64755d"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083319 - Update PDF.js to f73a6986dd5bd6da329d9ae75e1794d8e667464c r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334833\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "10292ba900dba8eef895eb7e685162f556c38ed5", "git_parents": ["82e458a378eebb4705aa51bce50dbaaba95fab5f"], "node": "0418fd01e650c9048928666a36210e44fff6390c", 