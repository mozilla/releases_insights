ls/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/models/tests/browser/head.js", "toolkit/components/pageextractor/PageExtractorChild.sys.mjs", "toolkit/components/pageextractor/PageExtractorParent.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_headless_extractor.js"], "git_node": "a5f2d623753a55e7ccb77af039ce337ec5f39cd6", "git_parents": ["84fa096f86e232d85624cf9e1b553f638360bbf3"], "node": "10c1630e420b88fd249b0862068d1af6f0011880", "parents": ["ef7d0e4646d53a486c9f2ca30ebb02dd1ec3e198"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2065991 - Update mio to 1.2.4. r=supply-chain-reviewers,afranchuk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333090\n", "files": ["Cargo.lock", "supply-chain/imports.lock", "third_party/rust/mio/.cargo-checksum.json", "third_party/rust/mio/.cargo_vcs_info.json", "third_party/rust/mio/CHANGELOG.md", "third_party/rust/mio/Cargo.lock", "third_party/rust/mio/Cargo.toml", "third_party/rust/mio/Cargo.toml.orig", "third_party/rust/mio/README.md", "third_party/rust/mio/src/event/source.rs", "third_party/rust/mio/src/lib.rs", "third_party/rust/mio/src/macros.rs", "third_party/rust/mio/src/net/tcp/listener.rs", "third_party/rust/mio/src/net/udp.rs", "third_party/rust/mio/src/net/uds/datagram.rs", "third_party/rust/mio/src/net/uds/listener.rs", "third_party/rust/mio/src/net/uds/stream.rs", "third_party/rust/mio/src/poll.rs", "third_party/rust/mio/src/sys/shell/mod.rs", "third_party/rust/mio/src/sys/unix/mod.rs", "third_party/rust/mio/src/sys/unix/net.rs", "third_party/rust/mio/src/sys/unix/pipe.rs", "third_party/rust/mio/src/sys/unix/selector/epoll.rs", "third_party/rust/mio/src/sys/unix/selector/event_ports.rs", "third_party/rust/mio/src/sys/unix/selector/kqueue.rs", "third_party/rust/mio/src/sys/unix/selector/poll.rs", "third_party/rust/mio/src/sys/unix/selector/registered_io_source.rs", "third_party/rust/mio/src/sys/unix/tcp.rs", "third_party/rust/mio/src/sys/unix/uds/listener.rs", "third_party/rust/mio/src/sys/unix/uds/mod.rs", "third_party/rust/mio/src/sys/unix/waker/kqueue.rs", "third_party/rust/mio/src/sys/unix/waker/selector.rs", "third_party/rust/mio/src/sys/windows/mod.rs", "third_party/rust/mio/src/sys/windows/named_pipe.rs", "third_party/rust/mio/src/sys/windows/net.rs"], "git_node": "f5d9aec6bb6e0556ce5e1f2e959b6577a7325f49", "git_parents": ["a5f2d623753a55e7ccb77af039ce337ec5f39cd6"], "node": "adb2c6f22812ccfd2d2fe68059b0ca4add4fc357", "parents": ["10c1630e420b88fd249b0862068d1af6f0011880"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077535 - Fade out homepage content where it meets the toolbars with universal edge-to-edge wallpapers. r=android-reviewers,skhan\n\nWith transparent toolbars, the homepage content ends on a hard line where it is\nclipped at the toolbar edges. The content is faded with a mask instead of being\nallowed to scroll under the toolbars, so that touch targets, accessibility focus\nand the thumbnail bounds are unaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331230\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/compose/VerticalFadingEdges.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt"], "git_node": "6e7b39a2fa9c91ef1f31a42bca25c57dd556a03a", "git_parents": ["f5d9aec6bb6e0556ce5e1f2e959b6577a7325f49"], "node": "fbfce39d091f313d0e38eb09f28a5a3525726137", "parents": ["adb2c6f22812ccfd2d2fe68059b0ca4add4fc357"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Don't debug system principal tabs when devtools.chrome.enabled is locked to false. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328619\n", "files": ["devtools/client/framework/devtools-browser.js", "devtools/client/framework/devtools.js", "devtools/client/framework/local-tab-commands-factory.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_chrome_debugging_disabled.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/server/actors/webbrowser.js", "devtools/shared/commands/commands-factory.js", "devtools/shared/commands/target/tests/browser_target_command_various_descriptors.js"], "git_node": "ac4bb38259510da337ef9324424d855bbe7134b8", "git_parents": ["6e7b39a2fa9c91ef1f31a42bca25c57dd556a03a"], "node": "a5ecb009bb4367ec252e970b4ea97b4e0b5a791e", "parents": ["fbfce39d091f313d0e38eb09f28a5a3525726137"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Disable DevTools options checkboxes for locked prefs. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328620\n", "files": ["devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_options_locked_pref.js", "devtools/client/framework/toolbox-options.js"], "git_node": "52dd141623094ad9772ead2cf8ba56d378b617aa", "git_parents": ["ac4bb38259510da337ef9324424d855bbe7134b8"], "node": "83aec4b572c6b0d3bb146dbf82a0eaf0482626bb", "parents": ["a5ecb009bb4367ec252e970b4ea97b4e0b5a791e"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Hide the Inspect context menu item on system principal pages when devtools.chrome.enabled is locked to false. r=firefox-desktop-core-reviewers ,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328621\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-contextMenu/browser_contextmenu_inspect.js"], "git_node": "349c3f7f460b80fca87dff09eaa8edd0a49950a7", "git_parents": ["52dd141623094ad9772ead2cf8ba56d378b617aa"], "node": "5f44c35b76a46c586c20c266c82d173917aeab5a", "parents": ["83aec4b572c6b0d3bb146dbf82a0eaf0482626bb"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2081107 - Give JSVAL_TYPE_BOOLEAN and JSVAL_TYPE_MAGIC even type codes. r=iain,devtools-reviewers,profiler-reviewers,nchevobbe,mstange\n\nThe boolean (0x03) and magic (0x05) type codes are odd, so on PUNBOX64\ntheir shifted tags set bit 47 and span two halfwords. Every boolean or\nmagic Value constant then needs an extra movk on ARM64: false and the\nuninitialized-lexical magic take two instructions, and true and the\nelements-hole magic take three.\n\nMove them to the free even codes 0x08 and 0x0a. The GC-thing types move\nup to make room: PrivateGCThing 0x0b, BigInt 0x0d and Symbol 0x0f, while\nObject (0x0c) and String (0x0e) stay. Symbol's shifted tag is still an\nARM64 logical immediate. PrivateGCThing and Symbol are no longer\nadjacent, but their low two bits are both 0b11, which TraceKind never\nuses for a Value, so Value::traceKind still needs one branch. Boolean no\nlonger follows Int32, so ValueUpperExclShiftedNumberTag is the shifted\ntag after Int32 rather than Boolean's.\n\nThe execution tracer's value summary format exposes the type codes, and\n0x0f is now a valid type, so GETTER_SETTER_MAGIC moves to the unused\ncode 0x01 and VERSION goes to 5; the in-tree readers follow.\n\nWith the new codes, false and the uninitialized-lexical magic are a\nsingle movz, true (0xfffc000000000001) is a logical immediate, and a\nmagic with a payload needs one movk instead of two. On a JetStream 3 run\nwith an instrumented shell, boolean and magic constant materializations\ndrop from 57,202 to 33,410 instructions in Ion and from 231,158 to\n117,312 in Baseline, about 137,600 instructions (550 KB) per run.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333131\n", "files": ["devtools/client/shared/components/reps/reps/value-summary-reader.mjs", "js/public/Debug.h", "js/public/Value.h", "js/src/jit-test/tests/debug/ExecutionTracer-traced-values.js", "tools/profiler/tests/browser/browser_test_feature_jstracing_values.js"], "git_node": "d893cd8345676ceb863425ae35232b3fa3730c85", "git_parents": ["349c3f7f460b80fca87dff09eaa8edd0a49950a7"], "node": "e81557f473d9d36fce9915658e77ebd66c8274a4", "parents": ["5f44c35b76a46c586c20c266c82d173917aeab5a"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079312 - Update sctp to c625e21950600460cb5c6075616eb1622df2b06a r=webrtc-reviewers,jesup,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331633\n", "files": ["netwerk/sctp/src/moz.yaml", "netwerk/sctp/src/netinet/sctp.h", "netwerk/sctp/src/netinet/sctp_asconf.c", "netwerk/sctp/src/netinet/sctp_bsd_addr.c", "netwerk/sctp/src/netinet/sctp_cc_functions.c", "netwerk/sctp/src/netinet/sctp_indata.c", "netwerk/sctp/src/netinet/sctp_input.c", "netwerk/sctp/src/netinet/sctp_os_userspace.h", "netwerk/sctp/src/netinet/sctp_output.c", "netwerk/sctp/src/netinet/sctp_pcb.c", "netwerk/sctp/src/netinet/sctp_pcb.h", "netwerk/sctp/src/netinet/sctp_sysctl.c", "netwerk/sctp/src/netinet/sctp_timer.c", "netwerk/sctp/src/netinet/sctp_usrreq.c", "netwerk/sctp/src/netinet/sctputil.c", "netwerk/sctp/src/netinet6/sctp6_usrreq.c", "netwerk/sctp/src/user_mbuf.c", "netwerk/sctp/src/user_recv_thread.c", "netwerk/sctp/src/user_socket.c", "netwerk/sctp/src/usrsctp.h"], "git_node": "c9d8591e56ad08a01c37e0790436b5ee2769eb0b", "git_parents": ["d893cd8345676ceb863425ae35232b3fa3730c85"], "node": "3c48b118bcd29de79fadbd68d99b27afe1a7c16b", "parents": ["e81557f473d9d36fce9915658e77ebd66c8274a4"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079312 - Apply mozilla patches for sctp r=webrtc-reviewers,jesup,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331634\n", "files": ["netwerk/sctp/src/netinet/sctp_indata.c", "netwerk/sctp/src/netinet/sctp_input.c", "netwerk/sctp/src/usrsctp.h"], "git_node": "e97a0f9fe333a5466352ebb44597708cb91fe955", "git_parents": ["c9d8591e56ad08a01c37e0790436b5ee2769eb0b"], "node": "f1d20c8b58dfb4ded47180315e20a39f0ff992dd", "parents": ["3c48b118bcd29de79fadbd68d99b27afe1a7c16b"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076441 - Treat a deferred session with no windows or saved groups as nothing to restore. r=sessionstore-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330173\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_deferred_nothing_to_restore.py"], "git_node": "ff3589c8ab05cce511c4fa8482293202c53cb040", "git_parents": ["e97a0f9fe333a5466352ebb44597708cb91fe955"], "node": "f4ee789fe4f3d4a5d695c4acedc1860fe4d2d928", "parents": ["f1d20c8b58dfb4ded47180315e20a39f0ff992dd"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1594264 - Enable sql normalization r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321974\n", "files": ["storage/moz.build", "third_party/sqlite3/src/moz.build", "third_party/sqlite3/src/sqlite.symbols"], "git_node": "519fffae4d4b686861b24daec1af883f103857e0", "git_parents": ["ff3589c8ab05cce511c4fa8482293202c53cb040"], "node": "1014c2d1f3724ce6475d157f9cfa60f708fe1de0", "parents": ["f4ee789fe4f3d4a5d695c4acedc1860fe4d2d928"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977639 - Report slow SQL over Glean r=mak\n\nsqlite3_normalized_sql is only available for prepared statements, so\nthis specifically does not report on simple sql executions.\n\nThis does not remove the existing Legacy Telemetry reporting (yet).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321975\n", "files": ["storage/metrics.yaml", "storage/mozStorageConnection.cpp", "storage/mozStorageService.cpp", "storage/mozStorageService.h", "storage/pings.yaml", "toolkit/components/glean/metrics_index.py"], "git_node": "72f269fb0bd397adb23429aeec0fabaa57b9d0fd", "git_parents": ["519fffae4d4b686861b24daec1af883f103857e0"], "node": "e98bd138851443efc1b6fc523ec2c4456c43c66c", "parents": ["1014c2d1f3724ce6475d157f9cfa60f708fe1de0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1781388 - Check every touch pointermove in test_getCoalescedEvents_touch.html and stop listening at pointerup. r=dom-core-reviewers,smaug\n\nOn Windows the injected touchmoves can reach content as a single touchmove, leaving only the first\npointermove's check, which was recorded by the popup's SimpleTest rather than the opener's. A compat mouse\nmove then dispatched a pointermove after pointerup, so the coalesced event checks ran after finish().\n\nThe test passes on Windows and Android, so both of its skips are removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333322\n", "files": ["dom/events/test/pointerevents/mochitest.toml", "dom/events/test/pointerevents/test_getCoalescedEvents_touch.html"], "git_node": "722410768dffd2035242dae242c9786a7becf3b1", "git_parents": ["72f269fb0bd397adb23429aeec0fabaa57b9d0fd"], "node": "fd97c87d3ab0cc157fd04ed6738de4397b783fa2", "parents": ["e98bd138851443efc1b6fc523ec2c4456c43c66c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1985017 - Run the checks of test_pointerrawupdate_event_count_touch.html at pointerup instead of waiting for a second pointerrawupdate. r=dom-core-reviewers,smaug\n\nOn Windows the injected touchmoves can reach content as a single touchmove, so only one pointerrawupdate is\ndispatched and the pointerup handler waited forever for a second one. The coalesced pointermove is flushed\nbefore pointerup, so every event the test checks has been dispatched by then. The surplus-event messages no\nlonger increment the index a second time, which skipped every other event.\n\nThe test passes on Windows and Android, so both of its skips are removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333323\n", "files": ["dom/events/test/pointerevents/mochitest.toml", "dom/events/test/pointerevents/test_pointerrawupdate_event_count_touch.html"], "git_node": "abaa60b2c0794cd6ebe6462e48f8b6311573d5df", "git_parents": ["722410768dffd2035242dae242c9786a7becf3b1"], "node": "afc1bbb37e2b859420d470764add19fe099c8c8f", "parents": ["fd97c87d3ab0cc157fd04ed6738de4397b783fa2"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/focus-android/app/src/main/res/values-cs/strings.xml"], "git_node": "91f96260b67cf7ddf106d38a80d8f83afea7ffae", "git_parents": ["abaa60b2c0794cd6ebe6462e48f8b6311573d5df"], "node": "ef8f6c1c60be7e495fa5a35b357228bef77d2484", "parents": ["afc1bbb37e2b859420d470764add19fe099c8c8f"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081467 - give the name \"unnamed log\" to CT logs without descriptions for now r=jschanck\n\nThis is a temporary fix that we should improve upon in the near future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333426\n", "files": ["taskcluster/docker/periodic-updates/scripts/getCTKnownLogs.py"], "git_node": "50b6b97b99e83c6573434594e0a87919049cc7cb", "git_parents": ["91f96260b67cf7ddf106d38a80d8f83afea7ffae"], "node": "a935ead4a0a5ed0049e10e0115592b4c8ec3512a", "parents": ["ef8f6c1c60be7e495fa5a35b357228bef77d2484"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081347: Adjust test expectations line-clamp-auto-063.html which tends to crash on local debug builds. r=layout-reviewers,dshin DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333422\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-063.html.ini"], "git_node": "47bd1b20033e8976f6a8a4105a69481b9d27495a", "git_parents": ["50b6b97b99e83c6573434594e0a87919049cc7cb"], "node": "f7171fb8855cbdde1ed800261714eaf44cb65334", "parents": ["a935ead4a0a5ed0049e10e0115592b4c8ec3512a"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064461 - Add Quora as a new marketing partner in Adjust. r=android-reviewers,rebecatudor273,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319596\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/AdjustMetricsService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/InstallReferrerWorker.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/AdjustMetricsServiceTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingServiceTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerWorkerTest.kt"], "git_node": "4cd35e833f6b9336ad459393fc77c60789781c9b", "git_parents": ["47bd1b20033e8976f6a8a4105a69481b9d27495a"], "node": "3881151eace91c9a9e43bffaafabe700abf76f7e", "parents": ["f7171fb8855cbdde1ed800261714eaf44cb65334"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070892 - Avoid eager and potentially unnecessary allocations during parsing for HTMLInputElement r=smaug\n\nDefer SetDefaultValueAsValue until mDoneCreating is true, keeping the\nvalue backed by the content attribute during parsing. In\nDoneCreatingElement, take a fast path for plain text inputs that\nsanitizes and updates element state without allocating TextControlState.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329242\n", "files": ["dom/html/HTMLInputElement.cpp", "dom/html/TextControlState.cpp", "dom/html/TextControlState.h"], "git_node": "fa3bd6f27d275aa83788b56113394248d7319087", "git_parents": ["4cd35e833f6b9336ad459393fc77c60789781c9b"], "node": "541d402b488a7c5e9094b03518b1290696930d45", "parents": ["3881151eace91c9a9e43bffaafabe700abf76f7e"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079970 - add and use asynchronous version of findCertByDBKey r=jschanck,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333051\n", "files": ["browser/components/backup/tests/marionette/test_backup.py", "security/manager/pki/resources/content/certManager.js", "security/manager/ssl/nsIX509CertDB.idl", "security/manager/ssl/nsNSSCertificateDB.cpp", "security/manager/ssl/tests/unit/test_cert_dbKey.js", "security/manager/ssl/tests/unit/test_enterprise_roots.js"], "git_node": "fa7b1f9454fee04d88abd89b10ed34a664b25b24", "git_parents": ["fa3bd6f27d275aa83788b56113394248d7319087"], "node": "71969a27aea8135277d3cfa56c035a4b915a5c64", "parents": ["541d402b488a7c5e9094b03518b1290696930d45"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079970 - enable remote pkcs#11 modules by default in Firefox Nightly r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333052\n", "files": ["browser/app/profile/firefox.js", "modules/libpref/init/StaticPrefList.yaml", "security/certverifier/NSSCertDBTrustDomain.cpp", "security/manager/pki/resources/content/certManager.js", "security/manager/ssl/PKCS11ModuleDB.cpp", "security/manager/ssl/PKCS11ModuleDB.h", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/tests/mochitest/browser/head.js", "security/manager/ssl/tests/unit/test_certDB_import.js", "security/manager/ssl/tests/unit/test_pkcs11_module.js", "security/manager/ssl/tests/unit/xpcshell-smartcards-plain.toml", "security/manager/ssl/tests/unit/xpcshell-smartcards-remote.toml", "security/manager/ssl/tests/unit/xpcshell.toml"], "git_node": "a3e100ee761e626251ab1a5dbf53af2341ba2812", "git_parents": ["fa7b1f9454fee04d88abd89b10ed34a664b25b24"], "node": "b24e1f9812ac271a5c1b1f9b3d12ff452d512ef3", "parents": ["71969a27aea8135277d3cfa56c035a4b915a5c64"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081471: Use IsIdentifierStartASCII when we know the character is ASCII r=spidermonkey-reviewers,mgaudet\n\nFoofrix wrote this patch to avoid the `if (ch \u003c 128)` branch in IsIdentifierPart. It seems like LLVM should be able to do this itself, but this does make my local build 1% faster in multi-inspector-code-load (which does a lot of parsing). It's plausible that PGO covers this, but this patch can't hurt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333417\n", "files": ["js/src/frontend/TokenStream.cpp"], "git_node": "285da9c02776872b547a30977944027bbab31063", "git_parents": ["a3e100ee761e626251ab1a5dbf53af2341ba2812"], "node": "f7b8e664fece9a03c625b6a38a44a0ccb633a603", "parents": ["b24e1f9812ac271a5c1b1f9b3d12ff452d512ef3"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079546 - Allow Smart Window to read longer YouTube transcripts r=ai-platform-reviewers,ai-security-reviewers,vazish,gregtatum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331868\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "toolkit/components/pageextractor/PageExtractor.d.ts", "toolkit/components/pageextractor/PageExtractorChild.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_youtube_extraction.js"], "git_node": "4c0249e827439c32a3d0c1a632923f2d9f2d9fff", "git_parents": ["285da9c02776872b547a30977944027bbab31063"], "node": "f40ecac0716ec32db5652ad8eef56b72104a0421", "parents": ["f7b8e664fece9a03c625b6a38a44a0ccb633a603"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 1: Migrate selectPromptHeaderTextColor to colorTertiary r=android-reviewers,skhan\n\n- The normal theme was already aliased to fx_mobile_tertiary in Bug 2032670. This also moves the private theme off the legacy accent color.\n- Appears in the header of the saved login, strong password, saved card and saved address autofill prompts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332772\n", "files": ["mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "10ee3b497895deea50d93f245e056a92e66896f9", "git_parents": ["4c0249e827439c32a3d0c1a632923f2d9f2d9fff"], "node": "35c243fe67b83d977249da5c660188dc0d789fee", "parents": ["f40ecac0716ec32db5652ad8eef56b72104a0421"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 2: Remove the unused drawableTint from SelectPromptHeaderTextStyle r=android-reviewers,skhan\n\n- The prompts apply this style with setTextAppearance, which ignores drawableTint, and tint the header icon with the text color instead. This has been the case since the login prompt was added in https://github.com/mozilla-mobile/fenix/issues/5551.\n- Applies to the header icon of the saved login, strong password, saved card and saved address autofill prompts with no visual change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332773\n", "files": ["mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "529785204c1bacd3fdbff03217f65f9b96c44592", "git_parents": ["10ee3b497895deea50d93f245e056a92e66896f9"], "node": "d1b0e4773731c0a3971cc3b31cc1f079913ae5ac", "parents": ["35c243fe67b83d977249da5c660188dc0d789fee"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 3: Migrate accentUsedOnDarkBackground to colorPrimary r=android-reviewers,skhan\n\n- These are text buttons, so they now match the Compose TextButton, which uses colorPrimary for its text. This also moves the private theme off the legacy accent color.\n- Appears in the buttons of the open links in apps banner and the add to home screen dialogs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332774\n", "files": ["mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "3b1f9d4987f422f1149982651b03745ed5cef559", "git_parents": ["529785204c1bacd3fdbff03217f65f9b96c44592"], "node": "104f99ec62591b37e7f1d0b091d003615df5ad36", "parents": ["d1b0e4773731c0a3971cc3b31cc1f079913ae5ac"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 4: Remove the accentHighContrast control color overrides from DialogStyleBase r=android-reviewers,skhan\n\n- The dialogs now inherit the theme's colorControlNormal and colorControlActivated like the rest of the app. This removes the last readers of accentHighContrast and its legacy colors.\n- Appears in the text fields and checkboxes of the collection creation, rename collection and add to home screen dialogs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332775\n", "files": ["mobile/android/fenix/app/src/main/res/values-night/colors.xml", "mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "6246a6868095ba2da3947c1597370bb818f8363b", "git_parents": ["3b1f9d4987f422f1149982651b03745ed5cef559"], "node": "868c7552a494c17a395c454d6f6b9bb2ddd71b8e", "parents": ["104f99ec62591b37e7f1d0b091d003615df5ad36"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 5: Remove the accentBright highlight override from DialogStyleBase r=android-reviewers,skhan\n\n- The dialogs now inherit the theme's default colorControlHighlight like the rest of the app. This removes the last reader of accentBright.\n- Appears in the press ripple of the collection creation, rename collection and add to home screen dialogs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332776\n", "files": ["mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "d1cf2c90bcc28e3ca49dfd5f6fd76f268faf1093", "git_parents": ["6246a6868095ba2da3947c1597370bb818f8363b"], "node": "8fdf65c12e8e712fad56b45330f446cf5e1ca66e", "parents": ["868c7552a494c17a395c454d6f6b9bb2ddd71b8e"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 6: Migrate addOnPrivateBrowsingExteriorCircleBackground to colorIconPrivate r=android-reviewers,skhan\n\n- The badge now uses the same private icon color as the rest of the app (fx_mobile_icon_private). This also removes its legacy colors.\n- Appears in the private browsing badge of installed extensions that are enabled in private browsing in the Extensions screen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332777\n", "files": ["mobile/android/fenix/app/src/main/res/drawable/ic_add_on_private_browsing_label.xml", "mobile/android/fenix/app/src/main/res/values-night/colors.xml", "mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "1b0eec8be48af981e9420de4da1172c1cae75741", "git_parents": ["d1cf2c90bcc28e3ca49dfd5f6fd76f268faf1093"], "node": "34617d28e723a0b12a892856810ddfd376403532", "parents": ["8fdf65c12e8e712fad56b45330f446cf5e1ca66e"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 7: Migrate textOnColorPrimary to colorOnTertiary r=android-reviewers,skhan\n\n- The download dialogs' positive button text now matches FilledButton. Compose removed textOnColorPrimary in Bug 2053992.\n- Appears in the positive button text of the download prompt and the cancel private downloads dialog.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332948\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonPopupBaseFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/store/BrowserScreenMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "9a1ea1c46b092c473bea3b74c5f61a0c3312afd0", "git_parents": ["1b0eec8be48af981e9420de4da1172c1cae75741"], "node": "fc14cb0920457278fd86e524a8aa5d55ae9f2022", "parents": ["34617d28e723a0b12a892856810ddfd376403532"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 8: Use colorTertiary for the download dialogs' positive button background r=android-reviewers,skhan\n\n- The positive button now matches the FilledButton container color and pairs with the colorOnTertiary text from Part 7.\n- Appears in the positive button of the download prompt and the cancel private downloads dialog.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332954\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonPopupBaseFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/store/BrowserScreenMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt"], "git_node": "7a63bd232b940e846f2b8de60ffa4b7c5e1d0f8a", "git_parents": ["9a1ea1c46b092c473bea3b74c5f61a0c3312afd0"], "node": "c58f34a2849caf91e5447870ec62b0d4a5df3c47", "parents": ["fc14cb0920457278fd86e524a8aa5d55ae9f2022"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 9: Use colorPrimary and colorOnPrimary for the library item checkmark r=android-reviewers,skhan\n\n- The selected item badge now matches the RadioCheckmark used for multi-select in the tabs tray. This removes the last reader of iconOnColor.\n- Appears in the checkmark badge of selected items in the history, history group and recently closed tabs lists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332965\n", "files": ["mobile/android/fenix/app/src/main/res/layout/library_site_item.xml", "mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "0c88bd3f644a9ee78447c4a17f9f96e118e67d7d", "git_parents": ["7a63bd232b940e846f2b8de60ffa4b7c5e1d0f8a"], "node": "183a31870860ca2d7d34bf02dd700e640ed658b6", "parents": ["c58f34a2849caf91e5447870ec62b0d4a5df3c47"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 10: Use a white placeholder fill in favicon_background r=android-reviewers,skhan\n\n- Both consumers tint this shape with backgroundTint, so the hardcoded bookmark_favicon_background fill was never visible. This removes that color.\n- Appears in the library item checkmark badge and the share sheet tab favicon with no visual change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333116\n", "files": ["mobile/android/fenix/app/src/main/res/drawable/favicon_background.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml"], "git_node": "2293b726d07d40fcc0f5e684dd326c6753b073d8", "git_parents": ["0c88bd3f644a9ee78447c4a17f9f96e118e67d7d"], "node": "54ccb1723ee539b88ba7d49cabf2b8fb3ed8b433", "parents": ["183a31870860ca2d7d34bf02dd700e640ed658b6"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080538 - Part 11: Remove the unused colorAccent override from BaseDialogStyle r=android-reviewers,skhan\n\n- Material3 dialogs do not read colorAccent. See https://github.com/material-components/material-components-android/blob/master/docs/components/Dialog.md\n- This removes the last consumer of the legacy accent attr.\n- Applies to all Material alert dialogs with no visual change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333117\n", "files": ["mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "bc2376feacef4123f06e09e38f62575492dc1eb2", "git_parents": ["2293b726d07d40fcc0f5e684dd326c6753b073d8"], "node": "39826858ca5839fd6db5f26f1642fcea5eb9acfa", "parents": ["54ccb1723ee539b88ba7d49cabf2b8fb3ed8b433"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2063856 - Exit the MediaCache trim loop at the first rejected destination. r=media-playback-reviewers,azebrowski\n\nWith no free block in the main part of the cache, FindReusableBlock returns\nthe same destination for every overflow block, and rejecting it changes no\nstate, so each remaining overflow block would be rejected the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329957\n", "files": ["dom/media/MediaCache.cpp"], "git_node": "5cedc8e8a2e0f6f06b583bd7fc2b76c8a31f0b14", "git_parents": ["bc2376feacef4123f06e09e38f62575492dc1eb2"], "node": "da78218e306dad5322b8c17293f97c15e591563c", "parents": ["39826858ca5839fd6db5f26f1642fcea5eb9acfa"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072322 - Give monitor checks time to settle before reading pages r=ai-platform-reviewers,ai-security-reviewers,gregtatum,again\" for causing bc tests failures at browser_headless_extractor.js\n\nThis reverts commit a5f2d623753a55e7ccb77af039ce337ec5f39cd6.\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/models/tests/browser/head.js", "toolkit/components/pageextractor/PageExtractorChild.sys.mjs", "toolkit/components/pageextractor/PageExtractorParent.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_headless_extractor.js"], "git_node": "908b097d37e5c7408e39aede0d0b9888b5ff6b8b", "git_parents": ["5cedc8e8a2e0f6f06b583bd7fc2b76c8a31f0b14"], "node": "db1a6b4d48e21b74edfe3fc56fa04a6aa670b3e8", "parents": ["da78218e306dad5322b8c17293f97c15e591563c"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067311: Skip a stylesheet that immediately repeats its predecessor's contents. r=firefox-style-system-reviewers,emilio\n\nComponent frameworks routinely emit hundreds of byte-identical inline \u003cstyle\u003e\nelements, one per instance. Adobe Spectrum's SVG icons do this, and Speedometer\n3's TodoMVC-*-Complex-DOM workloads embed ~416 copies of one icon: 422 author\nstylesheets sharing just 7 distinct StylesheetContents, the duplicates in a\nsingle contiguous run. Every copy after the first contributes another set of the\nsame rules to the selector maps, and then a redundant match, sort entry and rule\nnode for every element they apply to.\n\nSkipping such a sheet takes declarations collected from 755,990 to 38,870 and\nmean rule path depth from 90.0 to 4.6, back in line with the \"we pretty much\nnever have more than 8 applicable declarations\" measurement that sized\nApplicableDeclarationList in bug 1364952. Traversal time for large restyles\ndrops ~48% at both 1 and 6 style threads; across the full 20-workload suite,\ntotal style traversal time drops ~29%, about 562ms per run.\n\nOn its own, Speedometer 3's total CPU time drops 7-15% in the median on all five\ndesktop platforms, and the score gains 0.2-0.8% on the four where that is\nMann-Whitney significant. Stacked on bug 2067318, which removes the same\nduplicates one layer later, only a further 1-3% of CPU time is left. Blink made\nthe equivalent change in 2024 (crrev.com/c/5385787, later moved earlier in\ncrrev.com/c/5889787) and also reported a score improvement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325718\n", "files": ["servo/components/style/stylist.rs", "testing/web-platform/tests/css/css-cascade/duplicate-stylesheets.html"], "git_node": "68560d4c2084ff7810dc60f4755ae0cc001e21f4", "git_parents": ["908b097d37e5c7408e39aede0d0b9888b5ff6b8b"], "node": "3e2fb9e71e82cf905d4c5abf1e894ced9762a4e6", "parents": ["db1a6b4d48e21b74edfe3fc56fa04a6aa670b3e8"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059011. r=gfx-reviewers,gw,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333126\n", "files": ["gfx/2d/DrawTargetCairo.cpp", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetSkia.cpp", "gfx/2d/DrawTargetSkia.h"], "git_node": "62e595ba156c7324fd691ed5c00002e803554af5", "git_parents": ["68560d4c2084ff7810dc60f4755ae0cc001e21f4"], "node": "cd9b20c5fcb16187377d7883cee88405e4e6943c", "parents": ["3e2fb9e71e82cf905d4c5abf1e894ced9762a4e6"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056564 - Add an import history promo card to the history sidebar panel r=desktop-theme-reviewers,fxview-reviewers,reusable-components-reviewers,sidebar-reviewers,hjones,jsudiaman,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332166\n", "files": ["browser/components/firefoxview/HistoryController.sys.mjs", "browser/components/firefoxview/history.mjs", "browser/components/firefoxview/tests/browser/browser_history_firefoxview.js", "browser/components/sidebar/sidebar-history.css", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_history_sidebar_import_promo.js", "browser/locales/en-US/browser/sidebar.ftl", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/sidebar/kit-history-import.svg"], "git_node": "a31d2dc85fce0f93fbc29567d78dc427c9eda564", "git_parents": ["62e595ba156c7324fd691ed5c00002e803554af5"], "node": "5a0ce1968413730f838e0713ce7aa802690584ac", "parents": ["cd9b20c5fcb16187377d7883cee88405e4e6943c"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2079301 r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332286\n", "files": ["gfx/layers/BufferTexture.cpp"], "git_node": "cfb7a35115f04fbad7696f8f78875226ad4cdf28", "git_parents": ["a31d2dc85fce0f93fbc29567d78dc427c9eda564"], "node": "e22f337301bf7780e966a5b151f81c5def0e0812", "parents": ["5a0ce1968413730f838e0713ce7aa802690584ac"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026828 - Fix handling of out-pointer parameter r=webgpu-reviewers,nical,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290297\n", "files": ["dom/webgpu/ipc/WebGPUParent.cpp", "gfx/wgpu_bindings/src/server.rs"], "git_node": "0b4656e8b0ba8090c69b7bdfcd0a2f8156cc8c92", "git_parents": ["cfb7a35115f04fbad7696f8f78875226ad4cdf28"], "node": "baddb50d93d1444286544be61e9d3f21ac212d97", "parents": ["e22f337301bf7780e966a5b151f81c5def0e0812"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026828 - Disallow `unsafe_op_in_unsafe_fn` in wgpu_bindings r=webgpu-reviewers,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331326\n", "files": ["gfx/wgpu_bindings/src/client.rs", "gfx/wgpu_bindings/src/command.rs", "gfx/wgpu_bindings/src/lib.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "cd04d24459f990928e0dce6f03ef90da5d68c771", "git_parents": ["0b4656e8b0ba8090c69b7bdfcd0a2f8156cc8c92"], "node": "806973a8c40bd8c57dc9b74d5641b45f0b88b0b7", "parents": ["baddb50d93d1444286544be61e9d3f21ac212d97"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067129 - Make the listen to page progress bar draggable r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333338\n", "files": ["mobile/android