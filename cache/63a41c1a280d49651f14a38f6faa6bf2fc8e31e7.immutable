curity/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlists.h"], "git_node": "e0bf1506b352809f2d1af47495fad31364582146", "git_parents": ["1fffc48b7888bdf75c9a001068d767b435fb864d"], "node": "17134d4a2d2c466a0a8f8ba4cd3a8bb74d8d2cf5", "parents": ["e11e12fc1ee9aacceb34f0940750e2569c229b03"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072261 - Part 2: Block WebRTC connections with Connection Allowlists. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335625\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "testing/web-platform/meta/connection-allowlist/tentative/webrtc-block-default.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webrtc-block-interactions.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webrtc-block.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webrtc-local-scheme-block.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webrtc-queuereport-report-only.https.sub.window.js.ini"], "git_node": "f0db5b0a357d31e2882e80b1ec97872bd6ab1e43", "git_parents": ["e0bf1506b352809f2d1af47495fad31364582146"], "node": "c753a57fdfd05ecf6755a7367c323c98eee69d38", "parents": ["17134d4a2d2c466a0a8f8ba4cd3a8bb74d8d2cf5"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084667: handle ios in build_schedules transform r=releng-reviewers,taskgraph-reviewers,jcristau\n\nAt the moment, iOS builds get lumped in with desktop firefox, which is incorrect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336000\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_build_schedules.py", "taskcluster/gecko_taskgraph/transforms/build_schedules.py"], "git_node": "d32fbc0a8763d9d4b5383ff5e38ec8054c0badaf", "git_parents": ["f0db5b0a357d31e2882e80b1ec97872bd6ab1e43"], "node": "137d2de40cf20f6bed215f5d79461ccfdfa56d82", "parents": ["c753a57fdfd05ecf6755a7367c323c98eee69d38"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069508 - Add telemetry for SmartBlock embed toggles in the Trust Panel r=mraiber,webcompat-reviewers,twisniewski\n\nAdd trustpanel.smartblock_toggled and restore the smartblock_embed_toggles_shown\nextra on trustpanel.opened, since the legacy\nsecurity.ui.protectionspopup.click_smartblockembeds_toggle probe is\nunreachable from the new Trust Panel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324046\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml", "browser/extensions/webcompat/tests/browser/browser_smartblockembeds_trustpanel.js"], "git_node": "752261cf853304caa452aa1c372c90eec3cfda21", "git_parents": ["d32fbc0a8763d9d4b5383ff5e38ec8054c0badaf"], "node": "86a4f097a864c7b37a82498bf8a359639744cc8d", "parents": ["137d2de40cf20f6bed215f5d79461ccfdfa56d82"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2084271 - Re-enumerate macOS speech synthesis voices when the system voice list changes. r=eeejay,media-playback-reviewers,padenot\n\nVoices installed or removed in System Settings only showed up after a\nrestart, because the voice list was read once at startup. On macOS 14\nand later, listen for AVSpeechSynthesisAvailableVoicesDidChangeNotification\nand bring the voice registry in sync with the new list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335688\n", "files": ["dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.h", "dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.mm"], "git_node": "fce00ff624d5530ff7a4f3489bb6154a85613880", "git_parents": ["752261cf853304caa452aa1c372c90eec3cfda21"], "node": "4edfab085273155ea81eb62de5150822230686aa", "parents": ["86a4f097a864c7b37a82498bf8a359639744cc8d"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2030810 - add previousSessionEnd and impressions to ASRouter targeting environment and expose previousSessionEnd and profileLastUse to nimbus r=omc-reviewers,nimbus-reviewers,aminomancer,beth\" for causing node tests failures.\n\nThis reverts commit cb32c168930bb473ed5e2ad4b71ab89f9cf07f78.\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/asrouter/tests/unit/ASRouterTargeting.test.js", "browser/components/asrouter/tests/unit/TargetingDocs.test.js", "toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml"], "git_node": "c157b5d4b5ade2d655d174d925cd573bf6aa39d5", "git_parents": ["fce00ff624d5530ff7a4f3489bb6154a85613880"], "node": "1dfd8c211dc0ef3ccc2e9d59d5d09e01ac7f51d5", "parents": ["4edfab085273155ea81eb62de5150822230686aa"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083219 - update content strings to match finalized strings r=gcardieri,fluent-reviewers,bolsson\" for causing mochitests failures in browser_aitab_blocks.js.\n\nThis reverts commit 1fffc48b7888bdf75c9a001068d767b435fb864d.\n", "files": ["browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.mjs", "browser/locales-preview/aiWindow.ftl"], "git_node": "45e7a1b5fb051e623bc744be93830ef6c9638e62", "git_parents": ["c157b5d4b5ade2d655d174d925cd573bf6aa39d5"], "node": "a7e8e9decca62e39009aa1db5bf27b4fd5205e53", "parents": ["1dfd8c211dc0ef3ccc2e9d59d5d09e01ac7f51d5"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072573 - Decrease the opacity of post-Nova secondary/deemphasized text in the urlbar. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335759\n", "files": ["layout/generic/nsTextPaintStyle.cpp"], "git_node": "5cfe11ff1bdec764a11072234f0a2782db23b0bf", "git_parents": ["45e7a1b5fb051e623bc744be93830ef6c9638e62"], "node": "b34c5c703aea8578610aadad25959ffb035d6816", "parents": ["a7e8e9decca62e39009aa1db5bf27b4fd5205e53"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2060687 - Iterate through the tab group theme colors based on the last used for the Collections migration r=jdelorenzo\n\n- Each migrated tab group is given the theme that follows the most recently modified tab group's theme.\n- Extract `TabGroupTheme.nextOrDefault()` so the migration and `newTabGroupForm` share the same next theme rule.\n- Fall back to the default theme if the tab groups cannot be read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335187\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/403\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/collections/migration/CollectionsToTabGroupsMigration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/data/TabGroupTheme.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/state/TabGroupFormState.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/collections/migration/CollectionsToTabGroupsMigrationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/collections/migration/CollectionsToTabGroupsMigrationWorkerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/data/TabGroupThemeTest.kt"], "git_node": "fbacb14cfc5acdab53def65c6ba70eee1d06bfc0", "git_parents": ["5cfe11ff1bdec764a11072234f0a2782db23b0bf"], "node": "519df7bcd382a891b4fa4d4ccda1fae6ffc2de6b", "parents": ["b34c5c703aea8578610aadad25959ffb035d6816"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2080989 - Write BHR permahang details to disk on the hang processing thread, not under the BHR lock. r=canova\n\nThis makes it so that slow file operations don't keep the mutex locked for too long;\nthe main thread locks the same mutex and we don't want to slow down the main thread.\n\nDo the write in ProcessHangStackRunnable instead, just before submitting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335415\n", "files": ["toolkit/components/backgroundhangmonitor/BackgroundHangMonitor.cpp", "toolkit/components/backgroundhangmonitor/HangDetails.cpp", "toolkit/components/backgroundhangmonitor/HangDetails.h"], "git_node": "1c24cbf14f483bbee40432cf0c48163a28905e9f", "git_parents": ["fbacb14cfc5acdab53def65c6ba70eee1d06bfc0"], "node": "2c7928af6a52eaec129a1017dd52a9270ccd99cc", "parents": ["519df7bcd382a891b4fa4d4ccda1fae6ffc2de6b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081550. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335964\n", "files": ["image/SVGDocumentWrapper.cpp"], "git_node": "03642f06d8b130543bdf51fc728cad624dd5162f", "git_parents": ["1c24cbf14f483bbee40432cf0c48163a28905e9f"], "node": "148bb8e1b2c0bd478cd445e3ec0340ab32257412", "parents": ["2c7928af6a52eaec129a1017dd52a9270ccd99cc"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073242 - Measure time to first rendered chat character r=jlewis\n\nThis commit records a new telemetry event for the latency\nfrom response request start to the moment when SmartWindow first\nrenders text to the user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329082\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/actors/AIChatContentChild.sys.mjs", "browser/components/aiwindow/ui/actors/AIChatContentParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_character_telemetry.js"], "git_node": "a607be51c60742ea14a6e5c1b9f265af58603bd3", "git_parents": ["03642f06d8b130543bdf51fc728cad624dd5162f"], "node": "ccbe46e312700c6c1c0df88407aad4ccb2a9f957", "parents": ["148bb8e1b2c0bd478cd445e3ec0340ab32257412"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073242 - Cover first-character telemetry across search handoff r=jlewis\n\nThis commit adds a test case that documents a failure to report the\ntime-to-first-character telemetry metric when the full-page chat\nmoves into the sidebar due to web search and continues the response.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329273\n", "files": ["browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search_telemetry.js"], "git_node": "6e2b0803fcbc420ad20a4c69db16401d9559a408", "git_parents": ["a607be51c60742ea14a6e5c1b9f265af58603bd3"], "node": "433f3fa993832ca7d30753a7fcf7c99d6b45f161", "parents": ["ccbe46e312700c6c1c0df88407aad4ccb2a9f957"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2036862 - Make sure to use a fresh connection for each captive portal check r=necko-reviewers,sunil\n\nIf the interception is only achieved via DNS, and the captive portal does not forward traffic when\nunlocked, we might think the captive portal is still locked because we're reusing the connection\nwe obtained before logging in.\n\nThis patch adds LOAD_FRESH_CONNECTION + LOAD_INITIAL_DOCUMENT_URI to the CP detector\nso that we always use a new connection and refresh DNS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327801\n", "files": ["toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/test/unit/test_fresh_connection.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml"], "git_node": "4bb14f4b9933fa06b4b141592069df9d715d1d46", "git_parents": ["6e2b0803fcbc420ad20a4c69db16401d9559a408"], "node": "ab743b3aad159ae87b74d97446d20ee97bdf78da", "parents": ["433f3fa993832ca7d30753a7fcf7c99d6b45f161"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084321 - Disable webgl.out-of-process.enable-ahardwarebuffer on Android. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336023\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "d3d300efd3f83842bf853530b124c161ae11c4a7", "git_parents": ["4bb14f4b9933fa06b4b141592069df9d715d1d46"], "node": "073af63d5e060d6f9913ac738c3c4c8d485a2b17", "parents": ["ab743b3aad159ae87b74d97446d20ee97bdf78da"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e c2a79e0baa743ed529ae40d4c3fd9eb1d561e0de\naf -\u003e c2a79e0baa743ed529ae40d4c3fd9eb1d561e0de\nan -\u003e c2a79e0baa743ed529ae40d4c3fd9eb1d561e0de\nar -\u003e c2a79e0baa743ed529ae40d4c3fd9eb1d561e0de\nast -\u003e c2a79e0baa743e