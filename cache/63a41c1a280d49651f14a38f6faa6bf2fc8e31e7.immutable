plication-services/examples/relay-cli/src/main.rs", "third_party/application-services/examples/relevancy-cli/Cargo.toml", "third_party/application-services/examples/relevancy-cli/src/main.rs", "third_party/application-services/examples/remote-settings-cli/Cargo.toml", "third_party/application-services/examples/remote-settings-cli/src/main.rs", "third_party/application-services/examples/suggest-cli/Cargo.toml", "third_party/application-services/examples/suggest-cli/src/main.rs", "third_party/application-services/examples/sync-pass/Cargo.toml", "third_party/application-services/examples/sync-pass/src/sync-pass.rs", "third_party/application-services/examples/tabs-sync/Cargo.toml", "third_party/application-services/examples/tabs-sync/src/tabs-sync.rs", "third_party/application-services/examples/viaduct-cli/Cargo.toml", "third_party/application-services/examples/viaduct-cli/src/main.rs", "third_party/application-services/megazords/ios-rust/Cargo.toml", "third_party/application-services/megazords/ios-rust/focus/Cargo.toml", "third_party/application-services/megazords/ios-rust/src/lib.rs", "third_party/application-services/moz.yaml", "third_party/application-services/testing/sync-test/Cargo.toml", "third_party/application-services/testing/sync-test/src/main.rs", "third_party/application-services/tools/dependency_summary.py", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/db-crypto/android/src/main/java/mozilla/appservices/db_crypto/db_crypto.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "edf96b1ed8ac5db119850b26c5d978d5112bc52c", "git_parents": ["f5a6549e5ce0f463ff767bf56cc231ce07c11b44"], "node": "c12d48e17397d80465caf5838c415e8083cae906", "parents": ["0a7acd225694d023991b492bc8214a6d0f046099"], "tags": []}, {"author": "Vanessa Prema \u003cvprema@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080327 - fix(pbw): basic spotlight colors udpated r=aminomancer,omc-reviewers\n\n- small change to fix the text color and background color of spotlight\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332576\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "c41271ab490125ae15f130aa96e9ca09ad422cdc", "git_parents": ["edf96b1ed8ac5db119850b26c5d978d5112bc52c"], "node": "1933177435d0d6858c31cd5e151e938c7184a6f7", "parents": ["c12d48e17397d80465caf5838c415e8083cae906"], "tags": []}, {"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077641 - Stop disabling launch on login when the legacy profile manager is shown at startup. r=firefox-desktop-core-reviewers ,chumphreys,mconley,iholmes,mossop\n\nChoosing a profile at startup is no reason to keep Firefox from starting at login. The selectable profiles selector already appears at login without turning launch on login off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330548\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/metrics.yaml", "browser/components/preferences/main.js", "browser/components/preferences/tests/browser_windows_launch_on_login.js", "browser/components/shell/StartupOSIntegration.sys.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl", "toolkit/components/telemetry/Events.yaml"], "git_node": "a80573bdcc8e26be1d81e167f693bad600f28a9c", "git_parents": ["c41271ab490125ae15f130aa96e9ca09ad422cdc"], "node": "29587801638de24f2816d14d3a26203bebf2f6fd", "parents": ["1933177435d0d6858c31cd5e151e938c7184a6f7"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2077770 - Remove relocated child from mARIAOwnsHash before removal. r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332947\n", "files": ["accessible/generic/DocAccessible.cpp"], "git_node": "89305e6de9a108c05623151c9a056fdfb5b10021", "git_parents": ["a80573bdcc8e26be1d81e167f693bad600f28a9c"], "node": "ec7e6f96dc2698fa0a58d171e6aee5382a3c9542", "parents": ["29587801638de24f2816d14d3a26203bebf2f6fd"], "tags": []}, {"author": "daviddurfee \u003cdavid@anonymco.com\u003e", "branch": "default", "desc": "Bug 2079015 - Postprocessing sponsored scores with trend fitting. r=mconley,bbirdsong\n\nDepends on D331832\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332528\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js"], "git_node": "d546748ce2868013e32b33608f0456ffea8005a1", "git_parents": ["89305e6de9a108c05623151c9a056fdfb5b10021"], "node": "4f29bcfb3696b4457e455654664c1d2e5d02c0d5", "parents": ["ec7e6f96dc2698fa0a58d171e6aee5382a3c9542"], "tags": []}, {"author": "Brendan Birdsong \u003cbbirdsong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080368 - Make SponsoredTopSitesScoreProvider a singleton initialized by TopSitesFeed. r=ddurfee,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332628\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js"], "git_node": "9aadea19fd4613f328bd2d1783de3216d4660c35", "git_parents": ["d546748ce2868013e32b33608f0456ffea8005a1"], "node": "3968840d4025b703fd706765a9aca58ca9f2c3ae", "parents": ["4f29bcfb3696b4457e455654664c1d2e5d02c0d5"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075990: Make typed loads non-movable r=jandem\n\nTyped loads are used in self-hosted code to access reserved slots. In cases where the contents of a reserved slot depend on control flow, we want to ensure that the load isn't hoisted above the code that guards it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332615\n", "files": ["js/src/jit-test/tests/regexp/bug2075990.js", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "25fbb1fe95e1b1742a1484a51a155f454c7edc96", "git_parents": ["9aadea19fd4613f328bd2d1783de3216d4660c35"], "node": "4c3d5873f1db2245a8dabfd4c8b30c5abd8af76a", "parents": ["3968840d4025b703fd706765a9aca58ca9f2c3ae"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080657 - Declare androidx.lifecycle in AC modules that compile against lifecycle 2.8 and 2.9 r=android-reviewers,mcarare\n\nCompose UI and AppCompat put lifecycle 2.8.7 on these modules' compile classpaths, and ui-animation's runtime\nclasspath resolves 2.9.4. Lint loads the lifecycle-runtime lint checks from there, and those releases\nreference KtLightModifierList.getKotlinOrigin(), which lint 32.5 removed (ObsoleteLintCustomCheck). Declaring\na lifecycle artifact aligns the whole group to the catalog version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332767\n", "files": ["mobile/android/android-components/components/browser/state/build.gradle", "mobile/android/android-components/components/compose/browser-toolbar/build.gradle", "mobile/android/android-components/components/compose/engine/build.gradle", "mobile/android/android-components/components/compose/menu/build.gradle", "mobile/android/android-components/components/compose/tabstray/build.gradle", "mobile/android/android-components/components/feature/ipprotection/build.gradle", "mobile/android/android-components/components/service/firefox-relay/build.gradle", "mobile/android/android-components/components/support/images/build.gradle", "mobile/android/android-components/components/ui/animation/build.gradle", "mobile/android/android-components/components/ui/richtext/build.gradle"], "git_node": "df4e3da416344aa3b4475512e7878dc1a1741ba5", "git_parents": ["25fbb1fe95e1b1742a1484a51a155f454c7edc96"], "node": "c7c9804677244a9aef6946bd5ff80aa207849b7c", "parents": ["4c3d5873f1db2245a8dabfd4c8b30c5abd8af76a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080318 - Fail the test when an end-of-test @AssertCalled count does not match. r=geckoview-reviewers,owlish\n\ntestExtensionProcessCrash never gets the onDisabledProcessSpawning call it counts in the junit runtime, so it\nis disabled until bug 2080467.\n\nA waitUntilCalled given a delegate interface and method names now treats a call to any overload as satisfying\nits name, instead of waiting for every overload, so adding an overload to a delegate no longer makes those\nwaits time out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332716\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoSessionTestRuleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebExtensionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java"], "git_node": "f9c3ca7882941183f309eb9e43c4c317a5df5f06", "git_parents": ["df4e3da416344aa3b4475512e7878dc1a1741ba5"], "node": "9a8349aafa35cf15361459747b8df638cff81b78", "parents": ["c7c9804677244a9aef6946bd5ff80aa207849b7c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080318 - Fix the GeckoView junit tests whose end-of-test @AssertCalled counts did not match. r=geckoview-reviewers,owlish\n\nThese tests passed only because the end-of-test counts were never checked. Several ended before the callback\ncould be delivered, enableDisable declared counts its flow does not produce, and translateTest's count only\nholds outside automation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332717\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateChildTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ExperimentDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TranslationsTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebExtensionTest.kt"], "git_node": "01c3edc54593fed220c2d3241199e065cf2942ed", "git_parents": ["f9c3ca7882941183f309eb9e43c4c317a5df5f06"], "node": "95bc0cee2a60f3639e771c1c6224f69517eed9fc", "parents": ["9a8349aafa35cf15361459747b8df638cff81b78"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080318 - Wait for recorded delegate calls in GeckoView junit tests instead of completing a GeckoResult in the delegate. r=geckoview-reviewers,owlish\n\nThe rule already records every proxied delegate call, so waitUntilCalled on the registered interface replaces\na GeckoResult that only signalled the call, and the registration's @AssertCalled count still checks it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332718\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/MediaSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/OpenWindowTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PromptDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SelectionActionDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TranslationsTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebExtensionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebNotificationTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebPushTest.kt"], "git_node": "2479fbdef22b1969b061f0022a4ed52041391180", "git_parents": ["01c3edc54593fed220c2d3241199e065cf2942ed"], "node": "fc1572b1f68aeba4808ac40af6f7e25875051e24", "parents": ["95bc0cee2a60f3639e771c1c6224f69517eed9fc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080318 - Register ExtensionActionTest's action delegates with the test rule and wait for their calls. r=geckoview-reviewers,owlish\n\nThe action delegates were set directly on the extension or session, so the rule never recorded their calls and\nthe tests completed a GeckoResult instead. Registering them through addExternalDelegateDuringNextWait records\nthe calls, so the tests wait with waitUntilCalled. A wait on several method names waits for every one of them,\nso the tests that handle either action wait only on the one their id selects.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332724\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ExtensionActionTest.kt"], "git_node": "3e6de9d1c454c890ddba048e87862ed93daeed8e", "git_parents": ["2479fbdef22b1969b061f0022a4ed52041391180"], "node": "147705b0d242bea86489b38dbecfede228f779a8", "parents": ["fc1572b1f68aeba4808ac40af6f7e25875051e24"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080318 - Wait for the delegate calls in AutocompleteTest instead of completing a GeckoResult after a fixed delay. r=geckoview-reviewers,owlish\n\nIn the fetch tests the delay kept the count = 1 scope open after the fetch, the only way they could see a\nsecond one. Nothing marks the end of Gecko's fetching, so they now check that the fetch happened, with the\ndelegate registered until test end so an extra fetch recorded before then still fails the count.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332725\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AutocompleteTest.kt"], "git_node": "91733db835c9b320fe48ce5e58a98950b07b117d", "git_parents": ["3e6de9d1c454c890ddba048e87862ed93daeed8e"], "node": "ab6f5126163e909d8f981258264ddd6deb7c9a87", "parents": ["147705b0d242bea86489b38dbecfede228f779a8"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2080185 - Pick image raster sizes at the scroll-invariant position WebRender snaps at r=gfx-reviewers,nical\n\nWebRender moves display items out of the pre-scrolled coordinates Gecko\nauthors them in by the accumulated external scroll offset, and snaps them\nthere, re-applying the scroll offset rounded to whole device pixels. The\nraster size was picked by rounding the pre-scrolled rect, so for a rect with\na fractional device extent it depended on the sub-pixel phase of the scroll\noffset while the rect it is drawn into did not. Since bug 2070683 draws a\ntexture that is a pixel off 1:1 instead of stretching it, every repaint\nduring a scroll could alternate between the two sizes and visibly change\nthe image's shape.\n\nRead the offset back from the WebRender display list builder, so it is the\nsame accumulation it normalizes with, and round there instead. This also\nstops scrolling from requesting a new raster size for such images.\n\nimage-scrolled-fractional-raster-1 encoded the old behaviour, a raster a row\ntaller than the snapped rect drawn 1:1 and clipped; the raster now matches\nthe snapped rect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332766\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender_api/src/display_list.rs", "layout/base/nsLayoutUtils.cpp", "layout/base/nsLayoutUtils.h", "layout/generic/nsImageFrame.cpp", "layout/painting/nsCSSRenderingBorders.cpp", "layout/painting/nsImageRenderer.cpp", "layout/reftests/image/reftest.list", "layout/svg/SVGImageFrame.cpp"], "git_node": "74591af1535cf40403b48cfd126cbc66f8a15d67", "git_parents": ["91733db835c9b320fe48ce5e58a98950b07b117d"], "node": "c69c7211d15d42ebe73c13ab5bc6ee50b70cd8fd", "parents": ["ab6f5126163e909d8f981258264ddd6deb7c9a87"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071271 - Show sign out card in the app menu when status is NOT_VERIFIED. r=nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328549\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js"], "git_node": "3dfb499768421cce807360c64dc7e4220304d76f", "git_parents": ["74591af1535cf40403b48cfd126cbc66f8a15d67"], "node": "093298c6520d1bee3a16a4d35056fd1240868ae1", "parents": ["c69c7211d15d42ebe73c13ab5bc6ee50b70cd8fd"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077661 - Don't trust fontconfig to prioritize face index within a collection. r=gfx-reviewers,lsalzman\n\nWhen the fontconfig validation here was implemented (in bug 2045378),\nI assumed that if we gave FC a pattern with pathname and face index,\nit would treat these as primary attributes for FcFontMatch, and return\nthat exact face if available.\n\nHowever, it turns out that's not true; if the font resource is a\ncollection, FcFontMatch may prefer a different face than the one\nwhose index we specified. And that will result in using the wrong\nface and potentially getting garbled rendering.\n\nTo fix this, let's keep the originally-requested index, as all we\nreally want to check here is the validity of the pathname as a\nfontconfig-known resource. If we get back the same path, we can\nsafely use it. We only need to consider the index from FcFontMatch\nif it has returned us a different path altogether.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333283\n", "files": ["gfx/2d/ScaledFontFontconfig.cpp"], "git_node": "53aca1462bf3b9965d1eae9a2bf3b74767e6c6da", "git_parents": ["3dfb499768421cce807360c64dc7e4220304d76f"], "node": "d90445265e27e9594a3fee807861fc30db2fc9c3", "parents": ["093298c6520d1bee3a16a4d35056fd1240868ae1"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2081234 - Clear the image cache in test_resource_timing.html. r=dom-core-reviewers,jjaschke\n\nWhen the test runs more than once in the same browser, its images are served\nfrom the image cache and don't get resource timing entries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333240\n", "files": ["dom/tests/mochitest/general/test_resource_timing.html"], "git_node": "734c07f3b4a2d1fcb379c7f927448b04129798b7", "git_parents": ["53aca1462bf3b9965d1eae9a2bf3b74767e6c6da"], "node": "cd49bc1c51fecbcfce3aa4a13b1d1149f8d2f080", "parents": ["d90445265e27e9594a3fee807861fc30db2fc9c3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Fail browser-chrome tests that leave permissions changed, r=emz.\n\nAfter each test, compare the permissions with the state before the test, report each difference as a failure, and restore the previous state with removeAll() so the following tests are not affected. Permissions Gecko adds by itself (user interaction, high value site detection, storage access grants, HTTPS-First exceptions) are removed silently. On Thunderbird, whose tests haven't been fixed, the differences are reported as known failures. Also flush the permissions pushed with SpecialPowers.pushPermissions, like SimpleTest.finish() does for plain mochitests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331142\n", "files": ["testing/mochitest/browser-test.js"], "git_node": "b7d9367b0989e91f03e009f1e954e9adf4f2f4db", "git_parents": ["734c07f3b4a2d1fcb379c7f927448b04129798b7"], "node": "fafafbac18ac8016cc1e792f0d3ccb93255eb134", "parents": ["cd49bc1c51fecbcfce3aa4a13b1d1149f8d2f080"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077641 - Stop disabling launch on login when the legacy profile manager is shown at startup. r=firefox-desktop-core-reviewers ,chumphreys,mconley,iholmes,mossop\" for causing browser chrome tests failures at browser_startup.js\n\nThis reverts commit a80573bdcc8e26be1d81e167f693bad600f28a9c.\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/metrics.yaml", "browser/components/preferences/main.js", "browser/components/preferences/tests/browser_windows_launch_on_login.js", "browser/components/shell/StartupOSIntegration.sys.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl", "toolkit/components/telemetry/Events.yaml"], "git_node": "e8b5532dde4bcea8beccd91d29845b2dd74ff6ee", "git_parents": ["b7d9367b0989e91f03e009f1e954e9adf4f2f4db"], "node": "9dab42632a06fb5022459fe59221c4a273b72af7", "parents": ["fafafbac18ac8016cc1e792f0d3ccb93255eb134"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080203 - [devtools] Add gradient underline for CSS explainers target/anchor.r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332417\n", "files": ["devtools/client/themes/rules.css"], "git_node": "62697f6511220c77e96b3b1c8d7453dc474c3177", "git_parents": ["e8b5532dde4bcea8beccd91d29845b2dd74ff6ee"], "node": "e070b50e46932751fc3a09ff1b66c2b736d3726c", "parents": ["9dab42632a06fb5022459fe59221c4a273b72af7"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078946 - redo short-write handling r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331663\n", "files": ["security/manager/ssl/NSSSocketControl.cpp", "security/manager/ssl/NSSSocketControl.h", "security/manager/ssl/nsNSSIOLayer.cpp"], "git_node": "58f4688447b58e69ef29414b709f6d6850de4caa", "git_parents": ["62697f6511220c77e96b3b1c8d7453dc474c3177"], "node": "1ff49f7d88107145ac4329f5845ad4bae1573297", "parents": ["e070b50e46932751fc3a09ff1b66c2b736d3726c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080220: Fix test for beta r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332489\n", "files": ["js/src/jit-test/tests/proxy/bug2077725.js"], "git_node": "0706d2c2249a3536f458e35617031b36ee8fb70e", "git_parents": ["58f4688447b58e69ef29414b709f6d6850de4caa"], "node": "ec46757d6d990b43ea5fb2cee2a54c42079fe4f7", "parents": ["1ff49f7d88107145ac4329f5845ad4bae1573297"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056564 - Add an import history promo card to the history sidebar panel r=desktop-theme-reviewers,fxview-reviewers,reusable-components-reviewers,sidebar-reviewers,hjones,jsudiaman,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332166\n", "files": ["browser/components/firefoxview/HistoryController.sys.mjs", "browser/components/firefoxview/history.mjs", "browser/components/firefoxview/tests/browser/browser_history_firefoxview.js", "browser/components/sidebar/sidebar-history.css", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_history_sidebar_import_promo.js", "browser/locales/en-US/browser/sidebar.ftl", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/sidebar/kit-history-import.svg"], "git_node": "401d273130fa98a43efb0bbb66d477e1762e28f8", "git_parents": ["0706d2c2249a3536f458e35617031b36ee8fb70e"], "node": "5b1bc17bf1178d5f77b492a5f03b3bb11550dafc", "parents": ["ec46757d6d990b43ea5fb2cee2a54c42079fe4f7"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078749: Check stack limit before looping for bound functions in generic call trampoline r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332603\n", "files": ["js/src/jit-test/tests/ion/bug2078749.js", "js/src/jit/CodeGenerator.cpp"], "git_node": "e1be8aac1f0ea47d9945ede8f75c7782880f9181", "git_parents": ["401d273130fa98a43efb0bbb66d477e1762e28f8"], "node": "fb618aaa82ba2292faa29923bf35ccf8b38e2e53", "parents": ["5b1bc17bf1178d5f77b492a5f03b3bb11550dafc"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1863994 - Keep is-url attribute on clipboard result title r=adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333076\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_clipboard.js"], "git_node": "c6510bca503b7619f8b64f4481270c27edb44f00", "git_parents": ["e1be8aac1f0ea47d9945ede8f75c7782880f9181"], "node": "cf02379c024754b527dd700497bef52c5e43fdee", "parents": ["fb618aaa82ba2292faa29923bf35ccf8b38e2e53"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2064788 - Even out the panel-list padding and make its corners concentric with its items in Nova. r=desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322517\n", "files": ["toolkit/content/widgets/panel-list/panel-list.css", "toolkit/content/widgets/panel-list/panel-list.tokens.css", "toolkit/content/widgets/panel-list/panel-list.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "c922fc0a34915028c9a34bc72fc4d23f8f1a3877", "git_parents": ["c6510bca503b7619f8b64f4481270c27edb44f00"], "node": "64b6eb1e3b079c2b4fa430852b8198c94885e284", "parents": ["cf02379c024754b527dd700497bef52c5e43fdee"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2079579 - Stop reporting CPU use on profiler shutdown r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332063\n", "files": ["toolkit/components/glean/ipc/FOGIPC.cpp"], "git_node": "f240c5f048c32b48e300bddb2baf28265a6b66bb", "git_parents": ["c922fc0a34915028c9a34bc72fc4d23f8f1a3877"], "node": "7225e81dd2f74ddb639e29107f4604a575c03c9d", "parents": ["64b6eb1e3b079c2b4fa430852b8198c94885e284"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021191 - update tabgroup telemetry. r=sthompson,sessionstore-reviewers,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328940\n", "files": ["browser/base/content/main-popupset.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/tabbrowser/TabMetrics.sys.mjs", "browser/components/tabbrowser/content/tab-groups-list.mjs", "browser/components/tabbrowser/metrics.yaml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_interaction_telemetry.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "82e05032fee17a2984163dba3ff3d3adb7ca5974", "git_parents": ["f240c5f048c32b48e300bddb2baf28265a6b66bb"], "node": "4a95e40c12273dc3f2377b9bf22bbc97ba232f29", "parents": ["7225e81dd2f74ddb639e29107f4604a575c03c9d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081413 - Remove LocalStorage shadow writes and their tests, r=dom-storage-reviewers,janv.\n\nShadow writes have been disabled since bug 1769733. This removes the write path and the databaseShadowing tests, which also handed a database to each other through the test directory and had to run sequentially. Creating and opening the shadow database, and deleting webappsstore.sqlite when all data is cleared, stay for profiles with older data until bug 1582066.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333303\n", "files": ["dom/localstorage/ActorsParent.cpp", "dom/localstorage/moz.build", "dom/localstorage/test/unit/databaseShadowing-shared.js", "dom/localstorage/test/unit/test_databaseShadowing1.js", "dom/localstorage/test/unit/test_databaseShadowing2.js", "dom/localstorage/test/unit/test_databaseShadowing_clearOrigin1.js", "dom/localstorage/test/unit/test_databaseShadowing_clearOrigin2.js", "dom/localstorage/test/unit/test_databaseShadowing_clearOriginsByPattern1.js", "dom/localstorage/test/unit/test_databaseShadowing_clearOriginsByPattern2.js", "dom/localstorage/test/unit/test_databaseShadowing_clearOriginsByPrefix1.js", "dom/localstorage/test/unit/test_databaseShadowing_clearOriginsByPrefix2.js", "dom/localstorage/test/unit/test_flushing.js", "dom/localstorage/test/unit/xpcshell.toml", "modules/libpref/init/all.js"], "git_node": "06a5cead41f9005a5a209a710fa6a153e3528bb4", "git_parents": ["82e05032fee17a2984163dba3ff3d3adb7ca5974"], "node": "06f413a5121e963a0fe235391411a23f73ff5986", "parents": ["4a95e40c12273dc3f2377b9bf22bbc97ba232f29"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1842899 - Move the restore session infobar to the messaging system. r=omc-reviewers,sessionstore-reviewers,fluent-reviewers,desktop-theme-reviewers,firefox-desktop-core-reviewers ,nsharpley,hjones,bolsson,mak,mimi\n\nThe previous code incremented the browser.startup.couldRestoreSession.count\npref when it was 0 and returned, so the infobar does not appear on the\nstartup that advanced it. Leaving the increment in BrowserGlue\n(onWindowsRestored) would break that, since it runs before the messaging\nsystem evaluates targeting, so a profile at 0 would reach 1 and could match in\nthe same startup. The increment from 0 to 1 now runs at shutdown instead, to\nmaintain the previous behavior as closely as possible, though the count may\nno longer advance if the browser crashes.\n\nSupporting changes:\n\n- Added inline_icons support to infobar, for the inline hamburger menu icon.\n- Added a SELECT_AND_MARK_MENU_ITEM special message action.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331209\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/BrowserGlue.sys.mjs", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/templates/InfoBar/InfoBar.schema.json", "browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js", "browser/components/sessionstore/SessionWindowUI.sys.mjs", "browser/components/sessionstore/test/unit/test_restore_session_suggestion_count.js", "browser/components/sessionstore/test/unit/xpcshell.toml", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/browser/newtab/asrouter.ftl", "browser/themes/shared/browser-shared.css", "python/l10n/fluent_migrations/bug_1842899_restore_session_startup_infobar.py", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_select_and_mark_menu_item.js"], "git_node": "34d9c55ac730e74fd6ffb80ff70808214194832b", "git_parents": ["06a5cead41f9005a5a209a710fa6a153e3528bb4"], "node": "85b5c2b9614243cbb8627b6cb8adc8dd0ba2e27b", "parents": ["06f413a5121e963a0fe235391411a23f73ff5986"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056564 - Add an import history promo card to the history sidebar panel r=desktop-theme-reviewers,fxview-reviewers,reusable-components-reviewers,sidebar-reviewers,hjones,jsudiaman,fluent-reviewers,bolsson\" for causing bc tests failures at history_sidebar_import_promo.js\n\nThis reverts commit 401d273130fa98a43efb0bbb66d477e1762e28f8.\n", "files": ["browser/components/firefoxview/HistoryController.sys.mjs", "browser/components/firefoxview/history.mjs", "browser/components/firefoxview/tests/browser/browser_history_firefoxview.js", "browser/components/sidebar/sidebar-history.css", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_history_sidebar_import_promo.js", "browser/locales/en-US/browser/sidebar.ftl", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/sidebar/kit-history-import.svg"], "git_node": "c7c716cb56e67b40d06927e652601b6deff41106", "git_parents": ["34d9c55ac730e74fd6ffb80ff70808214194832b"], "node": "d2ab070c953c29a638b3f2e6e3388fbb8e52331f", "parents": ["85b5c2b9614243cbb8627b6cb8adc8dd0ba2e27b"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2080985: Update the doc's scroll position when MozScrolledAreaChanged is fired r=accessibility-platform-reviewers,Jamie\n\nHistorically, we've queued an update for ScrollPosition in two cases:\n- When an accessible's overflow styling changes\n- When a scroll is performed\n\nWe also explicitly avoid pushing a scroll update when the scroll range\nfor a given acc is computed to be (0, 0) since we use the existence of\nthe scroll key in the parent process as an indicator of whether the\ngiven acc is a scroll container.\n\nThis causes us to occasionally misrepresent scrollable containers as\nnon-scrollable in the parent process.\n\nImagine a document is created with scrollable overflow styling,\nbut does not initially have enough content to generate a scroll bar\n(i.e. its scroll range is 0x0).\nThen, the content inside the doc expands and creates a\nnonzero scroll range.\nWe'd continue to assert in the parent process that this doc\nisn't scrollable because no style change has happened and no\nscroll has occurred.\n\nWith this patch, we now queue an additional update to scroll position\nwhen witnessing the MozScrolledAreaChanged event from layout.\nThis event is fired when the scroll range of the root scroll frame\nis altered due to the size of its internal content changing in reflow.\n\nThis caused intermittent failures in browser_test_scroll_bounds.js. A\nnew test case below exercises this functionality explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333042\n", "files": ["accessible/generic/RootAccessible.cpp", "accessible/tests/browser/scroll/browser_test_scroll_bounds.js"], "git_node": "52d2e58206c2b04e907155ed42c90b6f9fc5f9d3", "git_parents": ["c7c716cb56e67b40d06927e652601b6deff41106"], "node": "5bbe69f1270b4f146052ea6e6de5d96d412d075b", "parents": ["d2ab070c953c29a638b3f2e6e3388fbb8e52331f"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078883 - Re-check autocomplete attribute each time the dropdown is about to be offered. r=mtigley,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332138\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_autocomplete_unrecognized_attribute_dynamic.js", "toolkit/components/formautofill/FormAutofillChild.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "7d5e4e364a8f2460f3475c7565dae8339a6792de", "git_parents": ["52d2e58206c2b04e907155ed42c90b6f9fc5f9d3"], "node": "b99a4d280e40f947ece2bc4e5899777287cb21f5", "parents": ["5bbe69f1270b4f146052ea6e6de5d96d412d075b"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081445 - Correct uniffi-bindgen-gecko-js default maps r=bdk\n\nCurrently these generate empty objects (`{}`),\nbut should be empty maps (`new Map()`).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333397\n", "files": ["toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/src/pipeline/defaults.rs"], "git_node": "43d285bb41121635eb6ebf5cd62dd089322f46b6", "git_parents": ["7d5e4e364a8f2460f3475c7565dae8339a6792de"], "node": "c2d55617b881ed1198e57523c7ce8cb0d66d60bf", "parents": ["b99a4d280e40f947ece2bc4e5899777287cb21f5"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080356 - Fix perma failure in browser_privacy_ipprotection_siterules_srd.js - r=settings-reviewers,mconley\n\nAlthough the reported failure line in the bug lists a changed preference, it is very likely that the actual failure came from a timeout and an issue with the test opening a new tab 20+ times rather than opening it once for all tests that needed it. I addressed the changed preferences but also what I believe to be the root cause of the issue.\n\nTry push: https://treeherder.mozilla.org/jobs?repo=try&revision=568f3f5db11153334856f4fb20bc0003af27cb27\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332897\n", "files": ["browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js"], "git_node": "84fa096f86e232d85624cf9e1b553f638360bbf3", "git_parents": ["43d285bb41121635eb6ebf5cd62dd089322f46b6"], "node": "ef7d0e4646d53a486c9f2ca30ebb02dd1ec3e198", "parents": ["c2d55617b881ed1198e57523c7