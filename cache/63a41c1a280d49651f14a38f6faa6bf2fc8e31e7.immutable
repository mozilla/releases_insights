hor": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2077351 - Move Google Lens and QR code telemetry to `BrowserToolbarTelemetryMiddleware` r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330397\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserToolbarStoreBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomeToolbarStoreBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/BrowserToolbarTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/BrowserToolbarSearchMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/telemetry/AddressBarTelemetry.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarTelemetryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/BrowserToolbarTelemetryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/BrowserToolbarSearchMiddlewareTest.kt"], "git_node": "e3a64204448c0a0b59cb7e3ad280d6da11b9b8bd", "git_parents": ["8ae6c70489805d7105f9de70b604d68afb54e0a1"], "node": "66082a1063913f3502a1cfda8af9dd2b52b3b4f0", "parents": ["4f69f1511d88eb5d27d8a32490809b8f5a73cc1d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075782 - Allow GMP process to be launched as isolated process on Android. r=geckoview-reviewers,media-playback-reviewers,tcampbell,alwu\n\nWe only use the GMP process for clearkey on Android, which does not\nhave any special access requirements. It should be safe to enable\nisolated process for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329364\n", "files": ["dom/media/gmp/GMPProcessParent.cpp", "mobile/android/geckoview/src/main/AndroidManifest_overlay.jinja", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoChildProcessServices.jinja", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoProcessManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/ServiceAllocator.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/ServiceUtils.java", "modules/libpref/init/StaticPrefList.yaml", "taskcluster/test_configs/variants.yml"], "git_node": "4fde4ba264b3b51908da2a3e4c100e544fbbaad7", "git_parents": ["e3a64204448c0a0b59cb7e3ad280d6da11b9b8bd"], "node": "d1ac99dac28dfbce1495c02eddad8208ee049710", "parents": ["66082a1063913f3502a1cfda8af9dd2b52b3b4f0"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2079771 - Fix delete GL texture in RenderAndroidHardwareBufferTextureHost::DeleteTextureHandle() r=gfx-reviewers,aosmond\n\nThe assert failure happened when RenderAndroidHardwareBufferTextureHost::~RenderAndroidHardwareBufferTextureHost() was called from RenderThread::DeferredRenderTextureHostDestroy().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332047\n", "files": ["gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp"], "git_node": "2990cc6291c71eff5a11c69afb6615625f601b8b", "git_parents": ["4fde4ba264b3b51908da2a3e4c100e544fbbaad7"], "node": "a05e135f83da