z.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 1753dda108ccb85bae6ac47e8f7838f60f27faef with DEVEDITION_159_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ad9241b356d83e2dbc33aebf01c61766e001d38f", "git_parents": ["e19cfbd1682bb5a3886e8c6d8999e8f4515ca739"], "node": "de13ecaff98195270f0982404238293a42dcf87e", "parents": ["cb5a47b2ac470bb2828e91c8faa5ccac417c6c95"], "tags": []}], "date": 1791483106, "git_changesets": ["ad9241b356d83e2dbc33aebf01c61766e001d38f"], "user": "ffxbld@lando.moz.tools"}, "45524": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 1753dda108ccb85bae6ac47e8f7838f60f27faef with FIREFOX_159_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "031c489c41faffa6cf06d3195b299de066c7fa77", "git_parents": ["ad9241b356d83e2dbc33aebf01c61766e001d38f"], "node": "8517fde08bcb47cbff5267f8378a330a67cf670e", "parents": ["de13ecaff98195270f0982404238293a42dcf87e"], "tags": []}], "date": 1791483196, "git_changesets": ["031c489c41faffa6cf06d3195b299de066c7fa77"], "user": "ffxbld@lando.moz.tools"}, "45525": {"changesets": [{"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079671 - Make `signon.storage.rust.enabled` controllable through Nimbus. r=dimi\n\nAdd the `logins-rust-storage` feature, whose `enabled` variable sets the pref.\n\nThe pref is read when login storage initializes, which can happen before Nimbus applies its enrollments, so the value is set on the user branch. It then takes effect from the next startup and does not change between sessions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331959\n", "files": ["toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/passwordmgr/test/unit/test_LoginStorageMigrator_nimbus.js", "toolkit/components/passwordmgr/test/unit/xpcshell.toml"], "git_node": "e5da1d6427ae0901d3a0ad0fa730aa46253e06e6", "git_parents": ["15a387663c1da6c6bef3f65894f1ff974deecb95"], "node": "87c05f11b637e9431d9de2c9e1c031b5f8453a0f", "parents": ["0575fa0966876b9fa7437a7838a793cfa2588ed8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070647 - Only apply opaque surface when hovered/expanded. r=kcochrane,desktop-theme-reviewers\n\nFrom our latest theme triage discussion it seems people were on board\nwith this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324663\n", "files": ["browser/themes/shared/sidebar.css"], "git_node": "f5f9a69fd6e114dff03291a50634c911a034e13f", "git_parents": ["e5da1d6427ae0901d3a0ad0fa730aa46253e06e6"], "node": "f2310aa52a8a4f51a1bb98499e528270f3e81a72", "parents": ["87c05f11b637e9431d9de2c9e1c031b5f8453a0f"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2073733 part 1 - Move NativeNtBlockSet into its own file. r=yjuglaret,win-reviewers\n\nNo functional changes. This allows TestCrossProcessWin to include it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331602\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/NativeNtBlockSet.cpp", "browser/app/winlauncher/freestanding/NativeNtBlockSet.h", "browser/app/winlauncher/freestanding/moz.build"], "git_node": "eae79b812ea2b63d3c12cd1c30524a7f7738e185", "git_parents": ["f5f9a69fd6e114dff03291a50634c911a034e13f"], "node": "b5ad47af24a9475e54faa3aff8a4d394a6f5cd60", "parents": ["f2310aa52a8a4f51a1bb98499e528270f3e81a72"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2073733 part 2 - copy DLL names into dynamic blocklist from SharedSection view r=yjuglaret,win-reviewers\n\nCopy these in to ensure that their lifetime matches what we need.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330231\n", "files": ["browser/app/winlauncher/freestanding/NativeNtBlockSet.cpp", "browser/app/winlauncher/freestanding/NativeNtBlockSet.h", "browser/app/winlauncher/test/TestCrossProcessWin.cpp"], "git_node": "2edb81cdd20b0305250572a9ee2e4479c993d84a", "git_parents": ["eae79b812ea2b63d3c12cd1c30524a7f7738e185"], "node": "f5c604db20f9d0c9eb2cfb4de872383a867fdf1f", "parents": ["b5ad47af24a9475e54faa3aff8a4d394a6f5cd60"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068227 - Show the onboarding sync card to users arriving via a pairing link. r=android-reviewers,cbect\n\n{F83056636}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329758\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/MarketingPageAdditionSupport.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingPageAdditionSupport.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/MarketingPageAdditionSupportTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/OnboardingPageAdditionSupportTest.kt"], "git_node": "945fc174cef00daa5d9147524d74faef2f5a22f2", "git_parents": ["2edb81cdd20b0305250572a9ee2e4479c993d84a"], "node": "dc7ddd27d77f711cc47f90bcdb9edd6f7804aecb", "parents": ["f5c604db20f9d0c9eb2cfb4de872383a867fdf1f"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068227 - [refactor] Remove the double negative condition to improve the readability of the `pagesToDisplay` function. r=android-reviewers,cbect\n\nDifferential Revision: https://phabrica