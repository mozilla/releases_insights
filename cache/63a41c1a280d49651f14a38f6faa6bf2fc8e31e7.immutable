main/res/drawable/nova_onboarding_toolbar_bottom_active.xml", "mobile/android/fenix/app/src/main/res/drawable/nova_onboarding_toolbar_bottom_inactive.xml", "mobile/android/fenix/app/src/main/res/drawable/nova_onboarding_toolbar_top_active.xml", "mobile/android/fenix/app/src/main/res/drawable/nova_onboarding_toolbar_top_inactive.xml", "mobile/android/fenix/app/src/main/res/drawable/nova_onboarding_widget.xml", "mobile/android/fenix/app/src/main/res/raw/keep.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/DefaultBrowserPromptManagerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/OnboardingTelemetryRecorderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/continuous/ContinuousOnboardingFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/store/DefaultOnboardingPreferencesRepositoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/store/OnboardingPreferencesMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/store/OnboardingStoreTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/view/OnboardingMapperTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/view/OnboardingPageUiDataTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "4334dcd7e34e40d05ea21c92b05ffa5a8957ed86", "git_parents": ["f1e40fd5ea7dc20ff723f555b7ad5ae3d6a1f651"], "node": "5cefd7bf564908c223f33650c9084c78cac23e9a", "parents": ["68f28b52b696ac4fabf7dadee834016dac3a90d9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080652 - Fix base toolchains build.\n", "files": ["dom/svg/SVGUseElement.cpp"], "git_node": "0fa1c9cb8fb7ce13635b19fedd759a934f5e49f7", "git_parents": ["4334dcd7e34e40d05ea21c92b05ffa5a8957ed86"], "node": "4f07e03205e35da1553a8fee6eb3ee9dd5fa279f", "parents": ["5cefd7bf564908c223f33650c9084c78cac23e9a"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079602 - Replace mozilla::DefaultDelete by std::default_delete r=nika,necko-reviewers,ipc-reviewers,cubeb-reviewers,dom-storage-reviewers,firefox-style-system-reviewers,valentin,dshin,jari,pehrsons\n\nThere was a single case in toolkit/components/xulstore/XULStore.h where\nDefaultDelete was specialized, replace it by an ad-hoc Deleter.\n\nNo bad usage can happen because the destructor is deleted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331993\n", "files": ["docs/writing-rust-code/cpp-interop.md", "docshell/shistory/SessionHistoryEntry.cpp", "dom/base/Document.h", "dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/ThreadLocal.h", "ipc/glue/BackgroundChildImpl.h", "layout/style/BindgenUniquePtr.h", "layout/style/ServoBindings.toml", "media/libcubeb/0005-disable-obsolete-mozilla-default-delete.patch", "media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_resampler_internal.h", "mfbt/UniquePtr.h", "mfbt/api.yml", "mfbt/tests/TestUniquePtr.cpp", "netwerk/protocol/http/Http2StreamBase.h", "netwerk/protocol/http/nsHttpAuthCache.h", "toolkit/components/xulstore/XULStore.cpp", "toolkit/components/xulstore/XULStore.h"], "git_node": "6e61dc4328d87782ea6c35f304672fa722d5cce0", "git_parents": ["0fa1c9cb8fb7ce13635b19fedd759a934f5e49f7"], "node": "1164b69513ea94fe403e4726f5e83d564756e7e0", "parents": ["4f07e03205e35da1553a8fee6eb3ee9dd5fa279f"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079602 - Replace mozilla::MakeUnique by std::make_unique r=nika,geckoview-reviewers,ipc-reviewers,application-update-reviewers,media-playback-reviewers,webrtc-reviewers,cookie-reviewers,places-reviewers,profiler-reviewers,win-reviewers,dom-storage-reviewers,permissions-reviewers,firefox-style-system-reviewers,layout-reviewers,dom-worker-reviewers,sandbox-reviewers,gtk-reviewers,webdriver-reviewers,geoprovider-reviewers,crashreporting-reviewers,device-api-reviewers,media-webspeech-reviewers,manuel,mossop,Sasha,saschanaz,bobowen,dshin,jfkthame,chutten,emz,gstoll,jari,bwc,gsvelto,padenot,canova,asuth,emilio,yjuglaret,azebrowski\n\nObsolete mozilla::MakeUnique which is just an alias to std::make_unique\nanyway. That way it's clear we're using a standard container.\n\nThe change is purely mechanical and was generated through the following\nsequence:\n\ngit grep -l mozilla::MakeUnique | xargs sed -i -e 's/\\\u003cmozilla::MakeUnique\\\u003e/std::make_unique/g'\ngit grep -l \"using std::make_unique\" | xargs sed -i -e '/using std::make_unique;/ d'\ngit grep -l MakeUnique | xargs sed -r -i -e 's/\\\u003cMakeUnique\\\u003e/std::make_unique/g'\ngit grep -l js::std::make_unique | xargs sed -r -i -e 's/js::std::make_unique/js::MakeUnique/g'\n\nThe js/ directory required a few more iterations as js::MakeUnique and\nmozilla::MakeUnique produce different types, but that was a minor\neffort. I went manually through each of the change as a double-check,\nand strong typing helps a lot there anyway.\n\nAlso minor adjustment to markdown file, reset of js/public/UniquePtr.h\nand removal of mozilla::MakeUnique from mfbt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332395\n", "files": ["accessible/base/AccAttributes.h", "accessible/base/CachedTableAccessible.cpp", "accessible/generic/LocalAccessible.cpp", "accessible/windows/msaa/CompatibilityUIA.cpp", "accessible/windows/msaa/Platform.cpp", "browser/app/winlauncher/ErrorHandler.cpp", "browser/app/winlauncher/LaunchUnelevated.cpp", "browser/app/winlauncher/ProcThreadAttributes.h", "browser/app/winlauncher/test/TestCrossProcessWin.cpp", "browser/components/shell/WindowsDefaultBrowser.cpp", "browser/components/shell/WindowsUserChoice.cpp", "build/clang-plugin/mozsearch-plugin/MozsearchIndexer.cpp", "chrome