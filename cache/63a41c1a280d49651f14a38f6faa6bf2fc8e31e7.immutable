tocol/http/HttpChannelParent.h", "netwerk/test/unit/test_cache-entry-write-handle.js", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "e204907fd62fe2f6405c847503e6ba51afc50ba4", "git_parents": ["c6350d7721fb1173fcf8f8f0e12f3939bc54c352"], "node": "7cafb4a3a47ed1a03c114df3afec1c1d3c9ac58b", "parents": ["7a87cfecec273526b81878a9028e29d25ea92995"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075726 - Test, r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332330\n", "files": ["netwerk/test/browser/browser_alt_data_cross_origin.js"], "git_node": "f49bcdf82726524b75d116676717311f6f3828f7", "git_parents": ["e204907fd62fe2f6405c847503e6ba51afc50ba4"], "node": "5bb24094362e69b4a5684b6f1c8182bdf472ded7", "parents": ["7cafb4a3a47ed1a03c114df3afec1c1d3c9ac58b"], "tags": []}, {"author": "Dmitry Gozman \u003cdgozman@gmail.com\u003e", "branch": "default", "desc": "Bug 2080183 - Do not touch the platform geolocation when a geolocation override is set. r=saschanaz\n\nThe GeolocationService created by BrowsingContext.setGeolocationServiceOverride\nis fed positions by its caller, yet it is still wired to the platform:\n\n- Geolocation::RequestIfPermitted asks the parent for the system permission\n  behavior and, on Windows and macOS, nsGeolocationRequest::Allow then shows\n  the system permission dialog (or Gecko's \"open system settings\" dialog) for\n  a position the caller just faked. With\n  dom.geolocation.require_system_permission.enabled the request is cancelled\n  when the dialog is dismissed.\n- For watchPosition() the request still calls StartDevice() on the override\n  service, which starts the real provider in the parent process. Its\n  positions are delivered to the content process' global service, so nobody\n  consumes them. When the override lives in the parent process, Init() also\n  instantiates a real platform provider for it.\n- UpdateAccuracy() on the override service reconfigures a device it does not\n  use.\n\nMark the override service as such when it is created, skip the system\npermission query for it, and make StartDevice() and UpdateAccuracy() no-ops on\nit. Replace the comparison against sService in nsGeolocationRequest::Allow with\nan explicit predicate.\n\nThe new browser test counts \"geolocation-device-events\" \"starting\"\nnotifications in the parent: requests served by an override must not start\nthe device, while a control request through the test provider starts it\nexactly once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332405\n", "files": ["docshell/base/BrowsingContext.cpp", "dom/geolocation/Geolocation.cpp", "dom/geolocation/Geolocation.h", "dom/geolocation/test/browser/browser.toml", "dom/geolocation/test/browser/browser_geolocation_override_no_device.js", "toolkit/components/geolocation/GeolocationService.cpp", "toolkit/components/geolocation/GeolocationService.h"], "git_node": "1b3bb19182bea89749bbbcc075a2d650da21f09b", "git_parents": ["f49bcdf82726524b75d116676717311f6f3828f7"], "node": "02f84959a8fccf3bf489c98813b95186d0a1fdfc", "parents": ["5bb24094362e69b4a5684b6f1c8182bdf472ded7"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080200 [Wayland] Split nsWindowWayland to nsWindowWaylandToplevel / nsWindowWaylandPopup r=emilio,gtk-reviewers\" for causing conflicts while backing out bug 2080307\n\nThis reverts commit 2527a804ec06fcd97ce9d9f3642b311a419974f0.\n", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "14a5ee7ba53cf344c00fe9445f39425168a9fb5c", "git_parents": ["1b3bb19182bea89749bbbcc075a2d650da21f09b"], "node": "5ac3cee633bf9a7fb798664c36393d6736f72c74", "parents": ["02f84959a8fccf3bf489c98813b95186d0a1fdfc"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080307 - [Wayland] Apply toplevel opaque region changes immediately. r=gtk-reviewers,stransky,emilio\" for causing bug 2081642\n\nThis reverts commit 2dd0b125686c3aa348b94f3967e17cac6faf7acc.\n", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "861b4fc88a01f3b809d3ca5d4be72206b0f0e8b9", "git_parents": ["14a5ee7ba53cf344c00fe9445f39425168a9fb5c"], "node": "8410999b5d9b0b8ed855f46aebd88a21a1cdee0b", "parents": ["5ac3cee633bf9a7fb798664c36393d6736f72c74"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078223 - Reject the MozPromise instead of leak on shutdown in FileSystemBackgroundRequestHandler.cpp r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331631\n", "files": ["dom/fs/api/FileSystemManager.cpp", "dom/fs/child/FileSystemBackgroundRequestHandler.cpp"], "git_node": "d89c313e32333c218ce6e619f4a1e05eaad2d3ed", "git_parents": ["861b4fc88a01f3b809d3ca5d4be72206b0f0e8b9"], "node": "617ee84e4d2ce6efaad81288b3fc21eb28051905", "parents": ["8410999b5d9b0b8ed855f46aebd88a21a1cdee0b"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082300 - Revert metadata update for encrypted-media/drm-mp4-playback-temporary-multisession.https.html and encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334029\n", "files": ["testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-multisession.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.ini"], "git_node": "2515b3f5f956217a9be17414582e7c7e0d6f992f", "git_parents": ["d89c313e32333c218ce6e619f4a1e05eaad2d3ed"], "node": "3fc842cafb63650a6fecf11fb37642df90e077d7", "parents": ["617ee84e4d2ce6ef