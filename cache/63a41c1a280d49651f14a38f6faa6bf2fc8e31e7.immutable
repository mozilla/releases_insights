yout-algorithm/grid-flex-and-auto-columns-fill-available-width-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-intrinsic-size-nested-baseline-grid-001-ref.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-intrinsic-size-nested-baseline-grid-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-item-margin-auto-columns-rows-vertical-rtl-001-ref.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-item-margin-auto-columns-rows-vertical-rtl-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-max-content-tracks-items-with-paddings-001-ref.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-max-content-tracks-items-with-paddings-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-spanning-item-with-paddings-auto-columns-001-ref.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-spanning-item-with-paddings-auto-columns-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-spanning-item-with-paddings-auto-rows-001-ref.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-spanning-item-with-paddings-auto-rows-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-template-areas-media-query-001-ref.html", "testing/web-platform/tests/css/css-grid/placement/grid-template-areas-media-query-001.html"], "git_node": "09deb72e6672a5e90f01f30f5f3f3ce07f26dfe7", "git_parents": ["2aa0654c67dd7ca76e7673b7544977b9a9d48cd9"], "node": "ee4f6b6e09a4635531d551a7df9deb86abcc9cab", "parents": ["6e8f0468646b917fead821fdbb8fc24739c16f2d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076980 [wpt PR 63125] - Update wpt metadata, a=testonly\n\nwpt-pr: 63125\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-items/grid-item-min-size-auto-overflow-002.html.ini"], "git_node": "7c4d57dbdfb457afbf20028c226b3c9c8c7b00bd", "git_parents": ["09deb72e6672a5e90f01f30f5f3f3ce07f26dfe7"], "node": "55a3887f9d1aa6cb634d843a420e08e56d4e3af0", "parents": ["ee4f6b6e09a4635531d551a7df9deb86abcc9cab"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2077091 [wpt PR 63160] - Reset cached body color when the last body is removed, a=testonly\n\nAutomatic update from web-platform-tests\nReset cached body color when the last body is removed\n\nClear the body color cached in TextLinkColors when no body remains.\nIn quirks mode, invalidate the matched properties cache and\nrecalculate styles so tables use the initial color instead of the\nremoved body's.\n\nBug: 494341468\nChange-Id: Ia249ab6d0551f39ac94613df26ebc7035fee80a0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8474572\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709767}\n\n--\n\nwpt-commits: 789d9c4cdaac7c672fe8b876bc6a3d835eb151b0\nwpt-pr: 63160\n", "files": ["testing/web-platform/tests/quirks/tables-inherit-color-from-body-quirk-first-body-removed.html"], "git_node": "adec5eb3305284c0c505b515f56e421c909fa5ab", "git_parents": ["7c4d57dbdfb457afbf20028c226b3c9c8c7b00bd"], "node": "18f8062c34064b6f06d0a3ebb6cbb5467a255fb2", "parents": ["55a3887f9d1aa6cb634d843a420e08e56d4e3af0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077091 [wpt PR 63160] - Update wpt metadata, a=testonly\n\nwpt-pr: 63160\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/quirks/tables-inherit-color-from-body-quirk-first-body-removed.html.ini"], "git_node": "d4e66878bb90ca04a30bcf84d997d339862f4702", "git_parents": ["adec5eb3305284c0c505b515f56e421c909fa5ab"], "node": "140c91100e6f27c251f7fc9dc4b27b44fd4e1026", "parents": ["18f8062c34064b6f06d0a3ebb6cbb5467a255fb2"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2077696 [wpt PR 63219] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324398, a=testonly\n\nAutomatic update from web-platform-tests\n[css-values-5 calc-size()] Resolve intrinsic keyword bases at layout time\n\n    \u003cdiv style=\"display: inline-block\"\u003e\n      \u003cdiv style=\"width: calc-size(max-content, size * 2)\"\u003e\n        \u003cdiv style=\"width: 60px\"\u003e\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\nThe middle box's max-content width is 60px, so `size` is 60px and the box resolves to 120px.\nThe inline-block sizes to what that box contributes, so it is 120px too.\n\nLayout works out what the basis keyword resolves to and substitutes it for `size`.\nThis is the inline axis only.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324398\nWebKit-Canonical-Link: https://commits.webkit.org/322423@main\n\n--\n\nwpt-commits: 846c0ae87085223c14f2bf62f8ce349c54e272e8\nwpt-pr: 63219\n", "files": ["testing/web-platform/tests/css/css-values/calc-size/calc-size-list-box.html", "testing/web-platform/tests/css/css-values/calc-size/calc-size-replaced-element.html", "testing/web-platform/tests/css/css-values/calc-size/calc-size-table.html"], "git_node": "b2043b5164e3532369905c87e7049a36921f69a0", "git_parents": ["d4e66878bb90ca04a30bcf84d997d339862f4702"], "node": "3996f85b8e9b95eb12f7b578b6b5c661c5f2e380", "parents": ["140c91100e6f27c251f7fc9dc4b27b44fd4e1026"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077696 [wpt PR 63219] - Update wpt metadata, a=testonly\n\nwpt-pr: 63219\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/calc-size/calc-size-list-box.html.ini", "testing/web-platform/meta/css/css-values/calc-size/calc-size-replaced-element.html.ini", "testing/web-platform/meta/css/css-values/calc-size/calc-size-table.html.ini"], "git_node": "05fca39fea82c3d9ca7a2e795f6d400b4ee5872f", "git_parents": ["b2043b5164e3532369905c87e7049a36921f69a0"], "node": "db9660ce8fbb31ea6bedd620b9565fb78637c861", "parents": ["3996f85b8e9b95eb12f7b578b6b5c661c5f2e380"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2077695 [wpt PR 63218] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325336, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Keep nothing but the block ellipsis on a fully displaced line\n\n\u003cdiv style=\"line-clamp: 2\"\u003efirst line \u003cspan style=\"font-size: 2em\"\u003eunbreakable_content\u003c/span\u003e after\u003c/div\u003e\n\nWhen the block ellipsis displaces all the content of the clamped line, the inline box start (and any float or\nout-of-flow box placed before the content) stayed on that line, and inline boxes made the line taller.\nNow the line reverts to its start, so everything moves to the next line with the content, and only the root\ninline box strut sizes the line (open inline boxes keep their fragment but don't stretch it).\nhttps://drafts.csswg.org/css-overflow-4/#block-ellipsis\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325336\nWebKit-Canonical-Link: https://commits.webkit.org/322500@main\n\n--\n\nwpt-commits: 0918772e1072391b83e7b05860a780b6a4284188\nwpt-pr: 63218\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/block-ellipsis-036.html"], "git_node": "52b5bc300b47a4e055215c179e1ff7868a90ff48", "git_parents": ["05fca39fea82c3d9ca7a2e795f6d400b4ee5872f"], "node": "216b154e9b54231905d3fdecb0f6e4808c851fda", "parents": ["db9660ce8fbb31ea6bedd620b9565fb78637c861"], "tags": []}, {"author": "Aadharsh Pannirselvam \u003c19518661+oddharsh@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075771 [wpt PR 62978] - [compression-dictionary] Test how Cache-Control affects dictionary freshness, a=testonly\n\nAutomatic update from web-platform-tests\n[compression-dictionary] Test how Cache-Control affects dictionary freshness\n\nRFC 9842 section 2.2.1 requires a dictionary to be \"either fresh or allowed\nto be served stale\" to match. The existing tests cover an expired dictionary\nand max-age=0. This adds coverage for the directives that decide whether a\nstale response may be served: stale-while-revalidate (inside and past its\nwindow), must-revalidate (fresh and stale), no-cache, and no-store.\n\nregister-dictionary.py gains an optional cache-control parameter that replaces\nthe default max-age=N header, so a test can send any Cache-Control value.\n\n--\n\nwpt-commits: 81909f96121278bafe6d1f70a01dab8e3f1536a2\nwpt-pr: 62978\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/dictionary-registration.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/resources/register-dictionary.py"], "git_node": "4461effe8e534310d4cb7dbe775f47ea61d0edf3", "git_parents": ["52b5bc300b47a4e055215c179e1ff7868a90ff48"], "node": "0bd6ac4a742d93195e3ff13e44c83eb72bcd777c", "parents": ["216b154e9b54231905d3fdecb0f6e4808c851fda"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075771 [wpt PR 62978] - Update wpt metadata, a=testonly\n\nwpt-pr: 62978\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/fetch/compression-dictionary/dictionary-registration.tentative.https.html.ini"], "git_node": "e7a7c5389c75e6027815df6242c0fc7933136c3a", "git_parents": ["4461effe8e534310d4cb7dbe775f47ea61d0edf3"], "node": "805c668fcc06ac8a2df20de6593616ea521ccbf9", "parents": ["0bd6ac4a742d93195e3ff13e44c83eb72bcd777c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077487 [wpt PR 63195] - [wdspec] Remove Chromium-only '# META: timeout=long' annotations, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Remove Chromium-only '# META: timeout=long' annotations (#63195)\n\n- Remove '# META: timeout=long' and the accompanying explanatory\n  comments from 68 wdspec tests that complete within the normal 25s\n  timeout in upstream WPT.\n- These annotations were added in crrev.com/c/8407451,\n  crrev.com/c/8412909, and crrev.com/c/8420180 to work around slower\n  full browser/user-context setup on virtualized Chromium bots, which\n  masked regressions under the 25s normal timeout in upstream WPT.\n- Now that crrev.com/c/8466642 and crrev.com/c/8444218 mark these 68\n  tests as [ Slow ] in Chromium's SlowTests, the upstream WPT files no\n  longer need '# META: timeout=long'.\n\nBug: 565447575, 565712857\nCq-Include-Trybots: luci.chromium.try\u200b:linux-blink-rel,linux-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I5e17ff1bd7e7330b4c8d8e419675fcc8926bfcd2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8493754\nCommit-Queue: Jonathan Lee \u003cjonathanjlee@google.com\u003e\nReviewed-by: Jonathan Lee \u003cjonathanjlee@google.com\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709161}\n\nCo-authored-by: Maksim Sadym \u003csadym@chromium.org\u003e\n--\n\nwpt-commits: 7108b8dedbf4f7e6e3b21fe82b84f904f529b75f\nwpt-pr: 63195\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browser/remove_user_context/user_context.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_created/context_created.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_created/original_opener.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_created/subscribe_steps.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_destroyed/context_destroyed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/fragment_navigated/fragment_navigated.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/get_tree/frames.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/handle_user_prompt/handle_user_prompt.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/history_updated/history_updated.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/locate_nodes/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/locate_nodes/locator.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigate/data_url.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigate/error.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigate/navigate.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigation_committed/navigation_committed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/navigation_failed/navigation_failed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/print/page.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/set_viewport/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/set_viewport/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/user_prompt_closed/user_prompt_closed.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/user_prompt_opened/user_prompt_opened.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_geolocation_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_locale_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_network_conditions/contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_network_conditions/network_conditions_offline.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_network_conditions/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_screen_settings_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_touch_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_user_agent_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/external/user_agent_client_hints/set_client_hints_override/user_contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_mouse_modifier.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/wheel_events.py", "testing/web-platform/tests/webdriver/tests/bidi/input/set_files/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/network/add_intercept/contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/network/add_intercept/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/network/auth_required/auth_required.py", "testing/web-platform/tests/webdriver/tests/bidi/network/continue_with_auth/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/network/provide_response/body.py", "testing/web-platform/tests/webdriver/tests/bidi/script/add_preload_script/add_preload_script.py", "testing/web-platform/tests/webdriver/tests/bidi/script/call_function/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/script/call_function/remote_values.py", "testing/web-platform/tests/webdriver/tests/bidi/script/evaluate/remote_values.py", "testing/web-platform/tests/webdriver/tests/bidi/storage/delete_cookies/filter.py", "testing/web-platform/tests/webdriver/tests/bidi/storage/delete_cookies/partition.py", "testing/web-platform/tests/webdriver/tests/bidi/storage/get_cookies/filter.py", "testing/web-platform/tests/webdriver/tests/bidi/storage/set_cookie/partition.py", "testing/web-platform/tests/webdriver/tests/classic/back/back.py", "testing/web-platform/tests/webdriver/tests/classic/close_window/close.py", "testing/web-platform/tests/webdriver/tests/classic/element_clear/disabled.py", "testing/web-platform/tests/webdriver/tests/classic/element_click/navigate.py", "testing/web-platform/tests/webdriver/tests/classic/element_send_keys/send_keys.py", "testing/web-platform/tests/webdriver/tests/classic/execute_async_script/arguments.py", "testing/web-platform/tests/webdriver/tests/classic/find_element/find.py", "testing/web-platform/tests/webdriver/tests/classic/forward/forward.py", "testing/web-platform/tests/webdriver/tests/classic/get_element_text/get.py", "testing/web-platform/tests/webdriver/tests/classic/navigate_to/file.py", "testing/web-platform/tests/webdriver/tests/classic/new_session/invalid_capabilities.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/none.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_modifier_click.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_pen.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/wheel_events.py", "testing/web-platform/tests/webdriver/tests/classic/send_alert_text/send.py", "testing/web-platform/tests/webdriver/tests/classic/take_element_screenshot/screenshot.py", "testing/web-platform/tests/webdriver/tests/classic/take_screenshot/screenshot.py"], "git_node": "f5ba96bfedaccdeadcd2f2b44e841f666128b5a1", "git_parents": ["e7a7c5389c75e6027815df6242c0fc7933136c3a"], "node": "528b472294b993a5eb0952e60bdfbea2176817b6", "parents": ["805c668fcc06ac8a2df20de6593616ea521ccbf9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077487 [wpt PR 63195] - Update wpt metadata, a=testonly\n\nwpt-pr: 63195\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browser/remove_user_context/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/remove_user_context/user_context.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/user_prompt_opened/handler.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/user_prompt_opened/user_prompt_opened.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_alwaysMatch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_firstMatch.py.ini"], "git_node": "e39b1c1beb485a5ccb6f0e7c8792ae741c7e9d6c", "git_parents": ["f5ba96bfedaccdeadcd2f2b44e841f666128b5a1"], "node": "7eb2ef0c9e3a3cc23c4a5e73b7e0dedfd0bcccf0", "parents": ["528b472294b993a5eb0952e60bdfbea2176817b6"], "tags": []}, {"author": "Simon Farre \u003csimon.farre.cx@gmail.com\u003e", "branch": "default", "desc": "Bug 2077614 [wpt PR 63208] - Add test that verifies no state got serialized if ongoing API method tracker is null, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test that verifies no state got serialized if ongoing API method tracker is null\n\nThis is a test for the issue https://github.com/whatwg/html/issues/13014\n\nFor non-navigation API initiated navigations, there will be no ongoing\nAPI method tracker to serialize state with.\n\n--\n\nwpt-commits: a990d18fbf9fc7f0b54e16a6dd2cc27dbd75a101\nwpt-pr: 63208\n", "files": ["testing/web-platform/tests/navigation-api/precommit-handler/precommitHandler-redirect-non-api-navigation.html"], "git_node": "3402f1f6fc3a70c6ca49d688b30387ff53f3f1ca", "git_parents": ["e39b1c1beb485a5ccb6f0e7c8792ae741c7e9d6c"], "node": "85f73b08167a2d54af8b24452a3a13e723a93f19", "parents": ["7eb2ef0c9e3a3cc23c4a5e73b7e0dedfd0bcccf0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077614 [wpt PR 63208] - Update wpt metadata, a=testonly\n\nwpt-pr: 63208\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/navigation-api/precommit-handler/precommitHandler-redirect-non-api-navigation.html.ini"], "git_node": "42e4996ca4a223f8cdb893bbf6a3dc442c160e07", "git_parents": ["3402f1f6fc3a70c6ca49d688b30387ff53f3f1ca"], "node": "570a2aa4bfbdc51d140adfa8d0dd71ea46e1cfd8", "parents": ["85f73b08167a2d54af8b24452a3a13e723a93f19"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2077616 [wpt PR 63209] - Disallow percentage in calc() for \u003clength\u003e, a=testonly\n\nAutomatic update from web-platform-tests\nDisallow percentage in calc() for \u003clength\u003e\n\nWe should not allow values such as calc(4px * sign(10%)) as a valid\n\u003clength\u003e.\n\nAdjusted test_invalid_length() tests lacking a calc() wrapper which\nmade them incorrectly pass without the changes here.\n\nThis CL also disallows percentage in \u003clength\u003e for these cases:\n\ncalc(4px * sign(10% / 10%)\ncalc(4px * (10% / 10%))\n\nThere are open issues against the spec:\n\nhttps://github.com/w3c/csswg-drafts/issues/14300\nhttps://github.com/w3c/csswg-drafts/issues/12204\nhttps://github.com/w3c/csswg-drafts/issues/10017\n\nThe two latter aligns with the current Firefox Nightly.\n\nIt should be noted that we already disallowed percentages for other\nvalue types such as \u003cangle\u003e and \u003cresolution\u003e.\n\nFixes a UAF issue where CalcHandles() are accessed from multiple\nthreads computing length values in a canvas worker thread.\n\nTurn DCHECK() into CHECK() for IsMainThread() to crash instead of\ndoing cross thread access to CalcHandles().\n\nBug: 416644951, 567611695\nChange-Id: I1e4be23733b3139d16986e3848323a99248f72f1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8482545\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709882}\n\n--\n\nwpt-commits: baabe6dc9b15a3ffed3307b94372d60430eac872\nwpt-pr: 63209\n", "files": ["testing/web-platform/tests/css/css-values/signs-abs-invalid.html", "testing/web-platform/tests/html/canvas/offscreen/canvas-context/chrome-567611695-crash.html"], "git_node": "dbd7e4488f384b1fff4eaf37d82cdcc6bb053dff", "git_parents": ["42e4996ca4a223f8cdb893bbf6a3dc442c160e07"], "node": "7bb242aab6a1f2aaa53bec5bc0557cada7cf85d4", "parents": ["570a2aa4bfbdc51d140adfa8d0dd71ea46e1cfd8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077616 [wpt PR 63209] - Update wpt metadata, a=testonly\n\nwpt-pr: 63209\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/random-computed.tentative.html.ini"], "git_node": "573a2d0e93ec749f57154ffa0d02c52b63c608b7", "git_parents": ["dbd7e4488f384b1fff4eaf37d82cdcc6bb053dff"], "node": "0fc4861f6cb5a479a21f2fc4bc548d30f2f405cb", "parents": ["7bb242aab6a1f2aaa53bec5bc0557cada7cf85d4"], "tags": []}, {"author": "Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e", "branch": "default", "desc": "Bug 2077565 [wpt PR 63206] - script: Update `connected_to_document` state when disconnecting `IntersectionObserver`, a=testonly\n\nAutomatic update from web-platform-tests\nAdd WPT\n\nSigned-off-by: Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e\n\n--\n\nwpt-commits: 3370fed37c3ab3c60915014bde83cf00a6ca806e\nwpt-pr: 63206\n", "files": ["testing/web-platform/tests/intersection-observer/observe-after-unobserve.html"], "git_node": "a1213340645e152152796c3f6746eec14d316473", "git_parents": ["573a2d0e93ec749f57154ffa0d02c52b63c608b7"], "node": "f36f827a8723f3c92de63c097bcccbfbb1e2f8e1", "parents": ["0fc4861f6cb5a479a21f2fc4bc548d30f2f405cb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077565 [wpt PR 63206] - Update wpt metadata, a=testonly\n\nwpt-pr: 63206\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/intersection-observer/reinsert-element.html.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-non-scrolling-root.html.ini"], "git_node": "6830ebac7e7421b1e39a943c0ca367d197b09927", "git_parents": ["a1213340645e152152796c3f6746eec14d316473"], "node": "1e8ff50377d30d7f95fff916d795ee15c45326e5", "parents": ["f36f827a8723f3c92de63c097bcccbfbb1e2f8e1"], "tags": []}, {"author": "mxmgorin \u003c102797145+mxmgorin@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2076792 [wpt PR 63105] - webgl: Accept HALF_FLOAT in WebGL 2 texture uploads, a=testonly\n\nAutomatic update from web-platform-tests\nwebgl: Accept HALF_FLOAT in WebGL 2 texture uploads\n\nSigned-off-by: mxmgorin \u003c102797145+mxmgorin@users.noreply.github.com\u003e\n\n--\n\nwpt-commits: 3a8ad2e9451f3dfea5b074b8dc6337d7c26eba3e\nwpt-pr: 63105\n", "files": ["testing/web-platform/tests/webgl/texImage-half-float-type.html"], "git_node": "dd3f3573d6f1a5b31e103df862b8ad3efcd9980d", "git_parents": ["6830ebac7e7421b1e39a943c0ca367d197b09927"], "node": "ccd1e56ad001bbacc7026559bb2144ed0e5a2c67", "parents": ["1e8ff50377d30d7f95fff916d795ee15c45326e5"], "tags": []}, {"author": "Byungwoo Lee \u003cblee@igalia.com\u003e", "branch": "default", "desc": "Bug 2077547 [wpt PR 63200] - Fire securitypolicyviolation for worker/worklet CSP violations, a=testonly\n\nAutomatic update from web-platform-tests\nFire securitypolicyviolation for worker/worklet CSP violations\n\nWhen CSP violations are detected while fetching a worker's or worklet's\nmodule graph, a securitypolicyviolation event has not been dispatched\nsince OutsideSettingsCSPDelegate::DispatchViolationEvent() has been a\nno-op.\n\nAdd a proxy method DispatchCSPViolationEvent() to WorkerReportingProxy,\nimplement the method in MainThreadWorkletReportingProxy for the main\nthread worklets, and implement in ThreadedObjectProxyBase and\nThreadedMessagingProxyBase for the threaded workers and worklets.\n\nAdd a data wrapper CrossThreadSecurityPolicyViolationEventInit to\nforward the CSP violation data (SecurityPolicyViolationEventInit)\nacross threads.\n\nThis fix covers CSP violations on the module graph fetching for\nAudioWorklet, AnimationWorklet, PaintWorklet, LayoutWorklet, and\nDedicatedWorker (including nested workers), since they all share the\nOutsideSettingsCSPDelegate and a WorkerReportingProxy implementation\nthat can reach the target context to dispatch the event.\n(AnimationWorklet's test expectations are not updated in this CL\nsince the feature is disabled by default)\n\nSharedWorker is not covered by this change. To cover the case, we need\nto implement SharedWorkerReportingProxy::DispatchCSPViolationEvent(),\nforwarding the violation across processes (via the browser process's\nSharedWorkerHost) to the worker's owners.\n\nThe fix is gated by an experimental runtime-enabled feature,\nDispatchWorkerCSPViolationEventForModuleGraphFetching.\n\nLow-Coverage-Reason: OTHER No need to test the fallback virtual proxy method that is a no-op.\nBug: 40612680\nForce-WPT-Export: true\nChange-Id: I977144fd8098dede6ec0ac57d9e03348aca24389\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8256819\nReviewed-by: Hiroki Nakagawa \u003cnhiroki@chromium.org\u003e\nCommit-Queue: Byungwoo Lee \u003cblee@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709955}\n\n--\n\nwpt-commits: 8f35c13cebda81174ddb789c73b126b5649c4de6\nwpt-pr: 63200\n", "files": ["testing/web-platform/tests/content-security-policy/securitypolicyviolation/inside-nested-dedicated-worker.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/support/inside-nested-worker-inner.sub.js", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/support/inside-nested-worker-outer.sub.js", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/support/inside-nested-worker-outer.sub.js.headers", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/worklet-import-nested-cross-origin-blocked.https.sub.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/worklet-import-report-only.https.sub.html", "testing/web-platform/tests/content-security-policy/securitypolicyviolation/worklet-import-report-only.https.sub.html.headers"], "git_node": "c689e6dee2119d422ff45007bc512a8b6cfd2fbd", "git_parents": ["dd3f3573d6f1a5b31e103df862b8ad3efcd9980d"], "node": "55fe831d96c785d2f3bda805f850ba6e1ef16f9d", "parents": ["ccd1e56ad001bbacc7026559bb2144ed0e5a2c67"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077547 [wpt PR 63200] - Update wpt metadata, a=testonly\n\nwpt-pr: 63200\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/securitypolicyviolation/inside-nested-dedicated-worker.html.ini", "testing/web-platform/meta/content-security-policy/securitypolicyviolation/worklet-import-nested-cross-origin-blocked.https.sub.html.ini", "testing/web-platform/meta/content-security-policy/securitypolicyviolation/worklet-import-report-only.https.sub.html.ini"], "git_node": "44378ca11cd630fb0b2a5d877bd96479bdce53c1", "git_parents": ["c689e6dee2119d422ff45007bc512a8b6cfd2fbd"], "node": "6e5ab99ed32261232c56e8ef3325bf06a7cd32a7", "parents": ["55fe831d96c785d2f3bda805f850ba6e1ef16f9d"], "tags": []}, {"author": "Sky Debreuil \u003cskydebreuil@google.com\u003e", "branch": "default", "desc": "Bug 2077506 [wpt PR 63196] - [css-overflow] Add WPTs for scroll-marker-group scroll container changes, a=testonly\n\nAutomatic update from web-platform-tests\n[css-overflow] Add WPTs for scroll-marker-group scroll container changes\n\nWhen an element with scroll-marker-group becomes a scroll container,\nits ::scroll-marker pseudo-elements are not created. When it stops\nbeing a scroll container, they are not removed.\n\nWith nested groups, a stale marker can then be attached to a second\ngroup, hitting DCHECK(!GetLayoutObject()) in\nPseudoElement::AttachLayoutTree().\n\nAdd two WPT reftests and a crashtest for these cases, and mark them as\nexpected failures in TestExpectations until the fix lands in a\nfollow-up CL.\n\nBug: 500793607\nChange-Id: Ib252a2d5f690ee73bf12a792a6aa4075df9c86d6\nCq-Include-Trybots: luci.chromium.try\u200b:linux-blink-web-tests-force-accessibility-rel,fuchsia-x64-accessibility-rel,linux-blink-rel,mac15.arm64-blink-rel,win11-blink-rel,android-15-chrome-blink-rel\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8465744\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCommit-Queue: Sky Debreuil \u003cskydebreuil@google.com\u003e\nReviewed-by: Free Debreuil \u003cfreedebreuil@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1710139}\n\n--\n\nwpt-commits: dd9a69da4b0ca491c1d5fee766c8fac180213cab\nwpt-pr: 63196\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-001.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-002.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-crash.html"], "git_node": "0d713b7a4634efd4fb29209754b3f73da2770d2f", "git_parents": ["44378ca11cd630fb0b2a5d877bd96479bdce53c1"], "node": "d0d731fdfafbf78751a6b7827900f7d523dcecc7", "parents": ["6e5ab99ed32261232c56e8ef3325bf06a7cd32a7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077506 [wpt PR 63196] - Update wpt metadata, a=testonly\n\nwpt-pr: 63196\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-001.html.ini"], "git_node": "89f52b0d4ffb64c415c3f1802b7c4386646c3cae", "git_parents": ["0d713b7a4634efd4fb29209754b3f73da2770d2f"], "node": "3ac942e0fdf2d456064b3f2b87464ec0c913f32d", "parents": ["d0d731fdfafbf78751a6b7827900f7d523dcecc7"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2077693 [wpt PR 63217] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324508, a=testonly\n\nAutomatic update from web-platform-tests\n[css-values-5 calc-size()] Add support for calc-size() on an out-of-flow positioned box in the inline axis\n\n    \u003cdiv style=\"position: relative; width: 400px\"\u003e\n      \u003cdiv style=\"position: absolute; width: calc-size(max-content, size + 20px)\"\u003e\u2026\u003c/div\u003e\n    \u003c/div\u003e\n\nThe max-content width is 100px, so the box is 120px wide rather than 100px. The block axis already\nresolved a keyword basis, since it goes through computeContentAndScrollbarLogicalHeightUsing().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324508\nWebKit-Canonical-Link: https://commits.webkit.org/322528@main\n\n--\n\nwpt-commits: 17d707b9798342d5878e6de93b88401c9d8789cd\nwpt-pr: 63217\n", "files": ["testing/web-platform/tests/css/css-values/calc-size/calc-size-out-of-flow.html"], "git_node": "b39094027fda444552b35b1121f542656265e230", "git_parents": ["89f52b0d4ffb64c415c3f1802b7c4386646c3cae"], "node": "1caedf2e0836735dbf671e196b260f5f919ebf36", "parents": ["3ac942e0fdf2d456064b3f2b87464ec0c913f32d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077693 [wpt PR 63217] - Update wpt metadata, a=testonly\n\nwpt-pr: 63217\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/calc-size/calc-size-out-of-flow.html.ini"], "git_node": "dadb59a4a5498bf9949314b067a6de32ed6ec3d0", "git_parents": ["b39094027fda444552b35b1121f542656265e230"], "node": "9275b44497b011551ff0baa922a25d3289b2ef8e", "parents": ["1caedf2e0836735dbf671e196b260f5f919ebf36"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2077699 [wpt PR 63221] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324772, a=testonly\n\nAutomatic update from web-platform-tests\n[css-values-5 calc-size()] Add support for an auto basis on replaced elements\n\n    \u003c!-- a 60x20 image --\u003e\n    \u003cimg style=\"width: calc-size(auto, size * 2)\"\u003e\n\n`auto` on a replaced element is its intrinsic width, 60px, so the image is 120px wide, and the aspect ratio then makes it 40px tall.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324772\nWebKit-Canonical-Link: https://commits.webkit.org/322486@main\n\n--\n\nwpt-commits: c18fd8163e14055653fcbb50ad2be94b4a927dc6\nwpt-pr: 63221\n", "files": ["testing/web-platform/tests/css/css-values/calc-size/calc-size-replaced-element.html"], "git_node": "56dd4d3704e8e6b0e0f28468100e208b405a0766", "git_parents": ["dadb59a4a5498bf9949314b067a6de32ed6ec3d0"], "node": "bcf099adb17d849537b75b56e7d5cd92cac50c6a", "parents": ["9275b44497b011551ff0baa922a25d3289b2ef8e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077699 [wpt PR 63221] - Update wpt metadata, a=testonly\n\nwpt-pr: 63221\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/calc-size/calc-size-replaced-element.html.ini"], "git_node": "6ce237f4e5f92650ed6d792e8d829edb6b199763", "git_parents": ["56dd4d3704e8e6b0e0f28468100e208b405a0766"], "node": "c5566cadf4ee5ee29b018a969e2997ddd1ab20ea", "parents": ["bcf099adb17d849537b75b56e7d5cd92cac50c6a"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2077629 [wpt PR 63214] - Mark scripts in frameless XML documents as already started, a=testonly\n\nAutomatic update from web-platform-tests\nMark scripts in frameless XML documents as already started\n\nXSLTProcessor.transformToDocument() creates a frameless Document and\npopulates it via Document::SetContent(). For XML output,\nXMLDocumentParser and XMLDocumentParserRs do not create a script_runner_\nwhen the document has no frame, so ScriptLoader::PrepareScript() is\nnever called during parsing. Because ShouldMarkScriptAlreadyStarted()\npreviously only checked for DOMParser, XMLHttpRequest, and fragment\nparsing, script elements in XML-output transformToDocument() results\nwere left with already_started set to false and would execute if later\ncloned or imported into an active document.\n\nUpdate ShouldMarkScriptAlreadyStarted() in both XML parsers to also\ncheck !document_-\u003eGetFrame() so that scripts in frameless XML documents\nare marked already started upon creation.\n\nFixed: 565252325\nChange-Id: Ia09b96f447c8d8857a7bd2385e87191efd4c3126\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8494597\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nReviewed-by: Dominik R\u00f6ttsches \u003cdrott@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710082}\n\n--\n\nwpt-commits: d7ff4d5ceedf6399f338462cd19ea07e568d4e5b\nwpt-pr: 63214\n", "files": ["testing/web-platform/tests/xml/xslt/transformToDocument-xml-scripting-support-disabled.html"], "git_node": "d9145a10e7cee4da065aaa9759dc3ec497f40a95", "git_parents": ["6ce237f4e5f92650ed6d792e8d829edb6b199763"], "node": "8f7a022b2d6ea95ce8f7009509b46b415d06bee3", "parents": ["c5566cadf4ee5ee29b018a969e2997ddd1ab20ea"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077629 [wpt PR 63214] - Update wpt metadata, a=testonly\n\nwpt-pr: 63214\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/xml/xslt/invalid-output-encoding-crash.html.ini", "testing/web-platform/meta/xml/xslt/svg/crashtests/xslt-in-img-001.html.ini"], "git_node": "56c56f3f3361c820df7536fc93f9cd069168749a", "git_parents": ["d9145a10e7cee4da065aaa9759dc3ec497f40a95"], "node": "df621917128e02563ba7160f7235af3489c175b9", "parents": ["8f7a022b2d6ea95ce8f7009509b46b415d06bee3"], "tags": []}, {"author": "Christian Biesinger \u003ccbiesinger@chromium.org\u003e", "branch": "default", "desc": "Bug 2077670 [wpt PR 63215] - Fail instead of timing out when FedCM shows an unexpected dialog, a=testonly\n\nAutomatic update from web-platform-tests\nFail instead of timing out when FedCM shows an unexpected dialog\n\nSome FedCM tests wait for a request that is expected to fail, or to be\nauto re-authenticated, to settle. When the browser shows an account\nchooser instead, the request stays pending until the test times out.\n\nRace these requests against the dialog appearing, so that the tests fail\nright away with a message naming the dialog that was shown:\n\n- well-known-client-metadata-validation expects requests to be\n  rejected, so wrap them in fedcm_settles_without_dialog().\n- The auto re-authentication tests use a new helper,\n  fedcm_expect_auto_reauthn(), which allows the auto re-authentication\n  notice, which is reported as a dialog, but fails on any other dialog.\n\nBoth helpers now cancel an unexpected dialog, so that the pending\nrequest does not block the requests in later subtests.\n\nWritten with Claude. This primarily affects wpt.fyi and not the\nChrome-side WPT runner.\n\nBug: 331237776\nChange-Id: I3de042932739c3aff09569e4ccfd3f0e92f1d23f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8498602\nCommit-Queue: Christian Biesinger \u003ccbiesinger@chromium.org\u003e\nReviewed-by: Yi Gu \u003cyigu@chromium.org\u003e\nAuto-Submit: Christian Biesinger \u003ccbiesinger@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710189}\n\n--\n\nwpt-commits: 300776810530bf616182c19dc20b3f8dd7a1609d\nwpt-pr: 63215\n", "files": ["testing/web-platform/tests/fedcm/fedcm-auto-selected-flag.https.html", "testing/web-platform/tests/fedcm/fedcm-button-and-other-account/fedcm-button-mode-auto-selected-flag.tentative.https.html", "testing/web-platform/tests/fedcm/fedcm-multi-idp/fedcm-multi-idp-mediation-optional.https.html", "testing/web-platform/tests/fedcm/fedcm-returning-account-auto-reauthn.https.html", "testing/web-platform/tests/fedcm/fedcm-well-known-validation/well-known-client-metadata-validation.https.html", "testing/web-platform/tests/fedcm/support/fedcm-helper.sub.js"], "git_node": "14182084309b4ae4ef8d2f4e270576d7f2e05de6", "git_parents": ["56c56f3f3361c820df7536fc93f9cd069168749a"], "node": "d85dac886fc847b528ccacf5e89dcbc946c55584", "parents": ["df621917128e02563ba7160f7235af3489c175b9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077670 [wpt PR 63215] - Update wpt metadata, a=testonly\n\nwpt-pr: 63215\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/fedcm/fedcm-well-known-validation/well-known-client-metadata-validation.https.html.ini"], "git_node": "fb4e888d8f89aa293b30677d805126f2c5ef30a5", "git_parents": ["14182084309b4ae4ef8d2f4e270576d7f2e05de6"], "node": "f2ec9cf28f6d33b37b73c8535f1548deaf1970d3", "parents": ["d85dac886fc847b528ccacf5e89dcbc946c55584"], "tags": []}, {"author": "Gabriel Brito \u003cgabrielbrito@microsoft.com\u003e", "branch": "default", "desc": "Bug 2077628 [wpt PR 63213] - OfflineAudioContext incremental rendering, a=testonly\n\nAutomatic update from web-platform-tests\nOfflineAudioContext incremental rendering\n\nThis CL implements incremental rendering support for\nOfflineAudioContext.startRendering. These changes reflect the steps of\nthe current startRendering algorithm of the Web Audio specification:\nhttps://webaudio.github.io/web-audio-api/#dom-offlineaudiocontext-startrendering\n\nThese changes are gated by a feature flag so that the old behavior shall\nbe observed while the flag is disabled. Regression tests have been added\nto make sure these observable behaviors still happen while the feature\nflag is disabled. While the flag is disabled,\n- Passing an OfflineAudioContextOptions dict to the OAC constructor will\n  throw a TypeError with the same message that is currently used\n- Passing a chunkSize value to startRendering will just set the internal\n  value to std::nullopt, which should trigger the old behavior of\n  rendering the whole buffer at once.\n- Exceptions will be thrown if startRendering is called twice or if\n  called while it is suspended.\n\nBug: 530596178\nChange-Id: I97b00d8a180e867a8cc119efb493089b10e545c4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8376101\nReviewed-by: Hongchan Choi \u003chongchan@google.com\u003e\nReviewed-by: Michael Wilson \u003cmjwilson@chromium.org\u003e\nCommit-Queue: Gabriel Brito \u003cgabrielbrito@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1710215}\n\n--\n\nwpt-commits: 30ea40fa727fd151ed284e682e062c76143ce456\nwpt-pr: 63213\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-offlineaudiocontext-interface/ctor-offlineaudiocontext.html", "testing/web-platform/tests/webaudio/the-audio-api/the-offlineaudiocontext-interface/offlineaudiocontext-incremental-rendering-data-integrity.html", "testing/web-platform/tests/webaudio/the-audio-api/the-offlineaudiocontext-interface/offlineaudiocontext-incremental-rendering.html"], "git_node": "d5d718cf576f13966eef5f33f33fc690e8ef2ee8", "git_parents": ["fb4e888d8f89aa293b30677d805126f2c5ef30a5"], "node": "79954fe458ac12339fe6b40fb657ccaf3b0f2c22", "parents": ["f2ec9cf28f6d33b37b73c8535f1548deaf1970d3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077628 [wpt PR 63213] - Update wpt metadata, a=testonly\n\nwpt-pr: 63213\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webaudio/the-audio-api/the-offlineaudiocontext-interface/ctor-offlineaudiocontext.html.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-offlineaudiocontext-interface/offlineaudiocontext-incremental-rendering.html.ini"], "git_node": "a95d476d17f85ca4fa69aea208557a2c4a4d6241", "git_parents": ["d5d718cf576f13966eef5f33f33fc690e8ef2ee8"], "node": "b01a0e2806587e529616be6638883a554af71364", "parents": ["79954fe458ac12339fe6b40fb657ccaf3b0f2c22"], "tags": []}, {"author": "Andreu Botella \u003cabotella@igalia.com\u003e", "branch": "default", "desc": "Bug 2077691 [wpt PR 63216] - [line-clamp] Use the expected BFC offset in the LineClampAncestorChain, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Use the expected BFC offset in the LineClampAncestorChain\n\nAdded in https://crrev.com/c/7566509, the `LineClampAncestorChain` is\na data structure used to compute the expected automatic block size of\na line-clamp container if we were to clamp at a given point, which is\nused in order to line-clamp based on a height. It does this by storing\ndata for the current block box and its ancestors up to the line-clamp\ncontainer in an immutable single linked list.\n\nOne of the pieces of data the ancestor chain stores for each box is\nits BFC offset. However, the ancestor chain for a box must be created\nbefore any layout of its children, meaning that the BFC offset won't\nbe resolved at that point for any box other than the line-clamp\ncontainer itself.\n\nPreviously this was handled by having the BFC offset field be a\n`std::optional`, by creating a replacement chain once the BFC offset\nis known, and by assuming that if a descendant node resolves its BFC\noffset, all nodes in the ancestor chain that don't have a BFC offset\nmust end up with the BFC offset we just resolved. Unfortunately, this\napproach ended up having holes in cases where a BFC offset is resolved\nwithout causing a relayout.\n\nThis patch instead refactors the ancestor chain so that it always\nstores the expected BFC offset of each box, even if that expectation\nis optimistic. It then also sets the\n`BlockLayoutAlgorithm::abort_when_bfc_block_offset_updated_` flag, to\nmake sure we relayout to invalidate the expectation.\n\nThis change regresses one WPT test, `line-clamp-auto-045.html`, but\nthis seems to be due to a preexisting issue when\n`abort_when_bfc_block_offset_updated_` is set, bug 568010387.\n\nBug: 40336192, 561613778\nChange-Id: I1e5068b86e88b3b957235f18b5f5c383483bf997\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8501743\nCommit-Queue: Andreu Botella \u003cabotella@igalia.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710292}\n\n--\n\nwpt-commits: 2be669784f1e7386ea21acff340b96c265ca3e07\nwpt-pr: 63216\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-063.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-auto-063-ref.html"], "git_node": "54d1a272ee48baa34282e6a42acbe760c9fb6065", "git_parents": ["a95d476d17f85ca4fa69aea208557a2c4a4d6241"], "node": "56b2eaa13d11f070b5e817ba98eb3ac10e88580d", "parents": ["b01a0e2806587e529616be6638883a554af71364"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077691 [wpt PR 63216] - Update wpt metadata, a=testonly\n\nwpt-pr: 63216\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-063.html.ini"], "git_node": "bf496fa7f14378da929f2a51b90d1b8dc30ab76f", "git_parents": ["54d1a272ee48baa34282e6a42acbe760c9fb6065"], "node": "dcd20bc9b6b55b0c15f1aa4d2e6113afadf622cc", "parents": ["56b2eaa13d11f070b5e817ba98eb3ac10e88580d"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2077769 [wpt PR 63224] - Move positional HTML methods to NonDocumentTypeChildNode and align Trusted Types sinks, a=testonly\n\nAutomatic update from web-platform-tests\nMove positional HTML methods to NonDocumentTypeChildNode and align Trusted Types sinks\n\nThis aligns positional HTML insertion and streaming methods with\nhttps://github.com/whatwg/html/pull/12753:\n\nBug: 491743369\nChange-Id: Ie0b6f8175b7de75b9842bf90cccd168dbced1275\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8494796\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1710333}\n\n--\n\nwpt-commits: c3a310677da334e3d08e4704a4c7788ff8f5fdb5\nwpt-pr: 63224\n", "files": ["testing/web-platform/tests/domparsing/tentative/positional-methods-with-parser-options.html", "testing/web-platform/tests/domparsing/tentative/positional-methods-with-trusted-types.html", "testing/web-platform/tests/domparsing/tentative/positional-methods.html", "testing/web-platform/tests/domparsing/tentative/stream-positional.html"], "git_node": "b618ba4b1ca105c8f4a29db71db6cd2d020d0ca0", "git_parents": ["bf496fa7f14378da929f2a51b90d1b8dc30ab76f"], "node": "576ca9f6f6d1fd03202a81e46015ec35154a144a", "parents": ["dcd20bc9b6b55b0c15f1aa4d2e6113afadf622cc"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077769 [wpt PR 63224] - Update wpt metadata, a=testonly\n\nwpt-pr: 63224\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/positional-methods-with-trusted-types.html.ini", "testing/web-platform/meta/domparsing/tentative/positional-methods.html.ini"], "git_node": "57443e2ed6d9fc4a4e045c899bb3a484662de420", "git_parents": ["b618ba4b1ca105c8f4a29db71db6cd2d020d0ca0"], "node": "802a797ffa95fae8c50aa2960738f1e32dd2096c", "parents": ["576ca9f6f6d1fd03202a81e46015ec35154a144a"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2077772 [wpt PR 63225] - Remove void element end tags from HTML editing and rendering WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove void element end tags from HTML editing and rendering WPTs\n\ninput, link, embed, source, area and frame have no end tag. Writing an\nend tag for any of these is a parse error, and the parser drops the tag,\nso the source suggests a structure the document never had. \u003c/br\u003e is the\none exception: the parser rewrites it into a \u003cbr\u003e start tag, so it is\nspelled \u003cbr\u003e instead of being deleted.\n\nThis CL removes those void end tags from WPT tests in html/editing,\nhtml/browsers and html/rendering.\n\nBug: 542686202\nChange-Id: I59be0229376410c6b8a2e31244b1979cc8dda382\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8225583\nReviewed-by: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1710336}\n\n--\n\nwpt-commits: c767b6281fbca35e30f3301147085b3f4784a70d\nwpt-pr: 63225\n", "files": ["testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/abort-document-load-2.html", "testing/web-platform/tests/html/browsers/the-window-object/accessing-other-browsing-contexts/indexed-browsing-contexts-02.html", "testing/web-platform/tests/html/browsers/the-window-object/accessing-other-browsing-contexts/test2.html", "testing/web-platform/tests/html/browsers/the-window-object/accessing-other-browsing-contexts/test3.html", "testing/web-platform/tests/html/browsers/the-window-object/named-access-on-the-window-object/named-objects.html", "testing/web-platform/tests/html/browsers/the-window-object/named-access-on-the-window-object/test.html", "testing/web-platform/tests/html/editing/dnd/events/dragend-event-manual.html", "testing/web-platform/tests/html/editing/dnd/events/dragenter-event-manual.html", "testing/web-platform/tests/html/editing/dnd/events/dragleave-event-manual.html", "testing/web-platform/tests/html/editing/dnd/events/drop-event-manual.html", "testing/web-platform/tests/html/editing/dnd/the-datatransfer-interface/effectAllowed-manual.html", "testing/web-platform/tests/html/editing/dnd/the-datatransfer-interface/setData-manual.html", "testing/web-platform/tests/html/editing/dnd/the-datatransfer-interface/types-manual.html", "testing/web-platform/tests/html/editing/dnd/the-dropzone-attribute/dropzone_attribute_inputbox_element-manual.html", "testing/web-platform/tests/html/editing/dnd/the-dropzone-attribute/dropzone_attribute_inputbox_element_dbcs-manual.html", "testing/web-platform/tests/html/editing/the-hidden-attribute/hidden-until-found-002.html", "testing/web-platform/tests/html/rendering/non-replaced-elements/the-frameset-and-frame-elements/different-writing-modes.html", "testing/web-platform/tests/html/rendering/non-replaced-elements/the-frameset-and-frame-elements/reference/different-writing-modes-ref.html", "testing/web-platform/tests/html/rendering/pixel-length-attributes.html", "testing/web-platform/tests/html/rendering/replaced-elements/attributes-for-embedded-content-and-images/picture-aspect-ratio.html"], "git_node": "7c32933ae69df50321e251bf0aaadb527f9930e4", "git_parents": ["57443e2ed6d9fc4a4e045c899bb3a484662de420"], "node": "7c40b7f68cd2c04f1aeb765cfa1be42cf1e86d16", "parents": ["802a797ffa95fae8c50aa2960738f1e32dd2096c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077772 [wpt PR 63225] - Update wpt metadata, a=testonly\n\nwpt-pr: 63225\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/rendering/cdata-001.xhtml.ini"], "git_node": "b89689b3a810fec09696adac6637c9b21d3c51f5", "git_parents": ["7c32933ae69df50321e251bf0aaadb527f9930e4"], "node": "d1dea3d605e1c19f149b323490af59df0736e78a", "parents": ["7c40b7f68cd2c04f1aeb765cfa1be42cf1e86d16"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2077607 [wpt PR 63207] - Drop navigate event only for BFCache-restored non-intercepted navs, a=testonly\n\nAutomatic update from web-platform-tests\nDrop navigate event only for BFCache-restored non-intercepted navs\n\ncrrev.com/c/7653517 made SetEntriesForRestore() unconditionally clear\nongoing_navigate_event_ to avoid a dangling cross-document navigate\nevent after restore. However, SetEntriesForRestore() also runs on\nprerender activation (and bfcache restore) while an intercepted\nsame-document navigation may still be in flight. Dropping it without\naborting its signal causes NavigateEvent::ReactDone() to hit\nCHECK_EQ(this, ongoing_navigate_event_) once the intercept handler\nsettles.\n\nOnly clear the ongoing event (and its API method tracker) when it has\nnot been intercepted and has not reacted, i.e. it is the dangling\ncross-document navigation the original change targeted.\n\nBug: 553918186\nChange-Id: If86f586924e4ceb57f5565f9c016b5b37ab3f6ef\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8479895\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Lingqi Chi \u003clingqi@chromium.org\u003e\nReviewed-by: Nate Chapin \u003cjaphet@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710338}\n\n--\n\nwpt-commits: b8dcaf37787a645a7202fa497eec397640f88632\nwpt-pr: 63207\n", "files": ["testing/web-platform/tests/navigation-api/navigate-event/intercepted-navigation-after-bfcache-restore.html", "testing/web-platform/tests/speculation-rules/prerender/navigation-api-intercept-during-activation.https.html"], "git_node": "5e6c97ccdf25db6a3dd1104cfb683ba595530b97", "git_parents": ["b89689b3a810fec09696adac6637c9b21d3c51f5"], "node": "e8eb9489f67ad853799667003b394d4bdee274af", "parents": ["d1dea3d605e1c19f149b323490af59df0736e78a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077607 [wpt PR 63207] - Update wpt metadata, a=testonly\n\nwpt-pr: 63207\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/navigation-api/navigate-event/intercepted-navigation-after-bfcache-restore.html.ini", "testing/web-platform/meta/speculation-rules/prerender/navigation-api-intercept-during-activation.https.html.ini"], "git_node": "b6ecc4b50f73ea223f8fbf380a929e6719cc0ce6", "git_parents": ["5e6c97ccdf25db6a3dd1104cfb683ba595530b97"], "node": "deadd4fc23693bdabcea61bb567a8583e3d0989c", "parents": ["e8eb9489f67ad853799667003b394d4bdee274af"], "tags": []}, {"author": "Thomas Guilbert \u003ctguilbert@chromium.org\u003e", "branch": "default", "desc": "Bug 2077712 [wpt PR 63222] - Deflake preserves-pitch.html when playback stalls, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake preserves-pitch.html when playback stalls\n\n`preserves-pitch.html` samples the pitch on the first `timeupdate` with\n`currentTime \u003e= 0.5`. `timeupdate` is also fired when playback stalls to\nwait for data, and the analyser only receives silence during stalls.\nThis shows up as 0Hz failures in the 2x cases, mostly on debug bots.\n\nThis CL only resolves `waitUntil()` while `readyState` is at least\n`HAVE_FUTURE_DATA`. It also retries the detection up to twice more if it\nreturns 0Hz, since a periodic `timeupdate` can still race with a stall.\n\nFinally, this removes a stale `Win11-arm64` `[ Timeout ]` expectation\nfor `preserves-pitch.html`, which hasn't timed out in ~1,900 runs since\nJuly.\n\nFixed: 40706046, 353583104\nChange-Id: I134980f58b4ca1ed766ac78b6b8edacef68bc3e0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508603\nCommit-Queue: Hongchan Choi \u003chongchan@google.com\u003e\nReviewed-by: Hongchan Choi \u003chongchan@google.com\u003e\nAuto-Submit: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCommit-Queue: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710356}\n\n--\n\nwpt-commits: 1a5d02cde89b48bf8f8d2cc426be6b437f00d541\nwpt-pr: 63222\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/preserves-pitch.html"], "git_node": "023f0e3a4c4bdb34f4a3ced2743c04ed665505dc", "git_parents": ["b6ecc4b50f73ea223f8fbf380a929e6719cc0ce6"], "node": "4290e6116ddabf44c1e8112cc16f24c88f62f28e", "parents": ["deadd4fc23693bdabcea61bb567a8583e3d0989c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077712 [wpt PR 63222] - Update wpt metadata, a=testonly\n\nwpt-pr: 63222\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/__dir__.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/track-cue-rendering-after-controls-removed.html.ini"], "git_node": "da2a631f6c732077d3f09511a7e9b0d58859f3a3", "git_parents": ["023f0e3a4c4bdb34f4a3ced2743c04ed665505dc"], "node": "61eadef183eb9221d8ceb2bd30c5f1ab82db1972", "parents": ["4290e6116ddabf44c1e8112cc16f24c88f62f28e"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2077821 [wpt PR 63227] - [html-in-canvas] Remove layoutSubtree, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Remove layoutSubtree\n\nWe have switched to content=drawable and this patch removes the\nlegacy layoutSubtree attribute.\n\nBug: 561849343\nChange-Id: I79c7738e2a4daf08c1b73ceffc440fbb87a07439\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8494061\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710365}\n\n--\n\nwpt-commits: 74ca910926d76710943f2a8798817102f69d6e40\nwpt-pr: 63227\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/date-input-slot-assignment-crash.tentative.html"], "git_node": "97f5b19360c27adc364a4c2a936d6a544f944ff9", "git_parents": ["da2a631f6c732077d3f09511a7e9b0d58859f3a3"], "node": "9b68e353691f58c7a0b8b947ba253775a5006c3e", "parents": ["61eadef183eb9221d8ceb2bd30c5f1ab82db1972"], "tags": []}, {"author": "Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e", "branch": "default", "desc": "Bug 2077617 [wpt PR 63210] - webdriver: Invalidate duration of null/key/pointer/wheel action, a=testonly\n\nAutomatic update from web-platform-tests\nwdspec: Add test for invalid scroll duration and pointermove duration\n\nSigned-off-by: Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e\n\n--\n\nwpt-commits: f37e2295b34838f17c612a527f52f3056e7b6da2\nwpt-pr: 63210\n", "files": ["testing/web-platform/tests/webdriver/tests/classic/perform_actions/invalid.py"], "git_node": "b75c96b67e90f4a3935dcb3f97458d9d2a15e641", "git_parents": ["97f5b19360c27adc364a4c2a936d6a544f944ff9"], "node": "b90869acff01a351a751beec9eb32f020e8500d6", "parents": ["9b68e353691f58c7a0b8b947ba253775a5006c3e"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2077809 [wpt PR 63226] - Use long timeout for src-then-lazy-load.html, a=testonly\n\nAutomatic update from web-platform-tests\nUse long timeout for src-then-lazy-load.html\n\nThe test sleeps 6s by design (12 x 500ms step_timeouts), which leaves\nno headroom against the 6s base timeout; on linux-oi-rel it ran at\n~6.4s and flipped from barely-passing to consistently timing out,\ncausing LUCI Bisection to blame crrev.com/c/8126943.\n\nBug: 535260626\nChange-Id: I1dc25a7846c6004dfeaa70e12f18ec58f49dad15\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8501165\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1710462}\n\n--\n\nwpt-commits: b01090a989cde89da80cc5369e71990780612005\nwpt-pr: 63226\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/update-the-image-data/src-then-lazy-load.html"], "git_node": "b31fc32cc8263959d243f887110f728565e9970b", "git_parents": ["b75c96b67e90f4a3935dcb3f97458d9d2a15e641"], "node": "484c297e2ae7ae99c79960ac9c1e9b3a0d4c372d", "parents": ["b90869acff01a351a751beec9eb32f020e8500d6"], "tags": []}, {"author": "Brandon Walderman \u003cbrwalder@microsoft.com\u003e", "branch": "default", "desc": "Bug 2077905 [wpt PR 63229] - [css-mixins] Invalidate shadow DOM mixin consumers, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Invalidate shadow DOM mixin consumers\n\nChanging a mixin in an outer tree scope only rebuilt RuleSets in that\nscope. Descendant shadow styles that applied the inherited mixin could\nremain flattened against the old definition.\n\nPropagate mixin changes along paths to dependent shadow scopes and\nrefresh intermediate scope identities so local mixins cannot hide an\ninherited change. Preserve the existing identity when the effective\nmixin map is unchanged to avoid rebuilding dependent RuleSets after\nunrelated stylesheet updates.\n\nCSSOM mutation can modify a mixin in place without changing its rule\npointer. Track a monotonic revision for each stylesheet's extracted\nmixins so every collection sharing a constructable stylesheet observes\nthe mutation independently.\n\nAdd coverage for direct and nested shadow consumers, including a shared\nconstructable stylesheet adopted into sibling scopes. Also expose the\ndependent-scope invalidation phase as a trace metric for the mixin\ninvalidation perf tests.\n\nBug: 542873370\nChange-Id: I0760313de69d51d02aa8cf00068b5cd8c7662d9c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8450115\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCommit-Queue: Brandon Walderman \u003cbrwalder@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1710484}\n\n--\n\nwpt-commits: 3a34a13d22d9c50b35ac9ba2f7bcae08fef23191\nwpt-pr: 63229\n", "files": ["testing/web-platform/tests/css/css-mixins/mixins/mixin-shadow-dom.html"], "git_node": "c9a7d7974a343f37dccc976d197d986d1605749a", "git_parents": ["b31fc32cc8263959d243f887110f728565e9970b"], "node": "c22eb0a24897fd17ac9ac146fc22e848d3b87ed5", "parents": ["484c297e2ae7ae99c79960ac9c1e9b3a0d4c372d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077905 [wpt PR 63229] - Update wpt metadata, a=testonly\n\nwpt-pr: 63229\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/mixins/mixin-shadow-dom.html.ini"], "git_node": "284c280e8e1991c32d62f03e3f8ca9010b1bac6e", "git_parents": ["c9a7d7974a343f37dccc976d197d986d1605749a"], "node": "9bfe86fb56407e607226dc9c054ed10b92baba51", "parents": ["c22eb0a24897fd17ac9ac146fc22e848d3b87ed5"], "tags": []}, {"author": "Stefan Zager \u003cszager@chromium.org\u003e", "branch": "default", "desc": "Bug 2077908 [wpt PR 63230] - [HiC] Disable composited clip-path animations inside canvas, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Disable composited clip-path animations inside canvas\n\nFixed: 567613566\nChange-Id: Id9e77fe3df096ea5c2067f8eab5ff7861a6ed996\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8487173\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710501}\n\n--\n\nwpt-commits: cd4077727082fd04534bd1982ec9c9cd69eef5fc\nwpt-pr: 63230\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/animated-clip-path-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/animated-clip-path.tentative.html"], "git_node": "1ffef8bfdfb31962c850e0d49a604ac61c5037ee", "git_parents": ["284c280e8e1991c32d62f03e3f8ca9010b1bac6e"], "node": "059428d67674e5848f4a7497bc9ac604c317534e", "parents": ["9bfe86fb56407e607226dc9c054ed10b92baba51"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2077876 [wpt PR 63228] - Remove void element end tags from WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove void element end tags from WPTs\n\nimg, input, meta have no end tag. Writing \u003c/img\u003e, \u003c/meta\u003e or \u003c/input\u003e\nanyway is a parse error, and the parser drops the tag, so the source\nsuggests a structure the document never had. This CL removes these\ninvalid closing tags from WPT tests.\n\nBug: 542686202\nChange-Id: I830e0200c1614665e0e8632db447a00092821a71\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8222244\nReviewed-by: Brandon Walderman \u003cbrwalder@microsoft.com\u003e\nReviewed-by: Leo Lee \u003cleolee@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1710536}\n\n--\n\nwpt-commits: dcab91a96a4d199c6f7a1c1eeac67cbacc2d0c0a\nwpt-pr: 63228\n", "files": ["testing/web-platform/tests/event-timing/first-input-interactionid-key.html", "testing/web-platform/tests/event-timing/interaction-count-press-key.html", "testing/web-platform/tests/event-timing/keydown.html", "testing/web-platform/tests/event-timing/keyup.html", "testing/web-platform/tests/intersection-observer/v2/text-editor-occlusion.html", "testing/web-platform/tests/largest-contentful-paint/multiple-redirects-TAO.html", "testing/web-platform/tests/navigation-api/navigate-event/resources/meta-refresh.html", "testing/web-platform/tests/paint-timing/fcp-only/replaced-content-image.html", "testing/web-platform/tests/resource-timing/initiator-type/img-srcset.html", "testing/web-platform/tests/resource-timing/initiator-type/img.html", "testing/web-platform/tests/resource-timing/initiator-type/picture.html", "testing/web-platform/tests/resource-timing/resource-ignore-data-url.html", "testing/web-platform/tests/soft-navigation-heuristics/detection/tentative/text-node-modifications.html", "testing/web-platform/tests/soft-navigation-heuristics/smoke/tentative/image-src-change.html"], "git_node": "fc6a20a737868807c9e89b71a2b726b30d3f92a5", "git_parents": ["1ffef8bfdfb31962c850e0d49a604ac61c5037ee"], "node": "6e38415a93231004010e7c0bb73f08ed20b88b29", "parents": ["059428d67674e5848f4a7497bc9ac604c317534e"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2077912 [wpt PR 63231] - Clear SVG resource invalidation mask when performing cycle-check, a=testonly\n\nAutomatic update from web-platform-tests\nClear SVG resource invalidation mask when performing cycle-check\n\nThe invalidation mask could prevent invalidation of the SVGResource\ncycle-cache if an edge was introduced that caused a cycle before a\npaint that would clear the invalidation mask had happened.\n\nClear the invalidation mask in SVGResource before performing a\ncycle-check. Factor this into a new ResourceContainerForCycleCheck()\nfunction.\n\nFixed: 565674533\nChange-Id: I5c6ab97fdd3746e694271f5387b0fd684feceab7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8501797\nAuto-Submit: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710542}\n\n--\n\nwpt-commits: 989c64c1f46b91142c878f7e7ae7c6c869b52093\nwpt-pr: 63231\n", "files": ["testing/web-platform/tests/svg/crashtests/chrome-bug-565674533.html"], "git_node": "bbbcd3a4c1e13dc526d540e44a3eea5b447f5fc7", "git_parents": ["fc6a20a737868807c9e89b71a2b726b30d3f92a5"], "node": "8b5258c5d9a9ec812dcc52052e5a4fa7e0cf7e80", "parents": ["6e38415a93231004010e7c0bb73f08ed20b88b29"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077917 [wpt PR 63232] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325808, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(311393@main): Table cells after a width: 0 column are placed off-screen (#63232)\n\n\u003ctable style=\"width: 300px\"\u003e\n    \u003ctr\u003e\n      \u003ctd style=\"width: 20px\"\u003etext\u003c/td\u003e\n      ...\n      \u003ctd style=\"width: 0; padding: 0\"\u003e\u003c/td\u003e\n      \u003ctd style=\"width: 1%\"\u003etext\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/table\u003e\n\nThe last cell should be at the table's right edge. Instead it was placed at x = -33554152 (caused by NaN).\n\n311393@main stopped ignoring width: 0 on cells, making an empty 'width: 0' column (with no padding) a fixed column with a max width of 0.\nWhen AutoTableLayout::layout() distributes leftover width over fixed columns,\n1. first (and subsequent) columns use up totalFixed,\n2. the zero width column computes 0/0 = NaN and\n3. the last column gets pushed off-screen.\n\nThis is also a pre-existing bug: a positive width that rounds down to 0 in LayoutUnit (e.g. width: 0.001px) is not ignored either (see first test case).\n\nStop distributing when we run out of totalFixed space. The remaining fixed columns have a max width of 0, so they would get 0 anyway, and any width still left goes to the later passes (e.g. percent columns).\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325808\nWebKit-Canonical-Link: https://commits.webkit.org/322376@main\n\nCo-authored-by: Alan Baradlay \u003czalan@apple.com\u003e\n--\n\nwpt-commits: 172557b5048df2b9485d2e9bcadbcd95a096e537\nwpt-pr: 63232\n", "files": ["testing/web-platform/tests/css/css-tables/table-cell-tiny-width-excess-width-distribution-ref.html", "testing/web-platform/tests/css/css-tables/table-cell-tiny-width-excess-width-distribution.html", "testing/web-platform/tests/css/css-tables/table-cell-width-0-excess-width-distribution-ref.html", "testing/web-platform/tests/css/css-tables/table-cell-width-0-excess-width-distribution.html"], "git_node": "4b95c9fb4f0eaffe8a620b1ffc3ba3c6a336930e", "git_parents": ["bbbcd3a4c1e13dc526d540e44a3eea5b447f5fc7"], "node": "27698611af846591e67fabf7012ed49fe6b0b5b7", "parents": ["8b5258c5d9a9ec812dcc52052e5a4fa7e0cf7e80"], "tags": []}, {"author": "Charlie Lin \u003ctuug@gmx.us\u003e", "branch": "default", "desc": "Bug 2077368 [wpt PR 63170] - Update IDNA Test JSON to 18.0.0, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate IDNA Test JSON to Unicode 18.0.0\n--\n\nwpt-commits: 13748c36fdf9dd77cd0b34dd6b244256b365ea60\nwpt-pr: 63170\n", "files": ["testing/web-platform/tests/url/resources/IdnaTestV2.json"], "git_node": "1f58e8db452620dcf48f4d5e53e6079b3f1a30ef", "git_parents": ["4b95c9fb4f0eaffe8a620b1ffc3ba3c6a336930e"], "node": "9f4699063a90c8a1588d4bc3736e59b9d517b31f", "parents": ["27698611af846591e67fabf7012ed49fe6b0b5b7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077368 [wpt PR 63170] - Update wpt metadata, a=testonly\n\nwpt-pr: 63170\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/url/IdnaTestV2.any.js.ini"], "git_node": "a620b10f296b47f75165a672e2e9d0cad02c687b", "git_parents": ["1f58e8db452620dcf48f4d5e53e6079b3f1a30ef"], "node": "1101973db60094c2cb70affa009c6e8e0b8610a8", "parents": ["9f4699063a90c8a1588d4bc3736e59b9d517b31f"], "tags": []}, {"author": "Martin Robinson \u003cmartin@abandonedwig.info\u003e", "branch": "default", "desc": "Bug 2078009 [wpt PR 63238] - wpt: Bounce CSP errors to opener immediately in `navigation-support.js`, a=testonly\n\nAutomatic update from web-platform-tests\nwpt: Bounce CSP errors to opener immediately in `navigation-support.js`\n\nThis fixes an issue with the flakiness of this test for engines that do\nnot fire CSP errors synchronously when opening a WebSocket (Servo and\nWebKit namely). A previous version of this test had an immediate\nnotification, but it was removed in web-platform-tests/wpt#51758. That\ncommit removed the immediate notification because a violation was added\nas a marker. This change restores the immediate notification (leaving\nthe marker behavior), but does not bounce it if it's not on the list of\nviolations we are waiting for.\n\nSigned-off-by: Martin Robinson \u003cmartin@abandonedwig.info\u003e\n\n--\n\nwpt-commits: 8e9969fd5559dcff933a1cf4e62e9f5bc16b7231\nwpt-pr: 63238\n", "files": ["testing/web-platform/tests/trusted-types/support/navigation-support.js"], "git_node": "fa2cde4b8fc416396d68fc91d022cd05adeb68b3", "git_parents": ["a620b10f296b47f75165a672e2e9d0cad02c687b"], "node": "22cacc31bb22fbb0755a210c22d7fb564194a349", "parents": ["1101973db60094c2cb70affa009c6e8e0b8610a8"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078021 [wpt PR 63251] - [wpt] Unregister SW in update-no-cache-request-headers.https.html, a=testonly\n\nAutomatic update from web-platform-tests\n[wpt] Unregister SW in update-no-cache-request-headers.https.html\n\nAny later test running in the same browser session that loads a frame\nunder 'resources/' (such as waiting.https.html loading\nresources/blank.html) can end up controlled by this leaked worker,\ncausing unexpected failures.\n\nAdd a cleanup to unregister the registration so it does not outlive the\ntest.\n\nBug: 485854362\nChange-Id: Ieedd10c027a2e19da415ad499feba6d258105e9d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8510639\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nAuto-Submit: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCommit-Queue: Ari Chivukula \u003carichiv@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710904}\n\n--\n\nwpt-commits: e63fb1d81c023f9192548563d5e6f7561085d8d6\nwpt-pr: 63251\n", "files": ["testing/web-platform/tests/service-workers/service-worker/update-no-cache-request-headers.https.html"], "git_node": "0a337c030ca1190ea60ba432a6908e1f819a93d6", "git_parents": ["fa2cde4b8fc416396d68fc91d022cd05adeb68b3"], "node": "57beab27a0d92b10e6f46417f400cbe94932acd8", "parents": ["22cacc31bb22fbb0755a210c22d7fb564194a349"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078021 [wpt PR 63251] - Update wpt metadata, a=testonly\n\nwpt-pr: 63251\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/service-workers/service-worker/waiting.https.html.ini"], "git_node": "8e2f6d62c21a7d4891e3703be7f2619a968f113e", "git_parents": ["0a337c030ca1190ea60ba432a6908e1f819a93d6"], "node": "81dd585fe8cb8c4b0486741ccc74d18defa6338f", "parents": ["57beab27a0d92b10e6f46417f400cbe94932acd8"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078022 [wpt PR 63252] - [wpt] Unregister SW in controlled-dedicatedworker-postMessage.https.html, a=testonly\n\nAutomatic update from web-platform-tests\n[wpt] Unregister SW in controlled-dedicatedworker-postMessage.https.html\n\nfetch-mixed-content-to-inscope.https.html has been a deterministic\nCRASH (browser unresponsive at the 72s external timeout, PASS on retry)\non bots where it runs after controlled-dedicatedworker-postMessage in\nthe same browser session.\n\ncontrolled-dedicatedworker-postMessage.https.html registers\npostMessage-client-worker.js with the broad scope 'resources' and never\nunregisters it. The leaked worker then intercepts every navigation under\nresources/ from later tests; fetch-mixed-content-to-inscope's iframe\n(resources/fetch-mixed-content-iframe.html) never finishes loading and\nthe test hangs until it is killed.\n\nThis is the dedicated-worker twin of the controlled-iframe-postMessage\nfix (crrev.com/c/8512058). Narrow the scope to just the worker scripts\nthis test loads (scope matching is a prefix match) and add a final\nsubtest that unregisters the registration.\n\nRunning controlled-dedicatedworker-postMessage followed by\nfetch-mixed-content-to-inscope locally reproduced the CRASH every time\nbefore this change and passes after it.\n\nBug: 485854362\nChange-Id: Iadd1ca2df9d844721666010c017bec588843e85f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508031\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nAuto-Submit: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCommit-Queue: Ari Chivukula \u003carichiv@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710905}\n\n--\n\nwpt-commits: ebdb7f0a16d682887de7423bd1bcf87b64e70948\nwpt-pr: 63252\n", "files": ["testing/web-platform/tests/service-workers/service-worker/controlled-dedicatedworker-postMessage.https.html"], "git_node": "928e7a4ad9658720cf4bfe3266cb32374c987e1f", "git_parents": ["8e2f6d62c21a7d4891e3703be7f2619a968f113e"], "node": "4b2355064e807cf61548998a9c5dcb3f2f063e64", "parents": ["81dd585fe8cb8c4b0486741ccc74d18defa6338f"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078023 [wpt PR 63253] - [wpt] Unregister SW in update-module-request-mode.https.html, a=testonly\n\nAutomatic update from web-platform-tests\n[wpt] Unregister SW in update-module-request-mode.https.html\n\nwaiting.https.html has been flaky (deterministic FAIL then PASS on\nretry) on bots where it runs after update-module-request-mode.https.html\nin the same browser session. The failure is:\n\nFAIL waiting is set after installation - assert_equals: controller\n  expected null but got object \"[object ServiceWorker]\"\n\nupdate-module-request-mode.https.html registers a worker with the broad\nscope 'resources/' and never unregisters it. waiting.https.html then\nloads an iframe at resources/blank.html, which gets controlled by that\nleaked worker; its own service_worker_unregister() call only unregisters\nregistrations whose scope exactly matches 'resources/blank.html', so the\nleak isn't cleaned up.\n\nBug: 485854362\nChange-Id: I16072fa337795ea02aac57828b0ac78c803dcf1e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8510285\nAuto-Submit: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCommit-Queue: Ari Chivukula \u003carichiv@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710906}\n\n--\n\nwpt-commits: 1cdea7e1736d0e1c283b9ec4de732979836782fc\nwpt-pr: 63253\n", "files": ["testing/web-platform/tests/service-workers/service-worker/update-module-request-mode.https.html"], "git_node": "02601ad83e9dfe26715a80c2ca89a996f7414834", "git_parents": ["928e7a4ad9658720cf4bfe3266cb32374c987e1f"], "node": "775bc92e0ecbe88ec67c879000c911440b664c4b", "parents": ["4b2355064e807cf61548998a9c5dcb3f2f063e64"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078026 [wpt PR 63254] - [wpt] Unregister SW in controlled-iframe-postMessage.https.html, a=testonly\n\nAutomatic update from web-platform-tests\n[wpt] Unregister SW in controlled-iframe-postMessage.https.html\n\nThe test registered postMessage-client-worker.js with the broad scope\n'resources' and never unregistered it. The leaked worker then\nintercepted navigations under resources/ made by later tests in the\nsame browser session; in fetch-response-taint.https.html the login\niframe never loaded, causing a deterministic 60s TIMEOUT on first run\n(and PASS on retry with a fresh profile) on Mac13 and Win11 bots.\n\nUse service_worker_unregister_and_register(), narrow the scope to the\nframe the test actually uses, and unregister when done.\n\nBug: 485854362, 504634457\nChange-Id: Ibb5aef9e19110adb01ced61c1197a430ab35de57\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8512058\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710907}\n\n--\n\nwpt-commits: c8d16c7002e5c72e96ff513b7231f7696ef992d5\nwpt-pr: 63254\n", "files": ["testing/web-platform/tests/service-workers/service-worker/controlled-iframe-postMessage.https.html"], "git_node": "bf2c828a297a8f91161e1ca7670f1345c55d75d9", "git_parents": ["02601ad83e9dfe26715a80c2ca89a996f7414834"], "node": "d220bd3df2402439a2b7fc0c66ad8b93efcdef09", "parents": ["775bc92e0ecbe88ec67c879000c911440b664c4b"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078029 [wpt PR 63256] - [wpt] Deflake bidi/browsing_context/user_prompt_opened/beforeunload.py, a=testonly\n\nAutomatic update from web-platform-tests\n[wpt] Deflake bidi/browsing_context/user_prompt_opened/beforeunload.py\n\nThe test cancelled the pending `browsingContext.navigate` task after\nreceiving `userPromptOpened`. Since beforeunload prompts are accepted by\ndefault, the navigation can still succeed before the tab is closed in\nthe `new_tab` fixture teardown. In that case the WPT BiDi client calls\n`set_result()` on the cancelled future, which raises InvalidStateError\nand terminates the websocket reader task, so the `browsingContext.close`\nresponse is never processed and the test hangs until the harness\ntimeout.\n\nAwait the navigation instead so that no command is pending at teardown.\nLocally this went from ~4/25 timeouts to 0/40.\n\nBug: 565888355, 568343392\nChange-Id: If705703539cb8b1be6c7ee4faa1ae63d3486189d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8512617\nCommit-Queue: Ari Chivukula \u003carichiv@chromium.org\u003e\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nAuto-Submit: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710925}\n\n--\n\nwpt-commits: 1b0b707288d5c67de135daa6d626640282b20122\nwpt-pr: 63256\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browsing_context/user_prompt_opened/beforeunload.py"], "git_node": "db9953f687d5b02ffada25228b26fd49b79cfe95", "git_parents": ["bf2c828a297a8f91161e1ca7670f1345c55d75d9"], "node": "c8c391c20516bed3ba187c12196d4efdec5a6bb1", "parents": ["d220bd3df2402439a2b7fc0c66ad8b93efcdef09"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078029 [wpt PR 63256] - Update wpt metadata, a=testonly\n\nwpt-pr: 63256\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/user_prompt_opened/beforeunload.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/user_prompt_opened/user_context_tentative.py.ini"], "git_node": "40ee99ed085a04897b7fba689fe0dd4881e1ff1b", "git_parents": ["db9953f687d5b02ffada25228b26fd49b79cfe95"], "node": "fe949edd83238ced59f2421838eade66ee3d14f1", "parents": ["c8c391c20516bed3ba187c12196d4efdec5a6bb1"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078066 [wpt PR 63259] - Deflake transition-shape-outside-crash.html, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake transition-shape-outside-crash.html\n\nThe crashtest waits for a `transitionend` event on an `\u003cinput\u003e` element\nwith `autofocus` and `shape-outside: padding-box`, relying on `autofocus`\nmatching `:focus-visible` and changing the UA `outline` style to trigger\na CSS transition. If focus or `:focus-visible` does not produce a style\nchange (e.g., when the frame is not focused), no transition starts and\nthe test times out.\n\nExplicitly flush the initial style and change `color` via a class so a\nCSS transition on the element is guaranteed to run and fire\n`transitionend` regardless of focus state, while still exercising the\n`BaseComputedStyle` comparison for `shape-outside: padding-box`.\n\nBug: 485677942\nChange-Id: I85bc4d41581dd0d645908a073aca742987fd9ac3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8512417\nAuto-Submit: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710933}\n\n--\n\nwpt-commits: 564b9b1eb1387ef42456f1cba77d2d38599fad61\nwpt-pr: 63259\n", "files": ["testing/web-platform/tests/css/css-transitions/crashtests/transition-shape-outside-crash.html"], "git_node": "ca02e7f3aa00cc82f3019cd1068865af14a5b83c", "git_parents": ["40ee99ed085a04897b7fba689fe0dd4881e1ff1b"], "node": "12620292a72ac4f0f2f2c42952ef7fc0ab7a5538", "parents": ["fe949edd83238ced59f2421838eade66ee3d14f1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078066 [wpt PR 63259] - Update wpt metadata, a=testonly\n\nwpt-pr: 63259\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-transitions/crashtests/clear-duration-in-transitionend.html.ini"], "git_node": "e039d011a9eae75c415b8edc0aa4e4b230128f03", "git_parents": ["ca02e7f3aa00cc82f3019cd1068865af14a5b83c"], "node": "b6546f203985b12f2e311ff60773ca333fce0b20", "parents": ["12620292a72ac4f0f2f2c42952ef7fc0ab7a5538"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2078040 [wpt PR 63248] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326255, a=testonly\n\nAutomatic update from web-platform-tests\nImplement the cross-origin-isolated permissions policy feature\n\nA document's cross-origin isolated capability requires both that its agent\ncluster is cross-origin isolated and that the document is allowed to use the\n\"cross-origin-isolated\" feature, whose default allowlist is 'self'. We did not\nimplement the feature, so every cross-origin iframe in a cross-origin isolated\npage reported crossOriginIsolated as true and could serialize\nSharedArrayBuffers, without the embedder delegating that capability through\nallow=\"cross-origin-isolated\".\n\nWe do not support the Permissions-Policy header, so the subtests that rely on\nit to disable the feature remain failures.\n\nUpdate window-failure.https.html from upstream, which delegates the capability\nto its cross-site iframe so the failure is due to the agent cluster mismatch.\nDo the same for the cross-site iframe in the API test added in 322609@main.\n\nwindow-domain-failure.https.sub.html expected SharedArrayBuffer to be absent in\na cross-origin iframe of a cross-origin isolated page. HTML only removes it\nwhen the agent cluster's cross-origin isolation mode is \"none\", which is not\nthe case there, so it now expects it to be present. In particular the capability\nis not a factor.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326255\n\n--\n\nwpt-commits: 136ecd8cc9e611303e593f0c9e57070b29164b19\nwpt-pr: 63248\n", "files": ["testing/web-platform/tests/html/infrastructure/safe-passing-of-structured-data/shared-array-buffers/window-domain-failure.https.sub.html"], "git_node": "ef3d909ae84c1011658eb20c66563a73f1aac81d", "git_parents": ["e039d011a9eae75c415b8edc0aa4e4b230128f03"], "node": "c8801620452cd0a6417a12a20a87c6b3a47e8f70", "parents": ["b6546f203985b12f2e311ff60773ca333fce0b20"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2078046 [wpt PR 63250] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326092, a=testonly\n\nAutomatic update from web-platform-tests\n\u003cselect\u003e computes its selected option's style from outdated ancestor styles\n\nSelectFallbackButtonElement::resolveCustomStyle() copies direction and\nunicode-bidi from the selected option. The popover holding the options\ncomes after the button slot in the shadow tree, so style resolution has\nnot reached the option at that point, and options have no renderer\nunless a base appearance picker is open. The button therefore resolved\nthe option's style on demand through computedStyleForEditability(),\nwhich starts from the existing styles of the option's ancestors.\n\nBefore 306393@main RenderMenuList did that outside of style resolution.\nSince then it happens during style resolution, where those styles are\nout of date: new styles only reach the renderers once the whole tree is\nresolved, so elements inserted since the last update have no style yet\nand the others still have their old one. The option's style was thus\ncomputed from an old ancestor style and cached on every element in\nbetween, including ones style resolution had already passed. As those\ncaches take precedence over renderer styles, getComputedStyle() returned\nold values for the select and its ancestors up to the inserted subtree's\nroot until they were restyled, and so did anything reading the select's\nexistingComputedStyle(), such as usesBaseAppearancePicker(). When an\nancestor's direction changed, the fallback button ended up with the\nprevious direction.\n\nInstead resolve the option's style starting from the host style passed\nto resolveCustomStyle(), through the option's composed tree ancestors\nbelow the select, without caching anything. That costs at least three\nstyle resolutions each time the button is resolved: the popover, its\nslot and the option. A dir change on the root element already restyles\n6+N elements of a select with N options.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326092\n\n--\n\nwpt-commits: e80a2fcedb44dc749675f8482c442b5c86e17aa3\nwpt-pr: 63250\n", "files": ["testing/web-platform/tests/html/rendering/widgets/the-select-element/select-dir-invalidation-ref.html", "testing/web-platform/tests/html/rendering/widgets/the-select-element/select-dir-invalidation.html", "testing/web-platform/tests/html/rendering/widgets/the-select-element/select-optgroup-dir-invalidation-ref.html", "testing/web-platform/tests/html/rendering/widgets/the-select-element/select-optgroup-dir-invalidation.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-insertion-inherited-style.html"], "git_node": "9ee7a58df24f25a3311546b3b45a839c1869ad72", "git_parents": ["ef3d909ae84c1011658eb20c66563a73f1aac81d"], "node": "6aacf7340a9dece12831023354f5f1028757291f", "parents": ["c8801620452cd0a6417a12a20a87c6b3a47e8f70"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2077949 [wpt PR 63235] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325152, a=testonly\n\nAutomatic update from web-platform-tests\n:open stops matching a select whose base appearance picker is still showing\n\n:open was a flag shared by the native popup menu and the base appearance picker, and\ndidDetachRenderers() cleared it. That is right for the native popup, which goes away with the\nrenderers, but not the popover. So a display change, moveBefore(), setting size to 1, or a :open\nrule that changes display left the picker showing while :open stopped matching. The flag changed\nduring a render tree update, where invalidation is dropped, so :has() and sibling rules went stale\nas well.\n\n:open is now derived. While the picker popover is showing, the select matches :open as long as it\nsupports a base appearance picker, which only its attributes decide. Otherwise :open follows the\nnative popup flag. SelectPopoverElement invalidates the select's :open when its visibility state\nchanges, and setSizeAndMultiple() does so when a size or multiple change makes an open picker stop\nor start counting. Accessibility and internals.isSelectPopupVisible() use the same answer.\n\nA truthful :open showed where the picker did not actually close:\n- didRecalcStyle() compared the select's appearance against its committed style, which is not\n  updated yet at that point. So changing the select's own appearance, for instance through inline\n  style, never closed the picker. The select and its picker popover now both check from\n  didAttachRenderers(), through closePickerIfNoLongerBaseAppearance(), which needs no record of\n  the previous appearance.\n- With HTMLEnhancedSelectMultipleAndListBoxEnabled off, setting multiple on a select whose size is\n  1 left the picker open.\n- Script run by hiding other popovers while the picker opens can make the select a list box.\n  showPickerInternal() now checks once more after showing the picker, which also takes over the\n  :open appearance checks that showPicker() and openPickerForUserInteraction() each made.\n- The queued close re-checks whether the picker still has to close. A change undone within the\n  same task now leaves the picker open, and one close logs one warning.\n- popoverWasHidden() now runs at the end of hidePopoverInternal(), so :open no longer matches\n  during the focus events it causes. This matches Chrome.\n\nA size or multiple change no longer queues an appearance close next to the dropdown box one, so iOS\nstops logging a second warning and no longer needs its own baselines for the box type tests. Three\ncustomizable-select tests that iOS expected to fail now pass there as well.\n\nThis also fixes a crash in showPopup() when a :open rule rebuilds the renderer of a native select.\n\nhttps://github.com/whatwg/html/issues/13027 proposes specifying when the picker closes once it can\nno longer be shown. switch-picker-appearance.html no longer assumes the close is synchronous, and\nswitch-picker-appearance-timing.tentative.html tests the proposal.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325152\n\n--\n\nwpt-commits: 192f07310695937db846026754392cfaef13c87f\nwpt-pr: 63235\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-pseudo-open-display.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-pseudo-open-move-remove.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-pseudo-open-size.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-pseudo-open-top-layer.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/switch-picker-appearance-timing.tentative.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/switch-picker-appearance.html"], "git_node": "62d9f38646f9edc441495718b0cae9d8f14eb2e3", "git_parents": ["9ee7a58df24f25a3311546b3b45a839c1869ad72"], "node": "11a005550eda654b274ffad17b8da9c9e62ccc0f", "parents": ["6aacf7340a9dece12831023354f5f1028757291f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077949 [wpt PR 63235] - Update wpt metadata, a=testonly\n\nwpt-pr: 63235\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-pseudo-open-move-remove.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-pseudo-open-size.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/switch-picker-appearance-timing.tentative.html.ini"], "git_node": "0dde6f9dcd2f3c7230ed1b58ebfacc384c4d0ca0", "git_parents": ["62d9f38646f9edc441495718b0cae9d8f14eb2e3"], "node": "efcccd05ac8963782cf1224eaa72de6681c5f5df", "parents": ["11a005550eda654b274ffad17b8da9c9e62ccc0f"], "tags": []}, {"author": "G\u00e9rald Barr\u00e9 \u003cgit@meziantou.net\u003e", "branch": "default", "desc": "Bug 2078082 [wpt PR 63262] - HTML parser: test that search is in the special category, a=testonly\n\nAutomatic update from web-platform-tests\nHTML parser: test that search is in the special category\n\n--\n\nwpt-commits: 784112f08ab2918960a76fbb499cc9f32f67726f\nwpt-pr: 63262\n", "files": ["testing/web-platform/tests/html/syntax/parsing/resources/search-element.dat"], "git_node": "277c48daf912ba41ac8e915d699f80a17255d5a6", "git_parents": ["0dde6f9dcd2f3c7230ed1b58ebfacc384c4d0ca0"], "node": "56c6ae4aada4b46bf90ac096048178b8daa6d5a4", "parents": ["efcccd05ac8963782cf1224eaa72de6681c5f5df"], "tags": []}, {"author": "Sergey Rubanov \u003cchi187@gmail.com\u003e", "branch": "default", "desc": "Bug 2076637 [wpt PR 63086] - [wasm] customSections returns independent copies, a=testonly\n\nAutomatic update from web-platform-tests\n[wasm] customSections returns independent copies (#63086)\n\nMutating an ArrayBuffer from Module.customSections does not change a\nlater result or another buffer from the same section.\n--\n\nwpt-commits: 25124fb10060fd038ec70094902d1190a8260f4e\nwpt-pr: 63086\n", "files": ["testing/web-platform/tests/wasm/jsapi/module/customSections.any.js"], "git_node": "62c706653bb935043c37a127233082cd325853d2", "git_parents": ["277c48daf912ba41ac8e915d699f80a17255d5a6"], "node": "6581947fc303a848b2b35b1d0f96cc05feb5c19f", "parents": ["56c6ae4aada4b46bf90ac096048178b8daa6d5a4"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077561 [wpt PR 63205] - Update CODEOWNERS, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated update of CODEOWNERS\n\n--\n\nwpt-commits: 670703cd82a900ecb62327c205f7e2fd7911dc84\nwpt-pr: 63205\n", "files": ["testing/web-platform/tests/CODEOWNERS"], "git_node": "305480ba5094b11609af5972ca3d883e968e61ad", "git_parents": ["62c706653bb935043c37a127233082cd325853d2"], "node": "2ef79d926e06d2b0a2fa056fdfe45f770f6986ee", "parents": ["6581947fc303a848b2b35b1d0f96cc05feb5c19f"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2078077 [wpt PR 63261] - Activate the ital axis for variable font italics, a=testonly\n\nAutomatic update from web-platform-tests\nActivate the ital axis for variable font italics\n\nPass the authored font-style syntax into variable font instantiation so\nitalic and oblique select the correct registered axes.\n\nBug: 40681464\nChange-Id: I1a718bd28b43f48d3f092c6dd49fd21e20c3e6df\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8179764\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1710996}\n\n--\n\nwpt-commits: da1f6d20caf40b4003ae288dda8c97f252dd9264\nwpt-pr: 63261\n", "files": ["testing/web-platform/tests/css/css-fonts/variations/ital-variable-ref.html", "testing/web-platform/tests/css/css-fonts/variations/ital-variable.html", "testing/web-platform/tests/css/css-fonts/variations/resources/FontStyleTest-ital-VF.woff2", "testing/web-platform/tests/css/css-fonts/variations/resources/FontStyleTest-slnt_ital-VF.woff2"], "git_node": "190d80a48cf520e657442b3d78976fa59644edd5", "git_parents": ["305480ba5094b11609af5972ca3d883e968e61ad"], "node": "7976f786bfcb5c00bbf6da1e36f97d0e4965309a", "parents": ["2ef79d926e06d2b0a2fa056fdfe45f770f6986ee"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078077 [wpt PR 63261] - Update wpt metadata, a=testonly\n\nwpt-pr: 63261\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-fonts/variations/ital-variable.html.ini"], "git_node": "5c34797d26e55742e6d7f625d183ada945d273be", "git_parents": ["190d80a48cf520e657442b3d78976fa59644edd5"], "node": "27a4258cd88afab18342bf33fe320405db30c52f", "parents": ["7976f786bfcb5c00bbf6da1e36f97d0e4965309a"], "tags": []}, {"author": "G\u00e9rald Barr\u00e9 \u003cmeziantou@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078088 [wpt PR 63263] - HTML parser: test that U+FFFD sets frameset-ok to \"not ok\", a=testonly\n\nAutomatic update from web-platform-tests\nHTML parser: test that U+FFFD sets frameset-ok to \"not ok\"\n--\n\nwpt-commits: 9710d2af7737513c93d823fddf364c36b2574c4c\nwpt-pr: 63263\n", "files": ["testing/web-platform/tests/html/syntax/parsing/resources/tests19.dat"], "git_node": "008cc1181bbe26b30c9f913cdc072083656f1951", "git_parents": ["5c34797d26e55742e6d7f625d183ada945d273be"], "node": "0bcbd47323c2baf967010bb2b95aa43502809f2a", "parents": ["27a4258cd88afab18342bf33fe320405db30c52f"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078064 [wpt PR 63258] - Deflake external/wpt/touch-events/single-touch-vertical-rl.html, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake external/wpt/touch-events/single-touch-vertical-rl.html\n\nThis test has two failure modes that both manifest as test timeouts:\n\n1. Pre-commit touch input suppression / un-committed touch listener\n   properties: Sending touch actions immediately inside `window.onload`\n   can race with the first compositor frame (`WidgetInputHandlerManager`\n   drops input before the first paint) as well as with the commit that\n   propagates `EventListenerClass::kTouchStartOrMove` from\n   `EventHandlerRegistry` to the compositor's active tree\n   (`InputHandlerProxy::HitTestTouchEvent` drops `TouchStart` if the\n   active tree still has `kNone`). Waiting for\n   `waitTillReadyForTouchInput()` after registering the `touchstart`\n   listener and before calling `actions.send()` ensures a compositor\n   frame is committed and produced with the listener properties active.\n\n2. Unhandled assertion errors in `onEvent` and vestigial `explicit_done`:\n   `onEvent()` invoked `validator(event)` inside a raw DOM event listener\n   without catching exceptions. If an assertion failed, `resolve()` was\n   skipped and the returned promise never settled. Additionally,\n   `setup({explicit_done: true})` and `done()` after `await Promise.all`\n   caused any promise rejection to skip `done()`, hanging the harness\n   until timeout. Wrapping `validator(event)` in `try/catch` to call\n   `reject(e)` and removing the unnecessary `explicit_done`/`done()`\n   allows assertion failures to fail immediately.\n\nBug: 499752810, 417428652\nChange-Id: I99056ee637e6812596b12f94e03a04c9137955c1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8512377\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711192}\n\n--\n\nwpt-commits: cce39f4f40895399efe26e5dfa51ddaaab12d48a\nwpt-pr: 63258\n", "files": ["testing/web-platform/tests/touch-events/single-touch-vertical-rl.html"], "git_node": "1f0519f0862dee762c3d5730eb359bfc0f398d5f", "git_parents": ["008cc1181bbe26b30c9f913cdc072083656f1951"], "node": "67b2b47c23f12db5845fd694498c7989b210aaec", "parents": ["0bcbd47323c2baf967010bb2b95aa43502809f2a"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2078011 [wpt PR 63239] - HTML: COOP and COEP report-to must be a string, a=testonly\n\nAutomatic update from web-platform-tests\nHTML: COOP and COEP report-to must be a string\n\nFor https://github.com/whatwg/html/issues/11365#issuecomment-5665100293.\n\n--\n\nwpt-commits: 39ea66c5fa2179942e3735f490220b77493a2866\nwpt-pr: 63239\n", "files": ["testing/web-platform/tests/html/cross-origin-embedder-policy/reporting-report-to-must-be-string.https.window.js", "testing/web-platform/tests/html/cross-origin-opener-policy/reporting/navigation-reporting/reporting-popup-report-to-must-be-string.https.html", "testing/web-platform/tests/html/cross-origin-opener-policy/reporting/navigation-reporting/reporting-popup-report-to-must-be-string.https.html.sub.headers"], "git_node": "9810f022e2dd242843325b6b32ab17e3b266b70a", "git_parents": ["1f0519f0862dee762c3d5730eb359bfc0f398d5f"], "node": "1c572a31b8867dcde6cb4cf178216d4fba1cf1bc", "parents": ["67b2b47c23f12db5845fd694498c7989b210aaec"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078011 [wpt PR 63239] - Update wpt metadata, a=testonly\n\nwpt-pr: 63239\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/cross-origin-embedder-policy/reporting-report-to-must-be-string.https.window.js.ini"], "git_node": "a4b16b9269b068853e44948f30b0c8cc16d9ffda", "git_parents": ["9810f022e2dd242843325b6b32ab17e3b266b70a"], "node": "b9edc6ffc64a72b52ea8f5b242689e9593b0f065", "parents": ["1c572a31b8867dcde6cb4cf178216d4fba1cf1bc"], "tags": []}, {"author": "mxmgorin \u003c102797145+mxmgorin@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078297 [wpt PR 63280] - webgl: Read WebGL 2 *_BITS from the draw framebuffer attachments, a=testonly\n\nAutomatic update from web-platform-tests\nwebgl: Read WebGL 2 *_BITS from the draw framebuffer attachments\n\nSigned-off-by: mxmgorin \u003c102797145+mxmgorin@users.noreply.github.com\u003e\n\n--\n\nwpt-commits: f305c26113152585c5b44661e2427a821b04ee94\nwpt-pr: 63280\n", "files": ["testing/web-platform/tests/webgl/webgl2-drawing-buffer-bits.html"], "git_node": "8f020054b885bd0d79edfcc538ede36b9b55385b", "git_parents": ["a4b16b9269b068853e44948f30b0c8cc16d9ffda"], "node": "125969b6fd73ef52b75a50d9b4d3106e96d20a9d", "parents": ["b9edc6ffc64a72b52ea8f5b242689e9593b0f065"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078211 [wpt PR 63272] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325429, a=testonly\n\nAutomatic update from web-platform-tests\n[Style] The overscroll-behavior shorthand serializes max(x, y) instead of both axis values in getComputedStyle (#63272)\n--\n\nwpt-commits: a0104ed8ce6a2ea8c6085335dd4d7c9288559b36\nwpt-pr: 63272\n", "files": ["testing/web-platform/tests/css/css-overscroll-behavior/parsing/overscroll-behavior-computed.html"], "git_node": "a637aa28d9a65d413427cc92b51ce7a9bd040a14", "git_parents": ["8f020054b885bd0d79edfcc538ede36b9b55385b"], "node": "d49ec9337e802e84843c35c9dc41bb66b8e8b89f", "parents": ["125969b6fd73ef52b75a50d9b4d3106e96d20a9d"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078208 [wpt PR 63271] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325287, a=testonly\n\nAutomatic update from web-platform-tests\n@scope start (scoping root) selector matching drops style relations, so structural DOM mutations don't invalidate scope membership (#63271)\n--\n\nwpt-commits: 022ad216edff8b91fddd871b2472dea7c58ee11a\nwpt-pr: 63271\n", "files": ["testing/web-platform/tests/css/css-cascade/scope-invalidation.html"], "git_node": "1c215f14f5fa52efab1ce0cc28afffaf1cd8e142", "git_parents": ["a637aa28d9a65d413427cc92b51ce7a9bd040a14"], "node": "127c01fd8fe377349bbd7df616be5025e64602d6", "parents": ["d49ec9337e802e84843c35c9dc41bb66b8e8b89f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078208 [wpt PR 63271] - Update wpt metadata, a=testonly\n\nwpt-pr: 63271\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-cascade/inline-style-revert-layer-crash.html.ini"], "git_node": "9df241845103fea3aa35654449f92447aa7354c8", "git_parents": ["1c215f14f5fa52efab1ce0cc28afffaf1cd8e142"], "node": "cb1af9c28566d5f9a6fdcb8c235bb3e225f3bd8b", "parents": ["127c01fd8fe377349bbd7df616be5025e64602d6"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078199 [wpt PR 63270] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324997, a=testonly\n\nAutomatic update from web-platform-tests\nTree-scoped var() and custom-function references inside an @function fail to resolve when the function is called from a :host rule (#63270)\n--\n\nwpt-commits: b2b18ad6bd678f673fb715c2f3ac4db42ec573c5\nwpt-pr: 63270\n", "files": ["testing/web-platform/tests/css/css-mixins/functions/function-shadow.html"], "git_node": "79727264abf2b56673426ac0fcca560bf14e2df7", "git_parents": ["9df241845103fea3aa35654449f92447aa7354c8"], "node": "f49f6c3358dbe909fafa0eb89d7ded3474c950a0", "parents": ["cb1af9c28566d5f9a6fdcb8c235bb3e225f3bd8b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078199 [wpt PR 63270] - Update wpt metadata, a=testonly\n\nwpt-pr: 63270\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/functions/function-shadow.html.ini"], "git_node": "9befc850d254bc988d481f43f4d9bb3203bce73e", "git_parents": ["79727264abf2b56673426ac0fcca560bf14e2df7"], "node": "871ab4eb4f27db6fbeb91e9d5b1c613ffc1efceb", "parents": ["f49f6c3358dbe909fafa0eb89d7ded3474c950a0"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078181 [wpt PR 63269] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=309041, a=testonly\n\nAutomatic update from web-platform-tests\nSVG elements inside hidden containers should not be focusable (#63269)\n--\n\nwpt-commits: d792d484df767995351c436f88395d54d41824a0\nwpt-pr: 63269\n", "files": ["testing/web-platform/tests/svg/interact/focus-inside-hidden-svg-containers-04.html"], "git_node": "f61afe978449d096400cdbcda2c07c3f812b539f", "git_parents": ["9befc850d254bc988d481f43f4d9bb3203bce73e"], "node": "0c6eccc9d5e07ae935c2e7abc5c617feefa135f6", "parents": ["871ab4eb4f27db6fbeb91e9d5b1c613ffc1efceb"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2078296 [wpt PR 63278] - Sanitizer: place children of replaceWithChildren elements correctly, a=testonly\n\nAutomatic update from web-platform-tests\nSanitizer: place children of replaceWithChildren elements correctly\n\nWhen the streaming sanitizer replaces an open element with its children\n(replaceWithChildrenElements), nodes parsed under it have to be inserted\nwhere that element would have been, not merely under its parent. This\nwent wrong in a few cases exercised by setHTML()/setHTMLUnsafe():\n\n- Foster parenting: an unwrapped element that was itself foster-parented\n  (e.g. \u003ctable\u003e\u003cdiv\u003e\u2026\u003c/div\u003e\u003ctd\u003e) lost its insertion point, so its\n  children ended up after the table instead of before it; and a table\n  whose parent is unwrapped foster-parented text into the wrong node.\n- \u003ctemplate\u003e: a template has no light-tree children, so replacing it\n  with its children must drop its contents rather than hoist them into\n  the parent. This matches Sanitizer::ReplaceWithChildren for already\n  parsed trees and the existing sanitizer-api tree-construction cases\n  (whose failing baseline is now removed).\n- A declarative shadow root inside an unwrapped element must not be\n  attached on behalf of that element.\n- OwnerDocumentForCurrentNode and the custom element registry lookup now\n  resolve through unwrapped elements to the real intended parent.\n\nHTMLStackItem now records the replaced insertion location (parent and\nnext child) when a foster-parented element is unwrapped, and\nHTMLConstructionSite::AdjustInsertionLocation / FindFosterSite /\nCreateElement consult it. ShouldInsertChild takes the adjusted location.\n\nNew sanitizer-api WPT coverage uses setHTML()/setHTMLUnsafe(). The\nstreamHTML() counterparts (stream-html-sanitizer.html, plus the scoped\ncustom element registry case in stream-html-custom-element.html, which\nsetHTMLUnsafe() cannot exercise yet, see crbug.com/569832084) are\nincluded too, since they are fixed by this same change.\n\nBug: 569831431, 491743369\nChange-Id: I75d3930029c7d68fad8b7dea4c6e4d85f831d628\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8512657\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711249}\n\n--\n\nwpt-commits: cce6e21bd21055f3a2c202ddc0f04413922d0565\nwpt-pr: 63278\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-html-custom-element.html", "testing/web-platform/tests/domparsing/tentative/stream-html-sanitizer.html", "testing/web-platform/tests/sanitizer-api/sethtml-replace-with-children.html", "testing/web-platform/tests/sanitizer-api/sethtml-tree-construction.sub.dat"], "git_node": "b3108fa26a5fdfc09a0faa92385384430fe06ad4", "git_parents": ["f61afe978449d096400cdbcda2c07c3f812b539f"], "node": "a42e0d707c5f3dd39d473ab3cb646eeae860776b", "parents": ["0c6eccc9d5e07ae935c2e7abc5c617feefa135f6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078296 [wpt PR 63278] - Update wpt metadata, a=testonly\n\nwpt-pr: 63278\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-html-custom-element.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-sanitizer.html.ini"], "git_node": "ae54fb1a1301313f22689ad878e058abed3875b7", "git_parents": ["b3108fa26a5fdfc09a0faa92385384430fe06ad4"], "node": "cc5164dbbe7894bdbf3605b8a511f0976891955c", "parents": ["a42e0d707c5f3dd39d473ab3cb646eeae860776b"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077015 [wpt PR 63143] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321948, a=testonly\n\nAutomatic update from web-platform-tests\n[Grid Lanes] Rename flow-tolerance to fit-tolerance (#63143)\n\nThe CSSWG resolved to rename the flow-tolerance property to fit-tolerance\n(https://github.com/w3c/csswg-drafts/issues/10884), so rename it here, along\nwith the Style::FlowTolerance value type and the GridData member that stores it.\n\nflow-tolerance is kept as an alias so that content written against the old name\nkeeps working. This is a temporary measure and will likely be removed at\nsome point in the future. To help facilitate this process we show a\ndeprecation warning in the web inspector. When the old name is used the\nweb inspector will show a warning icon next to the declaration and a\nhover will inform the user that the property name is deprecated.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321948\nWebKit-Canonical-Link: https://commits.webkit.org/319795@main\n--\n\nwpt-commits: 6aed1d11156fd6f818799d59c47d8f69ecde86a3\nwpt-pr: 63143\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/animation/fit-tolerance-interpolation.html", "testing/web-platform/tests/css/css-grid/grid-lanes/animation/flow-tolerance-interpolation.html"], "git_node": "cd6cf234b78521173be521cb4a5b9291c4152cf4", "git_parents": ["ae54fb1a1301313f22689ad878e058abed3875b7"], "node": "099bfafb29626675c8c8ae7859fe38fd51ed1370", "parents": ["cc5164dbbe7894bdbf3605b8a511f0976891955c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077015 [wpt PR 63143] - Update wpt metadata, a=testonly\n\nwpt-pr: 63143\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/animation/fit-tolerance-interpolation.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/animation/flow-tolerance-interpolation.html.ini"], "git_node": "1463c98aeaea35b3a1809e13f3a8cb754057db0d", "git_parents": ["cd6cf234b78521173be521cb4a5b9291c4152cf4"], "node": "0ab092f3f19a49606094f344c461a36cec038feb", "parents": ["099bfafb29626675c8c8ae7859fe38fd51ed1370"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077011 [wpt PR 63140] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325684, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=325684 (#63140)\n\n* Convert some fast/css-grid-layout tests to WPT checkLayout tests\n\nThese legacy check-layout tests in fast/css-grid-layout cover cases that\nare missing from WPT and need only mechanical changes to become WPT\ntestharness tests. Convert them and remove the legacy versions.\n\nThree more legacy tests overlap existing WPT tests but check cases they\ndo not (see below), so they are rewritten as new WPT testharness tests:\ngrid-item-margin-auto-columns-rows-vertical-ltr (a reftest),\nrelayout-align-items-changed and relayout-justify-items-changed.\n\nIn the mechanical conversions, the data-* expectations and test styles\nare unchanged. A few markup cleanups do not affect what the tests check:\nundefined or misspelled classes (fixedWidth, fixedHeight, border,\njustfyContentStart) and a duplicate \u003cbody\u003e tag are dropped, mistyped\n\u003c/div--\u003e end tags and unclosed wrapper divs are fixed, and descriptions\nare reworded.\n\nThe relayout-{align,justify}-{items,self}-changed tests are each split\ninto two grid-alignment-implies-size-change tests (037 to 044), one for\neach change the legacy test made. Each checks size and position both\nbefore and after the change.\n\ngrid-auto-columns-rows-auto-flow-resolution had a doctype that put it in\nquirks mode; the WPT version runs in standards mode with the same\nresults. quirks-mode-percent-resolution-grid-item stays in quirks mode on\npurpose.\n\nRemoved test (fast/css-grid-layout/) -\u003e new WPT test (css/css-grid/):\n\nauto-content-resolution-columns -\u003e layout-algorithm/grid-auto-columns-content-resolution-001\nauto-content-resolution-rows -\u003e layout-algorithm/grid-auto-rows-content-resolution-001\ngrid-auto-columns-rows-auto-flow-resolution -\u003e implicit-grids/grid-auto-columns-rows-auto-flow-resolution-001\ngrid-auto-columns-rows-resolution -\u003e implicit-grids/grid-auto-columns-rows-resolution-001\ngrid-auto-flow-resolution -\u003e placement/grid-auto-flow-resolution-001\ngrid-auto-flow-update -\u003e placement/grid-auto-flow-dynamic-change-001\ngrid-content-alignment-stretch-with-different-sized-tracks -\u003e alignment/grid-content-distribution-stretch-different-sized-tracks-001\ngrid-element-empty-row-column -\u003e grid-model/grid-container-rows-or-columns-only-001\ngrid-element-min-max-width -\u003e grid-model/grid-min-max-width-001\ngrid-element-padding-margin -\u003e grid-model/grid-container-padding-border-size-001\ngrid-item-addition-auto-placement-update -\u003e placement/grid-auto-placement-item-addition-001\ngrid-item-addition-track-breadth-update -\u003e layout-algorithm/grid-track-sizing-item-addition-001\ngrid-item-auto-margins-and-stretch -\u003e alignment/grid-item-auto-margins-and-stretch-001\ngrid-item-auto-margins-must-respect-specified-margins -\u003e alignment/grid-item-auto-margins-and-specified-margins-001\ngrid-item-auto-placement-automatic-span -\u003e placement/grid-auto-placement-automatic-span-001\ngrid-item-auto-placement-definite-span -\u003e placement/grid-auto-placement-definite-span-001\ngrid-item-auto-placement-fixed-row-column -\u003e placement/grid-auto-placement-fixed-row-column-001\ngrid-item-bad-named-area-auto-placement -\u003e placement/grid-placement-unknown-named-area-001\ngrid-item-bad-resolution-double-span -\u003e placement/grid-placement-invalid-double-span-001\ngrid-item-change-order-auto-flow -\u003e placement/grid-auto-placement-order-change-001\ngrid-item-margin-auto-columns-rows-vertical-ltr -\u003e\n        layout-algorithm/grid-item-margin-auto-columns-rows-vertical-lr-002,\n        layout-algorithm/grid-item-margin-auto-columns-rows-vertical-rl-002\n    The existing -001 tests only put margin-bottom on first-row items and\n    only check the size of a fit-content grid. These add margin-bottom on\n    second-row items in a grid with a definite block size, and check where\n    each item is placed.\ngrid-item-multiple-minmax-content-resolution -\u003e layout-algorithm/grid-minmax-content-tracks-multiple-items-001\ngrid-item-named-grid-area-resolution -\u003e placement/grid-placement-named-grid-area-resolution-001\ngrid-item-negative-indexes -\u003e placement/grid-placement-huge-negative-indexes-001\ngrid-item-negative-integer-explicit-grid-resolution -\u003e placement/grid-placement-negative-integer-explicit-grid-001\ngrid-item-negative-position-resolution -\u003e placement/grid-placement-negative-position-resolution-001\ngrid-item-position-changed-dynamic -\u003e placement/grid-placement-dynamic-change-001\ngrid-item-positioning-with-orthogonal-flows -\u003e layout-algorithm/grid-item-positioning-orthogonal-flows-001\ngrid-item-removal-auto-placement-update -\u003e placement/grid-auto-placement-item-removal-001\ngrid-item-removal-track-breadth-update -\u003e layout-algorithm/grid-track-sizing-item-removal-001\ngrid-item-sizing-with-orthogonal-flows -\u003e layout-algorithm/grid-item-sizing-orthogonal-flows-001\ngrid-item-spanning-and-orthogonal-flows -\u003e layout-algorithm/grid-spanning-items-orthogonal-flows-001\ngrid-item-spanning-resolution -\u003e layout-algorithm/grid-spanning-items-percentage-grid-001\ngrid-item-stretch-with-margins-borders-padding -\u003e alignment/grid-item-stretch-margin-border-padding-001\ngrid-item-stretch-with-margins-borders-padding-vertical-lr -\u003e alignment/grid-item-stretch-margin-border-padding-vertical-lr-001\ngrid-item-stretch-with-margins-borders-padding-vertical-rl -\u003e alignment/grid-item-stretch-margin-border-padding-vertical-rl-001\ngrid-item-unknown-named-grid-line-resolution -\u003e placement/grid-placement-unknown-named-grid-line-001\ngrid-item-with-border-in-fr -\u003e layout-algorithm/grid-flex-tracks-item-with-border-001\ngrid-item-with-border-in-intrinsic -\u003e layout-algorithm/grid-intrinsic-tracks-item-with-border-001\ngrid-item-with-percent-height-in-auto-height-grid-resolution -\u003e grid-items/grid-item-percentage-height-auto-height-grid-001\ngrid-items-should-not-be-stretched-when-height-or-width-or-margin-change -\u003e alignment/grid-item-stretch-dynamic-size-margin-change-001\ngrid-justify-content -\u003e alignment/grid-justify-content-001\ngrid-justify-content-distribution -\u003e alignment/grid-justify-content-distribution-001\ngrid-justify-content-distribution-vertical-lr -\u003e alignment/grid-justify-content-distribution-vertical-lr-001\ngrid-justify-content-distribution-vertical-rl -\u003e alignment/grid-justify-content-distribution-vertical-rl-001\ngrid-justify-content-vertical-lr -\u003e alignment/grid-justify-content-vertical-lr-001\ngrid-justify-content-vertical-rl -\u003e alignment/grid-justify-content-vertical-rl-001\ngrid-percent-track-margin-border-padding -\u003e layout-algorithm/grid-percentage-tracks-container-margin-border-padding-001\ngrid-preferred-logical-widths -\u003e layout-algorithm/grid-intrinsic-width-minmax-tracks-001\nimplicit-columns-auto-resolution -\u003e implicit-grids/grid-implicit-columns-auto-resolution-001\nimplicit-rows-auto-resolution -\u003e implicit-grids/grid-implicit-rows-auto-resolution-001\nimplicit-tracks-before-explicit -\u003e implicit-grids/grid-implicit-tracks-before-explicit-001\njustify-self-cell -\u003e alignment/grid-justify-self-cell-001\nmin-height-border-box -\u003e grid-items/grid-item-min-height-border-box-001\nmin-width-height-auto -\u003e grid-items/grid-item-min-width-height-auto-001\nmin-width-margin-box -\u003e grid-items/grid-item-min-width-margin-box-001\nminmax-spanning-resolution-columns -\u003e layout-algorithm/grid-minmax-spanning-items-columns-001\nminmax-spanning-resolution-rows -\u003e layout-algorithm/grid-minmax-spanning-items-rows-001\nnamed-grid-lines-with-named-grid-areas-resolution -\u003e placement/grid-placement-named-lines-and-areas-001\npercent-intrinsic-track-breadth -\u003e layout-algorithm/grid-percentage-tracks-intrinsic-container-001\npercent-of-indefinite-track-size -\u003e layout-algorithm/grid-percentage-of-indefinite-track-size-001\npercent-of-indefinite-track-size-in-auto -\u003e layout-algorithm/grid-percentage-of-indefinite-auto-track-size-001\npercent-padding-margin-resolution-grid-item -\u003e grid-items/grid-items-percentage-paddings-margins-writing-modes-001\npercent-padding-margin-resolution-grid-item-update -\u003e grid-items/grid-items-percentage-paddings-margins-track-change-001\npercent-resolution-grid-item -\u003e grid-items/grid-item-percentage-resolution-writing-modes-001\npercent-resolution-grid-item-children -\u003e grid-items/grid-item-children-percentage-resolution-001\npercent-track-breadths-regarding-container-size -\u003e layout-algorithm/grid-percentage-tracks-container-size-001\nquirks-mode-percent-resolution-grid-item -\u003e grid-items/grid-item-percentage-resolution-writing-modes-quirks-001\nrelayout-align-items-changed -\u003e alignment/grid-alignment-implies-size-change-037,\n        alignment/grid-alignment-implies-size-change-038\nrelayout-align-self-changed -\u003e alignment/grid-alignment-implies-size-change-041,\n        alignment/grid-alignment-implies-size-change-042\nrelayout-indefinite-heights -\u003e layout-algorithm/grid-flex-rows-container-height-change-001\nrelayout-justify-items-changed -\u003e alignment/grid-alignment-implies-size-change-039,\n        alignment/grid-alignment-implies-size-change-040\n    The existing -001 to -036 tests only change between start, normal and\n    stretch, and only check sizes. These, and 041 to 044 for align-self\n    and justify-self, cover end -\u003e stretch and stretch -\u003e center.\nrelayout-justify-self-changed -\u003e alignment/grid-alignment-implies-size-change-043,\n        alignment/grid-alignment-implies-size-change-044\nrepeating-layout-must-produce-the-same-results -\u003e layout-algorithm/grid-relayout-orthogonal-items-same-result-001\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325684\nWebKit-Canonical-Link: https://commits.webkit.org/322300@main\n--\n\nwpt-commits: 2a5ac6d83892b21a681ccbddcb47171b431d6c65\nwpt-pr: 63140\n", "files": ["testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-037.html", "testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-038.html", "testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-039.html", "testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-040.html", "testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-041.html", "testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-042.html", "testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-043.html", "testing/web-platform/tests/css/css-grid/alignment/grid-alignment-implies-size-change-044.html", "testing/web-platform/tests/css/css-grid/alignment/grid-content-distribution-stretch-different-sized-tracks-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-item-auto-margins-and-specified-margins-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-item-auto-margins-and-stretch-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-item-stretch-dynamic-size-margin-change-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-item-stretch-margin-border-padding-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-item-stretch-margin-border-padding-vertical-lr-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-item-stretch-margin-border-padding-vertical-rl-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-justify-content-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-justify-content-distribution-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-justify-content-distribution-vertical-lr-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-justify-content-distribution-vertical-rl-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-justify-content-vertical-lr-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-justify-content-vertical-rl-001.html", "testing/web-platform/tests/css/css-grid/alignment/grid-justify-self-cell-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-children-percentage-resolution-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-min-height-border-box-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-min-width-height-auto-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-min-width-margin-box-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-percentage-height-auto-height-grid-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-percentage-resolution-writing-modes-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-percentage-resolution-writing-modes-quirks-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-items-percentage-paddings-margins-track-change-001.html", "testing/web-platform/tests/css/css-grid/g