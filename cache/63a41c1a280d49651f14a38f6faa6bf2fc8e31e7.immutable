_changesets": ["8a04f2b9694c385245dae3d96676780785bbe9b0"], "user": "ffxbld@lando.moz.tools"}, "45596": {"changesets": [{"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2083082 - Fix intermittent verifyPrivateTabsTrayWithOpenTabTest navigation to BrowserPage r=ajoltan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334691\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SearchBarComponent.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TabbedBrowsingTest.kt"], "git_node": "8cb43598313557dc17537a9f752c2e4ec83d4142", "git_parents": ["8ea63b4292d88c4a831332ea57f3e08e0993108d"], "node": "ab30bc0277206b5678ad13eb4c715c2a4d831f52", "parents": ["e609d26e9aa3f8131631e2291a18fde748b3f3d8"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2044375 - Schedule Fenix/Focus UI test suite and TestRail milestone creation via promote_android r=mobiletest-reviewers,taskgraph-reviewers,releng-reviewers,ahal,isabel_rios\n\nThis moves the Fenix/Focus TestRail milestone creation into the Android release-promotion graph via shipping-phase: promote instead of on every push to mozilla-beta/mozilla-release.\n\n* Adds four new UI test tasks ({fenix,focus}-arm-{beta,release}-signoff) that run alongside beetmover-android-app in the same promote graph, against the same Firebase-signed APK built from the promoted revision.\n\n* Milestone creation uses requires: all-resolved so it always fires regardless of UI test outcome (SoftVision explicitly asked for this). The Slack message to #mobile-testeng-releases now includes a dynamic status emoji + link to the Taskcluster task replacing the previously hardcoded fake per-device checkmarks.\n\nVerified: a bunch of scenario local taskgraph matrix passes; live Try decision task matches local sim; scope grants verified in fxci-config.\n\nQuestions for taskgraph-reviewers:\n\n* Any concerns about adding to the promote graph size?\n* We're pulling build-apk-fenix-beta-firebase + its signing chain into promote_android as transitive deps. Any concern about this crossing the normal push-triggered boundary into the action graph?\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334192\n", "files": ["taskcluster/config.yml", "taskcluster/kinds/release-notify-testrail/kind.yml", "taskcluster/kinds/ui-test-apk/kind.yml", "taskcluster/scripts/slack_notifier.py", "taskcluster/scripts/testrail_main.py"], "git_node": "d4aa1cfdf8928a7f582f43f0070395098d327b66", "git_parents": ["8cb43598313557dc17537a9f752c2e4ec83d4142"], "node": "0f6240ca4f3790e22b99dbb0216f9a7bcedd6b11", "parents": ["ab30bc0277206b5678ad13eb4c715c2a4d831f52"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082167 - Let urlbar tests force the locale used to format dates and times - r=daisuke,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334864\n", "files": ["browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/private/FlightStatusSuggestions.sys.mjs", "browser/components/urlbar/private/SportsSuggestions.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_realtime_flight_status.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_sports.js", "browser/components/urlbar/tests/unit/test_UrlbarShared_formatDate.js"], "git_node": "20ac42c265b04a5863d83ad372ce678dadaa44a7", "git_parents": ["d4aa1cfdf8928a7f582f43f0070395098d327b66"], "node": "962a266a6816b98d29e89613cf82d3a18f233a8e", "parents": ["0f6240ca4f3790e22b99dbb0216f9a7bcedd6b11"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082186 - Fix calculation of gray marking valid state r=spidermonkey-reviewers,yulia\n\nThe patch changes the grayBitsValid boolean into a grayBitsInvalid bitmask, so\nwe can have a state to record when the gray bits were marked invalid as part of\nthe current collection. The gray bit state is no longer reset to valid at the\nend of such a collection.\n\nThe bitmask is made atomic because it can be written from parallel marking\nthreads as noted in bug 2082082.\n\nThe call to waitBackgroundSweepEnd() is no longer needed since the recent\nchanges to symbol gray marking in bug 2075296.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334049\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp", "js/src/jit-test/tests/gc/bug-2072426.js", "js/src/jit-test/tests/gc/bug-2082186.js"], "git_node": "9e1efa8acec25b84a9f4f2439e51fc1597c3ad5c", "git_parents": ["20ac42c265b04a5863d83ad372ce678dadaa44a7"], "node": "d372068aec805a4f857db84a83fb173755b04b42", "parents": ["962a266a6816b98d29e89613cf82d3a18f233a8e"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081581 - Bookmarks.insert() and update() should not accept a bookmark or separator as parentGuid. r=places-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333587\n", "files": ["toolkit/components/places/Bookmarks.sys.mjs", "toolkit/components/places/tests/bookmarks/test_bookmarks_insert.js", "toolkit/components/places/tests/bookmarks/test_bookmarks_insertTree.js", "toolkit/components/places/tests/bookmarks/test_bookmarks_moveToFolder.js", "toolkit/components/places/tests/bookmarks/test_bookmarks_update.js"], "git_node": "36952d22dcc48d4cb9955f30772491c4f18a8ddd", "git_parents": ["9e1efa8acec25b84a9f4f2439e51fc1597c3ad5c"], "node": "d97a87a82859dcf4f9a5c2f2af4e5f0744abdc2f", "parents": ["d372068aec805a4f857db84a83fb173755b04b42"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083036 - [ci] Update firefox-dev's URL to new org, r=jlorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334628\n", "files": [".taskcluster.yml", "taskcluster/docker/snap-coreXX-build/snap-tests/basic_tests/expectations.json.in"], "git_node": "531b2ae34e9a34f1f5c025b73bc813694cb06ae1", "git_parents": ["36952d22dcc48d4cb9955f30772491c4f18a8ddd"], "node": "f52621c697c929246219483c64d99b37a2fe2936", "parents": ["d97a87a82859dcf4f9a5c2f2af4e5f0744abdc2f"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075440 - Update PdfEmbedFallback:OpenPdf. r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331960\n", "files": ["toolkit/components/pdfjs/content/PdfEmbedFallbackParent.sys.mjs"], "git_node": "44c8fd8df124546b1aec37bd794eed0a97140cf3", "git_parents": ["531b2ae34e9a34f1f5c025b73bc813694cb06ae1"], "node": "6db1516b26c4739c8baca47b5b3b95daf934f48f", "parents": ["f52621c697c929246219483c64d99b37a2fe2936"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2079682 - chore(webgpu): clarify why we `\u2026.unwrap_or(0)` `submission_index` r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334487\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "190377ca7a1f4dcd7c42fc7c9d71f6f1f770979b", "git_parents": ["44c8fd8df124546b1aec37bd794eed0a97140cf3"], "node": "c25ce1e40f09b93cee245ea7c4a40912e7e94ef0", "parents": ["6db1516b26c4739c8baca47b5b3b95daf934f48f"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2079682 - fix(webgpu): unconditionally remove Vulkan semaphores from HAL queue r=webgpu-reviewers,teoxoy\n\nIndependent of whether the submission failed, we should remove these;\nsignalling a semaphore after a failed submission is incorrect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334488\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "6f306bab84456a991cad483ce81516ca96c5169b", "git_parents": ["190377ca7a1f4dcd7c42fc7c9d71f6f1f770979b"], "node": "c978fd00674e1fa29d805f694a5c52c9d57b1067", "parents": ["c25ce1e40f09b93cee245ea7c4a40912e7e94ef0"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2079682 - fix(webgpu): assume `!submission_succeeded` for a submit if a Vulkan semaphore is still present in the HAL queue r=webgpu-reviewers,teoxoy\n\nWe can detect if a submission has failed when we discover that a signal\nsemaphore was still left in the HAL queue after a submission that was\nsupposed to consume it. Add this to our heuristic for detecting\nsubmission failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334489\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "875508e7103bb0a75070223e01a23b65da9a4446", "git_parents": ["6f306bab84456a991cad483ce81516ca96c5169b"], "node": "b2043257cfc6b5c917c26997027861f055d6c8a9", "parents": ["c978fd00674e1fa29d805f694a5c52c9d57b1067"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082674 - Import condprof in perftest.py inside the functions that use it. r=perftest-reviewers,sparky\n\nThe condprof imports at the top of perftest.py are only used by\nget_conditioned_profile and install_extra_extensions.\nThis patch moves them into those functions and matches how\nbuild_conditioned_profile already imports condprof.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334343\n", "files": ["testing/raptor/raptor/perftest.py", "testing/raptor/test/test_cmdline.py"], "git_node": "1e6d865f830d6f95c963199b0039249fb386bbb9", "git_parents": ["875508e7103bb0a75070223e01a23b65da9a4446"], "node": "9e0c9f9907c7004eb718516791d980c04fa37ff0", "parents": ["b2043257cfc6b5c917c26997027861f055d6c8a9"], "tags": []}, {