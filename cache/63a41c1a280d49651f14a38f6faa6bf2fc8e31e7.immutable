"security/nss/taskcluster/nss_taskgraph/transforms/hg_store.py", "security/nss/taskcluster/nss_taskgraph/transforms/platforms.py", "security/nss/tests/common/init.sh"], "git_node": "0948215a0c8f13ebddb9df73227ffea5e8bc23fb", "git_parents": ["680a5440e4434789237610e4bc8b2a639163c47c"], "node": "e90b5fd0f78782816f60d8a75cf7d0e330ddfcc1", "parents": ["7d838a266bf65d4226442cad81a9fdbc408691b0"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1916979 - mozprocess: treat a passed deadline as a timeout in ProcessReader. r=mozbase-reviewers,ahal\n\nIf the overall deadline passed between two reads, Queue.get was called with\na negative timeout and raised ValueError, killing the reader thread without\ncalling either the timeout or finished callback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333224\n", "files": ["testing/mozbase/mozprocess/mozprocess/processhandler.py"], "git_node": "e79b49bd6181a57398785925f473fda4da194bbc", "git_parents": ["0948215a0c8f13ebddb9df73227ffea5e8bc23fb"], "node": "65f725454ce044da8120d7cb9f9831cce63ac18e", "parents": ["e90b5fd0f78782816f60d8a75cf7d0e330ddfcc1"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043004 - Enable skipping paint for clamped lines by defualt. r=dshin,alaskanemily?\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322432\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-overflow/__dir__.ini"], "git_node": "a904292fdf61f5d057dad17cdceb6634eafdeebb", "git_parents": ["e79b49bd6181a57398785925f473fda4da194bbc"], "node": "09cc521e30357247f7b55883f8ca6dc8c58a5507", "parents": ["65f725454ce044da8120d7cb9f9831cce63ac18e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081760 - Tweak transition cascade order. r=firefox-style-system-reviewers,dshin\" for causing failures complaining about CascadePriority.\n\nThis reverts commit b0a6c1bb4eae8fb6022700aa1bc2215a6892f941.\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/rule_tree/level.rs", "testing/web-platform/tests/css/css-transitions/ua-important.tentative.html"], "git_node": "f07d0bae68c50e0a94e605b66e38ac979c1a5f24", "git_parents": ["a904292fdf61f5d057dad17cdceb6634eafdeebb"], "node": "68fc8762f20db6db51c444b6ae5e8f39bd067466", "parents": ["09cc521e30357247f7b55883f8ca6dc8c58a5507"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1917652 Part 1: Turn on GPU Process for X11 Nightly. r=aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221529\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "8a96d0802b12a70dc7318b223c47a448b796baa2", "git_parents": ["f07d0bae68c50e0a94e605b66e38ac979c1a5f24"], "node": "f90437fb5aa0efa7c9710ceaebf53a49a9313732", "parents": ["68fc8762f20db6db51c444b6ae5e8f39bd067466"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070663 - Add the moz-widget custom element. r=mconley,nina-py\n\n- Adds standard widget sizes and card styling.\n- Widget content can come from slotted elements or framed content loaded from `src`.\n- Loads framed content in a remote browser in chrome or iframe in content.\n- When using a browser element, extension content is loaded using the extension\u2019s browsing context group.\n- Adds Storybook documentation and chrome tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327912\n", "files": ["browser/components/moz.build", "browser/components/storybook/.storybook/main.js", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/moz.build", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html"], "git_node": "5fbb7224d4740b1e272c38160284cdfeb1dcacf2", "git_parents": ["8a96d0802b12a70dc7318b223c47a448b796baa2"], "node": "6de539f85ab9fcd8884f08b72beb0076a79e8375", "parents": ["f90437fb5aa0efa7c9710ceaebf53a49a9313732"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070684 - Add a header component and slot to moz-widget. r=nina-py\n\n- Adds a `moz-widget-header` component with a heading and `leading` and `trailing` slots\n- Adds a `header` slot to moz-widget for the `moz-widget-header`\n- Adds a `padded` attribute to moz-widget to inset and round the content\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328015\n", "files": ["browser/components/widgets/content/moz-widget-header.css", "browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html", "browser/components/widgets/tests/chrome/test_moz_widget_header.html"], "git_node": "6e863ebf1dac5b3e33e86d0690ccd6e9b707b6d1", "git_parents": ["5fbb7224d4740b1e272c38160284cdfeb1dcacf2"], "node": "b5ec66f75a692aeabd211967d77311238adb155a", "parents": ["6de539f85ab9fcd8884f08b72beb0076a79e8375"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070709 - Add WidgetManager to track the widgets registered by extensions. r=mconley\n\n- Adds a `WidgetManager` singleton that stores one widget per extension id.\n- Emits \"change\" at init and on register and unregister with the IDs of the updated widgets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329352\n", "files": ["browser/components/BrowserComponents.manifest", "toolkit/components/moz.build", "toolkit/components/widgets/WidgetManager.sys.mjs", "toolkit/components/widgets/moz.build", "toolkit/components/widgets/tests/xpcshell/test_WidgetManager.js", "toolkit/components/widgets/tests/xpcshell/xpcshell.toml"], "git_node": "d5bb5994f3bdb7237dc2f9a8a5bea61aa125ab38", "git_parents": ["6e863ebf1dac5b3e33e86d0690ccd6e9b707b6d1"], "node": "68f1dd79b9e816a57188339b3c1d38e5d1822ce8", "parents": ["b5ec66f75a692aeabd211967d77311238adb155a"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074341 - Add ExtensionWidgetsFeed for widgets provided by extensions. r=mconley,ckerschb\n\n- Adds `src` and `extensionID` to the config for widgets.\n- Widgets with URL in `src` set will render using the `moz-widget` component with that src set on the internal iframe.\n- ExtensionWidgetsFeed updates on WidgetManager changes.\n- Extension widgets get `src` from WidgetManager.\n- Widgets without a registered extension widget aren't shown.\n- Extension widgets use the extension's name as their toggle label.\n- Applies the drag pointer-events and cell sizing rules to `moz-widget`.\n- Allows `moz-extension:` in the `frame-src` of about:newtab and about:home, limited to privileged extensions by Bug 2070235.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328690\n", "files": ["browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/useWidgetLabels.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_WidgetWrapper.scss", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/data/content/abouthomecache/page.html.template", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/ExtensionWidgetsFeed.sys.mjs", "browser/extensions/newtab/prerendered/activity-stream-debug.html", "browser/extensions/newtab/prerendered/activity-stream-noscripts.html", "browser/extensions/newtab/prerendered/activity-stream.html", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/xpcshell/test_ExtensionWidgetsFeed.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "browser/extensions/newtab/test/xpcshell/xpcshell.toml", "dom/security/nsContentSecurityUtils.cpp"], "git_node": "4d0bd16129183b5f9728550d991cb60d427e9ae0", "git_parents": ["d5bb5994f3bdb7237dc2f9a8a5bea61aa125ab38"], "node": "39d0b57a3913e9bba2b69bf020d9b0e41e2f3934", "parents": ["68f1dd79b9e816a57188339b3c1d38e5d1822ce8"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079959 - Include the ExtensionWidgets slice when getting all widgets. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332214\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx"], "git_node": "3f35ab6a78798f139d9c089f47e32f9bce7c432b", "git_parents": ["4d0bd16129183b5f9728550d991cb60d427e9ae0"], "node": "8d7f069ad496974a6325192d7fd213bd3fb7792e", "parents": ["39d0b57a3913e9bba2b69bf020d9b0e41e2f3934"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070689 - Add a menu button and slot to moz-widget-header. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331840\n", "files": ["browser/components/widgets/content/moz-widget-header.css", "browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/tests/chrome/test_moz_widget.html", "browser/components/widgets/tests/chrome/test_moz_widget_header.html"], "git_node": "d4fc28348c367cb220aa89db3c626f07955d1681", "git_parents": ["3f35ab6a78798f139d9c089f47e32f9bce7c432b"], "node": "6f4d39619ef3e61918a9e31121291219b3cc97a6", "parents": ["8d7f069ad496974a6325192d7fd213bd3fb7792e"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2080184 - Migrate bookmarkProperties.properties to Fluent. r=places-reviewers,fluent-reviewers,bolsson,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332407\n", "files": ["browser/components/places/content/bookmarkProperties.js", "browser/components/places/content/bookmarkProperties.xhtml", "browser/components/places/tests/browser/browser_bookmarkProperties_bookmarkAllTabs.js", "browser/locales/en-US/browser/editBookmarkOverlay.ftl", "browser/locales/en-US/chrome/browser/places/bookmarkProperties.properties", "browser/locales/jar.mn", "python/l10n/fluent_migrations/bug_2080184_bookmark_properties.py"], "git_node": "e4051a1a86cbb7376bb33d3f1447a0f1db6da5b5", "git_parents": ["d4fc28348c367cb220aa89db3c626f07955d1681"], "node": "ac9f07a47f33a1582c534a04f5ae65fbc767ebef", "parents": ["6f4d39619ef3e61918a9e31121291219b3cc97a6"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2072364 - [Monitor Agent][FE] Pages to watch chips show the address instead of the page title while creating a task r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332956\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/ui/actors/AgentMonitorItemChild.sys.mjs", "browser/components/aiwindow/ui/actors/AgentMonitorItemParent.sys.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js"], "git_node": "027da1490c0db3ae86c1a9162240971fb524a0fa", "git_parents": ["e4051a1a86cbb7376bb33d3f1447a0f1db6da5b5"], "node": "5387791e8f073ea62789e12c8b47ceb0911fc27d", "parents": ["ac9f07a47f33a1582c534a04f5ae65fbc767ebef"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076483: Add a default-off pref for swipe haptic feedback. r=mac-reviewers,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333817\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "widget/SwipeTracker.cpp"], "git_node": "359e996a2aacbee7860d3b72c5809904f96788c1", "git_parents": ["027da1490c0db3ae86c1a9162240971fb524a0fa"], "node": "03da7cf39dba4f6389446af4c79f3315813161b6", "parents": ["5387791e8f073ea62789e12c8b47ceb0911fc27d"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2078462 - Intern rectangles in the display list builder r=gfx-reviewers,nical\n\nThe first interned type, plus the machinery every primitive type shares.\nPrimitive keys hold the prim rect, local clip rect and flags, so an item is\nonly its spatial id, clip chain and handle, and the scene builder places the\ninstance from a PrimPlacement store (add_dl_prim). The two ids stay on the\nitem because content numbers them per build.\n\nSince an item no longer carries what its shadow copy needs, primitives pushed\nin a shadow scope record a CapturedKey that the desugar interns copies from.\nA handle-less rectangle in a finished list is a transparent checkerboard,\nkept only for its tile cache barrier.\n\nA fresh builder re-mints every uid, so an identical list from a new builder\nrepaints; test_invalidation covers it. wrshell's capture writer now emits\nplaceholder bounds and colour.\n\nA removed pipeline's namespace is released by the scene build of the\ndocument that removed it, or by any build once that document is deleted.\nThe render backend holds a document's ops while it has no scene to swap, so\na release from another document's build could overtake the namespace's open.\n\nContent's builder survives its pipeline moving to another window's WebRender\ninstance, which releases the pipeline in the old one, so WrUpdated replaces\nthe builder and the next display list starts a fresh delta stream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330955\n", "files": ["gfx/layers/wr/WebRenderLayerManager.cpp", "gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/rectangle.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/interning.rs", "gfx/wr/wrench/invalidation/invalidation.list", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/test_invalidation.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "741ac2c009f9b5c0016abcf83f624bfaa5c2e0b9", "git_parents": ["359e996a2aacbee7860d3b72c5809904f96788c1"], "node": "2bb9e01d59522378e3de02c1f7c17cf56aa1dd41", "parents": ["03da7cf39dba4f6389446af4c79f3315813161b6"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081560: Keep APZ bridges alive during synchronous calls. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333501\n", "files": ["gfx/layers/apz/public/APZBridge.h", "gfx/layers/apz/public/IAPZCTreeManager.h", "gfx/layers/apz/src/APZCTreeManager.h", "gfx/layers/apz/test/gtest/TestAPZBridge.cpp", "gfx/layers/apz/test/gtest/moz.build", "gfx/layers/ipc/APZBridgeChild.cpp", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerChild.h"], "git_node": "81587730f71fa7554b84c5b2b7bb6c4bb23a8388", "git_parents": ["741ac2c009f9b5c0016abcf83f624bfaa5c2e0b9"], "node": "68c671f65c57583cd9104a19b06ac922e671807b", "parents": ["2bb9e01d59522378e3de02c1f7c17cf56aa1dd41"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077494 - Lock the callbacks read by GetInterface in ConnectionEstablisher and DnsAndConnectSocket. r=necko-reviewers,valentin\n\nPSM can call GetInterface on the main thread for the password prompt, while these objects update their security callbacks and transaction on the socket thread.  This is safe today only because the socket thread is blocked meanwhile, unlike nsHttpConnection which already uses a lock for this.  ForgetRealTransaction becomes virtual so DnsAndConnectSocket, the only attempt whose GetInterface reads mTransaction, can take its lock there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330409\n", "files": ["netwerk/protocol/http/ConnectionAttempt.h", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/ConnectionEstablisher.h", "netwerk/protocol/http/DnsAndConnectSocket.cpp", "netwerk/protocol/http/DnsAndConnectSocket.h"], "git_node": "6a3c6f372fb4d38fd2af17fd1e65e05d3072823c", "git_parents": ["81587730f71fa7554b84c5b2b7bb6c4bb23a8388"], "node": "0b939bfbdd74e58bf142cc0267c9c0d6506897b4", "parents": ["68c671f65c57583cd9104a19b06ac922e671807b"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2080171 - ensure title of personalized taskbar tabs spotlights have sufficient contract with HCM enabled r=omc-reviewers,mimi\n\n{F84227009}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333661\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs"], "git_node": "e0faf499c7d217338264a5b3af54386722e54541", "git_parents": ["6a3c6f372fb4d38fd2af17fd1e65e05d3072823c"], "node": "5e519f82555094d14b6532996cb15cd198b24a69", "parents": ["0b939bfbdd74e58bf142cc0267c9c0d6506897b4"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079947 - Fall back to the previous push's task in mach perftest --alert-exact. r=mozperftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333814\n", "files": ["python/mozperftest/mozperftest/test/alert.py", "python/mozperftest/mozperftest/tests/test_alert.py"], "git_node": "90b211c2bff14cb6692d6be432008dcbd3cb6499", "git_parents": ["e0faf499c7d217338264a5b3af54386722e54541"], "node": "481015d9f5d2bb024c64f6d7dae7c38c087848e7", "parents": ["5e519f82555094d14b6532996cb15cd198b24a69"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-bg/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-gl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-hsb/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-hu/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-pt-rPT/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-sl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-sv-rSE/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/focus-android/app/src/main/res/values-hsb/strings.xml"], "git_node": "a54abfe9aca2233dc148a545d87476e29758d1f2", "git_parents": ["90b211c2bff14cb6692d6be432008dcbd3cb6499"], "node": "5678772d4d610a86864272d47abffe56fb2513b8", "parents": ["481015d9f5d2bb024c64f6d7dae7c38c087848e7"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078462 - Intern rectangles in the display list builder r=gfx-reviewers,nical\" for causing failures at browser_window_open_modifiers.js.\n\nThis reverts commit 741ac2c009f9b5c0016abcf83f624bfaa5c2e0b9.\n", "files": ["gfx/layers/wr/WebRenderLayerManager.cpp", "gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/rectangle.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/interning.rs", "gfx/wr/wrench/invalidation/invalidation.list", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/test_invalidation.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "d9996dda0c58f40e5709297283554f9e4766bbda", "git_parents": ["a54abfe9aca2233dc148a545d87476e29758d1f2"], "node": "cdb74ad03c32d2ac3abd330e9b0800821ff257d2", "parents": ["5678772d4d610a86864272d47abffe56fb2513b8"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1917652 Part 1: Turn on GPU Process for X11 Nightly. r=aosmond\" for causing failures complaining about BadDrawable.\n\nThis reverts commit 8a96d0802b12a70dc7318b223c47a448b796baa2.\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "920d2e9e838bc00470db464b4fc063ec2ff33080", "git_parents": ["d9996dda0c58f40e5709297283554f9e4766bbda"], "node": "1544b4e195549190c3cfe3ee260b2058555e6a68", "parents": ["cdb74ad03c32d2ac3abd330e9b0800821ff257d2"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070689, Bug 2079959, Bug 2074341, Bug 2070709, Bug 2070684, Bug 2070663 - Add a menu button and slot to moz-widget-header. r=nina-py\" for causing high frequency leaks.\n\nThis reverts commit d4fc28348c367cb220aa89db3c626f07955d1681.\n\nRevert \"Bug 2079959 - Include the ExtensionWidgets slice when getting all widgets. r=mconley\"\n\nThis reverts commit 3f35ab6a78798f139d9c089f47e32f9bce7c432b.\n\nRevert \"Bug 2074341 - Add ExtensionWidgetsFeed for widgets provided by extensions. r=mconley,ckerschb\"\n\nThis reverts commit 4d0bd16129183b5f9728550d991cb60d427e9ae0.\n\nRevert \"Bug 2070709 - Add WidgetManager to track the widgets registered by extensions. r=mconley\"\n\nThis reverts commit d5bb5994f3bdb7237dc2f9a8a5bea61aa125ab38.\n\nRevert \"Bug 2070684 - Add a header component and slot to moz-widget. r=nina-py\"\n\nThis reverts commit 6e863ebf1dac5b3e33e86d0690ccd6e9b707b6d1.\n\nRevert \"Bug 2070663 - Add the moz-widget custom element. r=mconley,nina-py\"\n\nThis reverts commit 5fbb7224d4740b1e272c38160284cdfeb1dcacf2.\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/moz.build", "browser/components/storybook/.storybook/main.js", "browser/components/widgets/content/moz-widget-header.css", "browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/moz.build", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html", "browser/components/widgets/tests/chrome/test_moz_widget_header.html", "browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/useWidgetLabels.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_WidgetWrapper.scss", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/data/content/abouthomecache/page.html.template", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/ExtensionWidgetsFeed.sys.mjs", "browser/extensions/newtab/prerendered/activity-stream-debug.html", "browser/extensions/newtab/prerendered/activity-stream-noscripts.html", "browser/extensions/newtab/prerendered/activity-stream.html", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/xpcshell/test_ExtensionWidgetsFeed.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "browser/extensions/newtab/test/xpcshell/xpcshell.toml", "dom/security/nsContentSecurityUtils.cpp", "toolkit/components/moz.build", "toolkit/components/widgets/WidgetManager.sys.mjs", "toolkit/components/widgets/moz.build", "toolkit/components/widgets/tests/xpcshell/test_WidgetManager.js", "toolkit/components/widgets/tests/xpcshell/xpcshell.toml"], "git_node": "bdbe2fac18a8db2a73343a235692706e1805fa3d", "git_parents": ["920d2e9e838bc00470db464b4fc063ec2ff33080"], "node": "1d2637a051ec36eca9be6b795644e149f177a8d0", "parents": ["1544b4e195549190c3cfe3ee260b2058555e6a68"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077486 - Keep nsHttpHandler::mActivityDistributor alive until the handler is destroyed. r=necko-reviewers,kershaw\n\nObserve cleared it on profile-change-net-teardown, which AppShutdown sends as a shutdown phase, while the socket thread can still dereference it.  Set it once in Init and let the destructor release it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330402\n", "files": ["netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h"], "git_node": "ff3f633ad55001f2577ceb097116aca9f3ae99f7", "git_parents": ["bdbe2fac18a8db2a73343a235692706e1805fa3d"], "node": "c4281e8e20a42190bed2e319490406d80a3fd8e3", "parents": ["1d2637a051ec36eca9be6b795644e149f177a8d0"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2081794 - Update the Firefox Profiler toolchain to the October 13, 2026 deploy r=profiler-reviewers,dcarver\n\nThis revision includes profiler-cli 0.11.0, which is needed to build\nprofiler-cli from the same source in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332187\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "b68ea165ef1bb21799dce17115956f97444b8e50", "git_parents": ["ff3f633ad55001f2577ceb097116aca9f3ae99f7"], "node": "9380574a64af5a2e778c9676a34077d203b11bed", "parents": ["c4281e8e20a42190bed2e319490406d80a3fd8e3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081789 - Record max-age-too-low as its own result in the HSTS probe results artifact. r=keeler\n\nHosts sending a max-age below the minimum, including an explicit max-age=0 opt-out, are recorded as no-header,\nindistinguishable from hosts that send no header at all. Failure streaks are unaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333708\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "208172e93132de931759284220ac60c6183818bb", "git_parents": ["b68ea165ef1bb21799dce17115956f97444b8e50"], "node": "6eef05fe7de7cb9ff0470752508dc918bbac18ae", "parents": ["9380574a64af5a2e778c9676a34077d203b11bed"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081789 - Load the preloaded intermediate certificates before probing hosts for the HSTS preload list. r=keeler\n\nFirefox fills in intermediates a server leaves out of its chain from the security-state/intermediates Remote\nSettings collection, but the probe runs without them, so those hosts fail with SEC_ERROR_UNKNOWN_ISSUER and\nare recorded as connection failures. This patch syncs the collection into a profile in the script's working\ndirectory and imports the certificates before probing. Without a profile-before-change notification before\nexit, including when the script fails, xpcshell crashes at shutdown once the imported certificates are in use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333709\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "4116743ec2b9f6d05e13bdaab90b5d6e9586fa8b", "git_parents": ["208172e93132de931759284220ac60c6183818bb"], "node": "9b4d2ff1e1914dfc8cbe384011172e6a516d0210", "parents": ["6eef05fe7de7cb9ff0470752508dc918bbac18ae"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061363 - Remove the Legacy Telemetry mirrors of the query_stripping probes r=TravisLong\n\nOnly the Legacy Telemetry mirrors are removed. The Glean metrics\ncontentblocking.query_stripping_count, query_stripping_param_count and\nquery_stripping_count_by_param are left in place, so what Firefox collects is\nunchanged. URLQueryStringStripper.cpp, nsHttpChannel.cpp and\nnsDocShellLoadState.cpp already record exclusively through Glean, so no\ninstrumentation changes are needed.\n\nBoth sides of each mirror have to go in the same commit: test_mirrors.py asserts\nevery telemetry_mirror resolves to an existing probe, and also that every\nhistogram in Histograms.json has a mirroring metric, so removing either side\nalone fails.\n\nBoth browser_urlQueryStringStripping_telemetry.js and its _2 variant asserted on\nthe legacy histograms only, so those assertions are converted to Glean rather\nthan dropped:\n\n- The categorical indices map onto queryStrippingCount's labels: 0 is\n  Navigation, 1 is Redirect, 2 is StripForNavigation and 3 is StripForRedirect.\n- query_stripping_param_count is an exponential distribution, so instead of\n  checking that a sample landed in a given bucket the assertions now check the\n  distribution's sum and count, which pins the recorded values exactly. The\n  sweep over buckets 0-5 that expected a lone sample in bucket 4 becomes a\n  single check for one sample of value 4.\n- An absent label read back as undefined from a histogram snapshot but reads\n  back as null from Glean, so those checks get their own helper.\n- queryStrippingCountByParam is compared as a whole label-to-count map. Params\n  that are stripped but deliberately not broken out per-param in the metric\n  definition land in Glean's __other__ label; the previous code ignored them\n  because indexOf() returned -1 for them, so the comparison drops __other__ to\n  keep that behaviour.\n\nThe clearing helpers no longer need to wait out the two second content-process\nsync interval, since flushing the children before resetting FOG is synchronous\nwith respect to the test. TelemetryTestUtils is no longer used in either file\nand its import is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317126\n", "files": ["toolkit/components/antitracking/metrics.yaml", "toolkit/components/antitracking/test/browser/browser_urlQueryStringStripping_telemetry.js", "toolkit/components/antitracking/test/browser/browser_urlQueryStringStripping_telemetry_2.js", "toolkit/components/telemetry/Histograms.json"], "git_node": "cd4874f93b303865d79c1a62529a8be337070a12", "git_parents": ["4116743ec2b9f6d05e13bdaab90b5d6e9586fa8b"], "node": "c5c72fc08bbd848c8136ab96748db3f002aeffa7", "parents": ["9b4d2ff1e1914dfc8cbe384011172e6a516d0210"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2058489 - Keep npx in the repacked Node toolchains r=glandium\n\nThe node that we built from source for linux64 and the Windows repacks\nalready ship npx. The removal only matched the node/bin layout of the\nupstream macOS and Linux archives, so npx was only removed from the\nmacOS, linux-aarch64 and Node 12 toolchains.\n\nThe puppeteer tests and `mach npx` depend on npx, so switching linux64\nfrom the source build to the upstream archive would break the linux64\npuppeteer tasks. npx was originally removed because it downloads and\nexecutes packages from npm at runtime, but npm ships next to it and\n`npm exec` does the same thing, so removing npx didn't protect anything.\nLet's stop removing it rather than having it depend on the platform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330068\n", "files": ["taskcluster/scripts/misc/repack-node.sh"], "git_node": "220d56e5441a7c229c8a2373c03bd9b58135a083", "git_parents": ["cd4874f93b303865d79c1a62529a8be337070a12"], "node": "d4edb98e5d5593969783c322c11404740b96f9c9", "parents": ["c5c72fc08bbd848c8136ab96748db3f002aeffa7"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2058489 - Use the upstream Node 22 binary for linux64 r=glandium\n\nWe built Node 22 from source because the upstream binary requires glibc\n2.28, which Ubuntu 18.04 doesn't have. The last Ubuntu 18.04 jobs were\nremoved in bug 2069527, so repack the upstream binary like on the other\nplatforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330069\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/node.yml", "taskcluster/scripts/misc/build-nodejs.sh"], "git_node": "a1669119212878e8c912a3a72eedcc99567bdb19", "git_parents": ["220d56e5441a7c229c8a2373c03bd9b58135a083"], "node": "e0f333fde8e045d45322f49c378c72c4fea700c9", "parents": ["d4edb98e5d5593969783c322c11404740b96f9c9"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2058489 - Switch the default Node.js toolchain to Node 24 r=glandium,perftest-reviewers,taskgraph-reviewers,releng-reviewers,jcristau,sparky,ahal\n\nMove the \u003cplatform\u003e-node toolchain aliases to Node 24.21.0 prebuilt\nbinaries, and drop the Node 22 toolchains that are no longer used.\n\nSome Node 22 toolchains are kept:\n- win32-node stays on Node 22, as there is no official 32-bit Windows\n  build of Node 23 and later.\n- macosx64-node-22 is used on the macOS 10.15 test and build workers,\n  since Node 24 requires macOS 13.5.\n\nThe gecko profile action no longer hardcodes versioned node labels, so\nprofiling backfills across this change and future upgrades keep\nworking. mach raptor stays pinned, as node upgrades change browsertime\nperformance numbers, and now uses Node 24 (Node 22 on Intel macOS,\nmatching what CI fetches there).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330070\n", "files": ["taskcluster/gecko_taskgraph/actions/gecko_profile.py", "taskcluster/gecko_taskgraph/test/test_actions.py", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/node.yml", "testing/raptor/mach_commands.py", "tools/lint/toolchain-parity/exclusions.yml"], "git_node": "ecf823e6d046cd99a49a28867266ff855377142c", "git_parents": ["a1669119212878e8c912a3a72eedcc99567bdb19"], "node": "cf111e6cda16f8b86c360830ec1aab89135d5af4", "parents": ["e0f333fde8e045d45322f49c378c72c4fea700c9"], "tags": []}, {"author": "daviddurfee \u003cdavid@anonymco.com\u003e", "branch": "default", "desc": "Bug 2079016 - Clear sponsored scoring data when history is removed. r=mconley,bbirdsong\n\nClear the stored scores and score history, and restart the release interval,\nwhen all history is cleared or the user removes any history. Removals from\nhistory expiration are ignored. This listens to Places directly because\nPlacesFeed does not forward partial visit removals.\n\nDepends on D332628\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332924\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js"], "git_node": "e1f2fa6d6ee1df98c6a224ca8fca15d8a259b19c", "git_parents": ["ecf823e6d046cd99a49a28867266ff855377142c"], "node": "e663e12316e6c31135e9416f10ec4e50d5a7e58e", "parents": ["cf111e6cda16f8b86c360830ec1aab89135d5af4"], "tags": []}, {"author": "daviddurfee \u003cdavid@anonymco.com\u003e", "branch": "default", "desc": "Bug 2079021 - Stop sponsored scoring when shortcuts or sponsored shortcuts are disabled. r=mconley\n\nOnly run the sponsored top sites score provider while both shortcuts and\nsponsored shortcuts are shown. Turning either off clears the stored scores\nand stops the provider. Switching the sponsored tiles service away from MARS\nkeeps the provider and its data, since the user has not opted out.\n\nDepends on D332924\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333780\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "50f99b474938db7a0f7b6a498f908cc6c262acce", "git_parents": ["e1f2fa6d6ee1df98c6a224ca8fca15d8a259b19c"], "node": "3c8a1ea78941705ca9e5475647814b3c3f695513", "parents": ["e663e12316e6c31135e9416f10ec4e50d5a7e58e"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065579 - Allow a GeckoSession to be opened in an existing browsing context group and content process. r=geckoview-reviewers,ohall,jonalmeida\n\nA session that clones a video from another session has to live in the same browsing context group and the same content process as that video, otherwise the video cannot be cloned into it.\n\nLet the embedder ask for that placement explicitly through two new session settings. When they are unset, remote type selection keeps falling back to ProcessIsolation's prediction, so this does not change how any existing session is opened.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320560\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SessionProcessPlacementTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSessionSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/chrome/geckoview/geckoview.js", "mobile/shared/modules/geckoview/GeckoViewPictureInPicture.sys.mjs", "mobile/shared/modules/geckoview/moz.build"], "git_node": "5efb97cc636de9c89ec788932cb0bdf399167a23", "git_parents": ["50f99b474938db7a0f7b6a498f908cc6c262acce"], "node": "e5f1667f05d2f0663100a293a53649315f7634da", "parents": ["3c8a1ea78941705ca9e5475647814b3c3f695513"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065581 - Let a GeckoSession host a picture-in-picture player. r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324069\n", "files": ["mobile/shared/actors/GeckoViewPictureInPicturePlayerChild.sys.mjs", "mobile/shared/actors/GeckoViewPictureInPicturePlayerParent.sys.mjs", "mobile/shared/actors/moz.build", "mobile/shared/chrome/geckoview/geckoview.js", "toolkit/actors/PictureInPictureChild.sys.mjs", "toolkit/themes/mobile/global/jar.mn"], "git_node": "d017c7799bb501fbfe468863420253aa0792022e", "git_parents": ["5efb97cc636de9c89ec788932cb0bdf399167a23"], "node": "34184d79e3e61b31a1a6a330534435bdb44893ce", "parents": ["e5f1667f05d2f0663100a293a53649315f7634da"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065581 - Ask the embedder to open a picture-in-picture window for a playing video. r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324070\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PictureInPictureTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PictureInPictureController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/actors/GeckoViewPictureInPictureSourceChild.sys.mjs", "mobile/shared/actors/moz.build", "mobile/shared/chrome/geckoview/geckoview.js", "mobile/shared/modules/geckoview/GeckoViewPictureInPicture.sys.mjs"], "git_node": "2362c846618d449e21aeaf2c0d8e7327cbd41580", "git_parents": ["d017c7799bb501fbfe468863420253aa0792022e"], "node": "e74359a353b3bf526379e6643662952426281bee", "parents": ["34184d79e3e61b31a1a6a330534435bdb44893ce"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065581 - Clone the video once the picture-in-picture window's session is ready. r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324071\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/TestSupportChild.sys.mjs", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PictureInPictureTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SessionProcessPlacementTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/shared/modules/geckoview/GeckoViewPictureInPicture.sys.mjs"], "git_node": "8644324c8a24280d48370d1861131fb76623441c", "git_parents": ["2362c846618d449e21aeaf2c0d8e7327cbd41580"], "node": "f012b5f51a364cd815b700d96884101d945bc8de", "parents": ["e74359a353b3bf526379e6643662952426281bee"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065581 - Tell the embedder when to close the picture-in-picture window. r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324072\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/assets/www/video_in_iframe.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PictureInPictureTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PictureInPictureController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/actors/GeckoViewPictureInPicturePlayerParent.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewPictureInPicture.sys.mjs"], "git_node": "92168877276e023a102a2538624ecf3c5bbbdaad", "git_parents": ["8644324c8a24280d48370d1861131fb76623441c"], "node": "f2683c0d59c1c56e42f233bdeee59e9058893649", "parents": ["f012b5f51a364cd815b700d96884101d945bc8de"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065581 - Let the embedder report that it closed the picture-in-picture window itself. r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324073\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PictureInPictureTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PictureInPictureController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/modules/geckoview/GeckoViewPictureInPicture.sys.mjs"], "git_node": "f876795489a6607ff8e5e17dcd0b5a815c4a517c", "git_parents": ["92168877276e023a102a2538624ecf3c5bbbdaad"], "node": "1fc8f6a2b81b48b61435c261d9801cbf7888689b", "parents": ["f2683c0d59c1c56e42f233bdeee59e9058893649"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065581 - Keep the source tab alive while its video is in a picture-in-picture window. r=geckoview-reviewers,ohall,kaya\n\nThe cloned video is painted from the source video, which stops painting once the source docShell is deactivated. The source session is deactivated when the user switches to another tab, and pages also commonly pause their video once they are hidden, so the picture-in-picture window would freeze.\n\nAdd SessionPictureInPicture.setKeepActive so the embedder can keep the source session active while its window shows one of that session's videos. GeckoView skips deactivating a session that has it set. Only the embedder knows when the window is gone and whether the session is still showing elsewhere, so once it clears the flag it is responsible for deactivating the session.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320563\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoViewTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoView.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PictureInPictureController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "690791ec9fc506b8ddb17fb5aebbd20dc14be6a1", "git_parents": ["f876795489a6607ff8e5e17dcd0b5a815c4a517c"], "node": "38c11a4e05d765314c4c1916e3495fe955c0afae", "parents": ["1fc8f6a2b81b48b61435c261d9801cbf7888689b"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065587 - Implement picture-in-picture in GeckoView Example. r=ohall,geckoview-reviewers\n\nGeckoViewActivity answers the session's picture-in-picture delegate by opening the session Gecko asks for and starting PictureInPictureActivity, which renders it and puts itself into native picture-in-picture mode. Expanding the window returns to the tab the video was playing in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320565\n", "files": ["mobile/android/geckoview_example/src/main/AndroidManifest.xml", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/GeckoViewActivity.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/PictureInPictureActivity.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/PipSessionHolder.java", "mobile/android/geckoview_example/src/main/res/values/strings.xml"], "git_node": "932b2e3b9060aaa4e64e3c35aa0cf378460219c5", "git_parents": ["690791ec9fc506b8ddb17fb5aebbd20dc14be6a1"], "node": "9d2d44dce85137cf1600774eabac3abb03908d06", "parents": ["38c11a4e05d765314c4c1916e3495fe955c0afae"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065581 - Drop picture-in-picture state when a session goes away. r=ohall,geckoview-reviewers,jonalmeida\n\nA source session that went away without its window being closed first left GeckoView holding its browsing context group, which a later picture-in-picture session could be handed. Forget the source's state, or the player's, when its session is destroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324964\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PictureInPictureTest.kt", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/GeckoViewActivity.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/PictureInPictureActivity.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/PipSessionHolder.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/TabSessionManager.java", "mobile/shared/modules/geckoview/GeckoViewPictureInPicture.sys.mjs"], "git_node": "eca95998cac4726c78cdb0c886914ea339574ce9", "git_parents": ["932b2e3b9060aaa4e64e3c35aa0cf378460219c5"], "node": "fd1baf763cf0d690a6f0718311b827d976f444b0", "parents": ["9d2d44dce85137cf1600774eabac3abb03908d06"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080998 - Show the existing picture-in-picture overlay on Android videos without controls. r=desktop-theme-reviewers,fluent-reviewers,kpatenio,bolsson,geckoview-reviewers,kcochrane,ohall\n\nWhen a video is in picture-in-picture, the source video shows an overlay\nsaying where the video went. On desktop this works whether or not the\nvideo has the controls attribute. On Android it only worked with\ncontrols: switchImpl() checked isMobile before isPictureInPictureVideo,\nso a video without controls always got NoControlsMobileImplWidget. That\nwidget only has markup for the click-to-play button, so the source video\nkept playing in the page next to the picture-in-picture window.\n\nThis moves the isPictureInPictureVideo check above isMobile, so Android\nreaches NoControlsPictureInPictureImplWidget and its existing overlay.\nNo new overlay is added, and desktop behavior is unchanged: the desktop\nbranch order is the same.\n\nIt also updates the overlay's icon and string on Android to match\nAndroid's picture-in-picture design. The icon is switched with\n-moz-platform: android in CSS. The string is set in both\nVideoControlsImplWidget and NoControlsPictureInPictureImplWidget, so it\nreads the same whether or not the video has controls.\n\nGeckoView tests check that the source video shows the message with and\nwithout controls, and that a video not in picture-in-picture shows none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324173\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/TestSupportChild.sys.mjs", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PictureInPictureTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "toolkit/content/widgets/videocontrols.js", "toolkit/locales/en-US/toolkit/global/videocontrols.ftl", "toolkit/themes/mobile/global/jar.mn", "toolkit/themes/shared/media/picture-in-picture-open-android.svg", "toolkit/themes/shared/media/videocontrols.css"], "git_node": "5dd3d9a7b3411384f2049facdac879a38d4c4683", "git_parents": ["eca95998cac4726c78cdb0c886914ea339574ce9"], "node": "8ea4126045bd67ff9c4b128a4e9ce3b54b9dedf8", "parents": ["fd1baf763cf0d690a6f0718311b827d976f444b0"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2081458 - Fall back to the sample index for oversized MP4 offsets. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333435\n", "files": ["dom/media/gtest/TestMP4Demuxer.cpp", "dom/media/mp4/SampleIterator.cpp"], "git_node": "e700d78a9aa8d6bfdbc90fbf559ab05ad44814df", "git_parents": ["5dd3d9a7b3411384f2049facdac879a38d4c4683"], "node": "0be9b586af8f3039a447349528b6e38dfb665fcc", "parents": ["8ea4126045bd67ff9c4b128a4e9ce3b54b9dedf8"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076491 - Update New Tab train-hop runtime metrics generation to handle new extra_keys on existing events. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331816\n", "files": ["browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs", "browser/extensions/newtab/mach_commands.py", "browser/extensions/newtab/test/xpcshell/test_NewTabGleanUtils.js", "browser/extensions/newtab/webext-glue/metrics/gen_runtime_metrics.py"], "git_node": "738d032c675cb8dac901ad09b4eebe6241f951c9", "git_parents": ["e700d78a9aa8d6bfdbc90fbf559ab05ad44814df"], "node": "e3bef2af4440b367afbfc66928a79ccd91cc2eeb", "parents": ["0be9b586af8f3039a447349528b6e38dfb665fcc"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076491 - Continue New Tab runtime metric registration past individual failures. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332482\n", "files": ["browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_NewTabGleanUtils.js"], "git_node": "2ca9f7cd685dd79efbe9447df02ddbdc3d5582d9", "git_parents": ["738d032c675cb8dac901ad09b4eebe6241f951c9"], "node": "aa5eff3492809f1a5646137107188d396842b337", "parents": ["e3bef2af4440b367afbfc66928a79ccd91cc2eeb"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076491 - Add a train-hop CI test for New Tab runtime events recording all extra keys. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332483\n", "files": ["browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_newtab_runtime_metrics.js"], "git_node": "4cbf7b1359baddbf69a75ec490c5de2e4d5dabe2", "git_parents": ["2ca9f7cd685dd79efbe9447df02ddbdc3d5582d9"], "node": "d46556c102cb00d2023fbcd83dec4c5916fd0290", "parents": ["aa5eff3492809f1a5646137107188d396842b337"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026491: Raise the file descriptor ceiling on macOS from 4096 to 65536. r=nika,necko-reviewers,jld,kershaw,valentin\n\nNSPR emulates poll() with select() on macOS, so a socket whose descriptor number is at or above the FD_SETSIZE the emulation was built with cannot be polled. Firefox therefore kept the descriptor limit at 4096 and asserts in AttachSocket that no socket reaches that number. A process that leaks descriptors hits the assert after a few thousand, which is the top macOS crash.\n\nThe three numbers move together to 65536 so that the emulation, the assert and the limit agree: FD_SETSIZE for the in-tree NSPR, the Darwin value in AttachSocket, and the soft limit set at startup. macOS accepts the larger limit in setrlimit and caps the effective value at kern.maxfilesperproc. The emulation's three fd_sets grow from 512 bytes to 8 KB each. They live on the stack and are zeroed per poll.\n\nThe new test occupies every descriptor below 4500 and checks that a request still goes through the socket transport service.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327425\n", "files": ["config/external/nspr/pr/moz.build", "netwerk/base/nsSocketTransportService2.cpp", "netwerk/test/unit/test_socket_above_fd_setsize.js", "netwerk/test/unit/xpcshell.toml", "toolkit/xre/nsAppRunner.cpp"], "git_node": "7dff24b3fccaf1d3f5d6eef97495012bd2ab7006", "git_parents": ["4cbf7b1359baddbf69a75ec490c5de2e4d5dabe2"], "node": "4819acb3bef5d76ecdf34700f13aede35d0046a9", "parents": ["d46556c102cb00d2023fbcd83dec4c5916fd0290"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2081576 - Ensure a result is shown when clicking on an empty urlbar r=urlbar-reviewers,mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333526\n", "files": ["browser/components/urlbar/tests/browser-editing/browser_readOnly.js"], "git_node": "c66f948754e6459005953937ea9bdb7c1d75d713", "git_parents": ["7dff24b3fccaf1d3f5d6eef97495012bd2ab7006"], "node": "418fd09244b1aceb5d47600f8fe1365582123742", "parents": ["4819acb3bef5d76ecdf34700f13aede35d0046a9"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the openh264-plugin and openh264-signing kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,ahal\n\nopenh264-plugin carries `run-on-repo-type: [hg]` and `clone-with: hg`,\nopenh264-signing the former. With the guards gone the plugin builds clone\nfrom GitHub and the signing tasks follow.\n\nVerified on staging-firefox (git-backed) on Oct 12: the linux64, macosx64\nand win64 plugin builds and their signing tasks completed. The dependent\nopenh264-symbol-upload kind is left out: it is broken on Mercurial too\n(missing upload tool) and its transform still pins Mercurial.\n\nLanding waits on https://github.com/mozilla/global-platform-admin/pull/7642\n(GitHub app install for the repo).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333138\n", "files": ["taskcluster/kinds/openh264-plugin/kind.yml", "taskcluster/kinds/openh264-signing/kind.yml"], "git_node": "6e315a4b68e096989bb036bcb3811aa63e31c9f7", "git_parents": ["c66f948754e6459005953937ea9bdb7c1d75d713"], "node": "116ee9797b38cbb06682374d664806319b506b9c", "parents": ["418fd09244b1aceb5d47600f8fe1365582123742"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the beetmover-integration and beetmover-rpm kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,ahal\n\nBoth kinds carry `run-on-repo-type: [hg]`, so nothing is uploaded from a\ngit-backed push. Beetmover tasks have no checkout, so removing the guard\nonly changes scheduling.\n\nVerified on staging-firefox (git-backed) on Oct 12: the three\nbeetmover-integration tasks and the beetmover-rpm task completed against\nthe staging buckets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333136\n", "files": ["taskcluster/kinds/beetmover-integration/kind.yml", "taskcluster/kinds/beetmover-rpm/kind.yml"], "git_node": "2ab279907960ca254eeb5271f43e97c3ae7e5810", "git_parents": ["6e315a4b68e096989bb036bcb3811aa63e31c9f7"], "node": "06687e86af3980f09a4558ab4dea2b2a90f20621", "parents": ["116ee9797b38cbb06682374d664806319b506b9c"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the build-mac-signing and geckodriver-signing kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,ahal\n\nBoth kinds carry `run-on-repo-type: [hg]`. Signing tasks have no checkout,\nso removing the guard only changes scheduling.\n\nVerified on staging-firefox (git-backed) on Oct 12: build-mac-signing on\nthe two mac builds and geckodriver-signing on linux64, macosx64 and win64\ncompleted with dep signing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333137\n", "files": ["taskcluster/kinds/build-mac-signing/kind.yml", "taskcluster/kinds/geckodriver-signing/kind.yml"], "git_node": "16913eecd427abef23871dad3ef95a94606de57a", "git_parents": ["2ab279907960ca254eeb5271f43e97c3ae7e5810"], "node": "d8d4dc9b4f2819048f325d8b9c3673c99953d943", "parents": ["06687e86af3980f09a4558ab4dea2b2a90f20621"], "tags": []}, {"author": "gazhibekova-hub \u003cgazhibekova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074214 - Provide location data for Smart Window weather integration r=bjohns\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328915\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/SmartWindowLocation.sys.mjs", "browser/components/aiwindow/models/moz.build", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js", "browser/components/aiwindow/models/tests/browser/browser_smartwindow_location.js", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs"], "git_node": "c60b5ea977a83183b0a2740e124f07c96079edf3", "git_parents": ["16913eecd427abef23871dad3ef95a94606de57a"], "node": "fe24a908be1f730771a5d2e699e08409082d7929", "parents": ["d8d4dc9b4f2819048f325d8b9c3673c99953d943"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 1: Make GeckoChildProcessHost refcounted, r=ipc-reviewers,necko-reviewers,media-playback-reviewers,mccr8,gfx-reviewers,kershaw,padenot,aosmond,device-api-reviewers,gstoll\n\nThe lifecycle of this type right now is very annoying and complex, and\nvarious child process implementations have had to do different things in\norder to deal with the unfortunate lifecycle properties.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318516\n", "files": ["dom/base/ChromeUtils.cpp", "dom/file/ipc/RemoteLazyInputStreamThread.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPProcessParent.cpp", "dom/media/gmp/GMPProcessParent.h", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h", "dom/webserial/SerialManagerChild.h", "gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUChild.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/vr/ipc/VRChild.cpp", "gfx/vr/ipc/VRChild.h", "gfx/vr/ipc/VRProcessManager.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/ForkServiceChild.cpp", "ipc/glue/ForkServiceChild.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/glue/UtilityProcessManager.h", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTestParent.h", "netwerk/base/nsIOService.h", "netwerk/ipc/SocketProcessHost.cpp", "netwerk/ipc/SocketProcessHost.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "xpcom/base/MemoryTelemetry.cpp"], "git_node": "a1d0ca64aee011d581d81b76bb9c7c703c82a48e", "git_parents": ["c60b5ea977a83183b0a2740e124f07c96079edf3"], "node": "ecf9a88f5ca0de11f59eb8375abc6c445d155779", "parents": ["fe24a908be1f730771a5d2e699e08409082d7929"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 2: Keep XRE_GetAsyncIOMessageLoop working later during shutdown, r=ipc-reviewers,mccr8\n\nThis keeps the object valid throughout IPC I/O thread shutdown tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322480\n", "files": ["ipc/glue/IOThread.cpp", "ipc/glue/IOThread.h"], "git_node": "38c1e4d79fbd7cad643f144a06b39753b553d7ea", "git_parents": ["a1d0ca64aee011d581d81b76bb9c7c703c82a48e"], "node": "78cfe429fd8c8a0ecb9c1c99281e4dd91e5dfae3", "parents": ["ecf9a88f5ca0de11f59eb8375abc6c445d155779"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 3: Keep IsOnCurrentThread working further into shutdown for MessageLoop::EventTarget, r=mccr8\n\nBefore this change, we would stop considering `IsOnCurrentThread` during\n`WillDestroyCurrentMessageLoop` callbacks, which could cause it to\nspuriously begin returning false while code is still running on the\nthread.\n\nI also refactored the code somewhat to make the timing of `BeginDestroy`\nmore consistently & explicitly before all other destruction observers\nhave been run.\n\nIn the future, I expect we'll want to make the IPC I/O thread behave\nmore like XPCOM threads, and have a clear atomic moment when runnables\nare no longer processed, and the queue is empty, but that was left as a\nfuture project.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328924\n", "files": ["ipc/chromium/src/base/message_loop.cc"], "git_node": "1bb9b9badba98d79382515134c5fa3ff36bb874a", "git_parents": ["38c1e4d79fbd7cad643f144a06b39753b553d7ea"], "node": "9c8ae80df0ca0f0067fa4dac42d70afd55864b54", "parents": ["78cfe429fd8c8a0ecb9c1c99281e4dd91e5dfae3"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080184 - Migrate bookmarkProperties.properties to Fluent. r=places-reviewers,fluent-reviewers,bolsson,mak\" for causing failures at browser_bookmarks_change_title.js.\n\nThis reverts commit e4051a1a86cbb7376bb33d3f1447a0f1db6da5b5.\n", "files": ["browser/components/places/content/bookmarkProperties.js", "browser/components/places/content/bookmarkProperties.xhtml", "browser/components/places/tests/browser/browser_bookmarkProperties_bookmarkAllTabs.js", "browser/locales/en-US/browser/editBookmarkOverlay.ftl", "browser/locales/en-US/chrome/browser/places/bookmarkProperties.properties", "browser/locales/jar.mn", "python/l10n/fluent_migrations/bug_2080184_bookmark_properties.py"], "git_node": "356780eff4dc2095bd9d1b56736a93bc0ae6653c", "git_parents": ["1bb9b9badba98d79382515134c5fa3ff36bb874a"], "node": "1ac92a822d81f6f95ee496d32c23cbc5b2f1f481", "parents": ["9c8ae80df0ca0f0067fa4dac42d70afd55864b54"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081663 - Add design token train-hop checks to the New Tab AGENTS.md r=ai4dev-reviewers,mconley,padenot DONTBUILD\n\nThe New Tab AGENTS.md now has a \"Design tokens\" section, so that agents\nimplementing or reviewing New Tab changes check each design token a\nchange references against Release. A token newer than Release gets a\nfallback to the token it aliases and a `@backward-compat` marker, as\nbug 2080654 needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333594\n", "files": ["browser/extensions/newtab/AGENTS.md"], "git_node": "d98971f7f3eec636414e48e4640d9020aebc898a", "git_parents": ["356780eff4dc2095bd9d1b56736a93bc0ae6653c"], "node": "5cdb58bd39431acaaf87d5e7647370e5341aedea", "parents": ["1ac92a822d81f6f95ee496d32c23cbc5b2f1f481"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081936 - Make root scrollcorner paint at the same z-index as root scrollbars. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nThis fixes some tests with the patch in bug 2081313 but I think it's\nworth landing separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333837\n", "files": ["layout/style/res/scrollbars.css"], "git_node": "d261a5340d8aebdc0f2261d7a90422aa0600eeed", "git_parents": ["d98971f7f3eec636414e48e4640d9020aebc898a"], "node": "c574e04d41b6f338d6ec4ee569abe21c40d25da1", "parents": ["5cdb58bd39431acaaf87d5e7647370e5341aedea"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2079798 - Make GetContextInfo return Maybe r=mccr8\n\nThis involves an inconsistent GlobalTeardownObserver behavior, where mParentGlobal is dropped for objects created before teardown, but it still exists for objects created after teardown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333327\n", "files": ["dom/notification/Notification.cpp", "dom/notification/Notification.h", "testing/web-platform/tests/notifications/crashtests/show-and-close.https.html"], "git_node": "0a93b2c0b9b03ed3bbcb0c94be1dd78c986885a6", "git_parents": ["d261a5340d8aebdc0f2261d7a90422aa0600eeed"], "node": "977281382ca8332f25441d5bd05361badc474427", "parents": ["c574e04d41b6f338d6ec4ee569abe21c40d25da1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081890 - Update intellij-markdown to version 0.7.17. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333821\n", "files": ["gradle/libs.versions.toml"], "git_node": "898d26c5e72ae42fc0b79cd3d8f0174f9c64d688", "git_parents": ["0a93b2c0b9b03ed3bbcb0c94be1dd78c986885a6"], "node": "ec49cdb576652692954feb9a83507e3c5c2cc727", "parents": ["977281382ca8332f25441d5bd05361badc474427"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077498 - Release mChannelParent on the main thread if ActorDestroy can't dispatch to it. r=necko-reviewers,valentin\n\nHttpChannelParent is not thread-safe refcounted, so when the dispatch from HttpBackgroundChannelParent::ActorDestroy fails, mChannelParent must not be released on the background thread.  Also assert the background thread in DetachStreamFilters, like AttachStreamFilter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330413\n", "files": ["netwerk/protocol/http/HttpBackgroundChannelParent.cpp"], "git_node": "da9ea9e8c548627b30cd2a09c711840fe2d040b0", "git_parents": ["898d26c5e72ae42fc0b79cd3d8f0174f9c64d688"], "node": "8825f2e5084391ee018adcd1283528364e8af2a3", "parents": ["ec49cdb576652692954feb9a83507e3c5c2cc727"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069153 - Add new copy mentioning site inclusions to signed out view of VPN settings - r=ip-protection-reviewers,fluent-reviewers,settings-reviewers,Gijs,bolsson,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332939\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "7fefb4e0ab3f41af960ec60e2df38155e72948a1", "git_parents": ["da9ea9e8c548627b30cd2a09c711840fe2d040b0"], "node": "9d4df2fde0b0918b3b0e21362153439c13795d19", "parents": ["8825f2e5084391ee018adcd1283528364e8af2a3"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2075412 - Slugs support dupes with date versioning - r=omarg,rrando\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332976\n", "files": ["browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js"], "git_node": "fd13233bfcf9e198cfb3def81630a787679bf829", "git_parents": ["7fefb4e0ab3f41af960ec60e2df38155e72948a1"], "node": "c5911dbd443ce9a59aa48ba006c07cd98b1bfa95", "parents": ["9d4df2fde0b0918b3b0e21362153439c13795d19"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077497 - Assert the owning thread in the WebTransport session and stream classes and arm the receive pipe on it. r=necko-reviewers,valentin\n\nThe HTTP/2 WebTransport classes had no thread assertions, and Http2WebTransportStream::OnOutputStreamReady re-armed the pipe with no target, so its callback ran on whichever thread drained the other end.  Pass the owner thread, as Http3WebTransportStream does, and add assertions to the entry points that the proxy classes reach on the socket thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330412\n", "files": ["netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportStream.cpp", "netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportStream.cpp"], "git_node": "707bf4045073ca79ad801b4ff1cd759d96a61013", "git_parents": ["fd13233bfcf9e198cfb3def81630a787679bf829"], "node": "690f022964ec6f5a99563dd9823fc37b98608a27", "parents": ["c5911dbd443ce9a59aa48ba006c07cd98b1bfa95"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073242 - Cover first-character telemetry across search handoff r=jlewis\n\nThis commit adds a test case that documents a failure to report the\ntime-to-first-character telemetry metric when the full-page chat\nmoves into the sidebar due to web search and continues the response.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329273\n", "files": ["browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search_telemetry.js"], "git_node": "4049b401677fa3a239e9501e466b6452562a8f03", "git_parents": ["707bf4045073ca79ad801b4ff1cd759d96a61013"], "node": "cd44c2bb9f91fce4847a0b9734d26fc3b1eeaf97", "parents": ["690f022964ec6f5a99563dd9823fc37b98608a27"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030926 - Don't mark errorsummary groups as failed for crashes of tests that will be retried. r=florian\n\nCrashes in runs that are retried are logged with quiet=True, but the\nerrorsummary formatter ignored it, so a group stayed ERROR even when the\nretry passed. The remote xpcshell harness also didn't pass quiet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328806\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/errorsummary.py", "testing/mozbase/mozlog/tests/test_errorsummary.py", "testing/xpcshell/remotexpcshelltests.py", "testing/xpcshell/selftest.py"], "git_node": "c9da002415254aa1d36525ead2554ffccf876d03", "git_parents": ["4049b401677fa3a239e9501e466b6452562a8f03"], "node": "c51219e7ff24b84a27fdf1dc9ea41f271e037209", "parents": ["cd44c2bb9f91fce4847a0b9734d26fc3b1eeaf97"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078836 - Add the travel widget strings r=fluent-reviewers,bolsson\n\nThe title, Customize panel toggle label, menu button label and Learn more\nitem of the Travel widget have been added. The Learn more message copies\nits translations from the identical Weather message through a migration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333407\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl", "python/l10n/fluent_migrations/bug_2078836_newtab_travel_widget_learn_more.py"], "git_node": "b9caaa3199279fd3b4ff7e04ff558cb035df1218", "git_parents": ["c9da002415254aa1d36525ead2554ffccf876d03"], "node": "2119873083906f9c82ca9120584aba9bba154e4d", "parents": ["c51219e7ff24b84a27fdf1dc9ea41f271e037209"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078838 - Add the travel widget scaffold r=reemhamz\n\nThe travel widget has been added to the widget row as an empty card with\nthe standard header and context menu, in medium and large sizes, with\nits Customize panel toggle. It is off everywhere by default, and a Nimbus\nrollout can turn it on through its `widgetTravel` namespace.\n\nA stub `TravelFeed` broadcasts an empty result set into a new `Travel`\nslice whenever the widget is enabled, so the data path from the parent\nprocess to the page is in place for the Merino place lookups. The\ncomponent does not read the slice yet; the search form will.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333408\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Travel/_Travel.scss", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/Widgets/TravelFeed.sys.mjs", "browser/extensions/newtab/test/jest/common/Reducers.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_TravelFeed.js", "browser/extensions/newtab/test/xpcshell/xpcshell.toml"], "git_node": "ded7e9892b4d307fbede20da164b56e3fdafea9e", "git_parents": ["b9caaa3199279fd3b4ff7e04ff558cb035df1218"], "node": "aa8bfa7d029bb7a8226861c2b79d94ee6109428e", "parents": ["2119873083906f9c82ca9120584aba9bba154e4d"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2079729 - Clean MTA data r=win-reviewers,handyman,chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332064\n", "files": ["ipc/mscom/EnsureMTA.cpp", "ipc/mscom/EnsureMTA.h", "ipc/mscom/ProcessRuntime.cpp", "toolkit/components/glean/ipc/FOGIPC.cpp"], "git_node": "557ca231b8c536c8e4f3336d77597ac2fc1a26b8", "git_parents": ["ded7e9892b4d307fbede20da164b56e3fdafea9e"], "node": "c167f7f81d6e7b1dcc43df5abec4bc8915f0dfc0", "parents": ["aa8bfa7d029bb7a8226861c2b79d94ee6109428e"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081815 - Update strings for site inclusions CFRs - r=fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333888\n", "files": ["browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "e8097c7ae3877fb9885aa1cc7fb7a542fed6f3b3", "git_parents": ["557ca231b8c536c8e4f3336d77597ac2fc1a26b8"], "node": "82805797115faaa7d16248f7a7915bcbecfebbe5", "parents": ["c167f7f81d6e7b1dcc43df5abec4bc8915f0dfc0"], "tags": []}, {"author": "mimi \u003cmjung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081898 - Updates Welcome Back Onboarding container styles in PanelTestProvider r=omc-reviewers,yazan\n\nUpdates the Welcome Back Onboarding spotlight container with the finalized [figma styles](https://www.figma.com/design/AAl5FaQxlyal6Q0grRlh9w/Make-Firefox-Theirs?node-id=618-14735&t=noEsRjUcVaVeQZJD-0). The Spotlight is being surfaced in PanelTestProvider for the time being as it'll be an experiment rather than landing in-tree.\n\nNote that the pill container and responsive mode is covered by other tickets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333810\n", "files": ["browser/components/asrouter/modules/PanelTestProvider.sys.mjs"], "git_node": "44d3b57040d17f8f6d86238364e9344e694e9c4b", "git_parents": ["e8097c7ae3877fb9885aa1cc7fb7a542fed6f3b3"], "node": "ff17bee65ffd58f9103b520a9f71f13a0b139afb", "parents": ["82805797115faaa7d16248f7a7915bcbecfebbe5"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2081490. Clean up jpegxl wpt expectations inis. r=gfx-reviewers,bradwerth\n\nI ran these with many re-triggers on try, no failures. The wpt update bot sometimes seems to do this when adding/changing tests in the same dir.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333436\n", "files": ["testing/web-platform/meta/jpegxl/custom-primaries-icc-overflow-crash.html.ini", "testing/web-platform/meta/jpegxl/incomplete-codestream-trailing-box-crash.html.ini"], "git_node": "8e9fd77fff0c3b62efed650b00e473db1600cd0f", "git_parents": ["44d3b57040d17f8f6d86238364e9344e694e9c4b"], "node": "92a05bf28e990d840ef2ce2e900854854adeed2c", "parents": ["ff17bee65ffd58f9103b520a9f71f13a0b139afb"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2074048: Expose aria-keyshortcuts Meta and Alt as Command and Option on macOS r=accessibility-platform-reviewers,eeejay\n\nWithout this patch, keyshortcuts that use `alt` and `meta` are read literally\non macOS. With this patch, those keys are mapped to `option` and\n`command` respectively. The `aria-keyshortcuts` property is still\nexposed via AXKeyShortcutsValue and everything else about exposure,\nincluding malformed values passed via this property, is unchanged.\n\nThis matches WebKit's behaviour. I've used their test cases below, too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333849\n", "files": ["accessible/mac/mozAccessible.mm", "accessible/tests/browser/mac/browser_aria_keyshortcuts.js"], "git_node": "633f1077808716ada09b96e0ab50d9b37bc2217d", "git_parents": ["8e9fd77fff0c3b62efed650b00e473db1600cd0f"], "node": "39378bab4ba908c5b39f94b3e7c02aa344ec1bad", "parents": ["92a05bf28e990d840ef2ce2e900854854adeed2c"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054925 - Don't drop SERP engagements when the browsing context is replaced during a top level navigation - r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319766\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/unit/test_urlTelemetry.js", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": "ac977b3dcbcfeb671332bcb2555bb70a5c1338ae", "git_parents": ["633f1077808716ada09b96e0ab50d9b37bc2217d"], "node": "34d588cbcf67a075bb9072c37b1b93a1e18648ad", "parents": ["39378bab4ba908c5b39f94b3e7c02aa344ec1bad"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081770 - Fix test_ext_l10n.js with Android isolated process. r=extension-reviewers,fluent-reviewers,robwu,bolsson\n\nThe test setup wrote test.ftl into the profile's temporary directory,\nwhich Android isolated processes are unable to read.\n\nInstead, ship test.ftl in the test's data directory instead, which the\nharness pushes to location that can be read by isolated processes. As\na result, the key must be made longer in order to satisfy fluent-lint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333741\n", "files": ["toolkit/components/extensions/test/xpcshell/data/l10n/test.ftl", "toolkit/components/extensions/test/xpcshell/test_ext_l10n.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml"], "git_node": "a8b2280603b8c70e5e438d86a7affd90c4d6ba59", "git_parents": ["ac977b3dcbcfeb671332bcb2555bb70a5c1338ae"], "node": "d78bb78535bb4fe1c02b14dcdebb0359fbb39de9", "parents": ["34d588cbcf67a075bb9072c37b1b93a1e18648ad"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082166 - Update android nightly application-services version bump to 7afac3d5d04ee81490e9a0947216c1ea15addd57 r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333922\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "797788eb866a95770e0bb6d143e1cf76805eec4f", "git_parents": ["a8b2280603b8c70e5e438d86a7affd90c4d6ba59"], "node": "07d2cc0a12548867501bc1e7b523269617257093", "parents": ["d78bb78535bb4fe1c02b14dcdebb0359fbb39de9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082069 - Retry hosts that answered HEAD without an HSTS header with GET when updating the HSTS preload list. r=keeler\n\nSome servers only send Strict-Transport-Security on GET responses, so they were recorded as no-header. After\nthe retry pass, hosts that answered without a header (other than 429) are probed again with GET, and a header\nfound that way replaces the HEAD result. Their records in the probe results artifact carry get: true. Both\nmethods now finish as soon as the headers arrive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333923\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "2f82b7f898f5b10f03916a56eaa39bd8038f26cb", "git_parents": ["797788eb866a95770e0bb6d143e1cf76805eec4f"], "node": "e4d82acccf47befb6f7f58dd322d4f7d85ab45e8", "parents": ["07d2cc0a12548867501bc1e7b523269617257093"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081560: Fix GCC build failure in the APZ bridge test.\n\nMove `APZBridgeTester` out of the anonymous namespace to fix the GCC `-Werror=subobject-linkage` build failure in `build-linux64-base-toolchains/debug`.\n\nThis follows the [integration-tree sheriff guidance](https://wiki.mozilla.org/Tree_Rules/Inbound#Sheriff_Duty) for correcting simple build failures with a quick follow-up patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333952\n", "files": ["gfx/layers/apz/test/gtest/TestAPZBridge.cpp"], "git_node": "f57596046101197e1bc1e64dfcb198a29aa480b9", "git_parents": ["2f82b7f898f5b10f03916a56eaa39bd8038f26cb"], "node": "1e98c2e1326377c9ab355315cdc0639d0ba122c4", "parents": ["e4d82acccf47befb6f7f58dd322d4f7d85ab45e8"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for PrefsFeed properties created by a lazy pref getter and a lazy Set (TS2339, TS2345, TS2551) by declaring them as class fields r=thecount\n\ninActivationWindowState is defined by XPCOMUtils.defineLazyPreferenceGetter and _wroteSpaceDefaults by a ??= assignment, so tsc saw neither as a member, and the space pref's default from PREFS_CONFIG is now cast to the boolean that setBoolPref requires; PrefsFeed now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332531\n", "files": ["browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "59426b7c3f57f1c6f0965e3ccdd690cf62cbb7cd", "git_parents": ["f57596046101197e1bc1e64dfcb198a29aa480b9"], "node": "592c86653925705fc0b99ed2431aba03a8f31416", "parents": ["1e98c2e1326377c9ab355315cdc0639d0ba122c4"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Pass TopSitesFeed.refresh's isStartup to getLinksWithDefaults as a boolean so that later screenshot updates are not marked as startup actions r=thecount\n\nrefresh passed { isStartup } where getLinksWithDefaults expects a boolean, so _fetchScreenshot dispatched SCREENSHOT_UPDATED with an always-truthy meta.isStartup and init-store.mjs dropped every one of them on an about:home loaded from the startup cache; only rankTopSites wants the object form, so it is now wrapped there, and tsc had reported the mismatch as TS2345.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332532\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "1a5a11c4576bfb64f7ad63a449351469f1feaa2b", "git_parents": ["59426b7c3f57f1c6f0965e3ccdd690cf62cbb7cd"], "node": "ce2ce1a43db36b0d63763ed329ce6ca16f574f0c", "parents": ["592c86653925705fc0b99ed2431aba03a8f31416"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for the fetch wrappers in TopSitesFeed and AdsFeed (TS2556) by typing their rest arguments as fetch's parameters r=thecount\n\nBoth wrappers spread an untyped ...args into the global fetch, which tsc rejects because it cannot tell the array matches fetch's two parameters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332533\n", "files": ["browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs"], "git_node": "5caaa4f9f68ce02741a50449c748fb626b0bee3b", "git_parents": ["1a5a11c4576bfb64f7ad63a449351469f1feaa2b"], "node": "01bfd0297b090ff320a859f7424ebfee7301837f", "parents": ["ce2ce1a43db36b0d63763ed329ce6ca16f574f0c"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix the TypeScript error for ContileIntegration's OHTTP headers (TS2740) by passing ohttpRequest a copy of the options instead of replacing their Headers r=thecount\n\nThe request options held a Headers instance that was overwritten in place with a plain object for ObliviousHTTP.ohttpRequest, so tsc saw an object assigned where it inferred Headers; ohttpRequest now gets a copy with Object.fromEntries(headers), which is what it received before, and the fetch path still gets the Headers instance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332534\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs"], "git_node": "aca23f9f7340d2b3fe57ce2fea7102bb9fd33d5e", "git_parents": ["5caaa4f9f68ce02741a50449c748fb626b0bee3b"], "node": "d0285a9b7cd6e4f5082833e7a27976716dd60d6f", "parents": ["01bfd0297b090ff320a859f7424ebfee7301837f"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for TopSitesFeed._pinSiteAt's JSDoc (TS2339), which put each name before its type and documented the site's properties as separate parameters r=thecount\n\ntsc read the first @param as giving the destructured site object the type String, so none of customScreenshotURL, label, url or searchTopSite existed on it; TopSitesFeed now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332535\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "28486bda6a266497e60afc4f073ff46cb7108cbe", "git_parents": ["aca23f9f7340d2b3fe57ce2fea7102bb9fd33d5e"], "node": "02da8aff82fd36b7846f1f0c19018d1eec8b86eb", "parents": ["d0285a9b7cd6e4f5082833e7a27976716dd60d6f"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for PersistentCache.get calls without a key (TS2554) by marking the key optional in its JSDoc r=thecount\n\nget returns the whole cache when called without a key, as its JSDoc already said in prose, but the key was typed as required, so calls like TopStoriesFeed.loadCachedData's were flagged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332536\n", "files": ["browser/extensions/newtab/lib/PersistentCache.sys.mjs"], "git_node": "0de6524d9914bf998465df4e20d73de833c94e0d", "git_parents": ["28486bda6a266497e60afc4f073ff46cb7108cbe"], "node": "5296d91c29f8d58f897e66a2bcb8fbcd087f72a5", "parents": ["02da8aff82fd36b7846f1f0c19018d1eec8b86eb"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for TopStoriesFeed's parsed endpoint responses (TS2339) since the generated Response.json type resolves to JSON r=thecount\n\ntools/@types declares Response.json as returning Promise\u003cJSON\u003e, the JSON namespace object, so every property read on the stories and topics bodies was flagged; both bodies are now typed as object, and TopStoriesFeed now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332537\n", "files": ["browser/extensions/newtab/lib/TopStoriesFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "6e9e30a9969634cf7a5d8874b9083cd5056cd2d6", "git_parents": ["0de6524d9914bf998465df4e20d73de833c94e0d"], "node": "beea31d40c72fb2b000a183e1e49cf099fb47879", "parents": ["5296d91c29f8d58f897e66a2bcb8fbcd087f72a5"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Record topic_position on newtab.inline_selection_click since TelemetryFeed read a position field that InterestPicker never sends r=thecount\n\nInterestPicker dispatches INLINE_SELECTION_CLICK with topic_position, the extra key metrics.yaml declares, but handleInlineSelectionUserEvent destructured and recorded position instead, which was always undefined, so topic_position has been empty since bug 1954763, which renamed the position extra key to section_position but replaced topic_position instead of position here; tsc reported the unknown key as TS2353.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332538\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "b9d0802da3b91d16cec53b4b258f08304a59edf9", "git_parents": ["6e9e30a9969634cf7a5d8874b9083cd5056cd2d6"], "node": "db3cc98fffecd3aa76ea3680ff339aa98b816392", "parents": ["beea31d40c72fb2b000a183e1e49cf099fb47879"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for recordOrQueueEvent calls without a callback (TS2554) by marking the callback optional in its JSDoc r=thecount\n\nrecordOrQueueEvent already calls its callback with optional chaining, and the topSitesImpression and topSitesDismiss paths only record to the newtab-content ping, so they pass none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332539\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs"], "git_node": "fe70d362c27160dcd512fe00609056fbde78218e", "git_parents": ["b9d0802da3b91d16cec53b4b258f08304a59edf9"], "node": "f5b64648d0f49b2da6fa7b47c90d2c5a2251ca9b", "parents": ["db3cc98fffecd3aa76ea3680ff339aa98b816392"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for subtracting Dates in TelemetryFeed's followed-topics sort (TS2362, TS2363) by comparing their getTime values r=thecount\n\nSubtracting two Date objects works through valueOf, but tsc only allows arithmetic on numbers, so the sort now compares getTime results, which gives the same ordering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332540\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs"], "git_node": "ac322d20ad0c2eb9d8ac4dce457df9530188082a", "git_parents": ["fe70d362c27160dcd512fe00609056fbde78218e"], "node": "60d43db4a49ecda3f7d15ca0454d50d0c2990097", "parents": ["f5b64648d0f49b2da6fa7b47c90d2c5a2251ca9b"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix the TypeScript error for TelemetryFeed.getActiveChromeWindow's return type (TS2740) by documenting the mozIDOMWindowProxy it returns r=thecount\n\nServices.focus.activeWindow is a mozIDOMWindowProxy rather than a Window, and isDwellTargetInForeground only compares it by identity with a tab's owner window, so both JSDoc types now say mozIDOMWindowProxy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332541\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs"], "git_node": "d3933346639834ba915837adf57e943cb8f53fd5", "git_parents": ["ac322d20ad0c2eb9d8ac4dce457df9530188082a"], "node": "1608b8be948c0d831cdfa416246af78b6df15dbd", "parents": ["60d43db4a49ecda3f7d15ca0454d50d0c2990097"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for TelemetryFeed's sponsored content prefs (TS2339) by declaring the lazy pref getters as class fields r=thecount\n\nSHOW_SPONSORED_STORIES_ENABLED and SHOW_SPONSORED_TOPSITES_ENABLED are defined by XPCOMUtils.defineLazyPreferenceGetter in the constructor, so tsc did not see them as members; TelemetryFeed now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332542\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "1a864c8d4726028be73edeff37a02b848978360a", "git_parents": ["d3933346639834ba915837adf57e943cb8f53fd5"], "node": "27f963ef6c38e6b92e6c6e86a52ffa708f7b08e2", "parents": ["1608b8be948c0d831cdfa416246af78b6df15dbd"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Send AdsFeed.fetchData's content-type header on OHTTP requests by building the headers as a plain object instead of a Headers instance r=thecount\n\nObliviousHTTP.ohttpRequest copies request headers with Object.keys, which finds nothing on a Headers instance, so unified ads requests made over OHTTP since bug 1968982 have gone out without content-type: application/json; tsc reported the Headers instance passed to fetch as TS2345.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332543\n", "files": ["browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsFeed.js"], "git_node": "462dfdf155eae44a8d3bc8bfd186930976ea5b82", "git_parents": ["1a864c8d4726028be73edeff37a02b848978360a"], "node": "928a90fda889d37b15f3b280c8e5c2484796a9eb", "parents": ["27f963ef6c38e6b92e6c6e86a52ffa708f7b08e2"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix the TypeScript error for AdsFeed.deleteUserAdsData's request headers (TS2322) by passing them as a plain object r=thecount\n\nThe generated HeadersInit type in tools/@types follows the WebIDL union and does not include Headers, so a Headers instance in fetch's init was rejected; a plain object sends the same content-type header.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332544\n", "files": ["browser/extensions/newtab/lib/AdsFeed.sys.mjs"], "git_node": "079fdbd20cd1180c5c62983c0d459a054f222f6d", "git_parents": ["462dfdf155eae44a8d3bc8bfd186930976ea5b82"], "node": "488d00790099f66a5ee4cb6b0578d7e65cb4ae31", "parents": ["928a90fda889d37b15f3b280c8e5c2484796a9eb"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080304 - Fix TypeScript errors for AdsFeed's ad type flags and response objects (TS2339, TS2345) whose JSDoc described them as arrays r=thecount\n\nsupportedAdTypes is the { tiles, spocs } object from getSupportedAdTypes and _normalizeTileData takes placements keyed by name, but both were documented as Array, and returnData and the spocs accumulator started as untyped {} literals; AdsFeed now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332545\n", "files": ["browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "4a61eaacfee2d35490e9defcfb6339e4889638d5", "git_parents": ["079fdbd20cd1180c5c62983c0d459a054f222f6d"], "node": "1fd28a18f87a3f22aa1dded38cac74cfd663fcf1", "parents": ["488d00790099f66a5ee4cb6b0578d7e65cb4ae31"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076491 - Add a train-hop CI test for New Tab runtime events recording all extra keys. r=mconley\" for causing failures at test_NewTabGleanUtils.js.\n\nThis reverts commit 4cbf7b1359baddbf69a75ec490c5de2e4d5dabe2.\n\nRevert \"Bug 2076491 - Continue New Tab runtime metric registration past individual failures. r=mconley\"\n\nThis reverts commit 2ca9f7cd685dd79efbe9447df02ddbdc3d5582d9.\n\nRevert \"Bug 2076491 - Update New Tab train-hop runtime metrics generation to handle new extra_keys on existing events. r=mconley\"\n\nThis reverts commit 738d032c675cb8dac901ad09b4eebe6241f951c9.\n", "files": ["browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs", "browser/extensions/newtab/mach_commands.py", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_newtab_runtime_metrics.js", "browser/extensions/newtab/test/xpcshell/test_NewTabGleanUtils.js", "browser/extensions/newtab/webext-glue/metrics/gen_runtime_metrics.py"], "git_node": "fdf5d518a28f309206f656ccc2c943f4bd76e29f", "git_parents": ["4a61eaacfee2d35490e9defcfb6339e4889638d5"], "node": "3fde972a91ce8304840193482974ee64937ec054", "parents": ["1fd28a18f87a3f22aa1dded38cac74cfd663fcf1"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1564615 - Part 3: Keep IsOnCurrentThread working further into shutdown for MessageLoop::EventTarget, r=mccr8\" for causing failures at MozPromise.h.\n\nThis reverts commit 1bb9b9badba98d79382515134c5fa3ff36bb874a.\n\nRevert \"Bug 1564615 - Part 2: Keep XRE_GetAsyncIOMessageLoop working later during shutdown, r=ipc-reviewers,mccr8\"\n\nThis reverts commit 38c1e4d79fbd7cad643f144a06b39753b553d7ea.\n\nRevert \"Bug 1564615 - Part 1: Make GeckoChildProcessHost refcounted, r=ipc-reviewers,necko-reviewers,media-playback-reviewers,mccr8,gfx-reviewers,kershaw,padenot,aosmond,device-api-reviewers,gstoll\"\n\nThis reverts commit a1d0ca64aee011d581d81b76bb9c7c703c82a48e.\n", "files": ["dom/base/ChromeUtils.cpp", "dom/file/ipc/RemoteLazyInputStreamThread.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPProcessParent.cpp", "dom/media/gmp/GMPProcessParent.h", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h", "dom/webserial/SerialManagerChild.h", "gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUChild.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/vr/ipc/VRChild.cpp", "gfx/vr/ipc/VRChild.h", "gfx/vr/ipc/VRProcessManager.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/chromium/src/base/message_loop.cc", "ipc/glue/ForkServiceChild.cpp", "ipc/glue/ForkServiceChild.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/IOThread.cpp", "ipc/glue/IOThread.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/glue/UtilityProcessManager.h", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "ipc/ipdl/