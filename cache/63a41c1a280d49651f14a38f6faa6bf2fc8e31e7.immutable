": ["b5ffa69526cd4ba7538d1250424777d313cc1d6f"], "tags": []}], "date": 1792156097, "git_changesets": ["23d0b51b3caa6d3b05b99404235c43c8d787258e"], "user": "ffxbld@lando.moz.tools"}, "45574": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging c87b810aa1f3f79bc24bc4294061826c24051448 with FIREFOX-ANDROID_159_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "841567e2918fe15ea13388d9728a510136b39bdb", "git_parents": ["23d0b51b3caa6d3b05b99404235c43c8d787258e"], "node": "3d175a1d248687833d0a746abd6f472c3f658db3", "parents": ["c6cc7f183e328c0c25b6e351a58cd2859c556187"], "tags": []}], "date": 1792157896, "git_changesets": ["841567e2918fe15ea13388d9728a510136b39bdb"], "user": "ffxbld@lando.moz.tools"}, "45575": {"changesets": [{"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082480 - Update isolated_process WPT reftest test expectations. r=geckoview-reviewers,m_kato\n\nThese tests now pass, likely due to 1988531 enabling the NDK decoder\nfor isolated process tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334152\n", "files": ["testing/web-platform/meta/css/compositing/mix-blend-mode/mix-blend-mode-video-sibling.html.ini", "testing/web-platform/meta/css/compositing/mix-blend-mode/mix-blend-mode-video.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/container-for-cue.html.ini"], "git_node": "1e8a7c462b39741127290bb77f0c51cc1fe315a0", "git_parents": ["8014960797439064c025f6bbc6a236558bd4f35f"], "node": "adbaebbb720a1eb555878647342fe4cbbf761ed7", "parents": ["21750dc4c701dcf4b9c666edc1e56c52f6e48077"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082480 - Run WPT reftests/crashtests on GeckoView with isolated process. r=geckoview-reviewers,m_kato\n\nThese jobs previously ran on the `debug-isolated-process` build and\nwere try-only (selectable only with `mach try fuzzy --full`). They\nwere lost altogether when bug 1977950 replaced that build with the\n`geckoview-isolated-process` variant.\n\nThis adds the variant to both suites and schedules them as tier 1 on\nbuilt-projects for `android-em.*/debug`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334153\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "305cddfbad1096df3cf38f7800b881af8cae8703", "git_parents": ["1e8a7c462b39741127290bb77f0c51cc1fe315a0"], "node": "5528b9daba32b9408d68aab4c00a5bf916683848", "parents": ["adbaebbb720a1eb555878647342fe4cbbf761ed7"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079891 - Add open Smart Page slug to chat context so that page can be edited. r=mzhang,mlucks,tetchart\n\nAdd dust js style {#\u003cvar\u003e} {/\u003cvar}to allow prompt sections to be enabled when a param exists.\n\nNote we're including the page slug for the Open page, and for @mentions as well\n\nCompanion PR for the prompts (includes prompt changes for one other patch)\nhttps://github.com/Firefox-AI/ai-window-remote-settings-prompts/pull/226\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333281\n", "files": ["browser/components/aiwindow/models/ChatUtils.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab.js", "browser/components/aiwindow/models/tests/xpcshell/test_ChatUtils.js", "browser/components/aiwindow/models/tests/xpcshell/test_PromptLoader_BrowserContext.js", "browser/components/aiwindow/models/tests/xpcshell/test_Utils.js", "browser/components/aiwindow/models/tests/xpcshell/xpcshell.toml", "browser/components/aiwindow/ui/modules/UrlTokenizer.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js"], "git_node": "43eb2debb50ce1f59659d05fe4d27f8a1e770f8d", "git_parents": ["305cddfbad1096df3cf38f7800b881af8cae8703"], "node": "6e5995bd9df032a86d7f63f941ef583abdb8a8b6", "parents": ["5528b9daba32b9408d68aab4c00a5bf916683848"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079888 - Add layout feature to List component. r=omarg,tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333310\n", "files": ["browser/components/aiwindow/models/aitab/component_schema.json", "browser/components/aiwindow/models/tests/browser/browser_aitab_catalog.js"], "git_node": "97c8d6bb7d27c2dd548660d87988fe0893a47b0b", "git_parents": ["43eb2debb50ce1f59659d05fe4d27f8a1e770f8d"], "node": "ecd2a4eaaffedbd206a7655be532c710c057c1f2", "parents": ["6e5995bd9df032a86d7f63f941ef583abdb8a8b6"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018318 - Update infobar.css to pass use-design-tokens r=desktop-theme-reviewers,reusable-components-reviewers,akulyk,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330053\n", "files": ["stylelint-rollouts.config.js", "toolkit/content/widgets/infobar.css"], "git_node": "6222355f70e016f3774ee08827e42db5accb3de2", "git_parents": ["97c8d6bb7d27c2dd548660d87988fe0893a47b0b"], "node": "f991528a6fb6d17727fc2d781700b85bc6f03429", "parents": ["ecd2a4eaaffedbd206a7655be532c710c057c1f2"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065871 - Picture of the Day: add the dated header and neutral picture strings. r=bolsson,fluent-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333336\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "11873147dca1bc619a83b818565191c3cc751b5e", "git_parents": ["6222355f70e016f3774ee08827e42db5accb3de2"], "node": "241efbd30a51c1a696ae9889e1648c9cdd2e827c", "parents": ["f991528a6fb6d17727fc2d781700b85bc6f03429"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065871 - Picture of the Day: show the previous picture while today's is the wallpaper. r=nina-py,fluent-reviewers,bolsson\n\nWhen today's picture was set as the wallpaper, the same image showed twice on the page. The widget now shows the previous day's picture from Merino's new `previous` field, dated in the header. Set wallpaper applies to whichever picture is showing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333337\n", "files": ["browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/PictureOfTheDay.jsx", "browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/PictureOfTheDay.test.jsx", "browser/extensions/newtab/test/xpcshell/test_PictureOfTheDayFeed.js", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "78e6a47ccb5eb24a258c240a54c4ebb4e5784bc0", "git_parents": ["11873147dca1bc619a83b818565191c3cc751b5e"], "node": "adcecf46903e3c8434c011a1c904b5cdb6b7c332", "parents": ["241efbd30a51c1a696ae9889e1648c9cdd2e827c"], "tags": []}, {"author": "Shravan Narayan \u003cshravanrn@gmail.com\u003e", "branch": "default", "desc": "Bug 2077405 - Update rlbox to avoid duplicate reads of sandbox data r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330315\n", "files": ["third_party/rlbox/include/rlbox.hpp", "third_party/rlbox/include/rlbox_conversion.hpp", "third_party/rlbox/include/rlbox_helpers.hpp", "third_party/rlbox/include/rlbox_range.hpp", "third_party/rlbox/include/rlbox_sandbox.hpp", "third_party/rlbox/include/rlbox_stdlib.hpp", "third_party/rlbox/include/rlbox_struct_support.hpp", "third_party/rlbox/moz.yaml", "third_party/rlbox/rlbox-updates.patch"], "git_node": "54f25a462908003df4b0391afb4fd7abc1b65174", "git_parents": ["78e6a47ccb5eb24a258c240a54c4ebb4e5784bc0"], "node": "ded05538821264bbceb805b6bafe4a17a8199467", "parents": ["adcecf46903e3c8434c011a1c904b5cdb6b7c332"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072855 - Don't leak `CC` and `CFLAGS` into the environment of the process reading gyp files r=firefox-build-system-reviewers,nalexander\n\n`GypProcessor` set `CC` and `CFLAGS` in `os.environ` of the calling\nprocess, because the NSS gyp files shell out to `$CC`.\n`./mach mochitest` regenerates the build backend in process through\nmoztest's `BuildBackendLoader`, so both variables stay set for the\nrest of the mach invocation.\n\nThe gradle run in `./mach android install-geckoview-test_runner` then\ninherits `CC`. `MachTasksPlugin`'s `normalizedMachEnv` rewrites it from\nthe `CC` subst, which is a list, as\n`/path/clang,--target=x86_64-linux-android26`, and the reentrant\nconfigure in `:machBuildFaster` fails with\n\"Cannot find the target C compiler\".\n\nGyp files are loaded in `BuildReader`'s `ProcessPoolExecutor` workers,\nso set both variables through the pool's initializer and leave the\nparent's environment alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331520\n", "files": ["python/mozbuild/mozbuild/frontend/gyp_reader.py", "python/mozbuild/mozbuild/frontend/reader.py", "python/mozbuild/mozbuild/test/frontend/data/gyp-env/test.gyp", "python/mozbuild/mozbuild/test/frontend/test_gyp_reader.py", "python/mozbuild/mozbuild/test/python.toml", "tools/moztreedocs/__init__.py"], "git_node": "426e4f1e076380cf59ef654d8e234f3383ee27c4", "git_parents": ["54f25a462908003df4b0391afb4fd7abc1b65174"], "node": "0d65c67af78d3c7fc141e5a92bca0c2ce6cb8418", "parents": ["ded05538821264bbceb805b6bafe4a17a8199467"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080467 - Run testExtensionProcessCrash in a separate runtime with the extension process enabled. r=geckoview-reviewers,android-addons-reviewers,robwu,jonalmeida\n\nThe shared junit runtime starts with extensions.webextensions.remote=false and ExtensionPolicyService caches\nthat value, so the test's pref flip left extensions in the parent process, and borderify has no background\npage, so about:crashextensions had nothing to kill. Start a TestRuntimeService in its own process with\nextensionsProcessEnabled(true) and a crash threshold of 0, wait for the messaging extension's background page,\nthen check that crashing the extension process calls onDisabledProcessSpawning.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334159\n", "files": ["mobile/android/geckoview/src/androidTest/AndroidManifest.xml", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ExtensionProcessCrashService.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebExtensionTest.kt"], "git_node": "bdd62939a224de44e1ddf83cdcaadf300280b80c", "git_parents": ["426e4f1e076380cf59ef654d8e234f3383ee27c4"], "node": "03eb2b1b0144e5047228a227df77ec1a1fd2a2a3", "parents": ["0d65c67af78d3c7fc141e5a92bca0c2ce6cb8418"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082086 - Make radio group containers reference-counted. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334254\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/FragmentOrElement.cpp", "dom/base/FragmentOrElement.h", "dom/base/RadioGroupContainer.cpp", "dom/base/RadioGroupContainer.h", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLInputElement.h"], "git_node": "feb58931ff875fcc070689a75c874a0764cc2f12", "git_parents": ["bdd62939a224de44e1ddf83cdcaadf300280b80c"], "node": "85d3fefa78fa3ee0c06e67cc907925d00196e792", "parents": ["03eb2b1b0144e5047228a227df77ec1a1fd2a2a3"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 1: SkPDF: Support specifying namespace for structure elements. r=gfx-reviewers,lsalzman\n\nWe need this in order to support tagging MathML in PDF, which requires that we specify the MathML namespace.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329544\n", "files": ["gfx/skia/skia/include/docs/SkPDFDocument.h", "gfx/skia/skia/src/pdf/SkPDFTag.cpp", "gfx/skia/skia/src/pdf/SkPDFTag.h"], "git_node": "daa4e4db9dd46aa430f4b545d6f544add13634ce", "git_parents": ["feb58931ff875fcc070689a75c874a0764cc2f12"], "node": "b1d20cfaa22a9726eb7dd03895f865ebf1a4015f", "parents": ["85d3fefa78fa3ee0c06e67cc907925d00196e792"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 2: PdfStructTreeBuilder: Map MathML to PDF. r=accessibility-platform-reviewers,eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329545\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/pdf/PdfStructTreeBuilder.h", "accessible/tests/browser/pdfOutput/browser_structTree.js"], "git_node": "9a360a7b3f6cd9add0b8a77f60fbc6e0bebdf201", "git_parents": ["daa4e4db9dd46aa430f4b545d6f544add13634ce"], "node": "b5ad498432031a32c7e440ff6246e3ff945a4d03", "parents": ["b1d20cfaa22a9726eb7dd03895f865ebf1a4015f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 3: Don't associate nsMathMLChar with an accessibility node if the character is implicitly drawn for the element (e.g. square root). r=layout-reviewers,accessibility-platform-reviewers,dshin,eeejay\n\nFor \u003cmsqrt\u003e and \u003cmenclose notation=\"longdiv\"\u003e, the characters are drawn implicitly for the element.\nIn these cases, the element itself is the semantic representation for accessibility; the character is purely presentational.\nThus, it should not be associated with an accessibility node and should be treated as an artifact in tagged PDF output.\n\nIn contrast, nsMathMLChar can also be used for \u003cmo\u003e in some cases.\nIn these cases, the character is necessary for meaning; \u003cmo\u003e by itself is meaningless.\nThus, we must ensure the character is associated with an accessibility node.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329546\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/pdf/PdfStructTreeBuilder.h", "accessible/tests/browser/pdfOutput/browser.toml", "accessible/tests/browser/pdfOutput/browser_artifacts.js", "accessible/tests/browser/pdfOutput/browser_structTree.js", "accessible/tests/browser/pdfOutput/generate_pdfTest_font.py", "accessible/tests/browser/pdfOutput/head.js", "accessible/tests/browser/pdfOutput/pdfTest.ttf", "accessible/tests/browser/pdfOutput/pdfTest.ttf^headers^", "layout/mathml/nsMathMLChar.cpp", "layout/mathml/nsMathMLChar.h", "layout/mathml/nsMathMLmencloseFrame.cpp", "layout/mathml/nsMathMLmoFrame.cpp", "layout/mathml/nsMathMLmrootFrame.cpp"], "git_node": "557bd556efac7aeebd67d479dde148f2da4b8711", "git_parents": ["9a360a7b3f6cd9add0b8a77f60fbc6e0bebdf201"], "node": "a139cf8a883cf6471bf3d98a02af586afafa90d4", "parents": ["b5ad498432031a32c7e440ff6246e3ff945a4d03"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 4: Add glyph source text support to Moz2D and the Skia backend. r=gfx-reviewers,lsalzman\n\ngfx::GlyphBuffer now has optional per-glyph source text and cluster fields, and DrawTarget has a new SupportsGlyphSourceText() method.\nFactory::CreateDrawTargetWithSkCanvas now takes a new argument which specifies whether the target supports this.\nPrintTargetSkPDF sets this for the PDF page canvas.\nWhen this is set and a caller supplies source text/cluster data, DrawTargetSkia uses SkTextBlobBuilder::allocRunTextPos instead of allocRunPos, falling back to the existing behaviour otherwise.\nWhen splitting glyphs into batches, it avoids splitting glyphs which share a cluster, since each batch only includes the source text for its own glyphs.\nNothing populates the new fields yet, so this is not a behaviour change on its own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329547\n", "files": ["gfx/2d/2D.h", "gfx/2d/DrawTargetSkia.cpp", "gfx/2d/DrawTargetSkia.h", "gfx/2d/Factory.cpp", "gfx/thebes/PrintTargetSkPDF.cpp"], "git_node": "685913c15905196d10bcdfeb7bfe2c261e1421e7", "git_parents": ["557bd556efac7aeebd67d479dde148f2da4b8711"], "node": "c59bcde4ccea460c71af6af1bfdd3d9eee733616", "parents": ["a139cf8a883cf6471bf3d98a02af586afafa90d4"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 5: Add a way for gfxTextRun::PropertyProvider to supply per-character source text. r=layout-reviewers,emilio\n\nPropertyProvider has a new GetSourceText virtual method, which fetches the source text a range of the textrun was shaped from, as exactly one UTF-16 code unit per textrun character.\nThe default implementation returns false.\nnsTextFrame::PropertyProvider implements it by mapping back to the original DOM text via the skip-chars iterator, even for a transformed textrun, since text-transform must not affect a plain text copy.\nThe DOM text is never masked, so for a transformed textrun, it explicitly returns false for masked password characters.\nNot yet called from anywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329548\n", "files": ["gfx/thebes/gfxTextRun.h", "layout/generic/nsTextFrame.cpp", "layout/generic/nsTextFrame.h"], "git_node": "4996b81d507074042884c2b113acb7d62deeaaca", "git_parents": ["685913c15905196d10bcdfeb7bfe2c261e1421e7"], "node": "6c8d42580e0bc5a4e20d3ca10a635c99b70d8870", "parents": ["c59bcde4ccea460c71af6af1bfdd3d9eee733616"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 6: Feed per-glyph source text into GlyphBuffer when drawing text. r=gfx-reviewers,lsalzman\n\ngfxTextRun::Draw determines once per run whether to collect source text, based on whether there is a provider and whether DrawTarget::SupportsGlyphSourceText() says the target might be able to use it.\nIf so, gfxTextRun::DrawGlyphs fetches the source text for the range being drawn from the provider, converts it to UTF-8 along with a mapping from textrun characters to byte offsets, and passes these to gfxFont via TextRunDrawParams, just as it already does for spacing.\nThe conversion to UTF-8 happens here rather than in the provider because that is what Skia expects (as does cairo's equivalent API), whereas layout deals in UTF-16.\ngfxFont::DrawGlyphs maps each glyph to the source text of the character it was drawn for, plus any following characters that have no glyphs of their own.\nFor example, a ligature glyph maps to the text of all the characters it replaced.\nGlyphBufferAzure records a cluster offset for each glyph it buffers and passes the relevant slice of the source text to the DrawTarget whenever it flushes, which can happen part way through a run.\nThis fixes incorrect /ToUnicode mapping in PDF output for glyphs reached via OpenType substitution, such as MathML sub/superscript styling, when printing directly to SkPDF.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329549\n", "files": ["accessible/tests/browser/pdfOutput/browser.toml", "accessible/tests/browser/pdfOutput/browser_sourceText.js", "accessible/tests/browser/pdfOutput/generate_pdfTest_font.py", "accessible/tests/browser/pdfOutput/head.js", "accessible/tests/browser/pdfOutput/pdfTest.ttf", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxTextRun.cpp"], "git_node": "c4b7599bac64d78672cfb5c86e5c75c5cfec84b4", "git_parents": ["4996b81d507074042884c2b113acb7d62deeaaca"], "node": "54b01c71b67b21b93e889d4cbec11f957b04f729", "parents": ["6c8d42580e0bc5a4e20d3ca10a635c99b70d8870"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 7: Plumb glyph source text from content processes to the parent process via DrawTargetRecording. r=gfx-reviewers,lsalzman\n\nRecordedDrawGlyphs, and the RecordedFillGlyphs/RecordedStrokeGlyphs events derived from it, now take the whole GlyphBuffer rather than just a glyph array and count.\nThey serialize the buffer's optional source text/cluster fields when present.\nBecause recordings can come from a less privileged process, the clusters are validated when an event is read, before they can be used to index into the text.\nDrawTargetRecording::SupportsGlyphSourceText defers to its recorder, since the target the recording will eventually be replayed against isn't known at record time.\nRecorders opt in via DrawEventRecorderPrivate::SetSupportsGlyphSourceText.\nThis is done for the recorder used for printing in a content process, and for CrossProcessPaint when painting out-of-process iframes for printing, since those are replayed directly into the print target.\nOther recording consumers such as remote canvas and WebRender blob images don't opt in, so they don't pay for this.\nThis is required for the fix in the previous patch to take effect when printing a document in a content process, since content process drawing is recorded and only replayed against the real target (e.g. a tagged SkPDF document) in the parent process.\n\nPrintTargetWindows also opts in its own internal recorder, used for its GDI back-end's two-pass drawing scheme (bug 2079470).\nThat recorder is only ever an intermediate step toward GDI output, which has no use for the text, but it still needs to tolerate the text without asserting.\nPrinting always records with glyph source text regardless of the actual destination, since the content process currently has no way to know whether printing will end up at a target that supports it (e.g. SkPDF) or one that doesn't (e.g. this GDI back-end).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329550\n", "files": ["accessible/tests/browser/pdfOutput/browser_sourceText.js", "gfx/2d/DrawEventRecorder.h", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetRecording.h", "gfx/2d/RecordedEventImpl.h", "gfx/ipc/CrossProcessPaint.cpp", "gfx/thebes/PrintTargetWindows.cpp", "widget/nsDeviceContextSpecProxy.cpp"], "git_node": "fc9e452c7e57eb2c04ff6b833e2965eb513b9565", "git_parents": ["c4b7599bac64d78672cfb5c86e5c75c5cfec84b4"], "node": "1aeec4493b85f6eb7202b0060827353dc5b8e061", "parents": ["54b01c71b67b21b93e889d4cbec11f957b04f729"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055405 part 8: Fix outline titles now that glyph source text is provided to SkPDF. r=gfx-reviewers,accessibility-platform-reviewers,lsalzman,eeejay\n\nWhen PDF outline generation was implemented in bug 1950656, source text wasn't passed to SkPDF.\nThat meant that SkPDF couldn't accumulate heading names for the outline from the source text.\nTo work around that, I tweaked Skia slightly to optionally use the alt text as the heading name without exposing the name as the alt attribute in the struct tree.\n\nNow that we pass source text to SkPDF thanks to the earlier patches in this stack, this previous support is redundant and causes duplicate text.\nInstead, in most cases, we now allow SkPDF to accumulate heading names from the source text.\nWhere a heading's name is overridden (e.g. using aria-label), we continue to pass it as alt text.\nHowever, we don't want to expose both alt text and source text, so this tweaks Skia to avoid accumulating heading names from the source text if alt text is explicitly specified for a heading.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329551\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp", "gfx/skia/skia/include/docs/SkPDFDocument.h", "gfx/skia/skia/src/pdf/SkPDFTag.cpp"], "git_node": "3eaee84e0cbdc95895c53c1b66d3afd11f16d3ac", "git_parents": ["fc9e452c7e57eb2c04ff6b833e2965eb513b9565"], "node": "417ff28e74a3158d5c5a89bdcd0fd40b9bbfc358", "parents": ["1aeec4493b85f6eb7202b0060827353dc5b8e061"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071733 - Update FFmpeg decoded frame plane handling. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326035\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoUtils.h"], "git_node": "51eb2db4754c4fb1d964ad2bdb45650d8327727f", "git_parents": ["3eaee84e0cbdc95895c53c1b66d3afd11f16d3ac"], "node": "395dd613ce3dd1cb5da4d2da59b49092cc4f581d", "parents": ["417ff28e74a3158d5c5a89bdcd0fd40b9bbfc358"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071733 - Update FFmpeg decoded frame plane handling. r=media-playback-reviewers,azebrowski\" for causing bustage @ FFmpegVideoDecoder.cpp\n\nThis reverts commit 51eb2db4754c4fb1d964ad2bdb45650d8327727f.\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoUtils.h"], "git_node": "8386d73515e1627cdfe678a7a69aac86d1b6260f", "git_parents": ["51eb2db4754c4fb1d964ad2bdb45650d8327727f"], "node": "4db1a423c4ad43d9294bbfde589221d6d3179d19", "parents": ["395dd613ce3dd1cb5da4d2da59b49092cc4f581d"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080840 - Only decrypt sessionstore if encryption is available. r=nwipper,sessionstore-reviewers,nsharpley\n\nReading with the decrypt option creates the lockstore service, which\ninitializes NSS on the main thread during startup. Builds without encryption\nsupport cannot have written encrypted session files, so skip it there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333648\n", "files": ["browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_restore_with_encryption.py"], "git_node": "f1440e25d2a284ffffdccc2038bda68721e483c5", "git_parents": ["8386d73515e1627cdfe678a7a69aac86d1b6260f"], "node": "0bd7480b13d47f170b503bbe07aaab4e0778a267", "parents": ["4db1a423c4ad43d9294bbfde589221d6d3179d19"], "tags": []}, {"author": "Martin Sirringhaus \u003cmartin.sirringhaus@suse.com\u003e", "branch": "default", "desc": "Bug 1983767 - Expose topOrigin in WebAuthnRegisterArgs/WebAuthnSignArgs (r=mfarrell)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333210\n", "files": ["dom/webauthn/WebAuthnArgs.cpp", "dom/webauthn/WebAuthnArgs.h", "dom/webauthn/WebAuthnTransactionParent.cpp", "dom/webauthn/nsIWebAuthnArgs.idl"], "git_node": "e0b511ea6f798cdb5e6abf85b75224261ef16000", "git_parents": ["f1440e25d2a284ffffdccc2038bda68721e483c5"], "node": "5887fcf048d06f5759a83817a05514b237f0843d", "parents": ["0bd7480b13d47f170b503bbe07aaab4e0778a267"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2078982 r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334377\n", "files": ["gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/wr/webrender/src/scene_builder_thread.rs"], "git_node": "86b40fbd67bf2581ef14edbe8e1056bd82da4471", "git_parents": ["e0b511ea6f798cdb5e6abf85b75224261ef16000"], "node": "291e6f99ce60c1d773b63c78479fc09e1716341b", "parents": ["5887fcf048d06f5759a83817a05514b237f0843d"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080415 - Fix GetOrCreateTableData() ownership transfer for C++23. r=timhuang\n\nGetOrCreateTableData() returned a local RefPtr\u003cTableData\u003e as a raw\nTableData*. In C++20, the returned RefPtr is an lvalue, so the\nconversion uses RefPtr's `operator T*() const&`.\n\nIn C++23 (P2266), a returned local is a move-eligible xvalue. The\nconversion then selects the deleted `operator T*() const&&`:\n\n  error: conversion function from 'const RefPtr\u003cT\u003e' to 'T *'\n  invokes a deleted function\n\nReturn already_AddRefed\u003cTableData\u003e instead and hold the result in a\nRefPtr in the caller. mTableData keeps its own reference, so there is\nno ownership change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332650\n", "files": ["toolkit/components/url-classifier/nsUrlClassifierDBService.cpp"], "git_node": "2e2f8cdb57a348c6fad7dc6fe3eaa37b161f00f9", "git_parents": ["86b40fbd67bf2581ef14edbe8e1056bd82da4471"], "node": "906b71bb7ec824bd862c7ab5fc5d9c556bd568b3", "parents": ["291e6f99ce60c1d773b63c78479fc09e1716341b"], "tags": []}, {"author": "Javier Fern\u00e1ndez Garc\u00eda-Boente \u003cjfernandez@igalia.com\u003e", "branch": "default", "desc": "Bug 2061233 - Widen the tracker purge's storage-activity lookback to what the platform keeps r=timhuang,asuth,dom-worker-reviewers\n\nTHREE_DAYS_MS was 3 * 24 * 60 * 1000, so the first-iteration storage-activity\nlookup reached back 72 minutes rather than the three days its name promised.\n\nCorrecting the constant to three days is not an option: StorageActivityService\nforgets activity older than TIME_MAX_SECS and answers NS_ERROR_INVALID_ARG for\nany range reaching further back, and purgeTrackingCookieJars() does not guard\nthe call, so it throws instead. Ask for what the service can answer, and name\nthe constant after that rather than after an interval it cannot serve.\n\nTesting this exposed a bug in StorageActivityService::MoveOriginInTime, which\ndivided by PR_USEC_PER_SEC on the way into mActivities while everything else\nstores and reads PRTime. A moved origin landed near the epoch and the next\nCleanUp() dropped it, so callers saw it survive clearing because its activity\nwas gone, not because it had moved out of the window.\n\nThe new purge task ages a tracker's storage activity past the old window and\nexpects the purge to still reach it, and\ntest_clear_by_time_range_scopes_to_window now asserts that the moved origin is\nactive at its new timestamp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332805\n", "files": ["dom/serviceworkers/test/browser_clearData_serviceWorkers.js", "dom/serviceworkers/test/browser_purgeTrackers_serviceWorkers.js", "dom/storage/StorageActivityService.cpp", "toolkit/components/antitracking/PurgeTrackerService.sys.mjs"], "git_node": "8899143a1dcebe786dd9cad4ec35f16369283f7a", "git_parents": ["2e2f8cdb57a348c6fad7dc6fe3eaa37b161f00f9"], "node": "5517c79a2a01385831835242f59d879d7a486fb9", "parents": ["906b71bb7ec824bd862c7ab5fc5d9c556bd568b3"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2082118 - Keep owner of TextInputListener alive during script execution. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334175\n", "files": ["dom/html/TextControlState.cpp", "dom/html/TextInputListener.h"], "git_node": "b4183333830b47e1b1c0fbc0bf49a1c30a0479da", "git_parents": ["8899143a1dcebe786dd9cad4ec35f16369283f7a"], "node": "c19f26f0cbe7a13c3db63df4bfa8ef2ca4c67760", "parents": ["5517c79a2a01385831835242f59d879d7a486fb9"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076454 - Update browser/themes/windows to pass use-design-tokens r=desktop-theme-reviewers,places-reviewers,akulyk,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330624\n", "files": ["browser/themes/windows/browser.css", "browser/themes/windows/customizableui/panelUI.css", "browser/themes/windows/downloads/allDownloadsView.css", "browser/themes/windows/downloads/downloads.css", "browser/themes/windows/places/organizer.css", "stylelint-rollouts.config.js", "tools/lint/stylelint/stylelint-plugin-mozilla/helpers.mjs"], "git_node": "da386a58c036239b3f2aca8fd4c4f2c25c1fe651", "git_parents": ["b4183333830b47e1b1c0fbc0bf49a1c30a0479da"], "node": "c9d5edfe267bdcb122be2467c7ae3e475e301aef", "parents": ["c19f26f0cbe7a13c3db63df4bfa8ef2ca4c67760"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2080118 - Correctly QI continuation state r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334056\n", "files": ["extensions/auth/nsHttpNegotiateAuth.cpp", "netwerk/protocol/http/nsHttpChannelAuthProvider.cpp", "netwerk/protocol/http/nsHttpNTLMAuth.cpp"], "git_node": "5f0184513edde36a5a6103e4a24641fa64490ff0", "git_parents": ["da386a58c036239b3f2aca8fd4c4f2c25c1fe651"], "node": "9bc9e39db5c86cee12aef8d5d2ed45461d0b3651", "parents": ["c9d5edfe267bdcb122be2467c7ae3e475e301aef"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080169 - Sync credit cards through the Rust store's bridged engine on Desktop r=credential-management-reviewers,joschmidt\n\nThe credit card counterpart of bug 2062542. BridgedCreditCardsEngine is\nregistered as the alternative to CreditCardsEngine on\ncreditCards.storage.rust.active, so Sync reads and writes the store the browser\nis serving from.\n\nUnlike addresses, a sync with the primary password locked is skipped and\nrecords MASTER_PASSWORD_LOCKED rather than prompting, as RustPasswordEngine\ndoes. The meta/global engine version stays CreditCardsEngine's (1), not\nCREDIT_CARD_SCHEMA_VERSION, so other clients keep syncing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332397\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_bridged_engine.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_sync_engine.js", "browser/extensions/formautofill/test/unit/xpcshell.toml", "services/sync/modules/service.sys.mjs", "toolkit/components/formautofill/FormAutofillSync.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs"], "git_node": "1b693cb9a5e1e491874a04f1f5a4e633638d5b4a", "git_parents": ["5f0184513edde36a5a6103e4a24641fa64490ff0"], "node": "e517a6c6138793891bb3de4739ac09c7b57f9b81", "parents": ["9bc9e39db5c86cee12aef8d5d2ed45461d0b3651"], "tags": []}, {"author": "Ahmed Ashraf ElGendy \u003cahmedashrafelgendy25@gmail.com\u003e", "branch": "default", "desc": "Bug 1327787 - Set focus back on element attribute/tag after removing an attribute. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333012\n", "files": ["devtools/client/inspector/markup/test/browser_markup_keybindings_delete_attributes.js", "devtools/client/inspector/markup/views/element-container.js"], "git_node": "118243f3d38efd6bc8c6a752951cb053a24d5b74", "git_parents": ["1b693cb9a5e1e491874a04f1f5a4e633638d5b4a"], "node": "1955d7600a0afe4eadff2c52ea398cc9039fa1e6", "parents": ["e517a6c6138793891bb3de4739ac09c7b57f9b81"], "tags": []}, {"author": "Ahmed Ashraf ElGendy \u003cahmedashrafelgendy25@gmail.com\u003e", "branch": "default", "desc": "Bug 2076777 - Fix inactive CSS for display grid-lanes / inline-grid-lanes. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333937\n", "files": ["devtools/client/inspector/rules/test/browser_rules_inactive_css_grid.js", "devtools/server/actors/utils/inactive-property-helper.js", "devtools/server/tests/chrome/inactive-property-helper/align-content.mjs", "devtools/server/tests/chrome/inactive-property-helper/gap.mjs", "devtools/server/tests/chrome/inactive-property-helper/grid-container-properties.mjs"], "git_node": "f587b565c4f38ddfb91a129614ebca7600c68f27", "git_parents": ["118243f3d38efd6bc8c6a752951cb053a24d5b74"], "node": "4b72d4ace057f0b226f21b4e2bb6df42d8481dde", "parents": ["1955d7600a0afe4eadff2c52ea398cc9039fa1e6"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2078543 - DoShiftReloadConnectionCleanupWithConnInfo should not cancel all connections r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331099\n", "files": ["netwerk/protocol/http/HttpConnectionMgrShell.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpHandler.h", "netwerk/test/unit/test_freshconnection_origin_attributes.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "69fbc6656b570db6ff29df1bf607618460a6173f", "git_parents": ["f587b565c4f38ddfb91a129614ebca7600c68f27"], "node": "8d1c6358c8fd089884d7ef341a5a9450c76c747f", "parents": ["4b72d4ace057f0b226f21b4e2bb6df42d8481dde"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2078515 - Do not expose captive portal components on android r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331113\n", "files": ["netwerk/test/unit/test_dooh.js", "netwerk/test/unit/test_trr.js", "netwerk/test/unit/xpcshell.toml", "toolkit/components/captivedetect/components.conf", "toolkit/components/captivedetect/test/unit/xpcshell.toml"], "git_node": "c738391cf43008aaa0cf61d316ded081525a7417", "git_parents": ["69fbc6656b570db6ff29df1bf607618460a6173f"], "node": "3641ad33a09976a771e6d798c541b8324c4a0bc8", "parents": ["8d1c6358c8fd089884d7ef341a5a9450c76c747f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2078515 - Make sure captive portal does not run when pref is off r=necko-reviewers,jesup\n\n- Moved prefs to StaticPrefList\n- Checked pref in all CPS methods\n- Added test that recheckCaptivePortal does not trigger a check when pref is off\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331114\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js", "netwerk/base/CaptivePortalService.cpp", "netwerk/base/CaptivePortalService.h", "netwerk/base/nsIOService.cpp", "netwerk/test/unit/test_captive_portal_service.js"], "git_node": "9bd21a7ae288ab38349de732eea778f950973c6b", "git_parents": ["c738391cf43008aaa0cf61d316ded081525a7417"], "node": "86a2730e69c6494b3f265a96736fc90b3aa3d5f3", "parents": ["3641ad33a09976a771e6d798c541b8324c4a0bc8"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082423 - Create a new addPopularSiteAsShortcutTest regression UI test r=android-reviewers,mcarare\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\n\u2757 We need a separate review for the newly added test tags from someone from the development team\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334114\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/HomePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/ShortcutsTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ui/PopularSites.kt"], "git_node": "86449455a531880c3b4c2dc2b049a85e209780de", "git_parents": ["9bd21a7ae288ab38349de732eea778f950973c6b"], "node": "cfed1cd322352d36052c30d39d7d6d211759366e", "parents": ["86a2730e69c6494b3f265a96736fc90b3aa3d5f3"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082118 - Keep owner of TextInputListener alive during script execution. r=masayuki\" for causing build bustages at TextControlState.cpp\n\nThis reverts commit b4183333830b47e1b1c0fbc0bf49a1c30a0479da.\n", "files": ["dom/html/TextControlState.cpp", "dom/html/TextInputListener.h"], "git_node": "07d0623c12651e2764371f8ec133e279b713f586", "git_parents": ["86449455a531880c3b4c2dc2b049a85e209780de"], "node": "d4de8677bf260c449326358dccddcf7c7b4f393f", "parents": ["cfed1cd322352d36052c30d39d7d6d211759366e"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080024 - Don't query the native layer root in CompositorOGL. r=gfx-reviewers,lsalzman\n\nCompositorOGL no longer renders into native layers, and on GTK it is only\ncreated by RenderCompositorOGLSWGL when the native compositor is not used.\nAsking the widget for its NativeLayerRoot there made GtkCompositorWidget create\na NativeLayerRootWayland with no usable widget or Wayland surface (in the GPU\nprocess, or on X11) and crash.\n\nRemove the query and always render to the window's default framebuffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333750\n", "files": ["gfx/layers/opengl/CompositorOGL.cpp", "gfx/layers/opengl/CompositorOGL.h"], "git_node": "d77d64262f9068515bac080b08e07603929dbbff", "git_parents": ["07d0623c12651e2764371f8ec133e279b713f586"], "node": "f9a06a2d4e20eea76cbe2644806c2c9e45134cbe", "parents": ["d4de8677bf260c449326358dccddcf7c7b4f393f"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2082336 - Guard -fprofile-abs-path usage behind moz_automation. r=glandium\n\nThis fixes building Firefox with coverage instrumentation with an\nunpatched Clang 22+.\n\n(Unless the people doing so set the moz_automation flag obviously, but\nthat's on them.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334072\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "24d201ee432968cdad8c6d416759c65c1b6a44fb", "git_parents": ["d77d64262f9068515bac080b08e07603929dbbff"], "node": "87a447d02ab2212070def3b2f13b64c1142342f0", "parents": ["f9a06a2d4e20eea76cbe2644806c2c9e45134cbe"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2057104 - Use CheckedInt for the normalized spec length in nsStandardURL. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334405\n", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": "3331e9c482248fe707693f4d3c26d5b78b761e69", "git_parents": ["24d201ee432968cdad8c6d416759c65c1b6a44fb"], "node": "22c7de5a4d93950a0ec1d8a73913d8ec252643e0", "parents": ["87a447d02ab2212070def3b2f13b64c1142342f0"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2057104 - Enforce network.standard-url.max-length after encoding in nsStandardURL setters. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334406\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/base/nsStandardURL.h", "netwerk/test/unit/test_standardurl.js"], "git_node": "ee25906ee1e200c9d33d284ee3565635b4b0c7e3", "git_parents": ["3331e9c482248fe707693f4d3c26d5b78b761e69"], "node": "7191ffd1524f967ffb5331f24f866aac5d7e7b1e", "parents": ["22c7de5a4d93950a0ec1d8a73913d8ec252643e0"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082400 - Ensure map/set iterator link pointer uses atomic accesses in concurrent marking builds r=spidermonkey-reviewers,iain\n\nUsually access to GC edges is mediated by barrier wrappers such as GCPtr which\nuse the atomic operations where necessary. Here we take a pointer to an object\nslot containing a private value and cast it to a raw pointer, thus bypassing\nthe wrapper. (This is also undefined behaviour).\n\nThe patch casts instead to a GCPtr\u003cT*\u003e which keeps the wrapper. (It is still\nundefined behaviour though).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334079\n", "files": ["js/src/builtin/OrderedHashTableObject.h", "js/src/vm/NativeObject.h"], "git_node": "7f409ba0a2bd28138eb263c7f7db5cb139fa8e36", "git_parents": ["ee25906ee1e200c9d33d284ee3565635b4b0c7e3"], "node": "66ed3d7d181a7904bca19aa9c15b80b1ed31f24f", "parents": ["7191ffd1524f967ffb5331f24f866aac5d7e7b1e"], "tags": []}, {"author": "Tim Elliott \u003ctle@holymonkey.com\u003e", "branch": "default", "desc": "Bug 2071113 - Use libwebp scaled decoding to reduce WebP decode cost when downscaling. r=tnikkel,gfx-reviewers\n\nWhen decoding to a much smaller output size, ask libwebp's rescaler for an\nintermediate of min-factor times the target and let the DownscalingFilter\nfinish, as Bug 2033250 did for JPEG with IDCT scaling. libwebp's output\nbuffer shrinks to the intermediate size as well.\n\nOnly for opaque still images. Animated frames are positioned in full-size\ncoordinates, and the lossy rescaler scales colour and alpha separately\nbefore we premultiply, so the colour of transparent pixels bleeds into their\nneighbours (up to 60/255 on a hard edge). Lossless alpha would be safe but\nis excluded to keep the rule simple.\n\nOnly when the intermediate is at most half the full size. The rescaler\nvisits every source pixel, so above that it is slower than decoding at full\nsize. At the boundary lossless is roughly CPU-neutral but still cuts peak\nmemory by 1.4x (2.8x for lossy) on a 21 MP image, since only libwebp's\noutput buffer shrinks and VP8L keeps a full-size buffer internally.\n\nGated by image.webp.scaled-decoding.enabled (default on), with\nimage.webp.scaled-decoding.min-factor (default 2.5) as for JPEG.\n\nAdds DownscaleScalingOn/Off gtest benchmarks, scaled-path correctness gtests\nfor a lossless and a lossy fixture, and WebP downscaling reftests. Linux opt,\n1000x1000 decoded to 100x100:\n\n  WebP_RgbLossy      4373us -\u003e 2273us   1.92x\n  WebP_RgbLossless   3445us -\u003e 2141us   1.61x\n\nClaude-Session: https://claude.ai/code/session_01ACqiev6r4mDb7BjevAAwL5\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325197\n", "files": ["image/decoders/nsWebPDecoder.cpp", "image/decoders/nsWebPDecoder.h", "image/test/gtest/Common.cpp", "image/test/gtest/Common.h", "image/test/gtest/TestDecoders.cpp", "image/test/gtest/TestDecodersPerf.cpp", "image/test/gtest/downscaled-lossy.webp", "image/test/gtest/moz.build", "image/test/reftest/downscaling/lime-red-256px.webp", "image/test/reftest/downscaling/reftest.list", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "566fc83f6864bed2145bae1eeb53812202266e7c", "git_parents": ["7f409ba0a2bd28138eb263c7f7db5cb139fa8e36"], "node": "578ca1a4375bdb8818b258fb1e5d4913c27c7fff", "parents": ["66ed3d7d181a7904bca19aa9c15b80b1ed31f24f"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078669 - Give each layer tree its own id namespace. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333180\n", "files": ["gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h"], "git_node": "95f7223188225e08b9d54af830727e650cf3ff0e", "git_parents": ["566fc83f6864bed2145bae1eeb53812202266e7c"], "node": "07cfed1457a5a6bbd15f0c9c9cfcd2da96ec4edc", "parents": ["578ca1a4375bdb8818b258fb1e5d4913c27c7fff"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078669 - Add per-pipeline embed policies to WebRender scenes. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333181\n", "files": ["gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wrench/reftests/embed-policy/allowed.yaml", "gfx/wr/wrench/reftests/embed-policy/blank.yaml", "gfx/wr/wrench/reftests/embed-policy/both-ref.yaml", "gfx/wr/wrench/reftests/embed-policy/denied.yaml", "gfx/wr/wrench/reftests/embed-policy/embeds-ancestor.yaml", "gfx/wr/wrench/reftests/embed-policy/no-policy.yaml", "gfx/wr/wrench/reftests/embed-policy/not-enforced.yaml", "gfx/wr/wrench/reftests/embed-policy/outer-ref.yaml", "gfx/wr/wrench/reftests/embed-policy/reftest.list", "gfx/wr/wrench/reftests/embed-policy/root-no-policy.yaml", "gfx/wr/wrench/reftests/reftest.list", "gfx/wr/wrench/src/wrench.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs", "gfx/wr/wrench/src/yaml_helper.rs"], "git_node": "72eb43bb92efd6b57a445b096f044f3914ce2b3e", "git_parents": ["95f7223188225e08b9d54af830727e650cf3ff0e"], "node": "a4392c432e20f217948f869047c516f21bad2d38", "parents": ["07cfed1457a5a6bbd15f0c9c9cfcd2da96ec4edc"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078669 - Send iframe embed policies from the GPU process to WebRender, behind a pref. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333182\n", "files": ["gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.h", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "5355a20575b2c92b70016a68e667ae90e10bf570", "git_parents": ["72eb43bb92efd6b57a445b096f044f3914ce2b3e"], "node": "6ce3aa77e7a52b471265fd52b79f0c3f42355955", "parents": ["a4392c432e20f217948f869047c516f21bad2d38"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078669 - Log the iframe items that WebRender embed policies reject. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333183\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs"], "git_node": "254bb1abb03afcbc4c9a4890da898f38d1cb30ba", "git_parents": ["5355a20575b2c92b70016a68e667ae90e10bf570"], "node": "8f8416422e18e8b70f1a87e08b3f595c15018fb5", "parents": ["6ce3aa77e7a52b471265fd52b79f0c3f42355955"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081658 - Implement correct inheritance algorithm for permissionsPolicy. r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333619\n", "files": ["dom/security/permissionspolicy/PermissionsPolicy.cpp", "dom/security/permissionspolicy/PermissionsPolicy.h", "dom/security/permissionspolicy/test/mochitest/test_parser.html", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-self.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-some.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-malformed-wildcard.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-self.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-some.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-wildcard.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-declined.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-nested-header-policy-allowed-for-all.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-nested-header-policy-allowed-for-self.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-nested-local-frame-delegation.https.sub.html.ini", "testing/web-platform/meta/permissions/permissions-query-permissions-policy-attribute.https.sub.html.ini"], "git_node": "c7d13ad7529397fe1e9becdfd5397f613565f639", "git_parents": ["254bb1abb03afcbc4c9a4890da898f38d1cb30ba"], "node": "6fafc324b0a2a8afb42465bd26b8ea3025520f20", "parents": ["8f8416422e18e8b70f1a87e08b3f595c15018fb5"], "tags": []}, {"author": "Oskar Mansfeld \u003comansfeld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082573 - Increase DNS cache size on Beta and Release. r=necko-reviewers,kershaw,mxinden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334224\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "fe92c06e23f4fd18f694b887a08fa63f67451bd8", "git_parents": ["c7d13ad7529397fe1e9becdfd5397f613565f639"], "node": "5a44fe946dbdd8ed0097c7fc91ed0f03174a018b", "parents": ["6fafc324b0a2a8afb42465bd26b8ea3025520f20"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063158 - Replace EARLY_BETA_OR_EARLIER in PHC with NIGHTLY_BUILD r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332802\n", "files": ["memory/build/PHC.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "551b8257b9df6bbef9587920ff7efa93e4b124d9", "git_parents": ["fe92c06e23f4fd18f694b887a08fa63f67451bd8"], "node": "05c46ce1fa804793215574fd920865de1a3c66c4", "parents": ["5a44fe946dbdd8ed0097c7fc91ed0f03174a018b"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080990 - Update metadata for html/dom/render-blocking/remove-attr-style-keeps-blocking.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334418\n", "files": ["testing/web-platform/meta/html/dom/render-blocking/remove-attr-style-keeps-blocking.html.ini"], "git_node": "63007ccef38fcc32b009c596095b36bb7a86edd4", "git_parents": ["551b8257b9df6bbef9587920ff7efa93e4b124d9"], "node": "2f9bea41cf74e061ae018f9798ffe9ff2a24ffac", "parents": ["05c46ce1fa804793215574fd920865de1a3c66c4"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081232 - Update metadata for fullscreen/api/document-fullscreen-keyboard-lock-escape.window.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334422\n", "files": ["testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-escape.window.js.ini"], "git_node": "db8d3c5115922871e4a08e72cc32834b854ec96f", "git_parents": ["63007ccef38fcc32b009c596095b36bb7a86edd4"], "node": "8733d8e9855efc2a669e0fbec98559b65e01d3e3", "parents": ["2f9bea41cf74e061ae018f9798ffe9ff2a24ffac"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082682 - Update metadata for encrypted-media/drm-events.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334450\n", "files": ["testing/web-platform/meta/encrypted-media/drm-events.https.html.ini"], "git_node": "9582b9041373e4fb50f63c0ac2ef2080ad2c0ee2", "git_parents": ["db8d3c5115922871e4a08e72cc32834b854ec96f"], "node": "891e1420ce8c8093335413b4082310e90bca12c8", "parents": ["8733d8e9855efc2a669e0fbec98559b65e01d3e3"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081614 - Update freetype2 to 88f8b33c4d5e695565bd9ef90d6e9e5ef1d51bde r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333512\n", "files": ["modules/freetype2/README", "modules/freetype2/include/freetype/freetype.h", "modules/freetype2/moz.yaml", "modules/freetype2/src/autofit/afshaper.c", "modules/freetype2/src/autofit/ft-hb-decls.h", "modules/freetype2/src/base/ftbbox.c", "modules/freetype2/src/base/ftobjs.c", "modules/freetype2/src/base/ftver.rc", "modules/freetype2/src/cid/cidload.c", "modules/freetype2/src/psaux/psintrp.c", "modules/freetype2/src/truetype/ttvarc.c"], "git_node": "7e8def600d55883db0521e5f2489e7aa71e5efe4", "git_parents": ["9582b9041373e4fb50f63c0ac2ef2080ad2c0ee2"], "node": "d164a2fbcfbe7fd90d054b43cd21d2412d6e6e00", "parents": ["891e1420ce8c8093335413b4082310e90bca12c8"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078994 - Fix fullscreen state; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332574\n", "files": ["dom/base/Document.cpp"], "git_node": "272c1e4ec390c32e10e9333894b650feffbe2310", "git_parents": ["7e8def600d55883db0521e5f2489e7aa71e5efe4"], "node": "8c31a14ef72c60ea1c5b32574a1e762618de975a", "parents": ["d164a2fbcfbe7fd90d054b43cd21d2412d6e6e00"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079786 - Adjust the timing of pointer lock release; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333687\n", "files": ["dom/base/Document.cpp"], "git_node": "a591061b2d106e49abff985a6a9aed457e27e016", "git_parents": ["272c1e4ec390c32e10e9333894b650feffbe2310"], "node": "ac5ec4a2db43d9a8c96cb710f3c1378c61d908c2", "parents": ["8c31a14ef72c60ea1c5b32574a1e762618de975a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081341 - Wait in addAccessibleTask until a remote document's cached bounds match its browser's size. r=morgan\n\nA new remote document can load and send its accessibility cache before the\nbrowser has sent its size, so tasks could read bounds from a 0x0 layout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333361\n", "files": ["accessible/tests/browser/shared-head.js"], "git_node": "b83e5955ea1019852e8911298a8f6a4fd6fb5b22", "git_parents": ["a591061b2d106e49abff985a6a9aed457e27e016"], "node": "8128556919d036f2ae5a312f9d0b50c6fad9feba", "parents": ["ac5ec4a2db43d9a8c96cb710f3c1378c61d908c2"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2082118 - Keep owner of TextInputListener alive during script execution. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334175\n", "files": ["dom/html/TextControlState.cpp", "dom/html/TextInputListener.h"], "git_node": "9be238d65cf36134ec8186e9e26a884b3d77bbee", "git_parents": ["b83e5955ea1019852e8911298a8f6a4fd6fb5b22"], "node": "bfb91bc37ddcdac565a0e14cb5176da04abb4f9f", "parents": ["8128556919d036f2ae5a312f9d0b50c6fad9feba"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080787 - Don't hold on to store buffer entry unnecessarily when tenuring strings r=spidermonkey-reviewers,yulia\n\nSemispace nursery sets a flag |promotedToNursery| when a cell is promoted but\nstays in the nursery. This is used to detect when we need to keep a store\nbuffer entry around rather than discarding it after it's been traced.\n\nThe code in question performs a recursive tenuring operation on a dependent\nstring's base, which overwrites this flag. This can cause the store buffer\nentry to be kept after the pointer it contains is tenured. Subsequent post\nbarrier operations won't remove it for this reason and the memory holding it\ncan be freed, leading to UAF on the next nursery collection.\n\nThe fix is to preserve the flag over the recursive promotion call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334074\n", "files": ["js/src/gc/Tenuring.cpp", "js/src/jit-test/tests/gc/bug-2080787.js"], "git_node": "db45ebd6ce9476f96020a66cf6be7398bcb3b36f", "git_parents": ["9be238d65cf36134ec8186e9e26a884b3d77bbee"], "node": "3e7e34435a2d6ecfd2ad56f6e9546663a0868782", "parents": ["bfb91bc37ddcdac565a0e14cb5176da04abb4f9f"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082130 - Clear WindowProxy properly; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334214\n", "files": ["dom/base/nsGlobalWindowOuter.h"], "git_node": "9befd8690b26e4cdb3bcb80617fc8a9c55fa36e7", "git_parents": ["db45ebd6ce9476f96020a66cf6be7398bcb3b36f"], "node": "00606c100f82f7355d78d6a0355df9033bd4cd46", "parents": ["3e7e34435a2d6ecfd2ad56f6e9546663a0868782"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2053472 - Add dom.template-for.enabled pref and HTMLTemplateElement.htmlFor r=webidl,keithamus,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334016\n", "files": ["dom/html/HTMLTemplateElement.h", "dom/webidl/HTMLTemplateElement.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/reflect-html-for.html.ini"], "git_node": "125777bd7b860f4073b7eb1ffee3a094ce41565e", "git_parents": ["9befd8690b26e4cdb3bcb80617fc8a9c55fa36e7"], "node": "133026a3835d0f1ef34b2e834dab2d5790cef456", "parents": ["00606c100f82f7355d78d6a0355df9033bd4cd46"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940650 - Slide dropped tabs from where they were drawn to their new position. r=tabbrowser-reviewers,desktop-theme-reviewers,sthompson,tgiles\n\nThe drop now moves the tabs in the DOM right away and animates the result, so moving-tab mode ends with the drop; this is why DROP_ANIMATION_GRACE_MS and the _after_drop labels of tab.stale_drag_recovery are gone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329819\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tabs.mjs", "browser/components/tabbrowser/metrics.yaml", "browser/components/tabbrowser/test/browser/dragdrop/browser.toml", "browser/components/tabbrowser/test/browser/dragdrop/browser_drop_animation.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_move_unpinned_not_overflowing.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_stale_drag_session.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "6ef1d37e6c8e1358ee832c5ac15cf3d9db464e5d", "git_parents": ["125777bd7b860f4073b7eb1ffee3a094ce41565e"], "node": "a934c0dd73807dd93e06c4dfa44c4149d3e9ba44", "parents": ["133026a3835d0f1ef34b2e834dab2d5790cef456"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a path data structure to webrender_api. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330855\n", "files": ["gfx/wr/webrender_api/src/lib.rs", "gfx/wr/webrender_api/src/path.rs"], "git_node": "2e13417b0975f88fa95d7caecaa81752913d8fbd", "git_parents": ["6ef1d37e6c8e1358ee832c5ac15cf3d9db464e5d"], "node": "00319bcc3dc78b31556896a75c40656a4b44132f", "parents": ["a934c0dd73807dd93e06c4dfa44c4149d3e9ba44"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a bezier module. r=gfx-reviewers,gw\n\nIt contains only curve flattening implementations for cubic and quadratic b\u00e9zier curves for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330856\n", "files": ["gfx/wr/webrender/src/bezier.rs", "gfx/wr/webrender/src/lib.rs"], "git_node": "8ddb472efbb831cb6694f0c2e82104bfd00a152f", "git_parents": ["2e13417b0975f88fa95d7caecaa81752913d8fbd"], "node": "29afcd8a2051b98833a4487b1553587aebd3588a", "parents": ["00319bcc3dc78b31556896a75c40656a4b44132f"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Move polygon_contains_point from clip.rs to hit_test.rs. r=gfx-reviewers,gw\n\nclip.rs is a pretty large file and polygon.rs is the only place where it is used. Also move the related tests that were in util.rs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330860\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/util.rs"], "git_node": "310f20cc7024eef43e0c37f84d38196cd3e01775", "git_parents": ["8ddb472efbb831cb6694f0c2e82104bfd00a152f"], "node": "acf80e161a97698b6bc4101c8bf7835b6ecb8a63", "parents": ["29afcd8a2051b98833a4487b1553587aebd3588a"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add the polygon and box-shadow counters to the Interners profiler preset. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331232\n", "files": ["gfx/wr/webrender/src/profiler.rs"], "git_node": "bb9372796e5baed8e587546e13f5d72089d119e7", "git_parents": ["310f20cc7024eef43e0c37f84d38196cd3e01775"], "node": "1352dc7254db5c5c25614a7818917dd376af02c0", "parents": ["acf80e161a97698b6bc4101c8bf7835b6ecb8a63"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a sparse tiling path rasterizer. r=gfx-reviewers,gw\n\nPort of the tiling path renderer from https://codeberg.org/nical/misc/src/branch/main/path_renderer/renderers/tiling without occlusion culling, opaque batches and the point buffer. Curves are flattened with the bezier module, and segments are clipped to the region that affects the target before binning so that huge coordinates cannot cause the binning to walk across millions of tiles.\n\nThis is not used yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330862\n", "files": ["gfx/wr/webrender/src/bezier.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/path_tiler.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "5be8d4e40a6fcefdd1ca558815364e4cefc0b236", "git_parents": ["bb9372796e5baed8e587546e13f5d72089d119e7"], "node": "9391f7bf894c9547746404ecdeeb8bd74ef529a4", "parents": ["1352dc7254db5c5c25614a7818917dd376af02c0"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a frame-wide path edge buffer. r=gfx-reviewers,gw\n\nPath tile edges are stored in a dedicated RGBA8 texture, one edge per texel, so that the fragment shader gets them unpacked by the texture unit. It is shared by all of the paths of the frame and is empty until path clips are rasterized.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330863\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/render_task_graph.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs"], "git_node": "42e07829140af8fe7feea272431a0a2f4fb8135a", "git_parents": ["5be8d4e40a6fcefdd1ca558815364e4cefc0b236"], "node": "f757f451893b0094bba182e41bdc409942f3aaaa", "parents": ["9391f7bf894c9547746404ecdeeb8bd74ef529a4"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add the cs_path_tile shader. r=gfx-reviewers,gw\n\nPort of the tiling path renderer's shader, with area coverage anti-aliasing only. The tile rasterization code lives in path_tile.glsl so that it can later be included by other shaders.\n\nPath tiles are drawn at the end of the clip masks, with the premultiplied dest-out blend mode in color targets. In alpha targets they use the multiply blend mode instead, because SWGL's R8 targets have no fragment alpha to blend with. No path tiles are produced yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330866\n", "files": ["gfx/wr/webrender/res/cs_path_tile.glsl", "gfx/wr/webrender/res/path_tile.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender/src/renderer/vertex.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "82ed53e375333112f377a94102d66c879ee217c1", "git_parents": ["42e07829140af8fe7feea272431a0a2f4fb8135a"], "node": "c05b781b383e2a4ce878f62df7cfaeaf4669fec5", "parents": ["f757f451893b0094bba182e41bdc409942f3aaaa"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082636 - Remove the logging.nsHttp pref from test_happy_eyeballs_h3_fallback.js, r=necko-reviewers,sunil DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334434\n", "files": ["netwerk/test/unit/test_happy_eyeballs_h3_fallback.js"], "git_node": "046bce08d8a1e932e90fc8f5dcfc0b9ed42e6dca", "git_parents": ["82ed53e375333112f377a94102d66c879ee217c1"], "node": "b72adb95f0241d836c0c8c8b900adb8047f9f72b", "parents": ["c05b781b383e2a4ce878f62df7cfaeaf4669fec5"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080915 - Install agentic coding tools during non-interactive bootstrap. r=firefox-build-system-reviewers,glandium DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332963\n", "files": ["python/mozboot/mozboot/bootstrap.py", "python/mozboot/mozboot/mach_commands.py", "python/mozboot/mozboot/test/test_bootstrap.py"], "git_node": "1ef6058d28d8fc0e3797f7fc7642b90c5e2b2fc2", "git_parents": ["046bce08d8a1e932e90fc8f5dcfc0b9ed42e6dca"], "node": "60aa266e191853bcf1fc384bc96163ab52170a06", "parents": ["b72adb95f0241d836c0c8c8b900adb8047f9f72b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076643 - Use the neutral address bar shadow with third-party themes. r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334403\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "e2852f043c4b8950475b3b2ab96823882dc479b7", "git_parents": ["1ef6058d28d8fc0e3797f7fc7642b90c5e2b2fc2"], "node": "807bee157c5870cf1640614addd8fd7cbbf37c26", "parents": ["60aa266e191853bcf1fc384bc96163ab52170a06"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082350 - Notify on attributes set on custom elements, from parser r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334054\n", "files": ["parser/html/nsHtml5TreeOperation.cpp", "parser/html/nsHtml5TreeOperation.h", "testing/web-platform/tests/custom-elements/parser/WEB_FEATURES.yml", "testing/web-platform/tests/custom-elements/parser/parser-sets-attributes-after-autonomous-constructor.html", "testing/web-platform/tests/custom-elements/parser/parser-sets-attributes-after-built-in-constructor.html"], "git_node": "c2bb36460fb104fe9237b04aab72d6173908b44e", "git_parents": ["e2852f043c4b8950475b3b2ab96823882dc479b7"], "node": "143e4dc2d91e98b49f420f9c4e63f0f9902bb7b6", "parents": ["807bee157c5870cf1640614addd8fd7cbbf37c26"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2054020 - Traverse the shadow including tree, not flat tree, for headingoffset r=dom-core-reviewers,jjaschke,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334028\n", "files": ["dom/base/nsIContent.cpp", "dom/base/nsIContent.h", "dom/html/HTMLHeadingElement.cpp", "dom/html/HTMLHeadingElement.h", "dom/html/HTMLSlotElement.cpp", "testing/web-platform/meta/html/semantics/sections/headingoffset-and-headingreset.html.ini", "testing/web-platform/meta/html/semantics/sections/headingoffset-mutations.html.ini", "testing/web-platform/tests/html/semantics/sections/headingoffset-mutations.html"], "git_node": "015b6108293a4ecd4cee0599067cfa04fc4f67f9", "git_parents": ["c2bb36460fb104fe9237b04aab72d6173908b44e"], "node": "394a3136c3b53d3e7447e5e857ede1658adb646f", "parents": ["143e4dc2d91e98b49f420f9c4e63f0f9902bb7b6"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2077634 - Out-of-order script execution when extension sends synchronous XHR during iframe insertion r=necko-reviewers,extension-reviewers,robwu,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332339\n", "files": ["dom/xhr/XMLHttpRequestMainThread.cpp", "toolkit/components/extensions/test/xpcshell/test_ext_contentscript_sync_xhr.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml"], "git_node": "04fe41d9bc408cde4c790fd405db63e4983da365", "git_parents": ["015b6108293a4ecd4cee0599067cfa04fc4f67f9"], "node": "4eff5dc4e8f8eed8c66080d01e90a3313793f95d", "parents": ["394a3136c3b53d3e7447e5e857ede1658adb646f"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073775 - Make stack unwinding zero-copy r=mstange,profiler-reviewers\n\nBy avoiding copying of the entire stack onto a stack-allocated buffer, we avoid blowing the stack for threads that do not have a large stack.\n\nMOZ_ASAN_IGNORE on DerefTUW in LulMain.cpp prevents ASan from flagging reads into the target thread's stack memory. DerefTUW is the only function that dereferences StackImage::mContents, and its existing bounds check provides the safety guarantee.\n\nThis fix gives us better performance as well as avoiding segfaulting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327585\n", "files": ["tools/profiler/core/platform.cpp", "tools/profiler/lul/LulMain.cpp", "tools/profiler/lul/LulMain.h", "tools/profiler/tests/gtest/LulTestDwarf.cpp"], "git_node": "782c362e0edbbc14f3453d56aaf6d46ae8dfa912", "git_parents": ["04fe41d9bc408cde4c790fd405db63e4983da365"], "node": "fdf481c7aa34d1ee875c138bcde5e7d8f6be3e37", "parents": ["4eff5dc4e8f8eed8c66080d01e90a3313793f95d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082083 - Use atomic operations on mark bits when marking weakly held atoms r=spidermonkey-reviewers,yulia\n\nThis can happen from multiple threads in parallel when sweeping so we need to\nuse the thread safe marking methods here.\n\nThe test case is extremely slow in debug builds so I didn't add it. I confirmed\nthat it no longer reproduces with the patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334058\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/jit-test/tests/gc/bug-2082083.js"], "git_node": "b349137a8c9f5343c089b48d2af7b78ff68c3ff1", "git_parents": ["782c362e0edbbc14f3453d56aaf6d46ae8dfa912"], "node": "b1f6fc46686ca4206072c03336dd61fa5be4114a", "parents": ["fdf481c7aa34d1ee875c138bcde5e7d8f6be3e37"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081313 - Don't assume non-overlay scrollbars are opaque. r=layout-reviewers,dshin\n\nThey might very well not be due to scrollbar-color.\n\nThis came up during mini-window development, where we might want to\npaint non-overlay visual-viewport-only scrollbars with overlay style.\nBut it seems like a relatively minor optimization.\n\nWe still need to subtract the scrollbar from the visual viewport etc\nthough (my first version of this patch didn't use to), otherwise we\nmight make content unreachable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333318\n", "files": ["layout/base/ViewportUtils.cpp", "layout/base/ViewportUtils.h", "layout/base/nsLayoutUtils.cpp", "layout/base/nsLayoutUtils.h", "layout/generic/ScrollContainerFrame.cpp", "layout/reftests/css-scrollbars/reftest.list", "layout/reftests/css-scrollbars/viewport-transparent-scrollbar-zoomed-ref.html", "layout/reftests/css-scrollbars/viewport-transparent-scrollbar-zoomed.html"], "git_node": "3826476349fe7ab92e2c835b219d7b50b027ef31", "git_parents": ["b349137a8c9f5343c089b48d2af7b78ff68c3ff1"], "node": "9cabd13380ae387094a9bd0ebdeb01b586dbc7bf", "parents": ["b1f6fc46686ca4206072c03336dd61fa5be4114a"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Fix incompatible type assertions in CSSNumericValue arithmetic WPT; r=emilio,firefox-style-system-reviewers\n\nThe existing test uses incompatible dimensions that correctly trigger TypeError\nfor add(), sub(), min(), and max(), but are valid for mul() and div().\n\nUse operands with conflicting percent hints instead, ensuring that numeric type\ncomputation fails for all six arithmetic methods and that each method is\nactually tested for the expected TypeError.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334256\n", "files": ["testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js"], "git_node": "d57263ce449b5e890c5579d50ad48af6dc695d1b", "git_parents": ["3826476349fe7ab92e2c835b219d7b50b027ef31"], "node": "493a0777dacb63f572ec44ab12cf457e3418e24d", "parents": ["9cabd13380ae387094a9bd0ebdeb01b586dbc7bf"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2080114 - Report a SOCKS proxy connect failure from the lookup callback through poll. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332399\n", "files": ["netwerk/socket/nsSOCKSIOLayer.cpp", "netwerk/test/gtest/TestSOCKSProxyLookup.cpp", "netwerk/test/gtest/moz.build"], "git_node": "210f71ccb19f8bdbc1b4e8fe8664237cc54988c2", "git_parents": ["d57263ce449b5e890c5579d50ad48af6dc695d1b"], "node": "faf0c7d42a3e9a56c555964184cb7f14573d0711", "parents": ["493a0777dacb63f572ec44ab12cf457e3418e24d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082697 - Only reject the AppleVTDecoder decode promise if it still exists. r=media-playback-reviewers,padenot\n\nThe VideoToolbox output callback may resolve the decode promise at any time,\nso it may already have been settled when we try to reject it, e.g. when a flush\nraces with the callback, or when the callback fails to output a frame while no\ndecode is pending. This matches the other paths which already use\nRejectIfExists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334349\n", "files": ["dom/media/platforms/apple/AppleVTDecoder.cpp"], "git_node": "cc2dc5e3a86d1e1177a4be0244170409c2139f27", "git_parents": ["210f71ccb19f8bdbc1b4e8fe8664237cc54988c2"], "node": "26afb4b6910d58c7928d19d7ea7c76b83e928399", "parents": ["faf0c7d42a3e9a56c555964184cb7f14573d0711"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082684 - Only disable hardware decoding once after decoding errors. r=media-playback-reviewers,padenot\n\nSome platform decoders ignore the request to disable hardware decoding, such as\nthe MediaCodec decoders for H264 and HEVC on Android, which have no software\nfallback. Since we create a new decoder each time without counting the error,\na stream which keeps failing to decode would recreate decoders forever. Now\nhardware decoding is only disabled once, and subsequent errors are counted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334340\n", "files": ["dom/media/MediaFormatReader.cpp"], "git_node": "4013e7a5654cc9aa8ed5d7074033feeb42abacb5", "git_parents": ["cc2dc5e3a86d1e1177a4be0244170409c2139f27"], "node": "95e6595951ba7e730aaeb04b08de29620e6bcc22", "parents": ["26afb4b6910d58c7928d19d7ea7c76b83e928399"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064583 - Unwrap about:reader URLs in content-realm moz-urlbars. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334452\n", "files": ["browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "377f7b5559a60ba7e78a87bcb90c7e256b187c6a", "git_parents": ["4013e7a5654cc9aa8ed5d7074033feeb42abacb5"], "node": "71662a5921f3eb9ea087ce0457ffc84e3a62d783", "parents": ["95e6595951ba7e730aaeb04b08de29620e6bcc22"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2080128 - move fxa subscription api from AboutProtectionsParent.sys.mjs into `fxAccount.activeSubscriptions()`. r=vbudhram\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332361\n", "files": ["browser/actors/AboutProtectionsParent.sys.mjs", "services/common/hawkrequest.sys.mjs", "services/common/tests/unit/test_hawkrequest.js", "services/fxaccounts/FxAccounts.sys.mjs", "services/fxaccounts/FxAccountsClient.sys.mjs", "services/fxaccounts/FxAccountsCommon.sys.mjs", "services/fxaccounts/tests/xpcshell/test_accounts.js", "services/fxaccounts/tests/xpcshell/test_client.js"], "git_node": "e98e3731dcecc91a819dfb147a644481784bc6e6", "git_parents": ["377f7b5559a60ba7e78a87bcb90c7e256b187c6a"], "node": "d0171bc52bdb0fd6e42ad08800b03e9de751875b", "parents": ["71662a5921f3eb9ea087ce0457ffc84e3a62d783"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2080687 - move internal FxA clients to a \"service\" model when using access tokens. r=skhamis,credential-management-reviewers,dimi\n\nThe FxA server wants to be able to enable \"services\", which means we need to centralize\nthe set of scopes each service needs. This creates a \"service registry\" containing the\nscopes, and all client code moves to requesting an access token for the service instead\nof listing explicit scopes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332789\n", "files": ["browser/actors/AboutProtectionsParent.sys.mjs", "browser/components/aiwindow/models/openAIEngine.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_utils_fxAccount.js", "services/fxaccounts/FxAccounts.sys.mjs", "services/fxaccounts/FxAccountsCommon.sys.mjs", "services/fxaccounts/tests/xpcshell/test_accounts.js", "toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs", "toolkit/components/satchel/integrations/FirefoxRelay.sys.mjs"], "git_node": "d6da6959374eefea44edd6618bafcceb4a6757ff", "git_parents": ["e98e3731dcecc91a819dfb147a644481784bc6e6"], "node": "b4a981ff6f73864c553edc0de45aae25667ce8ad", "parents": ["d0171bc52bdb0fd6e42ad08800b03e9de751875b"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079355 - Size a cropped mini window's layout viewport from the tab's innerWidth/innerHeight. r=emilio\n\nThe layout viewport override was taken from the tab's clientWidth/clientHeight,\nwhich already exclude the root scrollbars. With non-overlay scrollbars the page\nthen reserved them again inside the override, so it was laid out a scrollbar\nnarrower than in the tab and the crop drifted. innerWidth/innerHeight include\nthe scrollbars, so the page keeps the layout it was cropped at.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331768\n", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs"], "git_node": "1daeb6b0d7780f512616a9b94071df7b62e64b03", "git_parents": ["d6da6959374eefea44edd6618bafcceb4a6757ff"], "node": "22421deb3cce94e54d8b3e61b7e0bc27bf2cb7a8", "parents": ["b4a981ff6f73864c553edc0de45aae25667ce8ad"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074676 - Enable mini window and badge their menu items as beta. r=mconley,tabbrowser-reviewers,dao,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328871\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-contextMenu/browser_contextmenu.js", "browser/base/content/test/browser-contextMenu/browser_contextmenu_input.js", "browser/components/miniwindow/moz.build", "browser/components/miniwindow/test/browser/browser_overlap.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/locales-preview/miniWindow.ftl", "browser/locales/en-US/browser/browserContext.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "a95e19cec0670561774445f412abe2a2b21e176a", "git_parents": ["1daeb6b0d7780f512616a9b94071df7b62e64b03"], "node": "bd46858943cd7cfbba4966bc5ac23acd63a26948", "parents": ["22421deb3cce94e54d8b3e61b7e0bc27bf2cb7a8"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074676 - Graduate preview strings for miniWindow. r=mconley,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329626\n", "files": ["browser/base/content/browser.xhtml", "browser/base/content/webext-panels.xhtml", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/locales-preview/miniWindow.ftl", "browser/locales/en-US/browser/miniWindow.ftl", "browser/locales/jar.mn"], "git_node": "843be816bdde8748ced6eeff68c49d47da27f11c", "git_parents": ["a95e19cec0670561774445f412abe2a2b21e176a"], "node": "2327576e48a5ed1a8e4dba1b86216e8043948fb7", "parents": ["bd46858943cd7cfbba4966bc5ac23acd63a26948"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078935 - handle multiple tab selections when moving to mini window. r=mconley,fluent-reviewers,tabbrowser-reviewers,dao,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331446\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/test/browser/browser_overlap.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/content/tabsplitview.mjs", "browser/components/tabbrowser/metrics.yaml", "browser/locales/en-US/browser/miniWindow.ftl"], "git_node": "10b5af5f8e54112666e4d78033c80070acddf438", "git_parents": ["843be816bdde8748ced6eeff68c49d47da27f11c"], "node": "e2faee987913471b513d46fd4100bfb4dde56a93", "parents": ["2327576e48a5ed1a8e4dba1b86216e8043948fb7"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082127 - Optimize Element::AddToIdTable. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334411\n", "files": ["dom/base/Element.cpp"], "git_node": "663e04deb72ddb0e494a47783e5ec9a40a4093be", "git_parents": ["10b5af5f8e54112666e4d78033c80070acddf438"], "node": "5fbaeb74d184d9cca335f391c233b56bd20b51db", "parents": ["e2faee987913471b513d46fd4100bfb4dde56a93"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2071611 - Restore requesttimeoutfactor for test_launch_without_hang.js. r=florian DONTBUILD\n\nThe test does 50 sequential cold starts of the application. On Windows\ncode coverage builds each launch takes about 1.85s, so the whole run needs\nabout 92s and reliably hits the 90s xpcshell timeout, even though every\nlaunch exits cleanly. The timeout factor removed in bug 1995058 covered this.\n\nEspecially a problem for Thunderbird CCov.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334483\n", "files": ["toolkit/xre/test/xpcshell.toml"], "git_node": "09eb153f4a165ad4a0669716a9dff42a5258c452", "git_parents": ["663e04deb72ddb0e494a47783e5ec9a40a4093be"], "node": "771544c38b26b73317243a798a5cb83043d8c467", "parents": ["5fbaeb74d184d9cca335f391c233b56bd20b51db"], "tags": []}, {"author": "Carlos Jeurissen \u003ccarlos-mozilla@jeurissen.co\u003e", "branch": "default", "desc": "Bug 2072133 - Add MessageSender.windowId r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326115\n", "files": ["browser/components/extensions/test/browser/browser.toml", "browser/components/extensions/test/browser/browser_ext_messaging_windowId.js", "toolkit/components/extensions/ExtensionParent.sys.mjs", "toolkit/components/extensions/schemas/runtime.json"], "git_node": "f43deb1ab6b224f3be03085909d46ee62afcf926", "git_parents": ["09eb153f4a165ad4a0669716a9dff42a5258c452"], "node": "feceb28119f3b8fce984063efdb5dac8fcb4e210", "parents": ["771544c38b26b73317243a798a5cb83043d8c467"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078935 - handle multiple tab selections when moving to mini window. r=mconley,fluent-reviewers,tabbrowser-reviewers,dao,bolsson\" for causing bc tests failures at customizableui/test\n\nThis reverts commit 10b5af5f8e54112666e4d78033c80070acddf438.\n\nRevert \"Bug 2074676 - Graduate preview strings for miniWindow. r=mconley,fluent-reviewers,bolsson\"\n\nThis reverts commit 843be816bdde8748ced6eeff68c49d47da27f11c.\n\nRevert \"Bug 2074676 - Enable mini window and badge their menu items as beta. r=mconley,tabbrowser-reviewers,dao,fluent-reviewers,bolsson\"\n\nThis reverts commit a95e19cec0670561774445f412abe2a2b21e176a.\n\nRevert \"Bug 2079355 - Size a cropped mini window's layout viewport from the tab's innerWidth/innerHeight. r=emilio\"\n\nThis reverts commit 1daeb6b0d7780f512616a9b94071df7b62e64b03.\n", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/app/profile/firefox.js", "browser/base/content/browser.xhtml", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-contextMenu/browser_contextmenu.js", "browser/base/content/test/browser-contextMenu/browser_contextmenu_input.js", "browser/base/content/webext-panels.xhtml", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/moz.build", "browser/components/miniwindow/test/browser/browser_overlap.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/content/tabsplitview.mjs", "browser/components/tabbrowser/metrics.yaml", "browser/locales-preview/miniWindow.ftl", "browser/locales/en-US/browser/browserContext.ftl", "browser/locales/en-US/browser/miniWindow.ftl", "browser/locales/en-US/browser/tabbrowser.ftl", "browser/locales/jar.mn"], "git_node": "d72f5f4b748937b20fa0deb2e61f092a32427eaa", "git_parents": ["f43deb1ab6b224f3be03085909d46ee62afcf926"], "node": "bcf5a7c6870a16d480dde23ae836bf1f648a40c7", "parents": ["feceb28119f3b8fce984063efdb5dac8fcb4e210"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081313 - Annotate the new test.\n\nSee comments.\n", "files": ["layout/reftests/css-scrollbars/reftest.list"], "git_node": "e8ba13b23db48998462f5a830eb99adaae41fc24", "git_parents": ["d72f5f4b748937b20fa0deb2e61f092a32427eaa"], "node": "2d8aac5f5cb65ec8fbd4998fab8bb857c22b19b7", "parents": ["bcf5a7c6870a16d480dde23ae836bf1f648a40c7"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082829 - Credit card Rust migration reports false divergences for cards whose number mask has no digits or whose expiry is stored as 0. r=joschmidt,credential-management-reviewers\n\nThe migration verify compared cc-number by the last four characters of each\nstore's mask. The JSON store masks a number that fails isValidNumber entirely\nin `*`, while the Rust store keeps the real last four, so those cards were\nreported as diverged although the number reached Rust intact. Matching last\nfour digits also let a number that differed elsewhere pass.\n\nCompare the number each store decrypts for the record instead. A source that\ncannot read its own number is not compared; a copy whose number cannot be read\nback is reported as having dropped it.\n\nThe Rust expiry columns are non-optional integers, so a JSON record holding\ncc-exp-month or cc-exp-year as 0 read back without the field and was reported\nas \"added\". Both sides mean no expiry, so that pair now compares equal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334502\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs"], "git_node": "98b9ef545502316e6e0a3d190c9d0257277c22ed", "git_parents": ["e8ba13b23db48998462f5a830eb99adaae41fc24"], "node": "153b110ad63bba8cf426a77d3a593eb68d2349f5", "parents": ["2d8aac5f5cb65ec8fbd4998fab8bb857c22b19b7"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2060671 - Give the remaining h3 no-response port tests ports they own. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334414\n", "files": ["netwerk/docs/NodeServers.md", "netwerk/test/httpserver/NodeServer.sys.mjs", "netwerk/test/unit/head_http3.js", "netwerk/test/unit/http3_proxy_common.js", "netwerk/test/unit/test_happy_eyeballs_conn_failure.js", "netwerk/test/unit/test_http3_fallback_anonymous_conn.js", "netwerk/test/unit/test_trr_http3_first.js"], "git_node": "5fe4dd04c8e9772d896adeb04c0d11a15ad48cc5", "git_parents": ["98b9ef545502316e6e0a3d190c9d0257277c22ed"], "node": "828b59319ffb2c722d32ba7a6c8ef0facbe85e45", "parents": ["153b110ad63bba8cf426a77d3a593eb68d2349f5"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2060671 - Start the MASQUE fallback proxy with the MASQUE server. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334415\n", "files": ["netwerk/docs/NodeServers.md", "netwerk/test/httpserver/NodeServer.sys.mjs", "netwerk/test/unit/head_http3.js", "netwerk/test/unit/http3_proxy_common.js", "netwerk/test/unit/test_http2_with_http3_proxy.js", "netwerk/test/unit/test_http3_with_proxy.js"], "git_node": "01a34b6d7eb95ca52c129df43f790f0a61829300", "git_parents": ["5fe4dd04c8e9772d896adeb04c0d11a15ad48cc5"], "node": "ff1fb58ceb9ead628d29e8a5ae1c92e7bd978a90", "parents": ["828b59319ffb2c722d32ba7a6c8ef0facbe85e45"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2082482 - Bind node test servers to loopback addresses instead of a wildcard. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334416\n", "files": ["netwerk/test/browser/browser_test_local_network_access_sni_leak.js", "netwerk/test/httpserver/NodeServer.sys.mjs", "netwerk/test/unit/head_trr.js", "netwerk/test/unit/test_connection_coalescing.js", "netwerk/test/unit/test_http2-proxy.js", "testing/xpcshell/moz-http2/moz-http2.js"], "git_node": "5bca37db82d237446a6abe62afb70c291eaad74d", "git_parents": ["01a34b6d7eb95ca52c129df43f790f0a61829300"], "node": "af284057e7f1be6bb36ebd6a45276eec1ce79013", "parents": ["ff1fb58ceb9ead628d29e8a5ae1c92e7bd978a90"], "tags": []}, {"author": "KayanoLiam \u003cKayano04@outlook.jp\u003e", "branch": "default", "desc": "Bug 2076851 - Allow zoom shortcuts in mini windows r=hsohaney\n\nAllow zoom-in, zoom-out and reset keys by their exact command IDs so\nanonymous alternate bindings remain enabled alongside the primary keys\nKeep unrelated shortcut restrictions unchanged\n\nAdd browser-chrome coverage for full-tab and cropped mini windows,\nincluding alternate shortcuts and resetting to the default zoom level\n\nReproduced Cmd-minus leaving zoom unchanged in the unmodified Nightly\nThe tested Nightly also disabled Cmd-plus, so the reported asymmetry\nwas not reproduced\n\nRuntime checks using the local module in Nightly pass in headless and\nwindowed macOS modes for both kinds of mini window\nESLint, Prettier, JavaScript syntax and patch checks pass\nThe official browser-chrome test remains unrun because the incomplete\nsource checkout prevents an artifact build\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330328\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_zoom.js"], "git_node": "7f0633bd344e921234639a4dae87ea1fa31f4d13", "git_parents": ["5bca37db82d237446a6abe62afb70c291eaad74d"], "node": "63a1e1b6e1ca7cfdb13c9f7c02132cb3f41464ec", "parents": ["af284057e7f1be6bb36ebd6a45276eec1ce79013"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076682 - Keep the prefetch's HTTP cache entry alive on the prefetch record. r=necko-reviewers,sunil\n\nOtherwise a no-store prefetched response can be purged before the navigation uses it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333428\n", "files": ["dom/base/test/browser_prefetch_delivery_type.js", "dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "testing/web-platform/meta/speculation-rules/prefetch/initiators-a-element.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/mutate-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-delivery-type.