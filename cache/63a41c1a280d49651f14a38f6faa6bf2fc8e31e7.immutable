dd6f01bf643bc40181613", "git_parents": ["52fbb1e5ea0df67f9df983234cef13bf67874f85"], "node": "2e5f623e6c1998b09cb29f3affd380b2c0726a34", "parents": ["d78c9ccb38b96726dcddc090c31881631bc8f166"], "tags": []}], "date": 1792550876, "git_changesets": ["5f0ede8ad94c3673a76dd6f01bf643bc40181613"], "user": "ffxbld@lando.moz.tools"}, "45609": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084137 - Support StylePropertyMap.set() with multiple values. r=janv\n\nTrivial-ish now that we support append().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335595\n", "files": ["layout/style/typedom/StylePropertyMap.cpp", "layout/style/typedom/StylePropertyMap.h", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/declared/set.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/inline/set.tentative.html.ini", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/declared/append.tentative.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/inline/append.tentative.html"], "git_node": "81b8bb03d15ef90a5c74821a22db7ebc2d23a00b", "git_parents": ["06fa2674be3db4f3b623bad938282310509cc54b"], "node": "e5420fd54610d9af371feb4853c96c70b613078d", "parents": ["b268695b69daa2cf51723fafcaf6c817837eb96d"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081087 - [devtools] Enable the devtools connection prompt on Nightly r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335559\n", "files": ["devtools/docs/user/browser_toolbox/index.md", "modules/libpref/init/all.js"], "git_node": "8d58e4744c6a9c2d9e7d0f2196b70e88b9a5a2ee", "git_parents": ["81b8bb03d15ef90a5c74821a22db7ebc2d23a00b"], "node": "e3f9af54c0501030654dd37d9ba9d7523c1cc6f5", "parents": ["e5420fd54610d9af371feb4853c96c70b613078d"], "tags": []}, {"author": "Fabio Kaminski \u003cfabio.kaminski@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2080821 Support for color conversion in GetImageData/PutImageData. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334581\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "testing/web-platform/meta/html/canvas/__dir__.ini", "testing/web-platform/meta/html/canvas/offscreen/pixel-manipulation/2d.imageData.createImageBitmap.p3.rgba.unorm8.html.ini", "testing/web-platform/meta/html/canvas/offscreen/pixel-manipulation/2d.imageData.createImageBitmap.p3.rgba.unorm8.worker.js.ini", "testing/web-platform/meta/html/canvas/offscreen/pixel-manipulation/2d.imageData.createImageBitmap.srgb.rgba.unorm8.html.ini", "testing/web-platform/meta/html/canvas/offscreen/pixel-manipulation/2d.imageData.createImageBitmap.srgb.rgba.unorm8.worker.js.ini"], "git_node": "e4a818538bb9744b4b51c2faff5ff812869c3281", "git_parents": ["8d58e4744c6a9c2d9e7d0f2196b70e88b9a5a2ee"], "node": "3e834b59a95fb4e6fd04441d6bc0e4254bb25fb4", "parents": ["e3f9af54c0501030654dd37d9ba9d7523c1cc6f5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084003 - Update Kotlin Serialization to version 1.12.0. r=android-reviewers,android-build-system-reviewers,ahochheiden,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335461\n", "files": ["gradle/libs.versions.toml"], "git_node": "59e3787553aedc6c9db49961327ad43a9725ac62", "git_parents": ["e4a818538bb9744b4b51c2faff5ff812869c3281"], "node": "bb92ea2fd46c3e53f9552b8b97a8b6e1398e30d1", "parents": ["3e834b59a95fb4e6fd04441d6bc0e4254bb25fb4"], "tags": []}, {"author": "Michal Fox \u003cme@dualfroz.com\u003e", "branch": "default", "desc": "Bug 1996443 - Focus the browser window when opening about:logins via LoginHelper.openPasswordManager. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332854\n", "files": ["browser/base/content/test/browser-pageinfo/browser_pageinfo_security.js", "toolkit/components/passwordmgr/LoginHelper.sys.mjs"], "git_node": "16fd06a0033d1a1f0e7540dfe4e7eacea1b632e3", "git_parents": ["59e3787553aedc6c9db49961327ad43a9725ac62"], "node": "9c1b9b8ff0a866b20363df95e3bef61b23aea1ab", "parents": ["bb92ea2fd46c3e53f9552b8b97a8b6e1398e30d1"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Read macOS preference sources separately. r=spohl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332139\n", "files": ["xpcom/base/nsIMacPreferencesReader.idl", "xpcom/base/nsMacPreferencesReader.mm"], "git_node": "1a259e5ea92bde17e0b1699093e493a385b7c242", "git_parents": ["16fd06a0033d1a1f0e7540dfe4e7eacea1b632e3"], "node": "e18df2e1577fbd323271e19dec03562f041f0a15", "parents": ["9c1b9b8ff0a866b20363df95e3bef61b23aea1ab"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Rename shouldIgnoreLocalPolicies to ignoreLocalPoliciesInAutomation. r=jneuberger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332479\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs"], "git_node": "d682fd653534aca794b3f135cba0d86cae644da4", "git_parents": ["1a259e5ea92bde17e0b1699093e493a385b7c242"], "node": "cdd302a402a5b4ed5c40cb9a3f1aacba1b6669b4", "parents": ["e18df2e1577fbd323271e19dec03562f041f0a15"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Rank user policies below all policy providers. r=fluent-reviewers,spohl,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332480\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/locales/en-US/browser/policies/policies-descriptions.ftl", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/tests/xpcshell/test_combined_provider_precedence.js"], "git_node": "08a2832554f59651ddf766e950f801fb30caf2d4", "git_parents": ["d682fd653534aca794b3f135cba0d86cae644da4"], "node": "77dd491122d8ab19f908a7a4c4209de80b932bed", "parents": ["cdd302a402a5b4ed5c40cb9a3f1aacba1b6669b4"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Restrict macOS policy sources to privileged domains. r=jneuberger,spohl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332140\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/macOSPoliciesParser.sys.mjs"], "git_node": "1ac33ebf87b159e31c8b0cefddda3febc61e69cb", "git_parents": ["08a2832554f59651ddf766e950f801fb30caf2d4"], "node": "c26476c3281d6167d01c4788158d2756de05f229", "parents": ["77dd491122d8ab19f908a7a4c4209de80b932bed"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Add tests for macOS policy source selection. r=jneuberger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332141\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_macos_policy_sources.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "b90cf7c0ba3564b0d064fdd018d8eb51ffcdf451", "git_parents": ["1ac33ebf87b159e31c8b0cefddda3febc61e69cb"], "node": "852ec92540dde5d2fe2e937a79dc823dd1616e8d", "parents": ["c26476c3281d6167d01c4788158d2756de05f229"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084106 - Resolve UI test failures during Android release builds r=aaronmt\n\n1. noCrashWithAddonInstalledTest: Failing because the \u201cWikipedia\u201d top site was not available due to region differences.\nFix: Updated the test to click the first top site in the list instead of targeting \u201cWikipedia\u201d directly.\n\n2. verifySearchSettingsMenuItemsTest & verifyGoogleLensFunctionalityTest: Failing while verifying the \u201cGoogle Lens\u201d search option.\nFix: Enabled the \u201cGoogle Lens\u201d feature flag and set it to enabled by default.\n\n3. verifySearchSettingsMenuItemsTest: Failing while verifying the \u201cFirefox Suggest\u201d search options.\nFix: Enabled the \u201cFirefox Suggest\u201d feature by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335619\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelperDelegate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/HomeActivityTestRule.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsAddonsTest.kt"], "git_node": "32ea90ac58d55c0929926cfe310ee625632695a6", "git_parents": ["b90cf7c0ba3564b0d064fdd018d8eb51ffcdf451"], "node": "c3980801ed448962afeaef3eb309c5d64df5e02b", "parents": ["852ec92540dde5d2fe2e937a79dc823dd1616e8d"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082820 - Create 5 new AI controls related regression UI tests r=aaronmt\n\nThe UI tests successfully passed 25x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=107027\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=106151\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334477\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAiControlsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SearchBarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAiControlsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsAIControlsTest.kt"], "git_node": "db3bfee52559a0855594c6440533b55895a36dc9", "git_parents": ["32ea90ac58d55c0929926cfe310ee625632695a6"], "node": "08e15765a096ba77ea91c7d09fc061ea45b7c122", "parents": ["c3980801ed448962afeaef3eb309c5d64df5e02b"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074111 - Stop running browsertime tests on macOS 14.7 that already run on 15.x r=perftest-reviewers,taskgraph-reviewers,aglavic,ahal\n\nPart 1 of 3 in moving browsertime from macOS 14.7 (intel) to macOS 15\n(apple silicon). These 12 tasks already run the same way on both pools,\nso stop scheduling the 14.7 copies on autoland and mozilla-central. They\nwill remain available on Try for a bit.\n\n- firefox js3 and sp3 (including native profiling variants)\n- firefox tp6-essential\n\nAlso exclude 14.7 js3 and sp3 from the general perf testing cron which\nignores run-on-projects\n\nAdditionally, stale macosx1400 references are dropped as that platform\nconfiguration no longer exists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334169\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "1b445acd370923e4b718a6bf47619993eddd78b9", "git_parents": ["db3bfee52559a0855594c6440533b55895a36dc9"], "node": "afd6d4cdb04a704b86120af89940f6a56451e7bb", "parents": ["08e15765a096ba77ea91c7d09fc061ea45b7c122"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080652 - Forbid foreignObject in \u003csvg:use\u003e. r=smaug\n\nEven same-origin. This introduces a lot of security edge cases like\nclonable shadow DOM etc. Matches other engines.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334190\n", "files": ["dom/svg/SVGUseElement.cpp", "layout/reftests/svg/use-restrictions-not-restricted-ref.svg", "layout/reftests/svg/use-restrictions.svg", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/svg/struct/reftests/use-foreignObject.html.ini", "testing/web-platform/tests/svg/struct/scripted/use-script-not-executed.html"], "git_node": "c6c47831d5a9b02ad438219b603d8974e83c00dd", "git_parents": ["1b445acd370923e4b718a6bf47619993eddd78b9"], "node": "1eda20a2fc4e6b74f39b7e4675e4cf57797c9eef", "parents": ["afd6d4cdb04a704b86120af89940f6a56451e7bb"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082871 - Let rotated SVG images and plain rects be drawn by WebRender again. r=emilio\n\nBug 2070993 kept the children of a rotated or skewed transform in the blob\nimage unless they had to be active. This moved rotated \u003cimage\u003e elements into\nthe blob and regressed tsvgx (hixie-004).\n\nOnly strokes and rounded fills need to stay in the blob under rotations:\nWebRender currently renders solid rounded rects and borders axis aligned and\nthen rotates them, which makes their edges blurry. Shapes under a skew also\nstay in the blob, because WebRender anti-aliases each edge separately and\ncoverage bleeds past the acute corners of the skewed shape\n(css/css-transforms/skewX/svg-skewxy-001.html).\n\nThe accumulated 2D transform is passed down to SVGGeometryFrame, which\ncombines it with the stacking context transform and applies these rules.\nA boolean is not enough here because a rotation inside a non-uniform scale\nproduces a skew.\n\nThe non-uniform scale restriction is removed along with the\ngfx.webrender.svg-images.non-uniform-scale pref. The anti-aliasing issues it\nworked around were fixed by the migration from brush shaders to quad shaders.\n\nRotated text is now drawn by WebRender, which increases the anti-aliasing\ndifferences on Windows in layout/reftests/svg/webrender/text-simple.svg, so its\nfuzz is raised.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335099\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/reftests/svg/webrender/reftest.list", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGeometryFrame.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "9d56533cb9baa21c79caee71a200d24654d488b7", "git_parents": ["c6c47831d5a9b02ad438219b603d8974e83c00dd"], "node": "47f7d4134802a9a8fc18715de016dc394e62272e", "parents": ["1eda20a2fc4e6b74f39b7e4675e4cf57797c9eef"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083416 - Part 1. Report decoder device reuse and D3D11 fence support accurately, and add prefs to disable them. r=gfx-reviewers,sotaro\n\nThe reuse decoder device feature was only recorded when the pref was on, and it\nshowed as enabled even when reuse could not happen: on AMD it was forced on\noutside of gfxConfig, and it did not account for software WebRender or a\ncompositor device without video support. Fence support was not reported at all.\nTogether these decide whether video uses the D3D11 sync object.\n\nThe parent now decides decoder device reuse, including the AMD requirement, in\nInitPlatformHardwareVideoConfig, using the adapter from gfxInfo like the\nblocklist does, and also forcing reuse when the compositor device's reported\nadapter is AMD, since gfxInfo can report a different adapter on hybrid GPU\nsystems. That runs again whenever new device status arrives, so the gfxVar is\nnow recomputed then too. The GPU process reports whether the compositor device\nsupports video and fences in D3D11DeviceStatus, which is only used to report\nwhether the compositor device is actually reused.\n\ngfx.direct3d11.reuse-decoder-device-force-disabled disables reuse even where it\nis required, and gfx.direct3d11.fences-enabled turns off fences for D3D11\ntextures. Together they force video onto the sync object on hardware that would\notherwise use fences or a shared device.\n\nFenceD3D11::IsSupportedByDevice is now called for every compositor device, so\nfix its unchecked QueryInterface results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335004\n", "files": ["gfx/config/gfxFeature.h", "gfx/ipc/GraphicsMessages.ipdlh", "gfx/layers/d3d11/FenceD3D11.cpp", "gfx/layers/d3d11/FenceD3D11.h", "gfx/thebes/DeviceManagerDx.cpp", "gfx/thebes/DeviceManagerDx.h", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxWindowsPlatform.cpp", "gfx/thebes/gfxWindowsPlatform.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a0818a07cfc7a744936469b4b963c1190b8720da", "git_parents": ["9d56533cb9baa21c79caee71a200d24654d488b7"], "node": "e9f895b479bd6a66b59946b0d81ef0593eea7391", "parents": ["47f7d4134802a9a8fc18715de016dc394e62272e"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083416 - Part 2. Share one sync object per compositor device between all compositors. r=gfx-reviewers,sotaro\n\nEach RenderCompositorANGLE created its own sync object, so a video decoder only\nsynchronized with the window whose sync handle it was given. That window may\nnot be the one compositing the video, for example after its tab moved to\nanother window, or it may be gone. SWGL with D3D11 already shared one sync\nobject per device through DeviceAttachmentsD3D11.\n\nDeviceManagerDx now creates the sync object together with the compositor\ndevice and drops it with the device. It is handed out together with the device,\nso a compositor always gets the sync object of the device it renders with:\nDeviceAttachmentsD3D11 receives it when created, and RenderThread keeps it with\nthe singleton GL context that ANGLE renders with. It is also created for WARP\ndevices, which ANGLE already did; the WARP exception dated from Windows 7. On\nWARP, content textures now synchronize with it and gfx.use-mutex-on-present\nuses its keyed mutex, like on other devices. If creating it fails on WARP,\nDeviceAttachmentsD3D11 still initializes without it, as before.\n\nSyncObjectHost becomes atomically refcounted because it is now shared across\nthreads. A sync object timeout on any window still triggers a device reset, as\nbefore, but every window now waits on the same keyed mutex.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335005\n", "files": ["gfx/layers/SyncObject.h", "gfx/layers/d3d11/DeviceAttachmentsD3D11.cpp", "gfx/layers/d3d11/DeviceAttachmentsD3D11.h", "gfx/thebes/DeviceManagerDx.cpp", "gfx/thebes/DeviceManagerDx.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderThread.cpp", "gfx/webrender_bindings/RenderThread.h"], "git_node": "481e9ef6a556d0e6c78168815fb3cb525812f45f", "git_parents": ["a0818a07cfc7a744936469b4b963c1190b8720da"], "node": "55ccc25015e7fc35dd15528a06187bb90170b085", "parents": ["e9f895b479bd6a66b59946b0d81ef0593eea7391"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083416 - Part 3. Synchronize with the sync object once per frame, after the frame update, and only when needed. r=gfx-reviewers,lsalzman\n\nCompositorD3D11 acquired the sync object at the start of every frame, while\nRenderCompositorANGLE did so in BeginFrame only while a registered texture\nneeds it (RenderThread::SyncObjectNeeded). Since part 2, both share the same\nsync object, so acquire it once in RendererOGL::UpdateAndRender instead, for\nboth compositors.\n\nAcquiring after wr_renderer_update also covers frames published after\nBeginFrame, and offscreen renders such as view transition captures, which do not\ncall BeginFrame. A timeout is now handled as a device reset for SWGL with D3D11\ntoo, instead of skipping the frame or crashing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335006\n", "files": ["gfx/layers/d3d11/CompositorD3D11.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RendererOGL.cpp"], "git_node": "3da213b28200e680e06166a76a474f6dba8bceee", "git_parents": ["481e9ef6a556d0e6c78168815fb3cb525812f45f"], "node": "fb885e00b773512a809c70d2642f1820ef6384f2", "parents": ["55ccc25015e7fc35dd15528a06187bb90170b085"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083416 - Part 4. RenderDXGIYCbCrTextureHost does not need the sync object. r=gfx-reviewers,lsalzman\n\nThese textures always have a write fence, which LockInternal waits on, and the\nproducer never registers them with the sync object. Requesting the sync object\nonly made the compositors acquire its keyed mutex for nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335007\n", "files": ["gfx/webrender_bindings/RenderD3D11TextureHost.h"], "git_node": "399eeddde62bf4a7a9787c7f39111ea500dd3ad2", "git_parents": ["3da213b28200e680e06166a76a474f6dba8bceee"], "node": "f420c8f42bb4e8ee67b1f19cc7608779e477bf3d", "parents": ["fb885e00b773512a809c70d2642f1820ef6384f2"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082956 - Part 1. Report 10-bit and maximum frame size decoding support from MediaCodec. r=geckoview-reviewers,gfx-reviewers,media-playback-reviewers,bradwerth,padenot,m_kato\n\nHardwareCodecCapabilityUtils.getSupportedMimeTypesWithAccelInfo now also lists\ndecoders which support a 10-bit profile, and the largest frame size supported\nby hardware video decoders. These are exposed through the new\nPlatformMediaCodecs10BitSupported gfxVar and the Platform*HwDecodeMaxSize\ngfxVars for H264, HEVC, VP8, VP9 and AV1, so that both the content process and\nthe media processes can use them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334726\n", "files": ["gfx/config/gfxVars.h", "gfx/thebes/gfxAndroidPlatform.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/HardwareCodecCapabilityUtils.java"], "git_node": "834a69420de8c524417c6e444b784074e2b44b8c", "git_parents": ["399eeddde62bf4a7a9787c7f39111ea500dd3ad2"], "node": "b2db439c86b67227c0a78c667b85ebf306f62a1a", "parents": ["f420c8f42bb4e8ee67b1f19cc7608779e477bf3d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082956 - Part 2. Add MCSInfo helpers to filter MediaCodec decoding support by color depth and frame size. r=media-playback-reviewers,padenot\n\nThese will be used by the decoder modules in the next part.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334727\n", "files": ["dom/media/platforms/MediaCodecsSupport.cpp", "dom/media/platforms/MediaCodecsSupport.h"], "git_node": "e4b134c9d4c96335fd7bc1b0132ff629201c7a47", "git_parents": ["834a69420de8c524417c6e444b784074e2b44b8c"], "node": "873f7360b2c16a7685aa6aaa1f3043e5a2ab771a", "parents": ["b2db439c86b67227c0a78c667b85ebf306f62a1a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082956 - Part 3. Account for color depth and frame size when reporting MediaCodec decoding support. r=media-playback-reviewers,padenot\n\nMediaCodec support is now only reported for 10-bit video when the device has a\n10-bit decoder for the codec, and never above 10-bit. Hardware support is also\ndropped when the frame is larger than any hardware decoder supports.\nAndroidDecoderModule, FFmpegDecoderModule, FFmpegVideoDecoder and\nRemoteDecoderModule share the same rules, so the Java and NDK decoding paths\nreport the same support. H264 and HEVC report software decoding when the\nplatform has a software decoder, and hardware decoding when it is available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334728\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/platforms/android/AndroidDecoderModule.cpp", "dom/media/platforms/ffmpeg/FFmpegDecoderModule.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "7a8fd35d43cfda38ec5910da5f707cbbf12e6b3d", "git_parents": ["e4b134c9d4c96335fd7bc1b0132ff629201c7a47"], "node": "9bd172c3e05ac41b967e6a7fb815722955cb1230", "parents": ["873f7360b2c16a7685aa6aaa1f3043e5a2ab771a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082956 - Part 4. Remove unused HardwareCodecCapabilityUtils code. r=geckoview-reviewers,m_kato\n\ndecodes10Bit has no remaining callers, and the encoder MIME types were always\nrequested from getSupportedMimeTypesWithAccelInfo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334729\n", "files": ["gfx/thebes/gfxAndroidPlatform.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/HardwareCodecCapabilityUtils.java"], "git_node": "bd1d773b32372fc62c1b3c728d940eefea864726", "git_parents": ["7a8fd35d43cfda38ec5910da5f707cbbf12e6b3d"], "node": "05f03bc6735a3374552e44cb1835815af404c3b0", "parents": ["9bd172c3e05ac41b967e6a7fb815722955cb1230"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082956 - Part 5. Update the Android media-capabilities WPT expectations for hardware decoding. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334730\n", "files": ["testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-webrtc-power-efficient.any.js.ini"], "git_node": "0189d9804276443df191da4a2ef4ad3098c9fbbb", "git_parents": ["bd1d773b32372fc62c1b3c728d940eefea864726"], "node": "5f8d8f74f76a4cab06d64ad52cbaa7e661b9c0de", "parents": ["05f03bc6735a3374552e44cb1835815af404c3b0"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Vendor libwebrtc from ce13eaa8e5 r=webrtc-reviewers,mjf\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ce13eaa8e5750b09c46b088a35d74bdadbac25dc\n    [M156] Avoid reusing released decoders after SetDecoders()\n\n    Original change's description:\n    \u003e Avoid reusing released decoders after SetDecoders()\n    \u003e\n    \u003e SetDecoders() only deregistered decoders that were removed or changed,\n    \u003e but it also reset the decoder database's active payload type. The next\n    \u003e frame then released the active decoder and configured the same instance\n    \u003e again. Not all decoders support that: Chromium's hardware decoders fail\n    \u003e Configure() after Release() and permanently fall back to software\n    \u003e decoding. This happens e.g. when the receiving side creates a new offer,\n    \u003e since that typically changes the set of receive codecs.\n    \u003e\n    \u003e Deregister all of the previous decoders instead, so that the factory\n    \u003e creates new instances on demand. This matches how decoders were handled\n    \u003e before the receive stream stopped being recreated on decoder changes\n    \u003e (https://webrtc-review.googlesource.com/c/src/+/494540).\n    \u003e\n    \u003e Bug: chromium:572220780\n    \u003e Change-Id: Ibe646151c9803aab1e01665b8a70352f09e5c101\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508961\n    \u003e Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48904}\n\n    (cherry picked from commit 157bdfb63caa236d7bbdd0889f99ddba96a44fee)\n\n    Bug: chromium:573917369,chromium:572220780\n    Change-Id: Ibe646151c9803aab1e01665b8a70352f09e5c101\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/510040\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8078@{#4}\n    Cr-Branched-From: 3225248425fe2b3cafe389465b94ebc24968d9ba-refs/heads/main@{#48737}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335590\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc"], "git_node": "3e0128c2375e4ad15e00c43cdc480e2c114fb89c", "git_parents": ["0189d9804276443df191da4a2ef4ad3098c9fbbb"], "node": "c4e4cbdd67d9354a68e44337ff25945728c6cd5b", "parents": ["5f8d8f74f76a4cab06d64ad52cbaa7e661b9c0de"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Vendor libwebrtc from 2a990ce0cc r=webrtc-reviewers,mjf\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2a990ce0ccd00a3ad449f2201a8e5c2dad53177d\n    [M156] Keep unchanged video decoders across SetDecoders()\n\n    Original change's description:\n    \u003e Keep unchanged video decoders across SetDecoders()\n    \u003e\n    \u003e Updating the receive codecs, e.g. when the receiving side creates a new\n    \u003e offer, deregistered all decoders and reset the decoder database. The\n    \u003e decoder in use was then recreated and needed a keyframe even if its\n    \u003e configuration hadn't changed, and a keyframe was always requested.\n    \u003e\n    \u003e Apply only the difference between the old and new decoders instead.\n    \u003e Removed or updated decoders are deregistered, added or updated ones are\n    \u003e registered and unchanged decoders, including the one in use, keep\n    \u003e running. A keyframe is now only requested if the decoder in use was\n    \u003e removed or replaced.\n    \u003e\n    \u003e Fixed: chromium:572220780\n    \u003e Change-Id: Ia4e6e4682c8ece42fc175f24d4b406345bd4a81d\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508964\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48907}\n\n    (cherry picked from commit 6870f3a8aa1b1bfdc97f2b8e1dcab9461f533352)\n\n    Bug: chromium:572220780\n    Fixed: chromium:573917369\n    Change-Id: Ia4e6e4682c8ece42fc175f24d4b406345bd4a81d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/510043\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8078@{#5}\n    Cr-Branched-From: 3225248425fe2b3cafe389465b94ebc24968d9ba-refs/heads/main@{#48737}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335591\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc"], "git_node": "0dbb25c1a88085ef508216336b3e5dde826acce9", "git_parents": ["3e0128c2375e4ad15e00c43cdc480e2c114fb89c"], "node": "21aab473ac2a55746380fbed1ec8d859d9350796", "parents": ["c4e4cbdd67d9354a68e44337ff25945728c6cd5b"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083161 - Don't try to update the WebRTC global indicator before its script has loaded. r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335278\n", "files": ["browser/modules/webrtcUI.sys.mjs"], "git_node": "e543a13ca99f5ddbffe6e149d77d67ba823d28a6", "git_parents": ["0dbb25c1a88085ef508216336b3e5dde826acce9"], "node": "e0766fc35a16e837ed33927b0e4e8386e86d9a2b", "parents": ["21aab473ac2a55746380fbed1ec8d859d9350796"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083609 - Preallocate the named pipe used to report crashes r=afranchuk,crashreporting-reviewers\n\nThis change creates the named pipe used by Breakpad's out-of-process\nexception handler in the main process, and then passes the server end to\nthe crash helper when launching it. This way if a child process sets its\nexception handler before the crash helper has started it will wait to\nconnect to the pipe, before this change this would fail and we wouldn't\nset the exception handler at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335063\n", "files": ["toolkit/crashreporter/breakpad-client/windows/crash_generation/crash_generation_server.cc", "toolkit/crashreporter/breakpad-client/windows/crash_generation/crash_generation_server.h", "toolkit/crashreporter/breakpad_wrapper/breakpad_wrapper.cpp", "toolkit/crashreporter/crash_helper/crashhelper.cpp", "toolkit/crashreporter/crash_helper_client/cbindgen.toml", "toolkit/crashreporter/crash_helper_client/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_common/src/breakpad/windows.rs", "toolkit/crashreporter/crash_helper_server/cbindgen.toml", "toolkit/crashreporter/crash_helper_server/src/breakpad_crash_generator.rs", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "307fa94a6c9ac47ecbd1e6fa9f9a7401dc0948da", "git_parents": ["e543a13ca99f5ddbffe6e149d77d67ba823d28a6"], "node": "1ba870c2a4e5aa723982c5073ba2df7de28b4968", "parents": ["e0766fc35a16e837ed33927b0e4e8386e86d9a2b"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083680 - Skip browser windows that are still opening when collecting tab telemetry. r=firefox-desktop-core-reviewers ,mossop\n\nA new window is listed by the window mediator before its gBrowser exists, so\ntab count, tab group and site origin telemetry threw and lost the sample when\ncollected while another window was opening.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335273\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/test/browser/browser.toml", "browser/modules/test/browser/browser_UsageTelemetry_window_opening.js", "toolkit/modules/BrowserTelemetryUtils.sys.mjs"], "git_node": "7706138007c8a02f4f53dd47dad9ac285f8f1e5a", "git_parents": ["307fa94a6c9ac47ecbd1e6fa9f9a7401dc0948da"], "node": "902d120aa0b08ed0d1fa721974e24236396cf272", "parents": ["1ba870c2a4e5aa723982c5073ba2df7de28b4968"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073040 - Replace the edited pin in place when a grouped shortcut's URL changes. r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334889\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "e631b70d6b97955b45a30e41aca1b9eff7344daf", "git_parents": ["7706138007c8a02f4f53dd47dad9ac285f8f1e5a"], "node": "b6ef3f2bc3ba77dfa8fe5dc673187bcb041a53e6", "parents": ["902d120aa0b08ed0d1fa721974e24236396cf272"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the attribution kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nDrop `run-on-repo-type: [hg]` and `clone-with: hg` from the attribution and\nattribution-l10n kinds, so the attributed repackages schedule on git-backed\npushes and check out the GitHub mirror (run-task-git, shallow clone).\n\nVerified on try with attribution-win64-shippable/opt,\nattribution-macosx64-shippable/opt and attribution-win64-aarch64-fr-shippable/opt\ncloning from Git, all green with their builds and signing (24 tasks):\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=4810156dabb1bd6c64a5ebc63fec94d9e8906462\nBoth kinds also ran green as dependencies of the Oct 12 staging-firefox push\nthat verified the repackage and signing families.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335511\n", "files": ["taskcluster/kinds/attribution-l10n/kind.yml", "taskcluster/kinds/attribution/kind.yml"], "git_node": "617f0e94813dae8f37cabad621dda62455559b01", "git_parents": ["e631b70d6b97955b45a30e41aca1b9eff7344daf"], "node": "5a5fac584f575b694aa194cad041b4c0cd8b2848", "parents": ["b6ef3f2bc3ba77dfa8fe5dc673187bcb041a53e6"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075719 - Remove version 157 train-hop guard for the is_ad_eligible_position extra key. r=ini\n\nFirefox 157 has merged to release and no new XPIs will be train-hopped to 156 or older,\nso the `isAdEligiblePositionSupported()` backward-compat guard is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329442\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "fed975358b555ce79b497c193db34ef626fc6dfc", "git_parents": ["617f0e94813dae8f37cabad621dda62455559b01"], "node": "d7e4de6a6eba8cfb5caf808ecb0cd7fa373548dd", "parents": ["5a5fac584f575b694aa194cad041b4c0cd8b2848"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075715 - Remove the version 157 train-hop shim for the recent searches widget search SAP check. r=nina-py\n\nFirefox 157 has merged to release. It carries the `newtab_search_widget` SAP in BrowserSearchTelemetry\nand the partner code config in ConfigSearchEngine, so the host version check for the recent searches\nwidget is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329440\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_RecentSearchesFeed.js"], "git_node": "4744d9bb8fa899b2fd4998c05d942384e94a23e7", "git_parents": ["fed975358b555ce79b497c193db34ef626fc6dfc"], "node": "452a1624dd040fc14c4adbafdd95db5c0e444e40", "parents": ["d7e4de6a6eba8cfb5caf808ecb0cd7fa373548dd"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075716 - Remove the version 157 backward-compat shim around theme-picker shown() in newtab. r=nina-py\n\nFirefox 157 has reached Release and no new train-hop XPIs will target 156 or older, so every host\nthe newtab code runs on has `shown()` on the toolkit `theme-picker` element (added in bug 2052547).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329441\n", "files": ["browser/extensions/newtab/content-src/lib/theme-picker-shown.mjs", "browser/extensions/newtab/test/jest/content-src/lib/theme-picker-shown.test.js"], "git_node": "0935fd00e22e4c02cd4536e20dd0f11cb86abac0", "git_parents": ["4744d9bb8fa899b2fd4998c05d942384e94a23e7"], "node": "4f0dee1fcdff5694e614a6fc25fd304dfcb1d609", "parents": ["452a1624dd040fc14c4adbafdd95db5c0e444e40"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075717 - Remove the version 157 train-hop guard for layout_name in NewTabContentPing. r=ini\n\nFirefox 157 has merged to release and no new XPIs will train-hop to 156 or older, so the\n`@backward-compat { version 157 }` shim in `NewTabContentPing.sanitizeEventData` that\ndeleted `layout_name` on older hosts is no longer needed.\n\nPlus, these days, with bug 2076491 fixed, we can add extra_keys to existing metrics\nin a trainhop compatible way!\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329444\n", "files": ["browser/extensions/newtab/lib/NewTabContentPing.sys.mjs"], "git_node": "3cb110a75b1139ecf01a278b806352eec6a54492", "git_parents": ["0935fd00e22e4c02cd4536e20dd0f11cb86abac0"], "node": "26cd2649e8558661216f781ee3cdac3d65a4a520", "parents": ["4f0dee1fcdff5694e614a6fc25fd304dfcb1d609"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075718 - Remove version 157 train-hop guard for the card_column pocket extra key. r=ini\n\nFirefox 157 has been merged to release and new XPIs won't be train-hopped to 156 or earlier,\nso the platform schema always has the `card_column` extra key.\n\nPlus, these days, with bug 2076491 fixed, we can add extra_keys to existing metrics\nin a trainhop compatible way!\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329443\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs"], "git_node": "f299809b48aa21a322141b238f8781fd36208a7b", "git_parents": ["3cb110a75b1139ecf01a278b806352eec6a54492"], "node": "5733258e8dfda2bd6af0c8e8ed6e0ddfb90e74e9", "parents": ["26cd2649e8558661216f781ee3cdac3d65a4a520"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079624 - Give Wrap Long Lines and Syntax Highlighting in the view-source context menu accesskeys. r=firefox-desktop-core-reviewers ,fluent-reviewers,Gijs,bolsson\n\nNo other item uses O or X in any context a view-source page can show, including the letters proposed in bug 2079632.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333697\n", "files": ["browser/base/content/browser-context.inc.xhtml", "python/l10n/fluent_migrations/bug_2079624_viewsource_context_accesskeys.py", "toolkit/locales/en-US/toolkit/global/viewSource.ftl"], "git_node": "0b199ff48815a0f5871792b1010506e800adf8ef", "git_parents": ["f299809b48aa21a322141b238f8781fd36208a7b"], "node": "881e475b327d207be3b24b4d6ba122aaf395d685", "parents": ["5733258e8dfda2bd6af0c8e8ed6e0ddfb90e74e9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079632 - Let content context menu items that rarely show together share an accesskey, and move Search in a Private Window to V. r=fluent-reviewers,jteow,bolsson\n\nThe edit items keep their letters because every text field's context menu uses the same messages, and each has a keyboard shortcut. The other marked items share a key only in uncommon menus: a link inside editable content, a link in view-source, a selected link or a linked image while Smart Window is enabled, an AI window, or a device list from Sync. Each marked item names the items it shares its key with.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333769\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "browser/locales/en-US/chrome/browser/browser.properties"], "git_node": "5a732c8f01604485f5d468e67dfcd9c4a0302572", "git_parents": ["0b199ff48815a0f5871792b1010506e800adf8ef"], "node": "50de4694d75c37809703a875f02a5cef2d4bb705", "parents": ["881e475b327d207be3b24b4d6ba122aaf395d685"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079607 - Let Search Image with Google Lens share its accesskey with View Selection Source in the content context menu. r=firefox-desktop-core-reviewers ,Gijs\n\nThe two only show together when an image inside a selection is right-clicked, and the image menu has no letter of the label free.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333770\n", "files": ["browser/base/content/browser-context.inc.xhtml"], "git_node": "05e8a22823c9343952f06a36bb560b81534a555f", "git_parents": ["5a732c8f01604485f5d468e67dfcd9c4a0302572"], "node": "9a46e67a0127e76ddd1ab0a946a9753154715caf", "parents": ["50de4694d75c37809703a875f02a5cef2d4bb705"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079606 - Give the highlight items and the PDF viewer's comment and highlight items in the content context menu accesskeys. r=firefox-desktop-core-reviewers ,fluent-reviewers,Gijs,bolsson\n\nRemove Highlight shares H with Copy Link to Highlight, since it only shows on a page opened with a text fragment and no other letter of its label is free. Copy Clean Link to Highlight shares K with Save Link As\u2026, which shows beside it only on a link inside a selection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333771\n", "files": ["browser/base/content/browser-context.inc.xhtml", "python/l10n/fluent_migrations/bug_2079606_text_action_accesskeys.py", "toolkit/locales/en-US/toolkit/global/textActions.ftl"], "git_node": "c98364c8f2b999b26fc9a96dc086e1e4e1e21414", "git_parents": ["05e8a22823c9343952f06a36bb560b81534a555f"], "node": "6e92c23083df589b9bd8cfdbc652319e6ce6a7c7", "parents": ["9a46e67a0127e76ddd1ab0a946a9753154715caf"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075718 - Remove unused AppConstants i