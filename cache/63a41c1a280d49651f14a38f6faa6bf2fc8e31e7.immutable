": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972522 - Use view transitions for sidebar animations r=emilio,nsharpley,desktop-theme-reviewers,sidebar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328556\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-sets.js", "browser/base/content/test/browser-general/browser_backOrSidebarButtonFitts.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-main.css", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/sidebar-pins-promo.css", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/components/sidebar/tests/browser/browser_glean_sidebar.js", "browser/components/sidebar/tests/browser/browser_resize_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/components/sidebar/tests/browser/browser_sidebar_escape_collapse.js", "browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/browser/browser_toolbar_sidebar_button.js", "browser/components/sidebar/tests/browser/browser_tools_overflow.js", "browser/components/sidebar/tests/browser/legacy/browser_sidebar_keys.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/content/tests/browser/browser_bug1693577.js"], "git_node": "54560295c0dff109ec56820b58ea487b54f9fe47", "git_parents": ["f665d5eb1e931e3535acd70a4eb574284cf4912e"], "node": "c3ad02af6ee1100889c12051437322451a5f4686", "parents": ["0494dcc8ebc979c8dd5f4bf4d7bc69915cf3ee99"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079765 - Show the make output when the export tiers fail in mach static-analysis check. r=firefox-build-system-reviewers,sergesanspaille\n\nWithout --verbose the output was discarded, and the failure surfaced as an exception that only gave the exit code and the command line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332337\n", "files": ["python/mozbuild/mozbuild/code_analysis/mach_commands.py"], "git_node": "4143c304c5e4778c4bbfc532fd52350424ccd959", "git_parents": ["54560295c0dff109ec56820b58ea487b54f9fe47"], "node": "a0818e1e822914bc038f130460f51d692a0e794b", "parents": ["c3ad02af6ee1100889c12051437322451a5f4686"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077244 - Make sizeToContent() a no-op in content browsing contexts. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331762\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_sizeToContent_tab.js", "dom/tests/mochitest/chrome/test_resize_move_windows.xhtml"], "git_node": "968de6ac846d9340a09e185792bb2dbffb4b0418", "git_parents": ["4143c304c5e4778c4bbfc532fd52350424ccd959"], "node": "c31d42cf03a2020249abb034508514ee88f6e9d9", "parents": ["a0818e1e822914bc038f130460f51d692a0e794b"], "tags": []}, {"author": "Smagin Ivan \u003csmag.vav@gmail.com\u003e", "branch": "default", "desc": "Bug 1986064 - Use pref_set in test_ext_contentscript_module_import.js. r=rpl\n\nThe test manually set and cleared the pref\nextensions.content_web_accessible.enabled in three tasks. If a task\nfailed early or was run in isolation, the pref could leak into\nsubsequent tests.\n\nReplace the manual Services.prefs.setBoolPref / clearUserPref calls\nwith the pref_set option of add_task, which automatically saves the\ninitial value and restores it after the task completes. This makes the\ntest self-contained and works correctly even when a single task is run\nwith .only().\n\nNo functional change to the test assertions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325611\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_contentscript_module_import.js"], "git_node": "a149c54936a59e20db3f4fd17f7404d6c15ddf91", "git_parents": ["968de6ac846d9340a09e185792bb2dbffb4b0418"], "node": "413c586e1ef1586e6c310bf62cd1c0ff885315c6", "parents": ["c31d42cf03a2020249abb034508514ee88f6e9d9"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1983019 - Avoid quadratic AbortSignal dependency checks r=saschanaz,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331249\n", "files": ["dom/abort/AbortSignal.cpp"], "git_node": "816642447a061ca33cc64aded3f1cbd2dc90a801", "git_parents": ["a149c54936a59e20db3f4fd17f7404d6c15ddf91"], "node": "96c4780fa2b850d29ebe39502565396e9433ea9a", "parents": ["413c586e1ef1586e6c310bf62cd1c0ff885315c6"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074514 - Create new list component for managing site permissions in website settings subpane - r=ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,mstriemer,flod,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328232\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.css", "browser/components/ipprotection/content/vpn-site-rules-list.mjs", "browser/components/ipprotection/jar.mn", "browser/components/preferences/config/privacy.mjs", "