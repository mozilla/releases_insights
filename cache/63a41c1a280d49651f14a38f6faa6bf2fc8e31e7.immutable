cbe\nsv-SE -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nta -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nte -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nth -\u003e 430d05059d624463d581dc494784aeed1d644cbe\ntl -\u003e 430d05059d624463d581dc494784aeed1d644cbe\ntr -\u003e 430d05059d624463d581dc494784aeed1d644cbe\ntrs -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nuk -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nur -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nuz -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nvi -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nwo -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nxh -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nzam -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nzh-CN -\u003e 430d05059d624463d581dc494784aeed1d644cbe\nzh-TW -\u003e 430d05059d624463d581dc494784aeed1d644cbe\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "6ab63d7d2e74b9b60ab4698e54590b583c8a6db0", "git_parents": ["f5f255b814898d66ef5c2347aa0eb5791d5fe187"], "node": "5459221470efc5740aa692f551de6869d977c101", "parents": ["b0a1af3e8e9d0def58431176175c8580a2f817af"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070709 - Add WidgetManager to track the widgets registered by extensions. r=mconley\"\n\nThis reverts commit 13253c74b6737de57cff678872f2dd62e226dd2e.\n\nRevert \"Bug 2070684 - Add a header component and slot to moz-widget. r=nina-py\"\n\nThis reverts commit 2e09c9df2d51b818f0945561b0156abd544f55cf.\n\nRevert \"Bug 2070663 - Add the moz-widget custom element. r=mconley,nina-py\"\n\nThis reverts commit e291a31b70a82c0d6d8c83285dd5d145a42ac594.\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/moz.build", "browser/components/storybook/.storybook/main.js", "browser/components/widgets/content/moz-widget-header.css", "browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/moz.build", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html", "browser/components/widgets/tests/chrome/test_moz_widget_header.html", "toolkit/components/moz.build", "toolkit/components/widgets/WidgetManager.sys.mjs", "toolkit/components/widgets/moz.build", "toolkit/components/widgets/tests/xpcshell/test_WidgetManager.js", "toolkit/components/widgets/tests/xpcshell/xpcshell.toml"], "git_node": "71e78da379f00fe51d44bb6b0d2a31bdd296976b", "git_parents": ["6ab63d7d2e74b9b60ab4698e54590b583c8a6db0"], "node": "97b7173afbdb4237a019c7ae7b05896920c51c71", "parents": ["5459221470efc5740aa692f551de6869d977c101"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078727: Use release assert in RegExpStatics::executeLazy r=spidermonkey-reviewers,jonco\n\nNormally, rerunning a regexp should get the same result. However, if there is a bug in the regexp engine that causes us to fail to match in a case where we should, *and* the choice to emit the buggy code depends on the frequency sampling that the regexp compiler does to its input, then discarding and recompiling can end up with a mismatch. We can nip it all in the bud by simply turning this assert into a release assert.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332218\n", "files": ["js/src/vm/RegExpStatics.cpp"], "git_node": "59579da43a4eec2990f55df48356290c175bc66a", "git_parents": ["71e78da379f00fe51d44bb6b0d2a31bdd296976b"], "node": "cfa14facc82d4af327f55a3afcf548a336eedd2c", "parents": ["97b7173afbdb4237a019c7ae7b05896920c51c71"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2076007 - Part 1: Give JSVAL_TYPE_UNDEFINED a tag that ARM64 materializes in one instruction. r=iain,devtools-reviewers,nchevobbe\n\nThe undefined type code 0x03 is odd, so its shifted tag\n0xfff9800000000000 spans two halfwords and every undefined Value that\nARM64 JIT code stores, pushes or compares against takes two instructions\nto build:\n\n  mov  x21, #0x800000000000\n  movk x21, #0xfff9, lsl #48\n  str  x21, [x23], #8\n\nMoving it to the unused code 0x06 gives 0xfffb000000000000, a single\nmovz:\n\n  mov  x21, #-0x5000000000000\n  str  x21, [x23], #8\n\nUndefined is not a number, a GC thing, or part of the null/object pair,\nso none of the tag ordering micro-optimizations constrain it; the new code\nstays below the private GC thing tag. x86-64 code is unaffected, since\nit materializes both tags with movabs.\n\nThe type code is visible in the execution tracer's value summary\nformat, so its VERSION goes to 4 and the two in-tree readers learn the\nnew code.\n\nOn a JetStream 3 run with an instrumented shell, 184,815 two-instruction\nundefined materializations (Baseline 122,976, Ion 61,629, other stubs\n210) become 185,754 single movz (Baseline 123,073, Ion 62,441, other\n240), with no two-instruction ones left. That is about 185,000\ninstructions, 740 KB of JIT code, per run. The JetStream 3 score is\nunchanged within noise (242.3 before, 241.1 after, three alternating\nruns each).\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329492\n", "files": ["devtools/client/shared/components/reps/reps/value-summary-reader.mjs", "js/public/Debug.h", "js/public/Value.h", "js/src/jit-test/tests/debug/ExecutionTracer-traced-values.js"], "git_node": "0fe63d75a044c755f20861c809dbd5df52eca24b", "git_parents": ["59579da43a4eec2990f55df48356290c175bc66a"], "node": "e8c957d95045b24579f2674f73eff37e8af1f6d4", "parents": ["cfa14facc82d4af327f55a3afcf548a336eedd2c"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2076007 - Part 2: Give JSVAL_TYPE_INT32 a tag that ARM64 materializes in one instruction. r=iain,devtools-reviewers,nchevobbe,profiler-reviewers,canova\n\nThe int32 type code 0x01 is odd, so its shifted tag 0xfff8800000000000\nspans two halfwords, and an int32 Value constant takes three\ninstructions to build on ARM64, as when Baseline pushes an int constant:\n\n  mov  x16, #0x36\n  movk x16, #0x8000, lsl #32\n  movk x16, #0xfff8, lsl #48\n  sub  sp, x20, #8\n  str  x16, [x20, #-8]!\n\nMoving INT32 to 0x02 gives 0xfff9000000000000, which needs only one\nhalfword, so the middle movk goes away:\n\n  mov  x16, #0x36\n  movk x16, #0xfff9, lsl #48\n  sub  sp, x20, #8\n  str  x16, [x20, #-8]!\n\nA store of the bare tag likewise becomes a single movz. Double stays the\nonly tag below Int32, so isNumber's tag \u003c= Int32 test is unchanged and\n0x01 is left unused.\n\nBOOLEAN moves to 0x03 because ValueUpperExclShiftedNumberTag relies on\nit being the tag right after Int32 (now enforced by a static_assert).\nThat makes the boolean tag the one that spans two halfwords, but int32\nconstants are far more common. Boxing a register costs two instructions\nfor either tag before and after, since the backend already folds an\nodd tag into orr with a shifted operand.\n\nThe type codes are visible in the execution tracer's value summary\nformat, and the three in-tree readers learn the new codes. VERSION stays\nat the 4 that Part 1 sets, since the two parts land together. The\nprofiler mochitest's copy of the type codes was also stale after bug\n2071531 and Part 1, so it now matches Value.h in full.\n\nOn a JetStream 3 run with an instrumented shell, not counting boxes,\nint32 tag and constant materializations drop from 1,030,866 to 687,678\ninstructions (Baseline 975,670 to 651,291, Ion 55,196 to 36,387) and\nboolean ones grow from 89,828 to 147,865, a net saving of about 285,000\ninstructions, 1.1 MB of JIT code, per run. The JetStream 3 score is\nunchanged within noise (242.1 before, 240.0 after, three alternating\nruns each).\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329872\n", "files": ["devtools/client/shared/components/reps/reps/value-summary-reader.mjs", "js/public/Value.h", "js/src/jit-test/tests/debug/ExecutionTracer-traced-values.js", "tools/profiler/tests/browser/browser_test_feature_jstracing_values.js"], "git_node": "3edd3c76194a3b26b5b0d3dd8d57ea56ad5a47f4", "git_parents": ["0fe63d75a044c755f20861c809dbd5df52eca24b"], "node": "4292ed3f7a3f0dfc04ef9d6fddd04c1db605f1a8", "parents": ["e8c957d95045b24579f2674f73eff37e8af1f6d4"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078769: Skip recoveredOnBailout instructions in CanFoldShiftIntoUse r=spidermonkey-reviewers,jandem,gaul\n\nThis triggers an assertion in a debug build. I couldn't see any problems with the resulting code in a non-debug build, but I didn't look very hard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332209\n", "files": ["js/src/jit-test/tests/ion/bug2078769.js", "js/src/jit/arm64/Lowering-arm64.cpp"], "git_node": "483ac2bbf60772456b063381ee3d899e10d6e332", "git_parents": ["3edd3c76194a3b26b5b0d3dd8d57ea56ad5a47f4"], "node": "dd9d8cd504ac8e9c2d895f2f3cb43289a00f8346", "parents": ["4292ed3f7a3f0dfc04ef9d6fddd04c1db605f1a8"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076964 - Renew addons_manager.* telemetry expiring in Firefox 161. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331942\n", "files": ["toolkit/mozapps/extensions/metrics.yaml"], "git_node": "5082708f0f812198f10254bd971583fa61471164", "git_parents": ["483ac2bbf60772456b063381ee3d899e10d6e332"], "node": "6cb0f91e2dce9b4f7cf3928231332f17d40fe70c", "parents": ["dd9d8cd504ac8e9c2d895f2f3cb43289a00f8346"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079672 - [Nova] Fix per addon-card message bars styling to better match figma specs. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331958\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css"], "git_node": "e669a840c69519ebf2ee61298a6448c53bf9d3f6", "git_parents": ["5082708f0f812198f10254bd971583fa61471164"], "node": "7328ee7289648859c00daa55e5297bb4755bd01c", "parents": ["6cb0f91e2dce9b4f7cf3928231332f17d40fe70c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076981: Move template data inside Token r=arai\n\nI was going to put the proposed patch in bug 2076981 up for review, but as I was applying it I was slightly dissatisfied that it required us to store additional values every time we initialized a TokenStreamPosition. I asked Claude to suggest alternatives, and after some back and forth, this is what we came up with. It stores the template data in the Token instead of the TokenStreamAnyChars. I think this ends up doing strictly less work than the original patch, but I'm not particularly familiar with this part of the codebase, so if there's some reason that this patch is undesirable, I'm happy to fall back to the originally suggested patch .\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331743\n", "files": ["js/src/frontend/Parser.cpp", "js/src/frontend/Token.h", "js/src/frontend/TokenStream.cpp", "js/src/frontend/TokenStream.h", "js/src/jit-test/tests/parser/bug2076981.js"], "git_node": "b081bd87a5a0de4c49a098980957c0b9dd1a3dca", "git_parents": ["e669a840c69519ebf2ee61298a6448c53bf9d3f6"], "node": "945a69002169307df46adb8ad821e0280237e60a", "parents": ["7328ee7289648859c00daa55e5297bb4755bd01c"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059852 - Contain keyboard focus inside Edit Avatar dialog r=mkennedy,niklas\n\nOpening the dialog with show() left the rest of the page focusable, so tabbing past the last element moved focus to content hidden behind the dialog.showModal() makes the rest of the page inert for keyboard and screen reader users.\n\nThe browser now handles Escape and clicks outside the dialog through closedby, instead of our own document click listener. In the crop view, outside clicks are ignored and Escape goes back to the custom view instead of closing the dialog. The dialog is anchored under the edit button with CSS anchor positioning and scrolls with the page instead of being pinned to the viewport.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331668\n", "files": ["browser/components/profiles/content/profile-avatar-selector.css", "browser/components/profiles/content/profile-avatar-selector.mjs", "browser/components/profiles/tests/browser/browser_custom_avatar_test.js", "browser/components/profiles/tests/browser/browser_edit_profile_test.js"], "git_node": "15140172d36dc5d33bc7ab02cf0ef22c83ed406b", "git_parents": ["b081bd87a5a0de4c49a098980957c0b9dd1a3dca"], "node": "66fce3ef7aa5b537a4c1c34ce90f002888335878", "parents": ["945a69002169307df46adb8ad821e0280237e60a"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073384 - Part 1: Request audio focus only when playback starts. r=android-reviewers,matt-tighe\n\nWhen the platform takes audio focus away, the page's media is suspended, but a\npage that declares a playing media session keeps reporting that it is playing.\nEvery later media session update then requested audio focus again and took it\nstraight back, which silenced an alarm right after it started ringing.\n\nRequest audio focus once per playing tab and audio session type, and again only\nafter playback pauses or stops. A later audio session type change still reshapes\nthe request. A request that is not granted right away is retried on the next\nupdate, and only the latest start of the foreground service requests audio\nfocus, provided playback has not paused in the meantime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331396\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/focus/AudioFocus.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt"], "git_node": "e37a089265f481ba5f3b03f19a2d8a21bddfcaa9", "git_parents": ["15140172d36dc5d33bc7ab02cf0ef22c83ed406b"], "node": "f455e11fcc222f1327f9852ec452845a12d34ede", "parents": ["66fce3ef7aa5b537a4c1c34ce90f002888335878"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073384 - Part 2: Request audio focus when the user resumes from the platform media controls. r=android-reviewers,matt-tighe\n\nAfter the system takes audio focus away for good, a page that declares a playing\nmedia session never reports a pause, so no new playback start requests focus\nagain. An explicit play command from the platform media session, such as a car,\nheadset or assistant play, now requests audio focus directly.\n\nResuming from the page's own controls in that state is not covered yet; that\nneeds Gecko to report that the media actually started playing again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331397\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/session/MediaSessionCallback.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/session/MediaSessionCallbackTest.kt"], "git_node": "4f31a2983c8f03d5fd2c0b426b13f96d5e70785c", "git_parents": ["e37a089265f481ba5f3b03f19a2d8a21bddfcaa9"], "node": "6dbd1c4cc1587936c37c22725863788475018e26", "parents": ["f455e11fcc222f1327f9852ec452845a12d34ede"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073384 - Part 3: Test audio focus requests during media session updates. r=android-reviewers,matt-tighe\n\nCover that repeated updates for a playing tab do not request audio focus again,\nincluding after a transient or permanent focus loss, and that pausing, stopping,\nshutting down, switching tabs, changing the audio session type, a denied request\nand an explicit play from the platform media session all lead to a new request.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331398\n", "files": ["mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/focus/AudioFocusTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/session/MediaSessionCallbackTest.kt"], "git_node": "480047293d5acb2b19b81e06ee15340c8c867a83", "git_parents": ["4f31a2983c8f03d5fd2c0b426b13f96d5e70785c"], "node": "f9ec1138233190af8f38ff30167789c17ee6b31a", "parents": ["6dbd1c4cc1587936c37c22725863788475018e26"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080058 - Assign lockstore files to the Core :: Security: Keystore component. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332370\n", "files": ["security/lockstore/moz.build"], "git_node": "47f18c57aeefc87910a3b8b9cb7255fca897a2f0", "git_parents": ["480047293d5acb2b19b81e06ee15340c8c867a83"], "node": "2e20ab6bfc7cc57107f16d81f1eeff8539fbe121", "parents": ["f9ec1138233190af8f38ff30167789c17ee6b31a"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078471 - Only check ShowShortcuts calls in test_input_selection. r=yjamora\n\nA late GenAI:HideShortcuts from the previous test's closed tab could land\nafter the stub was installed and be mistaken for the first call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331344\n", "files": ["browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "c62a1bf95696b0f03bc0c522be6d5548d8111804", "git_parents": ["47f18c57aeefc87910a3b8b9cb7255fca897a2f0"], "node": "7db1d0f92fbdc13b512367a9586e62a50fe28cad", "parents": ["2e20ab6bfc7cc57107f16d81f1eeff8539fbe121"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1972522 - Use view transitions for sidebar animations r=emilio,nsharpley,desktop-theme-reviewers,sidebar-reviewers\" for causing marionette failures at restore_sidebar.py\n\nThis reverts commit 54560295c0dff109ec56820b58ea487b54f9fe47.\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-sets.js", "browser/base/content/test/browser-general/browser_backOrSidebarButtonFitts.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-main.css", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/sidebar-pins-promo.css", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/components/sidebar/tests/browser/browser_glean_sidebar.js", "browser/components/sidebar/tests/browser/browser_resize_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/components/sidebar/tests/browser/browser_sidebar_escape_collapse.js", "browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/browser/browser_toolbar_sidebar_button.js", "browser/components/sidebar/tests/browser/browser_tools_overflow.js", "browser/components/sidebar/tests/browser/legacy/browser_sidebar_keys.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/content/tests/browser/browser_bug1693577.js"], "git_node": "adf229ce4bfc472872f7f8a64825d2fe7ddbe6f6", "git_parents": ["c62a1bf95696b0f03bc0c522be6d5548d8111804"], "node": "8dd0c5ce6dcab80386d7007214310d4a8d7b14da", "parents": ["7db1d0f92fbdc13b512367a9586e62a50fe28cad"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059852 - Contain keyboard focus inside Edit Avatar dialog r=mkennedy,niklas\" for causing bc tests failures at components/profiles\n\nThis reverts commit 15140172d36dc5d33bc7ab02cf0ef22c83ed406b.\n", "files": ["browser/components/profiles/content/profile-avatar-selector.css", "browser/components/profiles/content/profile-avatar-selector.mjs", "browser/components/profiles/tests/browser/browser_custom_avatar_test.js", "browser/components/profiles/tests/browser/browser_edit_profile_test.js"], "git_node": "854e8a341da420a3e71ed1e540843f75702d9b75", "git_parents": ["adf229ce4bfc472872f7f8a64825d2fe7ddbe6f6"], "node": "781b0e70fce12b0c024094368110df1562c9f23b", "parents": ["8dd0c5ce6dcab80386d7007214310d4a8d7b14da"], "tags": []}, {"author": "Simon Friedberg