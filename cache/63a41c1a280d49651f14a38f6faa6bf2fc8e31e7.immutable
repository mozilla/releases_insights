/xslt/base/txOwningArray.h", "dom/xslt/xml/moz.build", "dom/xslt/xpath/moz.build", "dom/xslt/xslt/moz.build", "dom/xul/moz.build", "tools/clang-tidy/config.yaml"], "git_node": "3e573caff5c8f726c726d8872f781238f2b68733", "git_parents": ["de1992f30a3c86a0bafdeb0b5f0c9059e8a8886d"], "node": "ab3a92911e26b116ffd984c387febf053aa6d3d0", "parents": ["b60bd4dbea75ff8ffa1686c4e371dfd0be1ab133"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077198 - Fix for toolchain build bustages\n", "files": ["taskcluster/kinds/toolchain/embedded-uniffi-bindgen.yml", "taskcluster/kinds/toolchain/mozcheck.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml"], "git_node": "abd7e5c05328cadc5ca50b595690233ab1cee705", "git_parents": ["3e573caff5c8f726c726d8872f781238f2b68733"], "node": "970618192a5ace08da90090c1d248192a298fd3e", "parents": ["ab3a92911e26b116ffd984c387febf053aa6d3d0"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077198 - Further fix for toolchain build bustages\n", "files": ["taskcluster/kinds/toolchain/embedded-uniffi-bindgen.yml", "taskcluster/kinds/toolchain/mozcheck.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml"], "git_node": "603df3b06f10aafe7294d5021ff06a670a592b39", "git_parents": ["abd7e5c05328cadc5ca50b595690233ab1cee705"], "node": "a23a97f6f68425aa14932e0b2e100aad5edc68d1", "parents": ["970618192a5ace08da90090c1d248192a298fd3e"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077198 - Further fix for toolchain build bustages\n", "files": ["taskcluster/kinds/toolchain/embedded-uniffi-bindgen.yml", "taskcluster/kinds/toolchain/mozcheck.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml"], "git_node": "72c01a4a09fabff47c56cfea5b0cafa1adf9dd38", "git_parents": ["603df3b06f10aafe7294d5021ff06a670a592b39"], "node": "f80b71c14f9b467d045b089d9017a55a4d855848", "parents": ["a23a97f6f68425aa14932e0b2e100aad5edc68d1"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2077221 [wpt PR 63167] - [wdspec] Fix worker subtests in script.realmDestroyed WPT, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Fix worker subtests in script.realmDestroyed WPT\n\n- Fix the dedicated and shared worker subtests in the\n  script.realmDestroyed WPT suite and prevent duplicate\n  script.realmDestroyed events when worker targets crash or close.\n- Previously, the dedicated worker subtests terminated workers via a\n  100ms timer that raced with CDP worker target initialization, while\n  the shared worker subtest navigated away and left the worker frozen\n  in BFCache; additionally, CdpTargetManager disposed crashed worker\n  realms without removing them from storage, causing a duplicate\n  script.realmDestroyed event on target detach.\n- Wait for script.realmCreated before terminating dedicated workers,\n  close the tab in test_shared_worker to bypass BFCache, and call\n  deleteRealms in CdpTargetManager.#handleTargetCrashedEvent.\n\nBug: 411416746, 324436866\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I36c8f7f1086adc137ebb2c7e2a85995143f08a1e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8497210\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCommit-Queue: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1708855}\n\n--\n\nwpt-commits: 691aca74c55eb13859895abab25d0b43dd6e1e39\nwpt-pr: 63167\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/script/realm_destroyed/realm_destroyed.py"], "git_node": "026fef64afb1dda410d21ae333295d0a24335bd1", "git_parents": ["72c01a4a09fabff47c56cfea5b0cafa1adf9dd38"], "node": "745a1b82a8ae545b65d4c96681eab0f9b51e9743", "parents": ["f80b71c14f9b467d045b089d9017a55a4d855848"], "tags": []}, {"author": "object-ions \u003cmoshikoatia@gmail.com\u003e", "branch": "default", "desc": "Bug 2077056 [wpt PR 63154] - Test that an input's value resets after a text to file to text type change, a=testonly\n\nAutomatic update from web-platform-tests\nTest that an input's value resets after a text to file to text type change\n\nCovers steps 2 and 3 of the input type change algorithm: after changing\ntype from text to file and back to text, the value is the value content\nattribute (or the empty string) and the dirty value flag is false.\n\nCloses #2611.\n\n--\n\nwpt-commits: 052717023c40d0a0827507451a5246d6227bea7f\nwpt-pr: 63154\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-input-element/type-change-text-to-file-to-text.html"], "git_node": "6306f935e27310a981eb44a64a9950b328cf58ab", "git_parents": ["026fef64afb1dda410d21ae333295d0a24335bd1"], "node": "ca4ac592efa6877f853cd2eb9435adf660dfffbf", "parents": ["745a1b82a8ae545b65d4c96681eab0f9b51e9743"], "tags": []}, {"author": "Brian Kardell \u003cbkardell@gmail.com\u003e", "branch": "default", "desc": "Bug 2076796 [wpt PR 63106] - Add WEB_FEATURES.yml for text-transform math rules, a=testonly\n\nAutomatic update from web-platform-tests\nAdd WEB_FEATURES.yml for text-transform math rules (#63106)\n--\n\nwpt-commits: bc3c0fe9e1b54c033afe67b1164c2baf13b52055\nwpt-pr: 63106\n", "files": ["testing/web-platform/tests/css/css-text/text-transform/math/WEB_FEATURES.yml"], "git_node": "524c8699cbc9d796797437b07d7df4dbf4e76120", "git_parents": ["6306f935e27310a981eb44a64a9950b328cf58ab"], "node": "cf9b12de9e121fb15d7b72f21f899f8853bedac4", "parents": ["ca4ac592efa6877f853cd2eb9435adf660dfffbf"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076985 [wpt PR 63126] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325177, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC][Integration] Allow basic repeat() (#63126)\n\nStyle::GridTemplateList already expands repeat() with an integer count into\nits list of track sizes, and GFC reads that expanded list for the explicit\ntrack count, the track sizing functions, and line-based placement. So the\nintegration code was the only thing keeping grids that use repeat() out of\nGFC.\n\nAllow repeat(\u003cinteger\u003e, ...) in grid-template-columns and grid-template-rows\nas long as every entry inside it meets the same rules as a top-level entry:\nfixed breadth track sizes and no line names. repeat(auto-fill, ...) and\nrepeat(auto-fit, ...) are still rejected, since computing the number of\nrepetitions from the available space is not yet implemented.\n\nAlso check the expanded track sizes when looking for percentage rows in a\ngrid with an indefinite height. Previously only top-level entries were\nchecked, so repeat(2, 10%) would have been let into GFC.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325177\nWebKit-Canonical-Link: https://commits.webkit.org/321911@main\n--\n\nwpt-commits: b2b20667621999d93b3f920ae13aa43e8c489cb2\nwpt-pr: 63126\n", "files": ["testing/web-platform/tests/css/css-grid/grid-definition/grid-repeat-integer-001.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-repeat-integer-002.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-repeat-integer-003.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-repeat-integer-004.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-repeat-integer-005.html"], "git_node": "685d3bd34d45ad5faf925c9b887703c859a0f20b", "git_parents": ["524c8699cbc9d796797437b07d7df4dbf4e76120"], "node": "ff4713b995994a0f2241749a2b1751323785d496", "parents": ["cf9b12de9e121fb15d7b72f21f899f8853bedac4"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076987 [wpt PR 63128] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322714, a=testonly\n\nAutomatic update from web-platform-tests\n[Grid] Grid item with an aspect ratio keeps its stale inline contribution when the grid container shrinks (#63128)\n\n\u003cdiv id=grid style=\"display: grid; grid-template-columns: 1fr 1fr; width: 200px\"\u003e\n    \u003cdiv style=\"aspect-ratio: 1.5\"\u003e\u003c/div\u003e\n    \u003cdiv\u003e\u003c/div\u003e\n  \u003c/div\u003e\n  \u003cscript\u003egrid.style.width = \"150px\"\u003c/script\u003e\n\nAfter the shrink both 1fr columns should be 75px wide. Instead the first one\nstayed 100px and the second got the leftover 50px.\n\nGrid runs a second column sizing pass for items whose inline size depends on\ntheir block size, and it measures them with the row size installed as an\noverriding block size. The aspect ratio then transfers that row size into the\nitem's inline size, and the 100px result gets cached as the item's min-content\ncontribution. shouldInvalidateContentWidths(), which tells the next layout to\nmeasure again, only covered flex items, so the 100px stayed cached and floored\nthe flexible track. Growing the container hid this because the larger fr share\nwas already above the stale value.\n\nAdd grid items next to the flex item case, which 241542@main added for the same\nreason.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322714\nWebKit-Canonical-Link: https://commits.webkit.org/320117@main\n\nCo-authored-by: Alan Baradlay \u003czalan@apple.com\u003e\nCo-authored-by: Claude Opus 5 (1M context) \u003cnoreply@anthropic.com\u003e\n--\n\nwpt-commits: 1e2d8fddddf3ce2ff784ddad5454060bd0e4ce71\nwpt-pr: 63128\n", "files": ["testing/web-platform/tests/css/css-grid/grid-items/aspect-ratio-grid-item-dynamic-container-shrink-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-items/aspect-ratio-grid-item-dynamic-container-shrink-001.html"], "git_node": "932170faca25edfbe0584cab1956f809adc92c06", "git_parents": ["685d3bd34d45ad5faf925c9b887703c859a0f20b"], "node": "0c29a49e86fc8e494a52b4a48b29f8e1b4f125de", "parents": ["ff4713b995994a0f2241749a2b1751323785d496"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076988 [wpt PR 63129] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324377, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] Floor grid items' content box size to zero. (#63129)\n\nThis PR fixes a bug where a stretched grid item whose padding\nexceeds its grid area is sized to a negative content box.\n\nstretchFitSize() subtracts the item's margins, border, and padding from the available space without\na floor. Adding the border and padding back cancels the negative exactly, so the item's border box\ncomes out as the grid area size rather than the padding sum, leaving it narrower than its own\npadding.\n\nA content box cannot be negative, so clamp it to zero. The item then stretches to a zero content\nbox and overflows its grid area, which is what legacy RenderGrid and Blink both produce.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324377\nWebKit-Canonical-Link: https://commits.webkit.org/321295@main\n\nCo-authored-by: Yulun Wu \u003cyulun_wu@apple.com\u003e\n--\n\nwpt-commits: b86f29a1854c1c97480738c97865145a4f40b16c\nwpt-pr: 63129\n", "files": ["testing/web-platform/tests/css/css-grid/grid-items/grid-item-border-padding-005-ref.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-border-padding-005.html"], "git_node": "49763af9e393d9fa9984a9e6445f69416f425d42", "git_parents": ["932170faca25edfbe0584cab1956f809adc92c06"], "node": "8bf533d042bfbb0894ef56206a1656a4c8ecbdae", "parents": ["0c29a49e86fc8e494a52b4a48b29f8e1b4f125de"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076989 [wpt PR 63130] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324920, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] Support fixed margins on grid items (#63130)\n\nThis PR admits grid items with fixed or known zero margins into GFC and renames GridItemHasMargin to GridItemHasUnsupportedMargin.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324920\nWebKit-Canonical-Link: https://commits.webkit.org/321739@main\n\nCo-authored-by: Yulun Wu \u003cyulun_wu@apple.com\u003e\n--\n\nwpt-commits: a4709826e5566139ab86ee5b0c1c5f2376cf35b6\nwpt-pr: 63130\n", "files": ["testing/web-platform/tests/css/css-grid/grid-items/grid-item-fixed-margin-001.html"], "git_node": "3384caacf960301839c87342f870928a435422ad", "git_parents": ["49763af9e393d9fa9984a9e6445f69416f425d42"], "node": "56aff619a18e00732d6848680da6f985158c6552", "parents": ["8bf533d042bfbb0894ef56206a1656a4c8ecbdae"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076991 [wpt PR 63131] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324516, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC][Integration] Relax restriction related to items locked to a row. (#63131)\n\nThe integration logic had some logic that would decide not to run GFC if\nwe had more items that were locked to a given row than there were\ncolumns in the explicit grid. This is because we needed logic to add\nextra columns to the grid to fit the number of items in that row. That\nlogic has now been added so we can remove this gate.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324516\nWebKit-Canonical-Link: https://commits.webkit.org/321410@main\n--\n\nwpt-commits: d35b2d4ee0114d3e02c30e2c74feac39c9995a13\nwpt-pr: 63131\n", "files": ["testing/web-platform/tests/css/css-grid/placement/grid-implicit-columns-for-items-locked-to-row-001.html"], "git_node": "886c93b5a98be14806cc97456b829659e56bbb2a", "git_parents": ["3384caacf960301839c87342f870928a435422ad"], "node": "c0e9645a29d4e8ee5d24f33ca36b36de3ea986ec", "parents": ["56aff619a18e00732d6848680da6f985158c6552"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076992 [wpt PR 63132] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320665, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC][Integration] Allow grid items in trailing implicit columns. (#63132)\n\nThis allows content when a grid item is has a column placement that is\noutside any explicit columns. For example, grid-column: 4 / 5 should be\nallowed if there are only two explicit columns.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=320665\nWebKit-Canonical-Link: https://commits.webkit.org/321954@main\n--\n\nwpt-commits: 4766065197fd5473a3aa0018130f41e673043761\nwpt-pr: 63132\n", "files": ["testing/web-platform/tests/css/css-grid/implicit-grids/grid-item-placed-in-trailing-implicit-column-001.html"], "git_node": "8477fa534b20291a87b71434b725ed13aaeda5d8", "git_parents": ["886c93b5a98be14806cc97456b829659e56bbb2a"], "node": "6c6bdd197666a3376ec503fbf1abb553c96f7531", "parents": ["c0e9645a29d4e8ee5d24f33ca36b36de3ea986ec"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076998 [wpt PR 63134] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322871, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] Fixed track sizing functions get overridden during \"size tracks to fit non-spanning items\". (#63134)\n\nsizeTracksToFitNonSpanningItems() implements the step of the track sizing algorithm which\nsizes the intrinsic breadths of a track from the items in it:\nhttps://drafts.csswg.org/css-grid-2/#algo-single-span-items\n\nThat step has a clause for each intrinsic breadth, and none for a \u003clength-percentage\u003e one,\nsince Initialize Track Sizes already resolved those to an absolute length. Both switchOn()\nover the track sizing functions assigned unconditionally though, so a \u003clength-percentage\u003e\nbreadth fell into the ASSERT_NOT_REACHED() case and overwrote the resolved size with zero.\n\nInstead, we should just return the base size/growth limit that was\ndetermined during the \"Initialize Track Sizes,\" step.\n\nThe test covers each of the fixed, percentage and calculated breadths against each of the\nauto, min-content and max-content breadths, in both the minimum and the maximum position. It\nis limited to rows because an implicit column cannot be run through GFC yet, whether it comes\nfrom a column auto flow or from an item placed past the explicit grid, so the equivalent\ngrid-auto-columns cases are still handled by legacy grid layout.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322871\nWebKit-Canonical-Link: https://commits.webkit.org/320168@main\n--\n\nwpt-commits: 5337076ee83ec1ccb6726d6e2e501161880bd2f5\nwpt-pr: 63134\n", "files": ["testing/web-platform/tests/css/css-grid/layout-algorithm/minmax-tracks-with-fixed-breadths.html"], "git_node": "8f2ff6142478353fd12a21b890fa693e4e0bd7fd", "git_parents": ["8477fa534b20291a87b71434b725ed13aaeda5d8"], "node": "e3f3ffb5dff5e4fb0e4449e6ed4be6cecc37ed0f", "parents": ["6c6bdd197666a3376ec503fbf1abb553c96f7531"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076998 [wpt PR 63134] - Update wpt metadata, a=testonly\n\nwpt-pr: 63134\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/layout-algorithm/minmax-tracks-with-fixed-breadths.html.ini"], "git_node": "6557c6ccde82bb32e8538e345e6803384b3ed5fc", "git_parents": ["8f2ff6142478353fd12a21b890fa693e4e0bd7fd"], "node": "724294295b9fee230bb74f036499d5c86c9d5fa0", "parents": ["e3f3ffb5dff5e4fb0e4449e6ed4be6cecc37ed0f"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077001 [wpt PR 63135] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324606, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC][Integration] Allow items placed past the explicit grid. (#63135)\n\nWe recently allowed items with negative line numbers which got placed before the start\nof the explicit grid. Now we allow support for the opposite case since we handle needing\nto add tracks to the end of the grid in a similar way.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324606\nWebKit-Canonical-Link: https://commits.webkit.org/321629@main\n--\n\nwpt-commits: 29897ed964853b9caaad4f9136a10d4286ba3431\nwpt-pr: 63135\n", "files": ["testing/web-platform/tests/css/css-grid/placement/grid-implicit-track-placement-001.html"], "git_node": "fdf034fe49297553fcf701e0b72f166c749c9fd0", "git_parents": ["6557c6ccde82bb32e8538e345e6803384b3ed5fc"], "node": "fcc16157d6baf838350eb2d8c977859f3fa417cd", "parents": ["724294295b9fee230bb74f036499d5c86c9d5fa0"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077003 [wpt PR 63136] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323369, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] A grid item's automatic minimum size is not clamped to a fixed max track sizing function. (#63136)\n\nhttps://drafts.csswg.org/css-grid-1/#min-size-auto says that if a grid item spans only grid tracks\nthat have a fixed max track sizing function, then its specified size suggestion and content size\nsuggestion are further clamped to less than or equal to the stretch fit into the grid area's\nmaximum size in that dimension, as represented by the sum of those grid tracks' max track sizing\nfunctions plus any intervening fixed gutters.\n\nGFC never applied that clause. automaticMinimumInlineSize() and automaticMinimumBlockSize() only\nclamped the size suggestion by the item's own maximum size, so an item whose content is taller or\nwider than its grid area kept a content-based minimum size larger than the maximum the author gave\nthe tracks it spans.\n\nThe automatic minimum size is queried in two places, and the two know the grid area differently.\n\nWhile track sizing is in progress the grid area does not exist yet, so gridAreaMaximumSize()\napproximates it by the sum of the spanned tracks' max track sizing functions plus the gutters\nbetween them. This is the size described in the blub from the portion of\nthe spec mentioned earlier.\n\nOnce the tracks are sized the grid area is resolved, so inlineMinimumSize() and blockMinimumSize()\nclamp against the grid area itself. Without this the row is capped correctly but the item inside it\nis still laid out at its content size and overflows its own grid area.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323369\nWebKit-Canonical-Link: https://commits.webkit.org/320750@main\n--\n\nwpt-commits: 1ccaca57518f083e3003190f902952c5876377ea\nwpt-pr: 63136\n", "files": ["testing/web-platform/tests/css/css-grid/layout-algorithm/automatic-minimum-size-clamped-to-fixed-max-track-sizing-function.html"], "git_node": "ca61138f7f00fc4dba20250cf75772a5ba85ad5a", "git_parents": ["fdf034fe49297553fcf701e0b72f166c749c9fd0"], "node": "59d4745e95ced7d43e06c7bf45233e7de7676cc2", "parents": ["fcc16157d6baf838350eb2d8c977859f3fa417cd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077003 [wpt PR 63136] - Update wpt metadata, a=testonly\n\nwpt-pr: 63136\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/layout-algorithm/automatic-minimum-size-clamped-to-fixed-max-track-sizing-function.html.ini"], "git_node": "aa4d6d95b709d38052c6ea02d8ce02cb4355a829", "git_parents": ["ca61138f7f00fc4dba20250cf75772a5ba85ad5a"], "node": "3774cecefb3c288e315c16107ba580873acafe22", "parents": ["59d4745e95ced7d43e06c7bf45233e7de7676cc2"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077004 [wpt PR 63137] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324592, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC][Integration] Allow negative line-number grid item placement. (#63137)\n\nGFC has the code implemented to support grid items with negative line\nnumbers. We can resolve the negative line number to the \"logical,\" line\nnumber on the grid. Remove the restrictions from the integration code\nrelated to this.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324592\nWebKit-Canonical-Link: https://commits.webkit.org/321429@main\n--\n\nwpt-commits: 9cd331648cbc747ff1a01443025c4a8dba023bc3\nwpt-pr: 63137\n", "files": ["testing/web-platform/tests/css/css-grid/placement/grid-negative-line-placement-001.html"], "git_node": "2131e706cb7a1e9f045a24f250eb8a7f0568e107", "git_parents": ["aa4d6d95b709d38052c6ea02d8ce02cb4355a829"], "node": "1fbf5554a9f2ce63abbe02486f189e133130b70d", "parents": ["3774cecefb3c288e315c16107ba580873acafe22"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077006 [wpt PR 63138] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323704, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] fit-content() tracks should not be stretched and should cap the growth limit (#63138)\n\nSetting fit-content() for a track size has a couple of different\nimplications during track sizing. For the most part this is supposed to\nhave the same behavior as \"auto,\" for the max track sizing function\n(getting treated as max-content). There are some nuances that need to be\ntaken into consideration during track sizing though since that argument\nto fit-content can act as a limit during track sizing.\n\nWe currently lose this information and cannot do anything with it since\nthe max track sizing function is a Style::GridTrackBreadth. Instead, we\nneed to change the max track sizing function so that is can hold either\na Style::GridTrackBreadth or Style::GridTrackSize::FitContent. We do\nthis by having MaxTrackSizingFunction just be a variant over these two.\n\nStyle::GridTrackSize represents a fit-content() track by leaving both of its breadths at their\ndefault value of auto and storing the argument in a separate member, so\nGridLayout::convertGridTrackSizeToTrackSizingFunctions() reported such a track's max track sizing\nfunction as auto and dropped the argument entirely.\n\nTwo things followed from that:\n\n1.) https://drafts.csswg.org/css-grid-1/#algo-stretch only expands\ntracks whose max track sizing function is auto. In this case we were\nsetting the max track sizing function to gridTrackSize.maxTrackBreadth()\nwhich was returning auto in the fit-content case. By now setting\nfit-content directly we avoid this.\n\n2.) https://drafts.csswg.org/css-grid-2/#algo-single-span-items says that for fit-content() maximums\nthe growth limit is furthermore clamped by the fit-content() argument, which was not reachable at\nall once the argument had been dropped.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323704\nWebKit-Canonical-Link: https://commits.webkit.org/320780@main\n--\n\nwpt-commits: b3dd28297a23688e9ed2180fa9bb30fc9d9f7ab4\nwpt-pr: 63138\n", "files": ["testing/web-platform/tests/css/css-grid/grid-definition/fit-content-track-sizing.html"], "git_node": "cdf779b2a7077df09a028aeae725ce6c80c4ae18", "git_parents": ["2131e706cb7a1e9f045a24f250eb8a7f0568e107"], "node": "07a4797e7c49aa995dad1810e926d4b2fbf74d07", "parents": ["1fbf5554a9f2ce63abbe02486f189e133130b70d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077006 [wpt PR 63138] - Update wpt metadata, a=testonly\n\nwpt-pr: 63138\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-definition/fit-content-track-sizing.html.ini"], "git_node": "489c96538bb7b86e108dd14621acfac9d3c9ddd7", "git_parents": ["cdf779b2a7077df09a028aeae725ce6c80c4ae18"], "node": "8618f66797d20a1561ffe3ae3865326c993b4466", "parents": ["07a4797e7c49aa995dad1810e926d4b2fbf74d07"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077010 [wpt PR 63139] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322875, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(316706@main) tess.oconnor.cx: lots of spacing between image and content towards bottom of page (#63139)\n\n316706@main dropped the BaselineGroup::computeSize() \u003e 1 guard from baselineOffsetForGridItem() on the assumption\nthat a single participant's max ascent is its own ascent, so that the offset is already zero.\nThat only holds while the ascent is stable: it is collected in computeBaselineAlignmentContext()\nand computed again when the offset is queried. An item whose used size is only resolved after track sizing\n(e.g. a replaced item with a percentage max-width) reports a smaller ascent by then, and the stale, larger max ascent turns into\na baseline offset that pushes the single item away from the start of its grid area.\n\nTrack the number of alignment subjects next to the max ascent in GridBaselineAlignment's per-context state and restore the guard (similar to what we had before 316706@main).\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322875\nWebKit-Canonical-Link: https://commits.webkit.org/320115@main\n\nCo-authored-by: Alan Baradlay \u003czalan@apple.com\u003e\n--\n\nwpt-commits: f75780f1886c1efe2c0efa045ce1312a9355865c\nwpt-pr: 63139\n", "files": ["testing/web-platform/tests/css/css-grid/alignment/grid-align-baseline-single-item-001.html"], "git_node": "55c5ba7d3ef8de3d01fe7a04f91d7efec652076b", "git_parents": ["489c96538bb7b86e108dd14621acfac9d3c9ddd7"], "node": "c28ce4bbd6893a7cb5cdc40ef23281796b46f87a", "parents": ["8618f66797d20a1561ffe3ae3865326c993b4466"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2076272 [wpt PR 63021] - Rename position-visibility:anchors-visible to anchor-visible, a=testonly\n\nAutomatic update from web-platform-tests\nRename position-visibility:anchors-visible to anchor-visible\n\nThe CSSWG renamed the `position-visibility` property values\n`anchors-visible` and `anchors-valid` to the singular `anchor-visible`\nand `anchor-valid`, keeping the plural keywords as legacy value\naliases. This CL renames the pre-existing `anchors-visible` value\nto `anchor-visible`, and also sets the stage for a later CL that\nimplements the behavior for `anchor-valid`.\n\nThis CL gates the new singular keywords and legacy value aliasing\nbehind the `PositionVisibilitySingularValues` runtime-enabled feature\n(status: experimental), and adds UseCounters for the three variants\n(`anchor-visible`, `anchors-visible`, and `anchor-valid`).\n\nBug: 526682332, 333421963\nChange-Id: I8490608c7598fc367b37d34251dadf2f11dd1936\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8449214\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1706340}\n\n--\n\nwpt-commits: cf01e8777cd43ece510b4cc949bd93da61a2c343\nwpt-pr: 63021\n", "files": ["testing/web-platform/tests/css/css-anchor-position/chrome-445458885-crash.html", "testing/web-platform/tests/css/css-anchor-position/parsing/position-visibility-computed.html", "testing/web-platform/tests/css/css-anchor-position/parsing/position-visibility-parsing.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-valid-ref.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-valid.tentative.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-after-scroll-in-document.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-after-scroll-in.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-after-scroll-out.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-both-position-fixed.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-chained-001.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-chained-002.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-chained-003.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-chained-004.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-change-anchor.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-change-css-visibility.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-css-visibility.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-in-overflow-ref.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-in-overflow.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-non-intervening-container.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-position-fixed.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-stacked-child.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-stacked-child.tentative.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-with-position.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible.html", "testing/web-platform/tests/css/css-anchor-position/position-visibility-remove-anchors-visible.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/properties/position-visibility.html", "testing/web-platform/tests/web-animations/animation-model/animation-types/property-list.js"], "git_node": "a26dc5000888375b520c04a7b5bbc81683fc896f", "git_parents": ["55c5ba7d3ef8de3d01fe7a04f91d7efec652076b"], "node": "7ff5b426e226844f55f1ec04c7eec4086daab9b0", "parents": ["c28ce4bbd6893a7cb5cdc40ef23281796b46f87a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076272 [wpt PR 63021] - Update wpt metadata, a=testonly\n\nwpt-pr: 63021\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-anchor-position/parsing/position-visibility-computed.html.ini", "testing/web-platform/meta/css/css-anchor-position/parsing/position-visibility-parsing.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/properties/position-visibility.html.ini", "testing/web-platform/meta/web-animations/animation-model/animation-types/accumulation-per-property-002.html.ini", "testing/web-platform/meta/web-animations/animation-model/animation-types/addition-per-property-002.html.ini", "testing/web-platform/meta/web-animations/animation-model/animation-types/interpolation-per-property-002.html.ini"], "git_node": "9c7ca2a9c28b2493d26bbfaa87a80157052d42d3", "git_parents": ["a26dc5000888375b520c04a7b5bbc81683fc896f"], "node": "764da77c1ce35c8b9a1ab0f845cf1983d6d64032", "parents": ["7ff5b426e226844f55f1ec04c7eec4086daab9b0"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2076811 [wpt PR 63110] - HTML: fix event handlers and no browsing context, a=testonly\n\nAutomatic update from web-platform-tests\nHTML: fix event handlers and no browsing context\n\nThe event handler IDL attribute setter is not affected by the lack of a\nbrowsing context. Determining the target of an event handler returns the event\ntarget itself unless it is a body or frameset element whose name is a\nWindowEventHandlers member or in the Window-reflecting body element event\nhandler set, so for a div it never returns null. That is what implementations\ndo, and event-handler-attributes-windowless-body.html already asserts as much\nfor handlers that are not shadowed, on a windowless body element in a DOMParser\ndocument.\n\nAlso:\n\n* The content attribute body assigned to a local variable of run_checks that it\n  cannot see, so the handler running would have gone unnoticed.\n* new Document() is an XML document, so innerHTML used the XML fragment parsing\n  algorithm and left the div in no namespace, where it has no onclick IDL\n  attribute at all.\n\nSee https://github.com/whatwg/html/issues/12014.\n\n--\n\nwpt-commits: 7d9d48db9a064794b87c2c90d7fa13262ac71c50\nwpt-pr: 63110\n", "files": ["testing/web-platform/tests/html/webappapis/scripting/events/event-handler-attributes-no-bc.html"], "git_node": "5dd5d59730d0a70b5a5be961543fd79032389829", "git_parents": ["9c7ca2a9c28b2493d26bbfaa87a80157052d42d3"], "node": "87ff1bdb8bfc5e9ae3813e354698b2f8fce16a17", "parents": ["764da77c1ce35c8b9a1ab0f845cf1983d6d64032"], "tags": []}, {"author": "Leo Watts \u003cleowatts34@gmail.com\u003e", "branch": "default", "desc": "Bug 2077112 [wpt PR 63163] - layout: Alter ratio_from_view_box to allow fractional values, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test\n\nSigned-off-by: Leo Watts \u003cleowatts34@gmail.com\u003e\n\n--\n\nwpt-commits: 003c5dd7428469630382c405b45e706761e4e4f6\nwpt-pr: 63163\n", "files": ["testing/web-platform/tests/svg/coordinate-systems/viewBox-fractional-valid-ref.html", "testing/web-platform/tests/svg/coordinate-systems/viewBox-fractional-valid.html"], "git_node": "cb9281cf13554023664a42c14d7266bfaeba89b0", "git_parents": ["5dd5d59730d0a70b5a5be961543fd79032389829"], "node": "7e274a513136493a1fbd8795d6e3f1778c6da6e1", "parents": ["87ff1bdb8bfc5e9ae3813e354698b2f8fce16a17"], "tags": []}, {"author": "Stalgia Grigg \u003cstalgiag@igalia.com\u003e", "branch": "default", "desc": "Bug 2076499 [wpt PR 63055] - Test that windows created by WebDriver are not script-closable, a=testonly\n\nAutomatic update from web-platform-tests\nTest that windows created by WebDriver are not script-closable (#63055)\n\nThis uses test_driver.create_window() (#62103) and test_driver.navigate()\n(#62198) to test the session history branch of script-closable. A window\ncreated by WebDriver whose session history has more than one entry should\nnot be closable by script. A window.open() popup with the same history is\nthe control.\n\nIt also adds wdspec tests that the first navigation after New Window\n(classic) and browsingContext.create (BiDi) replaces the new window's\ninitial about:blank entry, so history.length is 1. Chrome currently\nappends an entry instead (https://crbug.com/552741963).\n\nFixes #51933.\n--\n\nwpt-commits: c5e80ef1dca982bfab50c54277fdf99bfb8c9a62\nwpt-pr: 63055\n", "files": ["testing/web-platform/tests/html/browsers/the-window-object/open-close/script-closable-webdriver.html", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/create/type.py", "testing/web-platform/tests/webdriver/tests/classic/new_window/new_tab.py", "testing/web-platform/tests/webdriver/tests/classic/new_window/new_window.py"], "git_node": "80f1b8744c778b2a9ae5464346aa39191fda6d17", "git_parents": ["cb9281cf13554023664a42c14d7266bfaeba89b0"], "node": "1c9ab73e429ce25dada9867f54390a80cdc206ad", "parents": ["7e274a513136493a1fbd8795d6e3f1778c6da6e1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076499 [wpt PR 63055] - Update wpt metadata, a=testonly\n\nwpt-pr: 63055\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/browsers/the-window-object/open-close/script-closable-webdriver.html.ini"], "git_node": "cacc0f1a7608ba10969d1ac4c455be0986248564", "git_parents": ["80f1b8744c778b2a9ae5464346aa39191fda6d17"], "node": "872819984b5bd7148e077ed55d1ab88fb1c0ffee", "parents": ["1c9ab73e429ce25dada9867f54390a80cdc206ad"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2077269 [wpt PR 63169] - [chromium-bidi] Fix touch altitudeAngle and azimuthAngle precision, a=testonly\n\nAutomatic update from web-platform-tests\n[chromium-bidi] Fix touch altitudeAngle and azimuthAngle precision\n\n- Preserve floating-point precision when converting pointer\n  `altitudeAngle` and `azimuthAngle` to CDP `tiltX` and `tiltY`, and\n  update WPT `pointer_touch.py` expectations.\n- Previously, `getTilt()` rounded `tiltX` and `tiltY` degrees to\n  integers before dispatching to CDP, causing Blink's reverse\n  trigonometric conversion to produce inaccurate `altitudeAngle` and\n  `azimuthAngle` values on `PointerEvent`.\n- Pass unrounded floating-point `tiltX` and `tiltY` degrees to CDP and\n  use `pytest.approx` for floating-point angle assertions in WPT.\n\nBug: 411434110\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: Ic37c44054c48ba26ae246c879b395fdc6bc54842\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8500576\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCommit-Queue: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1708992}\n\n--\n\nwpt-commits: be06f5d84ee0d681b5ef78b02d94b61fc747c5f7\nwpt-pr: 63169\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_touch.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_touch.py"], "git_node": "9d4820b82dd9477166608dd2e955a8c4b8e55ef1", "git_parents": ["cacc0f1a7608ba10969d1ac4c455be0986248564"], "node": "24606b2eb46435b229d9319392f5258b56e6ed17", "parents": ["872819984b5bd7148e077ed55d1ab88fb1c0ffee"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077269 [wpt PR 63169] - Update wpt metadata, a=testonly\n\nwpt-pr: 63169\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/duration.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_modifiers.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_shortcuts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_special_keys.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/navigation.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/none.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/perform.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_contextmenu.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_dblclick.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_modifier_click.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse_drag.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_origin.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_pause_dblclick.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_pen.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_touch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_touch_simultaneous.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_tripleclick.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/sequence.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_events.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_frame.py.ini"], "git_node": "17a3c0f504d2c8e8130150e5f04e5ca081c6f7bc", "git_parents": ["9d4820b82dd9477166608dd2e955a8c4b8e55ef1"], "node": "8c4461378a2c874970bec0bc6a779d025940e0e1", "parents": ["24606b2eb46435b229d9319392f5258b56e6ed17"], "tags": []}, {"author": "Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e", "branch": "default", "desc": "Bug 2077113 [wpt PR 63164] - wpt: Enable web animations for `touch-events`, a=testonly\n\nAutomatic update from web-platform-tests\nshould have two touchmove events\n\nSigned-off-by: Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e\n\n--\n\nwpt-commits: 89c9ebab4fef9e79de92421dd637f00fa4922359\nwpt-pr: 63164\n", "files": ["testing/web-platform/tests/touch-events/single-touch.html"], "git_node": "a5c15b31cd5dd8d4d408537221fdfb479ed23975", "git_parents": ["17a3c0f504d2c8e8130150e5f04e5ca081c6f7bc"], "node": "906b75acb9e02fdb046c9db81562658974aca36f", "parents": ["8c4461378a2c874970bec0bc6a779d025940e0e1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077113 [wpt PR 63164] - Update wpt metadata, a=testonly\n\nwpt-pr: 63164\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/touch-events/single-touch.html.ini"], "git_node": "0d6a5ff16f7764a3a81af8096c19428e76baa890", "git_parents": ["a5c15b31cd5dd8d4d408537221fdfb479ed23975"], "node": "b6d887541cca37e7f50e856ad2f00cdf35b49136", "parents": ["906b75acb9e02fdb046c9db81562658974aca36f"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2077372 [wpt PR 63172] - focus: Implement nextFocusable and previousFocusable., a=testonly\n\nAutomatic update from web-platform-tests\nfocus: Implement nextFocusable and previousFocusable.\n\nThis adds nextFocusable and previousFocusable which relies on focus\ncontroller.\n\nR=masonf@chromium.org\n\nBug: 565786176\nChange-Id: I4a82b35974e7eb37b217eee955508d07543fdb93\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8465265\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709055}\n\n--\n\nwpt-commits: 0162a6409522ec70d34f75a4ca5e2fe2da62300a\nwpt-pr: 63172\n", "files": ["testing/web-platform/tests/shadow-dom/focus-navigation/focus-negative-tabindex-at-end-of-shadow-tree.html"], "git_node": "62e6cc163c649fd880d50dde30b4e7a6de2ed998", "git_parents": ["0d6a5ff16f7764a3a81af8096c19428e76baa890"], "node": "586fcc65ec485be699141e2c37e005a0c72d8c31", "parents": ["b6d887541cca37e7f50e856ad2f00cdf35b49136"], "tags": []}, {"author": "Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2077396 [wpt PR 63177] - [css-mixins] Test that @mixin is valid wherever @keyframes is valid, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Test that @mixin is valid wherever @keyframes is valid\n\nAdd test cases verifying that @mixin is valid wherever @keyframes is\nvalid, including conditional group rules and @layer.\n\nhttps://github.com/w3c/csswg-drafts/issues/12417\n\nChange-Id: I2e2a619db118ff2a6e33a616719a7afb6f0baffc\nFixed: 440050694\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8487194\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nAuto-Submit: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709091}\n\n--\n\nwpt-commits: 6a1e019de7c5e3ef2e78b9dc91b594da35f8a51f\nwpt-pr: 63177\n", "files": ["testing/web-platform/tests/css/css-mixins/mixins/mixin-parsing.html"], "git_node": "e96d04c08ce350d32a4c49c7ff236a3139a593c9", "git_parents": ["62e6cc163c649fd880d50dde30b4e7a6de2ed998"], "node": "c1ef499a7f3045768b02b8961a18bc469df0d292", "parents": ["586fcc65ec485be699141e2c37e005a0c72d8c31"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077396 [wpt PR 63177] - Update wpt metadata, a=testonly\n\nwpt-pr: 63177\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/mixins/mixin-parsing.html.ini"], "git_node": "3512152adcf0560551fa77b3ff4a2dc614fb66c9", "git_parents": ["e96d04c08ce350d32a4c49c7ff236a3139a593c9"], "node": "1bcd2bebe76b511bbf686ee346f9198ee6796506", "parents": ["c1ef499a7f3045768b02b8961a18bc469df0d292"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2077413 [wpt PR 63182] - Anchor popovers to ::interest-button when it triggers interest, a=testonly\n\nAutomatic update from web-platform-tests\nAnchor popovers to ::interest-button when it triggers interest\n\nBefore this CL, when an interest invoker showed a popover, the\npopover's implicit anchor was always the originating element. That was\ntrue even when interest was shown by activating the element's\n`::interest-button` pseudo element.\n\nWith this CL, if the `::interest-button` is activated, and the target\npopover is implicitly anchored to the originating element, the implicit\nanchor becomes the `::interest-button` instead.  This makes sense,\nsince in this case the user has clicked the `::interest-button`, so it\nfeels more natural to have an anchored popover anchor to that button,\nrather than the originating element.\n\nBug: 453705247\nChange-Id: Ie3549a1289650e5f65d80feb0ad2a4eace8d24c1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8496548\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709210}\n\n--\n\nwpt-commits: 2d60becc4044d70e3e17c530cd568f61005445f6\nwpt-pr: 63182\n", "files": ["testing/web-platform/tests/html/semantics/interestfor/interestfor-pseudo-element-popover-anchor-already-open.tentative.html", "testing/web-platform/tests/html/semantics/interestfor/interestfor-pseudo-element-popover-anchor-ref.html", "testing/web-platform/tests/html/semantics/interestfor/interestfor-pseudo-element-popover-anchor.tentative.html"], "git_node": "b7ddd63b6fff4ff7b6ce0d016c345499cf2ac420", "git_parents": ["3512152adcf0560551fa77b3ff4a2dc614fb66c9"], "node": "77028d7ef7f57b649003ca3f43f8620225ac505a", "parents": ["1bcd2bebe76b511bbf686ee346f9198ee6796506"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077413 [wpt PR 63182] - Update wpt metadata, a=testonly\n\nwpt-pr: 63182\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/interestfor/interestfor-pseudo-element-popover-anchor-already-open.tentative.html.ini", "testing/web-platform/meta/html/semantics/interestfor/interestfor-pseudo-element-popover-anchor.tentative.html.ini"], "git_node": "6c7edcddd78cada6c677bc4c5426533aeb399020", "git_parents": ["b7ddd63b6fff4ff7b6ce0d016c345499cf2ac420"], "node": "477a152616148e851770df8ba250f947d20d732f", "parents": ["77028d7ef7f57b649003ca3f43f8620225ac505a"], "tags": []}, {"author": "Peng Zhou \u003cpengzhou@chromium.org\u003e", "branch": "default", "desc": "Bug 2077397 [wpt PR 63178] - [css-pseudo] Don't apply first-line or first-letter to input and textarea, a=testonly\n\nAutomatic update from web-platform-tests\n[css-pseudo] Don't apply first-line or first-letter to input and textarea\n\n\u003cinput\u003e and \u003ctextarea\u003e don't have a first formatted line. Also prevent\nan ancestor's first-letter style from reaching into a block-level input.\n\nSee https://github.com/w3c/csswg-drafts/issues/13926.\n\nBug: 519984271\nChange-Id: I4e4652d5043115e88b029bc4d791f9e7e7c444e7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8476991\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Peng Zhou \u003cpengzhou@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709216}\n\n--\n\nwpt-commits: a907ccbc8b9912769189b4a249b2b8686501eec7\nwpt-pr: 63178\n", "files": ["testing/web-platform/tests/css/css-pseudo/first-letter-input-textarea.tentative.html", "testing/web-platform/tests/css/css-pseudo/first-line-input-textarea.tentative.html", "testing/web-platform/tests/css/css-pseudo/input-textarea-ref.html"], "git_node": "846ad7e97bb1477e7562c6f7a4047af939762c3c", "git_parents": ["6c7edcddd78cada6c677bc4c5426533aeb399020"], "node": "f9ee4bb1c2abdd64d7729edc7fffe88f7514f79f", "parents": ["477a152616148e851770df8ba250f947d20d732f"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2076616 [wpt PR 63081] - Remove void element end tags from css-overflow and css-ruby WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove void element end tags from css-overflow and css-ruby WPTs\n\nimg and br have no end tag. Writing \u003c/img\u003e anyway is a parse error, and\nthe parser drops the tag, so the source suggests a structure the\ndocument never had. \u003c/br\u003e is different: the parser rewrites it into a\n\u003cbr\u003e start tag, so it is spelled \u003cbr\u003e instead of being deleted.\n\nThis CL removes \u003c/img\u003e and rewrites \u003c/br\u003e into \u003cbr\u003e in WPTs in\nthird_party/blink/web_tests/external/wpt/css/css-overflow/ and\nthird_party/blink/web_tests/external/wpt/css/css-ruby/.\n\nBug: 542686202\nChange-Id: I04e2dca0c2066ec6d486f0227346dab1a7f2e63e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8219315\nReviewed-by: Andres Regalado Rosas \u003candresrega@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709146}\n\n--\n\nwpt-commits: 999cd3c89f36bf345ac96fa098f85f0b0f3db178\nwpt-pr: 63081\n", "files": ["testing/web-platform/tests/css/css-overflow/overflow-img-border-radius.html", "testing/web-platform/tests/css/css-overflow/overflow-img-display-table-ref.html", "testing/web-platform/tests/css/css-overflow/overflow-img-display-table.html", "testing/web-platform/tests/css/css-overflow/overflow-img-object-position-ref.html", "testing/web-platform/tests/css/css-overflow/overflow-img-object-position.html", "testing/web-platform/tests/css/css-overflow/overflow-img-ref.html", "testing/web-platform/tests/css/css-overflow/overflow-img-scroll-non-replaced-ref.html", "testing/web-platform/tests/css/css-overflow/overflow-img-scroll-non-replaced.html", "testing/web-platform/tests/css/css-overflow/overflow-img-scroll-replaced-ref.html", "testing/web-platform/tests/css/css-overflow/overflow-img-scroll-replaced.html", "testing/web-platform/tests/css/css-overflow/overflow-img-svg-ref.html", "testing/web-platform/tests/css/css-overflow/overflow-img-svg.html", "testing/web-platform/tests/css/css-overflow/overflow-img.html", "testing/web-platform/tests/css/css-overflow/scrollable-overflow-padding-inline.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-001-ref.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-001.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-002-ref.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-002.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-003-ref.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-003.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-004-ref.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-004.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-005-ref.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-005.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-006-ref.html", "testing/web-platform/tests/css/css-ruby/ruby-overhang-spaces-vertical-006.html"], "git_node": "72ab4ed51b2a23d7cd5e4acd0cd08bf73ab5dad3", "git_parents": ["846ad7e97bb1477e7562c6f7a4047af939762c3c"], "node": "6e1391d09c76708db38b0e576b9e435cd6f0cfd8", "parents": ["f9ee4bb1c2abdd64d7729edc7fffe88f7514f79f"], "tags": []}, {"author": "Jingyun Liu \u003cjingyun@google.com\u003e", "branch": "default", "desc": "Bug 2076949 [wpt PR 63123] - Rename \"callID\" to \"callId\" in Prompt API tool use, a=testonly\n\nAutomatic update from web-platform-tests\nRename \"callID\" to \"callId\" in Prompt API tool use\n\n- goal is to be consistent with everwhere else in spec\n- Spec comment:\nhttps://github.com/webmachinelearning/prompt-api/pull/162/changes#r4138766567\n\nChange-Id: I668e7c90b402d730b50268d63ba7fda51e12d5b9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8490332\nReviewed-by: Elias Klim \u003celklm@chromium.org\u003e\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nReviewed-by: Nasko Oskov \u003cnasko@chromium.org\u003e\nCommit-Queue: Jingyun Liu \u003cjingyun@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709232}\n\n--\n\nwpt-commits: b947eabfc111cedd050e83d7ed65aa92a5fb3099\nwpt-pr: 63123\n", "files": ["testing/web-platform/tests/ai/language-model/language-model-tool-use.tentative.https.window.js"], "git_node": "a8809da15c8aa2cc6274434a7f77266a8100d8ba", "git_parents": ["72ab4ed51b2a23d7cd5e4acd0cd08bf73ab5dad3"], "node": "1e07b2925023899b038869e93a6d72d26010cbf1", "parents": ["6e1391d09c76708db38b0e576b9e435cd6f0cfd8"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2077411 [wpt PR 63181] - Tweak wpt/svg/text/scripted/lengthadjust-char-positions.html, a=testonly\n\nAutomatic update from web-platform-tests\nTweak wpt/svg/text/scripted/lengthadjust-char-positions.html\n\nConvert sync test()s to promise_test()s so that promise_setup() can be\nused to wait for fonts to be ready.\n\nTweak the epsilon from 0.01 to 0.015625 (1/64, LayoutUnit precision).\n\nBug: 567285529\nChange-Id: I5a02c8d83dd67516d77f7ddfba580e4b18a2310d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8496671\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nAuto-Submit: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709253}\n\n--\n\nwpt-commits: a8bbdfd97725ce013cd1462ccc254650a77edff0\nwpt-pr: 63181\n", "files": ["testing/web-platform/tests/svg/text/scripted/lengthadjust-char-positions.html"], "git_node": "bfcd8a76f0548e0b948a3da04db2702b68238257", "git_parents": ["a8809da15c8aa2cc6274434a7f77266a8100d8ba"], "node": "d76e63b413d3f587ef7d1d90791665ccbee65f8d", "parents": ["1e07b2925023899b038869e93a6d72d26010cbf1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077411 [wpt PR 63181] - Update wpt metadata, a=testonly\n\nwpt-pr: 63181\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/text/scripted/lengthadjust-char-positions.html.ini"], "git_node": "70055ac4dd0cee6fcee7374a36b0cdf147cc2bc6", "git_parents": ["bfcd8a76f0548e0b948a3da04db2702b68238257"], "node": "bb73a11cd8a4d4aa57ca2088c0d348eebfca1365", "parents": ["d76e63b413d3f587ef7d1d90791665ccbee65f8d"], "tags": []}, {"author": "Mustaq Ahmed \u003cmustaq@google.com\u003e", "branch": "default", "desc": "Bug 2077422 [wpt PR 63186] - Include all non-throttled controllers in active_controllers, a=testonly\n\nAutomatic update from web-platform-tests\nInclude all non-throttled controllers in active_controllers\n\nWith EventTimingMatchingHTML disabled, UpdateAnimationsForDocument runs\nbefore active_controllers is filtered by HasScheduledFrameTasks(), so\ncontrollers with finishing animations are added to active_controllers\nand any rAF callbacks scheduled in their animation event handlers\nexecute in Step 14 of the same frame.\n\nWhen EventTimingMatchingHTML moved UpdateAnimationsForDocument into Step\n11, controllers with only active animations had HasScheduledFrameTasks()\n== false before Step 6 and were excluded from active_controllers. Step\n11 worked around this by using run_for_all_controllers_with_timing, but\nStep 14 still used run_for_all_active_controllers_with_timing, deferring\nrAF callbacks scheduled during Step 11 to the next frame.\n\nThis CL fixes the deferred callback problem when EventTimingMatchingHTML\nis enabled, aligning the new behavior with the disabled case and also\nwith the HTML spec's single docs list across Steps 6-14.\n\nFixed: 563399635\nChange-Id: If402c8aabf024c093eeb6c5bddd100420841aec8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8484104\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCommit-Queue: Mustaq Ahmed \u003cmustaq@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709281}\n\n--\n\nwpt-commits: c21fcc8925d19647649b573915a56fa620342ece\nwpt-pr: 63186\n", "files": ["testing/web-platform/tests/html/webappapis/scripting/event-loops/raf-from-animation-event-serviced-in-same-rendering-update.html"], "git_node": "9557a4a3fae50eff611da855fdeccdcc097d6cca", "git_parents": ["70055ac4dd0cee6fcee7374a36b0cdf147cc2bc6"], "node": "a6a52e510d3de9a544012ca74d311fb0e6ad6a4d", "parents": ["bb73a11cd8a4d4aa57ca2088c0d348eebfca1365"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2077087 [wpt PR 63158] - CSSPseudoElement: Implement selectorText, a=testonly\n\nAutomatic update from web-platform-tests\nCSSPseudoElement: Implement selectorText\n\nThis patch implements CSSPseudoElement.selectorText\n\nR=flackr@chromium.org\nBug: 567978984\n\nChange-Id: I15505ec7b6562bed70440a4cad18161113ec1ea8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8493252\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709300}\n\n--\n\nwpt-commits: e5ccbb56407ec3ce1c93871c63351e0f231356ab\nwpt-pr: 63158\n", "files": ["testing/web-platform/tests/css/css-pseudo/CSSPseudoElement-scroll-button.html", "testing/web-platform/tests/css/css-pseudo/CSSPseudoElement-selectorText.html", "testing/web-platform/tests/css/css-pseudo/CSSPseudoElement-view-transitions-scoped.tentative.html", "testing/web-platform/tests/css/css-pseudo/CSSPseudoElement-view-transitions.tentative.html", "testing/web-platform/tests/css/css-pseudo/scroll-button-pseudo-element-click.html"], "git_node": "203c88f28ce14a29e5e32a9904d5086b322a170a", "git_parents": ["9557a4a3fae50eff611da855fdeccdcc097d6cca"], "node": "93b4424a1c9e4d3783ddcc33dc59cb9f14a90b98", "parents": ["a6a52e510d3de9a544012ca74d311fb0e6ad6a4d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077087 [wpt PR 63158] - Update wpt metadata, a=testonly\n\nwpt-pr: 63158\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-pseudo/CSSPseudoElement-scroll-button.html.ini", "testing/web-platform/meta/css/css-pseudo/CSSPseudoElement-selectorText.html.ini", "testing/web-platform/meta/css/css-pseudo/CSSPseudoElement-view-transitions.tentative.html.ini"], "git_node": "2099518e673539f7df9f059bb680e8d736fd1657", "git_parents": ["203c88f28ce14a29e5e32a9904d5086b322a170a"], "node": "e3b2314681baac29a10d9780eb5c2dc6cb2e3c0c", "parents": ["93b4424a1c9e4d3783ddcc33dc59cb9f14a90b98"], "tags": []}, {"author": "Jeff Weiner \u003cJeff.Weiner@microsoft.com\u003e", "branch": "default", "desc": "Bug 2077426 [wpt PR 63188] - [focusgroupV2] Migrate grid grammar to V2, a=testonly\n\nAutomatic update from web-platform-tests\n[focusgroupV2] Migrate grid grammar to V2\n\nRecognize manual and the V2 per-axis grid edge tokens, make grid default\nto itemcontrols, and resolve wrap and flow conflicts to hard edges (hard\nedges) independently per axis. Treat the obsolete hyphenated spellings\nas unknown tokens. Leave grid itemcontrols traversal disabled for a\nseparate integration CL.\n\nExplainer: https://open-ui.org/components/focusgroup-v2.explainer/#grid-wrapping-and-flow\nBug: 40074157\nAX-Relnotes: Focusgroup V2 grids support manual topology and per-axis wrap and flow behavior.\nChange-Id: Ica2b5f46578082992c1450957e136d3890feb077\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8245029\nCommit-Queue: Jeff Weiner \u003cJeff.Weiner@microsoft.com\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Jeff Weiner \u003cJeff.Weiner@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709312}\n\n--\n\nwpt-commits: 8442db7e8924cfdf85fc2722362f582ede980496\nwpt-pr: 63188\n", "files": ["testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/grid-navigation/col-flow-only.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/grid-navigation/col-wrap-and-row-flow.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/grid-navigation/col-wrap-only.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/grid-navigation/grid-grammar-conflicts.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/grid-navigation/row-flow-only.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/grid-navigation/row-wrap-and-col-flow.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/grid-navigation/row-wrap-only.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/idl-reflection.html"], "git_node": "0cf4dc36d76c7802d7e149d1269c07924903a11a", "git_parents": ["2099518e673539f7df9f059bb680e8d736fd1657"], "node": "7cbd5145ce99301c92b8dac349b378addbef9374", "parents": ["e3b2314681baac29a10d9780eb5c2dc6cb2e3c0c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077426 [wpt PR 63188] - Update wpt metadata, a=testonly\n\nwpt-pr: 63188\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/interaction/focus/focusgroup/tentative/grid-navigation/grid-grammar-conflicts.html.ini"], "git_node": "41afa123c8210ac56f9b9a4680a12e001258886b", "git_parents": ["0cf4dc36d76c7802d7e149d1269c07924903a11a"], "node": "2f2921e15d6d95acae18d51e4b8c6cf641b8b88a", "parents": ["7cbd5145ce99301c92b8dac349b378addbef9374"], "tags": []}, {"author": "Gaston Rodriguez \u003cgastonr@microsoft.com\u003e", "branch": "default", "desc": "Bug 2076942 [wpt PR 63121] - Reland \"Add focus requirement to insert content into clipboard\", a=testonly\n\nAutomatic update from web-platform-tests\nReland \"Add focus requirement to insert content into clipboard\"\n\nThis is a reland of commit c50edc4214d81e4f944c3415d55104a49e46d214\n\nThe original CL was reverted due to tests that failed with the new focus\nrequirement which did not run on my CQ Dry Run. I made the tests require\nfocus now, and they pass. Added (win/linux/mac)-webdriver-bidi-rel bot\nruns to CQ to ensure there are no other missing tests that would fail\nwith these changes.\n\nOriginal change's description:\n\u003e Add focus requirement to insert content into clipboard\n\u003e\n\u003e Currently, focus is not required to insert content into the clipboard\n\u003e under certain circumstances (running on x11). The new async clipboard\n\u003e API requires focus for a script to inject content into the clipboard.\n\u003e\n\u003e This seems reasonable since a webpage may require you to open a second\n\u003e window to process additional input (like a SSO page), and injecting\n\u003e content from an unfocused page could be a vector of attack to an\n\u003e unassuming user.\n\u003e\n\u003e This CL adds the requirement for focus on the non-async path and a unit\n\u003e test that verifies that this is enforced.\n\u003e\n\u003e Additionally, I was able to repro the issue on the provided html in the\n\u003e linked bug and verified that this CL patches the repro.\n\u003e\n\u003e Bug: 563021080\n\u003e Change-Id: I928f5769e75f4c3d1c4ba9e69976f14dd85c50e6\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8422732\n\u003e Reviewed-by: Dan Clark \u003cdaniec@microsoft.com\u003e\n\u003e Reviewed-by: James Cook \u003cjamescook@chromium.org\u003e\n\u003e Commit-Queue: Gaston Rodriguez \u003cgastonr@microsoft.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1706539}\n\nBug: 563021080\nChange-Id: I6314dcff954ec3a8a004742d5873d346f39ee253\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8488666\nCommit-Queue: Gaston Rodriguez \u003cgastonr@microsoft.com\u003e\nReviewed-by: James Cook \u003cjamescook@chromium.org\u003e\nReviewed-by: Dan Clark \u003cdaniec@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709342}\n\n--\n\nwpt-commits: a2783a95f0aeb2f0066ed439ec7d166f06cd2136\nwpt-pr: 63121\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/script/call_function/user_activation.py", "testing/web-platform/tests/webdriver/tests/bidi/script/evaluate/user_activation.py"], "git_node": "282a4a9829187ede308241bb6322a060422164dc", "git_parents": ["41afa123c8210ac56f9b9a4680a12e001258886b"], "node": "e387edfa478c59a5cfc47d862798a2b2c2a2fceb", "parents": ["2f2921e15d6d95acae18d51e4b8c6cf641b8b88a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076942 [wpt PR 63121] - Update wpt metadata, a=testonly\n\nwpt-pr: 63121\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/script/call_function/arguments.py.ini"], "git_node": "299fe17d6a0f362a6cf88e34ebc8e87e86fb4d33", "git_parents": ["282a4a9829187ede308241bb6322a060422164dc"], "node": "27c917a47a36ab76712f72d5bea6f382968c73b2", "parents": ["e387edfa478c59a5cfc47d862798a2b2c2a2fceb"], "tags": []}, {"author": "fantasai \u003cfantasai.bugs@inkedblade.net\u003e", "branch": "default", "desc": "Bug 2077539 [wpt PR 63199] - [css-grid] Import lost grid overflow test from WebKit repo, a=testonly\n\nAutomatic update from web-platform-tests\n[css-grid] Import lost grid overflow test from WebKit repo\n\n--\n\nwpt-commits: 9ce09cc90f39fc8040c9c81977e31a2fcfe26562\nwpt-pr: 63199\n", "files": ["testing/web-platform/tests/css/css-grid/grid-overflow-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-overflow-001.html"], "git_node": "96471489650786f4429cf9ae2cb07d49dd32bde3", "git_parents": ["299fe17d6a0f362a6cf88e34ebc8e87e86fb4d33"], "node": "99bd2b2093e92945b51777f112ea56aa78404762", "parents": ["27c917a47a36ab76712f72d5bea6f382968c73b2"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2077410 [wpt PR 63180] - Support CSS 3D transforms on SVG children behind a flag, a=testonly\n\nAutomatic update from web-platform-tests\nSupport CSS 3D transforms on SVG children behind a flag\n\nStop flattening SVG child transforms to 2D affine: feed the full 3D\nmatrix (including perspective()) into the transform paint node, keep the\nsvg root's perspective node unflattened for its content, and hit test\nthrough the same GeometryMapper projection that rendering uses, all\ngated on the experimental SvgCss3dTransforms runtime flag.\n\nBug: 41310059\nChange-Id: Ie8f2052df0ef2955d25524bdfbf2108b5f8f16a3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8462268\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1709384}\n\n--\n\nwpt-commits: 330565cf9542c954c058a6f8ac4424b2b3214d36\nwpt-pr: 63180\n", "files": ["testing/web-platform/tests/css/css-transforms/perspective-svg-child-001.html", "testing/web-platform/tests/css/css-transforms/perspective-svg-child-002.html", "testing/web-platform/tests/css/css-transforms/perspective-svg-child-ref.html"], "git_node": "7192beaf77f7347e1dc6f4a727130c21f4477ce2", "git_parents": ["96471489650786f4429cf9ae2cb07d49dd32bde3"], "node": "36f2b1a2a6cf791311749de02ba3e23f59cd3510", "parents": ["99bd2b2093e92945b51777f112ea56aa78404762"], "tags": []}, {"author": "Ari Chivukula \u003carichiv@chromium.org\u003e", "branch": "default", "desc": "Bug 2077477 [wpt PR 63194] - [Clear-Site-Data] Prevent cross-site fetch clearing unpartitioned data, a=testonly\n\nAutomatic update from web-platform-tests\n[Clear-Site-Data] Prevent cross-site fetch clearing unpartitioned data\n\nCurrently, cross-site fetch requests with CSD headers clear\nunpartitioned storage. This is incorrect, as they should only clear the\nrelevant partitioned storage. This CL ensures the StorageKey used for\nCSD logic is set up properly with trusted data from the network service.\n\nFixed: 566660676, 518053309, 550356947\nChange-Id: I4b7e845a92d4ea09ff08da3342c57ec7d50d0f69\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8463605\nReviewed-by: mmenke \u003cmmenke@chromium.org\u003e\nCommit-Queue: Ari Chivukula \u003carichiv@chromium.org\u003e\nReviewed-by: Charlie Reis \u003ccreis@chromium.org\u003e\nAuto-Submit: Ari Chivukula \u003carichiv@chromium.org\u003e\nReviewed-by: Lambros Lambrou \u003clambroslambrou@chromium.org\u003e\nReviewed-by: Erik Chen \u003cerikchen@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709414}\n\n--\n\nwpt-commits: 7e3d3861ef6b57ad50f542deb584f5b394b7adc1\nwpt-pr: 63194\n", "files": ["testing/web-platform/tests/clear-site-data/no-cors-fetch-iframe.https.sub.html", "testing/web-platform/tests/clear-site-data/no-cors-fetch-window.https.sub.html", "testing/web-platform/tests/clear-site-data/support/no-cors-fetch-clear-site-data.html", "testing/web-platform/tests/clear-site-data/support/no-cors-fetch-clear-site-data.html.headers", "testing/web-platform/tests/clear-site-data/support/no-cors-fetch-util.html", "testing/web-platform/tests/lint.ignore"], "git_node": "5b4d6bdad536a23113a9ad07a7629f214aa6d72b", "git_parents": ["7192beaf77f7347e1dc6f4a727130c21f4477ce2"], "node": "da68e40814e11797349aab1aec5de408aef5a2b8", "parents": ["36f2b1a2a6cf791311749de02ba3e23f59cd3510"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077477 [wpt PR 63194] - Update wpt metadata, a=testonly\n\nwpt-pr: 63194\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/clear-site-data/no-cors-fetch-window.https.sub.html.ini"], "git_node": "f57b134c2ae1dcea85d27838699627e05e8f5e65", "git_parents": ["5b4d6bdad536a23113a9ad07a7629f214aa6d72b"], "node": "744b566888aab88fa651b8a33402d6eb36ad84b5", "parents": ["da68e40814e11797349aab1aec5de408aef5a2b8"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2077369 [wpt PR 63171] - c-v: Harden display locking + VT interactions, a=testonly\n\nAutomatic update from web-platform-tests\nc-v: Harden display locking + VT interactions\n\nThis does 4 things:\n\n- This ensures that we don't access and invalidate containers as we\n  iterate them (by making a copy of the collections and iterating\n  that collection)\n- Calls NotifyPriorityScrollAnchorStatusChanged only if we have a layout\n  object, since it would be a no-op otherwise\n- avoid exposing GetTransitioningElements when we finished the\n  transition\n- avoids exposing pseudos to Performance API as nodes.\n\nAll of this ensures that the given test doesn't DCHECK/crash\n\nR=futhark@chromium.org, flackr@chromium.org\n\nBug: 567612004\nChange-Id: I3345ad5c1dc9cfe6ef4b1b5e7bc2a9b54b6d56ad\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8490475\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709446}\n\n--\n\nwpt-commits: e7f5f02d69eb7edb2e3f70b5afe2c3dec17d9d9c\nwpt-pr: 63171\n", "files": ["testing/web-platform/tests/css/css-view-transitions/content-visibility-auto-ancestor-skipped-after-finish.html", "testing/web-platform/tests/css/css-view-transitions/content-visibility-auto-relock-crash.html", "testing/web-platform/tests/layout-instability/sources-pseudo-element.html"], "git_node": "8dc01050d7f641142fb42a9c609e4f383bc6e20e", "git_parents": ["f57b134c2ae1dcea85d27838699627e05e8f5e65"], "node": "5aa456ca79f63e26c6294f21763b60c8b5af760d", "parents": ["744b566888aab88fa651b8a33402d6eb36ad84b5"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2077442 [wpt PR 63192] - Fix filterable select active_option_ crashes, a=testonly\n\nAutomatic update from web-platform-tests\nFix filterable select active_option_ crashes\n\nWhen filtering a \u003cselect\u003e, active_option_ may be null if no options\nsupport :active-option when the input is focused, or if the active\noption is removed. Additionally, active_option_ may still be set when\nStartFiltering() is called if a previously focused input lost its\nassociation with the \u003cselect\u003e before blurring.\n\nFixed: 540266841\nChange-Id: I2ae941cac0cad87c0ac4c8685dda86a009621198\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8490185\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709487}\n\n--\n\nwpt-commits: 44d520e0575f2ed6a3a2cd2127b79d6a2aade9ba\nwpt-pr: 63192\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/filterable-select/filterable-select-keyboard-behavior.tentative.html"], "git_node": "7da7b68d09173585b39c408144b1f5f5041b64de", "git_parents": ["8dc01050d7f641142fb42a9c609e4f383bc6e20e"], "node": "279c5c391d0bda12e317f0afc1ebdab81ac2a7ba", "parents": ["5aa456ca79f63e26c6294f21763b60c8b5af760d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077442 [wpt PR 63192] - Update wpt metadata, a=testonly\n\nwpt-pr: 63192\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/filterable-select/filterable-select-keyboard-behavior.tentative.html.ini"], "git_node": "64638b535ed8a4a491e528dd72d9d91938c9962f", "git_parents": ["7da7b68d09173585b39c408144b1f5f5041b64de"], "node": "d37a23cd32e5aab1ba4ebe4b1c6d66f17fea5337", "parents": ["279c5c391d0bda12e317f0afc1ebdab81ac2a7ba"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2077509 [wpt PR 63197] - Reset interest state when hiding a popover without loseinterest, a=testonly\n\nAutomatic update from web-platform-tests\nReset interest state when hiding a popover without loseinterest\n\nWhen a popover that is the target of an active interest invoker was\nhidden without firing events (e.g. when hidePopover() was re-entered\nfrom a beforetoggle handler), or when the invoker's interestfor\nrelationship no longer resolved (e.g. the invoker button was disabled),\nLoseInterestNow() was skipped. The invoker was left in an interest\nstate, so :interest-source and :interest-target kept matching after the\npopover closed.\n\nHidePopoverInternal() now moves the invoker to the no-interest state,\nwithout firing loseinterest, in either of those cases. This matches the\nspec's fireEvents=false behavior, and mirrors the handling in\nElement::RemovedFrom(). If loseinterest was fired and canceled,\ninterest is maintained.\n\nBug: 326681249\nChange-Id: I437de4fe9f8c9873502535e23defc25ca4e4ead4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8499237\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709488}\n\n--\n\nwpt-commits: fe9e4b77eda4e5ef3246e4485b9055a265068258\nwpt-pr: 63197\n", "files": ["testing/web-platform/tests/html/semantics/interestfor/interestfor-hide-popover-interest-state.tentative.html"], "git_node": "8f5ae6b8752d97e9f2f1d21d6e4dd6a57f36a6bc", "git_parents": ["64638b535ed8a4a491e528dd72d9d91938c9962f"], "node": "41a93166c8e87ff1222a4fceb11f74292659a627", "parents": ["d37a23cd32e5aab1ba4ebe4b1c6d66f17fea5337"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077509 [wpt PR 63197] - Update wpt metadata, a=testonly\n\nwpt-pr: 63197\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/interestfor/interestfor-hide-popover-interest-state.tentative.html.ini", "testing/web-platform/meta/html/semantics/interestfor/interestfor-pseudo-element-crash.html.ini"], "git_node": "6079d5d173b7f85607768695dbb7f5a18d9bf61e", "git_parents": ["8f5ae6b8752d97e9f2f1d21d6e4dd6a57f36a6bc"], "node": "73d86de876ef7f678259508db45ec4b38684bd4d", "parents": ["41a93166c8e87ff1222a4fceb11f74292659a627"], "tags": []}, {"author": "Eugene Zemtsov \u003ceugene@chromium.org\u003e", "branch": "default", "desc": "Bug 2077437 [wpt PR 63191] - webcodecs: Validate constructor arguments before transferring buffers, a=testonly\n\nAutomatic update from web-platform-tests\nwebcodecs: Validate constructor arguments before transferring buffers\n\nEnsure WebCodecs constructors (AudioData, ImageDecoder, VideoFrame,\nEncodedVideoChunk, and EncodedAudioChunk) validate all init parameters\nbefore calling TransferArrayBufferForSpan(), so that throwing\nconstructors do not detach ArrayBuffers in `init.transfer`.\n\nAlso throw TypeError instead of NotSupportedError in AudioData when\n`sampleRate \u003c= 0` per the WebCodecs spec.\n\nBug: 562608155\nChange-Id: Id73764813bc917c617143c41aee3b2ec00ee9f18\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8497290\nReviewed-by: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCommit-Queue: Eugene Zemtsov \u003ceugene@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709500}\n\n--\n\nwpt-commits: 6aeb0f912436c35cc2f08bdcfd5c5db83f544d47\nwpt-pr: 63191\n", "files": ["testing/web-platform/tests/webcodecs/audio-data.any.js", "testing/web-platform/tests/webcodecs/transfering.https.any.js"], "git_node": "e544862d82d72a99ef5825826293567971762875", "git_parents": ["6079d5d173b7f85607768695dbb7f5a18d9bf61e"], "node": "aeae056f24f665507200062633dfeb55d7c0e326", "parents": ["73d86de876ef7f678259508db45ec4b38684bd4d"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2077513 [wpt PR 63198] - Ignore arrow key selection cycling in \u003cselect multiple size=1\u003e picker, a=testonly\n\nAutomatic update from web-platform-tests\nIgnore arrow key selection cycling in \u003cselect multiple size=1\u003e picker\n\nWhen pressing ArrowLeft or ArrowRight on a focused option in a\n\u003cselect multiple size=1\u003e popover picker with appearance:auto,\nHTMLOptionElement::DefaultEventHandlerInternal does not handle the event\nin horizontal writing modes, allowing it to bubble up to\nMenuListSelectType::DefaultEventHandler. Previously,\nMenuListSelectType::DefaultEventHandler only skipped keydown option\ncycling when IsAppearanceBase() was true, causing ArrowLeft and\nArrowRight to cycle the selected option in \u003cselect multiple size=1\u003e.\n\nThis patch also checks PickerIsPopover() before handling keydown arrow\nevents in MenuListSelectType::DefaultEventHandler.\n\nFixed: 565496822\nChange-Id: I89253bddf9b1ff6047ec3d1207e77900b8742e50\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8487592\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1709548}\n\n--\n\nwpt-commits: ddc15938dcb087d58b982ecd234fae02bf90d288\nwpt-pr: 63198\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select-multiple-popup/select-multiple-popup-keyboard-behavior.tentative.html"], "git_node": "3f57519984ca6a65a3e9a80e555bacbf6c341539", "git_parents": ["e544862d82d72a99ef5825826293567971762875"], "node": "4896704b6c0b5fa0097eb26d61c1d25e56cdb946", "parents": ["aeae056f24f665507200062633dfeb55d7c0e326"], "tags": []}, {"author": "Nicol\u00f2 Ribaudo \u003cnribaudo@igalia.com\u003e", "branch": "default", "desc": "Bug 2077378 [wpt PR 63174] - Remove MessagePort close event tests, a=testonly\n\nAutomatic update from web-platform-tests\nRemove MessagePort close event tests\n\nSee https://github.com/whatwg/html/pull/13016\n--\n\nwpt-commits: fc1a6ce4f05cff738ebf43a7b4d57860a197f7c1\nwpt-pr: 63174\n", "files": ["testing/web-platform/tests/html/browsers/browsing-the-web/back-forward-cache/resources/service-worker.js", "testing/web-platform/tests/webmessaging/message-channels/WEB_FEATURES.yml", "testing/web-platform/tests/webmessaging/message-channels/close-event/WEB_FEATURES.yml", "testing/web-platform/tests/webmessaging/message-channels/close-event/document-destroyed.tentative.window.js", "testing/web-platform/tests/webmessaging/message-channels/close-event/entangled-after-back-forward-cache-restore.https.tentative.window.js", "testing/web-platform/tests/webmessaging/message-channels/close-event/explicitly-closed.tentative.window.js", "testing/web-platform/tests/webmessaging/message-channels/close-event/garbage-collected.tentative.any.js", "testing/web-platform/tests/webmessaging/message-channels/close-event/resources/helper.js", "testing/web-platform/tests/webmessaging/message-channels/historical.any.js"], "git_node": "2e1033268f4ad670f871cc3a7b7a851ef1f6b88c", "git_parents": ["3f57519984ca6a65a3e9a80e555bacbf6c341539"], "node": "eafc1ee10e58cbb41ae1ee1efb1f20836beca9fb", "parents": ["4896704b6c0b5fa0097eb26d61c1d25e56cdb946"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077378 [wpt PR 63174] - Update wpt metadata, a=testonly\n\nwpt-pr: 63174\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmessaging/message-channels/close-event/document-destroyed.tentative.window.js.ini", "testing/web-platform/meta/webmessaging/message-channels/close-event/explicitly-closed.tentative.window.js.ini", "testing/web-platform/meta/webmessaging/message-channels/close-event/garbage-collected.tentative.any.js.ini"], "git_node": "ec88d5497b6b1080bf83c4d3ead01d3259a84f98", "git_parents": ["2e1033268f4ad670f871cc3a7b7a851ef1f6b88c"], "node": "3a51a9872b9e0f3606df737f3f36f93efb513070", "parents": ["eafc1ee10e58cbb41ae1ee1efb1f20836beca9fb"], "tags": []}, {"author": "Valerie Young \u003cspectranaut@igalia.com\u003e", "branch": "default", "desc": "Bug 2075465 [wpt PR 62435] - Core-AAM: Add generated attribute tests, a=testonly\n\nAutomatic update from web-platform-tests\nCore-AAM: Add generated attribute tests (#62435)\n\nCo-authored-by: Manuel Rego \u003crego@igalia.com\u003e\n--\n\nwpt-commits: bddd58f2dcb808d67035ca4cb3cb056b281782a2\nwpt-pr: 62435\n", "files": ["testing/web-platform/tests/core-aam/aamtests/attribute/aria_brailleroledescription.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_brailleroledescription_undefined.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_busy_false.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_busy_true.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_checked_false.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_checked_mixed.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_checked_true.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_checked_undefined.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_col_count.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_col_index.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_col_index_text.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_col_span.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_controls.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_current.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_current_unrecognized_value.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_described_by.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_description.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_details.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_disabled_false.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_disabled_true.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_error_message.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_expanded_false.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_expanded_true.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_expanded_undefined.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_flowto.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_grabbed_false.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_grabbed_true.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_grabbed_undefined.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_haspopup_dialog.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_haspopup_grid.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_haspopup_listbox.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_haspopup_menu.py", "testing/web-platform/tests/core-aam/aamtests/attrib