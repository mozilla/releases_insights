illa/fenix/browser/menu/MoveToNormalTabsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/readermode/ReaderViewMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/collections/SaveToCollectionMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/FindInPageMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/accounts/MozillaAccountMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuBuilderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/MenuItemEventsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/downloads/DownloadsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/CustomizeHomepageMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/ShortcutMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/VpnMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/history/HistoryMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/SaveAsPdfMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/print/PrintMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/SettingsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/deletebrowsingdata/QuitMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/shortcut/AddToHomeScreenMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/translations/TranslationsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/ReportBrokenSiteMenuItemProviderTest.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/BrowserMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/CustomTabMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/home/HomeMenu.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/MenuMiddlewareTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/BrowserMenuTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/CustomTabMenuTest.kt"], "git_node": "afd419965c0429ff664da8a2385bbd7b9233515c", "git_parents": ["4b89b64e7729cf9572138533551515a146cbeb1e"], "node": "d15fb645f9d1fb8029f1096e27b44fef325e6377", "parents": ["944e0ff91a7deb7e72dd9c031615ef124db1a501"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081611 - Use a different content description for the menu handle in custom tabs r=android-reviewers,giorga\n\nThis will ensure matching the legacy menu UX.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333522\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt"], "git_node": "f9468116d1e39fcf572e9261118bf3866f19700c", "git_parents": ["afd419965c0429ff664da8a2385bbd7b9233515c"], "node": "06e5ad9bb2149dc6bf29fd4bfa4ef5d9147c328f", "parents": ["d15fb645f9d1fb8029f1096e27b44fef325e6377"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081612 - Use dynamic200 for the inner padding of list menu items r=android-reviewers,giorga\n\nThis will ensure matching the legacy menu UX for the majority of its menu items.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333523\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/ExpandableHeaderItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItem.kt"], "git_node": "93665fd4b3d89161937319483aef517e9eab84a4", "git_parents": ["f9468116d1e39fcf572e9261118bf3866f19700c"], "node": "d203c4886a01a4cd4e43fcc12176eea518792169", "parents": ["06e5ad9bb2149dc6bf29fd4bfa4ef5d9147c328f"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081613 - Restore showing the menu promotional banner image at the bottom r=android-reviewers,giorga\n\nThis was changed when the banner was downstreamed to Android-Components\nand now is reverted to what the legacy menu was showing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333524\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuBanner.kt"], "git_node": "0385e927f0ceacaf97f9da7fb26a2388ed47b03e", "git_parents": ["93665fd4b3d89161937319483aef517e9eab84a4"], "node": "98131be1ded4df60325271f161ec04e27aa99627", "parents": ["d203c4886a01a4cd4e43fcc12176eea518792169"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081320 - [devtools] Remove dead hiddenInOptions filter in toolbox-options.js r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333345\n", "files": ["devtools/client/framework/toolbox-options.js"], "git_node": "1d950654fd54c95755e913fa1d27b814bb454a52", "git_parents": ["0385e927f0ceacaf97f9da7fb26a2388ed47b03e"], "node": "513707cc8a69817526bfbf64c132a6ad1a803131", "parents": ["98131be1ded4df60325271f161ec04e27aa99627"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077681: Fixed crash by changing privacy.trackingprotection.annotate_channels to type RelaxedAtomicBool to allow access off main thread. r=edgar\" for causing wpt failures @ for causing wpt failures @ clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html\n\nThis reverts commit 563853ea8e4beda1e0700a8734874372aac4efcd.\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "8d6ba8193282650f87363e0b1c729e1a86aa0f11", "git_parents": ["1d950654fd54c95755e913fa1d27b814bb454a52"], "node": "dd6977b1c6f01c4c30c9594274f63e1876f2417a", "parents": ["513707cc8a69817526bfbf64c132a6ad1a803131"], "tags": []}, {"author": "Kia Salehzadeh \u003ckiasalehzadeh@gmail.com\u003e", "branch": "default", "desc": "Bug 2077681: Fixed crash by changing privacy.trackingprotection.annotate_channels to type RelaxedAtomicBool to allow access off main thread. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331870\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "1b4558b4c4ed1a89503bd671131a4a00317c79c9", "git_parents": ["8d6ba8193282650f87363e0b1c729e1a86aa0f11"], "node": "7e4e3a27d00edaa50ddca07414c265c8d21da090", "parents": ["dd6977b1c6f01c4c30c9594274f63e1876f2417a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062858: apply code formatting via Lando\" for causing wpt failures @ /navigation-api/*\n\nThis reverts commit f5dc15adc76e1a9a2f7eff078e7cb422537fa6d9.\n\nRevert \"Bug 2062858 - Don't convert link clicks to replace during onload. r=dom-core-reviewers,smaug\"\n\nThis reverts commit a7c82e599806a329ad0bc83f55aafe343e4f24f7.\n\nRevert \"Bug 2062858 - Do fragment navigations from links synchronously. r=farre,webdriver-reviewers,whimboo\"\n\nThis reverts commit 19876c06e3d9a363828a73f54a92c7114888de9c.\n\nRevert \"Bug 2062858 - Refactor: Move principal check into IsSameDocumentNavigation. r=dom-core-reviewers,smaug\"\n\nThis reverts commit d9cc2ecc18d8ec20db36c2c5139c389801764299.\n\nRevert \"Bug 2062858 - Refactor: Inline OnLinkClickWithLoadState. r=ltenenbaum\"\n\nThis reverts commit 88c034e04a9a721550a3207d619ac0fd3c18140e.\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "modules/libpref/init/StaticPrefList.yaml", "remote/marionette/actors/MarionetteReftestChild.sys.mjs", "testing/web-platform/meta/html/browsers/browsing-the-web/overlapping-navigations-and-traversals/anchor-fragment-history-back-on-click.html.ini", "testing/web-platform/meta/html/browsers/browsing-the-web/overlapping-navigations-and-traversals/same-document-traversal-same-document-nav.html.ini", "testing/web-platform/meta/navigation-api/currententrychange-event/anchor-click.html.ini", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/replace-before-load/a-fragment-click-during-load.html", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/replace-before-load/resources/fragment-click-during-load-helper.html", "testing/web-platform/tests/html/browsers/browsing-the-web/overlapping-navigations-and-traversals/anchor-fragment-history-back-on-click.html", "testing/web-platform/tests/html/browsers/browsing-the-web/scroll-to-fragid/scroll-to-fragid-from-link-is-synchronous.html"], "git_node": "3d7a306db34a44d754856527a49fa4b8b8775df7", "git_parents": ["1b4558b4c4ed1a89503bd671131a4a00317c79c9"], "node": "a489551ed82c4ba0959cdf0f40e3c07a15144e5b", "parents": ["7e4e3a27d00edaa50ddca07414c265c8d21da090"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2076710 - Bound the step count in floating point. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330381\n", "files": ["gfx/wr/swgl/src/swgl_ext.h"], "git_node": "8ca0cdd57359df4dcb4a5dd6ee713605e03a2bba", "git_parents": ["3d7a306db34a44d754856527a49fa4b8b8775df7"], "node": "cfa25b36e589e9f5721b8388c3936165c86e8089", "parents": ["a489551ed82c4ba0959cdf0f40e3c07a15144e5b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081216 - Run PSM test servers on a per-test copy of their certificate directory, r=crypto-reviewers,necko-reviewers,keeler,kershaw.\n\nThe TLS test servers and GenerateOCSPResponse open an NSS database in the certificate directory they are given, creating cert9.db, key4.db and pkcs11.txt in the checked-in test directories. In local objdirs the existing database files are symlinks into the source tree, so NSS and certutil (e.g. test_missing_intermediate.js adding a certificate to bad_certs) modified the source tree. Give each test its own copy of the certificate directory in its temp dir, and write the generated OCSP responses there too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333293\n", "files": ["netwerk/test/unit/head_channels.js", "security/manager/ssl/tests/unit/head_psm.js", "security/manager/ssl/tests/unit/test_intermediate_preloads.js", "security/manager/ssl/tests/unit/test_missing_intermediate.js"], "git_node": "12e3560bc767de856fff7f8585f0c6a1a7651306", "git_parents": ["8ca0cdd57359df4dcb4a5dd6ee713605e03a2bba"], "node": "838631f91f151a06c4dcf90867ded04a51664472", "parents": ["cfa25b36e589e9f5721b8388c3936165c86e8089"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081216 - Write devtools transport test files to the temp dir, r=devtools-reviewers,nchevobbe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333299\n", "files": ["devtools/shared/transport/tests/xpcshell/head_dbg.js", "devtools/shared/transport/tests/xpcshell/test_client_server_bulk.js", "devtools/shared/transport/tests/xpcshell/test_queue.js", "devtools/shared/transport/tests/xpcshell/test_transport_bulk.js"], "git_node": "4d0c14bfb92521566ca85c4b4301a097284459fe", "git_parents": ["12e3560bc767de856fff7f8585f0c6a1a7651306"], "node": "0139293a401d3fd58831817dfa023f1a549ea012", "parents": ["838631f91f151a06c4dcf90867ded04a51664472"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2071798 - Use a 256-entry lookup table for Latin1 segmentation. r=TYLin\n\nAccording to performance analyzing, if we extend hard-coded lookup\ntable, we can improve speedmeter benchmark.\n\nWe should use a 256-entry lookup table for Latin1 segmentation.\n\nAlso, AI (Ambiguous) with EAW=N is same as AI by LB1. So we can add AI\nfor this table.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333213\n", "files": ["dom/base/nsLineBreaker.cpp"], "git_node": "54b1489f6abb3c800a7903e3dd055bdaca666460", "git_parents": ["4d0c14bfb92521566ca85c4b4301a097284459fe"], "node": "2968fa08c7038f104a9a6b5bd04d0aca872484a0", "parents": ["0139293a401d3fd58831817dfa023f1a549ea012"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072391 - Keep the user's VPN location when a country list arrives during a selection r=android-reviewers,Roger\n\n`IPProtectionLocationMiddleware` used to run each storage read / write in its own coroutine so a country list could read the stored code before a new selection was written and revert the selection.\n\nStorage operations are now chained so that they run in order. Also a selection made after the new country list arrives takes precedence over the stored country code.\n\n`handleCountryListChanged` compares the selected location at dispatch time with the current one in the state: if it changed while storage was being read, the newer selection is used instead of the stored one, since chaining orders storage operations but not the reducer's state changes.\n\n`LocationReset` now persists the reset selection in order too, so it is written after any pending write from a selection made during the read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329254\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt"], "git_node": "8111f08e81b5d30f86edae868754bbb4747fa527", "git_parents": ["54b1489f6abb3c800a7903e3dd055bdaca666460"], "node": "c95fd03962799706b16e433e3edd5220b042edad", "parents": ["2968fa08c7038f104a9a6b5bd04d0aca872484a0"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068228 - Let the QR pairing scanner be opened from outside Settings r=android-reviewers,twhite\n\n`PairFragment` could only be accessed from `TurnOnSyncFragment` and each of its exits popped back to `turnOnSyncFragment`. If the scanner was opened from another screen, `turnOnSyncFragment` would not be in the back stack so the pop would do nothing.\n\nAdd a global navigation action, `action_global_pairFragment` with `launchSingleTop` so that the scanner can be opened from any destination without being added twice in the back stack. Now, every exit pops `pairFragment` instead of popping back to `turnOnSyncFragment` to return to the previous screen. Opening the screen from settings behaves as before because  `turnOnSyncFragment` is always directly before `pairFragment`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332828\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/PairFragment.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml"], "git_node": "37eb98581e212a75a79adf9c86fd8efe68133e02", "git_parents": ["8111f08e81b5d30f86edae868754bbb4747fa527"], "node": "d04b49235de19ca552044fae795df294327d01a9", "parents": ["c95fd03962799706b16e433e3edd5220b042edad"], "tags": []}, {"author": "Fabio Kaminski \u003cfabiokaminski@gmail.com\u003e", "branch": "default", "desc": "Bug 1841326 Colorspace property added and correctly managed in CanvasRenderingContext2d and ImageData r=gfx-reviewers,webidl,emilio,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332911\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/ImageBitmap.cpp", "dom/canvas/ImageData.cpp", "dom/canvas/ImageData.h", "dom/webidl/CanvasRenderingContext2D.webidl", "dom/webidl/ImageData.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/canvas/element/pixel-manipulation/2d.imageData.createImageBitmap.srgb.rgba.unorm8.html.ini"], "git_node": "c39fb25be0f696efbae911d1f19cceb9e9239622", "git_parents": ["37eb98581e212a75a79adf9c86fd8efe68133e02"], "node": "dfd2308d4afbf3c21669e5ada4e74677000f7905", "parents": ["d04b49235de19ca552044fae795df294327d01a9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080943 - Remove PrintTargetCG. r=mac-reviewers,mstange\n\nSince we enabled SkPdf, this is only used for niche functionality off\nthe native print dialog (PDF processors etc, or no-longer-first-class\nfunctionality like faxes and PostScript export).\n\nAfter bug 2080640, this just becomes unused. Given its niche nature I\nthink we can probably get rid of this and rely on PrintTargetSkPdf\ninstead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333005\n", "files": ["gfx/thebes/PrintTargetCG.h", "gfx/thebes/PrintTargetCG.mm", "gfx/thebes/moz.build", "modules/libpref/init/StaticPrefList.yaml", "widget/cocoa/nsDeviceContextSpecX.mm", "widget/cocoa/nsPrintDialogX.mm", "widget/nsIDeviceContextSpec.cpp", "widget/nsIDeviceContextSpec.h"], "git_node": "8b1d57ff9ad3b6285410c2216ea405d6ed8fea5f", "git_parents": ["c39fb25be0f696efbae911d1f19cceb9e9239622"], "node": "729da8775e59011ccf13fcf0ddacb97989094f34", "parents": ["dfd2308d4afbf3c21669e5ada4e74677000f7905"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080786 - Move the CrashTime annotation handling to the crash helper r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332835\n", "files": ["toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/test/browser/browser_required_annotations.js", "toolkit/crashreporter/test/unit/head_crashreporter.js"], "git_node": "b20866e5a6ba05f87271374b0837be04b4a04c78", "git_parents": ["8b1d57ff9ad3b6285410c2216ea405d6ed8fea5f"], "node": "cb096033f9b6f0f5b57a50e6adea75a13c687324", "parents": ["729da8775e59011ccf13fcf0ddacb97989094f34"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080219 - Check cached grid axis measurement before creating the ReflowInput. r=TYLin\n\nWe need to return the ContentBSize as well, because we no longer set the\nold bsize into the frame via FinishReflowChild. That was rather sketchy\nto begin with (it doesn't change the layout of e.g. the children)...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332438\n", "files": ["layout/generic/nsGridContainerFrame.cpp"], "git_node": "874dac89494ddb82fbb75d073b86e00cc06e0f2d", "git_parents": ["b20866e5a6ba05f87271374b0837be04b4a04c78"], "node": "e46c9358c2a4110e01d9bcaeac532a03e530c5bc", "parents": ["cb096033f9b6f0f5b57a50e6adea75a13c687324"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079046 - Keep the HTTP/2 session alive while adding and cleaning up streams, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333547\n", "files": ["netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/nsHttpConnection.cpp"], "git_node": "48bfc983860d374a828b3bfbb4376593962a7b77", "git_parents": ["874dac89494ddb82fbb75d073b86e00cc06e0f2d"], "node": "ea83ab7accb7453cb14eedfbf5bc2db6ce85968f", "parents": ["e46c9358c2a4110e01d9bcaeac532a03e530c5bc"], "tags": []}, {"author": "neoyarus \u003cneoyarus@gmail.com\u003e", "branch": "default", "desc": "Bug 1813919 - Accept spaces after the authority when classifying HTTP/S URLs. r=android-reviewers,petru\n\nThe address bar needs to recognize addresses such as `https://example.com/a b` as URLs. `isURLLike` accepts spaces in the path, query or fragment of an HTTP/S address, but never in its scheme or authority. Without a scheme, such input is only a URL when it has a port, an IP address as its host, or a `?` or `#` after its first `/`, as in desktop's URIFixup, so `node.js/express tutorial` stays a search. `toNormalizedURL` and `String.toNormalizedUrl` encode these spaces as `%20`. Focus uses the same helpers, so it also loads such input as a URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328425\n", "files": ["mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/kotlin/String.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/kotlin/StringTest.kt", "mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/ktx/util/URLStringUtils.kt", "mobile/android/android-components/components/support/utils/src/test/java/mozilla/components/support/utils/URLStringUtilsTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "2655cc7697daea5f2871b3e42e588a4768477ee4", "git_parents": ["48bfc983860d374a828b3bfbb4376593962a7b77"], "node": "8874183e5e03e0d3516bb4818481fdd30bfe9b84", "parents": ["ea83ab7accb7453cb14eedfbf5bc2db6ce85968f"], "tags": []}, {"author": "neoyarus \u003cneoyarus@gmail.com\u003e", "branch": "default", "desc": "Bug 1813919 - Navigate address-bar URLs containing spaces. r=android-reviewers,petru\n\nHTTP/S addresses with spaces in the path, query or fragment now open as URLs instead of searches, with the spaces encoded as `%20`. The \"Search with\" row now also shows when search suggestions are turned off, so the typed text can still be searched. Input that isn't classified as a URL reaches Gecko or the search engine unchanged, and an explicit search stays a search.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327680\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/AddressBarNavigationTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/AddressBarTestCase.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/usecases/FenixBrowserUseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/SearchSuggestionsProvidersBuilder.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/usecases/FenixBrowserUseCasesTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/awesomebar/SearchSuggestionsProvidersBuilderTest.kt"], "git_node": "f38fd9c622afc87715f07eefb12d5080bbd313c0", "git_parents": ["2655cc7697daea5f2871b3e42e588a4768477ee4"], "node": "b5b1dd401b62279b1f4b074d2fb6d6df584954c2", "parents": ["8874183e5e03e0d3516bb4818481fdd30bfe9b84"], "tags": []}, {"author": "neoyarus \u003cneoyarus@gmail.com\u003e", "branch": "default", "desc": "Bug 2047486 - Add lossless URL formatters to URLStringUtils. r=android-reviewers,petru\n\n`toLosslessDisplayUrl` and `toLosslessEditableUrl` port desktop's `losslessDecodeDisplaySpec`, so every Android surface that shows a URL can decode it the same way desktop does. The shared `toDisplayUrl` and `toShortUrl` helpers use them. Tests compare the formatter with 45 cases generated by the desktop helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328426\n", "files": ["mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/kotlin/String.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/kotlin/StringTest.kt", "mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/ktx/util/URLStringUtils.kt", "mobile/android/android-components/components/support/utils/src/test/java/mozilla/components/support/utils/URLStringUtilsTest.kt", "mobile/android/android-components/components/support/utils/src/test/resources/url-editing/firefox-desktop.tsv", "mobile/android/android-components/docs/changelog.md"], "git_node": "d1ea733b2e3da95a3fe153f3d4486d14faddf456", "git_parents": ["f38fd9c622afc87715f07eefb12d5080bbd313c0"], "node": "26fa3a03dd4360eec53f61ecbbb3fbc5143b8718", "parents": ["b5b1dd401b62279b1f4b074d2fb6d6df584954c2"], "tags": []}, {"author": "neoyarus \u003cneoyarus@gmail.com\u003e", "branch": "default", "desc": "Bug 2047486 - Use desktop formatting rules for URLs shown on Android. r=android-reviewers,petru\n\nThe address bar and its suggestions, history, bookmarks, recent and closed tabs, the tabs tray, tab history and share captions show readable Unicode and spaces in HTTP/S URLs, as desktop does. Navigation, storage, comparison, copy and share keep the canonical URL, and editing only a bookmark's title leaves its stored URL untouched.\n\nHistory storage suggestions now carry the `HISTORY` flag, so they become readable when selected for editing like other browser-owned URLs, and tapping them is now counted by `History.searchResultTapped` like other history results. Search engine and clipboard suggestion text stays literal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327679\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/internal/Suggestion.kt", "mobile/android/android-components/components/compose/awesomebar/src/test/java/mozilla/components/compose/browser/awesomebar/internal/SuggestionTest.kt", "mobile/android/android-components/components/feature/awesomebar/src/main/java/mozilla/components/feature/awesomebar/provider/HistoryStorageSuggestionProvider.kt", "mobile/android/android-components/components/feature/awesomebar/src/main/java/mozilla/components/feature/awesomebar/provider/SessionSuggestionProvider.kt", "mobile/android/android-components/components/feature/awesomebar/src/test/java/mozilla/components/feature/awesomebar/provider/CombinedHistorySuggestionProviderTest.kt", "mobile/android/android-components/components/feature/awesomebar/src/test/java/mozilla/components/feature/awesomebar/provider/HistoryStorageSuggestionProviderTest.kt", "mobile/android/android-components/components/feature/awesomebar/src/test/java/mozilla/components/feature/awesomebar/provider/SessionSuggestionProviderTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/AddressBarNavigationTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/bookmarks/view/Bookmarks.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/recenttabs/view/RecentTabs.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/viewholders/HistoryListItemViewHolder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/historymetadata/view/HistoryMetadataGroupItemViewHolder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/recentlyclosed/RecentlyClosedItemViewHolder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/AddressBarUrl.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/BrowserToolbarToFenixSearchMapperMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/FenixSearchMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/listadapters/ShareTabsAdapter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabhistory/TabHistoryViewHolder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/BasicTabListItem.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/BookmarksMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/BookmarksReducerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/historymetadata/view/HistoryMetadataGroupItemViewHolderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/AddressBarUrlTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/FenixSearchMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabhistory/TabHistoryViewHolderTest.kt"], "git_node": "b37b4fc34df257d00cf0090c8bb1e5a3960cbfb1", "git_parents": ["d1ea733b2e3da95a3fe153f3d4486d14faddf456"], "node": "0337048903407aecb40e607bd5f4470c9b06b304", "parents": ["26fa3a03dd4360eec53f61ecbbb3fbc5143b8718"], "tags": []}, {"author": "neoyarus \u003cneoyarus@gmail.com\u003e", "branch": "default", "desc": "Bug 2047486 - Add address-bar privacy instrumentation tests. r=android-reviewers,petru\n\nThe remote search suggestion test only runs the permission combinations that behave differently, and the other tests run on the four focus and browsing-mode combinations, which keeps the CI cost down.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328427\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/AddressBarPrivacyTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/AddressBarSuggestionsPrivacyTest.kt"], "git_node": "95d7d0ae5f4147c801b6c01557bea8d87586e912", "git_parents": ["b37b4fc34df257d00cf0090c8bb1e5a3960cbfb1"], "node": "b8dfa33ea72994de72595721d2719d11eeffc964", "parents": ["0337048903407aecb40e607bd5f4470c9b06b304"], "tags": []}, {"author": "neoyarus \u003cneoyarus@gmail.com\u003e", "branch": "default", "desc": "Bug 2047486 - Show suggestion titles made from their URL in a readable form. r=android-reviewers,petru\n\nPlaces titles a URL match with its stored URL minus the scheme, so typing an encoded path showed an encoded title above the readable URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328849\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/internal/Suggestion.kt", "mobile/android/android-components/components/compose/awesomebar/src/test/java/mozilla/components/compose/browser/awesomebar/internal/SuggestionTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "1ca97bfffffb806a1a9e6909489fccf8334fca42", "git_parents": ["95d7d0ae5f4147c801b6c01557bea8d87586e912"], "node": "f3c1dd0aa325e185e517f68277d3494f7e82890e", "parents": ["b8dfa33ea72994de72595721d2719d11eeffc964"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076039 - Use geckoview-test_runner.apk as the target for Android test-coverage tasks. r=nicolas.guichard\n\nBug 1399396 added the `ccov-code-coverage-tests` test set to `android-em-14-x86_64-ccov/opt`, but the `test-coverage` task in `taskcluster/kinds/test/misc.yml` has no Android `target` override. So `set_target` falls back to the default `target.apk`, which GeckoView builds never publish, and the TC task always fails with a 404 while downloading the installer.\n\nThis adds the same `target` override that `test-verify` (misc.yml) and `test-coverage-wpt` (web-platform-tests kind defaults) already have: `android-em.*: geckoview-test_runner.apk`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331941\n", "files": ["taskcluster/kinds/test/misc.yml"], "git_node": "9ccdb7792e8a23463cd6d5c1c628103455606e79", "git_parents": ["1ca97bfffffb806a1a9e6909489fccf8334fca42"], "node": "0d35eac9fef2b3f3f04d1f48e1f825538640a4fe", "parents": ["f3c1dd0aa325e185e517f68277d3494f7e82890e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080219 - Check cached grid axis measurement before creating the ReflowInput. r=TYLin\" for causing build bustages @nsGridContainerFrame.cpp\n\nThis reverts commit 874dac89494ddb82fbb75d073b86e00cc06e0f2d.\n", "files": ["layout/generic/nsGridContainerFrame.cpp"], "git_node": "8cc9ba38c936f356a4feac30a89b15ad465d3cf4", "git_parents": ["9ccdb7792e8a23463cd6d5c1c628103455606e79"], "node": "c381b217388431a00ab9ba47f16f80d73f4114f6", "parents": ["0d35eac9fef2b3f3f04d1f48e1f825538640a4fe"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 2: Fix 70 or so 'misc-unused-parameters' warnings in 3 more directories r=mfbt-reviewers,profiler-reviewers,sergesanspaille,canova\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nEverything found by ./mach static-analysis was manually inspected and changed if needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329451\n", "files": ["hal/HalWakeLock.cpp", "hal/fallback/FallbackPerformanceHintManager.cpp", "hal/fallback/FallbackScreenConfiguration.cpp", "hal/linux/UPowerClient.cpp", "hal/sandbox/SandboxHal.cpp", "mfbt/tests/TestBufferList.cpp", "mfbt/tests/TestMaybe.cpp", "mfbt/tests/TestMozCrash.cpp", "mfbt/tests/TestResult.cpp", "mfbt/tests/TestSegmentedVector.cpp", "mfbt/tests/TestUtf8.cpp", "mfbt/tests/gtest/TestAlgorithm.cpp", "mfbt/tests/gtest/TestResultExtensions.cpp", "mozglue/baseprofiler/core/ProfileBufferEntry.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/misc/StackWalk.cpp", "mozglue/tests/TestBaseProfiler.cpp", "mozglue/tests/gtest/TestStackWalk.cpp"], "git_node": "3fe8b84740d6ee645a9bdb4bac83bb7edf427bae", "git_parents": ["8cc9ba38c936f356a4feac30a89b15ad465d3cf4"], "node": "775be0ad716b73e39ce41172a1998824d35ccbc6", "parents": ["c381b217388431a00ab9ba47f16f80d73f4114f6"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1841326 Colorspace property added and correctly managed in CanvasRenderingContext2d and ImageData r=gfx-reviewers,webidl,emilio,bradwerth\" for causing build bustages @ ImageData.cpp\n\nThis reverts commit c39fb25be0f696efbae911d1f19cceb9e9239622.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/ImageBitmap.cpp", "dom/canvas/ImageData.cpp", "dom/canvas/ImageData.h", "dom/webidl/CanvasRenderingContext2D.webidl", "dom/webidl/ImageData.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/canvas/element/pixel-manipulation/2d.imageData.createImageBitmap.srgb.rgba.unorm8.html.ini"], "git_node": "55798f30b66a304382688423a7dbb3ce120180d3", "git_parents": ["3fe8b84740d6ee645a9bdb4bac83bb7edf427bae"], "node": "33eba90f8c168625047f874f2e6f7ed8a0a166aa", "parents": ["775be0ad716b73e39ce41172a1998824d35ccbc6"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081681 - Allow toggling \"Enable menu customization\" secret setting in Nightly also r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333600\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt"], "git_node": "58f7c25614cabb4dc278ad0810f881af503b8257", "git_parents": ["55798f30b66a304382688423a7dbb3ce120180d3"], "node": "74104eea046acc48baca5832b9a03a5f36e93ede", "parents": ["33eba90f8c168625047f874f2e6f7ed8a0a166aa"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1831048 - Part 2: Fix 70 or so 'misc-unused-parameters' warnings in 3 more directories r=mfbt-reviewers,profiler-reviewers,sergesanspaille,canova\" for causing build bustages @ core/platform.cpp\n\nThis reverts commit 3fe8b84740d6ee645a9bdb4bac83bb7edf427bae.\n", "files": ["hal/HalWakeLock.cpp", "hal/fallback/FallbackPerformanceHintManager.cpp", "hal/fallback/FallbackScreenConfiguration.cpp", "hal/linux/UPowerClient.cpp", "hal/sandbox/SandboxHal.cpp", "mfbt/tests/TestBufferList.cpp", "mfbt/tests/TestMaybe.cpp", "mfbt/tests/TestMozCrash.cpp", "mfbt/tests/TestResult.cpp", "mfbt/tests/TestSegmentedVector.cpp", "mfbt/tests/TestUtf8.cpp", "mfbt/tests/gtest/TestAlgorithm.cpp", "mfbt/tests/gtest/TestResultExtensions.cpp", "mozglue/baseprofiler/core/ProfileBufferEntry.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/misc/StackWalk.cpp", "mozglue/tests/TestBaseProfiler.cpp", "mozglue/tests/gtest/TestStackWalk.cpp"], "git_node": "e8c54eadc14f2ad4ba1dbd5d8bf8d47888945ab3", "git_parents": ["58f7c25614cabb4dc278ad0810f881af503b8257"], "node": "f5b8039984e5b1d9f63fb409243c84c1763f6f76", "parents": ["74104eea046acc48baca5832b9a03a5f36e93ede"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080219 - Check cached grid axis measurement before creating the ReflowInput. r=TYLin\n\nWe need to return the ContentBSize as well, because we no longer set the\nold bsize into the frame via FinishReflowChild. That was rather sketchy\nto begin with (it doesn't change the layout of e.g. the children)...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332438\n", "files": ["layout/generic/nsGridContainerFrame.cpp"], "git_node": "046a5acc16f4f27d422d5721cc981100cf825090", "git_parents": ["e8c54eadc14f2ad4ba1dbd5d8bf8d47888945ab3"], "node": "b0fddc4311a63ac1d082a9b7ce8cc48451732246", "parents": ["f5b8039984e5b1d9f63fb409243c84c1763f6f76"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062858 - Refactor: Inline OnLinkClickWithLoadState. r=ltenenbaum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328587\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h"], "git_node": "be53cdb968c4cd8ace6106ea214a137d2dc6a300", "git_parents": ["046a5acc16f4f27d422d5721cc981100cf825090"], "node": "254b9431fdadab50e3b5d7ac49ea72d556fe5e57", "parents": ["b0fddc4311a63ac1d082a9b7ce8cc48451732246"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062858 - Refactor: Move principal check into IsSameDocumentNavigation. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328588\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h"], "git_node": "ed5e6bab597ea4dc7b8e79f7e2adedf7e8cb9c28", "git_parents": ["be53cdb968c4cd8ace6106ea214a137d2dc6a300"], "node": "9030ece196d956e13b90176a968a68876b699460", "parents": ["254b9431fdadab50e3b5d7ac49ea72d556fe5e57"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062858 - Do fragment navigations from links synchronously. r=farre,webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318477\n", "files": ["docshell/base/nsDocShell.cpp", "modules/libpref/init/StaticPrefList.yaml", "remote/marionette/actors/MarionetteReftestChild.sys.mjs", "testing/web-platform/meta/html/browsers/browsing-the-web/overlapping-navigations-and-traversals/anchor-fragment-history-back-on-click.html.ini", "testing/web-platform/meta/html/browsers/browsing-the-web/overlapping-navigations-and-traversals/same-document-traversal-same-document-nav.html.ini", "testing/web-platform/meta/html/semantics/forms/the-button-element/controls-inside-link-activation.tentative.html.ini", "testing/web-platform/meta/navigation-api/currententrychange-event/anchor-click.html.ini", "testing/web-platform/meta/navigation-api/precommit-handler/precommitHandler-redirect-non-api-navigation.html.ini", "testing/web-platform/tests/html/browsers/browsing-the-web/overlapping-navigations-and-traversals/anchor-fragment-history-back-on-click.html", "testing/web-platform/tests/html/browsers/browsing-the-web/scroll-to-fragid/scroll-to-fragid-from-link-is-synchronous.html"], "git_node": "f5befd04b0d5bd5af696d04336231272aed7fb5a", "git_parents": ["ed5e6bab597ea4dc7b8e79f7e2adedf7e8cb9c28"], "node": "0b66c6f4c50ba14706275ebc6a62938ae92f4ba9", "parents": ["9030ece196d956e13b90176a968a68876b699460"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062858 - Don't convert link clicks to replace during onload. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332350\n", "files": ["docshell/base/nsDocShell.cpp", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/replace-before-load/a-fragment-click-during-load.html", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/replace-before-load/resources/fragment-click-during-load-helper.html"], "git_node": "1f18bb982a5020a19d41901a0bf1cc5c71f2963f", "git_parents": ["f5befd04b0d5bd5af696d04336231272aed7fb5a"], "node": "7de8ac551a5108911a9555e00906123a01288e1d", "parents": ["0b66c6f4c50ba14706275ebc6a62938ae92f4ba9"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2062858: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "0442b449ecf131bd75e515fbd76f0fdd5c82362a", "git_parents": ["1f18bb982a5020a19d41901a0bf1cc5c71f2963f"], "node": "3a941a7c23bcb3171adf9ef95f914ae22ec8c030", "parents": ["7de8ac551a5108911a9555e00906123a01288e1d"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081669 - Update metadata for clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html on macOS 15. r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333599\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.ini"], "git_node": "dfb62d98918d1f945a1f13291c975270968e342f", "git_parents": ["0442b449ecf131bd75e515fbd76f0fdd5c82362a"], "node": "cd9765539447962431226e78a8241cd7f31fcb49", "parents": ["3a941a7c23bcb3171adf9ef95f914ae22ec8c030"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079998 - Keep the source of event handlers forwarded to a window until they're compiled. r=smaug\n\nEvent handler content attributes of \u003cbody\u003e, \u003cframeset\u003e and \u003cxul:window\u003e\nare forwarded to the window. Lazy compilation reads a handler's source\nfrom the attribute on mTarget, but for forwarded handlers mTarget is the\nwindow, which has no attribute to read.\n\nFor forwarded handlers, keep the source, and the element's namespace for\nthe argument names, on the JSEventHandler instead, and compile them\nlazily like other inline handlers. The new handler is then visible as\nsoon as the attribute is set, like the spec's raw uncompiled handler.\n\nAlso remove the now unused aDefer plumbing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333231\n", "files": ["dom/base/Element.cpp", "dom/base/Element.h", "dom/events/EventListenerManager.cpp", "dom/events/EventListenerManager.h", "dom/events/JSEventHandler.h", "dom/events/crashtests/2079998.html", "dom/events/crashtests/crashtests.list", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h", "dom/xul/nsXULElement.cpp", "dom/xul/nsXULElement.h"], "git_node": "88eb03cc0c881ef116b721ccd242abf377c6154b", "git_parents": ["dfb62d98918d1f945a1f13291c975270968e342f"], "node": "f4a94bd6a54519e5dd4d1e120d6e138c51fd50cd", "parents": ["cd9765539447962431226e78a8241cd7f31fcb49"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2080638 - Use moz-src for dom/media r=webrtc-reviewers,ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332759\n", "files": ["dom/media/PeerConnection.sys.mjs", "dom/media/PeerConnectionIdp.sys.mjs", "dom/media/components.conf", "dom/media/moz.build", "dom/media/webrtc/tests/mochitests/identity/test_fingerprints.html", "dom/media/webrtc/tests/mochitests/identity/test_idpproxy.html", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "42ce30444242860572ed161b7bd8a486c94a69d1", "git_parents": ["88eb03cc0c881ef116b721ccd242abf377c6154b"], "node": "277b73b482c11e91444e6a89bad8e0ffc96bc15a", "parents": ["f4a94bd6a54519e5dd4d1e120d6e138c51fd50cd"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079614 - [customizable-menu] Support sandboxed custom tabs r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333249\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactory.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuTarget.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProviderTest.kt"], "git_node": "77e208bcf7dca1ae77481a2721bf63235a197a4d", "git_parents": ["42ce30444242860572ed161b7bd8a486c94a69d1"], "node": "48340301699dedfd6fd97f27e3c25be45d1ce733", "parents": ["277b73b482c11e91444e6a89bad8e0ffc96bc15a"], "tags": []}, {"author": "eldjiikgull (EDS) \u003c333746118+eldjiikgull@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075750 - Close the attachment bundle before deleting it in Downloader.cacheAll(). r=remote-settings-reviewers,leplatrem\n\nThe bundle zip was never deleted from the temp directory. The deletion\nwas removed in bug 1908699 because it failed on Windows with a locked\nfile. The lock came from the zip reader, which was never closed.\n\nClose the reader, then delete the file, in a finally block. The test\nchecks again that no zip file is left behind, on success, on a failed\nextraction and on a failed save. It compares the temp directory before\nand after cacheAll(), so a zip file that was already there does not\nmake it fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329343\n", "files": ["services/settings/Attachments.sys.mjs", "services/settings/test/unit/test_attachments_downloader.js"], "git_node": "c3246bcbb3e5e333099e2922c82fd0e7ba105311", "git_parents": ["77e208bcf7dca1ae77481a2721bf63235a197a4d"], "node": "9285baea23dba34299400bbdc9eefc0f4b6c6cef", "parents": ["48340301699dedfd6fd97f27e3c25be45d1ce733"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081627 - Update android nightly application-services version bump to ec31dc5b4a91bff3749222090a8f8eef4b70cb56 r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333534\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "ac889625759866ae052f40b1917fc33cf8bbe1f9", "git_parents": ["c3246bcbb3e5e333099e2922c82fd0e7ba105311"], "node": "9e71cc00bd25882f52a758d173f11f3f06bc131c", "parents": ["9285baea23dba34299400bbdc9eefc0f4b6c6cef"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2081638 - Remove unused Android SurfaceTexture usage of canvas r=gfx-reviewers,jnicol\n\nAndroid SurfaceTexture is no longer used for canvas rendering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333539\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "gfx/gl/AndroidNativeWindow.h", "gfx/gl/SharedSurface.cpp", "gfx/gl/SharedSurfaceEGL.cpp", "gfx/gl/SharedSurfaceEGL.h", "gfx/gl/SurfaceTypes.h", "gfx/gl/moz.build", "gfx/layers/CanvasRenderer.cpp", "gfx/layers/LayersTypes.h", "gfx/layers/client/TextureClient.cpp", "gfx/layers/opengl/TextureClientOGL.cpp", "gfx/layers/opengl/TextureClientOGL.h", "gfx/layers/opengl/TextureHostOGL.cpp", "gfx/vr/ipc/VRLayerChild.cpp", "gfx/webrender_bindings/RenderAndroidSurfaceTextureHost.cpp", "modules/libpref/init/StaticPrefList.yaml", "widget/android/AndroidCompositorWidget.cpp", "widget/android/AndroidCompositorWidget.h"], "git_node": "94b1e2b1c62af54fc93cc02a2eb04a2d5f771d17", "git_parents": ["ac889625759866ae052f40b1917fc33cf8bbe1f9"], "node": "8b49d9328d1c9077a252c9709219ae790891adb6", "parents": ["9e71cc00bd25882f52a758d173f11f3f06bc131c"], "tags": []}, {"author": "Willem Kaufmann \u003cwillem.kaufmann@gmail.com\u003e", "branch": "default", "desc": "Bug 2079806 - Shut down `CookieStore` when its global is torn down. r=cookie-reviewers,baku\n\nWhile a window is in the `bfcache`, `CookieStoreNotifier` queues cookie\nchange events in `mDelayedDOMEvents`, and each event holds a strong\nreference to the window. When the `bfcache` entry was evicted, nothing\nreleased the queue. The notifier is not cycle collected, and\n`CookieStore::Shutdown()` only ran from unlink and the destructor, which\na page holding cookieStore never reached. As a result, the window leaked\nas a ghost window for the lifetime of its content process.\n\nShut the `CookieStore` down in `DisconnectFromOwner()` and clear the\nqueued events when the notifier is disentangled to prevent the leaks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332068\n", "files": ["dom/cookiestore/CookieStore.cpp", "dom/cookiestore/CookieStore.h", "dom/cookiestore/CookieStoreNotifier.cpp", "netwerk/cookie/test/browser/browser.toml", "netwerk/cookie/test/browser/browser_cookieStore_bfcache_leak.js"], "git_node": "16713f82e6e1e475a18a59a0da5ad7e6b4da7673", "git_parents": ["94b1e2b1c62af54fc93cc02a2eb04a2d5f771d17"], "node": "77a4e5e8157bdefae3e692ccc440fa99eed8cc4b", "parents": ["8b49d9328d1c9077a252c9709219ae790891adb6"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 2: Fix 70 or so 'misc-unused-parameters' warnings in 3 more directories r=mfbt-reviewers,profiler-reviewers,sergesanspaille,canova\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nEverything found by ./mach static-analysis was manually inspected and changed if needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329451\n", "files": ["hal/HalWakeLock.cpp", "hal/fallback/FallbackPerformanceHintManager.cpp", "hal/fallback/FallbackScreenConfiguration.cpp", "hal/linux/UPowerClient.cpp", "hal/sandbox/SandboxHal.cpp", "mfbt/tests/TestBufferList.cpp", "mfbt/tests/TestMaybe.cpp", "mfbt/tests/TestMozCrash.cpp", "mfbt/tests/TestResult.cpp", "mfbt/tests/TestSegmentedVector.cpp", "mfbt/tests/TestUtf8.cpp", "mfbt/tests/gtest/TestAlgorithm.cpp", "mfbt/tests/gtest/TestResultExtensions.cpp", "mozglue/baseprofiler/core/ProfileBufferEntry.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/misc/StackWalk.cpp", "mozglue/tests/TestBaseProfiler.cpp", "mozglue/tests/gtest/TestStackWalk.cpp"], "git_node": "c3b08041690ba091f755a51427c4c5c1f31c2a06", "git_parents": ["16713f82e6e1e475a18a59a0da5ad7e6b4da7673"], "node": "e33fc1e84f1a5444ef2e779019c9a648e36f5fef", "parents": ["77a4e5e8157bdefae3e692ccc440fa99eed8cc4b"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080262 - Use declareLazy to for imports in remaining urlbar modules. r=urlbar-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332471\n", "files": ["browser/components/urlbar/ActionsProviderQuickActions.sys.mjs", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs", "browser/components/urlbar/QuickActionsLoaderDefault.sys.mjs", "browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderAboutPages.sys.mjs", "browser/components/urlbar/UrlbarProviderActionsSearchMode.sys.mjs", "browser/components/urlbar/UrlbarProviderAddonsShortcutMoved.sys.mjs", "browser/components/urlbar/UrlbarProviderAiChat.sys.mjs", "browser/components/urlbar/UrlbarProviderAliasEngines.sys.mjs", "browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarProviderBookmarkKeywords.sys.mjs", "browser/components/urlbar/UrlbarProviderCalculator.sys.mjs", "browser/components/urlbar/UrlbarProviderClipboard.sys.mjs", "browser/components/urlbar/UrlbarProviderGlobalActions.sys.mjs", "browser/components/urlbar/UrlbarProviderHeuristicFallback.sys.mjs", "browser/components/urlbar/UrlbarProviderHistoryUrlHeuristic.sys.mjs", "browser/components/url