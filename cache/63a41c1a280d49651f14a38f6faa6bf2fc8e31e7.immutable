int-rollouts.config.js", "toolkit/components/contentanalysis/tests/browser/save_page_complete.css"], "git_node": "7d4833c1337b02a4ad6d668d2eb1c5bba503c329", "git_parents": ["0a139fafe87e510e42956f39792df288e123615e"], "node": "e8feb19e5501b46ba9aaff3e0f731d19cf2b9dbb", "parents": ["bebecacd30f0cb6d783b53919bc8071cd1ef1b8b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081760 - Tweak transition cascade order. r=firefox-style-system-reviewers,dshin\n\nAdd a pref + test to make sure that transitions can't override UA\nimportant cascade level.\n\nSee bug 2077756 for context.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333700\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/rule_tree/level.rs", "testing/web-platform/tests/css/css-transitions/ua-important.tentative.html"], "git_node": "b0a6c1bb4eae8fb6022700aa1bc2215a6892f941", "git_parents": ["7d4833c1337b02a4ad6d668d2eb1c5bba503c329"], "node": "0fc6326e5902c8e16e3bf5b7d7a59659d9b68e21", "parents": ["e8feb19e5501b46ba9aaff3e0f731d19cf2b9dbb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077502 - Fix stale threading comments in netwerk/protocol/http. r=necko-reviewers,valentin\n\nCorrect the comments on nsHttpTransaction::mResponseHeadTaken, nsAHttpTransaction::RequestHead, the nsHttpHandler Alt-Svc functions, and the nsHttpConnectionMgr main thread section.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330416\n", "files": ["netwerk/protocol/http/nsAHttpTransaction.h", "netwerk/protocol/http/nsHttpConnectionMgr.h", "netwerk/protocol/http/nsHttpHandler.h", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": "f231ceb363c8c30c1f0f5bb5bc3386ee02fc37d2", "git_parents": ["b0a6c1bb4eae8fb6022700aa1bc2215a6892f941"], "node": "325d97c64f6386c01ff9c737b8c89b42a7c83e40", "parents": ["0fc6326e5902c8e16e3bf5b7d7a59659d9b68e21"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080278 - Add AutoTabGrouping ASRouter Targeting Variable. r=jlewis,omc-reviewers,aminomancer\n\nThis patch adds `isAutoTabGroupingAvailable` (AutoTabGroupingSuggestions.isAvailable) so\nAuto Tab Grouping messages follow the feature's own locale gate.\n\nIt also removes the English-only isSmartTabGroupingAllowed. The sw-organize-tabs-callout\nrollout will be updated to use the new attribute.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332520\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "dceddb3a8efa9d9543fd50433f0b7605ef5dfdc6", "git_parents": ["f231ceb363c8c30c1f0f5bb5bc3386ee02fc37d2"], "node": "63f1742e583243817bfc48527db2dbe4085aeb56", "parents": ["325d97c64f6386c01ff9c737b8c89b42a7c83e40"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077572: treat autoland tasks as higher priority than non-shipping release pushes r=release-managers,RyanVM\n\nIn addition to the simple switch to `autoland`s own priority, this includes:\n* Reducing priority of non-shipping mozilla-release builds. Maybe there's a reason this wasn't done in https://bugzilla.mozilla.org/show_bug.cgi?id=2065046, but it seems like an obvious thing to do?\n* Raising mozilla-central's priority. This has no effect on the relative priorities of different branches, but needed to be done to make room for autoland between the last `default` and the non-shipping priority of release branches\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330427\n", "files": ["taskcluster/config.yml"], "git_node": "e9fd513f5035082e639f6b4a08c482ca9adb1a96", "git_parents": ["dceddb3a8efa9d9543fd50433f0b7605ef5dfdc6"], "node": "84329e47f9873eb2becbebccea684f54e41b3c9d", "parents": ["63f1742e583243817bfc48527db2dbe4085aeb56"], "tags": []}, {"author": "Mirko Kerezovic \u003cmirko@kerezovic.de\u003e", "branch": "default", "desc": "Bug 2078343 - Remove unused __SS_tabsToRestore from browser-test.js. r=dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333010\n", "files": ["testing/mochitest/browser-test.js"], "git_node": "d88df093560ec5993566c1f98865cabec1d65002", "git_parents": ["e9fd513f5035082e639f6b4a08c482ca9adb1a96"], "node": "06be60fb93db3534707b711caee56d945e4c9db9", "parents": ["84329e47f9873eb2becbebccea684f54e41b3c9d"], "tags": []}, {"author": "Mirko Kerezovic \u003cmirko@kerezovic.de\u003e", "branch": "default", "desc": "Bug 2078165 - Remove unused browser.urlbar.extension.timeout pref. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333021\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarPrefs.sys.mjs"], "git_node": "0d323688a9c5c525245b5dc5a6a99001886acf6d", "git_parents": ["d88df093560ec5993566c1f98865cabec1d65002"], "node": "fa4f2fa7cfdf0226be877621c7cb0b3a29174023", "parents": ["06be60fb93db3534707b711caee56d945e4c9db9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080800 - Keep the use-design-tokens autofix from replacing common size values with component-specific tokens. r=hjones,desktop-theme-reviewers\n\nThe derived map changes only where a component token won, which the diff cannot show: `40px` now fixes to `--size-image-xsmall`, and values that only a component token had, such as `2px` or `initial`, no longer autofix. Every scale-token mapping is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332841\n", "files": ["tools/lint/stylelint/stylelint-plugin-mozilla/helpers.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.size.tests.mjs"], "git_node": "f09c4b24d7961ac0fc8707e767f1d55d0d5f6d3f", "git_parents": ["0d323688a9c5c525245b5dc5a6a99001886acf6d"], "node": "a6b7c217e0fceff3efacc7353b8120fa6261e2b3", "parents": ["fa4f2fa7cfdf0226be877621c7cb0b3a29174023"], "tags": []}, {"author": "Rana Al-Khulaidi \u003cralkhulaidi@gmail.com\u003e", "branch": "default", "desc": "Bug 2059777 - Move ClientEnvironment out of toolkit/components/normandy. r=nimbus-reviewers,omc-reviewers,mconley,aminomancer,beth\n\nThese changes remove Normandy's ClientEnvironment and move the remaining consumers to ClientEnvironmentBase. Code that previously used userId now uses ClientEnvironmentBase.legacyRandomizationId which is the renamed randomizationId and keeps the same value.\n\nNormandy now gets the country from Region.home instead of the classify-client server. Nothing else that uses location should be affected since it already uses Region.home. The tests from browser_ClientEnvironment.js that cover ClientEnvironmentBase getters are also moved into test_ClientEnvironment.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330813\n", "files": ["browser/components/aboutwelcome/tests/unit/unit-entry.js", "browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/unit/TargetingDocs.test.js", "browser/components/asrouter/tests/unit/unit-entry.js", "toolkit/components/backgroundtasks/BackgroundTask_message.sys.mjs", "toolkit/components/messaging-system/targeting/Targeting.sys.mjs", "toolkit/components/messaging-system/targeting/test/unit/test_targeting.js", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/test/unit/test_ExperimentManager_enroll.js", "toolkit/components/normandy/actions/ShowHeartbeatAction.sys.mjs", "toolkit/components/normandy/lib/ClientEnvironment.sys.mjs", "toolkit/components/normandy/lib/RecipeRunner.sys.mjs", "toolkit/components/normandy/test/browser/browser.toml", "toolkit/components/normandy/test/browser/browser_ClientEnvironment.js", "toolkit/components/normandy/test/browser/browser_LegacyHeartbeat.js", "toolkit/components/normandy/test/browser/browser_RecipeRunner.js", "toolkit/components/normandy/test/browser/browser_actions_ShowHeartbeatAction.js", "toolkit/components/utils/ClientEnvironment.sys.mjs", "toolkit/components/utils/test/unit/test_ClientEnvironment.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "403f0b56164104799d69a2db85940075b0471f4d", "git_parents": ["f09c4b24d7961ac0fc8707e767f1d55d0d5f6d3f"], "node": "0146746983fe2e0611b3de56986a281aac1733b9", "parents": ["a6b7c217e0fceff3efacc7353b8120fa6261e2b3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077501 - Assert that the Digest authenticator is used on the main thread. r=necko-reviewers,valentin\n\nnsHttpDigestAuth is a singleton that keeps per-call state in members, which is only safe because nsHttpChannelAuthProvider calls it on the main thread.  Assert that in ChallengeReceived and GenerateCredentials and note it on the members.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330415\n", "files": ["netwerk/protocol/http/nsHttpDigestAuth.cpp", "netwerk/protocol/http/nsHttpDigestAuth.h"], "git_node": "680a5440e4434789237610e4bc8b2a639163c47c", "git_parents": ["403f0b56164104799d69a2db85940075b0471f4d"], "node": "7d838a266bf65d4226442cad81a9fdbc408691b0", "parents": ["0146746983fe2e0611b3de56986a281aac1733b9"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081616 - Update NSS to 119695e9cf9a81a41c685b7b652d6774827b742f. UPGRADE_NSS_RELEASE r=nss-reviewers,jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333525\n", "files": ["security/nss/automation/taskcluster/scripts/build_gyp.sh", "security/nss/a