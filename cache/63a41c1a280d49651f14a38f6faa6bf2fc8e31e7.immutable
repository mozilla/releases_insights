1d_unittest.cc", "security/nss/help.txt", "security/nss/lib/ckfw/builtins/certdata.txt", "security/nss/lib/ckfw/builtins/nssckbi.h", "security/nss/lib/freebl/freebl.gyp", "security/nss/lib/freebl/ghash.gyp", "security/nss/lib/freebl/intel-gcm-wrap.gyp", "security/nss/lib/nss/nss.h", "security/nss/lib/pk11wrap/pk11pk12.c", "security/nss/lib/pk11wrap/pk11skey.c", "security/nss/lib/softoken/pkcs11c.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/ssl.h", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/ssl/sslsock.c", "security/nss/lib/ssl/tls13con.c", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/secasn1d.c", "security/nss/moz.yaml", "security/nss/taskcluster/kinds/test/gtest.yml", "security/nss/taskcluster/kinds/test/kind.yml", "security/nss/taskcluster/nss_taskgraph/transforms/build.py", "security/nss/tests/smime/smime.sh"], "git_node": "7ff62457dcf126523608e2f4b90d232d49d58185", "git_parents": ["5f8d7c123dd64ea10b1bdfe09235b19e624af721"], "node": "fee2fc492a7d62689a724c01c2b810cd49f43212", "parents": ["60568ec293f64611ac08be4d4096fd40d185a84d"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084808 - remove EV status for distrusted emSign roots. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336070\n", "files": ["security/certverifier/ExtendedValidation.cpp"], "git_node": "924cbd0bd600f9fe1a123d108e9cc005114ed6a6", "git_parents": ["7ff62457dcf126523608e2f4b90d232d49d58185"], "node": "bf1d214daaac3a6907fd3ca29765daf566b7563d", "parents": ["fee2fc492a7d62689a724c01c2b810cd49f43212"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071112 - Picture of the Day: hide the picture until it loads. r=reemhamz\n\nOn a new window, a fresh start or several New Tabs opened quickly, the widget could briefly show the picture\u2019s alt text, then a blank card, before the image appeared. It now keeps the placeholder visible and shows the picture only after it loads, like story card images.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335444\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/PictureOfTheDay.jsx", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/_PictureOfTheDay.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/PictureOfTheDay.test.jsx"], "git_node": "7eb180f7c9b05ff95dfcfa5e077e6b1f53afefdf", "git_parents": ["924cbd0bd600f9fe1a123d108e9cc005114ed6a6"], "node": "36fc28173c6bc3229af649e9506d5147bf2f3897", "parents": ["bf1d214daaac3a6907fd3ca29765daf566b7563d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084626 - Merge the overlapping shapes of the synced tabs icon so a translucent fill doesn't darken its corners. r=desktop-theme-reviewers,sfoster DONTBUILD\n\nThe merged path covers exactly the area of the old paths. With an opaque fill, only the edges two old shapes shared change: they were antialiased twice and are slightly softer now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336046\n", "files": ["browser/themes/shared/icons/synced-tabs.svg"], "git_node": "1de2163fed07e8174d3f655c86ada9583fa032e1", "git_parents": ["7eb180f7c9b05ff95dfcfa5e077e6b1f53afefdf"], "node": "e08017f2c63294cc24eff7bf1f756b72a39bbb74", "parents": ["36fc28173c6bc3229af649e9506d5147bf2f3897"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075274 - Size the carousel container and cards Spotlight responsiveness. r=omc-reviewers,sachung\n\nGives the carousel two fixed layouts. The screen is either 800px wide, where the selected card is enlarged and its neighbours peek in at a smaller size, or the standard 504px Spotlight width, where every card takes the smaller size and the selection is marked by its outline. A container query on .section-main switches the custom properties that size the selected and the peek card, so both change together when the screen crosses that boundary, and the screen itself snaps between the two widths. The selected card's 4px ring is a border, which keeps those sizes the card's real outer box, and each card scales its artwork to its own box.\n\nCarousel rendering is opt-in through tiles.layout: \"carousel\", which also gates the pill row. Selecting a pill animates the row's scroll position with requestAnimationFrame over the same duration the card takes to grow, re-measuring the destination each frame so the card lands centred, and a ResizeObserver re-centres it when the row is resized. The pill click records a CLICK_BUTTON event.\n\nNote that the frames leave no room for body copy, so body text is kept for assistive technology but is not displayed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333493\n", "files": ["browser/base/content/test/browser-static/browser_parsable_css.js", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/CarouselNav.jsx", "browser/components/asrouter/content-src/components/ContentTiles.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/components/SingleSelect.jsx", "browser/components/asrouter/content-src/components/TileButton.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/about-welcome.md", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_spotlight_carousel_nav.js", "browser/components/asrouter/tests/unit/content-src/components/ContentTiles.test.jsx", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "60092d9e0134be92fc8663130ed042026c64f981", "git_parents": ["1de2163fed07e8174d3f655c86ada9583fa032e1"], "node": "62c076a1a0edf180e69bfe60bd901ff2d4d47c94", "parents": ["e08017f2c63294cc24eff7bf1f756b72a39bbb74"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083546 part 1: Rename gfxTextRun::DrawGlyphs's aSpacingRange to aProviderRange. r=gfx-reviewers,lsalzman\n\nThis parameter identifies the sub-range of aRange that the given PropertyProvider can actually answer for.\nIt is currently only used to scope spacing lookups.\nHowever, a later patch will also use it to scope source text lookups.\nTherefore, generalise the name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335507\n", "files": ["gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h"], "git_node": "f4ff3892f8305a425f7f18bf842a4dcd1cbb51a1", "git_parents": ["60092d9e0134be92fc8663130ed042026c64f981"], "node": "9fb4bb25b658152ac49c4ab93b1f7b5138a4a2ee", "parents": ["62c076a1a0edf180e69bfe60bd901ff2d4d47c94"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083546 part 2: Fix a crash when a ligature's glyph spans two layout frames (and thus PropertyProviders). r=jfkthame\n\nA gfxTextRun can span multiple PropertyProviders, such as adjacent nsTextFrames for separate text nodes, as long as they share a font and style.\nA ligature glyph can therefore span the boundary between two providers, since shaping happens across the whole run, regardless of provider boundaries.\nDrawPartialLigature always asks DrawGlyphs to draw the complete range of such a ligature, even though a single provider only has source text for the characters it actually owns.\n\nPreviously, GetSourceText was called with that complete range directly.\nFor the provider on the first side of the boundary, this read past the end of its own text.\nFor the provider on the second side, this underflowed, reading before the start of its own text, which crashes.\n\nTo fix this, restrict the GetSourceText call, and the resulting sourceCharToByte array, to aProviderRange instead of aRange.\nCharacters inside aRange but outside aProviderRange now map to the nearest edge of the provider's source text.\nThis way, the glyph itself can still be drawn in full, while each provider only reports the text it actually owns.\n\nAlso switch the source text strings and arrays to be non-auto so that they don't bloat the stack frame, since this isn't a common case in relative terms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335508\n", "files": ["accessible/tests/browser/pdfOutput/browser_sourceText.js", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxTextRun.cpp"], "git_node": "89587205401951f650311dfd5588f663e9f7bfa0", "git_parents": ["f4ff3892f8305a425f7f18bf842a4dcd1cbb51a1"], "node": "84ed40d13475437d24f084f5dc6846a56b1ee23f", "parents": ["9fb4bb25b658152ac49c4ab93b1f7b5138a4a2ee"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084501 - Frame-build offscreen scenes against held dl ops. r=gfx-reviewers,ahale\n\nA transaction that builds no main scene holds its dl ops back from the\nstores, but its offscreen scenes were built against them. Frame-build\nthose against a copy of the stores with the ops applied; applying them to\nthe stores early could remove entries the current scene still reads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336071\n", "files": ["gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/rectangle.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/wrench/src/rawtest.rs"], "git_node": "be9f3b044d50a9f27bf6c4d10b06f789588025a5", "git_parents": ["89587205401951f650311dfd5588f663e9f7bfa0"], "node": "637f046b834a0a604cf0db60dc52867c8a2f8b66", "parents": ["84ed40d13475437d24f084f5dc6846a56b1ee23f"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030810 - add previousSessionEnd and impressions to ASRouter targeting environment and expose previousSessionEnd and profileLastUse to nimbus r=omc-reviewers,nimbus-reviewers,aminomancer,beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303827\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/asrouter/tests/unit/ASRouterTargeting.test.js", "browser/components/asrouter/tests/unit/TargetingDocs.test.js", "toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml"], "git_node": "5675ea0b4388e5a5b861570629cda81ec6b80ed8", "git_parents": ["be9f3b044d50a9f27bf6c4d10b06f789588025a5"], "node": "c5149dac52240b0b20f7f6d00e3058a282454c33", "parents": ["637f046b834a0a604cf0db60dc52867c8a2f8b66"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/summarize/src/main/res/values-kmr/strings.xml", "mobile/android/android-components/components/lib/crash/src/main/res/values-kmr/strings.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/res/values-kmr/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-kmr/strings.xml", "mobile/android/fenix/app/src/main/res/values-ab/strings.xml", "mobile/android/fenix/app/src/main/res/values-am/strings.x