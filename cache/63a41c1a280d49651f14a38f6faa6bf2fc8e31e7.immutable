hared/toolbarbuttons.css", "stylelint-rollouts.config.js"], "git_node": "a7090062ade6c71257ecd088491e9c338d19e078", "git_parents": ["73a21488aa7f5cfd0d74cea20d8325cdb12afb9d"], "node": "8cabcdbc610623c119d57ae446d4dc207109b865", "parents": ["8410d9ebc561b7bb239cd2ae4d311183a2b2f51f"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071908 - Add test coverage for the creditCards.storage.rust.enabled pref r=joschmidt,credential-management-reviewers\n\nThe credit card counterpart of bug 2071837. rustCreditCard/browser.toml includes\ntest/browser/creditCard/ wholesale, so those tests and their skip-if annotations\nare inherited rather than copied; what it lists are the credit card tests living\nin test/browser/ instead, each a shim that loads its original. head.js asserts\nrust.active after the test, so nothing that clears it mid-run leaves a suite\npassing against JSON.\n\nNo xpcshell counterpart: those storage tests reach for sync APIs the Rust\nadapter does not answer or past the collection API into creditCards._data, and\ntest_getRecords.js resets the NSS token, which would take this store's key.\n\nCards are encrypted, which addresses are not, so six places that decrypted\nthrough OSKeyStore ask the collection instead, and creditcard.osKeystoreDecrypt\ngains an assertion beside each original. Skipped in the file, the include\nrunning the directory wholesale: browser_creditCard_cvv.js and one task in\nbrowser_creditCard_capture_cvv.js, for a security code the Rust schema has no\ncolumn for; and browser_creditCard_decryption_failure.js, which re-keys the OS\nkey store and so leaves this store's NSS key alone.\n\nbrowser_creditCard_migration.js and browser_creditCard_primaryPassword.js move\nout to test/browser/, covering the Rust store itself rather than re-running a\ntest under a pref; the migration's fixtures gain a 15-digit card, so the rebuilt\nmask and derived fields are asserted against a record the migration copied.\n\nEverything under test/browser/rustCreditCard/ is a second run of a test that\nlives elsewhere, so it can be deleted whole once the Rust store is the only one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326174\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_creditCard_migration.js", "browser/extensions/formautofill/test/browser/browser_creditCard_primaryPassword.js", "browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_form_removal.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_multiple_cc_number.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_decryption_failure.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_display.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_fill_cancel_login.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_submission_autodetect_type.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_submission_normalized.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser.toml", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_autofill_creditCard_expiry.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_autofill_creditCard_name.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_autofill_creditCard_type.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_creditCard_migration.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_creditCard_primaryPassword.js", "browser/extensions/formautofill/test/browser/rustCreditCard/head.js"], "git_node": "49623293c507659b11ff75232dc74310ee41662f", "git_parents": ["a7090062ade6c71257ecd088491e9c338d19e078"], "node": "60ccee0d0caeee5916902ce1c1bf5c5f9d70e3fe", "parents": ["8cabcdbc610623c119d57ae446d4dc207109b865"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079731 - Start a logging sccache server before running configure in automation. r=firefox-build-system-reviewers,sylvestre\n\nConfigure's compiler checks otherwise start an sccache server on their own,\nwithout logging, so when that server fails to start there is no sccache.log\nto tell why.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332032\n", "files": ["python/mozbuild/mozbuild/controller/building.py"], "git_node": "32409bbd4f04c3658e0005a9b49a184cba401e1b", "git_parents": ["49623293c507659b11ff75232dc74310ee41662f"], "node": "2d37b2768fd806961a3e869a0a029739f7a9434a", "parents": ["60ccee0d0caeee5916902ce1c1bf5c5f9d70e3fe"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079597 - Let typing a letter in an open panel-list select an item with a label that starts with punctuation or an emoji. r=reusable-components-reviewers,tgiles\n\nAn item with an empty accesskey attribute now counts as having no accesskey, as it already did in a menupopup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331925\n", "files": ["toolkit/content/tests/widgets/test_panel_item_first_letter.html", "toolkit/content/widgets/auto-accesskey.mjs", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "471f5e3b4ef8fa13cd3b3d61c48dc933bbf88e9f", "git_parents": ["32409bbd4f04c3658e0005a9b49a184cba401e1b"], "node": "f1d9549e396509e18f1607ae2178d3c80f74515e", "parents": ["2d37b2768fd806961a3e869a0a029739f7a9434a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076174 - Count a disabled panel-item with an accesskey when deciding whether auto-accesskey items get accesskeys. r=reusable-components-reviewers,tgiles\n\nEvery panel-item has role=\"presentation\", so the selector meant for informational menu items matched all disabled panel-items.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331926\n", "files": ["toolkit/content/tests/widgets/test_panel_list_accesskey_conflicts.html", "toolkit/content/widgets/auto-accesskey.mjs"], "git_node": "d028d5ec07ccb24d202202201241129563c8d7b7", "git_parents": ["471f5e3b4ef8fa13cd3b3d61c48dc933bbf88e9f"], "node": "2d68999edc5e257c29f7dc5e8f3311c962ce2f82", "parents": ["f1d9549e396509e18f1607ae2178d3c80f74515e"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Fuzz the reftests whose references differ by anti-aliasing with the WebRender SVG item prefs on. r=gfx-reviewers,lsalzman\n\nEach of these compares geometry that WebRender now draws with primitives\nagainst the same geometry drawn by the blob image, or against a downscaled\nrasterization of it. What is left after the anti-aliasing fixes in this\nseries is sub-pixel: edges resolved by the shader instead of by Skia, and\ngradient interpolation that rounds differently, which shows up as a large\ncount of pixels differing by one or two.\n\n  non-scaling-stroke-01         the reference's stroke is a WebRender border\n  downscale-svg-1a/b/c/e/f      the reference's stroked rect is anti-aliased\n                                where the downscaled image is resampled\n  corner-split                  the reference's stroked rounded rect\n  621918-2                      rotated glyphs from WebRender text\n  feComponentTransfer-discrete  filter input rounding\n  feComposite-operator-lighter  same, and no longer Windows only\n  box-decoration-break-01       same fuzz as box-decoration-break-03\n  clip-path-polygon-013         a native clip edge at a half pixel\n  svg-origin-length-cm/pt-00*   gradient interpolation plus one corner pixel\n  blending-002                  stroke edges over a blended fill\n  marker-context-fill-transform a marker's gradient against the path's\n  mask-image-3i                 a circle in a blob image mask against a WebRender\n                                circle\n  paint-order-01                the reference's fill-only circles are WebRender\n                                rounded rects while the stroked circles of the\n                                test stay in the blob\n\nThe values are ranges that hold with the prefs on and off, so they do not\ndepend on the pref flip landing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328130\n", "files": ["layout/reftests/bugs/reftest.list", "layout/reftests/image-element/reftest.list", "layout/reftests/svg/filters/reftest.list", "layout/reftests/svg/reftest.list", "layout/reftests/svg/smil/style/reftest.list", "layout/reftests/svg/svg-integration/clip-path/reftest.list", "layout/reftests/svg/svg-integration/reftest.list", "testing/web-platform/meta/css/css-masking/mask-image/mask-image-3i.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-cm-001.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-cm-002.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-cm-003.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-cm-004.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-cm-005.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-pt-001.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-pt-002.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-pt-003.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-pt-004.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-pt-005.html.ini", "testing/web-platform/meta/svg/painting/reftests/marker-context-fill-transform.html.ini", "testing/web-platform/meta/svg/render/reftests/blending-002.svg.ini"], "git_node": "b2abeeeea1fdbfe3ce831575ecd66ff71b7c2b63", "git_parents": ["d028d5ec07ccb24d202202201241129563c8d7b7"], "node": "5584a388f05751607f94fc9875a3981fbfbb229f", "parents": ["2d68999edc5e257c29f7dc5e8f3311c962ce2f82"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Relax a few bail-outs in the SVG shape and image WebRender paths. r=emilio\n\nEach change is behind its own pref, off by default:\n\n- gfx.webrender.svg-images.opacity: \u003cimage\u003e opacity is passed as the\n  WebRender image color multiplier instead of forcing a blob.\n- gfx.webrender.svg-images.non-uniform-scale: images do not need the\n  uniform scale that shapes need for WebRender anti-aliasing, so they can\n  be active under any scale.\n- gfx.webrender.svg-shapes.blend: shapes and images with mix-blend-mode no\n  longer bail. The blend is performed by the enclosing nsDisplayBlendMode\n  stacking context, which is what the blob path relies on as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325271\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "gfx/layers/wr/WebRenderCommandBuilder.h", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGImageFrame.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "1f8142cb3be38606d27192ee94bf405438078428", "git_parents": ["b2abeeeea1fdbfe3ce831575ecd66ff71b7c2b63"], "node": "93c4cb60487cb8189260cfe52a0e535d526f4f13", "parents": ["5584a388f05751607f94fc9875a3981fbfbb229f"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Draw filled circles, ellipses and rounded rects in SVG with WebRender. r=layout-reviewers,emilio\n\nReplace SVGGeometryElement::SimplePath with SimpleShape, a description of\ngeometry that can be drawn without building a Path: axis aligned rectangles\nwith elliptical corner radii (which covers \u003crect\u003e with rx/ry, \u003ccircle\u003e and\n\u003cellipse\u003e) and lines. The Skia painting path in SVGGeometryFrame::Render only\nuses the DrawTarget rect and line methods for plain rects and lines, and\nbuilds a Path for the other shapes, as before.\n\nSVGGeometryFrame::CreateWebRenderCommands uses it and emits a WebRender\nrounded rect (a thick border, which WebRender caches as an image) for the\nnon rectangular cases. Rounded shapes with shape-rendering: crispEdges stay\nin the blob since WebRender always anti-aliases rounded corners.\n\nDisplayListBuilder::PushRoundedRect now takes explicit corner radii. The\nprevious version, which draws an inscribed ellipse, is renamed to PushEllipse\nand is expressed in terms of PushRoundedRect.\n\nGated behind gfx.webrender.svg-shapes.ellipses, off by default. With the\npref on, the following reftests differ from their references by anti-aliasing\nonly (max difference up to 67 on a handful of pixels, all on shape edges)\nand will need fuzz when the pref is enabled: clipPath-and-shape-rendering-01,\npath-01, mask-opacity-02..05, symbol-01, marker-viewBox-01,\nmoz-only/zoomed-svg-with-viewBox-01, svg-integration/clip-path-transform-001.\n\nA new layout/reftests/svg/webrender directory compares each file rendered\nwith the pref on against the same file rendered with the pref off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325272\n", "files": ["dom/svg/SVGCircleElement.cpp", "dom/svg/SVGCircleElement.h", "dom/svg/SVGEllipseElement.cpp", "dom/svg/SVGEllipseElement.h", "dom/svg/SVGGeometryElement.h", "dom/svg/SVGLineElement.cpp", "dom/svg/SVGLineElement.h", "dom/svg/SVGPathElement.cpp", "dom/svg/SVGPathElement.h", "dom/svg/SVGRectElement.cpp", "dom/svg/SVGRectElement.h", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "layout/generic/nsImageFrame.cpp", "layout/reftests/svg/reftest.list", "layout/reftests/svg/webrender/reftest.list", "layout/reftests/svg/webrender/shapes-ellipses.svg", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGeometryFrame.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b17c823a651fe907ed0021c5fddb5456b34de80d", "git_parents": ["1f8142cb3be38606d27192ee94bf405438078428"], "node": "6678440ed0c55a5744d8f1eaff748f5cff5b322d", "parents": ["93c4cb60487cb8189260cfe52a0e535d526f4f13"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Draw solid strokes on simple SVG shapes with WebRender. r=gfx-reviewers,lsalzman\n\nA solid, undashed stroke of width w on a rect, rounded rect, circle or\nellipse is a WebRender border of width w around the shape inflated by w/2.\nThe outer corner radius is the shape's radius plus w/2; for sharp rect\ncorners it follows stroke-linejoin (square for miter, w/2 for round). Axis\naligned \u003cline\u003es are a rect of thickness w, extended by w/2 for square and\nround caps, the latter drawn as a rounded rect.\n\npaint-order decides whether the fill or the stroke is pushed first.\nfill-opacity and stroke-opacity are folded into the colors; the element\nopacity is folded in only when CanOptimizeOpacity says so, otherwise it is\napplied by the enclosing nsDisplayOpacity item as before.\n\nKept in the blob: dashed strokes, bevel joins, miter limits below sqrt(2),\nnon-scaling strokes, non color stroke paint, non axis aligned lines,\nstrokes with shape-rendering: crispEdges (WebRender borders are always\nanti-aliased), and shapes with markers.\n\nRounded shapes and strokes are also kept in the blob when the inherited\ntransform rotates or skews, since WebRender renders them from axis aligned\ncached images whose edges come out blurry under such transforms. For the\nsame reason IsItemProbablyActive no longer lets shapes that merely could be\nactive pull a rotated or skewed 2D transform out of the blob: the blob would\nthen be rasterized unrotated and resampled instead of having the transform\nbaked in. The transform's own scale is folded into the uniform scale check\nthat its children see.\n\nGated behind gfx.webrender.svg-shapes.strokes, off by default. With the pref\non, non-scaling-stroke-01 differs from its reference: the reference's plain\nstroked rect is now drawn by WebRender with correct half-pixel edges while\nthe test's non-scaling stroke path renders them crisp. That test needs fuzz\nor a different reference when the pref is enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325273\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/reftests/svg/webrender/reftest.list", "layout/reftests/svg/webrender/shapes-strokes.svg", "layout/svg/SVGGeometryFrame.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "8c4717d29ea52108deb6aad1b8ed18c38ffa5e37", "git_parents": ["b17c823a651fe907ed0021c5fddb5456b34de80d"], "node": "382dd10cafd3717c9ad090449b9e5435b8f5484c", "parents": ["6678440ed0c55a5744d8f1eaff748f5cff5b322d"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Roll back spatial tree items in DisplayListBuilder::restore. r=gfx-reviewers,lsalzman\n\nThe save state only recorded the length of the display item buffer, so a\nreference frame, scroll frame or sticky frame defined between save() and\nrestore() kept its spatial tree entry while its id was handed out again to\nthe next spatial node, which trips the duplicate id assertion in the scene\nbuilder. Record the spatial tree buffer length and truncate it too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325274\n", "files": ["gfx/wr/webrender_api/src/display_list.rs"], "git_node": "fb7eb87dc5c59944d596a9f6a13d315d8caee712", "git_parents": ["8c4717d29ea52108deb6aad1b8ed18c38ffa5e37"], "node": "ed82320ec287409433c74351932dca52f865ffc6", "parents": ["382dd10cafd3717c9ad090449b9e5435b8f5484c"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Draw SVG text with a plain opaque fill using WebRender text primitives. r=gfx-reviewers,layout-reviewers,jfkthame,lsalzman\n\nSVGTextFrame::CreateWebRenderCommands walks the rendered runs the same way\nPaintSVG does. For each run it pushes a WebRender reference frame carrying\nthe run transform (glyph position, 1 / mFontSizeScaleFactor, rotation from\nrotate=\"\" or a textPath, the textLength scale) and paints the nsTextFrame at\nthe origin through a TextDrawTarget, so glyph positions reach WebRender\nuntransformed and WebRender applies the scale and rotation when rasterizing.\n\nRuns that cannot be expressed this way make the whole item stay in the blob:\nanything ShouldRenderAsPath accepts (strokes, paint servers, translucent\nfills), text-shadow, text-rendering: geometricPrecision, selection, the\ncaret, opacity on intermediate \u003ctspan\u003e ancestors (the blob path applies it\nby grouping), and font sizes over WebRender's glyph rasterization limit.\nFeatures that only the text painting code can detect (unserializable fonts,\n-webkit-text-stroke, SVG and COLR glyphs) are reported by the TextDrawTarget\nand handled by recording everything under a DisplayListBuilder save point.\n\nThe blob grouping code asks DisplaySVGText::ShouldBeActive, which is a dry\nrun of the same code with the commands discarded afterwards. Active text\ntherefore pays for two text painting passes; caching the result per paint is\nleft as a follow up once the approach has proven itself.\n\nDisplaySVGText moves to the header so that WebRenderCommandBuilder can call\nit. TextDrawTarget gains SetBounds so that one instance can serve several\nruns with different bounds.\n\nGated behind gfx.webrender.svg-text, off by default. With the pref on,\nlayout/reftests/svg/text/text-shadow and dynamic-text-shadow differ from\ntheir reference by one color unit on 25 pixels (the reference text is now\ndrawn by WebRender while the shadowed test text stays in the blob).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325275\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/generic/TextDrawTarget.h", "layout/reftests/svg/webrender/reftest.list", "layout/reftests/svg/webrender/text-simple.svg", "layout/svg/SVGTextFrame.cpp", "layout/svg/SVGTextFrame.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b3a2850c51ca2a93922ff9e1251f7476b51b2eb9", "git_parents": ["fb7eb87dc5c59944d596a9f6a13d315d8caee712"], "node": "b47a4b82c9c64ba1ec18ff4a6dabb9c52629fe87", "parents": ["ed82320ec287409433c74351932dca52f865ffc6"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Draw SVG text with a translucent fill using WebRender text primitives. r=gfx-reviewers,lsalzman\n\nShouldRenderAsPath sends text with fill-opacity below 1 through the path\nbased painter so that overlapping glyphs blend once. WebRender text applies\nthe color per glyph, which is the same behavior HTML text with a translucent\ncolor has, so with gfx.webrender.svg-text.fill-opacity on such text is\naccepted by the WebRender path as long as it has no stroke, no shadow and no\ntext decorations.\n\nDecorations are excluded because nsTextFrame paints them with the fill color\nbut without fill-opacity, so they would come out opaque. Opaque fills are not\naffected since the fill color is then the right decoration color. The new\nreftest covers decorations together with the translucent fills.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325276\n", "files": ["layout/reftests/svg/webrender/reftest.list", "layout/reftests/svg/webrender/text-opacity-decorations.svg", "layout/svg/SVGTextFrame.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "04053be1ffe7c457f247dfb67ebbf74889b10ce8", "git_parents": ["b3a2850c51ca2a93922ff9e1251f7476b51b2eb9"], "node": "8f527e2681dbdb36696ba2b8571a94414bd480c6", "parents": ["b47a4b82c9c64ba1ec18ff4a6dabb9c52629fe87"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Draw gradient fills on simple SVG shapes with WebRender gradients. r=layout-reviewers,dshin\n\nSVGGradientFrame::GetWebRenderGradient resolves the stops (following href\nchains, applying stop-opacity and the graphic opacity, interpolating in\nlinearRGB when color-interpolation asks for it) and maps the gradient\ngeometry to the user space of the painted frame through the same\nobjectBoundingBox and gradientTransform matrix that the Skia path uses.\n\nA linear gradient is mapped by transforming its two end points, which is\nonly valid when the lines of constant color stay perpendicular to the\nvector; other transforms make the gradient fall back to the blob. A radial\ngradient becomes a WebRender radial gradient with elliptical radii under an\naxis aligned scale, or a circular one under a similarity; focal points and\nskews fall back. spreadMethod=\"reflect\" is expressed as a repeating\ngradient over twice the vector with mirrored stops. Degenerate gradients\n(no stops, one stop, zero length vector) become a solid fill like they do\nin GetPaintServerPattern.\n\nSVGGeometryFrame::CreateWebRenderCommands uses this for fills whose paint\nserver is a gradient. Rounded shapes clip the gradient with a rounded rect\nclip. Gradient strokes stay in the blob.\n\nGated behind gfx.webrender.svg-shapes.gradients, off by default. With the\npref on, paint-order-02 differs from its reference by anti-aliasing only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325278\n", "files": ["layout/reftests/svg/webrender/reftest.list", "layout/reftests/svg/webrender/shapes-gradients.svg", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGradientFrame.cpp", "layout/svg/SVGGradientFrame.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a9fcfe1d00e45981da1d73f6d3dcd579169c5043", "git_parents": ["04053be1ffe7c457f247dfb67ebbf74889b10ce8"], "node": "dc8af46e61ac6845a3910589b92d40497ef3bb1b", "parents": ["8f527e2681dbdb36696ba2b8571a94414bd480c6"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Express trivial clip-path: url() references as native WebRender clips. r=layout-reviewers,emilio\n\nSVGClipPathFrame::GetSimpleClipShape recognizes a trivial \u003cclipPath\u003e whose\nsingle child is a rect, rounded rect, circle or ellipse and whose combined\nchild transform, clipPath transform and clipPathUnits mapping is an axis\naligned scale and translation. DetermineMaskUsage then reports such clips as\nsimple clip shapes and CreateSimpleClipRegion turns them into a WebRender\nrect or rounded rect clip instead of rasterizing an A8 mask image. The\nshape is mapped from the clipped frame's user space to the reference frame\nthe same way SVGIntegrationUtils positions mask painting.\n\nA box split into several fragments by line breaking, an ib-split, pagination\nor bidi resolution is excluded. A clipPathUnits=\"objectBoundingBox\" shape\nresolves against the union of those fragments and then has to be placed\nagainst each fragment's own origin, which a single rect or rounded rect clip\ncannot describe. DetermineMaskUsage is where that check belongs, because\nmIsSimpleClipShape has four consumers that all need the same answer: besides\nthe clip itself, GetCompositorHitTestInfo drops eIrregularArea for a simple\nclip shape, nsDisplayMasksAndClipPaths::CreateWebRenderCommands applies the\ninherited opacity, and IsItemProbablyActive lets the children decide\nactivity. Reporting false for a fragmented box keeps all four on the mask\npath. CreateSimpleClipRegion looks the clipPath up on\nFirstContinuationOrIBSplitSibling, which is what GetAndObserveClipPath\nrequires and what the other callers pass.\n\nInside SVG blob groups, IsItemProbablyActive treats a mask item with such a\nclip as free and lets its children decide the activity, instead of keeping\nthe subtree in the blob. This exercises CreateSimpleClipRegion for CSS basic\nshapes on SVG frames, which added the item's ToReferenceFrame() offset to a\nreference box that is already in the frame's user space; the offset now\nexcludes the frame's own position for SVG leaf frames.\n\nTwo prefs, both off by default: gfx.webrender.svg-simple-clips for the clip\nconversion and gfx.webrender.svg-mask-propagates-activity for the activity\nchange, since the latter changes layerization on its own.\n\nWith the clip pref on, the svg-integration clip-path-circle-* and\nclip-path-ellipse-* tests pass exactly because their references use\nurl(#clipPath) and now render the same way as the CSS shapes; their\nfuzzy-if(!useDrawSnapshot,...) annotations need a lower bound of 0 when the\npref is enabled.\n\nsimple-clips.svg covers the shapes that convert and the ones that stay mask\nimages, simple-clips-text.svg covers text in a natively clipped group, and\nsimple-clips-fragmented.html covers the fragmented cases. Each renders the\nsame file with the pref on and off, so they compare the native clip against\nthe blob image directly. The text test has its own, larger fuzz: on Windows\nthe WebRender text gets subpixel anti-aliasing while the blob text is\ngrayscale.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325279\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/painting/nsDisplayList.cpp", "layout/reftests/svg/webrender/reftest.list", "layout/reftests/svg/webrender/simple-clips-fragmented.html", "layout/reftests/svg/webrender/simple-clips-text.svg", "layout/reftests/svg/webrender/simple-clips.svg", "layout/svg/SVGClipPathFrame.cpp", "layout/svg/SVGClipPathFrame.h", "layout/svg/SVGUtils.cpp", "layout/svg/SVGUtils.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "000ff6cef5e0bf8a1d22376081c981004d41eb62", "git_parents": ["a9fcfe1d00e45981da1d73f6d3dcd579169c5043"], "node": "ea71b9242f9818bd05a74963647173cb8be12703", "parents": ["dc8af46e61ac6845a3910589b92d40497ef3bb1b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Add a mostly-active heuristic. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325280\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a32a72da55c1545648b6a1abdc4858d984ab6fe3", "git_parents": ["000ff6cef5e0bf8a1d22376081c981004d41eb62"], "node": "a869a320fbad7e1ccd3180beff37f2e5edb2d27a", "parents": ["ea71b9242f9818bd05a74963647173cb8be12703"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Don't assert on an SVG text stroke that paints nothing in the WebRender text path. r=firefox-svg-reviewers,longsonr\n\nSVGContextPaint::GetDrawMode sets GLYPH_STROKE for any stroke paint other\nthan \"none\", including a stroke whose width or whose opacity is zero and so\npaints nothing. ShouldRenderAsPath treats those two cases as not needing the\npath rendering route, so they reach the WebRender text path and trip its\nassertion that no stroke gets that far. zero-stroke-01.svg, which strokes\ntext at stroke-width=\"0\", crashes debug builds with the WebRender SVG text\npref on.\n\nnsTextFrame strokes glyphs only for -webkit-text-stroke, and the text drawer\nrejects that separately, so the SVG stroke is simply not painted here. That\nmatches what the blob image path does with a zero width stroke, which also\ngoes through plain PaintText. Drop the assertion and record the invariant it\nwas trying to state in a comment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328063\n", "files": ["layout/svg/SVGTextFrame.cpp"], "git_node": "be18b4a3c1ad5fcedc6794941de9a59d1cd6b9c0", "git_parents": ["a32a72da55c1545648b6a1abdc4858d984ab6fe3"], "node": "3891d4911350198ca4221ef2554ccb5b3deca793", "parents": ["a869a320fbad7e1ccd3180beff37f2e5edb2d27a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Keep vertical text with a lengthAdjust scale in the blob image. r=firefox-svg-reviewers,longsonr\n\nlengthAdjust=\"spacingAndGlyphs\" scales the glyphs along the inline axis only,\nso the run transform that TextRenderedRun hands out is a non-uniform scale.\nSideways vertical glyphs reach WebRender already transposed, through the\nTRANSPOSE and FLIP glyph flags that gfxFont sets for a text drawer, and\nWebRender folds the run transform in after that transpose. The scale\ntherefore lands on the glyph's cross axis: the glyphs come out squashed\nacross the baseline instead of along it, and the run overflows the box the\ntest covers.\n\nReject the combination so those runs stay in the blob image, where the\nrotation is applied to the draw target instead and the order works out.\nHorizontal text is unaffected: with no transpose, a non-uniform run scale\ncomposes correctly.\n\nFixes lengthAdjust-vertical.svg and lengthAdjust-large-font-vertical.svg with\nthe WebRender SVG text pref on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328064\n", "files": ["layout/svg/SVGTextFrame.cpp"], "git_node": "2e537a78fd1fc6132e8ccd3d00ebd8afbab7c468", "git_parents": ["be18b4a3c1ad5fcedc6794941de9a59d1cd6b9c0"], "node": "db50d271f52d01ae1f910067e3fae94af1e03adc", "parents": ["3891d4911350198ca4221ef2554ccb5b3deca793"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Anti-alias the WebRender borders and gradients that SVG shapes push. r=gfx-reviewers,gw\n\nPushRect takes a flag that sets PrimitiveFlags::ANTIALISED, which tells\nWebRender to resolve the primitive's edges in the shader and to snap nothing\n- neither the primitive rect nor its clips. The stroke borders and the\ngradient fills that SVG shapes push had no such flag, so a stroke or a\ngradient whose edges fall between device pixels was moved onto the grid while\nthe plain rect fill beside it was not. The stroked rect in\nnon-scaling-stroke-01-ref.svg came out crisp where the same geometry drawn by\nthe blob image is anti-aliased, and a gradient rendered under a rotation\n(where WebRender has no snapping transform and so snaps nothing) disagreed\nwith itself under the identity transform.\n\nPlumb the flag through wr_dp_push_border, wr_dp_push_linear_gradient and\nwr_dp_push_radial_gradient, and set it on the stroke border and the gradient\nfills in SVGGeometryFrame, where it follows ShouldAntiAlias as the rect fill\nalready does. Every other caller keeps the previous behaviour.\n\nRounded shape fills deliberately stay as they were. Their curve is\nanti-aliased by the border shader regardless, and the device pixel snapping\nis what makes their cached corner textures composite exactly: taking it away\nresampled the corners and moved circle and rounded rect edges by a fraction\nof a pixel, which showed up in mask-opacity-02 to -05,\nrect-with-rx-and-ry-01, patterned-svg-under-transformed-html-01, the\nfilter-marked-line family and the as-image tests.\n\nAn anti-aliased border also opts out of the border thickness snapping in\nNormalBorderData::update. That snapping gives a CSS border an even\nwhole-pixel thickness on each side (bug 1258112, bug 1950029), but an SVG\nstroke width is geometry that has to stay exact: rounding a 3.33 device pixel\nstroke to 3 shifts its inner edge by a third of a pixel. The corner radius\nsnapping still applies, since it is about sampling the cached corner texture\nrather than about where the border's edges are.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328065\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "layout/svg/SVGGeometryFrame.cpp"], "git_node": "0e20ebb64e2b17da69c39a6177b540a468e4b937", "git_parents": ["2e537a78fd1fc6132e8ccd3d00ebd8afbab7c468"], "node": "ea2da4373b392d361a9f3c5b3c6db423886027d4", "parents": ["db50d271f52d01ae1f910067e3fae94af1e03adc"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070993 - Keep the anti-aliased edges of decomposed linear gradients. r=gfx-reviewers,lsalzman\n\nAxis-aligned linear gradients that are split into two-stop segment quads\ndropped the primitive's aligned AA edges, so the outer edges of an\nANTIALISED gradient were rounded to the pixel grid. This path runs for\ngradients under 256 pixels only when dithering is on, which made SVG\ngradient fills differ between hardware and software WebRender.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332091\n", "files": ["gfx/wr/webrender/src/prepare.rs", "gfx/wr/wrench/reftests/gradient/linear-decomposed-antialiased.yaml", "gfx/wr/wrench/reftests/gradient/linear-decomposed-antialiased_ref.yaml", "gfx/wr/wrench/reftests/gradient/reftest.list"], "git_node": "867b94c52d375ae734aafeb412cbb28355c73082", "git_parents": ["0e20ebb64e2b17da69c39a6177b540a468e4b937"], "node": "bfc619a499414971cd53b75d4195324076b5d04e", "parents": ["ea2da4373b392d361a9f3c5b3c6db423886027d4"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2070993: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/webrender_bindings/WebRenderAPI.h", "layout/svg/SVGGeometryFrame.cpp"], "git_node": "f6d1a646d16706d37f0f60b5c94d2e3b8395bea1", "git_parents": ["867b94c52d375ae734aafeb412cbb28355c73082"], "node": "b7afb0e60a503e130147a4eaa919f68d952386af", "parents": ["bfc619a499414971cd53b75d4195324076b5d04e"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081025 - Update PDF.js to e1412d3a540bec075b58c01853e1d85f45f7e841 r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333087\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "5a995f95e3154a1b45b464a4a120a683df8c720e", "git_parents": ["f6d1a646d16706d37f0f60b5c94d2e3b8395bea1"], "node": "f6d2e43bd3d9839ef517cb3ecdab72223eebc3d0", "parents": ["b7afb0e60a503e130147a4eaa919f68d952386af"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077960 - Add explicit support for Unicode paths to the crash helper r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332022\n", "files": ["toolkit/crashreporter/crash_helper/crashhelper.cpp", "toolkit/crashreporter/crash_helper/moz.build", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/mach.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/windows.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_server/cbindgen.toml", "toolkit/crashreporter/crash_helper_server/src/breakpad_crash_generator.rs", "toolkit/crashreporter/crash_helper_server/src/lib.rs", "toolkit/crashreporter/crash_helper_server/src/platform/unix.rs", "toolkit/crashreporter/crash_helper_server/src/platform/windows.rs", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "6b22228dd79736fd6dd6eeba880beae973592fc9", "git_parents": ["5a995f95e3154a1b45b464a4a120a683df8c720e"], "node": "bb4f1731a04c30a7157f59396cf1ce2ea5ded4b3", "parents": ["f6d2e43bd3d9839ef517cb3ecdab72223eebc3d0"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071908 - Add test coverage for the creditCards.storage.rust.enabled pref r=joschmidt,credential-management-reviewers\" for causing bc failures @ creditCard/browser_creditCard_doorhanger_cvv.js\n\nThis reverts commit 49623293c507659b11ff75232dc74310ee41662f.\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_creditCard_migration.js", "browser/extensions/formautofill/test/browser/browser_creditCard_primaryPassword.js", "browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_form_removal.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_multiple_cc_number.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_decryption_failure.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_display.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_fill_cancel_login.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_submission_autodetect_type.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_submission_normalized.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser.toml", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_autofill_creditCard_expiry.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_autofill_creditCard_name.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_autofill_creditCard_type.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_creditCard_migration.js", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_creditCard_primaryPassword.js", "browser/extensions/formautofill/test/browser/rustCreditCard/head.js"], "git_node": "4d3f70b10fb1a997387b2b2ec889055a579a8de4", "git_parents": ["6b22228dd79736fd6dd6eeba880beae973592fc9"], "node": "5d79add120a20eb252bc836eb6c718447b961795", "parents": ["bb4f1731a04c30a7157f59396cf1ce2ea5ded4b3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2080975 - Keep failures of tests that will be retried as FAIL in resource usage profile markers. r=jcristau\n\nThe harnesses make expected match status when a test will be retried, so the\nfailure arrived looking like a todo() and became KNOWN-FAIL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333041\n", "files": ["testing/mochitest/runtests.py", "testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "4bfc772b4e156746e430284c9f263f522b175c26", "git_parents": ["4d3f70b10fb1a997387b2b2ec889055a579a8de4"], "node": "29caf1f5b8235826880264cd48d6d38d866a110b", "parents": ["5d79add120a20eb252bc836eb6c718447b961795"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Make MOZ_PROCESS_SAMPLING set the interval between process samples. r=releng-reviewers,ahal\n\nProcess sampling can have high overhead, so allow setting a different\nfrequency than that of the resource monitor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330468\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "4931f17e8be3a210a448d07d8e4770d8d3c26414", "git_parents": ["4bfc772b4e156746e430284c9f263f522b175c26"], "node": "b08714de74e00fc70179415cfcc7f57aac9536f8", "parents": ["29caf1f5b8235826880264cd48d6d38d866a110b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Record sampled processes that are still running when monitoring stops. r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330469\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "29a34f6c39f2d26e57fdf519ad3ca30bd51f1fa6", "git_parents": ["4931f17e8be3a210a448d07d8e4770d8d3c26414"], "node": "5db41f5585fd35387f7d59f7a84b0eb5bae42906", "parents": ["b08714de74e00fc70179415cfcc7f57aac9536f8"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Fix ruff string-formatting warnings in resourcemonitor.py. r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332110\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py"], "git_node": "7157f0c734f1ae563f2715dca6d1810654ca7d87", "git_parents": ["29a34f6c39f2d26e57fdf519ad3ca30bd51f1fa6"], "node": "0cc4cd8697d655d91d73a27f9506b9174d9ab8ef", "parents": ["5db41f5585fd35387f7d59f7a84b0eb5bae42906"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079996 - [wdspec] Skip unhandled_prompt_behavior/file/ignore.py on ccov r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332962\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/session/capabilities/unhandled_prompt_behavior/file/ignore.py.ini"], "git_node": "a51952056c116af167caa40793ab793287c48f51", "git_parents": ["7157f0c734f1ae563f2715dca6d1810654ca7d87"], "node": "a4051b8f6e36794cde249b6c385d7a1c667f7c0d", "parents": ["0cc4cd8697d655d91d73a27f9506b9174d9ab8ef"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2066466: Ensure we don't enter uninit until init has completed. r=jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332826\n", "files": ["browser/components/profiles/tests/unit/test_datastore_uninit_during_init.js", "browser/components/profiles/tests/unit/xpcshell.toml", "toolkit/profile/ProfilesDatastoreService.sys.mjs"], "git_node": "381d59c0342ed74c480551bf052bb420e081bb60", "git_parents": ["a51952056c116af167caa40793ab793287c48f51"], "node": "38623e0d6d313c6f648418acd4b27e48370072b1", "parents": ["a4051b8f6e36794cde249b6c385d7a1c667f7c0d"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2074651: Normalize URIs before checking against site policies. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328555\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies.js", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies_container.js", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs", "toolkit/components/enterprisepolicies/SitePolicyUtils.sys.mjs"], "git_node": "fe0e09025a19496a2e4222d2b5d784bd9aa4b3e7", "git_parents": ["381d59c0342ed74c480551bf052bb420e081bb60"], "node": "d02fb7ef77e0128b7e6518321d7103164276b497", "parents": ["38623e0d6d313c6f648418acd4b27e48370072b1"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2081114 - Free the wrong-color glyph atlas in GetGlyphAtlas (Coverity CID 1524574) r=jfkthame\n\nGetGlyphAtlas takes the cached atlas out of gGlyphAtlas. When its color\ndoes not match, it builds a new atlas and deletes whatever is left in the\nglobal, which is normally the null it stored itself. The old atlas and\nits surface were therefore leaked each time the missing-glyph color\nchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333144\n", "files": ["gfx/thebes/gfxFontMissingGlyphs.cpp"], "git_node": "897e48f9de115b658604507cd6dd478889e352c7", "git_parents": ["fe0e09025a19496a2e4222d2b5d784bd9aa4b3e7"], "node": "84020b46eb532520e38bad260d8b7f85c0bd8d05", "parents": ["d02fb7ef77e0128b7e6518321d7103164276b497"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069135 - part 1, Share the AITab component telemetry name. r=omarg\n\nextract componentTypeName to be shared for consistent naming across telemetry\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332476\n", "files": ["browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/xpcshell/test_AITabUtils.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml"], "git_node": "9ce13896771e725aa05bd20e8fcd762acfdc931f", "git_parents": ["897e48f9de115b658604507cd6dd478889e352c7"], "node": "4927d91c2f196054abb40714f8a3d5eff4e34121", "parents": ["84020b46eb532520e38bad260d8b7f85c0bd8d05"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069135 - AITab [FE] - Telemetry for viewing tabs and actions r=omarg\n\nadd interaction events for opening, page view, click, delete. keep component type when rendering for links\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329058\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/actors/AITabChild.sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js"], "git_node": "fcd35df8d24dc751d0e2a0bdf4a890a6e26d9517", "git_parents": ["9ce13896771e725aa05bd20e8fcd762acfdc931f"], "node": "63766aece37031f93cb55ac78009a13b5a9cfb71", "parents": ["4927d91c2f196054abb40714f8a3d5eff4e34121"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075414 - Only AdoptChildSHEntry for static original frame src. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332836\n", "files": ["docshell/base/crashtests/2075414.html", "docshell/base/crashtests/crashtests.list", "docshell/base/nsDocShell.cpp", "testing/web-platform/tests/html/browsers/browsing-the-web/history-traversal/iframe-navigated-during-container-load.html", "testing/web-platform/tests/html/browsers/browsing-the-web/resources/navigates-iframe-in-load.html"], "git_node": "4293a0f611750b827ef0c4b1e506dc3dd569c3e1", "git_parents": ["fcd35df8d24dc751d0e2a0bdf4a890a6e26d9517"], "node": "87bcf6fc6afd1fa63c0252097b2b24a3126862f3", "parents": ["63766aece37031f93cb55ac78009a13b5a9cfb71"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Wayland] Add RenderWaylandTextureHost to hold external SHM buffers on Wayland r=gw\n\nImplement RenderWaylandTextureHost as SHM based texture host which supports external textures,\nit's used for direct mapping of SW decoded video frames.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331810\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/composite/TextureHost.h", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h", "gfx/webrender_bindings/RenderWaylandTextureHost.cpp", "gfx/webrender_bindings/RenderWaylandTextureHost.h", "gfx/webrender_bindings/moz.build"], "git_node": "554d455996c0826de726d9dc7067c5580807537e", "git_parents": ["4293a0f611750b827ef0c4b1e506dc3dd569c3e1"], "node": "129f96382c20f63992b8cadcf4eb0d924bcd769a", "parents": ["87bcf6fc6afd1fa63c0252097b2b24a3126862f3"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Linux] Return correct color depth by RenderDMABUFTextureHost r=gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331811\n", "files": ["gfx/webrender_bindings/RenderDMABUFTextureHost.h"], "git_node": "f8241ffe11ca675443116295b2304e974fc565a9", "git_parents": ["554d455996c0826de726d9dc7067c5580807537e"], "node": "a4f70b89fd212bf2a6d1c29a4ef8c90aae394eae", "parents": ["129f96382c20f63992b8cadcf4eb0d924bcd769a"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Linux] Remove direct dmabuf frames upload for HDR frames but use standard shm image path r=padenot,media-playback-reviewers\n\nRemove Linux specific hack and use standard SHM/custom buffer allocation for SW decoded frames.\nWe'll upload them to dmabuf later when we have real HW based GL context from WR compositor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331812\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.h"], "git_node": "16d575fa60558294ffb48b632b1d6068e04152a2", "git_parents": ["f8241ffe11ca675443116295b2304e974fc565a9"], "node": "a09a7582fc1081e4a172aec2ec51b5d18959e3fb", "parents": ["a4f70b89fd212bf2a6d1c29a4ef8c90aae394eae"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Linux] Remove direct buffer upload to DMABufSurface r=emilio,gtk-reviewers\n\nDirect upload of PlanarYCbCrData to DAMBufSurface is not used any more.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331813\n", "files": ["widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h"], "git_node": "728d1db310390afa11385cd901457523802ec71a", "git_parents": ["16d575fa60558294ffb48b632b1d6068e04152a2"], "node": "7d35860bf4501d83501d7301b2723b3ca7096962", "parents": ["a09a7582fc1081e4a172aec2ec51b5d18959e3fb"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071908 - Add test coverage for the creditCards.storage.rust.enabled pref r=joschmidt,credential-management-reviewers\n\nThe credit card counterpart of bug 2071837. rustCreditCard/browser.toml includes\ntest/browser/creditCard/ wholesale, so those tests and their skip-if annotations\nare inherited rather than copied; what it lists are the credit card tests living\nin test/browser/ instead, each a shim that loads its original. head.js asserts\nrust.active after the test, so nothing that clears it mid-run leaves a suite\npassing against JSON.\n\nNo xpcshell counterpart: those storage tests reach for sync APIs the Rust\nadapter does not answer or past the collection API into creditCards._data, and\ntest_getRecords.js resets the NSS token, which would take this store's key.\n\nCards are encrypted, which addresses are not, so six places that decrypted\nthrough OSKeyStore ask the collection instead, and creditcard.osKeystoreDecrypt\ngains an assertion beside each original. Skipped in the file, the include\nrunning the directory wholesale: browser_creditCard_cvv.js and a task each in\nbrowser_creditCard_capture_cvv.js and browser_creditCard_doorhanger_cvv.js, for\na security code the Rust schema has no column for; and\nbrowser_creditCard_decryption_failure.js, which re-keys the OS key store and so\nleaves this store's NSS key alone.\n\nbrowser_creditCard_migration.js and browser_creditCard_primaryPassword.js move\nout to test/browser/, covering the Rust store itself rather than re-running a\ntest under a pref; the migration's fixtures gain a 15-digit card, so the rebuilt\nmask and derived fields are asserted against a record the migration copied.\n\nEverything under test/browser/rustCreditCard/ is a second run of a test that\nlives elsewhere, so it can be deleted whole once the Rust store is the only one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326174\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_creditCard_migration.j