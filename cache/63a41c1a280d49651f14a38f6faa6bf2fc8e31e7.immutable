ty/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "58f4bb32b4cbdc4b4a130e15f9833488dbfa8e2a", "git_parents": ["5cf4a585c0befc28b9e276f9075c9a5b07607106"], "node": "9c2821b17a22bb8add36994db7553ef115340505", "parents": ["0f77526118e734a6541da21baddf6f11eeeb23cb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from c246fef6f3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c246fef6f336f36d4861ade1d198b9a279d2b47e\n    build vp9_frame_buffer_pool_unittest only when vp9 is enabled\n\n    It fails to compile when vp9 is disabled because vp9_frame_buffer_pool\n    itself is not built without vp9\n\n    Bug: None\n    Change-Id: I5822aa35003a53ef036d5a6c56a3715916a8b628\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505180\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48695}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0140.patch"], "git_node": "b28487b470463ea6cde25bb3e36494fafb65510e", "git_parents": ["58f4bb32b4cbdc4b4a130e15f9833488dbfa8e2a"], "node": "e696ca2828264d7ede4bcd5d634eaf8dca7dd242", "parents": ["9c2821b17a22bb8add36994db7553ef115340505"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 10d1c51150\n\nUpstream commit: https://webrtc.googlesource.com/src/+/10d1c51150cd44e69a909a58efdae42d2e47ad84\n    Turn modules_unittests into a rtc_test_suite\n\n    Number of tests triggered by modules_unittests on Linux.\n    before the commit: 715 tests\n    after the commit: 781 tests\n\n    This is because loss_based_bwe_v2_test and packet_arrival_map_test are currently missing from CI.\n\n    Change-Id: I8ff76b65b28ad5b2fe6448f50efe549149bacc71\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505122\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48696}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/BUILD.gn", "third_party/libwebrtc/modules/audio_device/BUILD.gn", "third_party/libwebrtc/modules/audio_mixer/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/goog_cc/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/pcc/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/rtp/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/scream/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/scream/test/BUILD.gn", "third_party/libwebrtc/modules/pacing/BUILD.gn", "third_party/libwebrtc/modules/remote_bitrate_estimator/BUILD.gn", "third_party/libwebrtc/modules/sframe/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch"], "git_node": "1a0442b805b09b1533e7630530288fec3338e323", "git_parents": ["b28487b470463ea6cde25bb3e36494fafb65510e"], "node": "098774c17b1ca5c2c5cfa0fb3215cc2cbad30374", "parents": ["e696ca2828264d7ede4bcd5d634eaf8dca7dd242"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from d354a0dda4\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d354a0dda4a61dd0ab25ced9b1a445b39a2cb54f\n    Protect against late encode tasks after VideoStreamEncoder has been stopped\n\n    Since encode tasks may be delayed via asynchronous readback, they sometimes\n    can happen after VideoStreamEncoder::Stop has finished running on the encoder\n    queue.\n\n    Bug: chromium:397485312\n    Change-Id: I3768a0b20b51b787b8224d81349c2dd3188351be\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505121\n    Auto-Submit: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48697}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0067.patch", "third_party/libwebrtc/moz-patch-stack/s0101.patch", "third_party/libwebrtc/moz-patch-stack/s0130.patch", "third_party/libwebrtc/video/video_stream_encoder.cc", "third_party/libwebrtc/video/video_stream_encoder.h", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc"], "git_node": "174eaefcf20e63e0b4732eacd7c433ec18ae15e8", "git_parents": ["1a0442b805b09b1533e7630530288fec3338e323"], "node": "8c1605975441a6af538d162101e3ead4e4d3a284", "parents": ["098774c17b1ca5c2c5cfa0fb3215cc2cbad30374"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 1db151dec0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1db151dec016f0b265274afff88b113e1b94d3e3\n    Roll chromium_revision cc826fc259..b8d3e2cdc8 (1703340:1703496)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/cc826fc259..b8d3e2cdc8\n    Full diff: https://chromium.googlesource.com/chromium/src/+/cc826fc259..b8d3e2cdc8\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/85497c09eb..cb914350af\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/f1b78ef3a0..511d567e01\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/8cbf49dbe4..583f54d6ec\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/57206d9af6..74894df59b\n    * src/third_party/android_deps/autorolled/cipd: PGrFTGKTyIng0-Xv1DGdPSEXFtstUFrMSfQ-YfZYsoMC..e7aoXq5qJ1JaNWqkfWbSIRGVW6d_Eb0_eBXx8NEckdQC\n    * src/third_party/androidx/cipd: 0LRTx3XriodsH8TrCMp_bc21hJF3LdLJAclcV5uCPdEC..goLLYrbZhmNxvNT0wtMn1UTH7KT66r4QUESzyC3IdiQC\n    * src/third_party/grpc/src: https://chromium.googlesource.com/external/github.com/grpc/grpc.git/+log/eef57557d7..7fcce3b7b7\n    * src/third_party/perfetto: https://chromium.googlesource.com/external/github.com/google/perfetto.git/+log/aa8f09763d..12115cb265\n    * src/tools: https://chromium.googlesource.com/chromium/src/tools/+log/ca5f1babbc..155c581e13\n    Removed dependencies\n    * src/third_party/android_deps/cipd/libs/com_google_android_apps_common_testing_accessibility_framework_accessibility_test_framework\n    * src/third_party/android_deps/cipd/libs/com_googlecode_java_diff_utils_diffutils\n    * src/third_party/android_deps/cipd/libs/net_bytebuddy_byte_buddy\n    * src/third_party/android_deps/cipd/libs/net_bytebuddy_byte_buddy_agent\n    * src/third_party/android_deps/cipd/libs/org_ccil_cowan_tagsoup_tagsoup\n    * src/third_party/android_deps/cipd/libs/org_jsoup_jsoup\n    * src/third_party/android_deps/cipd/libs/org_mockito_mockito_android\n    * src/third_party/android_deps/cipd/libs/org_mockito_mockito_core\n    * src/third_party/android_deps/cipd/libs/org_mockito_mockito_subclass\n    * src/third_party/android_deps/cipd/libs/org_objenesis_objenesis\n    DEPS diff: https://chromium.googlesource.com/chromium/src/+/cc826fc259..b8d3e2cdc8/DEPS\n\n    BUG=None\n\n    Change-Id: I6d236792078efe4533de4aee52e9b389ddebc890\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505200\n    Bot-Commit: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48698}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "e5a178166dc343bad90e73ac9578ff3adfa9ed73", "git_parents": ["174eaefcf20e63e0b4732eacd7c433ec18ae15e8"], "node": "4aa3608cbbe7db606a87f5851aa4703c7702f85a", "parents": ["8c1605975441a6af538d162101e3ead4e4d3a284"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from af859639f9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/af859639f9f4de19773c3ea972aebbb68dad8bb8\n    Enable WebRTC-MediaTaskQueuePriorities by default\n\n    Media task queues benefit from dedicated audio and video thread\n    priorities (TaskQueueFactory::Priority::kAudio and kVideo) for improved\n    platform-specific thread scheduling. Following experiment evaluation\n    (see http://shortn/_Ws8YvA2wqM), enable the media task queue priorities\n    by default while retaining the field trial as a killswitch.\n\n    - Switch WebRTC-MediaTaskQueuePriorities checks from IsEnabled() to\n      !IsDisabled() so it remains disable-able.\n    - Apply kAudio priority by default to AudioEncoderQueue in ChannelSend.\n    - Apply kVideo priority by default to VideoEncoderQueue,\n      VideoDecoderQueue, IncomingVideoStreamQueue, and\n      VideoFrameTransformerQueue.\n\n    Bug: chromium:470337728\n    Change-Id: I56cbea4350d323f935bfbd99762e58a02ed52b41\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505220\n    Commit-Queue: Markus Handell \u003chandellm@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48699}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/channel_send.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/s0029.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/moz-patch-stack/s0069.patch", "third_party/libwebrtc/video/render/incoming_video_stream.cc", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_send_stream_impl.cc"], "git_node": "69fda1f229243c4a7b42f2dfd8252d321f9b1dee", "git_parents": ["e5a178166dc343bad90e73ac9578ff3adfa9ed73"], "node": "9896e1faa3718f05eec5f36f3dc07421444a34b6", "parents": ["4aa3608cbbe7db606a87f5851aa4703c7702f85a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from ae68e810ea\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ae68e810eaf381a5640cb0fecbb5bd379a575bf3\n    Update WebRTC code version (2026-09-24T04:06:53).\n\n    Bug: None\n    Change-Id: I3d31120167a72a79407e99441c606dbf55740043\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505280\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48700}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "280f706484c7a7429b8ec7a2e6ca3441558b49fb", "git_parents": ["69fda1f229243c4a7b42f2dfd8252d321f9b1dee"], "node": "fed124deeb1fac0f526fc92fa177f07b12c387f4", "parents": ["9896e1faa3718f05eec5f36f3dc07421444a34b6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from d387b14b6e\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in ae1e16c7bc.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d387b14b6e90861565fc8bc064110877d5ae7f95\n    [[deprecated]] PeerConnectionFactoryDependencies::worker_thread\n\n    Marks PeerConnectionFactoryDependencies::worker_thread as [[deprecated]]\n    so that applications that still supply a worker thread get a compile\n    time warning before the dedicated worker_thread configuration becomes a\n    fatal error.\n\n    Internal readers of the member (the ConnectionContext constructor and\n    the legacy CreatePeerConnectionFactory overload) suppress the warning\n    with a new RTC_PUSH/POP_IGNORING_WDEPRECATED_DECLARATIONS macro pair,\n    and the remaining in-tree tests that assigned the member (always to the\n    same thread as the network thread) no longer do so.\n\n    See https://groups.google.com/g/discuss-webrtc/c/Fs_Hd5XNJh0 for more\n    details.\n\n    Bug: webrtc:558821261\n    Change-Id: Iab47a93adf760e17f0224b17b731613e49c92913\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/502940\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48701}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/ae1e16c7bc.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch"], "git_node": "7f468591a6c047b23ae48180063cf196e8b8c3d7", "git_parents": ["280f706484c7a7429b8ec7a2e6ca3441558b49fb"], "node": "ee7284c0e11e0cd04731d6978b3b6b444bc99f98", "parents": ["fed124deeb1fac0f526fc92fa177f07b12c387f4"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from bfeecbf072\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bfeecbf072ede242da8d528618bdef8d294c5209\n    Switch the below target from rtc_test to rtc_test_suite\n\n    * video_timing_tests\n    * system_wrappers_unittests\n    * rtc_stats_unittests\n\n    Change-Id: If3c26fc245a207220cee2885416b5ba83d8e2912\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/504884\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48702}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/stats/BUILD.gn", "third_party/libwebrtc/system_wrappers/BUILD.gn", "third_party/libwebrtc/video/timing/BUILD.gn", "third_party/libwebrtc/video/timing/simulator/BUILD.gn", "third_party/libwebrtc/video/timing/simulator/test/BUILD.gn"], "git_node": "edf14de968782d5582580b773590ea42e7e84779", "git_parents": ["7f468591a6c047b23ae48180063cf196e8b8c3d7"], "node": "42d76e58534148c422c5ef33308a1f172dbc5885", "parents": ["ee7284c0e11e0cd04731d6978b3b6b444bc99f98"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from ae1e16c7bc\n\nWe already cherry-picked this when we vendored d387b14b6e.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ae1e16c7bcb1390e1a552c704dfefa70c67f84a7\n    Revert \"[[deprecated]] PeerConnectionFactoryDependencies::worker_thread\"\n\n    This reverts commit d387b14b6e90861565fc8bc064110877d5ae7f95.\n\n    Reason for revert: Chromium targets need to be updated\n\n    Failure Link:\n    https://chromium-review.googlesource.com/c/chromium/src/+/8459322\n\n    Original change's description:\n    \u003e [[deprecated]] PeerConnectionFactoryDependencies::worker_thread\n    \u003e\n    \u003e Marks PeerConnectionFactoryDependencies::worker_thread as [[deprecated]]\n    \u003e so that applications that still supply a worker thread get a compile\n    \u003e time warning before the dedicated worker_thread configuration becomes a\n    \u003e fatal error.\n    \u003e\n    \u003e Internal readers of the member (the ConnectionContext constructor and\n    \u003e the legacy CreatePeerConnectionFactory overload) suppress the warning\n    \u003e with a new RTC_PUSH/POP_IGNORING_WDEPRECATED_DECLARATIONS macro pair,\n    \u003e and the remaining in-tree tests that assigned the member (always to the\n    \u003e same thread as the network thread) no longer do so.\n    \u003e\n    \u003e See https://groups.google.com/g/discuss-webrtc/c/Fs_Hd5XNJh0 for more\n    \u003e details.\n    \u003e\n    \u003e Bug: webrtc:558821261\n    \u003e Change-Id: Iab47a93adf760e17f0224b17b731613e49c92913\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/502940\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48701}\n\n    Bug: webrtc:558821261\n    No-Presubmit: true\n    No-Tree-Checks: true\n    No-Try: true\n    Change-Id: Id9e2f4c55ad1c3efbc9d0f4a1b54ff7b573a1601\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505320\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48703}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/ae1e16c7bc.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch"], "git_node": "8563f74e75579f376eaff064581ebc32bb2189e2", "git_parents": ["edf14de968782d5582580b773590ea42e7e84779"], "node": "f1e44bba02e820997a67cd730308d3a3eb54b482", "parents": ["42d76e58534148c422c5ef33308a1f172dbc5885"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from c88c2392e0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c88c2392e0861d2cff21c3d205ab5c39dcfafa9e\n    Preserve ICE role on subsequent local answer without ICE restart\n\n    In CL 426661, the explicit ICE role initialization state was removed\n    from JsepTransportController under the assumption that\n    ICEROLE_CONTROLLING indicates the uninitialized state.\n\n    That assumption breaks when the initial offerer later applies a local\n    answer during renegotiation without an ICE restart: the current role is\n    still controlling, so it is incorrectly changed to controlled.\n\n    Track role initialization explicitly for each ICE session. Preserve the\n    role across non-restart renegotiations, and reset the initialization\n    state when changed local ICE credentials indicate a restart and\n    redetermine_role_on_ice_restart is enabled.\n\n    Add coverage for caller and callee renegotiation without an ICE restart,\n    and for role redetermination when a controlled agent initiates an ICE\n    restart.\n\n    Bug: webrtc:488980789, webrtc:360058654\n    Change-Id: I8ac3be37dbd7590b2cc8aea1f6bd44525d6e5499\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/504101\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48704}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/jsep_transport_controller.cc", "third_party/libwebrtc/pc/jsep_transport_controller.h", "third_party/libwebrtc/pc/jsep_transport_controller_unittest.cc"], "git_node": "6db73f13ff6f088babe0ee0538458302089275e0", "git_parents": ["8563f74e75579f376eaff064581ebc32bb2189e2"], "node": "38c1fa2bcf25374e3cbcbd137c3b622f3f955e44", "parents": ["f1e44bba02e820997a67cd730308d3a3eb54b482"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077266 - Vendor libwebrtc from 5620a259ed\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5620a259eda8c754abcaff4aa6179b4fd94bada6\n    Roll chromium_revision b8d3e2cdc8..80137986d5 (1703496:1704109)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/b8d3e2cdc8..80137986d5\n    Full diff: https://chromium.googlesource.com/chromium/src/+/b8d3e2cdc8..80137986d5\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/cb914350af..968af5e6c5\n    * src/buildtools/linux64: git_revision:127dd2a6d582528d6d61c4d838dc17385ef31abd..git_revision:56c22442ee369ddc6f44c2ff5e0664d47a3c6b0e\n    * src/buildtools/mac: git_revision:127dd2a6d582528d6d61c4d838dc17385ef31abd..git_revision:56c22442ee369ddc6f44c2ff5e0664d47a3c6b0e\n    * src/buildtools/win: git_revision:127dd2a6d582528d6d61c4d838dc17385ef31abd..git_revision:56c22442ee369ddc6f44c2ff5e0664d47a3c6b0e\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/511d567e01..d7c3980a9f\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/583f54d6ec..c542c3898c\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/74894df59b..5079f996a8\n    * src/third_party/android_build_tools/lint/cipd: cnU8eI5jfA4xSSGKDSSk7kWQge5gcKBCboYSoGfM-K8C..hlge2bvrew-6bOssoVOamzqfzaF3I8BRw5Y4BK8TREkC\n    * src/third_party/android_build_tools/manifest_merger/cipd: gF2ValQlfEtIWSS_qKWdhiVP357RpQnsuzJgy7SLBM4C..O0KQQ1A1r1qMudJFEkycDqz-hab-YkLj97zZJD-UdUoC\n    * src/third_party/android_deps/autorolled/cipd: e7aoXq5qJ1JaNWqkfWbSIRGVW6d_Eb0_eBXx8NEckdQC..cAIV9KhFHhVi86frHZTKiaGYkbGSn1bRoxYkD1NWyI4C\n    * src/third_party/android_sdk/public: WhtP32Q46ZHdTmgCgdauM3ws_H9iPoGKEZ_cPggcQ6wC..JsUGMsJK2pkQxVKr7EcJbxbwjJEIWjEPLqcbv7ifdmcC\n    * src/third_party/androidx/cipd: goLLYrbZhmNxvNT0wtMn1UTH7KT66r4QUESzyC3IdiQC..1k7M-khGB8Hv020Vpfh8eyIVwYjKN0wSzkHEkyLzRPgC\n    * src/third_party/boringssl/src: https://boringssl.googlesource.com/boringssl.git/+log/62fb8ab5bd..5fbad2285b\n    * src/third_party/catapult: https://chromium.googlesource.com/catapult.git/+log/30de54364b..1abb561557\n    * src/third_party/clang-format/script: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/clang/tools/clang-format.git/+log/7051008198..47dce8466c\n    * src/third_party/compiler-rt/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/compiler-rt.git/+log/7dc7227733..5296d7a681\n    * src/third_party/dav1d/libdav1d: https://chromium.googlesou