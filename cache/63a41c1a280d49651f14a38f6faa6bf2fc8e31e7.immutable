c2", "git_parents": ["f02fee17ed3b8f511c158d9b6e9bdddbdb1eff58"], "node": "db0d0e675c1a3136349a20b4a6696f7c29b6effa", "parents": ["83fd431ce9aabc6255918ab6ac9d8dd19d88aea1"], "tags": []}, {"author": "Matt Hargett \u003cplaztiksyke@gmail.com\u003e", "branch": "default", "desc": "Bug 2076950 [wpt PR 63124] - WebNN: preserve float16 subnormal values through value movement, a=testonly\n\nAutomatic update from web-platform-tests\nWebNN: preserve float16 subnormal values through value movement (#63124)\n\n* Add float16 subnormal transport conformance tests\n\n* Cover signed subnormal state across native dispatches\n--\n\nwpt-commits: a94f22900b2aad050d1fef8e88ca98644e9a1b12\nwpt-pr: 63124\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/float16-transport.https.any.js"], "git_node": "ad21bf7836566501e8f8d7cfdee4927a1f1b4fd6", "git_parents": ["34f1cf0a87c112bf855c2d5e6f1d38fad62583c2"], "node": "5ba1724ba5dc5b2aecf8efb6427dd3d701f3de67", "parents": ["db0d0e675c1a3136349a20b4a6696f7c29b6effa"], "tags": []}, {"author": "Matt Hargett \u003cplaztiksyke@gmail.com\u003e", "branch": "default", "desc": "Bug 2077021 [wpt PR 63146] - WebNN: test nearest resampling half-pixel coordinates, a=testonly\n\nAutomatic update from web-platform-tests\nTest nearest resampling half-pixel coordinates (#63146)\n--\n\nwpt-commits: be405ad7f99b2aee7efe1d4f40720d4335a510a3\nwpt-pr: 63146\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/resample2d-nearest-half-pixel.https.any.js"], "git_node": "f776bb9729021bb4300af6615d2f17755b985be9", "git_parents": ["ad21bf7836566501e8f8d7cfdee4927a1f1b4fd6"], "node": "aee755798c64fc3af1c9014c24e98366c3dd3aa9", "parents": ["5ba1724ba5dc5b2aecf8efb6427dd3d701f3de67"], "tags": []}, {"author": "Matt Hargett \u003cplaztiksyke@gmail.com\u003e", "branch": "default", "desc": "Bug 2077029 [wpt PR 63149] - WebNN: cover small and zero reduceLogSum inputs, a=testonly\n\nAutomatic update from web-platform-tests\nWebNN: cover small and zero reduceLogSum inputs (#63149)\n\n* WebNN: cover small and zero reduceLogSum inputs\n\n* Clarify reduceLogSum intermediate precision assumption\n--\n\nwpt-commits: 1519af7faae30bb0ae0b995b1a39e1f36e48ab0b\nwpt-pr: 63149\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/reduce-log-sum-small-values.https.any.js"], "git_node": "df3376ea5be2dd0bb196826d42b1d2690a00f338", "git_parents": ["f776bb9729021bb4300af6615d2f17755b985be9"], "node": "b37e1988c381119ab7992d48859d9722b79b6ff3", "parents": ["aee755798c64fc3af1c9014c24e98366c3dd3aa9"], "tags": []}, {"author": "Matt Hargett \u003cplaztiksyke@gmail.com\u003e", "branch": "default", "desc": "Bug 2077040 [wpt PR 63151] - Fix WebNN binary16 helper rounding, a=testonly\n\nAutomatic update from web-platform-tests\nFix WebNN binary16 helper rounding (#63151)\n\n* Fix WebNN binary16 helper rounding\n\n* Clarify binary16 midpoint rounding condition\n\n* Use native Float16Array conversion in WebNN helpers\n--\n\nwpt-commits: b6fc3da9a0ca1550b836560a55e62293756ae16e\nwpt-pr: 63151\n", "files": ["testing/web-platform/tests/webnn/helper-validation.window.js", "testing/web-platform/tests/webnn/resources/utils.js"], "git_node": "53d48f05fab482dc94c142ff7f054336ddb2be99", "git_parents": ["df3376ea5be2dd0bb196826d42b1d2690a00f338"], "node": "00863adbbebd7f68c9dc873135dc171945368b3c", "parents": ["b37e1988c381119ab7992d48859d9722b79b6ff3"], "tags": []}, {"author": "Matt Hargett \u003cplaztiksyke@gmail.com\u003e", "branch": "default", "desc": "Bug 2077032 [wpt PR 63150] - WebNN: fix float16 ULP ordering and raw storage comparisons, a=testonly\n\nAutomatic update from web-platform-tests\nWebNN: fix float16 ULP ordering and raw storage comparisons (#63150)\n\n* Fix float16 ULP ordering and storage comparisons\n\n* Share signed floating-point ordering in WebNN helpers\n--\n\nwpt-commits: 7fd9e711b5f21f746c51af6509a1bb99a050a02f\nwpt-pr: 63150\n", "files": ["testing/web-platform/tests/webnn/helper-validation.window.js", "testing/web-platform/tests/webnn/resources/utils.js"], "git_node": "d07b50db752b53b8bf0cf0232d0ffeecf4161aec", "git_parents": ["53d48f05fab482dc94c142ff7f054336ddb2be99"], "node": "2ea12b600b661962793bcb5c9706cc931d789965", "parents": ["00863adbbebd7f68c9dc873135dc171945368b3c"], "tags": []}, {"author": "Yanling Wang \u003cyanlingwang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2081708 [wpt PR 63631] - [Masonry] Clamp child spans in grid-lanes subgrids, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Clamp child spans in grid-lanes subgrids\n\nThis CL clamps child spans to inherited tracks in grid-lanes subgrids\nbefore mapping them into ancestor coordinates. It matches regular\nGrid's bounds while preserving auto-placement and leaving standalone\naxes unchanged.\n\nBug: 343257585\nChange-Id: I23c72598acc5a71b9523baeb8160e57886174145\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8403795\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1718136}\n\n--\n\nwpt-commits: 6c316e69b2fb124e5603764f3034268607d6c62b\nwpt-pr: 63631\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-004a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-004a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-004a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-004a.html"], "git_node": "4e2968f93b763dcc79f8f28c67886b8ccdf3bbae", "git_parents": ["d07b50db752b53b8bf0cf0232d0ffeecf4161aec"], "node": "f890500702d60b6f952166caaf48d869dc79731c", "parents": ["2ea12b600b661962793bcb5c9706cc931d789965"], "tags": []}, {"author": "Francois Daoust \u003cfd@tidoust.net\u003e", "branch": "default", "desc": "Bug 2079224 [wpt PR 63327] - Update speculation-rules META.yml files, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate speculation-rules META.yml files\n\nThe root `META.yml` still referenced the WICG spec, which no longer exists and\nhas been partially upstreamed to HTML. This updates the link to associate the\ntests with the HTML spec.\n\nThis update also introduces two new `META.yml` files for the `prerender` and\n`prefetch` subfolders to associate them with the Prerendering and Prefetch\nspecs in WICG.\n\n--\n\nwpt-commits: 28f6fc31a9908e4cd2645827aea592a6df758b41\nwpt-pr: 63327\n", "files": ["testing/web-platform/tests/speculation-rules/META.yml", "testing/web-platform/tests/speculation-rules/prefetch/META.yml", "testing/web-platform/tests/speculation-rules/prerender/META.yml"], "git_node": "c5ad5ed9d69bc590a8c7bf2a166c9711a8259207", "git_parents": ["4e2968f93b763dcc79f8f28c67886b8ccdf3bbae"], "node": "b4f8cd9a35c3d67251174fe0bd622ce0d9c52147", "parents": ["f890500702d60b6f952166caaf48d869dc79731c"], "tags": []}, {"author": "Tim Nguyen \u003cntim@apple.com\u003e", "branch": "default", "desc": "Bug 2080447 [wpt PR 63483] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326920, a=testonly\n\nAutomatic update from web-platform-tests\nlight-dark() inside image-set() accepts a bare string as an image URL\n\nExclude RawStringAsURL when passing in the allowed images.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326920\n\n--\n\nwpt-commits: 4e38cef3f7e15234679a84faca4bf6689744d7ae\nwpt-pr: 63483\n", "files": ["testing/web-platform/tests/css/css-backgrounds/parsing/background-image-invalid.html", "testing/web-platform/tests/css/css-backgrounds/parsing/background-image-valid.html"], "git_node": "d486a7234f74f2244603ae085fb639772ab5bf77", "git_parents": ["c5ad5ed9d69bc590a8c7bf2a166c9711a8259207"], "node": "1615693c6b3f10add28dda5b61f62138ac401cb3", "parents": 