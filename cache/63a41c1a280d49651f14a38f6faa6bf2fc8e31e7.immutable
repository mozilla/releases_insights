00d7804\nte -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nth -\u003e 08ba6c5efaab334a66f766313533282a700d7804\ntl -\u003e 08ba6c5efaab334a66f766313533282a700d7804\ntr -\u003e 08ba6c5efaab334a66f766313533282a700d7804\ntrs -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nuk -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nur -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nuz -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nvi -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nwo -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nxh -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nzam -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nzh-CN -\u003e 08ba6c5efaab334a66f766313533282a700d7804\nzh-TW -\u003e 08ba6c5efaab334a66f766313533282a700d7804\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "a86e86f24621900c84b9387251f7ee4f9eae91b4", "git_parents": ["9c24ce6c8cc204dce8eadf8885443519a9d5a2cf"], "node": "ae87ca5ac3895d932856e67b6083f8389738a824", "parents": ["04dd6ebbbe078ac972812f38f92cfde0c53cc0ea"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074550 - Key start()/stop() off the in-flight activation, not the ACTIVATING state r=ip-protection-reviewers,rking\n\nupdateState() demotes ACTIVATING back to READY while an activation is still\nrunning, so a start() issued from that announcement opened a second activation\nand the two raced for the one channel filter.\n\nTrack the in-flight activation via #activatingPromise instead, clearing it\nbefore any state is announced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328886\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "beb4d0563c28f409fed45781f189fb37355254b3", "git_parents": ["a86e86f24621900c84b9387251f7ee4f9eae91b4"], "node": "9eee42b45a15f1f5f60b197c1d8d83ffda3d4325", "parents": ["ae87ca5ac3895d932856e67b6083f8389738a824"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066840 - Move proxy mode ownership into IPPProxyManager r=ip-protection-reviewers,rking\n\nIPPChannelFilter read browser.ipProtection.mode itself, so nothing could ask\nfor a connection in another mode. Moving this into ProxyManager, we can now ask for specific types\nof activations and the UI can check what mode we are in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325907\n", "files": ["toolkit/components/ipprotection/IPPChannelFilter.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/docs/Constants.md", "toolkit/components/ipprotection/docs/Preferences.md", "toolkit/components/ipprotection/tests/xpcshell/head.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPChannelFilter.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "68687343f0dce345bb9169a3541b410d3964cb59", "git_parents": ["beb4d0563c28f409fed45781f189fb37355254b3"], "node": "ca3cb4b3f8cd925befe903e3e3c9f48cff7b535a", "parents": ["9eee42b45a15f1f5f60b197c1d8d83ffda3d4325"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066842 - Let start() wait for the service instead of IPPEarlyStartupFilter r=ip-protection-reviewers,rking\n\nIPPEarlyStartupFilter was a hidden half-started state: traffic held behind a\nchannel filter with no activation the state machine knew about. ACTIVATING is\nthat state, but start() could only enter it once the service was READY. It now\nregisters the filter and waits in ACTIVATING for a service that may still\nbecome ready, so the helpers that built an early filter simply ask for the\nproxy, and updateState() leaves the state to an activation in flight.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328888\n", "files": ["toolkit/components/ipprotection/IPPAutoRestore.sys.mjs", "toolkit/components/ipprotection/IPPAutoStart.sys.mjs", "toolkit/components/ipprotection/IPPEarlyStartupFilter.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/IPPStartupCache.sys.mjs", "toolkit/components/ipprotection/IPProtectionService.sys.mjs", "toolkit/components/ipprotection/docs/Preferences.md", "toolkit/components/ipprotection/docs/StateMachine.md", "toolkit/components/ipprotection/enterprise/IPPAlwaysOn.sys.mjs", "toolkit/components/ipprotection/moz.build", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAlwaysOn.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "d016884eaa8d5f1e0b444487a4d74ea91e650245", "git_parents": ["68687343f0dce345bb9169a3541b410d3964cb59"], "node": "c54c30831647555e452977698a14adf772469b66", "parents": ["ca3cb4b3f8cd925befe903e3e3c9f48cff7b535a"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066842 - Decide desktop auto-activation in one component r=ip-protection-reviewers,rking\n\nIPPAutoStart and IPPAutoRestore both wanted full protection and differed only\nin what made them want it. IPPAutoActivation is the one owner, with\ndesiredMode() as the one decision, and full protection is owed once: cleared\non the ask, owed again when the service returns to READY. IPProtectionActivator\npicks the activation helper per build: this one on desktop, IPPAlwaysOn on\nenterprise, none on Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328889\n", "files": ["toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPAutoRestore.sys.mjs", "toolkit/components/ipprotection/IPPAutoStart.sys.mjs", "toolkit/components/ipprotection/IPProtectionActivator.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/enterprise/IPPAlwaysOn.sys.mjs", "toolkit/components/ipprotection/moz.build", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoRestore.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "1535ec7f1dd6149d9ccc31aa7769f70b5044f194", "git_parents": ["d016884eaa8d5f1e0b444487a4d74ea91e650245"], "node": "d56c427e1d99b5fb6b7c529f93a855c98fb11dd0", "parents": ["c54c30831647555e452977698a14adf772469b66"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066842 - Keep always-on sites covered through IPPAutoActivation r=ip-protection-reviewers,rking\n\nA site marked as always using the VPN was only proxied while the user\nhappened to have a connection up. desiredMode() now asks for inclusion mode\nwhile any rule provider holds an included site, so a match pattern counts the\nsame as an ipp-vpn permission. The reason is standing: the proxy going idle or\nthe rules changing asks again, and the last inclusion going away takes the\nnarrow connection down. IPPSiteRuleManager becomes a core helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328890\n", "files": ["browser/components/ipprotection/IPProtectionHelpers.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/IPProtectionActivator.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js", "toolkit/components/ipprotection/tests/xpcshell/test_MatchPatternPrefRule.js", "toolkit/components/ipprotection/tests/xpcshell/test_SiteRuleManager.js"], "git_node": "60046fa97e9c7809bdaf2ffafe9c896ebae170bb", "git_parents": ["1535ec7f1dd6149d9ccc31aa7769f70b5044f194"], "node": "9dec4b47c0a45c546eb40f9547f57b4e6bfde638", "parents": ["d56c427e1d99b5fb6b7c529f93a855c98fb11dd0"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079752 - Only count the toggle's own mode as protection being on in the panel r=ip-protection-reviewers,rking\n\nThe panel treated any active connection as the VPN being on, whatever mode\nit was in.\nNow it only counts the mode the toggle turns on.\nTurning it on while a narrower connection is up switches that connection's mode instead of\nstarting a second one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332877\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_confirmation_hints_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_toolbar.js", "browser/components/ipprotection/tests/browser/head.js", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs"], "git_node": "fa3edeb08ac38f71eabf2c57c5a96640f150c59c", "git_parents": ["60046fa97e9c7809bdaf2ffafe9c896ebae170bb"], "node": "9253c56fac1b83865833ae6ab864a7a3f64eadec", "parents": ["9dec4b47c0a45c546eb40f9547f57b4e6bfde638"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074850 - Avoid undefined fields in jemalloc_ptr_info_s default constructor r=pbone\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328511\n", "files": ["memory/build/mozjemalloc_types.h"], "git_node": "cafcf57f939259e3ce9d7458de03ed004173135a", "git_parents": ["fa3edeb08ac38f71eabf2c57c5a96640f150c59c"], "node": "038a169981c8e913a9d367230d79ee744f16de9c", "parents": ["9253c56fac1b83865833ae6ab864a7a3f64eadec"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080871 - Investigate hit-testing for view transitions in the sidebar to ensure clicks are actionable during animation r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332898\n", "files": ["layout/generic/nsIFrame.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/css/css-view-transitions/hit-test-captured-element-live-position.html.ini", "testing/web-platform/mozilla/tests/css/css-view-transitions/hit-test-captured-element-live-position.html"], "git_node": "c78075ae4862de932afdace92496ab35823065a9", "git_parents": ["cafcf57f939259e3ce9d7458de03ed004173135a"], "node": "84199eae635a3d9e9dec7779313b54a39bd52f46", "parents": ["038a169981c8e913a9d367230d79ee744f16de9c"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080207 - Add wasm tail-call frame iteration regression tests. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332429\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2080207-01.js", "js/src/jit-test/tests/wasm/tail-calls/bug2080207-02.js"], "git_node": "d4321408021b9c9fe4a8f60417dc75f3c9086511", "git_parents": ["c78075ae4862de932afdace92496ab35823065a9"], "node": "1da2da17ccbdbcc9d0c110c4013c3deb06275a38", "parents": ["84199eae635a3d9e9dec7779313b54a39bd52f46"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080706 - Skip iframe items that reference a pipeline already being built. r=gfx-reviewers,wsmind\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332870\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/wrench/reftests/crash/iframe-cycle-ref.yaml", "gfx/wr/wrench/reftests/crash/iframe-embeds-root.yaml", "gfx/wr/wrench/reftests/crash/iframe-self-embed.yaml", "gfx/wr/wrench/reftests/crash/reftest.list"], "git_node": "73c2c22ff02db19310e813cdbdeae706b7b70f75", "git_parents": ["d4321408021b9c9fe4a8f60417dc75f3c9086511"], "node": "df31dd0ef914421e99a63d83325a4e9ee08deae9", "parents": ["1da2da17ccbdbcc9d0c110c4013c3deb06275a38"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2071529 - jit/arm64: box an int32 in place with movk when the payload register is the destination. r=jandem\n\nMacroAssemblerCompat::tagValue ORs the shifted type tag into the payload.\nThe string, symbol and object tags are logical immediates, so that orr is\na single instruction for them, but since bug 2076007 the int32 tag\n0xfff9000000000000 is not, and vixl materializes it first:\n\n  movz x16, #0xfff9, lsl #48\n  orr  x2, x2, x16\n\nWhen the destination is the payload register and the tag lives entirely\nin the top halfword, a single movk writes the same word, because the\npayload's upper bits are already zero, as AssertValidPayload checks:\n\n  movk x2, #0xfff9, lsl #48\n\nOnly tags that orr cannot encode take this path, which today is just the\nint32 tag, so the other in-place boxes keep their orr. When the\ndestination differs, the instruction count is a tie (mov + movk against\nmovz + orr) and the orr form keeps the shorter dependency chain, so that\ncase is unchanged too.\n\nOn a JetStream 3 run with an instrumented shell the in-place int32 shape\nappears 4,192 times (Ion 3,335, Baseline 851, trampolines 6) and is gone\nafterwards, each site one instruction shorter, about 16 KB of JIT code\nper run.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325574\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.cpp"], "git_node": "0e657ca3a72972029e2114b8c71be3c7cc2e6bae", "git_parents": ["73c2c22ff02db19310e813cdbdeae706b7b70f75"], "node": "787ff83767cfb769bd50408211158dc709e08142", "parents": ["df31dd0ef914421e99a63d83325a4e9ee08deae9"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2080775 - [loong64] Take register into consideration when classifying patchable immediate load sequences. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332856\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp"], "git_node": "a73984500b9aec0bb202d37740c7ddf442abdcf4", "git_parents": ["0e657ca3a72972029e2114b8c71be3c7cc2e6bae"], "node": "f6b35fbc2de869c3a0cb67120791ebff0dfadcea", "parents": ["787ff83767cfb769bd50408211158dc709e08142"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080882 - Prevent transluscent backgrounds stacking for pinned tabs when sidebar animations are active r=desktop-theme-reviewers,sidebar-reviewers,jsudiaman,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332914\n", "files": ["browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/themes/shared/sidebar.css"], "git_node": "7ea34cac980ae9b72a24681f4ddfe700f5d38220", "git_parents": ["a73984500b9aec0bb202d37740c7ddf442abdcf4"], "node": "c5313c46cab449bbe76a444a28a51cfaf452a4a2", "parents": ["f6b35fbc2de869c3a0cb67120791ebff0dfadcea"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2080116 - Move bogus assertion before inserting into [[LoadedModules]]. r=jonco\n\nModuleRequestHasher::match is also called during `lookup`.\nMove the assertion of !ModuleType::Unknown in FinishLoadingImportedModule.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332912\n", "files": ["js/src/builtin/ModuleObject.h", "js/src/jit-test/tests/modules/bug-2080116.js", "js/src/vm/Modules.cpp"], "git_node": "284b35c9833720dc80f666b3a7c9a492ee83a00f", "git_parents": ["7ea34cac980ae9b72a24681f4ddfe700f5d38220"], "node": "6ce8cc71ed8cc626f2e47b7c990db0d47283ef70", "parents": ["c5313c46cab449bbe76a444a28a51cfaf452a4a2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080752 - Implement layer invalidation via cascade data diffing. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332221\n", "files": ["servo/components/style/invalidation/stylesheets.rs", "servo/components/style/stylist.rs", "testing/web-platform/mozilla/tests/css/layer-insert-rule-invalidation.html"], "git_node": "947d9764c80d32b849271b018356382a7d2ff04d", "git_parents": ["284b35c9833720dc80f666b3a7c9a492ee83a00f"], "node": "6b12becb478aa4ea792dfb94ab88da2451a154b7", "parents": ["6ce8cc71ed8cc626f2e47b7c990db0d47283ef70"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076295 - Frame cropped mini windows by zooming the visual viewport with APZ instead of a layout transform. r=emilio,webidl,layout-reviewers,mconley,smaug,hiro,botond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330273\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/webidl/Document.webidl", "layout/base/MobileViewportManager.cpp", "layout/base/PresShell.cpp", "layout/base/PresShell.h", "layout/base/nsPresContext.cpp", "layout/generic/ScrollContainerFrame.cpp"], "git_node": "1a6824a111b30a16d187589cf56d95f990d8b36b", "git_parents": ["947d9764c80d32b849271b018356382a7d2ff04d"], "node": "8d0871e8c42dd061b3eff2d408af42643b24166f", "parents": ["6b12becb478aa4ea792dfb94ab88da2451a154b7"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076295 - Set minimum zoom for mini windows to 0.1. r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331767\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_framing_resize.js", "dom/base/Document.cpp"], "git_node": "e644571fd62b01be9e185fbf684cbbe97ae8954f", "git_parents": ["1a6824a111b30a16d187589cf56d95f990d8b36b"], "node": "fbeec5a5d77ab5eb22b1d10c25cdf9206ba8fb68", "parents": ["8d0871e8c42dd061b3eff2d408af42643b24166f"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076295 - tests for framing using apz. r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330941\n", "files": ["browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_reveal.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "layout/base/tests/browser.toml", "layout/base/tests/browser_viewport_size_override.js"], "git_node": "e2e552b9923001595cf8e4596e027f901505a74f", "git_parents": ["e644571fd62b01be9e185fbf684cbbe97ae8954f"], "node": "95715e6a53686a0a69c1ef509e34cac77a149712", "parents": ["fbeec5a5d77ab5eb22b1d10c25cdf9206ba8fb68"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071871 - Keep Treeherder's failure summary lines in summary.jsonl r=ahal\" for causing perma jittest failures\n\nThis reverts commit 79a9295a1e1296254e55c2633b5bf7d031bd2c3d.\n\nRevert \"Bug 2071871 - Write summary.jsonl from mozharness's StructuredOutputParser r=ahal\"\n\nThis reverts commit 375459800258cafdc1e31df7afb9145b9c9e0940.\n", "files": ["testing/mozharness/configs/android/android_common.py", "testing/mozharness/configs/unittests/linux_unittest.py", "testing/mozharness/configs/unittests/mac_unittest.py", "testing/mozharness/configs/unittests/win_unittest.py", "testing/mozharness/mozharness/mozilla/structuredlog.py", "testing/mozharness/mozharness/mozilla/testing/errors.py", "testing/mozharness/mozharness/mozilla/testing/per_test_base.py", "testing/mozharness/scripts/android_emulator_unittest.py", "testing/mozharness/scripts/android_hardware_unittest.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/scripts/web_platform_tests.py", "testing/mozharness/test/python.toml", "testing/mozharness/test/test_mozilla_per_test_base.py", "testing/mozharness/test/test_mozilla_structured.py", "testing/mozharness/test/test_mozilla_testing_errors.py"], "git_node": "491bd9f702a2fb1abed4744631610617b7a43a96", "git_parents": ["e2e552b9923001595cf8e4596e027f901505a74f"], "node": "08db332839036008a36c244c2bd51f9864e41e6b", "parents": ["95715e6a53686a0a69c1ef509e34cac77a149712"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079752, Bug 2066842, Bug 2066840, Bug 2074550 - Only count the toggle's own mode as protection being on in the panel r=ip-protection-reviewers,rking\"\n\nThis reverts commit fa3edeb08ac38f71eabf2c57c5a96640f150c59c.\n\nRevert \"Bug 2066842 - Keep always-on sites covered through IPPAutoActivation r=ip-protection-reviewers,rking\"\n\nThis reverts commit 60046fa97e9c7809bdaf2ffafe9c896ebae170bb.\n\nRevert \"Bug 2066842 - Decide desktop auto-activation in one component r=ip-protection-reviewers,rking\"\n\nThis reverts commit 1535ec7f1dd6149d9ccc31aa7769f70b5044f194.\n\nRevert \"Bug 2066842 - Let start() wait for the service instead of IPPEarlyStartupFilter r=ip-protection-reviewers,rking\"\n\nThis reverts commit d016884eaa8d5f1e0b444487a4d74ea91e650245.\n\nRevert \"Bug 2066840 - Move proxy mode ownership into IPPProxyManager r=ip-protection-reviewers,rking\"\n\nThis reverts commit 68687343f0dce345bb9169a3541b410d3964cb59.\n\nRevert \"Bug 2074550 - Key start()/stop() off the in-flight activation, not the ACTIVATING state r=ip-protection-reviewers,rking\"\n\nThis reverts commit beb4d0563c28f409fed45781f189fb37355254b3.\n", "files": ["browser/components/ipprotection/IPProtectionHelpers.sys.mjs", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_confirmation_hints_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_toolbar.js", "browser/components/ipprotection/tests/browser/head.js", "toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPAutoRestore.sys.mjs", "toolkit/components/ipprotection/IPPAutoStart.sys.mjs", "toolkit/components/ipprotection/IPPChannelFilter.sys.mjs", "toolkit/components/ipprotection/IPPEarlyStartupFilter.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/IPPStartupCache.sys.mjs", "toolkit/components/ipprotection/IPProtectionActivator.sys.mjs", "toolkit/components/ipprotection/IPProtectionService.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/docs/Constants.md", "toolkit/components/ipprotection/docs/Preferences.md", "toolkit/components/ipprotection/docs/StateMachine.md", "toolkit/components/ipprotection/enterprise/IPPAlwaysOn.sys.mjs", "toolkit/components/ipprotection/moz.build", "toolkit/components/ipprotection/tests/xpcshell/head.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAlwaysOn.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoRestore.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPChannelFilter.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js", "toolkit/components/ipprotection/tests/xpcshell/test_MatchPatternPrefRule.js", "toolkit/components/ipprotection/tests/xpcshell/test_SiteRuleManager.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "1ebf201a096cfd723adda19eb357698a0fdf66af", "git_parents": ["491bd9f702a2fb1abed4744631610617b7a43a96"], "node": "ba34e6da104c7c265011eb58083c061b8f7d466a", "parents": ["08db332839036008a36c244c2bd51f9864e41e6b"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2080784 - [loong64] Part 1: Use CALL36 for MacroAssembler::{callWithPatch,patchCall}(). r=jandem\n\nThis is a leftover cleanup from Bug 2071659.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332885\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "086a2fbaee8e58360bf42fa3b4fc1901941d5721", "git_parents": ["1ebf201a096cfd723adda19eb357698a0fdf66af"], "node": "f3b6197bc98a82c645fe4a79dce511d95bbb9ee1", "parents": ["ba34e6da104c7c265011eb58083c061b8f7d466a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2080784 - [loong64] Part 2: Relax JumpImmediateRange to INT32_MAX. r=jandem\n\nThis value equals minRange(callWithPatch, farJumpWithPatch), which is\nnow bound by farJumpWithPatch's +/-2 GiB range, but not callWithPatch's\n+/-128 GiB range.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332886\n", "files": ["js/src/jit/loong64/Architecture-loong64.h"], "git_node": "45b250280d863d524c532d5c86cccefd95c90a54", "git_parents": ["086a2fbaee8e58360bf42fa3b4fc1901941d5721"], "node": "bed2e56cddd7a047754dc6fcc439578d2898aa97", "parents": ["f3b6197bc98a82c645fe4a79dce511d95bbb9ee1"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078287 - Fix TOCTOU process startup race in android xpcshell tests r=florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330854\n", "files": ["testing/xpcshell/remotexpcshelltests.py"], "git_node": "7e47737e2388eaad2e3604aaca7f2e1c855aec3a", "git_parents": ["45b250280d863d524c532d5c86cccefd95c90a54"], "node": "fba40a56c7fc2161c6e6991877f14b24426832e0", "parents": ["bed2e56cddd7a047754dc6fcc439578d2898aa97"], "tags": []}, {"author": "Tyler Etchart \u003ctetchart@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079400 - removed the test_Tools_GetPageContent test r=gregtatum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332208\n", "files": ["browser/components/aiwindow/models/tests/xpcshell/test_Tools_GetPageContent.js", "browser/components/aiwindow/models/tests/xpcshell/xpcshell.toml"], "git_node": "374378ff8d5ddb1b50b783a452ef616a7aca24d3", "git_parents": ["7e47737e2388eaad2e3604aaca7f2e1c855aec3a"], "node": "0e44e72658ccfdc21abfe2911e43ad453e676335", "parents": ["fba40a56c7fc2161c6e6991877f14b24426832e0"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Wayland] Add RenderWaylandTextureHost to hold external SHM buffers on Wayland r=gw\n\nImplement RenderWaylandTextureHost as SHM based texture host which supports external textures,\nit's used for direct mapping of SW decoded video frames.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331810\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/composite/TextureHost.h", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h", "gfx/webrender_bindings/RenderWaylandTextureHost.cpp", "gfx/webrender_bindings/RenderWaylandTextureHost.h", "gfx/webrender_bindings/moz.build"], "git_node": "b650f02aa97684b5adefc86c313ccb884f567ee4", "git_parents": ["374378ff8d5ddb1b50b783a452ef616a7aca24d3"], "node": "93871cc83e297a127072f6e72e29e1d4cb6b3ce6", "parents": ["0e44e72658ccfdc21abfe2911e43ad453e676335"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Linux] Return correct color depth by RenderDMABUFTextureHost r=gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331811\n", "files": ["gfx/webrender_bindings/RenderDMABUFTextureHost.h"], "git_node": "580e97fb0152a32459e2dec4d29c1a9c9e7e7a94", "git_parents": ["b650f02aa97684b5adefc86c313ccb884f567ee4"], "node": "414dc1030703ce792dcaa3461ff59aadec955733", "parents": ["93871cc83e297a127072f6e72e29e1d4cb6b3ce6"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Linux] Remove direct dmabuf frames upload for HDR frames but use standard shm image path r=padenot,media-playback-reviewers\n\nRemove Linux specific hack and use standard SHM/custom buffer allocation for SW decoded frames.\nWe'll upload them to dmabuf later when we have real HW based GL context from WR compositor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331812\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.h"], "git_node": "26e1fde6dedf54574b699772cb1abe70c24a696d", "git_parents": ["580e97fb0152a32459e2dec4d29c1a9c9e7e7a94"], "node": "39c6934b20a583126d8fcea7bb70fe262f3e4a7e", "parents": ["414dc1030703ce792dcaa3461ff59aadec955733"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068021 [Linux] Remove direct buffer upload to DMABufSurface r=emilio,gtk-reviewers\n\nDirect upload of PlanarYCbCrData to DAMBufSurface is not used any more.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331813\n", "files": ["widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h"], "git_node": "478bfd09ffafeecce7ff980bdb14d637599eff0a", "git_parents": ["26e1fde6dedf54574b699772cb1abe70c24a696d"], "node": "6c11edbe98adc873576d4436bf43415354c2cc3d", "parents": ["39c6934b20a583126d8fcea7bb70fe262f3e4a7e"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2077231 - Forward sendQuery rejections from RPMSendQuery to the page promise. r=NeilDeakin\n\nBefore this patch, RPMSendQuery wrapped sendQuery in a new Promise with no rejection handler. This meant when the parent did not answer before the actor was destroyed, the AbortError was unhandled and the promise never settled. In this patch, we pass reject as the second argument to then() so the rejection settles the outer promise, and wrapPromise forwards it to the page promise.\n\nThis appears (based on several treeherder pushes) to have been the cause of the flakiness of [this](https://tests.firefox.dev/test.html?test=accessible%2Ftests%2Fbrowser%2Fevents%2Fbrowser_test_docload.js) accessibility test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330208\n", "files": ["toolkit/actors/RemotePageChild.sys.mjs"], "git_node": "a19786ffc373b5feaf3e0de000c9c8851b6d9508", "git_parents": ["478bfd09ffafeecce7ff980bdb14d637599eff0a"], "node": "42830f523cb600566d887d427e2ee95ac9d909fa", "parents": ["6c11edbe98adc873576d4436bf43415354c2cc3d"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076295 - tests for framing using apz. r=emilio,layout-reviewers\" for causing bc failures @browser_framing.js.\n\nThis reverts commit e2e552b9923001595cf8e4596e027f901505a74f.\n\nRevert \"Bug 2076295 - Set minimum zoom for mini windows to 0.1. r=emilio,layout-reviewers\"\n\nThis reverts commit e644571fd62b01be9e185fbf684cbbe97ae8954f.\n\nRevert \"Bug 2076295 - Frame cropped mini windows by zooming the visual viewport with APZ instead of a layout transform. r=emilio,webidl,layout-reviewers,mconley,smaug,hiro,botond\"\n\nThis reverts commit 1a6824a111b30a16d187589cf56d95f990d8b36b.\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_framing_resize.js", "browser/components/miniwindow/test/browser/browser_reveal.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/miniwindow/test/xpcshell/test_MiniWindowUtils.js", "docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/webidl/Document.webidl", "layout/base/MobileViewportManager.cpp", "layout/base/PresShell.cpp", "layout/base/PresShell.h", "layout/base/nsPresContext.cpp", "layout/base/tests/browser.toml", "layout/base/tests/browser_viewport_size_override.js", "layout/generic/ScrollContainerFrame.cpp"], "git_node": "f9c62290c4cecfe92d3c0a88152b62ec0e7266ce", "git_parents": ["a19786ffc373b5feaf3e0de000c9c8851b6d9508"], "node": "9ae62aee05532c068b1ab6de68f661312c8030d5", "parents": ["42830f523cb600566d887d427e2ee95ac9d909fa"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068021 [Linux] Remove direct buffer upload to DMABufSurface r=emilio,gtk-reviewers\" for causing linting failures @DMABufSurface.cpp.\n\nThis reverts commit 478bfd09ffafeecce7ff980bdb14d637599eff0a.\n\nRevert \"Bug 2068021 [Linux] Remove direct dmabuf frames upload for HDR frames but use standard shm image path r=padenot,media-playback-reviewers\"\n\nThis reverts commit 26e1fde6dedf54574b699772cb1abe70c24a696d.\n\nRevert \"Bug 2068021 [Linux] Return correct color depth by RenderDMABUFTextureHost r=gw\"\n\nThis reverts commit 580e97fb0152a32459e2dec4d29c1a9c9e7e7a94.\n\nRevert \"Bug 2068021 [Wayland] Add RenderWaylandTextureHost to hold external SHM buffers on Wayland r=gw\"\n\nThis reverts commit b650f02aa97684b5adefc86c313ccb884f567ee4.\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.h", "gfx/layers/NativeLayerWayland.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/composite/TextureHost.h", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderDMABUFTextureHost.h", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h", "gfx/webrender_bindings/RenderWaylandTextureHost.cpp", "gfx/webrender_bindings/RenderWaylandTextureHost.h", "gfx/webrender_bindings/moz.build", "widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h"], "git_node": "a17c52fd76909d83b010e3be5ce97ca8e491b3ca", "git_parents": ["f9c62290c4cecfe92d3c0a88152b62ec0e7266ce"], "node": "4b114aa59bb346d6e224347ab02f56ee76fe9aef", "parents": ["9ae62aee05532c068b1ab6de68f661312c8030d5"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075432 - Ensure table continuations use consistent border-collapse model. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330808\n", "files": ["layout/tables/nsCellMap.cpp", "layout/tables/nsTableFrame.cpp", "testing/web-platform/tests/css/css-tables/table-continuation-border-model-crash-print.html"], "git_node": "a8d29a532006f82dc09ff167a004105347dc85a8", "git_parents": ["a17c52fd76909d83b010e3be5ce97ca8e491b3ca"], "node": "d579f9fc0981650dad1450b7ad098aa95784eb5e", "parents": ["4b114aa59bb346d6e224347ab02f56ee76fe9aef"], "tags": []}, 