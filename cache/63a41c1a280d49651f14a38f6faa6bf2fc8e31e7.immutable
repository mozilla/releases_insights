b35e564f", "git_parents": ["a5027b986057834d783674c93063abce70d1d7a2"], "node": "3faa802075192ab08d42de4f98e0b7e10412d1ba", "parents": ["1aeec1c645f598dfd7cd1509400b80580ec60fc8"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079818 - Associate ScriptFetchInfo for frame, process and sub scripts. r=jonco,arai\n\nFrame, process and sub scripts have no ScriptFetchInfo, and\nSyncScriptLoader has no base URL, so a dynamic import() from them dereferenced\na null baseURL in ImportMap::ResolveModuleSpecifier.\n\nAssociate a ScriptFetchInfo with those scripts, using the script URL as the\nbase URL. Make SyncModuleLoader create default ScriptFetchOptions for scripts\nthat still have no ScriptFetchInfo, such as ChromeUtils.compileScript ones, and\nhandle their null baseURL when resolving a specifier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333635\n", "files": ["dom/base/nsFrameMessageManager.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_messagemanager_loadprocessscript_dynamic_import.js", "dom/base/test/file_precompiled_script_dynamic_import.js", "dom/base/test/file_process_script_dynamic_import.js", "dom/base/test/file_process_script_dynamic_import.sys.mjs", "dom/base/test/file_subscript_dynamic_import.js", "dom/base/test/file_subscript_dynamic_import.sys.mjs", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "js/loader/ImportMap.cpp", "js/xpconnect/loader/SyncModuleLoader.cpp", "js/xpconnect/loader/SyncModuleLoader.h", "js/xpconnect/loader/mozJSSubScriptLoader.cpp"], "git_node": "da1cd85aa1bf0529c14dad8211243d724671f589", "git_parents": ["0e294f4174355004fd7181c89b0ade43b35e564f"], "node": "4a5e2b36dde3a3c9921f21f2e8795f4cb09e6577", "parents": ["3faa802075192ab08d42de4f98e0b7e10412d1ba"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2082282: Update intervention for *.class.com to use FxQuantum instead of Firefox in UA string, and to provide navigator.userAgentData.getHighEntropyValues stub. r=twisniewski,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334265\n", "files": ["browser/extensions/webcompat/data/interventions/1912923-class.com.json", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_1912923_class_com.py", "testing/webcompat/interventions/tests/test_1912923_livelesson_class_com.py"], "git_node": "83c6e0f802d0f4ee0f0ce04c614946bf2ca3f193", "git_parents": ["da1cd85aa1bf0529c14dad8211243d724671f589"], "node": "1bc31eb45b166564a645908f518e813a2fb630c3", "parents": ["4a5e2b36dde3a3c9921f21f2e8795f4cb09e6577"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 1991747 - Support MP3 (A_MPEG/L3, audio/mpeg) in Matroska. r=media-playback-reviewers,padenot\n\nMatroskaDemuxer now handles NESTEGG_CODEC_MP3 in\nSetContainerAudioCodecInfo (audio/mpeg + Mp3CodecSpecificData,\nencoder delay derived from codec_delay like AAC's 1024-\u003e1152).\n\nMatroskaDecoder exposes mp3/mp4a.40.34 via\nGetTracksInfo/IsSupportedType and adds audio/mpeg to the\nno-codecs probe list.\n\nWebMDemuxer SetAudioCodecInfo early-returns for 0 headers (MP3 has\nno CodecPrivate) and GetNextPacket makes discardPadding generic:\nOpus keeps opus_packet_get_nb_samples path, others subtract\nnanosecond padding from sample duration.\n\nTest: move output_mp3.mkv from gUnsupportedMKVtests to gMKVtests so\ntest_mkv_playback.html plays it to the end (the file contains\nDiscardPadding, exercising the generic padding path). Add\nTEST(MatroskaDemuxer, MP3DiscardPadding) asserting the last sample\nduration is trimmed by the padding (~6.28ms vs a full 26.12ms frame).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323913\n", "files": ["dom/media/gtest/TestWebMDemuxer.cpp", "dom/media/gtest/moz.build", "dom/media/test/manifest.js", "dom/media/webm/MatroskaDecoder.cpp", "dom/media/webm/MatroskaDemuxer.cpp", "dom/media/webm/WebMDemuxer.cpp"], "git_node": "3cc207c14742830aa4ed3b0ad4d21eafbf3f4716", "git_parents": ["83c6e0f802d0f4ee0f0ce04c614946bf2ca3f193"], "node": "632f24c044a97754933aa8395e033e198dff6c14", "parents": ["1bc31eb45b166564a645908f518e813a2fb630c3"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 1991746 - Support FLAC (A_FLAC, audio/flac) in Matroska. r=media-playback-reviewers,padenot\n\nSeparate from Bug 1991747 MP3. MatroskaDemuxer now handles\nNESTEGG_CODEC_FLAC as audio/flac + FlacCodecSpecificData\n(STREAMINFO supplied via Matroska CodecPrivate and consumed in\nWebMDemuxer::SetAudioCodecInfo's CodecPrivate blob path).\n\nDecoder exposes flac via GetTracksInfo/IsSupportedType and the\nno-codecs probe list.\n\nTest: move output_flac.mkv from gUnsupportedMKVtests to gMKVtests so\ntest_mkv_playback.html plays it to the end.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323914\n", "files": ["dom/media/test/manifest.js", "dom/media/webm/MatroskaDecoder.cpp", "dom/media/webm/MatroskaDemuxer.cpp"], "git_node": "ca4f3937e3c40c48213635af9ba6ea6060bc3f2f", "git_parents": ["3cc207c14742830aa4ed3b0ad4d21eafbf3f4716"], "node": "b4bf87df940aab590b48734ca40f1061ee7ac9bf", "parents": ["632f24c044a97754933aa8395e033e198dff6c14"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079498 - Offer the security code checkbox in the card doorhanger whenever security codes are supported. r=credential-management-reviewers,dimi\n\nThe checkbox now follows extensions.formautofill.creditCards.cvv.supported\nrather than requiring capture to already be on, and starts from the\n\"Save security codes\" setting, so a user who turned it off can turn it back\non from the doorhanger.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333475\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "61cf7c2783c0fc868feca4ed252ad22313f77916", "git_parents": ["ca4f3937e3c40c48213635af9ba6ea6060bc3f2f"], "node": "a974ec8962a57acb00ffbaf21b1d3f3071d2b5ef", "parents": ["b4bf87df940aab590b48734ca40f1061ee7ac9bf"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1751383 - Support blocking=\"render\", r=farre,emilio,firefox-style-system-reviewers\n\nAdds the blocking=render content attribute plumbing (link/script/style),\nrender-blocking bookkeeping on Document, and the refresh-driver hook that\nholds the last rendered frame while a document is render-blocked.\n\nTests are enabled in the last patch of the stack\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310387\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/FromParser.h", "dom/base/LinkStyle.cpp", "dom/base/nsContentSink.cpp", "dom/base/nsContentSink.h", "dom/html/HTMLLinkElement.cpp", "dom/html/HTMLLinkElement.h", "dom/html/HTMLScriptElement.cpp", "dom/html/HTMLStyleElement.cpp", "dom/html/HTMLStyleElement.h", "dom/script/ScriptElement.cpp", "dom/script/ScriptLoader.cpp", "layout/style/Loader.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a634b1d9f9eafb246703167dcb1996d0063843c2", "git_parents": ["61cf7c2783c0fc868feca4ed252ad22313f77916"], "node": "80caf2a50d8e333dfba4739a2d0a60e8ca0d5a25", "parents": ["a974ec8962a57acb00ffbaf21b1d3f3071d2b5ef"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2053279 - Support rel=expect, r=farre\n\nImplements the rel=expect internal resource link render-blocking: parse the\nhref against the document, and keep blocking while the indicated part is not\nyet parsed (tracked via ELEMENT_CLOSED_BY_PARSER, set when the parser closes\nan element).\n\nTests are enabled in the last patch of the stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310388\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/LinkStyle.cpp", "dom/base/LinkStyle.h", "dom/html/HTMLAnchorElement.cpp", "dom/html/HTMLLinkElement.cpp", "dom/html/HTMLLinkElement.h", "parser/html/nsHtml5TreeBuilderCppSupplement.h", "parser/html/nsHtml5TreeOperation.cpp"], "git_node": "de8658ade955b95fac1f39b7b6588a118f07e853", "git_parents": ["a634b1d9f9eafb246703167dcb1996d0063843c2"], "node": "060782d89e5128ad6413320368a9dbaaa05ed76e", "parents": ["80caf2a50d8e333dfba4739a2d0a60e8ca0d5a25"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1881438 - Implement pageswap event, r=farre,webidl\n\nThe parent process defers the navigation commit so the old document fires pageswap and\ncaptures its outbound snapshot in a natural refresh tick, then signals the\nparent to proceed. Covers top-level and subframe navigations  and a WindowGlobalParent\nopt-in flag so common (non-VT) navigations keep committing inline with no extra IPC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310389\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h", "docshell/shistory/nsSHistory.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/events/EventNameList.inc", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/DOMTypes.ipdlh", "dom/ipc/PContent.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalParent.c