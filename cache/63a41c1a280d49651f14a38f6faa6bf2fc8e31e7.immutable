es.cpp", "xpcom/base/CollectorLogAnalyzer.cpp", "xpcom/base/CycleCollectedJSContext.cpp", "xpcom/base/CycleCollectedJSRuntime.cpp", "xpcom/base/Logging.cpp", "xpcom/base/MemoryTelemetry.cpp", "xpcom/base/RLBoxSandboxPool.cpp", "xpcom/base/nsCycleCollector.cpp", "xpcom/base/nsINIParser.cpp", "xpcom/base/nsMacUtilsImpl.cpp", "xpcom/base/nsMemoryInfoDumper.cpp", "xpcom/base/nsTraceRefcnt.cpp", "xpcom/build/BinaryPath.h", "xpcom/build/MainThreadIOLogger.cpp", "xpcom/build/PoisonIOInterposerWin.cpp", "xpcom/components/StaticComponents.cpp.in", "xpcom/components/nsComponentManager.cpp", "xpcom/ds/Tokenizer.cpp", "xpcom/ds/nsBaseHashtable.h", "xpcom/io/AsyncPlatformPipes.cpp", "xpcom/io/FixedBufferOutputStream.cpp", "xpcom/io/StreamBufferSinkImpl.h", "xpcom/io/nsBinaryStream.cpp", "xpcom/tests/gtest/TestGCPostBarriers.cpp", "xpcom/tests/gtest/TestHashtables.cpp", "xpcom/tests/gtest/TestJSHolderMap.cpp", "xpcom/tests/gtest/TestMozPromise.cpp", "xpcom/tests/gtest/TestObserverArray.cpp", "xpcom/tests/gtest/TestSegmentedBuffer.cpp", "xpcom/tests/gtest/TestThreadUtils.cpp", "xpcom/threads/DeadlockDetector.h", "xpcom/threads/TaskController.cpp", "xpcom/threads/ThreadEventQueue.cpp", "xpcom/threads/nsThreadManager.cpp"], "git_node": "ead274928a9917eadd87c6dbf3b3f3667814f2b2", "git_parents": ["bee2d5f308555d516c356c6e935f5458bb8c6a45"], "node": "4bed166cd327f72cde1ec118ac326104151dbf40", "parents": ["91e34690905806d1bd87e7cac5a47df5bcaa0f2a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083318 - Use intrusive pointer for nsDisplayItem again. r=layout-reviewers,dshin\n\nAvoids some indirection when traversing display lists.\n\nWe removed it in bug 1714584, to allow experimenting with different\nnsDisplayList representations. That hasn't panned out but we can keep\nthe API very similar in order to not make it harder if someone wants to\nlook into it again.\n\nI rejiggered a bit some of the APIs because it was very unclear that\nclear() didn't destroy anything (other than the list nodes) for example.\n\nI removed the builder param because after this is only used for\nsame-builder asserts (and you could technically pass nullptr there\nalways and be alright). It didn't seem super valuable but lmk if you\nwant them back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334832\n", "files": ["layout/base/PresShell.cpp", "layout/base/nsLayoutUtils.cpp", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/TextOverflow.cpp", "layout/generic/ViewportFrame.cpp", "layout/generic/nsCanvasFrame.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsPageContentFrame.cpp", "layout/generic/nsPageFrame.cpp", "layout/generic/nsPageSequenceFrame.cpp", "layout/generic/nsSubDocumentFrame.cpp", "layout/painting/RetainedDisplayListBuilder.cpp", "layout/painting/RetainedDisplayListBuilder.h", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/painting/nsDisplayListArenaTypes.inc", "layout/svg/SVGForeignObjectFrame.cpp", "layout/svg/SVGOuterSVGFrame.cpp", "layout/tables/nsTableFrame.cpp", "layout/xul/nsSliderFrame.cpp"], "git_node": "03208515d44796553d8c25d0e1812db04a40172a", "git_parents": ["ead274928a9917eadd87c6dbf3b3f3667814f2b2"], "node": "3d065f26e67c628b4803320a222e13c08e124033", "parents": ["4bed166cd327f72cde1ec118ac326104151dbf40"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069157 - Record impressions of the text selection menu's search action. r=jteow,search-reviewers,echa\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nRecords a `sap.impression_counts` entry for `text_selection` each time the menu is shown with the Search action visible, labelled with the engine it would search with.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334793\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/metrics.yaml"], "git_node": "3eb241601e107020bdbbe13c0d6fe0b93af7a24c", "git_parents": ["03208515d44796553d8c25d0e1812db04a40172a"], "node": "e3b98abc606117dbec54e58fbd45b5288c36bfad", "parents": ["3d065f26e67c628b4803320a222e13c08e124033"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084053 - Cleanup nsDeviceContextSpec::BeginPage/EndPage. r=layout-reviewers,dshin\n\nMost of them just ignore it, we can move that to the interface.\n\nNo behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336002\n", "files": ["widget/android/nsDeviceContextAndroid.h", "widget/cocoa/nsDeviceContextSpecX.h", "widget/gtk/nsDeviceContextSpecG.h", "widget/nsDeviceContextSpecProxy.cpp", "widget/nsDeviceContextSpecProxy.h", "widget/nsIDeviceContextSpec.h", "widget/windows/nsDeviceContextSpecWin.h"], "git_node": "1996ec1308551620ef3fa0914acde9bdccd97c6e", "git_parents": ["3eb241601e107020bdbbe13c0d6fe0b93af7a24c"], "node": "6f8f7f47abd5c5b1666e2f708801d9a9fd0b7d58", "parents": ["e3b98abc606117dbec54e58fbd45b5288c36bfad"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084033 - Fix two dwell time JSDoc types in TelemetryFeed that fail the TypeScript lint. r=ini\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335705\n", "files": ["browser/extensions/newtab/lib/TelemetryFeed.sys.mjs"], "git_node": "5b216f148200b9661d6dfe0c3272d81eccc5ad3f", "git_parents": ["1996ec1308551620ef3fa0914acde9bdccd97c6e"], "node": "c9fe9b6f3f854c0630e545558d255ff2c7bade19", "parents": ["6f8f7f47abd5c5b1666e2f708801d9a9fd0b7d58"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083820 - Enable building the fontations code in Nightly builds. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335331\n", "files": ["toolkit/moz.configure"], "git_node": "ac4fd600fb7f79d7e24c5975cd0d48c567ee80d1", "git_parents": ["5b216f148200b9661d6dfe0c3272d81eccc5ad3f"], "node": "ce2b9e6e397d5a884f68af89ff16945f6842d7fe", "parents": ["c9fe9b6f3f854c0630e545558d255ff2c7bade19"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083656 - Run the spidermonkey build kind on git-backed pushes and clone it with Git, r=taskgraph-reviewers,ahal\n\nDrop `run-on-repo-type: [hg]` and `clone-with: hg` from the spidermonkey kind\nand its linux and windows task files, so the SpiderMonkey builds schedule on\ngit-backed pushes and check out the GitHub mirror (run-task-git, shallow\nclone) on both repository types.\n\nVerified on try, 9 sm builds cloning from Git, all green (plain linux64\nopt and debug, nonunified, compacting, asan, arm64-sim, package, wasi and\nplain win64 debug):\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=edc244edfc4c34467961466de645f64241527d9e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335138\n", "files": ["taskcluster/kinds/spidermonkey/kind.yml", "taskcluster/kinds/spidermonkey/linux.yml", "taskcluster/kinds/spidermonkey/windows.yml"], "git_node": "576adef03fade719bf144deb87d953b3a354a8bb", "git_parents": ["ac4fd600fb7f79d7e24c5975cd0d48c567ee80d1"], "node": "ae1d37300767660f43c8ab528ff1c49e524901bb", "parents": ["ce2b9e6e397d5a884f68af89ff16945f6842d7fe"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084606 - Update PDF.js to 5d143c409514675aa0fc9ee2a18346cfebafd770 r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335974\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "f4bdd7908707150515c5cd53fec8a4425de4a73a", "git_parents": ["576adef03fade719bf144deb87d953b3a354a8bb"], "node": "39239fb321e3a322390be95f4d30d46bfc47eff6", "parents": ["ae1d37300767660f43c8ab528ff1c49e524901bb"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075274 - Size the carousel container and cards Spotlight responsiveness. r=omc-reviewers,sachung\n\nGives the carousel two fixed layouts. The screen is either 800px wide, where the selected card is enlarged and its neighbours peek in at a smaller size, or the standard 504px Spotlight width, where every card takes the smaller size and the selection is marked by its outline. A container query on .section-main switches the custom properties that size the selected and the peek card, so both change together when the screen crosses that boundary, and the screen itself snaps between the two widths. The selected card's 4px ring is a border, which keeps those sizes the card's real outer box, and each card scales its artwork to its own box.\n\nCarousel rendering is opt-in through tiles.layout: \"carousel\", which also gates the pill row. Selecting a pill animates the row's scroll position with requestAnimationFrame over the same duration the card takes to grow, re-measuring the destination each frame so the card lands centred, and a ResizeObserver re-centres it when the row is resized. The pill click records a CLICK_BUTTON event.\n\nNote that the frames leave no room for body copy, so body text is kept for assistive technology but is not displayed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333493\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/CarouselNav.jsx", "browser/components/asrouter/content-src/components/ContentTiles.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/components/SingleSelect.jsx", "browser/components/asrouter/content-src/components/TileButton.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/about-welcome.md", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_spotlight_carousel_nav.js", "browser/components/asrouter/tests/unit/content-src/components/ContentTiles.test.jsx", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "82c747b0b4beba83feeea0ff39257cb3790f9107", "git_parents": ["f4bdd7908707150515c5cd53fec8a4425de4a73a"], "node": "4b46ef5f8194a3136dcf601dd21f3ebdc4e721d4", "parents": ["39239fb321e3a322390be95f4d30d46bfc47eff6"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073326 - Show private tab notification immediately when a new private tab is made r=p--xyhgnc68hvgie4h4sae9tk\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/405\n", "files": ["mobile/android/android-components/components/feature/privatemode/src/main/java/mozilla/components/featu