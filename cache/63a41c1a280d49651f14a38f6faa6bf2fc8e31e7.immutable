3c"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053846 - Add Marionette tests for lockstore-based storage encryption. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311362\n", "files": ["dom/cache/test/marionette/manifest.toml", "dom/cache/test/marionette/test_cacheapi_encryption_lockstore.py", "dom/cache/test/marionette/test_cacheapi_encryption_persistence.py", "dom/indexedDB/test/marionette/manifest.toml", "dom/indexedDB/test/marionette/test_IDB_encryption_lockstore.py", "dom/indexedDB/test/marionette/test_IDB_encryption_persistence.py", "dom/quota/test/marionette/quota_test_case.py"], "git_node": "5aeacbbdfd475c5f5832ba3b9cc9c43906927e26", "git_parents": ["aba96e274ba053b21baa81aba2b41eac1e361fb4"], "node": "ad7c61b876b0babcbb886fb49216858f55e3c290", "parents": ["497ceb88a15ec051bf369eac0067964b03cc8ce7"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053846 - Track per-origin encryption state in storage.sqlite. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311363\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CommonMetadata.h", "dom/quota/DirectoryMetadata.cpp", "dom/quota/DirectoryMetadata.h", "dom/quota/OriginInfo.cpp", "dom/quota/OriginInfo.h", "dom/quota/SerializationHelpers.h", "dom/quota/test/gtest/QuotaManagerDependencyFixture.cpp"], "git_node": "933e5109edbaae2467d756a2bf8449d09d57cc91", "git_parents": ["5aeacbbdfd475c5f5832ba3b9cc9c43906927e26"], "node": "6aa7007ec202b3d4b65c13b05cb761c8eeb2fd46", "parents": ["ad7c61b876b0babcbb886fb49216858f55e3c290"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083514 - Deal with reframes of ancestors of replicated fixed-pos frames. r=layout-reviewers,dshin\n\nSo the issue is that esr153 reframes the ::before and that means really\nreframing the originating element entirely, which is _not_ in the\nfixed-pos subtree. The WPT triggers the issue pre-patch on nightly and\ndoesn't depend on us eventually allowing reframing of individual pseudos\n(which is on file).\n\nMove the paginated bail-out sooner since it's the most aggressive one.\nOtherwise I'm guessing that if you hit the multicol case you might still\nbe able to trigger the original issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335133\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "testing/web-platform/tests/css/printing/fixed-generated-content-reconstruct-crash-print.html"], "git_node": "ed6a5a08f468d38ea1c662f47634f36f0d2b5248", "git_parents": ["933e5109edbaae2467d756a2bf8449d09d57cc91"], "node": "cd7b195fa22ebeac0dadc7a833cc8a3c5298719a", "parents": ["6aa7007ec202b3d4b65c13b05cb761c8eeb2fd46"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2078661 - Replace CollectionsMigrationPromoCard image with R.drawable.mozac_ic_kit_tab_groups_list_view r=android-reviewers,skhan\n\nFigma: https://www.figma.com/design/iBmi6I1Q2oSXqJMjguOfwb/Tab-Groups-Android?node-id=25088-32189&t=bkYZy8uo8ujlyB3P-4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335188\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/collections/CollectionsMigrationPromoCard.kt"], "git_node": "ab8802203249f5b2edcbe55add72a8afb31afb75", "git_parents": ["ed6a5a08f468d38ea1c662f47634f36f0d2b5248"], "node": "64566168605b8207c8dcd66d751425aeb9df0485", "parents": ["cd7b195fa22ebeac0dadc7a833cc8a3c5298719a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083796 - Clean-up pseudo-class parsing. r=firefox-style-system-reviewers,boris\n\nNo behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335190\n", "files": ["servo/components/style/gecko/selector_parser.rs"], "git_node": "9e121562ce986ef6074f652b551edda0ee3e4c0a", "git_parents": ["ab8802203249f5b2edcbe55add72a8afb31afb75"], "node": "857ed870d5d50917a65b0e46b4ed803e9f270fe7", "parents": ["64566168605b8207c8dcd66d751425aeb9df0485"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083032 - Skip dirty queue registration for private origins in InitQuotaForOrigin. r=dom-storage-reviewers,asuth\n\nPrivate origins are never written to storage.sqlite, so queuing them only\ntrips the assertion in FlushDirtyOriginInfos once the origin becomes\nwrite-quiescent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334622\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "7b9c18fbe1feb40b283361932f9694ec603e51d1", "git_parents": ["9e121562ce986ef6074f652b551edda0ee3e4c0a"], "node": "3a588554d77ce30153bbc31f0d43e309682fb20c", "parents": ["857ed870d5d50917a65b0e46b4ed803e9f270fe7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083313 - Remove nsDisplayItemWrapper and friends. r=layout-reviewers,dshin\n\nDead code. I noticed it because it was the only TakeItems() call that\nwas early-returning.\n\nRemove another one that can't happen in nsPageContentFrame (TakeItems\nnever yields null).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334831\n", "files": ["layout/generic/nsPageContentFrame.cpp", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h"], "git_node": "d2ea5d20e81239cdab395ea68abe5ac607ab10a8", "git_parents": ["7b9c18fbe1feb40b283361932f9694ec603e51d1"], "node": "111351526ab51842ef5c4f40bc13a2d95a13a3f7", "parents": ["3a588554d77ce30153bbc31f0d43e309682fb20c"], "tags": []}, {"author": "Glenda Leonard \u003cgleonard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081902 - Vendor application-services c0f2af4 r=bdk\n\nGenerated using:\n\n  # ./mach vendor third_party/application-services/moz.yaml -r c0f2af40e5d6ef4f9fa673e48ba3218921a3ed32\n  # ./mach vendor rust --ignore-modified\n  # ./mach uniffi generate\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334711\n", "files": ["third_party/application-services/components/ads-client/docs/usage-javascript.md", "third_party/application-services/components/ads-client/docs/usage-kotlin.md", "third_party/application-services/components/ads-client/docs/usage-swift.md", "third_party/application-services/components/ads-client/src/client.rs", "third_party/application-services/components/ads-client/src/ffi.rs", "third_party/application-services/components/ads-client/src/lib.rs", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/ad_request.rs", "third_party/application-services/components/remote_settings/src/client.rs", "third_party/application-services/components/remote_settings/src/context.rs", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/remotesettings/android/src/main/java/mozilla/appservices/remotesettings/remote_settings.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "c76df403c39aebd764eb3b0dd15a690ff9ae3259", "git_parents": ["d2ea5d20e81239cdab395ea68abe5ac607ab10a8"], "node": "4927985f0f0ac850f8434dee95c922c78df377c3", "parents": ["111351526ab51842ef5c4f40bc13a2d95a13a3f7"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2083713 - Include CoreFoundation in CFTypeRefPtr.h. r=mstange\n\nThe templates call CFRelease and CFRetain, so the header failed to compile\nunless CoreFoundation had already been included.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335189\n", "files": ["xpcom/base/CFTypeRefPtr.h"], "git_node": "856009a8867b428485af4e104425887d84839326", "git_parents": ["c76df403c39aebd764eb3b0dd15a690ff9ae3259"], "node": "bcbaaa4dfb8854f151d452078d54be5c8f71bb8b", "parents": ["4927985f0f0ac850f8434dee95c922c78df377c3"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Add proof test for cropped VideoFrame geometry r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318619\n", "files": ["dom/media/webcodecs/test/mochitest.toml", "dom/media/webcodecs/test/test_videoFrame_croppedVideo.html", "dom/media/webcodecs/test/vp8-pixel-crop.webm"], "git_node": "d95abf7b60cc31dd5fb4eb4d1954f3b01a20c445", "git_parents": ["856009a8867b428485af4e104425887d84839326"], "node": "5203160e45a74d1d00fffccf4fcb3a03380e1e77", "parents": ["bcbaaa4dfb8854f151d452078d54be5c8f71bb8b"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Add a fallible Image addressable-domain query r=gfx-reviewers,padenot,bradwerth\n\nAdd Image::GetAddressableSize(), which returns the size of the pixel buffer\nan image addresses, or Nothing() if the image is invalid or its picture rect\ndoes not lie inside that buffer. Planar and NV images answer from their data\nbecause their GetSize() is only the picture size. Share the picture-rect\noverflow check with PlanarYCbCrData::GetPlaneSizes().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318620\n", "files": ["dom/media/gtest/TestYUVBufferGenerator.cpp", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h", "gfx/tests/gtest/TestImageAddressableSize.cpp", "gfx/tests/gtest/moz.build"], "git_node": "83afc3ad612995a949d670257c6993c413af0d94", "git_parents": ["d95abf7b60cc31dd5fb4eb4d1954f3b01a20c445"], "node": "637e29783b0fdd27a19db800167415dff3d9b527", "parents": ["5203160e45a74d1d00fffccf4fcb3a03380e1e77"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Preserve native coded geometry in VideoFrame r=media-playback-reviewers,padenot\n\nValidate a layers::Image once, in VideoFrame::ValidateImage, and keep the\nresult as the frame's Resource: the image, its format, the size of its pixel\nbuffer as the coded size, and its picture rect. Every VideoFrame is built from\na Resource, either freshly validated or copied from another frame, so a coded\nsize is no longer derived from GetSize(), which for planar images is only the\npicture size. Route decoder output and ImageTrack frames through\nCreateFromImage so they are validated as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318622\n", "files": ["dom/media/webcodecs/ImageTrack.cpp", "dom/media/webcodecs/VideoDecoder.cpp", "dom/media/webcodecs/VideoFrame.cpp", "dom/media/webcodecs/VideoFrame.h", "dom/media/webcodecs/gtest/TestVideoFrame.cpp", "dom/media/webcodecs/gtest/moz.build"], "git_node": "ec9189c984c32800175e0c5011d2b2adc8a50fbf", "git_parents": ["83afc3ad612995a949d670257c6993c413af0d94"], "node": "f9596b8b30ed824308ad93ea3ae83d35cbdb03ab", "parents": ["637e29783b0fdd27a19db800167415dff3d9b527"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Deduplicate internal VideoFrame format conversion r=media-playback-reviewers,padenot\n\nCentralize conversion from VideoPixelFormat to the internal VideoFrame::Format\nwrapper across the construction paths that take a VideoPixelFormat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323462\n", "files": ["dom/media/webcodecs/VideoFrame.cpp"], "git_node": "4480e95fcfd19ec3f296a2066b6edbf25a2dd6ae", "git_parents": ["ec9189c984c32800175e0c5011d2b2adc8a50fbf"], "node": "f707b436c565ca13acb8425fa7880802b862c030", "parents": ["f9596b8b30ed824308ad93ea3ae83d35cbdb03ab"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067602: Relax asserts that NativeLayerRootCA has no sublayers upon destruction. r=mstange\n\nIt's not dangerous to have sublayers when the root layer is destroyed,\nbut we still want to catch it in debug builds. Relax the release assert\nin the destructor, and add an assert in RemoveLayer, which *might* be an\nentry point for where we lose track of sublayers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323052\n", "files": ["gfx/layers/NativeLayerCA.mm"], "git_node": "cbbf04cb07fd7214bc92d9b1efcdff1323171629", "git_parents": ["4480e95fcfd19ec3f296a2066b6edbf25a2dd6ae"], "node": "934db543f485c65acfdff1bbd69ae8fe0e0c8133", "parents": ["f707b436c565ca13acb8425fa7880802b862c030"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081527 - Add simple display for MAC status in HNT Admin r=ini\n\nThis will help users debug differences testing MAC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333455\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.jsx"], "git_node": "68c5a838071c092f2afffb6386e2a6e3ef7e73ff", "git_parents": ["cbbf04cb07fd7214bc92d9b1efcdff1323171629"], "node": "f4a0ea1a307af3b83a7cbac30edad6dd51d5e697", "parents": ["934db543f485c65acfdff1bbd69ae8fe0e0c8133"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083273 - Replace nsCOMPtr pointer conversion with explicit get() in GetCurrentSerialEventTarget(). r=xpcom-reviewers,emilio\n\nC++23 changed how implicit conversion from nsCOMPtr\u003cT\u003e to T* works:\n\n* In C++20, returning an nsCOMPtr is treated as an lvalue, uses nsCOMPtr's\n  const& conversion 'operator T*() const&', and compiles successfully.\n\n* In C++23, returning an nsCOMPtr is treated as a move-eligible xvalue, prefers\n  const&& conversion, hits nsCOMPtr's deleted overload 'operator T*() const&& =\n  delete', and fails to compile.\n\nerror: conversion function from 'const nsCOMPtr\u003cT\u003e' to 'T *' invokes a deleted function\n|   operator T*() const&& = delete;\n\nUse get() to preserve the existing borrowed-pointer API. Thread-local\nstorage holds a strong reference to the current thread\n(nsISerialEventTarget), so destroying the local nsCOMPtr does not\ninvalidate the returned pointer.\n\nChanging the return type to transfer a strong reference would require\nauditing hundreds of callers and files, adapting their ownership\nhandling. That API change is unnecessary for this compilation fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334804\n", "files": ["xpcom/threads/nsThreadUtils.cpp"], "git_node": "5fb91ac72a52c550fa2dd09b8af50f3810fd26a5", "git_parents": ["68c5a838071c092f2afffb6386e2a6e3ef7e73ff"], "node": "effaa5fcc04615e4860005d84a60ff6b5e637544", "parents": ["f4a0ea1a307af3b83a7cbac30edad6dd51d5e697"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082040. r=layout-reviewers,dshin\n\nMake sure we're consistent about which state we call\nUpdateEmbeddedBrowsingContextDependentData in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334853\n", "files": ["layout/generic/nsSubDocumentFrame.cpp"], "git_node": "b48bed5acc18ec2ffcf01e0cab60c58bfe890dd8", "git_parents": ["5fb91ac72a52c550fa2dd09b8af50f3810fd26a5"], "node": "f0ad6e86ef281106adb6f75a9e1d20e70d59590d", "parents": ["effaa5fcc04615e4860005d84a60ff6b5e637544"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083218 - Account for display: contents properly in should_suppress_line_break. r=firefox-style-system-reviewers,dshin\n\nA display: contents element is not really floating / abspos.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334843\n", "files": ["servo/components/style/style_adjuster.rs", "testing/web-platform/tests/css/css-ruby/crashtests/oof-display-contents.html"], "git_node": "66ecef0d23348217a1877ebd5c4e97d84793555f", "git_parents": ["b48bed5acc18ec2ffcf01e0cab60c58bfe890dd8"], "node": "95b3005816aa916f3de6b18a0b89896c02258875", "parents": ["f0ad6e86ef281106adb6f75a9e1d20e70d59590d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081280. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334807\n", "files": ["layout/style/Loader.cpp", "testing/web-platform/tests/svg/as-image/external-resource-data-url-import-helper.sub.svg", "testing/web-platform/tests/svg/as-image/external-resource-data-url-import.sub.html"], "git_node": "f2727bd6db14f8fbf5409fd4822ffa93b9e1ed1a", "git_parents": ["66ecef0d23348217a1877ebd5c4e97d84793555f"], "node": "c8a64c5054c9c2f3806f52019b75785e319269f9", "parents": ["95b3005816aa916f3de6b18a0b89896c02258875"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2078920 - Remove the no-fission variant from the Android performance tests r=sparky,perftest-reviewers,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333438\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/variants.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "649fd2f1257f731a9cdad2c93ce96d51312d2c57", "git_parents": ["f2727bd6db14f8fbf5409fd4822ffa93b9e1ed1a"], "node": "d6974f09c4520116498ec14124a9942424fc457a", "parents": ["c8a64c5054c9c2f3806f52019b75785e319269f9"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Implement CSSNumericValue.add(); r=emilio,firefox-style-system-reviewers\n\nImplement CSSNumericValue.add() according to the CSS Typed OM specification.\n\nIntroduce an internal Add() overload to share the addition algorithm with the\nupcoming sub() implementation. The overload uses a reusable helper for\ncomputing values with the same unit, which can also be used by other arithmetic\nmethods in future.\n\nExtend CSSMathSum::Create() to support constructing sums from already validated\nDOM numeric values, without requiring an intermediate Stylo representation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333684\n", "files": ["layout/style/typedom/CSSMathSum.cpp", "layout/style/typedom/CSSMathSum.h", "layout/style/typedom/CSSNumericValue.cpp", "layout/style/typedom/CSSNumericValue.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini"], "git_node": "02b2bdeea1678f8f904acf55945f04c19fd59bbd", "git_parents": ["649fd2f1257f731a9cdad2c93ce96d51312d2c57"], "node": "784d62b13e4435d05197bb1e1fe3ebdc97aa88a0", "parents": ["d6974f09c4520116498ec14124a9942424fc457a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078920 - Remove the no-fission variant from the Android performance tests r=sparky,perftest-reviewers,taskgraph-reviewers,bhearsum\" for causing perfdocs lint failures\n\nThis reverts commit 649fd2f1257f731a9cdad2c93ce96d51312d2c57.\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/variants.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "8b498a332ee654bce4fda9c32d4edc06437fb6e4", "git_parents": ["02b2bdeea1678f8f904acf55945f04c19fd59bbd"], "node": "8145de10cb6b9c4cba54fa2add28fbd2fee7a8a4", "parents": ["784d62b13e4435d05197bb1e1fe3ebdc97aa88a0"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2037068 - Document distribution.ini in the Firefox source docs. r=jhirsch,Gijs DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333776\n", "files": ["browser/docs/DistributionIni.md", "browser/docs/index.md", "browser/moz.build"], "git_node": "5a7c1b84d23015ef533546c15dd4773db58f249c", "git_parents": ["8b498a332ee654bce4fda9c32d4edc06437fb6e4"], "node": "058d4146ae3552375768c9f6c01cc096f0576ee6", "parents": ["8145de10cb6b9c4cba54fa2add28fbd2fee7a8a4"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082400 - Ensure map/set iterator link pointer uses atomic accesses in concurrent marking builds r=spidermonkey-reviewers,iain\n\nUsually access to GC edges is mediated by barrier wrappers such as GCPtr which\nuse the atomic operations where necessary. Here we take a pointer to an object\nslot containing a private value and cast it to a raw pointer, thus bypassing\nthe wrapper. (This is also undefined behaviour).\n\nThe patch adds an abstraction that keepts a pointer to the heap slot internally\nwithout casting it and provides methods to get or set its contents as a private\npointer while avoiding unnecessary GC barriers but using atomic operatations\nwhere necessary.\n\nThe NativeObject method to return a typed pointer to a private slot is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334079\n", "files": ["js/src/builtin/OrderedHashTableObject.h", "js/src/gc/Barrier.h", "js/src/vm/NativeObject.h"], "git_node": "e6398f8f9f8749fedec58425d7cd2eab8cc4b80e", "git_parents": ["5a7c1b84d23015ef533546c15dd4773db58f249c"], "node": "b995c25ec65c7bffe11a566120e7d5d64c8936b1", "parents": ["058d4146ae3552375768c9f6c01cc096f0576ee6"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083814 - Free the directive on early returns in nsCSPParser::handleRequireTrustedTypesForDirective r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335222\n", "files": ["dom/security/nsCSPParser.cpp", "testing/web-platform/meta/trusted-types/__dir__.ini"], "git_node": "259c1cf035012cd0c8fce8ae8733f1d52414a1cd", "git_parents": ["e6398f8f9f8749fedec58425d7cd2eab8cc4b80e"], "node": "22e1528fbe46f5bdbaac259c30e0fe0421dabc56", "parents": ["b995c25ec65c7bffe11a566120e7d5d64c8936b1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082327 - Add a pref to avoid compiling inline event handlers in \u003csvg:use\u003e shadow trees. r=longsonr,smaug\n\nSee https://github.com/w3c/svgwg/issues/1211.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334019\n", "files": ["dom/base/nsDeprecatedOperationList.inc", "dom/base/use_counter_metrics.yaml", "dom/events/EventListenerManager.cpp", "dom/locales/en-US/chrome/dom/dom.properties", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/svg/struct/scripted/use-inline-event-handlers.tentative.html.ini", "testing/web-platform/tests/svg/struct/scripted/use-inline-event-handlers.html"], "git_node": "8fc3285e0495fe08a510b40899f32c661c788e4a", "git_parents": ["259c1cf035012cd0c8fce8ae8733f1d52414a1cd"], "node": "3ed502bc86f2288ccc120468cc883bd86b433e0a", "parents": ["22e1528fbe46f5bdbaac259c30e0fe0421dabc56"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080958 - Show the text selection menu only for a selection the user made. r=ngrato\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo test manually, set `browser.highlightToSearch.featureGate` to true,\nclick a page element that selects its text for you, such as a\nclick-to-select code block, and confirm the menu does not appear. Then\ndrag across some text, or double-click a word, and confirm it does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333036\n", "files": ["browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "fa5a6e4fd8947f5b38caf413f1e092daf0c0ccc7", "git_parents": ["8fc3285e0495fe08a510b40899f32c661c788e4a"], "node": "7e33c6559481e9e4766125f8456b5ea63d8a74e9", "parents": ["3ed502bc86f2288ccc120468cc883bd86b433e0a"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079975 - Allow SERP telemetry providers to ignore query params when matching clicked URLs to components - r=search-reviewers,Standard8\n\nAdds an optional ignoredQueryParamNames array to the search-telemetry-v2 schema. compareUrls skips those params when scoring, so links whose param values change between page load and click (e.g. a click-time token) can still be matched to their component.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332456\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/schema/search-telemetry-v2-schema.json", "browser/components/search/schema/search-telemetry-v2-ui-schema.json", "browser/components/search/test/browser/telemetry/browser_search_telemetry_engagement_query_params.js", "browser/components/search/test/unit/test_search_telemetry_compare_urls.js"], "git_node": "73c0e3522e2933d3cec71e3751254ae95116b8b9", "git_parents": ["fa5a6e4fd8947f5b38caf413f1e092daf0c0ccc7"], "node": "56c1a0d54fae972c80283d71a2634ef20b2377be", "parents": ["7e33c6559481e9e4766125f8456b5ea63d8a74e9"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082871 - Let rotated SVG images and plain rects be drawn by WebRender again. r=emilio\" for causing reftest failures in text-simple.svg\n\nThis reverts commit 21fcfacd8833b98417a8f340fce3d5b3f76f2941.\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGeometryFrame.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "5d5cda32caca190533bcb20056197a6030d861fb", "git_parents": ["73c0e3522e2933d3cec71e3751254ae95116b8b9"], "node": "1fe1150cdc703a4b7003e7819181381cc3f3d945", "parents": ["56c1a0d54fae972c80283d71a2634ef20b2377be"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2081666 - Embed the benchmark JS sources into raptor profiles r=perftest-reviewers,mstange,kshampur\n\nBenchmark profiles from CI can't show JS source code. The benchmark is\nserved from a local web server that is gone by the time someone looks at\nthe profile, and the source maps were never fetched.\n\nRaptor now tells profiler-edit which directory the benchmark server\nserved, with the new --map-source-paths option. profiler-edit reads the\nJS sources and their source maps from that directory and embeds them,\nincluding the original sources from the maps' sourcesContent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333777\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/__init__.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py", "testing/mozbase/mozgeckoprofiler/tests/manifest.toml", "testing/mozbase/mozgeckoprofiler/tests/test_symbolication.py", "testing/raptor/raptor/benchmark.py", "testing/raptor/raptor/browsertime/base.py", "testing/raptor/raptor/etw_profile.py", "testing/raptor/raptor/gecko_profile.py", "testing/raptor/raptor/perf_profile.py", "testing/raptor/raptor/perftest.py", "testing/raptor/raptor/raptor_profiling.py", "testing/raptor/raptor/samply_profile.py", "testing/raptor/test/python.toml", "testing/raptor/test/test_benchmark.py", "testing/raptor/test/test_raptor_profiling.py"], "git_node": "7fa1401e79a68392a204693ef304d0a54f05d833", "git_parents": ["5d5cda32caca190533bcb20056197a6030d861fb"], "node": "50305afa6f24d9e9032405fafaba5dfa87db13fa", "parents": ["1fe1150cdc703a4b7003e7819181381cc3f3d945"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071083 - [Nova] Tighten up spacing between sidebar options in Settings panel r=sidebar-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334624\n", "files": ["browser/components/sidebar/sidebar-customize.css"], "git_node": "855ec7c7ed01d26728fad93214ed819de12393d9", "git_parents": ["7fa1401e79a68392a204693ef304d0a54f05d833"], "node": "fd24b28a3dc6a5059fa2ddbfcc31246992b1c34b", "parents": ["50305afa6f24d9e9032405fafaba5dfa87db13fa"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066018 - Part 1: Stop holding a tab's audio after a permanent audio-focus loss. r=media-playback-reviewers,azebrowski\n\nA permanent audio-focus loss now pauses the tab's audible sources once and\nlets go of them: the page is not blocked from starting audio, and the media\nelement, Web Audio and Web Speech treat the pause as an ordinary one that the\npage can undo. A Web Audio or Web Speech resume() the page asked for during an\nearlier transient interruption is not carried out by the permanent loss; the\npage has to resume again.\n\nA permanent loss used to be handled like a transient one: the audible sources\nwere paused, the page was blocked from starting audio, and the paused sources\nwere kept for a resume that only an audio-focus gain could deliver. After a\npermanent loss the platform sends no gain until the browser requests focus\nagain, which only happens once playback starts, so the tab could never play\nagain; for example, a video could not be resumed after another app took over\nthe audio. Letting go of the paused sources matches the spec, which empties\nthe interrupted set when the session becomes inactive [1], and the parent\nside, which already ends the audio session as inactive. Pausing them once\non a permanent loss is existing behaviour and is kept.\n\n[1] https://w3c.github.io/audio-session/#notify-the-states-change\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331894\n", "files": ["dom/ipc/PContent.ipdl", "dom/media/mediacontrol/AudioFocusInterrupt.h", "dom/media/mediacontrol/AudioSessionManager.h", "dom/media/mediacontrol/ContentMediaController.cpp", "dom/media/mediacontrol/ContentMediaController.h", "dom/media/mediacontrol/MediaControlIPC.h", "dom/media/mediacontrol/MediaController.cpp", "dom/media/mediacontrol/moz.build", "dom/media/mediacontrol/tests/gtest/TestContentMediaController.cpp", "dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/webaudio/AudioContext.cpp", "dom/media/webaudio/AudioContext.h", "dom/media/webaudio/AudioDestinationNode.cpp", "dom/media/webspeech/synth/ipc/SpeechSynthesisChild.cpp", "dom/media/webspeech/synth/ipc/SpeechSynthesisChild.h"], "git_node": "19b510c0401a82747bc5f66e44ea3333aa568373", "git_parents": ["855ec7c7ed01d26728fad93214ed819de12393d9"], "node": "28e583f527a93aac11120fc7eee411a8c38238fc", "parents": ["fd24b28a3dc6a5059fa2ddbfcc31246992b1c34b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066018 - Part 2: Test that a permanent audio-focus loss stops holding a tab while a transient one keeps it gated. r=media-playback-reviewers,azebrowski\n\nCheck each source, a media element, Web Audio and Web Speech, after a\ntransient loss and after a permanent loss: only the transient loss keeps\nthe page from starting it, and the sources resume when the interruption\nends. A source paused by a permanent loss, alone or after a transient\none, is not resumed by a later focus gain or a window thaw, and the page\ncan start it again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331895\n", "files": ["dom/media/mediacontrol/tests/browser/browser_audio_focus_interrupt_blocks_start.js", "dom/media/mediacontrol/tests/gtest/TestContentMediaController.cpp"], "git_node": "453e46c5031279becf8a7469fc83ae6f14975f35", "git_parents": ["19b510c0401a82747bc5f66e44ea3333aa568373"], "node": "632f3a797c73ecb5b930ee4fe8c619549952e73b", "parents": ["28e583f527a93aac11120fc7eee411a8c38238fc"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066018 - Part 3: Test system audio-focus changes reported through GeckoView. r=geckoview-reviewers,owlish\n\nDrive a platform audio-focus change through the GeckoView media session,\nthe path the embedder uses, and check the page's media end to end: after\na permanent loss the page can play again, while during a transient loss\nit cannot until a focus gain resumes the media.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331896\n", "files": ["mobile/android/geckoview/src/androidTest/assets/www/audio_focus_interrupt.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/MediaSessionTest.kt"], "git_node": "89b79eee285901198a997893de0abbe3bde7e25d", "git_parents": ["453e46c5031279becf8a7469fc83ae6f14975f35"], "node": "3e6f122dc21f144fbaa24aeadfb57258de5c7db3", "parents": ["632f3a797c73ecb5b930ee4fe8c619549952e73b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066018 - Part 4: Decide Web Audio's interruption suspend and resume from the context's own state. r=media-playback-reviewers,padenot\n\nWhen an audio-focus interruption starts, Web Audio suspends each context that\nthe page and media control want to run. This includes a context in a suspended\nwindow and a context that is still resuming. When the interruption stops, Web\nAudio resumes each context that the interruption suspended. Nothing resumes\nduring the interruption. The resume metric counts only these resumes.\n\nBefore, Web Audio used the reported state of the context. This state changes\nonly after the audio graph applies a suspend or a resume. Thus, a context that\nwas resuming could play during an interruption. Also, a short interruption\ncould leave a context suspended, and the page could not resume it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334708\n", "files": ["dom/media/mediacontrol/tests/browser/browser_audio_focus_interrupt_suspend_resume.js", "dom/media/webaudio/AudioContext.cpp", "dom/media/webaudio/AudioContext.h", "dom/media/webaudio/AudioDestinationNode.cpp"], "git_node": "4145719ede73dc32e5c65c43b5e87ef4b1ef8cd6", "git_parents": ["89b79eee285901198a997893de0abbe3bde7e25d"], "node": "33f48e997d936d9a7a5c3e53ba5e04091e090561", "parents": ["3e6f122dc21f144fbaa24aeadfb57258de5c7db3"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066018 - Part 5: Wait for audio sessions to be active in the audio-focus telemetry test. r=media-playback-reviewers,padenot\n\nThe telemetry tasks that interrupt or resume a tab now wait until its audio\nsessions are active before they check the probes and drive the interruption:\nthe interrupt-and-resume task and the resume-without-interruption task wait for\nthe effective audio-session type to become playback, and the per-session task\nalso waits for the main frame's media to be audible.\n\nThey used to proceed as soon as the media played or the controller was active.\nA session becomes active, and is selected, only once its media is reported\naudible, which can come later. When it did, the selection probes were still\nempty and the interruption found no active session, so no outcome was recorded,\nand a resume-without-interruption check passed without a session to test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334709\n", "files": ["dom/media/mediacontrol/tests/browser/browser_audiosession_telemetry.js"], "git_node": "7e1500ac86c8e60915b8c20764c91b4c81677c2f", "git_parents": ["4145719ede73dc32e5c65c43b5e87ef4b1ef8cd6"], "node": "ba857c461e3f8ece86b1821bfb0ebd0d0b65f133", "parents": ["33f48e997d936d9a7a5c3e53ba5e04091e090561"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 1: Make GeckoChildProcessHost refcounted, r=ipc-reviewers,necko-reviewers,media-playback-reviewers,mccr8,gfx-reviewers,kershaw,padenot,aosmond,device-api-reviewers,gstoll\n\nThe lifecycle of this type right now is very annoying and complex, and\nvarious child process implementations have had to do different things in\norder to deal with the unfortunate lifecycle properties.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318516\n", "files": ["dom/base/ChromeUtils.cpp", "dom/file/ipc/RemoteLazyInputStreamThread.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPProcessParent.cpp", "dom/media/gmp/GMPProcessParent.h", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h", "dom/webserial/SerialManagerChild.h", "gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUChild.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/vr/ipc/VRChild.cpp", "gfx/vr/ipc/VRChild.h", "gfx/vr/ipc/VRProcessManager.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/ForkServiceChild.cpp", "ipc/glue/ForkServiceChild.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTestParent.h", "netwerk/base/nsIOService.h", "netwerk/ipc/SocketProcessHost.cpp", "netwerk/ipc/SocketProcessHost.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "xpcom/base/MemoryTelemetry.cpp"], "git_node": "ceabad83d3ed7d5c5ed4571d9c95729f9dd4672a", "git_parents": ["7e1500ac86c8e60915b8c20764c91b4c81677c2f"], "node": "dec9e8e19f12b526bc6338ece604aa5c4ccf413d", "parents": ["ba857c461e3f8ece86b1821bfb0ebd0d0b65f133"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 2: Keep XRE_GetAsyncIOMessageLoop working later during shutdown, r=ipc-reviewers,mccr8\n\nThis keeps the object valid throughout IPC I/O thread shutdown tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322480\n", "files": ["ipc/glue/IOThread.cpp", "ipc/glue/IOThread.h"], "git_node": "1ae7aeb125fc2fc4cc63302f7c00b7351afee4ba", "git_parents": ["ceabad83d3ed7d5c5ed4571d9c95729f9dd4672a"], "node": "62a8491bcfa6d2d02db0660ca7049cd12a1cd6fc", "parents": ["dec9e8e19f12b526bc6338ece604aa5c4ccf413d"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 3: Keep IsOnCurrentThread working further into shutdown for MessageLoop::EventTarget, r=mccr8\n\nBefore this change, we would stop considering `IsOnCurrentThread` during\n`WillDestroyCurrentMessageLoop` callbacks, which could cause it to\nspuriously begin returning false while code is still running on the\nthread.\n\nI also refactored the code somewhat to make the timing of `BeginDestroy`\nmore consistently & explicitly before all other destruction observers\nhave been run.\n\nIn the future, I expect we'll want to make the IPC I/O thread behave\nmore like XPCOM threads, and have a clear atomic moment when runnables\nare no longer processed, and the queue is empty, but that was left as a\nfuture project.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328924\n", "files": ["ipc/chromium/src/base/message_loop.cc"], "git_node": "b8b0accc5cf241e1ab351b1e169d82107de9f08c", "git_parents": ["1ae7aeb125fc2fc4cc63302f7c00b7351afee4ba"], "node": "7169058a1daa989f129c380d209f39568e230208", "parents": ["62a8491bcfa6d2d02db0660ca7049cd12a1cd6fc"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082772 - Create a new verifyTheShowOriginalOptionFromTheTranslationBannerTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334417\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt"], "git_node": "96c37ebc8a73cc79564f5c2b77beec631a892798", "git_parents": ["b8b0accc5cf241e1ab351b1e169d82107de9f08c"], "node": "f0f17fb06b5f9b4800182d9f9c63d30ebba1d3e2", "parents": ["7169058a1daa989f129c380d209f39568e230208"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2082328 - Fix debug-only deadlock between async statement execution and Statement::finalize. r=mak\n\nBug 2037645 made Connection::isConnectionReadyOnThisThread take\nsharedAsyncExecutionMutex in debug builds. The async thread reaches it from\nConnection::stepStatement while holding sharedDBMutex, whereas\nStatement::internalFinalize on the main thread takes sharedAsyncExecutionMutex\nand then the SQLite db mutex in sqlite3_finalize. Finalizing a statement while\nan async execution was stepping on the same connection could therefore\ndeadlock.\n\nReturn early for the async thread before taking the lock, as the async thread\nnever consulted connectionReady() anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335210\n", "files": ["storage/mozStorageConnection.cpp", "storage/test/unit/test_statement_finalize_during_async.js", "storage/test/unit/xpcshell.toml"], "git_node": "1046b35299f07936a9e18216846950150f273b3b", "git_parents": ["96c37ebc8a73cc79564f5c2b77beec631a892798"], "node": "d240f11dfa916711920e9166bcdd4939298ff222", "parents": ["f0f17fb06b5f9b4800182d9f9c63d30ebba1d3e2"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2058306 - Only allow reftest system content with a pref, r=tschuster\n\nThis is a simplification of the existing checks based on the document's\nURI. While it's more permissive when the pref is enabled, the pref will\nonly ever be enabled during reftests, meaning that the scope should be\neven more limited.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314499\n", "files": ["dom/ipc/BrowserParent.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/ipc/DocumentLoadListener.cpp", "testing/profiles/reftest/user.js"], "git_node": "4951f63a95818b036549b4f78e7254d43513c3cd", "git_parents": ["1046b35299f07936a9e18216846950150f273b3b"], "node": "48f0b338afd1d29236f9afb22cc6ad350b6116a4", "parents": ["d240f11dfa916711920e9166bcdd4939298ff222"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 1765351 - Move privacy pref checks for content script resources and proxied connections into StoragePrincipalHelper. r=necko-reviewers,emz,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331059\n", "files": ["netwerk/base/LoadInfo.cpp", "netwerk/base/nsNetUtil.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "toolkit/components/antitracking/StoragePrincipalHelper.cpp", "toolkit/components/antitracking/StoragePrincipalHelper.h"], "git_node": "5aae2d2bc343be0fafd9e916d7ac6f3c099aaf56", "git_parents": ["4951f63a95818b036549b4f78e7254d43513c3cd"], "node": "248a625aea0282faf56879d65b165dcd64e64266", "parents": ["48f0b338afd1d29236f9afb22cc6ad350b6116a4"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080958 - Show the text selection menu only for a selection the user made. r=ngrato\" for causing failures at browser_clipboard_paste_chat_shortcuts.js.\n\nThis reverts commit fa5a6e4fd8947f5b38caf413f1e092daf0c0ccc7.\n", "files": ["browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "6ec2374eedb6da01d584e18cfcd07c9872755852", "git_parents": ["5aae2d2bc343be0fafd9e916d7ac6f3c099aaf56"], "node": "20896619dbca630b663a8a988fb22c98618cadd6", "parents": ["248a625aea0282faf56879d65b165dcd64e64266"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045003 - Defer unbinding of unlinked content until the end of each shutdown cycle collection. r=smaug\" for causing wpt failures in HasSlots.\n\nThis reverts commit 783e9459105cde1e84dc4c3ce209af18f0458645.\n", "files": ["dom/base/FragmentOrElement.cpp", "dom/base/nsJSEnvironment.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_range_shadow_root_shutdown.js"], "git_node": "e3d2ccb869c27d5fe42c6540a48d5f8ab42b1270", "git_parents": ["6ec2374eedb6da01d584e18cfcd07c9872755852"], "node": "4caf536d532a19103853b18deb6bd14175d71d68", "parents": ["20896619dbca630b663a8a988fb22c98618cadd6"], "tags": []}, {"author": "Fluorescent \u003cmozbugzilla.mushily885@passmail.net\u003e", "branch": "default", "desc": "Bug 2082173 - Add an option to turn off JIT context initialization in non-main processes; r=spidermonkey-reviewers,mgaudet\n\ncurrently, firefox crashes when running in a jitless environment (e.g., GrapheneOS\nwithout a compatibility flag enabled, GNU/Linux with sebool deny_execmem=1) because\nit always tries to initialize a jitted context and cannot map executable pages when\ndoing so.\n\nthis fixes it by adding an option `javascript.options.other_processes_disable_jit'\nthat disables jit initialization in all other processes (like the current flag\n`javascript.options.main_process_disable_jit').\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333970\n", "files": ["js/xpconnect/src/nsXPConnect.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f0757ab94e1a5da7dd11c33bcbd94674ace3a2ab", "git_parents": ["e3d2ccb869c27d5fe42c6540a48d5f8ab42b1270"], "node": "5674670c5e6aa5b555cff33435c9e0fd16482540", "parents": ["4caf536d532a19103853b18deb6bd14175d71d68"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078425 - Inline class field initializers that just set 0 r=spidermonkey-reviewers,yulia\n\nInstead of building a .initializers closure array and calling into it from the constructor, inline directly into the constructor's own bytecode when every instance field has a plain name and a 0 initializer. Falls back to the existing .initializers behavior for any non-qualifying field, and caps at 8 inlinable fields.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332616\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/Parser.cpp", "js/src/frontend/Parser.h", "js/src/frontend/SharedContext.h", "js/src/jit-test/tests/fields/inline-zero-fields.js", "js/src/vm/SharedStencil.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "4bfe5534ba3c1922eed298cea8d07ebc01eac261", "git_parents": ["f0757ab94e1a5da7dd11c33bcbd94674ace3a2ab"], "node": "c067211f421d9dec31f1f2a793028c349f99dcb8", "parents": ["5674670c5e6aa5b555cff33435c9e0fd16482540"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2078920 - Remove the no-fission variant from the Android performance tests r=sparky,perftest-reviewers,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333438\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/variants.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "8a092733a384305735acbd41fb71e64edd5bea99", "git_parents": ["4bfe5534ba3c1922eed298cea8d07ebc01eac261"], "node": "830de9529008b274c8f37d343f43c6841e975f5a", "parents": ["c067211f421d9dec31f1f2a793028c349f99dcb8"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\naf -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nan -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nar -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nast -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\naz -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbe -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbg -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbn -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbo -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbqi -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbr -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbrx -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nbs -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e20\nca -\u003e 886eb0c57d0d674215573ac5aced6bcd677f9e2