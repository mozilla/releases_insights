e959f59d9a7\nxh -\u003e 320f36ab4e482ba4a46f58a7865e3e959f59d9a7\nzam -\u003e 320f36ab4e482ba4a46f58a7865e3e959f59d9a7\nzh-CN -\u003e 320f36ab4e482ba4a46f58a7865e3e959f59d9a7\nzh-TW -\u003e 320f36ab4e482ba4a46f58a7865e3e959f59d9a7\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "011ffe6249f9d7e4843598dbe3636839bc4f9ced", "git_parents": ["2df7d1b9d6b5b134ad3f04d251246d609594aa3f"], "node": "ed96d30d3fc9a170b5e6444a332f6f73cf3e0d18", "parents": ["0df18079796c1959fcb0b0e3d6687de1ebcb6ccc"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069097: Fix excess dirty-origin writes at startup. r=ArnaudBienner\" for causing failures at test_unaccessedOrigins.js.\n\nThis reverts commit 54e4f79368e5050ba88ef2a4298f520590e31005.\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CommonMetadata.h"], "git_node": "fdb4de23c12057868b2959df176db0955a589b7d", "git_parents": ["011ffe6249f9d7e4843598dbe3636839bc4f9ced"], "node": "ba75a55799750b6def7dcb7e0804b0bc008731f2", "parents": ["ed96d30d3fc9a170b5e6444a332f6f73cf3e0d18"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077541 - Reduce vertical spacing between vertical tabs to 4px in compact mode r=desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332191\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "9fc650cec7e601004a7ba09ad6b8cfa74c3fa3f8", "git_parents": ["fdb4de23c12057868b2959df176db0955a589b7d"], "node": "a7f5e3a138ed32fbe330fc022d31423515a0a4a4", "parents": ["ba75a55799750b6def7dcb7e0804b0bc008731f2"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1953361 - Don't let a click's select-all clobber text typed after a focusing mousedown. r=urlbar-reviewers,dao\n\nA key typed between the mousedown that focuses the input and the click\ninserted its character, then the click selected it and the next key\nreplaced it. Typing now prevents the click from selecting all, in both\nUrlbarInputBase and SmartbarInput's forked copy of this logic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331683\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser/browser.toml", "browser/components/urlbar/tests/browser/browser_urlbar_typingRace.js"], "git_node": "6935fb255820716ff92d36ecd138ea25c785e81f", "git_parents": ["9fc650cec7e601004a7ba09ad6b8cfa74c3fa3f8"], "node": "fcc8524dd74bd85d0216e86fbdd00cda0a9cb176", "parents": ["a7f5e3a138ed32fbe330fc022d31423515a0a4a4"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079744 - Convert verifyTheSummarizePagesToggleBehaviourTest regression UI test to the efficiency framework r=aaronmt\n\n\u2757 I had to massively refactor the legacy test because of missing steps, improper assertions and other inconsistencies.\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705 (both TAE and legacy)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332027\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsPageSummariesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsPageSummariesSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsPageSummariesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/BrowserRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuPageSummariesRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/ThreeDotMenuMainRobot.kt"], "git_node": "3930f6b06090bc257f2efa39b59bd06f145724da", "git_parents": ["6935fb255820716ff92d36ecd138ea25c785e81f"], "node": "aa0f4ec46e494d6c47c69b7aba3f5089792c22ae", "parents": ["fcc8524dd74bd85d0216e86fbdd00cda0a9cb176"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2074894 Don't expose Gecko patch level in Opus User Comment r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330911\n", "files": ["dom/media/encoder/OpusTrackEncoder.cpp"], "git_node": "53ce79fd2924ac47190ee8d4c11f540f6c3406b3", "git_parents": ["3930f6b06090bc257f2efa39b59bd06f145724da"], "node": "c58529c42f50cb456f8bee24161b6d5ad3ab74eb", "parents": ["aa0f4ec46e494d6c47c69b7aba3f5089792c22ae"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 1: Change existing APIs to record atom references to allow wrapping r=spidermonkey-reviewers,jandem\n\nSymbols may need to be wrapped when they are passed between zones. This changes\nthe internal and external APIs which currently update the atom reference bitmap\nto refer to wrapping symbols.\n\nThe existing external APIs are replaced by a shim over the new APIs. They are\nreplaced in a later patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331073\n", "files": ["js/public/Zone.h", "js/src/debugger/Debugger.cpp", "js/src/debugger/Environment.cpp", "js/src/debugger/Frame.cpp", "js/src/debugger/Object.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/JSContext.h", "js/src/vm/SymbolType.cpp"], "git_node": "febb26bdcf66da42606dba79d9461e009fe00d3c", "git_parents": ["53ce79fd2924ac47190ee8d4c11f540f6c3406b3"], "node": "d132ff29735e849f6a19debdff2a38d6b485f41e", "parents": ["c58529c42f50cb456f8bee24161b6d5ad3ab74eb"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 2: Merge atom reference bitmap recordRef methods into JSContext r=spidermonkey-reviewers,jandem\n\nThese will do more than just update the atom reference bitmap so merge these\ninto their JSContext callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331074\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h"], "git_node": "5faf0b483e468272565214332b33ebac6a995271", "git_parents": ["febb26bdcf66da42606dba79d9461e009fe00d3c"], "node": "9676b4d0c55dca088dcf83e9a974c431c84e944a", "parents": ["d132ff29735e849f6a19debdff2a38d6b485f41e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 3: Update the browser to call JS_WrapId function in place of JS_MarkCrossZoneId r=dom-core-reviewers,smaug\n\nThis new function now also wraps symbols when appropriate. It is fallible\nunlike the function it replaces.\n\nUse of JS_MarkCrossZoneIdValue is replaced with JS_WrapValue.\n\nreview comments for patch 3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331075\n", "files": ["dom/base/ChromeUtils.cpp", "dom/base/MaybeCrossOriginObject.cpp", "dom/base/nsGlobalWindowOuter.cpp", "dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "js/public/Zone.h", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/vm/JSContext-inl.h", "js/xpconnect/src/ExportHelpers.cpp", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCWrappedNativeInfo.cpp", "js/xpconnect/src/XPCWrappedNativeJSOps.cpp", "js/xpconnect/wrappers/XrayWrapper.cpp"], "git_node": "67a2e22962212c83d26caddb9e060a5140827ec4", "git_parents": ["5faf0b483e468272565214332b33ebac6a995271"], "node": "f0cb937922c2c34a063bb973a549556f32b1a046", "parents": ["9676b4d0c55dca088dcf83e9a974c431c84e944a"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 4: Extend JS::Symbol to support allocating per-zone wrappers r=spidermonkey-reviewers,jandem\n\nAdds methods to query whether a symbol is shared (canonical, allocated in the\natoms zone) or local (a wrapper, not allocated in the atoms zone).\n\nThis changes the symbol header pointer for a local symbol to point to its\nshared symbol. For non-unique and shared symbols the header pointer\ncontinues to point to the description atom.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331076\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/Cell.h", "js/src/gc/TraceMethods-inl.h", "js/src/vm/SymbolType.cpp", "js/src/vm/SymbolType.h"], "git_node": "b067bc41fda4fced912eb2ce40109900a1114d6e", "git_parents": ["67a2e22962212c83d26caddb9e060a5140827ec4"], "node": "103f8430d93b2d1a2af1ab3f831603030a2875bf", "parents": ["f0cb937922c2c34a063bb973a549556f32b1a046"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 5: Allocate local/shared symbol pairs for unique symbols and implement wrapping r=spidermonkey-reviewers,jandem\n\nThis is the main patch that changes the way symbols are allocated. For unique\nsymbols we allocate a local symbol and make it point to a shared symbol. Local\nsymbols are wrapped when being moved between zones so that JS always sees the\nlocal symbol.\n\nTests are updated to take account of the fact that unqiue symbols are no longer\npresent in atom reference bitmap.\n\nNot using the atoms reference bitmap (which is quite conservative) means we can\ncollect symbols sooner in some cases.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331077\n", "files": ["js/src/builtin/FinalizationRegistryObject.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/builtin/WeakRefObject.cpp", "js/src/gc/Allocator.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/Cell.h", "js/src/gc/Marking.cpp", "js/src/gc/RootMarking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.h", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/jit-test/tests/gc/bug-2029769.js", "js/src/jit-test/tests/gc/bug-2042465.js", "js/src/jit-test/tests/gc/bug-2061775.js", "js/src/jit-test/tests/gc/marked-atoms.js", "js/src/jit-test/tests/gc/symbols-as-weakmap-keys.js", "js/src/jit/VMFunctions.cpp", "js/src/jl", "js/src/proxy/Proxy.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/Compartment.cpp", "js/src/vm/EqualityOperations.cpp", "js/src/vm/JSAtomUtils.h", "js/src/vm/JSContext-inl.h", "js/src/vm/JSContext.cpp", "js/src/vm/SymbolType.cpp", "js/src/vm/SymbolType.h"], "git_node": "d845966f7bf2d20968f4b5a70a7b208e3a3ecf10", "git_parents": ["b067bc41fda4fced912eb2ce40109900a1114d6e"], "node": "017a92ba04d536d43eafc7cf769f3463d2ac3532", "parents": ["103f8430d93b2d1a2af1ab3f831603030a2875bf"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 6: Add some tests to exercise symbols being passed between zones r=spidermonkey-reviewers,jandem\n\nI think our existing tests already cover most of this but having some explicit\ntests for this can't hurt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331078\n", "files": ["js/src/jit-test/tests/gc/symbol-cross-zone-identity.js", "js/src/jit-test/tests/gc/symbol-cross-zone-weakref-finalization.js"], "git_node": "656b399bff950b11cb4f35ccdf7895b95e335a8c", "git_parents": ["d845966f7bf2d20968f4b5a70a7b208e3a3ecf10"], "node": "187b504e0de455a41a17a0992a89fcf2cc2c51fb", "parents": ["017a92ba04d536d43eafc7cf769f3463d2ac3532"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 7: Add a ref to the symbol description in getters r=spidermonkey-reviewers,jandem\n\nI'm not sure why this wasn't already present. We need to add a ref to the\ndescription atom in the current zone when returning it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331079\n", "files": ["js/public/Symbol.h", "js/src/builtin/Symbol.cpp", "js/src/jit-test/tests/gc/symbol-description-atom-ref.js", "js/src/jsapi-tests/testSymbol.cpp", "js/src/jsapi.cpp"], "git_node": "7fa195f12cb697438e8206a772f50ca5414b5608", "git_parents": ["656b399bff950b11cb4f35ccdf7895b95e335a8c"], "node": "937aeac966de9f255c3934791f5f7f2055303070", "parents": ["187b504e0de455a41a17a0992a89fcf2cc2c51fb"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 8: Fix gdb tests to understand the new symbol layout r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331080\n", "files": ["js/src/gdb/mozilla/CellHeader.py", "js/src/gdb/mozilla/GCCellPtr.py", "js/src/gdb/mozilla/JSSymbol.py", "js/src/gdb/mozilla/prettyprinters.py"], "git_node": "ab3482f26543073ae496013f77e0fc09bb096113", "git_parents": ["7fa195f12cb697438e8206a772f50ca5414b5608"], "node": "d62ddddb12a9403b8756237cf1c457484e7db4c2", "parents": ["937aeac966de9f255c3934791f5f7f2055303070"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 9: Stop tracking gray references in atom reference bitmap r=spidermonkey-reviewers,jandem\n\nThis updates APIs to remove references to cell color and removes updating gray\nsymbol references in marking.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331081\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Marking.cpp", "js/src/gc/Verifier.cpp", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/vm/JSContext-inl.h"], "git_node": "736e0c5723f9ea6183e4b9a794837fe6eff53a50", "git_parents": ["ab3482f26543073ae496013f77e0fc09bb096113"], "node": "837234bf7326f801ceb186ceb037677cd874b420", "parents": ["d62ddddb12a9403b8756237cf1c457484e7db4c2"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078855 - Fix FoldTests pass to mark phi operands as implicitly-used when discarding a phi. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332107\n", "files": ["js/src/builtin/Boolean.cpp", "js/src/jit-test/tests/ion/bug2078855.js", "js/src/jit/FoldTests.cpp"], "git_node": "a0f4e736503483cac17c0948fe2393cff2108939", "git_parents": ["736e0c5723f9ea6183e4b9a794837fe6eff53a50"], "node": "f8ddcc1612363a7ded96845274fd54462ce31569", "parents": ["837234bf7326f801ceb186ceb037677cd874b420"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2080037 - Don't skip bootstrap steps that don't touch the system when using --no-system-changes. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332276\n", "files": ["python/mozboot/mozboot/bootstrap.py", "python/mozboot/mozboot/mach_commands.py", "python/mozversioncontrol/mozversioncontrol/repo/base.py", "python/mozversioncontrol/mozversioncontrol/repo/git.py", "python/mozversioncontrol/mozversioncontrol/repo/jj.py", "python/mozversioncontrol/mozversioncontrol/repo/mercurial.py", "python/mozversioncontrol/mozversioncontrol/repo/source.py", "tools/phabricator/mach_commands.py"], "git_node": "2fdea8e0542f6a000722b7aedb3e6fb6af886b12", "git_parents": ["a0f4e736503483cac17c0948fe2393cff2108939"], "node": "3f7fb29babdc7fc1f52853c96f614a24762ab824", "parents": ["f8ddcc1612363a7ded96845274fd54462ce31569"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2080041 - Remove mercurial support in bootstrap. r=firefox-build-system-reviewers,sergesanspaille\n\nWe keep the git-cinnabar support for try.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332279\n", "files": ["python/mozboot/bin/bootstrap.py", "python/mozboot/mozboot/aerynos.py", "python/mozboot/mozboot/archlinux.py", "python/mozboot/mozboot/base.py", "python/mozboot/mozboot/bootstrap.py", "python/mozboot/mozboot/centosfedora.py", "python/mozboot/mozboot/debian.py", "python/mozboot/mozboot/freebsd.py", "python/mozboot/mozboot/gentoo.py", "python/mozboot/mozboot/mozillabuild.py", "python/mozboot/mozboot/opensuse.py", "python/mozboot/mozboot/osx.py", "python/mozboot/mozboot/solus.py", "python/mozboot/mozboot/windows.py"], "git_node": "5221a8414a7a598163f43ad1455240c7c0133039", "git_parents": ["2fdea8e0542f6a000722b7aedb3e6fb6af886b12"], "node": "47ec502628a2349db4b5fb0563aa77bcb4d3a87b", "parents": ["3f7fb29babdc7fc1f52853c96f614a24762ab824"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Rename significant reuse to page reuse. r=pbone\n\nThe timestamp records that a dirty page was taken for a new allocation. It says\nnothing about whether that reuse mattered, so calling it significant invites the\nreader to think a magnitude has already been accounted for. Renaming it makes\nroom for the following patch, which decides that separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321992\n", "files": ["memory/build/Arena.h", "memory/build/malloc_decls.h", "memory/build/mozjemalloc.cpp"], "git_node": "bf209bb130ec9bbfc0efe2dc563789ee8155fdc0", "git_parents": ["5221a8414a7a598163f43ad1455240c7c0133039"], "node": "27bb5823bcb954ead1253804798a881e8733d4b5", "parents": ["47ec502628a2349db4b5fb0563aa77bcb4d3a87b"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Take the deferred purge predicate as a C callback. r=pbone\n\nUse a C callback with a closure for the aKeepGoing argument of\nmoz_may_purge_now() instead of a std::function. The latter may allocate, which\ncan reuse dirty pages of the arena being purged and restart its grace period,\ndeferring the purge.\n\nThis also removes the C++ specific includes from malloc_decls.h. Fallback.cpp\ngot its posix_memalign declaration through them, so malloc_decls.h includes\nstdlib.h now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322612\n", "files": ["memory/build/Arena.h", "memory/build/malloc_decls.h", "memory/build/mozjemalloc.cpp", "memory/build/mozjemalloc.h", "memory/build/mozjemalloc_types.h", "xpcom/threads/TaskController.cpp"], "git_node": "80221f5d32b1ef9951452ca5a57045fa9018f815", "git_parents": ["bf209bb130ec9bbfc0efe2dc563789ee8155fdc0"], "node": "7cdaff25334c86965e337a8726edb9937902b51d", "parents": ["27bb5823bcb954ead1253804798a881e8733d4b5"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Count a rescheduled task as pending again. r=smaug,bas\n\nA task that returns TaskResult::Incomplete is put back in the queue, but its\nmanager was told WillRunTask() again instead of DidQueueTask(), decrementing\nmTaskCount twice for one run. It is unsigned, so it wraps and the manager\nreports pending tasks forever, which for the idle task manager means its\ndeadline machinery never stops.\n\nThis was latent: the only tasks returning Incomplete live in TestTaskController\nand have no manager. The purge task later in this stack is the first managed\none, and it reschedules itself whenever it is interrupted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322614\n", "files": ["xpcom/tests/gtest/TestTaskController.cpp", "xpcom/threads/TaskController.cpp"], "git_node": "abb511fda6fe6c94b801e5e913b3e4692e99b0b2", "git_parents": ["80221f5d32b1ef9951452ca5a57045fa9018f815"], "node": "6899ab66c2a32ce7653746f97faf25237804e078", "parents": ["7cdaff25334c86965e337a8726edb9937902b51d"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Count the suspended tasks of every task manager. r=smaug\n\nThe loop that decides whether only idle tasks are left stops at the first\nmanager that is not suspended. mTaskManagers is a std::set of raw pointers and\nso iterates in address order, which means whether a suspended manager's tasks\nare subtracted depends on where the allocator happened to put it, and can\ndiffer from run to run.\n\nWhen the loop stops early we count suspended tasks as runnable, conclude that\nthere is still real work, and skip requesting an idle deadline. In a content\nprocess that request is what fetches the idle token from the parent, so the\nidle tasks that were ready wait for an extra round trip.\n\nIterate all of them. There is only a handful of managers, so the early exit was\nnot buying much.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323186\n", "files": ["xpcom/threads/TaskController.cpp"], "git_node": "0a74a2c5ba9de8c67a6f882159554dcc2cca6e25", "git_parents": ["abb511fda6fe6c94b801e5e913b3e4692e99b0b2"], "node": "195350872d26e7b203d52d2b2280493f4d2d3b72", "parents": ["6899ab66c2a32ce7653746f97faf25237804e078"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Add a lowest priority class to TaskController. r=smaug\n\nSome work is not idle work in the sense of the HTML spec's idle period, it just\nwants the main thread's leftovers: run if nothing else runs, and get out of the\nway as soon as something does.\n\nGive it a priority below Idle, so that a real idle task wins against it and\ninterrupts it, and a task manager, so that whoever asks whether the main thread\nhas work to do can tell it apart from work.\n\nThe manager also suspends itself while an idle task is queued, which is what\nkeeps a lowest priority task from starving one.\n\nForgetting the manager would quietly turn such a task back into work, so\nAddTask asserts that the two go together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323187\n", "files": ["layout/base/nsRefreshDriver.cpp", "xpcom/tests/gtest/TestTaskController.cpp", "xpcom/threads/EventQueue.h", "xpcom/threads/TaskController.cpp", "xpcom/threads/TaskController.h", "xpcom/threads/nsIRunnable.idl"], "git_node": "7038be7b490c36d00752cbc354580c56e9d9be28", "git_parents": ["0a74a2c5ba9de8c67a6f882159554dcc2cca6e25"], "node": "6dc98d06046e7c55065303e03c6562166da6239f", "parents": ["195350872d26e7b203d52d2b2280493f4d2d3b72"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Run the deferred purge as a lowest priority task. r=smaug\n\nIdleTaskRunner re-derived idle time for a purge that was scheduled because the\nmain thread was about to fall idle anyway: two timers, and a minimum useful\nbudget that most of its runs declined without purging anything. Queue one\nlowest priority task instead, which also retires the maximum delay and the\nminimum idle budget prefs.\n\nPurging is not idle work in the sense of the spec, it only wants the main\nthread's leftovers, and the lowest priority is also what fixes the deferral:\nrunning the task does not itself ask for an idle deadline, so nothing computes\nidle period state between the peek that decides to purge and the purge itself.\nInterruptiblePurgeTask's comment explains how that computation stalled the\npurge. A slice now ends when any other task becomes ready, including an idle GC\nor CC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322613\n", "files": ["memory/build/mozjemalloc.cpp", "modules/libpref/init/StaticPrefList.yaml", "xpcom/threads/TaskController.cpp"], "git_node": "3bb1de65a3f3e90653b94f8490fed9f1fa2477e4", "git_parents": ["7038be7b490c36d00752cbc354580c56e9d9be28"], "node": "e5a39d9bf6183dd8febed9912dfa3540fd0bb3d7", "parents": ["6dc98d06046e7c55065303e03c6562166da6239f"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Drop the idle from the memory cleanup names. r=smaug\n\nTaskController's callers ask for a memory cleanup and do not care how it finds\nthe time, which stopped being idle processing with the previous patch. The lazy\npurge name, which the prefs already use, stays for the markers of the task that\ndoes the purging.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323188\n", "files": ["dom/base/nsJSEnvironment.cpp", "memory/build/mozjemalloc.cpp", "xpcom/build/XPCOMInit.cpp", "xpcom/tests/unit/test_getTimers.js", "xpcom/threads/TaskController.cpp", "xpcom/threads/TaskController.h", "xpcom/threads/nsThread.cpp"], "git_node": "a97d4b037cc0eb6c82bdd9dd302d5842e03c949f", "git_parents": ["3bb1de65a3f3e90653b94f8490fed9f1fa2477e4"], "node": "cc37f71339495a9a9a792a3842545159132a8e94", "parents": ["e5a39d9bf6183dd8febed9912dfa3540fd0bb3d7"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080064 - Update test annoattions for verifyTheMainMenuShareButtonFromCustomTabTest and httpsOnlyModeExceptionPersistsForCurrentSessionTest UI tests r=mbarone\n\nUpdate test annoattions for verifyTheMainMenuShareButtonFromCustomTabTest and httpsOnlyModeExceptionPersistsForCurrentSessionTest UI tests\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332297\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHTTPSOnlyModeTest.kt"], "git_node": "8f3a482dfcea5f492081d9752c76dedf2d8059ec", "git_parents": ["a97d4b037cc0eb6c82bdd9dd302d5842e03c949f"], "node": "5997c0868d9f605ec0686142a2b7ca67151f3266", "parents": ["cc37f71339495a9a9a792a3842545159132a8e94"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2076410 - Read and close JSStreamConsumer streams on a dedicated task queue. r=saschanaz,necko-reviewers,nika,sunil\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331070\n", "files": ["dom/fetch/FetchUtil.cpp"], "git_node": "bf319ddf6e5efd9db78ff1686c1580d62e402e27", "git_parents": ["8f3a482dfcea5f492081d9752c76dedf2d8059ec"], "node": "70e3614979990e4bbfd244369a73a9978a75fe0e", "parents": ["5997c0868d9f605ec0686142a2b7ca67151f3266"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072070 - Bypass SharedSubResourceCache if any Vary header is present. r=emilio\" for causing bug 2080070.\n\nThis reverts commit 895a259b4c4bd473cf10b11b1848ac47df4a34af.\n", "files": ["dom/base/nsContentUtils.cpp", "dom/tests/browser/browser_scriptCache_responseHeaders.js", "dom/tests/browser/responseHeaders_server.sjs"], "git_node": "d7786761e0f13e66bd85364b42fe9e18e46278a1", "git_parents": ["bf319ddf6e5efd9db78ff1686c1580d62e402e27"], "node": "d8f5ed2b61e939cdfd657f6b2463b28b0d9c413b", "parents": ["70e3614979990e4bbfd244369a73a9978a75fe0e"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079810 - Let Metal ANGLE WebGL ride the trains. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332092\n", "files": ["dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-glsl3.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "c4c21bfb173e05342e7fcc43f62f62d4b0c26866", "git_parents": ["d7786761e0f13e66bd85364b42fe9e18e46278a1"], "node": "79303593ef9af0f8b4b0b73b3b4465c216271d12", "parents": ["d8f5ed2b61e939cdfd657f6b2463b28b0d9c413b"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2079754 - Include the host name in ChildDNSService request hash keys. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332049\n", "files": ["netwerk/dns/ChildDNSService.cpp", "netwerk/test/unit/test_dns_cancel.js"], "git_node": "0597323e6c4ce402c35b7a35628e97b300225f99", "git_parents": ["c4c21bfb173e05342e7fcc43f62f62d4b0c26866"], "node": "4fa06e626bf250b92ebfb6cb82c15244a6881232", "parents": ["79303593ef9af0f8b4b0b73b3b4465c216271d12"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080085 - Skip taskgraph verifications when generating tasks in mach try. r=marco DONTBUILD\n\nTry and autoland decision tasks already run with --no-verify, the\nverifications run in the source-test-python-verify-decision task\ninstead, so we don't need to slow down the local generation for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332331\n", "files": ["tools/tryselect/tasks.py"], "git_node": "4a8647be3066238c1feaeff0aee0b7cc27b9929e", "git_parents": ["0597323e6c4ce402c35b7a35628e97b300225f99"], "node": "0811ed3de27aeee5900c37c48b9d3402bf334eea", "parents": ["4fa06e626bf250b92ebfb6cb82c15244a6881232"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 1983514 - Update metadata for html/semantics/interactive-elements/the-summary-element/interactive-content.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331984\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini"], "git_node": "ce4ddd02c0f29c1feb9a2d1156fc8d1f795d6b3a", "git_parents": ["4a8647be3066238c1feaeff0aee0b7cc27b9929e"], "node": "742cfe120c2648af1e48fa396020eee28484fc7e", "parents": ["0811ed3de27aeee5900c37c48b9d3402bf334eea"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078592 - Run snap-upstream-build tasks on git-backed pushes, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331152\n", "files": ["taskcluster/kinds/snap-upstream-build/kind.yml"], "git_node": "83e4d2ef0490cf0edd1a7947a71bd467d20bcbfc", "git_parents": ["ce4ddd02c0f29c1feb9a2d1156fc8d1f795d6b3a"], "node": "58b174561e0dc6442c77074767ec0fb8f2b3f446", "parents": ["742cfe120c2648af1e48fa396020eee28484fc7e"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078592 - Run snap-upstream-test tasks on git-backed pushes, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331153\n", "files": ["taskcluster/kinds/snap-upstream-test/kind.yml"], "git_node": "6b00474846f3f8a2b55e17f7de0c08722f0579ab", "git_parents": ["83e4d2ef0490cf0edd1a7947a71bd467d20bcbfc"], "node": "eba994342c3d642a8be2294f328a9eb00b365e37", "parents": ["58b174561e0dc6442c77074767ec0fb8f2b3f446"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079322 - Run browsertime tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331641\n", "files": ["taskcluster/kinds/browsertime/kind.yml"], "git_node": "ab4738b775de79da39c727ce59f00896a7bdc06b", "git_parents": ["6b00474846f3f8a2b55e17f7de0c08722f0579ab"], "node": "b04cc813f6f15d9bc4b7bc84271b365951f59b90", "parents": ["eba994342c3d642a8be2294f328a9eb00b365e37"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079705 - Run condprof tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331979\n", "files": ["taskcluster/kinds/condprof/kind.yml"], "git_node": "a38e72bdaba72e9fb608a07965ffdaac12385eb2", "git_parents": ["ab4738b775de79da39c727ce59f00896a7bdc06b"], "node": "5c53f1b26865a4755b3a81eb1ed70face21f43ef", "parents": ["b04cc813f6f15d9bc4b7bc84271b365951f59b90"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079705 - Run webrender tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331980\n", "files": ["taskcluster/kinds/webrender/kind.yml"], "git_node": "30ab2ec4f4f6fc31d1ef0ac89d0608034cf71feb", "git_parents": ["a38e72bdaba72e9fb608a07965ffdaac12385eb2"], "node": "edd2583d63877929fed35d100e0e075ae4191a85", "parents": ["5c53f1b26865a4755b3a81eb1ed70face21f43ef"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079627 - Ignore `glean.shutdown` thread when trying to record CPU usage metrics r=chutten\n\nThis currently did not lead to any deadlock, because the Glean SDK\ndetects this and logs an error.\nAs we know this won't work there's no need to log that error.\nWe just skip the operation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331950\n", "files": ["toolkit/components/glean/ipc/FOGIPC.cpp"], "git_node": "8bff5ceab18d6e5209aa7821e4e93ee70c6949b3", "git_parents": ["30ab2ec4f4f6fc31d1ef0ac89d0608034cf71feb"], "node": "3fc2f1d650d89b945a2e8a9f191104ccd54fe3f8", "parents": ["edd2583d63877929fed35d100e0e075ae4191a85"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1983019 - Avoid quadratic AbortSignal dependency checks r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331249\n", "files": ["dom/abort/AbortSignal.cpp"], "git_node": "db5a1faa8d56726ab13c199bbfaae94e3f7cc0b1", "git_parents": ["8bff5ceab18d6e5209aa7821e4e93ee70c6949b3"], "node": "0cf032069e7fd18acf4afea72d45ea9c143cb378", "parents": ["3fc2f1d650d89b945a2e8a9f191104ccd54fe3f8"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079844 - Update metadata for content-security-policy/inside-worker/dedicatedworker-connect-src.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332336\n", "files": ["testing/web-platform/meta/content-security-policy/inside-worker/dedicatedworker-connect-src.html.ini"], "git_node": "a46752476e41ffe9422f872e9d34402fc91c122b", "git_parents": ["db5a1faa8d56726ab13c199bbfaae94e3f7cc0b1"], "node": "96d0d3eb9f85dd16ed1b56a20f010160f95138ac", "parents": ["0cf032069e7fd18acf4afea72d45ea9c143cb378"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079751 - Clamp the MOZ_LOG rotate and maxsize sizes. r=xpcom-reviewers,nika\n\nThe megabytes were converted to bytes on 32 bits, so large or negative values\nwrapped around silently. Large values are now clamped to 2047 MB so that the\nsizes fit in an int32_t, and negative values disable the option, as values\nthat overflow an int32_t already did in the MOZ_LOG parser.\n\nUsing an int64_t would require replacing ftell(), which returns a 32-bit long\non Windows and on 32-bit platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332112\n", "files": ["xpcom/base/Logging.cpp", "xpcom/docs/logging.md", "xpcom/tests/gtest/TestLogging.cpp"], "git_node": "4b277307bd43c4d37d66ba339780f6baf890c6cb", "git_parents": ["a46752476e41ffe9422f872e9d34402fc91c122b"], "node": "30a0066e59b6f28dd204180599378b14c7e46a53", "parents": ["96d0d3eb9f85dd16ed1b56a20f010160f95138ac"], "tags": []}, {"author": "Rich \u003craw@goodhumans.net\u003e", "branch": "default", "desc": "Bug 2052604, Bug 2052601 - Context-aware word boundary check for text-fragments r=jjaschke\n\nPrior to this change, the code used only 2 surrounding characters to check for a word boundary. In many cases, this does not provide enough context to the segmenter to make correct determinations of word boundaries. This patch adds a mSegmenterWordBoundaries nsFind option that collects the text in the entire block the text node falls in and then uses the WordBreakIterator to find all of the word boundaries within the block. Checks for boundaries are then run against that cache. The new option is exposed on nsIFind to make it testable from mochitest and available for regular find.\n\nThe SegmenterWordBoundaries option is set in the construction of both the finder (TextDirectiveFinder) and the generator (TextDirectiveCreator) so that text directive resolution and generation make use of the new word boundary detection by default. The patch does not set the new option for the general find-in-page case or change the prior behavior with the option unset.\n\nThe patch also changes test_nsFind.html so that most tests are run for both backwards and forwards searching. Additionally, it adds several new tests for complex word boundaries and the new option. Other text-directive tests are added to the wpt find-range-from-text-directive that test some scenarios the unpatched code didn't support.\n\nAn additional test was added to test_text-fragments-create-text-directive.html covering a CJK selection that also occurs as part of a longer word, which requires the generator to add context to disambiguate.\n\nThis change also fixes the boundary check at the start of nodes (bug 2052601) since the context collection extends beyond the text node back to the beginning of the block.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310555\n", "files": ["dom/base/TextDirectiveCreator.cpp", "dom/base/TextDirectiveCreator.h", "dom/base/TextDirectiveFinder.cpp", "dom/base/test/test_text-fragments-create-text-directive.html", "dom/base/test/test_text-fragments-get-text-directive-ranges.html", "testing/web-platform/tests/scroll-to-text-fragment/find-range-from-text-directive-target.html", "testing/web-platform/tests/scroll-to-text-fragment/find-range-from-text-directive.html", "toolkit/components/find/nsFind.cpp", "toolkit/components/find/nsFind.h", "toolkit/components/find/nsIFind.idl", "toolkit/components/find/test/mochitest/test_nsFind.html"], "git_node": "d841ac2676d99234669516049cfbe76b13f805e5", "git_parents": ["4b277307bd43c4d37d66ba339780f6baf890c6cb"], "node": "3fce8e102deb1ed096cc6299114e1be1bc399190", "parents": ["30a0066e59b6f28dd204180599378b14c7e46a53"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Use generic NTLM on windows xpcshell tests to avoid test failures r=necko-reviewers,kershaw\n\nOn windows the sys-ntlm module is used, instead of the generic impl.\nThat can make the tests fail if we have a different expectation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321223\n", "files": ["netwerk/test/unit/xpcshell.toml"], "git_node": "e410de3029478293d9e85fe763c5d146d1109309", "git_parents": ["d841ac2676d99234669516049cfbe76b13f805e5"], "node": "876b42ba609b734acceb3f94211bef760dfaf556", "parents": ["3fce8e102deb1ed096cc6299114e1be1bc399190"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Make NTLM/Negotiate auth async to avoid blocking the main thread r=necko-reviewers,kershaw\n\n- Implement GenerateCredentialsAsync for nsHttpNTLMAuth, dispatching\ncredential generation to a background thread following the same pattern\nas nsHttpNegotiateAuth.\n- Add nsIAuthModule::InitAsync with an nsIAuthModuleInitCallback so\nthat auth module initialization can complete asynchronously.\n- Implement InitAsync in nsAuthSSPI: for NTLM the callback fires\nsynchronously; for Kerberos it starts an AsyncResolveNative DNS\nlookup for the canonical hostname and finishes initialization in\nOnLookupComplete.\n- Defer nsIAuthModule::Init for Negotiate auth from ChallengeReceived\n(main thread) to the background thread via NegotiateAuthState, which\ncalls InitAsync in the GetNextTokenRunnable and continues with\nGenerateCredentials in the callback.\n- Remove nsDNSService::DeprecatedSyncResolve and its\nfriend class nsAuthSSPI \u2014 nsAuthSSPI was the sole caller.\n- Convert network.auth.use-sspi from a runtime pref to a static pref\nand update nsAuthSASL to use StaticPrefs::network_auth_use_sspi().\n- Make nsNTLMAuthModule and nsAuthSambaNTLM use thread-safe\nref-counting (NS_DECL_THREADSAFE_ISUPPORTS) since their instances are\nnow handed across threads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142161\n", "files": ["extensions/auth/nsAuthGSSAPI.cpp", "extensions/auth/nsAuthSASL.cpp", "extensions/auth/nsAuthSSPI.cpp", "extensions/auth/nsAuthSSPI.h", "extensions/auth/nsAuthSambaNTLM.cpp", "extensions/auth/nsAuthSambaNTLM.h", "extensions/auth/nsHttpNegotiateAuth.cpp", "modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js", "netwerk/base/nsIAuthModule.idl", "netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsDNSService2.h", "netwerk/protocol/http/nsHttpNTLMAuth.cpp", "security/manager/ssl/nsNTLMAuthModule.cpp", "security/manager/ssl/nsNTLMAuthModule.h"], "git_node": "1cea5b89b16660c8216a0da681b8ded551905934", "git_parents": ["e410de3029478293d9e85fe763c5d146d1109309"], "node": "588ed54bb13e9eb9d357b2aa23af16cae10adbdf", "parents": ["876b42ba609b734acceb3f94211bef760dfaf556"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Test that Negotiate auth builds the SPN from the canonical name r=necko-reviewers,kershaw\n\nnsAuthSSPI::InitAsync resolves the canonical name of the host so that the\nSPN is built from the CNAME target rather than the name in the URI. Nothing\ncovered that: every existing Negotiate test uses localhost, which\nnsHostResolver satisfies without reaching a resolver thread, so the lookup\ncompletes re-entrantly inside AsyncResolveNative and the asynchronous path\nis never taken.\n\nResolve the host through a TRR server instead. That forces a real async\nresolution and lets the name be a CNAME for a different host, so the test\nfails if the canonical name is dropped or if the lookup result never makes\nit back to the channel.\n\nWindows only, since nsAuthSSPI is the only nsIAuthModule that implements\ninitAsync.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321224\n", "files": ["netwerk/test/unit/test_negotiate_auth_canonical_name.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "bf0a9bf15cf3828718d3257beb1d404e2e34d58a", "git_parents": ["1cea5b89b16660c8216a0da681b8ded551905934"], "node": "f6ac49b649fb0b35a004e48b31d02ca0b88ab0af", "parents": ["588ed54bb13e9eb9d357b2aa23af16cae10adbdf"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Test cancelling a channel while async auth init is in flight r=necko-reviewers,kershaw\n\nDeferring nsIAuthModule::init to a background thread means a channel can be\ncancelled while the init is still running. Cancel() runs on the main thread\nand races the background thread that finishes the init and goes on to\ngenerate the credentials, both of which touch GetNextTokenCompleteEvent.\n\ntest_bug1683176.js already cancels during Negotiate credential generation,\nbut it resolves localhost, so the init completes re-entrantly and the\ncancel can only ever land after it. Delay the DoH response instead: the\ntransaction is suspended for authentication while the canonical name lookup\nis still outstanding, so the cancel is guaranteed to land mid-init. The test\nasserts the server never sees an authenticated retry, which is what\ndistinguishes a cancel that took effect from one that arrived too late.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321225\n", "files": ["netwerk/test/unit/test_negotiate_auth_cancel_during_init.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "cda80310f4722a3d850700bb338f1178d1108b0f", "git_parents": ["bf0a9bf15cf3828718d3257beb1d404e2e34d58a"], "node": "28c149b17367bc5306e51248fa4ccae2203a7ead", "parents": ["f6ac49b649fb0b35a004e48b31d02ca0b88ab0af"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Test cancelling a channel during async NTLM credential generation r=necko-reviewers,kershaw\n\nnsHttpNTLMAuth::GenerateCredentialsAsync runs GenerateCredentials on a\nbackground thread, so Cancel() can run on the main thread concurrently with\nthe background thread filling in NTLMGetNextTokenCompleteEvent. Whichever\nside wins, the callback has to run exactly once and the channel has to end\nup aborted.\n\ntest_bug1683176.js covers this for Negotiate but there was no equivalent for\nNTLM, which is the path that just gained a background thread.\n\nUses a content principal because the generic NTLM module reports the\nidentity as invalid and the channel prompts, which is blocked for\nnon-web-content triggered loads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321226\n", "files": ["netwerk/test/unit/test_ntlm_cancel_async_creds.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "37e674c96f75d9ea7c7d344fc44f6302c553b562", "git_parents": ["cda80310f4722a3d850700bb338f1178d1108b0f"], "node": "30ea1007227a70cac34e4cedeaddf736776aee75", "parents": ["28c149b17367bc5306e51248fa4ccae2203a7ead"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Add gtests for the nsIAuthModule::initAsync contract r=necko-reviewers,kershaw\n\nThere is no way to drive initAsync from JS with a mock module, because\nnsIAuthModule::CreateInstance is a hardcoded factory rather than a component\nmanager lookup, so cover the contract directly.\n\n- Modules without an async init must report NS_ERROR_NOT_IMPLEMENTED.\nNegotiateAuthState::InitAsync and GetNextTokenRunnable::Run both fall back\nto the synchronous Init on exactly that result, so a module that grows a\npartial implementation without returning it would silently skip\ninitialization.\n\n- nsAuthSSPI must complete a Kerberos init off the main thread. localhost\nis answered without reaching a resolver thread, so before InitAsync passed\nan event target to AsyncResolveNative this ran re-entrantly on the caller's\nthread; the test fails (on the MOZ_ASSERT in OnLookupComplete) if that\nregresses.\n\n- NTLM skips the canonical name lookup, so its init still reports completion\nbefore returning.\n\n- Empty and malformed service names are rejected without invoking the\ncallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321227\n", "files": ["netwerk/test/gtest/TestAuthModuleInitAsync.cpp", "netwerk/test/gtest/moz.build"], "git_node": "9e047566f3e98f4e3fdce2b6c5080b0d69d70239", "git_parents": ["37e674c96f75d9ea7c7d344fc44f6302c553b562"], "node": "d4d395dae5d8c0d392a805e5c9895028737f8e7e", "parents": ["30ea1007227a70cac34e4cedeaddf736776aee75"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Test native NTLM proxy and web auth r=necko-reviewers,kershaw\n\nEvery existing NTLM test either sets network.auth.force-generic-ntlm or runs\nsomewhere sys-ntlm is unavailable, so nsHttpNTLMAuth::mUseNative and the\nnative module itself had no coverage at all. That matters here because\nnsAuthSSPI is now constructed on the main thread in ChallengeReceived and\nthen has Init and GetNextToken called on a background thread, which is why it\nneeded threadsafe refcounting.\n\nTrusting localhost for automatic NTLM means the native module uses default\ncredentials and reports the identity as valid, so the channel never prompts.\nThe test fails if anything asks for a prompt, which is what keeps it honest:\nthe internal module always prompts, so a silent fallback to it is caught\nrather than passing quietly.\n\nThe sequence stops after the type 1 message. Answering a type 2 challenge\nmakes SSPI derive a response from whoever is logged in, and on a machine with\nno credentials for the domain named in the challenge it fails with\nSEC_E_NO_CREDENTIALS -- which is why the other proxy tests force the generic\nmodule. The type 3 step stays covered there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321228\n", "files": ["netwerk/test/unit/test_ntlm_native_proxy_and_web_auth.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "fe91f5cf9454017af38b24d68c60340102e590eb", "git_parents": ["9e047566f3e98f4e3fdce2b6c5080b0d69d70239"], "node": "74584fca31f60909533c44e7505972daa8096251", "parents": ["d4d395dae5d8c0d392a805e5c9895028737f8e7e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Test native NTLM against a server that validates the response r=necko-reviewers,kershaw\n\nThe other native NTLM tests accept any well-formed type 3 message, so a bug\nthat computed the NTLMv2 proof wrongly would still pass them. This one has\nthe server recompute the proof from a password it knows and compare:\n\n  NTHash     = MD4(UTF16LE(password))\n  NTLMv2Hash = HMAC-MD5(NTHash, UTF16LE(uppercase(user) + domain))\n  NTProofStr = HMAC-MD5(NTLMv2Hash, serverChallenge + blob)\n\nThe server runs on the node harness, issues a real type 2 with a fresh random\nchallenge per connection, and returns 200 only when the proof matches. A\nsecond task points it at a different password and expects 403, so a validator\nthat accepted everything cannot masquerade as a working one.\n\nMD4 is implemented in JS because OpenSSL 3 moved it to the legacy provider\nand node cannot supply it. It is checked against three known answers,\nincluding the NT hash of the password from MS-NLMP, so a broken digest shows\nup as a failed vector rather than as an unexplained rejection.\n\nUses explicit credentials for the same reason as the full exchange test:\ndefault credentials give SEC_E_NO_CREDENTIALS on a machine that is not\ndomain joined.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321229\n", "files": ["netwerk/test/unit/test_ntlm_native_server_validation.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "8d447f79c396eeac14d201df6000843a5a243c6c", "git_parents": ["fe91f5cf9454017af38b24d68c60340102e590eb"], "node": "eded1691d088d11648c5c2fe3b81747b99868aaa", "parents": ["74584fca31f60909533c44e7505972daa8096251"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1394752 - Remove the scriptable synchronous nsIDNSService::resolve r=necko-reviewers,jesup\n\nNothing calls it. There is no JS caller anywhere in the tree, and the only two\nimplementations were nsDNSService::Resolve, which unwrapped the origin\nattributes and forwarded straight to ResolveNative, and\nChildDNSService::Resolve, which returned NS_ERROR_NOT_AVAILABLE with the\ncomment that sync IPDL is evil. DNSServiceWrapper forwards via\nNS_FORWARD_NSIDNSSERVICE and both implementors declare their methods with\nNS_DECL_NSIDNSSERVICE, so removing the method from the interface is enough.\n\nresolveNative stays. It has three callers, and they all pass RESOLVE_OFFLINE or\nrun off the main thread, so they consult literals and the cache rather than\nblocking: nsCORSListenerProxy and two in DnsAndConnectSocket. Its documentation\nwas attached to the scriptable method, so it moves and is corrected to describe\nthe RESOLVE_OFFLINE exemption that ResolveNative actually implements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321293\n", "files": ["netwerk/dns/ChildDNSService.cpp", "netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsIDNSService.idl"], "git_node": "565d55563c2be7d8b05d4446f8d19201c1b2cb4e", "git_parents": ["8d447f79c396eeac14d201df6000843a5a243c6c"], "node": "e6cdd2a3ede9f23033529dbed2b968d8c145d598", "parents": ["eded1691d088d11648c5c2fe3b81747b99868aaa"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2080036 - Bug 2045720 - Avoid RefPtr churn while checking document cookies. r=cookie-reviewers,manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326570\n", "files": ["netwerk/cookie/CookieServiceChild.cpp"], "git_node": "e4e2c8164d819536562eda5a9f235f54da15039c", "git_parents": ["565d55563c2be7d8b05d4446f8d19201c1b2cb4e"], "node": "460d6983f2eba3fffa7d4b8fc97735c3450ccd5c", "parents": ["e6cdd2a3ede9f23033529dbed2b968d8c145d598"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Run and clone the source-test wpt-unittest task from Git, r=taskgraph-reviewers,jcristau\n\nThe task was parked on bug 2066119 (run-task-git did not put the fetched\nPython toolchain on PATH). With that fix on main, source-test-wpt-unittest-default\nis green on a git-backed push with both hg-only guards removed (staging-firefox,\ndecision task group e8zNHJwQQDyoErwzv95Syw).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331996\n", "files": ["taskcluster/kinds/source-test/wpt-unittest.yml"], "git_node": "ce3363f75ba149d04e67c3181c2baca78bd3678a", "git_parents": ["e4e2c8164d819536562eda5a9f235f54da15039c"], "node": "8e9fc09e5726900a51669fef4f35fc842ba482cb", "parents": ["460d6983f2eba3fffa7d4b8fc97735c3450ccd5c"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Clone the source-test python tasks from Git, r=taskgraph-reviewers,jcristau\n\nThese tasks were parked on bug 2066119 (run-task-git did not put the fetched\nPython toolchain on PATH). With that fix on main, a representative sample of\n13 source-test-python-* tasks across linux, macOS and Windows ran on a\ngit-backed push with clone-with removed (staging-firefox, decision task group\ne8zNHJwQQDyoErwzv95Syw): 12 green.\n\nsource-test-python-firefox-ci keeps cloning from hg for now: run from a git\ncheckout, the ci subsuite hits the worker memory limit (bug 2080077).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331998\n", "files": ["taskcluster/kinds/source-test/python.yml"], "git_node": "728a1018d466f26f7ba2ee984a38c98db59436b6", "git_parents": ["ce3363f75ba149d04e67c3181c2baca78bd3678a"], "node": "ffad59e5a7efc05aed07b18c53fd30c723855eca", "parents": ["8e9fc09e5726900a51669fef4f35fc842ba482cb"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "4fa56cd19bf8f2bc9eff88044bec286f11a7f19c", "git_parents": ["728a1018d466f26f7ba2ee984a38c98db59436b6", "7af81fe47ac81825fa31f451dddfaeb736e109ba"], "node": "7823e47260a4fad97520269dd7578330e5aeb322", "parents": ["ffad59e5a7efc05aed07b18c53fd30c723855eca", "22080c83e0d3b920e11a03367c6344afc562c0dd"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019860 - Make `mach coverage-report` use the latest mozilla-central push with finished coverage tasks r=nicolas.guichard\n\nWhen no --branch/--revision is passed, `mach coverage-report` used the very latest mozilla-central decision task. On that push the ccov test tasks are almost always still unscheduled or running, so the command polled every 60s waiting for them. That makes test_coverage_report_latest_push_gtest hit its 600s subprocess timeout. For example, on the current latest push (pushlog-id 45525), test-linux2404-64-ccov/opt-gtest-1proc is `unscheduled`, as are 458 of the 467 ccov tasks.\n\nThe command now walks back through the most recent mozilla-central pushes, using the `gecko.v2.mozilla-central.pushlog-id.\u003cN\u003e.decision` index and checking at most 30 pushes. It uses the first push whose matching ccov tasks have all finished. Explicit --branch/--revision keeps the old behaviour of waiting for the tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332216\n", "files": ["tools/code-coverage/mach_commands.py"], "git_node": "3a073ab6ded7922794d5b6e06fede4b8b5ff91d6", "git_parents": ["4fa56cd19bf8f2bc9eff88044bec286f11a7f19c"], "node": "e1630f55b8b1a782c2407d534b954188ae39d018", "parents": ["7823e47260a4fad97520269dd7578330e5aeb322"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044019: Encrypt session restore data r=bbeurdouche,jswinarton\n\nEncrypts session store when browser.sessionstore.encryption.available\nand browser.sessionstore.encryption.enabled are both set. The available\npref is locked so nobody enables encryption by accident in builds where\nit is not supported; enabled is left unlocked for users and policy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305981\n", "files": ["browser/app/profile/firefox.js", "browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/SessionStartup.sys.mjs", "browser/components/sessionstore/SessionWriter.sys.mjs", "browser/components/sessionstore/test/browser_backup_recovery.js", "browser/components/sessionstore/test/browser_upgrade_backup.js", "browser/components/sessionstore/test/head.js", "browser/components/sessionstore/test/unit/test_encryption.js", "browser/components/sessionstore/test/unit/test_encryption_pref_locked.js", "browser/components/sessionstore/test/unit/xpcshell.toml", "dom/chrome-webidl/IOUtils.webidl", "security/lockstore/LockstoreService.cpp", "security/lockstore/LockstoreService.h", "toolkit/modules/tests/browser/browser_Troubleshoot.js", "tools/@types/lib.gecko.tweaks.d.ts", "xpcom/ioutils/IOUtils.cpp", "xpcom/ioutils/IOUtils.h", "xpcom/ioutils/tests/chrome.toml", "xpcom/ioutils/tests/test_ioutils_encrypt.html"], "git_node": "0e98dd7dd31239714520afea446859b7534c4668", "git_parents": ["3a073ab6ded7922794d5b6e06fede4b8b5ff91d6"], "node": "224e9a93af2a4158466897e03c120410829c6f00", "parents": ["e1630f55b8b1a782c2407d534b954188ae39d018"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2079924 - Check for NS_STATE_SVG_TEXT_CORRESPONDENCE_DIRTY too r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332190\n", "files": ["layout/svg/SVGObserverUtils.cpp", "testing/web-platform/tests/svg/text/crashtests/unicode-bidi-crash.html"], "git_node": "738acb085e68784781741c448c272d83854780fc", "git_parents": ["0e98dd7dd31239714520afea446859b7534c4668"], "node": "1f135c7ad6eb0e6fc0fdb73d57e9f4b18cfa8576", "parents": ["224e9a93af2a4158466897e03c120410829c6f00"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074393 - [devtools] Add functional checkbox in new settings panel r=devtools-reviewers,fluent-reviewers,nchevobbe,bolsson\n\nConvert panel file to esm to make imports easier. Use panel class to handle interaction with the rest of devtools, triggered by events from the lit element. Add tests in their own folder.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328084\n", "files": ["devtools/client/definitions.js", "devtools/client/locales-preview/settings.ftl", "devtools/client/settings/events.mjs", "devtools/client/settings/index.html", "devtools/client/settings/moz.build", "devtools/client/settings/panel.js", "devtools/client/settings/panel.mjs", "devtools/client/settings/settings.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_rulers.js", "devtools/client/settings/test/browser/head.js", "devtools/client/settings/tsconfig.json"], "git_node": "cb959ca5620872274f1d382b86a2f022c75bace1", "git_parents": ["738acb085e68784781741c448c272d83854780fc"], "node": "72d5ef1118623ae05a3c9ba09ed415509b2220f1", "parents": ["1f135c7ad6eb0e6fc0fdb73d57e9f4b18cfa8576"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1983019 - Avoid quadratic AbortSignal dependency checks r=jjaschke\" as requested by dev.\n\nThis reverts commit db5a1faa8d56726ab13c199bbfaae94e3f7cc0b1.\n", "files": ["dom/abort/AbortSignal.cpp"], "git_node": "65bf8be2e9fb146a5cfe76911b028473e83f3dc7", "git_parents": ["cb959ca5620872274f1d382b86a2f022c75bace1"], "node": "d5a839769fe44e0335fcdfc8f0246d68dda3fce0", "parents": ["72d5ef1118623ae05a3c9ba09ed415509b2220f1"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069097: Fix excess dirty-origin writes at startup. r=ArnaudBienner\n\nAfter a build-ID change, dirty shutdown, or migration, scanned origin\nmetadata often has a stale mLastAccessTime from .metadata-v2 that\ndiffers from the DB row. This caused cacheRowMatches=false and an\nunnecessary dirty-queue push for origins whose usage was otherwise\nidentical.\n\nReconcile timestamps before comparing, replace the mOriginUsage\u003e0\nguard with aDirectoryExists, add an mUsageModificationDisabled guard,\nand re-enable that flag after RemoveQuota in the full-scan path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327351\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CommonMetadata.h", "dom/quota/test/xpcshell/test_unaccessedOrigins.js"], "git_node": "0faafd1ca77577ad6fd324624ec46ae86b384d49", "git_parents": ["65bf8be2e9fb146a5cfe76911b028473e83f3dc7"], "node": "a5f63ddeb11116fd7116f227fa93312bfc689fda", "parents": ["d5a839769fe44e0335fcdfc8f0246d68dda3fce0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079688 - Stop resetting scroll position of listbox select on child added. r=jjaschke\n\nIt won't work on base appearance anyway, and it doesn't seem to happen\non Blink browsers, so just doing this.\n\nIn order to do this, we need to flush layout on DoScrollToOption,\nbecause otherwise the frame for the option might not be there.\n\nThis does change behavior a bit to effectively match Chromium. E.g. now\nif you have a hidden select, we don't retroactively trigger the scroll\nwhen you reveal it.\n\nIt probably also fixes some edge cases if you e.g. trigger a frame flush\nbut not a layout flush on DoScrollToOption for example.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332332\n", "files": ["dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h", "layout/forms/nsListControlFrame.cpp", "layout/forms/nsListControlFrame.h"], "git_node": "e8f150331d42fa07f90a2de24482cf7ccc57c453", "git_parents": ["0faafd1ca77577ad6fd324624ec46ae86b384d49"], "node": "0c1db9fc6541a1e9b14027ae99a2d73cde8ea4aa", "parents": ["a5f63ddeb11116fd7116f227fa93312bfc689fda"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079924 - Check for NS_STATE_SVG_TEXT_CORRESPONDENCE_DIRTY too r=emilio\" for causing failures at SVGTextFrame.cpp.\n\nThis reverts commit 738acb085e68784781741c448c272d83854780fc.\n", "files": ["layout/svg/SVGObserverUtils.cpp", "testing/web-platform/tests/svg/text/crashtests/unicode-bidi-crash.html"], "git_node": "722171699537fd34644d8d5381db080756f3cb0b", "git_parents": ["e8f150331d42fa07f90a2de24482cf7ccc57c453"], "node": "82b43ea684289b9f0daf4123e7c9577b0d356e86", "parents": ["0c1db9fc6541a1e9b14027ae99a2d73cde8ea4aa"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078853 - [devtools] Add the UI skeleton for the Speculative Loads r=devtools-reviewers,fluent-reviewers,nchevobbe,bolsson\n\nThis patch adds the basic UI skeleton for to view speculative loads. this setup\nthe base for showing the actual data which will be come in subsequent patches.\n\nThere are 2 sections\n- Speculative load status of the current page\n- Any speculations initiated by this page\n\nSee the speculative loads panel in chrome for details, which is the\ninspiration for most of this work.\n\nEnable `devtools.application.speculativeLoads` to see panel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331486\n", "files": ["devtools/client/application/application.css", "devtools/client/application/index.html", "devtools/client/application/initializer.js", "devtools/client/application/src/components/moz.build", "devtools/client/application/src/components/routing/PageSwitcher.js", "devtools/client/application/src/components/routing/Sidebar.js", "devtools/client/application/src/components/routing/SidebarItem.js", "devtools/client/application/src/components/speculative-loads/SpeculativeLoads.css", "devtools/client/application/src/components/speculative-loads/SpeculativeLoadsPage.js", "devtools/client/application/src/components/speculative-loads/moz.build", "devtools/client/application/src/constants.js", "devtools/client/jar.mn", "devtools/client/locales-preview/speculative-loads.ftl", "devtools/client/locales/jar.mn", "devtools/client/themes/images/speculative-loads.svg"], "git_node": "63899b00d8471f951e13316f27a3c07079c41d76", "git_parents": ["722171699537fd34644d8d5381db080756f3cb0b"], "node": "88c52bc757e4c39d83b7e26d18810881d16b896e", "parents": ["82b43ea684289b9f0daf4123e7c9577b0d356e86"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2079568. Don't perform microtask checkpoints from windowless documents. r=dom-core-reviewers,smaug\n\nWindowless documents (SVG images, external resource documents, data\ndocuments) can't run script, so a microtask checkpoint performed on their\nbehalf only runs microtasks belonging to other documents. Add\nnsAutoMicroTaskForDocument, which skips the checkpoint when the document\nhas no inner window, and use it for the checkpoints such documents can\nreach: the empty inline script checkpoint in ScriptElement, the one around\nUpdateAndReduceAnimations in the refresh driver, and the checkpoints in the\nXML and HTML parsers and the XSLT output sink.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331878\n", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/test/gtest/TestContentUtils.cpp", "dom/script/ScriptElement.cpp", "dom/xml/nsXMLContentSink.cpp", "dom/xslt/xslt/txMozillaXMLOutput.cpp", "layout/base/nsRefreshDriver.cpp", "parser/html/nsHtml5TreeOperation.cpp"], "git_node": "42c545b0297a4a6967d4ea7799f2ba33c922c35a", "git_parents": ["63899b00d8471f951e13316f27a3c07079c41d76"], "node": "3860dc8bfb3b7372fb5f4bb0102bc5dab5e97323", "parents": ["88c52bc757e4c39d83b7e26d18810881d16b896e"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2080007 [Linux][Vulkan Video] - Enable the DMA-BUF sync-file ioctl in ffvpx Vulkan import. r=stransky,media-playback-reviewers\n\nThe Linux sysroot has no linux/dma-buf.h new enough for the sync-file ioctl. Define it in hwcontext_vulkan.c, as DMABufSurface.cpp does for DMA_BUF_IOCTL_SYNC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332261\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/dma-buf-sync-file.patch", "media/ffvpx/libavutil/hwcontext_vulkan.c"], "git_node": "cd606a8ebab37371f7759f1ea7580c90b9671c08", "git_parents": ["42c545b0297a4a6967d4ea7799f2ba33c922c35a"], "node": "c550de848aa0b7b23a3b58466c342a4e73d2da21", "parents": ["3860dc8bfb3b7372fb5f4bb0102bc5dab5e97323"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078853 - [devtools] Add the UI skeleton for the Speculative Loads r=devtools-reviewers,fluent-reviewers,nchevobbe,bolsson\" for causing build bustages.\n\nThis reverts commit 63899b00d8471f951e13316f27a3c07079c41d76.\n", "files": ["devtools/client/application/application.css", "devtools/client/application/index.html", "devtools/client/application/initializer.js", "devtools/client/application/src/components/moz.build", "devtools/client/application/src/components/routing/PageSwitcher.js", "devtools/client/application/src/components/routing/Sidebar.js", "devtools/client/application/src/components/routing/SidebarItem.js", "devtools/client/application/src/components/speculative-loads/SpeculativeLoads.css", "devtools/client/application/src/components/speculative-loads/SpeculativeLoadsPage.js", "devtools/client/application/src/components/speculative-loads/moz.build", "devtools/client/application/src/constants.js", "devtools/client/jar.mn", "devtools/client/locales-preview/speculative-loads.ftl", "devtools/client/locales/jar.mn", "devtools/client/themes/images/speculative-loads.svg"], "git_node": "093927000591edd7635af156078dcbd87b25b476", "git_parents": ["cd606a8ebab37371f7759f1ea7580c90b9671c08"], "node": "3372b0200025673520a9a6af55655919d1e4eb40", "parents": ["c550de848aa0b7b23a3b58466c342a4e73d2da21"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077927 - [devtools] Use individual Symbol const for handling important state in parseDeclarationsInternal. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331909\n", "files": ["devtools/shared/css/parsing-utils.js"], "git_node": "85e9d78db317b903dc542eb0a823c7f7e50177ea", "git_parents": ["093927000591edd7635af156078dcbd87b25b476"], "node": "9bea443968b6ec4b68a24704467dc13678d770d2", "parents": ["3372b0200025673520a9a6af55655919d1e4eb40"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077927 - [devtools] Handle non-lowercase !important in parseDeclarationsInternal. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331910\n", "files": ["devtools/client/inspector/rules/test/browser_rules_mark_overridden_03.js", "devtools/client/shared/test/xpcshell/test_parseDeclarations.js", "devtools/shared/css/parsing-utils.js"], "git_node": "0d1465b91a06abcd245abeb4c8f13077c1f89c39", "git_parents": ["85e9d78db317b903dc542eb0a823c7f7e50177ea"], "node": "7436d03a53a8ab019199e0272976e70dc2f7e7ba", "parents": ["9bea443968b6ec4b68a24704467dc13678d770d2"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077929 - [devtools] Handle trailing !important without semi colon on empty custom property. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331913\n", "files": ["devtools/client/shared/test/xpcshell/test_parseDeclarations.js", "devtools/shared/css/parsing-utils.js"], "git_node": "1617bb56f7b164ae4af1b3b1076e3d0c5a37f48a", "git_parents": ["0d1465b91a06abcd245abeb4c8f13077c1f89c39"], "node": "bc2df5fcd58d704bd3182a20207786d8a3eaff8c", "parents": ["7436d03a53a8ab019199e0272976e70dc2f7e7ba"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077923 - [devtools] !important in parenthesis, square or curly bracket shouldn't impact declaration priority. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331917\n", "files": ["devtools/client/shared/test/xpcshell/test_parseDeclarations.js", "devtools/shared/css/parsing-utils.js"], "git_node": "346ceb8a93cdbbc99189e3070b43245fd38a9a0e", "git_parents": ["1617bb56f7b164ae4af1b3b1076e3d0c5a37f48a"], "node": "d47d888452bc829d2fd065c03817c09523fc6e83", "parents": ["bc2df5fcd58d704bd3182a20207786d8a3eaff8c"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079977 - Enable Local Network Access by default in Fenix. r=android-reviewers,sfamisa\n\nLNA has been rolled out to Android users via Nimbus. Default the lna-blocking\nfeature's `enabled` and `blocking` variables to true so it no longer depends\non the rollout. The Nimbus feature can still turn it off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332278\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "5b234a022d1ad138eb589bab391f815f350addc8", "git_parents": ["346ceb8a93cdbbc99189e3070b43245fd38a9a0e"], "node": "4e4d25feede5d669d5f4436359bb1945b645f741", "parents": ["d47d888452bc829d2fd065c03817c09523fc6e83"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073453 - Add Glean telemetry for category manager consumer failures r=Gijs\n\nA consumer that throws no longer stops the rest of its category (bug 2019544),\nso failures are otherwise only visible in the console.\n\nRecord browser_utils.category_dispatch_error on each failure, with the\ncategory, module, consumer and error name, and count every consumer run per\ncategory as success or failure in browser_utils.category_consumer_result.\nModule URIs and names outside the expected shapes are recorded as \"other\", and\ncategories missing from the labels as __other__.\n\nMove the callModulesFromCategory tests, with the sinon import and catman\nsupport files only they use, from test_BrowserUtils.js to\ntest_BrowserUtils_callModulesFromCategory.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327315\n", "files": ["browser/docs/CategoryManagerIndirection.md", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/gecko_metrics.yaml", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js", "toolkit/modules/tests/xpcshell/test_BrowserUtils_callModulesFromCategory.js", "toolkit/modules/tests/xpcshell/xpcshell.toml"], "git_node": "5b2721cd140853e96c40f8a4f54e30929e31ac9e", "git_parents": ["5b234a022d1ad138eb589bab391f815f350addc8"], "node": "22569b0a62d8086f111516d4f63a2fd9dd6eea58", "parents": ["4e4d25feede5d669d5f4436359bb1945b645f741"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 6: Fix 30-ish 'misc-unused-parameters' warnings under /xpcom r=xpcom-reviewers,emilio\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nMost of the warnings appear in directories outside of /xpcom because of macro expansions from nsCycleCollectionParticipant.h\n\nAmend: Fix what reviewhelper-bot said\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332040\n", "files": ["xpcom/base/nsCycleCollectionParticipant.h", "xpcom/base/nsDebugImpl.cpp", "xpcom/base/nsDumpUtils.cpp", "xpcom/base/nsDumpUtils.h", "xpcom/tests/TestQuickReturn.cpp", "xpcom/tests/gtest/TestHashtables.cpp", "xpcom/threads/IdlePeriodState.cpp", "xpcom/threads/IdleTaskRunner.cpp", "xpcom/threads/nsThreadUtils.h"], "git_node": "ddbfe517985cdc1e5bb4a0d44f821fae743341a9", "git_parents": ["5b2721cd140853e96c40f8a4f54e30929e31ac9e"], "node": "b006ff58ba57b8238fe0a5a63dd7c18ba2b87486", "parents": ["22569b0a62d8086f111516d4f63a2fd9dd6eea58"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075334 - Give libogg, libvorbis and the Speex resampler their own about:license entries r=media-playback-reviewers,chunmin DONTBUILD\n\nThey shared a Xiph.org text with the year left as a placeholder and the\nranges typed into the notice, which had gone stale for libvorbis and left\nout the Speex resampler's other copyright holders. Each now shows its\nupstream COPYING.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332098\n", "files": ["media/libogg/moz.build", "media/libspeex_resampler/moz.build", "media/libvorbis/moz.build", "toolkit/content/licenses/moz.build", "toolkit/content/licenses/xiph.txt"], "git_node": "2fde11a0b05a2871ed78595031cb9985a9a9fc54", "git_parents": ["ddbfe517985cdc1e5bb4a0d44f821fae743341a9"], "node": "cb841af98cc69890d9bd126bc9e62f0e129a42bd", "parents": ["b006ff58ba57b8238fe0a5a63dd7c18ba2b87486"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 5: Fix the few 'misc-unused-parameters' warnings under /browser r=stransky\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330445\n", "files": ["browser/components/shell/nsGNOMEShellSearchProvider.cpp", "browser/components/shell/nsGNOMEShellService.cpp"], "git_node": "b010be3c810c870956a754f4994fb86f25242777", "git_parents": ["2fde11a0b05a2871ed78595031cb9985a9a9fc54"], "node": "4424a1a81201e8628feba9716ca3369b0c810556", "parents": ["cb841af98cc69890d9bd126bc9e62f0e129a42bd"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2073398: Support writing update telemetry on macOS. r=spohl,application-update-reviewers,jhirsch,iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327802\n", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/profile/ProfileMetrics.sys.mjs", "toolkit/profile/test/xpcshell/test_profile_metrics_time_since_update.js", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp"], "git_node": "816f6bceed90b0f16c8e14e3e157c1db33b530c2", "git_parents": ["b010be3c810c870956a754f4994fb86f25242777"], "node": "3199ec4ed2081c15b5883ff76124ea6369159216", "parents": ["4424a1a81201e8628feba9716ca3369b0c810556"], "tags": []}, {"author