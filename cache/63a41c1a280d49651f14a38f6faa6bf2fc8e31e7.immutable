5a35c5a60b74", "parents": ["761631023f7a6007359d56b590b426867a5a8499"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063264 - Create a preference to swap between search-config-v2 and search-config-v3. r=search-reviewers,scunnane\n\nThis only hooks up the configuration reading from remote settings. We'll hook up application-services and other parts in a later patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331623\n", "files": ["modules/libpref/init/all.js", "toolkit/components/search/SearchEngineSelector.sys.mjs", "toolkit/components/search/SearchUtils.sys.mjs"], "git_node": "13970ec4a8f3caddd3100609653d0fbb0fb78286", "git_parents": ["afe86a1d2fe3f0650d2ba42e2adb86409355f794"], "node": "2de63e78ab5ca9f0e6a5c5d7c9759111115aabd7", "parents": ["7ee55cb62d7b788e1be02f59dafa5a35c5a60b74"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063279 - Update the search-config-v3-schema with the new definitions. r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331658\n", "files": ["toolkit/components/search/schema/search-config-v3-schema.json"], "git_node": "4f5bc26e904b80e7d7eba734dc48075a327899a9", "git_parents": ["13970ec4a8f3caddd3100609653d0fbb0fb78286"], "node": "3fbfb13ee7df9c6fb3745152b0a7783d0ad0c933", "parents": ["2de63e78ab5ca9f0e6a5c5d7c9759111115aabd7"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332511\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "e54a2676bfe9a4011817f57f30e8dbd011fd3687", "git_parents": ["4f5bc26e904b80e7d7eba734dc48075a327899a9"], "node": "800b02e90d90cbad20412beb766a034e27234ebc", "parents": ["3fbfb13ee7df9c6fb3745152b0a7783d0ad0c933"], "tags": []}, {"author": "python273 \u003ciam@python273.pw\u003e", "branch": "default", "desc": "Bug 1613369 - Use paired nearest alpha rounding and correct conversion expectations. r=gfx-reviewers,lsalzman,places-reviewers,mak\n\nPair nearest premultiplication with nearest unpremultiplication to preserve\nvalid stored pixels through both direct ImageData and native PNG round trips.\nAdd exhaustive scalar/SIMD checks and canvas import/round-trip regression tests.\n\nCorrect the legacy gradient expectations to pixel-center sampling. Update\nthe four JPEG/WebP references and both PNG compression variants of the\n48x48 favicon to reflect nearest premultiplication.\n\nRemove obsolete FAIL metadata for 18 element/offscreen/worker compositing\nreftests. Nearest PNG decoding improves their existing references enough\nto meet the existing fuzzy bounds.\n\nCorrect the GTK drawSnapshot straight-alpha reference grays from 29 and 237\nto 28 and 236. Nearest premultiplication maps gray 16 and 235 at alpha 242\nto 15 and 223; composition over white adds 13.\n\nPreserve the independent JPEG XL conformance PNG and allow up to 36000\ndiffering pixels without relaxing the two-unit channel bound. Half-float\ndecoding, color management and alpha rounding produce small differences\nfrom the reference; nearest premultiplication changes their pixel count.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331332\n", "files": ["dom/canvas/test/mochitest.toml", "dom/canvas/test/reftest/color_quads.list", "dom/canvas/test/test_canvas.html", "dom/canvas/test/test_canvas_png_roundtrip.html", "gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleGeneric.h", "gfx/2d/SwizzleNEON.h", "gfx/tests/gtest/TestSwizzle.cpp", "image/test/unit/image1.webp", "image/test/unit/image1png16x16.jpg", "image/test/unit/image1png64x64.jpg", "image/test/unit/image1quality50.webp", "image/test/unit/test_imgtools.js", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.w.html.ini", "testing/web-platform/tests/jpegxl/conformance-alpha-premultiplied-reftest.html", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.libz-rs.png", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.png"], "git_node": "6b9d9e663b9f03aa6ef57a21e595a11490eac445", "git_parents": ["e54a2676bfe9a4011817f57f30e8dbd011fd3687"], "node": "dc7e8879cfdf6b74aa9758114e27f97bf19a8af3", "parents": ["800b02e90d90cbad20412beb766a034e27234ebc"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075334 - Credit the current cairo copyright holders on about:license r=gfx-reviewers,lsalzman DONTBUILD\n\nThe holder list predated pixman's move out of gfx/cairo and most names no\nlonger had code there, while the notice claimed all of gfx/cairo, which is\nMPL-1.1/LGPL-2.1. It now covers the nine files carrying the notice, and the\nMIT-licensed scan converters, which were not credited at all, join the MIT\nnotice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332096\n", "files": ["gfx/cairo/moz.build"], "git_node": "51d5d8687bcbafdc765ffd817d3385505472089c", "git_parents": ["6b9d9e663b9f03aa6ef57a21e595a11490eac445"], "node": "aa3a5719747fe14627e6cd0693d49d4f9d1e43ec", "parents": ["dc7e8879cfdf6b74aa9758114e27f97bf19a8af3"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075334 - Declare the about:license credits next to the code they cover r=firefox-build-system-reviewers,ahochheiden\n\nA build without the code no longer shows its credit: Linux no longer\nthanks the Windows installer's NSIS, and the FreeType credit only appears\non Android, the one platform that builds FreeType from the tree. With\nthat, the FreeType line can use the FreeType License's credit sentence\nas is. The Acknowledgements section is left out when a build has nothing\nto list.\n\nEach credit now sits on a LICENSES declaration for its library, which\nalso brings their license texts onto the page: the FreeType License,\nkept from upstream's docs/FTL.TXT, and NSIS's COPYING are added for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328970\n", "files": ["browser/installer/windows/moz.build", "browser/installer/windows/nsis-license.txt", "media/libjpeg/moz.build", "media/libpng/moz.build", "modules/freetype2/docs/FTL.TXT", "modules/freetype2/moz.build", "modules/freetype2/moz.yaml", "modules/zlib/moz.build", "third_party/sqlite3/src/moz.build", "toolkit/content/license.html.mako"], "git_node": "ffbd57416f154d1de10fc4abae265735a43dfd01", "git_parents": ["51d5d8687bcbafdc765ffd817d3385505472089c"], "node": "0def769856fb0f0ce6123320d5af20fbc165a233", "parents": ["aa3a5719747fe14627e6cd0693d49d4f9d1e43ec"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075334 - Drop Markdown line breaks from about:license texts r=firefox-build-system-reviewers,ahochheiden\n\nlibjpeg-turbo's LICENSE.md ends a line with \u003cbr\u003e, which showed as a literal\ntag in the plain-text block.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332095\n", "files": ["python/mozbuild/mozbuild/licenses.py", "python/mozbuild/mozbuild/test/test_license_collection.py"], "git_node": "84e04c69eaaa78ff3a2e0a65c199d34d2373d8ab", "git_parents": ["ffbd57416f154d1de10fc4abae265735a43dfd01"], "node": "68a2b0dbc9470a0d9ee5bf581ecc3f909012f5bd", "parents": ["0def769856fb0f0ce6123320d5af20fbc165a233"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075177 - Update the nimbus skill with the rollout info. r=jlockhart,ai4dev-reviewers,suhaib DONTBUILD\n\nRollouts now use phased schedules, and disabling one removes the recipe\nuntil the next phase republishes it, so code has to handle unenrollment\nat runtime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328809\n", "files": [".agents/skills/nimbus-prefs/SKILL.md", ".claude/skills/nimbus-prefs/SKILL.md"], "git_node": "6c6ed55e1969a0becb7613845f4ab25014df08d1", "git_parents": ["84e04c69eaaa78ff3a2e0a65c199d34d2373d8ab"], "node": "2b07a3c05152cce8894203e222103baa755473dd", "parents": ["68a2b0dbc9470a0d9ee5bf581ecc3f909012f5bd"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2061793: Simplify/modernize this, and treat an empty cipher list as an error. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332256\n", "files": ["dom/media/webrtc/transport/transportlayerdtls.cpp"], "git_node": "3575bb6a12b8989d384b690fd6a19d1a89ed413a", "git_parents": ["6c6ed55e1969a0becb7613845f4ab25014df08d1"], "node": "03f2238ce87171b0a33dc669191aef5ba7cf05fb", "parents": ["2b07a3c05152cce8894203e222103baa755473dd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079733 - Move always_underline_links to StyleAdjuster. r=layout-reviewers,jfkthame\n\nThis allows to preserve strike-throughs and such.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332030\n", "files": ["layout/reftests/text-decoration/always-underline-links-line-through-ref.html", "layout/reftests/text-decoration/always-underline-links-line-through.html", "layout/reftests/text-decoration/reftest.list", "layout/style/res/ua.css", "servo/components/style/style_adjuster.rs", "servo/components/style/values/specified/text.rs", "widget/nsXPLookAndFeel.cpp", "xpcom/ds/StaticAtoms.py"], "git_node": "eaa37f33de4386aed354511f291e8e75be657edf", "git_parents": ["3575bb6a12b8989d384b690fd6a19d1a89ed413a"], "node": "63aacff3dc73b9f3a8f4552f8c79b0aeb12e09f1", "parents": ["03f2238ce87171b0a33dc669191aef5ba7cf05fb"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079353