ng/web-platform/tests/core-aam/aamtests/attribute/aria_value_now.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_value_text.py"], "git_node": "1196bc56d108ee52d896d06453443ac350794f26", "git_parents": ["ec88d5497b6b1080bf83c4d3ead01d3259a84f98"], "node": "803237aaf5994d2441e8912a62c7df8d862db4e2", "parents": ["3a51a9872b9e0f3606df737f3f36f93efb513070"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075465 [wpt PR 62435] - Update wpt metadata, a=testonly\n\nwpt-pr: 62435\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/core-aam/aamtests/attribute/aria_brailleroledescription_undefined.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_invalid_spelling_grammar.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_invalid_true.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_invalid_unrecognized_value.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_readonly_true.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_readonly_unspecified_on_gridcell.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_role_description_empty_string.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_setsize_indeterminate.py.ini"], "git_node": "4247b7b4213d440528caf840e690b6537c749240", "git_parents": ["1196bc56d108ee52d896d06453443ac350794f26"], "node": "0642854d8afb81d1c803d11494b0121790513ca1", "parents": ["803237aaf5994d2441e8912a62c7df8d862db4e2"], "tags": []}, {"author": "Romain Menke \u003c11521496+romainmenke@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077380 [wpt PR 63175] - [css-color-5] fix some recently added test cases for color-mix, a=testonly\n\nAutomatic update from web-platform-tests\n[css-color-5] fix some recently added test cases for color-mix (#63175)\n--\n\nwpt-commits: 588420c752cb4988fb2fc193583637a4b6452406\nwpt-pr: 63175\n", "files": ["testing/web-platform/tests/css/css-color/parsing/color-computed-color-mix-function.html"], "git_node": "0cf3071ef56c7ccaae040df60de0273bcf744359", "git_parents": ["4247b7b4213d440528caf840e690b6537c749240"], "node": "3fcd7f259c306e8f857f3da1b40135f41aa2eead", "parents": ["0642854d8afb81d1c803d11494b0121790513ca1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077380 [wpt PR 63175] - Update wpt metadata, a=testonly\n\nwpt-pr: 63175\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color/parsing/color-computed-color-mix-function.html.ini"], "git_node": "9b353223d67a9691e981f46033210709602e13f0", "git_parents": ["0cf3071ef56c7ccaae040df60de0273bcf744359"], "node": "d4229d70e18aa1aa1550dd8914e5cb4968c2c370", "parents": ["3fcd7f259c306e8f857f3da1b40135f41aa2eead"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076986 [wpt PR 63127] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322873, a=testonly\n\nAutomatic update from web-platform-tests\n[Grid Lanes] Explicitly-placed items should not advance the auto-placement cursor. (#63127)\n\nUnlike regular grid, where all explicitly-placed items are positioned before auto-placement\nruns, Grid Lanes places items interleaved in order. That raised the question of whether an\nexplicitly-placed item should move the auto-placement cursor along with it.\n\nThe CSSWG resolved this in\nhttps://github.com/w3c/csswg-drafts/issues/13987#issuecomment-5192487721:\n\n    RESOLVED: Remove issue, leave spec as-is (not updating auto-placement cursor with\n    explicit placement)\n\nGridLanesLayout was updating m_autoFlowNextCursor from insertIntoGridAndLayoutItem(), which\nruns for every item, so explicitly-placed items dragged the cursor along too. Move the\nupdate up into placeGridLanesItems(), which already knows whether the item resolved a\ndefinite grid-axis position, and only advance the cursor for auto-placed items.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322873\nWebKit-Canonical-Link: https://commits.webkit.org/320253@main\n--\n\nwpt-commits: 0b934ff0bd6dcf5ea6525bbcaf5812d2f5237f71\nwpt-pr: 63127\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/column-fit-tolerance-infinite-explicit-placement-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/column-fit-tolerance-infinite-explicit-placement.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/row-auto-placement-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/row-auto-placement-003.html"], "git_node": "7bdad7e2640b1bfceb2ff8e59e2676dd1fcd206f", "git_parents": ["9b353223d67a9691e981f46033210709602e13f0"], "node": "dca05d0e43536b09beb1511f950f3300087a0e73", "parents": ["d4229d70e18aa1aa1550dd8914e5cb4968c2c370"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076986 [wpt PR 63127] - Update wpt metadata, a=testonly\n\nwpt-pr: 63127\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/column-fit-tolerance-infinite-explicit-placement.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/row-auto-placement-003.html.ini"], "git_node": "36463f5b994f36a581e94b02e0fa30f1dd5cdb7d", "git_parents": ["7bdad7e2640b1bfceb2ff8e59e2676dd1fcd206f"], "node": "c4339e17489ce5a57db2602aabc8fcdfd835ffd4", "parents": ["dca05d0e43536b09beb1511f950f3300087a0e73"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076995 [wpt PR 63133] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325661, a=testonly\n\nAutomatic update from web-platform-tests\n[css-grid] Remove legacy grid tests that are duplicated by WPT (#63133)\n\nSeveral tests in fast/css-grid-layout were upstreamed to WPT long ago\nand the imported copies now cover everything the legacy versions test,\nusually with more subtests. Each legacy test was compared against its\nWPT counterpart subtest by subtest, and each WPT counterpart passes with\nno TestExpectations entries.\n\nRemoved test (fast/css-grid-layout/) -\u003e WPT replacement (css/css-grid/):\n\ncontaining-block-grids -\u003e abspos/absolute-positioning-grid-container-containing-block-001\n\ngrid-align-baseline -\u003e alignment/grid-align-baseline\n\ngrid-align-baseline-vertical -\u003e alignment/grid-align-baseline-vertical,\n                                alignment/grid-align-baseline-vertical-mixed\n    The legacy test set `text-orientation: sideways-right`, which the\n    unprefixed property rejects, so it ran with `mixed` and the system\n    font, and was marked failing on every platform. The WPT test covers\n    `sideways`; the new -mixed variant covers `mixed` with Ahem.\n\ngrid-auto-flow-sparse -\u003e placement/grid-auto-flow-sparse-001\n\ngrid-container-change-explicit-grid-recompute-child -\u003e\n        placement/grid-container-change-grid-tracks-recompute-child-positions-001\n\ngrid-container-ignore-first-line -\u003e grid-model/grid-container-ignores-first-line-001\n\ngrid-container-percentage-rows -\u003e layout-algorithm/grid-container-percentage-002\n\ngrid-container-scroll-accounts-for-sizing -\u003e grid-model/grid-container-scrollbars-sizing-001,\n                                             grid-model/grid-container-scrollbars-sizing-002\n    001 is the same test with float: left; 002 covers fit-content grids.\n\ngrid-dynamic-updates-relayout -\u003e grid-definition/grid-template-columns-rows-changes-001\n\ngrid-gutters-and-flex-content -\u003e grid-model/grid-gutters-and-flex-content-001\n\ngrid-gutters-and-tracks -\u003e grid-model/grid-gutters-and-tracks-001\n\ngrid-gutters-as-percentage -\u003e grid-model/grid-gutters-as-percentage-001\n\ngrid-item-first-letter-valid -\u003e grid-model/grid-item-accepts-first-letter-001\n\ngrid-item-first-line-valid -\u003e grid-model/grid-item-accepts-first-line-001\n\ngrid-item-z-index-stacking-context -\u003e grid-items/grid-z-axis-ordering-00[1-5],\n                                      grid-items/grid-z-axis-ordering-overlapped-items-00[1-6]\n\ngrid-margins-not-collapse -\u003e grid-model/grid-margins-no-collapse-001\n\npositioned-grid-items-sizing -\u003e abspos/positioned-grid-items-sizing-001\n\nvertical-align-do-not-effect-grid-items -\u003e grid-model/grid-vertical-align-001\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325661\nWebKit-Canonical-Link: https://commits.webkit.org/322277@main\n--\n\nwpt-commits: 4a58d4bc3beb008728eb9dcf4d4000e8878edce6\nwpt-pr: 63133\n", "files": ["testing/web-platform/tests/css/css-grid/alignment/grid-align-baseline-vertical-mixed.html"], "git_node": "abdba8a6b844540144b287c4cb5c02a4790186df", "git_parents": ["36463f5b994f36a581e94b02e0fa30f1dd5cdb7d"], "node": "087213402f69254434415a84c3dd8011538b9a3f", "parents": ["c4339e17489ce5a57db2602aabc8fcdfd835ffd4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076995 [wpt PR 63133] - Update wpt metadata, a=testonly\n\nwpt-pr: 63133\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/alignment/grid-align-baseline-vertical-mixed.html.ini"], "git_node": "2aa0654c67dd7ca76e7673b7544977b9a9d48cd9", "git_parents": ["abdba8a6b844540144b287c4cb5c02a4790186df"], "node": "6e8f0468646b917fead821fdbb8fc24739c16f2d", "parents": ["087213402f69254434415a84c3dd8011538b9a3f"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2076980 [wpt PR 63125] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325682, a=testonly\n\nAutomatic update from web-platform-tests\nConvert some fast/css-grid-layout tests to WPT ref tests (#63125)\n\nThere are some tests in fast/css-grd-layout that are trivially\nconvertible to WPT ref tests. These tests just need an equivalent -ref\nfile (assuming they cannot reuse an existing one) so we can just move\nthe test, move the -expected, and create a -ref for it. Also ned to make\nsure we are pointing at the right resources.\n\n- ascpect-ratio-with-percent-width and out-of-flow-with-sibling-anon-grid-item\n  had no doctype; one is added to both the test and the reference.\n- Tests whose passing rendering showed red (red means failure in WPT) now\n  use purple, in both the test and the reference.\n- Comments describing WebKit-internal layout paths (GFC, legacy RenderGrid)\n  are reworded in spec terms or removed.\n\nRemoved test (fast/css-grid-layout/) -\u003e new WPT test (css/css-grid/):\n\nascpect-ratio-with-percent-width -\u003e grid-items/grid-item-aspect-ratio-percent-width-001 (doctype added)\ncompute-intrinsic-logical-widths-should-not-mutate-children -\u003e layout-algorithm/grid-intrinsic-size-nested-baseline-grid-001 (red -\u003e purple)\nflex-content-sized-column-use-available-width -\u003e layout-algorithm/grid-flex-and-auto-columns-fill-available-width-001\nfloating-empty-grids -\u003e grid-model/grid-empty-floating-positioned-and-inline-001\ngrid-2x2-items-with-borders -\u003e layout-algorithm/grid-auto-tracks-items-with-borders-001\ngrid-item-border-overflow-paint -\u003e grid-items/grid-item-border-overflow-paint-001 (red -\u003e purple)\ngrid-item-grid-container-percentage-rows -\u003e grid-definition/grid-item-grid-container-percentage-rows-001\ngrid-item-margin-auto-columns-rows-vertical-rtl -\u003e layout-algorithm/grid-item-margin-auto-columns-rows-vertical-rtl-001\ngrid-item-overflow -\u003e grid-items/grid-item-min-size-auto-overflow-001\ngrid-item-overflow-paint -\u003e grid-items/grid-item-overflow-paint-001 (red -\u003e purple)\ngrid-item-paddings-and-writing-modes -\u003e grid-items/grid-item-paddings-and-writing-modes-001\ngrid-item-text-background-not-interleaved -\u003e grid-items/grid-item-text-background-not-interleaved-001\ngrid-item-with-border-track-sizing -\u003e layout-algorithm/grid-auto-track-item-with-border-001\ngrid-item-with-calc-padding-track-sizing -\u003e grid-items/grid-items-calc-paddings-001 (red -\u003e purple)\ngrid-item-with-em-padding-track-sizing -\u003e grid-items/grid-items-em-paddings-001 (red -\u003e purple)\ngrid-item-with-fixed-padding-and-percent-margin -\u003e grid-items/grid-items-percentage-margins-and-fixed-paddings-001 (red -\u003e purple)\ngrid-item-with-fixed-padding-intrinsic-track-sizing -\u003e layout-algorithm/grid-max-content-tracks-items-with-paddings-001 (red -\u003e purple)\ngrid-item-with-fixed-padding-track-sizing -\u003e grid-items/grid-items-fixed-paddings-001 (red -\u003e purple)\ngrid-item-with-percent-padding-track-sizing -\u003e grid-items/grid-items-percentage-paddings-016\n    The existing fixed-track tests (001, 002) use justify-items: start\n    with a single column; none covers stretched items in a 2x2 grid of\n    fixed tracks with different padding on each side.\ngrid-painting-item-overflow -\u003e grid-items/grid-item-overflow-offscreen-painting-001\ngrid-painting-items-only-once -\u003e grid-items/grid-items-painted-once-001\ngrid-painting-respect-dom-order -\u003e grid-items/grid-items-painting-order-dom-001\ngrid-painting-rtl -\u003e grid-model/grid-painting-rtl-001\nmin-width-height-auto-overflow -\u003e grid-items/grid-item-min-size-auto-overflow-002\nmulti-span-content-sized-columns-padding -\u003e layout-algorithm/grid-spanning-item-with-paddings-auto-columns-001 (red -\u003e purple)\nmulti-span-content-sized-rows-padding -\u003e layout-algorithm/grid-spanning-item-with-paddings-auto-rows-001 (red -\u003e purple)\nnamed-grid-areas-dynamic-with-media-query -\u003e placement/grid-template-areas-media-query-001\nnested-grid -\u003e grid-definition/grid-item-grid-container-percentage-rows-002\nout-of-flow-with-sibling-anon-grid-item -\u003e abspos/grid-abspos-sibling-of-anonymous-grid-item-001 (doctype added)\npainting-item-marginbox-overflowing-grid-area -\u003e grid-items/grid-item-margin-box-overflowing-grid-area-paint-001\npositioned-grid-container-item-percentage-size -\u003e grid-items/grid-item-percentage-size-in-positioned-grid-001\nscrolled-grid-painting -\u003e grid-model/grid-scrolled-painting-001\nscrolled-grid-painting-overflow -\u003e grid-model/grid-scrolled-painting-overflow-001\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325682\nWebKit-Canonical-Link: https://commits.webkit.org/322290@main\n--\n\nwpt-commits: 1726211cd46d35c87cf70465e0d7054bfc446b1d\nwpt-pr: 63125\n", "files": ["testing/web-platform/tests/css/css-grid/abspos/grid-abspos-sibling-of-anonymous-grid-item-001-ref.html", "testing/web-platform/tests/css/css-grid/abspos/grid-abspos-sibling-of-anonymous-grid-item-001.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-item-grid-container-percentage-rows-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-item-grid-container-percentage-rows-001.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-item-grid-container-percentage-rows-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-item-grid-container-percentage-rows-002.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-aspect-ratio-percent-width-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-aspect-ratio-percent-width-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-border-overflow-paint-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-border-overflow-paint-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-margin-box-overflowing-grid-area-paint-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-margin-box-overflowing-grid-area-paint-001.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-min-size-auto-ov