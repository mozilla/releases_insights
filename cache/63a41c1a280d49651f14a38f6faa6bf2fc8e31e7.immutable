d_party/parakeet.cpp/src/scene_render.hpp", "third_party/parakeet.cpp/src/scene_stream.cpp", "third_party/parakeet.cpp/src/scene_stream.hpp", "third_party/parakeet.cpp/src/sound_stream.cpp", "third_party/parakeet.cpp/src/sound_stream.hpp", "third_party/parakeet.cpp/src/tdt.cpp", "third_party/parakeet.cpp/src/tdt.hpp", "third_party/parakeet.cpp/src/tokenizer.cpp", "third_party/parakeet.cpp/src/tokenizer.hpp", "third_party/parakeet.cpp/src/transcription_json.cpp", "third_party/parakeet.cpp/src/transcription_json.hpp"], "git_node": "9ddcf22f3999be0407532566749275218d22b4ac", "git_parents": ["c91204eb434ffc39fbe4499c23303eab7db8c454"], "node": "0d5e771a72498970454e7c6b47611a3d381c36b8", "parents": ["2a673454957f53e67fc6a6555ca6784645359169"], "tags": []}, {"author": "Nico Burns \u003cnico@nicoburns.com\u003e", "branch": "default", "desc": "Bug 2080580 - Add the fit-tolerance property behind the grid-lanes pref. r=firefox-style-system-reviewers,emilio\n\nImport the property from Servo's Stylo, with flow-tolerance as an alias for its\nprevious name, and enable it for Gecko too.\n\nIt lives in nsStyleDisplay for now, as nsStylePosition does not have room for it\nunder the style struct size limit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332872\n", "files": ["devtools/server/actors/animation-type-longhand.js", "dom/base/use_counter_metrics.yaml", "layout/style/ServoBindings.toml", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/style/test/property_database.js", "layout/style/test/test_transitions_per_property.html", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/length.rs", "servo/components/style/values/generics/length.rs", "servo/components/style/values/specified/length.rs", "servo/ports/geckolib/cbindgen.toml", "testing/web-platform/meta/css/css-grid/grid-lanes/animation/fit-tolerance-interpolation.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/tentative/parsing/flow-tolerance-computed.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/tentative/parsing/flow-tolerance-valid.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/explicit-inherit/all-length-properties.html.ini"], "git_node": "0083473b8ea046bd95c319e422bb21df16a8a358", "git_parents": ["9ddcf22f3999be0407532566749275218d22b4ac"], "node": "13830bf0f66acff0ee7db9578fb9a952c54a6f28", "parents": ["0d5e771a72498970454e7c6b47611a3d381c36b8"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069293 - Keep the known IP Protection account status when the account manager reports WarmingUp. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333427\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FxaAccountStoreSyncTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/IPProtectionFeatureTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "ea0c76528eb5da6b0345b7ec09cf25a1d0d1a177", "git_parents": ["0083473b8ea046bd95c319e422bb21df16a8a358"], "node": "b374534c51d456ff16dacd33a00630ebecf30c11", "parents": ["13830bf0f66acff0ee7db9578fb9a952c54a6f28"], "tags": []}, {"author": "Dmitry Gozman \u003cdgozman@gmail.com\u003e", "branch": "default", "desc": "Bug 2080149 - Add BrowsingContext flag to emulate prefers-contrast. r=emilio,firefox-style-system-reviewers,layout-reviewers,dshin\n\nAdd a chrome-only prefersContrastOverride attribute on BrowsingContext, next\nto the existing prefers-color-scheme, prefers-reduced-motion and forced-colors\noverrides, so that tooling (DevTools, Remote Agent, out-of-tree automation)\ncan emulate the prefers-contrast media feature for a single top-level\nbrowsing context. \"none\" keeps the current system-derived behaviour.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332380\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "dom/chrome-webidl/BrowsingContext.webidl", "layout/base/tests/mochitest.toml", "layout/base/tests/test_emulate_prefers_contrast.html", "layout/style/nsMediaFeatures.cpp"], "git_node": "e1dd212956191db55c9afa269649610ea9e5a0e3", "git_parents": ["ea0c76528eb5da6b0345b7ec09cf25a1d0d1a177"], "node": "553bf86e3acb1c713b59ea21a3058b471d80c066", "parents": ["b374534c51d456ff16dacd33a00630ebecf30c11"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080704 - Control the Rust autofill storage prefs through Nimbus. r=credential-management-reviewers,NeilDeakin\n\nSet on the user branch so that a storage load early in startup, before Nimbus\nhas applied its enrollments, does not read false and copy the records back to\nJSON.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332818\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_storage_rust_nimbus.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "b5512c46b21d97ef7c2a5a68e6e122ba29a2af61", "git_parents": ["e1dd212956191db55c9afa269649610ea9e5a0e3"], "node": "345fcd4799070978b27dd2e17a3506faf78d0fe1", "parents": ["553bf86e3acb1c713b59ea21a3058b471d80c066"], "tags": []}, {"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074693 - Keep the card stack's back cards behind the front card in RTL r=emcminn,omc-reviewers\n\nNormally, when elements in `.screen[pos='card-stack']` become a stacking\ncontext (which happens in RTL mode), the elements with negative z-index\npaint above the top card, which means the back cards render above it.\n\nIn this patch, we make `.screen[pos='card-stack']` always a stacking\ncontext with no background color of it's own, then change the z-index\ninside the isolated screen, so that the content paints above all of\nthose ::after elements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333022\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/tests/browser/browser.toml", "browser/components/asrouter/tests/browser/browser_asrouter_newtab_card_stack.js", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAWProton.test.jsx"], "git_node": "3e621d6e27df2b9f959446a9d4a47b7009e473b3", "git_parents": ["b5512c46b21d97ef7c2a5a68e6e122ba29a2af61"], "node": "8c09abb17fd98be2828cefbcad9d0896087a7645", "parents": ["345fcd4799070978b27dd2e17a3506faf78d0fe1"], "tags": []}, {"author": "calixteman \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2076546 - Prefer the source folder only when saving edited local PDFs. r=mak\n\nRestore the last-used directory for unmodified PDFs and other local-file\nsaves, while preserving the edited-PDF behavior from bug 2059930.\nRequires the pdf.js update that sends isModified with download requests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332972\n", "files": ["toolkit/components/pdfjs/content/PdfJsParent.sys.mjs", "toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/test/browser_pdfjs_saveas.js", "toolkit/content/contentAreaUtils.js"], "git_node": "21ed79cc69de6089e4287f94a36cfd7a0bc891ad", "git_parents": ["3e621d6e27df2b9f959446a9d4a47b7009e473b3"], "node": "95d9c9adefa40500eded363168e2433819962e21", "parents": ["8c09abb17fd98be2828cefbcad9d0896087a7645"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081661 - Run the credit card migration dry run in Nightly r=joschmidt,credential-management-reviewers\n\nCopy the profile's credit cards into the Rust store, verify them, report the\nresult through migrate_to_rust, and wipe the copy again. Nothing reads from\nRust: creditCards.storage.rust.enabled stays off. Once per profile per\ngeneration, recorded on migrationTestVersion.\n\nThe copy is skipped when a primary password is set, and deferred while the OS\nkey store is locked or busy, so that it never asks the user anything. Record\nmigrate_to_rust_blocked with the reason each time, so that a profile held back\ncan be told apart from one with nothing to migrate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333618\n", "files": ["browser/extensions/formautofill/test/browser/browser_creditCard_migration.js", "browser/extensions/formautofill/test/unit/xpcshell.toml", "modules/libpref/init/all.js", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "9148e04653e1bef10f0717a7127e46dffa04361d", "git_parents": ["21ed79cc69de6089e4287f94a36cfd7a0bc891ad"], "node": "00a36497501289ef2353b607f1bc329033d04559", "parents": ["95d9c9adefa40500eded363168e2433819962e21"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068374 - Add a test for a trapping cross-realm wasm tail call. r=jpages\n\nDepends on D323721\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324387\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2068374.js"], "git_node": "966be33974e76e2086d3e38b1aae9bccaefd4a69", "git_parents": ["9148e04653e1bef10f0717a7127e46dffa04361d"], "node": "80b7811df6c98933b457abc739ec2a8c854ff369", "parents": ["00a36497501289ef2353b607f1bc329033d04559"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081659 - don't duplicate on-push tasks in cron graphs that schedule builds. r=taskgraph-reviewers,bhearsum DONTBUILD\n\nScheduling duplicate builds is wasteful and can cause problems for consumers.\nSet include-push-tasks for the devtools-backward-compat, eslint-build,\nos-integration, perftest-applink-profiling and perftest-fenix-startup cron\njobs.\n\nos-integration also sets optimize-target-tasks to false so its target tasks\nstill run rather than being replaced by the on-push ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333588\n", "files": [".cron.yml"], "git_node": "271c8c81647466e5834da0d25a904f66501f8f19", "git_parents": ["966be33974e76e2086d3e38b1aae9bccaefd4a69"], "node": "dc6dbb846c1b425d9a6c7a5f085c5f7b90588b4b", "parents": ["80b7811df6c98933b457abc739ec2a8c854ff369"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079894 - move createDefaultBrowserConfig out of main.js r=settings-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332167\n", "files": ["browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/config/default-browser.mjs", "browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/jar.mn", "browser/components/preferences/main.js"], "git_node": "b7ee4c06e54b3278b514c41cd7f2339d1c3cee5e", "git_parents": ["271c8c81647466e5834da0d25a904f66501f8f19"], "node": "4a9b8ea28d3b9300f6594a83dbaa8bf0eff9e94f", "parents": ["dc6dbb846c1b425d9a6c7a5f085c5f7b90588b4b"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079414 - move code from from the createStartupConfig method to home-startup.mjs from main.js r=settings-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332168\n", "files": ["browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/main.js"], "git_node": "61cc0452f3712efd0135aa777b1894104eb4de78", "git_parents": ["b7ee4c06e54b3278b514c41cd7f2339d1c3cee5e"], "node": "375cc130f7841dfa14d729ee951ce4f9daf6d7fa", "parents": ["4a9b8ea28d3b9300f6594a83dbaa8bf0eff9e94f"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081296 - Limit Max Tabs Processed for ATG to 200. r=jlewis\n\nThis patch limits the number of tabs we process to 200. If we detect\nmore than 200 tabs, we only process the 200 most recent ones.\n\nThis prevents memory issues for power users with large number of tabs.\n(e.g. p99 - 842 tabs ~40s, max 2k tabs ~90s)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333317\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "5b6026ae8222b6b5d30f3ec1a31357dacb4b832f", "git_parents": ["61cc0452f3712efd0135aa777b1894104eb4de78"], "node": "7575aae45b2f98cf196d38712bc6e16cf195ea9c", "parents": ["375cc130f7841dfa14d729ee951ce4f9daf6d7fa"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074346 - Update parakeet.cpp to 623a968b r=media-webspeech-reviewers,pehrsons\" for causing lint vendor failures\n\nThis reverts commit 9ddcf22f3999be0407532566749275218d22b4ac.\n", "files": ["third_party/parakeet.cpp/include/parakeet_capi.h", "third_party/parakeet.cpp/moz.build", "third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-chunk-samples.patch", "third_party/parakeet.cpp/parakeet-end-utterance.patch", "third_party/parakeet.cpp/parakeet-free-host-weights.patch", "third_party/parakeet.cpp/parakeet-move-mel-batch.patch", "third_party/parakeet.cpp/parakeet-no-drwav.patch", "third_party/parakeet.cpp/parakeet-no-exceptions.patch", "third_party/parakeet.cpp/src/asr_committer.cpp", "third_party/parakeet.cpp/src/asr_committer.hpp", "third_party/parakeet.cpp/src/audio_io.cpp", "third_party/parakeet.cpp/src/audio_io.hpp", "third_party/parakeet.cpp/src/backend.hpp", "third_party/parakeet.cpp/src/ced_tagger.cpp", "third_party/parakeet.cpp/src/ced_tagger.hpp", "third_party/parakeet.cpp/src/diar_pcm_stream.cpp", "third_party/parakeet.cpp/src/diar_pcm_stream.hpp", "third_party/parakeet.cpp/src/diarization.cpp", "third_party/parakeet.cpp/src/diarization.hpp", "third_party/parakeet.cpp/src/diarization_encoder.cpp", "third_party/parakeet.cpp/src/diarization_encoder.hpp", "third_party/parakeet.cpp/src/diarization_head.cpp", "third_party/parakeet.cpp/src/diarization_head.hpp", "third_party/parakeet.cpp/src/diarization_streaming.cpp", "third_party/parakeet.cpp/src/diarization_streaming.hpp", "third_party/parakeet.cpp/src/dr_wav_impl.cpp", "third_party/parakeet.cpp/src/fft.cpp", "third_party/parakeet.cpp/src/mel.cpp", "third_party/parakeet.cpp/src/mel.hpp", "third_party/parakeet.cpp/src/model.cpp", "third_party/parakeet.cpp/src/model.hpp", "third_party/parakeet.cpp/src/model_loader.cpp", "third_party/parakeet.cpp/src/model_loader.hpp", "third_party/parakeet.cpp/src/parakeet.cpp", "third_party/parakeet.cpp/src/parakeet_capi.cpp", "third_party/parakeet.cpp/src/relpos_attention.cpp", "third_party/parakeet.cpp/src/sas_merge.cpp", "third_party/parakeet.cpp/src/sas_merge.hpp", "third_party/parakeet.cpp/src/scene_render.cpp", "third_party/parakeet.cpp/src/scene_render.hpp", "third_party/parakeet.cpp/src/scene_stream.cpp", "third_party/parakeet.cpp/src/scene_stream.hpp", "third_party/parakeet.cpp/src/sound_stream.cpp", "third_party/parakeet.cpp/src/sound_stream.hpp", "third_party/parakeet.cpp/src/tdt.cpp", "third_party/parakeet.cpp/src/tdt.hpp", "third_party/parakeet.cpp/src/tokenizer.cpp", "third_party/parakeet.cpp/src/tokenizer.hpp", "third_party/parakeet.cpp/src/transcription_json.cpp", "third_party/parakeet.cpp/src/transcription_json.hpp"], "git_node": "6f910c0238f056b63bf1ed183909e513702c02fc", "git_parents": ["5b6026ae8222b6b5d30f3ec1a31357dacb4b832f"], "node": "b278b8ae1cbec3c2108c1440ba05b5f6e16b1342", "parents": ["7575aae45b2f98cf196d38712bc6e16cf195ea9c"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076775 - Fall back to the document's referrer policy for speculation rules prefetch. r=necko-reviewers,sunil\" for causing wpt failures @ /speculation-rules/prefetch/referrer-policy-from-rules.https.html?8-last\n\nThis reverts commit ef8e19a316ec7522c5cdd35b198e95ca9d07ae79.\n", "files": ["dom/base/SpeculationRulesManager.cpp", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini"], "git_node": "d1937f4be051df35283c604d57cd641162b8afc2", "git_parents": ["6f910c0238f056b63bf1ed183909e513702c02fc"], "node": "d5bee7137ad3d868abc8429ed3345748fa485b57", "parents": ["b278b8ae1cbec3c2108c1440ba05b5f6e16b1342"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079414 - move code from from the createStartupConfig method to home-startup.mjs from main.js r=settings-reviewers,mconley\" for causing bc failures @ browser_sessionRestoreNewTab.js\n\nThis reverts commit 61cc0452f3712efd0135aa777b1894104eb4de78.\n", "files": ["browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/main.js"], "git_node": "4cdac103dab751bbe26d59dfb3f7dd4d7ba2c34a", "git_parents": ["d1937f4be051df35283c604d57cd641162b8afc2"], "node": "fc7a16489ab573579483854b5c91e986fb00ade4", "parents": ["d5bee7137ad3d868abc8429ed3345748fa485b57"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079894 - move createDefaultBrowserConfig out of main.js r=settings-reviewers,mconley\" for causing bc failures @ browser_sessionRestoreNewTab.js\n\nThis reverts commit b7ee4c06e54b3278b514c41cd7f2339d1c3cee5e.\n", "files": ["browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/config/default-browser.mjs", "browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/jar.mn", "browser/components/preferences/main.js"], "git_node": "1928c80b890de2e720c3b8ff293cc45f64c59c9d", "git_parents": ["4cdac103dab751bbe26d59dfb3f7dd4d7ba2c34a"], "node": "c04b99e87813cc3280c2f0904338abe196d97daa", "parents": ["fc7a16489ab573579483854b5c91e986fb00ade4"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081788 - Treat a missing guid as no such record in the Rust autofill adapter. r=joschmidt,credential-management-reviewers\n\nThe \"Add\" address button opens the edit dialog with an undefined guid,\nwhich is passed to `addresses.get()`. The JSON store returns null for it,\nbut the Rust adapter forwarded it to the UniFFI binding, whose type check\nthrows, so the dialog never opened once the Rust address store was enabled.\n`get()` and `remove()` now handle a missing guid the way the JSON store\ndoes, which also covers `update()` and `notifyUsed()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333699\n", "files": ["browser/extensions/formautofill/test/browser/address/browser_manageAddressesSubpage.js", "toolkit/components/formautofill/RustAutofillAdapterBase.sys.mjs"], "git_node": "a78ab6586cb85ca145610ead8d7844a57df18003", "git_parents": ["1928c80b890de2e720c3b8ff293cc45f64c59c9d"], "node": "b9f313bd5e1371aeaa910486cf3514088f99e17f", "parents": ["c04b99e87813cc3280c2f0904338abe196d97daa"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079498 - Offer the security code checkbox in the card doorhanger whenever security codes are supported. r=credential-management-reviewers,dimi\n\nThe checkbox now follows extensions.formautofill.creditCards.cvv.supported\nrather than requiring capture to already be on, and starts from the\n\"Save security codes\" setting, so a user who turned it off can turn it back\non from the doorhanger.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333475\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "96eb774681eb9cd2cadf2e86ae684b8f5ee85185", "git_parents": ["a78ab6586cb85ca145610ead8d7844a57df18003"], "node": "407e2ef47d69e034588dc721a18a06aaf197d1f8", "parents": ["b9f313bd5e1371aeaa910486cf3514088f99e17f"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080236 - Fire beforeinput events on undo/redo in EditContext. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333252\n", "files": ["editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "testing/web-platform/tests/editing/edit-context/edit-context-undo-redo.tentative.html", "testing/web-platform/tests/editing/include/editor-test-utils.js"], "git_node": "4de774a7bc5f123c60f1be5bdc0415948fa9c21f", "git_parents": ["96eb774681eb9cd2cadf2e86ae684b8f5ee85185"], "node": "e6d2a1838d5e5989d94f90ab2d8041a256d3cd06", "parents": ["407e2ef47d69e034588dc721a18a06aaf197d1f8"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1972602 - Remove legacy enrollment store and disable persistence in tests r=ralkhulaidi,nimbus-reviewers,emcminn,settings-reviewers,Gijs\n\nThe shared SQL database in the ProfilesDatastoreServices has been the\nsource of truth for Nimbus since bug 1972426. However, we've still had\nthe legacy ExperimentDataStore.json to support xpcshell tests that do\nnot enable the ProfilesDatastoreService (see bug 1967779).\n\nBy default we no longer persist experiments to disk when running in a\ntest environment (when `Cu.isInAutomation` is true at startup). This\nremoves the need for keeping the legacy experiment store. Persistence\nis, however, enabled in all toolkit/components/nimbus xpcshell tests to\nensure correctness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322754\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/experimental_features/head.js", "browser/components/urlbar/tests/browser-quickactions/browser_commands.js", "testing/profiles/xpcshell/user.js", "toolkit/components/nimbus/lib/Enrollments.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/ExperimentStore.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/browser/browser_SharedDataMap.js", "toolkit/components/nimbus/test/browser/browser_about_config_pref_change.js", "toolkit/components/nimbus/test/browser/browser_experimentapi_child.js", "toolkit/components/nimbus/test/browser/browser_remotesettings_experiment_enroll.js", "toolkit/components/nimbus/test/browser/head.js", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml", "toolkit/components/nimbus/test/unit/test_ExperimentManager_lifecycle.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_prefs.js", "toolkit/components/nimbus/test/unit/test_ExperimentStore.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_Migrations.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_bug2054546.js", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "a1c7b86c0dd2b92e7d093707cf799573bb9336d0", "git_parents": ["4de774a7bc5f123c60f1be5bdc0415948fa9c21f"], "node": "44b6039d714771d924512aeb6042a9251ab9d27d", "parents": ["e6d2a1838d5e5989d94f90ab2d8041a256d3cd06"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081219 - Make nsLocalFile::CopyDirectoryTo copy the contents of read-only directories, r=xpcom-reviewers,jstutte.\n\nOn Unix, the destination directory was created with the source directory's permissions before the children were copied into it, so with a read-only source every child copy failed. These errors are ignored, so the copy silently produced an empty directory. Create the directory with owner rwx added and, once its contents are copied, chmod it to the source permissions minus the umask, like cp -r does. The copy gets the same permissions mkdir would have given it, whether or not the source is read-only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333292\n", "files": ["xpcom/io/nsLocalFileUnix.cpp", "xpcom/tests/unit/test_file_copyTo_permissions.js", "xpcom/tests/unit/xpcshell.toml"], "git_node": "928594629d7aba1176de029f0ed230725c4c6766", "git_parents": ["a1c7b86c0dd2b92e7d093707cf799573bb9336d0"], "node": "f0c7904b207e255cf156fd9efd11b5e494ef044e", "parents": ["44b6039d714771d924512aeb6042a9251ab9d27d"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2075344 - Add a secret setting and nimbus flag to select the sear\u2026 r=pollymce\n\nAdd a `search-config-v3` Nimbus feature and a matching secret setting under the\nexisting Search category, so the collection used for search configuration can be\nselected remotely with a local override for testing. The default is off, matching\nthe desktop `browser.search.configV3.featureGate` preference, and the switch is\nexpected to be temporary while v3 is validated.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/389\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "f376ed736c6e0ba408104f439a5b2c40cc4ca1cd", "git_parents": ["928594629d7aba1176de029f0ed230725c4c6766"], "node": "b8dcbed9ed9499c0f30e2ff688873d71bd6514b2", "parents": ["f0c7904b207e255cf156fd9efd11b5e494ef044e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081030 - Annotate fontface-descriptor-updates as passing everywhere. r=layout-reviewers,dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333529\n", "files": ["testing/web-platform/meta/css/css-font-loading/fontface-descriptor-updates.html.ini"], "git_node": "a038432aa81fbe91111c1e8c786ca1ddb2e95a14", "git_parents": ["f376ed736c6e0ba408104f439a5b2c40cc4ca1cd"], "node": "6b3d88f6c81669aed514011740972050839f041a", "parents": ["b8dcbed9ed9499c0f30e2ff688873d71bd6514b2"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081249 - Handle empty profile shmems from child processes in nsProfiler::StartGathering. r=profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333246\n", "files": ["tools/profiler/gecko/nsProfiler.cpp"], "git_node": "9525291c21fc61fee34159e1b48ac61b4579cfbb", "git_parents": ["a038432aa81fbe91111c1e8c786ca1ddb2e95a14"], "node": "ecbc9b458fa8059e8ea15c99c8a90bebc51e6830", "parents": ["6b3d88f6c81669aed514011740972050839f041a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081249 - Bound the time CanvasTranslator::CheckAndSignalWriter waits for the writer to leave the AboutToWait state. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333248\n", "files": ["gfx/layers/ipc/CanvasTranslator.cpp"], "git_node": "77689c92128a625a6bf45b9afb10aa13e9262723", "git_parents": ["9525291c21fc61fee34159e1b48ac61b4579cfbb"], "node": "b9923b8610354cdcec453f6a1499feecddc072de", "parents": ["ecbc9b458fa8059e8ea15c99c8a90bebc51e6830"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2081249: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["tools/profiler/gecko/nsProfiler.cpp"], "git_node": "0ca205adf8ce6581abb52f57ec08140ff7668dc6", "git_parents": ["77689c92128a625a6bf45b9afb10aa13e9262723"], "node": "23f00d653749c52d136fa4408ebccd64b92bf399", "parents": ["b9923b8610354cdcec453f6a1499feecddc072de"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2074346 - Update parakeet.cpp to 623a968b r=media-webspeech-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332846\n", "files": ["third_party/parakeet.cpp/include/parakeet_capi.h", "third_party/parakeet.cpp/moz.build", "third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-chunk-samples.patch", "third_party/parakeet.cpp/parakeet-end-utterance.patch", "third_party/parakeet.cpp/parakeet-free-host-weights.patch", "third_party/parakeet.cpp/parakeet-move-mel-batch.patch", "third_party/parakeet.cpp/parakeet-no-drwav.patch", "third_party/parakeet.cpp/parakeet-no-exceptions.patch", "third_party/parakeet.cpp/src/asr_committer.cpp", "third_party/parakeet.cpp/src/asr_committer.hpp", "third_party/parakeet.cpp/src/audio_io.cpp", "third_party/parakeet.cpp/src/audio_io.hpp", "third_party/parakeet.cpp/src/backend.hpp", "third_party/parakeet.cpp/src/ced_tagger.cpp", "third_party/parakeet.cpp/src/ced_tagger.hpp", "third_party/parakeet.cpp/src/diar_pcm_stream.cpp", "third_party/parakeet.cpp/src/diar_pcm_stream.hpp", "third_party/parakeet.cpp/src/diarization.cpp", "third_party/parakeet.cpp/src/diarization.hpp", "third_party/parakeet.cpp/src/diarization_encoder.cpp", "third_party/parakeet.cpp/src/diarization_encoder.hpp", "third_party/parakeet.cpp/src/diarization_head.cpp", "third_party/parakeet.cpp/src/diarization_head.hpp", "third_party/parakeet.cpp/src/diarization_streaming.cpp", "third_party/parakeet.cpp/src/diarization_streaming.hpp", "third_party/parakeet.cpp/src/dr_wav_impl.cpp", "third_party/parakeet.cpp/src/fft.cpp", "third_party/parakeet.cpp/src/mel.cpp", "third_party/parakeet.cpp/src/mel.hpp", "third_party/parakeet.cpp/src/model.cpp", "third_party/parakeet.cpp/src/model.hpp", "third_party/parakeet.cpp/src/model_loader.cpp", "third_party/parakeet.cpp/src/model_loader.hpp", "third_party/parakeet.cpp/src/parakeet.cpp", "third_party/parakeet.cpp/src/parakeet_capi.cpp", "third_party/parakeet.cpp/src/relpos_attention.cpp", "third_party/parakeet.cpp/src/sas_merge.cpp", "third_party/parakeet.cpp/src/sas_merge.hpp", "third_party/parakeet.cpp/src/scene_render.cpp", "third_party/parakeet.cpp/src/scene_render.hpp", "third_party/parakeet.cpp/src/scene_stream.cpp", "third_party/parakeet.cpp/src/scene_stream.hpp", "third_party/parakeet.cpp/src/sound_stream.cpp", "third_party/parakeet.cpp/src/sound_stream.hpp", "third_party/parakeet.cpp/src/tdt.cpp", "third_party/parakeet.cpp/src/tdt.hpp", "third_party/parakeet.cpp/src/tokenizer.cpp", "third_party/parakeet.cpp/src/tokenizer.hpp", "third_party/parakeet.cpp/src/transcription_json.cpp", "third_party/parakeet.cpp/src/transcription_json.hpp"], "git_node": "be9336bab1d2d2d66a99c3965b0714cd6652b3d1", "git_parents": ["0ca205adf8ce6581abb52f57ec08140ff7668dc6"], "node": "79eaaa4bc6f98866dfa754093f5b6ac53a93e657", "parents": ["23f00d653749c52d136fa4408ebccd64b92bf399"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074139 - Fix triple clicking the toolbar Monitor button bug r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333033\n", "files": ["browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js"], "git_node": "6da6aa3e26080eedbf76a06cc4c642bb7110a8e6", "git_parents": ["be9336bab1d2d2d66a99c3965b0714cd6652b3d1"], "node": "41becb96777ad43f12fcb55ba50021142edcc178", "parents": ["79eaaa4bc6f98866dfa754093f5b6ac53a93e657"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077206 - Extract \u003csidebar-panel-header\u003e to a single element displayed over sidebar panels r=sidebar-reviewers,desktop-theme-reviewers,credential-management-reviewers,places-reviewers,kcochrane,sfoster,mtigley\n\nPanels no longer need to maintain their own instance of `\u003csidebar-panel-header\u003e`.\n\n`SidebarController` manages the shared header, and updates its `view` property whenever a panel is shown. The header then shares its property with its child switcher. Thus, the switcher no longer needs to maintain event listeners to track the active view.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332629\n", "files": ["browser/base/content/browser-box.inc.xhtml", "browser/base/content/webext-panels.js", "browser/base/content/webext-panels.xhtml", "browser/components/places/content/bookmarksSidebar.js", "browser/components/places/content/bookmarksSidebar.xhtml", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/sidebar-customize.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/sidebar-panel-header.css", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/sidebar-panel-switcher.mjs", "browser/components/sidebar/sidebar-syncedtabs.mjs", "browser/components/sidebar/sidebar.css", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_hide_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_header.js", "browser/themes/shared/places/sidebar.css", "browser/themes/shared/sidebar.css", "toolkit/components/satchel/megalist/content/MegalistAlpha.mjs", "toolkit/components/satchel/megalist/content/megalist.css"], "git_node": "5da0f66d7e818cf34fc834d68e1802c3cd766b87", "git_parents": ["6da6aa3e26080eedbf76a06cc4c642bb7110a8e6"], "node": "c2c9d7a7a37e52046da015ca75cc551d17c3fe6b", "parents": ["41becb96777ad43f12fcb55ba50021142edcc178"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2006225 - Adjust bookmark sidebar test for browser_documentnavigation.js r=sidebar-reviewers,sfoster\n\nThis bug no longer reproduces when using a shared header/switcher instance, so the workaround actually causes the test to _fail_ now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332902\n", "files": ["browser/base/content/test/browser-general/browser_documentnavigation.js"], "git_node": "be9de3260f869e9dfd3d824f8a2ffaa2d5eb621d", "git_parents": ["5da0f66d7e818cf34fc834d68e1802c3cd766b87"], "node": "8359c7ab8ac4a06c192059417e683f0a6e31381f", "parents": ["c2c9d7a7a37e52046da015ca75cc551d17c3fe6b"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076794 - Rewire AI Chatbot to use the shared switcher instance. r=desktop-theme-reviewers,sidebar-reviewers,yjamora,akulyk,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332903\n", "files": ["browser/components/genai/chat.css", "browser/components/genai/chat.html", "browser/components/genai/chat.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/themes/shared/sidebar.css"], "git_node": "be7d145c23500010e93f998d23ebe68ec982ffdf", "git_parents": ["be9de3260f869e9dfd3d824f8a2ffaa2d5eb621d"], "node": "e708d99a07aafbe4c2cff648c9d59987dffa67f2", "parents": ["8359c7ab8ac4a06c192059417e683f0a6e31381f"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Use isDefaultBrowserAsync() in IPProtectionPanel; r=ip-protection-reviewers,rking\n\nUse the asynchronous default-browser check when determining premium status for\nthe IPProtectionPanel. Wait for premium status before displaying the panel,\nkeeping the UI responsive while the check is pending.\n\nInvalidate pending showing attempts when the panel is destroyed or a newer\nattempt starts, preventing stale results from updating the panel.\n\nUpdate the panel tests to await showing() and cover hiding the panel while the\npremium check is pending.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332065\n", "files": ["browser/components/ipprotection/IPProtection.sys.mjs", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/xpcshell/test_IPProtectionPanel.js"], "git_node": "b3a1aea7362829e123f5798636e4d2b67c45f419", "git_parents": ["be7d145c23500010e93f998d23ebe68ec982ffdf"], "node": "9f07afed793e9dc08fe78ddedc994d475455ec5a", "parents": ["e708d99a07aafbe4c2cff648c9d59987dffa67f2"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079532 - update mots for machine learning related frontend r=flozia,shtrom\n\nadd multiline and frontend peers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331850\n", "files": ["mots.yaml"], "git_node": "0da07d05c269353dbc6360ac6a4fafbd88de329e", "git_parents": ["b3a1aea7362829e123f5798636e4d2b67c45f419"], "node": "08bc5f45da16046afff36fafe98b4b8a42bf9fe0", "parents": ["9f07afed793e9dc08fe78ddedc994d475455ec5a"], "tags": []}, {"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077641 - Stop disabling launch on login when the legacy profile manager is shown at startup. r=firefox-desktop-core-reviewers ,chumphreys,iholmes,mossop,mconley\n\nChoosing a profile at startup is no reason to keep Firefox from starting at login. The selectable profiles selector already appears at login without turning launch on login off.\n\nLaunchOnLogin.sys.mjs and StartupOSIntegration.sys.mjs no longer load before profile selection, so they come off the browser_startup.js allowlist.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330548\n", "files": ["browser/base/content/test/browser-performance/browser_startup.js", "browser/components/BrowserGlue.sys.mjs", "browser/components/metrics.yaml", "browser/components/preferences/main.js", "browser/components/preferences/tests/browser_windows_launch_on_login.js", "browser/components/shell/StartupOSIntegration.sys.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl", "toolkit/components/telemetry/Events.yaml"], "git_node": "34d8cfb1fb890dd376c322fe16df316075ea131c", "git_parents": ["0da07d05c269353dbc6360ac6a4fafbd88de329e"], "node": "bdfe2a536720645214353a01536948b4b5e5c45d", "parents": ["08bc5f45da16046afff36fafe98b4b8a42bf9fe0"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2076260 - Add a Nimbus targeting attribute for active web push subscriptions r=saschanaz,omc-reviewers,nimbus-reviewers,beth,jbrown,yazan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329652\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js", "browser/components/newtab/AboutNewTabResourceMapping.sys.mjs", "dom/push/PushService.sys.mjs", "dom/push/test/xpcshell/test_getAllUnexpiredNonSystem.js", "dom/push/test/xpcshell/xpcshell.toml", "toolkit/components/nimbus/ExperimentAPI.sys.mjs", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_ExperimentAPI.js"], "git_node": "9e68f465f4ca9f106d50eaf270181ee25e2834eb", "git_parents": ["34d8cfb1fb890dd376c322fe16df316075ea131c"], "node": "6e78d8d996ac4f7f19dd160f3728461f2e086fdf", "parents": ["bdfe2a536720645214353a01536948b4b5e5c45d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2081746 - [mips64] Implement lshift32Then{Add,Or}, rshiftPtrThenXor, and rotateLeft64ThenXor for MIPS64. r=spidermonkey-reviewers,iain\n\nThis is similar to https://phabricator.services.mozilla.com/D330421.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333638\n", "files": ["js/src/jit/mips64/MacroAssembler-mips64-inl.h"], "git_node": "c978fb89e5fa9b31cb65f58382535d2e294743b8", "git_parents": ["9e68f465f4ca9f106d50eaf270181ee25e2834eb"], "node": "2d84f5de1363149045466185bcd228cd78b2322c", "parents": ["6e78d8d996ac4f7f19dd160f3728461f2e086fdf"], "tags": []}, {"author": "Airat Makhmutov \u003crauty@altlinux.org\u003e", "branch": "default", "desc": "Bug 1321685 - Keep the generic of fontconfig alias families. r=jfkthame\n\nThis is necessary for color emoji in UI text whose GTK system font is a\nfontconfig alias such as \"Sans Serif\", the KDE Plasma default on some\ndistributions. Without the generic the expanded families count as\nexplicitly named, so font matching takes the monochrome emoticons of\nDejaVu Sans instead of falling back to the color emoji font.\n\nisDeprecatedGeneric goes away because the deprecated names are already\nrewritten to generics that Parse() recognizes.\n\nLink: https://bugzilla.altlinux.org/60882\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333636\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp"], "git_node": "76e74903d6b126b47ccf189208aaf119f6ec51d7", "git_parents": ["c978fb89e5fa9b31cb65f58382535d2e294743b8"], "node": "8cfc8927bfffa02e1a55f8efa5993d759b489ee3", "parents": ["2d84f5de1363149045466185bcd228cd78b2322c"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076295 - Frame cropped mini windows by zooming the visual viewport with APZ instead of a layout transform. r=emilio,webidl,layout-reviewers,mconley,smaug,hiro,botond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330273\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/webidl/Document.webidl", "layout/base/MobileViewportManager.cpp", "layout/base/PresShell.cpp", "layout/base/PresShell.h", "layout/base/nsPresContext.cpp", "layout/generic/Scroll