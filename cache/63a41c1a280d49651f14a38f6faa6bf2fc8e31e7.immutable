lgorithm/grid-minmax-content-tracks-multiple-items-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-minmax-spanning-items-columns-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-minmax-spanning-items-rows-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-percentage-of-indefinite-auto-track-size-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-percentage-of-indefinite-track-size-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-percentage-tracks-container-margin-border-padding-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-percentage-tracks-container-size-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-percentage-tracks-intrinsic-container-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-relayout-orthogonal-items-same-result-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-spanning-items-orthogonal-flows-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-spanning-items-percentage-grid-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-track-sizing-item-addition-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-track-sizing-item-removal-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-flow-dynamic-change-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-flow-resolution-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-placement-automatic-span-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-placement-definite-span-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-placement-fixed-row-column-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-placement-item-addition-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-placement-item-removal-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-auto-placement-order-change-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-dynamic-change-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-huge-negative-indexes-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-invalid-double-span-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-named-grid-area-resolution-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-named-lines-and-areas-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-negative-integer-explicit-grid-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-negative-position-resolution-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-unknown-named-area-001.html", "testing/web-platform/tests/css/css-grid/placement/grid-placement-unknown-named-grid-line-001.html"], "git_node": "4d0922766cd395c5979e9764d283e4b387c7f455", "git_parents": ["1463c98aeaea35b3a1809e13f3a8cb754057db0d"], "node": "3d0ecd9ee9618ad45d8e4c88a7da12711555d8ea", "parents": ["0ab092f3f19a49606094f344c461a36cec038feb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077011 [wpt PR 63140] - Update wpt metadata, a=testonly\n\nwpt-pr: 63140\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/alignment/grid-item-stretch-dynamic-size-margin-change-001.html.ini", "testing/web-platform/meta/css/css-grid/layout-algorithm/grid-spanning-items-orthogonal-flows-001.html.ini"], "git_node": "7a6410c53b6c89058869468689f67d208bc27cdc", "git_parents": ["4d0922766cd395c5979e9764d283e4b387c7f455"], "node": "d6325c29c57c2100276d8612ec0a1081d2c0c970", "parents": ["3d0ecd9ee9618ad45d8e4c88a7da12711555d8ea"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078172 [wpt PR 63268] - Cleanup 2 Ahem tests, a=testonly\n\nAutomatic update from web-platform-tests\nCleanup 2 Ahem tests\n\nThis patch cleans up 2 Ahem tests to fix typos so that Ahem is used, and\nto wait for fonts to be ready so that they are not flaky.\n\nBug: 568337130\nChange-Id: I5698120325896c77564a95e6f5f28a4a82d5e79e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508968\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711325}\n\n--\n\nwpt-commits: 3403aad555d12838ff3edfda3d843877c4a1886c\nwpt-pr: 63268\n", "files": ["testing/web-platform/tests/css/css-text/white-space/trailing-space-before-br-001.html", "testing/web-platform/tests/css/css-writing-modes/forms/text-input-baseline.html"], "git_node": "6fa964f532ee8cc420ca59a913932402784b366e", "git_parents": ["7a6410c53b6c89058869468689f67d208bc27cdc"], "node": "1ab0c01ee7f1d7000ef8a49c6b98246d13b33a3c", "parents": ["d6325c29c57c2100276d8612ec0a1081d2c0c970"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079149 - [wpt-sync] Update web-platform-tests to 3403aad555d12838ff3edfda3d843877c4a1886c, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 3403aad555d12838ff3edfda3d843877c4a1886c\nwpt-type: landing\n", "files": ["testing/web-platform/meta/css/css-grid/grid-items/grid-item-min-size-auto-overflow-002.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/backdrop-filter-mask-image-while-loading.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-063.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-with-ruby-001.html.ini", "testing/web-platform/meta/domparsing/tentative/positional-methods-with-trusted-types.html.ini", "testing/web-platform/meta/editing/other/editing-div-outside-body.html.ini", "testing/web-platform/meta/fullscreen/api/fullscreen-change-event-shape.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-properties.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-defaults.window.js.ini", "testing/web-platform/meta/html/dom/render-blocking/parser-inserted-stylesheet-link.html.ini", "testing/web-platform/meta/html/dom/render-blocking/remove-attr-style-keeps-blocking.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-poster-when-visible.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini", "testing/web-platform/meta/html/user-activation/activation-trigger-touch.tentative.html.ini", "testing/web-platform/meta/intersection-observer/scroll-and-root-margin.html.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-horizontal.html.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-nested.html.ini", "testing/web-platform/meta/layout-instability/sources-pseudo-element.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/navigation-api/precommit-handler/precommitHandler-redirect-non-api-navigation.html.ini", "testing/web-platform/meta/pointerevents/touch-action-with-swipe-dir-change.html.ini", "testing/web-platform/meta/referrer-policy/gen/top.meta/strict-origin-when-cross-origin/script-tag-dynamic-import.http.html.ini", "testing/web-platform/meta/service-workers/service-worker/controller-on-reload.https.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-beyond-cookies.none.sub.https.window.js.ini", "testing/web-platform/meta/url/IdnaTestV2.any.js.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webdriver/tests/classic/interface/__dir__.ini"], "git_node": "39108081b343080499f95aadb36d4966b3f3a3af", "git_parents": ["6fa964f532ee8cc420ca59a913932402784b366e"], "node": "87b2cb1c489bcc2363013adf3bcfe48e1ada0e79", "parents": ["1ab0c01ee7f1d7000ef8a49c6b98246d13b33a3c"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079185 - Drop -TP from header entries in the compilation database. r=firefox-build-system-reviewers,ahochheiden\n\nHeader entries are only produced by the static-analysis backend, which\nadds -xc++ to tell clang to treat the .h file as C++. On Windows, the\ncompiler is clang-cl and CXXFLAGS already contains -TP, its own flag for\n\"treat all inputs as C++\". With both flags present, clang reports -TP as\nan unused argument for every header, so drop -TP from these entries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331556\n", "files": ["python/mozbuild/mozbuild/compilation/database.py"], "git_node": "a3fbdbfaf620c73d5bfabc1a377f27a013f172d5", "git_parents": ["39108081b343080499f95aadb36d4966b3f3a3af"], "node": "6ee46a38de80fa0edd6904b461487c6c006babfd", "parents": ["87b2cb1c489bcc2363013adf3bcfe48e1ada0e79"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079185 - Emit compilation database entries as argument lists. r=firefox-build-system-reviewers,ahochheiden\n\nShell-quoting the command breaks on Windows, where quoted string-valued defines end up being parsed as file names.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331557\n", "files": ["python/mozbuild/mozbuild/backend/clangd.py", "python/mozbuild/mozbuild/compilation/database.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/database-defines/foo.c", "python/mozbuild/mozbuild/test/backend/data/database-defines/moz.build", "python/mozbuild/mozbuild/test/backend/test_database.py"], "git_node": "2093f63fb0fdf7fa44ca94bbe698b53783c7072c", "git_parents": ["a3fbdbfaf620c73d5bfabc1a377f27a013f172d5"], "node": "be411dbb42600a024285d8150befc3120bcc7a61", "parents": ["6ee46a38de80fa0edd6904b461487c6c006babfd"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028531: Test GeolocationService::MoveLocators back-pointer update. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329781\n", "files": ["dom/geolocation/test/browser/browser.toml", "dom/geolocation/test/browser/browser_geolocation_move_locators.js"], "git_node": "eb41b54b502ad58c3edbb6ff75643cb644a14f79", "git_parents": ["2093f63fb0fdf7fa44ca94bbe698b53783c7072c"], "node": "62e5e79c66e5a7904d600a590b544fa42b81d618", "parents": ["be411dbb42600a024285d8150befc3120bcc7a61"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 4 - Bump ModuleLoadInfo version number r=win-reviewers,yjuglaret\n\nModuleLoadInfo in mozilla-central is binary incompatible with ModuleLoadInfo\nin beta, so bump the version number.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331856\n", "files": ["toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h"], "git_node": "597c9b1050ad149fab401543726ff8d1783b6e9f", "git_parents": ["eb41b54b502ad58c3edbb6ff75643cb644a14f79"], "node": "27b8b80e456c1cf7f0a37b77e16b117d0311b409", "parents": ["62e5e79c66e5a7904d600a590b544fa42b81d618"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072341 - Part 1: Extend the range to delete for a double-click selection when computing the ranges to delete r=masayuki\n\nThe white-space next to a double-clicked word was deleted by\nDeleteRangeTransaction, after `beforeinput` had been dispatched, so its target\nranges missed the white-space and the caret ended up before preceding\npunctuation. Extend the range in AutoClonedSelectionRangeArray where the\nranges to delete are computed instead. The rule follows WebKit: prefer the\npreceding white-space, otherwise take the following one, and do nothing if the\nselection already touches white-space.\n\nIf a `beforeinput` listener changes the selection, it is no longer treated as\ncreated by double-click.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328151\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/AutoClonedRangeArray.h", "editor/libeditor/DeleteRangeTransaction.cpp", "editor/libeditor/DeleteRangeTransaction.h", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditorDeleteHandler.cpp", "editor/libeditor/TextEditSubActionHandler.cpp", "testing/web-platform/mozilla/tests/editor/delete-space-after-double-click-selection.html"], "git_node": "6cb22fec8a1e4f840b7268184805af42dd543668", "git_parents": ["597c9b1050ad149fab401543726ff8d1783b6e9f"], "node": "6203e122461b6f2cf3ccbc01cc17b51113f4ba24", "parents": ["27b8b80e456c1cf7f0a37b77e16b117d0311b409"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072341 - Part 2: Use WSRunScanner to find the white-space to delete with a double-click selection r=masayuki\n\nThe adjacent character may be in another text node or inline element, and\ncollapsible white-space may span several characters. Scan with WSRunScanner\nand delete the whole collapsed run; preformatted content still loses exactly\none character.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328152\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/AutoClonedRangeArray.h", "testing/web-platform/mozilla/meta/editor/delete-space-after-double-click-selection.html.ini", "testing/web-platform/mozilla/tests/editor/delete-space-after-double-click-selection.html"], "git_node": "4639decaf6a8833cf8e56913fd9167b0a8478894", "git_parents": ["6cb22fec8a1e4f840b7268184805af42dd543668"], "node": "efb306a29fde4d2cd606c2652134bcb4657e4200", "parents": ["6203e122461b6f2cf3ccbc01cc17b51113f4ba24"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072341 - Part 3: Treat a form feed as white-space when deleting a double-click selection r=masayuki\n\nWebKit's smart delete considers the Infra ASCII whitespace set plus U+00A0,\nso a form feed next to the word is deleted like a space while other Unicode\nspaces such as U+2003 are not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328153\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/HTMLEditUtils.h", "testing/web-platform/mozilla/tests/editor/delete-space-after-double-click-selection.html"], "git_node": "8cf6d3e8b3a517e8db44cf8336eb0224ed6232c7", "git_parents": ["4639decaf6a8833cf8e56913fd9167b0a8478894"], "node": "33d4f4328a467e572c3ae32c3bd838cb8869922e", "parents": ["efb306a29fde4d2cd606c2652134bcb4657e4200"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072341 - Part 4: Delete the adjacent white-space when cutting a double-click selection r=masayuki\n\nWebKit applies smart delete to Cut as well as to Backspace and Delete.\nRecord whether the selection was created by double-click in CutAsAction()\ntoo, before `beforeinput` is dispatched, so that the target ranges of\n`deleteByCut` and the deletion include the white-space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328154\n", "files": ["editor/libeditor/EditorBase.cpp", "testing/web-platform/mozilla/tests/editor/delete-space-after-double-click-selection.html"], "git_node": "1b706009fad9afea657684e8aead0bb6e078b694", "git_parents": ["8cf6d3e8b3a517e8db44cf8336eb0224ed6232c7"], "node": "b7c449f171c2e2d99f039218cff63880294e2f54", "parents": ["33d4f4328a467e572c3ae32c3bd838cb8869922e"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054644 - Add a cross-origin alt-data regression test r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329209\n", "files": ["netwerk/test/browser/alt_data_cross_origin.sjs", "netwerk/test/browser/browser.toml", "netwerk/test/browser/browser_alt_data_cross_origin.js"], "git_node": "cc55489c3aaf72fe4e2b4ea4326bf5d4a5886d52", "git_parents": ["1b706009fad9afea657684e8aead0bb6e078b694"], "node": "55b955b01ca3990dfa817c5c0c28ff03155c53d4", "parents": ["b7c449f171c2e2d99f039218cff63880294e2f54"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078742 - Also wait for background unmarking task when handling alloc failure r=spidermonkey-reviewers,iain\n\nWe need to wait for the background unmark task, which iterates through the\nchunk lists, before we call GCRuntime::releaseRelocatedArenasWithoutUnlocking\nwhich can mutate the chunk lists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331670\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug-2078742.js"], "git_node": "90f73766bb216d92c436e7bdb971235017bb45c4", "git_parents": ["cc55489c3aaf72fe4e2b4ea4326bf5d4a5886d52"], "node": "3a26ee747fbbeca99842a6489e361c167646264b", "parents": ["55b955b01ca3990dfa817c5c0c28ff03155c53d4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in browser/base/content/test/browser-captivePortal, r=firefox-desktop-core-reviewers ,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331128\n", "files": ["browser/base/content/test/browser-captivePortal/head.js"], "git_node": "377cfbc66be823525948306d9d5e74905338a688", "git_parents": ["90f73766bb216d92c436e7bdb971235017bb45c4"], "node": "1428c82930aa95a669717d87b0b3406e7b2320c3", "parents": ["3a26ee747fbbeca99842a6489e361c167646264b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up the automatic-download permission left by the download spam tests, r=firefox-desktop-core-reviewers ,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331129\n", "files": ["browser/components/downloads/test/browser/browser_download_spam_protection.js", "uriloader/exthandler/tests/mochitest/browser_download_spam_permissions.js"], "git_node": "a5b9da9b5093f35194270527c8c6fcb8200880d0", "git_parents": ["377cfbc66be823525948306d9d5e74905338a688"], "node": "015b9454db8a5475b4431fa434da4c2cf637e485", "parents": ["1428c82930aa95a669717d87b0b3406e7b2320c3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in browser/components/preferences, r=settings-reviewers,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331133\n", "files": ["browser/components/preferences/tests/permissions/browser_ignore_invalid_capability.js", "browser/components/preferences/tests/siteData/head.js"], "git_node": "d3831979aacf1ab576e9751f93db8fc5a2dc1dbf", "git_parents": ["a5b9da9b5093f35194270527c8c6fcb8200880d0"], "node": "16ca829a8f44a840035e3c20336b4513985e4d07", "parents": ["015b9454db8a5475b4431fa434da4c2cf637e485"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in browser/components/originattributes, r=firefox-desktop-core-reviewers ,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331134\n", "files": ["browser/components/originattributes/test/browser/browser_permissions.js"], "git_node": "338c6b865270c7b11bdf20165dd9149b0f170414", "git_parents": ["d3831979aacf1ab576e9751f93db8fc5a2dc1dbf"], "node": "d22e8d2d64bced27b00b421d6ff9652fde7247b7", "parents": ["16ca829a8f44a840035e3c20336b4513985e4d07"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by the controlCenter screenshot test, r=firefox-desktop-core-reviewers ,Gijs.\n\nThe ControlCenter configurations of mozscreenshots set every site permission for test1.example.com, and add a tracking protection exception for tracking.example.org.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331225\n", "files": ["browser/tools/mozscreenshots/controlCenter/browser_controlCenter.js"], "git_node": "97b1d8e2e2c4250386156b6a1726b494f75c9f28", "git_parents": ["338c6b865270c7b11bdf20165dd9149b0f170414"], "node": "b2a8ac5647e06ac951e729535d967b075a0acd61", "parents": ["d22e8d2d64bced27b00b421d6ff9652fde7247b7"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710592 - Generate bugbug-push-schedules.json artifact on backstop pushes too. r=taskgraph-reviewers,bhearsum DONTBUILD\n\nOn autoland, start querying bugbug in a background thread at the beginning of the\ndecision task, and store its results at the end if they are ready, without\nwaiting for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328437\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_util_bugbug.py", "taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "ea040f228e2c66958f33c40d777a8dc993903003", "git_parents": ["97b1d8e2e2c4250386156b6a1726b494f75c9f28"], "node": "168de4a0cced2e96b313791670b00c761dc1bde0", "parents": ["b2a8ac5647e06ac951e729535d967b075a0acd61"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2079537 - re-enable test_cert_expiration_canary.js. r=keeler DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331855\n", "files": ["security/manager/ssl/tests/unit/xpcshell.toml"], "git_node": "df26c9d74315689e24c738a7b8f0543642f0881f", "git_parents": ["ea040f228e2c66958f33c40d777a8dc993903003"], "node": "75d13072413a9c1ea3ef4d31104026882ac3dc9a", "parents": ["168de4a0cced2e96b313791670b00c761dc1bde0"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078649. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331537\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h", "dom/canvas/DrawTargetWebglInternal.h", "gfx/2d/RecordedEvent.h", "gfx/2d/RecordedEventImpl.h", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/CanvasTranslator.h"], "git_node": "b5a7d53b596825c7ceeb35307d205ce8c8867341", "git_parents": ["df26c9d74315689e24c738a7b8f0543642f0881f"], "node": "df37d9798bddffd1009cdb5eccf9407c2c061d37", "parents": ["75d13072413a9c1ea3ef4d31104026882ac3dc9a"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074898 - Ensure bottom chrome dividers are shown on top of the top most bar r=android-reviewers,calu\n\nUntil recently the single navigation bar or bottom toolbar were known to be the\ntop most bars shown at the bottom of the screens so they were hardcoded to show\na top divider.\nNow it is possible for the tab strip or tab groups strip to be shown on top of\nthem so their divider should not be shown in favor of a new one supported by the\nnew strips.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330793\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserDisplayToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserEditToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/NavigationBar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/concept/BrowserToolbarTestTags.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/FullDisplayToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserDisplayToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserEditToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/NavigationBarTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/TabPreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/TopDividerColumn.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/TopDividerColumnTest.kt"], "git_node": "39f70188c9ed4031472d8b0d69f5ac0dc90f8567", "git_parents": ["b5a7d53b596825c7ceeb35307d205ce8c8867341"], "node": "e1eab6b814aebb9a23179a0dff49187c9d3c0ed6", "parents": ["df37d9798bddffd1009cdb5eccf9407c2c061d37"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079182 - [devtools] Only show the slow script debug button if devtools are open r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331807\n", "files": ["browser/modules/ProcessHangMonitor.sys.mjs", "devtools/client/debugger/test/mochitest/browser_dbg-slow-script.js"], "git_node": "eeb305e0a237006f97511b4ad0c694be9d7fcd52", "git_parents": ["39f70188c9ed4031472d8b0d69f5ac0dc90f8567"], "node": "1a376c114e9ae113bba0f751e31d8fd7b95b4854", "parents": ["e1eab6b814aebb9a23179a0dff49187c9d3c0ed6"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Use isDefaultBrowserAsync() in DefaultBrowserCheck; r=firefox-desktop-core-reviewers ,dao\n\nUse the asynchronous default-browser check when determining whether the\ndefault-browser prompt should be shown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330097\n", "files": ["browser/components/DefaultBrowserCheck.sys.mjs"], "git_node": "3999ec8288a7ba7efb7730245bb952727d6df600", "git_parents": ["eeb305e0a237006f97511b4ad0c694be9d7fcd52"], "node": "79b04649eec4589d080f934d6c2c5e9a87ef3b97", "parents": ["1a376c114e9ae113bba0f751e31d8fd7b95b4854"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079182 - [devtools] Only show the slow script debug button if devtools are open r=devtools-reviewers,bomsy\" for causing mochitests failures in browser_ProcessHangNotifications.js.\n\nThis reverts commit eeb305e0a237006f97511b4ad0c694be9d7fcd52.\n", "files": ["browser/modules/ProcessHangMonitor.sys.mjs", "devtools/client/debugger/test/mochitest/browser_dbg-slow-script.js"], "git_node": "fb64f45409145102ee583c5d53def6993520c468", "git_parents": ["3999ec8288a7ba7efb7730245bb952727d6df600"], "node": "86eec4888196af6c769d5445952efd73a2ad14e4", "parents": ["79b04649eec4589d080f934d6c2c5e9a87ef3b97"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077198 - Another fix for toolchain build bustages\n", "files": ["taskcluster/kinds/toolchain/embedded-uniffi-bindgen.yml", "taskcluster/kinds/toolchain/mozcheck.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml"], "git_node": "584f7df533651f855a59591ba788f252cbe036d3", "git_parents": ["fb64f45409145102ee583c5d53def6993520c468"], "node": "9a969e6cf1197e22e1acf63cf03793c185a20894", "parents": ["86eec4888196af6c769d5445952efd73a2ad14e4"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079149 - Fix for failures in fullscreen-change-event-shape.html\n", "files": ["testing/web-platform/meta/fullscreen/api/fullscreen-change-event-shape.html.ini"], "git_node": "0095c7b8018121ae72ee8a96570876e984517c58", "git_parents": ["584f7df533651f855a59591ba788f252cbe036d3"], "node": "28c6cc948741b2e141a26998ae994c45f73dfd16", "parents": ["9a969e6cf1197e22e1acf63cf03793c185a20894"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981768 - Log HSTS and HTTPS RR connection upgrades to the web console. r=valentin,necko-reviewers,devtools-reviewers,jdescottes\n\nHTTPS-Only, HTTPS-First, CSP upgrade-insecure-requests and Mixed Content\nauto-upgrade all log a console message when they upgrade an HTTP\nrequest. Add the same for HSTS and HTTPS RR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330600\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_filters.js", "dom/locales/en-US/chrome/security/security.properties", "dom/security/test/https-only/browser.toml", "dom/security/test/https-only/browser_hsts_host.js", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/test/browser/browser_mock_https_rr.js"], "git_node": "4aca506e89083cd6bc14345cb60312762ee45909", "git_parents": ["0095c7b8018121ae72ee8a96570876e984517c58"], "node": "52b319859ca83cd8f7a0dd4918a0fe14cdfd452e", "parents": ["28c6cc948741b2e141a26998ae994c45f73dfd16"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063878. Point modules/xz-embedded's moz.yaml at its owning component. r=application-update-reviewers,firefox-build-system-reviewers,sylvestre DONTBUILD\n\nBug 1982512 moved this directory's BUG_COMPONENT in moz.build to Toolkit :: Application\nUpdate, and moz.yaml still names GeckoView :: General. Updatebot files its update bugs\nfrom the moz.yaml block rather than moz.build, so update bugs for xz-embedded still go to\nGeckoView.\n\nUse the same product and component moz.build does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318925\n", "files": ["modules/xz-embedded/moz.yaml"], "git_node": "94421735322b094a220692fc878bbccf2bbe8e44", "git_parents": ["4aca506e89083cd6bc14345cb60312762ee45909"], "node": "43edde44379e0ac4c757a5ec0fc1916162d1282b", "parents": ["52b319859ca83cd8f7a0dd4918a0fe14cdfd452e"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079324 - Compute the priority of a delayed web task when its timeout fires. r=smaug\n\nDelayedWebTaskHandler took the priority to dispatch at but never stored it,\nso a delayed postTask queued its runnable at whatever priority mPriority\nhappened to hold.\n\nPer the spec, enqueueSteps run after the delay, so compute the priority from\nthe task's current priority source at that point instead of passing it in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331696\n", "files": ["dom/webscheduling/WebTaskScheduler.cpp", "dom/webscheduling/WebTaskScheduler.h", "dom/webscheduling/WebTaskSchedulerMainThread.cpp", "dom/webscheduling/WebTaskSchedulerMainThread.h", "dom/webscheduling/WebTaskSchedulerWorker.cpp", "dom/webscheduling/WebTaskSchedulerWorker.h"], "git_node": "adb5637b77378f7ae38a8c123988a08a40a8d359", "git_parents": ["94421735322b094a220692fc878bbccf2bbe8e44"], "node": "1f6f990d68ccf444bd1691f4547232c21d6bd8f4", "parents": ["43edde44379e0ac4c757a5ec0fc1916162d1282b"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074902 - [devtools] Preserve quote used in original source when pretty printing r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331922\n", "files": ["devtools/client/debugger/dist/pretty-print-worker.js", "devtools/client/debugger/src/workers/pretty-print/pretty-fast.js", "devtools/client/debugger/src/workers/pretty-print/tests/__snapshots__/prettyFast.spec.js.snap", "devtools/client/debugger/src/workers/pretty-print/tests/prettyFast.spec.js"], "git_node": "229c544b3e13c74d39381ef6c85045cc32769a9f", "git_parents": ["adb5637b77378f7ae38a8c123988a08a40a8d359"], "node": "1f7fe057c46d38effff2b367c982427c5a87924f", "parents": ["1f6f990d68ccf444bd1691f4547232c21d6bd8f4"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079649 - [devtools] Force user-select:none on devtools-checkbox-label (netmonitor, a11y panel) r=devtools-reviewers,nchevobbe\n\ndevtools-checkbox-label is used in 3 UIs across 2 panels:\n- request blocking panel in netmonitor\n- disable cache checkbox in netmonitor toolbar\n- show tabbing order checkbox in a11y panel\n\nOnly the request blocking checkbox was properly setting user-select none. Add a rule to common.css to allow other UIs to benefit from this as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331946\n", "files": ["devtools/client/netmonitor/src/assets/styles/RequestBlockingPanel.css", "devtools/client/themes/common.css"], "git_node": "6f22ee5b369672f5eb61f397bb8bae3df0de7236", "git_parents": ["229c544b3e13c74d39381ef6c85045cc32769a9f"], "node": "8c7e268ee223fbcca6db1ed7674a52bc7cc0ea7a", "parents": ["1f7fe057c46d38effff2b367c982427c5a87924f"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076834 - Use asynchronous module load for the revamped switcher in the legacy bookmarks panel. r=sidebar-reviewers,nsharpley\n\nAccessibility creates the wrong kind of accessible for the bookmarks tree before its custom-element initialization finishes. Loading switcher module asynchronously prevents that initialization race.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330158\n", "files": ["browser/components/places/content/bookmarksSidebar.js", "browser/components/places/content/bookmarksSidebar.xhtml", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js"], "git_node": "e182eaf56725ea8a02d725d175431456e0a95e1d", "git_parents": ["6f22ee5b369672f5eb61f397bb8bae3df0de7236"], "node": "8752d21ad0dce356d83a0223f45eed001fb01133", "parents": ["8c7e268ee223fbcca6db1ed7674a52bc7cc0ea7a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078989. r=lsalzman\n\nSeems we already assume that the recorder is main-thread-only in a few\nother places.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331763\n", "files": ["gfx/2d/DrawTargetRecording.cpp"], "git_node": "cc0cadee476879b37e8f9d4ab31a3cc1290f1b34", "git_parents": ["e182eaf56725ea8a02d725d175431456e0a95e1d"], "node": "76933a810b0581642e89513d79a4d1aa1dc50431", "parents": ["8752d21ad0dce356d83a0223f45eed001fb01133"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078551 - Add Windows GDI printer test coverage. r=webdriver-reviewers,jgraham,jdescottes\n\nAdd a WPT print job that runs the tests with \"Microsoft Print to PDF\",\nwhich uses GDI rather than PDF output.\n\nThis is the only remaining printing codepath that uses cairo, and that\ncurrently goes totally untested. We're considering making big changes to\nthis code (see bug 2036950) and having this coverage helps being more\nconfident on those changes.\n\nThe fuzzy expectations are because this driver re-encodes images to\njpeg.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331108\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/test_configs/variants.yml", "testing/web-platform/meta/css/css-break/block-001-wm-vlr-print.html.ini", "testing/web-platform/meta/css/css-break/block-001-wm-vrl-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-008-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-015-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-019-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-022-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-024-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-025-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-027-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-028-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-029-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-031-print.html.ini", "testing/web-platform/meta/css/css-page/monolithic-overflow-032-print.tentative.html.ini", "testing/web-platform/meta/css/css-page/page-background-002-print.html.ini", "testing/web-platform/meta/css/css-page/page-background-003-print.html.ini", "testing/web-platform/meta/css/css-page/page-name-table-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-landscape-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-square-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-size-015-print.tentative.html.ini", "testing/web-platform/meta/css/css-position/sticky/position-sticky-offset-print.html.ini", "testing/web-platform/meta/css/printing/background-image-print.html.ini", "testing/web-platform/meta/css/printing/table-in-flex-overflow-print.html.ini", "testing/web-platform/meta/css/printing/text-shadow-blur-print.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/responsive-image-select-print.html.ini", "testing/web-platform/mozilla/meta/html/canvas/mozPrintCallback-text-001-print.html.ini", "testing/web-platform/mozilla/meta/html/canvas/mozPrintCallback-text-002-print.html.ini", "testing/web-platform/mozilla/meta/printing/video-001-print.html.ini", "testing/web-platform/mozilla/meta/printing/video-002-print.html.ini", "testing/web-platform/mozilla/meta/printing/video-005-print.html.ini", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": "cd311455c67b60f499dfee575ee28f8007ca06be", "git_parents": ["cc0cadee476879b37e8f9d4ab31a3cc1290f1b34"], "node": "603e62584c0060ad1f55aecb1ff7b643382dbfee", "parents": ["76933a810b0581642e89513d79a4d1aa1dc50431"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078240 - Compute CSD margin eagerly, rather than waiting for the first map. r=stransky,gtk-reviewers\n\nMake sure that our CSD margin is always up-to-date even before map, so\nthat we can compute the right size constraints etc.\n\nTest borrowed and stripped down from the original revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331644\n", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/tests/chrome.toml", "widget/tests/test_window_size_constraints.xhtml", "widget/tests/window_size_constraints.xhtml"], "git_node": "c80b6008b0f54ed03c969129843e098432b2f357", "git_parents": ["cd311455c67b60f499dfee575ee28f8007ca06be"], "node": "bf675e457d84abd1d8613ff08117fe8708762784", "parents": ["603e62584c0060ad1f55aecb1ff7b643382dbfee"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049741 - Sanitize recorded fonts with OTS, r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326963\n", "files": ["gfx/2d/2D.h", "gfx/2d/RecordedEventImpl.h"], "git_node": "7d3a178295e8e59e6b4fff9fd4997e7ea4f123e8", "git_parents": ["c80b6008b0f54ed03c969129843e098432b2f357"], "node": "b2f9f5a7a870e9be3e3cbb6925a466fb16d84895", "parents": ["bf675e457d84abd1d8613ff08117fe8708762784"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071247 - P1. Vendor the autofill EncryptorDecryptor from application-services r=joschmidt,credential-management-reviewers\n\nVendor application-services e57fe2900f, which merges pull request #7573. It\nmoves autofill's credit card encryption onto the db-crypto crate: Store::new()\ntakes an EncryptorDecryptor, and the record API carries the card number in\ncleartext, which the store encrypts and derives the last four digits from. A\nnumber the key cannot read fails the read. It also removes the key-based\nencrypt_string() and decrypt_string(), which nothing can call once no consumer\nholds ciphertext.\n\nThe NSS store constructor is behind the crate's new keydb feature, which the\nuniffi-bindgen-gecko-js components crate turns on as it already does for\ndb-crypto. Both store constructors are declared AsyncWrapped, since each does\nthe same database work as Store's own constructor, and the two new key manager\nhelpers Sync, alongside create_autofill_key().\n\nThe revision also carries the upstream changes since 7585e03e2: an ads-client\nrefactor, sync_manager moving from UDL to UniFFI macros, a logins fix to not\ncreate a key while the NSS token is locked (bug 2067678), and an fxa-client\nauth URL fix (bug 2074136).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331484\n", "files": ["Cargo.lock", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_bridged_engine.js", "docs/rust-components/api/js/autofill.md", "third_party/application-services/components/ads-client/integration-tests/tests/http_cache.rs", "third_party/application-services/components/ads-client/integration-tests/tests/mars.rs", "third_party/application-services/components/ads-client/src/ads.rs", "third_party/application-services/components/ads-client/src/ads_store.rs", "third_party/application-services/components/ads-client/src/ads_store/builder.rs", "third_party/application-services/components/ads-client/src/ads_store/connection_initializer.rs", "third_party/application-services/components/ads-client/src/ads_store/store.rs", "third_party/application-services/components/ads-client/src/bytesize.rs", "third_party/application-services/components/ads-client/src/client.rs", "third_party/application-services/components/ads-client/src/clock.rs", "third_party/application-services/components/ads-client/src/common.rs", "third_party/application-services/components/ads-client/src/common/bytesize.rs", "third_party/application-services/components/ads-client/src/common/clock.rs", "third_party/application-services/components/ads-client/src/ffi.rs", "third_party/application-services/components/ads-client/src/ffi/telemetry.rs", "third_party/application-services/components/ads-client/src/http_cache.rs", "third_party/application-services/components/ads-client/src/http_cache/builder.rs", "third_party/application-services/components/ads-client/src/http_cache/cache_control.rs", "third_party/application-services/components/ads-client/src/http_cache/connection_initializer.rs", "third_party/application-services/components/ads-client/src/http_cache/request_hash.rs", "third_party/application-services/components/ads-client/src/http_cache/store.rs", "third_party/application-services/components/ads-client/src/http_cache/strategy.rs", "third_party/application-services/components/ads-client/src/http_cache/ttl.rs", "third_party/application-services/components/ads-client/src/lib.rs", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/ad_request.rs", "third_party/application-services/components/ads-client/src/mars/ad_response.rs", "third_party/application-services/components/ads-client/src/mars/environment.rs", "third_party/application-services/components/ads-client/src/mars/error.rs", "third_party/application-services/components/ads-client/src/mars/transport.rs", "third_party/application-services/components/ads-client/src/request.rs", "third_party/application-services/components/ads-client/src/test_utils.rs", "third_party/application-services/components/autofill/Cargo.toml", "third_party/application-services/components/autofill/android/build.gradle", "third_party/application-services/components/autofill/android/src/test/java/mozilla/appservices/autofill/AutofillTest.kt", "third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/db/credit_cards.rs", "third_party/application-services/components/autofill/src/db/mod.rs", "third_party/application-services/components/autofill/src/db/models/credit_card.rs", "third_party/application-services/components/autofill/src/db/schema.rs", "third_party/application-services/components/autofill/src/db/store.rs", "third_party/application-services/components/autofill/src/encryption.rs", "third_party/application-services/components/autofill/src/error.rs", "third_party/application-services/components/autofill/src/lib.rs", "third_party/application-services/components/autofill/src/sync/address/mod.rs", "third_party/application-services/components/autofill/src/sync/bridge.rs", "third_party/application-services/components/autofill/src/sync/credit_card/incoming.rs", "third_party/application-services/components/autofill/src/sync/credit_card/mod.rs", "third_party/application-services/components/autofill/src/sync/credit_card/outgoing.rs", "third_party/application-services/components/autofill/src/sync/engine.rs", "third_party/application-services/components/fxa-client/src/internal/oauth.rs", "third_party/application-services/components/support/db-crypto/src/encryption.rs", "third_party/application-services/components/support/rc_crypto/nss/src/error.rs", "third_party/application-services/components/support/rc_crypto/nss/src/pk11/sym_key.rs", "third_party/application-services/components/sync_manager/Cargo.toml", "third_party/application-services/components/sync_manager/build.rs", "third_party/application-services/components/sync_manager/src/error.rs", "third_party/application-services/components/sync_manager/src/lib.rs", "third_party/application-services/components/sync_manager/src/manager.rs", "third_party/application-services/components/sync_manager/src/syncmanager.udl", "third_party/application-services/components/sync_manager/src/types.rs", "third_party/application-services/examples/autofill-utils/Cargo.toml", "third_party/application-services/examples/autofill-utils/src/autofill-utils.rs", "third_party/application-services/moz.yaml", "third_party/application-services/testing/sync-test/src/auth.rs", "third_party/application-services/testing/sync-test/src/autofill.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/syncmanager/android/src/main/java/mozilla/appservices/syncmanager/syncmanager.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "7263e6cd37259d501c4e3c803782dfb05e68c88c", "git_parents": ["7d3a178295e8e59e6b4fff9fd4997e7ea4f123e8"], "node": "aef603e1b41d9b3969e8c564a07d94bdc77c3861", "parents": ["b2f9f5a7a870e9be3e3cbb6925a466fb16d84895"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071247 - P2. Hand credit card numbers to the store that encrypts them r=joschmidt,credential-management-reviewers\n\nThe Rust store now holds an EncryptorDecryptor, so it owns the key: it takes\nthe number in the clear, encrypts it itself, and hands it back decrypted. The\nadapter stops encrypting through OSKeyStore and passes the number through.\n\nRecords the adapter hands out still carry a mask built from the last four\ndigits and no ciphertext, so the number goes no further than the caller that\nneeds it: finding duplicates, restoring it before a merge, and exporting it for\na migration each read it from the store by guid. A card the store hands over\nwithout a number -- scrubbed, or saved without one -- has nothing to restore or\nexport, and is refused as a masked number would be. A number the store's key\ncannot read fails the read.\n\nRustAutofillStore opens the store with a key held in NSS's key4.db under its\nown name, distinct from logins'. NSS only asks for the primary password when\nthe profile has one set, and this is not enabled for those profiles: the\nauthenticator here declines rather than prompting, so a store that cannot get\nits key reports that instead of showing a dialog nothing has wired up yet. The\nprompt, and everything that has to coordinate with passwordmgr around it,\nlands in P4.\n\nCards written under OSKeyStore no longer read back. The JSON records they were\ncopied from are still there -- the migration never wipes its source -- but\nnothing re-runs the copy on its own, so recovering them needs the profile put\nback on the JSON store first. No profile is in that position: the pref is off\non every channel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325372\n", "files": ["browser/extensions/formautofill/test/unit/test_rustStoreShutdown.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs", "toolkit/components/formautofill/RustAutofillStore.sys.mjs"], "git_node": "a220e1f5e5afbdc28f3c97f320f1cd116717bb30", "git_parents": ["7263e6cd37259d501c4e3c803782dfb05e68c88c"], "node": "a934ff59f7fdc1ec3e4cded4efb1a03df1b30413", "parents": ["aef603e1b41d9b3969e8c564a07d94bdc77c3861"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071247 - P3. Read credit card numbers through the store that holds them r=joschmidt,credential-management-reviewers\n\nThe Rust store encrypts with a key of its own and hands its records out with no\nciphertext at all, so a number can no longer be read by handing\n`cc-number-encrypted` to OSKeyStore: which store holds a card decides how its\nnumber is read back.\n\nBoth credit card collections grow decryptField(record, field), and the three\nconsumers that decrypted for themselves -- filling a form, the edit dialog and\nthe sidebar -- now name the field they want of the collection they read the\nrecord from. CreditCardRecord.ciphertextField() answers where a JSON record\nkeeps the ciphertext, and the Rust store reads the number by the record's guid,\nso no caller needs to know either. A record holding nothing under that field\nreads back as null, and a caller keeps what it already carries rather than\nwriting the null over it.\n\nWhichever store holds the key is now what reports the read, so the edit dialog\nstops recording creditcard.osKeystoreDecrypt itself and the read is reported once\nrather than twice. A declined prompt reaches the fill path as NS_ERROR_ABORT, so\npromptShownOsReauth records fail_user_canceled where it recorded fail_error.\n\nFormAutofillSection is bundled for iOS, which resolves its lazy module specifiers\nat build time, so reaching the storage from there needs an Overrides.ios.js entry.\niOS never reaches the credit card fill path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325373\n", "files": ["browser/extensions/formautofill/moz.build", "browser/extensions/formautofill/test/browser/rustCreditCard/browser.toml", "browser/extensions/formautofill/test/browser/rustCreditCard/browser_creditCard_migration.js", "browser/extensions/formautofill/test/browser/rustCreditCard/head.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/Overrides.ios.js", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs", "toolkit/components/formautofill/shared/CreditCardRecord.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillSection.sys.mjs", "toolkit/components/satchel/megalist/aggregator/datasources/BankCardDataSource.sys.mjs"], "git_node": "0b9b15c6cfa2306e2818d561c07385d601875ad0", "git_parents": ["a220e1f5e5afbdc28f3c97f320f1cd116717bb30"], "node": "761e23e95635078de97863f7b8ba2e64cb202fcf", "parents": ["a934ff59f7fdc1ec3e4cded4efb1a03df1b30413"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2078189 - [remote] Temporary lock preference \"telemetry.fog.init_on_shutdown\" to false. r=webdriver-reviewers,jdescottes,chutten\n\nLocking the preference will prevent it from being unconditionally\nreset by Glean before the shutdown of Firefox. It needs to stay\nfalse to prevent Glean's initialization code to run during shutdown\nfor short-lived Firefox processes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331145\n",