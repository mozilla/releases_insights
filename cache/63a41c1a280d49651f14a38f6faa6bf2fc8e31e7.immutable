", "git_parents": ["c3ba56c2b64b8c69f1b3e905f42fa5ebde5bec5b"], "node": "4e1820d597eb40c7df578430dd86c2b470f2f7d8", "parents": ["a6bea25b5ee51994ebf4a3325efcbd24596cb49a"], "tags": []}, {"author": "abutkovits \u003cabutkovits@mozilla.com\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3806652efdaccfd958d04803eddd3fdf131cd0cd with FIREFOX_153_5_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "04a8d3d4af2d595e0a566849813a102abd43990a", "git_parents": ["0da7339f0557afd47f23e2e8015fa4dfbaa58495"], "node": "f6e36402d1c56cc342f0c100d2b79e3859bb7c29", "parents": ["4e1820d597eb40c7df578430dd86c2b470f2f7d8"], "tags": []}], "date": 1792038083, "git_changesets": ["0da7339f0557afd47f23e2e8015fa4dfbaa58495", "04a8d3d4af2d595e0a566849813a102abd43990a"], "user": "abutkovits@mozilla.com"}, "45565": {"changesets": [{"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076775 - Fall back to the document's referrer policy for speculation rules prefetch. r=necko-reviewers,sunil\n\nAn empty policy resolved to the browser default instead of the document's policy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333391\n", "files": ["dom/base/SpeculationRulesManager.cpp", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini"], "git_node": "ef8e19a316ec7522c5cdd35b198e95ca9d07ae79", "git_parents": ["976279105b2e78b8666a959eb3f25c9176cefaf8"], "node": "aef916ee60eb7f3156d05ad66690a5deab886f0a", "parents": ["ac62a49e0473827c1b4ca38bf1fc8a6303b50ea1"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2081269 - Fix user activation telemetry to be limited to permission-granted requests r=dom-core-reviewers,edgar\n\nBecause we don't care about denied requests as they do nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333650\n", "files": ["dom/geolocation/Geolocation.cpp", "testing/web-platform/mozilla/tests/geolocation-API/user-activation-glean.https.window.js"], "git_node": "65b19d5b84e4e12118ff91a9e2e0df5499b98aef", "git_parents": ["ef8e19a316ec7522c5cdd35b198e95ca9d07ae79"], "node": "baeabacb75f8fbb099dbe5a2be3427cf9d2b71ab", "parents": ["aef916ee60eb7f3156d05ad66690a5deab886f0a"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068745 - Enable ext-TSP basic block placement for PGO builds r=glandium\n\nWe could also enable it for non-PGO builds, but the pass works\n(theoretically!) better with profile informations, and if this kind of\nfine-tuning is required, we use PGO anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332360\n", "files": ["build/moz.configure/lto-pgo.configure"], "git_node": "1bdca7a784ef982694dc9381894927c8b7132623", "git_parents": ["65b19d5b84e4e12118ff91a9e2e0df5499b98aef"], "node": "81ffeddf5c78cc5cd05ce66558371cbc0027211e", "parents": ["baeabacb75f8fbb099dbe5a2be3427cf9d2b71ab"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081083 - Remove unreferenced Hal sandbox implementation of Alarm API r=gsvelto\n\nAs hinted in https://bugzilla.mozilla.org/show_bug.cgi?id=1350169#c0\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333115\n", "files": ["hal/sandbox/SandboxHal.cpp"], "git_node": "c91204eb434ffc39fbe4499c23303eab7db8c454", "git_parents": ["1bdca7a784ef982694dc9381894927c8b7132623"], "node": "2a673454957f53e67fc6a6555ca6784645359169", "parents": ["81ffeddf5c78cc5cd05ce66558371cbc0027211e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2074346 - Update parakeet.cpp to 623a968b r=media-webspeech-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.c