9981e69e205153", "parents": ["e27cbd8e78872efcffd141eead37baaa37f66afd"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080718: Always remove progress listeners on rejected promise. r=asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333543\n", "files": ["dom/clients/manager/ClientOpenWindowUtils.cpp"], "git_node": "9a039351c8384bd8464d96199642bea0bb3ec589", "git_parents": ["8b7410172538b18ebee1f03009eec5fec854cf43"], "node": "655b9677986fcfdd06650628c4d6188089d6d11b", "parents": ["977b414d29d130d9a177aee1659981e69e205153"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334195\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "5b91d01112737ca968e558b33646c84b693207da", "git_parents": ["9a039351c8384bd8464d96199642bea0bb3ec589"], "node": "ecea1e9325102c55b46233405601c17fc3e4cc5d", "parents": ["655b9677986fcfdd06650628c4d6188089d6d11b"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077206 - Extract \u003csidebar-panel-header\u003e to a single element displayed over sidebar panels r=sidebar-reviewers,desktop-theme-reviewers,credential-management-reviewers,places-reviewers,kcochrane,sfoster,mtigley\n\nPanels no longer need to maintain their own instance of `\u003csidebar-panel-header\u003e`.\n\n`SidebarController` manages the shared header, and updates its `view` property whenever a panel is shown. The header then shares its property with its child switcher. Thus, the switcher no longer needs to maintain event listeners to track the active view.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332629\n", "files": ["browser/base/content/browser-box.inc.xhtml", "browser/base/content/webext-panels.js", "browser/base/content/webext-panels.xhtml", "browser/components/places/content/bookmarksSidebar.js", "browser/components/places/content/bookmarksSidebar.xhtml", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/sidebar-customize.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/sidebar-panel-header.css", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/sidebar-panel-switcher.mjs", "browser/components/sidebar/sidebar-syncedtabs.mjs", "browser/components/sidebar/sidebar.css", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_hide_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_header.js", "browser/themes/shared/places/sidebar.css", "browser/themes/shared/sidebar.css", "toolkit/components/satchel/megalist/content/MegalistAlpha.mjs", "toolkit/components/satchel/megalist/content/megalist.css"], "git_node": "329c12136158a36db5f593ff4efc2bf21ffa634b", "git_parents": ["5b91d01112737ca968e558b33646c84b693207da"], "node": "59f902b3b90dbd012f082a2441d74d0879829dcd", "parents": ["ecea1e9325102c55b46233405601c17fc3e4cc5d"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2006225 - Adjust bookmark sidebar test for browser_documentnavigation.js r=sidebar-reviewers,sfoster\n\nThis bug no longer reproduces when using a shared header/switcher instance, so the workaround actually causes the test to _fail_ now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332902\n", "files": ["browser/base/content/test/browser-general/browser_documentnavigation.js"], "git_node": "e61c1ccd44585636466993be567c95526c94b41f", "git_parents": ["329c12136158a36db5f593ff4efc2bf21ffa634b"], "node": "3da27940512389052d2f300051e8f28a5f8e1e22", "parents": ["59f902b3b90dbd012f082a2441d74d0879829dcd"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076794 - Rewire AI Chatbot to use the shared switcher instance. r=desktop-theme-reviewers,sidebar-reviewers,yjamora,akulyk,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332903\n", "files": ["browser/components/genai/chat.css", "browser/components/genai/chat.html", "browser/components/genai/chat.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/themes/shared/sidebar.css"], "git_node": "60bd4fd510d91f25a7e361bf8057c9a19d2caed4", "git_parents": ["e61c1ccd44585636466993be567c95526c94b41f"], "node": "6554764eda16c79c8e43da877e058814e3a010dc", "parents": ["3da27940512389052d2f300051e8f28a5f8e1e22"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082341 - Fix uniffi enumeration output to specify the symbol the members belong to. r=bdk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333898\n", "files": ["docs/config.yml", "docs/jsdoc.json", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSync15.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/src/templates/js/Enum.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs"], "git_node": "01af69e4c60a6b7b948ee5c3be609003416ad0c8", "git_parents": ["60bd4fd510d91f25a7e361bf8057c9a19d2caed4"], "node": "9d82fd537f53376c0795c44f830b9dce998f3c62", "parents": ["6554764eda16c79c8e43da877e058814e3a010dc"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 668577 - Let users block sites from asking to register protocol handlers. r=Gijs,timhuang,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,akulyk,bolsson\n\nSome sites call navigator.registerProtocolHandler on every page\nload, and the infobar had no way to say no for good. A new\nregister-protocol-handler site permission stores a persistent block from a\n\"Never allow\" button, or a temporary one when the bar is closed. Both the\ngeneric and the mailto infobar respect it, and it can be managed and blocked\nby default from settings.\n\nThe permission is keyed on the origin of the top-level document, also for\nrequests from iframes. The infobar belongs to the tab, so users decide about\nthe page they are on, and one \"Never allow\" covers every frame on that page\nthat keeps asking. Keying on the iframe origin would instead require\nblocking each embedded origin separately.\n\nIframes can still ask, as before. Not prompting for them could break sites\nthat rely on it; a separate patch measures how common such requests are.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331387\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/config/permissions-data.mjs", "browser/components/preferences/dialogs/sitePermissions.js", "browser/components/protocolhandler/WebProtocolHandlerRegistrar.sys.mjs", "browser/locales/en-US/browser/preferences/permissions.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/locales/en-US/browser/webProtocolHandler.ftl", "browser/locales/en-US/chrome/browser/sitePermissions.properties", "browser/modules/SitePermissions.sys.mjs", "browser/themes/shared/notification-icons.css"], "git_node": "4ebdf141fdb8401e5e0017b484a4430fedcdea76", "git_parents": ["01af69e4c60a6b7b948ee5c3be609003416ad0c8"], "node": "a038f30c061f930274ca4ac52f9801c4ac3401e0", "parents": ["9d82fd537f53376c0795c44f830b9dce998f3c62"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 668577 - Test blocking sites from asking to register protocol handlers. r=Gijs,timhuang,settings-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331388\n", "files": ["browser/components/preferences/tests/permissions/browser-srd.toml", "browser/components/preferences/tests/permissions/browser.toml", "browser/components/preferences/tests/permissions/browser_permissions_app_links.js", "browser/components/protocolhandler/test/browser/browser.toml", "browser/components/protocolhandler/test/browser/browser_registerProtocolHandler_notification.js", "browser/components/protocolhandler/test/browser/browser_registerProtocolHandler_permission.js", "browser/components/protocolhandler/test/browser/browser_registerProtocolHandler_relative.html", "browser/components/protocolhandler/test/browser/head.js", "browser/components/tests/browser/browser_default_webprotocol_handler_mailto.js", "browser/modules/test/unit/test_SitePermissions.js"], "git_node": "fcfc2078c97d5803220815eeb9f51b5ccc8aa112", "git_parents": ["4ebdf141fdb8401e5e0017b484a4430fedcdea76"], "node": "90a5959ec902781b5017e5ff4e4de81ae5f265ee", "parents": ["a038f30c061f930274ca4ac52f9801c4ac3401e0"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 668577 - Count registerProtocolHandler calls by frame type and user activation. r=Gijs,timhuang\n\nThe register-protocol-handler permission treats requests from iframes as\nrequests from the top-level site. This measures how many calls come from\niframes, split by whether all their ancestors are same-origin with the\ntop-level document, and whether the caller had user activation. That tells\nus whether we can stop prompting for cross-origin iframes, or without a user\ngesture, without breaking sites.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331389\n", "files": ["browser/components/protocolhandler/test/browser/browser.toml", "browser/components/protocolhandler/test/browser/browser_registerProtocolHandler_frame_telemetry.js", "dom/base/Navigator.cpp", "dom/metrics.yaml"], "git_node": "ad363c237700809e1cdf2ec61f51b66d62818714", "git_parents": ["fcfc2078c97d5803220815eeb9f51b5ccc8aa112"], "node": "d9256b38cafdbdfdebb03cefa1a892962ec26065", "parents": ["90a5959ec902781b5017e5ff4e4de81ae5f265ee"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080952: Update spacing on aitab blocks and minor UX for timeline component r=mlucks\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333851\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-timeline/aitab-timeline.css"], "git_node": "58c01691cfba1cc85de233d8b31f681001be645f", "git_parents": ["ad363c237700809e1cdf2ec61f51b66d62818714"], "node": "d22a4c7d04cf5c7e586bf356daf27f2423592501", "parents": ["d9256b38cafdbdfdebb03cefa1a892962ec26065"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a path data structure to webrender_api. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330855\n", "files": ["gfx/wr/webrender_api/src/lib.rs", "gfx/wr/webrender_api/src/path.rs"], "git_node": "46d168cea747147fd55d431710e41ee636ff5ba6", "git_parents": ["58c01691cfba1cc85de233d8b31f681001be645f"], "node": "c9d59b1e78d521078b6b2e090b6309731e1f2857", "parents": ["d22a4c7d04cf5c7e586bf356daf27f2423592501"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a bezier module. r=gfx-reviewers,gw\n\nIt contains only curve flattening implementations for cubic and quadratic b\u00e9zier curves for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330856\n", "files": ["gfx/wr/webrender/src/bezier.rs", "gfx/wr/webrender/src/lib.rs"], "git_node": "05f2613ccb48e4c9c36507010012470467ddc2bd", "git_parents": ["46d168cea747147fd55d431710e41ee636ff5ba6"], "node": "93cf1f719b05059e7fd1c7bcdb373fd64517a9ec", "parents": ["c9d59b1e78d521078b6b2e090b6309731e1f2857"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Intern paths in the display list builder. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330858\n", "files": ["gfx/webrender_bindings/webrender_ffi.h", "gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender_api/src/interning.rs"], "git_node": "d20727a123a497a6f451b6a21b4d6077aa9a901a", "git_parents": ["05f2613ccb48e4c9c36507010012470467ddc2bd"], "node": "9cd02d6f14a93083be99e6bee5b3e95377e146b8", "parents": ["93cf1f719b05059e7fd1c7bcdb373fd64517a9ec"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078306 - Path clip item plumbing. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330859\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/quad_clip.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "c17fc3da84588d568bd6dd9333006f69cc7f73d7", "git_parents": ["d20727a123a497a6f451b6a21b4d6077aa9a901a"], "node": "58bd592ce7765f46f3ee121df51a2c514caf6942", "parents": ["9cd02d6f14a93083be99e6bee5b3e95377e146b8"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Move polygon_contains_point from clip.rs to hit_test.rs. r=gfx-reviewers,gw\n\nclip.rs is a pretty large file and polygon.rs is the only place where it is used. Also move the related tests that were in util.rs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330860\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/util.rs"], "git_node": "c693d7de60a1751232695c97a03fdcc26eae5016", "git_parents": ["c17fc3da84588d568bd6dd9333006f69cc7f73d7"], "node": "400a700d5717a39f0b1ef5dc3d23e711504fc226", "parents": ["58bd592ce7765f46f3ee121df51a2c514caf6942"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Integrate paths with hit testing. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330861\n", "files": ["gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/scene_building.rs"], "git_node": "77942bf5af9517c43d54dbe60b2eafeef640f27f", "git_parents": ["c693d7de60a1751232695c97a03fdcc26eae5016"], "node": "c19a920d971dab0b27fb7e96cb7a4d449c0f5c1d", "parents": ["400a700d5717a39f0b1ef5dc3d23e711504fc226"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a sparse tiling path rasterizer. r=gfx-reviewers,gw\n\nPort of the tiling path renderer from https://codeberg.org/nical/misc/src/branch/main/path_renderer/renderers/tiling without occlusion culling, opaque batches and the point buffer. Curves are flattened with the bezier module, and segments are clipped to the region that affects the target before binning so that huge coordinates cannot cause the binning to walk across millions of tiles.\n\nThis is not used yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330862\n", "files": ["gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/path_tiler.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "f4de15fe2259abf9390d2e6152c43949773fd3ac", "git_parents": ["77942bf5af9517c43d54dbe60b2eafeef640f27f"], "node": "2f2282f22bf88b2001de73dd1d8c5940a52f450c", "parents": ["c19a920d971dab0b27fb7e96cb7a4d449c0f5c1d"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add a frame-wide path edge buffer. r=gfx-reviewers,gw\n\nPath tile edges are stored in a dedicated RGBA8 texture, one edge per texel, so that the fragment shader gets them unpacked by the texture unit. It is shared by all of the paths of the frame and is empty until path clips are rasterized.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330863\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/render_task_graph.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs"], "git_node": "661f889e507457c95d37cb3253d2346fe31372b3", "git_parents": ["f4de15fe2259abf9390d2e6152c43949773fd3ac"], "node": "fdc0e6b0ab87ab046ff8cfa623772d78988d4e62", "parents": ["2f2282f22bf88b2001de73dd1d8c5940a52f450c"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add the cs_path_tile shader. r=gfx-reviewers,gw\n\nPort of the tiling path renderer's shader, with area coverage anti-aliasing only. The tile rasterization code lives in path_tile.glsl so that it can later be included by other shaders.\n\nPath tiles are drawn at the end of the clip masks, with the premultiplied dest-out blend mode in color targets. In alpha targets they use the multiply blend mode instead, because SWGL's R8 targets have no fragment alpha to blend with. No path tiles are produced yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330866\n", "files": ["gfx/wr/webrender/res/cs_path_tile.glsl", "gfx/wr/webrender/res/path_tile.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender/src/renderer/vertex.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "aec6250961b0637de3dbe250afcf80f5d5ecd781", "git_parents": ["661f889e507457c95d37cb3253d2346fe31372b3"], "node": "899478b1c4ca9a9e97a47e64a72f296c51df6b72", "parents": ["fdc0e6b0ab87ab046ff8cfa623772d78988d4e62"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Rasterize path clips with the path tiler. r=gfx-reviewers,gw\n\nPath clips on quad render tasks and clip masks push a path clip sub-task. The path is tiled when the task is added to its render target, so that the tiles can be positioned relative to the task and their edges go straight into the frame's edge buffer.\n\nWhen the clip's transform to the raster space can't be computed, the clip falls back to the bounds of the path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330867\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/path_tiler.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs"], "git_node": "76e96edb8862f149b08a8b23bd6657e3a772993b", "git_parents": ["aec6250961b0637de3dbe250afcf80f5d5ecd781"], "node": "59fb78e9ee145d17593fcf6c0c5e1e7d41b5f0a3", "parents": ["899478b1c4ca9a9e97a47e64a72f296c51df6b72"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add path clip reftests. r=gfx-reviewers,gw\n\nWrench yaml clips get a path property with a rect, a fill rule and path data in a subset of the SVG path syntax.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330870\n", "files": ["gfx/wr/wrench/reftests/clip/path-and-rounded-rect-ref.yaml", "gfx/wr/wrench/reftests/clip/path-and-rounded-rect.yaml", "gfx/wr/wrench/reftests/clip/path-conflation-ref.yaml", "gfx/wr/wrench/reftests/clip/path-conflation.yaml", "gfx/wr/wrench/reftests/clip/path-curves-ref.yaml", "gfx/wr/wrench/reftests/clip/path-curves.yaml", "gfx/wr/wrench/reftests/clip/path-fill-rules-ref.yaml", "gfx/wr/wrench/reftests/clip/path-fill-rules.yaml", "gfx/wr/wrench/reftests/clip/path-firefox-logo.png", "gfx/wr/wrench/reftests/clip/path-firefox-logo.svg", "gfx/wr/wrench/reftests/clip/path-firefox-logo.yaml", "gfx/wr/wrench/reftests/clip/path-fractional-rect-ref.yaml", "gfx/wr/wrench/reftests/clip/path-fractional-rect.yaml", "gfx/wr/wrench/reftests/clip/path-large-prim-ref.yaml", "gfx/wr/wrench/reftests/clip/path-large-prim.yaml", "gfx/wr/wrench/reftests/clip/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "525d176375098aace7bef5d105b591f31213e5a7", "git_parents": ["76e96edb8862f149b08a8b23bd6657e3a772993b"], "node": "2b971316ffcaaec29e57f675cfef098c94853f25", "parents": ["59fb78e9ee145d17593fcf6c0c5e1e7d41b5f0a3"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Render clip-path path() and shape() with WebRender path clips. r=layout-reviewers,emilio\n\nInstead of rasterizing a mask image on the CPU, the path is built with SVGPathData and sent to WebRender as a path clip. This is behind the gfx.webrender.paths pref, which is disabled by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330873\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "layout/painting/nsDisplayList.cpp", "layout/svg/SVGUtils.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f1aed8e4987fd41c6fee75818617689c09a46760", "git_parents": ["525d176375098aace7bef5d105b591f31213e5a7"], "node": "97126e10f622353068372abeac704cf0168a8c9e", "parents": ["2b971316ffcaaec29e57f675cfef098c94853f25"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add ssaa4 and ssaa8 anti-aliasing modes to the path tile shader. r=gfx-reviewers,gw\n\nAnalytical anti-aliasing has conflation artifacts where edges overlap, so path\ntiles are rasterized with 8 samples per pixel by default, and 4 on Android.\nThe gfx.webrender.path-aa.samples pref selects the mode. Software WebRender\nonly builds the ssaa4 variant.\n\nThe fuzziness of the wrench path clip reftests is adjusted to the sampled anti-aliasing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330874\n", "files": ["gfx/config/gfxVars.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/wr/webrender/res/path_tile.glsl", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/webrender_build/src/shader_features.rs", "gfx/wr/wrench/reftests/clip/reftest.list", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "565e627c068f1c5a6e9442dc622988a3e2a73986", "git_parents": ["f1aed8e4987fd41c6fee75818617689c09a46760"], "node": "a565e28fa1a0df33a0522949e63b068dca45b765", "parents": ["97126e10f622353068372abeac704cf0168a8c9e"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add the polygon and box-shadow counters to the Interners profiler preset. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331232\n", "files": ["gfx/wr/webrender/src/profiler.rs"], "git_node": "be9b0db3cba906a79c5b8a59cca1568dccb947f8", "git_parents": ["565e627c068f1c5a6e9442dc622988a3e2a73986"], "node": "1d9b407392d2d91d1d207d2c2d1593fbc4084b42", "parents": ["a565e28fa1a0df33a0522949e63b068dca45b765"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074891 - Add Nimbus prefs to control the fire button experiment. r=nimbus-reviewers,firefox-desktop-core-reviewers ,Gijs,beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328922\n", "files": ["browser/app/profile/firefox.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "bc5ec56541718721ce1212d6fe5369e68c51c771", "git_parents": ["be9b0db3cba906a79c5b8a59cca1568dccb947f8"], "node": "ab98ea7eb6163486efb02c27cb7a6a32d23b3ef9", "parents": ["1d9b407392d2d91d1d207d2c2d1593fbc4084b42"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074891 - Add a forgetButtonAreaType targeting attribute. r=omc-reviewers,mviar\n\nThe fire button experiment uses it to exclude users who have the Forget button\nin their toolbar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331824\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "fe58dac847c6a1775760d829db45303f7ed86e01", "git_parents": ["bc5ec56541718721ce1212d6fe5369e68c51c771"], "node": "5467da3f2f74cf4061dbe6aa4c2dee10070128a5", "parents": ["ab98ea7eb6163486efb02c27cb7a6a32d23b3ef9"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074891 - Record forgetButtonAreaType in the Nimbus targeting context. r=nimbus-reviewers,beth\n\nExperimenter only accepts advanced targeting on recorded attributes, and the\nfire button experiment targets on this one to exclude Forget button users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331833\n", "files": ["toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_TargetingContextRecorder.js"], "git_node": "f2c904e5d666e842fff78465899b536fd46cfe40", "git_parents": ["fe58dac847c6a1775760d829db45303f7ed86e01"], "node": "6eac5cb04ef01f9654eea247ccf947dd04af183b", "parents": ["5467da3f2f74cf4061dbe6aa4c2dee10070128a5"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076799 - Use delete wording, a close button and destructive styling in the clear browsing data dialog. r=desktop-theme-reviewers,fluent-reviewers,akulyk,emz,flod\n\nThe fire button opens this dialog to delete data, so its title and confirm\nbutton now say so. Clear on shutdown only saves preferences and keeps its\nexisting wording.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329969\n", "files": ["browser/base/content/sanitizeDialog.js", "browser/base/content/sanitize_v2.xhtml", "browser/base/content/test/browser-sanitize/browser_sanitize-history.js", "browser/base/content/test/browser-sanitize/browser_sanitizeDialog_v2.js", "browser/base/content/test/browser-sanitize/head.js", "browser/locales/en-US/browser/sanitize.ftl", "browser/modules/Sanitizer.sys.mjs", "browser/themes/shared/sanitizeDialog_v2.css"], "git_node": "7e024540900801a5efeb1cda7b35023d9b9a350d", "git_parents": ["f2c904e5d666e842fff78465899b536fd46cfe40"], "node": "a18d772de46ac7ec3c3ecbb652c07596c78927ef", "parents": ["6eac5cb04ef01f9654eea247ccf947dd04af183b"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076799 - Add a fire button to the toolbar that deletes browsing data and opens a fresh window. r=desktop-theme-reviewers,fluent-reviewers,janerik,dao,bolsson\n\nThe fireButton Nimbus feature from bug 2074891 gates the widget and picks\nbetween the panel and direct flows; the Glean events compare the two.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329967\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/test/browser-keyboard/browser_toolbarKeyNav.js", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/metrics.yaml", "browser/components/customizableui/moz.build", "browser/components/customizableui/test/browserFireButton.toml", "browser/components/customizableui/test/browser_fireButton.js", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/toolbarbutton-icons.css", "toolkit/components/glean/metrics_index.py"], "git_node": "0c3b0ab27a91c7ede15dd2a57d7eb294bf6fd29e", "git_parents": ["7e024540900801a5efeb1cda7b35023d9b9a350d"], "node": "568de0502d0110d6f3893e5df307827680ef3b45", "parents": ["a18d772de46ac7ec3c3ecbb652c07596c78927ef"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076799 - Animate the fire button icon on hover. r=desktop-theme-reviewers,kcochrane,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329968\n", "files": ["browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/themes/shared/icons/flame-hover-animation.svg", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/toolbarbutton-icons.css"], "git_node": "d9faae5f5de557ec55ecfbd93189ff73f394c12a", "git_parents": ["0c3b0ab27a91c7ede15dd2a57d7eb294bf6fd29e"], "node": "8c36261b81e4f4b6f6c75fbd4f7947138d6f0306", "parents": ["568de0502d0110d6f3893e5df307827680ef3b45"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072964 - [bidi] Use a shared helper to resolve user context ids in BiDi modules r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333155\n", "files": ["remote/webdriver-bidi/modules/RootBiDiModule.sys.mjs", "remote/webdriver-bidi/modules/root/_configuration.sys.mjs", "remote/webdriver-bidi/modules/root/browser.sys.mjs", "remote/webdriver-bidi/modules/root/browsingContext.sys.mjs", "remote/webdriver-bidi/modules/root/network.sys.mjs", "remote/webdriver-bidi/modules/root/permissions.sys.mjs", "remote/webdriver-bidi/modules/root/script.sys.mjs", "remote/webdriver-bidi/modules/root/session.sys.mjs", "remote/webdriver-bidi/modules/root/storage.sys.mjs"], "git_node": "35f0f3f5a6f8c842fe76aa67f13b1c127c5ba656", "git_parents": ["d9faae5f5de557ec55ecfbd93189ff73f394c12a"], "node": "8e81d108e47678817728fc6c1dbe33593a15e9ce", "parents": ["8c36261b81e4f4b6f6c75fbd4f7947138d6f0306"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072964 - [bidi] Restrict browsing context access to a single container r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333156\n", "files": ["remote/shared/TabManager.sys.mjs", "remote/shared/test/browser/browser_TabManager.js", "remote/shared/webdriver/Session.sys.mjs", "remote/webdriver-bidi/modules/RootBiDiModule.sys.mjs", "remote/webdriver-bidi/modules/root/browsingContext.sys.mjs"], "git_node": "66831c33f409bed3ca96a7e0c0d1cb0d0975a62d", "git_parents": ["35f0f3f5a6f8c842fe76aa67f13b1c127c5ba656"], "node": "686192d822b6a8d83458ad31a63f0a6faee7e96f", "parents": ["8e81d108e47678817728fc6c1dbe33593a15e9ce"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072964 - [wdspec] Add tests for WebDriver BiDi sessions restricted to a single container r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333157\n", "files": ["testing/web-platform/mozilla/meta/webdriver/bidi/browser/set_download_behavior/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browsing_context/activate/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browsing_context/create/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browsing_context/get_tree/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browsing_context/navigate/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browsing_context/reload/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browsing_context/set_viewport/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browsing_context/traverse_hist