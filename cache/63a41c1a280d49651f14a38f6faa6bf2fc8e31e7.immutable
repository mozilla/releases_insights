ediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h", "dom/webidl/HTMLMediaElement.webidl", "layout/generic/nsVideoFrame.cpp", "layout/generic/nsVideoFrame.h", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5TreeBuilderCppSupplement.h", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/__dir__.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-autoplay-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-autoplay-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-disconnected.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-not-rendered.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-source-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-to-eager.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-window-onload.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-load-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-load-preload-auto-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-load-preload-metadata-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/__dir__.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-autoplay-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-autoplay-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-disconnected.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-load-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-not-rendered.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-poster-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-source-poster-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-to-eager.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-window-onload.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-load-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-load-preload-auto-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-load-preload-metadata-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-poster-deferred.html.ini"], "git_node": "1158a9ae68551746ea34ed6a3d13bb7cbcd3a692", "git_parents": ["f2b755ec8374041a4ed732408e7e9ddd780da13c"], "node": "d92e457711a2f8fc2348a08aca1aa91dadbde162", "parents": ["8d8e261bed003ebe715b662a9f402b927fbbe788"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082098 - Align the PlayerExpanded track and time labels, and enforce LTR for media player controls r=android-reviewers,moyin\n\n- We want the track to run to the edge of the component, and have the Thumb (scrub) indicator hang off the edge.\n- In addition, the media player controls should be in LTR: this enforces that LayoutDirection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333930\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlaybackControls.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt"], "git_node": "77a8a08d48b5d1ca5b372b68a6fff020dec19f84", "git_parents": ["1158a9ae68551746ea34ed6a3d13bb7cbcd3a692"], "node": "3a194297c8eb2ebf52d3ca5e3ce89068d3c9ce1b", "parents": ["d92e457711a2f8fc2348a08aca1aa91dadbde162"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081805 - Remove unused locationButtonBadgeDismissed pref - r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333724\n", "files": ["browser/app/profile/firefox.js"], "git_node": "2c1e2bd0c963b6b5332561dd653e6325cb129425", "git_parents": ["77a8a08d48b5d1ca5b372b68a6fff020dec19f84"], "node": "d2e7b5a238777619129eec9f307653de4b545d81", "parents": ["3a194297c8eb2ebf52d3ca5e3ce89068d3c9ce1b"], "tags": []}, {"author": "Davis Zeller-Pies \u003cDavis.pies1@gmail.com\u003e", "branch": "default", "desc": "Bug 2080307 - [Wayland] Apply toplevel opaque region changes immediately. r=gtk-reviewers,stransky,emilio\n\nOn Wayland, gdk_window_set_opaque_region() is cached by GTK and only sent\nto the wl_surface when the GdkWindow repaints. Gecko draws into its own\nsubsurface, so the toplevel rarely repaints and its opaque region lags the\nsubsurface's, sometimes by seconds. While it is stale the compositor skips\ndrawing what's behind that area, which shows up as stale or black blocks on\ntransparent windows.\n\nSet the region on the toplevel wl_surface directly and commit it with\nForceToplevelCommit(), so it applies without repainting the window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332610\n", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "a877dd2f44443bc50edde800395f6b8735de3069", "git_parents": ["2c1e2bd0c963b6b5332561dd653e6325cb129425"], "node": "d1238f5a72283b467415c015cd0c7d7f205d6185", "parents": ["d2e7b5a238777619129eec9f307653de4b545d81"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082352 - Don't reuse a stale descriptor for [Serializable] exposure sets r=webidl,emilio,saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334043\n", "files": ["dom/bindings/Codegen.py"], "git_node": "fcb816fd8010982c3969f883aed91802720ae426", "git_parents": ["a877dd2f44443bc50edde800395f6b8735de3069"], "node": "834235e76b554a8dbb99ad4693cdf63fe4f53210", "parents": ["d1238f5a72283b467415c015cd0c7d7f205d6185"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976159 - Add the QuotaExceededError DOMException derived interface r=edgar,webidl,dom-worker-reviewers,smaug,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325781\n", "files": ["dom/base/DOMException.cpp", "dom/base/QuotaExceededError.cpp", "dom/base/QuotaExceededError.h", "dom/base/StructuredCloneHolder.cpp", "dom/base/StructuredCloneTags.h", "dom/base/moz.build", "dom/ipc/ClonedErrorHolder.cpp", "dom/ipc/ClonedErrorHolder.h", "dom/ipc/tests/JSWindowActor/browser.toml", "dom/ipc/tests/JSWindowActor/browser_sendQuery.js", "dom/serviceworkers/test/test_serviceworker_interfaces.js", "dom/tests/mochitest/crypto/test_getRandomValues.html", "dom/tests/mochitest/general/test_interfaces.js", "dom/tests/mochitest/whatwg/test_structuredCloneAndExposed.html", "dom/webidl/DOMException.webidl", "dom/webidl/QuotaExceededError.webidl", "dom/webidl/moz.build", "dom/workers/test/test_worker_interfaces.js", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/WebCryptoAPI/getRandomValues.any.js.ini", "testing/web-platform/meta/WebIDL/ecmascript-binding/es-exceptions/DOMException-audioworklet.https.html.ini", "testing/web-platform/meta/encrypted-media/clearkey-mp4-setmediakeys-to-multiple-video-elements.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-to-multiple-video-elements.https.html.ini", "testing/web-platform/meta/html/infrastructure/safe-passing-of-structured-data/structuredclone_0.html.ini", "testing/web-platform/meta/media-source/mediasource-appendbuffer-quota-exceeded.html.ini", "testing/web-platform/meta/webidl/idlharness.any.js.ini", "testing/web-platform/meta/webstorage/storage_local_quota_independent_from_session.window.js.ini", "testing/web-platform/meta/webstorage/storage_local_setitem_quotaexceedederr.window.js.ini", "testing/web-platform/meta/webstorage/storage_session_quota_independent_from_local.window.js.ini", "testing/web-platform/meta/webstorage/storage_session_setitem_quotaexceedederr.window.js.ini", "toolkit/actors/TestWindowChild.sys.mjs"], "git_node": "588df137f392430f58c7a368da2b73e309495a4a", "git_parents": ["fcb816fd8010982c3969f883aed91802720ae426"], "node": "84310977d465b5bf832492f1c0640ad69b82249c", "parents": ["834235e76b554a8dbb99ad4693cdf63fe4f53210"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2082225 - [loong64] Part 1: (Drive-by) Handle optional InstanceReg saves in codegen test's expected prologue. r=yury\n\nThis makes codegen tests compatible with non-debug shells.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333958\n", "files": ["js/src/jit-test/lib/codegen-loong64-test.js"], "git_node": "3c5ace3f2f8a45b265514681394d62d529d8f6a4", "git_parents": ["588df137f392430f58c7a368da2b73e309495a4a"], "node": "6b740f96999e75e174056d4a59c8133278b35812", "parents": ["84310977d465b5bf832492f1c0640ad69b82249c"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2082225 - [loong64] Part 2: Move wasm SIMD lanes directly between vectors on Loong64. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333959\n", "files": ["js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane-loong64-ion-codegen.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp"], "git_node": "11aacf4cdeb5b2a1eab7b9f3c3a73c713a4f3eea", "git_parents": ["3c5ace3f2f8a45b265514681394d62d529d8f6a4"], "node": "f3e0f5d059c1af21e7b027bcf2ee5066fc83cd53", "parents": ["6b740f96999e75e174056d4a59c8133278b35812"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2082246 - [arm64][loong64] Extend WASM lane movement to I64x2. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333977\n", "files": ["js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane-arm64-ion-codegen.js", "js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane-loong64-ion-codegen.js", "js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane.js", "js/src/jit/MIR-wasm.cpp", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/loong64/CodeGenerator-loong64.cpp"], "git_node": "523b7ed71dac4af325316ab0e1b90b33602dd9fe", "git_parents": ["11aacf4cdeb5b2a1eab7b9f3c3a73c713a4f3eea"], "node": "6a3ef2d7cb66cdcd9b2e4d6ba53afa95bb110ebe", "parents": ["f3e0f5d059c1af21e7b027bcf2ee5066fc83cd53"], "tags": []}, {"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079560 - Avoid a quadratic slowdown in mbsdiff on long duplicated data. r=yjuglaret,application-update-reviewers\n\nThe macOS universal XUL holds its architecture-independent data twice. When\nthe copy mbsdiff is following is only 1-10 bytes worse than the other one,\nthe scan loop calls search() once per byte of the run, and the 156.x -\u003e 158.0\nXUL diffs took over 5 hours. Taking any exact match of at least 64 KiB ends\nthat crawl; the output only changes where the scan would otherwise get stuck.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332128\n", "files": ["other-licenses/bsdiff/bsdiff.c"], "git_node": "a29bfc522fae14da639101cf15d7ebbd467e260c", "git_parents": ["523b7ed71dac4af325316ab0e1b90b33602dd9fe"], "node": "fae4470be0b95b05b488214a0da6de70aac054cc", "parents": ["6a3ef2d7cb66cdcd9b2e4d6ba53afa95bb110ebe"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076491 - Update New Tab train-hop runtime metrics generation to handle new extra_keys on existing events. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331816\n", "files": ["browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs", "browser/extensions/newtab/mach_commands.py", "browser/extensions/newtab/test/xpcshell/test_NewTabGleanUtils.js", "browser/extensions/newtab/webext-glue/metrics/gen_runtime_metrics.py"], "git_node": "f3db19dec2b1a57b541f1e8857ced4679e8ecfb9", "git_parents": ["a29bfc522fae14da639101cf15d7ebbd467e260c"], "node": "ec36718ddfad33b66c5712b701eaa40096fd2e21", "parents": ["fae4470be0b95b05b488214a0da6de70aac054cc"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076491 - Continue New Tab runtime metric registration past individual failures. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332482\n", "files": ["browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_NewTabGleanUtils.js"], "git_node": "0746d58ae83daa88cd1cef7a20f90285af1af761", "git_parents": ["f3db19dec2b1a57b541f1e8857ced4679e8ecfb9"], "node": "5f64c9442b49c3c534f2031d69586eb963c026b3", "parents": ["ec36718ddfad33b66c5712b701eaa40096fd2e21"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076491 - Add a train-hop CI test for New Tab runtime events recording all extra keys. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332483\n", "files": ["browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_newtab_runtime_metrics.js"], "git_node": "32578170bef0ea9e09dbd647980c18cef400fc1e", "git_parents": ["0746d58ae83daa88cd1cef7a20f90285af1af761"], "node": "58f109ff922134fc44b7d0eeb479240a62d576e1", "parents": ["5f64c9442b49c3c534f2031d69586eb963c026b3"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2074192 - Remove old web_accessible_workers.deprecated_behavior pref r=rpl,necko-reviewers,dom-worker-reviewers,asuth\n\nWhile making a change to further restrict Worker's created by extension content\nscripts, we added the extensions.web_accessible_workers.deprecated_behavior pref\nin case an emergency rollback was required. Fortunately, the change hasn't\ncaused problems in practice, and we can remove that unused preference now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331569\n", "files": ["dom/workers/loader/NetworkLoadHandler.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/base/nsNetUtil.cpp", "toolkit/components/extensions/test/xpcshell/test_ext_web_accessible_workers.js"], "git_node": "ce6571f3bb4cf55ec4520ff7babad40f2808e8ac", "git_parents": ["32578170bef0ea9e09dbd647980c18cef400fc1e"], "node": "6c89057fc2288fe55af61c5be96d2a1f28a501bb", "parents": ["58f109ff922134fc44b7d0eeb479240a62d576e1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081896 - Run the HSTS and HPKP updates in the weekly periodic-file-update task on ESR branches. r=releng-reviewers,jcristau\n\nThe pinning-update cron no longer runs on mozilla-esr153, so ESR branches get one repo-update revision a week,\nas on esr115. On ESR, periodic-file-update runs on b-linux with the pinning update's max-run-time. The HSTS\nupdate now reads the previous probe results from the index route of the task running it, so failure streaks\ncarry over in either task; esr153's start over once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333848\n", "files": [".cron.yml", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh", "taskcluster/gecko_taskgraph/transforms/repo_update.py", "taskcluster/kinds/repo-update/kind.yml"], "git_node": "149fbe77f6cbc13099a617af42ff9a07ed3bc31b", "git_parents": ["ce6571f3bb4cf55ec4520ff7babad40f2808e8ac"], "node": "550405f1c517b7185a01897dfb9bfecfd68a160f", "parents": ["6c89057fc2288fe55af61c5be96d2a1f28a501bb"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081896 - Stop appending r=releng-reviewers,jcristau to the generated repo-update commit messages.\n\nRelease managers review and approve the revision anyway, and Lando rewrites the message when it lands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334191\n", "files": ["taskcluster/docker/periodic-updates/runme.sh", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": "2a1e1174bd2b65c7dfe2820091cd40310b893904", "git_parents": ["149fbe77f6cbc13099a617af42ff9a07ed3bc31b"], "node": "573883dd242af2b674eb9afad42d99e182271094", "parents": ["550405f1c517b7185a01897dfb9bfecfd68a160f"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080336 - Don't fail in PushSubscriptionChangeDispatcher if there's no SW for window-accessible scope. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333721\n", "files": ["dom/push/PushDB.sys.mjs", "dom/push/PushNotifier.cpp", "dom/serviceworkers/ServiceWorkerManager.cpp", "testing/web-platform/mozilla/tests/push-api/pushsubscriptionchange.https.any.js"], "git_node": "3830b0bc4b70e68ba5211fc92a619006576d9591", "git_parents": ["2a1e1174bd2b65c7dfe2820091cd40310b89