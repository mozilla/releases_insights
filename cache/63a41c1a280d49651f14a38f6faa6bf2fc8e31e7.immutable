f05d1e80d5b2e3dea4382a2c7b10ff\nuk -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nur -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nuz -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nvi -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nwo -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nxh -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nzam -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nzh-CN -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\nzh-TW -\u003e b9ce7af92ff05d1e80d5b2e3dea4382a2c7b10ff\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "fabc488d175367eb1321dbaa0900c8c4cd6e75ea", "git_parents": ["3043fb28c39426eb18b87b77b4f998c287009c14"], "node": "8912607a109ba3f929c2180fc0578b72b491ce03", "parents": ["571f642fe712897db46acec827b820acf2cdd472"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2081260 - Add tae-arm task to mozilla-beta/mozilla-release r=isabel_rios,mbarone\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333253\n", "files": ["taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "6b3047fb846e92a318790802ca9a9659d0f89b56", "git_parents": ["fabc488d175367eb1321dbaa0900c8c4cd6e75ea"], "node": "4436fb7246870b3901e0e009620caecd65d02346", "parents": ["8912607a109ba3f929c2180fc0578b72b491ce03"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080659 - Pass the activity context to GeckoViewPrintDocumentAdapter r=geckoview-reviewers,ohall\n\nView.getContext() is @UiThread, but onPrintWithStatus is also reached from didPrintPageContent on a handler\nthread, and lint 32.5 reports it (ThreadConstraint). The adapter only uses the context for getCacheDir(), so\nthe activity context the method already null-checks works the same.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332769\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoView.java"], "git_node": "58dceb7e52410ac5201f1d2bc3ec018d362e1110", "git_parents": ["6b3047fb846e92a318790802ca9a9659d0f89b56"], "node": "3055c97c1a41d679b198dcb8dcfdcd5e500426f9", "parents": ["4436fb7246870b3901e0e009620caecd65d02346"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059840 - Enable layout.css.anchor-positioning.follows-transforms.enabled in Nightly only. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333110\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "c46ca666510ab8df0424c426a709b2ac2fdfa96e", "git_parents": ["58dceb7e52410ac5201f1d2bc3ec018d362e1110"], "node": "b792ee03b0b341e99e66340e82b1b64a89d2b951", "parents": ["3055c97c1a41d679b198dcb8dcfdcd5e500426f9"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the cron-bouncer-check kind on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,jcristau\n\nThe kind carries `run-on-repo-type: [hg]` and `clone-with: hg`. Removing\nthem only changes scheduling: the bouncer_check transform still pins the\nclone to Mercurial.\n\nVerified on staging-firefox (git-backed) on Oct 12: cron-bouncer-check-firefox\ncompleted in two minutes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333140\n", "files": ["taskcluster/kinds/cron-bouncer-check/kind.yml"], "git_node": "e24c0cb5f2a12f5272214677e86222c22bfee9d1", "git_parents": ["c46ca666510ab8df0424c426a709b2ac2fdfa96e"], "node": "8cd810a0bcf0834b08940d7b78a8d8b9047e3dbc", "parents": ["b792ee03b0b341e99e66340e82b1b64a89d2b951"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run android-stuff build tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nPart of the Mercurial -\u003e Git CI migration: remove the hg-only guards from\nthe build/android-stuff kind.\n\nbuild-android-geckoview-docs cannot be fully verified at level 1 on either\nbackend: after building the javadoc it uploads it to mozilla/geckoview\n(gh-pages) with a deploy key held in the level-3 secret\nproject/releng/gecko/build/level-3/geckoview-docs-upload, so try and\nstaging runs fail at that upload step whatever the VCS. What is verifiable\nmatches: on a git-backed push (staging-firefox) the task is scheduled, clones\nwith git, builds the javadoc (BUILD SUCCESSFUL) and fails at the same upload\nstep as the hg try baseline (lando 93250). On mozilla-central (level 3) the\ntask is green.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332344\n", "files": ["taskcluster/kinds/build/android-stuff.yml"], "git_node": "1d603388a9723c9bebc7297f2f04ff3231f315a6", "git_parents": ["e24c0cb5f2a12f5272214677e86222c22bfee9d1"], "node": "86d38809ace48c1bb7e31bf1901ee99c8f2471af", "parents": ["8cd810a0bcf0834b08940d7b78a8d8b9047e3dbc"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080735 - Run startup-test tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nRemove the `run-on-repo-type: [hg]` and `clone-with: hg` keys so the\nstartup-test tasks are scheduled on git-backed pushes and clone from\nGitHub.\n\nThe kind depends on dep-signing tasks, which failed on git-backed pushes\nuntil bug 2070846 was fixed (scriptworker 63.6.1, deployed 2026-10-08).\nVerified on a git-backed push (staging-firefox 3f1d4444b983, task group\nRA6yNPC9RaSiJSRzem7qZw): 6/6 startup-test tasks (linux64, linux64-aarch64,\nmacosx64, win32, win64, win64-aarch64) and all their build-signing,\nbuild-mac-signing and repackage-signing dependencies completed. hg\nbaseline (try push 2030870): 6/6 green.\n\nLanding waits on https://github.com/mozilla/global-platform-admin/pull/7642\n(GitHub app install for the repo).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332814\n", "files": ["taskcluster/kinds/startup-test/kind.yml"], "git_node": "416e49d66aacd49d5c51619e1b6d314e3961c8d7", "git_parents": ["1d603388a9723c9bebc7297f2f04ff3231f315a6"], "node": "22cc9999d43d4632c8b702c575184f6ab107b7b1", "parents": ["86d38809ace48c1bb7e31bf1901ee99c8f2471af"], "tags": []}], "date": 1791925799, "git_changesets": ["50e0c3659c03dd815b7ca3253e77b06c46b17e26", "bf4a0a91ad3fbb844b2956bd279ebf534c67e3f2", "ff16f9139b1f4c3693f0b07abcb042aba64450b8", "6b751cd3b25d5ef6e69e8e0b3ce5a3f757f9c606", "e09df0f7f8c73cde073ed4a2107fdf51b1b09452", "395de7db13542f587fcc2e8a7269faa4fade45ff", "37a65ea8d8c6b2d7f9ce9cad8554b793eefad422", "4ae0a5aa553789be93c5b98e6c32a4d8d213ba7e", "857a666df42ff976249838a854f34351b861128e", "bc0ae5aa40f0c6c5d5718a4d4b8b0a45223453dc", "8b2be85c999aa592c24a178900d6eb583bec98f8", "6e5e6845d31a8615dc256dc89ba1b0b118100f91", "bfea8b3f1d2fb0557f349b6a445ef685db5268e1", "77c61f6368745f44bb1832544fff2de2785a84cf", "d85db1b52e5f4fd76509c4df39ec5c421a1847e5", "dddb410c7df4013a14700a42709235925178ec86", "fe51e666e0ece0778454d80e14d78422190a9451", "a56c5e937f5584a9068f8b7426a6c57d968bec73", "0b79f0e0af2840c666e4ae4dd4a6d80a030755d7", "e33605e144d743801c934bad21098d85fa6a990b", "64438bf829c13807fb3042ea14d1f7b4bf85d7a1", "bd03775a2f1800f169b8a64e26749cf7eb5d3c62", "a6737f6982cbc9be4bd15b6921fe3487eef12387", "0f70e93bb8734ebffcdcb8c4af1e1c18344d7031", "bde9d242f1643b8c99dbd66af83c976c05c909ff", "0c1025123d09390679b9f2d84700a24af88ddf3e", "4f827abf46ca293d53393155843e752dcd03fe9f", "5a3268c8adce4b51302f16b88ac4396d85e4e2a3", "659ebcab90b98ac7d5e3b21c85c7d1b0dda13fe7", "f258f2881a28d22f8aa3f9cad7f4da4bfe575e5f", "22e095ca59aef00143400713e99e8154e0623563", "bcf621f5b087feefd11be6aea9cb532b47133f57", "8ef939f874f3da37800c0e40effb570055c0e520", "5cc9442898d36336da8a1a31238a8aba229a0cae", "4226b37e3d56703454fde75869df3b9a947459dc", "fc87f27a2297fc0fbb6e0db6fe636866e1243b08", "7e2feeed1249118c58d26aaf6e0ca7197316c356", "7d381b64f2bf84da8194e26138a2b637ec2f8990", "cca5a526251f1787e66ceec1d813ec8199065187", "248db073790584f8cbc1ea6a621ff99d64f30504", "8f48ec7c5318acaaae9a4e52a42a71fa85926895", "7dba7828d76d91cd050b36575b350ae4e1f6a5dc", "53282626ce3191172969ad4aaaeae6bb022e0477", "a430c6ceb8a649fafd869b468fd1714cceb1daa3", "9d1c524a3074d59eed1c5a3cf6dbbcda855851a7", "43b12ee5f7ca8937d37000229cc2481ba0a9a42f", "399acd02629ba0b33214c58fa047b0c52f67df30", "f4bc7e6814ddacaa58d1375331b17e40a856e532", "b0c3a5ee0ddf43d0fbc66633a25804e30e533f46", "63cb2e05e2a038aca90128360f1b85ef6f9b76f8", "5a99ceac42c3649d5016fa43cccac5c5b0d92c71", "b45fc4e808e9492876ee2cc6cf0939b11562b1d8", "a4468087346878f9707118f05f43756cbbcd905a", "e165c0b402ebeb16fcf5ef2d650ac90e2b16c870", "989212e2c552b88730901f31bd5f18cf2af5b940", "d0e5b646a6f02a517fb88c454e5336bcd71ad68d", "dd523934020f49cffbff3fcad8ec13889fed5aac", "6e05934c91312657bc4a3894bd452b4dd069f679", "3183e513243166d21094bc259aee85e6bfadd2ca", "8bc6b844c4235ccc4797032b284e017d4cb682f0", "5656338c2d261f4c9364f670486eec63ae6e4ecd", "3043fb28c39426eb18b87b77b4f998c287009c14", "fabc488d175367eb1321dbaa0900c8c4cd6e75ea", "6b3047fb846e92a318790802ca9a9659d0f89b56", "58dceb7e52410ac5201f1d2bc3ec018d362e1110", "c46ca666510ab8df0424c426a709b2ac2fdfa96e", "e24c0cb5f2a12f5272214677e86222c22bfee9d1", "1d603388a9723c9bebc7297f2f04ff3231f315a6", "416e49d66aacd49d5c51619e1b6d314e3961c8d7"], "user": "csabou@mozilla.com"}, "45554": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2073568 - Don't attempt to create XUL accessible in computed style change. r=morgan\n\nWe will otherwise fail to create an accessible again and again since XUL\nelements will not get generic accessibles. This mirrors the logic in\nMustBeGenericAccessible.\n\nNot sure how/if to test. Seems very specific for a perf test. Would need\nto do a xul browser test and restyle the container a bunch? Seems very\nspecific and not so useful as a test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332964\n", "files": ["accessible/base/nsAccessibilityService.cpp"], "git_node": "77bc98c6b6c414a1613201b776d95cbf9da81fc8", "git_parents": ["416e49d66aacd49d5c51619e1b6d314e3961c8d7"], "node": "7859e7e6ce706dd9399c604433c95032662ce4a4", "parents": ["22cc9999d43d4632c8b702c575184f6ab107b7b1"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966970 - Remove default agent legacy telemetry. r=chutten,nrishel\n\nAs a tag along, errors reading system state are now reported in telemetry as \"Error\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288290\n", "files": ["toolkit/components/telemetry/docs/data/default-browser-ping.md", "toolkit/mozapps/defaultagent/Cache.cpp", "toolkit/mozapps/defaultagent/Cache.h", "toolkit/mozapps/defaultagent/Telemetry.cpp", "toolkit/mozapps/defaultagent/docs/index.md", "toolkit/mozapps/defaultagent/moz.build", "toolkit/mozapps/defaultagent/tests/gtest/CacheTest.cpp", "toolkit/mozapps/defaultagent/tests/gtest/DefaultAgentTest.cpp", "toolkit/mozapps/defaultagent/tests/gtest/moz.build"], "git_node": "3846e5e300c3ace4e6ba6dac1b6a5d658f217dff", "git_parents": ["77bc98c6b6c414a1613201b776d95cbf9da81fc8"], "node": "f79e38e6aa6ff18bf5237d7424687edb734a02a3", "parents": ["7859e7e6ce706dd9399c604433c95032662ce4a4"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026828 - Fix handling of out-pointer parameter r=webgpu-reviewers,nical,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290297\n", "files": ["dom/webgpu/ipc/WebGPUParent.cpp", "gfx/wgpu_bindings/src/server.rs"], "git_node": "e0236b63f5492f19685a796a33a8c0090f678e5e", "git_parents": ["3846e5e300c3ace4e6ba6dac1b6a5d658f217dff"], "node": "69434de69993c328157f3c6f0f05a14e22c28a26", "parents": ["f79e38e6aa6ff18bf5237d7424687edb734a02a3"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026828 - Disallow `unsafe_op_in_unsafe_fn` in wgpu_bindings r=webgpu-reviewers,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331326\n", "files": ["gfx/wgpu_bindings/src/client.rs", "gfx/wgpu_bindings/src/command.rs", "gfx/wgpu_bindings/src/lib.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "369c00775eeae63d7ce41a35fe71f423a431c1f6", "git_parents": ["e0236b63f5492f19685a796a33a8c0090f678e5e"], "node": "5b82f76bccad2de7bebb7ba4318d4bc223882e4e", "parents": ["69434de69993c328157f3c6f0f05a14e22c28a26"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2080200 [Wayland] Split nsWindowWayland to nsWindowWaylandToplevel / nsWindowWaylandPopup r=emilio,gtk-reviewers\n\nSeparated nsWindowWaylandPopup class allows us to implement xdg-popup based wayland popups and use xdg-positioner directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332419\n", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "2527a804ec06fcd97ce9d9f3642b311a419974f0", "git_parents": ["369c00775eeae63d7ce41a35fe71f423a431c1f6"], "node": "f20fd5a5502de5ccac6389aa5c468460e1c2e335", "parents": ["5b82f76bccad2de7bebb7ba4318d4bc223882e4e"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080298: Allow CSSOM parsing of more numeric types. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332554\n", "files": ["servo/components/style/typed_om/numeric_declaration.rs", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/parse.tentative.html"], "git_node": "8b73de73ba8b12b00fb0797bd861dd19cc2ef074", "git_parents": ["2527a804ec06fcd97ce9d9f3642b311a419974f0"], "node": "ee8adb5a602bdd40fba0a344da58cbd3a297294e", "parents": ["f20fd5a5502de5ccac6389aa5c468460e1c2e335"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080298: Disallow Typed OM from having nodes not defined in CSSMathOperator after simplification. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332555\n", "files": ["servo/components/style/typed_om/numeric_declaration.rs"], "git_node": "95766692f3fa9d7e0b11b7954e7d41e66e33ef13", "git_parents": ["8b73de73ba8b12b00fb0797bd861dd19cc2ef074"], "node": "49e939b7aea56fe3dec589069d7af0f7a327efa3", "parents": ["ee8adb5a602bdd40fba0a344da58cbd3a297294e"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080940 - Add tests for more main thread GMP queries racing GMP service creation. r=media-playback-reviewers,padenot\n\nAdd browser tests that start a media capabilities query on the page or\nin a worker, and then make a main thread call that asks for GMP support.\nEach test runs in a new content process that has no GMP service yet, and\nchecks that the query and the main thread call both finish.\n\nBefore the fix in bug 2080876, the query started to create the GMP\nservice off the main thread and waited for the main thread. Each main\nthread call then waited for that service:\n- A new peer connection reads the default codecs, which ask if a GMP\n  can decode H.264.\n- The sender capabilities query reads the same default codecs.\n- A WebRTC capabilities query on the main thread asks if a GMP can\n  decode H.264.\n- A key system request asks if the ClearKey GMP is installed.\n- A media type check, with the GMP decoder preferred, asks the GMP\n  decoder module first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333125\n", "files": ["dom/media/test/browser/browser.toml", "dom/media/test/browser/browser_gmp_service_creation_race_callers.js"], "git_node": "cfffb66535a34e6d4a17727ee72052f16c985940", "git_parents": ["95766692f3fa9d7e0b11b7954e7d41e66e33ef13"], "node": "c620762263d80b991f378993911bb013346d4f11", "parents": ["49e939b7aea56fe3dec589069d7af0f7a327efa3"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2021271 - Show sign out card in the app menu when status is NOT_VERIFIED. r=nsharpley\" for landing with the wrong bug number.\n\nThis reverts commit e3bfd0ed8f27c348c7d7b0ab2bca3c2bf5270426.\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js"], "git_node": "d5b4706b89dabb3128df78efb54b1515010caaad", "git_parents": ["cfffb66535a34e6d4a17727ee72052f16c985940"], "node": "927ef9c5dfe4ab320496645432c46a0db0b2f4e0", "parents": ["c620762263d80b991f378993911bb013346d4f11"], "tags": []}, {"author": "alastor0325 \u003calastor0325@gmail.com\u003e", "branch": "default", "desc": "Bug 2079559 - Part 1: Do not offer Media Foundation CDMs when hardware video decoding is unavailable. r=media-playback-reviewers,padenot\n\nFirefox now offers the Media Foundation CDM key systems only when hardware\nvideo decoding is available, or when the graphics blocklist is bypassed. The\nmedia engine refuses every stream without hardware video decoding [1], but\nthe key system check did not look at it. So a page could get PlayReady\naccess and set keys for playback that cannot start.\n\n[1] https://searchfox.org/firefox-main/rev/1a097ed8d31f6b307a5d0ebc34a82ceaf7f3727b/dom/media/platforms/wmf/MFMediaEngineDecoderModule.cpp#103-107\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333082\n", "files": ["dom/media/eme/MediaKeySystemAccess.cpp"], "git_node": "5a85cf5172229006634cb053f55baa9e6fef142a", "git_parents": ["d5b4706b89dabb3128df78efb54b1515010caaad"], "node": "ffb042778ee3ab35873abbbca287015d39bbb11c", "parents": ["927ef9c5dfe4ab320496645432c46a0db0b2f4e0"], "tags": []}, {"author": "alastor0325 \u003calastor0325@gmail.com\u003e", "branch": "default", "desc": "Bug 2079559 - Part 2: Resolve setMediaKeys() once the CDM is associated with the element. r=media-playback-reviewers,padenot\n\nThe external engine state machine now resolves the setMediaKeys() promise\nwhen it queues the CDM, and it applies the CDM when the engine is ready.\nBefore, it held the promise until the engine was ready. The promise never\nsettled if the engine did not start, and it was rejected with an AbortError\nif the engine shut down first. The EME specification [1] only requires that\nthe CDM is associated with the element.\n\nIf the engine refuses the stream while a CDM is queued, the state machine\nnow reports a media error. It does not fall back to the normal state\nmachine, because that state machine cannot use a Media Foundation CDM. A\nnewer or cleared CDM replaces the queued one. The error path for applying\nthe CDM and the crash recovery case have no test, because no test can cause\nthem.\n\n[1] https://w3c.github.io/encrypted-media/#dom-htmlmediaelement-setmediakeys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333083\n", "files": ["dom/media/ExternalEngineStateMachine.cpp", "dom/media/ExternalEngineStateMachine.h"], "git_node": "8923dfdaa917258716099d34871920ef3f5a6dec", "git_parents": ["5a85cf5172229006634cb053f55baa9e6fef142a"], "node": "0e2b04e1077292c9ce0d6c0499e5920cfdba740d", "parents": ["ffb042778ee3ab35873abbbca287015d39bbb11c"], "tags": []}, {"author": "alastor0325 \u003calastor0325@gmail.com\u003e", "branch": "default", "desc": "Bug 2079559 - Part 3: Test that Media Foundation CDMs are not offered without hardware video decoding. r=media-playback-reviewers,padenot\n\nThe test turns off hardware video decoding and checks that Firefox refuses\nevery PlayReady key system. It also checks that these key systems are\noffered when the graphics blocklist is bypassed, and that ClearKey is always\noffered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333084\n", "files": ["dom/media/test/mochitest_media_engine.toml", "dom/media/test/test_eme_mfcdm_unavailable_without_hw_decoding.html"], "git_node": "88c8db829e426a0dfd05997c4bb8211dfbf6d7d0", "git_parents": ["8923dfdaa917258716099d34871920ef3f5a6dec"], "node": "4ecd4e82b4d0656a8c802a01826eeea75b3f6ed1", "parents": ["0e2b04e1077292c9ce0d6c0499e5920cfdba740d"], "tags": []}, {"author": "alastor0325 \u003calastor0325@gmail.com\u003e", "branch": "default", "desc": "Bug 2079559 - Part 4: Test that setMediaKeys() does not wait for the external engine to start. r=media-playback-reviewers,padenot\n\nThe test checks that setMediaKeys() settles when no media is appended, and\nwhen the element or its MediaSource is replaced while the CDM is queued. It\nalso checks that only the newest CDM is applied when keys are set two times,\nand that a refused stream raises a media error only while keys are set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333085\n", "files": ["dom/media/test/mochitest_media_engine.toml", "dom/media/test/test_eme_setmediakeys_engine_startup.html"], "git_node": "d27265a860d4bc426988b68fe2a3f80393e853f6", "git_parents": ["88c8db829e426a0dfd05997c4bb8211dfbf6d7d0"], "node": "20d5f813196b6688f50e303ac0c967442bc1ab35", "parents": ["4ecd4e82b4d0656a8c802a01826eeea75b3f6ed1"], "tags": []}, {"author": "alastor0325 \u003calastor0325@gmail.com\u003e", "branch": "default", "desc": "Bug 2079559 - Part 5: Record when the external engine refuses a stream that has a pending CDM. r=media-playback-reviewers,padenot\n\nThe external engine state machine now records a media engine error event\nwhen the engine refuses the stream format while a CDM is queued. This shows\nhow often this failure occurs in the field. Clear playback is not recorded,\nbecause every machine without hardware video decoding refuses clear streams\nin the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333086\n", "files": ["dom/media/ExternalEngineStateMachine.cpp", "dom/media/test/test_eme_setmediakeys_engine_startup.html"], "git_node": "f04a3a31abe20c04e4c1c6752d5d8ad711a13e2b", "git_parents": ["d27265a860d4bc426988b68fe2a3f80393e853f6"], "node": "e108b2d205f4eb4fd888026c5b1aadd5917fac4d", "parents": ["20d5f813196b6688f50e303ac0c967442bc1ab35"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079061 - Hold strong references to the media element across timeupdate and pause. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333031\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/webvtt/TextTrackManager.cpp"], "git_node": "9f8119a9bf91e9b916e8090de2a347e5e57ccccb", "git_parents": ["f04a3a31abe20c04e4c1c6752d5d8ad711a13e2b"], "node": "5ca1c5cb286e845ba66faad7e4fcb86883db4317", "parents": ["e108b2d205f4eb4fd888026c5b1aadd5917fac4d"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2026828 - Disallow `unsafe_op_in_unsafe_fn` in wgpu_bindings r=webgpu-reviewers,ErichDonGubler\" for causing build bustages at MTLTextureDescriptor\n\nThis reverts commit 369c00775eeae63d7ce41a35fe71f423a431c1f6.\n\nRevert \"Bug 2026828 - Fix handling of out-pointer parameter r=webgpu-reviewers,nical,ErichDonGubler\"\n\nThis reverts commit e0236b63f5492f19685a796a33a8c0090f678e5e.\n", "files": ["dom/webgpu/ipc/WebGPUParent.cpp", "gfx/wgpu_bindings/src/client.rs", "gfx/wgpu_bindings/src/command.rs", "gfx/wgpu_bindings/src/lib.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "6f66f3c826c714cf43ccd2541808e4d4c5246402", "git_parents": ["9f8119a9bf91e9b916e8090de2a347e5e57ccccb"], "node": "151fad17a50c03e310e71ad2381fc310998402e1", "parents": ["5ca1c5cb286e845ba66faad7e4fcb86883db4317"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079058 - Adjust principal update handling when a media resource request starts. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333034\n", "files": ["dom/media/ChannelMediaResource.cpp"], "git_node": "689d11b2db81731a53db1c2b362b648785cdcb51", "git_parents": ["6f66f3c826c714cf43ccd2541808e4d4c5246402"], "node": "39c335caadc7b77def49e8a578147285dd06180f", "parents": ["151fad17a50c03e310e71ad2381fc310998402e1"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2077211 - pt1. Use FaultingCodeRange resumeOffset returned by wasmTrap for stack maps r=iain,rhunt\n\nConsistently use FaultingCodeRange.resumeOffset() returned by wasmTrap to\nrecord the resume point offset rather than using a fresh offset. This makes\noffset recording more robust to potential intermediate instruction emission\nbetween the actual trap instruction and when the offset is recorded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330284\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCCodegen-inl.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "ac495d936df98c5cd0314fa6cd291ce356c0c3e3", "git_parents": ["689d11b2db81731a53db1c2b362b648785cdcb51"], "node": "8d98fe69eb5dcbb3b8b18c20d08f53e92d53b3e0", "parents": ["39c335caadc7b77def49e8a578147285dd06180f"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2077211 - pt2. Use an indirect jump when resuming from the WASM trap exit stub r=iain,rhunt\n\nUse an indirect jump to resume from the WASM trap exit stub instead of a ret() with\na synthesized return address.\n- On architectures with a link register this simply uses an indirect jump instead\nof a return through the link register.\n- On x86/x64 this introduces an additional instruction after the actual trap instruction\nat all resumable trap sites to cleanup the stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330285\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/wasm/WasmStubs.cpp"], "git_node": "dbace9ef886fb90bf46b3a7b85097df55b6f33d9", "git_parents": ["ac495d936df98c5cd0314fa6cd291ce356c0c3e3"], "node": "05ebe19efbaa9c3333bf5cfbf5e37834eae729b7", "parents": ["8d98fe69eb5dcbb3b8b18c20d08f53e92d53b3e0"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080000 - Part 7: Remove the unused deleteBrowsingDataItemIcon attr r=android-reviewers,skhan\n\n- This attr has been unused since the delete browsing data items switched from icons to checkboxes in https://github.com/mozilla-mobile/fenix/issues/3106.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332710\n", "files": ["mobile/android/fenix/app/src/main/res/values/attrs.xml"], "git_node": "1036cd3482ea0354f69056baecf77d090cb82b82", "git_parents": ["dbace9ef886fb90bf46b3a7b85097df55b6f33d9"], "node": "068e3fd406fdd684f8eeb90c667d78d074e88091", "parents": ["05ebe19efbaa9c3333bf5cfbf5e37834eae729b7"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072029 - P1. Run the address and credit card migrations through one function r=joschmidt,credential-management-reviewers\n\n#setUpAddressRustStorage, #migrateToEnabledAddressStorage and their credit card\ncounterparts become #maybeRunMigration(dataType), which startup and a flip of\neither enabled pref call. What differs per collection -- its three prefs and its\nmigrator, whose config names the Rust adapter -- comes from RUST_MIGRATIONS,\nkeyed by AutofillDataTypes, and the prefs decide which copy runs.\n\nThree behavior changes, the same for both collections:\n\n - A copy into Rust wipes it first on a flip too, not only at startup, which\n   clears tombstones an earlier copy left there. A copy back still does not.\n - Every completed real copy fires the \"migrate\" notification, including the\n   startup copy into Rust, where it is redundant but harmless.\n - A flip that leaves Rust off runs the dry run if one is owed, where before\n   only startup could.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329928\n", "files": ["toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs"], "git_node": "414e1ff3d0554636c73d89d3d2ca6df2c1ce0943", "git_parents": ["1036cd3482ea0354f69056baecf77d090cb82b82"], "node": "9d3c879693372b76f96659161c7ff08d78eac1a7", "parents": ["068e3fd406fdd684f8eeb90c667d78d074e88091"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072029 - P2. Announce when the OS key store is unlocked r=joschmidt\n\nOSKeyStore.isLoggedIn says whether a read with reauth false would retrigger a\ndialog, but nothing says when it becomes true, so a caller that must not be the\none to put that dialog up can only ask again at some later point and hope.\n\nensureLoggedIn() now notifies OSKeyStore.UNLOCKED_TOPIC when it takes the store\nfrom locked to unlocked: once per unlock, whatever did the unlocking, and not\nfor a use of a store that is already unlocked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329697\n", "files": ["toolkit/modules/OSKeyStore.sys.mjs", "toolkit/modules/tests/xpcshell/test_osKeyStore.js"], "git_node": "b7ab45b4667cff5593ab298ac8e6fdceb0ce3e50", "git_parents": ["414e1ff3d0554636c73d89d3d2ca6df2c1ce0943"], "node": "110f782672dabf00a83cb093722fc05f7078ff92", "parents": ["9d3c879693372b76f96659161c7ff08d78eac1a7"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072029 - P3. Support the credit card migration dry run r=joschmidt,credential-management-reviewers\n\nWith runMigrationTest set, the cards are copied into the Rust store once per\nprofile per generation, verified, reported through migrate_to_rust and wiped.\nThe pref stays off by default.\n\nThe copy needs a key at each end and must never prompt, so #maybeRunMigration\nchecks an encrypted collection before copying it:\n\n - With a primary password set, nothing is copied into Rust. A copy back waits\n   until the token is unlocked.\n - A copy into Rust waits until the OS key store is unlocked, retried on\n   OSKeyStore.UNLOCKED_TOPIC (P2). Windows does not wait: its key store shows\n   no UI.\n - While another key store operation is in flight, the copy waits for it.\n - A profile with no cards goes ahead.\n - A copy back from a Rust store that cannot be read leaves the profile there\n   instead of failing startup.\n\nThis replaces CreditCardStorageMigrator._keysAvailable from bug 2080074. A key\nstore that cannot decrypt the cards now fails the attempt instead of deferring\nit, so after three attempts the profile stays on JSON.\n\nThe copy's decrypts are recorded under their own trigger,\nformautofill_migration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326175\n", "files": ["browser/extensions/formautofill/test/browser/browser_creditCard_migration.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "a5128f9f1d03f69ded8b9b10ab2723d47944425e", "git_parents": ["b7ab45b4667cff5593ab298ac8e6fdceb0ce3e50"], "node": "a315208d502e7e44aa8e8941e8bc2813d51561e1", "parents": ["110f782672dabf00a83cb093722fc05f7078ff92"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2081033 - wasm: use MacroAssembler::cmp64Set directly in the baseline compiler. r=yury\n\nBaseCompiler::cmp64Set duplicated MacroAssembler::cmp64Set: on 64-bit\ntargets it called cmpPtrSet, as every 64-bit MacroAssembler::cmp64Set does,\nand on 32-bit targets it emitted the same branch sequence that the x86 and\narm MacroAssembler::cmp64Set use when the destination aliases an operand.\nRemove it and call masm.cmp64Set directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333101\n", "files": ["js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCCodegen-inl.h", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "049b84698891076de1055d54baa86798890d17d8", "git_parents": ["a5128f9f1d03f69ded8b9b10ab2723d47944425e"], "node": "44e215f03661d508bc655df8888e56756bce03c8", "parents": ["a315208d502e7e44aa8e8941e8bc2813d51561e1"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2080681 - wasm: compare i64 values against constant immediates in the baseline compiler. r=yury\n\nThe baseline compiler compares an i32 against a constant right-hand side\nusing an immediate, but for i64 it popped both operands into registers. On\narm64, a compare against zero followed by a branch became:\n\n  mov  x0, #0\n  cmp  x1, x0\n  b.ge label\n\nWhen the right-hand side of an i64 comparison is a constant, use it as an\nimmediate, both for comparisons that feed a branch and for those that\nproduce a value:\n\n  cmp  x1, #0\n  b.ge label\n\nOn a JetStream 3 run on arm64 this removes all 2,414 materialized zeros\ncompared against in baseline wasm code.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332784\n", "files": ["js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "30e93a88b95b572f141bb2ceb4b3888b4fa11146", "git_parents": ["049b84698891076de1055d54baa86798890d17d8"], "node": "1a735b023a1dfe4598b437877fd4969a419fc928", "parents": ["44e215f03661d508bc655df8888e56756bce03c8"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081198 - Bump `webspec-index` skills in-tree to v0.14. r=ai4dev-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333255\n", "files": [".agents/skills/spec-trace/SKILL.md", ".agents/skills/specmap/SKILL.md", ".agents/skills/webspec-index/SKILL.md", ".claude/skills/spec-trace/SKILL.md", ".claude/skills/specmap/SKILL.md", ".claude/skills/webspec-index/SKILL.md", "taskcluster/kinds/fetch/toolchains.yml"], "git_node": "6c879c8e6cd86f7f064d5a8c620ce1f6d49d457b", "git_parents": ["30e93a88b95b572f141bb2ceb4b3888b4fa11146"], "node": "89455a37131ebf4664682fb9cbf30d1c679bc367", "parents": ["1a735b023a1dfe4598b437877fd4969a419fc928"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076717 - Submit the ETLD local-network-access ping on all channels. r=janerik,necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333024\n", "files": ["netwerk/pings.yaml", "netwerk/protocol/http/nsHttpHandler.cpp"], "git_node": "ba4d60db6affde83ff5db9b07152935a19c4b676", "git_parents": ["6c879c8e6cd86f7f064d5a8c620ce1f6d49d457b"], "node": "1330dbc72180e691b96483cdbe2388994f918745", "parents": ["89455a37131ebf4664682fb9cbf30d1c679bc367"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081024 - Update NSS to 49e8830fef06c1b83d1fa5b49c4c8d96247305f1. UPGRADE_NSS_RELEASE r=nss-reviewers,jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333078\n", "files": ["security/nss/automation/abi-check/expected-report-libnss3.so.txt", "security/nss/automation/abi-check/expected-report-libnssutil3.so.txt", "security/nss/automation/abi-check/expected-report-libsmime3.so.txt", "security/nss/automation/abi-check/expected-report-libssl3.so.txt", "security/nss/automation/abi-check/previous-nss-release", "security/nss/fuzz/targets/smime.cc", "security/nss/gtests/pk11_gtest/pk11_chacha20poly1305_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_hpke_unittest.cc", "security/nss/gtests/smime_gtest/smime_unittest.cc", "security/nss/gtests/ssl_gtest/ssl_keyupdate_unittest.cc", "security/nss/lib/base/arena.c", "security/nss/lib/base/base.h", "security/nss/lib/base/hash.c", "security/nss/lib/base/item.c", "security/nss/lib/base/libc.c", "security/nss/lib/base/list.c", "security/nss/lib/base/utf8.c", "security/nss/lib/certdb/alg1485.c", "security/nss/lib/certdb/cert.h", "security/nss/lib/certdb/certdb.c", "security/nss/lib/certdb/certi.h", "security/nss/lib/cryptohi/keyhi.h", "security/nss/lib/cryptohi/seckey.c", "security/nss/lib/cryptohi/secsign.c", "security/nss/lib/dev/ckhelper.c", "security/nss/lib/dev/ckhelper.h", "security/nss/lib/dev/dev.h", "security/nss/lib/dev/devm.h", "security/nss/lib/dev/devslot.c", "security/nss/lib/dev/devtoken.c", "security/nss/lib/dev/devutil.c", "security/nss/lib/nss/nss.h", "security/nss/lib/pk11wrap/dev3hack.c", "security/nss/lib/pk11wrap/dev3hack.h", "security/nss/lib/pk11wrap/pk11cert.c", "security/nss/lib/pk11wrap/pk11cxt.c", "security/nss/lib/pk11wrap/pk11hpke.c", "security/nss/lib/pk11wrap/pk11obj.c", "security/nss/lib/pk11wrap/pk11pbe.c", "security/nss/lib/pk11wrap/pk11priv.h", "security/nss/lib/pk11wrap/pk11util.c", "security/nss/lib/pk11wrap/secmodi.h", "security/nss/lib/pki/certificate.c", "security/nss/lib/pki/nsspki.h", "security/nss/lib/pki/pki.h", "security/nss/lib/pki/pki3hack.c", "security/nss/lib/pki/pkibase.c", "security/nss/lib/pki/pkim.h", "security/nss/lib/smime/cmsarray.c", "security/nss/lib/smime/cmssigdata.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/tls13con.c", "security/nss/lib/util/nssutil.h", "security/nss/moz.yaml"], "git_node": "d150e12011a2e24a97fd66bc1f6768b1f1ddbdc6", "git_parents": ["ba4d60db6affde83ff5db9b07152935a19c4b676"], "node": "8f66c140d0cfbff1e758c925279b718eccf9fc50", "parents": ["1330dbc72180e691b96483cdbe2388994f918745"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079728 - Prefix the names of the content child processes with \"sandboxed_\". r=kaya,geckoview-reviewers\n\nHyperOS's memory cleaner skips processes named \":sandboxed_*\", which\navoids it killing our content processes in the background and causing\ntab reloads. The applink startup test ignores the prefix like the\n\"_disable_art_image_\" tag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332033\n", "files": ["mobile/android/docs/geckoview/contributor/native-debugging.md", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateMultipleSessionsTest.kt", "mobile/android/geckoview/src/main/AndroidManifest_overlay.jinja", "testing/performance/mobile-startup/android_startup_videoapplink.py"], "git_node": "f81d844d8981a55b8b09a20fc15a336d6314f491", "git_parents": ["d150e12011a2e24a97fd66bc1f6768b1f1ddbdc6"], "node": "82167adcdbe409349ce61456aaa9fe8946744370", "parents": ["8f66c140d0cfbff1e758c925279b718eccf9fc50"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2079783 - Clear observer before notifying in XSLT compiler. r=sfarre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333203\n", "files": ["dom/xslt/xslt/txStylesheetCompiler.cpp"], "git_node": "4a4e8bdeb879f11af600fdfdd31675a26fe40535", "git_parents": ["f81d844d8981a55b8b09a20fc15a336d6314f491"], "node": "124b30a35e1d5b984390502a10db92b2f04349be", "parents": ["82167adcdbe409349ce61456aaa9fe8946744370"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2079783 test case - Clear observer before notifying in XSLT compiler. r=sfarre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333204\n", "files": ["dom/xslt/crashtests/2079783-blank.txt", "dom/xslt/crashtests/2079783-c.xsl", "dom/xslt/crashtests/2079783-g.xsl", "dom/xslt/crashtests/2079783-p.xsl", "dom/xslt/crashtests/2079783-source.xml", "dom/xslt/crashtests/2079783.html", "dom/xslt/crashtests/crashtests.list"], "git_node": "df94f2f7b9ec3c97c9df6b006620da84c27bfc63", "git_parents": ["4a4e8bdeb879f11af600fdfdd31675a26fe40535"], "node": "9531b6d22c2c39e6e0fcf60c7e286eb6bb588c99", "parents": ["124b30a35e1d5b984390502a10db92b2f04349be"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080237 - [devtools] Add sections to the new settings inventory r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332447\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/inventory.mjs", "devtools/client/settings/test/browser/browser_settings_preference_bindings.js", "devtools/client/settings/test/browser/browser_settings_rulers.js", "devtools/client/settings/types/inventory.d.ts"], "git_node": "3d1256347e4ec4cfb413aebe5a12a05558b7bb95", "git_parents": ["df94f2f7b9ec3c97c9df6b006620da84c27bfc63"], "node": "ec68a78a1a003b686ca8c8e8b2d36a4fa17c5eb3", "parents": ["9531b6d22c2c39e6e0fcf60c7e286eb6bb588c99"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2003984 - Wait for the saved login to be filled before updating it in AutocompleteTest#loginUpdateAccept. r=geckoview-reviewers,ohall\n\nThe second session submitted right after the page stopped loading, sometimes before the login fetch filled in\nthe username, so the empty username saved as a new login instead of updating the existing one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332723\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AutocompleteTest.kt"], "git_node": "cc5efadf2d07c42a4e68b2f760a24b2b1f1942c5", "git_parents": ["3d1256347e4ec4cfb413aebe5a12a05558b7bb95"], "node": "05a56ae8908bb073f1bd937c4a1178a2c1df908c", "parents": ["ec68a78a1a003b686ca8c8e8b2d36a4fa17c5eb3"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080210: Fix test for beta r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332486\n", "files": ["js/src/jit-test/tests/iterator/bug2079156-async.js"], "git_node": "adb6b0223f3c0057ff75c25d0dc7c6018914feb9", "git_parents": ["cc5efadf2d07c42a4e68b2f760a24b2b1f1942c5"], "node": "4fbd90d14f8a5ef79893e51d41da38a037e556ad", "parents": ["05a56ae8908bb073f1bd937c4a1178a2c1df908c"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079036 - Clamp damage area in nsTableCellFrame::DidSetComputedStyle. r=layout-reviewers,emilio\n\n(original patch provided by clauditor)\n\nThe col-span clamp in nsTableCellFrame::DidSetComputedStyle here is sufficient\nto fix the reported issue; but given the complexity of table and border-collapse\ncode in general, the precaution of clamping in nsTableFrame::ExpandBCDamageArea\nseems worthwhile for a little extra hardening.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332732\n", "files": ["layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableFrame.cpp", "testing/web-platform/tests/css/css-tables/crashtests/border-collapse-dynamic-crash.html"], "git_node": "989bfc7f72fe17d9d0849c32ad79e52b9d49ceab", "git_parents": ["adb6b0223f3c0057ff75c25d0dc7c6018914feb9"], "node": "e32361b498998d19bb0b3103c3f772bb4c3f0653", "parents": ["4fbd90d14f8a5ef79893e51d41da38a037e556ad"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079529 - use CERT_GetDERCertTrust in PSM r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331847\n", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp", "security/manager/ssl/nsIX509CertDB.idl", "security/manager/ssl/nsNSSCertificateDB.cpp", "security/manager/ssl/nsNSSCertificateDB.h", "security/manager/ssl/tests/unit/head_psm.js", "security/manager/ssl/tests/unit/test_cert_overri