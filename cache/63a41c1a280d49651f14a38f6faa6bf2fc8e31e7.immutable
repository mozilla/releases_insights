c/klarDebug/res/xml-v25/shortcuts.xml", "mobile/android/focus-android/app/src/klarDebug/res/xml/shortcuts.xml", "mobile/android/focus-android/app/src/klarNightly/drawable-v24/icon_foreground.xml", "mobile/android/focus-android/app/src/klarNightly/drawable/background_gradient_dark.xml", "mobile/android/focus-android/app/src/klarNightly/drawable/icon_background.xml", "mobile/android/focus-android/app/src/klarNightly/drawable/toolbar_url_background.xml", "mobile/android/focus-android/app/src/klarNightly/mipmap-anydpi-v26/ic_launcher.xml", "mobile/android/focus-android/app/src/klarNightly/mipmap-anydpi-v26/ic_launcher_round.xml", "mobile/android/focus-android/app/src/klarNightly/mipmap-hdpi/ic_launcher.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-hdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-mdpi/ic_launcher.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-mdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-xhdpi/ic_launcher.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-xhdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-xxhdpi/ic_launcher.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-xxhdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-xxxhdpi/ic_launcher.png", "mobile/android/focus-android/app/src/klarNightly/mipmap-xxxhdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/klarNightly/res/xml-v25/shortcuts.xml", "mobile/android/focus-android/app/src/klarNightly/res/xml/shortcuts.xml", "mobile/android/focus-android/app/src/klarRelease/res/xml-v25/shortcuts.xml", "mobile/android/focus-android/app/src/klarRelease/res/xml/shortcuts.xml", "mobile/android/focus-android/app/src/nightly/res/drawable-v24/ic_splash_screen.xml", "mobile/android/focus-android/app/src/nightly/res/drawable/ic_splash_screen.webp", "mobile/android/focus-android/app/src/nightly/res/drawable/ic_splash_screen.xml", "mobile/android/focus-android/app/src/nightly/res/mipmap-anydpi-v26/ic_launcher.xml", "mobile/android/focus-android/app/src/nightly/res/mipmap-anydpi/ic_launcher.xml", "mobile/android/focus-android/app/src/nightly/res/mipmap-hdpi/ic_launcher.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-hdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-mdpi/ic_launcher.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-mdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-xhdpi/ic_launcher.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-xhdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-xxhdpi/ic_launcher.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-xxhdpi/ic_launcher_round.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-xxxhdpi/ic_launcher.png", "mobile/android/focus-android/app/src/nightly/res/mipmap-xxxhdpi/ic_launcher_round.png"], "git_node": "8448760670753a731541ff9aa0e6c7e68df7236a", "git_parents": ["242748166de028a0b532f67e69f7dc7460cb94f6"], "node": "8f16a949146a298e1746074eba820fe159153fcc", "parents": ["f4cf900e7f315c83c6a0264a038ece29335c1407"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083254 - Fix lint findings in the Focus variant wordmarks. r=android-reviewers,mcarare\n\nSeveral Nightly paths close their tag before a fillAlpha line, which is left as text in the drawable. Removing\nit keeps the wordmark rendering as it does today. The variant copies also get the VectorRaster suppression bug\n2060603 gave the main one, which lint never reported for them because it only analyzes the debug variant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334857\n", "files": ["mobile/android/focus-android/app/src/focusBeta/res/drawable/wordmark2.xml", "mobile/android/focus-android/app/src/klar/res/drawable/wordmark2.xml", "mobile/android/focus-android/app/src/nightly/res/drawable/wordmark2.xml"], "git_node": "c4ddca79171add8a2c6ebb362c66e934eeeadc1c", "git_parents": ["8448760670753a731541ff9aa0e6c7e68df7236a"], "node": "bd88d7682399f55570301d6c6db43682574f1d0a", "parents": ["8f16a949146a298e1746074eba820fe159153fcc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083254 - Remove Focus strings that only tests reference. r=android-reviewers,android-l10n-reviewers,mcarare,parker\n\nThe first run tour titles went with the legacy onboarding in bug 1950092, and the robot helpers that still\nread them have no callers. The block cookies prompt takes its title from preference_privacy_category_cookies,\nso the test now looks for that string instead of the never-displayed preference_block_cookies_title.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334858\n", "files": ["mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/HomeScreenRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/SettingsPrivacyMenuRobot.kt", "mobile/android/focus-android/app/src/main/res/values/strings.xml"], "git_node": "040c70b6b68daf86ddb212b5417fd8f5ee9df1f9", "git_parents": ["c4ddca79171add8a2c6ebb362c66e934eeeadc1c"], "node": "da8a128599e259177fb389c0b1f00a64bedb5452", "parents": ["bd88d7682399f55570301d6c6db43682574f1d0a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083254 - Suppress UnusedResources for the Focus text selection label. r=android-reviewers,android-l10n-reviewers,mcarare,parker\n\nLike the beta and nightly labels, it is referenced only through manifestPlaceholders in build.gradle, which\nthe check cannot see in the variants that do not use it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334859\n", "files": ["mobile/android/focus-android/app/src/main/res/values/strings.xml"], "git_node": "d4e8a9af8aed9c7694d99da422a5648515189e8d", "git_parents": ["040c70b6b68daf86ddb212b5417fd8f5ee9df1f9"], "node": "53d776c5919fee78951d7dfa65070753b864398d", "parents": ["da8a128599e259177fb389c0b1f00a64bedb5452"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083254 - Alias the Focus splash screen icon to the launcher foreground. r=android-reviewers,mcarare\n\nThe main and nightly ic_splash_screen drawables were copies of the ic_launcher_foreground beside them. Beta\nkeeps its own, which differs from its launcher foreground.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334860\n", "files": ["mobile/android/focus-android/app/src/main/res/drawable/ic_splash_screen.xml", "mobile/android/focus-android/app/src/main/res/values/drawables.xml", "mobile/android/focus-android/app/src/nightly/res/drawable/ic_splash_screen.xml"], "git_node": "0b12b9325bf45aa7555f2bf3fd52e92e09ec696b", "git_parents": ["d4e8a9af8aed9c7694d99da422a5648515189e8d"], "node": "8a58ba5a24f36cd4b3feeffbc5f1d6e1b1346744", "parents": ["53d776c5919fee78951d7dfa65070753b864398d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083254 - Point the Klar Nightly shortcuts at the Klar Nightly package. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334861\n", "files": ["mobile/android/focus-android/app/src/klarNightly/res/xml/shortcuts.xml"], "git_node": "f27295ba5b0a198ed8db40fcdc3a6af1661ccf67", "git_parents": ["0b12b9325bf45aa7555f2bf3fd52e92e09ec696b"], "node": "30cc5a8f96391e6d6f79a997debbc42161c0b4cc", "parents": ["8a58ba5a24f36cd4b3feeffbc5f1d6e1b1346744"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083254 - Add missing final newlines to Focus XML files. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334888\n", "files": ["mobile/android/focus-android/app/src/debug/res/mipmap-anydpi/ic_launcher.xml", "mobile/android/focus-android/app/src/main/res/color/preference_title_text.xml", "mobile/android/focus-android/app/src/main/res/color/selected_search_engine_state.xml", "mobile/android/focus-android/app/src/main/res/drawable/background_install_banner.xml", "mobile/android/focus-android/app/src/main/res/drawable/background_list_item_current_session.xml", "mobile/android/focus-android/app/src/main/res/drawable/background_list_item_session.xml", "mobile/android/focus-android/app/src/main/res/drawable/background_search_suggestion_section.xml", "mobile/android/focus-android/app/src/main/res/drawable/dialog_background.xml", "mobile/android/focus-android/app/src/main/res/drawable/dialog_warning_background.xml", "mobile/android/focus-android/app/src/main/res/drawable/preference_foreground_disabled.xml", "mobile/android/focus-android/app/src/main/res/drawable/preference_multiselect_search_engine_foreground.xml", "mobile/android/focus-android/app/src/main/res/layout/activity_customtab.xml", "mobile/android/focus-android/app/src/main/res/layout/focus_preference_no_icon.xml", "mobile/android/focus-android/app/src/main/res/layout/fragment_autocomplete_add_domain.xml", "mobile/android/focus-android/app/src/main/res/layout/preference_manual_add_search_engine.xml", "mobile/android/focus-android/app/src/main/res/menu/menu_search_engines.xml", "mobile/android/focus-android/app/src/main/res/mipmap-anydpi/ic_launcher.xml", "mobile/android/focus-android/app/src/main/res/transition/firstrun_exit.xml", "mobile/android/focus-android/app/src/main/res/values/attrs.xml", "mobile/android/focus-android/app/src/main/res/xml/autocomplete.xml", "mobile/android/focus-android/app/src/main/res/xml/manual_add_search_engine.xml", "mobile/android/focus-android/app/src/main/res/xml/remove_search_engines.xml", "mobile/android/focus-android/app/src/nightly/res/mipmap-anydpi/ic_launcher.xml", "mobile/android/focus-android/quality/pmd-rules.xml"], "git_node": "7e5a4cdbfd8b37bcce9c3e2a4ee6125975bf94da", "git_parents": ["f27295ba5b0a198ed8db40fcdc3a6af1661ccf67"], "node": "61650759f69d723117c017e14065192484fba567", "parents": ["30cc5a8f96391e6d6f79a997debbc42161c0b4cc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083389 - Drop dead Fenix nightly manifest and dimen entries. r=android-reviewers,mcarare\n\nThe nightly CustomTabsService declaration has duplicated main's since bug 1827716 removed its Trusted Web\nActivity intent filter, and wordmark_text_margin_top has no users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334895\n", "files": ["mobile/android/fenix/app/src/nightly/AndroidManifest.xml", "mobile/android/fenix/app/src/nightly/res/values/dimens.xml"], "git_node": "a4387cc673897c3827a8f50f94917254ef720309", "git_parents": ["7e5a4cdbfd8b37bcce9c3e2a4ee6125975bf94da"], "node": "d849f65e5afb45d402a94df9253e5d56135d1fb3", "parents": ["61650759f69d723117c017e14065192484fba567"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083389 - Fix lint findings in the Fenix variant manifests and icons. r=android-reviewers,mcarare\n\nNightly's IntentReceiverActivity declares main's android:exported value itself, and the beta and nightly\nic_firefox vectors take the intrinsic size of main's, which release already uses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334896\n", "files": ["mobile/android/fenix/app/src/beta/res/drawable/ic_firefox.xml", "mobile/android/fenix/app/src/nightly/AndroidManifest.xml", "mobile/android/fenix/app/src/nightly/res/drawable/ic_firefox.xml"], "git_node": "4109941a3e29d8f3be5805f4fd0c7a7f6daee7df", "git_parents": ["a4387cc673897c3827a8f50f94917254ef720309"], "node": "6b283e51fa6777e1d40bc21dd77b577f01bc48f1", "parents": ["d849f65e5afb45d402a94df9253e5d56135d1fb3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083389 - Remove Fenix resources that only tests reference. r=android-reviewers,android-l10n-reviewers,mcarare,parker\n\nUI tests now find the settings title and the delete dialog buttons by the strings those screens display. The\nother test references move to live resources or go with the unused robot helpers and selector that held them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334897\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/onboarding/view/OnboardingMapperTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/BrowserRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuLoginsAndPasswordsSavedLoginsRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsTranslationsRobot.kt", "mobile/android/fenix/app/src/main/res/drawable/ic_notification_permission.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_onboarding_search_widget.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/ContextTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/DefaultSessionControlControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/view/OnboardingMapperTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/view/OnboardingPageUiDataTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelTest.kt"], "git_node": "a866934ee3cf8ebc7b53e1cdbb8d2a3c328d8d28", "git_parents": ["4109941a3e29d8f3be5805f4fd0c7a7f6daee7df"], "node": "2c75cc88bb0aab363c4ee64e8073e81e8d5d1f2d", "parents": ["6b283e51fa6777e1d40bc21dd77b577f01bc48f1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083389 - Suppress Fenix lint findings that are intentional. r=android-reviewers,mcarare\n\nBeta and release keep sharedUserId for every install, as the comment beside it explains (bug 2083368 covers\nsharedUserMaxSdkVersion), and ProfilerProvider is exported only in Nightly and checks its caller itself.\nic_print is named by the Nimbus printing microsurvey message, and the Firefox Labs test strings are looked up\nby name for Nimbus labs, so lint cannot see their uses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334898\n", "files": ["mobile/android/fenix/app/src/beta/AndroidManifest.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_print.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/nightly/AndroidManifest.xml", "mobile/android/fenix/app/src/release/AndroidManifest.xml"], "git_node": "8845fe756d45a675bfeaf69e48e859342db10856", "git_parents": ["a866934ee3cf8ebc7b53e1cdbb8d2a3c328d8d28"], "node": "ecd89759b2e412a91e2bce3727236490268e72c6", "parents": ["2c75cc88bb0aab363c4ee64e8073e81e8d5d1f2d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079259 - Take stream from base channel r=nika,necko-reviewers,dom-worker-reviewers,kershaw,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334066\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/InterceptedHttpChannel.cpp"], "git_node": "d4a877c66be3aeba7b0881fd81a304573ded1ca3", "git_parents": ["8845fe756d45a675bfeaf69e48e859342db10856"], "node": "62d4c618eb93a2db9407465948161ce176e90a11", "parents": ["ecd89759b2e412a91e2bce3727236490268e72c6"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079259 - Make DecryptingInputStream serialization safe after the inner stream is closed r=nika,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334067\n", "files": ["dom/quota/DecryptingInputStream.cpp", "dom/quota/DecryptingInputStream_impl.h", "dom/quota/test/gtest/TestEncryptedStream.cpp", "ipc/glue/InputStreamParams.ipdlh"], "git_node": "061bc48b8776ca660c31c2dbd47f2ad544b5b47d", "git_parents": ["d4a877c66be3aeba7b0881fd81a304573ded1ca3"], "node": "42a211f2a9c0157e0d2d517f5ae12a61eb230cd5", "parents": ["62d4c618eb93a2db9407465948161ce176e90a11"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079259 - test r=necko-reviewers,dom-worker-reviewers,kershaw,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334068\n", "files": ["testing/web-platform/mozilla/tests/fetch/api/request/request-stream-service-worker.h2.html", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-service-worker.js"], "git_node": "d4b4f6271065bb077b3f4eb2c7b404e7cf94d899", "git_parents": ["061bc48b8776ca660c31c2dbd47f2ad544b5b47d"], "node": "c479731130e21a2f44931cf6452efe270c4d4413", "parents": ["42a211f2a9c0157e0d2d517f5ae12a61eb230cd5"], "tags": []}, {"author": "daviddurfee \u003cdavid@anonymco.com\u003e", "branch": "default", "desc": "Bug 2079019 - Route sponsored top sites telemetry to the newtab-content ping when score-based selection is enabled. r=mconley,bbirdsong\n\nScore-based selection chooses sponsored top sites using browsing history, so\ntheir telemetry must not be linkable to the client, like the share of voice\nfrecency boosting. Rename sovEnabled to isPlacesInfluenced to cover both.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335025\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "d0aa01b5e9123e3648e8246f79364d8fd1f85224", "git_parents": ["d4b4f6271065bb077b3f4eb2c7b404e7cf94d899"], "node": "07a52349f5b14c31a176198834b11d7cc75aa0d2", "parents": ["c479731130e21a2f44931cf6452efe270c4d4413"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081196 - Include nsMacUtilsImpl.h on macOS builds without the sandbox. r=ipc-reviewers,nika\n\nBug 1950310 added a call to nsMacUtilsImpl::GetExecutablePathFromBundle in GeckoChildProcessHost.cpp that is not guarded by MOZ_SANDBOX, but the header was only included when MOZ_SANDBOX was defined, so --disable-sandbox builds failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335336\n", "files": ["ipc/glue/GeckoChildProcessHost.cpp"], "git_node": "6fab1b30f07392c12923fc822f7a23094f809770", "git_parents": ["d0aa01b5e9123e3648e8246f79364d8fd1f85224"], "node": "ea612448b4c7c5f73c7c4b75bbe3ef602e98d921", "parents": ["07a52349f5b14c31a176198834b11d7cc75aa0d2"], "tags": []}, {"author": "def00111 \u003ckernp@gmx.de\u003e", "branch": "default", "desc": "Bug 2078266 - Refactor PDF printer detection to use an array of prefixes. r=win-reviewers,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330786\n", "files": ["widget/windows/nsDeviceContextSpecWin.cpp"], "git_node": "db35c4f548d2ea09ec