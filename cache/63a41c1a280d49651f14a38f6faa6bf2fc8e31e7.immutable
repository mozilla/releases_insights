ed", "desc": "No bug - Tagging c87b810aa1f3f79bc24bc4294061826c24051448 with DEVEDITION_159_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4ba390331577bce217ce6e4eebcdcfe4922ff5b6", "git_parents": ["841567e2918fe15ea13388d9728a510136b39bdb"], "node": "5b16428a1ed07983ec124099e410195c4949280e", "parents": ["3d175a1d248687833d0a746abd6f472c3f658db3"], "tags": []}], "date": 1792167747, "git_changesets": ["4ba390331577bce217ce6e4eebcdcfe4922ff5b6"], "user": "ffxbld@lando.moz.tools"}, "45577": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging c87b810aa1f3f79bc24bc4294061826c24051448 with FIREFOX_159_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0dd3fa218003a13a22e83363ce6306d5eb1c51dd", "git_parents": ["4ba390331577bce217ce6e4eebcdcfe4922ff5b6"], "node": "7a3f241513d33798aa15c100ccc6d004041d2216", "parents": ["5b16428a1ed07983ec124099e410195c4949280e"], "tags": []}], "date": 1792168068, "git_changesets": ["0dd3fa218003a13a22e83363ce6306d5eb1c51dd"], "user": "ffxbld@lando.moz.tools"}, "45578": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic newtab version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/extensions/newtab/manifest.json"], "git_node": "286c182fc6bcb1fb873d5684519e7e4e3e542c8e", "git_parents": ["0f89b57864c7fecffd873697a6bda30b162070df"], "node": "5b238be4f3c25e29659b4622cd017efdec926268", "parents": ["48c02039d8a76b90aba637c0db639fd1982c87d3"], "tags": []}], "date": 1792177025, "git_changesets": ["286c182fc6bcb1fb873d5684519e7e4e3e542c8e"], "user": "ffxbld@lando.moz.tools"}, "45579": {"changesets": [{"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2081007 - add smart page message when sidebar is empty and tab is on smart page r=jlewis,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333985\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_sidebar.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "b730d175decd65a69fe3ce582b8a1b1c0d6dc96a", "git_parents": ["0f89b57864c7fecffd873697a6bda30b162070df"], "node": "21810c56f33e23741d3f7a8284477de22c4b728a", "parents": ["48c02039d8a76b90aba637c0db639fd1982c87d3"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1730261 - Mark urlbar clipboard writes as sensitive in private windows r=timhuang,urlbar-reviewers,Standard8\n\nPass nsIClipboardHelper.Sensitive when copying from the urlbar in a\nprivate window so downstream consumers (OS clipboard managers, sync,\ncloud clipboard) can skip retention. Applies to both UrlbarInput.mjs\nand the temporarily forked SmartbarInput.mjs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291560\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "7fff04f1fe5b6839df7e289f8eae87d034cca907", "git_parents": ["b730d175decd65a69fe3ce582b8a1b1c0d6dc96a"], "node": "9bb743afee64a1a1b1284a58545b58488b53e50b", "parents": ["21810c56f33e23741d3f7a8284477de22c4b728a"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2079681 - no need to notify about text node changes when notifications are suspended, r=hsivonen\n\nThis brings back the generic check from bug 1882417, but still keeps the fix for bug 1883138\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333890\n", "files": ["dom/base/MutationObservers.cpp"], "git_node": "2f2d052fb8b8f7a2737e6391c545c3f59c6b14f3", "git_parents": ["7fff04f1fe5b6839df7e289f8eae87d034cca907"], "node": "0dde67abfb652f96383c646408f7d53bcef9cb0f", "parents": ["9bb743afee64a1a1b1284a58545b58488b53e50b"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082061 - Hold a strong reference to the document in media and image stream listeners. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334055\n", "files": ["dom/html/ImageDocument.cpp", "dom/html/MediaDocument.cpp"], "git_node": "b3d830a931b8b192bf0446490f6131c001b78a16", "git_parents": ["2f2d052fb8b8f7a2737e6391c545c3f59c6b14f3"], "node": "b76cd4bf749fa30ea5a4c15d3476dbbf4ff474c5", "parents": ["0dde67abfb652f96383c646408f7d53bcef9cb0f"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082563 - Add search-config-v3 to the remote settings dumps. r=remote-settings-reviewers,leplatrem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334215\n", "files": ["services/settings/dumps/main/moz.build", "services/settings/dumps/main/search-config-v3.json", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": "9d30d7ef893faf39781600c57f78b4155515372d", "git_parents": ["b3d830a931b8b192bf0446490f6131c001b78a16"], "node": "2eb5229127ea38f6a483d1612487eedc2bc93467", "parents": ["b76cd4bf749fa30ea5a4c15d3476dbbf4ff474c5"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063288 - Create tests specific to search-config-v3. r=jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331660\n", "files": ["toolkit/components/search/SearchEngineSelector.sys.mjs", "toolkit/components/search/tests/xpcshell/searchconfigs/head_searchconfig.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_distributions.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_searchconfig.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_searchconfig_google_additional.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_searchconfig_validates.js"], "git_node": "d8bb18cd8107ddd0185930227d0c5f7e42a63e57", "git_parents": ["9d30d7ef893faf39781600c57f78b4155515372d"], "node": "ab8e88cf5ce4f051365221c498bd9c03c48ab0b2", "parents": ["2eb5229127ea38f6a483d1612487eedc2bc93467"], "tags": []}, {"author": "aurora \u003caurora@starsinthesky.ca\u003e", "branch": "default", "desc": "Bug 2074269 - Share setDesktopBackground image saving code between different ShellService implementations. r=nrishel,emilio,mac-reviewers,tschuster,bradwerth\n\n- On Windows and Linux, this previously used synchronous I/O to write the\n  file. On macOS, it might've been asynchronous, but it went through\n  nsIWebBrowserPersist, which is more complicated than it needs to be. Now,\n  the I/O is done asynchronously via IOUtils.\n\n- Every platform had a different strategy for placing the file:\n\n    * Windows used %APPDATA%\\Mozilla\\Firefox\\Desktop Background.bmp\n    * macOS used Pictures/\u003cimage filename\u003e\n    * Linux used $HOME/Firefox_wallpaper.png\n\n  Given that none of the platforms actually care about the location, just\n  use Windows', since then it isn't in the way of the user. (e.g. on my\n  Linux box, this'd use `~/.mozilla/firefox/Desktop Background.png`.)\n\n- Windows apparently used BMP to support Windows 7; since Firefox doesn't\n  support that anymore, just use PNG, which lets us remove WriteBitmap.\n  macOS would use whatever, and it will use PNG now too for consistency.\n\nRemoving the usage of nsIWebBrowserPersist was actually my main motivation\nfor this patch; in looking into MHTML saving, I want to minimize the number\nof places I have to think about. But this also removes a bunch of\nsynchronous I/O and code duplication/differences between platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328188\n", "files": ["browser/components/shell/ShellService.sys.mjs", "browser/components/shell/content/setDesktopBackground.js", "browser/components/shell/nsGNOMEShellService.cpp", "browser/components/shell/nsIShellService.idl", "browser/components/shell/nsMacShellService.h", "browser/components/shell/nsMacShellService.mm", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/test/browser_1119088.js", "browser/components/shell/test/browser_420786.js", "browser/locales/en-US/browser/setDesktopBackground.ftl"], "git_node": "0563ee177d75337644c3d4e011ac418a8b30ae1b", "git_parents": ["d8bb18cd8107ddd0185930227d0c5f7e42a63e57"], "node": "75e534e2568ae5255ea625d68842c988e6f7d30b", "parents": ["ab8e88cf5ce4f051365221c498bd9c03c48ab0b2"], "tags": []}, {"author": "aurora \u003caurora@starsinthesky.ca\u003e", "branch": "default", "desc": "Bug 2074269 - Post: Don't compute or pass around imageName for setDesktopBackground. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328189\n", "files": ["browser/actors/ContextMenuChild.sys.mjs", "browser/base/content/nsContextMenu.sys.mjs", "browser/components/shell/content/setDesktopBackground.js"], "git_node": "2f9290cc681f1c7be9936a34539cbcb7753bd870", "git_parents": ["0563ee177d75337644c3d4e011ac418a8b30ae1b"], "node": "25f338c586f0e6b0c95ac6eb7b0adde2ed463234", "parents": ["75e534e2568ae5255ea625d68842c988e6f7d30b"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081809 - Do not create a console window for the notification helper in release builds r=iholmes,hsohaney,application-update-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334126\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/main.rs"], "git_node": "4f18fee84d767c8508b7349d144d459d394d0cc3", "git_parents": ["2f9290cc681f1c7be9936a34539cbcb7753bd870"], "node": "36db3b4afe6b4f8cbe7e394b04f740a56db5be28", "parents": ["25f338c586f0e6b0c95ac6eb7b0adde2ed463234"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081776 - Create new verifyTheTabStripTabsCounterShortcutMenuCloseTabTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=106172\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=105394\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334064\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/NavigationToolbarTest.kt"], "git_node": "82aa0ebae07de5e25d5900399499b2f9d43ba6ab", "git_parents": ["4f18fee84d767c8508b7349d144d459d394d0cc3"], "node": "e3cfb002faa9747e37567e336af568a416ca0eca", "parents": ["36db3b4afe6b4f8cbe7e394b04f740a56db5be28"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081007 - add smart page message when sidebar is empty and tab is on smart page r=jlewis,fluent-reviewers,bolsson\" for causing bc tests failures\n\nThis reverts commit b730d175decd65a69fe3ce582b8a1b1c0d6dc96a.\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_sidebar.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "a7f302debd8c12ee63772295893957d565d602d7", "git_parents": ["82aa0ebae07de5e25d5900399499b2f9d43ba6ab"], "node": "53689f27f754c95e4dc6e41e3c8d3ea732e57bdb", "parents": ["e3cfb002faa9747e37567e336af568a416ca0eca"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2069138 - pt1. Reserve space for DebugModeOSR points in the Baseline JIT r=jandem,iain\n\nBaselineDebugModeOSR may redirect execution in a live Baseline frame to\neither a new BaselineScript or to the BaselineInterpreter. This is\ncurrently done by directly modifying the return address on the stack.\n\nThis commit introduces space for DebugModeOSR points similar to OSI points in Ion\n(adding NOPs where required) after each call that DebugModeOSR may use to redirect\ncontrol to the new intended code when debugging is toggled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323694\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineJIT.h", "js/src/jit/none/Assembler-none.h", "js/src/jit/wasm32/Assembler-wasm32.h"], "git_node": "8535b6496be7f82f041cea5f314fe2ae191c5319", "git_parents": ["a7f302debd8c12ee63772295893957d565d602d7"], "node": "0090b29e8e7636f1127d862982eeac226a5968ea", "parents": ["53689f27f754c95e4dc6e41e3c8d3ea732e57bdb"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2069138 - pt2. Preserve BaselineDebugModeOSR return sites in JitRuntime r=jandem,iain\n\nWhen BaselineDebugModeOSR needs to redirect the execution of a BaselineScript\nthat has live frames, we preserve the old JitCode and RetAddrEntry in the JitRuntime.\nThis allows control to return to this frame normally and then be redirected to the\nupdated target via a patched DebugModeOSR point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323695\n", "files": ["js/src/gc/RootMarking.cpp", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineFrame.h", "js/src/jit/BaselineJIT.h", "js/src/jit/Ion.cpp", "js/src/jit/JSJitFrameIter.cpp", "js/src/jit/JitRuntime.h"], "git_node": "b9717c7937d971bf3f5680c66d92d1e79c01a97d", "git_parents": ["8535b6496be7f82f041cea5f314fe2ae191c5319"], "node": "267f59f99bbca045ef7e0491c78a6aa463a80614", "parents": ["0090b29e8e7636f1127d862982eeac226a5968ea"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2069138 - pt3. Add DebugModeOSREpilogue to BaselineScript along with a handler trampoline r=jandem,iain\n\nEach BaselineScript has an out-of-line DebugModeOSREpilogue that calls the BaselineDebugModeOSRHandler\ntrampoline stub. The handler dispatches to a VM function to resolve the correct resume address for the\nparticular return site. It also releases its reference to the preserved return site metadata in the JitRuntime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323696\n", "files": ["js/src/jit/ABIFunctionList-inl.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineDebugModeOSR.h", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h", "js/src/jit/Ion.cpp", "js/src/jit/JitRuntime.h", "js/src/jit/Trampoline.cpp"], "git_node": "531ff4e68f39cbf5d9ff540c2599287592dec417", "git_parents": ["b9717c7937d971bf3f5680c66d92d1e79c01a97d"], "node": "0d4b0262868c1338879106c331d873012770d0b0", "parents": ["267f59f99bbca045ef7e0491c78a6aa463a80614"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2069138 - pt4. Patch DebugModeOSR points for return sites r=jandem,iain\n\nThe first time a new DebugModeOSR return site is added, the corresponding\npatch point is turned into a call to the BaselineScript's DebugModeOSR epilogue.\nWe additionally release any return-site references held by BaselineFrames skipped/unwound\nover during exception handling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323697\n", "files": ["js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/JitFrames.cpp", "js/src/jit/VMFunctions.cpp"], "git_node": "1b450a0f2df747887162b877c561421e89df65dc", "git_parents": ["531ff4e68f39cbf5d9ff540c2599287592dec417"], "node": "0b5015e842617b43dca977314b79d8366981cf6f", "parents": ["0d4b0262868c1338879106c331d873012770d0b0"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2069138: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/jit/Trampoline.cpp"], "git_node": "a50dbda4d09a62caba2834d6f4237d4b9a7ef019", "git_parents": ["1b450a0f2df747887162b877c561421e89df65dc"], "node": "8c00fb63d36db3d975f6067cd3de95d806f7047a", "parents": ["0b5015e842617b43dca977314b79d8366981cf6f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082064. r=layout-reviewers,dshin\n\nThe crashtest only crashes on ASAN builds but works.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334529\n", "files": ["layout/generic/MiddleCroppingBlockFrame.cpp", "testing/web-platform/tests/html/rendering/widgets/file-type-label-update-crash.https.html"], "git_node": "00484f32e8fb26b561e470d6bc73b4c396b4ebcf", "git_parents": ["a50dbda4d09a62caba2834d6f4237d4b9a7ef019"], "node": "dac7a57faa631ed404c2bb1f5959b7899054f44a", "parents": ["8c00fb63d36db3d975f6067cd3de95d806f7047a"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082265 - Part 1: Don't wait on the media engine CDM process for support queries without a media engine id. r=aosmond,media-playback-reviewers\n\nThe media engine CDM process only creates decoders for media engine playback so it can't affect the answer to those queries. Waiting on it means a launch that never completed leaves them pending forever.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334527\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp"], "git_node": "9bc9e77ab055feaa36be58eac8d010d6a44017a8", "git_parents": ["00484f32e8fb26b561e470d6bc73b4c396b4ebcf"], "node": "9473c92d8d72c5e174f7ba7c6417936d677453ff", "parents": ["dac7a57faa631ed404c2bb1f5959b7899054f44a"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082265 - Part 2: Restore the pre-bug 2051510 WPT expectations for strict-mode HEVC support on Windows. r=media-playback-reviewers,aosmond\n\nWithout the wait on the media engine CDM process, strict-mode HEVC support on Windows again depends on whether that process has reported.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334540\n", "files": ["testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini"], "git_node": "4d7a9fb2c0b293adcdd07a26471d29f527bc97ef", "git_parents": ["9bc9e77ab055feaa36be58eac8d010d6a44017a8"], "node": "e25cda7be6928b4644ee4d4d16fe44192dae109f", "parents": ["9473c92d8d72c5e174f7ba7c6417936d677453ff"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082509 - Let New Tab multistage messages wait for the migration wizard to close. r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334178\n", "files": ["browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content/asrouter-admin.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/modules/ASRouterParentProcessMessageHandler.sys.mjs", "browser/components/asrouter/modules/ActorConstants.mjs", "browser/components/asrouter/tests/unit/ASRouterParentProcessMessageHandler.test.js"], "git_node": "1465929a515a1c9ba598f611affe4ae84789a05f", "git_parents": ["4d7a9fb2c0b293adcdd07a26471d29f527bc97ef"], "node": "8b02eccc3295da40821e63fc20550a42224c182f", "parents": ["e25cda7be6928b4644ee4d4d16fe44192dae109f"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082514 - Allow SHOW_MIGRATION_WIZARD to open the migration wizard as a tab-modal dialog. r=migration-reviewers,omc-reviewers,desktop-theme-reviewers,emilio,emcminn,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334179\n", "files": ["browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/content/migration-dialog-window.js", "browser/themes/shared/migration/migration-dialog-window.css", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_show_migration_wizard.js"], "git_node": "0883f432075dc9b2336177e2fed25055b38ee8d3", "git_parents": ["1465929a515a1c9ba598f611affe4ae84789a05f"], "node": "a37e764b66c5ab27ff9970c1a16013a051d12184", "parents": ["8b02eccc3295da40821e63fc20550a42224c182f"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077206 - Extract \u003csidebar-panel-header\u003e to a single element displayed over sidebar panels r=sidebar-reviewers,desktop-theme-reviewers,credential-management-reviewers,places-reviewers,kcochrane,sfoster,mtigley\n\nPanels no longer need to maintain their own instance of `\u003csidebar-panel-header\u003e`.\n\n`SidebarController` manages the shared header, and updates its `view` property whenever a panel is shown. The header then shares its property with its child switcher. Thus, the switcher no longer needs to maintain event listeners to track the active view.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332629\n", "files": ["browser/base/content/browser-box.inc.xhtml", "browser/base/content/webext-panels.js", "browser/base/content/webext-panels.xhtml", "browser/components/places/content/bookmarksSidebar.js", "browser/components/places/content/bookmarksSidebar.xhtml", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/sidebar-customize.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/sidebar-panel-header.css", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/sidebar-panel-switcher.mjs", "browser/components/sidebar/sidebar-syncedtabs.mjs", "browser/components/sidebar/sidebar.css", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_hide_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_header.js", "browser/themes/shared/places/sidebar.css", "browser/themes/shared/sidebar.css", "toolkit/components/satchel/megalist/content/MegalistAlpha.mjs", "toolkit/components/satchel/megalist/content/megalist.css"], "git_node": "d1c9ac15bd7ce9e19562b7b9867a165936fb3f9f", "git_parents": ["0883f432075dc9b2336177e2fed25055b38ee8d3"], "node": "2e493f179fc9e1693b82a388abed4d730ffc01a8", "parents": ["a37e764b66c5ab27ff9970c1a16013a051d12184"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2006225 - Adjust bookmark sidebar test for browser_documentnavigation.js r=sidebar-reviewers,sfoster\n\nThis bug no longer reproduces when using a shared header/switcher instance, so the workaround actually causes the test to _fail_ now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332902\n", "files": ["browser/base/content/test/browser-general/browser_documentnavigation.js"], "git_node": "173f98c446d388eef230f69163d3def0395b7a7d", "git_parents": ["d1c9ac15bd7ce9e19562b7b9867a165936fb3f9f"], "node": "3620058c464eee4f0437902248623210a30bdbce", "parents": ["2e493f179fc9e1693b82a388abed4d730ffc01a8"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076794 - Rewire AI Chatbot to use the shared switcher instance. r=desktop-theme-reviewers,sidebar-reviewers,yjamora,akulyk,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332903\n", "files": ["browser/components/genai/chat.css", "browser/components/genai/chat.html", "browser/components/genai/chat.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/themes/shared/sidebar.css"], "git_node": "66567b3160e13f29c623cacc5288343b952272c8", "git_parents": ["173f98c446d388eef230f69163d3def0395b7a7d"], "node": "eedab65d12f1b14a8e3e873379a3938051b803ac", "parents": ["3620058c464eee4f0437902248623210a30bdbce"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 1804556 - Let Focus receive new-window custom tab intents from itself r=mcarare,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334397\n", "files": ["mobile/android/focus-android/app/src/main/AndroidManifest.xml", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/session/IntentProcessorTest.kt"], "git_node": "27369e881ae8db8788720b240aa8828493603a52", "git_parents": ["66567b3160e13f29c623cacc5288343b952272c8"], "node": "2164fda5b17a69d34dc283f0f41f81c7b90e6c19", "parents": ["eedab65d12f1b14a8e3e873379a3938051b803ac"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 1804556 - Open new window requests from Focus custom tabs in a new custom tab r=mcarare,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334398\n", "files": ["mobile/android/focus-android/app/src/androidTest/assets/windowOpen.html", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/CustomTabTest.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/CustomTabRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/helpers/TestAssetHelper.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt"], "git_node": "8410f6300a53b73f0abf0222a64647b2b5bab545", "git_parents": ["27369e881ae8db8788720b240aa8828493603a52"], "node": "8a705b062e3e233075c3effc3b5f507659c0b504", "parents": ["2164fda5b17a69d34dc283f0f41f81c7b90e6c19"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081719 - Create new verifySuggestedStrongPasswordDoesNotChangeTest and verifyUpdatePromptForGeneratedPasswordTest regression UI tests r=aaronmt\n\nThe UI tests successfully passed 25x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=105298\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=105296\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333678\n", "files": ["mobile/android/fenix/app/src/androidTest/assets/pages/signupForm.html", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/TestAssetHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiElement.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/LoginsTest.kt"], "git_node": "36a2a2684602940b923e7e7c1aecdb33f13ffe46", "git_parents": ["8410f6300a53b73f0abf0222a64647b2b5bab545"], "node": "a4c81772a44f3a7b6578feab51992eefb8d9000a", "parents": ["8a705b062e3e233075c3effc3b5f507659c0b504"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079355 - Size a cropped mini window's layout viewport from the tab's innerWidth/innerHeight. r=emilio\n\nThe layout viewport override was taken from the tab's clientWidth/clientHeight,\nwhich already exclude the root scrollbars. With non-overlay scrollbars the page\nthen reserved them again inside the override, so it was laid out a scrollbar\nnarrower than in the tab and the crop drifted. innerWidth/innerHeight include\nthe scrollbars, so the page keeps the layout it was cropped at.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331768\n", "files": ["browser/actors/ScreenshotsComponentChild.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs"], "git_node": "74c81fa2a38e0c1b312c505a25d65a14962f9229", "git_parents": ["36a2a2684602940b923e7e7c1aecdb33f13ffe46"], "node": "00e8e69bc7d941add8af826c537de413a7ac38ab", "parents": ["a4c81772a44f3a7b6578feab51992eefb8d9000a"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074676 - Enable mini window and badge their menu items as beta. r=mconley,tabbrowser-reviewers,dao,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328871\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-contextMenu/browser_contextmenu.js", "browser/base/content/test/browser-contextMenu/browser_contextmenu_input.js", "browser/components/customizableui/test/browser_1089591_still_customizable_after_reset.js", "browser/components/miniwindow/moz.build", "browser/components/miniwindow/test/browser/browser_overlap.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/locales-preview/miniWindow.ftl", "browser/locales/en-US/browser/browserContext.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "8bb4cc0f855f3e7a8f6da06a9fbbe2b764550ad4", "git_parents": ["74c81fa2a38e0c1b312c505a25d65a14962f9229"], "node": "ae839278c3cdbdb821bb791f7cd739bdef212642", "parents": ["00e8e69bc7d941add8af826c537de413a7ac38ab"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074676 - Graduate preview strings for miniWindow. r=mconley,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329626\n", "files": ["browser/base/content/browser.xhtml", "browser/base/content/webext-panels.xhtml", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/locales-preview/miniWindow.ftl", "browser/locales/en-US/browser/miniWindow.ftl", "browser/locales/jar.mn"], "git_node": "a1064775351639c4b6dcee716e27dc3ce7e94ca2", "git_parents": ["8bb4cc0f855f3e7a8f6da06a9fbbe2b764550ad4"], "node": "f10c083e42dad603c2756eefeebebfe349ff472f", "parents": ["ae839278c3cdbdb821bb791f7cd739bdef212642"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078935 - handle multiple tab selections when moving to mini window. r=mconley,fluent-reviewers,tabbrowser-reviewers,dao,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331446\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/test/browser/browser_overlap.js", "browser/components/miniwindow/test/browser/browser_pop_tab.js", "browser/components/miniwindow/test/browser/head.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/content/tabsplitview.mjs", "browser/components/tabbrowser/metrics.yaml", "browser/locales/en-US/browser/miniWindow.ftl"], "git_node": "75931a4392cc7421c5f36c4d22c6f8447f0d9e44", "git_parents": ["a1064775351639c4b6dcee716e27dc3ce7e94ca2"], "node": "be5bceb8eabf961c18db3c24ed3700b7725cf225", "parents": ["f10c083e42dad603c2756eefeebebfe349ff472f"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081818, don't use ML for autofill when a form is not valid, r=dimi,credential-management-reviewers\n\nThis avoids the need to initialize the ML inference engine or download the model if the form will not use autocomplete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333816\n", "files": ["browser/extensions/formautofill/test/browser/browser_ml_heuristics.js", "toolkit/components/formautofill/FormAutofillParent.sys.mjs"], "git_node": "1227def1ead1c725ab7cefc48c3844a6bb37edd6", "git_parents": ["75931a4392cc7421c5f36c4d22c6f8447f0d9e44"], "node": "d8379869ecdf22f52764ef9f4f08d8c26289980c", "parents": ["be5bceb8eabf961c18db3c24ed3700b7725cf225"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2082112 - batch updates before adding or removing switch children r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334491\n", "files": ["dom/svg/SVGSwitchElement.cpp", "testing/web-platform/tests/svg/struct/scripted/switch_reentrant_removal.html"], "git_node": "0a4a573472d1d44a72e3c563be3cd1334a1fa476", "git_parents": ["1227def1ead1c725ab7cefc48c3844a6bb37edd6"], "node": "9442a6d8ebcc1a1d5cffa3474e310f6761dba570", "parents": ["d8379869ecdf22f52764ef9f4f08d8c26289980c"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082514, Bug 2082509 - Allow SHOW_MIGRATION_WIZARD to open the migration wizard as a tab-modal dialog. r=migration-reviewers,omc-reviewers,desktop-theme-reviewers,emilio,emcminn,mconley\" for causing bc and TV tests failures at SpecialMessageAction\n\nThis reverts commit 0883f432075dc9b2336177e2fed25055b38ee8d3.\n\nRevert \"Bug 2082509 - Let New Tab multistage messages wait for the migration wizard to close. r=omc-reviewers,emcminn\"\n\nThis reverts commit 1465929a515a1c9ba598f611affe4ae84789a05f.\n", "files": ["browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content/asrouter-admin.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/modules/ASRouterParentProcessMessageHandler.sys.mjs", "browser/components/asrouter/modules/ActorConstants.mjs", "browser/components/asrouter/tests/unit/ASRouterParentProcessMessageHandler.test.js", "browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/content/migration-dialog-window.js", "browser/themes/shared/migration/migration-dialog-window.css", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_show_migration_wizard.js"], "git_node": "e7693eedf2e9b785d997e4de4217e9f782c8c052", "git_parents": ["0a4a573472d1d44a72e3c563be3cd1334a1fa476"], "node": "2251fbd7baba7090923cbdf0863b0d1abdd5fb36", "parents": ["9442a6d8ebcc1a1d5cffa3474e310f6761dba570"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082064 - Remove the right class from crashtest.\n", "files": ["testing/web-platform/tests/html/rendering/widgets/file-type-label-update-crash.https.html"], "git_node": "11474824a0a743422b73733236048b9404ce3827", "git_parents": ["e7693eedf2e9b785d997e4de4217e9f782c8c052"], "node": "e0621291b7d94b52b36b486aead3588ac046916d", "parents": ["2251fbd7baba7090923cbdf0863b0d1abdd5fb36"], "tags": []}, {"author": "daviddurfee \u003cdavid@anonymco.com\u003e", "branch": "default", "desc": "Bug 2081929 - Serialize sponsored score refreshes and clearing with an exclusive lock. r=mconley,bbirdsong\n\nA refresh could start while clearData() was waiting on the cache, then write\nthe score history back after it was cleared. Run refreshes and clears under\nthe same Web Locks API lock so that only one runs at a time. A refresh that\nwaits behind a clear then sees the restarted release interval and writes\nnothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334315\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js"], "git_node": "95dea7de136ef78aa7cedf937e71ebc8819bd8c0", "git_parents": ["11474824a0a743422b73733236048b9404ce3827"], "node": "3dff1268c582072bab762dfcd251ee3ac29294ca", "parents": ["e0621291b7d94b52b36b486aead3588ac046916d"], "tags": []}, {"author": "Brendan Birdsong \u003cbbirdsong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082690 - Add debug logs to SponsoredTopSitesScoreProvider. r=ddurfee,mconley\n\nDepends on D334315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334344\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs"], "git_node": "cb4d1c256ab02d163d9912afc12ef055f333d840", "git_parents": ["95dea7de136ef78aa7cedf937e71ebc8819bd8c0"], "node": "50bc7b6c794d7a0a5608b2b3c399dadd83165caf", "parents": ["3dff1268c582072bab762dfcd251ee3ac29294ca"], "tags": []}, {"author": "Mitchell Plyler \u003cmlplyler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080227 - Add location-based initialization for inferred interests, plumbing only. r=thecount\n\n[HNT-3534]\n\nDesign Doc: https://mozilla-hub.atlassian.net/wiki/spaces/FAAMT/pages/3126133346/Location+Based+Initialization+for+Inferred\n\nThis is a plumbing only patch for using location based topic interests. The ping for location and location based interest computation will be in a stacked patch. The idea is to initialize a user's topic interest based on their current locaton. If they start clicking and developing their own topic interests, we will abandon the location-based interests and just use the real interests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332444\n", "files": ["browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/lib/InferredModel/FeatureModel.sys.mjs", "browser/extensions/newtab/lib/InferredPersonalizationFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/DiscoveryStreamFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_InferredPersonalizationFeed.js"], "git_node": "ade8f1d99287169950fecf957b71025e407f163b", "git_parents": ["cb4d1c256ab02d163d9912afc12ef055f333d840"], "node": "283db4ee6f760a65d33cfd66fab8d464bb3065e8", "parents": ["50bc7b6c794d7a0a5608b2b3c399dadd83165caf"], "tags": []}, {"author": "Mitchell Plyler \u003cmlplyler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080944 - Calculate inferred interests based on location. r=thecount,mconley\n\n[HNT-3533]\n\nAdds topic interest grids over the US, pings merino for location, and looks up interests based on a client's location.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332996\n", "files": ["browser/extensions/newtab/data/content/assets/location-interest-grid/topic_grid_100km.bin", "browser/extensions/newtab/data/content/assets/location-interest-grid/topic_grid_10km.bin", "browser/extensions/newtab/data/content/assets/location-interest-grid/topic_grid_1km.bin", "browser/extensions/newtab/data/content/assets/location-interest-grid/topic_grid_25km.bin", "browser/extensions/newtab/data/content/assets/location-interest-grid/topic_grid_50km.bin", "browser/extensions/newtab/data/content/assets/location-interest-grid/topic_grid_bands.json", "browser/extensions/newtab/lib/InferredModel/FeatureModel.sys.mjs", "browser/extensions/newtab/lib/InferredModel/LocationInterestGrid.sys.mjs", "browser/extensions/newtab/lib/InferredPersonalizationFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_InferredFeatureModel.js", "browser/extensions/newtab/test/xpcshell/test_InferredPersonalizationFeed.js", "browser/extensions/newtab/test/xpcshell/test_LocationInterestGrid.js", "browser/extensions/newtab/test/xpcshell/xpcshell.toml"], "git_node": "91f594feca52201174ddb710da7de9a200e0a580", "git_parents": ["ade8f1d99287169950fecf957b71025e407f163b"], "node": "c89e61efcbfe0c82a534f208f0a57c9f1d26b24b", "parents": ["283db4ee6f760a65d33cfd66fab8d464bb3065e8"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080072 - [devtools] Check for default location before sanitizing r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334478\n", "files": ["devtools/client/shared/components/Frame.js", "devtools/client/shared/components/test/chrome/chrome.toml", "devtools/client/shared/components/test/chrome/test_frame_03.html"], "git_node": "bc0e22c04e95751887698a9b8fe8b765fb27f334", "git_parents": ["91f594feca52201174ddb710da7de9a200e0a580"], "node": "d26031e5effb62545631965000b7609ac7a7b01f", "parents": ["c89e61efcbfe0c82a534f208f0a57c9f1d26b24b"], "tags": []}, {"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079741 - Report install type, MSIX package and distribution in the default agent Glean ping. r=hsohaney\n\nThe default-agent ping could not tell Microsoft Store installs from other installs: client_info.distribution.name is only set by TelemetryEnvironment, which the background task does not run. The install values are passed through sendPing so they are only recorded once a ping is due that day; setting them on every run would stop the ping from being empty, and so being skipped, on the other runs.\n\nReading installation_telemetry.json moves into WindowsInstallsInfo, so BrowserUsageTelemetry and the agent share it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332050\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "toolkit/components/utils/WindowsInstallsInfo.sys.mjs", "toolkit/components/utils/test/unit/test_WindowsInstallsInfo.js", "toolkit/components/utils/test/unit/xpcshell.toml", "toolkit/mozapps/defaultagent/BackgroundTask_defaultagent.sys.mjs", "toolkit/mozapps/defaultagent/DefaultAgent.cpp", "toolkit/mozapps/defaultagent/Telemetry.cpp", "toolkit/mozapps/defaultagent/Telemetry.h", "toolkit/mozapps/defaultagent/metrics.yaml", "toolkit/mozapps/defaultagent/nsIDefaultAgent.idl", "toolkit/mozapps/defaultagent/tests/gtest/DefaultAgentTest.cpp", "toolkit/mozapps/defaultagent/tests/xpcshell/test_backgroundtask_defaultagent.js"], "git_node": "af3d2e36568ff167a5c808a4d9f96718c1996529", "git_parents": ["bc0e22c04e95751887698a9b8fe8b765fb27f334"], "node": "363c533f13939a5a801b756760fcd91408be3085", "parents": ["d26031e5effb62545631965000b7609ac7a7b01f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2082235 - Part 1: Add LIRGeneratorShared::useInt64RegisterOrZero() for customizing at-start Int64 allocation. r=yury\n\nNow, the original useInt64RegisterOrZeroAtStart() delegates to the new\nmethod.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333961\n", "files": ["js/src/jit/shared/Lowering-shared-inl.h", "js/src/jit/shared/Lowering-shared.h"], "git_node": "8f13d2420d966d58440f6386fc60941441f5ba38", "git_parents": ["af3d2e36568ff167a5c808a4d9f96718c1996529"], "node": "99964677e116737d57b15b9bf18026106f77fd4b", "parents": ["363c533f13939a5a801b756760fcd91408be3085"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2082235 - [loong64] Part 2: Optimize cases where RHS=0 in MWasmReplaceLaneSimd128. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333962\n", "files": ["js/src/jit-test/tests/wasm/simd/replace-lane-i64-zero-loong64-ion-codegen.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp"], "git_node": "12114e6f035db20bd73fa2bab45234a34e353358", "git_parents": ["8f13d2420d966d58440f6386fc60941441f5ba38"], "node": "840ce807d6486dada344a26f6e91853123f2740b", "parents": ["99964677e116737d57b15b9bf18026106f77fd4b"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071029 - Exclude about:smartpage URLs from history Sync r=mak,sync-reviewers,markh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332583\n", "files": ["services/sync/modules/engines/history.sys.mjs", "services/sync/tests/unit/test_history_store.js", "services/sync/tests/unit/test_history_tracker.js"], "git_node": "8002d3a2d3c47a24bcf75526502a6ed68fffed09", "git_parents": ["12114e6f035db20bd73fa2bab45234a34e353358"], "node": "5555c087b016309a0a19718edf98e0a008f7c699", "parents": ["840ce807d6486dada344a26f6e91853123f2740b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["browser/locales-preview/miniWindow.ftl"], "git_node": "e77c5131fd07ddab0731efab207539f5ae3a00ce", "git_parents": ["286c182fc6bcb1fb873d5684519e7e4e3e542c8e", "8002d3a2d3c47a24bcf75526502a6ed68fffed09"], "node": "b0954e595f191eb415dc31933a9ea941d46ace92", "parents": ["5b238be4f3c25e29659b4622cd017efdec926268", "5555c087b016309a0a19718edf98e0a008f7c699"], "tags": []}], "date": 1792179495, "git_changesets": ["b730d175decd65a69fe3ce582b8a1b1c0d6dc96a", "7fff04f1fe5b6839df7e289f8eae87d034cca907", "2f2d052fb8b8f7a2737e6391c545c3f59c6b14f3", "b3d830a931b8b192bf0446490f6131c001b78a16", "9d30d7ef893faf39781600c57f78b4155515372d", "d8bb18cd8107ddd0185930227d0c5f7e42a63e57", "0563ee177d75337644c3d4e011ac418a8b30ae1b", "2f9290cc681f1c7be9936a34539cbcb7753bd870", "4f18fee84d767c8508b7349d144d459d394d0cc3", "82aa0ebae07de5e25d5900399499b2f9d43ba6ab", "a7f302debd8c12ee63772295893957d565d602d7", "8535b6496be7f82f041cea5f314fe2ae191c5319", "b9717c7937d971bf3f5680c66d92d1e79c01a97d", "531ff4e68f39cbf5d9ff540c2599287592dec417", "1b450a0f2df747887162b877c561421e89df65dc", "a50dbda4d09a62caba2834d6f4237d4b9a7ef019", "00484f32e8fb26b561e470d6bc73b4c396b4ebcf", "9bc9e77ab055feaa36be58eac8d010d6a44017a8", "4d7a9fb2c0b293adcdd07a26471d29f527bc97ef", "1465929a515a1c9ba598f611affe4ae84789a05f", "0883f432075dc9b2336177e2fed25055b38ee8d3", "d1c9ac15bd7ce9e19562b7b9867a165936fb3f9f", "173f98c446d388eef230f69163d3def0395b7a7d", "66567b3160e13f29c623cacc5288343b952272c8", "27369e881ae8db8788720b240aa8828493603a52", "8410f6300a53b73f0abf0222a64647b2b5bab545", "36a2a2684602940b923e7e7c1aecdb33f13ffe46", "74c81fa2a38e0c1b312c505a25d65a14962f9229", "8bb4cc0f855f3e7a8f6da06a9fbbe2b764550ad4", "a1064775351639c4b6dcee716e27dc3ce7e94ca2", "75931a4392cc7421c5f36c4d22c6f8447f0d9e44", "1227def1ead1c725ab7cefc48c3844a6bb37edd6", "0a4a573472d1d44a72e3c563be3cd1334a1fa476", "e7693eedf2e9b785d997e4de4217e9f782c8c052", "11474824a0a743422b73733236048b9404ce3827", "95dea7de136ef78aa7cedf937e71ebc8819bd8c0", "cb4d1c256ab02d163d9912afc12ef055f333d840", "ade8f1d99287169950fecf957b71025e407f163b", "91f594feca52201174ddb710da7de9a200e0a580", "bc0e22c04e95751887698a9b8fe8b765fb27f334", "af3d2e36568ff167a5c808a4d9f96718c1996529", "8f13d2420d966d58440f6386fc60941441f5ba38", "12114e6f035db20bd73fa2bab45234a34e353358", "8002d3a2d3c47a24bcf75526502a6ed68fffed09", "e77c5131fd07ddab0731efab207539f5ae3a00ce"], "user": "imoraru@mozilla.com"}, "45580": {"changesets": [{"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2080582 - Add test to prevent new EXTRA_JS_MODULES added to tree. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332729\n", "files": ["docs/code-quality/lint/linters/extra-js-modules.md", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/extra-js-modules.yml", "tools/lint/extra-js-modules/__init__.py", "tools/lint/extra-js-modules/allowlist.txt", "tools/lint/test/files/extra-js-modules/allowlist.txt", "tools/lint/test/files/extra-js-modules/sub/final/moz.build", "tools/lint/test/files/extra-js-modules/sub/globbed/Globbed.sys.mjs", "tools/lint/test/files/extra-js-modules/sub/globbed/NewGlobbed.sys.mjs", "tools/lint/test/files/extra-js-modules/sub/globbed/moz.build", "tools/lint/test/files/extra-js-modules/sub/moz.build", "tools/lint/test/files/extra-js-modules/sub/nested/moz.build", "tools/lint/test/files/extra-js-modules/sub/nonliteral/moz.build", "tools/lint/test/files/extra-js-modules/sub/targets/moz.build", "tools/lint/test/python.toml", "tools/lint/test/test_extra_js_modules.py"], "git_node": "46f51d4cb12053ebd59beda1704780a89ff6804d", "git_parents": ["8002d3a2d3c47a24bcf75526502a6ed68fffed09"], "node": "0aa021a5d843271678319c692a102bf1ca0104de", "parents": ["5555c087b016309a0a19718edf98e0a008f7c699"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1972602 - Remove legacy enrollment store and disable persistence in tests r=ralkhulaidi,nimbus-reviewers,emcminn,settings-reviewers,Gijs\n\nThe shared SQL database in the ProfilesDatastoreServices has been the\nsource of truth for Nimbus since bug 1972426. However, we've still had\nthe legacy ExperimentDataStore.json to support xpcshell tests that do\nnot enable the ProfilesDatastoreService (see bug 1967779).\n\nBy default we no longer persist experiments to disk when running in a\ntest environment (when `Cu.isInAutomation` is true at startup). This\nremoves the need for keeping the legacy experiment store. Persistence\nis, however, enabled in all toolkit/components/nimbus xpcshell tests to\nensure correctness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322754\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/experimental_features/head.js", "browser/components/urlbar/tests/browser-quickactions/browser_commands.js", "testing/profiles/xpcshell/user.js", "toolkit/components/nimbus/lib/Enrollments.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/ExperimentStore.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/browser/browser_SharedDataMap.js", "toolkit/components/nimbus/test/browser/browser_about_config_pref_change.js", "toolkit/components/nimbus/test/browser/browser_experimentapi_child.js", "toolkit/components/nimbus/test/browser/browser_remotesettings_experiment_enroll.js", "toolkit/components/nimbus/test/browser/head.js", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml", "toolkit/components/nimbus/test/unit/test_ExperimentManager_lifecycle.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_prefs.js", "toolkit/components/nimbus/test/unit/test_ExperimentStore.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_Migrations.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_bug2054546.js", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "d6712d934c77e70eb6de546aed681e82e9213660", "git_parents": ["46f51d4cb12053ebd59beda1704780a89ff6804d"], "node": "1de45affb77a09dd00f0ef4a97f81272f814a037", "parents": ["0aa021a5d843271678319c692a102bf1ca0104de"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081409 - added checks for inference_model when openaiEngine is created r=cgopal,cmurray\n\nWe wish to enable a way of choosing a model for the user when they select \"auto\" from the drop down. Until we have a more complicated\nrouting algorithm, we will always route the the strongest model we currently host (as judged from evals). In order to\nfacilitate this in a way that can evolve along with our model selection, we use Remote Settings to handle the routing.\n\nThis is done by adding an \"auto.json\" record to the \"params dir of \"prompt_v2/features/chat\". This record contains a\nnew attribute \"inference_model\". when the model is choen (with the creating of the openai inference engine), the\nremote settings record is first checked for this new field. if it exists, \"inference_model\"s value will be\nused for the openai inference engine model. Otherwise we will use the default behavior (use the value of\nthe \"model\" field).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333358\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_build_conversation.js"], "git_node": "a8b72f3e90530da7cea7b23d925a89a782a59f3a", "git_parents": ["d6712d934c77e70eb6de546aed681e82e9213660"], "node": "a000eab96bcc0016175ed6de8cf3d18a40fc89f9", "parents": ["1de45affb77a09dd00f0ef4a97f81272f814a037"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030981, part 1 - Implement ECMA{Set|Map} in Gecko. r=edgar,sfink\n\nInsertion-ordered set and map with ECMA-262 iteration semantics: deletion\ntombstones entries, compaction remaps registered iteration cursors, so live\niterators stay valid without pinning memory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292469\n", "files": ["dom/bindings/ECMACollections.h", "dom/bindings/gtest/TestECMACollections.cpp", "dom/bindings/gtest/moz.build", "dom/bindings/moz.build"], "git_node": "cb57527935653bffa4e72aa1f52ea870a937dbb0", "git_parents": ["a8b72f3e90530da7cea7b23d925a89a782a59f3a"], "node": "cd17ddcea94e73fd9c2b24790bc5101da432df25", "parents": ["a000eab96bcc0016175ed6de8cf3d18a40fc89f9"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030981, part 2 - Introduce [DOMBackedStorage] for WebIDL setlike/maplike, provide SetlikeMixin/MaplikeMixin. r=edgar,webidl,sfink,smaug\n\nGenerated add/set/delete/clear/has/get and the size getter call the\nimplementation's mixin methods; forEach and the iterators read the C++ storage\ndirectly. The iterator interfaces inherit from %SetIteratorPrototype% and\n%MapIteratorPrototype%, exposed through JS::GetRealm{Set,Map}IteratorPrototype.\n\nThe iterators are WebIDL objects, so they now work through Xrays like those of\niterable interfaces; the chrome maplike/setlike test is updated accordingly.\nIterating them with for-of over Xrays still needs bug 1023984.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292470\n", "files": ["dom/bindings/Codegen.py", "dom/bindings/Configuration.py", "dom/bindings/ECMACollectionIterator.h", "dom/bindings/ECMACollectionMixin.h", "dom/bindings/moz.build", "dom/bindings/parser/WebIDL.py", "dom/bindings/parser/tests/test_interface_maplikesetlikeiterable.py", "dom/bindings/test/TestInterfaceMaplike.cpp", "dom/bindings/test/TestInterfaceMaplike.h", "dom/bindings/test/TestInterfaceMaplikeObject.cpp", "dom/bindings/test/TestInterfaceMaplikeObject.h", "dom/bindings/test/TestInterfaceSetlike.h", "dom/bindings/test/TestInterfaceSetlikeNode.cpp", "dom/bindings/test/TestInterfaceSetlikeNode.h", "dom/bindings/test/mochitest.toml", "dom/bindings/test/test_bug1123516_maplikesetlikechrome.xhtml", "dom/bindings/test/test_ecma_collection_semantics.html", "dom/webidl/TestInterfaceJSMaplikeSetlikeIterable.webidl", "js/public/Realm.h", "js/src/vm/Realm.cpp"], "git_node": "0a79cca4ed7772b34453d006541e3c16db466f18", "git_parents": ["cb57527935653bffa4e72aa1f52ea870a937dbb0"], "node": "f47b202809d6fc7df7e66b115151601dc72f130a", "parents": ["cd17ddcea94e73fd9c2b24790bc5101da432df25"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1852908, part 1 - Migrate Highlight to SetlikeMixin, remove mRanges. r=edgar,webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D293561\n", "files": ["dom/base/Highlight.cpp", "dom/base/Highlight.h", "dom/webidl/Highlight.webidl", "layout/generic/nsFrameSelection.cpp"], "git_node": "627353e2ccf9e6faf8f3b204d8d7bfb5676215eb", "git_parents": ["0a79cca4ed7772b34453d006541e3c16db466f18"], "node": "0fdaa91474a31183178f86ffbee7f24be2bd5cd0", "parents": ["f47b202809d6fc7df7e66b115151601dc72f130a"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1852908, part 2 - Migrate HighlightRegistry to MaplikeMixin with [DOMBackedStorage], remove mHighlightsOrdered. r=edgar,webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D293562\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_object_inspector_entries.snapshot.mjs", "dom/base/HighlightRegistry.cpp", "dom/base/HighlightRegistry.h", "dom/webidl/HighlightRegistry.webidl", "layout/inspector/InspectorUtils.cpp"], "git_node": "8baccb0ee616bf7bc498a1282d2d36928a106234", "git_parents": ["627353e2ccf9e6faf8f3b204d8d7bfb5676215eb"], "node": "79168f5801535c8eab6143ecd2cdbe9d920727cc", "parents": ["0fdaa91474a31183178f86ffbee7f24be2bd5cd0"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081419 - Recreate the semantic history singleton after JourneyManager test cleanup. r=cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333392\n", "files": ["browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js"], "git_node": "82141dc5570f0d1c9958110072a7db39a2061562", "git_parents": ["8baccb0ee616bf7bc498a1282d2d36928a106234"], "node": "4e9835e707003f5c0cd816e78bce1a903f00e30e", "parents": ["79168f5801535c8eab6143ecd2cdbe9d920727cc"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080582 - Add test to prevent new EXTRA_JS_MODULES added to tree. r=firefox-build-system-reviewers,sergesanspaille\" for causing linting opt failure at EXTRA_JS_MODULES\n\nThis reverts commit 46f51d4cb12053ebd59beda1704780a89ff6804d.\n", "files": ["docs/code-quality/lint/linters/extra-js-modules.md", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/extra-js-modules.yml", "tools/lint/extra-js-modules/__init__.py", "tools/lint/extra-js-modules/allowlist.txt", "tools/lint/test/files/extra-js-modules/allowlist.txt", "tools/lint/test/files/extra-js-modules/sub/final/moz.build", "tools/lint/test/files/extra-js-modules/sub/globbed/Globbed.sys.mjs", "tools/lint/test/files/extra-js-modules/sub/globbed/NewGlobbed.sys.mjs", "tools/lint/test/files/extra-js-modules/sub/globbed/moz.build", "tools/lint/test/files/extra-js-modules/sub/moz.build", "tools/lint/test/files/extra-js-modules/sub/nested/moz.build", "tools/lint/test/files/extra-js-modules/sub/nonliteral/moz.build", "tools/lint/test/files/extra-js-modules/sub/targets/moz.build", "tools/lint/test/python.toml", "tools/lint/test/test_extra_js_modules.py"], "git_node": "973fe6912109188695010623d512a47bfe74da2f", "git_parents": ["82141dc5570f0d1c9958110072a7db39a2061562"], "node": "f189f37a07aab0860e894e007b7d6b189deaad12", "parents": ["4e9835e707003f5c0cd816e78bce1a903f00e30e"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080224 - Documentation for Mini Window. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332508\n", "files": ["browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/MiniWindowUtils.sys.mjs", "browser/components/miniwindow/docs/architecture-diagram.png", "browser/components/miniwindow/docs/cropped-mini-window.png", "browser/components/miniwindow/docs/full-tab-mini-window.png", "browser/components/miniwindow/docs/index.md", "browser/components/miniwindow/docs/mini-window-api.md", "browser/components/miniwindow/docs/selector-diagram.png", "browser/components/miniwindow/moz.build", "browser/docs/index.md", "docs/config.yml"], "git_node": "9053e766b4856698bb75abfb4acdc7e72122b1aa", "git_parents": ["973fe6912109188695010623d512a47bfe74da2f"], "node": "c2a469c07e71dcb9aa042d6037646303839aea50", "parents": ["f189f37a07aab0860e894e007b7d6b189deaad12"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079068 - Resolve the nsIFile on demand in nsStandardURL instead of lazily caching it r=necko-reviewers,valentin\n\nEnsureFile() is replaced by ResolveFile(), which returns a file owned by the\ncaller.  mFile is now only set by SetFile() or by cloning.  Made mFile private\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334365\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/base/nsStandardURL.h", "netwerk/protocol/res/SubstitutingProtocolHandler.cpp", "netwerk/protocol/res/SubstitutingURL.h", "netwerk/test/unit/test_URIs.js"], "git_node": "ffbdff5f0da651597c456c3633bc703d9627d5d4", "git_parents": ["9053e766b4856698bb75abfb4acdc7e72122b1aa"], "node": "6c099baccf518cf4d4b9a9c54e53b0ce0ddf70f4", "parents": ["c2a469c07e71dcb9aa042d6037646303839aea50"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1728612 - Complete pending MediaSource transactions in MediaSource::Detach. r=media-playback-reviewers,azebrowski\n\nHTMLMediaElement::ShutdownDecoder only resolved the MediaSource's pending\ncompletion promises if the element still held mMediaSource. If the element\nwas unlinked by the cycle collector, mMediaSource was cleared while the\nMediaSourceDecoder still referenced the MediaSource, so MediaSource::Detach\nwould hit the release assert on mCompletionPromises being empty. Instead,\nhave MediaSource::Detach complete the pending transactions itself. Also do\nso in the destructor, in case the MediaSource is destroyed before it could\nbe detached.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334373\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediasource/MediaSource.cpp"], "git_node": "8103ea0e7b2b72447f11c21196f2a83a056d3669", "git_parents": ["ffbdff5f0da651597c456c3633bc703d9627d5d4"], "node": "ed6f2f7d1cfb50bde56c241810ac9e305e30b1fe", "parents": ["6c099baccf518cf4d4b9a9c54e53b0ce0ddf70f4"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081969 - Tweak CoalescedInputFlusher::WillRefresh. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334575\n", "files": ["dom/ipc/CoalescedInputData.h", "dom/ipc/CoalescedMouseData.cpp", "dom/ipc/CoalescedTouchData.cpp"], "git_node": "1ee3315053803575d7996d96989f309a2d7f1b31", "git_parents": ["8103ea0e7b2b72447f11c21196f2a83a056d3669"], "node": "24c9fd9c8c12c462e778f29add69d49b501ef7c3", "parents": ["ed6f2f7d1cfb50bde56c241810ac9e305e30b1fe"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Fail live alt-data readers when the alt-data writer fails r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334172\n", "files": ["netwerk/cache2/CacheFile.cpp", "netwerk/cache2/CacheFileChunk.cpp", "netwerk/cache2/CacheFileInputStream.h"], "git_node": "d03c3288bf1a6f27b663ad5900a6e46633e2a45b", "git_parents": ["1ee3315053803575d7996d96989f309a2d7f1b31"], "node": "4dc991daf69b3c3b10754c781892aca8da410af1", "parents": ["24c9fd9c8c12c462e778f29add69d49b501ef7c3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Reject incomplete compressed script bytecode r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334173\n", "files": ["dom/script/ScriptCompression.cpp"], "git_node": "90d68393000787adf5a4be31281c02e38b8b6d5c", "git_parents": ["d03c3288bf1a6f27b663ad5900a6e46633e2a45b"], "node": "40f6ca14c3a053464ff6a221322ec85b03824463", "parents": ["4dc991daf69b3c3b10754c781892aca8da410af1"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Test failed alt-data writes and incomplete compressed bytecode r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334174\n", "files": ["dom/base/test/gtest/TestScriptCompression.cpp", "dom/base/test/gtest/moz.build", "netwerk/test/unit/test_alt-data_failed_write.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "c2818201c6422b38ea3bcbc7bf94ac3639433fbb", "git_parents": ["90d68393000787adf5a4be31281c02e38b8b6d5c"], "node": "e80cd56251f6fa1d49f8c2584b894bb0673103c6", "parents": ["40f6ca14c3a053464ff6a221322ec85b03824463"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2080908 - Let SpeechRecognition and associated interfaces ride the trains. r=media-webspeech-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332949\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "8c6555e06456acfbb4300180d2556deb56b23ffc", "git_parents": ["c2818201c6422b38ea3bcbc7bf94ac3639433fbb"], "node": "cd849c5344f7b63c2d7fbdf2a01dd0f4c110d933", "parents": ["e80cd56251f6fa1d49f8c2584b894bb0673103c6"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2081007 - add smart page message when sidebar is empty and tab is on smart page r=jlewis,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333985\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_sidebar.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "b4bb64637b16d770c60f2afbcdd99fcde9a358f6", "git_parents": ["8c6555e06456acfbb4300180d2556deb56b23ffc"], "node": "ea10a9a1a1880ad8dd76cf35117df260108565cf", "parents": ["cd849c5344f7b63c2d7fbdf2a01dd0f4c110d933"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081848 - Declare the browser window's globals as the members of a BrowserWindow type. r=Standard8\n\nThe globals keep their types; browser-window.d.ts takes those that are not system modules from BrowserWindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333760\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "9512d8d05c50b7baea5476fa823fe97dc8f16ccf", "git_parents": ["b4bb64637b16d770c60f2afbcdd99fcde9a358f6"], "node": "4150d73280a47413fcb7e04e145a93f58a72eeb4", "parents": ["ea10a9a1a1880ad8dd76cf35117df260108565cf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081848 - Type allSplitViews' return value as MozTabSplitViewWrapper[]. r=tabbrowser-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333761\n", "files": ["browser/components/tabbrowser/content/tabs.mjs"], "git_node": "06af8149e92dfd2884b54cbe72c3ce70eec9e850", "git_parents": ["9512d8d05c50b7baea5476fa823fe97dc8f16ccf"], "node": "5f43a79202cacc916596e1dac749ea1265630ab1", "parents": ["4150d73280a47413fcb7e04e145a93f58a72eeb4"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079204 - Declare the browser window globals that Session Restore reads. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333762\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "55eff1bbadbbff5334f8ab1d949c763994bdc9a5", "git_parents": ["06af8149e92dfd2884b54cbe72c3ce70eec9e850"], "node": "e7d6d5f5cae177e3529b951f0d772f025020a2a4", "parents": ["5f43a79202cacc916596e1dac749ea1265630ab1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079204 - Type Session Restore's browser windows as BrowserWindow. r=sessionstore-reviewers,sclements\n\nThe macOS hidden window and getWindowsFragment's window stay typed as Window, since neither is necessarily a browser window. Passing \"about:blank\" to addWebTab is behavior-neutral: addTab replaces a missing URI with it before reading it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333763\n", "files": ["browser/components/sessionstore/RecentlyClosedTabsAndWindowsMenuUtils.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/content/aboutSessionRestore.js", "browser/components/sessionstore/tsconfig.json"], "git_node": "4f1a73f873d1c8f5eaf7396b8f9052797488349d", "git_parents": ["55eff1bbadbbff5334f8ab1d949c763994bdc9a5"], "node": "33a600881aab0e286d8a78f50bf9da807a9628fc", "parents": ["e7d6d5f5cae177e3529b951f0d772f025020a2a4"], "tags": []}, {"author": "Rana Al-Khulaidi \u003cralkhulaidi@gmail.com\u003e", "branch": "default", "desc": "Bug 2059776 - Move about:studies from Normandy to browser/components/nimbus. r=nimbus-reviewers,desktop-theme-reviewers,emilio,beth,frontend-codestyle-reviewers,shtrom\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333669\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/about/AboutRedirector.cpp", "browser/components/moz.build", "browser/components/nimbus/AboutStudies.sys.mjs", "browser/components/nimbus/AboutStudiesChild.sys.mjs", "browser/components/nimbus/AboutStudiesParent.sys.mjs", "browser/components/nimbus/content/about-studies/about-studies.css", "browser/components/nimbus/content/about-studies/about-studies.html", "browser/components/nimbus/content/about-studies/about-studies.js", "browser/components/nimbus/jar.mn", "browser/components/nimbus/moz.build", "browser/components/nimbus/tests/browser/browser.toml", "browser/components/nimbus/tests/browser/browser_about_preferences.js", "browser/components/nimbus/tests/browser/browser_about_studies.js", "browser/components/nimbus/tests/browser/head.js", "eslint-rollouts.config.mjs", "mots.yaml", "stylelint-rollouts.config.js", "toolkit/components/normandy/content/AboutPages.sys.mjs", "toolkit/components/normandy/content/ShieldFrameChild.sys.mjs", "toolkit/components/normandy/content/ShieldFrameParent.sys.mjs", "toolkit/components/normandy/content/about-studies/about-studies.css", "toolkit/components/normandy/content/about-studies/about-studies.html", "toolkit/components/normandy/content/about-studies/about-studies.js", "toolkit/components/normandy/jar.mn", "toolkit/components/normandy/test/browser/browser.toml", "toolkit/components/normandy/test/browser/browser_about_preferences.js", "toolkit/components/normandy/test/browser/browser_about_studies.js", "toolkit/components/normandy/test/browser/head.js"], "git_node": "1b39bed73e3ffa3bca24aaa3f59b227024a32aac", "git_parents": ["4f1a73f873d1c8f5eaf7396b8f9052797488349d"], "node": "7739c7c34fea3777a94c3c111648ba50b16f046c", "parents": ["33a600881aab0e286d8a78f50bf9da807a9628fc"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082875 - [devtools] Remove Nova checks in browser_aboutdebugging_profiler_dialog.js. r=devtools-reviewers,bomsy.\n\nThe pref is going to be locked in Bug 2082898, so setting it to false won't work anymore.\nWe can remove the whole task that was checking that the performance panel is reacting\nto the pref change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334533\n", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_profiler_dialog.js"], "git_node": "81fb8f65c5ef39a61798637c56f3812cfb28a590", "git_parents": ["1b39bed73e3ffa3bca24aaa3f59b227024a32aac"], "node": "b2e552f2167a301a4bec34660c32fd3840b581eb", "parents": ["7739c7c34fea3777a94c3c111648ba50b16f046c"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjan-ivar@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074993 - Add WPT that candidates replace description attributes rather than mutate them. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328642\n", "files": ["testing/web-platform/tests/webrtc/RTCPeerConnection-description-candidate-replaced.https.html"], "git_node": "0d857f4300c164c02db885e9df5bd335089e25da", "git_parents": ["81fb8f65c5ef39a61798637c56f3812cfb28a590"], "node": "46266870865aa88671c7cb57f7005b7e13b32fe6", "parents": ["b2e552f2167a301a4bec34660c32fd3840b581eb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081977 - Deal better with style changes in replicated subtrees. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nQuite a massive hammer, but simple and should be correct / fix a lot of\nthese issues at once.\n\nWe'd need to reframe the root for replicated fixed pos, and would need to\nreframe at least the replicated table for the replicated rowgroups.\n\nHowever since nsPageSequenceFrame will bail on incremental reflow\n(bug 1152354), well...\n\nOther bugs that I found while at this are that nsTableCellMap::Synchronize\nand nsTableFrame::ResetRowIndices only look at a single table continuation.\nA dynamic row-group removal leaks a cell map.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334564\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/style/RestyleManager.cpp", "testing/web-platform/tests/css/printing/fixed-container-query-removal-crash-print.html", "testing/web-platform/tests/css/printing/table-row-group-container-query-crash-print.html"], "git_node": "a6e4e54eb51749b07196094b3256f3f38667b625", "git_parents": ["0d857f4300c164c02db885e9df5bd335089e25da"], "node": "7d1bc02454eae6f1ab15528b5224704fa1e2a3bd", "parents": ["46266870865aa88671c7cb57f7005b7e13b32fe6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081977 - Share generated content pseudo-elements and skip counters for extra frames. r=layout-reviewers,dshin\n\nRepeated table headers and replicated fixed-pos frames used to create\nnew pseudo-element containers and counter nodes for each copy, which\nconfused the generated content lists.\n\nReuse the original pseudo-element instead, and don't make extra frames\nparticipate in counters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334565\n", "files": ["layout/base/crashtests/crashtests.list", "layout/base/crashtests/repeated-counter-marker.html", "layout/base/crashtests/repeated-counter-marker.sjs", "layout/base/crashtests/repeated-generated-content.html", "layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h"], "git_node": "932c4f6ad9d471b4fa86f55de9beafe17a6f443e", "git_parents": ["a6e4e54eb51749b07196094b3256f3f38667b625"], "node": "50185838ae64640d87090e3b60d40d2f4b0f124d", "parents": ["7d1bc02454eae6f1ab15528b5224704fa1e2a3bd"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909443 - Don't emit fmtp or rtcp-fb for payload types excluded by setCodecPreferences. r=bwc,webrtc-reviewers\n\nThe send track keeps codecs excluded by setCodecPreferences, so it still\nwrote fmtp and rtcp-fb lines for payload types the offer never lists.\nRemove those lines once both tracks have been added to the offer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333705\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/sdp/SdpMediaSection.cpp", "dom/media/webrtc/sdp/SdpMediaSection.h", "dom/media/webrtc/tests/mochitests/helpers_from_wpt/sdp.js", "dom/media/webrtc/tests/mochitests/mochitest_peerconnection.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_setCodecPreferencesOfferSdp.html"], "git_node": "6ecca59430742e46e76b475d2318bc97a2010002", "git_parents": ["932c4f6ad9d471b4fa86f55de9beafe17a6f443e"], "node": "7b266529232414c7025098a2606fa3fa31140f59", "parents": ["50185838ae64640d87090e3b60d40d2f4b0f124d"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Show edge arrows with the switcher and keep spaces without stories in New Tab thematic spaces - r=thecount\n\nThis patch prepares the New Tab page's themed spaces layout, which splits the page into separate spaces, for an upcoming experiment that adds a widgets-only space and side arrows for moving between spaces.\n\nUntil now, this layout could only use the switcher at the bottom of the page, and the side arrows existed only in a different layout, where they replaced the switcher. A new option in the layout's settings now turns on the side arrows alongside the switcher, placed in the lower third of the window and recolored to stay readable over a wallpaper.\n\nA space is now kept if it has either stories or widgets, so a widgets-only space appears with its widgets filling the full width, and turning off all widgets only removes the spaces that relied on them instead of switching off the whole layout. The page still waits for stories to load before showing the spaces, so it always opens on the intended starting space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332605\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Spaces/Spaces.jsx", "browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamBase.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Spaces.test.jsx"], "git_node": "4e624c2efeb99504e038a9999ed03788d452d8fe", "git_parents": ["6ecca59430742e46e76b475d2318bc97a2010002"], "node": "94caa4b9bede131c294f5318755127b927d1e69d", "parents": ["7b266529232414c7025098a2606fa3fa31140f59"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Show Recent activity in the thematic space marked for it - r=thecount\n\nThis patch lets the New Tab page's themed spaces layout show Recent activity, the section with pages you visited or bookmarked recently, in a space of its own.\n\nUntil now, Recent activity could only appear in the space the page opens on. A new option in the layout's settings marks the space that should show it, and if no space is marked, Recent activity stays where it was. A space that holds only Recent activity is kept as long as Recent activity is turned on, and it shows the section at full width with no empty stories area.\n\nThis supports an upcoming experiment where Recent activity lives in a separate \"My Stuff\" space next to Home.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332606\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamBase.test.jsx"], "git_node": "6fa9018e515e8d1efb8fedfc263b65af3f786997", "git_parents": ["4e624c2efeb99504e038a9999ed03788d452d8fe"], "node": "e3f4029cb870a1ab9d26b4dc83371a4fdc18b288", "parents": ["94caa4b9bede131c294f5318755127b927d1e69d"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Show the first-slot widget in thematic spaces and let the config name the widget catch-all - r=thecount\n\nThis patch lets the New Tab page's themed spaces layout show a widget as the first card of the main stories section, a placement another layout already supports. Until now, that placement only worked in the other layout, so the themed layout ignored the setting.\n\nNow the themed layout honors the same setting, and the widget shown there is left out of every space's widget area so it never appears twice. A new option in the layout's settings also names the space that collects widgets no space lists, so a widget added later doesn't land on the starting space and push stories down. Without that option nothing changes, and the small Weather widget, which shows in the side area of the page, is now left out of every space so a space can't end up with an empty widget box.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332607\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/selectLayoutRender.test.js"], "git_node": "9035a57b4b55ccae2dd38087c7ed2208b7e9b84a", "git_parents": ["6fa9018e515e8d1efb8fedfc263b65af3f786997"], "node": "a89c8672285c7d349ca9cb1c29f890e61146ecf0", "parents": ["e3f4029cb870a1ab9d26b4dc83371a4fdc18b288"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Keep the New Tab thematic spaces frame within the page width - r=thecount\n\nThis patch stops the New Tab page's themed spaces layout from making the page scroll sideways at certain window widths.\n\nThe area that holds each space's stories and widgets was sized one card column wider than the stories and widgets inside it. Just past the widths where the layout adds another column of cards, that extra width pushed the area past the edges of the window. The area is now sized to exactly fit its stories and widgets, so nothing on screen moves and the sideways scrolling goes away.\n\nThe problem predates the other patches in this stack, and this fix doesn't depend on them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332608\n", "files": ["browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss"], "git_node": "64645f034c0c64a5888fc9c827d063da06806bd4", "git_parents": ["9035a57b4b55ccae2dd38087c7ed2208b7e9b84a"], "node": "6aa19c79b4ce2397272fe9773c9f5ca8c351c32f", "parents": ["a89c8672285c7d349ca9cb1c29f890e61146ecf0"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079902 - Newtab spaces preview modal on hover over tab bar r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333811\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Spaces/Spaces.jsx", "browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss", "browser/extensions/newtab/data/content/assets/spaces-preview-activity.png", "browser/extensions/newtab/data/content/assets/spaces-preview-kit-activity.png", "browser/extensions/newtab/data/content/assets/spaces-preview-kit-stories.png", "browser/extensions/newtab/data/content/assets/spaces-preview-kit-widgets.png", "browser/extensions/newtab/data/content/assets/spaces-preview-stories.png", "browser/extensions/newtab/data/content/assets/spaces-preview-widgets.png", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Spaces.test.jsx"], "git_node": "8141a9f40415784d1ab67749d19ef882758eb582", "git_parents": ["64645f034c0c64a5888fc9c827d063da06806bd4"], "node": "f2eca44593b3d0c63095aa9c3d1ad6c4e51602f1", "parents": ["6aa19c79b4ce2397272fe9773c9f5ca8c351c32f"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Let each New Tab thematic space name its own first-slot widget - r=thecount\n\nThis patch lets each space in the New Tab page's themed spaces layout show its own widget as the first card of its stories.\n\nBefore, the layout's settings could name only one widget for that card, and it always went into the first section on the page, which belongs to the starting space. So two spaces couldn't each have one, and a widget meant for another space still ended up on the starting space. A new option in each space's settings now names a widget, and that widget becomes the first card of the space's own first section. Each widget can be used by only one space, and it's left out of every space's widget area so it never appears twice.\n\nIf no space names a widget, the existing setting works as before, so current configs don't change. The code this layout now shares with the earlier widget-in-the-first-card experiment is marked to be kept when that experiment is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334339\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/lib/selectLayoutRender.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/selectLayoutRender.test.js"], "git_node": "35e98823a3482679755c7b9f318dee6cec97ea57", "git_parents": ["8141a9f40415784d1ab67749d19ef882758eb582"], "node": "e1da538e4d817f4914a57b5cca733485789124a8", "parents": ["f2eca44593b3d0c63095aa9c3d1ad6c4e51602f1"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2079241 - Don't ever show history in local search modes. r=mak,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331585\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser/browser_historyInSearchMode.js"], "git_node": "680fd7fb5e6a8e62afaa505931ab8152f01403dd", "git_parents": ["35e98823a3482679755c7b9f318dee6cec97ea57"], "node": "46f8c46365ee696a436b4fa4f292d250acdaea43", "parents": ["e1da538e4d817f4914a57b5cca733485789124a8"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2080980 - Prevent from using TimelineRangeOffset.offset if CSS Typed OM is disabled. r=webidl,layout-scroll-driven-animation-reviewers,smaug,dshin\n\nTimelineRangeOffset.offset` uses `CSSNumericValue` [1], which requires\nCSS Typed OM support. We shouldn't use it for the getters and setters if\nit is disabled.\n\nWe don't expect to disable `TimelineRangeOffset` entirely because this\nmay impact the rangeStart/rangeEnd getters. Per spec, when reading the\nattribute, the returned value is either a TimelineRangeOffset or the\nDOMString \"normal\". So if we disable `TimelineRangeOffset`, we lose the\nability to return values other than `normal`.\n\nNote that CSS Typed OM is enabled in Nightly only.\n\n[1] https://drafts.csswg.org/web-animations-2/#dom-timelinerangeoffset-offset\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333431\n", "files": ["dom/animation/Animation.cpp", "dom/animation/AnimationUtils.cpp", "dom/animation/test/mochitest.toml", "dom/animation/test/mozilla/test_timeline_range_without_typed_om.html", "dom/webidl/TimelineRangeOffset.webidl"], "git_node": "5f10a1a8e9b7a19079a8d8044e1599ba88a7309c", "git_parents": ["680fd7fb5e6a8e62afaa505931ab8152f01403dd"], "node": "456df083116bfdd441e7335d203b94a9442f2ac2", "parents": ["46f8c46365ee696a436b4fa4f292d250acdaea43"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2081501 - Stop treating Fission as off by default on Android in Raptor r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333444\n", "files": ["testing/raptor/mach_commands.py", "testing/raptor/raptor/cmdline.py", "testing/raptor/test/test_cmdline.py"], "git_node": "b83893d53c011eab94a13e6d5f51773074b4ee81", "git_parents": ["5f10a1a8e9b7a19079a8d8044e1599ba88a7309c"], "node": "a1728b13d450ca3ac6c4f22b0e76c8970afb0f2f", "parents": ["456df083116bfdd441e7335d203b94a9442f2ac2"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054203 - Decode the Picture of the Day wallpaper theme with the window that asked. r=thecount\n\nThe hidden window only exists on macOS, so on Windows and Linux the theme check threw and every Picture of the Day wallpaper was saved as light. This uses the browser window that asked to set the wallpaper instead. The new test sends a dark picture through the feed and checks that it is saved as dark, which the light fallback can't pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334354\n", "files": ["browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser_WallpaperThemeUtils.js"], "git_node": "701b5a87c7eb74df8dee14c6d717358af4a559dd", "git_parents": ["b83893d53c011eab94a13e6d5f51773074b4ee81"], "node": "ae5828095083d3ab8901f68de96716a55268ced5", "parents": ["a1728b13d450ca3ac6c4f22b0e76c8970afb0f2f"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080223 - don't allow scroll in the selection tool for mini window. r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334332\n", "files": ["browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/tests/browser/browser_mini_window_mode.js"], "git_node": "090ab78e8ba27bca53603f3a215308aa1d0bea81", "git_parents": ["701b5a87c7eb74df8dee14c6d717358af4a559dd"], "node": "9cbf4489ade127e08e1b6ad58265e3a47b95f732", "parents": ["ae5828095083d3ab8901f68de96716a55268ced5"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2083018 - Disable uv cache on windows performance tests. r=perftest-reviewers,kshampur DONTBUILD\n\nThis patch disables the uv cache on windows performance tests because of very long delays during the mounting step.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334602\n", "files": ["taskcluster/kinds/browsertime/kind.yml", "taskcluster/kinds/test/awsy.yml", "taskcluster/kinds/test/talos.yml"], "git_node": "9a9ef08f919dab6e9bc7b3d5ae5e370589a60e49", "git_parents": ["090ab78e8ba27bca53603f3a215308aa1d0bea81"], "node": "ff013c2bc342271248c410ed7cab7dd942d95f17", "parents": ["9cbf4489ade127e08e1b6ad58265e3a47b95f732"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082139: Test failed alt-data writes and incomplete compressed bytecode r=necko-reviewers,valentin\" for causing xpcshell failures.\n\nThis reverts commit c2818201c6422b38ea3bcbc7bf94ac3639433fbb.\n\nRevert \"Bug 2082139: Reject incomplete compressed script bytecode r=arai\"\n\nThis reverts commit 90d68393000787adf5a4be31281c02e38b8b6d5c.\n\nRevert \"Bug 2082139: Fail live alt-data readers when the alt-data writer fails r=necko-reviewers,valentin\"\n\nThis reverts commit d03c3288bf1a6f27b663ad5900a6e46633e2a45b.\n", "files": ["dom/base/test/gtest/TestScriptCompression.cpp", "dom/base/test/gtest/moz.build", "dom/script/ScriptCompression.cpp", "netwerk/cache2/CacheFile.cpp", "netwerk/cache2/CacheFileChunk.cpp", "netwerk/cache2/CacheFileInputStream.h", "netwerk/test/unit/test_alt-data_failed_write.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "d74aa51d713cde71a87626ba6f306d8496e5f80e", "git_parents": ["9a9ef0