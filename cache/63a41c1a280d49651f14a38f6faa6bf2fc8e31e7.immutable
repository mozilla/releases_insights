/fenix/ui/efficiency/tests/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/NavigationToolbarTest.kt"], "git_node": "058c95839b4bb7c185dd5afbd276e9541d48e089", "git_parents": ["028c42b0aa2e48ef2154a52d9de1dced009f348c"], "node": "d0c5dbd1405690e495b3f5ac9d1a47b638e58f45", "parents": ["00982bdb9eca38604c1fb7cb695f731b63dabade"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082006. r=gfx-reviewers,ahale\" for causing build bustages.\n\nThis reverts commit 028c42b0aa2e48ef2154a52d9de1dced009f348c.\n", "files": ["gfx/2d/2D.h", "gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/ScaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/cairo/cairo/src/cairo-ft-font.c", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0052-Bug-2082006-lock-sharedftface.patch", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp"], "git_node": "1f2f97a8f5d8cdb40875d1839dac03f9f1a763da", "git_parents": ["058c95839b4bb7c185dd5afbd276e9541d48e089"], "node": "fde1b0b398503e1dc6543487412e2bbbf4bb480b", "parents": ["d0c5dbd1405690e495b3f5ac9d1a47b638e58f45"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078254 [Linux] Respect nsWindow::MakeFullScreen() return state and disable fullscreen for xx-pip r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331961\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "bc576c01b19d81e850da5daca68b8fb438060ce0", "git_parents": ["1f2f97a8f5d8cdb40875d1839dac03f9f1a763da"], "node": "af83255c9177450d92e2827ea5c5524a6e2339b6", "parents": ["fde1b0b398503e1dc6543487412e2bbbf4bb480b"], "tags": []}, {"author": "giorga \u003cg