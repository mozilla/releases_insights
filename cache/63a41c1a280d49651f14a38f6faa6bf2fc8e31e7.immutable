nt_onPasswordEditedOrGenerated.js", "toolkit/components/passwordmgr/test/unit/test_PasswordRulesManager_generatePassword.js", "toolkit/components/passwordmgr/test/unit/test_loginsBackup.js", "toolkit/components/passwordmgr/test/unit/test_module_LoginCSVImport.js"], "git_node": "f8abfe5a2f7579f599804912883d476e0fac7b9d", "git_parents": ["19dfd44d76924e46aff06e55f773db51bea139c3"], "node": "35bb6a27d3f65bb51d8ba6003d11f2018a4c356e", "parents": ["b2eb07f9444dc604ea391a4041aa2040bf824641"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2079024 - Re-enable geckoview-junit tests that no longer need their fission skip r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331469\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/NavigationDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ScreenshotTest.kt"], "git_node": "90303d48d601b1e981a84a9f3568715a9bd4341b", "git_parents": ["f8abfe5a2f7579f599804912883d476e0fac7b9d"], "node": "5bd6d60b2834848db9bd12fe470b1af1944d2438", "parents": ["35bb6a27d3f65bb51d8ba6003d11f2018a4c356e"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070368 - Update WallpaperFeatureHighlight to allow for alternate strings to be injected. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331784\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/FeatureHighlight/WallpaperFeatureHighlight.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/WallpaperFeatureHighlight.test.jsx"], "git_node": "5bafa1e8170417b7cbefa5c70e072ef9968ccd3a", "git_parents": ["90303d48d601b1e981a84a9f3568715a9bd4341b"], "node": "eeabace72a4dccc675ed7fc5aa101dc136b2dc0c", "parents": ["5bd6d60b2834848db9bd12fe470b1af1944d2438"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076983. r=layout-reviewers,dshin\n\nLow-risk fix. More principled fix in bug 2080219.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332437\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/tests/css/css-grid/observer-chain-crash.html"], "git_node": "fbcd1e9bd4c87be1b852bf120ff07dc44b1d5e53", "git_parents": ["5bafa1e8170417b7cbefa5c70e072ef9968ccd3a"], "node": "03b6d62f859c9576b807c836e36fbee46655822e", "parents": ["eeabace72a4dccc675ed7fc5aa101dc136b2dc0c"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074620 - Horoscope: Add the widget scaffolding r=nina-py\n\nThis adds an empty Horoscopes card with the standard menu, following Crossword. Manage Widgets picks it up from the registry. It stays hidden until `widgets.system.horoscopes.enabled` or the `widgetHoroscopes` train-hop config turns it on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329103\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Horoscopes/Horoscopes.jsx", "browser/extensions/newtab/content-src/components/Widgets/Horoscopes/_Horoscopes.scss", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Horoscopes.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/AboutPreferences.test.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "8d071ec2d0145e6b999dd8eb49d886dcee36c9ab", "git_parents": ["fbcd1e9bd4c87be1b852bf120ff07dc44b1d5e53"], "node": "e3529aa91792f550c139094a5347c5458deaf8a7", "parents": ["03b6d62f859c9576b807c836e36fbee46655822e"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Run the source-test vendor node task from a Git checkout, r=taskgraph-reviewers,ahal\n\nThe task validated vendoring with `hg status third_party/node`, which only\nworks when the tree is cloned from hg. Check for changes under\nthird_party/node through mozversioncontrol instead (the same API\nvendor_node.py already uses), which handles both backends, and drop the\nclone-with: hg pin.\n\n`mach vendor node` ends with `add_remove_files` on third_party/node, so on\ngit its result is staged. The check therefore compares the working tree\nwith HEAD (`mode=\"all\"`); the default unstaged diff would report nothing\nafter vendoring.\n\nVerified on git-backed pushes (staging-firefox), exercising the check both\nways:\n- clean tree: source-test-vendor-node clones with git, vendors and\n  succeeds (https://firefox-ci-tc.services.mozilla.com/tasks/PA6iU4yXR3qqvxugg2c8ZA)\n- deliberately stale third_party/node/vendor-inputs.hash: vendoring\n  rewrites it, the check lists the file and the task fails\n  (https://firefox-ci-tc.services.mozilla.com/tasks/ZU4ilkolQTGC8VrQscXduw)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332342\n", "files": ["taskcluster/kinds/source-test/vendor.yml"], "git_node": "8ac8bbdba40d379b7386f6a6b233a1a5a5170d3d", "git_parents": ["8d071ec2d0145e6b999dd8eb49d886dcee36c9ab"], "node": "d41b43e4badb2f665efe123cd809f8e1d291b4cc", "parents": ["e3529aa91792f550c139094a5347c5458deaf8a7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059255 - Add a streaming markdown parser to ui-richtext. r=sfamisa,android-reviewers\n\nintellij-markdown reparses only the part of a document that can still change as text is appended, and can do\nso under a CancellationToken. Wrap that in a StreamingParser, converting each top-level node to blocks once it\nhas settled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321443\n", "files": ["mobile/android/android-components/components/ui/richtext/src/main/kotlin/mozilla/components/ui/richtext/parsing/StreamingParser.kt", "mobile/android/android-components/components/ui/richtext/src/test/kotlin/mozilla/components/ui/richtext/parsing/StreamingParserEquivalenceTest.kt", "mobile/android/android-components/components/ui/richtext/src/test/kotlin/mozilla/components/ui/richtext/parsing/StreamingParserTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "98bda5adad94517e9758e6581f6ce1d33f229c24", "git_parents": ["8ac8bbdba40d379b7386f6a6b233a1a5a5170d3d"], "node": "63a643a3edcde3ccfc4d9b0f12afc6664eae62a2", "parents": ["d41b43e4badb2f665efe123cd809f8e1d291b4cc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059255 - Parse a streamed page summary incrementally. r=sfamisa,android-reviewers\n\nThe summary was reparsed from scratch on a 120ms throttle as it streamed in, making the total parsing work\nquadratic in its length, and every tick copied the accumulated text into a new String for a parser that takes\na CharSequence. Feed a StreamingParser instead, once per tick, so a chunk never triggers a parse more often\nthan the throttle it replaced. An in-flight parse also stops as soon as the collection is cancelled, such as\nwhen the summary is dismissed, instead of running to completion.\n\nThe accumulated text was also written and read on opposite sides of the conflate(), which are separate\ncoroutines on a multi-threaded dispatcher; a queue is now the only state crossing that boundary. Per-stream\nstate moves into the flow builder, so collecting the returned flow twice no longer reuses a full buffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321444\n", "files": ["mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/ext/Flow.kt", "mobile/android/android-components/components/feature/summarize/src/test/java/mozilla/components/feature/summarize/ext/FlowTest.kt"], "git_node": "5b2c4e9344d11b0d550ef1f0a4161c2c45723255", "git_parents": ["98bda5adad94517e9758e6581f6ce1d33f229c24"], "node": "0abf6b3b6e4cb2213b07f6feb719d86a63786d16", "parents": ["63a643a3edcde3ccfc4d9b0f12afc6664eae62a2"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2077475 - chore(webgpu): update CTS to a5e5d7440fa036b74ea13c3c5cb6b618a3c884e9 r=webgpu-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330350\n", "files": ["dom/webgpu/tests/cts/checkout/package-lock.json", "dom/webgpu/tests/cts/checkout/package.json", "dom/webgpu/tests/cts/checkout/src/webgpu/api/operation/adapter/requestDevice.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/api/operation/command_buffer/copyTextureToTexture.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/api/operation/command_buffer/image_copy.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/api/validation/capability_checks/features/texture_compression_unaligned.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/api/validation/createBindGroupLayout.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/api/validation/createTexture.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/api/validation/render_pipeline/multisample_state.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/capability_info.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/format_info.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/atomics/atomicStoreMax.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/atomics/atomicStoreMin.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/bufferArrayView.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/bufferView.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/buffer_view_utils.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/quadBroadcast.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/quadSwap.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupAdd.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupAll.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupAny.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupBallot.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupBitwise.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupBroadcast.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupElect.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupMinMax.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupMul.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupShuffle.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/shader_io/compute_builtins.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/shader_io/fragment_builtins.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/statement/assignment/vector.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/shader_validation_test.ts", "dom/webgpu/tests/cts/checkout/tools/gen_version", "dom/webgpu/tests/cts/moz.yaml", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/createBindGroupLayout/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/render_pipeline/multisample_state/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/bufferArrayView/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/bufferView/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/statement/assignment/vector/cts.https.html.ini", "testing/web-platform/mozilla/tests/webgpu/common/internal/version.js", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/api/validation/createBindGroupLayout/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/api/validation/render_pipeline/multisample_state/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/shader/execution/expression/call/builtin/bufferArrayView/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/shader/execution/expression/call/builtin/bufferView/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/shader/execution/statement/assignment/vector/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/webgpu/api/operation/adapter/requestDevice.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/api/validation/capability_checks/features/texture_compression_unaligned.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/api/validation/createBindGroupLayout.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/api/validation/createTexture.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/api/validation/render_pipeline/multisample_state.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/capability_info.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/format_info.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/listing.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/builtin/bufferArrayView.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/builtin/bufferView.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/builtin/buffer_view_utils.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/statement/assignment/vector.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/execution/statement/assignment/vector.as_worker.js"], "git_node": "56fa1b9931130b837ef86b6461a8c1bf22f63b00", "git_parents": ["5b2c4e9344d11b0d550ef1f0a4161c2c45723255"], "node": "39280177af2a163670d659401e74040bad70118f", "parents": ["0abf6b3b6e4cb2213b07f6feb719d86a63786d16"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079380 - Keep the x64 mozconfig when collapsing the macOS universal build into an artifact build. r=taskgraph-reviewers,firefox-build-system-reviewers,sylvestre,ahal\n\nSince MOZCONFIG is set from the `mozconfig` key rather than the mozharness\nconfigs, the collapsed build kept the universal build's `mozconfig: null` and\nfailed with \"MOZCONFIG is not set in the environment\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331690\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_build.py", "taskcluster/gecko_taskgraph/transforms/build.py"], "git_node": "4525882dcaf180dd0caf46dc77c11c9a2e8d69f1", "git_parents": ["56fa1b9931130b837ef86b6461a8c1bf22f63b00"], "node": "1918e02d77c296d9430248032ff174094ecd835d", "parents": ["39280177af2a163670d659401e74040bad70118f"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079267 - Activate clang-tidy's modernize-make-unique r=extension-reviewers,ipc-reviewers,webrtc-reviewers,sandbox-reviewers,nika,bwc,mccr8,bobowen,robwu\n\nBasically turning:\n\n        std::unique_ptr\u003cT\u003e(new T(...))\n\ninto:\n\n        std::make_unique\u003cT\u003e(...)\n\nwhich is more concise. No performance change: the (optimized) generated\nbinary code is the same.\n\nFor the curious ones, a description of the linter can be found in\nhttps://clang.llvm.org/extra/clang-tidy/checks/modernize/make-unique.html\n\nThe change is purely mechanical and has been deterministically generated\nthrough the --fix feature of clang-tidy.\n\nThe was a single false positive from the linter, I submitted a fix\nupstream (see https://github.com/llvm/llvm-project/pull/229802) and\ndocumented it inline, until we reach a version of clang that ships the\npatch.\n\nA following patch (manually generated), turns the redundant:\n\n        std::unique_ptr\u003cT\u003e a = std::make_unique\u003cT\u003e(...)\n\ninto:\n\n        auto a = std::make_unique\u003cT\u003e(...)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331724\n", "files": ["dom/base/Document.cpp", "dom/base/Element.cpp", "dom/base/Selection.cpp", "dom/cache/TypeUtils.cpp", "dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLContextDraw.cpp", "dom/fetch/FetchDriver.cpp", "dom/fetch/Request.cpp", "dom/fetch/Response.cpp", "dom/html/HTMLInputElement.cpp", "dom/media/ExternalEngineStateMachine.cpp", "dom/media/MediaDecoderStateMachine.cpp", "dom/media/MediaFormatReader.cpp", "dom/media/VideoUtils.cpp", "dom/media/gmp/GMPTimerParent.cpp", "dom/media/mp4/MP4Demuxer.cpp", "dom/media/ogg/OggCodecState.cpp", "dom/media/ogg/OggDemuxer.cpp", "dom/media/platforms/MediaCodecsSupport.cpp", "dom/media/platforms/omx/OmxPlatformLayer.cpp", "dom/media/systemservices/video_engine/desktop_capture_impl.cc", "dom/media/webaudio/AudioContext.cpp", "dom/media/webaudio/ConvolverNode.cpp", "dom/media/webaudio/blink/Reverb.cpp", "dom/media/webaudio/blink/ReverbConvolver.cpp", "dom/media/webcodecs/VideoFrame.cpp", "dom/media/webrtc/jsep/JsepTrack.h", "dom/media/webrtc/sdp/RsdparsaSdpParser.cpp", "dom/media/webrtc/sdp/SipccSdpParser.cpp", "dom/media/webrtc/transport/test_nr_socket.cpp", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceStorageWorker.cpp", "dom/performance/PerformanceTiming.cpp", "dom/script/SharedScriptCache.cpp", "dom/serviceworkers/ServiceWorkerEvents.cpp", "dom/simpledb/SDBConnection.cpp", "dom/smil/SMILAnimationController.cpp", "dom/webgpu/CanvasContext.cpp", "dom/webgpu/ipc/WebGPUParent.cpp", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/workers/loader/NetworkLoadHandler.cpp", "dom/xhr/XMLHttpRequestWorker.cpp", "dom/xslt/xpath/txExprParser.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "dom/xslt/xslt/txNodeSorter.cpp", "dom/xslt/xslt/txPatternParser.cpp", "dom/xslt/xslt/txStylesheet.cpp", "dom/xslt/xslt/txStylesheetCompileHandlers.cpp", "dom/xslt/xslt/txStylesheetCompiler.cpp", "dom/xul/XULResizerElement.cpp", "extensions/spellcheck/hunspell/glue/RLBoxHunspell.cpp", "extensions/spellcheck/hunspell/glue/mozHunspellRLBoxHost.cpp", "gfx/gl/GLContext.cpp", "gfx/vr/VRManager.cpp", "gfx/webrender_bindings/Moz2DImageRenderer.cpp", "image/AnimationSurfaceProvider.cpp", "intl/components/src/DateTimeFormatUtils.cpp", "intl/strres/nsStringBundle.cpp", "ipc/chromium/src/chrome/common/ipc_channel_posix.cc", "js/xpconnect/src/XPCJSRuntime.cpp", "netwerk/dns/PlatformDNSUnix.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/InterceptedHttpChannel.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/sctp/datachannel/DataChannelDcSctp.cpp", "netwerk/sctp/datachannel/DataChannelUsrsctp.cpp", "netwerk/system/netlink/NetlinkService.cpp", "security/manager/ssl/OSKeyStore.cpp", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp", "toolkit/components/url-classifier/VariableLengthPrefixSet.cpp", "toolkit/components/url-classifier/nsUrlClassifierDBService.cpp", "toolkit/mozapps/update/updater/updater.cpp", "widget/headless/HeadlessKeyBindings.cpp", "xpcom/base/nsCycleCollector.cpp", "xpcom/base/nsMemoryReporterManager.cpp"], "git_node": "55b5b6f1ad5846981ee98f179758678aa81640c0", "git_parents": ["4525882dcaf180dd0caf46dc77c11c9a2e8d69f1"], "node": "dd5b387ca1aa90a86a3f00f4c20219d8c0e8611b", "parents": ["1918e02d77c296d9430248032ff174094ecd835d"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079267 - Remove redundant idiom when using std::make_unique\u003cT\u003e(...) r=webrtc-reviewers,bwc\n\nTurns the redundant:\n\n        std::unique_ptr\u003cT\u003e a = std::make_unique\u003cT\u003e(...)\n\ninto:\n\n        auto a = std::make_unique\u003cT\u003e(...)\n\nThe patch has been generated through a combination of grep and sed. As a\nsanity check, I looked for the multi-line patterns:\n\n        std::unique_ptr.*=.*std::make_unique\n\nand:\n\n        UniquePtr.*=.*std::make_unique\n\nAnd that's all what I've found.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331725\n", "files": ["build/clang-plugin/mozsearch-plugin/MozsearchIndexer.cpp", "dom/media/MediaDecoderStateMachine.cpp", "dom/media/gmp/GMPTimerParent.cpp", "dom/media/ogg/OggCodecState.cpp", "dom/media/webaudio/AudioContext.cpp", "dom/media/webaudio/ConvolverNode.cpp", "dom/media/webaudio/blink/Reverb.cpp", "dom/performance/PerformanceStorageWorker.cpp", "dom/serviceworkers/ServiceWorkerEvents.cpp", "dom/simpledb/SDBConnection.cpp", "dom/smil/SMILAnimationController.cpp", "dom/webgpu/ipc/WebGPUParent.cpp", "dom/workers/loader/NetworkLoadHandler.cpp", "dom/xslt/xpath/txExprParser.cpp", "dom/xslt/xslt/txNodeSorter.cpp", "dom/xslt/xslt/txStylesheet.cpp", "dom/xslt/xslt/txStylesheetCompileHandlers.cpp", "dom/xul/XULResizerElement.cpp", "modules/woff2/RLBoxWOFF2Sandbox.cpp", "netwerk/sctp/datachannel/DataChannelDcSctp.cpp", "netwerk/sctp/datachannel/DataChannelUsrsctp.cpp", "netwerk/system/netlink/NetlinkService.cpp", "security/manager/ssl/tests/gtest/CertificateCompressionTest.cpp", "toolkit/components/url-classifier/VariableLengthPrefixSet.cpp"], "git_node": "a09d76ad70f58df30c93d842c003678cc56cd0fe", "git_parents": ["55b5b6f1ad5846981ee98f179758678aa81640c0"], "node": "1d996266ae550374bbd72579ed49039ed2475727", "parents": ["dd5b387ca1aa90a86a3f00f4c20219d8c0e8611b"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079353 - Migrate pwmgr unit tests away from Legacy Telemetry r=mtigley,credential-management-reviewers\" for causing bc and TV tests failures at breachAlertLinkTelemetry.js\n\nThis reverts commit f8abfe5a2f7579f599804912883d476e0fac7b9d.\n\nRevert \"Bug 2079353 - Migrate pwmgr mochitests away from Legacy Telemetry r=mtigley,credential-management-reviewers\"\n\nThis reverts commit 19dfd44d76924e46aff06e55f773db51bea139c3.\n\nRevert \"Bug 2079353 - Migrate pwmgr browser tests to Glean r=mtigley,settings-reviewers,credential-management-reviewers,akulyk\"\n\nThis reverts commit 69129420f5a343fcabaf71b70127d67a57e75aef.\n\nRevert \"Bug 2079353 - Remove mirroring to now-unused Legacy Telemetry passwordmanager probes r=mtigley,credential-management-reviewers\"\n\nThis reverts commit 2522acbf6bb87ab2343ab60a3c9354f6b529db91.\n", "files": ["browser/components/aboutlogins/tests/browser/browser_aaa_eventTelemetry_run_first.js", "browser/components/aboutlogins/tests/browser/browser_breachAlertLinkTelemetry.js", "browser/components/aboutlogins/tests/browser/browser_openExport.js", "browser/components/aboutlogins/tests/browser/browser_openImport.js", "browser/components/aboutlogins/tests/browser/browser_openImportCSV.js", "browser/components/aboutlogins/tests/browser/browser_openPreferences.js", "browser/components/aboutlogins/tests/browser/head.js", "browser/components/preferences/tests/credentials/browser_password_management.js", "browser/components/preferences/tests/credentials/browser_password_management_xul.js", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/LoginTestUtils.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_footer.js", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_generated_password_private_window.js", "toolkit/components/passwordmgr/test/browser/browser_context_menu.js", "toolkit/components/passwordmgr/test/browser/browser_entry_point_telemetry.js", "toolkit/components/passwordmgr/test/browser/browser_relay_telemetry.js", "toolkit/components/passwordmgr/test/browser/browser_relay_utils.js", "toolkit/components/passwordmgr/test/browser/browser_telemetry_SignUpFormRuleset.js", "toolkit/components/passwordmgr/test/browser/browser_username_only_form_telemetry.js", "toolkit/components/passwordmgr/test/browser/head.js", "toolkit/components/passwordmgr/test/mochitest/pwmgr_common.js", "toolkit/components/passwordmgr/test/mochitest/pwmgr_common_parent.js", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_basic_form.html", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_basic_form_related_realms.html", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_password_generation_telemetry.html", "toolkit/components/passwordmgr/test/mochitest/test_insecure_form_field_no_saved_login.html", "toolkit/components/passwordmgr/test/unit/test_LoginManagerParent_onPasswordEditedOrGenerated.js", "toolkit/components/passwordmgr/test/unit/test_PasswordRulesManager_generatePassword.js", "toolkit/components/passwordmgr/test/unit/test_loginsBackup.js", "toolkit/components/passwordmgr/test/unit/test_module_LoginCSVImport.js", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "96893ab03843a88033ab5689af7e06b2673976e4", "git_parents": ["a09d76ad70f58df30c93d842c003678cc56cd0fe"], "node": "2b12649af0d1ded1b93281fd5f55839142e9e9cb", "parents": ["1d996266ae550374bbd72579ed49039ed2475727"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076715 - Log and record session file write failures. r=sessionstore-reviewers,jswinarton\n\n- Adds a write_failure event with fine-grained details on specifically where and how the failure occurred\n- Maintain running tally of write failures but don't spam with identical reports\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330114\n", "files": ["browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/SessionWriter.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/unit/test_write_outcome.js", "browser/components/sessionstore/test/unit/xpcshell.toml", "browser/components/sessionstore/types/sessionstore.ts", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "39a0b6710b3a8a1ba9143feaff79866c0bc75746", "git_parents": ["96893ab03843a88033ab5689af7e06b2673976e4"], "node": "a5fed98a4e5d56497cd20d4de8dd258354b68469", "parents": ["2b12649af0d1ded1b93281fd5f55839142e9e9cb"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049387 - add dialog tokens and Nova overrides r=desktop-theme-reviewers,tabbrowser-reviewers,jules,jsudiaman\n\nSince it'll be too much lift to create a moz-dialog element right now I'm creating some dialog tokens so we can at least standardize how we're styling existing dialog elements. This patch applies the tokens to content-area dialogs like those triggered via `window.alert`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310151\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/tabbrowser/content-area.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/figma-variables-all.json", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/components/dialog.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/panel.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/panel.tokens.json"], "git_node": "5f9f6af78952f19ef8ff266291199767bfe288fa", "git_parents": ["39a0b6710b3a8a1ba9143feaff79866c0bc75746"], "node": "dd32b6ca2a96b121f534eebd6f154884cf478e02", "parents": ["a5fed98a4e5d56497cd20d4de8dd258354b68469"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049387 - Make about:logins dialogs use the dialog tokens r=credential-management-reviewers,mtigley\n\nNow that we have dialog tokens we should use them for the about:logins specific dialogs so that all our dialogs match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310152\n", "files": ["browser/components/aboutlogins/content/aboutLogins.css", "browser/components/aboutlogins/content/components/confirmation-dialog.css", "browser/components/aboutlogins/content/components/generic-dialog.css", "browser/components/aboutlogins/content/components/remove-logins-dialog.css"], "git_node": "a840c11aa9f72ab9a2c63de61ce45ab64ba7c86d", "git_parents": ["5f9f6af78952f19ef8ff266291199767bfe288fa"], "node": "6beece95190b43dd4c2873688d59aa0017004345", "parents": ["dd32b6ca2a96b121f534eebd6f154884cf478e02"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049387 -  Make firefox view dialogs use the dialog tokens r=fxview-reviewers,nsharpley\n\nNow that we have dialog tokens we should make sure the dialogs in Firefox View use them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310153\n", "files": ["browser/components/firefoxview/history.css"], "git_node": "47790031d3be68731b0ae77f7d76e95b2cfab951", "git_parents": ["a840c11aa9f72ab9a2c63de61ce45ab64ba7c86d"], "node": "716ab548af2833620fb424907e639a9afcff4ee8", "parents": ["6beece95190b43dd4c2873688d59aa0017004345"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049387 - Make about:preferences dialogs use the dialog tokens r=desktop-theme-reviewers,jules\n\nNow that we have dialog tokens we should make sure dialogs in about:preferences use them\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310154\n", "files": ["browser/components/preferences/config/block-ai-confirmation-dialog.css", "browser/themes/shared/preferences/preferences.css"], "git_node": "8b71b4a802b06daafd376de9be411992b1efae5a", "git_parents": ["47790031d3be68731b0ae77f7d76e95b2cfab951"], "node": "0b7dddd62607c172a35f4f472b57011f8274eb9d", "parents": ["716ab548af2833620fb424907e639a9afcff4ee8"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049387 - Make new tab dialogs use dialog tokens r=jbrown\n\nNow that we have dialog tokens we should make sure dialogs on the new tab use them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310155\n", "files": ["browser/extensions/newtab/content-src/components/ConfirmDialog/_ConfirmDialog.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/ReportContent/ReportContent.scss", "browser/extensions/newtab/content-src/components/ModalOverlay/_ModalOverlay.scss", "browser/extensions/newtab/content-src/components/Weather/_Weather.scss"], "git_node": "7857c5772a78ec4d3e864d9fc1c66ac96cab0ddd", "git_parents": ["8b71b4a802b06daafd376de9be411992b1efae5a"], "node": "1e55d7ba988fb730147c3a019bc4c3f9302a8f08", "parents": ["0b7dddd62607c172a35f4f472b57011f8274eb9d"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049387 - take corner radius into account when positioning dialog resizer r=layout-reviewers,emilio,desktop-theme-reviewers,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314780\n", "files": ["browser/themes/shared/preferences/preferences.css", "layout/generic/ScrollContainerFrame.cpp", "layout/reftests/css-scrollbars/reftest.list", "layout/reftests/css-scrollbars/scrollbar-inset-resizer-notref.html", "layout/reftests/css-scrollbars/scrollbar-inset-resizer.html"], "git_node": "643a34ae6a90f4506bf5bf750530b0c5e8d0ea77", "git_parents": ["7857c5772a78ec4d3e864d9fc1c66ac96cab0ddd"], "node": "3325df250c4b1640058ebcbab237c14f92bcf940", "parents": ["1e55d7ba988fb730147c3a019bc4c3f9302a8f08"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046515 - Remove dialog background color styles now that we have a color token r=desktop-theme-reviewers,emilio,settings-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325533\n", "files": ["toolkit/themes/shared/in-content/common-shared.css"], "git_node": "fa512ea3860c93ba806aa7717d4b655f803b2d41", "git_parents": ["643a34ae6a90f4506bf5bf750530b0c5e8d0ea77"], "node": "9368b9c821836aa747bb0bdec3c256ff893b6d4f", "parents": ["3325df250c4b1640058ebcbab237c14f92bcf940"], "tags": []}, {"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 2080080 - Disable test_LoginStorageMigrator_nimbus.js for Thunderbird builds. r=mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332314\n", "files": ["toolkit/components/passwordmgr/test/unit/xpcshell.toml"], "git_node": "1111ae32ba178e664523f0e5b37058295374a012", "git_parents": ["fa512ea3860c93ba806aa7717d4b655f803b2d41"], "node": "6b5ab756d3f4200bc567b06b064428451f23f428", "parents": ["9368b9c821836aa747bb0bdec3c256ff893b6d4f"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2079873 - disable refresh button for v0 r=mlucks\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332253\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-page-actions/aitab-page-actions.css"], "git_node": "39453bee658a4d84818e99a2fa1788f7c0b54312", "git_parents": ["1111ae32ba178e664523f0e5b37058295374a012"], "node": "a0f8b05e76249e26cd29c07168046c279e67f7f8", "parents": ["6b5ab756d3f4200bc567b06b064428451f23f428"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077835 - Return already_AddRefed instead of raw pointer from GetHiddenWindowWidget(). r=mac-reviewers,mstange,bradwerth\n\nMake nsCocoaUtils::GetHiddenWindowWidget() return an\nalready_AddRefed\u003cnsIWidget\u003e instead of a raw nsIWidget* pointer because\nthe conversion from a nsCOMPtr to a raw pointer fails to compile in\nC++23.\n\n* In C++20, the returned nsCOMPtr is an lvalue. It uses nsCOMPtr's\n  `operator T*() const&` conversion.\n\n* In C++23 (P2266), the returned nsCOMPtr is a move-eligible xvalue.\n  It selects the deleted `operator T*() const&& = delete` overload:\n\nerror: conversion function from 'const nsCOMPtr\u003cT\u003e' to 'T *' invokes a deleted function\n|   operator T*() const&& = delete;\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330591\n", "files": ["widget/cocoa/nsCocoaUtils.h", "widget/cocoa/nsCocoaUtils.mm", "widget/cocoa/nsMenuUtilsX.mm"], "git_node": "4cfd929f871d8877c56d17db82156bf7db991a49", "git_parents": ["39453bee658a4d84818e99a2fa1788f7c0b54312"], "node": "e4e5361861b45ae5de6c511cf36e7aec57814eb1", "parents": ["a0f8b05e76249e26cd29c07168046c279e67f7f8"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077835 - Return strong references from Cocoa menu bar getters. r=mac-reviewers,bradwerth\n\nReturn already_AddRefed\u003cnsMenuBarX\u003e from GetMenuBar() and\nGetHiddenWindowMenuBar() instead of raw pointers.\n\nHold strong references when invoking menu bar operations that may\nre-enter Gecko in SendEventToNativeMenuSystem() and\nForceUpdateNativeMenuAt().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332283\n", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsMenuUtilsX.h", "widget/cocoa/nsMenuUtilsX.mm"], "git_node": "03b7f95fb35b62c35421e720a1e034db93f7eb37", "git_parents": ["4cfd929f871d8877c56d17db82156bf7db991a49"], "node": "6cec78cf7fdb4ddc301bd91f82fe64223ca6dbd6", "parents": ["e4e5361861b45ae5de6c511cf36e7aec57814eb1"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073531 - Raise the open file limit for mitmdump in direct playback mode r=kshampur,perftest-reviewers\n\nDirect mode gives every origin its own connections to mitmdump instead of the\n32 Firefox allows per proxy, which exceeds the macOS default of 256 open files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328900\n", "files": ["testing/mozbase/mozproxy/mozproxy/backends/mitm/mitm.py", "testing/mozbase/mozproxy/tests/test_proxy.py"], "git_node": "b50d388814c1463a616a8ce817f9e8666334925d", "git_parents": ["03b7f95fb35b62c35421e720a1e034db93f7eb37"], "node": "9b0cf7b95878cfeaef7097ae45d0c00995623132", "parents": ["6cec78cf7fdb4ddc301bd91f82fe64223ca6dbd6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078435 - Wait for each load and for the flushed history change in flushSessionStateTriggersHistoryChange. r=geckoview-reviewers,owlish\n\nLoading the second page without waiting let it cancel the first load, which does not always send onPageStop,\nso waitForPageStops(2) could time out. The delegate was also never called before the test ended, which went\nunnoticed because of bug 2080318.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332577\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/HistoryDelegateTest.kt"], "git_node": "c8ae8bdeafd1ce55092118e10cf128a249703429", "git_parents": ["b50d388814c1463a616a8ce817f9e8666334925d"], "node": "8c28fdeeb548523aaac0051ac562b24ca14a9958", "parents": ["9b0cf7b95878cfeaef7097ae45d0c00995623132"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051018 - Update sidebar history keyDown event to handle deleting consecutive and non-consecutive multiple selected items. r=sidebar-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330457\n", "files": ["browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/tests/browser/browser_delete_sidebar_history.js"], "git_node": "f223b08ec24a64bb75dfd7d15b28b9c6930d9fb2", "git_parents": ["c8ae8bdeafd1ce55092118e10cf128a249703429"], "node": "b0f28f8cfe69597b86b0b59474b20288d31444eb", "parents": ["8c28fdeeb548523aaac0051ac562b24ca14a9958"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080314 - Update android nightly application-services version bump to d3dbcf19b62a42f6a9d8fc0d88ba5507aee2ba76 r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332529\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "4e2f4aab6de77a691199ae48c4820d5bbb86b939", "git_parents": ["f223b08ec24a64bb75dfd7d15b28b9c6930d9fb2"], "node": "6351fa641e404e189c4f52e9e29279d6714e2955", "parents": ["b0f28f8cfe69597b86b0b59474b20288d31444eb"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2073555 - Document the jsdoc type and description rules in the documentation skill r=ai4dev-reviewers,suhaib DONTBUILD\n\nThe skill told authors to work around the type expressions jsdoc rejects\nby hand, which the new plugin makes unnecessary. Say what each of the two\nplugins handles, and the two cases they cannot: a one-line @type comment\nwhose description is dropped, and a bare @typedef whose prose jsdoc reads\na type expression out of.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327413\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "2f369fbd7d0e671ba98bff985f4f714c9b59e27f", "git_parents": ["4e2f4aab6de77a691199ae48c4820d5bbb86b939"], "node": "4e586ef6b0b67cf0d30f3c5cb319e0ac9a15b9cc", "parents": ["6351fa641e404e189c4f52e9e29279d6714e2955"], "tags": []}, {"author": "Tom Schuster \u003cevilpies@gmail.com\u003e", "branch": "default", "desc": "Bug 2079495 - Remove some unused WebGL code. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331808\n", "files": ["dom/canvas/WebGL2ContextFramebuffers.cpp", "dom/canvas/WebGL2ContextRenderbuffers.cpp", "dom/canvas/WebGL2ContextSamplers.cpp", "dom/canvas/WebGL2ContextState.cpp", "dom/canvas/WebGL2ContextSync.cpp", "dom/canvas/WebGL2ContextTransformFeedback.cpp", "dom/canvas/WebGL2ContextUniforms.cpp", "dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextBuffers.cpp", "dom/canvas/WebGLContextDraw.cpp", "dom/canvas/WebGLContextExtensions.cpp", "dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLContextState.cpp", "dom/canvas/WebGLContextTextures.cpp", "dom/canvas/WebGLContextUtils.cpp", "dom/canvas/WebGLContextUtils.h", "dom/canvas/WebGLContextValidate.cpp", "dom/canvas/WebGLContextVertexArray.cpp", "dom/canvas/WebGLFramebuffer.cpp", "dom/canvas/WebGLTexture.cpp", "dom/canvas/WebGLTextureUpload.cpp", "dom/canvas/WebGLTypes.h", "dom/canvas/moz.build"], "git_node": "45d076bf7bc3e9e5ceba0f59086c5f3fe911d377", "git_parents": ["2f369fbd7d0e671ba98bff985f4f714c9b59e27f"], "node": "ac0bcf3c773e9f1074d316b25790551cc5990f17", "parents": ["4e586ef6b0b67cf0d30f3c5cb319e0ac9a15b9cc"], "tags": []}, {"author": "Brendan Birdsong \u003cbbirdsong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079018 - Use PersistentCache for SponsoredTopSitesScoreProvider and enforce refresh intervals. r=mconley,ddurfee\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331832\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js"], "git_node": "90ef71682e7342114237dc3eee16aca95ab61e7c", "git_parents": ["45d076bf7bc3e9e5ceba0f59086c5f3fe911d377"], "node": "1a18c77cc3af1f4412e5bfdf7e0f85191ef1c878", "parents": ["ac0bcf3c773e9f1074d316b25790551cc5990f17"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2079548 - Make Fission the default geckoview-junit configuration and drop the no-fission variants r=geckoview-reviewers,RyanVM,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332258\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/FissionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoSessionTestRuleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoViewTest.kt", "taskcluster/kinds/test/misc.yml", "taskcluster/test_configs/variants.yml", "tools/tryselect/try_presets.yml"], "git_node": "e3b1ff298b9037ec4a7c6e48952bc450362b5bfc", "git_parents": ["90ef71682e7342114237dc3eee16aca95ab61e7c"], "node": "8a3f2f2563e89424a5b1bb7e59e13601d19c0da4", "parents": ["1a18c77cc3af1f4412e5bfdf7e0f85191ef1c878"], "tags": []}, {"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073353 - Remove unused metrics that cause shutdown hangs r=hsohaney,janerik\n\nCollecting these metrics is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327901\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/metrics.yaml", "browser/modules/test/unit/test_InstallationTelemetry.js", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/tests/unit/test_new_profile.js"], "git_node": "38f346e381d9d363139555145a02432822cb60bf", "git_parents": ["e3b1ff298b9037ec4a7c6e48952bc450362b5bfc"], "node": "ac20104d1869980d5878a457c1fd1ddd9064b78c", "parents": ["8a3f2f2563e89424a5b1bb7e59e13601d19c0da4"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059109 - Add jit-test for baseline try_table landing pad stackmaps. r=jseward\n\nThe test drives a try_table with a ref-typed block param whose landing pad\nrethrows, with a Debugger onExceptionUnwind hook forcing a minor GC during the\nunwind. Depends on the emitTryTable fix; without it, stackmaps in the landing\npad mark the dead param's spill slot live, so the GC traces a dangling pointer.\n\nDepends on D315721\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315722\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2059109.js"], "git_node": "f80536950ac7f2d6073c8a5b38663e6073fa2015", "git_parents": ["38f346e381d9d363139555145a02432822cb60bf"], "node": "d84e03f156db20ad40dee9d5ca56df15e6619257", "parents": ["ac20104d1869980d5878a457c1fd1ddd9064b78c"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061399 - Add a wasm Ion regression test. r=jseward\n\nDepends on D321589\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321590\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2061399.js"], "git_node": "ecc736d2895a56033d2ee97c9b657ea081dbf83e", "git_parents": ["f80536950ac7f2d6073c8a5b38663e6073fa2015"], "node": "fe3dc2f5444bfc01138465781c787227fed02efb", "parents": ["d84e03f156db20ad40dee9d5ca56df15e6619257"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073266 - Add a test for return calls from an imported function. r=rhunt\n\nDepends on D327347\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327348\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/imported-start.js"], "git_node": "b75be4098fd6369338edd7b35ed7455049abfe02", "git_parents": ["ecc736d2895a56033d2ee97c9b657ea081dbf83e"], "node": "76280ac14e29cdfcc62200eb0f387e0080d236b9", "parents": ["fe3dc2f5444bfc01138465781c787227fed02efb"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078245 - Add mozbuild's SOURCE_HEADERS linter r=ahochheiden\n\nLinter that verifies that every header that lives in a directory where\nthere's a moz.build is listed in that moz.build at least once.\n\nThis linter is not strict: for each existing literal, it checks if that\nheader is listed somewhere as a string literal. It does not check if\nit's added as a SOURCE_HEADERS, as an EXPORTS, in a GeneratedFile\nparameter etc.\n\nUnfortunately, it's not possible to perform that check dynamically\nbecause some headers may be guarded by a condition that does not hold\nunder current config, and they would raise a false positive.\n\nCurrent approach is pragmatic and does not raise any false Positive (but\nit could, if a name is dynamically generated).\n\nAlso add a missing header entry that slipped in while this linter was\nunder review.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331324\n", "files": ["browser/app/winlauncher/freestanding/moz.build", "docs/code-quality/lint/linters/source-headers.md", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/source-headers.yml", "tools/lint/source_headers/__init__.py", "tools/lint/test/files/source-headers/failure/local.h", "tools/lint/test/files/source-headers/failure/moz.build", "tools/lint/test/files/source-headers/failure/new-local.h", "tools/lint/test/files/source-headers/success/export-local.h", "tools/lint/test/files/source-headers/success/export.h", "tools/lint/test/files/source-headers/success/local.h", "tools/lint/test/files/source-headers/success/moz.build", "tools/lint/test/python.toml", "tools/lint/test/test_source_headers.py"], "git_node": "53fe5cd5b756bee8557a6d1f5124f4f925ef713f", "git_parents": ["b75be4098fd6369338edd7b35ed7455049abfe02"], "node": "548b69c75b1553501de089571bf373882f426a82", "parents": ["76280ac14e29cdfcc62200eb0f387e0080d236b9"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073065, always perform regex heurisics for address autofill, then ml can override results, r=dimi,credential-management-reviewers\n\nThe regular expression heuristics are performed for any field. ML inference is then performed on each field, unless the field type detected by heuristics is included in _getRegexpHeuristicFieldNames. This way, if ML fails or if the model is not available, the field type is still assigned and autofill still functions. ML is also not used for fields with an autocomplete attribute or those that fathon detects\n\nRemove the extensions.formautofill.useml.successful preference and instead perform a check to see if the model has been downloaded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329825\n", "files": ["browser/extensions/formautofill/test/browser/browser_dynamic_form_autocompletion.js", "browser/extensions/formautofill/test/browser/browser_ml_heuristics.js", "browser/extensions/formautofill/test/browser/browser_ml_ignore_field_types.js", "browser/extensions/formautofill/test/browser/browser_ml_mldata_features.js", "browser/extensions/formautofill/test/browser/browser_ml_native_onnx_availability.js", "browser/extensions/formautofill/test/browser/performance/browser_formautofill_ml_perf.js", "browser/extensions/formautofill/test/browser/performance/perftest.toml", "toolkit/components/formautofill/shared/FormAutofillHeuristics.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillML.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "4c244f519359a0dafc5a735e4bd0ab90ad185a3c", "git_parents": ["53fe5cd5b756bee8557a6d1f5124f4f925ef713f"], "node": "895fb9c88316d0b948be6c8bddf73560d80d8535", "parents": ["548b69c75b1553501de089571bf373882f426a82"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073065, add the regular expression hint to the ml tokens, r=dimi,rrando,credential-management-reviewers\n\nThe result of regular expression heuristics is used to generate a token of the form **hint\u003cfieldtype\u003e  and that token is prepended to the list of tokens used for ML inference, or **hintnone if heuristics does not detect a field type.\n\nThis is a similar patch to 2074252 but with the processing based on the calculated result of regex inference.\n\nThis also incorporates the changes to 2057296 so as not to include the bb/aa prefixes to ML tokens only to later strip them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329826\n", "files": ["browser/extensions/formautofill/test/browser/browser_ml_mldata_features.js", "browser/extensions/formautofill/test/unit/test_ml_regex_hint.js", "browser/extensions/formautofill/test/unit/xpcshell.toml", "modules/libpref/init/all.js", "toolkit/components/formautofill/shared/FormAutofillHeuristics.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillML.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "a945328a698365b49cbcce601b1eb9af7f2eba80", "git_parents": ["4c244f519359a0dafc5a735e4bd0ab90ad185a3c"], "node": "81060e7676ec92581b3d4767ba98ca748f94c0c5", "parents": ["895fb9c88316d0b948be6c8bddf73560d80d8535"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073065, fix issue in the case where the model doesn't know what type a field is but the heuristics do, r=dimi,credential-management-reviewers\n\nThe heuristic value should be used when the model returns 'other', and the ML model should not assign the reason if it does not understand the field. A test is added for this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331814\n", "files": ["browser/extensions/formautofill/test/browser/browser_ml_heuristics.js", "modules/libpref/init/all.js", "toolkit/components/formautofill/shared/FormAutofillML.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "aff22231ca7c5eff12c2aa2cb4798442af65f8c2", "git_parents": ["a945328a698365b49cbcce601b1eb9af7f2eba80"], "node": "dbac90dd1ae80d09051732680aa610703f17e991", "parents": ["81060e7676ec92581b3d4767ba98ca748f94c0c5"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/r