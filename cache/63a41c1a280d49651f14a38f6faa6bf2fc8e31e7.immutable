b4724cf9b0e6e5666a2df"], "user": "ffxbld@lando.moz.tools"}, "45620": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic newtab version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/extensions/newtab/manifest.json"], "git_node": "105142c648f51a2ed0aaf677acc6d2e793686e09", "git_parents": ["5feb1e1025ee05af089198a0678f5ad7a9284b24"], "node": "325ff8a5cc9e637e15d2644f3b7150784690a1fb", "parents": ["62c130d928c71c7ab4a4bc84ae124c3b899601c5"], "tags": []}], "date": 1792609853, "git_changesets": ["105142c648f51a2ed0aaf677acc6d2e793686e09"], "user": "ffxbld@lando.moz.tools"}, "45621": {"changesets": [{"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083647 - Attribute mochitest crashes to the manifest being run. r=ahal\n\nCrashes that happen before any test were reported in \"automation.py\", which\ncan't be mapped to a group in errorsummary.log, so the manifest's group wasn't\nmarked as failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335084\n", "files": ["testing/mochitest/runtests.py"], "git_node": "023fa61ec3fe8df290a10aab965c33d436bfd7a2", "git_parents": ["5feb1e1025ee05af089198a0678f5ad7a9284b24"], "node": "39390584b87982d064d35740531ae19c90758034", "parents": ["62c130d928c71c7ab4a4bc84ae124c3b899601c5"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2084363 - Long-press web content text through UiObject2 in BrowserPage.longClickWebContentText r=ajoltan\n\nThe long-press on the page text worked, but the old UiAutomator API reported it as failed because it expected a screen-update signal that Firefox\u2019s web text selection doesn\u2019t send, so the fix switches that long-press to the newer UiAutomator API, which doesn\u2019t wait for that signal and leaves the \u201cSelect all\u201d tap to confirm it worked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335789\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt"], "git_node": "e4c74917d84dc2d8c560ad91aa303a69fd4be315", "git_parents": ["023fa61ec3fe8df290a10aab965c33d436bfd7a2"], "node": "e1a126d3947fd0b37a19c30576ba80d66aca91a4", "parents": ["39390584b87982d064d35740531ae19c90758034"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054707 - Scope blob image external surface lookups to the process that produced the recording. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328087\n", "files": ["gfx/layers/ipc/SharedSurfacesParent.cpp", "gfx/layers/ipc/SharedSurfacesParent.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderDrawEventRecorder.cpp", "gfx/layers/wr/WebRenderDrawEventRecorder.h", "gfx/tests/fuzz/TestMoz2D.cpp", "gfx/tests/fuzz/moz2d_bin2cpp.py", "gfx/webrender_bindings/Moz2DImageRenderer.cpp", "gfx/webrender_bindings/src/bindings.rs", "gfx/webrender_bindings/src/moz2d_renderer.rs"], "git_node": "023574763c48efecec52959752c691fb305f5ef0", "git_parents": ["e4c74917d84dc2d8c560ad91aa303a69fd4be315"], "node": "c7a9b8e764afb98f72b05d980fba4fbb1ac13f17", "parents": ["e1a126d3947fd0b37a19c30576ba80d66aca91a4"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082476 - Add confirmation hint when navigating to a site inclusion - r=ip-protection-reviewers,fluent-reviewers,bolsson,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334184\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser.js", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser.toml", "browser/components/ipprotection/tests/browser/browser_ipprotection_confirmation_hints_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_confirmation_hints_site_inclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "browser/locales/en-US/browser/ipProtection.ftl", "toolkit/components/ipprotection/docs/Preferences.md"], "git_node": "dc9da41ccb3eaf63fc0da8b79812406d2cb8d495", "git_parents": ["023574763c48efecec52959752c691fb305f5ef0"], "node": "8bd5ed1b0e61ceffda69e0521d60e22d6e27db73", "parents": ["c7a9b8e764afb98f72b05d980fba4fbb1ac13f17"], "tags": []}, {"author": "Lauren Zugai \u003clauren@zugai.com\u003e", "branch": "default", "desc": "Bug 2080354 - Report whether the account holds the Sync key in the fxa_status web channel reply. r=sync-reviewers,markh\n\nFxA cannot tell a browser session that holds the Sync key from one that\ndoes not (e.g. a VPN or Relay sign-in that skipped the password), so it\nlets such a session start pairing, which then fails in the browser with\n\"No keyFetchToken\". Add signedInUser.hasSyncKey from\nkeys.hasKeysForScope(SCOPE_APP_SYNC), the same check UIState uses.\n\nThe key is unreadable while the Primary Password is locked, so also\nreport signedInUser.primaryPasswordLocked. Firefox's own Sync entry\npoints unlock it before opening FxA, so this only differs when FxA was\nreached directly; how FxA handles that is left to a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334608\n", "files": ["services/fxaccounts/FxAccountsWebChannel.sys.mjs", "services/fxaccounts/tests/xpcshell/test_web_channel.js"], "git_node": "67b3c1ec244c369d95dfd2ce6225b65e5478c2ed", "git_parents": ["dc9da41ccb3eaf63fc0da8b79812406d2cb8d495"], "node": "444df553fb50c7a735bee76ef324478a6799ea44", "parents": ["8bd5ed1b0e61ceffda69e0521d60e22d6e27db73"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081550. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335964\n", "files": ["image/SVGDocumentWrapper.cpp"], "git_node": "7a02db3396ccde78328d7979fe46ca47223c23e9", "git_parents": ["67b3c1ec244c369d95dfd2ce6225b65e5478c2ed"], "node": "dbbf704b880c5346a0bcb3746149e2d72c00023e", "parents": ["444df553fb50c7a735bee76ef324478a6799ea44"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083386 - Fall back to file copy if move fails. r=mac-reviewers,spohl\n\nMoves can fail on different volumes for example.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335802\n", "files": ["widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "fb344b5fca9a819b45d3ade8b5232391cbf803ce", "git_parents": ["7a02db3396ccde78328d7979fe46ca47223c23e9"], "node": "9dbb7dc30afa8f65fe92eab1cddf8bac984f2098", "parents": ["dbbf704b880c5346a0bcb3746149e2d72c00023e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084608 - Clean up handling of the mIsValid flag in gfxFont. r=layout-reviewers,dshin\n\nInitialize the flag to false during construction; and ensure\nall successful InitMetrics methods set mIsValid to true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335979\n", "files": ["gfx/thebes/gfxDWriteFonts.cpp", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxMacFont.cpp"], "git_node": "ee7aa3e9bb6c9642113781d67639d90af5d2f0c1", "git_parents": ["fb344b5fca9a819b45d3ade8b5232391cbf803ce"], "node": "c3906716292edd2151f7ac77deeab45dd2e8b065", "parents": ["9dbb7dc30afa8f65fe92eab1cddf8bac984f2098"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081783 - Unify the IP Protection status shown in the menus, trust panel and VPN settings. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335293\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/IPProtectionStatus.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/state/IPProtectionStatusTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/IPProtectionMenuBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/VpnMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPanelFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/IPProtectionMenuBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItemTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/VpnMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/IPProtectionScreenTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/TrustPanelStoreTest.kt"], "git_node": "7768e25dbbfd545ab157ea86e9fe44bfe9ee067c", "git_parents": ["ee7aa3e9bb6c9642113781d67639d90af5d2f0c1"], "node": "4f4154637ce62da55b61e0f4deb6605dd8f389c5", "parents": ["c3906716292edd2151f7ac77deeab45dd2e8b065"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072437: Serialize the cache-entry check with the cache-wait backstop and discard its state on timeout r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327235\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h"], "git_node": "5bc7f7a016a0db55d9f8380ae5b2e0a8d90677bc", "git_parents": ["7768e25dbbfd545ab157ea86e9fe44bfe9ee067c"], "node": "d402c9b2db005d954fdc896e22639732108cd3b5", "parents": ["4f4154637ce62da55b61e0f4deb6605dd8f389c5"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081887 p1 - Pre-generate the CrashEventID to use for a main process crash r=crashreporting-reviewers,gsvelto\n\nThis avoids running `GenerateUUID()` in the exception handler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335306\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/test/unit/head_crashreporter.js"], "git_node": "85f8b71a24403787dd2528c3e7c0faee7ad74155", "git_parents": ["5bc7f7a016a0db55d9f8380ae5b2e0a8d90677bc"], "node": "edb84d043dd40b52edc100ff9cf0914fb6751326", "parents": ["d402c9b2db005d954fdc896e22639732108cd3b5"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081887 p2 - Use an nsTAutoStringN to avoid heap allocation by NSID_TrimBracketsASCII r=saschanaz,crashreporting-reviewers,gsvelto\n\nThis allows us to use NSID_TrimBracketsASCII in async-signal-safe\ncontexts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335663\n", "files": ["xpcom/base/nsIDUtils.h"], "git_node": "b1f51ba82187e1b9da1d3000a4731f4a36e460f9", "git_parents": ["85f8b71a24403787dd2528c3e7c0faee7ad74155"], "node": "bf0800626179bf664ad9061340e669b9f0a46e28", "parents": ["edb84d043dd40b52edc100ff9cf0914fb6751326"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054707 - Scope blob image external surface lookups to the process that produced the recording. r=gfx-reviewers,lsalzman\" for causing build bustages @WebRenderBridgeParent.cpp.\n\nThis reverts commit 023574763c48efecec52959752c691fb305f5ef0.\n", "files": ["gfx/layers/ipc/SharedSurfacesParent.cpp", "gfx/layers/ipc/SharedSurfacesParent.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderDrawEventRecorder.cpp", "gfx/layers/wr/WebRenderDrawEventRecorder.h", "gfx/tests/fuzz/TestMoz2D.cpp", "gfx/tests/fuzz/moz2d_bin2cpp.py", "gfx/webrender_bindings/Moz2DImageRenderer.cpp", "gfx/webrender_bindings/src/bindings.rs", "gfx/webrender_bindings/src/moz2d_renderer.rs"], "git_node": "1412f02f1a0e428875afcf9eecf094b418b4cf2d", "git_parents": ["b1f51ba82187e1b9da1d3000a4731f4a36e460f9"], "node": "aac1bc399e36a734ce94969d474eecab721185f9", "parents": ["bf0800626179bf664ad9061340e669b9f0a46e28"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083043 - Swap in correct warning icon for delete error dialog in VPN site rules - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334673\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.mjs"], "git_node": "cc86dfa3894ac12abe2b892aff1deddd977c8aed", "git_parents": ["1412f02f1a0e428875afcf9eecf094b418b4cf2d"], "node": "afa98bf7cdbfd23b31e52f1f9d0c4a17fccb0ffa", "parents": ["aac1bc399e36a734ce94969d474eecab721185f9"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053492 - Quota manager: add telemetry for usage underflows. r=dom-storage-reviewers,janv\n\nWe added a bunch of telemetry in the scope of this bug, but those were based on QM_TRY and thus limited to nightly only.\n\nA few particular telemetry events have proven to be useful for investigation, so turn those particular ones into a dedicated telemetry, which will also reach release users.\n\nThose are:\n* decrease and truncate, per client type, to identify which clients are responsible for the underflows\n* global storage usage value, since underflow here is the one impacting quota operations\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334544\n", "files": ["dom/localstorage/LSSnapshot.cpp", "dom/localstorage/test/unit/test_usageUnderflowTelemetry.js", "dom/localstorage/test/unit/xpcshell.toml", "dom/quota/ActorsParent.cpp", "dom/quota/Assertions.cpp", "dom/quota/Assertions.h", "dom/quota/GroupInfo.cpp", "dom/quota/OriginInfo.cpp", "dom/quota/OriginInfo.h", "dom/quota/QuotaManager.h", "dom/quota/metrics.yaml"], "git_node": "5838a8b86148afdd3f0be3f34e440d489434fe69", "git_parents": ["cc86dfa3894ac12abe2b892aff1deddd977c8aed"], "node": "a3cf5dd832dba95f44c2d0f0df61fe9ab85c6073", "parents": ["afa98bf7cdbfd23b31e52f1f9d0c4a17fccb0ffa"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082607 - Part 1. Wait for new video bridge before creating remote video decoders while the compositor is recreated. r=media-playback-reviewers,padenot\n\nIf a remote video decoder is created after the compositor was lost, but before\nits process was given a new video bridge, it cannot share the decoded frames\nwith the new compositor until the video bridge is recreated. Creation now waits\nfor the new video bridge.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334282\n", "files": ["dom/media/ipc/RemoteDecoderParent.cpp", "dom/media/ipc/RemoteVideoDecoder.cpp", "dom/media/ipc/RemoteVideoDecoder.h", "gfx/layers/ipc/VideoBridgeChild.cpp", "gfx/layers/ipc/VideoBridgeChild.h"], "git_node": "2771daa18f44f9f991ce874d67a7ddbd3125644b", "git_parents": ["5838a8b86148afdd3f0be3f34e440d489434fe69"], "node": "d8070538e5b456ac0d98dfa5b74fdde50d1c540a", "parents": ["a3cf5dd832dba95f44c2d0f0df61fe9ab85c6073"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082607 - Part 2. Allow video decoders to get the TextureFactoryIdentifier of a content process from the compositor. r=gfx-reviewers,sotaro\n\nVideo decoders are given the TextureFactoryIdentifier by the content process,\nwhich may be from a compositor that no longer exists, e.g. if the decoder was\ncreated while the GPU process was being recreated. PVideoBridge now allows the\ndecoder process to ask the compositor for the identifier used by a content\nprocess instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334283\n", "files": ["gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/PVideoBridge.ipdl", "gfx/layers/ipc/VideoBridgeParent.cpp", "gfx/layers/ipc/VideoBridgeParent.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.h"], "git_node": "0c522bc3e7cf6e95d5164d647b895ef8221bfc8b", "git_parents": ["2771daa18f44f9f991ce874d67a7ddbd3125644b"], "node": "2db49e516efcc16c08f9b4318ddbaab1e28e0eba", "parents": ["d8070538e5b456ac0d98dfa5b74fdde50d1c540a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082607 - Part 3. Ask the compositor for the TextureFactoryIdentifier when creating remote video decoders. r=media-playback-reviewers,padenot\n\nThe identifier given by the content process may be from a compositor which no\nlonger exists, e.g. if the decoder was created while the GPU process was being\nrecreated. Remote video decoders now ask the compositor for the identifier used\nby the content process over their video bridge, so the content process no\nlonger gives one.\n\nIf the compositor cannot provide an identifier, decoders in the RDD and utility\nprocesses copy the decoded frames back to the content process, as they already\ndid when the content process did not give an identifier. Decoders in the GPU\nprocess fail instead so that another process may be used, as the content\nprocess previously did not create them there without a compositor. The\nKnowsCompositor for the decoder is now created when the decoder is constructed,\nrather than when the actor is created.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334284\n", "files": ["dom/media/ipc/PRemoteMediaManager.ipdl", "dom/media/ipc/RemoteAudioDecoder.cpp", "dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerParent.cpp", "dom/media/ipc/RemoteMediaManagerParent.h", "dom/media/ipc/RemoteVideoDecoder.cpp", "dom/media/ipc/RemoteVideoDecoder.h"], "git_node": "6f3066a651a218447c08853f981476c207eedc8c", "git_parents": ["0c522bc3e7cf6e95d5164d647b895ef8221bfc8b"], "node": "d71e0e964874778dfd800df5579c883d9fab8528", "parents": ["2db49e516efcc16c08f9b4318ddbaab1e28e0eba"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082607 - Part 4. Use the current image bridge for media element video decoders. r=media-playback-reviewers,padenot\n\nMediaDecoder gave the reader a KnowsCompositorMediaProxy for the document's\ncompositor, which kept the TextureFactoryIdentifier and image bridge from when\nit was created, and was only updated when the owner's activity changed. The\nreader no longer gives a compositor, and PDMFactory instead uses the current\nimage bridge in the content and parent processes whenever it creates a decoder\nthat was not given one, as WebCodecs and WebRTC already do, since it is replaced\nand given the new identifier when the compositor is reinitialized. This avoids\nusing a replaced image bridge when the decoder creation parameters are kept\nacross asynchronous steps, e.g. by MediaChangeMonitor or AllocationPolicy.\n\nThis also affects MediaCapabilities, which does not give a compositor when its\ndocument has none, e.g. in workers or tabs that have not been painted yet. Its\ndecoder probes now use the image bridge, once the content process has a\ncompositor, and so may now use the GPU process, as media element playback would.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334285\n", "files": ["dom/media/ChannelMediaDecoder.cpp", "dom/media/MediaDecoder.cpp", "dom/media/MediaDecoder.h", "dom/media/MediaFormatReader.cpp", "dom/media/MediaFormatReader.h", "dom/media/hls/HLSDecoder.cpp", "dom/media/mediasource/MediaSourceDecoder.cpp", "dom/media/platforms/PDMFactory.cpp"], "git_node": "37f624225e6dcb8a34cb06ff0556e86cf69173ed", "git_parents": ["6f3066a651a218447c08853f981476c207eedc8c"], "node": "6fa3eb08b69fb2451473fd578b4fe832edcd84a9", "parents": ["d71e0e964874778dfd800df5579c883d9fab8528"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084603 - Update freetype2 to 0eca44e6e819f9e156eee0de2cbbcffd3a59e47b r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335973\n", "files": ["modules/freetype2/include/freetype/internal/ftcalc.h", "modules/freetype2/moz.yaml", "modules/freetype2/src/base/fttrigon.c", "modules/freetype2/src/truetype/ttgload.c", "modules/freetype2/src/truetype/ttgxvar.c"], "git_node": "8f8b7e005c948b938034cb73cf1edad0448f19fa", "git_parents": ["37f624225e6dcb8a34cb06ff0556e86cf69173ed"], "node": "33b71000ce1814f2afa8fb396df2dcddf194cfad", "parents": ["6fa3eb08b69fb2451473fd578b4fe832edcd84a9"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2076009 - Pass expected add-on details when installing recommended+builtin add-ons r=robwu,devtools-reviewers,maxx,nchevobbe\n\nTake care to pass the expected id/type/version when installing recommended and\nbuiltin add-ons.\n\nTesting:\n\nADB extension:\n1. Launch Firefox `./mach run --temp-profile -- about:debugging#/setup`\n2. Click \"Enable USB Devices\"\n3. Ensure \"USB Enabled\" is displayed after the add-on is installed.\n\nRecommended:\n1. Launch Firefox `./mach run --temp-profile -- about:addons`\n2. Click to install one of the listed recommended add-ons.\n3. Likewise for one of the recommended themes.\n4. Ensure they were both installed successfully.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333214\n", "files": ["browser/components/newtab/AboutNewTabResourceMapping.sys.mjs", "devtools/client/shared/remote-debugging/adb/adb-addon.js", "toolkit/mozapps/extensions/content/components/recommended-addon-card.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_warning_messages.js", "toolkit/mozapps/extensions/test/browser/browser_installssl.js", "toolkit/mozapps/extensions/test/xpcshell/test_signed_verify.js", "toolkit/mozapps/extensions/test/xpcshell/test_system_upgrades.js"], "git_node": "d002b970fbe24edd2829b2fb9e2daf16e67cde28", "git_parents": ["8f8b7e005c948b938034cb73cf1edad0448f19fa"], "node": "1a3c115b0d3fe0dfec55128ae0983d5089de9065", "parents": ["33b71000ce1814f2afa8fb396df2dcddf194cfad"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2076009 - Pass expected add-on details when installing locales+dictionaries r=robwu,settings-reviewers,tgiles\n\nTake care to pass the expected id/type/version when installing locales and\ndictionaries. Also fix a bug so that telemetryInfo.source is passed correctly\nwhen installing locales.\n\nTesting:\n1. Launch the browser with language packs available:\n```bash\n./mach run --temp-profile \\\n  --setpref browser.settings-redesign.enabled=true \\\n  --setpref intl.multilingual.enabled=true \\\n  --setpref intl.multilingual.downloadEnabled=true \\\n  --setpref extensions.checkCompatibility.nightly=false \\\n  --setpref 'extensions.getAddons.langpacks.url=https://services.addons.mozilla.org/api/v4/addons/language-tools/?app=firefox&type=language&appversion=158.0' \\\n  -- 'about:preferences#languages'\n```\n2. Click the \"Preferred language\" drop-down\n   (if no options are listed, wait a few seconds and try again.)\n3. Select a different language (e.g. German), then click \"Apply and Restart\".\n4. Ensure your language was updated after the browser restarts.\n5. Navigate to `about:addons`, then make sure both the language pack and\n   dictionary are listed and enabled for the language you picked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333215\n", "files": ["browser/components/preferences/dialogs/browserLanguages.js", "browser/components/preferences/tests/languages/browser_browser_languages_subdialog.js", "intl/locale/LangPackMatcher.sys.mjs", "intl/locale/tests/unit/test_langPackMatcher_install.js", "intl/locale/tests/unit/xpcshell.toml", "toolkit/mozapps/extensions/internal/AddonRepository.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_AddonRepository_langpacks.js"], "git_node": "f77a54f6530b0d95b8c0ee7293577b290cdb0925", "git_parents": ["d002b970fbe24edd2829b2fb9e2daf16e67cde28"], "node": "fd13ceb5ac0b75b73706101e21932e2517a9d905", "parents": ["1a3c115b0d3fe0dfec55128ae0983d5089de9065"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2076009 - Pass expected add-on details when installing themes r=robwu,desktop-theme-reviewers,tgiles,mossop\n\nTesting:\n1. Launch Firefox: `./mach run --temp-profile -- about:addons`\n2. Click the \"Install\" button by one of the listed themes.\n3. Ensure the theme is installed and activated successfully.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333216\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/themes/ThemesList.sys.mjs", "browser/themes/test/unit/test_ThemesList.js", "toolkit/components/extensions/parent/ext-management.js"], "git_node": "1de818390fb8ad9814d119c0fdca03933d8a2769", "git_parents": ["f77a54f6530b0d95b8c0ee7293577b290cdb0925"], "node": "e5d4443caca84f4c9dff9bdb6f39457de3dbfa39", "parents": ["fd13ceb5ac0b75b73706101e21932e2517a9d905"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2076009 - Pass expected add-on details when importing/syncing add-ons r=robwu\n\nTesting:\n\nImporting:\n1. Install Dark Reader extension[1] in Google Chrome.\n2. Quit Chrome.\n3. Run Firefox: `./mach run --temp-profile -- 'about:preferences#general-migrate'`\n4. Select Chrome, and click the \"Import\" button.\n5. Ensure at least one extension is imported. Click \"Done\".\n6. Navigate to `about:addons#extensions` and click \"Install Extensions\" to\n   finalise the installation of the imported extension(s).\n\nSync:\n1. Ensure your main Firefox profile has at least one extension installed, and\n   you are logged in for sync.\n2. Run Firefox: `./mach run --temp-profile`.\n3. Click the hamburger menu, and then \"Sign in\" by \"Sync and Save Data\".\n4. Sign in to your account.\n5. Ensure your extensions are automatically installed.\n\n1 - https://chromewebstore.google.com/detail/dark-reader/eimadpbcbfnmbkopoojfekhnkhdbieeh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333217\n", "files": ["services/sync/modules/addonutils.sys.mjs", "toolkit/mozapps/extensions/AddonManager.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_AMBrowserExtensionsImport.js"], "git_node": "e7c2456a5f6be9ef682bc27d62e35660c90ea308", "git_parents": ["1de818390fb8ad9814d119c0fdca03933d8a2769"], "node": "9a0acd35eab741bc6f6dabeca02188667652d488", "parents": ["e5d4443caca84f4c9dff9bdb6f39457de3dbfa39"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2076009 - Pass expected add-on details when installing through enterprise policies r=robwu,mkaply\n\nProvide the add-on type and version for add-ons that are being installed via\nenterprise policies, if known. While we're at it, let's refactor\n`PoliciesHelpers.installAddonFromURL()` slightly, to make the parameter names\nand structure more closely follow the conventions of related add-on installation\ncode (e.g. `AddonManager.getInstallForURL()`).\n\nNote: Add-on version mismatches in update_url manifests are now a hard failure.\n\nTesting:\n1. Write this policy.json file somewhere on disk:\n```json\n{\n  \"policies\": {\n    \"ExtensionSettings\": {\n      \"addon@darkreader.org\": {\n        \"installation_mode\": \"force_installed\"\n      }\n    }\n  }\n}\n```\n2. Launch Firefox with that policy:\n```bash\n./mach run --temp-profile \\\n           --setpref browser.policies.alternatePath=/PATH/TO/policy.json \\\n           -- about:addons\n```\n3. Check that the Dark Reader extension was installed successfully.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333218\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_extensionsettings.js", "browser/components/enterprisepolicies/tests/xpcshell/test_extensionsettings_install_without_url.js", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs"], "git_node": "771345a2329496952831204eeebb3d870c6b930d", "git_parents": ["e7c2456a5f6be9ef682bc27d62e35660c90ea308"], "node": "245934a9075d21ac8242cf660fdf47a7a0fbefa7", "parents": ["9a0acd35eab741bc6f6dabeca02188667652d488"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2000604 - Add webcompat intervention for bam.barrister.com; r=webcompat-reviewers,ksenia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335703\n", "files": ["browser/extensions/webcompat/data/interventions/2000604-bam.barrister.com.json", "browser/extensions/webcompat/injections/js/bug2000604-bam.barrister.com-firebase-undefined-error-stack.js", "browser/extensions/webcompat/manifest.json", "testing/webcompat/interventions/tests/test_2000604_bam_barrister_com.py"], "git_node": "347adbc571fdacbe7ec60af9f7540bed0fd6313a", "git_parents": ["771345a2329496952831204eeebb3d870c6b930d"], "node": "aa93fd399047024b373e5a6c046297cf73de8398", "parents": ["245934a9075d21ac8242cf660fdf47a7a0fbefa7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084627 - Expose service-merino-manifest as an api dependency of browser-icons. r=android-reviewers,android-build-system-reviewers,mcarare\n\nThe public BrowserIcons constructor takes a MerinoManifestProvider with a default value, so consumers outside\nandroid-components need the type on their compile classpath. Kotlin 2.5 warns when it is missing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335984\n", "files": ["mobile/android/android-components/components/browser/icons/build.gradle"], "git_node": "13467697fe1e04fc48d851dae6431e744d11bcfd", "git_parents": ["347adbc571fdacbe7ec60af9f7540bed0fd6313a"], "node": "e20da68116e5660b82ce508d7dba25f452488375", "parents": ["aa93fd399047024b373e5a6c046297cf73de8398"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081550. r=layout-reviewers,dshin\" for causing build bustages @SVGDocumentWrapper.cpp.\n\nThis reverts commit 7a02db3396ccde78328d7979fe46ca47223c23e9.\n", "files": ["image/SVGDocumentWrapper.cpp"], "git_node": "37185f34fc4f6199369f1e2bc9140952b06caa04", "git_parents": ["13467697fe1e04fc48d851dae6431e744d11bcfd"], "node": "1953e31365ccd7e94c2fd5fdd478a2486ee92aaa", "parents": ["e20da68116e5660b82ce508d7dba25f452488375"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083043 - Swap in correct warning icon for delete error dialog in VPN site rules - r=ip-protection-reviewers,mcleinman\" for causing bc failures @ browser_privacy_ipprotection_siterules_srd.js\n\nThis reverts commit cc86dfa3894ac12abe2b892aff1deddd977c8aed.\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.mjs"], "git_node": "fa6780c91e3915de993cd92eb27f7eb6bb106ac0", "git_parents": ["37185f34fc4f6199369f1e2bc9140952b06caa04"], "node": "8526775787fb63c09c9783f96a7c492a25c6eb2e", "parents": ["1953e31365ccd7e94c2fd5fdd478a2486ee92aaa"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2061331: Plug these leaks a little better. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335811\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_component.cpp"], "git_node": "4100024516a12a469337ec3c1dc95b8bf9d52f54", "git_parents": ["fa6780c91e3915de993cd92eb27f7eb6bb106ac0"], "node": "400fd280c7cf7335da67191b1bd3dcde0c6100a3", "parents": ["8526775787fb63c09c9783f96a7c492a25c6eb2e"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079974 - Only count SERP ad clicks for document loads - r=Standard8\n\nSome providers send non-document requests, such as tracking pixels on hover,\nto the same endpoint used for ad click navigations. These can count ad\nclicks even though the user didn't click anything.\n\nThis adds a requireDocumentLoadForAdClick provider option so the check can\nbe enabled per provider via Remote Settings, and turned off again if it ends\nup excluding genuine ad clicks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332454\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/schema/search-telemetry-v2-schema.json", "browser/components/search/schema/search-telemetry-v2-ui-schema.json", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sources_ads_clicks.js"], "git_node": "a2d15d145478a6d0df008c6ae0f4342eed5c9e2e", "git_parents": ["4100024516a12a469337ec3c1dc95b8bf9d52f54"], "node": "7d14a3b500eb3b5b8bc871a2240ae2d477bdb0d4", "parents": ["400fd280c7cf7335da67191b1bd3dcde0c6100a3"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079978 - Add ad_brand_zone as a SERP telemetry ad component - r=search-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332457\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/metrics.yaml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_domain_categorization_ad_values.js"], "git_node": "d387567baf09d2fa2025c8a6dd1ff3ee2c4d8673", "git_parents": ["a2d15d145478a6d0df008c6ae0f4342eed5c9e2e"], "node": "407b14ad5b637a442d7cc7d891a638524a5684b0", "parents": ["7d14a3b500eb3b5b8bc871a2240ae2d477bdb0d4"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081949: Discard state from a previous cache-entry check when the entry is checked again r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333972\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "a5b7e3ee01db19f06030d77d9b67cd5b1bd4fd65", "git_parents": ["d387567baf09d2fa2025c8a6dd1ff3ee2c4d8673"], "node": "25392a5b4c5dcdf1e276bc355ed7158716bbf2c1", "parents": ["407b14ad5b637a442d7cc7d891a638524a5684b0"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084264 - Resolve the extraction directory once per archive when validating tar members. r=releng-reviewers,bhearsum\n\nEvery file of a test archive re-defines the real path of the extraction directory again and again across tens of thousands of files.\n\nThis just makes it so the relative path is passed in rather than re-defined every single time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335358\n", "files": ["testing/mozharness/mozharness/base/script.py"], "git_node": "add3ad5c8e3490a3f145f6198508017672db76fc", "git_parents": ["a5b7e3ee01db19f06030d77d9b67cd5b1bd4fd65"], "node": "a0408f1bb224a95cb189401625d235c04ee048ba", "parents": ["25392a5b4c5dcdf1e276bc355ed7158716bbf2c1"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082631 - Keep failed IPP system activations in the ERROR state r=ip-protection-reviewers,rking\n\nA failed system activation (start-on-boot, auto-restore, or inclusions ) fell back to READY and dropped the channel\nfilter, so traffic went direct and later triggers started it again.\n\nIt now keeps the filter and stays in ERROR until stop(). User\nactivations are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335251\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/Constants.md", "toolkit/components/ipprotection/docs/StateMachine.md", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "4a4154a75371d323d814b84e72218ea152060aad", "git_parents": ["add3ad5c8e3490a3f145f6198508017672db76fc"], "node": "8abeeca13ab7e50ae4c1e630c42f1395596c2c09", "parents": ["a0408f1bb224a95cb189401625d235c04ee048ba"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082631 - Don't restart IPP auto-activation after the proxy failed r=ip-protection-reviewers,rking\n\nEvery way back to READY looked idle to IPPAutoActivation, so it started the\ninclusion connection again right after the user stopped a failed one, or after\nthe user's own retry failed.\n\nIt now only restarts when a working connection goes back to READY, using the\nprevState now carried by IPPProxyManager:StateChanged. A rule change or the\nservice becoming ready still starts it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335253\n", "files": ["toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/StateMachine.md", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js"], "git_node": "0f5c675097f6571d6800ea871d9da624f0c429ea", "git_parents": ["4a4154a75371d323d814b84e72218ea152060aad"], "node": "e523a368a60e9154805d3759bb68ad42bfab8762", "parents": ["8abeeca13ab7e50ae4c1e630c42f1395596c2c09"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082631 - Let the user retry a failed IPP connection r=ip-protection-reviewers,rking\n\nstart() refused to run while the proxy was in ERROR, so turning the VPN on\ndid nothing after a failure, e.g. of the inclusion connection.\n\nA user start out of ERROR is now a retry: it tears the failed connection down\nsilently and moves straight to ACTIVATING. The shared teardown moves to\n#stopInternal(). System starts are still refused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335255\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/StateMachine.md", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "70879109d78e3faecc457a67231f05ac10b981dd", "git_parents": ["0f5c675097f6571d6800ea871d9da624f0c429ea"], "node": "d77ca681431de8886dacb020d97f08fa0947a48a", "parents": ["e523a368a60e9154805d3759bb68ad42bfab8762"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082631 - Fail proxied requests while IPPProxyManager is in ERROR r=ip-protection-reviewers,rking\n\nIn ERROR the channel filter kept proxied requests pending, and both stop()\nand a retry aborted them later, leaving the tab blank either way.\n\nIPPChannelFilter.fail() now cancels queued and new proxied requests with\nNS_ERROR_PROXY_CONNECTION_REFUSED, so documents show the proxy error page.\nEntering ERROR always does this, so the state never means maybe-working.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335257\n", "files": ["toolkit/components/ipprotection/IPPChannelFilter.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/StateMachine.md", "toolkit/components/ipprotection/tests/xpcshell/head.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPChannelFilter.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "c8dddd61352d63e733ee10d7304e0accbbf3c0da", "git_parents": ["70879109d78e3faecc457a67231f05ac10b981dd"], "node": "25e5f4a62aa7f5e570ef6f3f11da17bf1bab97b6", "parents": ["d77ca681431de8886dacb020d97f08fa0947a48a"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077086 - Fix crash in [@ java.lang.IllegalStateException: at okio.Buffer$$ExternalSyntheticBUOutline3.m(R8$$SyntheticClass:3)] r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335801\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragment.kt"], "git_node": "11289bfded2b9af6ab496f8753901c375eb84df3", "git_parents": ["c8dddd61352d63e733ee10d7304e0accbbf3c0da"], "node": "427f36a603152a273edd9d294f70e091eeb67cf4", "parents": ["25e5f4a62aa7f5e570ef6f3f11da17bf1bab97b6"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084352 - Run Python unbuffered on Android device tasks so their logs stream. r=taskgraph-reviewers,mozperftest-reviewers,bhearsum,kshampur\n\nOutput on the Bitbar and LambdaTest workers is block-buffered: mozharness log lines arrive minutes late, and mozperftest output only appears when the task exits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335317\n", "files": ["taskcluster/gecko_taskgraph/transforms/job/mozharness_test.py", "taskcluster/kinds/perftest/android.yml"], "git_node": "776d0c2e9ac6ca63d63ce4437f5c5417200a3ab7", "git_parents": ["11289bfded2b9af6ab496f8753901c375eb84df3"], "node": "a76e6b22c413574f5b99447b3cf4b15abefea0bd", "parents": ["427f36a603152a273edd9d294f70e091eeb67cf4"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083648 - Fix register encoding when relocating RIP-relative instructions into x64 trampolines. r=win-reviewers,gstoll\n\nThe relocation of REX-prefixed RIP-relative MOV and LEA ignored REX.R and\nkept the original REX byte, so e.g. `mov r10, [rip+x]` loaded into rdx\ninstead. It also turned RIP-relative stores into loads and emitted invalid\nencodings for rsp/rbp/r12/r13. RIP-relative stores and loads into rsp are\nnow refused instead, as they would require saving a scratch register on\nthe stack or moving rsp to an arbitrary address.\n\nThis also fixes the jump type detection for REX.W `jmp/call [rip+x]`, which\nread a displacement byte instead of the ModR/M byte, refuses the `40 38`\ncmp path for spl because it pushes r11 first, computes the length of `xor`\ninstructions with memory operands correctly, and computes the address of\n`cmp byte ptr [rip+x], imm8` from the end of the instruction rather than\nfrom the end of the displacement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335129\n", "files": ["toolkit/xre/dllservices/mozglue/interceptor/PatcherDetour.h"], "git_node": "cdd19c06e91a50f75e98ba74a9848fee3de44146", "git_parents": ["776d0c2e9ac6ca63d63ce4437f5c5417200a3ab7"], "node": "8b25746181e932b750681f4343de53cc6fce3e9c", "parents": ["a76e6b22c413574f5b99447b3cf4b15abefea0bd"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083648 - Test relocation of RIP-relative instructions into x64 trampolines. r=win-reviewers,gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335130\n", "files": ["toolkit/xre/dllservices/tests/AssemblyPayloads.h", "toolkit/xre/dllservices/tests/TestDllInterceptor.cpp"], "git_node": "fe272efde5975bc41aa9de795f18c92293ad0b30", "git_parents": ["cdd19c06e91a50f75e98ba74a9848fee3de44146"], "node": "09a1a91643bbdd6e695e940f19757c664314da21", "parents": ["8b25746181e932b750681f4343de53cc6fce3e9c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2083267 - Ignore the zip extraction advisories in cargo-audit until zip is upgraded r=supply-chain-reviewers,afranchuk DONTBUILD\n\nRUSTSEC-2026-0367, RUSTSEC-2026-0368 and RUSTSEC-2026-0369 are about\nZipArchive::extract() and ZipStreamReader::extract(). Neither geckodriver\nnor the crash reporter client calls them. Drop these waivers with the\nzip 9 upgrade in this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335970\n", "files": [".cargo/audit.toml"], "git_node": "1621dfe1834d904e80d2057909d8e42d11850c19", "git_parents": ["fe272efde5975bc41aa9de795f18c92293ad0b30"], "node": "a5505c863d16b07eff1b07f8abb7cabad09a1776", "parents": ["09a1a91643bbdd6e695e940f19757c664314da21"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084551 - Publish the build tooling SBOM alongside the other release artifacts r=releng-reviewers,taskgraph-reviewers,jcristau\n\nThe desktop shippable builds have uploaded sbom-build-tooling.json since\nbug 2075753, but the beetmover manifests only list sbom.json, so it never\nreaches archive.mozilla.org. The universal mac tasks re-upload the\nper-architecture ones as sbom-build-tooling-x86_64.json and\nsbom-build-tooling-aarch64.json, like they already do for sbom.json.\n\nFenix generates its SBOM with mach sbom in build-apk rather than from the\nbuild, so it now runs it a second time with --build-tooling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335928\n", "files": ["taskcluster/android_taskgraph/manifests/apk_candidates.yml", "taskcluster/android_taskgraph/transforms/build_android_app.py", "taskcluster/gecko_taskgraph/manifests/firefox_candidates.yml", "taskcluster/gecko_taskgraph/manifests/firefox_nightly.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/scripts/misc/unify.sh"], "git_node": "b728c2f204c7be5c40e2cd3ac2619ca8a21715a6", "git_parents": ["1621dfe1834d904e80d2057909d8e42d11850c19"], "node": "eab15c5830e591f5745388125d8f7a4e64b95d3c", "parents": ["a5505c863d16b07eff1b07f8abb7cabad09a1776"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084538 - Disable the profiler toolbar button while capturing a profile. r=profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335931\n", "files": ["browser/themes/shared/toolbarbutton-icons.css", "devtools/client/performance-new/popup/menu-button.sys.mjs", "devtools/client/performance-new/test/browser/browser_popup-profiler-states.js", "devtools/client/performance-new/test/browser/browser_split-toolbar-button.js"], "git_node": "0a69b6caebb3501758b2c76357d131e7d7fc1275", "git_parents": ["b728c2f204c7be5c40e2cd3ac2619ca8a21715a6"], "node": "e0c0e92309583f2191ee456e1c069493f1757ec0", "parents": ["eab15c5830e591f5745388125d8f7a4e64b95d3c"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084588: Restore the native Open in Preview print workflow. r=emilio\n\nBug 1372506 (D326234) enabled `print.experimental.skpdf` beyond Nightly, exposing the existing `tmp-printing.pdf` Preview path to release users. Using the native print session should restore the document title and Preview's save workflow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335981\n", "files": ["widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "71d29a3b488dedf5a33efc69087d23773e6bf480", "git_parents": ["0a69b6caebb3501758b2c76357d131e7d7fc1275"], "node": "2b81c9c3f1b1cfd80b6ccafd2daa5dd4da8d82f7", "parents": ["e0c0e92309583f2191ee456e1c069493f1757ec0"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084534 - Update the Reader mode access point icon on the toolbar r=android-reviewers,ltokhtamuradova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335942\n", "files": ["mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_reader_view_audio_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_reader_view_audio_fill_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_reader_view_headphones_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_reader_view_headphones_fill_24.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt"], "git_node": "67e88e4df06016e962a8b8987d3f56bc39b5c15c", "git_parents": ["71d29a3b488dedf5a33efc69087d23773e6bf480"], "node": "a4b3b3b7e2511e6b73439a25f9bf26a2913875bd", "parents": ["2b81c9c3f1b1cfd80b6ccafd2daa5dd4da8d82f7"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081333 - Fallback to using device language when the page returns no language r=android-reviewers,android-build-system-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335605\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/content/ContentProvider.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/content/ContentProviderTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPage.kt"], "git_node": "718fde765985e177b964f3bd45fbd7527bf912e6", "git_parents": ["67e88e4df06016e962a8b8987d3f56bc39b5c15c"], "node": "c30fc29e166d67b70a192948033003bb87cf5326", "parents": ["a4b3b3b7e2511e6b73439a25f9bf26a2913875bd"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083956 - Answer a Smart Page modification with a chat reply and reload the open page. r=ai-security-reviewers,tetchart,omarg\n\nA modified page is already open or linked from the chat, so the open card only makes sense for a new page. The model replies instead, and the selected tab reloads when it shows the modified page so it displays the new version.\n\n(Note this is currently based on Autoland due to some dependencies)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335420\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab.js", "browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js"], "git_node": "43fa979ce00b9b77ff6cc3e4b9d48751c44b5fb7", "git_parents": ["718fde765985e177b964f3bd45fbd7527bf912e6"], "node": "0abb58f27d9163cde18f3704449c5ecab150c957", "parents": ["c30fc29e166d67b70a192948033003bb87cf5326"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2083919 - Reduce UiAutomator idle wait during audio playback in mediaSystemNotificationInPrivateModeTest r=jajohnson\n\nThe looping audio player keeps the screen from going idle, so each UiAutomator lookup during playback waited the full 10s default idle timeout. Let tests opt into a shorter idle timeout through their execution requirements, which the test environment applies and restores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335400\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/EfficiencyExecutionContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/EfficiencyTestRule.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MediaNotificationTest.kt"], "git_node": "b4a92f588c8e4e98e2627e64ab2601d2dda7514e", "git_parents": ["43fa979ce00b9b77ff6cc3e4b9d48751c44b5fb7"], "node": "1199922753a097967fcca26b1fd7cc150404bde8", "parents": ["0abb58f27d9163cde18f3704449c5ecab150c957"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082730 - Update xshell-venv with a fix to properly reuse defined venvs r=TravisLong,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335945\n", "files": ["Cargo.lock", "supply-chain/audits.toml", "supply-chain/imports.lock", "third_party/rust/xshell-venv/.cargo-checksum.json", "third_party/rust/xshell-venv/.cargo_vcs_info.json", "third_party/rust/xshell-venv/.github/workflows/test.yml", "third_party/rust/xshell-venv/Cargo.lock", "third_party/rust/xshell-venv/Cargo.toml", "third_party/rust/xshell-venv/Cargo.toml.orig", "third_party/rust/xshell-venv/src/lib.rs"], "git_node": "73d2a1c16593e0e9197b614d58b9c16c062e671b", "git_parents": ["b4a92f588c8e4e98e2627e64ab2601d2dda7514e"], "node": "90d88219c87fac2ba11fd5a2fdc028fd33b330e9", "parents": ["1199922753a097967fcca26b1fd7cc150404bde8"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["mobile/android/android-components/components/ui/icons