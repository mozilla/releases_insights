d7ba2c34a", "1928c80b890de2e720c3b8ff293cc45f64c59c9d", "a78ab6586cb85ca145610ead8d7844a57df18003", "96eb774681eb9cd2cadf2e86ae684b8f5ee85185", "4de774a7bc5f123c60f1be5bdc0415948fa9c21f", "a1c7b86c0dd2b92e7d093707cf799573bb9336d0", "928594629d7aba1176de029f0ed230725c4c6766", "f376ed736c6e0ba408104f439a5b2c40cc4ca1cd", "a038432aa81fbe91111c1e8c786ca1ddb2e95a14", "9525291c21fc61fee34159e1b48ac61b4579cfbb", "77689c92128a625a6bf45b9afb10aa13e9262723", "0ca205adf8ce6581abb52f57ec08140ff7668dc6", "be9336bab1d2d2d66a99c3965b0714cd6652b3d1", "6da6aa3e26080eedbf76a06cc4c642bb7110a8e6", "5da0f66d7e818cf34fc834d68e1802c3cd766b87", "be9de3260f869e9dfd3d824f8a2ffaa2d5eb621d", "be7d145c23500010e93f998d23ebe68ec982ffdf", "b3a1aea7362829e123f5798636e4d2b67c45f419", "0da07d05c269353dbc6360ac6a4fafbd88de329e", "34d8cfb1fb890dd376c322fe16df316075ea131c", "9e68f465f4ca9f106d50eaf270181ee25e2834eb", "c978fb89e5fa9b31cb65f58382535d2e294743b8", "76e74903d6b126b47ccf189208aaf119f6ec51d7", "bf1de2fa7c27296225416b949015c71f0e5699a3", "094cddd552ba4e2b95954abd6f8a9ebb5e24c1f8", "5940e568d5b59b9b2f46d59c6cb622c5a101f408", "19603a862bb67a5d9bb87edf6083372c2685aba7", "ef62dfcf82cc7a17918e6ab6f36efd39ed81d069", "bccb6d9cf28debe29ffa5a80aa4349b204e2d008", "bcf0d6e4190e40b3bdb411f3d7ee1d76471e70fe", "fb7014bd59fb407dab785f62231f80fce1af52ba", "3c17cb7aeb97e7467e81f3dd9051f1fbabc8cdd5", "397cb80b12f35fad95bf9b509569ea92739547d3", "1b510cdbc687bc789cb19459f65b8741c0e06443", "491452d61fc2cbf4dc27ac899f4b0dff618ba0ff", "b0dec618dc5d00cb69ecf429760626cd40d08682", "ebed9843171426378332d2caf9c8e6850143ac61", "1840c61b7e6750130879757cbe65761a4b58c8e5", "bfb11933e1718176eb547303f4029e3d072ec5e0", "372054806763ea318202cde0a3a3a887c527df9a", "0707610ebb5925caedf3ef9a53297533586f00c3", "ba2521c08bb5c15e1673cc0d9e23610afb2edb39", "81cf801eb5c4d13d9eda9548f796dabf9836f89a", "f3afc6070391e920c60a0b6212aa44351bff428f", "34ae62af242280ddafd049af823fa6ed3bcafc7b", "a45db0dd1294e969dc87bb8e3aa2959169206924", "8ad80f9a1ec0ac7721fe5aa5770f728af80e48c3", "574ad298cfb6fc8c1c01a35df5f1600767f37c4f", "5c124bc00a6d475d4ea42297cb60de9bf5884844"], "user": "rperta@mozilla.com"}, "45566": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079284 - Add a try preset for the WPT eme-signed jobs that reuses signed mozilla-central builds. r=taskgraph-reviewers,bhearsum\n\nOn Windows and macOS, Widevine needs VMP signed builds, which try cannot\nproduce. The new --use-indexed-tasks option reuses an indexed task in place\nof a given label, so the preset can take the latest signed mozilla-central\nbuilds while the test packages, and thus the annotations, still come from\nthe push.\n\nReusing a signing task isn't possible while the build it depends on still\nruns on try, so a test requiring signed builds installs directly from the\nreused signing task instead of depending on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332035\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/__init__.py", "tools/tryselect/task_config.py", "tools/tryselect/test/test_task_configs.py", "tools/tryselect/try_presets.yml"], "git_node": "ceaa63fb4c0e27f5555d0427eb03afa0ab676bce", "git_parents": ["5c124bc00a6d475d4ea42297cb60de9bf5884844"], "node": "42179b1f842c06dda1fcf5ffeac00b7ee248df14", "parents": ["31bff714a4aeddf9bbf2f126dfbf0c57c807b953"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081667 - Stop running the address migration dry run in Nightly r=joschmidt,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333596\n", "files": ["modules/libpref/init/all.js"], "git_node": "537b3c73f43dbbd64c810aef6788bd846b1e1198", "git_parents": ["ceaa63fb4c0e27f5555d0427eb03afa0ab676bce"], "node": "f4cfb8afdef45b10382f5c749aaccb68c0397b8b", "parents": ["42179b1f842c06dda1fcf5ffeac00b7ee248df14"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076596 - Type-check tab-hover-preview.mjs. r=tabbrowser-reviewers,jswinarton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329859\n", "files": ["browser/components/tabbrowser/content/tab-hover-preview.mjs", "browser/components/tabbrowser/tsconfig.json"], "git_node": "d0d0d146a33ad3c8b6f8fa096db1d465aa2a3c8f", "git_parents": ["537b3c73f43dbbd64c810aef6788bd846b1e1198"], "node": "f1011f4e77941d2d0700e5d430c017844439fa19", "parents": ["f4cfb8afdef45b10382f5c749aaccb68c0397b8b"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012176 - Use the best-onnx backend for PDF.js alt-text generation. r=ai-platform-reviewers,pdfjs-reviewers,nordzilla,calixte\n\nPDF.js requested onnx-native directly, so engine creation failed wherever the\nnative ONNX runtime can't be loaded, such as distribution builds that don't\nship it. best-onnx keeps onnx-native where it is available and falls back to\nthe wasm onnx backend otherwise.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333723\n", "files": ["toolkit/components/pdfjs/content/PdfJsParent.sys.mjs"], "git_node": "95eac0e3f8dda4f4ca2eac303c4b2f40e8a080cb", "git_parents": ["d0d0d146a33ad3c8b6f8fa096db1d465aa2a3c8f"], "node": "f22b8bcb086cad024e151d24c46d185ab6008e19", "parents": ["f1011f4e77941d2d0700e5d430c017844439fa19"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072683 Part 1 - Add AnchorPosReferenceData::AppliedScrollShift(). r=layout-reviewers,emilio\n\nNext part will split `mDefaultScrollShift` into two values. Route the current\nusers of the variable to use the accessor instead.\n\nThis patch does not change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330818\n", "files": ["layout/base/AnchorPositioningUtils.cpp", "layout/base/AnchorPositioningUtils.h", "layout/generic/AbsoluteContainingBlock.cpp"], "git_node": "0374ed5036267b2fae1ea16ff5b14058ffb99728", "git_parents": ["95eac0e3f8dda4f4ca2eac303c4b2f40e8a080cb"], "node": "4313c08e99426884a4b89874f695d490fc37d1ab", "parents": ["f22b8bcb086cad024e151d24c46d185ab6008e19"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072683 Part 2 - Keep the default scroll shift out of scrollable overflow. r=layout-reviewers,emilio,dshin\n\nThis patch splits the original `mDefaultScrollShift` value into two. One is the\nremembered scroll offset [1], including the sticky positioning shift and\nscrolling done by script prior to an anchor recalculation point. The other is\nthe default scroll shift [2], which is excluded from the scrollable overflow\narea, to avoid the feedback loop.\n\n[1] https://drafts.csswg.org/css-anchor-position-1/#remembered-scroll-offset\n[2] https://drafts.csswg.org/css-anchor-position-1/#default-scroll-shift\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330819\n", "files": ["layout/base/AnchorPositioningUtils.cpp", "layout/base/AnchorPositioningUtils.h", "layout/generic/AbsoluteContainingBlock.cpp", "layout/generic/nsIFrame.cpp"], "git_node": "89bfb6b2a1ab384d6a3745f198081423a4f94ac3", "git_parents": ["0374ed5036267b2fae1ea16ff5b14058ffb99728"], "node": "300a9637f7dc31552ff8a535cb8dc386dd3ab711", "parents": ["4313c08e99426884a4b89874f695d490fc37d1ab"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072683 Part 3 - Add WPTs for the scrollable overflow of scroll-compensated anchored elements. r=layout-reviewers,dshin\n\n`anchor-scroll-010.html` covers the original testcase in the bug.\n\n`anchor-scroll-011.html` covers that scrolling the anchor's scroll container\ndoesn't change the scrollable overflow area that a positioned element\ncontributes to its own scroll container.\n\n`anchor-scroll-012.html` covers that the scroll container's scrollable overflow\narea is updated right after the positioned element switches position fallbacks,\nwhich is an anchor recalculation point.\n\n`anchor-scroll-013.html` covers that the remembered scroll offset isn't reused\nafter the positioned element's default anchor changes, so the scroll container's\nscrollable overflow area reflects the positioned element's new position.\n\n`anchor-scroll-014.html` covers that changing the default anchor's display\ntype keeps the remembered scroll offset, since it isn't an anchor\nrecalculation point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330820\n", "files": ["testing/web-platform/tests/css/css-anchor-position/anchor-scroll-010.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-011.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-012.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-013.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-014.html"], "git_node": "2421a05e7a4085c16732ade5c6fd0c119554361a", "git_parents": ["89bfb6b2a1ab384d6a3745f198081423a4f94ac3"], "node": "12339dae030e1854114ad1641fc3e0f53e892b98", "parents": ["300a9637f7dc31552ff8a535cb8dc386dd3ab711"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079824 - Add auto dismiss for about:welcome screens r=emcminn,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332790\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/MultiStageAboutWelcome.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAWProton.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAboutWelcome.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/MultistageWithDismiss.test.jsx", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "1144ee76588f0b862c42ce90e4978c395392080a", "git_parents": ["2421a05e7a4085c16732ade5c6fd0c119554361a"], "node": "900d5306ce3e48e1e3c5490cfbbf14610fe83b47", "parents": ["12339dae030e1854114ad1641fc3e0f53e892b98"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068878 - Use Media3 stream formats when sizing HLS video buffers. r=media-playback-reviewers,geckoview-reviewers,aosmond,owlish\n\nUse BaseRenderer.getStreamFormats() to include the stream's compatible\nformats when calculating maximum video dimensions and input buffer size.\nRemove the local format cache and its obsolete onStreamChanged callback.\n\nWhen the maximum input size is unknown, leave the input buffer unset\ninstead of attempting to allocate an array with Format.NO_VALUE as its\nsize. This allows the decoder input buffer to allocate storage when the\nsample size becomes known, including for AV1 streams.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325729\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoHlsVideoRenderer.java"], "git_node": "a872d66b90ced7f90f0c67d468939a551d46c28a", "git_parents": ["1144ee76588f0b862c42ce90e4978c395392080a"], "node": "529d2774edfb8259e31f25b78b06f88d824d0fc8", "parents": ["900d5306ce3e48e1e3c5490cfbbf14610fe83b47"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068878 - Only prepend HLS codec initialization data to H.264/H.265 keyframes. r=media-playback-reviewers,geckoview-reviewers,aosmond,owlish\n\nRestrict CSD prepending to codecs whose Annex B parameter sets are valid in-band data, preserving the original sample data for AV1 and other codecs.\n\nAdd a shared accessor for the current input format and reuse it for buffer sizing, sample preparation, and error reporting.\n\nRemove the video renderer's reconfiguration state machine, which inserted raw `Format.initializationData` (an av1C record for AV1) into the bitstream after format changes; keyframe CSD prepending already covers H.264/H.265.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325730\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoHlsAudioRenderer.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoHlsRendererBase.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoHlsVideoRenderer.java"], "git_node": "f14918d18d368f0e823c85ee70eb4a31c9497263", "git_parents": ["a872d66b90ced7f90f0c67d468939a551d46c28a"], "node": "1754191793d2b9d013e22b8ab781bcd2c2c935c8", "parents": ["529d2774edfb8259e31f25b78b06f88d824d0fc8"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068971 - Convert gfxFontconfigFontEntry::InitSkrifaFont into an override of gfxFontEntry::InitSkrifaFontFace r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333029\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h"], "git_node": "0321b76d7ac7c84b8937229ec5b0b85889f4a193", "git_parents": ["f14918d18d368f0e823c85ee70eb4a31c9497263"], "node": "6a6eeb7e30ac8e1b51557cc01c1b800c657fdf89", "parents": ["1754191793d2b9d013e22b8ab781bcd2c2c935c8"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080236 - Fire beforeinput events on undo/redo in EditContext. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333252\n", "files": ["editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/tests/edit-context/test_editcontext_format_commands.html", "testing/web-platform/tests/editing/edit-context/edit-context-undo-redo.tentative.html", "testing/web-platform/tests/editing/include/editor-test-utils.js"], "git_node": "f9b70b3c3ceea2e3a25f256dc402c0d05586e3df", "git_parents": ["0321b76d7ac7c84b8937229ec5b0b85889f4a193"], "node": "77f858aa5749d9f3ebe7510a818c2053da9f6143", "parents": ["6a6eeb7e30ac8e1b51557cc01c1b800c657fdf89"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2078921 - Update neqo to v0.33.0 r=necko-reviewers,supply-chain-reviewers,ai4dev-reviewers,leggert,padenot,valentin\n\nPulls in the WebTransport datagram queue (neqo #4003), which adds send\ngroup and order parameters to webtransport_send_datagram; forward the\nvalues neqo_glue already receives from the C++ side. neqo also moved to\nqlog 0.18.1, so bump neqo_glue's qlog dependency to match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333328\n", "files": [".cargo/config.toml.in", "Cargo.lock", "netwerk/socket/neqo_glue/Cargo.toml", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/http3server/Cargo.toml", "netwerk/test/http3server/src/main.rs", "supply-chain/audits.toml", "third_party/rust/humantime/.cargo-checksum.json", "third_party/rust/humantime/.cargo_vcs_info.json", "third_party/rust/humantime/.github/dependabot.yml", "third_party/rust/humantime/.github/workflows/rust.yml", "third_party/rust/humantime/Cargo.lock", "third_party/rust/humantime/Cargo.toml", "third_party/rust/humantime/Cargo.toml.orig", "third_party/rust/humantime/LICENSE-APACHE", "third_party/rust/humantime/LICENSE-MIT", "third_party/rust/humantime/README.md", "third_party/rust/humantime/benches/datetime_format.rs", "third_party/rust/humantime/benches/datetime_parse.rs", "third_party/rust/humantime/deny.toml", "third_party/rust/humantime/src/date.rs", "third_party/rust/humantime/src/duration.rs", "third_party/rust/humantime/src/lib.rs"