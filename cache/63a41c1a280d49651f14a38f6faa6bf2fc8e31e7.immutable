r/serializer.rs", "third_party/rust/postcard/src/varint.rs", "third_party/rust/postcard/tests/accumulator.rs", "third_party/rust/postcard/tests/crc.rs", "third_party/rust/postcard/tests/loopback.rs", "third_party/rust/postcard/tests/max_size.rs", "third_party/rust/process-backend/.cargo-checksum.json", "third_party/rust/process-backend/Cargo.toml", "third_party/rust/process-backend/src/lib.rs", "third_party/rust/process-backend/src/remote/backend.rs", "third_party/rust/process-backend/src/remote/executor/handler.rs", "third_party/rust/process-backend/src/remote/executor/mod.rs", "third_party/rust/process-backend/src/remote/executor/resources.rs", "third_party/rust/process-backend/src/remote/io/mod.rs", "third_party/rust/process-backend/src/remote/io/unix_stream.rs", "third_party/rust/process-backend/src/remote/mod.rs", "third_party/rust/process-backend/src/remote/transport/mod.rs", "third_party/rust/process-backend/src/remote/transport/postcard.rs", "third_party/rust/process-backend/src/remote/wire/cstr_with_null.rs", "third_party/rust/process-backend/src/remote/wire/mod.rs", "third_party/rust/process-backend/tests/basic.rs", "third_party/rust/process-reader/.cargo-checksum.json", "third_party/rust/process-reader/Cargo.toml", "toolkit/crashreporter/crash_helper_client/Cargo.toml", "toolkit/crashreporter/crash_helper_common/Cargo.toml", "toolkit/crashreporter/crash_helper_server/Cargo.toml", "toolkit/crashreporter/rust_minidump_writer_linux/Cargo.toml"], "git_node": "2b1a7760c38c1dbd56d7439f48a79e227e71d37e", "git_parents": ["1be1df7c38e457befc57592616b3bd0d54a18a21"], "node": "5164db8162882465800b09f90d108b918321ecf2", "parents": ["b5c4aef7efc9363ee2b68381c12f48825947067b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081985 - Make sure @position-try inside scope doesn't allow more than it should. r=firefox-style-system-reviewers,dshin\n\nEnsure that we're allowed in all the rules we're supposed to. Fix some\nplaces which allowed a rule in style but not in scope, which seems\nan oversight (see next patch for more reliable fix).\n\nThe test has one failure, which is for @page inside @scope, because\nthat's the only case where inner rules can be less restrictive than\nouter rules.\n\nThat failure will really go away when we ever make `size` a proper\nshorthand for width and height, but we can fix in a follow-up if\nneeded by splitting the bitflag check in two.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334116\n", "files": ["servo/components/style/parser.rs", "servo/components/style/properties/data.py", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/stylesheets/mod.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-cascade/declaration-context.html.ini", "testing/web-platform/tests/css/css-cascade/declaration-context.html"], "git_node": "9f77011aa34b4c326073e4152f3dfe0062a5c442", "git_parents": ["2b1a7760c38c1dbd56d7439f48a79e227e71d37e"], "node": "b21bd5143f654872a1858444120c60856fe5a560", "parents": ["5164db8162882465800b09f90d108b918321ecf2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081985 - Make sure @scope declarations allowance matches style rules. r=dshin,layout-reviewers,firefox-style-system-reviewers\n\nThis prevents other similar mistakes as the ones fixed in the previous\npatch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334117\n", "files": ["servo/components/style/properties/data.py", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/shorthands.toml", "testing/web-platform/tests/css/css-cascade/declaration-context.html"], "git_node": "de5fdc7c270a17307221c9cf725839861973ccc6", "git_parents": ["9f77011aa34b4c326073e4152f3dfe0062a5c442"], "node": "5ac8eaddcc6b186e06bd1cdc16b0c4f554111175", "parents": ["b21bd5143f654872a1858444120c60856fe5a560"], "tags": []}, {"author": "Dmitry Gozman \u003cdgozman@gmail.com\u003e", "branch": "default", "desc": "Bug 2081131 - Honor BrowsingContext.forceOffline for loads that only carry an associated browsing context. r=necko-reviewers,kershaw\n\nKeepalive fetches handled by the FetchService and fetches from workers\ndo not have a browsing context in their load info, only an associated\nbrowsing context. Fall back to it when checking forceOffline.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333154\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/test/browser/browser_test_offline_tab.js"], "git_node": "0331f6bb1d751efe3d9ade0c326af8288ae5ae07", "git_parents": ["de5fdc7c270a17307221c9cf725839861973ccc6"], "node": "481b121326786b191ba80768383442937e919641", "parents": ["5ac8eaddcc6b186e06bd1cdc16b0c4f554111175"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081763 - Update stmo skill to match stmo-cli 0.13.0; r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333663\n", "files": [".agents/skills/stmo/SKILL.md", ".claude/skills/stmo/SKILL.md"], "git_node": "5e4f7a5b7d261143afce1389fae15ba9dca47c66", "git_parents": ["0331f6bb1d751efe3d9ade0c326af8288ae5ae07"], "node": "01f60f06195cb2fde9477d4ffe8d8d7d5240d638", "parents": ["481b121326786b191ba80768383442937e919641"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080951: Update border and margins for AITab table component r=jlewis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333798\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-table/aitab-table.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-table/aitab-table.mjs"], "git_node": "c6a7d8d0351134c3293daac375d98f317e2ba12b", "git_parents": ["5e4f7a5b7d261143afce1389fae15ba9dca47c66"], "node": "e6288ec5baddea1c013dd05c71294a7ef75b3270", "parents": ["01f60f06195cb2fde9477d4ffe8d8d7d5240d638"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1841326 Colorspace property added and correctly managed in CanvasRenderingContext2d and ImageData r=gfx-reviewers,webidl,emilio,bradwerth\" for causing canvas @2d.imageData.createImageBitmap.p3.rgba.unorm8.html.\n\nThis reverts commit 76d008734a82091bcf84ad70e4d4e796322c38c4.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/ImageData.cpp", "dom/canvas/ImageData.h", "dom/webidl/CanvasRenderingContext2D.webidl", "dom/webidl/ImageData.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/canvas/element/manual/wide-gamut-canvas/canvas-display-p3-drawImage-ImageBitmap-ImageData.html.ini", "testing/web-platform/meta/html/canvas/element/manual/wide-gamut-canvas/canvas-display-p3-drawImage-ImageBitmap-canvas.html.ini", "testing/web-platform/meta/html/canvas/element/manual/wide-gamut-canvas/canvas-display-p3-pattern-canvas.html.ini", "testing/web-platform/meta/html/canvas/element/pixel-manipulation/2d.imageData.createImageBitmap.p3.rgba.unorm8.html.ini", "testing/web-platform/meta/html/canvas/element/pixel-manipulation/2d.imageData.createImageBitmap.srgb.rgba.unorm8.html.ini"], "git_node": "5ddd3ae49c34f377736b1f1947fd092ed7136e67", "git_parents": ["c6a7d8d0351134c3293daac375d98f317e2ba12b"], "node": "7eede97c05be18fb7b07df89f49974b747c825db", "parents": ["e6288ec5baddea1c013dd05c71294a7ef75b3270"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1976159, Bug 2082352 - Add the QuotaExceededError DOMException derived interface r=edgar,webidl,dom-worker-reviewers,smaug,edenchuang\" for causing wpt failures @DOMException-audioworklet.https.html.\n\nThis reverts commit 5d61eacca22c27409fe79de05e94da071573e87b.\n\nRevert \"Bug 2082352 - Don't reuse a stale descriptor for [Serializable] exposure sets r=webidl,emilio,saschanaz\"\n\nThis reverts commit 7f2c200ff7f02087ea74fc3900061567f64ad1ef.\n", "files": ["dom/base/DOMException.cpp", "dom/base/QuotaExceededError.cpp", "dom/base/QuotaExceededError.h", "dom/base/StructuredCloneHolder.cpp", "dom/base/StructuredCloneTags.h", "dom/base/moz.build", "dom/bindings/Codegen.py", "dom/ipc/ClonedErrorHolder.cpp", "dom/ipc/ClonedErrorHolder.h", "dom/ipc/tests/JSWindowActor/browser.toml", "dom/ipc/tests/JSWindowActor/browser_sendQuery.js", "dom/serviceworkers/test/test_serviceworker_interfaces.js", "dom/tests/mochitest/crypto/test_getRandomValues.html", "dom/tests/mochitest/general/test_interfaces.js", "dom/tests/mochitest/whatwg/test_structuredCloneAndExposed.html", "dom/webidl/DOMException.webidl", "dom/webidl/QuotaExceededError.webidl", "dom/webidl/moz.build", "dom/workers/test/test_worker_interfaces.js", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/WebCryptoAPI/getRandomValues.any.js.ini", "testing/web-platform/meta/encrypted-media/clearkey-mp4-setmediakeys-to-multiple-video-elements.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-to-multiple-video-elements.https.html.ini", "testing/web-platform/meta/html/infrastructure/safe-passing-of-structured-data/structuredclone_0.html.ini", "testing/web-platform/meta/media-source/mediasource-appendbuffer-quota-exceeded.html.ini", "testing/web-platform/meta/webidl/idlharness.any.js.ini", "testing/web-platform/meta/webstorage/storage_local_quota_independent_from_session.window.js.ini", "testing/web-platform/meta/webstorage/storage_local_setitem_quotaexceedederr.window.js.ini", "testing/web-platform/meta/webstorage/storage_session_quota_independent_from_local.window.js.ini", "testing/web-platform/meta/webstorage/storage_session_setitem_quotaexceedederr.window.js.ini", "toolkit/actors/TestWindowChild.sys.mjs"], "git_node": "4c1aacfbe69d0a674f698422d2540fc9ba450a41", "git_parents": ["5ddd3ae49c34f377736b1f1947fd092ed7136e67"], "node": "05523129c5582f2d9da6c2914c68e53137098694", "parents": ["7eede97c05be18fb7b07df89f49974b747c825db"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078496 - Set up an AutoJSAPI before reporting unhandled rejections from NotifyUnhandledRejections. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334120\n", "files": ["dom/promise/tests/chrome.toml", "dom/promise/tests/test_unhandledrejection_chrome_stack.html", "xpcom/base/CycleCollectedJSContext.cpp"], "git_node": "4301a8e37fd3609ab2524dbbe83cb3e145ac9ce0", "git_parents": ["4c1aacfbe69d0a674f698422d2540fc9ba450a41"], "node": "8bcd11bd66a9963b773b013cd94925f6033fd9cc", "parents": ["05523129c5582f2d9da6c2914c68e53137098694"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 1972313 - Fix ADTS duration via exact scan, frozen estimate for streaming. r=media-playback-reviewers,padenot\n\nADTSTrackDemuxer::Init used only the first ADTS frame for\nAverageFrameLength, and the first frame is often an outlier (28 bytes\nwith encoder metadata or tiny silence vs ~386 bytes true average),\ngiving wildly wrong durations (audio.aac: 43:09, output.aac: 47min).\n\nScanForDuration scans forward while data is available without\nblocking: reaching EOS yields the exact frame count; hitting the\nbuffered frontier (streaming) or the 20000-frame cap freezes a\nprefix-based estimate instead. Duration() prefers the exact count,\nelse the frozen snapshot, so the reported duration stays stable as\nthe rolling average adapts during playback. MaybeFinalizeDuration\nre-scans once the resource becomes fully cached: the single allowed\npost-Init update. A failed probe resets the parser (wiping\nFirstFrame), so it is re-latched from the saved offset.\n\nTest: TEST(ADTSDemuxer, OutlierFirstFrameDuration) builds an\nin-memory ADTS stream with a 28-byte outlier first frame and asserts\nthe exact ~0.99s duration (vs ~9.4s naive) plus stability across\ndemuxing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323920\n", "files": ["dom/media/ADTSDemuxer.cpp", "dom/media/ADTSDemuxer.h", "dom/media/gtest/TestADTSDemuxer.cpp"], "git_node": "3a650c4952e8933b57e5df3cad789013b0ac0cd9", "git_parents": ["4301a8e37fd3609ab2524dbbe83cb3e145ac9ce0"], "node": "96b7f38923e06b7218fd038f513711fb484df621", "parents": ["8bcd11bd66a9963b773b013cd94925f6033fd9cc"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2082277 - Don't use rhs at start in arm64 wasm move-lane lowering. r=yury\n\nLWasmMoveLaneSimd128 reuses its lhs register for the output, so the\nallocator may give the output the register of an at-start rhs and then\ncopy lhs into it before the lane move reads rhs. When lhs stays live\nafter the move this overwrote rhs and moved the wrong lane. Only use rhs\nat start when it is the same LIR node as lhs, as\nwillHaveDifferentLIRNodes prescribes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333991\n", "files": ["js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane.js", "js/src/jit/arm64/Lowering-arm64.cpp"], "git_node": "f7b6ab06fa66b543b546938259d8c3d687a35415", "git_parents": ["3a650c4952e8933b57e5df3cad789013b0ac0cd9"], "node": "72a490bf80ed506776811bbf8963367bc1204bde", "parents": ["96b7f38923e06b7218fd038f513711fb484df621"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080787 - Don't hold on to store buffer entry unnecessarily when tenuring strings r=spidermonkey-reviewers,yulia\n\nSemispace nursery sets a flag |promotedToNursery| when a cell is promoted but\nstays in the nursery. This is used to detect when we need to keep a store\nbuffer entry around rather than discarding it after it's been traced.\n\nThe code in question performs a recursive tenuring operation on a dependent\nstring's base, which overwrites this flag. This can cause the store buffer\nentry to be kept after the pointer it contains is tenured. Subsequent post\nbarrier operations won't remove it for this reason and the memory holding it\ncan be freed, leading to UAF on the next nursery collection.\n\nThe fix is to preserve the flag over the recursive promotion call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334074\n", "files": ["js/src/gc/Tenuring.cpp", "js/src/jit-test/tests/gc/bug-2080787.js"], "git_node": "f46522623831a4e0ff1b829e746fc560db0a5444", "git_parents": ["f7b6ab06fa66b543b546938259d8c3d687a35415"], "node": "f17d582dc70889ded6abfd73b7c2e1db24609dde", "parents": ["72a490bf80ed506776811bbf8963367bc1204bde"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073695 - Hold a strong context reference in WEBGL_lose_context methods. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333560\n", "files": ["dom/canvas/ClientWebGLExtensions.h"], "git_node": "fa13f368ce46f348d7693dd595da3cac8fe8b5a3", "git_parents": ["f46522623831a4e0ff1b829e746fc560db0a5444"], "node": "852e52c9dd294321543f633da1f897e3260faf76", "parents": ["f17d582dc70889ded6abfd73b7c2e1db24609dde"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073695 - Hold a strong context reference in WebGL extension methods. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333561\n", "files": ["dom/canvas/ClientWebGLExtensions.h"], "git_node": "8609f249ae9906056364913403c86d4c77e84f84", "git_parents": ["fa13f368ce46f348d7693dd595da3cac8fe8b5a3"], "node": "1e355b872c33d71c52d18887487369736b9b23bf", "parents": ["852e52c9dd294321543f633da1f897e3260faf76"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073695 - Hold a strong context reference in more WebGL extension methods. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334142\n", "files": ["dom/canvas/ClientWebGLContext.h", "dom/canvas/ClientWebGLExtensions.h"], "git_node": "aca3776a2414c0f601cf2f8c1d8cad49a5117120", "git_parents": ["8609f249ae9906056364913403c86d4c77e84f84"], "node": "59283092b9de008c81f874a631092547bae89e37", "parents": ["1e355b872c33d71c52d18887487369736b9b23bf"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077237 - Remove the Share firefox option in accounts menu r=fterdal,fluent-reviewers,desktop-theme-reviewers,mstriemer,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330235\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/components/referrals/tests/browser/browser.toml", "browser/components/referrals/tests/browser/browser_referralsAccountMenu.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "d1d9777e3b00b53b01865b410fad4c6c55ad461e", "git_parents": ["aca3776a2414c0f601cf2f8c1d8cad49a5117120"], "node": "95179d41d179ca78d08648cfe21d95714ac0007c", "parents": ["59283092b9de008c81f874a631092547bae89e37"], "tags": []}, {"author": "Mike Conley \u003cmike@conley.io\u003e", "branch": "default", "desc": "Bug 2072717 - Create mochitest-chrome tests for DownloadElementShell. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326626\n", "files": ["browser/components/downloads/DownloadsViewUI.sys.mjs", "browser/components/downloads/moz.build", "browser/components/downloads/test/chrome/chrome.toml", "browser/components/downloads/test/chrome/test_DownloadElementShell.html"], "git_node": "e05406e589f050cd31b321f35c0d5c1375111f65", "git_parents": ["d1d9777e3b00b53b01865b410fad4c6c55ad461e"], "node": "18aa377297b909ea05981bb9ed7c8a85b6437d8a", "parents": ["95179d41d179ca78d08648cfe21d95714ac0007c"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2080371 - Don't crash late during shutdown in JSActor code. r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333899\n", "files": ["dom/ipc/jsactor/JSActorService.cpp", "dom/ipc/jsactor/JSProcessActorProtocol.cpp"], "git_node": "1dbd3fd8072550f9a4a85b76ea31c8e55ac2a226", "git_parents": ["e05406e589f050cd31b321f35c0d5c1375111f65"], "node": "9657edfd0defe1168ebbad45641d3879c6171436", "parents": ["18aa377297b909ea05981bb9ed7c8a85b6437d8a"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080936 - Apply the round 1 UX QA spacing, line-height and border fixes to the AITab Highlights block. r=mlucks\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333405\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-highlights/aitab-highlights.css"], "git_node": "7a7520d584072b9c97d0f3b1bfff5d02a90011c5", "git_parents": ["1dbd3fd8072550f9a4a85b76ea31c8e55ac2a226"], "node": "772f99d0d7ceea4d21ec2534090e9c688891a431", "parents": ["9657edfd0defe1168ebbad45641d3879c6171436"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079203 - Convert SessionStartup to a class. r=sessionstore-reviewers,nsharpley\n\nNothing read _initialized, so it is dropped rather than kept as a write-only private field.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333772\n", "files": ["browser/components/sessionstore/SessionStartup.sys.mjs"], "git_node": "a2a8050bee49578eb0bac32ea1e6c8ab3f3d44b7", "git_parents": ["7a7520d584072b9c97d0f3b1bfff5d02a90011c5"], "node": "280da9b89fc743b497644568fe4e46479e17334e", "parents": ["772f99d0d7ceea4d21ec2534090e9c688891a431"], "tags": []}, {"author": "Denis Palmeiro \u003cdpalmeiro@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056689 - Add an environment variable to disable Remote Settings activity. r=remote-settings-reviewers,leplatrem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331726\n", "files": ["services/settings/Utils.sys.mjs", "services/settings/test/unit/test_remote_settings_disabled_env.js", "services/settings/test/unit/xpcshell.toml"], "git_node": "0641b9b428b859bdc6c83b9eeccd1b3cf6cc4c82", "git_parents": ["a2a8050bee49578eb0bac32ea1e6c8ab3f3d44b7"], "node": "b59c1fe225dd80c53e35c6f7d76bb38841cc3965", "parents": ["280da9b89fc743b497644568fe4e46479e17334e"], "tags": []}, {"author": "Denis Palmeiro \u003cdpalmeiro@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056689 - Reduce background activity during Raptor and Speedometer tests. r=perftest-reviewers,sparky\n\nThis patch disables the following features which contribute to test noise:\n- Remote Settings network activity\n- New-tab page preloading\n- Safe Browsing list updates\n- Captive-portal detection\n- Network connectivity probes\n- Backup scheduling\n- Firefox update timer\n- Delayed GMP initialization\n- Periodic session store saves\n\nAdditionally, remove the 30s settle sleep at the beginning of the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332453\n", "files": ["testing/profiles/raptor/user.js", "testing/raptor/browsertime/speedometer3.js", "testing/raptor/browsertime/utils/profiling.js", "testing/raptor/raptor/browsertime/base.py"], "git_node": "a7e0d49fa412f7208ad3e6463948c0c1beec646a", "git_parents": ["0641b9b428b859bdc6c83b9eeccd1b3cf6cc4c82"], "node": "be9a7441e3111e2cbb4ae9947a72eea8b8bd1e00", "parents": ["b59c1fe225dd80c53e35c6f7d76bb38841cc3965"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081374 - Create delete error dialog for VPN site rules - r=ip-protection-reviewers,fluent-reviewers,settings-reviewers,hjones,bolsson,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333418\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "12d31a4ce7e1a60cb295fbacf3c29c17adc4b864", "git_parents": ["a7e0d49fa412f7208ad3e6463948c0c1beec646a"], "node": "009a9d3a7c47cbb95990fe7e6fed187415062a67", "parents": ["be9a7441e3111e2cbb4ae9947a72eea8b8bd1e00"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081785 - Editing a website rule to a duplicate URL should display a validation error - r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333717\n", "files": ["browser/components/preferences/dialogs/vpnSiteRule.js", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js"], "git_node": "3c8cbb75cbad8459a3c7db596b180a054b61e36e", "git_parents": ["12d31a4ce7e1a60cb295fbacf3c29c17adc4b864"], "node": "68768ba50997384f52c367317de5d72552c7aeea", "parents": ["009a9d3a7c47cbb95990fe7e6fed187415062a67"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Expose arguments passed to host finalization registry cleanup callback r=spidermonkey-reviewers,sfink\n\nCurrently we expose these when we are about to do the cleanup but this needs to\nhappen as soon as we queue the cleanup otherwise the cycle collector could free\nit before it is run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332423\n", "files": ["js/src/gc/FinalizationObservers.cpp", "xpcom/base/CycleCollectedJSContext.cpp"], "git_node": "d18ae0a7e1bdf3044c0fcd575208642bfa9e8a70", "git_parents": ["3c8cbb75cbad8459a3c7db596b180a054b61e36e"], "node": "b062d577d5fe562bb319a1c65caf819413895340", "parents": ["68768ba50997384f52c367317de5d72552c7aeea"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Add testcase r=mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332424\n", "files": ["xpcom/tests/crashtests/bug-2079059.html", "xpcom/tests/crashtests/crashtests.list"], "git_node": "28f0865967cb90f111803dab3a1864d5c2731b02", "git_parents": ["d18ae0a7e1bdf3044c0fcd575208642bfa9e8a70"], "node": "799f076ca7a0888dcf1e916144c9839d9f787ce2", "parents": ["b062d577d5fe562bb319a1c65caf819413895340"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Add testcase from related bug r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334020\n", "files": ["js/src/jit-test/tests/gc/bug-2081988.js"], "git_node": "98a346c77b7c1b1fb87897d9f853d74b9a5e45c8", "git_parents": ["28f0865967cb90f111803dab3a1864d5c2731b02"], "node": "99e8ea009fd6e7f8f8a973e907df98377245ef5e", "parents": ["799f076ca7a0888dcf1e916144c9839d9f787ce2"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2079059: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/gc/FinalizationObservers.cpp"], "git_node": "e78c56887c1f81181ba242e1a8bc6165a3396001", "git_parents": ["98a346c77b7c1b1fb87897d9f853d74b9a5e45c8"], "node": "a953bd3ed5f05b24a96b45fe214789ec39b731ea", "parents": ["99e8ea009fd6e7f8f8a973e907df98377245ef5e"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080900 - Add site rules onboarding message to VPN panel - r=ip-protection-reviewers,fluent-reviewers,bolsson,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333704\n", "files": ["browser/app/profile/firefox.js", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/content/ipprotection-content.css", "browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_content.js", "browser/locales/en-US/browser/ipProtection.ftl", "toolkit/components/ipprotection/docs/Preferences.md"], "git_node": "9dd91b9757d887ec621dff02cc58f10efca40722", "git_parents": ["e78c56887c1f81181ba242e1a8bc6165a3396001"], "node": "7d4d033a803ceadbd8bafde4a98f347ba995f3a8", "parents": ["a953bd3ed5f05b24a96b45fe214789ec39b731ea"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060994: Log the text that the macOS Emoji picker inserts, rather than \"(null)\". r=mac-reviewers,mstange\n\nGetCharacters() escapes each UTF-16 code unit on its own, so a character outside the Basic Multilingual Plane ended up in the escaped string as two unpaired surrogates with the escape text between them. XPCOMStringToNSString() cannot convert that, returns nil, and every such character was logged as \"(null)\". Most Emoji are outside that plane, so the logs collected for this bug hid the very text we were following.\n\nKeep a surrogate pair together and log the code point it forms, and leave a lone surrogate out of a string that it cannot be converted in. While here, log which of the two ways of inserting text without a key press is in use, since the two behave differently and the choice is not otherwise visible in a log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319916\n", "files": ["widget/cocoa/TextInputHandler.mm"], "git_node": "d5689e1cfac91e981c496ca5d18ef2ac92a8ab85", "git_parents": ["9dd91b9757d887ec621dff02cc58f10efca40722"], "node": "dc9cba0827630b447cc474dab2b2d161a44a8052", "parents": ["7d4d033a803ceadbd8bafde4a98f347ba995f3a8"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060994: Ignore a resign-key notification for a window which is still the key window on macOS. r=mac-reviewers,bradwerth\n\nOpening a panel such as the Emoji picker gets us NSWindowDidResignKeyNotification without key going anywhere: NSApp still reports the window as its key window, no other window becomes key, and it stays key while the panel is up. We treated that as the window being lowered, so nsFocusManager blurred the content, the content process lost its focused editor, and an emoji arriving in the meantime had no editing host to dispatch \"beforeinput\" at, so it did not appear.\n\nIgnore the notification while the window is still the key window. When key really does move, to another window or to another application, NSApp reports the new window, or nil, by the time we are called. Sheets are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319917\n", "files": ["widget/cocoa/nsWindowMap.mm"], "git_node": "7cf3a9827eee96e0976dd6e0a5e88388e36736ce", "git_parents": ["d5689e1cfac91e981c496ca5d18ef2ac92a8ab85"], "node": "ac41aab664f6d229ba410da7810862994d5cf1d0", "parents": ["dc9cba0827630b447cc474dab2b2d161a44a8052"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2079668 [Linux] Don't create EGLWindow for non-accelerated nsWindow r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333159\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "f877ce1a2b58633224c898c5c8806f5eccaba3d6", "git_parents": ["7cf3a9827eee96e0976dd6e0a5e88388e36736ce"], "node": "f3a4efcd02e37f56d06e578594f91fb2f44eaf38", "parents": ["ac41aab664f6d229ba410da7810862994d5cf1d0"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2079668 [Linux] Don't delete GL resources on popup unmap r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334053\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "aceb3d7ac4b87b113196775b99537822064ad682", "git_parents": ["f877ce1a2b58633224c898c5c8806f5eccaba3d6"], "node": "8306d1a3abc8b3f10d867bbd19b1353e5ac965bd", "parents": ["f3a4efcd02e37f56d06e578594f91fb2f44eaf38"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2079668: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "4c5cbb120149b8112a16100f2d0b03212504e239", "git_parents": ["aceb3d7ac4b87b113196775b99537822064ad682"], "node": "05d31c287ddcb984f209af448735897bc789f65f", "parents": ["8306d1a3abc8b3f10d867bbd19b1353e5ac965bd"], "tags": []}, {"author": "Fabio Kaminski \u003cfabiokaminski@gmail.com\u003e", "branch": "default", "desc": "Bug 1841326 Colorspace property added and correctly managed in CanvasRenderingContext2d and ImageData r=gfx-reviewers,webidl,emilio,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332911\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/ImageData.cpp", "dom/canvas/ImageData.h", "dom/webidl/CanvasRenderingContext2D.webidl", "dom/webidl/ImageData.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/canvas/element/manual/wide-gamut-canvas/canvas-display-p3-drawImage-ImageBitmap-ImageData.html.ini", "testing/web-platform/meta/html/canvas/element/manual/wide-gamut-canvas/canvas-display-p3-drawImage-ImageBitmap-canvas.html.ini", "testing/web-platform/meta/html/canvas/element/manual/wide-gamut-canvas/canvas-display-p3-pattern-canvas.html.ini", "testing/web-platform/meta/html/canvas/element/pixel-manipulation/2d.imageData.createImageBitmap.p3.rgba.unorm8.html.ini", "testing/web-platform/