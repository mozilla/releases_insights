rential Revision: https://phabricator.services.mozilla.com/D325781\n", "files": ["dom/base/DOMException.cpp", "dom/base/QuotaExceededError.cpp", "dom/base/QuotaExceededError.h", "dom/base/StructuredCloneHolder.cpp", "dom/base/StructuredCloneTags.h", "dom/base/moz.build", "dom/ipc/ClonedErrorHolder.cpp", "dom/ipc/ClonedErrorHolder.h", "dom/ipc/tests/JSWindowActor/browser.toml", "dom/ipc/tests/JSWindowActor/browser_sendQuery.js", "dom/serviceworkers/test/test_serviceworker_interfaces.js", "dom/tests/mochitest/crypto/test_getRandomValues.html", "dom/tests/mochitest/general/test_interfaces.js", "dom/tests/mochitest/whatwg/test_structuredCloneAndExposed.html", "dom/webidl/DOMException.webidl", "dom/webidl/QuotaExceededError.webidl", "dom/webidl/moz.build", "dom/workers/test/test_worker_interfaces.js", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/WebCryptoAPI/getRandomValues.any.js.ini", "testing/web-platform/meta/encrypted-media/clearkey-mp4-setmediakeys-to-multiple-video-elements.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-to-multiple-video-elements.https.html.ini", "testing/web-platform/meta/html/infrastructure/safe-passing-of-structured-data/structuredclone_0.html.ini", "testing/web-platform/meta/media-source/mediasource-appendbuffer-quota-exceeded.html.ini", "testing/web-platform/meta/webidl/idlharness.any.js.ini", "testing/web-platform/meta/webstorage/storage_local_quota_independent_from_session.window.js.ini", "testing/web-platform/meta/webstorage/storage_local_setitem_quotaexceedederr.window.js.ini", "testing/web-platform/meta/webstorage/storage_session_quota_independent_from_local.window.js.ini", "testing/web-platform/meta/webstorage/storage_session_setitem_quotaexceedederr.window.js.ini", "toolkit/actors/TestWindowChild.sys.mjs"], "git_node": "5d61eacca22c27409fe79de05e94da071573e87b", "git_parents": ["7f2c200ff7f02087ea74fc3900061567f64ad1ef"], "node": "6c61e5aa96122ac4f5b88dcf84237b16aa3c082a", "pa