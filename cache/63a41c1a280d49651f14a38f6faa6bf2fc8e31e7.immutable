p", "gfx/layers/client/TextureClient.h", "gfx/layers/ipc/SharedRGBImage.cpp"], "git_node": "cdda42ed916bade334b5a29d17319bd2236184a7", "git_parents": ["261549f7c88516ca10678ba18701c3da9b0b3db9"], "node": "abae9bbd39bdeb2cf419937f3e7e8f41a383ad71", "parents": ["ecf37ded796fc800c2ab22e789502df32960ffa7"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2082248. Make MultipartImage part transitions more robust. r=gfx-reviewers,lsalzman\n\nHold strong references in MultipartImage and NextPartObserver across calls\nthat can send notifications, and re-check state after them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333979\n", "files": ["image/MultipartImage.cpp"], "git_node": "a522381a2a1800d978f9b9ecb1ec8c092a7a1306", "git_parents": ["cdda42ed916bade334b5a29d17319bd2236184a7"], "node": "4014b27eeba7889298d74b7b8636327042dc9392", "parents": ["abae9bbd39bdeb2cf419937f3e7e8f41a383ad71"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2082233. Don't get the image URI spec on every decode launch when the profiler isn't active. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333963\n", "files": ["image/DecodePool.cpp", "image/DecodePool.h", "image/RasterImage.cpp"], "git_node": "6a0c902b920ce2b4540c56c3c1b82d4f25307fbc", "git_parents": ["a522381a2a1800d978f9b9ecb1ec8c092a7a1306"], "node": "0a6edbf091b8e9f7bd4ab51730a0b272a1654c9a", "parents": ["4014b27eeba7889298d74b7b8636327042dc9392"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2082188 - Update authenticator-rs to 0.6.2 r=jschanck\n\nThis also updates `authrs_bridge` for API changes:\n\n* `StatusUpdate::NoDevicesFound` will send\n  `BrowserPromptType::NoDevicesFound`.  Wiring up the UI for this will be\n  handled in Bug 2082216.\n\n* `StatusUpdate::RequestLogging` will be handled in Bug 1868975.\n\n* `TestToken::manage_credentials` will be handled in Bug 1867285.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333941\n", "files": ["Cargo.lock", "dom/webauthn/authenticator/Cargo.toml", "dom/webauthn/authenticator/src/authenticatorservice.rs", "dom/webauthn/authenticator/src/crypto/mod.rs", "dom/webauthn/authenticator/src/ctap2/commands/authenticator_config.rs", "dom/webauthn/authenticator/src/ctap2/commands/bio_enrollment.rs", "dom/webauthn/authenticator/src/ctap2/commands/client_pin.rs", "dom/webauthn/authenticator/src/ctap2/commands/credential_management.rs", "dom/webauthn/authenticator/src/ctap2/commands/get_assertion.rs", "dom/webauthn/authenticator/src/ctap2/commands/large_blobs.rs", "dom/webauthn/authenticator/src/ctap2/commands/make_credentials.rs", "dom/webauthn/authenticator/src/ctap2/commands/mod.rs", "dom/webauthn/authenticator/src/ctap2/commands/reset.rs", "dom/webauthn/authenticator/src/ctap2/commands/selection.rs", "dom/webauthn/authenticator/src/ctap2/mod.rs", "dom/webauthn/authenticator/src/ctap2/preflight.rs", "dom/webauthn/authenticator/src/ctap2/server.rs", "dom/webauthn/authenticator/src/lib.rs", "dom/webauthn/authenticator/src/status_update.rs", "dom/webauthn/authenticator/src/transport/device_selector.rs", "dom/webauthn/authenticator/src/transport/freebsd/transaction.rs", "dom/webauthn/authenticator/src/transport/hid.rs", "dom/webauthn/authenticator/src/transport/linux/transaction.rs", "dom/webauthn/authenticator/src/transport/macos/transaction.rs", "dom/webauthn/authenticator/src/transport/mod.rs", "dom/webauthn/authenticator/src/transport/netbsd/monitor.rs", "dom/webauthn/authenticator/src/transport/netbsd/transaction.rs", "dom/webauthn/authenticator/src/transport/openbsd/monitor.rs", "dom/webauthn/authenticator/src/transport/openbsd/transaction.rs", "dom/webauthn/authenticator/src/transport/stub/transaction.rs", "dom/webauthn/authenticator/src/transport/windows/monitor.rs", "dom/webauthn/authenticator/src/transport/windows/transaction.rs", "dom/webauthn/authrs_bridge/src/lib.rs", "dom/webauthn/authrs_bridge/src/test_token.rs"], "git_node": "dc206cd6fbfa0de22960c08c6627ffc137a9aadf", "git_parents": ["6a0c902b920ce2b4540c56c3c1b82d4f25307fbc"], "node": "b39d67dfedd42d1730370cb98b646290e79282bd", "parents": ["0a6edbf091b8e9f7bd4ab51730a0b272a1654c9a"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2081040 - Skip authenticators that don't support required CTAP versions r=jschanck\n\n* Allow devices to indicate whether they support CTAP1.\n\n* CTAP1 downgrades may now throw an error.\n\n* CTAP1 TestToken now returns a `get_version` when it supports CTAP1.\n\n* Ignore devices that don't support CTAP1 when `security.webauthn.ctap2 =\n  false`.\n\n* Fail CTAP2-only requests immediately when `security.webauthn.ctap2 =\n  false`.\n\n* Ignore CTAP1-only devices for CTAP2-only requests.\n\n* Refactor some tests to handle versions properly.\n\nCherry-pick of https://github.com/mozilla/authenticator-rs/pull/370 and\npartial cherry-pick of D318670.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333509\n", "files": ["dom/webauthn/authenticator/src/authenticatorservice.rs", "dom/webauthn/authenticator/src/ctap2/commands/get_assertion.rs", "dom/webauthn/authenticator/src/ctap2/commands/get_info.rs", "dom/webauthn/authenticator/src/ctap2/commands/get_version.rs", "dom/webauthn/authenticator/src/ctap2/commands/large_blobs.rs", "dom/webauthn/authenticator/src/ctap2/commands/reset.rs", "dom/webauthn/authenticator/src/ctap2/commands/selection.rs", "dom/webauthn/authenticator/src/ctap2/mod.rs", "dom/webauthn/authenticator/src/lib.rs", "dom/webauthn/authenticator/src/statemachine.rs", "dom/webauthn/authenticator/src/transport/device_selector.rs", "dom/webauthn/authenticator/src/transport/freebsd/device.rs", "dom/webauthn/authenticator/src/transport/hid.rs", "dom/webauthn/authenticator/src/transport/linux/device.rs", "dom/webauthn/authenticator/src/transport/macos/device.rs", "dom/webauthn/authenticator/src/transport/mock/device.rs", "dom/webauthn/authenticator/src/transport/mod.rs", "dom/webauthn/authenticator/src/transport/netbsd/device.rs", "dom/webauthn/authenticator/src/transport/openbsd/device.rs", "dom/webauthn/authenticator/src/transport/stub/device.rs", "dom/webauthn/authenticator/src/transport/windows/device.rs", "dom/webauthn/authrs_bridge/src/test_token.rs"], "git_node": "8014960797439064c025f6bbc6a236558bd4f35f", "git_parents": ["dc206cd6fbfa0de22960c08c6627ffc137a9aadf"], "node": "21750dc4c701dcf4b9c666edc1e56c52f6e48077", "parents": ["b39d67dfedd42d1730370cb98b646290e79282bd"], "tags": []}], "date": 1792143777, "git_changesets": ["898450b886620ea9842f7295e7622046394759db", "23845b380086ad3f1bed87301b46033a733e5118", "5a357839f82b968d1bd35d3efecc76f4adfe8c3a", "267351349d4a816a697c6e2a501c8866ceef7267", "b5beca248fb3ef298a9520ba932e57fa00e34884", "77781751b18a86d9f75ca45793c88a57dac783e3", "7f30f992f9d8143b4070d52727dacb0ff72d3887", "f8ef0c56c8cd1baf21a89dd123e99a70c4de2429", "d0ea86476f04f971f250b9df378cb8fb2ad82142", "dd35dc22b43f50b03c6891ad3ef448118f2b603b", "bb816757ae1029c40ed19bf84706d1aadcb6efed", "337261eefe2ab68fad86c8b8c30f8fab0d272598", "d21ea628b741038a53c30de09a8ca7f941b1365b", "32e96b9033e7c19ffc5c037abbab399982d9c25c", "84193240666e18d78284eb3f7cd081d6cca54819", "b6d2ef4ba1ec7aad4c299beb063c4441d7795e29", "c0e99674dd93f531223294a546dd0ba14aac975e", "86eedd053a6e8f193cb81a44f592f7350af2dfb0", "98b67e62c75ccc2f28664a5c35d6a95bc33ce251", "fa8bea49589c5fbc7de1d9e3c88167ad40df196f", "d49e2c06d199c3c8c86e0914890f050820027385", "9098a3ec613cc29d1fc761ee8a36b482c88c249b", "e9b9909912060fc5659a3c63f28bb412ef25f895", "81c35398c176e1210407c0a1f70a5e819b248768", "5a6791cd8402c9a720de58f71ea3f27aa874c34b", "a8789871ff7043cdc92aaee408c9c5a1a14f4a66", "b3a883c7c51ec2bd84e58cf1034108b6d007511d", "f2cfd1be2b5549109a5ec77326b58412d50dd00f"