errerpolicy.html.ini", "testing/web-platform/meta/loading/early-hints/early-hints-response-time.h2.html.ini", "testing/web-platform/meta/mathml-aam/aamtests/attribute/__dir__.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/upgrade-insecure-requests/link-upgrade.sub.https.html.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_network_conditions/network_conditions_offline.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/duration.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/perform.py.ini", "testing/web-platform/meta/webmcp/imperative/executeTool-invalid-dictionary.https.html.ini", "testing/web-platform/meta/webmcp/imperative/getTools-imperative-annotations.https.html.ini", "testing/web-platform/meta/webmcp/imperative/opaque-origin-tools.https.html.ini", "testing/web-platform/meta/webmcp/imperative/register-tool-input-schema-registers-same-name.https.html.ini", "testing/web-platform/meta/webrtc-stats/supported-stats.https.html.ini", "testing/web-platform/meta/webstorage/storage_local_setitem_quotaexceedederr.window.js.ini", "testing/web-platform/meta/webstorage/storage_session_setitem_quotaexceedederr.window.js.ini"], "git_node": "73821b9c6c81e3bb79f4308c14ff18d74e933305", "git_parents": ["e396cb0d637721c9ca5636808cd27366390026be"], "node": "8c0662b43f93b14a02c9abe718386b6e595e6603", "parents": ["fa658b163f91b49616153424cf3292eaa26c9192"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079818 - Associate ScriptFetchInfo for frame, process and sub scripts. r=jonco,arai\" for causing hazard debug failures at ScriptLoader.cpp\n\nThis reverts commit da1cd85aa1bf0529c14dad8211243d724671f589.\n", "files": ["dom/base/nsFrameMessageManager.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_messagemanager_loadprocessscript_dynamic_import.js", "dom/base/test/file_precompiled_script_dynamic_import.js", "dom/base/test/file_process_script_dynamic_import.js", "dom/base/test/file_process_script_dynamic_import.sys.mjs", "dom/base/test/file_subscript_dynamic_import.js", "dom/base/test/file_subscript_dynamic_import.sys.mjs", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "js/loader/ImportMap.cpp", "js/xpconnect/loader/SyncModuleLoader.cpp", "js/xpconnect/loader/SyncModuleLoader.h", "js/xpconnect/loader/mozJSSubScriptLoader.cpp"], "git_node": "52a2cd5f180ee2a37b1ecf3b64f8acca14dbbfce", "git_parents": ["73821b9c6c81e3bb79f4308c14ff18d74e933305"], "node": "b587f18ae827bd1bbbf907686c38038bcc535288", "parents": ["8c0662b43f93b14a02c9abe718386b6e595e6603"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082024 - Handle hb_scalar_cache_t value quantization. r=gfx-reviewers,lsalzman\" for causing vendor failures at gfx/harfbuzz/moz.yaml\n\nThis reverts commit 8c3c63eae6673d68e113f8eb3ea3b53f9275a1b6.\n\nRevert \"Bug 2082024 - Cache advances during STCH measurement pass. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit 5bbda38c92792c970217b65781595d2488c55bb8.\n", "files": ["gfx/harfbuzz/src/hb-ot-layout-common.hh", "gfx/harfbuzz/src/hb-ot-shaper-arabic.cc", "gfx/harfbuzz/src/hb-ot-var-common.hh"], "git_node": "5e29f8179aed90ea445cb4ae960588d9100ad6d8", "git_parents": ["52a2cd5f180ee2a37b1ecf3b64f8acca14dbbfce"], "node": "0e24cd5fcc71aca5160cc3239e40b742532b9487", "parents": ["b587f18ae827bd1bbbf907686c38038bcc535288"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082884 - Remove browser.nova.enabled=false paths from contextualidentity tests. ? r=sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334767\n", "files": ["browser/components/contextualidentity/test/browser/browser_container_definitions_in_sync.js", "browser/components/contextualidentity/test/browser/browser_switchTab_across_user_context.js"], "git_node": "acf01dd3b0f25c63632a17df5df274156dc4ff43", "git_parents": ["5e29f8179aed90ea445cb4ae960588d9100ad6d8"], "node": "323dadca44b3e5056b66f13c6626f7d8b2c32df0", "parents": ["0e24cd5fcc71aca5160cc3239e40b742532b9487"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 1991748 - Support PCM (A_PCM/INT/LIT, audio/wave) in Matroska. r=media-playback-reviewers,padenot\n\nMatroskaDemuxer now handles NESTEGG_CODEC_PCM in\nSetContainerAudioCodecInfo. Only unambiguous little-endian integer\ndepths (8/16/24) are accepted: nestegg reports integer/float and\nlittle/big-endian PCM under one codec id, and 32-bit may be float,\nso those fall through to unsupported. The track is exposed as\naudio/wave; codecs=1 with the container bit depth, decoded by the\nexisting FFmpeg PCM path without extra work.\n\nPCM tracks carry no CodecPrivate data and nestegg reports an error\n(rather than zero headers) when none is present, so WebMDemuxer\nskips the CodecPrivate fetch for PCM instead of failing the track.\n\nMatroskaDecoder exposes pcm via GetTracksInfo/IsSupportedType and\nadds audio/wave to the no-codecs probe list.\n\nTest: move output_pcm.mkv from gUnsupportedMKVtests to gMKVtests so\ntest_mkv_playback.html plays it to the end. Also verified with a 5s\nPCM cut of a real-world HEVC+PCM file: plays to the end.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324630\n", "files": ["dom/media/test/manifest.js", "dom/media/test/mochitest.toml", "dom/media/test/test_unsupported_mkv.html", "dom/media/webm/MatroskaDecoder.cpp", "dom/media/webm/MatroskaDemuxer.cpp"], "git_node": "8abfa191ac9550143751745a091a8316bfdbedb4", "git_parents": ["acf01dd3b0f25c63632a17df5df274156dc4ff43"], "node": "1547f32c889d7379d95bcb25f5be67d94d71f53e", "parents": ["323dadca44b3e5056b66f13c6626f7d8b2c32df0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071291 - Move the documentation skill's API-reference and mermaid sections into bundled reference files. r=sylvestre DONTBUILD\n\nThe moved bullets are unchanged apart from naming mermaid-integration.md where they said \"that page\", and the `@type` prose bullet, which credited a plugin that does not exist. The JSDoc abort and the rule that a mermaid block always builds stay in SKILL.md.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333887\n", "files": [".agents/skills/documentation/SKILL.md", ".agents/skills/documentation/references/js-api-references.md", ".agents/skills/documentation/references/mermaid.md", ".claude/skills/documentation/SKILL.md", ".claude/skills/documentation/references/js-api-references.md", ".claude/skills/documentation/references/mermaid.md"], "git_node": "f0d36cc1fe3bb75e6e38679b20f34f9b016c6384", "git_parents": ["8abfa191ac9550143751745a091a8316bfdbedb4"], "node": "a4aee44c60fead94ef4ef3fe0d07a2bb0d582e17", "parents": ["1547f32c889d7379d95bcb25f5be67d94d71f53e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071292 - Tell the documentation skill how to fix a generated API page or a diagram that comes out wrong. r=sylvestre DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333903\n", "files": [".agents/skills/documentation/SKILL.md", ".agents/skills/documentation/references/js-api-references.md", ".agents/skills/documentation/references/mermaid.md", ".claude/skills/documentation/SKILL.md", ".claude/skills/documentation/references/js-api-references.md", ".claude/skills/documentation/references/mermaid.md"], "git_node": "a0493903944ea2f43ec0f9941cca40c680908559", "git_parents": ["f0d36cc1fe3bb75e6e38679b20f34f9b016c6384"], "node": "e4fd3d78bd275bad2ab5de6166d480cd27a4b74c", "parents": ["a4aee44c60fead94ef4ef3fe0d07a2bb0d582e17"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082314 - Tell the documentation skill what to name an options parameter and where to document a runtime check in a generated API page. r=sylvestre DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334013\n", "files": [".agents/skills/documentation/references/js-api-references.md", ".claude/skills/documentation/references/js-api-references.md"], "git_node": "d55b0da63c14c82ae9af3ca2cb56966c2e8b32be", "git_parents": ["a0493903944ea2f43ec0f9941cca40c680908559"], "node": "56182af9e1c8ce4a34eeaecfb18de7f02eeb2ff5", "parents": ["e4fd3d78bd275bad2ab5de6166d480cd27a4b74c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082765 - Import SessionStore and PageThumbs in the tabbrowser modules that read them off a window (no functional change). r=tabbrowser-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334420\n", "files": ["browser/components/tabbrowser/GroupsList.sys.mjs", "browser/components/tabbrowser/content/tab-groups-list.mjs", "browser/components/tabbrowser/content/tab-hover-preview.mjs"], "git_node": "9956fbce72f272bb8af1f2bf946e844715aec624", "git_parents": ["d55b0da63c14c82ae9af3ca2cb56966c2e8b32be"], "node": "752b53e6f4560ab3b8114838fe4ff765ee99d391", "parents": ["56182af9e1c8ce4a34eeaecfb18de7f02eeb2ff5"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083820 - Enable building the fontations code in Nightly builds. r=firefox-build-system-reviewers,ahochheiden\" for causing mass failures at MOZ_Crash / gfxFontGroup::GetDefaultFont\n\nThis reverts commit 76d1b935ad7aa029786f2fe1fc4a87c60afc5268.\n", "files": ["toolkit/moz.configure"], "git_node": "f27ae99cfb872634dd7c6c282528f90c59275eb4", "git_parents": ["9956fbce72f272bb8af1f2bf946e844715aec624"], "node": "bd1d752e914ea3ca8dd8230d2a38d9d1473bd130", "parents": ["752b53e6f4560ab3b8114838fe4ff765ee99d391"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074327 - New container icons r=sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334719\n", "files": ["browser/components/contextualidentity/content/briefcase.svg", "browser/components/contextualidentity/content/cart.svg", "browser/components/contextualidentity/content/chill.svg", "browser/components/contextualidentity/content/circle.svg", "browser/components/contextualidentity/content/dollar.svg", "browser/components/contextualidentity/content/fence.svg", "browser/components/contextualidentity/content/food.svg", "browser/components/contextualidentity/content/fruit.svg", "browser/components/contextualidentity/content/gift.svg", "browser/components/contextualidentity/content/pet.svg", "browser/components/contextualidentity/content/tree.svg", "browser/components/contextualidentity/content/vacation.svg"], "git_node": "69e64174fee9ddcb0bc20c7138dfe823f41e3945", "git_parents": ["f27ae99cfb872634dd7c6c282528f90c59275eb4"], "node": "7b8fc2ea04adb7f42d8f5bd00795bb4e50707604", "parents": ["bd1d752e914ea3ca8dd8230d2a38d9d1473bd130"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084102 - Stop parsing all xul attributes as atoms. r=webidl,jjaschke\n\nWe don't need this, and it makes the next patch work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335561\n", "files": ["dom/xul/nsXULElement.cpp"], "git_node": "87574cb2d4c7f5651887e5959304b4661c051125", "git_parents": ["69e64174fee9ddcb0bc20c7138dfe823f41e3945"], "node": "f822462307e520a9b71b2fa348a5f763cb4552d6", "parents": ["7b8fc2ea04adb7f42d8f5bd00795bb4e50707604"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083686 - Set browser.download.dir to the directory path in browser_save_link_when_window_navigates.js. r=firefox-desktop-core-reviewers ,mossop\n\nThe pref was set to the nsIFile object itself, which isn't a valid path, so\nthe download code failed to read it and fell back to the default downloads\ndirectory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335275\n", "files": ["browser/base/content/test/browser-general/browser_save_link_when_window_navigates.js"], "git_node": "53ea959bb7dfd634040c3a6253c0bdbc85418c77", "git_parents": ["87574cb2d4c7f5651887e5959304b4661c051125"], "node": "d22b1e929317cfeb4d0f88adc132e4615f63616b", "parents": ["f822462307e520a9b71b2fa348a5f763cb4552d6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2026584. Correctly set the (unused) YCbCr skip fields in the AVIF decoder. r=gfx-reviewers,lsalzman\n\nThe skip fields in PlanarYCbCrData are the number of samples skipped between\nadjacent samples in a row, so they are only non-zero for interleaved formats,\nfor planar formats they zero. Dav1dPictureToDecodedData and\nAOMImageToToDecodedData set them to stride minus width, which is the row\npadding, which is not correct. But nothing reads these fields in the AVIF path\ntoday, ConvertYCbCrToRGB32 only uses the strides, so it doesn't cause any\nissues. Our data is planar, so leave them at their default of 0.\n\nAlso, fix up and improve the comment example above PlanarYCbCrImage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335459\n", "files": ["gfx/layers/ImageContainer.h", "image/decoders/nsAVIFDecoder.cpp"], "git_node": "207eb67cf6e29277a80bcdac22c3198558a9d113", "git_parents": ["53ea959bb7dfd634040c3a6253c0bdbc85418c77"], "node": "5eb243c88de846308389550cd6ef3089f980f73c", "parents": ["d22b1e929317cfeb4d0f88adc132e4615f63616b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082560 - Only clone fully parsed options for selectedcontent updates. r=jjaschke,smaug\n\nSo the reason why at least the simplified pages aren't supposed to\ntrigger this per spec is fun...\n\nThe spec updates run sync on post-connection (before the script is\nconnected), and our script runner is too late and already sees the\nscript.\n\nThen the spec updates when popped from the stack of open elements (after\nthe script is done executing). We do that on\nHTMLSelectElement::ContentAppendedOrInserted (which is fine).\n\nBut that means that if there's a microtask scheduled but not from\nscript, then that causes the same issue to happen. See the two tentative\ntests, which fail in Chromium, which rely on the removal from the\nadoption agency algorithm to schedule a microtask.\n\nIn order to be reliable, at least while we sort this out in the spec\nside of things, track whether we're done parsing the option, and refuse\nto clone such an option until we pop it from the stack of open elements.\n\nIt's quite a heavy hammer, but...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334246\n", "files": ["dom/base/nsIContent.h", "dom/html/HTMLOptionElement.cpp", "dom/html/HTMLOptionElement.h", "dom/html/HTMLSelectElement.cpp", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-parser-removal-csp-strict-dynamic.tentative.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-parser-removal-script-runs-once.tentative.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-parser-script-csp-strict-dynamic.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-parser-script-runs-once.html"], "git_node": "7beea75fbc8080a22b9354df4e4d1dbc7a126394", "git_parents": ["207eb67cf6e29277a80bcdac22c3198558a9d113"], "node": "0a83eca3544fec25db244823b0045806b3604ad3", "parents": ["5eb243c88de846308389550cd6ef3089f980f73c"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in dom/media/ r=webrtc-reviewers,pehrsons\n\nThose cases have been detected by an in-progress checker. Expanation\nfollows below:\n\nFor dom/media/webrtc/jsapi/RTCStatsReport.h:\n\n  template \u003ctypename T\u003e\n  nsresult SetRTCStats(T& aValue) {\n        ...\n        ToJSValue(cx, std::forward\u003cT\u003e(aValue), &val)\n        ...\n  }\n\nIn that case, std::forward\u003cT\u003e always returns a T&&, so it's actually an\nstd::move (which is a bit surprising, as it leaves behind a reference to\na moved object.\n\n--\n\nFor dom/media/webrtc/libwebrtcglue/WebrtcTaskQueueWrapper.cpp:\n\n  template \u003ctypename Wrapper\u003e\n  explicit TaskQueueObserver(Wrapper aOwner)\n      : mOwner(std::forward\u003cWrapper\u003e(aOwner)) {}\n\n  ...\n\n  std::conditional_t\u003cDeletion == DeletionPolicy::NonBlocking,\n                     UniquePtr\u003cWebrtcTaskQueueWrapper\u003e,\n                     WebrtcTaskQueueWrapper*\u003e const mOwner;\n\nIn that case, if the call site is an r-value, then we get one copy-move\nat call site, and a copy at field initialization. If the call site is an\nl-value, we get a copy at call site and a copy at field initialization.\nWith an universal reference, if the call site is a r-value we get no\ncopy at call site and one copy at field initialization, and if it's an\nl-value, we get two copy-move.\n\n--\n\nFor dom/media/webrtc/transport/runnable_utils.h:\n\n  template \u003ctypename... Arguments\u003e\n  runnable_args_memfn_ret(Ret* ret, Class&& obj, M method, Arguments... args)\n      : mReturn(ret),\n        mObj(std::forward\u003cClass\u003e(obj)),\n        mMethod(method),\n        mArgs(std::forward\u003cArguments\u003e(args)...) {}\n\n  ...\n\n  std::tuple\u003cArgs...\u003e mArgs;\n\nAs `Arguments` and  `Args` are not related, omitting universal\nreference on `Arguments...` can lead to spurious copies at call site.\n`std::forward\u003cArguments\u003e` will always return an l-value in that case\nwhich is not incorrect, but it's suboptimal.\n\nOne notable change is that if `Args` ever happen to be a reference, it\nis currently a compile error while it could be accepted. The wrapper\ncreator uses\n\n  runnable_args_memfn_ret\u003cR, Class, M, std::decay_t\u003cArgs\u003e...\u003e\n\nso I think it's fine. I've added a static_assert for good measure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334097\n", "files": ["dom/media/webrtc/jsapi/RTCStatsReport.h", "dom/media/webrtc/libwebrtcglue/WebrtcTaskQueueWrapper.cpp", "dom/media/webrtc/transport/runnable_utils.h"], "git_node": "2edf9add742a06068710386b7500fa10a413abf1", "git_parents": ["7beea75fbc8080a22b9354df4e4d1dbc7a126394"], "node": "8facc20d09c783c7421cc59664e1ca94f60226c7", "parents": ["0a83eca3544fec25db244823b0045806b3604ad3"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in editor/ r=masayuki\n\ntemplate \u003ctypename StrongNodePtr\u003e\n  MOZ_CAN_RUN_SCRIPT static void RemoveContentFromNACArray(StrongNodePtr& aAnonymousContent) {\n    ...\n    // aAnonymousContent may be a class member. Let's move the ownership to\n    // the local strong pointer.\n    StrongNodePtr anonymousContent = std::forward\u003cStrongNodePtr\u003e(aAnonymousContent);\n    ...\n  }\n\nThe call to `std::forward`` always create an r-value from a reference,\nso it's actually an `std::move`, as hinted by the comment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334098\n", "files": ["editor/libeditor/ManualNAC.h"], "git_node": "20b5af41e4cb81288020157e1989f32b9ccd780a", "git_parents": ["2edf9add742a06068710386b7500fa10a413abf1"], "node": "4ba42ea11cd457b0c37547f409c210bc46db209e", "parents": ["8facc20d09c783c7421cc59664e1ca94f60226c7"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in image/ r=gfx-reviewers,lsalzman\n\nAll function arguments referenced in that patch are passed as value and\nthat value is then `std::forward`ed. This implies a copy at call site,\nit can eventually be avoided by using universal references instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334099\n", "files": ["image/SurfacePipe.h", "image/test/gtest/TestADAM7InterpolatingFilter.cpp", "image/test/gtest/TestDeinterlacingFilter.cpp", "image/test/gtest/TestDownscalingFilter.cpp", "image/test/gtest/TestRemoveFrameRectFilter.cpp", "image/test/gtest/TestSurfaceSink.cpp", "image/test/gtest/TestSwizzleFilter.cpp"], "git_node": "5636a6177d2c58d528b6b4417db2defb980a4f6b", "git_parents": ["20b5af41e4cb81288020157e1989f32b9ccd780a"], "node": "8baa17c4964afd8a74ac3ccd12f354a289197023", "parents": ["4ba42ea11cd457b0c37547f409c210bc46db209e"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in js/ r=spidermonkey-reviewers,jonco\n\nOriginal code was:\n\n   template \u003ctypename RootHolder, typename... CtorArgs, typename = std::enable_if_t\u003cdetail::IsTraceable_v\u003cT\u003e, RootHolder\u003e\u003e\n   explicit PersistentRooted(const RootHolder& cx, CtorArgs... args)\n   : ptr(std::forward\u003cCtorArgs\u003e(args)...) {\n\nAs `CtorArgs` is not a universal reference, it will always be deduced as\na value, potentially implying a copy at call-site, followed by a\ncopy-move to initialize `ptr`. With a universal reference, the original\ncopy at call site may be omitted, or turned into a copy-move.\n\nSurrounding code uses universal references, so I assume this behavior is\na mistake and was not intended.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334100\n", "files": ["js/public/RootingAPI.h"], "git_node": "31e6ba3ba770bf23c2c7764b5bf29cacaa74fe6f", "git_parents": ["5636a6177d2c58d528b6b4417db2defb980a4f6b"], "node": "2ce647be779740906fbb46736c46e424a12fc8be", "parents": ["8baa17c4964afd8a74ac3ccd12f354a289197023"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in mfbt/ r=nika\n\nForwarding parameters makes more sense if the parameters are universal\nreferences, otherwise we'd better use std::move. In that case it's a\ntypical forwarding pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334101\n", "files": ["mfbt/tests/TestFunctionRef.cpp"], "git_node": "de03ce77af99de55810c07fc563a46e952618c07", "git_parents": ["31e6ba3ba770bf23c2c7764b5bf29cacaa74fe6f"], "node": "3c158289fad42257c225aa1fb773cad8800a3af7", "parents": ["2ce647be779740906fbb46736c46e424a12fc8be"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in security/ r=emilio\n\nOriginal code was:\n\n    template \u003ctypename... Storages, typename Result, typename... Args\u003e\n    nsresult ImplXpcomMethod(LockstoreService* aLockstore, JSContext* aCx,\n                             Promise** aPromise,\n                             Result (LockstoreService::*aMethod)(Args...),\n                             Storages... aArgs) {\n        ...\n        [self = RefPtr{aLockstore}, aMethod, domHandle,\n           ... args = std::forward\u003cStorages\u003e(aArgs)]() mutable { ...}\n        ...\n\nwhich is not the easiest to read, but basically `aArgs` is passed by\ncopy, and then moved (through a dubious call to `std::forward`) to the\ncapture. Using universal references would avoid the copy at call site\nbut may lead to capturing as reference, which is probably not what we\nwant here. I made the intent clear and used an `std::move`, which does\nnot change the semantic of current code while making the intent clear.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334102\n", "files": ["security/lockstore/LockstoreService.cpp"], "git_node": "7d6077f22e437c6e1c42c4c5ef2d504c2d36fc43", "git_parents": ["de03ce77af99de55810c07fc563a46e952618c07"], "node": "9ac846b59b6143eb21458deb7b71fbce9cef55d3", "parents": ["3c158289fad42257c225aa1fb773cad8800a3af7"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in widget/ r=emilio\n\nConcerning the change in widget/PrintBackgroundTask.h:\n\n  template \u003ctypename T, typename Result\u003e\n  void ResolveOrReject(dom::Promise& aPromise, T&, Result& aResult) {\n    aPromise.MaybeResolve(std::forward\u003cResult\u003e(aResult));\n  }\n\nThe forward here is actually equivalent to a move (when Result is\ninferred), so I replaced it with an `std::move` to make the intent\nclear. Which is still surprising because it creates a reference to a\nmoved object. Alternatively we could have used a universal reference,\nbut that would change the semantic of the code that would allow l-value\nas parameter, and `MaybeResolve` would receive a reference instead of a\nmoved object.\n\nConcerning the other changes, they just prevent copy at call sites and\nfollow the typical perfect forwarding pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334103\n", "files": ["widget/PrintBackgroundTask.h", "widget/nsPrinterBase.cpp", "widget/nsPrinterBase.h"], "git_node": "080599921876e2fd59e2efd875d11ad03483dd0a", "git_parents": ["7d6077f22e437c6e1c42c4c5ef2d504c2d36fc43"], "node": "de57dbb9e6d071153ee33c404993fc651a6f55be", "parents": ["9ac846b59b6143eb21458deb7b71fbce9cef55d3"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in xpcom/ r=xpcom-reviewers,emilio\n\nJust follow the typical perfect forwarding pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334104\n", "files": ["xpcom/tests/gtest/TestMozPromise.cpp"], "git_node": "19415d7b7e68f1ceb663742b56afe0ca14442b03", "git_parents": ["080599921876e2fd59e2efd875d11ad03483dd0a"], "node": "6d1db8879afa91c5053707db5f1032086dd7c84b", "parents": ["de57dbb9e6d071153ee33c404993fc651a6f55be"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Add static analyzer for incorrect use of std::forward r=nika\n\nThis clang-tidy check recognizes perfect forwarding pattern where\nuniversal references are omitted, leading to sub-optimal code, or\nreference pointing at moved objects.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334105\n", "files": ["build/clang-plugin/Checks.inc", "build/clang-plugin/ChecksIncludes.inc", "build/clang-plugin/IncorrectStdForwardUsageChecker.cpp", "build/clang-plugin/IncorrectStdForwardUsageChecker.h", "build/clang-plugin/moz.build", "build/clang-plugin/tests/TestIncorrectStdForwardUsage.cpp", "build/clang-plugin/tests/moz.build"], "git_node": "bfbb029ff56ce8c959bf8e79608f330a7d769faa", "git_parents": ["19415d7b7e68f1ceb663742b56afe0ca14442b03"], "node": "deb33faaaa9eb60360c3a59859411cf5434c6106", "parents": ["6d1db8879afa91c5053707db5f1032086dd7c84b"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082039 - Hold strong reference to ImageListener and requests during OnStartRequest r=smaug\n\nDuring ImageListener::OnStartRequest -\u003e AddNativeObserver, ReplayImageStatus calls can make things happen on the event loop, which potentially can invalidate weak references.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334458\n", "files": ["dom/base/crashtests/2082038.html", "dom/base/crashtests/crashtests.list", "dom/base/nsImageLoadingContent.cpp", "dom/html/ImageDocument.cpp"], "git_node": "4b5adb7ff01b45440cd511e815c49db39d93d1df", "git_parents": ["bfbb029ff56ce8c959bf8e79608f330a7d769faa"], "node": "e1f9f3c9d45b85a73c2992e8ccdb7dae9d678056", "parents": ["deb33faaaa9eb60360c3a59859411cf5434c6106"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1819165 - Implement StylePropertyMap.append(). r=janv,firefox-style-system-reviewers,dshin\n\nAdd a few tests for things that went wrong during the first version of\nthis.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335346\n", "files": ["layout/style/CSSPropFlags.h", "layout/style/GenerateCSSProperties.py", "layout/style/typedom/StylePropertyMap.cpp", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/mod.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-properties-values-api/typedom.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/declared/append.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/inline/append.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/inline/attribute-changed-callback.html.ini", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/append-space-separated.tentative.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/declared/append.tentative.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/inline/append.tentative.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/inline/attribute-changed-callback.html"], "git_node": "c07b594b28e5d24633c3742f788b95d7b5891662", "git_parents": ["4b5adb7ff01b45440cd511e815c49db39d93d1df"], "node": "f139ee0b27c5352ece52a36446f3b0dfab6dfbcb", "parents": ["e1f9f3c9d45b85a73c2992e8ccdb7dae9d678056"], "tags": []}, {"author": "Arne Fucks \u003cafucks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080863 - Shift-reload should only clear Alt-Svc mappings matching the channel's origin attributes r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335114\n", "files": ["netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/AlternateServices.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_freshconnection_origin_attributes.js"], "git_node": "dce017a437f391c56f0ef975671b94706f8c74f2", "git_parents": ["c07b594b28e5d24633c3742f788b95d7b5891662"], "node": "f233e8c1902b55e012a29399444df504770bccb6", "parents": ["f139ee0b27c5352ece52a36446f3b0dfab6dfbcb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080652 - More thoroughly make sure that scripts in \u003cuse\u003e are inert. r=longsonr,webidl,smaug\n\nThey usually are because they are marked as `mAlreadyStarted` by the\ntime we clone them, but there are two cases where that doesn't work out.\n\nOne is this CSP issue, another is when the type attribute is originally\nnot JS and gets changed. This patch fixes both. The test is a bit gnarly\nbecause we need a flush while the script is created but before it's\nexecuted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334025\n", "files": ["dom/script/ScriptElement.cpp", "testing/web-platform/tests/svg/struct/scripted/support/use-script-strict-dynamic.js", "testing/web-platform/tests/svg/struct/scripted/use-script-not-executed.html"], "git_node": "09fd7b70aa9520d09de3d248e60e507c80baba7d", "git_parents": ["dce017a437f391c56f0ef975671b94706f8c74f2"], "node": "15c8024812b59958e08baecb86b75ab9af92a606", "parents": ["f233e8c1902b55e012a29399444df504770bccb6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083469 - Remove redundant virtual specifiers in DrawTargetRecording.h. r=gfx-reviewers,lsalzman\n\nDrive-by while I was looking at this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334892\n", "files": ["gfx/2d/DrawTargetRecording.h"], "git_node": "aa9baae5c92041881e8d8148bba8ef34cf100946", "git_parents": ["09fd7b70aa9520d09de3d248e60e507c80baba7d"], "node": "a59f2e45b545a36d7e29021c9b67bd93ac75f650", "parents": ["15c8024812b59958e08baecb86b75ab9af92a606"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082785 - [wptrunner] Set the Local Network Access address-space override prefs for Firefox. r=jgraham\" for causing wpt tests failures at non-local-ports.sub.window.html\n\nThis reverts commit bc2fefa19c4666159fe5c84893836649a2169d3c.\n", "files": ["testing/web-platform/meta/fetch/local-network-access/__dir__.ini", "testing/web-platform/meta/fetch/local-network-access/iframe-opener.tentative.https.html.ini", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py"], "git_node": "86bc6525ca63e52c669687754bb5964c20665cdb", "git_parents": ["aa9baae5c92041881e8d8148bba8ef34cf100946"], "node": "3b53e7f1e35bb96229b05019b5bce6fc2c5d125d", "parents": ["a59f2e45b545a36d7e29021c9b67bd93ac75f650"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082488 - update metadata\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.ini"], "git_node": "346ea394c772bea0194aa195ccfa3d50584279af", "git_parents": ["86bc6525ca63e52c669687754bb5964c20665cdb"], "node": "a1606714157e770bc7254a5dadf05af6b15c60fa", "parents": ["3b53e7f1e35bb96229b05019b5bce6fc2c5d125d"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082488 - further update metadata\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.ini"], "git_node": "7a4c788fad3f1cf029d3a419cc9b3c092129cb34", "git_parents": ["346ea394c772bea0194aa195ccfa3d50584279af"], "node": "7fb94146da9d0ca883c4d4e8e3ecaf0c437c29ca", "parents": ["a1606714157e770bc7254a5dadf05af6b15c60fa"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2076948 - Use exact permission check for open-protocol-handler. r=emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335341\n", "files": ["toolkit/mozapps/handling/ContentDispatchChooser.sys.mjs", "uriloader/exthandler/tests/unit/test_launch_first_click_with_permission.js"], "git_node": "4a9dc46a47bbb61a369c22e14256c87eb931049b", "git_parents": ["7a4c788fad3f1cf029d3a419cc9b3c092129cb34"], "node": "a23c689f9e69bb4d7f9a1cd86b5c395c017900fc", "parents": ["7fb94146da9d0ca883c4d4e8e3ecaf0c437c29ca"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084014 - Reset GrayBitsInvalidatedInCurrentGC state at the end of barrier verification r=spidermonkey-reviewers,yulia\n\nThe pre-barrier verify simulates being in a GC to enable barriers. But it\ndoesn't do all the cleanup that normally happens at the end of a GC, including\nthe recent change to reset this flag bit. This can get set if something sets\nthe gray bits to invalid while a GC is running.\n\nThe fix is to do the cleanup and clear this flag. The verifier sets the gray\nbits invalid state itself at the start so this is asserted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335569\n", "files": ["js/src/gc/Verifier.cpp", "js/src/jit-test/tests/gc/bug-2084014.js"], "git_node": "ca379fc24380941bce9debca05d51e3da9142354", "git_parents": ["4a9dc46a47bbb61a369c22e14256c87eb931049b"], "node": "df4522bca8b33b84e8bcb7768cddb9edf47047f8", "parents": ["a23c689f9e69bb4d7f9a1cd86b5c395c017900fc"], "tags": []}, {"author": "Wyatt Verchere \u003cwverchere@gmail.com\u003e", "branch": "default", "desc": "Bug 2083822 - Vendor application-services cb05b48. r=bdk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335288\n", "files": ["Cargo.lock", "docs/rust-components/api/js/autofill.md", "third_party/application-services/components/ads-client/docs/usage-javascript.md", "third_party/application-services/components/ads-client/docs/usage-kotlin.md", "third_party/application-services/components/ads-client/docs/usage-swift.md", "third_party/application-services/components/ads-client/integration-tests/tests/ads_store.rs", "third_party/application-services/components/ads-client/integration-tests/tests/mars.rs", "third_party/application-services/components/ads-client/src/ads.rs", "third_party/application-services/components/ads-client/src/ads_store.rs", "third_party/application-services/components/ads-client/src/ads_store/builder.rs", "third_party/application-services/components/ads-client/src/client.rs", "third_party/application-services/components/ads-client/src/client/config.rs", "third_party/application-services/components/ads-client/src/ffi.rs", "third_party/application-services/components/ads-client/src/ffi/telemetry.rs", "third_party/application-services/components/ads-client/src/lib.rs", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/ad_response.rs", "third_party/application-services/components/ads-client/src/mars/transport.rs", "third_party/application-services/components/ads-client/src/telemetry.rs", "third_party/application-services/components/ads-client/src/telemetry/backend.rs", "third_party/application-services/components/ads-client/src/test_utils.rs", "third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/db/models/credit_card.rs", "third_party/application-services/components/autofill/src/db/store.rs", "third_party/application-services/components/nimbus/android/src/main/java/org/mozilla/experiments/nimbus/Nimbus.kt", "third_party/application-services/components/nimbus/android/src/test/java/org/mozilla/experiments/nimbus/NimbusTests.kt", "third_party/application-services/components/nimbus/metrics.yaml", "third_party/application-services/components/nimbus/src/metrics.rs", "third_party/application-services/components/nimbus/src/nimbus.udl", "third_party/application-services/components/nimbus/src/stateful/enrollment.rs", "third_party/application-services/components/nimbus/src/stateful/nimbus_client.rs", "third_party/application-services/components/nimbus/src/tests/helpers.rs", "third_party/application-services/components/nimbus/src/tests/stateful/test_nimbus.rs", "third_party/application-services/components/nimbus/tests/common.rs", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.timestamp", "third_party/application-services/components/remote_settings/dumps/main/search-config-v3.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-v3.timestamp", "third_party/application-services/components/remote_settings/dumps/main/search-telemetry-v2.json", "third_party/application-services/components/remote_settings/dumps/main/search-telemetry-v2.timestamp", "third_party/application-services/components/remote_settings/src/client.rs", "third_party/application-services/components/support/error/Cargo.toml", "third_party/application-services/components/support/error/src/error_tracing.rs", "third_party/application-services/components/sync15/src/client/coll_state.rs", "third_party/application-services/components/sync15/src/client/state.rs", "third_party/application-services/components/sync15/src/client/storage_client.rs", "third_party/application-services/components/sync15/src/record_types.rs", "third_party/application-services/examples/nimbus/src/main.rs", 