348d41e59f0e", "093b8947f7af15418af3efdd3482ef78bb5ad968", "d69c820c03735b4f1bdcc5045c09a4949cfd6ddf", "4e8e21921e78e8d6d136ec4400d6dcb61c06ae36", "88974fa85b18c044c60091dfba3f03191cf27966", "e91b4aec6ab1927edc2905705494ef61c9ec9546", "8eaf47fe7ffc265aa5a23163b458c5dd590cda81", "dd75ebbe56742d31f7ec424bc500bf216a01f855", "e665f57ae8805c856e55f4888d3edab9c2cf0d61", "80473049a645c845146f4d0825c04f7af3c190b4", "03a76a59168bbeccd32575ee48a3ac1733fb9247", "5e7366f3823ca856cb70d9adcfaea054296c212d", "59c04986d90655f408304af1a69f8ab4f26052db", "2ddd918c3798192a3c1444a4deb1d8aedceef5f3", "ad7d3abc68f82e0200b37e32e10d860c32341047", "7c2abfd83d57e8e46e5649185d549c37c40eda1b", "41151a5af0cf6559f0f1fb9350e3ce792daad778", "f17065d709c82be59bd4d56f1440c340fd37e9b3", "5796ef9b9a0f7032bdd1c404e74a281b39459459", "0798aab5f6e3202b3fdfc63b09fb86bc5845acf7", "1ddb9c4442911a32de546268ccb3ad7bb674c3c4", "48b05be90ecb21c07ce1eb642048e38354320440", "8e296b72a9e75e7bfbbdba342d89a39a507b320a", "90158cd3d291b08476fe7561411b0ce4f58af75c", "c753fc7b4dc0d7362e0be7a3859b65dc59c989a6", "9a5ec3c027760a54ca9ac59ce15ba60279c1f94b", "c64b6907d64ab7d6dea8b1f3097287802d9e7c8e", "ec62a67a56cc3ee93871f884edf3ba13ff5bc5c7", "d24a903cc7779f6913377c7ad7bafb77cf762277", "a038980745a345c6d1e7ace523edb1cec6a99108", "856e84a650bf043b77d7f1e066b24324ffd0c9c2", "c66c7b2104a1ba28e4047c876d139d58cff61761", "997f570a3a323eafe02b3689e04d762b9f4a3c40"], "user": "amarc@mozilla.com"}, "45547": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2080059 - Align recently added rust-based toolchains with existing ones. r=firefox-build-system-reviewers,ahochheiden\n\nParts were apparently cargo-culted from geckodriver, which is a little\nspecial, but those toolchains don't need to be a little special.\n\nOnly socorro-cli needs to keep the use of the toolchain-sysroot because\nof its need for libdbus-1-dev, which is not in the Firefox sysroot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332290\n", "files": ["taskcluster/kinds/toolchain/embedded-uniffi-bindgen.yml", "taskcluster/kinds/toolchain/mozcheck.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml", "taskcluster/kinds/toolchain/searchfox-cli.yml", "taskcluster/kinds/toolchain/stmo-cli.yml", "taskcluster/kinds/toolchain/treeherder-cli.yml", "taskcluster/kinds/toolchain/webspec-index.yml"], "git_node": "c383d0da0483070b65c785638c8d24fb9a37a8c9", "git_parents": ["997f570a3a323eafe02b3689e04d762b9f4a3c40"], "node": "5d4ec106c0eb3fb7486a7858cd3653530b037670", "parents": ["d763217e1f6b97b38b58573cedcbc64a0202002b"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080060: Use the Finder default application when opening downloaded files on macOS. r=mac-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333048\n", "files": ["uriloader/exthandler/mac/nsMIMEInfoMac.mm"], "git_node": "cf6e72f4ba44b2f9198d670c973d224250cae0d6", "git_parents": ["c383d0da0483070b65c785638c8d24fb9a37a8c9"], "node": "8b4b462da029d8acf27119ba08acac375fddf193", "parents": ["5d4ec106c0eb3fb7486a7858cd3653530b037670"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080876 - Part 1: Answer GMP support queries in child processes from the cached capabilities. r=media-playback-reviewers,jolin\n\nRead the cached GMP capability list directly when answering GMP support\nqueries in child processes, instead of getting the GMP service first.\nThe parent process sends this list to each content process, and the\nchild GMP service already answered from it, so the answers do not\nchange. Also clear the list under its lock at shutdown, because any\nthread can now read it.\n\nGetting the service created it lazily. When the first query came from a\nbackground thread, a main thread query made at the same time could wait\nforever for that creation to finish, because the creation itself needs\nthe main thread.\n\nLate in shutdown, a child process can now answer from the cached list,\nwhere it used to answer no because the service could no longer be\ncreated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333074\n", "files": ["dom/media/gmp/GMPServiceChild.cpp", "dom/media/gmp/GMPServiceChild.h", "dom/media/gmp/GMPUtils.cpp"], "git_node": "0a391bbac7f411b01d22a4eff1bbf0f110c2372a", "git_parents": ["cf6e72f4ba44b2f9198d670c973d224250cae0d6"], "node": "680d388dabe08ba67a91c23ecdf8e6913dd60348", "parents": ["8b4b462da029d8acf27119ba08acac375fddf193"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080876 - Part 2: Add a test for EME requests racing GMP service creation from MediaCapabilities. r=media-playback-reviewers,jolin\n\nAdd a browser test that queries media capabilities and then requests key\nsystem access in a fresh content process that has not created the GMP\nservice yet. The test blocks the main thread between the two calls so\nthat the background support query runs first, and checks that both\nrequests resolve.\n\nThis is the sequence Prime Video uses on load. Before the fix, the\ncapabilities query started creating the GMP service on a background task\nqueue and waited for the main thread, while the key system request\nwaited on the main thread for that pending creation, so neither request\nfinished.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333075\n", "files": ["dom/media/test/browser/browser.toml", "dom/media/test/browser/browser_eme_gmp_service_creation_race.js"], "git_node": "880099cab927813ecc4bf7ca1a6a9b4985220137", "git_parents": ["0a391bbac7f411b01d22a4eff1bbf0f110c2372a"], "node": "62134d3c511273a73624a31f0bdaa23b0033f168", "parents": ["680d388dabe08ba67a91c23ecdf8e6913dd60348"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2080792 - Move EvalOptions::setUseInnerBindings() to match getter/setter order. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332838\n", "files": ["js/src/debugger/Debugger.h"], "git_node": "3627d7bd06d41db35ceced72b54b7b416100476b", "git_parents": ["880099cab927813ecc4bf7ca1a6a9b4985220137"], "node": "4b1612e038d07f477e8b44d1c64e0ee9d71d1af2", "parents": ["62134d3c511273a73624a31f0bdaa23b0033f168"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045704: Validate LoadInfoArgs and HTTP channel flags r=necko-reviewers,nika,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305263\n", "files": ["netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h"], "git_node": "c238e4215cd4524fdf0491adee7caeedfb1d9e1e", "git_parents": ["3627d7bd06d41db35ceced72b54b7b416100476b"], "node": "d8f307d6c6746616d6be584ed77c272644cdd956", "parents": ["4b1612e038d07f477e8b44d1c64e0ee9d71d1af2"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045704: Resend DevTools document and object requests as TYPE_OTHER r=devtools-reviewers,bomsy\n\nContent processes can no longer open document, subdocument or object loads\nover PHttpChannel, so resending such a request from the console or netmonitor\nwas blocked.  Use TYPE_OTHER for these, and drop the now-unreachable HTTPS\nupgrade telemetry annotation for TYPE_DOCUMENT resends.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331198\n", "files": ["devtools/server/actors/network-monitor/network-content.js"], "git_node": "7420721f10d725fc9c65ef32a5dd9baa4898c5be", "git_parents": ["c238e4215cd4524fdf0491adee7caeedfb1d9e1e"], "node": "2c5ed23daafc6c3556842ac828b892c6848ee15e", "parents": ["d8f307d6c6746616d6be584ed77c272644cdd956"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2045704: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "49bd6dd07228a34b1aba40816ff314912d6010e0", "git_parents": ["7420721f10d725fc9c65ef32a5dd9baa4898c5be"], "node": "52e58c1268c8fa30a2c90d777acccfedec2faece", "parents": ["2c5ed23daafc6c3556842ac828b892c6848ee15e"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2075700 - Show the Smartbar suggestions above the input after starting a new fullpage chat. r=flozia\n\nStarting a new chat in fullpage mode keeps the chat layout, so the Smartbar stays at the bottom of the window. The suggestions position was only set once, when the Smartbar was created, so the list still opened below the input and was cut off.\n\nThe position is now updated when the chat layout turns on or off, and the Smartbar CSS uses it to keep the input in place when the list opens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330631\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_suggestions.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "28af41dac4ec847145262a48283d72606c72a43a", "git_parents": ["49bd6dd07228a34b1aba40816ff314912d6010e0"], "node": "2e937969060d3f7e43febf5b4751f8804573cc32", "parents": ["52e58c1268c8fa30a2c90d777acccfedec2faece"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077496 - Assert the socket thread in nsHttpConnectionMgr methods that touch the connection table. r=necko-reviewers,valentin\n\nPruneNoTraffic sets mPruningNoTraffic before posting, which is only correct on the socket thread, where its timer fires.  GetConnectionData, GetHttp3ConnectionStatsData, ExcludeHttp2 and ExcludeHttp3 iterate or look up mCT, which is socket thread only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330411\n", "files": ["netwerk/protocol/http/nsHttpConnectionMgr.cpp"], "git_node": "ef53c7fddf4be4f66d86c05657d24b2bc47b391c", "git_parents": ["28af41dac4ec847145262a48283d72606c72a43a"], "node": "fd7a9a5ee645a942499304c40bbd2a90fc299e64", "parents": ["2e937969060d3f7e43febf5b4751f8804573cc32"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077493 - Register the HPACK static table memory reporter after the table is populated. r=necko-reviewers,valentin\n\nThe reporter iterates gStaticHeaders on the main thread without a lock, while InitializeStaticHeaders was still adding entries on the socket thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330408\n", "files": ["netwerk/protocol/http/Http2Compression.cpp"], "git_node": "a2190a0e262245853de9da0e6e0b9456ab3816ef", "git_parents": ["ef53c7fddf4be4f66d86c05657d24b2bc47b391c"], "node": "8cfa82213a6462aaa25a6b849d1449c7c464b416", "parents": ["fd7a9a5ee645a942499304c40bbd2a90fc299e64"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077492 - Don't read Http3Session::mConnInfo off the socket thread in DontReuse. r=necko-reviewers,valentin\n\nDontReuse can be called from other threads and read mConnInfo before dispatching, while RekeyAfterHttp3OnlyHandOff reassigns it on the socket thread.  Keep an atomic copy of the TRR service channel flag for that check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330407\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h"], "git_node": "3eb143fe3ebf2a67d85c3e2b73ef8ff3a6c33267", "git_parents": ["a2190a0e262245853de9da0e6e0b9456ab3816ef"], "node": "ea96895af4ceda3d79715d8c20a507c76b1750c7", "parents": ["8cfa82213a6462aaa25a6b849d1449c7c464b416"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077491 - Fix cross-thread accesses in HttpChannelChild. r=necko-reviewers,kershaw\n\nAssign mAltDataInputStream on the main thread rather than on the socket thread before the OnStartRequest event is queued.  Update mStatus in OnTransportAndData with a compare-exchange so it cannot overwrite a failure status set by Cancel in between the check and the store.  Make mBgInitFailCallbackTriggered atomic, since it is written on the socket thread and read in the destructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330406\n", "files": ["netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelChild.h"], "git_node": "df4d3cfbcf63235e899b98762b786330e1c9bf06", "git_parents": ["3eb143fe3ebf2a67d85c3e2b73ef8ff3a6c33267"], "node": "b2a7c8e9a7eb20b12fd07752e71b9b4ab432c8b3", "parents": ["ea96895af4ceda3d79715d8c20a507c76b1750c7"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077490 - Don't read InterceptedHttpChannel::mProgressSink from the retargeted OnDataAvailable thread. r=necko-reviewers,valentin\n\nSetLoadGroup and SetNotificationCallbacks can clear mProgressSink on the main thread while OnDataAvailable tests it.  Test an atomic flag instead; MaybeCallStatusAndProgress still checks the sink itself on the main thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330405\n", "files": ["netwerk/protocol/http/InterceptedHttpChannel.cpp", "netwerk/protocol/http/InterceptedHttpChannel.h"], "git_node": "622c7984dce8c8b5582832ef6125b863cb0442f8", "git_parents": ["df4d3cfbcf63235e899b98762b786330e1c9bf06"], "node": "95e75e4b19c7b3b5eb3ebe34efbaf876ee5243ab", "parents": ["b2a7c8e9a7eb20b12fd07752e71b9b4ab432c8b3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077489 - Make nsHttpChannel::mLogicalOffset atomic. r=necko-reviewers,kershaw\n\nIt is incremented on the thread OnDataAvailable was retargeted to and read on the main thread by GetEncodedBodySize.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330404\n", "files": ["netwerk/protocol/http/nsHttpChannel.h"], "git_node": "d92741aaa82536b9e9d97f0f011054c2e55d6b18", "git_parents": ["622c7984dce8c8b5582832ef6125b863cb0442f8"], "node": "077eb122e703a18e131c2edd9341ab97600d9cfc", "parents": ["95e75e4b19c7b3b5eb3ebe34efbaf876ee5243ab"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077488 - Fix unsynchronized sharing of response state in nsHttpTransaction. r=necko-reviewers,kershaw\n\nProcessData read mResponseHead without mLock after the data had been written to the pipe, which lets the main thread take the head concurrently.  Read it under the lock.  Make mHaveAllHeaders, mProxyConnectFailed and mSupportsHTTP3 atomic, since they are written on the socket thread and read on the main thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330403\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": "f9e19b871acd2fd780910bc9e9bd311929804456", "git_parents": ["d92741aaa82536b9e9d97f0f011054c2e55d6b18"], "node": "4251f797f9482f38fc3f60b7318e4f9f6a4872c8", "parents": ["077eb122e703a18e131c2edd9341ab97600d9cfc"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077484 - Make pref-derived nsHttpHandler members that are read off the main thread Atomic. r=necko-reviewers,kershaw\n\nPrefsChanged writes these on the main thread while the socket and TRR threads read them.  Use relaxed atomics, as for the members that were already atomic, and a DataMutex for the float ratio.  mEnableAltSvc was a bitfield sharing a word with mDebugObservations, so its writes were a read-modify-write of that word.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330401\n", "files": ["netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h"], "git_node": "9dee33cf5ab51b06ec095465aa02f904c4616f4c", "git_parents": ["f9e19b871acd2fd780910bc9e9bd311929804456"], "node": "09f29d01783e416259bf59266767ce29ac3d0bf3", "parents": ["4251f797f9482f38fc3f60b7318e4f9f6a4872c8"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2073868 - Acquire content provider lock until the clipboard item is set. r=geckoview-reviewers,owlish\n\nBug 2048545 adds a content provider to support custom clipboard data\ntypes. This commits the clipboard item on non-UI thread. And if the\nowner of the clipboard item isn't our content provider, we dispose the\nitem on UI thread by `onPrimaryClipChanged`.\n\nWhen setting clipboard item by our content provider, when the clipboard\nitem is changed by other app, it might dispose our item unexpectedly.\nBecause we don't block this disposer during setting new clipboard item.\n\nSo we should acquire Content provider's lock until the clipboard item is\n set. Since setting clipboard item doesn't support asynchronous\noperation, we cannot dispatch it to UI thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327685\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/Clipboard.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoClipboardContentProvider.java", "widget/android/nsClipboard.cpp"], "git_node": "6612df4eae43648af28a1d80d097dc39d56db79c", "git_parents": ["9dee33cf5ab51b06ec095465aa02f904c4616f4c"], "node": "c3f8310fcc810a9ff725d3743281da7aa7b88a98", "parents": ["09f29d01783e416259bf59266767ce29ac3d0bf3"], "tags": []}, {"author": "Mathew Hodson \u003cmathew.hodson@gmail.com\u003e", "branch": "default", "desc": "Bug 2072456 - Fix unused function warning for `pages_purge` r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326344\n", "files": ["memory/build/Chunk.cpp"], "git_node": "6c6cecfd9b54293a30f6d2ca047777c5ceea20b9", "git_parents": ["6612df4eae43648af28a1d80d097dc39d56db79c"], "node": "8608ac71556fec9654fc1c553e8eecbfdef1f9bf", "parents": ["c3f8310fcc810a9ff725d3743281da7aa7b88a98"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2075705 - Fix uneven spacing in the Smart Window Chat history menu. r=Mardak\n\nThe Chat history list used 16px of space around its rows and dividers, while the \"\u2026\" menu and other Nova panels use 8px. Match chat history with the 8px spacing, so the header, rows and dividers line up.\n\nThe panel corners, title weight, text color and divider color are also updated to match the design.\n\nRow hover now uses the Smart Window hover color. The old rule set a variable that panel rows do not read, so it had no effect.\n\nThe panel shadow is written out with the design values, because ai-window-shared.css turns the shared shadow colors violet for the whole Smart Window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330822\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.css"], "git_node": "9de88c07cf4adff38c7323c4647e022a1c1b36b2", "git_parents": ["6c6cecfd9b54293a30f6d2ca047777c5ceea20b9"], "node": "3611ec154de1720fdebb415b3e6e25721e09bf8e", "parents": ["8608ac71556fec9654fc1c553e8eecbfdef1f9bf"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080772: Prevent remote worker launch after controller termination. r=dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332853\n", "files": ["dom/workers/remoteworkers/RemoteWorkerController.cpp", "dom/workers/remoteworkers/RemoteWorkerManager.cpp"], "git_node": "1714c1df644e18ba101a9b9edfcb78f2d4af9309", "git_parents": ["9de88c07cf4adff38c7323c4647e022a1c1b36b2"], "node": "f57511fd43e1172fb3c205087c020af1130e301f", "parents": ["3611ec154de1720fdebb415b3e6e25721e09bf8e"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060994: Log the text that the macOS Emoji picker inserts, rather than \"(null)\". r=mac-reviewers,mstange\n\nGetCharacters() escapes each UTF-16 code unit on its own, so a character outside the Basic Multilingual Plane ended up in the escaped string as two unpaired surrogates with the escape text between them. XPCOMStringToNSString() cannot convert that, returns nil, and every such character was logged as \"(null)\". Most Emoji are outside that plane, so the logs collected for this bug hid the very text we were following.\n\nKeep a surrogate pair together and log the code point it forms, and leave a lone surrogate out of a string that it cannot be converted in. While here, log which of the two ways of inserting text without a key press is in use, since the two behave differently and the choice is not otherwise visible in a log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319916\n", "files": ["widget/cocoa/TextInputHandler.mm"], "git_node": "0cf9365b42a523ee0ae6914ee5ac33d5c9fa6803", "git_parents": ["1714c1df644e18ba101a9b9edfcb78f2d4af9309"], "node": "a6c3082b06817710ea5be5075fc3e33ac37a152d", "parents": ["f57511fd43e1172fb3c205087c020af1130e301f"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060994: Ignore a resign-key notification for a window which is still the key window on macOS. r=mac-reviewers,bradwerth\n\nOpening a panel such as the Emoji picker gets us NSWindowDidResignKeyNotification without key going anywhere: NSApp still reports the window as its key window, no other window becomes key, and it stays key while the panel is up. We treated that as the window being lowered, so nsFocusManager blurred the content, the content process lost its focused editor, and an emoji arriving in the meantime had no editing host to dispatch \"beforeinput\" at, so it did not appear.\n\nIgnore the notification while the window is still the key window. When key really does move, to another window or to another application, NSApp reports the new window, or nil, by the time we are called. Sheets are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319917\n", "files": ["widget/cocoa/nsWindowMap.mm"], "git_node": "599182662b8c2541cb439235535430e02056948f", "git_parents": ["0cf9365b42a523ee0ae6914ee5ac33d5c9fa6803"], "node": "f413cef2c2b2ad6161c5195a2bdb0b5cfbb717cc", "parents": ["a6c3082b06817710ea5be5075fc3e33ac37a152d"], "tags": []}], "date": 1791884304, "git_changesets": ["c383d0da0483070b65c785638c8d24fb9a37a8c9", "cf6e72f4ba44b2f9198d670c973d224250cae0d6", "0a391bbac7f411b01d22a4eff1bbf0f110c2372a", "880099cab927813ecc4bf7ca1a6a9b4985220137", "3627d7bd06d41db35ceced72b54b7b416100476b", "c238e4215cd4524fdf0491adee7caeedfb1d9e1e", "7420721f10d725fc9c65ef32a5dd9baa4898c5be", "49bd6dd07228a34b1aba40816ff314912d6010e0", "28af41dac4ec847145262a48283d72606c72a43a", "ef53c7fddf4be4f66d86c05657d24b2bc47b391c", "a2190a0e262245853de9da0e6e0b9456ab3816ef", "3eb143fe3ebf2a67d85c3e2b73ef8ff3a6c33267", "df4d3cfbcf63235e899b98762b786330e1c9bf06", "622c7984dce8c8b5582832ef6125b863cb0442f8", "d92741aaa82536b9e9d97f0f011054c2e55d6b18", "f9e19b871acd2fd780910bc9e9bd311929804456", "9dee33cf5ab51b06ec095465aa02f904c4616f4c", "6612df4eae43648af28a1d80d097dc39d56db79c", "6c6cecfd9b54293a30f6d2ca047777c5ceea20b9", "9de88c07cf4adff38c7323c4647e022a1c1b36b2", "1714c1df644e18ba101a9b9edfcb78f2d4af9309", "0cf9365b42a523ee0ae6914ee5ac33d5c9fa6803", "599182662b8c2541cb439235535430e02056948f"], "user": "sstanca@mozilla.com"}, "45548": {"changesets": [{"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060994: Ignore a resign-key notification for a window which is still the key window on macOS. r=mac-reviewers,bradwerth\" for causing wpt failures.\n\nThis reverts commit 599182662b8c2541cb439235535430e02056948f.\n\nThis reverts commit 0cf9365b42a523ee0ae6914ee5ac33d5c9fa6803.\n", "files": ["widget/cocoa/TextInputHandler.mm", "widget/cocoa/nsWindowMap.mm"], "git_node": "64cfaf34e56f4c82eea77d032ec592c083b5b161", "git_parents": ["599182662b8c2541cb439235535430e02056948f"], "node": "d250b3077d8dc23d9b64d03deaaeaf71c9bd09b5", "parents": ["f413cef2c2b2ad6161c5195a2bdb0b5cfbb717cc"], "tags": []}], "date": 1791884564, "git_changesets": ["64cfaf34e56f4c82eea77d032ec592c083b5b161"], "user": "sstanca@mozilla.com"}, "45549": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eb9a6e3a736802c8e080a76c44dc81f409d99d54 with FIREFOX_158_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ed3c342bf463f471bb31108e664a64e425c284cd", "git_parents": ["b6c8aca3a9e8ca4abb55a6f016e17417d43bd53b"], "node": "95216f553d31699c67e93d4069300b1f3ea1c756", "parents": ["f9d3bee3f71c847be0402dbb2b3e6a8ed99856c1"], "tags": []}], "date": 1791895241, "git_changesets": ["ed3c342bf463f471bb31108e664a64e425c284cd"], "user": "ffxbld@lando.moz.tools"}, "45550": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging dedb41ddf85d96319e7d6d5f45dd5a61986163b3 with FIREFOX_115_43_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "27a9b4d7a21a17f6a9b01e58a1710464eafa88bc", "git_parents": ["ed3c342bf463f471bb31108e664a64e425c284cd"], "node": "1fa780c46964db224fc2fb964b74ff7fde6d5507", "parents": ["95216f553d31699c67e93d4069300b1f3ea1c756"], "tags": []}], "date": 1791895451, "git_changesets": ["27a9b4d7a21a17f6a9b01e58a1710464eafa88bc"], "user": "ffxbld@lando.moz.tools"}, "45551": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fd5558cd1123da4b6a35348a386ac8319bb3a144 with FIREFOX_153_5_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "edc00968cc98b41b48c66bb3b00331fcc0213957", "git_parents": ["27a9b4d7a21a17f6a9b01e58a1710464eafa88bc"], "node": "efc7aa16e0a4b9b8bf41b78454c2d3dd0d09aaa5", "parents": ["1fa780c46964db224fc2fb964b74ff7fde6d5507"], "tags": []}], "date": 1791895610, "git_changesets": ["edc00968cc98b41b48c66bb3b00331fcc0213957"], "user": "ffxbld@lando.moz.tools"}, "45552": {"changesets": [{"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2081023 - Use emplaceBack instead of appending a temporary in js/. r=jandem\n\nConvert the append(T(args)) and infallibleAppend(T(args)) calls reported\nby the alpha mozilla-use-emplace check (bug 2081013) to emplaceBack(args)\nand infallibleEmplaceBack(args), which construct the element in place.\n\nFor trivially copyable element types this generates the same work. Where\nthe element has a non-trivial destructor, the temporary, its move and its\ndestruction go away. For example Debugger::addDebuggeeGlobal no longer\nruns the HeapPtr and WeakHeapPtr barriers of a stack temporary\nRealm::DebuggerVectorEntry.\n\nLeave the two appends in UbiNode.cpp alone: Edge takes ownership of a raw\nname buffer, and if the vector failed to grow, emplaceBack would never\nconstruct the Edge, leaking the buffer instead of freeing it in the\ntemporary's destructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333077\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/debugger/Debugger.cpp", "js/src/frontend/TokenStream.cpp", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIRWriter.h", "js/src/jit/IonAnalysis.cpp", "js/src/jit/LIR.cpp", "js/src/jit/LIR.h", "js/src/jit/UnrollLoops.cpp", "js/src/jit/WarpOracle.cpp", "js/src/jit/arm64/Assembler-arm64.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/vm/ConcurrentDelazification.cpp", "js/src/vm/GeckoProfiler.cpp", "js/src/vm/JSONParser.cpp", "js/src/wasm/WasmBuiltinModule.cpp", "js/src/wasm/WasmGenerator.cpp", "js/src/wasm/WasmIonCompile.cpp", "js/src/wasm/WasmOpIter.h", "js/src/wasm/WasmPI.cpp", "js/src/wasm/WasmStaticTypeDefs.cpp", "js/src/wasm/WasmValidate.cpp"], "git_node": "1e1a2f8b9010c16ed6b0be1a41e86cd96e921c39", "git_parents": ["599182662b8c2541cb439235535430e02056948f"], "node": "e74380cf1e8410895ebd82f4ea249e56582fe528", "parents": ["f413cef2c2b2ad6161c5195a2bdb0b5cfbb717cc"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1989690 - Wait for a layout viewport resize event in hitTestOnPositionStickyOnMainThread. r=botond,geckoview-reviewers,owlish\n\npromiseAllPaintsDone() alone can finish before the new dynamic toolbar offset has\nbeen reflected on the main-thread, so wait for the layout viewport resize event\nfirst and paint after it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329512\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/DynamicToolbarTest.kt"], "git_node": "49df93eabe60a85a0ffbd273dcaf983b063cf54d", "git_parents": ["1e1a2f8b9010c16ed6b0be1a41e86cd96e921c39"], "node": "5100976be21acd15f93b8877a7762c62ec72503e", "parents": ["e74380cf1e8410895ebd82f4ea249e56582fe528"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1989690 - Position the sticky element in the middle of the scroll container to workaround bug 2076041. r=botond,geckoview-reviewers,owlish\n\nHiding the dynamic toolbar enlarges the visual viewport and so reduces the maximum visual viewport offset. When the page is scrolled to the bottom, KeepLayoutViewportEnclosingVisualViewport clamps the layout viewport offset in APZ without sending a repaint request, so the main thread can observe a negative visualViewport.offsetTop. Avoid scrolling to the bottom of the page until bug 2076041 is fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329513\n", "files": ["mobile/android/geckoview/src/androidTest/assets/www/position-sticky-on-main-thread.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/DynamicToolbarTest.kt"], "git_node": "14f86feb26d37618443bd91301625c73cb1b211a", "git_parents": ["49df93eabe60a85a0ffbd273dcaf983b063cf54d"], "node": "653cb710678856c3843ec5d0e06b22cd28805059", "parents": ["5100976be21acd15f93b8877a7762c62ec72503e"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2080598 - Use the stub field values as immediates in GuardObjectFuseProperty for Ion ICs. r=jandem\n\nIon IC stubs bake their stub fields into the code, but\nemitGuardObjectFuseProperty still moved the expected generation, the\nproperty index and the property mask into a register before using them. On\narm64 a typical guard looked like:\n\n  mov  w1, #0\n  ldr  w16, [x0, #0x10]\n  cmp  w16, w1\n  b.ne fail\n  mov  w1, #0\n  ldr  x0, [x0]\n  ldr  w0, [x0, x1, lsl #2]\n  mov  w1, #0x2\n  tst  w0, w1\n  b.ne fail\n\nWhen the stub field policy is Constant, compare and test against\nimmediates and fold the index into the load offset instead.\n\nOn a JetStream 3 run on arm64 this applies to about 2,500 guards in Ion IC\nstubs, removing up to three instructions from each.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332738\n", "files": ["js/src/jit/CacheIRCompiler.cpp"], "git_node": "e873629d66ca78cc67256f3a52246451e2b8f674", "git_parents": ["14f86feb26d37618443bd91301625c73cb1b211a"], "node": "037bf266f6dcb909260b2724b1f884ac7239982b", "parents": ["653cb710678856c3843ec5d0e06b22cd28805059"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2080778 - [riscv64] Use canonical lui+addiw sequence for loading Imm32. r=jandem\n\nAddi does not sign-extend the lower 32 bits, which could lead to wrong\nsext results in the higher bits of the dest register.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333102\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "e53642ae3c3b9ae0198898559b027f3b3fe96aa3", "git_parents": ["e873629d66ca78cc67256f3a52246451e2b8f674"], "node": "1c2f2df9ba17824d02d0a52aaba44fdc4b066e30", "parents": ["037bf266f6dcb909260b2724b1f884ac7239982b"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\naf -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nan -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nar -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nast -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\naz -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbe -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbg -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbn -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbo -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbqi -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbr -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbrx -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nbs -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nca -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nca-valencia -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\ncak -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nckb -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\ncs -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\ncy -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nda -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\nde -\u003e bfcb066f2b92cb2ad4d0bfd639846d32dcab5211\ndsb -\u003e bfcb0