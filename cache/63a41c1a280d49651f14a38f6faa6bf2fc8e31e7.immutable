a754c8c288553bbb4b796c508ad865", "f5fc73cfd2337774e30e0b07eab038dc18fc729f", "60da826357fb884de63a9fe72414508e9bc430f0", "e66e99bbf29a442001ca70239ecf9c2cd737edc9", "c29e018cb956841f6ebba88723c63662efc314ad", "10e8f876281b4935f8e1a6c886981dbaf66fb6f6", "a8ef5d9dd6dd2b9505ceee139082d3107b466b74", "c4044389e238759a9d6d64eff2e58f8e08801a2d", "18956eddf365417e41a2aaddaf0a048e8ebfc2b2", "45be4af261d61e1dc0fe5cce3172aa23db79761d", "e00a7636053d44c48b523c20b24fde9d3548062a"], "user": "smolnar@mozilla.com"}, "45533": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic newtab version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/extensions/newtab/manifest.json"], "git_node": "dc44717dc670c05f3c6808a8a31750a31df876a0", "git_parents": ["e00a7636053d44c48b523c20b24fde9d3548062a"], "node": "9df568b2e0fd6d91b7d40457b373eff6942bc31f", "parents": ["897a2622d4c7bdee9bb07969a47e5143996c8980"], "tags": []}], "date": 1791670896, "git_changesets": ["dc44717dc670c05f3c6808a8a31750a31df876a0"], "user": "ffxbld@lando.moz.tools"}, "45534": {"changesets": [{"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078502 [wpt PR 63289] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326186, a=testonly\n\nAutomatic update from web-platform-tests\nshape-margin above 65535px on an image shape-outside produces a much smaller float area (#63289)\n\nMarginIntervalGenerator computed radius * radius as unsigned, which\noverflows when the shape-margin is above 65535px. For a radius of\n65536px the square wraps to 0, so the margin on each row of the\nshape itself became 0. Larger radii wrapped to other small values.\nA float with a huge shape-margin then had a float area far smaller\nthan its margin box, and text wrapped into the space the margin\nshould have covered.\n\nThis patch does the squaring in 64 bits.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326186\nWebKit-Canonical-Link: https://commits.webkit.org/322727@main\n--\n\nwpt-commits: 674daa9997ee85b54cd5c87182a751136c543b37\nwpt-pr: 63289\n", "files": ["testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/shape-image-030.html"], "git_node": "9e9ab19766c3805651543ce245e924a91971ae89", "git_parents": ["e00a7636053d44c48b523c20b24fde9d3548062a"], "node": "1e859660cfbf97660b3076943d74a010c4525a38", "parents": ["897a2622d4c7bdee9bb07969a47e5143996c8980"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078502 [wpt PR 63289] - Update wpt metadata, a=testonly\n\nwpt-pr: 63289\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-shapes/shape-outside/shape-image/shape-image-030.html.ini"], "git_node": "242cd5784721dbdaafebfdacb33b325f4521e32b", "git_parents": ["9e9ab19766c3805651543ce245e924a91971ae89"], "node": "142deea0d16e872b1df59e4dbb06e2b7aa981678", "parents": ["1e859660cfbf97660b3076943d74a010c4525a38"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2078617 [wpt PR 62881] - Add size attribute to select element, a=testonly\n\nAutomatic update from web-platform-tests\nAdd size attribute to select element (#62881)\n\nThe current test assumes that a collapsed select element has an accessible subtree of all its options. While this is true currently for most browsers, there is no reason for that accessible subtree to exist when the select is not expanded. Adding `size` changes the select to a listbox with rendered options.\n--\n\nwpt-commits: 756a82174877a5fa136459bbaacee00fff9797f6\nwpt-pr: 62881\n", "files": ["testing/web-platform/tests/accname/name/comp_label.html"], "git_node": "df5f1afddbe66c6d9d5036920243b37675c3041d", "git_parents": ["242cd5784721dbdaafebfdacb33b325f4521e32b"], "node": "1a4d852f1b8f018c80427176f4f023e854b593cf", "parents": ["142deea0d16e872b1df59e4dbb06e2b7aa981678"], "tags": []}, {"author": "G\u00e9rald Barr\u00e9 \u003cmeziantou@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078463 [wpt PR 63283] - Fix casing of webkitBackgroundClip in compat/css-style-declaration-alias-enumeration.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix casing of webkitBackgroundClip in compat alias enumeration test (#63283)\n\nThe test checked for 'WebKitBackgroundClip' (capital K), which is not an\nIDL attribute name CSSOM defines for -webkit-background-clip. The valid\nnames are webkitBackgroundClip (webkit-cased attribute),\nWebkitBackgroundClip (camel-cased attribute) and -webkit-background-clip\n(dashed attribute). The commit that added this entry (#34520) intended\nto add webkitBackgroundClip, per its commit message.\n\nUse 'webkitBackgroundClip', consistent with every other entry in the list.\n--\n\nwpt-commits: 8164bb36c9f435e18452f3698f3afa3928130613\nwpt-pr: 63283\n", "files": ["testing/web-platform/tests/compat/css-style-declaration-alias-enumeration.html"], "git_node": "8c0d12ab37b8a649236d2ed52c9b9ad2d4ee1e75", "git_parents": ["df5f1afddbe66c6d9d5036920243b37675c3041d"], "node": "bd93136027a67d4f0d6a73c225592a7adb74d585", "parents": ["1a4d852f1b8f018c80427176f4f023e854b593cf"], "tags": []}, {"author": "Viktoria Zlatinova \u003cvizlatin@microsoft.com\u003e", "branch": "default", "desc": "Bug 2078116 [wpt PR 63265] - Add WPT for prerender-until-script to prerender upgrade, a=testonly\n\nAutomatic update from web-platform-tests\nAdd WPT for prerender-until-script to prerender upgrade\n\nAdds a Web Platform Test for the prerender-until-script host upgrading\nto a full prerender host when a matching prerender speculation rule is\nadded for the same URL. The upgrade unpauses the previously paused\ninline JavaScript on the prerendered page, which the test verifies via\ndocument.prerendering.\n\nFlow:\n  1. Initiator adds a `prerender_until_script` rule; the\n     prerender-until-script host starts loading with inline JS paused.\n  2. The prerendered page's async \u003cscript src\u003e tag fetches the\n     \"pus-loaded\" signal (this fetch fires even with JS paused),\n     which releases the initiator's hanging long-poll fetch.\n  3. The initiator then adds a regular `prerender` rule for the same\n     URL, triggering the upgrade.\n  4. The previously paused inline \u003cscript\u003e finally runs, captures\n     `document.prerendering`, and posts it back via PrerenderChannel.\n  5. The initiator activates the prerender and the test asserts the\n     captured value was `true`, proving the script ran during\n     prerendering rather than after activation.\n\nWithout the upgrade (feature disabled), the inline JS never runs and\nthe test fails at a 30 s `t.step_timeout` with a diagnostic pointing\nat the missing upgrade rather than a bare harness timeout.\n\nA new `prerender-until-script-upgrade` virtual test suite enables\n`PrerenderUntilScriptUpgrade` (browser-side, off by default) for\nthis test; `exclusive_tests: \"ALL\"` skips the bare non-virtual run\nso the test only executes with the flag on.\n\nThe wptserve signal handler's long-poll loop is bounded at 60 s\n(returning 504 on timeout). This is intentionally longer than the\ntest's own 30 s `t.step_timeout`, so the test's semantic diagnostic\nremains the visible failure reason on a regression; the bound exists\nto unblock the initiator's fetch so its `reportFailure` path can\nclose the popup cleanly rather than leaking a wptserve worker thread.\n\nBug: 504686720\nChange-Id: I29d7dbed53d10b3c6164c398a502adb4f3fe2525\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7900337\nReviewed-by: Lingqi Chi \u003clingqi@chromium.org\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: Viktoria Zlatinova \u003cvizlatin@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711404}\n\n--\n\nwpt-commits: c7c268d928833daa1b7b7196a0f885b74348342e\nwpt-pr: 63265\n", "files": ["testing/web-platform/tests/speculation-rules/prerender-until-script/pus-to-prerender-upgrade.https.html", "testing/web-platform/tests/speculation-rules/prerender-until-script/resources/pus-upgrade-handler.py", "testing/web-platform/tests/speculation-rules/prerender-until-script/resources/pus-upgrade-initiator-template.html", "testing/web-platform/tests/speculation-rules/prerender-until-script/resources/pus-upgrade-page-template.html"], "git_node": "993817a3657a13973ec8b0774f1412e5d71882c7", "git_parents": ["8c0d12ab37b8a649236d2ed52c9b9ad2d4ee1e75"], "node": "06436a66ff6fcb14795b1a8a921af74e4ce6fa76", "parents": ["bd93136027a67d4f0d6a73c225592a7adb74d585"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078116 [wpt PR 63265] - Update wpt metadata, a=testonly\n\nwpt-pr: 63265\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/speculation-rules/prerender-until-script/pus-to-prerender-upgrade.https.html.ini"], "git_node": "d78799f15afc5323fea9642d717854de302fea59", "git_parents": ["993817a3657a13973ec8b0774f1412e5d71882c7"], "node": "4d49d70e1e5ac576b756f5962ec0bc80f7a38e57", "parents": ["06436a66ff6fcb14795b1a8a921af74e4ce6fa76"], "tags": []}, {"author": "Daniil Sakhapov \u003csakhapov@google.com\u003e", "branch": "default", "desc": "Bug 2078504 [wpt PR 63290] - Pin the activated ::column::scroll-marker as selected, a=testonly\n\nAutomatic update from web-platform-tests\nPin the activated ::column::scroll-marker as selected\n\nSince crbug.com/529411428 the pin state of a ::scroll-marker-group is\nupdated from the scroll-into-view bubbling loop\n(PerformBubblingScrollIntoViewWithResult()), which infers the targeted\nscroll marker from the node of the box being scrolled.\n\nFor a ::column::scroll-marker activation that box is the scroll\ncontainer itself (see Element::ScrollIntoViewNoVisualUpdate()), so\nFindScrollMarkerForTargetedScroll() started its backwards layout-order\nsearch *outside* the scroller. With `scroll-marker-group: before` the\n::scroll-marker-group box is laid out right before the scroller, so the\nsearch walked into it, picked up its last ::scroll-marker and pinned\nthat one instead of the activated marker. With `scroll-marker-group:\nafter` nothing was found, so the activated marker was selected but not\npinned anymore.\n\nFix this on two levels:\n\n ScrollMarkerGroupPseudoElement::ActivateScrollMarker() now pins the\n   activated marker itself (passing along apply_snap_alignment) instead\n   of relying on the scroll-into-view machinery to infer it. Activation\n   is by definition a targeted scroll to that marker's target.\n FindScrollMarkerForTargetedScroll() bails out when the target is the\n   scroll container owning the group. There is no scroll target inside\n   the scroller to map to a marker in that case, and the backwards walk\n   would otherwise leave the scroller and potentially end up in the\n   ::scroll-marker-group box.\n\nBug: 566965154\nChange-Id: Ia3da8c1708fe927dc5120ae25fa9db070f2d2302\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8498493\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nAuto-Submit: Daniil Sakhapov \u003csakhapov@google.com\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711426}\n\n--\n\nwpt-commits: 5a6e9d92bc9ee9ede2fecb3853968f824e94ca1f\nwpt-pr: 63290\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/column-scroll-marker-activation-target-current-ref.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/column-scroll-marker-activation-target-current.html"], "git_node": "4bb3ebd21d173202723bcc11cac9a4a4270c1166", "git_parents": ["d78799f15afc5323fea9642d717854de302fea59"], "node": "5c8cd010b55b138620714cba5fd16e83b86f45f1", "parents": ["4d49d70e1e5ac576b756f5962ec0bc80f7a38e57"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078504 [wpt PR 63290] - Update wpt metadata, a=testonly\n\nwpt-pr: 63290\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/chrome-421199213-crash.html.ini", "testing/web-platform/meta/css/css-overflow/scroll-markers/column-scroll-marker-activation-target-current.html.ini"], "git_node": "f0719ae7e6b93c79a61a07837c6f18490a4dae54", "git_parents": ["4bb3ebd21d173202723bcc11cac9a4a4270c1166"], "node": "88c486c45399f8feb1d156f782c0c350a0ee2b89", "parents": ["5c8cd010b55b138620714cba5fd16e83b86f45f1"], "tags": []}, {"author": "Kristin Lee \u003ckristinlee@microsoft.com\u003e", "branch": "default", "desc": "Bug 2078373 [wpt PR 63279] - [\u003cinstall\u003e Element] Make manifest and manifestid attributes non-nullable, a=testonly\n\nAutomatic update from web-platform-tests\n[\u003cinstall\u003e Element] Make manifest and manifestid attributes non-nullable\n\nMake HTMLInstallElement.manifest and manifestId non-nullable\nUSVString attributes, matching other reflected URL attributes.\n\nMissing content attributes now return empty strings, and assigning\nnull stringifies it instead of removing the corresponding attribute.\nUpdate WPT coverage for both attributes and their null assignment\nbehavior.\n\nThis follows existing HTML reflected URL attributes that are\nnon-nullable and expose a missing attribute as an empty string.\n\nBug: 568010593, 333795265\nChange-Id: I2cbf503f4c31ab890e901122898f7387fd8061dc\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8503822\nReviewed-by: Lu Huang \u003cluhua@microsoft.com\u003e\nReviewed-by: Philip J\u00e4genstedt \u003cfoolip@chromium.org\u003e\nReviewed-by: Lia Hiscock \u003cliahiscock@microsoft.com\u003e\nCommit-Queue: Kristin Lee \u003ckristinlee@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711439}\n\n--\n\nwpt-commits: 11beac6223928d41819162305c1954fe0e170bb4\nwpt-pr: 63279\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/install/install-element-url-attributes.tentative.html"], "git_node": "c0b08429d69d3475df9ec002df957ba916b3026e", "git_parents": ["f0719ae7e6b93c79a61a07837c6f18490a4dae54"], "node": "7951cd6e4c82515a47e0965cd3874a9df929ecc1", "parents": ["88c486c45399f8feb1d156f782c0c350a0ee2b89"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078373 [wpt PR 63279] - Update wpt metadata, a=testonly\n\nwpt-pr: 63279\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/install/install-element-url-attributes.tentative.html.ini"], "git_node": "b4c57a3c1e5fe2c25b5988a2597bf62faa66f46c", "git_parents": ["c0b08429d69d3475df9ec002df957ba916b3026e"], "node": "ea01622b9af2278824207080315892a6cae07f29", "parents": ["7951cd6e4c82515a47e0965cd3874a9df929ecc1"], "tags": []}, {"author": "John Jansen \u003cjohnjansen@microsoft.com\u003e", "branch": "default", "desc": "Bug 2076221 [wpt PR 63018] - [Masonry] Fix incorrect ref for grid-lanes-order-001 test, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Fix incorrect ref for grid-lanes-order-001 test\n\nThe reference file used a translateX offset to position item 5, but\nthe pixel value was slightly off, shifting the box by a few pixels\nrelative to the actual expected layout. This caused the test to fail on\nWindows in both Chrome and Edge, even though grid-lanes itself was not\nbroken. Replace the translateX hack with position: relative and a\nleft offset expressed in terms of the item's own percentage width,\nwhich matches the intended layout exactly and removes the\nplatform-dependent rounding error.\n\nBug: b:564353369\nTest: Ran the test in Chrome and Edge on Windows and Linux\nChange-Id: I464245444a3e0527871423df731b1dd8d7fc8d31\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8467894\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nReviewed-by: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nCommit-Queue: John Jansen \u003cjohnjansen@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711440}\n\n--\n\nwpt-commits: f8ae4a86e687cda85ab1a700f1cd8278ba9bfb44\nwpt-pr: 63018\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/order/grid-lanes-order-001-ref.html"], "git_node": "98f91ef52dff70b6a19d7f35a3485517899c9db7", "git_parents": ["b4c57a3c1e5fe2c25b5988a2597bf62faa66f46c"], "node": "a60aa32da148d73982c886948cb13fd7a3addabe", "parents": ["ea01622b9af2278824207080315892a6cae07f29"], "tags": []}, {"author": "mark a. foltz \u003cmfoltz@chromium.org\u003e", "branch": "default", "desc": "Bug 2078121 [wpt PR 63266] - [webmcp] Add WebMCP and ScriptTool executeTool() cancellation tests, a=testonly\n\nAutomatic update from web-platform-tests\n[webmcp] Add WebMCP and ScriptTool executeTool() cancellation tests\n\nAdds Web Platform Tests and Actor ScriptTool browser tests covering\ncancellation and early-abort scenarios during executeTool():\n- Imperative tool self-cancellation (sync and async caller signal abort)\n- Synchronous tool unregistration inside execute() followed by caller abort\n- Caller frame navigation and DOM detachment (toolcancel event verification)\n- Cross-origin and third-frame AbortController cancellation\n- Revoking exposedTo permission after getTools() and before executeTool()\n- Re-entrant (nested) executeTool() cancellation, target detachment, and\n  unregistration\n- Pre-submission declarative tool unregistration (DOM removal, attribute\n  removal, and target frame detachment) with -expected.txt for missing\n  toolcancel event\n- Actor ExecutionEngine::CancelOngoingActions() during imperative,\n  declarative, and re-entrant ScriptTool executions\n\nBug: 513147880, 565332588\nChange-Id: I4116141e836306d6775cde17f1ca85925ac006d9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8454102\nCommit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\nReviewed-by: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711461}\n\n--\n\nwpt-commits: 54b3dc579789163e868117bc957235999b348953\nwpt-pr: 63266\n", "files": ["testing/web-platform/tests/webmcp/declarative/unregister-during-executeTool.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-abort.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-caller-navigate-abort.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-reentrant-cancellation.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-signal-cross-origin.https.html", "testing/web-platform/tests/webmcp/imperative/permissions-policy.https.html", "testing/web-platform/tests/webmcp/imperative/resources/helpers.js", "testing/web-platform/tests/webmcp/imperative/resources/iframe-register-tool.html", "testing/web-platform/tests/webmcp/imperative/unregister-during-executeTool.https.html"], "git_node": "c9dcd3d61990b29c3f5eba07e498e30f61366706", "git_parents": ["98f91ef52dff70b6a19d7f35a3485517899c9db7"], "node": "0ae384d2e238a34d0c56ab85140f058d6a77e486", "parents": ["a60aa32da148d73982c886948cb13fd7a3addabe"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078121 [wpt PR 63266] - Update wpt metadata, a=testonly\n\nwpt-pr: 63266\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/declarative/unregister-during-executeTool.https.html.ini", "testing/web-platform/meta/webmcp/imperative/executeTool-abort.https.html.ini", "testing/web-platform/meta/webmcp/imperative/executeTool-caller-navigate-abort.https.html.ini", "testing/web-platform/meta/webmcp/imperative/executeTool-reentrant-cancellation.https.html.ini", "testing/web-platform/meta/webmcp/imperative/executeTool-signal-cross-origin.https.html.ini", "testing/web-platform/meta/webmcp/imperative/unregister-during-executeTool.https.html.ini"], "git_node": "13cf1f31f048a2d29e1e13728a67be0eeecab10d", "git_parents": ["c9dcd3d61990b29c3f5eba07e498e30f61366706"], "node": "9f962741ac21304845c1e016a54f9436f96287be", "parents": ["0ae384d2e238a34d0c56ab85140f058d6a77e486"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078506 [wpt PR 63291] - [html-in-canvas] Require drawable attribute for direct children, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Require drawable attribute for direct children\n\nThis patch removes a special-case where direct children of canvas were\ndrawable without the drawable attribute. With this patch, the drawable\nattribute is required.\n\nMajor changes:\n* Requires the `drawable` attribute in `Element::CanvasForDrawing()`\n  and uses it in `HTMLCanvasElement` and `CanvasRenderingContext`.\n* Added/updated comments for `IsInCanvasSubtree` and related functions,\n  as the special-cases are extremely nuanced (e.g., top-layer,\n  non-drawable subtrees).\n* Before this change it was not possible for an object to be in a\n  non-drawable subtree, since direct canvas children were drawable.\n  With this change, `PaintLayerPainter::Paint` needed updates to only\n  paint descendants in drawable subtrees.\n  `FragmentPaintPropertyTreeBuilder` also needed updates to ensure\n  effect nodes report the correct `IsInDrawableCanvasSubtree` value for\n  non-drawable subtrees, reparent nested drawable effects past\n  non-drawable ancestors, and reset paint offsets at drawable objects.\n* Added `Element::RequestCanvasPaintOnDrawableRemoved` which is\n  called from `Element::AttributeChanged` and\n  `LayoutObject::WillBeDestroyed` and which is a more general solution\n  for the removed logic in `HTMLCanvasElement::ChildElementRemoved`.\n* Enabled scripting in many unit tests which is required by\n  `HTMLCanvasElement::CreateLayoutObject`.\n\nBug: 565840014\nChange-Id: I915fd576f3aaa58e592953eb3b9b9dccc70af9b5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8496086\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711484}\n\n--\n\nwpt-commits: 1990905826e8968cfc867b4dd7fd2e605b887728\nwpt-pr: 63291\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/containment.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/error-conditions.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/moved-webgl-canvas.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-canvas-not-rendered.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-canvas-scale.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-content-drawable-canvas.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-drawable-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-drawable.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/onpaint-remove-drawable-element.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-linear-gradient-href-outside-subtree-ignored.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-pattern-href-outside-subtree-ignored.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-radial-gradient-href-outside-subtree-ignored.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-use-chained-outside-subtree-images-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-svg-use-chained-outside-subtree-ignored.tentative.html"], "git_node": "d281669a168bd5afa7252cd74cea70c2f0adf692", "git_parents": ["13cf1f31f048a2d29e1e13728a67be0eeecab10d"], "node": "c7b8685e3d0ed16f0b260b8b0847c07a428762c0", "parents": ["9f962741ac21304845c1e016a54f9436f96287be"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078506 [wpt PR 63291] - Update wpt metadata, a=testonly\n\nwpt-pr: 63291\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/onpaint-remove-drawable-element.tentative.html.ini"], "git_node": "fc35a16c3aa4f0bae87cd26a936d658e2875672e", "git_parents": ["d281669a168bd5afa7252cd74cea70c2f0adf692"], "node": "63e51d41397b780627255f6cfe3d42beb75807d4", "parents": ["c7b8685e3d0ed16f0b260b8b0847c07a428762c0"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2078500 [wpt PR 63288] - Prevent scrollbars in css/css-break/transforms-015.html, a=testonly\n\nAutomatic update from web-platform-tests\nPrevent scrollbars in css/css-break/transforms-015.html\n\nThis test relied on a bug in the current out-of-flow fragmentation\nengine in Blink, where scrollable overflow isn't always propagated.\nThis bug is one of the main reasons for the ongoing FragmentedOofInCb\nrewrite, as a matter of fact.\n\nCorrect the test. Note that a scrollbar also appeared in Firefox, but\nmay not have affected the test result, if overlay scrollbars are used by\ndefault in reftests (unlike Chrome).\n\nBug: 40267498\nChange-Id: If551ddc44cec49388a0978abd9dd1b42d01c2e2e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8515378\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711497}\n\n--\n\nwpt-commits: d3f25fd7c4a26159b3c4c3f72bf637ca3062dff2\nwpt-pr: 63288\n", "files": ["testing/web-platform/tests/css/css-break/transform-015.html"], "git_node": "0e31ad0cc4a0ed4782b6b9602ec9451d7894cfb8", "git_parents": ["fc35a16c3aa4f0bae87cd26a936d658e2875672e"], "node": "23261c874956978e3ea69a879a11aa6c1a3a4334", "parents": ["63e51d41397b780627255f6cfe3d42beb75807d4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078500 [wpt PR 63288] - Update wpt metadata, a=testonly\n\nwpt-pr: 63288\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/area-crash.html.ini", "testing/web-platform/meta/css/css-break/area-in-inline-crash.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-item-oof-crash.html.ini", "testing/web-platform/meta/css/css-break/transform-015.html.ini"], "git_node": "a1708415f18bd8e7f683f0705eb5870e8fa52c7a", "git_parents": ["0e31ad0cc4a0ed4782b6b9602ec9451d7894cfb8"], "node": "a246ba884a157ce1b2cc16b819c26114d5bc62c4", "parents": ["23261c874956978e3ea69a879a11aa6c1a3a4334"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2078475 [wpt PR 63286] - Fix transparent text visibility in macOS selections, a=testonly\n\nAutomatic update from web-platform-tests\nFix transparent text visibility in macOS selections\n\nUse the default selection foreground color on macOS so transparent text\nremains visible when selected.\n\nBug: 41228297\nChange-Id: I0f9fdf1244518537bac7e7e6738be972b2dd0d68\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8456516\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711511}\n\n--\n\nwpt-commits: cc74d2669f5de548e808779877d1d33339ec5115\nwpt-pr: 63286\n", "files": ["testing/web-platform/tests/css/css-pseudo/selection-transparent-text-author-background-ref.html", "testing/web-platform/tests/css/css-pseudo/selection-transparent-text-author-background.html", "testing/web-platform/tests/css/css-pseudo/selection-transparent-text-invisible-ref.html", "testing/web-platform/tests/css/css-pseudo/selection-transparent-text-ua-background.html"], "git_node": "a96f696ae965b222b366c9fb9781518a9818d770", "git_parents": ["a1708415f18bd8e7f683f0705eb5870e8fa52c7a"], "node": "c3a92c19d49f178e56a63f75c72f0e169197e9b5", "parents": ["a246ba884a157ce1b2cc16b819c26114d5bc62c4"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2078218 [wpt PR 63274] - [svg] Style reuse (1/3): Record incremental style update blockers, a=testonly\n\nAutomatic update from web-platform-tests\n[svg] Style reuse (1/3): Record incremental style update blockers\n\nMISU (More Incremental Style Updates) allows for incremental style\nupdates to avoid a full cascade rebuild when the inline style attribute\nchanges (since that has a higher priority than other CSS rules). This\nset of 3 changes (https://crrev.com/c/8142587 and\nhttps://crrev.com/c/8421915) expands this concept to apply to SVG\npresentation attributes.\n\nThis initial change adds a runtime flag (SvgIncrementalStyle) enabled\nfor \"test\", prepares SVG style reuse by recording cascade losses and\nstyle adjustments that make incremental updates unsafe. It also adds\ncache metadata to distinguish SVG presentation hints from HTML hints and\nconsolidates naming. Incremental style comments are updated along with\nunit tests to validate the behavior.\n\nBug: 372750818\nChange-Id: I5f6ceeef4bd813e56dc3284403667e4c9c8dabb4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8388256\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711639}\n\n--\n\nwpt-commits: 75409f019c3a56c5ee4711bd6da8814192dbc7ec\nwpt-pr: 63274\n", "files": ["testing/web-platform/tests/svg/styling/invalidation/attribute-style-invalidation.html"], "git_node": "4abd301d0c6d7d89e6b4316084bc5fafe95a1751", "git_parents": ["a96f696ae965b222b366c9fb9781518a9818d770"], "node": "9d33c1ff227c21d285e10063e3162b1015de4c2e", "parents": ["c3a92c19d49f178e56a63f75c72f0e169197e9b5"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2078675 [wpt PR 63296] - [flex] Only set reading flow nodes on first fragment, a=testonly\n\nAutomatic update from web-platform-tests\n[flex] Only set reading flow nodes on first fragment\n\nBecause all reading flow nodes are set while the first fragment is\nprocessed, in future fragments that are inheriting from break-tokens, we\ncan skip over the processing of adding read flow nodes.\n\nThis fixes a crash that was occurring because `PlaceFlexItems` was only\ncalled in the case of fragments that weren't inheriting from a\nbreak-token, which meant that `flex_items_` wasn't populated, and\n`SetReadingFlowNodes` would have a bad access.\n\nBug: 568666838\nChange-Id: I33b3063dcc49af60962ffb4c0b0ea29eaf88f4bb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8503789\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711658}\n\n--\n\nwpt-commits: 05730ee06b525d268b224dd7105370cd218d88a9\nwpt-pr: 63296\n", "files": ["testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/flex-visual-fragmentation.html"], "git_node": "00a8632e0ccc73f18b5400d0bd922f702407f80e", "git_parents": ["4abd301d0c6d7d89e6b4316084bc5fafe95a1751"], "node": "d1b10f4b3e36e1740a7c5641f453f8d3e57f194e", "parents": ["9d33c1ff227c21d285e10063e3162b1015de4c2e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078675 [wpt PR 63296] - Update wpt metadata, a=testonly\n\nwpt-pr: 63296\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/flex-visual-fragmentation.html.ini"], "git_node": "beb9d5236421625fab178826f139847d6f000674", "git_parents": ["00a8632e0ccc73f18b5400d0bd922f702407f80e"], "node": "92ccf086db20737800d82318afa63b482f1774c4", "parents": ["d1b10f4b3e36e1740a7c5641f453f8d3e57f194e"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078683 [wpt PR 63297] - Deflake row-use-cases-001.html, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake row-use-cases-001.html\n\nThis patch deflakes the following test:\nwpt/css/css-flexbox/intrinsic-size/row-use-cases-001.html\n\nThe flakiness is consistently reproducible and is due to not waiting\nfor the Ahem font to be ready. This patch waits for the font to be\nready, which fixes the flakiness.\n\nThis test already had failing expectations on all platforms (see:\ncrrev.com/46f904d16ebc598e95a3ba5b50e1b10eaa825577), and with this\nflakiness fix, they can be combined into a single failing expectation.\n\nBug: 568337130\nChange-Id: I58af8f2cb93e4cd53f431a0742e58d641cffb487\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8517418\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nCommit-Queue: David Grogan \u003cdgrogan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711661}\n\n--\n\nwpt-commits: 0e67fbbc7f7299f8a5960a628f67f8c3f0b7be51\nwpt-pr: 63297\n", "files": ["testing/web-platform/tests/css/css-flexbox/intrinsic-size/row-use-cases-001.html"], "git_node": "0210ba4840b902ef72eb789bfade3065743d8adf", "git_parents": ["beb9d5236421625fab178826f139847d6f000674"], "node": "5cf7ce2293be3fd363e421f9de5cfec572babb60", "parents": ["92ccf086db20737800d82318afa63b482f1774c4"], "tags": []}, {"author": "Simon Pieters \u003czcorpan@gmail.com\u003e", "branch": "default", "desc": "Bug 2078725 [wpt PR 63299] - Set `loading` before `src` in lazy-out-of-band-load.html, a=testonly\n\nAutomatic update from web-platform-tests\nSet `loading` before `src` in lazy-out-of-band-load.html\n\nOtherwise the `src-then-lazy-load.html` bug in WebKit loads the lazy image before the out-of-band load happens.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n\n--\n\nwpt-commits: 788584597a223265879760fd2633f7859d09e5ad\nwpt-pr: 63299\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/update-the-image-data/lazy-out-of-band-load.html"], "git_node": "ee51aeb87b4dbf4adf49e10e50d2c5e3973bc213", "git_parents": ["0210ba4840b902ef72eb789bfade3065743d8adf"], "node": "0d1b122ee40965e116e0c40a2d39dce5cf891670", "parents": ["5cf7ce2293be3fd363e421f9de5cfec572babb60"], "tags": []}, {"author": "Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e", "branch": "default", "desc": "Bug 2078760 [wpt PR 63298] - [HiC] Use unvisited color for image map focus rings, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Use unvisited color for image map focus rings\n\nFixed: 569005114\nChange-Id: I553cfe7658105dbed102923d39ca0db6fa15452e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8516997\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711767}\n\n--\n\nwpt-commits: febd84017b89a80d6b0464af9289381c5614ad06\nwpt-pr: 63298\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/visited-link/image-map-area-visited-color-ignored.tentative.html"], "git_node": "31f72ba618800cf4a4019bedfdb4e5d6cbb4da7f", "git_parents": ["ee51aeb87b4dbf4adf49e10e50d2c5e3973bc213"], "node": "acaaa40113d21c07712815c2cbf9713d439deb95", "parents": ["0d1b122ee40965e116e0c40a2d39dce5cf891670"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078760 [wpt PR 63298] - Update wpt metadata, a=testonly\n\nwpt-pr: 63298\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/visited-link/image-map-area-visited-color-ignored.tentative.html.ini"], "git_node": "b315ef028fec313defe4c204dcdb654c3cf8e7df", "git_parents": ["31f72ba618800cf4a4019bedfdb4e5d6cbb4da7f"], "node": "d08f7dad4089e57ce503253779df1f9d7fdce4dc", "parents": ["acaaa40113d21c07712815c2cbf9713d439deb95"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078780 [wpt PR 63301] - [Critical-CH] Clear persisted Accept-CH state between WPTs, a=testonly\n\nAutomatic update from web-platform-tests\n[Critical-CH] Clear persisted Accept-CH state between WPTs\n\nEvery response from echo-critical-hint.py includes `Accept-CH:\nsec-ch-device-memory,device-memory`, which the browser persists per\norigin on top-level navigations. Because headless_shell_wpt reuses the\nsame browser session across tests on a worker, any test that navigated a\ntop-level frame to echo-critical-hint.py (or\ncritical-ch.navigation-timing.restart.https.html) left\n`sec-ch-device-memory` and `device-memory` enabled for subsequent tests\non the same origin.\n\nWhen a later test expected an initial request without those hints (such\nas `mis-matched*`, `subresource`, `iframe`, `unsafe-method`, or\n`request-count*`), it would flakily fail depending on worker test\nordering.\n\nTo fix this:\n- Add `resources/clear-client-hints.html` (+ `.headers`) serving\n  `Clear-Site-Data: \"clientHints\"`.\n- Clear persisted hints before navigating or fetching in `util.js`,\n  `iframe.https.window.js`, `subresource.https.window.js`, and\n  `unsafe-method.https.window.js`, before `echo-critical-hint.py` posts\n  its result (which also clears `HTTPS_REMOTE_ORIGIN` in cross-origin\n  popup tests), and in cleanup of\n  `critical-ch.navigation-timing.restart.https.html`.\n- Perform subresource fetches in `subresource.https.window.js` from a\n  freshly committed same-origin iframe after clearing, since a\n  document's subresource hints are snapshotted at commit time.\n- Serialize multi-subtest files (`util.js`, `iframe.https.window.js`,\n  and `unsafe-method.https.window.js`), scope `popup_window` locally,\n  use distinct popup target names in `unsafe-method.https.window.js`,\n  and clean up popups/iframes via `() =\u003e popup_window.close()` and\n  `() =\u003e iframe.remove()`.\n\nBug: 504639939, 485661974\nChange-Id: I7b5829374e8fb8264f2eb5376a8cc4c28997af99\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8501311\nReviewed-by: Victor Tan \u003cvictortan@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711771}\n\n--\n\nwpt-commits: 94c8cb6bd8f6b72d08e78fd46cc1f1e245ca96b1\nwpt-pr: 63301\n", "files": ["testing/web-platform/tests/client-hints/critical-ch/critical-ch.navigation-timing.restart.https.html", "testing/web-platform/tests/client-hints/critical-ch/iframe.https.window.js", "testing/web-platform/tests/client-hints/critical-ch/resources/clear-client-hints.html", "testing/web-platform/tests/client-hints/critical-ch/resources/clear-client-hints.html.headers", "testing/web-platform/tests/client-hints/critical-ch/resources/echo-critical-hint.py", "testing/web-platform/tests/client-hints/critical-ch/resources/util.js", "testing/web-platform/tests/client-hints/critical-ch/subresource.https.window.js", "testing/web-platform/tests/client-hints/critical-ch/unsafe-method.https.window.js"], "git_node": "798599f5abe89f6b8a2dba504dd28699447692f1", "git_parents": ["b315ef028fec313defe4c204dcdb654c3cf8e7df"], "node": "30f4c11b207ad8f924b890ac140f1a0dca487774", "parents": ["d08f7dad4089e57ce503253779df1f9d7fdce4dc"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078800 [wpt PR 63302] - [html-in-canvas] Do not cull drawable elements under clips, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Do not cull drawable elements under clips\n\nThis patch fixes CullRectUpdater::UpdateRecursively to not mark\na subtree as out of the cull rect when\nsubtree_should_use_infinite_cull_rect is set. Previously, an empty\noverflow clip (such as overflow: hidden with zero size) failed the\nCullRect::Intersects check even with an infinite cull rect, causing\nnested drawable descendants to be culled instead of ignoring ancestor\nclips.\n\nBug: 565840014\nChange-Id: Ie33b6c4bb7f19adb85364d8dcef8e05ec3508e5e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8519297\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711887}\n\n--\n\nwpt-commits: f707a94225f974b954af49550c48c1d45dc130a7\nwpt-pr: 63302\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-drawable-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-drawable.tentative.html"], "git_node": "0edaad5cfa8c1ab827ea9fefd59b2d543140eb75", "git_parents": ["798599f5abe89f6b8a2dba504dd28699447692f1"], "node": "b04ae74fe3776a2b6e57b7851d927fb098d0c641", "parents": ["30f4c11b207ad8f924b890ac140f1a0dca487774"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2078813 [wpt PR 63303] - Keep following links when clicking controls inside them, a=testonly\n\nAutomatic update from web-platform-tests\nKeep following links when clicking controls inside them\n\nBefore CleanUpActivationBehavior [1], activation behavior ran from\ndefault event handlers (via DOMActivate). Those handlers bubble from\nthe target up the event path until one of them marks the click as\nhandled. For example, clicking `\u003ca href\u003e\u003cbutton\u003e...\u003c/button\u003e\u003c/a\u003e` ran\nthe button's default handler, which did nothing, and then the\nanchor's default handler, which followed the link. Clicking the same\nbutton when it submits or resets a form, or clicking a checkbox or\nradio button, marks the click as handled, so the link is not\nfollowed. Popover and command buttons do not mark the click as\nhandled, so both the popover/command and the link run. Gecko and\nWebKit behave the same way for the simple button-in-link case.\n\nCleanUpActivationBehavior moved activation behavior into\nEventDispatcher, following the DOM Standard [2]: the activation\ntarget is chosen before dispatch, and only its activation behavior\nruns. Every \u003cbutton\u003e and \u003cinput\u003e has activation behavior per the HTML\nStandard [3][4], so a control inside a link always became the\nactivation target and the link was never followed. That broke\ncontent.\n\nThe HTML Standard is likely to change to match what browsers do:\n\nSee https://github.com/whatwg/html/issues/10032#issuecomment-5879250134\n\nThis CL restores the legacy behavior under CleanUpActivationBehavior.\nAfter the activation target's activation behavior runs, the\ndispatcher walks the rest of the event path in bubbling order,\ninterleaved with the default event handlers. For each node after the\nactivation target that has activation behavior, it runs that\nbehavior, until the click is canceled or marked as handled. Whether a\nnode has activation behavior is checked at that point, after event\nlisteners have run, as the default event handlers did. This means\nchanges made during dispatch (e.g. changing a button's type, adding\ncommandfor/command or popovertarget, or giving the anchor an href)\nhave the same effect as before. Interleaving with the default event\nhandlers lets ancestors such as \u003clabel\u003e, whose click handling is in\nits default event handler, handle the click before an enclosing link\nis followed.\n\nTests:\n- New html/semantics/forms/the-button-element/\n  controls-inside-link-activation.tentative.html covers \u003cbutton\u003e and\n  \u003cinput\u003e inside a link, for form submission and reset, popovertarget,\n  commandfor/command, image, checkbox, radio, and controls without\n  activation behavior. Each behavior is tested when present before\n  the click, added during the click, and removed during the click.\n  It also covers the link gaining or losing href during the click,\n  and a canceled click. It passes with CleanUpActivationBehavior\n  enabled and disabled. This test is tentative because it doesn't\n  match the spec, but it does match browser behavior.\n- dom/events/Event-dispatch-single-activation-behavior.html gets a\n  baseline with 7 failing subtests (e.g. \u003ca\u003e\u003clabel\u003e\u003cbutton\n  type=button\u003e, where the link is followed). These assert the current\n  spec.\n\nSee also: https://crrev.com/c/8278919/comment/37da8d8b_d452e3da/\n\n[1] https://crrev.com/c/8278919\n[2] https://dom.spec.whatwg.org/#concept-event-dispatch\n[3] https://html.spec.whatwg.org/multipage/form-elements.html#the-button-element:activation-behaviour\n[4] https://html.spec.whatwg.org/multipage/input.html#the-input-element:activation-behaviour\n\nBug: 563000231\nChange-Id: I48b5f2ffb58d08f9201b23188fb49a5bd5620b04\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8463211\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711896}\n\n--\n\nwpt-commits: 2031a93c44df47d2630dd639e083c40f717f1c66\nwpt-pr: 63303\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-button-link-activation.html", "testing/web-platform/tests/html/semantics/forms/the-button-element/controls-inside-link-activation.tentative.html"], "git_node": "3e0792647f65f253844f5a804a4e95c21b0e6e82", "git_parents": ["0edaad5cfa8c1ab827ea9fefd59b2d543140eb75"], "node": "c6b19e193d81815de114fb63c8856129c1f5c78c", "parents": ["b04ae74fe3776a2b6e57b7851d927fb098d0c641"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078813 [wpt PR 63303] - Update wpt metadata, a=testonly\n\nwpt-pr: 63303\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-button-link-activation.html.ini", "testing/web-platform/meta/html/semantics/forms/the-button-element/controls-inside-link-activation.tentative.html.ini"], "git_node": "6488a13f8406165815d3fc3b01790b0f85ea488e", "git_parents": ["3e0792647f65f253844f5a804a4e95c21b0e6e82"], "node": "557fe78ea37d4efd1830a491f3fee4148d725fe5", "parents": ["c6b19e193d81815de114fb63c8856129c1f5c78c"], "tags": []}, {"author": "Manuel Rego Casasnovas \u003crego@igalia.com\u003e", "branch": "default", "desc": "Bug 2076747 [wpt PR 63096] - [aamtests] Add tests to check aria-errormessage with aria-invalid, a=testonly\n\nAutomatic update from web-platform-tests\n[aamtests] Add tests to check aria-errormessage with aria-invalid\n\nThe tests checks that aria-errormessage is not exposed\nwhen aria-invalid is false (explicitly and implicitly).\n\n--\n\nwpt-commits: 63ef10bc5daa008278fea37dbbc52993c485932c\nwpt-pr: 63096\n", "files": ["testing/web-platform/tests/aria/aamtests/aria_errormessage_not_exposed_condition.py", "testing/web-platform/tests/aria/aamtests/aria_errormessage_not_exposed_condition_dynamic.py", "testing/web-platform/tests/aria/aamtests/conftest.py"], "git_node": "afae2647cfe993e1e142ebe73cd2c202b118af14", "git_parents": ["6488a13f8406165815d3fc3b01790b0f85ea488e"], "node": "21588fa9f9247251dce1c49d0d3fd8b6e19a91a4", "parents": ["557fe78ea37d4efd1830a491f3fee4148d725fe5"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2078461 [wpt PR 63282] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326351, a=testonly\n\nAutomatic update from web-platform-tests\nCross-Origin-Embedder-Policy should be ignored in non-secure contexts\n\nAn embedder policy is only obtained for a secure context, but we only checked\nthe response URL, so an HTTPS document in an HTTP page, and the workers it\ncreates, still required CORP.\n\nobtainCrossOriginEmbedderPolicy() and obtainOriginAgentClusterPolicy() now take\nwhether the environment is a secure context, rather than each guessing from the\nresponse URL. A document uses Document::isSecureContext() and a worker uses its\nowner's.\n\nWith site isolation, Document::isSecureContext() is asked before a provisional\nframe is added to the frame tree, so it now also checks the main frame when\nthere is no parent yet.\n\nThis is a first step towards determining once per navigation whether the\nreserved environment is a secure context, as HTML does. Document-Isolation-Policy\nwill need that as well, and Document::isSecureContext() could then stop walking\nthe frame tree.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326351\n\n--\n\nwpt-commits: a419ab2055dd4a747dfae5c407ae9a6d10aa08ca\nwpt-pr: 63282\n", "files": ["testing/web-platform/tests/html/cross-origin-embedder-policy/no-secure-context-https-iframe.html"], "git_node": "713250cb002d68516f1b33de3b2a438bbcbed453", "git_parents": ["afae2647cfe993e1e142ebe73cd2c202b118af14"], "node": "db7e50869b1af9e0fd81b8fdf2206e96b088b38d", "parents": ["21588fa9f9247251dce1c49d0d3fd8b6e19a91a4"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2078099 [wpt PR 63264] - Fix copied bugs in COEP and DIP credentialless tests, a=testonly\n\nAutomatic update from web-platform-tests\nFix copied bugs in COEP and DIP credentialless tests\n\nThe shared worker tests compared the request_origin variant against\n\"same-origin\", but the variants use \"same_origin\". Every variant\ntherefore requested the cross-origin URL.\n\nThe require-corp \"(omit)\" Cache Storage subtests stored their response\nwith credentials \"include\", the same as their non-\"(omit)\" sibling.\n\nAlso retitle two Document-Isolation-Policy tests that still described\nthemselves as COEP tests.\n\n--\n\nwpt-commits: 89b6f8eb52b389dfa111ce91068a75ca296087eb\nwpt-pr: 63264\n", "files": ["testing/web-platform/tests/html/cross-origin-embedder-policy/credentialless/cache-storage.https.window.js", "testing/web-platform/tests/html/cross-origin-embedder-policy/credentialless/shared-worker.https.window.js", "testing/web-platform/tests/html/document-isolation-policy/credentialless-cache-storage-from-none.https.tentative.window.js", "testing/web-platform/tests/html/document-isolation-policy/credentialless-shared-worker.https.tentative.window.js", "testing/web-platform/tests/html/document-isolation-policy/isolate-and-require-corp-load-from-cache-storage.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/shared-workers.tentative.https.html"], "git_node": "e590a443ef44ab9005f793681aefb2cb46b7317e", "git_parents": ["713250cb002d68516f1b33de3b2a438bbcbed453"], "node": "9bde92060b12e11838977deb458a2d0d5aedf226", "parents": ["db7e50869b1af9e0fd81b8fdf2206e96b088b38d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078099 [wpt PR 63264] - Update wpt metadata, a=testonly\n\nwpt-pr: 63264\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/document-isolation-policy/credentialless-shared-worker.https.tentative.window.js.ini"], "git_node": "523912fd0229fa3511134aed8a9fd397098926bc", "git_parents": ["e590a443ef44ab9005f793681aefb2cb46b7317e"], "node": "c44c88693be2a75b4424eabcbe8991d970d97c79", "parents": ["9bde92060b12e11838977deb458a2d0d5aedf226"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2079075 [wpt PR 63309] - Deflake baseline-shift-sub-super.html, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake baseline-shift-sub-super.html\n\nThis patch deflakes the following test:\nwpt/css/css-inline/baseline-shift/baseline-shift-sub-super.html\n\nThe flakiness is consistently reproducible and is due to not waiting\nfor the Ahem font to be ready. This patch waits for the font to be\nready, which fixes the flakiness.\n\nBug: 568337130\nChange-Id: I2561651b55092fa8c0dc2722fd580a40220a4751\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8517757\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712128}\n\n--\n\nwpt-commits: d0d69b7dadfe16dd26a4c4792526aa2cee4a5ce6\nwpt-pr: 63309\n", "files": ["testing/web-platform/tests/css/css-inline/baseline-shift/baseline-shift-sub-super.html"], "git_node": "bf8897a4a69313b089e7e64dd87046c094cca96d", "git_parents": ["523912fd0229fa3511134aed8a9fd397098926bc"], "node": "94df7c9a45b5826316cd0ae5d7f671e76662fec1", "parents": ["c44c88693be2a75b4424eabcbe8991d970d97c79"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078972 [wpt PR 63307] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326377, a=testonly\n\nAutomatic update from web-platform-tests\n[MathML] Empty \u003cmpadded\u003e baseline ignores border-top and padding-top (#63307)\n--\n\nwpt-commits: a31e9d8ea6686588e83bdc094a22aa845afa3fb3\nwpt-pr: 63307\n", "files": ["testing/web-platform/tests/mathml/relations/css-styling/padding-border-margin/padding-border-mpadded-baseline.html"], "git_node": "f094bac7c7eba36a6e48297b5e0f2ccb003878f8", "git_parents": ["bf8897a4a69313b089e7e64dd87046c094cca96d"], "node": "58660324f27bee927799f34d45a5adfb0ac5e2ef", "parents": ["94df7c9a45b5826316cd0ae5d7f671e76662fec1"], "tags": []}, {"author": "Wonik Choi \u003cchoiwonik91@gmail.com\u003e", "branch": "default", "desc": "Bug 2078931 [wpt PR 63304] - [textdecoder] Reset CJK state after flushing, a=testonly\n\nAutomatic update from web-platform-tests\n[textdecoder] Reset CJK state after flushing\n\nISO-2022-JP and EUC-JP retain decoder state after end-of-input, allowing\none TextDecoder session to affect the next.\n\nReset ISO-2022-JP state after EOF processing and clear EUC-JP's JIS0212\nselection using the existing Finalize hook. Preserve state while\nstreaming.\n\nKeep the codec reuse optimization introduced in CL 2271061 to avoid\nallocating a new codec for each decoding session.\n\nBug: 467624168\nChange-Id: Ie9d44b70e54c5107a8ca14f85fc8d5a073ff8450\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8503856\nCommit-Queue: Adam Rice \u003cricea@chromium.org\u003e\nReviewed-by: Adam Rice \u003cricea@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712315}\n\n--\n\nwpt-commits: 5d731dbb6b9f21bd503752e0bf32a5ccc80f4b44\nwpt-pr: 63304\n", "files": ["testing/web-platform/tests/encoding/iso-2022-jp-decoder.any.js"], "git_node": "bddb497129cf1411dc295d71b07c3a1436c5aa53", "git_parents": ["f094bac7c7eba36a6e48297b5e0f2ccb003878f8"], "node": "e770a76fc219fc91d979fac80edc793e02ba3b0b", "parents": ["58660324f27bee927799f34d45a5adfb0ac5e2ef"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2078232 [wpt PR 63276] - Wait for poster decode before ending lazy-loading video tests, a=testonly\n\nAutomatic update from web-platform-tests\nWait for poster decode before ending lazy-loading video tests (#63276)\n\nThe poster is loaded by anonymous content, so decode a same-URL image\n(sharing the cached request) to wait until the poster is fully decoded\nbefore completing the test. A decode task still queued at shutdown is\notherwise reported as a leak.\n--\n\nwpt-commits: d76b1e12a4fc2fba4d403a013f049191a2ef9130\nwpt-pr: 63276\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-video-element/video-loading-lazy-poster-when-visible.html", "testing/web-platform/tests/html/semantics/embedded-content/the-video-element/video-loading-lazy-source-poster-deferred.html"], "git_node": "c756183e898383209f4325a778f0b53921b4301a", "git_parents": ["bddb497129cf1411dc295d71b07c3a1436c5aa53"], "node": "1098e104598536bb8fbe6c99df813840c3c1aa81", "parents": ["e770a76fc219fc91d979fac80edc793e02ba3b0b"], "tags": []}, {"author": "Thomas Guilbert \u003ctguilbert@chromium.org\u003e", "branch": "default", "desc": "Bug 2079082 [wpt PR 63324] - Fix timeouts in rVFC before-xr-session WPT, a=testonly\n\nAutomatic update from web-platform-tests\nFix timeouts in rVFC before-xr-session WPT\n\n`request-video-frame-callback-before-xr-session.https.html` shares one\n5s video between its 4 subtests, and starts playing it while the page is\nstill loading. On slow bots, the video can end before the subtests are\ndone. rVFC callbacks then stop, and the test times out. This happens on\n~4% of win-rel runs.\n\nThis CL loops the video, and removes the Linux `[ Pass Timeout ]`\nexpectation, which should no longer be needed. It also removes a\n`video.currentTime = 0` call, which never reset the video between\nsubtests.\n\nFixed: 40881807, 40189569\nChange-Id: I3a88a1389458fe7a3743ef99b80884721d7b1f39\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8518405\nCommit-Queue: Syed AbuTalib \u003clowkey@google.com\u003e\nReviewed-by: Syed AbuTalib \u003clowkey@google.com\u003e\nAuto-Submit: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712365}\n\n--\n\nwpt-commits: 48eb3224ed099607721b2b51eb8f9bfac67af0b8\nwpt-pr: 63324\n", "files": ["testing/web-platform/tests/video-rvfc/request-video-frame-callback-before-xr-session.https.html"], "git_node": "be59251f5aa9748f36530b34eb3afe2038b1e256", "git_parents": ["c756183e898383209f4325a778f0b53921b4301a"], "node": "64c9574ff17feaf127b3df563f5d806e2d2e0c5b", "parents": ["1098e104598536bb8fbe6c99df813840c3c1aa81"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2079084 [wpt PR 63322] - Fixed broken detection of overlay scrollbars in CQ test, a=testonly\n\nAutomatic update from web-platform-tests\nFixed broken detection of overlay scrollbars in CQ test\n\nSubtests of query-content-box.html relies on correct detection of\noverlay scrollbars for the expected query widths. The detection\nincorrectly checked the element reference against 0. Test flakily failed\non MacOS.\n\nCheck offsetWidth instead.\n\nBug: 566836342\nChange-Id: I926f6d48587e8e0aab42c94898ff1626e90a41d8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8517322\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nAuto-Submit: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712380}\n\n--\n\nwpt-commits: 59e20730c187de3ba701d95b7d81993279a89d6a\nwpt-pr: 63322\n", "files": ["testing/web-platform/tests/css/css-conditional/container-queries/query-content-box.html"], "git_node": "f6351b87acd296a7ddfaf635bcf10036510d0675", "git_parents": ["be59251f5aa9748f36530b34eb3afe2038b1e256"], "node": "f0440bf1f8357f3a635b8f3dda64e85fcaa37e25", "parents": ["64c9574ff17feaf127b3df563f5d806e2d2e0c5b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079084 [wpt PR 63322] - Update wpt metadata, a=testonly\n\nwpt-pr: 63322\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/container-queries/query-content-box.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini"], "git_node": "44d90910a1e41b354efe42c3c0e2e8b09e5cb8da", "git_parents": ["f6351b87acd296a7ddfaf635bcf10036510d0675"], "node": "54973f36d86094bdc3bda4abaea051a1bf7ee26e", "parents": ["f0440bf1f8357f3a635b8f3dda64e85fcaa37e25"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2079085 [wpt PR 63321] - Apply latest spec changes for createParserOptions, a=testonly\n\nAutomatic update from web-platform-tests\nApply latest spec changes for createParserOptions\n\nThis aligns with:\n- https://github.com/whatwg/html/pull/12583\n- https://github.com/w3c/trusted-types/pull/606\n\nKey changes:\n- Remove default `= {}` from `SetHTMLUnsafeOptions.sanitizer` and\n  `ParseHTMLUnsafeOptions.sanitizer` in IDL,\n  and only populate `sanitizer`\n  on the dictionary passed to `createParserOptions` when provided.\n- Update `TrustedTypePolicy.createParserOptions` and\n  `CreateParserOptionsCallback` to accept optional\n  `SetHTMLUnsafeOptions` and variadic `any... args`, passing\n  `\"TrustedHTMLParserOptions\"` and the\n  sink name when invoked on the default policy.\n- Require default policy `createParserOptions` vetting when author\n  supplied parser options specify `runScripts: true` or a non-empty\n  sanitizer, even\n  when the input is already a `TrustedHTML`. (This is a breaking\n  change! but still protected by the flag)\n- Allow any `TrustedHTMLParserOptions` (even without a sanitizer) to\n  satisfy Trusted Types enforcement for HTML fragment sinks, and use\n  `TrustedTypesCheckForFragment` in `Document.parseHTMLUnsafe`.\n- Bypass `createParserOptions` and ignore sanitization in XML\n  documents,\n  always requiring `TrustedHTML` for XML fragment sinks.\n\nBug: 491743369\nChange-Id: Ia0b35e3f8720dc318aacafc117098fb3db508b30\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8496967\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1712499}\n\n--\n\nwpt-commits: b5daf96de870b547d88d1a157a0be7b631db1f04\nwpt-pr: 63321\n", "files": ["testing/web-platform/tests/domparsing/tentative/positional-methods-with-parser-options.html", "testing/web-platform/tests/domparsing/tentative/stream-html-with-trusted-types-runScripts-cannot-be-turned-on.html", "testing/web-platform/tests/sanitizer-api/parsehtmlunsafe-with-trustedtypes.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedhtml-createParserOptions.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.tentative.html.headers", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer-report-only.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer-report-only.tentative.html.headers", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer.tentative.html"], "git_node": "a3f8f39b717eaff3321a5f6dfc1c8c8394c2c23a", "git_parents": ["44d90910a1e41b354efe42c3c0e2e8b09e5cb8da"], "node": "a158e7688437ddc49df990c7863dd38fbf1ffd0d", "parents": ["54973f36d86094bdc3bda4abaea051a1bf7ee26e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079085 [wpt PR 63321] - Update wpt metadata, a=testonly\n\nwpt-pr: 63321\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/positional-methods-with-parser-options.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-with-trusted-types-runScripts-cannot-be-turned-on.html.ini", "testing/web-platform/meta/sanitizer-api/parsehtmlunsafe-with-trustedtypes.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedhtml-createParserOptions.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes-createParserOptions.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-xml-document-sanitizer-report-only.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-xml-document-sanitizer.tentative.html.ini"], "git_node": "cde3fdb8196f985832f0cd7e232d637492b6d346", "git_parents": ["a3f8f39b717eaff3321a5f6dfc1c8c8394c2c23a"], "node": "bc672233c007c5587d6a8e9b29ffd3f37c6c9925", "parents": ["a158e7688437ddc49df990c7863dd38fbf1ffd0d"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2079086 [wpt PR 63328] - [masonry] Add tests for reading flow reading down the stacking axis, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Add tests for reading flow reading down the stacking axis\n\nTests for reading-flow in grid-lanes for reading down individual\nstacking axes. The default behavior of \"normal\" is working, where items\nare read based on their source order (so order they appear in the DOM)\nas opposed to their visual order. Naming for this is still up for\ndiscussion [1] but we're using the grid keywords for now to unblock\nimplementation.\n\nTests were also added for reverse placement, as well as dense-packing\nand multi-spanning items, but more complex tests will be added with the\nimplementation of those features to keep this change from being too\nlarge.\n\nFollow-ups will be needed to implement actually reading down the\nstacking axis based on visual order.\n\nReading across tracks (across the grid-axis) will require separate\nchanges, and the discussion can be found in a CSSWG issue [2].\n\n[1] https://github.com/w3c/csswg-drafts/issues/14290 [2]\nhttps://github.com/w3c/csswg-drafts/issues/5675#issuecomment-2565155995\n\nBug: 564353369\nChange-Id: Idea4862c2f6dca28d999f61cc5fce8f5164e8167\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8495806\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1712520}\n\n--\n\nwpt-commits: dde871463b330454edbc526703ab3dd4c8c3a3ff\nwpt-pr: 63328\n", "files": ["testing/web-platform/tests/css/css-display/reading-flow/tentative/reading-flow-invalid.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-001.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-002.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-003.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-004.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-006.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-007.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-008.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-001.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-002.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-003.html"], "git_node": "b9c62184a35ba7c8ae14aaef8730dba0e1866e0e", "git_parents": ["cde3fdb8196f985832f0cd7e232d637492b6d346"], "node": "f433ad81e54461ad6a5dba17cea67b1e391790bd", "parents": ["bc672233c007c5587d6a8e9b29ffd3f37c6c9925"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079086 [wpt PR 63328] - Update wpt metadata, a=testonly\n\nwpt-pr: 63328\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-001.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-003.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-004.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-006.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-007.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-008.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-001.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-002.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-003.html.ini"], "git_node": "15048d901baa6a984a2b2d8cf5c1fe3fd949ff24", "git_parents": ["b9c62184a35ba7c8ae14aaef8730dba0e1866e0e"], "node": "c4035c987f62adcb43cba2812d893a018ab4144a", "parents": ["f433ad81e54461ad6a5dba17cea67b1e391790bd"], "tags": []}, {"author": "Kiet Ho \u003ckiet.ho@apple.com\u003e", "branch": "default", "desc": "Bug 2078531 [wpt PR 63294] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=227967, a=testonly\n\nAutomatic update from web-platform-tests\nImplement CSS module scripts\n\nThis patch implements importing CSS stylesheets as JavaScript modules, using the\n`import ... with { type: 'css' }` and `import(..., { with: { type: 'css' } })`\nsyntax.\n\nOn the JSC side, we add support for the `css` module type, and requests WebCore\nto fetch it. WebCore fetches the stylesheet, constructs a CSSStyleSheet object\nout of it, wraps it in a JSCSSStyleSheet, and returns it back to JSC as a JSValue.\nJSC uses this as the default export value of the CSS module.\n\nTo implement this requires some changes in how script modules loading works. Before,\nJSC asks WebCore to fetch a script, WebCore fetches the source code and returns it\nto JSC. This works for JavaScript/WASM/JSON/text, because those are JavaScript\nconstructs and can only be handled by JSC. However, CSS is a WebCore construct and\ncan only be handled by WebCore. This patch changes it so that depending on the module\ntype, WebCore can either return a source code for types it can't handle, like JS or\nWASM. For types it can handle like CSS, WebCore constructs the JSValue itself, then\npasses it to JSC. JSC just uses the JSValue as the default module export.\n\nThis is gated by the CSSModuleScriptsEnabled feature flag, which is disabled by default.\n\nThere is one failing test only on GTK, which is tracked at webkit.org/b/326330:\n- html/semantics/scripting-1/the-script-element/css-module/credentials.sub.html\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=227967\n\n--\n\nwpt-commits: 97fe10c5d0e12e4a9d90f77b8db0602c64f3ad2d\nwpt-pr: 63294\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/css-module/charset-bom.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/css-module/content-type-checking.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/css-module/resources/should-not-be-loaded.js"], "git_node": "f03adcc5fd808d28e26791c61b33ec1ab3f120c2", "git_parents": ["15048d901baa6a984a2b2d8cf5c1fe3fd949ff24"], "node": "92141e151ba2100959913940488e66058ac0b6e2", "parents": ["c4035c987f62adcb43cba2812d893a018ab4144a"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2079099 [wpt PR 63323] - Disallow \u003cscript\u003e targets in HTMLStream, a=testonly\n\nAutomatic update from web-platform-tests\nDisallow \u003cscript\u003e targets in HTMLStream\n\nAlign HTMLStream::Create with the WHATWG HTML spec for streamHTML (#12758)\nby throwing a NotSupportedError DOMException when the target is an HTML\nor SVG \u003cscript\u003e element for both safe and unsafe streaming methods.\n\nUpdate stream-tokenizer-context.html accordingly: drop the cases that\nstreamed directly into \u003cscript\u003e and cover the remaining RAWTEXT and\n\u003cnoscript\u003e tokenizer contexts for the streaming methods.\n\nBug: 491743369\nChange-Id: I441e700b82fe334babefba697e4a1ba0c77a20cd\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8498303\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1712602}\n\n--\n\nwpt-commits: 4b363330fea2fa53fb6974d219a27ee25fb62862\nwpt-pr: 63323\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-html-script-safe.html", "testing/web-platform/tests/domparsing/tentative/stream-tokenizer-context.html"], "git_node": "3701647f70667671dab627adb3cd9a745fdf354f", "git_parents": ["f03adcc5fd808d28e26791c61b33ec1ab3f120c2"], "node": "f1f1266387e63d021a201d4a34df3cb2ea7c546c", "parents": ["92141e151ba2100959913940488e66058ac0b6e2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079099 [wpt PR 63323] - Update wpt metadata, a=testonly\n\nwpt-pr: 63323\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-html-script-safe.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-tokenizer-context.html.ini"], "git_node": "3473802a07c8f88b0610cd81a2c3d48085253ada", "git_parents": ["3701647f70667671dab627adb3cd9a745fdf354f"], "node": "f9f45636a2623eba3f7fed3622f69806446fd33d", "parents": ["f1f1266387e63d021a201d4a34df3cb2ea7c546c"], "tags": []}, {"author": "Adam Page \u003cadam@adampage.net\u003e", "branch": "default", "desc": "Bug 1962052 [wpt PR 52123] - Add tentative test for invalidly nested heading nodes, a=testonly\n\nAutomatic update from web-platform-tests\nAdd tentative test for invalidly nested heading nodes (#52123)\n--\n\nwpt-commits: cc7f70af99363abd75b651075666e037c78d5966\nwpt-pr: 52123\n", "files": ["testing/web-platform/tests/wai-aria/heading/invalid-nesting.html", "testing/web-platform/tests/wai-aria/heading/invalid-nesting.tentative.html"], "git_node": "3c7ccf1acc367670957188c410388bd1e7f55bd4", "git_parents": ["3473802a07c8f88b0610cd81a2c3d48085253ada"], "node": "8c44dc68d69ba48bc9a053b9fc48514bcbf31bc0", "parents": ["f9f45636a2623eba3f7fed3622f69806446fd33d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962052 [wpt PR 52123] - Update wpt metadata, a=testonly\n\nwpt-pr: 52123\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/wai-aria/heading/invalid-nesting.tentative.html.ini"], "git_node": "fcd8a01af2083dfa4b0bf1477f8235b4104b3cc2", "git_parents": ["3c7ccf1acc367670957188c410388bd1e7f55bd4"], "node": "5ca217589b688b2d4c05eb7d6f4896455c04596b", "parents": ["8c44dc68d69ba48bc9a053b9fc48514bcbf31bc0"], "tags": []}, {"author": "Ryosuke Niwa \u003crniwa@webkit.org\u003e", "branch": "default", "desc": "Bug 2079102 [wpt PR 63331] - Make html/user-activation/propagation-crossorigin.sub.html robust to touch input, a=testonly\n\nAutomatic update from web-platform-tests\nThe test clicks the midpoint of the cross-origin child frame, which lands in a (#63331)\n\nplain `\u003cdiv\u003e` just above the grandchild frame. The child frame listens for clicks\non its window, so nothing at the tapped point is itself clickable.\n\nOn touch devices, a browser may only send a click for a tap that hits an\nelement that responds to clicks, adjusting the tap toward a nearby clickable\nelement otherwise. Here, the tap gets adjusted onto the grandchild `\u003ciframe\u003e`,\nand the test currently passes only because the adjusted point lands right on\nthe `\u003ciframe\u003e`'s 2px border, within a fraction of a pixel of its edge. The border\nbelongs to the `\u003ciframe\u003e` element in the child frame, so the click bubbles to the\nchild frame's window. A sub-pixel difference in layout or in how the tap is\nadjusted instead moves the point above the border, where the click is dropped,\nor into the grandchild frame's content, where the grandchild frame receives it.\n\nShorten the `\u003cdiv\u003e` in the child frame and give the grandchild `\u003ciframe\u003e` a top\npadding, so that the child frame's midpoint falls in the middle of that\npadding. Like the border, the padding belongs to the `\u003ciframe\u003e` element in the\nchild frame's document, not to the grandchild frame's content. A tap there hits\nthe `\u003ciframe\u003e` element directly, with 15px of margin on either side, and the\nclick bubbles to the child frame's window as the test expects. The grandchild\nframe still does not receive it.\n--\n\nwpt-commits: 752dd240b494d8ea094ab12327956e614f4b7566\nwpt-pr: 63331\n", "files": ["testing/web-platform/tests/html/user-activation/resources/propagation-crossorigin-child.sub.html"], "git_node": "136a10e015c21cd24bbee5e1ed517f5fb2817444", "git_parents": ["fcd8a01af2083dfa4b0bf1477f8235b4104b3cc2"], "node": "c589d1711ebedf1f0a6fa96f4432f50c6ab89032", "parents": ["5ca217589b688b2d4c05eb7d6f4896455c04596b"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2079103 [wpt PR 63336] - Fix timeout flake in focus-pseudo-matches-on-shadow-host.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix timeout flake in focus-pseudo-matches-on-shadow-host.html\n\nIn focus-pseudo-matches-on-shadow-host.html, \u003cinput id=\"defaultFocus\"\nautofocus\u003e appears in \u003cbody\u003e before the \u003cscript\u003e element that registers\ndefaultFocus.addEventListener('focus', handleFocus) and calls\ntestInMode().\n\nOnce HTMLDocumentParser::PumpTokenizer() exits \u003chead\u003e and parses the\n\u003cinput autofocus\u003e element, the parser can yield before parsing \u003cscript\u003e\n(for example, when scheduler_-\u003eShouldYieldForHighPriorityWork() returns\ntrue for a pending BeginMainFrame, or when the parser time budget\nexpires). During that yield, BeginMainFrame runs\nPageAnimator::ServiceScriptedAnimations() and calls\nDocument::FlushAutofocusCandidates(), which focuses defaultFocus and\ndispatches its focus event before \u003cscript\u003e executes. When \u003cscript\u003e\nsubsequently runs and registers handleFocus(), the focus event has\nalready fired, so handleFocus() never runs, no promise_test() subtests\nare registered, and the test times out.\n\nReproduce the timeout deterministically by forcing HTML parser yields\nwith HTMLParserYieldAndDelayOftenForTesting:\n  third_party/blink/tools/run_wpt_tests.py -t Default \\\n    --additional-driver-flag=--enable-blink-features=HTMLParserYieldAndDelayOftenForTesting \\\n    external/wpt/shadow-dom/focus/focus-pseudo-matches-on-shadow-host.html\n\nInitialize focusedDefault to (document.activeElement == defaultFocus) so\nprepare() resolves immediately if autofocus already completed before\n\u003cscript\u003e execution. Call testInMode() synchronously at the top level of\n\u003cscript\u003e, and use step_timeout(didFocusDefault, 0) in handleFocus() to\navoid nested focusing steps when autofocus runs after \u003cscript\u003e.\n\nFixed: 567076198\nChange-Id: I0cd06c03e90cc0bcc99523543247aaa5590b3907\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8498979\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712699}\n\n--\n\nwpt-commits: ac78c1673226e1203d800170c1e288de0c508f75\nwpt-pr: 63336\n", "files": ["testing/web-platform/tests/shadow-dom/focus/focus-pseudo-matches-on-shadow-host.html"], "git_node": "1599a5592fd36e008296d69627626a58b0e929f8", "git_parents": ["136a10e015c21cd24bbee5e1ed517f5fb2817444"], "node": "7317637e07dab218b11d380dba27eb57e2f9276c", "parents": ["c589d1711ebedf1f0a6fa96f4432f50c6ab89032"], "tags": []}, {"author": "Kristin Lee \u003ckristinlee@microsoft.com\u003e", "branch": "default", "desc": "Bug 2079105 [wpt PR 63330] - [\u003cinstall\u003e Element] Rename invalid_data to invalid-data, a=testonly\n\nAutomatic update from web-platform-tests\n[\u003cinstall\u003e Element] Rename invalid_data to invalid-data\n\nRename the InstallResult enum value exposed by installresult from\n\"invalid_data\" to \"invalid-data\" to follow web-platform enum naming\nconventions.\n\nUpdate Blink, browser, DevTools, WPT, and vendored interface\nexpectations to use the new token.\n\nBug: 568822818, 454827186, 333795265\nChange-Id: I1690b313c8d6eec2f8a2ca0372ae293df48ce9d3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8522440\nReviewed-by: Robert Paveza \u003cRob.Paveza@microsoft.com\u003e\nReviewed-by: Kunjan Patel \u003cksukh@chromium.org\u003e\nCommit-Queue: Kristin Lee \u003ckristinlee@microsoft.com\u003e\nReviewed-by: Lia Hiscock \u003cliahiscock@microsoft.com\u003e\nReviewed-by: Dibyajyoti Pal \u003cdibyapal@chromium.org\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1712714}\n\n--\n\nwpt-commits: 0fe1e6ee4c914acac23955e62efc84a12ccb787b\nwpt-pr: 63330\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/install/install-element-invalid-targets.tentative.https.html", "testing/web-platform/tests/interfaces/install-element.idl"], "git_node": "2b19efe530719d61f21a832ce6644eafb7d9edb6", "git_parents": ["1599a5592fd36e008296d69627626a58b0e929f8"], "node": "11629ebc822d9b52cab1919a5c89f3d77421d0e4", "parents": ["7317637e07dab218b11d380dba27eb57e2f9276c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079105 [wpt PR 63330] - Update wpt metadata, a=testonly\n\nwpt-pr: 63330\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/install/install-element-invalid-targets.tentative.https.html.ini"], "git_node": "bc142702638a7d077e2cadf2a8db7be31b58a975", "git_parents": ["2b19efe530719d61f21a832ce6644eafb7d9edb6"], "node": "366816168e6f9909c5e5c8a190ba9d7c74dcf4a2", "parents": ["11629ebc822d9b52cab1919a5c89f3d77421d0e4"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078529 [wpt PR 63293] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326241, a=testonly\n\nAutomatic update from web-platform-tests\nshape-outside image drops an above-threshold run that starts in the last column (#63293)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nLayoutShape::createRasterShapeImpl() scans each row of the shape image and\nbuilds intervals from runs of pixels whose alpha is above the threshold. A\nrun was only emitted from the else-if branch, which also handled the last\ncolumn. When the run started on the last column, the first branch opened\nit and the else-if never ran, so the loop ended without emitting the run.\nAs a result, a 1px wide shape image had an empty shape, and a single\nabove-threshold pixel in the last column was ignored, in both horizontal\nand vertical writing modes.\n\nFix this by emitting any run that is still open after the row loop ends,\nand remove the last-column special case from the else-if.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326241\nWebKit-Canonical-Link: https://commits.webkit.org/322756@main\n--\n\nwpt-commits: 71d3ced8c71e21e1b53d90ed644023cfc75530c0\nwpt-pr: 63293\n", "files": ["testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-linear-gradient-last-column.html"], "git_node": "53597e41be81df913fe00958a6eddd3aa8ff5fcd", "git_parents": ["bc142702638a7d077e2cadf2a8db7be31b58a975"], "node": "ffe80e683c319f1cc2b92b7948df57e3f6c127e1", "parents": ["366816168e6f9909c5e5c8a190ba9d7c74dcf4a2"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078215 [wpt PR 63273] - [css-transitions] revert inside @starting-style drops lower-layer @starting-style declarations, a=testonly\n\nAutomatic update from web-platform-tests\n[css-transitions] revert inside @starting-style drops lower-layer @starting-style declarations (#63273)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nThe rollback cascades built for revert, revert-layer and revert-rule\nhardcoded their included property types to normalProperties(), which\ndoes not contain PropertyType::StartingStyle. As a result, addMatch()\ndropped every @starting-style declaration from the rollback cascade,\nso a revert used inside an @starting-style rule could not roll back to\nan @starting-style declaration from a lower priority layer or origin\nand instead behaved like \"unset\".\n\nPropagate the parent cascade's StartingStyle property type into the\nrollback cascade so starting-style declarations remain visible during\nrollback.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325359\nWebKit-Canonical-Link: https://commits.webkit.org/322688@main\n--\n\nwpt-commits: 917f0ba6df796f840099e0f3aadfa2af6401068e\nwpt-pr: 63273\n", "files": ["testing/web-platform/tests/css/css-transitions/starting-style-revert-layer-cascade.html"], "git_node": "52f2eaa92969005469efdd8776529346d648347e", "git_parents": ["53597e41be81df913fe00958a6eddd3aa8ff5fcd"], "node": "4acb1207904947611341ddf211a3e33cd4636b80", "parents": ["ffe80e683c319f1cc2b92b7948df57e3f6c127e1"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2076938 [wpt PR 63119] - Fix screen-relative spatial sensor rotation, a=testonly\n\nAutomatic update from web-platform-tests\nFix screen-relative spatial sensor rotation\n\nUse the screen orientation angle in the correct direction when remapping\nvector sensor readings into screen coordinates.\n\nBug: 506189182\nChange-Id: Ib0ff82debd20f561728752299382bc8f5bff00e0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8361411\nReviewed-by: Matt Reynolds \u003cmattreynolds@chromium.org\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1708575}\n\n--\n\nwpt-commits: ff69d440066cf76580f1bca5b120fdecfed4c505\nwpt-pr: 63119\n", "files": ["testing/web-platform/tests/accelerometer/resources/sensor-data.js", "testing/web-platform/tests/gyroscope/resources/sensor-data.js", "testing/web-platform/tests/magnetometer/resources/sensor-data.js"], "git_node": "cd8bf3fc84272cb8e7fe1a9861d3be4d184c2d8d", "git_parents": ["52f2eaa92969005469efdd8776529346d648347e"], "node": "d0afe897dab3a59c1301b899a73d704890990879", "parents": ["4acb1207904947611341ddf211a3e33cd4636b80"], "tags": []}, {"author": "mark a. foltz \u003cmfoltz@chromium.org\u003e", "branch": "default", "desc": "Bug 2079124 [wpt PR 63332] - [webmcp] Use camelCase and Promise.withResolvers() in WebMCP WPTs, a=testonly\n\nAutomatic update from web-platform-tests\n[webmcp] Use camelCase and Promise.withResolvers() in WebMCP WPTs\n\nConverts snake_case variable and helper names to camelCase and replaces\nmanual Promise construction with Promise.withResolvers() across WebMCP\nimperative and declarative WPTs.\n\nBug: 565332588\nChange-Id: I939156d5081acc6b463636642472e7538c72c169\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508224\nCommit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\nReviewed-by: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1712844}\n\n--\n\nwpt-commits: 86229454bfdfe43f9cf1de9bf5ae85c78252df5c\nwpt-pr: 63332\n", "files": ["testing/web-platform/tests/webmcp/declarative/unregister-during-executeTool.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-abort.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-caller-navigate-abort.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-signal-cross-origin.https.html", "testing/web-platform/tests/webmcp/imperative/permissions-policy.https.html", "testing/web-platform/tests/webmcp/imperative/resources/iframe-register-tool.html", "testing/web-platform/tests/webmcp/imperative/unregister-during-executeTool.https.html"], "git_node": "33a7b92eedc018bf31a879479190e2962b35bba7", "git_parents": ["cd8bf3fc84272cb8e7fe1a9861d3be4d184c2d8d"], "node": "c7853537a4bac1c9fecd82e8351a968a8bcee2bc", "parents": ["d0afe897dab3a59c1301b899a73d704890990879"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2079133 [wpt PR 63334] - Remove stray end tags from MathML and image density WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove stray end tags from MathML and image density WPTs\n\nThese files carry end tags the HTML parser has no matching open element\nfor. The parser discards each of them, so the source suggests a nesting\nthe DOM never had.\n\nDrop the redundant tags. This is a source-readability fix with no\nbehavioral effect.\n\nBug: 542686202\nChange-Id: If38cd5ecc705a1675ef24fbfa4f25aee424dd4f8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8221908\nReviewed-by: Brandon Walderman \u003cbrwalder@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1712883}\n\n--\n\nwpt-commits: b27294fc66c8bc48d577e6d4542c6c017da253f0\nwpt-pr: 63334\n", "files": ["testing/web-platform/tests/density-size-correction/density-corrected-image-svg-aspect-ratio-cross-origin.sub.html", "testing/web-platform/tests/density-size-correction/density-corrected-image-svg-aspect-ratio-ref.html", "testing/web-platform/tests/density-size-correction/density-corrected-image-svg-aspect-ratio.html", "testing/web-platform/tests/density-size-correction/density-corrected-image-svg-cross-origin.sub.html", "testing/web-platform/tests/density-size-correction/density-corrected-image-svg-ref.html", "testing/web-platform/tests/density-size-correction/density-corrected-image-svg.html", "testing/web-platform/tests/mathml/relations/css-styling/blur-filter-ref.html", "testing/web-platform/tests/mathml/relations/css-styling/clip-path-ref.html", "testing/web-platform/tests/mathml/relations/css-styling/clip-ref.html", "testing/web-platform/tests/mathml/relations/css-styling/mathcolor-mathbackground-css-ref.html", "testing/web-platform/tests/mathml/relations/css-styling/mathcolor-mathbackground-css.html", "testing/web-platform/tests/mathml/relations/css-styling/padding-border-margin/padding-border-margin-001-ref.html", "testing/web-platform/tests/mathml/relations/css-styling/padding-border-margin/padding-border-margin-002-ref.html", "testing/web-platform/tests/mathml/relations/css-styling/padding-border-margin/padding-border-margin-003-ref.html", "testing/web-platform/tests/mathml/relations/css-styling/transform-ref.html"], "git_node": "808af4d82e9fba377f080d98f8dd0c042e87a73d", "git_parents": ["33a7b92eedc018bf31a879479190e2962b35bba7"], "node": "50f8113342657b01fd5548d7ddefb3c8d01d533c", "parents": ["c7853537a4bac1c9fecd82e8351a968a8bcee2bc"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2079093 [wpt PR 63310] - Use JPEG XL intensity_target as the PQ content peak luminance, a=testonly\n\nAutomatic update from web-platform-tests\nUse JPEG XL intensity_target as the PQ content peak luminance\n\nA PQ JPEG XL was tone mapped from the 1000 cd/m2 default because the\ndecoder never reported HDR metadata, so plumb intensity_target out of\njxl-rs and report it as CLLI MaxCLL like the AVIF clli box.\n\nBug: 568825290\nChange-Id: Id299dced1b1ea2638cc8d10ae4831b116edfeeee\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8519837\nSLSA-Policy-Verified: SLSA Policy Verification Service \u003cdevtools-gerritcodereview-exitgate@google.com\u003e\nReviewed-by: Luca Versari \u003cveluca@google.com\u003e\nReviewed-by: Wan-Teh Chang \u003cwtc@google.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1712905}\n\n--\n\nwpt-commits: 6ef430e0f99c08c1f7e6f212b8e9de332d0035b4\nwpt-pr: 63310\n", "files": ["testing/web-platform/tests/jpegxl/hdr-pq-intensity-target.html", "testing/web-platform/tests/jpegxl/resources/generate_resources.sh", "testing/web-platform/tests/jpegxl/resources/pq_intensity_target_10000.jxl", "testing/web-platform/tests/jpegxl/resources/pq_intensity_target_600.jxl"], "git_node": "5021bc0b6124559709bd8df2f646469ca909f9cb", "git_parents": ["808af4d82e9fba377f080d98f8dd0c042e87a73d"], "node": "d9ceefdac981712f1d2323c72d32f743bf4be742", "parents": ["50f8113342657b01fd5548d7ddefb3c8d01d533c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079093 [wpt PR 63310] - Update wpt metadata, a=testonly\n\nwpt-pr: 63310\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/jpegxl/custom-primaries-icc-overflow-crash.html.ini", "testing/web-platform/meta/jpegxl/hdr-pq-intensity-target.html.ini", "testing/web-platform/meta/jpegxl/incomplete-codestream-trailing-box-crash.html.ini"], "git_node": "ae1dfc67465fb2b8fe56b917cffa5bd9e182f4d8", "git_parents": ["5021bc0b6124559709bd8df2f646469ca909f9cb"], "node": "391a688c008c637c377689b57f44255d3e2a859d", "parents": ["d9ceefdac981712f1d2323c72d32f743bf4be742"], "tags": []}, {"author": "Rahim Abdi \u003cabdi.abdirahim@gmail.com\u003e", "branch": "default", "desc": "Bug 1873104 [wpt PR 43859] - Update html-aam/roles-contextual.html with \u003csummary\u003e tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate html-aam/roles-contextual.html with \u003csummary\u003e tests (#43859)\n\nCo-authored-by: Rahim Abdi\nCo-authored-by: Scott O'Hara\n--\n\nwpt-commits: 4f6401cda49e7622832d3fd9652dceec65731d5b\nwpt-pr: 43859\n", "files": ["testing/web-platform/tests/html-aam/roles-contextual.html", "testing/web-platform/tests/html-aam/roles.html", "testing/web-platform/tests/html-aam/summary.html"], "git_node": "34fee3d8436b9146f8dd253591dbdcfdbc221d78", "git_parents": ["ae1dfc67465fb2b8fe56b917cffa5bd9e182f4d8"], "node": "5945452c26bd24bfad92ca528f31d285fe3bbf7e", "parents": ["391a688c008c637c377689b57f44255d3e2a859d"], "tags": []}, {"author": "Scott Haseley \u003cshaseley@chromium.org\u003e", "branch": "default", "desc": "Bug 2079261 [wpt PR 63329] - ElementTiming: \"Commit\" ElementTiming entries at paint time, a=testonly\n\nAutomatic update from web-platform-tests\nElementTiming: \"Commit\" ElementTiming entries at paint time\n\nThis CL unifies emitting text and image element timing entries and\nensures we emit entries based on paint-time criteria, as opposed to\nfiltering at presentation, which we were doing for text but not images.\nThis changes things to capture the navigation ID at paint time, rather\nthan at presentation time.\n\nThis is a step towards creating all paint timing entries at paint time.\nseparating this part off and using ElementTimingInfo allows us to\ndecouple both splitting off ContainerTiming into its own client and\nmigrating LCP/ICP to committing to entries at paint time. In the next\npatch, we'll do the LCP/ICP migration and change OnPaintFinished() to\nreturn a callback, which for ElementTiming, will own/manage the list of\nElementTimingInfos (removing it from PaintTiming).\n\nBug: 454082773\nChange-Id: I929355e7bc4cc24c4c6db043f40a4a8d190eeb82\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8412502\nReviewed-by: Michal Mocny \u003cmmocny@chromium.org\u003e\nCommit-Queue: Scott Haseley \u003cshaseley@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712941}\n\n--\n\nwpt-commits: b518aa953e38356bc4bc92990e96d0587d3f33f2\nwpt-pr: 63329\n", "files": ["testing/web-platform/tests/soft-navigation-heuristics/dropped-entries.tentative.html", "testing/web-platform/tests/soft-navigation-heuristics/largest-painted-element-dynamic-change.tentative.html", "testing/web-platform/tests/soft-navigation-heuristics/largest-painted-element-multiple-paints-before-url.tentative.html", "testing/web-platform/tests/soft-navigation-heuristics/largest-painted-element-paint-first.tentative.html", "testing/web-platform/tests/soft-navigation-heuristics/largest-painted-element-url-first.tentative.html", "testing/web-platform/tests/soft-navigation-heuristics/resources/soft-navigation-helper.js", "testing/web-platform/tests/soft-navigation-heuristics/softnav-after-lcp-paint-larger-than-viewport.tentative.html", "testing/web-platform/tests/soft-navigation-heuristics/softnav-after-lcp-paint.tentative.html"], "git_node": "89414e064108414cc932435504213afdaeaf3bde", "git_parents": ["34fee3d8436b9146f8dd253591dbdcfdbc221d78"], "node": "af591f6fc46cb9e169ac42d8e04a7becfd01d00f", "parents": ["5945452c26bd24bfad92ca528f31d285fe3bbf7e"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2079140 [wpt PR 63314] - [html-in-canvas] Privacy preserving paint -\u003e read-back allowed rendering, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Privacy preserving paint -\u003e read-back allowed rendering\n\nThis patch updates \"privacy-preserving painting\" to \"read-back allowed\nrendering\". Specifically:\n* Renames `PaintFlag::kPrivacyPreserving` to\n  `PaintFlag::kReadBackAllowedRendering`.\n* Renames `PaintInfo::IsPrivacyPreserving()` to\n  `PaintInfo::IsReadBackAllowedRendering()`.\n* Renames `preserve_privacy` parameters in `HighlightStyleUtils` to\n  `is_read_back_allowed_rendering`.\n* Updates `paint/README.md`, code comments, and `draw-element-image` /\n  `drawElementImage` WPT test assertions and comments.\n\nFixed: 568010580\nChange-Id: If2064c987ef8b30960c9851c8729dcfe0ff7b03e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8517121\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712971}\n\n--\n\nwpt-commits: d9b949e562d5064aa1cab263dcfb678139646766\nwpt-pr: 63314\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/selection-alone-with-decorations-painted.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/selection-colors-default.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/selection-painted-overlay-path.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-mask-visited.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/target-text-ignored-overlay-path.tentative.html"], "git_node": "ff9a67e72f83eb819b7a3205d029fbf6f1255cf4", "git_parents": ["89414e064108414cc932435504213afdaeaf3bde"], "node": "f040f28768dcb49673294f21b26ea1fbb6f9ddea", "parents": ["af591f6fc46cb9e169ac42d8e04a7becfd01d00f"], "tags": []}, {"author": "Alan Cutter \u003calancutter@google.com\u003e", "branch": "default", "desc": "Bug 2079274 [wpt PR 63338] - Fix invalid assumption that CSS column-rule and row-rule composite onto the same length values, a=testonly\n\nAutomatic update from web-platform-tests\nFix invalid assumption that CSS column-rule and row-rule composite onto the same length values\n\nThis CL fixes a crash when compositing one of the following CSS\nproperty animations onto an underlying value of a different length:\n- column-rule-color\n- column-rule-width\n- row-rule-color\n- row-rule-width\n\nThe lists are repeated to a lowest common multiple according to:\nhttps://drafts.csswg.org/web-animations-1/#repeatable-list\n\nBug: b:567429681\nChange-Id: I2be3e284c2b231c8beb8303d079f469e10d40752\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8521018\nReviewed-by: Alan Cutter \u003calancutter@chromium.org\u003e\nCommit-Queue: Alan Cutter \u003calancutter@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1712991}\n\n--\n\nwpt-commits: bb7e2aa4dcf896097bd3672b0af9b478b1ab3305\nwpt-pr: 63338\n", "files": ["testing/web-platform/tests/css/css-gaps/animation/rule-color-accumulation-auto-repeaters.html", "testing/web-platform/tests/css/css-gaps/animation/rule-width-accumulation-auto-repeaters.html"], "git_node": "3c100460d4aa1aa5f25547611d630195810f26da", "git_parents": ["ff9a67e72f83eb819b7a3205d029fbf6f1255cf4"], "node": "8f24cead4bb8f725ee21f4499405e70346831382", "parents": ["f040f28768dcb49673294f21b26ea1fbb6f9ddea"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079274 [wpt PR 63338] - Update wpt metadata, a=testonly\n\nwpt-pr: 63338\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/animation/rule-color-accumulation-auto-repeaters.html.ini", "testing/web-platform/meta/css/css-gaps/animation/rule-width-accumulation-auto-repeaters.html.ini"], "git_node": "d6337e3e2c3a501cc852ed48ee69dd10b36c298c", "git_parents": ["3c100460d4aa1aa5f25547611d630195810f26da"], "node": "a812a9e58521b917958db23a1870272d0562a6aa", "parents": ["8f24cead4bb8f725ee21f4499405e70346831382"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079276 [wpt PR 63341] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326462, a=testonly\n\nAutomatic update from web-platform-tests\nelement.dataset named getter matches non-data-* attributes and invalid property names (#63341)\n\nThis patch aligns WebKit with Gecko / Firefox.\n\nDatasetDOMStringMap's single-attribute fast path stripped the first five\ncharacters of any attribute name without checking for the \"data-\" prefix,\nso \u003cdiv aria-label=x\u003e exposed dataset.label === \"x\". The multi-attribute\npath converted the property name to an attribute name without validating\nit, so dataset[\"foo-bar\"] matched data-foo-bar.\n\nCheck isValidAttributeName() in the fast path and isValidPropertyName()\nin the multi-attribute path, in both item() and isSupportedPropertyName().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326462\nWebKit-Canonical-Link: https://commits.webkit.org/322936@main\n--\n\nwpt-commits: 4bbd5334824407ad7073237e435b93df55437023\nwpt-pr: 63341\n", "files": ["testing/web-platform/tests/html/dom/elements/global-attributes/dataset-get-invalid-names.html"], "git_node": "5cc9e4c20bf3aa3ce4165e65647494b28adc2aa5", "git_parents": ["d6337e3e2c3a501cc852ed48ee69dd10b36c298c"], "node": "0427de00f9c36d83d285516d198d274c4d407223", "parents": ["a812a9e58521b917958db23a1870272d0562a6aa"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079278 [wpt PR 63339] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326527, a=testonly\n\nAutomatic update from web-platform-tests\nIncorrect box size when padding change is followed by another style change before layout (#63339)\n\n\u003cdiv style=\"width: 200px\"\u003e\n    \u003cdiv id=\"container\"\u003e\u003cdiv style=\"height: 100px\"\u003e\u003c/div\u003e\u003c/div\u003e\n  \u003c/div\u003e\n  \u003cscript\u003e\n    container.style.paddingRight = \"100px\";\n    getComputedStyle(container).color;\n    container.style.color = \"blue\";\n  \u003c/script\u003e\n\nThe child should shrink to 100px. Instead it kept its 200px width.\n\nThe second style change calls setShouldForceRelayoutChildren(false) overriding setShouldForceRelayoutChildren(true) set by the initial (padding) change.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326527\nWebKit-Canonical-Link: https://commits.webkit.org/322929@main\n\nCo-authored-by: Alan Baradlay \u003czalan@apple.com\u003e\n--\n\nwpt-commits: a143ac31cb4fb17f14b54a7103ebab5228bdf8d9\nwpt-pr: 63339\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/dynamic-padding-change-with-style-update-before-layout.html"], "git_node": "3dd46210696c5278d310321ff859916352be9b28", "git_parents": ["5cc9e4c20bf3aa3ce4165e65647494b28adc2aa5"], "node": "111cb3e7f1e4ba17f0eddd1b900e63779e8b758c", "parents": ["0427de00f9c36d83d285516d198d274c4d407223"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079278 [wpt PR 63339] - Update wpt metadata, a=testonly\n\nwpt-pr: 63339\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/CSS2/normal-flow/crashtests/block-in-inline-ax-crash.html.ini"], "git_node": "33bc03069801b97effca9a36ea58a2be579ea931", "git_parents": ["3dd46210696c5278d310321ff859916352be9b28"], "node": "564ed8f3d322973cb7637983a185e470dc93d1b8", "parents": ["111cb3e7f1e4ba17f0eddd1b900e63779e8b758c"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2078963 [wpt PR 63306] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326476, a=testonly\n\nAutomatic update from web-platform-tests\nDetermine whether a document is a secure context when it is created\n\nDocument::isSecureContext() walked the frame tree on every call. With site\nisolation it could only see the origin of a frame in another process, which\nis opaque for a sandboxed frame, so a frame nested in a sandboxed cross-site\niframe was not a secure context. And a provisional frame is not in the frame\ntree yet, which needed a workaround.\n\nA document now determines this once, in initSecurityContext(): it is a secure\ncontext if its parent frame is and its own origin is potentially trustworthy.\nA document that inherits its origin inherits this from its owner too, like\nCOEP and Document-Isolation-Policy. DocumentSecurityPolicy carries the result,\nso other processes receive it the same way they receive COEP. The UI process\nseeds a new frame with its creator's state for its initial about:blank document.\n\nA document whose frame is removed now keeps its state. Before, it was always a\nsecure context.\n\nDedicated workers now inherit their creator's state instead of checking their\ntop-level origin, as HTML requires. Service workers are always secure contexts.\nShared workers keep checking their top-level origin, which is part of their key.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326476\n\n--\n\nwpt-commits: b102264996bf739f0ced7199b049c65b85b40ee7\nwpt-pr: 63306\n", "files": ["testing/web-platform/tests/secure-contexts/detached-iframe.html", "testing/web-platform/tests/secure-contexts/sandboxed-iframe-child.https.html", "testing/web-platform/tests/secure-contexts/support/iframe-with-child.html"], "git_node": "819f6445faa8e3c020a6e865ac3f8814ee4e9564", "git_parents": ["33bc03069801b97effca9a36ea58a2be579ea931"], "node": "860f94f1344f437a53c4b19f8978eca86b541185", "parents": ["564ed8f3d322973cb7637983a185e470dc93d1b8"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2079292 [wpt PR 63342] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=278868, a=testonly\n\nAutomatic update from web-platform-tests\n[SVG2] Remove `*Glyph*` support (#63342)\n\nSVG 2 removed altGlyph, altGlyphDef, altGlyphItem and glyphRef, and\ndropped SVG fonts with glyph and missing-glyph.\nhttps://w3c.github.io/svgwg/svg2-draft/changes.html#text\nhttps://w3c.github.io/svgwg/svg2-draft/changes.html#fonts\n\nTheir JavaScript interfaces were already removed in 255702@main. This\nremoves the six C++ classes behind them.\n\nThe only visible change is altGlyph. WebKit drew its text as a tspan.\nFirefox and Chrome draw nothing. SVG 2 says an element inside text\nthat is not a text content child or an a element has display: none.\nhttps://w3c.github.io/svgwg/svg2-draft/text.html#TextLayoutAlgorithm\n\nThe tag names stay in svgtags.in as SVGUnknownElement, as done for\nanimateColor in 276683@main. The HTML parser still needs them to fix\nthe case of altGlyph, altGlyphDef, altGlyphItem and glyphRef, and\nmissing-glyph is still a reserved custom element name.\n\nSVG fonts keep working. The SVG to OpenType converter now finds glyph\nand missing-glyph by tag name instead of by class, which selects the\nsame elements as before.\n\nTests about altGlyph itself are removed, and so is a glyphRef crash\ntest whose class no longer exists. Two text layout crash tests use\ntspan instead of altGlyph, which ran the same renderer.\n\nThe new test is marked flaky on mac: EWS sometimes captures a blank\nwhite snapshot, of the test or of its reference.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=278868\nWebKit-Canonical-Link: https://commits.webkit.org/322845@main\n--\n\nwpt-commits: 51dab792c1d34fe0279b427c0c00c808fb2ffd4b\nwpt-pr: 63342\n", "files": ["testing/web-platform/tests/svg/text/reftests/text-unknown-element-not-rendered-expected.svg", "testing/web-platform/tests/svg/text/reftests/text-unknown-element-not-rendered-ref.svg", "testing/web-platform/tests/svg/text/reftests/text-unknown-element-not-rendered.svg"], "git_node": "517c9f652d3fbf536ae08140d4c351b25c7c57de", "git_parents": ["819f6445faa8e3c020a6e865ac3f8814ee4e9564"], "node": "7cd9abe1139e5c3bc2ef0d628f29fcd42dd6294f", "parents": ["860f94f1344f437a53c4b19f8978eca86b541185"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2079295 [wpt PR 63343] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326338, a=testonly\n\nAutomatic update from web-platform-tests\n[LBSE] Re-layout \u003ctextPath\u003e when its pending target path appears (#63343)\n\nWhen a \u003ctextPath\u003e references a missing id, it registers as a pending\nresource. Once an element with that id appears, buildPendingResource()\nresolves the target, but in LBSE it returned early without invalidating\nthe renderer, so the text was never laid out along the path.\n\nRequest the renderer update via updateSVGRendererForElementChange() for\nboth engines. RenderTreeUpdater::updateSVGRenderer() already performs the\nengine-specific invalidation.\n\nsvg/text/adding-id-on-pending-path.html only covers resolving a pending\n\u003ctextPath\u003e target by setting an id on an existing path. Add reftests that\ninsert the referenced path, remove and re-add it, and change href to\nanother existing path.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326338\nWebKit-Canonical-Link: https://commits.webkit.org/322884@main\n\nCo-authored-by: Nikolas Zimmermann \u003cnzimmermann@igalia.com\u003e\n--\n\nwpt-commits: d09b0bc7eabb648ab7c8dc2807b9db3d24b44c65\nwpt-pr: 63343\n", "files": ["testing/web-platform/tests/svg/text/reftests/textpath-dynamic-href-change-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-dynamic-href-change.svg", "testing/web-platform/tests/svg/text/reftests/textpath-dynamic-insert-target-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-dynamic-insert-target.svg", "testing/web-platform/tests/svg/text/reftests/textpath-dynamic-remove-readd-target-expected.svg", "testing/web-platform/tests/svg/text/reftests/textpath-dynamic-remove-readd-target.svg", "testing/web-platform/tests/svg/text/reftests/textpath-dynamic-target-ref.svg"], "git_node": "a7bd15644be9bfd4b7a5e09d5726235dc33ae68c", "git_parents": ["517c9f652d3fbf536ae08140d4c351b25c7c57de"], "node": "d422d795d713b3d806a95b09c421e5885936f645", "parents": ["7cd9abe1139e5c3bc2ef0d628f29fcd42dd6294f"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2079300 [wpt PR 63351] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326631, a=testonly\n\nAutomatic update from web-platform-tests\nWPT: drop .tentative from the SVG list getItem identity tests (#63351)\n\nThe three tests added in bug 323065 were .tentative while\nhttps://github.com/w3c/svgwg/issues/1169 was open. SVG 2 now states\nthe requirement in the List interfaces preamble (#ListItemIdentity),\nso they lose the suffix and point at it. No subtest changes; the\nbaselines are renamed as they are.\n\nAlso corrects a comment in SameObject-identity.html that said\nSVGTransformList.getItem is not required to return the same object.\n\nThis will be exported to WPT.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326631\nWebKit-Canonical-Link: https://commits.webkit.org/322960@main\n--\n\nwpt-commits: a496f98e5c6fd13c24084443f872f7219946f31e\nwpt-pr: 63351\n", "files": ["testing/web-platform/tests/svg/types/SameObject-identity.html", "testing/web-platform/tests/svg/types/scripted/SVGList-getItem-identity.html", "testing/web-platform/tests/svg/types/scripted/SVGList-getItem-identity.tentative.html", "testing/web-platform/tests/svg/types/scripted/SVGList-identity-across-attribute-change.html", "testing/web-platform/tests/svg/types/scripted/SVGList-identity-across-attribute-change.tentative.html", "testing/web-platform/tests/svg/types/scripted/SVGList-mutator-return-identity.html", "testing/web-platform/tests/svg/types/scripted/SVGList-mutator-return-identity.tentative.html"], "git_node": "b8a7f88342dc02f1bd9c22d7163146fa2424fe69", "git_parents": ["a7bd15644be9bfd4b7a5e09d5726235dc33ae68c"], "node": "4b12cf416d8f21047449cd6079488b54dc26d3de", "parents": ["d422d795d713b3d806a95b09c421e5885936f645"], "tags": []}, {"author": "Koji Ishii \u003ckojii@chromium.org\u003e", "branch": "default", "desc": "Bug 2079304 [wpt PR 63350] - [text-spacing-trim] Disable `LineBreakerHanKerningEnd`, a=testonly\n\nAutomatic update from web-platform-tests\n[text-spacing-trim] Disable `LineBreakerHanKerningEnd`\n\nThis patch disables the `LineBreakerHanKerningEnd` runtime\nflag for a crash issue reported in crbug.com/568304685; which\ninherently reverts the fix for crbug.com/542686223. The flag\nwas first enabled in M153.\n\nBug: 568304685, 542686223\nChange-Id: Ida52d89a92cdc8d7fde4284c1837ed6e7268af9b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8526428\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nAuto-Submit: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713171}\n\n--\n\nwpt-commits: 2e94ad1f44a0a2926ab72b7d92c48e6ad4550e07\nwpt-pr: 63350\n", "files": ["testing/web-platform/tests/css/css-text/text-spacing-trim/crashtests/text-spacing-trim-end-crash.html"], "git_node": "21edfb22dd9868ae473348838d15a1563161fa58", "git_parents": ["b8a7f88342dc02f1bd9c22d7163146fa2424fe69"], "node": "3bab34b2517a01d4ed2ef11ceec56bf4cdea5ffa", "parents": ["4b12cf416d8f21047449cd6079488b54dc26d3de"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2079308 [wpt PR 63344] - URL: searchParams must reflect the query after setting search, a=testonly\n\nAutomatic update from web-platform-tests\nURL: searchParams must reflect the query after setting search\n\nThe search setter removes ASCII tab or newline from its input before updating the query, so searchParams needs to reflect that as well, including when it was obtained before setting search.\n\nFor https://github.com/whatwg/url/issues/931.\n\n--\n\nwpt-commits: b1a3daad996272add733ff1c420bf48049a5b698\nwpt-pr: 63344\n", "files": ["testing/web-platform/tests/url/url-setters-stripping.any.js"], "git_node": "3f0f2709e71778cfdc3c86d338bae30b9e04c1f4", "git_parents": ["21edfb22dd9868ae473348838d15a1563161fa58"], "node": "8e8d69a8607fa3e40eaad0b83690d57ff7e21225", "parents": ["3bab34b2517a01d4ed2ef11ceec56bf4cdea5ffa"], "tags": []}, {"author": "Noam Rosenthal \u003cnoamr@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2054582 [wpt PR 61260] - Mark createParserOptions tests non-tentative, a=testonly\n\nAutomatic update from web-platform-tests\nMark createParserOptions tests non-tentative\n\nTogether with whatwg/html#12583\n--\n\nwpt-commits: 2e954fa1b216ce1332a74ec9901fa6e8cde6addf\nwpt-pr: 61260\n", "files": ["testing/web-platform/tests/sanitizer-api/parsehtmlunsafe-with-trustedtypes.html", "testing/web-platform/tests/sanitizer-api/parsehtmlunsafe-with-trustedtypes.tentative.html", "testing/web-platform/tests/sanitizer-api/sanitizer-base-immutable.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedhtml-createParserOptions.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedhtml-createParserOptions.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-null.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-null.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.html.headers", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.tentative.html.headers", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-createParserOptions.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-immutable.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes-immutable.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-trustedtypes.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer-report-only.html", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer-report-only.html.headers", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer-report-only.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer-report-only.tentative.html.headers", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer.html", "testing/web-platform/tests/sanitizer-api/sethtml-xml-document-sanitizer.tentative.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-default-createHTML.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-default-createHTML.tentative.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-default-createParserOptions.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-default-createParserOptions.tentative.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-no-enforcement.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-no-enforcement.tentative.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-report-only.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-report-only.html.headers", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-report-only.tentative.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options-report-only.tentative.html.headers", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options.html", "testing/web-platform/tests/sanitizer-api/trustedhtml-unvetted-parser-options.tentative.html"], "git_node": "49ac85d7708d85838bb054b060c77d115931b1e2", "git_parents": ["3f0f2709e71778cfdc3c86d338bae30b9e04c1f4"], "node": "ce4b03d5bd246b0cfb0617db36575630701a3600", "parents": ["8e8d69a8607fa3e40eaad0b83690d57ff7e21225"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054582 [wpt PR 61260] - Update wpt metadata, a=testonly\n\nwpt-pr: 61260\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/sanitizer-api/parsehtmlunsafe-with-trustedtypes.html.ini", "testing/web-platform/meta/sanitizer-api/parsehtmlunsafe-with-trustedtypes.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedhtml-createParserOptions.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-null.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes-createParserOptions-report-only.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes-createParserOptions.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes-immutable.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes-immutable.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-xml-document-sanitizer-report-only.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-xml-document-sanitizer.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-default-createHTML.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-default-createHTML.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-default-createParserOptions.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-default-createParserOptions.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-no-enforcement.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-no-enforcement.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-report-only.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options-report-only.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options.html.ini", "testing/web-platform/meta/sanitizer-api/trustedhtml-unvetted-parser-options.tentative.html.ini"], "git_node": "2ee27280160584693edf5046be436cb5d10846e5", "git_parents": ["49ac85d7708d85838bb054b060c77d115931b1e2"], "node": "83f527bd01fb92d668fd8f00dea06e8d122b5980", "parents": ["ce4b03d5bd246b0cfb0617db36575630701a3600"], "tags": []}, {"author": "Florian Rivoal \u003cgit@florian.rivoal.net\u003e", "branch": "default", "desc": "Bug 2079369 [wpt PR 63352] - Update syntax of line-clamp, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate syntax of line-clamp (#63352)\n\nSee https://github.com/w3c/csswg-drafts/issues/13670\n--\n\nwpt-commits: 561d0ad808e7dd13116d7bfd474e3b6c52cf8803\nwpt-pr: 63352\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-039.html", "testing/web-platform/tests/css/css-overflow/parsing/line-clamp-invalid.html", "testing/web-platform/tests/css/css-overflow/parsing/line-clamp-valid.html", "testing/web-platform/tests/css/css-overflow/parsing/max-lines-valid.html"], "git_node": "6fa8271ed3abc04578a8f28ec9ad9bbbce391cde", "git_parents": ["2ee27280160584693edf5046be436cb5d10846e5"], "node": "4b253917e692163736ddbac0aaafe0e5214898cb", "parents": ["83f527bd01fb92d668fd8f00dea06e8d122b5980"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079369 [wpt PR 63352] - Update wpt metadata, a=testonly\n\nwpt-pr: 63352\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/parsing/line-clamp-valid.html.ini"], "git_node": "9e980a70cc2f1c1c522d74a7666a90b156dd5a02", "git_parents": ["6fa8271ed3abc04578a8f28ec9ad9bbbce391cde"], "node": "283a8c5787fbc5b9165472b9c818c1b517ff80db", "parents": ["4b253917e692163736ddbac0aaafe0e5214898cb"], "tags": []}, {"author": "sb3nder \u003csb3nd3r@gmail.com\u003e", "branch": "default", "desc": "Bug 2074959 [wpt PR 62879] - Support `box-shadow: inset` in corner-shape ref rendering, and test when the radius exceeds `target_rect` dimensions., a=testonly\n\nAutomatic update from web-platform-tests\nSupport `box-shadow: inset` in corner-shape ref rendering, and test when the radius exceeds `target_rect` dimensions. (#62879)\n\n* Test borders where radius \u003e target_rect dimension\n\n* Add support for box-shadow: inset\n- Minor optimization by skipping drawing the border when possible.\n- Minor cleanup.\n\n* Test box-shadow: inset\n\n* Small clean up\n\n* use `willReadFrequently: true` to work around flaky `ctx.stroke(path)`\n--\n\nwpt-commits: d1fab511543785ca68e5e40f36aa7c0840af0b32\nwpt-pr: 62879\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/render-corner-shape.html", "testing/web-platform/tests/css/css-borders/corner-shape/resources/render-corner-shape.js"], "git_node": "79c70165c241cb51bf7f9c21582df480ab22c934", "git_parents": ["9e980a70cc2f1c1c522d74a7666a90b156dd5a02"], "node": "87fb41174e3f82f551079cc12e0211be716116fd", "parents": ["283a8c5787fbc5b9165472b9c818c1b517ff80db"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074959 [wpt PR 62879] - Update wpt metadata, a=testonly\n\nwpt-pr: 62879\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "194546ecb80d25698324d3e4df5f3dc23e1f2cd5", "git_parents": ["79c70165c241cb51bf7f9c21582df480ab22c934"], "node": "1af77f6e8e0f123013a8bc05c2851fbfb27a88c4", "parents": ["87fb41174e3f82f551079cc12e0211be716116fd"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2078854 [wpt PR 63300] - Decisions API: Add Blink IDL, Mojo interfaces, Echo impl, and WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nDecisions API: Add Blink IDL, Mojo interfaces, Echo impl, and WPTs (#63300)\n\nAdds the Blink WebIDL interface (`window.DecisionModel`), Mojo interfaces (`blink::mojom::AIDecisionModel`), UseCounter metrics, unit tests, //content echo implementation, and WPT for the Built-In AI Decisions API prototype. Exclude Android for now to avoid a binary size increase.\n\nExplainer: https://github.com/explainers-by-googlers/decisions-api\nBug: 565849508, 568193538\nChange-Id: I8a1c0d94b72e4f16a5308c92d174e60b5f39a101\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8499040\nCommit-Queue: Mike Wasserman \u003cmsw@chromium.org\u003e\nReviewed-by: Fred Shih \u003cffred@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Jaewon Lee \u003cjaeone@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1711873}\n\nCo-authored-by: Mike Wasserman \u003cmsw@chromium.org\u003e\n--\n\nwpt-commits: 123e9cf261ab3119dfbf9b6fac4cd9ca799dbf03\nwpt-pr: 63300\n", "files": ["testing/web-platform/tests/ai/decision-model/decision-model.tentative.https.window.js", "testing/web-platform/tests/ai/resources/util.js"], "git_node": "4b56dd77e56a327d22a9b3d502e1de422491249c", "git_parents": ["194546ecb80d25698324d3e4df5f3dc23e1f2cd5"], "node": "1fda8712307afc63d72304245b4c8d6886b29da3", "parents": ["1af77f6e8e0f123013a8bc05c2851fbfb27a88c4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078854 [wpt PR 63300] - Update wpt metadata, a=testonly\n\nwpt-pr: 63300\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/decision-model/decision-model.tentative.https.window.js.ini"], "git_node": "e9b8257f3d2bb2998a7c9cf141117cc58c7906af", "git_parents": ["4b56dd77e56a327d22a9b3d502e1de422491249c"], "node": "aff4bdb4d35cc980b7d827bfc2513eb58546d34e", "parents": ["1fda8712307afc63d72304245b4c8d6886b29da3"], "tags": []}, {"author": "Robert Flack \u003cflackr@chromium.org\u003e", "branch": "default", "desc": "Bug 2079451 [wpt PR 63358] - Fix pre-interpolation composition with mismatched underlying values, a=testonly\n\nAutomatic update from web-platform-tests\nFix pre-interpolation composition with mismatched underlying values\n\nWhen converting non-neutral additive or accumulative keyframes,\nInvalidatableInterpolation::MaybeConvertPairwise and\nConvertSingleKeyframe should only pass underlying_value_owner.Value() to\nwith a matching InterpolationType.\n\nThis fixes issues when animating a registered custom property whose\nunderlying value may be absent, or not convertible by any\nInterpolationType, or produced by a different InterpolationType.\n\nBug: 566496747\nChange-Id: Ide25c19ff4a63c8e000f90c26fcd4dc1a5b7bc65\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8521821\nCommit-Queue: Robert Flack \u003cflackr@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713374}\n\n--\n\nwpt-commits: e24bad712bf5b05bae3c517b71973089050797da\nwpt-pr: 63358\n", "files": ["testing/web-platform/tests/css/css-properties-values-api/animation/custom-property-animation-list-type-mismatch.html", "testing/web-platform/tests/css/css-properties-values-api/animation/custom-property-animation-transform-list-multiple-values.html"], "git_node": "9c6244e62abe65a729f8ce4ccc73b66567bca59b", "git_parents": ["e9b8257f3d2bb2998a7c9cf141117cc58c7906af"], "node": "be553049746c9f75f645f9da17825041f7ec280d", "parents": ["aff4bdb4d35cc980b7d827bfc2513eb58546d34e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079451 [wpt PR 63358] - Update wpt metadata, a=testonly\n\nwpt-pr: 63358\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-properties-values-api/animation/custom-property-animation-list-type-mismatch.html.ini"], "git_node": "aa241fdeb5d0338c2bd7e97359fe0de2e4909985", "git_parents": ["9c6244e62abe65a729f8ce4ccc73b66567bca59b"], "node": "16cea45373adaaa186c73e59e25e87bc31ce8321", "parents": ["be553049746c9f75f645f9da17825041f7ec280d"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077421 [wpt PR 63185] - Add tests for popovers moving across documents, a=testonly\n\nAutomatic update from web-platform-tests\nAdd tests for popovers moving across documents\n\nFor https://github.com/whatwg/html/pull/13001\n--\n\nwpt-commits: 9f8310d123a408e0c6adba3ad1043cbcac61b337\nwpt-pr: 63185\n", "files": ["testing/web-platform/tests/html/semantics/popovers/popover-hide-inactive-document.html", "testing/web-platform/tests/html/semantics/popovers/popover-move-documents-during-hide.html", "testing/web-platform/tests/html/semantics/popovers/popover-removal-hides.html"], "git_node": "60786b608239e3395496e748e41989717a045bf9", "git_parents": ["aa241fdeb5d0338c2bd7e97359fe0de2e4909985"], "node": "8d7fb3a0337b3aba188b4f02feb44dcab18adbed", "parents": ["16cea45373adaaa186c73e59e25e87bc31ce8321"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077421 [wpt PR 63185] - Update wpt metadata, a=testonly\n\nwpt-pr: 63185\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/popovers/popover-hide-inactive-document.html.ini", "testing/web-platform/meta/html/semantics/popovers/popover-move-documents-during-hide.html.ini"], "git_node": "7771bd80a39084c3bd28278dbdc8cac1a69e59e5", "git_parents": ["60786b608239e3395496e748e41989717a045bf9"], "node": "858c81aa5e2483de60164442b2c491d6cf3002db", "parents": ["8d7fb3a0337b3aba188b4f02feb44dcab18adbed"], "tags": []}, {"author": "Peng Zhou \u003cpengzhou@chromium.org\u003e", "branch": "default", "desc": "Bug 2079462 [wpt PR 63359] - [HitTest] Check negative z-index children before line box fallback, a=testonly\n\nAutomatic update from web-platform-tests\n[HitTest] Check negative z-index children before line box fallback\n\nWhen foreground hit testing finds no child hit within a line box, it\nfalls back to the container. For a stacking context, this happens before\nits negative `z-index` children are hit tested, even when the line box\npaints nothing above them. For example, a positioned input with\n`z-index:-1` can become unclickable.\n\nDefer the line box fallback to the self block background phase when the\ncontainer has negative z-index children, allowing those children to be\nhit first. Keep the foreground fallback for line boxes using\n`::first-line` styles.\n\nPaintLayer does not apply the container's own overflow clip in the\nbackground phase, so explicitly check it before the deferred line box\nhit.\n\nBug: 41151682\nChange-Id: Ibc31fc6e40865e43049a40474793375906f154dd\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8495466\nCommit-Queue: Peng Zhou \u003cpengzhou@chromium.org\u003e\nReviewed-by: Xianzhu Wang \u003cwangxianzhu@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713404}\n\n--\n\nwpt-commits: 0d60546cfc4919d9a57ca39783ae4ffed827e966\nwpt-pr: 63359\n", "files": ["testing/web-platform/tests/css/cssom-view/elementFromPoint-negative-z-index-inline-overflow-clip.html", "testing/web-platform/tests/css/cssom-view/elementFromPoint-negative-z-index-inline.html"], "git_node": "2a01728eba9a7cc99037fb633b2611b10ae8147f", "git_parents": ["7771bd80a39084c3bd28278dbdc8cac1a69e59e5"], "node": "542e81c26d1f2a231d495bf6a9be729c6064977f", "parents": ["858c81aa5e2483de60164442b2c491d6cf3002db"], "tags": []}, {"author": "Hubert Chao \u003chchao@chromium.org\u003e", "branch": "default", "desc": "Bug 2079467 [wpt PR 63357] - Enforce CORS in Background Fetch, a=testonly\n\nAutomatic update from web-platform-tests\nEnforce CORS in Background Fetch\n\nPreviously, the DownloadService previously defaulted all fetch requests\nto `kNavigate` (which bypasses CORS). This CL updates the Background\nFetch delegate to pass the original fetch request mode down to the\nDownloadService, so that the network service can correctly enforce CORS\nchecks on Background Fetch requests.\n\nThis additionally updates the proto serialization to persist the request\nmode across browser restarts, and modify testing handlers to ensure the\nCORS enforcement properly blocks requests that lack required\nAccess-Control headers. The browser tests have been updated to initiate\nthese fetches from the Window context instead of the Service Worker to\nsidestep `kRestrictBackgroundFetchFromServiceWorker` restrictions.\n\nAdditionally, to prevent old suspended downloads from resuming and\nbypassing CORS after the browser updates, EntryFromProto explicitly\nupgrades the request mode to kCors if the fetch_request_mode is missing\nand the client is BACKGROUND_FETCH.\n\nThe CORS enforcement and legacy proto upgrade logic are gated behind a\nnew `kBackgroundFetchCorsEnforcement` feature kill switch.\n\nTAG=agy\nCONV=96c12324-004c-4da1-bec2-9436ea828a56\n\nBug: 515243254, 496008447, 495903812, 485855931, 40059500, 500171457, 498000798\nChange-Id: I1dc5266d08c20c23ee56340a3c20b7b988befb59\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8103044\nReviewed-by: Colin Blundell \u003cblundell@chromium.org\u003e\nReviewed-by: Yoshisato Yanagisawa \u003cyyanagisawa@chromium.org\u003e\nCommit-Queue: Hubert Chao \u003chchao@chromium.org\u003e\nReviewed-by: Camille Lamy \u003cclamy@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713422}\n\n--\n\nwpt-commits: 9d21f67a7c5991a892d368c28664100a13b6ca04\nwpt-pr: 63357\n", "files": ["testing/web-platform/tests/background-fetch/fetch.https.window.js"], "git_node": "29bb5b5b24ae1b28e1ecd0cac1335c2ed9abafb8", "git_parents": ["2a01728eba9a7cc99037fb633b2611b10ae8147f"], "node": "69589749d028fbae941454985e62dc129311d03e", "parents": ["542e81c26d1f2a231d495bf6a9be729c6064977f"], "tags": []}, {"author": "Hubert Chao \u003chchao@chromium.org\u003e", "branch": "default", "desc": "Bug 2079471 [wpt PR 63356] - Address various Background Fetch CORS issues, a=testonly\n\nAutomatic update from web-platform-tests\nAddress various Background Fetch CORS issues\n\nThis CL expands test coverage and fixes lingering response type and\nheader exposure bugs resolved by moving Background Fetch away from\nRequestMode::kNavigate to standard RequestMode::kCors enforcement, and\nexpands test coverage.\n\nSpecifically:\n\n- Fixes response type assignment in\n  MarkRequestCompleteTask::StoreResponse by dynamically assigning\n  FetchResponseType::kCors when the response URL origin differs from\n  the registration's initiator origin (instead of hardcoding\n  kDefault). This ensures JavaScript Response objects enforce\n  strict CORS exposed-header filtering (Access-Control-Expose-Headers)\n  and correctly mark response types as 'cors'.\n- Adds browser tests verifying CORS restrictions across redirect\n  chains (FailsOnCrossOriginRedirectWithoutCorsHeaders,\n  SucceedsOnCrossOriginRedirectWithCorsHeaders).\n- Adds browser tests verifying CORS OPTIONS preflight blocking on\n  custom request headers (FailsWithCustomHeaderWithoutPreflight).\n- Adds browser tests verifying accurate credentials mode plumbing and\n  wildcard origin constraints\n  (FailsWithCredentialsIncludeAgainstWildcardOrigin,\n  SucceedsWithCredentialsOmitAgainstWildcardOrigin).\n- Adds browser tests verifying JavaScript response record encapsulation\n  (CrossOriginResponseTypeIsCors, NonCorsExposedHeaderNotExposed).\n- Introduces standardized Web Platform Test (WPT) suite under\n  external/wpt/background-fetch/cors.https.window.js verifying\n  interoperable CORS behaviors (preflights, response types, exposed\n  headers, credentials).\n\nTAG=agy\nCONV=f978795a-c003-44c4-b9c9-28b4678a1f95\n\nFixed: 496008447, 495903812, 485855931, 40059500, 500171457, 498000798\nBug: 515243254\nChange-Id: I1ab48bc2a63aaaf9bc2e9ea480f062428416ff61\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8125729\nReviewed-by: Yoshisato Yanagisawa \u003cyyanagisawa@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Camille Lamy \u003cclamy@chromium.org\u003e\nCommit-Queue: Hubert Chao \u003chchao@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713427}\n\n--\n\nwpt-commits: 0535fe6a3b64933d80e10e49d712067288ad5908\nwpt-pr: 63356\n", "files": ["testing/web-platform/tests/background-fetch/cors.https.window.js", "testing/web-platform/tests/background-fetch/resources/cors-resource.txt", "testing/web-platform/tests/background-fetch/resources/cors-resource.txt.headers", "testing/web-platform/tests/background-fetch/service_workers/sw-cors.js"], "git_node": "9377e3465f254f1030cef9b1ad426cf0dea2cad4", "git_parents": ["29bb5b5b24ae1b28e1ecd0cac1335c2ed9abafb8"], "node": "9e40278b67b112e134381cceddfc6f8b4c10b040", "parents": ["69589749d028fbae941454985e62dc129311d03e"], "tags": []}, {"author": "Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e", "branch": "default", "desc": "Bug 2079477 [wpt PR 63348] - [scroll-anchor] Change ScrollAnchor to hold a WeakMember to the anchor., a=testonly\n\nAutomatic update from web-platform-tests\n[scroll-anchor] Change ScrollAnchor to hold a WeakMember to the anchor.\n\nPreviously ScrollAnchor held a strong reference to the appropriate\nLayoutObject which was the scroll-anchor.\n\nWhen an object was removed from the tree, it'd check if itself was a\nscroll-anchor, and remove itself as appropriate.\n\nWe have various cases now where we may remove a sub-tree (which would\nonly call WillBeRemovedFromTree for the top level node in the tree).\n\nThese cases would leave a potentially invalid scroll-anchor, triggering\neither a nullptr exception or a destroyed DCHECK.\n\nThe subtree was removed, then potentially destroyed, and the destroyed\nnested object would never clear itself from the ScrollAnchor.\n\nSwitch ScrollAnchor to store a WeakMember\u003cLayoutObject\u003e instead. We can\nremove all the (relatively) complex book-keeping when we remove these\nobjects.\n\nBug: 511985285\nChange-Id: Ie0b10e64a57a4880b2b2fc5b67c985834347eea4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8524255\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713437}\n\n--\n\nwpt-commits: 6d31d292a6e64568db514c197b7415684991534d\nwpt-pr: 63348\n", "files": ["testing/web-platform/tests/css/css-scroll-anchoring/anonymous-block-children-crash.html"], "git_node": "8465d5b2c7dc98159078153accd259434e495355", "git_parents": ["9377e3465f254f1030cef9b1ad426cf0dea2cad4"], "node": "a916ed320a64a925bbc31e5ee0cf5d9f666077ed", "parents": ["9e40278b67b112e134381cceddfc6f8b4c10b040"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079477 [wpt PR 63348] - Update wpt metadata, a=testonly\n\nwpt-pr: 63348\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-scroll-anchoring/anonymous-block-children-crash.html.ini"], "git_node": "774227fd6d4f984fbe7e8e1a0983256f3a5c39c5", "git_parents": ["8465d5b2c7dc98159078153accd259434e495355"], "node": "80039cf074fd15ea074727534c3e9c7d2adbfe18", "parents": ["a916ed320a64a925bbc31e5ee0cf5d9f666077ed"], "tags": []}, {"author": "Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e", "branch": "default", "desc": "Bug 2079480 [wpt PR 63360] - [css-mixins] Add WPT for function property context, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Add WPT for function property context\n\nBlink behavior already matches the CSSWG resolution.\nfunction-relative-units.html tests the \"element\" portion of the calling\ncontext, but there was no WPT coverage for the \"property\" portion.\n\nThis CL adds the missing coverage, using font-size and border-left-width\nto distinguish the applicable property context.\n\nFixed: 552969806\nChange-Id: I2b5acc9a2508ca7d8ac3d7d383ad407147a2569c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8519531\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1713445}\n\n--\n\nwpt-commits: 0528c911eb6d4bcd5a8d0b554bad445a9775f383\nwpt-pr: 63360\n", "files": ["testing/web-platform/tests/css/css-mixins/function-property-context.html"], "git_node": "a4536d51dc24cbbbba1ffde91b62a710c61e3209", "git_parents": ["774227fd6d4f984fbe7e8e1a0983256f3a5c39c5"], "node": "9bf9d99489bed0fa046f494ad8ed309374a2fca7", "parents": ["80039cf074fd15ea074727534c3e9c7d2adbfe18"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079480 [wpt PR 63360] - Update wpt metadata, a=testonly\n\nwpt-pr: 63360\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/function-property-context.html.ini"], "git_node": "4c9a14d0c857853880fb6252241a51d367c50be3", "git_parents": ["a4536d51dc24cbbbba1ffde91b62a710c61e3209"], "node": "35a1799b4f56b0c27bad7c4237620d93e8f40a83", "parents": ["9bf9d99489bed0fa046f494ad8ed309374a2fca7"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2079483 [wpt PR 63363] - Handle re-entrancy in \u003ctemplate for\u003e, a=testonly\n\nAutomatic update from web-platform-tests\nHandle re-entrancy in \u003ctemplate for\u003e\n\nMake sure we throw when document.write() happens inside a pagehide\nthat was instantiated by \u003ctemplate for\u003e node removal.\n\nBug: 570738038\nChange-Id: Ie643919fb00db9efe87e08fcb4866b70177bc7db\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8525050\nReviewed-by: Philip J\u00e4genstedt \u003cfoolip@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1713453}\n\n--\n\nwpt-commits: 130cfe2be02da19e24333f48430c91049a5d6b3e\nwpt-pr: 63363\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-template-element/template-for/template-for-pagehide-dynamic-markup-insertion.html"], "git_node": "4a2897e9c9b54d80ec807403dd4cc485d50e19cb", "git_parents": ["4c9a14d0c857853880fb6252241a51d367c50be3"], "node": "5524e47f1e7b22cd60420e9ebb6f01d756b3c593", "parents": ["35a1799b4f56b0c27bad7c4237620d93e8f40a83"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079483 [wpt PR 63363] - Update wpt metadata, a=testonly\n\nwpt-pr: 63363\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-pagehide-dynamic-markup-insertion.html.ini"], "git_node": "567578b06c826cb8a5d7985dd45adcc54592f402", "git_parents": ["4a2897e9c9b54d80ec807403dd4cc485d50e19cb"], "node": "c50b2c82961f352fe37efc88d87c8f1bea912766", "parents": ["5524e47f1e7b22cd60420e9ebb6f01d756b3c593"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079488 [wpt PR 63346] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326468, a=testonly\n\nAutomatic update from web-platform-tests\nDataTransfer treats any format starting with \"text/plain\" (e.g. \"text/plainfoo\") as text/plain (#63346)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nnormalizeType() mapped every format that started with \"text/plain\" to text/plain,\nbecause the check had no \";\". As a result, setData(\"text/plainfoo\", ...) overwrote\nthe text/plain item, getData(\"text/plainfoo\") returned the text/plain data, and\nclearData(\"text/plainfoo\") removed text/plain.\n\nThe HTML spec only normalizes the exact strings \"text\" and \"url\". This patch\nmatches \"text/plain\" exactly, or requires a \";\" after \"text/plain\", the same way\nthe text/uri-list and text/html checks next to it already do. This matches Blink.\nFormats with MIME parameters, such as \"text/plain;charset=utf-8\", still map to\ntext/plain.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326468\nWebKit-Canonical-Link: https://commits.webkit.org/322954@main\n--\n\nwpt-commits: 505c2ae9287ce38ef536652f040f4c80e3ade0e3\nwpt-pr: 63346\n", "files": ["testing/web-platform/tests/html/editing/dnd/datastore/datatransfer-text-plain-prefix-format.html"], "git_node": "0d82965a21302ed7cbd7aae8b7fec33ec73e7a77", "git_parents": ["567578b06c826cb8a5d7985dd45adcc54592f402"], "node": "ffddee5c12df9e92c33803b40c5481c12b1a7f21", "parents": ["c50b2c82961f352fe37efc88d87c8f1bea912766"], "tags": []}, {"author": "Steve Becker \u003cstevebe@microsoft.com\u003e", "branch": "default", "desc": "Bug 2079587 [wpt PR 63362] - [SVG] Implement SVGPathElement::getPathSegmentAtLength(), a=testonly\n\nAutomatic update from web-platform-tests\n[SVG] Implement SVGPathElement::getPathSegmentAtLength()\n\n... by adding a new function: `SVGPathQuery::GetSegmentAtLength()`,\nwhich uses existing `SVGPathTraversalState` functionality to calculate\nthe point at the length, but then return the `PathSegmentData` instead\nof the point.\n\nBug: 40441025\nChange-Id: I13c6adb181bf4e12b34fe2faed1e483d6ccfaaf6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8523495\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Steve Becker \u003cstevebe@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1713602}\n\n--\n\nwpt-commits: 98343bd3785f7fa7a7b65b7bb0bb917e24b6e2db\nwpt-pr: 63362\n", "files": ["testing/web-platform/tests/svg/path/interfaces/getPathSegmentAtLength-boundaries.html", "testing/web-platform/tests/svg/path/interfaces/getPathSegmentAtLength-clamping.html", "testing/web-platform/tests/svg/path/interfaces/getPathSegmentAtLength-detached-element.html", "testing/web-platform/tests/svg/path/interfaces/getPathSegmentAtLength-during-animation.html", "testing/web-platform/tests/svg/path/interfaces/getPathSegmentAtLength-invalid.html", "testing/web-platform/tests/svg/path/interfaces/getPathSegmentAtLength-segments.html", "testing/web-platform/tests/svg/path/interfaces/support/getPathData-helpers.js"], "git_node": "761b078f1cd558f3788e68d45e24d0965ec244f9", "git_parents": ["0d82965a21302ed7cbd7aae8b7fec33ec73e7a77"], "node": "bf66cc5aa59a54bfd0557390e6f1abcfbd2ef1e9", "parents": ["ffddee5c12df9e92c33803b40c5481c12b1a7f21"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079587 [wpt PR 63362] - Update wpt metadata, a=testonly\n\nwpt-pr: 63362\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/path/interfaces/getPathSegmentAtLength-clamping.html.ini", "testing/web-platform/meta/svg/path/interfaces/getPathSegmentAtLength-during-animation.html.ini"], "git_node": "44436b2b5def0c97c7b8c57dac214467a211cdf3", "git_parents": ["761b078f1cd558f3788e68d45e24d0965ec244f9"], "node": "7592c9845fa3a4b41b62f4b624f990c3271dbf23", "parents": ["bf66cc5aa59a54bfd0557390e6f1abcfbd2ef1e9"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2079675 [wpt PR 63370] - Do not synchronously fire speculation rules error events on base changes, a=testonly\n\nAutomatic update from web-platform-tests\nDo not synchronously fire speculation rules error events on base changes\n\nWhen a \u003cbase\u003e element is inserted, removed, or has its href attribute\nmodified, Document::ProcessBaseElement() updates the document's base URL\nand notifies ScriptLoader::DocumentBaseURLChanged(). If the document\ncontains an invalid \u003cscript type=\"speculationrules\"\u003e, reparsing it in\nScriptLoader::AddSpeculationRuleSet() synchronously dispatches error\nevents on the script element and window, running script while\nEventDispatchForbiddenScope is active during DOM insertion, removal, or\nattribute cloning.\n\nFix this by:\n1. Checking isConnected() in HTMLBaseElement::ParseAttribute() so\n   modifying or cloning attributes on a disconnected \u003cbase\u003e element does\n   not call Document::ProcessBaseElement().\n2. Returning early in ScriptLoader::DocumentBaseURLChanged() if the\n   speculation rule set failed to parse, since top-level parse errors do\n   not depend on the base URL.\n\nBug: 568730794\nChange-Id: Ib0167ae383b089c7548befb797b674212dca1479\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508876\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713725}\n\n--\n\nwpt-commits: d4750451ebf689017b8faf87001987039e7fe346\nwpt-pr: 63370\n", "files": ["testing/web-platform/tests/html/semantics/document-metadata/the-base-element/crashtests/base-clone-with-speculation-rules-onerror.html", "testing/web-platform/tests/speculation-rules/inline-speculation-rules-base-url-errors.tentative.html"], "git_node": "96bd23f84e0f9ea91ecd52808c3ed7f9b008ffa3", "git_parents": ["44436b2b5def0c97c7b8c57dac214467a211cdf3"], "node": "9cb218981ca2e4b83300def79b7e02b97fa9afee", "parents": ["7592c9845fa3a4b41b62f4b624f990c3271dbf23"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079675 [wpt PR 63370] - Update wpt metadata, a=testonly\n\nwpt-pr: 63370\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/speculation-rules/inline-speculation-rules-base-url-errors.tentative.html.ini"], "git_node": "e10a88ccc9d3d757c0dd69d46e9e583b2e85d734", "git_parents": ["96bd23f84e0f9ea91ecd52808c3ed7f9b008ffa3"], "node": "cbefa971148977eea30f01f8c28385ed3646c6ff", "parents": ["9cb218981ca2e4b83300def79b7e02b97fa9afee"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2079680 [wpt PR 63373] - [HiC] Privacy fix for popovers in the canvas subtree, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Privacy fix for popovers in the canvas subtree\n\nWhen an element inside the canvas subtree is activated as\na popover, it ceases to preserve privacy because it is no\nlonger rendered in the elements display item list. We want\nit this way so as not to unnecessarily hobble content.\n\nBut when the popover status changes, the cached display items\nmay be reused, resulting in private content being drawn when\nthe no-longer-top-layer popover is rendered into the canvas.\n\nThis CL treats change in popover status as equivalent to\nleaving/entering the canvas subtree, and calls\nDidChangeIsInCanvasSubtree to do the necessary invalidations.\n\nBug: 558101052\nChange-Id: I3ca6f6bf848f00b3f3b6852824f7dd4b47b8e561\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8526513\nAuto-Submit: Stephen Chenney \u003cschenney@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713767}\n\n--\n\nwpt-commits: 136493f8c17e0eccc5764ef12a8ebcbd9b53c3c3\nwpt-pr: 63373\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/popover-show-hide-background-image-ignored.tentative.https.sub.html"], "git_node": "55676520fc73cb50812680f5dec2fe3a75dc5469", "git_parents": ["e10a88ccc9d3d757c0dd69d46e9e583b2e85d734"], "node": "35deb73643aa4cfdc37961b86fdee58b32397b52", "parents": ["cbefa971148977eea30f01f8c28385ed3646c6ff"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079680 [wpt PR 63373] - Update wpt metadata, a=testonly\n\nwpt-pr: 63373\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/popover-show-hide-background-image-ignored.tentative.https.sub.html.ini"], "git_node": "530e2f36df27f7dc0821b86e0712fefb120e2d2c", "git_parents": ["55676520fc73cb50812680f5dec2fe3a75dc5469"], "node": "9fa1aeae22b62704d660b6b604ebaf4ead5a361e", "parents": ["35deb73643aa4cfdc37961b86fdee58b32397b52"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2079714 [wpt PR 63374] - [HiC] Draw nothing and return for non-finite rects, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Draw nothing and return for non-finite rects\n\nCanvas 2D APIs are all defined to return without drawing when input\nsizes or positions are non-finite. Make it so for HTML-in-Canvas APIs.\n\nWebGL/GPU APIs in general due not use floats, so do not have prior art\naround NaN/Infinity. In that case, throw a DOMException on Nan/Infinity\nin src rects.\n\nBug: 565835895\nChange-Id: Ic0d303ab9879ce9051821d69c671b5a641a45c27\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8506820\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713769}\n\n--\n\nwpt-commits: 30d4d7d41169175f74ebaa05be5616abc63d0e85\nwpt-pr: 63374\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/drawElementImage-dest-rect-non-finite.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/drawElementImage-src-rect-non-finite.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/drawElementImage-src-rect.tentative.html"], "git_node": "635cb67d1e6f7351e8a8b4c7eeabf676163eb969", "git_parents": ["530e2f36df27f7dc0821b86e0712fefb120e2d2c"], "node": "0cde15fadc92f68e1f9d4af9e820bc1beea2d1da", "parents": ["9fa1aeae22b62704d660b6b604ebaf4ead5a361e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079714 [wpt PR 63374] - Update wpt metadata, a=testonly\n\nwpt-pr: 63374\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/drawElementImage-dest-rect-non-finite.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/drawElementImage-src-rect-non-finite.tentative.html.ini"], "git_node": "5db51744934b9cd6d8a3c4353c520db2e2fc3ad9", "git_parents": ["635cb67d1e6f7351e8a8b4c7eeabf676163eb969"], "node": "ae2f2a051a8fd4bf19e54e7f90584881aa94f63f", "parents": ["0cde15fadc92f68e1f9d4af9e820bc1beea2d1da"], "tags": []}, {"author": "Thomas Guilbert \u003ctguilbert@chromium.org\u003e", "branch": "default", "desc": "Bug 2079721 [wpt PR 63378] - [Streams] Fix detach DCHECK in `WritableStream::Abort()`, a=testonly\n\nAutomatic update from web-platform-tests\n[Streams] Fix detach DCHECK in `WritableStream::Abort()`\n\n`WritableStream::Abort()` doesn't call `SuppressDetachCheck()` on its\nresolver. This hits a `DCHECK` when a stream with a pending abort is\ngarbage collected, e.g. if an in-flight write never settles.\n\nThis CL suppresses the check, like https://crrev.com/c/6517151 did for\n`Close()`, and adds a crashtest.\n\nThis was causing flaky crashes in unrelated WPTs that ran later in the\nsame shard as `aborting.any.serviceworker.html`, such as\n`preserves-pitch.html`.\n\nBug: 390646657\nChange-Id: I8338d1d16550614162d71e8d01416f6d96b45987\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508886\nReviewed-by: Adam Rice \u003cricea@chromium.org\u003e\nAuto-Submit: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCommit-Queue: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1713978}\n\n--\n\nwpt-commits: b550114b660ac9473078674ae8726ce760697904\nwpt-pr: 63378\n", "files": ["testing/web-platform/tests/streams/writable-streams/crashtests/garbage-collection.any.js"], "git_node": "13e89feccd586c127cc50c2c945885816385e485", "git_parents": ["5db51744934b9cd6d8a3c4353c520db2e2fc3ad9"], "node": "485c5dc6317c8ec70fbf4bbcfc6bc1cccba21b32", "parents": ["ae2f2a051a8fd4bf19e54e7f90584881aa94f63f"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2078008 [wpt PR 63237] - HTML: whitespace around non-classic script types, a=testonly\n\nAutomatic update from web-platform-tests\nHTML: whitespace around non-classic script types\n\nMake module/type.html actually fail if a module script with whitespace around its type runs, and add a similar test for import maps.\n\nFor https://github.com/whatwg/html/issues/13012.\n\n--\n\nwpt-commits: 3f7b05e96901eaa15e4e1a57d07dfc1dffe7681f\nwpt-pr: 63237\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/module/type.html", "testing/web-platform/tests/import-maps/type-whitespace.html"], "git_node": "959ef2d530bca9fc7ad2029cc6df061544f1056c", "git_parents": ["13e89feccd586c127cc50c2c945885816385e485"], "node": "7a7c68edda82511a772e300b9369a218629cff2f", "parents": ["485c5dc6317c8ec70fbf4bbcfc6bc1cccba21b32"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078008 [wpt PR 63237] - Update wpt metadata, a=testonly\n\nwpt-pr: 63237\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/modulepreload-referrerpolicy.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/type.html.ini", "testing/web-platform/meta/import-maps/type-whitespace.html.ini"], "git_node": "18575b3da9f068e0dcbd41a0c60c3a9afcaa2ef7", "git_parents": ["959ef2d530bca9fc7ad2029cc6df061544f1056c"], "node": "bf54a48bcbe19b86e366f943a930e62b1eed4713", "parents": ["7a7c68edda82511a772e300b9369a218629cff2f"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2079742 [wpt PR 63381] - [html-in-canvas] Do not treat canvas content as effectively invisible, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Do not treat canvas content as effectively invisible\n\nThis patch resets effective invisibility when painting drawable\nelements inside a \u003ccanvas content=\"drawable\"\u003e element. Previously, if\nthe canvas or an ancestor had opacity: 0, ScopedEffectivelyInvisible\nmarked all descendant paint chunks as effectively invisible.\n\nFixed: 571179203\nChange-Id: I7655e6b73e8f32f48414b4c5c5eb44b4fc1fd3fd\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8531230\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1714022}\n\n--\n\nwpt-commits: beed7c13e30efafeab683167022127f1aeb835ba\nwpt-pr: 63381\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/opacity-zero-ancestor-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/opacity-zero-ancestor.tentative.html"], "git_node": "03e5a5f813a97ef4cc54d9a35e2bd92b8fda8f80", "git_parents": ["18575b3da9f068e0dcbd41a0c60c3a9afcaa2ef7"], "node": "b06010c091cc21ad2b08955d93d72c324e4dec18", "parents": ["bf54a48bcbe19b86e366f943a930e62b1eed4713"], "tags": []}, {"author": "Florian Rivoal \u003cgit@florian.rivoal.net\u003e", "branch": "default", "desc": "Bug 2079745 [wpt PR 63387] - clamp preserves focusability, a=testonly\n\nAutomatic update from web-platform-tests\nclamp preserves focusability (#63387)\n--\n\nwpt-commits: ad9e764cb77dfa8854626eb2ce3ac06ec0d56d17\nwpt-pr: 63387\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-preserves-tabbing.html"], "git_node": "6e081e0f5f9db5b712bfd71ee741cab3fb1ea5b4", "git_parents": ["03e5a5f813a97ef4cc54d9a35e2bd92b8fda8f80"], "node": "feed479724a7af13d991270a6acbf74f73dd3d55", "parents": ["b06010c091cc21ad2b08955d93d72c324e4dec18"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2079777 [wpt PR 63389] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322973, a=testonly\n\nAutomatic update from web-platform-tests\nChanging a list attribute detaches the SVGNumber, SVGLength and SVGPoint objects a script is holding instead of updating them (#63389)\n\n1. A script reads an item from the rotate, x or points list.\n2. The script changes the attribute.\n3. The item still has its old value.\n4. Writing to the item no longer changes the element.\n\n    let n = text.rotate.baseVal.getItem(0);\n    text.setAttribute('rotate', '40 50 60');\n    n.value;    // 10, expected 40\n\nSVG 2 defines what happens when the attribute changes:\n1. If the new list is shorter, the extra items at the end are detached.\n2. Every other item gets its new value.\n\n    If length \u003e new length, then:\n        Detach each object in the list at an index greater than or\n        equal to new length.\n    ...\n    Set item's value to v.\n\nhttps://w3c.github.io/svgwg/svg2-draft/types.html#TermSynchronizeList\n\nBefore, SVGNumberList::parse(), SVGLengthList::parse() and\nSVGPointList::parse():\n1. Emptied the list, detaching every item.\n2. Parsed the new values into new items.\n\nNow they:\n1. Parse the new values.\n2. Add or remove items at the end if the count changed.\n3. Write each value into the item at its index.\n\nSVGTransformList already works this way.\n\nTwo WebKit tests expected the old behaviour:\n- SVGLengthList-xml-dom-modifications.xhtml now expects the held items\n  to take the new values. The pixel test no longer makes sense and is\n  removed.\n- SVGPointList-basics.xhtml puts its own point in the list, so the next\n  setAttribute() changes that point. The test now checks this and resets\n  the point before reusing it.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322973\nWebKit-Canonical-Link: https://commits.webkit.org/323046@main\n--\n\nwpt-commits: 89d1591cf3479fe464f3cdf17a07da37052ae394\nwpt-pr: 63389\n", "files": ["testing/web-platform/tests/svg/types/scripted/SVGList-reflected-attribute-synchronize.html"], "git_node": "0cb84f4dce15939d1d4db565233510cfb88cada1", "git_parents": ["6e081e0f5f9db5b712bfd71ee741cab3fb1ea5b4"], "node": "e94393a0a78ca889e1556f8297bc8c5ff7868ad2", "parents": ["feed479724a7af13d991270a6acbf74f73dd3d55"], "tags": []}, {"author": "Niall McCormack \u003cnmccormack@openai.com\u003e", "branch": "default", "desc": "Bug 2079794 [wpt PR 63388] - [WebMCP] Fix crash for documents without a frame, a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Fix crash for documents without a frame\n\n- createHTMLDocument() creates a document without a frame that shares\n  its creator's execution context. Reading modelContext on both documents\n  binds the same browser host twice and terminates the renderer.\n- Return from the ModelContext constructor before binding browser\n  interfaces when the document has no frame. Preserve the per-document\n  cached object and the existing InvalidStateError method rejections.\n- Add regression coverage for both getter orders, active-document tool\n  registration, discovery and execution, and inactive-document errors.\n\nReproducible steps:\n- Open dev tools console and type the following\n- ```\ndocument.modelContext;\ndocument.implementation.createHTMLDocument().modelContext;\n```\n- Chromium renderer will crash\n\nBug: None\nChange-Id: I95dfd9942938d3d773215e51c096ee641dc0943c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8502902\nReviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1714113}\n\n--\n\nwpt-commits: ba157201a8889745536225a7339700da1a0032a8\nwpt-pr: 63388\n", "files": ["testing/web-platform/tests/webmcp/declarative/no-frame-documents.https.html", "testing/web-platform/tests/webmcp/imperative/model_context.https.html"], "git_node": "410a606affa538ef672ad94f9daf0826a4e04701", "git_parents": ["0cb84f4dce15939d1d4db565233510cfb88cada1"], "node": "7e399fdbad588955b31f32dcb2fff852f186d3f9", "parents": ["e94393a0a78ca889e1556f8297bc8c5ff7868ad2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079794 [wpt PR 63388] - Update wpt metadata, a=testonly\n\nwpt-pr: 63388\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/declarative/no-frame-documents.https.html.ini", "testing/web-platform/meta/webmcp/imperative/model_context.https.html.ini"], "git_node": "834272280806ca701c1c69b0f971fcc2a54cbd4e", "git_parents": ["410a606affa538ef672ad94f9daf0826a4e04701"], "node": "1acabbcb60c5bc5eb35ac706257486f6dae10070", "parents": ["7e399fdbad588955b31f32dcb2fff852f186d3f9"], "tags": []}, {"author": "Jaewon Lee \u003cjaeone@google.com\u003e", "branch": "default", "desc": "Bug 2079799 [wpt PR 63385] - Decisions API: Require user activation to download the model, a=testonly\n\nAutomatic update from web-platform-tests\nDecisions API: Require user activation to download the model\n\nDecisionModel.create() only rejected an unavailable model, so once a\nbackend reports \"downloadable\", any page could start a multi-GB model\ndownload without a user gesture. Like LanguageModel, SemanticEmbedder\nand the other built-in AI APIs, create() now rejects with\nNotAllowedError when availability is \"downloadable\" and the window has\nno user activation (sticky activation is enough, as for the other\nAPIs). Workers skip the check, as they do for the other APIs.\n\nAdds a WPT like the other *-create-user-activation tests.\n\nBug: 565849508, 568193538\nChange-Id: I9591845408f6e27c5f8c0e058cc8118ee1554bfc\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8527785\nReviewed-by: Mike Wasserman \u003cmsw@chromium.org\u003e\nCommit-Queue: Jaewon Lee \u003cjaeone@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1714119}\n\n--\n\nwpt-commits: c9c2dce4a14adf09fcf13d5e086eea44c5bb3cd9\nwpt-pr: 63385\n", "files": ["testing/web-platform/tests/ai/decision-model/decision-model-create-user-activation.tentative.https.window.js"], "git_node": "b8012f03b1f8d1d33bf18f941942f222da79cd8b", "git_parents": ["834272280806ca701c1c69b0f971fcc2a54cbd4e"], "node": "c4a749d96e08cbbc574a23b48364500f25dd8fe3", "parents": ["1acabbcb60c5bc5eb35ac706257486f6dae10070"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079799 [wpt PR 63385] - Update wpt metadata, a=testonly\n\nwpt-pr: 63385\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/decision-model/decision-model-create-user-activation.tentative.https.window.js.ini"], "git_node": "d416408bf9c1d8436af9e96454902f2fec05cb1f", "git_parents": ["b8012f03b1f8d1d33bf18f941942f222da79cd8b"], "node": "8eddc88b29149361d7ff34ed89ba00e2f8f7aae5", "parents": ["c4a749d96e08cbbc574a23b48364500f25dd8fe3"], "tags": []}, {"author": "Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e", "branch": "default", "desc": "Bug 2078289 [wpt PR 63277] - wdspec: Change subtests ordering, a=testonly\n\nAutomatic update from web-platform-tests\nwdspec: Change subtests ordering for invalid perform actions tests (#63277)\n--\n\nwpt-commits: bf76bc7e35aaa494f76b56d878265475ad709550\nwpt-pr: 63277\n", "files": ["testing/web-platform/tests/webdriver/tests/classic/perform_actions/invalid.py"], "git_node": "24d6a5121ce0e611d20cdb60ed994c01ccd5507f", "git_parents": ["d416408bf9c1d8436af9e96454902f2fec05cb1f"], "node": "2d11e502284531db50c419f27897bf124b3fc7fb", "parents": ["8eddc88b29149361d7ff34ed89ba00e2f8f7aae5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078289 [wpt PR 63277] - Update wpt metadata, a=testonly\n\nwpt-pr: 63277\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/classic/perform_actions/duration.py.ini"], "git_node": "6a7717ad6e46c28cdc6bff1fe2b933c42a8a5c1a", "git_parents": ["24d6a5121ce0e611d20cdb60ed994c01ccd5507f"], "node": "ffab6cb1c9b63f894430312c96de169cbf5caf30", "parents": ["2d11e502284531db50c419f27897bf124b3fc7fb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080122 - [wpt-sync] Update web-platform-tests to bf76bc7e35aaa494f76b56d878265475ad709550, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: bf76bc7e35aaa494f76b56d878265475ad709550\nwpt-type: landing\n", "files": ["testing/web-platform/meta/background-fetch/cors.https.window.js.ini", "testing/web-platform/meta/client-hints/critical-ch/navigation.cross-origin.https.window.js.ini", "testing/web-platform/meta/client-hints/critical-ch/navigation.cross-origin.multiple.https.window.js.ini", "testing/web-platform/meta/client-hints/critical-ch/redirect.critical.cross-origin.https.window.js.ini", "testing/web-platform/meta/client-hints/critical-ch/redirect.critical.cross-origin.multiple.https.window.js