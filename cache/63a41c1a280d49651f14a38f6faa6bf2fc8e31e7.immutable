bar-reviewers,nsharpley,sessionstore-reviewers,kcochrane,extension-reviewers,rpl\n\n* Refactor sidebar visibility and sidebar state logic, removing multiple properties in browser-sidebar and sidebarState that handle launcher visibility\n* Update test coverage, particularly for hide-sidebar setting\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327791\n", "files": ["browser/components/customizableui/test/browser_remove_sidebar_button_and_sidebar.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/extensions/test/browser/browser_ext_sidebarAction.js", "browser/components/sessionstore/session.schema.json", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/docs/index.md", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/browser/browser_adopt_sidebar_from_opener.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_launcher_hidden_restore.js", "browser/components/sidebar/tests/browser/browser_opentabs_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_states.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/components/sidebar/tests/unit/test_sidebar_state.js"], "git_node": "51dae1931a6e49311309418c2671f735eb5057c0", "git_parents": ["d76f3ef4e38fe2201726370297e61240a5e0a590"], "node": "b0886792a0ebe2dda0cfba81e48cfce8166679fa", "parents": ["8ed12068bb83f591421893431b819da692c8db51"], "tags": []}, {"author": "Roberto Vidal \u003croberto.vidal@ikumene.com\u003e", "branch": "default", "desc": "Bug 1918990 - use proper CM APIs to assert language. r=bomsy,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334809\n", "files": ["devtools/client/shared/sourceeditor/editor.js"], "git_node": "ae7c0b9a28914fed7e61f81ad60615bdaeb6e572", "git_parents": ["51dae1931a6e49311309418c2671f735eb5057c0"], "node": "88f9d9ab76f1b697b3331e72d39d9da53418b2ca", "parents": ["b0886792a0ebe2dda0cfba81e48cfce8166679fa"], "tags": []}, {"author": "def00111 \u003ckernp@gmx.de\u003e", "branch": "default", "desc": "Bug 2076018 - Remove nsIHttpAuthenticableChannel.isSSL. r=valentin,necko-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329497\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/protocol/http/nsHttpChannelAuthProvider.cpp", "netwerk/protocol/http/nsIHttpAuthenticableChannel.idl"], "git_node": "594cf8e0041fda7201ac28bbcc3a20b56ec7d1b7", "git_parents": ["ae7c0b9a28914fed7e61f81ad60615bdaeb6e572"], "node": "b69f8764a7b42c952ef2a4d9cd0de0d78e1c7e29", "parents": ["88f9d9ab76f1b697b3331e72d39d9da53418b2ca"], "tags": []}, {"author": "Acters \u003cActers_102@protonmail.com\u003e", "branch": "default", "desc": "Bug 2062135 - Round Wayland viewport source edges before deriving dimensions r=gtk-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334791\n", "files": ["widget/gtk/WaylandSurface.cpp"], "git_node": "a47a6498d91d7b031edd8407fa6b7dd38e4e212d", "git_parents": ["594cf8e0041fda7201ac28bbcc3a20b56ec7d1b7"], "node": "d0d8f91dfd0b2b112ecf12a1472643d785415a8f", "parents": ["b69f8764a7b42c952ef2a4d9cd0de0d78e1c7e29"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077817 - Fix warnings for unreferenced code in installer r=browser-installer-reviewers,cdupuis\" for causing build bustages @ windows/.deps/helper.exe.stub\n\nThis reverts commit 7edec0dedd616e4cc20b0a03dff4f2c2d6aa4a7d.\n", "files": ["browser/installer/windows/nsis/installer.nsi", "browser/installer/windows/nsis/stub.nsh", "browser/installer/windows/nsis/uninstaller.nsi"], "git_node": "50272523f5188d7df769032f6bfa73d1907a68cd", "git_parents": ["a47a6498d91d7b031edd8407fa6b7dd38e4e212d"], "node": "957ca961c4202d26ad2da70ad2dd85748ab8737a", "parents": ["d0d8f91dfd0b2b112ecf12a1472643d785415a8f"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2081641 [Wayland] Disable composition of small popups r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335079\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "59ed74a4698b22ee40145d97aa28fa47e7512283", "git_parents": ["50272523f5188d7df769032f6bfa73d1907a68cd"], "node": "52566a280913d5c001cb2acd97776e7a8bdc34f8", "parents": ["957ca961c4202d26ad2da70ad2dd85748ab8737a"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2069286 - Clear console API storage before the about:policies test. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331923\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policies_about_policies.js"], "git_node": "9945de21cebd4a5bd2711c23b9f2ee38652c653b", "git_parents": ["59ed74a4698b22ee40145d97aa28fa47e7512283"], "node": "f03b01fbdb27188035ac65b89fffd0f06976a931", "parents": ["52566a280913d5c001cb2acd97776e7a8bdc34f8"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in dom/media/ r=webrtc-reviewers,pehrsons\n\nThose cases have been detected by an in-progress checker. Expanation\nfollows below:\n\nFor dom/media/webrtc/jsapi/RTCStatsReport.h:\n\n  template \u003ctypename T\u003e\n  nsresult SetRTCStats(T& aValue) {\n        ...\n        ToJSValue(cx, std::forward\u003cT\u003e(aValue), &val)\n        ...\n  }\n\nIn that case, std::forward\u003cT\u003e always returns a T&&, so it's actually an\nstd::move (which is a bit surprising, as it leaves behind a reference to\na moved object.\n\n--\n\nFor dom/media/webrtc/libwebrtcglue/WebrtcTaskQueueWrapper.cpp:\n\n  template \u003ctypename Wrapper\u003e\n  explicit TaskQueueObserver(Wrapper aOwner)\n      : mOwner(std::forward\u003cWrapper\u003e(aOwner)) {}\n\n  ...\n\n  std::conditional_t\u003cDeletion == DeletionPolicy::NonBlocking,\n                     UniquePtr\u003cWebrtcTaskQueueWrapper\u003e,\n                     WebrtcTaskQueueWrapper*\u003e const mOwner;\n\nIn that case, if the call site is an r-value, then we get one copy-move\nat call site, and a copy at field initialization. If the call site is an\nl-value, we get a copy at call site and a copy at field initialization.\nWith an universal reference, if the call site is a r-value we get no\ncopy at call site and one copy at field initialization, and if it's an\nl-value, we get two copy-move.\n\n--\n\nFor dom/media/webrtc/transport/runnable_utils.h:\n\n  template \u003ctypename... Arguments\u003e\n  runnable_args_memfn_ret(Ret* ret, Class&& obj, M method, Arguments... args)\n      : mReturn(ret),\n        mObj(std::forward\u003cClass\u003e(obj)),\n        mMethod(method),\n        mArgs(std::forward\u003cArguments\u003e(args)...) {}\n\n  ...\n\n  std::tuple\u003cArgs...\u003e mArgs;\n\nAs `Arguments` and  `Args` are not related, omitting universal\nreference on `Arguments...` can lead to spurious copies at call site.\n`std::forward\u003cArguments\u003e` will always return an l-value in that case\nwhich is not incorrect, but it's suboptimal.\n\nOne notable change is that if `Args` ever happen to be a reference, it\nis currently a compile error while it could be accepted. The wrapper\ncreator uses\n\n  runnable_args_memfn_ret\u003cR, Class, M, std::decay_t\u003cArgs\u003e...\u003e\n\nso I think it's fine. I've added a static_assert for good measure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334097\n", "files": ["dom/media/webrtc/jsapi/RTCStatsReport.h", "dom/media/webrtc/libwebrtcglue/WebrtcTaskQueueWrapper.cpp", "dom/media/webrtc/transport/runnable_utils.h"], "git_node": "5a113f981a763085df1360ab82e251eec588d2af", "git_parents": ["9945de21cebd4a5bd2711c23b9f2ee38652c653b"], "node": "fdb9bede48745725c9aa622a70564f1b448a450f", "parents": ["f03b01fbdb27188035ac65b89fffd0f06976a931"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in editor/ r=masayuki\n\ntemplate \u003ctypename StrongNodePtr\u003e\n  MOZ_CAN_RUN_SCRIPT static void RemoveContentFromNACArray(StrongNodePtr& aAnonymousContent) {\n    ...\n    // aAnonymousContent may be a class member. Let's move the ownership to\n    // the local strong pointer.\n    StrongNodePtr anonymousContent = std::forward\u003cStrongNodePtr\u003e(aAnonymousContent);\n    ...\n  }\n\nThe call to `std::forward`` always create an r-value from a reference,\nso it's actually an `std::move`, as hinted by the comment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334098\n", "files": ["editor/libeditor/ManualNAC.h"], "git_node": "b209d2e27a5b531cb83a73e4084cbfe4f6ba660e", "git_parents": ["5a113f981a763085df1360ab82e251eec588d2af"], "node": "ba5b7e872103ad79ca9779d423be6b116c70c240", "parents": ["fdb9bede48745725c9aa622a70564f1b448a450f"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in image/ r=gfx-reviewers,lsalzman\n\nAll function arguments referenced in that patch are passed as value and\nthat value is then `std::forward`ed. This implies a copy at call site,\nit can eventually be avoided by using universal references instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334099\n", "files": ["image/SurfacePipe.h", "image/test/gtest/TestADAM7InterpolatingFilter.cpp", "image/test/gtest/TestDeinterlacingFilter.cpp", "image/test/gtest/TestDownscalingFilter.cpp", "image/test/gtest/TestRemoveFrameRectFilter.cpp", "image/test/gtest/TestSurfaceSink.cpp", "image/test/gtest/TestSwizzleFilter.cpp"], "git_node": "a2c32c7cf5baf121ed075842f784a6c596a5f633", "git_parents": ["b209d2e27a5b531cb83a73e4084cbfe4f6ba660e"], "node": "ddf0425d0fc0ede90dd6f76afd5d196e45c9099c", "parents": ["ba5b7e872103ad79ca9779d423be6b116c70c240"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in js/ r=spidermonkey-reviewers,jonco\n\nOriginal code was:\n\n   template \u003ctypename RootHolder, typename... CtorArgs, typename = std::enable_if_t\u003cdetail::IsTraceable_v\u003cT\u003e, RootHolder\u003e\u003e\n   explicit PersistentRooted(const RootHolder& cx, CtorArgs... args)\n   : ptr(std::forward\u003cCtorArgs\u003e(args)...) {\n\nAs `CtorArgs` is not a universal reference, it will always be deduced as\na value, potentially implying a copy at call-site, followed by a\ncopy-move to initialize `ptr`. With a universal reference, the original\ncopy at call site may be omitted, or turned into a copy-move.\n\nSurrounding code uses universal references, so I assume this behavior is\na mistake and was not intended.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334100\n", "files": ["js/public/RootingAPI.h"], "git_node": "ae329c530f3fea67e30d7a19dbde4888abcce0ad", "git_parents": ["a2c32c7cf5baf121ed075842f784a6c596a5f633"], "node": "5c8eaedbaed4ac7fb3ba1faa6633b168a34fdc05", "parents": ["ddf0425d0fc0ede90dd6f76afd5d196e45c9099c"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Ensure correct usage of std::forward in mfbt/ r=nika\n\nForwarding parameters makes more sense if the parameters are universal\nreferences, otherwise we'd better use std::move. In that case it's a\ntypical forwarding pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334101\n", "files": ["mfbt/tests/TestFunctionRef.cpp"], "git_node": "4dc30d5a31324cb0469dfe4c55eb1635116b2d96", "git_parents": ["ae329c530f3fea67e30d7a19dbde4888abcce0ad"], "node": "920e0bf34ebea28fd72cbf5e4feb1214e864477c", "parents": ["5c8eaedbaed4ac7fb3ba1faa6633b168a34fdc05"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2082444 - Change aBufferSize to uint32_t r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335047\n", "files": ["gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeChild.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/ContentCompositorBridgeParent.h", "gfx/layers/ipc/PCompositorBridge.ipdl", "gfx/layers/wr/WebRenderLayerManager.cpp", "gfx/layers/wr/WebRenderLayerManager.h", "layout/painting/WindowRenderer.cpp", "layout/painting/WindowRenderer.h"], "git_node": "84f7b3423f51946fce922db1a1117cc2e60f9b39", "git_parents": ["4dc30d5a31324cb0469dfe4c55eb1635116b2d96"], "node": "ad2e2e54a0707d042257e07ab3dc019f23a34cb3", "parents": ["920e0bf34ebea28fd72cbf5e4feb1214e864477c"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2083325 - set SpeechRecognition related interfaces as enabled on all update channels in interface checks. r=padenot,webidl,emilio\n\nBug 2080908 enabled the interfaces for all update channels while the interface\ntest check still assumed they are enabled only for Nightly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335093\n", "files": ["dom/tests/mochitest/general/test_interfaces.js"], "git_node": "c47c0f4ec603f88296b6b158f6c3a98f9e8edfe1", "git_parents": ["84f7b3423f51946fce922db1a1117cc2e60f9b39"], "node": "0be0fad360d5b0c571af20e93ede277f3b7e4712", "parents": ["ad2e2e54a0707d042257e07ab3dc019f23a34cb3"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1332891 - Ensure correct usage of std::forward in mfbt/ r=nika\" for causing build bustages @ RTCStatsReport.h\n\nThis reverts commit 4dc30d5a31324cb0469dfe4c55eb1635116b2d96.\n\nRevert \"Bug 1332891 - Ensure correct usage of std::forward in js/ r=spidermonkey-reviewers,jonco\"\n\nThis reverts commit ae329c530f3fea67e30d7a19dbde4888abcce0ad.\n\nRevert \"Bug 1332891 - Ensure correct usage of std::forward in image/ r=gfx-reviewers,lsalzman\"\n\nThis reverts commit a2c32c7cf5baf121ed075842f784a6c596a5f633.\n\nRevert \"Bug 1332891 - Ensure correct usage of std::forward in editor/ r=masayuki\"\n\nThis reverts commit b209d2e27a5b531cb83a73e4084cbfe4f6ba660e.\n\nRevert \"Bug 1332891 - Ensure correct usage of std::forward in dom/media/ r=webrtc-reviewers,pehrsons\"\n\nThis reverts commit 5a113f981a763085df1360ab82e251eec588d2af.\n", "files": ["dom/media/webrtc/jsapi/RTCStatsReport.h", "dom/media/webrtc/libwebrtcglue/WebrtcTaskQueueWrapper.cpp", "dom/media/webrtc/transport/runnable_utils.h", "editor/libeditor/ManualNAC.h", "image/SurfacePipe.h", "image/test/gtest/TestADAM7InterpolatingFilter.cpp", "image/test/gtest/TestDeinterlacingFilter.cpp", "image/test/gtest/TestDownscalingFilter.cpp", "image/test/gtest/TestRemoveFrameRectFilter.cpp", "image/test/gtest/TestSurfaceSink.cpp", "image/test/gtest/TestSwizzleFilter.cpp", "js/public/RootingAPI.h", "mfbt/tests/TestFunctionRef.cpp"], "git_node": "dfa03b1cd79888fb4675dd71798165d632967580", "git_parents": ["c47c0f4ec603f88296b6b158f6c3a98f9e8edfe1"], "node": "8562b2bd01d9cdfa7dc2198ac1d3c2583f563bbc", "parents": ["0be0fad360d5b0c571af20e93ede277f3b7e4712"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081588 - Ship libmozsqlite3 in the trainhop test bundle r=ahochheiden\n\nOn Linux (MOZ_FOLD_LIBS unset), sqlite is a separate libmozsqlite3.so rather than part of nss3. The trainhop bundle ships the trunk libxul.so in tests/bin but not libmozsqlite3.so, so the loader resolved it from the Beta/Release application directory. That copy lacks the newly exported sqlite3_normalized_sql (bug 1594264), so the mochitest httpd xpcshell failed with a symbol lookup error.\n\nAdd mozsqlite3 to TRAIN_HOP_DLLS. On folded platforms (Windows/macOS) the pattern matches nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334923\n", "files": ["python/mozbuild/mozbuild/action/test_archive.py"], "git_node": "9bc21cf6aa8220b6989a61f9778f6aa5440521bb", "git_parents": ["dfa03b1cd79888fb4675dd71798165d632967580"], "node": "d56ada61279dcf643bc9c925bee7eede5f3d28d7", "parents": ["8562b2bd01d9cdfa7dc2198ac1d3c2583f563bbc"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071822 - Add gradle plugin to generate androidTest keep rules\n\nR8 only sees the app during minification, so it removes or renames code that only the androidTest apk uses, and instrumented tests crash at runtime against a minified build. A hand-written rule set can't keep up, because the rules change whenever app or test code changes.\n\nThis adds a new `android-test-keep-rules` gradle plugin. For the build type passed as `-PtestBuildType`, when that build type is minified, it runs R8's `TraceReferences` with the test apk as the source and the app as the target. It then adds the resulting keep rules to that variant's R8 config.\n\nBuilds without `-PtestBuildType`, including all shipping builds, are unaffected.\n\nFenix applies the plugin, and `proguard-rules-android-test.pro` adds `-dontwarn` rules for optional references in test-only libraries so R8 can process the test apk. The plugin has unit tests and a `source-test-android-gradle-plugins` ci job.\n\nCI test builds still pass `-PdisableOptimization`, so this changes nothing in ci until a minified ui test variant is added.\n\n[there is a green try here](https://treeherder.mozilla.org/jobs?repo=try&revision=e937c822474c688d0594a6f9ed026cf21ae08bc3) just to ensure that:\n- none of the usual fenix stuff is broken\n- the nightly ui tests still pass\n- the plugin's own unit tests pass\n- linters for the yml are happy\n\n[rerunning try here after last push to add docs](https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=107017)\n\nthere is also a [google doc with the approach and implementation plan for this ticket here](https://docs.google.com/document/d/1BHoznUPqfRlQ7M5UbtgwTwSHbcQ9_PA9TKHCbSEiuFI/edit?tab=t.l5l9dq1u67wr)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/395\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/proguard-rules-android-test.pro", "mobile/android/fenix/settings.gradle", "mobile/android/gradle/plugins/android-test-keep-rules/build.gradle.kts", "mobile/android/gradle/plugins/android-test-keep-rules/settings.gradle.kts", "mobile/android/gradle/plugins/android-test-keep-rules/src/main/kotlin/org/mozilla/androidtestkeeprules/AndroidTestKeepRulesPlugin.kt", "mobile/android/gradle/plugins/android-test-keep-rules/src/main/kotlin/org/mozilla/androidtestkeeprules/GenerateAndroidTestKeepRules.kt", "mobile/android/gradle/plugins/android-test-keep-rules/src/test/kotlin/org/mozilla/androidtestkeeprules/GenerateAndroidTestKeepRulesTest.kt", "settings.gradle", "taskcluster/kinds/source-test/android-gradle-plugins.yml"], "git_node": "1a68818a733eb53991e4468e0837638c7730bab3", "git_parents": ["9bc21cf6aa8220b6989a61f9778f6aa5440521bb"], "node": "fc571dedd4376f1cc5fc563661ea9baf7c459fc6", "parents": ["d56ada61279dcf643bc9c925bee7eede5f3d28d7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083700 - Alias ::-webkit-input-placeholder to ::placeholder. r=webcompat-reviewers,twisniewski\n\nShould be relatively safe, all things considered, but added a pref just\nin case. We can remove it after a bit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335109\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/gecko/pseudo_element_definition.mako.rs", "testing/web-platform/tests/compat/webkit-input-placeholder-ref.html", "testing/web-platform/tests/compat/webkit-input-placeholder.html"], "git_node": "c32e905775d2e3429cef83e8808b39d1b670e4bf", "git_parents": ["1a68818a733eb53991e4468e0837638c7730bab3"], "node": "a02af9ab10dde5ef31fe6d11b691e54b186003b5", "parents": ["fc571dedd4376f1cc5fc563661ea9baf7c459fc6"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2066166 - fix(webgpu): invert `hasCropRect` in `ImageBitmap::SurfaceFrom` r=webgpu-reviewers,aleiserson?,#webgpu-reviewers!\n\n[D182208](https://phabricator.services.mozilla.com/D182208)/bug 1781527\nintroduced surface extraction for `ImageBitmap`, but it got the\ncondition for `hasCropRect` incorrect:\n\n```\nbool hasCropRect = mPictureRect.IsEqualEdges(imageRect)\n```\n\nThis states that if the edges are equal, then we crop. But the inverse\nis the truth: if the view rectangle equals the image's rectangle, that\nmeans there _isn't_ any cropping to do. \ud83d\ude05\n\nThe fall-out of this issue was surprisingly narrow: we'd unconditionally\ndo un-pre-multiplication of alpha, which we noticed with this bug when\nalpha of texels were 0 (thus rendering pure black pixels).\n\nInvert, and fix this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323993\n", "files": ["dom/canvas/ImageBitmap.cpp"], "git_node": "8ea63b4292d88c4a831332ea57f3e08e0993108d", "git_parents": ["c32e905775d2e3429cef83e8808b39d1b670e4bf"], "node": "e609d26e9aa3f8131631e2291a18fde748b3f3d8", "parents": ["a02af9ab10dde5ef31fe6d11b691e54b186003b5"], "tags": []}], "date": 1792423413, "git_changesets": ["c0ffd70891b4073fdd27ed602f788debd4c7677e", "b1970bfdd374c8896a99914009dd4f9b298e196a", "99709e1e8633c5a131e0ebf9d9cfa95e2f07f444", "e78b91cba7b62344e54dcac1751146b29daaea89", "d3df50aa5d12bf4a1fe22057715b0fca51be19e8", "5e5161b4fa63119a0de91b6e89015e88cf84f747", "58ceda34c8348c4e460d59d3db87e87d28231af7", "a109c98ffa47041edba151678251cd080ba54a64", "4128b8e7cf055c3928646bf9fb41495ec1e95d42", "9f99d135386b06a9cca9cc2c99a6278e4f60f548", "5291a8142423f4c3db9cf2dc7642b9f0590219c0", "7454acea5a801eca87a57a2161a09e497c300d9c", "e92263e94000d0d226178f0bf35fb068ccbe4d95", "f942d6e6910e20a66e910d2687353163f2eb234a", "c5a22b75d6d49c79d75b602fb6c4fe2be9518377", "d1a020277b648296fc64ad9fc44bebd0d2276983", "ae0838823d2ce08dc14c0fe6c6db4c2c57b6cf78", "0b7759adab26b16b175e068da93b2c92a453cc76", "c4562fa8b373bb0fbb216f5a315d080e34be49c7", "18f2474a41f3e1979d3d1b232bd472817aaf929b", "e35d82b9cc65a8ba7c58ea74946fdd11921da968", "ef18b429236691020482dde74a75be5a415e635a", "7ad43ed6f9e969cb6570c6e554bdd231d94d6c47", "6bb463334bda323c61a9985fe2ce12468a6b0a14", "f9eeb26e898d4299dd1a669e6adfa80dc5761d2b", "01a92f94e33db18f5c70be1344c562bfc6564f47", "5c59f60a9f402a9c9fec075fa1022a4008788128", "bb596201cf42cd3287cd0490cabd2783d2f61603", "6195dc321cf717ce7d24f2761b421a59b5d12827", "5430fc6070eaa4e3a5fb79cf0926c940adcd4e5b", "d19a84bb57b2efd16f345b1983f527edb01c7db6", "3b8de05a9b6541219eb21d3d815c9db1935c9c29", "60842536456b70794e326094c99f22c14c27bae2", "ca475a552582a50e9c22c6a57d4772008f798aba", "2c89c69a9e8adc21771366a128b7cfb851a89f43", "77e02d149e58ecdddb8d4cbed050623233c2af5d", "0780b348e769c9b8a51e0af9983a6fd55885286b", "60a845608c61afc2ca5a08ea54f9e113932936af", "713fa82222297156fccd17d952ffde4fef6fa01c", "c21d90f63280d115e2b4c2fb5b23b2b17c01727e", "5f0f8f74b40d479ef91f7801c3c67fb84888fe9b", "d625c3ba2183e792152f2f3c63cd6acbf42339f2", "98b7082d30cdef6c08d4e2a030f97645a12e6d98", "950ae050adafb651ca26d754baf6bb589da8c5f9", "7edec0dedd616e4c