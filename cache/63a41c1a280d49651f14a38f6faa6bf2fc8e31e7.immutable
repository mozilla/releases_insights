s/Codegen.py"], "git_node": "bf4a0a91ad3fbb844b2956bd279ebf534c67e3f2", "git_parents": ["50e0c3659c03dd815b7ca3253e77b06c46b17e26"], "node": "3e0ccd69785b5c645ac26315817b170af86ffdc8", "parents": ["8b110c27139819e97a89e3c0ca3d7a4c88f18e43"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079834 - Don't send scopes to fxa-client  when sync decoupling is enabled r=titouan,twhite\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/385\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt"], "git_node": "ff16f9139b1f4c3693f0b07abcb042aba64450b8", "git_parents": ["bf4a0a91ad3fbb844b2956bd279ebf534c67e3f2"], "node": "b6f22ac8997d4b6f04e8758c51699d5ddbaa7985", "parents": ["3e0ccd69785b5c645ac26315817b170af86ffdc8"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071485 - Wait for an in-flight speculation rules prefetch before opening the navigation channel r=necko-reviewers,sunil\n\nDocumentLoadListener::Open waits, bounded by dom.speculation_rules.wait_timeout_ms, for a matching in-flight prefetch before AsyncOpen. Per spec only top-level GET navigations can match prefetch records. Gating on IsTop() also stops subframe navigations from activating from a completed prefetch, which the previous mIsDocumentLoad-only check allowed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327503\n", "files": ["dom/base/test/browser_prefetch_delivery_type.js", "dom/base/test/file_pageload_prefetch_target.sjs", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/DocumentLoadListener.h", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-requestStart-responseStart.https.html.ini"], "git_node": "6b751cd3b25d5ef6e69e8e0b3ce5a3f757f9c606", "git_parents": ["ff16f9139b1f4c3693f0b07abcb042aba64450b8"], "node": "eaa2b5eee8f748ab6aefabd77fd7bc6c4bda3942", "parents": ["b6f22ac8997d4b6f04e8758c51699d5ddbaa7985"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080849 - [customizable-menu] Fixed recent issues with customizable menu layout. r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333229\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/ExpandableHeaderItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuGridItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemGroup.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/MenuTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt"], "git_node": "e09df0f7f8c73cde073ed4a2107fdf51b1b09452", "git_parents": ["6b751cd3b25d5ef6e69e8e0b3ce5a3f757f9c606"], "node": "d167342936bc4135286e541f047c83f4dcc754c7", "parents": ["eaa2b5eee8f748ab6aefabd77fd7bc6c4bda3942"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081199 - Create new verifyBlockedTrackersDashboardWithTrackersBlockedInTabsTrayTest regression UI test for the efficiency framework r=aaronmt\n\nThe UI test successfully passed 25x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=103967  | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=9a76121b71d0d2a590b465cc5ded74fb72969746  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333243\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ProtectionsDashboardPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/TabDrawerPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ProtectionsDashboardSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/TabDrawerSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/ProtectionsDashboardTest.kt"], "git_node": "395de7db13542f587fcc2e8a7269faa4fade45ff", "git_parents": ["e09df0f7f8c73cde073ed4a2107fdf51b1b09452"], "node": "6f0ac60780f01ec82e2439c96435fc317f22a714", "parents": ["d167342936bc4135286e541f047c83f4dcc754c7"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037645 - Add MOZ_GUARDED_BY to mConnectionClosed and mAsyncExecutionThreadShuttingDown. r=jari\n\nAnnotate mConnectionClosed and mAsyncExecutionThreadShuttingDown with\nMOZ_GUARDED_BY(sharedAsyncExecutionMutex), matching what the comment\nabove the mutex already documented.\n\nEnsure mConnectionClosed is always set to true when a connection fails\nto open or is closed, even in early failure paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299529\n", "files": ["storage/mozStorageConnection.cpp", "storage/mozStorageConnection.h"], "git_node": "37a65ea8d8c6b2d7f9ce9cad8554b793eefad422", "git_parents": ["395de7db13542f587fcc2e8a7269faa4fade45ff"], "node": "19ad279e00669e98fb7ebd80ea8362258b766cc5", "parents": ["6f0ac60780f01ec82e2439c96435fc317f22a714"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "defa