37fdf733b", "d0048572ec04deb15832bd01cd67d11efa6748f0", "df9d48cd974d1d260fa8d71affa0e159fc221b74", "7c56dd718eb1db5e657360b398f9a02f602b2505", "8ae6c70489805d7105f9de70b604d68afb54e0a1", "e3a64204448c0a0b59cb7e3ad280d6da11b9b8bd", "4fde4ba264b3b51908da2a3e4c100e544fbbaad7", "2990cc6291c71eff5a11c69afb6615625f601b8b", "e861dd80e4c4434b34122859aad97ef62700abbd", "8477c6d8ac1ed7557937c9d3f9a6b1224142d27d"], "user": "rperta@mozilla.com"}, "45527": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/contextmenu/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/support/ktx/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-is/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/focus-android/app/src/main/res/values-cy/strings.xml", "mobile/android/focus-android/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/focus-android/app/src/main/res/values-is/strings.xml", "mobile/android/focus-android/app/src/main/res/values-iw/strings.xml", "mobile/android/focus-android/app/src/main/res/values-uk/strings.xml"], "git_node": "54b3ce96c8c66d524ff06df04122f538a3ced02e", "git_parents": ["8477c6d8ac1ed7557937c9d3f9a6b1224142d27d"], "node": "940f6b0a8ba04f6de57df7ea2fc4ff93085e98cf", "parents": ["9c2023509135f0e50a7c35952ad3d6448d649dee"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079062 - Use a single task to resolve the ready promise and fire loadingdone/loadingerror events. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332162\n", "files": ["layout/style/FontFaceSet.cpp", "layout/style/FontFaceSet.h"], "git_node": "e358158e58ce4b8a3084bdd191c863c8f18f18f0", "git_parents": ["54b3ce96c8c66d524ff06df04122f538a3ced02e"], "node": "87faa8658c8c656666fedc3ed2c8705091ddfa3b", "parents": ["940f6b0a8ba04f6de57df7ea2fc4ff93085e98cf"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2079663. Rename nsJXLDecoder::mU8RowBuf to mPipeInputRowBuf. r=saschanaz\n\nThe name says what type it holds rather than what it is for. The next patch\nadds a second row buffer, so name this one after its role: the row we hand to\nthe surface pipe when it can't read mPixelBuffer directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331947\n", "files": ["image/decoders/nsJXLDecoder.cpp", "image/decoders/nsJXLDecoder.h"], "git_node": "d51576d514bbc5337375770e300ea4004c9c81a0", "git_parents": ["e358158e58ce4b8a3084bdd191c863c8f18f18f0"], "node": "d495883d79a74fac293a347bf7a0a0ad4c25a0f6", "parents": ["87faa8658c8c656666fedc3ed2c8705091ddfa3b"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2079663. Don't premultiply JXL images that have premultiplied alpha a second time. r=saschanaz\n\nhttps://searchfox.org/firefox-main/rev/3c71a541b0e7ac6e086907b38670dabca9174c45/image/decoders/nsJXLDecoder.cpp#607\n\nWe assume jxl-rs always outputs unpremultiplied alpha, but for images with\npremultiplied (associated) alpha it outputs the premultiplied values stored in\nthe file. We then premultiply them again, so semi-transparent areas come out\ntoo dark. Color management and surfaces that want unpremultiplied data\n(NO_PREMULTIPLY_ALPHA) also got premultiplied data.\n\nNow we unpremultiply when color management or the surface needs it, and\notherwise tell the surface pipe not to premultiply. The spec doesn't say what\ncolor values larger than alpha mean; we clamp them to alpha so the result\ndoesn't depend on whether color management runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331951\n", "files": ["image/decoders/nsJXLDecoder.cpp", "image/decoders/nsJXLDecoder.h"], "git_node": "31349ea2b83e0ee0aca2c24d3107f1856556f9f8", "git_parents": ["d51576d514bbc5337375770e300ea4004c9c81a0"], "node": "cda3ed9c9aaa7f3ecfabff0a1a42bb19aebfd2f0", "parents": ["d495883d79a74fac293a347bf7a0a0ad4c25a0f6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2079663. Add WPT reftests for JXL images with premultiplied alpha. r=saschanaz\n\nPremultiplied and non-premultiplied versions of the same RGB and gray grids,\neach compared against one PNG, plus the conformance suite's\nalpha_premultiplied image compared against its reference PNG. cjxl\n--premultiply=1 only marks the pixels as premultiplied, so the premultiplied\ngrids are encoded from PNGs that were premultiplied first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331952\n", "files": ["testing/web-platform/tests/jpegxl/conformance-alpha-premultiplied-reftest-ref.html", "testing/web-platform/tests/jpegxl/conformance-alpha-premultiplied-reftest.html", "testing/web-platform/tests/jpegxl/nonpremultiplied-alpha-grid-reftest-ref.html", "testing/web-platform/tests/jpegxl/nonpremultiplied-alpha-grid-reftest.html", "testing/web-platform/tests/jpegxl/nonpremultiplied-gray-alpha-grid-reftest-ref.html", "testing/web-platform/tests/jpegxl/nonpremultiplied-gray-alpha-grid-reftest.html", "testing/web-platform/tests/jpegxl/premultiplied-alpha-grid-reftest-ref.html", "testing/web-platform/tests/jpegxl/premultiplied-alpha-grid-reftest.html", "testing/web-platform/tests/jpegxl/premultiplied-gray-alpha-grid-reftest-ref.html", "testing/web-platform/tests/jpegxl/premultiplied-gray-alpha-grid-reftest.html", "testing/web-platform/tests/jpegxl/resources/alpha_grid.png", "testing/web-platform/tests/jpegxl/resources/conformance_alpha_premultiplied.jxl", "testing/web-platform/tests/jpegxl/resources/conformance_alpha_premultiplied.png", "testing/web-platform/tests/jpegxl/resources/generate_resources.sh", "testing/web-platform/tests/jpegxl/resources/gray_alpha_grid.png", "testing/web-platform/tests/jpegxl/resources/nonpremultiplied_alpha_grid.jxl", "testing/web-platform/tests/jpegxl/resources/nonpremultiplied_gray_alpha_grid.jxl", "testing/web-platform/tests/jpegxl/resources/premultiplied_alpha_grid.jxl", "testing/web-platform/tests/jpegxl/resources/premultiplied_gray_alpha_grid.jxl"], "git_node": "d6ba1a3081a9b04e71e8691d72c9a5cdb2263c10", "git_parents": ["31349ea2b83e0ee0aca2c24d3107f1856556f9f8"], "node": "895ec42d7aba4b99ec2245a79cb59c5dda8d3c1b", "parents": ["cda3ed9c9aaa7f3ecfabff0a1a42bb19aebfd2f0"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077804 - Remove the `set_config` entries that nothing reads r=firefox-build-system-reviewers,sergesanspaille\n\n`--enable-java-coverage` goes too, because setting\n`MOZ_JAVA_CODE_COVERAGE` was its only use and D25216 removed the Gradle\ncode that read it. The `--coverage-output-dir` help in\n`mochitest_options.py` named that option, but the flag it requires is\n`--enable-coverage`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330443\n", "files": ["build/moz.configure/java.configure", "build/moz.configure/rust.configure", "build/moz.configure/toolchain.configure", "js/moz.configure", "mobile/android/gradle.configure", "python/mozbuild/mozbuild/test/configure/test_checks_configure.py", "testing/mochitest/mochitest_options.py", "toolkit/moz.configure"], "git_node": "e8e1c52af74ecff3c2cac7052c7e00bc71853209", "git_parents": ["d6ba1a3081a9b04e71e8691d72c9a5cdb2263c10"], "node": "9e02560560f727a79bd60815c6ce33f7943a4619", "parents": ["895ec42d7aba4b99ec2245a79cb59c5dda8d3c1b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077804 - Fail the configure lint on `set_config` entries that nothing reads r=firefox-build-system-reviewers,sergesanspaille\n\nOnly file types that can read substs are scanned, so a C++ use of a\ndefine with the same name does not count. A line starting with `#`\ncounts only when it holds an `@` substitution, so comments and\npreprocessor conditions do not count either, and neither do the\nconfigure tests. Names set inside a template are skipped, because their\nconsumers can build them dynamically.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330444\n", "files": ["python/mozbuild/mozbuild/configure/lint.py", "python/mozbuild/mozbuild/test/configure/lint.py", "python/mozbuild/mozbuild/test/configure/test_lint.py"], "git_node": "d9ea2f0f55a1e1d33f2b631b43cae90bfd580ce9", "git_parents": ["e8e1c52af74ecff3c2cac7052c7e00bc71853209"], "node": "599b07be347a381787887a1affa8df80a7547ddf", "parents": ["9e02560560f727a79bd60815c6ce33f7943a4619"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077804 - Remove the `@depends` functions whose value nothing reads r=firefox-build-system-reviewers,geckoview-reviewers,sergesanspaille,nalexander\n\n`check_maintenance_service`, `check_update_agent` and `with_gradle` only\nrun checks, so they stay and stop returning a value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330512\n", "files": ["build/moz.configure/flags.configure", "build/moz.configure/init.configure", "build/moz.configure/toolchain.configure", "build/moz.configure/update-programs.configure", "build/moz.configure/warnings.configure", "mobile/android/gradle.configure"], "git_node": "85fde04884f23d6dac8b39ab702a9f4b96c6e711", "git_parents": ["d9ea2f0f55a1e1d33f2b631b43cae90bfd580ce9"], "node": "fd5f3c1b732b603ba0ab662c79cdaf6a7a48e345", "parents": ["599b07be347a381787887a1affa8df80a7547ddf"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077804 - Fail the configure lint on `@depends` functions whose value nothing reads r=firefox-build-system-reviewers,sergesanspaille\n\nThe sandbox runs every `@depends` function even when nothing references\nit, so a function that returns nothing is a check and passes.\n`@checking` prints the value it decorates, so that counts as a read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330516\n", "files": ["python/mozbuild/mozbuild/configure/lint.py", "python/mozbuild/mozbuild/test/configure/lint.py", "python/mozbuild/mozbuild/test/configure/test_lint.py"], "git_node": "e1e39dfc1872714f62b991b3b391cc3d38973f95", "git_parents": ["85fde04884f23d6dac8b39ab702a9f4b96c6e711"], "node": "3bf3e20d8c30d50f42f7c4c8f5b79247acec85e8", "parents": ["fd5f3c1b732b603ba0ab662c79cdaf6a7a48e345"], "tags": []}, {"author": "python273 \u003ciam@python273.pw\u003e", "branch": "default", "desc": "Bug 1613369 - Use paired nearest alpha rounding and correct conversion expectations. r=gfx-reviewers,lsalzman,places-reviewers,mak\n\nPair nearest premultiplication with nearest unpremultiplication to preserve\nvalid stored pixels through both direct ImageData and native PNG round trips.\nAdd exhaustive scalar/SIMD checks and canvas import/round-trip regression tests.\n\nCorrect the legacy gradient expectations to pixel-center sampling. Update\nthe four JPEG/WebP references and both PNG compression variants of the\n48x48 favicon to reflect nearest premultiplication.\n\nRemove obsolete FAIL metadata for 18 element/offscreen/worker compositing\nreftests. Nearest PNG decoding improves their existing references enough\nto meet the existing fuzzy bounds.\n\nCorrect the GTK drawSnapshot straight-alpha reference grays from 29 and 237\nto 28 and 236. Nearest premultiplication maps gray 16 and 235 at alpha 242\nto 15 and 223; composition over white adds 13.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331332\n", "files": ["dom/canvas/test/mochitest.toml", "dom/canvas/test/reftest/color_quads.list", "dom/canvas/test/test_canvas.html", "dom/canvas/test/test_canvas_png_roundtrip.html", "gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleGeneric.h", "gfx/2d/SwizzleNEON.h", "gfx/tests/gtest/TestSwizzle.cpp", "image/test/unit/image1.webp", "image/test/unit/image1png16x16.jpg", "image/test/unit/image1png64x64.jpg", "image/test/unit/image1quality50.webp", "image/test/unit/test_imgtools.js", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.w.html.ini", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.libz-rs.png", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.png"], "git_node": "20c63b43b9ba3aa5a9f3c4c9b2289aa10b865c4f", "git_parents": ["e1e39dfc1872714f62b991b3b391cc3d38973f95"], "node": "6cf47244e4e3b0c2fae3dc68c3910c207bca8bdb", "parents": ["3bf3e20d8c30d50f42f7c4c8f5b79247acec85e8"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Find the bootstrapped mozmake in `test_build.py` without a configured objdir r=firefox-build-system-reviewers,sylvestre\n\nConfigure finds make in the `mozmake` directory under the state directory, so\nthe fallback for an unconfigured objdir searches there too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329478\n", "files": ["python/mozbuild/mozbuild/test/backend/test_build.py"], "git_node": "cf6c8c4cf43ddba36f80e7ff05cf8a038ed8f9e6", "git_parents": ["20c63b43b9ba3aa5a9f3c4c9b2289aa10b865c4f"], "node": "48417908aa8762f14a861415f76591c05e069555", "parents": ["6cf47244e4e3b0c2fae3dc68c3910c207bca8bdb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076399. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332247\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp"], "git_node": "2b6f847a46f47320e47904ab6fbd4bb12d5aa805", "git_parents": ["cf6c8c4cf43ddba36f80e7ff05cf8a038ed8f9e6"], "node": "5e75aed29992c92b997d0e8be51dead63cd144d1", "parents": ["48417908aa8762f14a861415f76591c05e069555"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079687. r=webidl,firefox-style-system-reviewers,smaug,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332230\n", "files": ["dom/webidl/CSSRule.webidl", "dom/webidl/CSSStyleDeclaration.webidl", "layout/style/Rule.cpp", "layout/style/Rule.h", "layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h", "layout/style/nsICSSDeclaration.cpp", "layout/style/nsICSSDeclaration.h"], "git_node": "e54211ea08efc3e4a6440739aa173b9edfc83b67", "git_parents": ["2b6f847a46f47320e47904ab6fbd4bb12d5aa805"], "node": "3c0c9d5e533ae230e2adbae1461a2bde7c7718c9", "parents": ["5e75aed29992c92b997d0e8be51dead63cd144d1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079938 - Prevent display contents pseudo-elements from showing up in SVG subtrees. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332245\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-display/display-contents-svg-pseudo-crash.html"], "git_node": "a12d1f77df06229fbcf34aaffa835bae800ecf00", "git_parents": ["e54211ea08efc3e4a6440739aa173b9edfc83b67"], "node": "ada9aff668bcab2f2a8f4d0bdeee200013d482e3", "parents": ["3c0c9d5e533ae230e2adbae1461a2bde7c7718c9"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2074786 - Make `HTMLEditor::HandleInsertText` not delete unnecessary `\u003cbr\u003e` immediately before `\u003cspan _moz_quote=\"true\"\u003e` r=m_kato\n\nIt's unnecessary for the layout, but it's necessary for the serializer.\nTherefore, it's actually necessary one for plain email composer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330087\n", "files": ["editor/libeditor/HTMLEditSubActionHandler.cpp", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/WSRunScanner.h", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_mailcite_insert_text_after_split.html"], "git_node": "f49843c27d7945ca589cc69694b6fc0778677b22", "git_parents": ["a12d1f77df06229fbcf34aaffa835bae800ecf00"], "node": "44ac02cc1651bc5073e07356c8e5a45de44f1cd1", "parents": ["ada9aff668bcab2f2a8f4d0bdeee200013d482e3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2077035 - Remove untested and dubious visitedWeight target radius. r=masayuki\n\nI don't think it's worth it. It's pretty dubious to favor a visited link\nin that way anyway, specially in the modern web where lots of links are\nused as buttons and so on.\n\nIt's also totally untested.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332153\n", "files": ["layout/base/PositionedEventTargeting.cpp", "layout/base/tests/test_event_target_radius.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "2ead387731c1ace82e8e23bf3f82022a92afc5f2", "git_parents": ["f49843c27d7945ca589cc69694b6fc0778677b22"], "node": "817909842a80f8a6af5534bbbc5c14c00706f51f", "parents": ["44ac02cc1651bc5073e07356c8e5a45de44f1cd1"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2023167 - Part 1: Reorganize EnterJITRegs on loong64 to allow easier frame chasing across JIT/native boundary. r=spidermonkey-reviewers,jandem\n\nThis moves the saved $fp to $fp+0 and saved $ra to $fp+8, which looks\nthe same as the JS ABI frame layout. This can aid LUL frame chasing that\nhas just walked the JS frames. The risk should be minimal since\nEnterJITRegs's layout should be opaque to deeper frames after all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313218\n", "files": ["js/src/jit/loong64/Trampoline-loong64.cpp"], "git_node": "02e58c546f0ab2bbe0665481e820454f3eec9a01", "git_parents": ["2ead387731c1ace82e8e23bf3f82022a92afc5f2"], "node": "cd275d1d76a2b934620b50bce46e3484906918bf", "parents": ["817909842a80f8a6af5534bbbc5c14c00706f51f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2023167 - Part 2: Reorganize EnterJITRegs on riscv64 to allow easier frame chasing across JIT/native boundary. r=spidermonkey-reviewers,jandem\n\nDitto for riscv64; see Part 1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313219\n", "files": ["js/src/jit/riscv64/Trampoline-riscv64.cpp"], "git_node": "ff3ec66db0f62e826f82af827a8c0507894b82fd", "git_parents": ["02e58c546f0ab2bbe0665481e820454f3eec9a01"], "node": "9cdf0d732b31f72fee178eb41b829c4c6c675730", "parents": ["cd275d1d76a2b934620b50bce46e3484906918bf"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2023167 - Part 3: Port Gecko Profiler to loongarch64-linux. r=profiler-reviewers,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287579\n", "files": ["mozglue/baseprofiler/core/platform-linux-an