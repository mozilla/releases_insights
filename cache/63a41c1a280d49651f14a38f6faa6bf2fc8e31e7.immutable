, "browser/components/urlbar/private/SuggestFeature.sys.mjs", "browser/components/urlbar/types/urlbar.ts", "browser/modules/Sanitizer.sys.mjs", "tools/@types/lib.gecko.custom.d.ts"], "git_node": "f2de3b1d85c8956d688e388e87490e81b5c86149", "git_parents": ["72c5004699d827fdd573252e47cac312466fd6ba"], "node": "eccdcdb176cb82558f59a81daa6d55aa48c8fa11", "parents": ["4a371b4428698b140f83a8e56a3885e49e6bd552"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2081329 - [wdspec] Revert wpt-sync meta data updates from bug 2077269. r=Sasha,webdriver-reviewers\n\nThis reverts commit 17a3c0f504d2c8e8130150e5f04e5ca081c6f7bc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333375\n", "files": ["testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_modifiers.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_shortcuts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_special_keys.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/key_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/navigation.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/none.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/perform.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_contextmenu.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_dblclick.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_modifier_click.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse_drag.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_origin.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_pause_dblclick.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_pen.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_touch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_touch_simultaneous.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_tripleclick.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/sequence.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_events.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_frame.py.ini"], "git_node": "703c629a891c33cfa5f0e3575adc0d77ff959d6c", "git_parents": ["f2de3b1d85c8956d688e388e87490e81b5c86149"], "node": "71c101762bfbe02a35cf1a8da217c3d06e9e6621", "parents": ["eccdcdb176cb82558f59a81daa6d55aa48c8fa11"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079750 - Stylelint: count background-image as painting a background in use-paired-color-tokens. r=hjones,desktop-theme-reviewers,tabbrowser-reviewers,kcochrane,czhou\n\nThe vertical tab audio overlay's inactive state now paints `--toolbox-text-color-inactive`, as the horizontal overlay does. It changes the icon color in an inactive window on native themes and under forced colors, and in no in-app theme beyond `#fff` becoming `#fbfbfe` in non-Nova dark.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332028\n", "files": ["browser/components/aiwindow/ui/content/firstrun.css", "browser/themes/shared/tabbrowser/tabs.css", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "tools/lint/stylelint/stylelint-plugin-mozilla/helpers.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.no-text-color.tests.mjs"], "git_node": "68d4f29721fe9d7b18ed200e6875921ff71fca1e", "git_parents": ["703c629a891c33cfa5f0e3575adc0d77ff959d6c"], "node": "35cb86af81321602ba37093796b759af65216780", "parents": ["71c101762bfbe02a35cf1a8da217c3d06e9e6621"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071822 - remove duplicate classes from androidTest dir. r=sfamisa\n\nThese break obfuscation and were not being used any more.\n\n`FxaServer` was previously used by `SyncIntegrationTest`, which is not currently run, so if this is ever restored we will have to figure out a minification-friendly way of doing this. (I've chatted to mobile test about this)\n\nsome more details:\n- The `androidTest` copies break once the build is minified. R8 rewrites the app's version, so the test copy no longer matches it.\n- The test `AppRequestInterceptor` had drifted from the real one. It was missing about:home handling, the story UTM interceptor, interceptsAppInitiatedRequests and the content-URI telemetry.\n- also, the test version of `AppRequestInterceptor` had different behaviour to the app one. The app one overrode `interceptsAppInitiatedRequests` to set it to true and the test one didn't, so it defaulted to false. This means that using the app one, you get a \"Open this link in xxx app?\" dialog which the tests didn't previously expect.\n\u003cimg width=\"304\" height=\"550\" alt=\"example of the app links dialog\" src=\"https://github.com/user-attachments/assets/cac27662-9c72-4e37-9ffe-13916cf9a1b5\" /\u003e\n\nI've fixed this by dismissing the dialog in `MainMenuTest`.\n\n[try is running here](https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=104609)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/388\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/components/FxaServer.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt"], "git_node": "92f9de0a78505d37884e9d7696a4368e4fd54f03", "git_parents": ["68d4f29721fe9d7b18ed200e6875921ff71fca1e"], "node": "7ad1ced2b9ac8565f04adc22084169614f92c9c0", "parents": ["35cb86af81321602ba37093796b759af65216780"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081740 - Run repo-update-pinning-update on b-linux workers. r=releng-reviewers,jcristau\n\nb-linux-medium also schedules workers in northamerica-northeast1, where the task currently times out. b-linux\nonly uses us-central1 and us-west1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333631\n", "files": ["taskcluster/kinds/repo-update/kind.yml"], "git_node": "ec8788f98b13cee02c69e7d2c59e5c36eaf63059", "git_parents": ["92f9de0a78505d37884e9d7696a4368e4fd54f03"], "node": "127dc4e5c4dc3c4863b4b8559c445b556f9159d0", "parents": ["7ad1ced2b9ac8565f04adc22084169614f92c9c0"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081648 - delete treescript worker aliases and payload builder. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333568\n", "files": ["taskcluster/config.yml", "taskcluster/docs/kinds.md", "taskcluster/docs/versioncontrol.md", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "8453c4381e2c168f9cea7ce8b9468aa7b5559a85", "git_parents": ["ec8788f98b13cee02c69e7d2c59e5c36eaf63059"], "node": "8f8756850b44446efb6e898f515e2e74b6fed3a7", "parents": ["127dc4e5c4dc3c4863b4b8559c445b556f9159d0"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2080525 - Move wasm SIMD lanes directly between vectors on arm64. r=yury\n\nA replace_lane whose value comes from an extract_lane of an equal or wider\nlane previously went through a general register, as `umov w, v.s[i]` then\n`mov v.b[j], w`. Fold such a pair into a new MWasmMoveLaneSimd128 when the\nplatform supports it, and on arm64 emit it as one `mov v.b[j], v.b[k]` (INS\nelement).\n\nOn the JetStream 3 wasm Ion code this replaces 5,666 GPR round trips.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332711\n", "files": ["js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane-arm64-ion-codegen.js", "js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane.js", "js/src/jit/MIR-wasm.cpp", "js/src/jit/MIR-wasm.h", "js/src/jit/MIROps.yaml", "js/src/jit/arm/CodeGenerator-arm.cpp", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.cpp", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/mips-shared/CodeGenerator-mips-shared.cpp", "js/src/jit/mips-shared/Lowering-mips-shared.cpp", "js/src/jit/riscv64/CodeGenerator-riscv64.cpp", "js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/wasm32/CodeGenerator-wasm32.cpp", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.cpp"], "git_node": "d972f29cf0a61805fb0945335e8f479023acb9b5", "git_parents": ["8453c4381e2c168f9cea7ce8b9468aa7b5559a85"], "node": "b025de4903d80373e068cf9dd519336f76cce235", "parents": ["8f8756850b44446efb6e898f515e2e74b6fed3a7"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072458 - Always start focus navigation from focused content if it's a popover invoker. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333356\n", "files": ["dom/base/nsFocusManager.cpp", "testing/web-platform/tests/html/semantics/popovers/popover-focus-source-contenteditable.html"], "git_node": "7c8835ea32b20d0f3f6118bc27e1b3647015ecba", "git_parents": ["d972f29cf0a61805fb0945335e8f479023acb9b5"], "node": "35e2dc2fffa7f76c3569626f180e7215c01ef0ce", "parents": ["b025de4903d80373e068cf9dd519336f76cce235"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079614 - [customizable-menu] Support sandboxed custom tabs r=android-reviewers,petru\" for causing fenix-debug failures @ OpenInFirefoxMenuItemProviderTest.kt\n\nThis reverts commit 77e208bcf7dca1ae77481a2721bf63235a197a4d.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactory.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuTarget.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProviderTest.kt"], "git_node": "306b8a57082890811207418bc739e0904e45ef3f", "git_parents": ["7c8835ea32b20d0f3f6118bc27e1b3647015ecba"], "node": "a7897a18fa033fa191882f1789975d029a13922b", "parents": ["35e2dc2fffa7f76c3569626f180e7215c01ef0ce"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034023 - Disable fullscreen keyboard-lock WPTs on macOS debug r=jgraham\n\nThey hit the mFullscreenChangeState assertion in AppWindow::FullscreenWillChange\nmuch more often now that macOS aarch64 runs testharness with 3 processes\n(bug 2050488). Re-enable once the race is fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332905\n", "files": ["testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-change.window.js.ini", "testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-escape.window.js.ini", "testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-multiple-elements.window.js.ini", "testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-shadowdom.window.js.ini", "testing/web-platform/meta/fullscreen/api/keyboard-lock-cross-origin-iframe.sub.html.ini"], "git_node": "988a5ed4dfdc0d292921ce59b8d734846dcd0ce1", "git_parents": ["306b8a57082890811207418bc739e0904e45ef3f"], "node": "0865a3163dec2750256db947d97006119dcfd82f", "parents": ["a7897a18fa033fa191882f1789975d029a13922b"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079196 - Remove SameObject attribute from window.pushManager. r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333319\n", "files": ["dom/webidl/PushManager.webidl"], "git_node": "f3ec5d8c08d3fbbd736cb82cfad6bce946d78f89", "git_parents": ["988a5ed4dfdc0d292921ce59b8d734846dcd0ce1"], "node": "c4ff147d054fafcc3e7f37b6b0733cab1338221c", "parents": ["0865a3163dec2750256db947d97006119dcfd82f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2071898 - Don't bold the body text of the speech recognition model download doorhanger. r=desktop-theme-reviewers,sfoster\n\nThis doorhanger has its own heading, so the description below it is body text,\nbut .popup-notification-description is semibold for every doorhanger because in\nthe usual case that description is the headline.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325901\n", "files": ["browser/base/content/popup-notifications.inc.xhtml", "browser/themes/shared/browser-shared.css"], "git_node": "811ae855aa12b8c68d49f3a8b67fb8de9db9b20c", "git_parents": ["f3ec5d8c08d3fbbd736cb82cfad6bce946d78f89"], "node": "6a252607112978b0b808c23d47aef280e27c19ff", "parents": ["c4ff147d054fafcc3e7f37b6b0733cab1338221c"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2081549 - ImageDocument should use the right token list, r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333622\n", "files": ["dom/html/ImageDocument.cpp"], "git_node": "784857b04694d24d538847bcc7bc252e3ac6988a", "git_parents": ["811ae855aa12b8c68d49f3a8b67fb8de9db9b20c"], "node": "bc8aca659b63bbe294d458485dcc16f1b598008c", "parents": ["6a252607112978b0b808c23d47aef280e27c19ff"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081669 - Update wpt metadata for clipboard-read-enabled-on-self-origin-by-permissions-policy.tentative.https.sub.html on macOS 15. r=sasha\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-on-self-origin-by-permissions-policy.tentative.https.sub.html.ini"], "git_node": "9b48d4d25b91347d52b185dafb9d6c38d174eab7", "git_parents": ["784857b04694d24d538847bcc7bc252e3ac6988a"], "node": "02e669248e63f1b6fd85415742df2583df1c0453", "parents": ["bc8aca659b63bbe294d458485dcc16f1b598008c"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2080674 - Stop if mSharePromise doesn't exist r=dom-core-reviewers,avandolder\n\nCan't test because we currently don't have a way to close share window. (We open Windows system popup currently.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333334\n", "files": ["dom/base/Navigator.cpp"], "git_node": "2742739a1db350834f0403919fb6186cccbd078a", "git_parents": ["9b48d4d25b91347d52b185dafb9d6c38d174eab7"], "node": "94f1951ba9d448c7cf7bcdc42e8353facc1d7c0d", "parents": ["02e669248e63f1b6fd85415742df2583df1c0453"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Fix incorrect TypeError assertions in CSSNumericValue arithmetic WPT; r=emilio,firefox-style-system-reviewers\n\nRemove an erroneous `new` from the CSSNumericValue arithmetic tests for\nincompatible types.\n\nThe `new` operator causes a TypeError before the arithmetic method is invoked,\nallowing the tests to pass without actually verifying the expected behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333602\n", "files": ["testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js"], "git_node": "44d65fb49765b24796e171d6ec22a5d2436c28e6", "git_parents": ["2742739a1db350834f0403919fb6186cccbd078a"], "node": "6de08b59e8feea898d46cc38d1efe02a8d918245", "parents": ["94f1951ba9d448c7cf7bcdc42e8353facc1d7c0d"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079353 - Remove mirroring to now-unused Legacy Telemetry passwordmanager probes r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332154\n", "files": ["toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "e6a4130b1b8df058354f1ab47a073cb3315cc55e", "git_parents": ["44d65fb49765b24796e171d6ec22a5d2436c28e6"], "node": "3f3cff6961a61b0e4682afbfdc93678bdac08460", "parents": ["6de08b59e8feea898d46cc38d1efe02a8d918245"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079353 - Migrate pwmgr browser tests to Glean r=mtigley,settings-reviewers,credential-management-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332155\n", "files": ["browser/components/aboutlogins/tests/browser/browser_aaa_eventTelemetry_run_first.js", "browser/components/aboutlogins/tests/browser/browser_breachAlertLinkTelemetry.js", "browser/components/aboutlogins/tests/browser/browser_openExport.js", "browser/components/aboutlogins/tests/browser/browser_openImport.js", "browser/components/aboutlogins/tests/browser/browser_openImportCSV.js", "browser/components/aboutlogins/tests/browser/browser_openPreferences.js", "browser/components/aboutlogins/tests/browser/head.js", "browser/components/preferences/tests/credentials/browser_password_management.js", "browser/components/preferences/tests/credentials/browser_password_management_xul.js", "toolkit/components/passwordmgr/test/LoginTestUtils.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_footer.js", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_generated_password_private_window.js", "toolkit/components/passwordmgr/test/browser/browser_context_menu.js", "toolkit/components/passwordmgr/test/browser/browser_entry_point_telemetry.js", "toolkit/components/passwordmgr/test/browser/browser_relay_telemetry.js", "toolkit/components/passwordmgr/test/browser/browser_relay_utils.js", "toolkit/components/passwordmgr/test/browser/browser_telemetry_SignUpFormRuleset.js", "toolkit/components/passwordmgr/test/browser/browser_username_only_form_telemetry.js", "toolkit/components/passwordmgr/test/browser/head.js"], "git_node": "2103805ec9884b4889b70118dbe41f7d45cac087", "git_parents": ["e6a4130b1b8df058354f1ab47a073cb3315cc55e"], "node": "759e191fbb48d64c53fe8cefb0ada5bc42703b8c", "parents": ["3f3cff6961a61b0e4682afbfdc93678bdac08460"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079353 - Migrate pwmgr mochitests away from Legacy Telemetry r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332156\n", "files": ["toolkit/components/passwordmgr/test/mochitest/pwmgr_common.js", "toolk