anslator ReferenceDrawTargetTransform handling for PushLayerWithBlend and CreateClippedDrawTarget. r=lsalzman\"\n\nThis reverts commit 1531436f01d206ad752a7cba68ce3d10b4771bd8.\n", "files": ["gfx/2d/2D.h", "gfx/2d/DrawTarget.cpp", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetRecording.h", "gfx/2d/HelpersSkia.h", "gfx/2d/RecordedEventImpl.h", "gfx/skia/gdi/SkGDIDocument.cpp", "gfx/skia/gdi/SkGDIDocument.h", "gfx/thebes/PrintTargetWindows.cpp", "testing/web-platform/tests/css/css-masking/mask-image/mask-image-cross-site-iframe-offset-ref.html", "testing/web-platform/tests/css/css-masking/mask-image/mask-image-cross-site-iframe-offset.sub.html", "testing/web-platform/tests/css/css-masking/mask-image/support/mask-image-cross-site-iframe-offset-frame.html"], "git_node": "d0d4af3c69ea85c292cbbdf68ae00126d5bae45b", "git_parents": ["2f0328609212d2641db213f41fe2fc53f134dbfb"], "node": "f00936a460afc1151d0efd5a2e30da4fb85bcf41", "parents": ["649d936cf9b54092f10304bf167b2b24af1dd5dd"], "tags": []}], "date": 1792358310, "git_changesets": ["d56e5af2441d785bdff00ca3ae10b85e082cc2e3", "5d313b2a88a16939f521ad9a8491d28835a63767", "412a5287a1372cae50a3084ab49b2e6e9c408196", "c22f05c912c44f56c75a5a7a38ff3c1290739d63", "2623442ed1e34722ae23ca1a2fb5f4714cd36a37", "1531436f01d206ad752a7cba68ce3d10b4771bd8", "4ee5bd298855737d10a815c14038fa46517e3252", "f911b573c6043d0510193daffe86a4c3fdfc38f3", "bb80ca3b402c65110cbdc62d13439f56bedb3c43", "81f6afcdacb6d52351ec061e92fad1c3e88d4d0c", "62c78f9a4fa2a24f0cc8f796c193812a6070f3de", "35076368bddcc646c550db7d781854ce9f7871d4", "2f0d93fcd777f360faaa4cdffbe481a78ed782da", "f389be85d633642a107fc0a8bd66347634be96e1", "d4dad554468ad3519667b6b9a080f9ad885a2f5e", "fb21bb8bcd3723bffa79e7b06c331d1146b0c4f2", "2f0328609212d2641db213f41fe2fc53f134dbfb", "d0d4af3c69ea85c292cbbdf68ae00126d5bae45b"], "user": "nfay@mozilla.com"}, "45585": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes ct-logs r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334996\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "0d328c1e6d83674bdacf125ba822d34a8ded6eb6", "git_parents": ["d0d4af3c69ea85c292cbbdf68ae00126d5bae45b"], "node": "de7c57dad035f398a660db7d6ae7e8d6351d3e08", "parents": ["f00936a460afc1151d0efd5a2e30da4fb85bcf41"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082794 - Don't snap very small font-size to integer appUnits, to avoid tiny values going to zero. r=firefox-style-system-reviewers,emilio\n\nOnly including a mismatch reftest for now, to confirm that the tiny-then-scaled text\ndoes not render blank. A proper matching reftest would be nice but currently ends up\nwith a huge amount of \"fuzz\" due to blurry rendering of the extremely-scaled test;\nsee bug 2082801.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334986\n", "files": ["servo/components/style/values/specified/font.rs", "testing/web-platform/tests/svg/text/reftests/tiny-text-with-scaling.html"], "git_node": "0a1bb6167c47bee171b01b37f680d7b4f61ba95e", "git_parents": ["0d328c1e6d83674bdacf125ba822d34a8ded6eb6"], "node": "9828e32964d39f5fe013823857ae63cf002a6205", "parents": ["de7c57dad035f398a660db7d6ae7e8d6351d3e08"], "tags": []}, {"author": "Abel Kalu \u003c59095867+BlessedOneKobo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2053552 - Remove unused preferences for extensions.webcompat-report.*. r=mconley,firefox-desktop-core-reviewers ,twisniewski\n\nUnused preferences removed:\n- extensions.webcompat-reporter.newIssueEndpoint\n- extensions.webcompat-reporter.enabled\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324645\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/installer/allowed-dupes.mn", "browser/modules/test/browser/head.js", "modules/libpref/init/all.js"], "git_node": "d756a07e8b4e16b3b82dda73257cfd6a3e634f4c", "git_parents": ["0a1bb6167c47bee171b01b37f680d7b4f61ba95e"], "node": "cbe9e8d793acd1cb667e010eb1d7b45f28f12b09", "parents": ["9828e32964d39f5fe013823857ae63cf002a6205"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083174 - Add a mapping of search access points to SAP in search-config-v3. r=jteow,search-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334745\n", "files": ["toolkit/components/search/SearchEngine.sys.mjs", "toolkit/components/search/SearchUtils.sys.mjs", "toolkit/components/search/schema/search-config-v3-schema.json", "toolkit/components/search/tests/xpcshell/test_getSubmission_partnerCode.js"], "git_node": "5e55d507da76298692d881ecb95513a8eac07667", "git_parents": ["d756a07e8b4e16b3b82dda73257cfd6a3e634f4c"], "node": "df3c5268c8ab2d6a95320aa2dea88f863a52ed83", "parents": ["cbe9e8d793acd1cb667e010eb1d7b45f28f12b09"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082000 - Clean up wrapper properly when the initialization fails; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334911\n", "files": ["dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "dom/bindings/DOMJSProxyHandler.cpp", "dom/bindings/DOMJSProxyHandler.h"], "git_node": "725cb0d437189f748de24bc87ca2a3c0de0cce61", "git_parents": ["5e55d507da76298692d881ecb95513a8eac07667"], "node": "db7891fbb8f6c62c5726fdb513da440ba3163458", "parents": ["df3c5268c8ab2d6a95320aa2dea88f863a52ed83"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079474 - Pt 1 - Find the region each backdrop-filter samples. r=gfx-reviewers,nical\n\nEach frame, record every reachable backdrop-filter chain's backdrop root,\ncapture primitive, and the area of the root surface its filters read. Nothing\nuses this yet beyond HIGHLIGHT_BACKDROP_FILTERS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333092\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture_graph.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "419add0ba12159578a4d243373d5b65d70b780f2", "git_parents": ["725cb0d437189f748de24bc87ca2a3c0de0cce61"], "node": "ea745deba60c0fedf66b9484bc128d7994abade8", "parents": ["db7891fbb8f6c62c5726fdb513da440ba3163458"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079474 - Pt 2 - Draw the primitives behind a backdrop-filter into its capture instead of copying them. r=gfx-reviewers,nical\n\nCopying the backdrop root's pixels required splitting its tasks around every\nbackdrop-filter. Instead, the capture is open on the backdrop root's surface\nfrom when the root is prepared until the capture's picture is, as one more\ntarget: each primitive behind the element emits its commands into it as well\nas the root's, so it is still prepared once, and the capture depends on the\nsame render tasks. The resolve is now unreachable and is removed in the\nfollowing patches.\n\nThe capture task is cleared and scissored to its content area, since a blur\nsamples its padding. The deferred dirty test covers the whole capture region,\nwhich a drop shadow can sample beyond the element.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333093\n", "files": ["gfx/wr/webrender/src/command_buffer.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/wrench/invalidation/backdrop_sampled_margin_1.yaml", "gfx/wr/wrench/invalidation/backdrop_sampled_margin_2.yaml", "gfx/wr/wrench/src/test_invalidation.rs"], "git_node": "082843cfff04db14b5c901d217eff41b307adcd4", "git_parents": ["419add0ba12159578a4d243373d5b65d70b780f2"], "node": "fb3b55d32e19795736a8fa5738790a13bb79832d", "parents": ["ea745deba60c0fedf66b9484bc128d7994abade8"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079474 - Pt 3 - Remove the backdrop resolve. r=gfx-reviewers,nical\n\nNothing registers a resolve source any more, so the backdrop root's tasks are\nnever split.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333094\n", "files": ["gfx/wr/webrender/src/command_buffer.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/render_task_graph.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/surface.rs"], "git_node": "0e80fdc2259c2891f75fd543bdee65cea350d50e", "git_parents": ["082843cfff04db14b5c901d217eff41b307adcd4"], "node": "081c24ee1f83b529211386238a8c94c6287461fe", "parents": ["fb3b55d32e19795736a8fa5738790a13bb79832d"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079474 - Pt 4 - Remove the enlarged tile tasks and tile composites used for backdrop resolves. r=gfx-reviewers,nical\n\nTiles under a backdrop-filter rendered into an enlarged task, copied into the\ntile, so that the task could be split for the resolve. Nothing splits tile\ntasks any more.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333095\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/invalidation/cached_surface.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/wrench/reftests/filters/backdrop-filter-transformed-filter.png"], "git_node": "43c79f86c7884f38a9d77b7892c3b10abf9e85d5", "git_parents": ["0e80fdc2259c2891f75fd543bdee65cea350d50e"], "node": "17b22abfced190cb998baec5c762eba062d65fd8", "parents": ["081c24ee1f83b529211386238a8c94c6287461fe"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079474 - Pt 5 - Remove the backdrop sub-graph bookkeeping and PictureFlags::IS_RESOLVE_TARGET. r=gfx-reviewers,nical\n\nA capture needed a render target of its own for the resolve to copy into. It\nnow clears and scissors its own task, so it can share one, and a chain's\nsurface is popped like any other.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333096\n", "files": ["gfx/wr/webrender/src/command_buffer.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "b51d8c2c35a398d26ae3ce2a675a102a815cc3eb", "git_parents": ["43c79f86c7884f38a9d77b7892c3b10abf9e85d5"], "node": "59fe71d7c538f279675307dd566f9846e80014d3", "parents": ["17b22abfced190cb998baec5c762eba062d65fd8"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078839 - Add Solitaire widget scaffold. r=fluent-reviewers,Dre,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333491\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Solitaire/Solitaire.jsx", "browser/extensions/newtab/content-src/components/Widgets/Solitaire/_Solitaire.scss", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Solitaire.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "60a601d307659b159d209f1f575708893bea07b4", "git_parents": ["b51d8c2c35a398d26ae3ce2a675a102a815cc3eb"], "node": "ba6c76175a74028c7b4a1feefedc5021aedba511", "parents": ["59fe71d7c538f279675307dd566f9846e80014d3"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/browser/menu/src/main/res/values-az/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/compose/browser-toolbar/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/app-links/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/app-links/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/contextmenu/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/downloads/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/importer/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/importer/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/media/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/password-importer/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/protection-dashboard/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-az/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/lib/crash/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/res/values-skr/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-skr/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-sq/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-skr/strings.xml", "mobile/android/fenix/app/src/main/res/values-sq/strings.xml", "mobile/android/focus-android/app/src/main/res/values-da/strings.xml"], "git_node": "581dc844ced2661b8885cb11f61bbd2faaa10cea", "git_parents": ["60a601d307659b159d209f1f575708893bea07b4"], "node": "2b71c25735d07c2a04faf903ae9efacf6fbe7679", "parents": ["ba6c76175a74028c7b4a1feefedc5021aedba511"], "tags": []}, {"author": "Logan Rosen \u003cloganrosen@gmail.com\u003e", "branch": "default", "desc": "Bug 2081639 - Bump rtoml to 0.14.0 in the taskgraph lockfile. r=taskgraph-reviewers,bhearsum\n\nrtoml 0.13.0 has no Python 3.15 wheels, and building it from source fails\nbecause its PyO3 doesn't support 3.15. That breaks the taskgraph site, which\nconfigure needs to bootstrap toolchains.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334920\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt"], "git_node": "3e4a63fca19b66665c8ccbbc73149471c480fa59", "git_parents": ["581dc844ced2661b8885cb11f61bbd2faaa10cea"], "node": "f1cc89b1b9e4c0bb755b456b67a1d991fc62976a", "parents": ["2b71c25735d07c2a04faf903ae9efacf6fbe7679"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083060 - Update mots for Picture-in-Picture. r=niklas,shtrom DONTBUILD\n\nThis patch:\n\n1. Adds the Mini Window feature to the Picture-in-Picture module scope of\n   responsibility, per discussion with Harshit Sohaney and Ania Safko.\n2. Adds Harshit Sohaney as a peer to the Picture-in-Picture module.\n3. Transfers ownership of the Picture-in-Picture module from Mike Conley\n   to Katherine Patenio.\n4. Moves Mike Conley to owner emeritus.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334672\n", "files": ["mots.yaml"], "git_node": "b827b7f0b04b30f8bb849e0e8618e78935f1840d", "git_parents": ["3e4a63fca19b66665c8ccbbc73149471c480fa59"], "node": "c62168eadf8da22928c55d6fe79670f317f20c76", "parents": ["f1cc89b1b9e4c0bb755b456b67a1d991fc62976a"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069301 - p1. Move the dl_iterate_phdr callback into a new class r=mstange,profiler-reviewers\n\nBy moving the dl_iterate_phdr callback into a new class the class\nmembers can be used as state.  This also lets us remove the temporary\nvector of LoadedLibraryInfo objects and the LoadedLibraryInfo class.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327295\n", "files": ["mozglue/baseprofiler/core/shared-libraries-linux.cc"], "git_node": "057f10b61b4059138614905886c6dc4c856ec011", "git_parents": ["b827b7f0b04b30f8bb849e0e8618e78935f1840d"], "node": "02a2c6673e4b080cd73f7324785404d9464f4eff", "parents": ["c62168eadf8da22928c55d6fe79670f317f20c76"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069301 - p2. Avoid some raw C-style strings r=mstange,profiler-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327296\n", "files": ["mozglue/baseprofiler/core/shared-libraries-linux.cc"], "git_node": "744f3f39483c512705bae1afa45cd2c8fd6df46f", "git_parents": ["057f10b61b4059138614905886c6dc4c856ec011"], "node": "d5115e3c0f9cce35406a64a3e10b02cc8520b33c", "parents": ["02a2c6673e4b080cd73f7324785404d9464f4eff"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069301 - p3. Identify the main executable from the aux vector r=jld,mstange,profiler-reviewers\n\nOn Linux the profiler can avoid system calls during GetInfoForSelf()\nwhich prevents it from falling afaul of sandboxing restrictions.\n\nThe ELF auxiliary vector can be used to find the path of the executable\n(AF_EXECFN).  Also because the first object retrieved by dl_iterate_phdr\nis the executable detecting the executable can be simplified.\n\nThe profiler still uses /proc/self/maps on Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323963\n", "files": ["mozglue/baseprofiler/core/shared-libraries-linux.cc", "tools/profiler/tests/xpcshell/test_shared_library.js"], "git_node": "813010038c5194e2cb21088365105e9760707c5d", "git_parents": ["744f3f39483c512705bae1afa45cd2c8fd6df46f"], "node": "228ee5305c70396d639f6223384e6797952848d4", "parents": ["d5115e3c0f9cce35406a64a3e10b02cc8520b33c"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1903924 - Set initiator type in ValidateRequestWithNewChannel. r=dom-core-reviewers,hsivonen\n\nWhen loading an image, we set initiator type on channel. But we forget\nsetting it when loading it from cache.\n\nWhen GeckoView with fission runs WPT, `input.html` test is failed due to\ndom.ipc.processCount.webIsolated=1. Also, this causes intermittent failures\nif image is from cache if content process isn't different, even if\ndesktop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334379\n", "files": ["image/imgLoader.cpp", "image/imgLoader.h", "testing/web-platform/meta/resource-timing/initiator-type/input.html.ini"], "git_node": "27d1e6edf83434dcf77917556e92e45e80206120", "git_parents": ["813010038c5194e2cb21088365105e9760707c5d"], "node": "0c49b43add763793c2da77dce7ec9074d3139ecc", "parents": ["228ee5305c70396d639f6223384e6797952848d4"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082376: When handling a query for an MSAA id, skip any top level remote docs that are print docs. r=accessibility-platform-reviewers,emilio,morgan\n\nPrint documents aren't exposed to platform accessibility APIs, so they don't get an MsaaDocAccessible.\nPreviously, we assumed all documents had an MsaaDocAccessible and thus crashed when we encountered a print doc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334399\n", "files": ["accessible/windows/msaa/MsaaAccessible.cpp"], "git_node": "d538134e94af12e76f548e3200adfbc42990d672", "git_parents": ["27d1e6edf83434dcf77917556e92e45e80206120"], "node": "ad905442661a653e877312fdac39e0e9e449d52e", "parents": ["0c49b43add763793c2da77dce7ec9074d3139ecc"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083426 - Defer throwing webglcontextcreationerror until after UpdateContext. r=gfx-reviewers,ahale\n\nThis refactors UpdateContext so that the two use-cases, context initialization and context updating\nare now separate entry points that call InitOrUpdateContext. Inside InitOrUpdateContext, SetDimensions\nmay cause a context creation error to be deferred. Upon return from InitOrUpdateContext, if there is\na failure, then MaybeThrowContextCreationError will be called on the context to trigger it, but only\nafter any appropriate failure cleanup has been done first. On success, where there is no context\ncreation error, then AfterUpdateContext is called instead to let inheritors derive further behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334926\n", "files": ["dom/canvas/CanvasRenderingContextHelper.cpp", "dom/canvas/CanvasRenderingContextHelper.h", "dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ClientWebGLContext.h", "dom/canvas/nsICanvasRenderingContextInternal.h", "dom/html/HTMLCanvasElement.cpp", "dom/html/HTMLCanvasElement.h"], "git_node": "4cc8cf47fb8a24efd78e3cb8b1a56c5066b4924d", "git_parents": ["d538134e94af12e76f548e3200adfbc42990d672"], "node": "0fdb388b069342e66533ebb161fa42201d0c19ee", "parents": ["ad905442661a653e877312fdac39e0e9e449d52e"], "tags": []}], "date": 1792395240, "git_changesets": ["0d328c1e6d83674bdacf125ba822d34a8ded6eb6", "0a1bb6167c47bee171b01b37f680d7b4f61ba95e", "d756a07e8b4e16b3b82dda73257cfd6a3e634f4c", "5e55d507da76298692d881ecb95513a8eac07667", "725cb0d437189f748de24bc87ca2a3c0de0cce61", "419add0ba12159578a4d243373d5b65d70b780f2", "082843cfff04db14b5c901d217eff41b307adcd4", "0e80fdc2259c2891f75fd543bdee65cea350d50e", "43c79f86c7884f38a9d77b7892c3b10abf9e85d5", "b51d8c2c35a398d26ae3ce2a675a102a815cc3eb", "60a601d307659b159d209f1f575708893bea07b4", "581dc844ced2661b8885cb11f61bbd2faaa10cea", "3e4a63fca19b66665c8ccbbc73149471c480fa59", "b827b7f0b04b30f8bb849e0e8618e78935f1840d", "057f10b61b4059138614905886c6dc4c856ec011", "744f3f39483c512705bae1afa45cd2c8fd6df46f", "813010038c5194e2cb21088365105e9760707c5d", "27d1e6edf83434dcf77917556e92e45e80206120", "d538134e94af12e76f548e3200adfbc42990d672", "4cc8cf47fb8a24efd78e3cb8b1a56c5066b4924d"], "user": "smolnar@mozilla.com"}, "45586": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6b01f55b37938d2c57530fadb14664b20abc61c9 with FIREFOX_159_0b4_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "2804bcd12231fe80e9137c871ca960a72766394c", "git_parents": ["0dd3fa218003a13a22e83363ce6306d5eb1c51dd"], "node": "170d6ce6fb34bd39e6ef901490c4d911f50374ef", "parents": ["7a3f241513d33798aa15c100ccc6d004041d2216"], "tags": []}], "date": 1792415123, "git_changesets": ["2804bcd12231fe80e9137c871ca960a72766394c"], "user": "ffxbld@lando.moz.tools"}, "45587": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6b01f55b37938d2c57530fadb14664b20abc61c9 with FIREFOX-ANDROID_159_0b4_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7ee98d72915aeb0fa1d8d83263fbfa2c5ee22a69", "git_parents": ["2804bcd12231fe80e9137c871ca960a72766394c"], "node": "63557ca1c87e78b5dc81c13801178b78ca71ff88", "parents": ["170d6ce6fb34bd39e6ef901490c4d911f50374ef"], "tags": []}], "date": 1792415202, "git_changesets": ["7ee98d72915aeb0fa1d8d83263fbfa2c5ee22a69"], "user": "ffxbld@lando.moz.tools"}, "45588": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6b01f55b37938d2c57530fadb14664b20abc61c9 with DEVEDITION_159_0b4_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "cb9985d5c93805641a0d5ee8a32e5e70384aee73", "git_parents": ["7ee98d72915aeb0fa1d8d83263fbfa2c5ee22a69"], "node": "3538fedf8f5cff29bb59ed87537d371f036087b8", "parents": ["63557ca1c87e78b5dc81c13801178b78ca71ff88"], "tags": []}], "date": 1792415283, "git_changesets": ["cb9985d5c93805641a0d5ee8a32e5e70384aee73"], "user": "ffxbld@lando.moz.tools"}, "45589": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6b01f55b37938d2c57530fadb14664b20abc61c9 with FIREFOX-ANDROID_159_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "31d86d7b29ca686ad9a8c227cf9bb3f314057955", "git_parents": ["cb9985d5c93805641a0d5ee8a32e5e70384aee73"], "node": "268a472dd3acdc96d4adaab7a9c01f951e372a64", "parents": ["3538fedf8f5cff29bb59ed87537d371f036087b8"], "tags": []}], "date": 1792416779, "git_changesets": ["31d86d7b29ca686ad9a8c227cf9bb3f314057955"], "user": "ffxbld@lando.moz.tools"}, "45590": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062341 - Install Windows import libraries under dist/lib/DIST_SUBDIR r=firefox-build-system-reviewers,ahochheiden\n\nbrowser/app/installation_dir_layout/{single,versioned} both build a SharedLibrary named InstallationDirLayout.\nThe DLLs go to different places (dist/bin vs dist/bin/installation_dir_layout/versioned thanks to\nDIST_SUBDIR), but the import libraries were both installed to dist/lib/InstallationDirLayout.lib. When the two\ndirectories build in parallel, the concurrent `nsinstall -R` calls race, and one of them fails with \"cannot\nmake symbolic link ...: File exists\".\n\nMake the import library destination mirror DIST_SUBDIR, like the DLL already does, so same-named libraries in\ndifferent DIST_SUBDIRs no longer collide. Only installation_dir_layout/versioned sets DIST_SUBDIR on a\nSharedLibrary, and nothing consumes InstallationDirLayout.lib from dist/lib (the DLL is loaded with\nLoadLibraryExW).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335021\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "c0ffd70891b4073fdd27ed602f788debd4c7677e", "git_parents": ["4cc8cf47fb8a24efd78e3cb8b1a56c5066b4924d"], "node": "d685199b9a2d6628783af8798c4680a9635217ee", "parents": ["0fdb388b069342e66533ebb161fa42201d0c19ee"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2083533: Remove about:config pref dom.text_fragments.enabled (which has been true for years). r=jjaschke,geckoview-reviewers,webidl,layout-reviewers,smaug,m_kato,TYLin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335011\n", "files": ["accessible/tests/browser/mac/browser.toml", "accessible/tests/browser/text/browser.toml", "browser/actors/ContextMenuParent.sys.mjs", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-scroll-to-text-fragment/browser.toml", "devtools/client/inspector/rules/test/browser_rules_pseudo-element_01.js", "devtools/server/tests/chrome/test_inspector-inactive-property-helper.html", "dom/base/Document.cpp", "dom/base/FragmentDirective.cpp", "dom/base/test/test_text-fragments-get-text-directive-ranges.html", "dom/webidl/Document.webidl", "dom/webidl/FragmentDirective.webidl", "layout/reftests/high-contrast/reftest.list", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/NavigationDelegateTest.kt", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-contain/__dir__.ini", "testing/web-platform/meta/css/css-pseudo/__dir__.ini", "testing/web-platform/meta/scroll-to-text-fragment/__dir__.ini"], "git_node": "b1970bfdd374c8896a99914009dd4f9b298e196a", "git_parents": ["c0ffd70891b4073fdd27ed602f788debd4c7677e"], "node": "7bbed634e75f220ea2922766e52a5663830a5bbc", "parents": ["d685199b9a2d6628783af8798c4680a9635217ee"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2078553 - Disable DMABUFTextureHostOGL recycling r=gfx-reviewers,lsalzman\n\nBack out Bug 2068330 fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335029\n", "files": ["gfx/layers/RemoteTextureMap.cpp"], "git_node": "99709e1e8633c5a131e0ebf9d9cfa95e2f07f444", "git_parents": ["b1970bfdd374c8896a99914009dd4f9b298e196a"], "node": "4363605d3063f29c1a5bef8121ea3ac8d5e957ae", "parents": ["7bbed634e75f220ea2922766e52a5663830a5bbc"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076336 part 1: nsIFrame::BuildDisplayListForChild: Set the accessibility node association before appending link items. r=layout-reviewers,dshin\n\nIn tagged PDF, link annotations need to be correctly associated with the struct tree element for the link.\nJust like content items, you do this with SkPDF by setting the accessibility node id before creating link annotations.\nPreviously, the accessibility node id was set after the link annotation was created.\nThis meant that the link annotation was associated with the previous struct tree element, which probably wasn't a link.\nTo fix this, simply flip the calls around.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329716\n", "files": ["accessible/tests/browser/pdfOutput/browser_structTree.js", "accessible/tests/browser/pdfOutput/head.js", "layout/generic/nsIFrame.cpp"], "git_node": "e78b91cba7b62344e54dcac1751146b29daaea89", "git_parents": ["99709e1e8633c5a131e0ebf9d9cfa95e2f07f444"], "node": "0aa821251e1605068f1b8f2eb765bd578d04390b", "parents": ["4363605d3063f29c1a5bef8121ea3ac8d5e957ae"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076336 part 2: Don't generate link display items for descendants entirely covered by the link element's frame. r=layout-reviewers,dshin\n\nPreviously, every descendant frame of a link element generated its own link display item, even when it was entirely covered by the link element's frame.\nThis produced redundant link annotations in PDF output.\nWhile this wasn't really noticeable for most users, with tagged PDF, each of them was attached to a struct element, resulting in multiple semantic links.\nThe link element's frame bounds and reference frame are now recorded on the display list builder.\nDescendants with the same reference frame whose bounds are contained within the bounds of the link no longer generate a link.\nDescendants which extend outside the link element's frame still generate their own link, as otherwise, those parts of the link wouldn't be clickable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329717\n", "files": ["accessible/tests/browser/pdfOutput/browser_structTree.js", "layout/generic/nsIFrame.cpp", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h"], "git_node": "d3df50aa5d12bf4a1fe22057715b0fca51be19e8", "git_parents": ["e78b91cba7b62344e54dcac1751146b29daaea89"], "node": "8c951043f9cc8979e651dd8717f58660992cde2c", "parents": ["0aa821251e1605068f1b8f2eb765bd578d04390b"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2081953 - Ensure old principal is not deleted immediately when swapping realm principals. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334570\n", "files": ["dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsGlobalWindowOuter.cpp"], "git_node": "5e5161b4fa63119a0de91b6e89015e88cf84f747", "git_parents": ["d3df50aa5d12bf4a1fe22057715b0fca51be19e8"], "node": "fddcdbd848dda6264a713c65c64172d860208344", "parents": ["8c951043f9cc8979e651dd8717f58660992cde2c"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083542 - Update PDF.js to 28e406a46fcca6591b96f943d98a739b8866da78 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335020\n", "files": ["toolkit/components/pdfjs/PdfJsDefaultPrefs.js", "toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.css", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "58ceda34c8348c4e460d59d3db87e87d28231af7", "git_parents": ["5e5161b4fa63119a0de91b6e89015e88cf84f747"], "node": "de9f36f14046ec62e6e9a573b67d0cfd44c4a5d1", "parents": ["fddcdbd848dda6264a713c65c64172d860208344"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081128 - [bidi] Reject unsafe commands for container-restricted sessions r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333992\n", "files": ["remote/webdriver-bidi/modules/RootBiDiModule.sys.mjs", "remote/webdriver-bidi/modules/root/browser.sys.mjs", "remote/webdriver-bidi/modules/root/browsingContext.sys.mjs", "remote/webdriver-bidi/modules/root/input.sys.mjs", "remote/webdriver-bidi/modules/root/network.sys.mjs", "remote/webdriver-bidi/modules/root/script.sys.mjs", "remote/webdriver-bidi/modules/root/session.sys.mjs", "testing/web-platform/mozilla/meta/webdriver/bidi/browser/create_user_context/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browser/get_client_windows/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bidi/browser/get_user_contexts/container_isolation.py.ini", "testing/web-platform/mozilla/meta/webdriver/bid