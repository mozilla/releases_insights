1be7546aa47802028c559d548acf", "92fb7271ad3dd9ee2bf23b956207b50e7bae8872", "b363a218a9d38bdbf30846f522f7655c0f5044c7", "3171262319bd17b9b427647918af620364a6f890"], "user": "asilaghi@mozilla.com"}, "45601": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX-ANDROID_158_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "1d76cde920e30954fc9e723aaf6ff4f43ef7c141", "git_parents": ["c4485f6da107f16515b24c791f71104056baa001"], "node": "15fbf6ba365ce6f84e03b26f33155d924f94b14e", "parents": ["7dc2b9feb5c0ceb4818f8f615981573e8a971e0f"], "tags": []}], "date": 1792501626, "git_changesets": ["1d76cde920e30954fc9e723aaf6ff4f43ef7c141"], "user": "ffxbld@lando.moz.tools"}, "45602": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX_158_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "5a5aafa93651b737e7b7c55629ba497b464f2fa2", "git_parents": ["1d76cde920e30954fc9e723aaf6ff4f43ef7c141"], "node": "8cee5ed296e3d81de1fc271b44fdd6c02da65784", "parents": ["15fbf6ba365ce6f84e03b26f33155d924f94b14e"], "tags": []}], "date": 1792501684, "git_changesets": ["5a5aafa93651b737e7b7c55629ba497b464f2fa2"], "user": "ffxbld@lando.moz.tools"}, "45603": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4de1925a46a49f026e71c4c0460230e6f39f5d9d with FIREFOX_115_43_1esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "00dac068356ec31db76b158ce982f3327eb51f0e", "git_parents": ["5a5aafa93651b737e7b7c55629ba497b464f2fa2"], "node": "18592600bb91258fb6b7b7cd9ae4c8115bd4b89b", "parents": ["8cee5ed296e3d81de1fc271b44fdd6c02da65784"], "tags": []}], "date": 1792503148, "git_changesets": ["00dac068356ec31db76b158ce982f3327eb51f0e"], "user": "ffxbld@lando.moz.tools"}, "45604": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 46f5f658a8fe6751cb4ef704999da57fb1bf1ea2 with FIREFOX_153_5_1esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9dd7a51abddd1e2dd34d82490318e914f2b18121", "git_parents": ["00dac068356ec31db76b158ce982f3327eb51f0e"], "node": "3c559d110a9ddec32bd099ab7ce557cdc83b9748", "parents": ["18592600bb91258fb6b7b7cd9ae4c8115bd4b89b"], "tags": []}], "date": 1792504222, "git_changesets": ["9dd7a51abddd1e2dd34d82490318e914f2b18121"], "user": "ffxbld@lando.moz.tools"}, "45605": {"changesets": [{"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2079394 - Don't copy the last sample of a sleeping thread if it contains JIT return addresses. r=profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333840\n", "files": ["tools/profiler/core/ProfileBuffer.cpp", "tools/profiler/core/ProfileBuffer.h", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/core/ProfiledThreadData.h", "tools/profiler/core/platform.cpp", "tools/profiler/tests/gtest/ThreadProfileTest.cpp"], "git_node": "6613d03b9955d89ab3415646fd5fd67718fb2ceb", "git_parents": ["3171262319bd17b9b427647918af620364a6f890"], "node": "00b532543adea5e9bb10c9c90335886b630e04bf", "parents": ["7465fd49087be2f5ed80d69b5508207c8964e9f8"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2079394 - Resolve profiled JIT addresses by sample position, so that samples of collected code are not attributed to code that later reused its memory. r=iain,profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331737\n", "files": ["js/public/ProfilingFrameIterator.h", "js/src/jit/JitcodeMap.cpp", "js/src/jit/JitcodeMap.h", "js/src/jsapi-tests/moz.build", "js/src/jsapi-tests/testJitcodeGlobalTableReuse.cpp", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/core/ProfileBufferEntry.h"], "git_node": "735e859d81e1040ea781fbd2c4e834a96341443d", "git_parents": ["6613d03b9955d89ab3415646fd5fd67718fb2ceb"], "node": "3ce8a37ecd457f5551786dca23498b764aca6b59", "parents": ["00b532543adea5e9bb10c9c90335886b630e04bf"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2083914 - Tweak Chrome flags used during profiling. r=perftest-reviewers,kshampur DONTBUILD\n\nOur sample-to-JS-function attribution currently can't handle inlining.\nWe were passing --no-turbo-inlining but we forgot to pass --no-maglev-inlining,\nso inlining was still enabled for many JS functions.\n\nThis patch also removes the `--perf-prof` flag which has no effect on Windows.\n\nOn non-Windows platforms we currently don't have any Chrome profiling set up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335356\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py"], "git_node": "a1e3da16174f23f1e38be81ad617f80d34a531d0", "git_parents": ["735e859d81e1040ea781fbd2c4e834a96341443d"], "node": "062caa6ecdbac5f2c6850e569417fe41dc4bce8e", "parents": ["3ce8a37ecd457f5551786dca23498b764aca6b59"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2083769 - Fall back to glBufferSubData when the unsynchronized shared instance buffer mapping fails. r=gfx-reviewers,bradwerth\n\nSome drivers return NULL from glMapBufferRange for the unsynchronized write\ninto the shared instance buffer, which hit an assertion on the renderer\nthread. Write the same range with glBufferSubData instead, which keeps the\nbuffer, offset and vertex array bindings unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335354\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs"], "git_node": "73c26f5e4eb1f327d038736f0c3d6d41e42d7e20", "git_parents": ["a1e3da16174f23f1e38be81ad617f80d34a531d0"], "node": "f6a6c76789173dde9ff97d219fddb9a1a7cfeb7f", "parents": ["062caa6ecdbac5f2c6850e569417fe41dc4bce8e"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079272 - Update Win11 Guidance notification toast with new copy and illustration r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334696\n", "files": ["browser/components/asrouter/content/assets/windows-guidance-static.svg", "browser/components/asrouter/content/assets/windows-guidance.gif", "browser/components/asrouter/jar.mn", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "76ece1af15f56a318921cac8f6637fe9545c825c", "git_parents": ["73c26f5e4eb1f327d038736f0c3d6d41e42d7e20"], "node": "5efdae35a58db01a270872da92160629c1219821", "parents": ["f6a6c76789173dde9ff97d219fddb9a1a7cfeb7f"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2082154 - Count URL canonization uses in the urlbar r=adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334000\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser/browser_canonizeURL.js"], "git_node": "b179d5d594a7365ca293e1d8c7c717e50abbeb29", "git_parents": ["76ece1af15f56a318921cac8f6637fe9545c825c"], "node": "e855f944057054fd14687c7524f4c1802faa2a25", "parents": ["5efdae35a58db01a270872da92160629c1219821"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078993 - Add script blockers to entry point methods in AccessibleCaretManager. r=layout-reviewers,emilio\n\nThe testcase is added as a traditional crashtest because AccessibleCaret is not\na web feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335234\n", "files": ["layout/base/AccessibleCaretManager.cpp", "layout/base/crashtests/2078993-inner.xml", "layout/base/crashtests/2078993.html", "layout/base/crashtests/crashtests.list"], "git_node": "3b2ec32fd0bc72d6d4394839341db02c049620e4", "git_parents": ["b179d5d594a7365ca293e1d8c7c717e50abbeb29"], "node": "23cfde2da5a6a91e1c4c1833bde8521aef1b0096", "parents": ["e855f944057054fd14687c7524f4c1802faa2a25"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054943 - Truncate a long Picture of the Day author to one line. r=reemhamz\n\nA long author name can push the Picture of the Day source and license links out of view, even with Merino\u2019s 50-character limit. This truncates only the author to one line, leaving the links visible on the next line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334298\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/_PictureOfTheDay.scss"], "git_node": "7313ab3693532600ddaff3836e568bca94717ebe", "git_parents": ["3b2ec32fd0bc72d6d4394839341db02c049620e4"], "node": "1ab5f9f36506516ead740e9fc2ef641ec1571c91", "parents": ["23cfde2da5a6a91e1c4c1833bde8521aef1b0096"], "tags": []}, {"author": "Eemeli Aro \u003ceemeli@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076961 - Drop telemetry from browser language subdialog, bump expiry of remaining intl.ui.browser_language metrics. r=bolsson,settings-reviewers,mkennedy,janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334535\n", "files": ["browser/components/preferences/dialogs/browserLanguages.js", "browser/components/preferences/main.js", "browser/components/preferences/metrics.yaml", "browser/components/preferences/tests/languages/browser_browser_languages_subdialog.js", "toolkit/components/telemetry/Events.yaml", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "3ca037d52d0a34bb4e16de6700077ed091e027a0", "git_parents": ["7313ab3693532600ddaff3836e568bca94717ebe"], "node": "2ec454e68c173ac63f4709a93393bfb6e598fd78", "parents": ["1ab5f9f36506516ead740e9fc2ef641ec1571c91"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045195 part 1: Convert last_test_to_unload_testsuite from XUL to HTML. r=accessibility-platform-reviewers,eeejay\n\nThis test doesn't need XUL.\nAs XUL, it had to be loaded via a chrome:// URL from a staged copy, which meant local edits weren't picked up without re-staging.\nThis is purely cleanup; there is no change in test behaviour here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334479\n", "files": ["accessible/tests/crashtests/crashtests.list", "accessible/tests/crashtests/last_test_to_unload_testsuite.html", "accessible/tests/crashtests/last_test_to_unload_testsuite.xhtml"], "git_node": "53543e78da121a7963ad5bd1e21ae488d22976c3", "git_parents": ["3ca037d52d0a34bb4e16de6700077ed091e027a0"], "node": "be6d513cec875574f693b5f089aab67c58d7f8ab", "parents": ["2ec454e68c173ac63f4709a93393bfb6e598fd78"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045195 part 2: Ensure accessibility is instantiated for the accessibility crashtests. r=accessibility-platform-reviewers,eeejay\n\n448064.xhtml was supposed to instantiate accessibility for all subsequent tests in this directory.\nHowever, it did that in a timer which never fired before the harness moved on to the next test, so the code never ran.\nEven if it had, the reference was dropped once the test ended, which would cause accessibility to shut down before the subsequent tests ran.\nIt also only (ostensibly) instantiated accessibility in the content process, which doesn't exercise any of the IPC code.\n\nInstead, a new first test now instantiates accessibility via XPCOM in the parent process, which also enables all cache domains in all processes.\nThe reference is stashed on the reftest window so that accessibility stays alive until the last test releases it.\nThe last test now fails (by timing out) if accessibility isn't running, rather than just dumping an error which would likely go unnoticed (as was the case for many years).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334480\n", "files": ["accessible/tests/crashtests/crashtests.list", "accessible/tests/crashtests/first_test_to_load_testsuite.html", "accessible/tests/crashtests/last_test_to_unload_testsuite.html"], "git_node": "ce2efd3a28c360488495467defde9e87f5c2b8ef", "git_parents": ["53543e78da121a7963ad5bd1e21ae488d22976c3"], "node": "1dabc2dfd18077d8b23fe925445fa67803535d44", "parents": ["be6d513cec875574f693b5f089aab67c58d7f8ab"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045195 part 3: Make 448064.xhtml wait for its timers. r=accessibility-platform-reviewers,eeejay\n\nPreviously, the harness considered the test finished on load, so the timers which query accessibility and mutate the DOM never ran.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334481\n", "files": ["accessible/tests/crashtests/448064.xhtml"], "git_node": "e8f9503e8432daa8f4b2444ae9f4975499014b3a", "git_parents": ["ce2efd3a28c360488495467defde9e87f5c2b8ef"], "node": "752aab5df2e35259ad292aa2f482239e85f9640d", "parents": ["1dabc2dfd18077d8b23fe925445fa67803535d44"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080675 part 1: Have the XUL tabbox widget label tab panels with ariaLabelledByElements instead of computing the relation in accessibility code. r=accessibility-platform-reviewers,hjones,tabbrowser-reviewers,dao,eeejay\n\nXULTabAccessible and XULTabpanelAccessible computed LABEL_FOR and LABELLED_BY by calling the JS getRelatedElement methods, which can run arbitrary script from accessibility code.\nFor example, tabbrowser's getRelatedElement can insert a lazy browser in the middle of a restyle.\nInstead, the tabbox widget now sets ariaLabelledByElements on each panel, which the generic relation code already handles.\nXULTabpanelAccessible ignores the resulting name so that panels remain unnamed as before, since naming tabbrowser panels would cause redundant screen reader reporting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333996\n", "files": ["accessible/tests/mochitest/relations/a11y.toml", "accessible/tests/mochitest/relations/test_tabbox.xhtml", "accessible/tests/mochitest/relations/test_tabbrowser.xhtml", "accessible/xul/XULTabAccessible.cpp", "accessible/xul/XULTabAccessible.h", "toolkit/content/widgets/tabbox.js"], "git_node": "cc181191a197105ec1a5a3ff209d39a1718732a6", "git_parents": ["e8f9503e8432daa8f4b2444ae9f4975499014b3a"], "node": "8dddbae495ac70f563cfd120f0818a03d723eb33", "parents": ["752aab5df2e35259ad292aa2f482239e85f9640d"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080675 part 2: Remove nsIDOMXULRelatedElement. r=webidl,reusable-components-reviewers,hjones,saschanaz\n\nAccessibility was the only consumer of this interface.\nJS callers call getRelatedElement directly, so those methods remain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333997\n", "files": ["dom/base/Element.cpp", "dom/base/Element.h", "dom/interfaces/xul/moz.build", "dom/interfaces/xul/nsIDOMXULRelatedElement.idl", "toolkit/content/widgets/tabbox.js"], "git_node": "80ac90aeba483f20e0fd33b9ee12309b94bb5131", "git_parents": ["cc181191a197105ec1a5a3ff209d39a1718732a6"], "node": "2036b2a8dc10624329000a7c7147879d25fe5b61", "parents": ["8dddbae495ac70f563cfd120f0818a03d723eb33"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083298 part 1: Fix bugs in SkPDF namespace handling. r=gfx-reviewers,lsalzman\n\n1. In my original patch for this in bug 2055405, I mistakenly thought that the PDF namespace was inherited from the parent struct tree element.\n  This is incorrect: per ISO 32000-2 14.8.6.1, the namespace must be specified on every element if it isn't the default namespace.\n  This doesn't require a code change to SkPDF, but it does require a correction to a comment.\n2. As well as referencing a namespace dictionary from an element's NS entry, PDF requires us to list those dictionaries in the StructTreeRoot's Namespaces array.\n  We now include this array when we emit the StructTreeRoot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335032\n", "files": ["gfx/skia/skia/include/docs/SkPDFDocument.h", "gfx/skia/skia/src/pdf/SkPDFTag.cpp"], "git_node": "23ad121b49cd1b1e3133b7957bb55dc66e6d08d5", "git_parents": ["80ac90aeba483f20e0fd33b9ee12309b94bb5131"], "node": "2659b5d08582107f9afb14e090cc55a1a0a5850e", "parents": ["2036b2a8dc10624329000a7c7147879d25fe5b61"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083298 part 2: Various namespace fixes in tagged PDF output. r=accessibility-platform-reviewers,eeejay\n\n1. Contrary to my previous incorrect understanding, the namespace isn't inherited from the parent, so we must set the MathML namespace for all MathML elements.\n2. Because we specify a namespace anywhere, we must also specify the PDF 2.0 namespace for the Document element.\n  Other elements can be in the default namespace, though, so we don't need to specify a namespace for those.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335033\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp"], "git_node": "59d68ee3913c00f9df7c1d2da3aa7ccd86394861", "git_parents": ["23ad121b49cd1b1e3133b7957bb55dc66e6d08d5"], "node": "10fcb09f28f9417f2daec318dfe0a5cfc38f0101", "parents": ["2659b5d08582107f9afb14e090cc55a1a0a5850e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079394 - Resolve profiled JIT addresses by sample position, so that samples of collected code are not attributed to code that later reused its memory. r=iain,profiler-reviewers,canova\" for causing bustages in ThreadProfileTest.cpp.\n\nThis reverts commit 735e859d81e1040ea781fbd2c4e834a96341443d.\n\nRevert \"Bug 2079394 - Don't copy the last sample of a sleeping thread if it contains JIT return addresses. r=profiler-reviewers,canova\"\n\nThis reverts commit 6613d03b9955d89ab3415646fd5fd67718fb2ceb.\n", "files": ["js/public/ProfilingFrameIterator.h", "js/src/jit/JitcodeMap.cpp", "js/src/jit/JitcodeMap.h", "js/src/jsapi-tests/moz.build", "js/src/jsapi-tests/testJitcodeGlobalTableReuse.cpp", "tools/profiler/core/ProfileBuffer.cpp", "tools/profiler/core/ProfileBuffer.h", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/core/ProfileBufferEntry.h", "tools/profiler/core/ProfiledThreadData.h", "tools/profiler/core/platform.cpp", "tools/profiler/tests/gtest/ThreadProfileTest.cpp"], "git_node": "37ac928cfd31b9e5420482134f8f8b06108e8d66", "git_parents": ["59d68ee3913c00f9df7c1d2da3aa7ccd86394861"], "node": "cdcf7efafa41ec3855b86c2f301d2c27b99b4b91", "parents": ["10fcb09f28f9417f2daec318dfe0a5cfc38f0101"], "tags": []}, {"author": "Jack Boykin \u003cjtboykin.jb@gmail.com\u003e", "branch": "default", "desc": "Bug 2083549 - Don't reuse an audio stream that a pause stopped before the seek. r=media-playback-reviewers,alwu\n\nAfter a pause, Stop() stashed the stopped stream for the seek. The resume\nrestarted it and rebased the clock without the audio queued before the stop,\nbut the backend's position still counts that audio, on PulseAudio and macOS\nalike. The clock then led the audible audio by the queued amount: the A/V\ndesync of bug 2083467 on macOS. On PulseAudio the clock can also clamp to the\nwrite cursor, advancing once per callback, and 60 fps video plays at 30.\n\nStash only a running stream, so a seek after a pause gets a fresh one, as\nwith the pref off, and drop the carry table row for that case. The tests that\nexpected the paused-seek reuse are replaced by one that checks the clock\nfollows the audible audio, plus one that a pause and resume before a seek\nstill reuses the stream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335026\n", "files": ["dom/media/AudioStream.h", "dom/media/docs/AudioStream.md", "dom/media/gtest/TestAudioSinkWrapper.cpp", "dom/media/mediasink/AudioSink.cpp", "dom/media/mediasink/AudioSink.h", "dom/media/mediasink/AudioSinkWrapper.cpp"], "git_node": "96a340e0056db5e5afef9b74235c60e10e8d6706", "git_parents": ["37ac928cfd31b9e5420482134f8f8b06108e8d66"], "node": "268c21f0ab0bfb8efa3049a697c63a83455e373a", "parents": ["cdcf7efafa41ec3855b86c2f301d2c27b99b4b91"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063361 - Enable widgets only when the region is known. r=maxx\n\n- Requires a known region before enabling widgets from trainhop configs.\n- Updates every widget feed that gates on trainhop config to wait for the region and recheck when it resolves.\n- Refreshes `enabled-widget` telemetry when the region updates.\n- Adds tests for unknown regions and sets `US` in tests that had no region.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326686\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/ListsFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PrivacyFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/RecentSearchesFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/StocksFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/TimerFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/TravelFeed.sys.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsSidebar.test.jsx", "browser/extensions/newtab/test/jest/lib/AboutPreferences.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_ListsFeed.js", "browser/extensions/newtab/test/xpcshell/test_PictureOfTheDayFeed.js", "browser/extensions/newtab/test/xpcshell/test_PrivacyFeed.js", "browser/extensions/newtab/test/xpcshell/test_RecentSearchesFeed.js", "browser/extensions/newtab/test/xpcshell/test_StocksFeed.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "browser/extensions/newtab/test/xpcshell/test_TimerFeed.js", "browser/extensions/newtab/test/xpcshell/test_TravelFeed.js"], "git_node": "68379062615ec1b18ea91d97e200d4d5cc1c08cd", "git_parents": ["96a340e0056db5e5afef9b74235c60e10e8d6706"], "node": "92045d05f60632d990c3b1dc48535d6edaf8f226", "parents": ["268c21f0ab0bfb8efa3049a697c63a83455e373a"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082868 - Disable the Suggest Merino backend when \"Suggestions from Firefox\" is unchecked. r=daisuke,urlbar-reviewers\n\nGate the Merino backend on `suggest.quicksuggest.all`.\n\nWhile I'm here, I added the same gate to the ML backend and added a comment to\nthe Rust backend about why it shouldn't be gated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335303\n", "files": ["browser/components/urlbar/private/SuggestBackendMerino.sys.mjs", "browser/components/urlbar/private/SuggestBackendMl.sys.mjs", "browser/components/urlbar/private/SuggestBackendRust.sys.mjs", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_merino.js", "browser/components/urlbar/tests/quicksuggest/unit/test_suggestBackendMl.js"], "git_node": "5238e1d43ba76e192e699626cc6c2fd0e0289617", "git_parents": ["68379062615ec1b18ea91d97e200d4d5cc1c08cd"], "node": "8b969f522d867861de4ffe08f9c41db3995f7a87", "parents": ["92045d05f60632d990c3b1dc48535d6edaf8f226"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2079394 - Don't copy the last sample of a sleeping thread if it contains JIT return addresses. r=profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333840\n", "files": ["tools/profiler/core/ProfileBuffer.cpp", "tools/profiler/core/ProfileBuffer.h", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/core/ProfiledThreadData.h", "tools/profiler/core/platform.cpp", "tools/profiler/tests/gtest/ThreadProfileTest.cpp"], "git_node": "e0efd8796ebac720fb0ebdabb3a3032711e153db", "git_parents": ["5238e1d43ba76e192e699626cc6c2fd0e0289617"], "node": "eff5f4fe68358fbd9028b48fe70c397cceae821e", "parents": ["8b969f522d867861de4ffe08f9c41db3995f7a87"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2079394 - Resolve profiled JIT addresses by sample position, so that samples of collected code are not attributed to code that later reused its memory. r=iain,profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331737\n", "files": ["js/public/ProfilingFrameIterator.h", "js/src/jit/JitcodeMap.cpp", "js/src/jit/JitcodeMap.h", "js/src/jsapi-tests/moz.build", "js/src/jsapi-tests/testJitcodeGlobalTableReuse.cpp", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/core/ProfileBufferEntry.h"], "git_node": "fa36d630d7908f559a0478848905521eaf23abd6", "git_parents": ["e0efd8796ebac720fb0ebdabb3a3032711e153db"], "node": "07ee257034edee1c0e1b7eef085dca7158b016da", "parents": ["eff5f4fe68358fbd9028b48fe70c397cceae821e"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2083553 - Skip static attribute checks for dynamic atoms. r=emilio\n\nDynamic atoms cannot match the static names in base parsers and maps.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334882\n", "files": ["dom/base/Element.cpp", "dom/html/nsGenericHTMLElement.cpp", "dom/svg/SVGElement.cpp"], "git_node": "473fbca772bac360fc72ff1ba33d3dc416eb76f6", "git_parents": ["fa36d630d7908f559a0478848905521eaf23abd6"], "node": "01a16ac5e3c9fad1042bb71e806cbe8ae11ab0f7", "parents": ["07ee257034edee1c0e1b7eef085dca7158b016da"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078993 - Add script blockers to entry point methods in AccessibleCaretManager. r=layout-reviewers,emilio\" for causing failures complaining about SelectionActionDelegateTest.\n\nThis reverts commit 3b2ec32fd0bc72d6d4394839341db02c049620e4.\n", "files": ["layout/base/AccessibleCaretManager.cpp", "layout/base/crashtests/2078993-inner.xml", "layout/base/crashtests/2078993.html", "layout/base/crashtests/crashtests.list"], "git_node": "f9499cee483aff56bdfa12fc794cc4fb41ee45eb", "git_parents": ["473fbca772bac360fc72ff1ba33d3dc416eb76f6"], "node": "581097c539a7aa71765857e6b888802a5b2897e3", "parents": ["01a16ac5e3c9fad1042bb71e806cbe8ae11ab0f7"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1264194 - Remove the support of non-swappable AccessibleCaret. r=layout-reviewers,dshin,emilio\n\n`layout.accessiblecaret.allow_dragging_across_other_caret` has been `true` for a\nlong time, and no existing platform need the `false` behavior except the legacy\nB2G.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335419\n", "files": ["layout/base/AccessibleCaretManager.cpp", "layout/base/AccessibleCaretManager.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "e189096c8cfe2b31e1de6318c7311e39a65168f1", "git_parents": ["f9499cee483aff56bdfa12fc794cc4fb41ee45eb"], "node": "bc8fd49cd78dcedec2431ec08caa8c4d408ceb6a", "parents": ["581097c539a7aa71765857e6b888802a5b2897e3"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2083328: Enable grid-lanes pref for two devtools tests that exercise grid-lanes parsing. r=devtools-reviewers,jdescottes\n\nThis fixes test failures in beta simulations (where grid-lanes is currently\ndisabled by default).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334924\n", "files": ["devtools/client/inspector/rules/test/browser_rules_inactive_css_grid.js", "devtools/server/tests/chrome/test_inspector-inactive-property-helper.html"], "git_node": "c3d274c58602484829dee2e077d541b80836efe2", "git_parents": ["e189096c8cfe2b31e1de6318c7311e39a65168f1"], "node": "3caaa677ca5ed98a8f607d10706f6d3da298f76a", "parents": ["bc8fd49cd78dcedec2431ec08caa8c4d408ceb6a"], "tags": []}, {"author": "glob \u003cglob@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014729 - Switch DevTools from yarn to npm. r=devtools-reviewers,profiler-reviewers,bomsy,canova\n\nThe DevTools node test suites and the debugger bundle now use npm and\npackage-lock.json instead of yarn and yarn.lock, which matches the rest of\nthe tree and removes the need for yarn on the PATH.  The lockfiles were\ngenerated by npm from the existing yarn.lock files, so resolved versions are\nunchanged.\n\ndevtools-node-test-runner now runs `npm ci` and `npm run test-ci`, and\npasses `shell` on Windows as Node no longer allows spawning .cmd files\nwithout it.  The devtools-verify-bundle task uses `npm ci`, and yarn is no\nlonger installed in the lint docker image.  The orphaned\ndevtools/client/webconsole/test/yarn.lock and the unused debugger workspaces\nentry are removed.\n\nThe yarn.lock files under devtools/client/debugger/test/mochitest/examples\nare left as is.  Those are standalone fixture projects used to regenerate\ntest bundles, they are not run by any test job, and moving their older\nbabel and webpack setups to npm is out of scope here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333511\n", "files": ["devtools/client/aboutdebugging/test/node/package-lock.json", "devtools/client/aboutdebugging/test/node/yarn.lock", "devtools/client/accessibility/test/node/README.md", "devtools/client/accessibility/test/node/package-lock.json", "devtools/client/accessibility/test/node/yarn.lock", "devtools/client/application/test/node/package-lock.json", "devtools/client/application/test/node/yarn.lock", "devtools/client/bin/devtools-node-test-runner.js", "devtools/client/debugger/package-lock.json", "devtools/client/debugger/package.json", "devtools/client/debugger/yarn.lock", "devtools/client/framework/test/node/README.md", "devtools/client/framework/test/node/package-lock.json", "devtools/client/framework/test/node/yarn.lock", "devtools/client/framework/test/reload/README.md", "devtools/client/inspector/compatibility/test/node/package-lock.json", "devtools/client/inspector/compatibility/test/node/yarn.lock", "devtools/client/netmonitor/test/node/package-lock.json", "devtools/client/netmonitor/test/node/yarn.lock", "devtools/client/performance-new/README.md", "devtools/client/performance-new/package-lock.json", "devtools/client/performance-new/typescript.md", "devtools/client/performance-new/yarn.lock", "devtools/client/shared/components/test/node/package-lock.json", "devtools/client/shared/components/test/node/yarn.lock", "devtools/client/webconsole/test/README.md", "devtools/client/webconsole/test/node/package-lock.json", "devtools/client/webconsole/test/node/yarn.lock", "devtools/client/webconsole/test/yarn.lock", "devtools/docs/contributor/tests/node-tests.md", "taskcluster/docker/lint/system-setup.sh", "taskcluster/kinds/source-test/node.yml", "taskcluster/scripts/misc/verify-devtools-bundle.py"], "git_node": "e093335925b40bd46a83f14c3391866fc79d6550", "git_parents": ["c3d274c58602484829dee2e077d541b80836efe2"], "node": "df7b0263dd8f1b78c65af312a7297c74327a42a6", "parents": ["3caaa677ca5ed98a8f607d10706f6d3da298f76a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079472 - Use the Win32 API instead of PowerShell to check for a Dev Drive in `./mach bootstrap` r=firefox-build-system-reviewers,sergesanspaille\n\nThe check parsed the third line of `Get-Volume` output. Bootstrap crashed\nwhen `Get-Volume` returned nothing, which happens on `subst` drives and on\nvolumes the Windows storage provider does not list. When the execution\npolicy blocked the user's PowerShell profile, the check reported the\nprofile error as the filesystem name.\n\n`GetVolumePathNameW` finds the volume that holds the checkout, including\na volume mounted into a folder, and `GetVolumeInformationW` returns its\nfilesystem name directly. Neither depends on the storage provider or\nPowerShell output. The path goes through `os.path.realpath` first so that\n`subst` drives resolve to the real drive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334347\n", "files": ["python/mozboot/mozboot/bootstrap.py"], "git_node": "4cdca2a3cc6e3f6a9c4ec89041f0672fc3b2a940", "git_parents": ["e093335925b40bd46a83f14c3391866fc79d6550"], "node": "fdb589d9d9a011017d7704dab18608a666f9affc", "parents": ["df7b0263dd8f1b78c65af312a7297c74327a42a6"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2072088 - Ensure random() values are the same across static cloned documents. r=firefox-style-system-reviewers,layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326831\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/Element.h", "layout/base/tests/chrome/chrome.toml", "layout/base/tests/chrome/printpreview_helper.xhtml", "layout/base/tests/chrome/printpreview_random.html", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "servo/components/style/device/gecko.rs", "servo/components/style/dom.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/values/computed/mod.rs", "xpcom/ds/StaticAtoms.py"], "git_node": "ff745ebfb64c5ca620a9dca97a24e91e4ad8c4b0", "git_parents": ["4cdca2a3cc6e3f6a9c4ec89041f0672fc3b2a940"], "node": "31da9f95ccc0055d6db0d40869d15c2765330a99", "parents": ["fdb589d9d9a011017d7704dab18608a666f9affc"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020709 - Part 1: Add support for Speculation-Rules HTTP header. r=necko-reviewers,devtools-reviewers,dom-worker-reviewers,nchevobbe,sunil,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287716\n", "files": ["devtools/client/netmonitor/src/utils/doc-utils.js", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "dom/base/nsContentPolicyType.h", "dom/base/nsContentSink.cpp", "dom/base/nsContentUtils.h", "dom/base/nsIContentPolicy.idl", "dom/cache/DBSchema.cpp", "dom/fetch/InternalRequest.cpp", "dom/security/SecFetch.cpp", "dom/security/nsCSPUtils.cpp", "testing/web-platform/meta/speculation-rules/header-only-top-level.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/out-of-document-rule-set.https.html.ini"], "git_node": "6bf27ffdba477dabe344adc79afddaafd5220981", "git_parents": ["ff745ebfb64c5ca620a9dca97a24e91e4ad8c4b0"], "node": "ccff95be28c4fe6e95ebdac9fc7daf5c21d901ca", "parents": ["31da9f95ccc0055d6db0d40869d15c2765330a99"], "tags": []}, {"author": "Adam Vandolder \u003cavandolde