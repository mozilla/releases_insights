om/D332474\n", "files": ["browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/tsconfig.json", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/types/urlbar.ts"], "git_node": "90e2d078310a82390a91cf45c0ce67028bcf5321", "git_parents": ["a03f78333895dca9ea1203d73a4ba4450dc3e8c6"], "node": "adde57a94cc8608cb862fa9449382c808dc2a648", "parents": ["cb09c7b8e9575798eab15ef3e8015dbe8e534504"], "tags": []}, {"author": "def00111 \u003ckernp@gmx.de\u003e", "branch": "default", "desc": "Bug 2000401 - Make tabs.discard to set the 'discarded' attribute. r=robwu,sessionstore-reviewers,tabbrowser-reviewers,jswinarton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331711\n", "files": ["browser/components/extensions/parent/ext-tabs.js", "browser/components/extensions/test/browser/browser_ext_tabs_discard.js", "browser/components/sessionstore/test/browser_1284886_suspend_tab.js", "browser/components/sessionstore/test/browser_wireframe_basic.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/docs/lazy-browsers.md", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_discardBrowser_discarded_attribute.js", "browser/components/tabbrowser/test/browser/tabs/browser_discarded_tab_move.js", "browser/components/tabbrowser/test/browser/tabs/browser_pinnedTabs.js", "browser/components/tabbrowser/test/browser/tabs/browser_selectMRUOnClose.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabswitch_discard.js", "toolkit/components/aboutprocesses/content/aboutProcesses.js"], "git_node": "98806e90f8b852f38380cabdf7772d5ca2f18c62", "git_parents": ["90e2d078310a82390a91cf45c0ce67028bcf5321"], "node": "21d59f09e80470c76f39a97c8dc6dd5609c01b45", "parents": ["adde57a94cc8608cb862fa9449382c808dc2a648"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2077756 - Suppress area elements at frame constructiont time. r=layout-reviewers,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333598\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "32e0bb536f4ca58fd1fe8938dcca21c1575f4cdc", "git_parents": ["98806e90f8b852f38380cabdf7772d5ca2f18c62"], "node": "964bf837d735a93e1eb86ba1e30074147c37b605", "parents": ["21d59f09e80470c76f39a97c8dc6dd5609c01b45"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078664 - Apply the safer MAR instruction order to complete updates too. r=releng-reviewers,bhearsum\n\nIn particular, this guarantees that nothing can fail after firefox.exe\nis replaced on disk because it is the last action in the MAR, so\nstarting a firefox.exe in the new version is only possible if the update\nsucceeded and impossible mid-update.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332038\n", "files": ["python/mozbuild/mozbuild/repackaging/mar.py", "toolkit/mozapps/update/docs/Debugging.md", "toolkit/mozapps/update/docs/SettingUpAnUpdateServer.md", "tools/update-packaging/common.sh", "tools/update-packaging/make_full_update.sh", "tools/update-packaging/make_incremental_update.sh"], "git_node": "839ef69178785e56f19ea30a3a31f605bd97c5c4", "git_parents": ["32e0bb536f4ca58fd1fe8938dcca21c1575f4cdc"], "node": "dc9267176df4b11f10fd67977212bf56c5b1d7d4", "parents": ["964bf837d735a93e1eb86ba1e30074147c37b605"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078664 - Move mozglue.dll next to the application executable in the safer MAR instruction order. r=releng-reviewers,bhearsum\n\nA version mismatch between mozglue.dll and firefox.exe can cause startup\ncrashes (see bug 2078555), so mozglue.dll should be considered critical\ntoo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332039\n", "files": ["tools/update-packaging/common.sh"], "git_node": "7ccaf83ab0367f9a03358eaf18ee3130f4b9528f", "git_parents": ["839ef69178785e56f19ea30a3a31f605bd97c5c4"], "node": "88fbc69686c376eb9fc4272582a394b7ecc3cb7e", "parents": ["dc9267176df4b11f10fd67977212bf56c5b1d7d4"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1831048 - Part 2: Fix 70 or so 'misc-unused-parameters' warnings in 3 more directories r=mfbt-reviewers,profiler-reviewers,sergesanspaille,canova\" for causing build bustages @ HalWakeLock.cpp\n\nThis reverts commit c3b08041690ba091f755a51427c4c5c1f31c2a06.\n", "files": ["hal/HalWakeLock.cpp", "hal/fallback/FallbackPerformanceHintManager.cpp", "hal/fallback/FallbackScreenConfiguration.cpp", "hal/linux/UPowerClient.cpp", "hal/sandbox/SandboxHal.cpp", "mfbt/tests/TestBufferList.cpp", "mfbt/tests/TestMaybe.cpp", "mfbt/tests/TestMozCrash.cpp", "mfbt/tests/TestResult.cpp", "mfbt/tests/TestSegmentedVector.cpp", "mfbt/tests/TestUtf8.cpp", "mfbt/tests/gtest/TestAlgorithm.cpp", "mfbt/tests/gtest/TestResultExtensions.cpp", "mozglue/baseprofiler/core/ProfileBufferEntry.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/misc/StackWalk.cpp", "mozglue/tests/TestBaseProfiler.cpp", "mozglue/tests/gtest/TestStackWalk.cpp"], "git_node": "72c5004699d827fdd573252e47cac312466fd6ba", "git_parents": ["7ccaf83ab0367f9a03358eaf18ee3130f4b9528f"], "node": "4a371b4428698b140f83a8e56a3885e49e6bd552", "parents": ["88fbc69686c376eb9fc4272582a394b7ecc3cb7e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "d