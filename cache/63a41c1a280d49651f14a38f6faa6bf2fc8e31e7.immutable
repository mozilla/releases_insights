fig/privacy.mjs", "browser/components/preferences/dialogs/vpnSiteRule.js", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "28f4a840c244c96426d6f562e34068c51eee72fd", "git_parents": ["3799afe3436db2a2d627db505b6f2e0aeba746da"], "node": "5eb5b17a43dd8f569672720f4c3b320d4367b2fd", "parents": ["a3ffc895422828eeb452d02e401f120bafe9dfa5"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074578 - Create delete confirmation dialogs for VPN site rules settings - r=kpatenio,mstriemer,ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331293\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.css", "browser/components/ipprotection/content/vpn-site-rules-list.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "ba1f25b133b89e4c014e4a4468434948cc75f032", "git_parents": ["28f4a840c244c96426d6f562e34068c51eee72fd"], "node": "7e09baad3f9d16ccee803e9c9ea13abaeac58936", "parents": ["5eb5b17a43dd8f569672720f4c3b320d4367b2fd"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070663 - Add the moz-widget custom element. r=mconley,nina-py\n\n- Adds standard widget sizes and card styling.\n- Widget content can come from slotted elements or framed content loaded from `src`.\n- Loads framed content in a remote browser in chrome or iframe in content.\n- When using a browser element, extension content is loaded using the extension\u2019s browsing context group.\n- Adds Storybook documentation and chrome tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327912\n", "files": ["browser/components/moz.build", "browser/components/storybook/.storybook/main.js", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/moz.build", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html"], "git_node": "e291a31b70a82c0d6d8c83285dd5d145a42ac594", "git_parents": ["ba1f25b133b89e4c014e4a4468434948cc75f032"], "node": "d0cc84603e1dab50fdfdeb33ce73b54083473bb4", "parents": ["7e09baad3f9d16ccee803e9c9ea13abaeac58936"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070684 - Add a header component and slot to moz-widget. r=nina-py\n\n- Adds a `moz-widget-header` component with a heading and `leading` and `trailing` slots\n- Adds a `header` slot to moz-widget for the `moz-widget-header`\n- Adds a `padded` attribute to moz-widget to inset and round the content\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328015\n", "files": ["browser/components/widgets/content/moz-widget-header.css", "browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html", "browser/components/widgets/tests/chrome/test_moz_widget_header.html"], "git_node": "2e09c9df2d51b818f0945561b0156abd544f55cf", "git_parents": ["e291a31b70a82c0d6d8c83285dd5d145a42ac594"], "node": "abc6167364fc06518903a963b9772dba5c7f94e8", "parents": ["d0cc84603e1dab50fdfdeb33ce73b54083473bb4"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070709 - Add WidgetManager to track the widgets registered by extensions. r=mconley\n\n- Adds a `WidgetManager` singleton that stores one widget per extension id.\n- Emits \"change\" at init and on register and unregister with the IDs of the updated widgets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329352\n", "files": ["browser/components/BrowserComponents.manifest", "toolkit/components/moz.build", "toolkit/components/widgets/WidgetManager.sys.mjs", "toolkit/components/widgets/moz.build", "toolkit/components/widgets/tests/xpcshell/test_WidgetManager.js", "toolkit/components/widgets/tests/xpcshell/xpcshell.toml"], "git_node": "13253c74b6737de57cff678872f2dd62e226dd2e", "git_parents": ["2e09c9df2d51b818f0945561b0156abd544f55cf"], "node": "95b21d9c88b0461d6283b5652216c8b4ad83bd61", "parents": ["abc6167364fc06518903a963b9772dba5c7f94e8"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080207 - Back out changeset 1e67efc9458c (bug 2077752), keeping its regression test, for recurring wasm frame-iteration regressions. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332425\n", "files": ["js/src/wasm/WasmFrameIter.cpp"], "git_node": "f1d5f86cd313d1a65c7f5fc6ff6eeaea089c494e", "git_parents": ["13253c74b6737de57cff678872f2dd62e226dd2e"], "node": "95f1f1305d0cb62cc2e18f13864e66354b7d78b8", "parents": ["95b21d9c88b0461d6283b5652216c8b4ad83bd61"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080207 - Back out changeset e927ba8329d0 (bug 2076982), keeping its regression test, for recurring wasm frame-iteration regressions. r=rhunt\n\nDepends on D332425\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332426\n", "files": ["js/src/jit/JitFrames.cpp", "js/src/vm/FrameIter.cpp", "js/src/vm/FrameIter.h"], "git_node": "b9f719c2c10e5dc185c8aa6acf1a9054d8f56264", "git_parents": ["f1d5f86cd313d1a65c7f5fc6ff6eeaea089c494e"], "node": "fe417892f7cba58f3b2b1ab392f9224de53491b2", "parents": ["95f1f1305d0cb62cc2e18f13864e66354b7d78b8"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080207 - Back out changeset c28101f7f5bd (bug 2068131), remove ReturnStub call site kind. r=rhunt\n\nDepends on D332426\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332427\n", "files": ["js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmCodegenTypes.h", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmGenerator.cpp"], "git_node": "d4f1a3fd62e7dbc9a68a5e16da84864282fb83ee", "git_parents": ["b9f719c2c10e5dc185c8aa6acf1a9054d8f56264"], "node": "70be28f35b5b98115221d42babd36aff7e78ee01", "parents": ["fe417892f7cba58f3b2b1ab392f9224de53491b2"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080207 - Back out changeset 036ee078e00b (bug 2068131), hoist return_call trampoline. r=rhunt\n\nDepends on D332427\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332428\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmBuiltins.h", "js/src/wasm/WasmCodegenTypes.cpp", "js/src/wasm/WasmCodegenTypes.h", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmFrameIter.h", "js/src/wasm/WasmGenerator.cpp", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h"], "git_node": "893d57b29b36ed1b541313d71d980b4eae889295", "git_parents": ["d4f1a3fd62e7dbc9a68a5e16da84864282fb83ee"], "node": "c81a65b180d59dc4b7f38cc08fa3d660d129acb6", "parents": ["70be28f35b5b98115221d42babd36aff7e78ee01"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079677 - Block scripts from running while notifying elements of legend change. r=dom-core-reviewers,masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332143\n", "files": ["dom/html/HTMLFieldSetElement.cpp"], "git_node": "5d090afb26d21aca1decae79c440c498705f1c21", "git_parents": ["893d57b29b36ed1b541313d71d980b4eae889295"], "node": "d4fd6a7cd37693117ab3e547ea19b5b096877429", "parents": ["c81a65b180d59dc4b7f38cc08fa3d660d129acb6"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074399 - [devtools] Add prototype inventory in new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nDefine settings once in the inventory, then render them as custom elements\nso the markup itself remains a readable inventory of settings.\n\nCreate a `\u003cdevtools-settings-pref\u003e` element to handle binding a checkbox,\nand in the future other controls, to the setting's pref. We'll add more\nelements like this one for handling different bindings in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328110\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-pref.mjs", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/components/moz.build", "devtools/client/settings/events.mjs", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/moz.build", "devtools/client/settings/panel.mjs", "devtools/client/settings/settings.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_preference_bindings.js", "devtools/client/settings/test/browser/browser_settings_rulers.js", "devtools/client/settings/types/inventory.d.ts"], "git_node": "44e61bad6de435e30778729e902ec713e744cf54", "git_parents": ["5d090afb26d21aca1decae79c440c498705f1c21"], "node": "fad6f178e86cfb4ec4761745c8e153cda28dd7cc", "parents": ["d4fd6a7cd37693117ab3e547ea19b5b096877429"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067132 - Scroll the article title while audio is playing r=android-reviewers,ltokhtamuradova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332189\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/ListenSheet.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlaybackControls.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerCompact.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt"], "git_node": "ad688c1abb831d72167add37810c6ee66bebae72", "git_parents": ["44e61bad6de435e30778729e902ec713e744cf54"], "node": "dcc09804b0840cae1a4e03b22bef901bbd49ae12", "parents": ["fad6f178e86cfb4ec4761745c8e153cda28dd7cc"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Include the unexpected scheme in the MozNewTabRemoteRendererProtocolParent error message since it was being passed as the Error options argument r=mconley\n\nThe scheme was passed as the second argument to new Error, which is ErrorOptions, so the logged message ended in \"but got \" with nothing after it; tsc reported this as TS2559, and the file now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331795\n", "files": ["browser/extensions/newtab/lib/actors/MozNewTabRemoteRendererProtocolParent.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "a21daf02bb9dd593e07bdc37e3e836c7a90348b3", "git_parents": ["ad688c1abb831d72167add37810c6ee66bebae72"], "node": "2e07df63abc544ba91eba0347bff12fa34e0777b", "parents": ["dcc09804b0840cae1a4e03b22bef901bbd49ae12"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Return a boolean from RemoteRenderer.willDoomOnShutdown as documented instead of the matching nsIURI r=mconley\n\nwillDoomOnShutdown used Array.prototype.find, so it returned the matching nsIURI or undefined rather than the documented boolean; every current caller only tests it for truthiness, so this changes no behavior, but tsc reported it as TS2322 and using some makes the return value match the contract.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331796\n", "files": ["browser/extensions/newtab/lib/RemoteRenderer.sys.mjs"], "git_node": "ecdae613be6cbcdf459722cfe54e62289dab49cf", "git_parents": ["a21daf02bb9dd593e07bdc37e3e836c7a90348b3"], "node": "e801f5b337da6e61d97903a51d7f5e23fb687198", "parents": ["2e07df63abc544ba91eba0347bff12fa34e0777b"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Remove the unused isStartup argument from WeatherFeed.loadWeather and the fetch call that it was forwarded to r=mconley\n\nWeatherFeed.fetch takes no arguments, so the isStartup flag that init passed to loadWeather and that loadWeather forwarded to fetch was never read; tsc reported the extra argument as TS2554, and the file now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331797\n", "files": ["browser/extensions/newtab/lib/WeatherFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "a44877a73caf87710c8c4e5bec35cf1b03040d81", "git_parents": ["ecdae613be6cbcdf459722cfe54e62289dab49cf"], "node": "bffb3b7e75376b8ddde6f3393e5f030fa6db3002", "parents": ["e801f5b337da6e61d97903a51d7f5e23fb687198"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Remove the unused Nimbus featureConfig from SectionsManager since BUILT_IN_SECTIONS stopped taking it in bug 1953330 r=mconley\n\nBug 1953330 changed BUILT_IN_SECTIONS to take no arguments, but SectionsManager.init and addBuiltInSection kept reading the newtab and pocketNewtab Nimbus variables to pass to it; tsc reported the extra argument as TS2554, and the file now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331798\n", "files": ["browser/extensions/newtab/lib/SectionsManager.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "3807487a596cf9fe54c31fe6a671e97a816616c8", "git_parents": ["a44877a73caf87710c8c4e5bec35cf1b03040d81"], "node": "48fed745891d4557afd487589c3acb302b207e5b", "parents": ["bffb3b7e75376b8ddde6f3393e5f030fa6db3002"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Fix TypeScript errors for calls to AlsoToOneContent without skipMain (TS2554) by marking it optional in its JSDoc r=mconley\n\nskipMain is only passed by OnlyToOneContent, so the other callers in NewTabInit and WebNotificationsFeed were flagged for passing two of three arguments; NewTabInit now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331799\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "f1f5ddf97f8bbf71a321cd740c54f928b85d85db", "git_parents": ["3807487a596cf9fe54c31fe6a671e97a816616c8"], "node": "481cd2bcd711a5f1f75761bad26a371f6cc78e56", "parents": ["48fed745891d4557afd487589c3acb302b207e5b"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Fix TypeScript errors for properties missing from JSDoc object types (TS2339, TS2353) in newtab/lib r=mconley\n\nThe JSDoc for these functions omitted properties the code reads or passes: manifest in RemoteRenderer's content objects, endpointUrl in two TemporaryMerinoClientShim fetches, the options of WebNotificationsFeed._dismissAll and skipNightlyDefault on WidgetRegistryEntry, while AdsClient.uninit's client was documented as a string; AdsClient, TemporaryMerinoClientShim and RemoteRenderer now leave the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331800\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/RemoteRenderer.sys.mjs", "browser/extensions/newtab/lib/TemporaryMerinoClientShim.sys.mjs", "browser/extensions/newtab/lib/WebNotificationsFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "c7af261f3949f4e4fc5564917e7484a920906b74", "git_parents": ["f1f5ddf97f8bbf71a321cd740c54f928b85d85db"], "node": "49ac54118a35718daeadad7c5efdba5e4178692d", "parents": ["481cd2bcd711a5f1f75761bad26a371f6cc78e56"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Fix TypeScript errors for object and array literals that tsc cannot infer as their documented types (TS2322, TS2741) in newtab/lib r=mconley\n\nSTORIES_REGION_LOCALE_DEFAULT is now typed as RegionLocaleEntries, with a cast on its Nightly-only spread since tsc infers that conditional array as nested string arrays rather than tuples, and normalizeDiskEntry casts its accumulator because id is copied in from DISK_PASSTHROUGH_FIELDS after construction; WebNotificationsFeed now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331801\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/WebNotificationsFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "2db18a8dfcd2383b37b21ebcca3b3a7cd9eaa036", "git_parents": ["c7af261f3949f4e4fc5564917e7484a920906b74"], "node": "bace8a49d8f9d4a3183d73956035d48f87d63e91", "parents": ["49ac54118a35718daeadad7c5efdba5e4178692d"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Fix the TypeScript error for widgetLabels' parameter type (TS2345) in newtab/lib AboutPreferences by typing it as WidgetRegistryEntry[] r=mconley\n\nwidgetLabels is passed WIDGET_REGISTRY entries, whose prefsL10nId is optional because retired entries omit it, so the hand-written { id, prefsL10nId } type rejected them; AboutPreferences now leaves the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331802\n", "files": ["browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "c3af2f95e76bad5cf7a6dc70793e78b4191f6048", "git_parents": ["2db18a8dfcd2383b37b21ebcca3b3a7cd9eaa036"], "node": "ed3409e32a59ace301c97bf6d282b9aee80d47b3", "parents": ["bace8a49d8f9d4a3183d73956035d48f87d63e91"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Fix TypeScript errors for ActivityStreamMessageChannel's options (TS2339, TS2345, TS2739) by declaring the members its constructor copies from them r=mconley\n\nThe constructor copies DEFAULT_OPTIONS and its options argument onto the instance with Object.assign, so tsc never saw dispatch, pageURL or the message names as members and required callers such as Store to pass every option the defaults already supply; the options are now documented as optional, the four members are declared as typed class fields, and onMessage's JSDoc names msg.data instead of msg.action, the property it actually reads. ActivityStreamMessageChannel and Store now leave the tsconfig exclude list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331803\n", "files": ["browser/extensions/newtab/lib/ActivityStreamMessageChannel.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "5bd552ee52601ee3d90c738268288f9ba606f648", "git_parents": ["c3af2f95e76bad5cf7a6dc70793e78b4191f6048"], "node": "518569a2491699c2c51c4d4beacd256091574cbb", "parents": ["ed3409e32a59ace301c97bf6d282b9aee80d47b3"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079376 - Fix TypeScript errors for NewTabAttributionService's constructor options and stored impression typedefs (TS2339, TS2345, TS2739) r=mconley\n\nThe constructor destructured an undocumented options object that defaults to {}, and the impression and allocatedTask typedefs marked as required the timestamps and DAP task fields that onAttributionEvent's default impression never has; the file stays excluded for the ObjectStore.get error that comes from wrapMethods in toolkit/modules/IndexedDB.sys.mjs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331804\n", "files": ["browser/extensions/newtab/lib/NewTabAttributionService.sys.mjs"], "git_node": "225c5ddea92ad7614aef64ff2a7a5ffa46a6ff19", "git_parents": ["5bd552ee52601ee3d90c738268288f9ba606f648"], "node": "211b9baed96abf3e0838cc2e26ca4d11e0a2c0c9", "parents": ["518569a2491699c2c51c4d4beacd256091574cbb"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080040 - Wayback backed by Nimbus flag wayback-machine r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332277\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "88b29acee33caafcb35f4375b82a94cd0af46f8d", "git_parents": ["225c5ddea92ad7614aef64ff2a7a5ffa46a6ff19"], "node": "5082c90aa256b9d75ef9979794975af5c91ef5bf", "parents": ["211b9baed96abf3e0838cc2e26ca4d11e0a2c0c9"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2076258 - Open PDF features in a new tab. r=dholbert\n\nPreserve the loaded PDF and unsaved edits. Require user activation because\nthe viewer accepts untrusted pdf.js.message events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332451\n", "files": ["toolkit/components/pdfjs/content/PdfJsParent.sys.mjs", "toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/test/browser_pdfjs_features_notification.js"], "git_node": "aa01e1c90fdfa9921c70a3e406052509dd3e18c4", "git_parents": ["88b29acee33caafcb35f4375b82a94cd0af46f8d"], "node": "e30bd32b746822a2ec825872e102833f67b79398", "parents": ["5082c90aa256b9d75ef9979794975af5c91ef5bf"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2077631 - refactor(webgpu): extract `request_device_error_to_string` r=webgpu-reviewers,aleiserson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331509\n", "files": ["gfx/wgpu_bindings/src/error.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "498c45b10680377139cf756bf184e585644c0d10", "git_parents": ["aa01e1c90fdfa9921c70a3e406052509dd3e18c4"], "node": "8c9058813b49da35e6b5a3762714a42bf4372489", "parents": ["e30bd32b746822a2ec825872e102833f67b79398"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2077631 - refactor(webgpu): extract `pipeline_error_to_ffi` r=webgpu-reviewers,aleiserson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331510\n", "files": ["gfx/wgpu_bindings/src/error.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "bb5f508f432cf743e5cfadd7c0f4b8b515dceccf", "git_parents": ["498c45b10680377139cf756bf184e585644c0d10"], "node": "ea3c26d6964206459cf6bcb12cf74d264375e6cb", "parents": ["8c9058813b49da35e6b5a3762714a42bf4372489"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug