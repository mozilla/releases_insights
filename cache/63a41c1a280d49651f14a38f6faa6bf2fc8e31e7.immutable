616c7db91301ec06f15a"], "node": "8e5df56ec45ef104452712762f5aa39ee4399232", "parents": ["d201aacdd3911ce6312ee09d95fa056d7c573a14"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066399 - Let contextual search resolve the page from the controller rather than the top window. r=urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334451\n", "files": ["browser/components/urlbar/ActionsProvider.sys.mjs", "browser/components/urlbar/ActionsProviderContextualSearch.sys.mjs", "browser/components/urlbar/ActionsProviderQuickActions.sys.mjs", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs", "browser/components/urlbar/UrlbarProviderGlobalActions.sys.mjs", "browser/components/urlbar/UrlbarProviderTabToSearch.sys.mjs", "browser/components/urlbar/tests/browser-search/browser_contextualsearch_install.js"], "git_node": "77fa820ece4c8ef596e8114f4a432638a4c96f04", "git_parents": ["d6b916652fb4acb633e456d9c4b9a8e96018ac34"], "node": "e13473c50cc5c0928cd8ac06d4278bffad1c3a44", "parents": ["8e5df56ec45ef104452712762f5aa39ee4399232"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2081966 - properly optimize documents out of CC graph, r=mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335604\n", "files": ["dom/base/FragmentOrElement.cpp"], "git_node": "cf2ec64cbbfae49fd12021077324b7898b60509a", "git_parents": ["77fa820ece4c8ef596e8114f4a432638a4c96f04"], "node": "0bf18e6e02231ece309fd83b0e40156323850eb8", "parents": ["e13473c50cc5c0928cd8ac06d4278bffad1c3a44"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080945 - Apply UX QA border colors and group spacing to the AI Tab List block r=gcardieri\n\n- Split the List border color: group headings now use gray-40 and group items use gray-50, as in the Figma. `--color-gray-40` only exists in the Nova palette, so it falls back to gray-30 when Nova is off.\n- Use `--aitab-list-group-gap` (36px) for both the row and column gaps between list groups. Before this, groups placed side by side in the column layout were only 24px apart.\n\nDark mode and forced colors keep their current behavior (a fixed gray token, with no `light-dark()`). The Figma only specifies light values.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333406\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-list/aitab-list.css", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js"], "git_node": "815ec98a706e5668934c2e1876c5306aadb2f28d", "git_parents": ["cf2ec64cbbfae49fd12021077324b7898b60509a"], "node": "c3f0fe5c72046952ced1cb82c5b9db03dc0ba179", "parents": ["0bf18e6e02231ece309fd83b0e40156323850eb8"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068177 - Observe TabDataCoordinator to populate the tab groups strip state r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333715\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripContent.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripStore.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripReducerTest.kt"], "git_node": "47985e52fb356d848aa64ea60986cd7472449d13", "git_parents": ["815ec98a706e5668934c2e1876c5306aadb2f28d"], "node": "b588e1691ffb363e83120d654e0192dcc8286f3f", "parents": ["c3f0fe5c72046952ced1cb82c5b9db03dc0ba179"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046813 - Part 1: Add H265::CreateExtraData to build an hvcC from an HEVC codec string. r=alwu\n\nMP4Decoder::GetTracksInfo leaves VideoInfo::mExtraData empty for HEVC, unlike\nthe VP9, AV1 and H.264 branches next to it, so a caller holding only a codecs\nparameter string has no hvcC to hand a decoder. H264::CreateExtraData covers\navc1 that way already, and MediaCapabilities needs the HEVC equivalent so it\ncan probe a real decoder instead of guessing.\n\nRewrite the canned parameter sets from CreateFakeExtraData with the profile,\ntier, level and constraint flags the codec string carries, sized to the\nrequested resolution, and at 10 bits for Main 10 and 8 bits otherwise, since\nthe string does not carry a bit depth.\n\nExtractH265CodecDetails now has to report the profile space, tier flag and\ncompatibility flags the hvcC needs, so its three out parameters become a\nsingle H265CodecDetails.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327009\n", "files": ["dom/media/VideoUtils.cpp", "dom/media/VideoUtils.h", "dom/media/mediasource/gtest/TestExtractH265CodecDetails.cpp", "dom/media/mediasource/gtest/moz.build", "dom/media/platforms/agnostic/bytestreams/H265.cpp", "dom/media/platforms/agnostic/bytestreams/H265.h", "dom/media/platforms/agnostic/bytestreams/gtest/TestByteStreams.cpp"], "git_node": "2085f14beb9061e39cf5a41b592148f6da8cbfe7", "git_parents": ["47985e52fb356d848aa64ea60986cd7472449d13"], "node": "672c6da30b9af236aaf4ab634f41a97b8e7b9a23", "parents": ["b588e1691ffb363e83120d654e0192dcc8286f3f"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046813 - Part 2: Report accurate powerEfficient for profile-less and HEVC video codecs in Media Capabilities. r=pehrsons,media-playback-reviewers,alwu\n\ndecodingInfo answers powerEfficient by creating a decoder and asking whether it\nis hardware accelerated, which needs a decoder configuration to create it from.\nA codecs parameter string carrying no profile, such as \"vp9\" or \"av1\", leaves\nVideoInfo::mExtraData empty because VPXDecoder::SetVideoInfo and its AV1\ncounterpart bail when the string does not parse, and MP4Decoder::GetTracksInfo\nnever fills it in for HEVC at all. Those queries were answered from a guess\nrather than from a decoder.\n\nSynthesize the missing configuration before probing: the common 8-bit profile 0\ncase for VP8, VP9 and AV1, picking the lowest AV1 seq_level_idx whose MaxPicSize\nfits the requested resolution, and for HEVC the profile, tier and level the\ncodec string does carry, through H265::CreateExtraData.\n\nThe new moz-WPT asserts that a profile-less string answers the same as its fully\nqualified form. avc1 still does not, because a bare \"avc1\" is rejected even\nthough RFC 6381 makes avcoti optional; that is bug 2049903, and the test is\nmarked as an expected failure against it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306228\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp", "testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-codec-without-profile.any.js.ini", "testing/web-platform/mozilla/tests/media-capabilities/decodingInfo-codec-without-profile.any.js"], "git_node": "da0b9692c590493ea028fa46f4455e8b6df2be85", "git_parents": ["2085f14beb9061e39cf5a41b592148f6da8cbfe7"], "node": "639b82d140950ed83b64b563195cc11a3e91c410", "parents": ["672c6da30b9af236aaf4ab634f41a97b8e7b9a23"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046813 - Part 3: Assert that a MediaCapabilities probe really instantiates a decoder. r=pehrsons,media-playback-reviewers,alwu\n\nNothing enforced that the configurations Part 2 synthesizes actually let a\nwrapping decoder create its underlying decoder. MediaChangeMonitor::Create\nresolves with the wrapper and no decoder when CanBeInstantiated() is false, and\nIsHardwareAccelerated then answers from a platform assumption instead, which is\nthe guess Part 2 exists to remove. A codec string whose synthesized config was\nmissing or malformed would therefore go unnoticed.\n\nAdd CreateDecoderParams::Option::AssertCanInstantiate, which MediaCapabilities\nsets on its strict probes, and assert on it in MediaChangeMonitor both where the\nunderlying decoder is created and where IsHardwareAccelerated is answered\nwithout one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328172\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/PlatformDecoderModule.h", "dom/media/platforms/wrappers/MediaChangeMonitor.cpp"], "git_node": "2d21b817158ca0c54c4beb7df0050f65a2a1eeca", "git_parents": ["da0b9692c590493ea028fa46f4455e8b6df2be85"], "node": "4b13bcae52c2669f73bb07d6afb49a48937eb197", "parents": ["639b82d140950ed83b64b563195cc11a3e91c410"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046813 - Part 4: Block shutdown while a strict MediaCapabilities decoder probe is queued or in flight. r=media-playback-reviewers,azebrowski\n\nGlobalAllocPolicy is cleared at XPCOMShutdownThreads, and a SingleAllocPolicy\nallocation that reaches it afterwards hits MOZ_RELEASE_ASSERT(aBasePtr) in\nWrapNotNull. dom/media/test/crashtests/2014861.html floods decodingInfo for\nprofile-less VP9 from workers, and now that such queries synthesize a vpcC each\nstrict probe really instantiates a decoder, so the queue is still draining\nwhen the content process shuts down.\n\nAdd WithAllocPolicy, which runs a probe with the process-wide SingleAllocPolicy\nwhile holding a ShutdownBlockingTicket, resolves unsupported without probing\nonce a ticket can no longer be created, and cancels the queued allocations on\nthe ticket's shutdown notification so the backlog does not hold shutdown back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327173\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp"], "git_node": "9414dcd9d6c4e32a410c2da144bec12e95b65df8", "git_parents": ["2d21b817158ca0c54c4beb7df0050f65a2a1eeca"], "node": "96bea88cca52bbc0a3cc4f02b0e545000ba4b15a", "parents": ["4b13bcae52c2669f73bb07d6afb49a48937eb197"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2081753 - Move global and memory matching onto GlobalType and Limits. r=bvisness\n\nRefactor internals of core GlobalDesc/MemoryDesc so there are types\nwe can use for an 'extern type' and ModuleType/InstanceType.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333639\n", "files": ["js/src/wasm/WasmModuleTypes.cpp", "js/src/wasm/WasmModuleTypes.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "dcf63b2f2e89a3dfebdf09f2d559a10ece2e4cf7", "git_parents": ["9414dcd9d6c4e32a410c2da144bec12e95b65df8"], "node": "e64fd94b747e4fb77accccf6f2ea4b1166cd02a3", "parents": ["96bea88cca52bbc0a3cc4f02b0e545000ba4b15a"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2081753 - Add core extern, instance, and module types. r=bvisness\n\nCoreExternType - an importable/exportable item\nCoreModuleType - a module's type signature\nCoreInstanceType - an instance's type signature\n\nThese will be used in a later patch to simplify type checking of\ncore index spaces in a component.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333640\n", "files": ["js/src/wasm/WasmMetadata.cpp", "js/src/wasm/WasmMetadata.h", "js/src/wasm/WasmModuleTypes.cpp", "js/src/wasm/WasmModuleTypes.h"], "git_node": "7e09cf63024e3e0f2adc8334ea106d6e01545df4", "git_parents": ["dcf63b2f2e89a3dfebdf09f2d559a10ece2e4cf7"], "node": "77d8a0d14a90866d4e8d7413f0d71ad415dac6d4", "parents": ["e64fd94b747e4fb77accccf6f2ea4b1166cd02a3"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2081753 - Use core instance and module types in component validation. r=bvisness\n\nThis flattens the special cases in core instances. We don't need to recurse\nthrough the different kinds of instances to find the extern type anymore.\n\n1. Core modules in a component now have a CoreModuleType\n2. Core instances in a component now have a CoreInstanceType\n3. Instantiate args are checked against CoreModuleType, and yield a CoreInstanceType\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333641\n", "files": ["js/src/jit-test/tests/wasm/components/coreinstances.js", "js/src/wasm/WasmComponent.cpp", "js/src/wasm/WasmComponent.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "b45f0ba2c2608cc75ad725817a539cd43cee6fb5", "git_parents": ["7e09cf63024e3e0f2adc8334ea106d6e01545df4"], "node": "58e0b6f4c42077ca62b9ac4d6e6b01fcd7412c71", "parents": ["77d8a0d14a90866d4e8d7413f0d71ad415dac6d4"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2081753 - Build component core imports from a dense index space of exports objects. r=bvisness\n\nWhen instantiating a component, instead of building a sparse index\nspace of WasmInstanceObject, build a dense vector of exports object.\nThis lets us remove special case logic for inline-exports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333642\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/wasm/components/instantiation.js", "js/src/wasm/WasmComponent.cpp", "js/src/wasm/WasmComponent.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "633434a621770c3c307cb7eac6571c631ea418e6", "git_parents": ["b45f0ba2c2608cc75ad725817a539cd43cee6fb5"], "node": "d459f268f419b58ce2af65c1ff723d53137998c4", "parents": ["58e0b6f4c42077ca62b9ac4d6e6b01fcd7412c71"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2081753 - Store export names directly in component core export aliases. r=bvisness\n\nFully switch a component core export alias to store the name of the\nexport it is referring to. This could be on the ComponentItem itself,\nbut this would blow up the space of it. So instead it's an index into\na component name vector.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333644\n", "files": ["js/src/wasm/WasmComponent.cpp", "js/src/wasm/WasmComponent.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "e31050d9579282673c5b95dcd1fc5620d40db79c", "git_parents": ["633434a621770c3c307cb7eac6571c631ea418e6"], "node": "022fcb717566b3d6a9978474fadb7b2e96b4810f", "parents": ["d459f268f419b58ce2af65c1ff723d53137998c4"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2081753 - Share core index space checks in component validation. r=bvisness\n\nA couple other quick cleanups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333645\n", "files": ["js/src/wasm/WasmValidate.cpp"], "git_node": "fb7aeb8db826e1140bab9df543a29615e81ac71a", "git_parents": ["e31050d9579282673c5b95dcd1fc5620d40db79c"], "node": "39bf3dd87268968335947962923b452753bd693d", "parents": ["022fcb717566b3d6a9978474fadb7b2e96b4810f"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070270 - Standardize widgets search UI. r=fluent-reviewers,nina-py,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333448\n", "files": ["browser/extensions/newtab/content-src/components/Weather/LocationS