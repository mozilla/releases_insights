s/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js"], "git_node": "fe51e666e0ece0778454d80e14d78422190a9451", "git_parents": ["dddb410c7df4013a14700a42709235925178ec86"], "node": "dc34a50ff143c51409f03efe07f3001077267a2d", "parents": ["2e953d619a02f48d0eec40a295e015687e0b400c"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2035899 - Rework how wasm bytecode is copied from shared memory. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330844\n", "files": ["js/src/wasm/WasmCompile.cpp", "js/src/wasm/WasmCompileArgs.h", "js/src/wasm/WasmJS.cpp"], "git_node": "a56c5e937f5584a9068f8b7426a6c57d968bec73", "git_parents": ["fe51e666e0ece0778454d80e14d78422190a9451"], "node": "e6aa60e12a6ab2931fb227c3c63e2b7cb4f579f2", "parents": ["dc34a50ff143c51409f03efe07f3001077267a2d"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2035899 - Don't recopy an existing buffer in BytecodeBufferOrSource::getOrCreateBuffer. r=yury\n\nMissing return prevented an optimization.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330845\n", "files": ["js/src/wasm/WasmCompileArgs.h"], "git_node": "0b79f0e0af2840c666e4ae4dd4a6d80a030755d7", "git_parents": ["a56c5e937f5584a9068f8b7426a6c57d968bec73"], "node": "ad3a5fe49c5a67f6c352ec8f7be3155a99308e4e", "parents": ["e6aa60e12a6ab2931fb227c3c63e2b7cb4f579f2"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2080569 - Migrate viewSource.properties to Fluent, r=firefox-desktop-core-reviewers ,fluent-reviewers,bolsson,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332794\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/webext-panels.xhtml", "python/l10n/fluent_migrations/bug_2080569_viewsource_properties.py", "toolkit/actors/ViewSourcePageChild.sys.mjs", "toolkit/actors/ViewSourcePageParent.sys.mjs", "toolkit/locales/en-US/chrome/global/viewSource.properties", "toolkit/locales/en-US/toolkit/global/viewSource.ftl", "toolkit/locales/jar.mn"], "git_node": "e33605e144d743801c934bad21098d85fa6a990b", "git_parents": ["0b79f0e0af2840c666e4ae4dd4a6d80a030755d7"], "node": "005b84d3ea4c0d6a286cd29cbfea889f9c856dc3", "parents": ["ad3a5fe49c5a67f6c352ec8f7be3155a99308e4e"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077504 - Fix inverted mActivated in nsHttpActivityDistributor, a stale user agent in the socket process, and remove an unused member. r=necko-reviewers,valentin\n\nnsHttpActivityDistributor::RemoveObserver set mActivated to true when no observers were left, so the socket process was never told to deactivate.  nsHttpHandler::SetHttpHandlerInitArgs now marks the user agent dirty so one built before the arguments arrived is rebuilt.  nsHttpTransaction::mPendingDurationTime was written but never read, so remove it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330417\n", "files": ["netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": "64438bf829c13807fb3042ea14d1f7b4bf85d7a1", "git_parents": ["e33605e144d743801c934bad21098d85fa6a990b"], "node": "1182a7875e3f1c293100529d154bf2efd4487e8a", "parents": ["005b84d3ea4c0d6a286cd29cbfea889f9c856dc3"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074994 - Pass NotificationManagerCompat to privacyReportNotificationAvailability r=android-reviewers,twhite\n\n`privacyReportNotificationAvailability` used to take a `Context` used to obtain a `NotificationManagerCompat` instance. It now takes a `NotificationManagerCompat` instance directly given that consumers already hav it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332908\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationScheduler.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationHelperTest.kt"], "git_node": "bd03775a2f1800f169b8a64e26749cf7eb5d3c62", "git_parents": ["64438bf829c13807fb3042ea14d1f7b4bf85d7a1"], "node": "fa6d0b1ffa16af9083acd08596457b0ffcce3676", "parents": ["1182a7875e3f1c293100529d154bf2efd4487e8a"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045822 - factor profile zip archive naming out of gecko_profile.py and chrome_trace.py. r=perftest-reviewers,aglavic\n\nThis patch moves the duplicated in-archive path logic from\n`gecko_profile.py` and `chrome_trace.py` into `_profile_archive_paths`\nin `raptor_profiling.py`.\n\nThe helper now also handles name collisions: when several profiles of\none test map to the same archive path, each profile gets its page alias\nas a subfolder. Existing tests like tp6 have no collisions so their\narchive layout is unchanged (covered by the new tests). This is needed\nfor the next patch, where nav-bench produces one profile per site\nwithin a single browser cycle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331477\n", "files": ["testing/raptor/raptor/chrome_trace.py", "testing/raptor/raptor/gecko_profile.py", "testing/raptor/raptor/raptor_profiling.py", "testing/raptor/test/test_gecko_profile.py"], "git_node": "a6737f6982cbc9be4bd15b6921fe3487eef12387", "git_parents": ["bd03775a2f1800f169b8a64e26749cf7eb5d3c62"], "node": "184f9303afcdcd0a1b1f4d8e35d12458e43c0423", "parents": ["fa6d0b1ffa16af9083acd08596457b0ffcce3676"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045822 - add gecko profiling functionality to nav bench test. r=perftest-reviewers,acreskey,aglavic\n\nThis patch enables gecko profiling for the nav-bench test and also\nbumps the tier from 3-\u003e2\n\nnav-bench is a composite test, one browser cycle loads all the sites,\nso the default profiling flow would give one giant profile for the\nwhole cycle. Instead we set expose_browser_profiler and have\nbrowsertime_interactive.js start/stop the profiler around each measure\ncommand, naming each profile after its site.\n\nworks with both --gecko-profiler and --extra-profiler-run\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326825\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/browsertime.md", "testing/perfdocs/generated/raptor.md", "testing/raptor/browsertime/browsertime_interactive.js", "testing/raptor/raptor/perfdocs/browsertime.md", "testing/raptor/raptor/tests/nav-bench/browsertime-nav-bench.toml"], "git_node": "0f70e93bb8734ebffcdcb8c4af1e1c18344d7031", "git_parents": ["a6737f6982cbc9be4bd15b6921fe3487eef12387"], "node": "a9b76facc899baa74f763231cdfe4e6ed922fa20", "parents": ["184f9303afcdcd0a1b1f4d8e35d12458e43c0423"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072861: Limit and sort context urls when generating an AITab r=omarg,mzhang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331449\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_context_tab_limit.js", "browser/components/aiwindow/ui/test/browser/aitab/head.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_menu_triggers.js"], "git_node": "bde9d242f1643b8c99dbd66af83c976c05c909ff", "git_parents": ["0f70e93bb8734ebffcdcb8c4af1e1c18344d7031"], "node": "48a30c88235f9273f8e67b7ddef11abd64fe60f4", "parents": ["a9b76facc899baa74f763231cdfe4e6ed922fa20"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066763 - Add telemetry for deliberate ETP disablement action in the Trust Panel r=urlbar-reviewers,timhuang,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324254\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js"], "git_node": "0c1025123d09390679b9f2d84700a24af88ddf3e", "git_parents": ["bde9d242f1643b8c99dbd66af83c976c05c909ff"], "node": "631462d462c2e5831ae672aa09b5458ef3aa5019", "parents": ["48a30c88235f9273f8e67b7ddef11abd64fe60f4"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066764 - Add telemetry for Clear Cookies and Site Data option in the new Trust Panel r=urlbar-reviewers,timhuang,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324255\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js"], "git_node": "4f827abf46ca293d53393155843e752dcd03fe9f", "git_parents": ["0c1025123d09390679b9f2d84700a24af88ddf3e"], "node": "08107cb9d921d83536c645c9e97a78c175e4656c", "parents": ["631462d462c2e5831ae672aa09b5458ef3aa5019"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066765 - Add telemetry for security info subview in the new Trust Panel r=urlbar-reviewers,timhuang,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324256\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_cert_exception.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js", "browser/components/urlbar/tests/browser-trustPanel/head.js"], "git_node": "5a3268c8adce4b51302f16b88ac4396d85e4e2a3", "git_parents": ["4f827abf46ca293d53393155843e752dcd03fe9f"], "node": "b988001265248dd06862a5c3424518ec2f216767", "parents": ["08107cb9d921d83536c645c9e97a78c175e4656c"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069505 - Add telemetry for the tracker list and per-tracker detail subviews in the Trust Panel r=urlbar-reviewers,timhuang,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324257\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/metrics.yaml", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js", "tools/lint/rejected-words.yml"], "git_node": "659ebcab90b98ac7d5e3b21c85c7d1b0dda13fe7", "git_parents": ["5a3268c8adce4b51302f16b88ac4396d85e4e2a3"], "node": "f64c300f08fa833be20f5319c60ce834e0a26026", "parents": ["b988001265248dd06862a5c3424518ec2f216767"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069506 - Add a Trust Panel close event to measure dwell time and abandonment r=urlbar-reviewers,timhuang,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324258\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/content/components/breach-alert-panel.mjs", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js"], "git_node": "f258f2881a28d22f8aa3f9cad7f4da4bfe575e5f", "git_parents": ["659ebcab90b98ac7d5e3b21c85c7d1b0dda13fe7"], "node": "8eab10e3f407d5fafcd56b51d9c243dc46ae5a9f", "parents": ["f64c300f08fa833be20f5319c60ce834e0a26026"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069507 - Record trust panel opening reason r=urlbar-reviewers,timhuang,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324259\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js"], "git_node": "22e095ca59aef00143400713e99e8154e0623563", "git_parents": ["f258f2881a28d22f8aa3f9cad7f4da4bfe575e5f"], "node": "96edb99e49edf375731fe93bb614fdef1d6cc724", "parents": ["8eab10e3f407d5fafcd56b51d9c243dc46ae5a9f"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074550 - Key start()/stop() off the in-flight activation, not the ACTIVATING state r=ip-protection-reviewers,rking\n\nupdateState() demotes ACTIVATING back to READY while an activation is still\nrunning, so a start() issued from that announcement opened a second activation\nand the two raced for the one channel filter.\n\nTrack the in-flight activation via #activatingPromise instead, clearing it\nbefore any state is announced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328886\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "bcf621f5b087feefd11be6aea9cb532b47133f57", "git_parents": ["22e095ca59aef00143400713e99e8154e0623563"], "node": "06ac71d3d4790d880a3b1bdbc50993a3652b90dc", "parents": ["96edb99e49edf375731fe93bb614fdef1d6cc724"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066840 - Move proxy mode ownership into IPPProxyManager r=ip-protection-reviewers,rking\n\nIPPChannelFilter read browser.ipProtection.mode itself, so nothing could ask\nfor a connection in another mode. Moving this into ProxyManager, we can now ask for specific types\nof activations and the UI can check what mode we are in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325907\n", "files": ["toolkit/components/ipprotection/IPPChannelFilter.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/docs/Constants.md", "toolkit/components/ipprotection/docs/Preferences.md", "toolkit/components/ipprotection/tests/xpcshell/head.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPChannelFilter.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "8ef939f874f3da37800c0e40effb570055c0e520", "git_parents": ["bcf621f5b087feefd11be6aea9cb532b47133f57"], "node": "8964313ff115d3a5adfb55fea983b1c5bb73dcc7", "parents": ["06ac71d3d4790d880a3b1bdbc50993a3652b90dc"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066842 - Let start() wait for the service instead of IPPEarlyStartupFilter r=ip-protection-reviewers,rking\n\nIPPEarlyStartupFilter was a hidden half-started state: traffic held behind a\nchannel filter with no activation the state machine knew about. ACTIVATING is\nthat state, but start() could only enter it once the service was READY. It now\nregisters the filter and waits in ACTIVATING for a service that may still\nbecome ready, so the helpers that built an early filter simply ask for the\nproxy, and updateState() leaves the state to an activation in flight.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328888\n", "files": ["toolkit/components/ipprotection/IPPAutoRestore.sys.mjs", "toolkit/components/ipprotection/IPPAutoStart.sys.mjs", "toolkit/components/ipprotection/IPPEarlyStartupFilter.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/IPPStartupCache.sys.mjs", "toolkit/components/ipprotection/IPProtectionService.sys.mjs", "toolkit/components/ipprotection/docs/Preferences.md", "toolkit/components/ipprotection/docs/StateMachine.md", "toolkit/components/ipprotection/enterprise/IPPAlwaysOn.sys.mjs", "toolkit/components/ipprotection/moz.build", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAlwaysOn.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "5cc9442898d36336da8a1a31238a8aba229a0cae", "git_parents": ["8ef939f874f3da37800c0e40effb570055c0e520"], "node": "3b61d7b53f6c8415b85b20273a1d25781ce9f242", "parents": ["8964313ff115d3a5adfb55fea983b1c5bb73dcc7"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066842 - Decide desktop auto-activation in one component r=ip-protection-reviewers,rking\n\nIPPAutoStart and IPPAutoRestore both wanted full protection and differed only\nin what made them want it. IPPAutoActivation is the one owner, with\ndesiredMode() as the one decision, and full protection is owed once: cleared\non the ask, owed again when the service returns to READY. IPProtectionActivator\npicks the activation helper per build: this one on desktop, IPPAlwaysOn on\nenterprise, none on Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328889\n", "files": ["toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPAutoRestore.sys.mjs", "toolkit/components/ipprotection/IPPAutoStart.sys.mjs", "toolkit/components/ipprotection/IPProtectionActivator.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/enterprise/IPPAlwaysOn.sys.mjs", "toolkit/components/ipprotection/moz.build", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoRestore.js", "toolkit/components/ipprotection/tests/xpcshell/xpcshell.toml"], "git_node": "4226b37e3d56703454fde75869df3b9a947459dc", "git_parents": ["5cc9442898d36336da8a1a31238a8aba229a0cae"], "node": "a0a9682747581f2395136ed519d074d8d6faac67", "parents": ["3b61d7b53f6c8415b85b20273a1d25781ce9f242"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066842 - Keep always-on sites covered through IPPAutoActivation r=ip-protection-reviewers,rking\n\nA site marked as always using the VPN was only proxied while the user\nhappened to have a connection up. desiredMode() now asks for inclusion mode\nwhile any rule provider holds an included site, so a match pattern counts the\nsame as an ipp-vpn permission. The reason is standing: the proxy going idle or\nthe rules changing asks again, and the last inclusion going away takes the\nnarrow connection down. IPPSiteRuleManager becomes a core helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328890\n", "files": ["browser/components/ipprotection/IPProtectionHelpers.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleManager.sys.mjs", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/IPProtectionActivator.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js", "toolkit/components/ipprotection/tests/xpcshell/test_MatchPatternPrefRule.js", "toolkit/components/ipprotection/tests/xpcshell/test_SiteRuleManager.js"], "git_node": "fc87f27a2297fc0fbb6e0db6fe636866e1243b08", "git_parents": ["4226b37e3d56703454fde75869df3b9a947459dc"], "node": "6a441b3e7d997710551042c01eb9680c691ed1e7", "parents": ["a0a9682747581f2395136ed519d074d8d6faac67"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079752 - Only count the toggle's own mode as protection being on in the panel r=ip-protection-reviewers,rking\n\nThe panel treated any active connection as the VPN being on, whatever mode\nit was in.\nNow it only counts the mode the toggle turns on.\nTurning it on while a narrower connection is up switches that connection's mode instead of\nstarting a second one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332877\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_confirmation_hints_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_toolbar.js", "browser/components/ipprotection/tests/browser/head.js", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs"], "git_node": "7e2feeed1249118c58d26aaf6e0ca7197316c356", "git_parents": ["fc87f27a2297fc0fbb6e0db6fe636866e1243b08"], "node": "bf8a721e1089e9bb4052c5c59238f1a5948ec2e6", "parents": ["6a441b3e7d997710551042c01eb9680c691ed1e7"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074126: Implement Journey Manager interface that calls existing resume-activity functions r=cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328227\n", "files": ["browser/components/aiwindow/models/ConversationSuggestions.sys.mjs", "browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/memories/journeys/moz.build", "browser/components/aiwindow/models/memories/moz.build", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js", "browser/components/aiwindow/models/tests/browser/browser_conversation_starters.js"], "git_node": "7d381b64f2bf84da8194e26138a2b637ec2f8990", "git_parents": ["7e2feeed1249118c58d26aaf6e0ca7197316c356"], "node": "1260a5cfa3fee145db4bb38a3915038d97df6433", "parents": ["bf8a721e1089e9bb4052c5c59238f1a5948ec2e6"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078383 - Route frontend resume activity through JourneyManager. r=pdahiya,cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330923\n", "files": ["browser/components/aiwindow/models/ConversationSuggestions.sys.mjs", "browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "cca5a526251f1787e66ceec1d813ec8199065187", "git_parents": ["7d381b64f2bf84da8194e26138a2b637ec2f8990"], "node": "929f1e08227c3dc21e98b71c10e5c1872bdfe75e", "parents": ["1260a5cfa3fee145db4bb38a3915038d97df6433"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025386 - Replace per-instance weak memory reporters with a strong singleton. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328759\n", "files": ["dom/file/BlobImpl.h", "dom/file/BlobMemoryReporter.cpp", "dom/file/BlobMemoryReporter.h", "dom/file/StreamBlobImpl.cpp", "dom/file/StreamBlobImpl.h", "dom/file/StringBlobImpl.cpp", "dom/file/StringBlobImpl.h", "dom/file/moz.build"], "git_node": "248db073790584f8cbc1ea6a621ff99d64f30504", "git_parents": ["cca5a526251f1787e66ceec1d813ec8199065187"], "node": "dfe4173242fae35027bce0312b6146235c754e6f", "parents": ["929f1e08227c3dc21e98b71c10e5c1872bdfe75e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059340 - When CaretPositionFromPoint rewrites the node to be relative to the text, also rewrite the offset as needed. r=dom-core-reviewers,smaug\n\nThis is a bit hacky, but no less correct than what we were doing before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332960\n", "files": ["dom/base/Document.cpp", "testing/web-platform/tests/css/cssom/caretPositionFromPoint-textarea.html"], "git_node": "8f48ec7c5318acaaae9a4e52a42a71fa85926895", "git_parents": ["248db073790584f8cbc1ea6a621ff99d64f30504"], "node": "91a77df60771e8be4dc7cf2a251d55aebf711b86", "parents": ["dfe4173242fae35027bce0312b6146235c754e6f"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070673 - enable playback speed controls for PiP player. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332093\n", "files": ["browser/app/profile/firefox.js"], "git_node": "7dba7828d76d91cd050b36575b350ae4e1f6a5dc", "git_parents": ["8f48ec7c5318acaaae9a4e52a42a71fa85926895"], "node": "9a4dee2caedfd8b71ebb7004d695e11c6756377b", "parents": ["91a77df60771e8be4dc7cf2a251d55aebf711b86"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073792 - [devtools] Prevent text selection on 'Copy Rule' and 'Copy All Changes' buttons. r=devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332832\n", "files": ["devtools/client/themes/changes.css"], "git_node": "53282626ce3191172969ad4aaaeae6bb022e0477", "git_parents": ["7dba7828d76d91cd050b36575b350ae4e1f6a5dc"], "node": "29ff8f46d158af83dbd310280bebe7d72799489f", "parents": ["9a4dee2caedfd8b71ebb7004d695e11c6756377b"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075450: pre: refactor code-review task to remove lint-specific hardcoding r=marco,taskgraph-reviewers,jcristau\n\nThis will allow us to easily add a second task for build/test tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332182\n", "files": ["taskcluster/gecko_taskgraph/transforms/code_review.py", "taskcluster/kinds/code-review/kind.yml"], "git_node": "a430c6ceb8a649fafd869b468fd1714cceb1daa3", "git_parents": ["53282626ce3191172969ad4aaaeae6bb022e0477"], "node": "cc06eabfd043261ccdbe0cf94eb295b291ed7eae", "parents": ["29ff8f46d158af83dbd310280bebe7d72799489f"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075450: add code-review-build-test-issues task r=marco,taskgraph-reviewers,jcristau\n\nThis allows us to distinctly notice completion of non-linting tasks that reviewbot and pull requests create.\n\nWhen a try push uses the `codereview-build-test` target tasks method it will cause builds to be pulled in as part of reviewbot pushes. Pull requests to the Firefox repository will also cause builds to be pulled in. Note that there is no optimization or smart selection of these builds initially: they will always run. I will follow-up in the future to make this part better prior to adding any additional jobs here; for now let's get some quick and dirty builds going.\n\nIn addition to the new task, it requires some minor adjustments to target tasks as well:\n- Selecting only the appropriate `code-review` task on the phabricator target tasks methods (we don't want to, eg: fire build events for lint pushes)\n- Selecting both on the Github side (because we only have one decision task there)\n\nThis was tested on the phab side with https://treeherder.mozilla.org/jobs?repo=try&revision=2f369becf766120ec172c296f8a5e7c59d7742f2 and https://treeherder.mozilla.org/jobs?repo=try&revision=2192efd39bd10fd68f0f28fed622e1948e709a30 (ignore the red decision task; that was caused by a missing scope).\n\nAnd on the Github side we've got https://firefox-ci-tc.services.mozilla.com/tasks/XDml51tUS5G79N9IJzrcOQ. That failed for different, unrelated scope reasons, but we can see in [its task-graph.json](https://firefoxci.taskcluster-artifacts.net/XDml51tUS5G79N9IJzrcOQ/0/public/task-graph.json) that it tried to run the correct build & linting tasks:\n```\nbuild-android-aarch64/opt\nbuild-ios/opt\nbuild-linux64/debug\nbuild-linux64/opt\nbuild-macosx64-aarch64/opt\nbuild-win64/opt\ncode-review-build-test-issues\ncode-review-issues\neager-index-toolchain-linux64-android-gradle-dependencies\neager-index-toolchain-linux64-embedded-uniffi-bindgen\neager-index-toolchain-linux64-nimbus-fml\neager-index-toolchain-linux64-rust-ios-1.95\nsource-test-mozlint-codespell\nsource-test-mozlint-dot-mozilla-reference\nsource-test-mozlint-file-perm\nsource-test-mozlint-file-whitespace\nsource-test-mozlint-license\nsource-test-mozlint-py-ruff\nsource-test-mozlint-py-ruff-format\nsource-test-mozlint-rejected-words\nsource-test-mozlint-trojan-source\nsource-test-mozlint-yaml\nsource-test-taskgraph-diff\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332183\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/code-review/kind.yml"], "git_node": "9d1c524a3074d59eed1c5a3cf6dbbcda855851a7", "git_parents": ["a430c6ceb8a649fafd869b468fd1714cceb1daa3"], "node": "8959ffe964a9f050a2678456929ce52f8096a8d0", "parents": ["cc06eabfd043261ccdbe0cf94eb295b291ed7eae"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080891 - Remove New badge from location button - r=ip-protection-reviewers,fluent-reviewers,bolsson,apopov\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332923\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/content/ipprotection-status-card.css", "browser/components/ipprotection/content/ipprotection-status-card.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_panel.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_card.js", "browser/components/ipprotection/tests/browser/head.js", "browser/components/ipprotection/tests/xpcshell/test_IPProtectionPanel.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "43b12ee5f7ca8937d37000229cc2481ba0a9a42f", "git_parents": ["9d1c524a3074d59eed1c5a3cf6dbbcda855851a7"], "node": "503e8eba4e78824d8b712fae48b9e795ee90d9aa", "parents": ["8959ffe964a9f050a2678456929ce52f8096a8d0"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2080056 - Make PictureInPicture policy disable the context menu item. r=jmendez\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332974\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": "399acd02629ba0b33214c58fa047b0c52f67df30", "git_parents": ["43b12ee5f7ca8937d37000229cc2481ba0a9a42f"], "node": "673e047adf34587c919588d92bb09e0e4570ba1e", "parents": ["503e8eba4e78824d8b712fae48b9e795ee90d9aa"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078975 - Swapped usesCustomEndpoint for conversation.engine.isCustomEndpoint r=cdipersio\n\nPreviously, we included a function usesCustomEndpoint() to check if a user was using a custom endpoint before deciding\nwhich search function to route the request to (fast vs answer). We wish to always pass queries from users on custom\nendpoints to fast - since using a custom endpoint may indicate a preference for restricting inference to chosen\nproviders (possibly local).\n\nIn usesCustomEndpoint(), we detected a custom endpoint by looking at browser.smartwindow.firstrun.modelChoice and\nby comparing browser.smartwindow.endpoint to the DEFAULT (prod) URL. This worked, except,\nbrowser.smartwindow.firstrun.modelChoice is set in about:preferences and remains static until it is changed either\nin about:preferences (or in about:config). importantly, it is NOT changed when the user overrides the\nabout:preferences model using the model picker dropdown in the chat window.\n\nThis means that declaring a custom model in about:preferences and then choosing a provided model in the picker would\nblock /ansers - even though the user is using the a provided model and the Fx endpoint. Alternatively, if the user\ndefines a custom endpoint in about:preferences, but then selects one of our provided endpoints in about:preferences\nand then navigates to \"custom\" in the picker dropdown, the user will get a /answers search.\n\nThis patch address this issue by swapping \"usesCustomEndpoint\" for a check against the conversation object (which\ncontains information about the current conversation state). specifically, we compare the baseUrl attribute of engine\nin the specific converseation we're working with to the prod MLPA endpoint.\n\nThe baseURL attribute is set when engine.build() is called, using the model_choice_id which is passed at build time.\nWhen we override the model_choice_id set in about:preferences using the model picker dropdown, this new model_choice_id\nis passed to buildEngineforFeature (without changing the actual pref - which is set by about:preferences) - which\nthen checks the CUSTOM_ENDPOINT_PREF to retreive a base_url. If the override is from custom -\u003e provided,\nthe baseURL set in resolveEndpointConfig will carry the value of browser.smartwindow.endpoint (note:\nour change also detects when this value is manually changed - via about:config - so something custom)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331447\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/openAIEngine.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js"], "git_node": "f4bc7e6814ddacaa58d1375331b17e40a856e532", "git_parents": ["399acd02629ba0b33214c58fa047b0c52f67df30"], "node": "38edabf98fb136fc8c1e0c9aaae03d1be9af2650", "parents": ["673e047adf34587c919588d92bb09e0e4570ba1e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080902 - Tell the documentation skill how to check a page retitle and where to preview the rendered pages. r=sylvestre DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332946\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "b0c3a5ee0ddf43d0fbc66633a25804e30e533f46", "git_parents": ["f4bc7e6814ddacaa58d1375331b17e40a856e532"], "node": "2b2feb4a29bc9aa14733acae00d37876136422a3", "parents": ["38edabf98fb136fc8c1e0c9aaae03d1be9af2650"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2079696 - Render the AI skill instead of pointing to the source r=ai4dev-reviewers,suhaib DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331985\n", "files": [".agents/skills/android-new-module/SKILL.md", ".agents/skills/android/SKILL.md", ".agents/skills/bug-filing/SKILL.md", ".agents/skills/documentation/SKILL.md", ".agents/skills/file-good-first-bug/SKILL.md