/ViewSourcePageChild.sys.mjs", "toolkit/actors/ViewSourcePageParent.sys.mjs", "toolkit/locales/en-US/chrome/global/viewSource.properties", "toolkit/locales/en-US/toolkit/global/viewSource.ftl", "toolkit/locales/jar.mn"], "git_node": "68ca2967561a707eb77c11c521c079aaf9ff6cbb", "git_parents": ["6b43f81076cdc0d595135c1c256e4152d6e93256"], "node": "d350bc0ba0fa5bc4a4c87ab50ffb0d163a79a69b", "parents": ["f462d246ae3c4a8dab1c9daa56ea29ce5616aa66"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2080565 - Remove unused .properties strings, r=firefox-desktop-core-reviewers ,media-playback-reviewers,padenot,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332791\n", "files": ["browser/components/customizableui/test/browser_open_in_lazy_tab.js", "browser/locales/en-US/chrome/browser/browser.properties", "browser/locales/en-US/chrome/browser/taskbar.properties", "browser/locales/en-US/chrome/overrides/appstrings.properties", "dom/media/doctor/test/browser/browser_decoderDoctor.js"], "git_node": "45b93537507da9aa829abf34cbdad8b1de86836c", "git_parents": ["68ca2967561a707eb77c11c521c079aaf9ff6cbb"], "node": "ab753f78e2ff4415aa4b48a281fb88c3b9741a72", "parents": ["d350bc0ba0fa5bc4a4c87ab50ffb0d163a79a69b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080943 - Avoid some includes in PrintTargetSkPdf.h. r=gfx-reviewers,lsalzman\n\nThis will be necessary when we remove PrintTargetPDF, and in general\nmakes the code a bit easier to reason about and less dependent on skia\nheaders.\n\nThe macOS change uses the same style as we use on windows / gtk.\n\nNo intended behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332995\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "gfx/thebes/PrintTargetSkPDF.h", "widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "d6844b32536e0f89cecd9aaf50870e29f9e010dc", "git_parents": ["45b93537507da9aa829abf34cbdad8b1de86836c"], "node": "7cbc1b07d055a1db8271389268433be73a005754", "parents": ["ab753f78e2ff4415aa4b48a281fb88c3b9741a72"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "ffd92ad26efcaf54de66b4b02beab221a16a3727", "git_parents": ["d6844b32536e0f89cecd9aaf50870e29f9e010dc", "64cfaf34e56f4c82eea77d032ec592c083b5b161"], "node": "37375913c7645ce4e0a27f026b42dd93e1e094aa", "parents": ["7cbc1b07d055a1db8271389268433be73a005754", "d250b3077d8dc23d9b64d03deaaeaf71c9bd09b5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080943 - Simplify PrintTargetRecording's API. r=gfx-reviewers,lsalzman\n\nThis code is currently dead (see also the next commit), but can be\nsignificantly simpler. Don't use a dummy cairo surface, just use a dummy\nSkia one. We only use it for recording anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332997\n", "files": ["gfx/thebes/PrintTargetRecording.cpp", "gfx/thebes/PrintTargetRecording.h"], "git_node": "7f16ba64d2bb372627a4dc2c5b7c07796d150117", "git_parents": ["ffd92ad26efcaf54de66b4b02beab221a16a3727"], "node": "e389a1427b1f03562ff832c67f468d5d57dcf5dd", "parents": ["37375913c7645ce4e0a27f026b42dd93e1e094aa"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080943 - Use PrintTargetRecording instead of PrintTargetThebes. r=gfx-reviewers,lsalzman\n\nIt's much simpler, and we don't need all the extra complexity since the\ntarget is only used for recording, see also the previous commit.\n\nThe two bugs mentioned in the comment seem solved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332998\n", "files": ["gfx/thebes/PrintTarget.h", "gfx/thebes/PrintTargetThebes.cpp", "gfx/thebes/PrintTargetThebes.h", "gfx/thebes/moz.build", "widget/nsDeviceContextSpecProxy.cpp"], "git_node": "b9160962dc882746904f58e0a8a1034243bf3622", "git_parents": ["7f16ba64d2bb372627a4dc2c5b7c07796d150117"], "node": "b0469080e3cd7f96ecf2d03f4b41108583eedcbb", "parents": ["e389a1427b1f03562ff832c67f468d5d57dcf5dd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080943 - Remove PrintTargetPDF. r=gfx-reviewers,lsalzman\n\nReplaced by PrintTargetSkPDF for all purposes.\n\nUnlike most other printing code, save to PDF is pretty well tested and\nthus I think we can try to do this now / over these next couple weeks\ngiven SkPdf is riding the trains (hitting release tomorrow).\n\nBut I'm also fine holding off on this for a couple releases if folks\ndeem it appropriate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333002\n", "files": ["accessible/tests/browser/pdfOutput/browser.toml", "gfx/thebes/PrintTargetPDF.cpp", "gfx/thebes/PrintTargetPDF.h", "gfx/thebes/moz.build", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/pdfjs/test/browser_pdfjs_printtopdf.js", "widget/android/nsDeviceContextAndroid.cpp", "widget/cocoa/nsDeviceContextSpecX.mm", "widget/gtk/nsDeviceContextSpecG.cpp", "widget/windows/nsDeviceContextSpecWin.cpp"], "git_node": "0897918f8009e8bf8d81059fe3ca4ae0b57a588c", "git_parents": ["b9160962dc882746904f58e0a8a1034243bf3622"], "node": "eac5bd7a911c943847b070c9c9c253f2fa0c7d89", "parents": ["b0469080e3cd7f96ecf2d03f4b41108583eedcbb"], "tags": []}, {"author": "Jaron Kramer \u003cinfo@jkramertech.com\u003e", "branch": "default", "desc": "Bug 1961431 - Respect reduced motion for fullscreen API transitions. r=vhilla,edgar\n\nSkip fullscreen API fade transitions when LookAndFeel reports a preference for reduced motion. Check the setting on each request and preserve the configured transition durations.\n\nAdd a browser test using DOMFullscreenTestUtils that covers entering and leaving fullscreen with reduced motion disabled, enabled, and disabled again. Run on all desktop platforms and expect custom transitions on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330168\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "dom/base/test/fullscreen/browser.toml", "dom/base/test/fullscreen/browser_fullscreen-reduced-motion.js"], "git_node": "330a0159eb855932c025475be782f3e44a9a0fbb", "git_parents": ["0897918f8009e8bf8d81059fe3ca4ae0b57a588c"], "node": "da59f5a2c49d37453beedd2d5f245af4c4b651d0", "parents": ["eac5bd7a911c943847b070c9c9c253f2fa0c7d89"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073095 - set up ci config to run ui tests on nightly build. r=sfamisa\n\nthis allows you to run `./mach try fuzzy --full -q \"'ui-test-apk-fenix-arm-nightly\"` to exercise the ui tests on nightly\n\nsome changes required:\n- `StartupExcessiveResourceUseTest` needs excluding for nightly because it looks at StrictMode violations, which are only flagged on debug.\n\n- fix java.lang.RuntimeException: Unable to resolve activity for: Intent { act=android.intent.action.MAIN cat=[android.intent.category.LAUNCHER] cmp=org.mozilla.fenix.test/androidx.activity.ComponentActivity }. This was causing all tests to take 45s to run as they were hitting a timeout on nightly (:\n\n- run on merge to mozilla-central only. this saves a bit of cash as it only happens twice a day.\n\n[`./mach try --preset android-fenix` is running here](https://treeherder.mozilla.org/jobs?repo=try&revision=11f55b5b96434545cfe75568d4dde7ee1a85e56f)\n[`./mach try fuzzy --full -q \"'ui-test-apk-fenix-arm-nightly\"` is running here](https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=101947)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/382\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/androidTest/AndroidManifest.xml", "mobile/android/test_infra/flank-configs/fenix/arm-nightly-full.yml", "taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "9db5e78749358de3c3e6e3f5d2202446a5401b8f", "git_parents": ["330a0159eb855932c025475be782f3e44a9a0fbb"], "node": "3353b7fef507694313df6433811292abac86aaee", "parents": ["da59f5a2c49d37453beedd2d5f245af4c4b651d0"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080569 - Migrate viewSource.properties to Fluent, r=firefox-desktop-core-reviewers ,fluent-reviewers,bolsson,mossop\" for causing devtools failures in browser_aboutdebugging_addons_debug_reload.js.\n\nThis reverts commit 68ca2967561a707eb77c11c521c079aaf9ff6cbb.\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "python/l10n/fluent_migrations/bug_2080569_viewsource_properties.py", "toolkit/actors/ViewSourcePageChild.sys.mjs", "toolkit/actors/ViewSourcePageParent.sys.mjs", "toolkit/locales/en-US/chrome/global/viewSource.properties", "toolkit/locales/en-US/toolkit/global/viewSource.ftl", "toolkit/locales/jar.mn"], "git_node": "bcb9b73f2cb8fd97b76d87016661ce0ef84434ee", "git_parents": ["9db5e78749358de3c3e6e3f5d2202446a5401b8f"], "node": "fbf23793f7f9dfe69f99c31a1b8a05a2d4863cab", "parents": ["3353b7fef507694313df6433811292abac86aaee"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062046 - Fix nested #if/#elif and comment handling in etp_matrix.py pref parser r=dmehic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322257\n", "files": ["docs/_addons/etp_matrix.py"], "git_node": "93a149df02afd03dd0f98a6bbade19a49e6049ae", "git_parents": ["bcb9b73f2cb8fd97b76d87016661ce0ef84434ee"], "node": "f5abea45fc1c510aac39d5431976d1aa6ce22c65", "parents": ["fbf23793f7f9dfe69f99c31a1b8a05a2d4863cab"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079676. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333187\n", "files": ["dom/canvas/OffscreenCanvasDisplayHelper.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.h"], "git_node": "b3cb7d1aba25441b8248bc1eeaf74e2994acdee3", "git_parents": ["93a149df02afd03dd0f98a6bbade19a49e6049ae"], "node": "9a9c0e1701ce052099eed9f53ab59737e83adc89", "parents": ["f5abea45fc1c510aac39d5431976d1aa6ce22c65"], "tags": []}, {"author": "Fabio Kaminski \u003cfabiokaminski@gmail.com\u003e", "branch": "default", "desc": "Bug 1841326 Colorspace property added and correctly managed in CanvasRenderingContext2d and ImageData r=gfx-reviewers,webidl,emilio,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332911\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/ImageBitmap.cpp", "dom/canvas/ImageData.cpp", "dom/canvas/ImageData.h", "dom/webidl/CanvasRenderingContext2D.webidl", "dom/webidl/ImageData.webidl", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b7ad87f9b6b5908ef2931980d2e8b4f530b94dfb", "git_parents": ["b3cb7d1aba25441b8248bc1eeaf74e2994acdee3"], "node": "8a2f6b5805375cf4a8a9753afe575b44accc04a7", "parents": ["9a9c0e1701ce052099eed9f53ab59737e83adc89"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080641 - More consistently deal with FontFaceSet promise resolution. r=layout-reviewers,firefox-style-system-reviewers,boris\n\nDon't use the ready promise status as a proxy for \"do we need to\nschedule the resolve\".\n\nThis prevents .ready from resolving when other loads have started after\nthe fact already.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332819\n", "files": ["layout/style/FontFaceImpl.cpp", "layout/style/FontFaceSet.cpp", "layout/style/FontFaceSet.h", "layout/style/FontFaceSetDocumentImpl.cpp", "layout/style/FontFaceSetImpl.cpp", "layout/style/FontFaceSetImpl.h"], "git_node": "c24242d7e49f2cc930792d5b6935ef0b3093b4bb", "git_parents": ["b7ad87f9b6b5908ef2931980d2e8b4f530b94dfb"], "node": "2c50754d6589afe2254725dbfac7793db9cdfcd2", "parents": ["8a2f6b5805375cf4a8a9753afe575b44accc04a7"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076535 - Report schema validation errors from the glean-parser linter r=linter-reviewers,janerik,sylvestre\n\nglean_parser reports schema validation errors as blocks separated by\nlines of \"=\", not as \"WARNING:\"/\"ERROR:\" lines like the glinter nits,\nso the linter silently dropped them and passed files that fail\nvalidation. Turn those blocks into lint errors too.\n\nThis uncovered that static_metrics.yaml is linted together with\ngenerated_metrics.yaml, which contains the same metrics, so exclude it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332398\n", "files": ["tools/lint/glean-parser.yml", "tools/lint/glean-parser/__init__.py", "tools/lint/test/files/glean-parser/invalid/all_pings_metrics.yaml", "tools/lint/test/files/glean-parser/invalid/metrics.yaml", "tools/lint/test/files/glean-parser/invalid_tags/tags.yaml", "tools/lint/test/test_glean_parser.py"], "git_node": "383d4900433874cfff7111a202fd7e8023179316", "git_parents": ["c24242d7e49f2cc930792d5b6935ef0b3093b4bb"], "node": "f38b03d1ea59d998242e6ad78f3932d8b004c680", "parents": ["2c50754d6589afe2254725dbfac7793db9cdfcd2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073936 - Fix post barrier in buffer allocator test code r=spidermonkey-reviewers,jandem\n\nThe buffer allocator jsapi tests want to allocate a bunch of nursery-owned\nbuffers without also having to allocate nursery objects to hold them. To do\nthis we add the (tenured) holder object to the whole cell store buffer so that\nit gets traced on minor GC. This ends up tracing the buffers as if they had\nbeen referenced from some traced nursery object. However we don't trace the\nstore buffers if the nursery is empty so this can fail.\n\nThe patch ensures the nursery is not empty when adding these store buffer\nentries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332852\n", "files": ["js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "99e27d00c0502a59531d3c65c7c4999f50a57a5e", "git_parents": ["383d4900433874cfff7111a202fd7e8023179316"], "node": "cfd7883e3ad96d88ebd3692574624597f6ea4236", "parents": ["f38b03d1ea59d998242e6ad78f3932d8b004c680"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072138, part 1 - CSS Highlight: Support parsing and serialization of universal highlight selectors. r=emilio,firefox-style-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333127\n", "files": ["servo/components/style/gecko/pseudo_element.rs", "servo/components/style/gecko/pseudo_element_definition.mako.rs", "servo/components/style/gecko/pseudo_elements.toml", "servo/components/style/gecko/selector_parser.rs", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-parsing-and-computed-style.tentative.html.ini"], "git_node": "3619882626e0419c086b316ce65a7a77e2faa829", "git_parents": ["99e27d00c0502a59531d3c65c7c4999f50a57a5e"], "node": "30b984235f976e88ebbd3b376018269548ba1dc5", "parents": ["cfd7883e3ad96d88ebd3692574624597f6ea4236"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072138, part 2 - CSS Highlight: Apply universal highlight rules to named highlight styles. r=emilio,firefox-style-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333128\n", "files": ["servo/components/style/gecko/pseudo_element_definition.mako.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-escaped-star.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-no-named-rule-001.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-painting-001.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-painting-002.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-painting-003.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-parsing-and-computed-style.tentative.html.ini"], "git_node": "53b2d2f0f209ae57e03adeb80e7f4f2869c80024", "git_parents": ["3619882626e0419c086b316ce65a7a77e2faa829"], "node": "7447fc243800d82f86c86a4b00aa8d427f2a1307", "parents": ["30b984235f976e88ebbd3b376018269548ba1dc5"], "tags": []}, {"author": "Fabio Kaminski \u003cfabio.kaminski@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2078878 fix EXT_texture_norm16 test exposing only to webGL2 r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331919\n", "files": ["dom/canvas/test/webgl-mochitest/ensure-exts/test_common.html"], "git_node": "1931dc57f53dcec1dfa6c3b1cec489a0ff487667", "git_parents": ["53b2d2f0f209ae57e03adeb80e7f4f2869c80024"], "node": "888929a8d88b1fd790908055ed8f5ce418ac7091", "parents": ["7447fc243800d82f86c86a4b00aa8d427f2a1307"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075484: Report scrollbar hover and drag activity to the scrollbar mediator. r=emilio,layout-reviewers\n\nSince bug 1927132, nsScrollbarFrame::ActivityChanged only notified a ScrollContainerFrame parent. XUL trees register nsTreeBodyFrame as the mediator through SetOverrideScrollbarMediator, so hovering or dragging a tree's overlay scrollbar no longer kept it visible.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333071\n", "files": ["layout/xul/nsScrollbarFrame.cpp"], "git_node": "c0ce2fcb8f04d8f5be56ba2bd7ac70b4cb7a1545", "git_parents": ["1931dc57f53dcec1dfa6c3b1cec489a0ff487667"], "node": "db3c3304bb9ee9478ad6a210e0cd7ba1e2d89b8d", "parents": ["888929a8d88b1fd790908055ed8f5ce418ac7091"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2033336 - Revert \"Bug 2033336 - Unpack GCNO files to topobjdir\". r=marco\n\nThis reverts:\n- 41b974a21cd8549a7ecc926924f78488e95582cd which was the original\n  change extracting the GCNO files to the build task's topobjdir\n- 38c7b77eb5a7c4d544b6ab2e8f07f654a9bcceaf which fixed bug 2075352 but\n  broke what 41b974a2 intended to fix\n\nInstead, the next commit proposes another solution to fix bug 2033336\nby relying on -fprofile-abs-path to get absolute paths back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332944\n", "files": ["testing/mozharness/mozharness/mozilla/testing/codecoverage.py"], "git_node": "642cac272b3e681b50e8bb20d9006d57433f0d5a", "git_parents": ["c0ce2fcb8f04d8f5be56ba2bd7ac70b4cb7a1545"], "node": "f1826eb00bd96b8f606bb667330ff133cad967a0", "parents": ["db3c3304bb9ee9478ad6a210e0cd7ba1e2d89b8d"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2033336 - Use -fprofile-abs-path when building for code coverage. r=marco\n\nThis applies https://github.com/llvm/llvm-project/pull/230077 (which is\ncurrently pending review upstream), to add the -fprofile-abs-path\nargument to clang.\n\nCiting the GCC documentation about -fprofile-abs-path:\n\u003e Automatically convert relative source file names to absolute path\n\u003e names in the .gcno files. This allows gcov to find the correct\n\u003e sources in projects where compilations occur with different working\n\u003e directories.\n\nThis gives us back the full paths to cpp files in GCNOs of unified\nsources files, just like we had before bug 2031965.\n\nThe patch doesn't apply cleanly on Clang 19, so instead of backporting\nit, I've gated the use of the flag to Clang 22+. We don't build our\ncoverage-enabled builds with Clang 19 anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332945\n", "files": ["build/build-clang/add_support_for_-fprofile-abs-path.patch", "build/build-clang/clang-22.json", "build/build-clang/clang-23.json", "build/moz.configure/toolchain.configure"], "git_node": "6fc55f7bccd3062e3c3f4a50a924ee6ca8350562", "git_parents": ["642cac272b3e681b50e8bb20d9006d57433f0d5a"], "node": "7d9b8f7e0a159cb2ec335155bb257acc9d44b2c3", "parents": ["f1826eb00bd96b8f606bb667330ff133cad967a0"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080747 - In TransportLayerDtls search for the single best cipher rather than the full advertised range. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332837\n", "files": ["dom/media/webrtc/transport/transportlayerdtls.cpp"], "git_node": "8307129ae71cd30c8d08cc40ae166b5867a6d2c6", "git_parents": ["6fc55f7bccd3062e3c3f4a50a924ee6ca8350562"], "node": "f1fd2018bef9c4c126f2bee981998b898fcb30b7", "parents": ["7d9b8f7e0a159cb2ec335155bb257acc9d44b2c3"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2080874 - Update rust-analyzer to version 2026-10-12. r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332943\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "2683e6226e62a92b922460850b3d9f4a96491dc1", "git_parents": ["8307129ae71cd30c8d08cc40ae166b5867a6d2c6"], "node": "bcfc01cf2bbfb3c1c8377d00cf06f3ccb7bdaa50", "parents": ["f1fd2018bef9c4c126f2bee981998b898fcb30b7"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1841326 Colorspace property added and correctly managed in CanvasRenderingContext2d and ImageData r=gfx-reviewers,webidl,emilio,bradwerth\" for causing build bustages in ImageData.cpp.\n\nThis reverts commit b7ad87f9b6b5908ef2931980d2e8b4f530b94dfb.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/ImageBitmap.cpp", "dom/canvas/ImageData.cpp", "dom/canvas/ImageData.h", "dom/webidl/CanvasRenderingContext2D.webidl", "dom/webidl/ImageData.webidl", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "798ad7c3a1482f13e8709e94020e5f1407b177eb", "git_parents": ["2683e6226e62a92b922460850b3d9f4a96491dc1"], "node": "0ab3aa9306f2ab398c584383c6a402ba2eb29be9", "parents": ["bcfc01cf2bbfb3c1c8377d00cf06f3ccb7bdaa50"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1961431 - Respect reduced motion for fullscreen API transitions. r=vhilla,edgar\" for causing mochitests failures in browser_fullscreen_permissions_prompt.js.\n\nThis reverts commit 330a0159eb855932c025475be782f3e44a9a0fbb.\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "dom/base/test/fullscreen/browser.toml", "dom/base/test/fullscreen/browser_fullscreen-reduced-motion.js"], "git_node": "8da2fdfd2d066dd67f425846e5c86f38ac3721a6", "git_parents": ["798ad7c3a1482f13e8709e94020e5f1407b177eb"], "node": "fbf207e0ede60f8ed510d419a357f228ca064397", "parents": ["0ab3aa9306f2ab398c584383c6a402ba2eb29be9"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2060390 - Adding the automotive feature to the android manifest r=android-reviewers,dmeehan,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327921\n", "files": ["mobile/android/fenix/app/src/main/AndroidManifest.xml"], "git_node": "08276891dfc58add4e8da1b1fb9c7fcdcd3b2439", "git_parents": ["8da2fdfd2d066dd67f425846e5c86f38ac3721a6"], "node": "83738d90e600bc9fa59c8e3f5bd1369a026368b8", "parents": ["fbf207e0ede60f8ed510d419a357f228ca064397"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080256 - Enable type checking in UrlbarProviderGlobalActions. r=urlbar-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332468\n", "files": ["browser/components/urlbar/ActionsProviderContextualSearch.sys.mjs", "browser/components/urlbar/UrlbarProviderGlobalActions.sys.mjs", "browser/components/urlbar/tsconfig.json"], "git_node": "0ae3f292ab115e18b46ccf4cbb52a1daeb41fdd1", "git_parents": ["08276891dfc58add4e8da1b1fb9c7fcdcd3b2439"], "node": "f96709aabf62eecd11bf74f1ce6a71fc3b86bfcd", "parents": ["83738d90e600bc9fa59c8e3f5bd1369a026368b8"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080260 - Add type info to UrlbarInput::browserWindow.gBrowser. r=urlbar-reviewers,tabbrowser-reviewers,reusable-components-reviewers,jsudiaman,jules,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332469\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "toolkit/content/widgets/browser-custom-element.mjs", "tools/@types/lib.gecko.tweaks.d.ts"], "git_node": "e99098976cc3115dc35cb0ee8abdfb87997c9d54", "git_parents": ["0ae3f292ab115e18b46ccf4cbb52a1daeb41fdd1"], "node": "4a9ed6f4c8e3a5a9c9c46cd389867afa90021b04", "parents": ["f96709aabf62eecd11bf74f1ce6a71fc3b86bfcd"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080261 - Use declareLazy for conditional system module imports in urlbar modules. r=Standard8,frontend-codestyle-reviewers,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332470\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/urlbar/UrlbarTokenizer.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "tools/lint/eslint/eslint-plugin-mozilla/lib/rules/valid-lazy.mjs", "tools/lint/eslint/eslint-plugin-mozilla/tests/valid-lazy.mjs"], "git_node": "74e1f41556bc58f66b83a67422640764f57e97a4", "git_parents": ["e99098976cc3115dc35cb0ee8abdfb87997c9d54"], "node": "c62a99e71eafc2433b8e642bc3e60234314e8ec4", "parents": ["4a9ed6f4c8e3a5a9c9c46cd389867afa90021b04"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079263: Check attemptingQuit after nsIAppStartup::quit in the About dialog. r=Gijs,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331596\n", "files": ["browser/base/content/aboutDialog-appUpdater.js", "toolkit/components/startup/public/nsIAppStartup.idl", "toolkit/mozapps/update/tests/browser/browser.toml", "toolkit/mozapps/update/tests/browser/browser_aboutDialog_bc_downloaded_restart.js"], "git_node": "5837760ab7528cf9542f84898bdc844f70e268d7", "git_parents": ["74e1f41556bc58f66b83a67422640764f57e97a4"], "node": "dfc29d5dbd0501a36454bac15377b47ec50e6087", "parents": ["c62a99e71eafc2433b8e642bc3e60234314e8ec4"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079853 - don't assume docker-image-index-task is in the task graph. r=bhearsum,taskgraph-reviewers\n\nThe index-task morphs rely on docker-image-index-task always being in\nthe graph, which it usually is by virtue of docker-image being in the\ndefault `enable_always_target` param.  However reviewbot disables\nenable_always_target entirely so it was hitting KeyError whenever a push\ntriggered these morphs.  Just skip the index tasks in that case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332308\n", "files": ["taskcluster/gecko_taskgraph/morph.py", "taskcluster/gecko_taskgraph/test/test_morph.py"], "git_node": "2bac0de8ee23e3be5ad426b8eb46f3fd9b585b55", "git_parents": ["5837760ab7528cf9542f84898bdc844f70e268d7"], "node": "5d857d5ec7a53d45b530a7f3264e034aedc36a18", "parents": ["dfc29d5dbd0501a36454bac15377b47ec50e6087"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2076891 - Cover more form elements in nsTreeSanitizer r=hsivonen\n\n- Move input from MustFlatten to MustPrune (cannot have children).\n- Add output to MustFlatten (can be form elements with children).\n- Add textarea to MustPrune (can be a form element)\n- Drop \"for\" attribute (can reference a form element)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330054\n", "files": ["dom/base/nsTreeSanitizer.cpp", "dom/base/test/test_bug650776.html", "parser/xml/test/unit/results.js"], "git_node": "7757c6371856760574539dcba48266d8098493f5", "git_parents": ["2bac0de8ee23e3be5ad426b8eb46f3fd9b585b55"], "node": "df366ec1d45b0731058510277b36bdb70267b3f3", "parents": ["5d857d5ec7a53d45b530a7f3264e034aedc36a18"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081095 - Update android nightly application-services version bump to f22774fb1bed92801709e499d7718ed61d4b42e9 r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333122\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "4fa8a2da1437e088a43b4c95fc2dd444ccba8da5", "git_parents": ["7757c6371856760574539dcba48266d8098493f5"], "node": "ad9456e5eaad27f60e3b3894429f042a13c4b0c4", "parents": ["df366ec1d45b0731058510277b36bdb70267b3f3"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078167. r=Standard8,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332051\n", "files": ["toolkit/components/places/BookmarkHTMLUtils.sys.mjs", "toolkit/components/places/PlacesUtils.sys.mjs", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/browser/browser_BrowserUtils.js"], "git_node": "5e9033522fecd86e257f6271f376c321dada3aa4", "git_parents": ["4fa8a2da1437e088a43b4c95fc2dd444ccba8da5"], "node": "c9613d0c7f64aaeb93b146a8abfb88d7ace33e80", "parents": ["ad9456e5eaad27f60e3b3894429f042a13c4b0c4"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075126. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332088\n", "files": ["browser/base/content/browser-siteIdentity.js", "browser/base/content/test/browser-siteIdentity/browser.toml", "browser/base/content/test/browser-siteIdentity/browser_identityBlock_drag.js"], "git_node": "7c610ba8039f43e615773bc353275c3b9521cfb6", "git_parents": ["5e9033522fecd86e257f6271f376c321dada3aa4"], "node": "fbf41e6589871b31fbe48eecce3917cef973461b", "parents": ["c9613d0c7f64aaeb93b146a8abfb88d7ace33e80"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075334 - Style about:license on Android r=desktop-theme-reviewers,tgiles\n\nAndroid packages neither info-pages.css nor aboutLicense.css, nor the design\ntokens they rely on, so the page rendered unstyled, laid out at desktop width\nand zoomed out. It now has a viewport and its own aboutLicense.css, as\nabout:support does, which shows each license as one block rather than three\ncolumns.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332386\n", "files": [".stylelintrc.js", "toolkit/content/license.html.mako", "toolkit/themes/mobile/global/aboutLicense.css", "toolkit/themes/mobile/global/jar.mn"], "git_node": "2b45c899538d627fdf8c5aa14bfcaae55cd706d6", "git_parents": ["7c610ba8039f43e615773bc353275c3b9521cfb6"], "node": "37c0222ca836748475d2850c16b86a07f53d5f42", "parents": ["fbf41e6589871b31fbe48eecce3917cef973461b"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075144 - Publish the Fenix SBOM alongside the APKs r=releng-reviewers,taskgraph-reviewers,jcristau\n\nThe Fenix nightly, beta and release builds already generate an SBOM, but\nonly the signing tasks fed beetmover, so it stayed a Taskcluster artifact.\nIt now goes next to the universal APK and the app bundle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332388\n", "files": ["taskcluster/android_taskgraph/manifests/apk_candidates.yml", "taskcluster/kinds/beetmover-android-app/kind.yml"], "git_node": "88328894d29520d74adf24ac2c49a7a5e0a74f82", "git_parents": ["2b45c899538d627fdf8c5aa14bfcaae55cd706d6"], "node": "08fd90581bdc0d611be306741a831e028466870d", "parents": ["37c0222ca836748475d2850c16b86a07f53d5f42"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064875 - Open specific tab intent r=android-reviewers,moyin\n\nmake notification sticky when closing app\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329324\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/P