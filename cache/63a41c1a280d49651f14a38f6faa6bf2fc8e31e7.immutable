da1b089189f4e0d9122ef0c", "645222b596c0b1d8ed6d907a37a782c56e492728", "ad9a51e7878a65d976fab20f3f05356fb6df2b35", "97bd300c768dca5f478fc2159de925ead7f15e99", "28b6e61d570c314befccd0d37a315abe3a88045f", "50a59cd5cedac95e739109b4f11fd89aa58800cc", "dd95d538519a75b166d0cf05f1f389c78ea3c70f", "30c8c283cd6972d4a1cf73a4d65fbd6f9f5a8b06", "53be171dd89709456e0121507c9857bd32a54dc5", "99dfbd65f56734abb66907f7f6b6698a094a44a5", "49ccfc913051e4760236dce73f3b12975960d627", "6da3783cf5cd599356fd111bd32e20517e3eec0b", "7b0abf005a44d9d1f5e49cef94f2cfcd489ea1b1", "bcbbae7949fe155e8068932cfa71e41d62cb43f8", "31e1483545b41a3d015b2bf7119a219c268201b7", "bd470bc3e2cb634e7d5992975fab1518cd91933e", "ed4bdda4da1959bc59b9b2078baf9d7a71ec7770", "ae421ea7249f63b8b8117551e3622bc9dba202a3", "4a45747688285d335e0f370fd8771842637c2a18", "8f52290a802a4c1c30a9c2926d04f1104ccf1161", "f9d84bc49907b247247598e3c895f157b202dcd2", "9fbc9b5f2ea66e794e625c5b47fdd971cae4301b", "00c7e9d4b77deb3fc5163a5987f76c62d4afb3dc", "dd5b870af06793153c6699fbd009ab3c9c8da2c7", "e786dddd5c90e873f544b6408ee390ee5a9b405d", "7277b624f1d9b70f22275ea850bd34c59c001a40", "712cafdf4ca22a20e7a19c1f2a0ba1948684351d", "d162f3808e325e29dfbaa5c79b23451fbb2673b5", "10aa972e8753ff1b497443ea1ad5bb9e1e861c96", "df2c26d15da8532451195e86e6e20e852fe6baed", "3f373ae59cb09e60f4044f9bb37fe27247986234"], "user": "amarc@mozilla.com"}, "45526": {"changesets": [{"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2075356 - Don't rewrite let/const to assignments for console eval in frames r=devtools-reviewers,nchevobbe\n\nThe frontend AST rewrite in `mapBindings.js` converted `let x = 1` into\n`x = 1` before the expression reached the engine, and it silently mutates\nthe outer binding instead of creating a frame-local shadow.\n\nThe rewrite was gated on `features.mapExpressionBindings &&\ngetIsPaused(...)`, so it only ran in the paused-frame case, the one\ncase where it was harmful. It was never responsible for global-scope\npersistence, which SpiderMonkey's evalInGlobal handles natively.\n\nThe patch removes the rewrites entirely, along with it's pref and unit test\nthat depended on that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330110\n", "files": ["devtools/client/debugger/dist/parser-worker.js", "devtools/client/debugger/src/actions/expressions.js", "devtools/client/debugger/src/utils/prefs.js", "devtools/client/debugger/src/workers/parser/mapBindings.js", "devtools/client/debugger/src/workers/parser/mapExpression.js", "devtools/client/debugger/src/workers/parser/tests/mapBindings.spec.js", "devtools/client/debugger/src/workers/parser/tests/mapExpression.spec.js", "devtools/client/preferences/debugger.js", "devtools/client/webconsole/test/browser/_jsterm.toml", "devtools/client/webconsole/test/browser/browser_jsterm_redeclare_let_const_in_frame.js", "devtools/client/webconsole/webconsole.js"], "git_node": "d1012b82661e69be9a65cf2580afc4586737cc03", "git_parents": ["3f373ae59cb09e60f4044f9bb37fe27247986234"], "node": "28495510ab512969c65f09f32a779a8b7f3274db", "parents": ["92cf2b38bea2dae10c2fc2e035cd2ff92ba145d9"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077842 - Only send previous entry on same-origin traversals. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331226\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/test/browser/browser.toml", "docshell/test/browser/browser_bfcache_previous_entry.js", "dom/ipc/ContentChild.cpp", "testing/web-platform/tests/navigation-api/navigation-activation/activation-after-bfcache-coop-coep.https.html"], "git_node": "b14590cc776c08e55922947ae4e8bf9ab4e44f19", "git_parents": ["d1012b82661e69be9a65cf2580afc4586737cc03"], "node": "e85207da75230d77f78258bd3d58af762fe32493", "parents": ["28495510ab512969c65f09f32a779a8b7f3274db"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2079753 - Remove unused Servo-specific methods. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332029\n", "files": ["servo/components/style/properties/properties.mako.rs"], "git_node": "7f8c7d627f06f572a2781468be765ae5861145fe", "git_parents": ["b14590cc776c08e55922947ae4e8bf9ab4e44f19"], "node": "f136c20ba39f8216e97a482bc435fa1e32eba84c", "parents": ["e85207da75230d77f78258bd3d58af762fe32493"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079701 - Create a new verifyATranslatableCustomTabTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331969\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt"], "git_node": "40fb393763eebf03b0da322fabe13ddc25aefcc2", "git_parents": ["7f8c7d627f06f572a2781468be765ae5861145fe"], "node": "37544f13b596445222fa1e371118062c6890f12b", "parents": ["f136c20ba39f8216e97a482bc435fa1e32eba84c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079739 - Update Kotlin to version 2.4.21. r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332026\n", "files": ["gradle/libs.versions.toml"], "git_node": "810ce3eb40865a14103dedfc14e4bc128ea5247c", "git_parents": ["40fb393763eebf03b0da322fabe13ddc25aefcc2"], "node": "f720c4dfada1534dfcf70d967434323db6c9ef2f", "parents": ["37544f13b596445222fa1e371118062c6890f12b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079531 - Update AndroidX Collection to version 1.7.0. r=android-reviewers,gmalekpour\