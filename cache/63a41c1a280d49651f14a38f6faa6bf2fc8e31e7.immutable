e.cpp", "gfx/layers/BufferTexture.h", "gfx/layers/client/TextureClient.cpp", "gfx/layers/client/TextureClient.h", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.h"], "git_node": "efb071ae86a67a46d9546e14fd540a5885ec8d87", "git_parents": ["99813e14447c7c32e43a8714688e102557ad8edb"], "node": "a7930548df9f75ead64210c13492e616d8b394f2", "parents": ["1862f7394a8f2d47151698ec200e9662a4d019ac"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077405 - Update rlbox to avoid duplicate reads of sandbox data r=glandium\" for causing build bustages @rlbox.hpp.\n\nThis reverts commit 99813e14447c7c32e43a8714688e102557ad8edb.\n", "files": ["third_party/rlbox/include/rlbox.hpp", "third_party/rlbox/include/rlbox_conversion.hpp", "third_party/rlbox/include/rlbox_helpers.hpp", "third_party/rlbox/include/rlbox_range.hpp", "third_party/rlbox/include/rlbox_sandbox.hpp", "third_party/rlbox/include/rlbox_stdlib.hpp", "third_party/rlbox/include/rlbox_struct_support.hpp", "third_party/rlbox/moz.yaml", "third_party/rlbox/rlbox-updates.patch"], "git_node": "c57bc09f4dce27ae88eae2a387943840dd51b1a4", "git_parents": ["efb071ae86a67a46d9546e14fd540a5885ec8d87"], "node": "95dd32745e3f70cbacf1d1faede0c8454b89a2dc", "parents": ["a7930548df9f75ead64210c13492e616d8b394f2"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081762 - Enable netwerk/test/unit_ipc xpcshell tests that were disabled with isolated process. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333657\n", "files": ["netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "d9e2bca2dd0dc3413dec6f5955c9af72c922c6d9", "git_parents": ["c57bc09f4dce27ae88eae2a387943840dd51b1a4"], "node": "82a2c8d1bfb09278da089f92f1eb31b374e91216", "parents": ["95dd32745e3f70cbacf1d1faede0c8454b89a2dc"], "tags": []}, {"author": "KayanoLiam \u003cKayano04@outlook.jp\u003e", "branch": "default", "desc": "Bug 2071053 - Don't reference subsessions in Glean metrics files r=chutten,necko-reviewers,search-reviewers,jteow,kershaw\n\nRationale:\nSubsessions are a Legacy Telemetry concept and do not apply to Glean metrics\nMetric descriptions originally adapted from Legacy Telemetry scalars still referenced subsessions, creating potential confusion for data consumers and telemetry authors\n\nScope:\n- Remove Legacy Telemetry subsession language from exactly 29 Glean metric descriptions across 4 metrics files:\n  * browser/components/search/metrics.yaml (18 descriptions)\n  * browser/modules/metrics.yaml (9 descriptions)\n  * gfx/metrics.yaml (1 description)\n  * netwerk/protocol/http/metrics.yaml (1 description)\n- Fix a missing word \"of\" in browser/components/search/metrics.yaml search widget description (\"The count URI loads\" -\u003e \"The count of URI loads\")\n- Keep all metric identifiers, types, lifetimes, ping configurations, and telemetry mappings unchanged\n- No runtime code changes\n- Exclude Legacy Telemetry documentation from scope per Bug 2071053 comment 1\n\nTesting:\n- Glean and YAML linting passed with 0 errors and 0 warnings on all 4 modified metrics files\n- Whole-tree Glean lint passed via `./mach lint -l glean-parser .`\n- Python lint tests passed via `./mach python-test tools/lint/test/test_glean_parser.py tools/lint/test/test_yaml.py` (all 3 tests passed)\n- Local verification script confirmed 0 subsession occurrences across all tracked metrics YAML files and verified exactly 29 description-only diffs with all other parsed YAML data identical to base commit 64cfaf34e56f4c82eea77d032ec592c083b5b161\n- Git diff check passed with `git diff --check`\n- Full Firefox compilation and runtime browser tests were not executed for this description-only patch\n- Remote try CI has not been run\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333477\n", "files": ["browser/components/search/metrics.yaml", "browser/modules/metrics.yaml", "gfx/metrics.yaml", "netwerk/protocol/http/metrics.yaml"], "git_node": "8e10246528f981fd3d8d7384cbbde338383ac7c2", "git_parents": ["d9e2bca2dd0dc3413dec6f5955c9af72c922c6d9"], "node": "0cd0319681f69ea334d59ced0e4bc4b2871cee1a", "parents": ["82a2c8d1bfb09278da089f92f1eb31b374e91216"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080262 - Use declareLazy to for imports in remaining urlbar modules. r=urlbar-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332471\n", "files": ["browser/components/urlbar/ActionsProviderQuickActions.sys.mjs", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs", "browser/components/urlbar/QuickActionsLoaderDefault.sys.mjs", "browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderAboutPages.sys.mjs", "browser/components/urlbar/UrlbarProviderActionsSearchMode.sys.mjs", "browser/components/urlbar/UrlbarProviderAddonsShortcutMoved.sys.mjs", "browser/components/urlbar/UrlbarProviderAiChat.sys.mjs", "browser/components/urlbar/UrlbarProviderAliasEngines.sys.mjs", "browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarProviderBookmarkKeywords.sys.mjs", "browser/components/urlbar/UrlbarProviderCalculator.sys.mjs", "browser/components/urlbar/UrlbarProviderClipboard.sys.mjs", "browser/components/urlbar/UrlbarProviderGlobalActions.sys.mjs", "browser/components/urlbar/UrlbarProviderHeuristicFallback.sys.mjs", "browser/components/urlbar/UrlbarProviderHistoryUrlHeuristic.sys.mjs", "browser/components/urlbar/UrlbarProviderInputHistory.sys.mjs", "browser/components/urlbar/UrlbarProviderInterventions.sys.mjs", "browser/components/urlbar/UrlbarProviderOmnibox.sys.mjs", "browser/components/urlbar/UrlbarProviderOpenTabs.sys.mjs", "browser/components/urlbar/UrlbarProviderPrivateSearch.sys.mjs", "browser/components/urlbar/UrlbarProviderQuickSuggest.sys.mjs", "browser/components/urlbar/UrlbarProviderQuickSuggestContextualOptIn.sys.mjs", "browser/components/urlbar/UrlbarProviderRecentSearches.sys.mjs", "browser/components/urlbar/UrlbarProviderRemoteTabs.sys.mjs", "browser/components/urlbar/UrlbarProviderRestrictKeywords.sys.mjs", "browser/components/urlbar/UrlbarProviderRestrictKeywordsAutofill.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchSuggestions.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchTips.sys.mjs", "browser/components/urlbar/UrlbarProviderSemanticHistorySearch.sys.mjs", "browser/components/urlbar/UrlbarProviderTabToSearch.sys.mjs", "browser/components/urlbar/UrlbarProviderTokenAliasEngines.sys.mjs", "browser/components/urlbar/UrlbarProviderTopSites.sys.mjs", "browser/components/urlbar/UrlbarProviderUnitConversion.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/UrlbarSearchTermsPersistence.sys.mjs", "browser/components/urlbar/UrlbarTokenizer.sys.mjs", "browser/components/urlbar/content/SearchbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs"], "git_node": "222439306c9db907381b14f3b83919e6bcb7f02a", "git_parents": ["8e10246528f981fd3d8d7384cbbde338383ac7c2"], "node": "96eff08e0ce19290c72fd00c136bba257668197d", "parents": ["0cd0319681f69ea334d59ced0e4bc4b2871cee1a"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080262 - Fix type errors found by typed imports. r=urlbar-reviewers,places-reviewers,Standard8,gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332472\n", "files": ["browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/places/Interactions.sys.mjs", "browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarProviderInterventions.sys.mjs", "browser/components/urlbar/UrlbarProviderQuickSuggest.sys.mjs", "browser/components/urlbar/UrlbarProviderRemoteTabs.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchTips.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/private/SuggestFeature.sys.mjs", "browser/modules/Sanitizer.sys.mjs"], "git_node": "0ba08924d9f47280053de1342ba1bc3dc5ce2e46", "git_parents": ["222439306c9db907381b14f3b83919e6bcb7f02a"], "node": "8d32383109bd6ed9356b883517681bf5e61cdfd2", "parents": ["96eff08e0ce19290c72fd00c136bba257668197d"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080262 - Respect transform function type for prefs in declareLazy. r=Standard8,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332473\n", "files": ["browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "tools/@types/lib.gecko.custom.d.ts"], "git_node": "f7859f0b7f79fd2bf3ffc3ec7d951744abd74a24", "git_parents": ["0ba08924d9f47280053de1342ba1bc3dc5ce2e46"], "node": "edea2f6190f75e1da26322cbd861b3327eaa0966", "parents": ["8d32383109bd6ed9356b883517681bf5e61cdfd2"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080262 - Add UrlbarSapName type. r=urlbar-reviewers,search-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332474\n", "files": ["browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/tsconfig.json", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/types/urlbar.ts"], "git_node": "0b73db0c6ceaba0175b6a3c289e40c913c8b179e", "git_parents": ["f7859f0b7f79fd2bf3ffc3ec7d951744abd74a24"], "node": "459f43946d35600ff245ed04521e4f7617cd6cc4", "parents": ["edea2f6190f75e1da26322cbd861b3327eaa0966"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2080145 - Throw if the module has been registered in the js shell. r=jonco\n\nAdd a check in the registerModule() and throws if the same module has\nbeen registered before.\n\nAlso updated the existing tests calling registerModule multiple times.\n\nFor the test js/src/jit-test/tests/modules/bug1912489.js\nIt can't no longer reproduce the original problem in bug 1912489 (throws\nover-recursed exception in an async module, the over-recursion can't be\nreproduced since bug 1989107), so I've written a new one:\njs/src/jit-test/tests/modules/bug1912489-oom.js\n\nFor other jit-tests, adding clearModules() before calling the next\nregisterModules() call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333559\n", "files": ["js/src/jit-test/tests/modules/bug-2058630.js", "js/src/jit-test/tests/modules/bug-2080145.js", "js/src/jit-test/tests/modules/bug1912489-oom.js", "js/src/jit-test/tests/modules/bug1912489.js", "js/src/shell/ModuleLoader.cpp", "js/src/tests/shell/script-file-name-utf8.js"], "git_node": "8e575499319a023be2b9314f099a70dac2a284f5", "git_parents": ["0b73db0c6ceaba0175b6a3c289e40c913c8b179e"], "node": "715163a70cbde9839bb483be633c883d18d3d454", "parents": ["459f43946d35600ff245ed04521e4f7617cd6cc4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082311 - Make \u003ciframe\u003e and friends inert in \u003csvg:use\u003e. r=longsonr\n\nLower risk fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334015\n", "files": ["dom/html/nsGenericHTMLFrameElement.cpp", "testing/web-platform/tests/svg/struct/scripted/use-iframe-onload.html"], "git_node": "d3d64436e967b08f733b5e1d312d0300cdf0c677", "git_parents": ["8e575499319a023be2b9314f099a70dac2a284f5"], "node": "471ab0e2d4e5e72d2921bf6080589688602ac1a0", "parents": ["715163a70cbde9839bb483be633c883d18d3d454"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080179 - P1. Vendor application-services bf6e952d for credit card CVV storage r=joschmidt,Standard8\n\nVendor application-services bf6e952d3, which merges pull requests #7631 and\n#7648. #7631 (bug 2076154) keeps an optional CVV in the credit card store,\nencrypted like the number: UpdatableCreditCardFields.cc_cvv in, CreditCard.cc_cvv\nout, and a schema upgrade adding the column. #7648 (bug 2074008) exposes\nStore.credit_cards_bridged_engine(), which nothing uses yet;\nCreditCardsBridgedEngine is declared AsyncWrapped beside AddressesBridgedEngine.\n\nThe revision also carries the upstream changes since f22774fb: search-config-v3\nwork on the search engine selector (bugs 2063260, 2063272, 2061724 and 2050097),\nand the Glean error ping on iOS (bug 2011695), after which error-support builds\nGlean bindings with glean-build from glean v70.2.0, so its git source moves to\nthat tag.\n\nThe new search-config-v3 enums in RustSearch.sys.mjs reuse variant names of the\nexisting ones, which collides in the source docs build (bug 2082313). Until that\nis fixed, jsdoc skips RustSearch.sys.mjs and the search API page's missing\nobjects are allowed, so the page renders empty.\n\nThis also includes the file changes from `./mach uniffi generate`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332402\n", "files": [".cargo/config.toml.in", "Cargo.lock", "docs/config.yml", "docs/jsdoc.json", "docs/rust-components/api/js/autofill.md", "docs/rust-components/api/js/search.md", "third_party/application-services/components/autofill/sql/create_shared_schema.sql", "third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/db/credit_cards.rs", "third_party/application-services/components/autofill/src/db/models/credit_card.rs", "third_party/application-services/components/autofill/src/db/schema.rs", "third_party/application-services/components/autofill/src/db/store.rs", "third_party/application-services/components/autofill/src/lib.rs", "third_party/application-services/components/autofill/src/sync/bridge.rs", "third_party/application-services/components/autofill/src/sync/credit_card/incoming.rs", "third_party/application-services/components/autofill/src/sync/credit_card/mod.rs", "third_party/application-services/components/autofill/src/sync/mod.rs", "third_party/application-services/components/places/Cargo.toml", "third_party/application-services/components/search/src/configuration_types.rs", "third_party/application-services/components/search/src/environment_matching.rs", "third_party/application-services/components/search/src/error.rs", "third_party/application-services/components/search/src/filter.rs", "third_party/application-services/components/search/src/selector.rs", "third_party/application-services/components/search/src/sort_helpers.rs", "third_party/application-services/components/search/src/test_helpers.rs", "third_party/application-services/components/search/src/types.rs", "third_party/application-services/components/support/error/Cargo.toml", "third_party/application-services/components/support/error/build.rs", "third_party/application-services/components/support/error/src/error_tracing.rs", "third_party/application-services/components/support/error/src/lib.rs", "third_party/application-services/examples/autofill-utils/src/autofill-utils.rs", "third_party/application-services/megazords/ios-rust/Cargo.toml", "third_party/application-services/moz.yaml", "third_party/application-services/testing/sync-test/src/autofill.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/search/android/src/main/java/mozilla/appservices/search/search.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "897e3c368783153b7e9564255f50678fe4e4d235", "git_parents": ["d3d64436e967b08f733b5e1d312d0300cdf0c677"], "node": "26b784784db5ff33a540754e04f7e5ff623d77c4", "parents": ["471ab0e2d4e5e72d2921bf6080589688602ac1a0"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080179 - P2. Store the credit card security code in the Rust store on Desktop r=credential-management-reviewers,NeilDeakin,joschmidt\n\nThe Rust credit card adapter gets its own valid fields, the ones its store has\na column for, so it adds cc-csc, mapped to the encrypted ccCvv, and drops\nbillingAddressGUID. cc-csc then counts in matching like any other field: a\nsaved card submitted with a new code is not a match, so the update doorhanger\noffers to save the code.\n\nStorage keeps the security code whatever the CVV prefs, and hides it from its\nconsumers while CVV is disabled. CreditCardRecord.normalizeFields drops cc-csc\nthen, so neither store writes one through add() or update(), and both strip it\nfrom every non-raw read through CreditCardRecord.stripSecurityCodeWhenDisabled.\nSync and the migration go through neither path and carry the code as stored.\nThe JSON store's getDuplicateRecords now yields cleaned copies, so that read is\nstripped too rather than handing out the store's own records. normalizeFields\nalso trims the code and drops one that is not 3 or 4 digits.\n\nThe Rust adapter's getSavedFieldNames reads raw, so a hidden code still counts\nas a saved field: the saved field names are recomputed only when the store\nchanges, so turning CVV on would otherwise offer no code until the next change.\nWhether the code is offered is decided where it would be filled.\n\nupdate() in the Rust adapter keeps the stored code when the record it is given\nomits cc-csc, and only an empty value clears it, which is what the JSON store\ndoes with cc-csc as an unknown field. The edit dialog has no security code\nfield while CVV is disabled, so saving a card from it keeps the code. update()\nmerges against a raw read so the hidden code is not lost; for addresses that\nalso keeps a country without metadata, as the JSON store does.\n\nThe migration carries the code into the Rust store but not back: the JSON\nstore would keep it in the clear. The copy back leaves cc-csc out, and the\nmigration no longer compares it. The CVV browser tests no longer skip under the\nRust store.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332403\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/RustAutofillAdapterBase.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs", "toolkit/components/formautofill/shared/CreditCardRecord.sys.mjs"], "git_node": "9d7f864149c4fd1ff2df557f52aba80a044c5c44", "git_parents": ["897e3c368783153b7e9564255f50678fe4e4d235"], "node": "c070a3db4e31e7d40df0ed020cf12f405aa68785", "parents": ["26b784784db5ff33a540754e04f7e5ff623d77c4"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080179 - P3. Only support credit card security codes while the Rust store is serving r=joschmidt,credential-management-reviewers\n\nisAutofillCreditCardCVVSupported now also requires the Rust credit card store\nto be active: the JSON store would keep the code in the clear. While it serves,\nno CVV option is offered and no new code is stored, and a code it already holds\nstays hidden. A profile with a primary password is never migrated, so it does\nnot get the feature.\n\nThe CVV browser tests switch to the Rust store through the new\nswitchCreditCardStore helper, and new tasks check the JSON store offers none of\nit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333604\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvvPreference.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/unit/test_creditCardCVVPrefs.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/FormAutofill.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs"], "git_node": "34ad370e2923d269ecc680b3faea932a16f2560d", "git_parents": ["9d7f864149c4fd1ff2df557f52aba80a044c5c44"], "node": "e2444b402005e796f8152cdf9afca9332a8fe0d7", "parents": ["c070a3db4e31e7d40df0ed020cf12f405aa68785"], "tags": []}, {"author": "Anna \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 1982833 - Missing crv check for OKP JWK keys r=JavierFernandez\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260973\n", "files": ["dom/crypto/CryptoKey.cpp", "dom/crypto/CryptoKey.h", "dom/crypto/WebCryptoTask.cpp", "testing/web-platform/meta/WebCryptoAPI/import_export/okp_importKey_failures_Ed25519.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/import_export/okp_importKey_failures_X25519.https.any.js.ini"], "git_node": "d8c6617dbc51c8793240662342dc055616d602c7", "git_parents": ["34ad370e2923d269ecc680b3faea932a16f2560d"], "node": "d221fc198db8da8eb0592fba84937ccf92e7ec20", "parents": ["e2444b402005e796f8152cdf9afca9332a8fe0d7"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081143 - Remove duplicate code dealing with the `LastInteractionDuration` crash annotation r=afranchuk,crashreporting-reviewers,schopin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333177\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "a2527da319b5c78a47df618db767873f6ba9d2d8", "git_parents": ["d8c6617dbc51c8793240662342dc055616d602c7"], "node": "5ee10d8d93c65a73bf671182d7519bb31891c7b1", "parents": ["d221fc198db8da8eb0592fba84937ccf92e7ec20"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081658 - Implement correct inheritance algorithm for permissionsPolicy. r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333619\n", "files": ["dom/security/permissionspolicy/PermissionsPolicy.cpp", "dom/security/permissionspolicy/PermissionsPolicy.h", "testing/web-platform/meta/permissions-policy/permissions-policy-frame-policy-allowed-for-all.https.sub.html.ini", "testing/