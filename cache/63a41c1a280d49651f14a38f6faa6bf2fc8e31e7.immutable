a.com/D331876\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_focus.js", "browser/themes/shared/smartbar.css"], "git_node": "c0ad8e7c1d3d33cf3405f7019994471ac8baf4e7", "git_parents": ["b260812d7db599b393d1191f1bcf0613cb748226"], "node": "8d78767e95b031cdcbea18f023b2d0e93df4b9a8", "parents": ["0138431bdc3a791f80d9bef29ac1112f3ba923ff"], "tags": []}], "date": 1792316590, "git_changesets": ["c7a285ba3d2755537be37ef2b273a3f7825e5c67", "e70bde08449454a4a34805b7172e380233bbd881", "586ae990b6b1ec6a61d710c431608dfa87762c67", "a9666788caf37a53811eb0ae8614116e10dc721d", "82e458a378eebb4705aa51bce50dbaaba95fab5f", "10292ba900dba8eef895eb7e685162f556c38ed5", "9b13cdaee9546db1d06a2f8041a4e40feeac904c", "ad7db3d6e34978434ed51b89f02a5a2566a1dafd", "a5590c1a8002b2c344e4a9895201d8d489d686c6", "c902e251797dbe57645242631242688874e5cc0d", "b193e850fbf39925b5dfa8c0f8a741371458ee12", "4d07cd443a65460e948f40d77da677f271790bf5", "cc0de95409257f6db37575055894a08c2b9a3389", "7a72918c725a39e6a3dbcc6089fa7a61b03e77f6", "d901f199401a15b3e64131d8692136ceaa4aa628", "5dbf01e0bb333a59d1963b12c5124e10be1bd3f1", "9193490cf278d03006a34014860bf8de59bc11b7", "9a0745d08a3046dad50122340981a8b76837d6b8", "ef3b794f616b1b2a30ce82a4b2169da4f19f9db7", "3b8263b05345279f6c675ca86515d0ad2c5f8dc5", "272d78d41aba5e6d6151e073f393c80633e63234", "39449bc0ed85cb6e240a05689aa632c600943b55", "b260812d7db599b393d1191f1bcf0613cb748226", "c0ad8e7c1d3d33cf3405f7019994471ac8baf4e7"], "user": "pstanciu@mozilla.com"}, "45584": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2083379 - Negative radialGradient r and fr are errors r=emilio\n\nA negative value for r or fr is an error per https://www.w3.org/TR/SVG2/pservers.html#RadialGradientAttributes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334931\n", "files": ["dom/svg/SVGElement.h", "layout/svg/SVGGradientFrame.cpp", "testing/web-platform/tests/svg/pservers/reftests/radialgradient-basic-003-ref.svg", "testing/web-platform/tests/svg/pservers/reftests/radialgradient-basic-003.svg"], "git_node": "d56e5af2441d785bdff00ca3ae10b85e082cc2e3", "git_parents": ["c0ad8e7c1d3d33cf3405f7019994471ac8baf4e7"], "node": "1aa1f4e0e381174ad68393d47188395b4a21b92a", "parents": ["8d78767e95b031cdcbea18f023b2d0e93df4b9a8"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083317 - Add logging for compositor and layer tree lifetimes. r=gfx-reviewers,lsalzman\n\nThese are hard to follow across the parent, GPU and content processes when\ndebugging rendering failures after tab moves, device resets or GPU process\ncrashes.\n\nThe new GPUProcess module logs GPU process launches, losses, device resets\nand fallbacks. The new LayerTree module logs when compositors, compositor\nmanagers and content compositor bridges are created and destroyed, and when\nlayer trees are allocated, mapped, attached to or moved between compositors,\nreconnected and erased, with their layers IDs, content IDs and pids.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334834\n", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/IdType.h", "dom/media/ipc/RemoteMediaManagerParent.cpp", "gfx/ipc/CanvasManagerParent.cpp", "gfx/ipc/GPUParent.cpp", "gfx/ipc/GPUProcessLog.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/moz.build", "gfx/layers/LayersTypes.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/CompositorManagerParent.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/layers/ipc/LayerTreeLog.h", "gfx/layers/ipc/LayerTreeOwnerTracker.cpp", "gfx/layers/ipc/UiCompositorControllerParent.cpp", "gfx/layers/moz.build", "gfx/vr/ipc/VRManagerParent.cpp", "layout/ipc/RemoteLayerTreeOwner.cpp"], "git_node": "5d313b2a88a16939f521ad9a8491d28835a63767", "git_parents": ["d56e5af2441d785bdff00ca3ae10b85e082cc2e3"], "node": "5bc78b46c8601a8a76ec8cc2cf1fe3c3cdc819c1", "parents": ["1aa1f4e0e381174ad68393d47188395b4a21b92a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083011 - Tests. r=lsalzman\n\nThis add a test for the problematic case here\n(translucent-content-offset-print), and another for masks/opacity with\noffsets which I found while looking into this.\n\nThe fuzz is tentative, there are multiple ways of fixing this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334867\n", "files": ["testing/web-platform/meta/css/printing/mask-and-opacity-offset-print.html.ini", "testing/web-platform/meta/css/printing/translucent-content-offset-print.html.ini", "testing/web-platform/tests/css/printing/mask-and-opacity-offset-print-ref.html", "testing/web-platform/tests/css/printing/mask-and-opacity-offset-print.html", "testing/web-platform/tests/css/printing/translucent-content-offset-print-ref.html", "testing/web-platform/tests/css/printing/translucent-content-offset-print.html"], "git_node": "412a5287a1372cae50a3084ab49b2e6e9c408196", "git_parents": ["5d313b2a88a16939f521ad9a8491d28835a63767"], "node": "0067d234f64c5e8c2888ebff5a7f67de500791fb", "parents": ["5bc78b46c8601a8a76ec8cc2cf1fe3c3cdc819c1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083011 - Fix fallback drawing in SkGDI. r=lsalzman\n\nSo the issue is that when replying the page for fallback rasterization,\nthe translation here just vanishes if the recording is complex enough:\n\n  https://searchfox.org/firefox-main/rev/e77c5131fd07ddab0731efab207539f5ae3a00ce/gfx/skia/gdi/SkGDIDocument.cpp#176,194-195\n\nBecause SetTransform() just clobbers it... I thought of different ways\nto deal with it and this is the most-likely to hit the happy/correct\npath. Just prevent messing with scales and give Gecko and offset that\nwe apply via DrawTargetOffset.\n\nThe alternative to prevent this would be  using something\nInlineTranslator's base transform should work, but there are a bunch\nof things that that doesn't handle, like the mask / opacity test from\nthe test commit.\n\n * DrawSurfaceWithShadow calls `resetMatrix()`. Though that seems to be\n   DrawTargetWebGL only so not problematic here.\n\n * PushLayer, PushLayerWithBlend and CreateClippedDrawTarget seem to use\n   device bounds directly.\n\nI did notice that drawWindow doesn't deal with that properly either, see\nincoming commit, which is rather hackish, better approaches welcome.\n\nI'd prefer taking this, then potentially fix up the translator stuff,\nwhich would make the offset and the canvasMayBeScaled=false go away.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334870\n", "files": ["gfx/skia/gdi/SkGDIDocument.cpp", "gfx/skia/gdi/SkGDIDocument.h", "gfx/thebes/PrintTargetWindows.cpp", "testing/web-platform/meta/css/printing/text-shadow-blur-print.html.ini"], "git_node": "c22f05c912c44f56c75a5a7a38ff3c1290739d63", "git_parents": ["412a5287a1372cae50a3084ab49b2e6e9c408196"], "node": "db761b1c3b8000aa407875f91ad1a8787ecc8be8", "parents": ["0067d234f64c5e8c2888ebff5a7f67de500791fb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081705 - Forget DrawTargets after each page. r=lsalzman,gfx-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334913\n", "files": ["gfx/2d/InlineTranslator.h", "gfx/thebes/PrintTargetWindows.cpp"], "git_node": "2623442ed1e34722ae23ca1a2fb5f4714cd36a37", "git_parents": ["c22f05c912c44f56c75a5a7a38ff3c1290739d63"], "node": "c99af373a61ec14d938d38eed9ddc9dddb31fc5b", "parents": ["db761b1c3b8000aa407875f91ad1a8787ecc8be8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083469 - Fix translator ReferenceDrawTargetTransform handling for PushLayerWithBlend and CreateClippedDrawTarget. r=lsalzman\n\nSince we can replay it with a different transform applied, we can't\nquite just record device space bounds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334891\n", "files": ["gfx/2d/2D.h", "gfx/2d/DrawTarget.cpp", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetRecording.h", "gfx/2d/RecordedEventImpl.h", "testing/web-platform/tests/css/css-masking/mask-image/mask-image-cross-site-iframe-offset-ref.html", "testing/web-platform/tests/css/css-masking/mask-image/mask-image-cross-site-iframe-offset.sub.html", "testing/web-platform/tests/css/css-masking/mask-image/support/mask-image-cross-site-iframe-offset-frame.html"], "git_node": "1531436f01d206ad752a7cba68ce3d10b4771bd8", "git_parents": ["2623442ed1e34722ae23ca1a2fb5f4714cd36a37"], "node": "c9e2f581291ea3d033f17d14b7d06a1b62e0eafc", "parents": ["c99af373a61ec14d938d38eed9ddc9dddb31fc5b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083469 - Remove redundant virtual specifiers in DrawTargetRecording.h. r=gfx-reviewers,lsalzman\n\nDrive-by while I was looking at this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334892\n", "files": ["gfx/2d/DrawTargetRecording.h"], "git_node": "4ee5bd298855737d10a815c14038fa46517e3252", "git_parents": ["1531436f01d206ad752a7cba68ce3d10b4771bd8"], "node": "ff2cea1aeddc5ea21d7eed0c06a6a5a86a94fff6", "parents": ["c9e2f581291ea3d033f17d14b7d06a1b62e0eafc"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083469 - Use SetReferenceDrawTargetTransform for SkGDI fallback. r=lsalzman\n\nInstead of manually passing an offset and downscaling.\n\nWe can do it now that handling of that transform is fixed\nin the recording.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334893\n", "files": ["gfx/2d/HelpersSkia.h", "gfx/skia/gdi/SkGDIDocument.cpp", "gfx/skia/gdi/SkGDIDocument.h", "gfx/thebes/PrintTargetWindows.cpp"], "git_node": "f911b573c6043d0510193daffe86a4c3fdfc38f3", "git_parents": ["4ee5bd298855737d10a815c14038fa46517e3252"], "node": "52a64b4331183c323b2789300388aea0987f06f6", "parents": ["ff2cea1aeddc5ea21d7eed0c06a6a5a86a94fff6"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2083469: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/2d/RecordedEventImpl.h"], "git_node": "bb80ca3b402c65110cbdc62d13439f56bedb3c43", "git_parents": ["f911b573c6043d0510193daffe86a4c3fdfc38f3"], "node": "8b1345f2145acce4a28d20a091049a7d812c8eb4", "parents": ["52a64b4331183c323b2789300388aea0987f06f6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082991 - Support native strokes in SkGDI. r=lsalzman\n\nLoosely based on _cairo_win32_printing_surface_stroke. This makes sure\nthat these lines remain on the output. Without this change, they go as\na clipped fill, and rounding makes them fade / disappear.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334904\n", "files": ["gfx/skia/gdi/SkGDIDocument.cpp"], "git_node": "81f6afcdacb6d52351ec061e92fad1c3e88d4d0c", "git_parents": ["bb80ca3b402c65110cbdc62d13439f56bedb3c43"], "node": "b7fa022f68083d6900452dcf063f140542bdacae", "parents": ["8b1345f2145acce4a28d20a091049a7d812c8eb4"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Add proof test for cropped VideoFrame geometry r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318619\n", "files": ["dom/media/webcodecs/test/mochitest.toml", "dom/media/webcodecs/test/test_videoFrame_croppedVideo.html", "dom/media/webcodecs/test/vp8-pixel-crop.webm"], "git_node": "62c78f9a4fa2a24f0cc8f796c193812a6070f3de", "git_parents": ["81f6afcdacb6d52351ec061e92fad1c3e88d4d0c"], "node": "8f00199b05b65c2411d7104fe72ef2b3de834eaf", "parents": ["b7fa022f68083d6900452dcf063f140542bdacae"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Add a fallible Image addressable-domain query r=gfx-reviewers,padenot,bradwerth\n\nAdd Image::GetAddressableSize(), which returns the size of the pixel buffer\nan image addresses, or Nothing() if the image is invalid or its picture rect\ndoes not lie inside that buffer. Planar and NV images answer from their data\nbecause their GetSize() is only the picture size. Share the picture-rect\noverflow check with PlanarYCbCrData::GetPlaneSizes().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318620\n", "files": ["dom/media/gtest/TestYUVBufferGenerator.cpp", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h", "gfx/tests/gtest/TestImageAddressableSize.cpp", "gfx/tests/gtest/moz.build"], "git_node": "35076368bddcc646c550db7d781854ce9f7871d4", "git_parents": ["62c78f9a4fa2a24f0cc8f796c193812a6070f3de"], "node": "158d1b34a4536ef3cc4bb2d984035eb1e2821e7d", "parents": ["8f00199b05b65c2411d7104fe72ef2b3de834eaf"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Preserve native coded geometry in VideoFrame r=media-playback-reviewers,padenot\n\nValidate a layers::Image once, in VideoFrame::ValidateImage, and keep the\nresult as the frame's Resource: the image, its format, the size of its pixel\nbuffer as the coded size, and its picture rect. Every VideoFrame is built from\na Resource, either freshly validated or copied from another frame, so a coded\nsize is no longer derived from GetSize(), which for planar images is only the\npicture size. Route decoder output and ImageTrack frames through\nCreateFromImage so they are validated as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318622\n", "files": ["dom/media/webcodecs/ImageTrack.cpp", "dom/media/webcodecs/VideoDecoder.cpp", "dom/media/webcodecs/VideoFrame.cpp", "dom/media/webcodecs/VideoFrame.h", "dom/media/webcodecs/gtest/TestVideoFrame.cpp", "dom/media/webcodecs/gtest/moz.build"], "git_node": "2f0d93fcd777f360faaa4cdffbe481a78ed782da", "git_parents": ["35076368bddcc646c550db7d781854ce9f7871d4"], "node": "7253ebad531f0795573b5e97e3afec13600a4e00", "parents": ["158d1b34a4536ef3cc4bb2d984035eb1e2821e7d"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061460 - Deduplicate internal VideoFrame format conversion r=media-playback-reviewers,padenot\n\nCentralize conversion from VideoPixelFormat to the internal VideoFrame::Format\nwrapper across the construction paths that take a VideoPixelFormat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323462\n", "files": ["dom/media/webcodecs/VideoFrame.cpp"], "git_node": "f389be85d633642a107fc0a8bd66347634be96e1", "git_parents": ["2f0d93fcd777f360faaa4cdffbe481a78ed782da"], "node": "ecad65f799cf2c8529a23fe873bafb7608dc0448", "parents": ["7253ebad531f0795573b5e97e3afec13600a4e00"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061460 - Deduplicate internal VideoFrame format conversion r=media-playback-reviewers,padenot\" for causing mda failures @ test_videoFrame_croppedVideo\n\nThis reverts commit f389be85d633642a107fc0a8bd66347634be96e1.\n\nRevert \"Bug 2061460 - Preserve native coded geometry in VideoFrame r=media-playback-reviewers,padenot\"\n\nThis reverts commit 2f0d93fcd777f360faaa4cdffbe481a78ed782da.\n\nRevert \"Bug 2061460 - Add a fallible Image addressable-domain query r=gfx-reviewers,padenot,bradwerth\"\n\nThis reverts commit 35076368bddcc646c550db7d781854ce9f7871d4.\n\nRevert \"Bug 2061460 - A