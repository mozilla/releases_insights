/pageextractor/PageExtractorChild.sys.mjs", "toolkit/components/pageextractor/PageExtractorParent.sys.mjs", "toolkit/components/pageextractor/metrics.yaml", "toolkit/components/pageextractor/tests/browser/browser_page_extractor_markers.js"], "git_node": "2018aa1fd377a1c39c8a20f36e523412cb424b0b", "git_parents": ["7f328610430f70a731e9aa13e38936b617d1797f"], "node": "0b906ade985721e3b319f847fc57fcedaa03db5a", "parents": ["0c46a99e610994a1cb66a5e6898b4c8543034674"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2079252 r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331610\n", "files": ["layout/svg/SVGTextFrame.cpp", "layout/svg/crashtests/2079252.html", "layout/svg/crashtests/crashtests.list"], "git_node": "7f7851f753201ba458cdd5a1750b9e5290cc036a", "git_parents": ["2018aa1fd377a1c39c8a20f36e523412cb424b0b"], "node": "a45d7bb91e80a5c4fc9186814945b485e50d5de3", "parents": ["0b906ade985721e3b319f847fc57fcedaa03db5a"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2078930 - Address wasm baseline globals off the pinned instance register. r=yury\n\nOn platforms that pin the instance register, addressOfGlobalVar copied\nInstanceReg into a scratch register before forming the address of a\nglobal, so every global.get and global.set began with a register move\n(mov x15, x23 on arm64). Use InstanceReg as the base directly, and for an\nindirect global load the cell pointer straight from it.\n\nOn one JetStream 3 run on arm64 this removes all 174,559 of those moves\nfrom baseline wasm code (about 680 KB). The other pinned platforms (x64,\nmips64, loong64 and riscv64) lose the same move.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331395\n", "files": ["js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "4152ce11061623d68035a417b42afcbd04723390", "git_parents": ["7f7851f753201ba458cdd5a1750b9e5290cc036a"], "node": "37bd6de35808fa9a5a333c515eabb3a8aeabd50c", "parents": ["a45d7bb91e80a5c4fc9186814945b485e50d5de3"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2079580 remove release_or_beta expectations from MediaRecorder tests r=azebrowski\n\nThe release_or_beta annotation derives from\nhttps://phabricator.services.mozilla.com/D98963,\nwhich was a follow-up to https://phabricator.services.mozilla.com/D98523,\nwhich was reverted in https://phabricator.services.mozilla.com/D307115\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331905\n", "files": ["testing/web-platform/meta/mediacapture-record/MediaRecorder-peerconnection-no-sink.https.html.ini", "testing/web-platform/meta/mediacapture-record/MediaRecorder-peerconnection.https.html.ini"], "git_node": "b51fa0b59ffae6f90a55f7d3467c87f15a0ba9b4", "git_parents": ["4152ce11061623d68035a417b42afcbd04723390"], "node": "ae72f5db284280e245f9285e3aca3c33f962b380", "parents": ["37bd6de35808fa9a5a333c515eabb3a8aeabd50c"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074514 - Create new list component for managing site permissions in website settings subpane - r=ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,mstriemer,flod,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328232\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.css", "browser/components/ipprotection/content/vpn-site-rules-list.mjs", "browser/components/ipprotection/jar.mn", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "666fdefcaa0cf5ca56ebcc9f33c8c3d26cde2d7d", "git_parents": ["b51fa0b59ffae6f90a55f7d3467c87f15a0ba9b4"], "node": "d5482820175f927790d1b657ab3fd48780998bcb", "parents": ["ae72f5db284280e245f9285e3aca3c33f962b380"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074574 - Add dialog for creating a site inclusion or exclusion rule in VPN settings - r=ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,mstriemer,bolsson,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329030\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/components/preferences/dialogs/jar.mn", "browser/components/preferences/dialogs/vpnSiteRule.css", "browser/components/preferences/dialogs/vpnSiteRule.js", "browser/components/preferences/dialogs/vpnSiteRule.xhtml", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl", "browser/themes/shared/preferences/preferences.css"], "git_node": "5aaebbd742b23887d38a997d1645a849c964cd59", "git_parents": ["666fdefcaa0cf5ca56ebcc9f33c8c3d26cde2d7d"], "node": "0ab76b866b8104debe043c511b48f718a5eed976", "parents": ["d5482820175f927790d1b657ab3fd48780998bcb"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075355 - Add a dialog for editing a site inclusion or exclusion - r=kpatenio,ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,reusable-components-reviewers,mstriemer,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329985\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/components/preferences/dialogs/vpnSiteRule.js", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "4ebc6be645df8bba788503f95ee23139d05e4b60", "git_parents": ["5aaebbd742b23887d38a997d1645a849c964cd59"], "node": "35d64197e0c06ddd3df6670d5497710f18d32d96", "parents": ["0ab76b866b8104debe043c511b48f718a5eed976"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074578 - Create delete confirmation dialogs for VPN site rules settings - r=kpatenio,mstriemer,ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331293\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.css", "browser/components/ipprotection/content/vpn-site-rules-list.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "37865ff75105879f6dc4e8ba0495f45a66e19dbd", "git_parents": ["4ebc6be645df8bba788503f95ee23139d05e4b60"], "node": "a9def5ca3a71f675fb5915bc6c7196b4b39788ff", "parents": ["35d64197e0c06ddd3df6670d5497710f18d32d96"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2055219 use software decoders for rRTCRtpSender-replaceTrack on Android r=dbaker,pehrsons\n\nHardware decoders produce SurfaceTextureImage frames; once the compositor GL\ncontext attaches to the SurfaceTexture, GetAsSourceSurface() from another\ncontext would fail silently, causing canvas drawImage() to produce black\npixels and the signal detector to never fire.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331906\n", "files": ["testing/web-platform/meta/webrtc/RTCRtpSender-replaceTrack.https.html.ini"], "git_node": "1dbc5dfecfc91b3bf69a627d1cef078b4b234c9d", "git_parents": ["37865ff75105879f6dc4e8ba0495f45a66e19dbd"], "node": "9df75dd1419ac19742330d52c9825e1724d67925", "parents": ["a9def5ca3a71f675fb5915bc6c7196b4b39788ff"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074620 - Horoscope: Update the widget menu button string. r=fluent-reviewers,bolsson\n\nThe Horoscopes menu button string only set an aria-label, the older shape. This replaces it with newtab-horoscopes-widget-open-menu-button, which sets both the title and the aria-label like every other widget menu button. Nothing on main uses the old ID yet, so it goes too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332127\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "5a5d1c6ea19605a228520856086184beec500bd4", "git_parents": ["1dbc5dfecfc91b3bf69a627d1cef078b4b234c9d"], "node": "cd7b22b1634464f23b902914491ff16311c08ed6", "parents": ["9df75dd1419ac19742330d52c9825e1724d67925"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005696: Use TmpD instead of $TMPDIR in browser_content_sandbox_fs.js, and re-enable the test on macOS 15 aarch64. r=haik,sandbox-reviewers\n\nThe $TMPDIR subtest was added in bug 1361304 (2017) to check that the per-user temp dir under /private/var is not readable from a web content process. It passes on the macOS 10.15 workers, which set $TMPDIR, but the newer macOS 15 aarch64 workers don't appear to set it, so testFileAccessMacOnly throws NS_ERROR_FILE_UNRECOGNIZED_PATH there.\n\nTmpD comes from NSTemporaryDirectory(), which returns that same per-user temp dir and should not depend on the environment. Either way this seems like the safer approach, since $TMPDIR can point anywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331889\n", "files": ["security/sandbox/test/browser.toml", "security/sandbox/test/browser_content_sandbox_fs_tests.js", "security/sandbox/test/browser_content_sandbox_utils.js"], "git_node": "e12f258f58340dc4943e6f13a355a9b7476e1474", "git_parents": ["5a5d1c6ea19605a228520856086184beec500bd4"], "node": "9ce9bd733ef17139b4e2128f84d101856dd8ef89", "parents": ["cd7b22b1634464f23b902914491ff16311c08ed6"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079436 - Update PDF.js to 89b500f5e1d98ed89bb90211e45b28730b2d99ac r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331739\n", "files": ["toolkit/components/pdfjs/PdfJsDefaultPrefs.js", "toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "1e79c1d26aa6ce81e228a8d4181506c2a964d464", "git_parents": ["e12f258f58340dc4943e6f13a355a9b7476e1474"], "node": "0637041ed8b6c89937f3607ca76101562758a37c", "parents": ["9ce9bd733ef17139b4e2128f84d101856dd8ef89"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077725: Mark immutable TypedArrays for proxy validation r=spidermonkey-reviewers,jonco\n\nWe are required to throw an exception if a Proxy's `get` trap returns a value that doesn't match the underlying object for a non-writable, non-configurable property. Our proxy fast path depends on the NeedsProxyGetSetResultValidation flag being set on any object that has non-writable, non-configurable properties. Normally this is handled automatically in GetObjectFlagsForNewProperty, but immutable typed array elements don't take that path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330846\n", "files": ["js/src/jit-test/tests/proxy/bug2077725.js", "js/src/vm/TypedArrayObject.cpp"], "git_node": "012a9a8f943f8c28f4227a6eff30b5a4a238fc07", "git_parents": ["1e79c1d26aa6ce81e228a8d4181506c2a964d464"], "node": "61fc5c0b30cab5d9fa89645e5e7779552c387425", "parents": ["0637041ed8b6c89937f3607ca76101562758a37c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077725: Add assertion in ScriptedProxyHandler::checkGetTrapResult r=jandem\n\nNote that when we're deciding *whether* we have to do this check we also check for a resolve hook, but here we're already looking at a concrete property that should have set the flag when it was added, so having a resolve hook isn't an excuse (and therefore doesn't need to be part of the assertion).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331455\n", "files": ["js/src/proxy/ScriptedProxyHandler.cpp"], "git_node": "24a929ebb3055e4c5c8c368eb7b6d10f5115f0c4", "git_parents": ["012a9a8f943f8c28f4227a6eff30b5a4a238fc07"], "node": "610b22ef6cc3e0d217e958ccc1e4bbda5a2e5ed6", "parents": ["61fc5c0b30cab5d9fa89645e5e7779552c387425"], "tags": []}, {"author": "virsworld \u003cvirpatel71@gmail.com\u003e", "branch": "default", "desc": "Bug 2073572 - Make DisplayMenuBar pass a string to runOncePerModification. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329061\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_runOnce_helper.js", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs"], "git_node": "1ee09ed66ba5bf5e12cd8c5669dceac7d90dc35f", "git_parents": ["24a929ebb3055e4c5c8c368eb7b6d10f5115f0c4"], "node": "1fa85bcd504acb8e05f0f984db8f92c631ed1db1", "parents": ["610b22ef6cc3e0d217e958ccc1e4bbda5a2e5ed6"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079040: Don't redefine the input in StringToAtom r=spidermonkey-reviewers,jandem\n\nOverwriting the input in an Ion IC can lead to barrier confusion, if a nursery string becomes a tenured atom.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331890\n", "files": ["js/src/jit-test/tests/cacheir/bug2079040.js", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/CacheIRWriter.h", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "f8ee10bfd0ad22ca964bb897b466c83ffbaab20e", "git_parents": ["1ee09ed66ba5bf5e12cd8c5669dceac7d90dc35f"], "node": "7b6f8d7c8201bec9b8357a912ae0c63fb14c163d", "parents": ["1fa85bcd504acb8e05f0f984db8f92c631ed1db1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079865 - Dispatch MozScrolledAreaChanged only to chrome. r=layout-reviewers,dshin\n\nWe have basically no tests for this event, and it is only used by chrome\ncode, so let's not dispatch it to content.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332147\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "modules/libpref/init/StaticPrefList.yaml", "widget/tests/test_assign_event_data.html"], "git_node": "af83e455b48b5ab6819d455fcf0b25fb36986a58", "git_parents": ["f8ee10bfd0ad22ca964bb897b466c83ffbaab20e"], "node": "110546e8d3e8bca0eb7703725d045d7c0f2f1870", "parents": ["7b6f8d7c8201bec9b8357a912ae0c63fb14c163d"], "tags": []}, {"author": "Emily Wachowiak \u003cewachowiak@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076100 - Update \"List all tabs\" button label and tooltip to \"Search and manage tabs\". r=fluent-reviewers,omc-reviewers,bolsson,emcminn\n\nRename tabs-toolbar-list-all-tabs to tabs-toolbar-list-all-tabs-2 in\nbrowser.ftl and update both .label and .tooltiptext to \"Search and manage tabs\".\nUpdate the data-l10n-id reference in navigator-toolbox.inc.xhtml.\nUpdate code comments in onboarding.ftl that referenced the old string ID.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331248\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/browser/newtab/onboarding.ftl"], "git_node": "0db8043fc8ff0a0254630e6c215d741e3651f2a1", "git_parents": ["af83e455b48b5ab6819d455fcf0b25fb36986a58"], "node": "6296fc482a445ebf0cc91740ecc7d5316b089911", "parents": ["110546e8d3e8bca0eb7703725d045d7c0f2f1870"], "tags": []}, {"author": "Emily Wachowiak \u003cewachowiak@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076100 - Update tab groups onboarding strings to reference \"Search and Manage Tabs\" menu. r=fluent-reviewers,omc-reviewers,emcminn,bolsson\n\nRename three onboarding string IDs and update their text to reflect the\nbutton rename from \"List all tabs\" to \"Search and manage tabs\":\n- tab-groups-onboarding-create-group-title-3 -\u003e -4\n- tab-groups-onboarding-saved-groups-title-3 -\u003e -4\n- tab-groups-onboarding-session-restore-title-2 -\u003e -3\n\nUpdate corresponding string_id references in FeatureCalloutMessages.sys.mjs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331250\n", "files": ["browser/components/asrouter/modules/FeatureCalloutMessages.sys.mjs", "browser/locales/en-US/browser/newtab/onboarding.ftl"], "git_node": "4e601fab619b3be42a5452b358efc12e2e8fc201", "git_parents": ["0db8043fc8ff0a0254630e6c215d741e3651f2a1"], "node": "00d96a32e9fa63ba0c76ab3bc91d2c538afd6db7", "parents": ["6296fc482a445ebf0cc91740ecc7d5316b089911"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075395 - AITab: pair the component catalog with the aitab Remote Settings major r=rrando\n\nThe aitab prompts in Remote Settings describe the packaged component\ncatalog, but nothing tied the two together: the catalog had no version and\nthe build's aitab major lived only in FEATURE_MAJOR_VERSIONS. A catalog\nchange the old prompts cannot describe (a new component, a new property on\na component that forbids unknown ones) would have to ship as a new major\nso two releases can be served side by side, and there was no check that\nthe two numbers agreed.\n\ncomponent_schema.json now declares \"version\": \"1.0\". AITab.loadAssets\nrejects a catalog whose major differs from FEATURE_MAJOR_VERSIONS.aitab\n(clientReason \"catalogVersionMismatch\"); the packaged catalog must declare\na version, a pref override may omit it. loadPromptV2 honors\nmajorVersionOverride like the v1 path, so tests and next-release dry runs\ncan read another major.\n\nNew coverage: the catalog major must equal the constant; an override at\nanother major is rejected; and browser_prompt_loader_aitab_versions.js\npublishes aitab records at two majors through a fake client and checks the\nbuild reads its own major, an override reads the next one, in-place minor\nbumps are picked up, and a missing major fails rather than falling forward.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329045\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/aitab/component_schema.json", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_aitab_catalog.js", "browser/components/aiwindow/models/tests/browser/browser_aitab_schema_override.js", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_aitab_versions.js"], "git_node": "874084c303cb0bf8f1c191bbdb1b0b98b5a8b870", "git_parents": ["4e601fab619b3be42a5452b358efc12e2e8fc201"], "node": "7387908e287156e63feaa465fee5ac088cabb72d", "parents": ["00d96a32e9fa63ba0c76ab3bc91d2c538afd6db7"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2078983: We don't actually need this. r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332094\n", "files": ["dom/media/webrtc/jsapi/RTCEncodedFrameBase.cpp"], "git_node": "631b21b70f19e626670b746fbe8b4c913a301f93", "git_parents": ["874084c303cb0bf8f1c191bbdb1b0b98b5a8b870"], "node": "7bc66d1ae7bb69afff6fb03976fcd789ca4f995d", "parents": ["7387908e287156e63feaa465fee5ac088cabb72d"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2011769: Put r=ng at the session level if there is an RTP m-section.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331839\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "aa4efa9ee34343c9ca14bf0f30497ae37bf0fa27", "git_parents": ["631b21b70f19e626670b746fbe8b4c913a301f93"], "node": "294167771f51b41b7908336fde7ca262f9138a92", "parents": ["7bc66d1ae7bb69afff6fb03976fcd789ca4f995d"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2074202: Add nsSTS::IsShuttingDownOrShutDown. r=necko-reviewers,kershaw\n\nTotal strawman, let me know if you want this done some other way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331703\n", "files": ["netwerk/base/nsSocketTransportService2.h"], "git_node": "3929ca6ec195aa7dde0fd4a41f4a329a808093a9", "git_parents": ["aa4efa9ee34343c9ca14bf0f30497ae37bf0fa27"], "node": "1a1562711b9cbcd84b6389e9cd3cdce83b3007fc", "parents": ["294167771f51b41b7908336fde7ca262f9138a92"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2074202: Refactor to remove the awful \"destruction tour\" we've had since the beginning. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329930\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsapi/MediaTransportHandler.h", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.cpp", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.h", "dom/media/webrtc/jsapi/moz.build", "dom/media/webrtc/tests/mochitests/mochitest_peerconnection.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_offline.html", "media/webrtc/signaling/gtest/mediapipeline_unittest.cpp", "media/webrtc/signaling/gtest/mediatransporthandler_unittest.cpp", "media/webrtc/signaling/gtest/moz.build"], "git_node": "6e7cf87d85e7518749db2283fb513a5b0db84af9", "git_parents": ["3929ca6ec195aa7dde0fd4a41f4a329a808093a9"], "node": "66840fe2ddc5c5df7085490e3034a431dc4628c8", "parents": ["1a1562711b9cbcd84b6389e9cd3cdce83b3007fc"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2074202: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandler.cpp"], "git_node": "5b25d01db35b55164f9ff218807bc3fcb80213f8", "git_parents": ["6e7cf87d85e7518749db2283fb513a5b0db84af9"], "node": "27ce610be0036e42f32a146a9336ad556f85de7a", "parents": ["66840fe2ddc5c5df7085490e3034a431dc4628c8"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981768 - Log HSTS and HTTPS RR connection upgrades to the web console. r=valentin,necko-reviewers,devtools-reviewers,jdescottes\n\nHTTPS-Only, HTTPS-First, CSP upgrade-insecure-requests and Mixed Content\nauto-upgrade all log a console message when they upgrade an HTTP\nrequest. Add the same for HSTS and HTTPS RR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330600\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_filters.js", "dom/locales/en-US/chrome/security/security.properties", "dom/security/test/https-only/browser.toml", "dom/security/test/https-only/browser_hsts_host.js", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/test/browser/browser_mock_https_rr.js"], "git_node": "3a7c9b8a8268e6f20fbbdd5f18150f4393a90447", "git_parents": ["5b25d01db35b55164f9ff218807bc3fcb80213f8"], "node": "267aff44523c08eab730c21d471e6f3e99d20839", "parents": ["27ce610be0036e42f32a146a9336ad556f85de7a"], "tags": []}, {"author": "daviddurfee \u003cdavid@anonymco.com\u003e", "branch": "default", "desc": "Bug 2072355 - Differentially private sponsored scoring. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331736\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/test/jest/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.test.js"], "git_node": "8240f487784731e4aa316f29a3dae982b49b09cc", "git_parents": ["3a7c9b8a8268e6f20fbbdd5f18150f4393a90447"], "node": "241f1d4e345c5c5520df6ff411fc8307aa3a042d", "parents": ["267aff44523c08eab730c21d471e6f3e99d20839"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079887 - Add a Nimbus flag for the onboarding completion state migration feature. r=android-reviewers,joberhauser\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332148\n", "files": ["mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml"], "git_node": "ec5a8311f28f5e3dd1b0772c3b6717b714dc3367", "git_parents": ["8240f487784731e4aa316f29a3dae982b49b09cc"], "node": "f8f4a02e052568ca0ed679c3c9d1c06a9266ad18", "parents": ["241f1d4e345c5c5520df6ff411fc8307aa3a042d"], "tags": []}, {"author": "Ian Lewis \u003cianlewisuk1@gmail.com\u003e", "branch": "default", "desc": "Bug 2032256 - Replace asrouter close-16 and subtract-16 icons with the Nova versions. r=emcminn,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322733\n", "files": ["browser/components/asrouter/content/assets/close-16.svg", "browser/components/asrouter/content/assets/subtract-16.svg"], "git_node": "bb294b0f6676536b09e9550a82bde6f6bff8c6b7", "git_parents": ["ec5a8311f28f5e3dd1b0772c3b6717b714dc3367"], "node": "0ca512f13cebe947dbc16d7c969b3758c1ea7adf", "parents": ["f8f4a02e052568ca0ed679c3c9d1c06a9266ad18"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079041: Handle AutoScratchFloatRegister in liveVolatileFloatRegs r=spidermonkey-reviewers,jandem\n\nsave.takeUnchecked(floatReg) only removes the Double-typed alias for FloatReg0. If this is an Ion IC, and a Float32-typed value is alive in FloatReg0 across the IC, then PopRegsInMask after the call will clobber the return value. We previously ran into this issue in bug 1451976 and used `save.takeUnchecked(floatReg.asSingle())` to ensure both aliases were removed from the save mask, but integrating this into liveVolatileFloatRegs means that we don't need ugly workarounds and should hopefully be able to avoid this in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331857\n", "files": ["js/src/jit-test/tests/cacheir/bug2079041.js", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIRCompiler.h"], "git_node": "b254d420476fdeede8e2f9d2fea19abec0d5ff30", "git_parents": ["bb294b0f6676536b09e9550a82bde6f6bff8c6b7"], "node": "3e7980425f1b6f6e4a18d9316b1875ec8809d37d", "parents": ["0ca512f13cebe947dbc16d7c969b3758c1ea7adf"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079156: Don't look up prototype for iterator helpers r=spidermonkey-reviewers,jandem\n\nIterator helpers use a separate path in the spec that does not do a prototype lookup. This can be observable if %GeneratorFunction.prototype%.prototype is redefined as a getter.\n\nAsync iterator helpers are only stage 2. CreateAsyncIteratorFromClosure was removed from the spec due to lack of uses, which is why the comment points to an old revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331854\n", "files": ["js/src/jit-test/tests/iterator/bug2079156-async.js", "js/src/jit-test/tests/iterator/bug2079156.js", "js/src/vm/AsyncIteration.cpp", "js/src/vm/GeneratorObject.cpp"], "git_node": "e1d135f3efc5fc74169d7c722ca2cf70605ddfd9", "git_parents": ["b254d420476fdeede8e2f9d2fea19abec0d5ff30"], "node": "a68fbfe9e07972b2ebb83db4f6da322c297724ed", "parents": ["3e7980425f1b6f6e4a18d9316b1875ec8809d37d"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076663: Don't optimize out SetArg values when arguments are observable r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331769\n", "files": ["js/src/jit-test/tests/arguments/bug2076663.js", "js/src/jit/WarpBuilder.cpp"], "git_node": "5f0909a991e46440573aece4873feba9a332cbd8", "git_parents": ["e1d135f3efc5fc74169d7c722ca2cf70605ddfd9"], "node": "91bdfa8ba068ab05d7e7702940485116823835cc", "parents": ["a68fbfe9e07972b2ebb83db4f6da322c297724ed"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077785 - [devtools] Read the real cache entry for 304 requests r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330699\n", "files": ["devtools/client/netmonitor/test/browser_al.toml", "devtools/client/netmonitor/test/browser_net_cache_details.js", "devtools/client/netmonitor/test/browser_net_cache_details_revalidated.js", "devtools/shared/network-observer/NetworkResponseListener.sys.mjs", "devtools/shared/platform/CacheEntry.sys.mjs"], "git_node": "939f0070cb6f0717e96da2419412c9b7afb0de2d", "git_parents": ["5f0909a991e46440573aece4873feba9a332cbd8"], "node": "793c93370ebd039823f5286c4507cfdb517eba18", "parents": ["91bdfa8ba068ab05d7e7702940485116823835cc"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077785 - [wdspec] Add tests for network.getData with 304 not modified requests r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330700\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/network/get_data/request.py", "testing/web-platform/tests/webdriver/tests/support/http_handlers/etag.py"], "git_node": "d1e3e8302e6dde2a76e6e32b0673d643c9a8aba0", "git_parents": ["939f0070cb6f0717e96da2419412c9b7afb0de2d"], "node": "04c76a8b24146a0f213290d95687756c6b56b996", "parents": ["793c93370ebd039823f5286c4507cfdb517eba18"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074578, Bug 2075355, Bug 2074574, Bug 2074514 - Create delete confirmation dialogs for VPN site rules settings - r=kpatenio,mstriemer,ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,bolsson\" for causing bc failures at browser_privacy_ipprotection_siterules_srd.js\n\nThis reverts commit 37865ff75105879f6dc4e8ba0495f45a66e19dbd.\n\nRevert \"Bug 2075355 - Add a dialog for editing a site inclusion or exclusion - r=kpatenio,ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,reusable-components-reviewers,mstriemer,flod\"\n\nThis reverts commit 4ebc6be645df8bba788503f95ee23139d05e4b60.\n\nRevert \"Bug 2074574 - Add dialog for creating a site inclusion or exclusion rule in VPN settings - r=ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,mstriemer,bolsson,kpatenio\"\n\nThis reverts commit 5aaebbd742b23887d38a997d1645a849c964cd59.\n\nRevert \"Bug 2074514 - Create new list component for managing site permissions in website settings subpane - r=ip-protection-reviewers,fluent-reviewers,settings-reviewers,desktop-theme-reviewers,mstriemer,flod,kpatenio\"\n\nThis reverts commit 666fdefcaa0cf5ca56ebcc9f33c8c3d26cde2d7d.\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.css", "browser/components/ipprotection/content/vpn-site-rules-list.mjs", "browser/components/ipprotection/jar.mn", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/dialogs/jar.mn", "browser/components/preferences/dialogs/vpnSiteRule.css", "browser/components/preferences/dialogs/vpnSiteRule.js", "browser/components/preferences/dialogs/vpnSiteRule.xhtml", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js", "browser/locales/en-US/browser/ipProtection.ftl", "browser/themes/shared/preferences/preferences.css"], "git_node": "164c07c9ff55a314299009fbf8f2fdb6f0a0285e", "git_parents": ["d1e3e8302e6dde2a76e6e32b0673d643c9a8aba0"], "node": "b7f4095accc5893befd91ca951306634185e4d51", "parents": ["04c76a8b24146a0f213290d95687756c6b56b996"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079527 - avoid constructing CERTCertificates for the peer in TransportLayerDtls. r=webrtc-reviewers,bwc\n\nTransportLayerDtls::AuthCertificateHook decoded the peer's end-entity\ncertificate with SSL_PeerCertificate only to fingerprint its DER encoding,\nand GetPeerCertChainDer decoded every certificate in the chain with\nSSL_PeerCertificateChain only to copy out each one's DER encoding. Both now\nuse SSL_PeerCertificateChainDER and work with the DER bytes directly.\n\nAuthCertificateHook now only fetches the chain in VERIFY_DIGEST mode, and\nfails with SSL_ERROR_BAD_CERTIFICATE if the peer presented no certificate.\nPreviously a null certificate would have been passed to\nDtlsIdentity::ComputeFingerprint and dereferenced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331846\n", "files": ["dom/media/webrtc/transport/transportlayerdtls.cpp", "dom/media/webrtc/transport/transportlayerdtls.h"], "git_node": "10f497b13fab9c0950a4d608d6d2ac9de32969cb", "git_parents": ["164c07c9ff55a314299009fbf8f2fdb6f0a0285e"], "node": "19fc9da023369d9bfb5842f48cbdcb0afe23f07e", "parents": ["b7f4095accc5893befd91ca951306634185e4d51"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2076802 - Update quinn-udp to 0.6.3 r=leggert,supply-chain-reviewers\n\nhttps://github.com/quinn-rs/quinn/releases/tag/quinn-udp-0.6.3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329964\n", "files": ["Cargo.lock", "supply-chain/audits.toml", "third_party/rust/quinn-udp/.cargo-checksum.json", "third_party/rust/quinn-udp/.cargo_vcs_info.json", "third_party/rust/quinn-udp/Cargo.lock", "third_party/rust/quinn-udp/Cargo.toml", "third_party/rust/quinn-udp/Cargo.toml.orig", "third_party/rust/quinn-udp/src/apple_fast.rs", "third_party/rust/quinn-udp/src/cmsg/mod.rs", "third_party/rust/quinn-udp/src/cmsg/unix.rs", "third_party/rust/quinn-udp/src/cmsg/windows.rs", "third_party/rust/quinn-udp/src/linux.rs", "third_party/rust/quinn-udp/src/unix.rs", "third_party/rust/quinn-udp/src/windows.rs"], "git_node": "226f1ca8aa2d9cc79b377303eac40dd0a3ba105d", "git_parents": ["10f497b13fab9c0950a4d608d6d2ac9de32969cb"], "node": "4ba79e811c75f2e7c048a3d096bfdf9218336907", "parents": ["19fc9da023369d9bfb5842f48cbdcb0afe23f07e"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079542 - Use `useWidgetTelemetry` in the Weather widget. r=fchasen\n\nWeather now uses `useWidgetTelemetry` for impressions, load errors and actions, like the other widgets. The event fields stay the same. It also records impressions when the widget appears after weather data loads, with a new test covering that case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332142\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Weather/Weather.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Weather.test.jsx"], "git_node": "e8d05c59e4a8f792aa42c198aec123ecf8b3db48", "git_parents": ["226f1ca8aa2d9cc79b377303eac40dd0a3ba105d"], "node": "e88f430904e7bebee487001a243f1bb4ef304526", "parents": ["4ba79e811c75f2e7c048a3d096bfdf9218336907"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2079636 - Migrate siteData.properties to Fluent. r=settings-reviewers,fluent-reviewers,bolsson,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331930\n", "files": ["browser/locales/en-US/browser/preferences/siteDataSettings.ftl", "browser/locales/en-US/chrome/browser/siteData.properties", "browser/locales/jar.mn", "browser/modules/SiteDataManager.sys.mjs", "python/l10n/fluent_migrations/bug_2079636_site_data_properties.py"], "git_node": "fec69795ab095674566c764eec820b0717746d01", "git_parents": ["e8d05c59e4a8f792aa42c198aec123ecf8b3db48"], "node": "a271b4266d982be62edbf352ecae9c506ae1a034", "parents": ["e88f430904e7bebee487001a243f1bb4ef304526"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2078970 - Pt 1 - Apply a tile cache's deferred dirty tests to every sub-slice. r=gfx-reviewers,nical\n\nThe tests were drained inside the loop over sub-slices, so only the first\nsub-slice's tiles were checked. A backdrop-filter on a sub-slice above a\ncompositor surface was not redrawn when the content it samples changed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331426\n", "files": ["gfx/wr/webrender/src/tile_cache/mod.rs"], "git_node": "57a71ddf1c9b84b415d8b8ce37eea8cae701db68", "git_parents": ["fec69795ab095674566c764eec820b0717746d01"], "node": "7dc153b6708793162510fd1cd098c0e4d72b5b10", "parents": ["a271b4266d982be62edbf352ecae9c506ae1a034"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2078970 - Pt 2 - Remove the unused PictureInstance::prev_local_rect and segments_are_valid. r=gfx-reviewers,nical\n\nsegments_are_valid was only ever written, and prev_local_rect only fed it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331428\n", "files": ["gfx/wr/webrender/src/picture.rs"], "git_node": "a229de4368a9f34f272dbf5730aee8394d3f49d1", "git_parents": ["57a71ddf1c9b84b415d8b8ce37eea8cae701db68"], "node": "63a75d8099cd04949b1c6084829a8c3d9d6eb2c9", "parents": ["7dc153b6708793162510fd1cd098c0e4d72b5b10"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2078970 - Pt 3 - Have prepare walk each picture's draws instead of its primitive instances. r=gfx-reviewers,nical\n\nVisibility already records each picture's draws. Walking them skips culled\ninstances and lifts the limit of one draw per primitive instance per frame.\nPREPARE_VISITED_PRIMS now counts the draws visited.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331430\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "fdba13d2f992d5797e7436384a1d789737a19b98", "git_parents": ["a229de4368a9f34f272dbf5730aee8394d3f49d1"], "node": "14fd6bdfe3fef311c08f861e6131892bd2cd5562", "parents": ["63a75d8099cd04949b1c6084829a8c3d9d6eb2c9"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2078970 - Pt 4 - Place a backdrop-filter chain in a non-atomic slice by its element's spatial node. r=gfx-reviewers,nical\n\nThe chain is added with an unknown spatial node, so a non-atomic slice, which\npicks a secondary slice from each primitive's spatial node, can't place it.\nNo change in behaviour yet, as backdrop-filters still make their slice atomic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331431\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs"], "git_node": "bd194a47b691061dbc3985ed028caacb3c5e1213", "git_parents": ["fdba13d2f992d5797e7436384a1d789737a19b98"], "node": "99cbdbc8bfe78e4bc4f177c848a56ae8c1934e82", "parents": ["14fd6bdfe3fef311c08f861e6131892bd2cd5562"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075022 - Adopt engine syncIDs from meta/syncids instead of resetting r=markh,sync-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328683\n", "files": ["services/sync/modules/engines.sys.mjs", "services/sync/tests/unit/test_syncengine_sync.js"], "git_node": "079656e66991a7e333cf2ee3d0f24c4ca342103f", "git_parents": ["bd194a47b691061dbc3985ed028caacb3c5e1213"], "node": "a7b82073584d25d38cba0937437e35e9acb26eac", "parents": ["99cbdbc8bfe78e4bc4f177c848a56ae8c1934e82"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074928 - Update Widevine fallback downloader URLs for 4.10.3112.0. r=aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330898\n", "files": ["toolkit/content/gmp-sources/widevinecdm.json"], "git_node": "f268f9f0bac68a3e043a0ba9c2f166137fdf733b", "git_parents": ["079656e66991a7e333cf2ee3d0f24c4ca342103f"], "node": "b1f265819ad2784c0d1ea33df00ed8a26831d978", "parents": ["a7b82073584d25d38cba0937437e35e9acb26eac"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069132 - AITab creation telemetry r=omarg,tabbrowser-reviewers,ai-security-reviewers,kcochrane\n\nAdd Telemetry around creation of an AITab\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329071\n", "files": ["browser/base/content/main-popupset.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs"