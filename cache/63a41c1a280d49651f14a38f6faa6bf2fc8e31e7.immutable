app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractableDragItemContainerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractableGridTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractableListTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractionModeTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractionStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/InteractionTestHelper.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/legacy/ReorderableGridTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/browser/compose/legacy/ReorderableListTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayoutTest.kt", "taskcluster/config.yml"], "git_node": "3e43365c8141d2616ce5c40b70eb04b834af2878", "git_parents": ["ec1b73b78896f6d5ebde81f2e7fad92461e2ba22"], "node": "2e397133de2ed403acfa32afc075002770d03693", "parents": ["7561b0720d3af857bc4beb2d977f3b71db065666"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082351 - VPN toolbar icon has incorrect UI when in overflow menu in included state - r=ip-protection-reviewers,desktop-theme-reviewers,lesleynorton,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334280\n", "files": ["browser/themes/shared/toolbarbutton-icons.css"], "git_node": "0681998eb8121214622815cd3db75c26f4d3cdd3", "git_parents": ["3e43365c8141d2616ce5c40b70eb04b834af2878"], "node": "1c67ee4413c1f528ed70bbbbcd5892355ba8265b", "parents": ["2e397133de2ed403acfa32afc075002770d03693"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079886 - AITab: Use tokenized URL length as factor for determining page content character limits r=thasan,hlin,omarg\n\nSome URLs are quite long on some pages, and they are eating up our internal quotas, even though they are tokenized to something short later on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334663\n", "files": ["browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab.js", "browser/components/aiwindow/ui/modules/UrlTokenizer.sys.mjs"], "git_node": "14123168b894e4cb0b4a486b79c7f473643e876f", "git_parents": ["0681998eb8121214622815cd3db75c26f4d3cdd3"], "node": "493be17cf829ff10bfde8ad3304fe61d08647178", "parents": ["1c67ee4413c1f528ed70bbbbcd5892355ba8265b"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2083185 - remove unused nsWindowsMigrationUtils.h, r=migration-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335388\n", "files": ["browser/components/migration/moz.build", "browser/components/migration/nsWindowsMigrationUtils.h"], "git_node": "96507c43cf46692bd9d38cd9aa770220dc6c1460", "git_parents": ["14123168b894e4cb0b4a486b79c7f473643e876f"], "node": "237ae2c22679cb6557a383a0696644c2fab3b7d3", "parents": ["493be17cf829ff10bfde8ad3304fe61d08647178"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075566 - Update tabs tray visibility in the App Store when fragment is getting removed r=android-reviewers,gl\n\nThe if statement in `TabManagementFragment.onDestroyView` keeps a configuration change that happens when the tabs tray is still open to be treated as leaving the tabs tray. This was added as a part of the PBM lock feature.\n\nDue to theming changes, when switching from a private tab to a normal tab, a configuration change also happens but this is also when the tabs tray gets dismissed. As a result, the if statement catches this configuration change and doesn't update the tabs tray visibility\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335389\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt"], "git_node": "beb150247df10bf2951f4fcaccbbe87ef8ae1c80", "git_parents": ["96507c43cf46692bd9d38cd9aa770220dc6c1460"], "node": "c33dfff92823b84cad26f774d2463071083f4839", "parents": ["237ae2c22679cb6557a383a0696644c2fab3b7d3"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083707: Update irregexp to 48a0da03cb526a5eef4c7c096ef8047516c06e33 r=spidermonkey-reviewers,yulia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335421\n", "files": ["js/src/irregexp/imported/gen-regexp-special-case.cc", "js/src/irregexp/imported/regexp-ast.h", "js/src/irregexp/imported/regexp-bytecode-generator-inl.h", "js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-compiler-tonode.cc", "js/src/irregexp/imported/regexp-compiler.cc", "js/src/irregexp/imported/regexp-compiler.h", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-nodes.h", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/imported/special-case.h", "js/src/irregexp/moz.yaml"], "git_node": "e9d639f92db2452afa97b361b7ade48de74afb9e", "git_parents": ["beb150247df10bf2951f4fcaccbbe87ef8ae1c80"], "node": "fc9433e822e69e98f4186c83fdda5fa5169ba4b4", "parents": ["c33dfff92823b84cad26f774d2463071083f4839"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083707: Apply mozilla patches for irregexp r=spidermonkey-reviewers,yulia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335422\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h"], "git_node": "29f4f83ad006589a543f9889b0a00d39152d374f", "git_parents": ["e9d639f92db2452afa97b361b7ade48de74afb9e"], "node": "645b7157bb8396e4d595f4e383318497fea8a513", "parents": ["fc9433e822e69e98f4186c83fdda5fa5169ba4b4"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083707: Update RegExp::Stack shim r=spidermonkey-reviewers,dminor\n\nAndrew Gaul landed a patch in V8 to access all RegExp::Stack state through a single pinned register. This patch just rebases our current approach on top of his changes; I'll land a follow-up patch in a separate bug to make the equivalent change in our code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335423\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpShim.cpp", "js/src/irregexp/RegExpShim.h"], "git_node": "9c9780e35780fb7dcb1347a8fb39e0aace053066", "git_parents": ["29f4f83ad006589a543f9889b0a00d39152d374f"], "node": "206d30bbfc0f8aca8addda29c652d1a3513a4552", "parents": ["645b7157bb8396e4d595f4e383318497fea8a513"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083707: Use V8's implementation for case-insensitive backreference comparison r=spidermonkey-reviewers,mgaudet\n\nThe spec rules for case-insensitive comparison are finicky. Prior to this update, both engines had known issues. V8 fixed their issues, so we might as well use their implementation directly.\n\nThis fixes bug 2072420. I'll land the testcase from that bug separately so that it gets automatically closed when the stack lands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335424\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp"], "git_node": "0cbb7d0ccf1c632a837ada8ee08bfc3242f369e4", "git_parents": ["9c9780e35780fb7dcb1347a8fb39e0aace053066"], "node": "622e87c08ad77c2e5000a5f81e171d22ea0d6be5", "parents": ["206d30bbfc0f8aca8addda29c652d1a3513a4552"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083707: Add update-special-case.py and update special-case.cc  r=spidermonkey-reviewers,mgaudet\n\nThe initial plan for special-case.cc was that on the rare occasion where we needed to update it, we could simply copy the output of V8's build process. It turns out that this isn't entirely true. In particular, the next Unicode version (Unicode 18) will add characters in the supplementary set that casefold to characters in the basic multilingual plane, meaning that for the first time the case-folding equivalence set for characters in the BMP may contain surrogate pairs. At the moment, Chrome has updated to use Unicode 18, but Firefox is still using Unicode 17. This means that our SupplementaryEquivalents set is empty, but we still need to define it. Since we're expecting to rebuild this again in the future, I got Claude to write a quick script to do so. It's not part of the regular build; it should be run manually when necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335425\n", "files": ["js/src/irregexp/imported/special-case.cc", "js/src/irregexp/update-special-case.py"], "git_node": "630d174192fd35ef4a7398a678c7806f94d7a5a2", "git_parents": ["0cbb7d0ccf1c632a837ada8ee08bfc3242f369e4"], "node": "dfd4b615ad35aa051f7de220465b4fd261af1fed", "parents": ["622e87c08ad77c2e5000a5f81e171d22ea0d6be5"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083707: Update shim r=spidermonkey-reviewers,mgaudet\n\nA couple of small shim updates that don't need their own patch.\n\nThe RoundUpToPowerOfTwo code is no longer needed because V8 replaced its uses with std::bit_ceil to reduce custom bit-twiddling code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335426\n", "files": ["js/src/irregexp/RegExpShim.h", "js/src/jit/JitOptions.cpp", "js/src/jit/JitOptions.h"], "git_node": "22dee57b45abd64a1fc967da24dc4bfcea6ad516", "git_parents": ["630d174192fd35ef4a7398a678c7806f94d7a5a2"], "node": "4438af531a6c1c7c36cdf3d928a5e4a09d9f064a", "parents": ["dfd4b615ad35aa051f7de220465b4fd261af1fed"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078698: Add test r=spidermonkey-reviewers,mgaudet\n\nThis is fixed by the irregexp update in bug 2083707.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335427\n", "files": ["js/src/jit-test/tests/regexp/bug2078698.js"], "git_node": "f85adba6f76d25e071f4e9005cb743184183a62c", "git_parents": ["22dee57b45abd64a1fc967da24dc4bfcea6ad516"], "node": "30649f418b80905e1ef3fbed707d375659f5cd01", "parents": ["4438af531a6c1c7c36cdf3d928a5e4a09d9f064a"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068429: Add test r=spidermonkey-reviewers,mgaudet\n\nThis is fixed by the irregexp update in bug 2083707.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335428\n", "files": ["js/src/jit-test/tests/regexp/bug2068429.js"], "git_node": "14a45f4d1b4902140d43f9c1f59c99bbd71f4b89", "git_parents": ["f85adba6f76d25e071f4e9005cb743184183a62c"], "node": "533608b5b45bb0c115f220a9dbe1e5efdc1f18e7", "parents": ["30649f418b80905e1ef3fbed707d375659f5cd01"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078729: Add test r=spidermonkey-reviewers,mgaudet\n\nThis is fixed by the irregexp update in bug 2083707.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335429\n", "files": ["js/src/jit-test/tests/regexp/bug2078729.js"], "git_node": "745e2adab034e5d05dbf7c72fbe9812266ae0ee4", "git_parents": ["14a45f4d1b4902140d43f9c1f59c99bbd71f4b89"], "node": "2088621cc73dca737e8c5a78ae6d876e3e89be14", "parents": ["533608b5b45bb0c115f220a9dbe1e5efdc1f18e7"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078864: Add test r=spidermonkey-reviewers,mgaudet\n\nThis is fixed by the irregexp update in bug 2083707.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335430\n", "files": ["js/src/jit-test/tests/regexp/bug2078864.js"], "git_node": "88ef17bfc2a6d7a95ea7ee88b525d08a2b7b0596", "git_parents": ["745e2adab034e5d05dbf7c72fbe9812266ae0ee4"], "node": "1e50f340cad2de0c9d19a4216a63b50656c89a64", "parents": ["2088621cc73dca737e8c5a78ae6d876e3e89be14"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072420: Add test r=spidermonkey-reviewers,mgaudet\n\nThis is fixed by the irregexp update in bug 2083707.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335431\n", "files": ["js/src/jit-test/tests/regexp/bug2072420.js"], "git_node": "bf238e2ccded39f0636aa0b677f7ec33f3469785", "git_parents": ["88ef17bfc2a6d7a95ea7ee88b525d08a2b7b0596"], "node": "361071a9abcd65ec65dc8116218b45d1aea9fe9a", "parents": ["1e50f340cad2de0c9d19a4216a63b50656c89a64"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083928: Pin regexp::Stack limit to a register r=spidermonkey-reviewers,dminor\n\nOur generated regexp code touches three fields in regexp::Stack: the current stack pointer, the stack limit, and the base of the stack. During execution, we keep the current stack pointer in a register, read the stack limit via AbsoluteAddress when pushing to the backtrack stack, and cache the base of the stack in our own stack frame (we use it to turn pointers to the backtrack stack into offsets so that they aren't invalidated when the backtrack stack grows).\n\nUpstream V8 landed a change (written by Andrew Gaul) to reduce code size by pinning a register pointing at the regexp::Stack itself and reading the stack limit / stack base fields through that, to avoid having to materialize v8's equivalent to an AbsoluteAddress repeatedly. I prototyped the equivalent change in our engine, then realized that if we're willing to pin an extra register, it's more efficient to load the stack limit into a register directly. Our accesses to the base of the stack already avoid AbsoluteAddress materialization because we're reading from our own stack frame, so pinning the stack limit eliminates the last of our AbsoluteAddress accesses in hot paths. (We still generate AbsoluteAddress code in prologue/epilogue/call code, but those paths aren't as hot as pushing/popping to the backtrack stack.)\n\nWe were already short one register on x86, so we just skip this optimization there.\n\nThis is about 10% faster on my x64 laptop on a microbenchmark, although I don't expect anything nearly that significant for real-world code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335432\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h"], "git_node": "b96dcbae6e47f9bd68f17a05f7788c6a551035b5", "git_parents": ["bf238e2ccded39f0636aa0b677f7ec33f3469785"], "node": "94698f09d7cf35a187d1df7c7ae7eb1be7e67982", "parents": ["361071a9abcd65ec65dc8116218b45d1aea9fe9a"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2074669 - Enable Smart Window resume cards by default - r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332971\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_telemetry.js"], "git_node": "742ec4c90d0071338c08aa3d03bd020ec5691c3b", "git_parents": ["b96dcbae6e47f9bd68f17a05f7788c6a551035b5"], "node": "a7bcc8c892b44d6c5288b3cbce07cf3e303cf66a", "parents": ["94698f09d7cf35a187d1df7c7ae7eb1be7e67982"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Implement CSSNumericValue.sub(); r=emilio,firefox-style-system-reviewers\n\nImplement CSSNumericValue.sub() according to the CSS Typed OM specification.\n\nReuse the internal Add() algorithm after negating the arguments. Introduce a\nNegate() helper implementing the corresponding specification algorithm.\n\nExtend CSSMathNegate::Create() to support constructing negations directly from\nDOM numeric values, without requiring an intermediate Stylo representation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333686\n", "files": ["layout/style/typedom/CSSMathNegate.cpp", "layout/style/typedom/CSSMathNegate.h", "layout/style/typedom/CSSNumericValue.cpp", "layout/style/typedom/CSSNumericValue.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini"], "git_node": "6cb604bf30f7aa9fe06bf03061a22b6e367500a0", "git_parents": ["742ec4c90d0071338c08aa3d03bd020ec5691c3b"], "node": "b123102e437aed250ba637d5274a240c614d3d6e", "parents": ["a7bcc8c892b44d6c5288b3cbce07cf3e303cf66a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082386 - Speed up BigInt division on AArch64 devices r=mgaudet\" for causing build bustages @ BigIntType.cpp\n\nThis reverts commit c1afc7e5dd666ffc7c58ea5c18801ed286d5db06.\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "531bc7abadd7a7e19f8ab38ca80b23e2b56f5a19", "git_parents": ["6cb604bf30f7aa9fe06bf03061a22b6e367500a0"], "node": "505793fce247fbd007e46d18d00536956a43965d", "parents": ["b123102e437aed250ba637d5274a240c614d3d6e"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083857 - Do not show the text selection menu for text selected in a textarea. r=flozia\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nIgnores `textarea` while `browser.highlightToSearch.featureGate` is on, so users who already have a chatbot configured keep the menu there until the feature ships.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335297\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "a6127c21fee3ddc8f142a318e78d5c2b9fd7668c", "git_parents": ["531bc7abadd7a7e19f8ab38ca80b23e2b56f5a19"], "node": "578c1e6d6aa95ce6ce696ca12bf5a73f06b2765d", "parents": ["505793fce247fbd007e46d18d00536956a43965d"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083407 - Record turning the text selection menu on or off from Settings. r=settings-reviewers,tgiles\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nRecords `selection_menu.option_toggled` when the menu or the Ask checkbox is changed in Settings, as the Search checkbox already does, and when unchecking the last action turns the menu off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334916\n", "files": ["browser/components/preferences/config/tabs-browsing.mjs", "browser/components/preferences/tests/browser_tabs_browsing_highlightToSearch.js"], "git_node": "c7a051edaf00f1f218e164e4f5db3e1c9a633824", "git_parents": ["a6127c21fee3ddc8f142a318e78d5c2b9fd7668c"], "node": "8e861c2fb8ea13bf24396b6d0599631e6415db71", "parents": ["578c1e6d6aa95ce6ce696ca12bf5a73f06b2765d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076423 - Enforce module script MIME type checks for worklets. r=arai,necko-reviewers,media-playback-reviewers,devtools-reviewers,jdescottes,valentin,padenot\n\nWorklet module fetches never checked the response MIME type against the\nrequested module type, so a top-level worklet script served as e.g. text/plain\nwould run, as would a JSON import served with a non-JSON type.  The netwerk\ncheck can't be used, since all worklet fetches share one content policy type\nregardless of module type; instead plumb the module type to\nWorkletScriptHandler and check there, reporting mismatches to the console.\nThe necko wrong-MIME warning is skipped for worklets, since it claimed the\nscript was loaded anyway.\n\nThis also stops treating application/wasm responses as wasm when the wasm ESM\nintegration pref is off or the module type isn't JavaScript, and gives the\nAudioWorklet test Blobs that relied on the missing check a JavaScript MIME\ntype.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333842\n", "files": ["devtools/client/webconsole/test/browser/test-worker-promise-error.html", "dom/media/test/crashtests/audioworkletnode-after-unload-1.html", "dom/worklet/WorkletFetchHandler.cpp", "dom/worklet/WorkletFetchHandler.h", "dom/worklet/loader/WorkletModuleLoader.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "62d54a6253862362ce6c94f712ab038cf985526f", "git_parents": ["c7a051edaf00f1f218e164e4f5db3e1c9a633824"], "node": "b13c0c7514803a02c710e0b219092714144beb09", "parents": ["8e861c2fb8ea13bf24396b6d0599631e6415db71"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081937 - Key worklet fetching requests by module type as well as URI. r=arai\n\nWorkletModuleLoader tracked in-flight fetches by URI only, while\nModuleLoaderBase treats the same URI imported as different module types as\nseparate fetches.  Concurrent fetches of one URL as two types overwrote each\nother's entry, so one fetch completed the wrong request and the other found no\nrequest (debug) or completed the same one twice (release), leaving the first\nrequest pending forever.  RemoveRequest() also called Remove() inside\nMOZ_ASSERT, so entries were never removed in non-debug builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333843\n", "files": ["dom/worklet/WorkletFetchHandler.cpp", "dom/worklet/WorkletFetchHandler.h", "dom/worklet/loader/WorkletModuleLoader.cpp", "dom/worklet/loader/WorkletModuleLoader.h"], "git_node": "fea583e49f28e1cadaf0bc26372723541584464d", "git_parents": ["62d54a6253862362ce6c94f712ab038cf985526f"], "node": "7757cc446e74156d8be85370f95d0d989401bcab", "parents": ["b13c0c7514803a02c710e0b219092714144beb09"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081937 - Test importing one URL as two module types in a worklet. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333844\n", "files": ["dom/worklet/tests/import_same_url_twice_target.mjs", "dom/worklet/tests/mochitest.toml", "dom/worklet/tests/test_import_same_url_twice.html"], "git_node": "d3e5ca7088f1aadd7ebb538f3ed4308403921596", "git_parents": ["fea583e49f28e1cadaf0bc26372723541584464d"], "node": "a2397a3f219b039573f5427553844344895397d5", "parents": ["7757cc446e74156d8be85370f95d0d989401bcab"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076423 - Test worklet module script MIME type checks. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333845\n", "files": ["dom/worklet/tests/mochitest.toml", "dom/worklet/tests/server_mime_type.sjs", "dom/worklet/tests/test_audioWorklet_mimeType.html"], "git_node": "e41ed36043b05a7b86faa779768a322b0914cce4", "git_parents": ["d3e5ca7088f1aadd7ebb538f3ed4308403921596"], "node": "bd95bb293b1bb73cf5118b11db09148a92cb546c", "parents": ["a2397a3f219b039573f5427553844344895397d5"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083157 - Don't register the ReportBrokenSite pref observers twice. r=webcompat-reviewers,twisniewski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335237\n", "files": ["browser/components/reportbrokensite/ReportBrokenSite.sys.mjs"], "git_node": "44c67c617e71059990b108a29cc7c63a4cbfe109", "git_parents": ["e41ed36043b05a7b86faa779768a322b0914cce4"], "node": "68cfeaf41ca4753a20c281917cfbe2943923c387", "parents": ["bd95bb293b1bb73cf5118b11db09148a92cb546c"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084279 - Rename the 3pcbexception log module to ThirdPartyCookieBlockingExceptions. r=cookie-reviewers,manuel\n\nMOZ_LOG doesn't accept module names starting with a digit, so the module\ncould only be enabled through the logging.3pcbexception pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335706\n", "files": ["netwerk/cookie/ThirdPartyCookieBlockingExceptions.cpp"], "git_node": "08120ffff4720f53fee6b3b94d0e468429c1da61", "git_parents": ["44c67c617e71059990b108a29cc7c63a4cbfe109"], "node": "36827e1b377d9cc670f1b283ad6e5422c549811d", "parents": ["68cfeaf41ca4753a20c281917cfbe2943923c387"], "tags": []}, {"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2083506 - Update wgpu to upstream e084b66aa (2026-10-18) r=webgpu-reviewers,supply-chain-reviewers,teoxoy\n\nImport a new version of `wgpu_core`, `naga` and related crates, and\nadapt `gfx/wgpu_bindings` and `dom/webgpu/ipc` to API changes.\n\nIn the newly vendored version of the `wgpu` crates,\n`wgpu_core_remote::Global::buffer_get_mapped_range` returns a\n`wgpu_core::resource::BufferMapping` value that ensures the pointer to the\nmapped memory remains valid until it is dropped. In the C++ bindings, introduce\na new `MappedRangeGuard` type for use by `WebGPUParent` that owns the mapped\nrange and releases the `BufferMapping` when it is dropped. Change all callers of\n`wgpu_server_buffer_get_mapped_range` to use `MappedRangeGuard` instead.\n\nSince `MappedRangeGuard` causes buffer unmapping and destruction to block, take\ncare not to hold a `MappedRangeGuard` across any such operation, or any call\nthat might perform one, to avoid deadlock.\n\nMark the following test as \"backlog\" for debug macOS builds. This was\nalready in the backlog for release macOS.\n\n\u003e webgpu:api,operation,command_buffer,image_copy:offsets_and_sizes_copy_depth_stencil:*\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335467\n", "files": [".cargo/config.toml.in", "Cargo.lock", "dom/webgpu/ipc/MappedRangeGuard.cpp", "dom/webgpu/ipc/MappedRangeGuard.h", "dom/webgpu/ipc/WebGPUParent.cpp", "dom/webgpu/ipc/WebGPUParent.h", "dom/webgpu/moz.build", "gfx/wgpu_bindings/Cargo.toml", "gfx/wgpu_bindings/cbindgen.toml", "gfx/wgpu_bindings/moz.yaml", "gfx/wgpu_bindings/src/server.rs", "supply-chain/audits.toml", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/command_buffer/copyTextureToTexture/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/command_buffer/image_copy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/rendering/3d_texture_slices/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxInterStageShaderVariables/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxStorageBuffersPerShaderStage/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/encoding/cmds/copyTextureToTexture/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/render_pipeline/fragment_state/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/state/device_lost/destroy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/sign/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupAdd/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupMinMax/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupMul/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGather/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGatherCompare/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureLoad/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSample/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleBias/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleCompare/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleCompareLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleGrad/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/expression/call/builtin/subgroupShuffle/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/canvas/readbackFromWebGPUCanvas/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/canvas/readbackFromWebGPUCanvas/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/canvas/readbackFromWebGPUCanvas/service.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/canvas/readbackFromWebGPUCanvas/shared.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/service.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/shared.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/canvas/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/image/cts.https.html.ini", "third_party/rust/naga-types/.cargo-checksum.json", "third_party/rust/naga-types/Cargo.toml", "third_party/rust/naga-types/src/lib.rs", "third_party/rust/naga-types/src/wgsl.rs", "third_party/rust/naga/.cargo-checksum.json", "third_party/rust/naga/build.rs", "third_party/rust/naga/src/back/glsl/writer.rs", "third_party/rust/naga/src/back/hlsl/writer.rs", "third_party/rust/naga/src/back/msl/writer.rs", "third_party/rust/naga/src/back/spv/layout.rs", "third_party/rust/naga/src/back/spv/mesh_shader.rs", "third_party/rust/naga/src/back/spv/mod.rs", "third_party/rust/naga/src/back/spv/writer.rs", "third_party/rust/naga/src/back/wgsl/writer.rs", "third_party/rust/naga/src/common/external_texture.rs", "third_party/rust/naga/src/common/mod.rs", "third_party/rust/naga/src/front/glsl/functions.rs", "third_party/rust/naga/src/front/spv/mod.rs", "third_party/rust/naga/src/front/type_gen.rs", "third_party/rust/naga/src/front/wgsl/lower/mod.rs", "third_party/rust/naga/src/proc/mod.rs", "third_party/rust/naga/src/proc/namer.rs", "third_party/rust/naga/src/proc/type_methods.rs", "third_party/rust/naga/src/racy_lock.rs", "third_party/rust/naga/src/valid/type.rs", "third_party/rust/wgpu-core-deps-linux-android-bsd/.cargo-checksum.json", "third_party/rust/wgpu-core-deps-linux-android-bsd/Cargo.toml", "third_party/rust/wgpu-core-remote-types/.cargo-checksum.json", "third_party/rust/wgpu-core-remote-types/Cargo.toml", "third_party/rust/wgpu-core-remote-types/src/id.rs", "third_party/rust/wgpu-core-remote-types/src/identity.rs", "third_party/rust/wgpu-core-remote/.cargo-checksum.json", "third_party/rust/wgpu-core-remote/Cargo.toml", "third_party/rust/wgpu-core-remote/src/global/device.rs", "third_party/rust/wgpu-core-remote/src/global/mod.rs", "third_party/rust/wgpu-core-remote/src/hub.rs", "third_party/rust/wgpu-core/.cargo-checksum.json", "third_party/rust/wgpu-core/src/command/bundle.rs", "third_party/rust/wgpu-core/src/command/draw.rs", "third_party/rust/wgpu-core/src/command/render.rs", "third_party/rust/wgpu-core/src/device/queue.rs", "third_party/rust/wgpu-core/src/device/resource.rs", "third_party/rust/wgpu-core/src/init_tracker/mod.rs", "third_party/rust/wgpu-core/src/instance.rs", "third_party/rust/wgpu-core/src/lib.rs", "third_party/rust/wgpu-core/src/lock/observing.rs", "third_party/rust/wgpu-core/src/lock/ranked.rs", "third_party/rust/wgpu-core/src/lock/vanilla.rs", "third_party/rust/wgpu-core/src/pipeline_cache.rs", "third_party/rust/wgpu-core/src/resource.rs", "third_party/rust/wgpu-core/src/snatch.rs", "third_party/rust/wgpu-core/src/track/buffer.rs", "third_party/rust/wgpu-core/src/track/metadata.rs", "third_party/rust/wgpu-core/src/track/mod.rs", "third_party/rust/wgpu-core/src/track/range.rs", "third_party/rust/wgpu-core/src/track/stateless.rs", "third_party/rust/wgpu-hal/.cargo-checksum.json", "third_party/rust/wgpu-hal/Cargo.toml", "third_party/rust/wgpu-hal/src/auxil/mod.rs", "third_party/rust/wgpu-hal/src/gles/adapter.rs", "third_party/rust/wgpu-hal/src/gles/device.rs", "third_party/rust/wgpu-hal/src/gles/mod.rs", "third_party/rust/wgpu-hal/src/lib.rs", "third_party/rust/wgpu-hal/src/metal/device.rs", "third_party/rust/wgpu-hal/src/vulkan/adapter.rs", "third_party/rust/wgpu-hal/src/vulkan/command.rs", "third_party/rust/wgpu-types/.cargo-checksum.json", "third_party/rust/wgpu-types/src/bitflags_array.rs", "third_party/rust/wgpu-types/src/error.rs", "third_party/rust/wgpu-types/src/features.rs", "third_party/rust/wgpu-types/src/lib.rs", "third_party/rust/wgpu-types/src/limits.rs", "third_party/rust/wgpu-types/src/surface.rs", "third_party/rust/wgpu-types/src/texture/external_texture.rs", "third_party/rust/wgpu-types/src/write_only.rs"], "git_node": "5e1c2c4a78b431f11846050c60f6a00c9a46c783", "git_parents": ["08120ffff4720f53fee6b3b94d0e468429c1da61"], "node": "2ef43fb5d0524baab3eee360dd26ac7d2ee60fff", "parents": ["36827e1b377d9cc670f1b283ad6e5422c549811d"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2081422 - disable AITab context menu triggers r=jlewis,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334772\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowMenu.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_menu_triggers.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_nimbus.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/content/tabgroup-menu.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "e0aa64ed1a2826b46fe6b0bcea813b351bdd67f1", "git_parents": ["5e1c2c4a78b431f11846050c60f6a00c9a46c783"], "node": "9f3604c321eaf6fe8cdf944aab45ee6dfcc0d5a5", "parents": ["2ef43fb5d0524baab3eee360dd26ac7d2ee60fff"], "tags": []}, {"author": "Seungmin Kim \u003cehfddr@gmail.com\u003e", "branch": "default", "desc": "Bug 2083702 - Paint I420 frames libwebrtc decodes itself in the color space they declare. r=webrtc-reviewers,pehrsons,gfx-reviewers,bradwerth\n\nMediaPipelineReceiveVideo painted every I420 frame as BT.601 limited. Map the\nmatrix, range, primaries and transfer function a frame declares in\nwebrtc::VideoFrame::color_space(), which libwebrtc fills from an AV1 sequence\nheader or a VP9 frame header, as gfxUtils maps them for the platform decoders.\nA frame that declares none stays BT.601 limited, as VP8 is by definition.\n\nSourceMediaTrack::AppendData becomes virtual so that the test can mock the\ntrack, and MockConduit becomes a template over the conduit class so that a mock\nVideoSessionConduit can extend it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335454\n", "files": ["dom/media/MediaTrackGraph.h", "dom/media/webrtc/transportbridge/MediaPipeline.cpp", "media/webrtc/signaling/gtest/MockConduit.h", "media/webrtc/signaling/gtest/mediapipeline_unittest.cpp"], "git_node": "b07104df94c17750ef83887c9781992d73b93d6f", "git_parents": ["e0aa64ed1a2826b46fe6b0bcea813b351bdd67f1"], "node": "93195db8df0a52e9218fd1a076f483e65bf