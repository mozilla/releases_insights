th CSP in WorkerLoadInfo. r=asuth,dom-worker-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331238\n", "files": ["dom/workers/ScriptLoader.cpp", "dom/workers/WorkerLoadInfo.cpp", "dom/workers/WorkerLoadInfo.h", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h", "dom/workers/loader/CacheLoadHandler.cpp", "dom/workers/loader/NetworkLoadHandler.cpp", "dom/workers/remoteworkers/RemoteWorkerChild.cpp"], "git_node": "a4aa2826b24a8afb8d82d928e0cd84a0de12a48f", "git_parents": ["64b4dec8e9be205967eb6a86c90c71a232b50ecb"], "node": "0cb36912cb8897f8f8a65ca735054f4a91b201d1", "parents": ["4ecab5afc1fca6aee38cfff0c0b92c6cedb9048a"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074818 - Replace WorkerPrivate::SetCsp with SetPolicyContainer. r=asuth,dom-worker-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331239\n", "files": ["dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h", "dom/workers/loader/CacheLoadHandler.cpp", "dom/workers/loader/NetworkLoadHandler.cpp"], "git_node": "7888ff27b68f8f865ea38b8e7c4bb98768b410cc", "git_parents": ["a4aa2826b24a8afb8d82d928e0cd84a0de12a48f"], "node": "0782dd2aa4d2d22661c0fc61cd5a930acde4e978", "parents": ["0cb36912cb8897f8f8a65ca735054f4a91b201d1"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074818 - Remove WorkerLoadInfo::mCSP. r=asuth,dom-worker-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331240\n", "files": ["dom/workers/WorkerLoadInfo.cpp", "dom/workers/WorkerLoadInfo.h", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h"], "git_node": "a471a565e9c80cda40f0c6ea543f296426f8cd6e", "git_parents": ["7888ff27b68f8f865ea38b8e7c4bb98768b410cc"], "node": "2c26a25d379cb3ae0367aaa060f3f63e60f93c44", "parents": ["0782dd2aa4d2d22661c0fc61cd5a930acde4e978"], "tags": []}, {"author": "Tom Schuste