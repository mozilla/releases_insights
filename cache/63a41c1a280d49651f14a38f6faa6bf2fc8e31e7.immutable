30126\n", "files": ["testing/web-platform/tests/content-security-policy/navigation/javascript-url-navigation-to-other-win-evaluated-to-string-inherits-csp.html", "testing/web-platform/tests/content-security-policy/navigation/javascript-url-navigation-to-popup-evaluated-to-string-inherits-csp.html", "testing/web-platform/tests/content-security-policy/navigation/support/utils.js"], "git_node": "a54ef7c492edc6834e82458249b02d94270bed62", "git_parents": ["397f23bd7891cc5c01c310a94998c51aba49535b"], "node": "3003384593f3a18027c6382f5829df71a61d1d96", "parents": ["9fbcaf02963b887f1e4e396cee2e933a474bd5d7"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079759 - Add a userContextId field to Places history visits and populate it r=places-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330688\n", "files": ["docshell/base/IHistory.h", "docshell/base/nsDocShell.cpp", "dom/base/PlacesVisit.h", "dom/chrome-webidl/PlacesEvent.webidl", "dom/ipc/BrowserParent.cpp", "mobile/shared/components/geckoview/GeckoViewHistory.cpp", "mobile/shared/components/geckoview/GeckoViewHistory.h", "toolkit/components/downloads/DownloadHistory.sys.mjs", "toolkit/components/downloads/test/unit/test_DownloadHistory.js", "toolkit/components/places/Database.cpp", "toolkit/components/places/Database.h", "toolkit/components/places/History.cpp", "toolkit/components/places/History.h", "toolkit/components/places/History.sys.mjs", "toolkit/components/places/PlacesUtils.sys.mjs", "toolkit/components/places/nsINavHistoryService.idl", "toolkit/components/places/nsPlacesTables.h", "toolkit/components/places/tests/browser/browser.toml", "toolkit/components/places/tests/browser/browser_visituri_userContextId.js", "toolkit/components/places/tests/gtest/places_test_harness.cpp", "toolkit/components/places/tests/gtest/test_IHistory.cpp", "toolkit/components/places/tests/history/test_insert_userContextId.js", "toolkit/components/places/tests/history/xpcshell.toml", "toolkit/components/places/tests/migration/places_v88.sqlite", "toolkit/components/places/tests/migration/test_current_from_v87.js", "toolkit/components/places/tests/migration/xpcshell.toml", "tools/@types/generated/lib.gecko.dom.d.ts"], "git_node": "2e0c562784871f23661e82a7c0c9b795bf7222a3", "git_parents": ["a54ef7c492edc6834e82458249b02d94270bed62"], "node": "f5f71c4223de3696f3dcdf9e6e7112eb2957f253", "parents": ["3003384593f3a18027c6382f5829df71a61d1d96"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082785 - [wptrunner] Set the Local Network Access address-space override prefs for Firefox. r=jgraham\n\nAll wptserve servers listen on 127.0.0.1, so without the overrides every\norigin is loopback and the LNA \"without permission\" tests cannot fail as\nexpected. Chrome already gets the equivalent through\n--ip-address-space-overrides. Gecko CI only passed thanks to hardcoded\nprefs in the LNA __dir__.ini, which upstream runs never apply.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334594\n", "files": ["testing/web-platform/meta/fetch/local-network-access/__dir__.ini", "testing/web-platform/meta/fetch/local-network-access/iframe-opener.tentative.https.html.ini", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py"], "git_node": "bc2fefa19c4666159fe5c84893836649a2169d3c", "git_parents": ["2e0c562784871f23661e82a7c0c9b795bf7222a3"], "node": "b808b6102aa6d6b71f92f2be0d5b980251776dac", "parents": ["f5f71c4223de3696f3dcdf9e6e7112eb2957f253"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082024 - Cache advances during STCH measurement pass. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335149\n", "files": ["gfx/harfbuzz/src/hb-ot-shaper-arabic.cc"], "git_node": "5bbda38c92792c970217b65781595d2488c55bb8", "git_parents": ["bc2fefa19c4666159fe5c84893836649a2169d3c"], "node": "f059c718b043a684cb1165b91e8e63d57a971135", "parents": ["b808b6102aa6d6b71f92f2be0d5b980251776dac"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082024 - Handle hb_scalar_cache_t value quantization. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335155\n", "files": ["gfx/harfbuzz/src/hb-ot-layout-common.hh", "gfx/harfbuzz/src/hb-ot-var-common.hh"], "git_node": "8c3c63eae6673d68e113f8eb3ea3b53f9275a1b6", "git_parents": ["5bbda38c92792c970217b65781595d2488c55bb8"], "node": "f2df65f3e6bf2a92b869b6468c14e2875afa2431", "parents": ["f059c718b043a684cb1165b91e8e63d57a971135"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083679 - Don't throw in the JSON view sniffer when the channel has no content type. r=devtools-reviewers,ochameau,jdescottes\n\nContent sniffers are also called for top level loads that failed before a\nresponse was received, where reading the content type throws, which logged an\nerror in the browser console for every such load.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335261\n", "files": ["devtools/client/jsonview/Sniffer.sys.mjs"], "git_node": "22c821f24b2805e51baf08a29cfbc758b1757520", "git_parents": ["8c3c63eae6673d68e113f8eb3ea3b53f9275a1b6"], "node": "c156d9071b0128d65401057dace1a0f24b2d024c", "parents": ["f2df65f3e6bf2a92b869b6468c14e2875afa2431"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073695 - Keep a strong context reference in WebGL extensions. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335235\n", "files": ["dom/canvas/ClientWebGLExtensions.cpp", "dom/canvas/ClientWebGLExtensions.h"], "git_node": "1aa2df8611c9c423870cb3dcef07053f793bbf6e", "git_parents": ["22c821f24b2805e51baf08a29cfbc758b1757520"], "node": "5bfc12f9a368b0f4f614a1c6ff95fec777bba6a6", "parents": ["c156d9071b0128d65401057dace1a0f24b2d024c"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079202 - Convert StartupPerformance to a class. r=sessionstore-reviewers,sclements\" for causing conflicts in backing out bug 2071519\n\nThis reverts commit 521b97c1f7ec22bf4200cfbb5f1be9a882e1abea.\n", "files": ["browser/components/sessionstore/StartupPerformance.sys.mjs"], "git_node": "dbde058eae5f455d4b905dee30fc22f27b2f6fd0", "git_parents": ["1aa2df8611c9c423870cb3dcef07053f793bbf6e"], "node": "5c8618d687f393980ea5ec36e918588a0cf4c67c", "parents": ["5bfc12f9a368b0f4f614a1c6ff95fec777bba6a6"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071519 - Always record the session_restore.number_of* counts and 0 window session restores. r=sessionstore-reviewers,sclements\" for causing marionette failures and was requested by dev to back it out.\n\nThis reverts commit 2730193fa33812c140d8cdf697246550169994bb.\n", "files": ["browser/components/sessionstore/StartupPerformance.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_restore_counts.py"], "git_node": "cb3e4516427b214e3dbfc11560f0bc516dfaa884", "git_parents": ["dbde058eae5f455d4b905dee30fc22f27b2f6fd0"], "node": "0ac27b096ed44762d8af48a789022332bd50d129", "parents": ["5c8618d687f393980ea5ec36e918588a0cf4c67c"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2064939 - disable browser_content_analysis_dnd_diff_origin.js also on Windows 32-bit opt. r=handyman\n\nWindows 64-bit had been already disabled in bug 1936521.\nThe failures on 32-bit started after the Windows worker images had been updated\nto version 1.0.7 in bug 2062626.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335095\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser.toml"], "git_node": "a3cbaa1e76b3ee34fb6ac547c5934250dcd80d9f", "git_parents": ["cb3e4516427b214e3dbfc11560f0bc516dfaa884"], "node": "c1c98781dfb54253b7c2bb5361ee1f7f67da7110", "parents": ["0ac27b096ed44762d8af48a789022332bd50d129"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1636088 - Allow attributing crashes to a test group. r=mozbase-reviewers,jgraham\n\nHarnesses don't always log crashes with a test ID that appears in\nsuite_start (e.g. reftest shortens \"a.html == b.html\" to \"a.html\", and\ncrashes can happen outside of any test), so the errorsummary formatter\ncan't map them to a group. Let callers pass the group explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335080\n", "files": ["testing/mozbase/mozcrash/mozcrash/mozcrash.py", "testing/mozbase/mozcrash/tests/test_basic.py", "testing/mozbase/mozlog/mozlog/formatters/errorsummary.py", "testing/mozbase/mozlog/mozlog/structuredlog.py", "testing/mozbase/mozlog/tests/test_errorsummary.py"], "git_node": "85287fba3f1dc16d6f2912b0fb66ecc7f0d2a890", "git_parents": ["a3cbaa1e76b3ee34fb6ac547c5934250dcd80d9f"], "node": "9887e4c8bf4095383fd041933868026ea6523601", "parents": ["c1c98781dfb54253b7c2bb5361ee1f7f67da7110"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083736 - [DevTools Release Tasks - Cycle 160] Update MDN compat data r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335178\n", "files": ["devtools/shared/compatibility/dataset/css-properties.json"], "git_node": "198fe4cc123f060bd5e83632be0d25aa1c37318f", "git_parents": ["85287fba3f1dc16d6f2912b0fb66ecc7f0d2a890"], "node": "f2552f257c644f296072cb7476da04cd8ddd2cca", "parents": ["9887e4c8bf4095383fd041933868026ea6523601"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079678 - Use inherited CERegistry for parser definition lookup r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334998\n", "files": ["parser/html/nsHtml5TreeOperation.cpp"], "git_node": "52906703a912b638d02013b25e46969fd00d796d", "git_parents": ["198fe4cc123f060bd5e83632be0d25aa1c37318f"], "node": "ffeaa59b1ff039afe9adfa06d3c43611952d2596", "parents": ["f2552f257c644f296072cb7476da04cd8ddd2cca"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083733. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335409\n", "files": ["layout/style/Loader.cpp", "testing/web-platform/tests/resource-timing/no-entries-for-cached-import-of-cross-origin-css.html", "testing/web-platform/tests/resource-timing/resources/cacheable-import-child.css", "testing/web-platform/tests/resource-timing/resources/cacheable-import-child.css.headers", "testing/web-platform/tests/resource-timing/resources/no-store-importer.sub.css", "testing/web-platform/tests/resource-timing/resources/no-store-importer.sub.css.headers"], "git_node": "ddce51fe1a43b0a442031ff6af4e41e9528aeec7", "git_parents": ["52906703a912b638d02013b25e46969fd00d796d"], "node": "514481d745caae4e4119ba3ce3e9b8aa4d2116ee", "parents": ["ffeaa59b1ff039afe9adfa06d3c43611952d2596"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079202 - Convert StartupPerformance to a class. r=sessionstore-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334455\n", "files": ["browser/components/sessionstore/StartupPerformance.sys.mjs"], "git_node": "6d051c3ba1629afea217a286fcf301783a6db8ce", "git_parents": ["ddce51fe1a43b0a442031ff6af4e41e9528aeec7"], "node": "b1a8f669189938f2ca43009e038b37a0975449e8", "parents": ["514481d745caae4e4119ba3ce3e9b8aa4d2116ee"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2082943 - Don't let queued per-window idle tasks keep closed browser windows alive. r=Gijs,firefox-desktop-core-reviewers\n\nBug 2052772 moved the per-window idle tasks from the window's requestIdleCallback to ChromeUtils.idleDispatch, whose pending runnables keep the window alive until they run. Go back to the window's idle queue, which is dropped when the window closes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334827\n", "files": ["browser/base/content/browser-init.js", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/browser/browser.toml", "toolkit/modules/tests/browser/browser_BrowserUtils_idle_window_leak.js", "toolkit/modules/tests/xpcshell/test_BrowserUtils_callModulesFromCategory.js"], "git_node": "8f6e6dbf32ab19ac687a8e0b8a5d0f50c8d389b7", "git_parents": ["6d051c3ba1629afea217a286fcf301783a6db8ce"], "node": "2ca60bd5a27a2cc5b1c08e4337c800908041c45c", "parents": ["b1a8f669189938f2ca43009e038b37a0975449e8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082044. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335387\n", "files": ["layout/style/nsDOMCSSAttrDeclaration.cpp", "layout/style/test/mochitest.toml", "layout/style/test/test_inline_style_cc.html"], "git_node": "4e3929ab47c84e2acc4387bd4c8c7cda5113d6cb", "git_parents": ["8f6e6dbf32ab19ac687a8e0b8a5d0f50c8d389b7"], "node": "d6955d1d1cc2f029f001e9a8007c6594f6110f8e", "parents": ["2ca60bd5a27a2cc5b1c08e4337c800908041c45c"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081864 - [devtools] Add basic styling to the new settings panel r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333764\n", "files": ["devtools/client/settings/components/devtools-settings.css", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html"], "git_node": "ef9e423eeb126c7a4203d2070c1c64d666203adf", "git_parents": ["4e3929ab47c84e2acc4387bd4c8c7cda5113d6cb"], "node": "b15a4fb7c815fb6f0a5a183a859f612caed0f8ca", "parents": ["d6955d1d1cc2f029f001e9a8007c6594f6110f8e"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081745 - [devtools] Add tagmaps for the new settings panel components r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333653\n", "files": ["devtools/client/settings/components/devtools-settings-pref.mjs", "devtools/client/settings/components/devtools-settings-pref.tagmap.d.ts", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/components/devtools-settings.tagmap.d.ts"], "git_node": "58692636f104358f9d0734cb82f255ce49bbe1d0", "git_parents": ["ef9e423eeb126c7a4203d2070c1c64d666203adf"], "node": "0837713c96a4c08d73760d2fb240c78671405159", "parents": ["b15a4fb7c815fb6f0a5a183a859f612caed0f8ca"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083820 - Enable building the fontations code in Nightly builds. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335331\n", "files": ["toolkit/moz.configure"], "git_node": "76d1b935ad7aa029786f2fe1fc4a87c60afc5268", "git_parents": ["58692636f104358f9d0734cb82f255ce49bbe1d0"], "node": "040f239a5e2a18a573717614dd929f3b0c439efb", "parents": ["0837713c96a4c08d73760d2fb240c78671405159"], "tags": []}, {"author": "vertpierre \u003c74794864+vertpierre@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071993 [wpt PR 62681] - [WebCryptoAPI] Add fixed-length OKP import coverage, a=testonly\n\nAutomatic update from web-platform-tests\n[WebCryptoAPI] Add fixed-length OKP import coverage (#62681)\n\n* Add fixed-length OKP import coverage\n\n* Separate OKP key preservation from signature encoding\n\n* Test invalid Ed25519 and X25519 SPKI key widths\n--\n\nwpt-commits: 245f4eb92d858312bafe5f761b10a626f338dd3a\nwpt-pr: 62681\n", "files": ["testing/web-platform/tests/WebCryptoAPI/import_export/okp_fixed_length.https.any.js", "testing/web-platform/tests/WebCryptoAPI/import_export/okp_malformed_asn1.https.any.js"], "git_node": "a7c4d6c79ec28ac77dad957d225c3bce40fa423e", "git_parents": ["76d1b935ad7aa029786f2fe1fc4a87c60afc5268"], "node": "865aa1ec978d2672a4db173f357f2d7ff9b9b418", "parents": ["040f239a5e2a18a573717614dd929f3b0c439efb"], "tags": []}, {"author": "Alex Flom \u003calexander.flom@gmail.com\u003e", "branch": "default", "desc": "Bug 2080393 [wpt PR 63475] - WebCryptoAPI: detach verification buffers once during algorithm normalization, a=testonly\n\nAutomatic update from web-platform-tests\n[WebCryptoAPI] Detach verification buffers once during algorithm normalization (#63475)\n\nCo-authored-by: Daniel Huigens \u003cd.huigens@protonmail.com\u003e\n--\n\nwpt-commits: 37260931105fff57b17bbb80d15fd44b1eb3b930\nwpt-pr: 63475\n", "files": ["testing/web-platform/tests/WebCryptoAPI/digest/digest.js", "testing/web-platform/tests/WebCryptoAPI/encrypt_decrypt/aes.js", "testing/web-platform/tests/WebCryptoAPI/encrypt_decrypt/rsa.js", "testing/web-platform/tests/WebCryptoAPI/modern-algos/digest/xof_digest.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/mac.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/signature.js"], "git_node": "dcc702b70117e63dd7a7cc08d13bf3fee6203fac", "git_parents": ["a7c4d6c79ec28ac77dad957d225c3bce40fa423e"], "node": "f4eaac64e513872059fe8de4b93a2d12313ab42d", "parents": ["865aa1ec978d2672a4db173f357f2d7ff9b9b418"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080393 [wpt PR 63475] - Update wpt metadata, a=testonly\n\nwpt-pr: 63475\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/WebCryptoAPI/encrypt_decrypt/aes_cbc.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/encrypt_decrypt/aes_ctr.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/encrypt_decrypt/aes_gcm.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/encrypt_decrypt/aes_gcm_256_iv.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/encrypt_decrypt/rsa_oaep.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/modern-algos/digest/sha3.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/modern-algos/encrypt_decrypt/aes_ocb.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/modern-algos/sign_verify/kmac.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/sign_verify/ecdsa.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/sign_verify/rsa_pss.https.any.js.ini"], "git_node": "96ad139b8a50be31db4f393bc83538aeb0f7fb08", "git_parents": ["dcc702b70117e63dd7a7cc08d13bf3fee6203fac"], "node": "ecfc3b61f11afc7bb0fc3f8652dbc4c77ea4c056", "parents": ["f4eaac64e513872059fe8de4b93a2d12313ab42d"], "tags": []}, {"author": "Stalgia Grigg \u003cstalgiag@igalia.com\u003e", "branch": "default", "desc": "Bug 2077433 [wpt PR 62882] - Fetch: make the bad port test observe blocked requests, a=testonly\n\nAutomatic update from web-platform-tests\nFetch: make the bad port test observe blocked requests (#62882)\n\n`request-bad-port.any.js` passes whether or not a port is blocked. Nothing listens on those ports and a refused connection also rejects with a TypeError.\n\nThis routes the fetches through `/common/proxy-all.sub.pac`, so a request that isn't blocked reaches wptserve and resolves. The host is a made-up name that only resolves through the proxy, the requests are no-cors so a CORS failure can't pass the test, and a control test confirms that a port that isn't bad succeeds. Service workers had to be dropped since they run over https, where these requests would fail as mixed content.\n--\n\nwpt-commits: d64eb89a3b867d3700938e5fc99bb1a9bd7e9f2a\nwpt-pr: 62882\n", "files": ["testing/web-platform/tests/fetch/api/request/request-bad-port.any.js", "testing/web-platform/tests/tools/lint/lint.py"], "git_node": "d9069f4731b0bcb2ba76fce2c4923c33497bd857", "git_parents": ["96ad139b8a50be31db4f393bc83538aeb0f7fb08"], "node": "3c2617f7b2257de660b7a244862d216acb2b517d", "parents": ["ecfc3b61f11afc7bb0fc3f8652dbc4c77ea4c056"], "tags": []}, {"author": "Simon Pieters \u003czcorpan@gmail.com\u003e", "branch": "default", "desc": "Bug 2079489 [wpt PR 63347] - Don't expect `error` at a removed media `source` candidate, a=testonly\n\nAutomatic update from web-platform-tests\nDon't expect `error` at a removed media `source` candidate\n\nSee https://github.com/whatwg/html/issues/12986. Also wait for the candidate to be selected before removing or moving it.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n\n--\n\nwpt-commits: 98942b887eb3436f38fac410ee5548148334b7bf\nwpt-pr: 63347\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-candidate-moved.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-candidate-remove-addEventListener.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-candidate-remove-onerror.html"], "git_node": "c81ef0ef8a562a5a97b2c57aa00d8bcda5c001c0", "git_parents": ["d9069f4731b0bcb2ba76fce2c4923c33497bd857"], "node": "b1b4568bbbd8ba7ecafb39ccab3b4f4157d5183f", "parents": ["3c2617f7b2257de660b7a244862d216acb2b517d"], "tags": []}, {"author": "Servo WPT Sync \u003c32481905+servo-wpt-sync@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071949 [wpt PR 62673] - script: Update radio group when checked radio button joins by changing form owner, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Update radio group when checked radio button joins by changing form owner (#62673)\n\nPreviously, radio buttons did not get unchecked when a checked radio button joined the group after the form owner changed. Now we properly broadcast this circumstance, so that the other radio buttons get unchecked.\n\nTesting: Added a new web platform test.\n\nReviewed in servo/servo#48069\n\nSigned-off-by: Glenn Skrzypczak \u003cglennskyzl@gmail.com\u003e\nCo-authored-by: Glenn Skrzypczak \u003cglenn.skrzypczak@gmail.com\u003e\nCo-authored-by: Glenn Skrzypczak \u003cglennskyzl@gmail.com\u003e\nCo-authored-by: Martin Robinson \u003cmartin@abandonedwig.info\u003e\n--\n\nwpt-commits: 530f51637f7c9827b3163fb2b9f4c222717942b0\nwpt-pr: 62673\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-input-element/radio-form-owner.html"], "git_node": "33d145d0732792ed2b6461ff98d3f48a145ebbe7", "git_parents": ["c81ef0ef8a562a5a97b2c57aa00d8bcda5c001c0"], "node": "152418ddc2a2eb87106c11f1c8a607d48bca193c", "parents": ["b1b4568bbbd8ba7ecafb39ccab3b4f4157d5183f"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2054284 [wpt PR 61232] - Cloning a document copies its base URL, a=testonly\n\nAutomatic update from web-platform-tests\nCloning a document copies its base URL\n\nAdd tests for a document's base URL after cloneNode(), covering that a\nclone copies the source's computed base URL: a deep clone carries the\n\u003cbase\u003e element, while a shallow clone (which has no \u003cbase\u003e) reports the\nsame base URL via the copied override. Also covers documents without a\n\u003cbase\u003e, createHTMLDocument(), about:blank base URL inheritance, XML/XHTML\n(no xml:base), blob: URLs, snapshot independence from later source\nmutation, durability across clone mutation, and an inserted \u003cbase\u003e taking\nprecedence over the copied base URL.\n\nFor https://github.com/whatwg/dom/issues/454\n--\n\nwpt-commits: 485329511d744931f027fa477cd0e072b663d7c9\nwpt-pr: 61232\n", "files": ["testing/web-platform/tests/dom/nodes/Document-cloneNode-about-base-url.window.js", "testing/web-platform/tests/dom/nodes/Document-cloneNode-base-url-xml.window.js", "testing/web-platform/tests/dom/nodes/Document-cloneNode-base-url.window.js"], "git_node": "5cd46fc0653e3f0b903f76ff863dda090e0709a8", "git_parents": ["33d145d0732792ed2b6461ff98d3f48a145ebbe7"], "node": "fd281871282c8c875cb79f23d8f35fedbdbcb2b6", "parents": ["152418ddc2a2eb87106c11f1c8a607d48bca193c"], "tags": []}, {"author": "Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e", "branch": "default", "desc": "Bug 2075366 [wpt PR 62939] - wdspec: Should not dispatch mousemove if already at target, a=testonly\n\nAutomatic update from web-platform-tests\npointer_mouse.py: Should not have mousemove event if already at target\n\nSigned-off-by: Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e\n\n--\n\nwpt-commits: c596c3bcd21b9a104ce299c6a933f705c3aec543\nwpt-pr: 62939\n", "files": ["testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_mouse.py"], "git_node": "c72148fe2065149e05e03d38a5df8590a158e340", "git_parents": ["5cd46fc0653e3f0b903f76ff863dda090e0709a8"], "node": "b752f02154729a2170e1585031c5cb9d200b48e0", "parents": ["fd281871282c8c875cb79f23d8f35fedbdbcb2b6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075366 [wpt PR 62939] - Update wpt metadata, a=testonly\n\nwpt-pr: 62939\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse.py.ini"], "git_node": "cbfbe80bd00bf1608c473064fd30f4527bf53940", "git_parents": ["c72148fe2065149e05e03d38a5df8590a158e340"], "node": "004e7df86bd5161c035434b92100ba59b2e38092", "parents": ["b752f02154729a2170e1585031c5cb9d200b48e0"], "tags": []}, {"author": "Wonik Choi \u003cchoiwonik91@gmail.com\u003e", "branch": "default", "desc": "Bug 2081177 [wpt PR 63590] - [textdecoder] Clear JIS0212 state on EUC-JP errors, a=testonly\n\nAutomatic update from web-platform-tests\n[textdecoder] Clear JIS0212 state on EUC-JP errors\n\nAn invalid third byte in a JIS0212 sequence leaves the table selection\nset, causing subsequent JIS0208 pairs in the same decoding session to\nuse the wrong mapping.\n\nClear the selection on the error path before processing the next byte.\nKeep codec reuse and the existing end-of-input reset.\n\nBug: 467624168\nChange-Id: I833333a1b14463a5631c4833f33f4cf09915f9cd\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8536386\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nReviewed-by: Adam Rice \u003cricea@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717360}\n\n--\n\nwpt-commits: 51a3177fe0cdf3777c84a909d249abc7ea9ddcf9\nwpt-pr: 63590\n", "files": ["testing/web-platform/tests/encoding/textdecoder-mistakes.any.js"], "git_node": "f97c8718a2a4d4985b561aaf8ed9fd0b11f698bb", "git_parents": ["cbfbe80bd00bf1608c473064fd30f4527bf53940"], "node": "e222da34836f5a0f4cc55a737d22f6a952ef649b", "parents": ["004e7df86bd5161c035434b92100ba59b2e38092"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081177 [wpt PR 63590] - Update wpt metadata, a=testonly\n\nwpt-pr: 63590\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/encoding/textdecoder-mistakes.any.js.ini"], "git_node": "619d4000adcc74a8bb3a123870fbc156c6406060", "git_parents": ["f97c8718a2a4d4985b561aaf8ed9fd0b11f698bb"], "node": "78e225d665253694295e750f255185db99ad6a30", "parents": ["e222da34836f5a0f4cc55a737d22f6a952ef649b"], "tags": []}, {"author": "Liang Zhao - MSFT \u003cliang.zhao@microsoft.com\u003e", "branch": "default", "desc": "Bug 2076946 [wpt PR 63122] - Add WebSocket-over-HTTP/3 server support, a=testonly\n\nAutomatic update from web-platform-tests\nAdd WebSocket-over-HTTP/3 server support (#63122)\n\n* Add WebSocket-over-HTTP/3 server support\n\n* Harden WebSocket over HTTP/3 server concurrency and lifecycle\n\nRun blocking handlers off the QUIC event loop, bound and cancel incoming stream buffers, drain in-flight work on shutdown, and preserve WPT header and authentication behavior.\n\nCo-authored-by: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\n\n* Make WebSocket H3 resource limits explicit and configurable\n\nRemove the arbitrary active-session cap; expose per-connection work limits and the per-stream unread-byte limit to callers with consistent names and targeted tests.\n\nCo-authored-by: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\n\n* Fix WebSocket H3 server type checking\n\nAnnotate worker tasks and buffered handshake data and assert required HTTP/3 adapters before use.\n\nCo-authored-by: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\n\n* Handle cookie headers correctly and queue requests when limits hits\n\n* Copy response header directly so that it can handle set-cookie headers better, and remove test dependency on handlers\n\n---------\n\nCo-authored-by: Mayur Patil \u003cpatilmayur@microsoft.com\u003e\nCo-authored-by: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\n--\n\nwpt-commits: 0622a8f533e946f9aeed8aa857b1eccf6606c0a5\nwpt-pr: 63122\n", "files": ["testing/web-platform/tests/tools/websocket/h3/h3_wptserve_adapter.py", "testing/web-platform/tests/tools/websocket/h3/headers.py", "testing/web-platform/tests/tools/websocket/h3/tests/test_headers.py", "testing/web-platform/tests/tools/websocket/h3/tests/test_websocket_h3_server.py", "testing/web-platform/tests/tools/websocket/h3/tests/test_ws_h3_handshake.py", "testing/web-platform/tests/tools/websocket/h3/websocket_h3_server.py", "testing/web-platform/tests/tools/websocket/h3/websocket_h3_session.py", "testing/web-platform/tests/tools/websocket/h3/ws_h3_handshake.py", "testing/web-platform/tests/tools/websocket/requirements.txt", "testing/web-platform/tests/websockets/handlers/basic_auth_wsh.py"], "git_node": "3db2bc865a77bd95fe0fbb66c393dda82bad4efc", "git_parents": ["619d4000adcc74a8bb3a123870fbc156c6406060"], "node": "2a6c16fa850521dc05f1c7518ff3279de5079ea1", "parents": ["78e225d665253694295e750f255185db99ad6a30"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2080688 [wpt PR 63543] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327156, a=testonly\n\nAutomatic update from web-platform-tests\nImplement [SameAgentCluster] for WebCodecs objects and MediaStreamTrack\n\nhttps://github.com/whatwg/html/pull/13055 adds the [SameAgentCluster]\nextended attribute: serializing or transferring an object implementing\nsuch an interface restricts the result to the agent cluster it came from,\ndeserializing it in another agent cluster throws a DataCloneError, and\nserializing it for storage throws as well. This is what\nhttps://github.com/w3c/webcodecs/issues/717 needs for EncodedVideoChunk,\nVideoFrame, EncodedAudioChunk, and AudioData, and what the WebCodecs\ncrossAgentCluster tests already expect. MediaStreamTrack and\nMediaStreamTrackHandle are transferred the same way, so restrict them\ntoo.\n\nThe bindings generator now emits isRestrictedToSameAgentCluster for\n[Serializable] and [Transferable] interfaces. SerializedScriptValue maps\neach serialization tag to the PlatformObjectSerializationTraits of its\ninterface in one place, platformObjectSerializationTraitsForTag(), which\nboth the exposure check and the new isTagRestrictedToSameAgentCluster()\nuse. When CloneSerializer writes a restricted tag it writes the agent\ncluster ID after it, as JSC already does for SharedArrayBuffer, and\nCloneDeserializer checks that ID before reading the object. All of these\nobjects already refuse to be serialized for storage, before their tag is\nwritten.\n\nThe existing tests only cover the video types, so add tests for\nAudioData, EncodedAudioChunk, MediaStreamTrack, and\nMediaStreamTrackHandle.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327156\n\n--\n\nwpt-commits: 9243789527cfc5d578568816bc9d2bebb9b3ade6\nwpt-pr: 63543\n", "files": ["testing/web-platform/tests/mediacapture-insertable-streams/MediaStreamTrackHandle-transfer-cross-agent-cluster.https.html", "testing/web-platform/tests/mediacapture-streams/MediaStreamTrack-transfer-cross-agent-cluster.https.html", "testing/web-platform/tests/mediacapture-streams/resources/cross-agent-cluster-receiver.html", "testing/web-platform/tests/webcodecs/audio-serialization.crossAgentCluster.helper.html", "testing/web-platform/tests/webcodecs/audio-serialization.crossAgentCluster.https.html"], "git_node": "6135b31f45110ee71a95b6d8000016acb15a046e", "git_parents": ["3db2bc865a77bd95fe0fbb66c393dda82bad4efc"], "node": "45b3769e893d6a898005608d7b9d681916839b05", "parents": ["2a6c16fa850521dc05f1c7518ff3279de5079ea1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080688 [wpt PR 63543] - Update wpt metadata, a=testonly\n\nwpt-pr: 63543\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/mediacapture-insertable-streams/MediaStreamTrackHandle-transfer-cross-agent-cluster.https.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-transfer-cross-agent-cluster.https.html.ini"], "git_node": "48c049beeae032c7cb854d4af9e9e451841e4dc7", "git_parents": ["6135b31f45110ee71a95b6d8000016acb15a046e"], "node": "c8149cb2fa9def4ad438775c270207b507b789af", "parents": ["45b3769e893d6a898005608d7b9d681916839b05"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080928 [wpt PR 63566] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327236, a=testonly\n\nAutomatic update from web-platform-tests\ncopyTo for a BGRX/RGBX VideoFrame should succeed (#63566)\n\nWe add support for copyTo by reusing the same code path for BGRX as BGRA and RGBX/RGBA.\nThe WPT test is not fully complete as it should check the copyT X component.\nThis will be added when the spec is clear about what should be done.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327236\n--\n\nwpt-commits: 1230960cbe40b7f78d762f3ade4c118ec2bbfa83\nwpt-pr: 63566\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-copyTo-rgbx.any.js"], "git_node": "fdb771328b0eb6df0edf3728d1d67744a8dbd815", "git_parents": ["48c049beeae032c7cb854d4af9e9e451841e4dc7"], "node": "bb7a19d4cf7c2c3aa610867b3a5b79be17cfd964", "parents": ["c8149cb2fa9def4ad438775c270207b507b789af"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2077988 [wpt PR 62674] - Test \u003cbutton\u003e in \u003cselect\u003e with appearance:auto, a=testonly\n\nAutomatic update from web-platform-tests\nTest \u003cbutton\u003e in \u003cselect\u003e with appearance:auto\n\nFor https://github.com/whatwg/html/issues/12474\n\n--\n\nwpt-commits: 83cc6bfac4b280a126f091e6578cd5971a2e2653\nwpt-pr: 62674\n", "files": ["testing/web-platform/tests/html/rendering/widgets/the-select-element/select-label-appearance-ref.html", "testing/web-platform/tests/html/rendering/widgets/the-select-element/select-label-appearance.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-appearance-auto-button-mutation-ref.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-appearance-auto-button-mutation.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-appearance-auto-button-ref.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-appearance-auto-button.html"], "git_node": "784552cea1562bffd2d4d59f10d8ccb4665e3b86", "git_parents": ["fdb771328b0eb6df0edf3728d1d67744a8dbd815"], "node": "8fdb08ec2234101477d114f325e20856958cf738", "parents": ["bb7a19d4cf7c2c3aa610867b3a5b79be17cfd964"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077988 [wpt PR 62674] - Update wpt metadata, a=testonly\n\nwpt-pr: 62674\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/rendering/widgets/the-select-element/select-label-appearance.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-appearance-auto-button-mutation.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-appearance-auto-button.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-appearance-disabled.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-base-appearance-writing-modes.html.ini"], "git_node": "e26167733efeb63ee9a3078537d70941bb233a9e", "git_parents": ["784552cea1562bffd2d4d59f10d8ccb4665e3b86"], "node": "cf0f5be1f202442b452fb1f24fd1656f70801340", "parents": ["8fdb08ec2234101477d114f325e20856958cf738"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2081295 [wpt PR 63594] - [BiDi] Add WPT tests for emulation.setTextLayoutModeOverride, a=testonly\n\nAutomatic update from web-platform-tests\n[BiDi] Add WPT tests for emulation.setTextLayoutModeOverride\n\nAdd Web Platform Tests for the WebDriver BiDi\n`emulation.setTextLayoutModeOverride` command covering:\n- `text_layout_mode`: setting `\"mobile\"` and resetting with `None`.\n- `contexts`: browsing context scoping, isolation across contexts, and\n  precedence over `user_contexts` and global overrides.\n- `user_contexts`: user context scoping, isolation, persistence across\n  new tabs, and precedence over global overrides.\n- `global`: global override application and reset.\n- `invalid`: parameter validation for `contexts`, `user_contexts`,\n  mutually exclusive scope parameters, and `text_layout_mode`.\n\nBug: 470320065\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,mac-webdriver-bidi-rel,win-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: Ie74e648086971ab99d499e2d5a98cdb9897ae19e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8546833\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717475}\n\n--\n\nwpt-commits: 3a5f3aec88ad9b57014baa332916d448f583ce5c\nwpt-pr: 63594\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/emulation/set_text_layout_mode_override/__init__.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_text_layout_mode_override/conftest.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_text_layout_mode_override/contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_text_layout_mode_override/global.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_text_layout_mode_override/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_text_layout_mode_override/text_layout_mode.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_text_layout_mode_override/user_contexts.py"], "git_node": "155837a917aae49f1ee729f029e616f657898c83", "git_parents": ["e26167733efeb63ee9a3078537d70941bb233a9e"], "node": "2bae602a489d6410670d9d661a73d42a54ae2596", "parents": ["cf0f5be1f202442b452fb1f24fd1656f70801340"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081295 [wpt PR 63594] - Update wpt metadata, a=testonly\n\nwpt-pr: 63594\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/emulation/set_text_layout_mode_override/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_text_layout_mode_override/global.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_text_layout_mode_override/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_text_layout_mode_override/text_layout_mode.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_text_layout_mode_override/user_contexts.py.ini"], "git_node": "548c55625ddb11ac43b1c2f3f24dc07d2b801a19", "git_parents": ["155837a917aae49f1ee729f029e616f657898c83"], "node": "e6501e3f290e9d98826174c797693eeb074638fe", "parents": ["2bae602a489d6410670d9d661a73d42a54ae2596"], "tags": []}, {"author": "Felipe Piubello \u003cpiubellofelipe97@gmail.com\u003e", "branch": "default", "desc": "Bug 2081321 [wpt PR 63598] - [chromium-bidi] Preserve default SameSite cookie semantics, a=testonly\n\nAutomatic update from web-platform-tests\n[chromium-bidi] Preserve default SameSite cookie semantics\n\nWebDriver BiDi distinguishes cookies without an explicit SameSite\nattribute from cookies explicitly marked None, Lax, or Strict.\n\nPreserve that distinction when serializing CDP cookies to BiDi and when\nconverting BiDi cookie parameters to CDP. Add mapper unit coverage and\nfocused WPT coverage, and remove expectations for the now-passing cases.\n\nRequire the same-origin request cookies in the network E2E instead of\naccepting an empty list. Expect default for the implicit cookie and keep\nan explicit SameSite=None; Secure control. Cover Default/None deletion\nfilters in both directions.\n\nBug: 557097759\nFixed: 560328170\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I0939551a5108f1a4506f6d9a5b89aa961e63d9fa\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8353750\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nReviewed-by: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717504}\n\n--\n\nwpt-commits: 0b250e1df33eeab5c4812b83341be6a1a3a5d4b9\nwpt-pr: 63598\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/storage/delete_cookies/filter.py"], "git_node": "886618d77a110cbc648eded9cf8ccf5d4b7654d0", "git_parents": ["548c55625ddb11ac43b1c2f3f24dc07d2b801a19"], "node": "baf751edc4852ff70152406c45339515dae3a390", "parents": ["e6501e3f290e9d98826174c797693eeb074638fe"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2081349 [wpt PR 63602] - Reland \"Fix script scheduling, style blocking, and abort cleanup for HTMLStream\", a=testonly\n\nAutomatic update from web-platform-tests\nReland \"Fix script scheduling, style blocking, and abort cleanup for HTMLStream\"\n\nThis is a reland of commit f19d15d649bb5bb0f4b2359e5537eb37ce5957cf\n\nFix flaky failure in stream-html-defer-async-script.html on Debug bots\nby wiring `window.on_slow` and awaiting `window.slow_async.promise` in\nthe `async scripts do not block parsing and run in load order` subtest\nso that `slow.js` does not finish during the subsequent abort subtest\nand pollute `window.events`.\n\nOriginal change's description:\n\u003e Fix script scheduling, style blocking, and abort cleanup for HTMLStream\n\u003e\n\u003e Align HTMLDocumentParser, HTMLTreeBuilder, HTMLParserScriptRunner,\n\u003e ScriptLoader, and PendingScript with the WHATWG HTML spec for\n\u003e streaming fragment parsers:\n\u003e - Do not block streamed inline, parser-blocking, or defer scripts on\n\u003e   script-blocking stylesheets in the live target document.\n\u003e - Keep classic non-async, non-defer external scripts parser-blocking\n\u003e   (kParserBlocking) for the stream, and yield to the event loop before\n\u003e   executing deferred/module scripts at close().\n\u003e - Flush pending text (including kTextMode) at the end of each chunk and\n\u003e   before StopParsing(), so written text is in the DOM when write()\n\u003e   resolves and no text is left buffered in HTMLConstructionSite when a\n\u003e   writer is dropped, aborted, or its write() rejects.\n\u003e - On StopParsing() / Detach() for fragment parsers (\"abort a parser\",\n\u003e   fragment case), mark open \u003cscript\u003e elements already-started, pop all\n\u003e   open elements so elements like \u003cstyle\u003e finish parsing children, and\n\u003e   cancel pending parser-blocking and deferred scripts, which also\n\u003e   unblocks rendering on them.\n\u003e - At EOF in the \"text\" insertion mode, mark an unclosed \u003cscript\u003e\n\u003e   already-started for fragment parsers, so it never runs even if it is\n\u003e   later connected. The same step for the main document parser is a\n\u003e   web-visible behavior change (an unclosed \u003cscript src\u003e at EOF currently\n\u003e   executes) and is left for a separate, flagged CL (see TODO).\n\u003e\n\u003e WPT coverage includes parser-blocking/defer/async script scheduling,\n\u003e abort unblocking rendering, bare text inserted before close(), and an\n\u003e unclosed \u003cscript\u003e at close() being marked already-started. The\n\u003e parser-blocking script tests depend on the displaced reference node\n\u003e handling in crrev.com/c/8498307, which this CL is based on.\n\u003e\n\u003e Bug: 491743369\n\u003e Fixed: 568820698\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8498308\n\u003e Commit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\n\u003e Reviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1716037}\n\nBug: 491743369, 572938271\nChange-Id: I26da393c542f3ae88c75e1a287f6da403b9913ea\nFixed: 568820698\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8569537\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Philip J\u00e4genstedt \u003cfoolip@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717520}\n\n--\n\nwpt-commits: d80fedd035bb0b03e1226efb30eebec73914d1c0\nwpt-pr: 63602\n", "files": ["testing/web-platform/tests/domparsing/tentative/resources/slow.css", "testing/web-platform/tests/domparsing/tentative/stream-html-defer-async-script.html", "testing/web-platform/tests/domparsing/tentative/stream-html-parser-blocking-script.html", "testing/web-platform/tests/domparsing/tentative/stream-html-run-scripts-option.html"], "git_node": "77750aa6d0fefa68f38e62a12d63b830cfd938b7", "git_parents": ["886618d77a110cbc648eded9cf8ccf5d4b7654d0"], "node": "d62a08ce34d236278fe11c0f3ddcbe5d51ecc744", "parents": ["baf751edc4852ff70152406c45339515dae3a390"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081349 [wpt PR 63602] - Update wpt metadata, a=testonly\n\nwpt-pr: 63602\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-html-defer-async-script.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-parser-blocking-script.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-run-scripts-option.html.ini"], "git_node": "880839c65a13a78d9ae11009a45ac22d4ca2f1a0", "git_parents": ["77750aa6d0fefa68f38e62a12d63b830cfd938b7"], "node": "1cd417536c6edfd9251095eb8b0db4cb7cec0436", "parents": ["d62a08ce34d236278fe11c0f3ddcbe5d51ecc744"], "tags": []}, {"author": "Dana Estra \u003c43855550+danae404@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075866 [wpt PR 62990] - Update WebVTT tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate WebVTT tests based on changes approved in WebVTT Interop investigation meetings. (#62990)\n--\n\nwpt-commits: 6dcecaab61b33a51e04f49be43941461808193cc\nwpt-pr: 62990\n", "files": ["testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/decode_escaped_entities-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/decode_escaped_entities.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/disable_controls_reposition-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/disable_controls_reposition.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_align_position_line_size-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_align_position_line_size.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_align_position_line_size_while_paused-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_align_position_line_size_while_paused.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_line-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_line.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_text-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_text.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_text_while_paused-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_text_while_paused.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_remove_cue_while_paused-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/dom_override_remove_cue_while_paused.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/embedded_style_cascade_priority-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/embedded_style_cascade_priority.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/embedded_style_cascade_priority_layer.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/embedded_style_imports_blocked-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/embedded_style_imports_blocked.html"], "git_node": "b111f66b04808680d162fed4e2a6d209a4064982", "git_parents": ["880839c65a13a78d9ae11009a45ac22d4ca2f1a0"], "node": "6f829aa4d32912dac04ba75054d54bc87b08c202", "parents": ["1cd417536c6edfd9251095eb8b0db4cb7cec0436"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075866 [wpt PR 62990] - Update wpt metadata, a=testonly\n\nwpt-pr: 62990\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_text.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_text_while_paused.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/dom_override_remove_cue_while_paused.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/embedded_style_imports_blocked.html.ini"], "git_node": "c494331ac6721b163c5c0b4707ffdf9ef8d24c3a", "git_parents": ["b111f66b04808680d162fed4e2a6d209a4064982"], "node": "56f5d0afe4e8527cb96fc0fd26b90bce8cd1f830", "parents": ["6f829aa4d32912dac04ba75054d54bc87b08c202"], "tags": []}, {"author": "Noam Rosenthal \u003cnoamr@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071492 [wpt PR 62492] - Additional sanitizer tests for streaming sanitizer, a=testonly\n\nAutomatic update from web-platform-tests\nAdditional sanitizer tests for streaming sanitizer\n\nSee whatwg/html#12756\n\n- Duplicate `\u003chtml\u003e`/`\u003cbody\u003e` start tags: attribute sanitization, non-overwriting merge behavior, and element-specific attribute rules in `Document.parseHTML()`, `Document.parseHTMLUnsafe()`, and fragment parsing.\n- Raw text and RCDATA tokenizer state: `replaceWithChildrenElements` on `\u003cscript\u003e`, `\u003cstyle\u003e`, `\u003ctextarea\u003e`, `\u003ctitle\u003e` (with entity decoding), and `\u003cplaintext\u003e` produces a single raw `Text` node rather than parsed child elements; `removeElements` on `\u003cxmp\u003e` drops its text.\n- Top-level `\u003ctemplate\u003e` and `\u003cscript\u003e` in `setHTMLUnsafe()`: content preservation, declarative shadow root non-attachment to the fragment host, and execution gating.\n- Adoption agency algorithm with `replaceWithChildrenElements`/`removeElements`: the insertion target redirection following a replaced `furthestBlock` or clone into the innermost non-replaced clone, the outer loop reaching its limit, a table as `commonAncestor` (foster parenting of `lastNode`), the formatting element itself removed or replaced (including chained through a replaced `furthestBlock`), Remove clones above Keep clones, a removed `furthestBlock` in a later iteration, a removed non-formatting element in the inner loop, and the `\u003ca\u003e` special case.\n- Active formatting elements: reconstructed clones are sanitized (replaced, removed, and attribute-stripped), and Noah's Ark compares the token's attributes rather than the sanitized ones.\n- Foster parenting: content of a foster-parented replaced element follows its foster location; content foster-parented after a replaced `\u003ctable\u003e`'s children were hoisted lands after them; removed `\u003ctable\u003e`/`\u003ctr\u003e` and replaced `\u003ctr\u003e` with foster-parented text; a replaced `\u003ctemplate\u003e` inside a table keeps its contents out of the tree; a replaced `\u003ctable\u003e` inside template contents; comments redirected through a replaced `\u003ctable\u003e` and inside template contents; a `tr` fragment context with a replaced `\u003ctd\u003e`.\n- `Document.parseHTML()`/`parseHTMLUnsafe()`: document-level comments and processing instructions are dropped when disallowed, `parseHTMLUnsafe()` without options keeps comments, `\u003ctemplate\u003e` in `replaceWithChildrenElements` drops its contents, `\u003cnoscript\u003e` parses with scripting disabled, and `\u003chead\u003e`/`\u003cbody\u003e` replaced with children.\n- `setHTML()`/`setHTMLUnsafe()` parse `\u003cnoscript\u003e` as raw text regardless of the options passed.\n- Declarative shadow roots: a `\u003ctemplate\u003e` in `replaceWithChildrenElements` creates no shadow root and drops its contents; a replaced or removed host doesn't pass its shadow root on to the parent.\n- Custom elements: no constructor runs for elements in `replaceWithChildrenElements`, allowed elements upgrade before `setHTML()` returns on a disconnected target, and `attributeChangedCallback` only fires for attributes the sanitizer keeps.\n- Element-specific paths: `\u003cselect\u003e`/`\u003coption\u003e` replaced with children, `\u003cimage\u003e` matched as `img`, implied `tbody`/`colgroup` replaced, a removed `\u003cp\u003e` still closed by `\u003cdiv\u003e`, SVG `\u003cg\u003e` and `\u003cforeignObject\u003e` replaced by namespace, and no form owner after the `\u003cform\u003e` is replaced with its children.\n- Processing instructions allow-list filtering of unlisted targets.\n- MathML elements with `javascript:` `href` attributes.\n- Test harness: `html5lib-testcase-support.js` collects the last testcase without a trailing empty line, and the tree construction harness supports `#document-fragment`.\n- `sanitizer-custom-elements-is.html` and `sethtml-with-declarative-shadow-root.html` are no longer tentative.\n--\n\nwpt-commits: 5ab6ad02ee9e14e1054c3bc798b67d25d0727584\nwpt-pr: 62492\n", "files": ["testing/web-platform/tests/sanitizer-api/sanitizer-custom-elements-constructor.html", "testing/web-platform/tests/sanitizer-api/sanitizer-custom-elements-is.html", "testing/web-platform/tests/sanitizer-api/sanitizer-custom-elements-is.tentative.html", "testing/web-platform/tests/sanitizer-api/sanitizer-duplicate-html-body.html", "testing/web-platform/tests/sanitizer-api/sanitizer-in-adoption-agency.sub.dat", "testing/web-platform/tests/sanitizer-api/sanitizer-javascript-url.html", "testing/web-platform/tests/sanitizer-api/sanitizer-parseHTML.html", "testing/web-platform/tests/sanitizer-api/sanitizer-processing-instructions.html", "testing/web-platform/tests/sanitizer-api/sanitizer-script-tokenizer.html", "testing/web-platform/tests/sanitizer-api/sanitizer-script-tokenizer.sub.dat", "testing/web-platform/tests/sanitizer-api/sethtml-form-owner.html", "testing/web-platform/tests/sanitizer-api/sethtml-noscript.html", "testing/web-platform/tests/sanitizer-api/sethtml-safety.sub.dat", "testing/web-platform/tests/sanitizer-api/sethtml-tree-construction.html", "testing/web-platform/tests/sanitizer-api/sethtml-tree-construction.sub.dat", "testing/web-platform/tests/sanitizer-api/sethtml-unsafety.sub.dat", "testing/web-platform/tests/sanitizer-api/sethtml-with-custom-elements.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-declarative-shadow-root.html", "testing/web-platform/tests/sanitizer-api/sethtml-with-declarative-shadow-root.tentative.html", "testing/web-platform/tests/sanitizer-api/sethtmlunsafe-toplevel-template-script.html", "testing/web-platform/tests/sanitizer-api/sethtmlunsafe-toplevel-template-script.sub.dat", "testing/web-platform/tests/sanitizer-api/support/html5lib-testcase-support.js"], "git_node": "cccc32b7c7cbeaebfbb1a80a1b88381487a8775e", "git_parents": ["c494331ac6721b163c5c0b4707ffdf9ef8d24c3a"], "node": "58c7653a674c0da9725587512973fda37da2efd9", "parents": ["56f5d0afe4e8527cb96fc0fd26b90bce8cd1f830"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071492 [wpt PR 62492] - Update wpt metadata, a=testonly\n\nwpt-pr: 62492\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/sanitizer-api/sanitizer-custom-elements-constructor.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-in-adoption-agency.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-parseHTML.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-processing-instructions.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-form-owner.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-custom-elements.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-declarative-shadow-root.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-declarative-shadow-root.tentative.html.ini", "testing/web-platform/meta/sanitizer-api/sethtmlunsafe-toplevel-template-script.html.ini"], "git_node": "4afca136690431fdd86a74553964704ed39bbd11", "git_parents": ["cccc32b7c7cbeaebfbb1a80a1b88381487a8775e"], "node": "42e29e2e86d628650186ab3755b79457e6fd330e", "parents": ["58c7653a674c0da9725587512973fda37da2efd9"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2081414 [wpt PR 63606] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=279265, a=testonly\n\nAutomatic update from web-platform-tests\nSupport `referrerPolicy` for SVG \u003ca\u003e element (#63606)\n\nSVG 2 gives SVG \u003ca\u003e the same referrerpolicy attribute as HTML \u003ca\u003e:\n\n    Allowed values and meaning are as defined for the a element in\n    HTML.\n\nhttps://w3c.github.io/svgwg/svg2-draft/linking.html#AElementReferrerpolicyAttribute\n\nWebKit had neither the attribute nor the referrerPolicy property, and\nfollowing an SVG link only looked at rel=\"noreferrer\". Chrome and\nFirefox support both.\n\nSVGAElement now reads the attribute the way HTMLAnchorElement does, and\nuses effectiveReferrerPolicy() when following the link, so\nrel=\"noreferrer\" still wins over the attribute. hasRel() had no other\ncaller and is removed.\n\nNew test a-referrerpolicy-navigation.html follows an SVG link with\nseveral referrerpolicy values and checks the referrer the target page\nreceives.\n\nUpstream commit: https://github.com/web-platform-tests/wpt/commit/c7bbc237dc396576b7486224a40a2ae2fa6d1141\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=279265\n--\n\nwpt-commits: 2b59485a21d5cde5ce6cb0f5cd10d9562e4595e3\nwpt-pr: 63606\n", "files": ["testing/web-platform/tests/svg/linking/scripted/a-referrerpolicy-navigation.html", "testing/web-platform/tests/svg/linking/scripted/resources/a-referrerpolicy-navigation-frame.html", "testing/web-platform/tests/svg/linking/scripted/resources/a-referrerpolicy-navigation-target.html"], "git_node": "fff4940820978d88e1ddc727d1e8ece1eb0a93fd", "git_parents": ["4afca136690431fdd86a74553964704ed39bbd11"], "node": "681ff026769cc27ade7a5d66937aad1699ad1598", "parents": ["42e29e2e86d628650186ab3755b79457e6fd330e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081414 [wpt PR 63606] - Update wpt metadata, a=testonly\n\nwpt-pr: 63606\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/linking/scripted/use-iframe-crash.html.ini"], "git_node": "9cdeb1f6593843e9c0932b63a55ec1774ba48fc8", "git_parents": ["fff4940820978d88e1ddc727d1e8ece1eb0a93fd"], "node": "0955349f788fe85186d6e515b831b7f8b6562010", "parents": ["681ff026769cc27ade7a5d66937aad1699ad1598"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081508 [wpt PR 63609] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325390, a=testonly\n\nAutomatic update from web-platform-tests\naspect-ratio interpolation is inverted in vertical writing modes (#63609)\n\nBlending\u003cAspectRatio\u003e::blend() interpolated the writing-mode-relative\n(logical) aspect ratio via ComputedStyle::logicalAspectRatio(), which\nreturns denominator/numerator in vertical writing modes, and then stored\nthe result straight into AspectRatio's physical numerator/denominator.\n\nThe computed value of aspect-ratio is physical (width / height) and\nindependent of writing mode, so in horizontal writing modes logical and\nphysical agree and the result was correct, but in vertical writing modes\nthe interpolation ran in inverted space and was stored without inverting\nback, producing the reciprocal of the correct value at every non-midpoint\nsample (the midpoint is symmetric in log space and happened to be\nunaffected).\n\nFix this by interpolating the physical ratio (width / height) directly,\nindependent of writing mode.\n\nInterpolation happens in log space, so a degenerate ratio (one with a zero\nor infinite term, e.g. 0 / 1, 1 / 0 or 0 / 0) produced NaN or infinity.\nPer https://drafts.csswg.org/css-values-4/#combine-ratio such ratios cannot\nbe interpolated, so make canBlend() return false for them and let them\nanimate discretely.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325390\nWebKit-Canonical-Link: https://commits.webkit.org/323584@main\n--\n\nwpt-commits: ea53e659f7f8c48671f4df50d1e980f31a7a684f\nwpt-pr: 63609\n", "files": ["testing/web-platform/tests/css/css-sizing/animation/aspect-ratio-interpolation-degenerate.html", "testing/web-platform/tests/css/css-sizing/animation/aspect-ratio-interpolation-sideways-lr.html", "testing/web-platform/tests/css/css-sizing/animation/aspect-ratio-interpolation-sideways-rl.html", "testing/web-platform/tests/css/css-sizing/animation/aspect-ratio-interpolation-vertical-lr.html", "testing/web-platform/tests/css/css-sizing/animation/aspect-ratio-interpolation-vertical-rl.html"], "git_node": "0ad990c127796e02384ac762b40e0747dcae798b", "git_parents": ["9cdeb1f6593843e9c0932b63a55ec1774ba48fc8"], "node": "6361dfafb9d3f38c428e9d17956073de1ed020d8", "parents": ["0955349f788fe85186d6e515b831b7f8b6562010"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2081365 [wpt PR 63603] - Use unique URLs in sizes=auto dynamic attribute tests, a=testonly\n\nAutomatic update from web-platform-tests\nUse unique URLs in sizes=auto dynamic attribute tests (#63603)\n\nAvoid cross-test cache hits that can complete image selection before\nlayout-driven reselection. This syncs the remaining WPT changes from\nChromium CL 8126943; its unrendered-image test is already upstream.\n\nBug: 572863052\nChange-Id: I83d99fd0df33160051d7a143339fd4bbc27ecc46\n--\n\nwpt-commits: 83a3410dcfc35b634208e52cf77c952b1531aa82\nwpt-pr: 63603\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/sizes/sizes-auto-dynamic-attributes.html"], "git_node": "4bf1f671d59639fd77ff4967f1327b11abac6002", "git_parents": ["0ad990c127796e02384ac762b40e0747dcae798b"], "node": "4218734e0b7b83301a53b7193a90439f192e6240", "parents": ["6361dfafb9d3f38c428e9d17956073de1ed020d8"], "tags": []}, {"author": "Olga Gerchikov \u003cgerchiko@microsoft.com\u003e", "branch": "default", "desc": "Bug 2081564 [wpt PR 63612] - [VT] Support scoped transitions for elements with mask image, a=testonly\n\nAutomatic update from web-platform-tests\n[VT] Support scoped transitions for elements with mask image\n\nThis restriction was added as a workaround to avoid a crash. Scoped\ntransition pseudo effects are now parented outside the scope's effect\nnode, so the transition overlay is not affected by the scope's mask and\nthe restriction is no longer necessary.\n\nBug: 429763389\nChange-Id: I5f2c66e198bbf2a38f06ea78161ee78438533484\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8546892\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCommit-Queue: Olga Gerchikov \u003cgerchiko@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1717580}\n\n--\n\nwpt-commits: 69ffa04085dc4485cc883460a90af09ff48d6e6f\nwpt-pr: 63612\n", "files": ["testing/web-platform/tests/css/css-view-transitions/scoped/mask-image-capture-ref.html", "testing/web-platform/tests/css/css-view-transitions/scoped/mask-image-capture.html", "testing/web-platform/tests/css/css-view-transitions/scoped/mask-image-overlay-ref.html", "testing/web-platform/tests/css/css-view-transitions/scoped/mask-image-overlay.html"], "git_node": "06f1292ca72c9ad9d119a9a37517654cd9efece4", "git_parents": ["4bf1f671d59639fd77ff4967f1327b11abac6002"], "node": "2363e28d4e7463d01ecfb09e41a14ddd5c873d0e", "parents": ["4218734e0b7b83301a53b7193a90439f192e6240"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081564 [wpt PR 63612] - Update wpt metadata, a=testonly\n\nwpt-pr: 63612\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/scoped/mask-image-capture.html.ini", "testing/web-platform/meta/css/css-view-transitions/scoped/mask-image-overlay.html.ini"], "git_node": "47ed9d124869f145fd574de45a1b27afe9d0b431", "git_parents": ["06f1292ca72c9ad9d119a9a37517654cd9efece4"], "node": "1ac7f0120ec6dafebce38dd3a3408856e0fa324f", "parents": ["2363e28d4e7463d01ecfb09e41a14ddd5c873d0e"], "tags": []}, {"author": "Dana Estra \u003c43855550+danae404@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080653 [wpt PR 63533] - Add webvtt rendering test for two cues with non-overlapping text on same line, with and without snap to lines, a=testonly\n\nAutomatic update from web-platform-tests\nAdd webvtt rendering test for two cues with non-overlapping text on same line, with and without snap to lines (#63533)\n--\n\nwpt-commits: b336733e6f71844e5866792ee49452be2a928bcd\nwpt-pr: 63533\n", "files": ["testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/align_left_right_with_and_without_snap_to_lines-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/align_left_right_with_and_without_snap_to_lines.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/support/align_left_right_with_and_without_snap_to_lines.vtt"], "git_node": "5918dfd285122c3b90608ba0b4dbfc7a7e5c83a7", "git_parents": ["47ed9d124869f145fd574de45a1b27afe9d0b431"], "node": "e7f4169061ccf89d60c9fd0f715a71435e60a8ed", "parents": ["1ac7f0120ec6dafebce38dd3a3408856e0fa324f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080653 [wpt PR 63533] - Update wpt metadata, a=testonly\n\nwpt-pr: 63533\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/align_left_right_with_and_without_snap_to_lines.html.ini"], "git_node": "9cbcaad8799ba624f03e69661bb25a817c317ee4", "git_parents": ["5918dfd285122c3b90608ba0b4dbfc7a7e5c83a7"], "node": "7de4cf5dd0735310c0b7ebfbda785aec7377522c", "parents": ["e7f4169061ccf89d60c9fd0f715a71435e60a8ed"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2080576 [wpt PR 63520] - VT: Don't paint view transition content under SVG reference filters, a=testonly\n\nAutomatic update from web-platform-tests\nVT: Don't paint view transition content under SVG reference filters\n\nVTs can have pixels of cross-origin frames, file:// frames and plugins.\nSVG reference filters must not be applied to such content (see the\nPreventSvgFilterPaint deprecation and crbug.com/476646486), but that\nmitigation only covers the remote frame and plugin foreign layers, and\nin-process cross-origin frames. A reference filter on the view\ntransition pseudo-elements, or on an ancestor of a subframe or scope\nwith a view transition, was therefore still applied to\nDisplayItem::kForeignLayerViewTransitionContent.\n\nThis patch records all three kForeignLayerViewTransitionContent foreign\nlayers under the parent of the highest effect with a reference filter,\n\nNote that whether the content actually contains such pixels isn't\ntracked (e.g. the old snapshot of a cross-document transition is\ncaptured by the previous document). There's a TODO for that.\n\nA new ViewTransitionPreventSvgFilterPaint deprecation (and use counter)\nis reported when a filter is removed\n\nBug: 568974861\nChange-Id: Ic188e4e24f5743d5183fb2dfcebc14e284b7a929\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8521561\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717831}\n\n--\n\nwpt-commits: 847dc7e9cc11c5c633705697dd12553b9617a5f8\nwpt-pr: 63520\n", "files": ["testing/web-platform/tests/css/css-view-transitions/iframe-cross-origin-svg-filter-ref.tentative.html", "testing/web-platform/tests/css/css-view-transitions/iframe-cross-origin-svg-filter.tentative.sub.https.html", "testing/web-platform/tests/css/css-view-transitions/support/iframe-cross-origin-svg-filter-child.html"], "git_node": "0ec250e54b78da9cbe0db40bb116fab332f632ee", "git_parents": ["9cbcaad8799ba624f03e69661bb25a817c317ee4"], "node": "2d3508e2bf12a6c7f2379f6912090f89ae9451e5", "parents": ["7de4cf5dd0735310c0b7ebfbda785aec7377522c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080576 [wpt PR 63520] - Update wpt metadata, a=testonly\n\nwpt-pr: 63520\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/content-visibility-auto-relock-crash.html.ini"], "git_node": "5302b89e746d1d5ce40c1a1998536d9d02351115", "git_parents": ["0ec250e54b78da9cbe0db40bb116fab332f632ee"], "node": "49a227e0c88113068559ff0111b543d354217e47", "parents": ["2d3508e2bf12a6c7f2379f6912090f89ae9451e5"], "tags": []}, {"author": "Alex Turner \u003calexmt@chromium.org\u003e", "branch": "default", "desc": "Bug 2081664 [wpt PR 63620] - Delete orphaned aggregation-service web test files, a=testonly\n\nAutomatic update from web-platform-tests\nDelete orphaned aggregation-service web test files\n\nDeletes the unused wpt_internal/aggregation-service directory and the\nexternal/wpt/.well-known/aggregation-service public-keys fixture. These\nare unused following the removal of the Aggregation Service (previously\nused by two Privacy Sandbox APIs: Private Aggregation and Attribution\nReporting, both of which have been removed).\n\nBug: 531746235\nChange-Id: I3442b34606e506e3240d042b64364da9c0e4ad65\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8531946\nAuto-Submit: Alex Turner \u003calexmt@chromium.org\u003e\nCommit-Queue: Nico Weber \u003cthakis@chromium.org\u003e\nReviewed-by: Nico Weber \u003cthakis@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717871}\n\n--\n\nwpt-commits: 05f6f3665c6c4bd92250ee1d78f08a6f3796ee21\nwpt-pr: 63620\n", "files": ["testing/web-platform/tests/.well-known/aggregation-service/v1/public-keys"], "git_node": "4dc9556ad99764b9fe1ed265df1d889c42cb68ab", "git_parents": ["5302b89e746d1d5ce40c1a1998536d9d02351115"], "node": "12e209d22ecff639751c878a6ada7b4e1372c62b", "parents": ["49a227e0c88113068559ff0111b543d354217e47"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2081563 [wpt PR 63611] - [FragmentedOofInCb] Keep overflowing OOFs in container that fits., a=testonly\n\nAutomatic update from web-platform-tests\n[FragmentedOofInCb] Keep overflowing OOFs in container that fits.\n\nIf there's a container with a definite size that fits in the current\nfragmentainer, it shouldn't be pushed to the next fragmentainer, even if\nthere's unbreakable content inside that doesn't fit. This was already\nworking for in-flow content, and with the current OOF fragmentation\nengine. Make it work for FragmentedOofInCb, too.\n\nMove the code that resets the RequiresContentBeforeBreaking flag into\nfragmentation-specific code, since it only matters in that case, and\nmake sure not to reset it when adding OOFs. Add another test to\ndemonstrate why this is needed.\n\nBug: 40267498\nChange-Id: Iaf39df92871eeaa21132edda5fd2cec941f20f2d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8570597\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717837}\n\n--\n\nwpt-commits: dc2c19c94268c60c9239afbfb3cdc863247c5f4d\nwpt-pr: 63611\n", "files": ["testing/web-platform/tests/css/css-break/tall-content-inside-constrained-block-007.tentative.html"], "git_node": "c132f985c9ce2f38f68efd1995d8ef46dec717b7", "git_parents": ["4dc9556ad99764b9fe1ed265df1d889c42cb68ab"], "node": "139a97de33047ea52124904d0eb756ddf11b2a6f", "parents": ["12e209d22ecff639751c878a6ada7b4e1372c62b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081563 [wpt PR 63611] - Update wpt metadata, a=testonly\n\nwpt-pr: 63611\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/area-crash.html.ini", "testing/web-platform/meta/css/css-break/flexbox/auto-height-flex-item-in-multicol-crash.html.ini"], "git_node": "bbbd9c4971973810657038016fcd9445babad4da", "git_parents": ["c132f985c9ce2f38f68efd1995d8ef46dec717b7"], "node": "fdd72c33b90f0135b9e279a724573bd097422a0d", "parents": ["139a97de33047ea52124904d0eb756ddf11b2a6f"], "tags": []}, {"author": "Thomas Guilbert \u003ctguilbert@chromium.org\u003e", "branch": "default", "desc": "Bug 2081566 [wpt PR 63613] - Fix timeouts in no-blocking-loads-gc-crash.html WPT, a=testonly\n\nAutomatic update from web-platform-tests\nFix timeouts in no-blocking-loads-gc-crash.html WPT\n\nThis crashtest runs 200 rounds, and each round forces two full GCs.\nThat takes ~4.3s locally and 5-7s on bots, against a 10s timeout. Under\nload, the timeout hits when ~190 rounds are done. Over the last 7 days,\nthe test timed out ~2,400 times in `headless_shell_wpt_tests`, mostly\non win-rel and linux-rel. Most of these runs passed on retry.\n\nThis CL runs 50 rounds instead. When the test was added upstream, its\nauthor noted that 200 rounds \"definitely has a large safety margin\".\nEach round is unchanged, so we still force 100 GCs right after dropping\na loading media element.\n\nLocally, the test now takes 1.1s instead of ~4.3s. With the CPU shared\nwith busy loops, it passes in 3.6s, where it timed out 3/3 times\nbefore.\n\nBug: 567242342, 567584245\nChange-Id: Ie3c5c2c4085e0faf9a423c7b49e0155861b025a3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8562664\nCommit-Queue: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nReviewed-by: Syed AbuTalib \u003clowkey@google.com\u003e\nCommit-Queue: Syed AbuTalib \u003clowkey@google.com\u003e\nAuto-Submit: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717838}\n\n--\n\nwpt-commits: 97147a9f65c63c1b7bfaee61fb9616735862c4d2\nwpt-pr: 63613\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/crashtests/no-blocking-loads-gc-crash.html"], "git_node": "6ad95cc78010978fc192dc960a2d79add601755f", "git_parents": ["bbbd9c4971973810657038016fcd9445babad4da"], "node": "e0105bcd72beee431285fadfa560b59a44663d57", "parents": ["fdd72c33b90f0135b9e279a724573bd097422a0d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081566 [wpt PR 63613] - Update wpt metadata, a=testonly\n\nwpt-pr: 63613\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/media-elements/crashtests/no-blocking-loads-gc-crash.html.ini"], "git_node": "468dac250925020dbdd296ef2a4c995a04d45c5f", "git_parents": ["6ad95cc78010978fc192dc960a2d79add601755f"], "node": "c48ddfbcdb189423b768d3760b19ece9cea3fc19", "parents": ["e0105bcd72beee431285fadfa560b59a44663d57"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2081309 [wpt PR 63596] - Avoid flat tree traversal when unlocking a display lock, a=testonly\n\nAutomatic update from web-platform-tests\nAvoid flat tree traversal when unlocking a display lock\n\nDisplayLockContext::SetRequestedState() called ForceLockIfNeeded() on\nevery state change. ForceLockIfNeeded() walks the flat tree to find out\nif a newly requested lock is on the ancestor chain of the node of an\nactive forced update scope. This is not needed when unlocking.\n\nDisplayLockContext::DetachLayoutTree() requests an unlock, and it can be\ncalled during slot assignment recalc, where flat tree traversal is not\nallowed. The traversal could then recalc the slot assignment of another\nshadow root while the assigned nodes of the slots being recalculated\nwere not up to date. As a result, parts of the layout tree were not\ndetached when they left the flat tree.\n\nOnly call ForceLockIfNeeded() when a lock is requested.\n\nAlso make ScrollMarkerGroupData::ChooseMarkerRecursively() more robust.\nIt runs after layout, and its flat tree walks must not recalc slot\nassignments. It now ignores scroll markers whose scroll targets are not\nconnected, runs on a stable list of scroll markers instead of the live\nfocus group, and verifies that no slot assignment recalc happens.\n\nBug: 570167919\nChange-Id: Ib2912912fabbc4368e6eea0c80ef88b0dfe5a9f9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8550701\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717859}\n\n--\n\nwpt-commits: 27da653a6d6c90e4050132a6c2ecdab597c40c66\nwpt-pr: 63596\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/chrome-570167919-crash.html"], "git_node": "405cd4bc5f4a9c3fe74d6be9d00b214162ef9395", "git_parents": ["468dac250925020dbdd296ef2a4c995a04d45c5f"], "node": "3dfcae175cd73b3a863d68daa70c775ddd7c0245", "parents": ["c48ddfbcdb189423b768d3760b19ece9cea3fc19"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081309 [wpt PR 63596] - Update wpt metadata, a=testonly\n\nwpt-pr: 63596\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/chrome-570167919-crash.html.ini"], "git_node": "55a1d1eb155785aa3d4ce23b72dae1b1e36bca01", "git_parents": ["405cd4bc5f4a9c3fe74d6be9d00b214162ef9395"], "node": "b2ead67615d64253eca08903b7db9279739ea1da", "parents": ["3dfcae175cd73b3a863d68daa70c775ddd7c0245"], "tags": []}, {"author": "Yanling Wang \u003cyanlingwang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2081668 [wpt PR 63621] - [Masonry] Basic support for grid-lanes subgrids in grid-lanes, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Basic support for grid-lanes subgrids in grid-lanes\n\nRecognize grid-lanes subgrids inside grid-lanes parents and include\nthem in the sizing tree, respecting grid axes and writing modes.\n\nReuse inherited geometry for layout and intrinsic sizing, including\nrow subgrids' inline contributions, and preserve inherited line\nresolution and placement cache invalidation.\n\nBug: 343257585\nChange-Id: Ic3ed6a15767d4fef70ce49eec8c49c7b15f358e9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8380717\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1717888}\n\n--\n\nwpt-commits: 7ea4f6de76b62c39187ba0ca2ad6c596c53640f4\nwpt-pr: 63621\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-003a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-003a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-001a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-001a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-003a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-003a.html"], "git_node": "962dd61afd3e47e4d0c850c7f898c5791f447340", "git_parents": ["55a1d1eb155785aa3d4ce23b72dae1b1e36bca01"], "node": "c210fd714d6a97735a8c786f74ebad8eb7d7bc99", "parents": ["b2ead67615d64253eca08903b7db9279739ea1da"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081668 [wpt PR 63621] - Update wpt metadata, a=testonly\n\nwpt-pr: 63621\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-001a.html.ini"], "git_node": "4108c01f68b000e1ce7ab2c91d2fdcd9f3a7c130", "git_parents": ["962dd61afd3e47e4d0c850c7f898c5791f447340"], "node": "a22dac7862b28f564a6371876fecd2fe13c8d328", "parents": ["c210fd714d6a97735a8c786f74ebad8eb7d7bc99"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2081552 [wpt PR 63610] - Load pending style resources for \u003carea\u003e, a=testonly\n\nAutomatic update from web-platform-tests\nLoad pending style resources for \u003carea\u003e\n\nAn \u003carea\u003e is display:none, so style resolution left unloaded\nStylePendingImage entries in its ComputedStyle, which the cursor\nselection path reads and CHECK-fails on.\n\nBug: 571666818\nChange-Id: I9c09ee963c36f61f7559615696003b68c222eecf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8548514\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717912}\n\n--\n\nwpt-commits: a911181788aaaed2c111136330447a7ed10b45d9\nwpt-pr: 63610\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-area-element/area-image-cursor.html"], "git_node": "0c2aa978bcab4d316f421c63a6ef06d8567c7666", "git_parents": ["4108c01f68b000e1ce7ab2c91d2fdcd9f3a7c130"], "node": "90c8c6b247aabc516295dacd1a50ccc4925bd3a5", "parents": ["a22dac7862b28f564a6371876fecd2fe13c8d328"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2081671 [wpt PR 63622] - Deflake three CSP WPTs and remove their expectations, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake three CSP WPTs and remove their expectations\n\nstylehash-basic-blocked.sub.html: The page has three blocked \u003cstyle\u003e\nelements, so three securitypolicyviolation events fire, but\nexpected_alerts only listed one. Violation events are posted as tasks;\nif the parser yielded before the \u003cbody\u003e script, the second violation\nhit assert_unreached. List all three violations (matching\nscriptnonce-basic-blocked.sub.html) and fix a t_log/t_alert typo.\n\nparsing/invalid-bytes.html: support/csp.py emitted the \u003cimg\u003e before the\nscript attaching onload/onerror, so a cached (or quickly blocked) image\ncould fire before the handler existed, leaving the promise_test hung.\nCreate the image in script and attach handlers before setting src. Also\nadd timeout=long for the 18 serial iframe loads, remove each iframe on\ncleanup, and drop a reference to a non-existent helper.sub.js.\n\ninheritance/sandboxed-data-scheme.html: checkReport.sub.js only waits\n3s for the report unless the test sets timeout=long (then 20s;\nreport.py returns as soon as a report arrives). On Mac14 Debug the\nsandboxed data: iframe, which gets its own process, plus the report-uri\nPOST can exceed 3s. Add \u003cmeta name=\"timeout\" content=\"long\"\u003e, as other\ncheckReport.sub.js tests already do.\n\nBug: 40853415, 439456643, 339853454\nChange-Id: I593cc11e3ab803a11334da761e8ba2700a77d974\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8570439\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCommit-Queue: Ari Chivukula \u003carichiv@chromium.org\u003e\nAuto-Submit: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717924}\n\n--\n\nwpt-commits: 49983c9f9bf574bd565cca971f9b6572cf6f9975\nwpt-pr: 63622\n", "files": ["testing/web-platform/tests/content-security-policy/inheritance/sandboxed-data-scheme.html", "testing/web-platform/tests/content-security-policy/parsing/invalid-bytes.html", "testing/web-platform/tests/content-security-policy/parsing/support/csp.py", "testing/web-platform/tests/content-security-policy/style-src/stylehash-basic-blocked.sub.html"], "git_node": "ed2aae12b4fc8998ff2da10ba94758a9a04787f9", "git_parents": ["0c2aa978bcab4d316f421c63a6ef06d8567c7666"], "node": "3912dd33e3cb3e60047ec18dd956affa3f7fd125", "parents": ["90c8c6b247aabc516295dacd1a50ccc4925bd3a5"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2081676 [wpt PR 63623] - Remove void element end tags from CSS WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove void element end tags from CSS WPTs\n\nSome elements (such as img, input, link, embed, frame, etc) have no end\ntag. Writing their end tag anyway is a parse error, and the parser drops\nthe tag, so the source suggests a structure the document never had. This\nCL removes these end tags from WPT tests in\nthird_party/blink/web_tests/external/wpt/css.\n\nBug: 542686202\nChange-Id: Ic1a4e98e6c2912f04dd95c4c376e8f8e8699850c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8224187\nReviewed-by: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1717996}\n\n--\n\nwpt-commits: 20706d5de4157797cad9b6da93d0758cdaaad5d6\nwpt-pr: 63623\n", "files": ["testing/web-platform/tests/css/css-break/area-crash.html", "testing/web-platform/tests/css/css-break/area-in-inline-crash.html", "testing/web-platform/tests/css/css-display/display-contents-unusual-html-elements-none.html", "testing/web-platform/tests/css/css-flexbox/flex-item-z-ordering-001.html", "testing/web-platform/tests/css/css-flexbox/percentage-heights-013.html", "testing/web-platform/tests/css/css-flexbox/reference/flex-item-z-ordering-001-ref.html", "testing/web-platform/tests/css/css-multicol/flex-grid-item-insert-002-crash.html", "testing/web-platform/tests/css/css-page/media-queries-003-print.html", "testing/web-platform/tests/css/css-rhythm/computedstyle/block-level-replaced-elements-affected-by-block-step-size.html", "testing/web-platform/tests/css/css-rhythm/computedstyle/inline-level-replaced-elements-not-affected-by-block-step-size.html", "testing/web-platform/tests/css/css-rhythm/replaced-elements/block-level-embed-margins-affected-by-block-step-size.html", "testing/web-platform/tests/css/css-rhythm/replaced-elements/block-level-img-margins-affected-by-block-step-size.html", "testing/web-platform/tests/css/css-shadow/part/interaction-with-placeholder-ref.html", "testing/web-platform/tests/css/css-shadow/part/interaction-with-placeholder.html", "testing/web-platform/tests/css/css-shadow/part/interaction-with-pseudo-elements.html", "testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-radial-gradient-001.html", "testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-radial-gradient-002.html", "testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-radial-gradient-003.html", "testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-radial-gradient-004.html", "testing/web-platform/tests/css/css-text/hyphens/hyphens-none-014.html", "testing/web-platform/tests/css/css-text/hyphens/hyphens-none-015.html", "testing/web-platform/tests/css/css-text/white-space/trailing-ideographic-space-break-spaces-007.html", "testing/web-platform/tests/css/css-ui/caret-color-010.html", "testing/web-platform/tests/css/cssom-view/elementFromPoint-ua-shadowroot-crash.html"], "git_node": "4fba6c342ec5cec05dece1c7de3aace742d4f96f", "git_parents": ["ed2aae12b4fc8998ff2da10ba94758a9a04787f9"], "node": "6b594b87745972045ecaddacf2fb4528e8d185eb", "parents": ["3912dd33e3cb3e60047ec18dd956affa3f7fd125"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2081591 [wpt PR 63617] - Do not expose pseudo-elements through LargestContentfulPaint API, a=testonly\n\nAutomatic update from web-platform-tests\nDo not expose pseudo-elements through LargestContentfulPaint API\n\nIf a PseudoElement is stored as the element_ in the\nLargestContentfulPaint object, we would expose that to javascript\nthrough the element attribute.\n\nThis could cause all sorts of problems, letting javascript be able to\nmodify them as if they were true elements, moving them around the tree\nin unexpected places and setting attributes on them, for instance.\n\nSpecifically, the issue reported was modifying querySelector caches\nwhile being traversed due to slot re-assignment.\n\nBug: 570638836\nChange-Id: I44d87a537a7da52fa9dc2aa577a58a888c94f3de\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8545831\nCommit-Queue: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nAuto-Submit: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1718007}\n\n--\n\nwpt-commits: cfb4a4b0bb480522d095557b16d86a15d6897e35\nwpt-pr: 63617\n", "files": ["testing/web-platform/tests/largest-contentful-paint/observe-pseudo-element.tentative.html"], "git_node": "598288d3c4acd7ac66fad166ac3523ad0e232eb4", "git_parents": ["4fba6c342ec5cec05dece1c7de3aace742d4f96f"], "node": "4f4dab49d5a7372fa597ec7f34ba02fc673f25e3", "parents": ["6b594b87745972045ecaddacf2fb4528e8d185eb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081591 [wpt PR 63617] - Update wpt metadata, a=testonly\n\nwpt-pr: 63617\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/largest-contentful-paint/observe-pseudo-element.tentative.html.ini"], "git_node": "acef3b93867476ba78a3a3f84a34ee1fa39cf754", "git_parents": ["598288d3c4acd7ac66fad166ac3523ad0e232eb4"], "node": "061e78ae02bfc278aed0861758b201d83ba4eceb", "parents": ["4f4dab49d5a7372fa597ec7f34ba02fc673f25e3"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081680 [wpt PR 63625] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327186, a=testonly\n\nAutomatic update from web-platform-tests\ngrid-template shorthand: empty [] line-names before a row's leading line-names overwrites the previous row's track size (#63625)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nIn the `[ \u003cline-names\u003e? \u003cstring\u003e \u003ctrack-size\u003e? \u003cline-names\u003e? ]+` form of\ngrid-template, consumeGridTemplateShorthand() keeps the trailing\n\u003cline-names\u003e from one row so it can merge them with the next row's\nleading \u003cline-names\u003e (e.g. `\"a\" [a] [b] \"b\"` becomes `\"a\" [a b] \"b\"`).\nThe merge works by replacing the track list's last entry, which assumes\nthe trailing names were appended.\n\nAn empty trailing `[]` is never appended, but it is still kept as a\nnon-null value. So with `\"a\" 10px [] [b] \"b\" 20px`, the leading `[b]` took\nthe merge path and replaced the last entry, which was the `10px` track\nsize. The result serialized as `[b] \"a\" 20px`.\n\nOnly merge when the previous line-names are non-empty. Otherwise append\nthe leading line-names as a new entry.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327186\nWebKit-Canonical-Link: https://commits.webkit.org/323665@main\n--\n\nwpt-commits: c0398c11f68f992c85e4c1c0bbd8da2791ca6961\nwpt-pr: 63625\n", "files": ["testing/web-platform/tests/css/css-grid/parsing/grid-template-shorthand-valid.html"], "git_node": "8e371b27b3cdfe4aff9ad708f86011bac304ea03", "git_parents": ["acef3b93867476ba78a3a3f84a34ee1fa39cf754"], "node": "e784ec209f63c419c6381bee1590494ecc396e4c", "parents": ["061e78ae02bfc278aed0861758b201d83ba4eceb"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2081688 [wpt PR 63626] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327205, a=testonly\n\nAutomatic update from web-platform-tests\ncalc() negation of a typed-arithmetic product flips the sign of every factor (#63626)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nWhen a Negate node's child is a Product whose children are all numeric,\nsimplify(Negate&) negated every child of the product. That is only\ncorrect when the product has an odd number of factors, since\n-(a * b) = (-a) * b, not (-a) * (-b). With typed arithmetic, a product\nsuch as `2px * 3px` (type length^2) cannot be resolved on its own and so\nsurvives simplification. Subtracting it then produced the wrong sign:\n`calc((0px * 0px - 2px * 3px) / 1px)` resolved to 6px instead of -6px.\n\nNegate only the first factor of the product instead.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327205\nWebKit-Canonical-Link: https://commits.webkit.org/323577@main\n--\n\nwpt-commits: fc3d98ed370411940bb4f9070cda0ee3c310d12e\nwpt-pr: 63626\n", "files": ["testing/web-platform/tests/css/css-values/typed-arithmetic-negated-product.html"], "git_node": "d1f9f058f4f948a652417967ad57cbb24ef155d3", "git_parents": ["8e371b27b3cdfe4aff9ad708f86011bac304ea03"], "node": "b42cac1f51d319d5b3451934575809bca5f858b1", "parents": ["e784ec209f63c419c6381bee1590494ecc396e4c"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 2081373 [wpt PR 63605] - Move WebIDL/* to webidl, a=testonly\n\nAutomatic update from web-platform-tests\nMove WebIDL/* to webidl\n\nPR 63524 added some files to WebIDL/ which didn't previously exist;\npresumably these were intended for webidl/, so move them there.\n\n--\n\nwpt-commits: a43dd1b4caeb60e6655a1b4904ab826f505956ac\nwpt-pr: 63605\n", "files": ["testing/web-platform/tests/WebIDL/ecmascript-binding/es-exceptions/DOMException-audioworklet-processor.js", "testing/web-platform/tests/WebIDL/ecmascript-binding/es-exceptions/DOMException-audioworklet.https.html", "testing/web-platform/tests/webidl/ecmascript-binding/es-exceptions/DOMException-audioworklet-processor.js", "testing/web-platform/tests/webidl/ecmascript-binding/es-exceptions/DOMException-audioworklet.https.html"], "git_node": "a102ed85083a2e575f3d11279229738cfd77f296", "git_parents": ["d1f9f058f4f948a652417967ad57cbb24ef155d3"], "node": "48396e8ba5867045a975ce37deb06bf68e40c7ce", "parents": ["b42cac1f51d319d5b3451934575809bca5f858b1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081373 [wpt PR 63605] - Update wpt metadata, a=testonly\n\nwpt-pr: 63605\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/WebIDL/ecmascript-binding/es-exceptions/DOMException-audioworklet.https.html.ini", "testing/web-platform/meta/webidl/ecmascript-binding/es-exceptions/DOMException-audioworklet.https.html.ini"], "git_node": "6e4c445f02e7c4f7405c80851cf8e03cd397eca3", "git_parents": ["a102ed85083a2e575f3d11279229738cfd77f296"], "node": "b9d2a1773b0c20946ccdf5576442640fdb5bfd9f", "parents": ["48396e8ba5867045a975ce37deb06bf68e40c7ce"], "tags": []}, {"author": "Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e", "branch": "default", "desc": "Bug 2080934 [wpt PR 63567] - Fix `larger-image.html` and `progressively-loaded-image.html`, whose assertions never ran, a=testonly\n\nAutomatic update from web-platform-tests\nFix two largest-contentful-paint tests whose assertions never ran\n\nlarger-image.html and progressively-loaded-image.html registered their\nPerformanceObserver callbacks with t.step_func() / t.step_func_done() inside a\npromise_test whose body returned before the entry was dispatched. Steps of an\nalready-completed test are ignored, so both files passed without executing any\nof their checks.\n\nWait for the entry in the test body and run the checks there instead.\n\nSigned-off-by: Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e\n\n--\n\nwpt-commits: 50d38aeb9952e1875c8f592e9bf5ebc971cc2e24\nwpt-pr: 63567\n", "files": ["testing/web-platform/tests/largest-contentful-paint/larger-image.html", "testing/web-platform/tests/largest-contentful-paint/progressively-loaded-image.html"], "git_node": "de7542b49588514c89e05e75ea40b203adaf75ce", "git_parents": ["6e4c445f02e7c4f7405c80851cf8e03cd397eca3"], "node": "d226891f4ef5ef8a4342eb610c5cb5064254936c", "parents": ["b9d2a1773b0c20946ccdf5576442640fdb5bfd9f"], "tags": []}, {"author": "Florian Rivoal \u003cgit@florian.rivoal.net\u003e", "branch": "default", "desc": "Bug 2081706 [wpt PR 63630] - Mark as non-tentative tests backed by spec, a=testonly\n\nAutomatic update from web-platform-tests\nMark as non-tentative tests backed by spec (#63630)\n--\n\nwpt-commits: 1b04368fd1fa15ee925597a09e874e9c292d6cd3\nwpt-pr: 63630\n", "files":