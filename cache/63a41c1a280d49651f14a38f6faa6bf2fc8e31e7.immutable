base/content/browser-box.inc.xhtml", "browser/base/content/test/browser-general/browser_documentnavigation.js", "browser/base/content/webext-panels.js", "browser/base/content/webext-panels.xhtml", "browser/components/genai/chat.css", "browser/components/genai/chat.html", "browser/components/genai/chat.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/places/content/bookmarksSidebar.js", "browser/components/places/content/bookmarksSidebar.xhtml", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/sidebar-customize.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/sidebar-panel-header.css", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/sidebar-panel-switcher.mjs", "browser/components/sidebar/sidebar-syncedtabs.mjs", "browser/components/sidebar/sidebar.css", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_hide_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_header.js", "browser/themes/shared/places/sidebar.css", "browser/themes/shared/sidebar.css", "toolkit/components/satchel/megalist/content/MegalistAlpha.mjs", "toolkit/components/satchel/megalist/content/megalist.css"], "git_node": "8abd470dbab5b53a632af107a05bf08e001f11bb", "git_parents": ["bc2837f46d2cd2705e74eca7f8d7974978190ed9"], "node": "78b3449e5d89bdcb25fd67e982f93989cd28a3c3", "parents": ["d500e35816065c9746564d2fa9973e14ec4c7ef4"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066086 - Fix hide tabs and sidebar logic and refactor sidebar state logic r=sfoster,jsudiaman,sidebar-reviewers,nsharpley,sessionstore-reviewers,kcochrane,extension-reviewers,rpl\" for causing mochitests failures in browser_opentabs_sidebar.js.\n\nThis reverts commit 6c3ca0366e257ec03631e60a8ea02c107d2afaeb.\n", "files": ["browser/components/customizableui/test/browser_remove_sidebar_button_and_sidebar.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/extensions/test/browser/browser_ext_sidebarAction.js", "browser/components/sessionstore/session.schema.json", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/docs/index.md", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/browser/browser_adopt_sidebar_from_opener.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_launcher_hidden_restore.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_states.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/components/sidebar/tests/unit/test_sidebar_state.js"], "git_node": "34c1fb9c0b0be176f8012514e4fcd51c964a020e", "git_parents": ["8abd470dbab5b53a632af107a05bf08e001f11bb"], "node": "95b3b9f047b9efabf0fa186d2ea96344be6deb71", "parents": ["78b3449e5d89bdcb25fd67e982f93989cd28a3c3"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068220: Remove unused DirtyTrackingAutoLock::Touch/mTouched. r=dom-storage-reviewers,ArnaudBienner,hsingh\n\nTouch() was called from RegisterDirtyOriginInfo but mTouched was never read\nanywhere. Remove it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323286\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/DirtyTrackingAutoLock.cpp", "dom/quota/DirtyTrackingAutoLock.h"], "git_node": "9c026f7293de297b3f140f795217a04465557b3d", "git_parents": ["34c1fb9c0b0be176f8012514e4fcd51c964a020e"], "node": "2d68e2f7f27d9dcf33c6fc265f5fc784e6d5d236", "parents": ["95b3b9f047b9efabf0fa186d2ea96344be6deb71"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078310 - Run WebGPU WPT with three processes on macOS 14.70 Intel. r=jgraham\n\nThe WebGPU chunks run one test at a time and leave the 12-thread Intel\nworkers mostly idle. Like the macOS aarch64 rule from bug 2050488 we\nwill now use three processes for test harness jobs tagged webgpu\nor webgpu-long on Intel macOS, excluding the backlog webgpu tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331284\n", "files": ["testing/mozharness/scripts/web_platform_tests.py"], "git_node": "3b8122e42b02dfe6fc584301ded6d0f06385c07c", "git_parents": ["9c026f7293de297b3f140f795217a04465557b3d"], "node": "78bdbdb499d26e816bd9ddeded4cc0a4f7631eb7", "parents": ["2d68e2f7f27d9dcf33c6fc265f5fc784e6d5d236"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078310 - Only extract the WPT harness and /_mozilla/ tests for WebGPU WPT. r=jgraham\n\nThe WebGPU jobs only run /_mozilla/webgpu tests(8k entries), but unpack all 197k entries\nof the web-platform tests archive, which takes up to 3 minutes per task. This patch adds a\nmember filter to mozharness tar extraction and use it to skip unpacking the\ntests we do not use, for every WebGPU WPT task on all platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331283\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml", "testing/mozharness/mozharness/base/script.py", "testing/mozharness/scripts/web_platform_tests.py"], "git_node": "6be097da9890dfe5a5e4f53259f2da4dec8529ae", "git_parents": ["3b8122e42b02dfe6fc584301ded6d0f06385c07c"], "node": "0afcecc3da5c4a21c3532f8f79e134e62349b812", "parents": ["78bdbdb499d26e816bd9ddeded4cc0a4f7631eb7"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076897 - Update SafeResolve to not defer on a 'then'-setter only. r=dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330362\n", "files": ["js/src/builtin/Promise.cpp", "js/src/jit-test/tests/promise/safe-resolve-ticks.js"], "git_node": "cb728d9a2fde66ce63eaa7bb7a1123874ba5bb05", "git_parents": ["6be097da9890dfe5a5e4f53259f2da4dec8529ae"], "node": "b33ea7ef5780e2cb7e1775354b68f09b2b21c724", "parents": ["0afcecc3da5c4a21c3532f8f79e134e62349b812"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076897 - Make RequiresDeferredPromiseResolution infallible r=dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330363\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "5086cb5ff7a5fb568859c0d2b9cd5aa7ace75cab", "git_parents": ["cb728d9a2fde66ce63eaa7bb7a1123874ba5bb05"], "node": "18602eb145a5031092836da5a52b5b298df4a1b5", "parents": ["b33ea7ef5780e2cb7e1775354b68f09b2b21c724"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082456 - re-disable remote pkcs#11 modules in Firefox Nightly for now r=jschanck\n\nEnabling remote pkcs#11 modules in bug 2079970 uncovered some performance\nissues, so this re-disables them for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334216\n", "files": ["browser/app/profile/firefox.js"], "git_node": "ada21865bd37ffa997db93ebe58a3b013e404b77", "git_parents": ["5086cb5ff7a5fb568859c0d2b9cd5aa7ace75cab"], "node": "845ef659f26eea4bbd1224d2227a78a64ae978a0", "parents": ["18602eb145a5031092836da5a52b5b298df4a1b5"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078052 - Stop mach from hanging when telemetry setup fails r=firefox-build-system-reviewers,sergesanspaille\n\nIf the mozconfig cannot be found or loaded, telemetry setup fails before\nit signals completion, and mach waits forever. Completion is now always\nsignalled. Telemetry records the command without its arguments when the\nmozconfig is unusable, and any other telemetry error prints a warning\nwithout changing the command's result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330654\n", "files": ["python/mach/mach/main.py", "python/mach/mach/telemetry.py", "python/mach/mach/test/test_error_output.py", "python/mach/mach/test/test_telemetry_instrumentation.py"], "git_node": "0b22a7e840d1a87e217018cf3cb86e9899358292", "git_parents": ["ada21865bd37ffa997db93ebe58a3b013e404b77"], "node": "8190cbd66ff1e1705b8a2aa6acc9d473bb9245e6", "parents": ["845ef659f26eea4bbd1224d2227a78a64ae978a0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071613 - Correct the forced-colors and env(hairline) claims in the HCM media query docs and CSS guidelines. r=desktop-theme-reviewers,akulyk DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333921\n", "files": ["accessible/docs/HCMMediaQueries.md", "docs/code-quality/coding-style/css_guidelines.md"], "git_node": "6925f60434b2a982b920bed1962e299de4358519", "git_parents": ["0b22a7e840d1a87e217018cf3cb86e9899358292"], "node": "f3320ca1b32f90de64b0fffe5f3df1163a4813cb", "parents": ["8190cbd66ff1e1705b8a2aa6acc9d473bb9245e6"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078922: Don't read other browsers' data on macOS 27 before the user selects its folder. r=migration-reviewers,mconley\n\nOn macOS 27, reading another app's data shows a \"Data Access Blocked\" notification. Firefox read Chrome's Local State whenever a page had a password field and whenever the import wizard listed browsers. Chromium browsers and Safari now go through the existing folder picker permission flow first on macOS 27. Safari's blocked reads did not show the notification, but they are skipped the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331483\n", "files": ["browser/components/migration/ChromeProfileMigrator.sys.mjs", "browser/components/migration/MigratorBase.sys.mjs", "browser/components/migration/SafariProfileMigrator.sys.mjs", "browser/components/migration/tests/unit/head_migration.js", "browser/components/migration/tests/unit/test_Chrome_permissions.js", "browser/components/migration/tests/unit/test_Safari_permissions.js"], "git_node": "17d1dfe920cbc318437d99c74c14e04854e6f63c", "git_parents": ["6925f60434b2a982b920bed1962e299de4358519"], "node": "9a1e8ba9865a1e665acae354f761229c2048e53f", "parents": ["f3320ca1b32f90de64b0fffe5f3df1163a4813cb"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078922: Keep the selected browser after granting it permission in the migration wizard. r=migration-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331479\n", "files": ["browser/components/migration/MigrationWizardChild.sys.mjs", "browser/components/migration/content/migration-wizard.mjs", "browser/components/migration/tests/browser/browser_permissions.js", "browser/components/migration/tests/chrome/test_migration_wizard.html"], "git_node": "ce58bd4fddbff7341a030bd81c408e3e041638ea", "git_parents": ["17d1dfe920cbc318437d99c74c14e04854e6f63c"], "node": "cf6fba7362abf3a58ff102fcf36d85c8567d7ecf", "parents": ["9a1e8ba9865a1e665acae354f761229c2048e53f"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078922: Open the folder picker for browser data in the data folder. r=migration-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331480\n", "files": ["browser/components/migration/ChromeProfileMigrator.sys.mjs", "browser/components/migration/SafariProfileMigrator.sys.mjs", "browser/components/migration/tests/unit/test_Chrome_permissions.js", "browser/components/migration/tests/unit/test_Safari_permissions.js"], "git_node": "56a02c2fe8a412ffee17c9bf4dd4f1493120f774", "git_parents": ["ce58bd4fddbff7341a030bd81c408e3e041638ea"], "node": "24af1798bc647bd78b3987e8d0a40996099ddc77", "parents": ["cf6fba7362abf3a58ff102fcf36d85c8567d7ecf"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078922: Keep the migration wizard's browser list open after a click in about:welcome. r=migration-reviewers,omc-reviewers,mconley,jprickett\n\nIn about:welcome the list is an auto popover that opens on mousedown, so the mouse release on the selector light dismissed it right away. Making the selector the popover's invoker prevents that, as moz-button does for its menus.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331481\n", "files": ["browser/components/aboutwelcome/tests/browser/browser.toml", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_import_dropdown.js", "browser/components/migration/content/migration-wizard.mjs"], "git_node": "8d2d712d5404543e64d8a66432452cd871819a12", "git_parents": ["56a02c2fe8a412ffee17c9bf4dd4f1493120f774"], "node": "dcb206838faa7208eb70ea57746f2d085d662c1a", "parents": ["24af1798bc647bd78b3987e8d0a40996099ddc77"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078922: Tell macOS users to choose \"Open\" in the file picker when granting access to browser data. r=fluent-reviewers,migration-reviewers,bolsson,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331482\n", "files": ["browser/components/migration/content/migration-wizard.mjs", "browser/components/migration/tests/browser/browser_permissions.js", "browser/locales/en-US/browser/migrationWizard.ftl"], "git_node": "b907d70012508e3402b62bb072529884e12efea8", "git_parents": ["8d2d712d5404543e64d8a66432452cd871819a12"], "node": "41a6bf87dd32d26454666cef6bca61fddbb76d6e", "parents": ["dcb206838faa7208eb70ea57746f2d085d662c1a"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1992419 - Upload symbols for onnxruntime. r=gsvelto,webgpu-reviewers,crashreporting-reviewers,shtrom\n\nonnxruntime is built by a standalone toolchain task and reaches dist/bin\nthrough FINAL_TARGET_FILES rather than as a build target, so the Gecko\nbuild's dumpsymbols.py never processes it. There was also nothing to dump:\nMinSizeRel carries no debug info, and the Windows build suppressed the PDBs\nupstream emits by default. Crash stacks through the library are\nunsymbolicated as a result.\n\nBuild with line tables, which is what the crash reporter consumes and which\ncosts far less under LTO than full DWARF, and dump the symbols from the\nbuild directory before the shipped copy is stripped. Stripping leaves the\nbuild id alone, so they still resolve the library we ship.\n\nThe new toolchain-symbols-upload kind pairs an upload task with each\ntoolchain task setting enable-full-crashsymbols, replacing the\ntoolchain-dxc-upload kind it is generalised from. That kind had matched\nnothing since bug 2044614 changed its kind-dependencies from toolchain to\nfetch, so this restores symbol upload for dxcompiler.dll as well. The\nAndroid onnxruntime toolchains are excluded: they are consumed only by the\nbootstrap tasks and no build task fetches them, so Firefox does not ship\nonnxruntime on Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328532\n", "files": ["build/sparse-profiles/toolchain-build", "mots.yaml", "taskcluster/docs/attributes.md", "taskcluster/docs/kinds.md", "taskcluster/kinds/toolchain-dxc-upload/kind.yml", "taskcluster/kinds/toolchain-symbols-upload/kind.yml", "taskcluster/kinds/toolchain/dxc.yml", "taskcluster/kinds/toolchain/onnx.yml", "taskcluster/scripts/misc/build-onnxruntime.sh", "toolkit/crashreporter/tools/symbolstore.py"], "git_node": "5fbfe3d2cda53cb484820f3e75e5266cd91906b9", "git_parents": ["b907d70012508e3402b62bb072529884e12efea8"], "node": "298ee46f581ecf0271e641f0c3d0f39a0d0315ef", "parents": ["41a6bf87dd32d26454666cef6bca61fddbb76d6e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072855 - Don't leak `CC` and `CFLAGS` into the environment of the process reading gyp files r=firefox-build-system-reviewers,nalexander\n\n`GypProcessor` set `CC` and `CFLAGS` in `os.environ` of the calling\nprocess, because the NSS gyp files shell out to `$CC`.\n`./mach mochitest` regenerates the build backend in process through\nmoztest's `BuildBackendLoader`, so both variables stay set for the\nrest of the mach invocation.\n\nThe gradle run in `./mach android install-geckoview-test_runner` then\ninherits `CC`. `MachTasksPlugin`'s `normalizedMachEnv` rewrites it from\nthe `CC` subst, which is a list, as\n`/path/clang,--target=x86_64-linux-android26`, and the reentrant\nconfigure in `:machBuildFaster` fails with\n\"Cannot find the target C compiler\".\n\nGyp files are loaded in `BuildReader`'s `ProcessPoolExecutor` workers,\nso set both variables through the pool's initializer and leave the\nparent's environment alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331520\n", "files": ["python/mozbuild/mozbuild/frontend/gyp_reader.py", "python/mozbuild/mozbuild/frontend/reader.py", "python/mozbuild/mozbuild/test/frontend/data/gyp-env/test.gyp", "python/mozbuild/mozbuild/test/frontend/test_gyp_reader.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "83d58d1452be0799ec074dd6bc23ee7589cd4586", "git_parents": ["5fbfe3d2cda53cb484820f3e75e5266cd91906b9"], "node": "dc54f9b044687f70b350c4a30a04bb28b092de1d", "parents": ["298ee46f581ecf0271e641f0c3d0f39a0d0315ef"], "tags": []}, {"author": "Ben Chatterton \u003cbchatterton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081521: remove target_info refs in dte test tasks, r=aeghtesadi\n\nChange in API call signature on the GHA side caused tests to fail with Unprocessable Entity, this patch lines emitted calls up with expectations. Work is underway to move tests to tree, which will obviate the need for this code sometime soon (ish).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333926\n", "files": ["taskcluster/gecko_taskgraph/transforms/dte_test.py", "taskcluster/kinds/dte-test/kind.yml", "taskcluster/scripts/tests/run_dte_github_tests.py"], "git_node": "64b8e58cee6b52ea728dbc936a742e359c9e9ee6", "git_parents": ["83d58d1452be0799ec074dd6bc23ee7589cd4586"], "node": "6bb32bad211f16cf35e8d1b16efcd9cdb6c5c242", "parents": ["dc54f9b044687f70b350c4a30a04bb28b092de1d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082223 - Log through console.createInstance instead of dump() when updating the HSTS preload list. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333953\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "942dfdae16e99ec24e3e202e72db8260000c5bb4", "git_parents": ["64b8e58cee6b52ea728dbc936a742e359c9e9ee6"], "node": "938dc28e0ef71dfb570fdc9841235c3a67b2428a", "parents": ["6bb32bad211f16cf35e8d1b16efcd9cdb6c5c242"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079255. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334059\n", "files": ["layout/generic/nsBlockFrame.cpp", "testing/web-platform/tests/css/css-multicol/crashtests/block-break-before.html"], "git_node": "84cec52ebaf55d3b51ac86c0853163a71d6310d6", "git_parents": ["942dfdae16e99ec24e3e202e72db8260000c5bb4"], "node": "dd714f6d625795f7f0d5d63a5b1b7eb6794aa599", "parents": ["938dc28e0ef71dfb570fdc9841235c3a67b2428a"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082051 - Don't enter fun_call's realm in the Ion generic call trampoline. r=iain\n\nThe generic call trampoline now only switches realms right before invoking\neither a `JSNative` callee or a JIT callee.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334047\n", "files": ["js/src/jit-test/tests/ion/call-generic-fun-call-realm.js", "js/src/jit/CodeGenerator.cpp"], "git_node": "c95c2b35c94200715690276dd17c2ff868da7947", "git_parents": ["84cec52ebaf55d3b51ac86c0853163a71d6310d6"], "node": "1bca30a498a36fd807673f12cab6aae8c70f5831", "parents": ["dd714f6d625795f7f0d5d63a5b1b7eb6794aa599"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073695 - Hold a strong context reference in more WebGL extension methods. r=gfx-reviewers,nical\" for causing hazard build bustages in ClientWebGLContext.h.\n\nThis reverts commit aca3776a2414c0f601cf2f8c1d8cad49a5117120.\n\nThis reverts commit 8609f249ae9906056364913403c86d4c77e84f84.\n\nThis reverts commit fa13f368ce46f348d7693dd595da3cac8fe8b5a3.\n", "files": ["dom/canvas/ClientWebGLContext.h", "dom/canvas/ClientWebGLExtensions.h"], "git_node": "3dc42292727ff816885f852cbf2ab5125f751741", "git_parents": ["c95c2b35c94200715690276dd17c2ff868da7947"], "node": "a20d6c31dc88611dedf928249f4795a31dc7cb9d", "parents": ["1bca30a498a36fd807673f12cab6aae8c70f5831"], "tags": []}, {"author": "Vijay Budhram \u003cvbudhram@gmail.com\u003e", "branch": "default", "desc": "Bug 2081233 - Return to Sign in when the QR scanner is dismissed without a scan. r=android-reviewers,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333237\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/PairFragment.kt"], "git_node": "1fc1ac056bcdd4f370d2d983c020a10e25cf7d94", "git_parents": ["3dc42292727ff816885f852cbf2ab5125f751741"], "node": "c8c06824d8fa6cd392c097a5ef4e906000541d1b", "parents": ["a20d6c31dc88611dedf928249f4795a31dc7cb9d"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081167 - Support unpremultiplied gradient interpolation in WebRender and use it for SVG gradients. r=firefox-svg-reviewers,longsonr\n\nSVG gradients interpolate stop colors with unpremultiplied alpha while CSS\ngradients use premultiplied alpha. WebRender only supported the latter, which\nmade SVG gradients with stops of varying opacity render differently from the\nblob image path. SWGL's span fast paths do not support unpremultiplied\ninterpolation yet and fall back to the fragment shader.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333676\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/res/ps_quad_gradient.glsl", "gfx/wr/webrender/src/pattern/gradient.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/gradient/conic.rs", "gfx/wr/webrender/src/prim_store/gradient/linear.rs", "gfx/wr/webrender/src/prim_store/gradient/radial.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/gradient_builder.rs", "gfx/wr/webrender_api/src/interned_prims.rs", "gfx/wr/webrender_api/src/prim_geometry.rs", "gfx/wr/wrench/reftests/gradient/reftest.list", "gfx/wr/wrench/reftests/gradient/unpremultiplied-ref.yaml", "gfx/wr/wrench/reftests/gradient/unpremultiplied.yaml", "gfx/wr/wrench/src/yaml_helper.rs", "layout/svg/SVGGeometryFrame.cpp"], "git_node": "0d0737c5cf93927b7cec156747a888e76f686319", "git_parents": ["1fc1ac056bcdd4f370d2d983c020a10e25cf7d94"], "node": "fcadd88c5b2add90ac0bd912bbfbe35c1698614c", "parents": ["c8c06824d8fa6cd392c097a5ef4e906000541d1b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081167 - Support unpremultiplied gradient interpolation in SWGL's gradient span fast paths. r=gfx-reviewers,lsalzman\n\nLinear and radial gradients with unpremultiplied interpolation fell back to the\nfragment shader with SWGL. The span functions now interpolate the\nunpremultiplied colors as before and premultiply each chunk of pixels before\nwriting it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333677\n", "files": ["gfx/wr/glsl-to-cxx/src/hir.rs", "gfx/wr/swgl/src/swgl_ext.h", "gfx/wr/webrender/res/ps_quad_gradient.glsl"], "git_node": "959fc14d5c8ef190f3e13ade22d0e524a1c8b18d", "git_parents": ["0d0737c5cf93927b7cec156747a888e76f686319"], "node": "0700129e2cd076240b05f49e30cd44355e686bb8", "parents": ["fcadd88c5b2add90ac0bd912bbfbe35c1698614c"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079522 - Improve SafeThreadLocal behavior for threads without TLS r=win-reviewers,gstoll\n\nThreads created with THREAD_CREATE_FLAGS_SKIP_LOADER_INIT or as parallel\nloader workers never get a TLS vector.  SafeThreadLocal assumed every\nnon-main thread had one, causing NULL derefs in get() and set().  This\ncrashed in the addition of TakePendingFileHandle(), since every section\nmapping reads the slot, and it has long crashed in\nModuleLoadFrame::ExistsTopFrame and the ModuleLoadFrame constructor, when\ndealing with some AV-created threads.\n\nThis patch:\n\n1. Treats these threads as having no frame and no pending handle\n2. Does not improperly use the main thread's global slot for a second caller\n3. Closes a duplicate patched_NtCreateSection could not stash due to missing\n   TLS.\n\nA thread that has stored nothing now also reads nothing.  Previously, before\nany thread had used TLS, other threads read the main thread's live frame\npointer and kept it in their own slot after it went out of scope.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331831\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/SafeThreadLocal.h", "browser/app/winlauncher/test/TestSafeThreadLocal.cpp"], "git_node": "39cf085ac780c554bd01c74cdf458c3c80636a84", "git_parents": ["959fc14d5c8ef190f3e13ade22d0e524a1c8b18d"], "node": "3ddea4389be4f0000ecc9771c65cde15ecb75766", "parents": ["0700129e2cd076240b05f49e30cd44355e686bb8"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Show edge arrows with the switcher and keep spaces without stories in New Tab thematic spaces - r=thecount\n\nThis patch prepares the New Tab page's themed spaces layout, which splits the page into separate spaces, for an upcoming experiment that adds a widgets-only space and side arrows for moving between spaces.\n\nUntil now, this layout could only use the switcher at the bottom of the page, and the side arrows existed only in a different layout, where they replaced the switcher. A new option in the layout's settings now turns on the side arrows alongside the switcher, placed in the lower third of the window and recolored to stay readable over a wallpaper.\n\nA space is now kept if it has either stories or widgets, so a widgets-only space appears with its widgets filling the full width, and turning off all widgets only removes the spaces that relied on them instead of switching off the whole layout. The page still waits for stories to load before showing the spaces, so it always opens on the intended starting space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332605\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Spaces/Spaces.jsx", "browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamBase.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Spaces.test.jsx"], "git_node": "7212785c2194f02907ce3c096f5823d7230cbe1e", "git_parents": ["39cf085ac780c554bd01c74cdf458c3c80636a84"], "node": "f0066c7af3fa0cd0df76504e19f55be1320cad8c", "parents": ["3ddea4389be4f0000ecc9771c65cde15ecb75766"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Show Recent activity in the thematic space marked for it - r=thecount\n\nThis patch lets the New Tab page's themed spaces layout show Recent activity, the section with pages you visited or bookmarked recently, in a space of its own.\n\nUntil now, Recent activity could only appear in the space the page opens on. A new option in the layout's settings marks the space that should show it, and if no space is marked, Recent activity stays where it was. A space that holds only Recent activity is kept as long as Recent activity is turned on, and it shows the section at full width with no empty stories area.\n\nThis supports an upcoming experiment where Recent activity lives in a separate \"My Stuff\" space next to Home.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332606\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamBase.test.jsx"], "git_node": "fa3e31940389a456640e5dd1285ca6a68e776708", "git_parents": ["7212785c2194f02907ce3c096f5823d7230cbe1e"], "node": "ab97e2bc82680bc94be6613c3408141412d6a070", "parents": ["f0066c7af3fa0cd0df76504e19f55be1320cad8c"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Show the first-slot widget in thematic spaces and let the config name the widget catch-all - r=thecount\n\nThis patch lets the New Tab page's themed spaces layout show a widget as the first card of the main stories section, a placement another layout already supports. Until now, that placement only worked in the other layout, so the themed layout ignored the setting.\n\nNow the themed layout honors the same setting, and the widget shown there is left out of every space's widget area so it never appears twice. A new option in the layout's settings also names the space that collects widgets no space lists, so a widget added later doesn't land on the starting space and push stories down. Without that option nothing changes, and the small Weather widget, which shows in the side area of the page, is now left out of every space so a space can't end up with an empty widget box.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332607\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/selectLayoutRender.test.js"], "git_node": "a7ee5e6ee486ee3afb1ceb0c0cb04f94e15afd89", "git_parents": ["fa3e31940389a456640e5dd1285ca6a68e776708"], "node": "b3cd634a016f1ae1dddf5c502c3eb3abbb0919e2", "parents": ["ab97e2bc82680bc94be6613c3408141412d6a070"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079981 - Keep the New Tab thematic spaces frame within the page width - r=thecount\n\nThis patch stops the New Tab page's themed spaces layout from making the page scroll sideways at certain window widths.\n\nThe area that holds each space's stories and widgets was sized one card column wider than the stories and widgets inside it. Just past the widths where the layout adds another column of cards, that extra width pushed the area past the edges of the window. The area is now sized to exactly fit its stories and widgets, so nothing on screen moves and the sideways scrolling goes away.\n\nThe problem predates the other patches in this stack, and this fix doesn't depend on them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332608\n", "files": ["browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss"], "git_node": "3560e6051067f5cecdee555e1ec8016f9f4a7181", "git_parents": ["a7ee5e6ee486ee3afb1ceb0c0cb04f94e15afd89"], "node": "d3ee31670fb006be76f92fa9a021a0b4b0c66504", "parents": ["b3cd634a016f1ae1dddf5c502c3eb3abbb0919e2"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079902 - Newtab spaces preview modal on hover over tab bar r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333811\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Spaces/Spaces.jsx", "browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss", "browser/extensions/newtab/data/content/assets/spaces-preview-activity.png", "browser/extensions/newtab/data/content/assets/spaces-preview-kit-activity.png", "browser/extensions/newtab/data/content/assets/spaces-preview-kit-stories.png", "browser/extensions/newtab/data/content/assets/spaces-preview-kit-widgets.png", "browser/extensions/newtab/data/content/assets/spaces-preview-stories.png", "browser/extensions/newtab/data/content/assets/spaces-preview-widgets.png", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Spaces.test.jsx"], "git_node": "ecf6b702d06eebf3244fcdb67dbeae65b04d916b", "git_parents": ["3560e6051067f5cecdee555e1ec8016f9f4a7181"], "node": "d1a372e4e1e31c386df82641be3095a063ac2bcc", "parents": ["d3ee31670fb006be76f92fa9a021a0b4b0c66504"], "tags": []}, {"author": "Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e", "branch": "default", "desc": "Bug 2074737: implement webrtc stats targetBitrate and remove totalEncodedBytesTarget r=bwc,webidl,smaug\n\nper discussion in\n  https://github.com/w3c/webrtc-stats/pull/824\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328415\n", "files": ["dom/media/webrtc/WebrtcGlobal.h", "dom/media/webrtc/jsapi/RTCRtpSender.cpp", "dom/media/webrtc/tests/mochitests/stats.js", "dom/webidl/RTCStatsReport.webidl", "testing/web-platform/meta/webrtc-stats/supported-stats.https.html.ini"], "git_node": "acdee14ad3d9779b1a466dd314b6afdf1835f6f3", "git_parents": ["ecf6b702d06eebf3244fcdb67dbeae65b04d916b"], "node": "a55aee672d3d24ab5054dd17fe8acdd25e75a2a8", "parents": ["d1a372e4e1e31c386df82641be3095a063ac2bcc"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082412 - Update PDF.js to 0252c1f6c97df44361646a8158e06dcb8bf9aa33 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334109\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/content/web/wasm/jbig2_nowasm_fallback.js", "toolkit/components/pdfjs/content/web/wasm/openjpeg.wasm", "toolkit/components/pdfjs/content/web/wasm/openjpeg_nowasm_fallback.js", "toolkit/components/pdfjs/moz.yaml"], "git_node": "220c10c45cb54d00f775a6318bbb357008f18899", "git_parents": ["acdee14ad3d9779b1a466dd314b6afdf1835f6f3"], "node": "1e11d0b08149762f067055a382c311605fd956d3", "parents": ["a55aee672d3d24ab5054dd17fe8acdd25e75a2a8"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2069128 - add support for extracting AITab pages r=rrando,mlucks\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329098\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_conversation_stream.js", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/get_page_content/browser.toml", "browser/components/aiwindow/ui/test/browser/get_page_content/browser_get_page_content_errors.js", "browser/components/aiwindow/ui/test/browser/get_page_content/head.js", "toolkit/modules/ActorManagerParent.sys.mjs"], "git_node": "1bd6d7f473e2e43d3baf31eb100bca1819a083eb", "git_parents": ["220c10c45cb54d00f775a6318bbb357008f18899"], "node": "8286f2b461b30c262e62a841fff3ade30dac6056", "parents": ["1e11d0b08149762f067055a382c311605fd956d3"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079419 - Pre: Inline `updateMicrosurveyPromptForConfigurationChange`. r=twhite,android-reviewers\n\nNo other fragment needs this, and there's no advantage to abstracting\nover the \"reinitialize microsurvey prompt\" behaviour.  Just do the\nwork when it's needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331716\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Fragment.kt"], "git_node": "15c3e3fab7f5d182080f3ec99653b37b82edd776", "git_parents": ["1bd6d7f473e2e43d3baf31eb100bca1819a083eb"], "node": "1e459803777555de906e0ecdaacb14867e8b86dd", "parents": ["8286f2b461b30c262e62a841fff3ade30dac6056"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079419 - Pre: Lift some extension methods to apply only to `BaseBrowserFragment`. r=twhite,android-reviewers,petru\n\nThese methods aren't general; they're tightly coupled to\n`BaseBrowserFragment`.  This patch makes that more clear.\n\nMoving these functions required updating some tests.  A detail is that\nwe test against the concrete class `BrowserFragment` rather than the\nabstract `BaseBrowserFragment`.\n\nI elected to keep the \"target name\" (so `BaseBrowserFragment`) rather\nthan a \"functionality name\" (like `BaseBrowserFragmentToolbarHeight`\nor similar), mostly because this patch already has a lot of churn and\nI'd rather the next person in this area not feel the need to add\n_another_ \"functionality name\" extension class if they can use this\none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331717\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Fragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/BaseBrowserFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/FragmentTest.kt"], "git_node": "4ac94eacd6099e33ce3bf67f064c381131dfb5cc", "git_parents": ["15c3e3fab7f5d182080f3ec99653b37b82edd776"], "node": "cc109c81e3ed3b08005a13b22b31041af7c65d39", "parents": ["1e459803777555de906e0ecdaacb14867e8b86dd"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079419 - Replace `Settings.shouldShowMicrosurveyPrompt` with `AppState`. r=android-reviewers,petru\n\nThe preference duplicated `AppState.microsurvey` and added an\nimperative layer to the standard unidirectional data flow.\n\nAlong the way, reinitialize the engine view when showing or hiding the\nprompt so that the insets are up to date.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331718\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/experiments/UninstallSurveyBottomSheetFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/messaging/state/MessagingMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/microsurvey/ui/MicrosurveyBottomSheetFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/BaseBrowserFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/BaseBrowserFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/messaging/state/MessagingMiddlewareTest.kt"], "git_node": "ef87671248755a99f3541dc692c8b765b0dd00d6", "git_parents": ["4ac94eacd6099e33ce3bf67f064c381131dfb5cc"], "node": "39cb41c83cc20482f2c55eec9f7383ef3a014696", "parents": ["cc109c81e3ed3b08005a13b22b31041af7c65d39"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079419 - Post: Remove unused `Settings` from `MessagingMiddleware`. r=twhite,android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331719\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/messaging/state/MessagingMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/messaging/state/MessagingMiddlewareTest.kt"], "git_node": "f3c79a044eda234337ace03da6b9ca97b0870eb6", "git_parents": ["ef87671248755a99f3541dc692c8b765b0dd00d6"], "node": "82cedf441302e47c2d337cdb4f3b95516ec0a06d", "parents": ["39cb41c83cc20482f2c55eec9f7383ef3a014696"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069167 - Add a search action to the text selection menu. r=Standard8,fluent-reviewers,settings-reviewers,tgiles,bolsson,omarg\n\nFor background on the new Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nWires the Search action to `SearchUIUtils.loadSearch`, tagged with the new\n`text_selection` access point, and widens the menu's gate so it shows with\njust Search even when no chatbot is configured.\n\nTo try it manually: flip `browser.highlightToSearch.featureGate` on, select\ntext on any page, and click the search icon in the menu that appears.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331806\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/genai/tests/xpcshell/test_show_chat_entrypoint.js", "browser/components/preferences/config/tabs-browsing.mjs", "browser/components/preferences/tests/browser_tabs_browsing_highlightToSearch.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sources_in_content.js", "browser/locales/en-US/browser/genai.ftl"], "git_node": "e909b87f96a43b460b2ff24d0ef32a306edfcae1", "git_parents": ["f3c79a044eda234337ace03da6b9ca97b0870eb6"], "node": "dafff56f87cda5b6fe2b4b0eee1f19cd6fbb8560", "parents": ["82cedf441302e47c2d337cdb4f3b95516ec0a06d"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082460 - Give UrlbarProviderQuickSuggest the same priority as UrlbarProviderTopSites in the zero prefix view. r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334243\n", "files": ["browser/components/urlbar/UrlbarProviderQuickSuggest.sys.mjs", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_dynamicSuggestions.js"], "git_node": "16ca80cf3ba6f24bc2d57a130652658a4a035f6a", "git_parents": ["e909b87f96a43b460b2ff24d0ef32a306edfcae1"], "node": "dad7e9aec3166934e63af57eaa992d4ab7fbc773", "parents": ["dafff56f87cda5b6fe2b4b0eee1f19cd6fbb8560"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080528 - Add prefs for temporal search suggestions. r=urlbar-reviewers,adw\n\nNothing reads them yet. Nimbus variables come in a later bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332878\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/docs/preferences.md"], "git_node": "d40f094654936b280771217dc70fe61e70223e0a", "git_parents": ["16ca80cf3ba6f24bc2d57a130652658a4a035f6a"], "node": "d2986444876768ba157eedc08ec842f1e1f5a9e2", "parents": ["dad7e9aec3166934e63af57eaa992d4ab7fbc773"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the l10n, l10n-signing and shippable-l10n kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,ahal\n\nThe four kinds carry `run-on-repo-type: [hg]`, so no localization repack\nor signing task is scheduled on a git-backed push. Removing it only changes\nscheduling: the l10n transform still pins the clone to Mercurial, and the\nsigning tasks have no checkout.\n\nVerified on staging-firefox (git-backed) on Oct 12: 3 l10n repacks, 24\nl10n-signing chunks, 25 shippable-l10n chunks and the shippable-l10n mac\nsigning task all completed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333134\n", "files": ["taskcluster/kinds/l10n-signing/kind.yml", "taskcluster/kinds/l10n/kind.yml", "taskcluster/kinds/shippable-l10n-mac-signing/kind.yml", "taskcluster/kinds/shippable-l10n/kind.yml"], "git_node": "5bd6f24e88c3c30e3271c7cc6826d970f8e11061", "git_parents": ["d40f094654936b280771217dc70fe61e70223e0a"], "node": "596b37b87215b4fa92118111aba74c215ca9aea6", "parents": ["d2986444876768ba157eedc08ec842f1e1f5a9e2"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081124 - Run test-apk tasks on git-backed pushes and clone them with Git r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334032\n", "files": ["taskcluster/kinds/test-apk/kind.yml"], "git_node": "da46bdf1cb078b9f416bd71dbe38e893dcd92159", "git_parents": ["5bd6f24e88c3c30e3271c7cc6826d970f8e11061"], "node": "b4f5442a29184c59c037f3ae2f4c3f049c1d79ff", "parents": ["596b37b87215b4fa92118111aba74c215ca9aea6"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081124 - Run test-components tasks on git-backed pushes and clone them with Git r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334033\n", "files": ["taskcluster/kinds/test-components/kind.yml"], "git_node": "011368d0c2a0e70899d1240048646fa0d4001b0e", "git_parents": ["da46bdf1cb078b9f416bd71dbe38e893dcd92159"], "node": "3481a757409ef122c2370f0aac8c995e07e9e554", "parents": ["b4f5442a29184c59c037f3ae2f4c3f049c1d79ff"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081124 - Run android-startup-test tasks on git-backed pushes and clone them with Git r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334034\n", "files": ["taskcluster/kinds/android-startup-test/kind.yml"], "git_node": "73a4d351559e32ab0466bbd938a7cb6c76c37363", "git_parents": ["011368d0c2a0e70899d1240048646fa0d4001b0e"], "node": "786b180437d61176d3033803e4a5f0521bb85f53", "parents": ["3481a757409ef122c2370f0aac8c995e07e9e554"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079891 - Add open Smart Page slug to chat context so that page can be edited. r=mzhang,mlucks,tetchart\n\nAdd dust js style {#\u003cvar\u003e} {/\u003cvar}to allow prompt sections to be enabled when a param exists.\n\nNote we're including the page slug for the Open page, and for @mentions as well\n\nCompanion PR for the prompts (includes prompt changes for one other patch)\nhttps://github.com/Firefox-AI/ai-window-remote-settings-prompts/pull/226\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333281\n", "files": ["browser/components/aiwindow/models/ChatUtils.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab.js", "browser/components/aiwindow/models/tests/xpcshell/test_ChatUtils.js", "browser/components/aiwindow/models/tests/xpcshell/test_PromptLoader_BrowserContext.js", "browser/components/aiwindow/models/tests/xpcshell/test_Utils.js", "browser/components/aiwindow/models/tests/xpcshell/xpcshell.toml", "browser/components/aiwindow/ui/modules/UrlTokenizer.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/t