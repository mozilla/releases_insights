, "media/webrtc/signaling/gtest/jsep_track_unittest.cpp", "media/webrtc/signaling/gtest/sdp_unittests.cpp"], "git_node": "897f6bcbe8b3415882675087dc2e86d69305f7e7", "git_parents": ["f8b7dfde4617f84c3e5697241b97f8304954fca9"], "node": "90bf31bbb23fba82bbccb79065418ad399495e4c", "parents": ["4e71fd69395db2132b2c976cbaf09d5b65975c04"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070346 - update webrtc-sdp to 0.3.16;r=webrtc-reviewers,supply-chain-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333411\n", "files": ["Cargo.lock", "dom/media/webrtc/sdp/rsdparsa_capi/Cargo.toml", "supply-chain/audits.toml", "third_party/rust/webrtc-sdp/.cargo-checksum.json", "third_party/rust/webrtc-sdp/.cargo_vcs_info.json", "third_party/rust/webrtc-sdp/.circleci/config.yml", "third_party/rust/webrtc-sdp/CHANGELOG.md", "third_party/rust/webrtc-sdp/Cargo.lock", "third_party/rust/webrtc-sdp/Cargo.toml", "third_party/rust/webrtc-sdp/Cargo.toml.orig", "third_party/rust/webrtc-sdp/src/attribute_type.rs", "third_party/rust/webrtc-sdp/src/attribute_type_tests.rs", "third_party/rust/webrtc-sdp/src/lib.rs", "third_party/rust/webrtc-sdp/src/media_type.rs", "third_party/rust/webrtc-sdp/src/media_type_tests.rs"], "git_node": "0202bdcd6d090c28634342ee1292d4b783c6f8d8", "git_parents": ["897f6bcbe8b3415882675087dc2e86d69305f7e7"], "node": "87ce3619447e218cc1f10775986ae0ff1f131a1d", "parents": ["90bf31bbb23fba82bbccb79065418ad399495e4c"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072766 - hook up unknown media types in the rsdparsa C API;r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326770\n", "files": ["dom/media/webrtc/sdp/RsdparsaSdpMediaSection.cpp", "dom/media/webrtc/sdp/rsdparsa_capi/src/media_section.rs", "media/webrtc/signaling/gtest/sdp_unittests.cpp"], "git_node": "06e1cac97f4c68223a7c7a2f51f1b2b1edc6cabf", "git_parents": ["0202bdcd6d090c28634342ee1292d4b783c6f8d8"], "node": "213ce03aa0bb8d6afbc42f100a4d18a6067b0331", "parents": ["87ce3619447e218cc1f10775986ae0ff1f131a1d"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072766 - preserve existing Rsdparsa behavior wrt unknown media types;r=dbaker\n\nWe do not want to expose JSEP to unknown types until bug 2072767.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328599\n", "files": ["dom/media/webrtc/sdp/RsdparsaSdpParser.cpp", "dom/media/webrtc/sdp/rsdparsa_capi/src/lib.rs", "media/webrtc/signaling/gtest/sdp_unittests.cpp"], "git_node": "b113597429b3b2ddc104593ddf970279ce51daf4", "git_parents": ["06e1cac97f4c68223a7c7a2f51f1b2b1edc6cabf"], "node": "b78283e2727c2a733b7c6e7c6216061082c3114d", "parents": ["213ce03aa0bb8d6afbc42f100a4d18a6067b0331"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081455 - align handling of OOB AV1 FMTP parameter handling between SDP parsers;r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333412\n", "files": ["dom/media/webrtc/sdp/RsdparsaSdpAttributeList.cpp", "media/webrtc/signaling/gtest/sdp_unittests.cpp"], "git_node": "8506d7ffa5ae5daea4511bbddf9a3b0d41cbda56", "git_parents": ["b113597429b3b2ddc104593ddf970279ce51daf4"], "node": "762ab009541394a8e7bff24693d6a520352d6085", "parents": ["b78283e2727c2a733b7c6e7c6216061082c3114d"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2080669 [wpt PR 63539] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327014, a=testonly\n\nAutomatic update from web-platform-tests\nRestore module-import-referrer-base-url.html test removed by WPT resync (323188@main)\n\n323188@main resynced html/semantics/scripting-1 from WPT upstream. That resync\ndeleted module-import-referrer-base-url.html, which 319921@main added directly\nto imported/w3c and never upstreamed. Restore it.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327014\nWebKit-Canonical-Link: https://commits.webkit.org/323280@main\n\n--\n\nwpt-commits: c5dcc2d1faa2e8ddba636d143220dc07459f9c17\nwpt-pr: 63539\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/module/module-import-referrer-base-url.html"], "git_node": "6becd961ad605027c273fb7159b9c5725bfcc553", "git_parents": ["8506d7ffa5ae5daea4511bbddf9a3b0d41cbda56"], "node": "1838ecbdc50b15fdfdfeb6d6bb4ede859f03a89a", "parents": ["762ab009541394a8e7bff24693d6a520352d6085"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080669 [wpt PR 63539] - Update wpt metadata, a=testonly\n\nwpt-pr: 63539\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/modulepreload-referrerpolicy.html.ini"], "git_node": "3e39b69d7b3537f47b2bf1d82ed21687e611734a", "git_parents": ["6becd961ad605027c273fb7159b9c5725bfcc553"], "node": "e8523762a78bf28a2b56535cc21bd7ece08d6071", "parents": ["1838ecbdc50b15fdfdfeb6d6bb4ede859f03a89a"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2080801 [wpt PR 63549] - [2/N]: WebMCP: Identify tools by a unique ID for unregistration, a=testonly\n\nAutomatic update from web-platform-tests\n[2/N]: WebMCP: Identify tools by a unique ID for unregistration\n\nThis CL gives every WebMCP tool a unique, unguessable, non-web-exposed\n`tool_id`, minted by the registering renderer and carried on\n`blink.mojom.ScriptTool`. The browser verifies that the ID is present\nand unique within a document upon registration, and tools are now\nunregistered by ID rather than by name, through a single\n`ModelContext::UnregisterTool(tool_id)` entry point:\n - An imperative tool's unregister-on-abort algorithm is bound to the\n   ID minted for that tool.\n - A declarative tool's backing `\u003cform\u003e` tool object owns its ID, just\n   as it owns its name, and unregisters with it.\n\nThis fixes a race where unregistering one tool could remove a\n*different* tool registered under the same name. Today this is only\nreachable through declarative tools: a `\u003cform\u003e` whose registration was\nrejected because its name was already taken (by an imperative or\ndeclarative tool) would, upon removal or renaming, unregister by name\nand take out the unrelated tool that owned the name. New WPTs cover\nthis, and fail without this CL.\n\nThe imperative abort path cannot currently hit this race from script:\nan imperative tool can only be unregistered by its own signal, and a\nrejected imperative registration never attaches an abort algorithm.\nIt is moved to IDs for consistency, and to stay correct if another\nunregistration path is ever added.\n\nThis CL does NOT fix the analogous execution-time race: `executeTool()`\nstill targets tools by name, so a stale `RegisteredTool` dictionary can\nexecute a different tool that was since registered under the same\nname. Fixing that requires the forthcoming `Tool` interface, which\ncarries the tool's ID and executes by it.\n\n`tool_id` is optional in mojom for now, since `ScriptTool` is also used\nto describe tools to embedders (APC, the actor), which do not populate\nit yet. Follow-ups will plumb IDs through APC and CDP, and then make\n`tool_id` required.\n\nSee\nhttps://docs.google.com/document/d/1psoB7k71-Dgkxg2tTG62DYJDTg02x8zOS3jCEd0QlbM/edit?tab=t.0.\n\nR=mfoltz\n\nBug: 536063275\nChange-Id: Ia7e0c0c63c7a8078ea96185992d045d0556f8832\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8464671\nReviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nReviewed-by: Alex Moshchuk \u003calexmos@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1716529}\n\n--\n\nwpt-commits: 626f5bf2133dea49f48d15238c03e0a7c34d5c1d\nwpt-pr: 63549\n", "files": ["testing/web-platform/tests/webmcp/declarative/duplicate-tool-name.https.html", "testing/web-platform/tests/webmcp/declarative/name-collision-with-imperative-tool.https.html"], "git_node": "7aa74204ea66fb9e632f4f40c58fd0dab1af4c14", "git_parents": ["3e39b69d7b3537f47b2bf1d82ed21687e611734a"], "node": "218d9c4475ae875ea77302757faf8b60d759a000", "parents": ["e8523762a78bf28a2b56535cc21bd7ece08d6071"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080801 [wpt PR 63549] - Update wpt metadata, a=testonly\n\nwpt-pr: 63549\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/declarative/duplicate-tool-name.https.html.ini", "testing/web-platform/meta/webmcp/declarative/name-collision-with-imperative-tool.https.html.ini"], "git_node": "85ca078a74f9df6c208f417dfca9733d5d7c8de7", "git_parents": ["7aa74204ea66fb9e632f4f40c58fd0dab1af4c14"], "node": "b5d5ceea9d7fe55823c47c471a1229dbaafc6317", "parents": ["218d9c4475ae875ea77302757faf8b60d759a000"], "tags": []}, {"author": "Rulong Chen (\u9648\u6c5d\u9f99) \u003crulongchen@chromium.org\u003e", "branch": "default", "desc": "Bug 2080805 [wpt PR 63461] - [Blink] Clear stale shaping when line breaking overflows, a=testonly\n\nAutomatic update from web-platform-tests\n[Blink] Clear stale shaping when line breaking overflows\n\nBreakText() can retry an existing InlineItemResult at a smaller width\nwhen HandleOverflow() attempts to fit part of a text item. When\nShapeLine() returns no result (kNoResultIfOverflow), the overflow path\nextends the text range to the end of the item but leaves shaping from\nthe previous attempt attached, so the InlineItemResult fails\nCheckConsistency() before HandleOverflow() restores its saved result.\n\nClear the stale shape on this path, restoring the invariant that\nshape_result is null after a no-result overflow. HandleOverflow() always\nrestores its saved result afterwards, so the failure is DCHECK-only and\nrelease layout behavior is unchanged.\n\nGuard the fix with the stable LineBreakerClearShapeResultOnOverflow\nruntime feature so it can be disabled as a kill switch.\n\nAdd a WPT crash test. Fractional letter-spacing advances make the\nshaped width of a fitting break opportunity land one LayoutUnit above\nthe available width, so the HandleOverflow() retry at a smaller width\nreturns no result and the stale shape trips CheckConsistency(). The\ntest passes with the feature enabled and hits the DCHECK when the\nfeature is disabled.\n\nTest: run_web_tests.py external/wpt/css/css-text/crashtests/overflow-wrap-anywhere-fractional-width-crash.html\nFixed: 559557312\nChange-Id: If8485752eb35fc457437e15aec42b593efe9d816\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8389337\nCommit-Queue: Rulong Chen \u003crulongchen@chromium.org\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1716543}\n\n--\n\nwpt-commits: 028866399b4a2cbaa53b416f6caaff955725f290\nwpt-pr: 63461\n", "files": ["testing/web-platform/tests/css/css-text/crashtests/overflow-wrap-anywhere-fractional-width-crash.html"], "git_node": "9c34faecc295ff2670f0e2ba7a9d1a4311a59c68", "git_parents": ["85ca078a74f9df6c208f417dfca9733d5d7c8de7"], "node": "37870b12dfdb9148a03dfa7354a567bb40dbd762", "parents": ["b5d5ceea9d7fe55823c47c471a1229dbaafc6317"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080805 [wpt PR 63461] - Update wpt metadata, a=testonly\n\nwpt-pr: 63461\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/crashtests/eol-spaces-bidi-min-content-crash.html.ini", "testing/web-platform/meta/css/css-text/crashtests/line-break-float-crash.html.ini"], "git_node": "81a68382c3c5bbf4a2fc3e0a06e80fa5319b302c", "git_parents": ["9c34faecc295ff2670f0e2ba7a9d1a4311a59c68"], "node": "dc42d62471dea28c56612c1eeb7cdd113f68912f", "parents": ["37870b12dfdb9148a03dfa7354a567bb40dbd762"], "tags": []}, {"author": "Antonio Sartori \u003cantoniosartori@chromium.org\u003e", "branch": "default", "desc": "Bug 2080392 [wpt PR 63474] - [CSP] Check 'trusted-types-eval' for each policy, a=testonly\n\nAutomatic update from web-platform-tests\n[CSP] Check 'trusted-types-eval' for each policy\n\nFold the 'trusted-types-eval' check into CSPDirectiveListAllowEval(), so\nthat it is performed for each policy, as per spec. Also make sure the\nTrusted Types check always runs before the CSP check.\n\nAs a side effect, this also fixes the problem that trusted-types-eval\nwas not checked for setTimeout() and setInterval().\n\nBug: 571784617, 388437274\nFixed: 571784617\nChange-Id: I6893af968af8f0db6b6db8b636c84113ec1170ad\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8547211\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCommit-Queue: Antonio Sartori \u003cantoniosartori@chromium.org\u003e\nReviewed-by: Mike West \u003cmkwst@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1716577}\n\n--\n\nwpt-commits: 631d9d926eee38a4911f2d4383ccef28e4aee075\nwpt-pr: 63474\n", "files": ["testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_allowed.window.js", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_allowed.window.js.headers", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_blocked.window.js", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_blocked.window.js.headers", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_report_only.window.js", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_report_only.window.js.headers", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_report_only_policies.window.js", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_report_only_policies.window.js.headers", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_report_only_policies_without_default_policy.window.js", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_report_only_policies_without_default_policy.window.js.headers", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_without_default_policy.window.js", "testing/web-platform/tests/content-security-policy/script-src/script-src-trusted_types_eval_without_default_policy.window.js.headers"], "git_node": "36390a07ad8b2f48313225a9160cdad283825509", "git_parents": ["81a68382c3c5bbf4a2fc3e0a06e80fa5319b302c"], "node": "b660ed10b2fd36896aa9eb9865ee63df0e6da78f", "parents": ["dc42d62471dea28c56612c1eeb7cdd113f68912f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080392 [wpt PR 63474] - Update wpt metadata, a=testonly\n\nwpt-pr: 63474\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_blocked.window.js.ini", "testing/web-platform/meta/content-security-policy/script-src/script-src-trusted_types_eval_multiple_policies_report_only.window.js.ini"], "git_node": "b8369e51435f9a61b18b0d1b961d25dd84adab6f", "git_parents": ["36390a07ad8b2f48313225a9160cdad283825509"], "node": "9f1c466d347a0cad1580f46612fde0f8bccc3c49", "parents": ["b660ed10b2fd36896aa9eb9865ee63df0e6da78f"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2080831 [wpt PR 63560] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327216, a=testonly\n\nAutomatic update from web-platform-tests\nMake the secure-contexts shared worker tests expect partitioning\n\nshared-worker-secure-first.https.html and shared-worker-insecure-first.https.html\nexpected a secure and a non-secure context with the same origin to share a\nSharedWorker, so that whichever connects second gets an error. Shared workers\nare partitioned by top-level site, so the two contexts get separate workers\ninstead. The tests now expect that, and are tentative until the HTML standard\nintegrates partitioning.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327216\n\n--\n\nwpt-commits: 1b00390e7609e29ae98cb2251ac860e440e1e8ed\nwpt-pr: 63560\n", "files": ["testing/web-platform/tests/secure-contexts/shared-worker-insecure-first.https.html", "testing/web-platform/tests/secure-contexts/shared-worker-insecure-first.tentative.https.html", "testing/web-platform/tests/secure-contexts/shared-worker-secure-first.https.html", "testing/web-platform/tests/secure-contexts/shared-worker-secure-first.tentative.https.html"], "git_node": "ba802a217763c46f096ce11b2d4f692bb79a0c8d", "git_parents": ["b8369e51435f9a61b18b0d1b961d25dd84adab6f"], "node": "6f018474d17679486525455d8643c6ff61027e5d", "parents": ["9f1c466d347a0cad1580f46612fde0f8bccc3c49"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080831 [wpt PR 63560] - Update wpt metadata, a=testonly\n\nwpt-pr: 63560\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/secure-contexts/shared-worker-insecure-first.tentative.https.html.ini", "testing/web-platform/meta/secure-contexts/shared-worker-secure-first.https.html.ini", "testing/web-platform/meta/secure-contexts/shared-worker-secure-first.tentative.https.html.ini"], "git_node": "bb13258df45b94e0b51c3b8141fea547a3e19ce7", "git_parents": ["ba802a217763c46f096ce11b2d4f692bb79a0c8d"], "node": "8b90d4cf1f64df66177dce52471a6865136b972e", "parents": ["6f018474d17679486525455d8643c6ff61027e5d"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080714 [wpt PR 63546] - Update Test262 tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Test262 tests\n\n--\n\nwpt-commits: cdb6b50247bc54922e3adc29b6fb540fc4ba09e1\nwpt-pr: 63546\n", "files": ["testing/web-platform/tests/third_party/test262/harness/sm/non262-expressions-shell.js", "testing/web-platform/tests/third_party/test262/test/built-ins/Array/prototype/join/number-elements.js", "testing/web-platform/tests/third_party/test262/test/built-ins/JSON/stringify/value-number.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getCollations/collations-supported-by-collator.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getCollations/language-subtag-with-more-than-three-letters.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getCollations/output-array-is-sorted.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getCollations/preferred-from-unicode-extension-true-empty.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getCollations/preferred-from-unicode-extension.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getNumberingSystems/language-subtag-with-more-than-three-letters.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getNumberingSystems/lookup-locale-by-prefix.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getNumberingSystems/output-array.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getNumberingSystems/preferred-from-unicode-extension-true-empty.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getNumberingSystems/preferred-from-unicode-extension.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getNumberingSystems/unsupported-defaults-to-latn.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getTextInfo/language-subtag-with-more-than-three-letters.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getTextInfo/script-metadata-rtl-is-unknown.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getTextInfo/script-metadata-unlisted-language-script-is-rtl.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getTextInfo/script-subtag-missing.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getTextInfo/script-subtag-present.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/getTextInfo/script-unregistered-or-privateuse.js", "testing/web-platform/tests/third_party/test262/test/intl402/Locale/prototype/maximize/language-subtag-with-more-than-three-letters.js", "testing/web-platform/tests/third_party/test262/vendored.toml"], "git_node": "a1fd85425b243bef89d45ab8a9b3bdd1cb961d6f", "git_parents": ["bb13258df45b94e0b51c3b8141fea547a3e19ce7"], "node": "e86e8b6161cad52302398d3a2ccd0156f2f3b442", "parents": ["8b90d4cf1f64df66177dce52471a6865136b972e"], "tags": []}, {"author": "Antonio Sartori \u003cantoniosartori@chromium.org\u003e", "branch": "default", "desc": "Bug 2080410 [wpt PR 63478] - [wpt] Add Permissions Policy WPT for cross-origin grandchild iframe, a=testonly\n\nAutomatic update from web-platform-tests\n[wpt] Add Permissions Policy WPT for cross-origin grandchild iframe\n\nThis CL adds a Web Platform test for Permissions Policy in a\ncross-origin grandchild iframe nested inside an about:blank child.\n\nBug: 571135412\nChange-Id: I30a6146b633b3b5b204457107edad2c0d129128c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8538727\nCommit-Queue: Antonio Sartori \u003cantoniosartori@chromium.org\u003e\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1716587}\n\n--\n\nwpt-commits: 0784e4e7df56c05eaeeeadc1d9fb3ca875d68fbd\nwpt-pr: 63478\n", "files": ["testing/web-platform/tests/permissions-policy/permissions-policy-nested-local-frame-delegation.https.sub.html", "testing/web-platform/tests/permissions-policy/permissions-policy-nested-local-frame-delegation.https.sub.html.headers"], "git_node": "a08bed64aec92f1ee260e3a1ad751a4b5122ffba", "git_parents": ["a1fd85425b243bef89d45ab8a9b3bdd1cb961d6f"], "node": "815c62bc503821922005eefeea61ef6689c2d275", "parents": ["e86e8b6161cad52302398d3a2ccd0156f2f3b442"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080410 [wpt PR 63478] - Update wpt metadata, a=testonly\n\nwpt-pr: 63478\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/permissions-policy/permissions-policy-nested-local-frame-delegation.https.sub.html.ini"], "git_node": "abdef639f07e92d69f8b7c4565c430ce61d93b96", "git_parents": ["a08bed64aec92f1ee260e3a1ad751a4b5122ffba"], "node": "1bd7c25710686bd3c2cc65214ee3077f0b60241e", "parents": ["815c62bc503821922005eefeea61ef6689c2d275"], "tags": []}, {"author": "Tim van der Lippe \u003ctvanderlippe@gmail.com\u003e", "branch": "default", "desc": "Bug 2080859 [wpt PR 63562] - script: Fix assertion failure when track with no cues is rendered, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Fix crash when track with no cues is rendered\n\nA text track without any cues therefore also hasn't set any rules for\nrendering. The debug assert is quite elaborate now, but I think these\nare all the valid scenarios.\n\nFixes #48812\n\nTesting: adds a new crash test\n\nSigned-off-by: Tim van der Lippe \u003ctvanderlippe@gmail.com\u003e\n\n--\nRemove comments from test\n\nCo-authored-by: Martin Robinson \u003cmartin@abandonedwig.info\u003e\nSigned-off-by: Martin Robinson \u003cmartin@abandonedwig.info\u003e\n\n--\n\nwpt-commits: e7931f65624efa795c30be54e93434a8a9e231ec, 049325c5e5bf7fc0889b76884c2b0205602c7a91\nwpt-pr: 63562\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/track/track-element/crashtests/track-element-track-showing-without-cues.html"], "git_node": "bf87685a09f5813f52313f4d8382fd8acc4a5a6e", "git_parents": ["abdef639f07e92d69f8b7c4565c430ce61d93b96"], "node": "d475cf18c645c621f76e01378ca7c5dcffa71634", "parents": ["1bd7c25710686bd3c2cc65214ee3077f0b60241e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080859 [wpt PR 63562] - Update wpt metadata, a=testonly\n\nwpt-pr: 63562\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/crashtests/track-element-src-aborted-load-onerror-crash.html.ini"], "git_node": "e6e7cbeef1758f2452bfde6990f80b43e3ac87d9", "git_parents": ["bf87685a09f5813f52313f4d8382fd8acc4a5a6e"], "node": "0e99efd97688b5bcf624c13405efb8fb746f5c62", "parents": ["d475cf18c645c621f76e01378ca7c5dcffa71634"], "tags": []}, {"author": "Simon Pieters \u003czcorpan@gmail.com\u003e", "branch": "default", "desc": "Bug 2077555 [wpt PR 63204] - Test that timers check CSP synchronously for string handlers, a=testonly\n\nAutomatic update from web-platform-tests\nTest that timers check CSP synchronously for string handlers\n\nSee https://github.com/whatwg/html/issues/13018.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n\n--\n\nwpt-commits: d23d456604e10783099cf322f3c601915d153276\nwpt-pr: 63204\n", "files": ["testing/web-platform/tests/content-security-policy/unsafe-eval/eval-scripts-setTimeout-setInterval-blocked-no-exception.html", "testing/web-platform/tests/content-security-policy/unsafe-eval/eval-scripts-setTimeout-setInterval-cross-realm.html", "testing/web-platform/tests/content-security-policy/unsafe-eval/eval-scripts-setTimeout-setInterval-policy-added-later.html", "testing/web-platform/tests/content-security-policy/unsafe-eval/eval-scripts-setTimeout-setInterval-report-only.html", "testing/web-platform/tests/content-security-policy/unsafe-eval/eval-scripts-setTimeout-setInterval-report-only.html.headers", "testing/web-platform/tests/trusted-types/Window-setTimeout-setInterval-default-policy-before-csp.html", "testing/web-platform/tests/trusted-types/Window-setTimeout-setInterval-default-policy-before-csp.html.headers"], "git_node": "4a5e4880a96b75074dafe7c2132e9ef58a5b8e1d", "git_parents": ["e6e7cbeef1758f2452bfde6990f80b43e3ac87d9"], "node": "31100cd94810e7f570611cb4bb2531bf276a2bb4", "parents": ["0e99efd97688b5bcf624c13405efb8fb746f5c62"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080710 [wpt PR 63545] - Update Wasm tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Wasm tests (core)\n\n--\n\nwpt-commits: 466a71a716d06c605039d48b0cbf545dbb5b4600\nwpt-pr: 63545\n", "files": ["testing/web-platform/tests/wasm/core/js/relaxed-simd/relaxed_dot_product.wast.js"], "git_node": "d50cffb9b21d67af4bdd3ab171b12f1de7cebb33", "git_parents": ["4a5e4880a96b75074dafe7c2132e9ef58a5b8e1d"], "node": "fe9482b0c1751d6fdc31843ddea3b96022855332", "parents": ["31100cd94810e7f570611cb4bb2531bf276a2bb4"], "tags": []}, {"author": "Mike West \u003cmkwst@chromium.org\u003e", "branch": "default", "desc": "Bug 2080884 [wpt PR 63454] - [Web Bundles] Support signature-based SRI., a=testonly\n\nAutomatic update from web-platform-tests\n[Web Bundles] Support signature-based SRI.\n\nWhen implementing Signature-based SRI, we missed the web bundle\nURLLoader specialization. This CL ensures that the relevant headers are\nprocessed in `WebBundleURLLoaderFactory::SendResponseToLoader`, and adds\nunit and web platform tests to lock in the behavior.\n\nBug: 566857543\nChange-Id: Id3497f215e1916a67287484a7eb2ab2aa4db404e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8548513\nCommit-Queue: Mike West \u003cmkwst@chromium.org\u003e\nReviewed-by: Kenichi Ishibashi \u003cbashi@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1716596}\n\n--\n\nwpt-commits: 2ae6a7125f0bd5075487e2bdda89dbdc82c5b7ee\nwpt-pr: 63454\n", "files": ["testing/web-platform/tests/web-bundle/resources/sri-message-signatures-bundle.py", "testing/web-platform/tests/web-bundle/subresource-loading/sri-message-signatures.https.tentative.html"], "git_node": "31760ef3ffda6eae9328a5583aea76217a868740", "git_parents": ["d50cffb9b21d67af4bdd3ab171b12f1de7cebb33"], "node": "ecf07a8d7005cb7a1459dbb4c93bd2f1718d4b31", "parents": ["fe9482b0c1751d6fdc31843ddea3b96022855332"], "tags": []}, {"author": "injun choi \u003ctkfydtls464@gmail.com\u003e", "branch": "default", "desc": "Bug 2080577 [wpt PR 63521] - Prevent menulist backdrops from intercepting pointer events, a=testonly\n\nAutomatic update from web-platform-tests\nPrevent menulist backdrops from intercepting pointer events\n\nThe popover backdrop UA rule requires a popover attribute, so it\nmisses menulist elements that are popovers by default. Add a menulist\nrule to apply pointer-events: none !important.\n\nExtend the existing WPT to check clicks outside a menulist before\nand after opening it, and run it in the overlay-disabled suite.\n\nBug: 406566432\nFixed: 571624240\nChange-Id: Ib7ef04af6ac74b53b9c322d5d62497be3f288543\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8547933\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1716611}\n\n--\n\nwpt-commits: 4e88a8f53b08f7944323a8501ca602a52b679f29\nwpt-pr: 63521\n", "files": ["testing/web-platform/tests/html/semantics/menu/tentative/menulist-popover-attribute.html"], "git_node": "ac65ac0f7b5f016cfb206d937f91c51a248c2fd3", "git_parents": ["31760ef3ffda6eae9328a5583aea76217a868740"], "node": "dafd5e4db07922f5ac1478471371b824924cad85", "parents": ["ecf07a8d7005cb7a1459dbb4c93bd2f1718d4b31"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080577 [wpt PR 63521] - Update wpt metadata, a=testonly\n\nwpt-pr: 63521\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/menu/tentative/menulist-popover-attribute.html.ini"], "git_node": "9ba09b065d95bf99cc7c30bd1bc0bcb675f57e8f", "git_parents": ["ac65ac0f7b5f016cfb206d937f91c51a248c2fd3"], "node": "53a06a0e4607de725fdb88aea425aab618e80cda", "parents": ["dafd5e4db07922f5ac1478471371b824924cad85"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2080517 [wpt PR 63501] - Remove stray end tags from WPT tests, a=testonly\n\nAutomatic update from web-platform-tests\nRemove stray end tags from WPT tests\n\nThese files carry end tags the HTML parser has no matching open element\nfor. The parser discards each of them, so the source suggests a nesting\nthe DOM never had.\n\nDrop the redundant tags. This is a source-readability fix with no\nbehavioral effect.\n\nBug: 542686202\nChange-Id: I5e82e04d35f54ac8f8a300fdb3f209ab8a39a852\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8219448\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Ana Sollano Kim \u003cansollan@microsoft.com\u003e\nCommit-Queue: Ana Sollano Kim \u003cansollan@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1715782}\n\n--\n\nwpt-commits: 2a13b3b97cd15b331d666b0004e2800ffd322627\nwpt-pr: 63501\n", "files": ["testing/web-platform/tests/animation-worklet/worklet-animation-local-time-null-2-ref.html", "testing/web-platform/tests/core-aam/role/roles-contextual.html", "testing/web-platform/tests/dom/observable/tentative/idlh