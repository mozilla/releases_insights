 during ancestor propagation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334881\n", "files": ["dom/base/Element.cpp"], "git_node": "60842536456b70794e326094c99f22c14c27bae2", "git_parents": ["3b8de05a9b6541219eb21d3d815c9db1935c9c29"], "node": "1c59daa129180cce8b45b9572d042af0ed2c701b", "parents": ["dffe2a206eac7a4a866886b0337c5224eacfcd53"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2083558 - Use main-thread atomization for dataset writes. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334878\n", "files": ["dom/html/nsDOMStringMap.cpp"], "git_node": "ca475a552582a50e9c22c6a57d4772008f798aba", "git_parents": ["60842536456b70794e326094c99f22c14c27bae2"], "node": "5516a463876c8b8bd6057029b200c75c85f09447", "parents": ["1c59daa129180cce8b45b9572d042af0ed2c701b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080609 - Allow window decorations to go outside the screen edges in AppWindow::SetSpecifiedSize. r=gtk-reviewers,stransky\n\nThis matches previous behavior, except the previous behavior was\nbasically accidental, because we didn't know our CSD offset yet\nby the time we got called.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334978\n", "files": ["xpfe/appshell/AppWindow.cpp"], "git_node": "2c89c69a9e8adc21771366a128b7cfb851a89f43", "git_parents": ["ca475a552582a50e9c22c6a57d4772008f798aba"], "node": "2cecdb2993bd13afd49f7ecdf0e2de6a44dda515", "parents": ["5516a463876c8b8bd6057029b200c75c85f09447"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2083556 - Avoid unused attribute value snapshots. r=emilio\n\nCompare before serializing old values; retain new values for hooks and callbacks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334872\n", "files": ["dom/base/Element.cpp"], "git_node": "77e02d149e58ecdddb8d4cbed050623233c2af5d", "git_parents": ["2c89c69a9e8adc21771366a128b7cfb851a89f43"], "node": "4345e7fa834e8ab5dc6ef6d14c33d735bf14d4b4", "parents": ["2cecdb2993bd13afd49f7ecdf0e2de6a44dda515"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2083588 - Bug 2083372 - Check namespaces before atomizing removal names. r=emilio\n\nUnknown namespaces cannot contain attributes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334877\n", "files": ["dom/base/Element.cpp"], "git_node": "0780b348e769c9b8a51e0af9983a6fd55885286b", "git_parents": ["77e02d149e58ecdddb8d4cbed050623233c2af5d"], "node": "4e5b0ddf75a8199eb82245cbd940420f277336d6", "parents": ["4345e7fa834e8ab5dc6ef6d14c33d735bf14d4b4"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2082901 - remove no-nova test variant. r=perftest-reviewers,kshampur,sclements\n\nConverted from \"nova\" to \"no-nova\" test variant in bug 2057643.\nThis reverts commit 1da44cc362e8c8850b2fbcf8d5e1af802342f039.\n\n\"nova\" test variant had been added in bug 2043602\nThis also reverts commit 2cbd17ec23bb76d88db92a14fc13ffda01ebb20b.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334566\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/kinds/test/talos.yml", "taskcluster/test_configs/variants.yml", "testing/perfdocs/generated/raptor.md", "testing/perfdocs/generated/talos.md", "testing/raptor/browsertime/support-scripts/speedometer3.py", "testing/talos/talos/run_tests.py"], "git_node": "60a845608c61afc2ca5a08ea54f9e113932936af", "git_parents": ["0780b348e769c9b8a51e0af9983a6fd55885286b"], "node": "2c68b558cc9e63d54060b9bfd1d048f178a861ea", "parents": ["4e5b0ddf75a8199eb82245cbd940420f277336d6"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2082901 - remove nova test manifests. r=sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334567\n", "files": ["browser/base/content/test/browser-maximized/browserNova.toml", "browser/base/content/test/browser-performance/browserNova.toml", "browser/base/content/test/browser-performance/moz.build", "browser/base/moz.build"], "git_node": "713fa82222297156fccd17d952ffde4fef6fa01c", "git_parents": ["60a845608c61afc2ca5a08ea54f9e113932936af"], "node": "3cad0b3af6c9533a7cd5645b39afc24e318a2e25", "parents": ["2c68b558cc9e63d54060b9bfd1d048f178a861ea"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2082901 - remove nova condition from test annotations after no-nova stops running. r=sclements,fxview-reviewers,mlucks\n\nAnnotation to skip for bug 2058027 removed as the bug has been set as fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334568\n", "files": ["browser/base/content/test/browser-static/browser.toml", "browser/base/content/test/browser-webrtc/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/asrouter/tests/browser/browser.toml", "browser/components/customizableui/test/browser.toml", "browser/components/firefoxview/tests/browser/browser.toml", "browser/components/reportbrokensite/test/browser/browser.toml", "browser/components/taskbartabs/test/browser/browser.toml", "browser/components/uitour/test/browser.toml"], "git_node": "c21d90f63280d115e2b4c2fb5b23b2b17c01727e", "git_parents": ["713fa82222297156fccd17d952ffde4fef6fa01c"], "node": "116c41b1a0c2c959ccdca7d1fd26fa476b3d1bbf", "parents": ["3cad0b3af6c9533a7cd5645b39afc24e318a2e25"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2082901 - remove nova boolean variable from test annotation environment. r=sclements\n\nno-nova testing tasks have been removed and the variable always yields 'True'.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334569\n", "files": ["testing/mochitest/runtests.py"], "git_node": "5f0f8f74b40d479ef91f7801c3c67fb84888fe9b", "git_parents": ["c21d90f63280d115e2b4c2fb5b23b2b17c01727e"], "node": "1b719807aac0d0ea3f827707184cfef085e3b94d", "parents": ["116c41b1a0c2c959ccdca7d1fd26fa476b3d1bbf"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083641. Add a gfx critical note when a Windows Shell icon call is still running at ImageIO shutdown. r=jstutte\n\nBug 2019907 is a shutdown hang waiting on the ImageIO thread, which is stuck\nin SHGetFileInfoW. We don't know if these calls get stuck during shutdown, or\nif they got stuck mid-session and shutdown just finds them. The fix depends on\nwhich, so record how long the call has been running and whether it started\nduring shutdown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335072\n", "files": ["image/DecodePool.cpp", "image/DecodePool.h", "image/decoders/icon/win/nsIconChannel.cpp"], "git_node": "d625c3ba2183e792152f2f3c63cd6acbf42339f2", "git_parents": ["5f0f8f74b40d479ef91f7801c3c67fb84888fe9b"], "node": "06fce7184d325a5712f148c6bf4b78c775d41543", "parents": ["1b719807aac0d0ea3f827707184cfef085e3b94d"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2082901 - remove nova test annotation from browser/components/aiwindow/ui/test/browser/get_page_content/browser.toml\n", "files": ["browser/components/aiwindow/ui/test/browser/get_page_content/browser.toml"], "git_node": "98b7082d30cdef6c08d4e2a030f97645a12e6d98", "git_parents": ["d625c3ba2183e792152f2f3c63cd6acbf42339f2"], "node": "4162b81064be3b8a97b8af9deab8cb969ddcc555", "parents": ["06fce7184d325a5712f148c6bf4b78c775d41543"], "tags": []}, {"author": "Masanari Mizuno \u003cmznms@primu.la\u003e", "branch": "default", "desc": "Bug 1662461 - Make \"Measure and save\" in about:memory work on Android. r=firefox-desktop-core-reviewers ,mossop\n\nGeckoView's file picker doesn't implement appendFilter() or save mode, and\ndoesn't keep defaultString, so the button threw before reaching the Android\nfallback, and the fallback would then have written to the downloads directory\nitself. Only configure the picker once init() has succeeded, and show fallback\nerrors on the page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332071\n", "files": ["toolkit/components/aboutmemory/content/aboutMemory.js", "toolkit/components/aboutmemory/tests/chrome.toml", "toolkit/components/aboutmemory/tests/test_aboutmemory8.xhtml"], "git_node": "950ae050adafb651ca26d754baf6bb589da8c5f9", "git_parents": ["98b7082d30cdef6c08d4e2a030f97645a12e6d98"], "node": "2164569f7ba1ee18acc0c0084f2060333643530b", "parents": ["4162b81064be3b8a97b8af9deab8cb969ddcc555"], "tags": []}, {"author": "Mathew Hodson \u003cmathew.hodson@gmail.com\u003e", "branch": "default", "desc": "Bug 2077817 - Fix warnings for unreferenced code in installer r=browser-installer-reviewers,cdupuis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330580\n", "files": ["browser/installer/windows/nsis/installer.nsi", "browser/installer/windows/nsis/stub.nsh", "browser/installer/windows/nsis/uninstaller.nsi"], "git_node": "7edec0dedd616e4cc20b0a03dff4f2c2d6aa4a7d", "git_parents": ["950ae050adafb651ca26d754baf6bb589da8c5f9"], "node": "96983ca272c93bd5dbd8e1b1c72d1c6143c15050", "parents": ["2164569f7ba1ee18acc0c0084f2060333643530b"], "tags": []}, {"author": "Mathew Hodson \u003cmathew.hodson@gmail.com\u003e", "branch": "default", "desc": "Bug 2080387 - Fix #define guards that confuse clang-format r=sergesanspaille,necko-reviewers,media-playback-reviewers,sunil,padenot\n\nDefining a value for the #define guard in a header confused\nclang-format, which then indented all the includes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332634\n", "files": ["dom/canvas/QueueParamTraits.h", "dom/ipc/ContentProcess.h", "dom/media/gmp/GMPProcessParent.h", "hal/HalInternal.h", "ipc/testshell/TestShellChild.h", "ipc/testshell/TestShellParent.h", "js/xpconnect/src/XPCWrapper.h", "netwerk/streamconv/converters/nsHTTPCompressConv.h"], "git_node": "2b63c2a6b86167f5384a5e94b1af4d53984c079a", "git_parents": ["7edec0dedd616e4cc20b0a03dff4f2c2d6aa4a7d"], "node": "37c6d16352a081457f2f742985877d25ee2fd1d4", "parents": ["96983ca272c93bd5dbd8e1b1c72d1c6143c15050"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078458 - Update harfbuzz to 14.6.0 r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330953\n", "files": ["gfx/harfbuzz/NEWS", "gfx/harfbuzz/moz.yaml", "gfx/harfbuzz/src/OT/Color/COLR/COLR.hh", "gfx/harfbuzz/src/OT/Color/COLR/colrv1-closure.hh", "gfx/harfbuzz/src/OT/Color/COLR/colrv1-depend.hh", "gfx/harfbuzz/src/OT/Color/CPAL/CPAL.hh", "gfx/harfbuzz/src/OT/Layout/Common/Coverage.hh", "gfx/harfbuzz/src/OT/Layout/Common/CoverageFormat1.hh", "gfx/harfbuzz/src/OT/Layout/Common/CoverageFormat2.hh", "gfx/harfbuzz/src/OT/Layout/Common/RangeRecord.hh", "gfx/harfbuzz/src/OT/Layout/GDEF/GDEF.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/AnchorMatrix.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/CursivePos.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/CursivePosFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/LigatureArray.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/MarkArray.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/MarkBasePosFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/MarkLigPosFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/MarkMarkPosFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/MarkRecord.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/PairPosFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/PairPosFormat2.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/PairSet.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/SinglePos.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/SinglePosFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/SinglePosFormat2.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/AlternateSubst.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/AlternateSubstFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/LigatureSet.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/LigatureSubst.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/LigatureSubstFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/MultipleSubstFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/ReverseChainSingleSubst.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/ReverseChainSingleSubstFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/SingleSubstFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/SingleSubstFormat2.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/SubstLookup.hh", "gfx/harfbuzz/src/OT/Layout/types.hh", "gfx/harfbuzz/src/OT/Var/VARC/VARC.cc", "gfx/harfbuzz/src/OT/Var/VARC/VARC.hh", "gfx/harfbuzz/src/OT/glyf/CompositeGlyph.hh", "gfx/harfbuzz/src/OT/glyf/Glyph.hh", "gfx/harfbuzz/src/OT/glyf/SimpleGlyph.hh", "gfx/harfbuzz/src/OT/glyf/SubsetGlyph.hh", "gfx/harfbuzz/src/OT/glyf/composite-iter.hh", "gfx/harfbuzz/src/OT/glyf/glyf-helpers.hh", "gfx/harfbuzz/src/OT/glyf/glyf.hh", "gfx/harfbuzz/src/OT/glyf/loca.hh", "gfx/harfbuzz/src/OT/glyf/path-builder.hh", "gfx/harfbuzz/src/graph/classdef-graph.hh", "gfx/harfbuzz/src/graph/coverage-graph.hh", "gfx/harfbuzz/src/graph/graph.hh", "gfx/harfbuzz/src/graph/gsubgpos-graph.hh", "gfx/harfbuzz/src/graph/ligature-graph.hh", "gfx/harfbuzz/src/graph/markbasepos-graph.hh", "gfx/harfbuzz/src/graph/pairpos-graph.hh", "gfx/harfbuzz/src/graph/test-classdef-graph.cc", "gfx/harfbuzz/src/hb-algs.hh", "gfx/harfbuzz/src/hb-cache.hh", "gfx/harfbuzz/src/hb-cff-interp-common.hh", "gfx/harfbuzz/src/hb-ft.cc", "gfx/harfbuzz/src/hb-machinery.hh", "gfx/harfbuzz/src/hb-open-file.hh", "gfx/harfbuzz/src/hb-open-type.hh", "gfx/harfbuzz/src/hb-ot-cff-common.hh", "gfx/harfbuzz/src/hb-ot-