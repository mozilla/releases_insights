: "bc1596f8e808f360573273b6aec1dfe4baa3e89b", "git_parents": ["1a4ee4916059178a468ef0f209293a8007f7e91b"], "node": "f003031f8d0a5d6daba78b3f1eac69e5f3610476", "parents": ["463065679a6bc72fd3e841de06814025d2d3fdd6"], "tags": []}], "date": 1792589569, "git_changesets": ["bc1596f8e808f360573273b6aec1dfe4baa3e89b"], "user": "ffxbld@lando.moz.tools"}, "45616": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4c4b0235df91b5e9a0e0e5060f00ab63f78a6ef7 with FIREFOX_RELEASE_158_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7d3a9915b0b9df810a64811d650694467f8d18ac", "git_parents": ["bc1596f8e808f360573273b6aec1dfe4baa3e89b"], "node": "3476bf309f94e23bc6ef5abe90178543b479e85a", "parents": ["f003031f8d0a5d6daba78b3f1eac69e5f3610476"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 7a806ef0f9e3a96c5609497ccbcad86696b98e83 with FIREFOX_RELEASE_159_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "402e780d98c9154f66218c566f53852dac9a548d", "git_parents": ["7d3a9915b0b9df810a64811d650694467f8d18ac"], "node": "d71fc18f7799a98c786f64799eb7d09f66ee766a", "parents": ["3476bf309f94e23bc6ef5abe90178543b479e85a"], "tags": []}], "date": 1792592748, "git_changesets": ["7d3a9915b0b9df810a64811d650694467f8d18ac", "402e780d98c9154f66218c566f53852dac9a548d"], "user": "ffxbld@lando.moz.tools"}, "45617": {"changesets": [{"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2081513 - pre-process alpha3 voices to apply filtering correctly r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333452\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SpeechSynthesizer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/synthesis/AndroidTtsSpeechSynthesizerTest.kt"], "git_node": "f586b026affbe2bed6630670c3a936a2aa4582c9", "git_parents": ["0f76fed7aea1f77db85afbf5a895754d8ad971d7"], "node": "63ab33c75d654028df1ba8b7e65e137188916476", "parents": ["f62de275299e8e64e7cb1ee2dd76e025f255beba"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083600 - Only read the _tags column in rowsToItemsArray for queries that select it. r=places-reviewers,daisuke\n\nProbing for the column in a try/catch made mozStorageRow warn for every row of\nthe other bookmark queries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335242\n", "files": ["toolkit/components/places/Bookmarks.sys.mjs"], "git_node": "f954f2a0a37174961b6a0c22427394632670d51a", "git_parents": ["f586b026affbe2bed6630670c3a936a2aa4582c9"], "node": "134d1597490dad8df908e486784f6a1f6c45bb9f", "parents": ["63ab33c75d654028df1ba8b7e65e137188916476"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Implement CSSNumericValue.mul(); r=emilio,firefox-style-system-reviewers\n\nImplement CSSNumericValue.mul() according to the CSS Typed OM specification.\n\nIntroduce an internal Mul() overload to share the multiplication algorithm with\nthe upcoming div() implementation. Use a dedicated helper to handle the\nunit-value computations, keeping the simplification steps closely aligned with\nthe specification.\n\nExtend CSSMathProduct::Create() to support constructing products from already\nvalidated DOM numeric values, without requiring an intermediate Stylo\nrepresentation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334268\n", "files": ["layout/style/typedom/CSSMathProduct.cpp", "layout/style/typedom/CSSMathProduct.h", "layout/style/typedom/CSSNumericValue.cpp", "layout/style/typedom/CSSNumericValue.h", "layout/style/typedom/CSSUnitValue.cpp", "layout/style/typedom/CSSUnitValue.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini"], "git_node": "9c54d5657e1ba47903e47640842cf50c8226e3b3", "git_parents": ["f954f2a0a37174961b6a0c22427394632670d51a"], "node": "c92c4ae289a5e5c56ea190f736356b0a01936498", "parents": ["134d1597490dad8df908e486784f6a1f6c45bb9f"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Implement CSSNumericValue.div(); r=emilio,firefox-style-system-reviewers\n\nImplement CSSNumericValue.div() according to the CSS Typed OM specification.\n\nReuse the internal Mul() algorithm after inverting the arguments. Introduce an\nInvert() helper implementing the corresponding specification algorithm,\nincluding handling division by zero.\n\nExtend CSSMathInvert::Create() to support constructing inversions directly from\nDOM numeric values, without requiring an intermediate Stylo representation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334269\n", "files": ["layout/style/typedom/CSSMathInvert.cpp", "layout/style/typedom/CSSMathInvert.h", "layout/style/typedom/CSSNumericValue.cpp", "layout/style/typedom/CSSNumericValue.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini"], "git_node": "a73a79c5c264459a6061b191b80f29e11d224f9e", "git_parents": ["9c54d5657e1ba47903e47640842cf50c8226e3b3"], "node": "64586301986881b489ede7074027682d6134caea", "parents": ["c92c4ae289a5e5c56ea190f736356b0a01936498"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082785 - [wptrunner] Set the Local Network Access address-space override prefs for Firefox. r=jgraham\n\nAll wptserve servers listen on 127.0.0.1, so without the overrides every\norigin is loopback and the LNA \"without permission\" tests cannot fail as\nexpected. Chrome already gets the equivalent through\n--ip-address-space-overrides. Gecko CI only passed thanks to hardcoded\nprefs in the LNA __dir__.ini, which upstream runs never apply.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334594\n", "files": ["testing/web-platform/meta/fetch/local-network-access/__dir__.ini", "testing/web-platform/meta/fetch/local-network-access/iframe-opener.tentative.https.html.ini", "testing/web-platform/meta/infrastructure/assumptions/non-local-ports.sub.window.js.ini", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py"], "git_node": "745d7dd0d782bfe525c9ca1587f9e22ecdc3211b", "git_parents": ["a73a79c5c264459a6061b191b80f29e11d224f9e"], "node": "cfebaabbc95b1dff82a5062f14e92700431e22d2", "parents": ["64586301986881b489ede7074027682d6134caea"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078254 [Linux] Respect nsWindow::MakeFullScreen() return state and disable fullscreen for xx-pip r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331961\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "a5c952027db13ab42ee87d6167885f060e9db04b", "git_parents": ["745d7dd0d782bfe525c9ca1587f9e22ecdc3211b"], "node": "32eb5cd92ce481b60b34aa74300752c96f65f833", "parents": ["cfebaabbc95b1dff82a5062f14e92700431e22d2"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083644 - Attribute reftest crashes to the manifest being run. r=layout-reviewers,dshin\n\nWhen running by manifest, the crash's test can't be mapped to a group in\nerrorsummary.log: the harness reports \"a.html\" for \"a.html == b.html\", or the\nmanifest URL for crashes outside of a test, so these crashes ended up in an\nempty group.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335082\n", "files": ["layout/tools/reftest/runreftest.py", "layout/tools/reftest/selftest/python.toml", "layout/tools/reftest/selftest/test_reftest_output.py", "layout/tools/reftest/selftest/test_run_by_manifest.py"], "git_node": "5e0e174b1edd4d9a1bf1cf0fe07f002900650d14", "git_parents": ["a5c952027db13ab42ee87d6167885f060e9db04b"], "node": "8bdf8fe436f76511dedbb45ebdff2ca9ee556d0b", "parents": ["32eb5cd92ce481b60b34aa74300752c96f65f833"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083646 - Don't end the reftest suite after the first crash when running by manifest. r=layout-reviewers,emilio\n\nThe suite_end logged after a crash ended the suite while the remaining\nmanifests were still to be run, so errorsummary.log only got group results\nfor the manifests run up to the first crash, and the later suite_end\nmessages were rejected by the logger. runSerialTests already logs suite_end\nonce all manifests have run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335083\n", "files": ["layout/tools/reftest/runreftest.py", "layout/tools/reftest/selftest/test_reftest_output.py"], "git_node": "3f80605d257b00121e1784ab84958ebfc2fe1909", "git_parents": ["5e0e174b1edd4d9a1bf1cf0fe07f002900650d14"], "node": "a762f23b38375467fe65ff3383f8c703bbdea7e8", "parents": ["8bdf8fe436f76511dedbb45ebdff2ca9ee556d0b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078306 - Fix some warnings in the new path tiler. r=nical,gfx-reviewers\n\nFixes use of deprecated constant `std::u16::MAX`: replaced by the `MAX`\nassociated constant on this type\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335570\n", "files": ["gfx/wr/webrender/src/path_tiler.rs"], "gi