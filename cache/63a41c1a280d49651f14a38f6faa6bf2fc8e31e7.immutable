jxl", "third_party/rust/jxl/tests/testdata/truncated_squeeze_missing_avg.jxl", "third_party/rust/jxl_macros/.cargo-checksum.json", "third_party/rust/jxl_macros/.cargo_vcs_info.json", "third_party/rust/jxl_macros/Cargo.lock", "third_party/rust/jxl_macros/Cargo.toml", "third_party/rust/jxl_macros/Cargo.toml.orig", "third_party/rust/jxl_macros/README.md", "third_party/rust/jxl_simd/.cargo-checksum.json", "third_party/rust/jxl_simd/.cargo_vcs_info.json", "third_party/rust/jxl_simd/Cargo.lock", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/Cargo.toml.orig", "third_party/rust/jxl_simd/README.md", "third_party/rust/jxl_simd/src/lib.rs", "third_party/rust/jxl_simd/src/x86_64/avx.rs", "third_party/rust/jxl_simd/src/x86_64/avx512.rs", "third_party/rust/jxl_simd/src/x86_64/sse42.rs", "third_party/rust/jxl_transforms/.cargo-checksum.json", "third_party/rust/jxl_transforms/.cargo_vcs_info.json", "third_party/rust/jxl_transforms/Cargo.lock", "third_party/rust/jxl_transforms/Cargo.toml", "third_party/rust/jxl_transforms/Cargo.toml.orig", "third_party/rust/jxl_transforms/README.md", "third_party/rust/jxl_transforms/src/transform.rs"], "git_node": "4ca6aedd9dbd063c7086f147fd9018f4776a4da8", "git_parents": ["fcf6b147c29168d43121714207d87821abaed4c8"], "node": "36d1eb7967a031a8acb4b562f2ad22922349af91", "parents": ["9a426fcd7fcdff259eff05dff7ab20867c98ab74"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083544. Reapply the jxl_simd macOS x86_64 workaround on top of 0.8.0. r=saschanaz,supply-chain-reviewers,gfx-reviewers,bradwerth\n\nThis re-applies the bug 2043090 macOS x86_64 workaround.\n\nThe only change to jxl_simd's src/x86_64/avx.rs and avx512.rs between 0.7.4\nand 0.8.0 makes the U64VecAvx/U64VecAvx512 tuple fields private, which the\nworkaround doesn't touch, so it forward-ports with no adaptation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335588\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/src/x86_64/avx.rs", "third_party/rust/jxl_simd/src/x86_64/avx512.rs"], "git_node": "311127159a6ac56b75b430050728b2c9ebe4118f", "git_parents": ["4ca6aedd9dbd063c7086f147fd9018f4776a4da8"], "node": "22f658fd6db5f711752b7e384fe882e1751ee86a", "parents": ["36d1eb7967a031a8acb4b562f2ad22922349af91"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083544. Adapt jxl_decoder to the event-based jxl-rs 0.8.0 JxlDecoder API. r=saschanaz,gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335589\n", "files": ["image/rust/jxl/src/decoder.rs", "image/rust/jxl/src/ffi.rs"], "git_node": "5f0afda0858cc0842cdc04a49e940af21cd59074", "git_parents": ["311127159a6ac56b75b430050728b2c9ebe4118f"], "node": "1988a60a13ab830553ad09af61deeda910427358", "parents": ["22f658fd6db5f711752b7e384fe882e1751ee86a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083544. Bump fuzz slightly for jxl-rs 0.8 upgrade. r=gfx-reviewers,nical\n\njxl-rs 0.8.0 reworked how decoded samples are converted to 8-bit output,\nmoving the conversion and dithering into the pipeline's save stage\n(https://github.com/libjxl/jxl-rs/pull/1014, plus a smaller pipeline\nrewrite in https://github.com/libjxl/jxl-rs/pull/1017). This shifts which\npixels round up or down by one, so the progressive tests differ from\ntheir references in more pixels than before, though by no larger an\namount. This is an expected consequence of the upstream change, not a\ndecoding regression.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335878\n", "files": ["testing/web-platform/tests/jpegxl/progressive-1.html", "testing/web-platform/tests/jpegxl/progressive-2.html", "testing/web-platform/tests/jpegxl/progressive-3.html"], "git_node": "cf137295b6936b94dbd0f853504361c5646a318f", "git_parents": ["5f0afda0858cc0842cdc04a49e940af21cd59074"], "node": "e515d640c561b3990f54e8cd93f29c5ee9c36583", "parents": ["1988a60a13ab830553ad09af61deeda910427358"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2082386 - Speed up BigInt division on AArch64 devices r=mgaudet\n\nAArch64 lacks a two-word division instruction, so it's much faster there\nto multiply by an inverse than to divide.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334073\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "ba0643e9095b7bdeccc68262aa2549c1c66b1ae8", "git_parents": ["cf137295b6936b94dbd0f853504361c5646a318f"], "node": "142e6c4b4e562bda49d85fffe9e5d3b9ca8957ef", "parents": ["e515d640c561b3990f54e8cd93f29c5ee9c36583"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084391: Use the project's own run-on-projects for desktop nightlies outside of Try. r=releng-reviewers,taskgraph-reviewers,jcristau\n\nSince bug 2052329, the desktop nightly target tasks map the release type to a project. That raises for project branches with their own release type (`nightly-pine`, `nightly-oak`, `nightly-cypress`, `nightly-larch`), so a nightly decision task on those branches fails, as it did on Pine. Only Try needs the mapping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335814\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/test/test_target_tasks.py"], "git_node": "8140fe07303e1dd450277ebd9029a30e8cef2b2f", "git_parents": ["ba0643e9095b7bdeccc68262aa2549c1c66b1ae8"], "node": "8763eed900d732948acaf6740e57f8b22218dc99", "parents": ["142e6c4b4e562bda49d85fffe9e5d3b9ca8957ef"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082386 - Speed up BigInt division on AArch64 devices r=mgaudet\" for causing failures @BigIntType.cpp.\n\nThis reverts commit ba0643e9095b7bdeccc68262aa2549c1c66b1ae8.\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "3ac2804483c48a4cdeebdc675b273b0a0539ee62", "git_parents": ["8140fe07303e1dd450277ebd9029a30e8cef2b2f"], "node": "7cbba72cdd849da8172a99c2094c8677e94885f9", "parents": ["8763eed900d732948acaf6740e57f8b22218dc99"], "tags": []}, {"author": "Tin La \u003ctin.la@utexas.edu\u003e", "branch": "default", "desc": "Bug 2071322 - dedupe amend_taskgraph in morph.py between gecko_taskgraph and taskgraph r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335764\n", "files": ["taskcluster/gecko_taskgraph/morph.py"], "git_node": "9ffae0c664a108012b02f4826b2a31940dc9e291", "git_parents": ["3ac2804483c48a4cdeebdc675b273b0a0539ee62"], "node": "b3210b5b6266dc35fb26da966f8694cea9a1aa73", "parents": ["7cbba72cdd849da8172a99c2094c8677e94885f9"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084266 - Connection Allowlists: Use http(s): instead of ws(s): URLs for WebSocket. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335683\n", "files": ["dom/security/ConnectionAllowlists.cpp", "testing/web-platform/meta/connection-allowlist/tentative/websocket.sub.window.js.ini"], "git_node": "6b1e77eca7ff27bb8c234c3366714e549603f97d", "git_parents": ["9ffae0c664a108012b02f4826b2a31940dc9e291"], "node": "bd7a13bf7f5bbea4797f5817dcabf073a57ed2d0", "parents": ["b3210b5b6266dc35fb26da966f8694cea9a1aa73"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079818 - Associate ScriptFetchInfo for frame, process and sub scripts. r=jonco,arai\n\nFrame, process and sub scripts have no ScriptFetchInfo, and\nSyncScriptLoader has no base URL, so a dynamic import() from them dereferenced\na null baseURL in ImportMap::ResolveModuleSpecifier.\n\nAssociate a ScriptFetchInfo with those scripts, using the script URL as the\nbase URL. Make SyncModuleLoader create default ScriptFetchOptions for scripts\nthat still have no ScriptFetchInfo, such as ChromeUtils.compileScript ones, and\nhandle their null baseURL when resolving a specifier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333635\n", "files": ["dom/base/nsFrameMessageManager.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_messagemanager_loadprocessscript_dynamic_import.js", "dom/base/test/file_precompiled_script_dynamic_import.js", "dom/base/test/file_process_script_dynamic_import.js", "dom/base/test/file_process_script_dynamic_import.sys.mjs", "dom/base/test/file_subscript_dynamic_import.js", "dom/base/test/file_subscript_dynamic_import.sys.mjs", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "js/loader/ImportMap.cpp", "js/xpconnect/loader/SyncModuleLoader.cpp", "js/xpconnect/loader/SyncModuleLoader.h", "js/xpconnect/loader/mozJSSubScriptLoader.cpp"], "git_node": "e4e0daa1803e3cfc8298aa7d1893a807267ff11e", "git_parents": ["6b1e77eca7ff27bb8c234c3366714e549603f97d"], "node": "84a9aaf36d24444d4e2f24aa41547ce46a7a1714", "parents": ["bd7a13bf7f5bbea4797f5817dcabf073a57ed2d0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084272 - Remove skip-if annotations that no longer fail in browser/components/search/test/browser, r=search-reviewers,scunnane.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335695\n", "files": ["browser/components/search/test/browser/browser.toml", "browser/components/search/test/browser/telemetry/browser.toml"], "git_node": "292fda6f78be104fc00af637da27150a70190ea2", "git_parents": ["e4e0daa1803e3cfc8298aa7d1893a807267ff11e"], "node": "a439cc0cf14cc90a997e89b2bb337727a134f00d", "parents": ["84a9aaf36d24444d4e2f24aa41547ce46a7a1714"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084265 - Reset browser.urlbar.lastUrlbarSearchSeconds before testing it is updated, r=search-reviewers,scunnane.\n\nThe pref has one-second resolution, so when the previous test did a urlbar search less than a second earlier, the new value equals the old one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335696\n", "files": ["browser/components/search/test/browser/browser_search_lastused_pref.js"], "git_node": "9c1f91085d40b62017da00c837669681634669d7", "git_parents": ["292fda6f78be104fc00af637da27150a70190ea2"], "node": "25bb5d49cc97899f67704bd3f22490c20cfdec10", "parents": ["a439cc0cf14cc90a997e89b2bb337727a134f00d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084263 - Wait for the expected search icon in browser_contentSearchUI_default.js, r=search-reviewers,scunnane.\n\nAn unset --newtab-search-icon computes to an empty string, not \"null\", so the\ntest's wait never waited for the page to receive its engine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335697\n", "files": ["browser/components/search/test/browser/browser_contentSearchUI_default.js"], "git_node": "1fb6b950669ecb9acc0e25c6c6ac823b1d8278ef", "git_parents": ["9c1f91085d40b62017da00c837669681634669d7"], "node": "598a34450e9dd70001fbf6c8153807ae7f19204e", "parents": ["25bb5d49cc97899f67704bd3f22490c20cfdec10"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2024061 - Fix intermittent failures in browser_search_telemetry_searchform.js, r=search-reviewers,scunnane.\n\nThe search form page can finish loading before the search mode switcher's \"hidden\" event, and the test only started listening for the load once the popup was hidden. Listen for both before clicking and wait for them together.\n\nThe new searchbar is not per tab, so test_actualSearch now clears the value it types; otherwise a re-run searches instead of opening the search form.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335698\n", "files": ["browser/components/search/test/browser/telemetry/browser_search_telemetry_searchform.js"], "git_node": "c07617138e6ae68792d13b83414833894945f736", "git_parents": ["1fb6b950669ecb9acc0e25c6c6ac823b1d8278ef"], "node": "6e864aa6730067eb0b7928725278b1d6beeaaac3", "parents": ["598a34450e9dd70001fbf6c8153807ae7f19204e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1943499 - Wait for SearchSERPTelemetry initialization in browser_search_glean_serp_event_telemetry_categorization_enabled_by_pref.js, r=search-reviewers,scunnane.\n\nThe test is first in its manifest, so it can start before the startup\nSearchSERPTelemetry.init() call from BrowserGlue completes. When init() then\nfinishes, it replaces the provider info the test overrode, and the SERP never\ngets categorized. The macOS skip-if was added for a timeout at the same step.\n\nCalling init() while that call was pending started a second initialization,\nso init() calls made during initialization now share it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335699\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_glean_serp_event_telemetry_categorization_enabled_by_pref.js"], "git_node": "1f526749cc3ebd534ea6870a21fc09850f1382d2", "git_parents": ["c07617138e6ae68792d13b83414833894945f736"], "node": "24dfd44610f876cbc2a8cb485697ffeea64d011e", "parents": ["6e864aa6730067eb0b7928725278b1d6beeaaac3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084262 - Don't drop SearchOneOffs cache invalidations that arrive during a rebuild, r=search-reviewers,scunnane.\n\n`invalidateCache()` was ignored while `_rebuild()` was running, so an engine change notified during a rebuild left the stale engine list cached, and the next rebuild returned early on it. Defer the invalidation until the rebuild finishes instead.\n\nThis also re-enables `browser_searchbar_openpopup.js` on Windows 11 25H2, skipped in bug 2019745.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335700\n", "files": ["browser/components/search/SearchOneOffs.sys.mjs", "browser/components/search/test/browser/browser.toml"], "git_node": "fd49e1068c87125fa63a3c45d660787d368e77f0", "git_parents": ["1f526749cc3ebd534ea6870a21fc09850f1382d2"], "node": "ffdc5df061fa47d6ca5bcae04f3a882c0aa153e1", "parents": ["24dfd44610f876cbc2a8cb485697ffeea64d011e"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2061638 - Mark ANGLE TLS pointers constinit r=gfx-reviewers,jnicol\n\nAdd constinit to both the declarations and definitions of gl::gCurrentValidContext and egl::gCurrentThread. Both pointers are initialized to nullptr and require no dynamic initialization.\n\nMaking this explicit in the declarations allows callers to access the TLS variables without checking for optional weak TLS initialization functions. This avoids the invalid initialization-function reference observed in the Android x86-64 build while preserving hidden visibility and direct TLS access.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335875\n", "files": ["gfx/angle/patches/0020-TLS-constinit-thread_local.patch", "third_party/angle/src/libANGLE/Context.cpp", "third_party/angle/src/libANGLE/Context.h", "third_party/angle/src/libGLESv2/global_state.cpp", "third_party/angle/src/libGLESv2/global_state.h"], "git_node": "e620d061726ac4773cbedc2e9a147cde23b6e0d1", "git_parents": ["fd49e1068c87125fa63a3c45d660787d368e77f0"], "node": "67836c6594c0c2b4feda0ee112c116bf4e52c330", "parents": ["ffdc5df061fa47d6ca5bcae04f3a882c0aa153e1"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071322 - dedupe amend_taskgraph in morph.py between gecko_taskgraph and taskgraph r=taskgraph-reviewers,jcristau\" for causing lint failures @morph.py.\n\nThis reverts commit 9ffae0c664a108012b02f4826b2a31940dc9e291.\n", "files": ["taskcluster/gecko_taskgraph/morph.py"], "git_node": "0f76fed7aea1f77db85afbf5a895754d8ad971d7", "git_parents": ["e620d061726ac4773cbedc2e9a147cde23b6e0d1"], "node": "f62de275299e8e64e7cb1ee2dd76e025f255beba", "parents": ["67836c6594c0c2b4feda0ee112c116bf4e52c330"], "tags": []}], "date": 1792574574, "git_changesets": ["2d7e2d0fe696574ae4f9e27a1c3078386161d0f6", "5a1c2d214fbe500cf8ca47a6f6c569dfb1d6d8ab", "2e02d8d098d040f6b2f26e308fe8c6dc11db2b02", "430b48d8f61d089a632756bfbb31a039bba8f73f", "aa6f23e00ed078a13675c06e17bd68577ba8a8b6", "02d6885e47fd0917257914625ae471994657115f", "50a9f61b8325000abef3561d1072d7c6881b004e", "240835807014f0acd45b6a43ce27adc59d20d22f", "36e5885fd2caf50359b7bd5a57c5ac5d337f8705", "d86a2bcff70f0d4e3d58f73b9eee6ad8f4c4259f", "b402ca7911cba615f7291b46fa610ace7b37b1ee", "ab8bc00bce32e62ccc37ad3f5f787cf3e0ffc1b5", "1f11b5ad57439af872081d0b9b870de5862fb075", "fb78851d4deaafd7eb8037865448b2f0cd8a02e3", "4e9b08d93aec59e5b9310cb199ddcd4fd6b348ca", "514a53dcccf617c047434326bc32d0e265c0f34a", "ce39c1abe2afb8ccb9f79bd7eea4e3f22d338ce0", "4ed18743c8e2f163ae8f78f291492be4bce54079", "7d0898fc4ba69cb2edd97f3cc7546cc69be8e5a2", "e75dc88a2456733b114a14eb2c1475dfa080b0dc", "c19545e637ca286c1552a540461d79c5447a08bd", "384cce07b219ae8d9bb10e8d92e9d83c4f39f506", "6b4da118c43dc5ced66dbe1adc530b6de87b794d", "ac36601846d345477391e1e406b4c86933a084f6", "16a89ce9ee5eaf23d5ebfea1c0a44fe19ecd0e0a", "050cb92ee6be534dc6edc8a9a639706e0363fc2e", "67ec6e39232b11140d545ef29da799755f27a5c3", "fa1415303a3991047df7eaa0bafddbc8f38db1f3", "457ce2cf5a7264f87b36ba6667d09f4db8343ac9", "39be7f42e21f7ae4ecc433889639e1662707b4e0", "a2561d64d27cd5841523