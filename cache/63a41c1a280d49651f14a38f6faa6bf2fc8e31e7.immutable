itab-text-block/aitab-text-block.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-text-block/aitab-text-block.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-timeline/aitab-timeline.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-timeline/aitab-timeline.stories.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.css", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.stories.mjs", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabHeadingFont.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_heading_font.js"], "git_node": "da0d0be5d5c7eb5f8a3b65370005150aa742ba57", "git_parents": ["f4d5bfc730e504eeb9a2ab87846f586082adafb1"], "node": "980d4c773836a9233d592e32981a4f18afa3a699", "parents": ["dfd81e18f5c1b0560fbdefa417c61b1670abfc13"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074601 - Detect current selected tab  for SW Agent Watch feature callout r=ngrato,omc-reviewers,pdahiya,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328247\n", "files": ["browser/components/aiwindow/ui/modules/AgentPageDetector.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/xpcshell/test_AgentPageDetector.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml", "browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs"], "git_node": "3ca6c14ac1cbe51b027a090bf407eda0a4e6afa0", "git_parents": ["da0d0be5d5c7eb5f8a3b65370005150aa742ba57"], "node": "920029637554064d699886e6f75e42679dc1cdff", "parents": ["980d4c773836a9233d592e32981a4f18afa3a699"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069024 - Show all menu items in the new home menu r=android-reviewers,giorga\n\nAll the menu items except the \"Customize homepage\" one were already\nshowing in the browser menu so we just need to declare that we need\nthem shown in the home menu also.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331967\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuConfigurations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactory.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/CustomizeHomepageMenuItemProvider.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/ExtensionsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuConfigurationsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/CustomizeHomepageMenuItemProviderTest.kt"], "git_node": "d9ebd59cc9780425f34d9c5b7571b04d7ae8c54d", "git_parents": ["3ca6c14ac1cbe51b027a090bf407eda0a4e6afa0"], "node": "8d88eff6e973dd468cec3d14128bf0d15caa2f9f", "parents": ["920029637554064d699886e6f75e42679dc1cdff"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079618 - Dim the menu background when opened from homepage while in private browsing mode r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331968\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt"], "git_node": "04751b721dda382259c43e8648f5403a2ce6212c", "git_parents": ["d9ebd59cc9780425f34d9c5b7571b04d7ae8c54d"], "node": "6ba7ebc69bcdedcc02e5b6a3ec186753cacb8386", "parents": ["8d88eff6e973dd468cec3d14128bf0d15caa2f9f"], "tags": []}, {"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073353 - Remove unused metrics that cause shutdown hangs r=hsohaney,janerik\n\nCollecting these metrics is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327901\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/metrics.yaml", "browser/modules/test/unit/test_InstallationTelemetry.js", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "113de0a1815704773ef8f8593adaca2053c10af4", "git_parents": ["04751b721dda382259c43e8648f5403a2ce6212c"], "node": "87db3c09cb030f42f7b0212156cc42bba9e6545f", "parents": ["6ba7ebc69bcdedcc02e5b6a3ec186753cacb8386"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067020 - Make DoH URL and DoH mode in about:networking more intuitive r=valentin\" for causing bc failures at browser_about_networking\n\nThis reverts commit 2a6928bcf7a197b4a4fa6ef2774bf8a7b1183067.\n", "files": ["toolkit/content/aboutNetworking.js"], "git_node": "5471881134e8021f972b27aa6c29caa555596df2", "git_parents": ["113de0a1815704773ef8f8593adaca2053c10af4"], "node": "3f9f5f9a35929a0fdb83c1a9b22c014e701d0fc5", "parents": ["87db3c09cb030f42f7b0212156cc42bba9e6545f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078363 - Fade the vertical tabs overflow indicators out before the content area's rounded corner. r=kcochrane,desktop-theme-reviewers,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332104\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "02d393c2a038be71b8519f775d5985497b7ee4d2", "git_parents": ["5471881134e8021f972b27aa6c29caa555596df2"], "node": "5a82fbd701a973ff50bb1346e68f6e9429e67115", "parents": ["3f9f5f9a35929a0fdb83c1a9b22c014e701d0fc5"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050488 - Run WPT testharness with --processes=3 on bare-metal macOS aarch64 r=jgraham\n\nFission-enabled WPT testharness was pinned to a single process on every\nplatform, a decision made for low-memory Intel workers. The macOS\naarch64 CI workers are 10-core / 16GB Mac minis and sit largely idle\nunder that.\n\nMeasured against a matched single-process control on the same base\ncommit, same selector, rebuild 3: median chunk wall-clock drops from\n22.4 min to 9.5 min, a 2.35x speedup, with the failure rate unchanged\nat 9/42 against the control's 8/42 (two-sided Fisher exact p = 1.000).\n\nSweeping further up finds the knee at 3. 5 processes gives 8.6 min and\n7 gives 8.7 min, so everything above 3 is worth about 10 percent more\nand nothing above 5 is worth anything, while the failure rate drifts to\n12/42 and 11/42. At 9 every job fails during browser startup with\nOSError [Errno 24] Too many open files: this is a file descriptor limit\nin the wptrunner parent process, not memory pressure, as peak system\nmemory never exceeds 10.3 GiB of 16 GiB even at 7 processes.\n\nScoped to the general testharness chunks. The tag-scoped media jobs\n(--tag=webrtc, -eme, -canvas, -webcodecs) have not been measured and\nstay single-process. The macOS aarch64 VM pools have far less memory\nper guest and also stay single-process, gated via mozinfo\ninfo[\"macos_vm\"].\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327010\n", "files": ["testing/mozharness/scripts/web_platform_tests.py"], "git_node": "749a857dc49b93eb30850b309b6d6f78bde501c7", "git_parents": ["02d393c2a038be71b8519f775d5985497b7ee4d2"], "node": "77f0110aaf3811ec6789d9c4addc9651c3aad613", "parents": ["5a82fbd701a973ff50bb1346e68f6e9429e67115"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2064874 - allow Listen Player to lose and claim focus correctly r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329065\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenPlayerTest.kt"], "git_node": "45b5f2b3e71fc9084108ba1d6bf625bf496d7ee5", "git_parents": ["749a857dc49b93eb30850b309b6d6f78bde501c7"], "node": "652ed54bfd9aada5cc1da0baf39769cc0072ec5a", "parents": ["77f0110aaf3811ec6789d9c4addc9651c3aad613"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051501 - remove our webcompat intervention for community.acer.com; r=skyschub,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331333\n", "files": ["browser/extensions/webcompat/data/interventions/2051501-community.acer.com.json", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2051501_community_acer_com.py"], "git_node": "7d1fc076b33eb7219fd0e4a203d8709b82eca1bb", "git_parents": ["45b5f2b3e71fc9084108ba1d6bf625bf496d7ee5"], "node": "ed595fffefcb5ee203947885afe8921c0983fbc2", "parents": ["652ed54bfd9aada5cc1da0baf39769cc0072ec5a"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045731 - remove our webcompat intervention for resultadosegundavuelta.onpe.gob.pe; r=skyschub,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331334\n", "files": ["browser/extensions/webcompat/data/interventions/2045731-resultadosegundavuelta.onpe.gob.pe.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2045731_resultadosegundavuelta_onpe_gob_pe.py"], "git_node": "64e0779822012b990a8132db48cd392ced03d6db", "git_parents": ["7d1fc076b33eb7219fd0e4a203d8709b82eca1bb"], "node": "382eca2f0b3183f6bfb25f88932d690c46cc511a", "parents": ["ed595fffefcb5ee203947885afe8921c0983fbc2"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1729435 - remove our webcompat intervention for milkbarstore.com; r=skyschub,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331335\n", "files": ["browser/extensions/webcompat/data/interventions/1729435-milkbarstore.com.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_1729435_milkbarstore_com.py"], "git_node": "bc7cc995463617db9f976feb3ffaca51d2b8ee91", "git_parents": ["64e0779822012b990a8132db48cd392ced03d6db"], "node": "1eed3e84f78ee7c9aa5378a837c68c569f01cb42", "parents": ["382eca2f0b3183f6bfb25f88932d690c46cc511a"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015962 - remove our webcompat intervention for usbank.com; r=skyschub,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331336\n", "files": ["browser/extensions/webcompat/data/interventions/2015962-usbank.com.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2015962_usbank_com.py"], "git_node": "e1c875450af97aba346851499c22299c2282e8f1", "git_parents": ["bc7cc995463617db9f976feb3ffaca51d2b8ee91"], "node": "3fe1f22f8a894c70aeb69e4fe067cd4c48b2d596", "parents": ["1eed3e84f78ee7c9aa5378a837c68c569f01cb42"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013856 - remove our webcompat intervention for 4gamer.net; r=skyschub,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331337\n", "files": ["browser/extensions/webcompat/data/interventions/2013856-4gamer.net.json", "testing/webcompat/interventions/tests/test_2013856_4gamer_net.py"], "git_node": "c242e1c430034801f89d41d3c36e8a7347cf1a5b", "git_parents": ["e1c875450af97aba346851499c22299c2282e8f1"], "node": "84eb981b4ff6b9bf8be1f03aa499adb8b6e763ab", "parents": ["3fe1f22f8a894c70aeb69e4fe067cd4c48b2d596"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078867 - fix webcompat interventions automated tests; r=skyschub\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331338\n", "files": ["testing/webcompat/interventions/tests/test_1830739_1902493_ozwincasino_com.py", "testing/webcompat/interventions/tests/test_1902416_acionafacil_com_br.py", "testing/webcompat/interventions/tests/test_1902475_cdk_fairgoau_com.py"], "git_node": "f7904d2f2292e1062c521eaafbb918356a007404", "git_parents": ["c242e1c430034801f89d41d3c36e8a7347cf1a5b"], "node": "9cd6fc32366e140c489783e19d694021d9b969cc", "parents": ["84eb981b4ff6b9bf8be1f03aa499adb8b6e763ab"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070945 - Remove macOS 14.7 nav-bench tests. r=perftest-reviewers,aglavic\n\nWe don't run 14.7 nav-bench in CI, so this bug is just to remove it from\nselection altogether as we are going to avoid perftesting on this\nplatform soon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331698\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "95b113d38bf67e39c31de373cb1c7778503c4562", "git_parents": ["f7904d2f2292e1062c521eaafbb918356a007404"], "node": "717d97233ff8ba8392d225157d5b55e2be879608", "parents": ["9cd6fc32366e140c489783e19d694021d9b969cc"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070664 - Remove macOS 14.7 Safari tests. r=perftest-reviewers,aglavic\n\nPart of the effort in moving tests over to macOS 15\nThis patch removes safari tests from 14.7 macOS\nDue to the old OS version, the Safari version is also out dated so these\nnumbers are not useful\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331700\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "aa1a21ed8b53af149e0ba6eafe9ed0e3c03d64a4", "git_parents": ["95b113d38bf67e39c31de373cb1c7778503c4562"], "node": "07b01fb8f593600e5ceee2ae11c531bfd999d395", "parents": ["717d97233ff8ba8392d225157d5b55e2be879608"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077995 - [devtools] Add pref for the speculative loads tab r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331881\n", "files": ["browser/app/profile/firefox.js"], "git_node": "0ba154368433ae159afd2345f5c70fcfba3407c2", "git_parents": ["aa1a21ed8b53af149e0ba6eafe9ed0e3c03d64a4"], "node": "b90ae6b1cd5ed1184a787577480bcda17de9f811", "parents": ["07b01fb8f593600e5ceee2ae11c531bfd999d395"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2078902: Factor out a version of this function that is designed for use with timers. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331661\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate_pair.cpp"], "git_node": "a3f830d92ac85091e6947e2ffd33594e65d9f260", "git_parents": ["0ba154368433ae159afd2345f5c70fcfba3407c2"], "node": "076f22d85339346d3bc6775bbb3e5412b077f9a3", "parents": ["b90ae6b1cd5ed1184a787577480bcda17de9f811"], "tags": []}, {"author": "Welpy-cw \u003c58345540+Welpy-cw@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078563 - Preserve GTK client bounds after a one-pixel allocation. r=gtk-reviewers,stransky,emilio\n\nTreat one-pixel client dimensions as placeholders only before the first GTK\ncontainer allocation, so titlebar changes use measured decoration margins\ninstead of stale cached margins.\n\nCover one-pixel bounds, titlebar restoration, and subsequent resizing with\nresize-event waits and assertions that allow fractional pixel rounding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331286\n", "files": ["widget/gtk/nsWindow.cpp", "widget/tests/test_window_size_constraints.xhtml", "widget/tests/window_size_constraints.xhtml"], "git_node": "de6eb035052a748b02a5babfb9b42996372362ab", "git_parents": ["a3f830d92ac85091e6947e2ffd33594e65d9f260"], "node": "d6149911b2985c004ba6c4e4cdf0104b02bdb742", "parents": ["076f22d85339346d3bc6775bbb3e5412b077f9a3"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078382 - Clarify options and alerting in the mozperftest docs r=perftest-reviewers,mozperftest-reviewers,aglavic\n\nThe docs listed these fields without saying how they are structured or what they actually do, so test authors had to read the harness code to use them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330910\n", "files": ["python/mozperftest/perfdocs/writing.md", "testing/perfdocs/generated/writing.md"], "git_node": "43821d3913b72d315c09895595e7739138cc6b20", "git_parents": ["de6eb035052a748b02a5babfb9b42996372362ab"], "node": "03abadc80fe3c04c54100ee166ca4b9f9b0a77d8", "parents": ["d6149911b2985c004ba6c4e4cdf0104b02bdb742"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073531 - Enable direct mitmproxy playback for nav-bench r=kshampur,perftest-reviewers\n\nProxy mode skips connection phases such as TLS and bypasses network stack\noptimizations that only apply to direct connections. The harness now sets\nnetwork.dns.forceResolve itself, so the test-level override is dropped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327396\n", "files": ["testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/nav-bench/browsertime-nav-bench.toml"], "git_node": "85d7c875953fc6be97ea12db5e11d0366f240a9e", "git_parents": ["43821d3913b72d315c09895595e7739138cc6b20"], "node": "a616bb40abfe3fbca164d89ee3c3652bc4feb71d", "parents": ["03abadc80fe3c04c54100ee166ca4b9f9b0a77d8"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2077255 - Avoid existing .json.gz names for xpcshell timeout profiles. r=perftest-reviewers,aglavic\n\nWhen we pick the filename for an xpcshell timeout profile, we only checked\nwhether the .json name was taken, not the .json.gz name. If a .json.gz file\nof that name already existed, symbolication would not rename the profile to\n.json.gz, so it would not overwrite the existing file. The profile would then\nstay at .json, and the artifact name we had logged in advance would be wrong.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330244\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "bedd72850a024c8dc03ed520dbba0665637372b7", "git_parents": ["85d7c875953fc6be97ea12db5e11d0366f240a9e"], "node": "7dd946cd16ae7ad9acf862a9088d0241b4b2022d", "parents": ["a616bb40abfe3fbca164d89ee3c3652bc4feb71d"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2077255 - Gzip profiles that fail to symbolicate. r=perftest-reviewers,aglavic\n\nProfile symbolication takes .json as input and produces .json.gz as output.\nBut sometimes symbolication fails. It would be good to have the .json.gz\nname even in those failure cases.\n\nThere are log messages which are printed before symbolication, which refer\nto the final filenames (with .json.gz). So by always ensuring .json.gz we\nmake it so that those \"predicted file names\" in the log messages are correct.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330245\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py"], "git_node": "47a05c9e04621506dc59ee1b4ea6df732b195039", "git_parents": ["bedd72850a024c8dc03ed520dbba0665637372b7"], "node": "352c9949c3da314177fe558543e8d1d5b654b80b", "parents": ["7dd946cd16ae7ad9acf862a9088d0241b4b2022d"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2077255 - Don't symbolicate profiles that are too large for profiler-edit. r=perftest-reviewers,aglavic\n\nIdeally symbolication would work for large profiles, but it currently doesn't.\nLet's detect those cases early so that we can avoid wasting time when we know\nit's going to fail anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330246\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py"], "git_node": "561159c2280fddc439addccf0bf74158c64edabd", "git_parents": ["47a05c9e04621506dc59ee1b4ea6df732b195039"], "node": "d5728c37718fb313e6fdbb853ec22c55fb01bf1d", "parents": ["352c9949c3da314177fe558543e8d1d5b654b80b"], "tags": []}, {"author": "Gopar \u003cgopardaniel@gmail.com\u003e", "branch": "default", "desc": "Bug 1981627 - Add trial ordering setting to raptor tests r=sparky,perftest-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329291\n", "files": ["testing/raptor/raptor/output.py"], "git_node": "c0b2aa7fbd502e7004d3f87f1fe15dba2bdffdab", "git_parents": ["561159c2280fddc439addccf0bf74158c64edabd"], "node": "5da7d87577241a50e441cade07ffd46a56de5815", "parents": ["d5728c37718fb313e6fdbb853ec22c55fb01bf1d"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058695 - Add share with mac functionality to share panel. r=jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332031\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/tests/browser/browser_testSharePanelButtonVisibility.js", "browser/components/sharing/tests/browser/browser_testSharePanelTelemetry.js"], "git_node": "566b60b4ba35f8d4f4ac9d7942772bd50684aa0a", "git_parents": ["c0b2aa7fbd502e7004d3f87f1fe15dba2bdffdab"], "node": "c0681e93ad5efc0ed75b416532cc9e7a617f8d11", "parents": ["5da7d87577241a50e441cade07ffd46a56de5815"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079171 - Update PlaybackEnded handling. r=media-playback-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332012\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp"], "git_node": "4c90edeaf366302d069aa0947172eff7b9acd2ed", "git_parents": ["566b60b4ba35f8d4f4ac9d7942772bd50684aa0a"], "node": "47f5017f60ba76f5754f710aaaa988bbad3eb87f", "parents": ["c0681e93ad5efc0ed75b416532cc9e7a617f8d11"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073353 - Remove unused metrics that cause shutdown hangs r=hsohaney,janerik\" for causing bc failures at browser_all_files_referenced\n\nThis reverts commit 113de0a1815704773ef8f8593adaca2053c10af4.\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/metrics.yaml", "browser/modules/test/unit/test_InstallationTelemetry.js", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "a8066d5c6c92e4b8ecbb620d170c447e8b538312", "git_parents": ["4c90edeaf366302d069aa0947172eff7b9acd2ed"], "node": "8f88bbe22927364a7648856b263132982be29333", "parents": ["47f5017f60ba76f5754f710aaaa988bbad3eb87f"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078873 - Ignore the media engine's seeked event once the seek has been rejected. r=media-playback-reviewers,azebrowski\n\nWhen the reader's seek is rejected, for example because it is canceled at\nshutdown, ExternalEngineStateMachine rejects the seek job but stays in the\nSeekingData state. A seeked event arriving from the engine afterwards then\ncompared the current position with the cleared seek target, which is an\ninvalid TimeUnit, and crashed on the release assertion in CheckedInt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331342\n", "files": ["dom/media/ExternalEngineStateMachine.cpp"], "git_node": "0ebc84435a693a206a2ec9faf3813462f1981a93", "git_parents": ["a8066d5c6c92e4b8ecbb620d170c447e8b538312"], "node": "e6192cc5674b218ce28d569431e5e63291b32d56", "parents": ["8f88bbe22927364a7648856b263132982be29333"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2079736 - Remove mochitest manifest conditions for Windows 11 24H2. r=aryx,devtools-reviewers,tabbrowser-reviewers,places-reviewers,sandbox-reviewers,niklas,gcardieri,bomsy\n\nMochitests moved to Windows 11 25H2 in bug 2027049. mochitest-media still runs\non the 24H2 hardware reference machines, so its conditions stay.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332014\n", "files": ["accessible/tests/browser/hittest/browser.toml", "accessible/tests/browser/scroll/browser.toml", "accessible/tests/browser/text/browser.toml", "accessible/tests/mochitest/events/a11y.toml", "accessible/tests/mochitest/tree/a11y.toml", "browser/base/content/test/browser-about/browser.toml", "browser/base/content/test/browser-tabcrashed/browser_aboutRestartRequired_noForkServer.toml", "browser/base/content/test/browser-webrtc/browser.toml", "browser/components/customizableui/test/browser.toml", "browser/components/firefoxview/tests/browser/browser.toml", "browser/components/genai/tests/browser/browser.toml", "browser/components/newtab/test/browser/browser.toml", "browser/components/originattributes/test/browser/browser.toml", "browser/components/profiles/tests/browser/browser-legacy.toml", "browser/components/profiles/tests/browser/browser.toml", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/sessionstore/test/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/extensions/formautofill/test/browser/browser.toml", "browser/modules/test/browser/browser.toml", "devtools/client/accessibility/test/browser/browser.toml", "devtools/client/application/test/browser/browser.toml", "devtools/client/framework/test/browser.toml", "devtools/client/inspector/boxmodel/test/browser.toml", "devtools/client/inspector/markup/test/browser.toml", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/responsive/test/browser/browser.toml", "devtools/client/webconsole/test/browser/_browser_console.toml", "devtools/shared/commands/target/tests/browser.toml", "docshell/test/browser/browser.toml", "dom/animation/test/mochitest.toml", "dom/base/test/fullscreen/mochitest.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-glsl3.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/events/test/mochitest.toml", "dom/events/test/pointerevents/mochitest.toml", "dom/manifest/test/browser.toml", "dom/messagechannel/tests/m