at cause shutdown hangs r=hsohaney,janerik\" for causing failure @ browser_all_files_referenced.js\n\nThis reverts commit 38f346e381d9d363139555145a02432822cb60bf.\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/metrics.yaml", "browser/modules/test/unit/test_InstallationTelemetry.js", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/tests/unit/test_new_profile.js"], "git_node": "cebae8c1bea6741f14b04b9ed321addc1fee63b4", "git_parents": ["45e4f05e820f778bad128cf0b31fa529088caa8d"], "node": "51a92238a5949e2a251fbf1ea92122d3dfb4cb40", "parents": ["965b2e3faa0f1a3f6d406553faebf32f1cc181cf"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972522 - Use view transitions for sidebar animations r=emilio,nsharpley,desktop-theme-reviewers,sidebar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328556\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-sets.js", "browser/base/content/test/browser-general/browser_backOrSidebarButtonFitts.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sessionstore/test/marionette/test_restore_sidebar.py", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-main.css", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/sidebar-pins-promo.css", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/components/sidebar/tests/browser/browser_glean_sidebar.js", "browser/components/sidebar/tests/browser/browser_resize_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/components/sidebar/tests/browser/browser_sidebar_escape_collapse.js", "browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/browser/browser_toolbar_sidebar_button.js", "browser/components/sidebar/tests/browser/browser_tools_overflow.js", "browser/components/sidebar/tests/browser/legacy/browser_sidebar_keys.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/content/tests/browser/browser_bug1693577.js"], "git_node": "1dd5b9862ed605d6a9ca1a9d7579f7e93d22bbac", "git_parents": ["cebae8c1bea6741f14b04b9ed321addc1fee63b4"], "node": "a040fd7f1f797f340fd94c8c9539ecbc0fb443f1", "parents": ["51a92238a5949e2a251fbf1ea92122d3dfb4cb40"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078853 - [devtools] Add the UI skeleton for the Speculative Loads r=devtools-reviewers,fluent-reviewers,nchevobbe,bolsson\n\nThis patch adds the basic UI skeleton for to view speculative loads. this setup\nthe base for showing the actual data which will be come in subsequent patches.\n\nThere are 2 sections\n- Speculative load status of the current page\n- Any speculations initiated by this page\n\nSee the speculative loads panel in chrome for details, which is the\ninspiration for most of this work.\n\nEnable `devtools.application.speculativeLoads` to see panel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331486\n", "files": ["devtools/client/application/application.css", "devtools/client/application/index.html", "devtools/client/application/initializer.js", "devtools/client/application/src/components/moz.build", "devtools/client/application/src/components/routing/PageSwitcher.js", "devtools/client/application/src/components/routing/Sidebar.js", "devtools/client/application/src/components/routing/SidebarItem.js", "devtools/client/application/src/components/speculative-loads/SpeculativeLoads.css", "devtools/client/application/src/components/speculative-loads/SpeculativeLoadsPage.js", "devtools/client/application/src/components/speculative-loads/moz.build", "devtools/client/application/src/constants.js", "devtools/client/jar.mn", "devtools/client/locales-preview/speculative-loads.ftl", "devtools/client/locales/jar.mn"], "git_node": "108b04fd6b155d870527ec57cb68d670e9ae8724", "git_parents": ["1dd5b9862ed605d6a9ca1a9d7579f7e93d22bbac"], "node": "da2e62fafac62352e9f40a86f8cfc50fd6778b71", "parents": ["a040fd7f1f797f340fd94c8c9539ecbc0fb443f1"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079994 - Make mach coverage-report recognize the Android platform. DONTBUILD\n\n`_get_platform` in tools/code-coverage/mach_commands.py didn't recognize Android task names. So `mach coverage-report --suite gtest` raised \"Unknown platform for test-android-em-14-x86_64-ccov/opt-geckoview-gtest-1proc\".\n\nThe fix checks for \"android\" before the other platform substring checks. It also lists the accepted values in the `--platform` help text, and adds an offline unit test for `_get_platform`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332248\n", "files": ["tools/code-coverage/mach_commands.py", "tools/code-coverage/tests/python/test_mach_commands.py"], "git_node": "be519496bfa76f90fa4b2fd396f58a456e1d0922", "git_parents": ["108b04fd6b155d870527ec57cb68d670e9ae8724"], "node": "022836f15bd6e1302632db426b980368953772f0", "parents": ["da2e62fafac62352e9f40a86f8cfc50fd6778b71"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068237 - Give the form history autocomplete popup the same minimum width as the autofill popup. r=desktop-theme-reviewers,kcochrane\n\nBug 2045828 stopped sizing the autocomplete popup to the input and gave the\nautofill popups a 250px minimum instead, but form history popups got no\nminimum. With the history icon from bug 2050573 taking room in each row,\nvalues in narrow fields could be cut off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332588\n", "files": ["browser/themes/shared/autocomplete.css"], "git_node": "90277648432839b27e8494dabada1d52e1b649eb", "git_parents": ["be519496bfa76f90fa4b2fd396f58a456e1d0922"], "node": "70c9d4e6a9e2b780d9a1a9bbb6889b407256a27c", "parents": ["022836f15bd6e1302632db426b980368953772f0"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078613 - Compilation time check to catch calls to do_GetWeakReference which can't work as epxected. r=xpcom-reviewers,dom-core-reviewers,nika,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331210\n", "files": ["dom/base/Attr.h", "dom/base/nsContentUtils.h", "dom/base/nsIContent.h", "xpcom/base/nsIWeakReferenceUtils.h"], "git_node": "6c157c693b7cd87edcf05af7b5d869fd94b87d2b", "git_parents": ["90277648432839b27e8494dabada1d52e1b649eb"], "node": "4a1e4b71e49ce5782711358caa68160b24a4abb1", "parents": ["70c9d4e6a9e2b780d9a1a9bbb6889b407256a27c"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2074842 - fix(webgpu): don't assert on `NS_ERROR_UNEXPECTED` when populating `GPUAdapter.features` r=webgpu-reviewers,aleiserson\n\nMuch like D241291, we might crash when populating `GPUSupportedFeatures`/`GPUAdapter.features`. Nay, I say! Only crash on things that aren't supposed to happen under ordinary running conditions!\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329250\n", "files": ["dom/webgpu/Adapter.cpp"], "git_node": "35475d2495bd0e79b95eaad41f135e082b543881", "git_parents": ["6c157c693b7cd87edcf05af7b5d869fd94b87d2b"], "node": "87a621909bbcd169863597f10a90c7271afeba1d", "parents": ["4a1e4b71e49ce5782711358caa68160b24a4abb1"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2080321 - Shorten the isolated process variant's Treeherder symbol to iso r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332587\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/test_configs/variants.yml"], "git_node": "d7ea5e82586b06c5c10207f4af7541c6430ae8d1", "git_parents": ["35475d2495bd0e79b95eaad41f135e082b543881"], "node": "a62e5c6d18ab01569f3081d9b76ce6f542b3a761", "parents": ["87a621909bbcd169863597f10a90c7271afeba1d"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2080044 - Update agentic tools to latest versions. r=ai4dev-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332281\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "63d7a6a429c98f92e299699ce2c4a486b9558260", "git_parents": ["d7ea5e82586b06c5c10207f4af7541c6430ae8d1"], "node": "4e3ddbbcea6bda577b47ab37ced61926d3ef4e78", "parents": ["a62e5c6d18ab01569f3081d9b76ce6f542b3a761"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079882 - Update dav1d to 99f3354ed0b9b4bf3c7c9347318dbcc522c94af5 r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332144\n", "files": ["media/libdav1d/moz.yaml", "media/libdav1d/vcs_version.h", "third_party/dav1d/src/arm/64/cdef.S", "third_party/dav1d/src/arm/64/cdef16.S", "third_party/dav1d/src/arm/64/cdef_tmpl.S", "third_party/dav1d/src/arm/64/ipred.S", "third_party/dav1d/src/lf_mask.c", "third_party/dav1d/src/looprestoration_tmpl.c", "third_party/dav1d/src/refmvs.c", "third_party/dav1d/src/x86/ipred_sse.asm", "third_party/dav1d/src/x86/loopfilter16_sse.asm", "third_party/dav1d/src/x86/loopfilter_avx2.asm", "third_party/dav1d/src/x86/mc_sse.asm", "third_party/dav1d/src/x86/refmvs.asm"], "git_node": "8add84122a22cded4b77caee6da1148e7011c29d", "git_parents": ["63d7a6a429c98f92e299699ce2c4a486b9558260"], "node": "adb25bf98caa679b4c6161fd89ed8f2a84ab2122", "parents": ["4e3ddbbcea6bda577b47ab37ced61926d3ef4e78"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059852 - Contain keyboard focus inside Edit Avatar dialog r=mkennedy,niklas\n\nOpening the dialog with show() left the rest of the page focusable, so\ntabbing past the last element moved focus to content hidden behind the\ndialog. showModal() makes the rest of the page inert for keyboard and\nscreen reader users.\n\nThe browser now handles Escape and clicks outside the dialog through\nclosedby, instead of our own document click listener. In the crop view,\noutside clicks are ignored and Escape goes back to the custom view\ninstead of closing the dialog. The dialog is anchored under the edit\nbutton with CSS anchor positioning and scrolls with the page instead of\nbeing pinned to the viewport.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331668\n", "files": ["browser/components/profiles/content/profile-avatar-selector.css", "browser/components/profiles/content/profile-avatar-selector.mjs", "browser/components/profiles/tests/browser/browser_custom_avatar_test.js", "browser/components/profiles/tests/browser/browser_edit_profile_test.js"], "git_node": "f026461b07b232a1f3d70bb11e1cca9f9c96dec3", "git_parents": ["8add84122a22cded4b77caee6da1148e7011c29d"], "node": "936fdf8953306d6d6e33c49919192e7e800f62cc", "parents": ["adb25bf98caa679b4c6161fd89ed8f2a84ab2122"], "tags": []}, {"author": "Anton Bershanskyi \u003cbershanskyi@astermail.org\u003e", "branch": "default", "desc": "Bug 2080310 - browser.runtime.PlatformArch.ARM64. r=robwu\n\nRename WebExtensions platform architecture enum value\nfrom aarch64 to arm64 to match Chromium.\n\nWECG discussion: https://github.com/w3c/webextensions/issues/1056\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332553\n", "files": ["toolkit/components/extensions/ExtensionParent.sys.mjs", "toolkit/components/extensions/schemas/runtime.json", "toolkit/components/extensions/test/xpcshell/test_ext_runtime_getPlatformInfo.js"], "git_node": "e775d5304b3299d976c4bfaa8f2f6a4b5d1ba7a2", "git_parents": ["f026461b07b232a1f3d70bb11e1cca9f9c96dec3"], "node": "7b6fdb6d232947d3f99d73731bf2d285e51e5afc", "parents": ["936fdf8953306d6d6e33c49919192e7e800f62cc"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 1905517 - Put g_error() messages into the crash reason. r=stransky\n\nGLib always aborts on a G_LOG_LEVEL_ERROR message. HandleGLibMessage() crashes\nwith the message only when IsCrashyGtkMessage() recognizes it. Any other fatal\nmessage goes to NS_DebugBreak(NS_DEBUG_ASSERTION), which in release builds only\nprints to stderr, so the crash report has no reason.\n\nCrash with the message for any G_LOG_LEVEL_ERROR, after it has been printed.\nThe process was going to die a moment later inside GLib anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332161\n", "files": ["toolkit/xre/nsSigHandlers.cpp"], "git_node": "be5ece3834afdb2eb503e41f6d4ac11cd63b0631", "git_parents": ["e775d5304b3299d976c4bfaa8f2f6a4b5d1ba7a2"], "node": "ea3dc2b5933ba61611d43b14cb28e241077a713f", "parents": ["7b6fdb6d232947d3f99d73731bf2d285e51e5afc"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080264 - Hide text labels for browser menu navigation items in Focus. r=android-reviewers,jonalmeida\n\n- Update `MenuGridItem` to center icons vertically and hide the title text and spacer when the title is empty.\n- Add a `showText` flag to menu item construction in `BrowserMenu` and `CustomTabMenu`.\n- Hide text titles for toolbar navigation items (Back, Forward, Share, Stop, Reload) while preserving accessibility content descriptions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332475\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuGridItem.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/BrowserMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/CustomTabMenu.kt"], "git_node": "9b573894b92cd6c9876851459c0342aec7bcff09", "git_parents": ["be5ece3834afdb2eb503e41f6d4ac11cd63b0631"], "node": "f103266482e89b943277bb6d39315debe5d62c9f", "parents": ["ea3dc2b5933ba61611d43b14cb28e241077a713f"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2079874 - make smartpage title in card complete state clickable, opens in new tab or existing tab if already opened r=jlewis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332263\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.css", "browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js"], "git_node": "751cec8b889c9359a13c7bdc9f01d3db1a2cfd22", "git_parents": ["9b573894b92cd6c9876851459c0342aec7bcff09"], "node": "88d0a38795bb97467cd4573de930760274f018bc", "parents": ["f103266482e89b943277bb6d39315debe5d62c9f"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2080000 - Part 1: Remove the unused layer3 attr r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332291\n", "files": ["mobile/android/fenix/app/src/mai