Differential Revision: https://phabricator.services.mozilla.com/D332140\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/macOSPoliciesParser.sys.mjs"], "git_node": "ea46f7d659e6d9acae6a5541dfc32d5087ed923f", "git_parents": ["b38ce19836d79d5f440406604829273ee7d8d4e0"], "node": "f02badcec45117dc4c7143d74fc689104a8246ff", "parents": ["82f0323b3d8021a28d591afb87dad31cb95633a7"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Add tests for macOS policy source selection. r=jneuberger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332141\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_macos_policy_sources.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "ef80fe286a8dfbd5c2363c1ed5b8f6175e4ec827", "git_parents": ["ea46f7d659e6d9acae6a5541dfc32d5087ed923f"], "node": "f5e8b5c7372c0594a07ea6f330e19654cfe88263", "parents": ["f02badcec45117dc4c7143d74fc689104a8246ff"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083042 - unsplit split view tabs when popping out a cropped mini window. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334633\n", "files": ["browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/test/browser/browser_pop_tab.js"], "git_node": "ce77592b110ae274a5aae66fbb2d42eda57feac6", "git_parents": ["ef80fe286a8dfbd5c2363c1ed5b8f6175e4ec827"], "node": "21b192310aee65363d3cc8ca5a1c76866ecb6369", "parents": ["f5e8b5c7372c0594a07ea6f330e19654cfe88263"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2080582 - Add test to prevent new EXTRA_JS_MODULES added to tree. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332729\n", "files": ["docs/code-quality/lint/linters/extra-js-modules.md", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/extra-js-modules.yml", "tools/lint/extra-js-modules/__init__.py", "tools/lint/extra-js-modules/allowlist.txt", "tools/lint/test/files/extra-js-modules/allowlist.txt", "tools/lint/test/files/extra-js-modules/sub/final/moz.build", "tools/lint/test/files/extra-js-modules/sub/globbed/Globbed.sys.mjs", "tools/lint/test/files/extra-js-modules/sub/globbed/NewGlobbed.sys.mjs", "tools/lint/test/files/extra-js-modules/sub/globbed/moz.build", "tools/lint/test/files/extra-js-modules/sub/moz.build", "tools/lint/test/files/extra-js-modules/sub/nested/moz.build", "tools/lint/test/files/extra-js-modules/sub/nonliteral/moz.build", "tools/lint/test/files/extra-js-modules/sub/targets/moz.build", "tools/lint/test/python.toml", "tools/lint/test/test_extra_js_modules.py"], "git_node": "a297f625eb2d51c7b5681fdfad3f6fa1cf25595a", "git_parents": ["ce77592b110ae274a5aae66fbb2d42eda57feac6"], "node": "235b0e0198731beb00c78af71b54bf365ea0a317", "parents": ["21b192310aee65363d3cc8ca5a1c76866ecb6369"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079863 - Add tests for Widevine provisioning in GeckoMediaDrmBridge. r=jolin,geckoview-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332259\n", "files": ["mobile/android/geckoview/build.gradle", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoMediaDrmBridge.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/media/GeckoMediaDrmBridgeTest.java"], "git_node": "0a43b170e857392838e3ab3ec378b59391513859", "git_parents": ["a297f625eb2d51c7b5681fdfad3f6fa1cf25595a"], "node": "879b0f5d223b37cf7129a02e54506837327d5364", "parents": ["235b0e0198731beb00c78af71b54bf365ea0a317"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079863 - Replace the deprecated AsyncTask in GeckoMediaDrmBridge. r=jolin,geckoview-reviewers,jonalmeida\n\nThe provisioning request and its response now run on the handler thread that resumes the pending session\noperations, instead of on AsyncTask's shared executor followed by a post to the main thread. Resuming the\npending sessions stops when one of them restarts provisioning, so that the new request can run on the same\nthread. A response arriving after release() is still dropped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332260\n", "files": ["mobile/android/geckoview/build.gradle", "mobile/android/geckoview/lint-baseline.xml", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoMediaDrmBridge.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/media/GeckoMediaDrmBridgeTest.java"], "git_node": "5d688f0dd0f592ca76a5c93edce8a4e18d38a443", "git_parents": ["0a43b170e857392838e3ab3ec378b59391513859"], "node": "0de0c90892a510c8269482961cb5893e1d31c879", "parents": ["879b0f5d223b37cf7129a02e54506837327d5364"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079863 - Synchronize GeckoMediaDrmBridge's threads with release(). r=jolin,geckoview-reviewers,jonalmeida\n\nThe provisioning response and the pending session operations run on the handler thread and MediaDrm events\narrive on the main thread, while RemoteMediaDrmBridgeStub calls release() and the other entry points on a\nbinder thread. A release() in the middle of one of them could use the released MediaDrm and crash the process,\nor start a handler thread that nothing quits. The entry points and those three paths now hold the bridge's\nlock; the provisioning request itself stays outside it.\n\nA second release() now returns early. The bridge releases itself after some MediaDrm failures, and the stub's\nlater release() used to throw before it finished its own teardown.\n\nRemoteMediaDrmBridgeStub now updates its static list of stubs under the class lock Codec reads it with. Code\nthat read this state without a lock and has no callers is removed instead: isSecureDecoderComponentRequired(),\nand MediaDrmProxy's getMediaCrypto() lookup with its proxy list, which takes getMediaCrypto() off the\nGeckoMediaDrm interface.\n\nA failed provisioning response now also rejects the queued session operations, which used to wait for a later\nprovisioning to succeed. A session that started the provisioning is rejected once, in release() as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333974\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoMediaDrm.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoMediaDrmBridge.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/MediaDrmProxy.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteMediaDrmBridge.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteMediaDrmBridgeStub.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/media/GeckoMediaDrmBridgeTest.java"], "git_node": "aca52f153233c1c5e1a9dbdba8d4376e54383187", "git_parents": ["5d688f0dd0f592ca76a5c93edce8a4e18d38a443"], "node": "a2d0063b589ac473f1adceee04e5da14699e832f", "parents": ["0de0c90892a510c8269482961cb5893e1d31c879"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082030 - Make sure to refcount custom element definitions when creating new elements. r=dom-core-reviewers,keithamus\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334638\n", "files": ["dom/xml/nsXMLContentSink.cpp", "parser/html/nsHtml5TreeOperation.cpp"], "git_node": "b66e9e7c969d3d371b2aef7a75963bd4718d7c55", "git_parents": ["aca52f153233c1c5e1a9dbdba8d4376e54383187"], "node": "57ccad55258a79b5cff2c4145736de40feae11ba", "parents": ["a2d0063b589ac473f1adceee04e5da14699e832f"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334648\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "c7c6ab155f4cbc829aac6dd4a6402a0980ba7289", "git_parents": ["b66e9e7c969d3d371b2aef7a75963bd4718d7c55"], "node": "42165a9bffd7be14f05bf51a373429bc2c3285f7", "parents": ["57ccad55258a79b5cff2c4145736de40feae11ba"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079204 - Type Session Restore's browser windows as BrowserWindow. r=sessionstore-reviewers,sclements\" for causing documentation failures\n\nThis reverts commit 4f1a73f873d1c8f5eaf7396b8f9052797488349d.\n\nRevert \"Bug 2079204 - Declare the browser window globals that Session Restore reads. r=Standard8\"\n\nThis reverts commit 55eff1bbadbbff5334f8ab1d949c763994bdc9a5.\n", "files": ["browser/components/sessionstore/RecentlyClosedTabsAndWindowsMenuUtils.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/content/aboutSessionRestore.js", "browser/components/sessionstore/tsconfig.json", "tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "6b62da2fd9b04c56a053ee0807a03675baa40ce2", "git_parents": ["c7c6ab155f4cbc829aac6dd4a6402a0980ba7289"], "node": "a934bacc967a476b1b8ee347465d9735dd778c00", "parents": ["42165a9bffd7be14f05bf51a373429bc2c3285f7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081848 - Type allSplitViews' return value as MozTabSplitViewWrapper[]. r=tabbrowser-reviewers,sclements\" for causing documentation failures\n\nThis reverts commit 06af8149e92dfd2884b54cbe72c3ce70eec9e850.\n\nRevert \"Bug 2081848 - Declare the browser window's globals as the members of a BrowserWindow type. r=Standard8\"\n\nThis reverts commit 9512d8d05c50b7baea5476fa823fe97dc8f16ccf.\n", "files": ["browser/components/tabbrowser/content/tabs.mjs", "tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "4b6097ab76520ca583ff6480a15ee8945795eaf0", "git_parents": ["6b62da2fd9b04c56a053ee0807a03675baa40ce2"], "node": "f8355faa6a589d692906b4d24866fea945be509f", "parents": ["a934bacc967a476b1b8ee347465d9735dd778c00"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "72fa9c388cbbc7c8236fa629af7f185fa634c5c1", "git_parents": ["4b6097ab76520ca583ff6480a15ee8945795eaf0", "e77c5131fd07ddab0731efab207539f5ae3a00ce"], "node": "7f09e5baa861443bc1098a2ce2f764158265c1f0", "parents": ["f8355faa6a589d692906b4d24866fea945be509f", "b0954e595f191eb415dc31933a9ea941d46ace92"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073015 - Add tests for macOS policy source selection. r=jneuberger\" for causing macOs build bustages on CFTypeRefPtr.h.\n\nThis reverts commit ef80fe286a8dfbd5c2363c1ed5b8f6175e4ec827.\n\nRevert \"Bug 2073015 - Restrict macOS policy sources to privileged domains. r=jneuberger,spohl\"\n\nThis reverts commit ea46f7d659e6d9acae6a5541dfc32d5087ed923f.\n\nRevert \"Bug 2073015 - Rank user policies below all policy providers. r=fluent-reviewers,spohl,bolsson\"\n\nThis reverts commit b38ce19836d79d5f440406604829273ee7d8d4e0.\n\nRevert \"Bug 2073015 - Rename shouldIgnoreLocalPolicies to ignoreLocalPoliciesInAutomation. r=jneuberger\"\n\nThis reverts commit 795b4ad82c289769dc13ebbed25dd46a9c7cd772.\n\nRevert \"Bug 2073015 - Read macOS preference sources separately. r=spohl\"\n\nThis reverts commit 78a168be1166c781d369ec3fe0e71684c1551e35.\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_macos_policy_sources.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "browser/locales/en-US/browser/policies/policies-descriptions.ftl", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/macOSPoliciesParser.sys.mjs", "toolkit/components/enterprisepolicies/tests/xpcshell/test_combined_provider_precedence.js", "xpcom/base/nsIMacPreferencesReader.idl", "xpcom/base/nsMacPreferencesReader.mm"], "git_node": "aeeb3b7501865032198e2d688fa2df500d2f6ba6", "git_parents": ["72fa9c388cbbc7c8236fa629af7f185fa634c5c1"], "node": "c83ffe7203b7f76ffd2329f9420f0ee134836636", "parents": ["7f09e5baa861443bc1098a2ce2f764158265c1f0"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078946 - short-write gtests. r=keeler\" for causing Gtest failures\n\nThis reverts commit 732e95f0a3902737d230ea983abfac58f89b43ff.\n", "files": ["security/manager/ssl/tests/gtest/ShortWriteTest.cpp", "security/manager/ssl/tests/gtest/moz.build", "security/manager/ssl/tests/gtest/short-write-server.key", "security/manager/ssl/tests/gtest/short-write-server.key.keyspec", "security/manager/ssl/tests/gtest/short-write-server.pem", "security/manager/ssl/tests/gtest/short-write-server.pem.certspec"], "git_node": "eace82b0fd8c633627632acf2c5565e1f83a67ce", "git_parents": ["aeeb3b7501865032198e2d688fa2df500d2f6ba6"], "node": "2e64bd67456f2d504ede4c80d38d410ae2b04d44", "parents": ["c83ffe7203b7f76ffd2329f9420f0ee134836636"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074129: Implement persistence of journey metadata r=cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329261\n", "files": ["browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/memories/journeys/JourneyStore.sys.mjs", "browser/components/aiwindow/models/memories/journeys/moz.build", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js", "browser/components/aiwindow/models/tests/browser/browser_JourneyStore.js"], "git_node": "debf3585de1cb78f57efa3acd0931fa9f09a4c95", "git_parents": ["eace82b0fd8c633627632acf2c5565e1f83a67ce"], "node": "6f0b9ec5a87079630ea4b80a7decc3539d5029df", "parents": ["2e64bd67456f2d504ede4c80d38d410ae2b04d44"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071733 - Update FFmpeg decoded frame plane handling. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326035\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoUtils.h"], "git_node": "2a50cba249b942a9a97b232d6e46fbf6c25a6abc", "git_parents": ["debf3585de1cb78f57efa3acd0931fa9f09a4c95"], "node": "9e639a9c2a6ae4bf98012c2c1d134abeaf726d10", "parents": ["6f0b9ec5a87079630ea4b80a7decc3539d5029df"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082704 - Update ANGLE vendoring script to point to Firefox Source Docs r=gfx-reviewers,tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334353\n", "files": ["gfx/angle/update-angle.py"], "git_node": "97deaba71e8141651d28f8a4ceab6506340ceb25", "git_parents": ["2a50cba249b942a9a97b232d6e46fbf6c25a6abc"], "node": "f3259d608af8fa135f13727212d54ca962b4b5bb", "parents": ["9e639a9c2a6ae4bf98012c2c1d134abeaf726d10"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Fail live alt-data readers when the alt-data writer fails r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334172\n", "files": ["netwerk/cache2/CacheFile.cpp", "netwerk/cache2/CacheFileChunk.cpp", "netwerk/cache2/CacheFileInputStream.h"], "git_node": "53327da3a768906ccfbced81e46fea0d64636ee6", "git_parents": ["97deaba71e8141651d28f8a4ceab6506340ceb25"], "node": "22ebd580f3441c28d5412cd9e52da09a4d43ba39", "parents": ["f3259d608af8fa135f13727212d54ca962b4b5bb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Reject incomplete compressed script bytecode r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334173\n", "files": ["dom/script/ScriptCompression.cpp"], "git_node": "e97177c8c2584e307754c7640da69c9b76e083dc", "git_parents": ["53327da3a768906ccfbced81e46fea0d64636ee6"], "node": "5184dee058d6c47f9a40748c19415df15e660326", "parents": ["22ebd580f3441c28d5412cd9e52da09a4d43ba39"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Test failed alt-data writes and incomplete compressed bytecode r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334174\n", "files": ["dom/base/test/gtest/TestScriptCompression.cpp", "dom/base/test/gtest/moz.build", "netwerk/test/unit/test_alt-data_failed_write.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "2dc3c68cfc7f7c53f41508dda9019a0f1e871c25", "git_parents": ["e97177c8c2584e307754c7640da69c9b76e083dc"], "node": "cd53110aa870cefe997f96dd9dff3fcd0c60c277", "parents": ["5184dee058d6c47f9a40748c19415df15e660326"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081951 - Add telemetry for rules_page_opened - r=ip-protection-reviewers,settings-reviewers,mconley,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334141\n", "files": ["browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/metrics.yaml", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules_srd.js"], "git_node": "063d18b4e6545c0a08d5cac5376d057e30982e47", "git_parents": ["2dc3c68cfc7f7c53f41508dda9019a0f1e871c25"], "node": "409d533569ea1cf6bedfe1312f6dae11d44d4c97", "parents": ["cd53110aa870cefe997f96dd9dff3fcd0c60c277"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2081515 - Move wasm SIMD lanes directly between vectors on x86 and x64. r=yury\n\nLower MWasmMoveLaneSimd128 on x86-shared so that a 16-, 32- or 64-bit\nreplace_lane fed by an extract_lane no longer goes through a general\nregister as pextr* then pinsr*:\n- a 64-bit lane moves with one movlhps or movhlps, or with one pblendw\n  when it keeps its index;\n- a 32-bit lane moves with one insertps;\n- a 16-bit lane moves with pblendw after a pshufd that broadcasts the\n  source dword into the SIMD scratch register and, when the lane changes\n  dword half, a 16-bit shift; a lane that keeps its index needs only the\n  pblendw.\n\nByte lanes keep the pextrb/pinsrb pair, since moving one needs a constant\nshuffle and a constant blend mask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333993\n", "files": ["js/src/jit-test/tests/wasm/simd/replace-lane-from-extract-lane-x64-ion-codegen.js", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.cpp"], "git_node": "3cdf5bd4bf9f74de3fd1db14725fd1f534868ecb", "git_parents": ["063d18b4e6545c0a08d5cac5376d057e30982e47"], "node": "f5974d35fa1ed2b6ab6aac5c7ce75fd04def00ad", "parents": ["409d533569ea1cf6bedfe1312f6dae11d44d4c97"], "tags": []}, {"author": "Denis Palmeiro \u003cdpalmeiro@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083066: Fix the android check for delaying post startup delay. r=perftest-reviewers,sparky DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334689\n", "files": ["testing/raptor/browsertime/speedometer3.js"], "git_node": "d3223c9644585bcaca0c7ee0b2196f323e210e40", "git_parents": ["3cdf5bd4bf9f74de3fd1db14725fd1f534868ecb"], "node": "9f495b78ae6506e45c1b85fe1152cc6ebc803ddd", "parents": ["f5974d35fa1ed2b6ab6aac5c7ce75fd04def00ad"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2072459 - Remove the unused YCbCrTextureClientAllocationHelper constructor r=gfx-reviewers,nical\n\nThe two-argument constructor derived the plane sizes from the unchecked\nPlanarYCbCrData accessors and has no callers;\nSharedPlanarYCbCrImage::CreateEmptyBuffer passes the sizes explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333478\n", "files": ["gfx/layers/client/TextureClientRecycleAllocator.cpp", "gfx/layers/client/TextureClientRecycleAllocator.h"], "git_node": "f79fa921bbc5157d3f7bf0bccab3449819e76a8f", "git_parents": ["d3223c9644585bcaca0c7ee0b2196f323e210e40"], "node": "ddfd605d4e3a88d316972839651c44740f750686", "parents": ["9f495b78ae6506e45c1b85fe1152cc6ebc803ddd"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2072459 - Use fallible planar image extents r=media-playback-reviewers,gfx-reviewers,bradwerth,padenot\n\nReplace the unchecked Y and chroma size accessors with the fallible\nPlanarYCbCrData::GetPlaneSizes() and migrate consumers to their existing\nerror paths.\n\nValidate geometry before allocation, backend access, or copying while\npreserving cropped origins and padded allocation sizes. Add geometry,\nconversion, and Mac IOSurface retry coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327203\n", "files": ["dom/canvas/ImageUtils.cpp", "dom/media/gtest/TestMediaDataEncoder.cpp", "dom/media/gtest/TestYUVBufferGenerator.cpp", "dom/media/platforms/apple/AppleVTEncoder.cpp", "dom/media/webcodecs/VideoFrame.cpp", "gfx/gl/GLBlitHelper.cpp", "gfx/layers/D3D11YCbCrImage.cpp", "gfx/layers/IMFYCbCrImage.cpp", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h", "gfx/layers/MacIOSurfaceImage.cpp", "gfx/layers/client/ImageClient.cpp", "gfx/layers/client/TextureClient.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/tests/gtest/TestMacIOSurfaceHelpers.cpp", "gfx/tests/gtest/TestPlanarYCbCrImage.cpp", "gfx/tests/gtest/TestTextures.cpp", "gfx/tests/gtest/TestYUVtoRGB32.cpp", "gfx/tests/gtest/TextureHelper.h", "gfx/tests/gtest/YCbCrTestHelpers.h", "gfx/tests/gtest/moz.build", "gfx/ycbcr/YCbCrUtils.cpp", "image/decoders/nsAVIFDecoder.cpp"], "git_node": "d8bb897145627b4fef8d62507d1e1516f3ab18ae", "git_parents": ["f79fa921bbc5157d3f7bf0bccab3449819e76a8f"], "node": "d19065f2503c630a9b64258b660419bb4b054a00", "parents": ["ddfd605d4e3a88d316972839651c44740f750686"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2072459 - Validate SharedPlanarYCbCrImage::CreateEmptyBuffer before mutating state r=gfx-reviewers,bradwerth\n\nReject a malformed picture rect or an allocation that cannot hold the\nplanes before the texture client is allocated and mData is overwritten,\nso a failed call leaves the image untouched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333479\n", "files": ["gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/tests/gtest/TestPlanarYCbCrImage.cpp"], "git_node": "1e832eb36a81b4a5d8d2440a2188aff2aa09f551", "git_parents": ["d8bb897145627b4fef8d62507d1e1516f3ab18ae"], "node": "4d82061eba9f3aa1af584f0d8e9ee569f17bbbf4", "parents": ["d19065f2503c630a9b64258b660419bb4b054a00"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050738 - Indent and deemphasize no tabs message in the synced tabs sidebar to match spec. r=sidebar-reviewers,sclements\n\nMakes the no tabs card in synced tabs an accordion to match the Figma spec and force full indent alignment. This patch also updates the no search results message as well for color and indent consistency, which wasn't in the bug but should likely match. Utilized existing tokens for the deemphasized text colour and the card spacing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333853\n", "files": ["browser/components/sidebar/sidebar-syncedtabs.mjs", "browser/components/sidebar/sidebar.css"], "git_node": "364a7c92eda317ea2fbda88b9ce48ca14b81fec0", "git_parents": ["1e832eb36a81b4a5d8d2440a2188aff2aa09f551"], "node": "34ea1c25a8dbaf0d78a70751f90da7bb3ca2fff1", "parents": ["4d82061eba9f3aa1af584f0d8e9ee569f17bbbf4"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083062 - Read the then data property from the lookup holder in RequiresDeferredPromiseResolution. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334676\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "8e6218c523e7feeb8a382176bf4f4f22d904f5eb", "git_parents": ["364a7c92eda317ea2fbda88b9ce48ca14b81fec0"], "node": "db6ff43c015c7d2b558f5dedac5a3fac6638fd7d", "parents": ["34ea1c25a8dbaf0d78a70751f90da7bb3ca2fff1"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082509 - Let New Tab multistage messages wait for the migration wizard to close. r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334178\n", "files": ["browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content/asrouter-admin.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/modules/ASRouterParentProcessMessageHandler.sys.mjs", "browser/components/asrouter/modules/ActorConstants.mjs", "browser/components/asrouter/tests/unit/ASRouterParentProcessMessageHandler.test.js"], "git_node": "01b759ff77a4b4ade8f74e025b750198e1ed0fe3", "git_parents": ["8e6218c523e7feeb8a382176bf4f4f22d904f5eb"], "node": "b57e8b8a2553de4e3f37ed97ca81b47678aa42c5", "parents": ["db6ff43c015c7d2b558f5dedac5a3fac6638fd7d"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082514 - Allow SHOW_MIGRATION_WIZARD to open the migration wizard as a tab-modal dialog. r=migration-reviewers,omc-reviewers,desktop-theme-reviewers,emilio,emcminn,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334179\n", "files": ["browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/content/migration-dialog-window.js", "browser/themes/shared/migration/migration-dialog-window.css", "browser/themes/shared/migration/migration-wizard.css", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_show_migration_wizard.js"], "git_node": "4bd98e993fda85ffa8bed201e5a80cf8bec58cbc", "git_parents": ["01b759ff77a4b4ade8f74e025b750198e1ed0fe3"], "node": "010b598f23b2e775e00bdc6d2a45776f3e91f193", "parents": ["b57e8b8a2553de4e3f37ed97ca81b47678aa42c5"], "tags": []}, {"author": "Nazeer Shaikh \u003ctheoriginalzan77@gmail.com\u003e", "branch": "default", "desc": "Bug 1965930 - Expand Glean profiler marker coverage in child processes. r=chutten\n\nThe IPC profiler test previously covered only a runtime labeled counter. This patch expands coverage to 28 child tasks across supported compile-time and runtime metric types, checking distribution samples, timer IDs, event extras, and rates with external denominators.\n\nIt also shares the profiler capture helper with the parent-process tests and limits capture to the recording callback to exclude unrelated setup and teardown markers. Existing child-process name-lookup limitations are explicitly tested.\n\nValidation: 52 local test runs passed using October 12 Mozilla CI optimized and debug macOS ARM64 builds, with both native and runtime metric registration. ESLint, formatting, and whitespace checks also passed.\n\nI don't have Try access, so cross-platform CI has not run. Could you help arrange a Try run before landing?\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333109\n", "files": ["toolkit/components/glean/tests/xpcshell/head_ProfilerMarkers.js", "toolkit/components/glean/tests/xpcshell/test_ProfilerMarkers.js", "toolkit/components/glean/tests/xpcshell/test_ProfilerMarkersIPC.js", "toolkit/components/glean/tests/xpcshell/xpcshell.toml"], "git_node": "f894fdd1e278e0fc750cc88139537d62c006c82e", "git_parents": ["4bd98e993fda85ffa8bed201e5a80cf8bec58cbc"], "node": "eaed0971b62f602a01eb68948a1d40ded73cf56e", "parents": ["010b598f23b2e775e00bdc6d2a45776f3e91f193"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081848 - Declare the browser window's globals as the members of a BrowserWindow type. r=Standard8\n\nThe globals keep their types; browser-window.d.ts takes those that are not system modules from BrowserWindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333760\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "b04cdb4a9fd91960cecdc5dfb4adccbc3a29f282", "git_parents": ["f894fdd1e278e0fc750cc88139537d62c006c82e"], "node": "b15898b837888ac0a2b716108522157321b6c456", "parents": ["eaed0971b62f602a01eb68948a1d40ded73cf56e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081848 - Type allSplitViews' return value as MozTabSplitViewWrapper[]. r=tabbrowser-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333761\n", "files": ["browser/components/tabbrowser/content/tabs.mjs"], "git_node": "14603d952e2e9162f35fdea11466db4f29b5b587", "git_parents": ["b04cdb4a9fd91960cecdc5dfb4adccbc3a29f282"], "node": "0b8575157edb1660a707d2cb5ec3de9da4921135", "parents": ["b15898b837888ac0a2b716108522157321b6c456"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081869 - Declare the browser window globals that the address bar reads. r=Standard8\n\nSitePermissions still types as any, because SitePermissions.sys.mjs refers to the object in its own initializer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333883\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "4de792cb8c9f19373ead3e54d06d1b1e628f8dd9", "git_parents": ["14603d952e2e9162f35fdea11466db4f29b5b587"], "node": "852d2762086dbd1cc08d653137fde103671b83ce", "parents": ["0b8575157edb1660a707d2cb5ec3de9da4921135"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081869 - Declare the lastLocationChange property that the tabbrowser sets on browser elements. r=reusable-components-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333884\n", "files": ["toolkit/content/widgets/browser-custom-element.mjs"], "git_node": "4a0b297b9d65cec93a7e166ab019e03ce6270ceb", "git_parents": ["4de792cb8c9f19373ead3e54d06d1b1e628f8dd9"], "node": "0b4184afb091e3decc54c6f4a8c4e08ea8cb2fcb", "parents": ["852d2762086dbd1cc08d653137fde103671b83ce"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081869 - Call URILoadingHelper's openTrustedLinkIn and switchToTabHavingURI directly from the address bar. r=urlbar-reviewers,Standard8\n\nThe tests spy on URILoadingHelper, which the window's wrappers forward to. browser_searchbar_dragdrop.js now creates its spy in the sandbox it restores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333885\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderAddonsShortcutMoved.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_dragdrop.js"], "git_node": "340069cf8b001aa1ff2a9679ba15d240aa6cdd9f", "git_parents": ["4a0b297b9d65cec93a7e166ab019e03ce6270ceb"], "node": "31fd520ceb5a330ff1956c4a5340d1a610c61362", "parents": ["0b4184afb091e3decc54c6f4a8c4e08ea8cb2fcb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081869 - Type the address bar code's browser windows as BrowserWindow. r=Standard8,urlbar-reviewers\n\nUrlbarValueFormatter's window is cast to BrowserWindow, since the formatter already reads gBrowser and gBrowserInit off it.\n\nUrlbarParentController imports SitePermissions rather than reading it off the window, which is behavior-neutral: the window's global is the same module instance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333886\n", "files": ["browser/components/urlbar/ActionsProviderContextualSearch.sys.mjs", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchTips.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/UrlbarValueFormatter.sys.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tsconfig.json"], "git_node": "232ad2b1ce8c3ab9a6941a6c1e70e6f7fe6f03e3", "git_parents": ["340069cf8b001aa1ff2a9679ba15d240aa6cdd9f"], "node": "41dc70018d0f9ebe60a57d56bd6c03ee7bb642ed", "parents": ["31fd520ceb5a330ff1956c4a5340d1a610c61362"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2083139: Make grid computed-style getters more robust. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334712\n", "files": ["layout/style/nsComputedDOMStyle.cpp"], "git_node": "dac7ec48204abac8541d50426e45aa56c5938ca2", "git_parents": ["232ad2b1ce8c3ab9a6941a6c1e70e6f7fe6f03e3"], "node": "32e52a70fc3483d2987851d914da5653b73c61cc", "parents": ["41dc70018d0f9ebe60a57d56bd6c03ee7bb642ed"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082995 - Remove the unused InternalAction.UpdateServiceState from feature-ipprotection. r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334585\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "54b045738617ae60822e0574af103e8cd447c1c3", "git_parents": ["dac7ec48204abac8541d50426e45aa56c5938ca2"], "node": "fbfbc3cd45690cb723d602d574f482d8083f5b09", "parents": ["32e52a70fc3483d2987851d914da5653b73c61cc"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Add tests for the legacy POSIX time zones EST5EDT, CST6CDT, MST7MDT, and PST8PDT r=dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334162\n", "files": ["js/src/tests/non262/Date/realm-time-zone-legacy-posix.js", "js/src/tests/non262/Date/time-zones-legacy-posix.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_legacy_posix.js"], "git_node": "9fe445c73f3fd395b11c183dc26720871e5c5b72", "git_parents": ["54b045738617ae60822e0574af103e8cd447c1c3"], "node": "1dd5197306061f0865357431a90a6b602e02b742", "parents": ["fbfbc3cd45690cb723d602d574f482d8083f5b09"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Update tzdata to 2026e r=dminor\n\nThis is a mechanical update done through `./update-tzdata.sh 2026e`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334163\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/zoneinfo64.txt"], "git_node": "61544b128894d3f9f8642fb3ea9c9df9880957d0", "git_parents": ["9fe445c73f3fd395b11c183dc26720871e5c5b72"], "node": "e77feefc6addfbde3da071174601ae7998551641", "parents": ["1dd5197306061f0865357431a90a6b602e02b742"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - SpiderMonkey update tz_data r=dminor\n\nThis is a mechanical update via `make_intl_data.py tzdata`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334164\n", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "eb2b4c6196bb6170bbf7a2692378772ec7535a39", "git_parents": ["61544b128894d3f9f8642fb3ea9c9df9880957d0"], "node": "f49487f5379e9e625f0c9958e53fb74e1f9ef5e8", "parents": ["e77feefc6addfbde3da071174601ae7998551641"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Make the ICU data hash visible to the build system to avoid caching failures. r=firefox-build-system-reviewers,ahochheiden\n\nI encountered failures with both sccache and buildcache beause the sccache and buildcache don't have semantic tracking through the .incbin inside the .S file, causing both tools to return out of date object files from the caches.\n\nTo fix this we add icu_dat_hashed.S to the sources list, and generate that from icu_data.S + the hash of the data file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334165\n", "files": ["config/external/icu/data/icu_data.S", "config/external/icu/data/icu_data_hash.py", "config/external/icu/data/moz.build"], "git_node": "753b793433ce9111d7d1b61e7aaa0e4bc9c36060", "git_parents": ["eb2b4c6196bb6170bbf7a2692378772ec7535a39"], "node": "ea0e172380f3fa32ab741b1736d930635c1faee7", "parents": ["f49487f5379e9e625f0c9958e53fb74e1f9ef5e8"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079869 - Ensure EST5EDT, CST6CDT, MST7MDT, and PST8PDT are not exposed as canonical time zone ids to the web r=hsivonen\n\nSpecial case these in make_intl_data.py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334166\n", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/builtin/intl/make_intl_data.py", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "f256f3e65b11fe0053e4e9e85f68240a3cd40f98", "git_parents": ["753b793433ce9111d7d1b61e7aaa0e4bc9c36060"], "node": "d35bd8cb4b38943413c67b96069a1369d35cc011", "parents": ["ea0e172380f3fa32ab741b1736d930635c1faee7"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Map legacy POSIX names to corresponding city zones r=dminor,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334167\n", "files": ["js/src/vm/DateTime.cpp"], "git_node": "8b535d2cd8254d1503b6e6ae3c31e0313e0d43e5", "git_parents": ["f256f3e65b11fe0053e4e9e85f68240a3cd40f98"], "node": "15425d8d45f7d0737b88df6ccb5b051762b26bf3", "parents": ["d35bd8cb4b38943413c67b96069a1369d35cc011"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077190 - Record autocomplete secondary action interactions. r=credential-management-reviewers,dimi,chutten\n\nRecord the interaction in AutoCompleteParent.selectAutoCompleteEntry, where\nit's known to come from a secondary action, rather than in each provider's\nmessage handler. The record type is inferred from the result's style (and,\nfor addresses and payment methods, the comment's type), and the interaction\nfrom the action's type, so providers don't need to pass anything extra. Both\ngo in a single autocomplete.record_interaction event defined in a new satchel\nmetrics file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330798\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/glean/metrics_index.py", "toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_footer.js", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/metrics.yaml", "toolkit/components/satchel/test/browser/browser_popup_secondary_action.js"], "git_node": "22323316a06856b8eea6e5044e0b9f35cf73f9d5", "git_parents": ["8b535d2cd8254d1503b6e6ae3c31e0313e0d43e5"], "node": "efc11fd4801d52951b5d707200565afad96b8d14", "parents": ["15425d8d45f7d0737b88df6ccb5b051762b26bf3"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077190 - Record autocomplete record removal confirmation dialog interactions. r=credential-management-reviewers,dimi\n\nRecord the user's response to the removal confirmation dialog in\nAutocompleteRemoveRecord.confirmRemoval, which every provider's dialog goes\nthrough, as a single autocomplete.record_dialog_interaction event with the\nrecord type, the response and the update type.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330799\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/AutocompleteRemoveRecord.sys.mjs", "toolkit/components/satchel/metrics.yaml"], "git_node": "4ff03d01ef936a886a92ff471ae842a304fc6625", "git_parents": ["22323316a06856b8eea6e5044e0b9f35cf73f9d5"], "node": "612246e70ba26247a074e9456c192321d61dc52b", "parents": ["efc11fd4801d52951b5d707200565afad96b8d14"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081366 - Record autocomplete dropdown shown telemetry. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333390\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/metrics.yaml", "toolkit/components/satchel/test/browser/browser_popup_secondary_action.js"], "git_node": "c84cfb543f8f1a243d18e8a80e4a683d63d061ed", "git_parents": ["4ff03d01ef936a886a92ff471ae842a304fc6625"], "node": "35475c6b8869b3fe1823396e904adc3f6fa6331e", "parents": ["612246e70ba26247a074e9456c192321d61dc52b"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081366 - Record autocomplete dropdown closed telemetry. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333421\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/metrics.yaml", "toolkit/components/satchel/test/browser/browser_popup_secondary_action.js"], "git_node": "04660ec97cd800832aab2979587393e5ea7547b3", "git_parents": ["c84cfb543f8f1a243d18e8a80e4a683d63d061ed"], "node": "429700bd26645803acd0049fa9bbbe56fcafe16f", "parents": ["35475c6b8869b3fe1823396e904adc3f6fa6331e"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073447 - Add an internal manifest property to register widgets with WidgetManager. r=rpl\n\n- Adds a privileged `builtin_widget` manifest property with the widget's `page`, `sizes`, `default_size` and `pref_branch`.\n- Registers the widget with `WidgetManager` once the extension is ready and unregisters it on shutdown.\n- Only privileged extensions can register a `builtin_widget` widget.\n- Stores each widget's enabled state and size in `\u003cpref_branch\u003e.enabled` and `\u003cpref_branch\u003e.size`, with `extensions.widgets.\u003ckey\u003e` as the default branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329433\n", "files": ["browser/components/extensions/ext-browser.json", "toolkit/components/extensions/Extension.sys.mjs", "toolkit/components/extensions/jar.mn", "toolkit/components/extensions/parent/ext-builtin-widget.js", "toolkit/components/extensions/schemas/builtin_widget.json", "toolkit/components/extensions/schemas/jar.mn", "toolkit/components/extensions/test/xpcshell/test_ext_builtin_widget.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml", "toolkit/components/widgets/WidgetManager.sys.mjs", "toolkit/components/widgets/tests/xpcshell/test_WidgetManager.js"], "git_node": "fe05cbb428a2749d483945cceb605c219c72b9bb", "git_parents": ["04660ec97cd800832aab2979587393e5ea7547b3"], "node": "91b43da07291a083016af754095dcc304f280611", "parents": ["429700bd26645803acd0049fa9bbbe56fcafe16f"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Read macOS preference sources separately. r=spohl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332139\n", "files": ["xpcom/base/nsIMacPreferencesReader.idl", "xpcom/base/nsMacPreferencesReader.mm"], "git_node": "dbf07a05a9aa344631fba50a10597676ae0c9ad0", "git_parents": ["fe05cbb428a2749d483945cceb605c219c72b9bb"], "node": "55538d30bab320ef03952e2cce58d562da717e2e", "parents": ["91b43da07291a083016af754095dcc304f280611"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Rename shouldIgnoreLocalPolicies to ignoreLocalPoliciesInAutomation. r=jneuberger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332479\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs"], "git_node": "99776e4df567dd242309fcda71250f8794443b16", "git_parents": ["dbf07a05a9aa344631fba50a10597676ae0c9ad0"], "node": "c50f4e4d98dd568aed62f69f3dc8c0201288ca98", "parents": ["55538d30bab320ef03952e2cce58d562da717e2e"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Rank user policies below all policy providers. r=fluent-reviewers,spohl,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332480\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/locales/en-US/browser/policies/policies-descriptions.ftl", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/tests/xpcshell/test_combined_provider_precedence.js"], "git_node": "27e57e0e6d5d9cff78566b78690eb714f386996b", "git_parents": ["99776e4df567dd242309fcda71250f8794443b16"], "node": "c97099e96dc99cc875c858dff8f103df0ab3485b", "parents": ["c50f4e4d98dd568aed62f69f3dc8c0201288ca98"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Restrict macOS policy sources to privileged domains. r=jneuberger,spohl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332140\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/macOSPoliciesParser.sys.mjs"], "git_node": "c9502e1543a2446a96b084aa47e420383953d14b", "git_parents": ["27e57e0e6d5d9cff78566b78690eb714f386996b"], "node": "49e4b454371c0f8ac80d6ddeaa67201d423571eb", "parents": ["c97099e96dc99cc875c858dff8f103df0ab3485b"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073015 - Add tests for macOS policy source selection. r=jneuberger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332141\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_macos_policy_sources.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "256c83fb3b4a08396ffba0f53a8bb17c07c968e2", "git_parents": ["c9502e1543a2446a96b084aa47e420383953d14b"], "node": "dd1350dd382f7ab9070541d8afeef5f65bc05c00", "parents": ["49e4b454371c0f8ac80d6ddeaa67201d423571eb"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2073015: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["xpcom/base/nsMacPreferencesReader.mm"], "git_node": "9a8292b18bedfdc0ce0654f858b46ed1c5eb8a28", "git_parents": ["256c83fb3b4a08396ffba0f53a8bb17c07c968e2"], "node": "74f62c9d6f11518a939f738b5aac0a970f8b660f", "parents": ["dd1350dd382f7ab9070541d8afeef5f65bc05c00"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073118 - Await MockEngineManager.rejectAllRequests() in the Smart Window browser tests. r=omarg,vazish\n\nThe next patch makes `rejectAllRequests()` async: it will wait for the chat turns MockEngineManager started to settle, and every caller has to await it before `cleanupMocks()` so no turn outlives the mocks. This patch only adds the `await`s (and makes the one synchronous cleanup function that calls it async); `rejectAllRequests()` is still synchronous here, so no test changes behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334336\n", "files": ["browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js", "browser/components/aiwindow/models/tests/browser/browser_conversation_stream.js", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/models/tests/browser/browser_smart_form_fill_model.js", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_context_tab_limit.js", "browser/components/aiwindow/ui/test/browser/browser_aichat_open_link.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_actions.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_menu_triggers.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_auto_tab_grouping_labeling.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_grouped_chips.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions_context.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_placeholder.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_security_get_open_tabs.js", "browser/components/aiwindow/ui/test/browser/browser_security_get_user_memories.js", "browser/components/aiwindow/ui/test/browser/browser_security_run_search.js", "browser/components/aiwindow/ui/test/browser/browser_security_search_browsing_history.js", "browser/components/aiwindow/ui/test/browser/browser_security_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_generation.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_get_page_content_timeout.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_history_thumbnails.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_history_thumbnails_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_jump_to_bottom.js", "browser/components/aiwindow/ui/test/browser/get_page_content/browser_get_page_content_errors.js", "browser/components/aiwindow/ui/test/browser/head_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js"], "git_node": "afb7dbd5cbe80c87b62a8961336c9f70d8b5fc2f", "git_parents": ["9a8292b18bedfdc0ce0654f858b46ed1c5eb8a28"], "node": "e430fee30c6a650dacd2ad9fbcb1e37179d2ac9c", "parents": ["74f62c9d6f11518a939f738b5aac0a970f8b660f"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073118 - Stop AITab browser tests from leaving a generation running after their mocks are restored. r=omarg,vazish\n\nbrowser_aitab_validation.js (and browser_aitab_schema_override.js, bug 2073119) never make model calls; they fail because of an earlier file in the same directory. When a browser_aitab_generation.js task timed out waiting for its mocked engine, its finally block restored the real `_createEngine` while the generation it started was still extracting pages. That abandoned generation then built a real engine and requested mlpa-prod while the next short file was running, or, when a later task in the same file had installed new mocks, consumed the response meant for that task.\n\nMockEngineManager now owns that lifecycle. It wraps `Chat.fetchWithHistory`, combining the caller's signal with its own through `AbortSignal.any` and tracking every turn it starts. `rejectAllRequests()` now also aborts those turns and keeps rejecting pending requests until each turn has settled (an aborted turn still sends one more chat request), so it is async; the previous patch made every caller await it before `cleanupMocks()`, which guarantees no turn outlives the mocks.\n\nbrowser_aitab_generation.js, browser_aitab.js and browser_aitab_context_tab_limit.js now drive generate_page the way production does: the mocked chat model calls the tool through `Chat.fetchWithHistory` (new `newChatConversation()` and `respondToWithToolCall()` helpers, and a `callTool()` head helper that resolves with the tool's result once the turn is over), and the tests read the result from the stored page and the tool message rather than from `generateAITab()`'s return value. Only the tasks that never reach a model still call `generateAITab()` directly. Two assertions change to match production: the tool drops a non-string URL before generating, so `num_tabs_total_attempted` is 1, and a chat that has read a page is private and untrusted, so building a second page from the same URL needs the user to have mentioned it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333288\n", "files": ["browser/components/aiwindow/models/tests/browser/browser_aitab.js", "browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js", "browser/components/aiwindow/models/tests/browser/head.js", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_context_tab_limit.js"], "git_node": "5316dd34c33580ccd75ec99f2da6be02a79e1d09", "git_parents": ["afb7dbd5cbe80c87b62a8961336c9f70d8b5fc2f"], "node": "de6352c8e6f424dd57f7be8075f6ee811fd6d7a1", "parents": ["e430fee30c6a650dacd2ad9fbcb1e37179d2ac9c"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073015: apply code formatting via Lando\" for causing build bustages @ CFTypeRefPtr.h\n\nThis reverts commit 9a8292b18bedfdc0ce0654f858b46ed1c5eb8a28.\n\nRevert \"Bug 2073015 - Add tests for macOS policy source selection. r=jneuberger\"\n\nThis reverts commit 256c83fb3b4a08396ffba0f53a8bb17c07c968e2.\n\nRevert \"Bug 2073015 - Restrict macOS policy sources to privileged domains. r=jneuberger,spohl\"\n\nThis reverts commit c9502e1543a2446a96b084aa47e420383953d14b.\n\nRevert \"Bug 2073015 - Rank user policies below all policy providers. r=fluent-reviewers,spohl,bolsson\"\n\nThis reverts commit 27e57e0e6d5d9cff78566b78690eb714f386996b.\n\nRevert \"Bug 2073015 - Rename shouldIgnoreLocalPolicies to ignoreLocalPoliciesInAutomation. r=jneuberger\"\n\nThis reverts commit 99776e4df567dd242309fcda71250f8794443b16.\n\nRevert \"Bug 2073015 - Read macOS preference sources separately. r=spohl\"\n\nThis reverts commit dbf07a05a9aa344631fba50a10597676ae0c9ad0.\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_macos_policy_sources.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "browser/locales/en-US/browser/policies/policies-descriptions.ftl", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/macOSPoliciesParser.sys.mjs", "toolkit/components/enterprisepolicies/tests/xpcshell/test_combined_provider_precedence.js", "xpcom/base/nsIMacPreferencesReader.idl", "xpcom/base/nsMacPreferencesReader.mm"], "git_node": "614dc4f6d256951ae068ba07ed4378a7bd057304", "git_parents": ["5316dd34c33580ccd75ec99f2da6be02a79e1d09"], "node": "12ce5a5ec59ba8efc555e260bc0de9ab80c6a899", "parents": ["de6352c8e6f424dd57f7be8075f6ee811fd6d7a1"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082267: Fall back to CLOCK_MONOTONIC when CLOCK_MONOTONIC_RAW is undefined, e.g. on Solaris. r=gfx-reviewers,tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334352\n", "files": ["gfx/angle/patches/0019-Fall-back-to-CLOCK_MONOTONIC-when-CLOCK_MONOTONIC_RA.patch", "third_party/angle/src/common/system_utils_linux.cpp"], "git_node": "71cb903509d706d81238455d56bd2e9ad38342e4", "git_parents": ["614dc4f6d256951ae068ba07ed4378a7bd057304"], "node": "a2bc9056db27b530d5d3033b51da7330cdb7d873", "parents": ["12ce5a5ec59ba8efc555e260bc0de9ab80c6a899"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076724 - Fix Reopen Closed Tab after reopening a closed tab group's tabs one at a time. r=sessionstore-reviewers,jswinarton\n\nundoCloseTabGroup used to clear the window's last closed group whichever group it reopened; forgetClosedTabGroup now clears it only when it names that group, so reopening an older closed group leaves Reopen Closed Tab offering the newer one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329920\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_tab_groups_undo.js"], "git_node": "6210f73af7ef7df6878d8f2d78599bf73e39c5ca", "git_parents": ["71cb903509d706d81238455d56bd2e9ad38342e4"], "node": "49050bfb79cfab7d78027d8876fae3bc8976811f", "parents": ["a2bc9056db27b530d5d3033b51da7330cdb7d873"], "tags": []}], "date": 1792208410, "git_changesets": ["46f51d4cb12053ebd59beda1704780a89ff6804d", "d6712d934c77e70eb6de546aed681e82e9213660", "a8b72f3e90530da7cea7b23d925a89a782a59f3a", "cb57527935653bffa4e72aa1f52ea870a937dbb0", "0a79cca4ed7772b34453d006541e3c16db466f18", "627353e2ccf9e6faf8f3b204d8d7bfb5676215eb", "8baccb0ee616bf7bc498a1282d2d36928a106234", "82141dc5570f0d1c9958110072a7db39a2061562", "973fe6912109188695010623d512a47bfe74da2f", "9053e766b4856698bb75abfb4acdc7e72122b1aa", "ffbdff5f0da651597c456c3633bc703d9627d5d4", "8103ea0e7b2b72447f11c21196f2a83a056d3669", "1ee3315053803575d7996d96989f309a2d7f1b31", "d03c3288bf1a6f27b663ad5900a6e46633e2a45b", "90d68393000787adf5a4be31281c02e38b8b6d5c", "c2818201c6422b38ea3bcbc7bf94ac3639433fbb", "8c6555e06456acfbb4300180d2556deb56b23ffc", "b4bb64637b16d770c60f2afbcdd99fcde9a358f6", "9512d8d05c50b7baea5476fa823fe97dc8f16ccf", "06af8149e92dfd2884b54cbe72c3ce70eec9e850", "55eff1bbadbbff5334f8ab1d949c763994bdc9a5", "4f1a73f873d1c8f5eaf7396b8f9052797488349d", "1b39bed73e3ffa3bca24aaa3f59b227024a32aac", "81fb8f65c5ef39a61798637c56f3812cfb28a590", "0d857f4300c164c02db885e9df5bd335089e25da", "a6e4e54eb51749b07196094b3256f3f38667b625", "932c4f6ad9d471b4fa86f55de9beafe17a6f443e