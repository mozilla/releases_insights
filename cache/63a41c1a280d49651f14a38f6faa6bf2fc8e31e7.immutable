ser/rustCreditCard/browser_creditCard_primaryPassword.js", "browser/extensions/formautofill/test/browser/rustCreditCard/head.js"], "git_node": "d777492de4a6b85fe6fdaca910a9d9dc8b1c7ef8", "git_parents": ["728d1db310390afa11385cd901457523802ec71a"], "node": "5873e9e24596f6f8171605dd62468855871ecc6b", "parents": ["7d35860bf4501d83501d7301b2723b3ca7096962"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069135 - AITab [FE] - Telemetry for viewing tabs and actions r=omarg\" for causing build bustages @ packager.mk\n\nThis reverts commit fcd35df8d24dc751d0e2a0bdf4a890a6e26d9517.\n\nRevert \"Bug 2069135 - part 1, Share the AITab component telemetry name. r=omarg\"\n\nThis reverts commit 9ce13896771e725aa05bd20e8fcd762acfdc931f.\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/ui/actors/AITabChild.sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabUtils.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml"], "git_node": "0dbf8550d136fb8d457bc4cb6539db9079d85f5b", "git_parents": ["d777492de4a6b85fe6fdaca910a9d9dc8b1c7ef8"], "node": "a2a45039faca161581877bb2bc4f5c884881a3a3", "parents": ["5873e9e24596f6f8171605dd62468855871ecc6b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2