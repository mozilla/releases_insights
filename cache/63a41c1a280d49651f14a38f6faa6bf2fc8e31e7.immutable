3b16", "27e57e0e6d5d9cff78566b78690eb714f386996b", "c9502e1543a2446a96b084aa47e420383953d14b", "256c83fb3b4a08396ffba0f53a8bb17c07c968e2", "9a8292b18bedfdc0ce0654f858b46ed1c5eb8a28", "afb7dbd5cbe80c87b62a8961336c9f70d8b5fc2f", "5316dd34c33580ccd75ec99f2da6be02a79e1d09", "614dc4f6d256951ae068ba07ed4378a7bd057304", "71cb903509d706d81238455d56bd2e9ad38342e4", "6210f73af7ef7df6878d8f2d78599bf73e39c5ca"], "user": "smolnar@mozilla.com"}, "45581": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2081300 - Stop exporting migration and browser aboutredirector headers and list them in SOURCE_HEADERS instead r=mconley,migration-reviewers\n\nThese were only exported so that the generated StaticComponents.cpp could include them. components.conf references them via absolute source paths, so they no longer need to be in EXPORTS and are listed in SOURCE_HEADERS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334510\n", "files": ["browser/components/about/moz.build", "browser/components/migration/components.conf", "browser/components/migration/moz.build"], "git_node": "286420ee277e2e301c97be9239165fa843862a85", "git_parents": ["6210f73af7ef7df6878d8f2d78599bf73e39c5ca"], "node": "5834a4657e5a0532c884d9295dc171c940acd74a", "parents": ["49050bfb79cfab7d78027d8876fae3bc8976811f"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039065 - Add tests for cleaning up stylesheets when destroying Document/ShadowRoot (bug 2038439); r=emilio,firefox-style-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300238\n", "files": ["layout/style/crashtests/2038439.html", "layout/style/crashtests/crashtests.list"], "git_node": "fb965c1a828b8b79ac15f8a39986da6989c7ca6b", "git_parents": ["286420ee277e2e301c97be9239165fa843862a85"], "node": "f4aa78362812f21b3cd56c9f7669282a32d18f2e", "parents": ["5834a4657e5a0532c884d9295dc171c940acd74a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083173. Fix confusing message about long cms profile length in about support. r=gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334744\n", "files": ["gfx/thebes/gfxPlatform.cpp"], "git_node": "16bfd772d78109a0de697cd7dd91085cb6a75525", "git_parents": ["fb965c1a828b8b79ac15f8a39986da6989c7ca6b"], "node": "b51dc209a1df24fcae043e85d126c919eabe7518", "parents": ["f4aa78362812f21b3cd56c9f7669282a32d18f2e"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074840 - Do not run the AutoConfig xpcshell tests on Android. r=jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333706\n", "files": ["extensions/pref/autoconfig/test/unit/xpcshell.toml"], "git_node": "a696277bc2aae4e91ce6f249d6803f539395c3f3", "git_parents": ["16bfd772d78109a0de697cd7dd91085cb6a75525"], "node": "665009c5390b36482b755176e876a52ec57c8640", "parents": ["b51dc209a1df24fcae043e85d126c919eabe7518"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083072 - Update background of Your Rule section in VPN panel - r=ip-protection-reviewers,lesleynorton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334695\n", "files": ["browser/components/ipprotection/content/ipprotection-content.css", "browser/components/ipprotection/content/ipprotection-content.mjs"], "git_node": "aa9fd6a7b6003db69893c9a6d53e77f62c8ee6d5", "git_parents": ["a696277bc2aae4e91ce6f249d6803f539395c3f3"], "node": "0ed4f04bb412b4368c9e4bea12b19ba39108c18a", "parents": ["665009c5390b36482b755176e876a52ec57c8640"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083184 - Introduce a pref to track whether the VPN panel was opened since release 160 - r=ip-protection-reviewers,lesleynorton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334756\n", "files": ["browser/app/profile/firefox.js", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_panel.js", "browser/components/ipprotection/tests/browser/head.js", "toolkit/components/ipprotection/docs/Preferences.md"], "git_node": "c32c397e1fca163faf775326e31b2461f2c27626", "git_parents": ["aa9fd6a7b6003db69893c9a6d53e77f62c8ee6d5"], "node": "e038af14cb3d2a68ce2560f72cc15fac2e6284b6", "parents": ["0ed4f04bb412b4368c9e4bea12b19ba39108c18a"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071132 - Add ImagePixelFormat to hold the image format from layers::Image r=media-playback-reviewers,padenot\n\nThis patch introduces `ImagePixelFormat`, which would be the internal\nvocabulary for the image format converted from the layers::Image for\nmedia applications. This new format class provides more types the\nWebCodecs needs, such as I420P10, which is absent in `ImageBitmapFormat`.\n\nInstead of extending types in `ImageBitmapFormat`, introducing a new\nclass is preferred since `ImageBitmapFormat` was added by Bug\n1141979 for a canceled project (FoxEye), and most of its usages were\nremoved by Bug 1500733. Previously, it was used in WebCodecs and related\nmedia applications to hold the image format we need. However, its role\nduplicates with the `VideoPixelFormat` today, and also makes its caller\ntouch unnecessary `dom` layer they don't really need since it was\ndefined in webidl.\n\nTo solve this issue, this patch introduces a thin layer holding the\nimage formats we need in media space, provides a conversion method to\nWebCodecs' type, and removes all the unnecessary types that have no users\nat all.\n\nThe whole `ImageBitmapFormat` replacement will be done in bug 2071133.\nBug 2071132 focuses on removing all of its usages in WebCodecs space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325215\n", "files": ["dom/media/ImagePixelFormat.cpp", "dom/media/ImagePixelFormat.h", "dom/media/gtest/MockGPUVideoSurfaceManager.h", "dom/media/gtest/TestImagePixelFormat.cpp", "dom/media/gtest/TestRemoteImageHolder.cpp", "dom/media/gtest/TestYUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.h", "dom/media/gtest/moz.build", "dom/media/moz.build"], "git_node": "fb3038f382b9525a6ee1b2dd13ac3bd0bc835db7", "git_parents": ["c32c397e1fca163faf775326e31b2461f2c27626"], "node": "caa5a1d4c4ff576d3cfbe81d2260e38ab0a1444a", "parents": ["e038af14cb3d2a68ce2560f72cc15fac2e6284b6"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071132 - Name WebCodecs VideoFrames from their ImagePixelFormat r=media-playback-reviewers,padenot\n\nEvery VideoFrame now derives its format from its layers::Image through\nGuessVideoPixelFormat, and ToVideoPixelFormat is the only mapping from\nthe internal names to the web enum.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325216\n", "files": ["dom/media/webcodecs/AudioDecoder.cpp", "dom/media/webcodecs/ImageTrack.cpp", "dom/media/webcodecs/VideoDecoder.cpp", "dom/media/webcodecs/VideoEncoder.cpp", "dom/media/webcodecs/VideoFrame.cpp", "dom/media/webcodecs/WebCodecsUtils.cpp", "dom/media/webcodecs/WebCodecsUtils.h", "dom/media/webcodecs/gtest/TestWebCodecsUtils.cpp", "dom/media/webcodecs/gtest/moz.build", "dom/media/webcodecs/test/generate_quadrants_fixtures.py", "dom/media/webcodecs/test/mochitest.toml", "dom/media/webcodecs/test/quadrants-vp9.webm", "dom/media/webcodecs/test/test_videoFrame_video_element.html", "dom/media/webcodecs/test/videoFrameFormatChecks.js"], "git_node": "262b13ec1fa7f48cd11ccf7bb49dcc373dd30464", "git_parents": ["fb3038f382b9525a6ee1b2dd13ac3bd0bc835db7"], "node": "52195af64905b0f52e1de23894d5853f8a7740eb", "parents": ["caa5a1d4c4ff576d3cfbe81d2260e38ab0a1444a"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049460 - Add new Source Docs tooling to support Settings UI documentation r=Standard8,mstriemer,settings-reviewers\n\nThis adds tooling required to get the Settings UI code into Source Docs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328977\n", "files": ["docs/_addons/js_typedef.py", "docs/conf.py", "docs/jsdoc-plugins/convert-descriptions-to-rst.mjs", "docs/jsdoc-plugins/skip-type-casts.mjs", "docs/jsdoc.json"], "git_node": "05e780985b66c67eb28cef4a108320c19150a8d1", "git_parents": ["262b13ec1fa7f48cd11ccf7bb49dcc373dd30464"], "node": "4b54600988d1067da6b1640f7c05ef665c3e7cee", "parents": ["52195af64905b0f52e1de23894d5853f8a7740eb"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083144 - Update string for Turn on VPN button - r=ip-protection-reviewers,fluent-reviewers,bolsson,lesleynorton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334716\n", "files": ["browser/components/ipprotection/content/ipprotection-status-card.mjs", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "0e6e5ae1be6415b365a44200e7fd3ec4c7bcfeaf", "git_parents": ["05e780985b66c67eb28cef4a108320c19150a8d1"], "node": "d0ab2288d85ea90ffefb39f2d371ac462d494f09", "parents": ["4b54600988d1067da6b1640f7c05ef665c3e7cee"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081895 - Follow up and clean up work in search widgets r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333869\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/widget/SearchWidgetIntents.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/widget/glance/SearchBarWidgets.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/widget/SearchWidgetIntentsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/widget/SearchWidgetProviderTest.kt"], "git_node": "fbd65046abe95c6da3b5e85714f25172839c1eca", "git_parents": ["0e6e5ae1be6415b365a44200e7fd3ec4c7bcfeaf"], "node": "20eed9eb6eed81c5cd76349ebb37553ec24e7b43", "parents": ["d0ab2288d85ea90ffefb39f2d371ac462d494f09"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079661 - Skip passive content in the ContentClassifier fingerprinters engine to match url-classifier. r=emz\n\nThis patch changes the fingerprinters engine to skip image and media loads\nin both the cancel and the annotate pass. url-classifier's fingerprinting\nfeatures return early for passive content, so the content classifier was\nblocking and annotating loads that url-classifier never touched. The request\nrecords passiveness through ChannelClassifierUtils::IsPassiveContent rather\nthan its type string, which also maps imageset loads to \"image\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331983\n", "files": ["toolkit/components/content-classifier/ContentClassifierFeatureUtils.cpp", "toolkit/components/content-classifier/ContentClassifierFeatureUtils.h", "toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.cpp", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.h", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_engines_pref.js", "toolkit/components/content-classifier/test/browser/browser_content_classifier_fingerprinters_passive.js", "toolkit/components/content-classifier/test/browser/browser_content_classifier_remote_settings.js", "toolkit/components/content-classifier/test/browser/empty_script.js", "toolkit/components/content-classifier/test/browser/head.js"], "git_node": "e59c9f94f5efcd8a1662bead693d8d643c7def19", "git_parents": ["fbd65046abe95c6da3b5e85714f25172839c1eca"], "node": "e208bdac3151c7fd1470aa2d09fb45ca6b44b929", "parents": ["20eed9eb6eed81c5cd76349ebb37553ec24e7b43"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079769 - Always mirror the cryptominers, fingerprinters and social-trackers annotation engines in ContentClassifierPrefMirror. r=emz\n\nurl-classifier creates its cryptomining, fingerprinting and social tracking\nannotation features without any pref check; only tracking annotation is\ngated by privacy.trackingprotection.annotate_channels. The mirror gated all\nfour on that pref, so turning it off also silenced cryptominer, fingerprinter\nand social tracker detection that url-classifier keeps reporting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332045\n", "files": ["toolkit/components/content-classifier/ContentClassifierPrefMirror.cpp", "toolkit/components/content-classifier/test/browser/browser_content_classifier_pref_mirror.js"], "git_node": "d71215586587ac10ffe742deb9fd306ff467a735", "git_parents": ["e59c9f94f5efcd8a1662bead693d8d643c7def19"], "node": "14d86c33081f297125403b3fe4709856ec28da77", "parents": ["e208bdac3151c7fd1470aa2d09fb45ca6b44b929"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083013 - Remove synchronous decoder creation from PlatformDecoderModule. r=media-playback-reviewers,azebrowski\n\nAsyncCreateDecoder is now the only way for a PlatformDecoderModule to create a\ndecoder, and CreateVideoDecoder and CreateAudioDecoder are no longer part of\nthe interface. Modules which still create their decoders synchronously use the\nnew CreateDecoderPromiseFrom helper, and the MediaResult out-parameter on\nCreateDecoderParams and SupportDecoderParams is removed in favour of rejecting\nthe promise.\n\nThere is no intended change in behaviour. This allows a module to finish\nsetting up a decoder asynchronously before deciding whether it can be used,\nwhile still letting PDMFactory fall back to another module.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334626\n", "files": ["dom/media/gtest/MockDecoderModule.h", "dom/media/ipc/RemoteDecoderModule.h", "dom/media/platforms/PlatformDecoderModule.cpp", "dom/media/platforms/PlatformDecoderModule.h", "dom/media/platforms/agnostic/AgnosticDecoderModule.cpp", "dom/media/platforms/agnostic/AgnosticDecoderModule.h", "dom/media/platforms/agnostic/BlankDecoderModule.cpp", "dom/media/platforms/agnostic/BlankDecoderModule.h", "dom/media/platforms/agnostic/NullDecoderModule.cpp", "dom/media/platforms/agnostic/eme/EMEDecoderModule.cpp", "dom/media/platforms/agnostic/eme/EMEDecoderModule.h", "dom/media/platforms/agnostic/gmp/GMPDecoderModule.cpp", "dom/media/platforms/agnostic/gmp/GMPDecoderModule.h", "dom/media/platforms/android/AndroidDecoderModule.cpp", "dom/media/platforms/android/AndroidDecoderModule.h", "dom/media/platforms/apple/AppleDecoderModule.cpp", "dom/media/platforms/apple/AppleDecoderModule.h", "dom/media/platforms/ffmpeg/FFmpegDecoderModule.h", "dom/media/platforms/omx/OmxDecoderModule.cpp", "dom/media/platforms/omx/OmxDecoderModule.h", "dom/media/platforms/wmf/MFMediaEngineDecoderModule.cpp", "dom/media/platforms/wmf/MFMediaEngineDecoderModule.h", "dom/media/platforms/wmf/WMFDecoderModule.cpp", "dom/media/platforms/wmf/WMFDecoderModule.h"], "git_node": "9ee38417a20ce73340ca05cd582ff5d6f19f4c3d", "git_parents": ["d71215586587ac10ffe742deb9fd306ff467a735"], "node": "2cf7682cf67c6d1ef4f808af8e2f91f437077eb8", "parents": ["14d86c33081f297125403b3fe4709856ec28da77"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071132 - Name WebCodecs VideoFrames from their ImagePixelFormat r=media-playback-reviewers,padenot\" for causing build bustages @ TestYUVBufferGenerator.cpp\n\nThis reverts commit 262b13ec1fa7f48cd11ccf7bb49dcc373dd30464.\n\nRevert \"Bug 2071132 - Add ImagePixelFormat to hold the image format from layers::Image r=media-playback-reviewers,padenot\"\n\nThis reverts commit fb3038f382b9525a6ee1b2dd13ac3bd0bc835db7.\n", "files": ["dom/media/ImagePixelFormat.cpp", "dom/media/ImagePixelFormat.h", "dom/media/gtest/MockGPUVideoSurfaceManager.h", "dom/media/gtest/TestImagePixelFormat.cpp", "dom/media/gtest/TestRemoteImageHolder.cpp", "dom/media/gtest/TestYUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.h", "dom/media/gtest/moz.build", "dom/media/moz.build", "dom/media/webcodecs/AudioDecoder.cpp", "dom/media/webcodecs/ImageTrack.cpp", "dom/media/webcodecs/VideoDecoder.cpp", "dom/media/webcodecs/VideoEncoder.cpp", "dom/media/webcodecs/VideoFrame.cpp", "dom/media/webcodecs/WebCodecsUtils.cpp", "dom/media/webcodecs/WebCodecsUtils.h", "dom/media/webcodecs/gtest/TestWebCodecsUtils.cpp", "dom/media/webcodecs/gtest/moz.build", "dom/media/webcodecs/test/generate_quadrants_fixtures.py", "dom/media/webcodecs/test/mochitest.toml", "dom/media/webcodecs/test/quadrants-vp9.webm", "dom/media/webcodecs/test/test_videoFrame_video_element.html", "dom/media/webcodecs/test/videoFrameFormatChecks.js"], "git_node": "780ccb1d0683c8399256d99d316e24ab2c6ab0b2", "git_parents": ["9ee38417a20ce73340ca05cd582ff5d6f19f4c3d"], "node": "1ebf5be55bcd8533eb18653aa7f7ee073a785dc7", "parents": ["2cf7682cf67c6d1ef4f808af8e2f91f437077eb8"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 597237: Change the paste-and-go menuitem label to 'Paste and Search' if the content of clipboard is not URL r=urlbar-reviewers,Standard8,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277834\n", "files": ["browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_pasteAndGo.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_context.js", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/chrome/browser/browser.properties", "python/l10n/fluent_migrations/bug_597237_paste_and_go.py"], "git_node": "fa19e15b43da5d20f90e1d879bc9c0e0591e641c", "git_parents": ["780ccb1d0683c8399256d99d316e24ab2c6ab0b2"], "node": "6ff5dc2c3cd24b7f9498b85a9ea54746eb31e90c", "parents": ["1ebf5be55bcd8533eb18653aa7f7ee073a785dc7"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053088 - Establish the outer proxy connection via Happy Eyeballs, r=mxinden\n\nGated by network.http.happy_eyeballs.proxy_enabled (default off). When enabled,\nthe outer Firefox\u003c-\u003eproxy connection for HTTPS CONNECT and MASQUE proxies is\ndriven by HappyEyeballsConnectionAttempt instead of DnsAndConnectSocket.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311264\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/HappyEyeballsConnMgrDelegate.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/HappyEyeballsTransaction.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpConnectionBase.h", "netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/nsAHttpTransaction.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.h", "netwerk/test/gtest/TestHappyEyeballsConnectionAttempt.cpp", "netwerk/test/unit/test_http3_proxy.js", "netwerk/test/unit/test_https_proxy_h3_outer_via_https_rr.js", "netwerk/test/unit/test_https_proxy_with_https_rr.js", "netwerk/test/unit/test_proxy_forwarding_peer_port.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "2df6be8ce1e5470c51d5bc47e56eeee77b4eebf3", "git_parents": ["fa19e15b43da5d20f90e1d879bc9c0e0591e641c"], "node": "4493e6ddd75bbf18ed5a672745f8771f6e961133", "parents": ["6ff5dc2c3cd24b7f9498b85a9ea54746eb31e90c"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053088 - Use Happy Eyeballs for SOCKS proxies via by-name connection attempts, r=necko-reviewers,valentin,mxinden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324051\n", "files": ["netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/AlternateServices.h", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/ConnectionEstablisher.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.cpp", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/nsAHttpTransaction.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/gtest/TestHappyEyeballsConnectionAttempt.cpp", "netwerk/test/gtest/TestHappyEyeballsNetAddrArray.cpp", "netwerk/test/unit/test_altsvc_proxy_cert_origin.js", "netwerk/test/unit/test_socks_proxy_fetch.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "2305fc7869033d3adc9ba04ae3ed6497d83a2314", "git_parents": ["2df6be8ce1e5470c51d5bc47e56eeee77b4eebf3"], "node": "dd8ec84b16320a7eb224a0b450c8020a3d149b22", "parents": ["4493e6ddd75bbf18ed5a672745f8771f6e961133"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074209 - Attach color-font palette cache to the individual gfxFontEntry for color fonts. r=gfx-reviewers,layout-reviewers,emilio,lsalzman\n\nThis is instead of having a shared cache attached to the presContext, and means the\nlifetime of the cache is directly tied to the font entry that owns it.\n\nCache lookups and modifications are guarded by the gfxFontEntry's RWLock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334249\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "gfx/src/nsFontMetrics.cpp", "gfx/thebes/FontPaletteCache.cpp", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/generic/TextOverflow.cpp", "layout/generic/nsTextFrame.cpp", "layout/mathml/nsMathMLChar.cpp"], "git_node": "2b4806238445a432c6327dccdd341f262cde3149", "git_parents": ["2305fc7869033d3adc9ba04ae3ed6497d83a2314"], "node": "0eb73ef4634e0a809069e0a92cf3487422b5e08c", "parents": ["dd8ec84b16320a7eb224a0b450c8020a3d149b22"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081959 - Store filename and FontData directly in SharedFTFace. r=gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334389\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceFreeType.cpp", "gfx/2d/NativeFontResourceFreeType.h", "gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2FontBase.h", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h"], "git_node": "cc717c4f27a77206179f53092c20da3380a265e3", "git_parents": ["2b4806238445a432c6327dccdd341f262cde3149"], "node": "99ae0f8ae99906c68f041bfded536dc93b629f4a", "parents": ["0eb73ef4634e0a809069e0a92cf3487422b5e08c"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083024. r=gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334768\n", "files": ["dom/canvas/CanvasRenderingContextHelper.cpp"], "git_node": "a28ec7f648edcd2f956356ec2960bee81311602d", "git_parents": ["cc717c4f27a77206179f53092c20da3380a265e3"], "node": "ceece80db31864d01fff87d3f148ff9ccd2ce73f", "parents": ["99ae0f8ae99906c68f041bfded536dc93b629f4a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083024. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334771\n", "files": ["dom/canvas/CanvasRenderingContextHelper.cpp"], "git_node": "e0c6a0bc17e076e1b1bca3104001e1bb4fc4bdd8", "git_parents": ["a28ec7f648edcd2f956356ec2960bee81311602d"], "node": "86d0289f34f3bd99ca33f6521a0f0f9451613475", "parents": ["ceece80db31864d01fff87d3f148ff9ccd2ce73f"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074209 - Attach color-font palette cache to the individual gfxFontEntry for color fonts. r=gfx-reviewers,layout-reviewers,emilio,lsalzman\" for causing build bustages @ gfxFontEntry.cpp\n\nThis reverts commit 2b4806238445a432c6327dccdd341f262cde3149.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "gfx/src/nsFontMetrics.cpp", "gfx/thebes/FontPaletteCache.cpp", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/generic/TextOverflow.cpp", "layout/generic/nsTextFrame.cpp", "layout/mathml/nsMathMLChar.cpp"], "git_node": "e847ab14b1a055b93c0b1777c397394e0ad330fd", "git_parents": ["e0c6a0bc17e076e1b1bca3104001e1bb4fc4bdd8"], "node": "5d67abf7605b31c3ecdeb5d3bd5aec2b64e156e8", "parents": ["86d0289f34f3bd99ca33f6521a0f0f9451613475"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053088 - Use Happy Eyeballs for SOCKS proxies via by-name connection attempts, r=necko-reviewers,valentin,mxinden\" for causing xpc & bc network related failures\n\nThis reverts commit 2305fc7869033d3adc9ba04ae3ed6497d83a2314.\n\nRevert \"Bug 2053088 - Establish the outer proxy connection via Happy Eyeballs, r=mxinden\"\n\nThis reverts commit 2df6be8ce1e5470c51d5bc47e56eeee77b4eebf3.\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/AlternateServices.h", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/ConnectionEstablisher.h", "netwerk/protocol/http/HappyEyeballsConnMgrDelegate.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/HappyEyeballsTransaction.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpConnectionBase.h", "netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.cpp", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/nsAHttpTransaction.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.h", "netwerk/test/gtest/TestHappyEyeballsConnectionAttempt.cpp", "netwerk/test/gtest/TestHappyEyeballsNetAddrArray.cpp", "netwerk/test/unit/test_altsvc_proxy_cert_origin.js", "netwerk/test/unit/test_http3_proxy.js", "netwerk/test/unit/test_https_proxy_h3_outer_via_https_rr.js", "netwerk/test/unit/test_https_proxy_with_https_rr.js", "netwerk/test/unit/test_proxy_forwarding_peer_port.js", "netwerk/test/unit/test_socks_proxy_fetch.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "3b2c49086e299a3f0d062a8552678cb9ad5de84e", "git_parents": ["e847ab14b1a055b93c0b1777c397394e0ad330fd"], "node": "059f2d7508ac5a8339686a25f3b8ab582e9d0bc6", "parents": ["5d67abf7605b31c3ecdeb5d3bd5aec2b64e156e8"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069156 - Hide the hide chatbot shortcut item once Highlight to Search is on. r=mlucks\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nWith the `browser.highlightToSearch.featureGate` pref on, the \"Hide chatbot shortcut\" item no longer appears in the AI submenu, since the menu is turned off from Settings. It stays when the gate is off, so existing users keep a way to hide the shortcut. Also adds a `selection_menu.enabled` state metric reporting whether the actions menu is turned on.\n\nTo test manually, select some text on a page, open the AI action's submenu, and confirm the hide item is listed with the gate off and gone with it on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334183\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "3c7cf2c538aeb7215578f1ca9a74caa243e95a6b", "git_parents": ["3b2c49086e299a3f0d062a8552678cb9ad5de84e"], "node": "2df2e4752e466a85ab0b90a3545b80f36f5a94fe", "parents": ["059f2d7508ac5a8339686a25f3b8ab582e9d0bc6"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080523 - Add the TemporalSuggestions Suggest feature with record validation, eligibility and selection. r=urlbar-reviewers,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332879\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/moz.build", "browser/components/urlbar/private/TemporalSuggestions.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_defaultPrefs.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js", "browser/components/urlbar/tests/quicksuggest/unit/xpcshell.toml"], "git_node": "bf6877748ad8101cf2c36e7432b6bdcaac1daaa6", "git_parents": ["3c7cf2c538aeb7215578f1ca9a74caa243e95a6b"], "node": "bc244c00fba816665d2b62130576af0792aeb136", "parents": ["2df2e4752e466a85ab0b90a3545b80f36f5a94fe"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bn/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/compose/browser-toolbar/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/autofill/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/contextmenu/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-uk/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-zh-rTW/strings.xml", "mobile/android/android-components/components/feature/pwa/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/feature/search/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bn/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-is/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml", "mobile/android/focus-android/app/src/main/res/values-bn/strings.xml"], "git_node": "fd9882d2c47c1de8e033acbeac15a0e5daccf69e", "git_parents": ["bf6877748ad8101cf2c36e7432b6bdcaac1daaa6"], "node": "bc648e8511c893ee91501c6b8914418d311c452c", "parents": ["bc244c00fba816665d2b62130576af0792aeb136"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082735: raise the open file limit on macOS and collect garbage between repetitions r=jgraham\n\nOn macOS the soft limit on open files starts at 256, and serve.py only raises\nit inside the server processes. The runner itself holds about 100 fds for\nthose servers plus 10 per TestRunnerManager (two mp.Queues: four pipes and six\nsemaphores), which are only freed when the cyclic GC gets to the dead managers.\ntest-verify of tests with several variants reached the limit and died with\nEMFILE when a manager started a browser.\n\nRaise the runner's soft limit the same way serve.py does, and collect garbage\nafter each repetition's ManagerGroup so the queues are freed promptly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334394\n", "files": ["testing/web-platform/tests/tools/serve/serve.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/environment.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptrunner.py"], "git_node": "8f7eaa6f0b7bf77e3e9815580bf8697a2a81d22b", "git_parents": ["fd9882d2c47c1de8e033acbeac15a0e5daccf69e"], "node": "6822c84d7ec4f481f3dc3c7d8b73b264f1e9fdfd", "parents": ["bc648e8511c893ee91501c6b8914418d311c452c"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081470: implement the WebTransport headers option r=dom-core-reviewers,necko-reviewers,ipc-reviewers,webidl,hsivonen,saschanaz,valentin\n\nAdd `headers` to WebTransportOptions.  It is filled into a Headers object, `wt-available-protocols` is rejected with a TypeError, and the rest goes through a request-guard Headers so forbidden request-header names are dropped silently.  The resulting list travels to the parent over CreateWebTransportParent and is set on the CONNECT channel before `wt-available-protocols`.  The parent applies the same restrictions again since the content process is not trusted.\n\nRemove the now-passing expectations from headers.https.any.js.ini.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333498\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h", "ipc/glue/PBackground.ipdl", "ipc/glue/PBackgroundSharedTypes.ipdlh", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/nsIWebTransport.idl", "testing/web-platform/meta/webtransport/headers.https.any.js.ini"], "git_node": "af45bd50e11c8752bcba492c636bedf043735b40", "git_parents": ["8f7eaa6f0b7bf77e3e9815580bf8697a2a81d22b"], "node": "fe5d702d271436c4d804c3d9b8367b0b7f684c7a", "parents": ["6822c84d7ec4f481f3dc3c7d8b73b264f1e9fdfd"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081488: fix the WebTransport headers option WPTs r=jib,valentin\n\nThe forbidden-header test asserted that Cookie, Host, Referer and Sec-Fetch-Mode never reach the server, but a user agent legitimately sends its own Referer and Sec-Fetch-Mode.  Assert that the user-supplied values are not forwarded instead.\n\nThe duplicate-header tests required each value in its own field.  RFC 9110 section 5.3 allows a sender to combine repeated fields, so accept either form.\n\nRemove headers.https.any.js.ini expectations for the three tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333499\n", "files": ["testing/web-platform/meta/webtransport/headers.https.any.js.ini", "testing/web-platform/tests/webtransport/headers.https.any.js"], "git_node": "7a7f5d578328522b0b9e170851e218de28704bfd", "git_parents": ["af45bd50e11c8752bcba492c636bedf043735b40"], "node": "5989dfb19f66ca6de1928939b8b086de3e486623", "parents": ["fe5d702d271436c4d804c3d9b8367b0b7f684c7a"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059292: createWritable() should not set a custom WritableStream high water mark r=saschanaz\n\nPer https://w3c.github.io/webtransport/#webtransportdatagramswritable-create\nstep 3, the writable is set up with only a write algorithm, so the default\nhigh water mark (1) applies. Use Nothing() instead of the datagram duplex\nstream's outgoingHighWaterMark, and drop the now-unused parameter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315173\n", "files": ["dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramsWritable.cpp", "dom/webtransport/api/WebTransportDatagramsWritable.h", "testing/web-platform/meta/webtransport/datagrams-writable.https.any.js.ini"], "git_node": "5b2d93106e3f2407c6925151e5094d8e289c76be", "git_parents": ["7a7f5d578328522b0b9e170851e218de28704bfd"], "node": "dc97a755dce3b26173f74e077cd7a8c11c07064d", "parents": ["5989dfb19f66ca6de1928939b8b086de3e486623"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078308: Throw a TypeError from datagrams.createWritable() for a sendGroup of another transport, r=jib,saschanaz\n\nThe spec checks the sendGroup before the transport state, and rejects with\na TypeError. The WPT expected an InvalidStateError; update it and add a\ncase for the check order.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331001\n", "files": ["dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "testing/web-platform/tests/webtransport/datagrams-writable.https.any.js"], "git_node": "c11ab6c638a9191722cbc0f309357d76a21487e3", "git_parents": ["5b2d93106e3f2407c6925151e5094d8e289c76be"], "node": "bb1a63e6d054cd023ff17bdc65d642806c7ddf4c", "parents": ["dc97a755dce3b26173f74e077cd7a8c11c07064d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007160: fix race between OnDraining and session-ready retargeting r=necko-reviewers,kershaw\n\nWebTransportSessionProxy::OnDraining() consulted mTarget directly, unlike\nits siblings (OnSessionClosed, OnAtomicWriteResult, OnDatagramReceivedInternal,\nOnMaxDatagramSizeInternal), which all check mStopRequestCalled first. Since\nthe listener's OnSessionReady runs on the main thread and retargets mTarget\nto the socket thread from there, a Draining event that arrives before that\nretargeting completes sees the stale main-thread default and misdelivers\nthe listener call to the main thread instead of the socket thread. Queue the\nevent like the other listener callbacks do until OnStopRequest has run.\n\nThat alone isn't sufficient: OnStopRequest sets mStopRequestCalled before\ncalling the listener's OnSessionReady (which performs the retarget), so a\ndraining event arriving in that gap (mStopRequestCalled true, retarget not\nyet run) still slips through to the listener on the wrong thread. For\nWebTransportParent, whose methods assert socket-thread affinity, this sends\nthe PWebTransport IPC message off its bound thread and crashes - observable\nwhenever a server drains a session immediately upon connecting. Close this\nby having WebTransportParent::OnDraining() hop onto mSocketThread itself\nbefore calling SendDraining(), matching NotifyRemoteClosed()'s existing\npattern for SendRemoteClosed(), instead of trusting its caller's thread.\n\nRemoved the draining.https.any.js.ini expectation metadata: all subtests\npass now that the crash is fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315172\n", "files": ["dom/webtransport/parent/WebTransportParent.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp"], "git_node": "65b08864820145fd15f84b2ecdb071c2416e8f9e", "git_parents": ["c11ab6c638a9191722cbc0f309357d76a21487e3"], "node": "8818bb321adef0fac33a6b53e9542deb16f89910", "parents": ["bb1a63e6d054cd023ff17bdc65d642806c7ddf4c"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: Enforce incomingHighWaterMark on the incoming datagram queue and count droppedIncoming r=necko-reviewers,kershaw\n\nNewDatagramReceived() drops the oldest queued datagrams until the queue\nis below incomingHighWaterMark before enqueuing, and counts the drops so\ngetStats() reports droppedIncoming instead of a hardcoded 0.  Raises the\ndefault incoming mark from 1 to 5 to match the outgoing default, and\nremoves the now-passing stats.https.any.js expectations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283500\n", "files": ["dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "testing/web-platform/meta/webtransport/stats.https.any.js.ini"], "git_node": "1f95bfb6e3dfd116a146c755f184d10405decc39", "git_parents": ["65b08864820145fd15f84b2ecdb071c2416e8f9e"], "node": "1e629672b4db16b4f30beec633c3a03d2ef45ec1", "parents": ["8818bb321adef0fac33a6b53e9542deb16f89910"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: verify incoming WebTransport datagrams are dropped oldest-first r=jib\n\nRewrite the incoming-bound datagram WPT to tag datagrams with sequence\nnumbers and check that the survivors come from the tail.  Replace the\n\"spin on Promise.resolve()\" idiom in the outgoing test with desiredSize.\nClose each transport from add_cleanup and swallow the resulting closed\nrejection, and switch the max-size+1 test to echo_datagram_length.py so\nits reply is always small enough to be delivered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280258\n", "files": ["testing/web-platform/tests/webtransport/datagrams.https.any.js"], "git_node": "f0c7a22fe3c381107e467ee990356fc2b12f8769", "git_parents": ["1f95bfb6e3dfd116a146c755f184d10405decc39"], "node": "154d95416a76af85f8bc9d04fb1d3966d3365edd", "parents": ["1e629672b4db16b4f30beec633c3a03d2ef45ec1"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: Tighten datagrams.https.any.js.ini WPT expectations r=necko-reviewers,valentin\n\nDrop the unconditional [OK, TIMEOUT] fallbacks and the mac TIMEOUT\nbranches, and replace loose [FAIL, PASS, ...] and [FAIL, NOTRUN]\nexpectations with a single definite result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327591\n", "files": ["testing/web-platform/meta/webtransport/datagrams.https.any.js.ini"], "git_node": "f933583a63fc8a63676196ed1cc5d097f03dfb51", "git_parents": ["f0c7a22fe3c381107e467ee990356fc2b12f8769"], "node": "d0e065dedd36fa21100d11d6d0c088ae50aa506e", "parents": ["154d95416a76af85f8bc9d04fb1d3966d3365edd"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007755: support BYOB readers on WebTransport datagrams r=saschanaz,webidl,smaug\n\nAdd WebTransportOptions.datagramsReadableType.  When it is \"bytes\",\ndatagrams.readable is built with byte reading support so a BYOB reader can be\nacquired, and pullDatagrams' byte branch rejects with a RangeError if the BYOB\nview is smaller than the datagram and with a TypeError if its element size is\nnot 1.\n\nThe pull goes through a new ReadableStream::PullFromBytes(), the Streams \"pull\nfrom bytes\" algorithm.  It is purely additive and WebTransport is its first\ncaller in the tree.  A zero-length datagram leaves the BYOB request pending\ninstead of responding with 0 bytes, which would throw a TypeError and error\nthe stream for the rest of the session.\n\nMost of the WebTransport.cpp diff is a renumbering of the constructor's\nspec-step comments rather than logic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286265\n", "files": ["dom/streams/ReadableStream.cpp", "dom/streams/ReadableStream.h", "dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini", "testing/web-platform/tests/webtransport/datagrams.https.any.js"], "git_node": "ed18ee733f16d4df933919ed1b51bee47682be82", "git_parents": ["f933583a63fc8a63676196ed1cc5d097f03dfb51"], "node": "adfa8b28e8b0ab4bda7bf9f555f18cffb3b7232a", "parents": ["d0e065dedd36fa21100d11d6d0c088ae50aa506e"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062010: fix some comments in webtransport sendorder WPT r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318338\n", "files": ["testing/web-platform/tests/webtransport/sendorder.https.any.js"], "git_node": "f9cfc585f805826b735cd262d5103e29b7291005", "git_parents": ["ed18ee733f16d4df933919ed1b51bee47682be82"], "node": "2507b01e973295b2086c4464327bf2860f4173ba", "parents": ["adfa8b28e8b0ab4bda7bf9f555f18cffb3b7232a"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009530: carry WebTransport stream reset/stop-sending error codes as 64-bit wire codes r=kershaw,necko-reviewers,webidl,smaug\n\nThe RESET_STREAM/STOP_SENDING error code was squashed through an nsresult on\nits way from neqo to content, which cannot represent the full WebTransport\ncode space.  Carry the wire code as a uint64_t end to end and map it back to\na WebTransport code in the DOM, where the HTTP/2 and HTTP/3 backends differ:\nHTTP/2 encodes the code directly, HTTP/3 has to skip greasing codepoints.\n\nWebTransport application error codes (streamErrorCode) are 32-bit, but the\nmapping functions in nsHttp.cpp were 8-bit and truncated larger codes.  Widen\nthem, and return Nothing for codes outside the application range so a peer\nthat sent no application code reaches script as null.\n\nSendStopSending() passed the raw application code to neqo; map it to the\nHTTP/3 code, as the RESET_STREAM path does.\n\nIncoming unidirectional streams were not in any WebTransportParent callback\nmap, so a peer RESET_STREAM never closed the local pipe.  Track them in\nmIncomingUniStreamCallbackMap and consult it from OnResetReceived().\nPeer-opened streams are removed from the callback maps once they finish\ncopying, and the reset/stop-sending error is sent to content before the pipe\nis closed.\n\nWebTransportError.streamErrorCode was an octet, which cannot hold the\n32-bit codes; make it an unsigned long.  Bring WebTransportError in line\nwith the spec while at it: the constructor is (optional DOMString message,\noptional WebTransportErrorOptions options) rather than a single init\ndictionary, the options' streamErrorCode is nullable, and source is\nsettable from script.  A session close() error no longer carries ABORT_ERR\nas its streamErrorCode.\n\nAdd webtransport-error.https.any.js and move the vendored\nstreams-close.https.any.js call sites to the new constructor form.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327733\n", "files": ["dom/webidl/WebTransportError.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransportError.cpp", "dom/webtransport/api/WebTransportError.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "dom/webtransport/shared/PWebTransport.ipdl", "netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportStream.cpp", "netwerk/protocol/http/Http2WebTransportStream.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportSession.h", "netwerk/protocol/http/Http3WebTransportStream.cpp", "netwerk/protocol/http/Http3WebTransportStream.h", "netwerk/protocol/http/WebTransportStreamBase.h", "netwerk/protocol/http/nsHttp.cpp", "netwerk/protocol/http/nsHttp.h", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.h", "netwerk/protocol/webtransport/WebTransportStreamProxy.cpp", "netwerk/protocol/webtransport/WebTransportStreamProxy.h", "netwerk/protocol/webtransport/nsIWebTransport.idl", "netwerk/protocol/webtransport/nsIWebTransportStream.idl", "netwerk/test/gtest/TestHttp2WebTransport.cpp", "netwerk/test/gtest/TestHttp3ConnectUDPStream.cpp", "testing/web-platform/tests/webtransport/streams-close.https.any.js", "testing/web-platform/tests/webtransport/webtransport-error.https.any.js"], "git_node": "22a4b1b859dda93156c15a5eec04b22ea83ab25c", "git_parents": ["f9cfc585f805826b735cd262d5103e29b7291005"], "node": "6dd565fc2b62036c09677a5d7379e94d07216a20", "parents": ["2507b01e973295b2086c4464327bf2860f4173ba"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009530: make WebTransportError serializable r=webidl,saschanaz\n\nThe spec marks WebTransportError [Serializable]: the DOMException fields\nare serialized, followed by source and streamErrorCode.  Serializable\nobjects can be stored in IndexedDB, so the tag takes the free stable slot\nEMPTY_SLOT_9.  DOMException's field reading is split out so the subclass\ncan reuse it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333500\n", "files": ["dom/base/DOMException.cpp", "dom/base/DOMException.h", "dom/base/StructuredCloneTags.h", "dom/webidl/WebTransportError.webidl", "dom/webtransport/api/WebTransportError.cpp", "dom/webtransport/api/WebTransportError.h", "testing/web-platform/tests/webtransport/webtransport-error.https.any.js"], "git_node": "5ba24a8a336cf98fc733f0f95f48a937d114c068", "git_parents": ["22a4b1b859dda93156c15a5eec04b22ea83ab25c"], "node": "710420b5e4c86cf6178209069e4a52fedf3784ef", "parents": ["6dd565fc2b62036c09677a5d7379e94d07216a20"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079281: close the WebTransport session when the parent actor is destroyed without Close() r=necko-reviewers,valentin\n\nWebTransportParent::ActorDestroy() did nothing, so a child that went away\nwithout Close() (e.g. a content process crash) left the session, and the\nstream copies waiting on it, open until the server closed it.\n\nCloseSession() must run on the proxy's target thread, which only becomes the\nsocket thread in OnSessionReady(); if the actor is destroyed before that, the\nsocket-thread runnable dispatched there closes the session instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331783\n", "files": ["dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h"], "git_node": "d70dd3859c75e1ad512fb41c06b4bd4b6c40aab0", "git_parents": ["5ba24a8a336cf98fc733f0f95f48a937d114c068"], "node": "715884d4745b2aabbeb9d51857d11745f65df290", "parents": ["710420b5e4c86cf6178209069e4a52fedf3784ef"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009593: Don't reset a WebTransport stream twice r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287801\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3WebTransportStream.h"], "git_node": "b75d968b7874ecc89c8c569e49fd17e3fc1beeb8", "git_parents": ["d70dd3859c75e1ad512fb41c06b4bd4b6c40aab0"], "node": "2651befddf17973698874c2afa6e92b5f73d24a3", "parents": ["715884d4745b2aabbeb9d51857d11745f65df290"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010394: Set max datagram size for WebTransport connections before ready resolves r=necko-reviewers,kershaw,ipc-reviewers\n\nFetch the max datagram size on the socket thread in OnSessionReady and\nreturn it as a third value of the CreateWebTransportParent response,\ninstead of a separate GetMaxDatagramSize IPC after it completes.  The\nchild sets it before resolving ready.  The GetMaxDatagramSize IPC is\nkept for later queries.\n\nCleanup() now resolves ready if the connection closes while it is still\npending, and an invalid URL reports the NS_NewURI error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283986\n", "files": ["dom/webtransport/api/WebTransport.cpp", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "ipc/glue/PBackground.ipdl"], "git_node": "2af01e2aa06943dc5f85f0303dc593ada6dfd9d2", "git_parents": ["b75d968b7874ecc89c8c569e49fd17e3fc1beeb8"], "node": "3a710cd903f1c51d4ba855ce960aa4f04247fc26", "parents": ["2651befddf17973698874c2afa6e92b5f73d24a3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010394: fix HTTP/2 backend leaving max datagram size pinned at 0 r=necko-reviewers,kershaw\n\nHttp2WebTransportSessionImpl::GetMaxDatagramSize() was an empty no-op that\nnever called back into OnMaxDatagramSize, unlike Http3WebTransportSession's\nimplementation, which calls back synchronously. mMaxDatagramSizeValue\ntherefore stayed at its default-constructed 0 for every HTTP/2-backed\nsession, which content then set as datagrams.[[OutgoingMaxDatagramSize]] --\nper spec, writeDatagrams()/sendDatagrams() silently no-ops forever once that\nvalue is less than any real payload, i.e. always, since 0 is less than any\nn\u003e=1 bytes.\n\nCall back with 1024, the same implementation-defined default used\nelsewhere (WebTransportDatagramDuplexStream.h's mOutgoingMaxDataSize) for a\nbackend with no equivalent limit to HTTP/3's max_datagram_size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318355\n", "files": ["netwerk/protocol/http/Http2WebTransportSession.cpp"], "git_node": "ce57defaa68b0fb4b9210fab8b1c87c45daf39a3", "git_parents": ["2af01e2aa06943dc5f85f0303dc593ada6dfd9d2"], "node": "263baf77ac089b6a2f74e3a26d76d0bf6b8dd0ee", "parents": ["3a710cd903f1c51d4ba855ce960aa4f04247fc26"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023144: Test bad serverCertificateHashes options for creating WebTransports r=jib\n\nAlso allow an empty serverCertificateHashes list with allowPooling, which the\nconstructor rejected although the spec only forbids a non-empty one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287559\n", "files": ["dom/webtransport/api/WebTransport.cpp", "testing/web-platform/tests/webtransport/constructor-certificate-hashes.https.sub.any.js", "testing/web-platform/tests/webtransport/constructor.https.sub.any.js"], "git_node": "112a9038e46cdab5d62e4462633ad9e9a59cdf75", "git_parents": ["ce57defaa68b0fb4b9210fab8b1c87c45daf39a3"], "node": "eaccbb9a2f8eec6514b611c314b7334e7279c22a", "parents": ["263baf77ac089b6a2f74e3a26d76d0bf6b8dd0ee"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023280: clear old data out of streams_dict after session close r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287742\n", "files": ["testing/web-platform/tests/webtransport/handlers/echo.py"], "git_node": "e831da39494fb2ab8d13bbb49a8dea1ec9ae8992", "git_parents": ["112a9038e46cdab5d62e4462633ad9e9a59cdf75"], "node": "07903d14f30ce7807ed1bb5f7faabfbeccc344d5", "parents": ["eaccbb9a2f8eec6514b611c314b7334e7279c22a"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023583: Implement child-side CloseAll() to handle WebTransport Cleanup r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288036\n", "files": ["dom/webtransport/child/WebTransportChild.cpp", "dom/webtransport/parent/WebTransportParent.cpp"], "git_node": "1cd06c3e88179104373d99cc360336f13bd41620", "git_parents": ["e831da39494fb2ab8d13bbb49a8dea1ec9ae8992"], "node": "2cd813c8c8f70497e735f3eff6d18f1b79a19c56", "parents": ["07903d14f30ce7807ed1bb5f7faabfbeccc344d5"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007205: Add xpcshell tests for new WebTransport spec features r=saschanaz,necko-reviewers,kershaw,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277257\n", "files": ["dom/webtransport/test/xpcshell/test_new_features.js", "dom/webtransport/test/xpcshell/xpcshell.toml"], "git_node": "236d32a31fb9c67c7bd306abeb257b34e9b2a56e", "git_parents": ["1cd06c3e88179104373d99cc360336f13bd41620"], "node": "57b91ca3ba35e079e50b72f7c3622c1a0015183d", "parents": ["2cd813c8c8f70497e735f3eff6d18f1b79a19c56"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033220: backend changes for WebTransport ResponseHeaders r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295144\n", "files": ["netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportSession.h", "netwerk/protocol/http/WebTransportSessionBase.h", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/gtest/TestHttp3WebTransportSession.cpp", "netwerk/test/gtest/moz.build"], "git_node": "aa8a95887ca03b14259ae37a39221469b5970a9e", "git_parents": ["236d32a31fb9c67c7bd306abeb257b34e9b2a56e"], "node": "9809bec887796481f41865b518074f9ffbaa60ff", "parents": ["57b91ca3ba35e079e50b72f7c3622c1a0015183d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033220: plumb the WebTransport CONNECT response headers to the content process r=necko-reviewers,dom-core-reviewers,smaug,valentin\n\nAdd nsIWebTransport::getResponseHeaders, cache the header list on\nWebTransportSessionProxy when the session becomes ready, and rename\nPWebTransport::NegotiatedProtocol to NegotiatedProtocolAndHeaders so the\nparent delivers the headers with the negotiated subprotocol.  The headers\nare only stored on the WebTransport object here; they are not yet exposed\nto script.  Also drops WebTransport::SetUsesHttp2()/mUsesHttp2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295145\n", "files": ["dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "dom/webtransport/child/WebTransportChild.cpp", "dom/webtransport/child/WebTransportChild.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/shared/PWebTransport.ipdl", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.h", "netwerk/protocol/webtransport/nsIWebTransport.idl"], "git_node": "5fef34c72bac04f310b0d834069e921487e46e2f", "git_parents": ["aa8a95887ca03b14259ae37a39221469b5970a9e"], "node": "763d61855146888f8e49be5ecf3fa9d2219a0802", "parents": ["9809bec887796481f41865b518074f9ffbaa60ff"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033220: Add WebIDL for ResponseHeaders and hook up DOM r=dom-core-reviewers,webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295146\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "testing/web-platform/meta/webtransport/headers.https.any.js.ini", "testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini", "testing/web-platform/tests/webtransport/response-headers.https.any.js"], "git_node": "db8bc2efc8111c44d42a513ca620b821883204ce", "git_parents": ["5fef34c72bac04f310b0d834069e921487e46e2f"], "node": "e972df7aa498bbbee36e7632d290f82fdd1c1150", "parents": ["763d61855146888f8e49be5ecf3fa9d2219a0802"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079306: make WebTransport exportKeyingMaterial args required and implement outputLength r=necko-reviewers,webidl,kershaw,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313848\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "dom/webtransport/shared/PWebTransport.ipdl", "dom/webtransport/test/xpcshell/test_new_features.js", "netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportSession.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportSession.h", "netwerk/protocol/http/WebTransportSessionBase.h", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/nsIWebTransport.idl", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/test/gtest/TestHttp3ConnectUDPStream.cpp", "testing/web-platform/meta/webtransport/export-keying-material.https.any.js.ini", "testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini"], "git_node": "50f209d9b56104823e15e7a31144db8c75bbecea", "git_parents": ["db8bc2efc8111c44d42a513ca620b821883204ce"], "node": "340e848d8399f2d8cb3d1f17fa6aba0df0808259", "parents": ["e972df7aa498bbbee36e7632d290f82fdd1c1150"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063706: reject ExportKeyingMaterial's promise on failure instead of resolving with an empty array r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318354\n", "files": ["dom/webtransport/api/WebTransport.cpp", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/shared/PWebTransport.ipdl"], "git_node": "ddf2e4743ed8a6e73d18ae38974a84a43df35e14", "git_parents": ["50f209d9b56104823e15e7a31144db8c75bbecea"], "node": "f8ccf775353fe2bfd09a092fb0066258f56a43fb", "parents": ["340e848d8399f2d8cb3d1f17fa6aba0df0808259"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079306: Update exportKeyingMaterial WPTs for spec change r=jib,webidl,smaug\n\nPer w3c/webtransport#774, exportKeyingMaterial(label, context, outputLength)\ntakes all three arguments as required (context is no longer optional and the\nprose no longer says \"if context is given\").\n\nRewrite the WPTs to the 3-argument form, asserting the output is outputLength\nbytes and covering the outputLength === 0 RangeError. The Firefox-specific\nrejection of outputLength above the implementation maximum moves to a\n/_mozilla/ test, since the spec only requires that maximum to be at least 4096.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310251\n", "files": ["testing/web-platform/mozilla/tests/webtransport/export-keying-material-output-length.https.any.js"], "git_node": "82a4f8b517342f798ba70f925159b485b5351cc8", "git_parents": ["ddf2e4743ed8a6e73d18ae38974a84a43df35e14"], "node": "214f37311990bcb9d6e6d6756e00d5667b891d08", "parents": ["f8ccf775353fe2bfd09a092fb0066258f56a43fb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057214: reset wpt meta r=jib,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313748\n", "files": ["testing/web-platform/meta/webtransport/csp-fail.https.window.js.ini", "testing/web-platform/meta/webtransport/csp-pass.https.window.js.ini", "testing/web-platform/meta/webtransport/datagram-bad-chunk.https.any.js.ini", "testing/web-platform/meta/webtransport/echo-large-bidirectional-streams.https.any.js.ini", "testing/web-platform/meta/webtransport/in-removed-iframe.https.html.ini", "testing/web-platform/meta/webtransport/sendorder.https.any.js.ini", "testing/web-platform/meta/webtransport/sendstream-bad-chunk.https.any.js.ini", "testing/web-platform/meta/webtransport/server-certificate-hashes.https.any.js.ini", "testing/web-platform/meta/webtransport/streams-close.https.any.js.ini"], "git_node": "e1a235bea5ea294c1faedde680842c2b56c7bfec", "git_parents": ["82a4f8b517342f798ba70f925159b485b5351cc8"], "node": "e1dbd8fadbbff61c9492a0ba9ce636a8e1573a74", "parents": ["214f37311990bcb9d6e6d6756e00d5667b891d08"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021710: Remove timestamp from send/receive stream stats r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286532\n", "files": ["dom/webidl/WebTransportSendReceiveStream.webidl"], "git_node": "eaaacd7198589efe74c0e1ce164ea2932fc140d7", "git_parents": ["e1a235bea5ea294c1faedde680842c2b56c7bfec"], "node": "6e11264cab2e434d5bf07286ed09022d268e43de", "parents": ["e1dbd8fadbbff61c9492a0ba9ce636a8e1573a74"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078339: Let InputToReadableStreamAlgorithms subclasses defer erroring the stream, r=saschanaz\n\nAdd ShouldPropagateError(), consulted before the stream is errored with the generic TypeError. A subclass returns false to hold off and then owns erroring or closing the stream. The default propagates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331010\n", "files": ["dom/streams/UnderlyingSourceCallbackHelpers.cpp", "dom/streams/UnderlyingSourceCallbackHelpers.h"], "git_node": "6d948900d454f288054f7a185b90f5c1ee43af85", "git_parents": ["eaaacd7198589efe74c0e1ce164ea2932fc140d7"], "node": "00b3b26a0faa55fe6a4230e5c907c9b04325fa8c", "parents": ["6e11264cab2e434d5bf07286ed09022d268e43de"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: test that a reading consumer receives more than the incoming queue bound r=jib\n\nThe existing incomingMaxBufferedDatagrams test deliberately has no reader\nattached while the burst arrives, so it exercises head-drop and passes\nprecisely because the queue evicts. It cannot catch the case where a burst\nlands while a read() is already pending: incoming datagrams are delivered\ninline from IPC dispatch, so if no microtask checkpoint runs between\nmessages, the pending read cannot resolve mid-batch and every arrival\nevicts its predecessor. WebKit hit exactly that (webkit.org/b/321176),\nwhere only the first and last datagram of a burst reached script.\n\nThe bound limits how much may sit buffered while nothing reads, not how\nmuch a continuously-reading consumer can receive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318351\n", "files": ["testing/web-platform/tests/webtransport/datagrams2.https.any.js"], "git_node": "a5a132b868eb61054e61ca8e1bebd0e46af4efcf", "git_parents": ["6d948900d454f288054f7a185b90f5c1ee43af85"], "node": "52ed76dd8de7fe60323b904077674cac95ad9c12", "parents": ["00b3b26a0faa55fe6a4230e5c907c9b04325fa8c"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: add a server-initiated datagram flood handler and test r=jib\n\nEvery existing datagram handler echoes what the client wrote, so incoming\ndatagrams inherit the client's send pacing and never arrive bunched. That\nleaves the case where a server pushes datagrams faster than the client reads\nuntested, and makes it impossible to measure what the receive path costs\nwhen datagrams do pile up within one socket-thread turn.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318352\n", "files": ["testing/web-platform/tests/webtransport/datagrams2.https.any.js", "testing/web-platform/tests/webtransport/handlers/server-flood-datagrams.py"], "git_node": "c5b547aff1d84771edcab8bd0f8b1c683ee396a0", "git_parents": ["a5a132b868eb61054e61ca8e1bebd0e46af4efcf"], "node": "d7a416658dbd44cbd3d0375871904ba7fbf2a3d9", "parents": ["52ed76dd8de7fe60323b904077674cac95ad9c12"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: test outgoing datagram expiry accounting in getStats() r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318644\n", "files": ["testing/web-platform/meta/webtransport/datagram-stats.https.any.js.ini", "testing/web-platform/tests/webtransport/datagram-stats.https.any.js"], "git_node": "2a80180839b4c50968f5ae233d350d07dbecc741", "git_parents": ["c5b547aff1d84771edcab8bd0f8b1c683ee396a0"], "node": "5af070286a7a661f9ce3e6478ce2e5e2338eda74", "parents": ["d7a416658dbd44cbd3d0375871904ba7fbf2a3d9"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007825: Add WPTs for anticipatedConcurrentIncomingUni/BidirectionalStreams r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280259\n", "files": ["testing/web-platform/meta/webtransport/anticipated-streams.https.any.js.ini", "testing/web-platform/tests/webtransport/anticipated-streams.https.any.js"], "git_node": "c8c0b16d3725f3daf61e8027559ff7b90f4607ca", "git_parents": ["2a80180839b4c50968f5ae233d350d07dbecc741"], "node": "e1ceabc0f5ebba50dac8c3f1cd0fb04ab68ef3e7", "parents": ["5af070286a7a661f9ce3e6478ce2e5e2338eda74"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007825: Add WPTs that anticipatedConcurrentIncomingUni/BidirectionalStreams raise the peer-visible QUIC stream limits r=jib\n\nThe handler reports the client's current max_streams limits from the QUIC\nconnection rather than opening that many streams.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280260\n", "files": ["testing/web-platform/tests/webtransport/anticipated-streams.https.any.js", "testing/web-platform/tests/webtransport/handlers/anticipated-streams.py"], "git_node": "e092bfd680534f3c819b1ba0b3ee509029305a2d", "git_parents": ["c8c0b16d3725f3daf61e8027559ff7b90f4607ca"], "node": "32c5b79e4f493f5d2c70eaa0a24bf49a75de670d", "parents": ["e1ceabc0f5ebba50dac8c3f1cd0fb04ab68ef3e7"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021710: Add WPT tests for WebTransport ReceiveStream/SendStream/SendGroup getStats() r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286527\n", "files": ["testing/web-platform/meta/webtransport/stream-stats.https.any.js.ini", "testing/web-platform/tests/webtransport/stream-stats.https.any.js"], "git_node": "993bfef86d080718aefc1edd6f9b1ba85c09b60b", "git_parents": ["e092bfd680534f3c819b1ba0b3ee509029305a2d"], "node": "93468891c910460224da6a75460fdb3761275f71", "parents": ["32c5b79e4f493f5d2c70eaa0a24bf49a75de670d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078344: Add WPTs that a peer's STOP_SENDING/RESET_STREAM leaves one half of a bidirectional stream writable, r=jib\n\nSend for STOP_SENDING, receive for RESET_STREAM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331012\n", "files": ["testing/web-platform/meta/webtransport/streams-reset-bidi-keeps-writing.https.any.js.ini", "testing/web-platform/meta/webtransport/streams-stop-sending-bidi-keeps-reading.https.any.js.ini", "testing/web-platform/tests/webtransport/handlers/reset-bidi-stream-then-read.py", "testing/web-platform/tests/webtransport/handlers/stop-sending-bidi-stream-then-send.py", "testing/web-platform/tests/webtransport/streams-reset-bidi-keeps-writing.https.any.js", "testing/web-platform/tests/webtransport/streams-stop-sending-bidi-keeps-reading.https.any.js"], "git_node": "5ba2d26252b35ec14cadce56e76a2e37bdf565e9", "git_parents": ["993bfef86d080718aefc1edd6f9b1ba85c09b60b"], "node": "f62523d7b67b7e105c71bb1aaac3e7a48def319d", "parents": ["93468891c910460224da6a75460fdb3761275f71"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023587: Rename the WebTransport datagram *HighWaterMark attributes to *MaxBufferedDatagrams r=jib,dom-core-reviewers,webidl,hsivonen,saschanaz\n\nThe spec also changed the attribute type from unrestricted double to\nunsigned long, so the setters lose their RangeError path and keep only\nthe clamp to 1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334395\n", "files": ["dom/webidl/WebTransportDatagramDuplexStream.webidl", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini", "testing/web-platform/meta/webtransport/historical.https.sub.any.js.ini", "testing/web-platform/tests/webtransport/datagrams.https.any.js"], "git_node": "c5756a9fb129ce547c1bdc9b657482a762bd580b", "git_parents": ["5ba2d26252b35ec14cadce56e76a2e37bdf565e9"], "node": "2dbec81a3b4d67daaf0f842d3994bdbba14973cf", "parents": ["f62523d7b67b7e105c71bb1aaac3e7a48def319d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: Fix WebTransport datagram WPTs that conflated highWaterMark with outgoingMaxBufferedDatagrams r=jib\n\ndatagrams.https.any.js asserted that writer.desiredSize tracks\noutgoingMaxBufferedDatagrams, i.e. that the writable's queuing-strategy\nhighWaterMark equals the datagram-buffer limit.  The spec sets the outgoing\ndatagrams writable up with the default highWaterMark (1) and enforces the\nlimit via writeDatagrams withholding the write promise, so desiredSize is 1.\nAssert that instead, and say so in datagrams-writable.https.any.js, which\nalready asserted 1.  Also require the incomingMaxBufferedDatagrams test to\nhave received at least one datagram, so an empty result cannot pass\nvacuously.\nhttps://w3c.github.io/webtransport/#writedatagrams\n\nThe outgoing test also checks that the write reaching the limit is withheld\nwhile those below it resolve.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313747\n", "files": ["testing/web-platform/meta/webtransport/datagrams.https.any.js.ini", "testing/web-platform/tests/webtransport/datagrams-writable.https.any.js", "testing/web-platform/tests/webtransport/datagrams.https.any.js"], "git_node": "47a2baa6b8bc8988742e88fe11f2032604d06f0e", "git_parents": ["c5756a9fb129ce547c1bdc9b657482a762bd580b"], "node": "cb0fdcb44503a50c0288accbe30e42b92f128306", "parents": ["2dbec81a3b4d67daaf0f842d3994bdbba14973cf"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023587: Drop the *MaxBufferedDatagrams idlharness FAIL expectations, r=jib\n\nThey are implemented by this point, so the expectations are stale.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331002\n", "files": ["testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini"], "git_node": "b7517184fcaaf8815e3bca1d181b415abb9976ee", "git_parents": ["47a2baa6b8bc8988742e88fe11f2032604d06f0e"], "node": "8ff64661f87977022a553a4059cc1c9eda419636", "parents": ["cb0fdcb44503a50c0288accbe30e42b92f128306"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078344: Handle RESET_STREAM and STOP_SENDING on a bidirectional WebTransport stream as a half-close in necko r=necko-reviewers,kershaw\n\nHttp3Session::ResetOrStopSendingRecvd tore down the whole stream for both. For bidirectional streams, RESET_STREAM\nnow closes only the receive side and STOP_SENDING only the send side; the stream goes away once both are done.\nneqo already resets the send half itself on STOP_SENDING.\n\nSTOP_SENDING closed both pipes of a bidirectional stream. Close only the output pipe and keep the map entry,\nsince the receive half is still live.\nClose only the input pipe on RESET_STREAM, and keep the map entry since the send half is still live.\n\nA peer's STOP_SENDING must not error the receive half of a bidirectional WebTransport stream\nA peer's RESET_STREAM must not close the send half of a bidirectional WebTransport stream\n\nAdd a gtest that the HTTP/2 backend keeps the send half writable after WT_RESET_STREAM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331013\n", "files": ["dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3WebTransportStream.cpp", "netwerk/protocol/http/Http3WebTransportStream.h", "netwerk/test/gtest/TestHttp2WebTransport.cpp", "testing/web-platform/meta/webtransport/streams-reset-bidi-keeps-writing.https.any.js.ini", "testing/web-platform/meta/webtransport/streams-stop-sending-bidi-keeps-reading.https.any.js.ini"], "git_node": "b4bc69ffcd7bef101cd12017323b998a97917b53", "git_parents": ["b7517184fcaaf8815e3bca1d181b415abb9976ee"], "node": "6c74ca8e998859bcd5ab4944cb7d4921c6059549", "parents": ["8ff64661f87977022a553a4059cc1c9eda419636"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083024. r=gfx-reviewers,bradwerth\" requested by tnikkel.\n\nThis reverts commit e0c6a0bc17e076e1b1bca3104001e1bb4fc4bdd8.\n", "files": ["dom/canvas/CanvasRenderingContextHelper.cpp"], "git_node": "9b6b030eb7c47bc1c4e5aa7a8d0081c37b251b64", "git_parents": ["b4bc69ffcd7bef101cd12017323b998a97917b53"], "node": "efa2a6841c72de727005b0e4a9b570e952c64975", "parents": ["6c74ca8e998859bcd5ab4944cb7d4921c6059549"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083237. Add more info to about support about display color management profile. r=gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334792\n", "files": ["gfx/qcms/qcms.h", "gfx/qcms/src/c_bindings.rs", "gfx/qcms/src/iccread.rs", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h"], "git_node": "4ca912077a5f35bb7ed9800c5b7275e9397fb189", "git_parents": ["9b6b030eb7c47bc1c4e5aa7a8d0081c37b251b64"], "node": "96eba4250cf593e6c6e82bf83090d2732161e725", "parents": ["efa2a6841c72de727005b0e4a9b570e952c64975"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083122 - Fix foreground and background fenix tests r=sparky,mstange\n\nThe Fenix resource usage tests were stuck on onboarding and never\nloaded a page. The launch now passes the performancetest extra to skip\nonboarding, and the toolbar selectors are updated for the Compose\ntoolbar, whose test tags replaced the old view ids. Before, missing\nelements meant taps at (0,0), so the measurements ran against the\nlauncher. The scripts now fail when an element can't be found.\n\nSince a page now loads, a utility process shows up and needs to be\nhandled when parsing the results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334697\n", "files": ["testing/performance/android-resource/main-background.sh", "testing/performance/android-resource/main-foreground.sh", "testing/performance/android-resource/parse_resource_usage.py", "testing/performance/android-resource/test-android-resource-usage.sh"], "git_node": "2cdf98ff6df19dae73566733c9cc35769816e91f", "git_parents": ["4ca912077a5f35bb7ed9800c5b7275e9397fb189"], "node": "c3028d4800f52d53c70e1e3d020431eb0f2a663b", "parents": ["96eba4250cf593e6c6e82bf83090d2732161e725"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070361 - When the deprecated flag is set in search-config-v3, skip including the engine in the user's list. r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334248\n", "files": ["toolkit/components/search/SearchService.sys.mjs", "toolkit/components/search/tests/xpcshell/test_appProvided_engine.js", "toolkit/components/search/tests/xpcshell/test_reload_engines.js"], "git_node": "d0e0fc69c10b345e8e1a83bae3d2da774970704d", "git_parents": ["2cdf98ff6df19dae73566733c9cc35769816e91f"], "node": "b30370631742599430d712ca66046dbda9be07bb", "parents": ["c30