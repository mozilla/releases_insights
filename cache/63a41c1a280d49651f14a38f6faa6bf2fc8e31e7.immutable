8a6d980ac1", "parents": ["a3eaee9645bcace796678d322eb39840085e82b9"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074902 - [devtools] Preserve quote used in original source when pretty printing r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331922\n", "files": ["devtools/client/debugger/dist/pretty-print-worker.js", "devtools/client/debugger/src/workers/pretty-print/pretty-fast.js", "devtools/client/debugger/src/workers/pretty-print/tests/__snapshots__/prettyFast.spec.js.snap", "devtools/client/debugger/src/workers/pretty-print/tests/prettyFast.spec.js", "devtools/client/debugger/test/mochitest/browser_dbg-pretty-print-inline-scripts.js", "devtools/client/debugger/test/mochitest/browser_dbg-pretty-print-paused-anonymous.js", "devtools/client/debugger/test/mochitest/browser_dbg-pretty-print.js", "devtools/client/debugger/test/mochitest/integration/browser_dbg-features-source-tree.js"], "git_node": "0c7aaecd80e6b33073a2b0aef7943021ac5f56b2", "git_parents": ["30a4f0a3a9a02ee9f8f9ae51dab7d12dfd46288c"], "node": "618f08d444a56202e7d684cdaecc4d4d9d01a957", "parents": ["5479f595e5425db92012db55e0cf2e8a6d980ac1"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075984 - Harden argument checks in the integer-GEMM column selection intrinsic. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331817\n", "files": ["js/src/intgemm/IntegerGemmIntrinsic.cpp", "js/src/jit-test/tests/wasm/builtin-modules/integer-gemm/I8SelectColumnsOfB.js"], "git_node": "d68a0b46f75791cf09d38ab014f30fdac69e981a", "git_parents": ["0c7aaecd80e6b33073a2b0aef7943021ac5f56b2"], "node": "7c161476f9d1e8a588e31f95014ae4965f24f46e", "parents": ["618f08d444a56202e7d684cdaecc4d4d9d01a957"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2079011 - Store constants directly in wasm baseline local.set, and zero locals from the zero register on arm64. r=yury\n\nlocal.set and local.tee of an i32 or i64 constant popped the constant into\na register and then stored the register, e.g. on arm64:\n\n  mov w0, #0\n  str w0, [sp, #0x7c]\n\nand on x86-64:\n\n  xorl %eax, %eax\n  movl %eax, 0x28(%rsp)\n\nStore the constant to the local directly instead, leaving it on the value\nstack for local.tee. arm64 stores a zero from wzr/xzr, and x86-64 stores\nan immediate.\n\nzeroLocals likewise loaded zero into a register before zeroing more than\none word of locals. On arm64, store from the zero register instead, which\nalso frees the register.\n\nOn one JetStream 3 run on arm64, baseline wasm code shrinks by 84,369\ninstructions (about 330 KB), and materialized zeros stored to memory drop\nfrom 132,545 to 52,227. On x86-64, with --wasm-compiler=baseline, constant\nstores to stack slots that went through a register drop from 128,591 to\n48,062, removing about 80,500 instructions. The code there grows by about\n67 KB, because a 32-bit immediate store is longer than xorl plus a\nregister store.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331467\n", "files": ["js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBCFrame.h", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "6b43a0466abe49830d0f35196d369b1a92722d81", "git_parents": ["d68a0b46f75791cf09d38ab014f30fdac69e981a"], "node": "65f491f21cd072567da6f3249ff9fda7e29cccad", "parents": ["7c161476f9d1e8a588e31f95014ae4965f24f46e"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078968 - Filter out dom.ipc.processLaunch.useMacPlists pref from diffoscope. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331838\n", "files": ["taskcluster/kinds/diffoscope/artifacts.yml"], "git_node": "0c6b8a42790fa003755ed884116fc843ff378352", "git_parents": ["6b43a0466abe49830d0f35196d369b1a92722d81"], "node": "41a14a8e495713847557ef40c30dd19472ce0b56", "parents": ["65f491f21cd072567da6f3249ff9fda7e29cccad"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078686 - Don't focus auto navigated tabs from cropped mini windows. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331445\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/test/browser/browser_cropped_navigation.js"], "git_node": "453e0b0b267be4ac90d24c9a17223465afa67c28", "git_parents": ["0c6b8a42790fa003755ed884116fc843ff378352"], "node": "63aa1e57f84db04995b86b6e60ccb0e9cc62b5fb", "parents": ["41a14a8e495713847557ef40c30dd19472ce0b56"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2079600 - Account for SQLite encryption on cache cleanup test r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331935\n", "files": ["dom/cache/test/marionette/test_caches_delete_cleanup_after_shutdown.py"], "git_node": "bd4986faf666af2e11279fdc3893e189206f5a87", "git_parents": ["453e0b0b267be4ac90d24c9a17223465afa67c28"], "node": "19f2741a1c63e3a5a6efeb35f51427d970f55bc8", "parents": ["63aa1e57f84db04995b86b6e60ccb0e9cc62b5fb"], "tags": []}, {"author": "Fabrice Armisen \u003cfarmisen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075012 - Remove the general.config.vendor check from AutoConfig. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328689\n", "files": ["extensions/pref/autoconfig/src/nsReadConfig.cpp", "extensions/pref/autoconfig/test/marionette/autoconfig.js", "extensions/pref/autoconfig/test/unit/autoconfig-admin-pref.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-no-sandbox.js", "extensions/pref/autoconfig/test/unit/autoconfig.js", "extensions/pref/autoconfig/test/unit/autoconfig_snap.js", "extensions/pref/autoconfig/test/unit/autoconfig_sysconfd.js", "extensions/pref/autoconfig/test/unit/test_autoconfig_profile_prefs.js"], "git_node": "f01b28fbce2875894f853eac59b322b3a1c65e52", "git_parents": ["bd4986faf666af2e11279fdc3893e189206f5a87"], "node": "6fd51d9b1521fa17e4e6703949945d25eec4dbf7", "parents": ["19f2741a1c63e3a5a6efeb35f51427d970f55bc8"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078609 - Support top-level imported calls in perfdocs r=sparky,mozperftest-reviewers\n\nThis commit lets perfdocs extract metadata from tests that initialize\nimported utilities at the top level scope.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331681\n", "files": ["python/mozperftest/mozperftest/script.py", "python/mozperftest/mozperftest/tests/test_script.py"], "git_node": "5eb950495252d2a02a039337286703c57dfbeb15", "git_parents": ["f01b28fbce2875894f853eac59b322b3a1c65e52"], "node": "830d8fc22b63a3841ec4c8eec95ae94733a5f40a", "parents": ["6fd51d9b1521fa17e4e6703949945d25eec4dbf7"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079565: Don't reuse a shut down window accessible on macOS. r=eeejay\n\nnsCocoaWindow caches its window accessible in a weak pointer. When the window's document is replaced, as when a new window loads browser.xhtml over its initial about:blank, the old document accessible is shut down but can stay alive for several seconds, and the cache kept returning it. Since bug 1997441 a window is only an accessibility element while that accessible has a native object, so a window shown in this state, such as a tab torn off into a new window, posted no AXCreated or AXFocusedWindowChanged notification.\n\nLook the accessible up again once the cached one has no document, and check the root accessible for null before using it for a popup panel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332048\n", "files": ["accessible/tests/browser/mac/browser_app.js", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "c461a7deff3a334179126197e5ca55a0761c058a", "git_parents": ["5eb950495252d2a02a039337286703c57dfbeb15"], "node": "2e8b2213c161cee2b8a5c650d9b36a9d56fabe32", "parents": ["830d8fc22b63a3841ec4c8eec95ae94733a5f40a"], "tags": []}, {"author": "Arne Fucks \u003cafucks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067020 - Make DoH URL and DoH mode in about:networking more intuitive r=valentin\n\nThe DoH URL is now only shown when DoH is enabled and the DoH mode now\ndisplays user readable states instead of numbers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332023\n", "files": ["toolkit/content/aboutNetworking.js"], "git_node": "2a6928bcf7a197b4a4fa6ef2774bf8a7b1183067", "git_parents": ["c461a7deff3a334179126197e5ca55a0761c058a"], "node": "9b374d957319a7dd86a113af35cc325a636e4fc3", "parents": ["2e8b2213c161cee2b8a5c650d9b36a9d56fabe32"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079686 - Unconstrained flexbox reflow should not push items to a next-in-flow. r=layout-reviewers,emilio\n\n(This is the clauditor-suggested patch, which AFAICS in local testing resolves\nthe issue here.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332067\n", "files": ["layout/generic/nsFlexContainerFrame.cpp"], "git_node": "7ae94165b77c5d4212eaf1eabfef39095bf085e2", "git_parents": ["2a6928bcf7a197b4a4fa6ef2774bf8a7b1183067"], "node": "46dcd87cf16f8497c765d7757d553f435c6eb5bd", "parents": ["9b374d957319a7dd86a113af35cc325a636e4fc3"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2075677 - Fix racy code by collecting Android resource CPU info with a single ps call for multiple pids. r=perftest-reviewers,aglavic\n\nThe per-PID ps calls ran concurrently and appended to the same file,\nso their output could interleave and split a line, which broke parse_resource_usage.py.\n\n`adb ps` can handle a comma-separated list of pids, so this fix changes\n`collect_cpu_at` to build such a comma-separated list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329268\n", "files": ["testing/performance/android-resource/collect-proc-info-cpu.sh"], "git_node": "b0f98422f26679f0ed9697e966f29cd3ae8fccf2", "git_parents": ["7ae94165b77c5d4212eaf1eabfef39095bf085e2"], "node": "f76778c126aed40ea8389f6437070e5784dac773", "parents": ["46dcd87cf16f8497c765d7757d553f435c6eb5bd"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Record the name of sampled processes whose command line can't be read. r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330466\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py"], "git_node": "aaa759246592ac9835246635732d19454eb7617c", "git_parents": ["b0f98422f26679f0ed9697e966f29cd3ae8fccf2"], "node": "3ae58ed2e07f2347200f4a6335717ddf401e452c", "parents": ["f76778c126aed40ea8389f6437070e5784dac773"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Don't share the default metadata dict between SystemResourceMonitor instances. r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330467\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py"], "git_node": "be53e89bb7c138dc2a3bb3e3af9c81c0f80f82c3", "git_parents": ["aaa759246592ac9835246635732d19454eb7617c"], "node": "950c8485d0e5ed80bf86340f173aff0a96c6376b", "parents": ["3ae58ed2e07f2347200f4a6335717ddf401e452c"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002385 - Add a cold search widget startup test. ?#perftest-reviewers r=perftest-reviewers,mozperftest-reviewers,sparky\n\nAdds cold_search_widget_first_frame to android_startup_cmff_cvns.py along with a\nsearch-widget.sh wrapper, and schedules it for fenix and chrome-m on a55, p6 and\ns24.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325469\n", "files": ["taskcluster/kinds/perftest/android.yml", "testing/performance/mobile-startup/android_startup_cmff_cvns.py", "testing/performance/mobile-startup/search-widget.sh"], "git_node": "125d7bef27bb96dfe55e80e5e567e1e38ea065ce", "git_parents": ["be53e89bb7c138dc2a3bb3e3af9c81c0f80f82c3"], "node": "fd769fe17d2e01c92878c901a577428a3253f9b0", "parents": ["950c8485d0e5ed80bf86340f173aff0a96c6376b"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056293 - Forward aria-label to reorderable moz-box-group listboxes. r=reusable-components-reviewers,mstriemer\n\n`moz-box-group` renders reorderable lists as listboxes. Map the host's\n`aria-label` to the inner list so the listbox, not its generic host,\nreceives the accessible name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328296\n", "files": ["toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_moz_box_group.html", "toolkit/content/widgets/moz-box-group/moz-box-group.mjs"], "git_node": "2de6829a6865bd8f8f6287f92bb38378786fb91c", "git_parents": ["125d7bef27bb96dfe55e80e5e567e1e38ea065ce"], "node": "0dfcdd87ae85d726fa443fecca98ce96a19f74b7", "parents": ["fd769fe17d2e01c92878c901a577428a3253f9b0"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077913 - Integrate search terms with addressbar focus mode r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331920\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/BrowserStoreToFenixSearchMapperMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/FenixSearchMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/SearchFragmentStore.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/BrowserStoreToFenixSearchMapperMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/SearchFragmentStoreTest.kt"], "git_node": "baeba2a8f88ccae434c965df7d8cb2bb6e607f2e", "git_parents": ["2de6829a6865bd8f8f6287f92bb38378786fb91c"], "node": "8f6ed2474abd0383335dd95dd8418e771f07acfd", "parents": ["0dfcdd87ae85d726fa443fecca98ce96a19f74b7"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Use isDefaultBrowserAsync() in AboutWelcomeParent; r=omc-reviewers,mviar\n\nUse the asynchronous default-browser check when determining whether About\nWelcome needs to set Firefox as the default browser.\n\nUpdate the related About Welcome targeting tests to stub the asynchronous API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330098\n", "files": ["browser/components/aboutwelcome/actors/AboutWelcomeParent.sys.mjs", "browser/components/aboutwelcome/tests/unit/unit-entry.js"], "git_node": "3cd4d8fea874a7ac4b9b1e15634ddca38f605303", "git_parents": ["baeba2a8f88ccae434c965df7d8cb2bb6e607f2e"], "node": "0d4aae90b0ecbc08cf3a3371d347632590bb1708", "parents": ["8f6ed2474abd0383335dd95dd8418e771f07acfd"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078236 - The VPN panel is not dismissed after clicking the Learn more link in the local region error view - r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331738\n", "files": ["browser/components/ipprotection/content/ipprotection-status-box.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_box.js"], "git_node": "776ab119f37489d415dd848ec84e1808398e4a2b", "git_parents": ["3cd4d8fea874a7ac4b9b1e15634ddca38f605303"], "node": "16b3bc28521d88c20ffd285d465210e4bd934c9b", "parents": ["0d4aae90b0ecbc08cf3a3371d347632590bb1708"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079182 - [devtools] Only show the slow script debug button if devtools are open r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331807\n", "files": ["browser/modules/ProcessHangMonitor.sys.mjs", "browser/modules/test/browser/browser_ProcessHangNotifications.js", "devtools/client/debugger/test/mochitest/browser_dbg-slow-script.js"], "git_node": "f61cbd5362ce9c3d92dbed58674e38252ccf0855", "git_parents": ["776ab119f37489d415dd848ec84e1808398e4a2b"], "node": "b6c1bec2855b2d1befa28652addd7b43e303feed", "parents": ["16b3bc28521d88c20ffd285d465210e4bd934c9b"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078192 - Focus ring around Settings button is clipped during keyboard navigation when in paused or error state - r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331424\n", "files": ["browser/components/ipprotection/content/ipprotection-content.css", "browser/components/ipprotection/content/ipprotection-content.mjs"], "git_node": "70818f1412398711f97c1a4ed918e4224bb09573", "git_parents": ["f61cbd5362ce9c3d92dbed58674e38252ccf0855"], "node": "f79bda3902c401e4d431bafc187bbdba78a77dc0", "parents": ["b6c1bec2855b2d1befa28652addd7b43e303feed"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079631 - [devtools] Remove backward compatibility code for version 157 r=devtools-reviewers,bomsy\n\nRemove the `@backward-compat { version 157 }` code in devtools:\n- Drop the `supportsGridGetFragments` root actor trait.\n- Remove the `GridFront.getFragments()` override that fell back to `form.gridFragments` for older servers; the spec-generated method is now used directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331933\n", "files": ["devtools/client/fronts/layout.js", "devtools/server/actors/root.js"], "git_node": "52388f8fed0c85552baef93af2c5b72cd6d42a3a", "git_parents": ["70818f1412398711f97c1a4ed918e4224bb09573"], "node": "f235bd5477237f45f55478356a26b70cf8dd372b", "parents": ["f79bda3902c401e4d431bafc187bbdba78a77dc0"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2078394 - Saturate SnappyFrameUtils::MaxCompressedBufferLength instead of wrapping (Coverity CID 1701845) r=xpcom-reviewers,mccr8\n\nSince snappy 1.3.0, snappy::MaxCompressedLength returns SIZE_MAX for inputs that are too large, and adding the frame overhead to it wraps around. Current callers pass at most one snappy block, so this is not reachable today.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330907\n", "files": ["xpcom/io/SnappyFrameUtils.cpp"], "git_node": "c8b4e767350fbea47f3088f6a46306795a4424b2", "git_parents": ["52388f8fed0c85552baef93af2c5b72cd6d42a3a"], "node": "c1c098049dd0844e6977d2e7fd897dceee42e788", "parents": ["f235bd5477237f45f55478356a26b70cf8dd372b"], "tags": []}, {"author": "Danny Colin \u003ccontact@dannycolin.com\u003e", "branch": "default", "desc": "Bug 2071844 - Hide Open in Container Tab context menu item if Containers are disabled r=sidebar-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326284\n", "files": ["browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/tests/browser/browser_history_sidebar.js"], "git_node": "53e1d899cd7a19ed9b72069a4a48e2b45ba81a52", "git_parents": ["c8b4e767350fbea47f3088f6a46306795a4424b2"], "node": "5158afcddb5e5217559add8b47be08cb327f70e7", "parents": ["c1c098049dd0844e6977d2e7fd897dceee42e788"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077059 - Pin pip installs to the package versions the site interpreter imports r=firefox-build-system-reviewers,sergesanspaille\n\n`uv pip list` does not read `.pth` files, so vendored packages never\nreached the constraints file and pip installed newer copies beside them.\nThe constraints now come from `importlib.metadata` in the site\ninterpreter. A site's own `pypi:` pins are left out of the constraints\nso they still win.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330129\n", "files": ["python/mach/mach/site.py", "python/mach/mach/test/test_site.py"], "git_node": "b15dd6fed1625dc1de40a3cc09cbd94cf8201046", "git_parents": ["53e1d899cd7a19ed9b72069a4a48e2b45ba81a52"], "node": "bed3fb0551f9b2af52d579ec54ce1cb3132ea86a", "parents": ["5158afcddb5e5217559add8b47be08cb327f70e7"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077059 - Rebuild virtualenvs when the mach site code or `uv.lock` changes r=firefox-build-system-reviewers,sergesanspaille\n\nOtherwise a virtualenv built with the wrong package versions is kept\nuntil an unrelated site file changes. `uv.lock` covers vendored package\nupdates, which leave the pthfile unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330435\n", "files": ["python/mach/mach/site.py", "python/mach/mach/test/test_site.py"], "git_node": "f4d5bfc730e504eeb9a2ab87846f586082adafb1", "git_parents": ["b15dd6fed1625dc1de40a3cc09cbd94cf8201046"], "node": "dfd81e18f5c1b0560fbdefa417c61b1670abfc13", "parents": ["bed3fb0551f9b2af52d579ec54ce1cb3132ea86a"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2078662 - Implement Mozilla Headline font from Remote settings, misc styling cleanups, small directory restructure, and fix for favicons - r=omarg,mzhang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33