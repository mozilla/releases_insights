adenot,gstoll\n\nThis requires a few changes:\n- Add missing headers to make headers analyzable\n- Move some definition to source file to make associated headers analyzable. This sometimes\n  require to create and register that source file.\n- Apply https://clang.llvm.org/extra/clang-tidy/checks/modernize/type-traits.html\n- Apply https://clang.llvm.org/extra/clang-tidy/checks/modernize/use-equals-default.html\n- Apply https://clang.llvm.org/extra/clang-tidy/checks/modernize/use-equals-delete.html\n- Apply https://clang.llvm.org/extra/clang-tidy/checks/modernize/use-nullptr.html, which results in calling the default constructor TimeDuration()\n- Ignore a few headers not meant to be use in standalone-mode\n\nAs a side effect remove dom/media/webrtc/common/NullTransport.h that's\nnever referenced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330535\n", "files": ["dom/base/moz.build", "dom/battery/moz.build", "dom/bindings/moz.build", "dom/bindings/test/moz.build", "dom/broadcastchannel/moz.build", "dom/cache/moz.build", "dom/canvas/DrawTargetWebglInternal.h", "dom/canvas/SourceSurfaceWebgl.cpp", "dom/canvas/SourceSurfaceWebgl.h", "dom/canvas/WebGLQueueParamTraits.h", "dom/canvas/WebGLVertexArray.cpp", "dom/canvas/WebGLVertexArray.h", "dom/canvas/moz.build", "dom/clients/api/moz.build", "dom/clients/manager/moz.build", "dom/compression/moz.build", "dom/console/moz.build", "dom/cookiestore/moz.build", "dom/events/moz.build", "dom/fetch/moz.build", "dom/file/moz.build", "dom/filesystem/compat/moz.build", "dom/filesystem/moz.build", "dom/fs/child/FileSystemEntryMetadataArray.cpp", "dom/fs/child/FileSystemEntryMetadataArray.h", "dom/fs/child/moz.build", "dom/fs/parent/datamodel/moz.build", "dom/fs/parent/moz.build", "dom/fs/test/gtest/moz.build", "dom/fs/test/gtest/parent/moz.build", "dom/geolocation/moz.build", "dom/html/HTMLFormSubmissionConstants.h", "dom/html/moz.build", "dom/indexedDB/moz.build", "dom/ipc/ColorPickerParent.cpp", "dom/ipc/ColorPickerParent.h", "dom/ipc/jsactor/moz.build", "dom/ipc/moz.build", "dom/localstorage/moz.build", "dom/media/FileMediaResource.cpp", "dom/media/FileMediaResource.h", "dom/media/MediaBlockCacheBase.h", "dom/media/MediaChannelStatistics.h", "dom/media/doctor/moz.build", "dom/media/driftcontrol/moz.build", "dom/media/encoder/moz.build", "dom/media/fake-cdm/cdm-test-output-protection.h", "dom/media/fake-cdm/moz.build", "dom/media/gmp/moz.build", "dom/media/gtest/moz.build", "dom/media/imagecapture/moz.build", "dom/media/ipc/moz.build", "dom/media/mediacapabilities/moz.build", "dom/media/mediacontrol/moz.build", "dom/media/mediacontrol/tests/gtest/moz.build", "dom/media/mediasink/AudioSinkWrapper.cpp", "dom/media/mediasink/AudioSinkWrapper.h", "dom/media/mediasink/moz.build", "dom/media/mediasource/moz.build", "dom/media/moz.build", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.h", "dom/media/platforms/ffmpeg/moz.build", "dom/media/platforms/omx/OmxPromiseLayer.cpp", "dom/media/platforms/omx/OmxPromiseLayer.h", "dom/media/platforms/omx/PureOmxPlatformLayer.h", "dom/media/platforms/omx/moz.build", "dom/media/platforms/wmf/moz.build", "dom/media/systemservices/moz.build", "dom/media/webaudio/PanningUtils.h", "dom/media/webaudio/PlayingRefChangeHandler.cpp", "dom/media/webaudio/PlayingRefChangeHandler.h", "dom/media/webaudio/ReportDecodeResultTask.h", "dom/media/webaudio/blink/moz.build", "dom/media/webaudio/moz.build", "dom/media/webcodecs/moz.build", "dom/media/webm/moz.build", "dom/media/webrtc/common/NullTransport.h", "dom/media/webrtc/common/Wrapper.h", "dom/media/webrtc/common/moz.build", "dom/media/webrtc/jsapi/moz.build", "dom/media/webrtc/jsep/JsepCodecDescription.h", "dom/media/webrtc/jsep/JsepSession.h", "dom/media/webrtc/jsep/JsepTransport.h", "dom/media/webrtc/jsep/moz.build", "dom/media/webrtc/libwebrtcglue/moz.build", "dom/media/webrtc/moz.build", "dom/media/webrtc/sdp/SdpAttributeList.h", "dom/media/webrtc/sdp/moz.build", "dom/media/webrtc/transport/ipc/moz.