lkit/components/search/SearchEngineSelector.sys.mjs", "toolkit/components/search/SearchService.sys.mjs", "toolkit/components/search/SearchSettings.sys.mjs", "toolkit/components/search/SearchSuggestionController.sys.mjs", "toolkit/components/search/SearchUtils.sys.mjs", "toolkit/components/translations/TranslationsTelemetry.sys.mjs", "toolkit/components/translations/content/translations-document.sys.mjs", "toolkit/modules/E10SUtils.sys.mjs", "toolkit/modules/PrefUtils.sys.mjs", "toolkit/modules/Region.sys.mjs", "toolkit/modules/Sqlite.sys.mjs", "toolkit/mozapps/defaultagent/DefaultAgentScheduler.sys.mjs", "toolkit/mozapps/extensions/AddonManager.sys.mjs", "toolkit/mozapps/pushnotificationhelper/PushNotificationHelperRegistry.sys.mjs", "toolkit/mozapps/pushnotificationhelper/WindowsPushNotificationHelper.sys.mjs"], "git_node": "ffda7fae91ec83c66a8e298e3f615084281c2ff7", "git_parents": ["297bddde6be441ab81de9d69a4b4dc68ece90ab1"], "node": "e767daa524288646238f7578491855ed44b3f9f5", "parents": ["a039c54ab5c6c051667aa3c15e7c3af99b48b113"], "tags": []}, {"author": "Brad Frost \u003cbfrost@squarespace.com\u003e", "branch": "default", "desc": "Bug 2005072 - Implement proposed loading attribute for video and audio elements. r=dom-core-reviewers,media-playback-reviewers,webidl,layout-reviewers,smaug,emilio,pehrsons,alwu,jjaschke\n\nAdd support for the `loading` attribute on \u003cvideo\u003e and \u003caudio\u003e\nelements, mirroring the existing behavior for \u003cimg\u003e and \u003ciframe\u003e. The\nattribute accepts `eager` (default) and `lazy`. When `loading=\"lazy\"`\nis set, loading of the media resource and poster image, as well as\nautoplay, is deferred via an intersection observer until the element is\nnear the viewport. Gated behind the media.lazy_loading.enabled pref.\n\nSpec: https://html.spec.whatwg.org/multipage/media.html#attr-media-loading\nSpec PR: https://github.com/whatwg/html/pull/11980\n\nCo-authored-by: Scott Jehl \u003csjehl@squarespace.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278547\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h", "dom/webidl/HTMLMediaElement.webidl", "layout/generic/nsVideoFrame.cpp", "layout/generic/nsVideoFrame.h", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5TreeBuilderCppSupplement.h", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/__dir__.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-autoplay-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-autoplay-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-disconnected.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-not-rendered.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-source-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-to-eager.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-lazy-window-onload.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-load-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-load-preload-auto-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-audio-element/audio-loading-load-preload-metadata-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/__dir__.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-autoplay-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-autoplay-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-disconnected.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-load-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-not-rendered.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-poster-when-visible.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-source-poster-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-to-eager.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-lazy-window-onload.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-load-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-load-preload-auto-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-load-preload-metadata-deferred.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-video-element/video-loading-poster-deferred.html.ini"], "git_node": "146655b7da2d93ebdb5a5b1b36e0ba40ba5ccbcb", "git_parents": ["ffda7fae91ec83c66a8e298e3f615084281c2ff7"], "node": "a45c639e32bf0476b658e8aa537c5efa84f533ba", "parents": ["e767daa524288646238f7578491855ed44b3f9f5"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2068049 - Increase tolerance to 20ms for toolkit/profile/test/xpcshell/test_create_default.js. r=mossop DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333245\n", "files": ["toolkit/profile/test/xpcshell/test_create_default.js"], "git_node": "de1c28716f73a11884961ee23c97be8dab22e02b", "git_parents": ["146655b7da2d93ebdb5a5b1b36e0ba40ba5ccbcb"], "node": "09c5ee74b44c5db05cb5eeaba71caa396fdf5fc4", "parents": ["a45c639e32bf0476b658e8aa537c5efa84f533ba"], "tags": []}, {"author": "Luk\u00e1\u0161 Lipinsk\u00fd \u003c6032558+Mr-Tao@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075482 - Reattach YouTube PiP captions within their player after playlist navigation. r=mconley\n\nKeep caption lookup and replacement observation scoped to the video's movie or Shorts player. Clear captions without creating observers when the video has no parent. Complete fake playback-rate methods and exercise regular/Shorts replacement with a second caption container present.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329579\n", "files": ["browser/extensions/pictureinpicture/tests/browser/browser.toml", "browser/extensions/pictureinpicture/tests/browser/browser_youtube_wrapper_captions.js", "browser/extensions/pictureinpicture/tests/browser/test-youtube-caption-container.html", "browser/extensions/pictureinpicture/video-wrappers/youtube.js"], "git_node": "96d8de97255618609078905db9d2a1c31277ace6", "git_parents": ["de1c28716f73a11884961ee23c97be8dab22e02b"], "node": "5df399e33de9a1ddfc7878c6d34a272a01396c9a", "parents": ["09c5ee74b44c5db05cb5eeaba71caa396fdf5fc4"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079424 - Run the SystemClockDriver thread at real-time priority on macOS. r=media-playback-reviewers,padenot\n\nOn macOS, a timed wait on a condition variable can be coalesced well beyond\nits deadline when the process is otherwise idle. The graph driver then falls\nmore than its bankruptcy threshold behind and drops media time, so a\nMediaStream's currentTime runs slow. Real-time threads are exempt from this\ncoalescing, and GraphRunner already promotes its thread the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332130\n", "files": ["dom/media/GraphDriver.cpp", "dom/media/GraphDriver.h"], "git_node": "3b60db2171c783ce0b0dbc61dff76df490c7ff92", "git_parents": ["96d8de97255618609078905db9d2a1c31277ace6"], "node": "11a7b1ac0c5331dd12604b187873b75666b67676", "parents": ["5df399e33de9a1ddfc7878c6d34a272a01396c9a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071613 - Fix the stale tool names in the devtools MCP docs. r=ai4dev-reviewers,padenot DONTBUILD\n\nThe names the docs used no longer resolve, so an agent following them calls tools that do not exist.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326227\n", "files": ["docs/ai-agent-tools/firefox-devtools-mcp.md"], "git_node": "3410578313887e90fa8c2ad96b04ff8a88dd1f45", "git_parents": ["3b60db2171c783ce0b0dbc61dff76df490c7ff92"], "node": "db102a31e21c1bdd73b74f03605c3d976bed18c7", "parents": ["11a7b1ac0c5331dd12604b187873b75666b67676"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1876516 - Change ConsoleLogLevel and maxLogLevel strings from PascalCase to camelCase r=firefox-desktop-core-reviewers ,dom-core-reviewers,devtools-reviewers,joschmidt,geckoview-reviewers,credential-management-reviewers,search-reviewers,tabbrowser-reviewers,places-reviewers,omc-reviewers,jteow,niklas,fchasen,yjamora,jjaschke,nalexander,translations-reviewers,nchevobbe,mossop,emcminn\" for causing mozlint failure @ InteractionsBlocklist\n\nThis reverts commit ffda7fae91ec83c66a8e298e3f615084281c2ff7.\n", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AIWindowAccountAuth.sys.mjs", "browser/components/asrouter/modules/ToastNotification.sys.mjs", "browser/components/backup/ArchiveEncryptionState.sys.mjs", "browser/components/backup/BackupService.sys.mjs",