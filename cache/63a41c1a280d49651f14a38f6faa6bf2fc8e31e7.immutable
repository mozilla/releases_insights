s", "browser/components/sidebar/tests/browser/browser_resize_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/components/sidebar/tests/browser/browser_sidebar_escape_collapse.js", "browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/browser/browser_toolbar_sidebar_button.js", "browser/components/sidebar/tests/browser/browser_tools_overflow.js", "browser/components/sidebar/tests/browser/legacy/browser_sidebar_keys.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/content/tests/browser/browser_bug1693577.js"], "git_node": "2be58b4cc0b99cc54cd3d2bb4525e5ccc742e666", "git_parents": ["00955cfcc26943d7791e7f7e42b97115d97fd75a"], "node": "6baa94653b2bbfeb3df15f67414ed49f880980d0", "parents": ["ba38c3c72ea30f4d36f36d8247863d04ae6510f1"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 1822968 - Match downloaded filenames structure to Desktop r=geckoview-reviewers,android-reviewers,tthibaud,owlish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312566\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/components/geckoview/GeckoViewExternalAppService.cpp", "mobile/android/components/geckoview/GeckoViewStreamListener.cpp", "mobile/android/components/geckoview/GeckoViewStreamListener.h", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "98bdeb951abecff24cd918ce8c98b1d3d4b6da4e", "git_parents": ["2be58b4cc0b99cc54cd3d2bb4525e5ccc742e666"], "node": "226cb09a5434195f211501477c103a5844505365", "parents": ["6baa94653b2bbfeb3df15f67414ed49f880980d0"], "tags": []}, {"author": "Danny Chen \u003cdchen705@gmail.com\u003e", "branch": "default", "desc": "Bug 1877223 - Emit warning when sendResponse is called by an async listener of runtime.OnMessage. r=robwu\n\nListener functions on browser.runtime.onMessage.addListener() support two mutually exclusive ways of sending a response asynchronously. If a listener is mistakenly declared async and sends sendResponse(), the value passed to sendResponse() is silently discarded. The caller instead receives the resolving value of the promise that's returned by the async listener. This is frustrating for extension developers who receive no explicit indication of why sendResponse fails.\n\nwrapResponse() in ExtensionChild.sys.mjs now logs a console warning whenever a call to sendResponse is discarded. Within wrapResponse(), two different checks to determine whether to log the warning are needed due to two different scenarios in which sendResponse can be invoked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324156\n", "files": ["toolkit/components/extensions/ExtensionChild.sys.mjs", "toolkit/components/extensions/ExtensionCommon.sys.mjs", "toolkit/components/extensions/test/mochitest/mochitest-common.toml", "toolkit/components/extensions/test/mochitest/test_ext_runtime_sendMessage_response_warning.html", "toolkit/components/extensions/test/xpcshell/test_ext_runtime_sendMessage_response_warning.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml"], "git_node": "f4731deb14a9c5993461c1a1d1277d825fbb6bc7", "git_parents": ["98bdeb951abecff24cd918ce8c98b1d3d4b6da4e"], "node": "ef32a66b043228daa8a5d53b0336e87b7c318e10", "parents": ["226cb09a5434195f211501477c103a5844505365"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079177 - Type-check the source option reads in SessionStore's #resolveClosedDataSource. r=sessionstore-reviewers,nsharpley\n\nBehavior-neutral. nsIDOMWindow is an empty interface, so tsc can't tell that aSource isn't a Window in those branches. The reads only passed because Window has an index signature that lets any property through.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331533\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": "21e6e5acdf78f68be8c89116f175c7fb4e2f0248", "git_parents": ["f4731deb14a9c5993461c1a1d1277d825fbb6bc7"], "node": "5e85f832efbbc08633d0828355b75a9a69a10f45", "parents": ["ef32a66b043228daa8a5d53b0336e87b7c318e10"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079670 - Move browser_TabUnloader.js and browser_preloading_tab_moving.js to the tabbrowser tests. r=tabbrowser-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331953\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_TabUnloader.js", "browser/components/tabbrowser/test/browser/tabs/browser_preloading_tab_moving.js", "browser/components/tabbrowser/test/browser/tabs/file_webrtc.html", "browser/modules/test/browser/browser.toml", "browser/modules/test/browser/browser_TabUnloader.js", "browser/modules/test/browser/browser_preloading_tab_moving.js", "browser/modules/test/browser/file_webrtc.html"], "git_node": "5f9012a33212437c8e414d335f7d83530e00c383", "git_parents": ["21e6e5acdf78f68be8c89116f175c7fb4e2f0248"], "node": "07bfa753a75719d0b76e26c96e7e887db154acff", "parents": ["5e85f832efbbc08633d0828355b75a9a69a10f45"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079201 - Convert TabAttributes to a class. r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331568\n", "files": ["browser/components/sessionstore/TabAttributes.sys.mjs"], "git_node": "48517e0d6b8b9122bc456d7382da5d031a6b0ab2", "git_parents": ["5f9012a33212437c8e414d335f7d83530e00c383"], "node": "60cc992ea8092e5142b249816f5d1b11d7a62bbf", "parents": ["07bfa753a75719d0b76e26c96e7e887db154acff"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079201 - Convert TabStateCache to a class. r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331570\n", "files": ["browser/components/sessionstore/TabStateCache.sys.mjs"], "git_node": "dfdecbdb26995a934328698186ccefad22137750", "git_parents": ["48517e0d6b8b9122bc456d7382da5d031a6b0ab2"], "node": "344881034e5f3bf726b7eebeaa7a5defbb713640", "parents": ["60cc992ea8092e5142b249816f5d1b11d7a62bbf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079201 - Convert TabStateFlusher to a class. r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331571\n", "files": ["browser/components/sessionstore/TabStateFlusher.sys.mjs"], "git_node": "0e5c405217725608632c0abb8cd779264d1f73d8", "git_parents": ["dfdecbdb26995a934328698186ccefad22137750"], "node": "ea78235f7d2529ac21c748b50bf84b3d093f9386", "parents": ["344881034e5f3bf726b7eebeaa7a5defbb713640"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079201 - Convert SessionMigration to a class. r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331572\n", "files": ["browser/components/sessionstore/SessionMigration.sys.mjs"], "git_node": "5dc83366ec61a3e76d087f487f9fcf254863a6d9", "git_parents": ["0e5c405217725608632c0abb8cd779264d1f73d8"], "node": "0f1f5c093e000612d62d5579f913f72278985153", "parents": ["ea78235f7d2529ac21c748b50bf84b3d093f9386"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079201 - Convert SessionCookies to a class. r=sessionstore-reviewers,sfoster\n\nThe exported instance now registers itself as the session-cookie-changed observer, so observe() is public on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331573\n", "files": ["browser/components/sessionstore/SessionCookies.sys.mjs"], "git_node": "f0ed3d60937ba5af75d63736f3bc717f1817b3d5", "git_parents": ["5dc83366ec61a3e76d087f487f9fcf254863a6d9"], "node": "0eef54f9c69122a6fa6774a72677fa445fdae1db", "parents": ["0f1f5c093e000612d62d5579f913f72278985153"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079201 - Convert SessionSaver to a class. r=sessionstore-reviewers,sfoster\n\nThe three lazy pref getters move into declareLazy, and the idle observer is registered from the constructor; both still register when the module loads, in the same order. The exported instance is the idle observer, so observe() is public on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331574\n", "files": ["browser/components/sessionstore/SessionSaver.sys.mjs"], "git_node": "fcea6883d3c7e08201a03931ec0f36702c9aeda6", "git_parents": ["f0ed3d60937ba5af75d63736f3bc717f1817b3d5"], "node": "04d1e54579d1340ce0344a95b80156d67e05790f", "parents": ["0eef54f9c69122a6fa6774a72677fa445fdae1db"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079201 - Convert SessionFile to a class. r=sessionstore-reviewers,sfoster\n\nlatestUpgradeBackupID becomes a module-level function because the getters on Paths read it with Paths as their receiver.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331575\n", "files": ["browser/components/sessionstore/SessionFile.sys.mjs"], "git_node": "b50da64668342a6d40cc6f197fef7087de0a5add", "git_parents": ["