/db/LoginExceptionDao.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/dialog/SaveLoginDialogFragment.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/login/LoginExceptions.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/exceptions/login/LoginExceptionsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/exceptions/login/LoginExceptionsInteractor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/exceptions/login/LoginExceptionsInteractorTest.kt"], "git_node": "06d315c375680525c457f456ff033665b8052b19", "git_parents": ["1eb422761fbdd41907df529e26bfab30e3c4b7ed"], "node": "aa448116f4ad71c15079128fe0f66de5047263c1", "parents": ["3eca31953c09ba4be6ca3a5071bf87c98d94a4bc"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070820 - Site Permissions: Refactor SitePermissionsDao to use suspend methods r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329893\n", "files": ["mobile/android/android-components/components/feature/sitepermissions/src/androidTest/java/mozilla/components/feature/sitepermissions/db/OnDeviceSitePermissionsStorageTest.kt", "mobile/android/android-components/components/feature/sitepermissions/src/androidTest/java/mozilla/components/feature/sitepermissions/db/SitePermissionsDaoTest.kt", "mobile/android/android-components/components/feature/sitepermissions/src/main/java/mozilla/components/feature/sitepermissions/OnDiskSitePermissionsStorage.kt", "mobile/android/android-components/components/feature/sitepermissions/src/main/java/mozilla/components/feature/sitepermissions/SitePermissionsFeature.kt", "mobile/android/android-components/components/feature/sitepermissions/src/main/java/mozilla/components/feature/sitepermissions/db/SitePermissionsDao.kt", "mobile/android/android-components/components/feature/sitepermissions/src/test/java/mozilla/components/feature/sitepermissions/OnDiskSitePermissionsStorageTest.kt", "mobile/android/android-components/components/feature/sitepermissions/src/test/java/mozilla/components/feature/sitepermissions/SitePermissionsFeatureTest.kt", "mobile/android/android-components/components/feature/sitepermissions/src/test/java/mozilla/components/feature/sitepermissions/SitePermissionsRulesTest.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/BaseBrowserFragment.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/DefaultComponents.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt"], "git_node": "caa2e05a1f294328010a679e6d44b45c7dffe470", "git_parents": ["06d315c375680525c457f456ff033665b8052b19"], "node": "0c89e8a35a5a5e22376253e63c54500702fe8ecd", "parents": ["aa448116f4ad71c15079128fe0f66de5047263c1"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070820 - PWA Manifest: Refactor ManifestDao to use suspend methods r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329895\n", "files": ["mobile/android/android-components/components/feature/pwa/src/main/java/mozilla/components/feature/pwa/ManifestStorage.kt", "mobile/android/android-components/components/feature/pwa/src/main/java/mozilla/components/feature/pwa/db/ManifestDao.kt"], "git_node": "433993d204a5c37a8b73d4923d15c2b3e3ca41cc", "git_parents": ["caa2e05a1f294328010a679e6d44b45c7dffe470"], "node": "d91acc43a5d0177c6e8d184e51b555ec31d3ca8a", "parents": ["0c89e8a35a5a5e22376253e63c54500702fe8ecd"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2083635 - Part 1: MapAlignedPages can make uncommitted reservations r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326976\n", "files": ["js/src/gc/Memory.cpp", "js/src/gc/Memory.h"], "git_node": "ac77582205b913bc0191b322091400b22428b7b5", "git_parents": ["433993d204a5c37a8b73d4923d15c2b3e3ca41cc"], "node": "c6ed73e92a0f302ae522d3083875a789f71675a0", "parents": ["d91acc43a5d0177c6e8d184e51b555ec31d3ca8a"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2083635 - Part 2: Contiguous nursery uses uncommitted reservations r=jonco\n\nAlso, don't re-acquire the reservation in enable/disable cycles; release\nit only when the nursery is destroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326977\n", "files": ["js/src/gc/Nursery.cpp", "js/src/gc/Nursery.h"], "git_node": "bb31ab219d97511d2e90e06e9b8f5a35d8bbc54f", "git_parents": ["ac77582205b913bc0191b322091400b22428b7b5"], "node": "274264600b38e6be13d5ecea0d6502e0a91ebf90", "parents": ["c6ed73e92a0f302ae522d3083875a789f71675a0"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082715 - Import the Browsertime platform class in raptor.py where it is selected. r=perftest-reviewers,sparky\n\nraptor.py imported both BrowsertimeDesktop and BrowsertimeAndroid up front,\nthough raptor_class only uses the one it selects. This patch imports each from\nits submodule where it is selected, and browsertime/__init__.py now only\nexports the shared Browsertime base.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334360\n", "files": ["testing/raptor/raptor/browsertime/__init__.py", "testing/raptor/raptor/raptor.py", "testing/raptor/test/test_raptor.py"], "git_node": "a53674e55e7147257acf75bc51b78bf4c9a98f30", "git_parents": ["bb31ab219d97511d2e90e06e9b8f5a35d8bbc54f"], "node": "346d91859a17b8e7048c748e9b20316daf7414da", "parents": ["274264600b38e6be13d5ecea0d6502e0a91ebf90"], "tags": []}, {"author": "Jonathan Mendez \u003cjmendez@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083149 - Treat an empty XRE_PROFILE_PATH as unset when tracking startup crashes. r=firefox-desktop-core-reviewers ,Gijs\n\nOn Unix, clearing the variable at startup leaves it empty in the environment of\nany Firefox process this one launches, which turned off startup crash detection\nthere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334740\n", "files": ["toolkit/components/startup/nsAppStartup.cpp", "toolkit/components/startup/tests/unit/test_startup_crash.js"], "git_node": "d6d4389650bc01340a5f02de2c9e08197c3ec46d", "git_parents": ["a53674e55e7147257acf75bc51b78bf4c9a98f30"], "node": "c5a929833bd74e97d21ae4ff0d7900af65fe71b6", "parents": ["346d91859a17b8e7048c748e9b20316daf7414da"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1818883: Move the outgoing datagram queue into neqo r=saschanaz,necko-reviewers,valentin\n\nThe content process no longer owns the outgoing datagram queue.  Each\nwrite() mints a datagram id, sends it with the chunk's creation timestamp,\nand waits for a new DatagramReady(id) message instead of the OutgoingDatagram\nreply.  outgoingMaxBufferedDatagrams and outgoingMaxAge reach neqo through a new\nUpdateDatagramQueueParams message and two new nsIWebTransport setters.  A\ndatagram already older than outgoingMaxAge when it reaches the parent is\ndropped there, since neqo ages it from its own enqueue time.\n\nHttp2WebTransportSession ignores the queue parameters for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287576\n", "files": ["dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "dom/webtransport/child/WebTransportChild.cpp", "dom/webtransport/child/WebTransportChild.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "dom/webtransport/shared/PWebTransport.ipdl", "netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportSession.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportSession.h", "netwerk/protocol/http/WebTransportSessionBase.h", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.h", "netwerk/protocol/webtransport/nsIWebTransport.idl", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/gtest/TestHttp2WebTransport.cpp", "netwerk/test/gtest/TestHttp3ConnectUDPStream.cpp"], "git_node": "efe5e4b42ebec7d6a4cbf24e4c29a0428bd62384", "git_parents": ["d6d4389650bc01340a5f02de2c9e08197c3ec46d"], "node": "ee78594fdaf5d756703fbac41e2a471614dedfe6", "parents": ["c5a929833bd74e97d21ae4ff0d7900af65fe71b6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: Allow more than one datagram to be queued waiting for connection to open r=saschanaz,jib\n\nmIncomingHighWaterMark allows us to queue multiple datagrams waiting for connection; previously there\ncould only be one - we had removed the ability to queue multiple in Bug 1822138\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287807\n", "files": ["dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "dom/webtransport/api/WebTransportDatagramsWritable.cpp", "dom/webtransport/api/WebTransportDatagramsWritable.h", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini"], "git_node": "3254cce42f8257d547d2321a42dbb8d5a6d19561", "git_parents": ["efe5e4b42ebec7d6a4cbf24e4c29a0428bd62384"], "node": "403b46d9e74ea17608c68b56271e97983d3d1a2f", "parents": ["ee78594fdaf5d756703fbac41e2a471614dedfe6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023585: incoming/outgoingMaxAge in WebTransport are now nullable r=webidl,saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288037\n", "files": ["dom/webidl/WebTransportDatagramDuplexStream.webidl", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini"], "git_node": "85b75294a15f41d1642281b10b3b0745b18ccf0c", "git_parents": ["3254cce42f8257d547d2321a42dbb8d5a6d19561"], "node": "86dba62c7e5d6fc9ab50e04d707cb9760238be8e", "parents": ["403b46d9e74ea17608c68b56271e97983d3d1a2f"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007757: close or error the outgoing datagram writables in WebTransport cleanup r=saschanaz\n\nThe cleanup algorithm empties each outgoing datagram writable's\n[[OutgoingDatagramsQueue]] and then closes the writable on a clean close, or\nerrors it on a failure.  Only the promises the duplex stream tracked were\nbeing settled.\n\nThe queued chunk's promise is also the sink's write promise, so it still has\nto be settled: erroring never finishes while a write is marked in flight, so\nthe close or error would not take effect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327590\n", "files": ["dom/streams/WritableStream.cpp", "dom/streams/WritableStream.h", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "testing/web-platform/tests/webtransport/datagrams-writable.https.any.js"], "git_node": "d23c11ba1a19a095d9376f63a3fce815493227da", "git_parents": ["85b75294a15f41d1642281b10b3b0745b18ccf0c"], "node": "690cd53a70fc75b38b2383ab959e455251f30cd3", "parents": ["86dba62c7e5d6fc9ab50e04d707cb9760238be8e"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083567: remove meta files for several WebTransport WPT tests r=jib,necko-reviewers,sunil\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335037\n", "files": ["testing/web-platform/meta/webtransport/close.https.any.js.ini", "testing/web-platform/meta/webtransport/streams-echo.https.any.js.ini"], "git_node": "2d63acda185cdc1696c2b40e510aaf46672fde82", "git_parents": ["d23c11ba1a19a095d9376f63a3fce815493227da"], "node": "d1f7c47e78d596cae00b26f4767c0852c7d94814", "parents": ["690cd53a70fc75b38b2383ab959e455251f30cd3"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1847625 - Apply auth prompt spoofing protection when the current page is an error page. r=mraiber\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334991\n", "files": ["browser/base/content/test/browser-tabPrompts/browser_auth_spoofing_protection.js", "toolkit/components/prompts/src/Prompter.sys.mjs"], "git_node": "6181cf0cdc0e6476d079397d2817d629c383a591", "git_parents": ["2d63acda185cdc1696c2b40e510aaf46672fde82"], "node": "090144a30060f9b081541072e9498fec4a34470d", "parents": ["d1f7c47e78d596cae00b26f4767c0852c7d94814"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994226 - Use public Python package sources in Firefox test tasks r=releng-reviewers,bhearsum,perftest-reviewers,mozperftest-reviewers,sparky,ahal\n\nRemove internal PyPI defaults and direct package URLs from Firefox CI test setup. Use public PyPI while preserving explicit offline installs and required fetched wheels.\n\nThis updates mozharness, mozperftest, conditioned profiles, Raptor, and Android startup setup. It also adds the Android six dependency, fixes accessibility wheel installation order, and pins the WPT/media TLS and Raptor aiohttp dependencies.\n\n[[https://remove-pypimo.quick.mozilla.cloud/ | Change report: before/after code, passing task links, and measured package installation times]].\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327890\n", "files": ["python/mozbuild/mozbuild/action/test_archive.py", "python/mozperftest/mozperftest/tests/test_utils.py", "python/mozperftest/mozperftest/utils.py", "testing/condprofile/condprof/check_install.py", "testing/condprofile/condprof/tests/python.toml", "testing/condprofile/condprof/tests/test_check_install.py", "testing/condprofile/requirements/base.txt", "testing/condprofile/requirements/ci-client.txt", "testing/condprofile/requirements/ci.txt", "testing/condprofile/requirements/local-client.txt", "testing/condprofile/requirements/local.txt", "testing/config/marionette_requirements.txt", "testing/config/mozbase_local_requirements.txt", "testing/config/mozbase_requirements.txt", "testing/config/mozbase_source_requirements.txt", "testing/config/requirements-android-pgo.txt", "testing/config/requirements-common.txt", "testing/config/requirements-condprofile.txt", "testing/config/requirements-marionette.txt", "testing/config/requirements-mozbase.txt", "testing/config/requirements-raptor.txt", "testing/config/wpt_ci_requirements.txt", "testing/mozharness/configs/android/android_common.py", "testing/mozharness/configs/unittests/linux_dbus-python.py", "testing/mozharness/configs/web_platform_tests/aam_config.py", "testing/mozharness/mozharness/base/python.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/mozharness/mozharness/mozilla/testing/talos.py", "testing/mozharness/mozharness/mozilla/testing/testbase.py", "testing/mozharness/scripts/android_emulator_pgo.py", "testing/mozharness/scripts/awsy_script.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/scripts/firefox_ui_tests.py", "testing/mozharness/scripts/marionette.py", "testing/mozharness/scripts/telemetry/telemetry_client.py", "testing/mozharness/scripts/web_platform_tests.py", "testing/mozharness/test/python.toml", "testing/mozharness/test/test_base_python.py", "testing/mozharness/test/test_mozilla_raptor.py", "testing/performance/mobile-startup/hooks_opencv.py", "testing/raptor/requirements-common.txt", "testing/raptor/requirements.txt", "testing/raptor/source_requirements.txt", "testing/talos/requirements.txt", "testing/talos/source_requirements.txt", "testing/tools/websocketprocessbridge/websocketprocessbridge_requirements_3.txt"], "git_node": "7ba4330bfde446583b282e208558e9bf626bec47", "git_parents": ["6181cf0cdc0e6476d079397d2817d629c383a591"], "node": "c4848d213ad3797c8d680c0378ee29adc3d9d3c0", "parents": ["090144a30060f9b081541072e9498fec4a34470d"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062033 - Parse StaticPrefList.yaml pref values with the YAML scanner r=mraiber\n\nparse_static_pref_list() took everything after \"value:\" as the value, so\n\"value: 0 # accept all cookies\" parsed as \"0 # accept all cookies\". 59 of\n2880 entries are affected; nothing renders wrong today only because\nfirefox.js overrides the prefs involved.\n\nLet PyYAML's scanner own the comment, quoting and escape rules rather than\nmatching them by hand. Text it cannot reduce to a scalar on that line --\npreprocessor macros, block scalars -- is handed back untouched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317330\n", "files": ["docs/_addons/etp_matrix.py"], "git_node": "3fb0eed29055946d70eb5b9af56a099c1fb3dac5", "git_parents": ["7ba4330bfde446583b282e208558e9bf626bec47"], "node": "c910ed54fcd8e79c137adda1e046f31ecb2eecff", "parents": ["c4848d213ad3797c8d680c0378ee29adc3d9d3c0"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076453 - Update browser/themes/osx to pass use-design-tokens r=desktop-theme-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332212\n", "files": ["browser/themes/osx/browser.css", "browser/themes/osx/customizableui/panelUI.css", "browser/themes/osx/downloads/allDownloadsView.css", "stylelint-rollouts.config.js"], "git_node": "0f8fe1794bd74a7ca96031d73107e244173c8a04", "git_parents": ["3fb0eed29055946d70eb5b9af56a099c1fb3dac5"], "node": "2ef77d2e3bdfcbc1e17f25ee74b9132b735baee3", "parents": ["c910ed54fcd8e79c137adda1e046f31ecb2eecff"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2081730 - [mips64] Part 1: Add missing FaultingCodeRange{,Pair} usings. r=spidermonkey-reviewers,yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333621\n", "files": ["js/src/jit/mips64/MacroAssembler-mips64.h"], "git_node": "2190b5f87e0bf72af3484a33e26b1cd82691d603", "git_parents": ["0f8fe1794bd74a7ca96031d73107e244173c8a04"], "node": "86be12908f8911931690bcafc22f3539ce740b86", "parents": ["2ef77d2e3bdfcbc1e17f25ee74b9132b735baee3"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2081730 - [mips64] Part 2: Wire up FaultingCodeRange returning through memory access methods. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333667\n", "files": ["js/src/jit/MacroAssembler.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared.cpp", "js/src/jit/mips-shared/MacroAssembler-mips-shared.h", "js/src/jit/mips64/MacroAssembler-mips64.cpp", "js/src/jit/mips64/MacroAssembler-mips64.h"], "git_node": "6ebdc28b71fd5102cc1f4929a38611083e793c04", "git_parents": ["2190b5f87e0bf72af3484a33e26b1cd82691d603"], "node": "5349270c03de52aae741825a26f7af63c4c04120", "parents": ["86be12908f8911931690bcafc22f3539ce740b86"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2081730 - [mips64] Part 3: Wire up MaybeAddDebugStackMapForTrapOOB() for MIPS64. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333668\n", "files": ["js/src/wasm/WasmBCMemory.cpp"], "git_node": "06d5e02541638be0531400fee4974b85fced093f", "git_parents": ["6ebdc28b71fd5102cc1f4929a38611083e793c04"], "node": "73cb82080cfd6bd22e77eeb1d3776635e80c95d5", "parents": ["5349270c03de52aae741825a26f7af63c4c04120"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082477 - VPN is off for this site should only be displayed in the Your Rule section on excluded sites - r=ip-protection-reviewers,lesleynorton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334281\n", "files": ["browser/components/ipprotection/content/ipprotection-content.css", "browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_card.js"], "git_node": "c9d3a604fc2a946de6c962538756255d34de27f2", "git_parents": ["06d5e02541638be0531400fee4974b85fced093f"], "node": "6572466e75d9a21cc78aa51c0db7687acaf0048e", "parents": ["73cb82080cfd6bd22e77eeb1d3776635e80c95d5"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["testing/web-platform/meta/webtransport/close.https.any.js.ini", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini", "testing/web-platform/meta/webtransport/streams-echo.https.any.js.ini"], "git_node": "fc216bdbdf04fca964b8f241844b0e6d048cc245", "git_parents": ["8a04f2b9694c385245dae3d96676780785bbe9b0", "c9d3a604fc2a946de6c962538756255d34de27f2"], "node": "3d4ee3ed50eec93899d6c763154bb3c25457a439", "parents": ["49fc31a23d634ee70e087b718056ef61c2b03258", "6572466e75d9a21cc78aa51c0db7687acaf0048e"], "tags": []}], "date": 1792447142, "git_changesets": ["8cb43598313557dc17537a9f752c2e4ec83d4142", "d4aa1cfdf8928a7f582f43f0070395098d327b66", "20ac42c265b04a5863d83ad372ce678dadaa44a7", "9e1efa8acec25b84a9f4f2439e51fc1597c3ad5c", "36952d22dcc48d4cb9955f30772491c4f18a8ddd", "531b2ae34e9a34f1f5c025b73bc813694cb06ae1", "44c8fd8df124546b1aec37bd794eed0a97140cf3", "190377ca7a1f4dcd7c42fc7c9d71f6f1f770979b", "6f306bab84456a991cad483ce81516ca96c5169b", "875508e7103bb0a75070223e01a23b65da9a4446", "1e6d865f830d6f95c963199b0039249fb386bbb9", "926619e85fda8c531ff49ad0376c5cffced9470d", "ae110dfc414cc3af37b5d00838f444c06a3244ac", "0fa8be1294cb43106406374d9e9f2bc65a7518e2", "614c2a77b9d2e2839d4b581ae7913c0dc3154562", "1eb422761fbdd41907df529e26bfab30e3c4b7ed", "06d315c375680525c457f456ff033665b8052b19", "caa2e05a1f294328010a679e6d44b45c7dffe470", "433993d204a5c37a8b73d4923d15c2b3e3ca41cc", "ac77582205b913bc0191b322091400b22428b7b5", "bb31ab219d97511d2e90e06e9b8f5a35d8bbc54f", "a53674e55e7147257acf75bc51b78bf4c9a98f30", "d6d4389650bc01340a5f02de2c9e08197c3ec46d", "efe5e4b42ebec7d6a4cbf24e4c29a0428bd62384", "3254cce42f8257d547d2321a42dbb8d5a6d19561", "85b75294a15f41d1642281b10b3b0745b18ccf0c", "d23c11ba1a19a095d9376f63a3fce815493227da", "2d63acda185cdc1696c2b40e510aaf46672fde82", "6181cf0cdc0e6476d079397d2817d629c383a591", "7ba4330bfde446583b282e208558e9bf626bec47", "3fb0eed29055946d70eb5b9af56a099c1fb3dac5", "0f8fe1794bd74a7ca96031d73107e244173c8a04", "2190b5f87e0bf72af3484a33e26b1cd82691d603", "6ebdc28b71fd5102cc1f4929a38611083e793c04", "06d5e02541638be0531400fee4974b85fced093f", "c9d3a604fc2a946de6c962538756255d34de27f2", "fc216bdbdf04fca964b8f241844b0e6d048cc245"], "user": "ctuns@mozilla.com"}, "45597": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX_158_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "810be14f88eb1abc0bf57df1158014d3464f1ba0", "git_parents": ["067d0f10f7411d25981204d7d8f57552b5913de2"], "node": "b3825d811065e00eda132444618e824eb95670aa", "parents": ["1bc590d097102265126b43df46a5c73592ff1247"], "tags": []}], "date": 1792447313, "git_changesets": ["810be14f88eb1abc0bf57df1158014d3464f1ba0"], "user": "ffxbld@lando.moz.tools"}, "45598": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX-ANDROID_158_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c4485f6da107f16515b24c791f71104056baa001", "git_parents": ["810be14f88eb1abc0bf57df1158014d3464f1ba0"], "node": "7dc2b9feb5c0ceb4818f8f615981573e8a971e0f", "parents": ["b3825d811065e00eda132444618e824eb95670aa"], "tags": []}], "date": 1792447466, "git_changesets": ["c4485f6da107f16515b24c791f71104056baa001"], "user": "ffxbld@lando.moz.tools"}, "45599": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2083010 - Add a test for Windows SSO header injection. r=necko-reviewers,valentin\n\nThere was no test coverage for Windows SSO. Split getting the credentials\nfrom Windows out of AddWindowsSSO, and in automation allow\nnetwork.http.windows-sso.credentials-for-testing to supply fake credentials\ninstead, so an xpcshell test can check which requests get them: only https\ndocuments and subdocuments, not in private browsing, anonymous loads or\ncontainers without SSO enabled, and cookies only on .live.com.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334752\n", "files": ["netwerk/protocol/http/HttpWinUtils.cpp", "netwerk/test/unit/test_windows_sso.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "cf291fd59e1082eccdfcf34a9e4965f73fe7c54b", "git_parents": ["c9d3a604fc2a946de6c962538756255d34de27f2"], "node": "70d910bbbb02b146f2394743e63bf36c74608361", "parents": ["6572466e75d9a21cc78aa51c0db7687acaf0048e"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068770 - Fetch the server list once startup has completed instead of mirroring it into a pref r=ip-protection-reviewers,firefox-desktop-core-reviewers ,rking\n\nThe pref mirror let an activation at startup pick a server before Remote\nSettings was readable. It is 9KB now, past libpref's 4KB advisory limit.\nstart() waits for startup to complete and fetches the list itself, so the\nmirror has no reader left: the list is fetched when an activation needs it,\nor once startup has completed with the service READY, and IPPAutoActivation\nno longer needs a list to ask. A profile data upgrade clears the pref for\nexisting desktop profiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328908\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/ProfileDataUpgrader.sys.mjs", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_list.js", "browser/components/ipprotection/tests/browser/head.js", "browser/components/tests/unit/test_browserGlue_migration_remove_pref.js", "toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPStartupCache.sys.mjs", "toolkit/components/ipprotection/IPProtectionServerlist.sys.mjs", "toolkit/components/ipprotection/docs/Preferences.md", "toolkit/components/ipprotection/tests/xpcshell/test_IPProtectionServerlist.js"], "git_node": "945290cfe0a1430fb0825846bd085e7e22bfef96", "git_parents": ["cf291fd59e1082eccdfcf34a9e4965f73fe7c54b"], "node": "9e79958befa6e801501722e444aef5c1f22e666b", "parents": ["70d910bbbb02b146f2394743e63bf36c74608361"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2083596 - Fix typos in ConsoleTimingMarker schema r=profiler-reviewers,dcarver DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335057\n", "files": ["dom/console/Console.cpp"], "git_node": "46184181787888edcea173027d796d299e3d1388", "git_parents": ["945290cfe0a1430fb0825846bd085e7e22bfef96"], "node": "e35c848978d6a95d2e23fb24873db776bca3a1c9", "parents": ["9e79958befa6e801501722e444aef5c1f22e666b"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2083540 - Decode UTF-8 JS source text as UTF-8 when creating JS strings for the profile. r=profiler-reviewers,canova\n\nJS_NewStringCopyN treats its input as Latin-1, so it was the wrong\nfunction to call for SourceTextUTF8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335022\n", "files": ["tools/profiler/core/ProfileAdditionalInformation.cpp", "tools/profiler/tests/browser/browser.toml", "tools/profiler/tests/browser/browser_test_feature_js_sources_retrieval.js", "tools/profiler/tests/browser/page_with_utf8_external_js.html", "tools/profiler/tests/browser/utf8_external_script.js"], "git_node": "7d1d9303030c770e89cb0a1172540a5818f624a6", "git_parents": ["46184181787888edcea173027d796d299e3d1388"], "node": "5a73c92930f7e47b3f18bddb0929aaee4b568121", "parents": ["e35c848978d6a95d2e23fb24873db776bca3a1c9"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079759 - Add a userContextId field to Places history visits and populate it r=places-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330688\n", "files": ["docshell/base/IHistory.h", "docshell/base/nsDocShell.cpp", "dom/base/PlacesVisit.h", "dom/chrome-webidl/PlacesEvent.webidl", "dom/ipc/BrowserParent.cpp", "mobile/shared/components/geckoview/GeckoViewHistory.cpp", "mobile/shared/components/geckoview/GeckoViewHistory.h", "toolkit/components/downloads/DownloadHistory.sys.mjs", "toolkit/components/downloads/test/unit/test_DownloadHistory.js", "toolkit/components/places/Database.cpp", "toolkit/components/places/Database.h", "toolkit/components/places/History.cpp", "toolkit/components/places/History.h", "toolkit/components/places/History.sys.mjs", "toolkit/components/places/PlacesUtils.sys.mjs", "toolkit/components/places/nsINavHistoryService.idl", "toolkit/components/places/nsPlacesTables.h", "toolkit/components/places/tests/browser/browser.toml", "toolkit/components/places/tests/browser/browser_visituri_userContextId.js", "toolkit/components/places/tests/gtest/places_test_harness.cpp", "toolkit/components/places/tests/gtest/test_IHistory.cpp", "toolkit/components/places/tests/history/test_insert_userContextId.js", "toolkit/components/places/tests/history/xpcshell.toml", "toolkit/components/places/tests/migration/places_v88.sqlite", "toolkit/components/places/tests/migration/test_current_from_v87.js", "toolkit/components/places/tests/migration/xpcshell.toml", "tools/@types/generated/lib.gecko.dom.d.ts"], "git_node": "da69f9ad547eb50d6895d674e8ea278e415b4a7b", "git_parents": ["7d1d9303030c770e89cb0a1172540a5818f624a6"], "node": "e6518a8f9dccca61fa829d879594ab6de9d9b5f9", "parents": ["5a73c92930f7e47b3f18bddb0929aaee4b568121"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058701 - Add a prefetch dry-run mode and an eligibility bit for A/B measurement r=ipc-reviewers,acreskey,sunil\n\nComparing prefetched navigations against all navigations is weak. This lets the\ncontrol branch process speculation rules and record the candidate, then stop\nbefore the request, so both branches can report the same population.\n\nTwo pieces: dom.speculation_rules.prefetch.dry_run, bound to Nimbus, and a\nNAVIGATIONAL_PREFETCH_ELIGIBLE bit set in both branches whenever a candidate\ncovers the navigation. Comparing eligible-to-eligible keeps the randomisation\nintact; the served bit then says which of those actually used a prefetch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324320\n", "files": ["dom/base/Document.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_page_load_event_prefetch.js", "dom/base/test/file_pageload_prefetch_target.sjs", "dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "dom/ipc/PrefetchTypes.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/metrics.yaml", "ipc/glue/BackgroundUtils.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/base/LoadInfo.h", "netwerk/base/nsILoadInfo.idl", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/NeckoChannelParams.ipdlh", "toolkit/components/nimbus/FeatureManifest.yaml", "tools/performance/PageloadEvent.h"], "git_node": "cca1f9918de0f2681d0fc80ed530e1ce17a3a19e", "git_parents": ["da69f9ad547eb50d6895d674e8ea278e415b4a7b"], "node": "596213486c902efdc5a49801061576137fc00bcb", "parents": ["e6518a8f9dccca61fa829d879594ab6de9d9b5f9"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079890 - Remove transactions from synchronous bookmark writes used by tagging. r=places-reviewers,daisuke\n\nmozStorageTransaction tracks nesting with a counter shared by the whole\nconnection, so a main-thread transaction on the Places connection breaks when\nan async thread opens one on the same connection. Tagging is the only caller of\nthese methods and each one only touches a few rows.\n\nInsertBookmark now validates the parent before creating the page, so an invalid\nparent doesn't leave a stray moz_places row behind. A later failure can still\nleave an unreferenced page row, which expiration cleans up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332673\n", "files": ["toolkit/components/places/nsNavBookmarks.cpp"], "git_node": "4841fb548cabfc64c9e93c6241538d83b6479942", "git_parents": ["cca1f9918de0f2681d0fc80ed530e1ce17a3a19e"], "node": "7b3c8c99df637913d54d0a08d16cd1a2ffb08363", "parents": ["596213486c902efdc5a49801061576137fc00bcb"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079890 - Make nsINavBookmarksService.removeItem fail on non-empty folders. r=sync-reviewers,places-reviewers,markh,daisuke\n\nThe only caller removes a tag folder after checking that it is empty, so the\nrecursive removal was never exercised outside of tests. Callers that need to\nremove a folder tree can use PlacesUtils.bookmarks.remove().\n\nThis removes RemoveFolderChildren and its helpers, including the nested\ntransaction it opened on the main connection. Removing a folder no longer bumps\nthe sync change counter of the folder right before deleting it, so\ntest_onItemUntagged and test_async_onItemUntagged expect one sync change less.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332674\n", "files": ["services/sync/tests/unit/test_bookmark_tracker.js", "toolkit/components/places/nsINavBookmarksService.idl", "toolkit/components/places/nsNavBookmarks.cpp", "toolkit/components/places/nsNavBookmarks.h"], "git_node": "652da4aca8d6362e7ddbcb36424184b67d4e18ce", "git_parents": ["4841fb548cabfc64c9e93c6241538d83b6479942"], "node": "0bac00c101aa721f814cb1a4ca6cead80c243f6d", "parents": ["7b3c8c99df637913d54d0a08d16cd1a2ffb08363"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079890 - Remove the transaction from nsINavBookmarksService.removeItem. r=places-reviewers,daisuke\n\nTag folders contain no separators, so skip adjusting them for tag items.\n\nThe remaining writes are no longer atomic. A failure between them can leave a\ngap in positions, a missing tombstone or a missed Sync change, in exchange for\nno longer opening a transaction on the main connection from the main thread.\n\nThis is an interim solution until tags are moved to the async API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332675\n", "files": ["toolkit/components/places/nsNavBookmarks.cpp"], "git_node": "20a443c25b98729ab00ddf55ead4354bfe134cfd", "git_parents": ["652da4aca8d6362e7ddbcb36424184b67d4e18ce"], "node": "34923f70cb766d2443c5269976b98f0eb223d2d8", "parents": ["0bac00c101aa721f814cb1a4ca6cead80c243f6d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074541 - Refresh Expat local patches for 2.8.5. r=mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328275\n", "files": ["parser/expat/00_xmlchar.patch", "parser/expat/01_report_mismatched_tag.patch", "parser/expat/02_dont_generate_salt.patch", "parser/expat/03_always_set_eventptrs.patch", "parser/expat/04_getcurrentbyteindex.patch", "parser/expat/05_always_store_rawnames.patch", "parser/expat/06_dont_ignore_undeclared_entity.patch", "parser/expat/07_include_xmlns.patch", "parser/expat/08_internalsubset.patch", "parser/expat/09_version_limit.patch", "parser/expat/10_no_debug_report.patch", "parser/expat/11_unused.patch"], "git_node": "1d27800103da64d6413c8bb3c9552da158d93ed0", "git_parents": ["20a443c25b98729ab00ddf55ead4354bfe134cfd"], "node": "ae570f7181a282ebd6cda0eab692b7b0413a40fa", "parents": ["34923f70cb766d2443c5269976b98f0eb223d2d8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074541 - Update to Expat 2.8.5. r=mccr8,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328276\n", "files": ["parser/expat/expat/Changes", "parser/expat/expat/README.md", "parser/expat/expat/lib/.gitignore", "parser/expat/expat/lib/expat.h", "parser/expat/expat/lib/expat_external.h", "parser/expat/expat/lib/hash_table.h", "parser/expat/expat/lib/internal.h", "parser/expat/expat/lib/xmlparse.c", "parser/expat/expat/lib/xmlrole.c", "parser/expat/expat/lib/xmlrole.h", "parser/expat/expat/lib/xmltok.c", "parser/expat/expat/lib/xmltok.h", "parser/expat/expat/lib/xmltok_impl.c", "parser/expat/expat/lib/xmltok_ns.c", "parser/expat/moz.yaml"], "git_node": "11b6ceef1b8f3032cbba5784fd018765ef48049e", "git_parents": ["1d27800103da64d6413c8bb3c9552da158d93ed0"], "node": "ccd0455bcc7618cf81693c5746f86df991f0f770", "parents": ["ae570f7181a282ebd6cda0eab692b7b0413a40fa"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081670 - [refactor] move onboardingCompletedTimestamp inside the block where it is used to prevent redundant setting. r=sfamisa\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/391\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationScheduler.kt"], "git_node": "4f1544d65e3797e87bbb2c758c234cc0d6c89a61", "git_parents": ["11b6ceef1b8f3032cbba5784fd018765ef48049e"], "node": "0129cd8c529bd8c292c4ea1c73e2e3265000c829", "parents": ["ccd0455bcc7618cf81693c5746f86df991f0f770"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081506 - Record which entry point opened the clear browsing data dialog and whether it deleted data. r=mraiber\n\nThe fire button experiment needs to tell whether the fire button replaces the\nexisting ways of clearing data, the keyboard shortcut in particular, which\nshares its command with the menu items.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333449\n", "files": ["browser/base/content/browser-sets.js", "browser/base/content/sanitizeDialog.js", "browser/base/content/test/browser-sanitize/browser_sanitizeDialog_v2.js", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/test/browser_fireButton.js", "browser/modules/Sanitizer.sys.mjs", "browser/modules/metrics.yaml"], "git_node": "c4a9eabcb93524d22adc79f816649e4aa83f3e35", "git_parents": ["4f1544d65e3797e87bbb2c758c234cc0d6c89a61"], "node": "ea51048820f93375d33edc577f3540198f0ddd57", "parents": ["0129cd8c529bd8c292c4ea1c73e2e3265000c829"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081506 - Report the address bar, history sidebar and Settings as entry points of the clear browsing data dialog. r=urlbar-reviewers,sidebar-reviewers,settings-reviewers,mkennedy,kcochrane,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333450\n", "files": ["browser/base/content/test/browser-sanitize/browser_sanitizeDialog_v2.js", "browser/components/preferences/config/privacy.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/tests/browser/browser_history_sidebar_glean.js", "browser/components/urlbar/QuickActionsLoaderDefault.sys.mjs", "browser/components/urlbar/UrlbarProviderInterventions.sys.mjs", "browser/components/urlbar/tests/browser-quickactions/browser_general.js", "browser/components/urlbar/tests/browser-tips/browser_interventions.js", "browser/modules/Sanitizer.sys.mjs", "browser/modules/metrics.yaml"], "git_node": "52b5839d30b4f47f96cab0fbb825b2b67d35f15f", "git_parents": ["c4a9eabcb93524d22adc79f816649e4aa83f3e35"], "node": "8ecaa904f4ba89a34bcd9852bff87e0cec8d7365", "parents": ["ea51048820f93375d33edc577f3540198f0ddd57"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045003 - Defer unbinding of unlinked content until the end of each shutdown cycle collection. r=smaug\n\nShutdown cycle collection unbound children synchronously, so ShadowRoot::Unbind() could notify a not yet unlinked range about an already emptied subtree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334629\n", "files": ["dom/base/FragmentOrElement.cpp", "dom/base/nsJSEnvironment.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_range_shadow_root_shutdown.js"], "git_node": "783e9459105cde1e84dc4c3ce209af18f0458645", "git_parents": ["52b5839d30b4f47f96cab0fbb825b2b67d35f15f"], "node": "8df01ab2af0fccde751086a1a458e652d84ffe34", "parents": ["8ecaa904f4ba89a34bcd9852bff87e0cec8d7365"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046071 - Preserve users initial intent through onboarding and process it on completion. r=pollymce\n\n### Summary\nWhen Firefox is launched through an intent before onboarding is complete, the user is redirected to onboarding. On a cold start, `HomeActivity` skips the intent processors, so the original launch intent\u2014such as a link tap, search widget action, deep link, or custom tab request\u2014was never processed after onboarding finished.\n\n`HomeActivity` now registers a preference listener while onboarding is displayed, provided `FenixOnboarding.userHasBeenOnboarded()` returns `false`. When `finish()` updates the stored onboarding version, the listener passes the original launch intent through the usual intent processors.\n\n`OnboardingFragment` calls `finish()` after navigating home. This ordering matters because the listener fires synchronously: home must already be on the back stack beneath the destination opened by the replayed intent.\n\n---\n\n### Testing:\n**Developer prerequistie**: flip the `FeatureFlags.onboardingFeatureEnabled` to show onboarding in debug.\n\n1.  `adb shell pm clear org.mozilla.fenix.debug`\n2.  `adb shell am start -a android.intent.action.VIEW -d https://example.com org.mozilla.fenix.debug`\n\n3. Complete onboarding. The page should load, and back should return to home.\n\nDemo\nhttps://github.com/user-attachments/assets/bd0426b8-cbf1-4ad0-8c75-13b3ca8dfd09\n\nRepeat with the search widget intent and expect the URL bar to be in focus:\n  `adb shell am start -n org.mozilla.fenix.debug/org.mozilla.fenix.HomeActivity -a android.intent.action.MAIN --es open_to_search search_widget`\n\nDemo\nhttps://github.com/user-attachments/assets/28ea97c1-52e1-4b1f-9761-8197c200763e\n\n### Notes\nRelation to [bug 2077533](https://bugzilla.mozilla.org/show_bug.cgi?id=2077533): that bug covers warm starts, where an intent arrives via `onNewIntent` while onboarding is already showing. Those intents are still processed immediately and are not affected by this change. If the user\nlaunches via link A and taps link B during onboarding, B opens straight away and A is still replayed on completion. The `StartSearchIntentProcessor` guard from bug 2022523 is left in place for the same reason.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/396\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/FenixOnboarding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/FenixOnboardingTest.kt"], "git_node": "0a0d3fc419fa3bca7d00ac5a43a596635bc41b4d", "git_parents": ["783e9459105cde1e84dc4c3ce209af18f0458645"], "node": "0e911c61636b46ab22aade3c0dc3deee15e9b521", "parents": ["8df01ab2af0fccde751086a1a458e652d84ffe34"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068232 - Add telemetry for the desktop to mobile pairing flow r=android-reviewers,Roger\n\nAdds telemetry to measure how many users come from the desktop to mobile pairing flow.\n\nA user can reach the flow in two ways:\n\n- Firefox is not installed: `play_store_attribution.pairing_campaign` records whether the install referrer's utm_content matches the campaign marker. The default value of `campaign-utm-content` has been changed to `DTM_SYNC_PAIR_V2` in Nimbus.\n\n- Firefox is already installed: There is no install referrer in this case. `sync_auth.pairing_link_opened` is recorded when the scanned pairing link is opened in the app. It also matches the stage server to facilitate tests. Its `campaign_attributed` extra tells if the install came from the pairing campaign.\n\nThe old pairing flow is still identified by `sync_auth.scan_pairing`, an event recorded by `TurnOnSyncFragment` when clicking `Ready to scan` button. Joining this with `sync_auth.paired` can tell if the user finished signing in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334605\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/IntentReceiverActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/InstallReferrerWorker.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/IntentReceiverActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingServiceTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerWorkerTest.kt"], "git_node": "2f21cbc1f919126e8c9be679c169fa8cd91f77a3", "git_parents": ["0a0d3fc419fa3bca7d00ac5a43a596635bc41b4d"], "node": "e5b42f0ad4834c206224bc5ebe04d419c1ab14ad", "parents": ["0e911c61636b46ab22aade3c0dc3deee15e9b521"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074984 - Show the whole article's progress in the Listen playback notification. r=android-reviewers,zfatima,matt-tighe\n\nThe notification and the lock screen now show the position and length of the whole article rather than of the chunk\nplaying, and seeking or skipping from them moves through the article. A seek past the audio that is ready shows\nloading at the target until its chunk has been made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328928\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/Playlist.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ArticleMeasurements.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ArticleTimeline.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ProgressMapper.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/SessionCommands.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/SessionPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueue.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/PlaylistTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/fakes/FakeChunkPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionServiceTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenSessionHarness.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenSessionTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ProgressMapperTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/SessionPlayerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueueTest.kt"], "git_node": "850822e6b43da24e4b62a4246c0eb5f291fed479", "git_parents": ["2f21cbc1f919126e8c9be679c169fa8cd91f77a3"], "node": "d37057d5d0546ae6eb6e08bf51206eaa80da1d3c", "parents": ["e5b42f0ad4834c206224bc5ebe04d419c1ab14ad"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074984 - Keep the Listen progress bar smooth while the article's length is estimated. r=android-reviewers,matt-tighe\n\nChunks that have not been made yet are estimated from the measured chunks nearest them. When the estimate changes, the\nbar speeds up or slows down to catch up instead of jumping or going back, and a seek lands where the bar was let go of.\nThe notification is given the length the sheet's bar is drawn against, so both bars stay in step.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333822\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/Playlist.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/BarPosition.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ProgressMapper.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/SessionCommands.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/SessionPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/PlaylistTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/BarPositionTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ProgressMapperTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/SessionPlayerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetTest.kt"], "git_node": "05fe938fa34a986476ad469fa8c58807cd78c114", "git_parents": ["850822e6b43da24e4b62a4246c0eb5f291fed479"], "node": "88aea8a995223fe6d689a0f00c1a7fc5add02b9c", "parents": ["d37057d5d0546ae6eb6e08bf51206eaa80da1d3c"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082569 - Start reading the Listen article out as soon as the audio icon is tapped. r=android-reviewers,matt-tighe\n\nThe sheet opens and the article is read out from a single tap, so starting playback is no longer a separate step. The\nbar cannot be dragged until the opening has given the article a length.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333823\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/AudioProgressBar.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/listentopage/ListenToPageTools.kt"], "git_node": "da3b379496851418656850df0e46bfa4ec0dccf7", "git_parents": ["05fe938fa34a986476ad469fa8c58807cd78c114"], "node": "2c270e0c55c5081c7fa37e80f403a867345f9212", "parents": ["88aea8a995223fe6d689a0f00c1a7fc5add02b9c"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078418 - Show a spinner on the Listen play button while playback is buffering. r=android-reviewers,matt-tighe\n\nThe icon is replaced by a loading indicator once buffering has lasted 300 ms, so the short buffering after most seeks\ndoes not make it flash.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333824\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayPauseButton.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlaybackUiState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerCompact.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/PlaybackUiStateTest.kt"], "git_node": "8f4a268499274371669ab05a839493fc6ef50576", "git_parents": ["da3b379496851418656850df0e46bfa4ec0dccf7"], "node": "6aeb44defdc6daf294541dfc4d01f2d3f9e2b251", "parents": ["2c270e0c55c5081c7fa37e80f403a867345f9212"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2080727 - Migrate customizableWidgets.properties to Fluent. r=firefox-desktop-core-reviewers ,fluent-reviewers,extension-reviewers,devtools-reviewers,nchevobbe,mconley,bolsson,rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333540\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/extensions/parent/ext-browserAction.js", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/browser/customizeMode.ftl", "browser/locales/en-US/chrome/browser/customizableui/customizableWidgets.properties", "browser/locales/jar.mn", "devtools/startup/DevToolsStartup.sys.mjs", "python/l10n/fluent_migrations/bug_2080727_customizable_widgets_properties.py"], "git_node": "67d3e22f48b7ea4c305585b344be3ccdf604b6f2", "git_parents": ["8f4a268499274371669ab05a839493fc6ef50576"], "node": "0dcb6dee837498db7f4322575dff2a73140879c7", "parents": ["6aeb44defdc6daf294541dfc4d01f2d3f9e2b251"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1975326: SelectableProfileService should block the ProfilesDatastoreService shutdown barrier. r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332833\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "toolkit/profile/ProfilesDatastoreService.sys.mjs"], "git_node": "c0a72aed7d0253254507cb63b9a1412e15e5a1b3", "git_parents": ["67d3e22f48b7ea4c305585b344be3ccdf604b6f2"], "node": "2440b96c88603cfb9c18ff5576a4ea3d58756d92", "parents": ["0dcb6dee837498db7f4322575dff2a73140879c7"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082997 - Skip redundant RegExpStatics barriers in JIT regexp calls; r=iain\n\nWhen RegExpStatics already refer to the same input string and RegExp source,\nas they do for every match after the first in a global loop, the pointer\nstores in UpdateRegExpStatics write the values the fields already hold. Skip\nthose stores and their pre- and post-write barriers, and only update the lazy\nindex, the pending-evaluation flag and the flags.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334589\n", "files": ["js/src/jit-test/tests/regexp/statics-fastpath-flags.js", "js/src/jit-test/tests/regexp/statics-fastpath-gc.js", "js/src/jit-test/tests/regexp/statics-fastpath-legacy.js", "js/src/jit-test/tests/regexp/statics-fastpath-realms.js", "js/src/jit-test/tests/regexp/statics-fastpath-reentrant.js", "js/src/jit/CodeGenerator.cpp"], "git_node": "5136b028fea75d6ab6097a1a38609af7f396d085", "git_parents": ["c0a72aed7d0253254507cb63b9a1412e15e5a1b3"], "node": "7255772db9771646fff6d7f347342cd4d1059d72", "parents": ["2440b96c88603cfb9c18ff5576a4ea3d58756d92"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075301 - Connection Allowlists: Report blocked resources to the console. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328899\n", "files": ["dom/locales/en-US/chrome/security/security.properties", "dom/security/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlists.h", "dom/security/test/connection-allowlist/file_enforce.html", "dom/security/test/connection-allowlist/file_enforce.html^headers^", "dom/security/test/connection-allowlist/file_report_only.html", "dom/security/test/connection-allowlist/file_report_only.html^headers^", "dom/security/test/connection-allowlist/mochitest.toml", "dom/security/test/connection-allowlist/test_console_messages.html", "dom/security/test/moz.build"], "git_node": "8729e63e61a5ae0e498ae7ac5e31f8a52e7e9fe4", "git_parents": ["5136b028fea75d6ab6097a1a38609af7f396d085"], "node": "9e1a1c18d279e37f07d2c726909c31cca9fd3465", "parents": ["7255772db9771646fff6d7f347342cd4d1059d72"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2083708 - Use moz-src for extensions/permissions r=permissions-reviewers,emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335113\n", "files": ["extensions/permissions/components.conf", "extensions/permissions/moz.build", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "cea9037516a587fb3e6db66dc352b0bbf8924b51", "git_parents": ["8729e63e61a5ae0e498ae7ac5e31f8a52e7e9fe4"], "node": "5088f20aca59066a1af4e7453faed941cef2a747", "parents": ["9e1a1c18d279e37f07d2c726909c31cca9fd3465"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2081475 - Allow another tick before retrieving interactive accessible. r=accessibility-platform-reviewers,morgan\n\nBefore bug 2073568, XUL elements were getting accessibles in the restyle\nstage rather than from the DOM \"popupshown\" event we listen for in\nRootAccessible. After this fix we are now having those accessibles\ncreated a bit later in the DOM event phase, so we need to wait an extra\nbeat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334235\n", "files": ["testing/mochitest/tests/SimpleTest/AccessibilityUtils.js"], "git_node": "a8c3f396e9aed55beedb4d0a361c529e20826f69", "git_parents": ["cea9037516a587fb3e6db66dc352b0bbf8924b51"], "node": "57df39a681e2db9d7c3dc9b03b0a9aa79d92f869", "parents": ["5088f20aca59066a1af4e7453faed941cef2a747"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076414 - Clean up DOMMediaStream listener handling. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334724\n", "files": ["dom/media/DOMMediaStream.cpp", "dom/media/DOMMediaStream.h"], "git_node": "30a92bd3d774810d9ad7d4d38f074310d160dd96", "git_parents": ["a8c3f396e9aed55beedb4d0a361c529e20826f69"], "node": "2cbd155f2d06d770bbc0ba44063e5f92a013fc89", "parents": ["57df39a681e2db9d7c3dc9b03b0a9aa79d92f869"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070672 - Remove macOS 14.7 Chrome tests. r=perftest-reviewers,aglavic\n\nThis is part of the effort in moving tests over to macOS 15\n\nRemove tests running on Chrome in 14.7 platform, except the media tests\nwhich are kept for now as they are monitored.\n\nStorage and networking are removed for the time being but may be added\nback later (but on macOS aarch64)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331699\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "efc97c16a4ba90710ab8b1a21a60b1d6b634b360", "git_parents": ["30a92bd3d774810d9ad7d4d38f074310d160dd96"], "node": "2bf25d1792404caaeaab3938f5b368a532e04f2c", "parents": ["2cbd155f2d06d770bbc0ba44063e5f92a013fc89"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082871 - Let rotated SVG images and plain rects be drawn by WebRender again. r=emilio\n\nBug 2070993 kept the children of a rotated or skewed transform in the blob\nimage unless they had to be active. This moved rotated \u003cimage\u003e elements into\nthe blob and regressed tsvgx (hixie-004).\n\nOnly strokes and rounded fills need to stay in the blob under such transforms:\nWebRender currently renders solid rounded rects and borders axis aligned and\nthen rotates them, which makes their edges blurry. The axis aligned requirement\nis now passed down to SVGGeometryFrame, which applies it to those shapes only.\n\nThe non-uniform scale restriction is removed along with the\ngfx.webrender.svg-images.non-uniform-scale pref. The anti-aliasing issues it\nworked around were fixed by the migration from brush shaders to quad shaders.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335099\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGeometryFrame.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "21fcfacd8833b98417a8f340fce3d5b3f76f2941", "git_parents": ["efc97c16a4ba90710ab8b1a21a60b1d6b634b360"], "node": "b857098ce732a0b951514a002f2462dda130bdeb", "parents": ["2bf25d1792404caaeaab3938f5b368a532e04f2c"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2082294 - Migrate media notification bar strings from browser.properties to Fluent. r=media-playback-reviewers,fluent-reviewers,bolsson,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334401\n", "files": ["browser/actors/DecoderDoctorParent.sys.mjs", "browser/actors/EncryptedMed