bus/test/unit/test_ExperimentStore.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_Migrations.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_bug2054546.js", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "bcf0d6e4190e40b3bdb411f3d7ee1d76471e70fe", "git_parents": ["bccb6d9cf28debe29ffa5a80aa4349b204e2d008"], "node": "650c62b5bd8d270acc233e164f4001b1a0324abd", "parents": ["6c8e2b0fceb52fac45faa960eca0b8a3629b6ef1"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081269 - Fix user activation telemetry to be limited to permission-granted requests r=dom-core-reviewers,edgar\" for causing failures at user-activation-glean.https.window.html.\n\nThis reverts commit 65b19d5b84e4e12118ff91a9e2e0df5499b98aef.\n", "files": ["dom/geolocation/Geolocation.cpp", "testing/web-platform/mozilla/tests/geolocation-API/user-activation-glean.https.window.js"], "git_node": "fb7014bd59fb407dab785f62231f80fce1af52ba", "git_parents": ["bcf0d6e4190e40b3bdb411f3d7ee1d76471e70fe"], "node": "8202d08adb740d28ed798ca4d60a3d6ea2bb2dc2", "parents": ["650c62b5bd8d270acc233e164f4001b1a0324abd"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078631 - Add tests for compartment mismatch; r=media-playback-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329144\n", "files": ["dom/media/webcodecs/test/file_crossCompartment_frame.html", "dom/media/webcodecs/test/mochitest.toml", "dom/media/webcodecs/test/test_audioData_crossCompartment.html", "dom/media/webcodecs/test/test_encodedAudioChunk_crossCompartment.html", "dom/media/webcodecs/test/test_imageDecoder_crossCompartment.html"], "git_node": "3c17cb7aeb97e7467e81f3dd9051f1fbabc8cdd5", "git_parents": ["fb7014bd59fb407dab785f62231f80fce1af52ba"], "node": "1c64e755f2311666373ce7b8153d55fc7f844a9a", "parents": ["8202d08adb740d28ed798ca4d60a3d6ea2bb2dc2"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076451 - update Linux browser theme to use design tokens r=desktop-theme-reviewers,places-reviewers,mstriemer,emilio\n\n- Updates the Linux browser theme to use tokens where possible, otherwise adds explanatory disable comments\n- Removes affected files from stylelint rollouts\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330211\n", "files": ["browser/themes/linux/browser.css", "browser/themes/linux/customizableui/panelUI.css", "browser/themes/linux/places/organizer.css", "stylelint-rollouts.config.js"], "git_node": "397cb80b12f35fad95bf9b509569ea92739547d3", "git_parents": ["3c17cb7aeb97e7467e81f3dd9051f1fbabc8cdd5"], "node": "8fef460625ddbb6a5e4c82e60d4d2b2447b951a2", "parents": ["1c64e755f2311666373ce7b8153d55fc7f844a9a"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078288 - Only deactivate when the proxy is active or an activation is in progress. r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330810\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "1b510cdbc687bc789cb19459f65b8741c0e06443", "git_parents": ["397cb80b12f35fad95bf9b509569ea92739547d3"], "node": "85f3a0acd9224675ddfd0bc0eacd970f5d3e9697", "parents": ["8fef460625ddbb6a5e4c82e60d4d2b2447b951a2"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2080897 - Retain SerpTelemetryRepository so search-telemetry-v2 is covered by Remote Settings sync r=android-reviewers,npoon\n\n`RemoteSettingsService::sync()` in application-services iterates `active_clients()`,\nwhich upgrades a `Weak` reference per client and prunes the ones that no longer\nresolve. `SerpTelemetryRepository` creates its client in its constructor, and both\n`Core` and Focus's `GleanMetricsService` constructed the repository as a temporary\ninside a startup coroutine, keeping only the resulting provider list, which holds no\nreference back to it. The repository was therefore collected shortly after startup\nand `search-telemetry-v2` was skipped by every sync, leaving the provider list pinned\nto the dump packaged with the megazord. `SearchMiddleware` already avoids this by\nholding its `search-config-icons` client in a field.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332994\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/telemetry/GleanMetricsService.kt"], "git_node": "491452d61fc2cbf4dc27ac899f4b0dff618ba0ff", "git_parents": ["1b510cdbc687bc789cb19459f65b8741c0e06443"], "node": "777548bba7baae9f1f8b7f41cd2d427a68a5e772", "parents": ["85f3a0acd9224675ddfd0bc0eacd970f5d3e9697"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2081710 - Stop adding telemetry and xpcom/base to every Linux IPC consumer's include path. r=ipc-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333623\n", "files": ["ipc/chromium/chromium-config.mozbuild"], "git_node": "b0dec618dc5d00cb69ecf429760626cd40d08682", "git_parents": ["491452d61fc2cbf4dc27ac899f4b0dff618ba0ff"], "node": "8341e8569102c609a6dacc4bed7c2feb82d5cac0", "parents": ["777548bba7baae9f1f8b7f41cd2d427a68a5e772"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079614 - [customizable-menu] Support sandboxed custom tabs r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333249\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactory.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuTarget.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProviderTest.kt"], "git_node": "ebed9843171426378332d2caf9c8e6850143ac61", "git_parents": ["b0dec618dc5d00cb69ecf429760626cd40d08682"], "node": "be53836f4382bdc3e376984d5d5c2c25b5c59574", "parents": ["8341e8569102c609a6dacc4bed7c2feb82d5cac0"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076225 - Parse web-platform-tests metadata tags like wptmanifest in TestResolver. r=taskgraph-reviewers,ahal,jgraham,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329632\n", "files": ["testing/mozbase/moztest/moztest/resolve.py", "testing/mozbase/moztest/tests/test_resolve.py"], "git_node": "1840c61b7e6750130879757cbe65761a4b58c8e5", "git_parents": ["ebed9843171426378332d2caf9c8e6850143ac61"], "node": "8274e5382202eda2bba75823051eb9becea840f5", "parents": ["be53836f4382bdc3e376984d5d5c2c25b5c59574"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2081406 - chore(rust): update `objc2` 0.6.3 \u2192 0.6.5 r=supply-chain-reviewers,webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333551\n", "files": ["Cargo.lock", "supply-chain/audits.toml", "third_party/rust/objc2/.cargo-checksum.json", "third_party/rust/objc2/.cargo_vcs_info.json", "third_party/rust/objc2/CHANGELOG.md", "third_party/rust/objc2/Cargo.lock", "third_party/rust/objc2/Cargo.toml", "third_party/rust/objc2/Cargo.toml.orig", "third_party/rust/objc2/src/__macro_helpers/common_selectors.rs", "third_party/rust/objc2/src/__macro_helpers/define_class.rs", "third_party/rust/objc2/src/__macro_helpers/defined_ivars.rs", "third_party/rust/objc2/src/__macro_helpers/mod.rs", "third_party/rust/objc2/src/lib.rs", "third_party/rust/objc2/src/macros/define_class.rs", "third_party/rust/objc2/src/macros/mod.rs", "third_party/rust/objc2/src/rc/retained.rs", "third_party/rust/objc2/tests/define_class.rs"], "git_node": "bfb11933e1718176eb547303f4029e3d072ec5e0", "git_parents": ["1840c61b7e6750130879757cbe65761a4b58c8e5"], "node": "dd3fcd09335c4e4f161471a71a25ddf7beadea04", "parents": ["8274e5382202eda2bba75823051eb9becea840f5"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049775 - Accept GitHub commit URLs as the ping revision in test_TelemetrySession.js, r=TravisLong\n\nThe build writes MOZ_SOURCE_URL as \u003crepo\u003e/commit/\u003csha\u003e for git checkouts\n(build/variables.py), so the revision info field is a GitHub URL on\ngit-backed builds and test_saveLoadPing fails on every platform. Accept\nthat form next to the hg.mozilla.org one, and drop the stray g flag that\nmade RegExp.test stateful.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332896\n", "files": ["toolkit/components/telemetry/tests/unit/test_TelemetrySession.js"], "git_node": "372054806763ea318202cde0a3a3a887c527df9a", "git_parents": ["bfb11933e1718176eb547303f4029e3d072ec5e0"], "node": "95d539dcfca5cec7faf6ea44f385ab9707fa193a", "parents": ["dd3fcd09335c4e4f161471a71a25ddf7beadea04"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080878 - Run the test, mochitest, reftest and web-platform-tests kinds on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nThese four kinds carry `run-on-repo-type: [hg]` in their task-defaults, so\nno test task is scheduled on a git-backed push. Test tasks have no source\ncheckout, so removing the guard only changes scheduling.\n\nVerified on staging-firefox: a 63-task sample across linux, windows, mac and\nandroid (xpcshell, mochitest, reftest, crashtest, jsreftest,\nweb-platform-tests, cppunit, gtest, marionette, telemetry-tests-client,\nfirefox-ui) is green with the test_TelemetrySession.js fix from\nbug 2049775 applied; the one remaining red was the known mac xpcshell\nintermittent from bug 2049776, green on rerun.\n\nDepends on D332896\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332904\n", "files": ["taskcluster/kinds/mochitest/kind.yml", "taskcluster/kinds/reftest/kind.yml", "taskcluster/kinds/test/kind.yml", "taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "0707610ebb5925caedf3ef9a53297533586f00c3", "git_parents": ["372054806763ea318202cde0a3a3a887c527df9a"], "node": "0cd0ed18bcb3501c92d68803dca144d8db2a4a27", "parents": ["95d539dcfca5cec7faf6ea44f385ab9707fa193a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081216 - Stop writing into the test directory in the migration xpcshell tests, r=migration-reviewers,niklas,mconley.\n\nThe tests used the test directory as a fake home (chromefiles/) and modified the checked-in Library/ and AppData/ fixtures in place, so tests running in parallel in the same directory collided. Use the per-test temporary directory instead, copying the fixtures there when a test needs to modify them, and remove the run-sequentially annotations that were working around this. test_Chrome_corrupt_history.js and test_Chrome_formdata.js also relied on a 'Local State' file left behind by test_Chrome_bookmarks.js, so they now write their own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333294\n", "files": ["browser/components/migration/tests/unit/head_migration.js", "browser/components/migration/tests/unit/test_360seMigrationUtils.js", "browser/components/migration/tests/unit/test_ChromeMigrationUtils_path.js", "browser/components/migration/tests/unit/test_ChromeMigrationUtils_path_chromium_snap.js", "browser/components/migration/tests/unit/test_Chrome_bookmarks.js", "browser/components/migration/tests/unit/test_Chrome_corrupt_history.js", "browser/components/migration/tests/unit/test_Chrome_credit_cards.js", "browser/components/migration/tests/unit/test_Chrome_formdata.js", "browser/components/migration/tests/unit/test_Chrome_history.js", "browser/components/migration/tests/unit/test_Chrome_passwords.js", "browser/components/migration/tests/unit/test_Safari_history.js", "browser/components/migration/tests/unit/test_Safari_history_strange_entries.js", "browser/components/migration/tests/unit/xpcshell.toml"], "git_node": "ba2521c08bb5c15e1673cc0d9e23610afb2edb39", "git_parents": ["0707610ebb5925caedf3ef9a53297533586f00c3"], "node": "c4f3934bce65c69494ba4a4ac3827677495bc79d", "parents": ["0cd0ed18bcb3501c92d68803dca144d8db2a4a27"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077162 - Remove obsolete local OTS patch. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333589\n", "files": ["gfx/ots/moz.yaml", "gfx/ots/ots-cff-charstring-ops-limit.patch"], "git_node": "81cf801eb5c4d13d9eda9548f796dabf9836f89a", "git_parents": ["ba2521c08bb5c15e1673cc0d9e23610afb2edb39"], "node": "ee0cd29cd4add6ebdf1a105cdd86599233a87d7a", "parents": ["c4f3934bce65c69494ba4a4ac3827677495bc79d"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077162 - Vendor current OTS tip from upstream. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333592\n", "files": ["gfx/ots/include/opentype-sanitiser.h", "gfx/ots/moz.yaml", "gfx/ots/src/glat.cc", "gfx/ots/src/glyf.cc", "gfx/ots/src/ots.cc", "gfx/ots/src/silf.cc"], "git_node": "f3afc6070391e920c60a0b6212aa44351bff428f", "git_parents": ["81cf801eb5c4d13d9eda9548f796dabf9836f89a"], "node": "16cf44268d156a7e0584b477fb073eb6f39a0f28", "parents": ["ee0cd29cd4add6ebdf1a105cdd86599233a87d7a"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077162 - Re-apply local OTS patches. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333593\n", "files": ["gfx/ots/include/opentype-sanitiser.h", "gfx/ots/src/glat.cc", "gfx/ots/src/ots.cc", "gfx/ots/src/silf.cc"], "git_node": "34ae62af242280ddafd049af823fa6ed3bcafc7b", "git_parents": ["f3afc6070391e920c60a0b6212aa44351bff428f"], "node": "29556e4db34975eb08dd3b3cbc14ab4678f02955", "parents": ["16cf44268d156a7e0584b477fb073eb6f39a0f28"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1721763 - Do not mark a distribution add-on as installed when it fails signature verification. r=extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333720\n", "files": ["toolkit/mozapps/extensions/internal/XPIInstall.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_distribution.js"], "git_node": "a45db0dd1294e969dc87bb8e3aa2959169206924", "git_parents": ["34ae62af242280ddafd049af823fa6ed3bcafc7b"], "node": "24b39d495044ed00240dc50d85604984d71063ca", "parents": ["29556e4db34975eb08dd3b3cbc14ab4678f02955"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch"