atform/mozilla/tests/webdriver/bidi/conftest.py", "testing/web-platform/mozilla/tests/webdriver/bidi/emulation/set_locale_override/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/external/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/external/permissions/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/external/permissions/set_permission/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/external/permissions/set_permission/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/input/perform_actions/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/network/add_data_collector/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/network/add_intercept/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/network/set_extra_headers/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/network/set_extra_headers/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/script/add_preload_script/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/script/add_preload_script/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/script/evaluate/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/session/subscribe/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/session/subscribe/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/storage/get_cookies/container_isolation.py", "testing/web-platform/mozilla/tests/webdriver/bidi/support/container_isolation.py"], "git_node": "680e45225760e61028b225aa99e25e89d16c2944", "git_parents": ["66831c33f409bed3ca96a7e0c0d1cb0d0975a62d"], "node": "f53fb54d8ee9db20660afa1e2bff1bfb3fce0dcb", "parents": ["686192d822b6a8d83458ad31a63f0a6faee7e96f"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071519 - Always record the session_restore.number_of* counts and 0 window session restores. r=sessionstore-reviewers,sclements\n\n- restore complete in StartupPerformance only records durations when there's been (eager) tabs created\n- but always records window and tab/eager-tab counts so we catch the 0 values\n- a restore that opens 0 windows was previously not recorded because the deadline timer only starts per restored window, so sessionstore-windows-restored is now watched as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333437\n", "files": ["browser/components/sessionstore/StartupPerformance.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_restore_counts.py"], "git_node": "2730193fa33812c140d8cdf697246550169994bb", "git_parents": ["680e45225760e61028b225aa99e25e89d16c2944"], "node": "a22a87c9a20868e31e5eb0639fc094acbad7aba4", "parents": ["f53fb54d8ee9db20660afa1e2bff1bfb3fce0dcb"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070663 - Add the moz-widget custom element. r=mconley,nina-py\n\n- Adds standard widget sizes and card styling.\n- Widget content can come from slotted elements or framed content loaded from `src`.\n- Loads framed content in a remote browser in chrome or iframe in content.\n- When using a browser element, extension content is loaded using the extension\u2019s browsing context group.\n- Adds Storybook documentation and chrome tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327912\n", "files": ["browser/components/moz.build", "browser/components/storybook/.storybook/main.js", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/moz.build", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html"], "git_node": "2d3e30952fd6034c69627dc260be437910225ffd", "git_parents": ["2730193fa33812c140d8cdf697246550169994bb"], "node": "738671c4e2e98f8d2ed7702d5c5858e029f585a0", "parents": ["a22a87c9a20868e31e5eb0639fc094acbad7aba4"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070684 - Add a header component and slot to moz-widget. r=nina-py\n\n- Adds a `moz-widget-header` component with a heading and `leading` and `trailing` slots\n- Adds a `header` slot to moz-widget for the `moz-widget-header`\n- Adds a `padded` attribute to moz-widget to inset and round the content\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328015\n", "files": ["browser/components/widgets/content/moz-widget-header.css", "browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_moz_widget.html", "browser/components/widgets/tests/chrome/test_moz_widget_header.html"], "git_node": "43a36fb7232d8936a7d84104f9d8453d21041988", "git_parents": ["2d3e30952fd6034c69627dc260be437910225ffd"], "node": "df316cd29e947da566f07ea3c3bacf3b8dc6caaa", "parents": ["738671c4e2e98f8d2ed7702d5c5858e029f585a0"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070709 - Add WidgetManager to track the widgets registered by extensions. r=mconley\n\n- Adds a `WidgetManager` singleton that stores one widget per extension id.\n- Emits \"change\" at init and on register and unregister with the IDs of the updated widgets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329352\n", "files": ["browser/components/BrowserComponents.manifest", "toolkit/components/moz.build", "toolkit/components/widgets/WidgetManager.sys.mjs", "toolkit/components/widgets/moz.build", "toolkit/components/widgets/tests/xpcshell/test_WidgetManager.js", "toolkit/components/widgets/tests/xpcshell/xpcshell.toml"], "git_node": "0b00e1e89c4f18720eb5e3579ef92935d1fd53db", "git_parents": ["43a36fb7232d8936a7d84104f9d8453d21041988"], "node": "412a195099ffeb946565815d04903ce4ce5c1f81", "parents": ["df316cd29e947da566f07ea3c3bacf3b8dc6caaa"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074341 - Add ExtensionWidgetsFeed for widgets provided by extensions. r=mconley,ckerschb\n\n- Adds `src` and `extensionID` to the config for widgets.\n- Widgets with URL in `src` set will render using the `moz-widget` component with that src set on the internal iframe.\n- ExtensionWidgetsFeed updates on WidgetManager changes.\n- Extension widgets get `src` from WidgetManager.\n- Widgets without a registered extension widget aren't shown.\n- Extension widgets use the extension's name as their toggle label.\n- Applies the drag pointer-events and cell sizing rules to `moz-widget`.\n- Allows `moz-extension:` in the `frame-src` of about:newtab and about:home, limited to privileged extensions by Bug 2070235.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328690\n", "files": ["browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/useWidgetLabels.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_WidgetWrapper.scss", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/data/content/abouthomecache/page.html.template", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/ExtensionWidgetsFeed.sys.mjs", "browser/extensions/newtab/prerendered/activity-stream-debug.html", "browser/extensions/newtab/prerendered/activity-stream-noscripts.html", "browser/extensions/newtab/prerendered/activity-stream.html", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/xpcshell/test_ExtensionWidgetsFeed.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "browser/extensions/newtab/test/xpcshell/xpcshell.toml", "dom/security/nsContentSecurityUtils.cpp"], "git_node": "c06dab190a66484abe328d3eab273522dc0ea774", "git_parents": ["0b00e1e89c4f18720eb5e3579ef92935d1fd53db"], "node": "5bebde00c0ec2c83736bba221f792b97f30cfdac", "parents": ["412a195099ffeb946565815d04903ce4ce5c1f81"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079959 - Include the ExtensionWidgets slice when getting all widgets. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332214\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx"], "git_node": "2139e08794d8aadea779ea4a109617609b938644", "git_parents": ["c06dab190a66484abe328d3eab273522dc0ea774"], "node": "7ef041dec722af15e770315b024840dbb01cb92e", "parents": ["5bebde00c0ec2c83736bba221f792b97f30cfdac"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070689 - Add a menu button and slot to moz-widget-header. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331840\n", "files": ["browser/components/widgets/content/moz-widget-header.css", "browser/components/widgets/content/moz-widget-header.mjs", "browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/tests/chrome/test_moz_widget.html", "browser/components/widgets/tests/chrome/test_moz_widget_header.html"], "git_node": "3d3c7fcdc711829f50565f2f92210c0d5ce15c59", "git_parents": ["2139e08794d8aadea779ea4a109617609b938644"], "node": "a800b8c2fa837ffdc8dadfed5b6358181ab5a843", "parents": ["7ef041dec722af15e770315b024840dbb01cb92e"], "tags": []}, {"author": "Fluorescent \u003cmozbugzilla.mushily885@passmail.net\u003e", "branch": "default", "desc": "Bug 2082173 - Add an option to turn off JIT context initialization in non-main processes; r=spidermonkey-reviewers,mgaudet\n\ncurrently, firefox crashes when running in a jitless environment (e.g., GrapheneOS\nwithout a compatibility flag enabled, GNU/Linux with sebool deny_execmem=1) because\nit always tries to initialize a jitted context and cannot map executable pages when\ndoing so.\n\nthis fixes it by adding an option `javascript.options.other_processes_disable_jit'\nthat disables jit initialization in all other processes (like the current flag\n`javascript.options.main_process_disable_jit').\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333970\n", "files": ["js/xpconnect/src/nsXPConnect.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "ceb1388446613591f5c0b4184fb39a78442fc04a", "git_parents": ["3d3c7fcdc711829f50565f2f92210c0d5ce15c59"], "node": "a9caaf818ec2d7937352a5d8c6d6cc8a20c130a6", "parents": ["a800b8c2fa837ffdc8dadfed5b6358181ab5a843"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074214 - Provide location data for Smart Window weather integration r=bjohns\" as requested by @nordzilla for being landed without approval.\n\nThis reverts commit c60b5ea977a83183b0a2740e124f07c96079edf3.\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/SmartWindowLocation.sys.mjs", "browser/components/aiwindow/models/moz.build", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js", "browser/components/aiwindow/models/tests/browser/browser_smartwindow_location.js", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs"], "git_node": "661f548890f7b1952e6659ab399fb05959bb6933", "git_parents": ["ceb1388446613591f5c0b4184fb39a78442fc04a"], "node": "d2e97f87c072c660c002827396e069174661c26e", "parents": ["a9caaf818ec2d7937352a5d8c6d6cc8a20c130a6"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055405 part 8: Fix outline titles now that glyph source text is provided to SkPDF. r=gfx-reviewers,accessibility-platform-reviewers,lsalzman,eeejay\" for causing wpt failures.\n\nThis reverts commit 77140fd08a321811c0df4e342ac9afec22489bfc.\n\nThis reverts commit 31fced352fbf9ab2155b87237b3773b3e4ca030f.\n\nThis reverts commit b807edd9820819e20fcb01