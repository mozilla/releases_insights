s:173127:"{
"lastpushid": 1568,
"pushes": {"11": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 4a8666238269bba3dcccc95812d13d2c8abd9252 with FIREFOX_115_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "ae2e07969260bb861e3eca35f89ffa9f95882af1", "parents": ["4a8666238269bba3dcccc95812d13d2c8abd9252"], "tags": []}], "date": 1688063226, "git_changesets": [null], "user": "ffxbld"}, "12": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "493b73f947401a32319742161aaec9682ea41c42", "parents": ["ae2e07969260bb861e3eca35f89ffa9f95882af1"], "tags": []}], "date": 1688460296, "git_changesets": [null], "user": "ffxbld-merge"}, "13": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 4a8666238269bba3dcccc95812d13d2c8abd9252 with FIREFOX_115_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "30207235c49f25820293a732f941ab468befeb20", "parents": ["493b73f947401a32319742161aaec9682ea41c42"], "tags": []}], "date": 1688475639, "git_changesets": [null], "user": "ffxbld"}, "14": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182884", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "bf80e425089f8a30ffbcb706a9879e51ed853175", "parents": ["30207235c49f25820293a732f941ab468befeb20"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1840700 - Make `Selection::AddRangeAndSelectFramesAndNotifyListenersInternal()` update interline position even if it does nothing r=jjaschke, a=dsmith\n\nIt always set to \"start of next line\" when new range was added.  However,\nafter bug 1815802, it does nothing when adding range is one of its ranges.\nTherefore, if interline position is set to \"end of line\" by our internal\ncode, like editor, `getSelection().addRange(getSelection().getRangeAt(0))`\nkeeps the last interline position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182300", "files": ["dom/base/Selection.cpp", "layout/base/tests/interlinePosition-after-Selection-addRange-ref.html", "layout/base/tests/interlinePosition-after-Selection-addRange.html", "layout/base/tests/mochitest.ini", "layout/base/tests/test_reftests_with_caret.html"], "git_node": null, "git_parents": [null], "node": "f15ac4f8bfd32bc5530f08e7b9f10e5b7fa6e3fa", "parents": ["bf80e425089f8a30ffbcb706a9879e51ed853175"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1840804 - Make `TextEditor::OnBlur` stop finalizing `Selection` if new element already gets focus r=m_kato, a=dsmith\n\nBefore bug 1770874, `EditorBase::OnBlur` checked that for both `TextEditor`\nand `HTMLEditor`.  However, accidentally, I removed the check from `TextEditor`.\nTherefore, a call of `EditorBase::FinalizeSelection()` will hide the caret\neven after another editor gets focus.\n\nTherefore, this patch just take it back into `TextEditor::OnBlur`.\n\nNote that I don't think the design mode handling is required there because\n`TextEditor`s shouldn't be created in the design mode document.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182468", "files": ["editor/libeditor/TextEditor.cpp", "layout/base/tests/collapse-selection-into-editing-host-during-blur-of-input-ref.html", "layout/base/tests/collapse-selection-into-editing-host-during-blur-of-input.html", "layout/base/tests/mochitest.ini", "layout/base/tests/test_reftests_with_caret.html"], "git_node": null, "git_parents": [null], "node": "637a2f9a456b0e1c630285637e1558436ed963a1", "parents": ["f15ac4f8bfd32bc5530f08e7b9f10e5b7fa6e3fa"], "tags": []}, {"author": "Zhao Jiazhong \u003czhaojiazhong-hf@loongson.cn\u003e", "branch": "default", "desc": "Bug 1836708 - [loong64][mips64] Fix register conflict in MulI64. r=jandem, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181978", "files": ["js/src/jit-test/tests/wasm/regress/bug1836708.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/mips-shared/CodeGenerator-mips-shared.cpp"], "git_node": null, "git_parents": [null], "node": "9e4289ab7c39403990c616e8b146439b2e587f09", "parents": ["637a2f9a456b0e1c630285637e1558436ed963a1"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1824420 - r=nalexander, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182143", "files": ["browser/installer/windows/nsis/installer.nsi", "browser/installer/windows/nsis/uninstaller.nsi", "browser/modules/BackgroundTask_install.sys.mjs", "browser/modules/BackgroundTask_uninstall.sys.mjs", "browser/modules/moz.build", "toolkit/mozapps/installer/windows/nsis/common.nsh", "toolkit/mozapps/update/UpdateService.sys.mjs", "toolkit/mozapps/update/nsIUpdateService.idl"], "git_node": null, "git_parents": [null], "node": "5ce3965048630a4ac183277b178fe68d2afad045", "parents": ["9e4289ab7c39403990c616e8b146439b2e587f09"], "tags": []}], "date": 1688651920, "git_changesets": [null, null, null, null, null], "user": "dsmith@mozilla.com"}, "15": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Set version to 115.0.1 a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "75499466411d130b8e949829405e131cfdc23472", "parents": ["4a8666238269bba3dcccc95812d13d2c8abd9252"], "tags": []}], "date": 1688672053, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "16": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1837242 - Fix the DLL blocklist code for older versions of Windows. r=gstoll, a=dmeehan\n\nWhile fixing a crash in bug 1733532, we accidentally broke the DLL\nblocklist on older versions of Windows (Windows 7, some versions\nof Windows 10, and possibly Windows 8 and 8.1). This is currently\npreventing us from mitigating crashes with third-party injected DLLs, in\nparticular the crash incident from bug 1837242. Considering the volumes\ninvolved, let's temporarily reintroduce bug 1733532 to ensure everyone\nhas a working blocklist, and deal with bug 1733532 later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182917", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "mozglue/misc/NativeNt.h"], "git_node": null, "git_parents": [null], "node": "cdb5fb7c2c9c823be04e0a265f3e27e1cd64c362", "parents": ["75499466411d130b8e949829405e131cfdc23472"], "tags": ["FIREFOX_115_0_1esr_BUILD1", "FIREFOX_115_0_1esr_RELEASE"]}], "date": 1688673617, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "17": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1837242 - Fix the DLL blocklist code for older versions of Windows. r=gstoll, a=dmeehan\n\nWhile fixing a crash in bug 1733532, we accidentally broke the DLL\nblocklist on older versions of Windows (Windows 7, some versions\nof Windows 10, and possibly Windows 8 and 8.1). This is currently\npreventing us from mitigating crashes with third-party injected DLLs, in\nparticular the crash incident from bug 1837242. Considering the volumes\ninvolved, let's temporarily reintroduce bug 1733532 to ensure everyone\nhas a working blocklist, and deal with bug 1733532 later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182917", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "mozglue/misc/NativeNt.h"], "git_node": null, "git_parents": [null], "node": "f3068b8a97f831057dbb7624b6ff5ce628e194ec", "parents": ["5ce3965048630a4ac183277b178fe68d2afad045"], "tags": []}], "date": 1688673999, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "18": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cdb5fb7c2c9c823be04e0a265f3e27e1cd64c362 with FIREFOX_115_0_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "d5bed4e01fe450fd70678e92cf95ae1546c37385", "parents": ["f3068b8a97f831057dbb7624b6ff5ce628e194ec"], "tags": []}], "date": 1688682527, "git_changesets": [null], "user": "ffxbld"}, "19": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cdb5fb7c2c9c823be04e0a265f3e27e1cd64c362 with FIREFOX_115_0_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "11a822fc756919e5d4ddf8f4e0ff8f137276cfe0", "parents": ["d5bed4e01fe450fd70678e92cf95ae1546c37385"], "tags": []}], "date": 1688736946, "git_changesets": [null], "user": "ffxbld"}, "20": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1841660 - Fix potential deadlock waiting for StartupCache ThreadedPrefetch, r=jesup a=RyanVM\n\nIn a previous change to this logic, we missed a hidden early return in\nthe `MMAP_FAULT_HANDLER_CATCH()` macro which can early return on both\nLinux and Windows. If this is hit, we could end up blocking at various\npoints waiting for the StartupCache to be prefetched.\n\nThis patch changes the logic to notify to happen in a ScopeExit instead,\nensuring that it'll happen on all return paths.\n\nIn addition, there was another potential deadlock due to the\nThreadedPrefetch thread acquiring mTableLock. This was fixed by passing\nin the pointers in the runnable instead. This should be OK as we are\nmaking sure to block on ThreadedPrefetch before we clear the startup\ndata already.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182732", "files": ["startupcache/StartupCache.cpp", "startupcache/StartupCache.h"], "git_node": null, "git_parents": [null], "node": "f715298e9a6a78c71fcd2615f1b61da6de744b96", "parents": ["11a822fc756919e5d4ddf8f4e0ff8f137276cfe0"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1838117 - Reject JAR entries that don't inflate to the correct size. r=jesup, a=RyanVM\n\n- Adds pref for whether to enforce size match with central-\u003eorglen\n- Checks return code of inflateEnd and returns error if it's not Z_OK\n- Also enter the finished block if mZs.total_out \u003e mOutSize\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181458", "files": ["modules/libjar/nsJARInputStream.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "695a9dd49876a46d00e7e9e63ca28faba33f6b5d", "parents": ["f715298e9a6a78c71fcd2615f1b61da6de744b96"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840890 - Reorder code in _cairo_tag_stack_pop. r=gfx-reviewers,jrmuizel a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182469", "files": ["gfx/cairo/cairo/src/cairo-tag-stack.c"], "git_node": null, "git_parents": [null], "node": "56f7bcb734e91ab04d0c3131f1724b978b6e6213", "parents": ["695a9dd49876a46d00e7e9e63ca28faba33f6b5d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1836473 - menulist[popuponly] rule should also remove padding. r=Gijs, a=RyanVM\n\nOtherwise menulists might unexpectedly appear.\n\nThis is an issue for Thunderbird. Trying to switch printers in a print\ndialog causes stuff to shift in current Thunderbird Daily.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179811", "files": ["toolkit/content/xul.css"], "git_node": null, "git_parents": [null], "node": "b64e072af23b430a7efc071a0c4f6f5e5f7be6ef", "parents": ["56f7bcb734e91ab04d0c3131f1724b978b6e6213"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838756 - do not adjust timestamp again for samples, which has been adjusted, when pushing them back to the audio queue. r=padenot, a=RyanVM\n\nWhen seamless looping is on, sample's timestamp would only be adjusted\nwhen they first get pushed into the media queue.\n\nWhen re-queuing sample back to the audio queue from the\n`mProcessedSPSCQueue`, we don't need to apply timestamp adjustment\nagain. Otherwise, it would result in incorrect audio time so that the\nAudioSink would never discard samples [1] during muting, causing audio\nbeing delayed.\n\n[1]\nhttps://searchfox.org/mozilla-central/rev/d307d4d9f06dab6d16e963a4318e5e8ff4899141/dom/media/mediasink/AudioSinkWrapper.cpp#159\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181817", "files": ["dom/media/MediaQueue.h", "dom/media/mediasink/AudioSink.cpp"], "git_node": null, "git_parents": [null], "node": "d4c67edf18f602fe9ba73752bf00f3dbd8fba334", "parents": ["b64e072af23b430a7efc071a0c4f6f5e5f7be6ef"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1841197 - Undefine the mips builtin macro on mips in skia. r=gfx-reviewers,lsalzman a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182536", "files": ["gfx/skia/generate_mozbuild.py", "gfx/skia/moz.build"], "git_node": null, "git_parents": [null], "node": "12ce28270176246f1cad1f4589ff86f000bcb891", "parents": ["d4c67edf18f602fe9ba73752bf00f3dbd8fba334"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1841199 - Work around tail-call optimization not happening on mips* and ppc64. r=gfx-reviewers,lsalzman a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182686", "files": ["gfx/skia/moz.build"], "git_node": null, "git_parents": [null], "node": "4e22a21e3f97bfbed8e06b0f59c63cbe5da70c12", "parents": ["12ce28270176246f1cad1f4589ff86f000bcb891"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1841250 - Always skip first code page on Windows 64-bit platforms. r=iain, a=RyanVM\n\nOn Win64 platforms (`NEED_JIT_UNWIND_HANDLING`), we reserve an extra page in\n`ReserveProcessExecutableMemory` for the generated exception handler.\n\nBefore this patch we'd skip the first page if we generated an exception handler there.\nIf we didn't generate an exception handler (for example JS shell builds on ARM64)\nwe'd not skip the first page and instead have an unused page at the end of the JIT\ncode region.\n\nWith this patch we always skip the first page if we reserved one. This fixes an\nassertion failure in `UnregisterJitCodeRegion` for Windows ARM64 JS shell builds\nbecause the size didn't match what we passed to `RegisterJitCodeRegion`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182726", "files": ["js/src/jit/ProcessExecutableMemory.cpp"], "git_node": null, "git_parents": [null], "node": "06a2542ef431f058871ff76aabe64fa71b87da99", "parents": ["4e22a21e3f97bfbed8e06b0f59c63cbe5da70c12"], "tags": []}, {"author": "Jonathan Kingston \u003cjonathan@jooped.co.uk\u003e", "branch": "default", "desc": "Bug 1836958 - Update DuckDuckGo favicon with latest version. r=Standard8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182679", "files": ["browser/components/newtab/data/content/tippytop/favicons/duckduckgo-com.ico", "browser/components/newtab/data/content/tippytop/images/duckduckgo-com@2x.svg", "browser/components/search/extensions/ddg/favicon.ico"], "git_node": null, "git_parents": [null], "node": "c420e703e75cbcd914b5d00afe23b4e1e910a498", "parents": ["06a2542ef431f058871ff76aabe64fa71b87da99"], "tags": []}], "date": 1688744752, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "21": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1842081 - Disable WebGPU WPT test suite on ESR115. r=jimb, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183015", "files": ["taskcluster/ci/test/web-platform.yml"], "git_node": null, "git_parents": [null], "node": "a2d2e0db31e3b6bc5a8bdb480bb00593a3ee93bd", "parents": ["c420e703e75cbcd914b5d00afe23b4e1e910a498"], "tags": []}, {"author": "sunil mayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 1823551 - add overflow check in nsDirIndexParser::OnDataAvailable(). r=necko-reviewers,valentin, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181874", "files": ["netwerk/streamconv/converters/nsDirIndexParser.cpp"], "git_node": null, "git_parents": [null], "node": "ac79cef2c5e2b8567e2fe6d0be73b83c16253de5", "parents": ["a2d2e0db31e3b6bc5a8bdb480bb00593a3ee93bd"], "tags": []}, {"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1839235 - Protect VideoBridgeChild's singleton with a StaticMutex r=lsalzman, a=RyanVM\n\nProtect  sVideoBridge like ImageBridgeChild::GetSingleton() to avoid race condition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181844", "files": ["gfx/layers/ipc/VideoBridgeChild.cpp"], "git_node": null, "git_parents": [null], "node": "28afebdab5721b1b851c2d6a2bc8a59fd51b0f7f", "parents": ["ac79cef2c5e2b8567e2fe6d0be73b83c16253de5"], "tags": []}], "date": 1688746740, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "22": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1842254 - Only schedule the webgl-ipc variant of mochitest-webgl1-ext on trunk. r=jmaher, a=test-only DONTBUILD", "files": ["taskcluster/ci/test/mochitest.yml"], "git_node": null, "git_parents": [null], "node": "3c5748f258f6e9d7ac32b3d2564d2c6e08e2eb5a", "parents": ["28afebdab5721b1b851c2d6a2bc8a59fd51b0f7f"], "tags": []}], "date": 1688828676, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "23": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Set version to 115.0.2, a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "01b9f3405caf419dba37b9e2e4eee2ad68bd0e3c", "parents": ["cdb5fb7c2c9c823be04e0a265f3e27e1cd64c362"], "tags": []}], "date": 1689004660, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "24": {"changesets": [{"author": "Robert Longson \u003clongsonr@gmail.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1840746 - SVG patternTransform translate uses wrong units r=emilio, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182618", "files": ["layout/svg/SVGPatternFrame.cpp", "testing/web-platform/tests/svg/pservers/reftests/pattern-transform-01.svg", "testing/web-platform/tests/svg/pservers/reftests/reference/pattern-transform-01-ref.svg"], "git_node": null, "git_parents": [null], "node": "5e419f99eb5bc8f0f951d2593f055bf2d678d768", "parents": ["01b9f3405caf419dba37b9e2e4eee2ad68bd0e3c"], "tags": []}, {"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1841382 - Zoom Controls Reset Button text is not aligned correctly when in tabstrip r=Itiel, a=dmeehan\n\nAnother way to fix this is to add flex-direction:column, if we need to keep '#zoom-reset-button \u003e .toolbarbutton-text' display:flex for some reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182621", "files": ["browser/base/content/browser.css", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": null, "git_parents": [null], "node": "849a54e80f41755bdfd5544142a11531967877cf", "parents": ["5e419f99eb5bc8f0f951d2593f055bf2d678d768"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1837700 - Fix ToShmem for empty ThinVec. r=jfkthame, a=dmeehan\n\nBug 1837700 comment 14 is right. I can reproduce it by toggling off\nscroll-anchoring by pref, and accessing:\n\n  data:text/html,\u003cdiv contenteditable\u003e\n\nSo that we load contenteditable.css which hits the issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182666", "files": ["servo/components/to_shmem/lib.rs"], "git_node": null, "git_parents": [null], "node": "39cc4fc768be69327d10a6ea766af82b44a3510e", "parents": ["849a54e80f41755bdfd5544142a11531967877cf"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1842368 - Force loading modules as image files for untrusted modules ping. r=gstoll, a=dmeehan\n\nWhen we prepare an untrusted modules ping, we currently let Windows\nchoose between loading the module as a data file or as an image file.\nHowever our code relies on the module being loaded as an image file,\nbecause we do RVA computations. We must use the proper flag\nLOAD_LIBRARY_AS_IMAGE_RESOURCE alone, which guarantees what we want:\nloading as an image file, but not for execution.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183076", "files": ["mozglue/baseprofiler/core/shared-libraries-win32.cc", "tools/profiler/core/shared-libraries-win32.cc"], "git_node": null, "git_parents": [null], "node": "3fed1b62aa07ae1547decda2c991fe1c688d8b9f", "parents": ["39cc4fc768be69327d10a6ea766af82b44a3510e"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1842368 - Enable test_ThirdPartyModulesPing.js on all branches. a=test-only", "files": ["toolkit/components/telemetry/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "34f09727017007d7b28a2d34f528da2982d4700a", "parents": ["3fed1b62aa07ae1547decda2c991fe1c688d8b9f"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1733532 - New attempt to avoid using stack buffers during calls to Thread32Next. r=gstoll, a=dmeehan\n\nThe previous attempt at avoiding the crash from bug 1733532 resulted in\nbreaking DLL blocklist code on older versions of Windows, in particular\nWindows 7, which led to a crash spike (see bug 1837242).\n\nThe detect executable DLL mappings, we must not look at the protection\nasked in the arguments of NtMapViewOfSection, but rather at the\nprotection that was used to create the section. We already do this\nthrough NtQueryVirtualMemory, but in a helper function rather than\ndirectly in patched_NtMapViewOfSection.\n\nBecause the helper function does not have MOZ_NO_STACK_PROTECTOR, it\ndoes not avoid stack cookie checks when NtMapViewOfSection is called\nfrom Thread32Next. To mitigate the crash from bug 1733532, we need to\nmove the call to NtQueryVirtualMemory to the main patched function, at\nthe (reasonable) cost of losing the stack cookie check on local\nvariable mbi since this function has MOZ_NO_STACK_PROTECTOR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182982", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp"], "git_node": null, "git_parents": [null], "node": "f327d181b3e388e8601c07479aed59804c2c8615", "parents": ["34f09727017007d7b28a2d34f528da2982d4700a"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1841982 - Only mark packets as EOF if the stream size is known in the MP3TrackDemuxer. r=media-playback-reviewers,chunmin, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182899", "files": ["dom/media/mp3/MP3Demuxer.cpp"], "git_node": null, "git_parents": [null], "node": "9060814fec5c8d4c98b191dd31e658aa17d21d8c", "parents": ["f327d181b3e388e8601c07479aed59804c2c8615"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1840804 - Make `TextEditor::OnBlur` stop finalizing `Selection` if new element already gets focus r=m_kato, a=dmeehan\n\nBefore bug 1770874, `EditorBase::OnBlur` checked that for both `TextEditor`\nand `HTMLEditor`.  However, accidentally, I removed the check from `TextEditor`.\nTherefore, a call of `EditorBase::FinalizeSelection()` will hide the caret\neven after another editor gets focus.\n\nTherefore, this patch just take it back into `TextEditor::OnBlur`.\n\nNote that I don't think the design mode handling is required there because\n`TextEditor`s shouldn't be created in the design mode document.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182468", "files": ["editor/libeditor/TextEditor.cpp", "layout/base/tests/collapse-selection-into-editing-host-during-blur-of-input-ref.html", "layout/base/tests/collapse-selection-into-editing-host-during-blur-of-input.html", "layout/base/tests/mochitest.ini", "layout/base/tests/test_reftests_with_caret.html"], "git_node": null, "git_parents": [null], "node": "d3c0aab5b0c78828b955062f5a29a41c2492e912", "parents": ["9060814fec5c8d4c98b191dd31e658aa17d21d8c"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1837429 - Rename hasShoppingTab to shoppingTabDisplayed - r=scunnane, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180346", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": null, "git_parents": [null], "node": "9063634e004fc8ce0df74558699c245f318f4f35", "parents": ["d3c0aab5b0c78828b955062f5a29a41c2492e912"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1833495 - Check if an ad is well above the possible viewable window - r=Standard8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181179", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/search/test/browser/browser_search_telemetry_adImpression_component.js", "browser/components/search/test/browser/searchTelemetryAd_components_carousel_hidden.html"], "git_node": null, "git_parents": [null], "node": "fe13597792dc9ff5078128fbb00556becbae2687", "parents": ["9063634e004fc8ce0df74558699c245f318f4f35"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1836507 - Prevent tab-history events from triggering a click event - r=Standard8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179966", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/browser/browser.ini", "browser/components/search/test/browser/browser_search_telemetry_engagement_cached_serp.js", "browser/components/search/test/browser/browser_search_telemetry_engagement_redirect.js", "browser/components/search/test/browser/redirect_ad.sjs", "browser/components/search/test/browser/searchTelemetryAd_adsLink_redirect.html", "browser/components/search/test/browser/searchTelemetryAd_components_text.html", "browser/components/search/test/browser/searchTelemetryAd_searchbox.html"], "git_node": null, "git_parents": [null], "node": "bbc453a2f286ec1d8012ebc05057406532afce18", "parents": ["fe13597792dc9ff5078128fbb00556becbae2687"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1839703: Move worker create into an Init() method r=nika, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182505", "files": ["dom/streams/UnderlyingSourceCallbackHelpers.cpp", "dom/streams/UnderlyingSourceCallbackHelpers.h"], "git_node": null, "git_parents": [null], "node": "7c3a2326c53a52ddad1a388a670bae3c61b65e2e", "parents": ["bbc453a2f286ec1d8012ebc05057406532afce18"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Bug 1841751 - Block instances of a malicious injected DLL causing startup crashes. r=gstoll, a=dmeehan\n\nWith bug 1832467 we have updated our Windows SDK version to 10.0.19041.\nAs a result, we now have a .retplne section in xul.dll, starting with\nFirefox 115. This is a section with PAGE_NOACCESS protection, so\naccessing it crashes the process.\n\nSome injected DLLs read the whole memory space dedicated to the xul.dll\nimage to search for patterns in it. When they hit the .retplne section,\nwe will crash. This happened for a legit product in bug 1837242, but\nalso for a malicious DLL in bug 1841751. This is a startup crash.\n\nThis changeset blocks the variants of this malicious DLL we know, to\neliminate the associated startup crash spike. Because the DLL does not\nuse a fixed name, we block by matching on the combination of version\nnumber + timestamp + image size, based on the values found in crash\nreports. We additionnally check for a checksum of 0 and the absence of\ndebug information, both of which are uncommon for legit production-ready\nDLLs; this thus helps further reduce the chances of collision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183096", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "mozglue/misc/NativeNt.h"], "git_node": null, "git_parents": [null], "node": "872b5aae170ffa755f89d0c6a9ebc380af677e9a", "parents": ["7c3a2326c53a52ddad1a388a670bae3c61b65e2e"], "tags": ["FIREFOX_115_0_2esr_BUILD1", "FIREFOX_115_0_2esr_RELEASE"]}], "date": 1689012199, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "25": {"changesets": [{"author": "Robert Longson \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 1840746 - SVG patternTransform translate uses wrong units r=emilio, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182618", "files": ["layout/svg/SVGPatternFrame.cpp", "testing/web-platform/tests/svg/pservers/reftests/pattern-transform-01.svg", "testing/web-platform/tests/svg/pservers/reftests/reference/pattern-transform-01-ref.svg"], "git_node": null, "git_parents": [null], "node": "96cc0bef834ce4c24c1bfaa222879091b50e9b26", "parents": ["3c5748f258f6e9d7ac32b3d2564d2c6e08e2eb5a"], "tags": []}, {"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "default", "desc": "Bug 1841382 - Zoom Controls Reset Button text is not aligned correctly when in tabstrip r=Itiel, a=dmeehan\n\nAnother way to fix this is to add flex-direction:column, if we need to keep '#zoom-reset-button \u003e .toolbarbutton-text' display:flex for some reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182621", "files": ["browser/base/content/browser.css", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": null, "git_parents": [null], "node": "0f60754acf97014449e02915489b3153074f4453", "parents": ["96cc0bef834ce4c24c1bfaa222879091b50e9b26"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1837700 - Fix ToShmem for empty ThinVec. r=jfkthame, a=dmeehan\n\nBug 1837700 comment 14 is right. I can reproduce it by toggling off\nscroll-anchoring by pref, and accessing:\n\n  data:text/html,\u003cdiv contenteditable\u003e\n\nSo that we load contenteditable.css which hits the issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182666", "files": ["servo/components/to_shmem/lib.rs"], "git_node": null, "git_parents": [null], "node": "a26bb62f85590763ead3a010cf7bccb99a343808", "parents": ["0f60754acf97014449e02915489b3153074f4453"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1842368 - Force loading modules as image files for untrusted modules ping. r=gstoll, a=dmeehan\n\nWhen we prepare an untrusted modules ping, we currently let Windows\nchoose between loading the module as a data file or as an image file.\nHowever our code relies on the module being loaded as an image file,\nbecause we do RVA computations. We must use the proper flag\nLOAD_LIBRARY_AS_IMAGE_RESOURCE alone, which guarantees what we want:\nloading as an image file, but not for execution.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183076", "files": ["mozglue/baseprofiler/core/shared-libraries-win32.cc", "tools/profiler/core/shared-libraries-win32.cc"], "git_node": null, "git_parents": [null], "node": "17ef7445a88add8afd326a415bbd93a6bbe9efd3", "parents": ["a26bb62f85590763ead3a010cf7bccb99a343808"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1842368 - Enable test_ThirdPartyModulesPing.js on all branches. a=test-only", "files": ["toolkit/components/telemetry/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "5d39eb73bc59711c662dd611363e9ff015b39b4d", "parents": ["17ef7445a88add8afd326a415bbd93a6bbe9efd3"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1733532 - New attempt to avoid using stack buffers during calls to Thread32Next. r=gstoll, a=dmeehan\n\nThe previous attempt at avoiding the crash from bug 1733532 resulted in\nbreaking DLL blocklist code on older versions of Windows, in particular\nWindows 7, which led to a crash spike (see bug 1837242).\n\nThe detect executable DLL mappings, we must not look at the protection\nasked in the arguments of NtMapViewOfSection, but rather at the\nprotection that was used to create the section. We already do this\nthrough NtQueryVirtualMemory, but in a helper function rather than\ndirectly in patched_NtMapViewOfSection.\n\nBecause the helper function does not have MOZ_NO_STACK_PROTECTOR, it\ndoes not avoid stack cookie checks when NtMapViewOfSection is called\nfrom Thread32Next. To mitigate the crash from bug 1733532, we need to\nmove the call to NtQueryVirtualMemory to the main patched function, at\nthe (reasonable) cost of losing the stack cookie check on local\nvariable mbi since this function has MOZ_NO_STACK_PROTECTOR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182982", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp"], "git_node": null, "git_parents": [null], "node": "08d45dd7217d4bd26df769a513f6c6d5a3bcdd18", "parents": ["5d39eb73bc59711c662dd611363e9ff015b39b4d"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1841982 - Only mark packets as EOF if the stream size is known in the MP3TrackDemuxer. r=media-playback-reviewers,chunmin, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182899", "files": ["dom/media/mp3/MP3Demuxer.cpp"], "git_node": null, "git_parents": [null], "node": "0f9aae15e883d34ea86a83185496e90bfa21e178", "parents": ["08d45dd7217d4bd26df769a513f6c6d5a3bcdd18"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1837429 - Rename hasShoppingTab to shoppingTabDisplayed - r=scunnane, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180346", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": null, "git_parents": [null], "node": "46d61356375ff2ede024bef77a19f659568e899f", "parents": ["0f9aae15e883d34ea86a83185496e90bfa21e178"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833495 - Check if an ad is well above the possible viewable window - r=Standard8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181179", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/search/test/browser/browser_search_telemetry_adImpression_component.js", "browser/components/search/test/browser/searchTelemetryAd_components_carousel_hidden.html"], "git_node": null, "git_parents": [null], "node": "f001fe269389233cb500c8e275f21d689a4360e8", "parents": ["46d61356375ff2ede024bef77a19f659568e899f"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1836507 - Prevent tab-history events from triggering a click event - r=Standard8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179966", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/browser/browser.ini", "browser/components/search/test/browser/browser_search_telemetry_engagement_cached_serp.js", "browser/components/search/test/browser/browser_search_telemetry_engagement_redirect.js", "browser/components/search/test/browser/redirect_ad.sjs", "browser/components/search/test/browser/searchTelemetryAd_adsLink_redirect.html", "browser/components/search/test/browser/searchTelemetryAd_components_text.html", "browser/components/search/test/browser/searchTelemetryAd_searchbox.html"], "git_node": null, "git_parents": [null], "node": "f6c512bba686a861c7d4cdb56daa95adc3c30d8f", "parents": ["f001fe269389233cb500c8e275f21d689a4360e8"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1839703: Move worker create into an Init() method r=nika, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182505", "files": ["dom/streams/UnderlyingSourceCallbackHelpers.cpp", "dom/streams/UnderlyingSourceCallbackHelpers.h"], "git_node": null, "git_parents": [null], "node": "4998d404a8952a8128311f14875b667df7e67dca", "parents": ["f6c512bba686a861c7d4cdb56daa95adc3c30d8f"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1841751 - Block instances of a malicious injected DLL causing startup crashes. r=gstoll, a=dmeehan\n\nWith bug 1832467 we have updated our Windows SDK version to 10.0.19041.\nAs a result, we now have a .retplne section in xul.dll, starting with\nFirefox 115. This is a section with PAGE_NOACCESS protection, so\naccessing it crashes the process.\n\nSome injected DLLs read the whole memory space dedicated to the xul.dll\nimage to search for patterns in it. When they hit the .retplne section,\nwe will crash. This happened for a legit product in bug 1837242, but\nalso for a malicious DLL in bug 1841751. This is a startup crash.\n\nThis changeset blocks the variants of this malicious DLL we know, to\neliminate the associated startup crash spike. Because the DLL does not\nuse a fixed name, we block by matching on the combination of version\nnumber + timestamp + image size, based on the values found in crash\nreports. We additionnally check for a checksum of 0 and the absence of\ndebug information, both of which are uncommon for legit production-ready\nDLLs; this thus helps further reduce the chances of collision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183096", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "mozglue/misc/NativeNt.h"], "git_node": null, "git_parents": [null], "node": "f1551ef129b14aaa3a590fa7e1347ec89b2e96ba", "parents": ["4998d404a8952a8128311f14875b667df7e67dca"], "tags": []}], "date": 1689015756, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "26": {"changesets": [{"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1839023 - Fix missing arm-specifc header  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D181738\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182710", "files": ["js/src/jit/shared/AtomicOperations-shared-jit.cpp"], "git_node": null, "git_parents": [null], "node": "340a8640da9fc18203d6ce5950afd52ee6e3f49b", "parents": ["f1551ef129b14aaa3a590fa7e1347ec89b2e96ba"], "tags": []}], "date": 1689017200, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "27": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 872b5aae170ffa755f89d0c6a9ebc380af677e9a with FIREFOX_115_0_2esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c42d74016a91f316c47ee5d92af184108ecb36d0", "parents": ["340a8640da9fc18203d6ce5950afd52ee6e3f49b"], "tags": []}], "date": 1689023215, "git_changesets": [null], "user": "ffxbld"}, "28": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183157", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "d2a7755ca2e3f62040fd53af278e9aac8081248e", "parents": ["c42d74016a91f316c47ee5d92af184108ecb36d0"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1838365 skip intermediate microseconds converting video frame start and end TimeUnits directly to TrackTime r=padenot, a=dsmith\n\nto avoid unnecessary rounding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181427", "files": ["dom/media/mediasink/DecodedStream.cpp"], "git_node": null, "git_parents": [null], "node": "11addd71dbbab172895b9ab148435c0aec6785ef", "parents": ["d2a7755ca2e3f62040fd53af278e9aac8081248e"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1838365 add some DecodedStream finished logging r=pehrsons,media-playback-reviewers,padenot, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181431", "files": ["dom/media/mediasink/DecodedStream.cpp"], "git_node": null, "git_parents": [null], "node": "b2f095f84acc5c508efe742d592a8f778d2338a7", "parents": ["11addd71dbbab172895b9ab148435c0aec6785ef"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1838365 use minimum TrackTime duration for extra end-of-track frame r=padenot,a=dsmith\n\nRounding could lead to a zero duration from the previous logic if\nmStartTime's denominator is not a multiple of the TrackRate.\n\nThe TimeStamp passed to WriteVideoToSegment usually corresponds to the aStart\nTimeUnit [1] (unless avoiding a previous overlapping frame), and when this was\nchanged from aEnd [2], no reason was given for leaving the TimeStamp for the\nEOS frame different [3], so the TimeStamp for the EOS frame now corresponds to\naStart rather than aEnd.\n\n[1] https://searchfox.org/mozilla-central/rev/3b707c8fd7e978eebf24279ee51ccf07895cfbcb/dom/media/mediasink/DecodedStream.cpp#974,982-984,991\n[2] https://hg.mozilla.org/mozilla-central/rev/7b980f1c50a127050f831b0a7d580eddc2939d27#l5.72\n[3] https://hg.mozilla.org/mozilla-central/rev/7b980f1c50a127050f831b0a7d580eddc2939d27#l5.97\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182556", "files": ["dom/media/mediasink/DecodedStream.cpp"], "git_node": null, "git_parents": [null], "node": "64177fa7d559200fcc6d93b264e62f43cc69c520", "parents": ["b2f095f84acc5c508efe742d592a8f778d2338a7"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1840002 - Ignore negative media duration found in container. r=alwu, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182165", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/test/crashtests/1840002.webm", "dom/media/test/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "484830acb17bc33dc2907a3b912d6b6f586d8748", "parents": ["64177fa7d559200fcc6d93b264e62f43cc69c520"], "tags": []}], "date": 1689033269, "git_changesets": [null, null, null, null, null], "user": "dsmith@mozilla.com"}, "29": {"changesets": [{"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1830461 - Allow to build webrtc on Linux/riscv64. r=webrtc-reviewers,ng,mjf,glandium a=RyanVM\n\nIf `use_sysroot` is false (see libwebrtc/build/config/sysroot.gni. true if\nGoogle's server has sysroot image), webrtc will causes build error since\n`rtc_use_pipewire` is false. But since `rtc_use_x11_extensions` is true,\nwe should include some dirs/files in source files.\n\nSo I add more MOZ_X11 condition for `rtc_use_x11_extensions`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D176752", "files": ["python/mozbuild/mozbuild/gn_processor.py", "toolkit/moz.configure"], "git_node": null, "git_parents": [null], "node": "656d05ecd6474ef9d7f22ff693330b1530253508", "parents": ["484830acb17bc33dc2907a3b912d6b6f586d8748"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1830461 - Allow to build webrtc on Linux/riscv64 - moz.build file updates. r=webrtc-reviewers,ng a=RyanVM\n\nDepends on D176752\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178854", "files": ["CLOBBER", "third_party/libwebrtc/common_audio/common_audio_c_gn/moz.build", "third_party/libwebrtc/common_audio/third_party/spl_sqrt_floor/spl_sqrt_floor_gn/moz.build", "third_party/libwebrtc/modules/desktop_capture/desktop_capture_gn/moz.build", "third_party/libwebrtc/modules/desktop_capture/primitives_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": null, "git_parents": [null], "node": "73f23aa3a12bef3d4b6b7a1f7b0cac34bcf0617b", "parents": ["656d05ecd6474ef9d7f22ff693330b1530253508"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1841203 - Stop building SkICC. r=gfx-reviewers,lsalzman a=RyanVM\n\nIt is not used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182538", "files": ["gfx/skia/generate_mozbuild.py", "gfx/skia/moz.build"], "git_node": null, "git_parents": [null], "node": "db609255e9263094dc90850bfb292d3aea2e3257", "parents": ["73f23aa3a12bef3d4b6b7a1f7b0cac34bcf0617b"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1841201 - Work around tail-call optimization not happening on mips*. r=markh, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182687", "files": ["toolkit/components/protobuf/moz.build"], "git_node": null, "git_parents": [null], "node": "cf70eede5d7ef34bd5ce85ac79a30d5ae891c2dd", "parents": ["db609255e9263094dc90850bfb292d3aea2e3257"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838323 - Disambiguate skvx when building with different arch options. r=glandium, a=RyanVM\n\nIt seems that GCC, under certain circumstances, does not completely inline code in the skvx namespace in Skia, even though the code specifies \"always_inline\". As a side-effect, it leaves around symbols that are generated with different architecture flags supplied. LTO then picks one of the symbols, at what may as well be random.\n\nThis could potentially be an issue under clang if it ever failed to inline.\n\nAs a workaround for both, we force skvx to exist in arch-specific namespaces, i.e. -Dskvx=skvx_foo, so that even in the worst case, no ambiguous symbols will be generated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182855", "files": ["gfx/skia/generate_mozbuild.py", "gfx/skia/moz.build"], "git_node": null, "git_parents": [null], "node": "db51a4ef54ed86b386dceb41c86ee983fa8be3b5", "parents": ["cf70eede5d7ef34bd5ce85ac79a30d5ae891c2dd"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1841577 - Don't set WEBRTC_ENABLE_AVX2 on platforms that don't have AVX2. r=mjf,webrtc-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182695", "files": ["third_party/libwebrtc/webrtc.gni"], "git_node": null, "git_parents": [null], "node": "2457a7c27329823013770a76947ee8e4f783fd5e", "parents": ["db51a4ef54ed86b386dceb41c86ee983fa8be3b5"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1841577 - Don't set WEBRTC_ENABLE_AVX2 on platforms that do