cbbc312552626ddeea1b9bf11dd", "parents": ["c565bf41b2194e874907ce5b31b20c673ae9a125"], "tags": []}], "date": 1783426171, "git_changesets": ["0a6a8b2b3d0c1c8a9303b9cf0f4d21298c5b2273"], "user": "dmeehan@mozilla.com"}, "1378": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046416: Ensure a hide event never occurs during a split show event.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D306672\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310548\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "537c77f7c6b931a86abcf2846e10b5662710cb99", "git_parents": ["0a6a8b2b3d0c1c8a9303b9cf0f4d21298c5b2273"], "node": "0059b0cb66c4e0dad43a3eb2a6517431c42641e3", "parents": ["c7c8a5f118096cbbc312552626ddeea1b9bf11dd"], "tags": []}], "date": 1783426200, "git_changesets": ["537c77f7c6b931a86abcf2846e10b5662710cb99"], "user": "dmeehan@mozilla.com"}, "1379": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2051653  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309978\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310545\n", "files": ["gfx/layers/d3d11/FenceD3D11.cpp", "gfx/layers/d3d11/FenceD3D11.h"], "git_node": "98b385f6139b2f854cd93df25913f1176c332e6c", "git_parents": ["537c77f7c6b931a86abcf2846e10b5662710cb99"], "node": "3d21ebeeb9f27a2249c2d42a7f092c94ea6523d2", "parents": ["0059b0cb66c4e0dad43a3eb2a6517431c42641e3"], "tags": []}], "date": 1783426242, "git_changesets": ["98b385f6139b2f854cd93df25913f1176c332e6c"], "user": "dmeehan@mozilla.com"}, "1380": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2045617 - Add some bounds checks to cairo_cff_font_read_fdselect.  a=dmeehan\n\nAttached to https://gitlab.freedesktop.org/cairo/cairo/-/work_items/967\nas well.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D306604\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310349\n", "files": ["gfx/cairo/cairo/src/cairo-cff-subset.c", "gfx/cairo/patches/0035-cff-fdselect-bounds.patch"], "git_node": "271fa24656a631752fa7fbed6f1e4b8dd14bd8a7", "git_parents": ["98b385f6139b2f854cd93df25913f1176c332e6c"], "node": "de9f7f7c4e43739e0d1ec24c0b2050c108d54af1", "parents": ["3d21ebeeb9f27a2249c2d42a7f092c94ea6523d2"], "tags": []}], "date": 1783426446, "git_changesets": ["271fa24656a631752fa7fbed6f1e4b8dd14bd8a7"], "user": "dmeehan@mozilla.com"}, "1381": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026301 - Synchronize ThreadSafeRequestHandle::mRunnable to fix cross-thread use-after-free  a=dmeehan DONTBUILD\n\nmRunnable was a plain RefPtr read on the main thread (GetCacheCreator and the\nother accessors) and cleared on the worker thread by ReleaseRequest() with no\nsynchronization. When the worker's store dropped the last reference to the\nshared ScriptLoaderRunnable, the main thread could dereference the already-freed\npointer, producing a heap-use-after-free.\n\nGuard mRunnable with a Mutex (enforced via MOZ_GUARDED_BY). ReleaseRequest() and\nthe new SetRunnable() mutate it under the lock, releasing the runnable outside\nthe lock so it is never destroyed while the mutex is held. Each main-thread\naccessor copies mRunnable into a local strong reference under the lock and bails\nif it was already released. GetCacheCreator() now returns a strong CacheCreator\nreference taken under the lock, so the caller keeps it alive across DeleteCache()\neven if the runnable is released on the worker thread afterwards.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307211\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310969\n", "files": ["dom/workers/ScriptLoader.cpp", "dom/workers/loader/CacheLoadHandler.cpp", "dom/workers/loader/NetworkLoadHandler.cpp", "dom/workers/loader/WorkerLoadContext.cpp", "dom/workers/loader/WorkerLoadContext.h"], "git_node": "0d6c3afe75939e7ba04bb7d8811ffafc78fa1aec", "git_parents": ["271fa24656a631752fa7fbed6f1e4b8dd14bd8a7"], "node": "ef07439b9ea7141411648e0e407f7686063d30a5", "parents": ["de9f7f7c4e43739e0d1ec24c0b2050c108d54af1"], "tags": []}], "date": 1783510844, "git_changesets": ["0d6c3afe75939e7ba04bb7d8811ffafc78fa1aec"], "user": "dmeehan@mozilla.com"}, "1382": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2045198 - Don't bother checking ancestors for constructed check.  a=dmeehan DONTBUILD\n\nSince we don't allow @import, we can't get there with a constructed\nancestor.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309844\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310859\n", "files": ["layout/style/ServoCSSRuleList.cpp", "layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h"], "git_node": "fa2cbef4ee57cc8869f7902c2f71ef20487d98eb", "git_parents": ["0d6c3afe75939e7ba04bb7d8811ffafc78fa1aec"], "node": "45530e5eb9201a7c7a8ae917414d0743aa3bd8b3", "parents": ["ef07439b9ea7141411648e0e407f7686063d30a5"], "tags": []}], "date": 1783510883, "git_changesets": ["fa2cbef4ee57cc8869f7902c2f71ef20487d98eb"], "user": "dmeehan@mozilla.com"}, "1383": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050368 - Check for end of charstring.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308768\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310831\n", "files": ["gfx/cairo/cairo/src/cairo-type1-subset.c", "gfx/cairo/patches/0040-type1-decode-integer.patch"], "git_node": "df69f21547f23cbcca523c1ff1a191967904c5e8", "git_parents": ["fa2cbef4ee57cc8869f7902c2f71ef20487d98eb"], "node": "b52d50fda0d317a15c001c04e282f0d3570985d3", "parents": ["45530e5eb9201a7c7a8ae917414d0743aa3bd8b3"], "tags": []}], "date": 1783510977, "git_changesets": ["df69f21547f23cbcca523c1ff1a191967904c5e8"], "user": "dmeehan@mozilla.com"}, "1384": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045772: Clean up nsStandardURL::Deserialize  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D305274\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310198\n", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": "63b5b174e5772ff8e44816325eb92ee75d987190", "git_parents": ["df69f21547f23cbcca523c1ff1a191967904c5e8"], "node": "42cc850c19953dc3c734edaf6ed5d18c1b370e4a", "parents": ["b52d50fda0d317a15c001c04e282f0d3570985d3"], "tags": []}], "date": 1783511015, "git_changesets": ["63b5b174e5772ff8e44816325eb92ee75d987190"], "user": "dmeehan@mozilla.com"}, "1385": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2048799: Flip polarity of a bounds check in cairo code.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307892\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310180\n", "files": ["gfx/cairo/cairo/src/cairoint.h", "gfx/cairo/patches/0041-Bug-2048799-flip-polarity-of-a-bounds-check.patch"], "git_node": "80c450dabd9bef369269ff09cd74ef545c662e46", "git_parents": ["63b5b174e5772ff8e44816325eb92ee75d987190"], "node": "69dac87e52ba3a369bdf17672c8238b5368ae081", "parents": ["42cc850c19953dc3c734edaf6ed5d18c1b370e4a"], "tags": []}], "date": 1783511202, "git_changesets": ["80c450dabd9bef369269ff09cd74ef545c662e46"], "user": "dmeehan@mozilla.com"}, "1386": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2045392 - Don't allow attaching children to outerdoc.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305621\n