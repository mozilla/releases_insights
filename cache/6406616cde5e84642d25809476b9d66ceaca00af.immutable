s.h"], "git_node": "341f097b712f4a33c0c1a978d54d20a4727a9a7d", "git_parents": ["8860fde2ea88a37ad3d7477a7942c0d6e06adfc6"], "node": "ef0d5b28123efe07fa88a6d9a483d521be2a5fe6", "parents": ["e06d161b7b81c5cdee3c4713b9b145af60f72933"], "tags": []}, {"author": "Fatih \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1422862: Show canvas permission prompt for offscreen canvases.  a=pascalc\n\nThis patch implements IsImageExtractionAllowed for Offscreen Canvas. It gets the windowId from offscreen canvas, queries it, attempts to get window's document, shows canvas permission prompt if successful.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222687\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255969\n", "files": ["dom/canvas/CanvasUtils.cpp"], "git_node": "8f6956fb31325e12e1669e3f1b896246199c36fc", "git_parents": ["341f097b712f4a33c0c1a978d54d20a4727a9a7d"], "node": "f2463405c3f79294743da0a0aeb18cf62c255e5b", "parents": ["ef0d5b28123efe07fa88a6d9a483d521be2a5fe6"], "tags": []}, {"author": "Fatih Kilic \u003cme@fklc.dev\u003e", "branch": "default", "desc": "Bug 1918690: Check canvas permission in RandomizePixels function.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255970\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasUtils.cpp", "dom/canvas/CanvasUtils.h", "dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ImageBitmapRenderingContext.cpp", "dom/canvas/OffscreenCanvas.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.cpp", "dom/webgpu/CanvasContext.cpp", "gfx/thebes/gfxUtils.cpp", "gfx/thebes/gfxUtils.h", "toolkit/components/resistfingerprinting/nsRFPService.cpp", "toolkit/components/resistfingerprinting/nsRFPService.h"], "git_node": "922992a8c231d0f7a95010bd0245d35f8c9134e3", "git_parents": ["8f6956fb31325e12e1669e3f1b896246199c36fc"], "node": "9cdd75dd7ace0911a50beea65acd9f2f60ad1293", "parents": ["f2463405c3f79294743da0a0aeb18cf62c255e5b"], "tags": []}, {"author": "Fatih \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918690: Extend test to also test Offscreen canvases.  a=pascalc\n\nPreviously this test didn't test for offscreen canvses. After all the previous patches in this stack, we can now enable offscreen canvas permission tests.\nWe are basically removing if (isOffscreen) continue; logic\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222838\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255971\n", "files": ["toolkit/components/resistfingerprinting/tests/browser/browser_canvas_randomization_permission.js"], "git_node": "803995787302040a79e1ea4d4ffd2c620285da08", "git_parents": ["922992a8c231d0f7a95010bd0245d35f8c9134e3"], "node": "e3e764f52911ae57d724573c4f52d115528033d5", "parents": ["9cdd75dd7ace0911a50beea65acd9f2f60ad1293"], "tags": []}, {"author": "Fatih \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1422862: Implement IsImageExtractionAllowed_impl.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D227385\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255972\n", "files": ["dom/canvas/CanvasUtils.cpp"], "git_node": "a5295861ea1863946c0e7d9ab1edd7cb72f3313b", "git_parents": ["803995787302040a79e1ea4d4ffd2c620285da08"], "node": "4c1517a386c0bad4b5276b419e14fc6825412564", "parents": ["e3e764f52911ae57d724573c4f52d115528033d5"], "tags": []}, {"author": "Fatih Kilic \u003cme@fklc.dev\u003e", "branch": "default", "desc": "Bug 1972643 - Initialize nsIPrincipal pointer.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254059\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255973\n", "files": ["dom/canvas/OffscreenCanvasDisplayHelper.cpp"], "git_node": "52cfa926a3467efb81da6457ce96b79b4254e122", "git_parents": ["a5295861ea1863946c0e7d9ab1edd7cb72f3313b"], "node": "dcc353560fa7753f06aba338dc596ebae8654015", "parents": ["4c1517a386c0bad4b5276b419e14fc6