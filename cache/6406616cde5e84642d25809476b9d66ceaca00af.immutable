s:96084:"{
"lastpushid": 1679,
"pushes": {"10": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962816 - Invert sign of delta-y when computing glyph advances for ExtTextOutW, because the GDI coordinate system is inverted.  a=pascalc\n\nWe used to have a sign-inversion like this in our cairo backend code:\n\nhttps://searchfox.org/mozilla-central/rev/0b6a214452a91745638b03d71da86ebe45e34efe/gfx/cairo/cairo/src/cairo-win32-surface.c#1892-1893\n\nThis was previously fixed (by me!) back in bug 454098, but in the\nprocess of updating cairo the change got lost as the code had moved\naround and so our old patch file no longer applied.\n\n(I'll see if I can get the standalone test program from that bug\nworking again, and file the issue upstream.)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254737\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254931\n", "files": ["gfx/cairo/28-win32-vertical-glyph-advance-direction.patch", "gfx/cairo/README", "gfx/cairo/cairo/src/win32/cairo-win32-surface.c"], "git_node": "35cb581b721ec12527cccc148ece7ab1dc99d041", "git_parents": ["b9c703059294a3c1c522767aaa20fa147ba0f15c"], "node": "2c845a484b45b9640d5acc87b506c859ad6e816b", "parents": ["f57a02ae2253731d9ca01172f894fe9a76bbdd0e"], "tags": []}], "date": 1750838306, "git_changesets": ["35cb581b721ec12527cccc148ece7ab1dc99d041"], "user": "pchevrel@mozilla.com"}, "11": {"changesets": [{"author": "Bastien Orivel \u003cborivel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965205 - Enable cron-bouncer-check on mozilla-esr140 r=releng-reviewers,jcristau a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254831\n", "files": [".cron.yml"], "git_node": "b36427f18e01c79fd1152a6c76a2145bab599941", "git_parents": ["35cb581b721ec12527cccc148ece7ab1dc99d041"], "node": "b2c36d24b6879ae76037991e3b2aaf1461cd157c", "parents": ["2c845a484b45b9640d5acc87b506c859ad6e816b"], "tags": []}], "date": 1751051920, "git_changesets": ["b36427f18e01c79fd1152a6c76a2145bab599941"], "user": "dmeehan@mozilla.com"}, "12": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972650 - add win64-aarch64 platform to update-verify-next tests.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254166\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254168\n", "files": ["taskcluster/kinds/release-update-verify-config-next/kind.yml", "taskcluster/kinds/release-update-verify-next/kind.yml"], "git_node": "2f67104721cfa96dd10b01037bf2e93157366966", "git_parents": ["b36427f18e01c79fd1152a6c76a2145bab599941"], "node": "74da17e1aa79195e7c3654d6bdf56c9b5bd54e4f", "parents": ["b2c36d24b6879ae76037991e3b2aaf1461cd157c"], "tags": []}], "date": 1751051978, "git_changesets": ["2f67104721cfa96dd10b01037bf2e93157366966"], "user": "dmeehan@mozilla.com"}, "13": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255109\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "70812ac3db2d85b9fb3247389bf6bdbd9d36a7df", "git_parents": ["2f67104721cfa96dd10b01037bf2e93157366966"], "node": "3640d4a43d9e7e24b3be56b61c60ae3f88d8833c", "parents": ["74da17e1aa79195e7c3654d6bdf56c9b5bd54e4f"], "tags": []}], "date": 1751052147, "git_changesets": ["70812ac3db2d85b9fb3247389bf6bdbd9d36a7df"], "user": "dmeehan@mozilla.com"}, "14": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 1968040 - Set color-scheme on root based on lwtheme-brighttext. r=emilio,desktop-theme-reviewers\" for causing Bug 1971487\n\nThis reverts commit 39032d8048b988a3b2bf23f61c0ebb182fc4ee3d.\n", "files": ["toolkit/themes/shared/global-shared.css"], "git_node": "e60e2adff433e8dec5fab87f8ea5328236340a8d", "git_parents": ["70812ac3db2d85b9fb3247389bf6bdbd9d36a7df"], "node": "a538d7424d2aba0392b85913fc609f3a5e2ef830", "parents": ["3640d4a43d9e7e24b3be56b61c60ae3f88d8833c"], "tags": []}], "date": 1751053694, "git_changesets": ["e60e2adff433e8dec5fab87f8ea5328236340a8d"], "user": "dmeehan@mozilla.com"}, "15": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974259 - Hold an OwnedHandle in an OverlappedOperation  a=dmeehan\n\nThis avoids cancelling a potentially closed handle.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255191\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255385\n", "files": ["toolkit/crashreporter/crash_helper_common/src/errors.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/windows.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs"], "git_node": "79a08e6f66a750ac66beda894b24e16e756c67fe", "git_parents": ["e60e2adff433e8dec5fab87f8ea5328236340a8d"], "node": "c0e0d3ce98364bd5b4ae93d011a788843c86fe60", "parents": ["a538d7424d2aba0392b85913fc609f3a5e2ef830"], "tags": []}], "date": 1751056809, "git_changesets": ["79a08e6f66a750ac66beda894b24e16e756c67fe"], "user": "dmeehan@mozilla.com"}, "16": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255481\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/moz-essential-domain-fallbacks.json"], "git_node": "c474f083b7605ea782d1e1ffb8be6fa74db2749a", "git_parents": ["79a08e6f66a750ac66beda894b24e16e756c67fe"], "node": "7ed1d9492105c1fe54f1b0fb6d1782a76347d8a9", "parents": ["c0e0d3ce98364bd5b4ae93d011a788843c86fe60"], "tags": []}], "date": 1751307055, "git_changesets": ["c474f083b7605ea782d1e1ffb8be6fa74db2749a"], "user": "dsmith@mozilla.com"}, "17": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1971581 - wasm: Align br_table limits with V8.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253675\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255156\n", "files": ["js/src/jit-test/tests/asm.js/testControlFlow.js", "js/src/wasm/WasmConstants.h"], "git_node": "69014578913976e5fc2ea2bc361196bb2de499b0", "git_parents": ["c474f083b7605ea782d1e1ffb8be6fa74db2749a"], "node": "bb7bf9ada1a3cdc15beb4b6e972d246b6236041e", "parents": ["7ed1d9492105c1fe54f1b0fb6d1782a76347d8a9"], "tags": []}], "date": 1751361687, "git_changesets": ["69014578913976e5fc2ea2bc361196bb2de499b0"], "user": "pchevrel@mozilla.com"}, "18": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1973440 - Fix serialization of light-dark(). r=dshin a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254686\n", "files": ["servo/components/style/values/generics/color.rs", "testing/web-platform/tests/css/css-color/parsing/color-valid.html"], "git_node": "8ebce472f49ae75b077cd3181d9dbe9fc278422f", "git_parents": ["69014578913976e5fc2ea2bc361196bb2de499b0"], "node": "539e9bf446bcaff6fe714ef0757fa115854aba72", "parents": ["bb7bf9ada1a3cdc15beb4b6e972d246b6236041e"], "tags": []}], "date": 1751387739, "git_changesets": ["8ebce472f49ae75b077cd3181d9dbe9fc278422f"], "user": "pchevrel@mozilla.com"}, "19": {"changesets": [{"author": "Gabriel Bustamante \u003cgbustamante@mozilla.com\u003e", "branch": "default", "desc": "Bug 1944440 - Add esr linux64-aarch64 installers, langpacks, and completes to bouncer check configuration  DONTBUILD  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235676\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255607\n", "files": ["testing/mozharness/configs/releases/bouncer_firefox_esr.py"], "git_node": "c0744ed0da5971cde9cddc602ac7fdb9f1a1733c", "git_parents": ["8ebce472f49ae75b077cd3181d9dbe9fc278422f"], "node": "a9490fbb673b9ad08b66e1929742856cddd323a0", "parents": ["539e9bf446bcaff6fe714ef0757fa115854aba72"], "tags": []}], "date": 1751458333, "git_changesets": ["c0744ed0da5971cde9cddc602ac7fdb9f1a1733c"], "user": "pchevrel@mozilla.com"}, "20": {"changesets": [{"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974076 - Remove the finish setup message and setup checklist auto-open message  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255347\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "2d728f9022e0a67f28ba8a7ff4c765010d1e9df8", "git_parents": ["c0744ed0da5971cde9cddc602ac7fdb9f1a1733c"], "node": "7af1ec4ec48a1367841850a4f02b5869dc5166bf", "parents": ["a9490fbb673b9ad08b66e1929742856cddd323a0"], "tags": []}], "date": 1751458379, "git_changesets": ["2d728f9022e0a67f28ba8a7ff4c765010d1e9df8"], "user": "pchevrel@mozilla.com"}, "21": {"changesets": [{"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1973333: Patch.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254640\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255167\n", "files": ["js/src/vm/Modules.cpp"], "git_node": "0c6d03c4b1d1607f4b0c3b79801f997c5b1fe4b0", "git_parents": ["2d728f9022e0a67f28ba8a7ff4c765010d1e9df8"], "node": "13dac60b81e0afb8655a60511a4f2fde66d37108", "parents": ["7af1ec4ec48a1367841850a4f02b5869dc5166bf"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1973333 - Test.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254641\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255168\n", "files": ["js/src/jit-test/tests/modules/bug-1973333.js"], "git_node": "e9b26188b94f794128ad64e67eb84a4a089d7123", "git_parents": ["0c6d03c4b1d1607f4b0c3b79801f997c5b1fe4b0"], "node": "ec6742e5c4c12eaf3d1feea161213a596642ea66", "parents": ["13dac60b81e0afb8655a60511a4f2fde66d37108"], "tags": []}], "date": 1751458776, "git_changesets": ["0c6d03c4b1d1607f4b0c3b79801f997c5b1fe4b0", "e9b26188b94f794128ad64e67eb84a4a089d7123"], "user": "pchevrel@mozilla.com"}, "22": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1970075 - Relax img-src CSP in alert.xhtml + tests  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253561\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253828\n", "files": ["dom/security/nsContentSecurityUtils.cpp", "toolkit/components/alerts/alert.xhtml", "toolkit/components/extensions/test/browser/browser.toml", "toolkit/components/extensions/test/browser/browser_ext_notifications_useSystemBackend_false.js"], "git_node": "fff97f3ade847d7b40122cd7a970086aed89f649", "git_parents": ["e9b26188b94f794128ad64e67eb84a4a089d7123"], "node": "d18e8127f8f4d4fc4d9e4ee6f1a1a66965201154", "parents": ["ec6742e5c4c12eaf3d1feea161213a596642ea66"], "tags": []}], "date": 1751458949, "git_changesets": ["fff97f3ade847d7b40122cd7a970086aed89f649"], "user": "pchevrel@mozilla.com"}, "23": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1959052 - Ensure JS execution is blocked during window.print() when we're using the system UI (rather than printing via the Firefox preview panel).  a=pascalc\n\nThe patch in bug 1898184 made reasonable sense, inasmuch as when the\nprint.prefer_system_dialog option is set, we don't show our window-modal\npreview panel.\n\nHowever, as noted in comment 6 here, we do still need to block JS while\nwindow.print() is presenting the system dialog, otherwise the document\nmay be changed or even closed by script behind the dialog's back. Prior\nto bug 1898184, the IsPreview::Yes flag caused us to block, but the issue\nwas that without the preview panel taking care of cleaning up the cloned\ndocument, the block got cleared.\n\nIt looks like we can solve this by setting the closeWindowAfterPrint\nflag in this case. In local testing, this seems to work for the various\nexamples here, and does not regress bug 1898184.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253655\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253944\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js"], "git_node": "c6ed7347eefc393cfebc51cbf422571687addd2c", "git_parents": ["fff97f3ade847d7b40122cd7a970086aed89f649"], "node": "fa6a8811ba5ebb49b6ddb926061a3a99f3f9a67d", "parents": ["d18e8127f8f4d4fc4d9e4ee6f1a1a66965201154"], "tags": []}], "date": 1751459306, "git_changesets": ["c6ed7347eefc393cfebc51cbf422571687addd2c"], "user": "pchevrel@mozilla.com"}, "24": {"changesets": [{"author": "John Bieling \u003cjohn@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1972814 - Supress warnings while evaluating choices, print if choice is used.  a=pascalc\n\nWe had to switch orders of choices in our schema files, so that the last\nadded choice also appears last (Bug 1972633). This caused some tests to\nfail, when a deprecated `refType` choices had been moved to the front.\n\nOne of the failing test is this one:\ncomm/mail/components/extensions/test/browser/browser_ext_compose_begin_attachments.js\n\nThis patch suppresses all deprecation warnings while choices are being\nevaluated, and prints only those warning which apply to the actual used choice.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254285\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254972\n", "files": ["toolkit/components/extensions/Schemas.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_background_empty.js", "toolkit/components/extensions/test/xpcshell/test_ext_schemas.js"], "git_node": "cb233a5f701578f23e342c230a534705471b744f", "git_parents": ["c6ed7347eefc393cfebc51cbf422571687addd2c"], "node": "d9fa845dd2e4b657e13fff54388360bac1427cb8", "parents": ["fa6a8811ba5ebb49b6ddb926061a3a99f3f9a67d"], "tags": []}], "date": 1751459806, "git_changesets": ["cb233a5f701578f23e342c230a534705471b744f"], "user": "pchevrel@mozilla.com"}, "25": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1973797 - Update Firefox home policies to remove Pocket name.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254990\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255293\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": "669cc2a9dfa62c7b18797b02b652bf6005a2900c", "git_parents": ["cb233a5f701578f23e342c230a534705471b744f"], "node": "6550a728c57e3e9f4d19e14cf93e4fcc43e97c2d", "parents": ["d9fa845dd2e4b657e13fff54388360bac1427cb8"], "tags": []}], "date": 1751460680, "git_changesets": ["669cc2a9dfa62c7b18797b02b652bf6005a2900c"], "user": "pchevrel@mozilla.com"}, "26": {"changesets": [{"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975262 - remove hugging chat from chatbot  a=pascalc\n\nHide from the list in onboarding and dropdown.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255875\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255920\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/tests/browser/browser_chat_sidebar.js"], "git_node": "7f8d24c80529e8b7d51c9ebf39381e43b8a7ced4", "git_parents": ["669cc2a9dfa62c7b18797b02b652bf6005a2900c"], "node": "298d8e525e6478ad6607be476ac401f68daa5700", "parents": ["6550a728c57e3e9f4d19e14cf93e4fcc43e97c2d"], "tags": []}], "date": 1751535749, "git_changesets": ["7f8d24c80529e8b7d51c9ebf39381e43b8a7ced4"], "user": "pchevrel@mozilla.com"}, "27": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1973990 - Do not reorder the state transition for async generator yield.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255428\n", "files": ["js/src/vm/AsyncIteration.cpp"], "git_node": "8d724901751c061a0b04e68385a5cc37035f813b", "git_parents": ["7f8d24c80529e8b7d51c9ebf39381e43b8a7ced4"], "node": "de7a6da77e99cbdbc95ed727017003d3d6540877", "parents": ["298d8e525e6478ad6607be476ac401f68daa5700"], "tags": []}], "date": 1751536831, "git_changesets": ["8d724901751c061a0b04e68385a5cc37035f813b"], "user": "pchevrel@mozilla.com"}, "28": {"changesets": [{"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 1973947 - revert removal of `remove_dir_all` crate  a=pascalc\n\nBug 1959801 removed the `remove_dir_all` crate. However, there was a regression we didn't discover until Firefox 140 reached stable: third-party DLL injection on Windows caused problems for the call sites that had had usages of `remove_dir_all::remove_dir_all` replaced with `std::fs::remove_dir_all`!\n\nDLL injection by third parties were causing these crashes because they incorrectly detour calls to `NtOpenFile`, crashing with Rust's current usage of it in `std::fs::remove_dir_all`. The issue has been reported upstream as [rust#143078], and a mitigation is in place in Rust's Nightly release channel. At time of writing this patch message, the fix is projected to become available in a stable Rust toolchain with version 1.90\u2014roughly 11 weeks away.\n\n[rust#143078]: https://github.com/rust-lang/rust/issues/143078#issue-3181510282\n\nAfter considering multiple mitigation options, this patch represents the decision of some stakeholders (@gstoll, @dmeehan, @yjuglaret, @gsvelto, @leggert, @ErichDonGubler) to mitigate the issue by directly backing out the patch for bug 1959801. The current plan is to eventually remove `remove_dir_all` again, once Rust 1.90 becomes the minimum supported version for `mozilla-central` (see bugs linked against bug 1973947 for more details), thus guaranteeing that our usage of `std::fs::remove_dir_all` is robust against this issue.\n\nWe may or may not engage with third parties to fix DLL injection; it has\nnot been decided at this time.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256027\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256040\n", "files": ["Cargo.lock", "gfx/webrender_bindings/Cargo.toml", "gfx/webrender_bindings/src/program_cache.rs", "supply-chain/config.toml", "third_party/rust/remove_dir_all/.cargo-checksum.json", "third_party/rust/remove_dir_all/Cargo.toml", "third_party/rust/remove_dir_all/LICENCE-APACHE", "third_party/rust/remove_dir_all/LICENCE-MIT", "third_party/rust/remove_dir_all/README.md", "third_party/rust/remove_dir_all/src/fs.rs", "third_party/rust/remove_dir_all/src/lib.rs"], "git_node": "f04e93142574537040e193e6ed17ab171afb0db8", "git_parents": ["8d724901751c061a0b04e68385a5cc37035f813b"], "node": "0eb96c5bc639b4e8f47bf1f60bfa44536af47d36", "parents": ["de7a6da77e99cbdbc95ed727017003d3d6540877"], "tags": []}], "date": 1751611374, "git_changesets": ["f04e93142574537040e193e6ed17ab171afb0db8"], "user": "pchevrel@mozilla.com"}, "29": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1974490 - Disable enrollment status metric  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255372\n", "files": ["toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_ExperimentManager_enroll.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_prefs.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_unenroll.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_nimbusTelemetry.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js"], "git_node": "591253834618ddcc2993bfbf434dca316881f6fc", "git_parents": ["f04e93142574537040e193e6ed17ab171afb0db8"], "node": "77b70b676e5777de424980e996b97c39a9dabca3", "parents": ["0eb96c5bc639b4e8f47bf1f60bfa44536af47d36"], "tags": []}], "date": 1751631384, "git_changesets": ["591253834618ddcc2993bfbf434dca316881f6fc"], "user": "pchevrel@mozilla.com"}, "30": {"changesets": [{"author": "Alexandru Marc \u003camarc@mozila.com\u003e", "branch": "default", "desc": "Bug 1974490 - Lint fix for test_ExperimentManager_enroll.js / test_ExperimentManager_prefs.js / test_ExperimentManager_unenroll.js / test_FirefoxLabs.js / test_RemoteSettingsExperimentLoader_updateRecipes.js / test_nimbusTelemetry.js / test_prefFlips.js DONTBUILD\n", "files": ["toolkit/components/nimbus/test/unit/test_ExperimentManager_enroll.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_prefs.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_unenroll.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_nimbusTelemetry.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js"], "git_node": "2b2839edb599f9527cace3b635eb50bad2d98d68", "git_parents": ["591253834618ddcc2993bfbf434dca316881f6fc"], "node": "6f23c7ca43389e07d0ac99f42271cfe52e9fd6d0", "parents": ["77b70b676e5777de424980e996b97c39a9dabca3"], "tags": []}], "date": 1751650265, "git_changesets": ["2b2839edb599f9527cace3b635eb50bad2d98d68"], "user": "amarc@mozilla.com"}, "31": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256256\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "95aa223cd3bd79d30cd5d3a6258f9da485c4bec8", "git_parents": ["2b2839edb599f9527cace3b635eb50bad2d98d68"], "node": "74d644d8e764cb44f66d246b7c0f95b6422d8d84", "parents": ["6f23c7ca43389e07d0ac99f42271cfe52e9fd6d0"], "tags": []}], "date": 1751891951, "git_changesets": ["95aa223cd3bd79d30cd5d3a6258f9da485c4bec8"], "user": "pchevrel@mozilla.com"}, "32": {"changesets": [{"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1968414 - [devtools] Escape carriage return character prope