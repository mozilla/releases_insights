bricator.services.mozilla.com/D256752\n", "files": ["layout/style/res/quirk.css", "testing/web-platform/meta/html/rendering/non-replaced-elements/lists/lists-styles-quirks.html.ini"], "git_node": "c81caea1cc691953696e40f8e4292cbba98fde88", "git_parents": ["206f5fce02ef177b3badcf742eef1ac240ed6a39"], "node": "b5199f3cf89c4b2702d4718b7c851117fcb878ca", "parents": ["54b33bbbca5508da7a6454d4fe9da3fdc4cdea94"], "tags": []}], "date": 1752181449, "git_changesets": ["c81caea1cc691953696e40f8e4292cbba98fde88"], "user": "pchevrel@mozilla.com"}, "67": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1933572 - Be more stringent about which SurfaceDescriptors we serialize for moz2d recording IPC. r=tnikkel a=pascalc\" a=backout\n\nThis reverts commit 8e03515d6cf8c808fe97b8be81c88625d50fb5da.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContextHelper.h", "gfx/2d/RecordedEventImpl.h", "gfx/2d/RecordingTypes.h", "gfx/gl/GLBlitHelper.cpp"], "git_node": "1e06eff94121d2e467f098ca73e99caa6bc62871", "git_parents": ["c81caea1cc691953696e40f8e4292cbba98fde88"], "node": "2b0d63266b1cd8e4faebee582644f16069a7e37b", "parents": ["b5199f3cf89c4b2702d4718b7c851117fcb878ca"], "tags": []}], "date": 1752183777, "git_changesets": ["1e06eff94121d2e467f098ca73e99caa6bc62871"], "user": "pchevrel@mozilla.com"}, "68": {"changesets": [{"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970973 - part1 : add a method to advance more than 32 bits for BitReader. r=media-playback-reviewers,karlt a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253259\n", "files": ["dom/media/BitReader.cpp", "dom/media/BitReader.h", "dom/media/platforms/agnostic/bytestreams/H265.cpp"], "git_node": "554c812f8cb1361afde6f480fdeeb2d249d39ac1", "git_parents": ["1e06eff94121d2e467f098ca73e99caa6bc62871"], "node": "af9ce938ceb99c92e1632193017f41e1d6c6f7b1", "parents": ["2b0d63266b1cd8e4faebee582644f16069a7e37b"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970973 - part2 : Support full parsing for AVCCConfig. r=media-playback-reviewers,karlt a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253118\n", "files": ["dom/media/platforms/agnostic/bytestreams/H264.cpp", "dom/media/platforms/agnostic/bytestreams/H264.h", "dom/media/platforms/agnostic/bytestreams/gtest/TestByteStreams.cpp"], "git_node": "28aa1e2e488d70f4338f7b331d1c1b1e57a8419f", "git_parents": ["554c812f8cb1361afde6f480fdeeb2d249d39ac1"], "node": "74994b7bfa395780a0da3ddb2ea1d98965362467", "parents": ["af9ce938ceb99c92e1632193017f41e1d6c6f7b1"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970973 - part3 : construct new extradata by using found SPSs and PPSs. r=media-playback-reviewers,karlt a=pascalc\n\nOn our Glean dashboard, we observed the error DRM_E_H264_SH_PPS_NOT_FOUND during\nAVC media engine playback. This may be caused by the H264ChangeMonitor not\nensuring that PPS is present in the extradata.\n\nIf the initial extradata contains both SPS and PPS, but a subsequent extradata\nonly includes a new SPS without the corresponding PPS, it could lead to that\nerror.\n\nTo address this, we should construct new extradata by inserting the previously\nfound PPS when needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253119\n", "files": ["dom/media/platforms/agnostic/bytestreams/H264.cpp", "dom/media/platforms/agnostic/bytestreams/H264.h", "dom/media/platforms/agnostic/bytestreams/gtest/TestByteStreams.cpp", "dom/media/platforms/wrappers/MediaChangeMonitor.cpp"], "git_node": "74b01796eb485b6c936395f6d02358807f54ab6a", "git_parents": ["28aa1e2e488d70f4338f7b331d1c1b1e57a8419f"], "node": "10b53f14d25f44d7512f3682538b8ba31097c2ac", "parents": ["74994b7bfa395780a0da3ddb2ea1d98965362467"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970973 - part4 : print the debug information in parsing warning. r=media-playback-reviewers,karlt a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253260\n", "files": ["dom/media/BitReader.cpp"], "git_node": "a8a2b3209756c69457fd422eadeb0ee38c1c8941", "git_parents": ["74b01796eb485b6c936395f6d02358807f54ab6a"], "node": "824f5187819b1387b161b858441a8392bae10bdc", "parents": ["10b53f14d25f44d7512f3682538b8ba31097c2ac"], "tags": []}], "date": 1752218682, "git_changesets": ["554c812f8cb1361afde6f480fdeeb2d249d39ac1", "28aa1e2e488d70f4338f7b331d1c1b1e57a8419f", "74b01796eb485b6c936395f6d02358807f54ab6a", "a8a2b3209756c69457fd422eadeb0ee38c1c8941"], "user": "pchevrel@mozilla.com"}, "69": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976454 - object-javascript-url.html now passes a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256771\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-object-element/object-javascript-url.html.ini"], "git_node": "a85bf16ed8bfcc03e6be05a267236dbe329c74c7", "git_parents": ["a8a2b3209756c69457fd422eadeb0ee38c1c8941"], "node": "d145bcbebef8e5315bf6ff892b19ac37cf871ad8", "parents": ["824f5187819b1387b161b858441a8392bae10bdc"], "tags": []}], "date": 1752218941, "git_changesets": ["a85bf16ed8bfcc03e6be05a267236dbe329c74c7"], "user": "pchevrel@mozilla.com"}, "7": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-esr140", "desc": "No bug - Tagging c2cc55e4c6ab5f0b8d99ec3e60fdf742c4d8ff65 with FIREFOX_140_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7bedb3af83da23a291b0d883fc43c3d5688cf03c", "git_parents": ["47692aa490f42ae4cf79a97fa4825a06a7cb0a7e"], "node": "0d42e033baaff621f76aba659847aff521b10099", "parents": ["74047400edfc08bc856442879e23f48bea141932"], "tags": []}], "date": 1750768524, "git_changesets": ["7bedb3af83da23a291b0d883fc43c3d5688cf03c"], "user": "ffxbld@lando.moz.tools"}, "70": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970983 - Re-apply patch 3 from bug 1896076, which was overwritten when the cairo-quartz code was reverted in bug 1908587.  a=pascalc\n\nThis is independent of the CGLayer-related issues that caused us to revert\nthe cairo-quartz component of the cairo 1.18.0 update, and is needed to\nallow document-internal links to work in Save-to-PDF output, rather than\npointing back to the online document.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253801\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256854\n", "files": ["gfx/cairo/cairo/src/cairo-quartz-surface.c"], "git_node": "cca88576ebdf7849ac4282db921f5c9cfd45a564", "git_parents": ["a85bf16ed8bfcc03e6be05a267236dbe329c74c7"], "node": "027de28eeab80fc32702f3ce141c245037b3bd08", "parents": ["d145bcbebef8e5315bf6ff892b19ac37cf871ad8"], "tags": []}], "date": 1752219969, "git_changesets": ["cca88576ebdf7849ac4282db921f5c9cfd45a564"], "user": "pchevrel@mozilla.com"}, "71": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970422 - Ensure we hold the gfxFontEntry lock while deleting an entry from the table cache.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253683\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256846\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h"], "git_node": "6ea300c230ae3537c69db7d5804d3a1b61be22ff", "git_parents": ["cca88576ebdf7849ac4282db921f5c9cfd45a564"], "node": "1ffa068710463382fb6721f1e0b061f7e0eeefeb", "parents": ["027de28eeab80fc32702f3ce141c245037b3bd08"], "tags": []}], "date": 1752220867, "git_changesets": ["6ea300c230ae3537c69db7d5804d3a1b61be22ff"], "user": "pchevrel@mozilla.com"}, "72": {"changesets": [{"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1922777 - Retain the last-used sidebar view/command id even when the panel is closed.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254261\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256867\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/marionette/manifest.toml", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py"], "git_node": "b42b497a1f676a9358df0632dfb723e843ace5b3", "git_parents": ["6ea300c230ae3537c69db7d5804d3a1b61be22ff"], "node": "1fe2f1d959a67bd305c7d51b816b1ed80965e877", "parents": ["1ffa068710463382fb6721f1e0b061f7e0eeefeb"], "tags": []}], "date": 1752222232, "git_changesets": ["b42b497a1f676a9358df0632dfb723e843ace5b3"], "user": "pchevrel@mozilla.com"}, "73": {"changesets": [{"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 1962880 - Get the download directory correctly for the profiler POSIX signal profiling  a=pascalc\n\nWe were using `NS_GetSpecialDirectory(NS_OS_DEFAULT_DOWNLOAD_DIR, ...)`\nbefore for getting the download directory for the profiler POSIX signal\nprofiling. But this ignores the user-set download directory and always\nuse the default downloads folder. And while doing so, it creates this\ndefault folder even if the user set it to another one.\n\nNow we are using `GetPreferredDownloadsDirectory` directly which looks\nfor the user-set download directory first and uses it if it find one.\n\nWe had to change the location we call profiler_lookup_async_signal_dump_directory\nbecause in that location user-defined prefs weren't fully initialized\nyet in NS_InitXPCOM. Moved it inside `XREMain::XRE_mainRun`. Note that\nthere is a small behavior change here. Previously that function was\nbeing called in *every process*, and now it's being called only in the\nparent process. This is actually the desired behavior because we can't\ncapture profiles by directly sending POSIX signals to child processes\ndue to sandboxing restrictions.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254342\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256960\n", "files": ["js/xpconnect/src/XPCShellImpl.cpp", "toolkit/xre/nsAppRunner.cpp", "tools/profiler/core/platform.cpp", "xpcom/build/XPCOMInit.cpp"], "git_node": "6a3ed071945dfed33b0969675ebedfce130c5017", "git_parents": ["b42b497a1f676a9358df0632dfb723e843ace5b3"], "node": "56a0c9a27151500c29845b022cdf3d6b48853977", "parents": ["1fe2f1d959a67bd305c7d51b816b1ed80965e877"], "tags": []}], "date": 1752226729, "git_changesets": ["6a3ed071945dfed33b0969675ebedfce130c5017"], "user": "pchevrel@mozilla.com"}, "74": {"changesets": [{"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976757 - Fix search test_google.js in esr builds.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257015\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257069\n", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_google.js"], "git_node": "2c2661d493e9dc55db297b7141abd1684b473acf", "git_parents": ["6a3ed071945dfed33b0969675ebedfce130c5017"], "node": "c0cade335b0703a9a4ed95af4053a1e1b576fc6d", "parents": ["56a0c9a27151500c29845b022cdf3d6b48853977"], "tags": []}], "date": 1752326104, "git_changesets": ["2c2661d493e9dc55db297b7141abd1684b473acf"], "user": "rvandermeulen@mozilla.com"}, "75": {"changesets": [{"author": "Fatih Kilic \u003cme@fklc.dev\u003e", "branch": "default", "desc": "Bug 1975851 - Enforce navigator.onLine as always true in RFP.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256508\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257041\n", "files": ["dom/base/Navigator.cpp", "dom/base/nsGlobalWindowInner.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerScope.cpp", "toolkit/components/resistfingerprinting/tests/browser/browser.toml", "toolkit/components/resistfingerprinting/tests/browser/browser_navigator_online.js"], "git_node": "fb0d3185b81692aaf00ca106142f58bb24d1b05f", "git_parents": ["2c2661d493e9dc55db297b7141abd1684b473acf"], "node": "6877adce8a8c5b64141cffa772926d3fdaaca6e0", "parents": ["c0cade335b0703a9a4ed95af4053a1e1b576fc6d"], "tags": []}], "date": 1752326154, "git_changesets": ["fb0d3185b81692aaf00ca106142f58bb24d1b05f"], "user": "rvandermeulen@mozilla.com"}, "76": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1948934 - Don't show new sidebar in kiosk mode.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254001\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257007\n", "files": ["browser/components/sidebar/browser-sidebar.js"], "git_node": "af95c4ca67f429431fd906bdb58d4ae4a47171c1", "git_parents": ["fb0d3185b81692aaf00ca106142f58bb24d1b05f"], "node": "68c1327813a5726029ed83ca756125f042fdc031", "parents": ["6877adce8a8c5b64141cffa772926d3fdaaca6e0"], "tags": []}, {"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1970492 - Allow additional prefs to be configured via policy.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253069\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257009\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs"], "git_node": "4b75e29a3e18cb6632b6b8127ac036742ddf8352", "git_parents": ["af95c4ca67f429431fd906bdb58d4ae4a47171c1"], "node": "b12cb419f9ffa7e7856e6271d13bbb73c348c993", "parents": ["68c1327813a5726029ed83ca756125f042fdc031"], "tags": []}], "date": 1752327076, "git_changesets": ["af95c4ca67f429431fd906bdb58d4ae4a47171c1", "4b75e29a3e18cb6632b6b8127ac036742ddf8352"], "user": "rvandermeulen@mozilla.com"}, "77": {"changesets": [{"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1967133 \u2013 part1 : handle operating_parameters_info in AV1 sequence header. r=media-playback-reviewers,padenot a=RyanVM\n\nAdd parsing support for operating_parameters_info in the AV1 sequence header.\nAlso, rename local variables to match the exact naming used in the AV1 spec.\nThis improves readability and makes it easier to verify the implementation\nagainst the specification.\n", "files": ["dom/media/platforms/agnostic/AOMDecoder.cpp"], "git_node": "1aee86090b094ee7b6ad488389f78438d3cdd67a", "git_parents": ["4b75e29a3e18cb6632b6b8127ac036742ddf8352"], "node": "824f510e6cfb87ba53080da31ffb7d3071903683", "parents": ["b12cb419f9ffa7e7856e6271d13bbb73c348c993"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1967133 \u2013 part2 : add test. r=media-playback-reviewers,padenot a=RyanVM\n", "files": ["dom/media/autoplay/test/mochitest/mochitest.toml", "dom/media/test/1967133.mp4", "dom/media/test/1967133.mp4^headers^", "dom/media/test/manifest.js", "dom/media/test/mochitest_compat.toml"], "git_node": "95c3cf9c62a3626b031ac75f09b2abeab1882518", "git_parents": ["1aee86090b094ee7b6ad488389f78438d3cdd67a"], "node": "5ba24a60d05c14de0ecfc35c571e7abdebaf3f06", "parents": ["824f510e6cfb87ba53080da31ffb7d3071903683"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1968956 - Use `await` when waiting for cache in browser_invalid.js. r=morgan a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253379\n", "files": ["accessible/tests/browser/mac/browser_invalid.js"], "git_node": "c288da112242108167fc7824a682fd8d2c1f9faa", "git_parents": ["95c3cf9c62a3626b031ac75f09b2abeab1882518"], "node": "8f70a769f6a055e69413f214793b0713a7d1341b", "parents": ["5ba24a60d05c14de0ecfc35c571e7abdebaf3f06"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1976561 - Remove a noisy warning. r=dom-core,smaug a=me\n\nIt is dealt with correctly, and it is somewhat common in tests it seem\nto start layout / insert anon content before the doc element is set up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256770\n", "files": ["dom/base/Document.cpp"], "git_node": "98ae3062758750bd2e1f4cc86dcd77441f86f312", "git_parents": ["c288da112242108167fc7824a682fd8d2c1f9faa"], "node": "bb3d2cd13a7a66b5092f4fcde263af1e3616e815", "parents": ["8f70a769f6a055e69413f214793b0713a7d1341b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972534 - Mock `buildconfig.substs` to only contain what we want to test against r=bhearsum a=test-only\n\nThe prior implementation allowed set environment variables to interfere with the test.\n\nIt seems we started setting `MOZ_SOURCE_REPO=https://hg.mozilla.org/releases/mozilla-esr140` with\n`ESR140`, so this was only a problem when this test ran on that branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256843\n", "files": ["python/mozbuild/mozbuild/test/test_artifacts.py"], "git_node": "c47c7d376dc89b180822e583b7f9a37c79edeee1", "git_parents": ["98ae3062758750bd2e1f4cc86dcd77441f86f312"], "node": "a73e2e4ec2b088ddbe6c51dbebd7d9b9c2cebf00", "parents": ["bb3d2cd13a7a66b5092f4fcde263af1e3616e815"], "tags": []}], "date": 1752328509, "git_changesets": ["1aee86090b094ee7b6ad488389f78438d3cdd67a", "95c3cf9c62a3626b031ac75f09b2abeab1882518", "c288da112242108167fc7824a682fd8d2c1f9faa", "98ae3062758750bd2e1f4cc86dcd77441f86f312", "c47c7d376dc89b180822e583b7f9a37c79edeee1"], "user": "rvandermeulen@mozilla.com"}, "78": {"changesets": [{"author": "Gabriel Astorgano \u003cgaastorgano@gmail.com\u003e", "branch": "default", "desc": "Bug 1967464 Align tab audio button r=kcochrane,desktop-theme-reviewers,tabbrowser-reviewers,dao,emilio a=RyanVM\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "1b829d6f6ba705bc8e8868837ea2757fd39ac78d", "git_parents": ["c47c7d376dc89b180822e583b7f9a37c79edeee1"], "node": "0f9d7241a7c121d56fde79f3ae7c8e7712f9ade6", "parents": ["a73e2e4ec2b088ddbe6c51dbebd7d9b9c2cebf00"], "tags": []}, {"author": "Benjamin VanderSloot \u003cbvandersloot@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974770 - Add null URI check while producing the partition key for ExpandedPrincipals - a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256823\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256997\n", "files": ["toolkit/components/antitracking/StoragePrincipalHelper.cpp"], "git_node": "5750d3a7b528893e5461c1ca9352f160fb8f889e", "git_parents": ["1b829d6f6ba705bc8e8868837ea2757fd39ac78d"], "node": "cdb01a61a25623ec6baf76857a143c841060f77d", "parents": ["0f9d7241a7c121d56fde79f3ae7c8e7712f9ade6"], "tags": []}], "date": 1752361020, "git_changesets": ["1b829d6f6ba705bc8e8868837ea2757fd39ac78d", "5750d3a7b528893e5461c1ca9352f160fb8f889e"], "user": "rvandermeulen@mozilla.com"}, "79": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257144\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "14266fc3b69c1a800176d0bbdc0880b290e6032f", "git_parents": ["5750d3a7b528893e5461c1ca9352f160fb8f889e"], "node": "9ac15c7a03c18a33cad3b750c05c6c2226ab8a17", "parents": ["cdb01a61a25623ec6baf76857a143c841060f77d"], "tags": []}], "date": 1752497105, "git_changesets": ["14266fc3b69c1a800176d0bbdc0880b290e6032f"], "user": "rvandermeulen@mozilla.com"}, "8": {"changesets": [{"author": "Bastien Orivel \u003cborivel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965206 - Re-enable the periodic-updates cron job on esr140 r=jcristau a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253989\n", "files": [".cron.yml"], "git_node": "d12b622bc9ab77a3840b2c4d75d6962b1ab10c13", "git_parents": ["7c8214adac3a11bb44876669348041bfb25b5a33"], "node": "2dbd16cf6f7e6b2994937ffc9c8cc2dd3c8a7609", "parents": ["395ea38c0d1272d4b509bd9fc034327c2917284f"], "tags": []}], "date": 1750777334, "git_changesets": ["d12b622bc9ab77a3840b2c4d75d6962b1ab10c13"], "user": "dmeehan@mozilla.com"}, "80": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1877695 - Update tracking protection policy to allow setting strict/standard.  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257033\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/trackingprotection/browser.toml", "browser/components/enterprisepolicies/tests/browser/trackingprotection/browser_policy_trackingprotection.js", "browser/components/enterprisepolicies/tests/browser/trackingprotection/trackingprotection.json", "browser/components/enterprisepolicies/tests/moz.build", "browser/components/protections/ContentBlockingPrefs.sys.mjs"], "git_node": "e8acc1d1086654dc5a1ad84b5d0e639aba4fe8a7", "git_parents": ["14266fc3b69c1a800176d0bbdc0880b290e6032f"], "node": "4e8b9df7e9dfeddfc705dfe51251c9ac6f4c5b4e", "parents": ["9ac15c7a03c18a33cad3b750c05c6c2226ab8a17"], "tags": []}, {"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1971182 - Add suspected fingerprinters to policy.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253071\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257008\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js", "browser/components/preferences/privacy.js"], "git_node": "229a8c121d8ebd6fabdb1317f77b98cb4edee1d0", "git_parents": ["e8acc1d1086654dc5a1ad84b5d0e639aba4fe8a7"], "node": "0c53463d0e61c036c08be46403e896e174f2182e", "parents": ["4e8b9df7e9dfeddfc705dfe51251c9ac6f4c5b4e"], "tags": ["FIREFOX_140_1_0esr_BUILD1", "FIREFOX_140_1_0esr_RELEASE"]}], "date": 1752499704, "git_changesets": ["e8acc1d1086654dc5a1ad84b5d0e639aba4fe8a7", "229a8c121d8ebd6fabdb1317f77b98cb4edee1d0"], "user": "rvandermeulen@mozilla.com"}, "9": {"changesets": [{"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 1972566 - temporarily disable testcase wasm/unroll7.js on esr140.   a=dmeehan.\n\nBug 1972357 pref'd off wasm loop unrolling for the 140 line.  That is harmless\nin itself, but unfortunately caused wasm/unroll7.js to fail since the purpose\nof that test is to check that unrolling is happening as expected.\n\nThis patch just sets the test to be always-skipped, effectively disabling it.\nWe can reenable it on central once 140 is out the door.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254010\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254161\n", "files": ["js/src/jit-test/tests/wasm/unroll7.js"], "git_node": "b9c703059294a3c1c522767aaa20fa147ba0f15c", "git_parents": ["d12b622bc9ab77a3840b2c4d75d6962b1ab10c13"], "node": "f57a02ae2253731d9ca01172f894fe9a76bbdd0e", "parents": ["2dbd16cf6f7e6b2994937ffc9c8cc2dd3c8a7609"], "tags": []}], "date": 1750778309, "git_changesets": ["b9c703059294a3c1c522767aaa20fa147ba0f15c"], "user": "dmeehan@mozilla.com"}}
}";