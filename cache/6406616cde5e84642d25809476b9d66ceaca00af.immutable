ac15da5a91cae0f8eb094d0b6bf3a156a0f"], "user": "pchevrel@mozilla.com"}, "6": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "7b64da855d2dc61da5b911a3afeaac0eec850365", "git_parents": ["e81e5b829e9146a023615f27d94359914c4d2547"], "node": "9ec4389dc9befc57ec73d233eec2117c588a8be9", "parents": ["c2cc55e4c6ab5f0b8d99ec3e60fdf742c4d8ff65"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "7c8214adac3a11bb44876669348041bfb25b5a33", "git_parents": ["7b64da855d2dc61da5b911a3afeaac0eec850365"], "node": "395ea38c0d1272d4b509bd9fc034327c2917284f", "parents": ["9ec4389dc9befc57ec73d233eec2117c588a8be9"], "tags": []}], "date": 1750691601, "git_changesets": ["7b64da855d2dc61da5b911a3afeaac0eec850365", "7c8214adac3a11bb44876669348041bfb25b5a33"], "user": "ffxbld@lando.moz.tools"}, "60": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975998 - Exit earlier on failure to add channel data when finishing audio decoding. r=padenot a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256298\n", "files": ["dom/media/webaudio/MediaBufferDecoder.cpp"], "git_node": "dadca200c6595cca9bb70e8cf4eccbd0a1cd74e8", "git_parents": ["46ec3ac15da5a91cae0f8eb094d0b6bf3a156a0f"], "node": "4f1485c53f0f08ec88700fa3c708d3687585dbb6", "parents": ["678f345d2545900d644c543189b53df5bb5477f1"], "tags": []}], "date": 1752151689, "git_changesets": ["dadca200c6595cca9bb70e8cf4eccbd0a1cd74e8"], "user": "pchevrel@mozilla.com"}, "61": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1976297 - Restore localization of a few labels. r=stransky a=pascalc\n\nI thought the underscores were some sort of magic builtin, but they\naren't, they just indicate where the accesskey is, apparently. So we\nneed to localize them.\n\nRestore the same localization that GTK used. The GTK 3 gettext domain is\nhard-coded to be gtk30.\n\nI could use the Firefox built-in localization mechanism, but that would\nend up with a somewhat weirder setup if the locales are mismatched, so\npreserve behavior for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256593\n", "files": ["widget/gtk/nsFilePicker.cpp", "widget/gtk/nsPrintDialogGTK.cpp"], "git_node": "9c221432242c664f4c38b9eff13bb6308bb3be0b", "git_parents": ["dadca200c6595cca9bb70e8cf4eccbd0a1cd74e8"], "node": "de7ba1d931a5b78a3a281312f2a3a269049f8530", "parents": ["4f1485c53f0f08ec88700fa3c708d3687585dbb6"], "tags": []}], "date": 1752153315, "git_changesets": ["9c221432242c664f4c38b9eff13bb6308bb3be0b"], "user": "pchevrel@mozilla.com"}, "62": {"changesets": [{"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 1973975 - Ensure that glMakeCurrent is called when rendering without presenting. r=gfx-reviewers,aosmond a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255987\n", "files": ["gfx/webrender_bindings/RendererOGL.cpp"], "git_node": "928305487e507e27c02b03a0f0557104379dd7ad", "git_parents": ["9c221432242c664f4c38b9eff13bb6308bb3be0b"], "node": "c2c829f3f5613a0df909e2ff7ea1a5bded180a55", "parents": ["de7ba1d931a5b78a3a281312f2a3a269049f8530"], "tags": []}], "date": 1752153626, "git_changesets": ["928305487e507e27c02b03a0f0557104379dd7ad"], "user": "pchevrel@mozilla.com"}, "63": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970753 - Keep locked resources alive. r=gw a=pasca