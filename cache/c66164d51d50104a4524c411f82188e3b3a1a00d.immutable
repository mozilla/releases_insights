rc/gc/AtomMarking.h", "js/src/vm/JSAtom.cpp"], "git_node": null, "git_parents": [null], "node": "0db86656655bb4df54ecb6aa40e3d57e81edfb0b", "parents": ["a62ede2dd3bc9d363f7b2b94c18b126ae5d637c4"], "tags": []}, {"author": "Jan Beich \u003cjbeich@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1509757 - Don't rely on GNU regex extension for character classes. r=froydnj a=lizzard\n$ echo --with-system-nspr --with-system-nss | gnused -e 's/--with-system-nspr\\S* *//'\n--with-system-nss\n$ echo --with-system-nspr --with-system-nss | bsdsed -e 's/--with-system-nspr\\S* *//'\nsed: 1: \"s/--with-system-nspr\\S* ...\": RE error: trailing backslash (\\)", "files": ["old-configure.in"], "git_node": null, "git_parents": [null], "node": "fbba8450659ff174beac3d1d69e7de277ae432e4", "parents": ["0db86656655bb4df54ecb6aa40e3d57e81edfb0b"], "tags": []}], "date": 1543501139, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "254": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1507267 - [awsy] Re-enable \"about:newtab\" page after Bug 1507267. r=erahm a=test-only\n\nBug 1506643 disabled the usage of \"about:newtab\". But it's\nactually needed by awsy for testing the memory consumption\nof Firefox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11932", "files": ["testing/awsy/conf/prefs.json"], "git_node": null, "git_parents": [null], "node": "54c9c6a08ed2a60e706f561b509bd2c8e11082dc", "parents": ["fbba8450659ff174beac3d1d69e7de277ae432e4"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1510471 - Avoid useless FrameNeedsReflow call. r=emilio, a=RyanVM", "files": ["layout/forms/nsComboboxControlFrame.cpp"], "git_node": null, "git_parents": [null], "node": "20e31905de62c24725d62988dd23a0764a7cfcb5", "parents": ["54c9c6a08ed2a60e706f561b509bd2c8e11082dc"], "tags": []}], "date": 1543507098, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "255": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1510471 - Fix bustage. r=smaug, a=bustage", "files": ["layout/forms/nsComboboxControlFrame.cpp"], "git_node": null, "git_parents": [null], "node": "c2832f98fe516ebad6add8105169c9cd99795013", "parents": ["20e31905de62c24725d62988dd23a0764a7cfcb5"], "tags": []}], "date": 1543510606, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "256": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1510441: Add `.cron.yml` to the taskgraph sparse profile; r=gps a=tomprince DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13142", "files": ["build/sparse-profiles/taskgraph"], "git_node": null, "git_parents": [null], "node": "1376c48eaf2b6313a9084165e99c377eeb9a8ddc", "parents": ["c2832f98fe516ebad6add8105169c9cd99795013"], "tags": []}], "date": 1543558964, "git_changesets": [null], "user": "mozilla@hocat.ca"}, "257": {"changesets": [{"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1475101 - add mark-as-started task. r=rail a=release", "files": ["taskcluster/ci/release-mark-as-started/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/release_mark_as_started.py", "taskcluster/taskgraph/transforms/task.py", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "7b5c4718f62552e43cc6f19c728f5ff2af1896ad", "parents": ["1376c48eaf2b6313a9084165e99c377eeb9a8ddc"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1499440 - add esr60/release configs for mark-as-started task.r=aki a=release", "files": ["taskcluster/ci/release-mark-as-started/kind.yml"], "git_node": null, "git_parents": [null], "node": "db9f8b0634ece4ba033c6227d8d65cd437748ee8", "parents": ["7b5c4718f62552e43cc6f19c728f5ff2af1896ad"], "tags": []}], "date": 1543599814, "git_changesets": [null, null], "user": "raliiev@mozilla.com"}, "258": {"changesets": [{"author": "Jason Orendorff \u003cjorendorff@mozilla.com\u003e", "branch": "default", "desc": "Bug 1391756 - Try to fix rare timeout in dom/tests/mochitest/fetch/test_readableStreams.html. r=baku, a=test-only\n\nAlso removes an infinite regress of nested iframes. The original problem was\nthat tests would start running before the child iframe was done loading. The\nstraightforward fix is to have the child frame start the test. But this caused\nfurther error messages because the child iframe is loaded more than once;\nremoving the iframe from the iframe fixes this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13385", "files": ["dom/tests/mochitest/fetch/common_readableStreams.js", "dom/tests/mochitest/fetch/iframe_readableStreams.html", "dom/tests/mochitest/fetch/test_readableStreams.html"], "git_node": null, "git_parents": [null], "node": "7a8060fc91cd897bb5b6060f42cc183581463e04", "parents": ["db9f8b0634ece4ba033c6227d8d65cd437748ee8"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1351940 - [marionette] Only convert a valid outerWindowID to a string. r=ato, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D13206", "files": ["testing/marionette/puppeteer/firefox/firefox_puppeteer/ui/browser/tabbar.py"], "git_node": null, "git_parents": [null], "node": "3e8c9f8c5307bce9bdfbe419a92f93cf7b11f7cb", "parents": ["7a8060fc91cd897bb5b6060f42cc183581463e04"], "tags": []}], "date": 1543607005, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "259": {"changesets": [{"author": "Simon Montagu \u003csmontagu@smontagu.org\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1505911 - Use IsAlpha/IsDigit instead of IsAsciiAlpha/IsAsciiDigit for full Unicode support. r=valentin a=jorgk DONTBUILD", "files": ["netwerk/stre