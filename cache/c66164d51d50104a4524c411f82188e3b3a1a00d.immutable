ect/test/test_message.t", "tools/tryselect/test/test_preset.t"], "git_node": null, "git_parents": [null], "node": "132ff998d04e07348dc8ca0b77229a946ead1360", "parents": ["8285177d195ba68c0232a27c70fc3e46a64164a3"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1495539 Set up MinGW-clang to track clang trunk r=ted", "files": ["build/build-clang/clang-7-mingw.json", "build/build-clang/clang-trunk-mingw.json", "taskcluster/ci/toolchain/linux.yml", "taskcluster/scripts/misc/build-clang-7-mingw.sh", "taskcluster/scripts/misc/build-clang-trunk-mingw.sh"], "git_node": null, "git_parents": [null], "node": "45bea853246f3485897b1d0bf58629e4f45ad829", "parents": ["132ff998d04e07348dc8ca0b77229a946ead1360"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1499809 - l10n bumper should touch a status file on success. r=nthomas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9017", "files": ["testing/mozharness/configs/l10n_bumper/jamun.py", "testing/mozharness/configs/l10n_bumper/mozilla-beta.py", "testing/mozharness/configs/l10n_bumper/mozilla-central.py", "testing/mozharness/scripts/l10n_bumper.py"], "git_node": null, "git_parents": [null], "node": "4f8fb48c0f7d1158bc1401c01c6319179e05fe1d", "parents": ["45bea853246f3485897b1d0bf58629e4f45ad829"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1498626 - Fix google-play-string docker image build r=dustin\n\nFix google-play-string docker image build\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9265", "files": ["taskcluster/docker/google-play-strings/Dockerfile"], "git_node": null, "git_parents": [null], "node": "ecc55f87f965c935ad2eabc6da681779722d60e3", "parents": ["4f8fb48c0f7d1158bc1401c01c6319179e05fe1d"], "tags": []}, {"author": "Jordan Lund \u003cjlund@mozilla.com\u003e", "branch": "default", "desc": "Bug 1499265 - Intermittent failure in update-verify: Task timeout after 3600 seconds. Force killing container. r=aki a=tomprince\n\nIntermittent failure in update-verify: Task timeout after 3600 seconds. Force killing container\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8925", "files": ["taskcluster/ci/release-update-verify/kind.yml"], "git_node": null, "git_parents": [null], "node": "f2569ad7bd92f6830db24e97ca40878579d62cf6", "parents": ["ecc55f87f965c935ad2eabc6da681779722d60e3"], "tags": []}], "date": 1541808485, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "mozilla@hocat.ca"}, "235": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11630", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "a5c1a73b5999be5959609e871f5e60660c332b40", "parents": ["f2569ad7bd92f6830db24e97ca40878579d62cf6"], "tags": []}, {"author": "Benjamin Bouvier \u003cbenj@benj.me\u003e", "branch": "default", "desc": "Bug 1503326. r=sunfish, r=nbp, a=RyanVM", "files": ["js/src/jit/RangeAnalysis.cpp"], "git_node": null, "git_parents": [null], "node": "6398541ec3020e85f19dea412c5f4f7ceab33f65", "parents": ["a5c1a73b5999be5959609e871f5e60660c332b40"], "tags": []}], "date": 1542036581, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "236": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1475566 - Disable #pragma comments for MinGW Builds. r=glandium, a=lizzard\n\nIn the MinGW browser build job, we're going to use -fms-extensions, which will tell\nclang to start processing these comments. Clang cannot process them correctly\n(it's an upstream bug) but it doesn't need to, because we include the libs we need\nin moz.build files.\n\nSo we exclude them for MinGW builds. mingw-clang gets them wrong and mingw-gcc\n(which doesn't even work anymore on -central) ignored them.\n\nIn the future, with a llvm fix, we could clean up the moz.build files and re-enable\nthese comments.", "files": ["ipc/chromium/src/base/time_win.cc", "media/gmp-clearkey/0.1/WMFUtils.cpp", "testing/tools/screenshot/win32-screenshot.cpp", "toolkit/components/maintenanceservice/workmonitor.cpp", "toolkit/xre/nsWindowsRestart.cpp"], "git_node": null, "git_parents": [null], "node": "d1c9b0924148c651f61c8305e71d21670876a472", "parents": ["6398541ec3020e85f19dea412c5f4f7ceab33f65"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1493249 - Add policy for security devices. r=Felipe, a=lizzard", "files": ["browser/components/enterprisepolicies/EnterprisePolicies.js", "browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/PoliciesValidator.jsm", "browser/components/enterprisepolicies/tests/browser/browser_policies_validate_and_parse_API.js"], "git_node": null, "git_parents": [null], "node": "b9c34e2086c23f68fcf76a1e8d969ac3e1832dc3", "parents": ["d1c9b0924148c651f61c8305e71d21670876a472"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1497549 - Add support for setting locale via policy. r=Felipe,zbraniecki, a=lizzard", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_locale.js"], "git_node": null, "git_parents": [null], "node": "4983ed48535aeea7058c838fa81633faabab9661", "parents": ["b9c34e2086c23f68fcf76a1e8d969ac3e1832dc3"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1463684 - Specify UTF-8 charset for policy search engines. r=Felipe, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8144", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "f27badd7938f81b636e922692abdf013543b1887", "parents": ["4983ed48535aeea7058c838fa81633faabab9661"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1493973 - Don't block devtools when block chrome URLs. r=felipe, a=lizzard", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "2b140842f76221400d0291f5e1230aa6d156bd5f", "parents": ["f27badd7938f81b636e922692abdf013543b1887"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1496736 - Check if we actually have a new key DB before removing the old one. r=jcj, a=lizzard\n\nIn bug 1475775, we added code to remove the old NSS key DB if the user has set a\npassword on the grounds that the old DB could potentially be unencrypted and\ncontain secrets. However, we did so with the assumption that we were using the\nnew DB, which is not necessarily true when the system has been configured to\nalways use the old DB, as with some RedHat products. This patch checks for the\nexistence of the new DB before proceeding with deleting the old DB. Technically\nthis isn't sufficient, because the new DB could be present even if we're not\nusing it. However, we've already gone far into \"this configuration isn't\nsupported\" territory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9318", "files": ["security/manager/ssl/nsNSSComponent.cpp"], "git_node": null, "git_parents": [null], "node": "3bed863ee656e34c7f1ec2c35765e0cdebca8545", "parents": ["2b140842f76221400d0291f5e1230aa6d156bd5f"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1486415 - Ensure the SourceSurface stays alive for the duration of MarkIndependent. r=jrmuizel, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4856", "files": ["gfx/2d/SourceSurfaceD2D1.cpp"], "git_node": null, "git_parents": [null], "node": "ad2e4899a821f14b0eb6abb9a582f1d3172ac002", "parents": ["3bed863ee656e34c7f1ec2c35765e0cdebca8545"], "tags": []}], "date": 1542069783, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "237": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1506643 - [marionette] Disable \"about:newtab\" page, and always load \"about:blank\". r=ato a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11691", "files": ["testing/marionette/client/marionette_driver/geckoinstance.py", "testing/marionette/components/marionette.js"], "git_node": null, "git_parents": [null], "node": "580a7ea06a11a09406447adc1be0b4d016c23cdb", "parents": ["ad2e4899a821f14b0eb6abb9a582f1d3172ac002"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1498765 - Clean up ContentParent::KillHard handling. r=mccr8, a=RyanVM\n\nMessageChannel shouldn't need to care about PContent-specific details.", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "ipc/glue/MessageChannel.cpp", "ipc/glue/MessageChannel.h"], "git_node": null, "git_parents": [null], "node": "a08c8493ba193add59c6236d6a1b4af4a64358d8", "parents": ["580a7ea06a11a09406447adc1be0b4d016c23cdb"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1505181 - Use canonical function in TypeNewScript::rollbackPartiallyInitializedObjects. r=bhackett, a=RyanVM", "files": ["js/src/vm/JSFunction.h", "js/src/vm/ObjectGroup.cpp", "js/src/vm/TypeInference.cpp"], "git_node": null, "git_parents": [null], "node": "ee204e26690e07dd6afe445ed30c7a026c2c29c0", "parents": ["a08c8493ba193add59c6236d6a1b4af4a64358d8"], "tags": []}], "date": 1542131267, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "238": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491848 - Patch libyuv to fix the x86 mingw-clang build. r=jesup, a=lizzard\n\nThis patch combines the following upstream patches to fix the mingw build\n\nhttps://chromium.googlesource.com/libyuv/libyuv/+/8fa02df3c%5E%21/\nhttps://chromium.googlesource.com/libyuv/libyuv/+/d8680893ecfcffd952c7a5d0dc1878d1c486a4e4%5E%21/\nhttps://chromium.googlesource.com/libyuv/libyuv/+/6e498475c749063485a046dfb24e1fa1a81cbedf%5E%21/", "files": ["media/libyuv/libyuv/include/libyuv/compare_row.h", "media/libyuv/libyuv/include/libyuv/rotate_row.h", "media/libyuv/libyuv/include/libyuv/row.h", "media/libyuv/libyuv/source/compare_win.cc", "media/libyuv/libyuv/source/rotate_win.cc", "media/libyuv/libyuv/source/scale_win.cc"], "git_node": null, "git_parents": [null], "node": "1cab3104b7a66866c907d41438ab45532fcdc8ef",