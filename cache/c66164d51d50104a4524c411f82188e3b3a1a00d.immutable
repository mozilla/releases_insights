ns/cookie/test/unit/test_permmanager_migrate_7-8.js", "extensions/cookie/test/unit/test_permmanager_notifications.js", "netwerk/test/unit/test_permmgr.js"], "git_node": null, "git_parents": [null], "node": "1cb019f041884c7ab81151fdb656dda856f1389e", "parents": ["1da8a333774a9842d70a9c49e0197dcdbfe2a96d"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1445943 - Add Enterprise Policy support for macOS to ESR. This includes patches in bug 1445943, bug 1497408, bug 1497948, bug 1498032. r=mstange,felipe,glandium,spohl, a=lizzard", "files": ["browser/components/enterprisepolicies/EnterprisePolicies.js", "browser/components/enterprisepolicies/macOSPoliciesParser.jsm", "browser/components/enterprisepolicies/moz.build", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policies_macosparser_unflatten.js", "browser/components/enterprisepolicies/tests/browser/browser_policies_sorted_alphabetically.js", "xpcom/base/moz.build", "xpcom/base/nsIMacPreferencesReader.idl", "xpcom/base/nsMacPreferencesReader.h", "xpcom/base/nsMacPreferencesReader.mm", "xpcom/build/XPCOMInit.cpp"], "git_node": null, "git_parents": [null], "node": "4503802587c82e204de340291ce9b403753b82fa", "parents": ["1cb019f041884c7ab81151fdb656dda856f1389e"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1500366 - Register all DBus connection to be handled by gmain loop. r=jhorak, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9230", "files": ["netwerk/wifi/nsWifiScannerDBus.cpp", "netwerk/wifi/nsWifiScannerDBus.h", "toolkit/components/remote/nsDBusRemoteService.cpp", "widget/xremoteclient/DBusRemoteClient.cpp"], "git_node": null, "git_parents": [null], "node": "abd59256c4e34bf576f00ec9ffd2d66f7b24adb6", "parents": ["4503802587c82e204de340291ce9b403753b82fa"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493080 - Remove reference cycle between BufferTextureData and DrawTargets. r=jrmuizel, a=lizzard", "files": ["gfx/layers/BufferTexture.cpp", "gfx/layers/BufferTexture.h"], "git_node": null, "git_parents": [null], "node": "a7cabf306d05ac71b99e29f965d20df28b0c8e3a", "parents": ["abd59256c4e34bf576f00ec9ffd2d66f7b24adb6"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1506640 - Trace wrappers rooters during sweep phase. r=pbone, a=RyanVM", "files": ["js/src/gc/GC.cpp"], "git_node": null, "git_parents": [null], "node": "8bbf80948b500d813c50cba5e56307ed62bcc981", "parents": ["a7cabf306d05ac71b99e29f965d20df28b0c8e3a"], "tags": []}, {"author": "Benjamin Bouvier \u003cbenj@benj.me\u003e", "branch": "default", "desc": "Bug 1507564 - Bind code labels when generating lazy table stubs. r=luke, a=jcristau\n\nA lazy stub could generate CodeLabels on x86, because of a constant NaN\ngenerated for the entry's epilogue that ended up in a constant pool. We need to\nactually bind these code labels in general.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12052", "files": ["js/src/jit-test/tests/wasm/regress/lazy-table-nan.js", "js/src/wasm/WasmCode.cpp"], "git_node": null, "git_parents": [null], "node": "60619cc47b104fb091f377c015c97dc62ac27ae7", "parents": ["8bbf80948b500d813c50cba5e56307ed62bcc981"], "tags": []}, {"author": "Benjamin Bouvier \u003cbenj@benj.me\u003e", "branch": "default", "desc": "Bug 1507730 - Generate a temporary for negative power-of-two constants in mul64 on 32 bits platforms. r=lth, a=jcristau\n\nIn the code generator function, we assume we have a temp if a known constant is\na non-negative power of two. But lowering only checked for power of twos\nindependently of their sign, so this was incorrect. This patch syncs them up on\nboth ARM32 and x86.", "files": ["js/src/jit-test/tests/wasm/regress/imul64-ion-negative-power-of-two.js", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/x86/Lowering-x86.cpp"], "git_node": null, "git_parents": [null], "node": "dd0f01818b9ce9257a1a2b1c9cfe8e7aabc8240e", "parents": ["60619cc47b104fb091f377c015c97dc62ac27ae7"], "tags": []}], "date": 1542634966, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "242": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 4503802587c8 (bug 1445943) for OSX policy engine test failures.", "files": ["browser/components/enterprisepolicies/EnterprisePolicies.js", "browser/components/enterprisepolicies/macOSPoliciesParser.jsm", "browser/components/enterprisepolicies/moz.build", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policies_macosparser_unflatten.js", "browser/components/enterprisepolicies/tests/browser/browser_policies_sorted_alphabetically.js", "xpcom/base/moz.build", "xpcom/base/nsIMacPreferencesReader.idl", "xpcom/base/nsMacPreferencesReader.h", "xpcom/base/nsMacPreferencesReader.mm", "xpcom/build/XPCOMInit.cpp"], "git_node": null, "git_parents": [null], "node": "af3d0194519b7f984ebb79e6ad9b2c824afdb6ac", "parents": ["dd0f01818b9ce9257a1a2b1c9cfe8e7aabc8240e"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1507614 - Identify ESR with MOZ_APP_VERSION_DISPLAY. r=glandium, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D12067", "files": ["browser/base/content/aboutDialog.js", "browser/base/content/aboutDialog.xul"], "git_node": null, "git_parents": [null], "node": "c419540e75dadc4ad89c596e43511c7265ab586b", "parents": ["af3d0194519b7f984ebb79e6ad9b2c824afdb6ac"], "tags": []}], "date": 1542650644, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "243": {"changesets": [{"author": "Fe