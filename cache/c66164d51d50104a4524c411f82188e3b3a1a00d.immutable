"third_party/rust/libc/src/unix/bsd/netbsdlike/openbsdlike/other/mod.rs", "third_party/rust/libloading/tests/statics.rs", "third_party/rust/proc-macro2/src/macros.rs", "third_party/rust/regex-syntax/src/literals.rs", "third_party/rust/regex-syntax/src/properties.rs", "third_party/rust/regex/examples/bug347.rs", "third_party/rust/regex/examples/shootout-regex-redux-1.rs", "third_party/rust/regex/examples/shootout-regex-redux-chunked.rs", "third_party/rust/regex/examples/shootout-regex-redux.rs", "third_party/rust/regex/scripts/unicode.py", "third_party/rust/regex/src/literals.rs", "third_party/rust/regex/src/re_plugin.rs", "third_party/rust/regex/src/simd_accel/mod.rs", "third_party/rust/regex/src/simd_accel/teddy128.rs", "third_party/rust/regex/src/simd_fallback/mod.rs", "third_party/rust/regex/src/simd_fallback/teddy128.rs", "third_party/rust/regex/tests/plugin.rs", "third_party/rust/regex/tests/test_plugin.rs", "third_party/rust/smallvec/LICENSE"], "git_node": null, "git_parents": [null, null], "node": "95d94b65a679e4f71ae2b131326822700e23c41d", "parents": ["8d71faee5dcdd0773b7e0830b8fad96a6bda559b", "ea9412b18ca812f8a480aa28d508298db5fdc531"], "tags": []}, {"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Backed out changeset c0b4ca69376c (bug 1434837 for causing bug 1499410) to build Thunderbird 60.3. a=jorgk DONTBUILD", "files": ["toolkit/components/satchel/nsFormFillController.cpp", "toolkit/components/satchel/test/test_popup_enter_event.html", "toolkit/content/tests/chrome/test_autocomplete_mac_caret.xul", "toolkit/content/tests/mochitest/test_autocomplete_change_after_focus.html", "toolkit/content/widgets/autocomplete.xml"], "git_node": null, "git_parents": [null], "node": "92515b2d8a74ec96119209101319a8b21e06c44d", "parents": ["95d94b65a679e4f71ae2b131326822700e23c41d"], "tags": []}], "date": 1540111867, "git_changesets": [null, null], "user": "mozilla@jorgk.com"}, "220": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging ea9412b18ca812f8a480aa28d508298db5fdc531 with FIREFOX_60_3_0esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c1f694959a11767924178e189fb5707f3f494fb6", "parents": ["048288040aac925a88fcd2882418cebc2a45bb97"], "tags": []}, {"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "98138b0822fbb8a082fb55ed36292128335be038", "parents": ["c1f694959a11767924178e189fb5707f3f494fb6"], "tags": []}], "date": 1540301578, "git_changesets": [null, null], "user": "ffxbld"}, "221": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9773", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "950b36fcf538c12c95744fd0803c8b60d00401d7", "parents": ["98138b0822fbb8a082fb55ed36292128335be038"], "tags": []}, {"author": "Jan Beich \u003cjbeich@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1500484 - Unbreak Wayland build on FreeBSD after bug 1417890. r=stransky, a=RyanVM", "files": ["widget/gtk/nsClipboardWayland.cpp"], "git_node": null, "git_parents": [null], "node": "6f1a76d107dc99e88ae7b1e031b858b7f8482c79", "parents": ["950b36fcf538c12c95744fd0803c8b60d00401d7"], "tags": []}], "date": 1540478954, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "222": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1434837 - Make autocomplete and satchel listen to keypress event at the system event group. r=mak (was c0b4ca69376c, backed out in 92515b2d8a74) a=jorgk\n\nThe autocomplete module listens to keypress event for both printable keys and\nnon-printable keys a lot.  However, we'll stop dispatching keypress event for\nnon-printable keys in the default event group of web content.  So, autocomplete\nshould listen to keypress events at the system event group.\n\nNote that it's difficult to change keypress event listeners to keydown event\nlisteners because if we stop keypress events at preceding keydown event in\nautocomplete or satchel module, some other modules fail to handle keydown or\nkeypress event before autocomplete and it's not easy to investigate which\nmodule's which keypress event listener should be changed to keydown event\nlistener.  Therefore, this patch doesn't do it at least for now.\n\nMozReview-Commit-ID: 7e3aklmKrXu", "files": ["toolkit/components/satchel/nsFormFillController.cpp", "toolkit/components/satchel/test/test_popup_enter_event.html", "toolkit/content/tests/chrome/test_autocomplete_mac_caret.xul", "toolkit/content/tests/mochitest/test_autocomplete_change_after_focus.html", "toolkit/content/widgets/autocomplete.xml"], "git_node": null, "git_parents": [null], "node": "a3f82738156799bf9bf3948f54f40a1b0a1fb4f2", "parents": ["92515b2d8a74ec96119209101319a8b21e06c44d"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1482425 - PresShell::PageMove() should use different rules to look for a container element for aExtend value. r=smaug a=jorgk DONTBUILD\n\nPresShell::PageMove() climbs up to parent document when there is no scrollable\nparent in current document.  However, if aExtend is true, it should expand\nSelection in the document itself.  Therefore, it needs different rules to\nlook for container of expanding Selection from scrollable element to scroll.\n\nAdditionally, old rules (i.e., before the fix of bug 1369072 which caused\nthis regression) were also buggy.  It used parent scrollable element or\nroot scrollable element simply.  Therefore, if found scrollable element is\nancestor of selection limiter, it didn't work as expected.\n\nThis patch creates nsFrameSelection::GetFrameToPageSelect() to retrieve\nper-page selection container element with the following rules:\n- look for a scrollable element in selection limiter.\n- if there is no scrollable element, use selection limiter.\n- if there is no selection limiter, use the root frame.\n\nSo, nsFrameSelection::CommonPageMove() should take nsIFrame rather than\nnsIScrollableFrame since container of per-page selection may be used in\nnon-scrollable contenteditable element.  If it's called with non-scrollable\nframe, it needs to compute the expanding range with the frame size.\n\nNote that this includes the fix of bug 1499996 (fixing random orange of the\nnew test).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8954", "files": ["dom/html/nsTextEditorState.cpp", "layout/base/PresShell.cpp", "layout/base/PresShell.h", "layout/base/tests/mochitest.ini", "layout/base/tests/test_expanding_selection_per_page.html", "layout/base/tests/window_empty_document.html", "layout/generic/nsFrameSelection.cpp", "layout/generic/nsFrameSelection.h"], "git_node": null, "git_parents": [null], "node": "ab014151d4c338562949c28aa140786b548856ca", "parents": ["a3f82738156799bf9bf3948f54f40a1b0a1fb4f2"], "tags": []}], "date": 1540498066, "git_changesets": [null, null], "user": "mozilla@jorgk.com"}, "223": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10050", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "be2281823d9007a314e175fedb7eac71a1034af3", "parents": ["6f1a76d107dc99e88ae7b1e031b858b7f8482c79"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1492639: Only run cron bouncer checks on mozilla-beta; r=sfraser,mtabara, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9137", "files": ["taskcluster/ci/cron-bouncer-check/kind.yml", "taskcluster/docs/attributes.rst", "taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "a2a92672233556b0caff27920b51286b601513b7", "parents": ["be2281823d9007a314e175fedb7eac71a1034af3"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1464061 - Return error immediately when plugin frame is destroyed. r=masayuki, a=RyanVM", "files": ["dom/plugins/base/nsPluginInstanceOwner.cpp"], "git_node": null, "git_parents": [null], "node": "d28761dbff18007122528330db5102769bd60c79", "parents": ["a2a92672233556b0caff27920b51286b601513b7"], "tags": []}], "date": 1540828306, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "224": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10543", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "4f6fe28ef42be4fb88ab65dac814b56e2863ef18", "parents": ["d28761dbff18007122528330db5102769bd60c79"], "tags": []}], "date": 1541080269, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "225": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10880", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "385f37ec0602a737173aff1308d1dfb2fcb6c7d9", "parents": ["4f6fe28ef42be4fb88ab65dac814b56e2863ef18"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1479853 - Prevent more than one VideoConduit having the same remote SSRC. r=ng, a=RyanVM", "files": ["media/webrtc/signaling/src/media-conduit/AudioConduit.h", "media/webrtc/signaling/src/media-conduit/MediaConduitInterface.h", "media/webrtc/signaling/src/media-conduit/VideoConduit.cpp", "media/webrtc/signaling/src/media-conduit/VideoConduit.h"], "git_node": null, "git_parents": [null], "node": "4faeb696dd0609448e0a4b4d9add05519c6e4117", "parents": ["385f37ec0602a737173aff1308d1dfb2fcb6c7d9"], "tags": []}], "date": 1541426259, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "226": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1501663 - Make HTMLEditor::GetSelectedElement() return nullptr when it finds different element or 2 or more elements in selected range. r=m_kato a=jorgk DONTBUILD\n\nThis back-ports:\n- https://hg.mozilla.org/integration/autoland/diff/eb94ff3abeca/editor/libeditor/HTMLEditor.cpp\n- https://hg.mozilla.org/integration/autoland/diff/d0cbbc6d2371/editor/libeditor/HTMLEditor.cpp\n- https://hg.mozilla.org/integration/autoland/diff/a7c1286bce7f/editor/libeditor/HTMLEditor.cpp\n- and the automated tests\n\nThis makes:\n- HTMLEditor::GetSelectedElement() return nullptr without error when it finds\n  different element from what the caller is looking for.\n- HTMLEditor::GetSelectedElement() return nullptr without error when it finds\n  second element node in the selected range.\n- HTMLEditor::GetElementOrParentByTagName() return only \u003ca\u003e element whose\n  href attribute value is not empty when the caller is looking for \"href\".\n- HTMLEditor::GetElementOrParentByTagName() return only \u003ca\u003e element whose\n  name attribute value is not empty when the caller is looking for \"anchor\" or\n  \"namedanchor\".", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/tests/mochitest.ini", "editor/libeditor/tests/test_nsIHTMLEditor_getSelectedElement.html"], "git_node": null, "git_parents": [null], "node": "c2e7cb0fa26db19e618c71c33e66b463ef8bf739", "parents": ["ab014151d4c338562949c28aa140786b548856ca"], "tags": []}], "date": 1541500392, "git_changesets": [null], "user": "mozilla@jorgk.com"}, "227": {"changesets": [{"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1503687 - Avoid python attribute errors for some infrequent xpcshell timeouts. r=jmaher, a=test-only", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": null, "git_parents": [null], "node": "5d185d5837ec10f5f9ff80fe17043acd53a4a20b", "parents": ["4faeb696dd0609448e0a4b4d9add05519c6e4117"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453895 - Avoid reftest startup hang waiting for focus. r=jmaher, a=test-only\n\nIntermittently, at least on Windows, reftest.jsm finds that the reftest.xul\nwindow is not focused on startup; focus seems to be on the dummy about:blank\nwindow. This patch tries to detect that condition and correct it by bringing\nreftest.xul (g.containingWindow) into focus before specifically focusing\nthe browser element (g.browser).", "files": ["layout/tools/reftest/reftest.jsm"], "git_node": null, "git_parents": [null], "node": "6b64af95c34fbad1ad4e9917186ec1890ee944ff", "parents": ["5d185d5837ec10f5f9ff80fe17043acd53a4a20b"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459891 - Routinely update in-tree TLD list. r=RyanVM,jlorenzo, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9385", "files": ["taskcluster/ci/repo-update/kind.yml", "taskcluster/docker/periodic-updates/runme.sh", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "9491263a845f2bab77ce68f0ff27b871874aaf6b", "parents": ["6b64af95c34fbad1ad4e9917186ec1890ee944ff"], "tags": []}], "date": 1541617556, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "228": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D11313", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "3d73a2c6f57dff1264aaf153310c4eccdbae3652", "parents": ["9491263a845f2bab77ce68f0ff27b871874aaf6b"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1488295 - Vendor in texture completeness cherry-pick. r=kvark, a=RyanVM", "files": ["gfx/angle/checkout/out/gen/angle/id/commit.h", "gfx/angle/checkout/src/libANGLE/Context.cpp", "gfx/angle/checkout/src/libANGLE/Texture.cpp", "gfx/angle/checkout/src/libANGLE/Texture.h", "gfx/angle/checkout/src/libANGLE/renderer/TextureImpl.h", "gfx/angle/checkout/src/libANGLE/renderer/d3d/TextureD3D.cpp", "gfx/angle/checkout/src/libANGLE/renderer/d3d/TextureD3D.h", "gfx/angle/checkout/src/libANGLE/renderer/renderer_utils.cpp", "gfx/angle/cherries.log", "gfx/angle/update-angle.py"], "git_node": null, "git_parents": [null], "node": "12ba39f69876424488db4fcda840081a6b47c6a5", "parents": ["3d73a2c6f57dff1264aaf153310c4eccdbae3652"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1500011 - Use CheckedInt more in CalculateBufferSizeForImage. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D9145", "files": ["dom/base/nsContentUtils.cpp"], "git_node": null, "git_parents": [null], "node": "a0adabeedf260e5fa0c439bc02d5e104ae07c0ae", "parents": ["12ba39f69876424488db4fcda840081a6b47c6a5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1503082 - Clear CanvasShutdownObserver::mCanvas when the canvas goes away. r=nical, a=RyanVM\n\nIt is possible for the CanvasRenderingContext2D to be destroyed while\nwe're in the middle of the call to nsObserverService::NotifyObservers()\nfor shutdown. This leaves the shutdown observer with a dangling pointer\nto the canvas, so this patch explicitly clears the pointer when the\ncontext goes away.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10777", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": null, "git_parents": [null], "node": "19604eb2623091a37d8c5fb92a52bd02e457562b", "parents": ["a0adabeedf260e5fa0c439bc02d5e104ae07c0ae"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1499861 - Make HTMLOptionsCollection::mSelect into a strong reference. r=qDot, a=RyanVM\n\nThe cycle collector makes weak references like this obsolete.", "files": ["dom/html/HTMLOptionsCollection.cpp", "dom/html/HTMLOptionsCollection.h", "dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h"], "git_node": null, "git_parents": [null], "node": "98737ab09270ba66e4b0a7310b91fe615fd8dd69", "parents": ["19604eb2623091a37d8c5fb92a52bd02e457562b"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1504452 - Fix GrGLGpu buffer offset calculations. r=rhunt, a=RyanVM", "files": ["gfx/skia/skia/src/gpu/gl/GrGLGpu.cpp"], "git_node": null, "git_parents": [null], "node": "1cf7d80355d55a5f935b17f37ca875baaf1646e0", "parents": ["98737ab09270ba66e4b0a7310b91fe615fd8dd69"], "tags": []}, {"author": "Jeff Walden \u003cjwalden@mit.edu\u003e", "branch": "default", "desc": "Bug 1494752. r=jonco, a=RyanVM", "files": ["js/src/frontend/Parser.cpp", "js/src/vm/Scope.cpp"], "git_node": null, "git_parents": [null], "node": "c264774b89130cd7759c40977835e2a0d32fd684", "parents": ["1cf7d80355d55a5f935b17f37ca875baaf1646e0"], "tags": []}], "date": 1541688155, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "229": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1477773 - No-op visited changes earlier if visited links are disabled. r=xidorn, a=lizzard\n\nWe force a repaint from ContentStateChangedInternal if visited links are\ndisabled, and that's observable. Let's cut it off as early as we can to avoid\ntiming attacks even when :visited is disabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3304", "files": ["layout/base/ServoRestyleManager.cpp", "layout/style/ServoBindings.cpp", "layout/style/ServoBindings.h", "servo/components/style/gecko/data.rs", "servo/components/style/invalidation/element/state_and_attributes.rs"], "git_node": null, "git_parents": [null], "node": "ec13fda7c9b0089134426f048c1376585dfd70b4", "parents": ["c264774b89130cd7759c40977835e2a0d32fd684"], "tags": []}, {"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "default", "desc": "Bug 1501680 - Don't send credentials in ssl error reports. r=Gijs, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D10594", "files": ["security/manager/ssl/tests/unit/test_toolkit_securityreporter.js", "toolkit/components/securityreporter/SecurityReporter.js"], "git_node": null, "git_parents": [null], "node": "6de53c935cfa65adb3bc2ef2ffa905e3606aff7f", "parents": ["ec13fda7c9b0089134426f048c1376585dfd70b4"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1490567 - Update ffi build to handle x86 MinGW-clang builds. r=glandium, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5643", "files": ["config/external/ffi/moz.build"], "git_node": null, "git_parents": [null], "node": "896a6b159815e5511c4845a4085be2ba8329f91f", "parents": ["6de53c935cfa65adb3bc2ef2ffa905e3606aff7f"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1490568 - Quote the _PrepareAndDispatch symbol to fix the mingw-clang x86 build. r=dmajor, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6045", "files": ["xpcom/reflect/xptcall/md/win32/xptcstubs.cpp"], "git_node": null, "git_parents": [null], "node": "5e6ad4f72b5dd6e837c8fef49e03ea15b9077a84", "parents": ["896a6b159815e5511c4845a4085be2ba8329f91f"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1490566 - Do not pass --enable-stdcall-fixup to clang in a x86 Windows build. r=froydnj, a=lizzard\n\nclang doesn't recognize --enable-stdcall-fixup as an option. We needed this for the\nmingw-gcc build (added in Bug 787653) because gcc had difficulty dealing with\nAngle's symbol linking\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6072", "files": ["old-configure.in"], "git_node": null, "git_parents": [null], "node": "55fb1f4492a658fa77e8e227bac645afc13c9ab2", "parents": ["5e6ad4f72b5dd6e837c8fef49e03ea15b9077a84"], "tags": []}], "date": 1541714917, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "230": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491856 Change .scl 3 -\u003e .scl 2 in the reflect assembly. r=dmajor, a=lizzard\n\nAs in Bug 1390583 and Bug 1470993, this will correct them to be external symbols\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6044", "files": ["xpcom/reflect/xptcall/md/win32/xptcstubs.cpp"], "git_node": null, "git_parents": [null], "node": "1325a6954b87e898271f78d15d10c231363afe57", "parents": ["55fb1f4492a658fa77e8e227bac645afc13c9ab2"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491846 - GetFrameLoader inside child objects vtbls could not be resolved by linker. It looks like a clang bug, but requires closer look. I worked around it by having explicit forwards. r=smaug, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6051", "files": ["dom/html/HTMLEmbedElement.h", "dom/html/HTMLFrameElement.h", "dom/html/HTMLObjectElement.h"], "git_node": null, "git_parents": [null], "node": "27f9d9a5e91e51f0c644965182c202921f4a297c", "parents": ["1325a6954b87e898271f78d15d10c231363afe57"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1500759 - Root parameter dictionaries in AesTask::Init(). r=keeler, a=lizzard", "files": ["dom/crypto/WebCryptoTask.cpp"], "git_node": null, "git_parents": [null], "node": "5e1a9644aeef3c38b34a81abb3ab2a931266b487", "parents": ["27f9d9a5e91e51f0c644965182c202921f4a297c"], "tags": []}], "date": 1541718081, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "231": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1485655 - Remove an assertion that doesn't hold in some cases. r=me, a=RyanVM", "files": ["servo/components/style/invalidation/element/state_and_attributes.rs"], "git_node": null, "git_parents": [null], "node": "9055726e2d89e54a135b28d9c2dc4162a129fa1b", "parents": ["5e1a9644aeef3c38b34a81abb3ab2a931266b487"], "tags": []}], "date": 1541718369, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "232": {"changesets": [{"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1410214: Part 1 - Implement support for WebExtension-style 