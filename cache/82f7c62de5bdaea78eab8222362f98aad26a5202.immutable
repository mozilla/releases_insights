iles": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "3bc7b6c407396db55a469e79b2bcb44af5582956", "git_parents": ["7ba32f14daf028514a8b37a49f917928eaf7a4b4"], "node": "5a9343c87c86051e28897137f51fed5ecf3d985b", "parents": ["c5a5c236b0b95cb0d94056a375fad0531a9c6d9c"], "tags": []}], "date": 1747311290, "git_changesets": ["3bc7b6c407396db55a469e79b2bcb44af5582956"], "user": "rvandermeulen@mozilla.com"}, "664": {"changesets": [{"author": "DIinna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "No bug - Bump version to 115.23.1 a=me\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "513ba91589d1b38ab3de3f075be7fc3ed377aeb4", "git_parents": [null], "node": "08277daac4b366f86278f08deca5aa7628448b0f", "parents": ["b235e5bb5b5b2c9f05b350d1642d4813a778ae61"], "tags": []}], "date": 1747400468, "git_changesets": ["513ba91589d1b38ab3de3f075be7fc3ed377aeb4"], "user": "dsmith@mozilla.com"}, "665": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966612 - Fix promise combinator function state.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D249782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249824\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "e999f9bd4bfd5850fcab3e2b247a6e9e93739ca7", "git_parents": ["3bc7b6c407396db55a469e79b2bcb44af5582956"], "node": "bad446550e1ab3a13d6ffe55a4d7b1ad27b71ffb", "parents": ["5a9343c87c86051e28897137f51fed5ecf3d985b"], "tags": []}], "date": 1747417244, "git_changesets": ["e999f9bd4bfd5850fcab3e2b247a6e9e93739ca7"], "user": "rvandermeulen@mozilla.com"}, "666": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: rename `release_version_bump` transform to reflect reality  a=dsmith\n\nThis transform may have been specific to `release_version_bump` at some point, but it's certainly not at this point, so rename it.\n\nIt almost seems silly for it to exist at all, but I was unable to replace it with `task-context`, so this rename will have to do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247399\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/ci/release-version-bump/kind.yml", "taskcluster/gecko_taskgraph/transforms/release_version_bump.py", "taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py"], "git_node": "db802ca6d24fea9b04ad314fbff5c1a3c279d0df", "git_parents": ["513ba91589d1b38ab3de3f075be7fc3ed377aeb4"], "node": "6fefd70ae427559a6869a0b6fe6752bbee311dad", "parents": ["08277daac4b366f86278f08deca5aa7628448b0f"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: add landoscript worker type and payload builder  a=dsmith\n\nThe payload builder is created here, but fully stubbed out. Descendent revisions will implement it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247400\n", "files": ["taskcluster/ci/config.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "d6f242e00a4e4aa9b0de524657b33206287bac7e", "git_parents": ["db802ca6d24fea9b04ad314fbff5c1a3c279d0df"], "node": "2b5bd1dc560a94776cee5d83a9079bef047f9462", "parents": ["6fefd70ae427559a6869a0b6fe6752bbee311dad"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: switch l10n-bump tasks to landoscript  a=dsmith\n\nAside from the addition of scopes and `lando-repo`, most of the changes to the kind are dropping attributes that do not add to the payload (`bump`, `tags`, `push`, `version-path`). `push` theoretically could have been supported, but I don't see any need for it seeing as all `landoscript` actions support a `dry_run` mode. (We don't actually ever use it for `l10n-bump`, but it's there if we want to in the future...)\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=l10n-bump&revision=2ab614bee5807309146d40188ba8766838205e98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247401\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "12c5404a14db55afdb276b39dd6e408d28cbe30c", "git_parents": ["d6f242e00a4e4aa9b0de524657b33206287bac7e"], "node": "ac4c7a610f435650adfd36922f0d49fc65482ebc", "parents": ["2b5bd1dc560a94776cee5d83a9079bef047f9462"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: switch release-early-tagging to landoscript  a=dsmith\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=early-tagging&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247402\n", "files": ["taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "5d028fc2fde91d1543a198195fd21fb6cdc1152b", "git_parents": ["12c5404a14db55afdb276b39dd6e408d28cbe30c"], "node": "302b65caacd8df197aa07a6c9ec5d14e80efb17f", "parents": ["ac4c7a610f435650adfd36922f0d49fc65482ebc"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: switch release-version-bump to landoscript  a=dsmith\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=version-bump&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247403\n", "files": ["taskcluster/ci/release-version-bump/kind.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "181069b7188486e8e8788d4c75a19b69e0bc4bd2", "git_parents": ["5d028fc2fde91d1543a198195fd21fb6cdc1152b"], "node": "14bef960be90f9b2c95a725a57badf1a2ad21936", "parents": ["302b65caacd8df197aa07a6c9ec5d14e80efb17f"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1964060: fallback to github when tags can't be found on hg.m.o in update verify config creator  a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247618\n", "files": ["testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": "b70475502ae8a06ec016b51bdb29c268f23d94f2", "git_parents": ["181069b7188486e8e8788d4c75a19b69e0bc4bd2"], "node": "409eba15f75c526ee044174c0750b8215cc926f2", "parents": ["14bef960be90f9b2c95a725a57badf1a2ad21936"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: switch merge-automation tasks to landoscript  a=dmeehan DONTBUILD\n\nSimilar to when other tasks were switched to landoscript, most of the changes to the kind (and some of the other files) are just dropping now-pointless attributes like `ssh-user-alias`.\n\nThere's two primary things of note here:\n* The change to the `bump-esr128` merge config to ensure the `esr` suffix is included in the display version. This fixes a bug that was present even in treescript.\n* The new logic in the payload builder to add the correct scopes. This should work for all `landoscript` tasks, and I will be removing the scopes in the other kinds in a descendent revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248301\n", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/merge-automation/kind.yml", "taskcluster/gecko_taskgraph/actions/merge_automation.py", "taskcluster/gecko_taskgraph/config.py", "taskcluster/gecko_taskgraph/transforms/merge_automation.py", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "e4a17fca2cb2c56b6d253555ac349cbae1720bd0", "git_parents": ["b70475502ae8a06ec016b51bdb29c268f23d94f2"], "node": "d2fe3689235fb6b161d9c105123262337ae84ae4", "parents": ["409eba15f75c526ee044174c0750b8215cc926f2"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: use correct `to-branch` in merge-automation on try  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248302\n", "files": ["taskcluster/ci/merge-automation/kind.yml"], "git_node": "f9170a57a923085d577b69c3a91c1c92ec123c23", "git_parents": ["e4a17fca2cb2c56b6d253555ac349cbae1720bd0"], "node": "4447afa44972d2709a7f2d7682554ed36fb9b538", "parents": ["d2fe3689235fb6b161d9c105123262337ae84ae4"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: drop unnecessary scopes from landoscript tasks  a=dsmith\n\nAn earlier revision in this stack will automatically add them in the payload builder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248303\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/ci/release-version-bump/kind.yml"], "git_node": "d1b4251a19e8c40a86733aed83973aa0321f47c1", "git_parents": ["f9170a57a923085d577b69c3a91c1c92ec123c23"], "node": "617c37fe8f4bb8f1f4faae74e33e61a40bb9acad", "parents": ["4447afa44972d2709a7f2d7682554ed36fb9b538"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1948315: change non-merge-automation landoscript tasks to use correct lando repo on try  a=dsmith\n\nThis is not technically related to the bug at hand, but the clean up may as well get done here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248304\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/ci/release-version-bump/kind.yml"], "git_node": "25cd9ecac888b8ab6afbea65b5c2f0f683dcd43b", "git_parents": ["d1b4251a19e8c40a86733aed83973aa0321f47c1"], "node": "b650111dba6e2e4ca615c0bbdbf007781d42a93f", "parents": ["617c37fe8f4bb8f1f4faae74e33e61a40bb9acad"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1965843: add esr suffix in bump-esr115 action r=jcristau a=dsmith\n\nIn https://bugzilla.mozilla.org/show_bug.cgi?id=1948315, my backport of merge-automation support to esr115 was slightly incomplete: I missed the line where we set new-suffix: \"esr\" to ensure that version bumps get the correct value into version_display.txt. This results in diffs such as:\n\n```\ndiff --git a/config/milestone.txt b/config/milestone.txt\n--- a/config/milestone.txt\n+++ b/config/milestone.txt\n@@ -10,4 +10,4 @@\n # hardcoded milestones in the tree from these two files.\n #--------------------------------------------------------\n\n-115.24.0\n+115.25.0\ndiff --git a/browser/config/version.txt b/browser/config/version.txt\n--- a/browser/config/version.txt\n+++ b/browser/config/version.txt\n@@ -1 +1 @@\n-115.24.0\n+115.25.0\ndiff --git a/browser/config/version_display.txt b/browser/config/version_display.txt\n--- a/browser/config/version_display.txt\n+++ b/browser/config/version_display.txt\n@@ -1 +1 @@\n-115.24.0esr\n+115.25.0\n```\n\n...which aren't correct.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248916\n", "files": ["taskcluster/ci/config.yml"], "git_node": "7acac9335f26e9b6467f7839674d25d1d420647c", "git_parents": ["25cd9ecac888b8ab6afbea65b5c2f0f683dcd43b"], "node": "fc50501a6b440ae12d653e97c97387434b84696a", "parents": ["b650111dba6e2e4ca615c0bbdbf007781d42a93f"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1943670: Migrate mozharness unit tests from tox -\u003e ./mach python-test, r=ahal a=dsmith\n\nThis is a backport of the original patch from this bug, and also a removal of a couple of tests that weren't passing for me locally, and I doubt are important enough to debug.\n\nI wasn't able to test this on try due to https://bugzilla.mozilla.org/show_bug.cgi?id=1948030; it's possible they would've passed there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248367\n", "files": ["js/src/make-source-package.py", "taskcluster/ci/source-test/python.yml", "testing/moz.build", "testing/mozharness/moz.build", "testing/mozharness/test/python.ini", "testing/mozharness/test/test_base_config.py", "testing/mozharness/test/test_base_diskutils.py", "testing/mozharness/test/test_base_log.py", "testing/mozharness/test/test_base_parallel.py", "testing/mozharness/test/test_base_python.py", "testing/mozharness/test/test_base_script.py", "testing/mozharness/test/test_base_vcs_mercurial.py", "testing/mozharness/test/test_l10n_locales.py", "testing/mozharness/test/test_mozilla_automation.py", "testing/mozharness/test/test_mozilla_building_buildbase.py", "testing/mozharness/test/test_mozilla_merkle.py", "testing/mozharness/test/test_mozilla_structured.py", "testing/mozharness/tox.ini"], "git_node": "8a9badc6ce3d232a470195c98d7266d302703496", "git_parents": ["7acac9335f26e9b6467f7839674d25d1d420647c"], "node": "981658b2e65287d892f967665da27abfd9709b8e", "parents": ["fc50501a6b440ae12d653e97c97387434b84696a"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1943670: Migrate mozharness unit tests from tox -\u003e ./mach python-test, r=ahal a=dsmith\n\nThis is a backport of the original patch from this bug, and also a removal of a couple of tests that weren't passing for me locally, and I doubt are important enough to debug.\n\nI wasn't able to test this on try due to https://bugzilla.mozilla.org/show_bug.cgi?id=1948030; it's possible they would've passed there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248367\n", "files": ["testing/mozharness/test/test_base_diskutils.py", "testing/mozharness/test/test_base_parallel.py", "testing/mozharness/test/test_base_script.py"], "git_node": "7c232a0bc64ac217e50fa895c72966c2c5a2c532", "git_parents": ["8a9badc6ce3d232a470195c98d7266d302703496"], "node": "df6962e15b65eaf4dfca28f51311ced2ff0fb350", "parents": ["981658b2e65287d892f967665da27abfd9709b8e"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Bug 1966612 - Fix promise combinator function state.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D249782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249824\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "40af230319ed0057f1f91ebb83cd1b0056a37de0", "git_parents": ["7c232a0bc64ac217e50fa895c72966c2c5a2c532"], "node": "b8343b8f27306fb4a107e72670c3582f7d0f8b89", "parents": ["df6962e15b65eaf4dfca28f51311ced2ff0fb350"], "tags": []}], "date": 1747429356, "git_changesets": ["db802ca6d24fea9b04ad314fbff5c1a3c279d0df", "d6f242e00a4e4aa9b0de524657b33206287bac7e", "12c5404a14db55afdb276b39dd6e408d28cbe30c", "5d028fc2fde91d1543a198195fd21fb6cdc1152b", "181069b7188486e8e8788d4c75a19b69e0bc4bd2", "b70475502ae8a06ec016b51bdb29c268f23d94f2", "e4a17fca2cb2c56b6d253555ac349cbae1720bd0", "f9170a57a923085d577b69c3a91c1c92ec123c23", "d1b4251a19e8c40a86733aed83973aa0321f47c1", "25cd9ecac888b8ab6afbea65b5c2f0f683dcd43b", "7acac9335f26e9b6467f7839674d25d1d420647c", "8a9badc6ce3d232a470195c98d7266d302703496", "7c232a0bc64ac217e50fa895c72966c2c5a2c532", "40af230319ed0057f1f91ebb83cd1b0056a37de0"], "user": "dsmith@mozilla.com"}, "667": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Revert \"Bug 1943670: Migrate mozharness unit tests from tox -\u003e ./mach python-test, r=ahal a=dsmith\", a=backout\n\nThis reverts commit 7c232a0bc64ac217e50fa895c72966c2c5a2c532.\n", "files": ["testing/mozharness/test/test_base_diskutils.py", "testing/mozharness/test/test_base_parallel.py", "testing/mozharness/test/test_base_script.py"], "git_node": "1de297df5374eff57da4ffde0e8bd79ca6622545", "git_parents": ["40af230319ed0057f1f91ebb83cd1b0056a37de0"], "node": "eea7cb827aad3ac31724d6606b029b796a08e74b", "parents": ["b8343b8f27306fb4a107e72670c3582f7d0f8b89"], "tags": []}, {"author": "Narcis Beleuzu \u003cnbeleuzu@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_23_X_RELBRANCH", "desc": "Revert \"Bug 1943670: Migrate mozharness unit tests from tox -\u003e ./mach python-test, r=ahal a=RyanVM\" for lint failure on test_base_diskutils.py\n\nThis reverts commit 99cedbbda7339fdb53c75ac438fa6e136ddaaf7a.\n", "files": ["js/src/make-source-package.py", "taskcluster/ci/source-test/python.yml", "testing/moz.build", "testing/mozharness/moz.build", "testing/mozharness/test/python.ini", "testing/mozharness/test/test_base_config.py", "testing/mozharness/test/test_base_diskutils.py", "testing/mozharness/test/test_base_log.py", "testing/mozharness/test/test_base_parallel.py", "testing/mozharness/test/test_base_python.py", "testing/mozharness/test/test_base_script.py", "testing/mozharness/test/test_base_vcs_mercurial.py", "testing/mozharness/test/test_l10n_locales.py", "testing/mozharness/test/test_mozilla_automation.py", "testing/mozharness/test/test_mozilla_building_buildbase.py", "testing/mozharness/test/test_mozilla_merkle.py", "testing/mozharness/test/test_mozilla_structured.py", "testing/mozharness/tox.ini"], "git_node": "931528bf938c4c8937a6e518543ab2cb5ef2bc31", "git_parents": ["1de297df5374eff57da4ffde0e8