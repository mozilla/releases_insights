s:52463:"{
"lastpushid": 1568,
"pushes": {"640": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging b235e5bb5b5b2c9f05b350d1642d4813a778ae61 with FIREFOX_115_23_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "62722770f13033680ac87fa5372a845349b02a24", "parents": ["b235e5bb5b5b2c9f05b350d1642d4813a778ae61"], "tags": []}], "date": 1745254762, "git_changesets": [null], "user": "ffxbld"}, "641": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "7a6e97bc1d99547879a9fa2c91560f54f94c6666", "parents": ["62722770f13033680ac87fa5372a845349b02a24"], "tags": []}], "date": 1745848412, "git_changesets": [null], "user": "ffxbld-merge"}, "642": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging b235e5bb5b5b2c9f05b350d1642d4813a778ae61 with FIREFOX_115_23_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b3468499cca0fc98a2b5f34849a39a7d6f6b745c", "parents": ["7a6e97bc1d99547879a9fa2c91560f54f94c6666"], "tags": []}], "date": 1745931408, "git_changesets": [null], "user": "ffxbld"}, "643": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246921", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "913ef4066aa9bad3798ccd34cebc34e1cebac4c5", "parents": ["b3468499cca0fc98a2b5f34849a39a7d6f6b745c"], "tags": []}], "date": 1745936840, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "644": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1958292 - Don't use the observer service for forget skippable cleanup.  a=RyanVM\n\nIt appears that calling UnmarkGrayStrongObservers while inside an observer can\ncause crashes. This will only happen for the forget skippable cleanup, so this\npatch splits out a separate cleanup method, adds a new static variable to hold\na pointer to the marker static instance, and adds a new static method to call\nthe cleanup method on the static instance.\n\nThere are no other uses of cycle-collector-forget-skippable so I get rid of it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246437\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246751", "files": ["dom/base/nsCCUncollectableMarker.cpp", "dom/base/nsCCUncollectableMarker.h", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": null, "git_parents": [null], "node": "1b70b3a79047b11a0485b4c43f4619b86d832145", "parents": ["913ef4066aa9bad3798ccd34cebc34e1cebac4c5"], "tags": []}], "date": 1745943964, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "645": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1960745 - Part 1: Do not perform side-effectful operations while converting muted errors into error reports.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246071\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246539", "files": ["js/src/jsexn.cpp"], "git_node": null, "git_parents": [null], "node": "4ef90ebe25f8d3dca1bc6e2ef21afc6991f5e75e", "parents": ["1b70b3a79047b11a0485b4c43f4619b86d832145"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1960745 - Part 2: Add Debugger.Object.isMutedError.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246072\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246540", "files": ["js/src/debugger/Object.cpp", "js/src/debugger/Object.h", "js/src/doc/Debugger/Debugger.Object.md"], "git_node": null, "git_parents": [null], "node": "8ae9860e9b7f80b81fc33eee1244eb29e045b6d0", "parents": ["4ef90ebe25f8d3dca1bc6e2ef21afc6991f5e75e"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1960745 - Part 3: Do not perform side-effectful operations while creating preview for muted errors.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246073\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246541", "files": ["devtools/server/actors/object/previewers.js"], "git_node": null, "git_parents": [null], "node": "606f0b9fca982e4d20025d042084715207da8def", "parents": ["8ae9860e9b7f80b81fc33eee1244eb29e045b6d0"], "tags": []}], "date": 1745970286, "git_changesets": [null, null, null], "user": "rvandermeulen@mozilla.com"}, "646": {"changesets": [{"author": "Zeid \u003czeid@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963595: update .arcconfig to point to new repo r=shtrom a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247288\n", "files": [".arcconfig"], "git_node": "a00af8ec661aaf28f71bdbebc8c4c494b74e7024", "git_parents": [null], "node": "2237e8ff4a7697f1b036a6409fd0badbdb66c889", "parents": ["606f0b9fca982e4d20025d042084715207da8def"], "tags": []}], "date": 1746027666, "git_changesets": ["a00af8ec661aaf28f71bdbebc8c4c494b74e7024"], "user": "zzabaneh@mozilla.com"}, "647": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: rename `release_version_bump` transform to reflect reality  a=RyanVM\n\nThis transform may have been specific to `release_version_bump` at some point, but it's certainly not at this point, so rename it.\n\nIt almost seems silly for it to exist at all, but I was unable to replace it with `task-context`, so this rename will have to do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247399\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/ci/release-version-bump/kind.yml", "taskcluster/gecko_taskgraph/transforms/release_version_bump.py", "taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py"], "git_node": "7dfcf4067791cee4011a336976a9f088284418fd", "git_parents": ["a00af8ec661aaf28f71bdbebc8c4c494b74e7024"], "node": "073d527ad981562b115008fd55a413e9b1c4b907", "parents": ["2237e8ff4a7697f1b036a6409fd0badbdb66c889"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: add landoscript worker type and payload builder  a=RyanVM\n\nThe payload builder is created here, but fully stubbed out. Descendent revisions will implement it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247400\n", "files": ["taskcluster/ci/config.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "c0d4701f0ad47ebc337a44cac807dad36b614f4e", "git_parents": ["7dfcf4067791cee4011a336976a9f088284418fd"], "node": "87e1903cdd140af778f97b1a9e48cf637dd27f66", "parents": ["073d527ad981562b115008fd55a413e9b1c4b907"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch l10n-bump tasks to landoscript  a=RyanVM\n\nAside from the addition of scopes and `lando-repo`, most of the changes to the kind are dropping attributes that do not add to the payload (`bump`, `tags`, `push`, `version-path`). `push` theoretically could have been supported, but I don't see any need for it seeing as all `landoscript` actions support a `dry_run` mode. (We don't actually ever use it for `l10n-bump`, but it's there if we want to in the future...)\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=l10n-bump&revision=2ab614bee5807309146d40188ba8766838205e98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247401\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "89ee678c474acee5ba2721e4b0985cffc3b503de", "git_parents": ["c0d4701f0ad47ebc337a44cac807dad36b614f4e"], "node": "d1ea99d4ae0357915557e8a7d1bcd98a906d7ecc", "parents": ["87e1903cdd140af778f97b1a9e48cf637dd27f66"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch release-early-tagging to landoscript  a=RyanVM\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=early-tagging&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247402\n", "files": ["taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "73c58900108508e8213fe9948ae0ab4ef48b3a67", "git_parents": ["89ee678c474acee5ba2721e4b0985cffc3b503de"], "node": "a025789feb2db823e2addf6671b4280fb2087d89", "parents": ["d1ea99d4ae0357915557e8a7d1bcd98a906d7ecc"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch release-version-bump to landoscript  a=RyanVM\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=version-bump&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247403\n", "files": ["taskcluster/ci/release-version-bump/kind.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "0f2097d5eb17ad173bcee16f53482631d5a87a58", "git_parents": ["73c58900108508e8213fe9948ae0ab4ef48b3a67"], "node": "f44fc7613a8413672887a9c2e1ca50add532ac04", "parents": ["a025789feb2db823e2addf6671b4280fb2087d89"], "tags": []}], "date": 1746056835, "git_changesets": ["7dfcf4067791cee4011a336976a9f088284418fd", "c0d4701f0ad47ebc337a44cac807dad36b614f4e", "89ee678c474acee5ba2721e4b0985cffc3b503de", "73c58900108508e8213fe9948ae0ab4ef48b3a67", "0f2097d5eb17ad173bcee16f53482631d5a87a58"], "user": "rvandermeulen@mozilla.com"}, "648": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964060: fallback to github when tags can't be found on hg.m.o in update verify config creator  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247618\n", "files": ["testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": "341df6137ddbfea2f9ecaf49fb47a41f6ed5bc5e", "git_parents": ["0f2097d5eb17ad173bcee16f53482631d5a87a58"], "node": "77e052aeb1a613fc265367f073ebbc6790828844", "parents": ["f44fc7613a8413672887a9c2e1ca50add532ac04"], "tags": []}], "date": 1746482867, "git_changesets": ["341df6137ddbfea2f9ecaf49fb47a41f6ed5bc5e"], "user": "rvandermeulen@mozilla.com"}, "649": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247744\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "93b733f501fb7304b7d35d3c4575696bb2c0f835", "git_parents": ["341df6137ddbfea2f9ecaf49fb47a41f6ed5bc5e"], "node": "fd67b73ff62c552958675e9fc301b2c762c54d35", "parents": ["77e052aeb1a613fc265367f073ebbc6790828844"], "tags": []}], "date": 1746548759, "git_changesets": ["93b733f501fb7304b7d35d3c4575696bb2c0f835"], "user": "rvandermeulen@mozilla.com"}, "650": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248403\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "50cd6eb2f056cb561e9aa96935f5e1798f1f6bf8", "git_parents": ["93b733f501fb7304b7d35d3c4575696bb2c0f835"], "node": "61d876716af3765f66609e1ab17949ea13ba3207", "parents": ["fd67b73ff62c552958675e9fc301b2c762c54d35"], "tags": []}], "date": 1746705626, "git_changesets": ["50cd6eb2f056cb561e9aa96935f5e1798f1f6bf8"], "user": "dmeehan@mozilla.com"}, "651": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch merge-automation tasks to landoscript  a=dmeehan DONTBUILD\n\nSimilar to when other tasks were switched to landoscript, most of the changes to the kind (and some of the other files) are just dropping now-pointless attributes like `ssh-user-alias`.\n\nThere's two primary things of note here:\n* The change to the `bump-esr128` merge config to ensure the `esr` suffix is included in the display version. This fixes a bug that was present even in treescript.\n* The new logic in the payload builder to add the correct scopes. This should work for all `landoscript` tasks, and I will be removing the scopes in the other kinds in a descendent revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248301\n", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/merge-automation/kind.yml", "taskcluster/gecko_taskgraph/actions/merge_automation.py", "taskcluster/gecko_taskgraph/config.py", "taskcluster/gecko_taskgraph/transforms/merge_automation.py", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "f1f12cf689a559c27a9f173a735c6a37be7f3743", "git_parents": ["50cd6eb2f056cb561e9aa96935f5e1798f1f6bf8"], "node": "05ae229f34bd79c46f73b6e56d0a7332dc0428ac", "parents": ["61d876716af3765f66609e1ab17949ea13ba3207"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: use correct `to-branch` in merge-automation on try  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248302\n", "files": ["taskcluster/ci/merge-automation/kind.yml"], "git_node": "1270a51b51750ea2ae3230e701d3eb45f69c9f3e", "git_parents": ["f1f12cf689a559c27a9f173a735c6a37be7f3743"], "node": "4b5230fce8a3f0aa99adbc8ad63c01af8bfde0f7", "parents": ["05ae229f34bd79c46f73b6e56d0a7332dc0428ac"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: drop unnecessary scopes from landoscript tasks  a=dmeehan DONTBUILD\n\nAn earlier revision in this stack will automatically add them in the payload builder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248303\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/ci/release-version-bump/kind.yml"], "git_node": "dcd64ddb4cf63a492e243b301b4f5907bf30e1ce", "git_parents": ["1270a51b51750ea2ae3230e701d3eb45f69c9f3e"], "node": "8dd3d3ff20e395fbc9ca8a0eb8703a64dba4fec6", "parents": ["4b5230fce8a3f0aa99adbc8ad63c01af8bfde0f7"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: change non-merge-automation landoscript tasks to use correct lando repo on try  a=dmeehan DONTBUILD\n\nThis is not technically related to the bug at hand, but the clean up may as well get done here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248304\n", "files": ["taskcluster/ci/l10n-bump/kind.yml", "taskcluster/ci/release-early-tagging/kind.yml", "taskcluster/ci/release-version-bump/kind.yml"], "git_node": "52a21fee786b477eea0f39193c6d09b1301bc5f8", "git_parents": ["dcd64ddb4cf63a492e243b301b4f5907bf30e1ce"], "node": "077f2fd0d81fbbed4675f46b1105621c26ab6a9d", "parents": ["8dd3d3ff20e395fbc9ca8a0eb8703a64dba4fec6"], "tags": []}], "date": 1747051462, "git_changesets": ["f1f12cf689a559c27a9f173a735c6a37be7f3743", "1270a51b51750ea2ae3230e701d3eb45f69c9f3e", "dcd64ddb4cf63a492e243b301b4f5907bf30e1ce", "52a21fee786b477eea0f39193c6d09b1301bc5f8"], "user": "dmeehan@mozilla.com"}, "652": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248873\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "716165de8b5d87db43706b6bd5903735055a0eeb", "git_parents": ["52a21fee786b477eea0f39193c6d09b1301bc5f8"], "node": "45b76dfaa62d840ecddae1cec0e6c22045483df2", "parents": ["077f2fd0d81fbbed4675f46b1105621c26ab6a9d"], "tags": []}], "date": 1747051646, "git_changesets": ["716165de8b5d87db43706b6bd5903735055a0eeb"], "user": "dmeehan@mozilla.com"}, "653": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965843: add esr suffix in bump-esr115 action r=jcristau a=dmeehan DONTBUILD\n\nIn https://bugzilla.mozilla.org/show_bug.cgi?id=1948315, my backport of merge-automation support to esr115 was slightly incomplete: I missed the line where we set new-suffix: \"esr\" to ensure that version bumps get the correct value into version_display.txt. This results in diffs such as:\n\n```\ndiff --git a/config/milestone.txt b/config/milestone.txt\n--- a/config/milestone.txt\n+++ b/config/milestone.txt\n@@ -10,4 +10,4 @@\n # hardcoded milestones in the tree from these two files.\n #--------------------------------------------------------\n\n-115.24.0\n+115.25.0\ndiff --git a/browser/config/version.txt b/browser/config/version.txt\n--- a/browser/config/version.txt\n+++ b/browser/config/version.txt\n@@ -1 +1 @@\n-115.24.0\n+115.25.0\ndiff --git a/browser/config/version_display.txt b/browser/config/version_display.txt\n--- a/browser/config/version_display.txt\n+++ b/browser/config/version_display.txt\n@@ -1 +1 @@\n-115.24.0esr\n+115.25.0\n```\n\n...which aren't correct.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248916\n", "files": ["taskcluster/ci/config.yml"], "git_node": "92c0ce762c8d07bd25487178e8994030c9a0dfb3", "git_parents": ["716165de8b5d87db43706b6bd5903735055a0eeb"], "node": "77372feeefac3a93bd904608d89d8a6b88e72c95", "parents": ["45b76dfaa62d840ecddae1cec0e6c22045483df2"], "tags": []}], "date": 1747076940, "git_changesets": ["92c0ce762c8d07bd25487178e8994030c9a0dfb3"], "user": "dmeehan@mozilla.com"}, "654": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962421 - Cherry-pick upstream libvpx commit 1c758781c4. r=wtc a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248264\n", "files": ["media/libvpx/moz.yaml", "media/libvpx/vpx_codec_enc_init_multi_fix__cherry_pick_1c7587.patch"], "git_node": "c98cb032e3544f0f3cf7d4c322535c58b142701e", "git_parents": ["92c0ce762c8d07bd25487178e8994030c9a0dfb3"], "node": "45d4ed0d9091d03f72b8de8c26d386a2d2979cc4", "parents": ["77372feeefac3a93bd904608d89d8a6b88e72c95"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962421 - Re-vendor libvpx. r=wtc a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248265\n", "files": ["media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vpx/src/vpx_encoder.c"], "git_node": "4b11bb11cc8a2fb0de2878def5a7e9c3d5aee281", "git_parents": ["c98cb032e3544f0f3cf7d4c322535c58b142701e"], "node": "f37bab5c17b26c19cd13e9bc300778d67d6d0539", "parents": ["45d4ed0d9091d03f72b8de8c26d386a2d2979cc4"], "tags": []}], "date": 1747077266, "git_changesets": ["c98cb032e3544f0f3cf7d4c322535c58b142701e", "4b11bb11cc8a2fb0de2878def5a7e9c3d5aee281"], "user": "dmeehan@mozilla.com"}, "655": {"changesets": [{"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962301 - [devtools] Escape windows special characters for strings  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246818\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249025\n", "files": ["devtools/client/netmonitor/test/browser_net_curl-utils.js", "devtools/client/shared/curl.js"], "git_node": "725ba67da3a9e957e32c76bc37da950238bcff0e", "git_parents": ["4b11bb11cc8a2fb0de2878def5a7e9c3d5aee281"], "node": "2da0e1ca3736bd257cc0094db087de42184bc534", "parents": ["f37bab5c17b26c19cd13e9bc300778d67d6d0539"], "tags": []}], "date": 1747150674, "git_changesets": ["725ba67da3a9e957e32c76bc37da950238bcff0e"], "user": "rvandermeulen@mozilla.com"}, "656": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1943670: Migrate mozharness unit tests from tox -\u003e ./mach python-test, r=ahal a=RyanVM\n\nThis is a backport of the original patch from this bug, and also a removal of a couple of tests that weren't passing for me locally, and I doubt are important enough to debug.\n\nI wasn't able to test this on try due to https://bugzilla.mozilla.org/show_bug.cgi?id=1948030; it's possible they would've passed there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248367\n", "files": ["js/src/make-source-package.py", "taskcluster/ci/source-test/python.yml", "testing/moz.build", "testing/mozharness/moz.build", "testing/mozharness/test/python.ini", "testing/mozharness/test/test_base_config.py", "testing/mozharness/test/test_base_diskutils.py", "testing/mozharness/test/test_base_log.py", "testing/mozharness/test/test_base_parallel.py", "testing/mozharness/test/test_base_python.py", "testing/mozharness/test/test_base_script.py", "testing/mozharness/test/test_base_vcs_mercurial.py", "testing/mozharness/test/test_l10n_locales.py", "testing/mozharness/test/test_mozilla_automation.py", "testing/mozharness/test/test_mozilla_building_buildbase.py", "testing/mozharness/test/test_mozilla_merkle.py", "testing/mozharness/test/test_mozilla_structured.py", "testing/mozharness/tox.ini"], "git_node": "99cedbbda7339fdb53c75ac438fa6e136ddaaf7a", "git_parents": ["725ba67da3a9e957e32c76bc37da950238bcff0e"], "node": "c14d438ba96c8ba45ecfa3c829055c77b598d92c", "parents": ["2da0e1ca3736bd257cc0094db087de42184bc534"], "tags": []}], "date": 1747190032, "git_changesets": ["99cedbbda7339fdb53c75ac438fa6e136ddaaf7a"], "user": "rvandermeulen@mozilla.com"}, "657": {"changesets": [{"author": "Narcis Beleuzu \u003cnbeleuzu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1943670: Migrate mozharness unit tests from tox -\u003e ./mach python-test, r=ahal a=RyanVM\" for lint failure on test_base_diskutils.py\n\nThis reverts commit 99cedbbda7339fdb53c75ac438fa6e136ddaaf7a.\n", "files": ["js/src/make-source-package.py", "taskcluster/ci/source-test/python.yml", "testing/moz.build", "testing/mozharness/moz.build", "testing/mozharness/test/python.ini", "testing/mozharness/test/test_base_c