/reader/content/aboutReader.html"], "git_node": null, "git_parents": [null], "node": "683148d04c33611f3b207419619de862378aed10", "parents": ["1777c4095b0b2ef909a6e391db021d2b27235d5e"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1649981 - Address bar should still allow to search or navigate even if it can't get results. r=harry, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82162", "files": ["browser/components/urlbar/UrlbarInput.jsm", "browser/components/urlbar/tests/browser/browser_handleCommand_fallback.js"], "git_node": null, "git_parents": [null], "node": "6b778891f6bc5e305ce5325f9b90698ff23ad5ad", "parents": ["683148d04c33611f3b207419619de862378aed10"], "tags": []}], "date": 1594213281, "git_changesets": [null, null, null, null], "user": "jcristau@mozilla.com"}, "33": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "FIREFOX_ESR_78_0_X_RELBRANCH", "desc": "Bug 1650162 - Turn security.allow_disjointed_external_uri_loads back on to fix regressions opening external applications. r=Gijs, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82740", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "6e1145ecb9914c071b0066b3422ff33464196190", "parents": ["2e228bcae46e0851a006c10d119200493996937d"], "tags": ["FIREFOX_78_0_2esr_BUILD2", "FIREFOX_78_0_2esr_RELEASE"]}], "date": 1594227910, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "34": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 6e1145ecb9914c071b0066b3422ff33464196190 with FIREFOX_78_0_2esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "369225a20cb4d89e7950376c3b185e96a8f98ea9", "parents": ["6b778891f6bc5e305ce5325f9b90698ff23ad5ad"], "tags": []}], "date": 1594237610, "git_changesets": [null], "user": "ffxbld"}, "35": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 6e1145ecb9914c071b0066b3422ff33464196190 with FIREFOX_78_0_2esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "522f86f2d686feb5dad82170a634ab72b623b77e", "parents": ["369225a20cb4d89e7950376c3b185e96a8f98ea9"], "tags": []}], "date": 1594299554, "git_changesets": [null], "user": "ffxbld"}, "36": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82905", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "b804363cb99d92cbfe3c60465143a4275bdd00e0", "parents": ["522f86f2d686feb5dad82170a634ab72b623b77e"], "tags": []}, {"author": "Markus Stange \u003cmstange@themasta.com\u003e", "branch": "default", "desc": "Bug 1642603 - Make TransformAndClipBounds stop discarding the corner positions of empty rectangles. r=kip, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79582", "files": ["gfx/2d/Matrix.cpp", "gfx/2d/Matrix.h", "gfx/tests/gtest/TestMatrix.cpp", "layout/base/PresShell.h", "layout/base/nsLayoutUtils.h", "layout/reftests/bugs/1642603-1-ref.html", "layout/reftests/bugs/1642603-1.html", "layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "203c34bc2d28912df2ed706cf0c0d9c2e53cab57", "parents": ["b804363cb99d92cbfe3c60465143a4275bdd00e0"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 1535922 - Don't try to process leaks if Firefox didn't shutdown cleanly, r=mccr8 a=test-only\n\nIn the case of unclean shutdown e.g. a crash we probably don't have leak logs to\nprocess, so don't do that, or we end up with a useless extra error we can't\nsuppress\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81386", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": null, "git_parents": [null], "node": "058460d41c5a34e3f13089b8bcd441ce7509d758", "parents": ["203c34bc2d28912df2ed706cf0c0d9c2e53cab57"], "tags": []}, {"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1641598 - Fix defect in Key::LengthOfEncodedBinary. r=ttung, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78696", "files": ["dom/indexedDB/Key.cpp"], "git_node": null, "git_parents": [null], "node": "58044b3f22e623b1533ba76cb106c4adbb7df4ed", "parents": ["058460d41c5a34e3f13089b8bcd441ce7509d758"], "tags": []}, {"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1641598 - Added gtest test cases for ToLocaleAwareKey. r=ttung, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78697", "files": ["dom/indexedDB/test/gtest/TestKey.cpp"], "git_node": null, "git_parents": [null], "node": "40209bb73e4d2b73a00021feaf140323811c03fb", "parents": ["58044b3f22e623b1533ba76cb106c4adbb7df4ed"], "tags": []}, {"author": "Harry Twyford \u003chtwyford@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648385 - Allow search suggestions in the Urlbar when they are disabled by a pref but a restriction token or token alias is used. r=adw, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81166", "files": ["browser/components/urlbar/UrlbarProviderSearchSuggestions.jsm", "browser/components/urlbar/tests/unit/test_search_suggestions.js", "browser/components/urlbar/tests/unit/test_search_suggestions_aliases.js"], "git_node": null, "git_parents": [null], "node": "41835a1ccf4b7fc5f8f7257bb206bdc5ba903882", "parents": ["40209bb73e4d2b73a00021feaf140323811c03fb"], "tags": []}, {"author": "Mirko Brodesser \u003cmbrodesser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648372: add missing `nullptr` check to `TextInputSelectionController::SetCaretReadOnly`. r=masayuki, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82165", "files": ["dom/html/TextControlState.cpp"], "git_node": null, "git_parents": [null], "node": "6c74c44b2c942f68e680ba165cd630218e3735ef", "parents": ["41835a1ccf4b7fc5f8f7257bb206bdc5ba903882"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1650825 - Only use bloom filters for AMO-signed add-ons. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82398", "files": ["toolkit/mozapps/extensions/Blocklist.jsm", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_mlbf.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_mlbf_dump.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_mlbf_fetch.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_mlbf_stashes.js"], "git_node": null, "git_parents": [null], "node": "6efe9012737d2d495f8a861e69ca852878892027", "parents": ["6c74c44b2c942f68e680ba165cd630218e3735ef"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1649347 - RefMessageBody needs to protect the reading when shared cross threads, r=edenchuang a=RyanVM", "files": ["dom/ipc/RefMessageBodyService.cpp", "dom/ipc/RefMessageBodyService.h", "dom/ipc/SharedMessageBody.cpp"], "git_node": null, "git_parents": [null], "node": "589ed79dc138750e120a7d3322780a8f7028814a", "parents": ["6efe9012737d2d495f8a861e69ca852878892027"], "tags": []}, {"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1643613 - Check that ScheduleDeletion is only called once. r=asuth, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81853", "files": ["dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h"], "git_node": null, "git_parents": [null], "node": "6893cb9ea3d807e1448c3c8815444f095d271d27", "parents": ["589ed79dc138750e120a7d3322780a8f7028814a"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1650162 - Turn security.allow_disjointed_external_uri_loads back on to fix regressions opening external applications. r=Gijs, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82740", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "25f6025e30a5f8c8b4c364d77bd3832b026a1a1f", "parents": ["6893cb9ea3d807e1448c3c8815444f095d271d27"], "tags": []}], "date": 1594313171, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "37": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1644246 - Send Activate/Deactivate messages over PBrowser instead of PContent, r=kmag, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79384", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PContent.ipdl"], "git_node": null, "git_parents": [null], "node": "810a217b4e4971e24b823f4142758aa96d69d29b", "parents": ["25f6025e30a5f8c8b4c364d77bd3832b026a1a1f"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1635784 - Make cached cursor consistent between parent and content process; r=smaug, a=RyanVM\n\nContent process won't try to send IPC to parent process to update cursor if the\ncursor isn't changed, and assume parent process would update cursor properly as\nsoon as the cursor re-enter to a remote target.\n\nBut BrowserParent cached the cursor information for a remote target only when the\nremote target is allowed to update the cursor. It could possible that parent use\na stale cursor for a remote target and stuck in that state untill content\nprocess tries to update cursor again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79985", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": null, "git_parents": [null], "node": "d38354ff64b22256ade753ebd0bc45b9cccf3184", "parents": ["810a217b4e4971e24b823f4142758aa96d69d29b"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1635784 - Should always allow a remote target to update cursor when mouse is over it; r=smaug, a=RyanVM\n\nregardless of what the previous remote target is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80094", "files": ["dom/events/EventStateManager.cpp"], "git_node": null, "git_parents": [null], "node": "3dde25d513dd05007c9c5b172c2b0e933987bf1f", "parents": ["d38354ff64b22256ade753ebd0bc45b9cccf3184"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1647293 - Don't improve TypeSets containing the magic-args type. r=iain, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82155", "files": ["js/src/jit/IonBuilder.cpp"], "git_node": null, "git_parents": [null], "node": "02f8f64c38eb474f87dede325abecc882cbe280b", "parents": ["3dde25d513dd05007c9c5b172c2b0e933987bf1f"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1326005: Test case for completion of ICE using candidates in reoffer/reanswer instead of trickle. r=jib, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82407", "files": ["testing/web-platform/tests/webrtc/RTCPeerConnection-helper.js", "testing/web-platform/tests/webrtc/RTCPeerConnection-setRemoteDescription-offer.html", "testing/web-platform/tests/webrtc/protocol/candidate-exchange.https.html"], "git_node": null, "git_parents": [null], "node": "263e06674eecc81e3245c522c50b6298e554021b", "parents": ["02f8f64c38eb474f87dede325abecc882cbe280b"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1326005: Make this log at INFO because that's the level we log on the sending side. r=mjf, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82035", "files": ["media/mtransport/nricemediastream.cpp"], "git_node": null, "git_parents": [null], "node": "5bfb278e99ac3cde6c96eab058eea2a1b2cfae3a", "parents": ["263e06674eecc81e3245c522c50b6298e554021b"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1326005: Always update the Jsep ICE transport's candidate list when negotiation completes. r=mjf, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82036", "files": ["media/webrtc/signaling/src/jsep/JsepSessionImpl.cpp"], "git_node": null, "git_parents": [null], "node": "7d6ebc2cd3c1e5a389b2ead3d51a2cef670a23af", "parents": ["5bfb278e99ac3cde6c96eab058eea2a1b2cfae3a"], "tags": []}], "date": 1594394788, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "38": {"changesets": [{"author": "Jan-Ivar Bruaroey \u003cjib@mozilla.com\u003e", "branch": "default", "desc": "Bug 1644848 - avoid Promise contructor anti-pattern in event RTCPeerConnection-helper.js to surface errors to harness. r=ng,bwc a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79177", "files": ["testing/web-platform/meta/webrtc/RTCPeerConnection-videoDetectorTest.html.ini", "testing/web-platform/meta/webrtc/RTCRtpReceiver-getSynchronizationSources.https.html.ini", "testing/web-platform/meta/webrtc/RTCRtpSender-replaceTrack.https.html.ini", "testing/web-platform/tests/webrtc/RTCPeerConnection-helper.js"], "git_node": null, "git_parents": [null], "node": "53b0e2749170c1ed360c9b0b206c803f5bef4a62", "parents": ["7d6ebc2cd3c1e5a389b2ead3d51a2cef670a23af"], "tags": []}, {"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1651436: Wrap exceptions thrown by WrapPrivileged getters. r=mccr8, a=test-only\n\nWhen a privileged exception object is thrown by a function exported via\n`exportFunction`, it is reported to the console, and a generic unprivileged\nexception is re-thrown in its place. This is a problem for test harness code\nwhich tests for getters throwing exceptions by catching them and then setting\na flag. The re-thrown exception is hidden, but the original is still reported,\nand becomes a red herring for people debugging tests.\n\nThis patch catches exceptions thrown by getters (and setters, and other proxy\nhooks previously overlooked), checks if they're readable by the global the\nprivileged object is wrapped for, wraps them if they are not, and then\nre-throws them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82782", "files": ["testing/specialpowers/content/WrapPrivileged.jsm"], "git_node": null, "git_parents": [null], "node": "793ab94efb2bc8d2a09f51e72f350d4bae1b120c", "parents": ["53b0e2749170c1ed360c9b0b206c803f5bef4a62"], "tags": []}], "date": 1594426558, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "39": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83329", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "ebf66838252395cc0e6595aa80c86f159da84a9e", "parents": ["793ab94efb2bc8d2a09f51e72f350d4bae1b120c"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648815 - Allow non-builtin certs for system addon updates. r=rpl,aswan a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81787", "files": ["toolkit/mozapps/extensions/internal/XPIInstall.jsm"], "git_node": null, "git_parents": [null], "node": "4efd5bf491c5a3cda443c5881efb61dcac8e72c4", "parents": ["ebf66838252395cc0e6595aa80c86f159da84a9e"], "tags": []}, {"author": "Jan Horak \u003cjhorak@redhat.com\u003e", "branch": "default", "desc": "Bug 1594738 - Remove top black line from kiosk mode; r=mkaply, a=RyanVM\n\nThere is a fullscr-toggler still shown in kiosk mode. This patch\ndisables it showing when in kiosk mode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81828", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js"], "git_node": null, "git_parents": [null], "node": "895b4f9d2e2fc1214619a092a567bbd5e36eece9", "parents": ["4efd5bf491c5a3cda443c5881efb61dcac8e72c4"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1648642 - Handle registry errors gracefully. r=mconley, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81608", "files": ["toolkit/components/enterprisepolicies/EnterprisePolicies.js"], "git_node": null, "git_parents": [null], "node": "15188f16f5fbf034d054d758d6c0fe6f4e87ae63", "parents": ["895b4f9d2e2fc1214619a092a567bbd5e36eece9"], "tags": []}], "date": 1594662924, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "40": {"changesets": [{"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1650572 - Check V4L2_CAP_DEVICE_CAPS before accessing device_caps; r=ng, a=RyanVM\n\nThe capabilities field is for the physical device, device_caps is for the\nspecific /dev/videoX device that has been opened. The device_caps field is\nonly populated if V4L2_CAP_DEVICE_CAPS is set, so we should check that, and\nfall back to capabilities if it is not set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82377", "files": ["media/webrtc/trunk/webrtc/modules/video_capture/linux/device_info_linux.cc", "media/webrtc/trunk/webrtc/modules/video_capture/linux/device_info_linux.h"], "git_node": null, "git_parents": [null], "node": "f003d48976866523ee3d734b2dba6a71e3711f37", "parents": ["15188f16f5fbf034d054d758d6c0fe6f4e87ae63"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1650590: A11y COM handler: Use CoTaskMemAlloc/Free for row/column header ids arrays when returned by IGeckoBackChannel::Refresh. r=MarcoZ, a=RyanVM\n\nDynamicIA2Data can be built to be transmitted in two different ways:\n\n1. As part of the payload included in the stream when an accessible is marshaled; or\n2. As an out parameter returned by IGeckoBackChannel::Refresh().\n\nDynamicIA2Data includes arrays for row/column header ids.\nNormally, such arrays would be allocated by CoTaskMemAlloc and freed by CoTaskMemFree.\nHowever, in the first case, the struct is actually marshaled by RPC encoding functions, not by COM itself.\nThis means we must use midl_user_allocate/free, lest we crash.\nWe previously used midl_user_allocate/free for the second case as well.\nUnfortunately, it turns out that this too causes crashes.\n\nTo fix this, we now use different memory allocation functions depending on how the struct is transmitted.\n\nThis patch also cleans up the old DynamicIA2Data in the client before calling IGeckoBackChannel::Refresh.\nPreviously, we didn't do this, which would have resulted in a leak.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82823", "files": ["accessible/ipc/win/HandlerProvider.cpp", "accessible/ipc/win/HandlerProvider.h", "accessible/ipc/win/handler/AccessibleHandler.cpp", "accessible/ipc/win/handler/AccessibleHandler.h", "accessible/ipc/win/handler/HandlerDataCleanup.h"], "git_node": null, "git_parents": [null], "node": "08b85e77f2065ea8e19bb700c01cd10bfb1ae7ff", "parents": ["f003d48976866523ee3d734b2dba6a71e3711f37"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1650811 - Make Base64 compatible with ReadSegments() with small buffers. r=asuth, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82522", "files": ["netwerk/test/gtest/TestBase64Stream.cpp", "netwerk/test/gtest/moz.build", "xpcom/io/Base64.cpp"], "git_node": null, "git_parents": [null], "node": "aa071acafd70c8b10270c1a6a33136e0c9685651", "parents": ["08b85e77f2065ea8e19bb700c01cd10bfb1ae7ff"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1651701 - Allow rseq in the Linux sandboxes. r=gcp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83142", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": null, "git_parents": [null], "node": "568a4aa7ec4df23f583e68f0361a525726b3ac73", "parents": ["aa071acafd70c8b10270c1a6a33136e0c9685651"], "tags": []}, {"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1646006 - Merge GetFileInfo and CreateFileInfo and make locking less quirky. r=janv, a=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82878", "files": ["dom/indexedDB/FileInfoT.h", "dom/indexedDB/FileInfoTImpl.h", "dom/indexedDB/FileManagerBase.h"], "git_node": null, "git_parents": [null], "node": "98bc457deb77edd24ce283f3986eaae252b20b54", "parents": ["568a4aa7ec4df23f583e68f0361a525726b3ac73"], "tags": []}], "date": 1594753070, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "41": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83785", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/blocklists/plugins.json", "services/settings/dumps/main/url-classifier-skip-urls.json"], "git_node": null, "git_parents": [null], "node": "ed23ca497a7e3031402c1d51abfb8d1cfbf21114", "parents": ["98bc457deb77edd24ce283f3986eaae252b20b54"], "tags": []}, {"author": "ssengupta \u003cssengupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1633880 - P1 - gStorage in IPCBlobInputStreamStorage is protected by gMutex. r=baku, a=RyanVM", "files": ["dom/file/ipc/IPCBlobInputStreamStorage.cpp"], "git_node": null, "git_parents": [null], "node": "3111d972f397c32492abd5e6e9b621d608f32dbb", "parents": ["ed23ca497a7e3031402c1d51abfb8d1cfbf21114"], "tags": []}, {"author": "ssengupta \u003cssengupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1633880 - P2 - IPCBlobInputStreamStorage::Get() now returns mozilla::Result\u003cRefPtr\u003cIPCBlobInputStreamStorage\u003e, nsresult\u003e. r=baku, a=RyanVM", "files": ["dom/fetch/InternalResponse.cpp", "dom/file/ipc/IPCBlobInputStream.cpp", "dom/file/ipc/IPCBlobInputStreamParent.cpp", "dom/file/ipc/IPCBlobInputStreamStorage.cpp", "dom/file/ipc/IPCBlobInputStreamStorage.h", "dom/serviceworkers/FetchEventOpProxyParent.cpp", "dom/serviceworkers/ServiceWorkerPrivateImpl.cpp", "ipc/glue/InputStreamUtils.cpp"], "git_node": null, "git_parents": [null], "node": "f64d74a9b713d0237f03593b7adcd79a77c9b02d", "parents": ["3111d972f397c32492abd5e6e9b621d608f32dbb"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1193437: Use config structs in NrIceCtx, and centralize pref lookups some. r=mjf, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82549", "files": ["media/mtransport/nricectx.cpp", "media/mtransport/nricectx.h", "media/mtransport/test/ice_unittest.cpp", "media/mtransport/test/multi_tcp_socket_unittest.cpp", "media/mtransport/test/test_nr_socket_ice_unittest.cpp", "media/mtransport/test/transport_unittests.cpp", "media/mtransport/test/turn_unittest.cpp", "media/webrtc/signaling/src/peerconnection/MediaTransportHandler.cpp"], "git_node": null, "git_parents": [null], "node": "58e9540c98888cc87231cba05e2fdd444711f0ef", "parents": ["f64d74a9b713d0237f03593b7adcd79a77c9b02d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1650444 - Remove browser.find.anonymous_content.enabled. r=jfkthame, a=RyanVM\n\nOther than this, there hasn't been any other major regression since we\nintroduced that switch. I don't think there's a point in keeping it\naround.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82297", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/find/nsFind.cpp"], "git_node": null, "git_parents": [null], "node": "56922d42adad86d28f2225ec6a94154a4821cdf2", "parents": ["58e9540c98888cc87231cba05e2fdd444711f0ef"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1650444 - Explicitly disallow finding in \u003cinput type=password\u003e. r=jfkthame, a=RyanVM\n\nMaybe if / when we have a native way to allow showing the password we\ncan lift this if the password is visible or what not. Until then this is\njust confusing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82296", "files": ["toolkit/components/find/nsFind.cpp", "toolkit/modules/tests/browser/browser_Finder_skip_invisible_and_option.js"], "git_node": null, "git_parents": [null], "node": "ea2af90997c0be818ab8e480518cdc82a83200c6", "parents": ["56922d42adad86d28f2225ec6a94154a4821cdf2"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1652439: Null check the root accessible when handling QueryService to SID_IAccessibleContentDocument in content processes. r=MarcoZ, a=RyanVM\n\nAccessible::RootAccessible() returns null on the ApplicationAccessible.\nWe weren't null checking this previously, so QueryService for SID_IAccessibleContentDocument on the ApplicationAccessible in a content process would crash.\nThis is rare, but JAWS does sometimes trigger it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83452", "files": ["accessible/windows/msaa/ServiceProvider.cpp"], "git_node": null, "git_parents": [null], "node": "dabc162949f73512234873b90949b3ed5333413e", "parents": ["ea2af90997c0be818ab8e480518cdc82a83200c6"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1651093 - Update UserMessaging policy for triplets. r=pdahiya, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83367", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": null, "git_parents": [null], "node": "bdbddeb365ed46b3177dec084dca65301a4ff37d", "parents": ["dabc162949f73512234873b90949b3ed5333413e"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 1645204 - Fix WebRequest.jsm. r=robwu,mayhemer a=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80953", "files": ["dom/chrome-webidl/ChannelWrapper.webidl", "netwerk/protocol/http/HttpBaseChannel.cpp", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp", "toolkit/components/extensions/webrequest/ChannelWrapper.h", "toolkit/components/extensions/webrequest/WebRequest.jsm"], "git_node": null, "git_parents": [null], "node": "0fa2e6171e7dba5e923db0eabe26a45c87dc537f", "parents": ["bdbddeb365ed46b3177dec084dca65301a4ff37d"], "tags": []}], "date": 1594938631, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "42": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84169", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "4df8bd076b8a797eea6664aebab503430380b952", "parents": ["0fa2e6171e7dba5e923db0eabe26a45c87dc537f"], "tags": []}, {"author": "Samuel Thibault \u003csamuel.thibault@ens-lyon.org\u003e", "branch": "default", "desc": "Bug 1606721 - Fix crash on screen reader text requests with end offset smaller than -1, r=Jamie a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82324", "files": ["accessible/atk/DOMtoATK.cpp"], "git_node": null, "git_parents": [null], "node": "626f392cebde79f9d13916d5ced2d5c9a1461e88", "parents": ["4df8bd076b8a797eea6664aebab503430380b952"], "tags": []}, {"author": "Samuel Thibault \u003csamuel.thibault@ens-lyon.org\u003e", "branch": "default", "desc": "Bug 1606721 - Fix crash on screen reader text requests with bogus offsets, r=Jamie a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82424", "files": ["accessible/atk/DOMtoATK.h"], "git_node": null, "git_parents": [null], "node": "ee84a7d0e4e0002acd018158deccf42194f915b8", "parents": ["626f392cebde79f9d13916d5ced2d5c9a1461e88"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1651330 - Include Canonical distribution in search engine configuration. r=mkaply, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82764", "files": ["services/settings/dumps/main/search-config.json", "toolkit/components/search/tests/xpcshell/test_distributions.js"], "git_node": null, "git_parents": [null], "node": "6664b85bbb8ee9c44b62538a561b5d5da6db5f4c", "parents": ["ee84a7d0e4e0002acd018158deccf42194f915b8"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1650751 - Add FMODE_NONOTIFY to ignored file flags in Linux sandbox. r=gcp, a=RyanVM\n\nAs of kernel 5.8 (commit [e9c15badb][]), Linux will set the internal\n`FMODE_NONOTIFY` flag on files that don't exist in the filesystem,\nincluding (unnamed) pipes and sockets.  Although this flag isn't\nproperly part of the userspace API, it will be returned by F_GETFL, so\nuserspace code that tries to change file flags will pass it to F_SETFL.\n\nThe implementation of `F_SETFL` has an allow list of flags userspace can\nchange (`SETFL_MASK`) and ignores all others, but our sandbox has a list\nof flags *known* to be ignored, because currently unknown flags could\npotentially be accepted by the kernel in the future.\n\nThis patch adds `FMODE_NONOTIFY` as an ignored flag.\n\n[e9c15badb]: https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=e9c15badbb7b20ccdbadf5da14e0a68fbad51015\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83874", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": null, "git_parents": [null], "node": "435eb575e449402ba45451fb391e9b4e925ae92d", "parents": ["6664b85bbb8ee9c44b62538a561b5d5da6db5f4c"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1652487: Escape widget identifiers before using them as CSS selectors. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83713", "files": ["browser/modules/BrowserUsageTelemetry.jsm", "browser/modules/test/browser/browser_UsageTelemetry_interaction.js"], "git_node": null, "git_parents": [null], "node": "0b2ec5d21b06864f8049cb63495590313da0b3dd", "parents": ["435eb575e449402ba45451fb391e9b4e925ae92d"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1649872 - Fix environment in blocklists filter expressions. r=robwu, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83807", "files": ["toolkit/mozapps/extensions/Blocklist.jsm", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_targetapp_filter.js"], "git_node": null, "git_parents": [null], "node": "a732eb41878105e41942af8af5050c7f0b0b2348", "parents": ["0b2ec5d21b06864f8049cb63495590313da0b3dd"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1653584 - Rename MasterPassword policy to PrimaryPassword. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83957", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_masterpassword.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_masterpassword_aboutlogins.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_masterpassword_doorhanger.js"], "git_node": null, "git_parents": [null], "node": "f140d852080d2e1870dbc7fcc6e42c663e195d9b", "parents": ["a732eb41878105e41942af8af5050c7f0b0b2348"], "tags": []}], "date": 1595269869, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "43": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1637745. r=Gijs,mayhemer a=RyanVM\n\nDifferential Revi