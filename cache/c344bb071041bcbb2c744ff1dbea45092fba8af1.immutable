246e272da288afa982b", "parents": ["1279e63e70e503d6d150fff6a8b0b2f8bdfe852c"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1643498 - Show errors when cert creation fails in policy. r=keeler, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78529", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "5a515fbf62733cd44bf9903a5853a168229bc0e3", "parents": ["741bad1bfb3cee03dc644246e272da288afa982b"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1643155 - Rename obfuscate_host_addresses pref; r=ng,mkaply a=RyanVM\n\nRenaming this to blocklist, as this is a list of sites for which hostname\nobfuscation is disabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78681", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json", "dom/media/tests/mochitest/mochitest.ini", "dom/media/tests/mochitest/test_dataChannel_hostnameObfuscation.html", "dom/media/tests/mochitest/test_dataChannel_hostnameObfuscationWhitelist.html", "media/webrtc/signaling/src/peerconnection/PeerConnectionMedia.cpp", "modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "6c869ad8c33cf93ad6f77b439aa612e86b96f2ed", "parents": ["5a515fbf62733cd44bf9903a5853a168229bc0e3"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1642789 - Remove all excess data from PEM files. r=keeler, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79176", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "51fbdd67be3c19bf7928c3baeed5550a794e0f68", "parents": ["6c869ad8c33cf93ad6f77b439aa612e86b96f2ed"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1645774 - Use proper textContent for section title. r=jaws, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79734", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.js"], "git_node": null, "git_parents": [null], "node": "55d75b07fedc286c063f05554c899429f6300762", "parents": ["51fbdd67be3c19bf7928c3baeed5550a794e0f68"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1639980 - Hide Pocket saved pages if Pocket is disabled. r=Mardak, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79750", "files": ["browser/components/newtab/lib/AboutPreferences.jsm", "browser/components/newtab/lib/SectionsManager.jsm", "browser/components/newtab/test/unit/lib/AboutPreferences.test.js"], "git_node": null, "git_parents": [null], "node": "c509c74a908db194426418bc191bb2999de8f47d", "parents": ["55d75b07fedc286c063f05554c899429f6300762"], "tags": []}], "date": 1593715154, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "24": {"changesets": [{"author": "Mitchell Hentges \u003cmhentges@mozilla.com\u003e", "branch": "default", "desc": "Bug 1621960: \"enum34\" and \"enum\" virtualenv packages are now only available to the python2 env. r=rstewart, a=RyanVM\n\nWhen running |mach python| with python 3, it was failing when importing \"enum\", since it would get the python 2 backport. By making these packages only\navailable to python 2, we allow python 3 to import standard library packages properly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D77960", "files": ["build/virtualenv_packages.txt"], "git_node": null, "git_parents": [null], "node": "6f7d5ab59284c9c2f2300f13af0251b59b11b979", "parents": ["c509c74a908db194426418bc191bb2999de8f47d"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1643168 - block moxSetFocused: on non-focusable accessibles. r=morgan, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78160", "files": ["accessible/mac/mozAccessible.mm", "accessible/tests/browser/mac/browser.ini", "accessible/tests/browser/mac/browser_focus.js"], "git_node": null, "git_parents": [null], "node": "b33a6cbaeddbf8331b05f400b7a32588a43e342d", "parents": ["6f7d5ab59284c9c2f2300f13af0251b59b11b979"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1636607 - Use prefix match for public identifiers that trigger the Almost Standards Mode. r=alchen, a=RyanVM\n\nImplements a part of the spec change\nhttps://searchfox.org/whatwg-html/diff/9345b201261c452868a68780ece85370f17644a3/source#42357\nthat was originally missed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D74658", "files": ["parser/html/javasrc/TreeBuilder.java", "parser/html/nsHtml5TreeBuilder.cpp", "parser/htmlparser/tests/reftest/bug1636607-1-ref.html", "parser/htmlparser/tests/reftest/bug1636607-1.html", "parser/htmlparser/tests/reftest/bug1636607-2-ref.html", "parser/htmlparser/tests/reftest/bug1636607-2.html", "parser/htmlparser/tests/reftest/reftest.list"], "git_node": null, "git_parents": [null], "node": "3e984ed05fb0be09061cd4d76adb1b5f59b35f58", "parents": ["b33a6cbaeddbf8331b05f400b7a32588a43e342d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1645789 - Fix \"Default Page Style\" submenu to do the right thing. r=Gijs, a=RyanVM\n\nWe compare the value passed through with the title, and StyleSheet.title\nreturns null for empty titles, so we never consider an empty title to be\nin the document, which is bad.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79700", "files": ["browser/base/content/browser-menubar.inc", "browser/base/content/test/general/browser_page_style_menu.js", "browser/base/content/test/general/page_style_sample.html"], "git_node": null, "git_parents": [null], "node": "bef6e89f60309a8e1ea4a31c4d54d867c714c98a", "parents": ["3e984ed05fb0be09061cd4d76adb1b5f59b35f58"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1645789 - Also fix the case when we're resetting the styles and the document has no default style. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79701", "files": ["browser/actors/PageStyleChild.jsm", "browser/base/content/test/general/browser.ini", "browser/base/content/test/general/browser_page_style_menu.js", "browser/base/content/test/general/page_style_only_alternates.html"], "git_node": null, "git_parents": [null], "node": "d469bfda63b4b9a478e36189fb1bb773d0f19d67", "parents": ["bef6e89f60309a8e1ea4a31c4d54d867c714c98a"], "tags": []}, {"author": "Alex Chronopoulos \u003cachronop@gmail.com\u003e", "branch": "default", "desc": "Bug 1584959 - Avoid calling the converter if the conversion is not possible. r=bryce, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56736", "files": ["dom/media/AudioConverter.cpp", "dom/media/AudioConverter.h", "dom/media/mediasink/AudioSink.cpp"], "git_node": null, "git_parents": [null], "node": "6dc7053ecfe17c2ece14810cd8f409be93aa5fda", "parents": ["d469bfda63b4b9a478e36189fb1bb773d0f19d67"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1645219: Repurpose DataChannelShutdown into DataChannelRegistry (which gives us some weak-pointer-like semantics) r=ng a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79375", "files": ["netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannel.h"], "git_node": null, "git_parents": [null], "node": "e12fdc01fa6e382afdb6d9b6b51aec24c86ab8c5", "parents": ["6dc7053ecfe17c2ece14810cd8f409be93aa5fda"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1644768 - Avoid OOM when serializing large 8-bit-code-unit text nodes. r=mbrodesser, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79270", "files": ["dom/base/nsXMLContentSerializer.cpp"], "git_node": null, "git_parents": [null], "node": "6140107b78758b38eee6932884e47bfb42feb135", "parents": ["e12fdc01fa6e382afdb6d9b6b51aec24c86ab8c5"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1547649 - Make allocation in wasm::Init infallible.  r=rhunt, a=RyanVM\n\nIf we fail this allocation during initialization we're going to crash very shortly\nanyway, so make the allocation infallible - it's small, and crashing here will\npreserve the call stack properly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80430", "files": ["js/src/wasm/WasmProcess.cpp"], "git_node": null, "git_parents": [null], "node": "2c73a011b54aa062831f160b1114ab553e739847", "parents": ["6140107b78758b38eee6932884e47bfb42feb135"], "tags": []}, {"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1646867 - SystemHeapSize counts only the process default heap on Windows.  r=froydnj,dmajor a=RyanVM\n\nThe crash reports indicate a situation where a non-default heap is destroyed\nafter we retrieve a handle is happening on a regular basis.\nWe've decided to count only the default heap, ignoring all non-default heaps\nwhich we don't manage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80299", "files": ["xpcom/base/nsMemoryReporterManager.cpp"], "git_node": null, "git_parents": [null], "node": "62f24832d7fdb55eb86636f95a543fbc4eccace6", "parents": ["2c73a011b54aa062831f160b1114ab553e739847"], "tags": []}], "date": 1593722215, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "25": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1645835 - Fix Sink to check for non-recoverable operands. r=nbp, a=tritter\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81131", "files": ["js/src/jit/Sink.cpp"], "git_node": null, "git_parents": [null], "node": "3ce251e60fa8a6694a174824cb7cd1ed02a94a48", "parents": ["62f24832d7fdb55eb86636f95a543fbc4eccace6"], "tags": []}, {"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1646006 - Check if CreateFileInfo returns nullptr. r=janv, a=tritter\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79835", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "a018341b3f7c4d30dd4394ff4a367e2b4558ff08", "parents": ["3ce251e60fa8a6694a174824cb7cd1ed02a94a48"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1638793 - Ensure OriginAttributes is set on OpenWindowInfo for expanded principals, r=kmag a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79471", "files": ["toolkit/components/windowwatcher/nsWindowWatcher.cpp"], "git_node": null, "git_parents": [null], "node": "2b15c487636e7ddf38c18958dd45784bb67b148a", "parents": ["a018341b3f7c4d30dd4394ff4a367e2b4558ff08"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1639945 - Add support for session cookies in policy. r=jaws, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79902", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_permissions.js"], "git_node": null, "git_parents": [null], "node": "af97d98eaf54a247831f3fa7150d4191c5071234", "parents": ["2b15c487636e7ddf38c18958dd45784bb67b148a"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1623176 - Normalize URI in loadContentPage. r=mixedpuppy, a=test-only\n\nA test used `encodeURIComponent` on a query string and expected the\nresulting URL to be comparable with URLs in a progress listener.\nBut `encodeURIComponent` doesn't escape an apostrophe (`'`), whereas\n`'` is percent-encoded as `%27` via nsIURI.\n\nTo ensure that it works as expected, use `nsIURI::equals` to compare\nURLs instead of doing string comparisons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79304", "files": ["toolkit/components/extensions/ExtensionXPCShellUtils.jsm", "toolkit/components/extensions/test/xpcshell/test_ext_webRequest_mergecsp.js"], "git_node": null, "git_parents": [null], "node": "139fd6502de50db1f5e397e80affaba44747373e", "parents": ["af97d98eaf54a247831f3fa7150d4191c5071234"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1635781 - Fix broken logic in test_ext_webRequest_mergecsp.js. r=mixedpuppy, a=RyanVM\n\n- Most importantly: Fix the `test_csp` helper to actually replace the\n  page's CSP header. The existing tests verify that the web page's CSP\n  is still applied, which is trivially true if the helper extension\n  appends the CSP instead of replacing it.\n\n- Expand comment on the meaning of the parameters in `test_csp`.\n\n- `sendMessage` is not async, properly await the result.\n\n- Unload extensions before checking assertions, to avoid unhelpful error\n  messages about extensions not having been unloaded at the end of the\n  test.\n\n- Report which test case is being run to make debugging easier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80760", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_webRequest_mergecsp.js"], "git_node": null, "git_parents": [null], "node": "eb8a75f46db0fea1067f2cbc9d80250d081c5988", "parents": ["139fd6502de50db1f5e397e80affaba44747373e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1635781 - Fully replace the web page's CSP if modified by add-on. r=mixedpuppy, a=RyanVM\n\nThe original addition of CSP to `headersAlreadySet` in bug 1462989 was\nto make sure that CSP response headers from different extensions are\nmerged as expected. The logic did however not take into account that\nunconditionally merging modified headers means that the header would be\nmerged with the original CSP from the web page, which prevented add-ons\nfrom relaxing a CSP from the web page.\n\nThis commit fixes the bug by tracking the CSP status on the\n`ResponseHeaderChanger` instance, which is shared by all webRequest\nhandlers of a single request.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80761", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_webRequest_cached.js", "toolkit/components/extensions/test/xpcshell/test_ext_webRequest_mergecsp.js", "toolkit/components/extensions/webrequest/WebRequest.jsm"], "git_node": null, "git_parents": [null], "node": "cdbc208638c34ae0623f95c66ab22d0812d741a8", "parents": ["eb8a75f46db0fea1067f2cbc9d80250d081c5988"], "tags": []}], "date": 1593736403, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "26": {"changesets": [{"author": "Tom Tung \u003cttung@mozilla.com\u003e", "branch": "default", "desc": "Bug 1645943 - Check results from nsIFile's functions rather than mozStorage's/SQLite's in LockedGetPaddingSizeFromDB; r=janv,sg a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79959", "files": ["dom/cache/DBAction.cpp", "dom/cache/DBAction.h", "dom/cache/QuotaClient.cpp", "dom/cache/QuotaClient.h"], "git_node": null, "git_parents": [null], "node": "72ebc41592ad801f65fed9a2cb9529686ef4b2ab", "parents": ["cdbc208638c34ae0623f95c66ab22d0812d741a8"], "tags": []}, {"author": "Tom Tung \u003cttung@mozilla.com\u003e", "branch": "default", "desc": "Bug 1645943 - A testcase to ensure temporary storage initialization is not blocked by a cache directory in an origin directory that ends with a period; r=janv a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80001", "files": ["dom/quota/test/xpcshell/test_initTemporaryStorage.js"], "git_node": null, "git_parents": [null], "node": "a201dcf7279aaa4d088aa0da0b02f8ec51de6b85", "parents": ["72ebc41592ad801f65fed9a2cb9529686ef4b2ab"], "tags": []}, {"author": "Tom Tung \u003cttung@mozilla.com\u003e", "branch": "default", "desc": "Bug 1645943 - Override xFullPathname to avoid the use of GetFullPathNameW; r=janv,asuth a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80202", "files": ["dom/quota/test/xpcshell/test_originEndsWithDot.js", "dom/quota/test/xpcshell/xpcshell.ini", "modules/libpref/init/StaticPrefList.yaml", "storage/TelemetryVFS.cpp"], "git_node": null, "git_parents": [null], "node": "2ddcaa06e5028afb9679806e526023726b7fe542", "parents": ["a201dcf7279aaa4d088aa0da0b02f8ec51de6b85"], "tags": []}, {"author": "J.C. Jones \u003cjjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1644627 - Set the WebAuthn `appid` client extension result properly r=bbeurdouche,keeler a=RyanVM\n\nThe semantics of what Firefox implemented for the AppID extension for WebAuthn\nwere wrong. Notably: It was always emitted if the extension were used, and\nalways set to `true`. The specification has more nuance so that RPs can use\nthat result to determine what to validate against.\n\nAs a reminder since it's been a while, this change has impacts to the WebAuthn\nToken Manager layer, so there's duplicative changes in the soft token and in\nthe HID token, _and the automated tests only test the soft token_. Manual\ntesting using webauthn.bin.coffee and other test sites are needed to verify\nbehavior in U2FHIDTokenManager.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79568", "files": ["dom/webauthn/U2FHIDTokenManager.cpp", "dom/webauthn/U2FHIDTokenManager.h", "dom/webauthn/U2FSoftTokenManager.cpp", "dom/webauthn/tests/browser/browser_fido_appid_extension.js", "dom/webauthn/tests/browser/browser_webauthn_telemetry.js", "dom/webauthn/tests/browser/head.js", "dom/webauthn/tests/test_webauthn_loopback.html"], "git_node": null, "git_parents": [null], "node": "55e7f19ac0110263ebe0eee5974a5f205b1e1bed", "parents": ["2ddcaa06e5028afb9679806e526023726b7fe542"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1592658 - Policy should not override user's locale choice. r=jaws,zbraniecki a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79913", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/tests/xpcshell/test_requestedlocales.js"], "git_node": null, "git_parents": [null], "node": "eabefa56ac9f933b0e35aa9f425a15c992fd7093", "parents": ["55e7f19ac0110263ebe0eee5974a5f205b1e1bed"], "tags": []}, {"author": "Itiel \u003citiel_yn8@walla.com\u003e", "branch": "default", "desc": "Bug 1648417 - Fix the doorhanger icon for updating an autofilled form. r=MattN, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81536", "files": ["browser/extensions/formautofill/content/icon-address-update.svg"], "git_node": null, "git_parents": [null], "node": "7276774749c20d50959a38af8a9342e155d2a504", "parents": ["eabefa56ac9f933b0e35aa9f425a15c992fd7093"], "tags": []}], "date": 1593740609, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "27": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82371", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "d3508ddb5a3f2c36aba376f9f8777246783887ad", "parents": ["7276774749c20d50959a38af8a9342e155d2a504"], "tags": []}, {"author": "Molly Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1644954 - Improve DLL loading. r=gfx-reviewers,jrmuizel, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81387", "files": ["gfx/2d/Factory.cpp", "toolkit/xre/nsAppRunner.cpp"], "git_node": null, "git_parents": [null], "node": "b234c76deb4a40581cfcfdfb957481be169998c1", "parents": ["d3508ddb5a3f2c36aba376f9f8777246783887ad"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1642922 - Tweak scroll-padding implementation to also account for visibility. r=hiro, a=RyanVM\n\nThe previous implementation made us think that stuff was visible when in\nfact it was not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79345", "files": ["dom/base/test/test_focus_scroll_padding_tab.html", "layout/base/PresShell.cpp"], "git_node": null, "git_parents": [null], "node": "f1b4b1f1311fef093c66e4390952528431595bfb", "parents": ["b234c76deb4a40581cfcfdfb957481be169998c1"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1636823 - nsInputTransport must support blocking and async source - part 1 - Use NS_MakeAsyncNonBlockingInputStream, r=smaug,mayhemer a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78233", "files": ["netwerk/base/nsInputStreamPump.cpp", "xpcom/io/nsStreamUtils.cpp", "xpcom/io/nsStreamUtils.h"], "git_node": null, "git_parents": [null], "node": "d66c167025b0245b6579d36dafc7849b58381eca", "parents": ["f1b4b1f1311fef093c66e4390952528431595bfb"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1636823 - nsInputTransport must support blocking and async source - part 2 - implementation, r=smaug,mayhemer a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78234", "files": ["netwerk/base/nsStreamTransportService.cpp"], "git_node": null, "git_parents": [null], "node": "7810eec5685704cac4285a2b1496f9104be2e444", "parents": ["d66c167025b0245b6579d36dafc7849b58381eca"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1636823 - nsInputTransport must support blocking and async source - part 3 - move gtests, r=smaug,mayhemer a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78235", "files": ["netwerk/test/TestBind.cpp", "netwerk/test/TestCommon.h", "netwerk/test/TestCookie.cpp", "netwerk/test/TestNamedPipeService.cpp", "netwerk/test/TestUDPSocket.cpp", "netwerk/test/gtest/TestBind.cpp", "netwerk/test/gtest/TestCommon.cpp", "netwerk/test/gtest/TestCommon.h", "netwerk/test/gtest/TestCookie.cpp", "netwerk/test/gtest/TestNamedPipeService.cpp", "netwerk/test/gtest/TestUDPSocket.cpp", "netwerk/test/gtest/TestURIMutator.cpp", "netwerk/test/gtest/moz.build", "netwerk/test/moz.build"], "git_node": null, "git_parents": [null], "node": "43b5b2c5e34eefe7df49ab161c1f53c64874de88", "parents": ["7810eec5685704cac4285a2b1496f9104be2e444"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1636823 - nsInputTransport must support blocking and async source - part 4 - gtest for inputStreamTransport, r=smaug,mayhemer a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78236", "files": ["netwerk/test/gtest/TestInputStreamTransport.cpp", "netwerk/test/gtest/TestReadStreamToString.cpp", "netwerk/test/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "6dcb7d31d7fd149a95b969e2f7b45c80794b6725", "parents": ["43b5b2c5e34eefe7df49ab161c1f53c64874de88"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1646928 - Bogus scheme typo correction in URIFixup. r=harry, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81329", "files": ["docshell/base/URIFixup.jsm", "docshell/test/unit/test_URIFixup_info.js"], "git_node": null, "git_parents": [null], "node": "c140acd62ff285bd69cb1136fed225f199702366", "parents": ["6dcb7d31d7fd149a95b969e2f7b45c80794b6725"], "tags": []}], "date": 1594068237, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "28": {"changesets": [{"author": "yulia \u003cystartsev@mozilla.com\u003e", "branch": "default", "desc": "Bug 1644839 - fix return value of emitOptionalChain on failure; r=jandem, a=RyanVM\n\nOptional Chain had two cases where, on failure, instead of returning false we were returning true. This patch fixes the issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79682", "files": ["js/src/frontend/BytecodeEmitter.cpp"], "git_node": null, "git_parents": [null], "node": "37e7c78a75e7aec5278fb3789137956474d98e5b", "parents": ["c140acd62ff285bd69cb1136fed225f199702366"], "tags": []}, {"author": "Jan Varga \u003cjvarga@mozilla.com\u003e", "branch": "default", "desc": "Bug 1649393 - Remove old IDB files directories during 1.0 to 2.0 storage upgrade; r=ttung, a=RyanVM\n\nIf an old IDB files directory exists, it no longer causes a failure during the\nstorage upgrade. The directory is removed instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81870", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/quota/test/xpcshell/upgrades/test_upgradeStorageFrom1_0_idb.js", "dom/quota/test/xpcshell/upgrades/version1_0_idb_profile.json", "dom/quota/test/xpcshell/upgrades/version1_0_idb_profile.zip", "dom/quota/test/xpcshell/upgrades/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "3a5725e256c10af8aaf1e3ff8848537ec1b3a7fb", "parents": ["37e7c78a75e7aec5278fb3789137956474d98e5b"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648008 - Don't report DNS error if the socket is closed by client side. r=dragana, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81469", "files": ["netwerk/base/nsSocketTransport2.cpp"], "git_node": null, "git_parents": [null], "node": "7ba229238221ce671a9cd9c3de695a12acd36938", "parents": ["3a5725e256c10af8aaf1e3ff8848537ec1b3a7fb"], "tags": []}, {"author": "Raphael Pierzina \u003crpierzina@mozilla.com\u003e", "branch": "default", "desc": "Bug 1649878 - Fix tt(i) event ping test to handle optional event fields; r=Dexter, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81975", "files": ["toolkit/components/telemetry/tests/integration/tests/test_event_ping.py"], "git_node": null, "git_parents": [null], "node": "7062e50ded42a2e4274480e860e306be68bd82b9", "parents": ["7ba229238221ce671a9cd9c3de695a12acd36938"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1647200 - Don't add the trimmed protocol on urlbar copy if it's already present. r=dao, a=RyanVM\n\nWhen focusing the urlbar after a non-whitelisted host is visited, we add the\ntrimmed protocol in front of it, because otherwise modifying the url and then\nresubmitting may end up searching. Due to that, it's possible the value is not\ntrimmed when we build the clipboard string.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81537", "files": ["browser/components/urlbar/UrlbarInput.jsm", "browser/components/urlbar/tests/browser/browser_copying.js"], "git_node": null, "git_parents": [null], "node": "9dfd39ee6c107cebd90a52d9191abb550f301edb", "parents": ["7062e50ded42a2e4274480e860e306be68bd82b9"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1650414 - Cherry-pick commit 1e6027e29cd5d900337b23a20886b2a8d81bb2de from upstream harfbuzz to fix AAT mark anchoring. r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82318", "files": ["gfx/harfbuzz/src/hb-aat-layout-kerx-table.hh"], "git_node": null, "git_parents": [null], "node": "e45931c7c81dd258c72727d41ca8a54a292b8de2", "parents": ["9dfd39ee6c107cebd90a52d9191abb550f301edb"], "tags": []}], "date": 1594071213, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "29": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1471854 - Don't make native format-choosing dependent on print preview. r=jwatt, a=RyanVM\n\nNot returning a valid target for print output causes the whole printing\nprogress to fail. When printing silent, we choose \"native\" format, which in the\nGTK backend just fails because we return null (wat).\n\nThis fixes printing with print.always_print_silent. Printing via the file\ndialog gets an explicit format so we don't hit that code path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79116", "files": ["widget/gtk/nsDeviceContextSpecG.cpp", "widget/gtk/nsDeviceContextSpecG.h"], "git_node": null, "git_parents": [null], "node": "5a41f844a4b25185d2c9d222d68f09f20525099e", "parents": ["e45931c7c81dd258c72727d41ca8a54a292b8de2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1471854 - Make print.always_print_silent a static pref. r=jwatt, a=RyanVM\n\nSo that it shows up in about:config (and also it's faster that way).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79117", "files": ["layout/printing/nsPrintJob.cpp", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/printingui/ipc/PrintingParent.cpp"], "git_node": null, "git_parents": [null], "node": "f6094be753bdedcb9854e928e5da4f4c2c397581", "parents": ["5a41f844a4b25185d2c9d222d68f09f20525099e"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1635293 - Cherry-pick ANGLE fix: Update tex cache even if new type is InvalidEnum. r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D79755", "files": ["gfx/angle/checkout/out/gen/angle/id/commit.h", "gfx/angle/checkout/src/libANGLE/State.cpp", "gfx/angle/cherry_picks.txt"], "git_node": null, "git_parents": [null], "node": "b1e067197dcef2b48ac121c73a83800eab9eb0e0", "parents": ["f6094be753bdedcb9854e928e5da4f4c2c397581"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1644738 - Propagate the IsOnContentBlockingAllowList in CookieJarSettings to the script generated document. r=baku, a=RyanVM\n\nWe also need to propagate the IsOnContentBlockingAllowList to the script\ngenerated document. For this kind of document, it won't have the\nCookieJarSettings at the first place. It will generate its\nCookieJarSettings when someone requests it. And we need to propagate the\nflag when generating the CookieJarSettings in this case. Or the script\ngenerated document will have a wrong IsOnContentBlockingAllowList flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81727", "files": ["dom/base/Document.cpp", "netwerk/cookie/CookieJarSettings.cpp", "netwerk/cookie/CookieJarSettings.h"], "git_node": null, "git_parents": [null], "node": "d12deadbcf40f36a3631529e8822d1f82c877c17", "parents": ["b1e067197dcef2b48ac121c73a83800eab9eb0e0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1650189 - Fix an off-by-one in the transition property iterator. r=mrobinson, a=RyanVM\n\nBy the time we get to iterate over the longhands of a shorthand, we've\nalready advanced the range iterator, so we look at the next duration and\nsuch, which causes this bug.\n\nI'm seriously baffled that no existing test caught this when it\nlanded, neither in our internal test suite nor wpt...  :/\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82396", "files": ["servo/components/style/properties/helpers/animated_properties.mako.rs", "testing/web-platform/tests/css/css-transitions/transition-duration-shorthand.html"], "git_node": null, "git_parents": [null], "node": "89c8569239fe9658477cd426945edf850666bd86", "parents": ["d12deadbcf40f36a3631529e8822d1f82c877c17"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1649347 - RefMessageBody needs to protect the reading when shared cross threads, r=edenchuang a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81972", "files": ["dom/ipc/RefMessageBodyService.cpp", "dom/ipc/RefMessageBodyService.h", "dom/ipc/SharedMessageBody.cpp"], "git_node": null, "git_parents": [null], "node": "ba35b8f940e80b6daa829c5e09fab477d9352473", "parents": ["89c8569239fe9658477cd426945edf850666bd86"], "tags": []}], "date": 1594155439, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "30": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset ba35b8f940e8 (bug 1649347)", "files": ["dom/ipc/RefMessageBodyService.cpp", "dom/ipc/RefMessageBodyService.h", "dom/ipc/SharedMessageBody.cpp"], "git_node": null, "git_parents": [null], "node": "f49d476903bf5a4db167f0878e75ab418da3e008", "parents": ["ba35b8f940e80b6daa829c5e09fab477d9352473"], "tags": []}], "date": 1594156123, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "31": {"changesets": [{"author": "Christoph Kerschbaumer \u003cckerschb@christophkerschbaumer.com\u003e", "branch": "FIREFOX_ESR_78_0_X_RELBRANCH", "desc": "Bug 1644076: Bring back XFO check in StartDocumentLoad for type internal object and embed. r=smaug, a=jcristau\n\nDifferential Revision: h