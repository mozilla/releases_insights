ogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "1b41cd29a077f2504c50268424a621db5542d535", "git_parents": ["6bacaefc460588a79759b9e12674146b436e6da8"], "node": "16f1182f6c719ce474db413f863606ee311afadf", "parents": ["af1bc59f27574ae0b1e0dcb8429e6d9716f88e58"], "tags": []}], "date": 1785782559, "git_changesets": ["1b41cd29a077f2504c50268424a621db5542d535"], "user": "dsmith@mozilla.com"}, "154": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2057101  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313927\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315527\n", "files": ["gfx/layers/d3d11/TextureD3D11.cpp"], "git_node": "752eaf05132c9ba3157d26f6b17399632cad4255", "git_parents": ["1b41cd29a077f2504c50268424a621db5542d535"], "node": "8683aa8bfc8b1bcf95762be1f3dd09b9cd017554", "parents": ["16f1182f6c719ce474db413f863606ee311afadf"], "tags": []}], "date": 1785782586, "git_changesets": ["752eaf05132c9ba3157d26f6b17399632cad4255"], "user": "dsmith@mozilla.com"}, "155": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054673.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315656\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.h"], "git_node": "56d6a58ab54d6f961c80eee91a00552f5d80444f", "git_parents": ["752eaf05132c9ba3157d26f6b17399632cad4255"], "node": "1f9708af6b866db8a318bf700082a7ef75925c13", "parents": ["8683aa8bfc8b1bcf95762be1f3dd09b9cd017554"], "tags": []}], "date": 1785782609, "git_changesets": ["56d6a58ab54d6f961c80eee91a00552f5d80444f"], "user": "dsmith@mozilla.com"}, "156": {"changesets": [{"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051013 - Validate `mInnerURI` when deserializing,  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314611\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315612\n", "files": ["netwerk/base/nsSimpleNestedURI.cpp", "netwerk/base/nsSimpleNestedURI.h", "netwerk/protocol/about/nsAboutProtocolHandler.cpp", "netwerk/protocol/about/nsAboutProtocolHandler.h"], "git_node": "696b7eaa70297691b94688ad6b3bb269cb19062f", "git_parents": ["56d6a58ab54d6f961c80eee91a00552f5d80444f"], "node": "7a76d67e31ae422249a2ed7938f39a95cf5a42b9", "parents": ["1f9708af6b866db8a318bf700082a7ef75925c13"], "tags": []}], "date": 1785782633, "git_changesets": ["696b7eaa70297691b94688ad6b3bb269cb19062f"], "user": "dsmith@mozilla.com"}, "157": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1955142 - Make `nsFrameSelection::MoveCaret` should do nothing if the anchor-focus range is outside the limiters  a=diannaS DONTBUILD\n\nCurrently, browsers allow the selection range to be outside the focused\nediting host. Then, only Chrome allow to modify the `Selection`.\nHowever, I think we should not follow Chrome because it may cause more\ncomplicated things in edge cases. Therefore, the new tentative WPT\ncheck whether the selection won't be modified.\n\nNote that the reported assertion failure occurs only when the selection\nmove crosses a frame. Therefore, the new WPT puts caret at edge of the\n`Text` to cross the frame boundary with the `Selection.modify` call.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315133\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315911\n", "files": ["layout/generic/nsFrameSelection.cpp", "testing/web-platform/tests/selection/contenteditable/selection-outside-focused-editing-host.tentative.html"], "git_node": "6f766a6502a5623d570b3c357d9f5a5d39ee66a6", "git_parents": ["696b7eaa70297691b94688ad6b3bb269cb19062f"], "node": "fdbaf7643d6765b468485e0dc705af7b3b1f204b", "parents": ["7a76d67e31ae422249a2ed7938f39a95cf5a42b9"], "tags": []}], "date": 1785782788, "git_changesets": ["6f766a6502a5623d570b3c357d9f5a5d39ee66a6"], "user": "dsmith@mozilla.com"}, "158": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044313 - Only allow loading page-icon, moz-icon and moz-remote-image in image contexts.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304085\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315976\n", "files": ["browser/base/content/test/static/browser_parsable_css.js", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/security/test/crashtests/1583044.html", "dom/security/test/crashtests/crashtests.list", "dom/security/test/general/chrome.toml", "dom/security/test/general/test_image_protocol_document_context.html", "image/ImageBlocker.cpp", "image/decoders/icon/nsIconProtocolHandler.cpp", "image/remote/RemoteImageProtocolHandler.cpp", "toolkit/components/places/PageIconProtocolHandler.cpp"], "git_node": "2f9a90a6ca87790b18704ac32cd829534582d7f6", "git_parents": ["6f766a6502a5623d570b3c357d9f5a5d39ee66a6"], "node": "b795ffe2e116e2880f0eb596a7dc0e89d4b3eae5", "parents": ["fdbaf7643d6765b468485e0dc705af7b3b1f204b"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049681 - Don't show \"Open in Image in New Tab\" and \"Save Image As\" for certain image protocols.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308256\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315977\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/contextMenu/browser.toml", "browser/base/content/test/contextMenu/browser_contextmenu_blocked_image_protocols.js", "browser/base/content/test/contextMenu/file_blocked_image_protocols.html"], "git_node": "645af28144ac3cc0da4ba453b0f6dd55ce973d05", "git_parents": ["2f9a90a6ca87790b18704ac32cd829534582d7f6"], "node": "102364cc37b5f040878e3dd5ecaede50cf60ec69", "parents": ["b795ffe2e116e2880f0eb596a7dc0e89d4b3eae5"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050364 - Only allow loading other image protocols in an image context.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308987\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316041\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/contextMenu/browser_contextmenu_blocked_image_protocols.js", "browser/base/content/test/contextMenu/file_blocked_image_protocols.html", "netwerk/ipc/NeckoParent.cpp", "netwerk/protocol/res/MozNewTabWallpaperProtocolHandler.cpp", "netwerk/protocol/res/MozNewTabWallpaperProtocolHandler.h", "netwerk/protocol/res/PageThumbProtocolHandler.cpp", "netwerk/protocol/res/PageThumbProtocolHandler.h", "netwerk/test/unit/test_wallpaper_protocol.js", "toolkit/components/places/nsCachedFaviconProtocolHandler.cpp"], "git_node": "c4b201cb5588ade024186ee9c8dccd0231880a10", "git_parents": ["645af28144ac3cc0da4ba453b0f6dd55ce973d05"], "node": "677eebaf8e2798a78722e5c93de26a75406424b0", "parents": ["102364cc37b5f040878e3dd5ecaede50cf60ec69"], "tags": []}], "date": 1785782817, "git_changesets": ["2f9a90a6ca87790b18704ac32cd829534582d7f6", "645af28144ac3cc0da4ba453b0f6dd55ce973d05", "c4b201cb5588ade024186ee9c8dccd0231880a10"], "user": "dsmith@mozilla.com"}, "159": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2057100  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313928\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315524\n", "files": ["gfx/gl/SharedSurfaceD3D11Interop.cpp"], "git_node": "8e2107437ed5bb0146d437fce50eb06a65bc40cc", "git_parents": ["c4b201cb5588ade024186ee9c8dccd0231880a10"], "node": "31d695128838181abb5e9299599bcd1e8423b530", "parents": ["677eebaf8e2798a78722e5c93de26a75406424b0"], "tags": []}], "date": 1785785599, "git_changesets": ["8e2107437ed5bb0146d437fce50eb06a65bc40cc"], "user": "dsmith@mozilla.com"}, "16": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053853 - Fix check in SMRegExpMacroAssembler::CheckPosition.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311806\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312935\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp"], "git_node": "87f80794b0ec04ab212a49b47dc7e042d0587530", "git_parents": ["429dd09df20917249cab1c001505b560883b2c03"], "node": "ab5e03201be48f2f3f72852cf215fdfe6ec2e1ef", "parents": ["14962e493dbdacfd6b142ef9ae6ba3d4f4af55f6"], "tags": []}], "date": 1784653398, "git_changesets": ["87f80794b0ec04ab212a49b47dc7e042d0587530"], "user": "dsmith@mozilla.com"}, "160": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2047669 - Fix text-overflow on text inputs.  a=diannaS DONTBUILD\n\nUnfortunately, I think we need to special-case this, since we don't want\nto set overflow: clip on the internal editor like we do for\n::placeholder.\n\nDraw the ellipsis only when the input is not scrolled, which matches\nother browsers and is simpler (otherwise the ellipsis would scroll).\n\nFix the caret check to deal with shadow dom, which would've kinda saved\nus a bit here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312691\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316014\n", "files": ["layout/generic/TextOverflow.cpp", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-focused-ref.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-focused.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-notref.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-rtl-notref.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-rtl-scrolled-ref.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-rtl-scrolled.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-rtl.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-scrolled-ref.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis-scrolled.html", "testing/web-platform/tests/html/rendering/widgets/input-text-overflow-ellipsis.html"], "git_node": "7f251d52e87eb1930ee383d4cbe20a788ae72484", "git_parents": ["8e2107437ed5bb0146d437fce50eb06a65bc40cc"], "node": "ab6ca92680720145febc92abc40ccb5ed40ba7b8", "parents": ["31d695128838181abb5e9299599bcd1e8423b530"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056633 - Don't allow \u003cinput\u003e / \u003ctextarea\u003e to be affected by multicol styles.  a=diannaS DONTBUILD\n\nMatches other browsers and our previous behavior, in general it doesn't\nmake sense to split an input into columns.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313434\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316015\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-multicol/textarea-text-overflow-ellipsis-crash.html", "testing/web-platform/tests/html/rendering/widgets/textarea-multicol-ref.html", "testing/web-platform/tests/html/rendering/widgets/textarea-multicol.html"], "git_node": "ddb515d198cfea4709cc4aaaedb3b797e46c22ff", "git_parents": ["7f251d52e87eb1930ee383d4cbe20a788ae72484"], "node": "5c429d9572188eb37e99aa6107d408d7bdb35b74", "parents": ["ab6ca92680720145febc92abc40ccb5ed40ba7b8"], "tags": []}], "date": 1785785623, "git_changesets": ["7f251d52e87eb1930ee383d4cbe20a788ae72484", "ddb515d198cfea4709cc4aaaedb3b797e46c22ff"], "user": "dsmith@mozilla.com"}, "161": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "[ESR 153] Bug 2045774 - Adjust picture-region handling for decoded video buffers.  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316092\n", "files": ["dom/media/MediaData.cpp", "gfx/layers/ImageContainer.cpp"], "git_node": "45137bd69b83223b59a81db173c098ddc20974f7", "git_parents": ["ddb515d198cfea4709cc4aaaedb3b797e46c22ff"], "node": "312e987017715e4e30cb59c6579ffcbea5701bcd", "parents": ["5c429d9572188eb37e99aa6107d408d7bdb35b74"], "tags": []}], "date": 1785785781, "git_changesets": ["45137bd69b83223b59a81db173c098ddc20974f7"], "user": "dsmith@mozilla.com"}, "162": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2051921 - Add policy for controlling default browser in prefs.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311372\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316101\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_default_browser_setting.js", "browser/components/enterprisepolicies/tests/xpcshell/test_defaultbrowsercheck.js", "browser/components/preferences/main.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": "8e703f87b37251b488eeea866c4d0d81bfaa5cb6", "git_parents": ["45137bd69b83223b59a81db173c098ddc20974f7"], "node": "836c907751bec29bc85eb4ca8f2be297db97b081", "parents": ["312e987017715e4e30cb59c6579ffcbea5701bcd"], "tags": []}], "date": 1785785835, "git_changesets": ["8e703f87b37251b488eeea866c4d0d81bfaa5cb6"], "user": "dsmith@mozilla.com"}, "163": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058197: ensure the patch instruction for firefox.exe is the last instruction in partial mars   a=diannaS\n\nThis ensures that Firefox cannot be run in the middle of an update being applied, reducing the chances of hitting https://bugzilla.mozilla.org/show_bug.cgi?id=1681745 and similar issues.\n\nI verified this locally by:\n* Running a `partials` task locally in a docker container with the existing code\n* Running again after injecting this new code\n* Unpacking one of the generated partials and diffing the `updatev3.manifest` contents, which showed the `firefox.exe` instruction moving to the bottom of the manifest as expected:\n\n```\nworker@a087bd0a695f:~$ diff -Naur artifacts-nofix/part/updatev3.manifest artifacts/part/updatev3.manifest\n--- artifacts-nofix/part/updatev3.manifest\t2026-07-27 16:54:46.958931475 +0000\n+++ artifacts/part/updatev3.manifest\t2026-07-27 17:26:03.533519742 +0000\n@@ -35,7 +35,6 @@\n patch \"gkcodecs.dll.patch\" \"gkcodecs.dll\"\n patch \"freebl3.dll.patch\" \"freebl3.dll\"\n patch \"firefox.exe.sig.patch\" \"firefox.exe.sig\"\n-patch \"firefox.exe.patch\" \"firefox.exe\"\n patch \"dxcompiler.dll.patch\" \"dxcompiler.dll\"\n patch \"desktop-launcher/desktop-launcher.exe.patch\" \"desktop-launcher/desktop-launcher.exe\"\n add \"dependentlibs.list\"\n@@ -61,3 +60,4 @@\n add \"browser/confused_fox.pdf\"\n add \"browser/blank.pdf\"\n remove \"chrome.manifest\"\n+patch \"firefox.exe.patch\" \"firefox.exe\"\n```\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314755\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316017\n", "files": ["tools/update-packaging/make_incremental_update.sh"], "git_node": "8a9918be4fba148fe521e5db4d6efed9e4754935", "git_parents": ["8e703f87b37251b488eeea866c4d0d81bfaa5cb6"], "node": "bf57801f983bd3b7b3059a406a01bb75450ff753", "parents": ["836c907751bec29bc85eb4ca8f2be297db97b081"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058594: optimize partial MAR operation order to minimize the chance of crashes   a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314721\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316022\n", "files": ["tools/update-packaging/make_incremental_update.sh"], "git_node": "ce4aab5dd94ba01992bc394b562f0274e9c05d2c", "git_parents": ["8a9918be4fba148fe521e5db4d6efed9e4754935"], "node": "280c01a503af46cfff67a96c8dfb493a9e08eb5a", "parents": ["bf57801f983bd3b7b3059a406a01bb75450ff753"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058759: remove firefox.exe hardcoding in make_incremental_updates.sh   a=diannaS\n\nThis was added in https://bugzilla.mozilla.org/show_bug.cgi?id=2058197 as a short term fix to some start-up crashes we were seeing in 153.0 updates. This patch gets rid of that hardcoding, allowing Thunderbird to benefit from the optimized instruction order as well, and clean up the code more generally.\n\nAFAIK the only caller to `make_incremental_update.sh` is `funsize.py`, which is also being updated here so there should be no risk to changing the required arguments.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315041\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316019\n", "files": ["taskcluster/docker/funsize-update-generator/scripts/funsize.py", "tools/update-packaging/make_incremental_update.sh", "tools/update-packaging/test/buildrefmars.sh"], "git_node": "f921d08e03bcae67df9b7002b3d8b705c3618b8f", "git_parents": ["ce4aab5dd94ba01992bc394b562f0274e9c05d2c"], "node": "945961e4f3d01697d1e6305c7c32ec113b0c2b17", "parents": ["280c01a503af46cfff67a96c8dfb493a9e08eb5a"], "tags": []}], "date": 1785785953, "git_changesets": ["8a9918be4fba148fe521e5db4d6efed9e4754935", "ce4aab5dd94ba01992bc394b562f0274e9c05d2c", "f921d08e03bcae67df9b7002b3d8b705c3618b8f"], "user": "dsmith@mozilla.com"}, "164": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2052965 - SearchEngines.PreventInstalls should hide the add search engine button in settings and its context menu item.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311883\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316110\n", "files": ["browser/actors/LinkHandlerChild.sys.mjs", "browser/base/content/nsContextMenu.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_search_engine.js", "browser/components/preferences/config/search.mjs"], "git_node": "b74f998f6e26fcf53ab6633669d66dcabd920232", "git_parents": ["f921d08e03bcae67df9b7002b3d8b705c3618b8f"], "node": "dd51eb262a48beeb1523a11b1740937f7dbe508a", "parents": ["945961e4f3d01697d1e6305c7c32ec113b0c2b17"], "tags": []}], "date": 1785787933, "git_changesets": ["b74f998f6e26fcf53ab6633669d66dcabd920232"], "user": "dsmith@mozilla.com"}, "165": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051921 - fix xpcshell tests in esr153 a=dsmith\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs"], "git_node": "31ea4b29620605768be8dd706b10097f328a0d77", "git_parents": ["b74f998f6e26fcf53ab6633669d66dcabd920232"], "node": "968bc90a28c488cbe895753832ada26111b0ffd4", "parents": ["dd51eb262a48beeb1523a11b1740937f7dbe508a"], "tags": []}], "date": 1785793913, "git_changesets": ["31ea4b29620605768be8dd706b10097f328a0d77"], "user": "dsmith@mozilla.com"}, "166": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2054643, make button's EndSubmitClick handling consistent with input type=button,  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315429\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315956\n", "files": ["dom/html/HTMLButtonElement.cpp", "dom/html/HTMLFormElement.cpp"], "git_node": "daff4cfc1d9830c8a0c58c17b7f4faa740456bf1", "git_parents": ["31ea4b29620605768be8dd706b10097f328a0d77"], "node": "55dffa802192faffa81c1fb9fc862459cc12d2e0", "parents": ["968bc90a28c488cbe895753832ada26111b0ffd4"], "tags": []}], "date": 1785797591, "git_changesets": ["daff4cfc1d9830c8a0c58c17b7f4faa740456bf1"], "user": "dsmith@mozilla.com"}, "167": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059188 - Add the missing WebGL texel unpack specializations.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315284\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315983\n", "files": ["dom/canvas/TexUnpackBlob.cpp", "dom/canvas/WebGLTexelConversions.cpp", "dom/canvas/WebGLTexelConversions.h"], "git_node": "dc10eff2d53a0269ae79f4ea6bba65452abe4ac6", "git_parents": ["daff4cfc1d9830c8a0c58c17b7f4faa740456bf1"], "node": "9079b84fedf55d1993e64bbfb2a05b9f0104497f", "parents": ["55dffa802192faffa81c1fb9fc862459cc12d2e0"], "tags": []}], "date": 1785797611, "git_changesets": ["dc10eff2d53a0269ae79f4ea6bba65452abe4ac6"], "user": "dsmith@mozilla.com"}, "168": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059424 - Transform-feedback followup.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315302\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315987\n", "files": ["dom/canvas/WebGLContextDraw.cpp", "dom/canvas/WebGLTransformFeedback.cpp"], "git_node": "cc2da29fb735d880e9583c95e5b338b12fe00b35", "git_parents": ["dc10eff2d53a0269ae79f4ea6bba65452abe4ac6"], "node": "d060f91bd6904c58eef7ea066bdd9bad2abeaba1", "parents": ["9079b84fedf55d1993e64bbfb2a05b9f0104497f"], "tags": []}], "date": 1785797630, "git_changesets": ["cc2da29fb735d880e9583c95e5b338b12fe00b35"], "user": "dsmith@mozilla.com"}, "169": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057117 - Improve shutdown handling for the media engine child actor.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314068\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316081\n", "files": ["dom/media/ipc/MFMediaEngineChild.cpp", "dom/media/ipc/MFMediaEngineChild.h"], "git_node": "c892d98af1b55f772eb51d71a6d941e8abdfd10a", "git_parents": ["cc2da29fb735d880e9583c95e5b338b12fe00b35"], "node": "e5fdd3249eaa089f33ed1c5e982e0165976d7418", "parents": ["d060f91bd6904c58eef7ea066bdd9bad2abeaba1"], "tags": []}], "date": 1785797651, "git_changesets": ["c892d98af1b55f772eb51d71a6d941e8abdfd10a"], "user": "dsmith@mozilla.com"}, "17": {"changesets": [{"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052688 - Small rework of wasm tail-calls and traps.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311219\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313062\n", "files": ["js/src/vm/JitActivation.cpp", "js/src/vm/JitActivation.h"], "git_node": "2b04398cb6681712a8d19c3c0ea5d66da0242810", "git_parents": ["87f80794b0ec04ab212a49b47dc7e042d0587530"], "node": "590f2fec2ec54086716f0854dc44204adc42a6c7", "parents": ["ab5e03201be48f2f3f72852cf215fdfe6ec2e1ef"], "tags": []}], "date": 1784653419, "git_changesets": ["2b04398cb6681712a8d19c3c0ea5d66da0242810"], "user": "dsmith@mozilla.com"}, "170": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058645 - Clear a stale user value when an incoming pref update flips the type.  a=diannaS DONTBUILD\n\nPref keeps its default and user values in a union governed by a single shared\ntype tag. FromDomPref applies the incoming default value first, so when that\nvalue changes the type it leaves mUserValue holding a member of the old type,\nwhich the user-value handling right below then reads as the new type.\n\nA content process can hold a user value whose type no longer matches the\nparent's, because ContentParent::Observe deliberately drops updates for prefs\nthat ShouldSanitizePreference() classifies as sanitized, and that\nclassification applies only while a dynamically named pref is a String without\na default value.\n\nClear such a user value before the type tag changes, while Clear() can still\nmatch the type it was actually stored as.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315248\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315937\n", "files": ["modules/libpref/Preferences.cpp"], "git_node": "7bc4f8bf2a6021ca0588870023b3894b78ec7864", "git_parents": ["c892d98af1b55f772eb51d71a6d941e8abdfd10a"], "node": "00e0eeb82ee168c97dcf8b9cf972aa126636be17", "parents": ["e5fdd3249eaa089f33ed1c5e982e0165976d7418"], "tags": []}], "date": 1785797675, "git_changesets": ["7bc4f8bf2a6021ca0588870023b3894b78ec7864"], "user": "dsmith@mozilla.com"}, "171": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 1: Add tests for push subscribes  a=diannaS\n\nThis mostly copies the same tests from notifications.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315057\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315991\n", "files": ["testing/web-platform/meta/push-a