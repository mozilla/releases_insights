426aa65e21a08218f3000aa08e7656a902b27c3b", "parents": ["a6a35f0083c2393c2380a08d869f0585bcde0e76"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging abd1fe67f4c3b677caecb582d55601a7b1191dc4 with FIREFOX_153_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "05783147962b54d6137cd94f222a4c78916db0bb", "git_parents": ["307a5a8bd3a2915e179f830ce67d376dbbd256ed"], "node": "50557b286cc52df712d12538095d8d862dd4d9a8", "parents": ["426aa65e21a08218f3000aa08e7656a902b27c3b"], "tags": []}], "date": 1784637965, "git_changesets": ["15ddbaef966012ae04dc86960a713356b96522d4", "17afadb7dae34924aef9e970a260b4e7e42ae132", "fb16a746b2ba40f60258102d693b63cc04bb36b8", "330d9027ffe93b051d6c8e152a9c9f7851f21897", "94b5fe1ecc9e759238d6386858ea8941e8c504fc", "7ca66aad04d882d51624f505f0505f8eee4f9cd6", "85b992467eb7d5e7ca83f7f44ba1002d14abc0cd", "307a5a8bd3a2915e179f830ce67d376dbbd256ed", "05783147962b54d6137cd94f222a4c78916db0bb"], "user": "ffxbld@lando.moz.tools"}, "120": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update HSTS HPKP -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315720\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "c85f36a91518a8fab065ae902504ba99acc89f74", "git_parents": ["fa89756b7bcf24e9167561ceb8fc339f9fc75a6a"], "node": "dd7638fa34edeb72526b10001a877a8da8c1ed5b", "parents": ["bbd6af60de4545f6750d588fc3e73ac0280692b3"], "tags": []}], "date": 1785527411, "git_changesets": ["c85f36a91518a8fab065ae902504ba99acc89f74"], "user": "rvandermeulen@mozilla.com"}, "121": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880253: Part 1 - Add file download ZoneId setter to WinUtils  a=RyanVM\n\nThis will allow it to be used by Save File As, etc.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D301933\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315676\n", "files": ["toolkit/components/downloads/DownloadIntegration.sys.mjs", "toolkit/components/downloads/DownloadPlatform.cpp", "toolkit/components/downloads/mozIDownloadPlatform.idl", "widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h"], "git_node": "127f8429ec49a429103f82227386b566ad5de18e", "git_parents": ["c85f36a91518a8fab065ae902504ba99acc89f74"], "node": "df6e6adf7aa8e03e77a0c1b1a339cfb4dde24549", "parents": ["dd7638fa34edeb72526b10001a877a8da8c1ed5b"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880253: Part 2 - Set zone of Save Page As files as Internet  a=RyanVM\n\nSetting the zone for save page as files means that the OS knows whether they\ncame from a trusted zone or not.  Files from untrusted zones will trigger the\nUAC dialog when used insecurely (e.g. double-clicking a .js file).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D301934\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315677\n", "files": ["dom/webbrowserpersist/nsWebBrowserPersist.cpp", "dom/webbrowserpersist/nsWebBrowserPersist.h"], "git_node": "85e9892bbeb9cd358f11ad1eb554a7a7efe33395", "git_parents": ["127f8429ec49a429103f82227386b566ad5de18e"], "node": "3196758d17531834bccb61b58f4dbb6182aef0f1", "parents": ["df6e6adf7aa8e03e77a0c1b1a339cfb4dde24549"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880253: Part 3 - Test WinUtils::MaybeWriteFileZoneId  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302602\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315678\n", "files": ["widget/windows/tests/gtest/TestWinUtils.cpp"], "git_node": "630ed583b55e12db73ce3fa34df6caa4944d8b39", "git_parents": ["85e9892bbeb9cd358f11ad1eb554a7a7efe33395"], "node": "11f8e7a9a8c8fd3ef9829770677036696779b779", "parents": ["3196758d17531834bccb61b58f4dbb6182aef0f1"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880253: Part 4 - Revise Windows zone writer API to be more versatile  a=RyanVM\n\nThe previous interface conflated having a source or referrer with writing them.\nThe source is needed to determine the zone, so that meant we couldn't\ndetermine the correct zone when not writing information because the\ninformation came from private browsing.  This change allows the zone to\nbe established correctly even when not writing URLs, which technically\nmeans it leaks a minor amount of information, but nothing sensitive.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304318\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315679\n", "files": ["dom/webbrowserpersist/nsWebBrowserPersist.cpp", "toolkit/components/downloads/DownloadIntegration.sys.mjs", "toolkit/components/downloads/DownloadPlatform.cpp", "toolkit/components/downloads/mozIDownloadPlatform.idl", "widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h", "widget/windows/tests/gtest/TestWinUtils.cpp"], "git_node": "1c7282e73f12cb9bc63ae9920e9c77d935804cc8", "git_parents": ["630ed583b55e12db73ce3fa34df6caa4944d8b39"], "node": "d05c33932acd19c32afd1b9b887ecf48fc3dadf5", "parents": ["11f8e7a9a8c8fd3ef9829770677036696779b779"], "tags": []}], "date": 1785527586, "git_changesets": ["127f8429ec49a429103f82227386b566ad5de18e", "85e9892bbeb9cd358f11ad1eb554a7a7efe33395", "630ed583b55e12db73ce3fa34df6caa4944d8b39", "1c7282e73f12cb9bc63ae9920e9c77d935804cc8"], "user": "rvandermeulen@mozilla.com"}, "122": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2051089 - Surface enterprise policy validation errors and keep one bad value from aborting the engine.  a=RyanVM DONTBUILD\n\nThe compliant validator throws (rather than returning invalid) for some inputs\nsuch as an undefined value, which previously escaped _activatePolicies and\naborted all policy processing with nothing logged. Fail just that policy\ninstead, report a clean message for unparseable JSON, log the validator's\nfield-located error, and reword the ExtensionSettings handler message so it\nno longer implies the whole policy was rejected when only part failed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309407\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315729\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_PolicySchemaValidator.js", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/PolicySchemaValidator.sys.mjs"], "git_node": "c3a063511ef9e99b6ffcd82e7d9867e516e70c1e", "git_parents": ["1c7282e73f12cb9bc63ae9920e9c77d935804cc8"], "node": "b789dad86f388572bfee64cace9aa62965b99dbf", "parents": ["d05c33932acd19c32afd1b9b887ecf48fc3dadf5"], "tags": []}], "date": 1785703386, "git_changesets": ["c3a063511ef9e99b6ffcd82e7d9867e516e70c1e"], "user": "rvandermeulen@mozilla.com"}, "123": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055856 - Update gfx SanityTest to load with a resource:// URL in a content process.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312717\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315572\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "dom/security/nsContentSecurityUtils.cpp", "toolkit/components/gfx/SanityTest.sys.mjs", "toolkit/components/gfx/content/gfxFrameScript.js", "toolkit/components/gfx/content/sanitytest.html", "toolkit/components/gfx/jar.mn"], "git_node": "817cabc714f2e072f4596673ac0d952ff79b61b6", "git_parents": ["c3a063511ef9e99b6ffcd82e7d