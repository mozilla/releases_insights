owser/browser.toml", "docshell/test/browser/browser_purge_shistory_keeps_current.js"], "git_node": "d4c587d1e59eea6231d730b12823915b16f08295", "git_parents": ["16aa2109b389104a7841a8ebceef447f5d87bad9"], "node": "1d1f98f962623e958c3c82fd0a8e28b75fdbcf5b", "parents": ["688028ea0d7bf2e863a5dc6b6c807bbe07860041"], "tags": []}], "date": 1786141751, "git_changesets": ["d4c587d1e59eea6231d730b12823915b16f08295"], "user": "rvandermeulen@mozilla.com"}, "238": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 1: Fix handling of budget expiry during main thread only marking  a=RyanVM\n\nCurrently we don't take account of the fact that we may run out of budget doing\nmain-thread-only marking at the start of a marking slice and return Finished\nwhen we're not.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317021\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp"], "git_node": "dcc026885a25d633504d3fa5ae8c0dcc9de0b337", "git_parents": ["d4c587d1e59eea6231d730b12823915b16f08295"], "node": "cbb55279af9244af4b4ce945128e70581abad843", "parents": ["1d1f98f962623e958c3c82fd0a8e28b75fdbcf5b"], "tags": []}], "date": 1786141778, "git_changesets": ["dcc026885a25d633504d3fa5ae8c0dcc9de0b337"], "user": "rvandermeulen@mozilla.com"}, "239": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2057033: Disable ::-webkit-scrollbar on gemini.google.com.  a=diannaS DONTBUILD\n\nThe gemini.google.com website has its own bespoke \"fake overlay scrollbars\"\nscrollbar styles.  Their styles turn out to produce a worse experience for\nus if we enable our partial ::-webkit-scrollbar support.  So, let's turn off\nthat support on this site for now.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313616\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317192\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "18b863adf54fb715d18466889f7b5ae4403627d7", "git_parents": ["dcc026885a25d633504d3fa5ae8c0dcc9de0b337"], "node": "2af6b4a647ee5713fc37ff00ce467d65c420d7d7", "parents": ["cbb55279af9244af4b4ce945128e70581abad843"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2058432: Disable ::-webkit-scrollbar on content.powerapps.com.  a=diannaS DONTBUILD\n\nThis domain (used by app.powerbi.com) has some JS that works with\n::-webkit-scrollbar in a way that's more sophisticated than our partial support\ncan handle (specifically, expecting arbitrary `width` / `height` values to\nwork).  This ends up giving us a worse experience (various useless scrollbars)\nwhen we have this feature enabled.  So, let's add the site to our feature\nopt-out list.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315681\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317193\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "b072f35e4c72936adce1026a49599ace90a59841", "git_parents": ["18b863adf54fb715d18466889f7b5ae4403627d7"], "node": "bd7fe98d0da708a1a13142cc8b8f16dd6c8862de", "parents": ["2af6b4a647ee5713fc37ff00ce467d65c420d7d7"], "tags": []}], "date": 1786191186, "git_changesets": ["18b863adf54fb715d18466889f7b5ae4403627d7", "b072f35e4c72936adce1026a49599ace90a59841"], "user": "dsmith@mozilla.com"}, "24": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2052196 - Raise the leakcheck threshold for /_mozilla/webdriver/ WPTs.  a=diannaS\n\nAlso revert bug 2051417 which didn't help anything.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310066\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313212\n", "files": ["testing/web-platform/mozilla/meta/webdriver/__dir__.ini"], "git_node": "33fdf5cb77bf6bd216ebb5ac243b8c7a2052f6c1", "git_parents": ["02d8482e32c1622faa7c65cde07bf8558d07bd3a"], "node": "8455c1d49918afb8f31a47427f65fa8b5af9349f", "parents": ["328e6973e011728f10c163d1d25ee47ed23b4cf1"], "tags": []}], "date": 1784753603, "git_changesets": ["33fdf5cb77bf6bd216ebb5ac243b8c7a2052f6c1"], "user": "dsmith@mozilla.com"}, "240": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2061315 - check we're in the composed doc before calling ScheduleForPresAttrEvaluation  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316883\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317019\n", "files": ["dom/svg/SVGSVGElement.cpp"], "git_node": "96727bf6986c51975c6012f2873a8701d27cf99b", "git_parents": ["b072f35e4c72936adce1026a49599ace90a59841"], "node": "0b84c45f9a6e25b05a8147bfc24828ce31a0d5df", "parents": ["bd7fe98d0da708a1a13142cc8b8f16dd6c8862de"], "tags": []}], "date": 1786191305, "git_changesets": ["96727bf6986c51975c6012f2873a8701d27cf99b"], "user": "dsmith@mozilla.com"}, "241": {"changesets": [{"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053455 - Add support for multiple arguments in jump list items.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314118\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317111\n", "files": ["browser/modules/WindowsJumpLists.sys.mjs", "dom/chrome-webidl/WindowsJumpListShortcutDescription.webidl", "widget/windows/JumpListBuilder.cpp", "widget/windows/tests/gtest/TestJumpListBuilder.cpp"], "git_node": "c1954b27c715af4d97f2f445673baad0d88c484b", "git_parents": ["96727bf6986c51975c6012f2873a8701d27cf99b"], "node": "bf1df1ab0b062f439dd1e3087119502f3fe64f5f", "parents": ["0b84c45f9a6e25b05a8147bfc24828ce31a0d5df"], "tags": []}], "date": 1786191327, "git_changesets": ["c1954b27c715af4d97f2f445673baad0d88c484b"], "user": "dsmith@mozilla.com"}, "242": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057205 - Don't repeat a non-repeating gradient because of rounding.   a=RyanVM\n\nManually rebased on top of the esr153 branch to resolve conflicts.\n\noptimize_radial_gradient shrinks a gradient's primitive rect to the bounding box\nof the interesting part of the ellipse and pushes the removed margins into\ntile_spacing. simplify_repeated_primitive then collapses that back into a single\ntile, but the tile size is stored as a ratio of the primitive rect while\ntile_spacing stays absolute, and the ratio is computed against the unsnapped rect\nand resolved against the snapped one at prepare time. The round-trip is therefore\nnot exact and could yield a stretch size a fraction of a pixel smaller than the\nprimitive rect, making prepare_repeatable_quad believe the primitive repeats.\n\nTwo fixes:\n\n - compute_stretch_ratio now reports exactly 1.0 on an axis where the tile\n   fuzzily covers the whole primitive rect, so a non-repeating primitive can't\n   be resurrected as a repeating one with a sub-pixel stride.\n\n - The CPU repetition loop now clips each tile to the primitive rect as well as\n   to the local clip rect. The last tile of a row or column always overhangs the\n   primitive rect and used to rely on the local clip rect bounding it, which is\n   not an invariant optimize_radial_gradient preserves. Without this the spurious\n   repetition rendered a complete, unclipped duplicate of the gradient.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314908\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317050\n", "files": ["gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/wrench/reftests/gradient/radial-spurious-repeat-ref.yaml", "gfx/wr/wrench/reftests/gradient/radial-spurious-repeat.yaml", "gfx/wr/wrench/reftests/gradient/reftest.list"], "git_node": "8c0a38a0dbd2a7cda9de59a30b2f5b46bb0599ff", "git_parents": ["c1954b27c715af4d97f2f445673baad0d88c484b"], "node": "298f3e61f4ebe29eff2e8f17528fa6820b4884b1", "parents": ["bf1df1ab0b062f439dd1e3087119502f3fe64f5f"], "tags": []}], "date": 1786191349, "git_changesets": ["8c0a38a0dbd2a7cda9de59a30b2f5b46bb0599ff"], "user": "dsmith@mozilla.com"}, "243": {"changesets": [{"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057205 - fuzz fix  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317251\n", "files": ["gfx/wr/wrench/reftests/gradient/reftest.list"], "git_node": "6eac95856855d972bac7a8ccb6871ce95c9cd700", "git_parents": ["8c0a38a0dbd2a7cda9de59a30b2f5b46bb0599ff"], "node": "174f4b447599174937571663954198a83f1fbb43", "parents": ["298f3e61f4ebe29eff2e8f17528fa6820b4884b1"], "tags": []}], "date": 1786195805, "git_changesets": ["6eac95856855d972bac7a8ccb6871ce95c9cd700"], "user": "rvandermeulen@mozilla.com"}, "244": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060511 - update our webcompat intervention for all Nintendo domains;  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317178\n", "files": ["browser/extensions/webcompat/injections/js/predefine_OnetrustActiveGroups.js", "browser/extensions/webcompat/manifest.json"], "git_node": "b84ea805580a25bffbcbbb651bdc2aec0eb3be0f", "git_parents": ["6eac95856855d972bac7a8ccb6871ce95c9cd700"], "node": "c43f59f21f3bd37fe4c8c4ae35eaeef81ee2db3c", "parents": ["174f4b447599174937571663954198a83f1fbb43"], "tags": []}], "date": 1786198489, "git_changesets": ["b84ea805580a25bffbcbbb651bdc2aec0eb3be0f"], "user": "rvandermeulen@mozilla.com"}, "245": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2059164 - Reject invalid AudioSegment resample sizes  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315520\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317208\n", "files": ["dom/media/AudioSegment.cpp", "dom/media/AudioSegment.h", "dom/media/MediaTrackGraph.cpp", "dom/media/mediasink/AudioDecoderInputTrack.cpp"], "git_node": "5790888ff3bb2eab8bbc33185cc77afcba2d7ae4", "git_parents": ["b84ea805580a25bffbcbbb651bdc2aec0eb3be0f"], "node": "bb8cc494a65ba7a0d0af4166594899dc2906b9e7", "parents": ["c43f59f21f3bd37fe4c8c4ae35eaeef81ee2db3c"], "tags": []}], "date": 1786198509, "git_changesets": ["5790888ff3bb2eab8bbc33185cc77afcba2d7ae4"], "user": "rvandermeulen@mozilla.com"}, "246": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058048 -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315100\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/cbs_decoder_sync.patch", "media/ffvpx/libavcodec/cbs_av1_syntax_template.c"], "git_node": "f9ae71afe40451ac34d766b46cb36f204fcae4b8", "git_parents": ["5790888ff3bb2eab8bbc33185cc77afcba2d7ae4"], "node": "7ff992133acc9d5585e0b40baafdc5d7a04b3f22", "parents": ["bb8cc494a65ba7a0d0af4166594899dc2906b9e7"], "tags": []}], "date": 1786205405, "git_changesets": ["f9ae71afe40451ac34d766b46cb36f204fcae4b8"], "user": "rvandermeulen@mozilla.com"}, "247": {"changesets": [{"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2058615 - Part 1: Call state-\u003ereject handler in case of over-recursion.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316025\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317236\n", "files": ["js/loader/ModuleLoaderBase.cpp", "js/src/vm/Modules.cpp"], "git_node": "c19b7e89270787889495688244ec6ee8e79288a1", "git_parents": ["f9ae71afe40451ac34d766b46cb36f204fcae4b8"], "node": "288ce844114633dd248da71501c2e83650d6c8aa", "parents": ["7ff992133acc9d5585e0b40baafdc5d7a04b3f22"], "tags": []}], "date": 1786205433, "git_changesets": ["c19b7e89270787889495688244ec6ee8e79288a1"], "user": "rvandermeulen@mozilla.com"}, "248": {"changesets": [{"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040673 - crashhelper: gracefully exit on missed Android rendezvous a=pascalc\n\nIf for some reason a bound process never makes it to the rendezvous,\nit's preferable to simply log and move on, as we want to keep using this\nspecific helper instance for *other* processes, since the service cannot\nbe restarted properly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309024\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315364\n", "files": ["toolkit/crashreporter/crash_helper_server/src/lib.rs"], "git_node": "31b06413d3b56d2281505ed9039a933d1a6a53aa", "git_parents": ["c19b7e89270787889495688244ec6ee8e79288a1"], "node": "bde5f83181fbf3152a21df5961182d330dd04227", "parents": ["288ce844114633dd248da71501c2e83650d6c8aa"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046494 - Fetch additional results from Merino for Online Suggest. a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308597\n\nRe-uplift of 08b0b921e2dc, which was backed out in aba1603bd141 for mochitest\nfailures. RESULT_SOURCE moved from UrlbarUtils to UrlbarShared on main after 153\nbranched, so browser_pickedSearchSuggestion.js used a symbol that does not exist\non the release branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314401\n", "files": ["browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/private/SuggestBackendMerino.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser_pickedSearchSuggestion.js", "browser/components/urlbar/tests/quicksuggest/unit/test_pickedSearchSuggestion.js", "browser/components/urlbar/tests/quicksuggest/unit/xpcshell.toml"], "git_node": "a88c2e3da87c036f6fe6e2760dee2cf66072dff3", "git_parents": ["31b06413d3b56d2281505ed9039a933d1a6a53aa"], "node": "f6c201259766c47f4924b610c9e97ed812c89f1e", "parents": ["bde5f83181fbf3152a21df5961182d330dd04227"], "tags": []}], "date": 1786227701, "git_changesets": ["31b06413d3b56d2281505ed9039a933d1a6a53aa", "a88c2e3da87c036f6fe6e2760dee2cf66072dff3"], "user": "rvandermeulen@mozilla.com"}, "249": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054662 - Add ownership check when registering a WebSocket event listener  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312269\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317278\n", "files": ["netwerk/ipc/NeckoParent.cpp", "netwerk/ipc/NeckoParent.h"], "git_node": "bf2a16f594ed4b0d0b6a28798f1d174b57eb227e", "git_parents": ["a88c2e3da87c036f6fe6e2760dee2cf66072dff3"], "node": "2c587aa8a698647a9b667724e0bcb7d49f8a3d32", "parents": ["f6c201259766c47f4924b610c9e97ed812c89f1e"], "tags": []}], "date": 1786240604, "git_changesets": ["bf2a16f594ed4b0d0b6a28798f1d174b57eb227e"], "user": "dsmith@mozilla.com"}, "25": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1788109: Clean up cookie authorization  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288314\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313710\n", "files": ["dom/ipc/WindowGlobalParent.cpp", "netwerk/cookie/CookieServiceParent.cpp", "netwerk/cookie/CookieServiceParent.h"], "git_node": "fc73c5b7afec72181f069deeeded66f7f7c21031", "git_parents": ["33fdf5cb77bf6bd216ebb5ac243b8c7a2052f6c1"], "node": "053d5032f0d86b7a39010e368828260b965a3a37", "parents": ["8455c1d49918afb8f31a47427f65fa8b5af9349f"], "tags": []}], "date": 1784830410, "git_changese