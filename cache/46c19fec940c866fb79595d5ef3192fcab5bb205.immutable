m"}, "57": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054487 - Use a NullPrincipal to inherit for view-source.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312051\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314304\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "2dd7c45d12cefae7f780a8c7bb9c4b09958fc759", "git_parents": ["5dbe1d87646a71d97435e5a07f39eed62c123bf4"], "node": "5e008b1f94036695db3cff27e2c6e7c4c6bff27a", "parents": ["d82f488851e4d67bfea8a858332a9bf7e6097063"], "tags": []}], "date": 1785177899, "git_changesets": ["2dd7c45d12cefae7f780a8c7bb9c4b09958fc759"], "user": "dsmith@mozilla.com"}, "58": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018164 - Verify more Client IPC.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310602\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314312\n", "files": ["dom/clients/manager/ClientHandleOpParent.cpp", "dom/clients/manager/ClientHandleOpParent.h", "dom/clients/manager/ClientHandleParent.cpp", "dom/clients/manager/ClientHandleParent.h", "dom/clients/manager/ClientManagerOpParent.cpp", "dom/clients/manager/ClientManagerOpParent.h", "dom/clients/manager/ClientManagerParent.cpp", "dom/clients/manager/ClientValidation.cpp", "dom/clients/manager/ClientValidation.h"], "git_node": "55b1c51c4fb1340110bb34a3f0f70ac3f3219d3b", "git_parents": ["2dd7c45d12cefae7f780a8c7bb9c4b09958fc759"], "node": "80e84573dbe70902b04e20b5d4d06032ae537a96", "parents": ["5e008b1f94036695db3cff27e2c6e7c4c6bff27a"], "tags": []}], "date": 1785177919, "git_changesets": ["55b1c51c4fb1340110bb34a3f0f70ac3f3219d3b"], "user": "dsmith@mozilla.com"}, "59": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053962 - Dispatch async backup pref writes as standalone writes instead of sharing the sPendingWriteData slot.  a=diannaS\n\nBackupPrefFile writes go through PreferencesImpl::WritePrefFile, which coalesces\nall writes through a single sPendingWriteData slot destined for the profile\nprefs.js. A backup targets a different file with a filtered pref set and carries\na MozPromise. When the slot was already occupied, the backup took the coalescing\nearly-return, dropping its MozPromiseHolder without settling it and leaving its\nfiltered data in the slot. Give writes that carry a promise holder their own\nPWRunnable with their own data so they never touch the shared slot.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311551\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314380\n", "files": ["modules/libpref/Preferences.cpp", "modules/libpref/Preferences.h", "modules/libpref/test/unit/test_backupPrefFile.js"], "git_node": "e17eb623290159d44641a27d15aaa6c6ce7e4480", "git_parents": ["55b1c51c4fb1340110bb34a3f0f70ac3f3219d3b"], "node": "1894f254236d533416fe4cf4aa3327da867fed04", "parents": ["80e84573dbe70902b04e20b5d4d06032ae537a96"], "tags": []}], "date": 1785177938, "git_changesets": ["e17eb623290159d44641a27d15aaa6c6ce7e4480"], "user": "dsmith@mozilla.com"}, "60": {"changesets": [{"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2018164 - Verify more Client IPC. a=diannaS DONTBUILD\" for cousing devtools failures @ BackgroundParentImpl.cpp DONTBUILD\n\nThis reverts commit 55b1c51c4fb1340110bb34a3f0f70ac3f3219d3b.\n", "files": ["dom/clients/manager/ClientHandleOpParent.cpp", "dom/clients/manager/ClientHandleOpParent.h", "dom/clients/manager/ClientHandleParent.cpp", "dom/clients/manager/ClientHandleParent.h", "dom/clients/manager/ClientManagerOpParent.cpp", "dom/clients/manager/ClientManagerOpParent.h", "dom/clients/manager/ClientManagerParent.cpp", "dom/clients/manager/ClientValidation.cpp", "dom/clients/manager/ClientValidation.h"], "git_node": "4aa354f57312282b41fca3263f513b16547d59e3", "git_parents": ["e17eb623290159d44641a27d15aaa6c6ce7e4480"], "node": "b17b8c73c359e62fa4b516e44eb01b6001b550e8", "parents": ["1894f254236d533416fe4cf4aa3327da867fed04"], "tags": []}], "date": 1785186306, "git_changesets": ["4aa354f57312282b41fca3263f513b16547d59e3"], "user": "pstanciu@mozilla.com"}, "61": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1698087 - Move the devtools fallback page from a chrome: to a resource: URL.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309773\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314321\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "devtools/server/actors/descriptors/webextension.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/shared/jar.mn"], "git_node": "8e3de234aae52dc39a4fa25ecb1583ef31686895", "git_parents": ["4aa354f57312282b41fca3263f513b16547d59e3"], "node": "00cb73d689fa1dbff233258945c6fbae36123682", "parents": ["b17b8c73c359e62fa4b516e44eb01b6001b550e8"], "tags": []}], "date": 1785186848, "git_changesets": ["8e3de234aae52dc39a4fa25ecb1583ef31686895"], "user": "dsmith@mozilla.com"}, "62": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055127: Always verify that the cell still exists.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312225\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314545\n", "files": ["accessible/base/CachedTableAccessible.cpp"], "git_node": "b2a9ea9e11bc0dc2590a7ff1c3a8f2aeefb05a68", "git_parents": ["8e3de234aae52dc39a4fa25ecb1583ef31686895"], "node": "19bbf8f1890c4034458294dca8b3023b0ad0af21", "parents": ["00cb73d689fa1dbff233258945c6fbae36123682"], "tags": []}], "date": 1785204853, "git_changesets": ["b2a9ea9e11bc0dc2590a7ff1c3a8f2aeefb05a6