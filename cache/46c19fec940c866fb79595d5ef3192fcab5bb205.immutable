5c87d4c", "parents": ["fef16320cc256a3c70cf6aee4f047a4ff0d62a6c"], "tags": []}], "date": 1785517119, "git_changesets": ["74243daf974fcd73c7754b37bd97e797cf89dd23", "5a3efdfe974dad11143d2f6bc841dcf480279632"], "user": "rvandermeulen@mozilla.com"}, "114": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2058049 - Backport upstream cubeb WASAPI device-invalidated-on-start fix.  a=RyanVM DONTBUILD\n\nUpstream cubeb commit ef47ae581df7c2f76058d554b3edde17f9ee7cba (\"wasapi:\nTrigger reconfig on render thread if device invalidated\"), landed on trunk as\npart of the libcubeb update in bug 2057682, carried here as a local patch\nrather than bumping the vendored libcubeb revision.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314159\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315110\n", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_wasapi.cpp", "media/libcubeb/wasapi-async-reconfigure-on-start.patch"], "git_node": "85f593956a12f09d1ee33308d3f000c1f4c16243", "git_parents": ["5a3efdfe974dad11143d2f6bc841dcf480279632"], "node": "64703b3efb5ae410eba995484b4049e7580d93f1", "parents": ["c7d3b6a7144cd47587bc7b096e4f97c855c87d4c"], "tags": []}], "date": 1785517143, "git_changesets": ["85f593956a12f09d1ee33308d3f000c1f4c16243"], "user": "rvandermeulen@mozilla.com"}, "115": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053582 - Mask invalid values in SetCanBreakBefore.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314763\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314941\n", "files": ["gfx/thebes/gfxFont.h"], "git_node": "090b83d4272e71222f6aba6fb5ee13a8732a4630", "git_parents": ["85f593956a12f09d1ee33308d3f000c1f4c16243"], "node": "82e0ca82e8659d57594e82ced4792bf3559d0245", "parents": ["64703b3efb5ae410eba995484b4049e7580d93f1"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053582 - Pass glyph count in to GetDetailedGlyphs.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314764\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314942\n", "files": ["gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/generic/nsTextFrame.cpp", "layout/generic/nsTextRunTransformations.cpp", "layout/mathml/nsMathMLChar.cpp", "layout/painting/nsCSSRendering.cpp"], "git_node": "4a771f8bef497e26bb4534c35180c64b3c5cb112", "git_parents": ["090b83d4272e71222f6aba6fb5ee13a8732a4630"], "node": "bf4b551950ab1389fee2366030bdf506fb597f7f", "parents": ["82e0ca82e8659d57594e82ced4792bf3559d0245"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053582 - Strengthen offset validation in gfxGraphiteShaper.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314765\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314943\n", "files": ["gfx/thebes/gfxGraphiteShaper.cpp"], "git_node": "57a6a15b7bfccf890a9ad995acc76d24be853a0c", "git_parents": ["4a771f8bef497e26bb4534c35180c64b3c5cb112"], "node": "282b887610578457a2d4c39f42d1426218d32a96", "parents": ["bf4b551950ab1389fee2366030bdf506fb597f7f"], "tags": []}], "date": 1785517170, "git_changesets": ["090b83d4272e71222f6aba6fb5ee13a8732a4630", "4a771f8bef497e26bb4534c35180c64b3c5cb112", "57a6a15b7bfccf890a9ad995acc76d24be853a0c"], "user": "rvandermeulen@mozilla.com"}, "116": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042101 - [devtools] Avoid inspector crashes if getListenerInfoFor returns dead wrappers  a=RyanVM DONTBUILD\n\nFixes the issue locally for me when Stylus is installed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308247\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315457\n", "files": ["devtools/server/actors/inspector/event-collector.js", "devtools/server/actors/inspector/node.js"], "git_node": "bd244521cd583ff61cbf6eefad103736ab6cf1f6", "git_parents": ["57a6a15b7bfccf890a9ad995acc76d24be853a0c"], "node": "0f75e83d38a45e8a7a778881a5c5ceddd45d0fd9", "parents": ["282b887610578457a2d4c39f42d1426218d32a96"], "tags": []}], "date": 1785527088, "git_changesets": ["bd244521cd583ff61cbf6eefad103736ab6cf1f6"], "user": "rvandermeulen@mozilla.com"}, "117": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044429 - Add PolicySchemaValidator helper for enterprise policies  a=RyanVM DONTBUILD\n\nPolicySchemaValidator wraps the compliant validator in JsonSchema.sys.mjs\nand turns raw policy input into validated, ready-to-use data in three\nstages: normalize source quirks into standard JSON (0/1 to boolean, and\nJSON-string to object for fields marked contentMediaType application/json),\nvalidate against standard JSON Schema, then hydrate format:uri strings into\nURL objects. Each list entry is validated on its own, so an invalid entry\nis dropped and logged rather than discarding the whole list. No consumers\nyet.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304186\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315709\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_PolicySchemaValidator.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "toolkit/components/enterprisepolicies/PolicySchemaValidator.sys.mjs", "toolkit/components/enterprisepolicies/moz.build"], "git_node": "fa98efb19a91e6a7187bbf0720befc48525ca3eb", "git_parents": ["bd244521cd583ff61cbf6eefad103736ab6cf1f6"], "node": "8b114b64bb15fb1b7a154c035146e83d5e28a8f9", "parents": ["0f75e83d38a45e8a7a778881a5c5ceddd45d0fd9"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044429 - Migrate enterprise policy validation to the compliant JSON Schema validator  a=RyanVM DONTBUILD\n\nRewrites the custom schema types (URL, URLorEmpty, origin, JSON) in\npolicies-schema.json to standard JSON Schema and switches\nEnterprisePoliciesParent to PolicySchemaValidator. Validity now lives\nentirely in the schema (format:uri, pattern, anyOf), so the same file can\nbe validated by off-the-shelf tooling; contentMediaType marks the fields\nthat may arrive as a JSON string. Shared types (url, urlOrEmpty, origin)\nare defined once under \"definitions\" and referenced with $ref, resolved\nwhen the schema is loaded for the per-policy validator. The $schema is\nbumped to draft-07 to match the keywords used.\n\nBehavior is preserved: boolean fields that are also numeric keep their 0/1\ninteger value; DisplayBookmarksToolbar and DisplayMenuBar accept a boolean\nor an enumerated string (via anyOf); SecurityDevices and ExtensionSettings\nexclude their literal special keys from the catch-all patternProperties so\nthose keys are not validated against two schemas at once; and an invalid\nentry in a list is dropped rather than discarding the whole policy. Also\nfixes a misplaced \"required\" in AutoLaunchProtocolsFromOrigins.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304187\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315710\n", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/schemas/schema.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_extensionsettings.js", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs"], "git_node": "a11435e79234fe0699d165068d31a8db3386caf0", "git_parents": ["fa98efb19a91e6a7187bbf0720befc48525ca3eb"], "node": "d401b1ba6bb732e918864bf686d4436c01eb3d77", "parents": ["8b114b64bb15fb1b7a154c035146e83d5e28a8f9"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044429 - Hide verbose schema keywords from about:policies documentation  a=RyanVM DONTBUILD\n\nabout:policies prints the policy schema to administrators. The schema is\nstandard JSON Schema, but a few constructs (format and pattern for URLs and\norigins, contentMediaType for JSON-string fields) are verbose, so the\ndocumentation view rewrites them into the shorter presentation used\nhistorically (URL, origin, JSON). This is a display-only transform.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304188\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315711\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.js"], "git_node": "dbb31b3a8c83e40b4b8a382c29168e022d11a0dc", "git_parents": ["a11435e79234fe0699d165068d31a8db3386caf0"], "node": "e4726b2b2b22754793ccca9746e3ee1079956220", "parents": ["d401b1ba6bb732e918864bf686d4436c01eb3d77"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044429 - Add macOS value-shape validation test for enterprise policies  a=RyanVM DONTBUILD\n\nmacOS delivers booleans as 0/1 integers (NSNumber) and nests via\nunflattened keys; no existing policy-engine test exercises those value\nshapes against the validator. This validates representative macOS-shaped\nvalues (integer booleans, nested objects, origin arrays) against the real\nschema, guarding the coercion the macOS path depends on. It is\nplatform-independent (the macOS-only parser/reader are covered by\ntest_macosparser_unflatten.js and by manual config-profile testing).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304189\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315712\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_macos_policy_validation.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "c9234123b932e8d68971e1c53ee8a9953ef0c3a2", "git_parents": ["dbb31b3a8c83e40b4b8a382c29168e022d11a0dc"], "node": "89d4c6376d217e48265e34fb8aabe9edde8dd149", "parents": ["e4726b2b2b22754793ccca9746e3ee1079956220"], "tags": []}], "date": 1785527187, "git_changesets": ["fa98efb19a91e6a7187bbf0720befc48525ca3eb", "a11435e79234fe0699d165068d31a8db3386caf0", "dbb31b3a8c83e40b4b8a382c29168e022d11a0dc", "c9234123b932e8d68971e1c53ee8a9953ef0c3a2"], "user": "rvandermeulen@mozilla.com"}, "118": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050059 - Remove picture-in-picture play/pause wrapper functions for Udemy.  a=RyanVM DONTBUILD\n\nThese were originally added for bug 1835638, but I suspect Udemy has changed how\ntheir site functions. Having removed the play/pause wrapper functions, I cannot\nreproduce bug 1835638, and the videos properly play and pause now from the PiP\nplayer window.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310635\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315674\n", "files": ["browser/extensions/pictureinpicture/video-wrappers/udemy.js"], "git_node": "67d32f919d293cfb3a2804ee7193b3c9b4a06dea", "git_parents": ["c9234123b932e8d68971e1c53ee8a9953ef0c3a2"], "node": "1fb8b3cc1c8dfa6ad06ffc884565bafe8b2f22ed", "parents": ["89d4c6376d217e48265e34fb8aabe9edde8dd149"], "tags": []}], "date": 1785527211, "git_changesets": ["67d32f919d293cfb3a2804ee7193b3c9b4a06dea"], "user": "rvandermeulen@mozilla.com"}, "119": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056865: Skip zone writer for dragged http/https URLs on Windows  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314233\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315695\n", "files": ["widget/windows/nsDataObj.cpp", "widget/windows/nsDataObj.h"], "git_node": "fa89756b7bcf24e9167561ceb8fc339f9fc75a6a", "git_parents": ["67d32f919d293cfb3a2804ee7193b3c9b4a06dea"], "node": "bbd6af60de4545f6750d588fc3e73ac0280692b3", "parents": ["1fb8b3cc1c8dfa6ad06ffc884565bafe8b2f22ed"], "tags": []}], "date": 1785527321, "git_changesets": ["fa89756b7bcf24e9167561ceb8fc339f9fc75a6a"], "user": "rvandermeulen@mozilla.com"}, "12": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 654474d69a6e3caa9d43660a49012f6f0858f732 with FIREFOX_BETA_153_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "15ddbaef966012ae04dc86960a713356b96522d4", "git_parents": ["6c006d7d4b68ca6e578dd9ee1107b809f2b6ca14"], "node": "4aec1330ca3740ac9c3bbb8e7b5ea3b75a25cf35", "parents": ["c5d3e841a75186275937efd8762725008e39c158"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4c1ce8f04007e1ebcc15ee64c68b6461c41413f9 with FIREFOX_BETA_154_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "17afadb7dae34924aef9e970a260b4e7e42ae132", "git_parents": ["15ddbaef966012ae04dc86960a713356b96522d4"], "node": "a55bc5479d7c1ec3f0af8dade8c11e374c0f9f33", "parents": ["4aec1330ca3740ac9c3bbb8e7b5ea3b75a25cf35"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4c1ce8f04007e1ebcc15ee64c68b6461c41413f9 with FIREFOX_NIGHTLY_154_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "fb16a746b2ba40f60258102d693b63cc04bb36b8", "git_parents": ["17afadb7dae34924aef9e970a260b4e7e42ae132"], "node": "0a86d23c2f36efd812c344d07a6796b4714fb17a", "parents": ["a55bc5479d7c1ec3f0af8dade8c11e374c0f9f33"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5ca49396cb455033afb922ef40cb68d13e469c9d with FIREFOX_154_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "330d9027ffe93b05