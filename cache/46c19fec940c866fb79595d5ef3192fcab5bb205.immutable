node": "9dca84a83a1f434412edc3c66040d95a4d319fa1", "parents": ["9864f9ae4ac1a43d6043eee0f725590f2311cb18"], "tags": []}], "date": 1784989835, "git_changesets": ["828bce9327e7672c3f9f25483125e32fb4d4ef40"], "user": "dmeehan@mozilla.com"}, "49": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045711.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311733\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312888\n", "files": ["gfx/cairo/cairo/src/cairo-truetype-subset.c", "gfx/cairo/patches/0043-Bug-2045711-records-size-check.patch"], "git_node": "4e45399f6c6ce50745591408d8dc3de03a1b73fd", "git_parents": ["828bce9327e7672c3f9f25483125e32fb4d4ef40"], "node": "ab0a1b7e2fbce6dd6474bc2a85994e7348574a87", "parents": ["9dca84a83a1f434412edc3c66040d95a4d319fa1"], "tags": []}], "date": 1784990062, "git_changesets": ["4e45399f6c6ce50745591408d8dc3de03a1b73fd"], "user": "dmeehan@mozilla.com"}, "50": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2056086 - Upgrade json5 and add test  a=diannaS\n\nUpgrade json5 v2.2.1 to v2.2.3, from UMD to ESM, mainly to get rid of\nunnecessary polyfills.\n\nAnd add a unit test that confirms that the library is indeed doing\nanything meaningful. `JSON5.parse` is called from utils.js, but\nreplacing it with `JSON.parse` did not cause test failures at first.\nThat is because no tests were added in bug 1260382, which introduced\nthe original version of the logic.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312910\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314058\n", "files": ["devtools/client/storage/test/browser_storage_values.js", "devtools/client/storage/test/storage-complex-values.html", "devtools/shared/storage/utils.js", "devtools/shared/storage/vendor/JSON5_UPGRADING.md", "devtools/shared/storage/vendor/json5.js", "devtools/shared/storage/vendor/json5.mjs", "devtools/shared/storage/vendor/moz.build"], "git_node": "256c6d43d61fb43690fcb8a97a2326bcf5ac16f4", "git_parents": ["4e45399f6c6ce50745591408d8dc3de03a1b73fd"], "node": "edd1e4738925c7b6762c0e95610e235e8600fdef", "parents": ["ab0a1b7e2fbce6dd6474bc2a85994e7348574a87"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2056076 - Drop freezeBuiltins from devtools loader  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312911\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314059\n", "files": ["devtools/shared/loader/base-loader.sys.mjs"], "git_node": "a904c60d62346718b8e01994926dab6790f37bb2", "git_parents": ["256c6d43d61fb43690fcb8a97a2326bcf5ac16f4"], "node": "d323ecff3a0ee7067ce7693dac75b3587efd101d", "parents": ["edd1e4738925c7b6762c0e95610e235e8600fdef"], "tags": []}], "date": 1785027391, "git_changesets": ["256c6d43d61fb43690fcb8a97a2326bcf5ac16f4", "a904c60d62346718b8e01994926dab6790f37bb2"], "user": "dsmith@mozilla.com"}, "51": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053599.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312932\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314199\n", "files": ["gfx/cairo/cairo/src/cairo-truetype-subset.c", "gfx/cairo/patches/0044-Bug-2053599-glyph-index-bounds.patch"], "git_node": "d28feabdbca88c29ac120274d34d13ac96153c99", "git_parents": ["a904c60d62346718b8e01994926dab6790f37bb2"], "node": "a34a6be1e1b8c09fa3ce9b694f3dd91c00097b63", "parents": ["d323ecff3a0ee7067ce7693dac75b3587efd101d"], "tags": []}], "date": 1785068369, "git_changesets": ["d28feabdbca88c29ac120274d34d13ac96153c99"], "user": "dsmith@mozilla.com"}, "52": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056501: Allow detecting newer riscv64 extensions on older kernels.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313476\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313941\n", "files": ["js/src/jit/riscv64/Architecture-riscv64.cpp"], "git_node": "cf474973e78f6badf380f300b6b34e4f48c08362", "git_parents": ["d28feabdbca88c29ac120274d34d13ac96153c99"], "node": "bcdaa3a4abfab6b54fd1ec55201063492ae699a0", "parents": ["a34a6be1e1b8c09fa3ce9b694f3dd91c00097b63"], "tags": []}], "date": 1785069858, "git_changesets": ["cf474973e78f6badf380f300b6b34e4f48c08362"], "user": "dsmith@mozilla.com"}, "53": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055260 - Add new memory tracking embedder APIs  a=diannaS\n\nAdd GetGCHeapSizeForZone, GetMallocHeapSizeForZone, and\nGetJITHeapSizeForZone to the embedder API. Each of these methods\nreturns one of the sizes that is currently added together and\nreturned by GetMemoryUsageForZone.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312817\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314106\n", "files": ["js/src/jsfriendapi.cpp", "js/src/jsfriendapi.h"], "git_node": "c6206d6f140745a06f09efd0feb104b47bc49ee2", "git_parents": ["cf474973e78f6badf380f300b6b34e4f48c08362"], "node": "b8eb5a93575774d5c0571ea71e6b7c4770377077", "parents": ["bcdaa3a4abfab6b54fd1ec55201063492ae699a0"], "tags": []}], "date": 1785069889, "git_changesets": ["c6206d6f140745a06f09efd0feb104b47bc49ee2"], "user": "dsmith@mozilla.com"}, "54": {"changesets": [{"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977202 - Pre 1: Expose DOM Promise reject with nsresult API for Rust and extend Rust Promise to allow resolving with undefined or rejecting with nsresult.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302650\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314133\n", "files": ["dom/promise/Promise.cpp", "dom/promise/Promise.h", "xpcom/rust/xpcom/src/promise.rs"], "git_node": "d7d7c18a4b9a7da9a0b5d1bfb684023be3028ffc", "git_parents": ["c6206d6f140745a06f09efd0feb104b47bc49ee2"], "node": "790d19b8f4b1db9ad3c23f348b816b27301d861b", "parents": ["b8eb5a93575774d5c0571ea71e6b7c4770377077"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977202 - Pre 2: Add async wrapper for nsITimer.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302651\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314134\n", "files": ["Cargo.lock", "browser/components/shell/rust/shell_windows/Cargo.toml", "browser/components/shell/rust/shell_windows/src/lib.rs", "browser/components/shell/rust/shell_windows/src/util/async_timer.rs", "browser/components/shell/rust/shell_windows/src/util/mod.rs", "build/workspace-hack/Cargo.toml"], "git_node": "30e066ee0cfd8631dbe31da8960e5b76b78e10d2", "git_parents": ["d7d7c18a4b9a7da9a0b5d1bfb684023be3028ffc"], "node": "5cb3fb3e6b5b4a412d284e3d6c61c0fe1ccfd9d8", "parents": ["790d19b8f4b1db9ad3c23f348b816b27301d861b"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977202 - Pre 3: Generalize Glean's use of xpc::IsInAutomation into the xpcom crate.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308177\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314135\n", "files": ["js/xpconnect/src/XPCComponents.cpp", "toolkit/components/glean/api/src/ipc.rs", "toolkit/components/glean/xpcom/FOG.cpp", "xpcom/rust/xpcom/src/lib.rs", "xpcom/rust/xpcom/src/xpc.rs"], "git_node": "5a712c04d8410812bb8c06f2c889e5b4bb5ccc7e", "git_parents": ["30e066ee0cfd8631dbe31da8960e5b76b78e10d2"], "node": "91848528a96b3843f23c2e827f9f965215eca13a", "parents": ["5cb3fb3e6b5b4a412d284e3d6c61c0fe1ccfd9d8"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977202 - Migrate Windows pinning to async Rust API.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302652\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314136\n", "files": ["Cargo.lock", "browser/components/shell/Windows11TaskbarPinning.cpp", "browser/components/shell/Windows11TaskbarPinning.h", "browser/components/shell/moz.build", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/rust/shell_windows/Cargo.toml", "browser/components/shell/rust/shell_windows/src/WindowsShellServiceRust.h", "browser/components/shell/rust/shell_windows/src/lib.rs", "browser/components/shell/rust/shell_windows/src/taskbar/com.rs", "browser/components/shell/rust/shell_windows/src/taskbar/mod.rs", "browser/components/shell/rust/shell_windows/src/taskbar/winrt.rs", "browser/components/shell/rust/shell_windows/src/util/mod.rs", "browser/components/shell/rust/shell_windows/src/util/thread.rs", "browser/components/shell/test/browser_createWindowsShortcut.js", "browser/components/shell/test/browser_processAUMID.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f5d8dffab9a916a20beb500309f03ef4f6d4ad12", "git_parents": ["5a712c04d8410812bb8c06f2c889e5b4bb5ccc7e"], "node": "b9c81dcf85e2714f4605418b6481df4bc6b1d62d", "parents": ["91848528a96b3843f23c2e827f9f965215eca13a"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977202 - Post: Autoformat, dos2unix, and comment cleanup.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302653\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314137\n", "files": ["browser/components/shell/rust/shell_windows/src/limited_access_features.rs", "browser/components/shell/rust/shell_windows/src/secondary_tiles.rs", "browser/components/shell/test/gtest/moz.build"], "git_node": "d612f3811a105af12ff337f1455c4259d8f70913", "git_parents": ["f5d8dffab9a916a20beb500309f03ef4f6d4ad12"], "node": "157b123eadd154d1d103c9558181ae0dae2320f8", "parents": ["b9c81dcf85e2714f4605418b6481df4bc6b1d62d"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034609 - Remove remaining unnecessary STA initialization from nsWindowsShellService.  a=diannaS\n\nSTA initialization was initially introduced to nsWindowsShellService when pin checks were moved to a background thread in D106346, and only for `IsCurrentAppPinnedToTaskbarAsync`.  Notably neither `PinCurrentAppToTaskbar` nor `CheckPinCurrentAppToTaskbar` enforce either main thread or STA, though the Taskband Pin COM API can only be created on an STA thread.\n\nNo Windows API called by `IsCurrentAppPinnedToTaskbarAsync` are documented or observed to rely on STA, notably `ShellLink` has `ThreadingModel=Both` in `HKCR\\CLSID\\{00021401-0000-0000-C000-000000000046}\\InProcServer32`. `00021401-0000-0000-C000-000000000046` is UUID associated to `CLSID_ShellLink`.\n\nNeither `ShellExecute` nor shell dialog opening functions are used herein. These are the two common sources of shell functions erring from `E_NOINTERFACE` on MTA threads as documented in \"Calling shell functions and interfaces from a multithreaded apartment\" at https://learn.microsoft.com/en-us/previous-versions/troubleshoot/windows/win32/shell-functions-multithreaded-apartment.\n\nThis initial use of STA predates implicit MTA on background threads introduced in Bug 1707954 by a few months.\n\nGiven the above context it is likely that the original intent was only to ensure COM was initialized for the background thread. It is unlikely STA was an intentional choice, and instead the result of choosing the smaller API between `CoInitialize` and `CoInitializeEx`.\n\nRemaining STA initialization seems to have copy/pasted this original example without further consideration.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296211\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314138\n", "files": ["browser/components/shell/nsWindowsShellService.cpp", "tools/lint/mscom-init.yml"], "git_node": "5f8b37e967de60c57e3afae571f31a753f77e1a6", "git_parents": ["d612f3811a105af12ff337f1455c4259d8f70913"], "node": "3d936228fc17dca0935dff7e45d306488e11404c", "parents": ["157b123eadd154d1d103c9558181ae0dae2320f8"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048824 - Reduce scope of taskbar pin check to verifying whether the necessary APIs are available, removing the \"check only\" flag.  a=diannaS\n\nThe check only flag was introduced during the first iteration of taskbar pinning in D104779. The purpose was to do a dry run to validate pinning was possible. This meant verifying the Windows version was supported, verifying the necessary shortcuts existed, and verifying the COM API existed.\n\nThe check only flag's original purpose is unclear, possibly only for testing, and was unused in the original revision stack.\n\nSince then the API was used to verify we can pin to the taskbar. Over time we also made attempts to pin create the necessary shortcuts in order to succeed. The pattern of adding a check only flag was then propagated to other interfaces unnecessarily.\n\nThe sole use today is verifying we can pin. We don't need to do a full dry run to validate this, we can just check that the necessary APIs are available. This allows us to remove the check only special case peppered throughout pinning code, and allows us to verify without consideration for the current AUMID which is unnecessary to validate API availability.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307737\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314139\n", "files": ["browser/components/shell/ShellService.sys.mjs", "browser/components/shell/nsIWindowsShellService.idl", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/rust/shell_windows/src/WindowsShellServiceRust.h", "browser/components/shell/rust/shell_windows/src/taskbar/com.rs", "browser/components/shell/rust/shell_windows/src/taskbar/mod.rs", "browser/components/shell/rust/shell_windows/src/taskbar/winrt.rs", "browser/components/tests/browser/head.js", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_pin_firefox.js", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_pin_private_firefox.js"], "git_node": "50f4793f4c755a0b9aa94d9a7ffd84e5768a320e", "git_parents": ["5f8b37e967de60c57e3afae571f31a753f77e1a6"], "node": "aa08790ffeaba797def569026282ae419cc6862c", "parents": ["3d936228fc17dca0935dff7e45d306488e11404c"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048824 - Post: Remove unused `aCheckOnly` parameter on `pinCurrentAppToStartMenuAsync`.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307738\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314140\n", "files": ["browser/components/shell/ShellService.sys.mjs", "browser/components/shell/nsIWindowsShellService.idl", "browser/components/shell/nsWindowsShellService.cpp"], "git_node": "f0f3cfcbf2450a74d08da3e87ab1212ea3855c6e", "git_parents": ["50f4793f4c755a0b9aa94d9a7ffd84e5768a320e"], "node": "fbc88aa519b2e71879b03df4ad3a6735af6559be", "parents": ["aa08790ffeaba797def569026282ae419cc6862c"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048854 - Clean up redundant `...Async` naming and comments in and around `nsIWindowsShellService`.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307739\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314141\n", "files": ["browser/components/StartupTelemetry.sys.mjs", "browser/comp