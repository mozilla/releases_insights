f5e12c7317", "parents": ["a53e5653ac3da30da2fb67440a9af0ba966ef4be"], "tags": []}], "date": 1785954905, "git_changesets": ["3ba836e36abf8a1d26236ae92eb32097918a0a3f", "f17e0e4c47b125d14a09c5ef9590ff363b5994ac"], "user": "dsmith@mozilla.com"}, "191": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2044518 - Simplify registerTraceableChannel  a=diannaS DONTBUILD\n\n- Make registerTraceableChannel calls synchronous.\n- Drop remoteTab parameter from registerTraceableChannel; validate\n  process access based on remoteType checks instead.\n- In practice a null remoteTab was only supported for in-process\n  extensions, but this was not obvious nor enforced. Enforce it\n  too, and fix test that depended on null remoteTab.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D304595\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316518\n", "files": ["browser/extensions/search-detection/extension/api.js", "dom/chrome-webidl/ChannelWrapper.webidl", "toolkit/components/extensions/parent/ext-proxy.js", "toolkit/components/extensions/parent/ext-webRequest.js", "toolkit/components/extensions/test/xpcshell/test_ChannelWrapper.js", "toolkit/components/extensions/test/xpcshell/test_ext_webRequest_StreamFilter_redirect_race.js", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp", "toolkit/components/extensions/webrequest/ChannelWrapper.h", "toolkit/components/extensions/webrequest/WebRequest.sys.mjs"], "git_node": "990e53b0fabcc25763f49961f3296f77ccc0fb7b", "git_parents": ["f17e0e4c47b125d14a09c5ef9590ff363b5994ac"], "node": "04c926843d17c072411423f46dffd2ccca5f6ab3", "parents": ["308fd35a3b9b210753b24d542035fef5e12c7317"], "tags": []}], "date": 1785955663, "git_changesets": ["990e53b0fabcc25763f49961f3296f77ccc0fb7b"], "user": "dsmith@mozilla.com"}, "192": {"changesets": [{"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - fix unbalanced AddRef/Release in SocketProcessParent.  a=diannaS\n\nBecause SocketProcessParent::DeallocPWebrtcTCPSocketParent is never called,\nthe AddRef in AllocPWebrtcTCPSocketParent was never balanced with a Release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316415\n", "files": ["dom/media/webrtc/transport/ipc/WebrtcTCPSocketParent.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h"], "git_node": "2376b77640a16b678f42bdac15ad1766838d3817", "git_parents": ["990e53b0fabcc25763f49961f3296f77ccc0fb7b"], "node": "0f758eb7f8d428f3fdd226f87c8920af406b9812", "parents": ["04c926843d17c072411423f46dffd2ccca5f6ab3"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - add checkRemoteCandidatePorts to test_peerConnection_portRestrictions.html  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316416\n", "files": ["dom/media/webrtc/tests/mochitests/test_peerConnection_portRestrictions.html"], "git_node": "f3cb8fdd65509a9c208f52b0d7c979ec109612c6", "git_parents": ["2376b77640a16b678f42bdac15ad1766838d3817"], "node": "bcb2726216a8769c20b33f581243f325bebc7328", "parents": ["0f758eb7f8d428f3fdd226f87c8920af406b9812"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Fix stale comment in UDPSocketParent::RecvOutgoingData.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316417\n", "files": ["dom/network/UDPSocketParent.cpp"], "git_node": "93ed68c9a56e13f154f758603605f31017ca7082", "git_parents": ["f3cb8fdd65509a9c208f52b0d7c979ec109612c6"], "node": "491381bbe14d468d168fb6ce81d396ec511767cc", "parents": ["bcb2726216a8769c20b33f581243f325bebc7328"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Expose the webrtc port allowlist as a shared IsWebrtcPortAllowed helper.  a=diannaS\n\nTurn the gGoodWebrtcPortList allowlist into IceServerParser::kGoodWebrtcPortList\nand make the file-local IsPortAllowed check to a public mozilla::IsWebrtcPortAllowed\nhelper, so the outgoing port restriction can be reused outside of ICE server URL\nparsing. No behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316418\n", "files": ["dom/media/webrtc/common/IceServerParser.cpp", "dom/media/webrtc/common/IceServerParser.h"], "git_node": "fb3a0273bf14f0d47a5e37c52fb3afa93a430344", "git_parents": ["93ed68c9a56e13f154f758603605f31017ca7082"], "node": "b6c6c8fa235a1f63caf68657aa1641592762b6e8", "parents": ["491381bbe14d468d168fb6ce81d396ec511767cc"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Apply outgoing port restrictions to remote ICE candidate destinations in NrSocket.  a=diannaS\n\nNrSocket (used for direct UDP/TCP sockets in the socket process and parent\nprocess) now rejects sends/connects to ports that are not allowed for webrtc,\nvia NrSocketBase::IsForbiddenAddress.  This blocks remote ICE candidates that\npoint at restricted destination ports in parent or socket process, the same\nway Bug 1677046 closed for them for ICE server URLs.  IsForbiddenAddress also\ngains the webrtc port allowlist so 53/3478/5349 stay usable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316419\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/nr_socket_prsock.h", "dom/media/webrtc/transport/test/test_nr_socket_unittest.cpp"], "git_node": "161cf1631282de353424f7af8e50036eb90bada0", "git_parents": ["fb3a0273bf14f0d47a5e37c52fb3afa93a430344"], "node": "f877e66e148435e30277e88b6a5aed15a621499d", "parents": ["b6c6c8fa235a1f63caf68657aa1641592762b6e8"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for content-process UDP.  a=diannaS\n\nWhen mtransport runs in the content process, UDP is sent via NrUdpSocketIpc to\nUDPSocketParent in the parent process. Drop outgoing packets destined for a\nrestricted port there, so the restriction is enforced in a process the content\nprocess cannot bypass. A disallowed port is dropped silently (IPC_OK) rather\nthan treated as a protocol violation, since it can come from a remote candidate\nsupplied through the normal API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316420\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/stun_socket_filter.cpp"], "git_node": "80c86f19ae953a582f2eafd88fec44449cc74424", "git_parents": ["161cf1631282de353424f7af8e50036eb90bada0"], "node": "e81421c59b7a34da63131da3f22d26411fab7c19", "parents": ["f877e66e148435e30277e88b6a5aed15a621499d"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for ICE-TCP.  a=diannaS\n\nICE-TCP connections are opened via WebrtcTCPSocketParent::RecvAsyncOpen (in the\nsocket or parent process). Reject opens to a restricted destination port there,\nsignalling a normal connection failure to the child via OnClose rather than\ntearing down the process with IPC_FAIL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316421\n", "files": ["dom/media/webrtc/transport/ipc/WebrtcTCPSocketParent.cpp"], "git_node": "d3962bfbb84c02e6bcc9126d30e52289c1b445df", "git_parents": ["80c86f19ae953a582f2eafd88fec44449cc74424"], "node": "70b094ed8b5671cc477a2c3eef9e20d04abf0aab", "parents": ["e81421c59b7a34da63131da3f22d26411fab7c19"], "tags": []}], "date": 1785955784, "git_changesets": ["2376b77640a16b678f42bdac15ad1766838d3817", "f3cb8fdd65509a9c208f52b0d7c979ec109612c6", "93ed68c9a56e13f154f758603605f31017ca7082", "fb3a0273bf14f0d47a5e37c52fb3afa93a430344", "161cf1631282de353424f7af8e50036eb90bada0", "80c86f19ae953a582f2eafd88fec44449cc74424", "d3962bfbb84c02e6bcc9126d30e52289c1b445df"], "user": "dsmith@mozilla.com"}, "193": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045368 - fixing bustage a=me\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp"], "git_node": "73a1cd00264f2b96ad5527b8675b145add03c586", "git_parents": ["d3962bfbb84c02e6bcc9126d30e52289c1b445df"], "node": "0e92f8302b28e16fd2323628fdb79699aa078ca2", "parents": ["70b094ed8b5671cc477a2c3eef9e20d04abf0aab"], "tags": []}], "date": 1785961585, "git_changesets": ["73a1cd00264f2b96ad5527b8675b145add03c586"], "user": "dsmith@mozilla.com"}, "194": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053670 - Part 1: Add isTwoByteString out parameter to ScriptSource::getSourceProperties.   a=diannaS\n\nThe later patch will rewrite the loadSource method based on the\ngetSourceProperties method, and the Unit type is necessaery there.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312680\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315830\n", "files": ["js/src/vm/GeckoProfiler.cpp", "js/src/vm/JSScript.cpp", "js/src/vm/JSScript.h"], "git_node": "097d20dedbe9813aac7a4b69211cb458bc506499", "git_parents": ["73a1cd00264f2b96ad5527b8675b145add03c586"], "node": "56800b453969d42255412ec3c5fec55b8c985a43", "parents": ["0e92f8302b28e16fd2323628fdb79699aa078ca2"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053670 - Part 2: Make ScriptSource::loadSource an instance method and rename to tryLoadSource.   a=diannaS\n\nThere's no reason to use static method, and the later patch will rewrite this\npart.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312681\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315831\n", "files": ["js/src/debugger/Source.cpp", "js/src/jsapi.cpp", "js/src/vm/JSFunction.cpp", "js/src/vm/JSScript.cpp", "js/src/vm/JSScript.h", "js/src/wasm/AsmJS.cpp"], "git_node": "99c6128ee9aa13e6dca9f04dad69386b59cd1a87", "git_parents": ["097d20dedbe9813aac7a4b69211cb458bc506499"], "node": "c5087cf6b06b7b7734469b09eade12d1249a18a2", "parents": ["56800b453969d42255412ec3c5fec55b8c985a43"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053670 - Part 3: Make ScriptSource::getSourceProperties an instance method.   a=diannaS\n\nThere's no reason to use static method, and the later patch will move this\nmethod into a new inner class.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315832\n", "files": ["js/src/vm/GeckoProfiler.cpp", "js/src/vm/JSScript.cpp", "js/src/vm/JSScript.h"], "git_node": "d8c150e2b62f8a098720d30481b33f00be4b6254", "git_parents": ["99c6128ee9aa13e6dca9f04dad69386b59cd1a87"], "node": "ce108d02c2a63c144a01394dbb3ce850d3118e55", "parents": ["c5087cf6b06b7b7734469b09eade12d1249a18a2"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053670 - Part 4: Move ScriptSource::TriggerConvertToCompressedSourceFromTask to JSScript.cpp.   a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312683\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315833\n", "files": ["js/src/vm/JSScript.cpp", "js/src/vm/JSScript.h"], "git_node": "08b4b1633333e8291792ee263739b0859ae3550e", "git_parents": ["d8c150e2b62f8a098720d30481b33f00be4b6254"], "node": "69331d6d48d824f9ca90158de1d97b4ce409568c", "parents": ["ce108d02c2a63c144a01394dbb3ce850d3118e55"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053670 - Part 5: Reorder ScriptSource methods as a preparation to introduce inner classes.   a=diannaS\n\nJust to reduce the diff in the next patch.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312685\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315834\n", "files": ["js/src/vm/JSScript.h"], "git_node": "bd928d76f12717875c94399c35a8f8e139cdab89", "git_parents": ["08b4b1633333e8291792ee263739b0859ae3550e"], "node": "32d8f58cdc5b6aaeb373f9c4ce10de2fc4565fe9", "parents": ["69331d6d48d824f9ca90158de1d97b4ce409568c"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053670 - Part 6: Introduce multiple-readers / single-writer lock for the ScriptSource data.   a=diannaS\n\nReplace PinnedUnits/PinnedUnitsIfUncompressed/GenericReader with\nDataReader and DataWriter, which allows making the underlying source units\nstable across multiple property accesses, in more natural way.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312686\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315835\n", "files": ["js/src/debugger/Source.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/frontend/Stencil.cpp", "js/src/frontend/StencilXdr.cpp", "js/src/frontend/StencilXdr.h", "js/src/jsapi-tests/testScriptSourceCompression.cpp", "js/src/jsapi.cpp", "js/src/vm/GeckoProfiler.cpp", "js/src/vm/HelperThreads.cpp", "js/src/vm/JSFunction.cpp", "js/src/vm/JSScript.cpp", "js/src/vm/JSScript.h", "js/src/wasm/AsmJS.cpp"], "git_node": "05e3b68fdca4f8708962526747be814b56c8ecb0", "git_parents": ["bd928d76f12717875c94399c35a8f8e139cdab89"], "node": "1520631d09a3e975f0249d39ec3ee96d3d76f81c", "parents": ["32d8f58cdc5b6aaeb373f9c4ce10de2fc4565fe9"], "tags": []}], "date": 1785966759, "git_changesets": ["097d20dedbe9813aac7a4b69211cb458bc506499", "99c6128ee9aa13e6dca9f04dad69386b59cd1a87", "d8c150e2b62f8a098720d30481b33f00be4b6254", "08b4b1633333e8291792ee263739b0859ae3550e", "bd928d76f12717875c94399c35a8f8e139cdab89", "05e3b68fdca4f8708962526747be814b56c8ecb0"], "user": "dsmith@mozilla.com"}, "195": {"changesets": [{"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050864 - update handling of subsegments in nsStandardURL::Deserialize and nsStandardURL::ReadPrivate.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311795\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316477\n", "files": ["netwerk/base/nsStandardURL.cpp", "netwerk/base/nsStandardURL.h"], "git_node": "ade5ea6791028dc8f3219b36af0c6fdd8d8d01b4", "git_parents": ["05e3b68fdca4f8708962526747be814b56c8ecb0"], "node": "3ed348aeea698133195de3d8f98ef9011d52b004", "parents": ["1520631d09a3e975f0249d39ec3ee96d3d76f81c"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053608 - Additional validation of URL segments in nsStandardURL.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312991\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316474\n", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": "f2bfe25a7dcf02a912b0add7a950103f6be1684a", "git_parents": ["ade5ea6791028dc8f3219b36af0c6fdd8d8d01b4"], "node": "d4d1f4f96439ec9ee1698b1f448ef72b5ab3abd2", "parents": ["3ed348aeea698133195de3d8f98ef9011d52b004"], "tags": []}], "date": 1785978914, "git_changesets": ["ade5ea6791028dc8f3219b36af0c6fdd8d8d01b4", "f2bfe25a7dcf02a912b0add7a950103f6be1684a"], "user": "dsmith@mozilla.com"}, "196": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2050294 - Backport cubeb test_loopback.cpp fix to address perma-failures on Windows.  a=diannaS DONTBUILD\n\nThis is a test-only change. To fix a perma, caused by a change in CI image.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315964\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315971\n", "files": ["media/libcubeb/0005-fix-loopback-separate-streams-flakiness-windows.patch", "media