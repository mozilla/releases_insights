6413c003863a414b0fa1616"], "tags": []}], "date": 1784849046, "git_changesets": ["0e3a7c5e799ec850693dc4b739cac180269f11ae"], "user": "dsmith@mozilla.com"}, "34": {"changesets": [{"author": "any1here \u003cany1here@duck.com\u003e", "branch": "default", "desc": "Bug 2046933 - Fix canvas.captureStream() permission prompting r=tjr, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306260\n", "files": ["dom/html/HTMLCanvasElement.cpp"], "git_node": "1e012d7883910fdbe8c891865b70a641c268a420", "git_parents": ["0e3a7c5e799ec850693dc4b739cac180269f11ae"], "node": "7c7782dd1e279c82292d518d03bf6073f34bbe1e", "parents": ["94f41f73de13ef0a92d6c91c1192fe57d61154e3"], "tags": []}], "date": 1784851538, "git_changesets": ["1e012d7883910fdbe8c891865b70a641c268a420"], "user": "dsmith@mozilla.com"}, "35": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054485 - Reject cross process javascript URIs in content.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312706\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313378\n", "files": ["dom/base/nsFrameLoader.cpp", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/javascript-url-security-check-failure.sub.html"], "git_node": "66c9f395d631abdc7efdb30586db2ce0b5606d3b", "git_parents": ["1e012d7883910fdbe8c891865b70a641c268a420"], "node": "e628c8a6ce683b41deb2e812fc6ed0aecb662644", "parents": ["7c7782dd1e279c82292d518d03bf6073f34bbe1e"], "tags": []}], "date": 1784853252, "git_changesets": ["66c9f395d631abdc7efdb30586db2ce0b5606d3b"], "user": "dsmith@mozilla.com"}, "36": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036097: Ignore native file picker confirmations that arrive too soon after the picker is shown.  a=diannaS\n\nA native file picker now ignores a confirmation that arrives within security.notification_enable_delay (default 500) of the picker being shown, keeping the picker open instead of accepting the selection. This reuses the existing anti-clickjacking delay already applied to security-sensitive notifications rather than adding a dedicated pref.\n\nThe shared timing lives in nsBaseFilePicker: RecordLastShownTime records when the picker is shown, IsPickerInputProtected says whether the time range is still active, and IsWithinInputProtectionTimeRange holds the timing check so it can be unit-tested. Each platform ignores an early confirmation in its native confirm path: macOS via an NSOpenSavePanelDelegate returning NO from panel:validateURL:error:, Windows via IFileDialogEvents::OnFileOk returning S_FALSE, and GTK by ignoring an early response from the non-portal file chooser. The GTK portal path returns only a final result and is left unchanged.\n\nA gtest covers the shared timing check.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307024\n\n(cherry picked from commit 107b377b65ae113bb23c127ccbdd617c25d4863a)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313514\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js", "widget/cocoa/nsFilePicker.h", "widget/cocoa/nsFilePicker.mm", "widget/gtk/nsFilePicker.cpp", "widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h", "widget/tests/gtest/TestFilePickerInputProtection.cpp", "widget/tests/gtest/moz.build", "widget/windows/filedialog/PWinFileDialog.ipdl", "widget/windows/filedialog/WinFileDialogChild.cpp", "widget/windows/filedialog/WinFileDialogChild.h", "widget/windows/filedialog/WinFileDialogCommands.cpp", "widget/windows/filedialog/WinFileDialogCommands.h", "widget/windows/filedialog/WinFileDialogParent.cpp", "widget/windows/filedialog/WinFileDialogParent.h", "widget/windows/nsFilePicker.cpp"], "git_node": "1a6143806988a4189a00ecfa17d26b3be70aa96d", "git_parents": ["66c9f395d631abdc7efdb30586db2ce0b5606d3b"], "node": "82fa579858654d505e41b2f73034486374575977", "parents": ["e628c8a6ce683b41deb2e812fc6ed0aecb662644"], "tags": []}], "date": 1784853369, "git_changesets": ["1a6143806988a4189a00ecfa17d26b3be70aa96d"], "user": "dsmith@mozilla.com"}, "37": {"changesets": [{"author": "Artur Iunusov \u003caiunusov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048490 - Schedule queued workers on their owning thread  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313419\n", "files": ["dom/workers/RuntimeService.cpp", "dom/workers/RuntimeService.h", "dom/workers/WorkerPrivate.h"], "git_node": "97a71e9a18a561cf7b8ee2650da664e82e3e47b7", "git_parents": ["1a6143806988a4189a00ecfa17d26b3be70aa96d"], "node": "04ef37f22157b63e5511ea361574e5856efaddab", "parents": ["82fa579858654d505e41b2f73034486374575977"], "tags": []}], "date": 1784910538, "git_changesets": ["97a71e9a18a561cf7b8ee2650da664e82e3e47b7"], "user": "dsmith@mozilla.com"}, "38": {"changesets": [{"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055723 Part 1 - Skip computing shrink-to-fit ratio during a measuring reflow.  a=diannaS DONTBUILD\n\nSee the code comment added in this patch for rationale.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313118\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313593\n", "files": ["layout/generic/nsPageContentFrame.cpp"], "git_node": "3236cd3082e3468448a099b2bd2bc41f670b3385", "git_parents": ["97a71e9a18a561cf7b8ee2650da664e82e3e47b7"], "node": "1e42544fc57b6e61a5c63cd555a3f799ae91d26b", "parents": ["04ef37f22157b63e5511ea361574e5856efaddab"], "tags": []}], "date": 1784910624, "git_changesets": ["3236cd3082e3468448a099b2bd2bc41f670b3385"], "user": "dsmith@mozilla.com"}, "39": {"changesets": [{"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054687 - Check iframe's parent matches the browsing context,  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312950\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313656\n", "files": ["toolkit/components/formautofill/FormAutofillParent.sys.mjs"], "git_node": "97df8c228a018618596a3adb1b577ec157844564", "git_parents": ["3236cd3082e3468448a099b2bd2bc41f670b3385"], "node": "1cad6c1b9cebe284445896c7bdd1a2fc3996d9b1", "parents": ["1e42544fc57b6e61a5c63cd555a3f799ae91d26b"], "tags": []}], "date": 1784910758, "git_changesets": ["97df8c228a018618596a3adb1b577ec157844564"], "user": "dsmith@mozilla.com"}, "40": {"changesets": [{"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054776 - Validate form history entries in FormHistoryParent.  a=diannaS DONTBUILD\n\nMove the form history entry checks into FormHistory and apply them in\nFormHistoryParent for the submit, autocomplete search and remove paths,\nin addition to the existing checks in FormHistoryChild.\n\nThe checks are applied by the actor that receives these messages.\nFormHistory.update is intentionally left unchanged so in-process callers\nsuch as the search bar continue to manage their own history directly.\nAutocomplete results are still scoped by fieldname only, so form history\nvisibility across origins is unchanged.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313659\n", "files": ["toolkit/components/satchel/FormHistory.sys.mjs", "toolkit/components/satchel/FormHistoryChild.sys.mjs", "toolkit/components/satchel/FormHistoryParent.sys.mjs"], "git_node": "7c7e57f1587e8aff3462fc01f10a418e8b628df1", "git_parents": ["97df8c228a018618596a3adb1b577ec157844564"], "node": "3fdb4d6a3c8833ae3c7df7e4047011b2749b8d7a", "parents": ["1cad6c1b9cebe284445896c7bdd1a2fc3996d9b1"], "tags": []}], "date": 1784910876, "git_changesets": ["7c7e57f1587e8aff3462fc01f10a418e8b628df1"], "user": "dsmith@mozilla.com"}, "41": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2054832 - Cap total module size during streaming wasm compilation  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312565\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313835\n", "files": ["js/src/wasm/WasmJS.cpp"], "git_node": "4c30d4bb8d80496df98403c42e1dbd031ed84700", "git_parents": ["7c7e57f1587e8aff3462fc01f10a418e8b628df1"], "node": "3079c4b62b55846fcd0f7afa719f909f3dfd5d80", "parents": ["3fdb4d6a3c8833ae3c7df7e4047011b2749b8d7a"], "tags": []}], "date": 1784910971, "git_changesets": ["4c30d4bb8d80496df98403c42e1dbd031ed84700"], "user": "dsmith@mozilla.com"}, "42": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054761.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313213\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313731\n", "files": ["browser/components/mozcachedohttp/actors/MozCachedOHTTPParent.sys.mjs", "browser/components/mozcachedohttp/test/unit/test_cache_behavior.js"], "git_node": "94ddac8f791eeb3d9147ef5ebbc3d85a59c5a7b4", "git_parents": ["4c30d4bb8d80496df98403c42e1dbd031ed84700"], "node": "65498a1c8fd45c86ae688ffe970fe7ab8f9e531a", "parents": ["3079c4b62b55846fcd0f7afa719f909f3dfd5d80"], "tags": []}], "date": 1784911021, "git_changesets": ["94ddac8f791eeb3d9147ef5ebbc3d85a59c5a7b4"], "user": "dsmith@mozilla.com"}, "43": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2055676 - Throw an error if a debugger hook breaks the promise invariant.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312708\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313198\n", "files": ["js/src/builtin/Promise.cpp", "js/src/debugger/DebugAPI-inl.h", "js/src/debugger/Debug