ta.json", "services/settings/dumps/main/search-config-icons/f312610a-ebfb-a106-ea92-fd643c5d3636.meta.json", "services/settings/dumps/main/search-config-icons/fa0fc42c-d91d-fca7-34eb-806ff46062dc.meta.json", "services/settings/dumps/main/search-config-icons/fca3e3ee-56cd-f474-dc31-307fd24a891d.meta.json", "services/settings/dumps/main/search-config-icons/fed4f021-ff3e-942a-010e-afa43fda2136.meta.json", "services/settings/dumps/main/search-config-overrides-v2.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/sites-classification.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/main/translations-wasm.json", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/main/url-parser-default-unknown-schemes-interventions.json", "services/settings/dumps/main/urlbar-persisted-search-terms.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "d9912a3e4f2bd4bd427fd537021feed66100db56", "git_parents": ["d92ddd664658528d1a01b185160ecca4e1a7763f"], "node": "f6036a487e47aa7cb21de6b7aacfecbb9c9bc2da", "parents": ["8dbf7dbd0a3609529d5cf88561e696e7d52a6375"], "tags": []}], "date": 1786362010, "git_changesets": ["d9912a3e4f2bd4bd427fd537021feed66100db56"], "user": "dsmith@mozilla.com"}, "256": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2052401 - Guard AudioCallbackDriver::mAudioStream with a DataMutex.  a=diannaS DONTBUILD\n\nAudioOutputLatency() reads mAudioStream from the main thread\n(AudioContext.getOutputTimestamp()), while Init() writes it on the\nCubebOperation thread with no synchronization.\n\nEvery other access to mAudioStream is already CubebOperation-thread-only,\nso wrap it in a DataMutex, matching the existing mFallback pattern in this\nfile, rather than e.g. caching a latency value (which can change over the\nstream's life). The real-time audio callback thread never touches\nmAudioStream, so this lock is never contended on that path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310300\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317497\n", "files": ["dom/media/GraphDriver.cpp", "dom/media/GraphDriver.h"], "git_node": "308ed0006666ecd8dda95438240f952d75319a54", "git_parents": ["d9912a3e4f2bd4bd427fd537021feed66100db56"], "node": "daab318479be16071170a78f3aab094f084f4fb7", "parents": ["f6036a487e47aa7cb21de6b7aacfecbb9c9bc2da"], "tags": []}], "date": 1786393074, "git_changesets": ["308ed0006666ecd8dda95438240f952d75319a54"], "user": "dsmith@mozilla.com"}, "257": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2054671 - ValidatePrincipal in PLockManager,  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313529\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317548\n", "files": ["dom/locks/LockManager.cpp", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "918a8e61984a029e07eafbd63a6d22fa60e86676", "git_parents": ["308ed0006666ecd8dda95438240f952d75319a54"], "node": "3b0246670d6b6741549e5ddd8b479ed3d789c497", "parents": ["daab318479be16071170a78f3aab094f084f4fb7"], "tags": []}], "date": 1786393095, "git_changesets": ["918a8e61984a029e07eafbd63a6d22fa60e86676"], "user": "dsmith@mozilla.com"}, "258": {"changesets": [{"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059365 - Remove mochitest-remote from the macosx1500-aarch64-vms test set.  a=diannaS DONTBUILD\n\nmochitest-remote is the only browser-chrome flavor suite running on the\nheadless VM pool, and it has been failing consistently since it was enabled.\n\nbrowser-test.js nextTest calls SimpleTest.waitForFocus before every test,\nincluding the first. That lands in SimpleTest.promiseFocus, which awaits a\nfocus event with no timeout and no fallback. Window activation never\ncompletes on these workers, so the job hangs before the first test, produces\nno output, and is killed by the 370s harness timeout on every one of its\nnine retries. A representative task burns 1h15m to produce zero results.\n\nProfiler captures taken automatically at the hang confirm the browser is\nidle rather than deadlocked: 1156 of 1157 GeckoMain samples sit in\nNative event loop idle under NSApplication run, waiting for an AppKit event\nthat never arrives.\n\nThis is not specific to mochitest-remote. mochitest-devtools-chrome was\nevaluated for this pool in June 2026 and rejected for the same signature;\nmochitest-remote only predates that finding. The block comment on this test\nset already states that suites needing focus management and browser windows\nare intentionally omitted, so this brings the list back in line with its own\nstated policy.\n\nBug 2050174 tracks the underlying window activation issue on these workers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316346\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316782\n", "files": ["taskcluster/test_configs/test-sets.yml"], "git_node": "d3f82683f009663393d373a2666304c43bcfd758", "git_parents": ["918a8e61984a029e07eafbd63a6d22fa60e86676"], "node": "6da815f9984749be95d2ca05a922b826dc4c5446", "parents": ["3b0246670d6b6741549e5ddd8b479ed3d789c497"], "tags": []}], "date": 1786394942, "git_changesets": ["d3f82683f009663393d373a2666304c43bcfd758"], "user": "dsmith@mozilla.com"}, "259": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2061794.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317311\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317313\n", "files": ["netwerk/protocol/http/InterceptedHttpChannel.cpp"], "git_node": "708c8d439f170881c11f5e3be7f15d5b71a18cdb", "git_parents": ["d3f82683f009663393d373a2666304c43bcfd758"], "node": "4646dc7b6dbe68513941c28f2c88d2c045d436b7", "parents": ["6da815f9984749be95d2ca05a922b826dc4c5446"], "tags": []}], "date": 1786396082, "git_changesets": ["708c8d439f170881c11f5e3be7f15d5b71a18cdb"], "user": "dsmith@mozilla.com"}, "26": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022382: Fix cookie handling  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D292251\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313709\n", "files": ["dom/ipc/WindowGlobalParent.cpp"], "git_node": "9a560bfaec3e9b92f0f4b2dba74147acd0285c8f", "git_parents": ["fc73c5b7afec72181f069deeeded66f7f7c21031"], "node": "118aa867d0ad64b876b4ad789e1fa49e08717307", "parents": ["053d5032f0d86b7a39010e368828260b965a3a37"], "tags": []}], "date": 1784830537, "git_changesets": ["9a560bfaec3e9b92f0f4b2dba74147acd0285c8f"], "user": "dsmith@mozilla.com"}, "260": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060748 - Add ifdef MOZ_THUNDERBIRD workaround for drag+drop regression.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317105\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317486\n", "files": ["widget/nsBaseDragService.cpp"], "git_node": "b870f1e57c1e385c3b3915a83b2ea74f59859638", "git_parents": ["708c8d439f170881c11f5e3be7f15d5b71a18cdb"], "node": "9cf3b481f29a94a4a5b5fc3bfb71e70cb5ae6f30", "parents": ["4646dc7b6dbe68513941c28f2c88d2c045d436b7"], "tags": []}], "date": 1786396104, "git_changesets": ["b870f1e57c1e385c3b3915a83b2ea74f59859638"], "user": "dsmith@mozilla.com"}, "261": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Send SSPI channel bindings on the initial InitializeSecurityContext call.  a=diannaS DONTBUILD\n\nThe SEC_CHANNEL_BINDINGS buffer was only ever built on continuation calls. That\nis sufficient for raw NTLM, whose channel binding travels in message 3, but\nSPNEGO carries the AP-REQ in the very first token, so Kerberos needs the\nbindings from the initial call on and never received them.\n\nMove the token construction into a helper and attach it whenever a certificate\nis available, building the input buffer descriptor up front so it can be passed\nwith no accompanying token. Keep the certificate for the lifetime of the\nsequence instead of freeing it after first use, so every leg of a multi-leg\nexchange carries the bindings.\n\nThe exemption for PACKAGE_TYPE_NTLM covers the sys-ntlm module only, which\nkeeps behaving exactly as it does today. NTLM negotiated inside SPNEGO runs\nunder PACKAGE_TYPE_NEGOTIATE and will now carry bindings from the first call:\nthat is the main behaviour change here and the one worth reviewing closely,\nsince raw NTLM is deliberately untouched.\n\nOn its own this commit changes nothing, because no caller supplies a\ncertificate on the Negotiate path until the next one.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316807\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317791\n", "files": ["extensions/auth/nsAuthSSPI.cpp", "extensions/auth/nsAuthSSPI.h"], "git_node": "472431e35ba6c8345210023202bcc1e78ae5fc95", "git_parents": ["b870f1e57c1e385c3b3915a83b2ea74f59859638"], "node": "66feea38152aa6a05a4dccca1dc63f7571b6dc82", "parents": ["9cf3b481f29a94a4a5b5fc3bfb71e70cb5ae6f30"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Pass the server certificate to the Negotiate auth module.  a=diannaS DONTBUILD\n\nnsHttpNegotiateAuth never retrieved the server certificate, so nsAuthSSPI had\nnothing to build a channel binding token from and Negotiate authentication\nnever sent one. Servers with Extended Protection set to Require reject that,\nwhich is why Kerberos SSO fails against ADFS and Exchange OWA where Chrome and\nEdge succeed. nsHttpNTLMAuth is the only caller that has ever supplied a\ncertificate.\n\nGenerateCredentials runs on a background thread, so the certificate is\ncollected on the main thread in GenerateCredentialsAsync, and only for a\nchallenge that carries no token of its own. That is the first call of a\nsequence, and the only call where nsAuthSSPI::GetNextToken expects a\ncertificate in place of the input token.\n\nProxy auth is excluded because the channel's security info describes the origin\nserver rather than the proxy. Extended Protection for proxies needs the proxy's\nown certificate and is left for a follow-up.\n\nnetwork.auth.negotiate_channel_binding backs the change out.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317792\n", "files": ["extensions/auth/nsHttpNegotiateAuth.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "51e17809e75de597c6378ce351775b4f48e45486", "git_parents": ["472431e35ba6c8345210023202bcc1e78ae5fc95"], "node": "b402805063888e8dce4c4996eb2749813ffabffe", "parents": ["66feea38152aa6a05a4dccca1dc63f7571b6dc82"], "tags": []}], "date": 1786468970, "git_changesets": ["472431e35ba6c8345210023202bcc1e78ae5fc95", "51e17809e75de597c6378ce351775b4f48e45486"], "user": "dsmith@mozilla.com"}, "262": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047853: Persisting response credential type in cache entries table.   a=diannaS\n\nThis re-lands D311986, backed out from esr153 in b81b4a1b1f41 for crashing\nevery dom/cache xpcshell migration test, and squashes in the Bug 2009295\nschema migration it depends on.\n\nRoot cause: D311986 bumps kLatestSchemaVersion from 29 to 31 but registers\nonly MigrateFrom30To31. Schema version 30 comes from Bug 2009295 (D278397),\nwhich adds the response_headers(entry_id, name) index and was never uplifted\nto esr153. With nothing registered for version 29, Migrate() walked a database\nup to 29, found no matching entry in sMigrationList, and looped without the\nversion advancing:\n\n  Assertion failure: currentVersion \u003e lastVersion, at dom/cache/DBSchema.cpp:2659\n\nOn the release channel MOZ_DIAGNOSTIC_ASSERT is compiled out, so this is an\ninfinite loop on the Cache IO thread rather than a crash. Every existing\nesr153 profile is at schema 29, so it would have hung Cache API and Service\nWorker storage for upgrading users, not just broken tests.\n\nSquashed commits:\n\n  Bug 2009295 (D278397), by Marcelo Camargo - closes the gap at version 29.\n  Uplifted whole rather than schema-only so that versions 30 and 31 mean the\n  same thing on esr153 as on mozilla-central. Profiles are shared across\n  channels, and a partial uplift would leave an esr153 database at version 31\n  permanently missing the index, with no migration left to ever add it.\n\n  Bug 2047853 (D311986) - unchanged from the original uplift.\n\nWith both applied, dom/cache/DBSchema.cpp matches mozilla-central except for\nthe unrelated nsID::Parse signature change from Bug 2054573.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D278397\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311986\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317091\n", "files": ["dom/cache/DBSchema.cpp", "dom/cache/TypeUtils.cpp"], "git_node": "79243c9dd50f71416d0698c4a614ce7ab584f165", "git_parents": ["51e17809e75de597c6378ce351775b4f48e45486"], "node": "a22508c1db0dcb8562d2e6e417d60c2215bbe3ec", "parents": ["b402805063888e8dce4c4996eb2749813ffabffe"], "tags": []}], "date": 1786471381, "git_changesets": ["79243c9dd50f71416d0698c4a614ce7ab584f165"], "user": "dsmith@mozilla.com"}, "263": {"changesets": [{"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2057577 - DOM Media - Add FFmpeg 63 support.  a=diannaS\n\nRaise FFMPEG_MAX_MAJOR_VERSION to 63 and add the ffmpeg63 header tree\nso system/custom libavcodec.so.63 can be loaded. Keep libavcodec.so.62\nin the runtime linker search list after the max bump. Adapt to FFmpeg\n63 API removals: query sample rates via avcodec_get_supported_config,\nand pick the Vulkan transfer queue from AVVulkanDeviceContext::qf.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314026\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317879\n", "files": [".clang-format-ignore", ".prettierignore", "dom/media/platforms/ffmpeg/FFmpegAudioEncoder.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.h", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/ffmpeg63/include/COPYING.LGPLv2.1", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/avcodec.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/avdct.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/bsf.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_desc.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_id.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_par.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/defs.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/packet.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/vdpau.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version_major.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/attributes.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/avconfig.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/avutil.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/buffer.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/channel_layout.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/common.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/cpu.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/dict.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/error.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/frame.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_drm.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_vaapi.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_vulkan.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/intfloat.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/log.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/macros.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/mathematics.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/mem.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/pixfmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/rational.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/samplefmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/moz.build", "dom/media/platforms/ffmpeg/moz.build", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "468445e58d3acc7e4e059be99856daff1f2ae8f1", "git_parents": ["79243c9dd50f71416d0698c4a614ce7ab584f165"], "node": "bdb74c45c2e1e3fe593fbf3c5ca6d2ab2046ef08", "parents": ["a22508c1db0dcb8562d2e6e417d60c2215bbe3ec"], "tags": ["FIREFOX_153_1_0esr_BUILD1", "FIREFOX_153_1_0esr_RELEASE"]}], "date": 1786479111, "git_changesets": ["468445e58d3acc7e4e059be99856daff1f2ae8f1"], "user": "dsmith@mozilla.com"}, "27": {"changesets": [{"author": "Karl Tomli