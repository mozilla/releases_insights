s:396500:"{
"lastpushid": 589,
"pushes": {"10": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "956b02a9b877f41e445504f13762c86c72b77e25", "git_parents": ["92cc8624088dff2164f8edbb3a16b6389acc3fa3"], "node": "65806e7eaad7afdc51252694ac3a721fef8490d3", "parents": ["d544c9d3d1e5b1b6a7a9462e9033dc9257476322"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "d43e1408f52a151750d2fa45ac1dd1cd38d9f8ed", "git_parents": ["956b02a9b877f41e445504f13762c86c72b77e25"], "node": "7426b9a506b146975bb377a89cac5a31cccd9180", "parents": ["65806e7eaad7afdc51252694ac3a721fef8490d3"], "tags": []}], "date": 1784569238, "git_changesets": ["956b02a9b877f41e445504f13762c86c72b77e25", "d43e1408f52a151750d2fa45ac1dd1cd38d9f8ed"], "user": "ffxbld@lando.moz.tools"}, "100": {"changesets": [{"author": "Tom Ritter \u003ctritter@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054037 - Add missing datadome_oc_pbm Glean metric r=timhuang a=RyanVM DONTBUILD\n\nThe Datadome 'loaded' counter had no private-browsing variant, unlike every\nother captcha provider. recordCaptchaHandlerConstructed unconditionally appends\nthe 'Pbm' suffix, so when a Datadome interstitial loads in a private window it\nevaluates Glean.captchaDetection.datadomeOcPbm.add(1) on an undefined metric,\nthrowing a TypeError and dropping the load count (ps/bl/pc _pbm still record).\nAdd datadome_oc_pbm mirroring the other providers' oc_pbm entries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311506\n", "files": ["toolkit/components/captchadetection/metrics.yaml"], "git_node": "21705535e24194b65d4707ba0f512b977a0c3b98", "git_parents": ["30f6ba6ce490fdf0f6a00eefa03eb1d0b1bb57c7"], "node": "08a2127e26dd580be83e6ab548e9caad61de4066", "parents": ["30b00bbd776627128b5f709772567683ecbe918f"], "tags": []}], "date": 1785510979, "git_changesets": ["21705535e24194b65d4707ba0f512b977a0c3b98"], "user": "rvandermeulen@mozilla.com"}, "101": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053327 - Check allocations in _cairo_win32_printing_surface_paint_linear_pattern.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311550\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315628\n", "files": ["gfx/cairo/cairo/src/win32/cairo-win32-printing-surface.c", "gfx/cairo/patches/0042-win32-printing-linear-pattern.patch"], "git_node": "0bf272aaac48d0c37393f2d907d4de6013b110e8", "git_parents": ["21705535e24194b65d4707ba0f512b977a0c3b98"], "node": "cd5d17a674b3e67d859f0fd2d8ac56056d017e37", "parents": ["08a2127e26dd580be83e6ab548e9caad61de4066"], "tags": []}], "date": 1785511282, "git_changesets": ["0bf272aaac48d0c37393f2d907d4de6013b110e8"], "user": "rvandermeulen@mozilla.com"}, "102": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035706: Stop IdleTaskRunner from rescheduling once thread shutdown has begun.  a=RyanVM DONTBUILD\n\nDuring content-process shutdown an IdleTaskRunner can re-dispatch itself through immediate idle dispatch (Run -\u003e Schedule -\u003e TaskController::AddTask -\u003e Run ...). The shutdown event-loop drains in ShutdownXPCOM and nsThreadManager::ShutdownNonMainThreads keep running that task while the idle deadline is stale, so it reschedules right away and spins the main thread. On macOS the parent's shutdown watchdog then force-crashes the still-busy child, which shows up in CI as the intermittent \"application crashed [@ mach_msg2_trap]\" signature and leakcheck \"missing output line for total leaks!\" failures on macOS 15 aarch64 debug, concentrated in the cross-origin variant that tears down many content processes.\n\nCancel the runner in Schedule() once we are in or beyond XPCOMShutdownThreads. Idle tasks are best-effort and serve no purpose that late in shutdown, and stopping them here prevents the runaway rescheduling that hangs the process.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310968\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315558\n", "files": ["xpcom/threads/IdleTaskRunner.cpp"], "git_node": "894e23e4fb9f156cb685dd5cbb57fcd5eda574da", "git_parents": ["0bf272aaac48d0c37393f2d907d4de6013b110e8"], "node": "e662300a07d1bc03c7966be035d6aac8581076f5", "parents": ["cd5d17a674b3e67d859f0fd2d8ac56056d017e37"], "tags": []}], "date": 1785511307, "git_changesets": ["894e23e4fb9f156cb685dd5cbb57fcd5eda574da"], "user": "rvandermeulen@mozilla.com"}, "103": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053174 - Compare source and destination surface sizes in ConvertToRGBA.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313543\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315393\n", "files": ["dom/media/ImageConversion.cpp"], "git_node": "4597ddb34cee72e5ec55bc64caa9ae2dc1f0cfcd", "git_parents": ["894e23e4fb9f156cb685dd5cbb57fcd5eda574da"], "node": "8aa815ebefc81a235fd88dafa5917aed55f7cd81", "parents": ["e662300a07d1bc03c7966be035d6aac8581076f5"], "tags": []}], "date": 1785511331, "git_changesets": ["4597ddb34cee72e5ec55bc64caa9ae2dc1f0cfcd"], "user": "rvandermeulen@mozilla.com"}, "104": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2057308.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313983\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314201\n", "files": ["image/RasterImage.cpp", "image/RasterImage.h"], "git_node": "567c0838d944c668307b8d56aa27b9d24e576f5d", "git_parents": ["4597ddb34cee72e5ec55bc64caa9ae2dc1f0cfcd"], "node": "5052ad4aba547e6bdc826c6cd065ccfb54938539", "parents": ["8aa815ebefc81a235fd88dafa5917aed55f7cd81"], "tags": []}], "date": 1785511351, "git_changesets": ["567c0838d944c668307b8d56aa27b9d24e576f5d"], "user": "rvandermeulen@mozilla.com"}, "105": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057118 - Reset the picture region when the decoder adopts a new image size from the stream.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314546\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315006\n", "files": ["dom/media/MediaInfo.h", "dom/media/platforms/wrappers/MediaChangeMonitor.cpp"], "git_node": "027662f28d6f8f0301e370b7f2f98eb0b08abded", "git_parents": ["567c0838d944c668307b8d56aa27b9d24e576f5d"], "node": "063054f3aad712654a0c4e50917c6305cbfff2ff", "parents": ["5052ad4aba547e6bdc826c6cd065ccfb54938539"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057118 - Constrain the picture rectangle to the image buffer when building a video frame.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314547\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315007\n", "files": ["dom/media/MediaData.cpp", "dom/media/platforms/wmf/WMFVideoMFTManager.cpp"], "git_node": "2a877732b1730f241238123411d882c3509c63be", "git_parents": ["027662f28d6f8f0301e370b7f2f98eb0b08abded"], "node": "197f67b212e596cbe5963a9405dafcf21670c545", "parents": ["063054f3aad712654a0c4e50917c6305cbfff2ff"], "tags": []}], "date": 1785511519, "git_changesets": ["027662f28d6f8f0301e370b7f2f98eb0b08abded", "2a877732b1730f241238123411d882c3509c63be"], "user": "rvandermeulen@mozilla.com"}, "106": {