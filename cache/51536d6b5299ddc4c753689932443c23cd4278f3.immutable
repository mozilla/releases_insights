1cfaa20b05b01e"], "node": "5437c06e9e894ee9e68cf3d01a1ded5b319031c0", "parents": ["ca2910fafa74e81e89319d0ca46328ae0a461dbf"], "tags": []}], "date": 1790696851, "git_changesets": ["a1ed52560a2b55c84fa09cb1f3516cdf3775ee1c"], "user": "dsmith@mozilla.com"}, "28725": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2075736 - Avoid a shift overflow when downscaling a box-shadow mask.  a=diannaS\n\nA surface can legitimately have a device pixel scale large enough that the\nnumber of blur downscales reaches 32, which overflowed the shift computing\nthe divisor.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329508\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329641\n", "files": ["gfx/tests/crashtests/2075736.html", "gfx/tests/crashtests/crashtests.list", "gfx/wr/webrender/src/box_shadow.rs"], "git_node": "e3d925f3acbc7ddd944070c3df9364b4a052bfdf", "git_parents": ["a1ed52560a2b55c84fa09cb1f3516cdf3775ee1c"], "node": "1558093c693a2798a0f4cc2c21ddd122e4113f9f", "parents": ["5437c06e9e894ee9e68cf3d01a1ded5b319031c0"], "tags": []}], "date": 1790696890, "git_changesets": ["e3d925f3acbc7ddd944070c3df9364b4a052bfdf"], "user": "dsmith@mozilla.com"}, "28726": {"changesets": [{"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074379 - Use --link-color for favicon badges in the urlbar view.  a=diannaS\n\nWhen the row isn't selected, use `--link-color` as the fill. That's the same\ncolor that URLs and explanation text in the view use, which is the desired color\naccording to Paul.\n\nWhen the row is selected, the existing `fill: currentColor` rule on the row is\nactive, which ensures the badge will have the same color as the row's text when\nthe row is selected:\n\nhttps://searchfox.org/firefox-main/rev/9e9b5f17f56187c1f5c8b9cdf79a01ff51a7b643/browser/themes/shared/urlbar/view-nova.css#149\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328685\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329678\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "144a188c07fd6bacff56ad9cc7522cb1a85e119d", "git_parents": ["e3d925f3acbc7ddd944070c3df9364b4a052bfdf"], "node": "2e7bcf44ae273c075a3cf79b249bab2d1a700d4d", "parents": ["1558093c693a2798a0f4cc2c21ddd122e4113f9f"], "tags": []}], "date": 1790697033, "git_changesets": ["144a188c07fd6bacff56ad9cc7522cb1a85e119d"], "user": "dsmith@mozilla.com"}, "28727": {"changesets": [{"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065402  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326836\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329681\n", "files": ["browser/components/urlbar/UrlbarProviderQuickSuggest.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/private/FlightStatusSuggestions.sys.mjs", "browser/components/urlbar/private/MarketSuggestions.sys.mjs", "browser/components/urlbar/private/RealtimeSuggestProvider.sys.mjs", "browser/components/urlbar/private/SportsSuggestions.sys.mjs", "browser/components/urlbar/private/YelpRealtimeSuggestions.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_addons.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_dynamicSuggestions.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_realtime_market.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_realtime_yelp.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_sports.js", "browser/components/urlbar/tests/quicksuggest/unit/head.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_addons.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_amp.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_merino.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_scoreMap.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_topPicks.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_wikipedia.js", "browser/components/urlbar/tests/unit/head.js", "browser/components/urlbar/tests/unit/test_UrlbarUtils_getRemoteIconUrl.js", "toolkit/modules/FaviconUtils.sys.mjs"], "git_node": "4392baa7a7bcde4e44c1db0913cd31b01ec815e0", "git_parents": ["144a188c07fd6bacff56ad9cc7522cb1a85e119d"], "node": "129a475e89df1406096e186ff7a1803f0a9a2aaf", "parents": ["2e7bcf44ae273c075a3cf79b249bab2d1a700d4d"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075759 - Always specify a size for moz-remote-image URLs used by Suggest.  a=diannaS\n\nPass in the top-pick icon size for the `size` param. This will have the\nfollowing effects as the images are decoded out-of-process due to how\n`moz-remote-image` works (in conjunction with the fact that we also pass\n`stretch=false`):\n\n* Images that are no larger than the top-pick size won't be resized when they\n  are decoded\n\n* Images that are larger will be downsampled when they are decoded\n\n* For SVGs that don't have an intrinsic size, there are two possibilities: They\n  can either have an intrinsic ratio or not. For those with an intrinsic ratio,\n  they'll be drawn at the top-pick size while preserving their ratio. For SVGs\n  without an intrinsic ratio, they'll be stretched and probably distorted so\n  that their width and height both equal the top-pick size.\n\nOn top of all of that, these images will be resized again when they're drawn in\nthe UI if they aren't shown at exactly the top-pick size.\n\nFor a larger discussion, including why this patch only uses the top-pick size\neven though some of these images will be shown at a smaller size, see:\n\nhttps://phabricator.services.mozilla.com/D326836#11437885\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329353\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329682\n", "files": ["browser/components/urlbar/UrlbarProviderQuickSuggest.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/private/FlightStatusSuggestions.sys.mjs", "browser/components/urlbar/private/MarketSuggestions.sys.mjs", "browser/components/urlbar/private/SportsSuggestions.sys.mjs", "browser/components/urlbar/private/YelpRealtimeSuggestions.sys.mjs", "browser/themes/shared/urlbar/view-nova.css"], "git_node": "50149cdaaa8c94acca5d1374e602b7be6ecb3742", "git_parents": ["4392baa7a7bcde4e44c1db0913cd31b01ec815e0"], "node": "9226edb09637c46df78cb2658a38a6b6a7b6338b", "parents": ["129a475e89df1406096e186ff7a1803f0a9a2aaf"], "tags": []}], "date": 1790697120, "git_changesets": ["4392baa7a7bcde4e44c1db0913cd31b01ec815e0", "50149cdaaa8c94acca5d1374e602b7be6ecb3742"], "user": "dsmith@mozilla.com"}, "28728": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2075069 - Allow the crash reporter client to send annotations under their altname.  a=diannaS\n\nThe .extra file uses an annotation's altname when it has one. The Addons annotation is\nwritten as \"Add-ons\". Build the allowlist from the altname when one is set, so it matches the\nnames in the .extra file.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329559\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329694\n", "files": ["toolkit/crashreporter/client/app/build.rs", "toolkit/crashreporter/client/app/src/test.rs"], "git_node": "9127bb5ca08e6945dd00ad379a8c24246a52a955", "git_parents": ["50149cdaaa8c94acca5d1374e602b7be6ecb3742"], "node": "cb2936a28f22bab8d15da18c0d8fb1bbefce241c", "parents": ["9226edb09637c46df78cb2658a38a6b6a7b6338b"], "tags": []}], "date": 1790714237, "git_changesets": ["9127bb5ca08e6945dd00ad379a8c24246a52a955"], "user": "dsmith@mozilla.com"}, "28729": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings mobile-merino-manifest ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329800\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-icons.json", "services/settings/dumps/main/search-config-overrides-v2.json", "services/settings/dumps/main/search-config-v2.json"], "git_node": "df7cb36d0d2b4ff5d02912a0a2988a8b16bda5da", "git_parents": ["9127bb5ca08e6945dd00ad379a8c24246a52a955"], "node": "896c16afdd1b1bfffdceb277346c1213946db531", "parents": ["cb2936a28f22bab8d15da18c0d8fb1bbefce241c"], "tags": []}], "date": 1790714924, "git_changesets": ["df7cb36d0d2b4ff5d02912a0a2988a8b16bda5da"], "user": "dsmith@mozilla.com"}, "28730": {"changesets": [{"author": "Dan Schomburg \u003cdschomburg@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075384 - Ensure that Firefox is used to open FxQ pairing QR codes  a=diannaS\n\nAdd an autoVerify intent filter to IntentReceiverActivity for https on\naccounts.firefox.com and accounts.stage.mozaws.net with a /pair path prefix.\nFxA already serves assetlinks.json for both hosts with the release, beta and\nnightly fingerprints, but Fenix only had scheme-only http/https filters, which\nAndroid cannot verify. This caused scanned pairing QR codes open in default\nbrowser instead of Firefox.\n\nThe new filter must precede the scheme-only filter. Android keeps only the\nfirst matching filter per activity and uses it to classify the app; with the\nscheme-only filter first, Fenix is treated as a generic browser and skipped\nduring App Links resolution even when the domains are approved.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329052\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329625\n", "files": ["mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/nightly/AndroidManifest.xml"], "git_node": "8940703dd21d725b48ac86e9075aa13b1fe60dfa", "git_parents": ["df7cb36d0d2b4ff5d02912a0a2988a8b16bda5da"], "node": "5ee2e9bd6fdf8929afcb094abd7ae97552379e81", "parents": ["896c16afdd1b1bfffdceb277346c1213946db531"], "tags": []}], "date": 1790715067, "git_changesets": ["8940703dd21d725b48ac86e9075aa13b1fe60dfa"], "user": "dsmith@mozilla.com"}, "28731": {"changesets": [{"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"No Bug, mozilla-beta repo-update remote-settings mobile-merino-manifest ct-logs - a=diannaS\" for causing multiple mochitest failures.\n\nThis reverts commit df7cb36d0d2b4ff5d02912a0a2988a8b16bda5da.\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-icons.json", "services/settings/dumps/main/search-config-overrides-v2.json", "services/settings/dumps/main/search-config-v2.json"], "git_node": "048184db16bbca8eaa932df0fce643aeac010f05", "git_parents": ["8940703dd21d725b48ac86e9075aa13b1fe60dfa"], "node": "233d1fefc30df4682bacb1a4efc98f2cadf6bce0", "parents": ["5ee2e9bd6fdf8929afcb094abd7ae97552379e81"], "tags": []}], "date": 1790725775, "git_changesets": ["048184db16bbca8eaa932df0fce643aeac010f05"], "user": "abutkovits@mozilla.com"}, "28732": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "des