ntial Revision: https://phabricator.services.mozilla.com/D329354\n", "files": ["media/ffvpx/libavutil/avutil.symbols"], "git_node": "dc412e8ba5c205160f421c96d333e75d79066a42", "git_parents": ["a56a3697a076457b5cea3f2fee5541683e66ecd8"], "node": "6ece71f86fd5de8476039f905a5c9489966a1e28", "parents": ["88530de797c1be07b333b351d3c306f9f3032bdf"], "tags": []}], "date": 1790555994, "git_changesets": ["dc412e8ba5c205160f421c96d333e75d79066a42"], "user": "dsmith@mozilla.com"}, "28699": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2074860 - Migrate release, beta, and dev edition users out of JPEG XL labs  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328708\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329271\n", "files": ["toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/unit/test_Migrations.js"], "git_node": "318e49ccdd5c79cee5f7abd67e8ef02529999937", "git_parents": ["dc412e8ba5c205160f421c96d333e75d79066a42"], "node": "bb0e4e14ddedf1762217857076c347b32dca01e3", "parents": ["6ece71f86fd5de8476039f905a5c9489966a1e28"], "tags": []}], "date": 1790556038, "git_changesets": ["318e49ccdd5c79cee5f7abd67e8ef02529999937"], "user": "dsmith@mozilla.com"}, "28700": {"changesets": [{"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073458 - [arm64] Avoid LDP/STP and use single-register loads and stores in {push,pop}Regs(...) on Darwin.  a=diannaS\n\nForwarding to/from LDP/STP instructions doesn't seem to work on some\nApple Silicons.\n\nSome metaprogramming techniques are used to fuse the SP adjustment into\nthe first stack accessing instruction. Per experimentation with GCC\n16.2.1 and Clang 22.1.8, both the \"generic lambda\" and the\nstd::forward_as_tuple() are elided and inlined linearly into\n{push,pop}Regs().\n\nLink:\n https://lemire.me/blog/2024/04/29/careful-with-pair-of-registers-instructions-on-apple-silicon/\n (\"Careful with Pair-of-Registers instructions on Apple Silicon\")\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328538\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329452\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "fc53e534ad2c8adc8592380a454bf749618a15ab", "git_parents": ["318e49ccdd5c79cee5f7abd67e8ef02529999937"], "node": "bbf58f450f5357a5e5199de1d9b9ca2f4d64ab54", "parents": ["bb0e4e14ddedf1762217857076c347b32dca01e3"], "tags": []}], "date": 1790556240, "git_changesets": ["fc53e534ad2c8adc8592380a454bf749618a15ab"], "user": "dsmith@mozilla.com"}, "28701": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068421 - Make crash helper message reception more robust on Windows  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326105\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329188\n", "files": ["toolkit/crashreporter/crash_helper_common/src/ipc_queue.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_queue/windows.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs"], "git_node": "c0abbf0b4749fd244d2dc33bbfcd3ea260f950a5", "git_parents": ["fc53e534ad2c8adc8592380a454bf749618a15ab"], "node": "38881b142b786aef748089d141448a8bc7684d4c", "parents": ["bbf58f450f5357a5e5199de1d9b9ca2f4d64ab54"], "tags": []}], "date": 1790556487, "git_changesets": ["c0abbf0b4749fd244d2dc33bbfcd3ea260f950a5"], "user": "dsmith@mozilla.com"}, "28702": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073838 - Keep the urlbar view closed when a search mode query has no results and no one-offs to show.  a=diannaS\n\npromiseSearchComplete no longer waits for the view to open, since a query without results now leaves it closed.\n\nUrlbarSearchOneOffs now invalidates its cache when the scotchBonnet one-off prefs change, since willHide() depends on them.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327663\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329076\n", "files": ["browser/base/content/test/browser-menubar/browser_search_bookmarks.js", "browser/base/content/test/browser-menubar/browser_search_history.js", "browser/components/urlbar/UrlbarSearchOneOffs.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_popover_state.js", "browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js", "browser/components/urlbar/tests/browser-search/browser_search_bookmarks_from_bookmarks_menu.js", "browser/components/urlbar/tests/browser-search/browser_search_history_from_history_panel.js", "browser/components/urlbar/tests/browser-searchMode/browser_newWindow.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser/browser_tabKeyBehavior.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchmode.js"], "git_node": "db3daeb23cf6fedb2687510e5693f7e8484648eb", "git_parents": ["c0abbf0b4749fd244d2dc33bbfcd3ea260f950a5"], "node": "2ec020c9c058ad8a500071254332d3dade876a97", "parents": ["38881b142b786aef748089d141448a8bc7684d4c"], "tags": []}], "date": 1790556946, "git_changesets": ["db3daeb23cf6fedb2687510e5693f7e8484648eb"], "user": "dsmith@mozilla.com"}, "28703": {"changesets": [{"author": "mandysGit \u003cmcheang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073145 - Remove Amazon from Remote Settings (search-config-v2 and search-config-overrides-v2).  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326989\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329349\n", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_searchconfig.js"], "git_node": "21656719499e4b2d31e17b7532fa2f5f51011854", "git_parents": ["db3daeb23cf6fedb2687510e5693f7e8484648eb"], "node": "fe545d37cf5621a3d641ac221fc4badce302c3f5", "parents": ["2ec020c9c058ad8a500071254332d3dade876a97"], "tags": []}], "date": 1790558085, "git_changesets": ["21656719499e4b2d31e17b7532fa2f5f51011854"], "user": "dsmith@mozilla.com"}, "28704": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings mobile-experiments ct-logs - a=repo-update r=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329499\n", "files": ["mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": "032ca5cda35ad7f3cfc4e912b2a237cae0d7bc7e", "git_parents": ["21656719499e4b2d31e17b7532fa2f5f51011854"], "node": "f427c6cb36ecc5d263fd5bca06fb8eda5393fbb4", "parents": ["fe545d37cf5621a3d641ac221fc4badce302c3f5"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075231 - tell pip not to try and be smart when installing funsize deps r=releng-reviewers,bhearsum, a=dsmith\n\nrequirements.txt already includes the necessary dependencies, no need to\nresolve them again and risk breakage at install time.\n\ngithub3-py depends on pyjwt[crypto], and the pip in debian 12 (23.0.1)\ndoesn't consider the pinned pyjwt==2.14.0 as satisfying that dependency,\nso it picked the latest pyjwt from PyPI instead, which broke when 2.15.0\nwas released as it's not pinned.\n\nRun pip check after the install as an extra safety.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328838\n", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile"], "git_node": "8e7ac2d6b9745d8579505e335977941686790412", "git_parents": ["032ca5cda35ad7f3cfc4e912b2a237cae0d7bc7e"], "node": "b36e8c269b63ca3e9ad1ab6c383b669827c70560", "parents": ["f427c6cb36ecc5d263fd5bca06fb8eda5393fbb4"], "tags": []}], "date": 1790559036, "git_changesets": ["032ca5cda35ad7f3cfc4e912b2a237cae0d7bc7e", "8e7ac2d6b9745d8579505e335977941686790412"], "user": "dsmith@mozilla.com"}, "28705": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pa-rIN/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-bg/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-en-rGB/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-gl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-hsb/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-ia/strings.xml", "mobile/android/android-componen