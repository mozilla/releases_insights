354e403cd6f42d7dcf9b95ed2b8e", "parents": ["0286569ff81e3989d717dee3bd73fb2a1f097339"], "tags": []}], "date": 1790775270, "git_changesets": ["b68ac5ade0292b97f395226d91a92752d2ebdbac"], "user": "ffxbld@lando.moz.tools"}, "28739": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 0286569ff81e3989d717dee3bd73fb2a1f097339 with FIREFOX-ANDROID_158_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9f823fd23fb9457e51151670e9d033acc146b136", "git_parents": ["6245919fd687f267e680bed7120e01889fd20d3f"], "node": "cdf0d78dbd340037ba9ac5c704bf1bba892f9b60", "parents": ["cc596cee87dcb82cb628a80ee6b86447ac675fe2"], "tags": []}], "date": 1790775287, "git_changesets": ["9f823fd23fb9457e51151670e9d033acc146b136"], "user": "ffxbld@lando.moz.tools"}, "28740": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 0286569ff81e3989d717dee3bd73fb2a1f097339 with DEVEDITION_158_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "e29f270fd9b649873347c30925aa4b23a74ed77f", "git_parents": ["9f823fd23fb9457e51151670e9d033acc146b136"], "node": "ce35cdb2f435763feefcd5da388e66fe3964aa45", "parents": ["cdf0d78dbd340037ba9ac5c704bf1bba892f9b60"], "tags": []}], "date": 1790790007, "git_changesets": ["e29f270fd9b649873347c30925aa4b23a74ed77f"], "user": "ffxbld@lando.moz.tools"}, "28741": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 0286569ff81e3989d717dee3bd73fb2a1f097339 with FIREFOX_158_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "63a4619f4d4ac6dd13827bb15d4e5ce10018c2a8", "git_parents": ["e29f270fd9b649873347c30925aa4b23a74ed77f"], "node": "70066e9142f26d889ca61c2ee2278eb6ce84f391", "parents": ["ce35cdb2f435763feefcd5da388e66fe3964aa45"], "tags": []}], "date": 1790792680, "git_changesets": ["63a4619f4d4ac6dd13827bb15d4e5ce10018c2a8"], "user": "ffxbld@lando.moz.tools"}, "28742": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2073788 - Part 1: Keep exposing BrowserParent on discarded WindowGlobalParent,  a=diannaS\n\nThis method was originally guarded behind CanSend() because at the time,\nIPDL actors only held a raw pointer to their Manager() after being torn\ndown. That has since changed, and all Manager() references are now\nowning, even after IPDL actors have been disconnected, so it is now\npossible to keep these methods working later.\n\nThe crash in this bug was caused due to code receiving unexpected values\nwhen accessing process-specific information on a discarded WGP, leading\nto a falsely-detected owning process ID mismatch.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328975\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329742\n", "files": ["dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "18764db21ae4522948dae43c927da74713e7a988", "git_parents": ["b68ac5ade0292b97f395226d91a92752d2ebdbac"], "node": "645dc544475e6d895784eed33e7bfc8a1c7f7d2d", "parents": ["daff62161edc354e403cd6f42d7dcf9b95ed2b8e"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2073788 - Part 2: Directly look up ContentParent in WGP,  a=diannaS\n\nA number of callers were doing unnecessary extra work to look up the\nContentParent via. the BrowserParent in WindowGlobalParent, likely due\nto the getter being added later. Simplify a few of these callers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328976\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329743\n", "files": ["dom/ipc/WindowGlobalParent.cpp"], "git_node": "c7d225563506a90577735b5d60cefb6529b653b4", "git_parents": ["18764db21ae4522948dae43c927da74713e7a988"], "node": "ef6e44f887e3ea0a1a4d5e1e5b2e893020642caf", "parents": ["645dc544475e6d895784eed33e7bfc8a1c7f7d2d"], "tags": []}], "date": 1790797349, "git_changesets": ["18764db21ae4522948dae43c927da74713e7a988", "c7d225563506a90577735b5d60cefb6529b653b4"], "user": "dsmith@mozilla.com"}, "28743": {"changesets": [{"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2073852 Use maximal align for ffmpeg custom get_buffer2() buffer allocator a=diannaS\n\nffmpeg/libavcodec/internal.h defines STRIDE_ALIGN for\navcodec_default_get_buffer2() according to used instructions set.\nThe recent biggest value is 64 for AVX-512.\nWe need to keep our internal align in sync with the biggest value\nto make sure our custom get_buffer2() allocator works with any system\nprovided ffmpeg.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327769\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329879\n", "files": ["dom/media/platforms/ffmpeg/FFmpegUtils.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/test/mochitest.toml", "dom/media/test/test_vp9_buffer_overread.html", "dom/media/test/vp9_256x128.webm", "dom/media/test/vp9_256x128.webm^headers^"], "git_node": "5ef842e57617b8019c3e9420982c518328194775", "git_parents": ["c7d225563506a90577735b5d60cefb6529b653b4"], "node": "825989cb00536ea812b1b9473c98c8a7ad0459d2", "parents": ["ef6e44f887e3ea0a1a4d5e1e5b2e893020642caf"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2074921 - Remove extra space from the empty identity box a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328661\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329817\n", "files": ["browser/themes/shared/identity-block/identity-block.css"], "git_node": "eca3e8a601b45d4180cba9a4d3b90f8c9252c0bb", "git_parents": ["5ef842e57617b8019c3e9420982c518328194775"], "node": "963833b83b23e76f1b709143a2a0321d41537541", "p