[]}], "date": 1791363914, "git_changesets": ["8c171fd9a15602a3c83d83630f6e6335cdbdac9e", "6d5eafaa1aa675c6dbbebe6ea76d34674d215bd5"], "user": "ffxbld@lando.moz.tools"}, "28804": {"changesets": [{"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2077441 - Add ShellService.isDefaultBrowserAsync compatibility wrapper on Beta for Newtab trainhop; a=dsmith\n\nAdd a Promise-returning wrapper around the existing synchronous check on Beta\nto provide the async API required by Newtab trainhop CI tests run against Beta\nbuilds and, after the next merge, Release builds.\n\nThis keeps the affected tests passing until the real implementation from bug\n2074009 reaches those branches through the normal release cycle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331022\n", "files": ["browser/components/shell/ShellService.sys.mjs"], "git_node": "cee8ff828346819c4b2b7bb516b6ca92223888b2", "git_parents": ["6d5eafaa1aa675c6dbbebe6ea76d34674d215bd5"], "node": "5644ef7b8880191bccd5eff9f4250de65a548497", "parents": ["9fc0355fa080566094ba05e9fc59dec5efba2440"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070033 - Don't dispatch the message event when the worker global scope is null. a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330138\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331518\n", "files": ["dom/workers/MessageEventRunnable.cpp"], "git_node": "b269654f611dc46fb191d813d5bbbe6ec4c9586a", "git_parents": ["cee8ff828346819c4b2b7bb516b6ca92223888b2"], "node": "dbde7b8f3e301dccc1de77c42b69464d4a4a0dc0", "parents": ["5644ef7b8880191bccd5eff9f4250de65a548497"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073442 - [devtools] Fix watchedByDevTools propagation when using bfcache back/forward a=dsmith\n\nThe state should only be set when devtools are actually open.\nAlso make sure to set the state back to false to cleanup stale values\nstored for contexts saved in bfcache.\n\nA test covering the crash is added as a devtools browser mochitest\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331030\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331498\n", "files": ["devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_watchedByDevTools_bfcache.js", "docshell/base/CanonicalBrowsingContext.cpp"], "git_node": "d963efc9fee90de768fd18f3dc34e5f172cd0d33", "git_parents": ["b269654f611dc46fb191d813d5bbbe6ec4c9586a"], "node": "45f9989bafaf251bb466620e814360f5c6a8318c", "parents": ["dbde7b8f3e301dccc1de77c42b69464d4a4a0dc0"], "tags": ["DEVEDITION_158_0b5_BUILD1", "DEVEDITION_158_0b5_RELEASE", "FIREFOX-ANDROID_158_0b5_BUILD1", "FIREFOX-ANDROID_158_0b5_RELEASE", "FIREFOX_158_0b5_BUILD1", "FIREFOX_158_0b5_RELEASE"]}], "date": 1791374169, "git_changesets": ["cee8ff828346819c4b2b7bb516b6ca92223888b2", "b269654f611dc46fb191d813d5bbbe6ec4c9586a", "d963efc9fee90de768fd18f3dc34e5f172cd0d33"], "user": "dsmith@mozilla.com"}, "28805": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 45f9989bafaf251bb466620e814360f5c6a8318c with DEVEDITION_158_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "b8736b846c953c0aeaa97c9ef6aa0c385b233519", "git_parents": ["cd09d2d99de78ff442309dbdc2f8b2d6a6ac2d75"], "node": "977a65c81b5acd26d2e8efe8865fc28de74d6ab1", "parents": ["a05738a29ac69ffd5ce04b77577d9c8c65d7e395"], "tags": []}], "date": 1791378340, "git_changesets": ["b8736b846c953c0aeaa97c9ef6aa0c385b233519"], "user": "ffxbld@lando.moz.tools"}, "28806": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 45f9989bafaf251bb466620e814360f5c6a8318c with FIREFOX-ANDROID_158_0b5_BUILD1 a=tagging CLOSED TREE DON