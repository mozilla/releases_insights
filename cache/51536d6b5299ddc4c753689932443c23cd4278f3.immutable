"third_party/application-services/megazords/ios-rust/src/lib.rs", "third_party/application-services/moz.yaml", "third_party/application-services/testing/sync-test/Cargo.toml", "third_party/application-services/testing/sync-test/src/auth.rs", "third_party/application-services/testing/sync-test/src/logins.rs", "third_party/application-services/tools/generate-rust-dashboards/src/component_config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/counter.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/distribution.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/event.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/labeled_counter.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/labeled_distribution.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/rust_component_errors.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/sync.rs", "third_party/application-services/tools/generate-rust-dashboards/src/schema.rs", "third_party/application-services/tools/generate-rust-dashboards/src/sql.rs", "third_party/application-services/tools/generate-rust-dashboards/src/team_config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/util.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/db-crypto/android/src/main/java/mozilla/appservices/db_crypto/db_crypto.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/fxaclient/android/src/main/java/mozilla/appservices/fxaclient/fxa_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/places/android/src/main/java/mozilla/appservices/places/uniffi/places.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/lib.rs", "toolkit/components/uniffi-bindgen-gecko-js/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "838992ff89414348d39e84ca016c00873210e110", "git_parents": ["9db962035c83de91394c935664b103385759bb95"], "node": "ec08183ccc6e83ccbf6f6cbc23100d5b56092db6", "parents": ["92e0402bea1c365a8fa0625ffe4c9ee471c321d4"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070853 - P2. Give build scripts a glean_parser virtualenv on every build r=firefox-build-system-reviewers,sylvestre, a=dsmith\n\nBuilding the application-services megazord fails with \"No module named\nglean_parser\" now that the places component runs its Glean codegen for the host\ntoo: application-services 5ff8ba498eb09c89f494706dd2106274c7e0a1ad (bug 2053207)\ndropped the CARGO_CFG_TARGET_OS android/ios guard around it. rust.mk takes\nGLEAN_PYTHON_VENV_DIR from GRADLE_GLEAN_PARSER_VENV, which\nmobile/android/gradle.configure only sets for Android, so every other build\nexports it empty, and glean-build reads an empty value as a virtualenv path\nrather than as unset.\n\nGLEAN_PARSER_VENV carries that value, the configure virtualenv that has\nglean_parser, for every build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328432\n", "files": ["build/moz.configure/rust.configure", "config/makefiles/rust.mk"], "git_node": "53bafec9333ee03bab625591eac6eb13856e38cb", "git_parents": ["838992ff89414348d39e84ca016c00873210e110"], "node": "e48b7485731f4d4655b5984b15274aee30ec6e25", "parents": ["ec08183ccc6e83ccbf6f6cbc23100d5b56092db6"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070853 - P3. Move logins encryption API to db_crypto r=joschmidt,credential-management-reviewers,android-reviewers,jonalmeida, a=dsmith\n\nThe crypto primitives now live in the db_crypto namespace, so their callers move\nwith them.\n\nDesktop: storage-rust.sys.mjs takes PrimaryPasswordAuthenticator and\nAuthenticationCanceled from RustDbCrypto.sys.mjs. LoginsApiError has an\nAuthenticationCanceled of its own, but getPrimaryPassword has to throw the\nDbCryptoApiError one, because that is what the callback interface declares.\n\nAndroid: the primitives now throw DbCryptoApiException, a separate sealed class\nrather than a subclass of LoginsApiException, so catches that stop matching are\nnot flagged at compile time. LoginsCrypto catches it in isKeyRecoveryNeeded and\nwraps it in createKey and storeKeyAndCanary, keeping db_crypto errors inside the\nkey manager, since SyncableLoginsStorage and its Fenix callers catch only\nLoginsApiException. LoginsCryptoTest covers both paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324942\n", "files": ["mobile/android/android-components/components/service/sync-logins/build.gradle", "mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/LoginsCrypto.kt", "mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/SyncableLoginsStorage.kt", "mobile/android/android-components/components/service/sync-logins/src/test/java/mozilla/components/service/sync/logins/LoginsCryptoTest.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt", "toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "9c14696ca1a6e65af9dbadeb8775c72b89b6d4f0", "git_parents": ["53bafec9333ee03bab625591eac6eb13856e38cb"], "node": "f9bf3c3b26251fb1bb3a4122ade27de2d44ca074", "parents": ["e48b7485731f4d4655b5984b15274aee30ec6e25"], "tags": ["FIREFOX-ANDROID_158_0b1_BUILD1"]}], "date": 1790279238, "git_changesets": ["83899