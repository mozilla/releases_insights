003e", "branch": "tags-unified", "desc": "No bug - Tagging 737ec77d798755890b062aab541a90d6c75afd19 with FIREFOX_157_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ad331bb78a0a06ed470863299034ac1424fa74bf", "git_parents": ["7eb5d82ef1673fc4bbe95c0274e2ccbb3f48550e"], "node": "344d56fe96b7ab9cd39126a29c676a9c87485dae", "parents": ["7dfe00057db0d4afcea6fb86081d5c70d51b8e0c"], "tags": []}], "date": 1791291539, "git_changesets": ["ad331bb78a0a06ed470863299034ac1424fa74bf"], "user": "ffxbld@lando.moz.tools"}, "28791": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073647;  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329143\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330833\n", "files": ["dom/media/webcodecs/AudioData.cpp", "dom/media/webcodecs/EncodedAudioChunk.cpp", "dom/media/webcodecs/ImageDecoder.cpp"], "git_node": "7167d374a355843d48cfb71d9ee2decebb9b628b", "git_parents": ["0ce2e946e58e8a61d35be78f8bbdd1d83c5f6100"], "node": "ad5a8b1d316fcaf8dfdd9a11b7ca2d478d4b8c85", "parents": ["8264627a6001ada921fc3d6c9498e83b85d6ffd3"], "tags": []}], "date": 1791294543, "git_changesets": ["7167d374a355843d48cfb71d9ee2decebb9b628b"], "user": "dsmith@mozilla.com"}, "28792": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076235 - Only handle a pending seek in MediaFormatReader::UpdateReceivedNewData for the tracks being seeked.  a=diannaS\n\nUpdateReceivedNewData skipped the audio track while a video-only seek was\npending, but not the video track while an audio-only seek was pending, such as\nwhen seamless looping rewinds the audio. If video received new data during\nthat seek while it had a decode request outstanding, it hit\nMOZ_ASSERT(!decoder.HasPromise()), and in release builds it would schedule a\nseek it was not part of.\n\nHandle audio-only seeks the same way as video-only seeks, matching what Seek()\nalready asserts for each kind of seek, so that a track that is not being\nseeked falls through to the normal waiting and internal seek handling.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329637\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331234\n", "files": ["dom/media/MediaFormatReader.cpp"], "git_node": "28a60c3ab6837113e9b7bd4594719ec350794f63", "git_parents": ["7167d374a355843d48cfb71d9ee2decebb9b628b"], "node": "ded5db828392fffd5bb5967e2ef191ff965f491b", "parents": ["ad5a8b1d316fcaf8dfdd9a11b7ca2d478d4b8c85"], "tags": []}], "date": 1791306386, "git_changesets": ["28a60c3ab6837113e9b7bd4594719ec350794f63"], "user": "dsmith@mozilla.com"}, "28793": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging dedb41ddf85d96319e7d6d5f45dd5a61986163b3 with FIREFOX_115_43_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "bf61305e82a9e2d64e0ea7be5bbc152cb379a371", "git_parents": ["ad331bb78a0a06ed470863299034ac1424fa74bf"], "node": "bc5f8f06cccc6921ec9806b089783c455a914597", "parents": ["344d56fe96b7ab9cd39126a29c676a9c87485dae"], "tags": []}], "date": 1791307795, "git_changesets": ["bf61305e82a9e2d64e0ea7be5bbc152cb379a371"], "user": "ffxbld@lando.moz.tools"}, "28794": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069729 - Expect PassedNoHardwareEncoder from the sanity test when GPU encoding is off.  a=diannaS\n\nHardware H.264 encoding is only available through the GPU process encoder, which is gated on\nmedia.use-remote-encoder.video.platform and media.gpu-process-encoder. Both default to on only in Nightly, so\non Beta and Release the sanity test correctly reports PassedNoHardwareEncoder.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330917\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331347\n", "files": ["dom/media/test/test_gfx_sanity_gpu.html"], "git_node": "a7a966bd60410836b92abe975d11ae55399f2c08", "git_parents": ["28a60c3ab6837113e9b7bd4594719ec350794f63"], "node": "c07bdbdad50d0c08f2a05286c0bdf19f4b5d9f70", "parents": ["ded5db828392fffd5bb5967e2ef191ff965f491b"], "tags": []}], "date": 1791313012, "git_changesets": ["a7a966bd60410836b92abe975d11ae55399f2c08"], "user": "dsmith@mozilla.com"}, "28795": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3806652efdaccfd958d04803eddd3fdf131cd0cd with FIREFOX_153_5_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "cd09d2d99de78ff442309dbdc2f8b2d6a6ac2d75", "git_parents": ["bf61305e82a9e2d64e0ea7be5bbc152cb379a371"], "node": "a05738a29ac69ffd5ce04b77577d9c8c65d7e395", "parents": ["bc5f8f06cccc6921ec9806b089783c455a914597"], "tags": []}], "date": 1791316822, "git_changesets": ["cd09d2d99de78ff442309dbdc2f8b2d6a6ac2d75"], "user": "ffxbld@lando.moz.tools"}, "28796": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes mobile-experiments mobile-merino-manifest ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331391\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "9f67b61d1a1e6aadf144f0dfc633dd4555288417", "git_parents": ["a7a966bd60410836b92abe975d11ae55399f2c08"], "node": "d7ab4576a80138e3bfc3dc7bc66b55f7f6ac96be", "parents": ["c07bdbdad50d0c08f2a05286c0bdf19f4b5d9f70"], "tags": []}], "date": 1791329695, "git_changesets": ["9f67b61d1a1e6aadf144f0dfc633dd4555288417"], "user": "dsmith@mozilla.com"}, "28797": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077022: Ignore DOM attribute changes before the initial accessibility tree is constructed.  a=diannaS\n\nAfter bug 2051694, UpdateAccessibleOnAttrChange (called by AttributeChanged) calls UpdateDocRoleMapEntry if the role attribute changes on the body or root element.\nA DOM attribute change can occur before the initial accessibility tree is constructed, since tree construction is triggered by the refresh driver.\nIn that case, mContent will still be null, which means we have an ARIA role on an Accessible with no mContent.\nLocalAccessible::ContainerWidget assumes (reasonably) that mContent must be set if there is an ARIA role.\nThus, if a client happened to query the state of a parent process DocAccessible after the role of the body/root mutated but before the tree was constructed, LocalAccessible::ContainerWidget would dereference null.\n\nThe simplest fix would be to have LocalAccessible::ContainerWidget null check mContent.\nHowever, expecting mContent when there is an ARIA role seems like a pretty reasonable assumption and there may be other code that assumes the same.\n\nAnother fix would be to have UpdateDocRoleMapEntry return early if mContent is null.\nIn that case, UpdateRootElement would be called soon thanks to DoInitialUpdate and UpdateDocRoleMapEntry would be called then.\n\nMore generally, though, it really doesn't make sense for AttributeChanged to do anything at all if the tree hasn't been constructed yet.\nIn that case, there's nothing in the tree, so there's nothing to mutate.\nThus, there's no point wasting cycles on checks that will all fail, nor potentially breaking normally reasonable assumptions like the one which triggers this crash.\nSo, AttributeChanged now returns early if the tree hasn't been constructed yet.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330103\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331457\n", "files": ["accessible/generic/DocAccessible.cpp"], "git_node": "805828b9441324a6e18dcdb754376d7da20070e3", "git_parents": ["9f67b61d1a1e6aadf144f0dfc633dd4555288417"], "node": "fa6fda65806c7e086bb99ac8760e152cfefa113a", "parents": ["d7ab4576a80138e3bfc3dc7bc66b55f7f6ac96be"], "tags": []}], "date": 1791339738, "git_changesets": ["805828b9441324a6e18dcdb754376d7da20070e3"], "user": "dsmith@mozilla.com"}, "28798": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068902 - Use __builtin_prefetch for absl::PrefetchToLocalCacheForWrite on x86-64.  a=diannaS\n\nWithout PRFCHW, abseil emits a hard-coded prefetchw on the assumption that CPUs lacking it treat the opcode as\na no-op. 64-bit NetBurst CPUs (Pentium 4 / Xeon family 15) raise #UD instead, crashing protobuf at startup.\nLet the compiler pick the instruction: prefetcht0 by default, prefetchw when the target guarantees it. The\nnon-GNU SSE fallback gets the same treatment. Written in the shape intended for upstream.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330758\n\n(cherry picked from commit 0f49952df11d9d3b4452a01d48e6333bedc9ec2f)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331365\n", "files": ["third_party/abseil-cpp/absl/base/prefetch.h", "third_party/abseil-cpp/moz-patch-stack/0009.patch"], "git_node": "581a19e2b4f8c8bb2e3735c64b7809419f3ec6a0", "git_parents": ["805828b9441324a6e18dcdb754376d7da20070e3"], "node": "96de386c299b8f17a37a6fb2411b0a05c2006ff1", "parents": ["fa6fda65806c7e086bb99ac8760e152cfefa113a"], "tags": []}], "date": 1791339758, "git_changesets": ["581a19e2b4f8c8bb2e3735c64b7809419f3ec6a0"], "user": "dsmith@mozilla.com"}, "28799": {"changesets": [{"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2072545 - Normalize schemeless origins before validating when adding new login through CPM.  a=diannaS\n\n`#addHTTPSPrefix` becomes `#normalizeOrigin`, which writes the prefixed origin to\nboth `originField.value` and `originField.inputEl.value`, then re-evaluates\n`_originInvalid`. If the origin is valid, it drops the warning and returns the\nnormalized string.\n\nCall `#normalizeOrigin` in `onSubmit` in addition to `@change`.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328707\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331381\n", "files": ["toolkit/components/satchel/megalist/content/components/login-form/login-form.mjs", "toolkit/components/satchel/megalist/content/tests/browser/browser_passwords_create_login.js"], "git_node": "cb0a4fa51b00a7ea1fc35124736e4672865a8dd3", "git_parents": ["581a19e2b4f8c8bb2e3735c64b7809419f3ec6a0"], "node": "51de84f294b42bfad039ef39404bbbce554a7577", "parents": ["96de386c299b8f17a37a6fb2411b0a05c2006ff1"], "tags": []}], "date": 1791339789, "git_changesets": ["cb0a4fa51b00a7ea1fc35124736e4672865a8dd3"], "user": "dsmith@mozilla.com"}, "28800": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077088: Gracefully handle races where an iframe embedder has died, but a content process hasn't caught up yet, so the parent process still receives accessibility messages related to the discarded embedder.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330319\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331454\n", "files": ["dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/WindowGlobalParent.cpp"], "git_node": "6b5945a4df7c2c934c1cd4757628ee0b9b1952c3", "git_parents": ["cb0a4fa51b00a7ea1fc35124736e4672865a8dd3"], "node": "a4c60a9abe51f563cba1deefa40e2a1544350efd", "parents": ["51de84f294b42bfad039ef39404bbbce554a7577"], "tags": []}], "date": 1791339818, "git_changesets": ["6b5945a4df7c2c934c1cd4757628ee0b9b1952c3"], "user": "dsmith@mozilla.com"}, "28801": {"changesets": [{"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2077820 - [riscv64] Use `tail` instead of `j` when tail-calling SharedStub.  a=diannaS\n\nThis practice is already adopted by some distros, like Arch Linux RISC-V\nand openRuyi.\n\nLink: https://github.com/felixonmars/archriscv-packages/blob/2662cf75438febc6ea993b5ecd6a2c747e8942bb/firefox/xptcstubs-riscv64-tail.patch\nLink: https://github.com/openRuyi-Project/openRuyi/blob/ef71a3c657919f7fdffe5ce5c7782abbf8d7549a/SPECS/firefox/2000-riscv64-Use-long-tail-jump-for-xptcall-stubs.patch\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330581\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331000\n", "files": ["xpcom/reflect/xptcall/md/unix/xptcstubs_riscv64.cpp"], "git_node": "da6b7fa59644be65b8082c770d915c635377aa80", "git_parents": ["6b5945a4df7c2c934c1cd4757628ee0b9b1952c3"], "node": "b6fcedf85234328c75ecf5b8058262fb6d8ba999", "parents": ["a4c60a9abe51f563cba1deefa40e2a1544350efd"], "tags": []}], "date": 1791339849, "git_changesets": ["da6b7fa59644be65b8082c770d915c635377aa80"], "user": "dsmith@mozilla.com"}, "28802": {"changesets": [{"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072593 - Pass searchText as moz-input-search value in CPM.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329259\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331384\n", "files": ["toolkit/components/satchel/megalist/content/MegalistAlpha.mjs", "toolkit/components/satchel/megalist/content/tests/browser/browser_passwords_filter.js"], "git_node": "bb1f76bcbf1d791a209e0596f8a92ce4e5dfaf01", "git_parents": ["da6b7fa59644be65b8082c770d915c635377aa80"], "node": "10aef7bc4b746e1a2dab6