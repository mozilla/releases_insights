839e2c4197a94f2c"], "tags": []}, {"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057112: Part 2 - Pass child process's module list by section handle r=win-reviewers,gstoll\" a=backout\n\nThis reverts commit 476da53d95d85efbe5b540f5dce3f29b425c72c5.\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPPlatform.h", "mozglue/misc/NativeNt.h", "toolkit/xre/dllservices/ModuleVersionInfo.cpp", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h"], "git_node": "54796c9e999b6d1ba2a2c2b03b81914ed50f8a20", "git_parents": ["1ce4c5f189dd4db0c8b8f1de6f2201c22bf43b43"], "node": "22ba423e97e5e84a510a2e56b5060ccf064f3e10", "parents": ["35f5039c01004c29df6a031d4a0ed997cde59f52"], "tags": []}, {"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057112: Part 1 - Rename ModulePaths to ModuleIdentifiers r=win-reviewers,necko-reviewers,media-playback-reviewers,padenot,gstoll\" a=backout\n\nThis reverts commit 75b4e31ffc30e1c9736965c18f686fa28e10891d.\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPPlatform.cpp", "dom/media/gmp/GMPPlatform.h", "dom/media/gmp/PGMP.ipdl", "dom/media/ipc/PRDD.ipdl", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h"], "git_node": "a20051b20bd72fbf2235692894b127ffab9517f2", "git_parents": ["54796c9e999b6d1ba2a2c2b03b81914ed50f8a20"], "node": "ce77feb48c07c7fb9174b84f2a1c998f2244e8d1", "parents": ["22ba423e97e5e84a510a2e56b5060ccf064f3e10"], "tags": []}], "date": 1790861212, "git_changesets": ["59851e37218ea7c83aba62ab792976489537416d", "1ce4c5f189dd4db0c8b8f1de6f2201c22bf43b43", "54796c9e999b6d1ba2a2c2b03b81914ed50f8a20", "a20051b20bd72fbf2235692894b127ffab9517f2"], "user": "dsmith@mozilla.com"}, "28748": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074160: Insert ref.cast for br_on_cast(_fail). a=dsmith\n\nInserting an MWasmRefCast along the relevant branch of a\nbr_on_cast(_fail) mirrors what you generally have to do if using\nref.test and ref.cast manually, and the presence of an explicit\nref.cast ensures that nothing gets LICM'd above the test. The cast\nitself ends up being a no-op because of our tests-dominating-casts\noptimizations.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329255\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329927\n", "files": ["js/src/jit-test/tests/wasm/gc/ref-gvn.js", "js/src/wasm/WasmIonCompile.cpp"], "git_node": "61c3c61655a6976833e60daeb7341bce9ea3241e", "git_parents": ["a20051b20bd72fbf2235692894b127ffab9517f2"], "node": "e01dc94fef8b43bd97b676f4b781608742c64c52", "parents": ["ce77feb48c07c7fb9174b84f2a1c998f2244e8d1"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076332 - Only restore the backups that the current updater run created. a=dsmith\n\nOn failure, every action restores the backup of its file whenever one exists,\nincluding the actions that never reached Execute. A backup left behind by an\nearlier updater run then puts back an old file next to newer ones. Each action\nnow only restores the backup it created. The backup that a precomplete remove\nshares with the add that follows it is restored by the remove, which rolls back\nlast.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329687\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329938\n", "files": ["toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialStaleBackup.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_service.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "c5fe622c88912a9039ca56cfd16d7910e457bec6", "git_parents": ["61c3c61655a6976833e60daeb7341bce9ea3241e"], "node": "e2526ab652e3167d71c278b3e4383940d6b90d01", "parents": ["e01dc94fef8b43bd97b676f4b781608742c64c52"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068420 - Skip the head sentinel, a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328764\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329940\n", "files": ["gfx/cairo/cairo/src/cairo-boxes-intersect.c", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0052-Bug-2068420-skip-head-sentinel.patch"], "git_node": "5afb718b9b00ec9abf9a0c7a8656c82bcf7b536d", "git_parents": ["c5fe622c88912a9039ca56cfd16d7910e457bec6"], "node": "18e35a74d5a904d6302be266e715775d8e919788", "parents": ["e2526ab652e3167d71c278b3e4383940d6b90d01"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074630 - Tolerate the remote service dying while RemoteManager.createCodec() ends a failed request. a=dsmith\n\nRemoteConnection.unlink() nulls mRemote under a different monitor than\ncreateCodec() holds, so the endRequest() call added by bug 2064678 can hit a\nNullPointerException just like the ones in releaseCodec() and\nonRemoteMediaDrmBridgeReleased(), which already catch it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328281\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330002\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteManager.java"], "git_node": "54828725421186e8632d3391f20c6d6d5e220211", "git_parents": ["5afb718b9b00ec9abf9a0c7a8656c82bcf7b536d"], "node": "eddc661eaaee23996914dc32fafcfabcc4158689", "parents": ["18e35a74d5a904d6302be266e715775d8e919788"], "tags": []}], "date": 1790865313, "git_changesets": ["61c3c61655a6976833e60daeb7341bce9ea3241e", "c5fe622c88912a9039ca56cfd16d7910e457bec6", "5afb718b9b00ec9abf9a0c7a8656c82bcf7b536d", "54828725421186e8632d3391f20c6d6d5e220211"], "user": "dsmith@mozilla.com"}, "28749": {"changesets": [{"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076296 - Add revamped sidebar switcher to the legacy bookmarks panel, and make it accessible from GenAI onboarding.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329839\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329962\n", "files": ["browser/components/genai/chat.css", "browser/components/genai/chat.js", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/components/places/content/bookmarksSidebar.xhtml", "browser/components/places/tests/browser/browser_bookmarks_close_panel.js", "browser/components/sidebar/sidebar-panel-switcher.mjs", "browser/themes/shared/places/sidebar.css"], "git_node": "503d80506003639749f80ecb3033e2ae367e99e5", "git_parents": ["54828725421186e8632d3391f20c6d6d5e220211"], "node": "3bfa74a411879c97c2d2ffee92ba689dc58739a3", "parents": ["eddc661eaaee23996914dc32fafcfabcc4158689"], "tags": []}], "date": 1790883719, "git_changesets": ["503d80506003639749f80ecb3033e2a