ponents/ads-client/src/ffi.rs", "third_party/application-services/components/ads-client/src/ffi/telemetry.rs", "third_party/application-services/components/ads-client/src/lib.rs", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/environment.rs", "third_party/application-services/components/ads-client/src/mars/preflight.rs", "third_party/application-services/components/ads-client/src/shutdown.rs", "third_party/application-services/components/fxa-client/src/auth.rs", "third_party/application-services/components/fxa-client/src/internal/mod.rs", "third_party/application-services/components/fxa-client/src/internal/oauth.rs", "third_party/application-services/components/fxa-client/src/internal/state_manager.rs", "third_party/application-services/components/fxa-client/src/internal/state_persistence.rs", "third_party/application-services/components/fxa-client/src/state_machine/helpers.rs", "third_party/application-services/components/fxa-client/src/state_machine/transitions.rs", "third_party/application-services/components/fxcontainers/Cargo.toml", "third_party/application-services/components/fxcontainers/README.md", "third_party/application-services/components/fxcontainers/android/build.gradle", "third_party/application-services/components/fxcontainers/android/proguard-rules.pro", "third_party/application-services/components/fxcontainers/android/src/main/AndroidManifest.xml", "third_party/application-services/components/fxcontainers/src/container.rs", "third_party/application-services/components/fxcontainers/src/data.rs", "third_party/application-services/components/fxcontainers/src/defaults.rs", "third_party/application-services/components/fxcontainers/src/definitions.rs", "third_party/application-services/components/fxcontainers/src/error.rs", "third_party/application-services/components/fxcontainers/src/format/migrations.rs", "third_party/application-services/components/fxcontainers/sr