illa.com\u003e", "branch": "default", "desc": "Bug 1814418 - don't include android/geckoview builds in esr staging releases. r=releng-reviewers,gbrown a=pascalc\n\nInstead of excluding android builds based on the `project` parameter, use\n`release_type`, which is properly set to e.g. `esr102` by `mach try release`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D168563", "files": ["taskcluster/gecko_taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "84a756cc9aba3d24b60c79ffb9642825be4d27f2", "parents": ["44d5e71c3b2e2bc612772a39a0974a5b5398973a"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D168657", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "ebbf0b072d6a5b4bbb2d919c620b49cea8d83966", "parents": ["84a756cc9aba3d24b60c79ffb9642825be4d27f2"], "tags": []}], "date": 1675353355, "git_changesets": [null, null, null, null], "user": "pchevrel@mozilla.com"}, "166": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1805194 - fix tryselect test for b-linux-gcp alias. a=bustage\n\nOn esr102 we've made b-linux an alias for b-linux-gcp so the test's\nexpectation failed.", "files": ["tools/tryselect/test/test_task_configs.py"], "git_node": null, "git_parents": [null], "node": "9e1e0f8fee049f6c41fbd33bd3905b668b028fc3", "parents": ["ebbf0b072d6a5b4bbb2d919c620b49cea8d83966"], "tags": []}], "date": 1675355621, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "167": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "d