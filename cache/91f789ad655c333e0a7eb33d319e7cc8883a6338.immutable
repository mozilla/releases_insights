s:72939:"{
"lastpushid": 316,
"pushes": {"149": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cff83fd04112a3b0d4091a1982d7219d200f6fa6 with FIREFOX_102_7_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "7a892d0ef0221544ebbf81486fef156cbf2d0a14", "parents": ["cff83fd04112a3b0d4091a1982d7219d200f6fa6"], "tags": []}], "date": 1673285937, "git_changesets": [null], "user": "ffxbld"}, "150": {"changesets": [{"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1805306 - Allow retrieval of compressed config files in final-verification.sh r=jcristau a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D164534", "files": ["tools/update-verify/release/final-verification.sh"], "git_node": null, "git_parents": [null], "node": "5e2076a5269c349ead8014fa5b5590ae52d86c0a", "parents": ["7a892d0ef0221544ebbf81486fef156cbf2d0a14"], "tags": []}], "date": 1673865889, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "151": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "c4b80665cd5f3aaafcd1870d419347c853660a78", "parents": ["5e2076a5269c349ead8014fa5b5590ae52d86c0a"], "tags": []}], "date": 1673880086, "git_changesets": [null], "user": "ffxbld-merge"}, "152": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cff83fd04112a3b0d4091a1982d7219d200f6fa6 with FIREFOX_102_7_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "5a356fd95c86f19962140340dc36653d25a34ea1", "parents": ["c4b80665cd5f3aaafcd1870d419347c853660a78"], "tags": []}], "date": 1673964069, "git_changesets": [null], "user": "ffxbld"}, "153": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167242", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/language-dictionaries.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "474bfd78094be459b1a3c815efe8d40c15ff905d", "parents": ["5a356fd95c86f19962140340dc36653d25a34ea1"], "tags": []}, {"author": "ahochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1769631 - Remove 'U' from 'mode' parameters for various 'open' calls to ensure Python3.11 compatibility r=firefox-build-system-reviewers,glandium a=RyanVM\n\nThe 'U' flag represents \"universal newline\". It has been deprecated\nsince Python3.3. Since then \"universal newline\" is the default when a\nfile is opened in text mode (not bytes). In Python3.11 using the 'U'\nflag throws errors. There should be no harm in removing 'U' from 'open'\neverywhere it is used, and doing allows the use of Python3.11.\n\nFor more reading see: https://docs.python.org/3.11/whatsnew/3.11.html#changes-in-the-python-api\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147721", "files": ["dom/base/usecounters.py", "python/mozbuild/mozbuild/action/process_define_files.py", "python/mozbuild/mozbuild/backend/base.py", "python/mozbuild/mozbuild/preprocessor.py", "python/mozbuild/mozbuild/util.py", "python/mozbuild/mozpack/files.py"], "git_node": null, "git_parents": [null], "node": "1345ee1bfd755138edecc5b8d30773c39b228b5b", "parents": ["474bfd78094be459b1a3c815efe8d40c15ff905d"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1799982 - Remove uses of inline flags from XPIDL regexps. r=xpcom-reviewers,kmag a=RyanVM\n\nApparently the use of these is being turned into an error in Python 3.11.\nFortunately, our uses appears to be rather trivial.\n\nFor t_multilinecomment and t_LCDATA, I dropped the (?s) flag and just\nreplaced the one use of . with (\\n|.). (?s) means DOTALL, which means\nthat dot includes any character, including a newline. Otherwise it means\ndot includes any character except a newline.\n\nI took the new t_singlelinecomment from IPDL's parser.py, so I assume\nit is reasonable enough. t_multilinecomment is also now the same as\nin IPDL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161738", "files": ["xpcom/idl-parser/xpidl/xpidl.py"], "git_node": null, "git_parents": [null], "node": "4217f431016273414aab5c4ccfe37076db352265", "parents": ["1345ee1bfd755138edecc5b8d30773c39b228b5b"], "tags": []}], "date": 1674143301, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "154": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1765416 - disable test_vendor.py on all platforms. r=ahochheiden, a=test-only  DONTBUILD\n\nTest can be reenabled after the migration to Python 3.7+ (bug 1734402) because\nthe fixed Poetry version (1.2.0) has that as minimum requirement.", "files": ["python/mozbuild/mozbuild/test/python.ini"], "git_node": null, "git_parents": [null], "node": "0648fb6ffd0b841ae42a5a9f32538156501286dc", "parents": ["4217f431016273414aab5c4ccfe37076db352265"], "tags": []}], "date": 1674144500, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "155": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1811287 - Change repo-update reviewer to release-managers group. r=releng-reviewers,bhearsum a=NPOTB DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167278", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "dd47c562df3c3b5b32c0d95059135930e98cf876", "parents": ["0648fb6ffd0b841ae42a5a9f32538156501286dc"], "tags": []}], "date": 1674181913, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "156": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167404", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "35e9b18737303c20a40434914adfcddfb0dfe3da", "parents": ["dd47c562df3c3b5b32c0d95059135930e98cf876"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1811296 - Update browser_searchEngine_behaviors.js and test_duckduckgo.js for ESR build. r=Standard8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167291\n\nDepends on D167404", "files": ["browser/components/search/test/browser/browser_searchEngine_behaviors.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_duckduckgo.js"], "git_node": null, "git_parents": [null], "node": "0894b39849454ba4ac9c2d9cc33219f6b6609973", "parents": ["35e9b18737303c20a40434914adfcddfb0dfe3da"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1747145 - Only apply stlport flags to configure compiler executions for target. r=firefox-build-system-reviewers,andi a=RyanVM\n\n(as opposed to host or wasm)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167112", "files": ["build/moz.configure/compilers-util.configure"], "git_node": null, "git_parents": [null], "node": "76878dedfc3833d7c152be3e0b4562377dd6f825", "parents": ["0894b39849454ba4ac9c2d9cc33219f6b6609973"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1747145 - Add more configure checks for the wasm toolchain setup. r=firefox-build-system-reviewers,ahochheiden a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166977", "files": ["build/moz.configure/compilers-util.configure", "toolkit/moz.configure"], "git_node": null, "git_parents": [null], "node": "ecb52b4afec3b0175dd38125c9639fcb0d5e5e44", "parents": ["76878dedfc3833d7c152be3e0b4562377dd6f825"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1810627 - Allow to build without a wasi sysroot. r=firefox-build-system-reviewers,ahochheiden a=RyanVM\n\nOn e.g. Debian unstable, the wasi SDK is available via packages in a\nmultiarch fashion, which doesn't require the --sysroot flag being passed\nto the compiler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166978", "files": ["toolkit/moz.configure"], "git_node": null, "git_parents": [null], "node": "30467f249e3808f1ed350eeaf2c9011d607009c6", "parents": ["ecb52b4afec3b0175dd38125c9639fcb0d5e5e44"], "tags": []}], "date": 1674236864, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "157": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167920", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/password-recipes.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "fc9c3f4145d4deea9527d56596fc36d9d2685f82", "parents": ["30467f249e3808f1ed350eeaf2c9011d607009c6"], "tags": []}, {"author": "Benjamin Beurdouche \u003cbbeurdouche@mozilla.com\u003e", "branch": "default", "desc": "Bug 1809461 - land NSS_3_79_3_RTM, UPGRADE_NSS_RELEASE, r=jschanck a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166448", "files": ["security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/doc/rst/releases/nss_3_79_2.rst", "security/nss/doc/rst/releases/nss_3_79_3.rst", "security/nss/lib/ckfw/builtins/certdata.txt", "security/nss/lib/ckfw/builtins/nssckbi.h", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "3bc4130f05e9b4d9436a275f2f682959d6689cbb", "parents": ["fc9c3f4145d4deea9527d56596fc36d9d2685f82"], "tags": []}, {"author": "Dan Robertson \u003cdrobertson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1488886 - Fix static-analysis warnings. r=botond, a=RyanVM\n\nFix static-analysis warnings in ContentCompositorBridgeParent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D164682", "files": ["gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": null, "git_parents": [null], "node": "b20d393bdf23e072a6fdb568055bda15c9d926a2", "parents": ["3bc4130f05e9b4d9436a275f2f682959d6689cbb"], "tags": []}, {"author": "Dan Robertson \u003cdrobertson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1488886 - AllocPAPZCTreeManager should gracefully fail if APZ is not enabled. r=botond, a=RyanVM\n\nDepends on D164682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D164683", "files": ["dom/ipc/BrowserChild.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": null, "git_parents": [null], "node": "26315bb0a435d0b9dbfa3bfa5ee80f483914847e", "parents": ["b20d393bdf23e072a6fdb568055bda15c9d926a2"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1809218 - Use a more generic element id for search shortcuts. r=Standard8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167385", "files": ["browser/components/search/SearchOneOffs.jsm", "browser/components/search/test/browser/browser_oneOffContextMenu_setDefault.js"], "git_node": null, "git_parents": [null], "node": "4d953c8cbdd674643c32ecd5f3021624a0ab396e", "parents": ["26315bb0a435d0b9dbfa3bfa5ee80f483914847e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1790160 - In MessagePumpForUI for Windows, effectively apply upstream's commit b26918c. r=mossop,ipc-reviewers,gfx-reviewers,nika,nical a=RyanVM\n\nAs MessagePumpForUI is an old fork from Chromium, this patch effectively applies\nthe Chromium patch\nhttps://source.chromium.org/chromium/chromium/src/+/b26918c5ab0da3130b92339f44ebdc4bfee1b351\n\nFor those threads where we use MessagePumpForUI we already have a way of\nstopping the thread and thereby quitting the message loop. At the same time some\napplications may send us unexpected WM_QUIT messages on those threads. Generally\nthe code using the thread is not able to handle this gracefully and we end up\ncrashing.\n\nIn particular there is a correlation between these crashes and certain antivirus\napplications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166432", "files": ["ipc/chromium/src/base/message_pump_win.cc"], "git_node": null, "git_parents": [null], "node": "6d0685a4a1f94e94a1fdf77ba12e194061c77149", "parents": ["4d953c8cbdd674643c32ecd5f3021624a0ab396e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1790160 - In MessagePumpForUI for Windows, effectively apply upstream's commit 6b9a2fa. r=ipc-reviewers,nika a=RyanVM\n\nAs a follow-up to the prior patch, this patch effectively applies upstream's\nhttps://source.chromium.org/chromium/chromium/src/+/6b9a2faf89e9b67fb6cb8d0986c431923f757b98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166521", "files": ["ipc/chromium/src/base/message_pump_win.cc"], "git_node": null, "git_parents": [null], "node": "bc6060d91b93613a66647067396d14ed29f87737", "parents": ["6d0685a4a1f94e94a1fdf77ba12e194061c77149"], "tags": []}], "date": 1674763149, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "158": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1789449 - Adjust clamp order. r=aosmond a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166759", "files": ["gfx/wr/swgl/src/swgl_ext.h"], "git_node": null, "git_parents": [null], "node": "d86cb7ed2a44f53bbdc38366b2de153ab2c66cde", "parents": ["bc6060d91b93613a66647067396d14ed29f87737"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1810536 - Use NS_NewTimerWithCallback to create timer r=necko-reviewers,kershaw a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166941", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/HttpConnectionUDP.h"], "git_node": null, "git_parents": [null], "node": "678b4113ea15e3f86b91b3f8440df5c34b64ca00", "parents": ["d86cb7ed2a44f53bbdc38366b2de153ab2c66cde"], "tags": []}, {"author": "Robert Longson \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 1811464 - Use SVGElement::FromNode more r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167459", "files": ["layout/svg/SVGTextFrame.cpp", "layout/svg/SVGUtils.cpp"], "git_node": null, "git_parents": [null], "node": "53574fbd4e07797ca1a8072711220493d2e83ef6", "parents": ["678b4113ea15e3f86b91b3f8440df5c34b64ca00"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1804564 - Respect aCount better in EncodeInputStream, r=mccr8,necko-reviewers,jesup a=RyanVM\n\nPreviously we'd always read the full stream, but if an aCount lower than\nthe actual size of the stream is provided, we should only encode that\nmany bytes.\n\nThis patch also improves handling of streams shorter than aCount bytes,\nensuring that the generated string is of the correct length.", "files": ["netwerk/test/gtest/TestBase64Stream.cpp", "xpcom/io/Base64.cpp"], "git_node": null, "git_parents": [null], "node": "bcbb5f3892ca30e9f97bb2e13cec87b70e946950", "parents": ["53574fbd4e07797ca1a8072711220493d2e83ef6"], "tags": []}], "date": 1674768688, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "159": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1773830 - Skip browser_searchSingleWordNotification.js on Linux64 due to frequent failures since the GCP migration. a=me DONTBUILD", "files": ["browser/components/urlbar/tests/browser/browser.ini"], "git_node": null, "git_parents": [null], "node": "b579b5d0bff2838e8c3da3cbeb532e349c23d061", "parents": ["bcbb5f3892ca30e9f97bb2e13cec87b70e946950"], "tags": []}], "date": 1674788282, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "160": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1803152, destroy nsFrameLoader asynchronously when destroyed from SessionHistoryEntry's/SHEntrySharedParentState's destructor. r=nika, a=RyanVM", "files": ["docshell/shistory/nsSHEntryShared.cpp", "dom/base/nsFrameLoader.h"], "git_node": null, "git_parents": [null], "node": "f6ccffe5145298761459bf8163523d8a7c9fa4aa", "parents": ["b579b5d0bff2838e8c3da3cbeb532e349c23d061"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1803628, initiate frameloader destroy asynchronously, r=mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166830", "files": ["docshell/shistory/nsSHEntryShared.cpp"], "git_node": null, "git_parents": [null], "node": "fd7ef44a727c41d8997bdbdb4feb2c94a813117d", "parents": ["f6ccffe5145298761459bf8163523d8a7c9fa4aa"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794622; r=smaug, a=RyanVM", "files": ["browser/actors/DOMFullscreenParent.jsm", "docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/chrome-webidl/WindowGlobalActors.webidl", "dom/html/test/browser.ini", "dom/html/test/browser_fullscreen-navigation-race.js", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": null, "git_parents": [null], "node": "6a1323351df3c18ea2cb2939c83bd5cc7439dffb", "parents": ["fd7ef44a727c41d8997bdbdb4feb2c94a813117d"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1810711: Refactor FindErrorInstanceOrPrototype r=jandem a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167105", "files": ["js/src/vm/ErrorObject.cpp"], "git_node": null, "git_parents": [null], "node": "7ecf0a6e9e6e3ea20d0df6ac19853c3b615001ec", "parents": ["6a1323351df3c18ea2cb2939c83bd5cc7439dffb"], "tags": []}], "date": 1674846966, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "161": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1794622 - Fix ESLint warning. a=me DONTBUILD", "files": ["dom/html/test/browser_fullscreen-navigation-race.js"], "git_node": null, "git_parents": [null], "node": "b07b4373ed3f7b392b2457b535c953176491de7b", "parents": ["7ecf0a6e9e6e3ea20d0df6ac19853c3b615001ec"], "tags": []}], "date": 1674852933, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "162": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D168241", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "70c2996e831f730697cc7d878176b7b46363ba53", "parents": ["b07b4373ed3f7b392b2457b535c953176491de7b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1804303 - force update to channel-prefs.js on mac. r=bhearsum a=pascalc\n\nThe channel-prefs.js file is normally excluded from updates, both so QA\ncan edit it for testing, and to enable shipping release candidates to\nthe beta channel.  However, that means any change to the file contents\nwe ship risk invalidating the package's signature for users with\npreexisting installs.  Such a change happened in bug 1576546, so we're\nnow forcing an update to the file on macOS to make sure users get the\ncurrent, correctly signed, contents.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166190", "files": ["tools/update-packaging/common.sh", "tools/update-packaging/make_incremental_update.sh"], "git_node": null, "git_parents": [null], "node": "9918c13156c7cdd473377d6e64b6d4009f7a1801", "parents": ["70c2996e831f730697cc7d878176b7b46363ba53"], "tags": []}], "date": 1675084536, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "163": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1813424 - webcrypto: check decoded key type before using r=jschanck a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D168472", "files": ["dom/crypto/WebCryptoTask.cpp", "dom/crypto/test/test_WebCrypto.html", "dom/crypto/test/test_WebCrypto_ECDSA.html"], "git_node": null, "git_parents": [null], "node": "e31f59bc107f3704b7f1762f2cb8a53b4b0e27c5", "parents": ["9918c13156c7cdd473377d6e64b6d4009f7a1801"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1811852: Clear default DEVMODEW storage on failure, so that we try again next time. r=emilio a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D168110", "files": ["widget/windows/nsPrintSettingsWin.cpp", "widget/windows/nsPrinterWin.cpp"], "git_node": null, "git_parents": [null], "node": "e74b2a8d649e3bfc0345f3c86f2eee02cc45f676", "parents": ["e31f59bc107f3704b7f1762f2cb8a53b4b0e27c5"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1809923, r=Gijs a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167953", "files": ["uriloader/exthandler/nsExternalHelperAppService.cpp"], "git_node": null, "git_parents": [null], "node": "3c7d9f78fb64026aeb9d55d3657246063fa5369e", "parents": ["e74b2a8d649e3bfc0345f3c86f2eee02cc45f676"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "d