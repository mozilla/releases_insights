0 - Be a bit more conservative about whether directories are readable. a=diannaS\" for causing bustages in nsFilePicker.cpp.\n\nThis reverts commit c1c0f8c158256c302b26d55728f5a7c8015cb5f2.\n", "files": ["dom/ipc/FilePickerParent.cpp", "widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h"], "git_node": "5e065b3b0abe41e9f0cc22a17908c965bbbac40c", "git_parents": ["edae3869acd08ff457881e04a5cc05e1e7cfcc32"], "node": "f35432591c07c3ca8bfd07a7d5f8c206bc5d2e07", "parents": ["183d5fe88a65601f56ebb8649524f13330e0cd67"], "tags": []}], "date": 1791171502, "git_changesets": ["5e065b3b0abe41e9f0cc22a17908c965bbbac40c"], "user": "abutkovits@mozilla.com"}, "1638": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330673\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "1ffbd508ac97528bb062b1f5a3e7842914ff1974", "git_parents": ["5e065b3b0abe41e9f0cc22a17908c965bbbac40c"], "node": "d27326491fc2ca412d20f7796297ee02bd2cc4c2", "parents": ["f35432591c07c3ca8bfd07a7d5f8c206bc5d2e07"], "tags": []}], "date": 1791198964, "git_changesets": ["1ffbd508ac97528bb062b1f5a3e7842914ff1974"], "user": "dsmith@mozilla.com"}, "1639": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2077390 - Be a bit more conservative about whether directories are readable.  a=diannaS\n\nI think this is the smallest change we can make really. I _think_\non windows we don't do this weird stuff...\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330352\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330434\n", "files": ["dom/ipc/FilePickerParent.cpp", "widget/gtk/nsFilePicker.cpp", "widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h"], "git_node": "92c6ff93470c2e5a43311e21ba47c1ea0f60fd72", "git_parents": ["1ffbd508ac97528bb062b1f5a3e7842914ff1974"], "node": "2a4b71a11b27c4038638bf386f3c325f0e00a832", "parents": ["d27326491fc2ca412d20f7796297ee02bd2cc4c2"], "tags": []}], "date": 1791198990, "git_changesets": ["92c6ff93470c2e5a43311e21ba47c1ea0f60fd72"], "user": "dsmith@mozilla.com"}, "1640": {"changesets": [{"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075998 - Root QueueWithSizes when dequeued  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330015\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330358\n", "files": ["dom/streams/QueueWithSizes.h"], "git_node": "a7743be421957fea3dda3f1d1157c2ba99ec905f", "git_parents": ["92c6ff93470c2e5a43311e21ba47c1ea0f60fd72"], "node": "0ef1bd7479cadb475b163e39707b05f882a64e07", "parents": ["2a4b71a11b27c4038638bf386f3c325f0e00a832"], "tags": []}], "date": 1791226852, "git_changesets": ["a7743be421957fea3dda3f1d1157c2ba99ec905f"], "user": "dsmith@mozilla.com"}, "1641": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029831 - Make CreateBackendIndependentTextureHost return a readable dummy buffer under memory pressure. a=diannaS DONTBUILD\n", "files": ["gfx/layers/composite/TextureHost.cpp"], "git_node": "9a36b77cb5a4b4b77b76cd068f6bf8b360910c16", "git_parents": ["a7743be421957fea3dda3f1d1157c2ba99ec905f"], "node": "8a91621a489c1cacd29f5eecae2099a71c85bd4a", "parents": ["0ef1bd7479cadb475b163e39707b05f882a64e07"], "tags": []}], "date": 1791227366, "git_changesets": ["9a36b77cb5a4b4b77b76cd068f6bf8b360910c16"], "user": "dsmith@mozilla.com"}, "1642": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076269 part 1 - Ensure the default array shape exists for MIR ops depending on this.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330003\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330745\n", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/WarpOracle.cpp"], "git_node": "9a16f1ec48843002210debcf4adf8a4c9ef9f5d7", "git_parents": ["9a36b77cb5a4b4b77b76cd068f6bf8b360910c16"], "node": "4023bcf16806396798c4b17fbe4203096df5fc98", "parents": ["8a91621a489c1cacd29f5eecae2099a71c85bd4a"], "tags": []}], "date": 1791227862, "git_changesets": ["9a16f1ec48843002210debcf4adf8a4c9ef9f5d7"], "user": "dsmith@mozilla.com"}, "1643": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077980 - Don't throw an error when setting nsIFilePicker.displayDirectory to a non-readable directory;  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330619\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330748\n", "files": ["widget/nsBaseFilePicker.cpp"], "git_node": "2d12e217ad0abd7a08e0b8337d845b663770b244", "git_parents": ["9a16f1ec48843002210debcf4adf8a4c9ef9f5d7"], "node": "b85703fd97f97352378284eff00e55ea092d27f9", "parents": ["4023bcf16806396798c4b17fbe4203096df5fc98"], "tags": []}], "date": 1791240314, "git_changesets": ["2d12e217ad0abd7a08e0b8337d845b663770b244"], "user": "dsmith@mozilla.com"}, "1644": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074632: Invalidate Ion when a pure DOM call reallocates the global's slots  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329341\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330540\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/CodeGenerator.h", "js/src/jit/Ion.cpp", "js/src/jit/JitRuntime.h", "js/src/vm/Interpreter.cpp", "js/src/vm/NativeObject.cpp"], "git_node": "947148ef84c2053c6f86debca4972a3f26127561", "git_parents": ["2d12e217ad0abd7a08e0b8337d845b663770b244"], "node": "ddaf563d7466a10232930427ab1894505dc03585", "parents": ["b85703fd97f97352378284eff00e55ea092d27f9"], "tags": []}], "date": 1791240931, "git_changesets": ["947148ef84c2053c6f86debca4972a3f26127561"], "user": "dsmith@mozilla.com"}, "1645": {"changesets": [{"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 1983736 - Patch jsonschema to work with Python 3.14+  a=diannaS\n\n(cherry picked from commit b09b27487e5d / bug 1983736)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262335\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330878\n", "files": ["python/mozbuild/mozbuild/vendor/vendor_python.py", "third_party/python/jsonschema/jsonschema/validators.py"], "git_node": "31ba7d7b939dd5b7f4d660a9966c5b45c4c98277", "git_parents": ["947148ef84c2053c6f86debca4972a3f26127561"], "node": "95dce12a782f4842e10d7300410bc03bc62d5a64", "parents": ["ddaf563d7466a10232930427ab1894505dc03585"], "tags": []}, {"author": "Filipe La\u00edns \u003clains@riseup.net\u003e", "branch": "default", "desc": "Bug 1935621 - Fix virtual environment sysconfig path calculation  a=diannaS\n\n(cherry picked from commit 8742bd387623 / bug 1935621)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D231480\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330879\n", "files": ["python/mach/mach/site.py"], "git_node": "120eeee495189a20c35ffe1a44c8e83fe16799c1", "git_parents": ["31ba7d7b939dd5b7f4d660a9966c5b45c4c98277"], "node": "15a9990a47ffc28d07bd42f179cd6ab6ff45f557", "parents": ["95dce12a782f4842e10d7300410bc03bc62d5a64"], "tags": []}, {"author": "Jesse Schwartzentruber \u003ctruber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053518 - Handle the *-oe-linux-* rust targets added in rustc 1.98 in rust target detection.  a=diannaS\n\n(cherry picked from commit 1ecaa12836a6, bug 2053518)\n\nChanges to apply on esr115:\n * rust.configure: dropped the wasm32-wasip1 context hunk, which esr115\n   doesn't have; only the vendor correlation was added.\n * test_toolchain_configure.py: added the 1.98 target list after esr115's\n   version-gated target lists, and dropped the riscv64gc test case, which\n   relies on target-list changes that aren't on esr115.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311145\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330880\n", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "204a5e2e4c898b7874640b6f2754d3e836a48cd3", "git_parents": ["120eeee495189a20c35ffe1a44c8e83fe16799c1"], "node": "d65b3e69679fa4092fba6ee5983f7caacd59ebd6", "parents": ["15a9990a47ffc28d07bd42f179cd6ab6ff45f557"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1969769 - Change uses of ast.Str with ast.Constant.  a=diannaS\n\nast.Str was deprecated in python 3.12 and removed in 3.14. It inherited\nfrom ast.Constant, `Str.s` was equivalent to `Constant.value`, so we can\nuse the latter on both old and newer python versions.\n\n(cherry picked from commit d497aa4f770c, bug 1969769)\n\nChanges to apply on esr115:\n * reader.py: dropped the ast.Attribute branch from the conflicting hunk,\n   which comes from a later change not on esr115.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D261512\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330881\n", "files": ["python/mozbuild/mozbuild/frontend/reader.py", "python/mozbuild/mozbuild/vendor/rewrite_mozbuild.py"], "git_node": "f512a2abd4338eba3709ac1a3c44c966acf330e2", "git_parents": ["204a5e2e4c898b7874640b6f2754d3e836a48cd3"], "node": "c5c3f82c14b281422610baa5bb5bcf6393463edf", "parents": ["d65b3e69679fa4092fba6ee5983f7caacd59ebd6"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1879464 - Disable -Wshorten-64-to-32 when making implicit-int-conversion an error.  a=diannaS\n\nclang 19 is making -Wshorten-64-to-32 enabled by\n-Wimplicit-int-conversion. This returns to the error level we could\nhandle up to clang 18.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D201194\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330882\n", "files": ["dom/canvas/moz.build", "dom/webgpu/moz.build"], "git_node": "9bb9ba85c286ec633788f9b80a88c454ab4f9936", "git_parents": ["f512a2abd4338eba3709ac1a3c44c966acf330e2"], "node": "52a175c9826830e916b9d05480e209e0b28893ff", "parents": ["c5c3f82c14b281422610baa5bb5bcf6393463edf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078149 - Locally patch bindgen 0.64 to handle modern Clang.  a=diannaS\n\nClang 18+ reports extern \"C\" blocks as CXCursor_LinkageSpec rather than\nCXCursor_UnexposedDecl, so bindgen 0.64 silently skipped everything\ninside them. With libclang 22 this left e.g. the gecko-profiler bindings\nwithout any gecko_profiler_* functions (and thus without the types they\nuse).\n\nStarting with Clang 22, clang_getTypeDeclaration() returns the first\n(possibly forward) declaration instead of the definition, so bindgen\ngenerated empty opaque structs for anything forward-declared before\nbeing defined, like NSS's `typedef struct SECItemStr SECItem;` pattern.\nThis broke neqo-crypto and ohttp.\n\nThis is a backport of the equivalent upstream rust-bindgen fixes rather\nthan cherry-picking the whole bindgen update chain (bug 1836230, bug\n1855631, bug 1670633, bug 1985509, bug 2069639), which touches neqo,\nstyle and other crates.\n\nSince this modifies the vendored crate, add a [patch.crates-io] entry\npointing bindgen to third_party/rust/bindgen (like autocfg), with the\nexisting 0.63-to-0.64 shim patch renamed to bindgen_0_63, and the\ncorresponding Cargo.lock and supply-chain policy updates, as main does\nsince bug 1894093.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330883\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/bindgen/.cargo-checksum.json", "third_party/rust/bindgen/clang.rs", "third_party/rust/bindgen/ir/item.rs"], "git_node": "1108e5817ec41f133baa4a1c1ed671b0cece777b", "git_parents": ["9bb9ba85c286ec633788f9b80a88c454ab4f9936"], "node": "07b0750337deba3613b3720d9c67b697218c6587", "parents": ["52a175c9826830e916b9d05480e209e0b28893ff"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1954003 - Fix new implicit-int-conversion warnings from clang 21.  a=diannaS\n\n/builds/worker/workspace/obj-build/dist/include/js/Conversions.h:364:70: error: implicit conversion loses integer precision: 'int' to 'unsigned char' [-Werror,-Wimplicit-int-conversion]\n  364 |   return (bits & mozilla::FloatingPoint\u003cdouble\u003e::kSignBit) ? ~result + 1\n      |   ~~~~~~                                                     ~~~~~~~~^~~\n/builds/worker/workspace/obj-build/dist/include/js/Conversions.h:544:42: note: in instantiation of function template specialization 'JS::ToUnsignedInteger\u003cunsigned char\u003e' requested here\n  544 | inline int8_t ToUint8(double d) { return ToUnsignedInteger\u003cuint8_t\u003e(d); }\n      |                                          ^\n/builds/worker/workspace/obj-build/dist/include/js/Conversions.h:364:70: error: implicit conversion loses integer precision: 'int' to 'unsigned short' [-Werror,-Wimplicit-int-conversion]\n  364 |   return (bits & mozilla::FloatingPoint\u003cdouble\u003e::kSignBit) ? ~result + 1\n      |   ~~~~~~                                                     ~~~~~~~~^~~\n/builds/worker/workspace/obj-build/dist/include/js/Conversions.h:549:45: note: in instantiation of function template specialization 'JS::ToUnsignedInteger\u003cunsigned short\u003e' requested here\n  549 | inline uint16_t ToUint16(double d) { return ToUnsignedInteger\u003cuint16_t\u003e(d); }\n      |                                             ^\n\n(cherry picked from commit 02f94f3cdc97fc3b2bc4654658230c2d896417ae)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D241584\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330884\n", "files": ["js/public/Conversions.h"], "git_node": "487ddb3c619c4bca442289c11797df20d2fadcbe", "git_parents": ["1108e5817ec41f133baa4a1c1ed671b0cece777b"], "node": "ac42cc33b825e5652561ca4d15e048d365ef0d7e", "parents": ["07b0750337deba3613b3720d9c67b697218c6587"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1894093 - Apply https://github.com/rust-lang/rust-bindgen/pull/2824 to vendored bindgen.  a=diannaS\n\nWithout this, newer libclang reports macro-expanded declarations (e.g. the\nSTYLE_STRUCT-generated Gecko_* functions) as having no file, so bindgen\nfiltered them out as builtins.\n\n(cherry picked from commit f7fff8e764b81f190a5b161154044ca0a0ee5a25)\n\nChanges to apply on esr115:\n * Only the clang.rs hunk (plus the .cargo-checksum.json update) is\n   applied. The Cargo.toml, Cargo.lock and supply-chain changes that\n   switch bindgen to a local path patch were already done in the previous\n   bug 2078149 commit, which patches bindgen 0.64 rather than 0.69.4.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D209112\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330885\n", "files": ["third_party/rust/bindgen/.cargo-checksum.json", "third_party/rust/bindgen/clang.rs"], "git_node": "e4f0a82ec0a11263c309ea1935fa33228e1e3913", "git_parents": ["487ddb3c619c4bca442289c11797df20d2fadcbe"], "node": "a3500fab7eb81ec8fac8048d72781e407c4f1bd2", "parents": ["ac42cc33b825e5652561ca4d15e048d365ef0d7e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078149 - Backport skcms F_from_Half fix for clang 22.  a=diannaS\n\nClang 22 removed __builtin_ia32_vcvtph2ps256. Upstream skcms uses\n__builtin_convertvector on _Float16 for clang \u003e= 15 instead.\n\nThis is the corresponding hunk of gfx/skia/skia/modules/skcms/src/Transform_inl.h\nfrom main's Skia m142 update (Bug 1995837, commit 182595a92fd1), rather than\nthe whole Skia update.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330886\n", "files": ["gfx/skia/skia/modules/skcms/src/Transform_inl.h"], "git_node": "3a6006f64dbc369dece648c4595e1d75e05ce2d5", "git_parents": ["e4f0a82ec0a11263c309ea1935fa33228e1e3913"], "node": "0e54a4c55c44267b0bd6ce00243583a611d8224d", "parents": ["a3500fab7eb81ec8fac8048d72781e407c4f1bd2"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1894423 - Remove unused ExclusiveData move constructor.  a=diannaS\n\nBecause the constructor is actually not used, the compiler used to not\ncomplain about it being broken. Recent changes on clang trunk made it\ncatch this problem without the constructor being used.\n\nAs Mutex doesn't have a move constructor, it's also not only a matter of\nadding the missing underscore to lock.\n\nAs the constructor is never used, just remove it.\n\n(cherry picked from commit f06818478d0ad439a14966ae63b6bbbeedf9acbd)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D209108\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330887\n", "files": ["js/src/threading/ExclusiveData.h"], "git_node": "6c6c4431c5a8700bfde9f7061ed2012c251c23a9", "git_parents": ["3a6006f64dbc369dece648c4595e1d75e05ce2d5"], "node": "747aa986ccfe5b1ecf913974804878c398c8dff6", "parents": ["0e54a4c55c44267b0bd6ce00243583a611d8224d"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1906851 - Use mozbuild.shellutil.quote instead of pipes.quote.  a=diannaS\n\nThe latter was removed in python 3.13, and while it can be replaced with\nshlex, we also have our own version that considers more characters as\nneeding quotes.\n\n(cherry picked from commit 7f975d0f7f6d347f0439d82c7b0b5795467a5046)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225329\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330888\n", "files": ["python/mozbuild/mozbuild/action/node.py"], "git_node": "45862305dc16df3a6d99347f52d6efad6bff0622", "git_parents": ["6c6c4431c5a8700bfde9f7061ed2012c251c23a9"], "node": "8c5f7c8fc39d0dd279b076fe8bf47167405c429b", "parents": ["747aa986ccfe5b1ecf913974804878c398c8dff6"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 1888581 - Copy FontVariation data instead of doing an unsound cast.  a=diannaS\n\n(cherry picked from commit 9aab5a7624fa56feceb2a906abbe0781354a5ff7)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D206567\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330889\n", "files": ["gfx/webrender_bindings/WebRenderTypes.h", "gfx/webrender_bindings/src/bindings.rs"], "git_node": "e9a8068a4d5db9854bad707b4f8e4610020abb1a", "git_parents": ["45862305dc16df3a6d99347f52d6efad6bff0622"], "node": "39d99ff952ddaa3f6e087bab9c9de5941705a00d", "parents": ["8c5f7c8fc39d0dd279b076fe8bf47167405c429b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1877389 - Simplify Servo static atom setup.  a=diannaS\n\nWe hopefully don't hit bug 1517685 again.\n\n(cherry picked from commit 218714d61f603695ce02d8a5e827349f1e57010b)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D199971\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330890\n", "files": ["layout/style/ServoBindings.toml", "layout/style/ServoStyleConstsInlines.h", "servo/components/style/gecko_string_cache/mod.rs", "xpcom/ds/nsGkAtoms.h"], "git_node": "57002b874ccf8de601cd16af70e55c9e3cfa6796", "git_parents": ["e9a8068a4d5db9854bad707b4f8e4610020abb1a"], "node": "160ecedf078738047b87789b607ef268d451d3e5", "parents": ["39d99ff952ddaa3f6e087bab9c9de5941705a00d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1912663 - Fix some build issues with cbindgen 0.27.  a=diannaS\n\nIt updates serde and syn and they are more strict. In particular, syn 2\ndoesn't parse the rust 2015 syntax where try is not a keyword, and serde\nrejects duplicate keys.\n\n(cherry picked from commit 1111b564f7baee42a658353b6e2ad5d6366228ec)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219025\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330891\n", "files": ["servo/components/style_traits/values.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": "373e2c0f3fd283ffb17466e2505e05a7681264e3", "git_parents": ["57002b874ccf8de601cd16af70e55c9e3cfa6796"], "node": "9d83260f7fae2a0d2460901b4a2b562d7d9a8314", "parents": ["160ecedf078738047b87789b607ef268d451d3e5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2046162 - Remove some redundant pub qualifiers.  a=diannaS\n\nThe enum is not public so this doesn't change behavior but a patch I'm\nworking on in cbindgen gets a bit confused with this.\n\n(cherry picked from commit c4aab1ba6aadd6985fcd271679d2118f094ec876)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D305678\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330892\n", "files": ["gfx/wr/webrender/src/texture_cache.rs"], "git_node": "dff12f8eda3dd87cda2a19a6d096a51334a2afe1", "git_parents": ["373e2c0f3fd283ffb17466e2505e05a7681264e3"], "node": "dedb41ddf85d96319e7d6d5f45dd5a61986163b3", "parents": ["9d83260f7fae2a0d2460901b4a2b562d7d9a8314"], "tags": ["FIREFOX_115_43_0esr_BUILD1", "FIREFOX_115_43_0esr_RELEASE"]}], "date": 1791243963, "git_changesets": ["31ba7d7b939dd5b7f4d660a9966c5b45c4c98277", "120eeee495189a20c35ffe1a44c8e83fe16799c1", "204a5e2e4c898b7874640b6f2754d3e836a48cd3", "f512a2abd4338eba3709ac1a3c44c966acf330e2", "9bb9ba85c286ec633788f9b80a88c454ab4f9936", "1108e5817ec41f133baa4a1c1ed671b0cece777b", "487ddb3c619c4bca442289c11797df20d2fadcbe", "e4f0a82ec0a11263c309ea1935fa33228e1e3913", "3a6006f64dbc369dece648c4595e1d75e05ce2d5", "6c6c4431c5a8700bfde9f7061ed2012c251c23a9", "45862305dc16df3a6d99347f52d6efad6bff0622", "e9a8068a4d5db9854bad707b4f8e4610020abb1a", "57002b874ccf8de601cd16af70e55c9e3cfa6796", "373e2c0f3fd283ffb17466e2505e05a7681264e3", "dff12f8eda3dd87cda2a19a6d096a51334a2afe1"], "user": "dsmith@mozilla.com"}}
}";