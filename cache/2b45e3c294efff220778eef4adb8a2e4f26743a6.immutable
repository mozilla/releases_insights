emes/windows/browser.css"], "git_node": "b80838027e1e371b37a5be484af3e47d45da5ac8", "git_parents": ["4ff12a828dca4761d2b640fbf5a89e2a30e70dd2"], "node": "2917f4f013bfb7c785adc2aa3bc10c04bfa94bab", "parents": ["84348ec329befdb06252a9c632fa7507ec034d7a"], "tags": []}], "date": 1790158854, "git_changesets": ["b80838027e1e371b37a5be484af3e47d45da5ac8"], "user": "pchevrel@mozilla.com"}, "28656": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074543 - Use a specific partner code for the Recent Search Widget experiment.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328197\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328257\n", "files": ["toolkit/components/search/ConfigSearchEngine.sys.mjs", "toolkit/components/search/tests/xpcshell/test_getSubmission_partnerCode.js"], "git_node": "5a1b7e0a86a227c515f178c142a3a1eff7a06140", "git_parents": ["b80838027e1e371b37a5be484af3e47d45da5ac8"], "node": "c99c84c9981b1f97d2ce79ebf63aa983386cecf3", "parents": ["2917f4f013bfb7c785adc2aa3bc10c04bfa94bab"], "tags": []}], "date": 1790158978, "git_changesets": ["5a1b7e0a86a227c515f178c142a3a1eff7a06140"], "user": "pchevrel@mozilla.com"}, "28657": {"changesets": [{"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2072895 - clear NonRudeHWND before going fullscreen  a=pascalc\n\nIt seems that the Windows shell only looks at NonRudeHWND when the window\nis resized, so setting it later doesn't seem to have an effect. This\nchange has us set it before the window is resized.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327972\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328456\n", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindowTaskbarConcealer.cpp", "widget/windows/nsWindowTaskbarConcealer.h"], "git_node": "46056a25c157e52da994bef01ae29463aa0dba9a", "git_parents": ["5a1b7e0a86a227c515f1