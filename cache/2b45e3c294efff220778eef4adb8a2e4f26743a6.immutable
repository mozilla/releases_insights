8c1cf8c13155c5\nta -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nte -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nth -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\ntl -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\ntr -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\ntrs -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nuk -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nur -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nuz -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nvi -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nwo -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nxh -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nzam -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nzh-CN -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\nzh-TW -\u003e fd85d46bdf75690659d75088ac8c1cf8c13155c5\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "1fc3768e441d7f3df1ad321d461e95b46716d13a", "git_parents": ["8d433829f5d01f8d8aeebc98aa550c5ccfdd5fc6"], "node": "8f80f2b8951afc1531271179b3e2397ee504b51f", "parents": ["3cdaa9a46a8f36edbf4da40131049804dd7cc00c"], "tags": []}], "date": 1789635916, "git_changesets": ["8d433829f5d01f8d8aeebc98aa550c5ccfdd5fc6", "1fc3768e441d7f3df1ad321d461e95b46716d13a"], "user": "ffxbld@lando.moz.tools"}, "28546": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061691: When validating ranges in DocAccessibleParent::SelectionRanges, check that the start and end accs are HyperTextAccessibles.  a=pascalc\n\nAs noted in the comment in this method, tree and selection updates happen in separate IPDL calls, so it's possible for a client selection query to arrive between them.\nWe work around this by validating the Accessibles and offsets.\nPreviously, we null checked the Accessibles.\nHowever, it's possible (albeit rare) that the same id is reused immediately when an Accessible is destroyed and another one is created.\nIn this case, the id might now be associated with an Accessible that is not a HyperTextAccessible, thus causing a null deref in TextRange::Crop.\nTo fix this, we now check IsHyperText() as well when validating selection ranges.\n\nA cleaner fix would be to remove any selection range that contains an Accessible that is being removed from the RemoteAccessible cache.\nHowever, I worry iterating selection ranges on every single removal could get expensive, especially in the (admittedly rare) case that there are a lot of noncontiguous selection ranges.\nYet another alternative could be to somehow process selection range changes atomically with tree mutations, but I think this would be quite difficult to get right and would likely be plagued by obscure edge cases.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325785\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326353\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "bb62c257236c5d6daecdd3b775f4475c627cd672", "git_parents": ["1fc3768e441d7f3df1ad321d461e95b46716d13a"], "node": "348ea6037af32a7377b4d34beae06651a3d1b71c", "parents": ["8f80f2b8951afc1531271179b3e2397ee504b51f"], "tags": []}], "date": 1789636808, "git_changesets": ["bb62c257236c5d6daecdd3b775f4475c627cd672"], "user": "pchevrel@mozilla.com"}, "28547": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065105 - Warn instead of crashing when ServiceWorkerPrivate::Initialize() fails.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323931\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326446\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp"], "git_node": "14bd3bf957913787f48988395d3bfbf9fa018b2e", "git_parents": ["bb62c257236c5d6daecdd3b775f4475c627cd672"], "node": "f15d3354c8dbe1c162b7ccaeeff1af6420b5f50e", "parents": ["348ea6037af32a7377b4d34beae06651a3d1b71c"], "tags": []}], "date": 1789636834, "git_changesets": ["14bd3bf957913787f48988395d3bfbf9fa018b2e"], "user": "pchevrel@mozilla.com"}, "28548": {"changesets": [{"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2065907 - fix intermittent test failures caused by browser having been set as the default in some cases.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324209\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326043\n", "files": ["browser/components/tests/browser/browser_browserGlue_fxa_client_info_ping.js"], "git_node": "5825547d7aa5eda6ccc1969e6044c0088a582112", "git_parents": ["14bd3bf957913787f48988395d3bfbf9fa018b2e"], "node": "8e9ad82799492d736a1e335a65d1fb4b07e4856e", "parents": ["f15d3354c8dbe1c162b7ccaeeff1af6420b5f50e"], "tags": []}], "date": 1789636858, "git_changesets": ["5825547d7aa5eda6ccc1969e6044c0088a582112"], "user": "pchevrel@mozilla.com"}, "28549": {"changesets": [{"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071002 - Fix toggle color contrast in platform  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325129\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326598\n", "files": ["toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/base/border.tokens.json"], "git_node": "a1dd03989ce7ef202aa0bd0e6bad660323fc3fc9", "git_parents": ["5825547d7aa5eda6ccc1969e6044c0088a582112"], "node": "758fcf0c9293bde2d2758e546284368450fce7d8", "parents": ["8e9ad82799492d736a1e335a65d1fb4b07e4856e"], "tags": []}], "date": 1789636964, "git_changesets": ["a1dd03989ce7ef202aa0bd0e6bad660323fc3fc9"], "user": "pchevrel@mozilla.com"}, "28550": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071695 - build funsize-update-generator image on top of debian12-base.  a=pascalc\n\nUse our own base image instead of pulling from docker hub, to get\nreproducible/snapshotted packages; update from debian 11 to 12.\n\nReplace /home/worker paths with /builds/worker following the base image's $HOME.\n\nUpdate funsize's requirements.txt for python 3.11.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326857\n", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile", "taskcluster/docker/funsize-update-generator/requirements.txt", "taskcluster/docker/funsize-update-generator/runme.sh", "taskcluster/gecko_taskgraph/transforms/partials.py", "taskcluster/kinds/docker-image/kind.yml"], "git_node": "1238a78937eae4c686f77393ebf0e40a625609e2", "git_parents": ["a1dd03989ce7ef202aa0bd0e6bad660323fc3fc9"], "node": "4bcc860b3bfffc090d01d7494bb92d7aea58d373", "parents": ["758fcf0c9293bde2d2758e546284368450fce7d8"], "tags": []}], "date": 1789637265, "git_changesets": ["1238a78937eae4c686f77393ebf0e40a625609e2"], "user": "pchevrel@mozilla.com"}, "28551": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2072044 - Carry the display list normalization offset in i64  a=pascalc\n\nSticky frames subtract their previously applied offset from the\naccumulated offset, and an unconstrained sticky range edge is\nnscoord_MIN / 2, so four nested sticky frames overflowed i32. Such\noffsets are already past MAX_EXACT_AU, so widening loses no exactness.\n\nDo not add a doctype to the crashtest; in standards mode the elements do\nnot nest into four sticky frames.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326316\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326694\n", "files": ["gfx/wr/webrender_api/src/display_list.rs", "layout/painting/crashtests/2072044.html", "layout/painting/crashtests/crashtests.list"], "git_node": "421a1697b5bbac05618abb1504090593dd75be13", "git_parents": ["1238a78937eae4c686f77393ebf0e40a625609e2"], "node": "6d817e18af32146efdb7c85507b7fb64788cdaef", "parents": ["4bcc860b3bfffc090d01d7494bb92d7aea58d373"], "tags": []}], "date": 1789637450, "git_changesets": ["421a1697b5bbac05618abb1504090593dd75be13"], "user": "pchevrel@mozilla.com"}, "28552": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070264 - Guard mFontFace//mFontFace5 members with the font-entry lock.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326447\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326891\n", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "d9844437a306744fea03e0495270250d9818fb3b", "git_parents": ["421a1697b5bbac05618abb1504090593dd75be13"], "node": "87caa6601520ce901184663bcf8392396f3344f5", "parents": ["6d817e18af32146efdb7c85507b7fb64788cdaef"], "tags": []}], "date": 1789646992, "git_changesets": ["d9844437a306744fea03e0495270250d9818fb3b"], "user": "pchevrel@mozilla.com"}, "28553": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067973 - Validate PWebBrowserPersistDocument actor state in the parent process.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324050\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326919\n", "files": ["dom/webbrowserpersist/WebBrowserPersistDocumentParent.cpp", "dom/webbrowserpersist/WebBrowserPersistDocumentParent.h", "dom/webbrowserpersist/WebBrowserPersistResourcesParent.cpp"], "git_node": "53ada026cb38c9c343fd1a65810f95b721486f90", "git_parents": ["d9844437a306744fea03e0495270250d9818fb3b"], "node": "0f834e01fe22c4ff05b569cb9147cf11b5138471", "parents": ["87caa6601520ce901184663bcf8392396f3344f5"], "tags": []}], "date": 1789650182, "git_changesets": ["53ada026cb38c9c343fd1a65810f95b721486f90"], "user": "pchevrel@mozilla.com"}, "28554": {"changesets": [{"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072676 - Enable VPN location secret settings for Beta.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326560\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326683\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt"], "git_node": "d8317fc80b6570e12f1892cf2ca37b8100447635", "git_parents": ["53ada026cb38c9c343fd1a65810f95b721486f90"], "node": "cb9d9fb28a49547dca3c7657cc80b00049fef562", "parents": ["0f834e01fe22c4ff05b569cb9147cf11b5138471"], "tags": []}], "date": 1789654898, "git_changesets": ["d8317fc80b6570e12f1892cf2ca37b8100447635"], "user": "pchevrel@mozilla.com"}, "28555": {"changesets": [{"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2063316: Add tests for CheckCompatibility and download ping generation.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320428\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326912\n", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestCheckCompatibility.cpp", "toolkit/xre/test/gtest/TestDowngradePing.cpp", "toolkit/xre/test/gtest/moz.build"], "git_node": "baee7b13ba3ed0fa6bcf2e434bd25e31de736c6c", "git_parents": ["d8317fc80b6570e12f1892cf2ca37b8100447635"], "node": "d05e63113e97604d82c3007566a19467e4f33c44", "parents": ["cb9d9fb28a49547dca3c7657cc80b00049fef562"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2063316: Record the time of the most recent update in the installation directory.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322904\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326913\n", "files": ["toolkit/mozapps/update/tests/data/