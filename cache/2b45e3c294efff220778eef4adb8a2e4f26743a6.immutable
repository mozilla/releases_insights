es/settings/dumps/security-state/intermediates.json"], "git_node": "b720b44cfae40cf7ee63429dae0febb2649ccf0f", "git_parents": ["48c8d1afd167458ca66a03b3a8e5217c1bcb91fa"], "node": "3daa225ee43689f0cc5da9220012b1aee55718e2", "parents": ["8884bcc755e6c507128c472c0b21ca640eb97f99"], "tags": []}], "date": 1789975118, "git_changesets": ["b720b44cfae40cf7ee63429dae0febb2649ccf0f"], "user": "pchevrel@mozilla.com"}, "28602": {"changesets": [{"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070897 - Return to the build-in VPN settings screen once a location is selected  a=pascalc\n\nSelecting a location in the VPN locations list applied the selected choice but left the user on this screen.\n\n Now the app returns to the built-in VPN settings screen once a location is selected by the user and applied. It pops to `R.id.ipProtectionFragment` destination rather than one entry up using `popBackStack()` so that a double tap can't pop the back stack twice.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325864\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327268\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragmentTest.kt"], "git_node": "9afa1d7ade928ffdfc49d4c3ac782c973c3a3290", "git_parents": ["b720b44cfae40cf7ee63429dae0febb2649ccf0f"], "node": "f5faea85c1fd9f0670ac7df38be2e4a05511f364", "parents": ["3daa225ee43689f0cc5da9220012b1aee55718e2"], "tags": []}], "date": 1789975990, "git_changesets": ["9afa1d7ade928ffdfc49d4c3ac782c973c3a3290"], "user": "pchevrel@mozilla.com"}, "28603": {"changesets": [{"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071380 - Make the bookmarks and notifications toolbars part of the titlebar  a=pascalc\n\nPut the toolbar background/text color back on the #notifications-toolbar\nfor LWTs since they may have low contrast now.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326730\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327370\n", "files": ["browser/components/tabbrowser/content/tab-bar-visibility.js"], "git_node": "404e19b7ea693f5fbaa40f0f0b7ce7ddb7a4507c", "git_parents": ["9afa1d7ade928ffdfc49d4c3ac782c973c3a3290"], "node": "ce842c98723923cb5368358e2a1b6f3f09ba5ae5", "parents": ["f5faea85c1fd9f0670ac7df38be2e4a05511f364"], "tags": []}], "date": 1789976022, "git_changesets": ["404e19b7ea693f5fbaa40f0f0b7ce7ddb7a4507c"], "user": "pchevrel@mozilla.com"}, "28604": {"changesets": [{"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2070482 - Fix enlarged Firefox logo in splash screen when animations disabled  a=pascalc\n\n- Updated the svg's viewBox\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326559\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327387\n", "files": ["browser/components/aboutwelcome/assets/splash-logo.svg"], "git_node": "4dd3753738c57c9e6ed2af29650d898efa6fc80c", "git_parents": ["404e19b7ea693f5fbaa40f0f0b7ce7ddb7a4507c"], "node": "61e8fab678b04eb78dd689fb4f38b5d04bbb515e", "parents": ["ce842c98723923cb5368358e2a1b6f3f09ba5ae5"], "tags": []}], "date": 1789976076, "git_changesets": ["4dd3753738c57c9e6ed2af29650d898efa6fc80c"], "user": "pchevrel@mozilla.com"}, "28605": {"changesets": [{"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2070182 - Fix focus outline in FRO Import Screen dropdown  a=pascalc\n\n- Remove focus outline from inner summary text, add outline to container\n- has() selector required to check the child, but modify the parent\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326301\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327448\n", "files": ["browser/themes/shared/migration/migration-wizard.css"], "git_node": "2b51ba2c1c99e0cd92b769bf4df71a750b8b2928", "git_parents": ["4dd3753738c57c9e6ed2af29650d898efa6fc80c"], "node": "83cd4d89ff506f52b924510d3b2a714e92847a49", "parents": ["61e8fab678b04eb78dd689fb4f38b5d04bbb515e"], "tags": []}], "date": 1789976140, "git_changesets": ["2b51ba2c1c99e0cd92b769bf4df71a750b8b2928"], "user": "pchevrel@mozilla.com"}, "28606": {"changesets": [{"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072756 - Fix moz-toggle colors in HCM with Nova enabled  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327238\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327556\n", "files": ["toolkit/content/widgets/moz-toggle/moz-toggle.nova.tokens.json", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "ff8724a141db0d3bbb5a14c5482edf1d5c2e201e", "git_parents": ["2b51ba2c1c99e0cd92b769bf4df71a750b8b2928"], "node": "cdd0173cd9af53036c4357f8596e7d3b795d30e2", "parents": ["83cd4d89ff506f52b924510d3b2a714e92847a49"], "tags": []}], "date": 1789976195, "git_changesets": ["ff8724a141db0d3bbb5a14c5482edf1d5c2e201e"], "user": "pchevrel@mozilla.com"}, "28607": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072548 - Keep the address bar's results view below the input in a short window.  a=pascalc\n\nThe view in chrome now scrolls when the window is too short for its rows, where it was clipped at the window edge. The view's own `min-height: 0` goes as a no-op: it is `position: fixed`, so `auto` already resolves to 0 there, and its geometry measures the same with either value.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326449\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327656\n", "files": ["browser/components/urlbar/tests/browser-UrlbarView/browser.toml", "browser/components/urlbar/tests/browser-UrlbarView/browser_viewBounds.js", "browser/components/urlbar/tests/browser-newtab/browser_resultMenu.js", "browser/components/urlbar/tests/browser-newtab/browser_viewBounds.js", "browser/themes/shared/urlbar.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "3b2fc03b16a4122cd8fadc6c8a056325c9e12ea5", "git_parents": ["ff8724a141db0d3bbb5a14c5482edf1d5c2e201e"], "node": "8f602497227013158503584850f0345364c3fb26", "parents": ["cdd0173cd9af53036c4357f8596e7d3b795d30e2"], "tags": []}], "date": 1789976270, "git_changesets": ["3b2fc03b16a4122cd8fadc6c8a056325c9e12ea5"], "user": "pchevrel@mozilla.com"}, "28608": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063680 - Destroy CacheIndexRecordWrapper via its refcount  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327689\n", "files": ["netwerk/cache2/CacheIndex.cpp", "netwerk/cache2/CacheIndex.h"], "git_node": "50d0cc91fb76b795bada7e56905be49835c29711", "git_parents": ["3b2fc03b16a4122cd8fadc6c8a056325c9e12ea5"], "node": "00849f5dc57a5184c4365ededc7741e8b01ffa35", "parents": ["8f602497227013158503584850f0345364c3fb26"], "tags": []}], "date": 1789976340, "git_changesets": ["50d0cc91fb76b795bada7e56905be49835c29711"], "user": "pchevrel@mozilla.com"}, "28609": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072467.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327500\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327693\n", "files": ["dom/canvas/OffscreenCan