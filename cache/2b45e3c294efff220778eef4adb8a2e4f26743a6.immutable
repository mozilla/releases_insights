d9df934319115ecd82f9249a\ntr -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\ntrs -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nuk -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nur -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nuz -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nvi -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nwo -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nxh -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nzam -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nzh-CN -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\nzh-TW -\u003e 6fa33d9756f322cad9df934319115ecd82f9249a\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "9d2d11b758a2d9807f3b3288f8b53761a2d4368d", "git_parents": ["59f6872f7661b2d408ae6ae4d2a390e5a3f36c26"], "node": "1c21c8de051bdad69532c3405c3327f9a8b7c99e", "parents": ["023fa61c47712b028c499c61267afb012c0d4031"], "tags": []}], "date": 1789290223, "git_changesets": ["59f6872f7661b2d408ae6ae4d2a390e5a3f36c26", "9d2d11b758a2d9807f3b3288f8b53761a2d4368d"], "user": "ffxbld@lando.moz.tools"}, "28454": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070949: Check for SSSE3, not SSE3, for pshufb  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325073\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325242\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/jit-test/tests/regexp/non-ssse3.js"], "git_node": "78eac8154ff58064d63e86ceb127521895060e53", "git_parents": ["9d2d11b758a2d9807f3b3288f8b53761a2d4368d"], "node": "4a9f3fb69dda0240538fa0c3b9cdcd25bd66d759", "parents": ["1c21c8de051bdad69532c3405c3327f9a8b7c99e"], "tags": []}], "date": 1789295589, "git_changesets": ["78eac8154ff58064d63e86ceb127521895060e53"], "user": "pchevrel@mozilla.com"}, "28455": {"changesets": [{"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054193 - Add functionality to use form history to target low/no SAP searchers.  a=pascalc\n\nGive the stale form-history entry in check_recentSearchCount a safety\nmargin past the recency window, instead of landing exactly on the\n28-day cutoff, since the test's cutoff and the recentSearchCount\ngetter's own Date.now()-based cutoff could land on either side of the\nboundary on loaded/virtualized CI hardware, intermittently counting it\nas recent.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311643\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325569\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "94fd1985108ebaa30b86a8df645a6ea2a4fcee49", "git_parents": ["78eac8154ff58064d63e86ceb127521895060e53"], "node": "68f6001552999ddce55892a1fed20ab75cbef8ad", "parents": ["4a9f3fb69dda0240538fa0c3b9cdcd25bd66d759"], "tags": []}], "date": 1789296636, "git_changesets": ["94fd1985108ebaa30b86a8df645a6ea2a4fcee49"], "user": "pchevrel@mozilla.com"}, "28456": {"changesets": [{"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071073 - Give Smart Window pref-state metrics application lifetime so they report on every ping  a=pascalc\n\nsmart_window.model, smart_window.memories_optin and smart_window.set_default_optin are current-state mirrors of prefs, set once per session in SmartWindowTelemetry.init() and re-set on change by the pref observers. They used the default `ping` lifetime, so the value was cleared after the first metrics ping of a session and was absent from every later ping. Reading any of them off a client's most recent ping reported the `unset` sentinel for most clients that actually have a value.\n\nThis gives all three `lifetime: application`, matching the already-correct smart_window.enabled. `application` clears on restart but init() re-sets the value each session, so it stays current without going stale, and it is now carried on every metrics ping.\n\nThis also closes the updateModelMetric race: because the value now persists rather than being cleared after the first ping, a value that resolves too late for the first ping is still reported on subsequent pings instead of being lost for the whole session.\n\nNote for data stewards: this changes how often these existing metrics are transmitted, not what is collected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325133\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325561\n", "files": ["browser/components/aiwindow/metrics.yaml"], "git_node": "efa18838ac881a5369d611cdae298c2303bce311", "git_parents": ["94fd1985108ebaa30b86a8df645a6ea2a4fcee49"], "node": "fae4a4225613b0028aac906732937c374a8e561c", "parents": ["68f6001552999ddce55892a1fed20ab75cbef8ad"], "tags": []}], "date": 1789296663, "git_changesets": ["efa18838ac881a5369d611cdae298c2303bce311"], "user": "pchevrel@mozilla.com"}, "28457": {"changesets": [{"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070652 - Record Glean events for the Smart Window Firefox Accounts sign-in flow  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325559\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/AIWindowAccountAuth.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_account_auth.js"], "git_node": "95a3aee5cec87b2a1b3b837c6196d919966f8f19", "git_parents": ["efa18838ac881a5369d611cdae298c2303bce311"], "node": "3e413f564a769844a8b7bacd8053e8fc42272da8", "parents": ["fae4a4225613b0028aac906732937c374a8e561c"], "tags": []}], "date": 1789296688, "git_changesets": ["95a3aee5cec87b2a1b3b837c6196d919966f8f19"], "user": "pchevrel@mozilla.com"}, "28458": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2068505 - Inject WebExtension content scripts into Thunderbird's mail-message browsers.  a=pascalc DONTBUILD\n\nIsTabOrExtensionBrowser gates content script injection on the top browsing\ncontext's message manager group. Thunderbird's message pane browser moved from\nthe \"single-page\" group to a new \"mail-message\" group in bug 2058761, which was\nnot on the list, so extensions stopped seeing documents loaded there.\n\nThat browser is what feed messages displayed as \"Full Web Page\" load into, so\nadd-ons like uBlock Origin and Dark Reader lost cosmetic filtering, element\npicking and CSS injection in that view.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324888\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325494\n", "files": ["toolkit/components/extensions/ExtensionPolicyService.cpp"], "git_node": "873f33f6fb32e23f7e9da0c632ce096d824bfe9e", "git_parents": ["95a3aee5cec87b2a1b3b837c6196d919966f8f19"], "node": "c68e4eaadf5849357841ea044dcfa6385f04a7a8", "parents": ["3e413f564a769844a8b7bacd8053e8fc42272da8"], "tags": []}], "date": 1789296750, "git_changesets": ["873f33f6fb32e23f7e9da0c632ce096d824bfe9e"], "user": "pchevrel@mozilla.com"}, "28459": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056841: Validate OriginInfo after lock reacquisition.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323652\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325463\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CanonicalQuotaObject.cpp", "dom/quota/DirtyTrackingAutoLock.cpp", "dom/quota/OriginInfo.cpp"], "git_node": "a0ea83c0bd0f7f01ad24d026358f9a5e294d7208", "git_parents": ["873f33f6fb32e23f7e9da0c632ce096d824bfe9e"], "node": "ab8a85845c2dd9cf7c75015ff4b72dacccdb84b7", "parents": ["c68e4eaadf5849357841ea044dcfa6385f04a7a8"], "tags": []}], "date": 1789296872, "git_changesets": ["a0ea83c0bd0f7f01ad24d026358f9a5e294d7208"], "user": "pchevrel@mozilla.com"}, "28460": {"changesets": [{"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2069644 - Fix non-Nightly CloseHandleWrapper.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325055\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325297\n", "files": ["security/sandbox/chromium-shim/patches/39_change_to_DCHECK_in_CloseHandleWrapper.patch", "security/sandbox/chromium/base/win/scoped_handle_verifier.cc"], "git_node": "688e8c58e8a76e941e21875bfb8961147a590b51", "git_parents": ["a0ea83c0bd0f7f01ad24d026358f9a5e294d7208"], "node": "be2fd39565172bd76403bd87f609508f7b9b5800", "parents": ["ab8a85845c2dd9cf7c75015ff4b72dacccdb84b7"], "tags": []}], "date": 1789297044, "git_changesets": ["688e8c58e8a76e941e21875bfb8961147a590b51"], "user": "pchevrel@mozilla.com"}, "28461": {"changesets": [{"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069350 - Move enough widgets into the navbar in ensureToolbarOverflow to overflow it on every channel  ,mossop  a=pascalc\n\nensureToolbarOverflow() resized the window to kForceOverflowWidthPx and moved\nfour palette widgets into the navbar. That no longer leaves any slack now that\nNova is enabled on all channels (bug 2056186): Nova's chrome is narrower, and\nthe default navbar outside Nightly has one widget fewer, since sidebar-button\nis only placed there when sidebar.revamp is enabled, which is Nightly-only.\nThe navbar then never overflows and callers waiting on its overflowing\nattribute time out. DevEdition escaped this because developer-button takes the\nplace of that missing widget.\n\nMove three more widgets so the helper overflows the narrowest default navbar\nof any channel.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324632\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325179\n", "files": ["browser/components/customizableui/test/head.js"], "git_node": "f0cd7f328f06ab52f131671c7f1f8e9957fb8a81", "git_parents": ["688e8c58e8a76e941e21875bfb8961147a590b51"], "node": "cb1122d487e71d0afb37ab5f269a2831c3c29e0a", "parents": ["be2fd39565172bd76403bd87f609508f7b9b5800"], "tags": []}], "date": 1789297088, "git_changesets": ["f0cd7f328f06ab52f131671c7f1f8e9957fb8a81"], "user": "pchevrel@mozilla.com"}, "28462": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070194 - Give a view in a content process an add-on engine's icon as a data URL.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324323\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325243\n", "files": ["browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser_engineIcon.js"], "git_node": "d62a0629545fc9c6f14cae534513fa1ddf8e52bd", "git_parents": ["f0cd7f328f06ab52f131671c7f1f8e9957fb8a81"], "node": "29a1cd300fee2c14a8f8afa8bcee2a4cc656607e", "parents": ["cb1122d487e71d0afb37ab5f269a2831c3c29e0a"], "tags": []}], "date": 1789297141, "git_changesets": ["d62a0629545fc9c6f14cae534513fa1ddf8e52bd"], "user": "pchevrel@mozilla.com"}, "28463": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070206 - Let only the address bar take its text direction from its value.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324834\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325244\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_rtl.js"], "git_node": "e3e1ec3da309c1f7dcc3376a4df20e1def1874fe", "git_parents": ["d62a0629545fc9c6f14cae534513fa1ddf8e52bd"], "node": "9ec574c9d7345c6b82fa78b8942f3b2d74078fe0", "parents": ["29a1cd300fee2c14a8f8afa8bcee2a4cc656607e"], "tags": []}], "date": 1789297187, "git_changesets": ["e3e1ec3da309c1f7dcc3376a4df20e1def1874fe"], "user": "pchevrel@mozilla.com"}, "28464": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2068430 - Retain HANGUL_SYLLABLE_MARKER when decomposing except Hangul syllables.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324580\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325253\n", "files": ["third_party/rust/icu_collator/src/elements.rs"], "git_node": "dab741737a512db1de9cfdfa5a10c83acf40a9da", "git_parents": ["e3e1ec3da309c1f7dcc3376a4df20e1def1874fe"], "node": "f60605578ca47403807b835841e198debc4119ba", "parents": ["9ec574c9d7345c6b82fa78b8942f3b2d74078fe0"], "tags": []}], "date": 1789297270, "git_changesets": ["dab741737a512db1de9cfdfa5a10c83acf40a9da"], "user": "pchevrel@mozilla.com"}, "28465": {"changesets": [{"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070982 - Keep webpack-cli from switching to a webpack-cli under browser/extensions/newtab/node_modules  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325087\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325255\n", "files": ["browser/extensions/newtab/build-newtab-bundles.py"], "git_node": "300c35eb5857ca5e7b61c0b4a4f176c27e1c818e", "git_parents": ["dab741737a512db1de9cfdfa5a10c83acf40a9da"], "node": "d904e833fae1fda906ebd2cd82e6c402fbc0b33c", "parents": ["f60605578ca47403807b835841e198debc4119ba"], "tags": []}], "date": 1789297320, "git_changesets": ["300c35eb5857ca5e7b61c0b4a4f176c27e1c818e"], "user": "pchevrel@mozilla.com"}, "28466": {"changesets": [{"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2063718 - Implement initial prototype of search newtab widget.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322451\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325316\n", "files": ["browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/docs/telemetry.md", "browser/components/search/metrics.yaml", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.jsx", "browser/extensions/newtab/content-src/components/Widgets/RecentSearches/RecentSearches.jsx", "browser/extensions/newtab/content-src/components/Widgets/RecentSearches/_RecentSearches.scss", "browser/extensions/newtab/content-src/lib/utils.jsx", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/RecentSearchesFeed.sys.mjs", "browser/extensions/newtab/test/jest/common/Reducers.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/RecentSearches.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/unit/lib/PrefsFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_RecentSearchesFeed.js", "browser/locales/en-US/browser/newtab/newtab.ftl", "toolkit/components/search/ConfigSearchEngine.sys.mjs", "toolkit/components/search/tests/xpcshell/test_getSubmission_partnerCode.js"], "git_node": "95ec3ce1a1ba001ff7e3f09c12585e8f9d87edd0", "git_parents": ["300c35eb5857ca5e7b61c0b4a4f176c27e1c818e"], "node": "87002716b9d03c42aaef97d968e2bb1fac01a55f", "parents": ["d904e833fae1fda906ebd2cd82e6c402fbc0b33c"], "tags": []}], "date": 1789299309, "git_changesets": ["95ec3ce1a1ba001ff7e3f09c12585e8f9d87edd0"], "user": "pchevrel@mozilla.com"}, "28467": {"changesets": [{"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066344 - Part 1: Call the theme picker's shown() when a New Tab picker becomes visible  a=pascalc\n\nNew Tab now calls the toolkit theme picker's `shown()` whenever one of\nits pickers comes into view, so the `theme_picker.shown` event is\nrecorded for about:newtab: for the compact picker when the Customize\npanel opens, and for the full picker when the \"See more themes\" subpanel\nopens. The picker element loads lazily, so the call waits for the element\nto be defined and is skipped if the panel has moved on by then, or if the\nFirefox build is too old to have `shown()`.\n\nNote that toolkit's `ThemePickerChild` actor records `shown` at most once\nper document, whichever layout reports first. The Customize panel always\nopens on its root panel, so the compact picker reports first and the full\npicker's event from about:newtab is currently dropped. New Tab still\ncalls `shown()` every time either picker appears, so if toolkit later\nrecords one event per layout, the full picker's events will start\narriving without any change on the New Tab side.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324867\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325366\n", "files": ["browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/lib/theme-picker-shown.mjs", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/theme-picker-shown.test.js", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx"], "git_node": "5ed1f118840fd733ef8be1af83be0a15f2f39a15", "git_parents": ["95ec3ce1a1ba001ff7e3f09c12585e8f9d87edd0"], "node": "27fc1a5f14f6f461fd1705445284acda8b10f1ac", "parents": ["87002716b9d03c42aaef97d968e2bb1fac01a55f"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066344 - Part 2: Track which New Tab customize subpanel is open with a single activeSubpanel value  a=pascalc\n\nRefactor how the customize panel tracks which subpanel is open. Part 3 of\nthis stack adds telemetry for the customize panel, and that telemetry\nneeds one value that names the open subpanel. The Base component now\nholds that value as `activeSubpanel`, so at most one subpanel is open at\na time, and the CustomizeMenu component derives each subpanel's open\nstate and its own styling from `activeSubpanel`. This removes the four\nbooleans and the callback each subpanel used to report its state back\nup. The subpanel props are unchanged.\n\nThis also fixes the panel styling itself as if no subpanel were open\nafter one subpanel replaced another, which Dre noted on D324515.\n\nThe Jest tests for the Base component now cover the new state: opening,\ntoggling and closing subpanels, one subpanel at a time, and the panel\ntaking its styling from the open subpanel. These replace the Enzyme\ntests deleted in this patch.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324868\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325367\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/SectionsMgmtPanel/SectionsMgmtPanel.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ThemesManagementPanel/ThemesManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/content-src/lib/constants.mjs", "browser/extensions/newtab/content-src/lib/theme-picker-shown.mjs", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/SectionsMgmtPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ThemesManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/theme-picker-shown.test.js", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/SectionsMgmtPanel.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx"], "git_node": "83d953790b1f001cc61bd65bd4948d0b2606ddc1", "git_parents": ["5ed1f118840fd733ef8be1af83be0a15f2f39a15"], "node": "0b6d48fd8c6ab07d86132f441f78e76b6baebde4", "parents": ["27fc1a5f14f6f461fd1705445284acda8b10f1ac"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066344 - Part 3: Add telemetry for opening the New Tab customize panel and its subpanels  a=pascalc\n\nRecord in the newtab ping when the Customize panel opens, when one of\nits subpanels opens and which one, and when \"Explore more themes\" is\nclicked in the themes subpanel. The CustomizeMenu component records the\ntwo open events at the point where the panel becomes visible, so every\nway of opening it counts the same way, whether from the customize\nbutton, a message, or the widgets context menu. The \"Explore more\nthemes\" button reports its click as a user event, the way the other\nNew Tab clicks reach the TelemetryFeed module.\n\nThe panel open reuses the `SHOW_PERSONALIZE` user event name, so the\nseven entry points that already sent that event are changed to stop\nsending it. Nothing was listening for the event before this patch, and\nnow that the TelemetryFeed module is aware of it, leaving those\ndispatches in place would count every open twice.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324869\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325368\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/content-src/components/ActivationWindowMessage/ActivationWindowMessage.jsx", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ThemesManagementPanel/ThemesManagementPanel.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/FeatureHighlight/WallpaperFeatureHighlight.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/PersonalizedCard/PersonalizedCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/PromoCard/PromoCard.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/lib/customize-panel-telemetry.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ThemesManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/PromoCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/customize-panel-telemetry.test.js", "browser/extensions/newtab/test/unit/content-src/components/Widgets.test.jsx", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "49d480571c592134ba63b60301a32b62fd26ab37", "git_parents": ["83d953790b1f001cc61bd65bd4948d0b2606ddc1"], "node": "7f5f1ff0e9658f92ccc7beddf5be4718d0d533b4", "parents": ["0b6d48fd8c6ab07d86132f441f78e76b6baebde4"], "tags": []}], "date": 1789299374, "git_changesets": ["5ed1f118840fd733ef8be1af83be0a15f2f39a15", "83d953790b1f001cc61bd65bd4948d0b2606ddc1", "49d480571c592134ba63b60301a32b62fd26ab37"], "user": "pchevrel@mozilla.com"}, "28468": {"changesets": [{"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058886 - Fix screen reader announcement and labeling in theme picker  a=pascalc\n\nThe light/dark/device group in the theme picker had no accessible name for screen readers, and its buttons had their role and selected state on a wrapper element instead of the button that gets focused.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323767\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325397\n", "files": ["toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/tests/widgets/test_segmented_control.html", "toolkit/content/widgets/moz-button/moz-button.mjs", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.mjs", "toolkit/content/widgets/theme-picker/theme-picker.mjs", "toolkit/locales/en-US/toolkit/about/aboutAddons.ftl", "toolkit/locales/en-US/toolkit/global/theme-picker.ftl", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-mode.mjs"], "git_node": "5fe2c7915442d7350d619dfd29ca6af8f65fda38", "git_parents": ["49d480571c592134ba63b60301a32b62fd26ab37"], "node": "6719576edabfdf6a7e0bdafec2df2ad23a10434e", "parents": ["7f5f1ff0e9658f92ccc7beddf5be4718d0d533b4"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064563 - Add explicit test assertion to ensure the expected fluent id is set on the aboutaddons-themes-mode moz-segmented-control element.  a=pascalc\n\nThis patch is adding only an additional test assertion to verify that\nthe aboutaddons-themes-mode moz-segmented-control does have the expected\nfluent id (which is something that the parent patch, D323767, is taking care of).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323037\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325398\n", "files": ["toolkit/mozapps/extensions/test/browser/browser_html_themes_mode.js"], "git_node": "356b19772dceae2ffa208930c60692fe63425619", "git_parents": ["5fe2c7915442d7350d619dfd29ca6af8f65fda38"], "node": "3f5bd8a1b74d55336b318fb00332b7eaa15816a7", "parents": ["6719576edabfdf6a7e0bdafec2df2ad23a10434e"], "tags": []}], "date": 1789299624, "git_changesets": ["5fe2c7915442d7350d619dfd29ca6af8f65fda38", "356b19772dceae2ffa208930c60692fe63425619"], "user": "pchevrel@mozilla.com"}, "28469": {"changesets": [{"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068046 - Ensure avatar background color is set when picking default theme with Nova enabled  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323055\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325400\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_test.js"], "git_node": "a9e452253affff3cb353f84112f57c216cb1433e", "git_parents": ["356b19772dceae2ffa208930c60692fe63425619"], "node": "d45b06148396504b0a8c642aea18f0b5e0e42f2b", "parents": ["3f5bd8a1b74d55336b318fb00332b7eaa15816a7"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068917 - revert to old theme color selection for non-Nova themes  a=pascalc\n\nWe switched how we're selecting theme foreground and background colors to make the profile avatars look the best for Nova specific themes. It turns out this causes contrast issues with some legacy/user generated themes, so this patch adds a check to determine which color selection logic we should follow.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324415\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325401\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs"], "git_node": "180e05e0ce9acea73f59a2db251962779ef5080c", "git_parents": ["a9e452253affff3cb353f84112f57c216cb1433e"], "node": "3a7236d32172cf09a42f38cc66e79b3879539e9d", "parents": ["d45b06148396504b0a8c642aea18f0b5e0e42f2b"], "tags": []}], "date": 1789301863, "git_changesets": ["a9e452253affff3cb353f84112f57c216cb1433e", "180e05e0ce9acea73f59a2db251962779ef5080c"], "user": "pchevrel@mozilla.com"}, "28470": {"changesets": [{"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069519 - Record every theme-picker shown event.  a=pascalc\n\nRemove shared client-side deduplication so every ThemePicker.shown()\ncall records one event with source and layout.\n\nConsumers still decide when a picker is shown. Reporting can aggregate\nrepeated events later.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324461\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325465\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs"], "git_node": "4c09a2fa1985a68ec4c6e24eb0dbed7cae071e59", "git_parents": ["180e05e0ce9acea73f59a2db251962779ef5080c"], "node": "37639b96922c773169757e22f19324f7d4aed87f", "parents": ["3a7236d32172cf09a42f38cc66e79b3879539e9d"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069172 - Record appearance and native-theme changes from the theme picker.  a=pascalc\n\nRecord each appearance and native-theme change with its selected value,\nsource, and layout.\n\nRecord direct updates locally. Record remote updates after the parent\napplies them.\n\nKeep theme selection in ThemesList and preserve its per-source\nattribution.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324462\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325466\n", "files": ["browser/actors/ThemePickerParent.sys.mjs", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_theme_picker.js", "browser/modules/metrics.yaml", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs"], "git_node": "fcde7a23006bc1d32a51c68ae5e2b63ce4b86c5d", "git_parents": ["4c09a2fa1985a68ec4c6e24eb0dbed7cae071e59"], "node": "ffc5fb34bac8d768afe1a43413d2506d245b2a68", "parents": ["37639b96922c773169757e22f19324f7d4aed87f"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069127 - Record theme-picker shown telemetry for Profiles.  a=pascalc\n\nBug 2052547 landed the `theme_picker.shown` event and left each surface\nto add its own caller. Profiles needs that caller so\n`profiles.existing.theme` and `profiles.new.theme` have an impression\ncount to compare against.\n\n`EditProfileCard.maybeRecordThemePickerShown()` records after the Nova\npicker is rendered, initialized, and visible. `NewProfileCard` inherits\nthis flow, so the same logic covers about:newprofile.\n`ThemePickerInitialState` handles readiness completing after visibility,\nwhile `visibilitychange` handles visibility completing after readiness.\nSuccessful recording removes both listeners. A final check after both\nrender waits prevents hidden or disconnected cards and overlapping calls\nfrom recording.\n\nThe visibility check is tab-level rather than viewport-level, which\nkeeps the impression denominator comparable to about:welcome, New Tab,\nand about:addons.\n\nNova renders `theme-picker` independently of legacy `this.themes`. The\nlegacy picker keeps its existing `this.themes` availability check.\n\nThe focused browser test covers active loading, background-tab deferral,\nvisibility changes during rendering, and per-document recording.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324463\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325467\n", "files": ["browser/components/profiles/content/edit-profile-card.mjs", "browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/browser/browser_profiles_theme_picker_shown_telemetry_test.js"], "git_node": "21fbe9b5cc36fafd0d850f47fe25467636deb60f", "git_parents": ["fcde7a23006bc1d32a51c68ae5e2b63ce4b86c5d"], "node": "9c92bc08943def59691c5df0b54563bf3b3953b6", "parents": ["ffc5fb34bac8d768afe1a43413d2506d245b2a68"], "tags": []}], "date": 1789301990, "git_changesets": ["4c09a2fa1985a68ec4c6e24eb0dbed7cae071e59", "fcde7a23006bc1d32a51c68ae5e2b63ce4b86c5d", "21fbe9b5cc36fafd0d850f47fe25467636deb60f"], "user": "pchevrel@mozilla.com"}, "28471": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068375.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325172\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325481\n", "files": ["dom/canvas/CanvasRenderingContextHelper.cpp", "dom/canvas/CanvasRenderingContextHelper.h", "dom/canvas/OffscreenCanvas.h", "dom/html/HTMLCanvasElement.h"], "git_node": "111142084790e1e694f7872ed9e467db57bea98f", "git_parents": ["21fbe9b5cc36fafd0d850f47fe25467636deb60f"], "node": "0ee5ae9ddafefbe4ef9686ad93f398fdda579eb5", "parents": ["9c92bc08943def59691c5df0b54563bf3b3953b6"], "tags": []}], "date": 1789304112, "git_changesets": ["111142084790e1e694f7872ed9e467db57bea98f"], "user": "pchevrel@mozilla.com"}, "28472": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050542.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325138\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325429\n", "files": ["widget/windows/RemoteBackbuffer.cpp"], "git_node": "3ed11a9b74f20f8faeb6b9eb3d233b44bdb6315b", "git_parents": ["111142084790e1e694f7872ed9e467db57bea98f"], "node": "3f1c4fcd39c750c95bf9065556291dd4959954f2", "parents": ["0ee5ae9ddafefbe4ef9686ad93f398fdda579eb5"], "tags": []}], "date": 1789304165, "git_changesets": ["3ed11a9b74f20f8faeb6b9eb3d233b44bdb6315b"], "user": "pchevrel@mozilla.com"}, "28473": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325720\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "711fe05f23afc125bc7b5351df51180f1f9e62e7", "git_parents": ["3ed11a9b74f20f8faeb6b9eb3d233b44bdb6315b"], "node": "67a6eb92b3ead85635b01a5bacae5070680c329c"