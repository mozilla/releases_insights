pplied. This is an expected difference when comparing such a directory to an unpacked target installer, and we must ignore it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327823\n", "files": ["tools/update-verify/release/common/check_updates.sh"], "git_node": "2c91b38c7da5485677f979a1e3989e85cf62a614", "git_parents": ["29ba1976054c597917e1eefff1148df2134c8d73"], "node": "ab61162e65b4df064e566ed27735835493caaad5", "parents": ["6de8244e865b23654fdc83ae35fe8df381039ed3"], "tags": []}], "date": 1790001950, "git_changesets": ["2c91b38c7da5485677f979a1e3989e85cf62a614"], "user": "pchevrel@mozilla.com"}, "28617": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6f2c158dfc7e9693f880fad2510ceb51a158c069 with FIREFOX_156_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ce2e09a162b7ceb8e0104e57b24c7f2ba025fb44", "git_parents": ["d58aa671c2164ce792e93b8bbc7dfa1e15321988"], "node": "04942e09facd1e490c08e2455140fd5cf8eb7fe9", "parents": ["c0376e53c0da35c04483997e56e2b8202ddce026"], "tags": []}], "date": 1790006388, "git_changesets": ["ce2e09a162b7ceb8e0104e57b24c7f2ba025fb44"], "user": "ffxbld@lando.moz.tools"}, "28618": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6f2c158dfc7e9693f880fad2510ceb51a158c069 with FIREFOX-ANDROID_156_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "11b2a005d3189fe650d7dbda3d695207fdd8f3a3", "git_parents": ["ce2e09a162b7ceb8e0104e57b24c7f2ba025fb44"], "node": "2dfb652614ae8730cc9898db55adfe3c4890b1d3", "parents": ["04942e09facd1e490c08e2455140fd5cf8eb7fe9"], "tags": []}], "date": 1790006771, "git_changesets": ["11b2a005d3189fe650d7dbda3d695207fdd8f3a3"], "user": "ffxbld@lando.moz.tools"}, "28619": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 8d2c74d068f2d070e0b3bddda05b005962f972ed with FIREFOX_157_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "daaa9ed3e4594d6b4c0fde405721c896fc847823", "git_parents": ["11b2a005d3189fe650d7dbda3d695207fdd8f3a3"], "node": "bf4099eee1e2428c141277933f8e271c9a836dc0", "parents": ["2dfb652614ae8730cc9898db55adfe3c4890b1d3"], "tags": []}], "date": 1790008652, "git_changesets": ["daaa9ed3e4594d6b4c0fde405721c896fc847823"], "user": "ffxbld@lando.moz.tools"}, "28620": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 8d2c74d068f2d070e0b3bddda05b005962f972ed with DEVEDITION_157_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "8f1b3668151b6badbcb850560515decf44b5a112", "git_parents": ["daaa9ed3e4594d6b4c0fde405721c896fc847823"], "node": "66b3ff5f9c19b465c7cd3aff31332d4d38c90b26", "parents": ["bf4099eee1e2428c141277933f8e271c9a836dc0"], "tags": []}], "date": 1790008802, "git_changesets": ["8f1b3668151b6badbcb850560515decf44b5a112"], "user": "ffxbld@lando.moz.tools"}, "28621": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068340 - Plumb aFromParser through nsXMLContentSink  a=pascalc\n\nThis change ensures that nsXMLContentSink::HandleStartElement properly\npasses through the parser origin.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325403\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327778\n", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xml/nsXMLFragmentContentSink.cpp"], "git_node": "ebbcf01ec5e1ac9377beecbbd86b8f58e2d06e05", "git_parents": ["2c91b38c7da5485677f979a1e3989e85cf62a614"], "node": "b25058a715a11cdb1ea46cd24e23037f7d41c6b9", "parents": ["ab61162e65b4df064e566ed27735835493caaad5"], "tags": []}], "date": 1790014472, "git_changesets": ["ebbcf01ec5e1ac9377beecbbd86b8f58e2d06e05"], "user": "pchevrel@mozilla.com"}, "28622": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068367: Make Cairo _get_bitmap_surface free its tmp buffer.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324784\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325916\n", "files": ["gfx/cairo/cairo/src/cairo-ft-font.c", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0051-Bug-2068367-bitmap-surface-tmp-buffer.patch"], "git_node": "dcced863f9f8b585e93d80b400809ed3127e683c", "git_parents": ["ebbcf01ec5e1ac9377beecbbd86b8f58e2d06e05"], "node": "395156df2cc267ad5626dc189caf33fd4d4adfba", "parents": ["b25058a715a11cdb1ea46cd24e23037f7d41c6b9"], "tags": []}], "date": 1790014537, "git_changesets": ["dcced863f9f8b585e93d80b400809ed3127e683c"], "user": "pchevrel@mozilla.com"}, "28623": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073266 - Recover the stack pointer after the import wrapper's call.  a=pascalc\n\nThe wasm import wrapper reads its instance slot and runs its epilogue at\nframe-pointer-relative offsets computed from framePushed, which assumes the\nstack pointer is unchanged across the call. A callee that ends in a return\ncall collapses frames and can leave the stack pointer elsewhere, so restore\nit from the frame pointer before reading those slots.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327347\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327828\n", "files": ["js/src/wasm/WasmStubs.cpp"], "git_node": "82e427d1a0c7bc5bf5be660baf28c3f4209d48fc", "git_parents": ["dcced863f9f8b585e93d80b400809ed3127e683c"], "node": "bf87d7c761f9606efc4e90e2846e3064e7ea23e0", "parents": ["395156df2cc267ad5626dc189caf33fd4d4adfba"], "tags": []}], "date": 1790015517, "git_changesets": ["82e427d1a0c7bc5bf5be660baf28c3f4209d48fc"], "user": "pchevrel@mozilla.com"}, "28624": {"changesets": [{"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072413 - wasm: Change rooting of throw-stub owner during an exception.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327156\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327820\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2072413.js", "js/src/jit/JitFrames.cpp"], "git_node": "55aaad284606c885f091ac94d3fd69e9773ebfcc", "git_parents": ["82e427d1a0c7bc5bf5be660baf28c3f4209d48fc"], "node": "fea911fb1efa8577d1ea3c4db159743db4be3011", "parents": ["bf87d7c761f9606efc4e90e2846e3064e7ea23e0"], "tags": []}], "date": 1790018989, "git_changesets": ["55aaad284606c885f091ac94d3fd69e9773ebfcc"], "user": "pchevrel@mozilla.com"}, "28625": {"changesets": [{"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073525 - Add UITour.showHome() to navigate to about:home with optional hash  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327381\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327916\n", "files": ["browser/components/uitour/UITour-lib.js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_showNewTab.js"], "git_node": "c33f42f6efbeb14b88024edaa1e56ceb4fe5ad60", "git_parents": ["55aaad284606c885f091ac94d3fd69e9773ebfcc"], "node": "6e47c920b7f78338bb978ea6c9200e8945d128b3", "parents": ["fea911fb1efa8577d1ea3c4db159743db4be3011"], "tags": []}], "date": 1790023839, "git_changesets": ["c33f42f6efbeb14b88024edaa1e56ceb4fe5ad60"], "user": "pchevrel@mozilla.com"}, "28626": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074047 - Measure AsyncShutdown's crash countdown against a clock that stops while the system is suspended.  a=pascalc\n\nSince bug 2065080 the countdown compares ChromeUtils.now() against a\ndeadline. On Windows that clock keeps counting while the machine sleeps,\nand relative timers that expire during sleep fire on wake, so a shutdown\ninterrupted by a suspend crashed on the first beat after resume, naming\nwhatever blocker had not yet had a chance to run. Blockers that give up\non their own after a few seconds, like the native messaging host\ncleanup, showed up this way.\n\nExpose mozglue's AwakeTimeStamp as ChromeUtils.awakeNow() and\nuse it for the countdown, so that, like nsTerminator, it only counts time\nthe system was awake.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327786\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327934\n", "files": ["dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "toolkit/components/asyncshutdown/AsyncShutdown.sys.mjs"], "git_node": "499c706022ce64fa15734a0f1f022a4c0d22cd5f", "git_parents": ["c33f42f6efbeb14b88024edaa1e56ceb4fe5ad60"], "node": "c92c2b0e271c7b0666bee7830737e04be221c3fe", "parents": ["6e47c920b7f78338bb978ea6c9200e8945d128b3"], "tags": []}], "date": 1790023922, "git_changesets": ["499c706022ce64fa15734a0f1f022a4c0d22cd5f"], "user": "pchevrel@mozilla.com"}, "28627": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071912 - part 1: Extract the release promotion artifact mocks in test_actions.py  a=pascalc\n\ntest_release_promotion registered every artifact fetch by hand as a 303 plus a\n200 on the redirect target. Pull that into helpers so the next patch, which adds\nthree more release promotion tests, does not repeat it five more times.\n\nNo behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327754\n", "files": ["taskcluster/gecko_taskgraph/test/test_actions.py"], "git_node": "fccc38ad7e9a4253204762642837f445139f59d8", "git_parents": ["499c706022ce64fa15734a0f1f022a4c0d22cd5f"], "node": "5087a827e33b46c21902d71f09c07545c0a0b6bf", "parents": ["c92c2b0e271c7b0666bee7830737e04be221c3fe"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071912 - part 2: Re-use the partner config resolved by an earlier release phase  a=pascalc\n\nI took a stab at this bug. This is not the fix suggested in the bug. Instead of\npinning a repack-manifests revision, I propose a solution that looks simpler:\nhaving the promote action task to fetch the partner config and downstream phases\nreuse it. Let me know what you think @bhearsum.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327755\n", "files": ["taskcluster/docs/partner-repacks.md", "taskcluster/gecko_taskgraph/actions/release_promotion.py", "taskcluster/gecko_taskgraph/test/test_actions.py"], "git_node": "9b343eee932514d28d8e644ed7de9017463afa40", "git_parents": ["fccc38ad7e9a4253204762642837f445139f59d8"], "node": "3c79205bb744413c4f19ea91b3d4ef989582f3b4", "parents": ["5087a827e33b46c21902d71f09c07545c0a0b6bf"], "tags": []}], "date": 1790024069, "git_changesets": ["fccc38ad7e9a4253204762642837f445139f59d8", "9b343eee932514d28d8e644ed7de9017463afa40"], "user": "pchevrel@mozilla.com"}, "28628": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rMX/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "e054f290daa0ddeefbc116a45acc5399e6e5ca2a", "git_parents": ["9b343eee932514d28d8e644ed7de9017463afa40"], "node": "d2337a900ab40491587bb172ed7653a35a76192c", "parents": ["3c79205bb744413c4f19ea91b3d4ef989582f3b4"], "tags": []}], "dat