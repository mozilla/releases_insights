mobile/android/android-components/components/browser/errorpages/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-dsb/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-en-rGB/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-gl/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hsb/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ia/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-is/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-it/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-iw/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nb-rNO/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nn-rNO/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pt-rPT/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ru/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sr/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sv-rSE/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-zh-rTW/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sr/strings.xml"], "git_node": "8897620075f9fede4a588e9ecdb44399d049b34a", "git_parents": ["a94f6442747b71653a1d184d8e1a1c1d792d0674"], "node": "5589e904e8ade228a108db7fc5d4b972f96d31f5", "parents": ["7d4d1c0f751e6e01f655113eeb651711b3006fb5"], "tags": []}], "date": 1790129790, "git_changesets": ["8897620075f9fede4a588e9ecdb44399d049b34a"], "user": "ffxbld@lando.moz.tools"}, "28647": {"changesets": [{"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057313 - Remove notification dot on VPN toolbar icon -  a=pascalc\n\nRemove trigger for notification dot without removing capability to show the badge for future major releases.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327900\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328168\n", "files": ["browser/app/profile/firefox.js", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_toolbar.js", "browser/components/ipprotection/tests/browser/head.js", "browser/components/ipprotection/tests/xpcshell/test_IPProtectionPanel.js", "toolkit/components/ipprotection/docs/Preferences.md"], "git_node": "5059f5878566668be9a5ee63b8877df7a41c7fe0", "git_parents": ["8897620075f9fede4a588e9ecdb44399d049b34a"], "node": "060efc9f32bc777fd1722bc9ccb6fd086e8e489b", "parents": ["5589e904e8ade228a108db7fc5d4b972f96d31f5"], "tags": []}], "date": 1790145529, "git_changesets": ["5059f5878566668be9a5ee63b8877df7a41c7fe0"], "user": "pchevrel@mozilla.com"}, "28648": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073819: Close the parent's pipe ends when Subprocess fails to launch the child on Unix.  a=pascalc\n\nWhen IOUtils.launchProcess() throws, spawn() disposed only the child's ends of the pipes it had just created. The parent's ends of stdin, stdout, stderr and the exit sentinel stayed open until the worker garbage-collected them, four descriptors per failed launch. An extension that keeps retrying a native messaging host whose launch fails can exhaust the process's descriptors this way. The Windows worker already closes its pipes on failure.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327609\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328240\n", "files": ["toolkit/modules/subprocess/subprocess_unix.worker.js", "toolkit/modules/subprocess/test/xpcshell/test_subprocess.js"], "git_node": "7e64bc8444034a49f36778e0b564197aef29e3e6", "git_parents": ["5059f5878566668be9a5ee63b8877df7a41c7fe0"], "node": "b57b06860089e52774ad31154b2e51041328d0d3", "parents": ["060efc9f32bc777fd1722bc9ccb6fd086e8e489b"], "tags": []}], "date": 1790145555, "git_changesets": ["7e64bc8444034a49f36778e0b564197aef29e3e6"], "user": "pchevrel@mozilla.com"}, "28649": {"changesets": [{"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074273 - Do not upload at all any ohttp-requiring pings that don't satisfy the no-_info-sections rule  a=pascalc\n\nWith the second commit in this stack and bug 2074263, pings like this\nare forbidden from existing.\nThis catches pending pings that are on disk and as-yet-unuploaded.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327927\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328340\n", "files": ["toolkit/components/glean/src/init/viaduct_uploader.rs"], "git_node": "826fa708affd75a57e1ab99c34d0d8c422d0e255", "git_parents": ["7e64bc8444034a49f36778e0b564197aef29e3e6"], "node": "85773d7210d49eb67117d8870eee59e21ac56f4d", "parents": ["b57b06860089e52774ad31154b2e51041328d0d3"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074273 - Do not include _info sections in pings uploaded over OHTTP  a=pascalc\n\nThe included lint only catches Firefox Desktop pings.\nFenix and others will get it in bug 2074263.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327928\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328341\n", "files": ["browser/components/urlbar/pings.yaml", "mobile/android/fenix/app/pings.yaml", "toolkit/components/glean/build_scripts/glean_parser_ext/run_glean_parser.py"], "git_node": "918f2380f26861ed149f0644608bf72480c52593", "git_parents": ["826fa708affd75a57e1ab99c34d0d8c422d0e255"], "node": "07de030fb2a9a36b3907666d918f46cb8b924321", "parents": ["85773d7210d49eb67117d8870eee59e21ac56f4d"], "tags": []}], "date": 1790146418, "git_changesets": ["826fa708affd75a57e1ab99c34d0d8c422d0e255", "918f2380f26861ed149f0644608bf72480c52593"], "user": "pchevrel@mozilla.com"}, "28650": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066778: Android testForceEnabledByPrefSurvivesNewSessionAttach: Wait for focus to check that accessibility is enabled.  a=pascalc\n\nThe root node falls back to class name \"android.webkit.WebView\" even if the session isn't attached yet, so we could falsely proceed as if accessibility was enabled when it wasn't.\nLoad a test page and wait for focus as we do in other tests to avoid this race.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328061\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328394\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "46791a700cd029f2800d3f02da9fcb5c57821d40", "git_parents": ["918f2380f26861ed149f0644608bf72480c52593"], "node": "7c12faf44da9261cfec110d66cf5b87900269201", "parents": ["07de030fb2a9a36b3907666d918f46cb8b924321"], "tags": []}], "date": 1790146510, "git_changesets": ["46791a700cd029f2800d3f02da9fcb5c57821d40"], "user": "pchevrel@mozilla.com"}, "28651": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073268 - Disable hoisting for loops with a generator resume dispatch.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327751\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328385\n", "files": ["js/src/jit/LICM.cpp", "js/src/jit/MIRGraph.cpp", "js/src/jit/MIRGraph.h", "js/src/jit/RangeAnalysis.cpp", "js/src/jit/WarpBuilder.cpp"], "git_node": "a60bdcb66e8428a5222a1abe4247f9520faf7484", "git_parents": ["46791a700cd029f2800d3f02da9fcb5c57821d40"], "node": "3e26f1fd9317d81d489f9dc4b9e55d8b13c280ef", "parents": ["7c12faf44da9261cfec110d66cf5b87900269201"], "tags": []}], "date": 1790146746, "git_changesets": ["a60bdcb66e8428a5222a1abe4247f9520faf7484"], "user": "pchevrel@mozilla.com"}, "