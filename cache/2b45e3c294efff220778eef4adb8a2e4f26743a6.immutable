ug 2059617 [Wayland] Rename session ID to workspace ID  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324870\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325868\n", "files": ["widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "e40633d5432bb39a784a899e8df1560573572fdd", "git_parents": ["c0b5250aefb00b0b36baa29503d9dd2f6226fc6b"], "node": "3f3e4be427c764afaafc8910662e42125bc77a0b", "parents": ["2d38b56f54bdf4e0e78f6ad2a386ab8a444344ea"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2059617 [Wayland] Convert integer workspace id to uuid  a=pascalc\n\nInteger workspace ID causes conflicts on session restore so use uuid everywhere and ignore integer ones to avoid protocol errors.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324871\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325869\n", "files": ["widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "4752c691676c3c82ab8e2f59837e336f9e173fa8", "git_parents": ["e40633d5432bb39a784a899e8df1560573572fdd"], "node": "c99d21b6f34e4712a2139fc0b21b1995b88bfe04", "parents": ["3f3e4be427c764afaafc8910662e42125bc77a0b"], "tags": []}], "date": 1789722724, "git_changesets": ["e40633d5432bb39a784a899e8df1560573572fdd", "4752c691676c3c82ab8e2f59837e336f9e173fa8"], "user": "pchevrel@mozilla.com"}, "28575": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072432 - Use AppendChild instead of AppendChildTo in txMozillaXMLOutput.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326562\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327115\n", "files": ["dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "7a5e8543fe65f07ff596d5b26c77419ded8f8fdd", "git_parents": ["4752c691676c3c82ab8e2f59837e336f9e173fa8"], "node": "d95e0472ee2