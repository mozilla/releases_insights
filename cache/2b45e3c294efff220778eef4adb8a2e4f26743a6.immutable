 10ba62821d6ab833dce1b4aff67cad298a502104\nzam -\u003e 10ba62821d6ab833dce1b4aff67cad298a502104\nzh-CN -\u003e 10ba62821d6ab833dce1b4aff67cad298a502104\nzh-TW -\u003e 10ba62821d6ab833dce1b4aff67cad298a502104\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "0080ee58f72130c34b67cec8df75a5972c33664e", "git_parents": ["6140cfe331c72b41d01d6c18991c160711794166"], "node": "80f62de8382c4e26a670ec7e2003d11954f5befa", "parents": ["56a9da519bb1974c8337fc8270c63818699271c6"], "tags": []}], "date": 1789808710, "git_changesets": ["6140cfe331c72b41d01d6c18991c160711794166", "0080ee58f72130c34b67cec8df75a5972c33664e"], "user": "ffxbld@lando.moz.tools"}, "28596": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072627: If the managing WindowGlobal is no longer current for its BrowsingContext, a received PDocAccessible will die shortly, so just ignore it.  a=dmeehan\n\nWe only ever care about the document for the current WindowGlobal.\nVarious places enforce this, including BrowserBridgeParent::GetDocAccessibleParent.\nPreviously, if a PDocAccessible for an OOP iframe arrived late after the WindowGlobal is no longer current (e.g. due to a process switch), we would try to add it as a child doc, causing a crash because BrowserBridgeParent::GetDocAccessibleParent refuses to return a non-current document.\nTo avoid this, ignore the document early and return, just as we already do for a discarded BrowsingContext.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326814\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327521\n", "files": ["dom/ipc/WindowGlobalParent.cpp"], "git_node": "ced9a8207802571c4efc695ee31dec3ed90a9f3c", "git_parents": ["0080ee58f72130c34b67cec8df75a5972c33664e"], "node": "02268514f1535d042d4e2b5109c99b55283eb190", "parents": ["80f62de8382c4e26a670ec7e2003d11954f5befa"], "tags": []}], "date": 1789827089, "git_changesets": ["ced9a8207802571c4efc695ee31dec3ed90a9f3c"], "user": "dmeehan@mozilla.com"}, "28597": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-is/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/value