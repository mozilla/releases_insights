js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_showNewTab.js"], "git_node": "a9dd6fd1805607ce4d4d45ff0a5db35701f5676b", "git_parents": ["e0b359069612a46049629d59e6760f380b973d61"], "node": "f26741e9cf2afbd35b5c70380e130f917b07b795", "parents": ["4789b0a19fe115e3c1c4fa18106c683513a08238"], "tags": []}], "date": 1789661311, "git_changesets": ["a9dd6fd1805607ce4d4d45ff0a5db35701f5676b"], "user": "pchevrel@mozilla.com"}, "28559": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml"], "git_node": "2dac914cc6344ccbbaf0d3e29768d25ed03f41f0", "git_parents": ["a9dd6fd1805607ce4d4d45ff0a5db35701f5676b"], "node": "a59c030601b22bb2aaf0207e1feccbd03f320ac3", "parents": ["f26741e9cf2afbd35b5c70380e130f917b07b795"], "tags": []}], "date": 1789698127, "git_changesets": ["2dac914cc6344ccbbaf0d3e29768d25ed03f41f0"], "user": "ffxbld@lando.moz.tools"}, "28560": {"changesets": [{"author": "Diego \u003cdiegodaf@gmail.com\u003e", "branch": "default", "desc": "Bug 2068108 - Revert the Ctrl+Shift+Home/End move tab shortcuts from bug 2018728.  a=pascalc\n\nThe shortcuts consume Ctrl+Shift+Home/End before the keydown reaches content,\nwhich breaks web apps that bind that combination. Bug 2071299 reports a web app\nusing it for spreadsheet selection, chosen for its similarity to the text\nediting shortcuts.\n\nAffected sites have no simple workaround. The IMEStatus guard only covers a\nfocused editable field, and content cannot defend itself with preventDefault\nbecause the parent process does not wait for the content process to reply.\n\nThis backs out all of bug 2018728: the ShortcutUtils constants and key\ndetection, the keydown handler cases, and the tests. The handler moved from\ntabbrowser.js to Tabbrowser.sys.mjs after the original patch landed, so that\nhunk is reverted by hand. The other two files revert cleanly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326933\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327207\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tab_move_active_tab.js", "toolkit/modules/ShortcutUtils.sys.mjs"], "git_node": "7ff20f9849e87f216622e693e199c803054a5432", "git_parents": ["2dac914cc6344ccbbaf0d3e29768d25ed03f41f0"], "node": "5984774274873726db165aa6e18ec8b1b7a7f970", "parents": ["a59c030601b22bb2aaf0207e1feccbd03f320ac3"], "tags": []}], "date": 1789714888, "git_changesets": ["7ff20f9849e87f216622e693e199c803054a5432"], "user": "pchevrel@mozilla.com"}, "28561": {"changesets": [{"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069497 - Update the Nova light/dark theme with latest design  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324837\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327139\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/browser-shared.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/components/sidebar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "678e7440c53eec2b79fe3f04908b7fff623684f5", "git_parents": ["7ff20f9849e87f216622e693e199c803054a5432"], "node": "88ea69ea6c5fdd5a121b425a7bf3cd59f340de4b", "parents": ["5984774274873726db165aa6e18ec8b1b7a7f970"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070971 - Fix native theme toolbox colors.  a=pascalc\n\nAfter the regressing bug, the nova layer stomps over.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325016\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327140\n", "files": ["browser/themes/shared/browser-colors.css"], "git_node": "f8565f7501e9a68f00939ec16135aa646d36ccd2", "git_parents": ["678e7440c53eec2b79fe3f04908b7fff623684f5"], "node": "1922406b36b7c4e40e4086db6078c9216787fc1d", "parents": ["88ea69ea6c5fdd5a121b425a7bf3cd59f340de4b"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070969 - Fix inactive perf and Nova overrides for nativeTheme  a=pascalc\n\nRegressions from bug 2069497\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325048\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327141\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/browser-shared.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/components/sidebar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "d5f58e833ff56e87a13c3888e8d58e40b53da79a", "git_parents": ["f8565f7501e9a68f00939ec16135aa646d36ccd2"], "node": "150970b21aa19535a234dd049286693161fa53d5", "parents": ["1922406b36b7c4e40e4086db6078c9216787fc1d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070963 - Stop deriving the notification bar's top border from the toolbar separator color.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325586\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327142\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json"], "git_node": "3ca27569dc138e57e1e900d426adfc2e45dcfa03", "git_parents": ["d5f58e833ff56e87a13c3888e8d58e40b53da79a"], "node": "8e34352892da1a286b4b5198fbf858b7ecd0f08c", "parents": ["150970b21aa19535a234dd049286693161fa53d5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071359 - Use input tokens for the new tab search bar.  a=pascalc\n\nThe brand value the input text color gains is the page text color moz-input-text already inherited in-content.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325585\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327143\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_inputBackground.js", "browser/themes/shared/urlbar.css", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/input.tokens.json"], "git_node": "0e88dabcca7e0bcb6e27681e494c8b15a8226372", "git_parents": ["3ca27569dc138e57e1e900d426adfc2e45dcfa03"], "node": "eb74803dd0829f0a5414cbe94fd8ab4867027fc8", "parents": ["8e34352892da1a286b4b5198fbf858b7ecd0f08c"], "tags": []}], "date": 1789715054, "git_changesets": ["678e7440c53eec2b79fe3f04908b7fff623684f5", "f8565f7501e9a68f00939ec16135aa646d36ccd2", "d5f58e833ff56e87a13c3888e8d58e40b53da79a", "3ca27569dc138e57e1e900d426adfc2e45dcfa03", "0e88dabcca7e0bcb6e27681e494c8b15a8226372"], "user": "pchevrel@mozilla.com"}, "28562": {"changesets": [{"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2064102 - Wait for previous entries to enter the BFCache in browser_policy_sitepolicies_serviceworkers.js.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325803\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326109\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_serviceworkers.js"], "git_node": "3a95c94165313be04516020c15ff1fefb9b2214b", "git_parents": ["0e88dabcca7e0bcb6e27681e494c8b15a8226372"], "node": "b5dff825c755a9c27e53c518b8b5691df0f6a914", "parents": ["eb74803dd0829f0a5414cbe94fd8ab4867027fc8"], "tags": []}], "date": 1789715410, "git_changesets": ["3a95c94165313be04516020c15ff1fefb9b2214b"], "user": "pchevrel@mozilla.com"}, "28563": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Use weak references in sLayerToBrowserParentTable and unregister in ~BrowserParent.  a=pascalc\n\nUsing weak references in sLayerToBrowserParentTable ensures that we never end\nup with dangling pointers. Clean up the table in ~BrowserParent() in case we\nskipped ActorDestroy.\n\nGetBrowserParentFromLayersId now returns an already_AddRefed because we were\nholding onto a strong reference anyways, and it is probably better anyways to\nhold strong stack references in the callers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326774\n", "files": ["dom/events/EventStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": "915571a3804366f5583bb774cf13b5e8505cd2d0", "git_parents": ["3a95c94165313be04516020c15ff1fefb9b2214b"], "node": "80422e3b0174c2f0191c0930562e468af10df4c4", "parents": ["b5dff825c755a9c27e53c518b8b5691df0f6a914"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Reject child-initiated deletion.  a=pascalc\n\nThe child should only send us the delete message after we've sent it the\nDestroy message, so if that's not the case, something has gone wrong, so\nlet's kill the child process to prevent further hijinks.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323316\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326775\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "f94fc70d87060e54af6a525a05cd36db6be49036", "git_parents": ["915571a3804366f5583bb774cf13b5e8505cd2d0"], "node": "c12dacc476ae3fc14dbf6715d6d2a519c5ad1fc7", "parents": ["80422e3b0174c2f0191c0930562e468af10df4c4"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Don't initialize rendering for an already-destroyed BrowserParent.  a=pascalc\n\nIf we can't send in nsFrameLoader::TryRemoteBrowserInternal() or\nBrowserParent::InitRendering(), then we've already started the process of\ndestroying the BrowserParent, so don't set up this rendering stuff that we may\nhave already tried to clean up.\n\nNote that mIsDestroyed is not usable here: it is only set by BrowserParent::Destroy(),\nwhich is not involved when the child initiates teardown.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326776\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "5e7c87460bf8f4362bf626db4d9817c8841d3c2f", "git_parents": ["f94fc70d87060e54af6a525a05cd36db6be49036"], "node": "bfe6176e6354b106a30d596443f367aa28d5b18b", "parents": ["c12dacc476ae3fc14dbf6715d6d2a519c5ad1fc7"], "tags": []}], "date": 1789715523, "git_changesets": ["915571a3804366f5583bb774cf13b5e8505cd2d0", "f94fc70d87060e54af6a525a05cd36db6be49036", "5e7c87460bf8f4362bf626db4d9817c8841d3c2f"], "user": "pchevrel@mozilla.com"}, "28564": {"changesets": [{"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2071752 - Distinguish List all tabs icon from Minimise on Breeze.  a=pascalc\n\nOn KDE's default theme Breeze, the Minimize button is a\ndownwards-pointing chevron. With horizontal tabs, the \"List all tabs\"\nbutton is too. Thus, on Breeze, it's better to use the icon we already\nuse when using vertical tabs.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325775\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326884\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "62cd2599965d15160785f0464963ce64e6d364ff", "git_parents": ["5e7c87460bf8f4362bf626db4d9817c8841d3c2f"], "node": "11ab6280f090c972db21363c4fc2ec6be9e79d21", "parents": ["bfe6176e6354b106a30d596443f367aa28d5b18b"], "tags": []}], "date": 1789715566, "git_changesets": ["62cd2599965d15160785f0464963ce64e6d364ff"], "user": "pchevrel@mozilla.com"}, "28565": {"changesets": [{"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071957 - Fix crash when tapping the VPN location row while the unavailable dialog opens  a=pascalc\n\nThe navigation action `action_ipProtectionFragment_to_ipProtectionLocationFragment` is scoped to `ipProtectionFragment`in `nav_graph.xml` so this destination is only resolved when that fragment is the current destination. `IPProtectionFragment` sets up `IPProtectionWarningBinding`, which triggers a navigation event to the unavailable dialog as soon as the proxy raises a `Authorized.ConnectionError`.\n\nWhen the proxy reports an error, `findNavController().navigate(HomeFragmentDirections.actionGlobalIpProtectionUnavailableDialog())` makes the dialog the current destination synchronously. There is a short time window where the current destination is now the dialog, but the fragment transaction is still pending and the dialog is not displayed on top of `IPProtectionFragment`. If a tap on the location row is done in that window, `handleOnLocationClicked` tries to navigate to `IPProtectionLocationsFragment` with the dialog as the current destination so it crashes. This crash can be reproduced by adjusting `handleOnLocationClicked` as follows:\n\n```\nprivate fun handleOnLocationClicked() {\n    findNavController().navigate(HomeFragmentDirections.actionGlobalIpProtectionUnavailableDialog())\n    findNavController().navigate(IPProtectionFragmentDirections.actionIpProtectionFragmentToIpProtectionLocationFragment())\n}\n```\n\nThe fix consists in using the helper `NavController.nav`, which verifies that the current destination is the expected one. If it's not the case, the navigation event is ignored so that `NavController` does not crash. By the way, `NavControllerTest` didn't have a test for the non matching id path, so a test has been added to cover this case.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326411\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326966\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/NavControllerTest.kt"], "git_node": "3f3c12a3b4629afbf8027a183c17aaa23351b028", "git_parents": ["62cd2599965d15160785f0464963ce64e6d364ff"], "node": "230b45b09b379db0bd44a32a190bd89010eca052", "parents": ["11ab6280f090c972db21363c4fc2ec6be9e79d21"], "tags": []}], "date": 1789715630, "git_changesets": ["3f3c12a3b4629afbf8027a183c17aaa23351b028"], "user": "pchevrel@mozilla.com"}, "28566": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068456.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326370\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327015\n", "files": ["gfx/thebes/gfxOTSUtils.h"], "git_node": "46f71a51d82894e716da4da279415947149ecf1b", "git_parents": ["3f3c12a3b4629afbf8027a183c17aaa23351b028"], "node": "d60563406e3b8a2816ec8494b0ce6fed1fd30d24", "parents": ["230b45b09b379db0bd44a32a190bd89010eca052"], "tags": []}], "date": 1789715692, "git_changesets": ["46f71a51d82894e716da4da279415947149ecf1b"], "user": "pchevrel@mozilla.com"}, "28567": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071557 - Keep color-font palette entries as hb_color_t to reduce memory footprint.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325607\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327023\n", "files": ["gfx/tests/fuzz/TestCOLRv1.cpp", "gfx/thebes/COLRFonts.cpp", "gfx/thebes/COLRFonts.h", "gfx/thebes/FontPaletteCache.h", "layout/style/GeckoBindings.cpp"], "git_node": "289c02bfcc8443b7ab2cbd56cf3bd0c1f2938e87", "git_parents": ["46f71a51d82894e716da4da279415947149ecf1b"], "node": "6cfee2e8b16774b9123fb4b784da78571a63ef4e", "parents": ["d60563406e3b8a2816ec8494b0ce6fed1fd30d24"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071921 - Use fallible allocation for color-font palettes to avoid a potential OOM crash with large fonts.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325911\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327024\n", "files": ["gfx/thebes/COLRFonts.cpp"], "git_node": "235cca02f869440741a8f9b36ecc0439508e2633", "git_parents": ["289c02bfcc8443b7ab2cbd56cf3bd0c1f2938e87"], "node": "e3ad617e7bd188f31dfcb92fa9f68d4c9d5cfcb8", "parents": ["6cfee2e8b16774b9123fb4b784da78571a63ef4e"], "tags": []}], "date": 1789716160, "git_changesets": ["289c02bfcc8443b7ab2cbd56cf3bd0c1f2938e87", "235cca02f869440741a8f9b36ecc0439508e2633"], "user": "pchevrel@mozilla.com"}, "28568": {"changesets": [{"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2065704 - Block HUAWEI devices to use AFont API.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324859\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327248\n", "files": ["gfx/thebes/gfxAndroidPlatform.cpp"], "git_node": "615664c3d8f7e096e5ec8bf603fe9f00bbeca450", "git_parents": ["235cca02f869440741a8f9b36ecc0439508e2633"], "node": "bb9ae57d92bedc940d8fc15dbf1d9f85f28a68f9", "parents": ["e3ad617e7bd188f31dfcb92fa9f68d4c9d5cfcb8"], "tags": []}], "date": 1789716332, "git_changesets": ["615664c3d8f7e096e5ec8bf603fe9f00bbeca450"], "user": "pchevrel@mozilla.com"}, "28569": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Make BrowserParent::mBrowserHost a strong reference.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324465\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327060\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "eddb7e21d705687ad6ffd8272e8b9b75af28a5d6", "git_parents": ["615664c3d8f7e096e5ec8bf603fe9f00bbeca450"], "node": "21d8af5d7be312b904f74b9c1da2022b2c439c8a", "parents": ["bb9ae57d92bedc940d8fc15dbf1d9f85f28a68f9"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Make BrowserParent::mBrowserBridgeParent a WeakPtr.  a=pascalc\n\nEvery user of the field runs on the parent process main thread, which\nWeakPtr's debug-only owning-thread assertions now enforce.\nBrowserBridgeParent::Destroy() still clears it explicitly, so the pointer\nis dropped when the actor is destroyed rather than when the\nBrowserBridgeParent is freed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324466\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327061\n", "files": ["dom/ipc/BrowserBridgeParent.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "de101d2dfa382265b1eba903e803589e80923adc", "git_parents": ["eddb7e21d705687ad6ffd8272e8b9b75af28a5d6"], "node": "417c35e2bd08c776b3e50f7484b287ef4bc420ed", "parents": ["21d8af5d7be312b904f74b9c1da2022b2c439c8a"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Don't let a content process name an already-embedded tab as the new tab in CreateWindow.  a=pascalc\n\nIn TryRemoteBrowserInternal, don't create a new BrowserHost is we're going to\nfail immediately anyways. This could result in failing to clean up properly.\n\nFor the two BrowserParent set methods, check in release builds that we are\neither clearing the field or the BrowserParent is not already in use.\n\nIn ContentParent::RecvCreateWindow, make sure that the child is handing us a\nfresh BrowserParent, or we can get into a weird state because things aren't\ncleaned up properly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324467\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327062\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentParent.cpp"], "git_node": "32b9067f71bedcaaa56b5e07a5ebbe47694b4e72", "git_parents": ["de101d2dfa382265b1eba903e803589e80923adc"], "node": "e29ac1be570bbee30029cedfaa20ac3b266db165", "parents": ["417c35e2bd08c776b3e50f7484b287ef4bc420ed"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Wait to set BrowserParent::mBrowserBridgeParent.  a=pascalc\n\nDon't set BrowserParent::mBrowserBridgeParent until we've set the strong half of\nthe cycle, BrowserBridgeParent::mBrowserParent, in case we hit any failure states.\n\nBrowserParent::mBrowserBridgeParent is now only set alongside the strong\nBrowserBridgeParent::mBrowserParent reference, and the two are cleared together,\nso Destroy() can only ever be clearing its own back pointer. Assert that, so\nthis doesn't silently regress into clobbering another bridge's pointer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324468\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327063\n", "files": ["dom/ipc/BrowserBridgeParent.cpp"], "git_node": "e053ef86673d563a550a1b065e7ccec57d83a4db", "git_parents": ["32b9067f71bedcaaa56b5e07a5ebbe47694b4e72"], "node": "b82d3a9630d707082742ba587fc77b064f6f948f", "parents": ["e29ac1be570bbee30029cedfaa20ac3b266db165"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Don't embed a discarded BrowsingContext from RecvCreateWindow.  a=pascalc\n\nThis is like a semi-related cleanup found while working on the other patches.\n\nThe existing BrowsingContext validation checks the shape of the new tab's\nBrowsingContext but not whether it is still live, so a discarded one would be\nadopted as the new frameloader's pending BrowsingContext by CreateBrowsingContext\nin nsFrameLoader.cpp and then embedded.\n\nUnlike the other checks here this isn't necessarily the child's fault, so fail\nthe window open the way we already do for a missing parent rather than killing\nthe child.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324469\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327064\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "f8b799eb7a4398c1d883ebc7048ebbc8a2f873c5", "git_parents": ["e053ef86673d563a550a1b065e7ccec57d83a4db"], "node": "f747b7aa6d2f05f3e2a479e5dded4e038d1866d5", "parents": ["b82d3a9630d707082742ba587fc77b064f6f948f"], "tags": []}], "date": 1789716533, "git_changesets": ["eddb7e21d705687ad6ffd8272e8b9b75af28a5d6", "de101d2dfa382265b1eba903e803589e80923adc", "32b9067f71bedcaaa56b5e07a5ebbe47694b4e72", "e053ef86673d563a550a1b065e7ccec57d83a4db", "f8b799eb7a4398c1d883ebc7048ebbc8a2f873c5"], "user": "pchevrel@mozilla.com"}, "28570": {"changesets": [{"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058785 - Gate HLS resource and demuxer callbacks on the GeckoHlsPlayer monitor.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323792\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327046\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoHlsPlayer.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/HttpChannelDataSource.java"], "git_node": "4a95cc98a4cedecfb1aca89c503ed2e9b73fd203", "git_parents": ["f8b799eb7a4398c1d883ebc7048ebbc8a2f873c5"], "node": "cb965ecaf3dc6af342c06f43fa360dc06d27c189", "parents": ["f747b7aa6d2f05f3e2a479e5dded4e038d1866d5"], "tags": []}], "date": 1789716634, "git_changesets": ["4a95cc98a4cedecfb1aca89c503ed2e9b73fd203"], "user": "pchevrel@mozilla.com"}, "28571": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2069399 - Hold references to the print dialog's header/footer dropdowns.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324694\n\n(cherry picked from commit 99645b958a738e515f8dbb305dbf9ff2ada6e438)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327037\n", "files": ["widget/gtk/nsPrintDialogGTK.cpp"], "git_node": "9223c7e8dfe960643bd2b128a05cb09793afb53d", "git_parents": ["4a95cc98a4cedecfb1aca89c503ed2e9b73fd203"], "node": "b35d4b6ac97b77a4803b5fa9f3784b00f8aad140", "parents": ["cb965ecaf3dc6af342c06f43fa360dc06d27c189"], "tags": []}], "date": 1789716709, "git_changesets": ["9223c7e8dfe960643bd2b128a05cb09793afb53d"], "user": "pchevrel@mozilla.com"}, "28572": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes mobile-merino-manifest ct-logs -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327145\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/newtab-wallpapers-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "f6622c6e59106b9402c8f5e482e5ad32c9a5f256", "git_parents": ["9223c7e8dfe960643bd2b128a05cb09793afb53d"], "node": "fedae81dd877f8474ed45f32ab86bc690c837e6e", "parents": ["b35d4b6ac97b77a4803b5fa9f3784b00f8aad140"], "tags": []}], "date": 1789717615, "git_changesets": ["f6622c6e59106b9402c8f5e482e5ad32c9a5f256"], "user": "pchevrel@mozilla.com"}, "28573": {"changesets": [{"author": "Release Engineering Landoscript \u003crele