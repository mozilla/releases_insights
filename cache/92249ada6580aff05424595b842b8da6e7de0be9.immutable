.mm"], "git_node": null, "git_parents": [null], "node": "73d77333f859d830a110e8e58dfc2eb7cba76ca6", "parents": ["df513e26729726fad8d4df4c91dc35c999c1f249"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1741665 - Align nsCString's public size_type better with other C++ APIs. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131959", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/bindings/FakeString.h", "dom/encoding/TextDecoder.cpp", "dom/ipc/ClonedErrorHolder.cpp", "dom/ipc/StringTable.h", "dom/localstorage/ActorsParent.cpp", "dom/quota/ActorsParent.cpp", "dom/serializers/nsPlainTextSerializer.cpp", "dom/webauthn/WinWebAuthnManager.cpp", "dom/workers/WorkerPrivate.cpp", "gfx/thebes/gfxFT2FontList.cpp", "intl/unicharutil/util/nsUnicharUtils.cpp", "intl/unicharutil/util/nsUnicharUtils.h", "layout/generic/nsTextFrame.cpp", "layout/style/StreamLoader.cpp", "modules/libjar/nsJARInputStream.cpp", "modules/libpref/Preferences.cpp", "modules/libpref/SharedPrefMap.h", "netwerk/base/nsStandardURL.cpp", "netwerk/protocol/http/AltDataOutputStreamChild.cpp", "netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Stream.cpp", "netwerk/protocol/http/Http3Stream.cpp", "netwerk/protocol/http/nsHttp.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/websocket/WebSocketChannel.cpp", "netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/streamconv/converters/nsUnknownDecoder.cpp", "netwerk/test/gtest/TestMIMEInputStream.cpp", "netwerk/test/gtest/TestPartiallySeekableInputStream.cpp", "parser/htmlparser/nsExpatDriver.cpp", "security/manager/ssl/ContentSignatureVerifier.cpp", "toolkit/components/places/SQLFunctions.cpp", "toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/url-classifier/HashStore.cpp", "toolkit/components/url-classifier/ProtocolParser.cpp", "widget/ContentCache.cpp", "widget/TextEventDispatcher.cpp", "widget/android/GeckoEditableSupport.cpp", "widget/gtk/IMContextWrapper.cpp", "widget/gtk/nsClipboard.cpp", "widget/windows/nsDataObj.cpp", "xpcom/ds/Tokenizer.cpp", "xpcom/io/nsUnicharInputStream.cpp", "xpcom/string/nsAString.h", "xpcom/string/nsCharTraits.h", "xpcom/string/nsReadableUtils.cpp", "xpcom/string/nsReadableUtils.h", "xpcom/string/nsString.h", "xpcom/string/nsStringBuffer.h", "xpcom/string/nsStringComparator.cpp", "xpcom/string/nsStringFwd.h", "xpcom/string/nsStringObsolete.cpp", "xpcom/string/nsTDependentString.cpp", "xpcom/string/nsTDependentString.h", "xpcom/string/nsTDependentSubstring.cpp", "xpcom/string/nsTDependentSubstring.h", "xpcom/string/nsTString.h", "xpcom/string/nsTStringComparator.cpp", "xpcom/string/nsTStringObsolete.cpp", "xpcom/string/nsTStringRepr.h", "xpcom/string/nsTSubstring.cpp", "xpcom/string/nsTSubstring.h", "xpcom/string/nsTSubstringTuple.cpp", "xpcom/string/nsTSubstringTuple.h", "xpcom/tests/gtest/TestInputStreamLengthHelper.cpp", "xpcom/tests/gtest/TestMultiplexInputStream.cpp", "xpcom/tests/gtest/TestStrings.cpp"], "git_node": null, "git_parents": [null], "node": "d47fdd938c091580f91f3efdda36b834e76da246", "parents": ["73d77333f859d830a110e8e58dfc2eb7cba76ca6"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1747185 - Reject INT32_MAX length arrays in CreateInputStream. r=dom-workers-and-storage-reviewers,janv a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134619", "files": ["dom/file/MemoryBlobImpl.cpp", "dom/file/tests/crashtests/1747185.html", "dom/file/tests/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "6cf81f51b1b671d16c1560a7295c20fc4a8b6d46", "parents": ["d47fdd938c091580f91f3efdda36b834e76da246"], "tags": []}], "date": 1642798927, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "152": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1743012 - Add missing `constexpr` qualifiers in `CheckedInt`, r=glandium, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132173", "files": ["mfbt/CheckedInt.h"], "git_node": null, "git_parents": [null], "node": "7e42d240e3fd0534e391da547dda94e73231a798", "parents": ["6cf81f51b1b671d16c1560a7295c20fc4a8b6d46"], "tags": []}], "date": 1642804697, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "153": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136725", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "8a1f67942cb61ebeab39a3790b0c70a39c9ebcf9", "parents": ["7e42d240e3fd0534e391da547dda94e73231a798"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1751053 - Avoid intermediate surface allocation to premultiply in ClientWebGLContext::GetSurfaceSnapshot. r=jgilbert, a=RyanVM\n\nThe intermediate allocation could fail and it was not handled, causing\nan infrequent OOM crash. This patch makes it so we just reuse the\nsurface buffer we have and does the premultiply inline without requiring\nan additional allocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136410", "files": ["dom/canvas/ClientWebGLContext.cpp"], "git_node": null, "git_parents": [null], "node": "b46bbce16c8214b0c50a31fdc39f6dff0d351c0a", "parents": ["8a1f67942cb61ebeab39a3790b0c70a39c9ebcf9"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1739929 - allow untrusted click/auxclick events to open one link per transient user gesture, r=edgar a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131868", "files": ["browser/actors/ClickHandlerChild.jsm", "browser/actors/moz.build", "browser/actors/test/browser/browser.ini", "browser/actors/test/browser/browser_untrusted_click_event.js", "browser/actors/test/browser/click.html", "browser/components/BrowserGlue.jsm"], "git_node": null, "git_parents": [null], "node": "fac80dc79ea27782f0ba1aad676e1dfa05463254", "parents": ["b46bbce16c8214b0c50a31fdc39f6dff0d351c0a"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1742801 - do not consume the user gesture from ClickHandlerChild if ClickHandlerParent will ignore the click anyway, r=edgar a=RyanVM\n\nThis commit does a couple of things:\n- move whereToOpenLink and getRootEvent implementations into BrowserUtils,\n  so they can be used from the child process.\n- forward callers in utilityOverlay.js to the BrowserUtils ones\n  (bug 1742889 will get rid of the forwarding and update all the callers;\n   we might be able to get this and bug 1739929 into beta if risk is low\n   enough, and touching a bunch of extra files really doesn't help with\n   that)\n- move the lazy-load of BrowserUtils from browser.js to utilityOverlay.js\n  This is safe because everywhere that loads browser.js also loads\n  utilityOverlay.js. It's needed because there are some places that use\n  utilityOverlay.js but not browser.js, and so now they need access to\n  BrowserUtils.jsm.\n- use whereToOpenLink to determine if we should avoid consuming the transient\n  user gesture activation in the child click handling code.\n- add an automated test based on the testcase in the bug.\n\nWhen working on this, I initially put the check using whereToOpenLink in\nthe toplevel of the function, and then when I ran places test to check that\nI hadn't broken any places consumers of whereToOpenLink or getRootEvent,\nrealized that I had broken `browser_markPageAsFollowedLink.js`, because it\nrelies on \"normal\" (ie no modifier key, left button) link clicks making it\nto ClickHandlerParent.jsm . I filed bug 1742894 about this. I've not tried\nto fix that here, instead I've tried to ensure that paths through this\nfunction are as untouched as possible while still fixing bug 1739929 and\nbug 1742801.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132102", "files": ["browser/actors/ClickHandlerChild.jsm", "browser/actors/test/browser/browser_untrusted_click_event.js", "browser/actors/test/browser/click.html", "browser/base/content/browser.js", "browser/base/content/utilityOverlay.js", "toolkit/modules/BrowserUtils.jsm"], "git_node": null, "git_parents": [null], "node": "6f820b5d5d9be1b066f8785b730bd2b4d640625e", "parents": ["fac80dc79ea27782f0ba1aad676e1dfa05463254"], "tags": []}, {"author": "Kelsey Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1750902 - Disable dom.vr.enabled by default. r=jrmuizel,jmathies,emilio a=RyanVM\n\nPreserve testing, just disable the pref by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136411", "files": ["dom/tests/mochitest/general/test_interfaces.js", "dom/vr/test/crashtests/crashtests.list", "dom/vr/test/mochitest/runVRTest.js", "dom/vr/test/reftest/reftest.list", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "362cfd416ae98aea091bebb1b0576a42b834e9ab", "parents": ["6f820b5d5d9be1b066f8785b730bd2b4d640625e"], "tags": []}], "date": 1643143322, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "154": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1750233 - Allow JSON policy to be a REG_SZ. r=mstriemer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136380", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_extensionsettings.js", "browser/components/enterprisepolicies/tests/xpcshell/test_preferences.js", "toolkit/components/enterprisepolicies/WindowsGPOParser.jsm", "toolkit/components/utils/JsonSchemaValidator.jsm"], "git_node": null, "git_parents": [null], "node": "a3fa76bff28fe91f03bb37d2ee7b6af81fee192d", "parents": ["362cfd416ae98aea091bebb1b0576a42b834e9ab"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1744165 - Clear sinks and block further use after storage observer shutdown. r=janv, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135474", "files": ["dom/storage/StorageIPC.cpp", "dom/storage/StorageObserver.cpp", "dom/storage/StorageObserver.h"], "git_node": null, "git_parents": [null], "node": "e12588f4908d0cfcc16d29cbb22c2d1bdb6d1f66", "parents": ["a3fa76bff28fe91f03bb37d2ee7b6af81fee192d"], "tags": []}, {"author": "Mitchell Hentges \u003cmhentges@mozilla.com\u003e", "branch": "default", "desc": "Bug 1751803: Update references to OpenSuSE NodeJS packages. r=ahochheiden, a=RyanVM\n\nOpenSuSE no longer has `nodejs`/`npm` packages, but rather\npostfixes them with their associated NodeJS version.\n\nUse version 16, since it's compatible with our minimum version\n(`10.23.1`) and is available from the official repositories.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136949", "files": ["python/mozboot/mozboot/opensuse.py"], "git_node": null, "git_parents": [null], "node": "d9ece6f47d6cff7c882485911044faa5a5f5460c", "parents": ["e12588f4908d0cfcc16d29cbb22c2d1bdb6d1f66"], "tags": []}], "date": 1643209207, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "155": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "