rents": ["deb38ff00378de59d8260c705e38b149b997dabf"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1707963: Let the PermissionManager be initialized lazily but not after shutdown started. r=timhuang,janv a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132088", "files": ["extensions/permissions/PermissionManager.cpp", "extensions/permissions/PermissionManager.h", "extensions/permissions/test/unit/test_permmanager_migrate_4-7_no_history.js", "layout/build/nsLayoutStatics.cpp"], "git_node": null, "git_parents": [null], "node": "e0fa9174c0fd0dbe8eb2af2530294d650f16bc99", "parents": ["fbb5e0cb053a5116f7734b0db1f15894d431a24f"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1707963: Avoid a potential race on permission manager singleton creation. r=timhuang a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132215", "files": ["extensions/permissions/PermissionManager.cpp", "extensions/permissions/PermissionManager.h"], "git_node": null, "git_parents": [null], "node": "91cf145c3df023170c192d7a41c7ceffbd307c39", "parents": ["e0fa9174c0fd0dbe8eb2af2530294d650f16bc99"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1707963: Remove permission manager from browser_xpcom_graph_wait.js. r=mossop a=RyanVM\n\nOnce we allow lazy initialization for the permission manager, we do not launch it at startup in any kind of process. We thus need to update the allowlist of this test and remove the permission manager and other (networking) modules it started.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133655", "files": ["toolkit/components/backgroundtasks/tests/browser/browser_xpcom_graph_wait.js"], "git_node": null, "git_parents": [null], "node": "65c98abf6c50cf6a875a8b9302fe2b7d86e6b94d", "parents": ["91cf145c3df023170c192d7a41c7ceffbd307c39"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1750168 - Align the size of buffers given to WriteBytesZeroCopy. r=nika, a=RyanVM\n\nAlso ensure Copier::Copy receives aligned pointers (in debug builds).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135985", "files": ["ipc/chromium/src/base/pickle.cc"], "git_node": null, "git_parents": [null], "node": "c73d5da6f27e2a73849860e7b38f69651affbfdc", "parents": ["65c98abf6c50cf6a875a8b9302fe2b7d86e6b94d"], "tags": []}, {"author": "Kirk Steuber \u003cksteuber@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732435 - ESR patch. r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132745", "files": ["toolkit/components/maintenanceservice/workmonitor.cpp", "toolkit/mozapps/update/nsIUpdateService.idl", "toolkit/xre/nsUpdateDriver.cpp"], "git_node": null, "git_parents": [null], "node": "e33e4da7a596cb3675a46bf757f2b7ce377ed361", "parents": ["c73d5da6f27e2a73849860e7b38f69651affbfdc"], "tags": []}], "date": 1642696596, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "150": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1745065 - Add support for managing more ciphers in policy. r=keeler, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "c652dc1b410cf99c2ede378f673e23c447ad03c2", "parents": ["e33e4da7a596cb3675a46bf757f2b7ce377ed361"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1592731 - Update Firefox ESR's update failure doorhanger to direct user to the ESR download page. r=nalexander,mkaply a=RyanVM