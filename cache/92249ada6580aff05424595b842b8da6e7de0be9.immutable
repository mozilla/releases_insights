d44178521dbed38487e9f0544b611f5e", "parents": ["005fab0e548338b8272b754aa6117c0df9694f26"], "tags": []}], "date": 1641564147, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "140": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1748774 - disable startup tests on release and esr. r=RyanVM,ahal a=release\n\nThey're kept for nightly, beta and release-rc as those are shipped\nbefore QA manual testing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135222", "files": ["taskcluster/ci/startup-test/kind.yml"], "git_node": null, "git_parents": [null], "node": "2eb3371a5d0ec9895007d495b8fe2776b25269f2", "parents": ["fc9428e0d44178521dbed38487e9f0544b611f5e"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648886 - Fix some busted tests for the about:home startup cache. r=amy, a=test-only\n\nWhen the tests for the about:home startup cache were first introduced, I made\na few mistakes:\n\n1. I used the wrong format for default named arguments in JavaScript. I accidentally\n   used { namedArg1, namedArg2 } = { namedArg1: \"default1\", namedArg2: \"default2\" }\n   instead of { namedArg1 = \"default1\", namedArg2 = \"default2\" } = {}.\n2. Some of the tests were passing a boolean as the second argument to simulateRestart,\n   which is not expected. This caused a whole host of issues, including some tests\n   not waiting for the cache to be ready when doing the restart simulation.\n\n(2) is what ultimately caused the intermittent failure for bug 1648886 - sometimes\nthe about:home startup cache would \"win\" the race and the cache data would be\navailable, and sometimes it would \"lose\" the race. Now we correctly wait for\nthe cache to be available before proceeding with the test so that the cache\n\"wins\" every time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128402", "files": ["browser/components/newtab/test/browser/abouthomecache/browser_bump_version.js", "browser/components/newtab/test/browser/abouthomecache/browser_locale_change.js", "browser/components/newtab/test/browser/abouthomecache/browser_no_cache.js", "browser/components/newtab/test/browser/abouthomecache/browser_overwrite_cache.js", "browser/components/newtab/test/browser/abouthomecache/browser_same_consumer.js", "browser/components/newtab/test/browser/abouthomecache/browser_sanitize.js", "browser/components/newtab/test/browser/abouthomecache/head.js"], "git_node": null, "git_parents": [null], "node": "5c2051d499567488b2fd765fac6c4ca8daaa8218", "parents": ["2eb3371a5d0ec9895007d495b8fe2776b25269f2"], "tags": []}], "date": 1641575809, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "141": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1677166 - Skip test_bug600307-DBOps.html for frequent failures. a=test-only DONTBUILD", "files": ["dom/tests/mochitest/localstorage/mochitest.ini"], "git_node": null, "git_parents": [null], "node": "0a7fdbf0766c2f390d7b5feba246777ee371eb25", "parents": ["5c2051d499567488b2fd765fac6c4ca8daaa8218"], "tags": []}], "date": 1641577935, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "142": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1663802 - [marionette] Fix syntax error for reset_addons() in test_addons.py. r=webdriver-reviewers,jdescottes a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134493", "files": ["testing/marionette/harness/marionette_harness/tests/unit/test_addons.py"], "git_node": null, "git_parents": [null], "node": "cee9cb3f8c0bad700d18fac135823266755fafcb", "parents": ["0a7fdbf0766c2f390d7b5feba246777ee371eb25"], "tags": []}], "date": 1641813754, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "143": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "c66de51ac28b903a32c790ea5928f4532dbad848", "parents": ["cee9cb3f8c0bad700d18fac135823266755fafcb"], "tags": []}], "date": 1641825707, "git_changesets": [null], "user": "ffxbld-merge"}, "144": {"changesets": [{"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Bug 1745116 - disable ThreadMetrics.CollectMetrics on windows x64. r=MasterWayZ, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135475", "files": ["xpcom/tests/gtest/TestThreadMetrics.cpp"], "git_node": null, "git_parents": [null], "node": "ab9feaedb93b5915ed1b4d2a23fe30c89f15fc60", "parents": ["c66de51ac28b903a32c790ea5928f4532dbad848"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135492", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "e1315f4c6be3ac012722cf2692986e147f3e6d5f", "parents": ["ab9feaedb93b5915ed1b4d2a23fe30c89f15fc60"], "tags": []}], "date": 1641837084, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "145": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 28571c2eb9624cfc7842c8f20a7c4682e8f4d3af with FIREFOX_91_5_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b5931fc8b6ad82e5586c139f96a23ebf3f9438cf", "parents": ["e1315f4c6be3ac012722cf2692986e147f3e6d5f"], "tags": []}], "date": 1641909716, "git_changesets": [null], "user": "ffxbld"}, "146": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135851", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/password-recipes.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "71c7fd79d8768b31bae48318afa0bf07518bc17d", "parents": ["b5931fc8b6ad82e5586c139f96a23ebf3f9438cf"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1748210 - Always release GetNextTokenCompleteEvent on main thread, r=valentin, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134948", "files": ["extensions/auth/nsHttpNegotiateAuth.cpp"], "git_node": null, "git_parents": [null], "node": "5a44dfe6261b98bdc080dfbbbff9cc9d44431976", "parents": ["71c7fd79d8768b31bae48318afa0bf07518bc17d"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1728413 - mistik.xtr.jp doesn't load. r=smaug, a=RyanVM\n\nGetting all the requests from the loadgroup every time a request\nis added or removed was causing performance issues. It turns out\nthat it wasn't really needed for determining if a page should be\nblocked from the BFCache, since we just need to know if there\nare any requests in the loadgroup, and if so, if all it contains\nis just one request with an id. We can keep a count of relevant\nrequests in the loadgroup. When the count changes to 1, on adding\nwe can inspect the request that's being added, and on removal we\ncan inspect the requests in the loadgroup (which should be now be\ncheap enough, since there's only 1 relevant request in the list).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125251", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h"], "git_node": null, "git_parents": [null], "node": "d6b06f985900e549cf9b3e37562e25c2ef5c82f0", "parents": ["5a44dfe6261b98bdc080dfbbbff9cc9d44431976"], "tags": []}, {"author": "Kevin Daudt \u003ckdaudt@alpinelinux.org\u003e", "branch": "default", "desc": "Bug 1745560 - Add missing stub for wl_proxy_marshal_flags, r=stransky, a=RyanVM\n\nFirefox fails to build against wayland 1.20 because this symbol is missing\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133583", "files": ["widget/gtk/mozwayland/mozwayland.c"], "git_node": null, "git_parents": [null], "node": "2ed1b3cb869bc6191bf306bab467ea42c3908c03", "parents": ["d6b06f985900e549cf9b3e37562e25c2ef5c82f0"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1740534 - Improve global consistency. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133379", "files": ["dom/base/nsIGlobalObject.cpp", "js/xpconnect/tests/mochitest/mochitest.ini", "js/xpconnect/tests/mochitest/test_bug986542.html", "testing/web-platform/meta/dom/traversal/TreeWalker-acceptNode-filter-cross-realm-null-browsing-context.html.ini"], "git_node": null, "git_parents": [null], "node": "977ec107a58ac3604c5a3e61999e3dd33b9656d5", "parents": ["2ed1b3cb869bc6191bf306bab467ea42c3908c03"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1745566 - Support frame-ancestors for web-accessible extension resources. r=freddyb,dragana a=RyanVM\n\nframe-ancestor support requires a CSP. While extensions can declare a\nCSP for extension pages, the frame-ancestors directive was not enforced\nbecause the implementation expected only HTTP channels.\n\nThis patch also adds support for channels from ExtensionProtocolHandler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134143", "files": ["dom/security/nsContentSecurityUtils.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "toolkit/components/extensions/test/xpcshell/test_ext_csp_frame_ancestors.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.ini"], "git_node": null, "git_parents": [null], "node": "fa4ca32f2125e26eec3b0469634b954909f98b64", "parents": ["977ec107a58ac3604c5a3e61999e3dd33b9656d5"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1748279 - Handle truncated WAV stream. r=alwu, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135124", "files": ["dom/media/wave/WaveDemuxer.cpp"], "git_node": null, "git_parents": [null], "node": "0568371e8077958b2d3ef3c6d84c7ee920448d6b", "parents": ["fa4ca32f2125e26eec3b0469634b954909f98b64"], "tags": []}], "date": 1642085781, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "147": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136113", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0cf9eba82093edf02e44b53ad54cd45231aa8ce4", "parents": ["0568371e8077958b2d3ef3c6d84c7ee920448d6b"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 1742682. r=bytesized,application-update-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133803", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "971eb5523eed54d4032614be41d2db49e7133f05", "parents": ["0cf9eba82093edf02e44b53ad54cd45231aa8ce4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1749957 - Fix parsing of content-length http3 header. r=dragana,kershaw a=RyanVM\n\nHTTP headers are case insensitive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135871", "files": ["netwerk/protocol/http/Http3Stream.cpp"], "git_node": null, "git_parents": [null], "node": "0c02fbef7df3307b1bc22f16271556f596a44915", "parents": ["971eb5523eed54d4032614be41d2db49e7133f05"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1735200 - Add JSAPI for getting Error.cause. r=jandem, a=RyanVM\n\nJS::GetExceptionCause() simply wraps ErrorObject::getCause().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135930", "files": ["js/public/Exception.h", "js/src/jsapi-tests/testException.cpp", "js/src/jsexn.cpp"], "git_node": null, "git_parents": [null], "node": "c7e6a60854136abf818d47c58948ef48988501c2", "parents": ["0c02fbef7df3307b1bc22f16271556f596a44915"], "tags": []}], "date": 1642534822, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "148": {"changesets": [{"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1571212 - [devtools] Wait for resume to complete in all xpcshell tests. r=bomsy, a=test-only\n\ntest_stepping-12.js wasn't correctly waiting for thread to be resumed between each of its sub test.\n\nSimilarly, other tests weren't waiting for thread front's resume request to be resume.\nI'm also spreading the usage of resumeAndWaitForPause to better ensure we resume and wait for next paused event\nwithout any race condition. Listening to \"paused\" after calling \"resume\" is subject to race conditions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136125", "files": ["devtools/server/tests/xpcshell/head_dbg.js", "devtools/server/tests/xpcshell/test_blackboxing-02.js", "devtools/server/tests/xpcshell/test_blackboxing-05.js", "devtools/server/tests/xpcshell/test_blackboxing-08.js", "devtools/server/tests/xpcshell/test_breakpoint-01.js", "devtools/server/tests/xpcshell/test_breakpoint-18.js", "devtools/server/tests/xpcshell/test_breakpoint-24.js", "devtools/server/tests/xpcshell/test_conditional_breakpoint-01.js", "devtools/server/tests/xpcshell/test_conditional_breakpoint-02.js", "devtools/server/tests/xpcshell/test_conditional_breakpoint-03.js", "devtools/server/tests/xpcshell/test_conditional_breakpoint-04.js", "devtools/server/tests/xpcshell/test_frameactor-01.js", "devtools/server/tests/xpcshell/test_frameactor-02.js", "devtools/server/tests/xpcshell/test_frameactor-03.js", "devtools/server/tests/xpcshell/test_frameactor-05.js", "devtools/server/tests/xpcshell/test_frameactor_wasm-01.js", "devtools/server/tests/xpcshell/test_listsources-01.js", "devtools/server/tests/xpcshell/test_listsources-03.js", "devtools/server/tests/xpcshell/test_pause_exceptions-01.js", "devtools/server/tests/xpcshell/test_pause_exceptions-02.js", "devtools/server/tests/xpcshell/test_pauselifetime-01.js", "devtools/server/tests/xpcshell/test_pauselifetime-02.js", "devtools/server/tests/xpcshell/test_pauselifetime-03.js", "devtools/server/tests/xpcshell/test_pauselifetime-04.js", "devtools/server/tests/xpcshell/test_source-01.js", "devtools/server/tests/xpcshell/test_stepping-12.js", "devtools/server/tests/xpcshell/test_threadlifetime-01.js", "devtools/server/tests/xpcshell/test_threadlifetime-02.js", "devtools/server/tests/xpcshell/test_watchpoint-04.js", "devtools/server/tests/xpcshell/test_xpcshell_debugging.js"], "git_node": null, "git_parents": [null], "node": "ff83e904437bff66b315866e2af7c34d32170643", "parents": ["c7