E"]}], "date": 1643219012, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "158": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f560cd3cd43bace45c9a7323404848efde7ac452 with FIREFOX_91_5_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "a18225cb2058ec4ff7e61431c391e511b8792d9e", "parents": ["9c78a8c65b7b9cd7c0c2729d6ca048fa8a438b33"], "tags": []}], "date": 1643234542, "git_changesets": [null], "user": "ffxbld"}, "159": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f560cd3cd43bace45c9a7323404848efde7ac452 with FIREFOX_91_5_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "56921d2e48c60b419de0e4fc307a4265a58c64ed", "parents": ["a18225cb2058ec4ff7e61431c391e511b8792d9e"], "tags": []}], "date": 1643295527, "git_changesets": [null], "user": "ffxbld"}, "160": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update, r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137128", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "85ecb5c98f5c7513b41c6f6cd81bd7a1d936dff0", "parents": ["56921d2e48c60b419de0e4fc307a4265a58c64ed"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1749306 - Fix spidermonkey source packaging for Windows. r=glandium, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135564", "files": ["mozglue/moz.build"], "git_node": null, "git_parents": [null], "node": "3701f969c754cad3546d48dd68150e8b32cd18e8", "parents": ["85ecb5c98f5c7513b41c6f6cd81bd7a1d936dff0"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1689978 - Fill out-of-bounds texelFetchPtr with zeroes rather than clamping. r=jrmuizel, a=RyanVM\n\nAttempting to just clamping the base address returning from texelFetchPtr might be causing\nsome crashes in the case the texture is actually smaller than the offset area. Instead, switch\nout the sampler with a zero buffer to ensure we have something sane to sample without having\nto do slow bounds checking on everything.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132508", "files": ["gfx/wr/glsl-to-cxx/src/lib.rs", "gfx/wr/swgl/src/gl.cc", "gfx/wr/swgl/src/gl_defs.h", "gfx/wr/swgl/src/texture.h"], "git_node": null, "git_parents": [null], "node": "aae8c64f2a1953d448b394c97840ca6c8c6a3dee", "parents": ["3701f969c754cad3546d48dd68150e8b32cd18e8"], "tags": []}, {"author": "Harry Twyford \u003chtwyford@mozilla.com\u003e", "branch": "default", "desc": "Bug 1745455 - Partially revert bug 1733660 to ensure close button is displayed. r=dao, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134796", "files": ["toolkit/themes/shared/findbar.css"], "git_node": null, "git_parents": [null], "node": "e599b5e0957ea4f11c93c3bd737e1b06c685f827", "parents": ["aae8c64f2a1953d448b394c97840ca6c8c6a3dee"], "tags": []}, {"author": "Bernard Igiri \u003cbigiri@mozilla.com\u003e", "branch": "default", "desc": "Bug 1714276 - Limit height of tab when font size is changed r=dao,desktop-theme-reviewers, a=RyanVM\n\nSet a maximum height on tabs to prevent it from expanding and moving the display of the web page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134169", "files": ["browser/base/content/tabbrowser-tab.js", "browser/themes/shared/tabs.inc.css"], "git_node": null, "git_parents": [null], "node": "594ee0d78b9edeb8f9b3972eced472064e16955e", "parents": ["e599b5e0957ea4f11c93c3bd737e1b06c685f827"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1739957 - Clear event listener. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134713", "files": ["dom/events/EventListenerManager.cpp"], "git_node": null, "git_parents": [null], "node": "7310b48db9839e0d1a7c78bc35b84dc21f125fea", "parents": ["594ee0d78b9edeb8f9b3972eced472064e16955e"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1750550: Null check aAttributes in ConvertToAtkTextAttributeSet. r=eeejay, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136303", "files": ["accessible/atk/nsMaiInterfaceText.cpp"], "git_node": null, "git_parents": [null], "node": "2b9c35892ea9713ae3cd031d427886b0333ec8a5", "parents": ["7310b48db9839e0d1a7c78bc35b84dc21f125fea"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1746545 - Use -fno-finite-math-only in SWGL. r=jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136990", "files": ["gfx/wr/swgl/build.rs"], "git_node": null, "git_parents": [null], "node": "386b63ddcd800fa546ad9a5c0bf55611571b21a2", "parents": ["2b9c35892ea9713ae3cd031d427886b0333ec8a5"], "tags": []}], "date": 1643297139, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "161": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137437", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "eaf4579f4afbffcf5d064b620e0c378aa7b2d145", "parents": ["386b63ddcd800fa546ad9a5c0bf55611571b21a2"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1317873, don't allow any internal types to be assigned to a DataTransfer, r=nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D118004", "files": ["dom/events/DataTransfer.cpp", "widget/nsITransferable.idl"], "git_node": null, "git_parents": [null], "node": "d50dfa8274c2a11e4e4ec25888cebd38439a92c2", "parents": ["eaf4579f4afbffcf5d064b620e0c378aa7b2d145"], "tags": []}, {"author": "Jan Rio Krause \u003cjkrause@mozilla.com\u003e", "branch": "default", "desc": "Bug 1740985 - Consistent error messages for scripts which failed to load. r=edenchuang, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133515", "files": ["dom/workers/ScriptLoader.cpp"], "git_node": null, "git_parents": [null], "node": "24f825282ceac2a85f7f86f7c34224000f17beec", "parents": ["d50dfa8274c2a11e4e4ec25888cebd38439a92c2"], "tags": []}, {"author": "Jan Rio Krause \u003cjkrause@mozilla.com\u003e", "branch": "default", "desc": "Bug 1748503 - Consistent error messages for blocked scripts. r=edenchuang, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136535", "files": ["dom/workers/ScriptLoader.cpp"], "git_node": null, "git_parents": [null], "node": "de8c6a1ba2c7f6003e795e63647f6ca1d3caccb0", "parents": ["24f825282ceac2a85f7f86f7c34224000f17beec"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1740304: Apply the print fragmentation-fallback \"additional offset\" in one case where it was being missed. r=miko, a=RyanVM\n\nWe call MaybeApplyAdditionalOffset a few lines up when setting *aOffset, but it\nlooks like we missed this particular codepath.  This was causing content to\nrender properly during print-preview (which takes the upper codepath) but not\nduring actual printing (which takes the lower codepath, the one where I'm\nadding the new call).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137199", "files": ["layout/painting/nsDisplayList.cpp", "testing/web-platform/meta/css/css-break/block-002-wm-vlr-print.html.ini", "testing/web-platform/meta/css/css-break/block-002-wm-vrl-print.html.ini", "testing/web-platform/tests/css/printing/fragmented-inline-block-001-print.html", "testing/web-platform/tests/css/printing/fragmented-inline-block-002-print-ref.html", "testing/web-platform/tests/css/printing/fragmented-inline-block-002-print.html"], "git_node": null, "git_parents": [null], "node": "d8affed56ce5cbbc47e05736d7ce714bffd1f968", "parents": ["de8c6a1ba2c7f6003e795e63647f6ca1d3caccb0"], "tags": []}], "date": 1643668203, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "162": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1740304 - Update test expectations. a=bustage", "files": ["testing/web-platform/meta/svg/painting/reftests/mask-print.svg.ini"], "git_node": null, "git_parents": [null], "node": "3ac96fd3a3820bb8a3160de1bc52009fe22d769d", "parents": ["d8affed56ce5cbbc47e05736d7ce714bffd1f968"], "tags": ["FIREFOX_91_6_0esr_BUILD1", "FIREFOX_91_6_0esr_RELEASE"]}], "date": 1643670770, "git_changesets": [null], "user": "ryanvm@gmail.com"}}
}";