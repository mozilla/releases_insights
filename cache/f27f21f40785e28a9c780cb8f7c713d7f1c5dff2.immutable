spot-537 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "57e8bcabfe044bf5e63990a42fd7936f9be00c6a", "parents": ["fd87e5883fdf4cd2201382a7e8155dd586962082"], "tags": []}], "date": 1433586416, "git_changesets": [null, null], "user": "ffxbld"}, "57": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1166867 - Add IsWin10OrLater(). r=jimm, a=sledru\n\nPatch originally was Part 0 from bug 1061604.", "files": ["mfbt/WindowsVersion.h"], "git_node": null, "git_parents": [null], "node": "6abf6c91586a2352c1d6fc6e9cecc8517fc8d752", "parents": ["57e8bcabfe044bf5e63990a42fd7936f9be00c6a"], "tags": []}, {"author": "Seth Fowler \u003cseth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1148640 - Bail if OnStartRequest is delivered more than once to imgCacheValidator. r=tn, a=sledru", "files": ["image/src/imgLoader.cpp"], "git_node": null, "git_parents": [null], "node": "86294b03c5a9bf962d5fa327d447113f92fab6fc", "parents": ["6abf6c91586a2352c1d6fc6e9cecc8517fc8d752"], "tags": []}, {"author": "nsilva@mozilla.com", "branch": "default", "desc": "Bug 1151713 - Initialize the layers prefs earlier. r=jrmuizel, a=sledru", "files": ["gfx/thebes/gfxPlatform.cpp"], "git_node": null, "git_parents": [null], "node": "e8504a5ff7ccf08499932000dea99e4a6cb7d6ed", "parents": ["86294b03c5a9bf962d5fa327d447113f92fab6fc"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1158558 - Part 1: Expand time logging in BeginCollection. r=smaug, a=sledru", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": null, "git_parents": [null], "node": "efb786012cf0615540be7b2829b2fa6d568b6b22", "parents": ["e8504a5ff7ccf08499932000dea99e4a6cb7d6ed"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1158558 - Part 2: Finish incremental GCs in progress in BeginCollection() and ShutdownCollect(). r=smaug, a=sledru\n\nVarious parts of the first half of BeginCollection() can start an incremental GC.\nThis is bad because running the GC and CC at the same time can cause the CC to end\nup with pointers to dead JS objects.\n\nTo avoid this, we finish any incremental GC in progress in BeginCollection. This\nis slow, but hopefully it is rare.", "files": ["js/xpconnect/tests/mochitest/mochitest.ini", "js/xpconnect/tests/mochitest/test_bug1158558.html", "xpcom/base/nsCycleCollector.cpp"], "git_node": null, "git_parents": [null], "node": "11153a2ecf27774cb38f16953346677b65f9486c", "parents": ["efb786012cf0615540be7b2829b2fa6d568b6b22"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1166183 - Back out the direct listener removal landed by mistake in bug 1141781. r=jesup, a=sledru", "files": ["media/webrtc/signaling/src/mediapipeline/MediaPipeline.cpp"], "git_node": null, "git_parents": [null], "node": "b1f5175eb8f233d4d682fc9e808f5a9fd5fbed24", "parents": ["11153a2ecf27774cb38f16953346677b65f9486c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1166183 - Work around bug 934512 in track_peerConnection_replaceTrack.html.  r=pehrson, a=sledru", "files": ["dom/media/tests/mochitest/test_peerConnection_replaceTrack.html"], "git_node": null, "git_parents": [null], "node": "b6207942c59f9197028bbf7acdab6189a2e08cd3", "parents": ["b1f5175eb8f233d4d682fc9e808f5a9fd5fbed24"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@gmail.com\u003e", "branch": "default", "desc": "Bug 1166183 - Reset PipelineListener's flag after ReplaceTrack(). r=bwc, a=sledru", "files": ["media/webrtc/signaling/src/mediapipeline/MediaPipeline.cpp"], "git_node": null, "git_parents": [null], "node": "917403490208150d356a00035f5ddd56258963d2", "parents": ["b6207942c59f9197028bbf7acdab6189a2e08cd3"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.s