ansportSecurityInfo.cpp", "security/manager/ssl/tests/gtest/DeserializeCertTest.cpp"], "git_node": null, "git_parents": [null], "node": "80a4a7ef281374dbb2afda8edac54665b14b9ef8", "parents": ["40a36bb3dc0d4f35b083eafd6ea2dad3f1dec888"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1475775 - Clean up old NSS DB file after upgrade if necessary. r=franziskus, r=mattn, a=RyanVM\n\nReviewers: franziskus, mattn\n\nBug #: 1475775\n\nDifferential Revision: https://phabricator.services.mozilla.com/D2202", "files": ["security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/tests/unit/test_sdr_upgraded_with_password.js", "security/manager/ssl/tests/unit/test_sdr_upgraded_with_password/cert8.db", "security/manager/ssl/tests/unit/test_sdr_upgraded_with_password/cert9.db", "security/manager/ssl/tests/unit/test_sdr_upgraded_with_password/key3.db", "security/manager/ssl/tests/unit/test_sdr_upgraded_with_password/key4.db", "security/manager/ssl/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "300efdbc9fe1f9165428c7934861033935b5abfa", "parents": ["80a4a7ef281374dbb2afda8edac54665b14b9ef8"], "tags": []}, {"author": "Nicholas Nethercote \u003cnnethercote@mozilla.com\u003e", "branch": "default", "desc": "Bug 1489744 - Fix a bounds violation crash in the prefs parser. r=glandium, a=RyanVM\n\nCurrently, if a get_char() call returns EOF, the index moves beyond the\nbuffer's bounds and get_char() cannot be called again without triggering a\npanic. As a result, everywhere that encounters an EOF and then does subsequent\nparsing ungets the EOF... except there was one place that failed to do that:\nthe match case for CharKind::Slash in get_token(). This meant that a single '/'\nat the end of the input could trigger a bounds violation (but only if it is the\nstart of a new token).\n\nThis EOF-unget requirement is subtle and easy to get wrong, so this patch\neliminates it. get_char() now can be called repeatedly after an EOF, and will\nreturn EOF on each subsequent call. This means that some of the existing\nunget_char() calls can be removed. Some others are still necessary to get line\nnumbers correct in error messages, but the outcome of mishandled cases is now\nmuch less drastic -- an incorrect line number in an error message instead of a\npanic.\n\nThe patch also clarifies a couple of related comments.", "files": ["modules/libpref/parser/src/lib.rs", "modules/libpref/test/gtest/Parser.cpp"], "git_node": null, "git_parents": [null], "node": "6546ee839d3002b595765008da323eb2422f0317", "parents": ["300efdbc9fe1f9165428c7934861033935b5abfa"], "tags": []}], "date": 1537319499, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "180": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6387", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "40b5da88eac924898de5c85f0cfb1fd60ffb52ee", "parents": ["6546ee839d3002b595765008da323eb2422f0317"], "tags": []}, {"author": "Yura Zenevich \u003cyura.zenevich@gmail.com\u003e", "branch": "default", "desc": "Bug 1489605 - Include jaws-esr add-on that disables e10s for users of old JAWS screen reader. r=rhelmer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6191", "files": ["browser/extensions/jaws-esr/bootstrap.js", "browser/extensions/jaws-esr/install.rdf", "browser/extensions/jaws-esr/locales/ar/jaws-esr.properties", "browser/extensions/jaws-esr/locales/de/jaws-esr.properties", "browser/extensions/jaws-esr/locales/en-US/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-AR/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-CL/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-ES/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-MX/jaws-esr.properties", "browser/extensions/jaws-esr/locales/et/jaws-esr.properties", "browser/extensions/jaws-esr/locales/fr/jaws-esr.properties", "browser/extensions/jaws-esr/locales/hu/jaws-esr.properties", "browser/extensions/jaws-esr/locales/it/jaws-esr.properties", "browser/extensions/jaws-esr/locales/jar.mn", "browser/extensions/jaws-esr/locales/lt/jaws-esr.properties", "browser/extensions/jaws-esr/locales/moz.build", "browser/extensions/jaws-esr/locales/nl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/nn-NO/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pt-BR/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pt-PT/jaws-esr.properties", "browser/extensions/jaws-esr/locales/ru/jaws-esr.properties", "browser/extensions/jaws-esr/locales/sl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/sv-SE/jaws-esr.properties", "browser/extensions/jaws-esr/locales/tr/jaws-esr.properties", "browser/extensions/jaws-esr/moz.build", "browser/extensions/moz.build", "browser/locales/Makefile.in"], "git_node": null, "git_parents": [null], "node": "cfd39eb278bb8b165bafd0cb26606f35c314df53", "parents": ["40b5da88eac924898de5c85f0cfb1fd60ffb52ee"], "tags": ["FIREFOX_60_2_1esr_BUILD1", "FIREFOX_60_2_1esr_RELEASE"]}], "date": 1537466034, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "181": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cfd39eb278bb8b165bafd0cb26606f35c314df53 with FIREFOX_60_2_1esr_BUILD1 a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "d30fe4234fc1359e2f806a9ccbc292c6c54aa9d6", "parents": ["cfd39eb278bb8b165bafd0cb26606f35c314df53"], "tags": []}], "date": 1537472985, "git_changesets": [null], "user": "ffxbld"}, "182": {"changesets": [{"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1486970 - Create revision and pushlog-id index routes for cron decision tasks. r=dustin,aki, a=ritu\n\nThis hardcodes the push info in .taskgraph.yml for cron so that we don't break Chain Of Trust (signing)\non other branches (uplifts) when we adjust scriptworker to start passing in this data to json-e.\n\nThis allows us to incrementally roll this out without needing a flag day, and will be needed on all production branches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4501", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "026a8471ee22a79af14a641343b666797ed6ff0d", "parents": ["d30fe4234fc1359e2f806a9ccbc292c6c54aa9d6"], "tags": []}], "date": 1537476457, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "183": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493028 - update branch priorities for esr60, r=aki, a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6450", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "078cec67c7046b31d141c408958e8ebe7521f7e2", "parents": ["026a8471ee22a79af14a641343b666797ed6ff0d"], "tags": []}], "date": 1537504025, "git_changesets": [null], "user": "nthomas@mozilla.com"}, "184": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cfd39eb278bb8b165bafd0cb26606f35c314df53 with FIREFOX_60_2_1esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "37e00f959a2efd8497346dd3e9152313276c8cf8", "parents": ["078cec67c7046b31d141c408958e8ebe7521f7e2"], "tags": []}, {"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "02d1db14a5d0c77fb5bd4ee40ea0fd01d639429b", "parents": ["37e00f959a2efd8497346dd3e9152313276c8cf8"], "tags": []}], "date": 1537558354, "git_changesets": [null, null], "user": "ffxbld"}, "185": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1432364 - remove comment about docker sha allowlists. r=gps\n\nIn bug 1328719, we added support for rebuilding the decision/action task definition via json-e.\nIn bug 1459705, we're killing support for cot v1, which relied on docker sha allowlists and decision task command parsing. Because we no longer use the docker sha allowlists, let's remove this comment.\n\nMozReview-Commit-ID: HntXmoSzUij", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "26be355967fd1f9979db668f3c7d600cf7a39938", "parents": ["02d1db14a5d0c77fb5bd4ee40ea0fd01d639429b"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1437958 - notify taskcluster-notifications@ on action task failure; r=bstack\n\nMozReview-Commit-ID: Fe3gUUmJkny", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "382bbe3f6093927f7d1227af244f430e92b694b5", "parents": ["26be355967fd1f9979db668f3c7d600cf7a39938"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1472777: add create-interactive action; r=bstack\n\nThe resulting action task isn't useful to the user, so instead we send an email\ncontaining a link to the interaction console.\n\nMozReview-Commit-ID: 5uHnQo9WTF6", "files": ["taskcluster/taskgraph/actions/create_interactive.py", "taskcluster/taskgraph/actions/util.py", "taskcluster/taskgraph/util/taskcluster.py"], "git_node": null, "git_parents": [null], "node": "98c58fda26d837e60a8418cbe6ca1ef9ef7d0347", "parents": ["382bbe3f6093927f7d1227af244f430e92b694b5"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1472776: add a 'cancel' action to cancel one task; r=tomprince\n\nMozReview-Commit-ID: E3MTcM4TR7e", "files": ["taskcluster/taskgraph/actions/cancel.py"], "git_node": null, "git_parents": [null], "node": "f815f353dd6b69474fccd9c3baab13eb696862ce", "parents": ["98c58fda26d837e60a8418cbe6ca1ef9ef7d0347"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471227 - adjust taskcluster backfill with path to use test-verify instead of original job. r=gbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1961", "files": ["taskcluster/taskgraph/actions/backfill.py", "testing/mozharness/scripts/android_emulator_unittest.py"], "git_node": null, "git_parents": [null], "node": "ed08947f392234b234f327d27041711114e0c9aa", "parents": ["f815f353dd6b69474fccd9c3baab13eb696862ce"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1473636: raise errors in cancel-all action; r=tomprince\n\nThis changes\n\n  File \"/builds/worker/checkouts/gecko/taskcluster/taskgraph/actions/cancel_all.py\", line 30, in list_group\n    for task in [t['status'] for t in response['tasks']]:\nKeyError: u'tasks'\n\nInto a more understandable error (404, in this case).\n\nMozReview-Commit-ID: 5XnFyxIdRfo", "files": ["taskcluster/taskgraph/actions/cancel_all.py"], "git_node": null, "git_parents": [null], "node": "120ce6e104bdb5e3835e4a1acd84a807edf240f0", "parents": ["ed08947f392234b234f327d27041711114e0c9aa"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1473636: clarify arguments to action callbacks; r=tomprince\n\nMozReview-Commit-ID: j3OiNkjngD", "files": ["taskcluster/docs/actions.rst", "taskcluster/mach_commands.py", "taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "bcfadb099ba3b802fc48dadad4e678d4133f6235", "parents": ["120ce6e104bdb5e3835e4a1acd84a807edf240f0"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1473636: move description of create_tasks to its own section; r=tomprince\n\nMozReview-Commit-ID: 2r1br7bvlcz", "files": ["taskcluster/docs/actions.rst", "taskcluster/taskgraph/actions/util.py"], "git_node": null, "git_parents": [null], "node": "12eb554839a2dbd6dd68415b009ca59620ead121", "parents": ["bcfadb099ba3b802fc48dadad4e678d4133f6235"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1473636: remove outdated information about raw YAML templates, custom tasks; r=tomprince\n\nMozReview-Commit-ID: CuhoyqGobXJ", "files": ["taskcluster/docs/actions.rst"], "git_node": null, "git_parents": [null], "node": "585e27d176216f7aa545eae5d92823e5d6358b49", "parents": ["12eb554839a2dbd6dd68415b009ca59620ead121"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1470886 - only produce tasks for recognized tasks_for; r=tomprince\n\nThis carefully maintains tasks as an array by putting the conditional inside of\nthat array.  Note that `[{$if: 'false', then: 1}]` returns `[]` in JSON-e --\nthe missing `else` branch is treated as a missing array element.\n\nMozReview-Commit-ID: 9ARIxW3gfWo", "files": [".taskcluster.yml", "taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "dedfee9cdbccec6899216297211df7aa2fbce755", "parents": ["585e27d176216f7aa545eae5d92823e5d6358b49"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1470621: make all actions use hooks r=tomprince\n\nEverything but release-promotion (to be handled in another bug) is generic.\nFor the moment, these all run with the default repo scopes; once this is\nlanded, I can start adjusting that and granting the necessary scopes only to\nthese actions.\n\nMozReview-Commit-ID: IB8OEsfeBpj", "files": ["taskcluster/taskgraph/actions/add_new_jobs.py", "taskcluster/taskgraph/actions/add_talos.py", "taskcluster/taskgraph/actions/cancel_all.py", "taskcluster/taskgraph/actions/mochitest_retrigger.py", "taskcluster/taskgraph/actions/purge_caches.py", "taskcluster/taskgraph/actions/rerun.py", "taskcluster/taskgraph/actions/run_missing_tests.py"], "git_node": null, "git_parents": [null], "node": "9928b1f588958181c9807ce015ed67811da11214", "parents": ["dedfee9cdbccec6899216297211df7aa2fbce755"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1470621: actionPerm is the cb_name, not name; r=tomprince\n\nThe actionPerm is for access control, so it must limit access to a specific\ncallback function, not a name (which can apply to mulitple functions).\n\nTo make things nicer, we allow functions to specify their cb_name and default\nit to the action name. The decorated function names are not used.\n\nMozReview-Commit-ID: 2oiuXrrw7DE", "files": ["taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "40eccbaa189faf8ca2a4f5d9e2edcf5eccdd4883", "parents": ["9928b1f588958181c9807ce015ed67811da11214"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1470623 - name the action purge-cache to align with the spec; r=tomprince\n\nMozReview-Commit-ID: G1PS0mi8Xpr", "files": ["taskcluster/taskgraph/actions/purge_caches.py"], "git_node": null, "git_parents": [null], "node": "bdcffeaa7f1ed58916d514a9d8721dfdf061dc76", "parents": ["40eccbaa189faf8ca2a4f5d9e2edcf5eccdd4883"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1475194 - In TV-bf, avoid use of --gpu-required for wpt; r=jmaher\n\nTest verification backfill specifies --gpu-required for certain types\nof tests (depending on test path and/or suite). web-platform-tests do\nnot recognize --gpu-required. This patch updates the backfill logic\nto avoid --gpu-required for wpt.", "files": ["taskcluster/taskgraph/actions/backfill.py"], "git_node": null, "git_parents": [null], "node": "87ca73a4ee09838da74b4c5bce1223cdc54303c9", "parents": ["bdcffeaa7f1ed58916d514a9d8721dfdf061dc76"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1477747 - combine action task-graph-{suffix}.json into one. r=dustin\n\nMozReview-Commit-ID: J3uaiMcTOBb", "files": ["taskcluster/taskgraph/actions/backfill.py", "taskcluster/taskgraph/actions/retrigger.py", "taskcluster/taskgraph/actions/util.py", "taskcluster/taskgraph/decision.py"], "git_node": null, "git_parents": [null], "node": "f4109139c7b370a8ccb982296fb48616a18b6e53", "parents": ["87ca73a4ee09838da74b4c5bce1223cdc54303c9"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1472792: give both retrigger actions the same name; r=bstack\n\nThis additionally reconsiders the order of all of the actions, spacing them 50\n\"units\" apart and putting the more common actions first.\n\nMozReview-Commit-ID: 98IOYKVMcGU", "files": ["taskcluster/docs/actions.rst", "taskcluster/taskgraph/actions/add_new_jobs.py", "taskcluster/taskgraph/actions/add_talos.py", "taskcluster/taskgraph/actions/backfill.py", "taskcluster/taskgraph/actions/cancel.py", "taskcluster/taskgraph/actions/cancel_all.py", "taskcluster/taskgraph/actions/create_interactive.py", "taskcluster/taskgraph/actions/mochitest_retrigger.py", "taskcluster/taskgraph/actions/purge_caches.py", "taskcluster/taskgraph/actions/release_promotion.py", "taskcluster/taskgraph/actions/rerun.py", "taskcluster/taskgraph/actions/retrigger.py", "taskcluster/taskgraph/actions/run_missing_tests.py"], "git_node": null, "git_parents": [null], "node": "d2adfc87c259865ed1f2577640e5479286ffe69b", "parents": ["f4109139c7b370a8ccb982296fb48616a18b6e53"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1398277: special-case retriggering of tasks not in the taskgraph; r=bstack\n\nThis will apply to cron tasks, action tasks, and decision tasks.  It is a\ndistinct retrigger implementation because (a) we do not want to follow\ndependencies, and (b) it takes a lot of scopes to create a decision task, so we\nneed to limit access to this action.\n\nMozReview-Commit-ID: 21DVSiagcrO", "files": [".taskcluster.yml", "taskcluster/taskgraph/actions/retrigger.py", "taskcluster/taskgraph/actions/util.py", "taskcluster/taskgraph/taskgraph.py", "taskcluster/taskgraph/test/python.ini", "taskcluster/taskgraph/test/test_actions_util.py", "taskcluster/taskgraph/test/test_taskgraph.py", "taskcluster/taskgraph/test/test_util_taskcluster.py", "taskcluster/taskgraph/util/taskcluster.py"], "git_node": null, "git_parents": [null], "node": "1aabfd210ab76acfc51996f3b50bfa6d4b075b3f", "parents": ["d2adfc87c259865ed1f2577640e5479286ffe69b"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1469610: [taskgraph] Use `action.taskGroupId` to set `ACTION_TASK_GROUP_ID`; r=dustin\n\nThis makes it consistent with everywhere else in `.taskcluster.yml` where we\nrefer to the action task group.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1707", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "45ece7edd5df08ff272d7b8026273203508f6719", "parents": ["1aabfd210ab76acfc51996f3b50bfa6d4b075b3f"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491307: make retrigger-mochitest its own action r=tomprince a=mochitest-retrigger-fix\n\nEven with no options, this is not a simple retrigger -- it adds voluminous\ndebug output.  So let's keep it as a custom action.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5879", "files": ["taskcluster/taskgraph/actions/retrigger.py", "taskcluster/taskgraph/actions/retrigger_mochitest.py"], "git_node": null, "git_parents": [null], "node": "0b5e251fa6093a14d393a22e4f177d833e64cdac", "parents": ["45ece7edd5df08ff272d7b8026273203508f6719"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487500: improvements to create-interactive r=bstack\n\nSome whitelisting of scopes, and some notes on security of the operation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5572", "files": ["taskcluster/taskgraph/actions/create_interactive.py"], "git_node": null, "git_parents": [null], "node": "7ea780c325e43a9e594e015a58ff10b00970ebb5", "parents": ["0b5e251fa6093a14d393a22e4f177d833e64cdac"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487500: allow context to be different based on parameters r=bstack\n\n..and use this to allow create-interactive on level 3, but only for testers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5573", "files": ["taskcluster/docs/actions.rst", "taskcluster/taskgraph/actions/create_interactive.py", "taskcluster/taskgraph/actions/registry.py"], "git_node": null, "git_parents": [null], "node": "f3353aab033e65d47431f486fd04009bb6214261", "parents": ["7ea780c325e43a9e594e015a58ff10b00970ebb5"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491186: sanity check action scopes r=aki,tomprince\n\nThis provides a modicum of assurance that, for example, a non-generic action is\nnot being run with generic scopes. While scopes would prevent any serious\ndamage from such an action, this provides an extra layer of security to prevent\nsuch abuse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6271", "files": ["taskcluster/taskgraph/actions/registry.py", "taskcluster/taskgraph/util/taskcluster.py"], "git_node": null, "git_parents": [null], "node": "d2538a8c3b47faf11c04cfbb25b24bb3f1b08781", "parents": ["f3353aab033e65d47431f486fd04009bb6214261"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491621 - use different priorities for different kinds of decisions r=tomprince a=tomprince\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6193", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "1bb58a2125e2173da7ba2b9259bb8e6de5974ae1", "parents": ["d2538a8c3b47faf11c04cfbb25b24bb3f1b08781"], "tags": []}], "date": 1537570873, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "mozilla@hocat.ca"}, "186": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6651", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "c09bd0878da723712c6d24711afb705e1624e320", "parents": ["1bb58a2125e2173da7ba2b9259bb8e6de5974ae1"], "tags": []}], "date": 1537793663, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "187": {"changesets": [{"author": "Chris Manchester \u003ccmanchester@mozilla.com\u003e", "branch": "default", "desc": "Bug 1479540 - Accept \"triplet\" strings with only two parts in moz.configure. r=froydnj, a=jcristau\n\nMozReview-Commit-ID: 7pFhoJgBMhQ", "files": ["build/moz.configure/init.configure"], "git_node": null, "git_parents": [null], "node": "381ae910e9b2712699fdc6a9bb9702c04bccb8f5", "parents": ["c09bd0878da723712c6d24711afb705e1624e320"], "tags": []}], "date": 1537883049, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "188": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1443137 - Attempt to fix intermittent in browser_search_notification.js by relying on a different method for opening the tab and waiting for completion before we start a search. r=adw, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6620", "files": ["docshell/test/browser/browser_search_notification.js"], "git_node": null, "git_parents": [null], "node": "38cf20b5e29a95c0ab45cd327d86e30db9349ec0", "parents": ["381ae910e9b2712699fdc6a9bb9702c04bccb8f5"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1486224: [fetch-content] Retry downloads when fetching content; r=gps, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6686", "files": ["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "de4f5177718881f1a199768d803159340997622c", "parents": ["38cf20b5e29a95c0ab45cd327d86e30db9349ec0"], "tags": []}], "date": 1537966514, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "189": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7080", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "268b8238dd954f5f80b595565ff7ff48c72dca2d", "parents": ["de4f5177718881f1a199768d803159340997622c"], "tags": []}], "date": 1538051356, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "190": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "merge cfd39eb278bb (FIREFOX_60_2_1esr_RELEASE) to THUNDERBIRD_60_VERBRANCH. a=jorgk", "files": [], "git_node": null, "git_parents": [null, null], "node": "3b3feba9b6a0122a712c02339b615fcddffa77c5", "parents": ["78c54e4a83e8807cdeaa96e22648d381eb51c8da", "cfd39eb278bb8b165bafd0cb26606f35c314df53"], "tags": []}, {"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1491907 - Set correct branch URL for Thunderbird based on product-details r=bhearsum\n\nThunderbird releases come from the comm-esr.* repositories rather than the\ncomm-release repository. This adds a special case for Thunderbird and sets\nthe branch URL correctly.\n\nThis initial patch is based on the branch_prefix (comm or mozilla).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6509", "files": ["testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": null, "git_parents": [null], "node": "f0a374b418e9b2464087541a9eca3959ce44926b", "parents": ["3b3feba9b6a0122a712c02339b615fcddffa77c5"], "tags": []}, {"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1491907 - Get comm/ version from comm/mail/version*.txt r=dustin\n\nThe release-update-verify-config task requires that the versions passed\nto it match up with what's been released. The version of Thunderbird\ndoes not necessarily match the Gecko version it's based on.\n\nDepends on D6509\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6510", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/__init__.py", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/parameters.py"], "git_node": null, "git_parents": [null], "node": "ef90e3410f3bea0976b85c0a8083bf1b06fe747b", "parents": ["f0a374b418e9b2464087541a9eca3959ce44926b"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1489785: Remove a workaround for gcc, introduced in bug 678607, that is no longer needed and that causes hangs in modal dialogs on macOS 10.14. r=mstange a=jorgk DONTBUILD", "files": ["widget/cocoa/nsChildView.mm"], "git_node": null, "git_parents": [null], "node": "8d71faee5dcdd0773b7e0830b8fad96a6bda559b", "parents": ["ef90e3410f3bea0976b85c0a8083bf1b06fe747b"], "tags": []}], "date": 1538330274, "git_changesets": [null, null, null, null], "user": "mozilla@jorgk.com"}, "191": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493900.  r=bhackett,sunfish a=dveditz", "files": ["js/src/jit/BacktrackingAllocator.cpp"], "git_node": null, "git_parents": [null], "node": "4808fcb2e6ca2decb8cebb2b7a2797d212466bc7", "parents": ["268b8238dd954f5f80b595565ff7ff48c72dca2d"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493903 - Don't inline push with more than 1 argument. r=tcampbell a=dveditz", "files": ["js/src/jit/MCallOptimize.cpp"], "git_node": null, "git_parents": [null], "node": "b8f5c37486e15c509594417c517e834944ac602a", "parents": ["4808fcb2e6ca2decb8cebb2b7a2797d212466bc7"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "1494405 - Disable Race Cache With Network, cached content load broken in conjunction with NTLM/Negotiate/Kerberos. r=michal, a=RyanVM", "files": ["modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "a7c86401998b88ec69fb4b132ee5c253334efb28", "parents": ["b8f5c37486e15c509594417c517e834944ac602a"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1489785: Remove a workaround for gcc, introduced in bug 678607, that is no longer needed and that causes hangs in modal dialogs on macOS 10.14. r=mstange, a=jcristau", "files": ["widget/coc