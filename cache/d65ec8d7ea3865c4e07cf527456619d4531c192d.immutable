ull, "git_parents": [null], "node": "3f8d57d936eade9abea32e351f27a5add0a5c266", "parents": ["098585dc86fc54509885626fc7dcf6c451e8d808"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1423278 - Correctly instantiate proxy authenticator with a lowercase schema. r=jduell, a=RyanVM", "files": ["netwerk/protocol/http/nsHttpChannelAuthProvider.cpp"], "git_node": null, "git_parents": [null], "node": "878ceaee563475ae5713c9bc386d14a199626e79", "parents": ["3f8d57d936eade9abea32e351f27a5add0a5c266"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1442010 - Check if the frame has been destroyed before calling UpdateFollowAnchor. r=tn, a=RyanVM", "files": ["layout/xul/nsXULPopupManager.cpp"], "git_node": null, "git_parents": [null], "node": "87be1b98ec9a2f1f0e4f12814789f059d526ac8f", "parents": ["878ceaee563475ae5713c9bc386d14a199626e79"], "tags": []}], "date": 1538682102, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "197": {"changesets": [{"author": "Mats Palmgren \u003cmats@mozilla.com\u003e", "branch": "default", "desc": "Bug 1484559 - Ensure that the scroll frame deregister its refresh driver observers (mAsyncScroll & mAsyncSmoothMSDScroll) before it's destroyed. r=dholbert, a=RyanVM", "files": ["layout/generic/nsGfxScrollFrame.cpp"], "git_node": null, "git_parents": [null], "node": "99e58b5307cec954f11237aa3e0687d1f8ba4a1b", "parents": ["87be1b98ec9a2f1f0e4f12814789f059d526ac8f"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1477268 - Use window manager decorations instead of CSD mode on Unity. r=jhorak, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4746", "files": ["widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "4dbc167132b379d2f9f1cf84310afe379921a0e8", "parents": ["99e58b5307cec954f11237aa3e0687d1f8ba4a1b"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1487098 - Reorder boolean expression to take advantage of short-circuiting. r=decoder, a=RyanVM", "files": ["extensions/spellcheck/src/mozEnglishWordUtils.cpp"], "git_node": null, "git_parents": [null], "node": "f25ce451a492a6338554e3a3aaadf96d4da25835", "parents": ["4dbc167132b379d2f9f1cf84310afe379921a0e8"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1484905 - Don't mark MGetFirstDollarIndex as movable. r=arai, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4879", "files": ["js/src/jit-test/tests/ion/bug1484905.js", "js/src/jit/MIR.h"], "git_node": null, "git_parents": [null], "node": "35c26bc231dfa0abcb67fe8513a57cced315900a", "parents": ["f25ce451a492a6338554e3a3aaadf96d4da25835"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1483487 - Add assertions around creating and retrieving DOM proxy expando objects. r=peterv, a=RyanVM", "files": ["dom/bindings/Codegen.py", "dom/bindings/DOMJSProxyHandler.cpp"], "git_node": null, "git_parents": [null], "node": "a8f720d6e51e22f7aa9862445e9003a6f66c3e37", "parents": ["35c26bc231dfa0abcb67fe8513a57cced315900a"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1481844 - Clear expando for objects with an ExpandoAndGeneration before wrapping. r=bz, a=RyanVM", "files": ["dom/bindings/Codegen.py"], "git_node": null, "git_parents": [null], "node": "563a3c11bb883dad5ce572d6511bea9836cc90c5", "parents": ["a8f720d6e51e22f7aa9862445e9003a6f66c3e37"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1484783 - Ensure to read the default stride when hardware acceleration isn't usable. r=mattwoodrow, a=RyanVM\n\nOn some platforms where a hardware decoder is present, but non functioning, we would fail to initialize the video stride, leading to the frames being incorrectly displayed later.\n\nAlso delete the DXVA2 manager early under those circumstances\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5402", "files": ["dom/media/platforms/wmf/WMFVideoMFTManager.cpp"], "git_node": null, "git_parents": [null], "node": "91653d2bc3acf89d590dbf5033c6b7abd4e1e60b", "parents": ["563a3c11bb883dad5ce572d6511bea9836cc90c5"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1488061 - Remove Query/Ref from the directory listing URI. r=bagder, a=RyanVM", "files": ["netwerk/streamconv/converters/nsIndexedToHTML.cpp"], "git_node": null, "git_parents": [null], "node": "050d0cfa8e3da3f08204d89b574a7a340290c900", "parents": ["91653d2bc3acf89d590dbf5033c6b7abd4e1e60b"], "tags": []}], "date": 1538687062, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "198": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 563a3c11bb88 (bug 1481844)", "files": ["dom/bindings/Codegen.py"], "git_node": null, "git_parents": [null], "node": "976fc330c260cc583009bc9d3f0d86dae4b2a4f1", "parents": ["050d0cfa8e3da3f08204d89b574a7a340290c900"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset a8f720d6e51e (bug 1483487) for assertions and rooting hazards.", "files": ["dom/bindings/Codegen.py", "dom/bindings/DOMJSProxyHandler.cpp"], "git_node": null, "git_parents": [null], "node": "999249ba5dac930e6d589471c38459be1f867234", "parents": ["976fc330c260cc583009bc9d3f0d86dae4b2a4f1"], "tags": []}], "date": 1538690857, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "199": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1434963 - Part 1: Change Gecko_ImageValue_Create to take a CORS mode argument. r=emilio, a=RyanVM", "files": ["layout/style/ServoBindings.cpp", "layout/style/ServoBindings.h", "layout/style/ServoBindings.toml", "servo/components/style/gecko/url.rs"], "git_node": null, "git_parents": [null], "node": "1e6dad87efedf0066ea2e0b1658eca7623ee99cf", "parents": ["999249ba5dac930e6d589471c38459be1f867234"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1434963 - Part 2: Expand the Parser trait to allow anonymous CORS to be applied. r=emilio, a=RyanVM", "files": ["servo/components/style/gecko/url.rs", "servo/components/style/values/specified/basic_shape.rs", "servo/components/style/values/specified/image.rs"], "git_node": null, "git_parents": [null], "node": "6558c46df9ea1fcca6af257e66f7444f3993458e", "parents": ["1e6dad87efedf0066ea2e0b1658eca7623ee99cf"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1434963 - Part 3: Remove style struct mutation in nsStyleDisplay::FinishStyle. r=emilio, a=RyanVM", "files": ["layout/style/nsCSSValue.cpp", "layout/style/nsCSSValue.h", "layout/style/nsRuleNode.cpp", "layout/style/nsStyleStruct.cpp"], "git_node": null, "git_parents": [null], "node": "686fcfa8abd60fa8fc0e8c0096edcac9ac7337c6", "parents": ["6558c46df9ea1fcca6af257e66f7444f3993458e"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1491132 - Clamp cache reads to content size. r=gerald, a=RyanVM\n\nPrior bug 1416085, reads were clamped to the content's duration (if known). It appears that the new code relied on MediaCacheReadBlockFromCache to properly account for the end of content.\n\nHowever, this was not the case, the MediaCache always reads (and write) one full block at a time regardles of the size requested (a block is 32768 bytes).\n\nRather than clamping in the Read() method as it used to be, we clamp in ReadBlockFromCache as such safety will benefit other callers that would have otherwise also returned garbage reads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5964", "files": ["dom/media/MediaCache.cpp"], "git_node": null, "git_parents": [null], "node": "14120e0c74d645d92ad9866e0968fdbd3fdbc745", "parents": ["686fcfa8abd60fa8fc0e8c0096edcac9ac7337c6"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1490264 - Part 1: Correct Windows installer SFX stub vendor and description. r=agashlin, a=RyanVM", "files": ["other-licenses/7zstub/firefox/7zSD.sfx"], "git_node": null, "git_parents": [null], "node": "d4f41a5cc9ff8be9f013f7175f20aff71dca2a08", "parents": ["14120e0c74d645d92ad9866e0968fdbd3fdbc745"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1490264 - Part 2: Document our SFX stub version resource edits. r=agashlin, a=NPOTB\n\nAlso take the opportunity to add specific instructions about how to rebuild 7zSD.sfx.", "files": ["other-licenses/7zstub/README.mozilla"], "git_node": null, "git_parents": [null], "node": "6ebbb97cc49c167e9e9092fdd8f90d18f071a743", "parents": ["d4f41a5cc9ff8be9f013f7175f20aff71dca2a08"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1490234 - Make permissions specific for Windows shared memory handle. r=jld, a=RyanVM", "files": ["ipc/chromium/src/base/shared_memory.h", "ipc/chromium/src/base/shared_memory_win.cc"], "git_node": null, "git_parents": [null], "node": "bc1fac09465e6c8b069d6f7f2b44447f29f6092e", "parents": ["6ebbb97cc49c167e9e9092fdd8f90d18f071a743"], "tags": []}], "date": 1538691162, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "200": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1492065 - Use Swizzle fallback when SSE2 is not supported. r=lsalzman, a=RyanVM\n\nThe same is done for NEON, and the check folds to nothing when building\nwhen the build target supports SSE2 and runtime detection is not\nnecessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6129", "files": ["gfx/2d/Swizzle.cpp"], "git_node": null, "git_parents": [null], "node": "ec4b5969c6ae8d4e0ba4e0cee1651f83a3cec83f", "parents": ["bc1fac09465e6c8b069d6f7f2b44447f29f6092e"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1492064 - Disable baseline JIT when SSE2 is not supported at runtime. r=jandem, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6219", "files": ["js/src/jit/BaselineJIT.h"], "git_node": null, "git_parents": [null], "node": "528cabdd966511ef04c7045ead69c7959eb3468e", "parents": ["ec4b5969c6ae8d4e0ba4e0cee1651f83a3cec83f"], "tags": []}, {"author": "Andrew Johnson \u003cajohnson@draster.com\u003e", "branch": "default", "desc": "Bug 1489757 - Bug 1448863 causes video streams to take a very long time to recover from packet loss. r=bwc, a=RyanVM\n\nThis patch sets mDecoderStatus from the GMPThread so we can eventually report\nan error back to the caller. Since this done during an asynchronous call, there\nis no guarantee that the error will be associated with the correct frame, but\nthis workaround should eventually cause an error to be signalled, so that a\nPLI can be requested and video will not freeze.", "files": ["media/webrtc/signaling/src/media-conduit/WebrtcGmpVideoCodec.cpp", "media/webrtc/signaling/src/media-conduit/WebrtcGmpVideoCodec.h"], "git_node": null, "git_parents": [null], "node": "46f19852aaa66bbf1f1b2af1d1c47d38d6506da5", "parents": ["528cabdd966511ef04c7045ead69c7959eb3468e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492897 - Fix spidermonkey build on mips32 without ion. r=dragan.mladjenovic, a=RyanVM\n\nAtomicOperations-mips-shared.h is included unconditionally when building for\nmips, but uses the JS_CODEGEN_MIPS32 macro for \"am I on 32bit\".  However that\nmacro isn't defined when ion is disabled, so we run into static assert\nfailures.", "files": ["js/src/jit/mips-shared/AtomicOperations-mips-shared.h"], "git_node": null, "git_parents": [null], "node": "c3a48066f3834cf7525e25c98331ff180eb54159", "parents": ["46f19852aaa66bbf1f1b2af1d1c47d38d6506da5"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492915 - Stop WebMDemuxer from inspecting partially encrypted packets for keyframe information. r=jya, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6415", "files": ["dom/media/webm/WebMDemuxer.cpp"], "git_node": null, "git_parents": [null], "node": "2d280e5573314dc5b729de7fced18922566ce7c0", "parents": ["c3a48066f3834cf7525e25c98331ff180eb54159"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1443748 - Delete resolver on main thread. r=jld, a=RyanVM", "files": ["netwerk/protocol/res/ExtensionProtocolHandler.cpp"], "git_node": null, "git_parents": [null], "node": "b80f94262165a28bc700d9513eab33d03e667afc", "parents": ["2d280e5573314dc5b729de7fced18922566ce7c0"], "tags": []}, {"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492484 - Do not reprioritize pushed streams on tab switch. r=kershaw, a=RyanVM\n\nRight now, pushed streams don't get put in the priority hierarchy\nanyway, and with the code as it was, we were sending an illegal PRIORITY\nframe for stream 0. This prevents that from happening. We should\nprobably think about putting pushed streams in the priority hierarchy at\nsome point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6500", "files": ["netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Stream.cpp"], "git_node": null, "git_parents": [null], "node": "1b3e6759cf3a39c85059504ae336621c7f453b62", "parents": ["b80f94262165a28bc700d9513eab33d03e667afc"], "tags": []}], "date": 1538700287, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "201": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1418470 - Part 1: Provide a specialized parse_method for mask-image to use CORS. r=emilio, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5714", "files": ["servo/components/style/properties/longhand/svg.mako.rs", "servo/components/style/values/specified/image.rs"], "git_node": null, "git_parents": [null], "node": "2977ca068b3e0441f119212813cdaad3d6710934", "parents": ["1b3e6759cf3a39c85059504ae336621c7f453b62"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1418470 - Part 2: Add a test confirming that mask-image is blocked cross-origin. r=emilio, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5910", "files": ["layout/style/test/mochitest.ini", "layout/style/test/support/blue-100x100.png", "layout/style/test/test_mask_image_CORS.html"], "git_node": null, "git_parents": [null], "node": "6894c1f63891ba8013f221263e6bcfab8ecbdf0d", "parents": ["2977ca068b3e0441f119212813cdaad3d6710934"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1493590 - Fix crash in GPUVideoImage::GetData. r=mattwoodrow, a=RyanVM\n\nThe texture client bound in a GPUVideoImage can be destroyed underneath\nit if the GPU process crashed and was restarted. This is because the\nImageBridgeChild singleton will destroy any textures bound to it before\nreinitializing itself. If there is a race to access a now stale\nGPUVideoImage object, we could accidently dereference the underlying\nTextureData which is now null in the TextureClient which was kept alive\nin the GPUVideoImage object. Now we check to make sure the TextureData\nis still there before accessing.", "files": ["gfx/layers/GPUVideoImage.h"], "git_node": null, "git_parents": [null], "node": "d9fe3b2025fc29e894eb17bcaeaae38c6727307e", "parents": ["6894c1f63891ba8013f221263e6bcfab8ecbdf0d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@jesup.org\u003e", "branch": "default", "desc": "Bug 1493347 - Drop DataChannelListener on Destroy(). r=drno, a=RyanVM", "files": ["netwerk/sctp/datachannel/DataChannel.cpp"], "git_node": null, "git_parents": [null], "node": "20c59797e994aeba6fb83ac0e9e57d7568c8afc9", "parents": ["d9fe3b2025fc29e894eb17bcaeaae38c6727307e"], "tags": []}, {"author": "Mats Palmgren \u003cmats@mozilla.com\u003e", "branch": "default", "desc": "Bug 1490561 - Make sure we remove our RefreshDriver observers in CompleteAsyncScroll. r=emilio, a=RyanVM", "files": ["layout/generic/nsGfxScrollFrame.cpp", "layout/generic/nsGfxScrollFrame.h"], "git_node": null, "git_parents": [null], "node": "1749661dfd2865a002d60d70d490eb21e9807326", "parents": ["20c59797e994aeba6fb83ac0e9e57d7568c8afc9"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1483905 - Ensure the WebAuthnManager stays alive while WebAuthnTransactionChild is using it. r=qdot, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D5305", "files": ["dom/webauthn/WebAuthnTransactionChild.cpp", "dom/webauthn/tests/get_assertion_dead_object.html", "dom/webauthn/tests/mochitest.ini", "dom/webauthn/tests/test_webauthn_get_assertion_dead_object.html"], "git_node": null, "git_parents": [null], "node": "a511a92424064dd608fdd41003065e5cfcd250c8", "parents": ["1749661dfd2865a002d60d70d490eb21e9807326"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1495404 - Postpone dbus_bus_get() call until we need it at WakeLockListener::Callback(). r=jhorak, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7281", "files": ["widget/gtk/WakeLockListener.cpp", "widget/gtk/WakeLockListener.h"], "git_node": null, "git_parents": [null], "node": "3232bb3b622ff70ddb3e5471ef165e8c6c841a8f", "parents": ["a511a92424064dd608fdd41003065e5cfcd250c8"], "tags": []}], "date": 1538703595, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "202": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1422583 - [marionette] Reset double click tracker when releasing actions. r=ato, a=test-only\n\nGiven that all internal states for the virtual devices are getting\ncleared when releasing actions, also the timer for double click\nevent detection has to be canceled.", "files": ["testing/marionette/listener.js"], "git_node": null, "git_parents": [null], "node": "cd57e28d75d973f803795530e0e046144cc2c25a", "parents": ["3232bb3b622ff70ddb3e5471ef165e8c6c841a8f"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1422583 - [wdspec] Add action tests for double click state when releasing action chain. r=ato, a=test-only\n\nThe click status of a mouse action has to be carried forward\nto the next \"Perform Actions\" call if the action sequence\nhasn't been reset before.", "files": ["testing/web-platform/meta/MANIFEST.json", "testing/web-platform/tests/webdriver/tests/actions/sequence.py"], "git_node": null, "git_parents": [null], "node": "4ae95536f4ce91db9eccc174f46258bef1c0d0ff", "parents": ["cd57e28d75d973f803795530e0e046144cc2c25a"], "tags": []}, {"author": "Adrian Bunk \u003cbunk@debian.org\u003e", "branch": "default", "desc": "Bug 1410545 - Fix sort_snans.js test on big endian. r=jwalden, a=test-only", "files": ["js/src/tests/non262/TypedArray/sort_snans.js"], "git_node": null, "git_parents": [null], "node": "bdb7e0b68550d0c3fbcf4d8597871efaf3bc9d91", "parents": ["4ae95536f4ce91db9eccc174f46258bef1c0d0ff"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1465388 - Resume about:blank parser upon unblocking the document. r=hsivonen, a=RyanVM\n\nWhen `document.blockParsing()` is called, the nsIParser is suspended\nuntil the document is unblocked. For about:blank documents, this is a\nnsParser.\n\nWhen a document is unblocked, nsParser::ContinueInterruptedParsingAsync\nis invoked, which delegates its implementation to nsIContentSink, which\nis a nsHTMLContentSink for about:blank documents. Due to a missing\nimplementation of nsHTMLContentSink::ContinueInterruptedParsingAsync,\nthe parser was never resumed, causing bug 1465388 and bug 1407501.\n\nThis patch fixes the problem, by implementing the required method (and\nusing a load blocker to ensure that the (about:blank) document does not\nfinish before the parser finishes).\n\nThis patch is tested through extension tests: Currently document_start\nstylesheets always activate the parser blocker, and document_start\nscripts trigger the parser blocker when the script has not been\npreloaded yet (e.g. at the first run).\nBefore this patch, the test failed due to the assertion failure as\nreported in the linked bugs. After this patch, the tests pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4352", "files": ["dom/base/nsDocument.cpp", "dom/html/nsHTMLContentSink.cpp", "toolkit/components/extensions/test/xpcshell/test_ext_contentscript_about_blank_start.js", "toolkit/components/extensions/test/xpcshell/xpcshell-content.ini"], "git_node": null, "git_parents": [null], "node": "a9577451dcc23b624d1154d5f35293aa3ef196f6", "parents": ["bdb7e0b68550d0c3fbcf4d8597871efaf3bc9d91"], "tags": []}], "date": 1538742898, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "203": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changesets 6894c1f63891 and 2977ca068b3e (bug 1418470) for longer bake time.", "files": ["layout/style/test/mochitest.ini", "layout/style/test/support/blue-100x100.png", "layout/style/test/test_mask_image_CORS.html", "servo/components/style/properties/longhand/svg.mako.rs", "servo/components/style/values/specified/image.rs"], "git_node": null, "git_parents": [null], "node": "caffbdbe307601c0234414b99d0c19e1c69f8ed9", "parents": ["a9577451dcc23b624d1154d5f35293aa3ef196f6"], "tags": []}], "date": 1538754201, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "204": {"changesets": [{"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1496159 - Don't try to load modules from the bytecode cache. r=nbp, a=abillings", "files": ["dom/script/ScriptLoader.cpp"], "git_node": null, "git_parents": [null], "node": "e965f6f6ed7548467f855cd697e4b70981029cff", "parents": ["caffbdbe307601c0234414b99d0c19e1c69f8ed9"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1445528 - Update 'cc' crate to version 1.0.9. r=jgraham, a=RyanVM\n\nThis patch was automatically generated by running the following commands:\n  $ cargo update -p cc\n  $ ./mach vendor rust\n\nMozReview-Commit-ID: 51NVIhtno6O", "files": ["Cargo.lock", "third_party/rust/cc/.cargo-checksum.json", "third_party/rust/cc/.travis.yml", "third_party/rust/cc/Cargo.toml", "third_party/rust/cc/src/com.rs", "third_party/rust/cc/src/lib.rs", "third_party/rust/cc/src/registry.rs", "third_party/rust/cc/src/setup_config.rs", "third_party/rust/cc/src/winapi.rs", "third_party/rust/cc/src/windows_registry.rs", "third_party/rust/cc/tests/cc_env.rs", "third_party/rust/cc/tests/support/mod.rs", "third_party/rust/cc/tests/test.rs"], "git_node": null, "git_parents": [null], "node": "8a503e022a29eada8397af73854e485f2040fe8a", "parents": ["e965f6f6ed7548467f855cd697e4b70981029cff"], "tags": []}, {"author": "philipp \u003cmadperson@gmx.at\u003e", "branch": "default", "desc": "Bug 1465787 - Add nviewh64.dll to the dll blocklist. r=marco, a=RyanVM", "files": ["mozglue/build/WindowsDllBlocklist.cpp"], "git_node": null, "git_parents": [null], "node": "b29d54f3b75264e4e80aa22b8175f6870d47fab0", "parents": ["8a503e022a29eada8397af73854e485f2040fe8a"], "tags": []}, {"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1409570 - Ensure that transactions matched with http/2 pushed streams are properly finished. r=bagder, a=RyanVM\n\nThere was an earlier fix to this, that fixed part of the issue, but that\nfix was racy. In the case where the transaction was matched with the\npushed stream before the pushed stream received its END_STREAM, and the\nresponse headers did not include a content-length, the transaction would\nnever notice that the data was done being sent. When that transaction\nwas necessary for the load event to fire, the page would get stuck in\nthe loading state until the user explicitly cancelled.\n\nThis new patch ensures that the transaction will notice the EOS by\nmaking sure the pushed stream gets inserted into the list of push\nstreams with data in the case described above. (The previous patch,\nwhich is still in the tree, is still necessary, but not sufficient, to\nfix the issue.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7298", "files": ["netwerk/protocol/http/Http2Session.cpp"], "git_node": null, "git_parents": [null], "node": "8d326641d1c0c8ee56078636416d80ca4d5c6d9d", "parents": ["b29d54f3b75264e4e80aa22b8175f6870d47fab0"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1496094 - Fix determining the correct target path of a reparse point. r=rstrong, a=RyanVM\n\nThe two standard reparse data buffer structs (SymbolicLinkReparseBuffer and\nMountPointReparseBuffer) both contain one UTF-16 array called PathBuffer which\ncontains two paths, the \"print name\" and the \"substitute name\", with no\nseparator between them. There are also fields in the struct that provide the\noffset and the length of both those paths (in bytes).\n\nI had originally missed that these were separate paths and that the print name\nwill typically not match the substitute name for file system links. This patch\ncorrects that oversight and uses the offsets to correctly check only the\nsubstitute name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7645", "files": ["toolkit/mozapps/update/common/updatecommon.cpp"], "git_node": null, "git_parents": [null], "node": "6cdd6d88eca96f6b0725b46c7768997aece49e2b", "parents": ["8d326641d1c0c8ee56078636416d80ca4d5c6d9d"], "tags": []}], "date": 1538829891, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "205": {"changesets": [{"author": "Jan Beich \u003cjbeich@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1496733 - Explicitly install libXt on FreeBSD. r=froydnj, a=NPOTB", "files": ["python/mozboot/mozboot/freebsd.py"], "git_node": null, "git_parents": [null], "node": "7bb6996ff6602e84d4a16eb36be9140b6b14c610", "parents": ["6cdd6d88eca96f6b0725b46c7768997aece49e2b"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=jlund\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7992", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "e6cbfd0e8d4220402e0c4cdbb6dae029394db192", "parents": ["7bb6996ff6602e84d4a16eb36be9140b6b14c610"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1478843 - Consider HLS resources CORS cross-origin. r=jya, a=RyanVM", "files": ["dom/media/hls/HLSDecoder.cpp"], "git_node": null, "git_parents": [null], "node": "0fa07c704ca4391c3e609d9fd3b89d7aef48360e", "parents": ["e6cbfd0e8d4220402e0c4cdbb6dae029394db192"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1462162 - Filter local storage cache synchronization messages based on origin; r=asuth a=ritu\n\nThis patch adds a new IPDL protocol PBackgroundLocalStorageCache. It is used by LocalStorageCache object to broadcast changes in local storage cache to other content processes. Each origin has its own PBackgroundLocalStorageCache, so now we can notify content processes that actually have a local storage cache for given origin. This greatly improves performance and reduces memory footprint especialy when local storage changes carry big strings and/or happen very quickly (before this patch all child processes were blindly notified).", "files": ["dom/storage/LocalStorage.cpp", "dom/storage/LocalStorage.h", "dom/storage/LocalStorageCache.cpp", "dom/storage/LocalStorageCache.h", "dom/storage/LocalStorageManager.cpp", "dom/storage/PBackgroundLocalStorageCache.ipdl", "dom/storage/Storage.h", "dom/storage/StorageIPC.cpp", "dom/storage/StorageIPC.h", "dom/storage/moz.build", "ipc/glue/BackgroundChildImpl.cpp", "ipc/glue/BackgroundChildImpl.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h", "ipc/glue/PBackground.ipdl"], "git_node": null, "git_parents": [null], "node": "739e898cb7c84c79da0f64d14e4a52c398fa471c", "parents": ["0fa07c704ca4391c3e609d9fd3b89d7aef48360e"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1492764 - Set .left class to headerbar box element as Gtk+ does. r=jhorak, a=RyanVM\n\nGtk+ sets .left/.right classes to GtkBox element at GtkHeaderBar according to button placement (left/right).\nWe don't support that now so set .left at least to be compatible with themes - BlueMenta for instance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6657", "files": ["widget/gtk/WidgetStyleCache.cpp"], "git_node": null, "git_parents": [null], "node": "16310ab354528413048ffa3fd5caaad30909e3ff", "parents": ["739e898cb7c84c79da0f64d14e4a52c398fa471c"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1488803 - Don't allocate PendingAction twice. r=masayuki, a=RyanVM", "files": ["widget/windows/TSFTextStore.cpp"], "git_node": null, "git_parents": [null], "node": "9b669d047d5537adc60d190f9a15b3f5dd0931aa", "parents": ["16310ab354528413048ffa3fd5caaad30909e3ff"], "tags": []}], "date": 1539112597, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "206": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1496340 - Make sure each nsISupports is an nsIX509Cert in nsNSSCertList::Read. r=jcj, a=RyanVM\n\nReviewers: jcj\n\nTags: #secure-revision\n\nBug #: 1496340\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7803", "files": ["security/manager/ssl/nsNSSCertificate.cpp", "security/manager/ssl/tests/unit/test_cert_chains.js"], "git_node": null, "git_parents": [null], "node": "9d51e65c797a6d4c697d7ba437aa2e2911318d21", "parents": ["9b669d047d5537adc60d190f9a15b3f5dd0931aa"], "tags": []}, {"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1492524. r=dragana, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D6946", "files": ["netwerk/protocol/http/Http2Compression.cpp"], "git_node": null, "git_parents": [null], "node": "efc0596dd381a59185f608c54079f37b39dc7338", "parents": ["9d51e65c797a6d4c697d7ba437aa2e2911318d21"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1495011. r=baku, a=RyanVM\n\nMozReview-Commit-ID: 8d7DzFnZx4n\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7273", "files": ["dom/script/ScriptLoader.cpp"], "git_node": null, "git_parents": [null], "node": "c4fb48bb5d282dd53d4536a8eadd3314ee0ef7d0", "parents": ["efc0596dd381a59185f608c54079f37b39dc7338"], "tags": []}, {"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "default", "desc": "Bug 1483699 - Part 1: Add overflow checks for extending arrays. r=mccr8, a=RyanVM", "files": ["xpcom/ds/nsTArray-inl.h", "xpcom/ds/nsTArray.h"], "git_node": null, "git_parents": [null], "node": "b3359becd7b11663b749dfc07a056ec1861a6d07", "parents": ["c4fb48bb5d282dd53d4536a8eadd3314ee0ef7d0"], "tags": []}, {"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "default", "desc": "Bug 1483699 - Part 2: Make InsertSlotsAt error checking more thorough. r=mccr8, a=RyanVM\n\nI don't know what the existing code was trying to do, but it certainly\nwasn't clear, and possibly not correct.", "files": ["xpcom/ds/nsTArray-inl.h", "xpcom/ds/nsTArray.h"], "git_node": null, "git_parents": [null], "node": "791c8ecf252dc79237e89cefd0dd4b5b81e0008f", "parents": ["b3359becd7b11663b749dfc07a056ec1861a6d07"], "tags": []}], "date": 1539113452, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "207": {"changesets": [{"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1494328 - Fix launchWebAuthFlow to use default redirect_uri. r=aswan, a=RyanVM\n\nSome oauth services require the redirect uri be configured on their service,\nand the reject the redirect_uri param if we send it.  Chrome works fine in this scenario,\nbut we have been requiring the redirect_uri be provided.  This addresses that requirement\nby using our own default redirect url, which would be the url used to configure the\noauth service.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8004", "files": ["toolkit/components/extensions/ext-c-identity.js", "toolkit/components/extensions/ext-identity.js", "toolkit/components/extensions/test/mochitest/redirect_auto.sjs", "toolkit/components/extensions/test/mochitest/test_ext_identity.html"], "git_node": null, "git_parents": [null], "node": "333276fac37c41030dd1307e8c9d67f252fdf539", "parents": ["791c8ecf252dc79237e89cefd0dd4b5b81e0008f"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1487478 - Move MatchPattern normalization into classifyPermission. r=aswan, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D4707", "files": ["toolkit/components/extensions/Extension.jsm", "toolkit/components/extensions/schemas/manifest.json", "toolkit/components/extensions/schemas/permissions.json"], "git_node": null, "git_parents": [null], "node": "cb73374a0e4e46e6cffd4427f1e7312088113377", "parents": ["333276fac37c41030dd1307e8c9d67f252fdf539"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1492823 - Ensure user input suppression works correctly even after document.open. r=peterv, a=RyanVM", "files": ["dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsGlobalWindowOuter.cpp"], "git_node": null, "git_parents": [null], "node": "f6bb138ad0abad6c9cdd157872dd5728004fd012", "parents": ["cb73374a0e4e46e6cffd4427f1e7312088113377"], "tags": []}], "date": 1539199909, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "208": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8371", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "4e21e86dca78f4470fbd57dbb1dbcc8c0182df63", "parents": ["f6bb138ad0abad6c9cdd157872dd5728004fd012"], "tags": []}, {"author": "Jan Beich \u003cjbeich@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1497169 - Unbreak bundled libevent on FreeBSD 12. r=froydnj, a=NPOTB", "files": ["ipc/chromium/src/third_party/libevent/README.mozilla", "ipc/chromium/src/third_party/libevent/evutil_rand.c", "ipc/chromium/src/third_party/libevent/include/event2/util.h", "ipc/chromium/src/third_party/libevent/patches/openbsd-no-arc4random_addrandom.patch"], "git_node": null, "git_parents": [null], "node": "97ef270558e0915fe1c92b1ff4455d5276fbb9b6", "parents": ["4e21e86dca78f4470fbd57dbb1dbcc8c0182df63"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1483602 - Skip unnecessary content scripts. r=mixedpuppy, a=RyanVM", "files": ["toolkit/components/extensions/ExtensionPolicyService.cpp", "toolkit/components/extensions/extension-process-script.js"], "git_node": null, "git_parents": [null], "node": "f27145bd5502992cf5801c61bf4ef2463816a3e8", "parents": ["97ef270558e0915fe1c92b1ff4455d5276fbb9b6"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1471873 - Ensure that the updater and crashreporter app don't appear in the recent apps section of the Dock on macOS 10.14+. r=mstange, a=RyanVM", "files": ["toolkit/crashreporter/client/macbuild/Contents/Info.plist", "toolkit/mozapps/update/updater/macbuild/Contents/Info.plist.in"], "git_node": null, "git_parents": [null], "node": "6d3676c3ea4dfa4a67f943c61afcb02176cf1a3e", "parents": ["f27145bd5502992cf5801c61bf4ef2463816a3e8"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1467523 - Prevent setting host/origin to restricted domains. r=aswan, a=RyanVM", "files": ["toolkit/modules/addons/WebRequest.jsm"], "git_node": null, "git_parents": [null], "node": "133a99a8f3ca89d4c58c08b395c79712e5115303", "parents": ["6d3676c3ea4dfa4a67f943c61afcb02176cf1a3e"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1467523 - Followup fix for case insensitive header name check. r=aswan,robwu, a=RyanVM", "files": ["toolkit/modules/addons/WebRequest.jsm"], "git_node": null, "git_parents": [null], "node": "82176a4a9b143c5b052e1a3f7bd34a372af68f9f", "parents": ["133a99a8f3ca89d4c58c08b395c79712e5115303"], "tags": []}], "date": 1539286954, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "209": {"changesets": [{"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1474265 - Add missing semicolon at DBusRemoteClient.cpp. r=jhorak, a=jcristau\n\nMozReview-Commit-ID: HIz4gZOzfOE", "files": ["widget/xremoteclient/DBusRemoteClient.cpp"], "git_node": null, "git_parents": [null], "node": "e8abd9a8ce6e03e5c36b6b0f587459232da80091", "parents": ["82176a4a9b143c5b052e1a3f7bd34a372af68f9f"], "tags": []}], "date": 1539337702, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "210": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8710", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "531b83a2458b07468a6db65325163710a9ae8728", "parents": ["e8abd9a8ce6e03e5c36b6b0f587459232da80091"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1469486 - Protect main thread in-process access to WinCompositorWidget transparent surface. r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D7178", "files": ["widget/windows/InProcessWinCompositorWidget.cpp", "widget/windows/InProcessWinCompositorWidget.h"], "git_node": null, "git_parents": [null], "node": "7d99a574e21be7f10146ec7dd3f7ec7f4f9537af", "parents": ["531b83a2458b07468a6db65325163710a9ae8728"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1498433: Ensure that 