am Skia patches. r=lsalzman, a=abillings\n\nBackport of:\nhttps://skia.googlesource.com/skia/+/c3d8a48f1b27370049aa512019cd726c59354743\nhttps://skia.googlesource.com/skia/+/8051d38358293df1e5b8a1a513f8114147ec9fa3", "files": ["gfx/skia/skia/src/core/SkPath.cpp"], "git_node": null, "git_parents": [null], "node": "9461988ff462c85212381f2aedd9aac6bdb72131", "parents": ["023133ff02ec6ba3bd40af17240ad4ee2a99aa8a"], "tags": []}, {"author": "David Parks \u003cdparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1495245 - Refactor AudioDeviceMessageRunnable's use of the PluginModuleSet. r=jmathies, a=RyanVM\n\nChanges AudioDeviceMessageRunnable to hold the AudioNotification instead of its PluginModuleSet to simplify object lifetime issues. AudioNotification is ref-counted so we can increment its ref-count during the asynchronous Runnable.", "files": ["dom/plugins/ipc/PluginUtilsWin.cpp"], "git_node": null, "git_parents": [null], "node": "4a99c842c818a1fcd7153e67a1fb919a30654103", "parents": ["9461988ff462c85212381f2aedd9aac6bdb72131"], "tags": []}], "date": 1539728952, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "215": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1499075 - Adjust the number of OSX wpt chunks for more consistent runtimes with other platforms. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D8730", "files": ["taskcluster/ci/test/web-platform.yml"], "git_node": null, "git_parents": [null], "node": "366bd2c7c4f18bf5d8343a3d9ac98a5bd077b77f", "parents": ["4a99c842c818a1fcd7153e67a1fb919a30654103"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1469288 - Increase test chunks for linux/debug wpt. r=jmaher, a=test-only", "files": ["taskcluster/ci/test/web-platform.yml"], "git_node": null, "git_parents": [null], "node": "ac127e734ef35211e9a87fad4418b60f88