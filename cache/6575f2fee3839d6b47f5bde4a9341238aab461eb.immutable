utomatic version bump CLOSED TREE NO BUG a=release DONTBUILD", "files": ["mobile/android/config/version-files/beta/version_display.txt"], "git_node": null, "git_parents": [null], "node": "ed88a1e3f50cd6ba666084660b1a209c0872add6", "parents": ["9a11fbd804f33474bbcc1e6e1d5be0bb4a0c8f6b"], "tags": []}], "date": 1578502840, "git_changesets": [null, null], "user": "ffxbld"}, "737": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 8b51bf38ddbb00131188d833c1441bb37128634b with FENNEC_68_4_1_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "8a4c603a9d6f1c78ea3c3602918f692f3fd2555f", "parents": ["ed88a1e3f50cd6ba666084660b1a209c0872add6"], "tags": []}], "date": 1578503177, "git_changesets": [null], "user": "ffxbld"}, "738": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nes-AR -\u003e fb0b1fbf1fe2\nit -\u003e d03731a873d6\nko -\u003e f2cf23df3c25\nnl -\u003e 4f2af37d9059\nsr -\u003e b3fee596f116\nsv-SE -\u003e d57686b409f3\nuk -\u003e 8c941690e805", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "78f5546627ffb5a6a70026c076dd5f2da57560de", "parents": ["8a4c603a9d6f1c78ea3c3602918f692f3fd2555f"], "tags": []}], "date": 1578553082, "git_changesets": [null], "user": "ffxbld"}, "739": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nhi-IN -\u003e 685a650aef8e\nuk -\u003e fc79661a0904", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "72e0e7d13c409889e4215f1950cd2a51e29bc51a", "parents": ["78f5546627ffb5a6a70026c076dd