de": null, "git_parents": [null], "node": "96c5b4633718d19c4ddc310e467f45adc215269c", "parents": ["cc21936c152d401eea77ba7b6c3884ca525a9230"], "tags": []}], "date": 1579193616, "git_changesets": [null], "user": "ffxbld"}, "775": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D60140", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "9a2085376edbfb05fd0464b0d845f1a9320b7c17", "parents": ["96c5b4633718d19c4ddc310e467f45adc215269c"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1605945 - Check if stumbling is allowed before starting StumblerService. r=VladBaicu, a=RyanVM\n\nOtherwise on Oreo+ devices we would show a \"Mozilla Location Service\"\nnotification for a brief time before checking that stumbling is not allowed\nand dismissing the notification, creating confusion for the users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D59878", "files": ["mobile/android/stumbler/java/org/mozilla/mozstumbler/service/mainthread/LocalPreferenceReceiver.java", "mobile/android/stumbler/java/org/mozilla/mozstumbler/service/mainthread/SystemReceiver.java", "mobile/android/stumbler/java/org/mozilla/mozstumbler/service/stumblerthread/StumblerService.java"], "git_node": null, "git_parents": [null], "node": "3be46594566812270c790b98508b862c201cabf4", "parents": ["9a2085376edbfb05fd0464b0d845f1a9320b7c17"], "tags": []}, {"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1599420 - Ensure that strong references to newly created cursors are kept until the DOM Binding is created. r=janv, a=RyanVM\n\nTest Plan:\nThis uplifts the change from Bug 1599420, which was relevant here only in the `BackgroundCursorChild::HandleResponse(const nsTArray\u003cObjectStoreCursorResponse\u003e& aResponses)` overload, which was the only one having an inner loop. The bug had been introduced by https://hg.mozilla.org/releases/mozilla-esr68/rev/1f31c24e2ca0bf2960c98de55396072ce6c46323 in FF43\n\nDifferential Revision: https://phabricator.services.mozilla.com/D59686", "files": ["dom/indexedDB/ActorsChild.cpp"], "git_node": null, "git_parents": [null], "node": "65564456e04aa88cc7de46914fbb590cd580b7a2", "parents": ["3be46594566812270c790b98508b862c201cabf4"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1608785 - Remove MClassConstructor::getAliasSet. r=tcampbell, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D59860", "files": ["js/src/jit/MIR.h"], "git_node": null, "git_parents": [null], "node": "ffe5efb8f46e141281c46eed3fb81a452cb9055f", "parents": ["65564456e04aa88cc7de46914fbb590cd580b7a2"], "tags": ["FENNEC_68_5b4_BUILD2", "FENNEC_68_5b4_RELEASE"]}], "date": 1579210805, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "776": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nbr -\u003e f36618f7de6a\ncs -\u003e 076bc8704762\ncy -\u003e 6373f4869100\ndsb -\u003e ecaa06441e1e\nen-CA -\u003e 50382c2f5e1b\nfy-NL -\u003e 06d4e9c1e4b9\nhe -\u003e fa5fa47c06fd\nhsb -\u003e fbd6c92b7eaa\nko -\u003e 1f1d02ff83a3\nnb-NO -\u003e d33318db5959\nnl -\u003e 18733efff0e6\nro -\u003e e42e27b16e4f\nsk -\u003e 1cdc433bcf79\nsv-SE -\u003e 1dec7a0102fd\nth -\u003e bba7947d52f4", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "9b182a5e7a7f57ba0f144b58a0d002247275b395", "parents": ["ffe5efb8f46e141281c46eed3fb81a452cb9055f"], "tags": []}], "date": 1579269353, "git_changesets": [null], "user": "ffxbld"}, "777": {"changesets": [{"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_4_X_RELBRANCH", "desc": "Bug 1601905 - Add quotes for a path including whitespaces in ShellExecuteWithIFile. r=aklotz, a=RyanVM\n\nA fix for Bug 1588975 replaced the call to `LaunchWithIProcess` in\n`nsMIMEInfoWin::LaunchWithFile` with the call to `ShellExecuteWithIFile` to use\n`mozilla::ShellExecuteByExplorer`.  This caused a regression that if a filepath\ncontains whitespaces, we pass it to a target application without quoting it\nwhile the old codepath `ShellExecuteWithIFile` quoted a path accordingly in\n`assembleCmdLine`.\n\nA proposed fix is to quote a path in the same way as `assembleCmdLine` does.\nThis patch also moves `assembleCmdLine` to an exported header so that we can add\na unittest to cover both of `assembleCmdLine` and a new function\n`assembleSingleArgument.  It would be better to refactor these functions in the\nfuture because many lines are duplicated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56646", "files": ["toolkit/xre/AssembleCmdLine.h", "toolkit/xre/moz.build", "toolkit/xre/test/gtest/TestAssembleCommandLineWin.cpp", "toolkit/xre/test/gtest/moz.build", "uriloader/exthandler/win/nsMIMEInfoWin.cpp", "xpcom/threads/nsProcessCommon.cpp"], "git_node": null, "git_parents": [null], "node": "8fb71d4399777dcbe94f9a58ef061d87520a6ab5", "parents": ["8b51bf38ddbb00131188d833c1441bb37128634b"], "tags": []}, {"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_4_X_RELBRANCH", "desc": "Bug 1602726 - Fall back to ShellExecuteEx if ShellExecuteByExplorer fails.  r=aklotz a=RyanVM\n\nIt turned out that `ShellExecuteByExplorer` does not work on VDI such as Citrix\nor Microsoft RemoteApp.  This patch adds a fallback to the original launching\ncode if `ShellExecuteByExplorer` fails.  This will be a temporary solution until\nwe find out a way to solve both interop issues `PreferSystem32Images` and VDI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D58054", "files": ["uriloader/exthandler/win/nsMIMEInfoWin.cpp", "uriloader/exthandler/win/nsMIMEInfoWin.h", "xpcom/io/nsLocalFileWin.cpp"], "git_node": null, "git_parents": [null], "node": "20ab1567df2b04f11625bac2ce8fe2984c4c08eb", "parents": ["8fb71d4399777dcbe94f9a58ef061d87520a6ab5"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_4_X_RELBRANCH", "desc": "Bug 1607494 - Disable Ion for the PAC script thread. r=jandem, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D59558", "files": ["netwerk/base/ProxyAutoConfig.cpp"], "git_node": null, "git_parents": [null], "node": "ec4175ed144b80188abcba4486ee7f03dbc2cc06", "parents": ["20ab1567df2b04f11625bac2ce8fe2984c4c08eb"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "FIREFOX_ESR_68_4_X_RELBRANCH", "desc": "Bug 1604249 - Add Leanplum user attribute for Master Password. r=VladBaicu, a=RyanVM\n\nAdded user attribute for master password preference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D57833", "files": ["mobile/android/base/java/org/mozilla/gecko/mma/MmaDelegate.java"], "git_node": null, "git_parents": [null], "node": "84850a10f9992c2a22382191de9e2956286b1dbf", "parents": ["ec4175ed144b80188abcba4486ee7f03dbc2cc06"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "FIREFOX_ESR_68_4_X_RELBRANCH", "desc": "Bug 1604490 - Enable Leanplum for users who have Master Password enabled. r=VladBaicu, a=RyanVM\n\nAdded additional condition in order to enable Leanplum for users that have Master Password enabled.\n\nDepends on D57833\n\nDifferential 