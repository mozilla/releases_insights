it_node": null, "git_parents": [null], "node": "2473f6eab15c4e5eaf7994ce35ba3e6f6ea97220", "parents": ["e8e9b0c94c394701e0dc8bc421efb056074bb5bf"], "tags": []}], "date": 1578680914, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "751": {"changesets": [{"author": "Junior Hsu \u003cjuhsu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1604851, r=dragana, a=RyanVM\n\nNo need to optimize one lock here since telemetry tells us only 1 out of 1m request with alt-svc\nhttps://searchfox.org/mozilla-central/rev/b243debf6235b050b42fd2eb615fdc729636ca6b/netwerk/protocol/http/nsHttpChannel.cpp#6670\n\nDifferential Revision: https://phabricator.services.mozilla.com/D57925", "files": ["netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h"], "git_node": null, "git_parents": [null], "node": "ef4b199de7b4c194540512c2aec4da69816d3f32", "parents": ["2473f6eab15c4e5eaf7994ce35ba3e6f6ea97220"], "tags": []}, {"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1602726 - Fall back to ShellExecuteEx if ShellExecuteByExplorer fails.  r=aklotz a=RyanVM\n\nIt turned out that `ShellExecuteByExplorer` does not work on VDI such as Citrix\nor Microsoft RemoteApp.  This patch adds a fallback to the original launching\ncode if `ShellExecuteByExplorer` fails.  This will be a temporary solution until\nwe find out a way to solve both interop issues `PreferSystem32Images` and VDI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D58054", "files": ["uriloader/exthandler/win/nsMIMEInfoWin.cpp", "uriloader/exthandler/win/nsMIMEInfoWin.h", "xpcom/io/nsLocalFileWin.cpp"], "git_node": null, "git_parents": [null], "node": "a871b86915454a1f3d43629b5e761b1a29ac1df0", "parents": ["ef4b199de7b4c194540512c2aec4da69816d3f32"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1608478 - Enable Leanplum for users who have master password enabled; r=petru, a=RyanVM\n\nThis fixes a recent regression that enabled all experiments for users that had\nmaster password enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D59534", "files": ["mobile/android/base/java/org/mozilla/gecko/switchboard/SwitchBoard.java"], "git_node": null, "git_parents": [null], "node": "632c2267777fa2aebd2bcaac89bc0c6f69dbc7e4", "parents": ["a871b86915454a1f3d43629b5e761b1a29ac1df0"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1601729 - Use different deeplink schemes depending on app channel. r=VladBaicu,RyanVM, a=RyanVM\n\nThis would allow us to send targeted push messages to specific applications\nand so protecting against the case in which the user has more apps installed,\nall trying to consume the just received push message which may not be intended\nfor the one that actually got to consume it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D58966", "files": ["mobile/android/base/AndroidManifest.xml.in"], "git_node": null, "git_parents": [null], "node": "27375dd57676f087b4e3c9947b7e43350b14cf93", "parents": ["632c2267777fa2aebd2bcaac89bc0c6f69dbc7e4"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1601729 - Validate the new schemes in code. r=VladBaicu, a=RyanVM\n\nNow that we have more deeplink schemes we need to make sure these are not\nrejected when validating a received Intent as a deeplink.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D59477", "files": ["mobile/android/base/java/org/mozilla/gecko/LauncherActivity.java", "mobile/android/base/java/org/mozilla/gecko/deeplink/DeepLinkContract.java"], "git_node": null, "git_parents": [null], "node": "f92856bebbf1b1b8a7bc1df917a2694efff6ae8a", "parents": ["27375dd57676f087b4e3c9947b7e43350b14cf93"], "tags": []}, {"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "default", "desc": "Bug 1601784 - Use a built-in \"Learn More\" link instead of custom nodes for the storage access prompt. r=ewright, a=RyanVM, l10n=flod", "files": ["browser/base/content/popup-notifications.inc", "browser/locales/en-US/chrome/browser/browser.properties", "browser/modules/PermissionUI.jsm"], "git_node": null, "git_parents": [null], "node": "3edf801b9317700e2937f57161e15735e7dad587", "parents": ["f92856bebbf1b1b8a7bc1df917a2694efff6ae8a"], "tags": []}], "date": 1578691624, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "752": {"changesets": [{"author": "Coroiu Cristina \u003cccoroiu@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset f92856bebbf1 (bug 1601729) for findbugs bustage at withoutGeckoBinariesDebug:MS_MUTABLE_COLLECTION a=backout", "files": ["mobile/android/base/java/org/mozilla/gecko/LauncherActivity.java", "mobile/android/base/java/org/mozilla/gecko/deeplink/DeepLinkContract.java"], "git_node": null, "git_parents": [null], "node": "92fc182ab07a770ec60c37cdc6eba1e7629a3057", "parents": ["3edf801b9317700e2937f57161e15735e7dad587"], "tags": []}], "date": 1578695297, "git_changesets": [null], "user": "ccoroiu@mozilla.com"}, "753": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ncs -\u003e 663c66cb8a65\nes-AR -\u003e adf45873baf0\nnn-NO -\u003e 165b9cbcfb46\npt-BR -\u003e 1a6b611b4a87\nrm -\u003e 44af4ff647df\nsk -\u003e 7b7d78d7664f\nsl -\u003e 9d360c861376\nur -\u003e dab5ba080518\nwo -\u003e 6a828c1c213c\nzh-CN -\u003e 739deb7e172a", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "df541f5ee90310dd50eb65895e0816bd05333416", "parents": ["92fc182ab07a770ec60c37cdc6eba1e7629a3057"], "tags": []}], "date": 1578725800, "git_changesets": [null], "user": "ffxbld"}, "754": {"