ae5c2796f0f80f", "parents": ["eca6dd107bf79270da8093873ea90313f198a55c"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1396185 - [wdspec] Use shared get_title function for making HTTP requests. r=ato\n\nMozReview-Commit-ID: 8gYWouT6K8q", "files": ["testing/web-platform/tests/webdriver/tests/navigation/get_title.py"], "git_node": null, "git_parents": [null], "node": "817f74ad9de08668dbb928632a21a985a65398b8", "parents": ["d8bfa9b99692a46f2875901c63ae5c2796f0f80f"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1396185 - [wdspec] Fix linter failures in get_title.py. r=ato\n\nMozReview-Commit-ID: KxrB69Bakcv", "files": ["testing/web-platform/tests/webdriver/tests/navigation/get_title.py"], "git_node": null, "git_parents": [null], "node": "c06b7fd656fb86b8c5f9e512e9bc592e13bad96b", "parents": ["817f74ad9de08668dbb928632a21a985a65398b8"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1396185 - [wdspec] Fix race condition in test_title_after_modification. r=ato, a=test-only\n\nUsing \"WebDriver:ExecuteScript\" to set the document title can cause\na race condition when the title gets retrieved from the parent process.\nTo guard against it \"wait()\" should be used.\n\nMozReview-Commit-ID: DyrHpQSKLjy", "files": ["testing/web-platform/tests/webdriver/tests/navigation/get_title.py"], "git_node": null, "git_parents": [null], "node": "3274916e9c7be879da3680fa0329a69403abdbf7", "parents": ["c06b7fd656fb86b8c5f9e512e9bc592e13bad96b"], "tags": []}], "date": 1525719223, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "26": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "bug 1408868 - back out the broken portions of cbdef048e40c. r=backout a=release", "files": ["testing/mozharness/configs/releases/bouncer_fennec.py", "testing/mozharness/configs/releases/bouncer_fennec_beta.py", "testing/mozharness/configs/releases/bouncer_firefox_beta.py", "testing/mozharness/configs/releases/bouncer_firefox_devedition.py", "testing/mozharness/configs/releases/bouncer_firefox_esr.py", "testing/mozharness/configs/releases/bouncer_firefox_release.py", "testing/mozharness/configs/releases/dev_bouncer_firefox_beta.py", "testing/mozharness/configs/releases/dev_bouncer_firefox_devedition.py", "testing/mozharness/configs/releases/dev_bouncer_firefox_esr.py"], "git_node": null, "git_parents": [null], "node": "f7e822f67a4490520630cc8271b948c0fa30d112", "parents": ["3274916e9c7be879da3680fa0329a69403abdbf7"], "tags": []}], "date": 1525798146, "git_changesets": [null], "user": "asasaki@mozilla.com"}, "27": {"changesets": [{"author": "\"Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e\"", "branch": "default", "desc": "No bug - Tagging e1c89bf28365823de83262354b17801158d9414f with FIREFOX_60_0esr_BUILD6, FIREFOX_60_0esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "89fe4f852dd226af2be9a3a41fe06449aa4ef23c", "parents": ["f7e822f67a4490520630cc8271b948c0fa30d112"], "tags": []}], "date": 1525874030, "git_changesets": [null], "user": "ffxbld"}, "28": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1430215 - Check on the principal in mozilla::dom::CheckSecurityForHTMLElements in case SurfaceFromElement returns an incomplete result. r=aosmond, a=RyanVM", "files": ["dom/canvas/ImageBitmap.cpp"], "git_node": null, "git_parents": [null], "node": "7037720f8b6bf6eeab0853c2cdbdd925cadc0f5a", "parents": ["89fe4f852dd226af2be9a3a41fe06449aa4ef23c"], "tags": []}, {"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1430215 - Update test expectations. a=RyanVM", "files": ["testing/web-platform/meta/2dcontext/imagebitmap/createImageBitmap-invalid-args.html.ini", "testing/web-platform/meta/MANIFEST.json"], "git_node": null, "git_parents": [null], "node": "7ff41cf175dc175adbdd39a8249b22beac6d8c16", "parents": ["7037720f8b6bf6eeab0853c2cdbdd925cadc0f5a"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1456071 - Do not dispatch InsertDTMFTone call to sts thread. r=bwc, a=RyanVM\n\nThis removes the dispatch to the sts thread prior to calling\nAudioConduit::InsertDTMFTone. There are assertions in ChannelProxy which\nrestrict the methods there to running on the main thread, so the current\ncode crashes immediately when inserting a tone in a debug build. The\ninserted DTMF event ends up in a queue, so there is no reason not to just do\nthe insertion from the main thread.\n\nMozReview-Commit-ID: G8JM9QDLrGF", "files": ["media/webrtc/signaling/src/media-conduit/AudioConduit.cpp", "media/webrtc/signaling/src/peerconnection/TransceiverImpl.cpp"], "git_node": null, "git_parents": [null], "node": "532f68d2f5b442812266fcc1499f1ca4721b0cde", "parents": ["7ff41cf175dc175adbdd39a8249b22beac6d8c16"], "tags": []}], "date": 1525960904, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "29": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1441507 - Fix window focus issue for intermittent browser_shim_disable_devtools. r=pbro, a=test-only\n\nMozReview-Commit-ID: 1e4NmJNdP3G", "files": ["devtools/shim/tests/browser/browser_shim_disable_devtools.js"], "git_node": null, "git_parents": [null], "node": "2d233d3c02be86bbcfc4cfc9c890b092a2b0fb5f", "parents": ["532f68d2f5b442812266fcc1499f1ca4721b0cde"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 962248 - Rewrite zoom test to be less terrible. r=dthayer, a=test-only\n\nMozReview-Commit-ID: ByUM61fsOgh", "files": ["browser/components/customizableui/test/browser_934951_zoom_in_toolbar.js", "browser/components/customizableui/test/head.js"], "git_node": null, "git_parents": [null], "node": "1496652b66f905579d9967f437bf3123deebea98", "parents": ["2d233d3c02be86bbcfc4cfc9c890b092a2b0fb5f"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458553 - Return of Google Maps all black map with updated Nvidia web driver on Mac. r=Alex_Gaynor, a=jcristau\n\nUpdate Mac sandbox rules to allow executable mappings from /Library/GPUBundles which is\nused by the Nvidia downloadable \"Web\" driver.\n\nMozReview-Commit-ID: L2nTP4YWdJJ", "files": ["security/sandbox/mac/SandboxPolicies.h"], "git_node": null, "git_parents": [null], "node": "b20c5c5180a7886d25c138d5577b68f1b112a911", "parents": ["1496652b66f905579d9967f437bf3123deebea98"], "tags": []}, {"author": "Kearwood Gilbert \u003ckgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459362 - Disable WebVR in release on macOS (Backed out changeset 1b24d52edebb). r=smaug, a=jcristau\n\nMozReview-Commit-ID: BMuGwXYP750", "files": ["dom/tests/mochitest/general/test_interfaces.js", "modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "275875c44e45866d23c7a00675847932f6d91321", "parents": ["b20c5c5180a7886d25c138d5577b68f1b112a911"], "tags": []}], "date": 1526302170, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "30": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459391 - Fix intermittent OSX vcversioner install error. r=tomprince, a=test-only", "files": ["testing/mozharness/configs/unittests/mac_unittest.py"], "git_node": null, "git_parents": [null], "node": "f8098a5cd01049b989be5a0449e5d62b47c2943c", "parents": ["275875c44e45866d23c7a00675847932f6d91321"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1457743 - Fix check for entering momentum-scrolling codepath after both fingers are released in a two-finger pan. r=kats, a=jcristau\n\nMozReview-Commit-ID: 587mYzBf2aB", "files": ["gfx/layers/apz/src/AsyncPanZoomController.cpp"], "git_node": null, "git_parents": [null], "node": "53b88f7b99821a4daf900615e250f2e09eb104f8", "parents": ["f8098a5cd01049b989be5a0449e5d62b47c2943c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458956 - Fix selectors for tabbrowser to use -moz-default-background-color as its default background in high contrast mode. r=mconley, a=jcristau\n\nMozReview-Commit-ID: ICjWQg64Wjx", "files": ["browser/themes/windows/browser.css"], "git_node": null, "git_parents": [null], "node": "d5595a55f4c1d19ebbcf5a0206d5937b92137e7e", "parents": ["53b88f7b99821a4daf900615e250f2e09eb104f8"], "tags": []}], "date": 1526319864, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "31": {"changesets": [{"author": "Ricky Rosario \u003crickyrosario@gmail.com\u003e", "branch": "default", "desc": "Bug 1458906 - A \"Sponsored content\" card is wrongly displayed on the first new tab opened, after the \"Sponsored Stories\" option was unchecked. r=k88hudson, a=jcristau\n\nMozReview-Commit-ID: 40XhoB5t7IG", "files": ["browser/extensions/activity-stream/lib/TopStoriesFeed.jsm", "browser/extensions/activity-stream/test/unit/lib/TopStoriesFeed.test.js"], "git_node": null, "git_parents": [null], "node": "423e30150b9a962f5ad50da561b4ab45e4cbd4a0", "parents": ["d5595a55f4c1d19ebbcf5a0206d5937b92137e7e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1449033 - Set new group unknown flag on placeholder prototypes where necessary. r=jandem, a=ritu", "files": ["js/src/gc/GC.cpp", "js/src/vm/GlobalObject.cpp"], "git_node": null, "git_parents": [null], "node": "0ff2170567cb3e45bb2f82e21cbc9d0cdfb20939", "parents": ["423e30150b9a962f5ad50da561b4ab45e4cbd4a0"], "tags": []}], "date": 1526325086, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "32": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1436662: Package translated uninstaller; r=pike,mshal a=jcristau\n\nThe uninstaller was being built as a side-effect of building `setup.exe`. In\nBug 1385227, that was moved from \"somewhere\" to part of the windows installer\npackaging, which happens after the zip and mar are generated. Since the\ninstaller we ship is actually repackaged from the zip[1], we stopped shipping\ntranslated uninstallers.\n\nThis changes things around so that the uninstaller gets translated:\n- Explicitly build the uninstaller as part of the L10n repack step.\n- Use the same logic to build the installer locally as we do to create the ones\n  we ship.\n\n[1] Except on Thunderbird\n\nDifferential Revision: https://phabricator.services.mozilla.com/D672", "files": ["browser/build.mk", "browser/installer/Makefile.in", "browser/installer/windows/Makefile.in", "browser/locales/Makefile.in", "config/config.mk", "toolkit/locales/l10n.mk", "toolkit/mozapps/installer/packager.mk", "toolkit/mozapps/installer/windows/nsis/makensis.mk"], "git_node": null, "git_parents": [null], "node": "f1193936462789453efaf9f07737cf2a95533edf", "parents": ["0ff2170567cb3e45bb2f82e21cbc9d0cdfb20939"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1436662: Remove `installer` MOZ_AUTOMATION stage; r=mshal a=jcristau\n\nThe previous commit moved creating installers to be side effect of creating\npackages. This makes the installer step not actually do anything. So remove the\nstep from automation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D864", "files": ["build/moz-automation.mk", "build/mozconfig.automation", "build/mozconfig.win-common", "mobile/android/config/mozconfigs/android-api-16-frontend/nightly", "mobile/android/config/mozconfigs/android-api-16-gradle-dependencies/nightly"], "git_node": null, "git_parents": [null], "node": "0619e26054d753c6e7c90c5e5d2906f3037cff4b", "parents": ["f1193936462789453efaf9f07737cf2a95533edf"], "tags": []}], "date": 1526407616, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}, "33": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1436662 - Fix Thunderbird support for building windows packages. r=mshal, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D991", "files": ["toolkit/mozapps/installer/windows/nsis/makensis.mk"], "git_node": null, "git_parents": [null], "node": "d4ddbb9e06c82bc653f07cab9692254ff28c7b0b", "parents": ["0619e26054d753c6e7c90c5e5d2906f3037cff4b"], "tags": []}, {"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1461590 - Lower-case hostnames when adding substitutions. r=smaug, f=dveditz, a=RyanVM\n\nSince URI hostnames are defined to be case-insensitive, we only ever see\nlower-case hostnames when looking up substitutions. That means that\nsubstitutions containing capital letters are inaccessible, which is a footgun\nthat has hit many people.\n\nThe handler should lower-case substitutions when they're added so that\nlook-ups are always case-insensitive.\n\nMozReview-Commit-ID: C936hS2cSyY", "files": ["netwerk/protocol/res/SubstitutingProtocolHandler.cpp", "netwerk/protocol/res/nsISubstitutingProtocolHandler.idl", "netwerk/test/unit/test_substituting_protocol_handler.js", "netwerk/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "c9846ca8c38f421be13baa5bf0d479b9637e806f", "parents": ["d4ddbb9e06c82bc653f07cab9692254ff28c7b0b"], "tags": []}], "date": 1526420653, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "34": {"changesets": [{"author": "Justin Wood callek@mozilla.com", "branch": "default", "desc": "Bug 1455337 - Set min version appropriately for language packs. r=gps, a=testing", "files": ["python/mozbuild/mozbuild/action/langpack_manifest.py"], "git_node": null, "git_parents": [null], "node": "f7f40b6cf8cfc0d7a84b585a1e6d27ad14dc06c4", "parents": ["c9846ca8c38f421be13baa5bf0d479b9637e806f"], "tags": []}], "date": 1526438059, "git_changesets": [null], "user": "jlund@mozilla.com"}, "35": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1455337 - followup fix, r=me, a=release", "files": ["python/mozbuild/mozbuild/action/langpack_manifest.py"], "git_node": null, "git_parents": [null], "node": "efbcc205a0d3562691bf62bb0cb55bb7e891e8ff", "parents": ["f7f40b6cf8cfc0d7a84b585a1e6d27ad14dc06c4"], "tags": ["FIREFOX_60_0_1esr_BUILD1", "FIREFOX_60_0_1esr_RELEASE"]}], "date": 1526441057, "git_changesets": [null], "user": "nthomas@mozilla.com"}, "36": {"changesets": [{"author": "\"Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e\"", "branch": "default", "desc": "No bug - Tagging efbcc205a0d3562691bf62bb0cb55bb7e891e8ff with FIREFOX_60_0_1esr_BUILD1, FIREFOX_60_0_1esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "a6fd1a8d6dc11028f544766016f36eea29285a37", "parents": ["efbcc205a0d3562691bf62bb0cb55bb7e891e8ff"], "tags": []}, {"author": "\"Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e\"", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "6b8f87d69a25c6316e01bb277978260a32e38fac", "parents": ["a6fd1a8d6dc11028f544766016f36eea29285a37"], "tags": []}], "date": 1526502240, "git_changesets": [null, null], "user": "ffxbld"}, "37": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459162 - Update dimensions early in ClearTarget. r=lsalzman a=abillings", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h"], "git_node": null, "git_parents": [null], "node": "3324a15087629b01a8fea2ae2b30708333a05a92", "parents": ["6b8f87d69a25c6316e01bb277978260a32e38fac"], "tags": []}], "date": 1526548598, "git_changesets": [null], "user": "jkew@mozilla.com"}, "38": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453892 - Only use SkJumper's arm64 half-float optimizations with clang. r=rhunt, a=RyanVM\n\nMozReview-Commit-ID: H4ahP6jVdqC", "files": ["gfx/skia/skia/src/jumper/SkJumper_stages.cpp"], "git_node": null, "git_parents": [null], "node": "b9217b454fd561088932c3a2472649499f785587", "parents": ["3324a15087629b01a8fea2ae2b30708333a05a92"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1462873 - Link chromium_atomics to webrtc tests. r=froydnj, a=RyanVM\n\nThis redoes bug 1257888 which bug 1393119 undid.", "files": ["media/webrtc/trunk/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "26f17ded038f8fefd7e2b09000b22f0ca960796d", "parents": ["b9217b454fd561088932c3a2472649499f785587"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1462859 - Add --disable-layoutex when running ICU configure. r=froydnj, a=RyanVM\n\nIn some recent ICU update, --enable-layoutex changed from defaulting to\nthe \"same-as-layout\" to \"yes\", so --disable-layout doesn't imply\n--disable-layoutex anymore, but we removed the layoutex files.", "files": ["intl/icu_sources_data.py"], "git_node": null, "git_parents": [null], "node": "31d4880fde318a25abb7dc5b99a0aaafc63af3bb", "parents": ["26f17ded038f8fefd7e2b09000b22f0ca960796d"], "tags": []}], "date": 1526845211, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "39": {"changesets": [{"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1422930 - Fix SpiderMonkey includedir installs. r=glandium, a=jcristau\n\nSomehow the header files were being installed directly into\n$prefix/include, rather than $prefix/include/mozjs-60. Something else\nchanged somewhere that affected this, since this code was the same in\nolder mozjs versions, but this seems the most logical place to fix it.", "files": ["js/src/build/Makefile.in"], "git_node": null, "git_parents": [null], "node": "8e016d7b01bbafb36d5198273d8f4c801782c108", "parents": ["31d4880fde318a25abb7dc5b99a0aaafc63af3bb"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1444532 - Fix a leak in SHA256 in nsHttpConnectionInfo.cpp. r=mayhemer, a=jcristau\n\nThe original code (from bug 1200802) declared an XPCOM object as a static bare\npointer, which for future reference is probably never the right thing to do. It\nmight have worked if it was cleared before shutdown but it never was.\n\nMozReview-Commit-ID: EMe7wgzm6zv", "files": ["netwerk/protocol/http/nsHttpConnectionInfo.cpp"], "git_node": null, "git_parents": [null], "node": "7aec8de1c9d5fb9b5d25481df1e38242f4df5ea6", "parents": ["8e016d7b01bbafb36d5198273d8f4c801782c108"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1440013 - For MinGW build, pass -Wa,-mbig-obj to solve 'too many sections' errors. r=glandium, a=jcristau\n\nMozReview-Commit-ID: 9ObJnrcpeKe", "files": ["build/autoconf/compiler-opts.m4"], "git_node": null, "git_parents": [null], "node": "b20aeb0746e7174522fec1f80a623adfb8b507eb", "parents": ["7aec8de1c9d5fb9b5d25481df1e38242f4df5ea6"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448746 - Capitalization fixes for MinGW x64 build in the crash reporter. r=gsvelto, a=jcristau\n\nMozReview-Commit-ID: 8tZkuachYhX", "files": ["toolkit/crashreporter/minidump-analyzer/moz.build"], "git_node": null, "git_parents": [null], "node": "0e11f150a4821f0b8740eb30d151076a095f83e1", "parents": ["b20aeb0746e7174522fec1f80a623adfb8b507eb"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448453 - Update libvpx to have a 64 bit mingw config. r=kinetik, a=jcristau\n\nMozReview-Commit-ID: 1Dt3OcMgWii", "files": ["media/libvpx/config/win/mingw64/vp8_rtcd.h", "media/libvpx/config/win/mingw64/vp9_rtcd.h", "media/libvpx/config/win/mingw64/vpx_config.asm", "media/libvpx/config/win/mingw64/vpx_config.c", "media/libvpx/config/win/mingw64/vpx_config.h", "media/libvpx/config/win/mingw64/vpx_dsp_rtcd.h", "media/libvpx/config/win/mingw64/vpx_scale_rtcd.h", "media/libvpx/moz.build"], "git_node": null, "git_parents": [null], "node": "38cda0a09c9da05f8a936499417b91c2d84c9b9d", "parents": ["0e11f150a4821f0b8740eb30d151076a095f83e1"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448461 - Give libaom a x64 MinGW config. r=kinetik, a=jcristau\n\nMozReview-Commit-ID: BiBqBFSWYtK", "files": ["media/libaom/config/win/mingw64/aom_config.asm", "media/libaom/config/win/mingw64/aom_config.c", "media/libaom/config/win/mingw64/aom_config.h", "media/libaom/config/win/mingw64/aom_dsp_rtcd.h", "media/libaom/config/win/mingw64/aom_scale_rtcd.h", "media/libaom/config/win/mingw64/av1_rtcd.h", "media/libaom/generate_sources_mozbuild.sh", "media/libaom/moz.build"], "git_node": null, "git_parents": [null], "node": "abc0f9a278d696f85fec72b23151ad17a087c3bf", "parents": ["38cda0a09c9da05f8a936499417b91c2d84c9b9d"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448483 - Remove reference and use of ssize_t in CityHash to avoid conflicting definitions in MinGW x64. r=froydnj, a=jcristau\n\nMozReview-Commit-ID: ErQGSPNk4Bg", "files": ["other-licenses/nsis/Contrib/CityHash/CityHash.h", "other-licenses/nsis/Contrib/CityHash/cityhash/city.cpp"], "git_node": null, "git_parents": [null], "node": "eeedbadc7a25f7989aaa0d9234efbbcfa8486f21", "parents": ["abc0f9a278d696f85fec72b23151ad17a087c3bf"], "tags": []}], "date": 1527016633, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "40": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1446346 - If an AudioContext hasn't been started, do not bother clamping/jittering the CurrentTime. r=padenot, a=RyanVM\n\nThis will resolve several intermittments that were occuring because we would\noccasionally get unlucky and have a jitter midpoint of 0, making an unstarted\nAudioContext report a CurrentTime of 100us (or 1ms - whatever our clamp value\nwas.)\n\nMozReview-Commit-ID: 45zXLbB93wP", "files": ["dom/media/webaudio/AudioContext.cpp"], "git_node": null, "git_parents": [null], "node": "d06fb3839361bda1f0c4af69fe6aec7846dc00b4", "parents": ["eeedbadc7a25f7989aaa0d9234efbbcfa8486f21"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1446346 - Do not clamp or jitter the AudioContext's CurrentTime if its interval is larger than our precision. r=jib, a=RyanVM\n\nMozReview-Commit-ID: Bc1cto3pBKL", "files": ["browser/components/resistfingerprinting/test/mochitest/test_reduce_time_precision.html", "dom/media/webaudio/AudioContext.cpp", "toolkit/components/resistfingerprinting/nsRFPService.cpp", "toolkit/components/resistfingerprinting/nsRFPService.h"], "git_node": null, "git_parents": [null], "node": "c7e494e5888d67d5822143985fca6fd42c303b90", "parents": ["d06fb3839361bda1f0c4af69fe6aec7846dc00b4"], "tags": []}, {"author": "Franziskus Kiefer \u003cfranziskuskiefer@gmail.com\u003e", "branch": "default", "desc": "Bug 1371991 - Don't link against crmf when building with --with-system-nss. r=ted, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D836", "files": ["old-configure.in"], "git_node": null, "git_parents": [null], "node": "3ac8f220f7e6524be3f8753544cd46bec50dd5a7", "parents": ["c7e494e5888d67d5822143985fca6fd42c303b90"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1449835 - Do not compile Windows x64 Crash Test Assembly for MinGW. r=ccorcoran, r=froydnj, a=jcristau\n\nThe assembly file uses the wrong syntax and MinGW cannot compile it.\n\n(Also, gcc doesn't recognize it, because it ends in .asm and not .s.)", "files": ["toolkit/crashreporter/test/moz.build", "toolkit/crashreporter/test/nsTestCrasher.cpp"], "git_node": null, "git_parents": [null], "node": "5dc9b3739510ed74b72c91c311f5647c41572fe1", "parents": ["3ac8f220f7e6524be3f8753544cd46bec50dd5a7"], "tags": []}, {"author": "Aaron Klotz \u003caklotz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459085 - Prevent mutex reentry in mscom::Interceptor::GetInterceptorForIID. r=Jamie, a=jcristau", "files": ["ipc/mscom/Interceptor.cpp", "ipc/mscom/Interceptor.h"], "git_node": null, "git_parents": [null], "node": "f10bc261be65712b1d508bf7b7b0750f2c66d161", "parents": ["5dc9b3739510ed74b72c91c311f5647c41572fe1"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1427248 - Avoid changing certificate trust in nsNSSComponent initialization. r=fkiefer, r=jcj, a=jcristau\n\nIf a user has set a master password on their NSS DB(s), when we try to change\nthe trust of a certificate, we may have to authenticate to the DB. This\ninvolves bringing up a dialog box, executing javascript, spinning the event\nloop, etc. In some cases (particularly when antivirus software has injected\ncode into Firefox), this can cause the nsNSSComponent to be initialized if it\nhasn't already been. So, it's a really, really bad idea to attempt to change\nthe trust of a certificate while we're initializing nsNSSComponent, because\nthis results in a recursive component dependency and everything breaks. To get\naround this, if we need to load 3rd party roots (e.g. enterprise roots or the\nfamily safety root), we defer any trust changes to a later event loop tick. In\ntheory this could cause verification failures early in startup. We'll have to\nsee if this is an issue in practice.\n\n MozReview-Commit-ID: FvjHP5dTmpP", "files": ["security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/nsNSSComponent.h"], "git_node": null, "git_parents": [null], "node": "f7ba2965406d08645df693bfe3ce8b798a512915", "parents": ["f10bc261be65712b1d508bf7b7b0750f2c66d161"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1457598 - Add MinGW and GCC scripts to the resources of fxc2 and nsis to ensure they get rebuilt. r=glandium, a=jcristau", "files": ["taskcluster/ci/toolchain/linux.yml"], "git_node": null, "git_parents": [null], "node": "b63a4acbf1f84cf76e1e821f40f2149bd8bc7a9f", "parents": ["f7ba2965406d08645df693bfe3ce8b798a512915"], "tags": []}], "date": 1527024792, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "41": {"changesets": [{"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 1398272 - Prevent onUpdated from breaking tab IDs for adopted tabs. r=kmag, a=jcristau", "files": ["browser/components/extensions/ext-tabs.js", "browser/components/extensions/test/browser/browser_ext_tabs_move_window.js"], "git_node": null, "git_parents": [null], "node": "f2165acbf563b92e790843ef3005cfbddad00cfc", "parents": ["b63a4acbf1f84cf76e1e821f40f2149bd8bc7a9f"], "tags": []}, {"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1382953 - Fix permission prompts in about:addons options browsers. r=aswan, a=jcristau\n\nMozReview-Commit-ID: At5F5cqGSWu", "files": ["browser/components/extensions/test/browser/browser-common.ini", "browser/components/extensions/test/browser/browser_ext_user_events.js", "browser/modules/ExtensionsUI.jsm"], "git_node": null, "git_parents": [null], "node": "62bc8ca444f9