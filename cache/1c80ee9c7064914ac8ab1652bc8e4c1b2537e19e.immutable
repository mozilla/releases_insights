uits. r=jesup, a=jcristau", "files": ["media/webrtc/signaling/gtest/mediaconduit_unittests.cpp", "media/webrtc/signaling/src/media-conduit/AudioConduit.h", "media/webrtc/signaling/src/media-conduit/MediaConduitInterface.h", "media/webrtc/signaling/src/media-conduit/VideoConduit.cpp", "media/webrtc/signaling/src/media-conduit/VideoConduit.h", "media/webrtc/signaling/src/peerconnection/TransceiverImpl.cpp"], "git_node": null, "git_parents": [null], "node": "670b55a623bbd7ba225294d40a4e420d5cdb7566", "parents": ["a475573d292338fff5c00c8fe35e062f063efcb6"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1414829 - Fix VideoConduitTest gtest assertion failures. r=drno, a=jcristau", "files": ["media/webrtc/signaling/gtest/videoconduit_unittests.cpp"], "git_node": null, "git_parents": [null], "node": "06605afa2c72513ef9b06240e4481bf4e3def6d6", "parents": ["670b55a623bbd7ba225294d40a4e420d5cdb7566"], "tags": []}, {"author": "David Major \u003cdmajor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458270 - Clean up in the shutdown observer. r=milan, a=jcristau", "files": ["widget/GfxInfoBase.cpp", "widget/GfxInfoX11.cpp", "widget/android/GfxInfo.cpp", "widget/cocoa/GfxInfo.mm", "widget/uikit/GfxInfo.cpp", "widget/windows/GfxInfo.cpp"], "git_node": null, "git_parents": [null], "node": "b107983ae76dbde95055891484d4f2daf63a41c7", "parents": ["06605afa2c72513ef9b06240e4481bf4e3def6d6"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1452576 - Improve StructuredCloneHolder for fuzzy tests. r=decoder, a=jcristau", "files": ["dom/base/StructuredCloneHolder.cpp"], "git_node": null, "git_parents": [null], "node": "6eacfd4565649634169c5dae8d9d120958bcdf0e", "parents": ["b107983ae76dbde95055891484d4f2daf63a41c7"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1459206 - Use FileSystemSecurity in ContentParent::RecvGetFilesRequest. r=ehsan, a=jcristau", "files": ["dom/filesystem/tests/test_webkitdirectory.html", "dom/ipc/ContentParent.cpp"], "git_node": null, "git_parents": [null], "node": "61e14e969d807b4bfdc6b16c4fb30530c1602c2f", "parents": ["6eacfd4565649634169c5dae8d9d120958bcdf0e"], "tags": []}, {"author": "Tim Taubert \u003cttaubert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460301 - Web Authentication - Don't use U2F_PING to initialize tokens. r=jcj, a=jcristau\n\nReviewers: jcj\n\nReviewed By: jcj\n\nBug #: 1460301\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1270", "files": ["dom/webauthn/u2f-hid-rs/src/u2fprotocol.rs"], "git_node": null, "git_parents": [null], "node": "f515f7469139fe27234141ae71f98da1711ab019", "parents": ["61e14e969d807b4bfdc6b16c4fb30530c1602c2f"], "tags": []}], "date": 1527081852, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "48": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1399348 - Explicitly wait and check for error in test browser_ext_tabs_executeScript_bad. r=rpl, a=test-only\n\nI think that the intermittent error in the bug may be caused by\na pending executeScript call that is somehow handled around the\nshutdown of the extension.\n\nTo verify this hypothesis, the test now explicitly waits for the\nresult of the first executeScript call before executing the last\nscript that is responsible for test completion.\n\nThe test should explicitly be checking for the error anyway.\n\nAnd clean up comments and add reference to bug 1435100 in an\nexisting comment.\n\nMozReview-Commit-ID: 6gV30Z6zQc4", "files": ["browser/components/extensions/test/browser/browser_ext_tabs_executeScript_bad.js", "mobile/android/components/extensions/test/mochitest/test_ext_tabs_executeScript_bad.html"], "git_node": null, "git_parents": [null], "node": "0c8f4c1d5c050d0d20914ebe74e38645e6c08db7", "parents": ["f515f7469139fe27234141ae71f98da1711ab019"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1454285 - Part 1: Specify the current scope when emitting await and .generator. r=jwalden, a=RyanVM", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/BytecodeEmitter.h"], "git_node": null, "git_parents": [null], "node": "99b5db4dc3e5a22e1833366be44ee7ab403e2f37", "parents": ["0c8f4c1d5c050d0d20914ebe74e38645e6c08db7"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1454285 - Part 2: Disallow using innermostEmitterScope while the value does not match the bytecode environment. r=jwalden, a=RyanVM", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/BytecodeEmitter.h"], "git_node": null, "git_parents": [null], "node": "1e57f0666202f4c565e36e28758fbf070ffcbd4c", "parents": ["99b5db4dc3e5a22e1833366be44ee7ab403e2f37"], "tags": []}], "date": 1527093644, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "49": {"changesets": [{"author": "J.C. Jones \u003cjjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1463537 - Land NSS NSS_3_36_2_RTM UPGRADE_NSS_RELEASE. r=me, a=RyanVM", "files": ["old-configure.in", "security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/cpputil/scoped_ptrs.h", "security/nss/gtests/der_gtest/der_gtest.gyp", "security/nss/gtests/der_gtest/manifest.mn", "security/nss/gtests/ssl_gtest/ssl_tls13compat_unittest.cc", "security/nss/lib/nss/nss.h", "security/nss/lib/pkcs12/p12d.c", "security/nss/lib/pkcs7/p7decode.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/secasn1d.c"], "git_node": null, "git_parents": [null], "node": "610e5c03c09c0f4466e3cd80445c44c2f939cd8b", "parents": ["1e57f0666202f4c565e36e28758fbf070ffcbd4c"], "tags": []}, {"author": "J.C. Jones \u003cjjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460767 - Return device ineligible when appropriate for U2F. r=ttaubert, a=jcristau\n\nSummary:\nFIDO U2F's specification says that when the wrong security key responds to a\nsignature, or when an already-registered key exists, that the UA should return\nerror code 4, DEVICE_INELIGIBLE. We used to do that, but adjusted some things\nfor WebAuthn and now we don't. This changes the soft token to return that at\nthe appropriate times, and updates the expectations of U2F.cpp that it should\nuse InvalidStateError as the signal to reutrn DEVICE_INELIGIBLE.\n\nAlso, note that WebAuthn's specification says that if any authenticator returns\n\"InvalidStateError\" that it should be propagated, as it indicates that the\nauthenticator obtained user consent and failed to complete its job [1].\n\nThis change to the Soft Token affects the WebAuthn tests, but in a good way.\nReading the WebAuthn spec, we should not be returning NotAllowedError when there\nis consent from the user via the token (which the softtoken always deliveres).\n\nAs such, this adjusts the affected WebAuthn tests, and adds a couple useful\nchecks to test_webauthn_get_assertion.html for future purposes.\n\n[1] https://w3c.github.io/webauthn/#createCredential section 5.1.3 \"Create a new\n    credential\", Step 20, Note 2: \"If any authenticator returns an error status\n    equivalent to \"InvalidStateError\"...\"\n\nTest Plan: https://treeherder.mozilla.org/#/jobs?repo=try&revision=f2fc930f7fc8eea69b1ebc96748fe95e150a92a4\n\nReviewers: ttaubert\n\nBug #: 1460767\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1269", "files": ["dom/u2f/U2F.cpp", "dom/webauthn/U2FSoftTokenManager.cpp", "dom/webauthn/tests/browser/browser_fido_appid_extension.js", "dom/webauthn/tests/test_webauthn_authenticator_transports.html", "dom/webauthn/tests/test_webauthn_get_assertion.html", "dom/webauthn/tests/test_webauthn_loopback.html"], "git_node": null, "git_parents": [null], "node": "1db563cfbd926edc4e8c9acd667f876b91404b6d", "parents": ["610e5c03c09c0f4466e3cd80445c44c2f939cd8b"], "tags": []}, {"author": "Alex Gaynor \u003cagaynor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1456189 - Simplify BufferList::Extract to make the lifetimes clearer. r=froydnj, a=RyanVM", "files": ["mfbt/BufferList.h", "mfbt/tests/TestBufferList.cpp"], "git_node": null, "git_parents": [null], "node": "4ad85535660759c208348e82b4e38dd5551bd820", "parents": ["1db563cfbd926edc4e8c9acd667f876b91404b6d"], "tags": []}, {"author": "Alex Gaynor \u003cagaynor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462912 - Fixed BufferList::Extract to handle the case where the call consumes the entirety of the BufferList. r=froydnj, a=RyanVM\n\nMozReview-Commit-ID: 1LWODn8JaNL", "files": ["mfbt/BufferList.h", "mfbt/tests/TestBufferList.cpp"], "git_node": null, "git_parents": [null], "node": "c3fadedf7d3d304d16772e2feadbbd6a229c830a", "parents": ["4ad85535660759c208348e82b4e38dd5551bd820"], "tags": []}, {"author": "menantea \u003cmenantea@linux.vnet.ibm.com\u003e", "branch": "default", "desc": "Bug 1462566 - Add signal handling registers for powerpc. r=bbouvier, a=RyanVM", "files": ["js/src/wasm/WasmSignalHandlers.cpp"], "git_node": null, "git_parents": [null], "node": "d5eb098522b56eeeef4de9bcc5e0765c01f0d17b", "parents": ["c3fadedf7d3d304d16772e2feadbbd6a229c830a"], "tags": []}], "date": 1527107199, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "50": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460917 - Fonts not displaying with FontExplorer X fonts in Firefox 60. r=handyman, a=RyanVM\n\nAdd back font whitelist rules removed by the fix for bug 1393259\nto workaround font sandbox extensions not being issued automatically\non OS X 10.11 and earlier.\n\nMozReview-Commit-ID: 2hT0BzN3Ggq", "files": ["security/sandbox/mac/SandboxPolicies.h"], "git_node": null, "git_parents": [null], "node": "513eeba1bb051e4a6efe47eded64aef295f75194", "parents": ["d5eb098522b56eeeef4de9bcc5e0765c01f0d17b"], "tags": []}, {"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1437334 - Block DX NV12 on SandyBridge for old graphics drivers. r=jrmuizel, a=RyanVM", "files": ["gfx/config/gfxVars.h", "gfx/thebes/D3D11Checks.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "widget/GfxInfoBase.cpp", "widget/nsIGfxInfo.idl", "widget/windows/GfxInfo.cpp"], "git_node": null, "git_parents": [null], "node": "4354208f372d3fd4900020bd1db8999dce1e3f93", "parents": ["513eeba1bb051e4a6efe47eded64aef295f75194"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1457758 - Blacklist NVidia driver 397.31. r=davidb, a=RyanVM\n\nMozReview-Commit-ID: 9IomfIWkmpb", "files": ["widget/windows/GfxInfo.cpp"], "git_node": null, "git_parents": [null], "node": "ab928a40363dc0baba444b839edad0c3f7ad1065", "parents": ["4354208f372d3fd4900020bd1db8999dce1e3f93"], "tags": []}, {"author": "Mike Hommey \u003cmh@glandium.org\u003e", "branch": "default", "desc": "Bug 1463036 - Add -mfloat-abi=softfp to NEON_FLAGS when it makes sense. r=froydnj, a=RyanVM\n\nThis is similar to what is done for VPX_ASFLAGS (bug 1199974).", "files": ["build/autoconf/arch.m4"], "git_node": null, "git_parents": [null], "node": "acdfd35c14dbde461d1d339e2a78512c258bc062", "parents": ["ab928a40363dc0baba444b839edad0c3f7ad1065"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1463036 - Use HAVE_ARM_NEON instead of BUILD_ARM_NEON for nsUTF8UtilsNEON.cpp. r=chmanchester, a=RyanVM\n\nThere is a subtle difference between the two, and the conditions used in\nnsUTF8Utils.h correspond to HAVE_ARM_NEON, not BUILD_ARM_NEON.", "files": ["xpcom/string/moz.build"], "git_node": null, "git_parents": [null], "node": "87c1c9083f59ae990d70e2265bf750cf4799b7fc", "parents": ["acdfd35c14dbde461d1d339e2a78512c258bc062"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1460838 - Avoid static initializers in mozjemalloc with MSVC. r=njn, a=RyanVM", "files": ["memory/build/Mutex.h", "memory/build/mozjemalloc.cpp"], "git_node": null, "git_parents": [null], "node": "014a54d534bc84a86bdb16e6428ff406c848f2ce", "parents": ["87c1c9083f59ae990d70e2265bf750cf4799b7fc"], "tags": []}], "date": 1527177777, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "51": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1437334 - Add FEATURE_WEBRENDER to fix debug build assertion.  rs=jrmuizel a=bustage-fix", "files": ["widget/GfxInfoBase.cpp", "widget/nsIGfxInfo.idl"], "git_node": null, "git_parents": [null], "node": "19db3ad8118c3ef14a01e5442bb264f6ec06dc19", "parents": ["014a54d534bc84a86bdb16e6428ff406c848f2ce"], "tags": []}], "date": 1527191243, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "52": {"changesets": [{"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1443092 - Crashtest. r=jwatt, a=test-only", "files": ["layout/svg/crashtests/1443092-helper.svg", "layout/svg/crashtests/1443092.html", "layout/svg/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "b225eb1f628ffe02b2c90ecc4723b7f606db64b4", "parents": ["19db3ad8118c3ef14a01e5442bb264f6ec06dc19"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1438556 - Use shape guards on the prototype chain for cross-compartment ICs. r=tcampbell, a=RyanVM\n\nThis patch unshares some of the property access code between regular and\ncross-compartment cases, allowing us to use a series of shape-guards on the\nprotochain instead of the previous shape-teleporting checks, that would\nend up baking in a cross-compartment pointer.\n\nThis also attempts to clarify the compartment membership situation while\ndoing the cross-compartment IC.\n\nAs well some assertions are added and some small elements are fixed.", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIR.h", "js/src/jit/IonCacheIRCompiler.cpp"], "git_node": null, "git_parents": [null], "node": "b2e2129293dd05a64e0d9ccaf3ff214307b2c8b7", "parents": ["b225eb1f628ffe02b2c90ecc4723b7f606db64b4"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1435212 - Add support for FFmpeg 4.0. r=bryce, a=jcristau\n\nMozReview-Commit-ID: JlDFSUyGQu", "files": ["dom/media/platforms/ffmpeg/FFmpegDataDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/FFmpegLibs.h", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/ffmpeg58/include/COPYING.LGPLv2.1", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavcodec/avcodec.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavcodec/avfft.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavcodec/vaapi.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavcodec/vdpau.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/attributes.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/avconfig.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/avutil.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/buffer.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/channel_layout.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/common.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/cpu.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/dict.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/error.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/frame.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/hwcontext.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/intfloat.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/log.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/macros.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/mathematics.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/mem.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/pixfmt.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/rational.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/samplefmt.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/version.h", "dom/media/platforms/ffmpeg/ffmpeg58/moz.build", "dom/media/platforms/ffmpeg/moz.build"], "git_node": null, "git_parents": [null], "node": "2f39b32593bd0d1d5ebd7623bdf324610027074f", "parents": ["b2e2129293dd05a64e0d9ccaf3ff214307b2c8b7"], "tags": []}, {"author": "Kyle Machulis \u003ckyle@nonpolynomial.com\u003e", "branch": "default", "desc": "Bug 1433221 - Revert changes to classid checks for object tags. r=bz, a=jcristau\n\nAs part of applet/java plugin removal in bug 1279218, classid checking\nwas removed, as it was not obvious that this was used anywhere other\nthan java plugins. The classid is still a valid attribute on object\ntags (and is sometimes used on tags for flash embedding). We want\nto use a fallback strategy when we find objects with classid\nattributes, as we don't support them, meaning we need to revert our\nprior removal of the check.\n\nMozReview-Commit-ID: BKQ34HGTkvt", "files": ["dom/base/nsObjectLoadingContent.cpp", "dom/base/nsObjectLoadingContent.h", "dom/html/HTMLObjectElement.cpp"], "git_node": null, "git_parents": [null], "node": "905a6312336f77569b35da7e49aac902af407e5a", "parents": ["2f39b32593bd0d1d5ebd7623bdf324610027074f"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1462571 - Check dbus name by dbus_validate_bus_name() before use. r=jhorak, a=RyanVM\n\nMozReview-Commit-ID: AxQp79oyRlm", "files": ["toolkit/components/remote/nsDBusRemoteService.cpp", "widget/xremoteclient/DBusRemoteClient.cpp"], "git_node": null, "git_parents": [null], "node": "977eb5c43f72d56f730880e6b5c21f9ab2a2ffc0", "parents": ["905a6312336f77569b35da7e49aac902af407e5a"], "tags": []}], "date": 1527266709, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "53": {"changesets": [{"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "default", "desc": "Bug 1457338 - Stop touch drag on mouseUp. r=kats, a=jcristau\n\nMozReview-Commit-ID: 4uPibB3DR1D", "files": ["dom/events/EventStateManager.cpp"], "git_node": null, "git_parents": [null], "node": "12bcae3949433c4f56e0a939d511208ec6b17822", "parents": ["977eb5c43f72d56f730880e6b5c21f9ab2a2ffc0"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1451297. r=nical, a=RyanVM", "files": ["gfx/layers/ImageDataSerializer.cpp", "gfx/layers/ImageDataSerializer.h", "gfx/layers/composite/TextureHost.cpp"], "git_node": null, "git_parents": [null], "node": "0face289ea908187ee19c9400f86f11ee9bf54be", "parents": ["12bcae3949433c4f56e0a939d511208ec6b17822"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1463244 - Cleanup of swizzle stride calculations. r=rhunt, a=RyanVM\n\nMozReview-Commit-ID: GMXRKnu8zHB", "files": ["gfx/2d/DataSurfaceHelpers.cpp", "gfx/2d/Swizzle.cpp"], "git_node": null, "git_parents": [null], "node": "78c708386b35af4145f0f1ba9d1da389e73143b0", "parents": ["0face289ea908187ee19c9400f86f11ee9bf54be"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462682 - Skia path bounds rounding fix. r=rhunt, a=RyanVM\n\nMozReview-Commit-ID: Lm0XhyLLCCV", "files": ["gfx/skia/skia/src/core/SkScan_Path.cpp"], "git_node": null, "git_parent