it-ID: Lm0XhyLLCCV", "files": ["gfx/skia/skia/src/core/SkScan_Path.cpp"], "git_node": null, "git_parents": [null], "node": "35bfb4e0a47e4c5de062285ee6e8908fa43a37b3", "parents": ["0511cd9ccbb67a65a4c534735285b695d334c0b9"], "tags": []}], "date": 1528220556, "git_changesets": [null, null, null, null], "user": "jcristau@mozilla.com"}, "66": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_60_0_X_RELBRANCH", "desc": "Bug 1462120 - Update verify fixes for ESR60 branch, r=bhearsum a=release  DONTBUILD", "files": ["taskcluster/ci/release-update-verify-config/kind.yml", "taskcluster/ci/release-update-verify/kind.yml", "taskcluster/taskgraph/transforms/update_verify_config.py", "testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": null, "git_parents": [null], "node": "feee68eebee3d670050dadc162acc38a571592e0", "parents": ["35bfb4e0a47e4c5de062285ee6e8908fa43a37b3"], "tags": []}], "date": 1528229442, "git_changesets": [null], "user": "bhearsum@mozilla.com"}, "67": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_60_0_X_RELBRANCH", "desc": "No bug - Touch CLOBBER to get a new set of builds. a=NPOTB", "files": ["CLOBBER"], "git_node": null, "git_parents": [null], "node": "53abcc751afb946ed47d567095ec1b84b88fc309", "parents": ["feee68eebee3d670050dadc162acc38a571592e0"], "tags": ["FIREFOX_60_0_2esr_BUILD2", "FIREFOX_60_0_2esr_RELEASE"]}], "date": 1528229826, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "68": {"changesets": [{"author": "Manish Goregaokar \u003cmanishsmail@gmail.com\u003e", "branch": "default", "desc": "Bug 1451724 - servo: Use correct filler y value when animating with an implied-y translate()s. r=emilio, a=jcristau\n\nSource-Repo: https://github.com/servo/servo\nSource-Revision: e460b4ab8a9abfe70d0cac9cf03160510f791b7c", "files": ["servo/components/style/properties/helpers/animated_properties.mako.rs"], "git_node": null, "git_parents": [null], "node": "43df2f692b6341d6173550a265264646053bc129", "parents": ["26f92aa2b9b2361692d7e3c5d769f80de6e0b386"], "tags": []}, {"author": "Manish Goregaokar \u003cmanishearth@gmail.com\u003e", "branch": "default", "desc": "Bug 1451724 - Add reftest. r=emilio, a=jcristau\n\nMozReview-Commit-ID: IEfyEY9S73n", "files": ["testing/web-platform/meta/MANIFEST.json", "testing/web-platform/tests/css/css-transforms/css-transform-animate-translate-implied-y-ref.html", "testing/web-platform/tests/css/css-transforms/css-transform-animate-translate-implied-y.html"], "git_node": null, "git_parents": [null], "node": "e784c8cff0c3fb1e87277b71230b34311d44c72d", "parents": ["43df2f692b6341d6173550a265264646053bc129"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1450302 - nsInputStreamPump should interrupt the reading of the inputStream when suspended. r=michal, a=jcristau", "files": ["netwerk/base/nsInputStreamPump.cpp"], "git_node": null, "git_parents": [null], "node": "1816f74764fe159c6b875f520036c075624aa092", "parents": ["e784c8cff0c3fb1e87277b71230b34311d44c72d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1461448 - Add gray marking phase to delayed marking phase. r=sfink, a=RyanVM", "files": ["js/src/gc/GenerateStatsPhases.py", "js/src/jit-test/tests/gc/bug-1461448.js"], "git_node": null, "git_parents": [null], "node": "8e6e0228335c98145710b164ebe20596f31f2ba2", "parents": ["1816f74764fe159c6b875f520036c075624aa092"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462891 - Add Timer Rounding to Navigation APIs. r=baku, a=RyanVM", "files": ["dom/performance/PerformanceNavigationTiming.cpp", "dom/performance/tests/mochitest.ini", "dom/performance/tests/test_performance_navigation_timing.html"], "git_node": null, "git_parents": [null], "node": "e6205726237169843c6e1de096a81af6448dc78d", "parents": ["8e6e0228335c98145710b164ebe20596f31f2ba2"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1463581 - Add browser chrome test. r=johannh, a=RyanVM\n\nMozReview-Commit-ID: JpryAEsiWfN", "files": ["browser/base/content/test/webrtc/browser_devices_get_user_media_paused.js"], "git_node": null, "git_parents": [null], "node": "8953e757ddaa6c8e38b213549909ad22f4cd4cbc", "parents": ["e6205726237169843c6e1de096a81af6448dc78d"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1463581 - Signal enabled state changes also on UnregisterSink. r=jib, a=RyanVM\n\nMozReview-Commit-ID: FDCO73SdBoL", "files": ["dom/media/MediaStreamTrack.h"], "git_node": null, "git_parents": [null], "node": "50cb104b7bd9b30dadaab899457eed2203984970", "parents": ["8953e757ddaa6c8e38b213549909ad22f4cd4cbc"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1392739 - Use CheckedInt in nsStandardURL::Deserialize(). r=mayhemer, a=RyanVM", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": null, "git_parents": [null], "node": "5e8ae758ac7f589ec09f67b072cc49d44877046b", "parents": ["50cb104b7bd9b30dadaab899457eed2203984970"], "tags": []}, {"author": "Alex Gaynor \u003cagaynor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1392739 - Add test for faulty nsStandardURL deserialization. r=mayhemer, a=RyanVM", "files": ["netwerk/test/gtest/TestStandardURL.cpp"], "git_node": null, "git_parents": [null], "node": "f1465ba4ff3aacbf5adcab0becde3838955c6a3f", "parents": ["5e8ae758ac7f589ec09f67b072cc49d44877046b"], "tags": []}, {"author": "Franziskus Kiefer \u003cfranziskuskiefer@gmail.com\u003e", "branch": "default", "desc": "Bug 1466028 - Land NSS NSS_3_36_4_RTM UPGRADE_NSS_RELEASE. a=jcristau", "files": ["old-configure.in", "security/nss/TAG-INFO", "security/nss/automation/abi-check/expected-report-libssl3.so.txt", "security/nss/coreconf/coreconf.dep", "security/nss/cpputil/scoped_ptrs.h", "security/nss/gtests/der_gtest/p12_import_unittest.cc", "security/nss/lib/dev/devslot.c", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "25a710304ebbe1607fa94a94fcea921675058d39", "parents": ["f1465ba4ff3aacbf5adcab0becde3838955c6a3f"], "tags": []}], "date": 1528252799, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "69": {"changesets": [{"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448086 - Ensure QR tests are disabled on beta and project branches. r=aryx, a=test-only\n\nThis updates the existing entries to use the 'trunk' shorthand notation,\nand adds missing entries for mochitests, reftests, jsreftests, and the\nthree categories of web-platform-tests.\n\nMozReview-Commit-ID: KTgfidGFPNu", "files": ["taskcluster/ci/test/mochitest.yml", "taskcluster/ci/test/reftest.yml", "taskcluster/ci/test/web-platform.yml"], "git_node": null, "git_parents": [null], "node": "fba041cdcc2e4d0f933e6c0ff53501f5adb1e782", "parents": ["25a710304ebbe1607fa94a94fcea921675058d39"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453703 - Reschedule periodic file updates. r=Callek, a=release\n\nReviewers: Callek, catlee\n\nReviewed By: Callek\n\nBug #: 1453703\n\nDifferential Revision: https://phabricator.services.mozilla.com/D923", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "2d215343e4b16150fda7a4a2eb2c6286be19bdbc", "parents": ["fba041cdcc2e4d0f933e6c0ff53501f5adb1e782"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1464816 - Run periodic file updates on mozilla-esr60. r=ryanvm, a=release\n\nSummary:\nI've copied the m-c schedule, as the task sometimes\nfails with timeouts. This does add to the releaseduty workload,\nuntil automatic landing is operational.\n\nReviewers: RyanVM\n\nReviewed By: RyanVM\n\nBug #: 1464816\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1438", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "5cdae647650e5b892706cab34108d5f786c369aa", "parents": ["2d215343e4b16150fda7a4a2eb2c6286be19bdbc"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1436369 - Run blocklist updates on mozilla-beta. r=jlorenzo, a=release\n\nSummary:\nthe blocklist and remote-settings changes need to happen on beta,\nbut not the hsts/hpkp updates, so we have to split out the control of what\nruns by project.\n\nReviewers: jlorenzo\n\nReviewed By: jlorenzo\n\nBug #: 1436369\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1487", "files": [".cron.yml", "taskcluster/ci/repo-update/kind.yml", "taskcluster/taskgraph/transforms/repo_update.py"], "git_node": null, "git_parents": [null], "node": "fc6908fa7e264aa6d7932f4c43f71effd867f011", "parents": ["5cdae647650e5b892706cab34108d5f786c369aa"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466552 - Automated file updates for beta/release. r=RyanVM, a=release\n\nEnable blocklist.xml for release, and all updates for beta.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1529", "files": [".cron.yml", "taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "1d67d6de4783c0683c87a924d51cc9bece88f6c0", "parents": ["fc6908fa7e264aa6d7932f4c43f71effd867f011"], "tags": []}], "date": 1528292867, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "70": {"changesets": [{"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1452159 - Periodic file update clears out old reviews. r=jlorenzo, a=release\n\nSummary:\nthe periodic file updates keep adding new reviews, and it's easy to fall behind.\nThis adjusts the script so it clears out any previous submissions that are still awaiting review.\n\nReviewers: jlorenzo\n\nReviewed By: jlorenzo\n\nBug #: 1452159\n\nDifferential Revision: https://phabricator.services.mozilla.com/D872", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "8f05d10a47978d7b770fdda5de69fd67445553a9", "parents": ["1d67d6de4783c0683c87a924d51cc9bece88f6c0"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1452159 - Periodic file updates, fix awk behaviour. r=jlorenzo, a=release\n\nSummary:\na difference in behaviours between awks meant the original didn't work in-situ,\nalthough the task didn't fail due to the pipe chain.\n\nReviewers: jlorenzo\n\nReviewed By: jlorenzo\n\nBug #: 1452159\n\nDifferential Revision: https://phabricator.services.mozilla.com/D899", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "fe272f41ed069ec44f37b5fd7f1b8ad7c4cd41a8", "parents": ["8f05d10a47978d7b770fdda5de69fd67445553a9"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453067 - Support for days (of week or month) in taskcluster cron. r=dustin, a=release\n\nSummary:\nWe need to run things less often than once a day, so adding support for\ndays to taskcluster cron. 'day' is the day of the month, 'weekday' is used\nas a datetime.weekday (not isoweekday), or a string comparable to strftime('%A')\nor strftime('%a')\n\nReviewers: dustin\n\nReviewed By: dustin\n\nBug #: 1453067\n\nDifferential Revision: https://phabricator.services.mozilla.com/D903", "files": ["taskcluster/taskgraph/cron/__init__.py", "taskcluster/taskgraph/cron/schema.py", "taskcluster/taskgraph/cron/util.py", "taskcluster/taskgraph/test/test_cron_util.py"], "git_node": null, "git_parents": [null], "node": "6809bbed542c8fab1459e65cf5afd1e406b53a17", "parents": ["fe272f41ed069ec44f37b5fd7f1b8ad7c4cd41a8"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453616 - Disable buildbot periodic file updates. r=Callek, a=release\n\nSummary:\nDisable just the buildbot version of the periodic file updates in the file_update action.\nRemoving the code will happen later.\n\nReviewers: Callek\n\nReviewed By: Callek\n\nBug #: 1453616\n\nDifferential Revision: https://phabricator.services.mozilla.com/D921", "files": ["taskcluster/ci/repo-update-bb/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "679f356c64583a6c4203844770e574c6e4136bdc", "parents": ["6809bbed542c8fab1459e65cf5afd1e406b53a17"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454343 - Update taskcluster cron documentation. r=dustin, a=release\n\nReviewers: dustin\n\nReviewed By: dustin\n\nBug #: 1454343\n\nDifferential Revision: https://phabricator.services.mozilla.com/D950", "files": ["taskcluster/docs/cron.rst"], "git_node": null, "git_parents": [null], "node": "235527e70175f172f18e830222193c8785303af3", "parents": ["679f356c64583a6c4203844770e574c6e4136bdc"], "tags": []}], "date": 1528295838, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "71": {"changesets": [{"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448438 - Install Mercurial via install-mercurial.sh; r=Callek, a=release\n\nAll in-tree Docker images should be installing Mercurial via\ninstall-mercurial.sh so that the Mercurial install is consistent\nacross all Docker images.\n\nI noticed this image wasn't using install-mercurial.sh because\nattempting to rebuild the image currently fails due to\nmercurial-4.3.1-2 not being available in the upstream package repo.\n\ninstall-mercurial.sh has been taught to handle Ubuntu 18.04 and the\nDocker image building process has been taught to use\ninstall-mercurial.sh. install-mercurial.sh uses tooltool and behavior\nshould work and be deterministic over all of time.\n\nAs part of this, we had to establish a standalone shell script for\nbuilding the image. That's because install-mercurial.sh requires a\n\"tooltool_fetch\" alias. Meaningful image building code has been\nmoved into the new setup.sh. This also means things run as a single\nRUN statement. So we don't need to hack around minimizing RUN\ninvocations.\n\nI also discovered that the pinned curl version is no longer available.\nSo I removed the version pinning. FWIW we can't rely on version\npinning unless the Apt repository is snapshotted. Packages do get\nyanked from time to time. Unless we absolutely require a specific\nversion of a specific package, we can probably get away without pinning\n- at least for this Docker image. But that can be a follow-up.\n\nMozReview-Commit-ID: As7Hq470QcK", "files": ["taskcluster/docker/periodic-updates/Dockerfile", "taskcluster/docker/periodic-updates/setup.sh", "taskcluster/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "b43c0d5ade53b261a65cc9a90569c793fc61dcbb", "parents": ["235527e70175f172f18e830222193c8785303af3"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448438 - Update to latest robustcheckout; r=sheehan, a=release\n\nrobustcheckout from revision f0c7808d6c00e2bbf3d7325ac4cb8eb0a2b0e939\nof version-control-tools is vendored without modifications.\n\nMozReview-Commit-ID: HYqmEoFmRYq", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "288e9113a8bd0291381453ae03a5dd9cd044f9c5", "parents": ["b43c0d5ade53b261a65cc9a90569c793fc61dcbb"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448438 - Upgrade to Mercurial 4.5.2; r=sheehan, a=release\n\nWe bump the version of Mercurial for Debian packages and for Ubuntu\nDocker images.\n\nMozReview-Commit-ID: KYmG4rOm3TQ", "files": ["taskcluster/ci/packages/kind.yml", "taskcluster/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "fbf0ab335f99ae58fcc819d64ca4ef97b2c3dfd4", "parents": ["288e9113a8bd0291381453ae03a5dd9cd044f9c5"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448438 - Document how to upgrade Mercurial in CI; r=sheehan, a=release\n\nWe don't have docs for how to upgrade Mercurial in CI. A lot of it\nis organic institutional knowledge that lives in various people's\nheads. That's not good for continuity of business.\n\nThis commit starts to establish documentation for how to upgrade\nMercurial in Firefox CI.\n\nThe documentation for updating things in-tree is pretty robust\n(because I've done it a handful of times and know what is involved).\nBut the docs for OpenCloudConfig and Puppet could certainly be\nimproved. I'll poke the respective maintainers of these systems\nto help improve these docs as a follow-up.\n\nMozReview-Commit-ID: Aruh3N8Llls", "files": ["taskcluster/docs/index.rst", "taskcluster/docs/versioncontrol.rst"], "git_node": null, "git_parents": [null], "node": "1d772095b6f837ac250ddcadd53a696e3fab4654", "parents": ["fbf0ab335f99ae58fcc819d64ca4ef97b2c3dfd4"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1452584 - Removing pinning for periodic file updates. r=jlorenzo, a=release\n\nReviewers: jlorenzo\n\nReviewed By: jlorenzo\n\nBug #: 1452584\n\nDifferential Revision: https://phabricator.services.mozilla.com/D883", "files": ["taskcluster/docker/periodic-updates/setup.sh"], "git_node": null, "git_parents": [null], "node": "328561773633511f754fa51e7026ecaecf5cca90", "parents": ["1d772095b6f837ac250ddcadd53a696e3fab4654"], "tags": []}], "date": 1528296754, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "72": {"changesets": [{"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453127 - Make sure decoder-captured tracks end when changing src. r=jya, a=RyanVM", "files": ["dom/html/HTMLMediaElement.cpp", "dom/html/HTMLMediaElement.h"], "git_node": null, "git_parents": [null], "node": "93c69315a27981ab8fa235e52c7bc9008c35165f", "parents": ["328561773633511f754fa51e7026ecaecf5cca90"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453127 - Ensure TrackID uniqueness for captured MediaDecoder. r=jya, a=RyanVM", "files": ["dom/html/HTMLMediaElement.cpp", "dom/html/HTMLMediaElement.h", "dom/media/MediaDecoder.cpp", "dom/media/MediaDecoder.h", "dom/media/MediaDecoderStateMachine.cpp", "dom/media/MediaDecoderStateMachine.h", "dom/media/mediasink/DecodedStream.cpp", "dom/media/mediasink/OutputStreamManager.cpp", "dom/media/mediasink/OutputStreamManager.h"], "git_node": null, "git_parents": [null], "node": "7e420412a88561dea30f53e6c23826018b5515db", "parents": ["93c69315a27981ab8fa235e52c7bc9008c35165f"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453127 - Clear output streams on shutdown. r=jya, a=RyanVM", "files": ["dom/media/MediaDecoderStateMachine.cpp", "dom/media/mediasink/OutputStreamManager.cpp", "dom/media/mediasink/OutputStreamManager.h"], "git_node": null, "git_parents": [null], "node": "d00df8beb17e1681adea2e8f3007af7a2cae3422", "parents": ["7e420412a88561dea30f53e6c23826018b5515db"], "tags": []}], "date": 1528322056, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "73": {"changesets": [{"author": "\"Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e\"", "branch": "default", "desc": "No bug - Tagging 53abcc751afb946ed47d567095ec1b84b88fc309 with FIREFOX_60_0_2esr_BUILD2, FIREFOX_60_0_2esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "ca4b7fbb56dc7f8b809b37b35cb872031115fecd", "parents": ["d00df8beb17e1681adea2e8f3007af7a2cae3422"], "tags": []}, {"author": "\"Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e\"", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "619ae3572d37952d44a05750249bdab6652c6173", "parents": ["ca4b7fbb56dc7f8b809b37b35cb872031115fecd"], "tags": []}], "date": 1528322854, "git_changesets": [null, null], "user": "ffxbld"}, "74": {"changesets": [{"author": "\"Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e\"", "branch": "FIREFOX_ESR_60_0_X_RELBRANCH", "desc": "Automatic version bump DONTBUILD CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "1f5a554ea98fa274db74efd58195a874bac6a8be", "parents": ["53abcc751afb946ed47d567095ec1b84b88fc309"], "tags": []}], "date": 1528323500, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "75": {"changesets": [{"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1456485 - Part 1: Support unrestricted matching in MatchPattern. r=zombie, a=RyanVM\n\nThis is grafted from the first part of bug 1425104.\n\nMozReview-Commit-ID: 4aW2w81LDTI", "files": ["dom/base/nsGkAtomList.h", "dom/chrome-webidl/MatchPattern.webidl", "toolkit/components/extensions/MatchPattern.cpp", "toolkit/components/extensions/MatchPattern.h", "toolkit/components/extensions/test/xpcshell/test_MatchPattern.js"], "git_node": null, "git_parents": [null], "node": "420f1c404375d26e9303c01ac1fc28d88a4f9702", "parents": ["619ae3572d37952d44a05750249bdab6652c6173"], "tags": []}, {"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1456485 - Part 2: Allow extensions with the mozillaAddons permission to match restricted schemes. r=zombie, a=RyanVM\n\nThe schema handling for this is currently a bit ugly, for the sake of\nsimplifying uplift. In the figure, we should find a way to change the schema\npattern matching based on whether or not the extension is privileged.\n\nMozReview-Commit-ID: CU9WR2Ika6k", "files": ["dom/base/nsGkAtomList.h", "toolkit/components/extensions/Extension.jsm", "toolkit/components/extensions/ExtensionChild.jsm", "toolkit/components/extensions/ExtensionXPCShellUtils.jsm", "toolkit/components/extensions/WebExtensionContentScript.h", "toolkit/components/extensions/WebExtensionPolicy.cpp", "toolkit/components/extensions/extension-process-script.js", "toolkit/components/extensions/schemas/manifest.json", "toolkit/components/extensions/test/xpcshell/test_ext_contentscript_restrictSchemes.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.ini"], "git_node": null, "git_parents": [null], "node": "6ae65bc81d98bc2e8e1792cdfd81ddcf48221295", "parents": ["420f1c404375d26e9303c01ac1fc28d88a4f9702"], "tags": []}, {"author": "Barry Chen \u003cbchen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1465544 - Add 'mozillaAddons' permission to Screenshots. r=ianbicking, r=_6a68, a=RyanVM\n\nMozReview-Commit-ID: 7CoJJt34wqZ", "files": ["browser/extensions/screenshots/webextension/manifest.json"], "git_node": null, "git_parents": [null], "node": "c5161c79c50bf808dbd866b62bf86fe3e90f4f0f", "parents": ["6ae65bc81d98bc2e8e1792cdfd81ddcf48221295"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 1466349 - Part 1: Enable passing addonData flags to embedded WE. r=aswan, a=RyanVM\n\nalso fix permission matcher creation in child process\n\nMozReview-Commit-ID: Ht9rEKwaUsp", "files": ["toolkit/components/extensions/LegacyExtensionsUtils.jsm", "toolkit/components/extensions/extension-process-script.js"], "git_node": null, "git_parents": [null], "node": "e0c623e9e9abae9545ff5c831fb2b76b4323d940", "parents": ["c5161c79c50bf808dbd866b62bf86fe3e90f4f0f"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 1466349 - Part 2: Pass addonData to embedded Screenshots WE, add permissions. r=aswan, r=ianbicking, a=RyanVM\n\nMozReview-Commit-ID: GLwjp32sj2i", "files": ["browser/extensions/screenshots/bootstrap.js", "browser/extensions/screenshots/webextension/manifest.json"], "git_node": null, "git_parents": [null], "node": "732cc9a732204da62e012df72719af4674a441de", "parents": ["e0c623e9e9abae9545ff5c831fb2b76b4323d940"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 1466349 - Part 3: Ignore ignorePath for privileged about: MatchPatterns. r=aswan, a=RyanVM\n\nPaths are all about: URIs have, so ignoring them doesn't make sense.\n\nMozReview-Commit-ID: ATwAeI7m61z", "files": ["toolkit/components/extensions/MatchPattern.cpp", "toolkit/components/extensions/test/xpcshell/test_MatchPattern.js"], "git_node": null, "git_parents": [null], "node": "07ae2a15b7baa5d1346e6756d5967ba14c19ad7d", "parents": ["732cc9a732204da62e012df72719af4674a441de"], "tags": []}], "date": 1528332643, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "76": {"changesets": [{"author": "Venkatesh Pitta \u003cvenkateshpitta@gmail.com\u003e", "branch": "default", "desc": "Bug 1348145 - Remove getWindowPosition/setWindowPosition and getWindowSize/setWindowSize. r=whimboo, a=test-only\n\nMozReview-Commit-ID: AUxPhJwOKB6", "files": ["testing/marionette/client/marionette_driver/marionette.py", "testing/marionette/driver.js", "testing/marionette/harness/marionette_harness/tests/unit/test_window_maximize.py", "testing/marionette/harness/marionette_harness/tests/unit/test_window_minimize.py", "testing/marionette/harness/marionette_harness/tests/unit/test_window_rect.py"], "git_node": null, "git_parents": [null], "node": "af365070668fa29b214d809c37b8355865129ee7", "parents": ["07ae2a15b7baa5d1346e6756d5967ba14c19ad7d"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1434983 - Make screenshare and windowshare test one-way, to work around limitations on OS X. r=pehrsons, a=test-only\n\nMozReview-Commit-ID: Ldy7Wb3ZSPQ", "files": ["dom/media/tests/mochitest/test_peerConnection_basicScreenshare.html", "dom/media/tests/mochitest/test_peerConnection_basicWindowshare.html"], "git_node": null, "git_parents": [null], "node": "e5deb539c16d5bca2868be847a569e8f96129c73", "parents": ["af365070668fa29b214d809c37b8355865129ee7"], "tags": []}, {"author": "Jan Odvarko \u003codvarko@gmail.com\u003e", "branch": "default", "desc": "Bug 1462882 - Avoid NPE when filtering using remote-ip. r=jryans, a=RyanVM\n\nMozReview-Commit-ID: IJ2lNgMRCYz", "files": ["devtools/client/netmonitor/src/utils/filter-text-utils.js"], "git_node": null, "git_parents": [null], "node": "bd1438686c3f1c174e49c7eb5ec864b252e119e8", "parents": ["e5deb539c16d5bca2868be847a569e8f96129c73"], "tags": []}, {"author": "abhinav \u003cabhinav.koppula@gmail.com\u003e", "branch": "default", "desc": "Bug 1462886 - Fix for filter flag breaking the netmonitor when using invalid values. r=Honza, a=RyanVM\n\nMozReview-Commit-ID: 5cvUX2sb7k0", "files": ["devtools/client/netmonitor/src/utils/filter-text-utils.js", "devtools/client/netmonitor/test/browser_net_filter-flags.js"], "git_node": null, "git_parents": [null], "node": "d7e42c12b4a70535e0a81df0f54ec13cf6263d52", "parents": ["bd1438686c3f1c174e49c7eb5ec864b252e119e8"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out 3 changesets (bug 1453127) for permafailing test_mediarecorder_principals.html.\n\nBacked out changeset d00df8beb17e (bug 1453127)\nBacked out changeset 7e420412a885 (bug 1453127)\nBacked out changeset 93c69315a279 (bug 1453127)", "files": ["dom/html/HTMLMediaElement.cpp", "dom/html/HTMLMediaElement.h", "dom/media/MediaDecoder.cpp", "dom/media/MediaDecoder.h", "dom/media/MediaDecoderStateMachine.cpp", "dom/media/MediaDecoderStateMachine.h", "dom/media/mediasink/DecodedStream.cpp", "dom/media/mediasink/OutputStreamManager.cpp", "dom/media/mediasink/OutputStreamManager.h"], "git_node": null, "git_parents": [null], "node": "d34e9c8ef02396c13e216328fb088c476ed4a3d4", "parents": ["d7e42c12b4a70535e0a81df0f54ec13cf6263d52"], "tags": []}], "date": 1528379945, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "77": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1348145 - Remove the obsolete test_tabbar_session_restore_button.py test which depends on the now-removed attributes. r=whimboo, a=test-only", "files": ["testing/firefox-ui/tests/functional/sessionstore/manifest.ini", "testing/firefox-ui/tests/functional/sessionstore/test_tabbar_session_restore_button.py"], "git_node": null, "git_parents": [null], "node": "ef91a3faffbfb4774cd876eabf1276078d52f5aa", "parents": ["d34e9c8ef02396c13e216328fb088c476ed4a3d4"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 1443499 - Background Hang Reporter: use only one thread for unwinding and reporting. r=mystor, a=RyanVM\n\nWhen the BHR wants to report a tardy thread, it hands off the work of\ngetting a stacktrace to a helper thread.  The helper threads used are in the\nStream Transport Service threadpool, which has a default limit of 25\nthreads.\n\nThis has a bad effect when we are in a severely compute-resource constrained\nsituation.  Then, many threads will be late, and up to 25 STS worker threads\nwill be employed to do unwinding, a potentially expensive operation.  This\nfurther restricts the compute resources available to progress the rest of\nthe system.\n\nAnother effect is that the unwinder work will compete against the \"real\" STS\nwork for the 25 workers, potentially further slowing forward progress.\n\nThis patch replaces the use of the STS thread pool with a single nsThread\ndedicated to unwinding/reporting hangs.", "files": ["toolkit/components/backgroundhangmonitor/BackgroundHangMonitor.cpp"], "git_node": null, "git_parents": [null], "node": "0e72e4c798bb6999188eb745cb6bf5b39056c5aa", "parents": ["ef91a3faffbfb4774cd876eabf1276078d52f5aa"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 1442603 - Background Hang Reporter: increase timeouts when running on Valgrind. r=mystor, a=RyanVM", "files": ["toolkit/components/backgroundhangmonitor/BackgroundHangMonitor.cpp"], "git_node": null, "git_parents": [null], "node": "843876c2ac8d2f0550dae653021b7caea7b36ea5", "parents": ["0e72e4c798bb6999188eb745cb6bf5b39056c5aa"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 1296819 - Intermittent valgrind-test | Invalid write of size 4 at mozilla:: / _pt_root / start_thread / clone. r=baku, a=RyanVM\n\nIf we're running on Valgrind, we'll be making forward progress at a rate of\nsomewhere between 1/25th and 1/50th of normal.  This can cause shutdown\ntimeouts frequently enough to be a problem for the Valgrind runs on\nautomation.  As an attempt to avoid the worst of this, this patch scales up\nthe presented timeout by a factor of three.  For a non-Valgrind-enabled\nbuild, or for an enabled build which isn't running on Valgrind, the timeout\nis unchanged.", "files": ["toolkit/components/terminator/nsTerminator.cpp"], "git_node": null, "git_parents": [null], "node": "00155725c3eae3e4c04b7c88e88f9f52670ee704", "parents": ["843876c2ac8d2f0550dae653021b7caea7b36ea5"], "tags": []}, {"author": "Jonathan Kingston \u003cjkt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454909 - Add support for system addon signing for web extension bundling. r=johannh, r=kmag, a=RyanVM", "files": ["toolkit/components/extensions/Extension.jsm", "toolkit/components/extensions/ExtensionTestCommon.jsm", "toolkit/components/extensions/test/xpcshell/test_ext_experiments.js", "toolkit/components/extensions/test/xpcshell/test_ext_schemas_interactive.js", "toolkit/mozapps/extensions/internal/XPIProvider.jsm"], "git_node": null, "git_parents": [null], "node": "d0564109d0e340caa7cdcf0e96aaa96b1feb0a09", "parents": ["00155725c3eae3e4c04b7c88e88f9f52670ee704"], "tags": []}], "date": 1528396081, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "78": {"changesets": [{"author": "Ben Hearsum \u003cbhearsum@mozilla.com\u003e", "branch": "default", "desc": "bug 1455061: upgrade update verify and funsize update generator docker images to newer ubuntu to get latest python. r=sfraser, a=release", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile", "taskcluster/docker/update-verify/Dockerfile"], "git_node": null, "git_parents": [null], "node": "c7187146116fe90f3e98a7d7657fe5501faad472", "parents": ["d0564109d0e340caa7cdcf0e96aaa96b1feb0a09"], "tags": []}], "date": 1528482703, "git_changesets": [null], "user": "bhearsum@mozilla.com"}, "79": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset d0564109d0e3 (bug 1454909) for test_ext_experiments.js failures.", "files": ["toolkit/components/extensions/Extension.jsm", "toolkit/components/extensions/ExtensionTestCommon.jsm", "toolkit/components/extensions/test/xpcshell/test_ext_experiments.js", "toolkit/components/extensions/test/xpcshell/test_ext_schemas_interactive.js", "toolkit/mozapps/extensions/internal/XPIProvider.jsm"], "git_node": null, "git_parents": [null], "node": "55bafed347183a1fbc13c8cc85fd6d0ae1b59838", "parents": ["c7187146116fe90f3e98a7d7657fe5501faad472"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1467456 - Use correct hg repo in repo-update. r=lguo, a=release\n\n1. Updated hgrepo to work with mozilla-beta, mozilla-esr60 and project branches (just in case)\n2. Presquashed commits, so we only submit one.\n3. Replaced 'which' with 'command -v' to avoid future shellcheck issues.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1582", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "53f4d54277e489eccd2e083da5d1c11c161b4934", "parents": ["55bafed347183a1fbc13c8cc85fd6d0ae1b59838"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453127 - Make sure decoder-captured tracks end when changing src. r=jya, a=RyanVM", "files": ["dom/html/HTMLMediaElement.cpp", "dom/html/HTMLMediaElement.h"], "git_node": null, "git_parents": [null], "node": "38d06926803a75da86152caf7b3503dbe044f864", "parents": ["53f4d54277e489eccd2e083da5d1c11c161b4934"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453127 - Ensure TrackID uniqueness for captured MediaDecoder. r=jya, a=RyanVM", "files": ["dom/html/HTMLMediaElement.cpp", "dom/html/HTMLMediaElement.h", "dom/media/MediaDecoder.cpp", "dom/media/MediaDecoder.h", "dom/media/MediaDecoderStateMachine.cpp", "dom/media/MediaDecoderStateMachine.h", "dom/media/mediasink/DecodedStream.cpp", "dom/media/mediasink/OutputStreamManager.cpp", "dom/media/mediasink/OutputStreamManager.h"], "git_node": null, "git_parents": [null], "node": "6896c23bcc964e78aa5bef4e6f982f9a0c20ff65", "parents": ["38d06926803a75da86152caf7b3503dbe044f864"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1453127 - Clear output streams on shutdown. r=jya, a=RyanVM", "files": ["dom/media/MediaDecoderStateMachine.cpp", "dom/media/mediasink/OutputStreamManager.cpp", "dom/media/mediasink/OutputStreamManager.h"], "git_node": null, "git_parents": [null], "node": "a2946175bb470d7ea5f3e59866432a81f19d1c79", "parents": ["6896c23bcc964e78aa5bef4e6f982f9a0c20ff65"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1266345 - Let MediaRecorder ignore ended tracks. r=bryce, a=RyanVM\n\nMozReview-Commit-ID: 8P1p0uI46BZ", "files": ["dom/media/MediaRecorder.cpp"], "git_node": null, "git_parents": [null], "node": "3258221fa293dbae1560110cfb46d8fcb48ee6e7", "parents": ["a2946175bb470d7ea5f3e59866432a81f19d1c79"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1266345 - Re-enable test on linux64. r=bryce, a=RyanVM\n\nMozReview-Commit-ID: IJqncmqDeKL", "files": ["dom/media/test/mochitest.ini"], "git_node": null, "git_parents": [null], "node": "a2929372f83d32fed6211333c058830065e69843", "parents": ["3258221fa293dbae1560110cfb46d8fcb48ee6e7"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1463786 - Make mozilla::Tokenizer work also with char16_t. r=froydnj, a=RyanVM", "files": ["xpcom/ds/IncrementalTokenizer.h", "xpcom/ds/Tokenizer.cpp", "xpcom/ds/Tokenizer.h", "xpcom/tests/gtest/TestTokenizer.cpp"], "git_node": null, "git_parents": [null], "node": "74c9ff1f6b3ce0af93a9ad6513f03c2946e92f71", "parents": ["a2929372f83d32fed6211333c058830065e69843"], "tags": []}], "date": 1528484937, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "80": {"changesets": [{"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1467113: Save signedState in startup data. r=aswan a=RyanVM\n\nMozReview-Commit-ID: 5iIzy1qKS0P", "files": ["toolkit/mozapps/extensions/internal/XPIProvider.jsm"], "git_node": null, "git_parents": [null], "node": "fa1c76b6cea15fc0cbdea4a5406034e1066d1476", "parents": ["74c9ff1f6b3ce0af93a9ad6513f03c2946e92f71"], "tags": []}], "date": 1528485633, "git_changesets": [null], "user": "maglione.k@gmail.com"}, "81": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1465898 - Remove unused code for managing physical audio devices. r=agaynor, a=abillings\n\nMozReview-Commit-ID: 7NsUfzJCUOB", "files": ["hal/Hal.cpp", "hal/Hal.h", "hal/HalInternal.h", "hal/HalTypes.h", "hal/fallback/FallbackSwitch.cpp", "hal/moz.build", "hal/sandbox/PHal.ipdl", "hal/sandbox/SandboxHal.cpp"], "git_node": null, "git_parents": [null], "node": "ccd106658ca24d89893462162175e1fa1d8fbd4d", "parents": ["fa1c76b6cea15fc0cbdea4a5406034e1066d1476"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1413868. r=valentin, a=RyanVM", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsEmbedFunctions.cpp", "xpcom/io/FilePreferences.cpp", "xpcom/io/FilePreferences.h", "xpcom/io/moz.build", "xpcom/io/nsLocalFileWin.cpp", "xpcom/tests/gtest/TestFilePreferencesWin.cpp", "xpcom/tests/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "1248809b8616ccdca655b997843b4bd43e835a14", "parents": ["ccd106658ca24d89893462162175e1fa1d8fbd4d"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1464079 - Bring ICE connection state change callback up to spec. r=jib, a=RyanVM", "files": ["dom/media/PeerConnection.js"], "git_node": null, "git_parents": [null], "node": "d0efbb8967ccff5e211c9e93a25fbca754e075b7", "parents": ["1248809b8616ccdca655b997843b4bd43e835a14"], "tags": []}, {"author": "Randell Jesup \u003crjesup@jesup.org\u003e", "branch": "default", "desc": "Bug 1395246 - Nullcheck DataChannel SendPacket calls, add some diagnostics. r=drno, a=RyanVM", "files": ["netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannel.h"], "git_node": null, "git_parents": [null], "node": "b5045ef425837e86b8406930d1a9d7929a7a4b8b", "parents": ["d0efbb8967ccff5e211c9e93a25fbca754e075b7"], "tags": []}], "date": 1528485724, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "82": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 1248809b8616 (bug 1413868) for bustage.", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsEmbedFunctions.cpp", "xpcom/io/FilePreferences.cpp", "xpcom/io/FilePreferences.h", "xpcom/io/moz.build", "xpcom/io/nsLocalFileWin.cpp", "xpcom/tests/gtest/TestFilePreferencesWin.cpp", "xpcom/tests/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "4461cd174c66424fb7da115812a933e73a9a01ee", "parents": ["b5045ef425837e86b8406930d1a9d7929a7a4b8b"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 74c9ff1f6b3c (bug 1463786) for bustage.", "files": ["xpcom/ds/IncrementalTokenizer.h", "xpcom/ds/Tokenizer.cpp", "xpcom/ds/Tokenizer.h", "xpcom/tests/gtest/TestTokenizer.cpp"], "git_node": null, "git_parents": [null], "node": "eed4d71dbb8d08f604bc4b8788bbcedd2185cc29", "parents": ["4461cd174c66424fb7da115812a933e73a9a01ee"], "tags": []}], "date": 1528487181, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "83": {"changesets": [{"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1467924 - Correctly calculate add-on install location at startup. r=aswan, a=RyanVM\n\nMozReview-Commit-ID: 2Hl3be03ovA", "files": ["toolkit/mozapps/extensions/internal/XPIProvider.jsm"], "git_node": null, "git_parents": [null], "node": "9bdbe902cb7ecfec9dac7f2c27bf5c58e77d35f0", "parents": ["eed4d71dbb8d08f604bc4b8788bbcedd2185cc29"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1411908 - Part 1: Wait for all live database objects to finish when shutting down. r=asuth, a=RyanVM", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "5c3a2242b2744a4a1f2c19ceb51a248d256cba33", "parents": ["9bdbe902cb7ecfec9dac7f2c27bf5c58e77d35f0"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1411908 - Part 2: Wait for all factory operations to finish when shutting down. r=asuth, a=RyanVM", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "25ae084a7fc71cc2079b0dde0ad818666d5931ca", "parents": ["5c3a2242b2744a4a1f2c19ceb51a248d256cba33"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1467041 - Default to --enable-release when milestone is beta/release. r=froydnj, a=RyanVM\n\n--enable-release not being passed means developer options are enabled,\nwhich is generally speaking not desirable for builds meant to be\nshipped. This is somewhat alleviated for Firefox by MOZILLA_OFFICIAL\nimplying --enable-release (as well as MOZ_AUTOMATION), but that doesn't\napply to e.g. standalone js builds (even some of the standalone js jobs\non our automation don't set MOZ_AUTOMATION for some reason).\n\nA reasonable thing to do is just to default builds for release/beta\nmilestones to --enable-release, but still allow --disable-release\nto enable the developer options.", "files": ["build/moz.configure/toolchain.configure"], "git_node": null, "git_parents": [null], "node": "100458d997b97d2d85e6d5855dfc5ecedc76c923", "parents": ["25ae084a7fc71cc2079b0dde0ad818666d5931ca"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1467462 - Adjust test_developer_options after bug 1467041. r=froydnj, a=RyanVM\n\nBug 1467041 changed the default for --enable-release such that it is\naffected by the milestone. Test both possible cases for milestones.", "files": ["python/mozbuild/mozbuild/test/configure/test_toolkit_moz_configure.py"], "git_node": null, "git_parents": [null], "node": "7d96e64a45748da951ebcb6a30d99b7156494bec", "parents": ["100458d997b97d2d85e6d5855dfc5ecedc76c923"], "tags": []}], "date": 1528560067, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "84": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1464084 - Don't export std::thread::_M_start_thread symbols with --enable-stdcxx-compat. r=froydnj, a=RyanVM\n\nThis relies on the fact that providing multiple --version-script\ncombines them all, so we effectively create a new symbol version\nthat has no global symbol, but hides the std::thread::_M_start_thread\nsymbols.\n\nThis version script trick happens to work with BFD ld, gold, and lld.\n\nThe downside is that when providing multiple --version-script's, ld\ndoesn't want any of them to have no version at all. So for the libraries\nthat do already have a version script (through SYMBOLS_FILE), we use a\nversion where there used to be none, using the library name as the\nversion. Practically speaking, this binds the libraries a little closer\nthan they used to be, kind of non-flat namespace on OSX (which is the\ndefault there), meaning the dynamic linker will actively want to use\nsymbols from those libraries instead of a system library that might\nhappen to have the same symbol name.", "files": ["build/unix/stdc++compat/hide_std.ld", "build/unix/stdc++compat/moz.build", "python/mozbuild/mozbuild/action/generate_symbols_file.py"], "git_node": null, "git_parents": [null], "node": "123bd919d459bf2c4f9921a584e44578b8b8272d", "parents": ["7d96e64a45748da951ebcb6a30d99b7156494bec"], "tags": []}, {"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1467938 - Fix out-of-bounds memory access in WebRTC VP9 Missing Frame Processing. r=ng, a=RyanVM", "files": ["media/webrtc/trunk/webrtc/modules/video_coding/rtp_frame_reference_finder.cc"], "git_node": null, "git_parents": [null], "node": "9875e9b3e0ca4f5846247f16feacec2b50e52ca5", "parents": ["123bd919d459bf2c4f9921a584e44578b8b8272d"], "tags": []}], "date": 1528591912, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "85": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1456652 - Use triggering principal when leaving reader mode. r=mgoodwin, a=RyanVM", "files": ["toolkit/components/reader/ReaderMode.jsm"], "git_node": null, "git_parents": [null], "node": "f620aed6dc0d8358e6936d6d310295fb8c5ee303", "parents": ["9875e9b3e0ca4f5846247f16feacec2b50e52ca5"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1461619 - Don't update atoms marking bitmaps in parallel due to potential races. r=sfink, a=RyanVM", "files": ["js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/GC.cpp"], "git_node": null, "git_parents": [null], "node": "e3a1391a1ae0496007159264fad8a40e05f75dca", "parents": ["f620aed6dc0d8358e6936d6d310295fb8c5ee303"], "tags": []}, {"author": "Ting-Yu Chou \u003cjanus926@gmail.com\u003e", "branch": "default", "desc": "Bug 1401883 - Don't hold unnecessary references to the Windows app shell. r=jimm, a=RyanVM\n\nWhen runnables are posted to the main thread's event loop, the event\nloop notifies any thread observers that this has been done.  The app\nshell registers itself as just such a runnable, and posts messages to\nthe native event loop that processing native events needs to be done.\n\nOn Windows, this posting takes an extra reference to the app shell, to\nkeep it alive until the message is processed by the native event loop,\nsince app shell code needs to be invoked during that processing.  The\nprocessing releases this extra reference, so everything stays balanced.\n\nExcept that it's possible for messages to be posted to the native event\nloop, and then browser shutdown happens.  Those messages are not\nprocessed and the associated references taken are not released.  This\nimbalance means that in debug builds, we appear to be leaking the app\nshell, and that leaking results in intermittent oranges.\n\nThis intermittent orange has manifested itself in a variety of ways over\nthe years, depending on how big the app shell itself was (since that\nchanges the number of bytes leaked) and how many leak-checked things the\napp shell was holding on to.  This bug is merely the latest\nmanifestation; the last serious work on analyzing the phenomenon and\nfixing it was done in bug 1220517.\n\nThe solution proposed in that bug was that we simply stop the extra\nreference counting; when the app shell is destroyed normally, we\nshouldn't be processing the native event loop any more anyway.  So even\nif the native event loop is holding (freed) pointers to the app shell,\nwe'd never execute the callback and perform a use-after-free.  Reading\nthrough the code suggests that this *ought* to be the case, but the\npotential for shooting ourselves in the foot seems awfully high.\n\nIn any event, this is not a problem unique to Windows; we have seen this\nsame sort of thing happen on OS X.  See nsAppShell::ProcessGeckoEvents\nin widget/cocoa/nsAppShell.mm.\n\nHere we propose a slightly different solution: we keep track of the\nnumber of native event callbacks we have scheduled, incrementing when we\nschedule, and decrementing when we actually run one.  When the app shell\nis destroyed, we simply set the number of outstanding events to zero,\nand we prohibit the callback from accessing the app shell if there are\nno outstanding events.  This solution is analogous to dropping the extra\nreference counting, but avoids potential badness if we do wind up\nprocessing native events after the app shell is destroyed.", "files": ["widget/windows/nsAppShell.cpp"], "git_node": null, "git_parents": [null], "node": "14a7aa94151de0f29f92e008ef37f89511633d70", "parents": ["e3a1391a1ae0496007159264fad8a40e05f75dca"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466606 - Calculate the current GetSample index when needed. r=bryce, a=RyanVM\n\nThe assumption that when calling GetNextRandomAccessPoint the next GetSample index would always be known was incorrect. It assumed that the call to GetNextRandomAccessPoint would always be preceded by a call to GetSample.\nThis is not always how the MediaSourceDemuxer called it.\n\nMozReview-Commit-ID: H1MyPpDEytk", "files": ["dom/media/mediasource/TrackBuffersManager.cpp", "dom/media/mediasource/TrackBuffersManager.h"], "git_node": null, "git_parents": [null], "node": "3f8c13e5e03e5a147d68119b9efb334c25327584", "parents": ["14a7aa94151de0f29f92e008ef37f89511633d70"], "tags": []}], "date": 1528830364, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "86": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1466387 - Set up the gray root tracer on worker thread. r=jonco, a=RyanVM", "files": ["js/src/shell/js.cpp", "js/src/tests/non262/regress/regress-1466387-worker-grayroot.js"], "git_node": null, "git_parents": [null], "node": "726e50cb332d92f6ee315bb6733df0d395bb564a", "parents": ["3f8c13e5e03e5a147d68119b9efb334c25327584"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1467743 - [marionette] Handle errors for nested promise in dispatchPointerMove. r=ato, a=test-only\n\nBecause the nested promise doesn't use the \"catch()\" method a\npossible raised error by its code is not handled, and will\ncause the outer promise never to resolve, which results in an\ninfinite hang.\n\nMozReview-Commit-ID: 1MFyKpmOjYz", "files": ["testing/marionette/action.js"], "git_node": null, "git_parents": [null], "node": "606b6857c9a47628cc257e0bdfab89e6d6b966c9", "parents": ["726e50cb332d92f6ee315bb6733df0d395bb564a"], "tags": []}], "date": 1528836474, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "87": {"changesets": [{"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1467440 - Allow periodic file updates on beta/release/esr60. r=RyanVM, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1635", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "56ec5b737f18d716fe4f8cfd1a56bcfe576cfb1c", "parents": ["606b6857c9a47628cc257e0bdfab89e6d6b966c9"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468423 - Change to greedy match to fix version parsing. r=RyanVM, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1639", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "04d46c805763b6d8757d3302d9767253c1955320", "parents": ["56ec5b737f18d716fe4f8cfd1a56bcfe576cfb1c"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1458492 - Uplift patches for correct popup window positions. r=jhorak, a=RyanVM\n\nIt fixe popup window placement at CSD window mode when titlebar is disabled.\nIt's a composition of these patches for Firefox 60:\n\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1441873\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1441665\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1456898\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1457309\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1457691", "files": ["widget/gtk/WidgetStyleCache.cpp", "widget/gtk/gtk3drawing.cpp", "widget/gtk/gtkdrawing.h", "widget/gtk/nsLookAndFeel.cpp", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "3578f6bf1ecfcafdfe1839a0493c77269b3ed2ae", "parents": ["04d46c805763b6d8757d3302d9767253c1955320"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1457661 - P1. Add mochitest. r=bryce, a=RyanVM\n\nMozReview-Commit-ID: 9YC8MaXRF42", "files": ["dom/media/test/mochitest.ini", "dom/media/test/test_arraybuffer.html"], "git_node": null, "git_parents": [null], "node": "f3f1173a28139f6b2a11d4c3fd73dad7538b3046", "parents": ["3578f6bf1ecfcafdfe1839a0493c77269b3ed2ae"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1457661 - P2. Ensure we call NotifyDataEnded for local resource once size is known. r=bryce, a=RyanVM\n\nA call to NotifyDataEnded is required even if the size was known when the resource was created. This ensures that the readyState is properly updated and that playback can immediately as no more data can be added once first loaded.\n\nMozReview-Commit-ID: FaJMBxJ9NkM", "files": ["dom/media/FileMediaResource.cpp", "dom/media/FileMediaResource.h"], "git_node": null, "git_parents": [null], "node": "d172fac7c7d94603a5baf13ee656e96959428b55", "parents": ["f3f1173a28139f6b2a11d4c3fd73dad7538b3046"], "tags": []}], "date": 1528898842, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "88": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1432737 - Add esr to the display version string. r=Callek, a=release", "files": ["browser/config/version_display.txt"], "git_node": null, "git_parents": [null], "node": "5a7b174910982369df1b23abd8577d904e2baed0", "parents": ["d172fac7c7d94603a5baf13ee656e96959428b55"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1446548 - Treat all GLSL versions \u003e=450 as 450. r=kvark, a=RyanVM\n\nMozReview-Commit-ID: 4i5IAvWNZb", "files": ["dom/canvas/WebGLShaderValidator.cpp"], "git_node": null, "git_parents": [null], "node": "43f0d1060e2d15e4b660141adfc8c82edf0fb7ee", "parents": ["5a7b174910982369df1b23abd8577d904e2baed0"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1455261 - Check for null metadata to workaround broken search.json. r=adw, a=RyanVM\n\nMozReview-Commit-ID: 4D2F30MHaqE", "files": ["toolkit/components/search/nsSearchService.js"], "git_node": null, "git_parents": [null], "node": "94108013697518e4e393c4a37a49d742996640a0", "parents": ["43f0d1060e2d15e4b660141adfc8c82edf0fb7ee"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1466863 - Just use empty metadata if invalid. r=florian, a=RyanVM\n\nMozReview-Commit-ID: 30Q5Sdi5ZRt", "files": ["toolkit/components/search/nsSearchService.js"], "git_node": null, "git_parents": [null], "node": "9b9625e75c2f81b2a90af4d66ea4ac53c4e425c5", "parents": ["94108013697518e4e393c4a37a49d742996640a0"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1464091 - Ignore case in media feature names inside media query expressions. r=heycam, a=RyanVM\n\nMedia feature names are converted to lower case before being processed, making\nthem effectively case-insensitive.\nPrefixes (\"min-\", etc.) and values are already treated in a case-insensitive\nmanner.\n\nMozReview-Commit-ID: JUeeEQEMIi4", "files": ["servo/components/style/gecko/media_queries.rs"], "git_node": null, "git_parents": [null], "node": "e1ce2a3068f4c4496e51b9c09bb5b07abd0c4642", "parents": ["9b9625e75c2f81b2a90af4d66ea4ac53c4e425c5"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1464091 - Test ascii-case-insensitivity of media query expressions. r=heycam, a=RyanVM\n\nMozReview-Commit-ID: 49pmJQXuvGo", "files": ["testing/web-platform/meta/MANIFEST.json", "testing/web-platform/tests/css/mediaqueries/mq-case-insensitive-001.html"], "git_node": null, "git_parents": [null], "node": "79f0eb1e703aa88f55a09b95212f1929033ae525", "parents": ["e1ce2a3068f4c4496e51b9c09bb5b07abd0c4642"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454630 - P1. Simplify retrieval of current TrackInfo. r=bryce, a=RyanVM\n\nAdding some documentation to clarify on the difference between mInfo and mOriginalInfo\n\nMozReview-Commit-ID: DWBsoi16QKf", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/MediaFormatReader.h"], "git_node": null, "git_parents": [null], "node": "6897558cfa133ae59928f6618910167454b067f4", "parents": ["79f0eb1e703aa88f55a09b95212f1929033ae525"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454630 - P2. Use new PDMFactory whenever encryption type change. r=bryce, r=cpearce, a=RyanVM\n\nIf the content being played was first non-encrypted, the PDMFactory would have been set without a CDMProxy. As such, it is necessary to use a new PDMFactory when the encryption type changes (from clear to encrypted).\n\nRather than attempting to detect if the encryption status has changed, simply use two PDMFactory, one with CDMProxy set and one without (for clear content)\n\nAlso, never attempt to recycle a decoder if the encryption type changed (used only on Android)\n\nThe TrackBuffersManager would have already handle the dispatching of the encrypted event when parsing the new init segment. As such, nothing more is necessary.\n\nMozReview-Commit-ID: Jn14P2F6N5V", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/MediaFormatReader.h"], "git_node": null, "git_parents": [null], "node": "c04873fad58566b0d346d28837f6dbb91b342b8e", "parents": ["6897558cfa133ae59928f6618910167454b067f4"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454630 - P3. Always recreate the PDMFactory when CDMProxy change. r=bryce, a=RyanVM\n\nThe code couldn't have worked and didn't do what the comment stated. When the CDMProxy changes, the current PDMFactory for encrypted content can no longer be used.\n\nMozReview-Commit-ID: 7LpcQkK5gLL", "files": ["dom/media/MediaFormatReader.cpp"], "git_node": null, "git_parents": [null], "node": "e90141e8315d85415680a6da293056939dbf3c0b", "parents": ["c04873fad58566b0d346d28837f6dbb91b342b8e"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454630 - P4. Only wait for CDMProxy if actually needed for the given decoder. r=bryce, a=RyanVM\n\nIf the particular track isn't encrypted, there's no need to wait for a CDMProxy.\n\nMozReview-Commit-ID: DPbvbwsO58N", "files": ["dom/media/MediaFormatReader.cpp"], "git_node": null, "git_parents": [null], "node": "89f930216fdbf1f2f64ea2385843c067bd6334ab", "parents": ["e90141e8315d85415680a6da293056939dbf3c0b"], "tags": []}], "date": 1528933429, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "89": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist. r=RyanVM, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1651", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "2e5dac0cdbee167d6b302aae5645f0f1a67c721d", "parents": ["89f930216fdbf1f2f64ea2385843c067bd6334ab"], "tags": []}], "date": 1528984900, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "90": {"changesets": [{"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1443032 - Stop closing usrsctp on callback. r=jesup, a=RyanVM\n\nMozReview-Commit-ID: BgX9I1shVeN", "files": ["netwerk/sctp/datachannel/DataChannel.cpp"], "git_node": null, "git_parents": [null], "node": "e4e7bbcff4e3ea7d786c1b5a6bf2046eace7ff83", "parents": ["2e5dac0cdbee167d6b302aae5645f0f1a67c721d"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468830 - Ignore exceptions when retreiving response headers. r=rpl, a=RyanVM\n\nMozReview-Commit-ID: Dw4X1q15NHv", "files": ["toolkit/modules/addons/WebRequest.jsm"], "git_node": null, "git_parents": [null], "node": "5b7e2a2b06e1a3ecc50bc566eb733cba085e8357", "parents": ["e4e7bbcff4e3ea7d786c1b5a6bf2046eace7ff83"], "tags": []}], "date": 1529077521, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "91": {"changesets": [{"author": "Matt Woodrow \u003cmwoodrow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1464928 - Invalidate border-collapse tables when we remove the border from a cell. r=mstange, a=RyanVM\n\nMozReview-Commit-ID: 4LWdFJkr72v", "files": ["layout/reftests/invalidation/reftest.list", "layout/reftests/invalidation/table-repaint-e-ref.html", "layout/reftests/invalidation/table-repaint-e.html", "layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableColFrame.cpp", "layout/tables/nsTableColGroupFrame.cpp", "layout/tables/nsTableRowFrame.cpp", "layout/tables/nsTableRowGroupFrame.cpp"], "git_node": null, "git_parents": [null], "node": "45689b759100952aa0f9dfbb0bbda44aa581c174", "parents": ["5b7e2a2b06e1a3ecc50bc566eb733cba085e8357"], "tags": []}, {"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1464063 - Remove sdp_getchoosetok. r=bwc, a=RyanVM", "files": ["media/webrtc/signaling/src/sdp/sipcc/sdp_private.h", "media/webrtc/signaling/src/sdp/sipcc/sdp_token.c", "media/webrtc/signaling/src/sdp/sipcc/sdp_utils.c"], "git_node": null, "git_parents": [null], "node": "46efbe00b7c03cd9b5df62a74c524983cb60f145", "parents": ["45689b759100952aa0f9dfbb0bbda44aa581c174"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1464039 - Reject some invalid transforms in qcms. r=mwoodrow, a=RyanVM", "files": ["gfx/qcms/chain.c"], "git_node": null, "git_parents": [null], "node": "7bd079502f7a57cfcc372a7d4a1403de5a35e181", "parents": ["46efbe00b7c03cd9b5df62a74c524983cb60f145"], "tags": []}], "date": 1529331233, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "92": {"changesets": [{"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1321069 - Redirect the end event of a long-tap sequence back to the content window. r=karlt, a=jcristau\n\nIn the case of a long-tap touch sequence, a new popup window (the\ncontextmenu) is spawned while the sequence is ongoing. The touch-end of\nthe sequence ends up getting delivered to the popup window, instead of\nthe original content window, and that causes the touch-handling\nmachinery state in the content window to get out of sync with reality.\nThis patch detects this scenario and redirects the touch events on the\npopup window back to the original content window.\n\nMozReview-Commit-ID: L2vvKLlogRA", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "c616970f2bc9c0d37b960de02701026c6a591d08", "parents": ["7bd079502f7a57cfcc372a7d4a1403de5a35e181"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1413868. r=valentin, r=bkelly, a=RyanVM", "files": ["dom/ipc/ContentPrefs.cpp", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsEmbedFunctions.cpp", "xpcom/io/FilePreferences.cpp", "xpcom/io/FilePreferences.h", "xpcom/io/moz.build", "xpcom/io/nsLocalFileWin.cpp", "xpcom/tests/gtest/TestFilePreferencesWin.cpp", "xpcom/tests/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "2d4e4c71187c631518459ece8a9c7c3efd2cdfdb", "parents": ["c616970f2bc9c0d37b960de02701026c6a591d08"], "tags": []}], "date": 1529347200, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "93": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP. r=RyanVM, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1686", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "fdad80f80c92e79bab8e3fd94cd842654ac3ef93", "parents": ["2d4e4c71187c631518459ece8a9c7c3efd2cdfdb"], "tags": []}, {"author": "Paolo Amadini \u003cpaolo.mozmail@amadzone.org\u003e", "branch": "default", "desc": "Bug 1468217 - Add \"SettingContent-ms\" to the list of executable file extensions. r=Gijs, a=RyanVM", "files": ["xpcom/io/nsLocalFileWin.cpp"], "git_node": null, "git_parents": [null], "node": "ef41d7f4cc725afe4ddc8d9a9503cfd74b3dea10", "parents": ["fdad80f80c92e79bab8e3fd94cd842654ac3ef93"], "tags": []}], "date": 1529357644, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "94": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "7280f5232c7c90904a15299569e523adc449b196", "parents": ["ef41d7f4cc725afe4ddc8d9a9503cfd74b3dea10"], "tags": []}], "date": 1529360153, "git_changesets": [null], "user": "jlund@mozilla.com"}, "95": {"changesets": [{"author": "Jonathan Kingston \u003cjkt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454909 - Add support for system addon signing for web extension bundling. r=johannh,kmag a=RyanVM", "files": ["toolkit/components/extensions/Extension.jsm", "toolkit/components/extensions/ExtensionTestCommon.jsm", "toolkit/components/extensions/test/xpcshell/test_ext_experiments.js", "toolkit/components/extensions/test/xpcshell/test_ext_schemas_interactive.js", "toolkit/mozapps/extensions/internal/XPIProvider.jsm"], "git_node": null, "git_parents": [null], "node": "24df9f92227a8d39dca2520ae795e9ee33986796", "parents": ["7280f5232c7c90904a15299569e523adc449b196"], "tags": []}], "date": 1529407507, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "96": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1454909 followup - Fix eslint failure. a=bustage-fix", "files": ["toolkit/components/extensions/Extension.jsm"], "git_node": null, "git_parents": [null], "node": "2cfca18739cc7f792f23ebe897d64694e223bd66", "parents": ["24df9f92227a8d39dca2520ae795e9ee33986796"], "tags": []}], "date": 1529411594, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "97": {"changesets": [{"author": "Kyle Machulis \u003ckyle@nonpolynomial.com\u003e", "branch": "default", "desc": "Bug 1436241 - Check redirect status code before forwarding to NPAPI. r=jimm, r=pauljt, a=jcristau\n\nNPAPI may handle a 307 redirect across different origins, while they\nshould only happen on same origin requests. Have the browser check\nthis before forwarding to NPAPI.\n\nMozReview-Commit-ID: 5vxMooygI4g", "files": ["dom/plugins/base/nsPluginStreamListenerPeer.cpp"], "git_node": null, "git_parents": [null], "node": "3101edb8003d6a3341aeef23d40d4550ab525f24", "parents": ["2cfca18739cc7f792f23ebe897d64694e223bd66"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1464039 - Only reject qcms transform with invalid grid size if the transform function uses the grid size. r=Bas, a=jcristau", "files": ["gfx/qcms/chain.c", "gfx/thebes/gfxPlatform.cpp"], "git_node": null, "git_parents": [null], "node": "a64fb8de655dc28efd0b7de94b6f0008b08ae0ae", "parents": ["3101edb8003d6a3341aeef23d40d4550ab525f24"], "tags": []}, {"author": "David Parks \u003cdparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1462979: Do not hook network functions in plugin process. r=jimm, a=jcristau\n\nDisables the quirk that tells the plugin process to hook these methods.", "files": ["dom/plugins/ipc/PluginQuirks.cpp"], "git_node": null, "git_parents": [null], "node": "dd52b41d2b775e5c7261ce52795268b7670635fc", "parents": ["a64fb8de655dc28efd0b7de94b6f0008b08ae0ae"], "tags": []}], "date": 1529429834, "git_changesets": [null, null, null], "user": "jcristau@mozilla.com"}, "98": {"changesets": [{"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1458048 - Cherry pick usersctp rev 8789a6da02e2c7c03522bc6f275b302f6ef977fe; r=drno, a=RyanVM", "files": ["netwerk/sctp/src/netinet/sctp_auth.c", "netwerk/sctp/src/netinet/sctp_pcb.c"], "git_node": null, "git_parents": [null], "node": "effd37566c79242e4662e3c1c01167822ebf74f7", "parents": ["dd52b41d2b775e5c7261ce52795268b7670635fc"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1468770 - repo-update submitter and commit msg. r=RyanVM, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D1700", "files": ["taskcluster/docker/periodic-updates/runme.sh", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "4ad4c31db9b1526aab8641be98fec8e0d63a4a7e", "parents": ["effd37566c79242e4662e3c1c01167822ebf74f7"], "tags": ["FIREFOX_60_1_0esr_BUILD2", "FIREFOX_60_1_0esr_RELEASE"]}], "date": 1529583364, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}}
