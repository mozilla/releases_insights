ump MinGW to capture the CD3D11_BLEND_DESC fix. r=froydnj, a=jcristau\n\nMozReview-Commit-ID: 83igqfjKm6O", "files": ["taskcluster/scripts/misc/build-gcc-mingw32.sh"], "git_node": null, "git_parents": [null], "node": "eb0f41ed94fb693810f781cde223d196c256a180", "parents": ["54937944b92295a04f8a7d661301c867bb4b303a"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1448749 - Resolve undefined references to '_imp__mozalloc_abort' in the MinGW build. r=glandium, a=jcristau\n\nMozReview-Commit-ID: 5enjU5Xp8G9", "files": ["memory/mozalloc/mozalloc_abort.h"], "git_node": null, "git_parents": [null], "node": "33b018306051cf27cf27d89b3dcff6a1e7d8f6ec", "parents": ["eb0f41ed94fb693810f781cde223d196c256a180"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1461203 - Use GetScrollbarMetrics() to access scrollbar metrics. r=jhorak, a=jcristau\n\nMozReview-Commit-ID: 3gnFNfxQJZi", "files": ["widget/gtk/gtk3drawing.cpp"], "git_node": null, "git_parents": [null], "node": "efd762c4f413ba6df32feb49d0334a3853b20e75", "parents": ["33b018306051cf27cf27d89b3dcff6a1e7d8f6ec"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1420350 - Enable jemalloc on MinGW. r=glandium, a=jcristau\n\nMozReview-Commit-ID: 6YUeFAJocHj", "files": ["build/moz.configure/memory.configure"], "git_node": null, "git_parents": [null], "node": "f14e73288315189505508c50698133add2d255e9", "parents": ["efd762c4f413ba6df32feb49d0334a3853b20e75"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1460720 - Do not define _aligned_malloc - instead define _aligned_malloc_impl and export _aligned_malloc. r=glandium, a=jcristau\n\nMozReview-Commit-ID: 3EwAd81Iz7r", "files": ["memory/build/mozmemory_wrap.cpp", "memory/build/mozmemory_wrap.h", "mozglue/build/mozglue.def.in"], "git_node": null, "git_parents": [null]