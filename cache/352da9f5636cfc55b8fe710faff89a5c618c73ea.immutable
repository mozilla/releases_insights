s:34384:"{
"lastpushid": 1568,
"pushes": {"337": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 64fc0d6e7ff6b1d626e40d45c492fa210591a1c0 with FIREFOX_115_10_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "dbac2001252b2fe72c971b8484c18e28369311d1", "parents": ["64fc0d6e7ff6b1d626e40d45c492fa210591a1c0"], "tags": []}], "date": 1712602473, "git_changesets": [null], "user": "ffxbld"}, "338": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888488: update staging content signing root certificate to new cas_new root certificate  a=RyanVM\n\nThis is the cas_new root (https://bugzilla.mozilla.org/attachment.cgi?id=9390855) converted from PEM to DER with: `openssl x509 -in cas-new-root-2024-03-12.crt -inform PEM -outform DER`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D206040\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207263", "files": ["security/manager/ssl/content-signature-stage.crt"], "git_node": null, "git_parents": [null], "node": "baa3abffc5a68e9f07dfb834ee443908f7df6221", "parents": ["dbac2001252b2fe72c971b8484c18e28369311d1"], "tags": []}], "date": 1712866503, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "339": {"changesets": [{"author": "Butkovits Atila \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880181 - Update Wix-3.14 download URL. a=npotb", "files": ["taskcluster/ci/fetch/toolchains.yml"], "git_node": null, "git_parents": [null], "node": "c1a52fbd2c759c3639533782bc8a875e4701b9c7", "parents": ["baa3abffc5a68e9f07dfb834ee443908f7df6221"], "tags": []}], "date": 1712884361, "git_changesets": [null], "user": "abutkovits@mozilla.com"}, "340": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207261", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "e59eb594b7dca76b0ebef5070b7cfea2b3561744", "parents": ["c1a52fbd2c759c3639533782bc8a875e4701b9c7"], "tags": []}], "date": 1712940667, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "341": {"changesets": [{"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1824109 - [devtools] Wait for SpecialPowers task to be resumed before leaving the test. r=devtools-reviewers,nchevobbe a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D198795", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-call-stack.js"], "git_node": null, "git_parents": [null], "node": "289a9e087e7c0879cd87033d038664226f136c05", "parents": ["e59eb594b7dca76b0ebef5070b7cfea2b3561744"], "tags": []}, {"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1824109 - [devtools] Make sure the paused task is resumed before exiting r=devtools-reviewers,nchevobbe a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207088", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-call-stack.js"], "git_node": null, "git_parents": [null], "node": "1613765a78309d897b8125ff449e154fdd0641d8", "parents": ["289a9e087e7c0879cd87033d038664226f136c05"], "tags": []}], "date": 1713050251, "git_changesets": [null, null], "user": "acseh@mozilla.com"}, "342": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "51122efaec9aacaf71ea2b26fea9940789b41bca", "parents": ["1613765a78309d897b8125ff449e154fdd0641d8"], "tags": []}], "date": 1713171594, "git_changesets": [null], "user": "ffxbld-merge"}, "343": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207426", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "75f1199cb2bd79c6bca960a50b667783b1afb70a", "parents": ["51122efaec9aacaf71ea2b26fea9940789b41bca"], "tags": []}], "date": 1713228805, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "344": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_115_9_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_115_9_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "e2e0099d258d93de60e04f73912be72e938adadf", "parents": ["f65068dc82bf6051f520551ba5497a5985877d47"], "tags": []}], "date": 1713274094, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "345": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 64fc0d6e7ff6b1d626e40d45c492fa210591a1c0 with FIREFOX_115_10_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "82f361e0bbe823eb93c68e89d7a32062dc7c17ef", "parents": ["75f1199cb2bd79c6bca960a50b667783b1afb70a"], "tags": []}], "date": 1713281159, "git_changesets": [null], "user": "ffxbld"}, "346": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1860304 - Ignore service_worker property when off by pref  a=dmeehan\n\nWhen a background page and service_worker are specified simultaneously,\nload the background page instead of neither (i.e. the bug).\n\nThis patch only fixes the issue when\nextensions.backgroundServiceWorker.enabled is false; When true, the\nservice worker is expected to load but doesn't due to\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1775618#c1 . That requires\na different fix and is therefore saved for a follow-up.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D192081\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207570", "files": ["toolkit/components/extensions/Extension.sys.mjs", "toolkit/components/extensions/parent/ext-backgroundPage.js", "toolkit/components/extensions/parent/ext-runtime.js", "toolkit/components/extensions/test/xpcshell/test_ext_background_script_and_service_worker.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.ini"], "git_node": null, "git_parents": [null], "node": "d962391def52be4cd3c0c1ec216f0da1be14dbf7", "parents": ["82f361e0bbe823eb93c68e89d7a32062dc7c17ef"], "tags": []}], "date": 1713456141, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "347": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1889866 - Use text-color-deemphasized on syncedtabs sidebar rather than GrayText. r=desktop-theme-reviewers,dao, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D206990", "files": ["browser/components/syncedtabs/sidebar.xhtml", "browser/themes/shared/syncedtabs/sidebar.css"], "git_node": null, "git_parents": [null], "node": "7089cb4c66b3577354e881826ebaaf72e2305e01", "parents": ["d962391def52be4cd3c0c1ec216f0da1be14dbf7"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885009 - adjust swr to be more relevant [esr115] a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207951", "files": ["taskcluster/ci/test/mochitest.yml", "taskcluster/ci/test/variants.yml", "taskcluster/ci/test/web-platform.yml"], "git_node": null, "git_parents": [null], "node": "c14d8f64828d43f0ea7c23596b6f311b0b0e28a0", "parents": ["7089cb4c66b3577354e881826ebaaf72e2305e01"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888460 - move android-em/linux tests to use noscratch workers [ESR115]. r=aryx, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207952", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/test/awsy.yml", "taskcluster/ci/test/compiled.yml", "taskcluster/ci/test/mochitest.yml", "taskcluster/ci/test/web-platform.yml", "taskcluster/ci/test/xpcshell.yml", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/worker.py"], "git_node": null, "git_parents": [null], "node": "3832fd631f4112069beea11b45f12da901ff4801", "parents": ["c14d8f64828d43f0ea7c23596b6f311b0b0e28a0"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208120", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "1a9596cbb25158b67643ea589f9b24dd0c252fe5", "parents": ["3832fd631f4112069beea11b45f12da901ff4801"], "tags": []}], "date": 1713797714, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "348": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out 1 changesets (bug 1889866) from esr115 for causing test failures\n\nBacked out changeset 7089cb4c66b3 (bug 1889866)", "files": ["browser/components/syncedtabs/sidebar.xhtml", "browser/themes/shared/syncedtabs/sidebar.css"], "git_node": null, "git_parents": [null], "node": "146868c2d5500cc860e68cf5b7c58da88f71586c", "parents": ["1a9596cbb25158b67643ea589f9b24dd0c252fe5"], "tags": []}], "date": 1713804728, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "349": {"changesets": [{"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888460 - [ESR 115] - fix rebase issue where all linux tests were running on kvm instances. r=aryx a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208205", "files": ["taskcluster/ci/config.yml"], "git_node": null, "git_parents": [null], "node": "4d7c0c1770a13b870d9f3f9d0606d80c77603da8", "parents": ["146868c2d5500cc860e68cf5b7c58da88f71586c"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885009 - Fix swr/no-fission variant confusion. r=aryx a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208248", "files": ["taskcluster/ci/test/web-platform.yml"], "git_node": null, "git_parents": [null], "node": "f1a0cf2eb51d0c95fe00af7ef8a243df563d5417", "parents": ["4d7c0c1770a13b870d9f3f9d0606d80c77603da8"], "tags": []}], "date": 1713824008, "git_changesets": [null, null], "user": "csabou@mozilla.com"}, "350": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1878199 - patch 1 - Don't create an additional Mutex in FontFaceImpl::Entry, just use the base gfxFontEntry's existing RWLock.  a=dmeehan\n\nNo functional change here, just cleanup in preparation for the following patch.\nWe don't need FontFaceImpl to create a mutex, as there's already a lock (RWLock)\nin its base class gfxFontEntry, and we can use that to guard the fields here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D207295\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208097", "files": ["layout/style/FontFaceImpl.cpp", "layout/style/FontFaceImpl.h"], "git_node": null, "git_parents": [null], "node": "cef0feb16bdf48784c05721039abfcd2e677c7a4", "parents": ["f1a0cf2eb51d0c95fe00af7ef8a243df563d5417"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1878199 - patch 2 - If the FontFaceImpl has a user-font entry, hold its lock during Add/Remove font-set operations.  a=dmeehan\n\nThis should fix the intermittently-reported race here, by ensuring that access into\nthe FontFaceImpl from GetUserFontSets(), called by the main thread, cannot race with\nchanges being made by the AddFontSet()/RemoveFontSet() methods.\n\n(If the FontFaceImpl doesn't have an mUserFontEntry yet, then these methods don't\nneed to lock, as only the owning thread will be touching it.)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D207296\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208098", "files": ["layout/style/FontFaceImpl.cpp", "layout/style/FontFaceImpl.h"], "git_node": null, "git_parents": [null], "node": "1a0c2ddc34eac7d7f9bdc9e7a0071f50d992b2f1", "parents": ["cef0feb16bdf48784c05721039abfcd2e677c7a4"], "tags": []}], "date": 1713963446, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "351": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1886199 - Allow enabling containers via policy without the extension.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205320\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208357", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs"], "git_node": null, "git_parents": [null], "node": "1006a327826aac0f624f729b753a55914f2a0425", "parents": ["1a0c2ddc34eac7d7f9bdc9e7a0071f50d992b2f1"], "tags": []}], "date": 1713972959, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "352": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1876555 - Locking Proxy policies should always lock prefs.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D206011\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208361", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/helpers/ProxyPolicies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "cd66beaf400a79d1cee0d2f1fb6323f06d273050", "parents": ["1006a327826aac0f624f729b753a55914f2a0425"], "tags": []}], "date": 1714009193, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "353": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1887029 - Simplify TabAttributes to explicitly specify supported attributes, r=sessionstore-reviewers,sfoster,dao, a=dmeehan\n\nThe only tab attribute which is ever persisted by SessionStore is\n\"customizemode\". This patch limits the logic to only allow persisting and\nrestoring this attribute.\n\nThe browser_attributes.js test is also updated to use the \"customizemode\"\nattribute for testing, rather than a custom specified attribute.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205481", "files": ["browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/TabAttributes.sys.mjs", "browser/components/sessionstore/test/browser_attributes.js"], "git_node": null, "git_parents": [null], "node": "39f61fc5d16c29f4277de2af7dc1fba256c80d5d", "parents": ["cd66beaf400a79d1cee0d2f1fb6323f06d273050"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208603", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f5c52bd3fbadd8f5ba8d88e80f36cbb629759417", "parents": ["39f61fc5d16c29f4277de2af7dc1fba256c80d5d"], "tags": []}], "date": 1714052047, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "354": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out 1 changesets (bug 1887029) for causing test failures\n\nBacked out changeset 39f61fc5d16c (bug 1887029)", "files": ["browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/TabAttributes.sys.mjs", "browser/components/sessionstore/test/browser_attributes.js"], "git_node": null, "git_parents": [null], "node": "bcebc3285ade3fd44e9ca2dd5e1601486799b234", "parents": ["f5c52bd3fbadd8f5ba8d88e80f36cbb629759417"], "tags": []}], "date": 1714056977, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "355": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1892887 - Use MOZ_APP_NAME and XUL_DLL in GMPChild::MakeCDMHostVerificationPaths.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208456", "files": ["dom/media/gmp/GMPChild.cpp", "dom/media/gmp/moz.build"], "git_node": null, "git_parents": [null], "node": "dce433d07c13a10ee93fff3f985ad2f558433ac9", "parents": ["bcebc3285ade3fd44e9ca2dd5e1601486799b234"], "tags": []}], "date": 1714159763, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "356": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1890514: Null-check 'view' before using it, in nsTreeBodyFrame::RemoveImageCacheEntry.  a=dmeehan\n\nIf it's null, we'll now just take the existing something-failed early-return codepath.\n\nThe 'view' local variable here is really just an alias for mView, and we have\nnull-checks for mView elsewhere, so it's conceivable that it could be null when\nwe get to this point. (And we have a low but nonzero level of crash volume for\nfolks hitting a null-deref on this line, which seems to confirm that it is\noccasionally null here.)\n\nI'm not including a test since I'm not sure how to trigger the conditions\nrequired to crash in this way.  But the change is pretty trivial and clearly\na step in the direction of safety-against-crashing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D207817\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208379", "files": ["layout/xul/tree/nsTreeBodyFrame.cpp"], "git_node": null, "git_parents": [null], "node": "e038e08823cba03b081e77b4c7d0dedfd60e9cf3", "parents": ["dce433d07c13a10ee93fff3f985ad2f558433ac9"], "tags": []}], "date": 1714223778, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "357": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1882080 - Don't use double dots in the path used to restart Firefox on macOS r=afranchuk, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202789", "files": ["toolkit/crashreporter/client/crashreporter.cpp"], "git_node": null, "git_parents": [null], "node": "a73696eed7aa31958d9a3ea7c523a164ecd144b0", "parents": ["e038e08823cba03b081e77b4c7d0dedfd60e9cf3"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886082, r=Gijs,emilio, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207253", "files": ["toolkit/modules/PopupNotifications.sys.mjs"], "git_node": null, "git_parents": [null], "node": "c5a6eb53ccea598987f56b77a7d0fc7abe387c0e", "parents": ["a73696eed7aa31958d9a3ea7c523a164ecd144b0"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893260 - [ESR115] Move linux-tsan/browser-chrome to use noscratch disks. r=aryx, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208538", "files": ["taskcluster/ci/test/mochitest.yml"], "git_node": null, "git_parents": [null], "node": "0dcc5c5d62f669933327c84549532911d9124c1e", "parents": ["c5a6eb53ccea598987f56b77a7d0fc7abe387c0e"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1887029 - Simplify TabAttributes to explicitly specify supported attributes, a=dmeehan\n\nThe only tab attribute which is ever persisted by SessionStore is\n\"customizemode\". This patch limits the logic to only allow persisting and\nrestoring this attribute.\n\nThe browser_attributes.js test is also updated to use the \"customizemode\"\nattribute for testing, rather than a custom specified attribute.\n\nMinor test fix for ESR115.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208655", "files": ["browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/TabAttributes.sys.mjs", "browser/components/sessionstore/test/browser_attributes.js"], "git_node": null, "git_parents": [null], "node": "76c491d2246ba2f2ca2fa48ac919d06ed97575ee", "parents": ["0dcc5c5d62f669933327c84549532911d9124c1e"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208868", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "315ee3705f1f7301efb703f05c70d90d1d9bc662", "parents": ["76c491d2246ba2f2ca2fa48ac919d06ed97575ee"], "tags": []}], "date": 1714401330, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "358": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1893270: Make cairo font-creation functions consistently use calloc.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D208556\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208836", "files": ["gfx/cairo/cairo/src/cairo-cff-subset.c"], "git_node": null, "git_parents": [null], "node": "4518585d91c988b274afe84feecd569d077ca563", "parents": ["315ee3705f1f7301efb703f05c70d90d1d9bc662"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1893270 followup: save a copy of the cairo patch in-tree.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D208657\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208837", "files": ["gfx/cairo/cff-font-creation.patch"], "git_node": null, "git_parents": [null], "node": "e215485f8c7410541c0c11eb38c9d00714a0e573", "parents": ["4518585d91c988b274afe84feecd569d077ca563"], "tags": []}], "date": 1714478965, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "359": {"changesets": [{"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893645 - Simplify the way to pass font data to the main thread  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208995", "files": ["toolkit/components/pdfjs/content/build/pdf.js", "toolkit/components/pdfjs/content/build/pdf.worker.js"], "git_node": null, "git_parents": [null], "node": "710a50f0f51dccf165059cbfb254d921117a425f", "parents": ["e215485f8c7410541c0c11eb38c9d00714a0e573"], "tags": []}], "date": 1714588349, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "360": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1878577 - Ensure private storage repo is always cleaned up, even with PBM autostart.r=dom-storage-reviewers,janv, a=dmeehan", "files": ["dom/quota/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "4965e5dd8803d6299fd9b3a066c98b5fc818f3f9", "parents": ["710a50f0f51dccf165059cbfb254d921117a425f"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1886892 - Part 1: (ESR115) Remove non-SHIP code from desktop SessionStore, r=#sessionstore-reviewers, a=dmeehan\n\n\nIn bug 1804140, we shipped SHIP everywhere on desktop. Unfortunately, we\nnever removed the now-dead code from SessionStore.\n\nThis patch removes the easy to identify SessionStore code for non-SHIP,\nnow that it is a fully unsupported configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209145", "files": ["browser/base/content/tabbrowser.js", "browser/base/content/test/performance/browser_startup_content.js", "browser/components/sessionstore/ContentRestore.sys.mjs", "browser/components/sessionstore/ContentSessionStore.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/TabStateFlusher.sys.mjs", "browser/components/sessionstore/content/content-sessionStore.js", "browser/components/sessionstore/jar.mn", "browser/components/sessionstore/moz.build", "mobile/android/actors/GeckoViewContentChild.sys.mjs", "toolkit/modules/moz.build", "toolkit/modules/sessionstore/Utils.sys.mjs", "tools/esmify/map.json"], "git_node": null, "git_parents": [null], "node": "405ef133436cd51eea848642713e14c7f4c61f97", "parents": ["4965e5dd8803d6299fd9b3a066c98b5fc818f3f9"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1886892 - Part 2: (ESR115) Remove non-SHIP cases from SessionStore tests, r=#sessionstore-reviewers, a=dmeehan\n\n\nThese cases will no longer be run, as SHIP is always on for desktop firefox, so\ncan be removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209146", "files": ["browser/components/sessionstore/test/browser.ini", "browser/components/sessionstore/test/browser_687710_2.js", "browser/components/sessionstore/test/browser_705597.js", "browser/components/sessionstore/test/browser_707862.js", "browser/components/sessionstore/test/browser_async_flushes.js", "browser/components/sessionstore/test/browser_async_remove_tab.js", "browser/components/sessionstore/test/browser_async_window_flushing.js", "browser/components/sessionstore/test/browser_bfcache_telemetry.js", "browser/components/sessionstore/test/browser_docshell_uuid_consistency.js", "browser/components/sessionstore/test/browser_history_persist.js", "browser/components/sessionstore/test/browser_send_async_message_oom.js", "browser/components/sessionstore/test/browser_sessionHistory.js", "browser/components/sessionstore/test/head.js"], "git_node": null, "git_parents": [null], "node": "7e6d8c3b9c33993fca36afce0fde8602ab8a7e20", "parents": ["405ef133436cd51eea848642713e14c7f4c61f97"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1884962 - report kProtectionHDCP for the protection mask. r=media-playback-reviewers,padenot, a=dmeehan\n\nAccording to what Widevine told us, `kProtectionNone` will cause playback\nto stop if HDCP_V1 is required. Therefore, we would report HDCP protection\nif there is no potential capturing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207483", "files": ["dom/media/gmp/ChromiumCDMProxy.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "7b75d03374b8fb1853d630becdd5d84da361a343", "parents": ["7e6d8c3b9c33993fca36afce0fde8602ab8a7e20"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209224", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f252865370c49a1330904499f43801c3080fea4d", "parents": ["7b75d03374b8fb1853d630becdd5d84da361a343"], "tags": []}], "date": 1714661901, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "361": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1894412 - When reading /etc/os-release, fall back to BUILD_ID when VERSION_ID is not set.  a=dmeehan\n\nArch Linux doesn't come with a VERSION_ID at all, but it has a BUILD_ID.\nSemantically, falling back to BUILD_ID when VERSION_ID is not present\nwould seem fair play:\n\nPer https://www.freedesktop.org/software/systemd/man/latest/os-release.html:\n\nBUILD_ID=\n    A string uniquely identifying the system image originally used as the\n    installation base. In most cases, VERSION_ID or IMAGE_ID+IMAGE_VERSION\n    are updated when the entire system image is replaced during an update.\n    BUILD_ID may be used in distributions where the original installation\n    image version is important: VERSION_ID would change during incremental\n    system updates, but BUILD_ID would not. This field is optional.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D209089\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209192", "files": ["widget/LSBUtils.cpp"], "git_node": null, "git_parents": [null], "node": "10d47da900b70fa50395066e605aaf6365d3effb", "parents": ["f252865370c49a1330904499f43801c3080fea4d"], "tags": []}], "date": 1714692572, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "362": {"changesets": [{"author": "Francesco Lodolo (:flod) \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 1894892 - Update l10n-changesets.json for ESR115,  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209352", "files": ["browser/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "3056630f339fb3087a91118182da6cc2239ff380", "parents": ["10d47da900b70fa50395066e605aaf6365d3effb"], "tags": []}], "date": 1714743747, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "363": {"changesets": [{"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1893340: Test nsINIParser for string and section deletion  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D208981\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209332", "files": ["xpcom/base/nsINIParser.cpp", "xpcom/tests/gtest/TestINIParser.cpp", "xpcom/tests/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "30f2b471b2f08adf4835ce240a52e1fdb0c2fffc", "parents": ["3056630f339fb3087a91118182da6cc2239ff380"], "tags": []}], "date": 1714766865, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "364": {"changesets": [{"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1886108 - Normalize error messages. ESR115  a=dmeehan\n\nThis is an ESR115-specific revision that drops the test changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D207920", "files": ["dom/workers/ScriptLoader.cpp"], "git_node": null, "git_parents": [null], "node": "98dee93cf4616db1aa692ff03660636b76ead127", "parents": ["30f2b471b2f08adf4835ce240a52e1fdb0c2fffc"], "tags": []}], "date": 1715000914, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "365": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209531", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "86bd738fb76a428807839736b53ef38cf6c45717", "parents": ["98dee93cf4616db1aa692ff03660636b76ead127"], "tags": []}], "date": 1715004411, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "366": {"changesets": [{"author": "Malte Juergens \u003cmjurgens@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885949 - Do not copy over HTTPS-First upgrade flag into new loadinfo  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205048\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209549", "files": ["dom/base/Document.cpp", "dom/security/nsHTTPSOnlyUtils.cpp", "dom/security/nsHTTPSOnlyUtils.h", "dom/security/test/https-first/browser.ini", "dom/security/test/https-first/browser_subdocument_downgrade.js", "dom/security/test/https-first/file_empty.html", "dom/security/test/https-first/file_subdocument_downgrade.sjs", "netwerk/base/LoadInfo.cpp"], "git_node": null, "git_parents": [null], "node": "36d2dde067333d0c181cb8e21b12b73c307575db", "parents": ["86bd738fb76a428807839736b53ef38cf6c45717"], "tags": ["FIREFOX_115_11_0esr_BUILD1", "FIREFOX_115_11_0esr_RELEASE"]}], "date": 1715006412, "git_changesets": [null], "user": "dmeehan@mozilla.com"}}
}";