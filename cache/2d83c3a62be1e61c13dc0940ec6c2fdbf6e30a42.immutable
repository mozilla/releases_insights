PreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "c01cf4fae5d8ee20817eaacf33169cf08040e02d", "parents": ["8fd69c9a1672d5225962a208f4ba46832ea4a8e1"], "tags": []}], "date": 1688645886, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "280": {"changesets": [{"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1839235 - Protect VideoBridgeChild's singleton with a StaticMutex r=lsalzman, a=RyanVM\n\nProtect  sVideoBridge like ImageBridgeChild::GetSingleton() to avoid race condition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181844", "files": ["gfx/layers/ipc/VideoBridgeChild.cpp"], "git_node": null, "git_parents": [null], "node": "7fe9c6957c762bfd520bff1f66a32c40e409e7d5", "parents": ["c01cf4fae5d8ee20817eaacf33169cf08040e02d"], "tags": []}], "date": 1688750318, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "281": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183158", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "41f0eb45f158a0bf95fb8d181bc415125d4e7cfe", "parents": ["7fe9c6957c762bfd520bff1f66a32c40e409e7d5"], "tags": []}], "date": 1689003077, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "282": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1782561 - Do not use getter_AddRefs to pass object to function r=necko-reviewers,cookie-reviewers,jesup,edgul, a=RyanVM\n\nWhen using getter_AddRefs it actually nulls out the pointer before\npassing it to the function, so in this case a new list was being\ncreated with every call to CreateOrUpdatePurgeList.\nInstead, we can just pass a reference to the `nsCOMPtr\u003cnsIArray\u003e&`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181743", "files": ["netwerk/cookie/CookieStorage.cpp", "netwerk/cookie/CookieStorage.h"], "git_node": null, "git_parents": [null], "node": "3b9ef0cfced16fafcf6415dec0245c8f51adc57f", "parents": ["41f0eb45f158a0bf95fb8d181bc415125d4e7cfe"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1782561 - Make sure we can evict cookies while processing AddCookie r=necko-reviewers,cookie-reviewers,jesup,edgul, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181744", "files": ["dom/ipc/ContentParent.cpp"], "git_node": null, "git_parents": [null], "node": "11c4f109f4d056c01f8c2eb7c94c1d86cab32dde", "parents": ["3b9ef0cfced16fafcf6415dec0245c8f51adc57f"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 1837686. r=jandem,rhunt a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182324", "files": ["js/src/jit/AliasAnalysis.cpp", "js/src/jit/MIR.h"], "git_node": null, "git_parents": [null], "node": "89b219b08539ba26cd7f8aa8590696e1d768a0b9", "parents": ["11c4f109f4d056c01f8c2eb7c94c1d86cab32dde"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1839073, r=emilio, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181779", "files": ["toolkit/modules/PopupNotifications.jsm"], "git_node": null, "git_parents": [null], "node": "acd5ece8baec1c33279f86d56be954df0517c818", "parents": ["89b219b08539ba26cd7f8aa8590696e1d768a0b9"], "tags": []}], "date": 1689189144, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "283": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183487", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "800ff961ab58f0e6c453bd225a306021d02c597c", "parents": ["acd5ece8baec1c33279f86d56be954df0517c818"], "tags": []}], "date": 1689255878, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "284": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840777, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183362", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/ApplicationReputation.h", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": null, "git_parents": [null], "node": "ff58df5cb71869d915e8db5b18615aa05a8e8344", "parents": ["800ff961ab58f0e6c453bd225a306021d02c597c"], "tags": []}], "date": 1689269530, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "285": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1824634 disconnect from GtkIMContext OnDestroyWindow r=masayuki, a=dsmith\n\nwhich will allow a GtkIMContext to outlive the IMContextWrapper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182865", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": null, "git_parents": [null], "node": "4ab5ee7f04c214a92048ca75d3d6c3b622c17135", "parents": ["ff58df5cb71869d915e8db5b18615aa05a8e8344"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1824634 hold GtkIMContext reference a little longer than preedit-changed r?masayuki, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182866", "files": ["widget/gtk/GRefPtr.h", "widget/gtk/IMContextWrapper.cpp"], "git_node": null, "git_parents": [null], "node": "0b6fc2a1f4d417b2e203ad21cbbbda546da5a191", "parents": ["4ab5ee7f04c214a92048ca75d3d6c3b622c17135"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1842325. Ensure that WebRenderLayerManager::mTarget is always cleared after a transaction. r=gfx-reviewers,lsalzman, a=dsmith\n\nThe scope exit in WebRenderLayerManager::EndTransactionWithoutLayer isn't necessary because there are no early returns in that function, but I added it just in case an early return is added in the future.\n\nThe assert in nsDisplayList::PaintRoot currently holds because of how the current code is, but these changes will mean EndEmptyTransaction will handle that case as far as clearing mTarget is concerned.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183069", "files": ["gfx/layers/wr/WebRenderLayerManager.cpp", "gfx/layers/wr/WebRenderLayerManager.h", "layout/painting/nsDisplayList.cpp"], "git_node": null, "git_parents": [null], "node": "76400b71a3cdfee96587585298c044da5c10330c", "parents": ["0b6fc2a1f4d417b2e203ad21cbbbda546da5a191"], "tags": []}], "date": 1689352817, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "286": {"changesets": [{"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1783689 - Fix typo in mozharness warning; r=releng-reviewers,aki, a=testonly\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153978", "files": ["testing/mozharness/mozharness/base/python.py"], "git_node": null, "git_parents": [null], "node": "bdc2ebf043cfa3c9185bdf0367e43523169531ac", "parents": ["76400b71a3cdfee96587585298c044da5c10330c"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1831467 - Avoid more UB from transmuting a ref to a ref with interior mutability. r=emilio,a=dsmith\n\naka one specific change in LLVM 16 introducing UB in Rust, take 3? 4?\n\nThis time, we have multiple types like:\n  #[xpcom(implement(nsISomething))]\n  struct Foo {\n      foo: RefCell\u003cSomething\u003e,\n  }\n\n  impl Foo {\n      fn from_interface(obj: &nsISomething) -\u003e &Self {\n          unsafe { ::std::mem::transmute(obj) }\n      }\n  }\n\nAt first glance, this looks innocuous. But the problem is that\nnsISomething, as far as LLVM is informed by Rust, is readonly,\nbut Foo, via the RefCell, has interious mutability.\n\nLLVM ends up assuming that any mutability that happens to that returned\n&Foo can't happen, and removes it.\n\nThis is yet another case where https://github.com/rust-lang/rust/issues/111229\nwould save our feet from this footgun LLVM 16 added and that the rust\ncompiler doesn't help us prevent the least.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183569", "files": ["xpcom/idl-parser/xpidl/rust.py"], "git_node": null, "git_parents": [null], "node": "0cc789da5ff404ad06dfce1946514144cca0c886", "parents": ["bdc2ebf043cfa3c9185bdf0367e43523169531ac"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183729", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "823008276619228fa533da8b026cdc72000d118f", "parents": ["0cc789da5ff404ad06dfce1946514144cca0c886"], "tags": []}], "date": 1689601453, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "287": {"changesets": [{"author": "Noemi Erli \u003cnerli@mozilla.com\u003e", "branch": "default", "desc": "Bug 1831467 - fix lint failure a=fix DONTBUILD", "files": ["xpcom/idl-parser/xpidl/rust.py"], "git_node": null, "git_parents": [null], "node": "3c2abdfa121e5f017a170fc2791e9ab996ac3364", "parents": ["823008276619228fa533da8b026cdc72000d118f"], "tags": []}], "date": 1689604827, "git_changesets": [null], "user": "nerli@mozilla.com"}, "288": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1843847. Clear nsDisplayListBuilder::mCurrentContainerASR at the end of a paint. r=mstange, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183741", "files": ["layout/painting/nsDisplayList.cpp"], "git_node": null, "git_parents": [null], "node": "469951a8bde7069f049d49239921b18541eb6745", "parents": ["3c2abdfa121e5f017a170fc2791e9ab996ac3364"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1841368, don't leak the old AttrArray::Impl, r=peterv, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183303", "files": ["dom/base/AttrArray.cpp"], "git_node": null, "git_parents": [null], "node": "461a860d822a9d7121fba06e11ca9bf7817a8719", "parents": ["469951a8bde7069f049d49239921b18541eb6745"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1842658 - Part 2: Use refcounting macros for nsHtml5OwningUTF16Buffer, r=mccr8, a=dsmith\n\nWhen the code was originally added in bug 1842658, it was to use non-atomic\nrefcounting across multiple threads due to some invariants preventing\nconcurrent access. That was changed in bug 1607762 to fix a race issue.\n\nWe should be able to switch to using the macros now, which will simplify the\ncode here a bit.\n\nDepends on D183203\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183204", "files": ["parser/html/nsHtml5OwningUTF16Buffer.cpp", "parser/html/nsHtml5OwningUTF16Buffer.h"], "git_node": null, "git_parents": [null], "node": "39238cdf16e8c82abb4cbe9ad7a5ffd189ae7211", "parents": ["461a860d822a9d7121fba06e11ca9bf7817a8719"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1843038 - Make CypherStrategy::DeserializeKey fallible, r=janv, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183509", "files": ["dom/quota/CipherStrategy.h", "dom/quota/DecryptingInputStream_impl.h", "dom/quota/DummyCipherStrategy.h", "dom/quota/NSSCipherStrategy.cpp", "dom/quota/NSSCipherStrategy.h"], "git_node": null, "git_parents": [null], "node": "f128b27632b3f7252a9d054b66fcfed153e54eeb", "parents": ["39238cdf16e8c82abb4cbe9ad7a5ffd189ae7211"], "tags": []}], "date": 1689797931, "git_changesets": [null, null, null, null], "user": "dsmith@mozilla.com"}, "289": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184088", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "3ec3d5a5aa1f200e6a95733e89808576fbe1d8b2", "parents": ["f128b27632b3f7252a9d054b66fcfed153e54eeb"], "tags": []}], "date": 1689860069, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "290": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779315 - Avoid tainting OffscreenCanvas if the principals match. r=lsalzman, a=dsmith\n\nIf we are on the main thread and have access to the principals, we\nshould perform the same check as we do for HTMLCanvasElement instead of\njust tainting the canvas.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151673", "files": ["dom/canvas/CanvasUtils.cpp", "dom/canvas/CanvasUtils.h", "dom/canvas/nsICanvasRenderingContextInternal.cpp"], "git_node": null, "git_parents": [null], "node": "03a36307e8751ebca66b64c373da742004aabb6d", "parents": ["3ec3d5a5aa1f200e6a95733e89808576fbe1d8b2"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779521 - Check for null principal when drawing images to a canvas element. r=lsalzman, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151819", "files": ["dom/canvas/CanvasUtils.cpp"], "git_node": null, "git_parents": [null], "node": "6f369918262b36773788155c74132c838d9e9010", "parents": ["03a36307e8751ebca66b64c373da742004aabb6d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1780042 - Set CanvasPattern principal for main thread OffscreenCanvas. r=lsalzman, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152710", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/nsICanvasRenderingContextInternal.cpp"], "git_node": null, "git_parents": [null], "node": "d5bd9f2711cdfe99035b29bcd621690a3d757b9d", "parents": ["6f369918262b36773788155c74132c838d9e9010"], "tags": []}, {"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833876., a=dsmith\ncommit f6d29793e6c74f1beb9e558f61398cbb501aebd1\nAuthor: Andrew Osmond \u003caosmond@mozilla.com\u003e\nDate:   Tue May 30 13:52:14 2023 -0400\n\n    Bug 1833876.\n\n    Differential Revision: https://phabricator.services.mozilla.com/D179483", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasUtils.cpp", "dom/canvas/OffscreenCanvas.cpp", "dom/canvas/OffscreenCanvas.h", "dom/html/HTMLCanvasElement.cpp", "dom/html/HTMLCanvasElement.h"], "git_node": null, "git_parents": [null], "node": "67f308759495c54b34f49d3af08f275b2f14d322", "parents": ["d5bd9f2711cdfe99035b29bcd621690a3d757b9d"], "tags": []}], "date": 1689885189, "git_changesets": [null, null, null, null], "user": "dsmith@mozilla.com"}, "291": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184360", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "381b375f07554410a27f95cefbc76b74c8274b46", "parents": ["67f308759495c54b34f49d3af08f275b2f14d322"], "tags": ["FIREFOX_102_14_0esr_BUILD1", "FIREFOX_102_14_0esr_RELEASE"]}], "date": 1690199251, "git_changesets": [null], "user": "dsmith@mozilla.com"}}
}";