s:29158:"{
"lastpushid": 1568,
"pushes": {"469": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging d4a50496fcaa7beb50ed8f63b28fa4d2be4fc779 with FIREFOX_115_15_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "579078f42208ad6b50a377b13df32056b152007b", "parents": ["d4a50496fcaa7beb50ed8f63b28fa4d2be4fc779"], "tags": []}], "date": 1724683325, "git_changesets": [null], "user": "ffxbld"}, "470": {"changesets": [{"author": "Doug Thayer \u003cdothayer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1811750 - Eliminate redundant array filling in performance.measure r=sefeng a=pascalc\n\nBasically we were falling off a cliff where if we had a bunch of marks recorded\nwith a particular name, when trying to measure we would fill an array with all\nof them only to return the last one. This just replaces that by iterating in\nreverse and returning the first matching mark. Arguably we should be using a\nhashmap or something here, but this is a quick and trivial improvement that I\nthink will resolve the reported issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D199451", "files": ["dom/performance/Performance.cpp"], "git_node": null, "git_parents": [null], "node": "a305eaf86d611d99ef0b811dbabaacb12f1e5d90", "parents": ["579078f42208ad6b50a377b13df32056b152007b"], "tags": []}], "date": 1724922265, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "471": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "3dd106759e3b4c199f41c57c4e9a839fd929f778", "parents": ["a305eaf86d611d99ef0b811dbabaacb12f1e5d90"], "tags": []}], "date": 1725283856, "git_changesets": [null], "user": "ffxbld-merge"}, "472": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging d4a50496fcaa7beb50ed8f63b28fa4d2be4fc779 with FIREFOX_115_15_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "6eda72b07578645ef60c4d8b0308c209c222963d", "parents": ["3dd106759e3b4c199f41c57c4e9a839fd929f778"], "tags": []}], "date": 1725367756, "git_changesets": [null], "user": "ffxbld"}, "473": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220799", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "94eeaee5ccbfd43f07f149afb558b5af8c085804", "parents": ["6eda72b07578645ef60c4d8b0308c209c222963d"], "tags": []}], "date": 1725384052, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "474": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221127", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "d564e3e3f06bcec7d0f70c5ab25f715cc9d62d99", "parents": ["94eeaee5ccbfd43f07f149afb558b5af8c085804"], "tags": []}], "date": 1725537400, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "475": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1916148 - set firefox-esr115-* bouncer aliases. r=bhearsum,releng-reviewers a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220778", "files": ["taskcluster/ci/release-bouncer-aliases/kind.yml"], "git_node": null, "git_parents": [null], "node": "ac55894e503fdf693b5820597d0b21ef3fa07110", "parents": ["d564e3e3f06bcec7d0f70c5ab25f715cc9d62d99"], "tags": []}], "date": 1725613087, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "476": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1916476. r=media-playback-reviewers,padenot, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220912", "files": ["dom/media/gmp/GMPVideoi420FrameImpl.cpp", "dom/media/gmp/GMPVideoi420FrameImpl.h"], "git_node": null, "git_parents": [null], "node": "1d420cca971ddaf4027a4b38ca69bd076db83f4f", "parents": ["ac55894e503fdf693b5820597d0b21ef3fa07110"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1897792 - Change NonVolatileSingleMask on ARM64. r=iain, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220148", "files": ["js/src/jit/arm64/Architecture-arm64.h"], "git_node": null, "git_parents": [null], "node": "3c6ae5ae9043ca55fc9c4074a2e73527d51554e5", "parents": ["1d420cca971ddaf4027a4b38ca69bd076db83f4f"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1858056 - Favor RawConfigParser.read_file instead of deprecated readfp r=saschanaz, a