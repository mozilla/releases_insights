mozilla.com\u003e", "branch": "default", "desc": "Bug 1916172 - update-verify: use `esr115-uv` OS Version in update urls. r=bhearsum a=release\n\nWe're soon going to enable updates from 115 to 128 for still-supported\nOSes, while keeping 115 alive for older Windows and Mac; pass a\nnon-default osVersion parameter to AUS to let us keep testing updates to\nnew esr115 releases on test channels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221225", "files": ["tools/update-verify/release/final-verification.sh", "tools/update-verify/release/updates/verify.sh"], "git_node": null, "git_parents": [null], "node": "455047263ac4ae6a14cad868c7b8d816416e04e9", "parents": ["4065c36f8011c073bc56832bdea18b4cc26a4742"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1876793 - bump get_automationrelevance timeout to 1 minute. r=releng-reviewers,taskgraph-reviewers,bhearsum a=release\n\nThere are cases where this needs more than 30s, e.g.\nhttps://hg.mozilla.org/releases/mozilla-beta/json-automationrelevance/54ad040f8a47539f1e5153aab3ed873341696280\nright now appears to take ~40s for me.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208113", "files": ["taskcluster/gecko_taskgraph/util/hg.py"], "git_node": null, "git_parents": [null], "node": "a498c490ec207bf93438483ef7bfd7d482f5d2ca", "parents": ["455047263ac4ae6a14cad868c7b8d816416e04e9"], "tags": []}], "date": 1726906878, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}, "499": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1905843, prevent unexpected use of result site origin,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215496\n\nDifferential Revision: https://phabricator.services.mozilla.com/D222922", "files": ["caps/nsScriptSecurityManager.cpp", "caps/nsScriptSecurityManager.h", "dom/security/nsContentSecurityManager.cpp", "dom/security/nsContentSecurityManager.h"], "git_node": null, "git_parents": [null], "node": "c8629e30ae3c8286f7941cf5eb385ec24980697e", "parents": ["a498c490ec207bf93438483ef7bfd7d482f5d2ca"], "tags": []}], "date": 1726927176, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "500": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223111", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6644fb42021841f02be5bbaf8208b352114c7b3b", "parents": ["c8629e30ae3c8286f7941cf5eb385ec24980697e"], "tags": ["FIREFOX_115_16_0esr_BUILD1", "FIREFOX_115_16_0esr_RELEASE"]}], "date": 1727091243, "git_changesets": [null], "user": "dsmith@mozilla.com"}}
