51-1.html"], "git_node": null, "git_parents": [null], "node": "20dd44b73ff0c712d22858d2fb5980e76771dbb2", "parents": ["8c7f0ee9916d963ae2d2f1d05f0f0753039f112c"], "tags": []}], "date": 1726046687, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "483": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221961", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "053e80274261230a0f48fabe9c9eb4bd287f7810", "parents": ["20dd44b73ff0c712d22858d2fb5980e76771dbb2"], "tags": []}], "date": 1726148718, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "484": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915813 - Fix a crash with Microsoft TTD.  a=diannaS\n\nMicrosoft TTD has a CPU emulation bug that makes Firefox crash when ran\nunder TTD. This patch mitigates the issue.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220829\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221937", "files": ["gfx/qcms/src/transform_avx.rs", "gfx/qcms/src/transform_sse2.rs"], "git_node": null, "git_parents": [null], "node": "c87ba6071494b5e61c4051971c6de969ae8d23eb", "parents": ["053e80274261230a0f48fabe9c9eb4bd287f7810"], "tags": []}], "date": 1726162361, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "485": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1715248 - include upload-symbols tasks in desktop release promotion. r=releng-reviewers,taskgraph-reviewers,gbrown a=release\n\nUsually, upload-symbols tasks run as part of the on-push graph; however, if a\npush only touches platform-specific code, builds for other platforms may get\noptimized out, along with the corresponding upload-symbols tasks.  If release\npromotion is triggered on such a push, we may end up shipping builds whose\nsymbols are missing from the symbols server, affecting downstream consumers\nlike crash-stats.  To avoid this, ensure beetmover jobs (as an arbitrary\nchoice) pull in the upload-symbols tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219768", "files": ["taskcluster/ci/beetmover-repackage/kind.yml", "taskcluster/gecko_taskgraph/transforms/beetmover_repackage.py"], "git_node": null, "git_parents": [null], "node": "3a8f3475655d40b77d4bb9c98a0809d21d9d19cd", "parents": ["c87ba6071494b5e61c4051971c6de969ae8d23eb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872744: Clean up DNSReqestSender::Cancel r=necko-reviewers,valentin, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220711", "files": ["netwerk/dns/DNSRequestChild.cpp"], "git_node": null, "git_parents": [null], "node": "da5a6d4882c2500625708f8df5a4ddfde70e74a5", "parents": ["3a8f3475655d40b77d4bb9c98a0809d21d9d19cd"], "tags": []}], "date": 1726197140, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "486": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset da5a6d4882c2 (bug 1872744) for bustage", "files": ["netwerk/dns/DNSRequestChild.cpp"], "git_node": null, "git_parents": [null], "node": "39e38fe9bbebf513460138ade3d23b67dc1c5f44", "parents": ["da5a6d4882c2500625708f8df5a4ddfde70e74a5"], "tags": []}], "date": 1726198339, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "487": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "de