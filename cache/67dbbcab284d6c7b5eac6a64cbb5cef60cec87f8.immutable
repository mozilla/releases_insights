mozilla.com/D269590\n", "files": ["taskcluster/ci/geckodriver-mac-notarization/kind.yml", "taskcluster/ci/release-beetmover-push-to-release/kind.yml", "taskcluster/ci/release-eme-free-repack-mac-notarization/kind.yml", "taskcluster/ci/shippable-l10n-mac-notarization/kind.yml", "taskcluster/gecko_taskgraph/transforms/beetmover_push_to_release.py", "taskcluster/gecko_taskgraph/transforms/mar_signing.py", "taskcluster/gecko_taskgraph/transforms/openh264_signing.py", "taskcluster/gecko_taskgraph/transforms/release_generate_checksums_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing_partner.py", "taskcluster/gecko_taskgraph/transforms/signing.py", "taskcluster/gecko_taskgraph/transforms/source_checksums_signing.py", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "4f38c99bde7d85a6aaed70d407fbe64897bfb500", "git_parents": ["d571f3b78e93640c4e9bb0d82ed686115307a9e0"], "node": "46daa4e63c586a10a65988c6565be518b1ca9e02", "parents": ["afe2c6b3233aa91eb4cbcd2563056f2b78301362"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995600 - stop setting default max-run-time for beetmover and signingscript tasks.  a=RyanVM DONTBUILD\n\nThe max-run-time is ignored by beetmover payload builders.\nFor signingscript, 10 minutes seems to be fine except for localized\nnotarization jobs, which started failing after scriptworker started\ntaking the payload's maxRunTime into account in v61.2.0.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269539\n\nDifferential Revision: https://phabricator.services.mozilla.com/D269591\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "9a169de358dcdf089ba3f5f24142efa3b6c0e0fd", "git_parents": ["4f38c99bde7d85a6aaed70d407fbe64897bfb500"], "node": "de5f2fe01d1468f22c5602102e36e92c04459727", "parents": ["46daa4e63c586a10a65988c6565be518b1ca9e02"], "tags": []}], "date": 1761585857, "git_changesets": ["4f38c99bde7d85a6aaed70d407fbe64897bfb500", "9a169de358dcdf089ba3f5f24142efa3b6c0e0fd"], "user": "rvandermeulen@mozilla.com"}, "778": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270131\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "7af465ad7de3d7bffe1fa1d1f0d6fddfa8077f19", "git_parents": ["9a169de358dcdf089ba3f5f24142efa3b6c0e0fd"], "node": "ba9cf5f00eaf297b10e47febbeb1b02280a174ac", "parents": ["de5f2fe01d1468f22c5602102e36e92c04459727"], "tags": []}], "date": 1761586361, "git_changesets": ["7af465ad7de3d7bffe1fa1d1f0d6fddfa8077f19"], "user": "rvandermeulen@mozilla.com"}, "779": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 1649857 - Fix crash in parent process when RDD and GPU processes crashed simultaneously.  a=pascalc\n\nWhen the RDD and GPU processes crashed simultaneously, we could get into\na position where we would try to recreate PVideoBridge between the RDD\nand GPU processes, before bringing back up the RDD process. We should\nnow skip reinitializing the protocol if the RDD process is unavailable.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D175044\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270328\n", "files": ["dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h"], "git_node": "e52f6198265ddc7834e16aea7a9a18d09db17af0", "git_parents": ["7af465ad7de3d7bffe1fa1d1f0d6fddfa8077f19"], "node": "d39f3fc6adc403e5dc75a34bd74e0f45aea18f79", "parents": ["ba9cf5f00eaf297b10e47febbeb1b02280a174ac"], "tags": []}], "date": 1761671823, "git_changesets": ["e52f6198265ddc7834e16aea7a9a18d09db17af0"], "user": "pchevrel@mozilla.com"}, "780": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991945. r=farre a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D267575\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270313\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "2045068dff0c2879303cf63578c048ab13a2f95e", "git_parents": ["e52f6198265ddc7834e16aea7a9a18d09db17af0"], "node": "8606a283a576b01703c3ea698d3411b8962fa57b", "parents": ["d39f3fc6adc403e5dc75a34bd74e0f45aea18f79"], "tags": []}], "date": 1761690156, "git_changesets": ["2045068dff0c2879303cf63578c048ab13a2f95e"], "user": "pchevrel@mozilla.com"}, "781": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1445260 - Add release-mode checks to Vector's operator[], back() and popBack().   a=pascalc\n\nAlso, while I am touching this file, change some typedefs to using.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D266670\n\nDifferential Revision: https://phabricator.services.mozilla.com/D269447\n", "files": ["mfbt/Vector.h"], "git_node": "8ab740a2ec78713297c17c6e1746769e79506615", "git_parents": ["2045068dff0c2879303cf63578c048ab13a2f95e"], "node": "d0f2587e838616f68308a7518a98a62ba09c4a65", "parents": ["8606a283a576b01703c3ea698d3411b8962fa57b"], "tags": []}], "date": 1761691581, "git_changesets": ["8ab740a2ec78713297c17c6e1746769e79506615"], "user": "pchevrel@mozilla.com"}, "782": {"changesets": [{"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994164 - add support for additional directional formatting characters  a=pascalc\n