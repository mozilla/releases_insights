91 - Use integers for audio when on Android, or when using ARM on other OSes, and disable webm encoding. r=padenot, a=NPOTB", "files": ["configure.in"], "git_node": null, "git_parents": [null], "node": "c7f651bc93bfc2a2fef6dd6e785b493dd97be786", "parents": ["1dddc96b0d4787fe5f77ae1092392cd7e741714f"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1045096 - Make sure initial about:blank in iframes have a nsDOMNavigationTiming object, so we don't end up with window.performance throwing when accessed on their window. r=smaug, a=sledru", "files": ["docshell/base/nsDocShell.cpp", "docshell/test/mochitest.ini", "docshell/test/test_bug1045096.html"], "git_node": null, "git_parents": [null], "node": "9770d423057392c2b294571e8e7fbfda54c04497", "parents": ["c7f651bc93bfc2a2fef6dd6e785b493dd97be786"], "tags": []}, {"author": "Bobby Holley \u003cbobbyholley@gmail.com\u003e", "branch": "default", "desc": "Bug 1048330 - Null-check the XBL scope in more places. r=smaug, a=sledru", "files": ["dom/bindings/BindingUtils.h", "dom/xbl/nsBindingManager.cpp", "dom/xbl/nsXBLBinding.cpp"], "git_node": null, "git_parents": [null], "node": "80038bea118efc7c3fc89391a0f7ab1821efe862", "parents": ["9770d423057392c2b294571e8e7fbfda54c04497"], "tags": []}], "date": 1407336397, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "26": {"changesets": [{"author": "Cameron McCormack \u003ccam@mcc.id.au\u003e", "branch": "default", "desc": "Bug 1018524 - Make copies of more SVGLength objects when manipulating SVGLengthLists. r=longsonr, a=lmandel", "files": ["content/svg/content/src/DOMSVGLength.cpp", "content/svg/content/src/DOMSVGLength.h", "content/svg/content/src/DOMSVGLengthList.cpp", "content/svg/content/test/test_SVGLengthList.xhtml"], "git_node": null, "git_parents": [null], "node": "e56441aca60d623ba4ed5dd065ae6d9d837b9a74", "parents": ["80038bea118efc7c3fc89391a0f7ab1821efe862"], "tags": []}, {"author": "Cameron McCormack \u003ccam@mcc.id.au\u003e", "branch": "default", "desc": "Bug 1040575 - Make a copy of SVGSVGElement.currentTranslate if it is inserted into an SVGPointList. r=longsonr, a=lmandel", "files": ["content/svg/content/src/DOMSVGPoint.h", "content/svg/content/src/DOMSVGPointList.cpp", "content/svg/content/src/SVGSVGElement.cpp", "content/svg/content/src/SVGSVGElement.h", "content/svg/content/src/nsISVGPoint.h", "content/svg/content/test/test_SVGPointList.xhtml"], "git_node": null, "git_parents": [null], "node": "e52d2055fbb27188a9e8d119ce214f33d6fe3efd", "parents": ["e56441aca60d623ba4ed5dd065ae6d9d837b9a74"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1035007 - Make sure hostname is inserted in the right place. r=mcmanus, a=sledru", "files": ["netwerk/base/src/nsStandardURL.cpp"], "git_node": null, "git_parents": [null], "node": "ebefe851e8a1b7eaa74faa58ae630f1e299536b0", "parents": ["e52d2055fbb27188a9e8d119ce214f33d6fe3efd"], "tags": []}, {"author": "Ben Kelly \u003cben@wanderview.com\u003e", "branch": "default", "desc": "Bug 995688 - Always show scrollbars in test to avoid fade effect evicting document from BF cache. r=smaug, a=test-only", "files": ["dom/workers/test/test_multi_sharedWorker_lifetimes.html"], "git_node": null, "git_parents": [null], "node": "47e7e9cf87013fa006cd7641358a8aa6967421cf", "parents": ["ebefe851e8a1b7eaa74faa58ae630f1e299536b0"], "tags": []}], "date": 1407424146, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "27": {"changesets": [{"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1045421 - Remove date time bomb from test_crash_manager.js, add logging. r=gfritzsche, a=test-only\n\nThere was a hard-coded date in test_crash_manager.js of around August 3,\n2013. This meant that about a year later we would start to run into\nboundary issues since we weren't wrapping Date.now() inside\nCrashManager.jsm.\n\nIt turns out the actual value of DUMMY_DATE doesn't really matter. So,\nthe test has been changed to produce a value that is reasonably modern.\n\nWhile I was debugging this, I noticed we're not getting logging in the\ntests. So I added that.", "files": ["toolkit/components/crashes/CrashManagerTest.jsm", "toolkit/components/crashes/tests/xpcshell/test_crash_manager.js", "toolkit/components/crashes/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "ee9983a19037724cc0c0906508373d3f1bccd3d5", "parents": ["47e7e9cf87013fa006cd7641358a8aa6967421cf"], "tags": []}], "date": 1407426795, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "28": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 969608 et al - Skip browser_popupNotification.js on Linux debug. a=test-only", "files": ["browser/base/content/test/general/browser.ini"], "git_node": null, "git_parents": [null], "node": "0635e2fb1904cba76ea698d9d22d6b192c544b09", "parents": ["ee9983a19037724cc0c0906508373d3f1bccd3d5"], "tags": []}, {"author": "Jason Orendorff \u003cjorendorff@mozilla.com\u003e", "branch": "default", "desc": "Bug 1043690 - Part 1: Provide helper function for HTMLDocument and HTMLFormElement proxies to use from [[Set]]. r=efaust, a=lmandel", "files": ["js/src/jsapi-tests/moz.build", "js/src/jsapi-tests/testSetPropertyIgnoringNamedGetter.cpp", "js/src/jsfriendapi.h", "js/src/jsproxy.cpp"], "git_node": null, "git_parents": [null], "node": "798427a23a18b085964028fdad2eeb82988d6633", "parents": ["0635e2fb1904cba76ea698d9d22d6b192c544b09"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1043690 - Part 2: Change the codegen for DOM proxies to ignore named props when looking up property descriptors on [[Set]]. r=efaust, a=lmandel", "files": ["dom/base/WindowNamedPropertiesHandler.cpp", "dom/base/WindowNamedPropertiesHandler.h", "dom/bindings/Codegen.py", "dom/bi