, "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1831529 - Don't perform the primary intervention action when the help command is clicked. r=mak, a=RyanVM\n\nThe provider needs to check whether the help command was picked before\nperforming the primary action. Opening the help page is done by UrlbarInput\nwhile intervention actions are done by the interventions provider.", "files": ["browser/components/urlbar/UrlbarProviderInterventions.sys.mjs", "browser/components/urlbar/tests/browser-tips/browser_interventions.js"], "git_node": null, "git_parents": [null], "node": "2f88e12093dc6d14bd9df7b0f4a512291375210c", "parents": ["4ca9deca7e114f46cee8cb535d36bc74fd51eb85"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1848369 - Add checksum to Stencil XDR content. r=nbp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186264", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/frontend/StencilXdr.cpp", "js/src/frontend/StencilXdr.h", "js/src/vm/HelperThreads.cpp", "js/src/vm/Xdr.h"], "git_node": null, "git_parents": [null], "node": "5fb03c6b6af55f4abec463023598f22f41bd8db1", "parents": ["2f88e12093dc6d14bd9df7b0f4a512291375210c"], "tags": []}], "date": 1692213280, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "71": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1845499 - Update libcubeb to revision 41344b3a. r=cubeb-reviewers,kinetik a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184567", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_aaudio.cpp", "media/libcubeb/src/cubeb_log.cpp", "media/libcubeb/src/cubeb_wasapi.cpp"], "git_node": null, "git_parents": [null], "node": "e36eb37f1b1e455b0abbdc2eeb12900cf965e3c5", "parents": ["5fb03c6b6af55f4abec463023598f22f41bd8db1"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1845499 - Adjust patch for cubeb_aaudio.cpp. r=cubeb-reviewers,kinetik a=RyanVM\n\nDepends on D184567\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184568", "files": ["media/libcubeb/0001-disable-aaudio-before-android-31.patch"], "git_node": null, "git_parents": [null], "node": "3d506eb60f30c3626cd0d825b21383907af221d8", "parents": ["e36eb37f1b1e455b0abbdc2eeb12900cf965e3c5"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1845499 - Reapply in-tree patch on cubeb_aaudio.cpp. r=cubeb-reviewers,kinetik a=RyanVM\n\nDepends on D184568\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184569", "files": ["media/libcubeb/src/cubeb_aaudio.cpp"], "git_node": null, "git_parents": [null], "node": "779e91a5a07de0cabd432e6051c7e2f06fe4937a", "parents": ["3d506eb60f30c3626cd0d825b21383907af221d8"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1846158 - Update libcubeb to revision b9af56cee7. r=cubeb-reviewers,kinetik a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184920", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_aaudio.cpp"], "git_node": null, "git_parents": [null], "node": "8a0a33fca315ab0378dcc2497c3426a24d33491f", "parents": ["779e91a5a07de0cabd432e6051c7e2f06fe4937a"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1846158 - Reapply patch on top of libcubeb. r=cubeb-reviewers,kinetik a=RyanVM\n\nDepends on D184920\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184921", "files": ["media/libcubeb/src/cubeb_aaudio.cpp"], "git_node": null, "git_parents": [null], "node": "3422b8cabbef9e78b47ca5f9c070a70e2ba6f492", "parents": ["8a0a33fca315ab0378dcc2497c3426a24d33491f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1847009 - Update libcubeb to revision ac8474a5929. r=cubeb-reviewers,chunmin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185292", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_aaudio.cpp"], "git_node": null, "git_parents": [null], "node": "a53b06e4a8ac98fd9f069c9f88025bd528c39616", "parents": ["3422b8cabbef9e78b47ca5f9c070a70e2ba6f492"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1847009 - Reapply patch on top of cubeb. r=cubeb-reviewers,chunmin a=RyanVM\n\nDepends on D185292\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185293", "files": ["media/libcubeb/src/cubeb_aaudio.cpp"], "git_node": null, "git_parents": [null], "node": "a9214363dd93703bd89483eabb0e0bcd08ba1edd", "parents": ["a53b06e4a8ac98fd9f069c9f88025bd528c39616"], "tags": []}], "date": 1692235337, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "72": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186455", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0f87da8cf2d1dc1028f7ef5d134e0e98c9c4a376", "parents": ["a9214363dd93703bd89483eabb0e0bcd08ba1edd"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1838381 - Extend waitForInitialPageLoaded for \"WebDriver:NewSession\" for desktop builds. r=webdriver-reviewers,Sasha a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181361", "files": ["remote/marionette/driver.sys.mjs"], "git_node": null, "git_parents": [null], "node": "36e2eb16b3b339cce934ff6d4dfd02ea159c13cb", "parents": ["0f87da8cf2d1dc1028f7ef5d134e0e98c9c4a376"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845863: Expose HTML placeholder for RemoteAccessible. r=nlapre, a=RyanVM\n\nWe previously cached aria-placeholder, but not HTML placeholder.\nThese both map to the placeholder object attribute exposed by Accessible::Attributes, but they are retrieved differently internally.\n\nThis also fixes LocalAccessible::Attributes to always prefer HTML placeholder over aria-placeholder as per the ARIA spec.\nPreviously, the attribute we preferred was somewhat indeterminate (from the user's perspective) due to the ordering of hash maps.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186203", "files": ["accessible/generic/LocalAccessible.cpp", "accessible/html/HTMLFormControlAccessible.cpp", "accessible/html/HTMLFormControlAccessible.h", "accessible/ipc/RemoteAccessibleBase.cpp", "accessible/tests/browser/e10s/browser_caching_attributes.js"], "git_node": null, "git_parents": [null], "node": "455c7cac4a430f23cc8c4d54ac6a9218025565ac", "parents": ["36e2eb16b3b339cce934ff6d4dfd02ea159c13cb"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1847904 - Dispatch PR_Close to socketthread in ~TLSTransportLayer r=keeler,necko-reviewers,kershaw a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185978", "files": ["netwerk/protocol/http/TLSTransportLayer.cpp"], "git_node": null, "git_parents": [null], "node": "0ba68d0ffd912119f4e814850ab9662efc388412", "parents": ["455c7cac4a430f23cc8c4d54ac6a9218025565ac"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1848999 - Always release TLSTransportLayer on socket thread, r=necko-reviewers,valentin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186388", "files": ["netwerk/protocol/http/TLSTransportLayer.cpp", "netwerk/protocol/http/TLSTransportLayer.h"], "git_node": null, "git_parents": [null], "node": "c5b0b925a720994be7af01295ada4eb702bcf1d7", "parents": ["0ba68d0ffd912119f4e814850ab9662efc388412"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1847397 - Get the string heap to use after possible GC when executing regular expressions. r=jandem, a=RyanVM\n\nThe problem here is that initialStringHeap can be stale by the time it's used\nin UpdateRegExpStatics. GenerateRegExpMatchStubShared can allocate a shape\nwhich can trigger GC which can re-enable previously disabled nursery string\nallocation. This means we may incorrectly elide post barriers here.\n\nThe fix is to get the initial heap setting after potential GC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186012", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/JitRealm.h"], "git_node": null, "git_parents": [null], "node": "e2c524f79180bcad216badc2c829ff068d763123", "parents": ["c5b0b925a720994be7af01295ada4eb702bcf1d7"], "tags": []}], "date": 1692366104, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "73": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1842141 - fix page style no style menu checked state after reloads or same-origin navigations,  a=RyanVM\n\nThe issue here is that authorStyleDisabledDefault persists on the BrowsingContext.\nThis means it stays set/unset if the BC navigates same-origin (including\nreloads). But the actor was keeping its own copy, on the actor, and the actor\ngets destroyed in those circumstances, leading to the frontend and the internal\nstate no longer being in sync.\n\nThis patch addresses this by no longer keeping our own state and just reading\nthe browsingcontext's field directly.\n\nThis is a tiny bit hackish because technically, whether this is the 'default'\nis not the same as whether the author style is actually disabled, but in\npractice the child actor always sets the two at the same time, and it is\nthe simpler fix (vs. trying to mirror state to the parent some more).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D183188\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186440", "files": ["browser/actors/PageStyleChild.sys.mjs", "browser/actors/PageStyleParent.sys.mjs", "browser/base/content/browser-pagestyle.js", "browser/base/content/test/pageStyle/browser_disable_author_style_oop.js"], "git_node": null, "git_parents": [null], "node": "c9777ab7fc975411f507e75bdc0bb1a8867ad2f5", "parents": ["e2c524f79180bcad216badc2c829ff068d763123"], "tags": []}], "date": 1692383327, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "74": {"changesets": [{"author": "hsingh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1843046: Do not allow notifications in private window. r=saschanaz, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184064", "files": ["dom/notification/Notification.cpp"], "git_node": null, "git_parents": [null], "node": "27e84a0d49deff6953d30319e7193964b6c1b9ba", "parents": ["c9777ab7fc975411f507e75bdc0bb1a8867ad2f5"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1843046: Ignored a android kt private notification test. r=geckoview-reviewers,owlish a=RyanVM\n\nDepends on D184064\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185818", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/WebNotificationTest.kt"], "git_node": null, "git_parents": [null], "node": "2d8400b399ed1e7ecaa9951705e93488ee575967", "parents": ["27e84a0d49deff6953d30319e7193964b6c1b9ba"], "tags": []}], "date": 1692549455, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "75": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186622", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "bf2f656d025836975b7bf6aeb16901a037a01923", "parents": ["2d8400b399ed1e7ecaa9951705e93488ee575967"], "tags": ["FIREFOX_115_2_0esr_BUILD1", "FIREFOX_115_2_0esr_RELEASE"]}], "date": 1692616178, "git_changesets": [null], "user": "ryanvm@gmail.com"}}
}";