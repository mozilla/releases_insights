ngLength r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184410", "files": ["dom/svg/SVGTextContentElement.cpp", "layout/svg/SVGTextFrame.cpp", "layout/svg/SVGTextFrame.h"], "git_node": null, "git_parents": [null], "node": "22b2df0fafecd8f686a49a55af5cadd08b5db820", "parents": ["d04c00458180db3f5cfb29b16c4f3ea2dfa5a9cd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1845895 - Allow profile manager richlistbox to shrink. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184818", "files": ["toolkit/profile/content/profileSelection.xhtml", "toolkit/themes/shared/profileSelection.css"], "git_node": null, "git_parents": [null], "node": "91d79c26fd0e57f8188d7f624cc0f98a17daa894", "parents": ["22b2df0fafecd8f686a49a55af5cadd08b5db820"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1845350 - Prevent a division by zero when adjusting dts in MoofParser.cpp. r=alwu, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184683", "files": ["dom/media/mp4/MoofParser.cpp", "dom/media/test/crashtests/1845350.mp4", "dom/media/test/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "b2e7589246ed5adfc939d864cfc19af21fc8405e", "parents": ["91d79c26fd0e57f8188d7f624cc0f98a17daa894"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1844784 - Ensure Synced Tabs in the history menu is properly removed when FxAccounts are disabled. r=sync-reviewers,places-reviewers,lina,markh a=RyanVM", "files": ["browser/base/content/test/sync/browser_sync.js", "browser/components/places/PlacesUIUtils.sys.mjs", "services/sync/Weave.sys.mjs"], "git_node": null, "git_parents": [null], "node": "cf27e37edb2c86b04094309d62cc2b11e187b344", "parents": ["b2e7589246ed5adfc939d864cfc19af21fc8405e"], "tags": []}], "