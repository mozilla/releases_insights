s:66839:"{
"lastpushid": 1568,
"pushes": {"49": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 662ab9287f0197d9799c6c15fde1ec07bfce8865 with FIREFOX_115_1_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "f63fe3eba4641c1dc45934d508d6b7d054b75bac", "parents": ["662ab9287f0197d9799c6c15fde1ec07bfce8865"], "tags": []}], "date": 1690218432, "git_changesets": [null], "user": "ffxbld"}, "50": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "34b859c323ae96222bf284f8c87a34f0b81094f9", "parents": ["f63fe3eba4641c1dc45934d508d6b7d054b75bac"], "tags": []}], "date": 1690816772, "git_changesets": [null], "user": "ffxbld-merge"}, "51": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1842088 - Avoid blocking blocked modules when loaded as image resources on Windows 7.  a=RyanVM\n\nOur blocklist code must allow loading blocked modules using\nLoadLibraryExW with LOAD_LIBRARY_AS_IMAGE_RESOURCE, so that we can\ncollect information about them when we want to send untrusted module\npings. This means that we need a trustworthy way to distinguish between\nthese loads and regular DLL loads.\n\nCurrently, we do the distinction by looking at the AllocationProtect\nfield for the virtual memory mapped for the view. This solution was\nintroduced with bug 1702717, but unfortunately it doesn't work with\nWindows 7. This - mixed with other reasons - has resulted in the crash\nspike in bug 1842368.\n\nWe should thus move to a more trustworthy solution to distinguish\nbetween these two kinds of DLL loads. The new solution is to instead\ncheck whether the permission to map executable views was asked when the\nsection that we are mapping was created. Because this solution is past\nproof, it also has more chances to be future proof.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D183530\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184593", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp"], "git_node": null, "git_parents": [null], "node": "a1142d47112cd2e6368a5b47619bb3c441c051f9", "parents": ["34b859c323ae96222bf284f8c87a34f0b81094f9"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1842088 - Explicitly test DLL blocklist assumptions in isolation with a cppunit test.  a=RyanVM\n\nIn mozilla::freestanding::patched_NtMapViewOfSection, the DLL blocklist\ncode relies on implicit assumptions about how LoadLibrary(Ex)W and\nThread32Next work internally.\n\nSome of these assumptions turned out to be false on Windows 7. This led\nto crash spikes with 115 release; first in bug 1837242, and then later\nin bug 1842368. After dealing with the crash spikes, we realized that\nsome blocklist gtests are still failing on Windows 7, due to such wrong\nassumptions. So, in bug 1842088, we are changing the assumptions.\n\nThis patch adds a dedicated cppunit test to test these assumptions in\nisolation. It is easier to run than blocklist gtests, and should lead to\neasier diagnostics in case the assumptions break in the future. This\ntest also checks the Thread32Next assumptions, which protect us against\nthe crash from bug 1733532.\n\nDepends on D183530\n\nOriginal Revision: https://phabricator.services.mozilla.com/D183757\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184594", "files": ["testing/cppunittest.ini", "toolkit/xre/dllservices/tests/TestDllBlocklistAssumptions.cpp", "toolkit/xre/dllservices/tests/moz.build"], "git_node": null, "git_parents": [null], "node": "d7456c865648e6be17c2df063a4b050fa9aef123", "parents": ["a1142d47112cd2e6368a5b47619bb3c441c051f9"], "tags": []}], "date": 1690821077, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "52": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845111 - block all versions of kwsui64.dll in the socket process  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D184382\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184616", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": null, "git_parents": [null], "node": "71092156a468eb78a8e4c55b9b0106ffcfc0c50d", "parents": ["d7456c865648e6be17c2df063a4b050fa9aef123"], "tags": []}], "date": 1690821164, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "53": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184927", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "329016a08a7d28c03d9cb6dba56b328e94704d89", "parents": ["71092156a468eb78a8e4c55b9b0106ffcfc0c50d"], "tags": []}, {"author": "mcheang \u003cmcheang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1844890 - Change default engine change notification bar to display engine names rather than engine ids. r=Standard8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184280", "files": ["toolkit/components/search/SearchService.sys.mjs", "toolkit/components/search/tests/xpcshell/test_remove_engine_notification_box.js"], "git_node": null, "git_parents": [null], "node": "6aced6d6ac987ebdd45cdbfd94013f4dd555a682", "parents": ["329016a08a7d28c03d9cb6dba56b328e94704d89"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1837226 part 1: Tighten our clearing of mRegisteredWithRefreshDriver. r=hiro, a=RyanVM\n\nThis patch doesn't change behavior. It just:\n(a) avoids unnecessarily assigning the bool to false when it's already false.\n(b) makes it easier to validate that we do truly only clear this bool when we\nactually unregister.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180239", "files": ["widget/SwipeTracker.cpp"], "git_node": null, "git_parents": [null], "node": "53209db51202bec3a26d2bbece46efb28686aad3", "parents": ["6aced6d6ac987ebdd45cdbfd94013f4dd555a682"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1837226 part 2: Upgrade some assertions to be release assertions in SwipeTracker.cpp. r=hiro, a=RyanVM\n\nThis patch just strengthens some invariants to be validated in release builds\nas well.\n\nDepends on D180239\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180240", "files": ["widget/SwipeTracker.cpp"], "git_node": null, "git_parents": [null], "node": "bd41dbdd10a32791c158d90e9d7d8579091f3ea7", "parents": ["53209db51202bec3a26d2bbece46efb28686aad3"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1837226 part 3: Make nsBaseWidget::SwipeFinished destroy its SwipeTracker before clearing pointer. r=hiro, a=RyanVM\n\nThis new call should generally be a no-op, since we already un-register before\nwe get here, i.e. before we call SwipeFinished on the widget. This new call is\njust to be extra-sure we're unregistered.  With this change, nsBaseWidget is\nnow consistent about calling Destroy before clearing its mSwipeTracker pointer.\n\nDepends on D180240\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180241", "files": ["widget/nsBaseWidget.cpp"], "git_node": null, "git_parents": [null], "node": "bc6928f9e9b96455b70726563c0a9180a165a3ce", "parents": ["bd41dbdd10a32791c158d90e9d7d8579091f3ea7"], "tags": []}], "date": 1690829757, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "54": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 662ab9287f0197d9799c6c15fde1ec07bfce8865 with FIREFOX_115_1_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "7ad46715b3ea5763fc7f8c5cfcd09bbd75e526ae", "parents": ["bc6928f9e9b96455b70726563c0a9180a165a3ce"], "tags": []}], "date": 1690894115, "git_changesets": [null], "user": "ffxbld"}, "55": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1843758.  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184580", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/ApplicationReputation.h", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": null, "git_parents": [null], "node": "c294f0f42afd008b2a2f25058ce29f3b554456e1", "parents": ["7ad46715b3ea5763fc7f8c5cfcd09bbd75e526ae"], "tags": []}], "date": 1691079665, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "56": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185282", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f89d60060e9c149107b3d97294c3bbb154770562", "parents": ["c294f0f42afd008b2a2f25058ce29f3b554456e1"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1846883 - Run test_canvas on gpu instances. r+a=RyanVM\n\nThis reenables test_canvas on Windows and runs it on a GPU\ninstance so that we actually test the D2D code.\n\nThis test would've caught the regression in bug 1846613\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185237", "files": ["dom/canvas/test/mochitest.ini"], "git_node": null, "git_parents": [null], "node": "68bdc41e50570bc14952707efb5858dcd731c34a", "parents": ["f89d60060e9c149107b3d97294c3bbb154770562"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1843205 - Rollup tooltips on WM_KILLFOCUS. r=handyman, a=RyanVM\n\nJust like we rollup menus.\n\nThis is needed because tooltips otherwise get hidden on mousedown and\ndon't flush the view manager.\n\nThis matches the similar hunk for GTK in bug 1569439.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183489", "files": ["layout/xul/nsXULPopupManager.cpp", "widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "6626c95c5d1d9a64c4926747270c5b378a40f25c", "parents": ["68bdc41e50570bc14952707efb5858dcd731c34a"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1819592 - Don't set Sec- headers for system requests. r=freddyb,ckerschb a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180932", "files": ["dom/security/SecFetch.cpp", "dom/security/test/sec-fetch/browser_external_loads.js"], "git_node": null, "git_parents": [null], "node": "6a0e335faac3ba89e48fa4111c1b4fea951e0ba2", "parents": ["6626c95c5d1d9a64c4926747270c5b378a40f25c"], "tags": []}], "date": 1691080103, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "57": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1845146 - Check numberOfBytes{Read,Written} in TestManyHandles, r=ipc-reviewers,handyman a=test-only\n\nWhen running GTests on Windows 7, the TestManyHandles test crashes due\nto the lpNumberOfBytesWritten argument to WriteFile not being passed.\nThis argument is required on earlier versions of Windows like Windows 7.\n\nWhile we no longer support Windows 7 on Nightly, we still support it on\nESR, and are trying to run GTests on Windows 7 there. It also doesn't\nhurt to add extra assertions that the full amount of data is\nread/written, so checking this could be valuable on m-c as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184393", "files": ["ipc/ipdl/test/gtest/TestManyHandles.cpp"], "git_node": null, "git_parents": [null], "node": "f5e4353e4c2d813939143035a0b38914644cb97d", "parents": ["6a0e335faac3ba89e48fa4111c1b4fea951e0ba2"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1845603 - Enable mochitest-media on Windows 7. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184630", "files": ["dom/media/test/mochitest.ini", "dom/media/webrtc/tests/mochitests/mochitest_peerconnection.ini", "taskcluster/ci/test/test-sets.yml"], "git_node": null, "git_parents": [null], "node": "ed0d079046bfca76c1e3c3aba4bcba8ae91006da", "parents": ["f5e4353e4c2d813939143035a0b38914644cb97d"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1846063 - Enable crashtests on Windows 7. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184848", "files": ["dom/base/crashtests/crashtests.list", "dom/media/tests/crashtests/crashtests.list", "dom/media/webrtc/tests/crashtests/crashtests.list", "dom/svg/crashtests/crashtests.list", "extensions/spellcheck/hunspell/tests/crashtests/crashtests.list", "gfx/tests/crashtests/crashtests.list", "layout/base/crashtests/crashtests.list", "layout/generic/crashtests/crashtests.list", "layout/style/crashtests/crashtests.list", "layout/svg/crashtests/crashtests.list", "layout/tables/crashtests/crashtests.list", "taskcluster/ci/test/test-sets.yml", "testing/crashtest/crashtests.list"], "git_node": null, "git_parents": [null], "node": "2b8e129720202e7b40a78a1eca8c3aba0658e0ab", "parents": ["ed0d079046bfca76c1e3c3aba4bcba8ae91006da"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1845163 - Enable GTests on Windows 7. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184632", "files": ["taskcluster/ci/test/test-sets.yml"], "git_node": null, "git_parents": [null], "node": "d27b1a8832d2b742bd2c13884642a26228f0cd88", "parents": ["2b8e129720202e7b40a78a1eca8c3aba0658e0ab"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1845163 - Only run TestWindowsPackageManager tests on Windows 10+. r=bhearsum, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184633", "files": ["toolkit/system/windowsPackageManager/tests/gtest/TestWindowsPackageManager.cpp"], "git_node": null, "git_parents": [null], "node": "43c7badc82f26502bcc44bf956f6d131e76282b4", "parents": ["d27b1a8832d2b742bd2c13884642a26228f0cd88"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1845163 - Skip TestMediaDataEncoder tests on Windows 7. r=jolin, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184634", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": null, "git_parents": [null], "node": "3393cf49c04d85b0a0ec7676e3e33ac5972bdc87", "parents": ["43c7badc82f26502bcc44bf956f6d131e76282b4"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1845163 - Adjust check in VideoFrameConverterTest.BlackOnDisableCreated to allow equality. r=bwc, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184635", "files": ["dom/media/gtest/TestVideoFrameConverter.cpp"], "git_node": null, "git_parents": [null], "node": "b60d565fe943a12f22a75413bdeb37003bd80232", "parents": ["3393cf49c04d85b0a0ec7676e3e33ac5972bdc87"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1845163 - Skip GeckoProfiler.FeatureCombinations and GeckoProfiler.AllThreads on Windows 7. r=canaltinova, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184636", "files": ["tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": null, "git_parents": [null], "node": "b18ce703d10bd7da5c6bcee479fe4606cca02a1b", "parents": ["b60d565fe943a12f22a75413bdeb37003bd80232"], "tags": []}], "date": 1691081645, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "58": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1832266 - test that drags of file links don't work, r=mak,emilio a=test-only\n\nDepends on D178310\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178311", "files": ["dom/events/test/test_dragstart.html"], "git_node": null, "git_parents": [null], "node": "2225652a02ac110ea7022d83bf7f6c2719bc8e2c", "parents": ["b18ce703d10bd7da5c6bcee479fe4606cca02a1b"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835930 - [devtools] Extend timeout for browser_net_har_multipage.js r=devtools-reviewers,nchevobbe a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185290", "files": ["devtools/client/netmonitor/src/har/test/browser_net_har_multipage.js"], "git_node": null, "git_parents": [null], "node": "be6ffa455ee6ca16da88b1a420bf6ef4609ed18e", "parents": ["2225652a02ac110ea7022d83bf7f6c2719bc8e2c"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1845338 - Remove workaround that was breaking channel switching. r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184582", "files": ["toolkit/mozapps/update/UpdateService.sys.mjs"], "git_node": null, "git_parents": [null], "node": "2898cd5db295d7a7a79db46d02ee6bac87f02f9c", "parents": ["be6ffa455ee6ca16da88b1a420bf6ef4609ed18e"], "tags": []}], "date": 1691111803, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "59": {"changesets": [{"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 1773874: fix(angle): cherry-pick fe45418c6592ab210ba5a6101f5058fe24eed266 from upstream  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D184174\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185383", "files": ["gfx/angle/checkout/out/gen/angle/angle_commit.h", "gfx/angle/checkout/src/compiler/translator/ValidateTypeSizeLimitations.cpp", "gfx/angle/cherry_picks.txt"], "git_node": null, "git_parents": [null], "node": "b3253bff7063782c32d731bca109bd0b475f6c93", "parents": ["2898cd5db295d7a7a79db46d02ee6bac87f02f9c"], "tags": []}], "date": 1691113646, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "60": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1847107 - Allow one-off extra mozconfig content in mozharness. r=releng-reviewers,gbrown, a=dmeehan\n\nThis can be more versatile than having to add a new mozconfig variant,\nespecially when used via extra-config in the taskgraph, rather than via\nmozharness configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185355", "files": ["testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": null, "git_parents": [null], "node": "3fdca3ab182b05c25d3d24a66eccfd65df44d3f7", "parents": ["b3253bff7063782c32d731bca109bd0b475f6c93"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185542", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "06b40306ade29dfe5cb0c0c73d44a14b1b498cf4", "parents": ["3fdca3ab182b05c25d3d24a66eccfd65df44d3f7"], "tags": []}], "date": 1691420414, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "61": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1843968 - Hold some strong references. r=mccr8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184803", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellTreeOwner.cpp", "docshell/shistory/ChildSHistory.cpp", "docshell/shistory/nsSHistory.cpp", "dom/base/Location.cpp", "dom/base/nsFrameLoader.cpp", "dom/html/HTMLFormElement.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/WindowGlobalParent.cpp", "dom/l10n/DocumentL10n.cpp", "dom/prototype/PrototypeDocumentContentSink.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "parser/html/nsHtml5TreeOpExecutor.cpp", "parser/prototype/PrototypeDocumentParser.cpp", "toolkit/components/browser/nsWebBrowser.cpp", "toolkit/components/sessionstore/SessionStoreUtils.cpp", "xpfe/appshell/nsAppShellService.cpp"], "git_node": null, "git_parents": [null], "node": "33c6f8efe6e1f28f3cf44ac4ae1c5e553cc0fc43", "parents": ["06b40306ade29dfe5cb0c0c73d44a14b1b498cf4"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1841806 - Explicitly disallow encrypted indexedDB storage to be used for extension page running in privateBrowsing mode. r=asuth,janv, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D183732", "files": ["dom/indexedDB/ActorsParent.cpp", "toolkit/components/extensions/test/xpcshell/test_ext_indexedDB_principal.js"], "git_node": null, "git_parents": [null], "node": "1c2ebb0e8bec23b48474b8b651e560c38764c4d0", "parents": ["33c6f8efe6e1f28f3cf44ac4ae1c5e553cc0fc43"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1828024 - Require the helper thread lock in the GC helper thread count getter r=sfink, a=dmeehan\n\nThis makes us take a lock to read this state (we already lock when writing it).\n\nAlso it adds a release assert in case something goes wrong with the thread\ncount calculations, as a crash is preferable to the potential deadlock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181257", "files": ["js/src/gc/GC.cpp", "js/src/gc/ParallelMarking.cpp", "js/src/vm/HelperThreadState.h"], "git_node": null, "git_parents": [null], "node": "6dfbc3889a88e5eb06562f183a8b60f6786011c1", "parents": ["1c2ebb0e8bec23b48474b8b651e560c38764c4d0"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185904", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f96bee7d61a1e34b415cfc146c4369d02db18ea7", "parents": ["6dfbc3889a88e5eb06562f183a8b60f6786011c1"], "tags": []}], "date": 1691686018, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "62": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186111", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ca8667b8bfb1904e42ccb7aa3e3441b7df1c5cb8", "parents": ["f96bee7d61a1e34b415cfc146c4369d02db18ea7"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1828992: test. r=jonco, a=test-only\n\nDepends on D175912\n\nDifferential Revision: https://phabricator.services.mozilla.com/D175943", "files": ["dom/workers/test/mochitest.ini", "dom/workers/test/test_dynamicImport_and_terminate.html", "dom/workers/test/worker_dynamicImport.mjs"], "git_node": null, "git_parents": [null], "node": "a23a183755516f0421d7d2f4a6198df2311f9f32", "parents": ["ca8667b8bfb1904e42ccb7aa3e3441b7df1c5cb8"], "tags": []}, {"author": "Ray Kraesig \u003crkraesig@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838244 - [1/1] Resolve special directory paths in the parent process  r=gstoll a=RyanVM\n\nAvoid (one instance of) loading `shell32.dll` in the content process by\ndelaying the resolution of special-directory names to paths until\nthey're passed up into the client process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180988", "files": ["widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h", "widget/nsFilePickerProxy.cpp", "widget/nsFilePickerProxy.h"], "git_node": null, "git_parents": [null], "node": "8ef8aee4d3125c2e4aae3c81be1af0aaf503f755", "parents": ["a23a183755516f0421d7d2f4a6198df2311f9f32"], "tags": []}, {"author": "Bryan Thrall \u003cbthrall@mozilla.com\u003e", "branch": "default", "desc": "Bug 1839007 - Return bool from ErrorToException r=arai a=RyanVM\n\nIt is simpler to think about ErrorToException returning true when the error is\ncorrectly converted, which is why it returns false on recursion even though you\ncould argue that nothing went wrong in that case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184160", "files": ["js/src/jsexn.cpp", "js/src/jsexn.h", "js/src/vm/ErrorReporting.cpp"], "git_node": null, "git_parents": [null], "node": "e2eaa313a346c6558d98f278ebda791c9a26bd22", "parents": ["8ef8aee4d3125c2e4aae3c81be1af0aaf503f755"], "tags": []}, {"author": "Bryan Thrall \u003cbthrall@mozilla.com\u003e", "branch": "default", "desc": "Bug 1839007 - Return bool from FrontendContext::convertToRuntimeErrorAndClear r=arai a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184161", "files": ["js/src/frontend/FrontendContext.cpp", "js/src/frontend/FrontendContext.h", "js/src/vm/ErrorReporting.cpp", "js/src/vm/ErrorReporting.h", "js/src/vm/HelperThreads.cpp"], "git_node": null, "git_parents": [null], "node": "f03409ee57eb0f3890cd8ad8b71bd831b8e281b2", "parents": ["e2eaa313a346c6558d98f278ebda791c9a26bd22"], "tags": []}, {"author": "Bryan Thrall \u003cbthrall@mozilla.com\u003e", "branch": "default", "desc": "Bug 1839007 - Return false if converting to a runtime error triggers OOM r=arai a=RyanVM\n\nIn that case, the error stored in cx is an OOM rather than the expected\nSyntaxError. CheckRegExpSyntax should return false in that case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184162", "files": ["js/src/vm/RegExpObject.cpp"], "git_node": null, "git_parents": [null], "node": "301266ba91083748205bb806b05a396e97c1148f", "parents": ["f03409ee57eb0f3890cd8ad8b71bd831b8e281b2"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845813 - Null-check the variation tag dictionary before trying to apply it to the font. r=gfx-reviewers,lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185268", "files": ["gfx/2d/ScaledFontMac.cpp"], "git_node": null, "git_parents": [null], "node": "18b5b844ca52f38007f80c7baa6a5fb4cdcac3ba", "parents": ["301266ba91083748205bb806b05a396e97c1148f"], "tags": []}, {"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1846591 - [msix] Add vendor name from task configuration to repackaging command. r=gbrown,nalexander, a=RyanVM\n\nThunderbird will be publishing MSIX packages on the MS Store using a separate\naccount. The repackaging command supports setting the vendor name, but the task\nconfiguration does not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185075", "files": ["taskcluster/ci/repackage-msix/kind.yml", "taskcluster/ci/repackage-shippable-l10n-msix/kind.yml", "taskcluster/gecko_taskgraph/transforms/repackage.py"], "git_node": null, "git_parents": [null], "node": "34e1ec46c9c64a747d695303879e1eb80298185b", "parents": ["18b5b844ca52f38007f80c7baa6a5fb4cdcac3ba"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1847101 - Define WORDS_BIGENDIAN when targeting big endians. r=firefox-build-system-reviewers,ahochheiden, a=RyanVM\n\nSome third party code (cairo, pixman, some media libs) rely on this\ndefine being set. When they are built standalone, they get it from\nautoconf, but we don't run their configure scripts, so that's missed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185351", "files": ["build/moz.configure/init.configure"], "git_node": null, "git_parents": [null], "node": "44a25e5f604868a31a6603f2432e69130664c9be", "parents": ["34e1ec46c9c64a747d695303879e1eb80298185b"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1847101 - Disable webrtc on all big endians. r=firefox-build-system-reviewers,ahochheiden, a=RyanVM\n\nThe webrtc code explicitly fails to build on big endians to begin with.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185352", "files": ["toolkit/moz.configure"], "git_node": null, "git_parents": [null], "node": "7f203d083f68dae38a0185bf4e33cf180db3631a", "parents": ["44a25e5f604868a31a6603f2432e69130664c9be"], "tags": []}], "date": 1692043108, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "63": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 691187 - Backout changeset e6e098584f0ab from ESR115. r=aosmond, a=RyanVM\n\nThe initial fix in bug 691187 has caused numerous regressions that have required\nlater fixups to address. Since only the initial version that caused all these\nregressions made it into 115, it is safe to just back out the initial change rather\nthan try to uplift all the regression fixes. This at least reverts rendering to\nthe stable, tenable state it was in prior to 115 for ESR.\n\nThis also backs out changeset 4bd878e7c8de from bug 1837729.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185624", "files": ["dom/canvas/CanvasPath.h", "dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/test/test_canvas.html", "gfx/2d/2D.h", "gfx/2d/PathD2D.cpp", "gfx/2d/PathD2D.h", "gfx/2d/PathSkia.cpp", "gfx/2d/PathSkia.h"], "git_node": null, "git_parents": [null], "node": "f51b2c8d1ccb3ae35f92da984d0eb0c554824eb5", "parents": ["7f203d083f68dae38a0185bf4e33cf180db3631a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1751583. r=media-playback-reviewers,alwu a=RyanVM", "files": ["dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPServiceParent.cpp"], "git_node": null, "git_parents": [null], "node": "1ba65fe5e859433f6f993db7295547de6bdec41a", "parents": ["f51b2c8d1ccb3ae35f92da984d0eb0c554824eb5"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1846687: Don't allow CanvasTranslator to be initialized twice. r=jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185548", "files": ["gfx/layers/ipc/CanvasTranslator.cpp"], "git_node": null, "git_parents": [null], "node": "9fa8de7e28de4bd83e6abaf925b9cd039dcbb9e1", "parents": ["1ba65fe5e859433f6f993db7295547de6bdec41a"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1846694: Additional validation in RecordedSourceSurfaceCreation. r=gfx-reviewers,jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185354", "files": ["gfx/2d/RecordedEventImpl.h"], "git_node": null, "git_parents": [null], "node": "bc14a71e04a23a024216d2d46732e68f3c05939c", "parents": ["9fa8de7e28de4bd83e6abaf925b9cd039dcbb9e1"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1847529 - Provide typed versions of Pointer::ToPtr. r=gfx-reviewers,lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185564", "files": ["gfx/thebes/SharedFontList-impl.h", "gfx/thebes/SharedFontList.cpp", "gfx/thebes/SharedFontList.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxMacPlatformFontList.mm", "gfx/thebes/gfxPlatformFontList.cpp", "gfx/thebes/gfxPlatformFontList.h", "gfx/thebes/gfxTextRun.cpp"], "git_node": null, "git_parents": [null], "node": "e836d52a4783c5c2e5d8066548740c60b7c36ebf", "parents": ["bc14a71e04a23a024216d2d46732e68f3c05939c"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1846080: WebSocket cleanup r=kershaw,necko-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184828", "files": ["netwerk/protocol/websocket/WebSocketChannel.cpp"], "git_node": null, "git_parents": [null], "node": "d5bd78cf5e6531bfd536de93349380e2be6a682b", "parents": ["e836d52a4783c5c2e5d8066548740c60b7c36ebf"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845205: Add locking around access to WebSocketChannel::mPMCECompressor r=kershaw,necko-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184868", "files": ["netwerk/protocol/websocket/WebSocketChannel.cpp", "netwerk/protocol/websocket/WebSocketChannel.h"], "git_node": null, "git_parents": [null], "node": "db5d25ac2f21c564a62ad6b60a9edeff5ba3cca7", "parents": ["d5bd78cf5e6531bfd536de93349380e2be6a682b"], "tags": []}], "date": 1692045548, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "64": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1848729 - Add back missing WPT meta files from backout of bug 691187. r=ryanvm, a=test-only\n\nSomehow the WPT meta files got missed when changesets were combined for the backout.\nThis finally adds them back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186200", "files": ["testing/web-platform/meta/html/canvas/element/path-objects/2d.path.stroke.prune.closed.html.ini", "testing/web-platform/meta/html/canvas/element/path-objects/2d.path.stroke.prune.rect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/path-objects/2d.path.stroke.prune.closed.html.ini", "testing/web-platform/meta/html/canvas/offscreen/path-objects/2d.path.stroke.prune.closed.worker.js.ini", "testing/web-platform/meta/html/canvas/offscreen/path-objects/2d.path.stroke.prune.rect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/path-objects/2d.path.stroke.prune.rect.worker.js.ini"], "git_node": null, "git_parents": [null], "node": "8d2a7323184584c5e579e7031bce6b7c7a60d015", "parents": ["db5d25ac2f21c564a62ad6b60a9edeff5ba3cca7"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1847628 - Limit verbs in SkPath. r=aosmond, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185622", "files": ["gfx/skia/skia/src/core/SkPath.cpp"], "git_node": null, "git_parents": [null], "node": "ee2ff8e58dedb2c8afe4daeb8cf7d0f8f377dbb4", "parents": ["8d2a7323184584c5e579e7031bce6b7c7a60d015"], "tags": []}], "date": 1692066677, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "65": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1800897 - Don't fire resize events along before/afterprint. r=dholbert, a=RyanVM\n\nThis partially backs out bug 774398.\n\nThis code was added to match what Chromium was doing, but it seems (per\ndiscussions with Chromium engineers) that:\n\n * Resize event listener in Chromium never changed\n   innerWidth/innerHeight. That doesn't match my recollection from bug\n   774398, but it's true now in Chrome stable, at least.\n\n * Chromium canary no longer fires a resize event\n   (https://crbug.com/1076867).\n\n * WebKit doesn't fire resize either.\n\nSo let's get rid of this, which also causes some correctness issues with\nsome iframes, and keep just the media query listeners firing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185404", "files": ["dom/base/AutoPrintEventDispatcher.h", "dom/base/nsGlobalWindowOuter.cpp", "dom/ipc/BrowserChild.cpp", "testing/web-platform/mozilla/tests/css/cssom/size-change-print-notref.html", "testing/web-platform/mozilla/tests/css/cssom/size-change-print.html", "testing/web-platform/tests/css/printing/no-resize-event-print.html", "testing/web-platform/tests/css/printing/no-resize-event-ref.html"], "git_node": null, "git_parents": [null], "node": "d07b1d712d40a2e5e5b1e50e2a3bb85f14869dcc", "parents": ["ee2ff8e58dedb2c8afe4daeb8cf7d0f8f377dbb4"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1846526: Handle IPC error condition r=nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185164", "files": ["dom/serviceworkers/FetchEventOpChild.cpp"], "git_node": null, "git_parents": [null], "node": "24fcf3c75dec73f81002b3a4ec4e848dff39c097", "parents": ["d07b1d712d40a2e5e5b1e50e2a3bb85f14869dcc"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1848369 - Add checksum to Stencil XDR content. r=nbp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186098", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/frontend/StencilXdr.cpp", "js/src/frontend/StencilXdr.h", "js/src/vm/HelperThreads.cpp", "js/src/vm/Xdr.h"], "git_node": null, "git_parents": [null], "node": "9c1bbdbb0a373e5cd41e8fbd38c511c3cf6e5824", "parents": ["24fcf3c75dec73f81002b3a4ec4e848dff39c097"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1829200 - Get LoadContext/BrowsingContext from loadInfo.workerAssociatedBrowsingContext for WebRequests when the request is from Workers. r=extension-reviewers,robwu a=RyanVM\n\nFetch() from Workers would no longer create the channel in the content process but in the parent process. The corresponding BrowsingContext information for fetch() from Workers would be saved in the parent process channel's loadInfo.workerAssociatedBrowsingContext(ID).\nThis patch corrects the source of BrowsingContext for WebRequests when the request is from Workers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182705", "files": ["toolkit/components/extensions/test/mochitest/file_simple_iframe_worker.html", "toolkit/components/extensions/test/mochitest/file_simple_sharedworker.js", "toolkit/components/extensions/test/mochitest/file_simple_webrequest_worker.html", "toolkit/components/extensions/test/mochitest/file_simple_worker.js", "toolkit/components/extensions/test/mochitest/mochitest-common.ini", "toolkit/components/extensions/test/mochitest/test_ext_webrequest_worker.html", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp"], "git_node": null, "git_parents": [null], "node": "035bba598ba8a6961651f17c8d4d9ad4c6e85c4d", "parents": ["9c1bbdbb0a373e5cd41e8fbd38c511c3cf6e5824"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1841186 - Ensure homepage and new tabs menulists align. r=settings-reviewers,mconley a=RyanVM\n\nBy simplifying the markup a bit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182662", "files": ["browser/components/preferences/home.inc.xhtml"], "git_node": null, "git_parents": [null], "node": "55707ed5c948f856dd636ea9274eef62735eb389", "parents": ["035bba598ba8a6961651f17c8d4d9ad4c6e85c4d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1841186 - Ensure that if there's room for both homepage button texts, they fit without line-wrapping. r=settings-reviewers,mconley a=RyanVM\n\nDepends on D182662\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182663", "files": ["browser/components/preferences/home.inc.xhtml", "browser/themes/shared/preferences/preferences.css"], "git_node": null, "git_parents": [null], "node": "76d511fd1fc0bd3d058baf5c3f1e12989659c613", "parents": ["55707ed5c948f856dd636ea9274eef62735eb389"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1841767 - Always clear startup cache if .startup-incomplete is present, r=peterv,smaug, a=RyanVM\n\nPreviously we would only clear the startup cache if the\n.startup-incomplete sentinel file was created less than 6 hours ago,\nmeaning we could end up stuck in a state where the startup cache needs\nto be recreated if we hang during startup then wait 6 hours to re-launch\nFirefox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182820", "files": ["toolkit/xre/nsAppRunner.cpp"], "git_node": null, "git_parents": [null], "node": "bec1fe8b82326f25a66d71d85111465e18ec1972", "parents": ["76d511fd1fc0bd3d058baf5c3f1e12989659c613"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1844717 - Move downloadArea min-width rules so that they apply to places window. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184235", "files": ["browser/components/downloads/content/downloads.css", "browser/themes/shared/downloads/downloads.inc.css"], "git_node": null, "git_parents": [null], "node": "b0d976a46f968d99f09632e030bd0dd6764559df", "parents": ["bec1fe8b82326f25a66d71d85111465e18ec1972"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838432 - Only check for read permissions on Safari files when the files exist. r=mstriemer, a=RyanVM", "files": ["browser/components/migration/SafariProfileMigrator.sys.mjs"], "git_node": null, "git_parents": [null], "node": "85f0aa098dffdd8fc16f7f168c9ee72675e19587", "parents": ["b0d976a46f968d99f09632e030bd0dd6764559df"], "tags": []}], "date": 1692111317, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "66": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 9c1bbdbb0a37 (bug 1848369) for build bustage.", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/frontend/StencilXdr.cpp", "js/src/frontend/StencilXdr.h", "js/src/vm/HelperThreads.cpp", "js/src/vm/Xdr.h"], "git_node": null, "git_parents": [null], "node": "9e618ea2666411eff37933840c0724429b5ecc69", "parents": ["85f0aa098dffdd8fc16f7f168c9ee72675e19587"], "tags": []}], "date": 1692115561, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "67": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_115_0_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_115_0_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "fa02519ae20917d209869116cd8abfc433918042", "parents": ["5d2ffa4fb7d07a9afa9ecb9f2f9619c4e72fb5c9"], "tags": []}], "date": 1692121630, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "68": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821884 - Ensure consistent state for fullscreen/pointerlock warnings; r=Gijs, a=RyanVM\n\nFullscreen/PointerLock warnings are initialized with hidden=\"true\", but\nchange to hidden=\"\" after being shown and hidden again. I think this\nstarted happening when we began using HTML elements instead of XUL as\nthey handle hidden attribute differently.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177790", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/base/content/fullscreen-and-pointerlock.inc.xhtml", "brows