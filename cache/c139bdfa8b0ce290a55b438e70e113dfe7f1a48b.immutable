UNDERBIRD_45_VERBRANCH", "desc": "Bug 1312827 - make the certificate blocklist only apply to TLS server certificates r=jcj,mgoodwin a=rkent\n\n(rkent: note browser_certViewer.js changes were not incorporated in THUNDEBIRD_45_VERBRANCH due to\nmassive post-esr45 changes, but these tests do not run in Thunderbird anyway)\n\n(Note that content signature verification does not use the unified certificate\nverifier and thus will still consult OneCRL.)\n\nMozReview-Commit-ID: 6KvHOngpabT", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp", "security/manager/ssl/tests/unit/test_cert_blocklist.js"], "git_node": null, "git_parents": [null], "node": "5c894801eb1e1269e4e5d940402d0389c46f6daf", "parents": ["8e1a21d2b531d9734b02f7239d5c782caad14356"], "tags": []}], "date": 1485205181, "git_changesets": [null, null], "user": "kent@caspia.com"}, "398": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "THUNDERBIRD_45_VERBRANCH", "desc": "Bug 1191841 - Perform label resolution in scriptable charset setters of nsIContentViewer. r=emk, a=rkent\n\nMozReview-Commit-ID: facCC1K7Dk", "files": ["layout/base/nsDocumentViewer.cpp"], "git_node": null, "git_parents": [null], "node": "83ee87b301bd952e4fef2de8189062ea0b19276a", "parents": ["5c894801eb1e1269e4e5d940402d0389c46f6daf"], "tags": []}], "date": 1485208332, "git_changesets": [null], "user": "kent@caspia.com"}, "399": {"changesets": [{"author": "Ahmed (Gentz) El Gendy \u003czegentzy@gmail.com\u003e", "branch": "THUNDERBIRD_45_VERBRANCH", "desc": "Bug 1234317 - Update mLastSizeMode when window size mode changes within Windows widget, avoids a window focus problem on Windows 10 with theme changes. r=jimm, a=rkent\n\nMozReview-Commit-ID: FFpH8iZbxXK", "files": ["widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "eb6f18dbfe8db1093d52590efa19f9d1bebef7dd", "parents": ["83ee87b301bd952e4fef2de8189062ea0b19276a"], "tags": []}], "date": 1485208722, "git_changesets": [nu