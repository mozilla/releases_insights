"pushes": {"197": {"changesets": [{"author": "Jan Beich \u003cjbeich@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1288984 - Copy X11 include flags for more BSDs. r=glandium, a=sledru\n\nMozReview-Commit-ID: 8Nr3hehjp2v", "files": ["configure.in"], "git_node": null, "git_parents": [null], "node": "c900dca2a9c219ca6d243757810120af400ce8a2", "parents": ["0a590ea8e1cc4138c9bc198ba0906f099b85c346"], "tags": []}, {"author": "Jan Beich \u003cjbeich@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1288987 - Unbreak mtransport tests on more BSDs. r=jesup, a=gchang\n\nMozReview-Commit-ID: 41A3bKpN5pU", "files": ["netwerk/sctp/src/usrsctp.h"], "git_node": null, "git_parents": [null], "node": "c3b8d2761ab1e3e46fa68c1e28879aa49f235c40", "parents": ["c900dca2a9c219ca6d243757810120af400ce8a2"], "tags": []}, {"author": "Sami Jaktholm \u003csjakthol@outlook.com\u003e", "branch": "default", "desc": "Bug 1237492 - Hold a strong reference to the Worker used in webconsole tests. r=ejpbruel, a=test-only\n\nIf a reference is not kept, the Worker might be GCd before the test\ncompteles. If that happens, the test times out as it tries to detach\na worker that has already been destroyed.\n\nThe state object is kept around for the duration of the tests so\nkeeping a reference in the state object ensures the worker\nlifetime matches that of the test.\n\nMozReview-Commit-ID: 31F54vHlm3z", "files": ["devtools/shared/webconsole/test/common.js"], "git_node": null, "git_parents": [null], "node": "1968816a1e161bd1ab306fa9fd414077a2364f99", "parents": ["c3b8d2761ab1e3e46fa68c1e28879aa49f235c40"], "tags": []}], "date": 1469713534, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "198": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents":