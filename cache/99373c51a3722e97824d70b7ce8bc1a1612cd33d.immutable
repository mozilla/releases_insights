back.jsm"], "git_node": null, "git_parents": [null], "node": "51dd4d5ecb901fff739a3156ca3d587f7645edf6", "parents": ["4b7d3dbd2bea7ccac1ea8b2e90ff8efba9d7f864"], "tags": []}], "date": 1472088338, "git_changesets": [null], "user": "kent@caspia.com"}, "211": {"changesets": [{"author": "tbirdbld", "branch": "THUNDERBIRD4530_2016082513_RELBRANCH", "desc": "Automated checkin: version bump for thunderbird 45.3.0 release. DONTBUILD CLOSED TREE a=release", "files": ["config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "f194d7b9c0a32532962a1864181d49b5e99d9c7e", "parents": ["51dd4d5ecb901fff739a3156ca3d587f7645edf6"], "tags": ["THUNDERBIRD_45_3_0_BUILD1", "THUNDERBIRD_45_3_0_RELEASE"]}, {"author": "tbirdbld", "branch": "THUNDERBIRD4530_2016082513_RELBRANCH", "desc": "Added THUNDERBIRD_45_3_0_RELEASE THUNDERBIRD_45_3_0_BUILD1 tag(s) for changeset f194d7b9c0a3. DONTBUILD CLOSED TREE a=release", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "47b1567fd9c095783485e2edf072f86530a48e3c", "parents": ["f194d7b9c0a32532962a1864181d49b5e99d9c7e"], "tags": []}], "date": 1472146080, "git_changesets": [null, null], "user": "tbirdbld"}, "212": {"changesets": [{"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1288434 - Add task to mark release as shipped. r=rail a=release DONTBUILD\n\nMozReview-Commit-ID: 9NBQK4BcDUe", "files": ["testing/mozharness/configs/releases/dev_postrelease_firefox_beta.py", "testing/mozharness/configs/releases/dev_postrelease_firefox_release.py", "testing/mozharness/configs/releases/postrelease_firefox_beta.py", "testing/mozharness/configs/releases/postrelease_firefox_esr45.py", "testing/mozharness/configs/releases/postrelease_firefox_release.py", "testing/mozharness/scripts/release/postrelease_mark_as_shipped.py"], "git_node": null, "git_parents": [null], "node": "f0545cc755809c7829effe4d51292c2226d3e5fb", "parents": ["ec364c8a986463c72b59b5bc7bc363872debbde5"], "tags": []}], "date": 1472234823, "git_changesets": [null], "user": "raliiev@mozilla.com"}, "213": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1297934. Enforce the invariant that every display item class has a different display item type for nsDisplayFocusRing. r=mattwoodrow a=sylvestre", "files": ["layout/base/nsDisplayItemTypesList.h", "layout/forms/nsRangeFrame.cpp"], "git_node": null, "git_parents": [null], "node": "6e43a01fee3c58877625f038e1bbee130b220255", "parents": ["f0545cc755809c7829effe4d51292c2226d3e5fb"], "tags": []}, {"author": "Dragana Damjanovic dd.mozilla@gmail.com", "branch": "default", "desc": "Bug 1243312 - nsNetCID is missing in toolkit/system/unixproxy/nsLibProxySettings.cpp. r=jduell a=sylvestre", "files": ["toolkit/system/unixproxy/nsLibProxySettings.cpp"], "git_node": null, "git_parents": [null], "node": "4023f0262a0f8b6cc74fa6af3016cb799b5cb9a8", "parents": ["6e43a01fee3c58877625f038e1bbee130b220255"], "tags": []}, {"author": "Jan Beich \u003cjbeich@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1242132 - Make sure to split multiple _FLAGS after bug 1224452. r=glandium a=sylvestre", "files": ["python/mozbuild/mozbuild/frontend/gyp_reader.py"], "git_node": null, "git_parents": [null], "node": "5da55ed611bd98024f7f5e6be518bab3930da3c5", "parents": ["4023f0262a0f8b6cc74fa6af3016cb799b5cb9a8"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1251088. Update the stored mImageWidth/Height on ImageDocuments when we get the document load event. r=bz a=sylvestre\n\nWe only update mImageWidth/Height when we get the load event for the img element. But the style sheet TopLevelImageDocument.css can be loaded after the img load event. TopLevelImageDocument.css specifies that the orientation of the image comes from the embedded exif data, thus when it is loaded the image can rotate and change size. So we need to be sure to re-get the size after all style sheets are loaded.\n\nThis means mImageWidth/Height could be wrong during loading.", "files": ["dom/html/ImageDocument.cpp"], "git_node": null, "git_parents": [null], "node": "5ffa912ed83eff4d64a0cec2154816a3c25ce475", "parents": ["5da55ed611bd98024f7f5e6be518bab3930da3c5"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1254688 - Use mLoadInfo to get the performance object [esr45] r=bz,tanvi a=sylvestre\n\nMozReview-Commit-ID: KMbwR7J8FLm", "files": ["dom/tests/mochitest/general/resource_timing_main_test.html", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": null, "git_parents": [null], "node": "6711ccb0184e4693b0fe67eebe41180aeac4cc74", "parents": ["5ffa912ed83eff4d64a0cec2154816a3c25ce475"], "tags": []}, {"author": "Michal Novotny \u003cmichal.novotny@gmail.com\u003e", "branch": "default", "desc": "Bug 1287266 - Integer overflow check in WebSocketChannel::ProcessInput, r=mcmanus, a=sylvestre", "files": ["netwerk/protocol/websocket/WebSocketChannel.cpp"], "git_node": null, "git_parents": [null], "node": "bc2f5467b33d70d5dc03fdc0d2fcf0d52356f186", "parents": ["6711ccb0184e4693b0fe67eebe41180aeac4cc74"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chiikezoe@mozilla-japan.org\u003e", "branch": "default", "desc": "Bug 1282076 - Store all non-inherited structs which are stored on the rule node on the style context if we have animation data. r=heycam a=sylvestre", "files": ["layout/style/nsRuleNode.cpp", "layout/style/nsRuleNode.h"], "git_node": null, "git_parents": [null], "node": "10c9453407de40dd17d612f802da2fab94c161f4", "parents": ["bc2f5467b33d70d5dc03fdc0d2fcf0d52356f186"], "tags": []}, {"author": "Jan Horak \u003cjhorak@redhat.com\u003e", "branch": "default", "desc": "Bug 1277213 - Reset auth continuation state after dialog cancellation a=sylvestre", "files": ["netwerk/protocol/http/nsHttpChannelAuthProvider.cpp"], "git_node": null, "git_parents": [null], "node": "d91fc76079