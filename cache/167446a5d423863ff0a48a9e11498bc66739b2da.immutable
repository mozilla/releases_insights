.org\u003e", "branch": "default", "desc": "Bug 1709500 [wpt PR 28829] - Replace hard-coded cookie expiration dates in WPT Python files, a=testonly\n\nAutomatic update from web-platform-tests\nReplace hard-coded cookie expiration dates in WPT Python files\n\nThese cookies are meant to expire in the future (i.e. be valid now), but\nby hard-coding the expiration date, they will no longer be valid when\nthe date expires. This changes the hard-coded expiration dates to a date\nguaranteed to be in the future.\n\nChange-Id: Ia0aa5b02483af76d198f09061e6073f538bba8e4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/2872768\nAuto-Submit: Lily Chen \u003cchlily@chromium.org\u003e\nReviewed-by: Aaron Tagliaboschi \u003caarontag@chromium.org\u003e\nCommit-Queue: Lily Chen \u003cchlily@chromium.org\u003e\nCr-Commit-Position: refs/heads/master@{#879417}\n\n--\n\nwpt-commits: bae534da5146c3504805c49d0c55b61c8f96ffbd\nwpt-pr: 28829", "files": ["testing/web-platform/tests/content-security-policy/reporting/support/set-cookie.py", "testing/web-platform/tests/cookies/resources/set-cookie.py"], "git_node": null, "git_parents": [null], "node": "396271cc5d3a4b6d919b405a63ffbb2e5d698bc3", "parents": ["15e82a89470983d8c7d2ecd0eb846451a15b09ff"], "tags": []}], "date": 1623367409, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "274": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1709500 - add missing closing parenthesis. a=test-only", "files": ["testing/web-platform/tests/content-security-policy/reporting/support/set-cookie.py"], "git_node": null, "git_parents": [null], "node": "4dbef6ad9a5b2a0c2ba55920627217dc943d794d", "parents": ["396271cc5d3a4b6d919b405a63ffbb2e5d698bc3"], "tags": []}], "date": 1623368382, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "275": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc"