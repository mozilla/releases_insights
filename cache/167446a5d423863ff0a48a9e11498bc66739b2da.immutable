0710", "parents": ["786569db2210283c32ddaaea0b99c9a728ce0813"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1711576 - Ensure we set the primary frame for native anon content where needed. r=dholbert, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115527", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": null, "git_parents": [null], "node": "80857d17b37d29c97f7bfb027b910e639eef1b3f", "parents": ["edc3493e52efd66e723bdf351e36c57158190710"], "tags": []}, {"author": "Alexis Beingessner \u003ca.beingessner@gmail.com\u003e", "branch": "default", "desc": "Bug 1681950 - properly serialize the PreferencesWriter's operations. r=KrisWright, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D99474", "files": ["modules/libpref/Preferences.cpp"], "git_node": null, "git_parents": [null], "node": "9d6f6a2c2117c4e748faccad78e04fc4c23557b9", "parents": ["80857d17b37d29c97f7bfb027b910e639eef1b3f"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1709976 - Remove selection listeners from shutting down PresShell. r=Jamie, a=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115839", "files": ["accessible/base/SelectionManager.cpp"], "git_node": null, "git_parents": [null], "node": "1c6290c3e4e15bc6477e59d3bffe41e3923f80a4", "parents": ["9d6f6a2c2117c4e748faccad78e04fc4c23557b9"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 1713393 - Remove version number from `DisplayName` in Firefox uninstall data on Windows. r=agashlin, a=RyanVM\n\nThe goal is to make it easier for admins to have a generic way to\nlocate Firefox for uninstall, without needing to know the target\nversion to uninstall.  The version in the `DisplayName` is extraneous:\nit's in the `DisplayVersion` field, and users can see it when you\nclick on it in \"Add/Remove Programs\".  Automated consumers may prefer\nto read the `Comments` field of the Firefox uninstall data instead,\nwhich remains identical to the `DisplayName` before this change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D116648", "files": ["browser/installer/windows/nsis/shared.nsh"], "git_node": null, "git_parents": [null], "node": "5168d5e45d327edff35eef73a58907b24e0ec9f8", "parents": ["1c6290c3e4e15bc6477e59d3bffe41e3923f80a4"], "tags": []}], "date": 1623350145, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "271": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1702154 - Stop URL popup from overlapping policy links. r=emalysz, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D112833", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.css"], "git_node": null, "git_parents": [null], "node": "1a31f0145c384eb57b66946519928cdf8e95faa3", "parents": ["5168d5e45d327edff35eef73a58907b24e0ec9f8"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1706119 - Add enterprise policy for open-protocol-handler permission. r=emalysz, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_permissions.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "a8c4670b6ef144a0f3b6851c2a9d4bbd44fc032a", "parents": ["1a31f0145c384eb57b66946519928cdf8e95faa3"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1710749 - If a website is blocked via policy, block about:reader. r=emalysz, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D115066", "files": ["browser/component