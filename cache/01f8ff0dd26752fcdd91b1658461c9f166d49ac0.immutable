.js", "netwerk/test/browser/browser_103_assets.js"], "git_node": "f918eee082baf2f908427340caed7393d243a672", "git_parents": ["c86f1c3836cc4bf4cc9b309937030aed1b83e31d"], "node": "bc1a80a2c75ccbc078a7af2cc9835ba2cc00426e", "parents": ["33365da8ea7828032f2d8d698b4473e35aff434e"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 4: Use HTTPS in the navigation-cache-related WebExtensions tests. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334427\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_dnr_cache.js", "toolkit/components/extensions/test/xpcshell/text_ext_webRequest_js_cache.js"], "git_node": "0651d5a274be5e8d0a69be2d1715c3b691884740", "git_parents": ["f918eee082baf2f908427340caed7393d243a672"], "node": "abf3e60ccfd166f8008cbaf66cc0913bdabbe787", "parents": ["bc1a80a2c75ccbc078a7af2cc9835ba2cc00426e"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 5: Use the navigation cache only for HTTPS. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334428\n", "files": ["dom/script/ScriptLoader.cpp"], "git_node": "9c64cd18a0a60b3d49f872f5d12128dede36aa67", "git_parents": ["0651d5a274be5e8d0a69be2d1715c3b691884740"], "node": "56417e46516515245183b30b4dd6b0ede5662cc4", "parents": ["abf3e60ccfd166f8008cbaf66cc0913bdabbe787"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 6: Add testcasw with HTTP. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334429\n", "files": ["dom/base/test/browser_script_loader_js_cache_basic.js", "dom/base/test/head.js"], "git_node": "62c6b6455b70afcc45394bf9f97ee8285e722a6e", "git_parents": ["9c64cd18a0a60b3d49f872f5d12128dede36aa67"], "node": "7af37c0c23ffc77f2d9c51b5cd65cc0d62507dec", "parents": ["56417e46516515245183b30b4dd6b0ede5662cc4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087586 - Land more tests for UA important vs. transition cascade order. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338368\n", "files": ["testing/web-platform/tests/css/css-transitions/ua-important-001.tentative.html", "testing/web-platform/tests/css/css-transitions/ua-important-002.tentative.html", "testing/web-platform/tests/css/css-transitions/ua-important-003.tentative.html", "testing/web-platform/tests/css/css-transitions/ua-important.tentative.html"], "git_node": "e4341b81afcb3e158a969502350c755648ac18a4", "git_parents": ["62c6b6455b70afcc45394bf9f97ee8285e722a6e"], "node": "43440ef806f623d3c7d5b9533c003cacf8419603", "parents": ["7af37c0c23ffc77f2d9c51b5cd65cc0d62507dec"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2084080 - retain newline characters across text chunks r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336488\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/content/TextChunker.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/content/TextChunkerTest.kt"], "git_node": "db555c46f9368797996d3a5f6c6edba90ad26b69", "git_parents": ["e4341b81afcb3e158a969502350c755648ac18a4"], "node": "25b1ef8b38386e957b47ef6c5fc55bb3df11c242", "parents": ["43440ef806f623d3c7d5b9533c003cacf8419603"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2084087 - cache chunk reading speed estimations r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336489\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ArticleMeasurements.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ProgressMapper.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ArticleMeasurementsTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ProgressMapperTest.kt"], "git_node": "5fb2051abc49fc281264168ca9a04f3e2646b24d", "git_parents": ["db555c46f9368797996d3a5f6c6edba90ad26b69"], "node": "d09600eecb9c59f3d2064cd95d54202b59a6e4f1", "parents": ["25b1ef8b38386e957b47ef6c5fc55bb3df11c242"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053164 - Part 1: Add a test-only pref to use the test_block and test_annotate engines in place of the trackers engine. r=emz\n\nThis patch changes ContentClassifierService to apply\nprivacy.trackingprotection.content.testing.use_test_trackers_engines when it\nreads the engines prefs: wherever the trackers engine is listed, test_block\nis used for blocking and test_annotate for annotation, and test_block\nfollows the trackers scoped pref. Whatever writes the engines prefs still\ndecides when they are active, and test fixtures can give tracking\nprotection and tracking annotation separate lists, as url-classifier's\ntables do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333582\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/ContentClassifierService.h", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_test_trackers_engines.js"], "git_node": "9513a07e0560d845b9875fe968a21ee30de2781b", "git_parents": ["5fb2051abc49fc281264168ca9a04f3e2646b24d"], "node": "3522517793f4bd2572c0f0388aa24d6c84b08b63", "parents": ["d09600eecb9c59f3d2064cd95d54202b59a6e4f1"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053164 - Part 2: Publish equivalent content classifier lists from UrlClassifierTestUtils.addTestTrackers(). r=emz,dimi\n\nOnce the content classifier is the engine consulted for channel\nclassification, the Safe Browsing tables addTestTrackers() installs are no\nlonger read, so the existing tracker-blocking assertions across the tree\nwould all fail. Publish matching content classifier lists alongside them,\ngated on disable_for_channel_classifier so this stays inert until that pref\nflips.\n\nHosts in url-classifier's tracking table and tracking annotation table are\npublished as the test_block and test_annotate lists, served as data: URLs,\nand the service is told to use those engines in place of the trackers\nengine. That keeps hosts the classic fixture annotates but never blocks off\nthe blocking list. The other features get Remote Settings lists.\n\nThe fixture also stands in for url-classifier's other test hooks:\naddTestHostsFromPrefs() publishes the hosts a test set through the\nurlclassifier.features.*.blacklistHosts and tracking table testEntries\nprefs, addBuiltInTestTrackers() the entries url-classifier's tracking tables\ncarry built in, and hosts matching each skip URL pref become exception rules\non the matching list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333583\n", "files": ["toolkit/components/content-classifier/moz.build", "toolkit/components/content-classifier/test/ContentClassifierTestUtils.sys.mjs", "toolkit/components/content-classifier/test/browser/head.js", "toolkit/components/url-classifier/tests/UrlClassifierTestUtils.sys.mjs"], "git_node": "9a38f16bea12023f37e60f049c904d993df6bc30", "git_parents": ["9513a07e0560d845b9875fe968a21ee30de2781b"], "node": "d2e00b72b16f861684df257a4c32f45ec7264507", "parents": ["3522517793f4bd2572c0f0388aa24d6c84b08b63"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053164 - Part 3: Apply engines pref changes to already-built ContentClassifier engines synchronously. r=emz\n\nThis patch changes ProcessListChanges to repopulate the active engine lists\nunder the lock before it starts the rebuild, so engines that are already\nbuilt follow an engines pref change on the next classification.\n\nPreviously the lists were only refreshed once every engine rebuild's list\ndownloading had settled. A load issued right after changing prefs was\nclassified with the previous lists. Populating the already built engines\ndoesn't need the missing engines; they join when downloading and building\nfinish.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333584\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp"], "git_node": "0938b112cb49b9ebab811db1d3321eb3f0c0417a", "git_parents": ["9a38f16bea12023f37e60f049c904d993df6bc30"], "node": "17cb8bae2ca4e5d4074bacdde3cbc5b26f0b9d98", "parents": ["d2e00b72b16f861684df257a4c32f45ec7264507"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053164 - Part 4: Adapt the tracking protection tests to the ContentClassifier being the default engine on Nightly. r=dimi,webcompat-reviewers,extension-reviewers,devtools-reviewers,urlbar-reviewers,emz,daisuke,twisniewski,nchevobbe\n\nThis patch keeps url-classifier as the channel classifier, through manifest\nprefs or a pushPrefEnv, for tests of what the content classifier does not\ncover: url-classifier's own test directories, consent manager and anti-fraud\nannotation, email tracking data collection, the entity list, the\nharmful-addon feature and the url-classifier-exceptions collection.\n\nThe other tests run on the content classifier. Those that seed trackers\nthrough url-classifier's host prefs or rely on its built-in table entries\npublish the same hosts through the shared fixture, and their cleanup now\nawaits the fixture so the engines are gone before the next test file.\nbrowser_scopedTrackingProtection.js also sets the content classifier scoped\nprefs for the trackers and test_block engines, and reloads between its two\nloads so the first load's blocking event cannot satisfy the second check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333585\n", "files": ["browser/base/content/test/browser-protectionsUI/browser_protectionsUI.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_cryptominers.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_fetch.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_fingerprinters.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_socialtracking.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_state_reset.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_subview_shim.js", "browser/components/reportbrokensite/test/browser/browser_a11y.js", "browser/components/reportbrokensite/test/browser/browser_report_preview.js", "browser/components/reportbrokensite/test/browser/browser_tab_key_order.js", "browser/components/reportbrokensite/test/browser/browser_url_widgets.js", "browser/components/reportbrokensite/test/browser/head.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_privacy_metrics_alignment.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_telemetry.js", "browser/extensions/webcompat/tests/browser/head.js", "devtools/client/anti-tracking/test/browser/browser_anti_tracking_panel.js", "devtools/client/webconsole/test/browser/head.js", "toolkit/components/antitracking/test/browser/browser_allowListPreference.js", "toolkit/components/antitracking/test/browser/browser_emailtracking.js", "toolkit/components/antitracking/test/browser/browser_noStorageAccessAutoGrant_thirdPartyTracker.js", "toolkit/components/antitracking/test/browser/browser_scopedTrackingProtection.js", "toolkit/components/antitracking/test/browser/browser_siteSpecificWorkAroundsComplex.js", "toolkit/components/antitracking/test/browser/browser_socialtracking_save_image.js", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_urlclassifier_disable_for_channel_classifier.js", "toolkit/components/extensions/test/browser/browser_ext_urlclassifier.js", "toolkit/components/extensions/test/xpcshell/xpcshell.toml", "toolkit/components/processtools/tests/browser/browser_test_powerMetrics.js", "toolkit/components/url-classifier/tests/browser/browser.toml", "toolkit/components/url-classifier/tests/mochitest/chrome.toml", "toolkit/components/url-classifier/tests/mochitest/mochitest.toml", "toolkit/components/url-classifier/tests/unit/xpcshell.toml"], "git_node": "e11b176c0a1c3e9cf90075b0c762ac2989053623", "git_parents": ["0938b112cb49b9ebab811db1d3321eb3f0c0417a"], "node": "75358aa5582661ced78168a979b0aeceb29818e9", "parents": ["17cb8bae2ca4e5d4074bacdde3cbc5b26f0b9d98"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053164 - Part 5: Enable the ContentClassifier as the tracking protection engine on desktop Nightly. r=emz\n\nThis patch changes the default of privacy.trackingprotection.content.mirror.mode\nto 1 and privacy.trackingprotection.urlclassifier.disable_for_channel_classifier\nto true on desktop Nightly. ContentClassifierPrefMirror then drives the content\nclassifier from the ETP prefs, and url-classifier stops running its tracking\nprotection features on channels. Safe Browsing stays on url-classifier.\n\nUntil the content classifier gains equivalents, Nightly loses consent manager\nand anti-fraud annotation, email tracking data collection and the entity list.\nNo tracker is blocked until the first engine build finishes, which on a new\nprofile means until the first Remote Settings sync.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333586\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/content-classifier/ContentClassifierPrefMirror.h"], "git_node": "503c797ed906779f12a2258ea2f28c94aac886f0", "git_parents": ["e11b176c0a1c3e9cf90075b0c762ac2989053623"], "node": "c9a8bf04e6c2227214949a4740067f6dad71433f", "parents": ["75358aa5582661ced78168a979b0aeceb29818e9"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087427 - Allow extensions with the clipboardRead permission to read cross-origin web custom formats. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338319\n", "files": ["dom/events/test/clipboard/browser_navigator_clipboard_read_custom_format_origin.js", "modules/libpref/init/StaticPrefList.yaml", "widget/nsBaseClipboard.cpp"], "git_node": "7c8d11f7d7b9519618233cfdbe8918434a3b50c1", "git_parents": ["503c797ed906779f12a2258ea2f28c94aac886f0"], "node": "8b1136bf9b8cfd34f7bf417d156402a27f215729", "parents": ["c9a8bf04e6c2227214949a4740067f6dad71433f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2087984 - Use Maybe\u003cnsID\u003e/nsIDRef for operationID r=baku,cookie-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288359\n", "files": ["dom/cookiestore/CookieStoreNotificationWatcher.cpp", "dom/cookiestore/CookieStoreNotificationWatcher.h", "dom/ipc/ContentParent.cpp", "netwerk/cookie/CookieNotification.cpp", "netwerk/cookie/CookieNotification.h", "netwerk/cookie/CookiePersistentStorage.cpp", "netwerk/cookie/CookieService.cpp", "netwerk/cookie/CookieService.h", "netwerk/cookie/CookieServiceChild.cpp", "netwerk/cookie/CookieServiceParent.cpp", "netwerk/cookie/CookieServiceParent.h", "netwerk/cookie/CookieStorage.cpp", "netwerk/cookie/CookieStorage.h", "netwerk/cookie/nsICookieNotification.idl", "netwerk/test/gtest/TestCookie.cpp"], "git_node": "d2db7e0c85cdd412e882a1b2db9bc3473191a9e7", "git_parents": ["7c8d11f7d7b9519618233cfdbe8918434a3b50c1"], "node": "98b87ee3682fc23d2bbac3fe13b8d4046d683da8", "parents": ["8b1136bf9b8cfd34f7bf417d156402a27f215729"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2087816 - Shift instead of multiplying by the megamorphic set cache entry size. r=jandem\n\nemitMegamorphicCachedSetSlot scales the hashed cache index by\nsizeof(MegamorphicSetPropCache::Entry) with mul32, which arm64 emits as a\nconstant move and a multiply and x86 as an imul, on the address chain of\nevery megamorphic property set. The entry is 32 bytes on 64-bit platforms,\nso shift when the size is a power of two.\n\narm64:\n\n  and   w11, w11, #0x3ff\n  mov   w16, #0x20\n  mul   w11, w11, w16\n  add   x11, x10, x11\n\nbecomes\n\n  and   w11, w11, #0x3ff\n  lsl   w11, w11, #5\n  add   x11, x10, x11\n\nx86-64:\n\n  andl  $0x3ff, %ebx\n  imull $32, %ebx, %ebx\n  leaq  0x0(%rdi,%rbx,1), %rbx\n\nbecomes\n\n  andl  $0x3ff, %ebx\n  shll  $5, %ebx\n  leaq  0x0(%rdi,%rbx,1), %rbx\n\nOn a JetStream 3 run on arm64 this removes the multiply from all 866\nmegamorphic set sites in Ion code.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338553\n", "files": ["js/src/jit/MacroAssembler.cpp"], "git_node": "466757182d79f06e093d7ab58a6b9eab3a3f4f55", "git_parents": ["d2db7e0c85cdd412e882a1b2db9bc3473191a9e7"], "node": "f7fe18fdd3d0517a4bf590208adee5e2b68c4ac1", "parents": ["98b87ee3682fc23d2bbac3fe13b8d4046d683da8"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084600 - Introduce PolicyContainer::CreateForNonDocument. r=emilio,necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336006\n", "files": ["dom/security/PolicyContainer.cpp", "dom/security/PolicyContainer.h", "netwerk/protocol/http/EarlyHintPreloader.cpp"], "git_node": "720314b16b3339b36ede20f8f4a4da3c38eda3d7", "git_parents": ["466757182d79f06e093d7ab58a6b9eab3a3f4f55"], "node": "cbf999fd79800e652c1e73feb8ee660b4aa076bd", "parents": ["f7fe18fdd3d0517a4bf590208adee5e2b68c4ac1"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084600 - Support Connection Allowlist in PolicyContainer::CreateForNonDocument. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336007\n", "files": ["dom/security/PolicyContainer.cpp", "dom/security/PolicyContainer.h"], "git_node": "2251e96bc111a779bf51d7d5c40396c48355b7a4", "git_parents": ["720314b16b3339b36ede20f8f4a4da3c38eda3d7"], "node": "7770af91623f0d0f4eefe64a3ceca12c74de75b0", "parents": ["cbf999fd79800e652c1e73feb8ee660b4aa076bd"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084600 - Block Early Hints with the Connection Allowlist. r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336008\n", "files": ["netwerk/ipc/DocumentLoadListener.cpp", "netwerk/protocol/http/EarlyHintPreloader.cpp", "netwerk/protocol/http/EarlyHintPreloader.h", "netwerk/protocol/http/EarlyHintsService.cpp", "netwerk/protocol/http/EarlyHintsService.h", "netwerk/protocol/http/nsHttpAtomList.inc", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsIEarlyHintObserver.idl"], "git_node": "cdd7770a7a08747c5d67a34cc3d62c1177b45c26", "git_parents": ["2251e96bc111a779bf51d7d5c40396c48355b7a4"], "node": "eab76549aa9075fc745d74658ed5f11f4b858f53", "parents": ["7770af91623f0d0f4eefe64a3ceca12c74de75b0"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078278 - Support [Tainted] annotations on individual C++ types (in parameters). r=nika,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330789\n", "files": ["ipc/docs/ipdl.md", "ipc/glue/TaintingIPCUtils.h", "ipc/ipdl/ipdl/ast.py", "ipc/ipdl/ipdl/lower.py", "ipc/ipdl/ipdl/type.py", "ipc/ipdl/test/ipdl/error/PNoTaintWithoutTainted.ipdl", "ipc/ipdl/test/ipdl/error/PTaintedTypeInconsistent.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedType.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedTypeAnyAny.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedTypeInProcess.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedTypeReversed.ipdl"], "git_node": "36ee783d0f3f797b808d6c7b4658b6c623c1567e", "git_parents": ["cdd7770a7a08747c5d67a34cc3d62c1177b45c26"], "node": "aca3c357510de8e7490f2359d75969098393002a", "parents": ["eab76549aa9075fc745d74658ed5f11f4b858f53"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078278 - Check which actor side gets Tainted\u003c\u003e in IPDL ok tests. r=nika,ipc-reviewers\n\nOk tests previously only checked that compilation succeeded, so they could\nnot tell whether [Tainted] types ended up tainted on the right side.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335530\n", "files": ["ipc/ipdl/test/ipdl/IPDLCompile.py", "ipc/ipdl/test/ipdl/ok/PTaintedType.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedTypeAnyAny.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedTypeInProcess.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedTypeReversed.ipdl", "ipc/ipdl/test/ipdl/runtests.py"], "git_node": "cc2456c75dee286fcb4e659abeb84e70d805d397", "git_parents": ["36ee783d0f3f797b808d6c7b4658b6c623c1567e"], "node": "cdeb0e67cb5ffa84fde556594ba3ba943086d31f", "parents": ["aca3c357510de8e7490f2359d75969098393002a"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087906 - Remove nsRefresDriver::UpdateThrottledState declaration. r=layout-reviewers,emilio\n\nThe implementation has been removed since bug 1847929.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338618\n", "files": ["layout/base/nsRefreshDriver.h"], "git_node": "a4fec3d4212b26a423639d23e46329068067a0b6", "git_parents": ["cc2456c75dee286fcb4e659abeb84e70d805d397"], "node": "cb29814afbd5898ae103e5110f783d8c695504c6", "parents": ["cdeb0e67cb5ffa84fde556594ba3ba943086d31f"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072077 - Part 6: Add testcasw with HTTP. r=bthrall\" for causing eslint failures.\n\nThis reverts commit 62c6b6455b70afcc45394bf9f97ee8285e722a6e.\n\nThis reverts commit 9c64cd18a0a60b3d49f872f5d12128dede36aa67.\n\nThis reverts commit 0651d5a274be5e8d0a69be2d1715c3b691884740.\n\nThis reverts commit f918eee082baf2f908427340caed7393d243a672.\n\nThis reverts commit c86f1c3836cc4bf4cc9b309937030aed1b83e31d.\n", "files": ["dom/base/test/browser_script_loader_js_cache_basic.js", "dom/base/test/browser_script_loader_js_cache_module_preload.js", "dom/base/test/head.js", "dom/base/test/jsmodules/importmaps/mochitest.toml", "dom/base/test/jsmodules/mochitest.toml", "dom/script/ScriptLoader.cpp", "netwerk/test/browser/browser_103_assets.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_cache.js", "toolkit/components/extensions/test/xpcshell/text_ext_webRequest_js_cache.js"], "git_node": "1d81eac9e943c606bdb005c9bfabe0196dacb524", "git_parents": ["a4fec3d4212b26a423639d23e46329068067a0b6"], "node": "04d211d3da16fa3f9f9d99b86951f7592a543fc3", "parents": ["cb29814afbd5898ae103e5110f783d8c695504c6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084585 - Update firefox-source-docs to Mermaid 12. r=firefox-source-docs-reviewers,ai4dev-reviewers,padenot,sylvestre,ahal\n\nThe config pins aim to keep every diagram as it renders today: rendered with both versions, 96 of the tree's 98 non-ZenUML diagrams stay within 5% of their current size, and the other two differ by about 6%. This depends on bug 2084536, without which the streams diagram does not parse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335969\n", "files": [".agents/skills/documentation/references/mermaid.md", ".claude/skills/documentation/references/mermaid.md", "docs/_static/custom_theme.css", "docs/conf.py", "tools/moztreedocs/docs/mermaid-integration.md"], "git_node": "2b5017a6047e279817347f93bebd5f30064554e7", "git_parents": ["1d81eac9e943c606bdb005c9bfabe0196dacb524"], "node": "36508b70610728f610eebf8199c134795fbd9724", "parents": ["04d211d3da16fa3f9f9d99b86951f7592a543fc3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084298 - Scale wide Mermaid diagrams to the page width when printing the source docs. r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335718\n", "files": ["docs/_static/custom_theme.css"], "git_node": "f10b237383a5be2f3d770350dc3708508483e06d", "git_parents": ["2b5017a6047e279817347f93bebd5f30064554e7"], "node": "a4747cfb5f6a921b280b9a8000f7a9f38e749252", "parents": ["36508b70610728f610eebf8199c134795fbd9724"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2088008. Space out the touch events in synthesizeNativeTouchForFastFling on Android. r=hiro\n\nOn Android the touch event timestamps have millisecond resolution, and\nAndroidVelocityTracker merges samples that are less than 1ms apart. We were\nsending the touch events back to back, so sometimes the last two moves of\nthe fling got the same timestamp. If the gap before them was also over 40ms\n(e.g. a slow promiseApzFlushedRepaints in\nhelper_event_during_fast_fling.html), the tracker was left with a single\nsample, computed no velocity, and no fling happened.\n\nWait 5ms between events on Android so each event gets its own sample.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338672\n", "files": ["gfx/layers/apz/test/mochitest/apz_test_native_event_utils.js"], "git_node": "b80256aa4d14ebd40abae460a92511510fe055ce", "git_parents": ["f10b237383a5be2f3d770350dc3708508483e06d"], "node": "054d67de72287dff548e68da9cfbf6cdbfa753cc", "parents": ["a4747cfb5f6a921b280b9a8000f7a9f38e749252"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087984 - Use Maybe\u003cnsID\u003e/nsIDRef for operationID r=baku,cookie-reviewers\" for causing build bustages in ContentParent.cpp.\n\nThis reverts commit d2db7e0c85cdd412e882a1b2db9bc3473191a9e7.\n", "files": ["dom/cookiestore/CookieStoreNotificationWatcher.cpp", "dom/cookiestore/CookieStoreNotificationWatcher.h", "dom/ipc/ContentParent.cpp", "netwerk/cookie/CookieNotification.cpp", "netwerk/cookie/CookieNotification.h", "netwerk/cookie/CookiePersistentStorage.cpp", "netwerk/cookie/CookieService.cpp", "netwerk/cookie/CookieService.h", "netwerk/cookie/CookieServiceChild.cpp", "netwerk/cookie/CookieServiceParent.cpp", "netwerk/cookie/CookieServiceParent.h", "netwerk/cookie/CookieStorage.cpp", "netwerk/cookie/CookieStorage.h", "netwerk/cookie/nsICookieNotification.idl", "netwerk/test/gtest/TestCookie.cpp"], "git_node": "3590d2d66918dcb88c2a97a20a0269dd789893e2", "git_parents": ["b80256aa4d14ebd40abae460a92511510fe055ce"], "node": "6cb44afca6f370880240309fb3b98cd90116f312", "parents": ["054d67de72287dff548e68da9cfbf6cdbfa753cc"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2085497 - Share equal constant pool entries on arm64. r=jandem\n\nPool::insertEntry appends a new entry for every literal load, so a pool\nholds one copy of a shape pointer or boxed Value per use. Keep a hash of\nthe shareable entries in the pending pool and point a load of an equal\nvalue at the existing entry.\n\nA PoolEntryKind on allocEntry says what may share. Loads that are\npatched in place afterwards (movWithPatch, CodeLabel and\nwasm::SymbolicAddress placeholders) stay Unshared. GC pointers and boxed\nValues share only among themselves, because TraceDataRelocations rewrites\nthem; doubles, floats, SIMD constants and JitCode call targets share as\nplain constants. The limiter and the pool size check keep treating a\nshared load as a new entry, which is conservative.\n\nOn JetStream 3, 121,954 of 634,117 Ion literal loads and 151,812 of\n775,246 Baseline literal loads now reuse an entry. Pool bytes fall from\n3.76 MB to 3.01 MB in Ion code and from 6.08 MB to 4.85 MB in Baseline\ncode.\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336932\n", "files": ["js/src/jit/arm64/Assembler-arm64.cpp", "js/src/jit/arm64/Assembler-arm64.h", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/arm64/vixl/MozBaseAssembler-vixl.h", "js/src/jit/shared/IonAssemblerBufferWithConstantPools.h", "js/src/jsapi-tests/testAssemblerBuffer.cpp"], "git_node": "71e70f67c7f11a992335d978d9db84ba7a1e2a20", "git_parents": ["3590d2d66918dcb88c2a97a20a0269dd789893e2"], "node": "d033d7cce0c3ba0a1a0d9aefa48cf578e15b72e9", "parents": ["6cb44afca6f370880240309fb3b98cd90116f312"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087982 - [devtools] Update devtools backward monitor links to point to firefox-devtools.github.io r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338656\n", "files": ["devtools/docs/contributor/release.md", "devtools/docs/contributor/tests/backward-compat-tests.md"], "git_node": "c2b578498c847d991bbeaa981ebbc492c87a0b35", "git_parents": ["71e70f67c7f11a992335d978d9db84ba7a1e2a20"], "node": "f7ba9c332c1b9abb8e160d3a35a5dc0c0cd478ba", "parents": ["d033d7cce0c3ba0a1a0d9aefa48cf578e15b72e9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084613 - Lay out firefox-source-docs Mermaid diagrams with ELK. r=firefox-source-docs-reviewers,ai4dev-reviewers,ahal,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335988\n", "files": [".agents/skills/documentation/references/mermaid.md", ".claude/skills/documentation/references/mermaid.md", "browser/components/urlbar/docs/lifetime.md", "docs/conf.py", "dom/docs/push/index.md", "toolkit/components/ipprotection/docs/Components.md"], "git_node": "7fd73ef2ddcd11eed0d4bf5ba529dfc591e3438f", "git_parents": ["c2b578498c847d991bbeaa981ebbc492c87a0b35"], "node": "72d6b4e21c72cc3cb737554c522973be74c30057", "parents": ["f7ba9c332c1b9abb8e160d3a35a5dc0c0cd478ba"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084689 - Draw firefox-source-docs Mermaid diagrams in Mermaid's default neo look. r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336044\n", "files": ["docs/conf.py", "tools/moztreedocs/docs/mermaid-integration.md"], "git_node": "d27849e491d4c7e166cf84baa9c70c56d47d279e", "git_parents": ["7fd73ef2ddcd11eed0d4bf5ba529dfc591e3438f"], "node": "93a539f31cbcd093b8cd8cbcb12c2459e21c5aeb", "parents": ["72d6b4e21c72cc3cb737554c522973be74c30057"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2087818 - Branch on the string length with cbz/cbnz in arm64 truthiness tests. r=jandem\n\nOn arm64, branchTestStringTruthy loads the string length and compares it\nagainst zero before a conditional branch. Branch on the loaded length with\ncbz/cbnz through branchTest32 instead, which saves the compare:\n\n  ldr   w16, [x16, #4]\n  cmp   w16, #0\n  b.eq  \u003cfalsy\u003e\n\nbecomes\n\n  ldr   w16, [x16, #4]\n  cbz   w16, \u003cfalsy\u003e\n\nbranchTestBigIntTruthy tests the digit length the same way and gets the same\ntreatment. The Condition-returning testStringTruthy and testBigIntTruthy\nhelpers have no other users, so they are removed.\n\nOn a JetStream 3 run on arm64 this removes the compare from all 17,817\nstring truthiness tests in Ion code.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338554\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "168b6714b66974d8ea1d9698a2ca175738885a1e", "git_parents": ["d27849e491d4c7e166cf84baa9c70c56d47d279e"], "node": "811e885edb7522ccd83a3aae02b9a59db1665cb0", "parents": ["93a539f31cbcd093b8cd8cbcb12c2459e21c5aeb"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2087903 - Use moz-src for netwerk r=cookie-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338619\n", "files": ["netwerk/cookie/components.conf", "netwerk/cookie/moz.build", "netwerk/url-classifier/components.conf", "netwerk/url-classifier/moz.build", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "61ec447d74c3529ef3da63f3b85b83e531f36719", "git_parents": ["168b6714b66974d8ea1d9698a2ca175738885a1e"], "node": "e5a55916acf9303cf236df952cafc0fc47725f38", "parents": ["811e885edb7522ccd83a3aae02b9a59db1665cb0"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076692 - Percent-decode No-Vary-Search header keys before matching query params. r=sunil,necko-reviewers,jesup\n\nQuery names were decoded but header keys weren't, so encoded keys like \"%C2%A2\" never matched (draft section 5.3).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336793\n", "files": ["netwerk/base/NoVarySearchUtils.cpp", "netwerk/test/gtest/TestNoVarySearchUtils.cpp", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single.https.html.ini"], "git_node": "c64a2ed5bf570d28cf8656fc530def85312cf6bd", "git_parents": ["61ec447d74c3529ef3da63f3b85b83e531f36719"], "node": "2a95bcbbd5f6b4174e323f00cec87c657bf87120", "parents": ["e5a55916acf9303cf236df952cafc0fc47725f38"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 1: Use https in the importmap test with the navigation cache. r=allstarschh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334424\n", "files": ["dom/base/test/jsmodules/importmaps/mochitest.toml", "dom/base/test/jsmodules/mochitest.toml"], "git_node": "d5b0eec7ea43ea73f33949d5b112cc8041cfdb8d", "git_parents": ["c64a2ed5bf570d28cf8656fc530def85312cf6bd"], "node": "90e7265d46d78cb7545c9449d93007bf331eeae8", "parents": ["2a95bcbbd5f6b4174e323f00cec87c657bf87120"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 3: Use HTTPS in the navigation-cache-related tests. r=bthrall,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334426\n", "files": ["dom/base/test/browser_script_loader_js_cache_module_preload.js", "dom/base/test/head.js", "netwerk/test/browser/browser_103_assets.js"], "git_node": "c1da6e60af1d10e4e8b3e1099e7e0a00352b11a0", "git_parents": ["d5b0eec7ea43ea73f33949d5b112cc8041cfdb8d"], "node": "953001c157124e1718b3a40cc2c27561dc1821a5", "parents": ["90e7265d46d78cb7545c9449d93007bf331eeae8"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 4: Use HTTPS in the navigation-cache-related WebExtensions tests. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334427\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_dnr_cache.js", "toolkit/components/extensions/test/xpcshell/text_ext_webRequest_js_cache.js"], "git_node": "d24fd2c3202845bcd4788756b5ba62db666bf509", "git_parents": ["c1da6e60af1d10e4e8b3e1099e7e0a00352b11a0"], "node": "d6a2bbc38d2fc6627a6785264e2f0286ee97d80d", "parents": ["953001c157124e1718b3a40cc2c27561dc1821a5"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 5: Use the navigation cache only for HTTPS. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334428\n", "files": ["dom/script/ScriptLoader.cpp"], "git_node": "60ad07f9cb84ffeacc9cb4d80ab6834d8031752b", "git_parents": ["d24fd2c3202845bcd4788756b5ba62db666bf509"], "node": "69ebcd49a6296d1b662f9ee56ee7eb92780580d4", "parents": ["d6a2bbc38d2fc6627a6785264e2f0286ee97d80d"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 6: Add testcasw with HTTP. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334429\n", "files": ["dom/base/test/browser_script_loader_js_cache_basic.js", "dom/base/test/head.js"], "git_node": "52f445527b23ff2323ffee61ceb0dd25fe8ea709", "git_parents": ["60ad07f9cb84ffeacc9cb4d80ab6834d8031752b"], "node": "0e83ff23933c14aad043fc4809d36a32db59d423", "parents": ["69ebcd49a6296d1b662f9ee56ee7eb92780580d4"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068966 - Add \"Sync this device\" toggle to Account Settings screen. r=android-reviewers,android-l10n-reviewers,parker,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338001\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsFragment.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/account_settings_preferences.xml"], "git_node": "025126f38cf03cecaf94b84929e493aba3773320", "git_parents": ["52f445527b23ff2323ffee61ceb0dd25fe8ea709"], "node": "ec8f22c1611c387f8dcdf2296c5043307bf3d07f", "parents": ["0e83ff23933c14aad043fc4809d36a32db59d423"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077703 - Prevent lingering session id for searches r=android-reviewers,moyin\n\nSwitching between private and normal mode recreates HomeFragment from its\noriginal navigation arguments, so the search kept targeting the private tab.\nThe awesomebar also only refreshed the current tab details when the query\nswitched between empty and non-empty, so they could stay outdated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335921\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/AwesomeBarComposable.kt"], "git_node": "8a730f2d81a5d263c5d4e2c6a331ff2ebdb6fe01", "git_parents": ["025126f38cf03cecaf94b84929e493aba3773320"], "node": "bd316003f0504e00018675774871c5c30dc23dd8", "parents": ["ec8f22c1611c387f8dcdf2296c5043307bf3d07f"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086661 - remove duration on listenSheet only r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338452\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetTest.kt"], "git_node": "1997eee4b05cef2952384c31bcab6fbf80eaa85e", "git_parents": ["8a730f2d81a5d263c5d4e2c6a331ff2ebdb6fe01"], "node": "c48a98ca0000c4817d5d21363198bec5f79c972e", "parents": ["bd316003f0504e00018675774871c5c30dc23dd8"], "tags": []}, {"author": "Smagin Ivan \u003csmag.vav@gmail.com\u003e", "branch": "default", "desc": "Bug 1820474 - Add WPT for mixed-content auto-upgrading not applying to track elements. r=freddyb\n\nAdds a web-platform test verifying that \u003ctrack\u003e elements are not\nupgraded from HTTP to HTTPS by mixed-content auto-upgrading, as the\nspecification restricts auto-upgrade to image, audio, and video only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322104\n", "files": ["testing/web-platform/tests/mixed-content/tentative/autoupgrades/track-upgrade.https.sub.html", "testing/web-platform/tests/mixed-content/tentative/resources/test.vtt"], "git_node": "1519f409c5febde3b19aa8d9349e35aafa0cc549", "git_parents": ["1997eee4b05cef2952384c31bcab6fbf80eaa85e"], "node": "d29ac098a5a697a72f36a3c3644935f0a74a4a74", "parents": ["c48a98ca0000c4817d5d21363198bec5f79c972e"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075618 - Enable the move tab menu when there is only 1 tab in the session to move to mini window. r=tabbrowser-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336019\n", "files": ["browser/components/miniwindow/test/browser/browser_last_tab.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_move.js"], "git_node": "e69e36c24c6d009f183f9c446f47ffff56453147", "git_parents": ["1519f409c5febde3b19aa8d9349e35aafa0cc549"], "node": "610edfc4aeef7dfea1b7a9badad0a9186a9b304f", "parents": ["d29ac098a5a697a72f36a3c3644935f0a74a4a74"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072077 - Part 1: Use https in the importmap test with the navigation cache. r=allstarschh\" for causing eslint failures.\n\nThis reverts commit d5b0eec7ea43ea73f33949d5b112cc8041cfdb8d.\n", "files": ["dom/base/test/jsmodules/importmaps/mochitest.toml", "dom/base/test/jsmodules/mochitest.toml"], "git_node": "d4e0c063c5cf81d7a38f86474dff2b1ddd7d2b82", "git_parents": ["e69e36c24c6d009f183f9c446f47ffff56453147"], "node": "af2181dabb2a9e160c9a941edbac15bf090d7db8", "parents": ["610edfc4aeef7dfea1b7a9badad0a9186a9b304f"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1820474 - Add WPT for mixed-content auto-upgrading not applying to track elements. r=freddyb\" for causing linting opt failures in track-upgrade.https.sub.html.\n\nThis reverts commit 1519f409c5febde3b19aa8d9349e35aafa0cc549.\n", "files": ["testing/web-platform/tests/mixed-content/tentative/autoupgrades/track-upgrade.https.sub.html", "testing/web-platform/tests/mixed-content/tentative/resources/test.vtt"], "git_node": "124e1ec79dac15887278dc843d8c3b300886da31", "git_parents": ["d4e0c063c5cf81d7a38f86474dff2b1ddd7d2b82"], "node": "388f6308f847e80dd926a13d56ccc7cc0c64b50c", "parents": ["af2181dabb2a9e160c9a941edbac15bf090d7db8"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2085082 - [Linux][Vulkan Video] Disable direct export on AMD with older system FFmpeg. r=stransky,media-playback-reviewers\n\nOlder system FFmpeg copies output DRM modifiers into its internal DPB\npool, which can cause video corruption on RADV at certain resolutions.\nH.264 and HEVC use system FFmpeg and are not covered by the ffvpx backport.\n\nUse the cached AMD vendor ID to block direct export when runtime\nlibavcodec is older than 63.20.101, the first upstream version bump after\nthe fix in b7e835e06913. Keep Vulkan decoding through the copy path.\nPatched ffvpx and newer system FFmpeg remain eligible for direct export.\n\nCombine this restriction with the existing NVIDIA forced-block-linear\nrestriction in a local directExportBlocked decision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338164\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "d2184195162a6543d3bc1091db72943be7772f34", "git_parents": ["124e1ec79dac15887278dc843d8c3b300886da31"], "node": "acec6691b081e672e2d4777fd57df0c54226d66c", "parents": ["388f6308f847e80dd926a13d56ccc7cc0c64b50c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084592 - Set the content-decoding flags outside mLock in nsHttpTransaction::ProcessData (Coverity CID 1703296) r=necko-reviewers,jesup\n\nmLock only protects mResponseHead from the main thread. The two\ncontent-decoding flags are socket-thread only, so read the header under\nthe lock and set them after releasing it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335995\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "6c8dfa3d56bb60833ab0e44c6083e104cd5e4e7d", "git_parents": ["d2184195162a6543d3bc1091db72943be7772f34"], "node": "f40a2bd5f3af7ee1f5e48b5826c196d159b07156", "parents": ["acec6691b081e672e2d4777fd57df0c54226d66c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075124 - update the content of about:license r=overholt DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328746\n", "files": ["browser/base/content/overrides/app-license.html"], "git_node": "2f9129cc937bf98fc995e7a033058e6dd7f87dcc", "git_parents": ["6c8dfa3d56bb60833ab0e44c6083e104cd5e4e7d"], "node": "03ac032e4b7cf3faaf70bf21b64661a38e1c7add", "parents": ["f40a2bd5f3af7ee1f5e48b5826c196d159b07156"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084081 - Render default arguments as written in the source in the Python API docs DONTBUILD\n\nSignatures with an os.environ default embedded the environment of the machine\nbuilding the docs, so the published pages listed the CI task's variables and\nchanged on every build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335884\n", "files": ["docs/conf.py"], "git_node": "4b8fa2cdb47d50e90c621fdbd76ffc09caeaa0ce", "git_parents": ["2f9129cc937bf98fc995e7a033058e6dd7f87dcc"], "node": "edab99a8db0858f55a5be2fd991ee936723915e5", "parents": ["03ac032e4b7cf3faaf70bf21b64661a38e1c7add"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2081118 - Drop the redundant mDocument null check in ScriptLoader::TryUseCache (Coverity CID 1702917) r=bthrall\n\nBuilding the ScriptHashKey earlier in the function already dereferences\nmDocument through LoaderPrincipal and PartitionedPrincipal, so it cannot\nbe null by the time the encoding is checked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333148\n", "files": ["dom/script/ScriptLoader.cpp"], "git_node": "aad2504de87ea31d1102d466fa289eb63c65f7cc", "git_parents": ["4b8fa2cdb47d50e90c621fdbd76ffc09caeaa0ce"], "node": "f1aa45157ae0a822c163c8288b49db3beb82b79f", "parents": ["edab99a8db0858f55a5be2fd991ee936723915e5"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2086852 - [Linux][Vulkan Video] Check DRM capabilities when NVIDIA modeset is unreadable. r=stransky,media-playback-reviewers\n\nOlder NVIDIA drivers expose the nvidia_drm modeset parameter with 0400\npermissions. Treating every fopen failure as disabled prevents Vulkan\nhardware decoding even when modesetting is enabled.\n\nCache the sysfs result as enabled, disabled, or unknown. On EACCES or\nEPERM, use VK_EXT_physical_device_drm to identify the candidate GPU's\nrender node and query DRM_CAP_DUMB_BUFFER. NVIDIA registers its\ndumb-buffer callback and KMS features when modesetting is enabled.\nVerify the opened node's major and minor numbers. Cache probe results\nby render-node major/minor to avoid repeated queries for the same GPU.\n\nSkip NVIDIA for explicit N/n/0, a missing parameter, other sysfs read\nfailures, or a DRM probe reporting no capability or unsupported KMS.\nIf the DRM probe is inconclusive, log the unknown status and allow\ninitialization. Preserve the missing-module guard from bug 2071303.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338011\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp"], "git_node": "f1742eaf7fc2cb83f0e3e8631acdca2210362be6", "git_parents": ["aad2504de87ea31d1102d466fa289eb63c65f7cc"], "node": "f82e410dbf8cbae5b275f8a90eb20dc4e8ab1132", "parents": ["f1aa45157ae0a822c163c8288b49db3beb82b79f"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084074 - Disable the cyclic garbage collector while building the docs r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nA CodSpeed walltime profile of a full build showed the main process spending\nmost of its own time in libpython, which gc.callbacks timing confirmed to be\ngarbage collection: about 18 s at -j 4, nearly all in full collections over\nthe growing environment and doctrees. Worker processes forked from it pay the\nsame cost.\n\nTurn the collector off once reading starts, collect once after the parallel\nreads are merged, and turn it back on when the build finishes. A clean -j 4\nbuild goes from 70 s to 51 s, with peak resident memory going from 0.84 GB to\n1.41 GB.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335888\n", "files": ["docs/conf.py"], "git_node": "a6037dfd1582638cd0bc309550013ad5afc24386", "git_parents": ["f1742eaf7fc2cb83f0e3e8631acdca2210362be6"], "node": "c4e4452193ba6417b2c0afae158b5e71171e0447", "parents": ["f82e410dbf8cbae5b275f8a90eb20dc4e8ab1132"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084074 - Freeze the long-lived objects before Sphinx forks its docs workers r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nCollect and gc.freeze() when reading and writing start, so the objects that\nalready exist stay out of later collections and their memory stays shared with\nthe forked workers. On top of disabling automatic collection this is a small\ngain: a clean -j 4 build goes from 54 s to 52 s with the same peak memory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335889\n", "files": ["docs/conf.py"], "git_node": "54e6c7c3d4de9d50f0be21e0525a0fd6e93b6980", "git_parents": ["a6037dfd1582638cd0bc309550013ad5afc24386"], "node": "3bb0ee63b578f8ae70ac3c9e9e84b00a45bd4aea", "parents": ["c4e4452193ba6417b2c0afae158b5e71171e0447"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086500 - Remove unused code under /docshell r=dom-core-reviewers,necko-reviewers,layout-reviewers,emilio,jesup,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337492\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h", "docshell/shistory/ChildSHistory.cpp", "docshell/shistory/ChildSHistory.h", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/nsISHEntry.idl", "dom/base/Element.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/ipc/ContentParent.cpp", "dom/ipc/PContent.ipdl", "layout/generic/nsImageFrame.cpp", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "fe0ac674f5cf15d9c08c44fe4103e75176dc6c24", "git_parents": ["54e6c7c3d4de9d50f0be21e0525a0fd6e93b6980"], "node": "ea55b127d616e3dafeacd6e256a906201fee9a7e", "parents": ["3bb0ee63b578f8ae70ac3c9e9e84b00a45bd4aea"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083793 - Add an AGENTS.md for wdba and update documentation. r=nrishel,ai4dev-reviewers,aborondo,suhaib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335194\n", "files": ["toolkit/mozapps/defaultagent/AGENTS.md", "toolkit/mozapps/defaultagent/CLAUDE.md", "toolkit/mozapps/defaultagent/docs/index.md"], "git_node": "3ab31b3cb445137d642a4464598612713e1d6d63", "git_parents": ["fe0ac674f5cf15d9c08c44fe4103e75176dc6c24"], "node": "b491a93f41e08553324ed9148ece413d5ece2bf0", "parents": ["ea55b127d616e3dafeacd6e256a906201fee9a7e"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2037327 - Use the pdf.js.pdfs repo for gathering pdfpaint PDFs. r=perftest-reviewers,taskgraph-reviewers,aglavic,bhearsum\n\nThis patch changes where the PDFs for the talos pdfpaint test come from. Instead of pulling them from webarchive, we pull them from the pdf.js.pdfs repo. As it's a private repo, this also makes the artifacts produced by the fetch/toolchain tasks private. This means that locally, we can no longer use bootsrapping to pull in those artifacts for the test. To get around this, an error message is added with a link to the latest artifact that a user can download the required PDFs from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333852\n", "files": ["taskcluster/gecko_taskgraph/transforms/fetch.py", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/fetch-talos-pdfs.py", "taskcluster/scripts/misc/run-fetch-talos-pdfs.sh", "testing/perfdocs/generated/talos.md", "testing/talos/mach_commands.py", "testing/talos/perfdocs/config.yml"], "git_node": "349d5b1bf05048167b17fc5f12f26ffdf484a9c9", "git_parents": ["3ab31b3cb445137d642a4464598612713e1d6d63"], "node": "29e2225f508b82df88662ad03ac8302b04667d37", "parents": ["b491a93f41e08553324ed9148ece413d5ece2bf0"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087031 - Allocate the image loading state of nsImageLoadingContent on demand. r=dom-core-reviewers,vhilla\n\nInputs that are not type=image no longer pay for the request, observer and\ndecode promise members. Teardown paths check for the state instead of\ncreating it, and the image loader lookup moves to where the state is created.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337931\n", "files": ["dom/base/nsImageLoadingContent.cpp", "dom/base/nsImageLoadingContent.h", "dom/html/HTMLImageElement.cpp", "dom/html/HTMLImageElement.h", "dom/svg/SVGFEImageElement.cpp"], "git_node": "ff2d83c98ef2e8a37e671f3fca05658946154569", "git_parents": ["349d5b1bf05048167b17fc5f12f26ffdf484a9c9"], "node": "83d73ebd3269885bd4cb5e3d151129b804ca3326", "parents": ["29e2225f508b82df88662ad03ac8302b04667d37"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072077 - Part 6: Add testcasw with HTTP. r=bthrall\" for causing eslint and mochitests failures.\n\nThis reverts commit 52f445527b23ff2323ffee61ceb0dd25fe8ea709.\n\nThis reverts commit 60ad07f9cb84ffeacc9cb4d80ab6834d8031752b.\n\nThis reverts commit d24fd2c3202845bcd4788756b5ba62db666bf509.\n\nThis reverts commit c1da6e60af1d10e4e8b3e1099e7e0a00352b11a0.\n", "files": ["dom/base/test/browser_script_loader_js_cache_basic.js", "dom/base/test/browser_script_loader_js_cache_module_preload.js", "dom/base/test/head.js", "dom/script/ScriptLoader.cpp", "netwerk/test/browser/browser_103_assets.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_cache.js", "toolkit/components/extensions/test/xpcshell/text_ext_webRequest_js_cache.js"], "git_node": "ded2cf73e00da23515e23931a3df1970ca3f02e8", "git_parents": ["ff2d83c98ef2e8a37e671f3fca05658946154569"], "node": "e9343d91ef1da5baa407d617818b182a1d079295", "parents": ["83d73ebd3269885bd4cb5e3d151129b804ca3326"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054633 - Validate RemoteWorkerDebugger registration and stop servicing rpc requests from out-of-process workers. r=dom-worker-reviewers,devtools-reviewers,jdescottes,asuth\" for causing puppeteer failures.\n\nThis reverts commit d9689c3ce00732ba0e4ad6a2622be2ccd359bf91.\n", "files": ["devtools/server/connectors/worker-connector.js", "dom/ipc/ContentParent.cpp", "dom/workers/WorkerDebugger.cpp", "dom/workers/nsIWorkerDebugger.idl", "dom/workers/remoteworkers/RemoteWorkerDebuggerManagerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerDebuggerManagerParent.h", "dom/workers/remoteworkers/RemoteWorkerDebuggerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerDebuggerParent.h", "dom/workers/remoteworkers/RemoteWorkerService.cpp"], "git_node": "be90ad116e504e6d401943aed155f086b8dcfc52", "git_parents": ["ded2cf73e00da23515e23931a3df1970ca3f02e8"], "node": "2921e4388ae3bab7006e18f61785602e54ac1075", "parents": ["e9343d91ef1da5baa407d617818b182a1d079295"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076692 - Percent-decode No-Vary-Search header keys before matching query params. r=sunil,necko-reviewers,jesup\" for causing wpt failures in prefetch-single.https.html.\n\nThis reverts commit c64a2ed5bf570d28cf8656fc530def85312cf6bd.\n", "files": ["netwerk/base/NoVarySearchUtils.cpp", "netwerk/test/gtest/TestNoVarySearchUtils.cpp", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single.https.html.ini"], "git_node": "4087808b7bb3eb2624463a8a6afdd0a6efcace0f", "git_parents": ["be90ad116e504e6d401943aed155f086b8dcfc52"], "node": "6bbff16df05d9c8771afe9a88811768741720d68", "parents": ["2921e4388ae3bab7006e18f61785602e54ac1075"], "tags": []}, {"author": "Chris Monteiro \u003cchrismmonteiro1+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2087967 - Use hostname rather than host when detecting loopback error pages. r=firefox-desktop-core-reviewers ,Gijs\n\nlocation.host includes the port, so the loopback check never matched URLs\nwith an explicit port, such as http://127.0.0.1:5000/, and the loopback hints\nwere only shown on default ports.\n\nAdd a browser test that loads a real refused port, so getLoopbackInfo() runs\nagainst an actual failed URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338653\n", "files": ["browser/base/content/test/browser-about/browser_aboutNetError_connectionFailure.js", "toolkit/content/aboutNetErrorHelpers.mjs"], "git_node": "578f659bec47593dccef2228f85d44dad4eb25c5", "git_parents": ["4087808b7bb3eb2624463a8a6afdd0a6efcace0f"], "node": "5f03facab36f5661a79f2461f0d507a087bf349a", "parents": ["6bbff16df05d9c8771afe9a88811768741720d68"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087986 - Draw the skeleton UI with Nova's colors. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336067\n", "files": ["mozglue/misc/PreXULSkeletonUI.cpp", "mozglue/misc/PreXULSkeletonUI.h"], "git_node": "237c1dc06df9184c19b26523ac3a59abc15d5a6e", "git_parents": ["578f659bec47593dccef2228f85d44dad4eb25c5"], "node": "d4b6e44552f851ded3683d6925bd490a2aa297f3", "parents": ["5f03facab36f5661a79f2461f0d507a087bf349a"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1939747 - Remove the unused pinned chromedriver fetches. r=perftest-reviewers,kshampur\n\nChrome browsertime tasks use the Chrome-for-Testing chromedriver fetches from cft-chromedriver-fetch.yml since bug 1869592, so the 2.46, 130 and 131 static-url fetches are no longer referenced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338474\n", "files": ["taskcluster/kinds/fetch/browsertime.yml"], "git_node": "f91ed235b95445e6d90c704f9a5f819f7b9e6791", "git_parents": ["237c1dc06df9184c19b26523ac3a59abc15d5a6e"], "node": "4365ad1724b89dc951d61323eb2e687d37b0ff35", "parents": ["d4b6e44552f851ded3683d6925bd490a2aa297f3"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087260 - Fix HandleBase allocation size accounting for move assignment r=ipc-reviewers,jld\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338130\n", "files": ["ipc/glue/SharedMemoryHandle.cpp"], "git_node": "29547bcfeb870152940b47f176f7c82af57862f5", "git_parents": ["f91ed235b95445e6d90c704f9a5f819f7b9e6791"], "node": "91e9ad27bf14761390ffcedadafd1e718ee53f85", "parents": ["4365ad1724b89dc951d61323eb2e687d37b0ff35"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087260 - Test shmem-allocated and shmem-mapped reporting r=ipc-reviewers,jld\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338376\n", "files": ["ipc/gtest/TestSharedMemory.cpp"], "git_node": "57d8dfda4dda0109703e58573ca7f92b2a8e70e0", "git_parents": ["29547bcfeb870152940b47f176f7c82af57862f5"], "node": "f837a215734119c48665a989b24c239d8624e026", "parents": ["91e9ad27bf14761390ffcedadafd1e718ee53f85"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070906 - Update perfetto to v59.1. r=canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338612\n", "files": ["third_party/perfetto/LICENSE", "third_party/perfetto/moz.yaml", "third_party/perfetto/sdk/perfetto.cc", "third_party/perfetto/sdk/perfetto.h"], "git_node": "7f472793d9a71c294ea0678e4401934555e41937", "git_parents": ["57d8dfda4dda0109703e58573ca7f92b2a8e70e0"], "node": "e3bc806e7b65366c9bc47af919a003f37ff0f4fa", "parents": ["f837a215734119c48665a989b24c239d862