rowser_osAuthDialog.js", "toolkit/components/passwordmgr/test/browser/browser_relay_signup_flow_showToAllBrowsers.js", "toolkit/components/passwordmgr/test/browser/browser_relay_telemetry.js", "toolkit/components/satchel/megalist/content/tests/browser/browser_passwords_sidebar.js"], "git_node": "5005781dfdd23fe407c17104ef2f136b98d8e8c5", "git_parents": ["fc56fa7ec18fa3a78c9708151406f2f0efe0f827"], "node": "a3c20335b0cd6aaebd357e37ebef4aab4afdae45", "parents": ["0815c218fc685422f5f6cca49ad73db0bf011bcf"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup application update tests that rely on the SRD pref being false r=application-update-reviewers,spohl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336278\n", "files": ["toolkit/mozapps/update/tests/browser/browser_aboutPrefs_backgroundUpdateSetting.js", "toolkit/mozapps/update/tests/browser/browser_aboutPrefs_settings.js", "toolkit/mozapps/update/tests/browser/head.js"], "git_node": "310d07532b1f95329ccc64caec4c78b51f4685e4", "git_parents": ["5005781dfdd23fe407c17104ef2f136b98d8e8c5"], "node": "594b70137bbb201ed5c8dfcb71d4b8e8dab66eae", "parents": ["a3c20335b0cd6aaebd357e37ebef4aab4afdae45"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup additional tests that rely on the SRD pref being false r=settings-reviewers,omc-reviewers,jhirsch,akulyk,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336279\n", "files": ["accessible/tests/browser/telemetry/browser_HCM_telemetry.js", "browser/base/content/test/browser-alerts/browser_notification_open_settings.js", "browser/base/content/test/browser-framebusting/browser_framebusting_notification.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_open_preferences.js", "browser/base/content/test/browser-sanitize/browser_sanitizeDialog_v2.js", "browser/base/content/test/browser-sanitize/head.js", "browser/components/asrouter/tests/browser/browser_trigger_listeners.js", "browser/components/nimbus/tests/browser/browser_about_preferences.js", "browser/components/nimbus/tests/browser/browser_about_studies.js", "browser/components/profiles/tests/browser/browser_preferences.js", "browser/components/uitour/test/browser_openPreferences.js", "browser/modules/test/browser/browser_UsageTelemetry_interaction.js", "toolkit/components/certviewer/tests/browser/browser_checkNonRepeatedCertTabs.js", "toolkit/components/certviewer/tests/browser/browser_openTabAndSendCertInfo.js"], "git_node": "fc8df1175d23a89e6297cf576f247642b3e43fa0", "git_parents": ["310d07532b1f95329ccc64caec4c78b51f4685e4"], "node": "fb413e4a494a43eee001015b394e86221af2b5c7", "parents": ["594b70137bbb201ed5c8dfcb71d4b8e8dab66eae"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074838 - Don't split UTF-8 characters when truncating filenames in nsWebBrowserPersist. r=mak\" for causing lint failures on browser_persist_filename.js.\n\nThis reverts commit 6b96e521252911df0618f8fb1e4a2af848a386e9.\n", "files": ["dom/tests/browser/browser_persist_filename.js", "dom/webbrowserpersist/nsWebBrowserPersist.cpp"], "git_node": "893697f7d379a366e27709c22819598a967b1109", "git_parents": ["fc8df1175d23a89e6297cf576f247642b3e43fa0"], "node": "d6ae16d5441adb0829e78a9a6e932c8350b5be47", "parents": ["fb413e4a494a43eee001015b394e86221af2b5c7"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086608 - Apply the try overrides for backstop and expanded pushes to the perf-cadence aliases. r=taskgraph-reviewers,bhearsum DONTBUILD\" for causing firefox-ci failures on test_mach_try_auto.py.\n\nThis reverts commit 61ec5138984e42a2de2985707dc43113217e0c8a.\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py"], "git_node": "2e9d30e9a2d67fc553d3bff4696676702e0f16d4", "git_parents": ["893697f7d379a366e27709c22819598a967b1109"], "node": "c1988059b7f97576021f511e0ae2ec2faa24069a", "parents": ["d6ae16d5441adb0829e78a9a6e932c8350b5be47"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086605 - Create a new verifyTheOfferToTranslateWhenPossibleOptionTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337593\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsTranslationSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt"], "git_node": "7069d106af32c452789061509ad66e99bbeddb87", "git_parents": ["2e9d30e9a2d67fc553d3bff4696676702e0f16d4"], "node": "9a1789ce47a592450c3c20ed20c6f26c2dbcdb0b", "parents": ["c1988059b7f97576021f511e0ae2ec2faa24069a"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2085438 - Add a secret setting and Nimbus flag for the Wrexham widget r=android-reviewers,npoon\n\n- Add the homepage-wrexham-widget Nimbus feature and an \"Enable Homepage Wrexham Widget\" secret setting\n- Add a \"Wrexham Widget\" Homepage settings toggle, off by default and shown only when the feature is enabled\n- Record the toggle with customize_home.preference_toggled using the wrexham_widget key\n- Exclude the Wrexham and Weather widget toggles from settings search when their features are disabled\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337007\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/HomeSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/home_preferences.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/HomeSettingsFragmentTest.kt"], "git_node": "727a861e11a1e7216e6fa4747fe1caaed87e7a8f", "git_parents": ["7069d106af32c452789061509ad66e99bbeddb87"], "node": "1c75d2e3d93dfdd68513343a0367988325fc84ea", "parents": ["9a1789ce47a592450c3c20ed20c6f26c2dbcdb0b"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083869 - Inline field initializers that are plain number literals r=spidermonkey-reviewers,mgaudet\n\nInline any plain number literal using emitNumberOp to pick the opcode. Negative literals still fall back to .initializers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335447\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/Parser.cpp", "js/src/frontend/Parser.h", "js/src/frontend/SharedContext.h", "js/src/vm/SharedStencil.h"], "git_node": "67c20d9ebb69f9e2a3b72f383bbd4f56c590beab", "git_parents": ["727a861e11a1e7216e6fa4747fe1caaed87e7a8f"], "node": "91f4768fa97746c0f909920ccfa4218f1e1cf26c", "parents": ["1c75d2e3d93dfdd68513343a0367988325fc84ea"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2084809 - Part 1: Restore the ScorePill with live and not live colors r=android-reviewers,skhan\n\n- Restore ScorePill from the removed Homepage Sports Widget\n- Add an isLive state that uses the error and onError colors\n- Use surfaceContainerHigh and onSurface colors when the match is not live\n\nFigma:\n- Live: https://www.figma.com/design/kDvQ8Hd2c5MwN9S3Y2FZ5r/Wrexham-Ideas?node-id=751-151326&m=dev\n- Not live: https://www.figma.com/design/kDvQ8Hd2c5MwN9S3Y2FZ5r/Wrexham-Ideas?node-id=751-151408&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337001\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/ScorePill.kt"], "git_node": "184690874704f77399e1acc91eb3d7811f098800", "git_parents": ["67c20d9ebb69f9e2a3b72f383bbd4f56c590beab"], "node": "a07b707b269c49757aef2229ea12ad39d14b636e", "parents": ["91f4768fa97746c0f909920ccfa4218f1e1cf26c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086234 - Point non-shipping GeckoView consumers at a single-arch build instead of the fat AAR. r=releng-reviewers,jcristau,taskgraph-reviewers\n\ntest-apk and build-samples-browser now use the x86_64 build, test-components the aarch64 build that matches\nits arm64 Firebase devices, and build-components the x86_64 build for every build type except release, beta\nand nightly. Their appservices-in-tree copies stay on the appservices fat AAR, the only build whose\nfull-megazord-libsForTests carries the desktop megazord libraries their unit tests load. When a gradlew task's\ngeckoview dependency is a build task, configure_gradlew takes MOZCONFIG from that build and leaves\nMOZ_ANDROID_FAT_AAR_ARCHITECTURES unset, so Gradle resolves the single-arch GeckoView artifact the task\nfetched. The dependency key in these kinds is renamed from build-fat-aar to geckoview since it no longer\nalways names the fat AAR. build-apk keeps the fat AAR because its APKs are split per ABI and its consumers\nneed more than one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337262\n", "files": ["taskcluster/android_taskgraph/job.py", "taskcluster/android_taskgraph/transforms/build_components.py", "taskcluster/gecko_taskgraph/test/test_android_taskgraph.py", "taskcluster/kinds/build-components-appservices/kind.yml", "taskcluster/kinds/build-components/kind.yml", "taskcluster/kinds/build-samples-browser/kind.yml", "taskcluster/kinds/test-apk-appservices/kind.yml", "taskcluster/kinds/test-apk/kind.yml", "taskcluster/kinds/test-components-appservices/kind.yml", "taskcluster/kinds/test-components/kind.yml"], "git_node": "06148ec3eb4310c75b66a51041b6150867a80e3f", "git_parents": ["184690874704f77399e1acc91eb3d7811f098800"], "node": "5532b53920c2089f29c6785616f95c3422100ba8", "parents": ["a07b707b269c49757aef2229ea12ad39d14b636e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086711 - Fetch the run-task resource usage profile in the test timings scripts, r=jcristau.\n\nFall back to the old mozharness profile for the tasks that predate the rename, as the scripts process 21 days of tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337656\n", "files": ["testing/timings/profile-worker.js"], "git_node": "d86769ec0b09c4de9bc485190e70b58abe31abbd", "git_parents": ["06148ec3eb4310c75b66a51041b6150867a80e3f"], "node": "1b37efd18d9b234d6e36319ca6ec6f981fa544a2", "parents": ["5532b53920c2089f29c6785616f95c3422100ba8"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069769 - Remove dom.ipc.processPrelaunch.lowmem_mb. r=mccr8\n\nThis check was always false by default, because the pref's default value is 4096, so this wrapped to 0.\n\n4096\u00d71024\u00d71024 =\n2\u00b9\u00b2\u00d72\u00b9\u2070\u00d72\u00b9\u2070 =\n2\u00b3\u00b2; wraps to 0 on an unsigned int 32 bits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323934\n", "files": ["dom/ipc/PreallocatedProcessManager.cpp", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "afa26250f7ab72efcddf5257e982dae1a7a1787b", "git_parents": ["d86769ec0b09c4de9bc485190e70b58abe31abbd"], "node": "48e22ed82310ecba16bebfdca128fc16e66ddbfd", "parents": ["1b37efd18d9b234d6e36319ca6ec6f981fa544a2"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086700 - Raise the Gradle daemon's JIT code cache to 512 MB r=RyanVM,android-build-system-reviewers\n\nIn CI the Gradle daemon fills the JVM's default 240 MB code cache, and the\nrest of the task then runs much slower. With 512 MB, fenix lint takes about\n800s instead of 1,900s when its daemon reuses work from earlier in the task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337651\n", "files": ["gradle.properties", "mobile/android/android-components/gradle.properties", "mobile/android/fenix/gradle.properties", "mobile/android/focus-android/gradle.properties"], "git_node": "6405399ec29d1afe74409e4202147a6819d0c434", "git_parents": ["afa26250f7ab72efcddf5257e982dae1a7a1787b"], "node": "52f124bba1ed2f92cc8228f6c0a9ebcf0e2629d9", "parents": ["48e22ed82310ecba16bebfdca128fc16e66ddbfd"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086509 - Remove non-idempotent changes from bug 2079602 r=emilio,webrtc-reviewers,mjf\n\nIn some cases, auto was used where some upcasting was done, so the upcasting was lost.\n\ne.g. :\n\nstd::unique_ptr\u003cBase\u003e a = std::make_unique\u003cChild\u003e();\n\nis different from\n\nauto a = std::make_unique\u003cChild\u003e();\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337503\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "toolkit/components/uniffi-bindgen-gecko-js/src/templates/cpp/CallbackInterfaces.cpp", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "fe120fc5eb43fa8a01f46ab331a2174515cd7fb6", "git_parents": ["6405399ec29d1afe74409e4202147a6819d0c434"], "node": "6238a23690be5384c369de94b72a202e2125d737", "parents": ["52f124bba1ed2f92cc8228f6c0a9ebcf0e2629d9"], "tags": []}, {"author": "Mike Conley \u003cmike@conley.io\u003e", "branch": "default", "desc": "Bug 2072717 - Convert DownloadElementShell to an ES6 class. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326629\n", "files": ["browser/components/downloads/DownloadsViewUI.sys.mjs", "browser/components/downloads/content/allDownloadsView.js", "browser/components/downloads/content/downloads.js", "browser/components/downloads/test/unit/test_DownloadsViewUI_getCommandNamesFrom.js", "browser/components/downloads/test/unit/xpcshell.toml"], "git_node": "c0bdd911219d47cdd383a8b23586491fedc3d9f3", "git_parents": ["fe120fc5eb43fa8a01f46ab331a2174515cd7fb6"], "node": "b04ee5615c0f306a7a30812a2677897fd4a1abc1", "parents": ["6238a23690be5384c369de94b72a202e2125d737"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075732 - Updated about:logins UI for per-device sync r=mtigley,fluent-reviewers,credential-management-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337332\n", "files": ["browser/components/aboutlogins/AboutLoginsParent.sys.mjs", "browser/components/aboutlogins/content/aboutLogins.mjs", "browser/components/aboutlogins/content/components/login-command-button.mjs", "browser/components/aboutlogins/content/components/login-item.mjs", "browser/components/aboutlogins/tests/browser/browser.toml", "browser/components/aboutlogins/tests/browser/browser_perDeviceSync.js", "browser/locales/en-US/browser/aboutLogins.ftl"], "git_node": "f0397de5962e919b7e4885b5be610680fc6a1cc6", "git_parents": ["c0bdd911219d47cdd383a8b23586491fedc3d9f3"], "node": "6d0fdb26848e20bbba1c8a7c1dcf16be6139b0c8", "parents": ["b04ee5615c0f306a7a30812a2677897fd4a1abc1"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086605 - Create a new verifyTheOfferToTranslateWhenPossibleOptionTest regression UI test r=aaronmt\" for causing fenix failures.\n\nThis reverts commit 7069d106af32c452789061509ad66e99bbeddb87.\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsTranslationSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt"], "git_node": "3b790c670a6d7c0f28fbfb39d2030a5d0044256e", "git_parents": ["f0397de5962e919b7e4885b5be610680fc6a1cc6"], "node": "678d1486efdb90fd8bc73236b4ffdfcfd73a0e8b", "parents": ["6d0fdb26848e20bbba1c8a7c1dcf16be6139b0c8"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081441 - Remove the tab-groups-button placement when cleaning up the confirmation hint test. r=sthompson,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333787\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_tab_group_menu.js"], "git_node": "479c34a9b79424fbe5de1f81823031162ff16560", "git_parents": ["3b790c670a6d7c0f28fbfb39d2030a5d0044256e"], "node": "bf73103c720eaacf88b55f2053b71a769212eaef", "parents": ["678d1486efdb90fd8bc73236b4ffdfcfd73a0e8b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085571 - Keep the media session position accurate across state rebuilds. r=Roger,android-reviewers\n\nEvery state rebuild handed Media3 a fresh extrapolating position that restarted from the last reported value,\nso an unrelated change mid-track (features, artwork, fullscreen) jumped the seek bar back. The supplier is now\nreused until the tab, track title, play state, reported position state or rate changes, and is dropped while\nno tab is active. A play state change alone continues from the current position, so pausing does not fall back\nto the last reported one. A seek from the notification or lockscreen moves it to the target right away instead\nof waiting for the page to report.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336532\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/player/BrowserStorePlayer.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/player/BrowserStorePlayerTest.kt"], "git_node": "4d4a7c3c8d3e07be37a48a1f5cc2ecf9ad3aeb5f", "git_parents": ["479c34a9b79424fbe5de1f81823031162ff16560"], "node": "bfa0196c1b8fe4c89f98c23f5ea23164b1f4c3a9", "parents": ["bf73103c720eaacf88b55f2053b71a769212eaef"], "tags": []}, {"author": "Matt Cleinman \u003c9295855+mcleinman@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084724 - Update copy on catastrophic error alert - r=ip-protection-reviewers,fluent-reviewers,rking,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337338\n", "files": ["browser/components/ipprotection/IPProtectionAlertManager.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_alert_manager.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "cdad7ebd8da30297679b7d3ebc74aaa471d04619", "git_parents": ["4d4a7c3c8d3e07be37a48a1f5cc2ecf9ad3aeb5f"], "node": "09e026fbc5dee7d237b397f40ab9296e7d652abc", "parents": ["bfa0196c1b8fe4c89f98c23f5ea23164b1f4c3a9"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 1700396: Bump Updatebot for bug fixes 435,438 r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337630\n", "files": ["taskcluster/docker/updatebot/updatebot-version.sh"], "git_node": "da8bab669bcb4d8aa3a8f817e46288fb1f752cff", "git_parents": ["cdad7ebd8da30297679b7d3ebc74aaa471d04619"], "node": "4155395e1206d8030beab0e4b5e8a175e88ce3d3", "parents": ["09e026fbc5dee7d237b397f40ab9296e7d652abc"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085178 - Report decode errors as remote crashes when the video bridge is gone. r=media-playback-reviewers,chunmin\n\nWhen the GPU process crashes, a remote video decoder can no longer\nallocate its images from the video bridge. The resulting allocation\nfailure was fatal, so playback never recovered. Report it as a remote\ncrash instead so that the decoder is recreated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336305\n", "files": ["dom/media/ipc/RemoteDecoderParent.cpp", "dom/media/ipc/RemoteDecoderParent.h", "dom/media/ipc/RemoteVideoDecoder.cpp", "dom/media/ipc/RemoteVideoDecoder.h"], "git_node": "2fc4c81399775b7dd8f0d7a23356da0fb432745b", "git_parents": ["da8bab669bcb4d8aa3a8f817e46288fb1f752cff"], "node": "a203761d53eb182b9d16c683d68a4d1ea32c3127", "parents": ["4155395e1206d8030beab0e4b5e8a175e88ce3d3"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085049 - Update CI to use Widevine 4.10.3112.0. r=jolin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336212\n", "files": ["taskcluster/kinds/fetch/widevine.yml"], "git_node": "ea2f27d751c1997293a9b1a016c7e4a5343ce3d7", "git_parents": ["2fc4c81399775b7dd8f0d7a23356da0fb432745b"], "node": "e053f6b0c963cd67480b94c48d3a71c1dbc4caf2", "parents": ["a203761d53eb182b9d16c683d68a4d1ea32c3127"], "tags": []}, {"author": "Dimi Lee \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086214 - Vendor application-services 50b76886 to fix a crash in autofill sync de-duplication. r=bdk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337712\n", "files": ["th