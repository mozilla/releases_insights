 tests\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338795\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx"], "git_node": "a0d0dbe5b2bbfdf7e18efa00869a67880e112224", "git_parents": ["d65e1844075453600602ce6f8d563b6ad4ffacae"], "node": "ea2eea78697715f8b711300be06de05be05e4684", "parents": ["606d9824bfaafa9fa370e65fba1d40a581c837e0"], "tags": []}, {"author": "elkal98 \u003ckhalid.alhaddad98@gmail.com\u003e", "branch": "default", "desc": "Bug 2072547 - Update find method in DOM.sys.mjs to always return a list and move error handling into relevant commands. r=whimboo,webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328853\n", "files": ["remote/marionette/actors/MarionetteCommandsChild.sys.mjs", "remote/marionette/actors/MarionetteCommandsParent.sys.mjs", "remote/marionette/driver.sys.mjs", "remote/shared/DOM.sys.mjs"], "git_node": "c1323004acfa242f6675cae0f7bc2a152a59475e", "git_parents": ["a0d0dbe5b2bbfdf7e18efa00869a67880e112224"], "node": "8a97f3ee68bb549d8c2f6768ff237a03136be102", "parents": ["ea2eea78697715f8b711300be06de05be05e4684"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088160 - Render clip-path polygon() with WebRender path clips. r=firefox-svg-reviewers,longsonr\" for causing mochitest failures\n\nThis reverts commit bcc23724d073d6b33ba083dd6f88ae7296fb8df9.\n", "files": ["layout/painting/nsDisplayList.cpp", "layout/svg/SVGUtils.cpp", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-fill.html.ini"], "git_node": "d38bd59e931664d1a9fdfdd71514acf772211869", "git_parents": ["c1323004acfa242f6675cae0f7bc2a152a59475e"], "node": "73f81d7023574812644ebf34ebe971a16cdd9b55", "parents": ["8a97f3ee68bb549d8c2f6768ff237a03136be102"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "bra