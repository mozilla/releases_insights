6966\nzam -\u003e 7bde8a119638de454cda90a723e35cd3b1896966\nzh-CN -\u003e 7bde8a119638de454cda90a723e35cd3b1896966\nzh-TW -\u003e 7bde8a119638de454cda90a723e35cd3b1896966\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "da141006bb55fe1420d39ec1fb730bb32390a44a", "git_parents": ["e7a464012d3b4f677287bfff9bb66cacce634653"], "node": "263530795a1ea6d7da80fec4798986dff71fc2c0", "parents": ["94faaf7d004e7033dc073d02d267c191d4ae7f63"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084683 - Derive the IP Protection telemetry extra values from the case names. r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336236\n", "files": ["mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/kotlin/String.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/kotlin/StringTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionTelemetryMiddlewareTest.kt"], "git_node": "7c3642b5b92dbc459ae159da5ae0c29a6301e763", "git_parents": ["da141006bb55fe1420d39ec1fb730bb32390a44a"], "node": "645459f7cfd17b68bc213a7a9b8661c502510800", "parents": ["263530795a1ea6d7da80fec4798986dff71fc2c0"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081886: Rename ai-website-chips to smartwindow-chips r=flozia,urlbar-reviewers,adw\n\n**Context**\nWe're renaming `ai-website-chips` to `smartwindow-chips` as this component is no longer used just as a website chip across smart window. We are expanding how we use our chips, adding it to new features such as the monitor and smart pages.\nOur goal is to have a clear naming and also add a third type of chip for source citations - we currently have context and inline, and would like to add source as a third.\n\n**This patch**\nThis patch is related to the renaming of the component, and others in the same stack will handle the CSS and Lit component changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334757\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-citations/chat-assistant-citations.css", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-citations/chat-assistant-citations.mjs", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.css", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-highlights/aitab-highlights.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-table/aitab-table.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-text-block/aitab-text-block.mjs", "browser/components/aiwindow/ui/components/smartwindow-chip/smartwindow-chip.css", "browser/components/aiwindow/ui/components/smartwindow-chip/smartwindow-chip.mjs", "browser/components/aiwindow/ui/components/smartwindow-chip/smartwindow-chip.stories.mjs", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.css", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.mjs", "browser/components/aiwindow/ui/content/aiChatContent.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_message_event.js", "browser/components/aiwindow/ui/test/browser/browser_aichat_message.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_table.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_grouped_chips.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_context_chips.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_website_chip.js", "browser/components/aiwindow/ui/test/browser/browser_chat_assistant_citations.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/browser/test_website_chip.mjs", "browser/components/aiwindow/ui/test/browser/test_website_chip_page.html", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs"], "git_node": "5c285cdd43e1d2c2230c1fc2a8b27e4d9278c417", "git_parents": ["7c3642b5b92dbc459ae159da5ae0c29a6301e763"], "node": "6d11a73aa2f036ca5dbb8c4c7904536dbf1cab0d", "parents": ["645459f7cfd17b68bc213a7a9b8661c502510800"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081886 - Extract smartwindow chip rendering helpers. r=jlewis\n\nPart of a stack of patches that refactors the smart window chips.\n\nThis one breaks down the render function into smaller ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335191\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-chip/smartwindow-chip.mjs"], "git_node": "921355edd6ba3d3fceb32ca6088f4fa89264698e", "git_parents": ["5c285cdd43e1d2c2230c1fc2a8b27e4d9278c417"], "node": "c63854028d7fa010c0c8e0bbc5d0b4fb76429898", "parents": ["6d11a73aa2f036ca5dbb8c4c7904536dbf1cab0d"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081886 - Use context and source types for smartwindow chips. r=jlewis\n\nReplace context-chip and size with context and source types, and migrate\nconsumers, styles, stories and tests. Only context and source are removable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334760\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-citations/chat-assistant-citations.css", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-citations/chat-assistant-citations.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-highlights/aitab-highlights.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-table/aitab-table.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-text-block/aitab-text-block.mjs", "browser/components/aiwindow/ui/components/smartwindow-chip/smartwindow-chip.css", "browser/components/aiwindow/ui/components/smartwindow-chip/smartwindow-chip.mjs", "browser/components/aiwindow/ui/components/smartwindow-chip/smartwindow-chip.stories.mjs", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.css", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.mjs", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.stories.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_website_chip.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_chip_overflow.js", "browser/components/aiwindow/ui/test/browser/test_website_chip_page.html"], "git_node": "f8e6841a57bfdc32c9e6b1f2ba5dad696a5f5045", "git_parents": ["921355edd6ba3d3fceb32ca6088f4fa89264698e"], "node": "e5400534badad131c6eeef4c4cb0ef46fd813cd2", "parents": ["c63854028d7fa010c0c8e0bbc5d0b4fb76429898"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1972602 - Remove legacy enrollment store and disable persistence in tests r=ralkhulaidi,nimbus-reviewers,emcminn,settings-reviewers,Gijs,crashreporting-reviewers\n\nThe shared SQL database in the ProfilesDatastoreServices has been the\nsource of truth for Nimbus since bug 1972426. However, we've still had\nthe legacy ExperimentDataStore.json to support xpcshell tests that do\nnot enable the ProfilesDatastoreService (see bug 1967779).\n\nBy default we no longer persist experiments to disk when running in a\ntest environment (when `Cu.isInAutomation` is true at startup). This\nremoves the need for keeping the legacy experiment store. Persistence\nis, however, enabled in all toolkit/components/nimbus xpcshell tests to\nensure correctness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322754\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/experimental_features/head.js", "browser/components/urlbar/tests/browser-quickactions/browser_commands.js", "testing/profiles/xpcshell/user.js", "toolkit/components/nimbus/lib/Enrollments.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/ExperimentStore.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/browser/browser_SharedDataMap.js", "toolkit/components/nimbus/test/browser/browser_about_config_pref_change.js", "toolkit/components/nimbus/test/browser/browser_experimentapi_child.js", "toolkit/components/nimbus/test/browser/browser_remotesettings_experiment_enroll.js", "toolkit/components/nimbus/test/browser/head.js", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml", "toolkit/components/nimbus/test/unit/test_ExperimentManager_lifecycle.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_prefs.js", "toolkit/components/nimbus/test/unit/test_ExperimentStore.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_Migrations.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_bug2054546.js", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/nimbus/test/unit/xpcshell.toml", "toolkit/crashreporter/test/unit/crasher_subprocess_head.js"], "git_node": "51f16131acac25e7afc09939be6b46253c4bca2b", "git_parents": ["f8e6841a57bfdc32c9e6b1f2ba5dad696a5f5045"], "node": "0382b187b9460c94edd2fe9127a877c3aba7929d", "parents": ["e5400534badad131c6eeef4c4cb0ef46fd813cd2"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p1 - Add the `prefs` module for unified prefs handling r=crashreporting-reviewers,schopin\n\nThis replaces the `prefs_parser` module.\n\nThe `Prefs` type will look for a set of prefs relevant to the program\nand aggregate values as prefs files are loaded. This consolidates code\nfrom the `langpack` and `glean` modules. It is intended to be\nfunctionally equivalent to the existing prefs loading. Improvements are\nin following patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333401\n", "files": ["toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/glean.rs", "toolkit/crashreporter/client/app/src/lang/langpack.rs", "toolkit/crashreporter/client/app/src/lang/mod.rs", "toolkit/crashreporter/client/app/src/main.rs", "toolkit/crashreporter/client/app/src/prefs/mod.rs", "toolkit/crashreporter/client/app/src/prefs/parser.rs", "toolkit/crashreporter/client/app/src/prefs_parser.rs", "toolkit/crashreporter/client/app/src/send_ping.rs", "toolkit/crashreporter/client/app/src/std/path.rs"], "git_node": "dd8838c18316f46f411eee5ce330a80aab1f4558", "git_parents": ["51f16131acac25e7afc09939be6b46253c4bca2b"], "node": "ea9bdc8a4dd33fe93b72bd7e4580c36b72c9ce0b", "parents": ["0382b187b9460c94edd2fe9127a877c3aba7929d"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p2 - Load user.js prefs r=crashreporting-reviewers,gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334738\n", "files": ["toolkit/crashreporter/client/app/src/prefs/mod.rs"], "git_node": "41e0db311928427fd645acf2ef8c354daf533774", "git_parents": ["dd8838c18316f46f411eee5ce330a80aab1f4558"], "node": "39522905c0ab9af704f824daf307341dde687c42", "parents": ["ea9bdc8a4dd33fe93b72bd7e4580c36b72c9ce0b"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p3 - Support the standard prefs directories r=crashreporting-reviewers,gsvelto\n\nPrefs files are read in prefs directories in reverse-alphabetical order.\nThe order of directories here matches the order in which Firefox loads\nthem.\n\nThis adds support to the prefs parser for other prefs \"functions\". User\npref files are supposed to only have `user_pref`, but default pref files\ncan have the others.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334739\n", "files": ["toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/prefs/mod.rs", "toolkit/crashreporter/client/app/src/prefs/parser.rs", "toolkit/crashreporter/client/app/src/send_ping.rs", "toolkit/crashreporter/client/app/src/std/fs.rs", "toolkit/crashreporter/client/app/src/std/path.rs"], "git_node": "75621f85f9ef0500433502a5eec1a1e6dc235ad1", "git_parents": ["41e0db311928427fd645acf2ef8c354daf533774"], "node": "df514fec09d344651b147f210e93a0deb15df191", "parents": ["39522905c0ab9af704f824daf307341dde687c42"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p4 - Support flatpak and debian prefs directories r=crashreporting-reviewers,gsvelto\n\nThis fixes the case described in the bug.\n\nThe `mocked_static!` macro was modified in a minor way to explicitly\nindicate the mocked value. This is used in the flatpak detection static\nvalue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334741\n", "files": ["toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/net/http.rs", "toolkit/crashreporter/client/app/src/prefs/mod.rs", "toolkit/crashreporter/client/app/src/std/mock.rs", "toolkit/crashreporter/client/app/src/std/mock_stub.rs"], "git_node": "dee42492602a9f54b15ba78df00a5d0fbf939198", "git_parents": ["75621f85f9ef0500433502a5eec1a1e6dc235ad1"], "node": "2ab31f6f79226c5d2ec29ae1727cca12a2407f65", "parents": ["df514fec09d344651b147f210e93a0deb15df191"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084959 - Schedule the sentry, trigger-comm-central, release-notify-testrail, updatebot, scriptworker-canary and system-symbols kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,ahal\n\nDeletes `run-on-repo-type: [hg]` from sentry, trigger-comm-central,\nrelease-notify-testrail, updatebot, scriptworker-canary,\nsystem-symbols-upload and system-symbols-reprocess. scriptworker-canary\nalso loses `clone-with: hg`, its transform pins the Mercurial checkout\nitself. The other `clone-with: hg` lines stay: they keep the Mercurial\ncheckout on Mercurial pushes until the Git checkout of these tasks can be\ntested at level 3, where their tokens live. On a Git push the checkout is\nGit whatever the setting says. Scheduling only, a no-op on the existing\ngraphs, as agreed with ahal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336145\n", "files": ["taskcluster/kinds/release-notify-testrail/kind.yml", "taskcluster/kinds/scriptworker-canary/kind.yml", "taskcluster/kinds/sentry/kind.yml", "taskcluster/kinds/system-symbols-reprocess/kind.yml", "taskcluster/kinds/system-symbols-upload/kind.yml", "taskcluster/kinds/trigger-comm-central/kind.yml", "taskcluster/kinds/updatebot/kind.yml"], "git_node": "2bafdb79b0c64be0fc893a9e8e575477a855fdef", "git_parents": ["dee42492602a9f54b15ba78df00a5d0fbf939198"], "node": "959e6193828315d4746bb8d2d6d294afe1f5b868", "parents": ["2ab31f6f79226c5d2ec29ae1727cca12a2407f65"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085318 - Point `mach try scriptworker mac-signing` at the build-mac-signing label, r=ahal\n\nThe mac-signing preset still targets `build-signing-macosx64-shippable/opt`,\nwhich no longer exists since mac signing moved to the build-mac-signing kind.\nThe decision task ended up with an empty target set and the push only ran\nthe default source-test tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336496\n", "files": ["tools/tryselect/selectors/scriptworker.py"], "git_node": "df12121e4e41961ef361d635723638c77ab198ca", "git_parents": ["2bafdb79b0c64be0fc893a9e8e575477a855fdef"], "node": "1b3fc4a6536ef051fd6f17d8f79f6b47e572b44e", "parents": ["959e6193828315d4746bb8d2d6d294afe1f5b868"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2084361: Exclude .claude/ directory from perfdocs scans r=mozperftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335799\n", "files": ["python/mozperftest/mozperftest/perfdocs/framework_gatherers.py", "python/mozperftest/mozperftest/perfdocs/gatherer.py"], "git_node": "fb9a47382b8782b0a27dc2e3442198f959d213b2", "git_parents": ["df12121e4e41961ef361d635723638c77ab198ca"], "node": "29410a9f9d51938d25eff84c5bf36bc10e72c12f", "parents": ["1b3fc4a6536ef051fd6f17d8f79f6b47e572b44e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2083302 - Upload a profile when browser-chrome tests leak windows until shutdown. r=ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334826\n", "files": ["testing/mochitest/browser-test.js"], "git_node": "d0c9817c1dabce9ba4d22ff43ccfd19600e23ed7", "git_parents": ["fb9a47382b8782b0a27dc2e3442198f959d213b2"], "node": "0c4152b901dbb758cf63b6471019de55d7603fed", "parents": ["29410a9f9d51938d25eff84c5bf36bc10e72c12f"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084760 - Only extract the tp5n pageset copy that talos DAMP suites use. r=perftest-reviewers,kshampur\n\nDAMP only loads pages from the fis/ copy of tp5n, so extracting the unmodified tests/ was unnecessary work\nWe see the biggest improvement on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336201\n", "files": ["testing/mozharness/mozharness/mozilla/testing/talos.py"], "git_node": "8cd685677b91dc267ff899aad6182658f635722b", "git_parents": ["d0c9817c1dabce9ba4d22ff43ccfd19600e23ed7"], "node": "285456bbe7ab83212b4fb1669bffc316a94776d1", "parents": ["0c4152b901dbb758cf63b6471019de55d7603fed"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081982. r=edgar\" for causing hazard failures @ StyleSheet.cpp\n\nThis reverts commit 6391882387da0a8be304d2ca19a9e64523e85838.\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "322aeb13304ee31af29526715137584ace3a3508", "git_parents": ["8cd685677b91dc267ff899aad6182658f635722b"], "node": "acd4631a2b451870e70d6a517cf54f5a4d961a6c", "parents": ["285456bbe7ab83212b4fb1669bffc316a94776d1"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2085170 part 1 - hide Windows taskbar always when not in fullscreen mode r=win-reviewers,handyman\n\nSkip over always-on-top non-fullscreen windows and then return the\nfirst window in Z-order (rather than the last one).\n\nThis also fixes bug 2065905 and bug 2064173 for me.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336770\n", "files": ["widget/windows/nsWindowTaskbarConcealer.cpp"], "git_node": "de3f13877148aabe30f16cdfda563a3698c3eb4b", "git_parents": ["322aeb13304ee31af29526715137584ace3a3508"], "node": "68aa94b4fb45e92a16d5db3b10f9cdb8a6164dd5", "parents": ["acd4631a2b451870e70d6a517cf54f5a4d961a6c"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2085170 part 2 - Move taskbar-hiding window selection into a testable function and add gtests. r=win-reviewers,handyman\n\nThe choice of which window hides the taskbar has regressed several times\n(bug 2048501, bug 2064173, bug 2065905), so make it a pure function that\ncan be covered by unit tests.\n\nThis is just a refactor and should not change any behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336771\n", "files": ["widget/windows/nsWindow.h", "widget/windows/nsWindowTaskbarConcealer.cpp", "widget/windows/nsWindowTaskbarConcealer.h", "widget/windows/tests/gtest/TestTaskbarConcealer.cpp", "widget/windows/tests/gtest/moz.build"], "git_node": "3a3036162995001ab06ede415d551ccdad125761", "git_parents": ["de3f13877148aabe30f16cdfda563a3698c3eb4b"], "node": "02a4c08858f656a2d479ee915b81713dc35f6016", "parents": ["68aa94b4fb45e92a16d5db3b10f9cdb8a6164dd5"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2034086: Remove usage rows whose file id no longer exists. r=dom-storage-reviewers,hsingh\" for causing xpc failures @ test_orphanUsageCleanup.js\n\nThis reverts commit 43e2431c583ce4ef4eb89eaf8ec8fc496437df38.\n\nRevert \"Bug 2034086: Make fileIds unknown on failed removals. r=dom-storage-reviewers,hsingh\"\n\nThis reverts commit d4dc5d2dedcf7af6b1919cf51b3f0c5b722645b2.\n", "files": ["dom/fs/parent/datamodel/FileSystemDataManager.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManager.h", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion001.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion001.h", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.h", "dom/fs/test/gtest/parent/FileSystemParentTest.cpp", "dom/fs/test/gtest/parent/FileSystemParentTest.h", "dom/fs/test/gtest/parent/TestFileSystemOrphanCleanup.cpp", "dom/fs/test/gtest/parent/moz.build", "dom/fs/test/xpcshell/test_fileIdCarry.js", "dom/fs/test/xpcshell/test_orphanUsageCleanup.js", "dom/fs/test/xpcshell/xpcshell.toml"], "git_node": "5e16dfe8613dd6b8dbe866afd941f42057443e0e", "git_parents": ["3a3036162995001ab06ede415d551ccdad125761"], "node": "2e57f0eec64cde686e3fee5a4b3d0bcbe962ab6d", "parents": ["02a4c08858f656a2d479ee915b81713dc35f6016"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078876 - Show the current page's speculative loading status. r=bomsy,fluent-reviewers,devtools-reviewers,bolsson\n\nExpose activatedFromNavigationalPrefetch on dom-loading document resources\nfrom the current document channel's loadInfo. Use it in the Application\npanel to distinguish a navigation served from prefetch from a normal load,\nincluding when DevTools opens after navigation.\n\nReset the status on navigation, ignore subframe events, and preserve the\nstatus when updating the page domain. Show an unavailable state when the\nserver does not provide the signal. This does not rely on the web-exposed\ndeliveryType API or infer activation from an ordinary HTTP cache hit.\n\nAdd browser coverage for activation, no-store responses, failed prefetches,\niframe isolation, reopening DevTools, history restoration and reload, plus\ndocument-resource and reducer checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334680\n", "files": ["devtools/client/application/initializer.js", "devtools/client/application/src/actions/page.js", "devtools/client/application/src/components/speculative-loads/SpeculativeLoads.css", "devtools/client/application/src/components/speculative-loads/SpeculativeLoadsPage.js", "devtools/client/application/src/constants.js", "devtools/client/application/src/reducers/page-state.js", "devtools/client/application/test/browser/browser.toml", "devtools/client/application/test/browser/browser_application_panel_speculative-load-status.js", "devtools/client/application/test/browser/resources/speculative-loads/prefetch-status.sjs", "devtools/client/application/test/xpcshell/test_page_reducer.js", "devtools/client/locales-preview/speculative-loads.ftl", "devtools/server/actors/resources/document-event.js", "devtools/shared/commands/resource/tests/browser_resources_document_events.js"], "git_node": "48cf0e700536e2c07ecebbb332231ad125870271", "git_parents": ["5e16dfe8613dd6b8dbe866afd941f42057443e0e"], "node": "b1632b91ba0e273e0aa14831639b88a89e9c791a", "parents": ["2e57f0eec64cde686e3fee5a4b3d0bcbe962ab6d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082368 - Load search-mode and one-off engine searches through the address bar's regular load path. r=daleharvey,urlbar-reviewers\n\nThis restores what these searches lost when they started calling openSERP: the input reverts and the view closes when the SERP opens elsewhere, the content area takes focus before a new-tab load, a current-tab Enter defers that focus to keyup, and urlbar-user-start-navigation fires.\n\nopenSERP's tracksBounce had no other caller; #loadURL always sets initiatedByURLBar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336239\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser-search/browser_oneOffs_keyModifiers.js", "browser/components/urlbar/tests/browser-searchMode/browser_heuristic.js"], "git_node": "253f94efc7e6f073eb8bc9ed340928a2f16598ef", "git_parents": ["48cf0e700536e2c07ecebbb332231ad125870271"], "node": "f18885397466252e3c06efcade34022076fb6623", "parents": ["b1632b91ba0e273e0aa14831639b88a89e9c791a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084270 - Stop applying ancestor clips outside popups in intersection observations. r=emilio,layout-reviewers\" for causing mochitest failures @ test_intersectionobserver_popup.xhtml\n\nThis reverts commit 09284977af1bf2ecb3db36b8d6d5fd2d6fc2bb9a.\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/base/test/chrome/chrome.toml", "dom/base/test/chrome/file_intersectionobserver_popup.xhtml", "dom/base/test/chrome/test_intersectionobserver_popup.xhtml"], "git_node": "d9098b3e11c2fbc2b2d84e53a3c784814cbdab3e", "git_parents": ["253f94efc7e6f073eb8bc9ed340928a2f16598ef"], "node": "6394817c482c7ed8baa4021802f4f231315ef0be", "parents": ["f18885397466252e3c06efcade34022076fb6623"], "tags": []}], "date": 1793048683, "git_changesets": ["7047d10e753dbe19aa1be3c1cf0342cf7a6d9d15", "fcb2bd8874bbec0cb26bd9e41e9427a5f5368505", "446681633109d634383953864e5e4c1841b4f183", "f4475d522a45a452feb31fbf2cec6be15d8a5a6c", "e221741e040ce5be8478768b5d2c88b572f344e4", "3d38dd2ac6a0d13b9acd5f3c20d5563863022545", "742327194805e5ad2ff8d24d1215666cb82bcb8a", "e017387ca3ebc509055be29a670e497661f4b2bc", "ce6d1ba68b263fbe7b606bd6b498dfa62ae501cf", "6391882387da0a8be304d2ca19a9e64523e85838", "9b5528b8432cb2b1abed72cecca37693f7f9b420", "05d3f680ab526c2c0d4571b770a488c36edffc8c", "ca3da38c7757f7f64aa8084d37408700a8086666", "079338aef0f429e33c7b5bf30f3e791197456971", "17fdf0b741cf50c38e7303eb44fc0f0683e930c4", "fbdbf6038726125b7358497806b39e190f5e359d", "05c1e17fa662365ae9fd2d9798251ad138c9fd7b", "9d07f650bba6035a764e404efd11134fe52922a0", "b83ccb49dc67ac65c799ee98ac4ccdf3c9c20fe8", "c0a1ae242007d6546c91a7e9c9e7c1a8fe7113b1", "d8cecc70e6066b78dadc0847de9d85f574eecbcb", "4ed68a8945f9d98ae0562aa7f8af04cba8d76e7b", "b3120b9942ec8d074e3b976a00df96b3f121f391", "46d5b7d4b47d0a3a8930bc76facf860d62edb6e5", "f226e0ce1a48550e2842127ce66d4dd3e9149c82", "6de0355ce40cd4e776357ca41f3d8e2aed037330", "239b013c44c045da7b3851d44a886f6c02ea780d", "96772a8c796e88d258b0e921b6448c9643200a62", "6099c3f67c3208cd3eced671bbdd95ec8ab8af50", "42d816565fcf410ef80392dbb614211b2e4d164d", "e11c558e4f31208bf28d0110cea33590592adcdc", "336321c3eb678390c7af587b24eed509db442818", "c6fddb63e3cdbabd13f978b91d55ee9b6d096bda", "06989e9d27452c23d3ea750a3314d4557ea10b87", "6ee822ddd28e6e1c81e2b170743e63e3b5b08143", "4b3d335268f3a0edbf59596c9362267697694946", "f64d190f80af84cc676d67014fbc96177d18ab6e", "e227f17ea6811f94a3a472d210ec23c9370b8c91", "044beb56c73a37207fe5931b7abcd8ee80517689", "f1d204e48904092d4a9fd76092e7cd609ba92479", "e0c84326fb0c09252aa505c1e1111b319d10a288",