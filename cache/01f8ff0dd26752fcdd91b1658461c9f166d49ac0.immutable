d6ade7a653e85c9ec\nur -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\nuz -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\nvi -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\nwo -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\nxh -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\nzam -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\nzh-CN -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\nzh-TW -\u003e adc5c236f2445b2ee703e8cd6ade7a653e85c9ec\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "245a71c6cf2d0744ade6a45b033f74a3967c9a79", "git_parents": ["2c761f20c65c31131da6d6cb4e563ce2ca4239db"], "node": "5be9ad7b18e25fc7e66ad50aebec5169525f52d0", "parents": ["c644a99855b480b29fae89f5895cbbe6f8695c26"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083941 - Release JavaCallbackDelegate's Java callback after it is invoked r=m_kato,geckoview-reviewers\n\nThis commit allows the global JNI callback reference to be released after either the success or error terminal state is reached.\n\nMoving the EventCallback makes it nullified/deleted as soon as `Call()` returns, thereby allowing Java's JavaCallbackDelegate and CallbackResult to become eligible for garbage collection after the callback result is returned on the Android side.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335518\n", "files": ["widget/android/EventDispatcher.cpp"], "git_node": "bddbe3e4cbf33f88bf13370dd8ff550aa8c507b6", "git_parents": ["245a71c6cf2d0744ade6a45b033f74a3967c9a79"], "node": "92ccaa5f4d834e17541443d47bc0546a9edbd843", "parents": ["5be9ad7b18e25fc7e66ad50aebec5169525f52d0"], "tags": []}, {"author": "Dimi Lee \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086235 - Add the security code field to credit card form telemetry. r=credential-management-reviewers,mtigley\n\nRecord cc_csc in the detected, filled, filled_on_fields_update and submitted\ncc_form_v2 events so checkout forms that ask for a security code, and whether\nit is filled, can be measured.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337463\n", "files": ["browser/extensions/formautofill/test/browser/browser_dynamic_form_telemetry.js", "browser/extensions/formautofill/test/browser/browser_ml_ignore_field_types.js", "browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_telemetry_autofill.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_telemetry_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_telemetry_submit_new.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_telemetry_submit_update.js", "browser/extensions/formautofill/test/browser/creditCard/browser_telemetry_utils.js", "toolkit/components/formautofill/metrics.yaml", "toolkit/components/formautofill/shared/AutofillTelemetry.sys.mjs"], "git_node": "881dec2ef18b9ea033f5f868fc0e8178226530d1", "git_parents": ["bddbe3e4cbf33f88bf13370dd8ff550aa8c507b6"], "node": "b683b08ecb974d406786641f5fc16ff75aea1f42", "parents": ["92ccaa5f4d834e17541443d47bc0546a9edbd843"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2086499 - Add branchTestNullOrUndefined and test both tags at once on arm64 and x64. r=iain\n\nNull and undefined differ in a single tag bit and the other two type codes\nwith the same upper bits are unused, so one comparison of the Value's bits\nabove that one tells whether it is either of them. The JITs test the pair\nat a dozen sites (loose equality with null, the Coalesce and\nIsNullOrUndefined ops, CheckObjCoercible, the guards for optional chains\nand the truthiness tests) as two tag compares with two branches.\n\nThis adds branchTestNullOrUndefined to the MacroAssembler and uses it at\nthose sites. The ValueOperand form shifts the Value and compares once on\narm64 and x64; the Register form, for callers that have extracted the tag\nfor further tests, uses ccmn on arm64 to keep a single branch. The other\nbackends emit the two compares as before.\n\nThe test of the Coalesce operand in Ion was, on arm64,\n\n  asr x16, x0, #47\n  cmn w16, #12\n  b.eq nullOrUndefined\n  cmn w16, #10\n  b.eq nullOrUndefined\n\nand becomes\n\n  asr x16, x0, #49\n  cmn w16, #3\n  b.eq nullOrUndefined\n\nand on x64 it was\n\n  movq %rax, %r11\n  shrq $47, %r11\n  cmpl $0x1fff4, %r11d\n  je nullOrUndefined\n  cmpl $0x1fff6, %r11d\n  je nullOrUndefined\n\nand becomes\n\n  movq %rax, %r11\n  shrq $49, %r11\n  cmpl $0x7ffd, %r11d\n  je nullOrUndefined\n\nThe CacheIR stub for loose equality with null goes on to test for an\nobject, so it keeps the extracted tag; on arm64 it was\n\n  asr x16, x0, #47\n  cmn w16, #12\n  b.eq equal\n  cmn w16, #10\n  b.eq equal\n  cmn w16, #4\n  b.ne notEqual\n\nand becomes\n\n  asr x16, x0, #47\n  cmn w16, #12\n  ccmn w16, #10, #4, ne\n  b.eq equal\n  cmn w16, #4\n  b.ne notEqual\n\nwhile x64 keeps the two compares there.\n\nIn the code compiled during a JetStream 3 run on arm64, the ValueOperand\nform replaces the pair of tests at 5,501 Ion and 2,157 Baseline sites, two\ninstructions fewer each with one of them a branch, and the ccmn form at\n10,462 Ion and 26 Baseline sites, a branch fewer each. Ion still tests null\nand then undefined at 2,491 sites, all in loadAtomOrSymbolAndHash, which\nmaps the two to different atoms.\n\nValue.h documents the layout constraint and asserts it, and\nValue::isNullOrUndefined uses the same test: the compiler turns its two\ncompares into a mask and a compare against a 64-bit constant, where the\nshift and compare against a small constant save an instruction on arm64\nand two 10-byte immediates on x64.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337469\n", "files": ["js/public/Value.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared-inl.h", "js/src/jit/mips64/MacroAssembler-mips64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/x64/MacroAssembler-x64-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86/MacroAssembler-x86-inl.h"], "git_node": "37f6aa6605c57c500ad1fa9fe03fdf77439fefac", "git_parents": ["881dec2ef18b9ea033f5f868fc0e8178226530d1"], "node": "f5e125ec7cca2144c010ff625c8166e596dafbf8", "parents": ["b683b08ecb974d406786641f5fc16ff75aea1f42"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085703 - Keep building when the build priority cannot be changed r=firefox-build-system-reviewers,glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336906\n", "files": ["python/mozbuild/mozbuild/build_commands.py"], "git_node": "49761cde2119a67aae24ea5504f5e2a443799726", "git_parents": ["37f6aa6605c57c500ad1fa9fe03fdf77439fefac"], "node": "0388b22fc18c9389a6b41c935f599c55c22e7e69", "parents": ["f5e125ec7cca2144c010ff625c8166e596dafbf8"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086876 - Add missing nightly equivalent to the linux64-rust-android-1.95-dev task. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337818\n", "files": ["taskcluster/kinds/toolchain/rust.yml"], "git_node": "849ad2820aad2f9f2004231dc96075599885e113", "git_parents": ["49761cde2119a67aae24ea5504f5e2a443799726"], "node": "956c382cfe9184c011dce6c1bc122e29702c7dc3", "parents": ["0388b22fc18c9389a6b41c935f599c55c22e7e69"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086891 - Set library search paths for Rust tests independently of Cargo output layout. r=firefox-build-system-reviewers,sergesanspaille\n\nCargo 1.99 enables build-dir layout v2 by default on the dev and nightly\nchannels (https://github.com/rust-lang/cargo/pull/17258). Test\nexecutables move out of the deps directory, which Cargo no longer\nincludes in the runtime library search path, leaving the staged native\nlibraries undiscoverable.\n\nUse dist/bin through LD_LIBRARY_PATH on Linux and PATH on Windows\ninstead of copying libraries into Cargo output directories. This also\ncovers transitive NSS dependencies that the test executable RUNPATH does\nnot resolve.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337831\n", "files": ["python/mozbuild/mozbuild/action/run_cargo.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/action/test_run_cargo.py", "python/mozbuild/mozbuild/test/test_rust_commands.py"], "git_node": "df88b7ae33da7b86ac79d98c5380021ddb6668ee", "git_parents": ["849ad2820aad2f9f2004231dc96075599885e113"], "node": "c03aa015727cec0a2505d7a13f2f5363f747ff72", "parents": ["956c382cfe9184c011dce6c1bc122e29702c7dc3"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082021 - Fix misplaced TEMP_COPY issue. r=gfx-reviewers,bradwerth\n\n(Based on AI-suggested patch, tweaked to account for the recent change\nin bug 2082181 having landed.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337590\n", "files": ["gfx/graphite2/geckoextra/patches/0002-temp-copy.patch", "gfx/graphite2/moz.yaml", "gfx/graphite2/src/Code.cpp", "gfx/graphite2/src/Slot.cpp", "gfx/graphite2/src/call_machine.cpp", "gfx/graphite2/src/direct_machine.cpp", "gfx/graphite2/src/inc/opcodes.h"], "git_node": "62ace7d3ce20822802a0c92730b482472ea8905e", "git_parents": ["df88b7ae33da7b86ac79d98c5380021ddb6668ee"], "node": "ce41af33b56d94f2a05b077f258e62b9d55ee050", "parents": ["c03aa015727cec0a2505d7a13f2f5363f747ff72"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086932 - Update android nightly application-services version bump to 50b768862de10b0d89dd6389afbda7a8a48c771e r=release-managers,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337861\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "035f70ac3a2fdd8983278dbbf0dc774d4732ebaf", "git_parents": ["62ace7d3ce20822802a0c92730b482472ea8905e"], "node": "362b262263e37d5aa04b412392719f7894802c41", "parents": ["ce41af33b56d94f2a05b077f258e62b9d55ee050"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081421 - Fix generating crash reports via the WER runtime exception module r=afranchuk,crashreporting-reviewers\n\nThis fixes two separate issues that had arised by previous refactorings\nof the crash reporter code. The first is that since we switched to a\npull model for transfering handles the WER runtime exception module\ncouldn't send the process and thread handles to the crash helper\nanymore. This is solved by replacing them with process and thread ids\nwhich we know remain valid as the corresponding handles remain open in\nthe WER runtime exception module until the crash helper is done dumping\nthe process. The second issue is that the crash report that the helper\ngenerated was not being properly recorded, so when the main process\nreached out for it, it wouldn't find it, leaving behind an orphaned\ncrash report.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335704\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs", "toolkit/crashreporter/mozwer-rust/lib.rs"], "git_node": "a1965d04d9a45b2e45a9d6c69a3d2f93e0bb83cf", "git_parents": ["035f70ac3a2fdd8983278dbbf0dc774d4732ebaf"], "node": "cc6db8e9b626a30400014a6623bd0db8fd64b4b3", "parents": ["362b262263e37d5aa04b412392719f7894802c41"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086115 - use gecko_decision:6.0.0 docker image. r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337667\n", "files": [".taskcluster.yml", "taskcluster/docker/decision/HASH", "taskcluster/docker/decision/VERSION"], "git_node": "5a87e8dc83ac436279d8370f3dd33998396a430d", "git_parents": ["a1965d04d9a45b2e45a9d6c69a3d2f93e0bb83cf"], "node": "8afd0aab4ad525f5fb79dc7cddec5aff18ee7afd", "parents": ["cc6db8e9b626a30400014a6623bd0db8fd64b4b3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950363 - Remove GECKOVIEW relbranch support from beetmover-geckoview. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nGECKOVIEW_*_RELBRANCH has not been used since 81 in 2020. Without it,\nbeetmover-geckoview only runs in nightly and firefox-android ship graphs,\nso its shipping phase can be ship everywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337588\n", "files": ["taskcluster/gecko_taskgraph/transforms/beetmover_geckoview.py", "taskcluster/kinds/beetmover-geckoview/kind.yml", "taskcluster/test/params/mr-onpush-geckoview.yml"], "git_node": "845f079b4e731f1c0a79aaf7b8d3135b932242e4", "git_parents": ["5a87e8dc83ac436279d8370f3dd33998396a430d"], "node": "c7e4553dc3bfc6c0f4ffa18d6c487bb62dc9d80c", "parents": ["8afd0aab4ad525f5fb79dc7cddec5aff18ee7afd"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950363 - Use firefox-android as the shipping product for android gecko tasks. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nfirefox-android is what the rest of the android tasks and release promotion\nuse. This lets the generic ship phase filter pick up beetmover-geckoview, so\nthe special case for it can go, along with the unused fennec product.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337589\n", "files": ["taskcluster/android_taskgraph/target_tasks.py", "taskcluster/config.yml", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/generate-profile/kind.yml", "taskcluster/kinds/instrumented-build/kind.yml"], "git_node": "6b8b686f417b2f057c3d3cccbeeb5854ba29f241", "git_parents": ["845f079b4e731f1c0a79aaf7b8d3135b932242e4"], "node": "8c16d2ebf7e9f644e588e27151a41c511e328d7e", "parents": ["c7e4553dc3bfc6c0f4ffa18d6c487bb62dc9d80c"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085619 - Record PAGE_LOADING as its own BFCache combo telemetry label r=smaug\n\nAdding PAGE_LOADING instead of having that fall under\nOTHER.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326150\n", "files": ["docshell/base/metrics.yaml", "docshell/base/nsDocShell.cpp"], "git_node": "49a6f6ae9dfb263007363852962096577253a487", "git_parents": ["6b8b686f417b2f057c3d3cccbeeb5854ba29f241"], "node": "48805f61eee37b837c9a5253bc15b0fcde69f819", "parents": ["8c16d2ebf7e9f644e588e27151a41c511e328d7e"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2076170 - Fallible MarkPagesInUseHard on Linux r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335070\n", "files": ["js/src/gc/Memory.cpp"], "git_node": "5e99ff18da9824a27eccaf4aaee95ffc7c204cd1", "git_parents": ["49a6f6ae9dfb263007363852962096577253a487"], "node": "70bb6b1cd897fd94c6e875832d2500b5a1d91235", "parents": ["48805f61eee37b837c9a5253bc15b0fcde69f819"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085764 - Part 1: Split out AssertIsBufferAlloc and rename IsBufferAlloc to indicate preconditions r=spidermonkey-reviewers,iain\n\nIsBufferAlloc can return false positives or crash when passed non-GC memory.\nRename it to indicate when kind of pointers it accepts.\n\nI think it's OK for AssertIsBufferAlloc to call this as the pointer is expected\nto be a buffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336727\n", "files": ["js/src/gc/Allocator.h", "js/src/gc/BufferAllocator-inl.h", "js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/Nursery.cpp", "js/src/jsapi-tests/testGCAllocator.cpp", "js/src/vm/NativeObject.cpp", "js/src/wasm/WasmGcObject.cpp"], "git_node": "18d66cf7081803eb5b5bdd014202993252b3d728", "git_parents": ["5e99ff18da9824a27eccaf4aaee95ffc7c204cd1"], "node": "7cc53dcaf60e540277665bb7bde8be1743dd1694", "parents": ["70bb6b1cd897fd94c6e875832d2500b5a1d91235"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085764 - Part 2: Fix spurious rooting hazard in WeakMapObject r=spidermonkey-reviewers,iain\n\nThis is not currently unsafe as the buffer is held live by the obect in this\nregion and we don't move buffers but it is reported as a rooting hazard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336728\n", "files": ["js/src/builtin/WeakMapObject.cpp"], "git_node": "00fd454cd7439c00d7e2804dd6dd37ce36ef5ad7", "git_parents": ["18d66cf7081803eb5b5bdd014202993252b3d728"], "node": "8fa80cd08947ac902b904c283713e159a3dcfadc", "parents": ["7cc53dcaf60e540277665bb7bde8be1743dd1694"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085764 - Part 3: Integrate buffer allocator buffers into hazard analysis r=spidermonkey-reviewers,iain\n\nThis adds a base class for (most) buffer allocations to allow the harzard\nanalysis to see that these are GC pointers.\n\nUnfortunately since this class has no data members we also haver to add the\nMOZ_EMPTY_BASES attribute on derived classes to avoid build errors on Windows.\n\nNot all buffer allocators are annotated. Object slots and elements can be other\nkinds of allocations too so these are not checked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336729\n", "files": ["js/src/builtin/WeakMapObject.h", "js/src/gc/Allocator-inl.h", "js/src/gc/Allocator.h", "js/src/gc/ZoneAllocator.h", "js/src/jsapi-tests/testGCAllocator.cpp", "js/src/vm/JSScript.h", "js/src/vm/Scope.h"], "git_node": "02826d296d550199e2cee33b6f0d9900ac2588aa", "git_parents": ["00fd454cd7439c00d7e2804dd6dd37ce36ef5ad7"], "node": "975d916abe663e94fa755530251b53afa33ad75a", "parents": ["8fa80cd08947ac902b904c283713e159a3dcfadc"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085764 - Part 4: Allow assignment to RootedBuffer r=spidermonkey-reviewers,dminor\n\nThis also removes makes the zone field debug-only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335669\n", "files": ["js/src/gc/Allocator.h", "js/src/gc/Tracer.h"], "git_node": "2d72d38d25f4b4f461beb26aeff2e52eb9c6c6a1", "git_parents": ["02826d296d550199e2cee33b6f0d9900ac2588aa"], "node": "aebb17a6595517ac0d1406621c9c2b74ad1fc454", "parents": ["975d916abe663e94fa755530251b53afa33ad75a"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085764 - Part 5: Make buffer trace methods return the traced buffer to avoid race during concurrent marking r=spidermonkey-reviewers,dminor\n\nDuring concurrent marking we need to read the buffer pointer once only an\natomic read. Since the caller has to trace the buffer we need to return the\npointer we read after tracing the buffer edge.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335670\n", "files": ["js/public/TracingAPI.h", "js/src/gc/Allocator.h", "js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp", "js/src/gc/Tenuring.cpp", "js/src/gc/Tenuring.h", "js/src/gc/Tracer.h"], "git_node": "baab1604501075e1a76c6a47e766168dc1095811", "git_parents": ["2d72d38d25f4b4f461beb26aeff2e52eb9c6c6a1"], "node": "41a10959314498591e1ee58761ae10a101b2965b", "parents": ["aebb17a6595517ac0d1406621c9c2b74ad1fc454"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085764 - Part 6: Fix rooting hazard in test code r=spidermonkey-reviewers,iain\n\nThis removes use of the unrooted 'vector' ref after a possible GC in the\ntestBufferAllocPolicy_vector test.\n\nIt's not currently safe to root nursery-owned buffers as the\nnursery/tenured-owned state can change, and this needs to match whatever GC\nthing owns it or will own it. Currently we don't have root nursery-owned\nbuffers.\n\nThe patch adds assertions to make sure we don't do this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336730\n", "files": ["js/src/gc/Allocator.h", "js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "d3b62222a2eda286437374d01595d05352f0ffa6", "git_parents": ["baab1604501075e1a76c6a47e766168dc1095811"], "node": "dafe9f1883b8b3e2b2a5a13b9b39bf1480e108cc", "parents": ["41a10959314498591e1ee58761ae10a101b2965b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "No bug - Fix expect() message to reference the right name. DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337893\n", "files": ["servo/ports/geckolib/glue.rs"], "git_node": "41e14c5b542be75b29358330fc63e9b6acadccd4", "git_parents": ["d3b62222a2eda286437374d01595d05352f0ffa6"], "node": "62a636bf54fd9efac88fe496590d59accde8e464", "parents": ["dafe9f1883b8b3e2b2a5a13b9b39bf1480e108cc"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074838 - Don't split UTF-8 characters when truncating filenames in nsWebBrowserPersist. r=mak\n\nFilenames were truncated by byte count, which could cut a multi-byte\ncharacter in half. The resulting name was invalid UTF-8 and the\nresource was not saved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335644\n", "files": ["dom/tests/browser/browser_persist_filename.js", "dom/webbrowserpersist/nsWebBrowserPersist.cpp"], "git_node": "6339fb2de4886dd4c9e015f1b80937c2b0aef48f", "git_parents": ["41e14c5b542be75b29358330fc63e9b6acadccd4"], "node": "fcf8542a6c7b75acb2dbeab136a6c63708b5a937", "parents": ["62a636bf54fd9efac88fe496590d59accde8e464"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086969 - Use the firefox repo as backing repo for the toolchains project branch. r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337884\n", "files": ["taskcluster/gecko_taskgraph/decision.py"], "git_node": "1b4ebc594a6120ec04a8abebedf14e8a1c494746", "git_parents": ["6339fb2de4886dd4c9e015f1b80937c2b0aef48f"], "node": "a093224d9b3bb9f4d3008908580b0e1162ed23f9", "parents": ["fcf8542a6c7b75acb2dbeab136a6c63708b5a937"], "tags": []}, {"author": "any1here \u003cany1here@duck.com\u003e", "branch": "default", "desc": "Bug 2086917 - Fix stale refresh-profile Fluent ID in Safe Mode r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337848\n", "files": ["browser/base/content/safeMode.xhtml"], "git_node": "f164a6b4d8be5dcc40f4d2e5e1e06bca79b6fbac", "git_parents": ["1b4ebc594a6120ec04a8abebedf14e8a1c494746"], "node": "bad517386f18b990bb45194bda2e259b5d69d901", "parents": ["a093224d9b3bb9f4d3008908580b0e1162ed23f9"], "tags": []}, {"author": "Christophe Henry \u003ccontact@c-henry.fr\u003e", "branch": "default", "desc": "Bug 1627479 - Linux: add nsWindowMediator::GetMostRecentBrowserAppWindow API to make Minimize to tray work on Linux, too r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332692\n", "files": ["xpfe/appshell/nsIWindowMediator.idl", "xpfe/appshell/nsWindowMediator.cpp"], "git_node": "24486c0b75d9ca6bbff1f95a5ec059a9e17cb57b", "git_parents": ["f164a6b4d8be5dcc40f4d2e5e1e06bca79b6fbac"], "node": "8be865a1dcd0a7b4dfdb5aef6641bf4728686853", "parents": ["bad517386f18b990bb45194bda2e259b5d69d901"], "tags": []}, {"author": "Christophe Henry \u003ccontact@c-henry.fr\u003e", "branch": "default", "desc": "Bug 1627479 - Implement AppWindow::GetVisibility and fix AppWindow::SetVisibility() to avoid CPU load of 10-15% when window goes invisible. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337092\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "dom/base/test/app_window.js", "dom/base/test/browser.toml", "xpfe/appshell/AppWindow.cpp"], "git_node": "178c81a47b8192ddc656fe0901752eefc81a27e1", "git_parents": ["24486c0b75d9ca6bbff1f95a5ec059a9e17cb57b"], "node": "6214296c1e978633f5cc9d041043cac5337f9ac1", "parents": ["8be865a1dcd0a7b4dfdb5aef6641bf4728686853"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086260 - Ensure RenderCompositorOGLSWGL::SurfaceOriginIsTopLeft() returns false. r=gfx-reviewers,bradwerth\n\nIt was returning true because RenderCompositorLayersSWGL overrode\nit. Move that override to RenderCompositorD3D11SWGL where it belongs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337636\n", "files": ["gfx/webrender_bindings/RenderCompositorD3D11SWGL.h", "gfx/webrender_bindings/RenderCompositorLayersSWGL.h"], "git_node": "14ff0a926b18389ff53e6f87494b9a400b22bee1", "git_parents": ["178c81a47b8192ddc656fe0901752eefc81a27e1"], "node": "0f1a7e1f0c66b63b1327326e40ea2ef774dcf75b", "parents": ["6214296c1e978633f5cc9d041043cac5337f9ac1"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086260 - Share Android screen capture implementation between hardware and software webrender. r=gfx-reviewers,bradwerth\n\nRemove the code duplication by moving the Android screen capture\nimplementation into a shared helper function in\nRenderCompositor. RenderCompositor::MaybeCaptureScreenPixels() now\n*always* captures pixels, so can drop the \"Maybe\" prefix. Also, we can\nnow return whether the capture was actually succesful rather than\nwhether the RenderCompositor implementation is responsible for\ncapturing or whether it should be handled by RendererOGL instead.\n\nRenderCompositorEGL and RenderCompositorOGLSWGL now simply override\nthis function and call the shared helper, and RendererOGL now has no\nadditional work to do.\n\nNote we use a shared helper rather than a RenderCompositor base class\nimplementation to ensure that RenderCompositorOGLSWGL's compositor GL\ncontext is used rather than its SWGL context.\n\nRenderCompositorOGLSWGL's previous implementation had a fallback path\nfor when GLFeature::framebuffer_blit is unavailable. This is now\npresent in the hardware webrender path too, though in practice we\ncan't be running hardware webrender without this feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337637\n", "files": ["gfx/webrender_bindings/RenderCompositor.cpp", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/RenderCompositorEGL.h", "gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "gfx/webrender_bindings/RenderCompositorOGLSWGL.h", "gfx/webrender_bindings/RendererOGL.cpp"], "git_node": "14abf3ed1f84533dbb567814b9c45141fdcab50e", "git_parents": ["14ff0a926b18389ff53e6f87494b9a400b22bee1"], "node": "65b5a8bdfa48d9e53b33432a4f109e9af9580055", "parents": ["0f1a7e1f0c66b63b1327326e40ea2ef774dcf75b"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086260 - Use fallback Android screen pixels capture path when required extensions are missing. r=gfx-reviewers,bradwerth\n\nWe previously only checked for GLFeature::framebuffer_blit, but in\npractice the fast path additionally requires:\n\n* GL_OES_EGL_image\n* EGL_KHR_fence_sync\n* EGL_ANDROID_native_fence_sync\n\nWe were seeing crashes on Android emulators running on hosts with ATI\nGPUs, due to disabling GL_OES_EGL_image on such devices.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337638\n", "files": ["gfx/webrender_bindings/RenderCompositor.cpp"], "git_node": "2ba4cce476adc7b920c4748237e58e7c925f9d4e", "git_parents": ["14abf3ed1f84533dbb567814b9c45141fdcab50e"], "node": "2b996914f8b659013b8f20c5a33619edabf1b263", "parents": ["65b5a8bdfa48d9e53b33432a4f109e9af9580055"], "tags": []}, {"author": "Oskar Mansfeld \u003comansfeld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083038 - Expose QUIC ABE (RFC 8511) as a Firefox and Nimbus pref. r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337538\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/socket/neqo_glue/src/lib.rs", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "3e745f959dcaeee24344579e92bb0b9f40f97e09", "git_parents": ["2ba4cce476adc7b920c4748237e58e7c925f9d4e"], "node": "e1dca19d64fccc731aaa0512606be2a4f5cda186", "parents": ["2b996914f8b659013b8f20c5a33619edabf1b263"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086587 - Create the blob upload directory before mozharness test scripts write to it. r=releng-reviewers,bhearsum\n\nSome writers relied on the resource monitor creating it after\ncreate-virtualenv, so the resource monitor goes back to only creating it\nfor its own profile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337572\n", "files": ["testing/mozharness/mozharness/base/python.py", "testing/mozharness/mozharness/mozilla/testing/per_test_base.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/scripts/devtools_compat.py"], "git_node": "e83ec1e74bf1028e1eb4aa87b1965746434947c5", "git_parents": ["3e745f959dcaeee24344579e92bb0b9f40f97e09"], "node": "8d412d8573d6bb0918d7eaf4e578989f5bca1088", "parents": ["e1dca19d64fccc731aaa0512606be2a4f5cda186"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083603 - Don't warn when HTMLEditor can't find an editing host because nothing is selected or focused. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335259\n", "files": ["editor/libeditor/HTMLEditor.cpp"], "git_node": "4ecd8443cd3c19a8b9979a2bd6217a47ef2e2425", "git_parents": ["e83ec1e74bf1028e1eb4aa87b1965746434947c5"], "node": "ac45b14e6f2fbf06427de423b2924a56ae17ac1c", "parents": ["8d412d8573d6bb0918d7eaf4e578989f5bca1088"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1882642 - Clean up MockFilePicker in browser_aboutdebugging_addons_temporary_install_path.js, r=devtools-reviewers,nchevobbe.\n\nMockFilePicker.showCallback kept the picker, and through it the about:debugging window, alive until shutdown. This only leaks in standalone runs, where no later MockFilePicker.init() resets the callback (skip-if from bug 2026756).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337696\n", "files": ["devtools/client/aboutdebugging/test/browser/browser.toml", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_temporary_install_path.js"], "git_node": "ab952ec92a84fe1c05076fbb336dd45bfb4684f9", "git_parents": ["4ecd8443cd3c19a8b9979a2bd6217a47ef2e2425"], "node": "06b99ff1bcd1f940cffc9d2afeb624a2760029d2", "parents": ["ac45b14e6f2fbf06427de423b2924a56ae17ac1c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1938697 - Name unnamed groups synchronously in the all tabs menu, r=tabbrowser-reviewers,jsudiaman.\n\nUnnamed open group rows only got their label after an extra async formatValues call, so the panel could show with a blank group label. Use the group's cached defaultGroupName instead, also in the groups section, which had the same async hop.\n\nThis was the Linux opt failure of bug 2028649. Its Windows opt timeout no longer reproduces, so the skip-if is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337697\n", "files": ["browser/components/tabbrowser/GroupsList.sys.mjs", "browser/components/tabbrowser/TabsList.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml"], "git_node": "8cb74bb2eb27dfeb22f056185fd57d245dbdab73", "git_parents": ["ab952ec92a84fe1c05076fbb336dd45bfb4684f9"], "node": "e4fb6dd1a2b176c949aab8869083a6514a354369", "parents": ["06b99ff1bcd1f940cffc9d2afeb624a2760029d2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1932027 - Check which child processes run only once test_memoryReporters2.xhtml's content processes are up, r=mccr8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337699\n", "files": ["toolkit/components/aboutmemory/tests/chrome.toml", "toolkit/components/aboutmemory/tests/test_memoryReporters2.xhtml"], "git_node": "d68c5bf93edc81226b9f483a3deded7487fc457f", "git_parents": ["8cb74bb2eb27dfeb22f056185fd57d245dbdab73"], "node": "bee5ee691dfb13bdd2e87adffc037c4d46c6850c", "parents": ["e4fb6dd1a2b176c949aab8869083a6514a354369"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2026600 - Check pageX/pageY against the scroll position in test_bug443985.html, r=dom-core-reviewers,smaug.\n\nThe test required pageX \u003e 3000, which the page cannot scroll far enough to reach when the test frame is wider than about 1000px, as it is in the standalone variant. The comparison allows a difference under 1px because on HiDPI macOS scrollX/scrollY can be fractional while MouseEvent.pageX/pageY are integers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337704\n", "files": ["dom/events/test/mochitest.toml", "dom/events/test/test_bug443985.html"], "git_node": "15ce030d438b318071f000394098061f184ef0fa", "git_parents": ["d68c5bf93edc81226b9f483a3deded7487fc457f"], "node": "698364b1bb00169d7d7d7b820f1106661d706c30", "parents": ["bee5ee691dfb13bdd2e87adffc037c4d46c6850c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086756 - Compare subframe displayports to their visible height in test_layerization.html, r=gfx-reviewers,bradwerth.\n\ninner2 and inner4 are clipped by their parent, so their displayport is built from the visible rect and doesn't grow with the window.\nThe standalone jobs' taller window (innerHeight 951) pushed the old min(clientHeight, innerHeight) threshold above it, so this removes the standalone skip added in bug 2026600.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337709\n", "files": ["gfx/layers/apz/test/mochitest/mochitest.toml", "gfx/layers/apz/test/mochitest/test_layerization.html"], "git_node": "ec0337a9092e2b46b2c9f07f04da76640d604524", "git_parents": ["15ce030d438b318071f000394098061f184ef0fa"], "node": "601dc978ba5dd09eed9e2971bf71cfdf6e1c436b", "parents": ["698364b1bb00169d7d7d7b820f1106661d706c30"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1920615 - Wait for the controls' icons to be decoded before snapshotting in the videocontrols direction tests, r=firefox-desktop-core-reviewers ,mossop.\n\nOnly the first test page of a fresh browser has a cold image cache, which is why this failed consistently in the standalone variant (bug 2026600, and bug 1920614 for the video test) and rarely otherwise. The xorigin failures were the same cold image cache failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337698\n", "files": ["toolkit/content/tests/widgets/mochitest.toml", "toolkit/content/tests/widgets/videocontrols_direction_test.js"], "git_node": "d6b9668f5e57b43e07ce4d261ddd5774acabfdfd", "git_parents": ["ec0337a9092e2b46b2c9f07f04da76640d604524"], "node": "0f87bf6062e76c8d8e1f3f6d6e2b51a2da443aa4", "parents": ["601dc978ba5dd09eed9e2971bf71cfdf6e1c436b"], "tags": []}, {"author": "Logan Rosen \u003cloganrosen@gmail.com\u003e", "branch": "default", "desc": "Bug 2083543 - Use a non-capturing string token pattern in manifestparser's expression scanner. r=jcristau\n\nPython 3.15 makes re.Scanner reject lexicon patterns containing capturing\ngroups, which broke parsing of every manifest condition. The groups in the\nstring token pattern were unused, since Scanner callbacks only receive the\nmatched text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336961\n", "files": ["testing/mozbase/manifestparser/manifestparser/expression.py"], "git_node": "9a1535227ce2f95390108747658ad3d0541db259", "git_parents": ["d6b9668f5e57b43e07ce4d261ddd5774acabfdfd"], "node": "42032a1b59af819343d532541451ca27ba565fb1", "parents": ["0f87bf6062e76c8d8e1f3f6d6e2b51a2da443aa4"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2085650 - Back out bug 1972313 for stalling AAC metadata loading over the network. r=media-playback-reviewers,alwu\n\nADTSTrackDemuxer::Init() scans up to 20000 frames with blocking reads, so\nloadedmetadata waits for several MB to download for any AAC file loaded over\nHTTP, and never fires for live streams advertising a fake Content-Length.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337912\n", "files": ["dom/media/ADTSDemuxer.cpp", "dom/media/ADTSDemuxer.h", "dom/media/gtest/TestADTSDemuxer.cpp"], "git_node": "a8872f9e23d80ed428ddeee72752028a73f4e70f", "git_parents": ["9a1535227ce2f95390108747658ad3d0541db259"], "node": "98aca628c14f4bc88d1e97213e4dd09d0b612b06", "parents": ["42032a1b59af819343d532541451ca27ba565fb1"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1796283 - disable @browser_aaa_eventTelemetry_run_first.js on macOS for causing frequent failures. r=credential-management-reviewers,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337870\n", "files": ["browser/components/aboutlogins/tests/browser/browser.toml"], "git_node": "032f90e0cd6296b6b2ff7876d45218b552443c68", "git_parents": ["a8872f9e23d80ed428ddeee72752028a73f4e70f"], "node": "7a5e93dd4b6718a99993eee546c2cf8587b1595e", "parents": ["98aca628c14f4bc88d1e97213e4dd09d0b612b06"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1627479 - Implement AppWindow::GetVisibility and fix AppWindow::SetVisibility() to avoid CPU load of 10-15% when window goes invisible. r=emilio\" for causing multiple failures.\n\nThis reverts commit 178c81a47b8192ddc656fe0901752eefc81a27e1.\n\nRevert \"Bug 1627479 - Linux: add nsWindowMediator::GetMostRecentBrowserAppWindow API to make Minimize to tray work on Linux, too r=emilio\"\n\nThis reverts commit 24486c0b75d9ca6bbff1f95a5ec059a9e17cb57b.\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "dom/base/test/app_window.js", "dom/base/test/browser.toml", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsIWindowMediator.idl", "xpfe/appshell/nsWindowMediator.cpp"], "git_node": "c17eac2420049dcb2507e3f6f35263ffd9e1843a", "git_parents": ["032f90e0cd6296b6b2ff7876d45218b552443c68"], "node": "f10b8618a69db5363c6f287a40d248469eb7b10e", "parents": ["7a5e93dd4b6718a99993eee546c2cf8587b1595e"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1920615, Bug 2086756, Bug 2026600, Bug 1932027, Bug 1938697, Bug 1882642 - Wait for the controls' icons to be decoded before snapshotting in the videocontrols direction tests, r=firefox-desktop-core-reviewers ,mossop.\" for causing mochitest failures @test_videocontrols_audio_direction.html.\n\nThis reverts commit d6b9668f5e57b43e07ce4d261ddd5774acabfdfd.\n\nRevert \"Bug 2086756 - Compare subframe displayports to their visible height in test_layerization.html, r=gfx-reviewers,bradwerth.\"\n\nThis reverts commit ec0337a9092e2b46b2c9f07f04da76640d604524.\n\nRevert \"Bug 2026600 - Check pageX/pageY against the scroll position in test_bug443985.html, r=dom-core-reviewers,smaug.\"\n\nThis reverts commit 15ce030d438b318071f000394098061f184ef0fa.\n\nRevert \"Bug 1932027 - Check which child processes run only once test_memoryReporters2.xhtml's content processes are up, r=mccr8.\"\n\nThis reverts commit d68c5bf93edc81226b9f483a3deded7487fc457f.\n\nRevert \"Bug 1938697 - Name unnamed groups synchronously in the all tabs menu, r=tabbrowser-reviewers,jsudiaman.\"\n\nThis reverts commit 8cb74bb2eb27dfeb22f056185fd57d245dbdab73.\n\nRevert \"Bug 1882642 - Clean up MockFilePicker in browser_aboutdebugging_addons_temporary_install_path.js, r=devtools-reviewers,nchevobbe.\"\n\nThis reverts commit ab952ec92a84fe1c05076fbb336dd45bfb4684f9.\n", "files": ["browser/components/tabbrowser/GroupsList.sys.mjs", "browser/components/tabbrowser/TabsList.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "devtools/client/aboutdebugging/test/browser/browser.toml", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_temporary_install_path.js", "dom/events/test/mochitest.toml", "dom/events/test/test_bug443985.html", "gfx/layers/apz/test/mochitest/mochitest.toml", "gfx/layers/apz/test/mochitest/test_layerization.html", "toolkit/components/aboutmemory/tests/chrome.toml", "toolkit/components/aboutmemory/tests/test_memoryReporters2.xhtml", "toolkit/content/tests/widgets/mochitest.toml", "toolkit/content/tests/widgets/videocontrols_direction_test.js"], "git_node": "0dedd7ca682b877c137d2c1eed33f361944d73cd", "git_parents": ["c17eac2420049dcb2507e3f6f35263ffd9e1843a"], "node": "6d32b0fd563e8299583cee2b153a690ff0085ffd", "parents": ["f10b8618a69db5363c6f287a40d248469eb7b10e"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076170 - Fallible MarkPagesInUseHard on Linux r=jonco\" for causing geckoview failures.\n\nThis reverts commit 5e99ff18da9824a27eccaf4aaee95ffc7c204cd1.\n", "files": ["js/src/gc/Memory.cpp"], "git_node": "d865e3146580ea1e985382c3dc44b10d7ef6be27", "git_parents": ["0dedd7ca682b877c137d2c1eed33f361944d73cd"], "node": "b07e16963e500fb6ef1f4d2ebfcf70abaa95e9f1", "parents": ["6d32b0fd563e8299583cee2b153a690ff0085ffd"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086064 - publish mapping files for all build types. r=jcristau\n\nNB the mapping file is only produced for r8 optimised builds: debug builds do not produce a mapping.txt, so in this case there will simply be a warning in the logs that the mapping.txt file does not exist.\n\nchanges:\n- `build_android_app.py`: `add_artifacts` now adds `mapping.txt` to any build.\n\n- `build-apk/kind.yml`: removed the one-off artifact on `fenix-nightly-firebase`. The new rule produces the same path, and the `ui-test-apk` fetch still resolves.\n\n- `test_android_taskgraph.py`: a new test, `test_mapping_published_for_each_variant`, looks for the mapping file at the expected path.\n\n[new try is here](https://treeherder.mozilla.org/jobs?repo=try&revision=a82c98e006dd980f36bb3feb47f7bd21711cd143)\nit is green and you can see the new artifact in each build: here is an example\n\u003cimg width=\"346\" height=\"217\" alt=\"image\" src=\"https://github.com/user-attachments/assets/aa39de04-cee7-4a0c-a281-cae492a37cac\" /\u003e\n\nartifact sizes for two of the try mappings:\n- Fenix nightly bundle: about 221 MB\n- Focus release bundle: about 108 MB\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/422\n", "files": ["taskcluster/android_taskgraph/transforms/build_android_app.py", "taskcluster/gecko_taskgraph/test/test_android_taskgraph.py", "taskcluster/kinds/build-apk/kind.yml"], "git_node": "d890dd606fd51902f874e479f9caebf3b6024ab7", "git_parents": ["d865e3146580ea1e985382c3dc44b10d7ef6be27"], "node": "67253db3e51770d4b6ddf2cf886c7b85daa58edb", "parents": ["b07e16963e500fb6ef1f4d2ebfcf70abaa95e9f1"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 1897366 - Assert that wasm frames of baseline-compiled debug-mode code have a stackmap during GC.  r=rhunt.\n\nEvery call site and trap site in debug-mode baseline code now has a stackmap,\nso a missing one in Instance::traceFrame indicates a bug. The assertion\nexcludes import-function wrappers, which aren't compiled by the baseline\ncompiler and have no stackmaps, and ReturnStub call sites, which also have\nnone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335992\n", "files": ["js/src/jit-test/tests/debug/wasm-gc-import-wrapper-frame.js", "js/src/jit-test/tests/debug/wasm-gc-return-stub-frame.js", "js/src/wasm/WasmInstance.cpp"], "git_node": "658cc99da1bdcae5f02de1e92020a0cd8e115ccb", "git_parents": ["d890dd606fd51902f874e479f9caebf3b6024ab7"], "node": "0dcf35d67b526cbfe472064eedc2b2b4c22b6c99", "parents": ["67253db3e51770d4b6ddf2cf886c7b85daa58edb"], "tags": []}, {"author": "Resonance \u003cres0nancee@pm.me\u003e", "branch": "default", "desc": "Bug 2042877 - Start the graph of an autoplay-blocked AudioContext with a SystemClockDriver. r=media-playback-reviewers,karlt\n\nAudioContext::AudioContext() computes whether the context is allowed to\nstart and, when it is not, keeps the destination track suspended until\nthe page resumes it. AudioDestinationNode nevertheless always requested\nan AUDIO_THREAD_DRIVER graph, so MediaTrackGraphImpl::Init() created an\nAudioCallbackDriver and RunInStableState() started it, opening and\nstarting a cubeb output stream. CheckDriver() then found no active audio\ntrack and switched to a SystemClockDriver, destroying the stream again\nabout 150 ms later.\n\nOn macOS, starting the output unit is enough for the system to route\nautomatically-switching Bluetooth headsets to this machine, so every\npage that creates an AudioContext before a user gesture steals the\nuser's AirPods from their phone while rendering nothing.\n\nPass the autoplay decision to AudioDestinationNode and request a\nSYSTEM_THREAD_DRIVER graph for a context that is not allowed to start.\nWhen the context is resumed, the pending resume operation makes\nCheckDriver() create the AudioCallbackDriver as it already does for\ngraphs created with a system clock driver.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334987\n", "files": ["dom/media/webaudio/AudioContext.cpp", "dom/media/webaudio/AudioDestinationNode.cpp", "dom/media/webaudio/AudioDestinationNode.h"], "git_node": "1e9ecaf1361e94eb84755d73ede8e1e745d3f53b", "git_parents": ["658cc99da1bdcae5f02de1e92020a0cd8e115ccb"], "node": "0839f229e50eb899c0390826b08f8331ff3110df", "parents": ["0dcf35d67b526cbfe472064eedc2b2b4c22b6c99"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085551 - Stop the permission cleaners from modifying the OriginAttributesPattern shared by all cleaners. r=permissions-reviewers,timhuang\n\nThe permission cleaners deleted userContextId and privateBrowsingId from the\npattern when permissions are not isolated by them. All cleaners share that\nobject, and the QuotaCleaner reads it after an await, so a bounce tracker\npurge for the default context also cleared QuotaManager storage of the site\nin every container.\n\nAdd nsIPermissionManager.getAllForOriginAttributesPattern, which applies the\nisolation prefs to its own copy of the pattern, and use it in the permission\ncleaners instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336814\n", "files": ["extensions/permissions/PermissionManager.cpp", "extensions/permissions/test/unit/test_permmanager_getAllForOriginAttributesPattern.js", "extensions/permissions/test/unit/xpcshell.toml", "netwerk/base/nsIPermissionManager.idl", "toolkit/components/cleardata/ClearDataService.sys.mjs", "toolkit/components/cleardata/tests/unit/test_permissions.js", "toolkit/components/cleardata/tests/unit/test_quota.js"], "git_node": "0537e231a1d37dd12b6a2c1a5056c68e7b2374a4", "git_parents": ["1e9ecaf1361e94eb84755d73ede8e1e745d3f53b"], "node": "66f273922aa831d57e4f658e6dd2464b8173cd7e", "parents": ["0839f229e50eb899c0390826b08f8331ff3110df"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1882642 - Clean up MockFilePicker in browser_aboutdebugging_addons_temporary_install_path.js, r=devtools-reviewers,nchevobbe.\n\nMockFilePicker.showCallback kept the picker, and through it the about:debugging window, alive until shutdown. This only leaks in standalone runs, where no later MockFilePicker.init() resets the callback (skip-if from bug 2026756).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337696\n", "files": ["devtools/client/aboutdebugging/test/browser/browser.toml", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_temporary_install_path.js"], "git_node": "4c196ecbfff887a88532bb7cdd79bd8cc55f7304", "git_parents": ["0537e231a1d37dd12b6a2c1a5056c68e7b2374a4"], "node": "36b996230afe787b4c1045ec9db1108041ec57af", "parents": ["66f273922aa831d57e4f658e6dd2464b8173cd7e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1938697 - Name unnamed groups synchronously in the all tabs menu, r=tabbrowser-reviewers,jsudiaman.\n\nUnnamed open group rows only got their label after an extra async formatValues call, so the panel could show with a blank group label. Use the group's cached defaultGroupName instead, also in the groups section, which had the same async hop.\n\nThis was the Linux opt failure of bug 2028649. Its Windows opt timeout no longer reproduces, so the skip-if is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337697\n", "files": ["browser/components/tabbrowser/GroupsList.sys.mjs", "browser/components/tabbrowser/TabsList.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml"], "git_node": "e5e046c9194b50adebb0d98cb17a9746c992326b", "git_parents": ["4c196ecbfff887a88532bb7cdd79bd8cc55f7304"], "node": "797e97af92e3f0e0eb0da7696916c899184411ab", "parents": ["36b996230afe787b4c1045ec9db1108041ec57af"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1932027 - Check which child processes run only once test_memoryReporters2.xhtml's content processes are up, r=mccr8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337699\n", "files": ["toolkit/components/aboutmemory/tests/chrome.toml", "toolkit/components/aboutmemory/tests/test_memoryReporters2.xhtml"], "git_node": "69cf8a54c30f1b6f418d46e751e0e9e29212e894", "git_parents": ["e5e046c9194b50adebb0d98cb17a9746c992326b"], "node": "44c74368884ec735f8bed2823d732bc7b18bd9fd", "parents": ["797e97af92e3f0e0eb0da7696916c899184411ab"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2026600 - Check pageX/pageY against the scroll position in test_bug443985.html, r=dom-core-reviewers,smaug.\n\nThe test required pageX \u003e 3000, which the page cannot scroll far enough to reach when the test frame is wider than about 1000px, as it is in the standalone variant. The comparison allows a difference under 1px because on HiDPI macOS scrollX/scrollY can be fractional while MouseEvent.pageX/pageY are integers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337704\n", "files": ["dom/events/test/mochitest.toml", "dom/events/test/test_bug443985.html"], "git_node": "69cb0bffd0ff109051f7be033fb054df8bf42a33", "git_parents": ["69cf8a54c30f1b6f418d46e751e0e9e29212e894"], "node": "6c92ce3ed3596ec2da57e02923429687d366c500", "parents": ["44c74368884ec735f8bed2823d732bc7b18bd9fd"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086756 - Compare subframe displayports to their visible height in test_layerization.html, r=gfx-reviewers,bradwerth.\n\ninner2 and inner4 are clipped by their parent, so their displayport is built from the visible rect and doesn't grow with the window.\nThe standalone jobs' taller window (innerHeight 951) pushed the old min(clientHeight, innerHeight) threshold above it, so this removes the standalone skip added in bug 2026600.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337709\n", "files": ["gfx/layers/apz/test/mochitest/mochitest.toml", "gfx/layers/apz/test/mochitest/test_layerization.html"], "git_node": "eaa67c5f12c3af06891ad055a98f26e46b7bbdf0", "git_parents": ["69cb0bffd0ff109051f7be033fb054df8bf42a33"], "node": "d5e20a3834c99cb3fea30d8d3626f1d2abfb4ee9", "parents": ["6c92ce3ed3596ec2da57e02923429687d366c500"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086266 - Re-enable tests disabled on ccov builds that pass there on try. r=aryx,application-update-reviewers,devtools-reviewers,dom-worker-reviewers,niklas,janerik,edenchuang,spohl,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337285\n", "files": ["browser/base/content/test/browser-static/browser.toml", "browser/base/content/test/browser-webrtc/browser.toml", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/originattributes/test/browser/browser.toml", "browser/components/resistfingerprinting/test/mochitest/mochitest.toml", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/sessionstore/test/browser.toml", "browser/components/shell/test/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/translations/tests/browser/browser.toml", "browser/components/translations/tests/browser/browser_full.toml", "browser/components/translations/tests/browser/browser_select.toml", "browser/components/translations/tests/browser/browser_telemetry.toml", "devtools/client/application/test/browser/browser.toml", "devtools/client/inspector/test/browser.toml", "devtools/shared/commands/target/tests/browser.toml", "dom/base/test/fullscreen/mochitest.toml", "dom/events/test/pointerevents/mochitest.toml", "dom/manifest/test/browser.toml", "dom/media/mediasource/test/mochitest_compat.toml", "dom/media/test/mochitest.toml", "dom/workers/test/chrome.toml", "gfx/layers/apz/test/mochitest/mochitest.toml", "image/test/mochitest/mochitest.toml", "modules/libpref/test/browser/browser.toml", "toolkit/components/backgroundtasks/tests/xpcshell/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/xpcshell-content.toml", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/printing/tests/browser.toml", "toolkit/components/processtools/tests/browser/browser.toml", "toolkit/components/telemetry/tests/unit/xpcshell.toml", "toolkit/mozapps/update/tests/unit_aus_update/xpcshell.toml", "toolkit/xre/test/browser.toml", "xpcom/tests/unit/xpcshell.toml"], "git_node": "9407148b01202846f7cbc1dd584c21ecb7d49069", "git_parents": ["eaa67c5f12c3af06891ad055a98f26e46b7bbdf0"], "node": "f3921d764ce9fbe6871eca9a92d2d9c424911dee", "parents": ["d5e20a3834c99cb3fea30d8d3626f1d2abfb4ee9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086266 - Narrow skip-if conditions on ccov builds to the tests and configurations that fail. r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337286\n", "files": ["dom/events/test/pointerevents/mochitest.toml", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_service.toml"], "git_node": "e728d826999dede71eef29aed8a79a374c3e588e", "git_parents": ["9407148b01202846f7cbc1dd584c21ecb7d49069"], "node": "7ce62eb8b92c93c91891c71b078869b37026684f", "parents": ["f3921d764ce9fbe6871eca9a92d2d9c424911dee"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087023 - Drop support for XSL in `Link` header. r=emilio\n\nNo other browser processes XSLT stylesheets referenced from a Link header,\nonly from the xml-stylesheet processing instruction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337942\n", "files": ["dom/base/test/browser_xml_xslt_disabled.js", "dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xml/nsXMLFragmentContentSink.cpp"], "git_node": "3f153c9d78e812bd6ae0c3914b90a8f3b9806b29", "git_parents": ["e728d826999dede71eef29aed8a79a374c3e588e"], "node": "6ed8275250ef21f65d33f9928bebe52255c5c25b", "parents": ["7ce62eb8b92c93c91891c71b078869b37026684f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086181 - Run the android-gradle-build python tests in two tasks. r=ahochheiden\n\nThe two mach environment cache tests share one build of their objdirs instead of each building both.\n\nThe app build tests carry an app_build marker and run in their own task; the minify test now runs mach build\nfirst like the others instead of relying on test_artifact_build's objdir. Unmarked tests run in the mach\nintegration task. Changes under build/test/python now schedule both tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337227\n", "files": ["build/test/python/conftest.py", "build/test/python/test_android_gradle_build.py", "taskcluster/kinds/source-test/python-android.yml"], "git_node": "0838e83b25c1a7805d78a341b9c8b99b75098874", "git_parents": ["3f153c9d78e812bd6ae0c3914b90a8f3b9806b29"], "node": "0923720b9c64d3e5453d51530b9497710a1c26ed", "parents": ["6ed8275250ef21f65d33f9928bebe52255c5c25b"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Split send_stop_signal into open and send steps r=iholmes,hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331065\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/lifecycle.rs"], "git_node": "30643005b51974cf747cf8f518031a2941bef51c", "git_parents": ["0838e83b25c1a7805d78a341b9c8b99b75098874"], "node": "2613cea66e3fdf43382592c9fffc3c6305b38d8f", "parents": ["0923720b9c64d3e5453d51530b9497710a1c26ed"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Check if the profile still exists within the program loop r=iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331066\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/main.rs"], "git_node": "ee30bd8e8ffe18887a2e9f3453fea121814bffb4", "git_parents": ["30643005b51974cf747cf8f518031a2941bef51c"], "node": "d5abcde9238d91f5debd458ec4d650a7c89dbf29", "parents": ["2613cea66e3fdf43382592c9fffc3c6305b38d8f"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Fix format r=iholmes,hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331067\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/main.rs"], "git_node": "98e5bbbf2574795bdb634ac82ac17c8fd1c03ddb", "git_parents": ["ee30bd8e8ffe18887a2e9f3453fea121814bffb4"], "node": "1260774638a8f2a2cebc37152bedb11f81df9200", "parents": ["d5abcde9238d91f5debd458ec4d650a7c89dbf29"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Remove commented-out function r=iholmes,hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331068\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/pushconnection.rs"], "git_node": "05d280a484451f68a4015db2f38aef1f8df7868f", "git_parents": ["98e5bbbf2574795bdb634ac82ac17c8fd1c03ddb"], "node": "11e18669762f72b6087655bd64a0b3e66af85c05", "parents": ["1260774638a8f2a2cebc37152bedb11f81df9200"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Remove outdated comment r=iholmes,hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331236\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/main.rs"], "git_node": "59fb033c7ad22cee6335a02db41e5adb59fc7a4a", "git_parents": ["05d280a484451f68a4015db2f38aef1f8df7868f"], "node": "814d2a28dff97069de5306b1a183e7233ccd639b", "parents": ["11e18669762f72b6087655bd64a0b3e66af85c05"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Make the push notification helper registry stateless r=iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331233\n", "files": ["toolkit/mozapps/pushnotificationhelper/PushNotificationHelperRegistry.sys.mjs", "toolkit/mozapps/pushnotificationhelper/WindowsPushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/tests/xpcshell/test_push_notification_helper_registry.js"], "git_node": "df8a18129858a77528a76c3fa75013f1e073b950", "git_parents": ["59fb033c7ad22cee6335a02db41e5adb59fc7a4a"], "node": "17c9baf9abb0e2383fca201d7b1a2f036a221c87", "parents": ["814d2a28dff97069de5306b1a183e7233ccd639b"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Add function to get the push notification helper records of a profile r=iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333610\n", "files": ["toolkit/mozapps/pushnotificationhelper/PushNotificationHelperRegistry.sys.mjs", "toolkit/mozapps/pushnotificationhelper/tests/xpcshell/test_push_notification_helper_registry.js"], "git_node": "1bc6b654b0e132bb99fc194aa9d379d479f24738", "git_parents": ["df8a18129858a77528a76c3fa75013f1e073b950"], "node": "a222ca643b56af8a5615d8a60e1d6c4d15e290bd", "parents": ["17c9baf9abb0e2383fca201d7b1a2f036a221c87"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Add stopForProfile to stop all the helpers of a profile r=iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333611\n", "files": ["toolkit/mozapps/pushnotificationhelper/PushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/WindowsPushNotificationHelper.sys.mjs", "toolkit/mozapps/pushnotificationhelper/tests/xpcshell/test_push_notification_helper_registry.js"], "git_node": "38b3f2fe9a7dc8bc9ce0ce407f8d0364a5fbcb51", "git_parents": ["1bc6b654b0e132bb99fc194aa9d379d479f24738"], "node": "da9ea9e7f380278f28baaf76b3c748e89a1d11fd", "parents": ["a222ca643b56af8a5615d8a60e1d6c4d15e290bd"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Expose MOZ_PUSH_NOTIFICATION_HELPER in AppConstants r=iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333612\n", "files": ["toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build"], "git_node": "a029bd9a24b3647687f67c89d6eb971f2094257f", "git_parents": ["38b3f2fe9a7dc8bc9ce0ce407f8d0364a5fbcb51"], "node": "86ff3a4140365272cbbbbe8fedf36188e82935db", "parents": ["da9ea9e7f380278f28baaf76b3c748e89a1d11fd"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Stop the profile's helper before the Profile Manager removes it r=iholmes,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333613\n", "files": ["toolkit/profile/content/profileSelection.js"], "git_node": "4ff10eba0dd90fb2f1c1d55e4cb268be0e17602c", "git_parents": ["a029bd9a24b3647687f67c89d6eb971f2094257f"], "node": "b9d7077f97e472565394c71d247774e6cd0aa3b1", "parents": ["86ff3a4140365272cbbbbe8fedf36188e82935db"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Stop the profile's helper before about:profiles removes it r=iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333614\n", "files": ["toolkit/content/aboutProfiles.js"], "git_node": "5e1ae849d8c704c04f5b238d9469b7e818315f3a", "git_parents": ["4ff10eba0dd90fb2f1c1d55e4cb268be0e17602c"], "node": "72195b34cacbb858879d554d03a883e3506e7aef", "parents": ["b9d7077f97e472565394c71d247774e6cd0aa3b1"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078295 - Stop the profile's helper before a selectable profile is deleted r=iholmes,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333615\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs"], "git_node": "08533c6b26eef5bba0c00d101f10b76b0727818c", "git_parents": ["5e1ae849d8c704c04f5b238d9469b7e818315f3a"], "node": "80b5090d78d8228a75f2d72626af602b9db90438", "parents": ["72195b34cacbb858879d554d03a883e3506e7aef"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2028517 - Wait for the content to be resized in setViewportSize, r=devtools-reviewers,nchevobbe.\n\nRDM emits content-resize before the content has its new size. browser_viewport_changed_meta.js reloads right after resizing, so the new document could get its first paint at the old width at resolution 1.0, and MobileViewportManager then scaled the resolution by 200/oldWidth. This fixes its Windows opt standalone perma-fail.\n\nsetViewportSize now also waits for the content to have the new size, for all its callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337705\n", "files": ["devtools/client/responsive/test/browser/browser.toml", "devtools/client/responsive/test/browser/head.js", "devtools/client/responsive/ui.js"], "git_node": "804f6e8302ea88d815f477f061232fecf2ed78e1", "git_parents": ["08533c6b26eef5bba0c00d101f10b76b0727818c"], "node": "816a097b233d6c371bd4977ac8ee38c822cfa729", "parents": ["80b5090d78d8228a75f2d72626af602b9db90438"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078640 - [devtools] Disable DevTools on mini window. r=devtools-reviewers,ochameau.\n\nWe want to disable DevTools when the Move Section to Mini Window is activated.\nThis requires a few things:\n- avoid registering keyboard shortcuts for DevTools on the new window\n- don't show DevTools related context menu entry on the new mini window\n- prevent the swap mechanism we have in DevTools when moving a tab to\n  another (non-mini) window to happen when the tab is moved to a mini window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336738\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-contextMenu/browser_contextmenu_inspect.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_disabled_devtools_mini_window.js", "devtools/client/framework/toolbox-host-manager.js", "devtools/server/actors/webbrowser.js", "devtools/startup/DevToolsStartup.sys.mjs"], "git_node": "3547015f390dafe09075532175da6d02450a8275", "git_parents": ["804f6e8302ea88d815f477f061232fecf2ed78e1"], "node": "94bf0593129ddc0484df7ceea6db3534af295a47",