3863022545"], "node": "4e8810923073f287d01caa0da37441df0bc0e93f", "parents": ["f61f53cf3944abbe07bcb280fb32081bb6b6bc69"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2083784 - Keep minidump_path on crash records in TestSummaryFormatter output r=jgraham\n\nTbplFormatter prints the minidump name after PROCESS-CRASH so that\nTreeherder can link the line to the crash dump, and the failure summary\nshows it that way. summary.jsonl stripped minidump_path, so its crash\nrecord could neither be matched to that line nor linked to the dump.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335175\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "e017387ca3ebc509055be29a670e497661f4b2bc", "git_parents": ["742327194805e5ad2ff8d24d1215666cb82bcb8a"], "node": "aec95037afeb5e726f70ec7a07a56d4a97132d45", "parents": ["4e8810923073f287d01caa0da37441df0bc0e93f"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2084619 - [remote] Harden the Marionette and Remote Agent server sockets. r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336178\n", "files": ["remote/components/RemoteAgent.sys.mjs", "remote/marionette/server.sys.mjs"], "git_node": "ce6d1ba68b263fbe7b606bd6b498dfa62ae501cf", "git_parents": ["e017387ca3ebc509055be29a670e497661f4b2bc"], "node": "db9a99efb07b8bec8dcfa82d1c8ebbc9283a8f62", "parents": ["aec95037afeb5e726f70ec7a07a56d4a97132d45"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081982. r=edgar\n\nNot the prettiest, but other approaches welcome, see bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335399\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "6391882387da0a8be304d2ca19a9e64523e85838", "git_parents": ["ce6d1ba68b263fbe7b606bd6b498dfa62ae501cf"], "node": "82d192e6e0b9ca7218244cba06428a47b616299a", "parents": ["db9a99efb07b8bec8dcfa82d1c8ebbc9283a8f62"], "tags": []}, {"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082359 - Wait for formAutofillStorage initialization before switching stores in browser_creditCard_migration.js. r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336659\n", "files": ["browser/extensions/formautofill/test/browser/browser_creditCard_migration.js"], "git_node": "9b5528b8432cb2b1abed72cecca37693f7f9b420", "git_parents": ["6391882387da0a8be304d2ca19a9e64523e85838"], "node": "d70c224295e8ea5a37e368279a591d68aed50b7e", "parents": ["82d192e6e0b9ca7218244cba06428a47b616299a"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2085336 - Ensure correct engine is selected during tests r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336437\n", "files": ["browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js"], "git_node": "05d3f680ab526c2c0d4571b770a488c36edffc8c", "git_parents": ["9b5528b8432cb2b1abed72cecca37693f7f9b420"], "node": "8d5aaa44977159e3dad2a3690fc1b0588fcb83bd", "parents": ["d70c224295e8ea5a37e368279a591d68aed50b7e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085386 - Sort frame arena free lists before initial frame construction. r=layout-reviewers,jfkthame\n\nThis gives better cache locality matching previous per-PresShell arena\nbehavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336535\n", "files": ["layout/base/PresShell.cpp", "layout/base/nsPresArena.cpp", "layout/base/nsPresArena.h"], "git_node": "ca3da38c7757f7f64aa8084d37408700a8086666", "git_parents": ["05d3f680ab526c2c0d4571b770a488c36edffc8c"], "node": "366da94b291268c44418c319b29cd67835b61c55", "parents": ["8d5aaa44977159e3dad2a3690fc1b0588fcb83bd"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085643 - Release the ANativeWindow reference given to the MediaCodec device context. r=media-playback-reviewers,padenot\n\nFFmpeg only releases AVMediaCodecDeviceContext::native_window if it created\nthe window itself, which it never does for us because we always provide one.\nRelease our reference from the device context's free callback, which runs once\nthe last reference to the context is dropped, including on init failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336560\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "079338aef0f429e33c7b5bf30f3e791197456971", "git_parents": ["ca3da38c7757f7f64aa8084d37408700a8086666"], "node": "e739a0d07fd44d15400e9abae0bf5b51852b8da4", "parents": ["366da94b291268c44418c319b29cd67835b61c55"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981478 - Flip prefs to switch to NDK decoding/encoding on Android on nightly. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260149\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "17fdf0b741cf50c38e7303eb44fc0f0683e930c4", "git_parents": ["079338aef0f429e33c7b5bf30f3e791197456971"], "node": "6d4673758f3c229a6c62889376270dde882677e0", "parents": ["e739a0d07fd44d15400e9abae0bf5b51852b8da4"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085148: add `checks` to routes for `code-review-build-test` tasks r=marco,taskgraph-reviewers,ahal\n\nThis will get them to show up in pull requests, as the linting tasks do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336289\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "fbdbf6038726125b7358497806b39e190f5e359d", "git_parents": ["17fdf0b741cf50c38e7303eb44fc0f0683e930c4"], "node": "980233e5208ff85fff8d1957732142be11958e06", "parents": ["6d4673758f3c229a6c62889376270dde882677e0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085685 - Update mingw-w64 to upstream revision 7213d719fe344553aa24fef7cc7dedee4940d594. r=firefox-build-system-reviewers,ahochheiden\n\nThe regenerated windows.foundation.h maps the WinRT boolean to C++ bool, so IReference\u003cboolean\u003e no longer\ncollides with IReference\u003cBYTE\u003e and mingw-foundation_redef.patch is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336568\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/scripts/misc/mingw-foundation_redef.patch"], "git_node": "05c1e17fa662365ae9fd2d9798251ad138c9fd7b", "git_parents": ["fbdbf6038726125b7358497806b39e190f5e359d"], "node": "e773a76baf17106728d5103c5654e71cbc67f320", "parents": ["980233e5208ff85fff8d1957732142be11958e06"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade APZ thread assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333734\n", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZPublicUtils.cpp", "gfx/layers/apz/src/APZSampler.cpp", "gfx/layers/apz/src/APZUpdater.cpp", "gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/layers/apz/src/FocusTarget.cpp", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/layers/apz/util/APZThreadUtils.cpp", "gfx/layers/apz/util/CheckerboardReportService.cpp", "gfx/layers/apz/util/ChromeProcessController.cpp", "gfx/layers/apz/util/ScrollLinkedEffectDetector.cpp"], "git_node": "9d07f650bba6035a764e404efd11134fe52922a0", "git_parents": ["05c1e17fa662365ae9fd2d9798251ad138c9fd7b"], "node": "a8e7330aad112c21f5c061969666cc2b841bd791", "parents": ["e773a76baf17106728d5103c5654e71cbc67f320"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade layers/ipc thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333735\n", "files": ["gfx/layers/ipc/APZBridgeChild.cpp", "gfx/layers/ipc/APZBridgeParent.cpp", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerParent.cpp", "gfx/layers/ipc/APZChild.cpp", "gfx/layers/ipc/CanvasChild.cpp", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/CanvasTranslator.h", "gfx/layers/ipc/CompositableForwarder.h", "gfx/layers/ipc/CompositableTransactionParent.cpp", "gfx/layers/ipc/CompositableTransactionParent.h", "gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorManagerChild.cpp", "gfx/layers/ipc/CompositorManagerChild.h", "gfx/layers/ipc/CompositorManagerParent.cpp", "gfx/layers/ipc/CompositorThread.cpp", "gfx/layers/ipc/CompositorVsyncScheduler.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ISurfaceAllocator.cpp", "gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/ImageBridgeChild.cpp", "gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/layers/ipc/KnowsCompositor.h", "gfx/layers/ipc/LayerTreeOwnerTracker.cpp", "gfx/layers/ipc/RefCountedShmem.cpp", "gfx/layers/ipc/RemoteContentController.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/layers/ipc/SharedSurfacesChild.cpp", "gfx/layers/ipc/SharedSurfacesChild.h", "gfx/layers/ipc/SharedSurfacesParent.cpp", "gfx/layers/ipc/UiCompositorControllerChild.cpp", "gfx/layers/ipc/UiCompositorControllerParent.cpp", "gfx/layers/ipc/VideoBridgeChild.cpp", "gfx/layers/ipc/VideoBridgeParent.cpp"], "git_node": "b83ccb49dc67ac65c799ee98ac4ccdf3c9c20fe8", "git_parents": ["9d07f650bba6035a764e404efd11134fe52922a0"], "node": "bae873dfbff5cdd7ddc9675c31784f990d3b84ac", "parents": ["a8e7330aad112c21f5c061969666cc2b841bd791"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Convert some  assertions to MOZ_RELEASE_ASSERT (part 1). r=gfx-reviewers,bradwerth\n\nConvert MOZ_ASSERT to MOZ_RELEASE_ASSERT for critical graphics resource assertions\nthat must hold even in release builds. These changes address cases where:\n- Output parameters from wr_window_new() must be valid (lines 317, 322, 323)\n- Memory mapping operations must succeed (line 510)\n\nThese cause immediate crashes in release builds if assertions fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333727\n", "files": ["gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "c0a1ae242007d6546c91a7e9c9e7c1a8fe7113b1", "git_parents": ["b83ccb49dc67ac65c799ee98ac4ccdf3c9c20fe8"], "node": "6502fe167fa3fbf38fd351d72666418774c64224", "parents": ["bae873dfbff5cdd7ddc9675c31784f990d3b84ac"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Convert some resource assertions to MOZ_RELEASE_ASSERT (part 2). r=gfx-reviewers,bradwerth\n\nThese assertions guard critical resources where null would cause crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333728\n", "files": ["gfx/layers/AndroidImageConsumer.cpp", "gfx/vr/VRManager.cpp", "gfx/vr/VRServiceHost.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.cpp", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "d8cecc70e6066b78dadc0847de9d85f574eecbcb", "git_parents": ["c0a1ae242007d6546c91a7e9c9e7c1a8fe7113b1"], "node": "979c843d7865a440fb80fce04ee7b655d98a78c0", "parents": ["6502fe167fa3fbf38fd351d72666418774c64224"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Fix contradictory assertion and upgrade shared memory checks to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nRemove contradictory MOZ_ASSERT in RenderTextureHostWrapper::EnsureTextureHost() that immediately precedes a null check. The null check is the actual guard and is already logging the error.\n\nConvert shared memory assertions to MOZ_RELEASE_ASSERT in VRManager since mShmem is accessed without fallback in the subsequent code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333729\n", "files": ["gfx/vr/VRManager.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp"], "git_node": "4ed68a8945f9d98ae0562aa7f8af04cba8d76e7b", "git_parents": ["d8cecc70e6066b78dadc0847de9d85f574eecbcb"], "node": "61ccebb48d9acdcf7546d793702597c773b3adcc", "parents": ["979c843d7865a440fb80fce04ee7b655d98a78c0"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade VRManager assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nThese assertions guard critical invariants where violation indicates a programming\nerror that must be caught in all builds, not just debug builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333730\n", "files": ["gfx/vr/VRManager.cpp"], "git_node": "b3120b9942ec8d074e3b976a00df96b3f121f391", "git_parents": ["4ed68a8945f9d98ae0562aa7f8af04cba8d76e7b"], "node": "5498c04967c5531dfefb0c1302a8e4f33e8aae75", "parents": ["61ccebb48d9acdcf7546d793702597c773b3adcc"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade some gfx/vr assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nConvert critical assertions in VRServiceHost, VRThread, gfxVRMutex, FxRWindowManager,\nand VRShMem to MOZ_RELEASE_ASSERT to protect:\n- Threading invariants (NS_IsMainThread)\n- Resource validity (GPU process, thread, window, mutex handles)\n- State machine invariants (shared memory state, resource cleanup)\n- Preconditions on public APIs (singleton getters, initialization)\n\nThese assertions guard invariants where violation indicates a programming error that\nmust be caught in all builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333731\n", "files": ["gfx/vr/FxRWindowManager.cpp", "gfx/vr/VRServiceHost.cpp", "gfx/vr/VRShMem.cpp", "gfx/vr/VRThread.cpp", "gfx/vr/gfxVRMutex.h"], "git_node": "46d5b7d4b47d0a3a8930bc76facf860d62edb6e5", "git_parents": ["b3120b9942ec8d074e3b976a00df96b3f121f391"], "node": "099d87f8fabe446723532cf0788344d712c2d3c9", "parents": ["5498c04967c5531dfefb0c1302a8e4f33e8aae75"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade more gfx/vr assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nFinal conversions in gfx/vr/ folder:\n- VRShMem.cpp: Mutex and state management assertions (9 conversions)\n- nsFxrCommandLineHandler.cpp: Window/API parameter validation (3 conversions)\n- VRPuppetCommandBuffer.cpp: Singleton init and buffer bounds (3 conversions)\n\nThese protect critical invariants: mutex state, window parameter contracts, array bounds,\nand singleton initialization that must be enforced in all builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333732\n", "files": ["gfx/vr/VRPuppetCommandBuffer.cpp", "gfx/vr/VRShMem.cpp", "gfx/vr/nsFxrCommandLineHandler.cpp"], "git_node": "f226e0ce1a48550e2842127ce66d4dd3e9149c82", "git_parents": ["46d5b7d4b47d0a3a8930bc76facf860d62edb6e5"], "node": "9e85ebc194b7777053a93bb9dc3740d5466e6dcd", "parents": ["099d87f8fabe446723532cf0788344d712c2d3c9"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade remaining gfx/vr as