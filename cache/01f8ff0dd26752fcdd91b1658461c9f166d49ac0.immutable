c/libANGLE/renderer/metal/mtl_occlusion_query_pool.h", "third_party/angle/src/libANGLE/renderer/metal/mtl_occlusion_query_pool.mm", "third_party/angle/src/libANGLE/renderer/metal/mtl_render_utils.h", "third_party/angle/src/libANGLE/renderer/metal/mtl_render_utils.mm", "third_party/angle/src/libANGLE/renderer/metal/mtl_resources.mm", "third_party/angle/src/libANGLE/renderer/metal/mtl_state_cache.mm", "third_party/angle/src/libANGLE/renderer/renderer_utils.cpp", "third_party/angle/src/libANGLE/validationEGL.cpp", "third_party/angle/src/libANGLE/validationEGL.h", "third_party/angle/src/libANGLE/validationEGL_autogen.h", "third_party/angle/src/libANGLE/validationES.cpp", "third_party/angle/src/libANGLE/validationES2.cpp", "third_party/angle/src/libANGLE/validationESEXT.cpp", "third_party/angle/src/libGLESv2.gni", "third_party/angle/src/libGLESv2/egl_ext_stubs.cpp", "third_party/angle/src/libGLESv2/egl_ext_stubs_autogen.h", "third_party/angle/src/libGLESv2/egl_stubs.cpp", "third_party/angle/src/libGLESv2/egl_stubs_autogen.h", "third_party/angle/src/libGLESv2/entry_points_egl_autogen.cpp", "third_party/angle/src/libGLESv2/entry_points_egl_ext_autogen.cpp", "third_party/angle/third_party/spirv-tools/src/BUILD.gn", "third_party/angle/third_party/vulkan-headers/src/include/vulkan/vulkan.hpp", "third_party/angle/third_party/vulkan-headers/src/include/vulkan/vulkan_core.h", "third_party/angle/translator_gn/moz.build", "third_party/angle/xxhash_gn/moz.build"], "git_node": "68fd455f3f2dd2daca87aa9257240cc2327d241d", "git_parents": ["382b1cbc5e087ae660ae1bbbbf131d484d0bcf3b"], "node": "3b77ecc3bcfcfbe5649ff9a4b7bbacfbf58c128e", "parents": ["18f733b3abd0e0e346ccd6d82763b35fbe91976e"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086994 - Add James Teow as a peer for Places. r=jteow,shtrom\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337909\n", "files": ["mots.yaml"], "git_node": "a8f0687b92144502c7690b71ca3a731b683f2348", "git_parents": ["68fd455f3f2dd2daca87aa9257240cc2327d241d"], "node": "592ce772172fe7ac67158ece2dbf15779625e3c6", "parents": ["3b77ecc3bcfcfbe5649ff9a4b7bbacfbf58c128e"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087051 - Speculative crash fix for a possible invalid page index when recording a page impression. Skip the impression and log a warning until the pager adjusts. r=gela,john-oberhauser\n\nI am unable to reproduce this locally - it looks like this is only affecting a _very small_ number of devices but this defensive check will prevent crashing and report logging if it happens.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/427\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt"], "git_node": "ef3d143639637477b5e82880a8a154a177a2ac34", "git_parents": ["a8f0687b92144502c7690b71ca3a731b683f2348"], "node": "7e2d608057fb9850db19a06784d144d13178ba96", "parents": ["592ce772172fe7ac67158ece2dbf15779625e3c6"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2084148 - fix(webgpu): replace incomplete error heuristic in `wgpu_server_queue_submit` w/ `Err`s from `wgpu_core::Queue::Submit` r=webgpu-reviewers,teoxoy\n\nNow that we're consuming [wgpu#10645](https://github.com/gfx-rs/wgpu/pull/10645), we don't need to guess about whether a submission succeeded. Simplify code accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334490\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "b2e92fc6bf889d4dba002023ec8a157f96a7488d", "git_parents": ["ef3d143639637477b5e82880a8a154a177a2ac34"], "node": "8293ba47ff62e4a36399bec7bb62b53dd2dd7640", "parents": ["7e2d608057fb9850db19a06784d144d13178ba96"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2070808 - Use stubEngineNetworkBoundaries in browser_smartwindow_run_search.js, r=Mardak.\n\nwithServer gives title generation a real engine, whose request can still be in flight against the stopped mock server when the test ends, keeping the closed Smart Window alive until shutdown. Holding the conversation until that request settles is expected, so the title can be saved; the test is what leaves the request running after it stopped the server.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337542\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search.js"], "git_node": "704d8efecd5c5825751bc277c5227d41fc3ad130", "git_parents": ["b2e92fc6bf889d4dba002023ec8a157f96a7488d"], "node": "6dec7836382fe464a34d01749332e57a2ee800ff", "parents": ["8293ba47ff62e4a36399bec7bb62b53dd2dd7640"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084591 - Only lock for the shutting-down flag in Connection::isAsyncExecutionThreadAvailable (Coverity CID 1703293) r=mak\n\nmAsyncExecutionThread is only modified on the opener thread, which this\nfunction asserts it runs on, so only mAsyncExecutionThreadShuttingDown\nneeds sharedAsyncExecutionMutex.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335994\n", "files": ["storage/mozStorageConnection.cpp"], "git_node": "11539269997d97878d53f60d3616b62d22ae9bc1", "git_parents": ["704d8efecd5c5825751bc277c5227d41fc3ad130"], "node": "5614be202e6270f6f48c12243b1494142360c6ba", "parents": ["6dec7836382fe464a34d01749332e57a2ee800ff"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2081451 - Enable main thread priority bump on Windows on Nightly r=bas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339064\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "d7b6cfc5bd29ba18c4a82a8a37641cbe56ffe0be", "git_parents": ["11539269997d97878d53f60d3616b62d22ae9bc1"], "node": "cd5244b4ff31e9d1b16a0c270b84340ff7a40337", "parents": ["5614be202e6270f6f48c12243b1494142360c6ba"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2079258 - refactor(webgpu): simplify `Buffer::Cleanup` r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336159\n", "files": ["dom/webgpu/Buffer.cpp"], "git_node": "598265662fb4f93407ff39a05e5e78ba721a589b", "git_parents": ["d7b6cfc5bd29ba18c4a82a8a37641cbe56ffe0be"], "node": "a434e62011aef4c67b372126ae3dd7c341e8987b", "parents": ["cd5244b4ff31e9d1b16a0c270b84340ff7a40337"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071300 - Show the VPN data limit notice once per cycle r=android-reviewers,Roger\n\nThe data limit notice was bound to the lifecycle of `IPProtectionInfoPrompter`, an `AbstractBinding`. Whenever the binding restarted after the app was backgrounded brought back to the foreground, the notice was shown again.\n\nThe notice now uses the allowance reset time and a new shared preference, `ipProtectionLastDataLimitNoticeCycleResetTime`. This preference stores the reset time of the most recent VPN allowance cycle for which the data limit notice was shown. The notice appears when the current reset time is available and is different from the stored time.\n\nThe VPN toggle is now disabled when the data limit is reached, and its disabled state is exposed to screen readers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328577\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemCommon.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/MenuListItemTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/IPProtectionAccountObserver.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/VpnMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionInfoPrompter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionPreferencesMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPanelFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItemTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/IPProtectionAccountObserverTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/VpnMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/FakeIPProtectionRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionInfoPrompterTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionRepositoryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionSnackbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "f8418e018f898fbe035216fea62ceb6e0bcbef7a", "git_parents": ["598265662fb4f93407ff39a05e5e78ba721a589b"], "node": "63022be9f6c3a5471326be3a167732cbe788ccc0", "parents": ["a434e62011aef4c67b372126ae3dd7c341e8987b"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2086685 - Use moz-src for mobile r=geckoview-reviewers,credential-management-reviewers,mtigley,m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337644\n", "files": ["dom/clients/manager/ClientOpenWindowUtils.cpp", "dom/webauthn/WebAuthnRelatedOriginFetcher.sys.mjs", "mobile/android/modules/geckoview/AndroidLog.sys.mjs", "mobile/android/modules/geckoview/moz.build", "mobile/shared/components/geckoview/ColorPickerDelegate.sys.mjs", "mobile/shared/components/geckoview/FilePickerDelegate.sys.mjs", "mobile/shared/components/geckoview/GeckoViewPrompt.sys.mjs", "mobile/shared/components/geckoview/GeckoViewStartup.sys.mjs", "mobile/shared/components/geckoview/LoginStorageDelegate.sys.mjs", "mobile/shared/components/geckoview/PromptCollection.sys.mjs", "mobile/shared/components/geckoview/ShareDelegate.sys.mjs", "mobile/shared/components/geckoview/components.conf", "mobile/shared/components/geckoview/moz.build", "mobile/shared/modules/geckoview/GeckoViewAutocomplete.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewIdentityCredential.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewRemoteDebugger.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewUtils.sys.mjs", "mobile/shared/modules/moz.build", "security/manager/ssl/ClientAuthDialogService.sys.mjs", "toolkit/components/formautofill/android/FormAutofillPrompter.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "52ebb867811a46bfbd85f572d08b2d20692f20fb", "git_parents": ["f8418e018f898fbe035216fea62ceb6e0bcbef7a"], "node": "117ef6ff7bd20eedab6d651ebde0a59608820bd0", "parents": ["63022be9f6c3a5471326be3a167732cbe788ccc0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088285 - Remove HeadlessLookAndFeelGTK. r=stransky,gtk-reviewers\n\nIt used to be the case that nsLookAndFeel didn't deal with no gtk\nsettings and crashed but now we can do the same thing we do on all\nplatforms and just use the platform settings as needed.\n\nTweak some defaults when there are no settings to match the old\nbehavior, and make colors fall back to stand-ins.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338968\n", "files": ["widget/gtk/nsLookAndFeel.cpp", "widget/gtk/nsLookAndFeel.h", "widget/headless/HeadlessLookAndFeel.h", "widget/headless/HeadlessLookAndFeelGTK.cpp", "widget/headless/moz.build", "widget/nsXPLookAndFeel.cpp"], "git_node": "6cc344f4f397139efeff52f1c4cfd6de59a12599", "git_parents": ["52ebb867811a46bfbd85f572d08b2d20692f20fb"], "node": "b6130aec93fd6dfb25d0c049788564f7a056fd3e", "parents": ["117ef6ff7bd20eedab6d651ebde0a59608820bd0"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1752382 followup - Make ident matching ascii-case-insensitive. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339063\n", "files": ["servo/components/style/values/specified/list.rs", "testing/web-platform/tests/css/css-content/parsing/quotes-computed.html", "testing/web-platform/tests/css/css-content/parsing/quotes-valid.html"], "git_node": "f04679e9513a99c84c28cab99b1a62c760e746be", "git_parents": ["6cc344f4f397139efeff52f1c4cfd6de59a12599"], "node": "fbc46343994e77933b9ff1af130f8fb0a3bd10d7", "parents": ["b6130aec93fd6dfb25d0c049788564f7a056fd3e"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 1: Reset the time stretcher after its flushed output has played. r=padenot\n\nReturning to 1x flushes the time stretcher. The flush pads the input with\nsilence, and SoundTouch keeps counting that padding as output it still owes.\nSince the stretcher is now kept alive across rate changes, this debt grows on\nevery return to 1x, so each flush plays more silence than the last and audio\nfalls further behind video.\n\nOnce the flushed output has played, clear the stretcher and prime it again, so\nthe next rate change starts from the same state as the first. Prime it in\nsmall chunks, as this now runs on every return to 1x.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338508\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h"], "git_node": "4af9830f075405db00bdfb6f0c1eb1cca0187f94", "git_parents": ["f04679e9513a99c84c28cab99b1a62c760e746be"], "node": "96aaf9ada578c1ea00603116f4b2be09f06a4f09", "parents": ["fbc46343994e77933b9ff1af130f8fb0a3bd10d7"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 2: Count the time stretcher output only as the source it holds. r=padenot\n\nThe clock counted every frame out of the time stretcher as media time at the\ncurrent rate. That output also carries the silence the stretcher is primed\nwith and the silence a flush pads it with, so the clock, and the video that\nfollows it, ran ahead of the audio, more on every return to 1x.\n\nKeep track of the source fed to the stretcher and of the media the clock has\ncounted for its output. Stretcher output now advances the clock only up to\nthe source the clock has not counted yet, and the rest holds the position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338509\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h"], "git_node": "d9d354bc6bce8f9d1adfb95405eb09da2f442f43", "git_parents": ["4af9830f075405db00bdfb6f0c1eb1cca0187f94"], "node": "a548a5f1071a0f07bf894642e6e73a2958590253", "parents": ["96aaf9ada578c1ea00603116f4b2be09f06a4f09"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 3: Test that rate changes keep the audio clock on the source position. r=padenot\n\nThe previous test only checked that rate changes do not consume too much\nsource, so it passed while the clock ran ahead of the audio. Check instead,\nfor several rates with and without pitch preservation, and for returns to 1x\nboth long and too short for the time stretcher to play out, that the clock\nnever passes the source taken from the data source, that the source consumed\nstays within bounds of what the rates ask for, and that every cycle after the\nfirst consumes the same source and leaves the clock the same distance behind.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338510\n", "files": ["dom/media/gtest/TestAudioStream.cpp"], "git_node": "33480eed2796fdd2663a909efee2f29e67e58eb2", "git_parents": ["d9d354bc6bce8f9d1adfb95405eb09da2f442f43"], "node": "f377d77eed8a3cd47ac85ac06da4dd5afd8e93e6", "parents": ["a548a5f1071a0f07bf894642e6e73a2958590253"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 4: Document how the audio clock counts the time stretcher output. r=padenot,media-playback-reviewers\n\nThe AudioStream document described how the frame history maps frames to media\ntime, but not the time stretcher that playback rates other than 1x go through.\nExplain when the stretcher is used, why it is primed, flushed and reset, and\nhow the clock counts its output so that it never runs ahead of the source.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338511\n", "files": ["dom/media/docs/AudioStream.md"], "git_node": "c42a93a1ed74f2119c4cc5da072116d311cf7226", "git_parents": ["33480eed2796fdd2663a909efee2f29e67e58eb2"], "node": "0a51c52efb5930bd1b7a415960920052ea3cd069", "parents": ["f377d77eed8a3cd47ac85ac06da4dd5afd8e93e6"], "tags": []}, {"author": "Marcin Ko\u0142odziej \u003cmkolodziej@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078650 - Hide the self-named and _-prefixed members on the address bar API reference pages. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339062\n", "files": ["browser/components/urlbar/docs/UrlbarChildController.md", "browser/components/urlbar/docs/UrlbarInputBase.md", "browser/components/urlbar/docs/UrlbarParentController.md", "browser/components/urlbar/docs/UrlbarQueryContext.md"], "git_node": "2b184f2af86c27b3874aa5fc99f3bed4bdbd0259", "git_parents": ["c42a93a1ed74f2119c4cc5da072116d311cf7226"], "node": "60cc99a275d7ff563ad9fbaf3895e2592e9bb607", "parents": ["0a51c52efb5930bd1b7a415960920052ea3cd069"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053725 - Enable Async Clipboard custom format support by default. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322856\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "a8a4797e72c967db63373b14b8a7a270fb8bdd1a", "git_parents": ["2b184f2af86c27b3874aa5fc99f3bed4bdbd0259"], "node": "9d8543de78370691951bf9da234c70eb95d1d0c6", "parents": ["60cc99a275d7ff563ad9fbaf3895e2592e9bb607"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082510 - Create cert details panel for QWAC compliance r=android-reviewers,android-l10n-reviewers,parker,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337161\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateDetailsPanel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelHeader.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "970d3d931afde1814c311ed201974a06a865f557", "git_parents": ["a8a4797e72c967db63373b14b8a7a270fb8bdd1a"], "node": "a6fbdda2fb5f06de0fd9459153cee794332909a6", "parents": ["9d8543de78370691951bf9da234c70eb95d1d0c6"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2087060 [Wayland] Move Gtk specific parts of nsWindowWayland to nsWindowWaylandGtk r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338041\n", "files": ["widget/gtk/moz.build", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h", "widget/gtk/nsWindowWaylandGtk.cpp", "widget/gtk/nsWindowWaylandGtk.h"], "git_node": "dde367bdbb006bea2210ffedf07717eec8291bdb", "git_parents": ["970d3d931afde1814c311ed201974a06a865f557"], "node": "c13513775538eb10981020b76e767b6a9c84da3e", "parents": ["a6fbdda2fb5f06de0fd9459153cee794332909a6"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 1830193 - Skip extracting test262 from the WPT archive when no task runs it. r=jgraham\n\nThe web-platform tests archive has 198k entries and 54k of them are under\ntests/third_party/test262. No CI task runs the test262 test type, but every\nWPT task extracts it, which is slow on Windows. Skip that subtree when the\ntask requests explicit test types that do not include test262.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336903\n", "files": ["testing/mozharness/scripts/web_platform_tests.py"], "git_node": "df4ea37a440b1f6e5ebe609144face369824dd78", "git_parents": ["dde367bdbb006bea2210ffedf07717eec8291bdb"], "node": "13bed3912a11038eb8c9c2ae5d3f113bebbdeb7c", "parents": ["c13513775538eb10981020b76e767b6a9c84da3e"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075947 - Part 4: Document how the audio clock counts the time stretcher output. r=padenot,media-playback-reviewers\" for causing build bustages on TestAudioStream.cpp.\n\nThis reverts commit c42a93a1ed74f2119c4cc5da072116d311cf7226.\n\nRevert \"Bug 2075947 - Part 3: Test that rate changes keep the audio clock on the source position. r=padenot\"\n\nThis reverts commit 33480eed2796fdd2663a909efee2f29e67e58eb2.\n\nRevert \"Bug 2075947 - Part 2: Count the time stretcher output only as the source it holds. r=padenot\"\n\nThis reverts commit d9d354bc6bce8f9d1adfb95405eb09da2f442f43.\n\nRevert \"Bug 2075947 - Part 1: Reset the time stretcher after its flushed output has played. r=padenot\"\n\nThis reverts commit 4af9830f075405db00bdfb6f0c1eb1cca0187f94.\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h", "dom/media/docs/AudioStream.md", "dom/media/gtest/TestAudioStream.cpp"], "git_node": "6b0d5d29d7116138455986f5f2a4fe78ebaedee8", "git_parents": ["df4ea37a440b1f6e5ebe609144face369824dd78"], "node": "889fbe47def231e6736c44b71f370feb72ae60e1", "parents": ["13bed3912a11038eb8c9c2ae5d3f113bebbdeb7c"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087060 [Wayland] Move Gtk specific parts of nsWindowWayland to nsWindowWaylandGtk r=emilio,gtk-reviewers\" for causing build bustages on SHMBufSurface.h.\n\nThis reverts commit dde367bdbb006bea2210ffedf07717eec8291bdb.\n", "files": ["widget/gtk/moz.build", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h", "widget/gtk/nsWindowWaylandGtk.cpp", "widget/gtk/nsWindowWaylandGtk.h"], "git_node": "3a7c82f31063c637ecfdad4f5050fc02c8beb019", "git_parents": ["6b0d5d29d7116138455986f5f2a4fe78ebaedee8"], "node": "a4873b263519d6732a27339967bb3e26f3554272", "parents": ["889fbe47def231e6736c44b71f370feb72ae60e1"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084930. Make the mochitest pywebsocket3 work on Python 3.15. r=jgraham\n\nPython 3.15 removed http.server.CGIHTTPRequestHandler, which\nWebSocketRequestHandler subclasses, so the mochitest websocket server dies on\nstartup. Its stderr is discarded, so websocket tests just fail with onerror.\n\nMochitest doesn't use pywebsocket3's CGI support, so subclass\nSimpleHTTPRequestHandler instead, on every Python version so that CI runs the\nsame code as 3.15. Passing CGI paths to standalone.py now exits with an error.\n\nCaptured as cgi_py315.patch so re-vendoring keeps it. This matches the change\nto wpt's copy in https://github.com/web-platform-tests/wpt/pull/64027.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336151\n", "files": ["testing/mochitest/pywebsocket3/cgi_py315.patch", "testing/mochitest/pywebsocket3/mod_pywebsocket/request_handler.py", "testing/mochitest/pywebsocket3/mod_pywebsocket/standalone.py", "testing/mochitest/pywebsocket3/moz.yaml"], "git_node": "3495d95b0a9dd5560c26734372db2734a4fd89bb", "git_parents": ["3a7c82f31063c637ecfdad4f5050fc02c8beb019"], "node": "12e0b191582b1466d05dcfd1e6fa0aaca8868cde", "parents": ["a4873b263519d6732a27339967bb3e26f3554272"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2087135 - end playback whenever we attempt starting a new listen session r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338981\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt"], "git_node": "a481eb4f336cba4799c876b2a68ff97ee5877c30", "git_parents": ["3495d95b0a9dd5560c26734372db2734a4fd89bb"], "node": "e4c2b2660d02d140d76438a37be760e542db0995", "parents": ["12e0b191582b1466d05dcfd1e6fa0aaca8868cde"], "tags": []}, {"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085768 - Remove the rule forbidding emoji in code r=ai4dev-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339091\n", "files": ["AGENTS.md"], "git_node": "bc213d4e7663216019b60ff81a771853b32c4d8f", "git_parents": ["a481eb4f336cba4799c876b2a68ff97ee5877c30"], "node": "1655e8010cae9a1feca3bda5cff77c774d043ebe", "parents": ["e4c2b2660d02d140d76438a37be760e542db0995"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1674342 - [DevTools] Enable worker targets by default and stop debugging worker console message from the main thread. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336736\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-breaking-from-console.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "9f71c36bb5eb805744fc6f25b71cfbedcf543d38", "git_parents": ["bc213d4e7663216019b60ff81a771853b32c4d8f"], "node": "03aea4f074eb89a71bb802ec7bfc484428cb8a90", "parents": ["1655e8010cae9a1feca3bda5cff77c774d043ebe"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1603205 - [devtools] Remove windowless-service worker preference. r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nAlways consider (service) workers debuggable in the application panel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337263\n", "files": ["devtools/client/aboutdebugging/src/actions/debug-targets.js", "devtools/client/aboutdebugging/src/actions/runtimes.js", "devtools/client/aboutdebugging/src/components/debugtarget/ServiceWorkerAction.js", "devtools/client/aboutdebugging/src/components/debugtarget/ServiceWorkerAdditionalActions.js", "devtools/client/aboutdebugging/src/modules/client-wrapper.js", "devtools/client/aboutdebugging/src/types/runtime.js", "devtools/client/application/initializer.js", "devtools/client/application/src/actions/workers.js", "devtools/client/application/src/components/service-workers/Registration.js", "devtools/client/application/src/components/service-workers/RegistrationList.js", "devtools/client/application/src/components/service-workers/Worker.js", "devtools/client/application/src/components/service-workers/WorkersPage.js", "devtools/client/application/src/modules/application-services.js", "devtools/client/application/src/reducers/workers-state.js", "devtools/client/application/test/browser/browser.toml", "devtools/client/application/test/browser/browser_application_panel_viewsource-service-worker.js", "devtools/client/application/test/node/components/service-workers/__snapshots__/components_application_panel-Registration.test.js.snap", "devtools/client/application/test/node/components/service-workers/__snapshots__/components_application_panel-RegistrationList.test.js.snap", "devtools/client/application/test/node/components/service-workers/__snapshots__/components_application_panel-WorkersPage.test.js.snap", "devtools/client/application/test/node/components/service-workers/components_application_panel-Registration.test.js", "devtools/client/application/test/node/components/service-workers/components_application_panel-RegistrationList.test.js", "devtools/client/application/test/node/components/service-workers/components_application_panel-Worker.test.js", "devtools/client/application/test/node/components/service-workers/components_application_panel-WorkersPage.test.js", "devtools/client/application/test/xpcshell/test_workers_reducer.js", "devtools/client/debugger/panel.js", "devtools/client/debugger/src/client/firefox.js", "devtools/client/debugger/src/utils/prefs.js", "devtools/client/debugger/test/mochitest/browser_dbg-service-workers-reload.js", "devtools/client/debugger/test/mochitest/browser_dbg-service-workers.js", "devtools/client/debugger/test/mochitest/browser_dbg-windowless-service-workers-reload.js", "devtools/client/debugger/test/mochitest/browser_dbg-windowless-service-workers.js", "devtools/client/debugger/test/mochitest/browser_qz.toml", "devtools/client/locales/en-US/aboutdebugging.ftl", "devtools/server/actors/device.js", "modules/libpref/init/all.js"], "git_node": "ed64659aea12c28eb1878e23594005fd6db0026e", "git_parents": ["9f71c36bb5eb805744fc6f25b71cfbedcf543d38"], "node": "5cb725668cc775dcb8f232e6dc00950f8c41efde", "parents": ["03aea4f074eb89a71bb802ec7bfc484428cb8a90"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1843272 - [devtools] Enable service worker debugging at toolbox startup. r=devtools-reviewers,nchevobbe\n\nThis allows to see service worker messages in the console without having\nto open the debugger.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337264\n", "files": ["devtools/client/webconsole/test/browser/_jsterm.toml", "devtools/client/webconsole/test/browser/_webconsole_lz.toml", "devtools/client/webconsole/test/browser/browser_jsterm_evaluation_context_selector.js", "devtools/client/webconsole/test/browser/browser_jsterm_evaluation_context_selector_targets_update.js", "devtools/client/webconsole/test/browser/browser_webconsole_service_worker.js", "devtools/client/webconsole/test/browser/test-console-evaluation-context-selector.html", "devtools/client/webconsole/test/browser/test-service-worker.html", "devtools/client/webconsole/test/browser/test-service-worker.js", "devtools/shared/commands/target/target-command.js"], "git_node": "e38e77936a17e8d8e8c0a0a1cc5074c0ef0bbf96", "git_parents": ["ed64659aea12c28eb1878e23594005fd6db0026e"], "node": "98e592e2570363690d909ccf09245c2b8eb0f47f", "parents": ["5cb725668cc775dcb8f232e6