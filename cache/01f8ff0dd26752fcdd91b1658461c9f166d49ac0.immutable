ection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338536\n", "files": ["toolkit/components/translations/actors/TranslationsEngineParent.sys.mjs", "toolkit/components/translations/tests/browser/browser_translations_engine_lifetime.js", "toolkit/components/translations/tests/browser/shared-head.js"], "git_node": "22764d09e3219da84695bebdd71f09851027544a", "git_parents": ["23d58ea94e40fc6d71c1a278ca8d7e0efc67208e"], "node": "d34fc57d53bc12a6efcb76478ec0e4aa04bd9005", "parents": ["e450a44ae8d153955c2a8f05563e0e6deee4f58c"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086022 - Refactor full-page Translations eligibility checks to accept a browser r=gregtatum,translations-reviewers\n\nThis commit decouples full-page Translations eligibility checks from the\ntab browser, preserving existing behavior while allowing the following\ncommit to enforce page restrictions within individual Translations actors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338537\n", "files": ["browser/base/content/browser.js", "browser/components/translations/content/fullPageTranslationsPanel.js", "browser/components/translations/content/selectTranslationsPanel.js", "browser/components/translations/tests/browser/head.js", "toolkit/components/translations/actors/TranslationsParent.sys.mjs"], "git_node": "093f7e4b6d9106d26ff01e11726eb0bc741806a8", "git_parents": ["22764d09e3219da84695bebdd71f09851027544a"], "node": "d515995219cabafb34a6aea55e0cb6dbf1d26f17", "parents": ["d34fc57d53bc12a6efcb76478ec0e4aa04bd9005"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086022 - Prevent full-page translations on PDF documents r=gregtatum,translations-reviewers\n\nThis commit ensures that page-eligibility restrictions are enforced\nthroughout full-page Translations by checking eligibility before offering\nor starting a translation, preventing PDFs from showing the Translations\nURL-bar button or auto-translating.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338538\n", "files": ["browser/components/translations/content/fullPageTranslationsPanel.js", "browser/components/translations/tests/browser/browser_full.toml", "browser/components/translations/tests/browser/browser_translations_full_page_pdf_is_restricted.js", "browser/components/translations/tests/browser/head.js", "toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/tests/browser/browser.toml", "toolkit/components/translations/tests/browser/translations-tester-es.pdf"], "git_node": "b105a4b0531f6c4d9b12944998b9fff21b36fd4e", "git_parents": ["093f7e4b6d9106d26ff01e11726eb0bc741806a8"], "node": "57c14d98d2364e546e1140da777710ee5f914c8f", "parents": ["d515995219cabafb34a6aea55e0cb6dbf1d26f17"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089039 - Move the site host into the response list in BounceTrackingState::OnBFCacheRestored (Coverity CID 1704432) r=emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339627\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp"], "git_node": "f9259c63a4d5ab5d2b708c024b9d32e06cfc0cea", "git_parents": ["b105a4b0531f6c4d9b12944998b9fff21b36fd4e"], "node": "b428a444fec59b45279d68ae62fe60f8e973666a", "parents": ["57c14d98d2364e546e1140da777710ee5f914c8f"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088891 - Reject with NS_ERROR_NOT_AVAILABLE when the content analysis service is missing in CheckUploadsInBatchMode (Coverity CID 1649492) r=dlp-reviewers,gstoll\n\nThe early return rejected with an uninitialized rv since the service\nlookup stopped setting it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339507\n", "files": ["toolkit/compo