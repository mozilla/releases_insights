esting/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_with_class_object_specific_selector-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_animation_with_timestamp-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_background_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_background_shorthand-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_color-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_outline_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_outline_shorthand-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_text-decoration_line-through-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_text-shadow-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_timestamp_future-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_timestamp_past-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_transition_with_timestamp-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_voice_attribute-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_white-space_normal_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_white-space_nowrap-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_white-space_pre-line_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_white-space_pre-wrap_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_white-space_pre_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_with_class-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_with_class_object_specific_selector-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/white-space_normal_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/white-space_nowrap_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/white-space_pre-line_wrapped-ref.html"], "git_node": "a1147b6a5ee6b778b7dd65c90642001562cdcfe7", "git_parents": ["8cb67b58a6ba0d97eeac21de383ffe878f1617fd"], "node": "87544e0a0dc862438af0fcc339e9c27682b152b3", "parents": ["fc59a8c2110e48a05bba9cb69a7a6daf84959e41"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082838 [wpt PR 63743] - Update wpt metadata, a=testonly\n\nwpt-pr: 63743\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/portrait.tentative.html.ini"], "git_node": "e3b4e8e291d3685d9726b5267cbb4929d6619ecb", "git_parents": ["a1147b6a5ee6b778b7dd65c90642001562cdcfe7"], "node": "4e9f44bcbfe2e960a81e969aed1409b73054e426", "parents": ["87544e0a0dc862438af0fcc339e9c27682b152b3"], "tags": []}, {"author": "Viktoriya Bryhider \u003cvbryhider@microsoft.com\u003e", "branch": "default", "desc": "Bug 2082841 [wpt PR 63745] - WebTransport: wpt test for WebTransportReceiveStream, a=testonly\n\nAutomatic update from web-platform-tests\nWebTransport: wpt test for WebTransportReceiveStream\n\nAdd WPT coverage for WebTransportReceiveStream.getStats() on\nunidirectional and bidirectional server-created streams. Verify that\nbytesReceived and bytesRead reflect the complete stream payload.\n\nAlso cover partial BYOB reads followed by cancellation to ensure the\nreported counters remain bounded and preserve the number of bytes read.\n\nBug: 510589920\nChange-Id: I1a5dd2211c0568767bbbf75b5ad476b6dd69dbb9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8505556\nReviewed-by: Nidhi Jaju \u003cnidhijaju@chromium.org\u003e\nCommit-Queue: Viktoriya Bryhider \u003cvbryhider@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1720087}\n\n--\n\nwpt-commits: 3093d4556637b69a569cb53499b095384cb035e8\nwpt-pr: 63745\n", "files": ["testing/web-platform/tests/webtransport/receive-stream-stats.https.any.js"], "git_node": "0cb3fe019ab8965edc200d7edb358dcb903f2e39", "git_parents": ["e3b4e8e291d3685d9726b5267cbb4929d6619ecb"], "node": "061580d7a1399b48b9785aef498b003591cca4e8", "parents": ["4e9f44bcbfe2e960a81e969aed1409b73054e426"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082841 [wpt PR 63745] - Update wpt metadata, a=testonly\n\nwpt-pr: 63745\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webtransport/bidirectional-cancel-crash.https.html.ini", "testing/web-platform/meta/webtransport/receive-stream-stats.https.any.js.ini"], "git_node": "876aa7778acac61791ad5acbc13bd567d6d50b73", "git_parents": ["0cb3fe019ab8965edc200d7edb358dcb903f2e39"], "node": "029dfda689dc7c0cac8a49bd1f82030e5b7085f5", "parents": ["061580d7a1399b48b9785aef498b003591cca4e8"], "tags": []}, {"author": "Christian Biesinger \u003ccbiesinger@chromium.org\u003e", "branch": "default", "desc": "Bug 2082845 [wpt PR 63746] - [WebBluetooth] Call requestDevice() after test_driver.click() in WPTs, a=testonly\n\nAutomatic update from web-platform-tests\n[WebBluetooth] Call requestDevice() after test_driver.click() in WPTs\n\nSince https://crrev.com/c/8416585 (\"[WebBluetooth] Check user\nactivation in the browser process\"), Chrome checks for transient\nactivation in the browser process as well as in the renderer. The\nrenderer tells the browser about the activation over LocalFrameHost,\nbut requestDevice() arrives over the separately bound\nWebBluetoothService pipe, so the browser can process the request first\nand reject it with \"Must be handling a user gesture to show a\npermission request.\" This makes the infrastructure/ Bluetooth tests\nfail intermittently on the upstream WPT CI. Under CPU load, it\nreproduces locally on every repetition of the directory.\n\nInstead of calling the callback from the click handler, wait for\ntest_driver.click() to finish. The activation is still valid then, and\nthe browser has processed the activation update.\n\nChange-Id: I7ea856c0e5b7defc93813fdb75395cb66b95b571\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8591262\nCommit-Queue: Christian Biesinger \u003ccbiesinger@chromium.org\u003e\nReviewed-by: Matt Reynolds \u003cmattreynolds@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720119}\n\n--\n\nwpt-commits: 273024c5eb625bb5be1e2ebc645ffa0cf4234b5a\nwpt-pr: 63746\n", "files": ["testing/web-platform/tests/bluetooth/resources/bluetooth-test.js", "testing/web-platform/tests/infrastructure/testdriver/bidi/bluetooth/resources/bidi-bluetooth-helper.js"], "git_node": "06304c8bdd8d378a74040239734226468d120d3a", "git_parents": ["876aa7778acac61791ad5acbc13bd567d6d50b73"], "node": "035ce36c57c68d28807dd14fb7a9072b6192bdf9", "parents": ["029dfda689dc7c0cac8a49bd1f82030e5b7085f5"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2082848 [wpt PR 63747] - Ignore default JPEG XL intensity_target values as content peak, a=testonly\n\nAutomatic update from web-platform-tests\nIgnore default JPEG XL intensity_target values as content peak\n\n255 means the field is absent from the codestream, so it never states\nthe content's peak. For PQ, encoders also write 10000 cd/m2 (PQ's own\nnominal peak) regardless of the content, so that is ignored too; HLG\nkeeps a stated 10000. Ignored values fall back to the 1000 cd/m2 tone\nmapping assumption.\n\nBug: 568825290\nChange-Id: I22f5e2a1abcbe199404df672b30fffac146b078d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8579993\nReviewed-by: ccameron chromium \u003cccameron@chromium.org\u003e\nCommit-Queue: Luca Versari \u003cveluca@google.com\u003e\nReviewed-by: Luca Versari \u003cveluca@google.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nSLSA-Policy-Verified: SLSA Policy Verification Service \u003cdevtools-gerritcodereview-exitgate@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1720133}\n\n--\n\nwpt-commits: d8b153fad69fc3c4d51f8b69cead3634da0c7380\nwpt-pr: 63747\n", "files": ["testing/web-platform/tests/jpegxl/hdr-pq-intensity-target.html", "testing/web-platform/tests/jpegxl/resources/generate_resources.sh", "testing/web-platform/tests/jpegxl/resources/pq_intensity_target_255.jxl"], "git_node": "6ca423f9b60bb2a24a793c9197f48d776e13598f", "git_parents": ["06304c8bdd8d378a74040239734226468d120d3a"], "node": "c00f11a99049bb7a95658dac05ce0daefbe9bcba", "parents": ["035ce36c57c68d28807dd14fb7a9072b6192bdf9"], "tags": []}, {"author": "Kristin Lee \u003ckristinlee@microsoft.com\u003e", "branch": "default", "desc": "Bug 2082857 [wpt PR 63748] - [\u003cinstall\u003e Element] Move oninstallresult to GlobalEventHandlers, a=testonly\n\nAutomatic update from web-platform-tests\n[\u003cinstall\u003e Element] Move oninstallresult to GlobalEventHandlers\n\nMove the feature-gated oninstallresult handler from\nHTMLInstallElement to GlobalEventHandlers. Since installresult bubbles,\nthis lets ancestor elements, Document, and Window handle the event while\npreserving install.oninstallresult and declarative\n\u003cinstall oninstallresult\u003e behavior.\n\nAdd native and web-platform coverage for inherited handler exposure,\nevent delegation, disabled-feature exposure, and declarative handlers.\n\nBug: 568337127, 454827186\nChange-Id: I6c9066f979947b456e578d584036491637e68716\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8543374\nCommit-Queue: Kristin Lee \u003ckristinlee@microsoft.com\u003e\nReviewed-by: Robert Paveza \u003cRob.Paveza@microsoft.com\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720135}\n\n--\n\nwpt-commits: 8d4a5465c256ae30cb52ebe396b94d6314ac3a95\nwpt-pr: 63748\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/install/install-element-event-handlers.tentative.html"], "git_node": "678c136c511b6633256c71ce69af59bdca112c93", "git_parents": ["6ca423f9b60bb2a24a793c9197f48d776e13598f"], "node": "d6ccf3eed92cf4f70b05af8c275bfb25988335a5", "parents": ["c00f11a99049bb7a95658dac05ce0daefbe9bcba"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082857 [wpt PR 63748] - Update wpt metadata, a=testonly\n\nwpt-pr: 63748\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/install/install-element-event-handlers.tentative.html.ini"], "git_node": "3a241343ff30eb8a7ffe29ac7863fae1bc8a7ec4", "git_parents": ["678c136c511b6633256c71ce69af59bdca112c93"], "node": "8e23e32bb0f02a519654627d02727c35ea4392dd", "parents": ["d6ccf3eed92cf4f70b05af8c275bfb25988335a5"], "tags": []}, {"author": "Chris Dumez \u003ccdumez@apple.com\u003e", "branch": "default", "desc": "Bug 2082566 [wpt PR 63705] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327456, a=testonly\n\nAutomatic update from web-platform-tests\nNon-ASCII Last-Event-ID request header values are UTF-8 encoded twice on Cocoa (#63705)\n\nOn Cocoa, the shared request header serialization UTF-8 encoded any non-ASCII\nLast-Event-ID value. Header values are byte strings, so this corrupted values set\nthrough fetch() or XMLHttpRequest (bug 327451). It also corrupted the EventSource\nheader on redirect, since the already encoded value read back from the NSURLRequest\nwas encoded again.\n\nMove the UTF-8 encoding into EventSource, which passes the encoded bytes as Latin-1\ncharacters, and remove the special case from the serialization code so header\nvalues round-trip unchanged.\n\nThe fetch() test still fails on GTK and WPE, where the soup backend UTF-8 encodes all\nheader values itself.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327456\n--\n\nwpt-commits: e58225abb92a4f3b2efa0f5ab6bb1dd99f3dfa73\nwpt-pr: 63705\n", "files": ["testing/web-platform/tests/eventsource/format-field-id-redirect.any.js", "testing/web-platform/tests/fetch/api/headers/header-values-last-event-id.any.js", "testing/web-platform/tests/fetch/api/resources/echo-header-bytes.py"], "git_node": "294c0ad4ade52ed45790bd3a41cc935e199c829e", "git_parents": ["3a241343ff30eb8a7ffe29ac7863fae1bc8a7ec4"], "node": "59e1b10f32e8c2b5e99a8ab2d2e0e7310ce31e59", "parents": ["8e23e32bb0f02a519654627d02727c35ea4392dd"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2082791 [wpt PR 63737] - Implement srcset 'h' descriptor and two-dimensional sizes, a=testonly\n\nAutomatic update from web-platform-tests\nImplement srcset 'h' descriptor and two-dimensional sizes\n\nImplements the parsing parts of\nhttps://github.com/whatwg/html/pull/13053 behind the\n`SrcsetTwoDimensionalSizes` runtime flag:\n\n- Represent a resolved source size as a `TargetBoxSize` (`width`,\n  optional `height`, and `object_fit`), and thread it through\n  `SizesAttributeParser`, `HTMLImageElement::SourceSize()`, the preload\n  scanner and `BestFitSource*`.\n  One-dimensional sizes populate only `width`, so this is a no-op\n  refactor for existing behavior.\n- Parse the `\u003cpositive-integer\u003eh` height descriptor in `srcset` when\n  paired with a `w` descriptor, and compute each candidate's source\n  concrete width from the `TargetBoxSize` and the candidate's aspect\n  ratio when fitting with `contain` or `cover`.\n- Parse the explicit `[contain | cover] \u003clength\u003e \u003clength\u003e` source size\n  syntax in `sizes`.\n\nMaking `sizes=\"auto\"` two-dimensional (using the box height and computed\n`object-fit`), and using the `width`/`height` attributes as a default\naspect ratio for candidates without an `h` descriptor, are implemented\nin follow-up CLs.\n\nBug: 572724710\nChange-Id: I17fd93318d0955fbb3d6ce8aed7d085174671ddd\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8559899\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1720204}\n\n--\n\nwpt-commits: d2727a54348e2af3f8fc7cbdfd4956d75927c938\nwpt-pr: 63737\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/sizes/sizes-2d.tentative.html"], "git_node": "9556ab13bff42244a654f263e4cbea691a586db9", "git_parents": ["294c0ad4ade52ed45790bd3a41cc935e199c829e"], "node": "0c74713bdbf7630f551e353ba718aa0734d8faaa", "parents": ["59e1b10f32e8c2b5e99a8ab2d2e0e7310ce31e59"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082791 [wpt PR 63737] - Update wpt metadata, a=testonly\n\nwpt-pr: 63737\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-img-element/sizes/sizes-2d.tentative.html.ini"], "git_node": "bda641dbee82ebd6cc525a0787c1902650353384", "git_parents": ["9556ab13bff42244a654f263e4cbea691a586db9"], "node": "829c7b0c32ae08c9a8e0a59e717b0de9b0847809", "parents": ["0c74713bdbf7630f551e353ba718aa0734d8faaa"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2082589 [wpt PR 63713] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327689, a=testonly\n\nAutomatic update from web-platform-tests\nU+FFFD should set the frameset-ok flag to \"not ok\"\n\nThe data and CDATA section states emit U+0000 NULL as a character token. Tree construction\nignores it, or in foreign content inserts U+FFFD for it, without setting the frameset-ok flag to\n\"not ok\". Our input stream preprocessor replaces U+0000 NULL with U+FFFD up front, unless it skips\nit, so tree construction exempted every U+FFFD from setting the flag. But U+FFFD in the input, or\nfrom a character reference, has to set it like any other character that is not whitespace.\n\nHave the tokenizer emit the U+FFFD that replaces U+0000 NULL in those two states as a character\ntoken of its own, marked as such, and have tree construction handle that token like U+0000 NULL.\nThe flag fits in existing padding, so neither token class grows.\n\nThis also stops us from inserting U+FFFD where the standard ignores U+0000 NULL: in HTML content\nafter a \"\u003c\" that does not start a tag, and in a CDATA section at an HTML integration point.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327689\n\n--\n\nwpt-commits: 4aa56d3beafc5655fa55491169eb14845b44eab3\nwpt-pr: 63713\n", "files": ["testing/web-platform/tests/html/syntax/parsing/resources/plain-text-unsafe.dat"], "git_node": "e2c8fa362264c2d3e1b649ffb33404acc6a25f9f", "git_parents": ["bda641dbee82ebd6cc525a0787c1902650353384"], "node": "9202d16a12e144ffa996c42aa3c251e2b4bf643f", "parents": ["829c7b0c32ae08c9a8e0a59e717b0de9b0847809"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2082893 [wpt PR 63652] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327534, a=testonly\n\nAutomatic update from web-platform-tests\nDeselecting the selected option of a dropdown box does not always select its first option\n\nWhen the selected option of a dropdown box gets deselected, for instance because its selected\nattribute is removed, HTMLSelectElement::optionSelectionStateChanged() selects the first option that\nisn't disabled, as the selectedness setting algorithm requires. It found that option with\nnextSelectableListIndex(), which doesn't fit:\n\n- Since 321896@main it skips options that aren't focusable when they are rendered with base\n  appearance, which is meant for keyboard navigation in a picker. When the picker is closed, no\n  option is rendered and so none is focusable, which left a base appearance dropdown box without a\n  selected option.\n- It returns a list index, which selectOption() takes as an option index. When an optgroup comes\n  before the first option, that selected another option.\n\nLook for the first option that isn't disabled directly, as recalcListItems() does.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327534\n\n--\n\nwpt-commits: 6ace6446dcb22a1201624259018ddfff2445e2c5\nwpt-pr: 63652\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-ask-for-reset-base-appearance.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-ask-for-reset.html"], "git_node": "d49896e06f7721086909822f00b91c773508ad35", "git_parents": ["e2c8fa362264c2d3e1b649ffb33404acc6a25f9f"], "node": "eb128342da99ac36ee2f8c6677f97e90701475d0", "parents": ["9202d16a12e144ffa996c42aa3c251e2b4bf643f"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2082896 [wpt PR 63651] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327532, a=testonly\n\nAutomatic update from web-platform-tests\nAn optgroup with a tabindex can't be focused in a base appearance picker\n\n307479@main made HTMLOptionElement::isFocusable() refuse focus only in a dropdown box with a native\npicker, but HTMLOptGroupElement::isFocusable() still refuses it in every dropdown box. So an optgroup\nwith a tabindex could be focused in a base appearance list box, but not in a base appearance picker,\nwhere it is rendered just the same. Make it match HTMLOptionElement::isFocusable().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327532\n\n--\n\nwpt-commits: c9511085f11569724183cc60dcedc2b1919357b7\nwpt-pr: 63651\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-optgroup-tabindex-focus.html"], "git_node": "d1972936b8eb6379f2b3538e4888d8c4aa550cc5", "git_parents": ["d49896e06f7721086909822f00b91c773508ad35"], "node": "56260a5d611bd464d1417528ce40aa0580d14c0b", "parents": ["eb128342da99ac36ee2f8c6677f97e90701475d0"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2082912 [wpt PR 63686] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327643, a=testonly\n\nAutomatic update from web-platform-tests\nSelecting an option as a user only sets its dirtiness with base appearance\n\nThe HTML Standard has the user picking an option, or toggling one in a select with multiple, set the\ndirtiness of the option, after which adding or removing its selected attribute no longer changes its\nselectedness. The selectedIndex and value setters set it for the option they select as well.\nHTMLSelectElement::pickOrToggleOption(), which clicking an option of a base appearance select,\naccess keys, and assistive technology use, only set it for base appearance. Nothing set it for the\nnative popup, the iOS picker, WebDriver, mouse and keyboard input in a list box, keyboard input and\ntype-ahead in a dropdown box, or the setters. 323382@main left this for a separate change.\n\nAdd SelectOptionFlag::MakeOptionDirty, for which selectOption() sets the dirtiness of the option it\nselects, and pass it for user-driven changes and from the setters. The selectedIndex setters of\nselect and HTMLOptionsCollection go through a new setSelectedIndexForBindings(), as other callers of\nsetSelectedIndex() restore an earlier selection. Unlike the option.selected setter, the setters set\nthe dirtiness even when the option is already selected, as the HTML Standard says.\nselect-setter-dirtiness.html checks each setter for an option that is already selected as well, and\nWebKit fails that check for the option.selected setter, which keeps the web compatibility exception\nof 300656@main.\n\nAlso set the dirtiness in updateListBoxSelection() for the options a list box selection change\napplies to, and in optionSelectedByUser() when the user picks the option that is already selected,\nas it returns before calling selectOption(). pickOrToggleOption() no longer sets it itself. A base\nappearance dropdown box with its picker closed shares keyboard input and type-ahead with a native\none, so those now set the dirtiness there too. Options that a selection change only deselects, such\nas the other options when clicking one in a select with multiple, are not picked or toggled, so\ntheir dirtiness stays as it was.\n\nSkip the new user interaction tests on iOS, which renders list boxes as dropdown boxes and has no\naccess keys, as for option-accesskey.html.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327643\n\n--\n\nwpt-commits: fded9bdb98b85331ac4e565a1799df865d107722\nwpt-pr: 63686\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/select-setter-dirtiness.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-user-selection-dirtiness.html", "testing/web-platform/tests/html/semantics/interactive-elements/commands/option/option-accesskey-dirtiness.html"], "git_node": "0de9855f752b2f25bc9444cdb3aa7dc13b3ecf27", "git_parents": ["d1972936b8eb6379f2b3538e4888d8c4aa550cc5"], "node": "0c0080767fd7659bc22ea241bc6726d94fbbcdfe", "parents": ["56260a5d611bd464d1417528ce40aa0580d14c0b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082912 [wpt PR 63686] - Update wpt metadata, a=testonly\n\nwpt-pr: 63686\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/select-setter-dirtiness.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/select-user-selection-dirtiness.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/commands/option/option-accesskey-dirtiness.html.ini"], "git_node": "3fc39a2e692dbe428e65bbf0a1ac2a3fe98b4bb6", "git_parents": ["0de9855f752b2f25bc9444cdb3aa7dc13b3ecf27"], "node": "9aaf4a97b66ed64747ca0c6da9e3c598b949ae5a", "parents": ["0c0080767fd7659bc22ea241bc6726d94fbbcdfe"], "tags": []}, {"author": "ChangSeok Oh \u003cchangseok@chromium.org\u003e", "branch": "default", "desc": "Bug 2082918 [wpt PR 63693] - [initial-letter] Fix block position when size is less than sink, a=testonly\n\nAutomatic update from web-platform-tests\n[initial-letter] Fix block position when size is less than sink\n\ncss-inline-3 positions an initial letter whose size is less than its\nsink to satisfy its over alignment [1], i.e. its top aligns with the\nfirst line (w3c/csswg-drafts#5329). Blink instead put the box at the end\nof the sink-th line, e.g. `initial-letter: 1.5 3` sat on the third line.\nComparing ceil(size) with the sink hid this for sizes like `2.51 3`.\n\nCompare the actual size with the sink, and place such a letter as a\n`size \u003e= sink` one without shifting the surrounding text. The initial\nletter box still spans its sink, so extend its exclusion to the end of\nthe sink-th line to keep the same lines wrapping around it.\n\nThe change is guarded by the new InitialLetterBlockPositioning runtime\nflag.\n\n[1] https://drafts.csswg.org/css-inline-3/#initial-letter-block-position\n\nTests:\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-over-sunk.html (new)\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vrl.html (new)\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vlr.html (new)\n\nBug: 573256240\nChange-Id: Ib28039553d0545188192314e1c1cac90f27c42bd\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8576478\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: ChangSeok Oh \u003cchangseok@chromium.org\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720386}\n\n--\n\nwpt-commits: bf0af913b81e09f6793fad8d6f90b6fb469d49f3\nwpt-pr: 63693\n", "files": ["testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vlr-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vlr.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vrl-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vrl.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-over-sunk.html"], "git_node": "2544c6b4c3c46778ec9d92a0e9a093797dce3489", "git_parents": ["3fc39a2e692dbe428e65bbf0a1ac2a3fe98b4bb6"], "node": "3922f2d3d9be3d431b3ba01922a410f4247fec55", "parents": ["9aaf4a97b66ed64747ca0c6da9e3c598b949ae5a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082918 [wpt PR 63693] - Update wpt metadata, a=testonly\n\nwpt-pr: 63693\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vlr.html.ini", "testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-over-sunk-vrl.html.ini", "testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-over-sunk.html.ini"], "git_node": "985415f7e3caa11f65d5e7a6f20dde83f5e1e8f1", "git_parents": ["2544c6b4c3c46778ec9d92a0e9a093797dce3489"], "node": "e231087ebe609d9fa17558b8eca78b0f84265000", "parents": ["3922f2d3d9be3d431b3ba01922a410f4247fec55"], "tags": []}, {"author": "mark a. foltz \u003cmfoltz@chromium.org\u003e", "branch": "default", "desc": "Bug 2082886 [wpt PR 63750] - [WebMCP] Reject executeTool() with granular DOMExceptions., a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Reject executeTool() with granular DOMExceptions.\n\nSpec change: https://github.com/webmachinelearning/webmcp/pull/339\n\nUpdates ModelContext.executeTool() to reject with specific DOMException\ntypes instead of UnknownError.\n\nImplementation details:\n- Moves ScriptToolErrorCode into script_tools.mojom for target-\n  renderer to browser-process reporting.\n- Introduces ExecuteRemoteScriptToolError in script_tools.mojom for\n  reporting a subset of errors to calling frames.\n- Updates WPT to verify the new exception behavior.\n\nBug: 509555636\nChange-Id: I64d89525ac15af05250971a1ccc76e5964b41084\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8546218\nReviewed-by: Fr \u003cbeaufort.francois@gmail.com\u003e\nReviewed-by: Alex Moshchuk \u003calexmos@chromium.org\u003e\nCommit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720407}\n\n--\n\nwpt-commits: 22b4a4dd5a1eef74f5675939449de3f796ab8c60\nwpt-pr: 63750\n", "files": ["testing/web-platform/tests/webmcp/declarative/executeTool-detach-toolactivated.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-invalid-input.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-no-autosubmit.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-respondWith-circular-object.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-respondWith-reject.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-respondWith.https.html", "testing/web-platform/tests/webmcp/declarative/unregister-during-executeTool.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-across-trees.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-detach-toolactivated.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-error-window-onerror.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-reentrant-cancellation.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-target-detachment.https.html", "testing/web-platform/tests/webmcp/imperative/executeTool-target-navigation.https.html", "testing/web-platform/tests/webmcp/imperative/permissions-policy.https.html", "testing/web-platform/tests/webmcp/imperative/tool-re-registration-race.https.html"], "git_node": "a8a59cd587cbfb01600f4a8990435b0066bcb876", "git_parents": ["985415f7e3caa11f65d5e7a6f20dde83f5e1e8f1"], "node": "7d8780a0511f9615aa7806e98bbb8fcd88969346", "parents": ["e231087ebe609d9fa17558b8eca78b0f84265000"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082886 [wpt PR 63750] - Update wpt metadata, a=testonly\n\nwpt-pr: 63750\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/getTools-imperative-annotations.https.html.ini"], "git_node": "db12c4b83ecda5890e255bf282660beb12514ca7", "git_parents": ["a8a59cd587cbfb01600f4a8990435b0066bcb876"], "node": "989e810366b038015c5fae02a57447d570d560e9", "parents": ["7d8780a0511f9615aa7806e98bbb8fcd88969346"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@abandonedwig.info\u003e", "branch": "default", "desc": "Bug 2082747 [wpt PR 63732] - wpt: Wait more than a single frame for a resize event, a=testonly\n\nAutomatic update from web-platform-tests\nwpt: Wait more than a single frame for a resize event\n\nNot all browsers can accomplish a client resize within a single\nanimation frame. In Servo this must first cycle through the embedder\nwhich might involve event loop iterations. Furthermore, the\nspecification doesn't say this should happen either.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@abandonedwig.info\u003e\n\n--\n\nwpt-commits: e54b2057dde28da0043dcc50a23c4f4cc8687543\nwpt-pr: 63732\n", "files": ["testing/web-platform/tests/visual-viewport/resize-event-order.html"], "git_node": "d162c2ef1f8bb5f2ea62c10138bb3bf094ed89a1", "git_parents": ["db12c4b83ecda5890e255bf282660beb12514ca7"], "node": "7753de39b54e7864a1369bdb847dc870d25c2c75", "parents": ["989e810366b038015c5fae02a57447d570d560e9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082747 [wpt PR 63732] - Update wpt metadata, a=testonly\n\nwpt-pr: 63732\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/visual-viewport/resize-event-order.html.ini"], "git_node": "772389fec608ad1f745fe014aa13df437b74a498", "git_parents": ["d162c2ef1f8bb5f2ea62c10138bb3bf094ed89a1"], "node": "9b7ea8c9112981598fbb7c24c6b74caccdcaff62", "parents": ["7753de39b54e7864a1369bdb847dc870d25c2c75"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 2080451 [wpt PR 63484] - Re-enable reftests for firefox_android, a=testonly\n\nAutomatic update from web-platform-tests\nRe-enable reftests for firefox_android\n\n--\nDouble number of reftest chunks for firefox_android\n\n--\n\nwpt-commits: 51b29f14a988cb4a5192453b164f42c5237732e3, 4ff00ef1db130b17abf7596a2085e5b622c9fa45\nwpt-pr: 63484\n", "files": ["testing/web-platform/tests/tools/ci/tc/tasks/test.yml", "testing/web-platform/tests/tools/ci/tc/tests/test_valid.py"], "git_node": "a5ac24aa187c3944a679460f4461f345087d1aa4", "git_parents": ["772389fec608ad1f745fe014aa13df437b74a498"], "node": "1384a4cffd2f27417a17353eb8b28fe8e3eaa853", "parents": ["9b7ea8c9112981598fbb7c24c6b74caccdcaff62"], "tags": []}, {"author": "Florian Rivoal \u003cgit@florian.rivoal.net\u003e", "branch": "default", "desc": "Bug 2082999 [wpt PR 63760] - line clamp and intrinsic sizing, a=testonly\n\nAutomatic update from web-platform-tests\nline clamp and intrinsic sizing (#63760)\n--\n\nwpt-commits: a12c3069d83ec25f4b420b729672e56bbcb164d8\nwpt-pr: 63760\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-intrinsic-size-001.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-intrinsic-size-002.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-intrinsic-size-003.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-intrinsic-size-004.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-text-intrinsic-size-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-text-intrinsic-size-002-ref.html"], "git_node": "4d43474dd276c77f1b986fc984a33986ab34ec17", "git_parents": ["a5ac24aa187c3944a679460f4461f345087d1aa4"], "node": "1aa78af65bcc366874dc160c3e97005a4423092c", "parents": ["1384a4cffd2f27417a17353eb8b28fe8e3eaa853"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2082846 [wpt PR 63741] - Fix WPT `percentage-height-calculation.html` to wait for image loading, a=testonly\n\nAutomatic update from web-platform-tests\nFix WPT `percentage-height-calculation.html` to wait for image loading\n\nThe test was already trying to preload an image so that its size would\nbe immediately known, but that doesn't work well in Servo.\n\nSo just wait for `load` events to be sure.\n\nSigned-off-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: 9fa14d902f08636ba939e330c8e11c61721986ce\nwpt-pr: 63741\n", "files": ["testing/web-platform/tests/quirks/percentage-height-calculation.html"], "git_node": "4f9c625030656429526ed2c1c91747dae87f9cea", "git_parents": ["4d43474dd276c77f1b986fc984a33986ab34ec17"], "node": "acbed90c792bced1245ba468e0c0487881d6fa23", "parents": ["1aa78af65bcc366874dc160c3e97005a4423092c"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2082669 [wpt PR 63716] - [wdspec] Remove 101 and 407 from BiDi network HTTP_STATUS_AND_STATUS_TEXT, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Remove 101 and 407 from BiDi network HTTP_STATUS_AND_STATUS_TEXT\n\n- Exclude 101 Switching Protocols and 407 Proxy Authentication Required\n  from HTTP_STATUS_AND_STATUS_TEXT in BiDi network WPTs.\n- The responseStarted and responseCompleted status tests issue a plain\n  window.fetch() to an origin server and await the response text. Per\n  the Fetch specification, 101 is an interim response for non-WebSocket\n  requests and 407 without a configured proxy is a network error, so\n  fetch() rejects rather than resolving with a final response.\n\nTAG=agy\n\nBug: 565712857\nCq-Include-Trybots: luci.chromium.try\u200b:linux-blink-rel,android-15-chrome-blink-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: Id2f58bd945d26d6939075341ce91b9a7ec537bb1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8578101\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720476}\n\n--\n\nwpt-commits: d3519c37fa17d5b2e27979fc2466c724660bdb9f\nwpt-pr: 63716\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/network/__init__.py"], "git_node": "d74fac9255d45874e39f118f43be0bce069b04c7", "git_parents": ["4f9c625030656429526ed2c1c91747dae87f9cea"], "node": "7253dcbaab30fbbaf897a2aa8dc0e25d04528b03", "parents": ["acbed90c792bced1245ba468e0c0487881d6fa23"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082669 [wpt PR 63716] - Update wpt metadata, a=testonly\n\nwpt-pr: 63716\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/network/add_data_collector/add_data_collector.py.ini"], "git_node": "131ded550f25b03eee8376d1f98ca5470b03b344", "git_parents": ["d74fac9255d45874e39f118f43be0bce069b04c7"], "node": "ad5a0f840f608bc1b15ec1a45791658ba2810a14", "parents": ["7253dcbaab30fbbaf897a2aa8dc0e25d04528b03"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2054282 [wpt PR 61231] - Test the inherited base URL of about: documents and their clones, a=testonly\n\nAutomatic update from web-platform-tests\nTest the inherited base URL of about: documents and their clones\n\nA \u003cbase\u003e in an about:blank or about:srcdoc document resolves against, and\nfalls back to, the base URL inherited from its initiator. A clone copies that\ninherited base URL, so a \u003cbase\u003e in a clone, including one inserted after\ncloning, resolves the same way. A document created by DOMParser gets the URL,\nbut not the inherited base URL. Also test that the inherited base URL is a\nsnapshot taken at creation.\n\nFor https://github.com/whatwg/dom/issues/454.\n\nSpecification changes: https://github.com/whatwg/html/pull/12674 & https://github.com/whatwg/dom/pull/1492\n--\n\nwpt-commits: ca4621ae41d6c113c449ca60cf1a64897b27e167\nwpt-pr: 61231\n", "files": ["testing/web-platform/tests/dom/nodes/Document-base-url-not-live.window.js", "testing/web-platform/tests/dom/nodes/Document-cloneNode-about-base-url-relative.window.js", "testing/web-platform/tests/dom/nodes/Document-cloneNode-srcdoc-base-url.window.js", "testing/web-platform/tests/domparsing/DOMParser-parseFromString-url-base-about.window.js"], "git_node": "73504436405e241bf4a8c2b4968380d1631e9319", "git_parents": ["131ded550f25b03eee8376d1f98ca5470b03b344"], "node": "ea064f6070f4310792632e80183de94c013fd03c", "parents": ["ad5a0f840f608bc1b15ec1a45791658ba2810a14"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054282 [wpt PR 61231] - Update wpt metadata, a=testonly\n\nwpt-pr: 61231\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/dom/nodes/Document-base-url-not-live.window.js.ini", "testing/web-platform/meta/dom/nodes/Document-cloneNode-about-base-url-relative.window.js.ini", "testing/web-platform/meta/dom/nodes/Document-cloneNode-srcdoc-base-url.window.js.ini"], "git_node": "1653b72d1f224aeb464d86bb75411ca0a1ad5eb3", "git_parents": ["73504436405e241bf4a8c2b4968380d1631e9319"], "node": "b5ab0b775b61069ef3a30d7b7bdde6801ec5ca1a", "parents": ["ea064f6070f4310792632e80183de94c013fd03c"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083126 [wpt PR 63759] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327658, a=testonly\n\nAutomatic update from web-platform-tests\nCSSUnitValue for container query length units has a number type instead of length (#63759)\n\nThis patch aligns WebKit with Blink / Chromium.\n\nCSSNumericType::create() did not handle the container query length units\n(cqw, cqh, cqi, cqb, cqmin, cqmax) because unitCategory() classified them as\nCSSUnitCategory::Other. The CSSUnitValue constructor then fell back to a\ndefault CSSNumericType, which is the \u003cnumber\u003e type. As a result,\nCSS.cqw(1).type() returned {} instead of {length: 1}, adding a container\nlength to a number did not throw, and multiplying or dividing container\nlengths produced the wrong type.\n\nAdd CSSUnitCategory::ContainerPercentageLength, classify the container query\nlength units under it, and treat it as length in CSSNumericType::create().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327658\nWebKit-Canonical-Link: https://commits.webkit.org/323949@main\n--\n\nwpt-commits: c3c17d0e9c2786c4f0ad9af9b04578ebc9f8dd3f\nwpt-pr: 63759\n", "files": ["testing/web-platform/tests/css/css-typed-om/container-length-units-type.html"], "git_node": "c752f481e5695ca42423846c94e62fa283e71f43", "git_parents": ["1653b72d1f224aeb464d86bb75411ca0a1ad5eb3"], "node": "371ea6da9a8d368d5d1fbc071c174ba7130cec8b", "parents": ["b5ab0b775b61069ef3a30d7b7bdde6801ec5ca1a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083126 [wpt PR 63759] - Update wpt metadata, a=testonly\n\nwpt-pr: 63759\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-typed-om/container-length-units-type.html.ini"], "git_node": "f411ab69c530d6dd7cdcd38988b309929046085a", "git_parents": ["c752f481e5695ca42423846c94e62fa283e71f43"], "node": "9e1bdd69e02b9a82fd61bb6a593cd81ce396634c", "parents": ["371ea6da9a8d368d5d1fbc071c174ba7130cec8b"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083104 [wpt PR 63757] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327642, a=testonly\n\nAutomatic update from web-platform-tests\nSelectorFilter hashes original-case attribute names of HTML elements in XHTML, causing ancestor selectors with mixed-case attributes to be wrongly rejected (#63757)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nSelectorFilter::collectElementIdentifierHashes() hashed attribute.localName()\nfor HTML elements and attribute.localNameLowercase() for everything else,\nwhile collectSimpleSelectorHash() always hashes the lowercase name of the\nselector's attribute. In HTML documents the two agree because attribute names\nare already lowercased by the parser and setAttribute(). In XHTML documents\nHTML elements keep the original case of attribute names, so \u003cdiv fooBar=\"1\"\u003e\nwas hashed as \"fooBar\" and the selector [fooBar] as \"foobar\". The ancestor\nfilter then concluded no ancestor could match and rejected rules such as\n`[fooBar] .child` and `[fooBar] \u003e .child` before the real matcher ran, even\nthough attribute names of HTML elements in XML documents are compared\ncase-sensitively by their original case and do match.\n\nAlways hash the lowercase attribute name on the element side. The filter only\nneeds to avoid false negatives; a lowercase collision between e.g. fooBar and\nfoobar is still resolved by the selector matcher.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327642\nWebKit-Canonical-Link: https://commits.webkit.org/323947@main\n--\n\nwpt-commits: 23a79ebe54a2df0b53c7a49bfe2820ad5a74fa35\nwpt-pr: 63757\n", "files": ["testing/web-platform/tests/css/selectors/attribute-selectors/attribute-case/xhtml-mixed-case-attribute-ancestor.xhtml"], "git_node": "e85e50a5580eeb9f6e909a6efdd7b1854c929907", "git_parents": ["f411ab69c530d6dd7cdcd38988b309929046085a"], "node": "92cdd1134397dda02148f630ca1cfe0a86cbf2c2", "parents": ["9e1bdd69e02b9a82fd61bb6a593cd81ce396634c"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083118 [wpt PR 63758] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327041, a=testonly\n\nAutomatic update from web-platform-tests\nCSSMatrixComponent.toMatrix() returns the internal DOMMatrix for 3D matrices, so mutating the result mutates the component (#63758)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nFor a 3D CSSMatrixComponent, toMatrix() returned m_matrix directly instead of a new\nDOMMatrix. Script that mutated the result, e.g. `component.toMatrix().m41 = 100` or\n`component.toMatrix().translateSelf(...)`, silently modified the component's matrix,\nits serialization, and the result of toMatrix() on any enclosing CSSTransformValue.\nThe 2D path was unaffected because it already constructs a fresh flattened matrix.\n\nPer https://drafts.css-houdini.org/css-typed-om-1/#dom-csstransformcomponent-tomatrix\ntoMatrix() must return a new DOMMatrix. Return a clone on the 3D path as well.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327041\nWebKit-Canonical-Link: https://commits.webkit.org/323948@main\n--\n\nwpt-commits: 232615d58dbfee07893b231e9ed9acd07dc17b14\nwpt-pr: 63758\n", "files": ["testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssMatrixComponent-toMatrix-returns-new-matrix.html"], "git_node": "784d13de6afa67f3384adbc863b122954d2f2139", "git_parents": ["e85e50a5580eeb9f6e909a6efdd7b1854c929907"], "node": "5910fb45f924686d855c8664bc8f73d092b7123a", "parents": ["92cdd1134397dda02148f630ca1cfe0a86cbf2c2"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083058 [wpt PR 63754] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327166, a=testonly\n\nAutomatic update from web-platform-tests\nSMIL full clock values with more than 1193046 hours overflow during parsing (#63754)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nIn SVGSMILElement::parseClockValue(), the hours of a full clock value are\nparsed as an unsigned and multiplied by 60 * 60 in unsigned arithmetic, so\nany value above 1193046 hours wraps around. For example, dur=\"1193047:00:00\"\nwas parsed as 1904s instead of 4294969200s. Convert hours to double before\nmultiplying so the result doesn't wrap.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327166\nWebKit-Canonical-Link: https://commits.webkit.org/323932@main\n--\n\nwpt-commits: 61d8cf76e01f2ccc9e77b0a76e289b4c5383f016\nwpt-pr: 63754\n", "files": ["testing/web-platform/tests/svg/animations/smil-clock-value-large-hours.html"], "git_node": "ba31a660b1ea233dab94f2a19c0280d4a412d832", "git_parents": ["784d13de6afa67f3384adbc863b122954d2f2139"], "node": "ac8960931534476944f7b5187cfa643bd2007e64", "parents": ["5910fb45f924686d855c8664bc8f73d092b7123a"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083085 [wpt PR 63755] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327079, a=testonly\n\nAutomatic update from web-platform-tests\n-webkit-{min,max}-device-pixel-ratio serializes as {min,max}--webkit-device-pixel-ratio (#63755)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nThe media query parser stores `-webkit-min-device-pixel-ratio` as the feature\nname `-webkit-device-pixel-ratio` with a \u003e= comparison. The serializer then put\n`min-` in front of the whole name, giving `min--webkit-device-pixel-ratio`. That\noutput shows up in MediaQueryList.media, MediaList.mediaText and\nCSSMediaRule.conditionText. The same happened with `max-`.\n\nWhen a feature name starts with `-webkit-`, the serializer now writes the vendor\nprefix first and then `min-`/`max-`, so the original\n`-webkit-min-device-pixel-ratio` form round-trips. This matches the alias names\nin the Compat spec (https://compat.spec.whatwg.org/#css-media-queries-webkit-device-pixel-ratio)\nand what Chrome and Firefox output.\n\nThe parser still accepts `min--webkit-device-pixel-ratio`. The Compat spec says\n`min-`/`max-` prefixes must not apply to `-webkit-device-pixel-ratio`, but every\nengine accepts that form, so rejecting it would hurt compatibility. It is\ndeliberately left unchanged and untested.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327079\nWebKit-Canonical-Link: https://commits.webkit.org/323731@main\n--\n\nwpt-commits: 2c298327c60c55365113f0079c90b5261b6db632\nwpt-pr: 63755\n", "files": ["testing/web-platform/tests/compat/webkit-device-pixel-ratio-serialization.html"], "git_node": "21cb15dd3315d64eb32ac4ea73f8839d8480fbbc", "git_parents": ["ba31a660b1ea233dab94f2a19c0280d4a412d832"], "node": "7ef6ada5c200c742655c5e6a16ad51bfd431053e", "parents": ["ac8960931534476944f7b5187cfa643bd2007e64"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2083236 [wpt PR 63764] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326788, a=testonly\n\nAutomatic update from web-platform-tests\nNull dereference in CSSParser::parsePageSelector() when inserting an @page rule into a detached CSSGroupingRule\n\nWhen a CSSGroupingRule has been removed from its style sheet, insertRule() passes a null\nStyleSheetContents to CSSParser::parseRule(). @page is allowed at that level, so\nparsePageSelector() runs, and for any @page prelude that has a type selector\n(e.g. \"@page foo {}\") it dereferences styleSheet-\u003edefaultNamespace(), crashing.\n\nFall back to starAtom() when there is no style sheet, which is what\nCSSSelectorParser::defaultNamespace() does and the default namespace of a\nStyleSheetContents with no @namespace rule.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326788\nWebKit-Canonical-Link: https://commits.webkit.org/323133@main\n\n--\n\nwpt-commits: e3169255ca985e75098c33c4110b7e12ca577bdb\nwpt-pr: 63764\n", "files": ["testing/web-platform/tests/css/cssom/insertRule-page-detached-grouping-rule-crash.html"], "git_node": "98b259f849849d56c0d1be47e3612ae4f15a41f7", "git_parents": ["21cb15dd3315d64eb32ac4ea73f8839d8480fbbc"], "node": "1bda4e9b46765404d929153d52e3ba35c9808bb3", "parents": ["7ef6ada5c200c742655c5e6a16ad51bfd431053e"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2083240 [wpt PR 63766] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326607, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] GridLayoutResult should return the grid's used block size.\n\nWhen the grid container's block size is indefinite, GridFormattingContext\nreported the sum of its row sizes and row gaps as its block content size.\nThe integration code set that as the grid container's height, laid out\nthe out-of-flow boxes whose containing block is the grid container, and\nonly then called updateLogicalHeight(), which applies min-height and\nmax-height.\n\nThis meant that out-of-flow descendants were positioned and sized against\nthe grid container's height before min-height and max-height were applied.\n\nOne option would be to call updateLogicalHeight before running\nout-of-flow boxes but that would be papering over the problem. Now that\nI think about it running out-of-flow layout is probably one of the last\nthings we want to do in layout but we should probably address that\nseparately. The true problem is that when we compute the\nblockContentSize we return that as part of GridLayoutResult but it\nshould really be the used size which means the min/max sizes are\napplied.\n\nThis is important not only for the out-of-flow scenario that is\ncurrently impacted but we will also need to have the used block size if\nwe need to run a second iteration of GridSizer (e.g. if any of the row\nsizes are percent based).\n\nSo here when we compute the block content size we also apply the minimum\nand maximum constraints. We also rename the field on GridLayoutResult to\nmatch.\n\n(WebCore::Layout::GridFormattingContext::layout): Apply the grid container's\nmin-height and max-height to the block content size when the block axis is\nindefinite, and rename it to usedBlockContentSize.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326607\nWebKit-Canonical-Link: https://commits.webkit.org/323053@main\n\n--\n\nwpt-commits: 7c79206a0cf0484d60a5c492a56f319d96ff7d36\nwpt-pr: 63766\n", "files": ["testing/web-platform/tests/css/css-grid/abspos/grid-container-min-max-height-abspos-descendant-001.html"], "git_node": "f32aafd1dffa46cdb199fc09a7a82590c695237b", "git_parents": ["98b259f849849d56c0d1be47e3612ae4f15a41f7"], "node": "9dec24777d83fa50195ac260412c1ac5d7d3d6f3", "parents": ["1bda4e9b46765404d929153d52e3ba35c9808bb3"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083241 [wpt PR 63767] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=317318, a=testonly\n\nAutomatic update from web-platform-tests\n[replaced] min-width: max-content is ignored for a percentage-width replaced element's min-content contribution\n\nConsider a percentage-width replaced element with min-width: max-content inside a min-content-sized\ncontainer (the canvas has a 100px natural width):\n\n    \u003cdiv style=\"width: min-content\"\u003e\n      \u003ccanvas width=\"100\" height=\"100\" style=\"width: 50%; min-width: max-content\"\u003e\u003c/canvas\u003e\n    \u003c/div\u003e\n\nThe container should be 100px wide - it should hug the canvas - but before this change it collapsed\nto 0px and the canvas overflowed it.\n\nPer CSS Sizing 3 section 5.2.1, the canvas's \"width: 50%\" is a cyclic percentage (the container is\nsized to its contents), so it resolves against zero for the canvas's min-content contribution; that\ncontribution is then floored by the minimum size in its own axis.\nHere \"min-width: max-content\" floors it by the canvas's max-content size - its 100px natural width -\nso the min-content contribution, and therefore the \"width: min-content\" container, is 100px.\n\nRenderReplaced::computeIntrinsicLogicalWidthContributions() applied the explicit min/max-width\nconstraints to the contributions but only handled fixed lengths, dropping a min-content/max-content\nkeyword min-width. For a non-percentage width this was harmless, since the keyword min/max-width is\nalready resolved by computeReplacedLogicalWidthRespectingMinMaxWidth(); but for a percentage width the\nsecond pass is the only place min/max-width is applied, so the min-content contribution stayed at zero\nand the container collapsed to 0px.\n\nResolve a min-content/max-content keyword min-width when clamping the contributions, flooring by the\nbox's own min-content/max-content contribution. This matches RenderBox::constrainIntrinsicLogicalWidthsByMinMax().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=317318\nWebKit-Canonical-Link: https://commits.webkit.org/322974@main\n\n--\n\nwpt-commits: ea9e76cfa0ddf2dee7a66c3c919aceadeeee0d3a\nwpt-pr: 63767\n", "files": ["testing/web-platform/tests/css/css-sizing/replaced-percent-min-width-max-content.html"], "git_node": "0222b2c3163f0b4478c8401b53eaf9f3dbab9cc8", "git_parents": ["f32aafd1dffa46cdb199fc09a7a82590c695237b"], "node": "60bbf7120e48400dc00c3dd8f70a63d75c3284aa", "parents": ["9dec24777d83fa50195ac260412c1ac5d7d3d6f3"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083242 [wpt PR 63768] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326848, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Block boxes after the clamp point are still visible\n\n\u003cdiv style=\"line-clamp: 2\"\u003e\u003cdiv\u003eLine 1\u003cbr\u003eLine 2\u003cbr\u003eLine 3\u003c/div\u003e\u003cdiv style=\"background-color: red\"\u003eLine 4\u003c/div\u003e\u003c/div\u003e\n\nLine 3 is gone, but the red box after the clamp point (and its \"Line 4\") still paints.\n\"Within a line-clamp container, the following boxes and line boxes become invisible boxes: Any in-flow or floating boxes\nthat follow the clamp point in the box tree.\"\nhttps://drafts.csswg.org/css-overflow-4/#line-clamp-containers\n\nNow block layout marks each in-flow child that comes after the clamp point (the line-clamp budget is used up), and every\nrenderer in it, hidden by line-clamp, which makes their used visibility hidden. This happens before the child's own\nlayout and only when the child changes between visible and hidden, so the subtree is walked once per change, and a box\nthat stops being a line-clamp container shows its content again. An out-of-flow box in it is only hidden when its\ncontaining block is in it too (\"Any absolutely positioned box which has an invisible box within its containing block\nchain, and all of its descendants.\"). Inline display boxes now take their\nvisibility from the used style of their renderer, so text and inline boxes inside such a block are hidden too.\nThese boxes still take up space; that is a separate change.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326848\nWebKit-Canonical-Link: https://commits.webkit.org/323220@main\n\n--\n\nwpt-commits: 0a3b5d460cca8e70716b607eb6a997c16b5ea952\nwpt-pr: 63768\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-dynamic-removal.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-dynamic-removal-ref.html"], "git_node": "2e1af113647e14d1dc29b7a769c09c6973fe9582", "git_parents": ["0222b2c3163f0b4478c8401b53eaf9f3dbab9cc8"], "node": "72d2329faf9eebbf4a5af708bef8aebd3245299a", "parents": ["60bbf7120e48400dc00c3dd8f70a63d75c3284aa"], "tags": []}, {"author": "Antti Koivisto \u003cantti@apple.com\u003e", "branch": "default", "desc": "Bug 2083239 [wpt PR 63765] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326791, a=testonly\n\nAutomatic update from web-platform-tests\nMove used visibility to UsedStyle\n\nReplace ComputedStyle::usedVisibility() with UsedStyle::visibility() so that all clients asking\nwhether a box is visible get the same answer. Used visibility can depend on renderer state, for\nexample line-clamp invisible boxes, which a ComputedStyle accessor can't see.\n\nUsedStyle::visibility() returns a two-valued UsedVisibility. Outside table and flex layout,\nvisibility: collapse is the same as hidden. Clients comparing against Visibility::Hidden treated\ncollapse as visible, so collapsed SVG shapes and images were painted. Code without a box reads the\ncomputed style fields directly.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326791\nWebKit-Canonical-Link: https://commits.webkit.org/323110@main\n\n--\n\nwpt-commits: d0f576770a226547508ceae2494d436782021731\nwpt-pr: 63765\n", "files": ["testing/web-platform/tests/svg/painting/reftests/visibility-collapse-001-ref.html", "testing/web-platform/tests/svg/painting/reftests/visibility-collapse-001.html"], "git_node": "bda18c36b8bbe8278f256474d8d337f5f05372d0", "git_parents": ["2e1af113647e14d1dc29b7a769c09c6973fe9582"], "node": "e49232b94efab5a408ff79f7373c3815a0ece89d", "parents": ["72d2329faf9eebbf4a5af708bef8aebd3245299a"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083243 [wpt PR 63769] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326909, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Content before the clamp point that does not change loses its lines\n\n\u003cdiv style=\"line-clamp: 1\"\u003e\u003cp\u003eLine 1\u003c/p\u003e\u003cp id=\"after\"\u003eLine 2\u003c/p\u003e\u003c/div\u003e\n\u003cscript\u003edocument.body.offsetHeight; after.textContent = \"Line 2 changed\";\u003c/script\u003e\n\n\"Line 2 changed\" should stay after the clamp point. Content takes its lines off the line-clamp budget as it gets laid\nout, but the first paragraph does not need layout after the change, so it gets skipped and its line never comes off the\nbudget: the second paragraph then fits within the budget and shows up with the block ellipsis.\nNow every block that is part of a line-clamp container's formatting context lays out all of its children.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326909\nWebKit-Canonical-Link: https://commits.webkit.org/323225@main\n\n--\n\nwpt-commits: e1274a659746d031a22a0323127e209f8809a80d\nwpt-pr: 63769\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-dynamic-change-after-clean-content.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-dynamic-change-after-clean-content-ref.html"], "git_node": "78be082b2d8959a7d4975e2d824544f81e997eb0", "git_parents": ["bda18c36b8bbe8278f256474d8d337f5f05372d0"], "node": "a326c1506c98b6c5f28bab41df689ae661375f8c", "parents": ["e49232b94efab5a408ff79f7373c3815a0ece89d"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083246 [wpt PR 63771] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326521, a=testonly\n\nAutomatic update from web-platform-tests\nA percentage width child of a vertical writing mode box stops following the box's width after a style change\n\n  \u003cdiv style=\"writing-mode: vertical-rl; width: 50px; height: 100px\"\u003e\n    \u003cdiv style=\"width: 100%\"\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\nThe child should be 100px wide after the box grows to 100px. Instead it stayed 50px wide.\n\nRenderBox::styleDidChange cached isHorizontalWritingMode() to detect an orientation change, but RenderElement::styleWillChange had already reset that flag to horizontal.\nEvery style change on a vertical box (even a color change) looked like an orientation change and took the box's descendants out of the percentage height maps, so a later change of the box's width did not mark the child for layout.\n\nLet's compare the orientation of the old and the new style instead.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326521\nWebKit-Canonical-Link: https://commits.webkit.org/322964@main\n\n--\n\nwpt-commits: 0a8d5b0e0268d2e43d477cf9f4fe2f1e8d7abff1\nwpt-pr: 63771\n", "files": ["testing/web-platform/tests/css/css-writing-modes/vertical-containing-block-width-changes-ref.html", "testing/web-platform/tests/css/css-writing-modes/vertical-containing-block-width-changes.html"], "git_node": "d36967427b8e9c5d0b059d6ce92bd5ccef68c3da", "git_parents": ["78be082b2d8959a7d4975e2d824544f81e997eb0"], "node": "81759da03cfea47886d8e7dd44d0c8998d883cbb", "parents": ["a326c1506c98b6c5f28bab41df689ae661375f8c"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2083244 [wpt PR 63770] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326609, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] Resolve percentage and calc() min/max sizes on the grid container\n\nGFC only resolved fixed min-width/max-width/min-height/max-height values on the grid\ncontainer. Any other value, including percentages and calc(), hit ASSERT_NOT_IMPLEMENTED_YET.\nGrids with these values are not excluded from GFC, so for example a grid with an indefinite height,\nflexible rows and max-height: 80% grew its rows past the max-height instead of redoing the\nflex fraction against it.\n\nPercentages and calc() now resolve against the containing block. We get\nthe width from the grid's containing block which we use to resolve the\npercentages. For the height we ask the containing block for its\navailableLogicalHeightForPercentageComputation().\n\nbox-sizing is now applied inside minimumSizeConstraint/maximumSizeConstraint, so\nGridLayout::computeIntrinsicWidths also gets content box sizes. It previously passed the raw\nvalues through to the auto-repeat count. That has no effect until auto-repeat tracks are\nallowed through GFC.\n\n(WebCore::LayoutIntegration::minimumSizeConstraint): Resolve percentages and calc() against\nthe given size, and apply box-sizing.\n(WebCore::LayoutIntegration::maximumSizeConstraint): Ditto.\n(WebCore::LayoutIntegration::constraintsForGridContent): Pass the containing block's width and\nheight, and the border and padding, to the min/max helpers.\n(WebCore::LayoutIntegration::GridLayout::computeIntrinsicWidths): Ditto, which now also applies\nbox-sizing to the auto-repeat constraints.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326609\nWebKit-Canonical-Link: https://commits.webkit.org/323051@main\n\n--\n\nwpt-commits: 577010d55d133e8b84d524b396c0786c8bfbb00b\nwpt-pr: 63770\n", "files": ["testing/web-platform/tests/css/css-grid/grid-definition/grid-percentage-max-size-flex-rows-001.html", "testing/web-platform/tests/css/css-grid/grid-definition/grid-percentage-max-size-flex-rows-002.html"], "git_node": "3055e8cb891a08d3706ca31f4b89c2f288f6411c", "git_parents": ["d36967427b8e9c5d0b059d6ce92bd5ccef68c3da"], "node": "362f60b4783c4cae6c0574a73dcc5617d6a368b5", "parents": ["81759da03cfea47886d8e7dd44d0c8998d883cbb"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjya@apple.com\u003e", "branch": "default", "desc": "Bug 2083247 [wpt PR 63772] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325915, a=testonly\n\nAutomatic update from web-platform-tests\nWebCodecs computes wrong plane layouts for I422 and I444 VideoFrames\n\nvideoPixelFormatToSubSampling() returned one factor for both axes and gave\n2 for every chroma plane, so allocationSize() and copyTo() halved the chroma\nheight of I422 frames and both chroma dimensions of I444 frames, and\nverifyRectOffsetAlignment() rejected an odd y for I422. The byte width was\nalso computed by dividing by sampleWidth * sampleBytes, which only matched\nthe spec while every sample was one byte.\n\nThe horizontal and vertical sub-sampling factors are now separate, as the\nspec defines them: I422 chroma is 2x1 and I444 is not sub-sampled. I422 only\nrequires an even x offset, and the left and width bytes are the sample count\ndivided by the sub-sampling factor, multiplied by the sample size.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325915\nWebKit-Canonical-Link: https://commits.webkit.org/322972@main\n\n--\n\nwpt-commits: 9e50756e96a04a8575ea9724f64eccd284c472e9\nwpt-pr: 63772\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-copyTo-chroma-subsampling.any.js"], "git_node": "7223d99f5ef0eec69657278dd85975d2dc4e67d6", "git_parents": ["3055e8cb891a08d3706ca31f4b89c2f288f6411c"], "node": "5278e07309ff1cb4a7f96009411e7d02ee283bb9", "parents": ["362f60b4783c4cae6c0574a73dcc5617d6a368b5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083247 [wpt PR 63772] - Update wpt metadata, a=testonly\n\nwpt-pr: 63772\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/videoFrame-copyTo-chroma-subsampling.any.js.ini"], "git_node": "7159385dd37a12447423f722f77fc3ef8f271778", "git_parents": ["7223d99f5ef0eec69657278dd85975d2dc4e67d6"], "node": "f13c130dd77ebe1661af0de0d2ed90c16e023f70", "parents": ["5278e07309ff1cb4a7f96009411e7d02ee283bb9"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjya@apple.com\u003e", "branch": "default", "desc": "Bug 2083248 [wpt PR 63773] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325883, a=testonly\n\nAutomatic update from web-platform-tests\nWebCodecs ignores the bit depth and chroma subsampling in VP9 codec strings\n\nWebCodecsVideoDecoder and WebCodecsVideoEncoder accepted any codec string starting with \"vp09.00\", or\n\"vp09.02\" when VP9 profile 2 was enabled, without parsing the remaining fields. Strings missing the\nlevel or bit depth, strings whose bit depth or chroma subsampling contradicted the profile\n(vp09.00.10.10, vp09.02.10.08, vp09.00.10.08.03), and 12-bit profile 2 strings were reported as\nsupported; the decoder then dropped or corrupted the frames and the encoder produced a stream that did\nnot match.\n\nThe WebCodecs VP9 registration defines the codec string through the \"Codecs Parameter String\" section\nof the VP Codec ISO Media File Format Binding, which limits bit depth and chroma subsampling by\nprofile: profile 0 is 8-bit 4:2:0 and profile 2 is 10 or 12-bit 4:2:0. A string that violates this is\nnot a valid codec string, which Check Configuration Support step 1 requires to be unsupported. VP9\ncodec strings are now parsed with parseVPCodecParametersIgnoringColorFields(), which validates the\nmandatory fields and the chroma subsampling without requiring the color fields that follow, as\nWebCodecs strings commonly omit them. Profile 0 must be 8-bit and profile 2 must be 10-bit, both with\n4:2:0 chroma; 12-bit profile 2 is valid but not supported by either the decoder or the encoder.\n\nThe new WPT test covers the invalid strings, which every implementation must reject. The WebKit test\ncovers which valid strings WebKit supports.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325883\nWebKit-Canonical-Link: https://commits.webkit.org/322962@main\n\n--\n\nwpt-commits: 2f26f1cf30f568781f3f3b26a4e01a3e7e43a6c1\nwpt-pr: 63773\n", "files": ["testing/web-platform/tests/webcodecs/vp9-codec-string-profile-constraints.https.any.js"], "git_node": "d12eee8202bd3293795148ec70e885a851b54074", "git_parents": ["7159385dd37a12447423f722f77fc3ef8f271778"], "node": "0b38f71af37bff2b4543beffb978d1746307daaa", "parents": ["f13c130dd77ebe1661af0de0d2ed90c16e023f70"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083248 [wpt PR 63773] - Update wpt metadata, a=testonly\n\nwpt-pr: 63773\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/serialization-to-shared-and-service-workers.https.html.ini", "testing/web-platform/meta/webcodecs/vp9-codec-string-profile-constraints.https.any.js.ini"], "git_node": "c09dbbd7d7b26877654d5288ed6b4fd8125285de", "git_parents": ["d12eee8202bd3293795148ec70e885a851b54074"], "node": "dfa8b22d8cf56e1f495f35dcb7cac0d7cf3b4705", "parents": ["0b38f71af37bff2b4543beffb978d1746307daaa"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2083250 [wpt PR 63774] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326424, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] Grid container min/max sizes ignore box-sizing: border-box.\n\nconstraintsForGridContent() passed the grid container's computed min/max-width and\nmin/max-height straight to the track sizing algorithm, which works in terms of the\ncontent box. When the container has box-sizing: border-box these values include its\nborder and padding, so GFC overestimated the container's minimum and maximum content\nsize. For an indefinite block size this inflated the free space used to stretch auto\nrows and to clamp the flex fraction, making rows (and the grid) too tall.\n\nConvert the min/max sizes to content-box sizes with the same RenderBox helpers legacy\nlayout uses.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326424\nWebKit-Canonical-Link: https://commits.webkit.org/322856@main\n\n--\n\nwpt-commits: 4d86d7f8e1a79de0681b88246d232e98c1b83e30\nwpt-pr: 63774\n", "files": ["testing/web-platform/tests/css/css-grid/layout-algorithm/flex-sizing-rows-min-max-height-border-box-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-stretch-respects-min-size-002.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-stretch-respects-min-size-003.html"], "git_node": "6be1fd63f3d2bbf701a6a3ad686d7124eb23a6dc", "git_parents": ["c09dbbd7d7b26877654d5288ed6b4fd8125285de"], "node": "ae56aed79672aad548feaf2c93d54fad43e50ff6", "parents": ["dfa8b22d8cf56e1f495f35dcb7cac0d7cf3b4705"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083252 [wpt PR 63775] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326531, a=testonly\n\nAutomatic update from web-platform-tests\nChanging a table cell's width does not resize its row in a vertical writing mode table\n\n  \u003ctable style=\"writing-mode: vertical-rl; border-spacing: 0\"\u003e\n    \u003ctr\u003e\u003ctd id=\"cell\" style=\"width: 200px; height: 100px; padding: 0\"\u003e\u003c/td\u003e\u003c/tr\u003e\n  \u003c/table\u003e\n  \u003cscript\u003e\n    document.body.offsetTop;\n    cell.style.width = \"100px\";\n  \u003c/script\u003e\n\nThe cell should shrink to 100px wide. Instead it kept its 200px width.\n\nLet's compare the cell's size along the row's block axis.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326531\nWebKit-Canonical-Link: https://commits.webkit.org/322934@main\n\n--\n\nwpt-commits: 8cef50955a2de25a4bb76aaf88f4e5007716532f\nwpt-pr: 63775\n", "files": ["testing/web-platform/tests/css/css-tables/dynamic-table-cell-block-size-vertical-rl.html"], "git_node": "29143ff50797025cd0d97c68030f52bc05d82730", "git_parents": ["6be1fd63f3d2bbf701a6a3ad686d7124eb23a6dc"], "node": "1e9c879d9b038ae7202d0a3c1660b8ab52c38dcd", "parents": ["ae56aed79672aad548feaf2c93d54fad43e50ff6"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083253 [wpt PR 63776] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326198, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] ASSERT in RenderTreeNeedsLayoutChecker when all inline content is after the clamp point\n\n\u003cdiv style=\"line-clamp: 1\"\u003eLine 1\u003cdiv\u003e\u003cspan style=\"display: inline-block\"\u003e\u003c/span\u003eLine 2\u003c/div\u003e\u003c/div\u003e\n\nThe inner div's inline content all comes after the clamp point, so inline layout discards it without building a\nsingle line and returns no layout result. Without a result, the integration does not know the content was\ndiscarded and leaves the inline-block needing layout. Check the line-clamp budget when there is no result.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326198\nWebKit-Canonical-Link: https://commits.webkit.org/322753@main\n\n--\n\nwpt-commits: 4882c7a569fde24a3653a5f3e3b1ad801177e537\nwpt-pr: 63776\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-atomic-inline-after-clamp-point-crash.html"], "git_node": "b4c2317637b9081b1d5b64c98fad02d901ae5210", "git_parents": ["29143ff50797025cd0d97c68030f52bc05d82730"], "node": "d3b5a9d4d8e9faf10724a3abf444035c62edb595", "parents": ["1e9c879d9b038ae7202d0a3c1660b8ab52c38dcd"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083256 [wpt PR 63777] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325890, a=testonly\n\nAutomatic update from web-platform-tests\nA block-level aspect-ratio box inside a float grows when its content changes\n\n  \u003cdiv style=\"float: left\"\u003e\n    \u003cdiv style=\"aspect-ratio: 1\"\u003e\n      \u003cdiv style=\"height: 100%; aspect-ratio: 2\"\u003e\n        \u003cdiv style=\"width: 20px; height: 5px\"\u003e\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\nThe aspect-ratio box should stay 20px wide when its content changes. Instead it doubled on every change.\n\navailableLogicalHeightForPercentageComputation() derives the box's height from logicalWidth(), which still holds the previous layout's width while the box measures its own intrinsic widths.\nIt uses dirty bits to signal intrinsic width computation, and only for grid and shrink-to-fit boxes, so the float's measurement of this block-level box feeds the old width back in.\n\nLet's mark the box while it measures its own intrinsic widths instead, with IntrinsicLogicalWidthComputationScope (the inline-axis counterpart of IntrinsicLogicalHeightComputationScope), and bail out only inside that scope.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325890\nWebKit-Canonical-Link: https://commits.webkit.org/322742@main\n\n--\n\nwpt-commits: 1bee03cec09351fd7b362f03fc4347bc67e0c2e3\nwpt-pr: 63777\n", "files": ["testing/web-platform/tests/css/css-sizing/aspect-ratio/block-aspect-ratio-shrink-to-fit-ancestor-relayout-ref.html", "testing/web-platform/tests/css/css-sizing/aspect-ratio/block-aspect-ratio-shrink-to-fit-ancestor-relayout.html"], "git_node": "507b40ce3aed39f29fa31679906dfbb744802c9e", "git_parents": ["b4c2317637b9081b1d5b64c98fad02d901ae5210"], "node": "43b997acf9632c4ba7448a4b5ece28b82e0a0c38", "parents": ["d3b5a9d4d8e9faf10724a3abf444035c62edb595"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083257 [wpt PR 63778] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325509, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Changing the width of a line-clamp container shows the lines past the clamp point\n\n\u003cdiv id=container style=\"line-clamp: 2; width: 300px\"\u003e\u003cdiv\u003eLine 1\u003c/div\u003e\u003cdiv\u003eLine 2\u003c/div\u003e\u003cdiv\u003eLine 3\u003c/div\u003e\u003c/div\u003e\n\u003cscript\u003edocument.body.offsetHeight; container.style.width = \"200px\";\u003c/script\u003e\n\nLine 3 should stay hidden after the width change.\nEnsure that the remaining budget goes back to the parent state, the same way the legacy line clamp's does.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325509\nWebKit-Canonical-Link: https://commits.webkit.org/322600@main\n\n--\n\nwpt-commits: 0ab92b0a69f8e031523f7a9e1204fa3786ce5e0e\nwpt-pr: 63778\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-dynamic-width-change.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-dynamic-width-change-ref.html"], "git_node": "ca0d9205fe9b89ff785849f7ac0901c2ac939fdc", "git_parents": ["507b40ce3aed39f29fa31679906dfbb744802c9e"], "node": "b6898b2b7d9d741fbd8ba4a15ae97b746d531184", "parents": ["43b997acf9632c4ba7448a4b5ece28b82e0a0c38"], "tags": []}, {"author": "Roberto Rodriguez \u003croberto_rodriguez2@apple.com\u003e", "branch": "default", "desc": "Bug 2083258 [wpt PR 63779] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319577, a=testonly\n\nAutomatic update from web-platform-tests\nCSP keyword source expressions must match the whole token\n\nContentSecurityPolicySourceList::parseSource() checks a keyword source\nexpression such as 'self' or 'unsafe-inline' by testing only that the\ntoken starts with the keyword. A token with extra characters after a\nvalid keyword like 'unsafe-inline'X is treated as a normal keyword\ninstead of being rejected.\n\nFix by comparing each keyword, including 'none', against the whole token\nwith equalIgnoringASCIICase() instead of matching a prefix. A token that\ndoes not match a keyword exactly now falls through to host source\nparsing, which rejects it. This follows the CSP Level 3 grammar.\nhttps://w3c.github.io/webappsec-csp/#grammardef-keyword-source\n\nAdds a new test and updates two existing tests to account for this\nchange.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=319577\nWebKit-Canonical-Link: https://commits.webkit.org/322470@main\n\n--\n\nwpt-commits: 86e95f9d349a41040bee4f4fa491eafb859faee2\nwpt-pr: 63779\n", "files": ["testing/web-platform/tests/content-security-policy/parsing/keyword-source-with-trailing-characters.html"], "git_node": "4d6f2bf2cbaa0a95ff0f4b30fe5df8683dd446cc", "git_parents": ["ca0d9205fe9b89ff785849f7ac0901c2ac939fdc"], "node": "34725719659f6542c8430572fdc03b6b3c39694b", "parents": ["b6898b2b7d9d741fbd8ba4a15ae97b746d531184"], "tags": []}, {"author": "Brent Fulgham \u003cbfulgham@apple.com\u003e", "branch": "default", "desc": "Bug 2083261 [wpt PR 63781] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325832, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION (321748@main): a child with height: 100% inside an aspect-ratio row flex item resolves to auto\n\n362ed3e5e593 (321748@main) made the aspect-ratio bail-out apply to any\nshrink-to-fit box with invalid content logical widths. Every row flex item\nis shrink-to-fit, so a flex item with an aspect ratio lost the percentage\nheight of its children even during the real layout, where the flex container\nhas already set its overriding inline size. The Yahoo Sports player\ncontainer regressed this way, as it did before with 313727@main and its\nrevert in 314405@main.\n\nTherefore skip the sizesLogicalWidthToFitContent() arm of the bail-out for a\nflex item whose main axis is its inline axis and that has an\noverridingBorderBoxLogicalWidth. Whenever such an item's intrinsic widths\nare measured, including when a shrink-to-fit ancestor queries the flex\ncontainer, FlexItemDefiniteCrossSizeScope clears that override first, so the\nstale-width cases that 321748@main protects are still covered. An orthogonal\nflex item keeps its cross size as the inline override during intrinsic\npasses while logicalWidth() is still stale, so it stays under the bail-out.\nThe isRenderGrid() arm is unchanged.\n\nflex-aspect-ratio-row-percentage-height-child.html is the reduction of the\nbug: a height: 100% child of an aspect-ratio row flex item was 0px tall.\nflex-aspect-ratio-orthogonal-percentage-child.html checks that an orthogonal\naspect-ratio flex item, which stays under the bail-out, still sizes a\nblock-size: 100% child correctly across relayouts.\nflex-aspect-ratio-shrink-to-fit-ancestor-relayout.html puts the flex\ncontainer inside float, inline-block, table-cell and inline-grid ancestors,\nwhose intrinsic-width queries run between layouts, and checks that repeated\nrelayouts do not grow the aspect-ratio box.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325832\nWebKit-Canonical-Link: https://commits.webkit.org/322341@main\n\n--\n\nwpt-commits: 7346292d052079f5313c8303f64bc90a82865ca9\nwpt-pr: 63781\n", "files": ["testing/web-platform/tests/css/css-sizing/aspect-ratio/flex-aspect-ratio-orthogonal-percentage-child.html", "testing/web-platform/tests/css/css-sizing/aspect-ratio/flex-aspect-ratio-row-percentage-height-child.html", "testing/web-platform/tests/css/css-sizing/aspect-ratio/flex-aspect-ratio-shrink-to-fit-ancestor-relayout.html"], "git_node": "c8246b6ebe1b5fd703553b2c44418a5f72c4ab80", "git_parents": ["4d6f2bf2cbaa0a95ff0f4b30fe5df8683dd446cc"], "node": "32245624c619bac317624a913f42ca0bd635943a", "parents": ["34725719659f6542c8430572fdc03b6b3c39694b"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2083260 [wpt PR 63780] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325837, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC] fit-content() tracks with an indefinite percentage should not be stretched\n\nWhen the grid container's size in an axis is indefinite, percentages in\ntrack sizes are treated as auto. trackSizeWithPercentagesConvertedToAuto\napplied this to fit-content(\u003cpercentage\u003e) by replacing the whole track\nsize with auto, which is minmax(auto, auto). This makes the track\neligible for the \"Stretch auto tracks,\" portion of the track sizing\nalgorithm. As a result, a fit-content(50%) row in a grid with\nan auto height and a definite min-height was stretched to fill the\nmin-height.\n\nfit-content() is defined as the smaller of minmax(auto, max-content) and\nminmax(auto, limit), so with its limit treated as auto it reduces to\nminmax(auto, max-content). Convert it to that instead, which keeps the\ntrack from being stretched and matches the legacy grid implementation.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325837\nWebKit-Canonical-Link: https://commits.webkit.org/322421@main\n\n--\n\nwpt-commits: b0edf8ab147ecaccf29a61b3b4d92ef32e48f13f\nwpt-pr: 63780\n", "files": ["testing/web-platform/tests/css/css-grid/layout-algorithm/grid-fit-content-indefinite-percentage-not-stretched-001.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/grid-fit-content-indefinite-percentage-not-stretched-002.html"], "git_node": "5e34e9c37eabe4b399fd9e7b3821efe58e1e792b", "git_parents": ["c8246b6ebe1b5fd703553b2c44418a5f72c4ab80"], "node": "00d8e067aa4a08ff5070fb8ddb17e54a2c9c7e5b", "parents": ["32245624c619bac317624a913f42ca0bd635943a"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083262 [wpt PR 63782] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325418, a=testonly\n\nAutomatic update from web-platform-tests\naspect-ratio is ignored on out-of-flow boxes with height: fit-content / min-content / max-content\n\nIntrinsic sizing keywords behave as auto in the block axis, but computeOutOfFlowPositionedLogicalHeightUsing()\nresolved them against the content before reaching the aspect ratio branch. Check the aspect ratio first, like the in-flow path does.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325418\nWebKit-Canonical-Link: https://commits.webkit.org/322178@main\n\n--\n\nwpt-commits: 5f316b60635cca03f4cb6e28aa2b6a7ff67da923\nwpt-pr: 63782\n", "files": ["testing/web-platform/tests/css/css-sizing/aspect-ratio/abspos-intrinsic-block-size.html"], "git_node": "716d3f214f36f3a79e66944509cf4e95b5885025", "git_parents": ["5e34e9c37eabe4b399fd9e7b3821efe58e1e792b"], "node": "38aa0446e618e70753226e958cec15c9218e7acd", "parents": ["00d8e067aa4a08ff5070fb8ddb17e54a2c9c7e5b"], "tags": []}, {"author": "Sky Debreuil \u003cskydebreuil@google.com\u003e", "branch": "default", "desc": "Bug 2082777 [wpt PR 63734] - [css-overflow] Fix crash when scroll container status changes, a=testonly\n\nAutomatic update from web-platform-tests\n[css-overflow] Fix crash when scroll container status changes\n\nDescendants of an element with scroll-marker-group only generate\n::scroll-marker pseudo-elements while that element is a scroll\ncontainer. Blink did not treat becoming or ceasing to be a scroll\ncontainer as affecting descendants, so the markers were not created or\nremoved. The layout tree was not reattached either, so when layout\npopulated the new ::scroll-marker-group it could attach markers that\nstill had layout objects.\n\nThis hits DCHECK(!GetLayoutObject()) in\nPseudoElement::AttachLayoutTree().\n\nWhen scroll-marker-group is not 'none', treat a scroll container change\nas descendant-affecting and reattach the layout tree.\n\nThis CL removes the TestExpectations entries added in\nhttps://crrev.com/c/8465744.\n\nBug: 500793607\nChange-Id: I44aeda66f3f5551c3c47522406b3e4e1ede84aac\nCq-Include-Trybots: luci.chromium.try\u200b:linux-blink-web-tests-force-accessibility-rel,fuchsia-x64-accessibility-rel,linux-blink-rel,mac15.arm64-blink-rel,win11-blink-rel,android-15-chrome-blink-rel\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8427086\nCommit-Queue: Sky Debreuil \u003cskydebreuil@google.com\u003e\nAuto-Submit: Sky Debreuil \u003cskydebreuil@google.com\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nReviewed-by: Free Debreuil \u003cfreedebreuil@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1720658}\n\n--\n\nwpt-commits: de86b2b3c3e5a18f441a3b9bd3697f922bb1216c\nwpt-pr: 63734\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-003.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-004.html"], "git_node": "7a64f2599726feb32737f20e9df552b821d0290a", "git_parents": ["716d3f214f36f3a79e66944509cf4e95b5885025"], "node": "5b92e65ae342152d99b26628ca8b88cc5728f880", "parents": ["38aa0446e618e70753226e958cec15c9218e7acd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082777 [wpt PR 63734] - Update wpt metadata, a=testonly\n\nwpt-pr: 63734\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-003.html.ini", "testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-marker-group-scroll-container-change-004.html.ini"], "git_node": "f533f5b3198ac79f8c4350941d0fddd731729dd3", "git_parents": ["7a64f2599726feb32737f20e9df552b821d0290a"], "node": "e06fb95f72d009672a35226065b5bb5a53ed37fe", "parents": ["5b92e65ae342152d99b26628ca8b88cc5728f880"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2082677 [wpt PR 63718] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327702, a=testonly\n\nAutomatic update from web-platform-tests\nFrames in an about:blank popup are not secure contexts to the UI process\n\nSince 323290@main, the UI process assigns agent clusters and applies\nOrigin-Agent-Cluster only in a secure context, which it computes from the\ntop-level creation URL. It took the origin of that URL. For an iframe in a popup\nwhose top-level document is still the initial about:blank document, that URL is\nabout:blank or empty, so its origin was opaque and the iframe was never a secure\ncontext there. The Origin-Agent-Cluster header of an https iframe in such a\npopup was therefore ignored, even though the WebContent process considers the\niframe a secure context.\n\nHTML checks the top-level creation URL with \"Is url potentially trustworthy?\",\nwhich is true for about:blank. The UI process now does the same, treating an\nempty URL as about:blank.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327702\n\n--\n\nwpt-commits: df642c4142354ffb5a0af6fa41610677f6321092\nwpt-pr: 63718\n", "files": ["testing/web-platform/tests/html/browsers/origin/origin-keyed-agent-clusters/about-blank-popup.https.sub.html"], "git_node": "adb483cbcf623cd52f69e695a39092e18e028f8f", "git_parents": ["f533f5b3198ac79f8c4350941d0fddd731729dd3"], "node": "2b9cd82790cc1432fc701bef55481f3e5aeffd46", "parents": ["e06fb95f72d009672a35226065b5bb5a53ed37fe"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2083275 [wpt PR 63785] - c-v: Guard scroll anchor reset with CanDirtyStyle, a=testonly\n\nAutomatic update from web-platform-tests\nc-v: Guard scroll anchor reset with CanDirtyStyle\n\nNotifyPriorityScrollAnchorStatusChanged was originally only called\ninside if (CanDirtyStyle())\n\nCommit e9ce5a60247f2 inadvertently moved that call outside the if\n(CanDirtyStyle()) block.\n\nWhen a size container needs layout, style recalc for its subtree is\ndeferred until layout. Calling NotifyPriorityScrollAnchorStatusChanged\nduring this deferred style recalc clears the ancestor scroll anchor\nmid-layout before NotifyAfterLayout can restore the scroll offset.\n\nBug: 571658271\nChange-Id: Iaa83a602aab365258f157f835d98587e3df3a5b7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8576897\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720741}\n\n--\n\nwpt-commits: 9ee22aea471009026d678334605ee22c4b29ff6f\nwpt-pr: 63785\n", "files": ["testing/web-platform/tests/css/css-scroll-anchoring/content-visibility-hidden-in-size-container.html"], "git_node": "c4a12018889bb2e1a1d5d4318251a4a6564b25e7", "git_parents": ["adb483cbcf623cd52f69e695a39092e18e028f8f"], "node": "457a823f87ea0d48b48570531b8f11b36f093f97", "parents": ["2b9cd82790cc1432fc701bef55481f3e5aeffd46"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2083277 [wpt PR 63786] - WebMCP: Keep a form's declarative tool in sync with its registration, a=testonly\n\nAutomatic update from web-platform-tests\nWebMCP: Keep a form's declarative tool in sync with its registration\n\n`HTMLFormElement` holds an `active_webmcp_tool_` that it later\nunregisters from its document's `ModelContext`. But it could hold onto a\ntool that is not registered in two ways:\n\n1. When `ModelContext::RegisterDeclarativeTool()` silently rejects\n   registration, the form kept the tool anyway because `ModelContext`\n   never made the form aware of registration failure.\n2. A currently-being-removed form's\n   `ScheduleDeclarativeWebMCPToolRegistration()` method returned early\n   for documents without a frame. This means a form can keep a handle\n   to the tool it originally registered, while its window/document are\n   inactive. If the form was then adopted into another, active document,\n   then it might act on that document's `ModelContext`, but with the\n   old tool.\n\nThis CL establishes the invariant that `active_webmcp_tool_` is non-null\niff it is registered with the `ModelContext` of the form's document:\n\n - `RegisterDeclarativeTool()` returns whether the tool was registered,\n   and the form drops its tool if not. As a result, a later mutation of\n   a rejected form retries registration.\n - The frame and sandbox checks no longer short-circuit the\n   unregistration path, so a form always unregisters its tool when it\n   can no longer be a tool, including from a frameless document.\n - `UnregisterDeclarativeTool()` now `CHECK()`s that the tool is\n   registered, and like `UnregisterTool()`, only notifies the browser\n   when the document is active.\n\nThe guard in the last point mirrors https://crrev.com/c/8578418, which adds the same IsActive() check to the imperative UnregisterTool() path. There, the inactive-document unregistration is reachable from script by aborting a tool's AbortSignal after its iframe is removed. Here, it only becomes reachable because of the second point: before this CL, a form in a frameless document returned early and never unregistered, so UnregisterDeclarativeTool() never ran for an inactive document. Now that it can, it needs the same guard, since the inactive document's ModelContextHost remote has been reset.\n\nR=mfoltz\n\nBug: 509983792\nChange-Id: I57f2d144e962d84087075360bce91bef701d9bb6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8581732\nReviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720758}\n\n--\n\nwpt-commits: e61b072782cfcb8fe459849a86f3460efaa2dc9d\nwpt-pr: 63786\n", "files": ["testing/web-platform/tests/webmcp/declarative/adopt-form-from-removed-iframe.https.html", "testing/web-platform/tests/webmcp/declarative/duplicate-tool-name.https.html"], "git_node": "419600e4c3f1e92e1fe0045e10170cbce26d39a4", "git_parents": ["c4a12018889bb2e1a1d5d4318251a4a6564b25e7"], "node": "95107831872d7c00bcfa6ad4b550cbf2dd8cf557", "parents": ["457a823f87ea0d48b48570531b8f11b36f093f97"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083277 [wpt PR 63786] - Update wpt metadata, a=testonly\n\nwpt-pr: 63786\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/declarative/adopt-form-from-removed-iframe.https.html.ini", "testing/web-platform/meta/webmcp/declarative/duplicate-tool-name.https.html.ini"], "git_node": "501168bc62b5fb7d33aab7317b894054ec6290cd", "git_parents": ["419600e4c3f1e92e1fe0045e10170cbce26d39a4"], "node": "f8dd29c43e2310dcc3e853b734d0ec0c983ee8fc", "parents": ["95107831872d7c00bcfa6ad4b550cbf2dd8cf557"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2082858 [wpt PR 63744] - Change select element to have size attribute, a=testonly\n\nAutomatic update from web-platform-tests\nChange select element to have size attribute (#63744)\n\n* Change select element to have size attribute\n\nSimilar to pull #62881. Can't assume there is an accessible in a subtree of a collapsed select. Use `size` to make it an inline listbox.\n\n* Update html-aam/optgroup-role.tentative.html\n\nCo-authored-by: Valerie Young \u003cspectranaut@igalia.com\u003e\n\n---------\n\nCo-authored-by: Valerie Young \u003cspectranaut@igalia.com\u003e\n--\n\nwpt-commits: 261de0a2c8cbdb7c06566bfd74a71b0b50d4b7fc\nwpt-pr: 63744\n", "files": ["testing/web-platform/tests/html-aam/optgroup-role.tentative.html"], "git_node": "b2ddc5a776504f87b0ab997df95b368c57ca10b8", "git_parents": ["501168bc62b5fb7d33aab7317b894054ec6290cd"], "node": "011715420a1e11cf72a88dd9bb04c267b32a2ea4", "parents": ["f8dd29c43e2310dcc3e853b734d0ec0c983ee8fc"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2083282 [wpt PR 63788] - Re-enable mixed-content object-tag, img-tag and imageset WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRe-enable mixed-content object-tag, img-tag and imageset WPTs\n\ntop.http-rp/opt-in/object-tag.https.html and\ntop.meta/unset/img-tag.https.html now pass: upstream WPT commit\n39a9cbddfe03f dropped the timing-out swap-scheme \u003cobject\u003e redirect\nsubtests and regenerated the img-tag test to expect auto-upgrades.\nRemove their stale expectations.\n\nimageset.https.sub.html predates Mixed Content Level 2 autoupgrades.\n\u003cimg src=\"http://...\"\u003e is now upgraded to https://, so pointing it at\nthe plain HTTP port made the upgraded load fail its TLS handshake.\nUse the HTTPS port (same technique as common.sub.js's\n*-http-downgrade cases) and expect the upgraded https:// URL to load.\n\n\u003cpicture\u003e\u003csource srcset\u003e and \u003cimg srcset\u003e are blockable and are not\nupgraded. Blocked fetches still produce a resource timing entry, with\ntransferSize 0, so assert that those entries show no download\n(rather than that no entry exists), and that no upgraded https://\nrequest was made.\n\nBug: 40673371\nChange-Id: Iab3eb3653eed20a755d6efa6bb80761b00cb8dc7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8544979\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720778}\n\n--\n\nwpt-commits: d24a67f42e4fcaafd4143d4c46abf8175a8612b9\nwpt-pr: 63788\n", "files": ["testing/web-platform/tests/mixed-content/imageset.https.sub.html"], "git_node": "15176bbde1275ea8957d21433b63051eb148ad19", "git_parents": ["b2ddc5a776504f87b0ab997df95b368c57ca10b8"], "node": "c3b205f3c5caffad1dae2823ed083d90be52004c", "parents": ["011715420a1e11cf72a88dd9bb04c267b32a2ea4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083282 [wpt PR 63788] - Update wpt metadata, a=testonly\n\nwpt-pr: 63788\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/mixed-content/imageset.https.sub.html.ini"], "git_node": "a85b5638e62edfd720fd135ee726e933521e8eff", "git_parents": ["15176bbde1275ea8957d21433b63051eb148ad19"], "node": "9cd9bf843aaac28fbbf44e907a79c325fd800c6d", "parents": ["c3b205f3c5caffad1dae2823ed083d90be52004c"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2083347 [wpt PR 63791] - [wdspec] Fix BiDi detached node and preload script order WPTs, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Fix BiDi detached node and preload script order WPTs\n\n- Fix flaky failures in WebDriver BiDi detached-element input tests and\n  missing assertion in preload script ordering tests.\n- Detached DOM nodes returned without strong ownership can be garbage-\n  collected before input commands check them, and test_script_order\n  compared the console text without an assert keyword.\n- Request result_ownership=\"root\" for detached nodes and assert the\n  first console message in test_script_order.\n\nTAG=agy\n\nBug: 565712857\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,linux-blink-rel\nChange-Id: Ie66f8ecc371b0806d1b7790d748d1eccf55ab6af\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8598974\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720800}\n\n--\n\nwpt-commits: 672f0e8cf8f6b495cbfc80df0d5b4b876757cedf\nwpt-pr: 63791\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_origin.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/wheel_origin.py", "testing/web-platform/tests/webdriver/tests/bidi/input/set_files/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/script/add_preload_script/add_preload_script.py"], "git_node": "68e690958436c7721d4c75deb3ff635cf0ca5de8", "git_parents": ["a85b5638e62edfd720fd135ee726e933521e8eff"], "node": "aadf55475b4c77606c988c826a0821502295c2f6", "parents": ["9cd9bf843aaac28fbbf44e907a79c325fd800c6d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083347 [wpt PR 63791] - Update wpt metadata, a=testonly\n\nwpt-pr: 63791\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/duration.py.ini"], "git_node": "5fcae4bfcf35089c942a7a2a07d556f6ba359054", "git_parents": ["68e690958436c7721d4c75deb3ff635cf0ca5de8"], "node": "24241a80946ad66ccc076cdadb205f7b47bd1c2c", "parents": ["aadf55475b4c77606c988c826a0821502295c2f6"], "tags": []}, {"author": "Yury Semikhatsky \u003cyurys@chromium.org\u003e", "branch": "default", "desc": "Bug 2083394 [wpt PR 63797] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325524, a=testonly\n\nAutomatic update from web-platform-tests\nelement.checkVisibility() returns false for \u003coption\u003e and \u003coptgroup\u003e elements in a list box\n\nList box items are painted by the owning select's RenderListBox and have no\nrenderer of their own, so checkVisibility() returned false for them. Chrome\nand Firefox return true. getBoundingClientRect() and scrollIntoView() already\nspecial-case list box items the same way.\n\nTreat an option or optgroup whose owning select has a RenderListBox as\nrendered, and let the remaining checks decide. Options in a drop-down select\nkeep returning false.\n\nOn iOS every select is drawn as a picker button, never as a list box, so the\nlist box subtest fails there as expected.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325524\nWebKit-Canonical-Link: https://commits.webkit.org/323990@main\n\n--\n\nwpt-commits: 2350f6e793896ad880f57f68be57202d234d4e22\nwpt-pr: 63797\n", "files": ["testing/web-platform/tests/css/cssom-view/checkVisibility.html"], "git_node": "1d3f20058206d93f02e48ba3798a23714da4c672", "git_parents": ["5fcae4bfcf35089c942a7a2a07d556f6ba359054"], "node": "3816bc2ff9aae7aa393754d7751b2c7e65ce5b4f", "parents": ["24241a80946ad66ccc076cdadb205f7b47bd1c2c"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2083373 [wpt PR 63793] - [wdspec] Pass string context IDs in BiDi Bluetooth invalid WPTs, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Pass string context IDs in BiDi Bluetooth invalid WPTs\n\n- Pass string context IDs instead of context dictionaries in WebDriver\n  BiDi Bluetooth invalid-argument WPTs.\n- Those tests checked invalid non-context parameters while passing the\n  full top_context dictionary, which made the command fail on context\n  validation instead of the parameter under test.\n\nTAG=agy\n\nBug: 565712857\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nChange-Id: Ie89970fb431a19e4020dbc8bb1decb8a6a50158b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8595568\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1720870}\n\n--\n\nwpt-commits: baa53d799979b956a97f3f79d6993103e9b9149d\nwpt-pr: 63793\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/external/bluetooth/simulate_characteristic_response/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/external/bluetooth/simulate_gatt_connection_response/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/external/bluetooth/simulate_gatt_disconnection/invalid.py"], "git_node": "ab8992ef06202a186a8a567165ce9910a2c5b0e6", "git_parents": ["1d3f20058206d93f02e48ba3798a23714da4c672"], "node": "f15eab1a7a43404a229a2839d78e749d8c7c26b8", "parents": ["3816bc2ff9aae7aa393754d7751b2c7e65ce5b4f"], "tags": []}, {"author": "David Baron \u003cdbaron@chromium.org\u003e", "branch": "default", "desc": "Bug 2083388 [wpt PR 63794] - Make XPath node sorting a bit more robust against crashes., a=testonly\n\nAutomatic update from web-platform-tests\nMake XPath node sorting a bit more robust against crashes.\n\nThis implements the suggestions in the issue, although I'm a little bit\nskeptical about whether these will fix the crashes being seen in the\nwild.\n\nIn particular, this change updates both sorting codepaths (Sort and\nTraversalSort) to\n* handle detached Attr nodes\n* handle nodes that have different roots\n\nIt adds tests that things don't crash and behave reasonably to WPT, and\nalso adds some internal tests to assert about the sorting order I chose\nfor disconnected nodes (which is completely made up and not appropriate\nfor WPT).\n\nBug: 535260636\nChange-Id: Ia8dfac5475c5788133df20398d10876acc33c0e3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8564244\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721030}\n\n--\n\nwpt-commits: 0535c4b0bedb560555d955a78150ee07241c292f\nwpt-pr: 63794\n", "files": ["testing/web-platform/tests/dom/xpath-evaluation-detached-nodes.html"], "git_node": "32e905cf0a17013dbc559e50e48c5780f3afeae2", "git_parents": ["ab8992ef06202a186a8a567165ce9910a2c5b0e6"], "node": "a16ee405c9e9ce784523634144d98c36f0855645", "parents": ["f15eab1a7a43404a229a2839d78e749d8c7c26b8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083388 [wpt PR 63794] - Update wpt metadata, a=testonly\n\nwpt-pr: 63794\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/dom/xpath-evaluation-detached-nodes.html.ini"], "git_node": "35fb66a0c527374ab387aafe3e07685eb9ebf993", "git_parents": ["32e905cf0a17013dbc559e50e48c5780f3afeae2"], "node": "23c0a9c573c347136669479f29ba30a587529a99", "parents": ["a16ee405c9e9ce784523634144d98c36f0855645"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2083391 [wpt PR 63795] - Defer HTMLStream abort while the fragment parser is running, a=testonly\n\nAutomatic update from web-platform-tests\nDefer HTMLStream abort while the fragment parser is running\n\nAlign HTMLStream's abort algorithm with \"abort a fragment parser\" in the\nspec (whatwg/html#12758): if the parser is running when the\nstream is aborted, the abort is deferred until the current run returns,\nso the rest of the current chunk is still parsed and the stack of open\nelements is not popped in the middle of inserting a node.\n\nWhile a write() is in flight, the WritableStream already queues abort()\nbehind it. But after a parser-blocking external script, the parser\nresumes from a task with no write in flight, so abort() called from a\nstreamed inline script or a custom element reaction reached\nHTMLSink::abort synchronously, which called StopParsing() and Detach()\nwhile PumpTokenizer() was on the stack and dropped the rest of the\nchunk.\n\nHTMLDocumentParser::AbortFragmentParser() records the request while a\npump session is active and PumpTokenizerIfPossible() performs the abort\nonce the outermost pump returns. Outside a pump the behavior is\nunchanged.\n\nAdds external/wpt/domparsing/stream-html-reentrancy.html (and its\nresources/slow.js dependency) from web-platform-tests/wpt#61748 at its\nfinal, non-tentative path.\n\nR=masonf@chromium.org\n\nBug: 573252239, 491743369\nChange-Id: I9569555cbae7f5be0ca91b3b8ede5b1198a7ad66\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8579128\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721059}\n\n--\n\nwpt-commits: 286b7995a5a3028cee705b5e5f67b0a960dafd44\nwpt-pr: 63795\n", "files": ["testing/web-platform/tests/domparsing/resources/slow.js", "testing/web-platform/tests/domparsing/stream-html-reentrancy.html"], "git_node": "b38d1b5e7e6dc36db640b8ddb17443e2ee7795fc", "git_parents": ["35fb66a0c527374ab387aafe3e07685eb9ebf993"], "node": "017536f25b6eb1008458f9efd92984d7a12b8824", "parents": ["23c0a9c573c347136669479f29ba30a587529a99"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083391 [wpt PR 63795] - Update wpt metadata, a=testonly\n\nwpt-pr: 63795\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/stream-html-reentrancy.html.ini"], "git_node": "103a37f9da40daf3ad723c24de4e17583288d80b", "git_parents": ["b38d1b5e7e6dc36db640b8ddb17443e2ee7795fc"], "node": "ea9ca7fb9c515db06f88d52530237a8038b25e9a", "parents": ["017536f25b6eb1008458f9efd92984d7a12b8824"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2083409 [wpt PR 63805] - Throw HierarchyRequestError for HTML partial insertion methods on the html element, a=testonly\n\nAutomatic update from web-platform-tests\nThrow HierarchyRequestError for HTML partial insertion methods on the html element\n\nAlign the HTML insertion and streaming methods with the WHATWG HTML spec\n(\"filter and pre-insert HTML\", \"filter and replace with HTML\", and\nwhatwg/html#12758 for the streaming methods):\n\n- appendHTML{Unsafe}, prependHTML{Unsafe}, streamAppendHTML{Unsafe}\n  and streamPrependHTML{Unsafe} throw a \"HierarchyRequestError\"\n  DOMException when the target is an html element.\n- beforeHTML{Unsafe}, afterHTML{Unsafe}, replaceWithHTML{Unsafe}\n  and their stream* counterparts throw the same exception when the\n  parent is an html element.\n\nParsing a fragment with an html context element always produces head and\nbody elements, which is only suitable when replacing all children, so\nsetHTML{Unsafe}() and streamHTML{Unsafe}() on the html element remain\nallowed.\n\nThe check, ContainerNode::CheckValidParentForPartialInsertion(), runs\nafter the Trusted Types compliance check and before the fragment parser\nis created, so that it takes precedence over sanitizer config validation\nand over removing the node for (stream)replaceWithHTML().\n\nAdds external/wpt/domparsing/tentative/stream-html-element.html from\nweb-platform-tests/wpt#61748 (tentative until the streaming spec PR\nlands), and html-insertion-methods-html-element.html for the\nnon-streaming methods.\n\nBug: 573276742, 491743369\nChange-Id: If6caf8060b254f5f1d9ad8c0f716b3a503d3066b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8576898\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1721116}\n\n--\n\nwpt-commits: a15a3144858f9e81c11abf28858be4cd2a64e80e\nwpt-pr: 63805\n", "files": ["testing/web-platform/tests/domparsing/html-insertion-methods-html-element.html", "testing/web-platform/tests/domparsing/tentative/stream-html-element.html", "testing/web-platform/tests/html/semantics/scripting-1/the-template-element/template-for/template-for-html-setters.html"], "git_node": "e502d6496d25fb5c7f23829170e14e53ad643c14", "git_parents": ["103a37f9da40daf3ad723c24de4e17583288d80b"], "node": "fb9ed559b2ed948685d1f675f6b4cb3437bdd930", "parents": ["ea9ca7fb9c515db06f88d52530237a8038b25e9a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083409 [wpt PR 63805] - Update wpt metadata, a=testonly\n\nwpt-pr: 63805\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/html-insertion-methods-html-element.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-element.html.ini"], "git_node": "cc1afb57b372ea71e937aa26b9dfa9dd08f3ab59", "git_parents": ["e502d6496d25fb5c7f23829170e14e53ad643c14"], "node": "9ef170b86402a4cfd96a0eff39512643249298f4", "parents": ["fb9ed559b2ed948685d1f675f6b4cb3437bdd930"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086253 - [wpt-sync] Update web-platform-tests to a15a3144858f9e81c11abf28858be4cd2a64e80e, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: a15a3144858f9e81c11abf28858be4cd2a64e80e\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/__dir__.ini", "testing/web-platform/meta/content-security-policy/navigation/javascript-url-navigation-evaluated-to-string-inherits-csp.html.ini", "testing/web-platform/meta/css/css-env/syntax.tentative.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-form-fieldset-003.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/container-length-units-type.html.ini", "testing/web-platform/meta/css/css-values/random-computed.tentative.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference.html.ini", "testing/web-platform/meta/css/css-view-transitions/navigation/__dir__.ini", "testing/web-platform/meta/digital-credentials/create.tentative.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-events.https.html.ini", "testing/web-platform/meta/fedcm/fedcm-accounts-push/fedcm-accounts-push-caches-pictures.tentative.https.html.ini", "testing/web-platform/meta/fetch/range/__dir__.ini", "testing/web-platform/meta/html/browsers/the-window-object/security-window/window-security.https.html.ini", "testing/web-platform/meta/html/document-isolation-policy/__dir__.ini", "testing/web-platform/meta/html/dom/idlharness.https.html.ini", "testing/web-platform/meta/html/editing/dnd/__