ture/prompts/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/feature/readerview/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-brh/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/focus-android/app/src/main/res/values-bg/strings.xml", "mobile/android/focus-android/app/src/main/res/values-de/strings.xml"], "git_node": "f3844ddba78b62caa6dbd32ff1dc555754951a3e", "git_parents": ["59a643159a0038a83797db4a3b400ac263d5aa48"], "node": "68051e817ef5c1317c28e3c806f03031eeaeb658", "parents": ["e17e6647501ddc04bd186e0cbf1a91bdb6aff797"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 1955427 - Truncate native macOS menu labels to match CSS max-width defined for XUL menu items. r=mac-reviewers,bradwerth\n\nOn Linux and Windows, XUL menu items follow the crop rules, but macOS uses native menu items instead which don't use the crop rules. GetTruncatedCocoaLabel existed but returned the label unchanged. It now measures the label in the menu font at the element's computed font size and if the label is wider than the element's computed max width, it is truncated with an ellipsis. Badges and tooltips keep their full text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338462\n", "files": ["widget/cocoa/nsMenuItemX.mm", "widget/cocoa/nsMenuUtilsX.h", "widget/cocoa/nsMenuUtilsX.mm", "widget/cocoa/nsMenuX.mm"], "git_node": "c092b556246630b91161c616724c07f00853eb9e", "git_parents": ["f3844ddba78b62caa6dbd32ff1dc555754951a3e"], "node": "a5efc3a048c5b642b78f72a4a3df84b780a21aa3", "parents": ["68051e817ef5c1317c28e3c806f03031eeaeb658"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 1955427 - Add tests for truncating native menu labels to max-width. r=webidl,mac-reviewers,bradwerth,smaug\n\nAdd nsIDOMWindowUtils.getNativeMenuItemTitle so a browser test can read the title of an NSMenuItem. A gtest checks TruncateLabelToWidth directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338463\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl", "widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm", "widget/nsIWidget.h", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_menu_label_truncation.js", "widget/tests/gtest/TestCocoaMenuLabelTruncation.mm", "widget/tests/gtest/moz.build"], "git_node": "8ad4293e17eb7048dd206780303196658d81b5ac", "git_parents": ["c092b556246630b91161c616724c07f00853eb9e"], "node": "d95aafb979fb457cd9e216bdca75e16c352a401b", "parents": ["a5efc3a048c5b642b78f72a4a3df84b780a21aa3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086343 - Update vendored Hunspell to v1.7.6. r=masayuki\n\nUpstream now carries the bug1410214 and bug1653659 changes behind MOZILLA_CLIENT, which both the native and\nthe wasm sandbox builds define, so the local patches are dropped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337394\n", "files": ["extensions/spellcheck/hunspell/moz.yaml", "extensions/spellcheck/hunspell/patches/bug1410214.patch", "extensions/spellcheck/hunspell/patches/bug1653659.patch", "extensions/spellcheck/hunspell/src/affentry.cxx", "extensions/spellcheck/hunspell/src/affentry.hxx", "extensions/spellcheck/hunspell/src/affixmgr.cxx", "extensions/spellcheck/hunspell/src/affixmgr.hxx", "extensions/spellcheck/hunspell/src/csutil.cxx", "extensions/spellcheck/hunspell/src/csutil.hxx", "extensions/spellcheck/hunspell/src/filemgr.hxx", "extensions/spellcheck/hunspell/src/hashmgr.cxx", "extensions/spellcheck/hunspell/src/hashmgr.hxx", "extensions/spellcheck/hunspell/src/hunspell.cxx", "extensions/spellcheck/hunspell/src/hunspell.hxx", "extensions/spellcheck/hunspell/src/hunspelltrace.hxx", "extensions/spellcheck/hunspell/src/hunversion.h", "extensions/spellcheck/hunspell/src/hunvisapi.h", "extensions/spellcheck/hunspell/src/replist.cxx", "extensions/spellcheck/hunspell/src/replist.hxx", "extensions/spellcheck/hunspell/src/suggestmgr.cxx", "extensions/spellcheck/hunspell/src/suggestmgr.hxx"], "git_node": "d7c7595033d99543243423c1a1b756159d9658f6", "git_parents": ["8ad4293e17eb7048dd206780303196658d81b5ac"], "node": "f775dc5e60d8ef6576e4bc9c88fc4d1c779bd9c4", "parents": ["d95aafb979fb457cd9e216bdca75e16c352a401b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086343 - Enable updatebot for Hunspell releases. r=smaug\n\nTrack upstream tags instead of commits so updatebot proposes each release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337395\n", "files": ["extensions/spellcheck/hunspell/moz.yaml"], "git_node": "5983a7a59ac732c2839e0d5284c98ad757ca19c1", "git_parents": ["d7c7595033d99543243423c1a1b756159d9658f6"], "node": "c4ec39995003b1e24bbfa7b5db1fef149f87aac5", "parents": ["f775dc5e60d8ef6576e4bc9c88fc4d1c779bd9c4"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2087663 - Catch RejectedExecutionException when closing an unused capture session in QrFragment. r=android-reviewers,joberhauser\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338811\n", "files": ["mobile/android/android-components/components/feature/qr/src/main/java/mozilla/components/feature/qr/QrFragment.kt", "mobile/android/android-components/components/feature/qr/src/test/java/mozilla/components/feature/qr/QrFragmentTest.kt"], "git_node": "006efdbf7c0e7436a601c8112b9defe077f8ccdb", "git_parents": ["5983a7a59ac732c2839e0d5284c98ad757ca19c1"], "node": "4366640f690a4b7a022b058819bfc6ff44fa57c3", "parents": ["c4ec39995003b1e24bbfa7b5db1fef149f87aac5"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2049270 - [wdspec] Sync the Bidi test \"pointer_mouse.py::test_move_to_position_in_viewport[default value]\" with the classic variant. r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338225\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse.py.ini", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py"], "git_node": "fa381652d424eada71a0b8b1f56e0788185f7263", "git_parents": ["006efdbf7c0e7436a601c8112b9defe077f8ccdb"], "node": "87db1c0d19bdb53ca8ef38da23ed5aa55e87c2fc", "parents": ["4366640f690a4b7a022b058819bfc6ff44fa57c3"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2084830 - Support option for pin actions to avoid falling back to Windows APIs that pin without an OS-level prompt r=aborondo,omc-reviewers,hanna_a\n\nAction-only messages (e.g. `PIN_FIREFOX_TASKBAR_WIN_OS_PROMPT`) pin Firefox with no Firefox UI, so the Windows pin prompt is the user's only chance to consent. Today, if that prompt can't be shown, Firefox falls back to an undocumented Windows API (COM) that pins without asking on Windows 10 and early Windows 11.\n\nThis patch adds a prompt-only mode to taskbar pinning. In that mode Firefox pins only through the Windows prompt, and if the prompt fails, nothing is pinned. ASRouter turns on prompt-only for every pin action in an action-only message, including actions nested in MULTI_ACTION. Other callers keep the fallback, since the user already clicked a pin button there (such as about:welcome, Settings, Spotlight/infobar buttons, and Taskbar Tabs).\n\nThis patch also adds hresult and com_fallback to the taskbar.pin_winrt event (which needs data review).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336270\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/metrics.yaml", "browser/components/shell/ShellService.sys.mjs", "browser/components/shell/docs/pin-to-taskbar.md", "browser/components/shell/nsIWindowsShellService.idl", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/rust/shell_windows/src/WindowsShellServiceRust.h", "browser/components/shell/rust/shell_windows/src/taskbar/com.rs", "browser/components/shell/rust/shell_windows/src/taskbar/ffi.rs", "browser/components/shell/rust/shell_windows/src/taskbar/mod.rs", "browser/components/shell/rust/shell_windows/src/taskbar/winrt.rs", "browser/components/shell/test/browser_pinToTaskbarTelemetry.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_pin_firefox.js", "tools/@types/generated/lib.gecko.win32.d.ts"], "git_node": "7d43e90e8a47caf994949db523c930865d4ed3d2", "git_parents": ["fa381652d424eada71a0b8b1f56e0788185f7263"], "node": "1b31db790fc568deff4593c342824b468d92cc93", "parents": ["87db1c0d19bdb53ca8ef38da23ed5aa55e87c2fc"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084354 - Add a widget-generation ML feature, service type and purpose r=ai-platform-reviewers,cmurray,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335769\n", "files": ["browser/components/aiwindow/models/Utils.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs"], "git_node": "a048299413f0b63f337ca94485d28b5e81be19f4", "git_parents": ["7d43e90e8a47caf994949db523c930865d4ed3d2"], "node": "41d94811539ca729af78ce98ba649ff32f28f11b", "parents": ["1b31db790fc568deff4593c342824b468d92cc93"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078933 - Generate a widget's files from a prompt. r=mconley\n\nThe WidgetGenerator writes files generated by a model from a user's prompt to be used in small unprivileged widget extensions.\n\n- Adds `WidgetGenerator.generate()`, which runs a conversation through `openAIEngine` until a reply calls no tools.\n- The model calls the `write_file` tool to add each of the widget's files.\n- Gets the system prompt, model and parameters from remote settings, with a local prompt.md as the fallback prompt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336099\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/test/browser-static/browser_all_files_referenced.js", "browser/components/widgets/Tools.sys.mjs", "browser/components/widgets/WidgetGenerator.sys.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/moz.build", "browser/components/widgets/prompt.md", "browser/components/widgets/tests/browser/browser.toml", "browser/components/widgets/tests/browser/browser_generated_widgets.js", "browser/components/widgets/tests/browser/head.js"], "git_node": "ba8af8a4aa4e92c0a79c7a4db2f72ae87179f45d", "git_parents": ["a048299413f0b63f337ca94485d28b5e81be19f4"], "node": "02e5a353f43261035a005378ca83c213277df1d9", "parents": ["41d94811539ca729af78ce98ba649ff32f28f11b"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080323 - Part 3: Text generation panel in about:inference. r=ai-platform-reviewers,fluent-reviewers,bolsson,nordzilla\" for causing bc tests failures at browser_aboutinference.js\n\nThis reverts commit 67fef1ce2acab21fbb556fa592f70a0dba547ebc.\n\nRevert \"Bug 2080323 - Part 2: Sub-tabs and a devices panel in about:inference. r=ai-platform-reviewers,fluent-reviewers,bolsson,nordzilla\"\n\nThis reverts commit 878dbd795c39d0bdbdbe15aa417cd090cc6ca8a9.\n\nRevert \"Bug 2080323 - Part 1: about:inference fixes for HWInference engines. r=ai-platform-reviewers,nordzilla\"\n\nThis reverts commit 812ae8c34e53871b235350f36ad416a1e03bf7e1.\n\nRevert \"Bug 2058478 - Part 5: Test llama.cpp on the Metal GPU of the macOS CI machines. r=ai-platform-reviewers,taskgraph-reviewers,jcristau,nordzilla\"\n\nThis reverts commit 4e2e01bc5cd3b3a57f34a0b95ea2fbc50b194756.\n\nRevert \"Bug 2058478 - Part 4: Record the kind of device that loaded a text generation model. r=ai-platform-reviewers,nordzilla\"\n\nThis reverts commit f97cf9a848965b0c369f713262893387f1aa400e.\n\nRevert \"Bug 2058478 - Part 3: Let the device pipeline option place a text generation. r=ai-platform-reviewers,nordzilla\"\n\nThis reverts commit 9dd6d555b276290556c57b777329f1b073dde042.\n\nRevert \"Bug 2058478 - Part 2: Let a TextGenerator choose its device through a placement. r=ai-platform-reviewers,webidl,smaug,nordzilla\"\n\nThis reverts commit c10690d069b6541fdd51e5fd046d8e7ad619668d.\n\nRevert \"Bug 2058478 - Part 1: List the inference devices of the HWInference process. r=ai-platform-reviewers,nordzilla\"\n\nThis reverts commit 38008a3cb3955283cd50e0482450830e27e749ac.\n\nRevert \"Bug 2080324 - Stop reading the device pipeline option. r=ai-platform-reviewers,nordzilla,fluent-reviewers,bolsson\"\n\nThis reverts commit 8d693cf5e97950f9a9071f53bc8f823465275b6c.\n", "files": ["config/external/mozinference/mozinference.symbols", "dom/chrome-webidl/HWInference.webidl", "dom/chrome-webidl/TextGenerator.webidl", "dom/chrome-webidl/moz.build", "dom/webidl/LlamaRunner.webidl", "taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "toolkit/components/aboutinference/content/aboutInference.css", "toolkit/components/aboutinference/content/aboutInference.ftl", "toolkit/components/aboutinference/content/aboutInference.html", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/aboutinference/tests/browser/browser_aboutinference.js", "toolkit/components/ml/MLProfilerMarkers.h", "toolkit/components/ml/MLTelemetry.sys.mjs", "toolkit/components/ml/backends/llama/LlamaBackend.cpp", "toolkit/components/ml/backends/llama/LlamaBackend.h", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/content/backends/ONNXPipeline.mjs", "toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/docs/api.md", "toolkit/components/ml/docs/extensions.md", "toolkit/components/ml/ipc/HWInference.cpp", "toolkit/components/ml/ipc/HWInference.h", "toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceDeviceTypes.ipdlh", "toolkit/components/ml/ipc/HWInferenceTypes.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/ipc/moz.build", "toolkit/components/ml/metrics.yaml", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_engine_multi_perf.js", "toolkit/components/ml/tests/browser/browser_ml_engine_pipeline_options.js", "toolkit/components/ml/tests/browser/browser_ml_hwinference_device_discovery.js", "toolkit/components/ml/tests/browser/browser_ml_textgeneration_engine.js", "toolkit/components/ml/tests/browser/browser_ml_textgeneration_telemetry.js", "toolkit/components/ml/tests/browser/head.js", "toolkit/components/ml/tests/browser_models/browser_ml_smollm2_chat.js", "toolkit/components/ml/tests/gtest/TestTextGeneration.cpp", "toolkit/components/ml/textgeneration/TextGenerationChild.cpp", "toolkit/components/ml/textgeneration/TextGenerationEngine.sys.mjs", "toolkit/components/ml/textgeneration/TextGenerationParent.cpp", "toolkit/components/ml/textgeneration/TextGenerationParent.h", "toolkit/components/ml/textgeneration/TextGenerationTypes.ipdlh", "toolkit/components/ml/textgeneration/TextGenerator.cpp", "toolkit/components/ml/textgeneration/TextGenerator.h", "tools/@types/generated/lib.gecko.dom.d.ts"], "git_node": "2eaf6bc2f2fc4f7707ee1509a34032c93076fb8d", "git_parents": ["ba8af8a4aa4e92c0a79c7a4db2f72ae87179f45d"], "node": "e8d86511a941f59705029455e647d35057088f7e", "parents": ["02e5a353f43261035a005378ca83c213277df1d9"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083795 - Clamp omitted color-mix() percentages to zero r=emilio,layout-reviewers,firefox-style-system-reviewers\n\nPrevent negative weights when specified percentages exceed 100% during\nparsing and when resolving.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338778\n", "files": ["servo/components/style/values/generics/color.rs", "servo/components/style/values/specified/color.rs", "testing/web-platform/tests/css/css-color/parsing/color-computed-color-mix-function.html", "testing/web-platform/tests/css/css-color/parsing/color-valid-color-mix-function.html"], "git_node": "b2aa6b5ba7f0758a7c9929e30377a0f76f2b1c4f", "git_parents": ["2eaf6bc2f2fc4f7707ee1509a34032c93076fb8d"], "node": "49ccb03b68e27535766e93f6c8febc2c9a4070b8", "parents": ["e8d86511a941f59705029455e647d35057088f7e"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2088007 - Add a separate pref for WebRender path rendering with SWGL. r=gfx-reviewers,wsmind\n\ngfx.webrender.paths.swgl controls path rendering when software WebRender is\nused, and gfx.webrender.paths now only applies to hardware WebRender. Path\nrendering stays disabled with SWGL by default for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338673\n", "files": ["layout/svg/SVGUtils.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "8371d146374dda801386fe8ab589fba23127cb8b", "git_parents": ["b2aa6b5ba7f0758a7c9929e30377a0f76f2b1c4f"], "node": "cd841f9abd7fbf1a6ae37d25110b40b8d3c9898b", "parents": ["49ccb03b68e27535766e93f6c8febc2c9a4070b8"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2088007 - Enable WebRender path rendering by default. r=gfx-reviewers,gw\n\nclip-path: path() and shape() are rendered with WebRender path clips, which\nanti-alias differently from the mask images, so the fuzziness of the affected\ntests is adjusted. corner-shape-superellipse-concave is affected through its\nreference, which uses clip-path: path().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331231\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-concave.html.ini", "testing/web-platform/meta/css/css-masking/clip-path/animations/clip-path-transition-allow-discrete-shape.html.ini", "testing/web-platform/meta/css/css-masking/clip-path/clip-path-shape-007.html.ini", "testing/web-platform/meta/css/css-masking/clip-path/clip-path-shape-008.html.ini", "testing/web-platform/meta/css/css-masking/clip-path/clip-path-shape-009.html.ini", "testing/web-platform/meta/css/css-masking/clip-path/clip-path-shape-010.html.ini", "testing/web-platform/meta/css/css-masking/clip-path/clip-path-shape-011.html.ini"], "git_node": "1a09c806d8daecedafd27d22b3193b1d3e251e62", "git_parents": ["8371d146374dda801386fe8ab589fba23127cb8b"], "node": "8b6ffb3466a35c593211287bd0fd3fac305608e2", "parents": ["cd841f9abd7fbf1a6ae37d25110b40b8d3c9898b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085570 - Refresh the media session and notification when the tab title, URL or favicon changes. r=Roger,android-reviewers\n\nBoth observers only reacted to mediaSessionState, but the title, artist and artwork fall back to the tab's\ncontent title, URL and icon, so a change to those alone left the lockscreen and notification stale.\n\nThe observers now compare what the media surfaces display: the resolved title and artist and the favicon, and\nnothing from a private tab, so a page title that changes under a metadata title does not trigger a refresh.\nMediaSessionFeature sends a change that leaves mediaSessionState untouched to the new\nMediaSessionDelegate.handleMediaUpdated, which only refreshes the notification, so it records no playback\ntelemetry and leaves audio focus and the foreground service alone. A favicon-only change refetches the artwork\nwithout blanking the current one first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336531\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/MediaSessionFeature.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/ext/SessionState.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/player/BrowserStorePlayer.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionDelegate.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/MediaSessionFeatureTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/player/BrowserStorePlayerTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "eec91bd8941bf97b46014f6de68bd54ac0e99760", "git_parents": ["1a09c806d8daecedafd27d22b3193b1d3e251e62"], "node": "bd6f24f4fe5e130e37bdc3e43261a9264ff49521", "parents": ["8b6ffb3466a35c593211287bd0fd3fac305608e2"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085570 - Build the media notification from the artwork the media session already fetched. r=Roger,android-reviewers\n\nThe notification fetched the page's artwork on every update, alongside the player's fetch of the same artwork\nfor the media session. Since that fetch suspended, an update could finish after a later one and leave older\ncontent posted, and starting the foreground service waited on it.\n\nThe notification now uses the artwork the player holds for the tab's current metadata, so it is built and\nposted in the same call, and the player reports when new artwork arrives so the notification is posted again\nwith it. With nothing left to wait for, the notification coroutine scope goes away, along with the generation\ncheck that kept a late foreground start from requesting audio focus after playback had paused or stopped.\n\nSince the cached artwork records whether it came from the favicon, a favicon change no longer refetches\nartwork the page supplied.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336559\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/notification/MediaNotification.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/player/BrowserStorePlayer.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/notification/MediaNotificationTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/player/BrowserStorePlayerTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt"], "git_node": "052b3ca9afa7236783c06aa42ba44cf2e1cae011", "git_parents": ["eec91bd8941bf97b46014f6de68bd54ac0e99760"], "node": "f4e2751271cc503217ea7c1486832ed56c556e07", "parents": ["bd6f24f4fe5e130e37bdc3e43261a9264ff49521"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2084809 - Part 5: Restore the SportsWidgetErrorCard with the Wrexham widget error states r=android-reviewers,android-l10n-reviewers,parker,skhan\n\n- Restore SportsWidgetErrorCard and SportCardErrorState from the removed Homepage Sports Widget\n- Replace the PromoCard layout with the title, message, filled Refresh button and fox mascot from the design\n- Add the latest results failed to load error state\n\nFigma:\n- Error card: https://www.figma.com/design/kDvQ8Hd2c5MwN9S3Y2FZ5r/Wrexham-Ideas?node-id=751-150901&m=dev\n- Results failed to load: https://www.figma.com/design/kDvQ8Hd2c5MwN9S3Y2FZ5r/Wrexham-Ideas?node-id=751-153847&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337005\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportCardErrorState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/SportsWidgetErrorCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/SportsWidgetHeader.kt", "mobile/android/fenix/app/src/main/res/drawable/fox_expressive_face_tail.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "957b88ed6b43a62a1efe357df03fec946415dc6d", "git_parents": ["052b3ca9afa7236783c06aa42ba44cf2e1cae011"], "node": "4303f5058563bf826f57a2270910507986f0822d", "parents": ["f4e2751271cc503217ea7c1486832ed56c556e07"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2084809 - Part 6: Restore the Scoreboard with the score pill and match status r=android-reviewers,android-l10n-reviewers,parker,skhan\n\n- Restore Scoreboard from the removed Homepage Sports Widget match card into its own file\n- Show the ScorePill followed by the match status and kickoff details for the followed team\n- Use the live ScorePill colors while the match is live\n- Add Compose previews for each match status\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337006\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportCardData.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/Scoreboard.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "94bb21308ac3c0374d2ad18733eb56d9707f38ef", "git_parents": ["957b88ed6b43a62a1efe357df03fec946415dc6d"], "node": "a7a4e85264ee026a6ebb6f7b9f6fe90a07fc07cd", "parents": ["4303f5058563bf826f57a2270910507986f0822d"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088146 - Update and re-enable media control focus tests in accessible/tests/mochitest/actions/test_media.html r=accessibility-platform-reviewers,morgan\n\nBug 494175 made the media controls keyboard navigable, so the play and mute buttons now take focus when they're activated. This patch restores the EVENT_FOCUS/STATE_FOCUSED checks for both buttons and removes the todo().\n\nThe commented-out scrubber case is removed rather than restored. It was written for the old XUL scale. The scrubber is now an \u003cinput type=range\u003e, which has no \"activate\" action, and the sibling path to it no longer points at the scrubber.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338865\n", "files": ["accessible/tests/mochitest/actions/test_media.html"], "git_node": "3d20e13447e995d9127067a17480b549d91464bd", "git_parents": ["94bb21308ac3c0374d2ad18733eb56d9707f38ef"], "node": "1c8fcbc9eed0ac002dc45d66c4c6be0fc83a64f4", "parents": ["a7a4e85264ee026a6ebb6f7b9f6fe90a07fc07cd"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088145 - Stop re-fetching the button accessible in browser_accessible_moved.js. r=accessibility-platform-reviewers,morgan\n\nBug 1739050 has been fixed, so moving an Accessible no longer recreates its RemoteAccessible. Use the original button reference after the move instead of looking it up again, which also makes the test verify that the Accessible survives the move.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338841\n", "files": ["accessible/tests/browser/bounds/browser_accessible_moved.js"], "git_node": "4049c5066ca34b12db85c554acc9c7c5bb4242c5", "git_parents": ["3d20e13447e995d9127067a17480b549d91464bd"], "node": "061cd49dad990e958770d2ddfe765ca3052f3cdc", "parents": ["1c8fcbc9eed0ac002dc45d66c4c6be0fc83a64f4"], "tags": []}, {"author": "Dmitry Gozman \u003cdgozman@gmail.com\u003e", "branch": "default", "desc": "Bug 2082535 - Use unique URLs in browser_test_offline_tab.js so repeated runs do not hit the HTTP cache. r=necko-reviewers,jesup\n\nWhen the test runs more than once in the same browser, the online task\ncaches empty.html and the next offline task is served from the cache,\nwhich forceOffline intentionally allows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335092\n", "files": ["netwerk/test/browser/browser_test_offline_tab.js"], "git_node": "ceebaa703b0f6b41c4b3e61a7e0e3b42eaded605", "git_parents": ["4049c5066ca34b12db85c554acc9c7c5bb4242c5"], "node": "8266c0a657046867231243dd69e551b2ab04d604", "parents": ["061cd49dad990e958770d2ddfe765ca3052f3cdc"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087644 - Update speculation-rules prefetch WPT expectations for subtests that are now stable. r=sunil\n\nThese intermittent expectations had the same result in every run across 4 mozilla-central pushes on all desktop and Android configurations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338451\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/clear-prefetch-cache-after-clear-site-data-cache.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-delivery-type.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-single.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/redirect-url.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/tentative/service-worker/redirect.sub.https.html.ini"], "git_node": "1d7959209e1fbddca7eefae2db196c25bbc4a686", "git_parents": ["ceebaa703b0f6b41c4b3e61a7e0e3b42eaded605"], "node": "b9e4210ad37b08c2dcb35e66dae8a58093d73747", "parents": ["8266c0a657046867231243dd69e551b2ab04d604"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081342 - Add small size styles to privacy widget r=fluent-reviewers,maxx,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337428\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "8aa11076ee84f268b50b50bb625cdb7a4f0f7d97", "git_parents": ["1d7959209e1fbddca7eefae2db196c25bbc4a686"], "node": "60e3eeb9e9f829e9e56d75a324e97a030e42722d", "parents": ["b9e4210ad37b08c2dcb35e66dae8a58093d73747"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063723 - Updates the streamlined tab context menu. - Also addresses the disabled state for \"Reopen Closed Tab\" option to be singular. r=tabbrowser-reviewers,fluent-reviewers,niklas,czhou,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333234\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/customizableui/ToolbarContextMenu.sys.mjs", "browser/components/genai/GenAI.sys.mjs", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabContextMenu_altStructure.js", "browser/locales/en-US/browser/genai.ftl", "browser/locales/en-US/browser/tabContextMenu.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "b88f19a33828d9f94c036a6fff7c6a3432860241", "git_parents": ["8aa11076ee84f268b50b50bb625cdb7a4f0f7d97"], "node": "c2a8eded185a13aab49ebdac526389d39ec12876", "parents": ["60e3eeb9e9f829e9e56d75a324e97a030e42722d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087525 - Mark from_header_and_iter_alloc unsafe. r=firefox-style-system-reviewers,dshin\n\nThe pointer can return whatever, it shouldn't be safe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338321\n", "files": ["servo/components/servo_arc/lib.rs", "servo/components/to_shmem/lib.rs"], "git_node": "7d5074d2f46eca1f8020cd3fd36d213df82f842a", "git_parents": ["b88f19a33828d9f94c036a6fff7c6a3432860241"], "node": "3a52c6439b4bbbcb2077a32c8d1de06b1b727ade", "parents": ["c2a8eded185a13aab49ebdac526389d39ec12876"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088178 - Updated Padding on ListenSheet expanded r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338819\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt"], "git_node": "cfe6693828ddc02071ca1e4b48f61cfe23681ae9", "git_parents": ["7d5074d2f46eca1f8020cd3fd36d213df82f842a"], "node": "5d4abf3042dc0c2b01bf7992bacc5fd1d21c63e5", "parents": ["3a52c6439b4bbbcb2077a32c8d1de06b1b727ade"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2086800: Show the response when arc gets non-JSON back from Phabricator r=firefox-build-system-reviewers,ahochheiden\n\nUpdatebot's PDF.js submissions have been failing at differential.creatediff\nwith \"Host returned HTTP/200, but invalid JSON data\", and arc doesn't say what\nit actually got back. Patch arcanist in the image to include the Conduit\nmethod, the response headers, and the start of the response body in that\nerror.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338844\n", "files": ["taskcluster/docker/updatebot/Dockerfile", "taskcluster/docker/updatebot/arcanist_log_invalid_json.patch", "taskcluster/docker/updatebot/privileged-setup.sh"], "git_node": "5a83619d110de8fe5812fbf4e9c89328989d14db", "git_parents": ["cfe6693828ddc02071ca1e4b48f61cfe23681ae9"], "node": "37c49f3cccf6cd4e0e531910f6de7948d24fb4d6", "parents": ["5d4abf3042dc0c2b01bf7992bacc5fd1d21c63e5"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2086800: Send arc's Conduit requests uncompressed r=firefox-build-system-reviewers,ahochheiden\n\nPhabricator advertises the gzip capability, so arc gzips its request bodies.\nPHP then parses the compressed body as form data before Phabricator\ndecompresses it. A large body has thousands of stray \"&\" bytes, which go over\nmax_input_vars, and the warning PHP prints replaces the JSON response. This\nhas made every PDF.js submission fail at differential.creatediff. Patch\narcanist to stop compressing requests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338845\n", "files": ["taskcluster/docker/updatebot/Dockerfile", "taskcluster/docker/updatebot/arcanist_no_gzip.patch", "taskcluster/docker/updatebot/privileged-setup.sh"], "git_node": "d329884a39efa133c73b869ef47ee7dad84fd38c", "git_parents": ["5a83619d110de8fe5812fbf4e9c89328989d14db"], "node": "a20cbf2b88054117c2b9f3b514cfde7eecc6ec13", "parents": ["37c49f3cccf6cd4e0e531910f6de7948d24fb4d6"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2086800: Bump Updatebot r=firefox-build-system-reviewers,ahochheiden\n\nThis includes:\n- Report commands that succeed but print a traceback to stderr\n- Don't crash on the oldest job when recovering from an unexpected CREATED status\n- Bump certifi from 2026.7.22 to 2026.10.19\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338870\n", "files": ["taskcluster/docker/updatebot/updatebot-version.sh"], "git_node": "9daee94dbbcd8b57a34bf90b68f1ad85b5634f83", "git_parents": ["d329884a39efa133c73b869ef47ee7dad84fd38c"], "node": "9276710f5e5806f331935a024d93066533c29058", "parents": ["a20cbf2b88054117c2b9f3b514cfde7eecc6ec13"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2071986 - Tell the Smart Window model what the user did on watch task cards. r=omarg\n\nWatch task messages previously rendered from Fluent IDs with an empty body,\ncausing them to be excluded from the conversation history sent to the model.\nAfter a /watch interaction, the model had no knowledge of tasks being created,\ncancelled, paused, edited, or deleted.\n\nThese messages now include an English, model-facing description in\n`content.body` while continuing to render using their Fluent localization IDs.\nCard outcomes (create, cancel, page not watchable, limit reached) receive\na one-line description. Created tasks maintain a short change log, updated\nfrom the monitor store by `#syncConversationHistory`, so edits, pauses,\nexpiry, and deletion are reflected in the model's conversation history.\n`MonitorUIUtils.formatMonitorForModel` builds the task descriptions.\n\nCreate and cancel actions first attempt `resolvePendingToolConfirmation`,\nallowing cards initiated by model tool calls to update their tool results.\n\nCopying localized messages now copies the rendered Fluent text instead of\nthe model-facing body. `ai-chat-message` exposes `localizedText`, which\n`ai-chat-content` uses when copying localized messages. Other messages\ncontinue to copy their body.\n\nAlso removes the duplicate `SCHEDULE_TYPES` definition from\n`MonitorUIUtils` in favor of the one in `Schedule.sys.mjs`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336058\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js", "browser/components/aiwindow/ui/test/browser/chat/browser.toml", "browser/components/aiwindow/ui/test/browser/chat/browser_chat_copy_message.js", "browser/components/aiwindow/ui/test/xpcshell/test_MonitorUIUtils.js"], "git_node": "352a5930523647fb213013e7c91a88cf0e921dbf", "git_parents": ["9daee94dbbcd8b57a34bf90b68f1ad85b5634f83"], "node": "872638bce4b8ea2d22a91f781a5f705fc6803b57", "parents": ["9276710f5e5806f331935a024d93066533c29058"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2086662 - add L2P to AI Controls and swap its backing enabled state to datastore r=android-reviewers,jdelorenzo,android-l10n-reviewers,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337776\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/settings/ListenSettings.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/settings/ListenSettingsTest.kt", "mobile/android/android-components/components/support/test-fakes/s