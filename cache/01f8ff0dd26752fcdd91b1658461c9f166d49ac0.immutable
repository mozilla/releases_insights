aders/src/include/vulkan/vulkan_android.h", "third_party/angle/third_party/vulkan-headers/src/include/vulkan/vulkan_core.h", "third_party/angle/third_party/vulkan-headers/src/include/vulkan/vulkan_screen.h", "third_party/angle/third_party/vulkan-headers/src/include/vulkan/vulkan_ubm.h", "third_party/angle/third_party/vulkan-headers/src/vulkan_headers_gn/moz.build", "third_party/angle/third_party/zlib/google/compression_utils_portable_gn/moz.build", "third_party/angle/third_party/zlib/zlib_gn/moz.build", "third_party/angle/translator_gn/moz.build", "third_party/build_overrides/swiftshader.gni", "third_party/build_overrides/vulkan_headers.gni"], "git_node": "8d1e09bf35a319e4416ccaf017be6cd4160185e9", "git_parents": ["5a78f4525f81f7323c2c044965096723318af6e6"], "node": "31510953970a53f5383d1fbe94359a3fbad10bac", "parents": ["d707487029a477a5269e6d2dc5f4420728a94522"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2060743 - Add a capability to load ANGLE libraries on Android r=gfx-reviewers,bradwerth\n\nIt adds a capability to select native EGL or ANGLE EGL by gfxVars::UseWebRenderANGLE().\n\nAnd adds GLContextProviderEGL::CreateHeadlessNative() for getting native EGL GLContext. It is added for GfxInfo on Android,\nThe function is called before gfxVars::SetUseWebRenderANGLE() call in parent process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316524\n", "files": ["gfx/gl/GLContextProvider.h", "gfx/gl/GLContextProviderEGL.cpp", "gfx/gl/GLContextProviderImpl.h", "gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "widget/android/GfxInfo.cpp"], "git_node": "371ed3193e2048f8484a96f4d43db0e460ba40cf", "git_parents": ["8d1e09bf35a319e4416ccaf017be6cd4160185e9"], "node": "fb3852db9069062ccfe5c543f7bd85c8c4c15724", "parents": ["31510953970a53f5383d1fbe94359a3fbad10bac"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083937 - Add MemoryMappedFile::AsSpan and use it for font loading. r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336868\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "xpcom/io/MemoryMappedFile.h"], "git_node": "5e6edd72f6c0889b4d3082de1825db158bc76ef1", "git_parents": ["371ed3193e2048f8484a96f4d43db0e460ba40cf"], "node": "94e29688dc0dbad8ac6a095d13421e9b04d1bbb2", "parents": ["fb3852db9069062ccfe5c543f7bd85c8c4c15724"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2083772 - Make `AutoClonedRangeArray::RemoveCollapsedRanges` optionally preserve the primary range even when all ranges are collapsed r=m_kato\n\nWe don't know how to reproduce the crash of bug 2083772. So, returning\nerror in the case may break some web apps. Therefore, let's try to\nkeep handling with the anchor-focus range even if all ranges are\ncollapsed with normalizing the white-spaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336962\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/AutoClonedRangeArray.h", "editor/libeditor/HTMLEditorDeleteHandler.cpp"], "git_node": "4bfe808cf25a910a929ac6a3581b1294924a2820", "git_parents": ["5e6edd72f6c0889b4d3082de1825db158bc76ef1"], "node": "1ac4f8fec143a165c6d685d56f12cc1824eb24d3", "parents": ["94e29688dc0dbad8ac6a095d13421e9b04d1bbb2"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 0f1e6bf43c587038c2613e6e21adf903166101df\naf -\u003e 0f1e6bf43c587038c2613e6e21adf903166101df\nan -\u003e 0f1e6bf43c587038c2613e6e21adf903166101df\nar -\u003e 0f1e6bf43c587038c2613e6e21adf903166101df\nast -\u003e 0f1e6bf43c587038c2613e6e21adf903166101df\naz -\u003e 0f1e6bf43c587