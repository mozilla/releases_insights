.rs", "third_party/rust/ringbuf/src/storage.rs", "third_party/rust/ringbuf/src/tests/access.rs", "third_party/rust/ringbuf/src/tests/basic.rs", "third_party/rust/ringbuf/src/tests/capacity.rs", "third_party/rust/ringbuf/src/tests/drop.rs", "third_party/rust/ringbuf/src/tests/fmt_write.rs", "third_party/rust/ringbuf/src/tests/frozen.rs", "third_party/rust/ringbuf/src/tests/hold.rs", "third_party/rust/ringbuf/src/tests/init.rs", "third_party/rust/ringbuf/src/tests/iter.rs", "third_party/rust/ringbuf/src/tests/message.rs", "third_party/rust/ringbuf/src/tests/mod.rs", "third_party/rust/ringbuf/src/tests/multiple.rs", "third_party/rust/ringbuf/src/tests/new.rs", "third_party/rust/ringbuf/src/tests/overwrite.rs", "third_party/rust/ringbuf/src/tests/read_write.rs", "third_party/rust/ringbuf/src/tests/shared.rs", "third_party/rust/ringbuf/src/tests/single.rs", "third_party/rust/ringbuf/src/tests/skip.rs", "third_party/rust/ringbuf/src/tests/slice.rs", "third_party/rust/ringbuf/src/tests/unsized_.rs", "third_party/rust/ringbuf/src/tests/zero_sized.rs", "third_party/rust/ringbuf/src/traits/consumer.rs", "third_party/rust/ringbuf/src/traits/mod.rs", "third_party/rust/ringbuf/src/traits/observer.rs", "third_party/rust/ringbuf/src/traits/producer.rs", "third_party/rust/ringbuf/src/traits/ring_buffer.rs", "third_party/rust/ringbuf/src/traits/split.rs", "third_party/rust/ringbuf/src/traits/utils.rs", "third_party/rust/ringbuf/src/transfer.rs", "third_party/rust/ringbuf/src/utils.rs", "third_party/rust/ringbuf/src/wrap/caching.rs", "third_party/rust/ringbuf/src/wrap/direct.rs", "third_party/rust/ringbuf/src/wrap/frozen.rs", "third_party/rust/ringbuf/src/wrap/mod.rs", "third_party/rust/ringbuf/src/wrap/traits.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "1aca4fa389a7eb085a1f77153be5d1998aa195b0", "git_parents": ["b1c75041b54a6a56c51486ab58e46e129ae2ff16"], "node": "c6fda35d65429a7d8dc0651b82f254e4255290f0", "parents": ["f28bbdb9fbb7d5d20a439cf38c380da924030330"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085772 - Update the picture region on output stream changes for hardware decoding in WMFVideoMFTManager. r=media-playback-reviewers,azebrowski\n\nThe picture size can change without a new decoder, e.g. when switching spatial\nlayers of an AV1 SVC stream in WebRTC. Only the software path updated it, so\nhardware decoding kept cropping to the configured image size, showing a smaller\npicture in a corner of stale surface content.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337117\n", "files": ["dom/media/platforms/wmf/WMFVideoMFTManager.cpp", "dom/media/platforms/wmf/WMFVideoMFTManager.h"], "git_node": "8f7778bcc082299b461c20bcc733d149f468a2ef", "git_parents": ["1aca4fa389a7eb085a1f77153be5d1998aa195b0"], "node": "a34deb94ae5430df08c1466802d5eb62cfa8c7ae", "parents": ["c6fda35d65429a7d8dc0651b82f254e4255290f0"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070189 - Allow extension pages subframes added to privilegedabout pages to run isolated in the extension process. r=nika,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324299\n", "files": ["dom/ipc/ProcessIsolation.cpp", "toolkit/components/extensions/moz.build", "toolkit/components/extensions/test/browser/browser.toml", "toolkit/components/extensions/test/browser/browser_ext_subframes_process_isolation.js", "toolkit/components/extensions/test/browser/data/file_dummy.html", "toolkit/components/extensions/test/browser/data/file_privilegedabout_page.html", "toolkit/components/extensions/test/browser/head_subframes_process_isolation.js", "toolkit/components/extensions/test/browser/webextensions-remote-false/browser.toml", "toolkit/components/extensions/test/browser/webextensions-remote-false/browser_ext_subframes_process_isolation_remote_disabled.js"], "git_node": "e0ea92acf3756ee62a98521127c9b79ee82f5346", "git_parents": ["8f7778bcc082299b461c20bcc733d149f468a2ef"], "node": "dda1f9534ea6e616a10370b5c3805dc674598405", "parents": ["a34deb94ae5430df08c1466802d5eb62cfa8c7ae"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084095 - Convert existing simple toolbar related existing regression UI tests and create new ones within the efficiency framework r=aaronmt,mobiletest-reviewers\n\nAll 9 UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335666\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsCustomizeTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ToolbarComponent.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsCustomizeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsCustomizeExpandedToolbarTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsCustomizeSimpleToolbarTest.kt"], "git_node": "98ef4cbd6750213982c57ceab66dc5da623bd02b", "git_parents": ["e0ea92acf3756ee62a98521127c9b79ee82f5346"], "node": "e4f1b4c66fe0392000f0bc8e959686f7c21182b2", "parents": ["dda1f9534ea6e616a10370b5c3805dc674598405"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2085817 - Unhide the removed search engine before SearchTestUtils restores the config in browser_topsites_section.js, r=ini.\n\nThe test could not run twice in one browser (test-verify, --repeat) because Baidu stayed hidden after the first run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336795\n", "files": ["browser/extensions/newtab/test/browser/browser_topsites_section.js"], "git_node": "4e66ba60ea2526467a4457631d80e05bced47045", "git_parents": ["98ef4cbd6750213982c57ceab66dc5da623bd02b"], "node": "6147e3ed27d4ba13d3e7fdcc92c0507bbd6425e0", "parents": ["e4f1b4c66fe0392000f0bc8e959686f7c21182b2"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076103 - Hide panel-list popovers that aren't in the top layer to prevent flickering. r=reusable-components-reviewers,mstriemer,desktop-theme-reviewers\n\nWhen the browser hides the popover itself (a light dismiss, or another auto\npopover evicting it), panel-list only clears its open attribute when the queued\ntoggle event fires. Until then, the open attribute keeps the list displayed\noutside the top layer, so it can paint a frame at its absolute position, e.g.\nflickering to the side after a press-drag-release.\n\nTie the panel's display to :popover-open instead, so it disappears as soon as\nit leaves the top layer. The [showing] exception keeps it laid out while\nsetAlign() measures it before showPopover() is called.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333485\n", "files": ["toolkit/content/tests/widgets/test_panel_list_popover.html", "toolkit/content/widgets/panel-list/panel-list.css"], "git_node": "6ed6ab6de0d76d50ddd48e8b380862196e521f00", "git_parents": ["4e66ba60ea2526467a4457631d80e05bced47045"], "node": "7c4ae6108f9ef734e200c9eab76271f95c4f6b9a", "parents": ["6147e3ed27d4ba13d3e7fdcc92c0507bbd6425e0"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084804, Bug 2084805, Bug 2084803, Bug 2084796 - Update the card update doorhanger for a new or changed security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\" for causing bc failures @browser_creditCard_capture_cvv.js.\n\nThis reverts commit e5d76e3da0c3a7b4e5ff322b66a8eaf224c23db9.\n\nRevert \"Bug 2084805 - Update the card update doorhanger for updates that keep the security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\"\n\nThis reverts commit b99b30a6aad68a53d98340266f63e9fd5721b962.\n\nRevert \"Bug 2084803 - Update the card save doorhanger to the new security code design. r=credential-management-reviewers,fluent-reviewers,desktop-theme-reviewers,akulyk,flod,dimi\"\n\nThis reverts commit 2948a11edcacb1a174188fd77fa78db91ef30ffd.\n\nRevert \"Bug 2084796 - Name the card security code after the card network. r=credential-management-reviewers,fluent-reviewers,dimi,bolsson\"\n\nThis reverts commit 3e1890faf786caf947c267f6ed09bfa862dd888e.\n", "files": ["browser/extensions/formautofill/content/autofillEditForms.mjs", "browser/extensions/formautofill/content/editCreditCard.xhtml", "browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/unit/test_profileAutocompleteResult.js", "browser/locales/en-US/browser/preferences/formAutofill.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/formautofill-notification.css", "python/l10n/fluent_migrations/bug_2084796_card_details.py", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/ProfileAuto