a.com/D335858\n", "files": ["remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/client/marionette_driver/geckoinstance.py"], "git_node": "08eec03e2ef2022d4662e3ad56394ae239b31d58", "git_parents": ["d6fd7a4e69b3c2d4550582eb38d2cdbd9cbad79a"], "node": "c6afe04da56db0c3a7c63b6517e0fc7bccf4ef0c", "parents": ["006163118837775b4ae627815acf6b8d32938271"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2082298 - Migrate narrate.properties to Fluent. r=firefox-desktop-core-reviewers ,fluent-reviewers,mossop,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335496\n", "files": ["python/l10n/fluent_migrations/bug_2082298_narrate_properties.py", "toolkit/components/narrate/NarrateControls.sys.mjs", "toolkit/components/narrate/test/NarrateTestUtils.sys.mjs", "toolkit/components/reader/content/aboutReader.html", "toolkit/locales/en-US/chrome/global/narrate.properties", "toolkit/locales/en-US/toolkit/global/narrate.ftl", "toolkit/locales/jar.mn"], "git_node": "bba7fe5862273028747586b6acaf021fc776a47c", "git_parents": ["08eec03e2ef2022d4662e3ad56394ae239b31d58"], "node": "de7f0d0f37cd589e9694b78d594eb8dbb5d31b35", "parents": ["c6afe04da56db0c3a7c63b6517e0fc7bccf4ef0c"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081209 - Wait for the first resource usage measurement in mozsystemmonitor tests. r=mozbase-reviewers,ahal\n\nThe monitor's collecting process is spawned on macOS, and may not have\nsent anything yet when test_aggregate_cpu stops the monitor, or when\ntest_process_sampling_still_running starts the process it expects to be\nsampled as started during monitoring.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333239\n", "files": ["testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "53a591d00dcb746f67747675db963871f4991660", "git_parents": ["bba7fe5862273028747586b6acaf021fc776a47c"], "node": "edd10a3f65d7da0182574e7e4f916cfb127cdd45", "parents": ["de7f0d0f37cd589e9694b78d594eb8dbb5d31b35"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081209 - Install psutil in the python-test virtualenv. r=mach-reviewers,ahochheiden\n\nIn automation, the mach site doesn't install its optional packages, so\ntests that need psutil were skipped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333226\n", "files": ["python/sites/python-test.txt"], "git_node": "db7f97553ad6d8a4b6e95db58d0878d9a7be14d7", "git_parents": ["53a591d00dcb746f67747675db963871f4991660"], "node": "5d359617c0f09ae5be1f1e9b5dab5260b87ad5c3", "parents": ["edd10a3f65d7da0182574e7e4f916cfb127cdd45"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 868ad45001d6813e543d85473eef613879d5d07a\naf -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nan -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nar -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nast -\u003e 868ad45001d6813e543d85473eef613879d5d07a\naz -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbe -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbg -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbn -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbo -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbqi -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbr -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbrx -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nbs -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nca -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nca-valencia -\u003e 868ad45001d6813e543d85473eef613879d5d07a\ncak -\u003e 868ad45001d6813e543d85473eef613879d5d07a\nckb -\u003e 868ad45001d6813e543d85473eef613879d5d07a\ncs -\u003e 868ad45001d6813