3b1175f99e6f2ce6e4092"], "node": "05f029ff22fc829d0bebf69137d9d28df8f08ad0", "parents": ["8f296ea0bbf1d0b202af529e9f0e86858c6a220f"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086805 - Expand browser_calculate_frecency_speed.js with more scenarios - r=places-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337819\n", "files": ["toolkit/components/places/tests/browser/performance/browser_calculate_frecency_speed.js"], "git_node": "bded309ed90a6394ec7db571f2959d8f14f1c46b", "git_parents": ["06933d7f5bcddde6a941b9d98ee1f1ad42505380"], "node": "d9c16000def39e176752510487a4a040f4ef2e92", "parents": ["05f029ff22fc829d0bebf69137d9d28df8f08ad0"], "tags": []}, {"author": "Abhinav Singh \u003cabhinavsingh717073@gmail.com\u003e", "branch": "default", "desc": "Bug 2087301 - Derive DMABuf blit channel order from source format. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338339\n", "files": ["gfx/gl/GLBlitHelper.cpp"], "git_node": "e71a438241cecbb5fb7e4bd374cbb9eb99cadee3", "git_parents": ["bded309ed90a6394ec7db571f2959d8f14f1c46b"], "node": "05c12b86383fd9dc064701faf1c10ed32c676720", "parents": ["d9c16000def39e176752510487a4a040f4ef2e92"], "tags": []}, {"author": "Muhammed Jaseem Pallikkal \u003c64106637+jasseeeem@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083663 - Keep client certificate dialog buttons and dropdown visible. r=keeler\n\nWait for certificate details and translation before sizing the dialog, and restore the certificate dropdown arrow on macOS. Adds regression coverage for both dialog types and certificate selection.\n\nScreenshots use synthetic data only.\n\nBefore (light):\n{F84587755}\n\nAfter (light):\n{F84587753}\n\nAfter (dark):\n{F84587754}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335091\n", "files": ["security/manager/pki/resources/content/clientauthask.js", "security/manager/pki/resources/content/clientauthask.xhtml", "security/manager/ssl/tests/mochitest/browser/browser.toml", "security/manager/ssl/tests/mochitest/browser/browser_clientAuth_dialog.js"], "git_node": "46eb15e12f8f7dcb9283daa8a970048c748989e9", "git_parents": ["e71a438241cecbb5fb7e4bd374cbb9eb99cadee3"], "node": "1e4d089f35d795768ce5dc4e0a4cd558b31c9783", "parents": ["05c12b86383fd9dc064701faf1c10ed32c676720"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087418 - Create 4 new ETP related regression UI tests r=mobiletest-reviewers,aaronmt\n\nHad to refactor the legacy test to match the manual test.\n\nAll 4 new UI tests successfully passed 25x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=112368 | Try ]]\n\nThe legacy test successfully passed 10x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=2cd5cdf6c5d9146789b0abf0cedeb72141e3da00 | try ]]\nAll efficiency UI tests successfully passed 1x on Firebase.[[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=112370  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338307\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/GlobalPrivacyControlTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsEnhancedTrackingProtectionExceptionsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsEnhancedTrackingProtectionSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/GlobalPrivacyControlTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsEnhancedTrackingProtectionExceptionsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsEnhancedTrackingProtectionTest.kt"], "git_node": "9c2586d157f26a45067a089872a4b648928bec5a", "git_parents": ["46eb15e12f8f7dcb9283daa8a970048c748989e9"], "node": "117da20738831ed4ca7dc5ba76d398a00c8a9933", "parents": ["1e4d089f35d795768ce5dc4e0a4cd558b31c9783"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1936168 - Clarify use of default widget placements for an area, in both vertical and horizontal tabs mode. r=tabbrowser-reviewers,sidebar-reviewers,nsharpley\"\n\n- defaultPlacements and verticalTabsDefaultPlacements sound equivalent but weren't\n- An area can now define *either* a verticalTabsDefaultPlacements which entirely replaces defaultPlacements, or verticalTabsAdditionalPlacements which gets appended to defaultPlacements\n- Add a new getDefaultPlacements internal method to remove duplication\n- Amend manifest to run tests which were previously expected to fail with vertical tabs and are fixed by this change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337808\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/sidebar/tests/marionette/test_initialize_vertical_tabs.py", "browser/components/tabbrowser/test/browser/tabs/browser.toml"], "git_node": "15b0e93a9d60aa601d85a2996140a0ff787d4169", "git_parents": ["9c2586d157f26a45067a089872a4b648928bec5a"], "node": "362954dbf8d74291f193fb0258ea91903507f30a", "parents": ["117da20738831ed4ca7dc5ba76d398a00c8a9933"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2087563 - Make resourcetimingbufferfull not bubble. r=bas\n\nThe spec has changed to not bubble with this PR:\nhttps://github.com/w3c/resource-timing/pull/168\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338342\n", "files": ["dom/performance/PerformanceMainThread.cpp", "testing/web-platform/meta/resource-timing/buffer-full-when-populate-entries.html.ini"], "git_node": "660f8f65866455870d394cd392d504bd6e4c5f3c", "git_parents": ["15b0e93a9d60aa601d85a2996140a0ff787d4169"], "node": "62c1f383654c95c0209adf2499df4541747b9534", "parents": ["362954dbf8d74291f193fb0258ea91903507f30a"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2087581 - Filter the navigation entry by type in getEntriesByName r=bas\n\nThe spec is here, see step 4:\nhttps://w3c.github.io/performance-timeline/#dfn-filter-buffer-map-by-name-and-type\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338370\n", "files": ["dom/performance/PerformanceMainThread.cpp", "testing/web-platform/tests/performance-timeline/getEntriesByName-type.html"], "git_node": "1ab6cdbeb0faa406562c132c745535b9f9ccf1f5", "git_parents": ["660f8f65866455870d394cd392d504bd6e4c5f3c"], "node": "04cb21edaaf0824c1a79f7202d0e8a2686754576", "parents": ["62c1f383654c95c0209adf2499df4541747b9534"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2087581 - Sort the paint entry by startTime in getEntriesByName r=bas\n\nThis is specified on the 6th step here:\nhttps://w3c.github.io/performance-timeline/#dfn-filter-buffer-map-by-name-and-type\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338371\n", "files": ["dom/performance/PerformanceMainThread.cpp", "testing/web-platform/tests/performance-timeline/getEntriesByName-sort.html"], "git_node": "96a79cf8b904e6772db9043667fb668fd5b6f23a", "git_parents": ["1ab6cdbeb0faa406562c132c745535b9f9ccf1f5"], "node": "9c23dd419f18489619f80ff4b6675088ac52ed7f", "parents": ["04cb21edaaf0824c1a79f7202d0e8a2686754576"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079894 - move createDefaultBrowserConfig out of main.js r=settings-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332167\n", "files": ["browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/config/default-browser.mjs", "browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/jar.mn", "browser/components/preferences/main.js"], "git_node": "92c637737ff63f2853f9466f9620ee77b66fa2d2", "git_parents": ["96a79cf8b904e6772db9043667fb668fd5b6f23a"], "node": "9532412d5338a22f204d99c101720e2bf9fb1483", "parents": ["9c23dd419f18489619f80ff4b6675088ac52ed7f"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079414 - move code from from the createStartupConfig method to home-startup.mjs from main.js r=settings-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332168\n", "files": ["browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/main.js"], "git_node": "5edd55931c92d3bd0fdfbd1dc4a0724f5bca6d19", "git_parents": ["92c637737ff63f2853f9466f9620ee77b66fa2d2"], "node": "12f601a9b0227e81b6b4c8a136cb94ffe6561fb3", "parents": ["9532412d5338a22f204d99c101720e2bf9fb1483"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085227 - Add general popover support to moz-button. r=reusable-components-reviewers,mkennedy\n\nRefactor `MenuController` into `PopoverController` and make `MenuController` a\nsubclass. Add a `popoverTarget` property to `moz-button`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336322\n", "files": ["toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/widgets/moz-button/moz-button.mjs"], "git_node": "866fb93a4670a54168412c817ad37c75a476ae4e", "git_parents": ["5edd55931c92d3bd0fdfbd1dc4a0724f5bca6d19"], "node": "c104165a035f34d7d128fefe7621a3f821c6654d", "parents": ["12f601a9b0227e81b6b4c8a136cb94ffe6561fb3"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2080511 - Implement argument grammar for var/env/attr substitution functions. r=firefox-style-system-reviewers,emilio\n\nArbitrary substitution functions are specified using a lenient argument\ngrammar that defines their syntax at parse time. The actual arguments\nare only parsed into their semantic forms at substitution time. For\n`var()`/`env()`/`attr()`, this makes nested references in the first\nparameter newly possible, like `var(var(--prop-name))`. Functions that\nwere previously considered invalid at parse time (like `var(1px)`) are\nnow considered valid so long as they match the argument grammar. The new\nargument grammar handling also adds support for free-form production\nmatching, so that `{}`-values work properly.\n\nIn this change, the core type that enables this functionality is\n`SubstitutionArgument\u003cT\u003e`. It can hold the `\u003cdeclaration-value\u003e` for the\nargument, but also eagerly parses it into the final `T` if there are no\nnested substitution functions. This enables parse-time usage of\narguments where possible, like attribute dependency tracking.\n\nIn order to handle functions with nested references, cycle detection\nruns Tarjan's algorithm through those references, and also performs\nsubstitution on those arguments to obtain the final referenced names.\n\nThis change passes existing WPTs for `var()` and `attr()` argument\ngrammar handling. New WPTs were added to test argument grammar handling\nfor `env()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333056\n", "files": ["devtools/client/inspector/rules/test/browser_rules_authored.js", "layout/style/test/property_database.js", "layout/style/test/test_css_supports_variables.html", "servo/components/style/custom_properties.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/stylesheets/container_rule.rs", "servo/components/style/stylist.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "servo/components/to_shmem/lib.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-env/env-fallback-substitution.html.ini", "testing/web-platform/meta/css/css-env/indexed-env.tentative.html.ini", "testing/web-platform/meta/css/css-values/attr-argument-grammar.html.ini", "testing/web-platform/meta/css/css-variables/var-ident-function.html.ini", "testing/web-platform/meta/css/css-variables/var-parsing.html.ini", "testing/web-platform/meta/css/css-variables/variable-declaration-29.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference-name-substitution-attr-taint.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference-name-substitution.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference.html.ini", "testing/web-platform/meta/css/css-variables/variable-supports-30.html.ini", "testing/web-platform/meta/css/css-variables/variable-supports-64.html.ini", "testing/web-platform/tests/css/css-conditional/container-queries/style-query-custom-attr-braces-change.html", "testing/web-platform/tests/css/css-conditional/container-queries/style-query-custom-attr-nested-name-change.html", "testing/web-platform/tests/css/css-env/env-fallback-braces.html", "testing/web-platform/tests/css/css-env/env-parsing.html", "testing/web-platform/tests/css/css-env/indexed-env.tentative.html", "testing/web-platform/tests/css/css-env/syntax.tentative.html", "testing/web-platform/tests/css/css-values/attr-all-types.html", "testing/web-platform/tests/css/css-values/attr-fallback-braces.html", "testing/web-platform/tests/css/css-variables/var-fallback-braces.html"], "git_node": "70c032140678e44566b059838930ebcb62176fcf", "git_parents": ["866fb93a4670a54168412c817ad37c75a476ae4e"], "node": "6bb2b0b5075a58a649f6feb9aa8fa34b703b38b5", "parents": ["c104165a035f34d7d128fefe7621a3f821c6654d"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2080511 - Use Parse trait and ParserContext for arbitrary substitution function arguments. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333114\n", "files": ["servo/components/style/custom_properties.rs", "servo/components/style/parser.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties_and_values/rule.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/queries/condition.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/stylist.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "servo/components/style/values/specified/image.rs", "servo/components/style/values/specified/param.rs", "servo/ports/geckolib/glue.rs"], "git_node": "386e66f908dd6ee3934de4e3a232fe3d0a14da82", "git_parents": ["70c032140678e44566b059838930ebcb62176fcf"], "node": "2f5554eae847421ab9924a0c78a57c23587ab943", "parents": ["6bb2b0b5075a58a649f6feb9aa8fa34b703b38b5"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085227 - Add general popover support to moz-button. r=reusable-components-reviewers,mkennedy\" for causing bc tests failures at searchModeSwitcher_basic.js\n\nThis reverts commit 866fb93a4670a54168412c817ad37c75a476ae4e.\n", "files": ["toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/widgets/moz-button/moz-button.mjs"], "git_node": "6ebf28036c69b2298b7143535d7798dba4ab1162", "git_parents": ["386e66f908dd6ee3934de4e3a232fe3d0a14da82"], "node": "8d595576ffe37734efc90f0b47180b667a7a04de", "parents": ["2f5554eae847421ab9924a0c78a57c23587ab943"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087421: Avoid activating masked SVG groups solely for transform animation. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338282\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "gfx/tests/browser/browser.toml", "gfx/tests/browser/browser_svg_masked_animation.js"], "git_node": "7a7d99a492f4cd764d0b9538558484b73aae0b0d", "git_parents": ["6ebf28036c69b2298b7143535d7798dba4ab1162"], "node": "d4a4c15a2ee3db6f56daac4f343e5dc335cbfade", "parents": ["8d595576ffe37734efc90f0b47180b667a7a04de"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087333 - Add ability to show large top pick icon for AMP suggestions with large scores. r=daisuke,desktop-theme-reviewers,urlbar-reviewers,hjones\n\nIn Proton we used `result.richSuggestionIconSize`, which mapped to\n`row[icon-size]` in the DOM. As part of Nova, we tried to keep icon sizes in the\nCSS and out of JS. I think that's a good goal and I don't want to regress it.\n\nSo rather than using `richSuggestionIconSize` again, this patch introduces\nbest-match types: small, large, and none. `UrlbarResult` can now be created with\na `bestMatchType`, and the `isBestMatch` property now takes its value from the\ntype. To keep this patch small, I kept the `isBestMatch` option in the\n`UrlbarResult` constructor. If a caller specifies `isBestMatch` without\n`bestMatchType`, then `bestMatchType` defaults to the usual best-match size,\nlarge. The only caller that can't rely on this default is `AmpSuggestions`.\n\n`result.bestMatchType` maps to `row[top-pick-type]` in the DOM. (At some point\nwe should replace \"best match\" with \"top pick\".)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338200\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/private/AmpSuggestions.sys.mjs", "browser/components/urlbar/tests/browser-results/browser_bestMatch.js", "browser/components/urlbar/tests/quicksuggest/QuickSuggestTestUtils.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_amp.js", "browser/components/urlbar/tests/unit/head.js", "browser/themes/shared/urlbar/view-nova.css", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "cfc282aab695585247cd20f46eb8f4bba14b3ddf", "git_parents": ["7a7d99a492f4cd764d0b9538558484b73aae0b0d"], "node": "2e7f9c7109398d77dc86c0ab8706d95e9345247f", "parents": ["d4a4c15a2ee3db6f56daac4f343e5dc335cbfade"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087548: Copy a shortcut assigned in System Settings to the key element of a hidden menu item. r=mac-reviewers,bradwerth\n\nA hidden menu item, such as \"Exit Full Screen\" outside of full screen, is not in its native menu, and AppKit only applies an assigned shortcut to an item that has been added to a menu. So after a restart, about:keyboard showed the built-in shortcut for these items. A hidden item with a key element is now added to its own menu, hidden, for a moment, so that AppKit applies the assignment, which the item keeps once removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338394\n", "files": ["widget/cocoa/nsMenuItemX.mm"], "git_node": "dff5d0ac1012fefad2322ad0c276c05763a6798d", "git_parents": ["cfc282aab695585247cd20f46eb8f4bba14b3ddf"], "node": "f698bad58264ab5fc9b79faa29c23a7ab0a64636", "parents": ["2e7f9c7109398d77dc86c0ab8706d95e9345247f"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2087603 - Assign BUG_COMPONENTs to code under mobile/android. r=nalexander,geckoview-reviewers,android-reviewers\n\nThe components come from the bugs fixed in each directory since 2023, with\nmore weight on recent and focused patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338380\n", "files": ["mobile/android/android-components/moz.build", "mobile/android/fenix/moz.build", "mobile/android/focus-android/moz.build", "mobile/android/moz.build"], "git_node": "cc162f4f73ca5267488746dad426f7c09e8b1e15", "git_parents": ["dff5d0ac1012fefad2322ad0c276c05763a6798d"], "node": "66c5a3246c4b179711b9549f0ac59f185e905f61", "parents": ["f698bad58264ab5fc9b79faa29c23a7ab0a64636"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085958 - Let users pin New Tab widgets to the Home space. r=ini,fluent-reviewers,bolsson\n\nThis patch lets people pin New Tab widgets to the Home space.\n\nPreviously, every widget lived wherever the spaces config put it, and hiding one turned it off everywhere. For the next spaces production candidate, Home gets some widgets the user picks, and a separate Widgets space holds the rest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336941\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Crossword/Crossword.jsx", "browser/extensions/newtab/content-src/components/Widgets/MoveSubmenu.jsx", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/PictureOfTheDay.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetMenuFooter.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetPlacement.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamBase.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MoveSubmenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetMenuFooter.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetPlacement.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "68a71367dc169b9b4c62412bc5b4b7b1d0b5d01c", "git_parents": ["cc162f4f73ca5267488746dad426f7c09e8b1e15"], "node": "98096e875be9719ed525631dd22d5f2b1a6d1367", "parents": ["66c5a3246c4b179711b9549f0ac59f185e905f61"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085959 - Record where New Tab widgets render and which are pinned to Home. r=ini\n\nThis patch records where New Tab widgets render and which ones are pinned to Home, using the widget telemetry we already have.\n\nThe previous patch lets people pin widgets to Home or keep them in the Widgets space. To compare how widgets do in each place, we need to know where a widget was when it was seen or used, so `widgets_impression` and `widgets_user_event` get a new `widget_location` extra:\n- `home_space`,\n- `widget_space`,\n- `widget_container` (the widgets section in any other layout),\n- `sidebar`\n- or `story_card`.\n\nA new `widgets_home_list` metric, a clone of `widgets_enabled_list`, records which widgets are pinned to Home.\n\nPinning a widget or moving it back records `widgets_user_event` with `add_to_home` or `remove_from_home`, and \"Hide widgets\" on Home records `widgets_container_action` with `remove_all_from_home`. Moving a widget off Home leaves it turned on, so none of these show up as `widgets_enabled` with enabled: false.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336942\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/content-src/components/Widgets/MoveSubmenu.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetPlacement.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsSidebar.jsx", "browser/extensions/newtab/content-src/components/Widgets/useWidgetTelemetry.jsx", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/CardSections.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetPlacement.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsSidebar.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useWidgetTelemetry.test.jsx", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "e91ad7339ec75c0b911c0c37f3fe77ba9766886c", "git_parents": ["68a71367dc169b9b4c62412bc5b4b7b1d0b5d01c"], "node": "5ff244ab36959dae396b7ae15f8ae64f4a3b7f83", "parents": ["98096e875be9719ed525631dd22d5f2b1a6d1367"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037619: Add WPT for preserving animation play state through unresolved timelines. r=layout-scroll-driven-animation-reviewers,boris\n\nIt seems that browsers currently disagree on if paused animations that then\nswitch to the unresolved timeline produce any effect. For now, test the\nnon-diverging portion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338176\n", "files": ["testing/web-platform/tests/scroll-animations/scroll-timelines/play-state-unresolved-timeline.tentative.html"], "git_node": "fe0173ca6a4f145937f4e3bf2541bbf89682cd51", "git_parents": ["e91ad7339ec75c0b911c0c37f3fe77ba9766886c"], "node": "859a6caea1ac10cbd4e91913661f8039c98b02be", "parents": ["5ff244ab36959dae396b7ae15f8ae64f4a3b7f83"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083154 - Resolve legacy POSIX time zones before ICU calculations and formatting. r=dminor,platform-i18n-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334747\n", "files": ["intl/components/gtest/TestLegacyPOSIXTimeZone.cpp", "intl/components/gtest/moz.build", "intl/components/src/Calendar.cpp", "intl/components/src/DateIntervalFormat.cpp", "intl/components/src/DateTimeFormat.cpp", "intl/components/src/TimeZone.cpp", "intl/components/src/TimeZone.h", "js/src/tests/non262/Date/realm-time-zone-legacy-posix.js", "js/src/tests/non262/Date/time-zones-legacy-posix.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_legacy_posix.js", "js/src/vm/DateTime.cpp"], "git_node": "548236b825d90bf1d33bf70531915d031bf488c6", "git_parents": ["fe0173ca6a4f145937f4e3bf2541bbf89682cd51"], "node": "1f4928d48515556791421b46be4d088c89bca3dd", "parents": ["859a6caea1ac10cbd4e91913661f8039c98b02be"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087602 - Update isPremium check so that unlimited bandwidth does not gate locations - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338391\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_list.js"], "git_node": "82aab248fd3444ef780112dffebff147d7f00c58", "git_parents": ["548236b825d90bf1d33bf70531915d031bf488c6"], "node": "93b6b01542169d7f21b8f18c86a61e77cebd33b6", "parents": ["1f4928d48515556791421b46be4d088c89bca3dd"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087324 - Pre: Codify assumption that map entries are non-null, in order to prevent creation of empty map entries. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338186\n", "files": ["dom/canvas/HostWebGLContext.cpp", "dom/canvas/HostWebGLContext.h"], "git_node": "ba26f55c646c3002a3d7c9de475861d1cc675724", "git_parents": ["82aab248fd3444ef780112dffebff147d7f00c58"], "node": "ad182cbded87a04de9066f67a3723903c67300a6", "parents": ["93b6b01542169d7f21b8f18c86a61e77cebd33b6"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087324 - Inspect WebGL tracked memory on the canvas rendering thread. r=lsalzman,mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338187\n", "files": ["dom/canvas/WebGLMemoryTracker.cpp", "dom/canvas/WebGLMemoryTracker.h"], "git_node": "53fa8fe451d46060c0e4be67e55042e22783bc49", "git_parents": ["ba26f55c646c3002a3d7c9de475861d1cc675724"], "node": "20f63d08a926d1e3ff8da532c1f4d4108653bbe8", "parents": ["ad182cbded87a04de9066f67a3723903c67300a6"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2087521 - When symbolicating profiles, output .jslb.gz instead of .json. r=perftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338318\n", "files": ["testing/raptor/raptor/gecko_profile.py"], "git_node": "d5ca8775cd4c5a9ed9925df8b42c960ebff97b68", "git_parents": ["53fa8fe451d46060c0e4be67e55042e22783bc49"], "node": "05c2c94742f206954e224e5ca0ffd7666a4cf159", "parents": ["20f63d08a926d1e3ff8da532c1f4d4108653bbe8"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087159 - Stop mirroring telemetry for ScriptPreloader. r=arai,chumphreys\n\nThe telemetry is still gathered in Glean and this only impacts the now-unused\nlegacy telemetry datasets. There were no existing tests for the legacy mirrors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338048\n", "files": ["js/xpconnect/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "83ce5a83ce737e981eee125094ce66bf5cfadaa5", "git_parents": ["d5ca8775cd4c5a9ed9925df8b42c960ebff97b68"], "node": "a5b8283033fa682ed922aff756b2cce4c4431894", "parents": ["05c2c94742f206954e224e5ca0ffd7666a4cf159"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087159 - Stop mirroring telemetry for ScriptPreloader. r=arai,chumphreys\" for causing python telemetry failures\n\nThis reverts commit 83ce5a83ce737e981eee125094ce66bf5cfadaa5.\n", "files": ["js/xpconnect/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "d3148da9f6d7c25003e21f94e34e233cc984ca4a", "git_parents": ["83ce5a83ce737e981eee125094ce66bf5cfadaa5"], "node": "f58b8c5dbf6616b5844c59dd188e5c46dca9d734", "parents": ["a5b8283033fa682ed922aff756b2cce4c4431894"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086805 - Expand browser_calculate_frecency_speed.js with more scenarios - r=places-reviewers,daisuke\" for causing perfdocs failures at browser_calculate_frecency_speed.js\n\nThis reverts commit bded309ed90a6394ec7db571f2959d8f14f1c46b.\n", "files": ["toolkit/components/places/tests/browser/performance/browser_calculate_frecency_speed.js"], "git_node": "be8eca2ab268607ad667092cd3779eb8f949396b", "git_parents": ["d3148da9f6d7c25003e21f94e34e233cc984ca4a"], "node": "6494119526da86ea758f7cb44a79e6a0f29753b2", "parents": ["f58b8c5dbf6616b5844c59dd188e5c46dca9d734"], "tags": []}, {"author": "Tyler Etchart \u003ctetchart@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079879 - allow multiple tool calls in a single assistant session with proper API validation r=bjohns,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332981\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/PromptOptimizer.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_chat_tool_calls.js", "browser/components/aiwindow/models/tests/browser/browser_conversation_stream.js", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search.js"], "git_node": "11b3a61c1a8e3de5498e7a46c4b7f9e816d3b7a8", "git_parents": ["be8eca2ab268607ad667092cd3779eb8f949396b"], "node": "358f7c92dcf22cf9ba783bc6321de1eb51589733", "parents": ["6494119526da86ea758f7cb44a79e6a0f29753b2"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087365 - Give exactly the Android Components modules with Robolectric tests a robolectric.properties. r=android-build-system-reviewers,android-reviewers,tcampbell\n\nThe next patch uses the file to decide which build-components tasks need Robolectric's android-all jars. The\nremoved files belonged to modules without Robolectric tests. lib-accelerometer-sensormanager's class-level\n@Config keeps its SDK.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338439\n", "files": ["mobile/android/android-components/components/compose/engine/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/tabstray/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/base/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/bookmarks-parser/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/push/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/example/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/protection-dashboard/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/screendetection/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/tab-collections/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/webauthn/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/webcompat/src/test/resources/robolectric.properties", "mobile/android/android-components/components/lib/accelerometer-sensormanager/src/test/resources/robolectric.properties", "mobile/android/android-components/components/lib/bookmark-parser-jsoup/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/firefox-relay/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/glean/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/merino-weather/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/sync/src/test/resources/robolectric.properties", "mobile/android/android-components/components/support/license/src/test/resources/robolectric.properties"], "git_node": "34ff47dd7ee38ae5f31fdb68170c226323b2ded4", "git_parents": ["11b3a61c1a8e3de5498e7a46c4b7f9e816d3b7a8"], "node": "acb070e26b882cdfa3186ff4fdac1ee60c9c2602", "parents": ["358f7c92dcf22cf9ba783bc6321de1eb51589733"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087365 - Provide Robolectric's android-all jars from a toolchain instead of Maven Central. r=android-build-system-reviewers,geckoview-reviewers,android-reviewers,tcampbell\n\nRobolectric's local dependency resolver has no fallback to Maven, so the toolchain carries every jar the\npinned Robolectric knows about, derived from its DefaultSdkProvider and checked against the sha512 Maven\npublishes. In automation the property is set unconditionally, so a task that runs Robolectric tests without\nthe toolchain fails instead of downloading the jars. Only build-components tasks of modules with a\nrobolectric.properties fetch it; the taskgraph sparse profile includes those files so the decision task can\nsee them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338424\n", "files": ["build/sparse-profiles/taskgraph", "mobile/android/android-components/samples/browser/build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt", "taskcluster/android_taskgraph/transforms/build_components.py", "taskcluster/kinds/source-test/mozlint-android.yml", "taskcluster/kinds/test-apk/kind.yml", "taskcluster/kinds/toolchain/android.yml", "taskcluster/scripts/misc/android-robolectric-jars.sh"], "git_node": "c8ea605fa2c13469b2dc78781e639148f81201db", "git_parents": ["34ff47dd7ee38ae5f31fdb68170c226323b2ded4"], "node": "3ab5d10775b87f46b34e940159269ddb1362c789", "parents": ["acb070e26b882cdfa3186ff4fdac1ee60c9c2602"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002879 - Serialize style attribute from parsed inline declaration block and drop opacity property when copying; r=masayuki\n\nWhen copying, serialize the inline `style` attribute from its parsed declaration\nblock instead of emitting the original attribute value, and drop the `opacity`\nproperty from it, this aligns with the behavior of other browsers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311179\n", "files": ["dom/base/test/test_bug166235.html", "dom/serializers/nsHTMLContentSerializer.cpp", "dom/serializers/nsHTMLContentSerializer.h", "dom/serializers/tests/mochitest/mochitest.toml", "dom/serializers/tests/mochitest/test_htmlcopyencoder_inlinestyle.html", "dom/serializers/tests/mochitest/test_htmlcopyencoder_inlinestyle_opacity.html", "editor/libeditor/tests/test_bug525389.html", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/tests/clipboard-apis/clipboard-copy-selection-style-opacity.tentative.https.html", "testing/web-platform/tests/clipboard-apis/resources/user-activation.js"], "git_node": "22c1239592476f0914d0f41f4eaac734fc358aad", "git_parents": ["c8ea605fa2c13469b2dc78781e639148f81201db"], "node": "f7ef57f98cb0ce7494c298462d8158fa7364482d", "parents": ["3ab5d10775b87f46b34e940159269ddb1362c789"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043033 - Add wpt crashtests and reftests for various form elements with line-clamp applied. r=dshin,AlaskanEmily\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334700\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-form-fieldset-003.tentative.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-form-input-001.tentative.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/crashtests/line-clamp-form-input-auto-height.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-button-001.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-button-002.tentative.html", "testing/web-platform/tests/css/css-ove