ef", "d9098b3e11c2fbc2b2d84e53a3c784814cbdab3e"], "user": "smolnar@mozilla.com"}, "45651": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with FIREFOX_160_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9b155f8b4aa1a6c5b4c4cdf6c70ba08dae480aa5", "git_parents": ["53d3a12c1168bd1772d208706945e844cc367ce8"], "node": "53d84b8bd49bf5b9c65017ffdf849fb00819795d", "parents": ["98a9c395e22f3ea462b2ce36e4813a581bf6cb5f"], "tags": []}], "date": 1793053235, "git_changesets": ["9b155f8b4aa1a6c5b4c4cdf6c70ba08dae480aa5"], "user": "ffxbld@lando.moz.tools"}, "45652": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eeb1d1a7d535e835dc67efa98fbdfa746a3be0a7 with DEVEDITION_160_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "2e1db2ece8a3a1d68a94cab8aee845aff0ba85da", "git_parents": ["9b155f8b4aa1a6c5b4c4cdf6c70ba08dae480aa5"], "node": "374006e562b213c42f8c6e9ef28521447782fc32", "parents": ["53d84b8bd49bf5b9c65017ffdf849fb00819795d"], "tags": []}], "date": 1793053372, "git_changesets": ["2e1db2ece8a3a1d68a94cab8aee845aff0ba85da"], "user": "ffxbld@lando.moz.tools"}, "45653": {"changesets": [{"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2082325 - Look up the FileFinder ignore patterns without a glob in a set r=firefox-build-system-reviewers,ahochheiden\n\nFileFinder matched every file and directory it visited against each of its\nignore patterns with mozpath.match. expand_exclusions hands it the global and\nthird-party excludes, 466 patterns of which only 10 have a glob, so a walk of\nthe whole tree made 164 million regex matches and took 34s.\n\nLook up the path and its ancestors in a set for the patterns without a glob,\nwhich is what mozpath.match amounts to for them, and only match the globs.\nThe same walk now takes 4s, and every linter relying on expand_exclusions\ngets the speedup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335920\n", "files": ["python/mozbuild/mozpack/files.py"], "git_node": "249ec46b9365d31a5af7c807f1724f0657d6f3a2", "git_parents": ["d9098b3e11c2fbc2b2d84e53a3c784814cbdab3e"], "node": "78d45e0e25fab414a2d02bd469dd0f9efcb49498", "parents": ["6394817c482c7ed8baa4021802f4f231315ef0be"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2039350 - Check if the scroll container frame may be scrolled asynchronously for compositor animations. r=firefox-style-system-reviewers,layout-reviewers,dshin\n\nAdd this flag to check if we may scroll asynchronously the scroll\ncontainer frame (i.e. the source) for compositor animations. This can\nfilter out the case we may not have ViewID for the source when generating\nWebRender commands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335832\n", "files": ["dom/animation/ScrollTimeline.cpp", "layout/style/crashtests/2039350.html", "layout/style/crashtests/crashtests.list"], "git_node": "0ddefaeeb6a31f2529b3a35c3afa693c4f97d83f", "git_parents": ["249ec46b9365d31a5af7c807f1724f0657d6f3a2"], "node": "1ee0f40ffe7ae05b63f0ec16e1ce79dd40004c4b", "parents": ["78d45e0e25fab414a2d02bd469dd0f9efcb49498"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078901 - Show initiated prefetch requests in the Application panel. r=bomsy,fluent-reviewers,devtools-reviewers,bolsson\n\nSubscribe to network resources when Speculative Loads is enabled and show\nprefetch requests in a localized URL, Action and Status table. Track each\nrequest by resource ID and update its pending, success or failure status.\nClear the list on navigation and filter requests to the current top-level\ndocument.\n\nAdd browser coverage for request completion, HTTP failures, captured resource\nreplay, navigation and the feature pref, plus reducer coverage for independent\nrequests and late updates after navigation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333827\n", "files": ["devtools/client/application/initializer.js", "devtools/client/application/src/actions/index.js", "devtools/client/application/src/actions/moz.build", "devtools/client/application/src/actions/speculative-loads.js", "devtools/client/application/src/components/speculative-loads/SpeculativeLoads.css", "devtools/client/application/src/components/speculative-loads/SpeculativeLoadsPage.js", "devtools/client/application/src/constants.js", "devtools/client/application/src/reducers/index.js", "devtools/client/application/src/reducers/moz.build", "devtools/client/application/src/reducers/speculative-loads-state.js", "devtools/client/application/test/browser/browser.toml", "devtools/client/application/test/browser/browser_application_panel_speculative-loads.js", "devtools/client/application/test/browser/resources/speculative-loads/index.html", "devtools/client/application/test/browser/resources/speculative-loads/target.sjs", "devtools/client/application/test/xpcshell/test_speculative_loads_reducer.js", "devtools/client/application/test/xpcshell/xpcshell.toml", "devtools/client/locales-preview/speculative-loads.ftl"], "git_node": "bb8b91615c05c97ec689f89e5c1d42961c2605aa", "git_parents": ["0ddefaeeb6a31f2529b3a35c3afa693c4f97d83f"], "node": "d1b5962146362063240223da7323770e89da6358", "parents": ["1ee0f40ffe7ae05b63f0ec16e1ce79dd40004c4b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074893 - Part 1 - Support BSD tar in `./mach package` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336335\n", "files": ["python/mozbuild/mozbuild/action/package.py", "python/mozbuild/mozbuild/test/action/test_package.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "233daa849edb8b5ea560b553ef0116f3a946bc3e", "git_parents": ["bb8b91615c05c97ec689f89e5c1d42961c2605aa"], "node": "9f31339146ac6e3fef2daef7583b0b485e31f854", "parents": ["d1b5962146362063240223da7323770e89da6358"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074893 - Part 2 - Support BSD tar in `./mach source-package` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336336\n", "files": ["python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_mach_source_package.py"], "git_node": "b0d3fee5dc4eebf520a34c4726d4b804601050df", "git_parents": ["233daa849edb8b5ea560b553ef0116f3a946bc3e"], "node": "7a469ce6367bd0d2153e1dd571f9d41360e25076", "parents": ["9f31339146ac6e3fef2daef7583b0b485e31f854"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085844 - Part 1 - Pass the ruff arguments through a response file r=linter-reviewers,marco\n\nA whole tree run passed 477 excludes in one `--extend-exclude`\nargument of 43226 characters, and Windows refuses a command line over\n32767 characters with `WinError 206`. ruff reads its arguments from an\n`@file` instead, which has no such limit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336622\n", "files": ["tools/lint/python/ruff.py", "tools/lint/test/test_ruff.py"], "git_node": "8a9e4f9d2130e1e8c2d5649d19e129663cd0de8f", "git_parents": ["b0d3fee5dc4eebf520a34c4726d4b804601050df"], "node": "f734e70f3a58bb94b5091dbcc7c31a469ce471be", "parents": ["7a469ce6367bd0d2153e1dd571f9d41360e25076"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085844 - Part 2 - Pass eslint and stylelint only the global excludes r=linter-reviewers,marco\n\nEach excluded path became an `--ignore-pattern`, about 477 on a whole\ntree run, which went over the Windows command line limit. The eslint\nand stylelint configs already read `ThirdPartyPaths.txt` and\n`Generated.txt`, so both now get only the global excludes. stylelint\nalso gets those two files through `--ignore-path`, because its\n`ignoreFiles` setting does not match a directory line. The patterns now\nuse forward slashes, so Windows applies them as well. The node\nprocesses no longer start through a shell, which limited the command\nline to 8191 characters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336623\n", "files": ["python/mozlint/mozlint/roller.py", "python/mozlint/mozlint/types.py", "tools/lint/eslint/__init__.py", "tools/lint/eslint/prettier_utils.py", "tools/lint/stylelint/__init__.py", "tools/lint/test/test_eslint.py", "tools/lint/test/test_stylelint.py"], "git_node": "fff7515d063105703ad3ab0aa7dc000168d01085", "git_parents": ["8a9e4f9d2130e1e8c2d5649d19e129663cd0de8f"], "node": "9fe1d57c77683eba12f7efd9965c18500903ac74", "parents": ["f734e70f3a58bb94b5091dbcc7c31a469ce471be"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085845 - Split a whole tree run into jobs on Windows too r=linter-reviewers,marco\n\n`_generate_jobs` lists the top level entries only when the linted path\nequals `self.root`. `roll` passes the path through `os.path.abspath`,\nwhich gives backslashes on Windows, while mach gives the root with\nforward slashes, so on Windows `mach lint .` ran each linter on the\nroot as a single job.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336624\n", "files": ["python/mozlint/mozlint/roller.py", "python/mozlint/test/test_roller.py"], "git_node": "e7027f1b6fef9f0da57460a674409ea42cc2a348", "git_parents": ["fff7515d063105703ad3ab0aa7dc000168d01085"], "node": "454394049f978c68804fc6ed86de2bacdb9263aa", "parents": ["9fe1d57c77683eba12f7efd9965c18500903ac74"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085846 - Cache `jj git root` with `functools.cache` r=ahal\n\n`jj git root` snapshots the working copy, and a single `mach lint` ran it\nthree times, once from the Sentry thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336625\n", "files": ["python/mozversioncontrol/mozversioncontrol/repo/jj.py"], "git_node": "477abcaace41d77538d9a3a7b9ab7abff0d0d090", "git_parents": ["e7027f1b6fef9f0da57460a674409ea42cc2a348"], "node": "0bfd8142d63cad3287b7a18bb6b64b8d7caff442", "parents": ["454394049f978c68804fc6ed86de2bacdb9263aa"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085847 - Hash only the mozcheck crate files for its toolchain r=linter-reviewers,marco\n\nThe toolchain digest covered all of `tools/lint/mozcheck`, including the\nPython wrapper `__init__.py`, which the build does not read. An edit to\nthe wrapper alone made the prebuilt binary unavailable locally and\nrebuilt every mozcheck toolchain on CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336626\n", "files": ["taskcluster/kinds/toolchain/mozcheck.yml"], "git_node": "2573d11983a17eaf3ce9f55e67c53edb5a371373", "git_parents": ["477abcaace41d77538d9a3a7b9ab7abff0d0d090"], "node": "1e8a0133952a769970db86a4efadc9dce6e6e454", "parents": ["0bfd8142d63cad3287b7a18bb6b64b8d7caff442"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085848 - Pass the resolved mozcheck binary to mozlint workers r=linter-reviewers,sergesanspaille\n\nOn macOS and Windows, each mozlint worker starts a fresh Python process.\nThe workers did not see the binary `setup` cached, so every mozcheck\nlinter ran `bootstrap_toolchain` again. `bootstrap_toolchain` takes about\n3 seconds per worker, and longer when its cache is cold, since it then\nruns `mach taskgraph`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336627\n", "files": ["tools/lint/mozcheck/__init__.py"], "git_node": "a9e0730edf6eb3058f36b5c87ff32e18b1434ec0", "git_parents": ["2573d11983a17eaf3ce9f55e67c53edb5a371373"], "node": "01cd7078a41c0ce863b7b39d86bc7d5cd2d35051", "parents": ["1e8a0133952a769970db86a4efadc9dce6e6e454"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336908\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "629c12d416f61c9c651bcc99b1e63fab8361d92d", "git_parents": ["a9e0730edf6eb3058f36b5c87ff32e18b1434ec0"], "node": "a53b867f259c6ce30b076e3b8d8ba7c5647d7ada", "parents": ["01cd7078a41c0ce863b7b39d86bc7d5cd2d35051"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 10: Fix 119 'misc-unused-parameters' warnings under /ipc r=ipc-reviewers,crashreporting-reviewers,nika\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nEverything found by ./mach static-analysis was manually inspected and changed if needed.\n\nAmend: fix some /**/ instances that should've been [[maybe_unused]] instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332955\n", "files": ["ipc/chromium/src/base/message_pump_glib.cc", "ipc/chromium/src/chrome/common/ipc_message.h", "ipc/chromium/src/chrome/common/ipc_message_utils.h", "ipc/glue/BackgroundChildImpl.cpp", "ipc/glue/BackgroundImpl.cpp", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/CrashReporterHost.cpp", "ipc/glue/DataPipe.cpp", "ipc/glue/ForkServiceChild.cpp", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/IPCMessageUtilsSpecializations.h", "ipc/glue/IdleSchedulerChild.cpp", "ipc/glue/IdleSchedulerParent.cpp", "ipc/glue/MessageChannel.cpp", "ipc/glue/MessagePump.cpp", "ipc/glue/NodeController.cpp", "ipc/glue/ProcessUtils_common.cpp", "ipc/glue/ProtocolUtils.cpp", "ipc/glue/SharedMemoryHandle.cpp", "ipc/glue/SharedMemoryMapping.cpp", "ipc/glue/Shmem.cpp", "ipc/glue/UtilityMediaServiceChild.cpp", "ipc/glue/UtilityProcessChild.cpp", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/test/gtest/TestAsyncBlockers.cpp", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp", "ipc/ipdl/test/gtest/TestAsyncReturns.cpp", "ipc/ipdl/test/gtest/TestDestroyNested.cpp", "ipc/ipdl/test/gtest/TestEndpointOpens.cpp", "ipc/ipdl/test/gtest/TestHangs.cpp", "ipc/testshell/TestShellChild.cpp", "ipc/testshell/TestShellParent.cpp", "ipc/testshell/XPCShellEnvironment.cpp"], "git_node": "e01aae7c6149a2fe37d485fb5e972c8182bdf4b2", "git_parents": ["629c12d416f61c9c651bcc99b1e63fab8361d92d"], "node": "c9c1e949dcdacece09acb8783850a08e17ab5e02", "parents": ["a53b867f259c6ce30b076e3b8d8ba7c5647d7ada"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085815 - Stop overriding the injected scope's dispatcher in PocketMiddleware. r=android-reviewers,jonalmeida\n\nThe start action launched on Dispatchers.IO even when a test scope was injected, so advanceUntilIdle() in\nPocketMiddlewareTest did not wait for the workers to start and the verify raced them. The production scope\nalready defaults to Dispatchers.IO. The negative test now advances the scheduler too, so it can fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336828\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/PocketMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/PocketMiddlewareTest.kt"], "git_node": "e6dbf8cbe2d09e6ca8d282c76204be5eb4823061", "git_parents": ["e01aae7c6149a2fe37d485fb5e972c8182bdf4b2"], "node": "48780498d7de179582530e17db3da3a555a94849", "parents": ["c9c1e949dcdacece09acb8783850a08e17ab5e02"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085815 - Inject the dispatcher used by FirstSessionMetricsService. r=android-reviewers,jonalmeida\n\nThe test waited at most one second for the ping to be filled on Dispatchers.IO, which takes about half a\nsecond on an idle machine and longer when the CPU is busy, such as with parallel test forks. The tests now run\nit on the test scheduler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336829\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/FirstSessionMetricsService.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/FirstSessionMetricsServiceTest.kt"], "git_node": "20df29c41da8a5d1931b0fa9ac474fcf31168320", "git_parents": ["e6dbf8cbe2d09e6ca8d282c76204be5eb4823061"], "node": "33a00d5c4c5feb2ec84f97a1612cbec73bdf1a8d", "parents": ["48780498d7de179582530e17db3da3a555a94849"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085815 - Mock the storage in AutofillSettingsMiddlewareTest. r=android-reviewers,jonalmeida\n\nThe real AutofillCreditCardsAddressesStorage needs NSS, which Fenix unit tests never initialize. Its load ran\non Dispatchers.IO and failed in every run, but only failed a test when it completed while a runTest was\nactive. The load tests asserted the empty initial state, so they now load an item from the mock instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336830\n", "files": ["mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/autofill/ui/AutofillSettingsMiddlewareTest.kt"], "git_node": "6baa19260832b7ff2fec2b9763b2f62edd8f32d6", "git_parents": ["20df29c41da8a5d1931b0fa9ac474fcf31168320"], "node": "da72c374874c3d5a5e2d61c95ff74f0e3dcc1afc", "parents": ["33a00d5c4c5feb2ec84f97a1612cbec73bdf1a8d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085815 - Run Fenix unit tests in three parallel forks on b-linux in CI. r=releng-reviewers,android-build-system-reviewers,ahochheiden,bhearsum\n\ntestDebugUnitTest ran every test class in a single JVM, leaving most of the worker's CPUs idle. The fork count\nis a testForks Gradle property, so local runs keep a single fork unless asked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336831\n", "files": ["mobile/android/fenix/app/build.gradle", "taskcluster/kinds/test-apk/kind.yml"], "git_node": "de47c9c45521d2a7a83507f0eb196fc54f0fb846", "git_parents": ["6baa19260832b7ff2fec2b9763b2f62edd8f32d6"], "node": "bd3e835f4f8e00ba2051fabc1d85f843dc84ddf0", "parents": ["da72c374874c3d5a5e2d61c95ff74f0e3dcc1afc"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085217 - Clear snapshot flags in the unbind path. r=firefox-style-system-reviewers,dshin\n\nThis matches GeckoElement::clear_data.\n\nIn the past (before :has) these flags wouldn't be set at all on elements\nthat have no data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336565\n", "files": ["dom/base/Element.cpp", "servo/components/style/gecko/wrapper.rs", "testing/web-platform/tests/css/css-pseudo/crashtests/placeholder-style-sharing-crash.html"], "git_node": "aed653c37863ca1b923c452d83236f8cfb99d6ca", "git_parents": ["de47c9c45521d2a7a83507f0eb196fc54f0fb846"], "node": "9f0db15915bc26987babf1625f1a8bc9e55016e6", "parents": ["bd3e835f4f8e00ba2051fabc1d85f843dc84ddf0"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071519 - Always record the session_restore.number_of* counts and 0 window session restores. r=sessionstore-reviewers,sclements\n\n- restore complete in StartupPerformance only records durations when there's been (eager) tabs created\n- but always records window and tab/eager-tab counts so we catch the 0 values\n- a restore that opens 0 windows was previously not recorded because the deadline timer only starts per restored window, so sessionstore-windows-restored is now watched as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333437\n", "files": ["browser/components/sessionstore/StartupPerformance.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_restore_counts.py"], "git_node": "d3dc085403a1e829dd2e0632d633838f8a6f6d99", "git_parents": ["aed653c37863ca1b923c452d83236f8cfb99d6ca"], "node": "216e32d9bf44842bbdd2ce53ccf24967e353c424", "parents": ["9f0db15915bc26987babf1625f1a8bc9e55016e6"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2079366 - Reopen a Smart Window chat on the last page a prompt was sent from. r=fxview-reviewers,ai-security-reviewers,pdahiya,sfoster,kcochrane,mak\n\nURL objects can't be sent in actor messages, so the page of the first sidebar prompt was saved as empty and the chat reopened in full page. The page URL is now sent as a string.\n\ngetMostRecentPageVisited now uses the last message on a website, and the Firefox View Chats page reopens chats with reopenConversationInTab like the other entry points, so the sidebar shows the chat instead of a new empty one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332651\n", "files": ["browser/components/aiwindow/ui/actors/AISmartBarChild.sys.mjs", "browser/components/aiwindow/ui/actors/AISmartBarParent.sys.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_history_menu.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_recentchats.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js", "browser/components/firefoxview/chats.mjs", "browser/components/firefoxview/tests/browser/browser_chats_firefoxview.js", "browser/components/urlbar/UrlbarProviderAiChat.sys.mjs"], "git_node": "d6e976d5b36c43c605c1a1a2473ebfb36137f9d6", "git_parents": ["d3dc085403a1e829dd2e0632d633838f8a6f6d99"], "node": "824df7530fae0da35c3a73de833eaa11247f29c0", "parents": ["216e32d9bf44842bbdd2ce53ccf24967e353c424"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2082297: Adjust intermittent-on-android annotation for WPT grid-column-axis-self-baseline-synthesized-003.html, to reflect reality. r=layout-reviewers,intermittent-reviewers,TYLin,aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336320\n", "files": ["testing/web-platform/meta/css/css-grid/alignment/grid-column-axis-self-baseline-synthesized-003.html.ini"], "git_node": "b0b1a7d4d6eca3ec4f0d795d2bdf54cefc4302f9", "git_parents": ["d6e976d5b36c43c605c1a1a2473ebfb36137f9d6"], "node": "203e920b9c4fe37b62a1f6d806b58eea7a62f0e6", "parents": ["824df7530fae0da35c3a73de833eaa11247f29c0"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2083704 - Use moz-src for dom/webauthn r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335107\n", "files": ["dom/webauthn/components.conf", "dom/webauthn/moz.build", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "2c2315f7ef56e1f6dbefa8f838edb7867d96d181", "git_parents": ["b0b1a7d4d6eca3ec4f0d795d2bdf54cefc4302f9"], "node": "7a3946868a8979ae469abadd0c671a427cd7ab0f", "parents": ["203e920b9c4fe37b62a1f6d806b58eea7a62f0e6"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2085310 - Enabled `unifiedSearchButton.always` in nightly. r=jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336354\n", "files": ["browser/app/profile/firefox.js"], "git_node": "2b51a84e77a99c06f597c71fec7beacab8515243", "git_parents": ["2c2315f7ef56e1f6dbefa8f838edb7867d96d181"], "node": "0273a1939eefe98eea97f54def338c538ca6df82", "parents": ["7a3946868a8979ae469abadd0c671a427cd7ab0f"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083204 - Add nimbus flag and secret setting for browser-first handling for youtube r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335345\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/BrowserFirstFeatureHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/OpenLinksInAppsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/open_links_in_apps_preferences.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "5cc7202cbdf203ba43e7d1826463b75896040edf", "git_parents": ["2b51a84e77a99c06f597c71fec7beacab8515243"], "node": "0e1130464ec1d98e2a0a12d2949fd0c3ddce47a4", "parents": ["0273a1939eefe98eea97f54def338c538ca6df82"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2084181 - Update minimum Rust version to 1.95. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336540\n", "files": ["Cargo.toml", "docs/writing-rust-code/update-policy.md", "python/mozboot/mozboot/util.py", "taskcluster/kinds/toolchain/rust.yml"], "git_node": "f1f150a0275419d3eedd40b8ec3636bcf3ad919d", "git_parents": ["5cc7202cbdf203ba43e7d1826463b75896040edf"], "node": "3e1ae4a2512460d15683e51c34dfecae0c56d8e7", "parents": ["0e1130464ec1d98e2a0a12d2949fd0c3ddce47a4"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Load AGP and KGP in convention plugins API to avoid using reflection r=android-build-system-reviewers,ahochheiden\n\nThis change is the first step in fixing our requirement to use reflection in the convention plugin.\nIt does so by reworking how we apply the Android & Kotlin gradle plugins from applying in the root plugin to applying in the convention plugin itself, so the classes are available everywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335575\n", "files": ["build.gradle", "mobile/android/gradle/plugins/conventions/build.gradle.kts"], "git_node": "88a716c81a397030506ab851ef81fbd93dad8afd", "git_parents": ["f1f150a0275419d3eedd40b8ec3636bcf3ad919d"], "node": "6d6162c93b70f586cb805cdbd8a45749eb0f48fc", "parents": ["3e1ae4a2512460d15683e51c34dfecae0c56d8e7"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Use typed Android Gradle Plugin API in configureBuildToolsVersion r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335576\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "7e1a5cabd4903952d068638caf9daf22df5a2dc2", "git_parents": ["88a716c81a397030506ab851ef81fbd93dad8afd"], "node": "396a0c736186fc8d404de7b906f9baa772bc026c", "parents": ["6d6162c93b70f586cb805cdbd8a45749eb0f48fc"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Use typed Android Gradle Plugin API in configurePackagingResourcesExcludes r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335577\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "4236db05a4d9960ec0638dc2b9b8c293b1bcccb2", "git_parents": ["7e1a5cabd4903952d068638caf9daf22df5a2dc2"], "node": "5debd924c77cc7ac500833cb8fab0ee352bd8cef", "parents": ["396a0c736186fc8d404de7b906f9baa772bc026c"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Use typed Android Gradle Plugin API in configureJniKeepDebugSymbols r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335578\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "18b6607f6013b7c68cdbc9603dc732dae46686f2", "git_parents": ["4236db05a4d9960ec0638dc2b9b8c293b1bcccb2"], "node": "691aaad24cf91e136964fd7b1be9a76b5e3def69", "parents": ["5debd924c77cc7ac500833cb8fab0ee352bd8cef"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Use typed Android Gradle Plugin API in configureAndroidComponentsLint r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335579\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "07e8128dd9dc9c096c8809b34f9142702d3adbfc", "git_parents": ["18b6607f6013b7c68cdbc9603dc732dae46686f2"], "node": "c159f6d4652fd4e49b63f12e594406ee0ef09dd4", "parents": ["691aaad24cf91e136964fd7b1be9a76b5e3def69"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Use typed Android Gradle Plugin API in registerPrintVariantsTask r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335580\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "6a3ee29262fbd720d5aedeb035e78861eede0068", "git_parents": ["07e8128dd9dc9c096c8809b34f9142702d3adbfc"], "node": "1ca89cf3bfb751925c78ab0a97399d0b43c653a9", "parents": ["c159f6d4652fd4e49b63f12e594406ee0ef09dd4"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Remove AGP/KGP classpath from standalone fenix, focus and android-components builds r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335581\n", "files": ["mobile/android/android-components/build.gradle", "mobile/android/fenix/build.gradle", "mobile/android/focus-android/build.gradle"], "git_node": "acb459575778f161c576703446cded05bc56a9b4", "git_parents": ["6a3ee29262fbd720d5aedeb035e78861eede0068"], "node": "e365211e19372f16e8c0dba22cb8ba9135937eb3", "parents": ["1ca89cf3bfb751925c78ab0a97399d0b43c653a9"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Use typed Kotlin Gradle Plugin API in configureKotlinWarningsAsErrors r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335582\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "f628534af20bff24f6c5a8f3f9c738ec5ad6cd02", "git_parents": ["acb459575778f161c576703446cded05bc56a9b4"], "node": "3ebeb4f0115b49ed67b84940d9999ce6a53eb142", "parents": ["e365211e19372f16e8c0dba22cb8ba9135937eb3"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Use typed Kotlin Gradle Plugin API in configureKotlinCompilerMessageReformatting r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335583\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "b2344128dbfd8300805c9e2e4308bbf15072c457", "git_parents": ["f628534af20bff24f6c5a8f3f9c738ec5ad6cd02"], "node": "22f82c14c0528fd4e9697f89b5476055cd0445c7", "parents": ["3ebeb4f0115b49ed67b84940d9999ce6a53eb142"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084128 - Remove configureKotlinJvmToolchain from ProjectPlugin r=android-build-system-reviewers,ahochheiden\n\nThe configureKotlinJvmToolchain function is a no-op since AGP 9.0+ - where we have been using AGP's built-in Kotlin. That meant that we no longer explicitly had any plugin with id \"org.jetbrains.kotlin.android\".\n\nWe are also applying and setting up the JVM toolchain in the root build.gradle for now, so we are safe to remove this no-op config that uses reflection APIs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335584\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "980f15be842b40d2d51d976cf17ec71317dcb230", "git_parents": ["b2344128dbfd8300805c9e2e4308bbf15072c457"], "node": "1e2aadf16bccbe6a6f927db355b8f4684a4faf04", "parents": ["22f82c14c0528fd4e9697f89b5476055cd0445c7"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046669 - Model IP Protection usage quota with types r=android-reviewers,Roger,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334583\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/DataVolume.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/UsageQuota.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/state/DataVolumeTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/state/UsageQuotaTest.kt"], "git_node": "19850b807bb8f7c336729cf0f2e71fd2349d1751", "git_parents": ["980f15be842b40d2d51d976cf17ec71317dcb230"], "node": "51434069430d454c0442c7986a949f1ce8cea668", "parents": ["1e2aadf16bccbe6a6f927db355b8f4684a4faf04"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046669 - Replace literal types representing usage quota in IP Protection state r=android-reviewers,Roger\n\nThis change replaces existing usages that use literal types to represent usage and cycle info, with this new UsageQuota\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334584\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebug.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values/static_strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FakeEligibilityStorage.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebugTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/state/UsageQuotaTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/IPProtectionMenuBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/VpnMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/IPProtectionMenuBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItemTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/VpnMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/IPProtectionScreenTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/TrustPanelStoreTest.kt"], "git_node": "e26b68428e2ab9eabde670bf99ed195ea8a5053d", "git_parents": ["19850b807bb8f7c336729cf0f2e71fd2349d1751"], "node": "6007c53f8573edce6bc26e08a43f0366eca8308f", "parents": ["51434069430d454c0442c7986a949f1ce8cea668"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080543 - Only show the \"Search with \u003cengine\u003e\" action on temporal search suggestions when they're selected - r=adw,urlbar-reviewers\n\nTemporal suggestions come from UrlbarProviderQuickSuggest, so their rows\ndidn't get the \"search\" type and the action was always visible instead of\nonly on selection and hover like other search suggestions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336432\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal.js"], "git_node": "4ad09728794d64aa4e06fd484087a312a875a89f", "git_parents": ["e26b68428e2ab9eabde670bf99ed195ea8a5053d"], "node": "e88f0622334c2bc1960f3859f219812c66b06d68", "parents": ["6007c53f8573edce6bc26e08a43f0366eca8308f"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080619 - Don't show temporal search suggestions in search mode - r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336433\n", "files": ["browser/components/urlbar/private/TemporalSuggestions.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js"], "git_node": "269e68908cf919b0379bce2e203340a9f6e0736f", "git_parents": ["4ad09728794d64aa4e06fd484087a312a875a89f"], "node": "101b21bb241b4867ed7016216cf0dd4dd00e8dcd", "parents": ["e88f0622334c2bc1960f3859f219812c66b06d68"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080549 - Make the temporal search suggestions feature gate controllable through Nimbus - r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336434\n", "files": ["browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "7e3d703ee069df3bbff59248d7c931df3b7e900e", "git_parents": ["269e68908cf919b0379bce2e203340a9f6e0736f"], "node": "ae6d7d256737df17c3d54f260097431399fd712f", "parents": ["101b21bb241b4867ed7016216cf0dd4dd00e8dcd"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083204 - Add nimbus flag and secret setting for browser-first handling for youtube r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\" for causing lint failures\n\nThis reverts commit 5cc7202cbdf203ba43e7d1826463b75896040edf.\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/BrowserFirstFeatureHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/OpenLinksInAppsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/open_links_in_apps_preferences.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "14ac9bde965d9022cf9c6b0d7b42520d1ae5afa9", "git_parents": ["7e3d703ee069df3bbff59248d7c931df3b7e900e"], "node": "f23c35165e1482fdade877178d363f1946b192f6", "parents": ["ae6d7d256737df17c3d54f260097431399fd712f"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069796 - Don't set on tabs icons previously selected as rich. r=firefox-desktop-core-reviewers ,mossop\n\nAn icon can be picked as rich icon only because of its declared size,\nwhile its isRichIcon flag remains false, as it tracks the page declaration.\nSince both icons load in parallel and LinkHandlerParent relied on\n!isRichIcon, the rich icon could replace the tab icon if it finished\nloading last.\n\nFaviconLoader now marks the tab icon with isTabIcon, and\nLinkHandlerParent uses it for tab related decisions.\nisRichIcon is still used to store icons in Places.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334474\n", "files": ["browser/actors/LinkHandlerParent.sys.mjs", "browser/base/content/test/browser-favicons/browser.toml", "browser/base/content/test/browser-favicons/browser_sized_icon_not_tab_icon.js", "browser/base/content/test/browser-favicons/file_sized_ico_and_svg.html", "browser/base/content/test/browser-favicons/head.js", "browser/modules/FaviconLoader.sys.mjs"], "git_node": "bcce1937ac22c29846a53d9c8505615a0db51f12", "git_parents": ["14ac9bde965d9022cf9c6b0d7b42520d1ae5afa9"], "node": "3796a65e137c205090f034de5dc4c49ae38316bb", "parents": ["f23c35165e1482fdade877178d363f1946b192f6"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Store FeatureModel's clickScale option so that click models which set it are divided by their click count as computeInterestVector intends r=rrando,ini,thecount\n\nFeatureModel.fromJSON has passed `clickScale: json.clickScale` since bug 1965153, but the constructor never destructured it, so `this.clickScale` was always undefined and the scaling branch in computeInterestVector was dead. No in-tree model sets `clickScale`, so this only changes values for a remotely configured model that does, and it is the one camelCase key fromJSON reads, which may also be wrong.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333865\n", "files": ["browser/extensions/newtab/lib/InferredModel/FeatureModel.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_InferredFeatureModel.js"], "git_node": "80dc48b4dee7bbde49737a44c0b82710900d6116", "git_parents": ["bcce1937ac22c29846a53d9c8505615a0db51f12"], "node": "7604f678901dc00c4ba5e974a51ea3e22c3fbe4e", "parents": ["3796a65e137c205090f034de5dc4c49ae38316bb"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Forward applyPostProcessing through FeatureModel.computeInterestVectors so that click models are rescaled before thresholding again r=rrando,thecount\n\nBug 1992913 moved the click model's log scaling and rescaling behind an applyPostProcessing option on computeInterestVector, and InferredPersonalizationFeed passes it to computeInterestVectors, which never forwarded it, so click models have since thresholded unscaled values against cutoffs meant for values in [0, 1]. The default model in InferredConstants is a click model with `rescale: true`, so this changes the inferred, coarse and coarse private interests it reports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333855\n", "files": ["browser/extensions/newtab/lib/InferredModel/FeatureModel.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_InferredFeatureModel.js"], "git_node": "0339ba7a707460dee94d87e81fef3f242c4e94f3", "git_parents": ["80dc48b4dee7bbde49737a44c0b82710900d6116"], "node": "6e6162de7fbf61743eb8e2d22bae5c50f525b6b1", "parents": ["7604f678901dc00c4ba5e974a51ea3e22c3fbe4e"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Stop passing the action to DiscoveryStreamFeed.onTrainhopConfigChanged since it has taken no arguments since bug 1990585 added it r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333856\n", "files": ["browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs"], "git_node": "8089b1392f3fdbe89003b8bf3d3f8bb1a4744dc9", "git_parents": ["0339ba7a707460dee94d87e81fef3f242c4e94f3"], "node": "cbe18e0360c9a176c997619efd6942a6f50f6a5e", "parents": ["6e6162de7fbf61743eb8e2d22bae5c50f525b6b1"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Stop passing features to RankShortcuts.fetchRefreFeatures since bug 1989130 removed that parameter r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333857\n", "files": ["browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs"], "git_node": "51738a067f0fb3579f5b210ea85e358df2640c42", "git_parents": ["8089b1392f3fdbe89003b8bf3d3f8bb1a4744dc9"], "node": "dd441a4d24a296316fcf76518bc940642fc1248f", "parents": ["cbe18e0360c9a176c997619efd6942a6f50f6a5e"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Declare the locks global for TypeScript since system modules such as WallpaperFeed and BackupService use the LockManager that SystemGlobal defines r=Standard8,ini\n\nThis also removes the two `@ts-expect-error` comments that bug 2081929 added to SponsoredTopSitesScoreProvider because `locks` was undeclared, since tsc now reports them as unused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333858\n", "files": ["browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "tools/@types/lib.gecko.tweaks.d.ts"], "git_node": "4abbab7c080a6ef8e66567a12ef49f980c75b9af", "git_parents": ["51738a067f0fb3579f5b210ea85e358df2640c42"], "node": "95fe94803c4c43f48309fc651f125b644bcc4ded", "parents": ["dd441a4d24a296316fcf76518bc940642fc1248f"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Fix TypeScript errors for WallpaperFeed's test wrappers around RemoteSettings and IOUtils (TS2556) by typing their rest arguments as the wrapped function's parameters r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333859\n", "files": ["browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "30aba255b60c4a83ef058dc8249ba2184d426c88", "git_parents": ["4abbab7c080a6ef8e66567a12ef49f980c75b9af"], "node": "42ea41e9a0b8fd8998fbbc26d4ec57a7e92c71e2", "parents": ["95fe94803c4c43f48309fc651f125b644bcc4ded"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Fix TypeScript errors for DiscoveryStreamFeed's refreshAll and isExpired options and its request bodies (TS2345, TS2353, TS2339, TS2739) by documenting the options that callers omit as optional r=thecount\n\nThe `Glean.newtabContent.surfaceIdRejected` call from bug 2083732 keeps a `@ts-expect-error`, because `tools/@types/generated/lib.gecko.glean.d.ts` has not been regenerated since that metric was added.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333860\n", "files": ["browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "0275c8e455797d195d07c767842a0455859be246", "git_parents": ["30aba255b60c4a83ef058dc8249ba2184d426c88"], "node": "d52d80c8b03221b64321c7e37cb62bc8a6d9e7d7", "parents": ["42ea41e9a0b8fd8998fbbc26d4ec57a7e92c71e2"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Fix TypeScript errors for FeatureModel's options and interest dictionaries (TS2322, TS2339, TS2353, TS2561) by documenting the options its callers pass and typing the empty dictionaries it fills r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333861\n", "files": ["browser/extensions/newtab/lib/InferredModel/FeatureModel.sys.mjs", "browser/extensions/newtab/lib/InferredPersonalizationFeed.sys.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "6f5e56a53cd66f2b52bbdc3d9521e25ad6ad0140", "git_parents": ["0275c8e455797d195d07c767842a0455859be246"], "node": "8c9a8ae68aaf5d07797adbe0a3ee60994762e99e", "parents": ["d52d80c8b03221b64321c7e37cb62bc8a6d9e7d7"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Return 0 from interpolateWrappedHistogram for an empty histogram as documented instead of returning the empty array r=thecount\n\nRankShortcuts builds the hourly and daily seasonality histograms with 24 and 7 bins, so this is not reached today; if it were, processSeasonality would pass the empty arrays to sumNorm, where adding them to 0 produces the string \"0\" and every weight becomes NaN.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333862\n", "files": ["browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcutsWorkerClass.mjs", "browser/extensions/newtab/test/xpcshell/test_ShortcutRanker.js"], "git_node": "eb2c20d93d0f16140e3f98e811611e364aad6eff", "git_parents": ["6f5e56a53cd66f2b52bbdc3d9521e25ad6ad0140"], "node": "c96ba47b384501cbd800966ee4a4c00b495d6e3e", "parents": ["8c9a8ae68aaf5d07797adbe0a3ee60994762e99e"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Fix TypeScript errors for the smart shortcuts ranker's histogram and frecency feature types (TS2322, TS2339, TS2345, TS2739) whose JSDoc described arrays as numbers r=thecount\n\nbuildFrecencyFeatures and fetchRefreFeatures also documented the seasonality return shape instead of the per-feature dictionaries they return, and sortKeysValues documented its keys and scores in the opposite order to the one it returns them in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333863\n", "files": ["browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcutsWorkerClass.mjs", "browser/extensions/newtab/lib/SmartShortcutsRanker/ThomSample.mjs", "browser/extensions/newtab/tsconfig.json"], "git_node": "f0f095b1ad606205f1212107732b4f94a7f6081f", "git_parents": ["eb2c20d93d0f16140e3f98e811611e364aad6eff"], "node": "8bd47e97525bd4e7a5f20ab612617d2ed9b7c63c", "parents": ["c96ba47b384501cbd800966ee4a4c00b495d6e3e"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082014 - Fix TypeScript errors for the smart shortcuts ranker's worker (TS2339) by subclassing PromiseWorker.AbstractWorker instead of assigning its methods to an instance r=thecount\n\nThis also adds the first test that starts the real worker, since every other ranker test stands a local object in for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333864\n", "files": ["browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.worker.mjs", "browser/extensions/newtab/test/xpcshell/test_ShortcutRanker.js", "browser/extensions/newtab/tsconfig.json"], "git_node": "a9cbcb19d8f9bdb3e54d314ba2d1fa66ec0145ab", "git_parents": ["f0f095b1ad606205f1212107732b4f94a7f6081f"], "node": "972ded0f27cf227d36701c86b931a2b203c77292", "parents": ["8bd47e97525bd4e7a5f20ab612617d2ed9b7c63c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079476 - Pt 1 - Let a tiled surface draw its primitives into extra tasks besides its tiles. r=gfx-reviewers,nical\n\nEach extra task covers a rect of the surface and gets the same dependencies as\nthe tiles. Nothing adds one yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335469\n", "files": ["gfx/wr/webrender/src/command_buffer.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/surface.rs"], "git_node": "ecbd96286e835e9feca2ddcc70b7d9e473965c93", "git_parents": ["a9cbcb19d8f9bdb3e54d314ba2d1fa66ec0145ab"], "node": "8e142a8b9911a26a60dd3e94662f319f10a27369", "parents": ["972ded0f27cf227d36701c86b931a2b203c77292"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079476 - Pt 2 - Don't promote compositor surfaces in the areas backdrop-filters sample. r=gfx-reviewers,nical\n\nA compositor surface isn't drawn into a slice's tiles, so a backdrop read from\nthe slice's primitives misses it. Before visibility, find the area each\nbackdrop-filter samples in its own slice and in the slices below it, and\npromote nothing to a compositor surface there. Elsewhere in those slices,\nsurfaces are still promoted.\n\nThe slices above are visited first, so which of their backdrop-filters are\ndrawn is known before a slice's surfaces are promoted. A slice's own\nbackdrop-filters are only found to be drawn as the slice is visited, after the\nprimitives behind them, so they count whether drawn or not.\n\nMerging the slices under a backdrop-filter into one atomic slice already keeps\noverlays out of it, so for now this only stops 8 bit underlays from being\npromoted there, rather than promoting and then cancelling them:\nunderlay-backdrop-filter-cancel now expects no underlays. The slices below\nare read from in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335470\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/wrench/reftests/compositor-surface/reftest.list", "gfx/wr/wrench/reftests/compositor-surface/underlay-backdrop-filter-cancel.yaml"], "git_node": "0489ecf65993b4bc5c2b9a9671f0a158605e72cb", "git_parents": ["ecbd96286e835e9feca2ddcc70b7d9e473965c93"], "node": "898c1161a502a23c348880b4e88108192b188286", "parents": ["8e142a8b9911a26a60dd3e94662f319f10a27369"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079476 - Pt 3 - Read a backdrop-filter's backdrop from the slices below its own instead of merging them. r=gfx-reviewers,nical\n\nMerging everything behind a backdrop-filter into one atomic slice meant that\nscrolling content under it invalidated the whole slice every frame, and that\ncontent in an earlier primary slice, such as a remote browser under chrome,\nwas not seen at all.\n\nEach capture's sampled region is now drawn in the slices below from the same\ncommands as their tiles, and composited into the capture, when it is opened,\nbefore the backdrop slice's own primitives.\n\nThe backdrop is redrawn when what it reads from the slices below changes, or\nthey have dirty tiles in the sampled area. What each capture read last frame is\nkept: its region, and for each slice the sampled rect, its transform to the\ncapture and its background color. This catches changes that dirty none of the\nslices' tiles, such as a clip growing or a slice no longer being sampled, and\ndoesn't redraw the backdrop when it moves together with the slices below, as\nwhen panning while zoomed.\n\nWhether a backdrop is drawn this frame is decided before prepare, and the\nparts of the slices below drawn for it are only used by the backdrop slice's\ntiles. Tiles that prepare used to cull, find occluded, or invalidate for a lost\nsurface are now handled first, in TileCacheInstance::cull_tiles, so the decision\nsees the same tiles prepare draws. Otherwise a backdrop over a slice whose tiles\nare all occluded leaves those parts with no task using them (bug 2085788), and a\nbackdrop slice tile redrawn after its texture was evicted misses the slices\nbelow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335471\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/wrench/invalidation/backdrop_above_slice_overlay.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_clip_grow_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_clip_grow_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_move_together_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_move_together_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_overlay.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_overlay_ref.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_under_clip_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_under_clip_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_uncovered_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_uncovered_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_underlay.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_underlay_ref.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_unsampled_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_unsampled_2.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_control.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_inside.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_inside_ref.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_outside.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-invisible-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-invisible.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-occluded-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-occluded.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-partial-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-partial.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scaled-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scaled.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scroll-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scroll.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-two-scrollers-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-two-scrollers.yaml", "gfx/wr/wrench/reftests/filters/reftest.list", "gfx/wr/wrench/src/test_invalidation.rs"], "git_node": "8beacee1246def77e093700789f31e3ba9cd4749", "git_parents": ["0489ecf65993b4bc5c2b9a9671f0a158605e72cb"], "node": "ae869c1635bd73f8e6b92cc512548f9b550368b3", "parents": ["898c1161a502a23c348880b4e88108192b188286"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079476 - Pt 4 - Apply a lower slice's rounded compositor clip to the backdrop read from it. r=gfx-reviewers,nical\n\nThe clip is applied when the slice's tiles are composited, not to its\nprimitives, so the backdrop read from those primitives was missing it. The\nclip is also part of what a capture reads from the slice, so the backdrop is\nredrawn when it changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335472\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/wrench/invalidation/backdrop_cross_slice_radius_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_radius_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_rounded.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_rounded_ref.yaml", "gfx/wr/wrench/src/test_invalidation.rs"], "git_node": "4490031272fc83816f82909b0493a4f132a0b26f", "git_parents": ["8beacee1246def77e093700789f31e3ba9cd4749"], "node": "f79fc2dbdfd6d1a3ba86989b6368a8e06dc6bc52", "parents": ["ae869c1635bd73f8e6b92cc512548f9b550368b3"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2067191 - Add the error handling if the ViewTimeline has zero cover range. r=layout-scroll-driven-animation-reviewers,dshin\n\nThe `AnimationTimeline.currentTime` API [1] shouldn't return Infinity\nif we got the zero cover range for ViewTimeline.\n\nNote that the spec is not yet updated for the case if the 0% position and\n100% position coincide [2][3]. For now, we just do an error handling to\navoid the unexpected value for ViewTimeline.\n\n[1] https://drafts.csswg.org/web-animations-2/#dom-animationtimeline-currenttime\n[2] https://drafts.csswg.org/scroll-animations-1/#view-timeline-progress\n[3] https://github.com/w3c/csswg-drafts/issues/9256\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336916\n", "files": ["dom/animation/ScrollTimeline.cpp", "dom/animation/ScrollTimeline.h", "testing/web-platform/meta/scroll-animations/css/view-timeline-unresolved-current-time-at-effect-end.html.ini"], "git_node": "d47a9520de87dc3407da9e23d016b209e35708cf", "git_parents": ["4490031272fc83816f82909b0493a4f132a0b26f"], "node": "636045503ad67e8edc7edfafc7b565580e946dc4", "parents": ["f79fc2dbdfd6d1a3ba86989b6368a8e06dc6bc52"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083204 - Add nimbus flag and secret setting for browser-first handling for youtube r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335345\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/BrowserFirstFeatureHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/OpenLinksInAppsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/open_links_in_apps_preferences.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "4d8a9b4e8df45cae2681ad4c26c2e61a74b11d14", "git_parents": ["d47a9520de87dc3407da9e23d016b209e35708cf"], "node": "e7b936eed60608d9f7af7cfd5be4864e911ffa64", "parents": ["636045503ad67e8edc7edfafc7b565580e946dc4"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2085424 - [devtools] Remove deprecated screenshot codepath. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336737\n", "files": ["devtools/client/definitions.js", "devtools/client/fronts/inspector.js", "devtools/client/shared/screenshot.js", "devtools/client/webconsole/actions/input.js"], "git_node": "e62f29ff1f509bd49c4db519ce1662e1eea30ea3", "git_parents": ["4d8a9b4e8df45cae2681ad4c26c2e61a74b11d14"], "node": "b35b9cb84440a28d1dd3d7af0008e1df00d60f41", "parents": ["e7b936eed60608d9f7af7cfd5be4864e911ffa64"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085310 - Enabled `unifiedSearchButton.always` in nightly. r=jteow\" for causing bc failures @ browser_searchModeSwitcher_basic.js\n\nThis reverts commit 2b51a84e77a99c06f597c71fec7beacab8515243.\n", "files": ["browser/app/profile/firefox.js"], "git_node": "4815169823e64d824584702d460dea08f9f79be6", "git_parents": ["e62f29ff1f509bd49c4db519ce1662e1eea30ea3"], "node": "6942a30158a2aa99817f7d6e0e550b21a1539fbb", "parents": ["b35b9cb84440a28d1dd3d7af0008e1df00d60f41"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Implement CSSNumericValue.min(); r=emilio,firefox-style-system-reviewers\n\nImplement CSSNumericValue.min() according to the CSS Typed OM specification.\n\nReuse the existing SameUnitValueComputation helper to simplify minimum\nexpressions with matching units, and the shared AddTypes() infrastructure to\nvalidate numeric types.\n\nExtend CSSMathMin::Create() to support constructing minimum expressions\ndirectly from DOM numeric values, without requiring an intermediate Stylo\nrepresentation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334435\n", "files": ["layout/style/typedom/CSSMathMin.cpp", "layout/style/typedom/CSSMathMin.h", "layout/style/typedom/CSSNumericValue.cpp", "layout/style/typedom/CSSNumericValue.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini"], "git_node": "148d3fe62bae4cc355f82c16ae07ea953566f1b2", "git_parents": ["4815169823e64d824584702d460dea08f9f79be6"], "node": "505910479ccde60867e909e82cc4b74732b62fcc", "parents": ["6942a30158a2aa99817f7d6e0e550b21a1539fbb"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2081689 - Implement CSSNumericValue.max(); r=emilio,firefox-style-system-reviewers\n\nImplement CSSNumericValue.max() according to the CSS Typed OM specification.\n\nReuse the existing SameUnitValueComputation helper to simplify maximum\nexpressions with matching units, and the shared AddTypes() infrastructure to\nvalidate numeric types.\n\nExtend CSSMathMax::Create() to support constructing maximum expressions\ndirectly from DOM numeric values, without requiring an intermediate Stylo\nrepresentation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334436\n", "files": ["layout/style/typedom/CSSMathMax.cpp", "layout/style/typedom/CSSMathMax.h", "layout/style/typedom/CSSNumericValue.cpp", "layout/style/typedom/CSSNumericValue.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini"], "git_node": "655f4c7aa89020663f417558d8d59e84b1b1f4e5", "git_parents": ["148d3fe62bae4cc355f82c16ae07ea953566f1b2"], "node": "cc152758ccd02b4eb39be1e80c6bc14d8f70a17a", "parents": ["505910479ccde60867e909e82cc4b74732b62fcc"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2082914 - Remove browser.nova.enabled=false coverage tests r=adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335512\n", "files": ["browser/components/urlbar/moz.build", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser-nova.toml", "browser/components/urlbar/tests/browser-UrlbarInput/browser-proton.toml", "browser/components/urlbar/tests/browser-UrlbarView/browser-nova.toml", "browser/components/urlbar/tests/browser-UrlbarView/browser-proton.toml", "browser/components/urlbar/tests/browser-UrlbarView/browser_resultDisplay.js", "browser/components/urlbar/tests/browser-UrlbarView/browser_resultTypes_display.js", "browser/components/urlbar/tests/browser-autofill/browser-nova.toml", "browser/components/urlbar/tests/browser-autofill/browser-proton.toml", "browser/components/urlbar/tests/browser-editing/browser-nova.toml", "browser/components/urlbar/tests/browser-editing/browser-proton.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser-nova.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser-proton.toml", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-quickactions/browser-nova.toml", "browser/components/urlbar/tests/browser-quickactions/browser-proton.toml", "browser/components/urlbar/tests/browser-results/browser-nova.toml", "browser/components/urlbar/tests/browser-results/browser-proton.toml", "browser/components/urlbar/tests/browser-results/browser_tag_star_visibility.js", "browser/components/urlbar/tests/browser-search/browser-nova.toml", "browser/components/urlbar/tests/browser-search/browser-proton.toml", "browser/components/urlbar/tests/browser-search/browser_oneOffs_heuristicRestyle.js", "browser/components/urlbar/tests/browser-searchMode/browser-nova.toml", "browser/components/urlbar/tests/browser-searchMode/browser-proton.toml", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser-tabs/browser-nova.toml", "browser/components/urlbar/tests/browser-tabs/browser-proton.toml", "browser/components/urlbar/tests/browser-tabs/browser_switchToTab_chiclet.js", "browser/components/urlbar/tests/browser-telemetry/browser-nova.toml", "browser/components/urlbar/tests/browser-telemetry/browser-proton.toml", "browser/components/urlbar/tests/browser-tips/browser-nova.toml", "browser/components/urlbar/tests/browser-tips/browser-proton.toml", "browser/components/urlbar/tests/browser-tips/browser_tip_richSuggestion.js", "browser/components/urlbar/tests/browser-trustPanel/browser-nova.toml", "browser/components/urlbar/tests/browser-trustPanel/browser-proton.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-updateResults/browser-nova.toml", "browser/components/urlbar/tests/browser-updateResults/browser-proton.toml", "browser/components/urlbar/tests/browser/browser-nova.toml", "browser/components/urlbar/tests/browser/browser-proton.toml", "browser/components/urlbar/tests/browser/searchbar/browser-nova.toml", "browser/components/urlbar/tests/browser/searchbar/browser-proton.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser-nova.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser-proton.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest.js", "browser/components/urlbar/tests/unit/test_UrlbarNewTabComponentRegistrant.js"], "git_node": "0a17a80f27813196a1230c608782dc64690373db", "git_parents": ["655f4c7aa89020663f417558d8d59e84b1b1f4e5"], "node": "6d158f0277e7b8e3d83013c325b3178cc35002ac", "parents": ["cc152758ccd02b4eb39be1e80c6bc14d8f70a17a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083610. Restart node on new ports when its ports are already in use on the Android device. r=ahal\n\nhttps://searchfox.org/firefox-main/rev/c0ad8e7c1d3d33cf3405f7019994471ac8baf4e7/testing/xpcshell/remotexpcshelltests.py#715\n\nThe moz-http2 node server picks ports that are free on the host, and we then\nadb reverse the same port numbers on the device. Sometimes one of them is\nalready in use on the device and the whole run fails before any test starts:\n\n    adb wait-for-device reverse tcp:38929 tcp:38929, exitcode: 1, stdout: adb: error: cannot bind listener: Address already in use\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335075\n", "files": ["testing/xpcshell/remotexpcshelltests.py"], "git_node": "ef5cf89525d0a6025282aecfa29661dad266225e", "git_parents": ["0a17a80f27813196a1230c608782dc64690373db"], "node": "c19ff990940b5292776772ad7193e6d319885446", "parents": ["6d158f0277e7b8e3d83013c325b3178cc35002ac"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073466 - Connection Allowlists: Show blocked reason in devtools. r=devtools-reviewers,necko-reviewers,valentin,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336131\n", "files": ["devtools/client/netmonitor/src/constants.js", "devtools/client/netmonitor/test/browser_al.toml", "devtools/client/netmonitor/test/browser_net_block-connection-allowlist.js", "devtools/client/netmonitor/test/html_connection-allowlist-test-page.html", "devtools/client/netmonitor/test/html_connection-allowlist-test-page.html^headers^", "dom/security/ConnectionAllowlistsService.cpp", "netwerk/base/nsILoadInfo.idl"], "git_node": "029aaa135f7e5eb3233c179fd78c5f8067d46bcf", "git_parents": ["ef5cf89525d0a6025282aecfa29661dad266225e"], "node": "66c544a626fb1003e12af94e0e67672440ea0f2a", "parents": ["c19ff990940b5292776772ad7193e6d319885446"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066771 - Updates the dragline between tabs to show for overflowed tabs and on hover with collapsed sidebar. r=sidebar-reviewers,nsharpley\n\nWith vertical tabs, previously, the divider between the tabs and tools was always drawn.\nThis patch updates the behavior to only show when tabs are overflowing while keeping the hover state in place.\nNote: Because of the extended behavior for tab overflow, removing the background image just for the expand-on-hover mode was no longer an exception so I pulled that comment out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335767\n", "files": ["browser/components/sidebar/sidebar-main.css", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/browser/browser_launcher_dividers.js"], "git_node": "1119fe08671f3b49b09f15857585f164fe94cdea", "git_parents": ["029aaa135f7e5eb3233c179fd78c5f8067d46bcf"], "node": "142bb7a65e5871731905dd7a8330938c44cba6c2", "parents": ["66c544a626fb1003e12af94e0e67672440ea0f2a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1981478 - Flip prefs to switch to NDK decoding/encoding on Android on nightly. r=media-playback-reviewers,azebrowski\" for causing webgl android failures\n\nThis reverts commit 17fdf0b741cf50c38e7303eb44fc0f0683e930c4.\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "3a2f304fc3eee2fca2ae8c0c28b6f34768d99780", "git_parents": ["1119fe08671f3b49b09f15857585f164fe94cdea"], "node": "56c6a195ed13b1c9fd64e77b00de7113141c53e1", "parents": ["142bb7a65e5871731905dd7a8330938c44cba6c2"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 1 - Pass private browsing state to JumpListBuilder. r=win-reviewers,gstoll\n\nRefactor only.  No substantive changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328660\n", "files": ["widget/windows/JumpListBuilder.cpp", "widget/windows/JumpListBuilder.h", "widget/windows/WinTaskbar.cpp", "widget/windows/tests/gtest/TestJumpListBuilder.cpp"], "git_node": "c45066e21d44b4a61920c2088e266b9ff9881b8b", "git_parents": ["3a2f304fc3eee2fca2ae8c0c28b6f34768d99780"], "node": "00bdbdd016b33e85341244e0c8ced365a6b4f63e", "parents": ["56c6a195ed13b1c9fd64e77b00de7113141c53e1"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 2 - Control separate STAs for Windows Jump List builders r=Jamie,win-reviewers,gstoll\n\nCLSID_DestinationList and CLSID_ApplicationDestinations are STA objects.\nCreating them from the MTA, as we have been doing, made COM host them in a\nsingle, process-wide implicit STA that it created, and marshal every call to it.\nThis serialised the normal and private-browsing builders against each other\nand turned teardown into a cross-apartment call.  One builder's stalled shell\ncall blocked the other's shutdown.  Additionally, LazyIdleThread, which\nbacked the MTA threads, was deadlocking at shutdown because it blocks on a\ntoo-early thread join to the main thread (the \"main\" STA), and doesn't spin\nan event loop when it does so.  Shutdown now spins the event loop while\nwaiting.  It is not clear that the last point was required for this deadlock,\nbut it is wrong regardless.  STAs should never block arbitrarily if they can\navoid it.  Auditing similar use in nsDataObj is bug 2074940.\n\nThis patch deliberately does _not_ timeout when it joins the new threads.  That\nwould prevent this deadlock, even if the theory that shutdown concurrency was\nto blame was wrong, but it would hide the issue rather than fix it.  This way,\nwe will know if we still have the issue.  The \"nuclear\" option of orphaning\nthese threads remains, if we need it.  Later patches in this series add\ntelemetry that would make that situation clear.\n\nTestJumpListBuilder previously only worked because the MTA happened to cause\nthe two uses to marshal to different STA objects, which was naughty, and is\nfixed here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328653\n", "files": ["build/clang-plugin/ThreadAllows.txt", "tools/lint/mscom-init.yml", "widget/windows/JumpListBuilder.cpp", "widget/windows/JumpListBuilder.h", "widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h", "widget/windows/tests/gtest/TestJumpListBuilder.cpp"], "git_node": "a855ce3cadfbeeddd49ee210ebbfb9f401b2d366", "git_parents": ["c45066e21d44b4a61920c2088e266b9ff9881b8b"], "node": "7a6009d784e7792c479d602847b4ce55a83ad1d4", "parents": ["00bdbdd016b33e85341244e0c8ced365a6b4f63e"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 3 - Time each Windows Jump List Shell call. r=win-reviewers,gstoll\n\nShort-lived telemetry (expires in Fx165) that will tell us if Jump List\nfixes are working and, if not, where they fail.  This times the operations,\nto see if they really are slow or if the bug is something else.  A later\npatch adds telemetry to detect Jump List calls that do not complete at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328654\n", "files": ["widget/windows/JumpListBuilder.cpp", "widget/windows/metrics.yaml"], "git_node": "f7a2cc2b4b44b5607933daf08a81fe9758b4769d", "git_parents": ["a855ce3cadfbeeddd49ee210ebbfb9f401b2d366"], "node": "120ce7669db66353f5b3ded59d31b3ada6b11bcb", "parents": ["7a6009d784e7792c479d602847b4ce55a83ad1d4"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 4 - Time in-flight Jump List calls in crash reports. r=win-reviewers,crashreporting-reviewers,afranchuk,gstoll\n\njump_list_shell_call, added in part 3, only records a call once it returns, so a\ncall that never returns leaves no sample.  The annotation added here is cleared\non return, so a crash report that still carries it is that case, and CrashTime\nminus the recorded value is how long the call had been blocked.\n\nUsing datetime for JumpListShellCallStart, instead of seconds from epoch, like\nsome others do, allows us to query crashTime-JumpListShellCallStart in STMO to\nget the amount of time stalled.  This is minor and simple -- the query could also\nbe written to convert crashTime to secs from epoch, but this will negate the\nneed.\n\nThe Rust function it uses to do the crashTime secs-to-date-conversion\nis renamed to convert_unix_timestamp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328655\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/glean_metrics.py", "toolkit/crashreporter/crashping/glean_rust.py", "toolkit/crashreporter/crashping/moz.build", "toolkit/crashreporter/crashping/src/annotations.rs", "widget/windows/JumpListBuilder.cpp"], "git_node": "642879d228a04ca10dc8d5f82fffe5f7ab14abb7", "git_parents": ["f7a2cc2b4b44b5607933daf08a81fe9758b4769d"], "node": "d659734efbddf89d3b215516b70503f96604b92b", "parents": ["120ce7669db66353f5b3ded59d31b3ada6b11bcb"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2085222 - [loong64] Use MOVFR2GR.[SD] to extract low 32/64 bits from VR with sign extension. r=yury\n\nPer measurement, this has an advantage of 1 cycle in latency on all\nLoongson 3A5000 (LA464), 3A6000 and 3B6000 (LA664).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336740\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "c3f8aa211b91b9c985855151c74c3ee6e9e33d90", "git_parents": ["642879d228a04ca10dc8d5f82fffe5f7ab14abb7"], "node": "55be90ec2805cc9f0d7c0e2474362f6315cd7866", "parents": ["d659734efbddf89d3b215516b70503f96604b92b"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/engine-system/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/feature/downloads/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/focus-android/app/src/main/res/values-sk/strings.xml"], "git_node": "07899212e44ba00ca71f04e7e17fbda442d13a50", "git_parents": ["c3f8aa211b91b9c985855151c74c3ee6e9e33d90"], "node": "2f2d57f9872e2543f0d268f2bcd13f6ef16e1252", "parents": ["55be90ec2805cc9f0d7c0e2474362f6315cd7866"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083227 - [loong64] Part 1: Eliminate redundant ma_cmp in ma_b(Register, Register, Condition, ...). r=spidermonkey-reviewers,jandem\n\nThis eliminates one TODO item.\n\nBefore:\n\n        slli.w  $a1, $a2, 0\n        slt     $t6, $a0, $a1\n        bne     $t6, $zero, 20\n\nAfter:\n\n        slli.w  $a1, $a2, 0\n        blt     $a0, $a1, 20\n\nThis reduces ~74603 instruction (~291.42 KiB) per Octane run on\nnon-debug shells.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334800\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "06db725bf61cdfdff180672ab499adefcdb91570", "git_parents": ["07899212e44ba00ca71f04e7e17fbda442d13a50"], "node": "ee3bd8e4f9f97a2ae8f880a3e071c06077f0be29", "parents": ["2f2d57f9872e2543f0d268f2bcd13f6ef16e1252"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083227 - [loong64] Part 2: Clean up Instruction and Inst{Reg,Imm,Jump}. r=spidermonkey-reviewers,jandem\n\nThis reorders methods so that constructors are placed in adjacent, and\nadds const specifiers to getters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334801\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h"], "git_node": "47fa2139ff8ad4fbcf6e2756f39573f2147b023d", "git_parents": ["06db725bf61cdfdff180672ab499adefcdb91570"], "node": "bb7796d6de2a0431edf156e588e4c37f6335037d", "parents": ["ee3bd8e4f9f97a2ae8f880a3e071c06077f0be29"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083227 - [loong64] Part 3: Introduce BEQZ/BNEZ branches for compares-against-zero. r=spidermonkey-reviewers,jandem\n\nThese two instructions has only one register operand, which means they\ncan encode much larger offsets (+/- 4 MiB) than the two-register\nconditional branches (+/- 128 KiB).\n\nOn Octane, this simplifies 12 sites that were originally emitted as long\njumps, plus another ~186k rewrites that have no size effect.\n\nFound by LoongLint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334802\n", "files": ["js/src/jit-test/tests/wasm/binop-loong64-ion-codegen.js", "js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "62a870a2498740aa18b8b9d4696f9fbfe50df373", "git_parents": ["47fa2139ff8ad4fbcf6e2756f39573f2147b023d"], "node": "5e69dcc593c84f30afd17dae61a1f8e6c4012701", "parents": ["bb7796d6de2a0431edf156e588e4c37f6335037d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083227 - [loong64] Part 4: Switch to Assembler::{,Non}Zero across Loong64-specific code. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334803\n", "files": ["js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "5fca058522655edd12c9438fa43d3056dd16c1d3", "git_parents": ["62a870a2498740aa18b8b9d4696f9fbfe50df373"], "node": "e8ae0cd3e525248b4bd5a8fd45b8e17dd249c156", "parents": ["5e69dcc593c84f30afd17dae61a1f8e6c4012701"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083331 - [loong64] Part 1: Introduce {,dis}assembly of some reducing vector zero/non-zero predicate instructions. r=yury\n\nThis includes:\n\n* VSETNEZ.V\n* VSETALLNEZ.[BHWD]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334846\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/disasm/Disasm-loong64.cpp"], "git_node": "5ffa4ec20c6d6129cfbc345cc8011a814046a82f", "git_parents": ["5fca058522655edd12c9438fa43d3056dd16c1d3"], "node": "09dca9abe9f4bf99b3fc4905fbe482fe70906590", "parents": ["e8ae0cd3e525248b4bd5a8fd45b8e17dd249c156"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083331 - [loong64] Part 2: Simplify anyTrueSimd128 and allTrueInt{8x16,16x8,32x4,64x2} with reducing z/nz predicates. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334847\n", "files": ["js/src/jit-test/tests/wasm/simd/reduce-loong64-ion-codegen.js", "js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "d152702e48b0b19015b0a7ec93a6907ba546608c", "git_parents": ["5ffa4ec20c6d6129cfbc345cc8011a814046a82f"], "node": "695e28742d4fe8ddd8c23ec52d89e2e0554b075d", "parents": ["09dca9abe9f4bf99b3fc4905fbe482fe70906590"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083331 - [loong64] Part 3: Introduce invertible branch-against-FCCn. r=yury\n\nThis will help fallthrough path in later parts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334848\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h"], "git_node": "c0d871cab9fc15ca39563fcd1a2b8f4e1ca3b278", "git_parents": ["d152702e48b0b19015b0a7ec93a6907ba546608c"], "node": "37bc25c04a1a864cf7fa8ab08c81f2dfb53d7360", "parents": ["695e28742d4fe8ddd8c23ec52d89e2e0554b075d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083331 - [loong64] Part 4: Simplify LWasmReduceAndBranchSimd128 using reducing predicates and branch-against-FCCn. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334849\n", "files": ["js/src/jit-test/tests/wasm/simd/reduce-loong64-ion-codegen.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp"], "git_node": "03a70eaafa73608f88ab4fb439c1ba3f9b9c1aae", "git_parents": ["c0d871cab9fc15ca39563fcd1a2b8f4e1ca3b278"], "node": "105ff99979bef0068a7cc12d13e4d5856bea2908", "parents": ["37bc25c04a1a864cf7fa8ab08c81f2dfb53d7360"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2084018 - Propagate MediaCodec output buffer release failures r=media-playback-reviewers,gfx-reviewers,bradwerth,aosmond\n\nReleaseFrameMediaCodec() currently reports success whenever it finds a retained frame, regardless of whether av_mediacodec_release_buffer() succeeds. When a render request fails, the ImageReader can therefore keep waiting for an image that was never submitted, blocking subsequent frame submissions.\n\nCheck the MediaCodec return value and propagate failures through the image callback so the ImageReader can clear its pending state. Continue resuming decoder draining whenever a retained frame is removed, including on render failure. Queue that resumption after releasing the frame-map lock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335484\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "1b2ff33417294150d748e8c5c6b6d0d8545e76a0", "git_parents": ["03a70eaafa73608f88ab4fb439c1ba3f9b9c1aae"], "node": "2fe1b4a119cbb85f3235b1aeb7ba7e8141cc7daa", "parents": ["105ff99979bef0068a7cc12d13e4d5856bea2908"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2060740 - Update ANGLE vendoring config to include GL backend on Android r=gfx-reviewers,bradwerth\n\nswiftshader.gni and vulkan_headers.gni let GN imports succeed without providing extra settings.\n\nwglext.h is not required by the Android GL backend. This entry prevents the Windows-specific wglext.h from being removed during vendoring cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316508\n", "files": ["gfx/angle/gn-configs/angle.json", "gfx/angle/update-angle.py", "python/mozbuild/mozbuild/vendor/host_angle.py", "third_party/build_overrides/swiftshader.gni", "third_party/build_overrides/vulkan_headers.gni"], "git_node": "0f3a0b27978aa74a8d4f8af475da8d89927ecefa", "git_parents": ["1b2ff33417294150d748e8c5c6b6d0d8545e76a0"], "node": "2accd842846e2a46ed7713978b71c0205aab197c", "parents": ["2fe1b4a119cbb85f3235b1aeb7ba7e8141cc7daa"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2072096 - Part 1: Ensure all blob:null URIs hold consistent principals, r=dom-core-reviewers,vhilla,smaug\n\nAdds an extra table which is tracked within the protocol handler to\ntrack associations between blob: URLs, and their content principals, to\nensure that they remain consistent. This is tracked by the Blob data\nentry as well as all parsed Blob URLs within the process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331351\n", "files": ["dom/file/uri/BlobURL.cpp", "dom/file/uri/BlobURL.h", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/file/uri/BlobURLProtocolHandler.h", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentParent.cpp"], "git_node": "31ff32bbcdcf80827e72d6af6d5241bfbb9c7658", "git_parents": ["0f3a0b27978aa74a8d4f8af475da8d89927ecefa"], "node": "741ef01f69c3d52750f5abbee5b1f45643cad51c", "parents": ["2accd842846e2a46ed7713978b71c0205aab197c"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2072096 - Part 2: Clarify meaning of BlobURL::GetNullPrincipal, r=vhilla\n\nThe type is now explicitly `NullOrigin` to make it more clear that it\ncan also apply to content principals in addition to null principals in\nthe case where the origin doesn't have a web-exposed origin\nserialization (e.g. `file://` URIs).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333748\n", "files": ["dom/file/uri/BlobURL.cpp", "dom/file/uri/BlobURL.h", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/file/uri/BlobURLProtocolHandler.h", "ipc/glue/URIParams.ipdlh"], "git_node": "6955af1bd121f6da8c590c699d6e2e3fba42bfb9", "git_parents": ["31ff32bbcdcf80827e72d6af6d5241bfbb9c7658"], "node": "2a80cc0794ee49a1cafc81a06819ddefb1612feb", "parents": ["741ef01f69c3d52750f5abbee5b1f45643cad51c"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080546 - Don't expand the number of zero prefix results when every temporal type is turned off - r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336435\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/private/TemporalSuggestions.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal_zeroPrefixLayout.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporal.js", "browser/components/urlbar/tests/unit/test_UrlbarPrefs.js", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "02a140f37f7114dde94a86bdf8cbc445c30e5f0e", "git_parents": ["6955af1bd121f6da8c590c699d6e2e3fba42bfb9"], "node": "70d0bce98bca74860a4777db73809ec7a45b27f1", "parents": ["2a80cc0794ee49a1cafc81a06819ddefb1612feb"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056107 - Validate IsKnownForChildID in RecvCreateBrowsingContext, r=dom-core-reviewers,vhilla\n\nThis isn't necessary for the parent because of the earlier check\n(parent-\u003eGetIsContentParent() != this).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313545\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "c76ca57e21786c6cd9e64ce5f49824d9d39f3050", "git_parents": ["02a140f37f7114dde94a86bdf8cbc445c30e5f0e"], "node": "6d7499ceef1c05bca0ce6f407a83fcd8ab9ed658", "parents": ["70d0bce98bca74860a4777db73809ec7a45b27f1"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2060230 - Consider TriggeringRemoteType in IsolationOptionsForNavigation, r=vhilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333354\n", "files": ["dom/ipc/ProcessIsolation.cpp"], "git_node": "0caf08d01122563fbe9ca617c40b423dc8d0bd2a", "git_parents": ["c76ca57e21786c6cd9e64ce5f49824d9d39f3050"], "node": "b9a3ac9a30ca5057280eaf40f1bfa53f10f3fd02", "parents": ["6d7499ceef1c05bca0ce6f407a83fcd8ab9ed658"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2084890 - display title/site placeholders in notification if reading a private tab r=android-reviewers,android-l10n-reviewers,moyin,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336312\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/PlaybackControllerTest.kt"], "git_node": "904410f4fd16874ffbeb25eb7707fdd4dfa10c05", "git_parents": ["0caf08d01122563fbe9ca617c40b423dc8d0bd2a"], "node": "a0a0a6848b5312f3727af99966e237850eb03533", "parents": ["b9a3ac9a30ca5057280eaf40f1bfa53f10f3fd02"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082538 - Let remote H.264 max-fs/max-mbps override the profile-level-id limits. r=webrtc-reviewers,pehrsons\n\nPer RFC 6184 section 8.1 these replace the level's values rather than only lowering them. Explicit values are bounded by level 5.2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334758\n", "files": ["dom/media/webrtc/jsep/JsepCodecDescription.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "testing/web-platform/tests/webrtc/protocol/h264-fmtp-modifies-level.https.html"], "git_node": "d67faa2e7f339f695d9aa5c37ec81379e1c97df1", "git_parents": ["904410f4fd16874ffbeb25eb7707fdd4dfa10c05"], "node": "7be1793355ffccbaef74700b040c43d3eb4a2328", "parents": ["a0a0a6848b5312f3727af99966e237850eb03533"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073787: Part 4 - Time in-flight Jump List calls in crash reports. r=win-reviewers,crashreporting-reviewers,afranchuk,gstoll\" for causing build bustages\n\nThis reverts commit 642879d228a04ca10dc8d5f82fffe5f7ab14abb7.\n\nRevert \"Bug 2073787: Part 3 - Time each Windows Jump List Shell call. r=win-reviewers,gstoll\"\n\nThis reverts commit f7a2cc2b4b44b5607933daf08a81fe9758b4769d.\n\nRevert \"Bug 2073787: Part 2 - Control separate STAs for Windows Jump List builders r=Jamie,win-reviewers,gstoll\"\n\nThis reverts commit a855ce3cadfbeeddd49ee210ebbfb9f401b2d366.\n\nRevert \"Bug 2073787: Part 1 - Pass private browsing state to JumpListBuilder. r=win-reviewers,gstoll\"\n\nThis reverts commit c45066e21d44b4a61920c2088e266b9ff9881b8b.\n", "files": ["build/clang-plugin/ThreadAllows.txt", "toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/glean_metrics.py", "toolkit/crashreporter/crashping/glean_rust.py", "toolkit/crashreporter/crashping/moz.build", "toolkit/crashreporter/crashping/src/annotations.rs", "tools/lint/mscom-init.yml", "widget/windows/JumpListBuilder.cpp", "widget/windows/JumpListBuilder.h", "widget/windows/WinTaskbar.cpp", "widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h", "widget/windows/metrics.yaml", "widget/windows/tests/gtest/TestJumpListBuilder.cpp"], "git_node": "9c4b676f7b4dd0952f3957421403a0d1d329d52d", "git_parents": ["d67faa2e7f339f695d9aa5c37ec81379e1c97df1"], "node": "ca7f540d1253e4dc2077b1f749ca381bc6f49078", "parents": ["7be1793355ffccbaef74700b040c43d3eb4a2328"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083434 - [loong64] Part 1: Uniformly delegate to ma_{load,store} {load,store}{32,Ptr} family. r=yury\n\nAlso relax an assertion that extension==ZeroExtend in the SizeDouble arm\nof ma_load(Register, const BaseIndex&, ...). This now matches the\nbehavior of overload ma_load(Register, Address, ...), and the default\nparameter now works with SizeDouble.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334929\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "c3a68700d8dd8a990323fb084cd283874851fdf5", "git_parents": ["9c4b676f7b4dd0952f3957421403a0d1d329d52d"], "node": "3a57566987608a719f48a78a5207ca94def10de1", "parents": ["ca7f540d1253e4dc2077b1f749ca381bc6f49078"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2083434 - [loong64] Part 2: Swap operand order of {,F,V}LDX.* to work around a performance quirk on LA464/LA664. r=yury\n\nLDX instructions form the effective address by rj+rk, then operates on\nthat address. The addition should be commutative, but experiments have\nshown otherwise.\n\nFor example, on LA464 and LA664, assuming that $a3 is calculated long\nbefore:\n\n        slli.d  $t2, $t2, 3\n        ldx.d   $t2, $a3, $t2\n        (latency = 6 cycles)\n\n        slli.d  $t2, $t2, 3\n        ldx.d   $t2, $t2, $a3\n        (latency = 5 cycles)\n\n        alsl.d  $t2, $t2, $a3, 3\n        ldptr.d $t2, $t2, 0\n        (latency = 5 cycles)\n\nFP instrucion FLDX.D and vector instructions VLDX/XVLDX all have such a\n1-cycle penalty, growing from 8 to 9, 9 to 10, and 11 to 12 cycles,\nrespectively.\n\nIt's possible that these microarchs can only forward (bypass) ALU\nresults to the rj operand of the LDX instruction. It's better to put the\nnearest defined register into rj, and put the other into rk. This has no\nfunctional change, and could work around this quirk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334930\n", "files": ["js/src/jit-test/tests/wasm/memory-loong64-ion-codegen.js", "js/src/jit-test/tests/wasm/simd/load-splat-widen-loong64-ion-codegen.js", "js/src/jit-test/tests/wasm/simd/reduce-loong64-ion-codegen.js", "js/src/jit-test/tests/wasm/store-zero-loong64-ion-codegen.js", "js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "e585245edc4873d5c92c2498aa21b930ec7f3432", "git_parents": ["c3a68700d8dd8a990323fb084cd283874851fdf5"], "node": "1025af7c69813afabe380090ed6b73589e2a20a2", "parents": ["3a57566987608a719f48a78a5207ca94def10de1"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060740 - Update ANGLE vendoring config to include GL backend on Android r=gfx-reviewers,bradwerth\" for causing lint vendor failures\n\nThis reverts commit 0f3a0b27978aa74a8d4f8af475da8d89927ecefa.\n", "files": ["gfx/angle/gn-configs/angle.json", "gfx/angle/update-angle.py", "python/mozbuild/mozbuild/vendor/host_angle.py", "third_party/build_overrides/swiftshader.gni", "third_party/build_overrides/vulkan_headers.gni"], "git_node": "a16636cf243d235938859850a5a037557a5593cd", "git_parents": ["e585245edc4873d5c92c2498aa21b930ec7f3432"], "node": "ec9d5db77b7d9c31c5bf1cbd97765ff90f292dc7", "parents": ["1025af7c69813afabe380090ed6b73589e2a20a2"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085035 - Announce Listen icon on the address bar r=android-reviewers,android-l10n-reviewers,matt-tighe,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336383\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ReaderModePanel.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt"], "git_node": "a6544ff7d8f985e3e7959d6c2e5de57b62a74dd6", "git_parents": ["a16636cf243d235938859850a5a037557a5593cd"], "node": "7357050d4e9eaf9cf4e665ccea12f735a67f2eea", "parents": ["ec9d5db77b7d9c31c5bf1cbd97765ff90f292dc7"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2081781 - Use SipHash for CSS random() base value generation. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336877\n", "files": ["Cargo.lock", "dom/base/Document.cpp", "dom/base/Document.h", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "servo/components/style/Cargo.toml", "servo/components/style/device/gecko.rs", "servo/components/style/device/servo.rs", "servo/components/style/values/computed/mod.rs"], "git_node": "34691d5daf50ab11ef441a3477559a710af212bd", "git_parents": ["a6544ff7d8f985e3e7959d6c2e5de57b62a74dd6"], "node": "1cb228cd2f9efacc58cb947e4ac3472076c7149f", "parents": ["7357050d4e9eaf9cf4e665ccea12f735a67f2eea"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2082205 - Make `HTMLEditor::ReapplyCachedStyles` clone the cached style while it computes the preserving styles r=m_kato\n\nThat requires to flush pending notifications at computing current style.\nTherefore, it should clone the cached styles first. Then, it should\nhandle only the original caches styles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334438\n", "files": ["editor/libeditor/HTMLEditSubActionHandler.cpp"], "git_node": "522ed357164cb240437a2e7e5a81de1bcb74af14", "git_parents": ["34691d5daf50ab11ef441a3477559a710af212bd"], "node": "13ec717c39c51f553afe367767ee43df1253ad70", "parents": ["1cb228cd2f9efacc58cb947e4ac3472076c7149f"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085450 - send Fetch Metadata headers with WebAuthn related origin requests. r=mfarrell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336794\n", "files": ["dom/webauthn/WebAuthnRelatedOriginFetcher.sys.mjs", "dom/webauthn/tests/test_webauthn_related_origin.html", "dom/webauthn/tests/webauthn-wellknown.sjs"], "git_node": "82ff8f5225953f607577e9213b174441d325c371", "git_parents": ["522ed357164cb240437a2e7e5a81de1bcb74af14"], "node": "b89ee1f3b8d0444814225315fec477f5b8106c24", "parents": ["13ec717c39c51f553afe367767ee43df1253ad70"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085470: Register the Cocoa app shell test interface with ESLint. r=frontend-codestyle-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336498\n", "files": ["tools/lint/eslint/eslint-plugin-mozilla/lib/rules/valid-ci-uses.mjs"], "git_node": "6bfe03369fd6fdd566179686719a03f4602a6708", "git_parents": ["82ff8f5225953f607577e9213b174441d325c371"], "node": "21f57ff2417aaedda0e4d47910eeaed658273a42", "parents": ["b89ee1f3b8d0444814225315fec477f5b8106c24"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077353 - keep favicon image processing out of the parent in the broken site reporter UI; r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336247\n", "files": ["browser/components/reportbrokensite/test/browser/browser_url_widgets.js", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs"], "git_node": "418d7edd5fede0d98c711fbbc227abac3e9398c6", "git_parents": ["6bfe03369fd6fdd566179686719a03f4602a6708"], "node": "15383af2fc5a88c4ce63e2ba7a810cee6d276f0f", "parents": ["21f57ff2417aaedda0e4d47910eeaed658273a42"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085969 - Allow WebGL to upload remotely decoded SurfaceTexture video frames. r=gfx-reviewers,sotaro\n\nWith NDK decoding on Android, video is decoded in the RDD process, so content\nreceives a SurfaceDescriptorGPUVideo with a TypeNone video type for\nSurfaceTexture frames. WebGL then falls back to a CPU readback, which\nSurfaceTextureImage does not implement, and texImage2D fails with\nGL_OUT_OF_MEMORY.\n\nReport a dedicated video type and expose the SurfaceTextureDescriptor from\nSurfaceTextureHost so WebGL can blit the frame directly in the GPU process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336956\n", "files": ["gfx/layers/LayersTypes.h", "gfx/layers/opengl/TextureClientOGL.h", "gfx/layers/opengl/TextureHostOGL.cpp", "gfx/layers/opengl/TextureHostOGL.h"], "git_node": "afab3f81d91e5a72c2af27a0ed8cdcb1907757a2", "git_parents": ["418d7edd5fede0d98c711fbbc227abac3e9398c6"], "node": "281d88c60f565f9936d00f0c8e7b415517fc3d31", "parents": ["15383af2fc5a88c4ce63e2ba7a810cee6d276f0f"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2076735 - Add Luxembourg to Weather widget's opt-in region list. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336958\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs"], "git_node": "e4b40e8953a3b85e863c6dd6e978478a273dd125", "git_parents": ["afab3f81d91e5a72c2af27a0ed8cdcb1907757a2"], "node": "c9ce6e44fc8ca5fda7796b02c76d36eff26e1328", "parents": ["281d88c60f565f9936d00f0c8e7b415517fc3d31"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083811 - Add Singapore to Weather widget region config. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336569\n", "files": ["browser/app/profile/firefox.js"], "git_node": "facc14bdeb867b5aef72fed88c2b6c0f8c5db63c", "git_parents": ["e4b40e8953a3b85e863c6dd6e978478a273dd125"], "node": "8b851f2a5d787e665404b70d0bc43ad533ec963e", "parents": ["c9ce6e44fc8ca5fda7796b02c76d36eff26e1328"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085779 - Run media tests on Android with the Java MediaCodec pipeline. r=taskgraph-reviewers,bhearsum\n\nNightly already or will soon decode/encode with the MediaCodec NDK via ffmpeg\nin the GPU/RDD processes, but release still uses the Java pipeline. Add a\nvariant restoring the release prefs, and run it for mochitest-media and the\neme, webcodecs and webrtc web-platform-tests until the NDK path ships.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336707\n", "files": ["taskcluster/kinds/mochitest/kind.yml", "taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/test_configs/variants.yml"], "git_node": 