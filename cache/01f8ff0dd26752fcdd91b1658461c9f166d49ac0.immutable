-icons/fr/android.png", "browser/themes/shared/app-marketplace-icons/fr/ios.svg", "browser/themes/shared/app-marketplace-icons/gl/android.png", "browser/themes/shared/app-marketplace-icons/gu-IN/android.png", "browser/themes/shared/app-marketplace-icons/he/android.png", "browser/themes/shared/app-marketplace-icons/he/ios.svg", "browser/themes/shared/app-marketplace-icons/hi-IN/android.png", "browser/themes/shared/app-marketplace-icons/hr/android.png", "browser/themes/shared/app-marketplace-icons/hu/android.png", "browser/themes/shared/app-marketplace-icons/hu/ios.svg", "browser/themes/shared/app-marketplace-icons/hy-AM/android.png", "browser/themes/shared/app-marketplace-icons/id/android.png", "browser/themes/shared/app-marketplace-icons/id/ios.svg", "browser/themes/shared/app-marketplace-icons/is/android.png", "browser/themes/shared/app-marketplace-icons/it/android.png", "browser/themes/shared/app-marketplace-icons/it/ios.svg", "browser/themes/shared/app-marketplace-icons/ja/android.png", "browser/themes/shared/app-marketplace-icons/ja/ios.svg", "browser/themes/shared/app-marketplace-icons/jar.mn", "browser/themes/shared/app-marketplace-icons/ka/android.png", "browser/themes/shared/app-marketplace-icons/kk/android.png", "browser/themes/shared/app-marketplace-icons/km/android.png", "browser/themes/shared/app-marketplace-icons/kn/android.png", "browser/themes/shared/app-marketplace-icons/ko/android.png", "browser/themes/shared/app-marketplace-icons/ko/ios.svg", "browser/themes/shared/app-marketplace-icons/lo/android.png", "browser/themes/shared/app-marketplace-icons/lt/android.png", "browser/themes/shared/app-marketplace-icons/lt/ios.svg", "browser/themes/shared/app-marketplace-icons/lv/android.png", "browser/themes/shared/app-marketplace-icons/lv/ios.svg", "browser/themes/shared/app-marketplace-icons/mk/android.png", "browser/themes/shared/app-marketplace-icons/ml/android.png", "browser/themes/shared/app-marketplace-icons/moz.build", "browser/themes/shared/app-marketplace-icons/mr/android.png", "browser/themes/shared/app-marketplace-icons/ms/android.png", "browser/themes/shared/app-marketplace-icons/ms/ios.svg", "browser/themes/shared/app-marketplace-icons/mt/ios.svg", "browser/themes/shared/app-marketplace-icons/my/android.png", "browser/themes/shared/app-marketplace-icons/nb-NO/android.png", "browser/themes/shared/app-marketplace-icons/nb-NO/ios.svg", "browser/themes/shared/app-marketplace-icons/ne-NP/android.png", "browser/themes/shared/app-marketplace-icons/nl/android.png", "browser/themes/shared/app-marketplace-icons/nl/ios.svg", "browser/themes/shared/app-marketplace-icons/nn-NO/android.png", "browser/themes/shared/app-marketplace-icons/nn-NO/ios.svg", "browser/themes/shared/app-marketplace-icons/pa-IN/android.png", "browser/themes/shared/app-marketplace-icons/pl/android.png", "browser/themes/shared/app-marketplace-icons/pl/ios.svg", "browser/themes/shared/app-marketplace-icons/pt-BR/android.png", "browser/themes/shared/app-marketplace-icons/pt-BR/ios.svg", "browser/themes/shared/app-marketplace-icons/pt-PT/android.png", "browser/themes/shared/app-marketplace-icons/pt-PT/ios.svg", "browser/themes/shared/app-marketplace-icons/ro/android.png", "browser/themes/shared/app-marketplace-icons/ro/ios.svg", "browser/themes/shared/app-marketplace-icons/ru/android.png", "browser/themes/shared/app-marketplace-icons/ru/ios.svg", "browser/themes/shared/app-marketplace-icons/si/android.png", "browser/themes/shared/app-marketplace-icons/sk/android.png", "browser/themes/shared/app-marketplace-icons/sk/ios.svg", "browser/themes/shared/app-marketplace-icons/sl/android.png", "browser/themes/shared/app-marketplace-icons/sl/ios.svg", "browser/themes/shared/app-marketplace-icons/sq/android.png", "browser/themes/shared/app-marketplace-icons/sr/android.png", "browser/themes/shared/app-marketplace-icons/sv-SE/android.png", "browser/themes/shared/app-marketplace-icons/sv-SE/ios.svg", "browser/themes/shared/app-marketplace-icons/sw/android.png", "browser/themes/shared/app-marketplace-icons/ta/android.png", "browser/themes/shared/app-marketplace-icons/te/android.png", "browser/themes/shared/app-marketplace-icons/th/android.png", "browser/themes/shared/app-marketplace-icons/th/ios.svg", "browser/themes/shared/app-marketplace-icons/tr/android.png", "browser/themes/shared/app-marketplace-icons/tr/ios.svg", "browser/themes/shared/app-marketplace-icons/uk/android.png", "browser/themes/shared/app-marketplace-icons/ur/android.png", "browser/themes/shared/app-marketplace-icons/uz/android.png", "browser/themes/shared/app-marketplace-icons/vi/android.png", "browser/themes/shared/app-marketplace-icons/vi/ios.svg", "browser/themes/shared/app-marketplace-icons/zh-CN/android.png", "browser/themes/shared/app-marketplace-icons/zh-CN/ios.svg", "browser/themes/shared/app-marketplace-icons/zh-TW/android.png", "browser/themes/shared/app-marketplace-icons/zh-TW/ios.svg", "browser/themes/shared/app-marketplace-icons/zu/android.png"], "git_node": "b8ebb64a32a9597b086167639ef1418a386582e6", "git_parents": ["8ebbc43ae4755dacab41e3eae0c6df53119f943c"], "node": "62311bb170df412da209b8a76c624ec425951523", "parents": ["77f0e80c07f93434fcd2a01fb3b183c271fc4fc3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 1 - Write install manifests through `FileAvoidWrite` r=firefox-build-system-reviewers,sergesanspaille\n\nInstall targets are phony, so the expanded track files are rewritten on every\nbuild and their timestamps move even when the files listed have not changed.\nAnything that depends on them to learn what was installed would rebuild every\ntime, and the parts after this one do exactly that.\n\nPattern expansion still runs when asked for. Only the resulting content decides\nwhether the file changes.\n\nThe rule that installs built files names its track as the target, so it now\ntouches the track after processing the manifest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323068\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozpack/manifests.py", "python/mozbuild/mozpack/test/test_manifests.py"], "git_node": "5c13ea30079044403bd7865245dbcabd435413f9", "git_parents": ["b8ebb64a32a9597b086167639ef1418a386582e6"], "node": "803782920d4e765f136fbbabfb0a6557cc8e470e", "parents": ["62311bb170df412da209b8a76c624ec425951523"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 2 - Parse a jar manifest into a model no backend owns r=firefox-build-system-reviewers,sergesanspaille\n\nA jar manifest names the same installs `moz.build` already expresses, but the\ncode that turned one into build objects was a `CommonBackend` method that only\nFasterMake called, for dist/bin, while RecursiveMake handed the manifest to\nJarMaker. Neither could share the result.\n\nThe expansion also recorded what it read by reaching into\n`backend_input_files`, so it now returns those paths alongside the objects. A\nbackend that ignores them stops regenerating when a jar manifest or one of its\nincludes changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323069\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/jar_manifest.py", "python/mozbuild/mozbuild/test/frontend/test_jar_manifest.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "3956a920a9ab8d964cca8f870052b5e91be0003f", "git_parents": ["5c13ea30079044403bd7865245dbcabd435413f9"], "node": "dcbf8beb27d57cdf6e86d533378bb5b9ef643d19", "parents": ["803782920d4e765f136fbbabfb0a6557cc8e470e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 3 - Add tests for locale staging r=firefox-build-system-reviewers,sergesanspaille\n\nNothing covered `stage_locale`, so how a locale picks a source, what `@AB_CD@`\nresolves to, and which sections reach a langpack were only described by the code\nthat did it. The parts after this commit change all three, so there needs to be a\nbaseline to compare against.\n\nThe fixture drives a real manifest through the backend rather than hand writing\none, so the tests keep working when the locale model changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323070\n", "files": ["python/mozbuild/mozbuild/test/backend/data/l10n-stage/de/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/de/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/en-US/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/en-US/extra.ftl", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/en-US/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/en-US/plain.txt", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/es-ES/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/es-ES/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/fr/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/fr/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/jar.mn", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/moz.build", "python/mozbuild/mozbuild/test/backend/test_l10n_stage.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "c41383d329e857ab17168885c3f049c8e41c6328", "git_parents": ["3956a920a9ab8d964cca8f870052b5e91be0003f"], "node": "80a3049420ce6a37ddc175f000b4a3a7e78c9334", "parents": ["dcbf8beb27d57cdf6e86d533378bb5b9ef643d19"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 4 - Read l10n manifest jar sections through `parse_jar_manifest` r=firefox-build-system-reviewers,glandium\n\nThe backend reads a jar manifest with `parse_jar_manifest`. The l10n manifest\nhad its own copy of that code, and the two copies had to agree on the defines\nand on what a section holds. The l10n manifest now calls `parse_jar_manifest`\nand stores the sections it returns, so its own `JarEntry` and `JarSection` are\nremoved. Both readers get their defines from `jar_manifest_defines`.\n\nSections no longer list the files a jar manifest includes in `pp_includes`.\nThose files are recorded on the context instead, so editing one still\nregenerates the backend.\n\nA define set to `False` used to reach the preprocessor, where `defined()` was\ntrue for it. It is now left out, as it is on a preprocessor command line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323783\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/jar_manifest.py", "python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/test/action/test_l10n_stage.py", "python/mozbuild/mozbuild/test/frontend/test_jar_manifest.py", "python/mozbuild/mozbuild/test/frontend/test_l10n_manifest.py"], "git_node": "8b5b4b7847f11667fe69a499804077f061009873", "git_parents": ["c41383d329e857ab17168885c3f049c8e41c6328"], "node": "6a11a76303413b8af3fe67aad3f1a49efce26583", "parents": ["80a3049420ce6a37ddc175f000b4a3a7e78c9334"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 5 - Stage toolkit's localized Fluent files in Android repacks from toolkit's jar manifest r=firefox-build-system-reviewers,glandium\n\n`MOZ_L10N_CHROME_ROOTS` kept every jar section of `toolkit/locales` out of\nAndroid repacks, so `mobile/android/locales/jar.mn` listed toolkit's Fluent\nfiles a second time behind `#if AB_CD != EN_US`. The l10n manifest reads jar\nmanifests with a placeholder locale, so that condition was always true and\nen-US builds installed those files twice. A context outside the roots now\ncontributes the localized entries of its `[localization]` sections, and the\nrepeated list is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323784\n", "files": ["mobile/android/locales/jar.mn", "python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/chrome/locales/en-US/chrome/chrome.ftl", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/chrome/locales/en-US/preview.ftl", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/chrome/locales/jar.mn", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/en-US/extra.ftl", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/jar.mn", "python/mozbuild/mozbuild/test/backend/test_l10n_manifest.py", "python/mozbuild/mozbuild/test/backend/test_l10n_stage.py", "python/mozbuild/mozbuild/test/frontend/test_l10n_manifest.py"], "git_node": "824910b8a8de4a4a62f9a50b3490cdfaa6485cd9", "git_parents": ["8b5b4b7847f11667fe69a499804077f061009873"], "node": "17c7bb2627aca258de69486f0b9211dcbf41a8db", "parents": ["6a11a76303413b8af3fe67aad3f1a49efce26583"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 6 - Keep the `@AB_CD@` placeholder in jar manifest paths r=firefox-build-system-reviewers,sylvestre\n\nThe l10n manifest and the backend parsed the same jar manifest with different\nvalues for `AB_CD`. The l10n manifest used `MOZ_L10N_AB_CD_PLACEHOLDER`, and the\nbackend used the configured locale. `parse_jar_manifest` now leaves `@AB_CD@` in\nsection names, paths and chrome manifest lines, and each reader replaces it\nwith its own locale. `l10n-manifest.json` carries `@AB_CD@` instead of\n`MOZ_L10N_AB_CD_PLACEHOLDER`.\n\n`base` and `relativesrcdir` are used without that replacement, so `@AB_CD@` in\neither is an error.\n\nA preprocessor condition on `AB_CD` is an error too. A jar manifest is parsed\nonce and the result serves every locale, including the ones a repack stages\nafter the backend wrote `l10n-manifest.json`. A condition would be evaluated\nonce, against the placeholder, and pick the same branch for all of them.\n\nA jar manifest without `#filter substitution` now gets `@AB_CD@` resolved\ntoo, where the backend kept it as literal text. Every jar manifest in\nmozilla-central and comm-central that names `@AB_CD@` uses the filter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323785\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/jar_manifest.py", "python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/jar.py", "python/mozbuild/mozbuild/test/action/test_l10n_stage.py", "python/mozbuild/mozbuild/test/frontend/test_jar_manifest.py", "python/mozbuild/mozbuild/test/frontend/test_l10n_manifest.py"], "git_node": "c703292cf61d6a1962ee736432fb821f7c6797b4", "git_parents": ["824910b8a8de4a4a62f9a50b3490cdfaa6485cd9"], "node": "123865c2cf6caf267a1e23fe916cb1a8bd6ba7dc", "parents": ["17c7bb2627aca258de69486f0b9211dcbf41a8db"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 7 - Remove `LOCALE_PP_DEFINES` r=firefox-build-system-reviewers,geckoview-reviewers,desktop-theme-reviewers,tgiles,sergesanspaille,owlish,sylvestre\n\nThe mobile app store badges removed in bug 2086965 were its only user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323071\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/test/action/test_l10n_stage.py", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest/moz.build", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/de/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/de/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/en-US/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/en-US/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/es-ES/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/es-ES/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/fr/android.png", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/fr/ios.svg", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/jar.mn", "python/mozbuild/mozbuild/test/backend/data/l10n-stage/moz.build", "python/mozbuild/mozbuild/test/backend/test_l10n_manifest.py", "python/mozbuild/mozbuild/test/backend/test_l10n_stage.py", "python/mozbuild/mozbuild/test/frontend/data/locale-pp-defines/moz.build", "python/mozbuild/mozbuild/test/frontend/test_l10n_manifest.py", "python/mozbuild/mozbuild/test/frontend/test_reader.py"], "git_node": "dac94a6f40b43cb326bba43d6a9f14a9e27d8f30", "git_parents": ["c703292cf61d6a1962ee736432fb821f7c6797b4"], "node": "58554a6ff137d24cddf3a094f3287f65ade7dbba", "parents": ["123865c2cf6caf267a1e23fe916cb1a8bd6ba7dc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 8 - Install preprocessed files through install manifests r=firefox-build-system-reviewers,sylvestre\n\nA preprocessed install had its own make rule, so its destination was missing\nfrom the install track, the list of files an install wrote. It now goes through\nthe install manifest like any other file.\n\nEach entry records the defines it is preprocessed with, which are the\nconfigured defines and the declaring `moz.build` `DEFINES`. The install no\nlonger preprocesses every file on every run, and a changed define rebuilds the\nfiles it applies to. Both backends now define `AB_CD` as the configured locale,\nwhere FasterMake used en-US. `XPI_NAME` is no longer defined, and no\npreprocessed source read it.\n\nThe install manifests are processed from the top level Makefile before the\nexport tier. A file a preprocessed install reads becomes a prerequisite of that\ninstall, so it must be a source file or a generated file with a rule in the top\nlevel Makefile, not a file some directory builds later. The backend rejects any\nother objdir dependency, so the error points at the declaration instead of a\nmissing make target.\n\n`OBJDIR_PP_FILES` keeps its rule, because the root of the object directory has\nno install manifest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323786\n", "files": ["config/faster/rules.mk", "python/mozbuild/mozbuild/action/process_install_manifest.py", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/backend/fastermake.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/faster_daemon.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/pp-defines/moz.build", "python/mozbuild/mozbuild/test/backend/data/pp-defines/script.js", "python/mozbuild/mozbuild/test/backend/data/pp-defines/sheet.css", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-other-directory/consumer/main.js", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-other-directory/consumer/moz.build", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-other-directory/moz.build", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-other-directory/producer/generate-header.py", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-other-directory/producer/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozpack/manifests.py"], "git_node": "47fd8eb952b2e1b9bd9cf6e356cb0ac34649ee1c", "git_parents": ["dac94a6f40b43cb326bba43d6a9f14a9e27d8f30"], "node": "5ad475e27d5c0c83f2c015288003ebf488d394a5", "parents": ["58554a6ff137d24cddf3a094f3287f65ade7dbba"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 9 - Install localized files through install manifests r=firefox-build-system-reviewers,sergesanspaille\n\nA localized install had its own make rule, so its destination never reached the\ninstall track. It always reads the source locale, en-US, whatever locale the\nbuild is configured for, since any other locale is staged from the merge tree.\nLocalized generated files move to the top level backend file so the install can\ndepend on them, and their localized inputs are named relative to the declaring\ndirectory.\n\n`l10n_stage` removes a staged file before writing it, because the build may now\ninstall that path as a link to a source file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323072\n", "files": ["config/config.mk", "python/mozbuild/mozbuild/action/l10n_stage.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/action/test_l10n_stage.py", "python/mozbuild/mozbuild/test/backend/data/localized-generated-root/moz.build", "python/mozbuild/mozbuild/test/backend/data/localized-generated-root/sub/en-US/input.txt", "python/mozbuild/mozbuild/test/backend/data/localized-generated-root/sub/make-it.py", "python/mozbuild/mozbuild/test/backend/data/localized-generated-root/sub/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "298db03a31384f7e9d4d9ac85627370748dae1ee", "git_parents": ["47fd8eb952b2e1b9bd9cf6e356cb0ac34649ee1c"], "node": "a1159a00eea33b0d82746cd8b64c85ae33f4001b", "parents": ["5ad475e27d5c0c83f2c015288003ebf488d394a5"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 10 - Root a wildcard install at its first wildcard component r=firefox-build-system-reviewers,sylvestre\n\nRecursiveMake rejected a wildcard in a directory component of a localized,\nabsolute or topsrcdir rooted source, such as `toolkit (%toolkit/**/*.ftl)` in\n`toolkit/locales/jar.mn`, which RecursiveMake handles once jar manifests are\nexpanded in the emitter. FasterMake accepted one, but for\n`assets/*/config.json` it searched `assets/config.json/` and installed nothing.\nBoth backends now search from the components before the first wildcard, and\neach match keeps its path below that point.\n\nWhen the destination's basename differs from the pattern's, the matches go in a\ndirectory with that name, so `toolkit/about (%toolkit/about/*About.ftl)`\ninstalls into `toolkit/about/`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323787\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/backend/fastermake.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/data/final-target-files-directory-wildcard/assets/a/config.json", "python/mozbuild/mozbuild/test/backend/data/final-target-files-directory-wildcard/assets/a/x.js", "python/mozbuild/mozbuild/test/backend/data/final-target-files-directory-wildcard/assets/b/config.json", "python/mozbuild/mozbuild/test/backend/data/final-target-files-directory-wildcard/assets/b/y.js", "python/mozbuild/mozbuild/test/backend/data/final-target-files-directory-wildcard/moz.build", "python/mozbuild/mozbuild/test/backend/data/final-target-files-renamed-wildcard/icons/a.svg", "python/mozbuild/mozbuild/test/backend/data/final-target-files-renamed-wildcard/icons/b.svg", "python/mozbuild/mozbuild/test/backend/data/final-target-files-renamed-wildcard/moz.build", "python/mozbuild/mozbuild/test/backend/data/jar-manifest-renamed-wildcard/icons/a.svg", "python/mozbuild/mozbuild/test/backend/data/jar-manifest-renamed-wildcard/icons/b.svg", "python/mozbuild/mozbuild/test/backend/data/jar-manifest-renamed-wildcard/jar.mn", "python/mozbuild/mozbuild/test/backend/data/jar-manifest-renamed-wildcard/moz.build", "python/mozbuild/mozbuild/test/backend/test_fastermake.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "bd5f65770cd4f936bdecb32c8c4f0f35529d6523", "git_parents": ["298db03a31384f7e9d4d9ac85627370748dae1ee"], "node": "2a2b3caf7050c9017cb0f4396331eaf02e55b178", "parents": ["a1159a00eea33b0d82746cd8b64c85ae33f4001b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 11 - Expand every jar manifest in the emitter r=firefox-build-system-reviewers,sergesanspaille\n\nA jar manifest names installs `moz.build` already expresses, so no backend needs\nto know one was involved. The paths it read are added to the context before the\ndirectory traversal object is built, because a context derived object copies\nthem when constructed and every backend reads that object. A pattern source is\nrooted at the directory holding the manifest. A preprocessed entry reads what\nthe directory's `PP_FILES_EXTRA_DEPS` names, like a preprocessed install\ndeclared in `moz.build`.\n\nA chrome manifest is installed as content built from its registrations, so a\nremoved registration leaves no line behind. `./mach package-multi-locale` adds\nlocale registrations to these manifests in `dist/bin`, so a later build drops\nthem again, and the command now warns about that. Staging areas that asked for\n`USE_EXTENSION_MANIFEST` get a `chrome/\u003cjar\u003e.manifest` and a `manifest` line in\n`chrome.manifest` like every other install target. No staging area in the tree\nregisters chrome today, so nothing exercises that path. A `resource` entry has\nno path, so the action label no longer includes one.\n\nA renamed entry may name a generated source. `RenamedSourcePath` rejected one\nand has no other user, so it is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323073\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/backend/fastermake.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/codecoverage/chrome_map.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/test/backend/data/chrome-manifest-resource/jar.mn", "python/mozbuild/mozbuild/test/backend/data/chrome-manifest-resource/moz.build", "python/mozbuild/mozbuild/test/backend/data/chrome-manifest-resource/thing.txt", "python/mozbuild/mozbuild/test/backend/data/jar-manifests-generated-pp/jar.mn", "python/mozbuild/mozbuild/test/backend/data/jar-manifests-generated-pp/make-it.py", "python/mozbuild/mozbuild/test/backend/data/jar-manifests-generated-pp/moz.build", "python/mozbuild/mozbuild/test/backend/data/jar-manifests-non-application/jar.mn", "python/mozbuild/mozbuild/test/backend/data/jar-manifests-non-application/moz.build", "python/mozbuild/mozbuild/test/backend/data/jar-manifests-non-application/thing.js", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-empty/jar.mn", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-empty/moz.build", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-non-application/jar.mn", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-non-application/moz.build", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-non-application/thing.js", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-pp-extra-deps/built.js", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-pp-extra-deps/jar.mn", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-pp-extra-deps/moz.build", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-subdirectory/moz.build", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-subdirectory/sub/assets/a.js", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests-subdirectory/sub/jar.mn", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests/jar.mn", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests/thing.js", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "toolkit/content/moz.build"], "git_node": "2b459342944fe3d62961cc2af2b59e23c9f9b89f", "git_parents": ["bd5f65770cd4f936bdecb32c8c4f0f35529d6523"], "node": "8c87d9d59d6dd88f55bbaeb7df473f6df3ffb9a1", "parents": ["2a2b3caf7050c9017cb0f4396331eaf02e55b178"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 12 - Add the `xpi_archive` action r=firefox-build-system-reviewers,sergesanspaille\n\nAn archive built from whatever the staging area holds keeps files that stopped\nbeing installed and ships a test extension's `moz.build`. The action reads only\nthe files the track lists, and fails when the track lists nothing or a listed\nfile is missing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323075\n", "files": ["python/mozbuild/mozbuild/action/xpi_archive.py", "python/mozbuild/mozbuild/test/action/test_xpi_archive.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "5343e43438a4825f9047eb0497c3f4805512dc45", "git_parents": ["2b459342944fe3d62961cc2af2b59e23c9f9b89f"], "node": "1b0b557110c281d0ca04e6c7aa75ccedeea32709", "parents": ["8c87d9d59d6dd88f55bbaeb7df473f6df3ffb9a1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 13 - Copy built files into an extension staging area from the top level Makefile r=firefox-build-system-reviewers,sylvestre\n\nTo build an extension archive from the top level Makefile, every file the\narchive packages needs a rule in the top level Makefile, which cannot depend on\na rule in the directory that generated a file. A built file listed in\n`FINAL_TARGET_FILES` for a staging area under `dist/xpi-stage` is therefore\ncopied by a rule in the top level Makefile.\n\nThat copy can only read a generated file whose rule is in the top level backend\nfile, so the backend rejects any other source rather than leaving the copy\nwithout a rule. A renamed built file is now listed in the install manifest like\nany other, so the install track includes it.\n\nThe copies run in every build, because a staging area does not need an archive.\nThe copy rule touches its install track afterwards, because the track is the\nrule's target and processing an unchanged manifest leaves it untouched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323788\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-generated/extension/make-it.py", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-generated/extension/manifest.json", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-generated/extension/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-generated/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-compile-output/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-compile-output/staged/make-it.py", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-compile-output/staged/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-no-archive/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-no-archive/staged/make-it.py", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-no-archive/staged/moz.build", "python/mozbuild/mozbuild/test/backend/test_xpi_archive.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "286447d12c3684ae6fccaa904d14f112a069e70a", "git_parents": ["5343e43438a4825f9047eb0497c3f4805512dc45"], "node": "671229c5082c0665cfb028a30185c7d9913f8083", "parents": ["1b0b557110c281d0ca04e6c7aa75ccedeea32709"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 14 - Declare extension archives as build edges r=firefox-build-system-reviewers,chutten,sergesanspaille\n\nThe file list comes from the install track, so an archive describes the\ndeclared installs rather than whatever the staging area holds, and is rebuilt\nwhen that install or one of its members changes. The track has a rule of its\nown, so the archive can depend on it before the install has run. That rule has\nan empty recipe, so make reads the track's timestamp again after the install\nand rebuilds the archive in the same build.\n\n`XPI_PKGNAME` now needs `XPI_NAME`, because an archive packages what was\ninstalled into its staging area. The telemetry test archives therefore name a\nstaging area and list their files in `FINAL_TARGET_FILES`. Nothing zips a\ndirectory by wildcard any more, so those archives no longer carry the\n`moz.build` that sat next to their sources.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323076\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-same-name/beside/manifest.json", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-same-name/beside/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-same-name/flat_name/manifest.json", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-same-name/flat_name/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-same-name/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-same-name/tested/manifest.json", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-same-name/tested/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-testdir/manifest.json", "python/mozbuild/mozbuild/test/backend/data/xpi-archive-testdir/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-archive/generated.js", "python/mozbuild/mozbuild/test/backend/data/xpi-archive/manifest.json", "python/mozbuild/mozbuild/test/backend/data/xpi-archive/moz.build", "python/mozbuild/mozbuild/test/backend/test_xpi_archive.py", "python/mozbuild/mozbuild/test/frontend/data/xpi-pkgname-without-xpi-name/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "toolkit/components/telemetry/tests/addons/long-fields/moz.build", "toolkit/components/telemetry/tests/addons/restartless/moz.build", "toolkit/components/telemetry/tests/addons/system/moz.build"], "git_node": "2b492f3cac2ee10ae459df2aa5b0fe981d74ccaf", "git_parents": ["286447d12c3684ae6fccaa904d14f112a069e70a"], "node": "3293af95ded6559faa460e07513d7f65dc80bc01", "parents": ["671229c5082c0665cfb028a30185c7d9913f8083"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068768 - Part 15 - Remove the legacy JarMaker implementation r=firefox-build-system-reviewers,extension-reviewers,layout-reviewers,rpl,sergesanspaille\n\nNothing emits a jar manifest object or runs the JarMaker writer any more. The\nwriter, the make rules that invoked it, its zip helper and the configure\nsetting that chose its output format are dead code.\n\nEvery build now installs `jar.mn` content as loose files. The standalone\n`browser/extensions` project was the only one whose `moz.configure` set\n`MOZ_JAR_MAKER_FILE_FORMAT` to `jar`, so each of its sections was zipped into a\n`.jar` archive and registered with `jar:` URLs. Its chrome manifest now points\nat directories like every other build.\n\n`config/tests/src-simple` exercised the jar format, preprocessing, locale\nsubstitution and source tree references. The jar format is gone, and the rest\nis covered where the manifest is read. The parser stays, because the model is\nbuilt on it.\n\nThe l10n driver was the last caller to run make with `XPI_NAME=` on the\ncommand line, so the backend writes `FINAL_TARGET` as the resolved path and no\nMakefile may set `XPI_NAME` any more.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323077\n", "files": ["browser/extensions/moz.configure", "browser/extensions/newtab/addon-jar.mn", "browser/tools/mozscreenshots/mozscreenshots/extension/moz.build", "build/docs/jar-manifests.md", "config/Makefile.in", "config/MozZipFile.py", "config/config.mk", "config/moz.build", "config/rules.mk", "config/tests/chrome.manifest.flat", "config/tests/ref-simple/one/file.xml", "config/tests/ref-simple/one/preproc", "config/tests/ref-simple/one/some.css", "config/tests/ref-simple/three/l10nfile.txt", "config/tests/ref-simple/two/otherfile.xml", "config/tests/src-simple/Makefile.in", "config/tests/src-simple/jar.mn", "config/tests/src-simple/l10n/l10nfile.txt", "config/tests/src-simple/moz.build", "config/tests/src-simple/thesrcdir/file.xml", "config/tests/src-simple/thesrcdir/preproc.in", "config/tests/src-simple/thesrcdir/some.css", "config/tests/src-simple/thetopsrcdir/otherfile.xml", "config/tests/test.manifest.flat", "config/tests/test.manifest.jar", "config/tests/test.manifest.symlink", "config/tests/unitMozZipFile.py", "layout/tools/reftest/moz.build", "pyproject.toml", "python/mozbuild/mozbuild/action/buildlist.py", "python/mozbuild/mozbuild/action/jar_maker.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/jar.py", "python/mozbuild/mozbuild/preprocessor.py", "python/mozbuild/mozbuild/test/action/test_buildlist.py", "python/mozbuild/mozbuild/test/backend/data/jar-manifests/jar.mn", "python/mozbuild/mozbuild/test/backend/data/jar-manifests/moz.build", "python/mozbuild/mozbuild/test/backend/test_build.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/controller/test_build_output.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_jarmaker.py", "testing/mochitest/moz.build", "testing/specialpowers/moz.build", "toolkit/moz.configure"], "git_node": "4d3d3e407d3dd30a792ef0483fdd2130e8bccf9b", "git_parents": ["2b492f3cac2ee10ae459df2aa5b0fe981d74ccaf"], "node": "34ca00c3e1c5daeb56c104822b53640d55238b19", "parents": ["3293af95ded6559faa460e07513d7f65dc80bc01"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2046372 - Missed when making the annotations tier2-only.\n", "files": ["testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-double.html.ini"], "git_node": "59a643159a0038a83797db4a3b400ac263d5aa48", "git_parents": ["4d3d3e407d3dd30a792ef0483fdd2130e8bccf9b"], "node": "e17e6647501ddc04bd186e0cbf1a91bdb6aff797", "parents": ["34ca00c3e1c5daeb56c104822b53640d55238b19"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/browser/menu/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/browser/menu2/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-in/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-am/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/va