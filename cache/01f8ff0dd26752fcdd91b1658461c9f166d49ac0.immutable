browser/components/aiwindow/ui/components/aitab-page/aitab-error/aitab-error.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-error/aitab-error.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "5b2fc4f2c655fcdab5af9b6323169e002c712d8a", "git_parents": ["ad04bdb66f88b02a849f2132964e8645e6805a54"], "node": "975d904e7f75a5eaf5bbfc1515bcfe56b527460b", "parents": ["8cd99e38018b5cce9f35165cafe9203a672cd110"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Add pending extension updates to BrowserState r=android-reviewers,marcin\n\nExtension updates that need new permissions will wait for the user instead of\nbeing denied behind a system notification. This adds the state for them,\nwhich will be populated later in this patch stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334270\n", "files": ["mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/action/BrowserAction.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/WebExtensionReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/selector/Selectors.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/BrowserState.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/extension/PendingExtensionUpdate.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/action/WebExtensionActionTest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/selector/SelectorsKtTest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/state/extension/PendingExtensionUpdateTest.kt", "mobile/android/android-components/components/support/webextensions/src/main/java/mozilla/components/support/webextensions/WebExtensionSupport.kt", "mobile/android/android-components/components/support/webextensions/src/test/java/mozilla/components/support/webextensions/WebExtensionSupportTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "3bfd67b34ebad584c54a98239f1e69342b0c168a", "git_parents": ["5b2fc4f2c655fcdab5af9b6323169e002c712d8a"], "node": "7f4b915cf831a0b2de13c0411bcef3f798146044", "parents": ["975d904e7f75a5eaf5bbfc1515bcfe56b527460b"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Look up extension permission prompt requests by ID r=android-reviewers,marcin\n\nThis enables a recreated prompt to identify the correct (original)\nrequest instead of whatever the current request is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334271\n", "files": ["mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/extension/WebExtensionPromptRequest.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/PermissionsDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/extension/WebExtensionPromptFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/extension/WebExtensionPromptFeatureTest.kt"], "git_node": "4e360a1c1632a6a660b4f5c01e2d1687e244319f", "git_parents": ["3bfd67b34ebad584c54a98239f1e69342b0c168a"], "node": "c623085956cf3b445c7c0866742bfecd2bbb7865", "parents": ["7f4b915cf831a0b2de13c0411bcef3f798146044"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Add an update mode to PermissionsDialogFragment r=android-reviewers,android-l10n-reviewers,parker,marcin\n\nReplace the forOptionalPermissions flag with PermissionsDialogMode and\nexpand its functionality to not only support install dialogs and\noptional permissions, but also extension updates with new permissions.\n\nThis will be documented in the changelog later, when it is integrated in\nthe app in the \"Replace notification-based permission prompt\" part of\nthis patch stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334272\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/PermissionsDialogFragment.kt", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_fragment_dialog_addon_permissions.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/ui/PermissionsDialogFragmentTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/extension/WebExtensionPromptFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/extension/WebExtensionPromptFeatureTest.kt"], "git_node": "2cc8bc2d1c526f6a55298de5b8706e04cd7e59c1", "git_parents": ["4e360a1c1632a6a660b4f5c01e2d1687e244319f"], "node": "f40add69b2ab7bd8b43a13e76733e052339053d3", "parents": ["c623085956cf3b445c7c0866742bfecd2bbb7865"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Show extension updates waiting for review on the extension screens r=android-reviewers,android-l10n-reviewers,parker,android-build-system-reviewers,RyanVM,marcin\n\nAdds a banner when an extension update requires new permissions, to the\nExtensions list, an extension's details and its \"Permissions and data\"\nscreen. The banner disappears when the user presses x or after an app\nrestart, and can return at the next add-on update check.\n\nThe \"Review changes\" button in the banner opens the update prompt that\nwas implemented in the previous commit.\n\nThese banners are not visible in the app yet because nothing populates\nthe set of pending updates. That will be done later in the patch stack,\nwith \"Replace notification-based permission prompt\". That will also\nadd the changelog entry for this API change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334273\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/action/BrowserAction.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/WebExtensionReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/BrowserState.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/action/WebExtensionActionTest.kt", "mobile/android/android-components/components/feature/addons/build.gradle", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/AddonsManagerAdapter.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/AddonsManagerAdapterDelegate.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/CustomViewHolder.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/PendingExtensionUpdateBanner.kt", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_message_bars.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/ui/AddonsManagerAdapterTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonPermissionsDetailsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonsManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonsManagementView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionUpdatePrompt.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ui/AddonPermissionsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/extension/WebExtensionPromptFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/AddonsManagementViewTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/ExtensionUpdatePromptTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/extension/WebExtensionPromptFeatureTest.kt"], "git_node": "d5c9a5152ca30f570ce3eb1b7a77c8f6ec341291", "git_parents": ["2cc8bc2d1c526f6a55298de5b8706e04cd7e59c1"], "node": "954bd1d39cf72d72a49bad7cf577b58a55aad622", "parents": ["f40add69b2ab7bd8b43a13e76733e052339053d3"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Mention extension updates waiting for review in the app menu r=android-reviewers,android-l10n-reviewers,parker,petru\n\nAdds red \"Review update for [extension names]\" to the main Extensions\nmenu item in the app menu (current one and upcoming customizable menu),\nand \"Review settings to update\" to individual extension menu items\n(i.e. for enabled extensions with a browser action / page action).\n\nThis only adds an extra description without changing the behavior of the\nmenu items.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334274\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/ExtensionsMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MainMenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MenuItem.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/ExtensionsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuDialogFragmentTest.kt"], "git_node": "16dde4dc12c3393cdc9bf0d60656c78bde283621", "git_parents": ["d5c9a5152ca30f570ce3eb1b7a77c8f6ec341291"], "node": "85d81adaf29b67ac24d152f6be42fb3ecd68d9a3", "parents": ["954bd1d39cf72d72a49bad7cf577b58a55aad622"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Show a dot on the menu button while an extension update waits for review r=android-reviewers,marcin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334275\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bindings/PendingExtensionUpdateBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/SupportedMenuNotifications.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bindings/PendingExtensionUpdateBindingTest.kt"], "git_node": "517f9708b42563649b3f65f534d3ea71bf661458", "git_parents": ["16dde4dc12c3393cdc9bf0d60656c78bde283621"], "node": "a7d22057c4aa63b8c2cec3230433f6819d5f7fc6", "parents": ["85d81adaf29b67ac24d152f6be42fb3ecd68d9a3"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Replace notification-based permission prompt with new in-app UI r=android-reviewers,marcin\n\nDefaultAddonUpdater used to deny an update that needs new permissions and post\na system notification; accepting it ran a new update check. Now it leaves the\nrequest unanswered and records it in BrowserState.pendingExtensionUpdates,\nwhere the screens from the previous commits show it. Accepting installs the\nversion that was already downloaded.\n\nThis adds the feature-addons changelog entry, which also covers the earlier\ncommits of this series.\n\nsamples-browser gets a minimal prompt, because AddonsManagerAdapter shows these\nupdates there too.\n\nThe notification code is now unused; the next commit will remove it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334276\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/AddonManager.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/update/AddonUpdater.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/AddonUpdaterWorkerTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/DefaultAddonUpdaterTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/DefaultComponents.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/addons/AddonsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt"], "git_node": "0f8862b85efbbb9d50ade628421c9ff1036a41c8", "git_parents": ["517f9708b42563649b3f65f534d3ea71bf661458"], "node": "f7b5dce476779d45a68ca4d4166eda88921ced1e", "parents": ["a7d22057c4aa63b8c2cec3230433f6819d5f7fc6"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Remove the old extension update notification r=android-reviewers,android-l10n-reviewers,parker,marcin\n\nRemove NotificationHandlerService, UpdateStatusStorage and the code that built\nthe notification, remove its strings, and drop feature-addons'\nPOST_NOTIFICATIONS permission (support-base still declares it).\n\nDefaultAddonUpdater now deletes the old notification channel and\nUpdateStatusStorage's preferences file, so upgrading users don't keep a\nchannel, or a notification, that no longer works.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334277\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/AndroidManifest.xml", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/update/AddonUpdater.kt", "mobile/android/android-components/components/feature/addons/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/DefaultAddonUpdaterTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/NotificationHandlerServiceTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/UpdateStatusStorageTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "848b255b2e9b0d839b41c138c430291cc60f7d74", "git_parents": ["0f8862b85efbbb9d50ade628421c9ff1036a41c8"], "node": "89e6a6703858c1527012e33a4cbfad9f58b234ab", "parents": ["f7b5dce476779d45a68ca4d4166eda88921ced1e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2067732 - Remove unused update-only permission strings r=android-reviewers,android-l10n-reviewers,parker,marcin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334278\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/Addon.kt", "mobile/android/android-components/components/feature/addons/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/addons/src/test/java/AddonTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "be05818bc5bcd9369068340340d2d5163c03fc23", "git_parents": ["848b255b2e9b0d839b41c138c430291cc60f7d74"], "node": "a3e5181d0bf39fb5698083616702ba9a87ce36ce", "parents": ["89e6a6703858c1527012e33a4cbfad9f58b234ab"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2086927 - Avoid ScrollRectIntoView IPC for top-level content documents r=layout-reviewers,hiro\n\nBrowserParent ignores ScrollRectIntoView when it has no browser bridge. Send the request only for out-of-process iframes, which can scroll their embedding document.\n\nSplit the PresShell change out of D336555 as requested in review so it can land independently.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337858\n", "files": ["layout/base/PresShell.cpp"], "git_node": "0a001fac52aaf69e47e1004936e6966260b41423", "git_parents": ["be05818bc5bcd9369068340340d2d5163c03fc23"], "node": "b0622c818c0fa7a6dea7d4778f719a2b7db10d96", "parents": ["a3e5181d0bf39fb5698083616702ba9a87ce36ce"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067732 - Remove unused update-only permission strings r=android-reviewers,android-l10n-reviewers,parker,marcin\" for causing failures at ExtensionsMenuItemProviderTest.\n\nThis reverts commit be05818bc5bcd9369068340340d2d5163c03fc23.\n\nRevert \"Bug 2067732 - Remove the old extension update notification r=android-reviewers,android-l10n-reviewers,parker,marcin\"\n\nThis reverts commit 848b255b2e9b0d839b41c138c430291cc60f7d74.\n\nRevert \"Bug 2067732 - Replace notification-based permission prompt with new in-app UI r=android-reviewers,marcin\"\n\nThis reverts commit 0f8862b85efbbb9d50ade628421c9ff1036a41c8.\n\nRevert \"Bug 2067732 - Show a dot on the menu button while an extension update waits for review r=android-reviewers,marcin\"\n\nThis reverts commit 517f9708b42563649b3f65f534d3ea71bf661458.\n\nRevert \"Bug 2067732 - Mention extension updates waiting for review in the app menu r=android-reviewers,android-l10n-reviewers,parker,petru\"\n\nThis reverts commit 16dde4dc12c3393cdc9bf0d60656c78bde283621.\n\nRevert \"Bug 2067732 - Show extension updates waiting for review on the extension screens r=android-reviewers,android-l10n-reviewers,parker,android-build-system-reviewers,RyanVM,marcin\"\n\nThis reverts commit d5c9a5152ca30f570ce3eb1b7a77c8f6ec341291.\n\nRevert \"Bug 2067732 - Add an update mode to PermissionsDialogFragment r=android-reviewers,android-l10n-reviewers,parker,marcin\"\n\nThis reverts commit 2cc8bc2d1c526f6a55298de5b8706e04cd7e59c1.\n\nRevert \"Bug 2067732 - Look up extension permission prompt requests by ID r=android-reviewers,marcin\"\n\nThis reverts commit 4e360a1c1632a6a660b4f5c01e2d1687e244319f.\n\nRevert \"Bug 2067732 - Add pending extension updates to BrowserState r=android-reviewers,marcin\"\n\nThis reverts commit 3bfd67b34ebad584c54a98239f1e69342b0c168a.\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/action/BrowserAction.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/WebExtensionReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/selector/Selectors.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/BrowserState.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/extension/PendingExtensionUpdate.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/extension/WebExtensionPromptRequest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/action/WebExtensionActionTest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/selector/SelectorsKtTest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/state/extension/PendingExtensionUpdateTest.kt", "mobile/android/android-components/components/feature/addons/build.gradle", "mobile/android/android-components/components/feature/addons/src/main/AndroidManifest.xml", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/Addon.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/AddonManager.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/AddonsManagerAdapter.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/AddonsManagerAdapterDelegate.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/CustomViewHolder.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/PendingExtensionUpdateBanner.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/ui/PermissionsDialogFragment.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/update/AddonUpdater.kt", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_fragment_dialog_addon_permissions.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_message_bars.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/addons/src/test/java/AddonTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/ui/AddonsManagerAdapterTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/ui/PermissionsDialogFragmentTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/AddonUpdaterWorkerTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/DefaultAddonUpdaterTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/NotificationHandlerServiceTest.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/update/UpdateStatusStorageTest.kt", "mobile/android/android-components/components/support/webextensions/src/main/java/mozilla/components/support/webextensions/WebExtensionSupport.kt", "mobile/android/android-components/components/support/webextensions/src/test/java/mozilla/components/support/webextensions/WebExtensionSupportTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/DefaultComponents.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/addons/AddonsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonPermissionsDetailsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonsManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonsManagementView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionUpdatePrompt.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ui/AddonPermissionsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bindings/PendingExtensionUpdateBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/SupportedMenuNotifications.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/ExtensionsMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MainMenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/extension/WebExtensionPromptFeature.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/AddonsManagementViewTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/ExtensionUpdatePromptTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/ExtensionsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bindings/PendingExtensionUpdateBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuDialogFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/extension/WebExtensionPromptFeatureTest.kt"], "git_node": "d6b85756630383d0ff2db89e644053cd7acc47ba", "git_parents": ["0a001fac52aaf69e47e1004936e6966260b41423"], "node": "6f8df9dde07d832a9e49eb8fd088668e88a5c653", "parents": ["b0622c818c0fa7a6dea7d4778f719a2b7db10d96"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086681 - Align the card doorhanger content with the header icon. r=desktop-theme-reviewers,hjones\n\nThe description, card details box and security code toggle on the card\ndoorhangers lined up with the header text, past the lock icon. They now line\nup with the lock icon and span the width of the panel, as in the design.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337640\n", "files": ["browser/themes/shared/formautofill-notification.css"], "git_node": "9593776fd701035aeb9891d2a8c7287f3844d590", "git_parents": ["d6b85756630383d0ff2db89e644053cd7acc47ba"], "node": "7abcd4d85722a1a21b00fc20c38b1ad20b3d6225", "parents": ["6f8df9dde07d832a9e49eb8fd088668e88a5c653"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1598175 - Prevent the overflow fade from hiding the base domain r=desktop-theme-reviewers,urlbar-reviewers,emilio,mak\n\nBug 1986161 mostly fixed this, but the base domain could still be partially\nhidden by the overflow fade, since the host was aligned exactly with the edge of\nthe input. This patch scrolls the host so that it stays clear of the fade (and\nof the scheme box for RTL domains).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336056\n", "files": ["browser/components/urlbar/UrlbarValueFormatter.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_registrableDomainInView.js", "browser/themes/shared/urlbar.css"], "git_node": "8ce2d7d3ae765479f773ba313aae94f6d770489c", "git_parents": ["9593776fd701035aeb9891d2a8c7287f3844d590"], "node": "352e7f7cbaf92615ae64699915dbc8daa3302683", "parents": ["7abcd4d85722a1a21b00fc20c38b1ad20b3d6225"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2086946 - Fix native fence FD ownership transfer when creating EGLSync on Android r=gfx-reviewers,jnicol\n\nAccording to the EGL_ANDROID_native_fence_sync specification, ownership of a native fence FD is transferred to the EGL implementation when it is passed to eglCreateSyncKHR(), regardless of whether sync creation succeeds.\n\nPreviously, Gecko released ownership of the FD only when eglCreateSyncKHR() succeeded. If sync creation failed, the FD could be closed again by Gecko, potentially resulting in a double-close.\n\nThis patch moves UniqueFileHandle::release() immediately after eglCreateSyncKHR() to ensure that Gecko relinquishes ownership of the FD regardless of the result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337868\n", "files": ["gfx/gl/GLBlitHelper.cpp", "gfx/gl/SharedSurfaceAndroidHardwareBuffer.cpp", "gfx/layers/opengl/TextureHostOGL.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.cpp"], "git_node": "cc1723545621203651cd14fba51441e08f04b864", "git_parents": ["8ce2d7d3ae765479f773ba313aae94f6d770489c"], "node": "a4799daf1e2dd9537aa1e7e1192ca0ebfdf9a5d3", "parents": ["352e7f7cbaf92615ae64699915dbc8daa3302683"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087072 - Create a new verifyThePrivacyReportItemTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337994\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsTabsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsTabsTest.kt"], "git_node": "649d32066ed002f35a6918900a135e684ce52901", "git_parents": ["cc1723545621203651cd14fba51441e08f04b864"], "node": "54f1e31ca2ff5a46649a189968bd6616e099b3bd", "parents": ["a4799daf1e2dd9537aa1e7e1192ca0ebfdf9a5d3"], "tags": []}, {"author": "Chun-Min Chang \u003ccchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050150 - Add a gtest for the NV12 destination stride contract. r=media-playback-reviewers,alwu\n\nChecks that a stride too narrow for an interleaved chroma row is declined and\nthat even widths still convert: seven odd-width cases and five even controls.\n\nBoth source formats are covered, because the RGB branch is the default for\nhardware-decoded input, and so are the same-size and rescaled paths, since\nVideoFrame::Format::IsValidSize rejects an odd-width I420 frame and only the\nrescaled path can present one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317996\n", "files": ["dom/media/gtest/TestImageConversion.cpp"], "git_node": "30b424eea8c4859889924fc4e6fe8843485a96a2", "git_parents": ["649d32066ed002f35a6918900a135e684ce52901"], "node": "fb8f1b8147855676db2d8bde664936d24f9aa20c", "parents": ["54f1e31ca2ff5a46649a189968bd6616e099b3bd"], "tags": []}, {"author": "Chun-Min Chang \u003ccchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050150 - Add a gtest for the WMF encoder module's frame-size predicate. r=media-playback-reviewers,alwu\n\nCovers the predicate directly. A test driving Supports() would return empty on\nany host without a VP8 or VP9 encoder, and so would pass without exercising it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317997\n", "files": ["dom/media/gtest/TestWMFEncoderModule.cpp", "dom/media/gtest/moz.build"], "git_node": "8d6a2d0bfa5bc4cd9c7b81e5f183f79f1c59ac74", "git_parents": ["30b424eea8c4859889924fc4e6fe8843485a96a2"], "node": "354725685d86dca849970afc9f83ff5c8e23d291", "parents": ["fb8f1b8147855676db2d8bde664936d24f9aa20c"], "tags": []}, {"author": "Chun-Min Chang \u003ccchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050150 - Add a WebCodecs test for per-codec dimension parity. r=media-playback-reviewers,alwu\n\nNeither requirement had coverage: H.264 must decline an odd dimension, since\n4:2:0 cannot express one, while VP8 and VP9 can express one and must keep\nworking.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317998\n", "files": ["dom/media/webcodecs/test/mochitest.toml", "dom/media/webcodecs/test/test_videoEncoder_oddWidth.html"], "git_node": "50b134ff4566d47f71e5babdb3895ac45a6ea075", "git_parents": ["8d6a2d0bfa5bc4cd9c7b81e5f183f79f1c59ac74"], "node": "84cc8f963100eb60fc8729cbc2104f99619b369b", "parents": ["354725685d86dca849970afc9f83ff5c8e23d291"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086605 - Create a new verifyTheOfferToTranslateWhenPossibleOptionTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337593\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/reachability/BaseReachabilityShardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/reachability/ReachabilityCase.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/reachability/ReachabilityCaseFactory.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsTranslationSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt"], "git_node": "a881440c8844c9698fea024185d650cc8ed36e59", "git_parents": ["50b134ff4566d47f71e5babdb3895ac45a6ea075"], "node": "f7f847d16486b841956809a7496aa404bca3b3b6", "parents": ["84cc8f963100eb60fc8729cbc2104f99619b369b"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064768 - updated menu icon asset r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328618\n", "files": ["mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_button.xml", "mobile/android/android-components/components/browser/menu2/src/main/res/layout/mozac_browser_menu2_button.xml", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/NavigationBar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/ActionButton.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/utils/DisplayToolbarDataProvider.kt", "mobile/android/android-components/components/feature/customtabs/src/main/java/mozilla/components/feature/customtabs/CustomTabsToolbarFeature.kt", "mobile/android/android-components/components/ui/widgets/src/main/res/layout/mozac_widget_site_item.xml", "mobile/android/android-components/samples/compose-browser/src/main/java/org/mozilla/samples/compose/browser/browser/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/TabPreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/Browser