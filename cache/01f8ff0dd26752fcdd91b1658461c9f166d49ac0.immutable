571\n", "files": ["devtools/server/connectors/worker-connector.js", "dom/ipc/ContentParent.cpp", "dom/workers/WorkerDebugger.cpp", "dom/workers/nsIWorkerDebugger.idl", "dom/workers/remoteworkers/RemoteWorkerDebuggerManagerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerDebuggerManagerParent.h", "dom/workers/remoteworkers/RemoteWorkerDebuggerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerDebuggerParent.h", "dom/workers/remoteworkers/RemoteWorkerService.cpp"], "git_node": "5ceef57bd9d93361b4098c86dc921393fab82028", "git_parents": ["f904a321300160fb6d392b410c9fd48fc2cbd8b9"], "node": "a9ef13d63ea7209e11eb73d7aa4a39051d76a69a", "parents": ["86ec2d2e08d179a4c315501d3d3eb2e23fd151ce"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075976 - Only accept one RespondWith per fetch event op in the parent process. r=dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333191\n", "files": ["dom/serviceworkers/FetchEventOpChild.cpp", "dom/serviceworkers/FetchEventOpProxyParent.cpp", "dom/serviceworkers/FetchEventOpProxyParent.h"], "git_node": "9afa7b4489bc241567eb7318bc29d6077a3f3059", "git_parents": ["5ceef57bd9d93361b4098c86dc921393fab82028"], "node": "f01e7d45c546132baddabda75c9151f6ce4fc75b", "parents": ["a9ef13d63ea7209e11eb73d7aa4a39051d76a69a"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080733 - use mach's python when installing moz-phab. r=sheehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332811\n", "files": ["tools/phabricator/mach_commands.py"], "git_node": "aeb550a276d64147a58d5a61cc3b99a1ef25f78e", "git_parents": ["9afa7b4489bc241567eb7318bc29d6077a3f3059"], "node": "96bfc0f75e69af5e617a35cc472daa863ac80b56", "parents": ["f01e7d45c546132baddabda75c9151f6ce4fc75b"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2086127 - Use stack/malloc scratch space for BigInt division r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337150\n", "files": ["js/src/vm/BigIntType.cpp"], "git_node": "5ced46333d6ee576f59c6dbf9990aa98d9375e6f", "git_parents": ["aeb550a276d64147a58d5a61cc3b99a1ef25f78e"], "node": "268847a1308d39441fefff0ac8c3c6787265d39b", "parents": ["96bfc0f75e69af5e617a35cc472daa863ac80b56"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2086142 - Use double-word arithmetic in BigInt multiply-accumulate r=mgaudet\n\nManages to lower instruction count by 1-5% on the bigint-noble\nbenchmarks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337157\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "6c12448cb52fbbe00abfdd7b4c625056a2974642", "git_parents": ["5ced46333d6ee576f59c6dbf9990aa98d9375e6f"], "node": "135866b2448fa8c0bac6a6d8e6454317f8e088f9", "parents": ["268847a1308d39441fefff0ac8c3c6787265d39b"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086469 - Re-enable BOLT for taskcluster-built clang binaries r=glandium\n\nDisable use-gnu-stack which made the library not dlopen-able.\n\nThe same patch has been applied by https://github.com/astral-sh/python-build-standalone\nand they now just pass fine-grain options to BOLT, while still not using\nthat flag. Given their audience, it's probably a good sign that it's now\ncompatible with dlopen.\n\nConcerning performance, I've run the following micro-benchmark:\n\n    $ hyperfine -r30 --parameter-list clang $PWD/bin/clang,/home/ssp/.mozbuild/clang/bin/clang '{clang} -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w'\n    Benchmark 1: /tmp/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w\n      Time (mean \u00b1 \u03c3):     11.371 s \u00b1  0.066 s    [User: 11.238 s, System: 0.063 s]\n      Range (min \u2026 max):   11.115 s \u2026 11.425 s    30 runs\n\n    Benchmark 2: /home/ssp/.mozbuild/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w\n      Time (mean \u00b1 \u03c3):     12.192 s \u00b1  0.082 s    [User: 12.049 s, System: 0.067 s]\n      Range (min \u2026 max):   11.925 s \u2026 12.283 s    30 runs\n\n    Summary\n      /tmp/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w ran\n        1.07 \u00b1 0.01 times faster than /home/ssp/.mozbuild/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337101\n", "files": ["build/build-clang/bolt-no-use-gnu-stack.patch", "build/build-clang/clang-22.json", "build/build-clang/clang-23.json", "build/build-clang/clang-trunk.json", "taskcluster/kinds/toolchain/clang.yml"], "git_node": "70a7586b34a4dea2afba181eca5a40badd6008f7", "git_parents": ["6c12448cb52fbbe00abfdd7b4c625056a2974642"], "node": "8d2bb0af976856c752bff24c560fc5e1484ca4bf", "parents": ["135866b2448fa8c0bac6a6d8e6454317f8e088f9"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073135 - Clear all aspects of depth-stencil attachments when resolving WebGL2 framebuffer data. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333256\n", "files": ["dom/canvas/WebGLFramebuffer.cpp", "dom/canvas/WebGLFramebuffer.h"], "git_node": "6cdf09c22bf6be9c54e1e3ef5f49691afb88624e", "git_parents": ["70a7586b34a4dea2afba181eca5a40badd6008f7"], "node": "c762710329b1dcf513a090a642fee883af209c27", "parents": ["8d2bb0af976856c752bff24c560fc5e1484ca4bf"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083720 - Update the symbol scrapers to pick up several fixes and improvements r=schopin\n\n- Scrape the libsecret packages from all distributions\n- Add missing libxcb crates from some distributions\n- Fix finding Ubuntu debuginfo packages\n- Speed up scraping packages for closed-source libraries by not\n  attempting to locate the corresponding debug information\n- Scrape some of Ubuntu's Firefox pre-release and daily Firefox and\n  Thunderbird builds\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337155\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "a9f0ac085a54cad167836cbe7fb013d2ad5b1cff", "git_parents": ["6cdf09c22bf6be9c54e1e3ef5f49691afb88624e"], "node": "f99a5eb1537314b4e42799d3399c1d827734889f", "parents": ["c762710329b1dcf513a090a642fee883af209c27"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Monitor resource usage in decision tasks. r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330475\n", "files": [".taskcluster.yml"], "git_node": "ea5909dd48bc5c0f71a2e73d4998ce5900fa6be5", "git_parents": ["a9f0ac085a54cad167836cbe7fb013d2ad5b1cff"], "node": "115e2811594437eb266653ad724a9d604503e72a", "parents": ["f99a5eb1537314b4e42799d3399c1d827734889f"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Record decision task phases in its resource usage profile. r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330476\n", "files": ["taskcluster/mach_commands.py"], "git_node": "21c2e5cac3023be3ada631609b7eda046f07b0ca", "git_parents": ["ea5909dd48bc5c0f71a2e73d4998ce5900fa6be5"], "node": "4f9a5f3d022b7984f8fa96c2bf893014030ac3a2", "parents": ["115e2811594437eb266653ad724a9d604503e72a"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Name run-task resource usage profiles after their task. r=releng-reviewers,taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330477\n", "files": [".taskcluster.yml", "taskcluster/gecko_taskgraph/test/test_transforms_job.py", "taskcluster/gecko_taskgraph/transforms/job/run_task.py", "taskcluster/scripts/run_task_resource_monitor.py"], "git_node": "6e78511dbd0e9e46bd2cdec0176c1339c188215e", "git_parents": ["21c2e5cac3023be3ada631609b7eda046f07b0ca"], "node": "4d970ce859bdc3f285861156ad9eed819497d43d", "parents": ["4f9a5f3d022b7984f8fa96c2bf893014030ac3a2"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Start the mozharness resource monitor before the first action when forwarding to a parent monitor. r=releng-reviewers,ahal\n\nForwarding doesn't need psutil, so the actions up to create-virtualenv are no\nlonger missing from the profile and the Perfherder data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332075\n", "files": ["testing/mozharness/mozharness/base/python.py"], "git_node": "a4655b6cd7e061b0f9f039440ddb7c4cf4791252", "git_parents": ["6e78511dbd0e9e46bd2cdec0176c1339c188215e"], "node": "fdf1208da7f67a60fd25bce92dce9c9cd86c8ae1", "parents": ["4d970ce859bdc3f285861156ad9eed819497d43d"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Monitor resource usage in run-task-git tasks. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nrun-task-git runs run_task_resource_monitor.py in-process from\nRUN_TASK_STARTUP_HOOK, which starts the resource monitor and records phases by\nwrapping run-task's functions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332076\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_job.py", "taskcluster/gecko_taskgraph/transforms/job/run_task.py", "taskcluster/scripts/run_task_resource_monitor.py"], "git_node": "0ad82c931081fdec5e23b362884f0a616278882d", "git_parents": ["a4655b6cd7e061b0f9f039440ddb7c4cf4791252"], "node": "8b75f514837a92e5651a8f0eece8d944e980a7a2", "parents": ["fdf1208da7f67a60fd25bce92dce9c9cd86c8ae1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071154 - Allow main thread IO on jogfile.json in the Privileged Content process of Windows artifact builds. r=firefox-desktop-core-reviewers ,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335724\n", "files": ["browser/base/content/test/browser-performance/browser_startup_content_mainthreadio.js"], "git_node": "b1c4f7add5e419efaa9884ba9751a2b4b254bb33", "git_parents": ["0ad82c931081fdec5e23b362884f0a616278882d"], "node": "2193085a4d642889ce932363e5bff86d2b856366", "parents": ["8b75f514837a92e5651a8f0eece8d944e980a7a2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084305 - Re-enable browser-performance tests on asan, tsan, debug and macOS 15 opt. r=firefox-desktop-core-reviewers ,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335725\n", "files": ["browser/base/content/test/browser-performance/browser.toml", "browser/base/content/test/browser-performance/io/browser.toml"], "git_node": "f21b56e4be167969dc64f27635e477162d4b2c66", "git_parents": ["b1c4f7add5e419efaa9884ba9751a2b4b254bb33"], "node": "1335532d12236958268aeae3774e1f16d599ccf6", "parents": ["2193085a4d642889ce932363e5bff86d2b856366"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078262 - Start the notification helpers without the shell after an update r=cdupuis,yjuglaret,browser-installer-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332113\n", "files": ["toolkit/mozapps/installer/windows/nsis/common.nsh"], "git_node": "97b54617b9acbd53ba2de3caecac4128c36f63f5", "git_parents": ["f21b56e4be167969dc64f27635e477162d4b2c66"], "node": "97450cda8dff5619317ac97e19b61256f0d5c397", "parents": ["1335532d12236958268aeae3774e1f16d599ccf6"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078262 - Start the post-update process with the user's default environment r=application-update-reviewers,cdupuis,hsohaney,yjuglaret,browser-installer-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335327\n", "files": ["browser/installer/windows/docs/Helper.md", "toolkit/mozapps/update/common/PostUpdateEnvironment.cpp", "toolkit/mozapps/update/common/PostUpdateEnvironment.h", "toolkit/mozapps/update/common/moz.build", "toolkit/mozapps/update/docs/Implementation.md", "toolkit/mozapps/update/tests/gtest/PostUpdateEnvironmentTests.cpp", "toolkit/mozapps/update/tests/gtest/moz.build", "toolkit/mozapps/update/updater/launchchild_osx.mm", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "d5864b8ae28b999cac7c0d83fc97b6b048936951", "git_parents": ["97b54617b9acbd53ba2de3caecac4128c36f63f5"], "node": "4a87958d6efe2e6006c490751a2784eda4e0d882", "parents": ["97450cda8dff5619317ac97e19b61256f0d5c397"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Create the blob upload directory when the resource monitor is forwarding to a parent monitor. r?#releng\n\nThe forwarding monitor starts before the clobber step, so the early return\nskipped creating the directory, and tests failed writing summary.jsonl.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337550\n", "files": ["testing/mozharness/mozharness/base/python.py"], "git_node": "f857db5bfd992d0b1964660bbe1531932898a56b", "git_parents": ["d5864b8ae28b999cac7c0d83fc97b6b048936951"], "node": "790a3a4fc6e9c3830aea09333b293b543ca9ccd4", "parents": ["4a87958d6efe2e6006c490751a2784eda4e0d882"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054633 - Validate RemoteWorkerDebugger registration and stop servicing rpc requests from out-of-process workers. r=dom-worker-reviewers,devtools-reviewers,jdescottes,asuth\" for causing bc failures @ browser_fileURL.js\n\nThis reverts commit 5ceef57bd9d93361b4098c86dc921393fab82028.\n", "files": ["devtools/server/connectors/worker-connector.js", "dom/ipc/ContentParent.cpp", "dom/workers/WorkerDebugger.cpp", "dom/workers/nsIWorkerDebugger.idl", "dom/workers/remoteworkers/RemoteWorkerDebuggerManagerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerDebuggerManagerParent.h", "dom/workers/remoteworkers/RemoteWorkerDebuggerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerDebuggerParent.h", "dom/workers/remoteworkers/RemoteWorkerService.cpp"], "git_node": "ec2158e236c5dc108b182e64e906a1157a9b436c", "git_parents": ["f857db5bfd992d0b1964660bbe1531932898a56b"], "node": "19a7aed6d2ceec33ae29d320971fc05b88f8bb4e", "parents": ["790a3a4fc6e9c3830aea09333b293b543ca9ccd4"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074442 - Let 'normal' line-height respect font-metrics overrides even if the spacing becomes more cramped than we would normally allow. r=layout-reviewers,dshin\" for causing wr failues @ metrics-override-small-lineheight.html\n\nThis reverts commit 0a4880391023c266e31cc42969b842045f6b9fd4.\n", "files": ["dom/svg/SVGContentUtils.cpp", "gfx/src/nsFontMetrics.cpp", "gfx/src/nsFontMetrics.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "layout/generic/ReflowInput.cpp", "layout/generic/ReflowInput.h", "testing/web-platform/tests/css/css-fonts/metrics-override-small-lineheight-ref.html", "testing/web-platform/tests/css/css-fonts/metrics-override-small-lineheight.html"], "git_node": "504eee56baddd590c5afc333b8e44a6fd605e1ad", "git_parents": ["ec2158e236c5dc108b182e64e906a1157a9b436c"], "node": "b3f2b4160f6f255cc40430fdf0ecacd58456ccdd", "parents": ["19a7aed6d2ceec33ae29d320971fc05b88f8bb4e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060746 - Remove nsAttributeTextNode. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nUse a privileged env() for the submit string instead of\n-moz-alt-content, and regular attr() when possible instead of\n-moz-label-content, leave that one for accesskey.\n\nThis technically breaks \u003clabel crop=\"start\" accesskey=\"\"\u003e but that makes\nno sense and we never use it anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337116\n", "files": ["accessible/tests/mochitest/events/test_label.xhtml", "accessible/xul/XULFormControlAccessible.cpp", "browser/base/content/test/browser-static/browser_parsable_css.js", "dom/base/nsTextNode.cpp", "gfx/src/nsFontCache.cpp", "gfx/thebes/gfxFontUtils.cpp", "gfx/thebes/gfxFontUtils.h", "layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsHTMLParts.h", "layout/inspector/tests/test_bug877690.html", "layout/style/FontFace.cpp", "layout/style/FontFaceImpl.cpp", "layout/style/FontFaceSet.cpp", "layout/style/FontFaceSetDocumentImpl.cpp", "layout/style/FontFaceSetImpl.cpp", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/ServoStyleSet.h", "layout/style/ServoUtils.h", "layout/style/res/html.css", "servo/components/style/custom_properties.rs", "servo/components/style/device/gecko.rs", "servo/components/style/device/mod.rs", "servo/components/style/substitution/env.rs", "servo/components/style/values/generics/counters.rs", "servo/components/style/values/specified/counters.rs", "toolkit/content/xul.css", "xpcom/ds/StaticAtoms.py"], "git_node": "83730915303340c5d0f01c6bb80982ce2615e3fc", "git_parents": ["504eee56baddd590c5afc333b8e44a6fd605e1ad"], "node": "e3b07b38487821c7ab509cbb21797595a4b36581", "parents": ["b3f2b4160f6f255cc40430fdf0ecacd58456ccdd"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2086362. Add a gtest that D3D11 render texture hosts accept textures larger than their descriptor. r=gfx-reviewers,wsmind\n\nVideo textures can be allocated with alignment padding, so they can be larger\nthan the size in the descriptor. Bug 2058993 required an exact match, which\nrejected those frames and showed green video (bug 2084846).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337398\n", "files": ["gfx/tests/gtest/TestRenderD3D11TextureHost.cpp", "gfx/tests/gtest/moz.build"], "git_node": "60eea592b249059fb535ebbc30843feea5bf4b72", "git_parents": ["83730915303340c5d0f01c6bb80982ce2615e3fc"], "node": "ebeb4c0bdb4960d5d8271de9678f53645817302d", "parents": ["e3b07b38487821c7ab509cbb21797595a4b36581"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2086362. Add a gtest that RemoteImageHolder accepts a frame with padded chroma planes. r=gfx-reviewers,wsmind\n\nDecoders can pad the planes of a frame, so the chroma plane can be larger than\nthe luma size implies. Bug 2018113 initially required an exact match, which\nrejected those frames (bug 2021592).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337399\n", "files": ["dom/media/gtest/TestRemoteImageHolder.cpp"], "git_node": "e0440d539c1f8e798fc731f184136d1df12a7a7e", "git_parents": ["60eea592b249059fb535ebbc30843feea5bf4b72"], "node": "12f888d90e52e68e20226b83a957093580c20705", "parents": ["ebeb4c0bdb4960d5d8271de9678f53645817302d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084519 - Use the ghost button tokens for disabled toolbarbuttons. r=desktop-theme-reviewers,akulyk\n\nThunderbird fades the children of some disabled toolbarbuttons, which now stacks with the button fade; bug 2084554 adapts those rules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335930\n", "files": ["browser/themes/shared/toolbarbuttons.css", "toolkit/themes/shared/arrowscrollbox.css", "toolkit/themes/shared/findbar.css", "toolkit/themes/shared/toolbarbutton.css"], "git_node": "8db9a83aaf7c94c92445322dcb2bd893b0289ce5", "git_parents": ["e0440d539c1f8e798fc731f184136d1df12a7a7e"], "node": "443a45f882c4528412259deaeeed1e5ea63820c1", "parents": ["12f888d90e52e68e20226b83a957093580c20705"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084656 - Use the ghost text colors for menu items in Nova dark too (no visible change). r=desktop-theme-reviewers,reusable-components-reviewers,akulyk\n\nFigma's dark values for disabled, hovered, pressed and selected menu items never painted: in chrome the ghost tokens are `inherit`, which invalidates the whole `light-dark()` so the color inherits, and in-content both sides already resolve to the same color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336050\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "90a8e1dacc5c56cc1a4713680e996a45c1e122e2", "git_parents": ["8db9a83aaf7c94c92445322dcb2bd893b0289ce5"], "node": "0cfd3c4b72dbb61503400fab23d6c33a7d4450be", "parents": ["443a45f882c4528412259deaeeed1e5ea63820c1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084656 - Use currentColor for the ghost and menu text colors that follow the surrounding text (no visible change). r=desktop-theme-reviewers,reusable-components-reviewers,akulyk\n\nA token set to `inherit` leaves the custom property empty, so it only works where no `light-dark()` or `color-mix()` wraps it; `currentColor` stays valid there. Every reader sets `color`, where the two compute the same.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336052\n", "files": ["toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "e6662ff5ac4ba924b3cc0694d4146b6500f3edff", "git_parents": ["90a8e1dacc5c56cc1a4713680e996a45c1e122e2"], "node": "88264fa6f2869cdbee90430b9b0e8a5ea87e0f96", "parents": ["0cfd3c4b72dbb61503400fab23d6c33a7d4450be"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084191 - Label the tab manager's container items with getUserContextLabel. r=tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336197\n", "files": ["browser/components/tabbrowser/content/browser-allTabsMenu.js", "browser/components/tabbrowser/test/browser/tabs/browser_list_all_tabs_menu_items.js"], "git_node": "87300f948bc2962ad88e44edded68818a30e58ec", "git_parents": ["e6662ff5ac4ba924b3cc0694d4146b6500f3edff"], "node": "af64bade72cce43a16c3de8f31408cc14c4d9798", "parents": ["88264fa6f2869cdbee90430b9b0e8a5ea87e0f96"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086037 - Retry a failed autofill migration dry run and leave a given-up profile on JSON. r=theidkamp,credential-management-reviewers\n\nSome migration failures clear on a later launch, so the attempt limit goes\nfrom 3 to 10, for credit cards and for the address migration already in the\nfield, whose profiles that gave up at 3 attempts will try again. A failed dry\nrun now retries on later launches on its own migrationTestAttempts budget\ninstead of recording its generation as done. Once the real migration has\nspent its attempts, rust.enabled is treated as false, so a Nimbus enrolment\ncannot restart it. The pref itself is not written: Nimbus would unenrol the\nprofile from the rollout that set it, and its remaining events would drop out\nof the rollout's telemetry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337529\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_address_migration.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "modules/libpref/init/all.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs"], "git_node": "ff0b237ad46cd269e91458373ac8d926acc69564", "git_parents": ["87300f948bc2962ad88e44edded68818a30e58ec"], "node": "e05680a24105c432e2066cbcae34a94b60d678af", "parents": ["af64bade72cce43a16c3de8f31408cc14c4d9798"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083673 - Don't fire ATK text change signals on objects that don't implement AtkText. r=accessibility-platform-reviewers,Jamie\n\nText change events could be fired on objects without AtkText, e.g. a slider,\nwhich GLib rejected. When that was the first text change of the session, the\ncheck for the newer text change signals failed, so the deprecated signals were\nused for the rest of the session.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335241\n", "files": ["accessible/atk/AccessibleWrap.cpp"], "git_node": "79e287d241cd3a3b1673b676f13500b9304b5296", "git_parents": ["ff0b237ad46cd269e91458373ac8d926acc69564"], "node": "a4f8fe41a7bc568df8938af9a6e1d77b19c73158", "parents": ["e05680a24105c432e2066cbcae34a94b60d678af"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2084753 - Import the irregexp revision being vendored, not a stale copy of v8 r=iain\n\nIn taskcluster, import-irregexp.py updated the image's copy of v8 with\n`git pull origin master`, but v8's master branch hasn't moved since 2021, so\nit imported v8 as of when the docker image was built while mach recorded the\nrequested revision in moz.yaml. Updatebot's irregexp updates were therefore\nmissing whatever had landed upstream since the image was built.\n\nPass the revision being vendored to the script and fetch exactly that from\nthe moz.yaml's vendoring url. The temporary-checkout path for local runs does\nthe same instead of cloning v8's tip.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336188\n", "files": ["js/src/irregexp/import-irregexp.py", "js/src/irregexp/moz.yaml"], "git_node": "63e30ebc1ef31fc412fed07ac7620a74f97b773b", "git_parents": ["79e287d241cd3a3b1673b676f13500b9304b5296"], "node": "a71f66c8bc91852c936e9ba728dd6dc7a4e88307", "parents": ["a4f8fe41a7bc568df8938af9a6e1d77b19c73158"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083683 - Don't notify the saver of blocked downloads when their transfer stops. r=mak\n\nDownloads blocked because they are potentially unsafe, e.g. mixed content, use\na copy saver since their channel is already closed. Their transfer still\nnotifies the end of the channel, and calling onTransferFinished, which only the\nlegacy saver implements, threw.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335247\n", "files": ["toolkit/components/downloads/DownloadLegacy.sys.mjs"], "git_node": "73de35fb5f9c67d7d0f824d73b195a10307926d6", "git_parents": ["63e30ebc1ef31fc412fed07ac7620a74f97b773b"], "node": "dfcf94e0cb6131db2c873507e3bd53621e5d101f", "parents": ["a71f66c8bc91852c936e9ba728dd6dc7a4e88307"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1775202 - gn_processor.py: Try every combination of mozbuild_args keys when factoring moz.build conditions. r=glandium,webrtc-reviewers,mjf,bwc\n\nPreviously the combinations of keys used for conditions were listed by\nhand, so adding a key meant adding the right combinations for\nit. Missing ones caused attributes to be silently dropped, as happened\nwith MOZ_X11 in bug 1738845. Instead, try every combination and make it\nan error if anything is left unwritten.\n\nCombinations of keys are tried from fewest keys to most, and\ncombinations of the same size follow a fixed key order from least to\nmost specific. This doesn't affect correctness, but trying coarse keys\nbefore the keys that refine them gives more compact output.\n\nTARGET_OS is now set for every target, not just Darwin ones. A key that\nis unset in mozbuild_args is written as \"not CONFIG[key]\", which must\nalso hold in the real build, and configure always sets TARGET_OS.\nOtherwise a combination including TARGET_OS could emit conditions that\nnever match.\n\nWhen writing the root moz.build, DIRS were previously not removed from\nconfigurations in which a key of the condition was unset, because the\ncomparison didn't treat None as \"\". The hand-written combinations never\nreached a pass where this mattered, but with every combination such DIRS\nwould be emitted again by each later pass.\n\nThis changes some existing generated files, but they are equivalent for\nevery configuration we generate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336198\n", "files": ["build/gn_processor.py", "third_party/angle/angle_program_version_id_gn/moz.build", "third_party/angle/moz.build", "third_party/angle/translator_gn/moz.build", "third_party/libwebrtc/modules/desktop_capture/desktop_capture_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "a6ad71576a1c3a0a4c046aa953b8ffe1cd5bd035", "git_parents": ["73de35fb5f9c67d7d0f824d73b195a10307926d6"], "node": "4c57ec75f5e08ab1d160bc9e6433ded36c3c86d0", "parents": ["dfcf94e0cb6131db2c873507e3bd53621e5d101f"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086321 - Part 1. Don't treat killing the GPU process for tests as a crash. r=gfx-reviewers,bradwerth\n\nKilling the GPU process from tests counted towards the unstable restart\nlimit, so repeated kills could disable GPU process video decoding and fall\nback to software WebRender, as well as generating crash telemetry. Such\nkills now only go through the recovery path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337382\n", "files": ["gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/tests/chrome/chrome.toml", "gfx/tests/chrome/test_gpu_process_kill_for_testing.html", "widget/GfxInfoBase.cpp"], "git_node": "1b38d3b841b55f40654b31158a7b50cc5437c02b", "git_parents": ["a6ad71576a1c3a0a4c046aa953b8ffe1cd5bd035"], "node": "709e535e977ff1d03359da10e15d56f6a7cd0ae8", "parents": ["4c57ec75f5e08ab1d160bc9e6433ded36c3c86d0"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086321 - Part 2. Allow CanvasShutdownManager to notify any canvas context. r=gfx-reviewers,bradwerth\n\nThis moves the shutdown and remote canvas lost, restored and reset\nnotifications to virtual methods on nsICanvasRenderingContextInternal, so\nthat contexts other than CanvasRenderingContext2D can make use of them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337383\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/nsICanvasRenderingContextInternal.cpp", "dom/canvas/nsICanvasRenderingContextInternal.h", "gfx/ipc/CanvasShutdownManager.cpp", "gfx/ipc/CanvasShutdownManager.h"], "git_node": "8d7bb45c3036c4a6d18e2a95f36ce47b3e80bf50", "git_parents": ["1b38d3b841b55f40654b31158a7b50cc5437c02b"], "node": "1893e4c9a4a997be9aa3b59e14f2618cc72b29e6", "parents": ["709e535e977ff1d03359da10e15d56f6a7cd0ae8"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086321 - Part 3. Lose and restore WebGL contexts when remote canvas is lost. r=gfx-reviewers,bradwerth\n\nPreviously if the GPU process crashed, WebGL contexts never fired\nwebglcontextlost and were left permanently blank. Restoring immediately\nwould race with the GPU process being relaunched, so we wait for the\nCanvasManagerChild to be recreated, as we do for remote 2D canvas.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337384\n", "files": ["dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ClientWebGLContext.h", "dom/canvas/test/mochitest.toml", "dom/canvas/test/test_webgl_context_loss_gpu_process.html"], "git_node": "d8a9ec73e32512bf713ffdf45337d846fe8edfeb", "git_parents": ["8d7bb45c3036c4a6d18e2a95f36ce47b3e80bf50"], "node": "afeefb76e8bc9cd184211900fe1614f261bbf449", "parents": ["1893e4c9a4a997be9aa3b59e14f2618cc72b29e6"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086463 - Update android nightly application-services version bump to 83593ab3aac70388315bedf52d2769c598639b5a r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337431\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "a7167d980e570ff5cfbe95d2b4bdee3d8098693c", "git_parents": ["d8a9ec73e32512bf713ffdf45337d846fe8edfeb"], "node": "5de4c5db4fde3799accd1a4ba29772184489fcd8", "parents": ["afeefb76e8bc9cd184211900fe1614f261bbf449"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2085747 - Fail the TAO check for resource timing when any redirect hop fails it. r=smaug\n\nThe Fetch TAO check fails for every later response once any hop has\nfailed, but `mTimingAllowed` only checked the final response. Getters\nthat read it directly (`deliveryType`, `nextHopProtocol`, `fetchStart`,\n`serverTiming`) exposed timing info when a cross-origin redirect without\n`Timing-Allow-Origin` that redirected to a final response with\n`Timing-Allow-Origin: *`.\n\nNavigation timing entries are left alone. They don't go through the\nresource timing path, so they keep checking only the final response.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336660\n", "files": ["dom/performance/PerformanceTiming.cpp", "testing/web-platform/meta/resource-timing/same-origin-from-cross-origin-redirect.html.ini", "testing/web-platform/tests/navigation-timing/nested-document-timing-after-cross-origin-redirect.https.html", "testing/web-platform/tests/resource-timing/delivery-type.tentative.any.js", "testing/web-platform/tests/resource-timing/tao-failure-on-redirect-hop.https.html"], "git_node": "d398ae6ce9a2c0e826cca3e1f47d8dc4a7cbd3ea", "git_parents": ["a7167d980e570ff5cfbe95d2b4bdee3d8098693c"], "node": "0936e93cdbf6f1580436460815471503eea204c0", "parents": ["5de4c5db4fde3799accd1a4ba29772184489fcd8"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2058493 - Add a helper to add ~/.mozbuild/bin to PATH r=glandium\n\nAdd a bin directory in the mozbuild state directory for tools that mach\nbootstrap installs, and a helper that offers to add it to PATH by\nsourcing a generated ~/.mozbuild/env script from the shell\nconfiguration files, or with fish_add_path for fish. The directory is\nprepended to PATH, so the tools that bootstrap keeps up to date take\nprecedence over older copies elsewhere in PATH.\n\nFor shells that it doesn't know how to configure, or when a shell\nconfiguration file can't be written, it prints instructions instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333332\n", "files": ["python/mozboot/mozboot/base.py", "python/mozboot/mozboot/test/python.toml", "python/mozboot/mozboot/test/test_mozbuild_bin.py"], "git_node": "7f457d102befc7b3bf23baec28aad6d7693bfb98", "git_parents": ["d398ae6ce9a2c0e826cca3e1f47d8dc4a7cbd3ea"], "node": "6dc84a01ebb759419843c0e09aeeae6926f1e116", "parents": ["0936e93cdbf6f1580436460815471503eea204c0"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2058493 - Install profiler-cli from mach bootstrap r=firefox-build-system-reviewers,ahochheiden\n\nprofiler-cli is used by the profiler-analysis skill, and currently needs\nto be installed separately with npm. Build it in a toolchain task from\nthe same Firefox Profiler revision as profiler-node-tools, so that\nbumping that revision updates both, and install it as part of the\nagentic coding tools step of mach bootstrap, along with launchers in\n~/.mozbuild/bin for its package.json bin entries that run it with the\nbootstrapped node. Bootstrap then offers to add ~/.mozbuild/bin to PATH.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330106\n", "files": ["python/mozboot/mozboot/base.py", "python/mozboot/mozboot/bootstrap.py", "python/mozboot/mozboot/test/test_bootstrap.py", "python/mozboot/mozboot/test/test_mozbuild_bin.py", "taskcluster/kinds/toolchain/profiler-node-tools.yml", "taskcluster/scripts/misc/build-profiler-cli.sh"], "git_node": "a3431d05a1efb2d7580e7824299b1399eedc15da", "git_parents": ["7f457d102befc7b3bf23baec28aad6d7693bfb98"], "node": "5fe13e536377ec4544bcf8e0c19d8c7bca949d1e", "parents": ["6dc84a01ebb759419843c0e09aeeae6926f1e116"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2058493 - Point the profiler skills at mach bootstrap to install profiler-cli r=ai4dev-reviewers,profiler-reviewers,padenot,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330108\n", "files": [".agents/skills/perf-regression-triage/SKILL.md", ".agents/skills/profiler-analysis/SKILL.md", ".claude/skills/perf-regression-triage/SKILL.md", ".claude/skills/profiler-analysis/SKILL.md"], "git_node": "a3248ecacdf2fab77c2c6f081ed901ce3ec77c02", "git_parents": ["a3431d05a1efb2d7580e7824299b1399eedc15da"], "node": "dc5742041f444bda7a3ce3ae841ac410662c23c1", "parents": ["5fe13e536377ec4544bcf8e0c19d8c7bca949d1e"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2081277 - Install the cargo agentic tools to ~/.mozbuild/bin r=padenot,glandium\n\nThe agentic coding tools that mach bootstrap installs were copied into\n~/.cargo/bin, which we don't own. Install them into ~/.mozbuild/bin\nalongside the npm tools instead. Since ~/.mozbuild/bin is prepended to\nPATH, the copies left in ~/.cargo/bin by previous bootstraps don't\nshadow the new ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333333\n", "files": ["python/mozboot/mozboot/base.py", "python/mozboot/mozboot/test/test_mozbuild_bin.py"], "git_node": "380516683c5ad8dec86371f6a1c4fad3bb21cc98", "git_parents": ["a3248ecacdf2fab77c2c6f081ed901ce3ec77c02"], "node": "74c4c0dce3554cd20ce90a10c2c0f393d4fce1f5", "parents": ["dc5742041f444bda7a3ce3ae841ac410662c23c1"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079630 - Record a resource usage profile while generating the taskgraph in mach try. r=releng-reviewers,bhearsum\n\nThe profile is written to the logs/try directory of the mach state directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332077\n", "files": ["tools/tryselect/tasks.py"], "git_node": "e322083ff7551a850b151eb1b4e45fde26f62593", "git_parents": ["380516683c5ad8dec86371f6a1c4fad3bb21cc98"], "node": "6a717c6d11569722801fd947f5c5fcd767134434", "parents": ["74c4c0dce3554cd20ce90a10c2c0f393d4fce1f5"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079630 - Let resource monitors in child processes forward to their parent's profile without inheriting its monitor. r=releng-reviewers,bhearsum\n\nAdd a forward_to argument to SystemResourceMonitor so child processes can\nforward to a file given to them other than through the environment, and a\nchildren_forward_path property giving the file children should forward to.\n\nForked children no longer see the parent's monitor as theirs, so they can't\nstop the parent's resource usage collection when exiting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332078\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "0ea32301b70fe246b8a9e52b1bd02626824324d7", "git_parents": ["e322083ff7551a850b151eb1b4e45fde26f62593"], "node": "00b729aae80c9985d83953bfea865da15eb098f3", "parents": ["6a717c6d11569722801fd947f5c5fcd767134434"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079630 - Record a resource usage profile marker for each kind loaded while generating the taskgraph. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nKinds loaded in worker processes forward their marker to the monitor in the\nparent process. The workers find ProfiledKind through the kind instances they\nare sent, so this works whatever the multiprocessing start method is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332079\n", "files": ["taskcluster/gecko_taskgraph/__init__.py", "taskcluster/gecko_taskgraph/kind.py", "taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_kind.py", "taskcluster/mach_commands.py", "tools/tryselect/tasks.py"], "git_node": "4fab1f21fabe01a147fa527f5b60f7edbfa223b6", "git_parents": ["0ea32301b70fe246b8a9e52b1bd02626824324d7"], "node": "4f29534597ada5475ec9d7e725904c1e58bcffcc", "parents": ["00b729aae80c9985d83953bfea865da15eb098f3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079630 - Record resource usage profile markers for kind results and taskgraph verifications. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nGetting the tasks of a kind loaded in another process back to the parent\nprocess takes over a second for the largest kinds, and verifications take\nmost of the time of some generation phases, neither of which was covered by\nmarkers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332080\n", "files": ["taskcluster/gecko_taskgraph/__init__.py", "taskcluster/gecko_taskgraph/kind.py", "taskcluster/gecko_taskgraph/test/test_kind.py", "taskcluster/gecko_taskgraph/util/verify.py"], "git_node": "2d667e7741fb5335ec6ab17e0c2bed8886455211", "git_parents": ["4fab1f21fabe01a147fa527f5b60f7edbfa223b6"], "node": "ca1d0ce14182fd0e8abe828a0aaabc21a20c582f", "parents": ["4f29534597ada5475ec9d7e725904c1e58bcffcc"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079630 - Record a resource usage profile marker for writing the taskgraph cache in mach try. r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332081\n", "files": ["tools/tryselect/tasks.py"], "git_node": "0c8d3ccd9b136f74d3efe4cdc87e6b87d1c01b4f", "git_parents": ["2d667e7741fb5335ec6ab17e0c2bed8886455211"], "node": "ee237888f12675dc8763f417b1c10dfea87fd7e3", "parents": ["ca1d0ce14182fd0e8abe828a0aaabc21a20c582f"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079630 - Record a resource usage profile marker for each taskgraph generation phase. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\ntaskgraph calls generator.phase_finished after each phase it runs, with no name\nfor a phase that raised. The graph_config phase isn't recorded: it ends before\nregister() replaces the hook.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332082\n", "files": ["taskcluster/gecko_taskgraph/__init__.py", "taskcluster/gecko_taskgraph/test/test_kind.py"], "git_node": "9563b3a9c5eae28479e3916cc975545045d4a088", "git_parents": ["0c8d3ccd9b136f74d3efe4cdc87e6b87d1c01b4f"], "node": "18da5d28768e44a1b866d48351e4bb89378934c7", "parents": ["ee237888f12675dc8763f417b1c10dfea87fd7e3"], "tags": []}, {"author": "Charlie Humphreys \u003cchumphreys@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084744: Update about:glean based on UX feedback r=TravisLong,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336029\n", "files": ["toolkit/content/aboutGlean.css", "toolkit/content/aboutGlean.html", "toolkit/content/aboutGlean.js", "toolkit/locales/en-US/toolkit/about/aboutGlean.ftl"], "git_node": "0e693091efcc82e55df07772299ecfb68a6d1d06", "git_parents": ["9563b3a9c5eae28479e3916cc975545045d4a088"], "node": "5a9a73d2912636a8715fa145b21048be654223f0", "parents": ["18da5d28768e44a1b866d48351e4bb89378934c7"], "tags": []}], "date": 1793206528, "git_changesets": ["4c0ee05cd75f3d036254adec50eed0ac0a082a1e", "154872461fe3040fbeef840e95d83109c0732d4c", "2820ac6da20cfbaa03762cd8f69fcc6b50a38b66", "5e8e06e012b3498cd9c001a48da33a64b5bd51f4", "5ff58768d9726a3f3fed830c3b3d242140d169fd", "c6356cadde74d4d856319802ca88b75eaf806e1e", "a99c7acf607d75e82e4fdb3d693b61ba7906c1b0", "85e3e85de4ab8400d1e3fdb520d4060d8392eee3", "0777d5419057374944d5a441ad56b88774f3b06d", "89250193369659802caba29b8c234c97243c1f57", "b3b9b117bb8dfbfe149c20f1e673d541270fd601", "1fdc3b5c09e2b01a8bc735af10014f1f0d664647", "e6f432c17d990b994dff3f92572b827c1245c42b", "cb8f2d2a164b6ae78883540c9a6a15e12b01ebc8", "32c873bd32aa68fe5fefb349fa0eabdb2cf0877c", "e77423cadcf852718b76cfc4951e26addad0af5c", "ac18217d27a211c71adf2295c08956b50b269817", "da95fc4675571fda8dcd8701aa561c594d918e9a", "059e890a790a6d1ec51bccdbb07c11273ed17870", "548366028