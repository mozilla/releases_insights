.cpp", "gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderImageHost.cpp", "gfx/layers/wr/WebRenderLayerManager.cpp", "gfx/layers/wr/WebRenderTextureHost.cpp", "gfx/src/DriverCrashGuard.cpp", "gfx/src/nsDeviceContext.cpp", "gfx/src/nsFontMetrics.cpp", "gfx/src/nsThebesFontEnumerator.cpp", "gfx/tests/gtest/TestVsync.cpp", "gfx/thebes/DeviceManagerDx.cpp", "gfx/thebes/SharedFontList-impl.h", "gfx/thebes/SharedFontList.cpp", "gfx/thebes/SoftwareVsyncSource.cpp", "gfx/thebes/VsyncSource.cpp", "gfx/thebes/gfxAndroidPlatform.cpp", "gfx/thebes/gfxDWriteFonts.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxFontInfoLoader.cpp", "gfx/thebes/gfxFontSrcPrincipal.cpp", "gfx/thebes/gfxFontSrcURI.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatformFontList.cpp", "gfx/thebes/gfxPlatformGtk.cpp", "gfx/thebes/gfxPlatformMac.cpp", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h", "gfx/thebes/gfxWindowsPlatform.cpp", "gfx/vr/FxROutputHandler.cpp", "gfx/vr/FxRWindowManager.cpp", "gfx/vr/VRManager.cpp", "gfx/vr/VRPuppetCommandBuffer.cpp", "gfx/vr/VRServiceHost.cpp", "gfx/vr/VRShMem.cpp", "gfx/vr/VRThread.cpp", "gfx/vr/gfxVRMutex.h", "gfx/vr/ipc/VRChild.cpp", "gfx/vr/ipc/VRGPUChild.cpp", "gfx/vr/ipc/VRGPUParent.cpp", "gfx/vr/ipc/VRLayerChild.cpp", "gfx/vr/ipc/VRManagerChild.cpp", "gfx/vr/ipc/VRManagerParent.cpp", "gfx/vr/ipc/VRParent.cpp", "gfx/vr/ipc/VRProcessChild.cpp", "gfx/vr/ipc/VRProcessManager.cpp", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/nsFxrCommandLineHandler.cpp", "gfx/vr/service/OculusSession.cpp", "gfx/vr/service/OpenVRSession.cpp", "gfx/vr/service/VRService.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidSurfaceTextureHost.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "gfx/webrender_bindings/RenderTextureHost.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderThread.cpp", "gfx/webrender_bindings/RenderThread.h", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "4b3d335268f3a0edbf59596c9362267697694946", "git_parents": ["6ee822ddd28e6e1c81e2b170743e63e3b5b08143"], "node": "941a1ea739b846b70c199026871b41828db5de04", "parents": ["e0f5d4917c72136199f663c253abf639e544768b"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085363 - Fetch the upload-symbols CLI in OpenH264 symbol upload tasks. r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nBug 2044614 made upload_symbols.py call the upload-symbols CLI, and bug 2065710\nfixed the static symbol upload kinds, but the OpenH264 tasks are generated by\ntheir own transform and were missed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336395\n", "files": ["taskcluster/gecko_taskgraph/transforms/openh264_symbol_upload.py", "taskcluster/kinds/openh264-symbol-upload/kind.yml"], "git_node": "f64d190f80af84cc676d67014fbc96177d18ab6e", "git_parents": ["4b3d335268f3a0edbf59596c9362267697694946"], "node": "4ae26e96bc4be325c5d96802fea88ba26b6e05fc", "parents": ["941a1ea739b846b70c199026871b41828db5de04"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064413 - Recognize git checkouts in symbolstore.py, r=ahochheiden\n\nTasks with clone-with: git produce a checkout with no .hg directory,\nso GetVCSFilenameFromSrcdir fell through to the unknown-VCS case and\ndropped source attribution for their crash symbols.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334295\n", "files": ["toolkit/crashreporter/tools/symbolstore.py", "toolkit/crashreporter/tools/unit-symbolstore.py"], "git_node": "e227f17ea6811f94a3a472d210ec23c9370b8c91", "git_parents": ["f64d190f80af84cc676d67014fbc96177d18ab6e"], "node": "eb587f1b5dcc82088f84004ae16a5f5b83289559", "parents": ["4ae26e96bc4be325c5d96802fea88ba26b6e05fc"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064413 - Ensure new build tasks default to Git clones, r=taskgraph-reviewers,bhearsum,sergesanspaille\n\nThis is a no-op, but means any future build tasks that don't explicitly\nset `clone-with` will default to Git.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334296\n", "files": ["taskcluster/kinds/build/android-stuff.yml", "taskcluster/kinds/build/kind.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/windows-mingw.yml"], "git_node": "044beb56c73a37207fe5931b7abcd8ee80517689", "git_parents": ["e227f17ea6811f94a3a472d210ec23c9370b8c91"], "node": "147543754e978ad40072f5f3fce866ea7ef227cd", "parents": ["eb587f1b5dcc82088f84004ae16a5f5b83289559"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2085210 - Simplify `String.toLocale()` and handle complex BCP-47 language tags r=pollymce\n\nReplaces custom string-splitting in `String.toLocale()` by normalizing underscores to hyphens and delegating to `Locale.forLanguageTag()`. This ensures language tags containing scripts, variants, or Unicode extensions are properly parsed, and returns `Locale.ROOT` for blank input strings.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/411\n", "files": ["mobile/android/android-components/components/support/locale/src/main/java/mozilla/components/support/locale/Extensions.kt", "mobile/android/android-components/components/support/locale/src/test/java/mozilla/components/support/locale/ExtensionsTest.kt"], "git_node": "f1d204e48904092d4a9fd76092e7cd609ba92479", "git_parents": ["044beb56c73a37207fe5931b7abcd8ee80517689"], "node": "f616b06abf1bd01e52bcd073c9f8bc7d81181e3b", "parents": ["147543754e978ad40072f5f3fce866ea7ef227cd"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084938 - Enable browser.smartwindow.aitab.enabled in browser_aitab_generation.js. r=jlewis\n\nabout:smartpage is unavailable when the pref is off, which is the default on beta.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336523\n", "files": ["browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js"], "git_node": "e0c84326fb0c09252aa505c1e1111b319d10a288", "git_parents": ["f1d204e48904092d4a9fd76092e7cd609ba92479"], "node": "cf49e34033a17748812aca745ee76711a37c6988", "parents": ["f616b06abf1bd01e52bcd073c9f8bc7d81181e3b"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084271 - Re-enumerate macOS speech synthesis voices when the system voice list changes. r=eeejay,media-playback-reviewers,padenot\" as requested by dev for causing Bug 2085631\n\nThis reverts commit fce00ff624d5530ff7a4f3489bb6154a85613880.\n", "files": ["dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.h", "dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.mm"], "git_node": "03a16370ec8e120a0aa04622171c8cfbabee5d85", "git_parents": ["e0c84326fb0c09252aa505c1e1111b319d10a288"], "node": "10c426f1a807b1ffaa0be0abc33f9d5b3e31008a", "parents": ["cf49e34033a17748812aca745ee76711a37c6988"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082483 - Smooth the Show Trackers pill's collapse and tab switch animations. r=urlbar-reviewers,desktop-theme-reviewers,tgiles,daisuke\n\nThe tracker count pill's expand, collapse and fade animations now share a\n110ms duration and a cubic-bezier(0.2, 0.8, 0.2, 1) easing, set once as\n--tracker-count-duration and --tracker-count-easing.\n\nOn a site's entry page, the longform \"N trackers blocked\" label now\ncrossfades into the shortform count: the shortform fades in and expands\nwhile the longform fades out and collapses, instead of only starting once\nthe longform has fully collapsed. The pill's width moves straight from the\nlongform to the shortform, without shrinking to the shield and growing\nback. Revealing the count by collapsing the longform would rely on the\ncount being at the start of the string, which isn't the case in every\nlocale.\n\nWhen switching tabs, the pill resizes from its width in the previous tab\nto the selected tab's, or from just the shield if the previous tab showed\nno count, while the count fades in. If the selected tab shows no count, the\nprevious tab's pill shrinks down to the shield while its background fades\nout. This is skipped with reduced motion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334334\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "f983dafd283bd23f5c80b20ec58ced00d7d922e7", "git_parents": ["03a16370ec8e120a0aa04622171c8cfbabee5d85"], "node": "b0c63234fc54d3de551ee3007efe65e66efb94ac", "parents": ["10c426f1a807b1ffaa0be0abc33f9d5b3e31008a"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049719 - Add Storybook documentation for the segmented control r=reusable-components-reviewers,tgiles\n\nAdds a README for moz-segmented-control that follows the shape of the other component docs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332046\n", "files": ["toolkit/content/widgets/moz-segmented-control/README.stories.md"], "git_node": "ee154fca766cbca9b664ba9a9c26e9ab0461cc84", "git_parents": ["f983dafd283bd23f5c80b20ec58ced00d7d922e7"], "node": "0433c92e2a8ae38f486085eeed344558e25f0e02", "parents": ["b0c63234fc54d3de551ee3007efe65e66efb94ac"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081939: Avoid duplicating frames that escape repeating headers. r=layout-reviewers,emilio\" for causing reftest failure @ 427017-1.xhtml\n\nThis reverts commit 6ee822ddd28e6e1c81e2b170743e63e3b5b08143.\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "31d5df4393622a949a890a096d425a69ee87051f", "git_parents": ["ee154fca766cbca9b664ba9a9c26e9ab0461cc84"], "node": "e47d5ec90642a53b5c1e0581a6acfc2d5a8b0b5b", "parents": ["0433c92e2a8ae38f486085eeed344558e25f0e02"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084071 - Send screen impression when newtab multistage is visible r=emcminn,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336220\n", "files": ["browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/docs/asrouter-newtab-multistage-message.md", "browser/components/asrouter/tests/browser/browser_asrouter_newtab_multistage_messages.js"], "git_node": "56f7283ea6c213186d763c991fa84358ed499b28", "git_parents": ["31d5df4393622a949a890a096d425a69ee87051f"], "node": "24fbb69ec09da6b1a86941809fc9362a5e8684f5", "parents": ["e47d5ec90642a53b5c1e0581a6acfc2d5a8b0b5b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085572 - Make color-scheme meta tag affect the prefers-color-scheme media query. r=firefox-style-system-reviewers,layout-reviewers,dshin\n\nAs per https://github.com/w3c/csswg-drafts/issues/13377\n\nSee https://github.com/w3c/csswg-drafts/issues/14493#issuecomment-6382548874\nfor some context that made me look at this.\n\nThe ChromeRulesEnabled check is because I want to remove some chrome\nusages of the override.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336533\n", "files": ["dom/base/Document.cpp", "layout/base/nsPresContext.cpp", "layout/inspector/tests/test_isUsedColorSchemeDark.html", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/prefers-color-scheme-meta-dark-print-notref.html", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/prefers-color-scheme-meta-dark.html", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/prefers-color-scheme-meta-dynamic.html", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/prefers-color-scheme-meta-light-dark-ref.html", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/prefers-color-scheme-meta-light-dark.html", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/prefers-color-scheme-meta-light-notref.html", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/prefers-color-scheme-meta-only-dark-print.tentative.html"], "git_node": "b94dd99eb54f0b0a883a2ad6597facf350c27a80", "git_parents": ["56f7283ea6c213186d763c991fa84358ed499b28"], "node": "43b97a47496ddc8183af01706c83ecb1e3916f4c", "parents": ["24fbb69ec09da6b1a86941809fc9362a5e8684f5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1922590 - Make mozprocess.run_and_wait reliably call the timeout handler. r=mozbase-reviewers,whimboo\n\nrun_and_wait compared time.time() with a wall-clock deadline after Queue.get() raised Empty, but Queue.get()\ntimes out on the monotonic clock and can wake just before the wall-clock deadline, so a real timeout was taken\nfor an output timeout. The deadline is now monotonic and get_line() records which limit it waited on.\n\nOnce the deadline has passed, get_line() stops waiting itself instead of passing Queue.get() a negative\ntimeout, which raised ValueError while output was still arriving. The final wait is bounded by the deadline as\nwell, so a process that closes its output and keeps running still times out. Once the reader has reached the\nend of the output, the lines still queued are delivered without a deadline, so a slow line handler no longer\nloses output the process wrote before exiting. Only run_and_wait's own waits are treated as timeouts, so an\nEmpty or TimeoutExpired raised by the output line handler reaches the caller instead of calling a timeout\nhandler.\n\nOutput is decoded with errors=\"replace\", since one undecodable byte killed the reader thread and left\nrun_and_wait waiting for the timeout, or forever without one. The reader also queues the end of output if it\nfails for any other reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336001\n", "files": ["testing/mozbase/mozprocess/mozprocess/mozprocess.py", "testing/mozbase/mozprocess/tests/test_run_and_wait.py"], "git_node": "b6fb0776e96b1c6acda3d13e848715602a409a12", "git_parents": ["b94dd99eb54f0b0a883a2ad6597facf350c27a80"], "node": "56f4f8a7e531ba5f5fd803ca275ef01e52e33c4b", "parents": ["43b97a47496ddc8183af01706c83ecb1e3916f4c"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085369 - Avoid prematurely rejecting legacy fonts before the platform back-end has a chance to initialize them. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336695\n", "files": ["gfx/thebes/gfxFont.cpp"], "git_node": "b4308b9c58006b1dd28887de4b0a4bce7a6af49c", "git_parents": ["b6fb0776e96b1c6acda3d13e848715602a409a12"], "node": "9c0ba48aec0d9210ebc3fd9c80be041a3337268a", "parents": ["56f4f8a7e531ba5f5fd803ca275ef01e52e33c4b"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2035623 - Fix event name for days_opened_in_last_28 r=androi