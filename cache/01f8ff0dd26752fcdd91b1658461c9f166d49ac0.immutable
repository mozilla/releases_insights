bd83fa76e5018cff052ca4c4d888e\nsv-SE -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nta -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nte -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nth -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\ntl -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\ntr -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\ntrs -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nuk -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nur -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nuz -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nvi -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nwo -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nxh -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nzam -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nzh-CN -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\nzh-TW -\u003e 2c980fabd54bd83fa76e5018cff052ca4c4d888e\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "26eacb9134b3dc9c225ab853c715f9f7eca83bb7", "git_parents": ["db0e7d977c06e53ae4bee503ab08d0b8ff0b9ea1"], "node": "7feb765b030cc6c90fa34ffe0a21d766d57e4f0c", "parents": ["c8bd7ef60f8bb2f0e60706e1ec7f0f8f356f6f73"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the maybe-release, notarization, l10n automation and openh264-symbol-upload kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,ahal\n\nDeletes `run-on-repo-type: [hg]` from maybe-release, build-mac-notarization,\ngeckodriver-mac-notarization, openh264-notarization,\nshippable-l10n-mac-notarization, android-l10n, l10n-bump and\nopenh264-symbol-upload. None of these kinds pins a checkout type, so the\nchange is scheduling only: a no-op on the existing Mercurial graphs, in\neffect once these graphs run against a GitHub repository. The tasks cannot\nbe exercised at level 1 (production tokens, cron triggers or real branches),\nso this lands without a test run, as agreed with ahal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336142\n", "files": ["taskcluster/kinds/android-l10n/kind.yml", "taskcluster/kinds/build-mac-notarization/kind.yml", "taskcluster/kinds/geckodriver-mac-notarization/kind.yml", "taskcluster/kinds/l10n-bump/kind.yml", "taskcluster/kinds/maybe-release/kind.yml", "taskcluster/kinds/openh264-notarization/kind.yml", "taskcluster/kinds/openh264-symbol-upload/kind.yml", "taskcluster/kinds/shippable-l10n-mac-notarization/kind.yml"], "git_node": "307b5678c60274ccaabfcc4acbe9ed4f19e2c220", "git_parents": ["26eacb9134b3dc9c225ab853c715f9f7eca83bb7"], "node": "29f5b262c7f05ac6f602baf3aa0e9bcfe3e00ee4", "parents": ["7feb765b030cc6c90fa34ffe0a21d766d57e4f0c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084519 - Give chrome the high contrast values of --button-text-color-ghost-disabled. r=desktop-theme-reviewers,reusable-components-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335929\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "84e8de82abcd7abe86faa5e69d498f1c938f8dd0", "git_parents": ["307b5678c60274ccaabfcc4acbe9ed4f19e2c220"], "node": "d1ce0bc6b9fef907ebeba88ecab52ac485c89a56", "parents": ["29f5b262c7f05ac6f602baf3aa0e9bcfe3e00ee4"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057675 - Add MSIX test job that installs newtab trainhop XPIs and fails if memory usage exceeds high thresholds. r=ahal,reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314154\n", "files": ["browser/components/newtab/test/python/python.toml", "browser/components/newtab/test/python/test_trainhop_langpacks.py", "browser/extensions/newtab/docs/v2-system-addon/trainhop-langpack-smoke.md", "taskcluster/kinds/source-test/python.yml", "toolkit/toolkit.mozbuild"], "git_node": "bb8abe6531ea28f05694132c0e641215f5d69148", "git_parents": ["84e8de82abcd7abe86faa5e69d498f1c938f8dd0"], "node": "13ff64974e8c315dcc5e0fd1365c7fa0da82fb0d", "parents": ["d1ce0bc6b9fef907ebeba88ecab52ac485c89a56"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2084787 - Don't let nsGridContainerFrame hand out a stale nscoord_MIN baseline. r=layout-reviewers,emilio\n\nnsGridContainerFrame::MarkIntrinsicISizesDirty() resets the cached mBaseline\nvalues to the NS_INTRINSIC_ISIZE_UNKNOWN (nscoord_MIN) sentinel. If the grid's\nbaseline is then queried via GetNaturalBaselineBOffset() before the grid's next\nreflow -- e.g. when an inline-block whose content is the grid is baseline-\naligned in its line box after a block-size resize reflow invalidated the grid's\nintrinsic sizes -- that sentinel escaped and blew the line box, and every\nancestor, up to nscoord_MAX. (That's what happened before this patch, which\nlead to layout breakage in some cases.)\n\nThis patch fixes that by guarding GetNaturalBaselineBOffset() so that when the\ncached baseline is still the sentinel, it returns Nothing{}, letting the caller\nsynthesize a baseline instead of handing back the bogus value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336077\n", "files": ["layout/generic/nsGridContainerFrame.h", "testing/web-platform/tests/css/css-grid/firefox-bug-2084787.html"], "git_node": "2d1c8d5fb9506803bf52e816e57562b3b9b5e065", "git_parents": ["bb8abe6531ea28f05694132c0e641215f5d69148"], "node": "91b57ec45076d68f0aafcafca5cbe91a55dce3bb", "parents": ["13ff64974e8c315dcc5e0fd1365c7fa0da82fb0d"], "tags": []}, {"author": "Han Yue \u003calexyuehan@gmail.com\u003e", "branch": "default", "desc": "Bug 2081496 - Leave sessionstore-logs alone in test_write_outcome.js cleanup. r=sessionstore-reviewers,nsharpley\n\nThe tasks deliberately make session file writes fail, so SessionLogger\nflushes an error log into the profile's sessionstore-logs directory from\nan idle callback. The cleanup function removed every profile entry whose\nname starts with \"sessionstore\", including that directory, so the flush\ncould add a file while it was being removed, failing the test with\nNS_ERROR_FILE_DIR_NOT_EMPTY (seen on Windows). sessionstore-logs is not a\nsession file, so leave it out of the entries the cleanup saves and\nrestores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335859\n", "files": ["browser/components/sessionstore/test/unit/test_write_outcome.js"], "git_node": "ca2af271f075ab68a2b27b8e09c233e54b0e198a", "git_parents": ["2d1c8d5fb9506803bf52e816e57562b3b9b5e065"], "node": "491a7af73960807c02aea899480ab889e125e641", "parents": ["91b57ec45076d68f0aafcafca5cbe91a55dce3bb"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Schedule the source-test clang tasks on git-backed pushes, r=taskgraph-reviewers,ahal\n\nDeletes `run-on-repo-type: [hg]` from source-test/clang.yml. `clone-with: hg`\nstays: on a shallow Git checkout the static-analysis tooling lists every\nfile of the tree and the task is killed, which needs the base revision from\nbug 2046767 and a change in mach static-analysis first. On a Git push the\ncheckout is Git whatever the setting says. Scheduling only, a no-op on the\nexisting graphs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336146\n", "files": ["taskcluster/kinds/source-test/clang.yml"], "git_node": "677a05e8dcc2130c9888ba736f721de8bb48836c", "git_parents": ["ca2af271f075ab68a2b27b8e09c233e54b0e198a"], "node": "cf326e6112bc48f21a235e73c3f0574dc1b97051", "parents": ["491a7af73960807c02aea899480ab889e125e641"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007755 - Catch rejections of unawaited datagram writes in datagrams.https.any.js r=jib\n\nThe tests now close the session in cleanup, which rejects any datagram writes\nstill queued; Chrome reported these as unhandled rejections and marked the file\nERROR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336249\n", "files": ["testing/web-platform/tests/webtransport/datagrams.https.any.js"], "git_node": "cefd99984a13f19966f0d8b3b22ca58c4b597fdb", "git_parents": ["677a05e8dcc2130c9888ba736f721de8bb48836c"], "node": "a468aed1a2ed26e3eb243771137cc95a99b90789", "parents": ["cf326e6112bc48f21a235e73c3f0574dc1b97051"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067134 - updated accessibility strings and traversal r=android-reviewers,android-l10n-reviewers,android-build-system-reviewers,007,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334699\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineView.kt", "mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/menu/DropdownMenu.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/ListenSheet.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlaybackControls.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlaybackSpeedMenu.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/Player