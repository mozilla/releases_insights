uthor": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging dbf330c544f18438f005e729aec03e95408a6d69 with FIREFOX-ANDROID_160_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "60691e11a68cdd9db5f1d4cbf0d41865d1b7ec7e", "git_parents": ["a8861ef45bdd39fcb4cff9d0694ada272de2d235"], "node": "3f3be73a3b469716f059470abbd90e827c183359", "parents": ["8e0c2781e704d69e79fff64590fb9c26624a04fd"], "tags": []}], "date": 1793194022, "git_changesets": ["60691e11a68cdd9db5f1d4cbf0d41865d1b7ec7e"], "user": "ffxbld@lando.moz.tools"}, "45666": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging dbf330c544f18438f005e729aec03e95408a6d69 with FIREFOX_160_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7c0c655bd1fe24a3e80f72a5740cd5e42e4f1bc7", "git_parents": ["60691e11a68cdd9db5f1d4cbf0d41865d1b7ec7e"], "node": "82d071f1926a79473773966ba93eee37619f9552", "parents": ["3f3be73a3b469716f059470abbd90e827c183359"], "tags": []}], "date": 1793203058, "git_changesets": ["7c0c655bd1fe24a3e80f72a5740cd5e42e4f1bc7"], "user": "ffxbld@lando.moz.tools"}, "45667": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging dbf330c544f18438f005e729aec03e95408a6d69 with DEVEDITION_160_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ea048f6d9a2d048d266bcefa17b6db897373fc82", "git_parents": ["7c0c655bd1fe24a3e80f72a5740cd5e42e4f1bc7"], "node": "0134b7616423c2b7005f6b56a823558ebbade5ae", "parents": ["82d071f1926a79473773966ba93eee37619f9552"], "tags": []}], "date": 1793203581, "git_changesets": ["ea048f6d9a2d048d266bcefa17b6db897373fc82"], "user": "ffxbld@lando.moz.tools"}, "45668": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2084555 r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336955\n", "files": ["gfx/layers/client/TextureClient.cpp"], "git_node": "4c0ee05cd75f3d036254adec50eed0ac0a082a1e", "git_parents": ["be3847db4e2bcc52fa3f078b8b4a1ff167ad158f"], "node": "d3b56c2f21306e6537e788781dc103bac279ff4b", "parents": ["1edf73f82a27cbcb0f8fce36d3c6765c2d7c5f7d"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2080511 - Refactor var/env/attr into dedicated substitution module. r=firefox-style-system-reviewers,emilio\n\nThe behavior of these substitution functions is unchanged; refactoring\nshould make it easier to extend these existing functions, as well as to\nintroduce additional arbitrary substitution functions.\n\n- The new var/env/attr modules hold most of the function-specific logic.\n  The new substitution module contains most of the shared substitution\n  logic, including new context structs for parsing and replacement to\n  replace long parameter lists.\n\n- The `VariableFallback` type is renamed to `ArbitraryDeclarationValue`,\n  and always stores its own end index (previously it always inferred\n  it from `reference.end - 1`). This is in preparation for functions\n  that have multiple non-fallback `\u003cdeclaration-value\u003e` arguments\n  (like `random-item()`), and to support free-form production syntax\n  (wrapped in curly braces).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333055\n", "files": ["servo/components/style/custom_properties.rs", "servo/components/style/device/gecko.rs", "servo/components/style/device/mod.rs", "servo/components/style/lib.rs", "servo/components/style/parser.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/queries/condition.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "servo/components/style/url/mod.rs", "servo/ports/geckolib/glue.rs"], "git_node": "154872461fe3040fbeef840e95d83109c0732d4c", "git_parents": ["4c0ee05cd75f3d036254adec50eed0ac0a082a1e"], "node": "4790d96ff12976ff75517ee041b0c93a51969a87", "parents": ["d3b56c2f21306e6537e788781dc103bac279ff4b"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2060857 - Add CreateGLContextANGLE() support for Android ANGLE GL r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318079\n", "files": ["gfx/gl/GLContextProviderEGL.cpp", "gfx/gl/GLContextProviderImpl.h", "gfx/gl/GLDefs.h", "gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "gfx/webrender_bindings/RenderThread.cpp"], "git_node": "2820ac6da20cfbaa03762cd8f69fcc6b50a38b66", "git_parents": ["154872461fe3040fbeef840e95d83109c0732d4c"], "node": "ae2b7b9f6080e484b66ceece38c28a967e413d28", "parents": ["4790d96ff12976ff75517ee041b0c93a51969a87"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2084036 - Migrate downloads.properties to Fluent. r=firefox-desktop-core-reviewers ,fluent-reviewers,bolsson,maxx,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336022\n", "files": ["browser/components/downloads/DownloadsCommon.sys.mjs", "browser/components/downloads/DownloadsViewUI.sys.mjs", "browser/components/downloads/content/downloads.js", "browser/components/downloads/content/downloadsPanel.inc.xhtml", "browser/components/downloads/test/browser/browser_blocked_and_deleted_status.js", "browser/extensions/newtab/lib/DownloadsManager.sys.mjs", "browser/extensions/newtab/test/jest/lib/DownloadsManager.test.js", "browser/locales/en-US/browser/downloads.ftl", "browser/locales/en-US/chrome/browser/downloads/downloads.properties", "browser/locales/jar.mn", "python/l10n/fluent_migrations/bug_2084036_downloads_properties.py"], "git_node": "5e8e06e012b3498cd9c001a48da33a64b5bd51f4", "git_parents": ["2820ac6da20cfbaa03762cd8f69fcc6b50a38b66"], "node": "cddd0ea9d18054dd015aaadfb237bd7edcaeb78b", "parents": ["ae2b7b9f6080e484b66ceece38c28a967e413d28"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084932 [Wayland] Explicitly watch for hidden VSync source when nsWindow gets expose event r=emilio,gtk-reviewers\n\nWhen nsWindow receives expose event we make it visible but VSync source may stay disabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337103\n", "files": ["widget/gtk/WaylandVsyncSource.cpp", "widget/gtk/WaylandVsyncSource.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "5ff58768d9726a3f3fed830c3b3d242140d169fd", "git_parents": ["5e8e06e012b3498cd9c001a48da33a64b5bd51f4"], "node": "4495e6065ff53f92fd004709573b71806fb6f1a7", "parents": ["cddd0ea9d18054dd015aaadfb237bd7edcaeb78b"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2085082 - [Linux][Vulkan Video] Keep DRM modifiers off distinct DPB images in ffvpx. r=stransky,media-playback-reviewers\n\nBackport FFmpeg b7e835e06913: \"Drivers needn't support modifier tiling\nfor DPB-only usage, and radv doesn't, so the pool broke\nVUID-VkImageCreateInfo-pNext-06811.\"\n\nFixes direct-export video corruption at certain resolutions, including\n144p and 720p, on AMD RDNA2 and RDNA3 GPUs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337282\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/vulkan_decode.c", "media/ffvpx/vulkan-decode-distinct-dpb-modifiers.patch"], "git_node": "c6356cadde74d4d856319802ca88b75eaf806e1e", "git_parents": ["5ff58768d9726a3f3fed830c3b3d242140d169fd"], "node": "48d821c7e055fa8192f6a814838109ee356865b6", "parents": ["4495e6065ff53f92fd004709573b71806fb6f1a7"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2086280 - [Linux][Vulkan Video] Check codec extensions before querying capabilities. r=stransky,media-playback-reviewers\n\nCheck the codec-specific extension in FFmpeg's enabled device extension\nlist before Firefox queries Vulkan video capabilities. Older drivers\nwithout VP9 support can crash in this query before FFmpeg reaches its own\nextension check.\n\nReturn NS_ERROR_NOT_AVAILABLE when the extension is missing so decoder\ninitialization falls back normally. Apply the check to H.264, HEVC, AV1,\nand VP9 without changing capability-cache behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337318\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.h"], "git_node": "a99c7acf607d75e82e4fdb3d693b61ba7906c1b0", "git_parents": ["c6356cadde74d4d856319802ca88b75eaf806e1e"], "node": "a6ea3042d6ce777f04b4a2748006668526081ca3", "parents": ["48d821c7e055fa8192f6a814838109ee356865b6"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\naf -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nan -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nar -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nast -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\naz -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbe -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbg -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbn -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbo -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbqi -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbr -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbrx -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nbs -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nca -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nca-valencia -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ncak -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nckb -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ncs -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ncy -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nda -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nde -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ndsb -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nel -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nen-CA -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nen-GB -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\neo -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nes-AR -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nes-CL -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nes-ES -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nes-MX -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\net -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\neu -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nfa -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nff -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nfi -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nfr -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nfur -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nfy-NL -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nga-IE -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ngd -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ngl -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ngn -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\ngu-IN -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nhe -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nhi-IN -\u003e 4109cb13413541b2567b0ea38ebbe9c746b42b4f\nhr -\u003e 4109cb13413541b2567b0ea38ebbe9c74