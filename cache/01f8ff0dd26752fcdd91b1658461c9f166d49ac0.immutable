ni"], "git_node": "902f84240ee9f4a1a01b290d53f24a019dd42410", "git_parents": ["f8e78474c142cb9cfc126a09abdf5cfc984dda6d"], "node": "9bffe050d585e1bac41a8518b27850e51d0ab754", "parents": ["3827b15aff0e7672f53f92efa2fad6496137c8a4"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084543 - Don't depend on testing function being passed legal bit index r=spidermonkey-reviewers,jandem\n\nThie idea is that you can call getAtomMarkIndex() to get the internal index of\nan atom and pass it to getAtomMarkColor(). But nothing stopps you making up an\nimpossible one and passing it in, resulting in an assertion failure.\n\nThe fix is to remove the assertion. I renamed the method to make it clearer\nthat it didn't expect the index of a valid atom, just an index into the bitmap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335977\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/jit-test/tests/gc/bug-2084543.js"], "git_node": "e4cd0e1315df1759f54c876e530c64de5784fccd", "git_parents": ["902f84240ee9f4a1a01b290d53f24a019dd42410"], "node": "1bc95fd303212e3b46a510d267d9e0cbb2f75901", "parents": ["9bffe050d585e1bac41a8518b27850e51d0ab754"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1863517 - Point the mach try perf category docs at classification.py. r=perftest-reviewers,fbilt\n\nThe categories moved from PerfParser in perf.py to ClassificationProvider in perfselector/classification.py.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338479\n", "files": ["testing/perfdocs/generated/mach-try-perf.md", "testing/performance/mach-try-perf/perfdocs/index.md"], "git_node": "390cc2e14ea7de63b8363d958ac0ceccfad07b7c", "git_parents": ["e4cd0e1315df1759f54c876e530c64de5784fccd"], "node": "8c093b0446b49748831e5ab6f0b57bdcf493edfb", "parents": ["1bc95fd303212e3b46a5