hangesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082109 - Hold a strong reference to SessionStorageManager in Observe. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338121\n", "files": ["dom/storage/SessionStorageManager.cpp"], "git_node": "8c48014d12d9e3ad7170b467dea355ee540dfd56", "git_parents": ["eed57099f5fd90b156725aeb1a25472dce631370"], "node": "03ea0972649576224c34bd19809259daaf475982", "parents": ["09edafd4f44481dd8cc968c97cb7b95dbbe6e86d"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081824 - [devtools] Add themes to the new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337582\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-pref.mjs", "devtools/client/settings/components/devtools-settings-theme.mjs", "devtools/client/settings/components/devtools-settings-theme.tagmap.d.ts", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/panel.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_themes.js"], "git_node": "6b41fd7b7f3c26aaa2399a9f8df0b2d92cca69d0", "git_parents": ["8c48014d12d9e3ad7170b467dea355ee540dfd56"], "node": "5140bc78cdd8eabfe6344d98cceba60cecc34af5", "parents": ["03ea0972649576224c34bd19809259daaf475982"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081846 - [devtools] Add the network body size limit to the new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337583\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-body-limit.css", "devtools/client/settings/components/devtools-settings-body-limit.mjs", "devtools/client/settings/components/devtools-settings-body-limit.tagmap.d.ts", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_netmonitor_body_limit.js", "tools/lint/fluent-lint/exclusions.yml"], "git_node": "049fd12383df263cb03747be2278f6840104ba35", "git_parents": ["6b41fd7b7f3c26aaa2399a9f8df0b2d92cca69d0"], "node": "83850b69883a89fd56815532fae925e603a527ac", "parents": ["5140bc78cdd8eabfe6344d98cceba60cecc34af5"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081863 - [devtools] Add the additional tools section to the new settings panel r=devtools-reviewers,fluent-reviewers,nchevobbe,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337784\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/inventory.mjs", "devtools/client/settings/panel.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_additional_tools.js", "devtools/client/settings/types/inventory.d.ts"], "git_node": "4f256d8dd100fdca9c7f5d170b8ce1b5a0ad621b", "git_parents": ["049fd12383df263cb03747be2278f6840104ba35"], "node": "96a91a2dd1775cc448b35c61d6d5c54d602b73b6", "parents": ["83850b69883a89fd56815532fae925e603a527ac"], "tags": []}, {"author": "Oskar Mansfeld \u003comansfeld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086705 - Add happy_eyeballs_last_answer_to_first_attempt metric. r=mxinden,acreskey,necko-reviewers,jesup\n\nThis measures the gap between the last positive answer and the first\nconnection attempt, labeled by what record type was waited on and what\nended the wait (negative entry arriving or timer running out).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337671\n", "files": ["netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/metrics.rs", "netwerk/protocol/http/metrics.yaml", "netwerk/test/unit/test_happy_eyeballs_last_answer_to_attempt.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "a7e1050d8c8abdf3e9028ee1d508f0e6d75eda45", "git_parents": ["4f256d8dd100fdca9c7f5d170b8ce1b5a0ad621b"], "node": "5e2fba58cfa36b5c5952ca99ea0ba9bf89241a12", "parents": ["96a91a2dd1775cc448b35c61d6d5c54d602b73b6"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083810 - Record semantic history distances in urlbar engagement telemetry. r=mak,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335216\n", "files": ["browser/components/urlbar/UrlbarProviderSemanticHistorySearch.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/metrics.yaml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_abandonment_groups.js", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_groups.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head-groups.js", "browser/components/urlbar/tests/unit/head.js", "browser/components/urlbar/tests/unit/test_UrlbarProviderSemanticHistorySearch.js"], "git_node": "3c6ee3e886035376f867c5657fbb89e55ac54fa8", "git_parents": ["a7e1050d8c8abdf3e9028ee1d508f0e6d75eda45"], "node": "359ee27fe1dcd6318aa962634780c87baf5c56ca", "parents": ["5e2fba58cfa36b5c5952ca99ea0ba9bf89241a12"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079689 - Ensure WeakRef targets are added to the CC graph r=mccr8,spidermonkey-reviewers,sfink\n\nWe already clear WeakRef targets for GC things that are white in the CC graph,\nbut not all GC things are represented in the CC graph and if the node is\nmissing then this check will fail. There are several reasons for GC things to\nbe missing: they might be garbage or they just might not have been considered\nby the CC.\n\nThe patch ensures WeakRef targets are present in the CC graph at the start so\nwe can get an accurate result. Only objects are added. Symbols must be used as\nWeakMap keys to be part of a gray cycle and these keys are already added to the\nCC graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337944\n", "files": ["js/public/friend/CycleCollector.h", "js/src/gc/FinalizationObservers.cpp", "js/src/gc/FinalizationObservers.h", "js/src/gc/GCRuntime.h", "xpcom/base/CycleCollectedJSRuntime.cpp"], "git_node": "55de37c0d3f09e5ac57be77b71674da9b83d2086", "git_parents": ["3c6ee3e886035376f867c5657fbb89e55ac54fa8"], "node": "7e4737ea660f707cf3025b1d6149fa2346a61cc3", "parents": ["359ee27fe1dcd6318aa962634780c87baf5c56ca"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086368 - Allow replacing a VideoBridgeChild that has not seen its channel error yet. r=gfx-reviewers,tnikkel,wsmind\n\nWhen the GPU process goes away, RDDChild and UtilityMediaServiceChild\nimmediately create a new video bridge in their OnCompositorUnexpectedShutdown\nhandlers and send the endpoint to the media process. That message and the\nchannel error of the old VideoBridgeChild arrive through different channels,\nso VideoBridgeChild::Open can run while the old bridge still reports that it\ncan send. The assertion in Open does not hold in that case.\n\nOpen already replaces the old bridge and resolves its replacement promise,\nso remove the assertion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338300\n", "files": ["gfx/layers/ipc/VideoBridgeChild.cpp"], "git_node": "a79e55cd69a1737125df94e34bbcb110c1bb7196", "git_parents": ["55de37c0d3f09e5ac57be77b71674da9b83d2086"], "node": "83a52769ae321db93cc440a1877ff88a72237668", "parents": ["7e4737ea660f707cf3025b1d6149fa2346a61cc3"], "tags": []}, {"author": "Ksenia Berezina \u003ckberezina@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087187 - Skip version bump in manifest.json for autowebcompat intervention agent; r=twisniewski,webcompat-reviewers,ai4dev-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338069\n", "files": ["browser/extensions/webcompat/AGENTS.md"], "git_node": "baf5a10048ba077b680028cdf5abfc5fa93091a2", "git_parents": ["a79e55cd69a1737125df94e34bbcb110c1bb7196"], "node": "54b6d86a7cc2d6ff443bd1639b570d4aab96cb4a", "parents": ["83a52769ae321db93cc440a1877ff88a72237668"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087278 - Keep the content area live during sidebar expand on hover view transitions r=desktop-theme-reviewers,sidebar-reviewers,emilio,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338167\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/themes/shared/sidebar.css"], "git_node": "1cdf0b9a4281fe062a1d75d4fbca270ad3e4232f", "git_parents": ["baf5a10048ba077b680028cdf5abfc5fa93091a2"], "node": "31786d5c8ecffed4f5406b6a03235e9ced57cbda", "parents": ["54b6d86a7cc2d6ff443bd1639b570d4aab96cb4a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086361 - Only release-assert on conflicting layer tree ID owners. r=gfx-reviewers,wsmind\n\nMapping a layers ID again to the same process is a no-op for the tracker and\nis harmless. The assertion now only fires when the layers ID is already owned\nby a different process, which is the case that matters for IsMapped checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338238\n", "files": ["gfx/layers/ipc/LayerTreeOwnerTracker.cpp"], "git_node": "400f2e76789a883ab434ae3bd8d9389289f1f44b", "git_parents": ["1cdf0b9a4281fe062a1d75d4fbca270ad3e4232f"], "node": "d5a08082abc1b6fa393b4fda83cbcb662dbda10b", "parents": ["31786d5c8ecffed4f5406b6a03235e9ced57cbda"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086733 - Handle a closed ImageBridgeChild in ClearImagesFromCompositable. r=gfx-reviewers,wsmind\n\nImageContainer::ClearImagesInHost goes through the current ImageBridgeChild\nsingleton, but the ImageClient's forwarder can be an older ImageBridgeChild\nthat was already closed, for example after a GPU process restart.\nImageContainer::EnsureImageClient already accounts for such stale clients.\nThere is nothing to clear on the host in that case, so return early instead of\nasserting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338239\n", "files": ["gfx/layers/ipc/ImageBridgeChild.cpp"], "git_node": "9bced9502f2582387405722b0f29f1c603c98bfe", "git_parents": ["400f2e76789a883ab434ae3bd8d9389289f1f44b"], "node": "7740e6502285424edd1f6ea364f8db49f5b399ac", "parents": ["d5a08082abc1b6fa393b4fda83cbcb662dbda10b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086944 - Drop SharedSurfacesAnimation keys of destroyed managers. r=gfx-reviewers,wsmind\n\nSharedSurfacesAnimation asserted that none of its keys belong to a destroyed\nRenderRootStateManager, relying on RenderRootStateManager::Destroy to\ninvalidate them through ClearAsyncAnimations. The animation is only\nregistered with the manager when image.animated.decode-on-demand.recycle is\nenabled, so that is not guaranteed to happen.\n\nDrop entries with a destroyed manager when iterating the keys instead, as was\ndone before bug 1504699. Their image keys are discarded along with the\nmanager's WebRender namespace, so there is nothing else to release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338240\n", "files": ["gfx/layers/ipc/SharedSurfacesChild.cpp"], "git_node": "c6f5bc91aa69b05c6d37198446dd2a0c701cc2ec", "git_parents": ["9bced9502f2582387405722b0f29f1c603c98bfe"], "node": "5e7a494740d9c213f4e1423d15bffa0bf1e90060", "parents": ["7740e6502285424edd1f6ea364f8db49f5b399ac"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087321 - Only unregister the APZCTreeManagerParent that is being destroyed. r=gfx-reviewers,wsmind\n\nContentCompositorBridgeParent::AllocPAPZCTreeManagerParent creates a dummy\nAPZCTreeManagerParent that is not stored in the LayerTreeState when the\nlayer tree has no parent compositor. When that actor is destroyed,\nDisconnectApzcTreeManager found a different (or no) registered tree manager\nand hit the release assert. Before the assert was a release assert, it would\ninstead clear whichever tree manager was registered for that layers id, which\ncould be a real one allocated later.\n\nOnly clear the registered tree manager if it is the one being destroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338241\n", "files": ["gfx/layers/ipc/CompositorBridgeParent.cpp"], "git_node": "702b52acbfe947b182babeb7321205e270e747f7", "git_parents": ["c6f5bc91aa69b05c6d37198446dd2a0c701cc2ec"], "node": "f86291292859eec4e07da5904f83e4e32fe9c7be", "parents": ["5e7a494740d9c213f4e1423d15bffa0bf1e90060"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2087401 - chore(webgpu): accept intermittents observed on patch stack base r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338288\n", "files": ["testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/command_buffer/copyTextureToTexture/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/rendering/3d_texture_slices/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/state/device_lost/destroy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupAdd/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGather/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureLoad/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSample/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleCompareLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleGrad/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/shared.https.html.ini"], "git_node": "935ef73ca9d10b1fbd9b2ae0572bff25e5f17444", "git_parents": ["702b52acbfe947b182babeb7321205e270e747f7"], "node": "a884aeb19cbca99be571a4a343ad257e68fc47d4", "parents": ["f86291292859eec4e07da5904f83e4e32fe9c7be"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2087401 - build(webgpu): update wgpu to 49325ca0a13bdc0787b1601138096cce743dd29e r=webgpu-reviewers,supply-chain-reviewers,teoxoy\n\nNew permas:\n\n- `webgpu:api,validation,compute_pipeline:overrides,workgroup_size,limits:*` now passes, but has a gap in that we're not actually enforcing anything. This will be fixed in [wgpu#9732](https://github.com/gfx-rs/wgpu/pull/9732), but for now, this `PASS`es for questionable reasons.\n- `textureSampleGrad` is \u003chttps://github.com/gfx-rs/wgpu/pull/10573\u003e.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338242\n", "files": [".cargo/config.toml.in", "Cargo.lock", "gfx/wgpu_bindings/Cargo.toml", "gfx/wgpu_bindings/moz.yaml", "gfx/wgpu_bindings/src/server.rs", "supply-chain/audits.toml", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/compute_pipeline/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleGrad/cts.https.html.ini", "third_party/rust/naga-types/.cargo-checksum.json", "third_party/rust/naga-types/src/spv.rs", "third_party/rust/naga/.cargo-checksum.json", "third_party/rust/naga/src/back/mod.rs", "third_party/rust/naga/src/back/msl/hoist.rs", "third_party/rust/naga/src/back/msl/mod.rs", "third_party/rust/naga/src/back/msl/ray.rs", "third_party/rust/naga/src/back/msl/writer.rs", "third_party/rust/naga/src/back/spv/writer.rs", "third_party/rust/naga/src/compact/functions.rs", "third_party/rust/naga/src/compact/mod.rs", "third_party/rust/naga/src/compact/statements.rs", "third_party/rust/wgpu-core-remote-types/.cargo-checksum.json", "third_party/rust/wgpu-core-remote-types/Cargo.toml", "third_party/rust/wgpu-core-remote-types/src/lib.rs", "third_party/rust/wgpu-core-remote/.cargo-checksum.json", "third_party/rust/wgpu-core-remote/Cargo.toml", "third_party/rust/wgpu-core-remote/src/global/device.rs", "third_party/rust/wgpu-core-remote/src/global/queue.rs", "third_party/rust/wgpu-core/.cargo-checksum.json", "third_party/rust/wgpu-core/src/command/clear.rs", "third_party/rust/wgpu-core/src/device/mod.rs", "third_party/rust/wgpu-core/src/device/queue.rs", "third_party/rust/wgpu-core/src/device/resource.rs", "third_party/rust/wgpu-core/src/device/stage_compiler.rs", "third_party/rust/wgpu-core/src/pipeline.rs", "third_party/rust/wgpu-core/src/resource.rs", "third_party/rust/wgpu-core/src/validation.rs", "third_party/rust/wgpu-hal/.cargo-checksum.json", "third_party/rust/wgpu-hal/src/metal/device.rs", "third_party/rust/wgpu-hal/src/metal/mod.rs", "third_party/rust/wgpu-hal/src/vulkan/conv.rs", "third_party/rust/wgpu-hal/src/vulkan/device.rs", "third_party/rust/wgpu-hal/src/vulkan/mod.rs", "third_party/rust/wgpu-types/.cargo-checksum.json", "third_party/rust/wgpu-types/src/lib.rs"], "git_node": "90b3ee75f91a6ceeb22661b25a49eefa719c927d", "git_parents": ["935ef73ca9d10b1fbd9b2ae0572bff25e5f17444"], "node": "7a67536d0904684b4156d6d225e59c531013191f", "parents": ["a884aeb19cbca99be571a4a343ad257e68fc47d4"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2087401 - chore(webgpu): accept observed intermittents in tier 3 r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338289\n", "files": ["testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupMul/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGather/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGatherCompare/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSample/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleCompareLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleLevel/cts.https.html.ini"], "git_node": "1b2799a3c77e6fa41294fa5a92b5740547b01ba8", "git_parents": ["90b3ee75f91a6ceeb22661b25a49eefa719c927d"], "node": "013aa2825709ad43b971c42a95e53b4e078776e5", "parents": ["7a67536d0904684b4156d6d225e59c531013191f"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087464 - Stop skipping remaining reftests for Android isolated process. r=media-playback-reviewers,aosmond\n\nThese tests now pass due to the NDK decoder being enabled.\n\nNote that isolated process reftests aren't currently running on CI due\nto bug 2080959.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338293\n", "files": ["dom/html/reftests/reftest.list", "dom/media/test/reftest/color_quads/reftest.list"], "git_node": "f3c4a9e505db28c574c7eaaf421ffdadeb7dc78d", "git_parents": ["1b2799a3c77e6fa41294fa5a92b5740547b01ba8"], "node": "c13a5493c47b232d03341a1a9c16ddd0c6372703", "parents": ["013aa2825709ad43b971c42a95e53b4e078776e5"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2085124 - fix actor annotations for about:studies actor to be more precise, r=beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338172\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs"], "git_node": "bbaaed7fcde973178be4fa0ccd0a4def7d4f1c27", "git_parents": ["f3c4a9e505db28c574c7eaaf421ffdadeb7dc78d"], "node": "d868d76fc71f9733f31580ad64d67d14feea50c4", "parents": ["c13a5493c47b232d03341a1a9c16ddd0c6372703"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085038 - Skip un-decodable records in SSLTokenCache.Get instead of failing r=necko-reviewers,valentin,leggert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336206\n", "files": ["netwerk/base/SSLTokensCache.cpp", "netwerk/base/SSLTokensCache.h", "netwerk/test/gtest/TestSSLTokensCache.cpp"], "git_node": "9840d93b6b65eb5acf042545b210f96adfeb731f", "git_parents": ["bbaaed7fcde973178be4fa0ccd0a4def7d4f1c27"], "node": "f61c7088bd42eb8d660e48c7263ea542651d3509", "parents": ["d868d76fc71f9733f31580ad64d67d14feea50c4"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076460 - update control center panel to pass use-design-tokens r=desktop-theme-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336798\n", "files": ["browser/themes/shared/controlcenter/panel.css", "stylelint-rollouts.config.js"], "git_node": "b258bd4a0d6ad4ef4a7a4c2d8ba1fdf952412428", "git_parents": ["9840d93b6b65eb5acf042545b210f96adfeb731f"], "node": "700debc88ca4c5f5358df3a02f9c96659dd4e27d", "parents": ["f61c7088bd42eb8d660e48c7263ea542651d3509"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 4: Fix around 60 'misc-unused-parameters' warnings under /tools r=profiler-reviewers,mstange\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nEverything found by ./mach static-analysis was manually inspected and changed if needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329493\n", "files": ["tools/power/rapl.cpp", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/core/ProfiledThreadData.cpp", "tools/profiler/core/memory_hooks.cpp", "tools/profiler/core/platform.cpp", "tools/profiler/gecko/ProfilerChild.cpp", "tools/profiler/gecko/ProfilerParent.cpp", "tools/profiler/lul/LulDwarf.cpp", "tools/profiler/lul/LulElf.cpp", "tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "138bfc6874a08a7984aaa818b8276561e02d0967", "git_parents": ["b258bd4a0d6ad4ef4a7a4c2d8ba1fdf952412428"], "node": "14a3f01c7f0f7841c16ad4b99f22383e43f2a751", "parents": ["700debc88ca4c5f5358df3a02f9c96659dd4e27d"], "tags": []}, {"author": "zhuangxiaosen \u003cxz.ganbaruibro@gmail.com\u003e", "branch": "default", "desc": "Bug 2064304 - Remove memoffset dependencies from crashreporter crates r=gsvelto,crashreporting-reviewers\n\nmozannotation_server used memoffset::offset_of; replace it with the\nstd::mem::offset_of macro (stable since Rust 1.77). process_reader\ndeclared the dependency without using it.\n\nThe vendored memoffset crate stays for now: the vendored nix crate\nstill enables it via its socket feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332338\n", "files": ["Cargo.lock", "toolkit/crashreporter/mozannotation_server/Cargo.toml", "toolkit/crashreporter/mozannotation_server/src/lib.rs", "toolkit/crashreporter/process_reader/Cargo.toml"], "git_node": "6909789b89ce10007d3631f2ff4e72ac884a574a", "git_parents": ["138bfc6874a08a7984aaa818b8276561e02d0967"], "node": "bf20fce3018b53b88ea5eee3d9c641c3c228bd63", "parents": ["14a3f01c7f0f7841c16ad4b99f22383e43f2a751"], "tags": []}, {"author": "daavoo \u003cdaviddelaiglesiacastro@gmail.com\u003e", "branch": "default", "desc": "Bug 2077648 - Show the configured custom model name in the Smart Window model picker. r=echa\n\nThe custom choice was always labelled \"Custom\", even with a model name\nconfigured. The menu now shows the full name and the button its first word,\nlike the brand names shown for preset models.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330549\n", "files": ["browser/components/aiwindow/ui/components/input-model-select/input-model-select.css", "browser/components/aiwindow/ui/components/input-model-select/input-model-select.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartbar_model_select.js"], "git_node": "58729e58d5ab6f9a00fcad372c06e575b53dd55f", "git_parents": ["6909789b89ce10007d3631f2ff4e72ac884a574a"], "node": "91d42e6fd03bd7f1e9e7b5e794ca733537143f57", "parents": ["bf20fce3018b53b88ea5eee3d9c641c3c228bd63"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087494 - Explicitly install dbus in the flatpak images. r=releng-reviewers,Eijebong DONTBUILD\n\nNewer flatpak packages only recommend a system bus, and recommends are\ndisabled in our images, but dbus.sh needs dbus-daemon.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338296\n", "files": ["taskcluster/docker/debian-flatpak/Dockerfile"], "git_node": "0906ec03098c284e4067474ef0c5c6adcbf3b934", "git_parents": ["58729e58d5ab6f9a00fcad372c06e575b53dd55f"], "node": "bf3cc47991ae952b73a67ee141c2f30edda5a456", "parents": ["91d42e6fd03bd7f1e9e7b5e794ca733537143f57"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060834 - Drop \"Learn More\" text in insecure connection autocomplete dropdown warning. r=mtigley,fluent-reviewers,credential-management-reviewers,reusable-components-reviewers,tgiles,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336237\n", "files": ["python/l10n/fluent_migrations/bug_2060834_insecure_login_warning.py", "toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_basic_form_insecure.html", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_https_downgrade.html", "toolkit/components/passwordmgr/test/mochitest/test_autocomplete_sandboxed.html", "toolkit/components/passwordmgr/test/mochitest/test_password_field_autocomplete.html", "toolkit/components/passwordmgr/test/unit/test_login_autocomplete_result.js", "toolkit/content/widgets/autocomplete-richlistitem.js", "toolkit/locales/en-US/chrome/passwordmgr/passwordmgr.properties", "toolkit/locales/en-US/toolkit/main-window/autocomplete.ftl"], "git_node": "768b56300081e8751f7c2b8728a21b2285cab403", "git_parents": ["0906ec03098c284e4067474ef0c5c6adcbf3b934"], "node": "fdcaeaeab39d81c2e8ddd6b94af43183edee601b", "parents": ["bf3cc47991ae952b73a67ee141c2f30edda5a456"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063723 - Updates the streamlined tab context menu. - Also addresses the disabled state for \"Reopen Closed Tab\" option to be singular. r=tabbrowser-reviewers,fluent-reviewers,niklas,czhou,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333234\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/customizableui/ToolbarContextMenu.sys.mjs", "browser/components/genai/GenAI.sys.mjs", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabContextMenu_altStructure.js", "browser/locales/en-US/browser/genai.ftl", "browser/locales/en-US/browser/tabContextMenu.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "9a8e9e0af8045ce33deada0b6008f6c02cc02018", "git_parents": ["768b56300081e8751f7c2b8728a21b2285cab403"], "node": "4babecef7cba2a5f73f267989d39182804746d5c", "parents": ["fdcaeaeab39d81c2e8ddd6b94af43183edee601b"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2084122 - clean up wasm::BaseCompiler::createStackMap overloads.  r=yury.\n\nBaseCompiler::createStackMap has overloads that pull the relevant offset\ndirectly from masm's current buffer offset.  Doing so is dangerous because it\nassumes no extra instructions have been inserted between the time the\nassoociated trap/call instruction has been generated, and when the buffer\noffset is read.\n\nThis changeset removes those variants and mandates passing in (preferably) a\nFaultingCodeRange or (preferably not) a CodeOffset, to specify the stackmap's\nkey.\n\nThe only affected user is BaseCompiler::insertBreakablePoint.  This now returns\na CodeOffset, as required above.  It also keys the CallSiteDesc using that same\noffset, for greater consistency and robustness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338021\n", "files": ["js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "201e914f2afa8ec55ce522f6822d283b781699a6", "git_parents": ["9a8e9e0af8045ce33deada0b6008f6c02cc02018"], "node": "1ffc08cb4f284d30ce11f061abf7904b7d8bbca2", "parents": ["4babecef7cba2a5f73f267989d39182804746d5c"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086553 - Only apply unpackColorSpace to TexImageSource uploads and pass NaN through colorspace LUT sampling. r=gfx-reviewers,wsmind\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337536\n", "files": ["dom/canvas/TexUnpackBlob.cpp", "dom/canvas/TexUnpackBlob.h", "dom/canvas/crashtests/crashtests.list", "dom/canvas/crashtests/webgl-unpack-colorspace-nan.html", "gfx/gl/Colorspaces.h"], "git_node": "a8805a886a6c3d669aabb8b362f85662eaf8c8e4", "git_parents": ["201e914f2afa8ec55ce522f6822d283b781699a6"], "node": "49468e8a5d68ca2d59636e4c1401701f84d050f3", "parents": ["1ffc08cb4f284d30ce11f061abf7904b7d8bbca2"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086652 - Updated password sidebar menu for per-device sync r=credential-management-reviewers,fluent-reviewers,bolsson,mtigley\n\nThe below tasks were created by product in [SYNC-5476](https://mozilla-hub.atlassian.net/browse/SYNC-5476)\n\n---\n\n####1. Sidebar: Remove All Passwords \u2014\u00a0Confirmation title\n\nSurface: The title in the sidebar Remove All Passwords confirmation dialog when Passwords Sync is enabled.\n\nCurrent copy:\n\n(1 password) \u201cRemove password?\u201d\n\n(2 or more passwords) \u201cRemove all {count} passwords?\u201d\n\nCWTS-specific problem: This changes copy for consistency with the proposed about:logins confirmation titles.\n\nProposed replacement:\n\n(1 password) \u201cDelete 1 password?\u201d\n\n(2 or more passwords) \u201cDelete {count} passwords?\u201d\n\n####2. Sidebar: Remove All Passwords \u2014\u00a0Deletion consequence\n\nSurface: The warning text in the same sidebar Remove All Passwords confirmation dialog when Passwords Sync is enabled.\n\nCurrent copy:\n\n(1 password) \u201cThis will remove the password saved to Firefox on all your synced devices and remove any breach alerts. You cannot undo this action.\u201d\n\n(2 or more passwords) \u201cThis will remove all passwords saved to Firefox on all your synced devices and remove any breach alerts. You cannot undo this action.\u201d\n\nCWTS-specific problem: Both singular and plural warnings promise deletion from all synced devices. With per-device CWTS, installations with Passwords Sync disabled can retain their local copies. Both variants should refer specifically to devices that sync passwords.\n\nProposed replacement:\n\n(1 password) \u201cThis deletes it from Firefox on every device that syncs your passwords. You can\u2019t undo this.\u201d\n\n(2 or more passwords) \u201cThis deletes them from Firefox on every device that syncs your passwords. You can\u2019t undo this.\u201d\n\n####3. Sidebar: Edit \u2192 Delete \u2014 Confirmation title\n\nSurface: The title in the Remove Password confirmation opened from the sidebar edit submenu.\n\nCurrent copy: \u201cRemove password?\u201d\n\nCWTS-specific problem: This changes \u201cRemove\u201d to \u201cDelete\u201d for consistency with the proposed about:logins confirmation titles.\n\nProposed replacement: \u201cDelete password?\u201d\n\n####4. Sidebar: Single-password action tooltip\n\nSurface: Single password in the sidebar password panel -\u003e Edit -\u003e Recycle bin icon tooltip .\n\nCurrent copy: \u201cRemove password\u201d\n\nProposed replacement: \u201cDelete password\u201d\n\n####5. Sidebar: Bulk-deletion menu item\n\nSurface: The sidebar password panel three-dots menu.\n\nCurrent copy: \u201cRemove all passwords\u201d\n\nProposed replacement: \u201cDelete all passwords\u201d\n\n####6. Sidebar: Remove All Passwords \u2014\u00a0checkbox text\n\nSurface: The text next to the checkbox in the sidebar Remove All Passwords confirmation dialog when Passwords Sync is enabled.\n\nCurrent copy: \u201cYes, remove password(s)\u201d\n\nProposed replacement: \u201cYes, delete password(s)\u201d\n\n####7. Sidebar: Remove All Passwords \u2014 button text\n\nSurface: \u00a0The button text in the sidebar Remove All Passwords confirmation dialog when Passwords Sync is enabled.\n\nCurrent copy: \u201cRemove\u201d\n\nProposed replacement: \u201cDelete\u201d\n\n####8. Sidebar: Edit \u2192 Delete \u2014 Confirmation title\n\nSurface: The button text in the Remove Password confirmation opened from the sidebar edit submenu.\n\nCurrent copy: \u201cRemove\u201d\n\nProposed replacement: \u201cDelete\u201d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337783\n", "files": ["browser/locales/en-US/browser/contextual-manager.ftl", "toolkit/components/satchel/megalist/aggregator/datasources/LoginDataSource.sys.mjs", "toolkit/components/satchel/megalist/content/MegalistAlpha.mjs", "toolkit/components/satchel/megalist/content/components/login-form/login-form.mjs", "toolkit/components/satchel/megalist/content/tests/browser/browser.toml", "toolkit/components/satchel/megalist/content/tests/browser/browser_passwords_per_device_sync.js", "toolkit/components/satchel/megalist/content/tests/browser/browser_viewmodel.js"], "git_node": "2abf9472c1d46931c3851b57bea24011af85231e", "git_parents": ["a8805a886a6c3d669aabb8b362f85662eaf8c8e4"], "node": "6cfc109d7f4b9b10a2b02477cbf21209b1cad864", "parents": ["49468e8a5d68ca2d59636e4c1401701f84d050f3"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087040 - Convert urlBarQuickActionsTest regression UI test to the efficiency framework r=mobiletest-reviewers,aaronmt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337943\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TextSelectionTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TextSelectionTest.kt"], "git_node": "0cac97e15c5d56714d890b53e3ae0512b3625f98", "git_parents": ["2abf9472c1d46931c3851b57bea24011af85231e"], "node": "a1b04ee33e8ed975e733d2be8ab29f4d6f795505", "parents": ["6cfc109d7f4b9b10a2b02477cbf21209b1cad864"], "tags": []}, {"author": "Jaron Kramer \u003cinfo@jkramertech.com\u003e", "branch": "default", "desc": "Bug 2075170 - Prepare pending-tab history handling and re-enable direct-load coverage. r=sessionstore-reviewers,nsharpley\n\nAdd an OnHistoryNewEntry handler that ignores active-entry reinsertion\nduring purge and defers history loads until insertion completes. Require\nsession history before starting restore and use reloadCurrentEntry().\nThe positive OnHistoryNewEntry path lands dormant and untested on current\ncentral until bug 2086636 is fixed; query loads use onStartRequest instead.\nThis partial patch does not fix the original fragment navigation issue.\n\nRe-enable browser_replace_load.js, disabled by bug 1646894, with direct\nloadURI coverage for bug 1100223 and pending-tab purge/CLEAR_HISTORY guards.\nThe rewritten test sidesteps bug 1646894's switchToTabHavingURI/remoteness\nflip from setting the selected index; it does not fix that scenario.\nKeep the fragment task explicitly skipped under bug 2086636 with its\ncontent, pending-state and 2-to-3 history assertions intact.\nBoth bug 2075170 and bug 1646894 must remain open after partial landing.\n\nUse the notification's oldIndex, implement OnHistoryTruncate, centralize\ntest preferences in add_setup and ensure asynchronous tab cleanup on errors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330164\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_replace_load.js"], "git_node": "0b31e30a26c9273f0e4373f7795a8def1cdde02a", "git_parents": ["0cac97e15c5d56714d890b53e3ae0512b3625f98"], "node": "04ac4db7e1be2a2cde9bd70c4588b7901002e37a", "parents": ["a1b04ee33e8ed975e733d2be8ab29f4d6f795505"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087393 - Use meta tag rather than magic override for theming code. r=desktop-theme-reviewers,dao\n\nNo behavior change, but less magic :)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336534\n", "files": ["browser/base/content/browser.xhtml", "docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": "15e1f5ad63ba7feefd0b353cbc6202aa2fbee808", "git_parents": ["0b31e30a26c9273f0e4373f7795a8def1cdde02a"], "node": "c473c0500b68582886668fc43b6a8e4f728a580b", "parents": ["04ac4db7e1be2a2cde9bd70c4588b7901002e37a"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087470 - Convert dismissOpenLinksInAppCFRTest regression UI test to the efficiency framework r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338287\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsAdvancedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsOpenLinksInAppsTest.kt"], "git_node": "08c08057c2315dddb5e6a98713911f0e5909048d", "git_parents": ["15e1f5ad63ba7feefd0b353cbc6202aa2fbee808"], "node": "a44656ca9f583eaee409d4714c28f0b79804a5fb", "parents": ["c473c0500b68582886668fc43b6a8e4f728a580b"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063723 - Updates the streamlined tab context menu. - Also addresses the disabled state for \"Reopen Closed Tab\" option to be singular. r=tabbrowser-reviewers,fluent-reviewers,niklas,czhou,bolsson\" for causing bc failures @ browser_tabContextMenu_altStructure.js\n\nThis reverts commit 9a8e9e0af8045ce33deada0b6008f6c02cc02018.\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/customizableui/ToolbarContextMenu.sys.mjs", "browser/components/genai/GenAI.sys.mjs", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabContextMenu_altStructure.js", "browser/locales/en-US/browser/genai.ftl", "browser/locales/en-US/browser/tabContextMenu.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "e9374561b3f9f8f57c008fc7eb10d6efaf7c74ac", "git_parents": ["08c08057c2315dddb5e6a98713911f0e5909048d"], "node": "cbb11aa3b3a5f68c1aad34416b527d7840735b1f", "parents": ["a44656ca9f583eaee409d4714c28f0b79804a5fb"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086705 - Add happy_eyeballs_last_answer_to_first_attempt metric. r=mxinden,acreskey,necko-reviewers,jesup\" for causing xpc failures @ test_happy_eyeballs_last_answer_to_attempt.js\n\nThis reverts commit a7e1050d8c8abdf3e9028ee1d508f0e6d75eda45.\n", "files": ["netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/metrics.rs", "netwerk/protocol/http/metrics.yaml", "netwerk/test/unit/test_happy_eyeballs_last_answer_to_attempt.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "921fd23c81f5ae5144305451716534aca3283914", "git_parents": ["e9374561b3f9f8f57c008fc7eb10d6efaf7c74ac"], "node": "00476fa6351f8dff1dbe6fd1f6d56268680c86e3", "parents": ["cbb11aa3b3a5f68c1aad34416b527d7840735b1f"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087448 - Create a new verifyTheExtensionSettingPageAccessedFromTheExtensionsMenuTest regression UI test r=mbarone\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nRemoved \"Bitwarden\" from the recommended add-on list because it's a not featured as a recommended extension anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338276\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/Constants.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "d1e3c0656d89b3888f86f3bf072ababf07f927a5", "git_parents": ["921fd23c81f5ae5144305451716534aca3283914"], "node": "ac5076aa48a679e27ee8a52bf774660cc0c559b1", "parents": ["00476fa6351f8dff1dbe6fd1f6d56268680c86e3"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081863 - [devtools] Add the additional tools section to the new settings panel r=devtools-reviewers,fluent-reviewers,nchevobbe,flod\" for causing dt failures @ browser_settings_netmonitor_body_limit.js\n\nThis reverts commit 4f256d8dd100fdca9c7f5d170b8ce1b5a0ad621b.\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/inventory.mjs", "devtools/client/settings/panel.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_additional_tools.js", "devtools/client/settings/types/inventory.d.ts"], "git_node": "d62ad4bbea18d222176b86643b4cedb31de0dd81", "git_parents": ["d1e3c0656d89b3888f86f3bf072ababf07f927a5"], "node": "d757bcb32ad89ab553a7cb7df7f51ebfdb1ecbfa", "parents": ["ac5076aa48a679e27ee8a52bf774660cc0c559b1"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081846 - [devtools] Add the network body size limit to the new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\" for causing dt failures @ browser_settings_netmonitor_body_limit.js\n\nThis reverts commit 049fd12383df263cb03747be2278f6840104ba35.\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-body-limit.css", "devtools/client/settings/components/devtools-settings-body-limit.mjs", "devtools/client/settings/components/devtools-settings-body-limit.tagmap.d.ts", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_netmonitor_body_limit.js", "tools/lint/fluent-lint/exclusions.yml"], "git_node": "13b794f399109fab47e6c0330fdd6382c07dbc5a", "git_parents": ["d62ad4bbea18d222176b86643b4cedb31de0dd81"], "node": "aa6e829694a7dbd308820c918f06d2a659b08da6", "parents": ["d757bcb32ad89ab553a7cb7df7f51ebfdb1ecbfa"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081824 - [devtools] Add themes to the new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\" for causing dt failures @ browser_settings_netmonitor_body_limit.js\n\nThis reverts commit 6b41fd7b7f3c26aaa2399a9f8df0b2d92cca69d0.\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-pref.mjs", "devtools/client/settings/components/devtools-settings-theme.mjs", "devtools/client/settings/components/devtools-settings-theme.tagmap.d.ts", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/panel.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_themes.js"], "git_node": "51d062d87791a9f374b3a7dbc4d607ed8942a1a2", "git_parents": ["13b794f399109fab47e6c0330fdd6382c07dbc5a"], "node": "72eaba40a7a3e7245d282ea99ac82e33bcc95b6d", "parents": ["aa6e829694a7dbd308820c918f06d2a659b08da6"], "tags": []}, {"author": "Nazeer Shaikh \u003ctheoriginalzan77@gmail.com\u003e", "branch": "default", "desc": "Bug 1957150 - Preserve runtime ping enabled flags across FOG test reset. r=chutten\n\nResetting FOG in artifact mode recreates runtime pings using the default enabled flags from jogfile.json, losing explicit setEnabled changes. Preserve those flags across runtime ping re-registration while continuing to clear metric data and server-knob overrides. Remove the repeated-enable workaround from browser_UsageTelemetry_interaction.js.\n\nTest enabled/disabled transitions, cleared data, and server-knob reset in xpcshell. A Rust factory regression registers runtime pings directly and replaces their registrations in reversed order, checking that enabled state follows ping names rather than IDs. No temporary jogfile or directory-service override is needed.\n\nValidation:\n- The production fix passed a full optimized macOS ARM64 build, eight xpcshell runs, and the complete browser interaction test in both registration modes before this test-only revision.\n- Final xpcshell test passed 13 assertions using the October 12 optimized CI binary with native registration. The unpatched artifact-mode control fails at the expected post-reset recording assertion.\n- The complete FOG Rust unit suite passed against this patch and newly generated factory/maps: 61 passed, 0 failed, 2 existing ignored, including the new regression. This uses the non-Gecko Rust test configuration. An earlier source-extracted SDK harness negative control fails when preservation is bypassed.\n- After the final review edits, the focused runtime-registration Rust regression, ESLint, Prettier, Rustfmt, and whitespace checks passed.\n\nCross-platform Try coverage remains requested because I do not have Try access.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334316\n", "files": ["browser/modules/test/browser/browser_UsageTelemetry_interaction.js", "toolkit/components/glean/api/src/factory.rs", "toolkit/components/glean/src/init/mod.rs", "toolkit/components/glean/tests/xpcshell/test_PingReset.js", "toolkit/components/glean/tests/xpcshell/xpcshell.toml"], "git_node": "d491a4f88a16f1c67a9104e001802de02c1cb331", "git_parents": ["51d062d87791a9f374b3a7dbc4d607ed8942a1a2"], "node": "1e4a82e761977f0d11cca821b1234f544f1e4e69", "parents": ["72eaba40a7a3e7245d282ea99ac82e33bcc95b6d"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2082667 - Replace the hung RDD cuda-uvmfd fd with an unarmed timerfd. r=jld,sandbox-reviewers\n\nThe brokered socket() leaves a socketpair half whose peer is already closed, so poll on that fd never sleeps. Keeping a new peer for each bind leaks a file descriptor. On bind, replace the fd with an unarmed timerfd so the wait can sleep, and do not publish the cuda-uvmfd name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334536\n", "files": ["config/system-headers.mozbuild", "security/sandbox/linux/SandboxFilter.cpp"], "git_node": "ffd9ce3b7b9aa18f1804175683c26d4ca7825373", "git_parents": ["d491a4f88a16f1c67a9104e001802de02c1cb331"], "node": "d7cb1e6799ba6068b078be97934ba281fe3295df", "parents": ["1e4a82e761977f0d11cca821b1234f544f1e4e69"], "tags": []}, {"author": "akasakariko \u003c148060537+akasakariko@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1965481 - Normalize Glean RuntimeObject serialization by omitting null and empty array members r=chutten\n\nFull builds serialize object metrics through generated Rust types that omit null and empty array object members, whereas RuntimeObject used to retain raw JSON\n\nFix: normalize RuntimeObject at serialization before storage, recursively dropping only object members whose values are null or empty arrays; retain root empty arrays, empty objects, all array elements, false, zero and empty strings\nNo new schema validation and no changes to rust.jinja2/full-build semantics\nUpdated test_Glean.js and test_JOG.js, removing old artifact-only expectations in test_BHRObserver.js and TelemetryEnvironmentTesting.sys.mjs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333957\n", "files": ["toolkit/components/backgroundhangmonitor/tests/test_BHRObserver.js", "toolkit/components/glean/api/src/private/object.rs", "toolkit/components/glean/tests/xpcshell/test_Glean.js", "toolkit/components/glean/tests/xpcshell/test_JOG.js", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs"], "git_node": "68ba7f72291a878b8c5446f1e33fa193e8a4b8d8", "git_parents": ["ffd9ce3b7b9aa18f1804175683c26d4ca7825373"], "node": "6d62085d4d76e289a802ab6e02fc66c92aa683ae", "parents": ["d7cb1e6799ba6068b078be97934ba281fe3295df"], "tags": []}, {"author": "Jonatan Wallmander \u003cjonatan.wallmander@kdab.com\u003e", "branch": "default", "desc": "Bug 2084677 - Move memory statistics gathering operation to the canvas renderer thread. r=nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337614\n", "files": ["dom/canvas/WebGLMemoryTracker.cpp", "dom/canvas/WebGLMemoryTracker.h", "dom/canvas/WebGLMemoryTrackerUsage.h"], "git_node": "ce194fb30624d1bf76be7b98fc7772c15bbcc822", "git_parents": ["68ba7f72291a878b8c5446f1e33fa193e8a4b8d8"], "node": "4aece9946ef1da1810adb988e6bd371d214242da", "parents": ["6d62085d4d76e289a802ab6e02fc66c92aa683ae"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087442 - Update aiohttp to 3.12.15 in test requirements. r=ci-and-tooling,aryx\n\naiohttp 3.7.4.post0 has no wheels for Python 3.10 and later, so test tasks\nrunning on a worker whose uv cache doesn't have a build of it yet spend 10 to\n12 seconds compiling it while creating their virtualenv. This matches the\nversion raptor already uses with condprofile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338273\n", "files": ["testing/condprofile/requirements/base.txt", "testing/config/mozbase_requirements.txt", "testing/config/requirements-android-pgo.txt", "testing/config/requirements-condprofile.txt", "testing/config/requirements-marionette.txt", "testing/config/requirements-mozbase.txt"], "git_node": "50e783d7fd76e90bcd2075f5e151c8b7dda1c1b2", "git_parents": ["ce194fb30624d1bf76be7b98fc7772c15bbcc822"], "node": "852eb8312bb7edbd45c6418a8b73f5963bb77b47", "parents": ["4aece9946ef1da1810adb988e6bd371d214242da"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084677 - Move memory statistics gathering operation to the canvas renderer thread. r=nical\" for causing lint failures & clang-tidy failures\n\nThis reverts commit ce194fb30624d1bf76be7b98fc7772c15bbcc822.\n", "files": ["dom/canvas/WebGLMemoryTracker.cpp", "dom/canvas/WebGLMemoryTracker.h", "dom/canvas/WebGLMemoryTrackerUsage.h"], "git_node": "b544de392ed16212db728f240da7905dc9637286", "git_parents": ["50e783d7fd76e90bcd2075f5e151c8b7dda1c1b2"], "node": "7f248256a501e787674ac871527e6b011828ba7c", "parents": ["852eb8312bb7edbd45c6418a8b73f5963bb77b47"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086783 - Encapsulate InlinePromiseReaction payload reads in StackPromiseReaction r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338057\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "cbf19cf2ddaefdd8840fdcda91cdf982d7c5e95b", "git_parents": ["b544de392ed16212db728f240da7905dc9637286"], "node": "0935723dd70c963d08a126f77dd791f4e8e16f99", "parents": ["7f248256a501e787674ac871527e6b011828ba7c"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079500 - Share microtask queue selection for promise jobs r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336228\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "a18a971b53860ed084e5d035b502da4f33d9f4ec", "git_parents": ["cbf19cf2ddaefdd8840fdcda91cdf982d7c5e95b"], "node": "37f2d7d3a7f85454429d47cef7570f84f7e76370", "parents": ["0935723dd70c963d08a126f77dd791f4e8e16f99"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079500 - Where possible use by-value Thenable jobs r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336229\n", "files": ["js/src/builtin/Promise.cpp", "js/src/jsapi-tests/testMicroTask.cpp", "js/src/vm/JSContext.h"], "git_node": "670488c8a6d5ae7932c41292458e6c35b081d878", "git_parents": ["a18a971b53860ed084e5d035b502da4f33d9f4ec"], "node": "af5164154d66d1d04d2d93c01f98ce7deddfbff2", "parents": ["37f2d7d3a7f85454429d47cef7570f84f7e76370"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087179 - Record markers for mach site creation and pip installs in run-task resource usage profiles. r=mach-reviewers,ahochheiden\n\nMach doesn't start a resource monitor before its command runs, so the time\nspent creating virtualenvs left an empty gap in task profiles. Forward these\nmarkers to run-task's monitor when the process has none of its own yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338079\n", "files": ["build/mach_initialize.py", "python/mach/mach/site.py", "python/mach/mach/util.py", "testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py"], "git_node": "a45c149c155bc3c0711898c520b2cd866efbdb01", "git_parents": ["670488c8a6d5ae7932c41292458e6c35b081d878"], "node": "9edea1a0e475664466b500e7e45d7e2ffb3f35ea", "parents": ["af5164154d66d1d04d2d93c01f98ce7deddfbff2"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069998 - Add strings for use with the HNT onboarding card stack message r=omc-reviewers,fluent-reviewers,bolsson,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338075\n", "files": ["browser/locales/en-US/browser/newtab/onboarding.ftl"], "git_node": "9736aa2a4199a25bede532ccdd51c910bf6d8150", "git_parents": ["a45c149c155bc3c0711898c520b2cd866efbdb01"], "node": "afcad2f93100ccb2d360d48640adbce53f618e7b", "parents": ["9edea1a0e475664466b500e7e45d7e2ffb3f35ea"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Add swapchain methods to the Compositor trait. r=gfx-reviewers,gw\n\nThe Layer configuration is driven through its own LayerCompositor trait,\nseparate from Compositor. This adds the swapchain operations it needs to\nCompositor so that a single trait can serve all configurations. The\nGecko implementation forwards to the FFI entry points that the bindings'\nlayer compositor already uses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336662\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/composite.rs"], "git_node": "33f224dd37fb905bd2dce307452711e39baed3b4", "git_parents": ["9736aa2a4199a25bede532ccdd51c910bf6d8150"], "node": "a7ebb1542c3b50a3b5a8d9d218bf653aa2c5e041", "parents": ["afcad2f93100ccb2d360d48640adbce53f618e7b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Move the Layer swapchain manager into WebRender as LayerTree. r=gfx-reviewers,gw\n\nEvery Layer embedder (the Gecko bindings and wrench) currently\nreimplements swapchain pooling, visual tree reuse and the sync commit\nheuristics. LayerTree moves that logic into WebRender, on top of the\nswapchain methods of the Compositor trait. It is not used yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336663\n", "files": ["gfx/wr/webrender/src/renderer/layer_tree.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "e245bec124ff0c6611071a273c2492cab030e1f8", "git_parents": ["33f224dd37fb905bd2dce307452711e39baed3b4"], "node": "6a8b34cd01d8453b75f9eaca3806fa6e087e6674", "parents": ["a7ebb1542c3b50a3b5a8d9d218bf653aa2c5e041"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Composite the Layer configuration through the Compositor trait. r=gfx-reviewers,gw\n\nThe renderer now owns a LayerTree and drives the Layer configuration\nthrough it, so CompositorConfig::Layer takes a regular Compositor. This\nremoves the LayerCompositor trait along with the swapchain managers in\nthe Gecko bindings and wrench.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336664\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/layer_tree.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/wrench/src/composite.cpp", "gfx/wr/wrench/src/composite.rs", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/null_compositor.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "80a2889a9a7dc55c55ba4abe37dc72bfadd4f22b", "git_parents": ["e245bec124ff0c6611071a273c2492cab030e1f8"], "node": "5cb7da057b8767dededbc26d51fe2d21cb2a2e61", "parents": ["6a8b34cd01d8453b75f9eaca3806fa6e087e6674"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Use one code path for the Draw and Layer configurations. r=gfx-reviewers,gw\n\nDraw and Layer only differ in where the composite pass renders: into the\nmain framebuffer or into one swapchain per layer. Branch on that\n(LayerMode) instead of on the compositor kind, and route the Draw\nconfiguration's damage region and end of frame through LayerTree too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336665\n", "files": ["gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/layer_tree.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "990858fc1703de82f2fb9ef077182feda7a00515", "git_parents": ["80a2889a9a7dc55c55ba4abe37dc72bfadd4f22b"], "node": "1707ae55ad124854cb15ba54fb78dd0f06336fed", "parents": ["5cb7da057b8767dededbc26d51fe2d21cb2a2e61"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087393 - Use meta tag rather than magic override for theming code. r=desktop-theme-reviewers,dao\" for causing mochitest failures @ test_emulate_color_scheme.html\n\nThis reverts commit 15e1f5ad63ba7feefd0b353cbc6202aa2fbee808.\n", "files": ["browser/base/content/browser.xhtml", "docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": "c6d2f30fe4af117f3f793c5bdc8ecc325025cda3", "git_parents": ["990858fc1703de82f2fb9ef077182feda7a00515"], "node": "9eee9262f8ac9463e203d75456d297db7382dc2d", "parents": ["1707ae55ad124854cb15ba54fb78dd0f06336fed"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2086860 - Show the homepage middle search bar in landscape r=android-reviewers,devota\n\n- The search bar was limited to portrait, but the toolbar still hid the address bar in landscape, leaving no way to search.\n- searchBarEnabled now uses isHomepageMiddleSearchEnabled so the search bar will be visible in landscape.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338124\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt"], "git_node": "92d718e3ec00bdf8a4d4593ed5b1b0a89509152a", "git_parents": ["c6d2f30fe4af117f3f793c5bdc8ecc325025cda3"], "node": "fcfa078120438aec30b104635114de60e6265517", "parents": ["9eee9262f8ac9463e203d75456d297db7382dc2d"], "tags": []}, {"author": "Oskar Mansfeld \u003comansfeld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086705 - Add happy_eyeballs_last_answer_to_first_attempt metric. r=mxinden,acreskey,necko-reviewers,jesup\n\nThis measures the gap between the last positive answer and the first\nconnection attempt, labeled by what record type was waited on and what\nended the wait (negative entry arriving or timer running out).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337671\n", "files": ["netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/metrics.rs", "netwerk/protocol/http/metrics.yaml"], "git_node": "824d0e85622653a721c6f985895f1286833123b2", "git_parents": ["92d718e3ec00bdf8a4d4593ed5b1b0a89509152a"], "node": "9ef9cfb456af11533c37775b44885dfaf1495c40", "parents": ["fcfa078120438aec30b104635114de60e6265517"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072850 - Validate that saved tab groups are retained when about:sessionrestore is opened r=sessionstore-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336492\n", "files": ["browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_restore_saved_tab_groups.py"], "git_node": "5e4017bde9b1a8819721745f47e2350b2e81f0ae", "git_parents": ["824d0e85622653a721c6f985895f1286833123b2"], "node": "bd93e633026ea43577be3d7290a966b9738b212c", "parents": ["9ef9cfb456af11533c37775b44885dfaf1495c40"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080907 - Add a duration metric for each migration resource. r=jhirsch,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335720\n", "files": ["browser/components/migration/MigratorBase.sys.mjs", "browser/components/migration/metrics.yaml", "browser/components/migration/tests/unit/test_fx_telemetry.js"], "git_node": "8036d2348e7edf6b08ca0f2a98450c88f4cdb596", "git_parents": ["5e4017bde9b1a8819721745f47e2350b2e81f0ae"], "node": "4ecf99909d14dc25d0dc03cffb16758f4c64578f", "parents": ["bd93e633026ea43577be3d7290a966b9738b212c"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084235 - Forward HNT card stack click telemetry with screen and button context. r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337127\n", "files": ["browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/docs/asrouter-newtab-multistage-message.md", "browser/components/asrouter/tests/browser/browser_asrouter_newtab_multistage_messages.js"], "git_node": "413d34c35dc47fe503c9b2a2ebbc890737c7da72", "git_parents": ["8036d2348e7edf6b08ca0f2a98450c88f4cdb596"], "node": "0c40f61e0c3c3a3dbbae398822eb772309c65f02", "parents": ["4ecf99909d14dc25d0dc03cffb16758f4c64578f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2087467 - [loong64] Switch to sign-extending tag extraction. r=spidermonkey-reviewers,iain\n\nThis pattern is already used by ARM64 and RISCV64. Similar to these two\narchitectures, Loong64 can only load small signed immediates in 1\ninstruction as well, so this optimization is beneficial.\n\nThis shortens each tag extraction by 1 instruction.\n\nBefore:\n\n        srli.d       $t6, $a2, 0x2f\n        lu12i.w      $t7, 31\n        ori          $t7, $t7, 0xff4\n        beq          $t6, $t7, 1116 -\u003e [...]\n        bge          $zero, $zero, 8 -\u003e [...]\n        nop\n\nAfter:\n\n        srai.d       $t6, $a2, 0x2f\n        addi.w       $t7, $zero, -12\n        beq          $t6, $t7, 1108 -\u003e [...]\n        bge          $zero, $zero, 8 -\u003e [...]\n        nop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338290\n", "files": ["js/src/jit/MIROps.yaml", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "2ac88440d82141c9cb600201bda2a825b3ab0980", "git_parents": ["413d34c35dc47fe503c9b2a2ebbc890737c7da72"], "node": "b747eec2a175e267bf8c3cf580ab95c59151c696", "parents": ["0c40f61e0c3c3a3dbbae398822eb772309c65f02"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2087434 - [loong64] Test for null or undefined with one tag compare. r=iain\n\nThis saves one branch for each such check, for example in the following\nsnippet:\n\n        function f(x) {\n          return x ? 1 : 2;\n        }\n        for (let i = 0; i \u003c 20000; i++) {\n          f((i & 1) ? null : 3);\n        }\n\nBefore:\n\n        [...]\n        ld.d         $a2, $fp, 40\n        srai.d       $t6, $a2, 0x2f\n        addi.w       $t7, $zero, -12\n        beq          $t6, $t7, 752 -\u003e [...]\n        bge          $zero, $zero, 8 -\u003e [...]\n        nop\n        addi.w       $t7, $zero, -10\n        beq          $t6, $t7, 736 -\u003e [...]\n        bge          $zero, $zero, 8 -\u003e [...]\n        nop\n        [...]\n\nAfter:\n\n        [...]\n        ld.d         $a2, $fp, 40\n        srai.d       $t6, $a2, 0x2f\n        srai.d       $t7, $t6, 0x2\n        addi.d       $t7, $t7, 3\n        beqz         $t7, 736 -\u003e [...]\n        bge          $zero, $zero, 8 -\u003e [...]\n        nop\n        [...]\n\n(Note that here $t6 is reused for subsequent tag checks.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338291\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "2382a4b06f4778ff6f158a0cc03e521195940ff4", "git_parents": ["2ac88440d82141c9cb600201bda2a825b3ab0980"], "node": "349bde5fb130ab27b78ba8412304d6438515f94b", "parents": ["b747eec2a175e267bf8c3cf580ab95c59151c696"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087200 - Reject iframe traverseTo() promises when the traversable's navigate event is canceled. r=farre\n\nA canceled traverse navigate event of the traversable rejects the\npending traversals of its subframes with an AbortError, as the spec\ndoes for a canceled beforeunload. An intercepted one still resumes the\ntraversal and leaves them pending.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338110\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsIDocumentViewer.idl", "docshell/shistory/nsSHistory.cpp", "dom/ipc/DocShellMessageUtils.h", "dom/navigation/Navigation.cpp", "dom/navigation/Navigation.h", "testing/web-platform/meta/navigation-api/navigate-event/navigation-traverseTo-in-iframe-same-document-preventDefault.html.ini", "testing/web-platform/tests/navigation-api/navigate-event/navigation-traverseTo-in-iframe-same-document-preventDefault-then-retry.html"], "git_node": "0831b60ce950c2c733f2a0164b1083d74807808f", "git_parents": ["2382a4b06f4778ff6f158a0cc03e521195940ff4"], "node": "e886ae664b8cf7b47f690f1282e0b6ca9bb93e03", "parents": ["349bde5fb130ab27b78ba8412304d6438515f94b"], "tags": []}, {"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087534 - Stop prompting for the primary password at startup to migrate logins after it was canceled a configurable number of times. r=joschmidt,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338328\n", "files": ["modules/libpref/init/all.js", "toolkit/components/passwordmgr/LoginStorageMigrator.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/unit/test_LoginStorageMigrator.js"], "git_node": "49010896be2086848ef447913dd368ee363994bb", "git_parents": ["0831b60ce950c2c733f2a0164b1083d74807808f"], "node": "331eaf7d4dd6d251e4375cdb3c12c04131dac10e", "parents": ["e886ae664b8cf7b47f690f1282e0b6ca9bb93e03"], "tags": []}, {"author": "Christoph Anton Mitterer \u003cmail@christoph.anton.mitterer.name\u003e", "branch": "default", "desc": "Bug 2025220 - Export reopen last tab of current window as a configurable keyboard shortcut. r=sessionstore-reviewers,fluent-reviewers,bolsson,sfoster\n\nFirefox 116.0 changed[0] the then long standing behaviour of how closed tabs are\nre-opened using (per default Ctrl-Shift-T) from re-opening the last closed tab\nof the current window, to re-opening the last closed tab of all windows.\n\nThis commit exports the previous behaviour as a configurable keyboard shortcut\nvia `about:keyboard`, leaving the post-116.0 behaviour as default while allowing\nusers to easily revert.\n\n[0] Commit a0b6ef95d9656fb5332a5420a1663ccb789e6785\n(\u201cBug 1833416 - modify undoClosedTab keyboard shortcut\u201d)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336869\n", "files": ["browser/base/content/browser-sets.inc.xhtml", "browser/components/customkeys/CustomKeysParent.sys.mjs", "browser/locales/en-US/browser/customkeys.ftl"], "git_node": "b48a5620a933973384166428c134af07f5abbe51", "git_parents": ["49010896be2086848ef447913dd368ee363994bb"], "node": "716c43e78abec43488403cf6f85d40fbbabf4d29", "parents": ["331eaf7d4dd6d251e4375cdb3c12c04131dac10e"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2087445 - [riscv64] Test for null or undefined with one tag compare. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338295\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64-inl.h"], "git_node": "0eda5305d3bb28f07f7e2322275e091536735d7a", "git_parents": ["b48a5620a933973384166428c134af07f5abbe51"], "node": "05459dcdb5fac4434d8c3775be20e780a02955d9", "parents": ["716c43e78abec43488403cf6f85d40fbbabf4d29"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2049407 Part 2 - explanation r=emilio DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308289\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "d4d209d1b3103c997105ac486b1ac59cc78827f9", "git_parents": ["0eda5305d3bb28f07f7e2322275e091536735d7a"], "node": "687f92249edad3c7a95bbc0c2f0f5e4e79b744a8", "parents": ["05459dcdb5fac4434d8c3775be20e780a02955d9"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2056792 part 2 - more comments r=dholbert,firefox-svg-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314693\n", "files": ["dom/svg/DOMSVGLength.cpp", "dom/svg/DOMSVGNumber.cpp", "dom/svg/DOMSVGPoint.cpp", "dom/svg/DOMSVGTransform.cpp"], "git_node": "ab61d4f0f4cbf8a3f1b468d584e830b682465327", "git_parents": ["d4d209d1b3103c997105ac486b1ac59cc78827f9"], "node": "56ea1f324a7fee7626c70c291dd3e89a86cccb56", "parents": ["687f92249edad3c7a95bbc0c2f0f5e4e79b744a8"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085942 - Add a secret setting and nimbus flag for search-config-v3 on Focus r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338292\n", "files": ["mobile/android/focus-android/app/nimbus.fml.yaml", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/settings/advanced/SecretSettingsFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/utils/Settings.kt", "mobile/android/focus-android/app/src/main/res/values/preference_keys.xml", "mobile/android/focus-android/app/src/main/res/values/static_strings.xml", "mobile/android/focus-android/app/src/main/res/xml/secret_settings.xml"], "git_node": "3eec566d9ec70ff8ced9e22967cf6295940c2037", "git_parents": ["ab61d4f0f4cbf8a3f1b468d584e830b682465327"], "node": "16508a81d64618143174890d0819d112f67c082e", "parents": ["56ea1f324a7fee7626c70c291dd3e89a86cccb56"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053229 - Fix New sidebar: [a11y] Focus not returned after dismissing panel r=sidebar-reviewers,nsharpley\n\nStore the latest node that was used to open a sidebar panel. If it is later dismissed by the close button with the keyboard, restore focus to that node. Falls back to the active button-group item if that node is no longer available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337111\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/sidebar/tests/browser/browser_a11y_sidebar.js"], "git_node": "ca21be768f9e5460998895c0787bc0c4e6d4614f", "git_parents": ["3eec566d9ec70ff8ced9e22967cf6295940c2037"], "node": "378af3c3386315a7c298b4e65bc2b43c47cb572b", "parents": ["16508a81d64618143174890d0819d112f67c082e"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085952 - Prevent background extensions from changing the header of other panels. r=sidebar-reviewers,nsharpley\n\nBug 2078028 made `_setExtensionAttributes` set `panelHeader.heading` without checking which panel the header shows. So when any sidebar extension was installed, or called setTitle/setIcon/setPanel, its title replaced the header of whatever panel was open.\n\nNow the heading is only updated when the extension is active. When another panel is opened, `setView()` already recomputes the heading from `sidebar.label`, so the updated title still shows when the extension's panel is next opened.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337616\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js"], "git_node": "95df25dce7dc047e0789777461ce8f779e06c4d3", "git_parents": ["ca21be768f9e5460998895c0787bc0c4e6d4614f"], "node": "d6364e440fd45d3c1922d793e315a7dd5352e782", "parents": ["378af3c3386315a7c298b4e65bc2b43c47cb572b"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082902 - Remove browser.nova.enabled=false coverage from about:addons tests. r=willdurand\n\nDepends on D333674\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335119\n", "files": ["browser/app/profile/firefox.js", "toolkit/mozapps/extensions/test/browser/browser_html_linux_theme_colors_checkbox.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view_recommendations.js", "toolkit/mozapps/extensions/test/browser/browser_html_themes_mode.js", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js", "toolkit/mozapps/extensions/test/browser/browser_verify_l10n_strings.js"], "git_node": "4a263698cee9ff40c2948b5eaf1ac81a8027086e", "git_parents": ["95df25dce7dc047e0789777461ce8f779e06c4d3"], "node": "a47b953685639d5d81a9fb783e892d48cbb758d6", "parents": ["d6364e440fd45d3c1922d793e315a7dd5352e782"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082885 - Remove browser.nova.enabled=false coverage from WebExtensions browser tests. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335120\n", "files": ["browser/components/extensions/test/browser/browser_ext_popup_corners.js", "toolkit/components/extensions/test/browser/browser_ext_management_themes.js", "toolkit/components/extensions/test/browser/browser_ext_themes_autocomplete_popup.js", "toolkit/components/extensions/test/browser/browser_ext_themes_dynamic_updates.js", "toolkit/components/extensions/test/browser/browser_ext_themes_multiple_backgrounds.js", "toolkit/components/extensions/test/browser/browser_ext_themes_pbm.js", "toolkit/components/extensions/test/browser/browser_ext_themes_separators.js", "toolkit/components/extensions/test/browser/browser_ext_themes_sidebars.js", "toolkit/components/extensions/test/browser/browser_ext_themes_toolbar_fields_focus.js"], "git_node": "cae94feb75f6dee83b5789169afc96cace57772c", "git_parents": ["4a263698cee9ff40c2948b5eaf1ac81a8027086e"], "node": "20b84be67ae6ca700476b6e2ea1a69c61cda26b7", "parents": ["a47b953685639d5d81a9fb783e892d48cbb758d6"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082885 - Remove browser.nova.enabled=false coverage from contextual identities xpcshell test. r=baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335121\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_contextual_identities.js"], "git_node": "57bc044897897e3f5ab2cd4d2474928906611c63", "git_parents": ["cae94feb75f6dee83b5789169afc96cace57772c"], "node": "24f2970240bd76a35c07bb83409c4b7873a150f0", "parents": ["20b84be67ae6ca700476b6e2ea1a69c61cda26