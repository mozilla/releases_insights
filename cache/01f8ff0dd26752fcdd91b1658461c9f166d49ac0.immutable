ser/base/content/browser.xhtml", "browser/components/customizableui/CustomizeMode.sys.mjs"], "git_node": "3b7009bca5215e7be9fcd97210944a4e3821e9f3", "git_parents": ["5fbdc0a151f30a779dadf250101485dff782fd10"], "node": "14660496acc248f5515ee879106c505abb11ce94", "parents": ["617426f66ed59c9b8604ac021430b99d856105d2"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082906 - remove browser.nova.enabled=false coverage in browser_popup_new_window_size.js r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336886\n", "files": ["browser/base/content/test/browser-popups/browser_popup_new_window_size.js"], "git_node": "5e83396e179c2df2fe9c7f6d25b588feac58bd85", "git_parents": ["3b7009bca5215e7be9fcd97210944a4e3821e9f3"], "node": "e93df77b9ecde4f12b54d049a5cd60a940a2815f", "parents": ["14660496acc248f5515ee879106c505abb11ce94"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings mobile-experiments mobile-merino-manifest ct-logs r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337275\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": "372ccf9f01b06e6c7fd871a1d76101cf5eecad0f", "git_parents": ["5e83396e179c2df2fe9c7f6d25b588feac58bd85"], "node": "537dd16744d30ed4d0e5a181c65bb1053cea947b", "parents": ["e93df77b9ecde4f12b54d049a5cd60a940a2815f"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084814 - Crossword: Add the Powered by Particle menu string r=fluent-reviewers,bolsson\n\nAdds the string for Crossword\u2019s link to its content provider, Particle. The next patch in the stack uses it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336946\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "89415c1695a2dce8bac4ede24d1e095ec49a725d", "git_parents": ["372ccf9f01b06e6c7fd871a1d76101cf5eecad0f"], "node": "d2755d7b2cae19f739b5cbf116d5247529a6c4c9", "parents": ["537dd16744d30ed4d0e5a181c65bb1053cea947b"], "tags": []}], "date": 1793160617, "git_changesets": ["74cf16c3e770ab326787667fb5017955b9bbb618", "d6bbcc57b778f985faf1f6cf9945c2bcb16c63d1", "825419279961afeda2ed7cdeaf29d6e7876b4873", "f4d41414e3b273aba79a6fb78ef1700abd313da0", "409a149b1a6b552a335399ebdab74ed323cfe5eb", "47ab9b4d737c35dc639db4df9f463b7f716f61a3", "8c6dae23625fbef2f3d2380bc5d560398a552de5", "4c113413b2431ab034e0cc757f0d8d2d1416a274", "94e72707c96ab9b45151a5296fcfebfa6250c9e2", "f57e5476ea7b06c807b918aafadd7fbcd89fa5cb", "42f9d6f6deb6be0647ac818a1342b3d800bb6649", "cb3f9dbf4d1293b58ea377688e48a0484d78ac38", "2ef7a956c8b6de978fa07a367b7392f5c8a777d7", "a04a7da9af376cd019b942d41ffb1d1f40f2a1c3", "fe230632b5851fd9900434e068a0994cb869a99a", "1c2fdfccf0410018ef38eded32af9db3f3cb748e", "8fdf94fa666b8f0b34206bf160b15bfe84117434", "31481cf5b084cf49856ac8ea211fc169d7840dbb", "5d0b2517f79af354375f273f0f3b4c6b41af82e8", "baa91290f0f291a02c56a2546aeaf93a9f0ec14c", "194f927159a0c199269c32eb0db237ed4aa1c1cd", "1e6145f049667d060c1ac5064ff674551a955608", "ca953e586d4a46b6b632e799feeb7090327d4fcd", "e8d520089740819c2fd957cc6d58ef09b1d0e102", "b3e2399193457e8a3185118148895e9f2f87a472", "ef97d0cba6f43fc2d9ce0ee3568fb61c54a57411", "9a05376372bffabaabc90ccc11e20dbe2c83f660", "08b8413aa1e0bafce59608b08cc7b3c37b85c927", "b7588bd40957ac03ffa3454e0c5b4fe2cd1214e1", "1cdd78167e50fcc0d538de1d35a0361f86f88174", "41165a77b220a028594d5d50b779786e6d95bcc0", "7ff6e61fe6b8a0f7bd9f2272eb8f78654fe2f9b7", "45ce2e53f20f6059f2f3a34d03bdca259f6473a9", "5be238d8209c3a494c91f195d7e7f455070a2bfd", "6f77b3edb2b0aeccbb9c2c0667e4af7a40810261", "6db3e1bf215e472867bc2442dd46b1e5c84f0f94", "afe8545a2c15608e3fc098f6af418a081af0f4e1", "381bb5936e126913a9900444f81489be51097fe9", "157c0d85b569ac7c548a51669c5510e482caddd5", "ef2bb06e09cab08ca146698a6809beec4503d072", "663d67d0a28f80d0987b6f65572996a31e1a1d69", "e1641efdad6802e24d02e7beefee691cbdbb9fa5", "e278bc46d21c4dc18f2572ba753df8246beab7d3", "917ca3c59bc0f9648e11a7337de7d4138316f5aa", "b98d8535259841455c95b1148abb353168421b6c", "bea55255d5950e463fa0cda1bdafeaa74d4bcc81", "d96b5a3cdc48c4f93f0ec3394f2fa5d6fecc365f", "5a39ae6d8f22fb6d26dc3b10de3f8e78f1fd6d6a", "fd3ebb9d419066273898a0bb2c993632b4a58a6a", "b7cd526e59b2fe123f7330824ba5b1602df3b3d7", "610c98c34f7cb40b61db390d2d5d3b1deaf20026", "d2c4a1e2d32d3be519822ffbf141ffdbe1de01f3", "0b8de9789e84035be6aace4e5521d0e21ec48519", "649331170af6b3c41773e9bc2ae17196dd0c4489", "15ba4d2b6a4a55e911095b5eb7abe334be83674e", "0437f8c0df6c26edf6c7be3cba1207eb431ede09", "5fbdc0a151f30a779dadf250101485dff782fd10", "3b7009bca5215e7be9fcd97210944a4e3821e9f3", "5e83396e179c2df2fe9c7f6d25b588feac58bd85", "372ccf9f01b06e6c7fd871a1d76101cf5eecad0f", "89415c1695a2dce8bac4ede24d1e095ec49a725d"], "user": "rperta@mozilla.com"}, "45661": {"changesets": [{"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085898 - Update irregexp to 313f3ab0d6063f3e5af9eaf88fa1e1c66c94e222 r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336879\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/moz.yaml"], "git_node": "85e60c0aca4f0775711773b42349ced21fa99738", "git_parents": ["89415c1695a2dce8bac4ede24d1e095ec49a725d"], "node": "33841a7a131660f2ffc7fc1688380ddd53072dd5", "parents": ["d2755d7b2cae19f739b5cbf116d5247529a6c4c9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085371 - Remove the VisibleForTesting annotation from FxaAccountManager.serverConfig. r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336393\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt"], "git_node": "c3f1372de02847d33a344689e33a70128b9e634a", "git_parents": ["85e60c0aca4f0775711773b42349ced21fa99738"], "node": "e056db4b119ac3a9a83f76e279da2ef6d08c9134", "parents": ["33841a7a131660f2ffc7fc1688380ddd53072dd5"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2085288. Don't abort mach vendor over a removed file that no moz.build mentions. r=tjr\n\nWhen an update removes a file of a type moz.build tracks but that no moz.build\nlists, such as cairo 1.18.6 removing win32/d2d1-extra.h, update_moz_build\nreports \"Could not remove ... from the appropriate moz.build file\" and exits\nwith 255 even though there is nothing to change. Bug 2062116 made it stop\nerroring when upstream removes a file of a type that isn't normally tracked in\nmoz.build.\n\nA file that a moz.build does mention, but in a list we can't edit (like\nSOURCE_HEADERS in gfx/cairo/cairo/src/moz.build), still aborts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336347\n", "files": ["python/mozbuild/mozbuild/test/test_rewrite_mozbuild.py", "python/mozbuild/mozbuild/test/vendor/test_vendor_manifest.py", "python/mozbuild/mozbuild/vendor/rewrite_mozbuild.py", "python/mozbuild/mozbuild/vendor/vendor_manifest.py"], "git_node": "aba36eeda23862776ef38639539d8a9c5f57a5f2", "git_parents": ["c3f1372de02847d33a344689e33a70128b9e634a"], "node": "01d5e569ea2c4621bd1df449d6d4d8b5ed0ad2ed", "parents": ["e056db4b119ac3a9a83f76e279da2ef6d08c9134"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084560. Fix libyuv link failure on 32-bit x86 non-Windows builds. r=ng\n\nSince the update to 9456b062, libyuv implements the transpose functions for\n32-bit x86 only in rotate_win.cc, on any OS and compiler. But libyuv.gyp sets\nchromium_code, which pulls in filename_rules.gypi, and that excludes *_win.cc\non non-Windows. Upstream's GN and CMake builds compile these files everywhere\nand rely on their #if guards, so we do the same.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335939\n", "files": ["media/libyuv/05_include_win_sources_on_all_platforms.patch", "media/libyuv/libyuv/libyuv.gyp", "media/libyuv/moz.yaml"], "git_node": "e141adc070277444f0d8131c75e43e77e8101f32", "git_parents": ["aba36eeda23862776ef38639539d8a9c5f57a5f2"], "node": "189ca82e3e7aae4df3f96f5cdedb28ea6f5860be", "parents": ["01d5e569ea2c4621bd1df449d6d4d8b5ed0ad2ed"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072714 - Update inline padding for edge elements in the toolbar/tabstrip and update sidebar tool buttons to be 28x28 in compact mode r=desktop-theme-reviewers,sidebar-reviewers,nsharpley,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333826\n", "files": ["browser/components/customizableui/test/browser_hidden_widget_overflow.js", "browser/components/sidebar/sidebar-main.css", "browser/themes/shared/browser-shared.css", "browser/themes/shared/sidebar.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "81b3307b50923020ebdce062ca5b185f59c2c934", "git_parents": ["e141adc070277444f0d8131c75e43e77e8101f32"], "node": "2e46f1da28a95ad155e42eaf400e9478fcf1bbf7", "parents": ["189ca82e3e7aae4df3f96f5cdedb28ea6f5860be"], "tags": []}, {"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073606 - Add a setting to allow website notifications while Firefox is closed. r=settings-reviewers,fluent-reviewers,desktop-theme-reviewers,akulyk,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336747\n", "files": ["browser/components/preferences/dialogs/sitePermissions.css", "browser/components/preferences/dialogs/sitePermissions.js", "browser/components/preferences/dialogs/sitePermissions.xhtml", "browser/components/preferences/tests/permissions/browser_permissions_dialog.js", "browser/locales/en-US/browser/preferences/permissions.ftl"], "git_node": "68d4839b23c20e92211e0d5e5624b95ab677a106", "git_parents": ["81b3307b50923020ebdce062ca5b185f59c2c934"], "node": "05db60ed06ecf593a991ca04d06d6d336cef76e0", "parents": ["2e46f1da28a95ad155e42eaf400e9478fcf1bbf7"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085832 - Rename InlinedZeroField to InlinedField r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336818\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/Parser.cpp", "js/src/frontend/Parser.h", "js/src/frontend/SharedContext.h", "js/src/vm/SharedStencil.h"], "git_node": "2747f1441ea197a2f5bed6eb9878b7d84e6b1dc8", "git_parents": ["68d4839b23c20e92211e0d5e5624b95ab677a106"], "node": "e9f98430083535d23414b4b59db09b0872c21f89", "parents": ["05db60ed06ecf593a991ca04d06d6d336cef76e0"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081303 - Normalize IPP site rule origins to https without www r=ip-protection-reviewers,settings-reviewers,Gijs\n\nSite rules were keyed on the exact origin, so http://www.example.com and\nhttps://example.com were separate rules. While the site inclusions feature is\non, rules are now stored on the https origin without a leading www.\n\nStored rules are normalized once, the first time the feature is seen on. The\ngeneric permissions dialog still writes exact origins while it is off, so\nturning it off clears the marker and the pass runs again on the next enable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334358\n", "files": ["browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules.js", "toolkit/components/ipprotection/IPPSiteRuleProviders.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPPPermissionRuleProvider.js"], "git_node": "77a07c868b499605b25d5ac20f91ac42d2b69e4a", "git_parents": ["2747f1441ea197a2f5bed6eb9878b7d84e6b1dc8"], "node": "353df0a7093aa42d1b0d34b27b34b683c3229d9e", "parents": ["e9f98430083535d23414b4b59db09b0872c21f89"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069166 - Turn the text selection menu off when every action is turned off. r=fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,yjamora,nsharpley,emilio,bolsson\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nTurning off the last action in the three-dot menu now shows a notice, and the menu turns off when the three-dot menu closes. While it is off, a \"Turn On Actions Menu\" item in the context menu of a selection turns it back on with every action and shows it over the selection.\n\nTo try it manually: flip `browser.highlightToSearch.featureGate` on, select text on a page, open the three-dot menu and turn off every action. A notice appears. Click outside the three-dot menu and the menu goes away. Then select text again and right-click it to find \"Turn On Actions Menu\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335857\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_contextmenu.js", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/locales/en-US/browser/browserContext.ftl", "browser/locales/en-US/browser/genai.ftl", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "730aa227a4f9f27cf1a32d4c235a1fb7ac395b02", "git_parents": ["77a07c868b499605b25d5ac20f91ac42d2b69e4a"], "node": "615e4b5a4470f714d3d9afcf8b56ea0b6bbe01c2", "parents": ["353df0a7093aa42d1b0d34b27b34b683c3229d9e"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085898 - Update irregexp to 313f3ab0d6063f3e5af9eaf88fa1e1c66c94e222 r=iain\" for causing build bustages @regexp-interpreter.cc.\n\nThis reverts commit 85e60c0aca4f0775711773b42349ced21fa99738.\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/moz.yaml"], "git_node": "eeba0041cdb47d4b1bf8a37e5b18928b5f22681b", "git_parents": ["730aa227a4f9f27cf1a32d4c235a1fb7ac395b02"], "node": "273282baf05a0f8d97506d153315c59f7b8fa867", "parents": ["615e4b5a4470f714d3d9afcf8b56ea0b6bbe01c2"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080961 - Record a telemetry event with the outcome of the session restore at startup. r=sessionstore-reviewers,jswinarton\n\nA new startup_session_outcome event records what came of the startup_session_decision, one of:\n- the session was restored\n- held back for a later window\n- had no windows to open\n- there was nothing to restore\nThe event is recorded once when that first restore completes, so a missing event means startup never got that far.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333943\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/metrics.yaml", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_session_availability.py", "browser/components/sessionstore/test/marionette/test_session_decision.py", "browser/components/sessionstore/test/marionette/test_session_outcome.py", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "900dcf2786947a5c252675e263e63f8c61c9e5d0", "git_parents": ["eeba0041cdb47d4b1bf8a37e5b18928b5f22681b"], "node": "8662f11772d657e6fb6dc9f097a85b31962b9ba9", "parents": ["273282baf05a0f8d97506d153315c59f7b8fa867"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085938 - Remove non-Firefox tp6 desktop tests. r=perftest-reviewers,sparky,taskgraph-reviewers,bhearsum\n\nNobody is actively tracking tp6 chrom* tests and they don't give us much\nvalue. Lots of them also record black screens intermittently, so they\njust burn CI time. This patch removes it with an estimated savings of\n~150 to 180 hours / month of hardware time\n\nAdditionally, dead safari tp6 config is also removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337265\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/tp6/desktop/browsertime-tp6.toml", "testing/raptor/raptor/tests/tp6/live/browsertime-live.toml"], "git_node": "d9aba54df3cb0aba6be0fe506ff4f5f89069f698", "git_parents": ["900dcf2786947a5c252675e263e63f8c61c9e5d0"], "node": "e89e18b635af727aed8dfa85c35ef9f9abf2d4ec", "parents": ["8662f11772d657e6fb6dc9f097a85b31962b9ba9"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054920 - Turn off pull-to-refresh on PDFs r=android-reviewers,jonalmeida\n\nPatch changes:\n* Does a minor refactor to move the fullscreen check from the browser fragment to the feature.\n* Checks if the page is a PDF or fullscreen to decide if the feature should be enabled or not\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336876\n", "files": ["mobile/android/android-components/components/feature/session/src/main/java/mozilla/components/feature/session/SwipeRefreshFeature.kt", "mobile/android/android-components/components/feature/session/src/test/java/mozilla/components/feature/session/SwipeRefreshFeatureTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/BrowserFragmentTest.kt"], "git_node": "2c85560ab00ae77d81e0a9abca93ed2077270861", "git_parents": ["d9aba54df3cb0aba6be0fe506ff4f5f89069f698"], "node": "33cb4d4b319431e63341c8cdb453a75487c7d98f", "parents": ["e89e18b635af727aed8dfa85c35ef9f9abf2d4ec"], "tags": []}, {"author": "jsimplicio \u003cjsimplicio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071975 - Unify New Tab card border and shadow tokens r=maxx,ini\n\nMake top sites tiles, Discovery Stream cards, widgets, and empty states\nuse the same --card-border/--card-box-shadow tokens as moz-card.\n\nCard background handling (solid by default, translucent over a\nwallpaper) is split out to D332589.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326258\n", "files": ["browser/extensions/newtab/content-src/components/Card/_Card.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/_DSCard.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSEmptyState/_DSEmptyState.scss", "browser/extensions/newtab/content-src/components/Sections/_Sections.scss", "browser/extensions/newtab/content-src/components/TopSites/_TopSites.scss", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/_TopSitesHoverCard.scss", "browser/extensions/newtab/content-src/styles/_mixins.scss", "browser/extensions/newtab/content-src/styles/nova/_DSCard.scss", "browser/extensions/newtab/content-src/styles/nova/_TopSites.scss"], "git_node": "e65d6df4d50adb4aab28038039ac5bd425323c99", "git_parents": ["2c85560ab00ae77d81e0a9abca93ed2077270861"], "node": "971ea792e34e4b0b55747fc9cb33c0982fe7945b", "parents": ["33cb4d4b319431e63341c8cdb453a75487c7d98f"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071975 - Make New Tab cards solid unless a wallpaper is active. r=jules,maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332589\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/styles/_theme.scss", "browser/extensions/newtab/content-src/styles/_variables.scss", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx"], "git_node": "a4eb1a57031a2133402ec2f11f0ffaea9691fc8c", "git_parents": ["e65d6df4d50adb4aab28038039ac5bd425323c99"], "node": "0a38f5ecce4bdaf246b2c89db8168687ad763a98", "parents": ["971ea792e34e4b0b55747fc9cb33c0982fe7945b"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084235 - Forward HNT card stack click telemetry with screen and button context. r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337127\n", "files": ["browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/docs/asrouter-newtab-multistage-message.md", "browser/components/asrouter/tests/browser/browser_asrouter_newtab_multistage_messages.js"], "git_node": "cd88671b01a16405f02fbd851ceb2c4bfd3bc6a5", "git_parents": ["a4eb1a57031a2133402ec2f11f0ffaea9691fc8c"], "node": "e178764d910dabd5af4baa9263dcd8d3d5b914e9", "parents": ["0a38f5ecce4bdaf246b2c89db8168687ad763a98"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085890: Use safe-insert-top in CanonicalizeNaNFor r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336866\n", "files": ["js/src/jit-test/tests/canonical-nan/multiple-uses-in-single-block-with-constant-at-start.js", "js/src/jit/IonAnalysis.cpp"], "git_node": "6f1be2eb72871a58ea82b2c0564c13f810ef71b6", "git_parents": ["cd88671b01a16405f02fbd851ceb2c4bfd3bc6a5"], "node": "3196d5555965448359845b234a405425f3a65ec0", "parents": ["e178764d910dabd5af4baa9263dcd8d3d5b914e9"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085938 - Remove non-Firefox tp6 desktop tests. r=perftest-reviewers,sparky,taskgraph-reviewers,bhearsum\" for causing raptor failures.\n\nThis reverts commit d9aba54df3cb0aba6be0fe506ff4f5f89069f698.\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/tp6/desktop/browsertime-tp6.toml", "testing/raptor/raptor/tests/tp6/live/browsertime-live.toml"], "git_node": "5bc1f0a1e7726a689a6ec91dcc97bfc3755d9b77", "git_parents": ["6f1be2eb72871a58ea82b2c0564c13f810ef71b6"], "node": "e14c49bb09246b16a2d49b554531862eda95ec04", "parents": ["3196d5555965448359845b234a405425f3a65ec0"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085929 - Remove the Ion compile time telemetry . r=iain\n\nTakes tiem on main-thread link and it's not being monitored.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337284\n", "files": ["js/public/friend/UsageStatistics.h", "js/src/jit/CodeGenerator.h", "js/src/jit/Ion.cpp", "js/xpconnect/metrics.yaml", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "e71b5f9f3dd3ebbf9c5ed88dc46d9ecb20258850", "git_parents": ["5bc1f0a1e7726a689a6ec91dcc97bfc3755d9b77"], "node": "a6d1f41d64b48920ff2f2f0ed6550eef05130a3f", "parents": ["e14c49bb09246b16a2d49b554531862eda95ec04"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086238 - Fix HTML entity in memory reporting docs example.  DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337266\n", "files": ["docs/performance/memory/memory_reporting.md"], "git_node": "dd26be37525d29ea82e6e2d7b32e6c2c6d13ee7c", "git_parents": ["e71b5f9f3dd3ebbf9c5ed88dc46d9ecb20258850"], "node": "ebbc9a5e2b7a85d7e372cc130190527e47a671ba", "parents": ["a6d1f41d64b48920ff2f2f0ed6550eef05130a3f"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084254 - Remove version 158 train-hop shim for MozAdsEnvironment in AdsClient. r=maxx\n\nFirefox 158 is on Release and ships the `MozAdsEnvironment.Prod()` constructor, so the `MozAdsEnvironment.PROD` fallback and its `@backward-compat { version 158 }` comment are no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335684\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs"], "git_node": "9b7c49f35d5249cb2154f34ac3c98652917c804c", "git_parents": ["dd26be37525d29ea82e6e2d7b32e6c2c6d13ee7c"], "node": "b26f53ac223205e54701ec77c8cea9083b398c39", "parents": ["ebbc9a5e2b7a85d7e372cc130190527e47a671ba"], "tags": []}, {"author": "Glenn Watson \u003cgit@intuitionlibrary.com\u003e", "branch": "default", "desc": "Bug 1660188 - Report more context when a display list fails to parse. r=gfx-reviewers,nical\n\nInclude the slice length, offset, pipeline and whether the list was already\nwalked by a completed scene build, to tell lists that arrived corrupt from\nones corrupted while stored.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336931\n", "files": ["gfx/wr/peek-poke/src/lib.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "61a4da24aeead7a25d5e070cd58f46d70ee882a8", "git_parents": ["9b7c49f35d5249cb2154f34ac3c98652917c804c"], "node": "8ab6de47963a434c2b0bdfc95280c04402ced2e0", "parents": ["b26f53ac223205e54701ec77c8cea9083b398c39"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085940 - Add time_to_connect_start to the pageload event. r=denispal,omansfeld\n\ndns_lookup_time does not include the time between the end of DNS resolution and the start of the connection, for example the Happy Eyeballs resolution delay. Recording connectStart makes that time measurable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336939\n", "files": ["dom/base/Document.cpp", "dom/metrics.yaml", "tools/performance/PageloadEvent.h"], "git_node": "ce1499c4cda027d29f1c0fcbec320a094b5a79eb", "git_parents": ["61a4da24aeead7a25d5e070cd58f46d70ee882a8"], "node": "56c3d1252e1e64e0e039968e950901657a804f38", "parents": ["8ab6de47963a434c2b0bdfc95280c04402ced2e0"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2085746 - Upgrade orjson to 3.13.0. r=taskgraph-reviewers,jcristau\n\nVersion 3.11.9 didn't have wheels for python 3.15.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336980\n", "files": ["taskcluster/requirements.txt"], "git_node": "e7b62ba98297e15a36a463ca69572dabed50afb7", "git_parents": ["ce1499c4cda027d29f1c0fcbec320a094b5a79eb"], "node": "4605adb983dcf3b80c23d6c2d4d05d9d71acc9cb", "parents": ["56c3d1252e1e64e0e039968e950901657a804f38"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084074 - Stop pickling the build environment into doctrees with eval-rst blocks r=firefox-source-docs-reviewers,ahal\n\nMyST parses each eval-rst block into a temporary document that shares the\noriginal settings object, and the nodes it moves into the page keep pointing at\nit. Sphinx only clears settings.env on a copy of the settings before pickling,\nso every such doctree carried a full copy of the BuildEnvironment.\n\nReattaching those nodes to their doctree shrinks the doctrees from 490 MB to\n96 MB. Loading them back in the main process during the write phase drops from\n61 s to 6.5 s, and a clean -j 4 build goes from 116 s to 102 s with the same\nHTML output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335886\n", "files": ["docs/conf.py"], "git_node": "a9f26a0686e8e7d87c4067683d7dc79f96233605", "git_parents": ["e7b62ba98297e15a36a463ca69572dabed50afb7"], "node": "e2dbda1f3b259b289614c68c3c7d24c108cfb9a6", "parents": ["4605adb983dcf3b80c23d6c2d4d05d9d71acc9cb"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084074 - Let Sphinx read the docs in parallel r=firefox-source-docs-reviewers,ahal\n\nmozbuild.sphinx, bzlink and sphinx-js did not declare whether they are safe for parallel reading, so Sphinx fell back to a serial read. None of them keep per-document state.\n\nA clean -j 4 build goes from 102 s to 71 s.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335887\n", "files": ["docs/_addons/bzlink.py", "docs/conf.py", "docs/config.yml", "python/mozbuild/mozbuild/sphinx.py"], "git_node": "c23b742eb7b6846dece83d2147406b27b484a6c7", "git_parents": ["a9f26a0686e8e7d87c4067683d7dc79f96233605"], "node": "301ed54c913aa98a040187c246f470520987db36", "parents": ["e2dbda1f3b259b289614c68c3c7d24c108cfb9a6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084045 - Build the curses module and give the extension modules a working rpath in the Python 3.12 toolchain r=firefox-build-system-reviewers,ahochheiden\n\nPython 3.12 relies on pkg-config to find the ncursesw headers, which the build image lacks, so it silently skipped the curses module that mach needs through blessed. Add the ncursesw include directory on Linux and check that curses imports.\n\nSince Python 3.12 the Makefile links the extension modules instead of setup.py, and make expanded $ORIGIN in the rpath to RIGIN, so they could not load the bundled libncursesw, libssl or libffi. Escape it in the generated Makefile, stop exporting the flags to make, and check the rpath of the curses module.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335890\n", "files": ["taskcluster/scripts/misc/build-cpython.sh"], "git_node": "1dedf71fd2b5d922d39998f27807728a8d5c3d87", "git_parents": ["c23b742eb7b6846dece83d2147406b27b484a6c7"], "node": "6ed3ea0b0b86519b94f8cea06137aa8e717095a6", "parents": ["301ed54c913aa98a040187c246f470520987db36"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084045 - Add a linux64-python-3.12 toolchain r=taskgraph-reviewers,bhearsum\n\npip 23.0 no longer works on Python 3.12, so the toolchain installs pip 24.0 there. Only rewrite PYTHONHOME in the files that mention it: touching every file made the Makefile regenerate sources with the host python3, which is too old for the Python 3.12 Tools/clinic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335891\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/python.yml", "taskcluster/scripts/misc/build-cpython.sh"], "git_node": "12b6441acc57d85dd9fe7646639341a299d1b8d2", "git_parents": ["1dedf71fd2b5d922d39998f27807728a8d5c3d87"], "node": "a71abc1fe5043e1b65bdf46e4cebe94c2fa4f675", "parents": ["6ed3ea0b0b86519b94f8cea06137aa8e717095a6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084046 - Upgrade Sphinx to 9.1.0 and build the docs with Python 3.12 r=firefox-source-docs-reviewers,ahal\n\nSphinx 9.1.0 requires Python 3.12, so build the doc tasks with the linux64-python-3.12 toolchain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335892\n", "files": ["python/sites/docs.txt", "taskcluster/kinds/source-test/doc.yml"], "git_node": "d9fddf1e36113d7c0f19a8fae9acd5a1cfa88178", "git_parents": ["12b6441acc57d85dd9fe7646639341a299d1b8d2"], "node": "1bf8ffb5c79eafe233523ce1c256c62af4a0a490", "parents": ["a71abc1fe5043e1b65bdf46e4cebe94c2fa4f675"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084046 - Import the real mach.commands package when loading command files r=mach-reviewers,ahochheiden\n\nThe placeholder module hid the mach.commands package, so the Sphinx autodoc run inside mach could not import mach.commands.commandinfo or mach.commands.settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335893\n", "files": ["python/mach/mach/command_util.py"], "git_node": "49e1e30165794495507745034a4d69885a64227e", "git_parents": ["d9fddf1e36113d7c0f19a8fae9acd5a1cfa88178"], "node": "7e27b535ed02c6d121dbb35e431ed1ba59dad755", "parents": ["1bf8ffb5c79eafe233523ce1c256c62af4a0a490"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2084865 - Update ca-certificates in the Ubuntu images. r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336945\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "b4f138b2849ff8e8c24d1f5cf3cf861848f03322", "git_parents": ["49e1e30165794495507745034a4d69885a64227e"], "node": "ea94a9f6f0b98143a2ac3a513e45ebf7c4ef3602", "parents": ["7e27b535ed02c6d121dbb35e431ed1ba59dad755"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073219 - Part 1 - Add write APIs to Tab Data Coordinator r=android-reviewers,android-build-system-reviewers,RyanVM,jdelorenzo\n\nThis commit allows the coordinator to be the orchestrator for updating tab data and handling side effects which update multiple layers of tab data.\n\nTab now also carries the favicon, `isMediaActive` boolean, and last access time so consumers can render a tab without reaching back into browser-state.\n\nThe lookups a consumer needs to reason about group membership are added as TabsSnapshot query extensions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328691\n", "files": ["mobile/android/android-components/components/feature/tabdata-coordinator/README.md", "mobile/android/android-components/components/feature/tabdata-coordinator/build.gradle", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/TabDataCoordinator.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/data/Tab.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/data/TabsSnapshotQueries.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/repository/TabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/DefaultTabDataCoordinatorTest.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/data/TabsSnapshotQueriesTest.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/testFixtures/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabDataCoordinator.kt", "mobile/android/android-components/components/feature/tabgroups-storage/build.gradle", "mobile/android/android-components/components/feature/tabgroups-storage/src/main/java/mozilla/components/feature/tabgroups/storage/data/TabGroupData.kt", "mobile/android/android-components/components/feature/tabgroups-storage/src/testFixtures/kotlin/mozilla/components/feature/tabgroups/storage/fakes/FakeTabGroupRepository.kt", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/tabs/DefaultTabRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/tabs/DefaultTabRepositoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddlewareTest.kt"], "git_node": "9342426be2939245e9bc072e2cb9d3b0afbdd055", "git_parents": ["b4f138b2849ff8e8c24d1f5cf3cf861848f03322"], "node": "f11f573148230d00662781829c39151733c0c273", "parents": ["ea94a9f6f0b98143a2ac3a513e45ebf7c4ef3602"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073219 - Part 2 - Migrate the Tab Manager's tab data observations to the coordinator r=android-reviewers,jdelorenzo\n\nThe middleware now collects TabDataCoordinator.tabsSnapshot instead of performing its own Flow transformation + collection.\n\n`TabsSnapshotMapper` handles the transformation from `TabsSnapshot` to `TabStorageUpdate`.\n\nBecause the coordinator is initialized with the application and keeps its snapshot warm, the tray no longer has to wait for the first transformation after it opens.\n\nThe transformation tests move from TabStorageMiddlewareTest to TabsSnapshotMapperTest, where they no longer need a store. The middleware's remaining tests are driven through a real DefaultTabDataCoordinator over a BrowserStore, so a test's reads and writes now share one source of truth; three drag-and-drop assertions change to the tab order production actually produces, which the previous static tab data flow could not observe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328692\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/data/TabData.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/data/TabGroupTheme.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/data/TabsSnapshotMapper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/ext/TabsTrayState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/reducer/TabsTrayReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/data/TabsSnapshotMapperTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt"], "git_node": "35a34962e86812702e0b7e19098f98e81f1b39ac", "git_parents": ["9342426be2939245e9bc072e2cb9d3b0afbdd055"], "node": "973a93dc3f520781f0fb7e04f6f3756ff18a5c9b", "parents": ["f11f573148230d00662781829c39151733c0c273"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073219 - Part 3 - Migrate TabStorageMiddleware to use the coordinator for all tab data updates r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328693\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt"], "git_node": "f433b448e8251f3e707ba48d9b3947b20ad5d79f", "git_parents": ["35a34962e86812702e0b7e19098f98e81f1b39ac"], "node": "f2f6203f57d573c2a1ba17ddfceafb2f9d949345", "parents": ["973a93dc3f520781f0fb7e04f6f3756ff18a5c9b"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082907 - Remove non nova branches from maximized decoration and about:support tests. r=desktop-theme-reviewers,mstriemer\n\nThe browserNova.toml manifest that ran browser_maximized_decoration.js a\nsecond time with Nova enabled was already removed in bug 2082901\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336232\n", "files": ["browser/base/content/test/browser-about/browser_aboutSupport_user_namespaces.js", "browser/base/content/test/browser-maximized/browser_maximized_decoration.js"], "git_node": "f39abf3f8ecafab4e6e7263eff38f02d4ea6199e", "git_parents": ["f433b448e8251f3e707ba48d9b3947b20ad5d79f"], "node": "6ff8097ff366490cd68fe05594911795ff025bb1", "parents": ["f2f6203f57d573c2a1ba17ddfceafb2f9d949345"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080180 - Part 1. Prefer decoding and encoding in the GPU process on Android, including with a CDM. r=media-playback-reviewers,alwu\n\nThis allows MediaCodec video decoding to use AImageReader. The CDM must be in\nthe same process as the decoders using it, so the CDM is created in the GPU\nprocess when decoding there is enabled, and only then may audio be decoded\nthere. If the GPU process is disabled, we fall back to the RDD process. We also\nno longer disable decoding in the GPU process separately on Android after\ncrashes, so a decoder which repeatedly crashes the GPU process will cause it to\nbe relaunched until it is disabled entirely after too many restarts. The GPU\nprocess now also probes for MediaCodec encoders, so that encoding is preferred\nthere in the same way, and the media manager endpoint for the GPU process is\ncreated if either decoding or encoding there is enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336690\n", "files": ["dom/media/eme/MediaKeys.cpp", "dom/media/ipc/RemoteAudioDecoder.cpp", "dom/media/ipc/RemoteCDMProxy.cpp", "dom/media/ipc/RemoteCDMProxy.h", "dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerChild.h", "dom/media/platforms/ffmpeg/FFmpegAudioDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegDecoderModule.h", "dom/media/platforms/ffmpeg/FFmpegEncoderModule.cpp", "gfx/ipc/GPUProcessManager.cpp"], "git_node": "e16a53883576f2f6c7cbf2bd37e1b84093d816d1", "git_parents": ["f39abf3f8ecafab4e6e7263eff38f02d4ea6199e"], "node": "8cd5e3a984a99abc0bf814583ddc13b054e2d684", "parents": ["6ff8097ff366490cd68fe05594911795ff025bb1"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080180 - Part 2. Only fallback to platform decoding and encoding in the RDD process on Android if the GPU process is disabled. r=media-playback-reviewers,alwu\n\nThe RDD process no longer creates MediaCodec decoders or encoders while the GPU\nprocess is enabled and decoding or encoding in it is preferred, and the content\nprocess no longer reports hardware decoding support for the RDD process then.\nPure software decoding and encoding with ffvpx may still be performed outside\nof the GPU process since it is not permitted there.\n\nNote that if creating a decoder in the GPU process fails for a reason other\nthan a crash, we no longer retry with MediaCodec in the RDD process, so codecs\nwithout a software decoder, such as H264 and HEVC, will fail to decode.\n\nThe test checks that video decoding prefers the GPU process, and that only\nhardware decoding is performed in the GPU process, and only software decoding\nis performed in the RDD process unless the GPU process is unavailable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336691\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/platforms/ffmpeg/FFmpegDecoderModule.h", "dom/media/platforms/ffmpeg/FFmpegEncoderModule.cpp", "dom/media/platforms/ffmpeg/FFmpegEncoderModule.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h", "dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp", "dom/media/test/mochitest.toml", "dom/media/test/test_android_gpu_process_decoding.html", "gfx/ipc/GPUProcessManager.cpp"], "git_node": "7b75939485a14a9ddd698beefa46185f4b0dbdc2", "git_parents": ["e16a53883576f2f6c7cbf2bd37e1b84093d816d1"], "node": "f7acecbf2a9fa442570a29fa9f4d0abfd18ef6fe", "parents": ["8cd5e3a984a99abc0bf814583ddc13b054e2d684"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080180 - Part 3. Use the GPU process for encoding/decoding with Android isolated process tests by default. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336692\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "32d91c7937fb3d0c789dd909e81778445f65a44c", "git_parents": ["7b75939485a14a9ddd698beefa46185f4b0dbdc2"], "node": "15f537110a84722190e4ab02e95b77623711adc7", "parents": ["f7acecbf2a9fa442570a29fa9f4d0abfd18ef6fe"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086278 - Flip prefs to enable decoding and encoding in the GPU process on Android on nightly. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337308\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "13f9a166d2bec490ab2df56913d4d5219b67767e", "git_parents": ["32d91c7937fb3d0c789dd909e81778445f65a44c"], "node": "bb53bc132f3ed05a87e59c8579a70d483016b639", "parents": ["15f537110a84722190e4ab02e95b77623711adc7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2085115 - Update libdav1d to e5fd231fe9955a342c60600edb7e0b8777786a6a r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336948\n", "files": ["media/libdav1d/moz.yaml", "media/libdav1d/vcs_version.h", "third_party/dav1d/meson.build", "third_party/dav1d/meson_options.txt", "third_party/dav1d/src/arm/32/util.S", "third_party/dav1d/src/arm/64/util.S", "third_party/dav1d/src/arm/asm_debug.c", "third_party/dav1d/src/cdef_apply_tmpl.c", "third_party/dav1d/src/decode.c", "third_party/dav1d/src/internal.h", "third_party/dav1d/src/lf_mask.c", "third_party/dav1d/src/meson.build", "third_party/dav1d/src/obu.c", "third_party/dav1d/src/x86/looprestoration16_avx512.asm"], "git_node": "0de7d3c2b9a378d4ea80fa8ba613fab98559871c", "git_parents": ["13f9a166d2bec490ab2df56913d4d5219b67767e"], "node": "59dba8ffb58cac7402d90d3de94132510d5ad812", "parents": ["bb53bc132f3ed05a87e59c8579a70d483016b639"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2079893 - Update libvpx to 50ede54a5ca9a63ab6439e04543ac9c183750c06 r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336959\n", "files": ["media/libvpx/libvpx/examples/simple_decoder.c", "media/libvpx/libvpx/test/decode_api_test.cc", "media/libvpx/libvpx/test/encode_api_test.cc", "media/libvpx/libvpx/test/mfqe_test.cc", "media/libvpx/libvpx/test/non_greedy_mv_test.cc", "media/libvpx/libvpx/test/sad_test.cc", "media/libvpx/libvpx/test/sum_squares_test.cc", "media/libvpx/libvpx/test/svc_datarate_test.cc", "media/libvpx/libvpx/test/test.mk", "media/libvpx/libvpx/test/vpx_image_test.cc", "media/libvpx/libvpx/vp8/encoder/bitstream.c", "media/libvpx/libvpx/vp8/encoder/onyx_if.c", "media/libvpx/libvpx/vp8/encoder/onyx_int.h", "media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vp8/vp8_dx_iface.c", "media/libvpx/libvpx/vp9/common/vp9_entropy.c", "media/libvpx/libvpx/vp9/common/vp9_mfqe.c", "media/libvpx/libvpx/vp9/decoder/vp9_detokenize.c", "media/libvpx/libvpx/vp9/encoder/vp9_bitstream.c", "media/libvpx/libvpx/vp9/encoder/vp9_denoiser.c", "media/libvpx/libvpx/vp9/encoder/vp9_encodemb.c", "media/libvpx/libvpx/vp9/encoder/vp9_encoder.c", "media/libvpx/libvpx/vp9/encoder/vp9_encoder.h", "media/libvpx/libvpx/vp9/encoder/vp9_pickmode.c", "media/libvpx/libvpx/vp9/encoder/vp9_rdopt.c", "media/libvpx/libvpx/vp9/encoder/vp9_svc_layercontext.c", "media/libvpx/libvpx/vp9/encoder/vp9_svc_layercontext.h", "media/libvpx/libvpx/vp9/encoder/vp9_temporal_filter_constants.h", "media/libvpx/libvpx/vp9/encoder/vp9_tokenize.c", "media/libvpx/libvpx/vp9/vp9_cx_iface.c", "media/libvpx/libvpx/vp9/vp9_dx_iface.c", "media/libvpx/libvpx/vp9/vp9_iface_common.c", "media/libvpx/libvpx/vpx/src/vpx_image.c", "media/libvpx/libvpx/vpx/vp8dx.h", "media/libvpx/libvpx/vpx_dsp/arm/fdct32x32_neon.c", "media/libvpx/libvpx/vpx_dsp/arm/fdct32x32_neon.h", "media/libvpx/libvpx/vpx_dsp/arm/intrapred_neon.c", "media/libvpx/libvpx/vpx_dsp/arm/sad4d_neon_dotprod.c", "media/libvpx/libvpx/vpx_dsp/arm/subtract_neon.c", "media/libvpx/libvpx/vpx_dsp/arm/sum_squares_neon.c", "media/libvpx/libvpx/vpx_dsp/ppc/sad_vsx.c", "media/libvpx/libvpx/vpx_ports/aarch64_cpudetect.c", "media/libvpx/libvpx/vpx_util/vpx_pthread.h", "media/libvpx/moz.yaml"], "git_node": "e361f368aa5f8f2f8b1db8ccb2e4e789e2e0adc0", "git_parents": ["0de7d3c2b9a378d4ea80fa8ba613fab98559871c"], "node": "441ba9757fe239ab364ed7c4d74ce407a42e25a4", "parents": ["59dba8ffb58cac7402d90d3de94132510d5ad812"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2079893 - Apply patches r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336960\n", "files": ["media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vp9/vp9_cx_iface.c", "media/libvpx/libvpx/vpx_ports/aarch64_cpudetect.c", "media/libvpx/libvpx/vpx_util/vpx_pthread.h"], "git_node": "f281f5dd6c0209be41b065facd42f5f68b3efa11", "git_parents": ["e361f368aa5f8f2f8b1db8ccb2e4e789e2e0adc0"], "node": "6e9115c20ee473586d831fa00d51ab9a24b8c884", "parents": ["441ba9757fe239ab364ed7c4d74ce407a42e25a4"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085567 - Put the CustomizeMode markup directly in its html:template r=firefox-desktop-core-reviewers ,Gijs\" for causing bc failures @browser_editcontrols_update.js.\n\nThis reverts commit 3b7009bca5215e7be9fcd97210944a4e3821e9f3.\n", "files": ["browser/base/content/browser.xhtml", "browser/components/customizableui/CustomizeMode.sys.mjs"], "git_node": "4fbc4d06699f9c77ef6639029e14ec3308a06052", "git_parents": ["f281f5dd6c0209be41b065facd42f5f68b3efa11"], "node": "73d9363fe3e57406e0ccce79b9a02508de37be86", "parents": ["6e9115c20ee473586d831fa00d51ab9a24b8c884"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 1 - Pass private browsing state to JumpListBuilder. r=win-reviewers,gstoll\n\nRefactor only.  No substantive changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328660\n", "files": ["widget/windows/JumpListBuilder.cpp", "widget/windows/JumpListBuilder.h", "widget/windows/WinTaskbar.cpp", "widget/windows/tests/gtest/TestJumpListBuilder.cpp"], "git_node": "b85b35c3e1c0953a8ca49ce366d85d44b28eba54", "git_parents": ["4fbc4d06699f9c77ef6639029e14ec3308a06052"], "node": "a7b9317f62aa6024105d9c7da1a264b9a929011d", "parents": ["73d9363fe3e57406e0ccce79b9a02508de37be86"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 2 - Control separate STAs for Windows Jump List builders r=Jamie,win-reviewers,gstoll\n\nCLSID_DestinationList and CLSID_ApplicationDestinations are STA objects.\nCreating them from the MTA, as we have been doing, made COM host them in a\nsingle, process-wide implicit STA that it created, and marshal every call to it.\nThis serialised the normal and private-browsing builders against each other\nand turned teardown into a cross-apartment call.  One builder's stalled shell\ncall blocked the other's shutdown.  Additionally, LazyIdleThread, which\nbacked the MTA threads, was deadlocking at shutdown because it blocks on a\ntoo-early thread join to the main thread (the \"main\" STA), and doesn't spin\nan event loop when it does so.  Shutdown now spins the event loop while\nwaiting.  It is not clear that the last point was required for this deadlock,\nbut it is wrong regardless.  STAs should never block arbitrarily if they can\navoid it.  Auditing similar use in nsDataObj is bug 2074940.\n\nThis patch deliberately does _not_ timeout when it joins the new threads.  That\nwould prevent this deadlock, even if the theory that shutdown concurrency was\nto blame was wrong, but it would hide the issue rather than fix it.  This way,\nwe will know if we still have the issue.  The \"nuclear\" option of orphaning\nthese threads remains, if we need it.  Later patches in this series add\ntelemetry that would make that situation clear.\n\nTestJumpListBuilder previously only worked because the MTA happened to cause\nthe two uses to marshal to different STA objects, which was naughty, and is\nfixed here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328653\n", "files": ["build/clang-plugin/ThreadAllows.txt", "tools/lint/mscom-init.yml", "widget/windows/JumpListBuilder.cpp", "widget/windows/JumpListBuilder.h", "widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h", "widget/windows/tests/gtest/TestJumpListBuilder.cpp"], "git_node": "5bb3f166b3bf35f8bb65a8a2614069ca48a3e82a", "git_parents": ["b85b35c3e1c0953a8ca49ce366d85d44b28eba54"], "node": "17c3d1e97e487851b4b0b90e8635b924688e65ef", "parents": ["a7b9317f62aa6024105d9c7da1a264b9a929011d"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 3 - Time each Windows Jump List Shell call. r=win-reviewers,gstoll\n\nShort-lived telemetry (expires in Fx165) that will tell us if Jump List\nfixes are working and, if not, where they fail.  This times the operations,\nto see if they really are slow or if the bug is something else.  A later\npatch adds telemetry to detect Jump List calls that do not complete at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328654\n", "files": ["widget/windows/JumpListBuilder.cpp", "widget/windows/metrics.yaml"], "git_node": "83176b0f291735fbd03cb4805ade67da57541b89", "git_parents": ["5bb3f166b3bf35f8bb65a8a2614069ca48a3e82a"], "node": "1d0edafdfb4b486dbf032a1bd6f5abefbba571f7", "parents": ["17c3d1e97e487851b4b0b90e8635b924688e65ef"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073787: Part 4 - Time in-flight Jump List calls in crash reports. r=win-reviewers,crashreporting-reviewers,afranchuk,gstoll\n\njump_list_shell_call, added in part 3, only records a call once it returns, so a\ncall that never returns leaves no sample.  The annotation added here is cleared\non return, so a crash report that still carries it is that case, and CrashTime\nminus the recorded value is how long the call had been blocked.\n\nUsing datetime for JumpListShellCallStart, instead of seconds from epoch, like\nsome others do, allows us to query crashTime-JumpListShellCallStart in STMO to\nget the amount of time stalled.  This is minor and simple -- the query could also\nbe written to convert crashTime to secs from epoch, but this will negate the\nneed.\n\nThe Rust function it uses to do the crashTime secs-to-date-conversion\nis renamed to convert_unix_timestamp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328655\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/glean_metrics.py", "toolkit/crashreporter/crashping/glean_rust.py", "toolkit/crashreporter/crashping/moz.build", "toolkit/crashreporter/crashping/src/annotations.rs", "toolkit/crashreporter/crashping/src/lib.rs", "widget/windows/JumpListBuilder.cpp"], "git_node": "f57110d7b8ec59eabe32c0a7c002272f3b678a33", "git_parents": ["83176b0f291735fbd03cb4805ade67da57541b89"], "node": "af9e1d7efe7d869081060a3e8cefe77ecafb7ebc", "parents": ["1d0edafdfb4b486dbf032a1bd6f5abefbba571f7"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084796 - Name the card security code after the card network. r=credential-management-reviewers,fluent-reviewers,dimi,bolsson\n\nCreditCard.getSecurityCodeL10nId() and formatSecurityCodeName() name the code\nthe way the card's network does (CVV for Visa, CVC for Mastercard, CID for\nAmerican Express, and \"Security code\" otherwise). The doorhanger card\ndetails, the autocomplete entry, the payment methods list and dialogs, and the\nedit dialog's field use it instead of a fixed abbreviation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336187\n", "files": ["browser/extensions/formautofill/content/autofillEditForms.mjs", "browser/extensions/formautofill/content/editCreditCard.xhtml", "browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/unit/test_profileAutocompleteResult.js", "browser/locales/en-US/browser/preferences/formAutofill.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "python/l10n/fluent_migrations/bug_2084796_card_details.py", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl", "toolkit/locales/en-US/toolkit/payments/payments.ftl", "toolkit/modules/CreditCard.sys.mjs", "toolkit/modules/tests/xpcshell/test_CreditCard.js"], "git_node": "7af7175b265b22bcc7c9689ee31d9038fb1c2b57", "git_parents": ["f57110d7b8ec59eabe32c0a7c002272f3b678a33"], "node": "c586fbca03608b4a5d10fdcaf0446187bd7b62da", "parents": ["af9e1d7efe7d869081060a3e8cefe77ecafb7ebc"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084803 - Update the card save doorhanger to the new security code design. r=credential-management-reviewers,fluent-reviewers,desktop-theme-reviewers,akulyk,flod,dimi\n\nWhen security codes are supported, the save doorhanger offers a toggle for\nsaving them in place of the checkbox. The description and card details follow\nthe toggle, so they only mention the security code when it will be saved. The\nupdate doorhanger keeps the checkbox for now. The lock icon of the card\ndoorhangers is now filled with the success color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336294\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/themes/shared/formautofill-notification.css", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "84b1078c84f921671902b04980154eafc84cb27b", "git_parents": ["7af7175b265b22bcc7c9689ee31d9038fb1c2b57"], "node": "561b7f114b55e9631b918b15f6173aa2f9cdc2ff", "parents": ["c586fbca03608b4a5d10fdcaf0446187bd7b62da"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084805 - Update the card update doorhanger for updates that keep the security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\n\nWhen security codes are supported, the update doorhanger shows the plain\n\"Update payment method?\" content, without the security codes checkbox, and\nnotes the stored security code in the card details. A form submitted with an\nempty security code no longer clears the stored one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336295\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "fbc1c5d6d3d261f8ebe968f6d060711502efec3f", "git_parents": ["84b1078c84f921671902b04980154eafc84cb27b"], "node": "5ed648f1ea3c47e8031e8d621272df475f63d8ba", "parents": ["561b7f114b55e9631b918b15f6173aa2f9cdc2ff"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084804 - Update the card update doorhanger for a new or changed security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\n\nA saved card submitted with a new or changed security code gets a \"Save\nsecurity code?\" doorhanger with the security codes toggle. Turning the toggle\noff switches it to the plain update content in place, and updating then keeps\nthe stored security code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336296\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "3297bf3238202d60cd53a4e7f2e103107a79dea8", "git_parents": ["fbc1c5d6d3d261f8ebe968f6d060711502efec3f"], "node": "5afb74ddd50c89f2c26d4130e60a96493bae1ede", "parents": ["5ed648f1ea3c47e8031e8d621272df475f63d8ba"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067846 - Remove the World Cup wallpaper highlight. r=fluent-reviewers,nina-py,bolsson\n\nThe World Cup wallpapers are leaving Remote Settings, so their promotional highlight will no longer have anything to link to. This removes the World Cup and semifinal highlights and their styles, image, strings and tests. The regular custom wallpaper highlight stays as it is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337251\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/FeatureHighlight/WallpaperFeatureHighlight.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/FeatureHighlight/_WallpaperFeatureHighlight.scss", "browser/extensions/newtab/data/content/assets/highlights/wallpaper-callout.png", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/WallpaperFeatureHighlight.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "5ee2674616187a88cca8acda39c23b3fc5209e5c", "git_parents": ["3297bf3238202d60cd53a4e7f2e103107a79dea8"], "node": "2c262b2fa0be7785fd697cde3f2b6c5f17f9a592", "parents": ["5afb74ddd50c89f2c26d4130e60a96493bae1ede"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082547 - Remove unused aIsSubframe parameter from IsolationBehaviorForURI. r=nika\n\nDepends on D324299\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334196\n", "files": ["dom/ipc/ProcessIsolation.cpp"], "git_node": "83c21ec0cbe26f1f75c10f551fcc7b0ae1a69c84", "git_parents": ["5ee2674616187a88cca8acda39c23b3fc5209e5c"], "node": "7f63dad16dcff24f375e6a80acdabb497c40d0c4", "parents": ["2c262b2fa0be7785fd697cde3f2b6c5f17f9a592"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085198: Resolve the Array constructor before transpiling DOM calls r=jandem\n\nThe array constructor has almost certainly already been resolved, so this is very cheap. Doing this allows us to safely support WebIDL sequences.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336323\n", "files": ["js/src/jit/WarpOracle.cpp"], "git_node": "ed3e00400ed97b68a7dfec8b155e3aeff54fc299", "git_parents": ["83c21ec0cbe26f1f75c10f551fcc7b0ae1a69c84"], "node": "ec24f9ae6459583e3b83ac5f145253ae91bf44ac", "parents": ["7f63dad16dcff24f375e6a80acdabb497c40d0c4"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085198: Don't trust the alias set of DOM operations that may create objects r=smaug\n\nThis is about as precise as we can reasonably make the set of exclusions. The one case that I didn't try to handle here was the \"TrustedHTML or DOMString\" case (eg innerHTML): the type indicates that it could potentially be an object, but Claude says that technically it always returns a string.\n\nThis is a major regression on some of the dom-assorted subtests (in particular window-get(name|prop)-performance-getter), but those are tiny (\u003c10 line) microbenchmarks that represent the absolute worst case scenario. (See the source code for the benchmark [here](https://github.com/mozilla/perf-automation/blob/master/benchmarks/assorted-dom/assorted/getprop-performance-getter-helper.js).) They don't appear to reflect real-world performance. I couldn't find a measurable regression in any of our other benchmarks; in particular, sp3 and sp-ex are flat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336324\n", "files": ["dom/bindings/Codegen.py"], "git_node": "b9a1ee8a4ba44ca93fcb68c8b58574fb07aaaeaf", "git_parents": ["ed3e00400ed97b68a7dfec8b155e3aeff54fc299"], "node": "0ed59120f50a8ef5c8fec21317be8fa2ec7c576a", "parents": ["ec24f9ae6459583e3b83ac5f145253ae91bf44ac"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2050480 - Add gtests that NVImage conversion preserves its input backing store r=gfx-reviewers,bradwerth\n\nBuildSurfaceDescriptorBuffer (NV12 and NV21 branches) and\nGetAsSourceSurface both convert the interleaved chroma to I420; neither\nmay write the deinterleaved planes back into the image's own backing\nstore. Also covers BuildSurfaceDescriptorBuffer's cached-surface path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311438\n", "files": ["gfx/tests/gtest/TestNVImage.cpp", "gfx/tests/gtest/moz.build"], "git_node": "82ff609bfa0fca0d8c922d9fe2a14dfe3a229eb4", "git_parents": ["b9a1ee8a4ba44ca93fcb68c8b58574fb07aaaeaf"], "node": "69f1229c96b173690ba562e577085c1da845775a", "parents": ["0ed59120f50a8ef5c8fec21317be8fa2ec7c576a"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2050480 - Add WebCodecs tests that encoding a VideoFrame preserves its input r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311224\n", "files": ["testing/web-platform/meta/webcodecs/videoFrame-encode-preserves-input.crossOrigin.https.html.ini", "testing/web-platform/meta/webcodecs/videoFrame-encode-preserves-input.https.any.js.ini", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input-utils.js", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input.crossOrigin.helper.html", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input.crossOrigin.https.html", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input.https.any.js"], "git_node": "67f326c95c5a68ced221c5c5ad738915e11fd205", "git_parents": ["82ff609bfa0fca0d8c922d9fe2a14dfe3a229eb4"], "node": "a1c07b532df2eda8f6443e76816daf7ff9bfd165", "parents": ["69f1229c96b173690ba562e577085c1da845775a"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2050480: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/tests/gtest/TestNVImage.cpp"], "git_node": "8691e4c82f06a416ce58e4c22a36a7d87eb1869b", "git_parents": ["67f326c95c5a68ced221c5c5ad738915e11fd205"], "node": "0123dc272c2b11677c6d83fcd1c1e0e55e930580", "parents": ["a1c07b532df2eda8f6443e76816daf7ff9bfd165"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2045379 - Add gtest for AudioPacketizer::Input refusing invalid input r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309207\n", "files": ["dom/media/gtest/TestAudioPacketizer.cpp"], "git_node": "a858e6ad6635419bea5035dbcf4b24e5d0e10f9b", "git_parents": ["8691e4c82f06a416ce58e4c22a36a7d87eb1869b"], "node": "158063038ff9224e58c5a3ef5bb2988842d27f8a", "parents": ["0123dc272c2b11677c6d83fcd1c1e0e55e930580"], "tags": []}, {"author": "Release Engineering 