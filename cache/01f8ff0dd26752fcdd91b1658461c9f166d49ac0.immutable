ts.json"], "git_node": "5a9fd7e5f207d25c0be84867b6f13c86cf2d0322", "git_parents": ["311326a7003db1021c2e42922f5bc62bb68de3c1"], "node": "99021183d0532256adb60346fe8525e7f8553f14", "parents": ["c597f5321463c1f23b2cca9db0fcb96ccdfb6097"], "tags": []}, {"author": "calixteman \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2085041 - Enable pdf.js worker rendering on Nightly and early beta. r=marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336211\n", "files": ["toolkit/components/pdfjs/PdfJsOverridePrefs.js"], "git_node": "de40ea351c8a42c7f07b7e640163a3d30f57edfe", "git_parents": ["5a9fd7e5f207d25c0be84867b6f13c86cf2d0322"], "node": "1c35f98b8f1c99b95575290cc0ce00276026baef", "parents": ["99021183d0532256adb60346fe8525e7f8553f14"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1705365 - Don't let an enclosing native loop go back to waiting after a nested loop consumed its wake-up. r=mac-reviewers,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330438\n", "files": ["widget/cocoa/nsAppShell.h", "widget/cocoa/nsAppShell.mm"], "git_node": "305e4f921351326da3e8440ed2ac33f9c8d6604e", "git_parents": ["de40ea351c8a42c7f07b7e640163a3d30f57edfe"], "node": "4beb6108ba61f7dc4b7cd142718f7938f6a1e806", "parents": ["1c35f98b8f1c99b95575290cc0ce00276026baef"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1705365 - Add a test for native wake-ups lost to nested Cocoa event loops. r=mac-reviewers,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330437\n", "files": ["widget/cocoa/CustomCocoaEvents.h", "widget/cocoa/nsAppShell.h", "widget/cocoa/nsAppShell.mm", "widget/moz.build", "widget/nsICocoaAppShellTestUtils.idl", "widget/tests/chrome.toml", "widget/tests/test_nested_native_loop_wakeup_mac.html"], "git_node": "2f8880339bc10b022e2e09c7c2c8a3352e369dc2", "git_parents": ["305e4f921351326da3e8440ed2ac33f9c8d6604e"], "node": "884f079e608d7b58c1d2a7f062b10eefd1d2bb5b", "parents": ["4beb6108ba61f7dc4b7cd142718f7938f6a1e806"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084640. Don't reuse cached path patterns at a different offset from the path. r=lsalzman\n\nhttps://searchfox.org/firefox-main/rev/034cd8a8207e38b04afec5e6f75e5161f75a112f/dom/canvas/DrawTargetWebgl.cpp#4540\n\nPathCacheEntry::MatchesPath ignores translation, assuming the pattern moves\nwith the path. That isn't true when the path stays put in device space and\nonly the pattern moves, e.g. pdf.js filling the whole canvas with a translated\nradial gradient for each shading, so we reused the first draw's texture for\nthe others. This was hidden until bug 2072448 let gradient patterns match in\nthe cache. Record the quantized offset of the pattern relative to the path\nwhenever the pattern is rasterized into an entry's texture, and require it to\nmatch for entries with a baked texture. Entries that only cache WGR vertex\ngeometry draw with the live pattern, so they are unaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336152\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h", "dom/canvas/DrawTargetWebglInternal.h", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat-expected.html", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat-expected.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.w.html", "testing/web-platform/tests/html/canvas/tools/yaml/fill-and-stroke-styles.yaml"], "git_node": "f536a878f58f97cdf167149b25a95848519a2199", "git_parents": ["2f8880339bc10b022e2e09c7c2c8a3352e369dc2"], "node": "6bd62bf4a691a2f3d262ad6e901fd9afc42d87e0", "parents": ["884f079e608d7b58c1d2a7f062b10eefd1d2bb5b"], "tags": []}], "date": 1792749057, "git_changesets": ["5fc4ea3944dd108f6f79c093bf8249feb451456e", "e63e93f6ae254802c55b181ca9c19975afae741f", "c25ff1d5742ef3b63aef7e1ca3889f3d839b4d0d", "b679200a2504c567b0b6b27c8b0f1860bb7a1dfa", "7ab28335841a813e7a80783db80b4d05669ec96e", "24a60fee8e770a982c312e7d4c63b98b941263b9", "66bc4052c09de29c91e2744dfa2a823ac4d7e4c0", "4a469f1be1ab254644715bc20b41a813eca2770b", "7069f4c00d48b478e7de8b5495535acb3e7934e3", "ac21bb009fae4c92c04de3b8d7f6a0d291b0674d", "3754a2a8cf8baa032baf958b5c27e46e4ff1a9e0", "41a957327136db085d5793f3cf80bb9360344b2b", "5af0292500a3a995689f09851f41b3c74890a5ff", "79e5add1ed503ecb346e49665dc9ca8212ba9a89", "24196af1cdf3c6292588082706a5c712178bbb00", "0cd910133ec7afe53bb66f38c9436bb6083ea5da", "aaaf80bd10130501fdc34f132ad32803dc4388d2", "022f5b711c6369d4bf77fe2acf3eafbe1f24a3b6", "966b17a5e71b0961d9f9cc77d44fa53fe5419d0e", "fcce6e923cbe95d86f81e7cf35e56507d4d167df", "37ca8e540789f2d1e48576adb1be9f60cac146df", "988533cc3a99dc0725c5650ee0f71a1034e31349", "b558ade8a6ae3ac3e4a7ac756acdea78cf49a78e", "311326a7003db1021c2e42922f5bc62bb68de3c1", "5a9fd7e5f207d25c0be84867b6f13c86cf2d0322", "de40ea351c8a42c7f07b7e640163a3d30f57edfe", "305e4f921351326da3e8440ed2ac33f9c8d6604e", "2f8880339bc10b022e2e09c7c2c8a3352e369dc2", "f536a878f58f97cdf167149b25a95848519a2199"], "user": "sstanca@mozilla.com"}, "45639": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082844 - Implement a Guest Auth Provider for SmartWindow - part 1 - move FxA to its own impl r=bjohns,pdahiya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334495\n", "files": ["browser/components/aiwindow/models/AuthProvider.sys.mjs", "browser/components/aiwindow/models/auth/AuthProviderImpl.sys.mjs", "browser/components/aiwindow/models/auth/FxaAuthProviderImpl.sys.mjs", "browser/components/aiwindow/models/auth/moz.build", "browser/components/aiwindow/models/moz.build", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "a1ab390c5ee5b52d4e6e243f324d5ec2f01a1a70", "git_parents": ["f536a878f58f97cdf167149b25a95848519a2199"], "node": "93130876b207c6255d2eaac31b6b2d30baccc781", "parents": ["6bd62bf4a691a2f3d262ad6e901fd9afc42d87e0"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2083653 - Ensure tests pass with unifiedSearchButton.always = true r=urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335329\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_disable_sap.js", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_search_mode_url_like.js", "browser/components/urlbar/tests/browser-search/browser_oneOffs.js", "browser/components/urlbar/tests/browser-searchMode/browser_alias_replacement.js", "browser/components/urlbar/tests/browser-searchMode/browser_excludeResults.js", "browser/components/urlbar/tests/browser-searchMode/browser_heuristic.js", "browser/components/urlbar/tests/browser-searchMode/browser_newWindow.js", "browser/components/urlbar/tests/browser-searchMode/browser_omnibox.js", "browser/components/urlbar/tests/browser-searchMode/browser_preview.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_bounds.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_dynamicUnifiedSearchButton.js", "browser/components/urlbar/tests/browser-searchMode/browser_suggestions.js", "browser/components/urlbar/tests/browser/browser_tokenAlias.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_pickedSearchSuggestion.js", "browser/components/urlbar/tests/unit/test_UrlbarProviderAiChat.js", "browser/components/urlbar/tests/unit/test_UrlbarProviderSemanticHistorySearch.js", "browser/components/urlbar/tests/unit/test_providerHeuristicFallback.js"], "git_node": "4c66793656f81d259a0ce561791d55d11776a62b", "git_parents": ["a1ab390c5ee5b52d4e6e243f324d5ec2f01a1a70"], "node": "c3dcdd53e5b38ef4a235b1934426f9bbae86f388", "parents": ["93130876b207c6255d2eaac31b6b2d30baccc781"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083168 - Don't update the lightweight theme of a window that was unloaded. r=hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335262\n", "files": ["toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": "316632883ed25d1550ab07702f2422fba67ee7d9", "git_parents": ["4c66793656f81d259a0ce561791d55d11776a62b"], "node": "bcdb512e09516f1bf3f95c22ed7a91599646cd01", "parents": ["c3dcdd53e5b38ef4a235b1934426f9bbae86f388"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083670 - Detect every node added or removed by a mutation when looking for form changes. r=credential-management-reviewers,NeilDeakin\n\nSet.add only takes one argument, so only the first added or removed node of a\nmutation was considered, and the removed nodes were ignored when the same\nmutation also added nodes. Replacing the content of a form, e.g. with\nreplaceChildren() or innerHTML, was often not detected as a form change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335252\n", "files": ["browser/extensions/formautofill/test/browser/browser_dynamic_form_detection.js", "toolkit/components/formautofill/shared/FormAutofillHandler.sys.mjs"], "git_node": "5a0de6d2b3597551bfc28e6e5d26cbd779049126", "git_parents": ["316632883ed25d1550ab07702f2422fba67ee7d9"], "node": "7638f2d08b7274b725ee93434294f450ca86746e", "parents": ["bcdb512e09516f1bf3f95c22ed7a91599646cd01"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084986 - Part 1: Allocate Array.prototype without fixed elements. r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336164\n", "files": ["js/src/builtin/Array.cpp"], "git_node": "1c38296941a866749ca4bbc864956da54151ae1c", "git_parents": ["5a0de6d2b3597551bfc28e6e5d26cbd779049126"], "node": "109bc8eba33c5d47eafcf937148cb63f6087e406", "parents": ["7638f2d08b7274b725ee93434294f450ca86746e"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084986 - Part 2: Add realm fuses for indexed properties on Array.prototype and Object.prototype. r=spidermonkey-reviewers,iain\n\nThe fuse is popped when the prototype is mutated or when adding a dense element or\nindexed (sparse) property.\n\nThis lets us optimize element accesses in JIT and C++ code in later patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336165\n", "files": ["js/src/builtin/Object.cpp", "js/src/jit-test/tests/fuses/protos-have-no-indexed-props-1.js", "js/src/jit-test/tests/fuses/protos-have-no-indexed-props-2.js", "js/src/jit/CompilationDependencyTracker.h", "js/src/jit/WarpOracle.cpp", "js/src/vm/NativeObject.cpp", "js/src/vm/NativeObject.h", "js/src/vm/RealmFuses.cpp", "js/src/vm/RealmFuses.h", "js/src/vm/Watchtower.cpp", "js/src/vm/Watchtower.h"], "git_node": "d40dd7df8596da1828f6a188cfd4a99e801bed14", "git_parents": ["1c38296941a866749ca4bbc864956da54151ae1c"], "node": "f678793072e92f014b46d5334dc32f2e267d3637", "parents": ["109bc8eba33c5d47eafcf937148cb63f6087e406"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084986 - Part 3: Use the no-indexed-properties fuses for element hole reads. r=spidermonkey-reviewers,iain\n\n`GeneratePrototypeHoleGuards` guards that each object on the prototype chain has\nthe expected shape and no dense elements. If we reach `Array.prototype` or\n`Object.prototype` on the prototype chain, we can guard on the new fuse instead\nof guarding the rest of the chain. In the common case where this is the\nreceiver's prototype, this lets us skip all of the prototype guards.\n\nIn Warp, the fuse guard is a no-op because these are invalidating fuses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336166\n", "files": ["js/src/jit-test/tests/fuses/protos-have-no-indexed-props-3.js", "js/src/jit/CacheIR.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "5c7c22d6537b6b4006e329c8aa0ad228f7fcf802", "git_parents": ["d40dd7df8596da1828f6a188cfd4a99e801bed14"], "node": "6ddeb1a14b4cdd9405c9d27edfd543f076f450ba", "parents": ["f678793072e92f014b46d5334dc32f2e267d3637"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084986 - Part 4: Use the no-indexed-properties fuses for element adds and Array.prototype.push. r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336167\n", "files": ["js/src/jit-test/tests/fuses/protos-have-no-indexed-props-4.js", "js/src/jit/CacheIR.cpp"], "git_node": "c92edf2483b88e0c5a76d186a995193ff740c217", "git_parents": ["5c7c22d6537b6b4006e329c8aa0ad228f7fcf802"], "node": "9f9d10259eddeafa7ec6d81a46b53cd0404e0dd2", "parents": ["6ddeb1a14b4cdd9405c9d27edfd543f076f450ba"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084986 - Part 5: Use ArrayProtoHasNoIndexedPropsFuse in ObjectMayHaveExtraIndexedProperties. r=spidermonkey-reviewers,iain\n\nThis adds a fast path for plain arrays to `ObjectMayHaveExtraIndexedProperties`.\n\nOn JetStream 3 this function is called ~12.4 million times. The fast path handles\nmore than 98% of these calls. The remaining calls are for other objects such as\nproxies.\n\nMicro-benchmarks for various array builtins are up to 10% faster.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336168\n", "files": ["js/src/builtin/Array-inl.h", "js/src/builtin/Array.cpp", "js/src/builtin/Array.h", "js/src/jit-test/tests/fuses/protos-have-no-indexed-props-array-builtins.js"], "git_node": "189e4a92503bc69e070f5100632c231f2bb9924d", "git_parents": ["c92edf2483b88e0c5a76d186a995193ff740c217"], "node": "e8451a6abf98a6bb99a7afef98c358001fdb90b9", "parents": ["9f9d10259eddeafa7ec6d81a46b53cd0404e0dd2"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084986 - Part 6: Add StringProtoHasNoIndexedPropsFuse and use it for out-of-bounds string element reads. r=spidermonkey-reviewers,iain\n\nOn JetStream 3, pdfjs has about 239,000 out-of-bounds string reads (`string[idx]`)\nthat stood out in a CacheIR report Matt collected a while ago. With this patch we\ncan handle these in JIT code. It's hard to measure an improvement in the pdfjs score,\nbut this is easy to optimize now.\n\nA micro-benchmark with a loop that reads characters until it sees `undefined`\nimproves from 178 ms to 18.7 ms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336169\n", "files": ["js/src/builtin/String.cpp", "js/src/jit-test/tests/fuses/protos-have-no-indexed-props-5.js", "js/src/jit/CacheIR.cpp", "js/src/jit/CompilationDependencyTracker.h", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/jit/WarpOracle.cpp", "js/src/vm/RealmFuses.cpp", "js/src/vm/RealmFuses.h"], "git_node": "603d75ca9a17e2ce0cac85a40776c68e15a8add2", "git_parents": ["189e4a92503bc69e070f5100632c231f2bb9924d"], "node": "3c3ab04f1e0224290cbb4a945697854246ca0955", "parents": ["e8451a6abf98a6bb99a7afef98c358001fdb90b9"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069587 - Fix intermittent browser_shortcuts_add_search_engine.js fail by attaching listener earlier. r=urlbar-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335568\n", "files": ["browser/components/urlbar/tests/browser-search/browser_shortcuts_add_search_engine.js"], "git_node": "d5eef12b95bb18d5a0109479746d07a43f867005", "git_parents": ["603d75ca9a17e2ce0cac85a40776c68e15a8add2"], "node": "0fd1a5bbffff98d21ec6c24a768c7ae5b5198ec8", "parents": ["3c3ab04f1e0224290cbb4a945697854246ca0955"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073849 - Fix intermittent browser_dragdropURL.js fail by awaiting title change. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335593\n", "files": ["browser/components/urlbar/tests/browser/browser_dragdropURL.js"], "git_node": "e23b60f23b240dfc012042bea6dcf92c4a488c1c", "git_parents": ["d5eef12b95bb18d5a0109479746d07a43f867005"], "node": "855ee47ee434617c940c0511ee0cc5407c06bee3", "parents": ["0fd1a5bbffff98d21ec6c24a768c7ae5b5198ec8"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081032 - Fix intermittent browser_canonizeURL.js fail. r=urlbar-reviewers,adw\n\nStop calling #searchSourceToSap in #getOptionalSmartbarTelemetry because that caused the exception.\n\nAlso store a reference to the browser window in UrlbarParentController so accessing it via the actor doesn't throw an invalid state exception when the urlbar actor has been torn down. This should prevent similar issues in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335634\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/tests/browser/browser.toml"], "git_node": "9e79cf9c38ba015dc15c8ee56a48e9705128e684", "git_parents": ["e23b60f23b240dfc012042bea6dcf92c4a488c1c"], "node": "896021ae18e7916a0a211adf7d208d114c3ad782", "parents": ["855ee47ee434617c940c0511ee0cc5407c06bee3"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2083701 - Use moz-src for dom/push r=saschanaz,geckoview-reviewers,remote-settings-reviewers,omc-reviewers,leplatrem,m_kato,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335104\n", "files": ["browser/base/content/test/browser-performance/browser_startup.js", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js", "dom/push/PushBroadcastService.sys.mjs", "dom/push/PushComponents.sys.mjs", "dom/push/PushService.sys.mjs", "dom/push/PushServiceWebSocket.sys.mjs", "dom/push/components.conf", "dom/push/moz.build", "dom/push/test/xpcshell/head.js", "dom/push/test/xpcshell/test_broadcast_success.js", "dom/push/test/xpcshell/test_crypto.js", "dom/push/test/xpcshell/test_crypto_encrypt.js", "dom/push/test/xpcshell/test_handler_service.js", "dom/push/test/xpcshell/test_record.js", "mobile/shared/components/geckoview/GeckoViewPush.sys.mjs", "services/fxaccounts/FxAccountsCommands.sys.mjs", "services/settings/remote-settings.sys.mjs", "services/settings/test/unit/test_remote_settings_poll.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "5d37d8a7ac01f51004d25aab6f09ab85fc542512", "git_parents": ["9e79cf9c38ba015dc15c8ee56a48e9705128e684"], "node": "e962c65728092130d07c35d18f0b36773f30fd63", "parents": ["896021ae18e7916a0a211adf7d208d114c3ad782"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083668 - Don't throw when clearing the form autofill visibility observer after it was already cleared. r=credential-management-reviewers,NeilDeakin\n\nThe observer clears itself once all fields become invisible, for instance when\nthe form is removed. Clearing the form change observers on submission then\nthrew, which left the handler marked as waiting for the submission to complete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335256\n", "files": ["toolkit/components/formautofill/shared/FormAutofillHandler.sys.mjs"], "git_node": "7c8f469bb3d0d9495175eee6e2d22a0a3b4b84f7", "git_parents": ["5d37d8a7ac01f51004d25aab6f09ab85fc542512"], "node": "48f7eeb6152677a1b5c292cff405be956d49457e", "parents": ["e962c65728092130d07c35d18f0b36773f30fd63"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083162 - Look for an anchor element among the added and newly visible fields when the tracked fields were removed. r=credential-management-reviewers,NeilDeakin\n\nThe fallback passed an array of the two lists instead of their elements, and\nread the added nodes using a FORM_CHANGE_REASON key that doesn't exist, so it\neither threw or never found an anchor element.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335250\n", "files": ["browser/extensions/formautofill/test/browser/browser_dynamic_form_detection.js", "toolkit/components/formautofill/FormAutofillChild.sys.mjs"], "git_node": "b27b92527ea2aba60179b5c489d804c3d2835ef0", "git_parents": ["7c8f469bb3d0d9495175eee6e2d22a0a3b4b84f7"], "node": "ada55ef1561c124f41d87a9736f2ef5690f2aa6b", "parents": ["48f7eeb6152677a1b5c292cff405be956d49457e"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039320: Enable Compression Dictionaries by default r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336262\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "62da1e010e67cd434a94bec5d5b9a901b9330261", "git_parents": ["b27b92527ea2aba60179b5c489d804c3d2835ef0"], "node": "2f18f032d7d81dd645eace171f4da4cb800ed203", "parents": ["ada55ef1561c124f41d87a9736f2ef5690f2aa6b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085056 - Document where the New Tab bundle commands write and how to remove bundles left in the source tree. r=ai4dev-reviewers,fchasen,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336286\n", "files": ["browser/extensions/newtab/AGENTS.md", "browser/extensions/newtab/docs/index.md"], "git_node": "1a6eb82e758889375db40696d62b89af578aaebf", "git_parents": ["62da1e010e67cd434a94bec5d5b9a901b9330261"], "node": "966e1a251173572d6a7dd1addfa1b5c3f2206fb3", "parents": ["2f18f032d7d81dd645eace171f4da4cb800ed203"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2081841. Don't skip unchanged descendants of a fixed pos containing block without a container item in partial display list builds. r=layout-reviewers,emilio\n\nIn a partial build, an unmodified stacking context that is a fixed pos\ncontaining block assumes that if it has no stored building rect then nothing\nunder it changed, and builds its descendants with an empty dirty rect.\n\nhttps://searchfox.org/firefox-main/rev/2d5c2a4eb5d99a92249ec13370b1de9c1a77c0f8/layout/generic/nsIFrame.cpp#3442-3454\n\nBut ComputeRebuildRegion only stores that rect when the frame has a container\ndisplay item. Otherwise it keeps going up to the next stacking context without\nstoring anything.\n\nhttps://searchfox.org/firefox-main/rev/2d5c2a4eb5d99a92249ec13370b1de9c1a77c0f8/layout/painting/RetainedDisplayListBuilder.cpp#1015-1024\n\nSo unchanged descendants that overlap a modified frame are not rebuilt, and the\nmerge can put them in the wrong z-order. The view transition snapshot containing\nblock is one of these frames. It has no display items of its own, so we never\nstore a rect on it. At the end of the sidebar panel transition the animated\ngroups were rebuilt but the sidebar-box group was not, and it painted on top of\nthe launcher for a frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336360\n", "files": ["layout/painting/RetainedDisplayListBuilder.cpp", "layout/reftests/display-list/reftest.list", "layout/reftests/display-list/retained-dl-top-layer-fixed-pos-cb-1-ref.html", "layout/reftests/display-list/retained-dl-top-layer-fixed-pos-cb-1.html", "testing/web-platform/tests/html/semantics/popovers/popover-contain-paint-dynamic-z-order-ref.html", "testing/web-platform/tests/html/semantics/popovers/popover-contain-paint-dynamic-z-order.html"], "git_node": "8ecdc4312f0b089a3ecfdaf4ffa51225f6459463", "git_parents": ["1a6eb82e758889375db40696d62b89af578aaebf"], "node": "75638885f938a007ea11bfdc369749dd9556cf37", "parents": ["966e1a251173572d6a7dd1addfa1b5c3f2206fb3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084102 - Avoid parsing non-static attributes. r=firefox-svg-reviewers,longsonr\n\nJust like we avoid calling AfterSetAttr().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335562\n", "files": ["dom/base/Element.cpp", "dom/svg/SVGElement.cpp"], "git_node": "9b527ba8e50773a3a9f9bf12d1320337d761f765", "git_parents": ["8ecdc4312f0b089a3ecfdaf4ffa51225f6459463"], "node": "123e3c226b1cc0db9a05879733a8b850b3060dd8", "parents": ["75638885f938a007ea11bfdc369749dd9556cf37"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084614 - Use the ghost button disabled text color for toolbar buttons outside forced-colors media queries. r=desktop-theme-reviewers,akulyk\n\nThe `fill` rules stay in `@media (forced-colors)`: `--toolbarbutton-icon-fill-disabled` is computed at `:root`, so outside forced colors it would miss the Windows `body` override of `--toolbarbutton-icon-fill` in an accent-colored titlebar.\n\nThe `color` rules can't simply go, because `color: inherit` on `.toolbarbutton-1` and on the arrowscrollbox's `toolbarbutton` outranks `toolbarbutton.css`'s `:where([disabled])` rule; nothing overrides it in `organizer.css`, so that block goes.\n\nNo visible change in the default, in-app, forced-colors and native prefers-contrast themes. Under prefers-contrast with the in-app theme, disabled labels go from rgb(21, 20, 26) to rgb(22, 20, 35).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336048\n", "files": ["browser/themes/shared/toolbarbutton-icons.css", "browser/themes/windows/places/organizer.css", "toolkit/themes/shared/arrowscrollbox.css"], "git_node": "5bef8f111c29a9ad6e1b7d913aa409c91497474b", "git_parents": ["9b527ba8e50773a3a9f9bf12d1320337d761f765"], "node": "3eb6043690456efefd94d5110538a3829b508fa3", "parents": ["123e3c226b1cc0db9a05879733a8b850b3060dd8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084656 - Make toolbar button icons and high contrast menu and disabled text follow the surrounding text color. r=desktop-theme-reviewers,reusable-components-reviewers,akulyk\n\nThe light icon fill mixes 69% of `currentColor` with transparent, which matches the old `color.gray.70` over the default light toolbar. Nova keeps its fixed icon colors, so the `fill` rules stay in `@media (forced-colors)`.\n\nOutside Nova in light, hovered and pressed icons get 12-27 levels darker because the translucent fill composites over the hover and active backgrounds. Under prefers-contrast, menu items take the panel's text color. Under forced colors, disabled buttons in the panel's combined button items, such as the zoom controls, get GrayText like other disabled menu items.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336049\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/customizableui/panelUI-shared.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.tokens.json"], "git_node": "0758b1907e68f5cfc151dca1906a2393f24e9986", "git_parents": ["5bef8f111c29a9ad6e1b7d913aa409c91497474b"], "node": "0f079dcf7835eeba0624b52c981a04f33b59ed28", "parents": ["3eb6043690456efefd94d5110538a3829b508fa3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084963 - Honor the per-page size in PrintTargetSkPDF::BeginPage. r=lsalzman\n\nLike PrintTargetPDF used to do. We had no test at all for this pref,\namazing.\n\nAdd a browser test based on the one in comment 1 but rewritten to avoid\nhaving to do the temporary file dance or manually parse PDFs.\n\nCo-authored-by: Josh Pieper \u003cjjp@pobox.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336337\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "testing/web-platform/meta/css/css-page/__dir__.ini", "toolkit/components/printing/tests/browser.toml", "toolkit/components/printing/tests/browser_print_page_size_output.js", "toolkit/components/printing/tests/page_size_mixed.html"], "git_node": "5954e69d0f5ff177d08ced0b2c4315edb360435b", "git_parents": ["0758b1907e68f5cfc151dca1906a2393f24e9986"], "node": "010a090dd2b93d95d6b176f1082acd6efebdd1ea", "parents": ["0f079dcf7835eeba0624b52c981a04f33b59ed28"], "tags": []}, {"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2085260 - Update android nightly application-services version bump to e1f3ac925e24386bf6223dc5db2171169cad295a r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336384\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "19e0de21566bdb628995db899773d3618fb2e080", "git_parents": ["5954e69d0f5ff177d08ced0b2c4315edb360435b"], "node": "8a8ca8b4c6b89730cc377d48315e7739a6ca3746", "parents": ["010a090dd2b93d95d6b176f1082acd6efebdd1ea"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085095 - Share the readback surface between GPUVideoImage consumers. r=gfx-reviewers,lsalzman\n\nEach GetAsSourceSurface call previously did a new sync readback and\nallocated a new frame-sized Shmem in the remote decoder process, held\nuntil the consumer released it. Now it will be reused as long is it\nis kept alive by one or more consumers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336244\n", "files": ["gfx/layers/GPUVideoImage.h"], "git_node": "41f793ed574ab76e8cc4f825270bbf107ab4c728", "git_parents": ["19e0de21566bdb628995db899773d3618fb2e080"], "node": "13ec7c15a5ab14e6883b89f9c578643e8883c60f", "parents": ["8a8ca8b4c6b89730cc377d48315e7739a6ca3746"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067925 - Clear ImageBridgeParent's about-to-send flag after flushing async messages. r=gfx-reviewers,lsalzman\n\nThe flag was never reset after the first transaction, so NotifyNotUsed\nmessages generated outside of a transaction (e.g. on ReleaseCompositable)\nwere queued until the next transaction on that bridge. If none came, the\ncontent process kept the textures alive indefinitely, along with the\ndecoded frames they reference in the RDD process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336297\n", "files": ["gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/ImageBridgeParent.cpp"], "git_node": "e1a1356c1fdd25385024145d8c393bba1b7ce3ce", "git_parents": ["41f793ed574ab76e8cc4f825270bbf107ab4c728"], "node": "06fd04be6e9910541585ba1b344eda36e294ef3e", "parents": ["13ec7c15a5ab14e6883b89f9c578643e8883c60f"], "tags": []}], "date": 1792772249, "git_changesets": ["a1ab390c5ee5b52d4e6e243f324d5ec2f01a1a70", "4c66793656f81d259a0ce561791d55d11776a62b", "316632883ed25d1550ab07702f2422fba67ee7d9", "5a0de6d2b3597551bfc28e6e5d26cbd779049126", "1c38296941a866749ca4bbc864956da54151ae1c", "d40dd7df8596da1828f6a188cfd4a99e801bed14", "5c7c22d6537b6b4006e329c8aa0ad228f7fcf802", "c92edf2483b88e0c5a76d186a995193ff740c217", "189e4a92503bc69e070f5100632c231f2bb9924d", "603d75ca9a17e2ce0cac85a40776c68e15a8add2", "d5eef12b95bb18d5a0109479746d07a43f867005", "e23b60f23b240dfc012042bea6dcf92c4a488c1c", "9e79cf9c38ba015dc15c8ee56a48e9705128e684", "5d37d8a7ac01f51004d25aab6f09ab85fc542512", "7c8f469bb3d0d9495175eee6e2d22a0a3b4b84f7", "b27b92527ea2aba60179b5c489d804c3d2835ef0", "62da1e010e67cd434a94bec5d5b9a901b9330261", "1a6eb82e758889375db40696d62b89af578aaebf", "8ecdc4312f0b089a3ecfdaf4ffa51225f6459463", "9b527ba8e50773a3a9f9bf12d1320337d761f765", "5bef8f111c29a9ad6e1b7d913aa409c91497474b", "0758b1907e68f5cfc151dca1906a2393f24e9986", "5954e69d0f5ff177d08ced0b2c4315edb360435b", "19e0de21566bdb628995db899773d3618fb2e080", "41f793ed574ab76e8cc4f825270bbf107ab4c728", "e1a1356c1fdd25385024145d8c393bba1b7ce3ce"], "user": "sstanca@mozilla.com"}, "45640": {"changesets": [{"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081982. r=edgar\" for causing hazard bustages in StyleSheet.cpp.\n\nThis reverts commit 0cd910133ec7afe53bb66f38c9436bb6083ea5da.\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "c1ac30ba9533ac20ad7d22efb4c6a48ae91ad2fd", "git_parents": ["e1a1356c1fdd25385024145d8c393bba1b7ce3ce"], "node": "267be105fce6390b566b5510d17a2a271e25fe25", "parents": ["06fd04be6e9910541585ba1b344eda36e294ef3e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084963 - Fix test annotations.\n", "files": ["testing/web-platform/meta/css/css-page/__dir__.ini", "testing/web-platform/meta/css/css-page/page-name-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-landscape-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-002-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-003-print.html.ini", "testing/web-platform/meta/css/css-page/page-size-015-print.tentative.html.ini"], "git_node": "134b5b571ed437f50b82b5725a2ac990c9bca8ce", "git_parents": ["c1ac30ba9533ac20ad7d22efb4c6a48ae91ad2fd"], "node": "3b8e4ab641da3b52fb67f7a60c1311f5412c2fa1", "parents": ["267be105fce6390b566b5510d17a2a271e25fe25"], "tags": []}], "date": 1792772428, "git_changesets": ["c1ac30ba9533ac20ad7d22efb4c6a48ae91ad2fd", "134b5b571ed437f50b82b5725a2ac990c9bca8ce"], "user": "sstanca@mozilla.com"}, "45641": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085249 - Clean up PrintTarget initialization. r=lsalzman\n\nTrivial clean-ups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336339\n", "files": ["gfx/thebes/PrintTarget.cpp", "gfx/thebes/PrintTarget.h"], "git_node": "c2e31abbb31289b9d045e421943c36558d2b7afc", "git_parents": ["e1a1356c1fdd25385024145d8c393bba1b7ce3ce"], "node": "ea47843de85c4dfca44b2e35027fc09e0d66e0ca", "parents": ["06fd04be6e9910541585ba1b344eda36e294ef3e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085249 - Remove PrintTarget::mSize. r=lsalzman\n\nThe print frame already honors the pref, and other than that it was only\nused to create the reference draw target, and in a roundabout way to\ncompute the nsDeviceContext size, which can just call into\nnsDeviceContext.\n\nmacOS GetPaperSize should match (we always print through PDF on macOS\nanyway nowadays).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336340\n", "files": ["gfx/src/nsDeviceContext.cpp", "gfx/thebes/PrintTarget.cpp", "gfx/thebes/PrintTarget.h", "gfx/thebes/PrintTargetRecording.cpp", "gfx/thebes/PrintTargetRecording.h", "gfx/thebes/PrintTargetSkPDF.cpp", "gfx/thebes/PrintTargetSkPDF.h", "gfx/thebes/PrintTargetWindows.cpp", "gfx/thebes/PrintTargetWindows.h", "layout/generic/PrintedSheetFrame.cpp", "widget/android/nsDeviceContextAndroid.cpp", "widget/cocoa/nsDeviceContextSpecX.h", "widget/cocoa/nsDeviceContextSpecX.mm", "widget/gtk/nsDeviceContextSpecG.cpp", "widget/nsDeviceContextSpecProxy.cpp", "widget/nsIDeviceContextSpec.h", "widget/nsIPrintSettings.idl", "widget/nsPrintSettingsImpl.cpp", "widget/windows/nsDeviceContextSpecWin.cpp"], "git_node": "a555661592f48bfc14e07cac27391d4467eada5b", "git_parents": ["c2e31abbb31289b9d045e421943c36558d2b7afc"], "node": "3b6cc26ffd158e100f3e4de5c7aced1a4cbded59", "parents": ["ea47843de85c4dfca44b2e35027fc09e0d66e0ca"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084961 - Make gfx.font_rendering.fontations.enabled into a live pref (not requiring restart) r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336154\n", "files": ["gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxPlatformFontList.cpp", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "78c6f85c2127fdc535cee747b176830c2cb5e495", "git_parents": ["a555661592f48bfc14e07cac27391d4467eada5b"], "node": "2fe120db230ff834f38956e021170fa4703fd9b7", "parents": ["3b6cc26ffd158e100f3e4de5c7aced1a4cbded59"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081982. r=edgar\" for causing hazard bustages in StyleSheet.cpp.\n\nThis reverts commit 0cd910133ec7afe53bb66f38c9436bb6083ea5da.\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "6dfef3799c6b8854bb1510ce7b6c3f20e2095263", "git_parents": ["78c6f85c2127fdc535cee747b176830c2cb5e495"], "node": "7e2cc2970aaf0d4d14828796e44e795357f626fa", "parents": ["2fe120db230ff834f38956e021170fa4703fd9b7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084963 - Fix test annotations.\n", "files": ["testing/web-platform/meta/css/css-page/__dir__.ini", "testing/web-platform/meta/css/css-page/page-name-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-landscape-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-002-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-003-print.html.ini", "testing/web-platform/meta/css/css-page/page-size-015-print.tentative.html.ini"], "git_node": "286e75dd4061ced2f3e65c422853f1e7ed9e2f16", "git_parents": ["6dfef3799c6b8854bb1510ce7b6c3f20e2095263"], "node": "c6f4a1bef15f48d1fc911b39ab2206ee7ef1af6b", "parents": ["7e2cc2970aaf0d4d14828796e44e795357f626fa"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1876483 - Stop calling nsIURIMutator.setSpec outside necko, and add a lint to prevent new callers. r=necko-reviewers,geckoview-reviewers,webrtc-reviewers,places-reviewers,layout-reviewers,dshin,bwc,m_kato,mak,ini\n\nsetSpec() hands a spec to whatever URI implementation the mutator wraps, even\none that was never meant to parse it (e.g. an http:// spec on a data: URI).\nCallers outside necko now go through NS_NewURI()/Services.io.newURI(), which\ndispatch on the scheme, and the new avoid-uri-setspec lint (run in CI) rejects\nnew callers. setSpec itself stays: the per-scheme NewURI paths still need it.\n\nNS_NewURI() normalizes a default port to -1, so WebrtcTCPSocket now uses\nNS_GetRealPort() when creating the transport.\n\nHistory no longer re-parses the visited URI. If triggeringSponsoredURL fails to\nparse or is on a different base domain, the visit is still recorded but the\nsponsored URL is cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323972\n", "files": ["browser/components/downloads/DownloadsCommon.sys.mjs", "browser/components/newtab/test/browser/browser_sponsored_annotation.js", "dom/media/webrtc/transport/ipc/WebrtcTCPSocket.cpp", "dom/media/webrtc/transport/test/webrtcproxychannel_unittest.cpp", "dom/network/TCPSocket.cpp", "dom/quota/ActorsParent.cpp", "dom/serializers/tests/mochitest/test_bug422403-1.html", "dom/serializers/tests/mochitest/test_bug422403-2.xhtml", "dom/serializers/tests/mochitest/test_bug424359-1.html", "dom/serializers/tests/mochitest/test_bug424359-2.html", "dom/serializers/tests/mochitest/test_bug498433.html", "layout/generic/nsImageFrame.cpp", "mobile/android/components/geckoview/GeckoViewContentChannelChild.cpp", "netwerk/base/nsIURIMutator.idl", "netwerk/cache2/Dictionary.cpp", "taskcluster/kinds/source-test/mozlint.yml", "toolkit/components/places/History.cpp", "tools/lint/test/python.toml", "tools/lint/test/test_uri_setspec.py", "tools/lint/uri-setspec.yml"], "git_node": "fe252098380de99cbdbbcdcfc5ec7f97f3247ac7", "git_parents": ["286e75dd4061ced2f3e65c422853f1e7ed9e2f16"], "node": "b157d989fdf999dec0d8c807e2ecf75b80936822", "parents": ["c6f4a1bef15f48d1fc911b39ab2206ee7ef1af6b"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2085243. Update the wpt metadata for 3D transform tests that now pass or only need a little fuzz. r=layout-reviewers,dshin\n\nttwf-css-3d-polygon-cycle.html was marked as failing. The test checks that\nthree rectangles that overlap each other in a cycle are split and drawn in\nthe right order, and we get that right. What is left is a slight difference\nin how the 3D transformed rectangles are rendered. The test's own fuzzy\nallows a max difference of 113 over 674 pixels; we differ by up to 138 over\n589 pixels (116 over 388 with software WebRender), so raise the max\ndifference to 138.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336333\n", "files": ["testing/web-platform/meta/css/css-masking/mask-image/mask-image-3d.html.ini", "testing/web-platform/meta/css/css-transforms/3d-point-mapping-overlapping.html.ini", "testing/web-platform/meta/css/css-transforms/backface-visibility-001.html.ini", "testing/web-platform/meta/css/css-transforms/backface-visibility-hidden-animated-001.html.ini", "testing/web-platform/meta/css/css-transforms/inline-with-filter-and-hidden-backface.html.ini", "testing/web-platform/meta/css/css-transforms/preserve-3d-flat-grouping-properties-containing-block.html.ini", "testing/web-platform/meta/css/css-transforms/preserve-3d-flat-grouping-properties.html.ini", "testing/web-platform/meta/css/css-transforms/preserve3d-and-flattening-z-order-005.html.ini", "testing/web-platform/meta/css/css-transforms/preserve3d-and-flattening-z-order-008.html.ini", "testing/web-platform/meta/css/css-transforms/scroll-preserve-3d.html.ini", "testing/web-platform/meta/css/css-transforms/transform-3d-rotateY-stair-above-001.xht.ini", "testing/web-platform/meta/css/css-transforms/transform-3d-rotateY-stair-below-001.xht.ini", "testing/web-platform/meta/css/css-transforms/transform3d-backface-visibility-008.html.ini", "testing/web-platform/meta/css/css-transforms/transform3d-perspective-001.html.ini", "testing/web-platform/meta/css/css-transforms/transform3d-perspective-009.html.ini", "testing/web-platform/meta/css/css-transforms/transform3d-preserve3d-001.html.ini", "testing/web-platform/meta/css/css-transforms/transform3d-sorting-006.html.ini", "testing/web-platform/meta/css/css-transforms/ttwf-css-3d-polygon-cycle.html.ini"], "git_node": "a0768f03d5eda2996a96ec3455aff95d8486feb3", "git_parents": ["fe252098380de99cbdbbcdcfc5ec7f97f3247ac7"], "node": "7b2dd4bbbadb5f1d4c048cfb2a5a93c80f9d1ee7", "parents": ["b157d989fdf999dec0d8c807e2ecf75b80936822"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085188 - Stop allowing D3D11 compositing with SWGL if a D3D11 compositor cannot be created. r=gfx-reviewers,lsalzman\n\nWhen creating a D3D11 compositor for SWGL failed, the window silently\nfell back to plain SWGL, while gfxVars::AllowSoftwareWebRenderD3D11 kept\nclaiming otherwise. Producers such as video decoders would then share\nD3D11 textures that the window cannot draw. Clear the var instead,\nunless the failure is due to a device reset, which is recoverable. This\nwill recreate the compositors for all windows so they agree. Also free\nthe SWGL context, which was leaked on failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336310\n", "files": ["gfx/2d/Logging.h", "gfx/2d/Types.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/webrender_bindings/RenderCompositorD3D11SWGL.cpp", "gfx/webrender_bindings/WebRenderTypes.h"], "git_node": "f6ee2bf4ad21e749a2ff2ea42d30ad38e119aab8", "git_parents": ["a0768f03d5eda2996a96ec3455aff95d8486feb3"], "node": "2d65a2b60e2af9ba713016c617f5fccf87890c65", "parents": ["7b2dd4bbbadb5f1d4c048cfb2a5a93c80f9d1ee7"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085382 - Avoid ignoring subsequent WebRender errors after failing to initialize video overlay support. r=gfx-reviewers,lsalzman\n\nRenderThread::HandleWebRenderError ignores all further errors until every\nrenderer is destroyed, because it expects the error to disable\nWebRender. A VIDEO_OVERLAY error only disables video overlays, so after\nfailing to initialize video overlay support in DCLayerTree, any later\nfatal error such as RENDER was silently dropped and we never fell back.\nUse NotifyWebRenderError like the other video overlay failures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336396\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp"], "git_node": "7876c1cabdfcbdeef76ad6cdce8375d014b85f2d", "git_parents": ["f6ee2bf4ad21e749a2ff2ea42d30ad38e119aab8"], "node": "0135872cfef340b3148a87ca29c71dbc04ba849e", "parents": ["2d65a2b60e2af9ba713016c617f5fccf87890c65"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080540 - Add a zero prefix result layout with temporal suggestions below recent searches - r=adw,urlbar-reviewers\n\nProduct would like the following:\n- In the zero prefix case, expand the number of results to 13\n- Have Temporal suggestions appear below Recent Suggestions\n- In the case where top sites, recent searches, and temporal searches could\n  all show maximal results, Top Sites should show 7 results, recent searches\n  3 results, and temporal searches 3 results.\n- If Temporal Searches has the capacity to show more results, it should show\n  5 results.\n- If the user has set browser.urlbar.maxRichResults, respect it in the zero\n  prefix view instead of temporal.zeroPrefixMaxRichResults.\n- If Trending could co-exist with Temporal, show Temporal first, then Trending\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335701\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarProviderQuickSuggest.sys.mjs", "browser/components/urlbar/UrlbarProviderTopSites.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarContentPrefs.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/metrics.yaml", "browser/components/urlbar/private/TemporalSuggestions.sys.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_groups.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head-groups.js", "browser/components/urlbar/tests/quicksuggest/browser/browser.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal_zeroPrefixLayout.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js", "browser/components/urlbar/tests/unit/test_UrlbarPrefs.js"], "git_node": "67ec8d40a67a15d41a8beb7e87abfdebd972bd3b", "git_parents": ["7876c1cabdfcbdeef76ad6cdce8375d014b85f2d"], "node": "d32ee1b809748ebfa96080128b3ff9c6acb72823", "parents": ["0135872cfef340b3148a87ca29c71dbc04ba849e"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080532 - Show a \"Seasonal searches\" row label above temporal search suggestions. r=urlbar-reviewers,fluent-reviewers,adw,bolsson\n\nUnlike other search suggestion labels, it shows even when nothing precedes the\nrows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332882\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/content/enUS-searchFeatures.ftl", "browser/components/urlbar/private/TemporalSuggestions.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js"], "git_node": "626dadf39f6a94624c690f40a34c449fe3238831", "git_parents": ["67ec8d40a67a15d41a8beb7e87abfdebd972bd3b"], "node": "65da89df2929db4d51869926b39c7efc5f157248", "parents": ["d32ee1b809748ebfa96080128b3ff9c6acb72823"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080535 - Add a \"Don't show\" result menu command to temporal search suggestions. r=urlbar-reviewers,fluent-reviewers,adw,bolsson\n\nThe strings are in the en-US-only enUS-searchFeatures.ftl, so they aren't\nlocalized.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332883\n", "files": ["browser/components/urlbar/content/enUS-searchFeatures.ftl", "browser/components/urlbar/private/TemporalSuggestions.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js"], "git_node": "c5cf911f089b8e21d2f7a77b830e87618b5fca30", "git_parents": ["626dadf39f6a94624c690f40a34c449fe3238831"], "node": "42458ee1631983f1db279f102faa9c01cf24c98f", "parents": ["65da89df2929db4d51869926b39c7efc5f157248"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "9f4f2b1af66f88b69c94e4496f01220e89dad574", "git_parents": ["c5cf911f089b8e21d2f7a77b830e87618b5fca30", "134b5b571ed437f50b82b5725a2ac990c9bca8ce"], "node": "2401883ed20032655ca8a1489cafcea05cc3a0df", "parents": ["42458ee1631983f1db279f102faa9c01cf24c98f", "3b8e4ab641da3b52fb67f7a60c1311f5412c2fa1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085249 - Set the base class print settings in nsDeviceContextSpecX::Init\n", "files": ["widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "f80084cb21952db0cf9fa775d19727b5c8d51a80", "git_parents": ["9f4f2b1af66f88b69c94e4496f01220e89dad574"], "node": "68f01c095fd2360458d71f29bf6b5f6398a3c35d", "parents": ["2401883ed20032655ca8a1489cafcea05cc3a0df"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085249 - Move cairo handling from PrintTarget to PrintTargetWindows. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336390\n", "files": ["gfx/thebes/PrintTarget.cpp", "gfx/thebes/PrintTarget.h", "gfx/thebes/PrintTargetRecording.cpp", "gfx/thebes/PrintTargetSkPDF.cpp", "gfx/thebes/PrintTargetWindows.cpp", "gfx/thebes/PrintTargetWindows.h"], "git_node": "85c3ea7236b22c3db0186bee2c3463d0374975b8", "git_parents": ["f80084cb21952db0cf9fa775d19727b5c8d51a80"], "node": "fb806f14ff9e1bab10e600d911695e33de1b643b", "parents": ["68f01c095fd2360458d71f29bf6b5f6398a3c35d"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081416 - WebGPU: Avoid redundant texture import code r=webgpu-reviewers,teoxoy\n\nRefactors texture import code so that it can be reused for swapchain\nsurfaces and external textures.\n\n- Identical calls to `wgpu_server_ensure_shared_texture_for_swap_chain`\n  previously existed in all three `create_texture_with_shared_texture_*`\n  functions. These calls, and the rest of the swapchain shared texture\n  creation code in handling of `CreateTexture`, move into a new function\n  `create_shared_texture_for_swap_chain`.\n- The code at the start of the `create_texture_with_shared_texture_*`\n  functions that obtains the platform shared texture resource from\n  the prepared swap chain surface moves out of those functions into\n  `create_shared_texture_for_swap_chain`.\n- The `IOSurface` swap chain path previously set\n  `MTLTextureUsage::PixelFormatView`. `wgpu` uses that only for\n  depth/stencil textures. I don't see why it is needed for swap chain\n  textures (the Metal docs say not to use it for component swizzle or\n  sRGB conversion), so I've left it out of the combined import.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333945\n", "files": ["Cargo.lock", "dom/webgpu/ExternalTexture.cpp", "gfx/wgpu_bindings/Cargo.toml", "gfx/wgpu_bindings/src/lib.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "aed14