.rs", "third_party/rust/nss-rs/src/hmac.rs", "third_party/rust/nss-rs/src/lib.rs", "third_party/rust/nss-rs/src/pbkdf2.rs", "third_party/rust/nss-rs/tests/handshake.rs", "third_party/rust/nss-rs/tests/hmac.rs", "third_party/rust/test-fixture/.cargo-checksum.json", "third_party/rust/test-fixture/src/lib.rs"], "git_node": "72695a99ec5b06bd0026871354bb81ee58034876", "git_parents": ["850a3a3cbf9e1369bd074f879a4b5fceb03ed6b6"], "node": "b59ca2d47ea5c6baf70b9e422e3afb2a92ae6a65", "parents": ["5d7231fa89f462daa3a9b3d47aaaff6605bd4adc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085967 - Disable ClangIR when building the clang toolchains. r=firefox-build-system-reviewers,glandium\n\nLLVM main now enables ClangIR by default, which pulls MLIR into clang and pushes the Windows clang.exe past\nlld-link's limit of 65535 exported symbols when LLVM_EXPORT_SYMBOLS_FOR_PLUGINS is on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336949\n", "files": ["build/build-clang/build-clang.py"], "git_node": "f852d1e2ffdfcddfbb4900d8f026a0f90a50049f", "git_parents": ["72695a99ec5b06bd0026871354bb81ee58034876"], "node": "c0628f23371aba9d22a12c2189324ca3e5e5ef2c", "parents": ["b59ca2d47ea5c6baf70b9e422e3afb2a92ae6a65"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2043033 - Add wpt crashtests and reftests for various form elements with line-clamp applied. r=dshin,AlaskanEmily\" for causing wpt failures at line-clamp-form-fieldset-003.tentative.html\n\nThis reverts commit 67ff71a7a9c6d39a2a779d89085c8fc7c49f86a9.\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-button-001.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-button-002.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-button-003.tentative.html", "testing/web-plat