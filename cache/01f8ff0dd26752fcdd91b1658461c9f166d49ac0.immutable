/phabricator.services.mozilla.com/D333734\n", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZPublicUtils.cpp", "gfx/layers/apz/src/APZSampler.cpp", "gfx/layers/apz/src/APZUpdater.cpp", "gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/layers/apz/src/FocusTarget.cpp", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/layers/apz/util/APZThreadUtils.cpp", "gfx/layers/apz/util/CheckerboardReportService.cpp", "gfx/layers/apz/util/ChromeProcessController.cpp", "gfx/layers/apz/util/ScrollLinkedEffectDetector.cpp"], "git_node": "3e9958e80af311d9fa374a4e2cc0dceae40fb3b1", "git_parents": ["f375225faa72451a4e9656552d3ecb7088379da1"], "node": "fd889cee0a5c7a03da1a7dec7a2f55f905fd76a0", "parents": ["04c4068aebe42683f313e006a1c69b18a416f84b"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade layers/ipc thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333735\n", "files": ["gfx/layers/ipc/APZBridgeChild.cpp", "gfx/layers/ipc/APZBridgeParent.cpp", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerParent.cpp", "gfx/layers/ipc/APZChild.cpp", "gfx/layers/ipc/CanvasChild.cpp", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/CanvasTranslator.h", "gfx/layers/ipc/CompositableForwarder.h", "gfx/layers/ipc/CompositableTransactionParent.cpp", "gfx/layers/ipc/CompositableTransactionParent.h", "gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorManagerChild.cpp", "gfx/layers/ipc/CompositorManagerChild.h", "gfx/layers/ipc/CompositorManagerParent.cpp", "gfx/layers/ipc/CompositorThread.cpp", "gfx/layers/ipc/CompositorVsyncScheduler.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ISurfaceAllocator.cpp", "gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/ImageBridgeChild.cpp", "gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/layers/ipc/KnowsCompositor.h", "gfx/layers/ipc/LayerTreeOwnerTracker.cpp", "gfx/layers/ipc/RefCountedShmem.cpp", "gfx/layers/ipc/RemoteContentController.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/layers/ipc/SharedSurfacesChild.cpp", "gfx/layers/ipc/SharedSurfacesChild.h", "gfx/layers/ipc/SharedSurfacesParent.cpp", "gfx/layers/ipc/UiCompositorControllerChild.cpp", "gfx/layers/ipc/UiCompositorControllerParent.cpp", "gfx/layers/ipc/VideoBridgeChild.cpp", "gfx/layers/ipc/VideoBridgeParent.cpp"], "git_node": "594d0ea751f076eac79c43b77ea0caa134491fb1", "git_parents": ["3e9958e80af311d9fa374a4e2cc0dceae40fb3b1"], "node": "489ed2bb74895cf0eefdc84bdc6347fb4e234418", "parents": ["fd889cee0a5c7a03da1a7dec7a2f55f905fd76a0"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Convert some  assertions to MOZ_RELEASE_ASSERT (part 1). r=gfx-reviewers,bradwerth\n\nConvert MOZ_ASSERT to MOZ_RELEASE_ASSERT for critical graphics resource assertions\nthat must hold even in release builds. These changes address cases where:\n- Output parameters from wr_window_new() must be valid (lines 317, 322, 323)\n- Memory mapping operations must succeed (line 510)\n\nThese cause immediate crashes in release builds if assertions fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333727\n", "files": ["gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "d372708d9ba3be664eb5886aba0c25159aa6b8ac", "git_parents": ["594d0ea751f076eac79c43b77ea0caa134491fb1"], "node": "9eef9742c466e29da328d89716312f416cb2ad0d", "parents": ["489ed2bb74895cf0eefdc84bdc6347fb4e234418"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Convert some resource assertions to MOZ_RELEASE_ASSERT (part 2). r=gfx-reviewers,bradwerth\n\nThese assertions guard critical resources where null would cause crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333728\n", "files": ["gfx/layers/AndroidImageConsumer.cpp", "gfx/vr/VRManager.cpp", "gfx/vr/VRServiceHost.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.cpp", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "cd37d0aa839e442cce86e6ba53d0b15ef699c692", "git_parents": ["d372708d9ba3be664eb5886aba0c25159aa6b8ac"], "node": "bdc5cc02ea6a2e176af628870b70834d0381a38a", "parents": ["9eef9742c466e29da328d89716312f416cb2ad0d"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Fix contradictory assertion and upgrade shared memory checks to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nRemove contradictory MOZ_ASSERT in RenderTextureHostWrapper::EnsureTextureHost() that immediately precedes a null check. The null check is the actual guard and is already logging the error.\n\nConvert shared memory assertions to MOZ_RELEASE_ASSERT in VRManager since mShmem is accessed without fallback in the subsequent code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333729\n", "files": ["gfx/vr/VRManager.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp"], "git_node": "078ecc8083b4fad4283608ab098858b9b732381e", "git_parents": ["cd37d0aa839e442cce86e6ba53d0b15ef699c692"], "node": "9ce1433dbe8c3b21e9d34e32c25a301791f37b10", "parents": ["bdc5cc02ea6a2e176af628870b70834d0381a38a"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2081780: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "a6a83c08600743b2b8f8e2f952a84866a3315b71", "git_parents": ["078ecc8083b4fad4283608ab098858b9b732381e"], "node": "795ce7374920fbd3986f5ee79270510e9ebd96b2", "parents": ["9ce1433dbe8c3b21e9d34e32c25a301791f37b10"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084970 - Test that GMP crashes produce a minidump r=crashreporting-reviewers,media-playback-reviewers,aosmond,afranchuk\n\nSince the GMP processes have different characteristics than other\nprocesses, notably their sandboxing rules, we need to check that we can\nstill produce minidumps when either the sandbox or the crash reporter\nchange.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336221\n", "files": ["dom/media/fake-cdm/cdm-test-decryptor.cpp", "dom/media/gtest/TestCDMStorage.cpp"], "git_node": "a96e6f836f37aa28016d9d0289df1f5b63e12e16", "git_parents": ["a6a83c08600743b2b8f8e2f952a84866a3315b71"], "node": "85ee295986ac3f3abfd610b0dee6ab2389b5c605", "parents": ["795ce7374920fbd3986f5ee79270510e9ebd96b2"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Intern paths in the display list builder. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330858\n", "files": ["gfx/webrender_bindings/webrender_ffi.h", "gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender_api/src/interning.rs"], "git_node": "21517ffd5b2cb055319edc5c2c968291b6fe5905", "git_parents": ["a96e6f836f37aa28016d9d0289df1f5b63e12e16"], "node": "2d3aee1d91ec52867773836106d2cc9de7d84c6f", "parents": ["85ee295986ac3f3abfd610b0dee6ab2389b5c605"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078306 - Path clip item plumbing. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330859\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/quad_clip.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "0e11a06dd86e1303ad165ed9d13e6e8dafd41395", "git_parents": ["21517ffd5b2cb055319edc5c2c968291b6fe5905"], "node": "dbd5e64ae8b4d05d9ac69064ecf67c64e0a53374", "parents": ["2d3aee1d91ec52867773836106d2cc9de7d84c6f"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Integrate paths with hit testing. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330861\n", "files": ["gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/scene_building.rs"], "git_node": "fc501c52f0cd23b85014e6f3b1978acc8fb84f91", "git_parents": ["0e11a06dd86e1303ad165ed9d13e6e8dafd41395"], "node": "24aa24c5599c331fd42edc4b04b7be121363c94f", "parents": ["dbd5e64ae8b4d05d9ac69064ecf67c64e0a53374"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Rasterize path clips with the path tiler. r=gfx-reviewers,gw\n\nPath clips on quad render tasks and clip masks push a path clip sub-task. The path is tiled when the task is added to its render target, so that the tiles can be positioned relative to the task and their edges go straight into the frame's edge buffer.\n\nWhen the clip's transform to the raster space can't be computed, the clip falls back to the bounds of the path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330867\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/path_tiler.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs"], "git_node": "e48e3b8963cada28a09b886429e0152eeca57002", "git_parents": ["fc501c52f0cd23b85014e6f3b1978acc8fb84f91"], "node": "3ecb317dffbd11be400e42556a818354b58c7034", "parents": ["24aa24c5599c331fd42edc4b04b7be121363c94f"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add path clip reftests. r=gfx-reviewers,gw\n\nWrench yaml clips get a path property with a rect, a fill rule and path data in a subset of the SVG path syntax.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330870\n", "files": ["gfx/wr/wrench/reftests/clip/path-and-rounded-rect-ref.yaml", "gfx/wr/wrench/reftests/clip/path-and-rounded-rect.yaml", "gfx/wr/wrench/reftests/clip/path-conflation-ref.yaml", "gfx/wr/wrench/reftests/clip/path-conflation.yaml", "gfx/wr/wrench/reftests/clip/path-curves-ref.yaml", "gfx/wr/wrench/reftests/clip/path-curves.yaml", "gfx/wr/wrench/reftests/clip/path-fill-rules-ref.yaml", "gfx/wr/wrench/reftests/clip/path-fill-rules.yaml", "gfx/wr/wrench/reftests/clip/path-firefox-logo.png", "gfx/wr/wrench/reftests/clip/path-firefox-logo.svg", "gfx/wr/wrench/reftests/clip/path-firefox-logo.yaml", "gfx/wr/wrench/reftests/clip/path-fractional-rect-ref.yaml", "gfx/wr/wrench/reftests/clip/path-fractional-rect.yaml", "gfx/wr/wrench/reftests/clip/path-large-prim-ref.yaml", "gfx/wr/wrench/reftests/clip/path-large-prim.yaml", "gfx/wr/wrench/reftests/clip/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "1c13e09015d3d6bcfb4bbaf9d021ded44c2835c1", "git_parents": ["e48e3b8963cada28a09b886429e0152eeca57002"], "node": "02d75c12e299ebb32d622d44600c376aa4917442", "parents": ["3ecb317dffbd11be400e42556a818354b58c7034"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Render clip-path path() and shape() with WebRender path clips. r=layout-reviewers,emilio\n\nInstead of rasterizing a mask image on the CPU, the path is built with SVGPathData and sent to WebRender as a path clip. This is behind the gfx.webrender.paths pref, which is disabled by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330873\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "layout/painting/nsDisplayList.cpp", "layout/svg/SVGUtils.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "1cf826f58b64effca9618a85b3df67d191ff4ffa", "git_parents": ["1c13e09015d3d6bcfb4bbaf9d021ded44c2835c1"], "node": "b8ca6a7b644330509169bed9b8f0ee9157efccc8", "parents": ["02d75c12e299ebb32d622d44600c376aa4917442"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2078306 - Add ssaa4 and ssaa8 anti-aliasing modes to the path tile shader. r=gfx-reviewers,gw\n\nAnalytical anti-aliasing has conflation artifacts where edges overlap, so path\ntiles are rasterized with 8 samples per pixel by default, and 4 on Android.\nThe gfx.webrender.path-aa.samples pref selects the mode. Software WebRender\nonly builds the ssaa4 variant.\n\nThe fuzziness of the wrench path clip reftests is adjusted to the sampled anti-aliasing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330874\n", "files": ["gfx/config/gfxVars.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/wr/webrender/res/path_tile.glsl", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/webrender_build/src/shader_features.rs", "gfx/wr/wrench/reftests/clip/reftest.list", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "bafd2c77f8472b6a9749358084a0f268a12ec913", "git_parents": ["1cf826f58b64effca9618a85b3df67d191ff4ffa"], "node": "d5a49816e94229b28e36a9a4737f63f1d0fb6714", "parents": ["b8ca6a7b644330509169bed9b8f0ee9157efccc8"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086004 - Update android nightly application-services version bump to 11317a28eb2bad473290ee416b94f1724c2122e6 r=release-managers,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337008\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "7be88b93d7851c3c0dedf58079497b44679a5793", "git_parents": ["bafd2c77f8472b6a9749358084a0f268a12ec913"], "node": "40dbd119ff54dedba605988151bae9a762a63e37", "parents": ["d5a49816e94229b28e36a9a4737f63f1d0fb6714"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081780: apply code formatting via Lando\" for causing lint failures in SharedSurfacesParent.cpp\n\nThis reverts commit a6a83c08600743b2b8f8e2f952a84866a3315b71.\n\nRevert \"Bug 2081780 - Fix contradictory assertion and upgrade shared memory checks to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 078ecc8083b4fad4283608ab098858b9b732381e.\n\nRevert \"Bug 2081780 - Convert some resource assertions to MOZ_RELEASE_ASSERT (part 2). r=gfx-reviewers,bradwerth\"\n\nThis reverts commit cd37d0aa839e442cce86e6ba53d0b15ef699c692.\n\nRevert \"Bug 2081780 - Convert some  assertions to MOZ_RELEASE_ASSERT (part 1). r=gfx-reviewers,bradwerth\"\n\nThis reverts commit d372708d9ba3be664eb5886aba0c25159aa6b8ac.\n\nRevert \"Bug 2081780 - Upgrade layers/ipc thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\"\n\nThis reverts commit 594d0ea751f076eac79c43b77ea0caa134491fb1.\n\nRevert \"Bug 2081780 - Upgrade APZ thread assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\"\n\nThis reverts commit 3e9958e80af311d9fa374a4e2cc0dceae40fb3b1.\n", "files": ["gfx/layers/AndroidImageConsumer.cpp", "gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZPublicUtils.cpp", "gfx/layers/apz/src/APZSampler.cpp", "gfx/layers/apz/src/APZUpdater.cpp", "gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/layers/apz/src/FocusTarget.cpp", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/layers/apz/util/APZThreadUtils.cpp", "gfx/layers/apz/util/CheckerboardReportService.cpp", "gfx/layers/apz/util/ChromeProcessController.cpp", "gfx/layers/apz/util/ScrollLinkedEffectDetector.cpp", "gfx/layers/ipc/APZBridgeChild.cpp", "gfx/layers/ipc/APZBridgeParent.cpp", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerParent.cpp", "gfx/layers/ipc/APZChild.cpp", "gfx/layers/ipc/CanvasChild.cpp", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/CanvasTranslator.h", "gfx/layers/ipc/CompositableForwarder.h", "gfx/layers/ipc/CompositableTransactionParent.cpp", "gfx/layers/ipc/CompositableTransactionParent.h", "gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorManagerChild.cpp", "gfx/layers/ipc/CompositorManagerChild.h", "gfx/layers/ipc/CompositorManagerParent.cpp", "gfx/layers/ipc/CompositorThread.cpp", "gfx/layers/ipc/CompositorVsyncScheduler.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ISurfaceAllocator.cpp", "gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/ImageBridgeChild.cpp", "gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/layers/ipc/KnowsCompositor.h", "gfx/layers/ipc/LayerTreeOwnerTracker.cpp", "gfx/layers/ipc/RefCountedShmem.cpp", "gfx/layers/ipc/RemoteContentController.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/layers/ipc/SharedSurfacesChild.cpp", "gfx/layers/ipc/SharedSurfacesChild.h", "gfx/layers/ipc/SharedSurfacesParent.cpp", "gfx/layers/ipc/UiCompositorControllerChild.cpp", "gfx/layers/ipc/UiCompositorControllerParent.cpp", "gfx/layers/ipc/VideoBridgeChild.cpp", "gfx/layers/ipc/VideoBridgeParent.cpp", "gfx/vr/VRManager.cpp", "gfx/vr/VRServiceHost.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.cpp", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "de4f66931bd45fab5f62c8f971816ce13d14dc92", "git_parents": ["7be88b93d7851c3c0dedf58079497b44679a5793"], "node": "793382e99c19aa31497bc36eedf3623f49da6459", "parents": ["40dbd119ff54dedba605988151bae9a762a63e37"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084576 - Use run-if = debug for tests that need test interfaces only built in debug builds. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336654\n", "files": ["dom/base/test/mochitest.toml", "dom/bindings/test/mochitest.toml", "dom/promise/tests/mochitest.toml", "js/xpconnect/tests/mochitest/mochitest.toml"], "git_node": "19662d5b96a0587d4b8d3a0367a7fbd29b2c0e48", "git_parents": ["de4f66931bd45fab5f62c8f971816ce13d14dc92"], "node": "c82b1044b18e3c4f98c0042bb1334f314eeb3d0a", "parents": ["793382e99c19aa31497bc36eedf3623f49da6459"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078647 - Test that a failure in the Draft phase doesn't restore a leftover backup. r=application-update-reviewers,spohl\n\nA non-staged complete update that fails in Draft has not created any backup yet,\nwhile its rollback visits the precomplete removes of every file. Draft writes\nonly fail on their own in conditions that tests can't easily reproduce, such as\na full disk, so this adds a fault injection to the test updater.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329688\n", "files": ["toolkit/mozapps/update/tests/unit_update_binary/marFailureCompleteStaleBackup.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "3c5471c4de8e0c777a66a648f2cf9c45e813a666", "git_parents": ["19662d5b96a0587d4b8d3a0367a7fbd29b2c0e48"], "node": "0836fbea81caf86ae9a8d8c002553f071f17fd30", "parents": ["c82b1044b18e3c4f98c0042bb1334f314eeb3d0a"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085774 - [devtools] Remove unnecessary arg in ThreadActor#doResume callsite. r=devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336688\n", "files": ["devtools/server/actors/thread.js"], "git_node": "6b6357e09cc76ae387798d9cda33cbd02b349d47", "git_parents": ["3c5471c4de8e0c777a66a648f2cf9c45e813a666"], "node": "67439ead8eefa789f9801f5ab6cd465692506840", "parents": ["0836fbea81caf86ae9a8d8c002553f071f17fd30"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085816 - Create the TextInputListener of a text control and start listening only once its editor is prepared. r=dom-core-reviewers,vhilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336823\n", "files": ["dom/html/TextControlState.cpp"], "git_node": "c33650a08a3dbb4006c5aca3716816d3efbe71b1", "git_parents": ["6b6357e09cc76ae387798d9cda33cbd02b349d47"], "node": "467c27ad4fd460a1d4d3c55120c585c7ce1933f4", "parents": ["67439ead8eefa789f9801f5ab6cd465692506840"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076872 - Avoid spinning the event loop to join the async thread when an async connection closes. r=jari\n\nthread-\u003eShutdown() spins the event loop of the thread that opened the\nconnection, until the async thread acknowledges it has stopped. When that\nthread is busy with higher priority work, the acknowledgement can be delayed\nlong enough for the Terminator to step in.\n\nWe don't need to be precise about when the thread terminates, so start the\njoin with BeginShutdown() and don't wait for it. nsThreadManager reaps any\njoin still pending at XPCOMShutdownThreads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330144\n", "files": ["storage/mozStorageConnection.cpp"], "git_node": "9aca39d3faf82e4a15398036bee2a82c296568bf", "git_parents": ["c33650a08a3dbb4006c5aca3716816d3efbe71b1"], "node": "eee4904ce40084aa3ecc3a701231ba7f18c685c1", "parents": ["467c27ad4fd460a1d4d3c55120c585c7ce1933f4"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2082337 - Use upstream version of Clang patch adding support for -fprofile-abs-path. r=glandium\n\nMy upstream PR https://github.com/llvm/llvm-project/pull/230077 was\nmerged so we now have a stable hash for the patch and know this will be\navailable in Clang 24+.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336878\n", "files": ["build/build-clang/add_support_for_-fprofile-abs-path.patch", "build/build-clang/clang-22.json", "build/build-clang/clang-23.json", "build/build-clang/llvmorg-24-init-16018-g88de0d5aed55.patch", "build/moz.configure/toolchain.configure"], "git_node": "bcf2449cfd45b52336f14de918f2574f086ffd8c", "git_parents": ["9aca39d3faf82e4a15398036bee2a82c296568bf"], "node": "03067c7d763184d03b702b8365a09e72f5a01578", "parents": ["eee4904ce40084aa3ecc3a701231ba7f18c685c1"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076475 - Don't load `javascript:` URLs in ViewSource. r=jdescottes,devtools-reviewers.\n\nBlock javascript protocol in both ViewSourceChild.sys.mjs and viewSourceUtils.js,\nwhere we can prevent opening a tab in such case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334419\n", "files": ["devtools/client/webconsole/test/browser/_webconsole_lz.toml", "devtools/client/webconsole/test/browser/browser_webconsole_stacktrace_location_javascript_protocol_link.js", "toolkit/actors/ViewSourceChild.sys.mjs", "toolkit/components/viewsource/content/viewSourceUtils.js"], "git_node": "a0b3154d3e8d96e6c464358ca8bac5e0675316cc", "git_parents": ["bcf2449cfd45b52336f14de918f2574f086ffd8c"], "node": "74e018aa8f07c12eb33e7aa3a485ab123fff65d8", "parents": ["03067c7d763184d03b702b8365a09e72f5a01578"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 1652558 - Forward Rust tracing events to Gecko logging and the profiler r=mstange,nika,markh\n\nAdd two tracing-subscriber layers to gecko_tracing:\n\n- MozLogLayer forwards events to C++ MOZ_LOG, producing the same\n  stderr/MOZ_LOG_FILE output and LOGS-category profiler markers a C++\n  MOZ_LOG call produces. It calls gecko_logger::moz_log (a Rust-visible\n  MOZ_LOG) directly rather than going through the log crate.\n- SpanMarkerLayer records spans as interval (duration) markers in the\n  profiler, only while the current thread is being profiled. Span fields\n  may contain PII, so the marker stores them as a SanitizedString.\n\nBoth filter callsites by the MOZ_LOG level of their target. As in C++,\nRUST_LOG does not apply. Expose gecko_logger::moz_log_test (a\nRust-visible MOZ_LOG_TEST) for this. The result is cached per callsite, so a disabled\ncall returns at the callsite, and set_rust_log_level rebuilds the cache\nso runtime MOZ_LOG changes (e.g. about:logging) still apply.\n\nEvents from application-services tracing_support macros reach these\nlayers too, in addition to application-services' own event layer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309235\n", "files": ["Cargo.lock", "xpcom/rust/gecko_logger/Cargo.toml", "xpcom/rust/gecko_logger/src/lib.rs", "xpcom/rust/gecko_tracing/Cargo.toml", "xpcom/rust/gecko_tracing/src/fields.rs", "xpcom/rust/gecko_tracing/src/lib.rs", "xpcom/rust/gecko_tracing/src/moz_log.rs", "xpcom/rust/gecko_tracing/src/span_marker.rs"], "git_node": "f6e041121857eee52840b2b9ad40f6857f75b7ca", "git_parents": ["a0b3154d3e8d96e6c464358ca8bac5e0675316cc"], "node": "d5b8234e99137d741624d1ba6ed94072bdf47081", "parents": ["74e018aa8f07c12eb33e7aa3a485ab123fff65d8"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077533 - Defer external intents received during onboarding until it completes. r=pollymce\n\n[Bug 2046071](https://bugzilla.mozilla.org/show_bug.cgi?id=2046071) replays the launch intent once onboarding completes, but only covers a cold start. `HomeActivity` is `singleTask`, so a link, share or shortcut that arrives while onboarding is on screen is delivered to `onNewIntent` and was processed immediately, bypassing the unfinished onboarding.\n\n`handleNewIntent` now stores such intents as the activity intent and returns, so the existing completion listener processes the most recent one. The listener also re-seeds the browsing mode so private intents open in private mode. Crash intents are still processed immediately, since the completion step does not run the crash processor.\n\nWith both paths gated in `HomeActivity`, the per-processor onboarding guard that [bug 2022523](https://bugzilla.mozilla.org/show_bug.cgi?id=2022523) added to `StartSearchIntentProcessor` is redundant and has been removed.\n\nKnown gaps:\n  - Under the persistent-onboarding debug setting the onboarding preference never changes, so the completion listener never fires and intents deferred in that session are not processed.\n  - An activity recreation during onboarding falls back to the original launch intent.\n\n### Testing\n\n**Developer prerequisite**: onboarding is disabled on debug builds, so set `onboardingFeatureEnabled = true`\nin `FeatureFlags.kt` before building.\n\n#### Link tapped during onboarding opens after onboarding\n\n1. `adb shell pm clear org.mozilla.fenix.debug`\n2. Launch Firefox from the app icon and stay on the first onboarding card.\n3. Press the home button, then send a link to the running app:\n   `adb shell am start -a android.intent.action.VIEW -d https://example.com org.mozilla.fenix.debug`\n4. Firefox comes to the foreground still showing the onboarding card. Before this patch the browser\n   opened example.com on top of onboarding.\n5. Complete onboarding. example.com loads, and back returns to the home screen.\n\n#### Most recent link wins\n\n1. `adb shell pm clear org.mozilla.fenix.debug`\n2. Launch from a link, which shows onboarding:\n   `adb shell am start -a android.intent.action.VIEW -d https://example.com org.mozilla.fenix.debug`\n3. Press home, then send a second link:\n   `adb shell am start -a android.intent.action.VIEW -d https://mozilla.org org.mozilla.fenix.debug`\n4. Complete onboarding. mozilla.org opens, not example.com.\n\n#### Private link opens in private mode\n\n1. `adb shell pm clear org.mozilla.fenix.debug`\n2. Launch Firefox from the app icon and stay on onboarding.\n3. Press home, then:\n   `adb shell am start -a android.intent.action.VIEW -d https://example.com --ez private_browsing_mode true org.mozilla.fenix.debug`\n4. Complete onboarding. example.com opens with the private theme and the tab is in the private tab list.\n\n#### Search widget tap during onboarding\n\n1. `adb shell pm clear org.mozilla.fenix.debug`\n2. Launch Firefox from the app icon and stay on onboarding.\n3. Press home, then:\n   `adb shell am start -n org.mozilla.fenix.debug/org.mozilla.fenix.HomeActivity -a android.intent.action.MAIN --es open_to_search search_widget`\n4. Onboarding is still showing. Complete it, and the home screen appears with the address bar focused.\n\n#### Regression check once onboarded\n\n1. With onboarding already completed, background Firefox and run step 3 of the first scenario.\n2. example.com opens immediately, as before.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/401\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/perf/StartupExcessiveResourceUseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/OnboardingTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/StartSearchIntentProcessor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/HomeActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/StartSearchIntentProcessorTest.kt"], "git_node": "b39d1c872ed740e0afc07dd332dca9ef58e5bd45", "git_parents": ["f6e041121857eee52840b2b9ad40f6857f75b7ca"], "node": "9dcbaf5e44731155cbaceae29ee62189caf09d55", "parents": ["d5b8234e99137d741624d1ba6ed94072bdf47081"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2062646 - Only validate Gecko thread hangs from the BHR telemetry payload in test_BHRObserver.js. r=florian\n\nOther threads with a background hang monitor, such as Compositor and\nRender, use a 128ms transient hang threshold and can report hangs when\nthe machine is under load. The payload check required every hang to be\non the Gecko or Gecko_Child thread, so such a hang failed the test. The\ntask then aborted before sending bhr_hangs_detected to the child, and\nshutdown stalled until the harness timed out.\n\nFilter the payload hangs the same way the bhr-thread-hang observer\nalready does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336721\n", "files": ["toolkit/components/backgroundhangmonitor/tests/test_BHRObserver.js"], "git_node": "8824f5f904755901a4f0cf583fee2cd657fdf467", "git_parents": ["b39d1c872ed740e0afc07dd332dca9ef58e5bd45"], "node": "8a486d0638d2ac8db7c7003f06388b190ee43b9d", "parents": ["9dcbaf5e44731155cbaceae29ee62189caf09d55"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084909 - sync robustcheckout hg extension from v-c-t. r=releng-reviewers,bhearsum\n\nUpdate robustcheckout from v-c-t rev fda7e45cb254.\n\nThis adds a --perfherderoutput option (bug 2080201), and resource usage\nmarkers (bug 2079626).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336118\n", "files": ["taskcluster/scripts/robustcheckout.py"], "git_node": "29ccf1e836e9b8c19b060d9ac1f168156e9a7141", "git_parents": ["8824f5f904755901a4f0cf583fee2cd657fdf467"], "node": "84acc41f1423011e700a26dadd4ea4ac42f10a06", "parents": ["8a486d0638d2ac8db7c7003f06388b190ee43b9d"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085107 - Don't lose the processes sampled by the resource monitor when it stops. r=releng-reviewers,bhearsum\n\nstop() gave up waiting for the collector after 0.1s without data, so the\nprocess entries sent once it finished its current sample could be dropped,\nwhich happened on Windows where sampling processes is slow. Also sample\nprocesses one last time when stopping, so that the ones started since the\nprevious sample are recorded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336298\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py"], "git_node": "f43ded3e5e3e3335908b9544d8e70d96277251ff", "git_parents": ["29ccf1e836e9b8c19b060d9ac1f168156e9a7141"], "node": "862b890b638a9fc12a0c05e0443643a2abadd444", "parents": ["84acc41f1423011e700a26dadd4ea4ac42f10a06"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Replace misuse of std::forward by std::move in editor/ r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335950\n", "files": ["editor/libeditor/EditorLineBreak.h", "editor/libeditor/HTMLEditHelpers.h", "editor/libeditor/HTMLEditorNestedClasses.h", "editor/libeditor/WSRunScanner.h"], "git_node": "13a17e0b1229a7a1511ef3ffbb121548292858ca", "git_parents": ["f43ded3e5e3e3335908b9544d8e70d96277251ff"], "node": "047ebb9463fa2845ced19e1a13d0e28b3576cdfc", "parents": ["862b890b638a9fc12a0c05e0443643a2abadd444"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1933337 - mozprocess: hold the cleanup lock when reading the process exit code on Windows. r=mozbase-reviewers,ahal\n\nAn onTimeout handler can kill the process from the reader thread while the\nmain thread is in wait(), closing the process handle between the check and\nthe GetExitCodeProcess call, which then fails with ERROR_INVALID_HANDLE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335956\n", "files": ["testing/mozbase/mozprocess/mozprocess/processhandler.py"], "git_node": "678211a7551dc4b56aa8b642a5f1414a19865eb5", "git_parents": ["13a17e0b1229a7a1511ef3ffbb121548292858ca"], "node": "cc63002143034eacb846e28c8ae0cf75f1ef10e4", "parents": ["047ebb9463fa2845ced19e1a13d0e28b3576cdfc"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1933337 - mozprocess: only update Process.returncode from a single place. r=mozbase-reviewers,ahal,whimboo\n\nProcess.wait() and Process.kill() reassigned returncode from the value\n_custom_wait() returned, which could overwrite an exit code set concurrently\nby another thread with None.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335957\n", "files": ["testing/mozbase/mozprocess/mozprocess/processhandler.py"], "git_node": "1bf2f8e2dd37e322d72de2f52c5bd84735afbd00", "git_parents": ["678211a7551dc4b56aa8b642a5f1414a19865eb5"], "node": "d1748b771c05d06496ef41231c6ce4d6bf871e80", "parents": ["cc63002143034eacb846e28c8ae0cf75f1ef10e4"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1933337 - mozprocess: don't let a timed out wait() make poll() always return None. r=mozbase-reviewers,ahal\n\nProcessHandlerMixin.wait() stores None in returncode when it times out, and\npoll() returned that cached value without checking the process again once the\nreader thread had finished.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335958\n", "files": ["testing/mozbase/mozprocess/mozprocess/processhandler.py", "testing/mozbase/mozprocess/tests/test_poll.py"], "git_node": "09330192886989d9bf58a433ccb3f5fbd6d32150", "git_parents": ["1bf2f8e2dd37e322d72de2f52c5bd84735afbd00"], "node": "2a0bcabef39368c09f529457f956e3530d71e6b4", "parents": ["d1748b771c05d06496ef41231c6ce4d6bf871e80"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079257 - Follow-up: Add a crashtest for the copied element's prefix atom being released by script. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332378\n", "files": ["dom/xslt/crashtests/2079257.html", "dom/xslt/crashtests/2079257.xml", "dom/xslt/crashtests/2079257.xsl", "dom/xslt/crashtests/crashtests.list"], "git_node": "dfd2b7ebf3a21411f31e7ed1743f8e409708cfe3", "git_parents": ["09330192886989d9bf58a433ccb3f5fbd6d32150"], "node": "d7134497f73882f040eeb7da8aea11b4ec2d591d", "parents": ["2a0bcabef39368c09f529457f956e3530d71e6b4"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085620 - Fire popstate for same-URL fragment navigations. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336689\n", "files": ["docshell/base/nsDocShell.cpp", "testing/web-platform/tests/html/browsers/browsing-the-web/history-traversal/event-order/same-url-fragment-link-click.html"], "git_node": "5f29a955675beb0f73d6afa55eb1da2acafbd3d2", "git_parents": ["dfd2b7ebf3a21411f31e7ed1743f8e409708cfe3"], "node": "c82a6e321f8660725f209a0700dbf5e2b6011e7a", "parents": ["d7134497f73882f040eeb7da8aea11b4ec2d591d"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082419 - Avoid virtual calls for HTMLCollection::{Item, IndexedGetter}. r=dom-core-reviewers,webidl,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335197\n", "files": ["dom/base/ContentList.h", "dom/html/HTMLFormControlsCollection.cpp", "dom/webidl/HTMLCollection.webidl"], "git_node": "4936a6a87b79f18039d2b805585a7791956d8206", "git_parents": ["5f29a955675beb0f73d6afa55eb1da2acafbd3d2"], "node": "b107c03b073fbc4a4d5ca12672670c81f8f0e6d5", "parents": ["c82a6e321f8660725f209a0700dbf5e2b6011e7a"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082419 - Prefetch successive elements for ContentList::PopulateSelf. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336657\n", "files": ["dom/base/ContentList.cpp"], "git_node": "bafd2a4450b0488e689f66281fa04c1ef9a31f10", "git_parents": ["4936a6a87b79f18039d2b805585a7791956d8206"], "node": "fe8f54024938c3cd9f12d932a4c3bc15f03a0b9d", "parents": ["b107c03b073fbc4a4d5ca12672670c81f8f0e6d5"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085801 - Change the devtools test runner to invoke npm via mach, rather than directly. r=devtools-reviewers,jdescottes\n\nThis resolves issues where the only node installed is as part of mozbuild.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336744\n", "files": ["devtools/client/bin/devtools-node-test-runner.js", "devtools/mach_commands.py"], "git_node": "a1657d110c1f3482d1acd596ec06db3c394745da", "git_parents": ["bafd2a4450b0488e689f66281fa04c1ef9a31f10"], "node": "a39f1a3e018edb5c11a0ef8a7c85f027170f02a5", "parents": ["fe8f54024938c3cd9f12d932a4c3bc15f03a0b9d"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085801 - Fix devtools bundle generation so that it can be invoked from anywhere. r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336745\n", "files": ["devtools/client/debugger/bin/bundle.js", "taskcluster/kinds/source-test/node.yml"], "git_node": "84423531bb3f00d2d275e28b38195b4b29e5432b", "git_parents": ["a1657d110c1f3482d1acd596ec06db3c394745da"], "node": "3cb891f76e86247f13dbdd39c0b69b1b2502021b", "parents": ["a39f1a3e018edb5c11a0ef8a7c85f027170f02a5"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085801 - Remove manual node install from the lint Docker images. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336746\n", "files": ["taskcluster/docker/lint/Dockerfile", "taskcluster/docker/lint/system-setup.sh", "taskcluster/docker/recipes/install-node.sh"], "git_node": "351ac54d0f0f838b8255c427579fc8f82eac3364", "git_parents": ["84423531bb3f00d2d275e28b38195b4b29e5432b"], "node": "2eab623b68a57f2738010aaff265952c77f9d88c", "parents": ["3cb891f76e86247f13dbdd39c0b69b1b2502021b"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086033 - Remove mentions of phab-test-policy addon in documentation. r=marco.\n\nThe feature was integrated in phabricator directly, so don't need to mention the addon anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337053\n", "files": ["docs/contributing/reviewer_checklist.md", "testing/docs/testing-policy/index.md"], "git_node": "77641dc012d934522fc6abb7c7bb893e266db9df", "git_parents": ["351ac54d0f0f838b8255c427579fc8f82eac3364"], "node": "6852fe2417ebb37707cf0ff6aa3b2109d0c67447", "parents": ["2eab623b68a57f2738010aaff265952c77f9d88c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086025 - Fix process start times in resource usage profiles on Linux. r=jcristau\n\npsutil's boot time comes from the btime field of /proc/stat, which is truncated to whole seconds, so process creation times were up to one second early.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337029\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "68ec7be06438598fb769b933e6e5579ad2d465b3", "git_parents": ["77641dc012d934522fc6abb7c7bb893e266db9df"], "node": "17c72481239b3532e718d3dd92487c19739fa934", "parents": ["6852fe2417ebb37707cf0ff6aa3b2109d0c67447"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058035 - Ensure consistent block and offset, r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332855\n", "files": ["gfx/thebes/SharedFontList.cpp", "gfx/thebes/SharedFontList.h"], "git_node": "94db1bf32f349f160269b2857a75cc883c0f64fd", "git_parents": ["68ec7be06438598fb769b933e6e5579ad2d465b3"], "node": "4cda581b2f21f0a600a1d8a47be4c6eb83b9f16e", "parents": ["17c72481239b3532e718d3dd92487c19739fa934"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084967 - Don't use image cursor clear workaround on gtk3 versions not affected by the gtk issue. r=gtk-reviewers,stransky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336402\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "6f4566ef53a1e894f7e0e59af61d2bf30afffe90", "git_parents": ["94db1bf32f349f160269b2857a75cc883c0f64fd"], "node": "1a780361596eb8b5b3e0c162523e5224777d80d5", "parents": ["4cda581b2f21f0a600a1d8a47be4c6eb83b9f16e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079640 - Freeze the gc before serializing the task graph in mach try. r=releng-reviewers,bhearsum\n\nTaskgraph doesn't collect garbage while generating the graph, so the first\ncollections after it re-enables the gc walk the whole graph while the\ntaskgraph cache is being written, with nothing to free. Freezing the gc\nmoves the graph out of its reach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334041\n", "files": ["tools/tryselect/tasks.py"], "git_node": "3e62189c573c40108fd931c5a46ac89e125c5a28", "git_parents": ["6f4566ef53a1e894f7e0e59af61d2bf30afffe90"], "node": "e89b37e9a39e6357018083df4402e417d2a195e8", "parents": ["1a780361596eb8b5b3e0c162523e5224777d80d5"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079640 - Freeze the gc before serializing the task graph in the decision task. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nTaskgraph doesn't collect garbage while generating the graph, so the first\ncollections after it re-enables the gc walk the whole graph while it is\nbeing serialized, with nothing to free. Freezing the gc moves the graph out\nof its reach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334042\n", "files": ["taskcluster/gecko_taskgraph/decision.py"], "git_node": "2569b81c8ec8bdb65e43b156d4c3f35ab15a263b", "git_parents": ["3e62189c573c40108fd931c5a46ac89e125c5a28"], "node": "68b60e0ccc9418b847979aa0ed578843b16a050d", "parents": ["e89b37e9a39e6357018083df4402e417d2a195e8"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Replace misuse of std::forward by std::move in dom/ r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335951\n", "files": ["dom/events/PointerEventHandler.cpp", "dom/fs/child/FileSystemThreadSafeStreamOwner.cpp", "dom/media/MediaSegment.h", "dom/media/VideoSegment.h", "dom/media/utils/PerformanceRecorder.cpp", "dom/media/utils/PerformanceRecorder.h", "dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.cpp", "dom/media/webrtc/libwebrtcglue/AudioConduit.cpp", "dom/media/webrtc/libwebrtcglue/VideoConduit.cpp", "dom/media/webrtc/libwebrtcglue/VideoStreamFactory.h"], "git_node": "c87e972beb50f1162e069b9f1c334d73abc909f9", "git_parents": ["2569b81c8ec8bdb65e43b156d4c3f35ab15a263b"], "node": "fadee68650763b9c1cfea79b2c344691cb6af030", "parents": ["68b60e0ccc9418b847979aa0ed578843b16a050d"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086050 - Wait for the first measurement in test_process_sampling_with_interval. r=florian\n\nThe monitor ignores processes already running when it takes its first\nsample. On Windows, where the collecting process is spawned, that can take\nlonger than the 2 seconds the test child runs for, which then goes\nunrecorded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337076\n", "files": ["testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "674368c0ad207c5d20c25c81e427b17403e9587e", "git_parents": ["c87e972beb50f1162e069b9f1c334d73abc909f9"], "node": "9ac78d89a91a146fd56f4a7a87d3004c30394221", "parents": ["fadee68650763b9c1cfea79b2c344691cb6af030"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086034 - Name the result of an autofill migration error that has no message. r=credential-management-reviewers,theidkamp\n\nAn XPCOM exception from the OS key store has an empty message, so every run\nthat rejected a record reported no error_message.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337069\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs"], "git_node": "8d382fe9df2e953d38569f77b6a2181c52e2b845", "git_parents": ["674368c0ad207c5d20c25c81e427b17403e9587e"], "node": "a3107705c3aee1dc96ffaa974a485bda830e79cb", "parents": ["9ac78d89a91a146fd56f4a7a87d3004c30394221"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998594 - Add PProcInfo protocol for requesting process info from child processes r=ipc-reviewers,nika\n\nProcInfo reads a child process's information from the parent, but this\nis not possible on Android for isolated processes: they run as a\ndifferent uid, so the parent cannot access their /proc directory. Add a\nPProcInfo protocol so the parent can instead request the information\nfrom the process itself. It is only built on Android, and is not yet\nconnected to any process.\n\nThe child actor lives on a background task queue so that it can respond\neven if the child's main thread is busy. The parent actor lives on the\nmain thread, where ProcInfoParent keeps a registry of actors keyed by\nGeckoChildID, which, unlike pids, is never reused. The registry holds a\nstrong reference to each actor until its channel is closed, so callers\nneed not own it.\n\nA child may be unable to respond, for example if Android has frozen it,\nso requests that haven't received a reply within a second are rejected.\nTo avoid messages piling up in a frozen child's queue, at most one\nmessage is sent to the child at a time, and requests made while\nawaiting its reply share that reply.\n\nThe data received over PProcInfo is reported by the child process\nitself, so a compromised child could report arbitrary values. It is only\nused for display purposes, so this is acceptable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335934\n", "files": ["toolkit/components/processtools/PProcInfo.ipdl", "toolkit/components/processtools/ProcInfoChild.cpp", "toolkit/components/processtools/ProcInfoChild.h", "toolkit/components/processtools/ProcInfoIPCUtils.h", "toolkit/components/processtools/ProcInfoParent.cpp", "toolkit/components/processtools/ProcInfoParent.h", "toolkit/components/processtools/moz.build"], "git_node": "1c0c915c8cd875e21ee1cd4cbf1745d985075e96", "git_parents": ["8d382fe9df2e953d38569f77b6a2181c52e2b845"], "node": "acdece6654a68d7fa41fa34fd705c0ca6a2f2663", "parents": ["a3107705c3aee1dc96ffaa974a485bda830e79cb"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998594 - Request process info over PProcInfo in GetProcInfo() where available r=ipc-reviewers,nika\n\nOn Android, for any child process that has a PProcInfo actor, request\nits process info over IPC instead of reading it in-process, and combine\nthe results with those read in-process. Processes whose remote request\nfails are omitted, as is the case for in-process failures.\n\nThe PInfoParent actor for a request is found using the\nProcInfoRequest::childId field, so ChromeUtils::RequestProcInfo() now\nsets it for all child processes rather than only content processes, and\nthe test is updated accordingly.\n\nProcInfoParent lookup and queries must be performed on the main thread,\nso this is now a documented and enforced constraint for GetProcInfo() on\nall platforms.\n\nNo process has a PProcInfo actor yet, so this does not change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335935\n", "files": ["dom/base/ChromeUtils.cpp", "toolkit/components/processtools/ProcInfo.h", "toolkit/components/processtools/ProcInfo_common.cpp", "toolkit/components/processtools/tests/browser/browser_test_procinfo.js"], "git_node": "b12ccc7278ffbe9320b2854c0872c4179b97688d", "git_parents": ["1c0c915c8cd875e21ee1cd4cbf1745d985075e96"], "node": "a6d4f65e783f21b6ea70bd13ea0809d5083d7211", "parents": ["acdece6654a68d7fa41fa34fd705c0ca6a2f2663"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998594 - Connect PProcInfo to Android content processes r=ipc-reviewers,nika\n\nabout:processes doesn't show Android isolated content processes, because\nChromeUtils.requestProcInfo() cannot read their information from the\nparent. Connect a PProcInfo actor to each content process on Android so\nthat the information is requested from the process itself.\n\nThis is done for every Android content process rather than only isolated\nones. Non-isolated processes could still be read from the parent, but a\nsingle code path is simpler, and isolated processes will soon be the\ndefault. On other platforms we deliberately do not use the remote path\nas content sandboxing may prevent child processes from obtaining the\nrequired information themselves.\n\nBrowser chrome mochitests for ChromeUtils.requestProcInfo() don't run on\nAndroid, so add a plain mochitest which checks that the process hosting\nthe test is reported with its system info and windows. Running it with\n--enable-isolated-process covers Android isolated processes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335936\n", "files": ["dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "toolkit/components/processtools/moz.build", "toolkit/components/processtools/tests/mochitest/mochitest.toml", "toolkit/components/processtools/tests/mochitest/test_procinfo_content_process.html"], "git_node": "f8f742186b37cff690895100ef487610607e5b3a", "git_parents": ["b12ccc7278ffbe9320b2854c0872c4179b97688d"], "node": "e2c5232d631f83749cf980c54fe50474dd031b38", "parents": ["a6d4f65e783f21b6ea70bd13ea0809d5083d7211"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998594 - Connect PProcInfo to Android GMP processes r=media-playback-reviewers,aosmond\n\nGMP processes can also run as Android isolated processes, so the parent\ncannot read their information from /proc either. Connect a PProcInfo\nactor to GMP processes on Android, as is done for content processes.\n\nGMPParent lives on the GMP thread, so it creates the endpoints there and\nbinds the parent actor on the main thread, where it is kept alive by\nIPC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335937\n", "files": ["dom/media/gmp/GMPChild.cpp", "dom/media/gmp/GMPChild.h", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/PGMP.ipdl"], "git_node": "f014387a434d655b402a91bff1b13598b73efb12", "git_parents": ["f8f742186b37cff690895100ef487610607e5b3a"], "node": "9c50099b0b3483d8847807bd0ca0239670bba31b", "parents": ["e2c5232d631f83749cf980c54fe50474dd031b38"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1998594: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["toolkit/components/processtools/ProcInfoChild.cpp"], "git_node": "e0bfb4106983309f56842dc8374a4bd0b005c05a", "git_parents": ["f014387a434d655b402a91bff1b13598b73efb12"], "node": "ec5504fbc3b28f83ac06605ae9cfbe2ea2c7d5fa", "parents": ["9c50099b0b3483d8847807bd0ca0239670bba31b"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084609 - Remove total duration from the Listen player r=android-reviewers,ltokhtamuradova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336952\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetTest.kt"], "git_node": "05f71e44886d8331a1f329cc57d72f12fc3344bd", "git_parents": ["e0bfb4106983309f56842dc8374a4bd0b005c05a"], "node": "7811baf852dce1c8dedf8fbf2fc1684a878e1891", "parents": ["ec5504fbc3b28f83ac06605ae9cfbe2ea2c7d5fa"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084283 - Publish mapping.txt file to firebase test lab. r=bhearsum\n\nThis is required to deobfuscate stack traces that may arise. This will be available as an artifact to download alongside junit html error report. So anyone can grab the file and run `retrace mapping.txt stack.txt` locally.\n\n[try is here](https://treeherder.mozilla.org/jobs?repo=try&revision=03d32fbe16ba4ab3951b5d0137e8ae6d2676f040)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/413\n", "files": ["taskcluster/gecko_taskgraph/transforms/ui_test_apk.py", "taskcluster/kinds/build-apk/kind.yml", "taskcluster/kinds/ui-test-apk/kind.yml", "taskcluster/scripts/tests/test-lab.py"], "git_node": "66c225bf4db2c3b9e5f5009626bab08b5c8dda4b", "git_parents": ["05f71e44886d8331a1f329cc57d72f12fc3344bd"], "node": "54c551a9766af17808f1e45ed24e1cf83dfdaaa1", "parents": ["7811baf852dce1c8dedf8fbf2fc1684a878e1891"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079602 - Remove redundant UniquePtr\u003c...\u003e ... = std::make_unique(...) r=nika,necko-reviewers,ipc-reviewers,application-update-reviewers,media-playback-reviewers,webrtc-reviewers,profiler-reviewers,win-reviewers,dom-worker-reviewers,gtk-reviewers,mossop,gstoll,bwc,canova,kershaw,edenchuang,stransky,padenot,yjuglaret,geckoview-reviewers,devtools-reviewers,cookie-reviewers,places-reviewers,dom-storage-reviewers,firefox-style-system-reviewers,layout-reviewers,sandbox-reviewers,webdriver-reviewers,geoprovider-reviewers,crashreporting-reviewers,device-api-reviewers,media-webspeech-reviewers,mac-reviewers,chutten,bobowen,nchevobbe,timhuang,pehrsons,dshin,mstange,jari,m_kato,spohl,masayuki\n\nTurn it into:\n\n        auto ... = std::make_unique(...)\n\nThis is a mechanical change that removes idioms introduced by previous\npatches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332411\n", "files": ["accessible/base/AccAttributes.h", "accessible/generic/LocalAccessible.cpp", "browser/app/winlauncher/test/TestCrossProcessWin.cpp", "browser/components/shell/WindowsDefaultBrowser.cpp", "chrome/nsChromeRegistryContent.cpp", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "dom/base/CustomElementRegistry.cpp", "dom/base/SerializedStackHolder.cpp", "dom/cache/TypeUtils.cpp", "dom/fetch/FetchDriver.cpp", "dom/file/ipc/RemoteLazyInputStreamStorage.cpp", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/geolocation/Geolocation.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/ContentParent.cpp", "dom/media/ChannelMediaResource.cpp", "dom/media/MediaCache.h", "dom/media/MediaFormatReader.cpp", "dom/media/mediasource/MediaSource.cpp", "dom/media/mp4/MP4Metadata.cpp", "dom/media/ogg/OggCodecState.cpp", "dom/media/webaudio/AudioWorkletNode.cpp", "dom/media/webaudio/blink/ReverbConvolver.cpp", "dom/media/webrtc/jsapi/PacketDumper.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/RTCDataChannel.cpp", "dom/media/webrtc/jsapi/RTCRtpTransceiver.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepTrack.cpp", "dom/media/webrtc/sdp/RsdparsaSdpParser.cpp", "dom/media/webrtc/sdp/SipccSdpParser.cpp", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceStorageWorker.cpp", "dom/reporting/ReportingHeader.cpp", "dom/serviceworkers/ServiceWorkerPrivate.cpp", "dom/serviceworkers/ServiceWorkerScriptCache.cpp", "dom/webtransport/api/WebTransport.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/remoteworkers/RemoteWorkerController.cpp", "dom/worklet/WorkletFetchHandler.cpp", "dom/xhr/XMLHttpRequestWorker.cpp", "dom/xslt/xpath/txExprParser.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "dom/xslt/xslt/txNodeSorter.cpp", "dom/xslt/xslt/txPatternParser.cpp", "dom/xslt/xslt/txStylesheet.cpp", "dom/xslt/xslt/txStylesheetCompiler.cpp", "dom/xslt/xslt/txXPathResultComparator.cpp", "editor/libeditor/PendingStyles.cpp", "editor/spellchecker/TextServicesDocument.cpp", "extensions/spellcheck/hunspell/glue/RLBoxHunspell.cpp", "gfx/gl/GLContext.h", "gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/test/gtest/TestSnapping.cpp", "gfx/layers/apz/test/gtest/TestSnappingOnMomentum.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/ots/RLBoxWOFF2Host.cpp", "gfx/tests/gtest/TestQcms.cpp", "gfx/tests/gtest/TestYUVtoRGB32.cpp", "gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "image/decoders/nsAVIFDecoder.cpp", "intl/components/src/NumberFormat.cpp", "intl/components/src/NumberParser.cpp", "intl/components/src/NumberRangeFormat.cpp", "intl/components/src/RelativeTimeFormat.cpp", "ipc/chromium/src/chrome/common/ipc_channel_mach.cc", "ipc/chromium/src/chrome/common/ipc_channel_posix.cc", "ipc/chromium/src/chrome/common/mach_ipc_mac.cc", "ipc/glue/MessageChannel.cpp", "ipc/glue/MiniTransceiver.cpp", "ipc/ipdl/test/gtest/TestUniquePtrIPC.cpp", "js/loader/ImportMap.cpp", "js/src/shell/js.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "layout/base/PresShell.cpp", "memory/gtest/TestJemalloc.cpp", "mfbt/tests/TestUniquePtr.cpp", "modules/libpref/Preferences.cpp", "mozglue/baseprofiler/core/ProfileBufferEntry.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/misc/PreXULSkeletonUI.cpp", "mozglue/misc/WindowsEnumProcessModules.h", "netwerk/dns/PlatformDNSUnix.cpp", "netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportStream.cpp", "netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/test/gtest/TestCapsule.cpp", "netwerk/test/gtest/TestHttp2WebTransport.cpp", "netwerk/test/gtest/TestWebTransportFlowControl.cpp", "parser/htmlparser/nsExpatDriver.cpp", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp", "toolkit/components/aboutthirdparty/tests/TestShellEx/RegUtils.cpp", "toolkit/components/maintenanceservice/serviceinstall.cpp", "toolkit/components/parentalcontrols/nsParentalControlsServiceWin.cpp", "toolkit/components/places/FaviconHelpers.cpp", "toolkit/components/remote/RemoteUtils.cpp", "toolkit/components/uniffi-bindgen-gecko-js/src/templates/cpp/CallbackInterfaces.cpp", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp", "toolkit/mozapps/defaultagent/DefaultAgent.cpp", "toolkit/mozapps/defaultagent/ScheduledTask.cpp", "toolkit/mozapps/update/common/readstrings.cpp", "toolkit/mozapps/update/common/updatecommon.cpp", "toolkit/mozapps/update/common/updatehelper.cpp", "toolkit/profile/nsToolkitProfileService.cpp", "toolkit/xre/MultiInstanceLock.cpp", "toolkit/xre/dllservices/DynamicBlocklist.h", "toolkit/xre/nsAppRunner.cpp", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/lul/LulMain.cpp", "tools/profiler/tests/gtest/GeckoProfiler.cpp", "widget/gtk/nsDragServiceGtk.cpp", "widget/gtk/nsDragServiceWayland.cpp", "widget/windows/WinHeaderOnlyUtils.h", "widget/windows/WinUtils.cpp", "widget/windows/WinWindowOcclusionTracker.cpp", "widget/windows/WindowsEventLog.h", "widget/windows/nsWindowLoggedMessages.cpp", "xpcom/base/Logging.cpp", "xpcom/base/nsMacUtilsImpl.cpp", "xpcom/io/nsBinaryStream.cpp", "xpcom/tests/gtest/TestThreadUtils.cpp", "xpcom/threads/nsThreadManager.cpp"], "git_node": "ccee8f28885be28304d3b3f289a10243c4e8b7c0", "git_parents": ["66c225bf4db2c3b9e5f5009626bab08b5c8dda4b"], "node": "a737efa50755bd6e8065095eb49355e0db9afec8", "parents": ["54c551a9766af17808f1e45ed24e1cf83dfdaaa1"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078871 - Expand weather widget to Hong Kong, Russia, Iraq, and Greenland. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336963\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs"], "git_node": "27e69823b4af905ce9c652372ae0d9476b26e513", "git_parents": ["ccee8f28885be28304d3b3f289a10243c4e8b7c0"], "node": "d28321cc22a3c09aabf15a99cba3481c9f0f7237", "parents": ["a737efa50755bd6e8065095eb49355e0db9afec8"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2084597 - Refactor schoolbook BigInt division to work on Digits r=mgaudet\n\nIn its inner loop, our implemention of the schoolbook division\nimplementation passed temporaries as BigInt* to mul/add/sub helpers,\nonly to then unpack them as Digits at the callee.\n\nThis patch refactors to stay in Digits.  By being careful that the\ncompiler can see release assertions about Digits lengths that dominate\nloops, we can reduce retired instruction count by 5-10% on\nmicrobenchmarks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335999\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "978c86e8160b388d284c79346dc7716a774e4efd", "git_parents": ["27e69823b4af905ce9c652372ae0d9476b26e513"], "node": "f1ff9a64fafe157210532e0386322f68a0ef2c60", "parents": ["d28321cc22a3c09aabf15a99cba3481c9f0f7237"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071467 - breakpad: use a socket pair for the crash generation channel r=crashreporting-reviewers,afranchuk\n\nWe'll need to have a bidirectional dialogue between client and server in\norder to set up the remote executor, for which the good old pipe isn't\nenough.\n\nSince the GMP sandbox doesn't allow socketpair(), we create it when\nsetting up the client, *before* the sandbox kicks in. Sadly, it's single-use,\nso any subsequent dump simply falls back to creating one on the fly,\nwhich will still fail on sandboxed GMP, but that's still a huge\nimprovement.\n\nCo-authored-by: Chris Martin \u003ccmartin@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336190\n", "files": ["toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation.h", "toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation_client.cc", "toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation_server.cc"], "git_node": "a7048c12404dab2e75248c5cbca2555023f82349", "git_parents": ["978c86e8160b388d284c79346dc7716a774e4efd"], "node": "55607e0c71f2acecf67451f4a72624e236071ddf", "parents": ["f1ff9a64fafe157210532e0386322f68a0ef2c60"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071467 - Allow dumping child processes through a forked executor r=crashreporting-reviewers,afranchuk\n\nThe forked executor is disabled by default, but the crashhelper will use\nit if the env var MOZ_CRASHREPORTER_FORCE_REMOTE_EXECUTOR is set to 1.\nThis will allow us to test it on desktop Linux.\n\nCo-authored-by: Chris Martin \u003ccmartin@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336191\n", "files": ["toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation.h", "toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation_client.cc", "toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation_server.cc", "toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation_server.h", "toolkit/crashreporter/rust_minidump_writer_linux/src/lib.rs"], "git_node": "c68cd46b612042bf18fd48beef618cd82c604424", "git_parents": ["a7048c12404dab2e75248c5cbca2555023f82349"], "node": "019213c8aa87e1758ab1a48f8d44ef5d6f8fcbe6", "parents": ["55607e0c71f2acecf67451f4a72624e236071ddf"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071467 - Add a testing annotation recording use of the remote executor r=crashreporting-reviewers,afranchuk\n\nThis isn't mandatory per se, but is fairly useful to make sure we\nactually used the right dumping mechanism in our tests. This annotation\nis client-scoped, so no data risk here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336192\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/rust_minidump_writer_linux/src/lib.rs"], "git_node": "ea1ed8a263983edde345192a9df631483f8921eb", "git_parents": ["c68cd46b612042bf18fd48beef618cd82c604424"], "node": "1a0caf74fcd5fe00b8e9a33889dd63b67e6ecf0c", "parents": ["019213c8aa87e1758ab1a48f8d44ef5d6f8fcbe6"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071467 - Test the remote executor on desktop Linux r=crashreporting-reviewers,afranchuk\n\nWe force the remote executor, and disable the content sandbox since it\ndoesn't let us fork.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336193\n", "files": ["toolkit/crashreporter/test/unit_ipc/test_content_remote_executor.js", "toolkit/crashreporter/test/unit_ipc/xpcshell.toml"], "git_node": "36102cc3b807c11f7c11027dc745fd1576c29c69", "git_parents": ["ea1ed8a263983edde345192a9df631483f8921eb"], "node": "07c19b3c00aa386739f204d600fcc7f2027fa790", "parents": ["1a0caf74fcd5fe00b8e9a33889dd63b67e6ecf0c"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2085946 - Update PDF.js to new version ea6cf5c985fbc77c48fffb30adf4167a0de8d005 r=pdfjs-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336928\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/images/gv-editor-toolbar-close.svg", "toolkit/components/pdfjs/content/web/viewer-geckoview.css", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/jar.mn", "toolkit/components/pdfjs/moz.yaml"], "git_node": "47e2c4baba470ca3921b93da876fbb20da17c871", "git_parents": ["36102cc3b807c11f7c11027dc745fd1576c29c69"], "node": "dbf7cc90d98dda69b0c3ec7677523f91e01ec911", "parents": ["07c19b3c00aa386739f204d600fcc7f2027fa790"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2085911 - Skip caching ConsoleAPIStorage events for already-destroyed inner windows in content processes too, r=nchevobbe.\n\nBug 2031280 stopped caching console events that arrive after their inner window was destroyed, but only in the parent process, assuming that nuking the destroyed window's realm would cut their references in content processes. Nuking only cuts the wrappers that exist when it runs, and doesn't prevent new ones, so a late event recorded after it kept the window alive until shutdown through its arguments. This made browser_aboutwelcome_multistage_mr.js intermittently leak an about:welcome window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336924\n", "files": ["dom/console/ConsoleAPIStorage.sys.mjs", "dom/console/tests/browser.toml", "dom/console/tests/browser_console_storage_window_leak.js"], "git_node": "1e310260624587633efcbd0466b36bf3d8847ebd", "git_parents": ["47e2c4baba470ca3921b93da876fbb20da17c871"], "node": "4c948fb1d84201fbc5caf33122ec02d4454677a0", "parents": ["dbf7cc90d98dda69b0c3ec7677523f91e01ec911"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083745 - Serialize DownloadSource properties (userContextId, and browsingContextId) explicitly instead of through unknown properties r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335805\n", "files": ["toolkit/components/downloads/DownloadCore.sys.mjs", "toolkit/components/downloads/test/unit/test_DownloadStore.js"], "git_node": "1fcc2c993a4e7c0a6d3855eca84d3feb24abbcf9", "git_parents": ["1e310260624587633efcbd0466b36bf3d8847ebd"], "node": "2b743741d369a74b23f23dd6100be38d17d0e107", "parents": ["4c948fb1d84201fbc5caf33122ec02d4454677a0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081982. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335399\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "309a5a01511293cd91f86d82c9c2f7130dd38ebc", "git_parents": ["1fcc2c993a4e7c0a6d3855eca84d3feb24abbcf9"], "node": "5e176f1bbe0e5c19ffab3e7e496a1844cb25458d", "parents": ["2b743741d369a74b23f23dd6100be38d17d0e107"], "tags": []}], "date": 1793118931, "git_changesets": ["8d1e09bf35a319e4416ccaf017be6cd4160185e9", "371ed3193e2048f8484a96f4d43db0e460ba40cf", "5e6edd72f6c0889b4d3082de1825db158bc76ef1", "4bfe808cf25a910a929ac6a3581b1294924a2820", "4ab399efe8dbd57c37352cb5fc83511ea062fdac", "758b44769b1279ad27e74a78bf44b2d9eb16312e", "f66c63e377ae3d1c4296f8a7d611aba6918d0d00", "ee55152ad1fb33c75faaaab6b8632a0a97bc3467", "154ddf6302dfa8d0cd7ac6368a0c68462a18e894", "1d735ad37075959d8b5c021e55df24910040ba33", "e8a0be3071607266abdaf5ff829e2478c435a463", "4efa94612117c21416a4d60a29cce925bb522dc0", "b49f335abacead8297b851dd4a1fda762052c1cd", "4d97a1fab46463fe3ed5bc4ed99f6602558346d9", "60d2d5d05de6adb753ddc3d11b245a16b3d7c826", "c2b6d5940ba3779a0337ec51afd378a8faa2f32b", "79d72bb377aeae0cafe223ff64f5453fda4d3d57", "f375225faa72451a4e9656552d3ecb7088379da1", "3e9958e80af311d9fa374a4e2cc0dceae40fb3b1", "594d0ea751f076eac79c43b77ea0caa134491fb1", "d372708d9ba3be664eb5886aba0c25159aa6b8ac", "cd37d0aa839e442cce86e6ba53d0b15ef699c692", "078ecc8083b4fad4283608ab098858b9b732381e", "a6a83c08600743b2b8f8e2f952a84866a3315b71", "a96e6f836f37aa28016d9d0289df1f5b63e12e16", "21517ffd5b2cb055319edc5c2c968291b6fe5905", "0e11a06dd86e1303ad165ed9d13e6e8dafd41395", "fc501c52f0cd23b85014e6f3b1978acc8fb84f91", "e48e3b8963cada28a09b886429e0152eeca57002", "1c13e09015d3d6bcfb4bbaf9d021ded44c2835c1", "1cf826f58b64effca9618a85b3