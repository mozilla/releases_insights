74c142cb9cfc126a09abdf5cfc984dda6d", "902f84240ee9f4a1a01b290d53f24a019dd42410", "e4cd0e1315df1759f54c876e530c64de5784fccd", "390cc2e14ea7de63b8363d958ac0ceccfad07b7c"], "user": "imoraru@mozilla.com"}, "45708": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a9effd9e521653405f0ffd311e8edf90bde92237 with FIREFOX_153_7_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7ecd1c547f4afb15116d5b6c31ed62146d5440d6", "git_parents": ["9283e2d4c366e8b449856a145652134a6de6238c"], "node": "366299066b92042a8d9f0c18587a4dfedb950545", "parents": ["2c8f31ffeea127e33007b3f6cf58f8316a8c56f6"], "tags": []}], "date": 1793731498, "git_changesets": ["7ecd1c547f4afb15116d5b6c31ed62146d5440d6"], "user": "ffxbld@lando.moz.tools"}, "45709": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 07da6c6c016add6f8270a4ac0e53320df73b1b1c with FIREFOX_115_45_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4eed3f14bcf019692ef7ae12bdb569a4b34ab082", "git_parents": ["7ecd1c547f4afb15116d5b6c31ed62146d5440d6"], "node": "6543a077657d77a567a18c8214e7ddcb5e6d20cb", "parents": ["366299066b92042a8d9f0c18587a4dfedb950545"], "tags": []}], "date": 1793733687, "git_changesets": ["4eed3f14bcf019692ef7ae12bdb569a4b34ab082"], "user": "ffxbld@lando.moz.tools"}, "45710": {"changesets": [{"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1766112 - Stop forcing --clean after a browsertime install in mach raptor. r=perftest-reviewers,fbilt\n\nThe forced rebuild was added for the move to single-task visual metrics in 2022 and is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338458\n", "files": ["testing/raptor/mach_commands.py"], "git_node": "2596752d755b189c95d6abec9c6394827bb7ea45", "git_parents": ["390cc2e14ea7de63b8363d958ac0ceccfad07b7c"], "node": "4735041c9f5656cc59419e40521f2faf90a82080", "parents": ["8c093b0446b49748831e5ab6f0b57bdcf493edfb"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1704598 - Add --list-tests as an alias for raptor --print-tests. r=perftest-reviewers,fbilt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338456\n", "files": ["testing/raptor/raptor/cmdline.py"], "git_node": "36390917ed68a0c652d4b7332d3d7bddde696891", "git_parents": ["2596752d755b189c95d6abec9c6394827bb7ea45"], "node": "f9d6a463f8b5c3172c729d9cff63c81f90bd59df", "parents": ["4735041c9f5656cc59419e40521f2faf90a82080"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Make the CSP url-hash violation report WPT tests fail instead of timing out; r=tschuster\n\nIn implementations not reporting urlHash, two of the\nscript-url-blocked-report-contains-hash tests timed out instead of failing:\n\n- In the document test, an assertion failing in the violation event listener\n  threw an uncaught exception, so the promise never settled. Reject it instead.\n- The worker script let importScripts() of the blocked script throw. For the\n  service worker, this fails the registration, which can tear down the worker\n  before it reports the violation, so the test timed out intermittently. Catch\n  the error instead.\n\nFailing right away makes these tests quicker to run, as they no longer wait for\nthe timeout, and makes their results stable. On try, the verify jobs, which run\ntests repeatedly, failed because of the repeated and intermittent timeouts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337040\n", "files": ["testing/web-platform/meta/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash-service-worker.https.html.ini", "testing/web-platform/meta/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash.https.html.ini", "testing/web-platform/tests/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash-dedicated-worker.https.html", "testing/web-platform/tests/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash-service-worker.https.html", "testing/web-platform/tests/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash.https.html", "testing/web-platform/tests/content-security-policy/script-src/tentative/support/worker-report-hash.js"], "git_node": "2ea047ed1e0f8baf5830a8659a0124e5e38987e9", "git_parents": ["36390917ed68a0c652d4b7332d3d7bddde696891"], "node": "5e150043610532bb1fc58cc26d7fd4574945dbe8", "parents": ["f9d6a463f8b5c3172c729d9cff63c81f90bd59df"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088449 - Mark sphinx-js parallel-safe only when the docs build loads it. r=firefox-source-docs-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339169\n", "files": ["docs/conf.py"], "git_node": "3696c4d7bb009815c1146117cce69fec22dd87e0", "git_parents": ["2ea047ed1e0f8baf5830a8659a0124e5e38987e9"], "node": "fdedbc8ccceba675de9024b218f338c2f0157139", "parents": ["5e150043610532bb1fc58cc26d7fd4574945dbe8"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065125 - Allow wscapi.dll.mui in the xperf allowlist. r=perftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337537\n", "files": ["testing/talos/talos/xtalos/xperf_allowlist.json"], "git_node": "eb36867198f165218d1a27e94643f16d8e5036b3", "git_parents": ["3696c4d7bb009815c1146117cce69fec22dd87e0"], "node": "3f87b70a532f0793d3d3a136b0c77863cadcea09", "parents": ["fdedbc8ccceba675de9024b218f338c2f0157139"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073888 - Rework the Glean crash ping submission to shutdown gracefully r=crashreporting-reviewers,gsvelto\n\nThis changes the logic to return whether the ping was submitted to the\ncrashreporter client successfully, and to subsequently mark it as\nsubmitted if so. Previously, we always marked it as submitted if it made\nit to the `sendGleanPing` \"queue\" of promises, but this is unnecessary\nand prone to error (especially when it comes to shutdown).\n\nThe shutdown blocker message is kept the same as the previous one so\nthat the crash signature remains the same (to facilitate analyzing the\neffect of this patch). It wouldn't be hard to add the expected new\nsignature to the bug, but the blocker message is still broadly accurate\nto what's being done.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338434\n", "files": ["toolkit/components/crashes/CrashManager.in.sys.mjs"], "git_node": "4b683d0a4b8271424b6d48672933b50625b7ba5d", "git_parents": ["eb36867198f165218d1a27e94643f16d8e5036b3"], "node": "f3818f748e560373aa44d6af28e1768700a765a5", "parents": ["3f87b70a532f0793d3d3a136b0c77863cadcea09"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087493 - Website with inclusion always routes through recommended location instead of selected after signing out and back in - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338360\n", "files": ["browser/components/ipprotection/IPProtectionHelpers.sys.mjs", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_list.js", "toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/IPProtectionServerlist.sys.mjs", "toolkit/components/ipprotection/docs/Components.md", "toolkit/components/ipprotection/tests/xpcshell/test_IPPAutoActivation.js"], "git_node": "5cdcb1b07f22e40fef26f556f9f1d0a027482dbd", "git_parents": ["4b683d0a4b8271424b6d48672933b50625b7ba5d"], "node": "000780eafb091e9c79ae96a76e07518548b667ee", "parents": ["f3818f748e560373aa44d6af28e1768700a765a5"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088104 - Inclusion promo displayed for excluded website - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338790\n", "files": ["browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_content.js"], "git_node": "7d0e3f7509e773a9e8454006d65eb4b4bd659379", "git_parents": ["5cdcb1b07f22e40fef26f556f9f1d0a027482dbd"], "node": "837e699ff86f752ae79029989568fe90d6e97583", "parents": ["000780eafb091e9c79ae96a76e07518548b667ee"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2086754 - Batch ui-test-apk tasks on mozilla-beta via run-missing-tests r=jcristau,mbarone\n\nUsing the test-backstop alias lets the beta optimization override skip these\ntasks on push, as it already does for other test suites, while behaviour on\nother branches is unchanged. The run-missing-tests cron then needs to pick up\nthe ui-test-apk kind so they still run on beta.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337719\n", "files": ["taskcluster/gecko_taskgraph/actions/run_missing_tests.py", "taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "33868b4c189b02da22f6dfdf5de7f6393de86f8b", "git_parents": ["7d0e3f7509e773a9e8454006d65eb4b4bd659379"], "node": "5fc44b9e5d34becec8578ebb1fadd8b2bec0e3a8", "parents": ["837e699ff86f752ae79029989568fe90d6e97583"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087929 - Stop crashing when Android refuses to open an app for a link. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338952\n", "files": ["mobile/android/android-components/components/feature/app-links/src/main/java/mozilla/components/feature/app/links/AppLinksUseCases.kt", "mobile/android/android-components/components/feature/app-links/src/test/java/mozilla/components/feature/app/links/AppLinksUseCasesTest.kt"], "git_node": "309c7c75fa9f8cbe1fb2db1e244a5c259d64569c", "git_parents": ["33868b4c189b02da22f6dfdf5de7f6393de86f8b"], "node": "99274eb2f6473ca536a548a784b3fd1c14ea8949", "parents": ["5fc44b9e5d34becec8578ebb1fadd8b2bec0e3a8"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2088123 - Prevent displaying site permission prompts when FragmentManager is destroyed or state is saved. r=android-reviewers,giorga\n\nAdd a `canShowPrompt` check in `SitePermissionsFeature` to ensure permission prompt dialog fragments are not committed when `fragmentManager.isDestroyed` or `fragmentManager.isStateSaved` is true, preventing potential `IllegalStateException` crashes during fragment transactions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338809\n", "files": ["mobile/android/android-components/components/feature/sitepermissions/src/main/java/mozilla/components/feature/sitepermissions/SitePermissionsFeature.kt", "mobile/android/android-components/components/feature/sitepermissions/src/test/java/mozilla/components/feature/sitepermissions/SitePermissionsFeatureTest.kt"], "git_node": "23c341b03fdd556c706db2e3c6a6aa447e724b1f", "git_parents": ["309c7c75fa9f8cbe1fb2db1e244a5c259d64569c"], "node": "cd1beec6ce4077c40d4862830fd38ee074816bbc", "parents": ["99274eb2f6473ca536a548a784b3fd1c14ea8949"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2083203 - deconflict windows graphics monitors, r=gfx-reviewers,nical\n\nThese identically named variables were causing issues after removing other files\nthat caused them to be unified-compiled together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338323\n", "files": ["widget/windows/WinCompositorWindowThread.cpp", "widget/windows/WinCompositorWindowThread.h", "widget/windows/WinWindowOcclusionTracker.cpp", "widget/windows/WinWindowOcclusionTracker.h"], "git_node": "80bc411b68ae7820c2cc53d3977102c46b1a0069", "git_parents": ["23c341b03fdd556c706db2e3c6a6aa447e724b1f"], "node": "9d290535feb3774dd20df0b7aed17a621e5f5749", "parents": ["cd1beec6ce4077c40d4862830fd38ee074816bbc"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2083203 - remove the remnants of the unmaintained FxR, r=firefox-desktop-core-reviewers ,gfx-reviewers,mossop,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338324\n", "files": [".stylelintrc.js", "browser/actors/WebRTCParent.sys.mjs", "browser/base/content/test/browser-static/browser_all_files_referenced.js", "browser/components/permissions/ContentPermissionPrompt.sys.mjs", "browser/fxr/content/assets/icon-backward.svg", "browser/fxr/content/assets/icon-forward.svg", "browser/fxr/content/assets/icon-home.svg", "browser/fxr/content/assets/icon-logo-settings-preview.png", "browser/fxr/content/assets/icon-refresh.svg", "browser/fxr/content/assets/icon-reportissue.svg", "browser/fxr/content/assets/icon-secure.svg", "browser/fxr/content/assets/icon-settings.svg", "browser/fxr/content/assets/icon-stop-reload.svg", "browser/fxr/content/assets/icon-toggle-off.png", "browser/fxr/content/assets/icon-toggle-on.png", "browser/fxr/content/common.css", "browser/fxr/content/common.js", "browser/fxr/content/fxr-fullScreen.js", "browser/fxr/content/fxrui.css", "browser/fxr/content/fxrui.html", "browser/fxr/content/fxrui.js", "browser/fxr/content/fxrui_blue.css", "browser/fxr/content/permissions.js", "browser/fxr/content/prefs.css", "browser/fxr/content/prefs.html", "browser/fxr/content/prefs.js", "browser/fxr/jar.mn", "browser/fxr/moz.build", "browser/moz.build", "dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "dom/base/nsPIDOMWindow.h", "dom/ipc/BrowserParent.cpp", "dom/vr/XRSystem.cpp", "eslint-rollouts.config.mjs", "gfx/config/gfxVars.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/ContentCompositorBridgeParent.h", "gfx/layers/ipc/PCompositorBridge.ipdl", "gfx/tests/gtest/TestConfigManager.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/vr/FxROutputHandler.cpp", "gfx/vr/FxROutputHandler.h", "gfx/vr/FxRWindowManager.cpp", "gfx/vr/FxRWindowManager.h", "gfx/vr/VRShMem.cpp", "gfx/vr/VRShMem.h", "gfx/vr/components.conf", "gfx/vr/external_api/moz_external_vr.h", "gfx/vr/moz.build", "gfx/vr/nsFxrCommandLineHandler.cpp", "gfx/vr/nsFxrCommandLineHandler.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "layout/tools/reftest/reftest-content.js", "toolkit/components/extensions/ExtensionParent.sys.mjs", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "tools/lint/file-whitespace.yml", "widget/android/GfxInfo.cpp", "widget/android/GfxInfo.h", "widget/cocoa/GfxInfo.h", "widget/cocoa/GfxInfo.mm", "widget/gtk/GfxInfo.cpp", "widget/gtk/GfxInfo.h", "widget/nsIGfxInfo.idl", "widget/nsIWidget.h", "widget/uikit/GfxInfo.cpp", "widget/uikit/GfxInfo.h", "widget/windows/GfxInfo.cpp", "widget/windows/GfxInfo.h", "widget/windows/OSKVRManager.cpp", "widget/windows/OSKVRManager.h", "widget/windows/WinCompositorWidget.cpp", "widget/windows/WinCompositorWidget.h", "widget/windows/WinIMEHandler.cpp", "widget/windows/moz.build", "widget/windows/nsWindow.h", "widget/windows/nsWindowGfx.cpp"], "git_node": "bd923ebc3d5e208f59145565895e609ef6091740", "git_parents": ["80bc411b68ae7820c2cc53d3977102c46b1a0069"], "node": "6ab5f22293ceaf89925fb4e07e61e8f0a613f1a5", "parents": ["9d290535feb3774dd20df0b7aed17a621e5f5749"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2083203: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/base/nsPIDOMWindow.h", "dom/ipc/BrowserParent.cpp", "gfx/thebes/gfxPlatform.cpp", "widget/windows/WinCompositorWidget.h", "widget/windows/nsWindowGfx.cpp"], "git_node": "f66169913e723ef9281ddc4f76dc456bafc393f3", "git_parents": ["bd923ebc3d5e208f59145565895e609ef6091740"], "node": "b94393ae2791cf05ce824fe37e76958a214ba0ae", "parents": ["6ab5f22293ceaf89925fb4e07e61e8f0a613f1a5"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087591 - Allow New Tab widget registry entries to add items to their card menu. r=fchasen\n\nA registry entry with `card: \"FramedWidgetCard\"` is drawn by the new\nFramedWidgetCard component, for a widget whose document a hosted page provides.\nIt is a MozWidgetCard with the entry's `menu` items above the shared ones.\nA \"choice\" item is a submenu of checkable options whose value is stored in a\npref and passed to the widget's document in its URL fragment; an \"action\" item\nruns a host action, of which \"show-customize\" is the only one.\n\nAn option can also name a `size`: while it is chosen, the widget is drawn at\nleast that size where the layout allows resizing, and choosing a smaller size\nswitches the choice to its first option that fits.\n\nThe frame keeps the URL it first loaded. Later changes to only its fragment\nreach it through location.replace(), so switching options doesn't add entries\nto the tab's session history.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338385\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/FramedWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/lib/utils.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FramedWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MozWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsErrorBoundary.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx"], "git_node": "a3fc0af69f9441ecf5101b6c26dc57b867dde5f3", "git_parents": ["f66169913e723ef9281ddc4f76dc456bafc393f3"], "node": "a554f7ee29c7a986ec5bda943e0db801e9f4e5d4", "parents": ["b94393ae2791cf05ce824fe37e76958a214ba0ae"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087597 - Show a placeholder in a widget card that has no document. r=nina-py,fluent-reviewers,bolsson\n\nMozWidgetCard shows \"Watch this space\" in place of the widget while its\nregistry entry has no document to frame. This is meant as a fallback while\nframed widgets using MozWidgetCard are built out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338386\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MozWidgetCard.test.jsx", "browser/locales-preview/newtabPreview.ftl"], "git_node": "8d29e20ff7b39aafd1a9a2c804c50cbf26641598", "git_parents": ["a3fc0af69f9441ecf5101b6c26dc57b867dde5f3"], "node": "69703ff99b857ceada0e965b014761d62fc2be03", "parents": ["a554f7ee29c7a986ec5bda943e0db801e9f4e5d4"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088149 - Make the layer append in FrameUniformityData::ToJS infallible r=gfx-reviewers,lsalzman\n\ndom::Sequence is a FallibleTArray, which has no infallible AppendElement, so the obsolete bug 968520 workaround used AppendElement(fallible) wrapped in MOZ_ALWAYS_TRUE. Build the entries in an infallible nsTArray instead and move it into the dictionary's Sequence, removing the stale FIXME.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338866\n", "files": ["gfx/layers/composite/FrameUniformityData.cpp"], "git_node": "8559b70993f4f3ed23c7b3e879e990f95f523068", "git_parents": ["8d29e20ff7b39aafd1a9a2c804c50cbf26641598"], "node": "e2ea9bf439d9819fedd35c7922c599cf5ccd366c", "parents": ["69703ff99b857ceada0e965b014761d62fc2be03"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088144 - Re-enable the frame url check in browser_ext_webNavigation_getFrames.js r=extension-reviewers,rpl\n\nBug 1246125 has been fixed, so the url reported by webNavigation.getAllFrames can again be compared with the url from webNavigation.onCompleted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338816\n", "files": ["browser/components/extensions/test/browser/browser_ext_webNavigation_getFrames.js"], "git_node": "0b858f3cb5e430858f34b6edb9c6c2ddab18364b", "git_parents": ["8559b70993f4f3ed23c7b3e879e990f95f523068"], "node": "b5c7bdbfc878d504f3a775267e3b99c639096d25", "parents": ["e2ea9bf439d9819fedd35c7922c599cf5ccd366c"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068399 - Add some font-list thread-safety annotations. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328457\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxPlatformFontList.h"], "git_node": "dcafde486e11b7a7776137b92fec2a6f56744eab", "git_parents": ["0b858f3cb5e430858f34b6edb9c6c2ddab18364b"], "node": "92b9ae37bedf12951c49c5b53c166c65b7c33b44", "parents": ["b5c7bdbfc878d504f3a775267e3b99c639096d25"], "tags": []}], "date": 1793742227, "git_changesets": ["2596752d755b189c95d6abec9c6394827bb7ea45", "36390917ed68a0c652d4b7332d3d7bddde696891", "2ea047ed1e0f8baf5830a8659a0124e5e38987e9", "3696c4d7bb009815c1146117cce69fec22dd87e0", "eb36867198f165218d1a27e94643f16d8e5036b3", "4b683d0a4b8271424b6d48672933b50625b7ba5d", "5cdcb1b07f22e40fef26f556f9f1d0a027482dbd", "7d0e3f7509e773a9e8454006d65eb4b4bd659379", "33868b4c189b02da22f6dfdf5de7f6393de86f8b", "309c7c75fa9f8cbe1fb2db1e244a5c259d64569c", "23c341b03fdd556c706db2e3c6a6aa447e724b1f", "80bc411b68ae7820c2cc53d3977102c46b1a0069", "bd923ebc3d5e208f59145565895e609ef6091740", "f66169913e723ef9281ddc4f76dc456bafc393f3", "a3fc0af69f9441ecf5101b6c26dc57b867dde5f3", "8d29e20ff7b39aafd1a9a2c804c50cbf26641598", "8559b70993f4f3ed23c7b3e879e990f95f523068", "0b858f3cb5e430858f34b6edb9c6c2ddab18364b", "dcafde486e11b7a7776137b92fec2a6f56744eab"], "user": "ctuns@mozilla.com"}, "45711": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088091 - onnavigate should fire after onbeforeunload. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338774\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "testing/web-platform/meta/navigation-api/navigate-event/navigate-navigation-back-cross-document.html.ini"], "git_node": "79751bfb6167e271bc6383fe9d26e03c7e3ec57d", "git_parents": ["dcafde486e11b7a7776137b92fec2a6f56744eab"], "node": "8cb5d08a745b568ee554bdf1634d49fa21cbf82f", "parents": ["92b9ae37bedf12951c49c5b53c166c65b7c33b44"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086592 - fix browser_pop_tab test and add it back to the mini window toml. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338810\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_pop_tab.js"], "git_node": "a38452a4855cb286958f388b2dd96b3f8218b4a0", "git_parents": ["79751bfb6167e271bc6383fe9d26e03c7e3ec57d"], "node": "e6903ab22c1562bd383b94c5369d4f8157cc6891", "parents": ["8cb5d08a745b568ee554bdf1634d49fa21cbf82f"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087252 - Remove the universal-edge-to-edge-wallpapers Nimbus feature and secret setting. r=android-reviewers,skhan\n\nUniversal edge-to-edge wallpapers are enabled by default, so the code paths for the treatment being off are removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338311\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/BrowserSimpleToolbar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomepageToolbarColors.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/StatusBarColorManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/theme/StatusBarColorManagerTest.kt"], "git_node": "10aae9ac50c172b2d75b5e42a54647ab6014aa15", "git_parents": ["a38452a4855cb286958f388b2dd96b3f8218b4a0"], "node": "8ab5af608d43d8b06eb74ec6c3f6c3d92ab6a927", "parents": ["e6903ab22c1562bd383b94c5369d4f8157cc6891"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087107 - Treat the edge-to-edge wallpaper like any other wallpaper, except for drawing its gradient. r=android-reviewers,mobiletest-reviewers,skhan\n\nThe gradient is now drawn by WallpaperBackground instead of the window background, and HomepageEdgeToEdgeFeature,\nwhich also gave the edge-to-edge wallpaper its own status bar background, is removed along with the other\nedge-to-edge-wallpaper-specific toolbar, tab strip and clipboard bar colors.\n\nThe clipboard suggestion bar now uses the same surface color as the toolbar while searching, as it already did for\nthe other wallpapers, instead of its own opaque color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338023\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHomepageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/TabStripColors.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomepageEdgeToEdgeFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomepageToolbarColors.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/HomepageTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/WallpaperBackground.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/AwesomeBarComposable.kt", "mobile/android/fenix/app/src/main/res/drawable/home_background_gradient.xml", "mobile/android/fenix/app/src/main/res/values-night/colors.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/HomeFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/HomepageEdgeToEdgeFeatureTest.kt"], "git_node": "720980046e4f90f2b81ec5ff38fe5889b5720650", "git_parents": ["10aae9ac50c172b2d75b5e42a54647ab6014aa15"], "node": "3ce8bee78a74148ca42fc5bbec315bbde7a7ef00", "parents": ["8ab5af608d43d8b06eb74ec6c3f6c3d92ab6a927"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087109 - Remove the homescreen-edge-to-edge-background Nimbus feature. r=android-reviewers,skhan\n\nThe edge-to-edge wallpaper is now always offered and is the default wallpaper, as it was with the feature enabled by\ndefault.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338026\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/Wallpaper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/WallpapersUseCases.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/wallpapers/WallpapersUseCasesTest.kt"], "git_node": "bfe34cf64d750e7fd4ca469125c99929aac6b700", "git_parents": ["720980046e4f90f2b81ec5ff38fe5889b5720650"], "node": "98a239e1b70ffa20c013ffd0b0f8feb27b320350", "parents": ["3ce8bee78a74148ca42fc5bbec315bbde7a7ef00"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085907 - Hide the tab strip while search is active. r=android-reviewers,skhan\n\nThe search screen covers the page, so the tab strip is hidden while a search is active:\n- HomeFragment.TabStrip hides it on the homepage.\n- BaseBrowserFragment.buildTabStrip hides it on the browser screen. It builds the tab strip content used by both the\n  top toolbar and the bottom toolbar or navigation bar, so this covers every tab strip position.\n- BrowserToolbarComposable now updates hasBottomStrip with the search state instead of remembering it once. It decides\n  whether the bottom toolbar's divider is drawn above the tab strip container or on the toolbar itself, so the divider\n  moves to the toolbar while the bottom tab strip is hidden.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337596\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt"], "git_node": "f66622fd64b624b9530b201048b88692eba71882", "git_parents": ["bfe34cf64d750e7fd4ca469125c99929aac6b700"], "node": "6d91b05fdf2c13730f85e57ada2ef5f0f9d61ddd", "parents": ["98a239e1b70ffa20c013ffd0b0f8feb27b320350"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082613 - Match the system bars to the search screen background while searching. r=android-reviewers,skhan\n\nWith universal edge-to-edge wallpapers, the wallpaper is drawn behind the system bars, which the search screen does\nnot cover.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337597\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/FenixHomeToolbar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposableTest.kt"], "git_node": "75496211596864118aac08ec9ccefbe68c70e203", "git_parents": ["f66622fd64b624b9530b201048b88692eba71882"], "node": "9f597b53b7108f7475934c83a21b462344fda33f", "parents": ["6d91b05fdf2c13730f85e57ada2ef5f0f9d61ddd"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086211 - Remove the tab strip and status bar gradient. r=android-reviewers,skhan\n\nThe tab strip and status bar halves of the gradient were drawn and updated independently, so they changed out of step.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337598\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/TabStripColors.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/StatusBarColorManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/TabStripStatusBarView.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/theme/StatusBarColorManagerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/theme/TabStripStatusBarViewTest.kt"], "git_node": "fdb956905a27cf04446d1f16c5f4c63ed45dfa18", "git_parents": ["75496211596864118aac08ec9ccefbe68c70e203"], "node": "098f76c240945025e7dc350d6c8455db2e29fa90", "parents": ["9f597b53b7108f7475934c83a21b462344fda33f"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084920 - Part 1: Check CSP for redirects from nsContentPolicy instead of CSPService. r=emilio,layout-reviewers\n\nConnection Allowlists also need to check redirects. Moving the\nnsIChannelEventSink to nsContentPolicy lets both policies share the logic\ndeciding in which process a redirect is checked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338717\n", "files": ["dom/base/nsContentPolicy.cpp", "dom/base/nsContentPolicy.h", "dom/security/nsCSPService.cpp", "dom/security/nsCSPService.h", "layout/build/components.conf"], "git_node": "41458fb82cb55adfe91a73f22068d5bec4b46f2e", "git_parents": ["fdb956905a27cf04446d1f16c5f4c63ed45dfa18"], "node": "c4caae999d31a964794f403531bcf807048e2c35", "parents": ["098f76c240945025e7dc350d6c8455db2e29fa90"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084920 - Part 2: Connection Allowlists: Block redirects. r=emilio\n\nUnless an allowlist sets redirects=allow, any redirect of a request\nsubject to it is blocked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338718\n", "files": ["dom/base/nsContentPolicy.cpp", "dom/security/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlists.h", "dom/security/ConnectionAllowlistsService.cpp", "dom/security/ConnectionAllowlistsService.h", "testing/web-platform/meta/connection-allowlist/tentative/dedicated-worker-redirect-block.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/dedicated-worker-redirect-default.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/fetch-keepalive-redirect.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/fetch-redirect-block.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/fetch-redirect-default.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/navigation-redirect-block.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/navigation-redirect-default.sub.window.js.ini"], "git_node": "ac95fea33336e99ee7a5094c26ded6b923de9b22", "git_parents": ["41458fb82cb55adfe91a73f22068d5bec4b46f2e"], "node": "5c6e7fe712936d795fed3bf019a796c909c5f38f", "parents": ["c4caae999d31a964794f403531bcf807048e2c35"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084920 - Part 3: Connection Allowlists: Report blocked redirects. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338719\n", "files": ["dom/locales/en-US/chrome/security/security.properties", "dom/security/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlists.h"], "git_node": "e1f35e7264daf16d754165488f6c732a6666fc19", "git_parents": ["ac95fea33336e99ee7a5094c26ded6b923de9b22"], "node": "8479928307197cf6bf27050dd2ab81fe46aadc9f", "parents": ["5c6e7fe712936d795fed3bf019a796c909c5f38f"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084920 - Part 4: Connection Allowlists: Don't treat https: upgrades as redirects. r=necko-reviewers,jesup\n\nGecko performs https: upgrades as REDIRECT_STS_UPGRADE redirects, but Fetch\nchanges the request's URL in place. upgrade-insecure-requests and the mixed\ncontent upgrade happen before the Connection Allowlists check, so match the\nupgraded URL, while HSTS happens after it, so match the original URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338757\n", "files": ["dom/security/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlistsService.cpp", "dom/security/test/connection-allowlist/file_upgrade.sjs", "dom/security/test/connection-allowlist/mochitest.toml", "dom/security/test/connection-allowlist/test_https_upgrades.html", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h"], "git_node": "065ac27b25cfda15877bd0a3b72a28bc2c8d2aa6", "git_parents": ["e1f35e7264daf16d754165488f6c732a6666fc19"], "node": "25a72b4e6ac2dd3ed2ac974475df7dae7ec20c97", "parents": ["8479928307197cf6bf27050dd2ab81fe46aadc9f"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087199 - Don't clear the ongoing navigate event when a cross-document navigation commits. r=farre\n\nnavigate-204-205-download-then-same-document.html and\nnavigate-cross-document-double.html expected the promises returned by\nnavigate() to reject when the navigation is aborted. Per spec, commit\na navigate event already cleaned up the API method tracker of the\ncross-document navigation, so abort a NavigateEvent has no tracker\nwhose promises it could reject; they never settle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339183\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "dom/navigation/Navigation.cpp", "dom/navigation/Navigation.h", "testing/web-platform/meta/navigation-api/navigate-event/signal-abort-window-stop.html.ini", "testing/web-platform/meta/navigation-api/ordering-and-transition/navigate-204-205-download-then-same-document.html.ini", "testing/web-platform/meta/navigation-api/ordering-and-transition/navigate-cross-document-double.html.ini", "testing/web-platform/tests/navigation-api/ordering-and-transition/navigate-204-205-download-then-same-document.html", "testing/web-platform/tests/navigation-api/ordering-and-transition/navigate-cross-document-double.html"], "git_node": "f5f116a9a08aebf1fe0cedab470a16022745db30", "git_parents": ["065ac27b25cfda15877bd0a3b72a28bc2c8d2aa6"], "node": "db62bca19d38faf71690793f13b8074ab8b40191", "parents": ["25a72b4e6ac2dd3ed2ac974475df7dae7ec20c97"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088417 - Ensure the quotes.match-parent pref is enabled for relevant WPT tests. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339172\n", "files": ["testing/web-platform/meta/css/css-content/__dir__.ini"], "git_node": "2e069c55d114b207d42091820905a8c26f425a69", "git_parents": ["f5f116a9a08aebf1fe0cedab470a16022745db30"], "node": "bf1c19c1a5ef457228d4180fcfd911e71a712eb8", "parents": ["db62bca19d38faf71690793f13b8074ab8b40191"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087595 - Add a stub Wrexham AFC widget to New Tab. r=fchasen,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338387\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_wrexhamafc_widget.js", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/locales-preview/newtabPreview.ftl"], "git_node": "73b40c038f7c65816d360f7409e6e7777dd89308", "git_parents": ["2e069c55d114b207d42091820905a8c26f425a69"], "node": "62fd5fa84020f8318475b0f472aad6befc37f0c5", "parents": ["bf1c19c1a5ef457228d4180fcfd911e71a712eb8"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074205 - Avoid building WR bridges twice. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333195\n", "files": ["gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": "ae803b44587ee5edcad2302104ffcd6b2f31cda2", "git_parents": ["73b40c038f7c65816d360f7409e6e7777dd89308"], "node": "dc02be0097dc5fa8f6d4a91739fd05023d4b897e", "parents": ["62fd5fa84020f8318475b0f472aad6befc37f0c5"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074205 - Replace the previous APZ actors when a layer tree gets new ones. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333196\n", "files": ["gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": "5400cc3327e88428bb2d3ae126171be81d82c805", "git_parents": ["ae803b44587ee5edcad2302104ffcd6b2f31cda2"], "node": "574abd6ad4c6a4844e2f731ed57c2d60437591dc", "parents": ["dc02be0097dc5fa8f6d4a91739fd05023d4b897e"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074205 - Check that the pipeline is not in use when creating a WebRenderBridgeParent. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333197\n", "files": ["gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": "163245b932951df3104fa8fc9b723905fe01a239", "git_parents": ["5400cc3327e88428bb2d3ae126171be81d82c805"], "node": "688a9be8039358626de9ae4952f9f8766e266fad", "parents": ["574abd6ad4c6a4844e2f731ed57c2d60437591dc"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088413 - Make SpecifiedValueInfo account for the quotes.match-parent pref. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339170\n", "files": ["servo/components/style/values/specified/list.rs"], "git_node": "3b796e7e10878efd847304058d6bae96024bd152", "git_parents": ["163245b932951df3104fa8fc9b723905fe01a239"], "node": "25461890429f5794cf2979c9d5eb9caeec8fa0e8", "parents": ["688a9be8039358626de9ae4952f9f8766e266fad"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074187 - Validate the ShmemSection heap header in AllocShmemSection. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333235\n", "files": ["gfx/layers/ipc/ISurfaceAllocator.cpp"], "git_node": "87888d127eecfe94ef7ad5fd64cf452653cfcff3", "git_parents": ["3b796e7e10878efd847304058d6bae96024bd152"], "node": "ca6a2966ba0cc11595f84f616f3463a6f1600c3d", "parents": ["25461890429f5794cf2979c9d5eb9caeec8fa0e8"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088170 - Skip (re-)validation of font tables when stripping shaping tables for freetype. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339177\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxOTSUtils.h"], "git_node": "d968626acc66562fb567944595fe1dc0c29c8f65", "git_parents": ["87888d127eecfe94ef7ad5fd64cf452653cfcff3"], "node": "b19d6ea9571cc492fe782f8f920e498595159466", "parents": ["ca6a2966ba0cc11595f84f616f3463a6f1600c3d"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073689 - Register VideoBridgeParent after taking a reference to it. r=gfx-reviewers,bradwerth,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335662\n", "files": ["gfx/layers/ipc/VideoBridgeParent.cpp", "gfx/layers/ipc/VideoBridgeParent.h"], "git_node": "104f40b3fc54a83c0ba6d2105c2f052eafffef50", "git_parents": ["d968626acc66562fb567944595fe1dc0c29c8f65"], "node": "0d0d59d77955c6253e41dd99b03b2351f27b5392", "parents": ["b19d6ea9571cc492fe782f8f920e498595159466"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2088160 - Render clip-path polygon() with WebRender path clips. r=firefox-svg-reviewers,longsonr\n\nWhen gfx.webrender.paths is enabled, polygon() clip paths are recorded with WrPathRecorder like path() and shape() instead of being painted into a mask image.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338802\n", "files": ["layout/painting/nsDisplayList.cpp", "layout/svg/SVGUtils.cpp", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-fill.html.ini"], "git_node": "bcc23724d073d6b33ba083dd6f88ae7296fb8df9", "git_parents": ["104f40b3fc54a83c0ba6d2105c2f052eafffef50"], "node": "0eda74f8dc07032dc105a0ba2fc7b83c21c73012", "parents": ["0d0d59d77955c6253e41dd99b03b2351f27b5392"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2085051 - Update to scip-javac and scip-kotlinc 0.13.2. r=RyanVM,android-build-system-reviewers\n\nsemanticdb-javac and semanticdb-kotlinc which used to output 1\nSemanticDB per Java/Kotlin source file to be aggregated with scip-java\nindex-semanticdb were reworked and renamed scip-javac and scip-kotlinc\nand now output 1 partial SCIP index per source file to be aggregated\nusing scip-java aggregate.\n\nIf needed we can eventually move back to a fork of ours but let's use\nthe upstream release for now.\n\nDepends on https://github.com/mozsearch/mozsearch-mozilla/pull/340 on\nthe Searchfox side.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339178\n", "files": ["build.gradle", "gradle/libs.versions.toml", "mobile/android/config/mozconfigs/android-arm-gradle-dependencies/base", "mobile/android/mach_commands.py", "toolkit/mozapps/installer/packager.mk"], "git_node": "bfb977a72e2d4463244ab6be40807f3865220701", "git_parents": ["bcc23724d073d6b33ba083dd6f88ae7296fb8df9"], "node": "4d9770b0322d590292722c7cc24d05628291fd33", "parents": ["0eda74f8dc07032dc105a0ba2fc7b83c21c73012"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081544 - Validate another argument of the integer-GEMM column selection intrinsic. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333754\n", "files": ["js/src/intgemm/IntegerGemmIntrinsic.cpp", "js/src/jit-test/tests/wasm/builtin-modules/integer-gemm/I8SelectColumnsOfB.js"], "git_node": "4b796a9f84696f4387907e9ff9ccb3cf666df320", "git_parents": ["bfb977a72e2d4463244ab6be40807f3865220701"], "node": "a44472eaac1d6d5c45ad36f822cb909cc5a3b185", "parents": ["4d9770b0322d590292722c7cc24d05628291fd33"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081214 - Fix Smart Window resume card button active states in HCM r=flozia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338113\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-resume-card/smartwindow-resume-card.css", "browser/components/aiwindow/ui/components/smartwindow-resume-section/smartwindow-resume-section.css"], "git_node": "8995035e89fdfe135afe90e28e9ae8ec77ede7e6", "git_parents": ["4b796a9f84696f4387907e9ff9ccb3cf666df320"], "node": "243f8266229fb3a996f671ae7e375041e76e0964", "parents": ["a44472eaac1d6d5c45ad36f822cb909cc5a3b185"], "tags": []}, {"author": "Philip Chimento \u003cpchimento@igalia.com\u003e", "branch": "default", "desc": "Bug 2085037 - Inline std::to_chars and templatize AppendInt32ToStringBuilder. r=iain\n\nOptimize appending an int32_t to a two-byte StringBuilder, in addition\nto the one-byte case. We can't do std::to_chars on char16_t, but it's\nsimple enough to open-code inline, in a templated function that works on\nboth one-byte and two-byte StringBuilders.\n\nTo my surprise this 2-digit-at-a-time lookup table is even faster than\nthe standard library's std::to_chars on my platform (x86-64 clang). So\nthis seems to be a modest improvement for one-byte StringBuilders as\nwell. If it isn't the case on other platforms, the solution would be to\ncontinue to use std::to_chars for the Latin1 case, with if constexpr.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336782\n", "files": ["js/src/builtin/Number.cpp"], "git_node": "83f3b5898718271cd55a040cff80287007a0399b", "git_parents": ["8995035e89fdfe135afe90e28e9ae8ec77ede7e6"], "node": "ab96785452cbccda7d0e90f8125e8e9c40497855", "parents": ["243f8266229fb3a996f671ae7e375041e76e0964"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088490 - Update jsoup to version 1.24.1. r=android-reviewers,android-build-system-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339187\n", "files": ["gradle/libs.versions.toml"], "git_node": "26f052f8a539db2946168d997e8e704b43cc2e66", "git_parents": ["83f3b5898718271cd55a040cff80287007a0399b"], "node": "8d2be6c08f10288482914afef2df677cf099ced8", "parents": ["ab96785452cbccda7d0e90f8125e8e9c40497855"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2084028 - Strip trailing dots from the host in AllowedDomainsForApps. r=jmendez\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338911\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_allowed_domains_for_apps.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "25da405ab30b9580080fc0436661d2ea21f4094a", "git_parents": ["26f052f8a539db2946168d997e8e704b43cc2e66"], "node": "0865bda6d18bc6594a4f376e5ccf574cfb57afad", "parents": ["8d2be6c08f10288482914afef2df677cf099ced8"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087206 - Part 1 - Don't lose focus when transitioning to disabled= r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338087\n", "files": ["dom/base/FocusModel.h", "dom/base/nsFocusManager.cpp", "dom/html/HTMLButtonElement.cpp", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLSelectElement.cpp", "dom/html/HTMLTextAreaElement.cpp", "dom/html/nsGenericHTMLElement.cpp", "dom/html/test/mochitest.toml", "dom/html/test/test_disabled_focus.html", "dom/xul/nsXULElement.cpp", "dom/xul/test/chrome.toml", "dom/xul/test/test_xul_disabled_focus.xhtml", "layout/base/PresShell.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/interaction/focus/processing-model/focus-fixup-rule-disabled.tentative.html.ini", "testing/web-platform/tests/html/interaction/focus/processing-model/focus-fixup-rule-disabled.tentative.html"], "git_node": "ca13b3aa25e6c5bcfcf82ac56bca8f84600fea5c", "git_parents": ["25da405ab30b9580080fc0436661d2ea21f4094a"], "node": "e1b70f73fff41e812559906811de7fe9fe50c58e", "parents": ["0865bda6d18bc6594a4f376e5ccf574cfb57afad"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087206 - Part 2 - Retain focus in date/time inputs on disabling. r=desktop-theme-reviewers,reusable-components-reviewers,hjones\n\nA focused date or time input still loses focus when it becomes disabled. Focus\nsits on an edit field inside the input's UA widget via `-moz-user-focus: none`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338541\n", "files": ["dom/html/nsGenericHTMLElement.cpp", "dom/html/test/test_disabled_focus.html", "testing/web-platform/tests/html/interaction/focus/processing-model/focus-fixup-rule-disabled.tentative.html", "toolkit/content/widgets/datetimebox.css"], "git_node": "868fc2f4810144de3adf21fc4fd82c2a8b8af9c3", "git_parents": ["ca13b3aa25e6c5bcfcf82ac56bca8f84600fea5c"], "node": "f4492336a3dcc0e014d57f7ece74833b8e61e173", "parents": ["e1b70f73fff41e812559906811de7fe9fe50c58e"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072957 - Add icon to tab which is being read with Listen to page. r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338007\n", "files": ["mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/action/BrowserAction.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/BrowserStateReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/ListenToPageReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/TabSessionState.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/action/ListenToPageActionTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/tabs/DefaultTabRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenToPageBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/data/TabsTrayItem.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/tabs/DefaultTabRepositoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/listentopage/ListenToPageBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/data/TabsTrayItemTest.kt"], "git_node": "bc716b06619f1cc7f2edd6241e73fc319a4d435d", "git_parents": ["868fc2f4810144de3adf21fc4fd82c2a8b8af9c3"], "node": "c91850298ec5c85c14fa70e5bb00f24e2156ea47", "parents": ["f4492336a3dcc0e014d57f7ece74833b8e61e173"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086309: finish PGO corpus items when they complete r=perftest-reviewers,kshampur\n\nAt the moment, we rely on fixed timeouts to progress to subsequent PGO training items. In effect, this means we spend a lot of time idle. Instead, we can signal when each item completes and move on more quickly.\n\nAs an example, when running locally there is a very sizable (10s+) delay after speedometer tests complete before the next one starts. There's shorter delays on all other tests which end up adding up to quite a bit overall. In CI it seems like these waits are greatly exaggerated (see below for before/after numbers). If it matters, I ran my local tests on Linux, not macOS.\n\nI started looking at this as a way of trying to improve throughput on macOS hardware. I found that P5/50/95 for macOS aarch64 profile generation is 15/17/31 minutes respectively. With this patch, my first profile run was 7min, and had no notable impact on browsertime nor talos numbers.\n\nWe run anywhere from ~100 to ~500 of these tasks per day. If we manage to save 10min per task in reality, we gain back ~1000 to ~5000 minutes on these workers per day. At a 7 minute runtime, that's an extra ~140 - ~700 generate profile tasks we could run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337343\n", "files": ["build/pgo/index.html", "build/pgo/profileserver.py"], "git_node": "08038947953e826666de2bc635a0f4d252b72038", "git_parents": ["bc716b06619f1cc7f2edd6241e73fc319a4d435d"], "node": "c2334fc6173c3492b5797403660be511070b386c", "parents": ["c91850298ec5c85c14fa70e5bb00f24e2156ea47"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076457 - Update shared downloads theme CSS so it passes use-design-tokens r=desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334229\n", "files": ["browser/themes/linux/downloads/downloads.css", "browser/themes/osx/downloads/downloads.css", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/downloads/allDownloadsView.inc.css", "browser/themes/shared/downloads/contentAreaDownloadsView.css", "browser/themes/shared/downloads/download-blockedStates.css", "browser/themes/shared/downloads/downloads.inc.css", "browser/themes/shared/downloads/indicator.css", "browser/themes/shared/downloads/progressmeter.css", "browser/themes/windows/downloads/downloads.css", "stylelint-rollouts.config.js", "tools/lint/stylelint/stylelint-plugin-mozilla/config.mjs"], "git_node": "c9c3be2d9573dce7811808c3f0ed3f9da5209d0b", "git_parents": ["08038947953e826666de2bc635a0f4d252b72038"], "node": "138dfeea37fce6b71fe67ac5e3433bbf806f08f9", "parents": ["c2334fc6173c3492b5797403660be511070b386c"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086470 - Update metadata for html/semantics/interactive-elements/the-summary-element/interactive-content.html.\n\nDifferential Revi