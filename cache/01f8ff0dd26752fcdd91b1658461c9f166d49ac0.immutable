fb1373447da23525661cc88b60ca9749c9a8c079", "6371b975daa23a402d758ec4087b875db70b8f67", "ad9e608654767b746c82196bf2de7c867c564498", "ac4ffb51155729bb3cda97febd9646aeb14a7143", "e74f5a48f0c69c14861a01acd30f667b17079bff", "02c42c546d4a5cbdf11cfa77c547820f67aedc59", "f8a0895bb4984e3099a775e2e5113b81883a95f6", "4e2a2fc656fb19feeae2bbbb6e9c44e700ad35a2", "e9864f06d4ba36422a39314fa0dbece8f259f01b", "31cdffc607b8c753270f564ec20d31ca59075c5d", "32af0f3bb6b323c1c660d70ecbad4e64479c09f5", "5d92eeb33763d7b06124f051a8b1f6efe0909a5c", "6fa4788507be472b8112d48e93b39e6120f4954a", "ca007f7b32a32be5d5a017aa844bea28ee638ce1", "190db23362eb948d31eb796a29d3f4e7c50924d6", "af9936217b2c51f179145f795b0588771f1d1001", "fc6c0e60f844b887bc452af63cc3189e35bc19f0", "7a342abfeb9b0b01d71b9df997d3f65e3fe89e82", "f462555168a61b0f0453ff893f6954aee1ee7a79", "371ce9b8b704726b7a7ed427609df6aaa088aca8", "3ec4caf4136fc189393b4c261ed584e47552e136", "a5df22d986d4b626f771b4f8885241941601c35c"], "user": "rperta@mozilla.com"}, "45687": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2083897 - Give parent-initiated loads their DocumentChannel id up front so the BFCache check can match it, r=dom-core-reviewers,necko-reviewers,smaug,jesup.\n\nFor a parent-initiated load, a process switch check that ran before content's\nDocumentChannel claimed the load saw an unknown request in content's loadgroup\nand kept the previous page out of the BFCache, causing the intermittent BFCache\ntimeout in browser_policy_sitepolicies_serviceworkers.js. The parent now takes\nthe id from its channel and sends it in the load state, replacing\nHasSpeculativeListener. Content's DocumentChannel uses it, so observers and\ndevtools see the parent channel's id, as for content-initiated loads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336676\n", "files": ["docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h", "docshell/test/browser/browser.toml", "docshell/test/browser/browser_bfcache_parent_initiated_load.js", "dom/ipc/DOMTypes.ipdlh", "netwerk/ipc/DocumentChannel.cpp", "netwerk/ipc/DocumentChannelParent.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/DocumentLoadListener.h"], "git_node": "061830b84ef183d6637f94900c8e4e5f9a5f451f", "git_parents": ["a5df22d986d4b626f771b4f8885241941601c35c"], "node": "70001ab958512fa2ccaf2570e4eeb9d78d0009b3", "parents": ["3cdac7931bdd10e99ecfdf464c907917855a56b3"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087469 - Package DebugSession.sys.mjs in artifact builds. r=firefox-build-system-reviewers,nalexander\n\nIn bug 2079375 I added DebugSession.sys.mjs to `js/src/debugger/moz.build`, but\nartifact builds don't traverse `js/src` so the module file was missing.\n\nThis patch moves it to `js/moz.build` and traverses that directory in all builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338375\n", "files": ["js/app.mozbuild", "js/moz.build", "js/src/debugger/moz.build", "js/src/make-source-package.py"], "git_node": "c0a8a701a8ec86ea69c8470c05a2009b26019433", "git_parents": ["061830b84ef183d6637f94900c8e4e5f9a5f451f"], "node": "09603439890a21ef79db01f80fed6c07cb165761", "parents": ["70001ab958512fa2ccaf2570e4eeb9d78d0009b3"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2085335 - Store the elements header of a new array as two 64-bit words. r=jandem\n\ncreateArrayWithFixedElements and initGCThing fill the four 32-bit fields of\nthe ObjectElements header with four immediate stores. On arm64 each store\nfirst materializes its immediate, and the capacity and length of an array\nliteral are usually the same value. For [a, b] the header took:\n\n  mov  w16, #1\n  stur w16, [x2, #-16]\n  stur wzr, [x2, #-12]\n  mov  w16, #2\n  stur w16, [x2, #-8]\n  mov  w16, #2\n  stur w16, [x2, #-4]\n\nAdd storeElementsHeader, which packs flags with initializedLength and\ncapacity with length and stores each pair with store64:\n\n  mov  x16, #1\n  stur x16, [x2, #-16]\n  mov  x16, #0x200000002\n  stur x16, [x2, #-8]\n\nWhen capacity and length are equal the packed word is a repeating bit\npattern, which vixl encodes as a single orr immediate. On x86-64 the first\npair fits a sign-extended immediate, so\n\n  movl $1, -0x10(%rdx)\n  movl $0, -0xc(%rdx)\n  movl $2, -0x8(%rdx)\n  movl $2, -0x4(%rdx)\n\nbecomes\n\n  movq    $1, -0x10(%rdx)\n  movabsq $0x200000002, %r11\n  movq    %r11, -0x8(%rdx)\n\nOn a JetStream 3 run on arm64 this removes two or three instructions from\neach of about 4,000 inline array allocations in Ion code.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336934\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/vm/NativeObject.h"], "git_node": "70dab994d88ac2ddccf1782af7b144955ca60b8e", "git_parents": ["c0a8a701a8ec86ea69c8470c05a2009b26019433"], "node": "63c09acb80c5377d74d372a3b93c9f5769512500", "parents": ["09603439890a21ef79db01f80fed6c07cb165761"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2085983 - Remove SharedImmutableStringsCache boxes as soon as their refcount drops to zero. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336967\n", "files": ["js/src/gc/GC.cpp", "js/src/jsapi-tests/testSharedImmutableStringsCache.cpp", "js/src/vm/SharedImmutableStringsCache-inl.h", "js/src/vm/SharedImmutableStringsCache.cpp", "js/src/vm/SharedImmutableStringsCache.h"], "git_node": "64327a8ca1e609d190aa037fe7c640b36cb38272", "git_parents": ["70dab994d88ac2ddccf1782af7b144955ca60b8e"], "node": "550d0d823578b27e5469d1f25cf169c50025f3e2", "parents": ["63c09acb80c5377d74d372a3b93c9f5769512500"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086027 - Carry the Rust autofill store over on Refresh Firefox. r=credential-management-reviewers,theidkamp,niklas,mconley\n\nRefresh Firefox copied autofill-profiles.json but not autofill.db, which\nholds addresses and credit cards once they move to the Rust store. Copy\nautofill.db as well and forward the rust.active prefs so the refreshed\nprofile keeps using it instead of re-migrating the stale JSON over it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337108\n", "files": ["browser/components/migration/FirefoxProfileMigrator.sys.mjs", "browser/components/migration/tests/marionette/test_refresh_firefox.py"], "git_node": "a9e4ee96a895ef4c7c4f711f247d7e0d389aaddc", "git_parents": ["64327a8ca1e609d190aa037fe7c640b36cb38272"], "node": "e852777aa818fbf23bcb10e5e4aa843207857949", "parents": ["550d0d823578b27e5469d1f25cf169c50025f3e2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081540 - Pass key delegate when tracing WeakMap entries r=mccr8,spidermonkey-reviewers,sfink\n\nThe cycle collector needs to know the key delegate for any weak map entries.\nCurrently it works this out itself, but this was not updated when we allowed\nSymbols to have delegates too.\n\nThe patch passes the delegate as well as the key when tracing weak map entries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338340\n", "files": ["js/public/friend/CycleCollector.h", "js/src/gc/WeakMap-inl.h", "js/src/jsapi-tests/testWeakMap.cpp", "js/src/util/DumpFunctions.cpp", "xpcom/base/CycleCollectedJSRuntime.cpp", "xpcom/base/nsCycleCollectionNoteRootCallback.h", "xpcom/base/nsCycleCollector.cpp"], "git_node": "97dfbbf2d40bf758cb0cf9de9dab1de3373613f0", "git_parents": ["a9e4ee96a895ef4c7c4f711f247d7e0d389aaddc"], "node": "19fa7eee868e6b66bb7abcf35a82c2ab967d49a1", "parents": ["e852777aa818fbf23bcb10e5e4aa843207857949"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 14: Fix 214 'misc-unused-parameters' warnings under /image r=gfx-reviewers,tnikkel\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nEverything found by ./mach static-analysis was manually inspected and changed if needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338461\n", "files": ["image/AnimationFrameBuffer.cpp", "image/BlobSurfaceProvider.h", "image/ClippedImage.cpp", "image/DecoderFactory.cpp", "image/DynamicImage.cpp", "image/FetchDecodedImage.cpp", "image/FrozenImage.cpp", "image/Image.cpp", "image/ImageBlocker.cpp", "image/ImageFactory.cpp", "image/ImageMemoryReporter.cpp", "image/ImageUtils.cpp", "image/MultipartImage.cpp", "image/ProgressTracker.cpp", "image/RasterImage.cpp", "image/SVGDocumentWrapper.cpp", "image/SurfaceCache.cpp", "image/VectorImage.cpp", "image/build/nsImageModule.cpp", "image/decoders/icon/nsIconProtocolHandler.cpp", "image/decoders/icon/nsIconURI.cpp", "image/decoders/icon/nsIconURI.h", "image/decoders/nsAVIFDecoder.cpp", "image/decoders/nsGIFDecoder2.cpp", "image/decoders/nsICODecoder.cpp", "image/decoders/nsPNGDecoder.cpp", "image/encoders/bmp/nsBMPEncoder.cpp", "image/encoders/ico/nsICOEncoder.cpp", "image/encoders/jpeg/nsJPEGEncoder.cpp", "image/encoders/webp/nsWebPEncoder.cpp", "image/imgFrame.cpp", "image/imgLoader.cpp", "image/imgRequest.cpp", "image/imgRequestProxy.cpp", "image/imgTools.cpp", "image/remote/RemoteImageProtocolHandler.cpp", "image/test/gtest/TestAnimationFrameBuffer.cpp", "image/test/gtest/TestBlendAnimationFilter.cpp", "image/test/gtest/TestCopyOnWrite.cpp", "image/test/gtest/TestStreamingLexer.cpp"], "git_node": "4818f24724336079c945a6d3bf602bfda2898ae4", "git_parents": ["97dfbbf2d40bf758cb0cf9de9dab1de3373613f0"], "node": "35e6e57d6296f0688c3c748c49115a4cb6adc64c", "parents": ["19fa7eee868e6b66bb7abcf35a82c2ab967d49a1"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080542 - Add Seasonal checkbox to address bar settings - r=adw,fluent-reviewers,settings-reviewers,urlbar-reviewers,Gijs,bolsson\n\nThe checkboxes are shown when browser.urlbar.temporal.featureGate is true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336068\n", "files": ["browser/components/preferences/config/search.mjs", "browser/components/preferences/tests/search/browser_search_firefoxSuggest.js", "browser/components/urlbar/content/enUS-searchFeatures.ftl", "browser/components/urlbar/private/TemporalSuggestions.sys.mjs", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js"], "git_node": "6489e779099e0ef8ff2112e4c5b00464eed3eae5", "git_parents": ["4818f24724336079c945a6d3bf602bfda2898ae4"], "node": "50c548f45afcd5beda003767c388a1e618701a16", "parents": ["35e6e57d6296f0688c3c748c49115a4cb6adc64c"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087745 - Update android nightly application-services version bump to 19bd251287f3b8cf0a5053374dfc0af8b30037aa r=android-build-system-reviewers,release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338506\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "7621fbf0ec34035667f3a071c6b0c07410a30fe3", "git_parents": ["6489e779099e0ef8ff2112e4c5b00464eed3eae5"], "node": "99ba2219953aa3bd6956f9994e5d8fe610e3e241", "parents": ["50c548f45afcd5beda003767c388a1e618701a16"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087354: For :has, try to detect change in the potentially-changed compound. r=firefox-style-system-reviewers,emilio\n\nInitially, this was not implemented because the tradeoff seemed minor/negative\nand we focused on minimizing upwards traversals by marking :has search paths.\nOne way or the other, that doesn't seem enough.\n\n... Only single element property mutations have snapshots, so DOM mutations\nremain unchanged (... It's unlikely that this approach is correct for DOM\nmutations, anyway). That side could use an improvement as well, tracked in\nBug 2086739.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338425\n", "files": ["servo/components/selectors/matching.rs", "servo/components/style/invalidation/element/relative_selector.rs", "servo/ports/geckolib/glue.rs"], "git_node": "841a4a9a9fdcc707e3bd4889918fca7001303875", "git_parents": ["7621fbf0ec34035667f3a071c6b0c07410a30fe3"], "node": "4d756348881d31a90bf6e0ee72f320b12d321d57", "parents": ["99ba2219953aa3bd6956f9994e5d8fe610e3e241"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2074995: Turn off spellchecking for textarea in WPT text-overflow-string-in-textarea-focused.html. r=layout-reviewers,emilio\n\nThis WPT has a textarea that's focused in the testcase vs. not-focused not in\nthe reference case. Before this patch, Firefox often fails the test due to\nshowing a spellcheck underline in the testcase (for its \"aaaaaa...\"\ncontents). This underline is irrelevant to what the test is trying to check. It\nonly happens in the testcase and not the reference case because Firefox only\nperforms a spellcheck after the textfield has been focused.\n\nThis patch avoids this issue by turning off spellcheck on these textareas using\nthe standard HTML `spellcheck=\"false\"` attribute, documented here:\nhttps://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/spellcheck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338389\n", "files": ["testing/web-platform/meta/css/css-overflow/text-overflow-string-in-textarea-focused.html.ini", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-focused-ref.html", "testing/web-platform/tests/css/css-overflow/text-overflow-string-in-textarea-focused.html"], "git_node": "380852cca27334a7459475a63df29133a1432db0", "git_parents": ["841a4a9a9fdcc707e3bd4889918fca7001303875"], "node": "4f45b70f049c7f8a325da0ca76b42b2c31c5c985", "parents": ["4d756348881d31a90bf6e0ee72f320b12d321d57"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2058776 - Return Maybe\u003cSMILMilestone\u003e from GetNextMilestone r=longsonr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338501\n", "files": ["dom/smil/SMILTimedElement.cpp", "dom/smil/SMILTimedElement.h"], "git_node": "faeeaff9760f904ed7bff15e4055c6d12fe85463", "git_parents": ["380852cca27334a7459475a63df29133a1432db0"], "node": "e620190495106b2c7331d216369f565ce78dbfac", "parents": ["4f45b70f049c7f8a325da0ca76b42b2c31c5c985"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2058776 - Skip regular SMIL samples for animation elements that have no target and settled timing r=longsonr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335094\n", "files": ["dom/smil/SMILAnimationController.cpp", "dom/smil/SMILAnimationController.h", "dom/smil/SMILTimedElement.cpp", "dom/smil/SMILTimedElement.h", "dom/smil/test/mochitest.toml", "dom/smil/test/test_smilNoTarget.html"], "git_node": "044f6e92857ec2086b10d0ce9936b6d29abf4172", "git_parents": ["faeeaff9760f904ed7bff15e4055c6d12fe85463"], "node": "8325434c2d08f9963f45f056b1b50ed0d46a39eb", "parents": ["e620190495106b2c7331d216369f565ce78dbfac"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082771 - Drop MOZ_REMOTE_SETTINGS_DISABLED for network-bench h3 tests. r=perftest-reviewers,acreskey,aglavic\n\nBug 2056689 set MOZ_REMOTE_SETTINGS_DISABLED=1 in the browsertime\nenvironment for all raptor tests. With that variable set, the h3\nnetwork-bench variants never load their page from the h3-only server\nand time out.\n\nAdd a modify_env() hook to BasePythonSupport, call it from\nBrowsertime.run_test once the environment is built, and have the\nnetwork-bench support class drop the variable. The other raptor\ntests keep it, and the prefs from bug 2056689 still apply.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338427\n", "files": ["testing/raptor/browsertime/support-scripts/network_bench.py", "testing/raptor/raptor/base_python_support.py", "testing/raptor/raptor/browsertime/base.py"], "git_node": "f513e3b4d900ac4f5a14aae0373a02471d479de4", "git_parents": ["044f6e92857ec2086b10d0ce9936b6d29abf4172"], "node": "08a96e73801d6db5ac212d664ea18792fe07de6a", "parents": ["8325434c2d08f9963f45f056b1b50ed0d46a39eb"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085534 - Remove reentrancy-on-serialize.html.ini as the test now passes. r=valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338224\n", "files": ["testing/web-platform/meta/navigation-api/updateCurrentEntry-method/reentrancy-on-serialize.html.ini"], "git_node": "bc1221a6f3f7468380629ca90b4e40ce045ab8ae", "git_parents": ["f513e3b4d900ac4f5a14aae0373a02471d479de4"], "node": "e8dd14436949f710dd5934ff323f1137d5ff490e", "parents": ["08a96e73801d6db5ac212d664ea18792fe07de6a"], "tags": []}], "date": 1793478558, "git_changesets": ["061830b84ef183d6637f94900c8e4e5f9a5f451f", "c0a8a701a8ec86ea69c8470c05a2009b26019433", "70dab994d88ac2ddccf1782af7b144955ca60b8e", "64327a8ca1e609d190aa037fe7c640b36cb38272", "a9e4ee96a895ef4c7c4f711f247d7e0d389aaddc", "97dfbbf2d40bf758cb0cf9de9dab1de3373613f0", "4818f24724336079c945a6d3bf602bfda2898ae4", "6489e779099e0ef8ff2112e4c5b00464eed3eae5", "7621fbf0ec34035667f3a071c6b0c07410a30fe3", "841a4a9a9fdcc707e3bd4889918fca7001303875", "380852cca27334a7459475a63df29133a1432db0", "faeeaff9760f904ed7bff15e4055c6d12fe85463"