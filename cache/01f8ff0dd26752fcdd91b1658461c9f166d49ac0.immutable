NotificationUtils.cpp", "dom/notification/metrics.yaml", "dom/push/Declarative.cpp", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/notifications/telemetry.sub.https.window.js", "toolkit/components/alerts/nsAlertsService.cpp", "toolkit/components/alerts/nsAlertsUtils.cpp", "toolkit/components/alerts/nsAlertsUtils.h", "toolkit/components/alerts/nsIAlertsService.idl", "toolkit/components/alerts/nsXULAlerts.cpp", "toolkit/system/gnome/nsAlertsIconListener.cpp", "widget/android/AndroidAlerts.cpp", "widget/cocoa/MacOSNotificationCenter.h", "widget/cocoa/MacOSNotificationCenter.mm", "widget/windows/ToastNotificationHandler.cpp", "widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": "d04f14b940758bb7b76ab5981345622dd590ede8", "git_parents": ["ed5266a8c1743d35392ddf323e070c9cc7007263"], "node": "577ef4279c984fbf7ea133e14ca7913bdaafadfe", "parents": ["c78f9240e98b4493b3be3f66a372c0be36e08105"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082836 - Record notification clicks that launch Firefox on Windows. r=saschanaz,firefox-desktop-core-reviewers\n\nClosing the last window quits Firefox on Windows, so a toast click relaunches\nit through the command line and no nsIAlertCallbacks reports the click. Record\nit there, with a new closed application state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335326\n", "files": ["browser/components/BrowserContentHandler.sys.mjs", "browser/components/tests/browser/browser_handle_notification.js", "dom/notification/metrics.yaml"], "git_node": "db611cf2e3d96c4c90c1e2dbdb7f15173057a2b9", "git_parents": ["d04f14b940758bb7b76ab5981345622dd590ede8"], "node": "88f9782e4f7c9647a630912f01b90fa980f2aaaa", "parents": ["577ef4279c984fbf7ea133e14ca7913bdaafadfe"], "tags": []}, {"author": "Tin La \u003ctin.la@utexas.edu\u003e", "branch": "default", "desc": "Bug 2071322 - dedupe amend_taskgraph in morph.py between gecko_taskgraph and taskgraph r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335764\n", "files": ["taskcluster/gecko_taskgraph/morph.py"], "git_node": "1d5b47e5bdf4faee6358b977b6d6841466030d0d", "git_parents": ["db611cf2e3d96c4c90c1e2dbdb7f15173057a2b9"], "node": "5dcb59c8af31faff8628854e7f566f5101467d61", "parents": ["88f9782e4f7c9647a630912f01b90fa980f2aaaa"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084661 - Upgrade taskgraph to 24.5.0. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335998\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt"], "git_node": "84a27739e4c513882855d8dc516342a4cdfeeebf", "git_parents": ["1d5b47e5bdf4faee6358b977b6d6841466030d0d"], "node": "8ff617e99520d5333affffccda9513d2c80c07e3", "parents": ["5dcb59c8af31faff8628854e7f566f5101467d61"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070790 - [bidi] Avoid duplicate contextCreated event when subscribing right after browsingContext.create r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335179\n", "files": ["remote/webdriver-bidi/modules/root/browsingContext.sys.mjs"], "git_node": "7621e29d78a97f36159888ede76e3e5afc88b5d4", "git_parents": ["84a27739e4c513882855d8dc516342a4cdfeeebf"], "node": "bba67d1cade72135d4ec1374f72cb430b31198af", "parents": ["8ff617e99520d5333affffccda9513d2c80c07e3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080161 - Start the newtab bundles without waiting on a separate stamp r=firefox-build-system-reviewers,ahochheiden,mconley\n\nThe bundles depended on newtab-sources.stamp. Make only comes back to a\ntarget whose prerequisite was still running after it has gone through the\nrest of the tree, so webpack started about 2.4s into pre-export, after\nthe stamp was long done. On clean builds the stamp hash also changed once\nwebpack-deps.txt had been written, so the bundles were built a second time\nin misc.\n\nForce the bundle targets instead, and have each one compare its own source\nhash with the one stored from its last run, which includes the inputs\nwebpack reported.\n\nOn linux64 artifact builds, misc goes from 4.3s to 0.9s. Webpack now\nstarts right away, but competes with the devtools babel jobs for CPU and\ntakes 6.3s instead of 4.5s, so pre-export only gets slightly shorter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332392\n", "files": ["browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/moz.build"], "git_node": "52a0baa0fdb1294216d542e7e64671140fcd1ef7", "git_parents": ["7621e29d78a97f36159888ede76e3e5afc88b5d4"], "node": "148c97a54fbefd87cda3b115c3e4463debaff143", "parents": ["bba67d1cade72135d4ec1374f72cb430b31198af"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083318 - Address some review comments I overlooked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336114\n", "files": ["layout/painting/nsDisplayList.h"], "git_node": "0a68b4639d8a2f65a892641696311231c1094610", "git_parents": ["52a0baa0fdb1294216d542e7e64671140fcd1ef7"], "node": "88104429dcafdce4c86525efba70a539a40c3bfd", "parents": ["148c97a54fbefd87cda3b115c3e4463debaff143"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080163 - Download large artifacts over several connections r=firefox-build-system-reviewers,ahochheiden\n\nA single connection to the artifact storage gets between 65 and 270MB/s\non CI, and the crashreporter symbols download (557MB) took 7.3s on\nlinux64 artifact builds, holding up the artifact tier.\n\nRequest the first 64MB of each artifact, which is all of most of them,\nand when there is more, fetch the rest in parallel ranges. Fall back to\ndlmanager when the server doesn't serve ranges of the artifact as is,\nor a range fails.\n\nThe symbols download now takes 2.2s, and the artifact tier goes from\n10.3s to 8.3s, without the occasional much slower runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332394\n", "files": ["python/mozbuild/mozbuild/artifact_cache.py", "python/mozbuild/mozbuild/test/test_artifact_cache.py"], "git_node": "60206ac64399121e35b9fda758f47bae9b14fe21", "git_parents": ["0a68b4639d8a2f65a892641696311231c1094610"], "node": "e49b8226b408cf06f86c7730bd23ac60727d9d2d", "parents": ["88104429dcafdce4c86525efba70a539a40c3bfd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083301 - Make frame and display list arenas process-global. r=tnikkel,layout-reviewers,firefox-style-system-reviewers,mccr8,dshin\n\nMove the allocation tracking in PresShell to nsPresArena, and remove the\nabstract frame ids while at it.\n\nAs a follow-up, frame construction functions should probably just take a\npres context directly. There are some other clean-ups.\n\nI had to remove MOZ_STACK_CLASS from gfxSkipCharsIterator and\nTextAutospace because the static analysis now detects it:\n\n  layout/svg/SVGTextFrame.cpp:2834:10: error: variable of type 'mozilla::SVGTextFrame' only valid on the stack\n  2834 |   return new mozilla::SVGTextFrame(aStyle, aPresShell-\u003eGetPresContext());\n       |          ^\n  layout/svg/SVGTextFrame.cpp:2834:10: note: value incorrectly allocated on the heap\n  layout/svg/SVGTextFrame.h:646:40: note: 'mozilla::SVGTextFrame' is a stack type because member 'mCachedProvider' is a stack type 'Maybe\u003cnsTextFrame::PropertyProvider\u003e' (aka 'mozilla::Maybe\u003cnsTextFrame::PropertyProvider\u003e')\n   646 |   Maybe\u003cnsTextFrame::PropertyProvider\u003e mCachedProvider;\n       |                                        ^\n  mfbt/Maybe.h:367:31: note: 'Maybe\u003cnsTextFrame::PropertyProvider\u003e' (aka 'mozilla::Maybe\u003cnsTextFrame::PropertyProvider\u003e') is a stack type because it inherits from a stack type 'detail::MaybeStorage\u003cnsTextFrame::PropertyProvider\u003e'\n   367 | MOZ_GSL_OWNER MOZ_EMPTY_BASES Maybe : private detail::MaybeStorage\u003cT\u003e,\n       |                               ^\n  mfbt/Maybe.h:243:8: note: 'detail::MaybeStorage\u003cnsTextFrame::PropertyProvider\u003e' is a stack type because it inherits from a stack type 'MaybeStorageBase\u003cnsTextFrame::PropertyProvider\u003e'\n   243 | struct MaybeStorage\u003cT, false\u003e : MaybeStorageBase\u003cT\u003e {\n       |        ^\n  mfbt/MaybeStorageBase.h:45:5: note: 'MaybeStorageBase\u003cnsTextFrame::PropertyProvider\u003e' is a stack type because member 'mStorage' is a stack type 'union Union'\n    45 |   } mStorage;\n       |     ^\n  mfbt/MaybeStorageBase.h:43:15: note: 'union Union' is a stack type because member 'val' is a stack type 'NonConstT' (aka 'nsTextFrame::PropertyProvider')\n    43 |     NonConstT val;\n       |               ^\n  layout/generic/nsTextFrame.h:254:26: note: 'NonConstT' (aka 'nsTextFrame::PropertyProvider') is a stack type because member 'mStart' is a stack type 'gfxSkipCharsIterator'\n   254 |     gfxSkipCharsIterator mStart;\n       |                          ^\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334824\n", "files": ["dom/base/nsWindowMemoryReporter.cpp", "dom/base/nsWindowSizes.h", "gfx/thebes/gfxSkipChars.h", "layout/base/ArenaObjectID.h", "layout/base/PresShell.cpp", "layout/base/PresShell.h", "layout/base/nsLayoutUtils.cpp", "layout/base/nsPresArena.cpp", "layout/base/nsPresArena.h", "layout/base/nsPresArenaObjectList.inc", "layout/build/nsLayoutStatics.cpp", "layout/forms/InputButtonControlFrame.cpp", "layout/forms/nsCheckboxRadioFrame.cpp", "layout/forms/nsColorControlFrame.cpp", "layout/forms/nsComboboxControlFrame.cpp", "layout/forms/nsDateTimeControlFrame.cpp", "layout/forms/nsFieldSetFrame.cpp", "layout/forms/nsFileControlFrame.cpp", "layout/forms/nsImageControlFrame.cpp", "layout/forms/nsListControlFrame.cpp", "layout/forms/nsProgressFrame.cpp", "layout/forms/nsRangeFrame.cpp", "layout/forms/nsTextControlFrame.cpp", "layout/generic/BRFrame.cpp", "layout/generic/ColumnSetWrapperFrame.cpp", "layout/generic/PrintedSheetFrame.cpp", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/ViewportFrame.cpp", "layout/generic/WBRFrame.cpp", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "layout/generic/nsCanvasFrame.cpp", "layout/generic/nsColumnSetFrame.cpp", "layout/generic/nsContainerFrame.cpp", "layout/generic/nsContainerFrame.h", "layout/generic/nsFirstLetterFrame.cpp", "layout/generic/nsFlexContainerFrame.cpp", "layout/generic/nsFloatManager.cpp", "layout/generic/nsFloatManager.h", "layout/generic/nsFrameList.cpp", "layout/generic/nsFrameList.h", "layout/generic/nsFrameSetFrame.cpp", "layout/generic/nsGridContainerFrame.cpp", "layout/generic/nsHTMLCanvasFrame.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/generic/nsImageFrame.cpp", "layout/generic/nsInlineFrame.cpp", "layout/generic/nsIntervalSet.cpp", "layout/generic/nsIntervalSet.h", "layout/generic/nsLineBox.cpp", "layout/generic/nsLineBox.h", "layout/generic/nsPageContentFrame.cpp", "layout/generic/nsPageFrame.cpp", "layout/generic/nsPageSequenceFrame.cpp", "layout/generic/nsPlaceholderFrame.cpp", "layout/generic/nsRubyBaseContainerFrame.cpp", "layout/generic/nsRubyBaseFrame.cpp", "layout/generic/nsRubyFrame.cpp", "layout/generic/nsRubyTextContainerFrame.cpp", "layout/generic/nsRubyTextFrame.cpp", "layout/generic/nsSubDocumentFrame.cpp", "layout/generic/nsTextFrame.cpp", "layout/generic/nsTextFrame.h", "layout/generic/nsVideoFrame.cpp", "layout/mathml/nsMathMLContainerFrame.cpp", "layout/mathml/nsMathMLTokenFrame.cpp", "layout/mathml/nsMathMLmencloseFrame.cpp", "layout/mathml/nsMathMLmfracFrame.cpp", "layout/mathml/nsMathMLmmultiscriptsFrame.cpp", "layout/mathml/nsMathMLmoFrame.cpp", "layout/mathml/nsMathMLmpaddedFrame.cpp", "layout/mathml/nsMathMLmrootFrame.cpp", "layout/mathml/nsMathMLmrowFrame.cpp", "layout/mathml/nsMathMLmspaceFrame.cpp", "layout/mathml/nsMathMLmtableFrame.cpp", "layout/mathml/nsMathMLmunderoverFrame.cpp", "layout/painting/DisplayListArenaObjectId.h", "layout/painting/RetainedDisplayListBuilder.h", "layout/painting/moz.build", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/style/CounterStyleManager.cpp", "layout/svg/SVGAFrame.cpp", "layout/svg/SVGClipPathFrame.cpp", "layout/svg/SVGContainerFrame.cpp", "layout/svg/SVGFEContainerFrame.cpp", "layout/svg/SVGFEImageFrame.cpp", "layout/svg/SVGFELeafFrame.cpp", "layout/svg/SVGFEUnstyledLeafFrame.cpp", "layout/svg/SVGFilterFrame.cpp", "layout/svg/SVGForeignObjectFrame.cpp", "layout/svg/SVGGFrame.cpp", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGradientFrame.cpp", "layout/svg/SVGImageFrame.cpp", "layout/svg/SVGInnerSVGFrame.cpp", "layout/svg/SVGMarkerFrame.cpp", "layout/svg/SVGMaskFrame.cpp", "layout/svg/SVGOuterSVGFrame.cpp", "layout/svg/SVGPatternFrame.cpp", "layout/svg/SVGStopFrame.cpp", "layout/svg/SVGSwitchFrame.cpp", "layout/svg/SVGSymbolFrame.cpp", "layout/svg/SVGTextFrame.cpp", "layout/svg/SVGUseFrame.cpp", "layout/svg/SVGViewFrame.cpp", "layout/tables/nsCellMap.cpp", "layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableColFrame.cpp", "layout/tables/nsTableColGroupFrame.cpp", "layout/tables/nsTableFrame.cpp", "layout/tables/nsTableRowFrame.cpp", "layout/tables/nsTableRowGroupFrame.cpp", "layout/tables/nsTableWrapperFrame.cpp", "layout/xul/MiddleCroppingLabelFrame.cpp", "layout/xul/SimpleXULLeafFrame.cpp", "layout/xul/nsMenuPopupFrame.cpp", "layout/xul/nsScrollbarButtonFrame.cpp", "layout/xul/nsScrollbarFrame.cpp", "layout/xul/nsSliderFrame.cpp", "layout/xul/nsSplitterFrame.cpp", "layout/xul/tree/nsTreeBodyFrame.cpp"], "git_node": "51dd939fdbfdee72868c957f66018b16b0a04486", "git_parents": ["60206ac64399121e35b9fda758f47bae9b14fe21"], "node": "9e83e54ed1b7683405be8c20b56ec9e3ab2affb9", "parents": ["e49b8226b408cf06f86c7730bd23ac60727d9d2d"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084661 - Upgrade taskgraph to 24.5.0. r=taskgraph-reviewers,bhearsum\" for causing python-firefox-ci failures\n\nThis reverts commit 84a27739e4c513882855d8dc516342a4cdfeeebf.\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt"], "git_node": "5b73a66098419e9a91135abc33a3450aff1ff000", "git_parents": ["51dd939fdbfdee72868c957f66018b16b0a04486"], "node": "56366b3a3d4230bf4c971298074285ee9d0a9cdb", "parents": ["9e83e54ed1b7683405be8c20b56ec9e3ab2affb9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083301 - Remove unneeded include.\n", "files": ["gfx/thebes/gfxSkipChars.h"], "git_node": "3c7e5d4fccf4664568bb7535603b578fdc427fc7", "git_parents": ["5b73a66098419e9a91135abc33a3450aff1ff000"], "node": "d4f97a9451c43599a4709e84f52671aacbd6f0df", "parents": ["56366b3a3d4230bf4c971298074285ee9d0a9cdb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066284 - Take the skeleton UI's urlbar span from the urlbar's container. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321114\n", "files": ["xpfe/appshell/AppWindow.cpp"], "git_node": "d92eff55445f42462698b8dff307209d5afba9a6", "git_parents": ["3c7e5d4fccf4664568bb7535603b578fdc427fc7"], "node": "aaca5665bb87e2668de72cf82bf697d66a266a4f", "parents": ["d4f97a9451c43599a4709e84f52671aacbd6f0df"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066296 - Take the skeleton UI's search bar span from the search bar's container. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321115\n", "files": ["xpfe/appshell/AppWindow.cpp"], "git_node": "bf52b637f12c4609795c0c9ef1fe2e4c55b40dd0", "git_parents": ["d92eff55445f42462698b8dff307209d5afba9a6"], "node": "59567d368a4708bb3d697ba05b85d656cdd8cbdc", "parents": ["aaca5665bb87e2668de72cf82bf697d66a266a4f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067038 - Blend the skeleton UI's rounded corners with what is painted below them. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336065\n", "files": ["mozglue/misc/PreXULSkeletonUI.cpp"], "git_node": "6f6a4e6b6293e7dcd2433daf2df3a54c56b3f378", "git_parents": ["bf52b637f12c4609795c0c9ef1fe2e4c55b40dd0"], "node": "95ee096f4a03fd923eeed756e6ab260a4d7591a7", "parents": ["59567d368a4708bb3d697ba05b85d656cdd8cbdc"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067038 - Draw the skeleton UI with Nova's shapes. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336066\n", "files": ["mozglue/misc/PreXULSkeletonUI.cpp"], "git_node": "94c63e169839f270cccfd3b7b372410290058623", "git_parents": ["6f6a4e6b6293e7dcd2433daf2df3a54c56b3f378"], "node": "99618825e6f0a7f21d981641bf03e8a7e5d2dbc8", "parents": ["95ee096f4a03fd923eeed756e6ab260a4d7591a7"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069179 - Avoid a rapid fire opening and closing the menu from attached keyboards r=android-reviewers,jdelorenzo\n\nTo prevent this crashing the application.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325902\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/HomeActivityTest.kt"], "git_node": "cd3ba2289a2617ca3e27616b205d1b53dd06aa15", "git_parents": ["94c63e169839f270cccfd3b7b372410290058623"], "node": "a54b21a03bbbd9a7a69917ff0a015e033749c9f4", "parents": ["99618825e6f0a7f21d981641bf03e8a7e5d2dbc8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083386 - Add a pref to stream directly to the print output destination. r=mac-reviewers,spohl\n\nPref off defaults to the current behavior, but I think this should\ngenerally be better behavior. I guess main issue is what happens if\nwe crash mid-print or so?\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335803\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "gfx/thebes/PrintTargetSkPDF.h", "modules/libpref/init/StaticPrefList.yaml", "widget/cocoa/nsDeviceContextSpecX.h", "widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "75fd4ada682e821f6594e75aef10b44af9657108", "git_parents": ["cd3ba2289a2617ca3e27616b205d1b53dd06aa15"], "node": "50c134fb57389e296649b68b288ecafff419affa", "parents": ["a54b21a03bbbd9a7a69917ff0a015e033749c9f4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083386 - Add a debug setting to always print via the print session. r=mac-reviewers,spohl\n\nThis is useful to debug this and other driver issues.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335804\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "2e6bec5c2a26d4ba4c0f94f916f50585cc29ed1f", "git_parents": ["75fd4ada682e821f6594e75aef10b44af9657108"], "node": "3d16a99e05d6a3af35def828e4141e88ef8e4c60", "parents": ["50c134fb57389e296649b68b288ecafff419affa"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084053 - Send explicit page count down to the driver. r=spohl,mac-reviewers\n\nSee diagnostics on the bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336003\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "widget/cocoa/nsDeviceContextSpecX.h", "widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "339b0369abccff9e106296f1b42e13d4a914ea81", "git_parents": ["2e6bec5c2a26d4ba4c0f94f916f50585cc29ed1f"], "node": "8177d3d362670869415cb46d137c6f7df1eaa9db", "parents": ["3d16a99e05d6a3af35def828e4141e88ef8e4c60"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083386 - Test the atomic file stream codepath. r=spohl,mac-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336028\n", "files": ["toolkit/components/printing/tests/browser_print_stream.js"], "git_node": "f9a139100ed55ccc5012641c19c939779bf678a0", "git_parents": ["339b0369abccff9e106296f1b42e13d4a914ea81"], "node": "a923f8fb714adfb1491de8796820a61a7f3703a8", "parents": ["8177d3d362670869415cb46d137c6f7df1eaa9db"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071822 - turn on minification in nightly ui tests, but not resource shrinking r=titouan\n\nVerify that minification doesn't break anything by running the ui tests against a minified nightly build.\n\nReasoning for doing this is:\na) our release builds are currently minified, but our ui test builds are not. So nothing currently tests minification doesn't break anything in release.\nYou would really hope r8 minification wouldn't break and trust it to do its thing, as it's very widely used!\nBut this is another step bringing what we ship closer to what we test.\nb) it's also a step towards turning on obfuscation - we need to have the broader `disable-optimisation` flag switched off to be able to enable the obfuscation part.\n\nResource shrinking breaks everywhere the tests need to look up a string resource that the app doesn't use, because r8 has optimised it away. Similar to the issue with classes and methods; this could be a future extension for the gradle plugin to generate keep rules for, but for now we can get the minified tests running by leaving the resource shrinking part switched off.\n\nNB this requires the gradle plugin added in https://github.com/mozilla-firefox/firefox/pull/395\n\n[green try here](https://treeherder.mozilla.org/jobs?repo=try&revision=8d4819ebaa182a829fe1b920ab8eb150172b7210)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/398\n", "files": ["mobile/android/fenix/app/build.gradle", "taskcluster/kinds/build-apk/kind.yml"], "git_node": "980f559246ebe82fc9bd32e7604594948dc05c31", "git_parents": ["f9a139100ed55ccc5012641c19c939779bf678a0"], "node": "c00b4867c61d13210b281b620b0a5c9ab4563133", "parents": ["a923f8fb714adfb1491de8796820a61a7f3703a8"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084286 - Follow-up: Expect PASS instead of OK for chrome-bug-565742178.html crashtest. r=emilio\n", "files": ["testing/web-platform/meta/css/selectors/crashtests/chrome-bug-565742178.html.ini"], "git_node": "8b977eb302353439679aa29804f8e22f9e8434a1", "git_parents": ["980f559246ebe82fc9bd32e7604594948dc05c31"], "node": "15a49c5d25c215962fdca7a552da101e0627a693", "parents": ["c00b4867c61d13210b281b620b0a5c9ab4563133"], "tags": []}, {"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084872 - Update android nightly application-services version bump to eba864f98b7ce6823e41c21c15adca7d6a778ea0 r=release-managers,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336139\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "bd2fcf9767f8234914792748051d2b929a09a769", "git_parents": ["8b977eb302353439679aa29804f8e22f9e8434a1"], "node": "96ce2b76431534710c54a48459435aa981bc77ac", "parents": ["15a49c5d25c215962fdca7a552da101e0627a693"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046558 - Rework active session history entry updates from content. r=smaug,emz,ckerschb\n\nSet/ReplaceActiveSessionHistoryEntry now require the sender's WindowContext\nas an argument and the parent creates shared state using the\nWindowGlobalParent instead of the content's copy.\n\nEach WindowGlobalParent now records the session history load that produced it,\nif any.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306114\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/shistory/nsSHEntryShared.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/ipc/ParentProcessChannelHandle.cpp", "dom/ipc/ParentProcessChannelHandle.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "584721263603f0d2a154370df8f5f00496c9777d", "git_parents": ["bd2fcf9767f8234914792748051d2b929a09a769"], "node": "c3a3b783ec9faa602c9f7dcda2bc1cb9c6038c5d", "parents": ["96ce2b76431534710c54a48459435aa981bc77ac"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["toolkit/locales/en-US/chrome/global/narrate.properties"], "git_node": "e33ac8a9b64e3946a203af8df5b2aa1bb4711d5c", "git_parents": ["2d5c2a4eb5d99a92249ec13370b1de9c1a77c0f8", "584721263603f0d2a154370df8f5f00496c9777d"], "node": "da9645630220310b11df117bd930777f6aebf5bd", "parents": ["b16fcfc374e3e99f00a0c18c7fe8b31fd03df868", "c3a3b783ec9faa602c9f7dcda2bc1cb9c6038c5d"], "tags": []}], "date": 1792686017, "git_changesets": ["08eec03e2ef2022d4662e3ad56394ae239b31d58", "bba7fe5862273028747586b6acaf021fc776a47c", "53a591d00dcb746f67747675db963871f4991660", "db7f97553ad6d8a4b6e95db58d0878d9a7be14d7", "0caa80137a509128dad3d4f1a03dc3961b9d1af0", "ed5266a8c1743d35392ddf323e070c9cc7007263", "d04f14b940758bb7b76ab5981345622dd590ede8", "db611cf2e3d96c4c90c1e2dbdb7f15173057a2b9", "1d5b47e5bdf4faee6358b977b6d6841466030d0d", "84a27739e4c513882855d8dc516342a4cdfeeebf", "7621e29d78a97f36159888ede76e3e5afc88b5d4", "52a0baa0fdb1294216d542e7e64671140fcd1ef7", "0a68b4639d8a2f65a892641696311231c1094610", "60206ac64399121e35b9fda758f47bae9b14fe21", "51dd939fdbfdee72868c957f66018b16b0a04486", "5b73a66098419e9a91135abc33a3450aff1ff000", "3c7e5d4fccf4664568bb7535603b578fdc427fc7", "d92eff55445f42462698b8dff307209d5afba9a6", "bf52b637f12c4609795c0c9ef1fe2e4c55b40dd0", "6f6a4e6b6293e7dcd2433daf2df3a54c56b3f378", "94c63e169839f270cccfd3b7b372410290058623", "cd3ba2289a2617ca3e27616b205d1b53dd06aa15", "75fd4ada682e821f6594e75aef10b44af9657108", "2e6bec5c2a26d4ba4c0f94f916f50585cc29ed1f", "339b0369abccff9e106296f1b42e13d4a914ea81", "f9a139100ed55ccc5012641c19c939779bf678a0", "980f559246ebe82fc9bd32e7604594948dc05c31", "8b977eb302353439679aa29804f8e22f9e8434a1", "bd2fcf9767f8234914792748051d2b929a09a769", "584721263603f0d2a154370df8f5f00496c9777d", "e33ac8a9b64e3946a203af8df5b2aa1bb4711d5c"], "user": "ctuns@mozilla.com"}, "45629": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5add844c26613d7e4d84c799d6e23cf987b1240d with FIREFOX_159_0_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7ea929aac67c88ec5b84d7147ecdd1a105520309", "git_parents": ["996da5728dae25cc909d308a2d15ef69f034cc2f"], "node": "44e91eb50c0b4d96ad21323c3b116bea860a3101", "parents": ["07a17c1afab53ed5cb9d8e6f316b9d69363b8e64"], "tags": []}], "date": 1792691323, "git_changesets": ["7ea929aac67c88ec5b84d7147ecdd1a105520309"], "user": "ffxbld@lando.moz.tools"}, "45630": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5add844c26613d7e4d84c799d6e23cf987b1240d with FIREFOX-ANDROID_159_0_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c2c9469315c7e5f1c08bc579fd15c0827c137b03", "git_parents": ["7ea929aac67c88ec5b84d7147ecdd1a105520309"], "node": "a678352438f8bad87374672dfaa51342bf7d2875", "parents": ["44e91eb50c0b4d96ad21323c3b116bea860a3101"], "tags": []}], "date": 1792691387, "git_changesets": ["c2c9469315c7e5f1c08bc579fd15c0827c137b03"], "user": "ffxbld@lando.moz.tools"}, "45631": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9994f9e54bec5c43f06bc9423494cba508ed7806 with FIREFOX_160_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "368ea549edb39ea2ab5c1129102dfa0829d483f9", "git_parents": ["c2c9469315c7e5f1c08bc579fd15c0827c137b03"], "node": "8b8dfa7a7e68fb61f35af3037b4d9957cc74a61b", "parents": ["a678352438f8bad87374672dfaa51342bf7d2875"], "tags": []}], "date": 1792694192, "git_changesets": ["368ea549edb39ea2ab5c1129102dfa0829d483f9"], "user": "ffxbld@lando.moz.tools"}, "45632": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9994f9e54bec5c43f06bc9423494cba508ed7806 with DEVEDITION_160_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "22e4260e74d9f628e316a486b87e70d51b2b0da2", "git_parents": ["368ea549edb39ea2ab5c1129102dfa0829d483f9"], "node": "808907722e4f0df928136907720873ed2a95afa1", "parents": ["8b8dfa7a7e68fb61f35af3037b4d9957cc74a61b"], "tags": []}], "date": 1792694409, "git_changesets": ["22e4260e74d9f628e316a486b87e70d51b2b0da2"], "user": "ffxbld@lando.moz.tools"}, "45633": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9994f9e54bec5c43f06bc9423494cba508ed7806 with FIREFOX-ANDROID_160_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ebb463af248edb95a8b4ecd172aa147f8501764f", "git_parents": ["22e4260e74d9f628e316a486b87e70d51b2b0da2"], "node": "cb081270d62a01482c28774461ef315f7b116428", "parents": ["808907722e4f0df928136907720873ed2a95afa1"], "tags": []}], "date": 1792694560, "git_changesets": ["ebb463af248edb95a8b4ecd172aa147f8501764f"], "user": "ffxbld@lando.moz.tools"}, "45634": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833752 - Introduce BrowserStorePlayer bridging BrowserStore to Media3. r=Roger,android-reviewers\n\nWires media3-common into the android-components feature/media module and introduces a SimpleBasePlayer\nsubclass that mirrors the active media tab's playback state and metadata (title, artist) onto Media3 while\nrouting play/pause commands back to the tab's MediaSession.Controller. It reacts only to changes of the active\ntab's media session state, not to every store action.\n\nThe player is not yet wired into the service delegate. Artwork, skip commands and the timeline follow in\nseparate commits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327936\n", "files": ["mobile/android/android-components/components/feature/media/build.gradle", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/player/BrowserStorePlayer.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/player/BrowserStorePlayerTest.kt"], "git_node": "2ecccc335f1d49c029c6a17e2989c7ec4b3ecde7", "git_parents": ["584721263603f0d2a154370df8f5f00496c9777d"], "node": "fbaf6bfe6a0535bebb6817ff45155ba67ca877cf", "parents": ["c3a3b783ec9faa602c9f7dcda2bc1cb9c6038c5d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833752 - Expose the active media tab's artwork through BrowserStorePlayer. r=Roger,android-reviewers\n\nFetches the tab's MediaSession artwork (never for private tabs) whenever the active tab or its metadata\nchanges, encodes it to PNG off the main thread and attaches it to the Media3 MediaMetadata as artwork data.\nThe cached bytes are keyed by tab id so a tab switch never shows the previous tab's cover while the new fetch\nis in flight, and a fetch whose tab is no longer the active media tab is dropped. A fetch or encode that\nthrows leaves the item without artwork instead of crashing the process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327937\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/player/BrowserStorePlayer.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/player/BrowserStorePlayerTest.kt"], "git_node": "8838263044043f939c952d2a725ba28a7862029d", "git_parents": ["2ecccc335f1d49c029c6a17e2989c7ec4b3ecde7"], "node": "ef0f968fdf21496feb96ec7ff92bd4cfb6a75fa6", "parents": ["fbaf6bfe6a0535bebb6817ff45155ba67ca877cf"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833752 - Advertise skip and seek commands and report the timeline from BrowserStorePlayer. r=Roger,android-reviewers\n\nSkip commands (COMMAND_SEEK_TO_NEXT/COMMAND_SEEK_TO_PREVIOUS) are advertised per-tab, only when web content\ndeclares the matching MediaSession.Feature, and handleSeek routes them to the active tab's controller. Media3\ndispatches these on the advertised availableCommands rather than on the timeline having adjacent items, so the\nsingle-item playlist this player exposes is sufficient.\n\nPosition, duration and playback rate from the tab's positionState are reported through the Media3 state so the\nsystem draws a timeline, and COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM is advertised when a duration is known or the\npage declares MediaSession.Feature.SEEK_TO, with handleSeek routing to controller.seekTo(). Within a tab, a\ntitle change with an unchanged positionState reports position 0 until the page pushes a fresh one, since pages\nkeep reporting the outgoing track's position briefly after a track change; switching to another media tab\nreports that tab's position immediately. A seek carrying C.TIME_UNSET is ignored rather than forwarded to the\npage. A non-finite position, duration or playback rate from the page is treated as unknown; Gecko rejects only\na negative duration, a position outside 0..duration and a zero rate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327938\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/player/BrowserStorePlayer.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/player/BrowserStorePlayerTest.kt"], "git_node": "9937df3ee0c017b05218c6709a81df517ecb5410", "git_parents": ["8838263044043f939c952d2a725ba28a7862029d"], "node": "882d169568a3c96ac46060a9993177447350199d", "parents": ["ef0f968fdf21496feb96ec7ff92bd4cfb6a75fa6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833752 - Migrate feature/media off legacy androidx.media to Media3. r=Roger,android-reviewers\n\nReplaces MediaSessionCompat and androidx.media.app.NotificationCompat.MediaStyle with\nandroidx.media3.session.MediaSession and MediaStyleNotificationHelper (adding the media3-session dependency),\nwith BrowserStorePlayer as the session's Player. Playback state, metadata, artwork and the timeline that\nupdateMediaSession() pushed onto MediaSessionCompat now come from the player's store observer, so\nupdateMediaSession() is removed and the session gets no Callback: Media3 routes framework play/pause/skip/seek\nevents (lockscreen, Bluetooth, Android Auto) through the Player, which forwards them to the active tab's\nMediaSession.Controller. A play command first goes through the delegate's audio focus check, passed to the\nplayer as onPlay, and the tab is told to play only if it allows it.\n\nThe notification's play/pause and previous/next actions go through the player as well instead of a controller\ncached at the last playing-state transition, so a notification button press acts on the tab that is the active\nmedia tab at press time. The becoming-noisy receiver pauses through the player too, instead of the controller\nof the tab that was playing when it was registered. The previous/next buttons stay gated on the tab's\nMediaSession.Feature flags and keep the Bug 2047284 telemetry.\n\nshutdown() cancels in-flight updateNotification/startForeground coroutines and no longer releases the session;\nonDestroy() releases the session and player. MediaSessionFeature can keep the service bound past stopSelf(),\nfor example when the task is removed while a custom tab keeps playing, and a later playing state must still\npost the notification, start the foreground service and request audio focus. The notification scope is a child\nSupervisorJob of the injected mainScope, so a failed coroutine does not cancel it, and onDestroy() cancels\nonly it while cancelling mainScope still cancels it.\n\nAbstractMediaSessionService keeps extending plain Service rather than Media3's MediaSessionService:\nMediaSessionFeature binds it directly with BIND_AUTO_CREATE and Fenix, Focus and sample-browser register it\nwithout a MediaSessionService intent-filter. Letting Media3 own the foreground lifecycle, notification and\nMediaBrowser discovery is a separate change.\n\nThe now-unused MediaSessionCallback and ext.toPlaybackState() are deleted in the next commit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327939\n", "files": ["mobile/android/android-components/components/feature/media/build.gradle", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/notification/MediaNotification.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/player/BrowserStorePlayer.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/notification/MediaNotificationTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt"], "git_node": "5f7eaa56a0efdce0ba1e208dec1c1fbe8b5d79cb", "git_parents": ["9937df3ee0c017b05218c6709a81df517ecb5410"], "node": "fbff1dbda4851a83b8be87db667ee5230b43ca40", "parents": ["882d169568a3c96ac46060a9993177447350199d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833752 - Remove the legacy MediaSessionCompat helpers left unused by the Media3 migration. r=Roger,android-reviewers\n\nMediaSessionCallback and ext.toPlaybackState() with its helpers only served the MediaSessionCompat session\nthat MediaSessionServiceDelegate no longer creates. playing() stays; the automotive CarUxRestrictionsFeature\nstill uses it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327940\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/ext/MediaSessionState.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/session/MediaSessionCallback.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/ext/MediaSessionStateKtTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/session/MediaSessionCallbackTest.kt"], "git_node": "b704ff492e0aa99d25d7ae27c20ec3aa8ce9424c", "git_parents": ["5f7eaa56a0efdce0ba1e208dec1c1fbe8b5d79cb"], "node": "53c0f04161b0d9ce02f3e3c178b44f761bb5d891", "parents": ["fbff1dbda4851a83b8be87db667ee5230b43ca40"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833752 - Remove legacy androidx.media dependency from feature/media. r=Roger,android-reviewers\n\nfeature/media no longer references androidx.media, and no other module consumes the catalog alias.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327941\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/components/feature/media/build.gradle"], "git_node": "e05064e15bbd8751d4c2728927c7a0568c5fadea", "git_parents": ["b704ff492e0aa99d25d7ae27c20ec3aa8ce9424c"], "node": "4b1efd560f15e2466c4a9dac8143ea91c07a00ef", "parents": ["53c0f04161b0d9ce02f3e3c178b44f761bb5d891"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2084197 - Dispatch ProfilerChild::ProcessPendingUpdate fallibly to avoid leaking it during shutdown r=profiler-reviewers,mstange\n\nSince bug 2043548, the sampler thread dispatches the update runnable\nafter releasing sPendingChunkManagerUpdate, so the ProfilerChild thread\ncan shut down in between. An infallible dispatch to a shut down thread\nleaks the runnable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335924\n", "files": ["tools/profiler/gecko/ProfilerChild.cpp"], "git_node": "f50268a720823cee7a8d63eb34ab3213fd7c1b89", "git_parents": ["e05064e15bbd8751d4c2728927c7a0568c5fadea"], "node": "4b2a261a0f44392aef308ea8e2b868795698f1c6", "parents": ["4b1efd560f15e2466c4a9dac8143ea91c07a00ef"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084960 - Fix green video. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336148\n", "files": ["gfx/webrender_bindings/RenderD3D11TextureHost.cpp"], "git_node": "d2412cf892849257bec34cc77e6161e0e9ff798b", "git_parents": ["f50268a720823cee7a8d63eb34ab3213fd7c1b89"], "node": "292002dbdaec42f592dc1ada3b15da3e89b14327", "parents": ["4b2a261a0f44392aef308ea8e2b868795698f1c6"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082866: Fix issue with font color in  ai-grouped-chip-container in HCM mode r=jlewis\n\nThe issue was that the fonts were not inheriting the proper style from its parent so HCM mode didn't work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336037\n", "files": ["browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.css"], "git_node": "ed2379686cbbb3a861f1a057b440c4afc4bd11ae", "git_parents": ["d2412cf892849257bec34cc77e6161e0e9ff798b"], "node": "f3fa7d7ff80af8f69dcc618dddd87c0a5b0b7d45", "parents": ["292002dbdaec42f592dc1ada3b15da3e89b14327"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049500 - Replace the vertical overflow indicator gradients with a mask on the scrollbox, so the tabs fade into transparency r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334245\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "03af7d2ef8d72be811fd4ca3266bb39cf8ffbc69", "git_parents": ["ed2379686cbbb3a861f1a057b440c4afc4bd11ae"], "node": "5ec1bb619492bc9c1840c0980983a545f3b71a1f", "parents": ["f3fa7d7ff80af8f69dcc618dddd87c0a5b0b7d45"], "tags": []}, {"au