048c12404dab2e75248c5cbca2555023f82349", "c68cd46b612042bf18fd48beef618cd82c604424", "ea1ed8a263983edde345192a9df631483f8921eb", "36102cc3b807c11f7c11027dc745fd1576c29c69", "47e2c4baba470ca3921b93da876fbb20da17c871", "1e310260624587633efcbd0466b36bf3d8847ebd", "1fcc2c993a4e7c0a6d3855eca84d3feb24abbcf9", "309a5a01511293cd91f86d82c9c2f7130dd38ebc"], "user": "ctuns@mozilla.com"}, "45659": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085757 - Simplify some attribute mapping code. r=firefox-style-system-reviewers,layout-reviewers,devtools-reviewers,dshin,nchevobbe\n\nThe things that are just mapped to the tag name can be UA sheet rules.\n\nRemove the math font pref because it's been shipping for a while.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336673\n", "files": ["devtools/server/actors/animation-type-longhand.js", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxPlatformFontList.cpp", "layout/inspector/tests/test_getMatchingCSSRules.html", "layout/mathml/mathml.css", "layout/style/res/quirk.css", "layout/svg/svg.css", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/color/parsing.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/font.rs", "servo/components/style/values/specified/color.rs", "testing/web-platform/meta/css/css-fonts/__dir__.ini", "testing/web-platform/meta/mathml/relations/css-styling/default-font-family.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/default-font.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/math-font-001-legacy.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/math-font-001.html.ini", "testing/web-platform/mozilla/tests/mathml/fonts/default-font.html", "testing/web-platform/mozilla/tests/mathml/fonts/math-font-001-legacy.html", "toolkit/components/resistfingerprinting/nsUserCharacteristics.cpp", "toolkit/components/resistfingerprinting/tests/gtest/test_mathml_prefs.cpp", "xpcom/ds/StaticAtoms.py"], "git_node": "26f39a3f2bc5e7d02a035cb8f5937dae6cb41863", "git_parents": ["309a5a01511293cd91f86d82c9c2f7130dd38ebc"], "node": "c0b58080d6d5b050bfb28c5e4e98031c886fd15f", "parents": ["5e176f1bbe0e5c19ffab3e7e496a1844cb25458d"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2085528 - Only send the page swap target entry to the process of the top document. r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336514\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/test/browser/browser.toml", "docshell/test/browser/browser_bfcache_pageswap_target_entry.js", "dom/ipc/ContentChild.cpp"], "git_node": "b406282f2a20305247350520c451588062370ded", "git_parents": ["26f39a3f2bc5e7d02a035cb8f5937dae6cb41863"], "node": "bdef54a88d5a2045112d07d17bf588b588beeda0", "parents": ["c0b58080d6d5b050bfb28c5e4e98031c886fd15f"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082025 - Explicitly check for resize() failure. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336817\n", "files": ["gfx/harfbuzz/bug-2082025.patch", "gfx/harfbuzz/moz.yaml", "gfx/harfbuzz/src/OT/Layout/GDEF/GDEF.hh"], "git_node": "bfa668a4834abe06f26c3395745c497357392dae", "git_parents": ["b406282f2a20305247350520c451588062370ded"], "node": "ba4b13b17ed28c918e8f34c7d07523cecb689d50", "parents": ["bdef54a88d5a2045112d07d17bf588b588beeda0"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2071883 - disable B-local(arm64) blocked by upstream request. r=taskgraph-reviewers,jcristau\n\nhttps://github.com/canonical/snapcraft/issues/6479 is needed to fix the task\nand ETA is unknown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337093\n", "files": ["taskcluster/kinds/snap-upstream-build/kind.yml"], "git_node": "930a9aafad3f56bf8685c07a86f18d9502340efa", "git_parents": ["bfa668a4834abe06f26c3395745c497357392dae"], "node": "c4379599da762969cd3a0a5a7b066851ed402efb", "parents": ["ba4b13b17ed28c918e8f34c7d07523cecb689d50"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2084393 - Fix setting primary attribute for activeness change in GeckoView r=geckoview-reviewers,ohall\n\nReactivation doesn't re-register the primary BrowserParent (that only happens on a BrowserParent change), so re-assert the primary attribute to force nsFrameLoader to restore this browser as the window's primary content. Without this, APIs that rely on the primary content browsing context break after the tab is backgrounded and reselected (ScrollCapture and captureFullPage are affected, other potentially affected APIs include SessionFinder, SessionTextInput, SelectionActionDelegate, getPageToScreenMatrix, getPageToSurfaceMatrix, printToPdf, printPageContent, ScrollDelegate).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336281\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SessionLifecycleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs"], "git_node": "b01ad3ff30a5433cbdf83ddbf1a153ecb8f7f3ac", "git_parents": ["930a9aafad3f56bf8685c07a86f18d9502340efa"], "node": "88ab712704d6b307fef781bde43c88d5675deb70", "parents": ["c4379599da762969cd3a0a5a7b066851ed402efb"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084393 - Fix setting primary attribute for activeness change in GeckoView r=geckoview-reviewers,ohall\" for causing Lint failures.\n\nThis reverts commit b01ad3ff30a5433cbdf83ddbf1a153ecb8f7f3ac.\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SessionLifecycleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs"], "git_node": "619e331f9882492a70a3985c9a22f0c488b14bf3", "git_parents": ["b01ad3ff30a5433cbdf83ddbf1a153ecb8f7f3ac"], "node": "e5df05b5c3272f76d2fb20504275125a36d13590", "parents": ["88ab712704d6b307fef781bde43c88d5675deb70"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069762 - Fix intermittent TV browser_retainedResultsOnFocus.js by resetting adaptive autofill backspace blocks in cleanup function. r=jteow,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337083\n", "files": ["browser/components/urlbar/tests/browser-results/browser_retainedResultsOnFocus.js"], "git_node": "222753b13848363ed4639df302b37864e81d38c0", "git_parents": ["619e331f9882492a70a3985c9a22f0c488b14bf3"], "node": "85be69256842c36103b83ade08b7aecc66ea9eb6", "parents": ["e5df05b5c3272f76d2fb20504275125a36d13590"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085757 - Simplify some attribute mapping code. r=firefox-style-system-reviewers,layout-reviewers,devtools-reviewers,dshin,nchevobbe\" for causing mochitest failures with longhands::_x_text_scale::get_initial_value()\n\nThis reverts commit 26f39a3f2bc5e7d02a035cb8f5937dae6cb41863.\n", "files": ["devtools/server/actors/animation-type-longhand.js", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxPlatformFontList.cpp", "layout/inspector/tests/test_getMatchingCSSRules.html", "layout/mathml/mathml.css", "layout/style/res/quirk.css", "layout/svg/svg.css", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/color/parsing.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/font.rs", "servo/components/style/values/specified/color.rs", "testing/web-platform/meta/css/css-fonts/__dir__.ini", "testing/web-platform/meta/mathml/relations/css-styling/default-font-family.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/default-font.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/math-font-001-legacy.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/math-font-001.html.ini", "testing/web-platform/mozilla/tests/mathml/fonts/default-font.html", "testing/web-platform/mozilla/tests/mathml/fonts/math-font-001-legacy.html", "toolkit/components/resistfingerprinting/nsUserCharacteristics.cpp", "toolkit/components/resistfingerprinting/tests/gtest/test_mathml_prefs.cpp", "xpcom/ds/StaticAtoms.py"], "git_node": "7b7fa66c6b60b45054e7741cfd7721fbf2b3de90", "git_parents": ["222753b13848363ed4639df302b37864e81d38c0"], "node": "ad88593cfa7ba07fa66dd7c776291524f3ba05cc", "parents": ["85be69256842c36103b83ade08b7aecc66ea9eb6"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085868: don't store Actions and Timeouts helpers on Marionette. r=webdriver-reviewers,whimboo\n\nThe circular reference created by Actions and Timeouts holding a reference to the object that holds them meant that the Marionette destructor did not run until cyclical garbage collection did (instead of immediately after Marionette went out of scope). We can avoid this delay in destruction by using properties to sidestep the circular reference. This means that the destructor (and any external-to-Marionette cleanup code that is called by it) will run more predictably.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336856\n", "files": ["testing/marionette/client/marionette_driver/marionette.py"], "git_node": "b251b0de8ddfd3cab648b8ab72a8ab3ccf695e76", "git_parents": ["7b7fa66c6b60b45054e7741cfd7721fbf2b3de90"], "node": "90c12de0638adc94c4e05f05096370cbed17af26", "parents": ["ad88593cfa7ba07fa66dd7c776291524f3ba05cc"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085868: avoid strong circular references in DeviceRunner r=releng-reviewers,jcristau\n\nSimilar to the parent commit, we want to avoid strong circular references that cause garbage collection to be delayed. In this case, the references are actually caused by some parts of `process_args` that actually go unused. Rather than try to solve that (eg: by making them weak references), we can just remove them instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336857\n", "files": ["testing/mozbase/mozrunner/mozrunner/base/device.py"], "git_node": "a61bc6854b312079380d9f22fb41e1b8879aeb6f", "git_parents": ["b251b0de8ddfd3cab648b8ab72a8ab3ccf695e76"], "node": "2cac3a30839f5abce19a94d81c0973a0e9f02c1a", "parents": ["90c12de0638adc94c4e05f05096370cbed17af26"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085868: don't do clean-up twice in BaseRunner r=releng-reviewers,ahal\n\nThis avoids major shutdown delays when cleanup blocks on certain things. For example, DeviceRunner calls out to adb, and those calls will hang if the device is already gone. Calling cleanup twice effectively ensures we hang.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336858\n", "files": ["testing/mozbase/mozrunner/mozrunner/base/device.py", "testing/mozbase/mozrunner/mozrunner/base/runner.py"], "git_node": "dace3e5d11c0687157805331de2656442027c64c", "git_parents": ["a61bc6854b312079380d9f22fb41e1b8879aeb6f"], "node": "0b6ff159e34d83a3e7b809f9e771238b773d5229", "parents": ["2cac3a30839f5abce19a94d81c0973a0e9f02c1a"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Replace misuse of std::forward by std::move in toolkit/ r=win-reviewers,gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335985\n", "files": ["toolkit/xre/dllservices/mozglue/LoaderObserver.cpp"], "git_node": "38e9036e49ffb109c0fa5d9a91c35c483e7ec89d", "git_parents": ["dace3e5d11c0687157805331de2656442027c64c"], "node": "5975577cfadea1beac68e50d07755168369550a2", "parents": ["0b6ff159e34d83a3e7b809f9e771238b773d5229"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Replace misuse of std::forward by std::move in ipc/ r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335986\n", "files": ["ipc/mscom/Utils.cpp"], "git_node": "8a682fd0029d915e92c91d3abd5502c2d63d2fb2", "git_parents": ["38e9036e49ffb109c0fa5d9a91c35c483e7ec89d"], "node": "081d2aabadf20c11669d5d2b5defdcc2bc253d8a", "parents": ["5975577cfadea1beac68e50d07755168369550a2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2086072 - Clean up mapped attribute scheduling. r=firefox-svg-reviewers,longsonr\n\nSaving a couple null-checks is not worth the duplication I think.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337098\n", "files": ["dom/base/Element.cpp", "dom/base/Element.h", "dom/html/HTMLBodyElement.cpp", "dom/html/HTMLInputElement.cpp", "dom/svg/SVGSVGElement.cpp"], "git_node": "585d0666afdcc11a98c2d9fb71406924249e217c", "git_parents": ["8a682fd0029d915e92c91d3abd5502c2d63d2fb2"], "node": "f20d8bec2726a8a55849115b2d436a408a8613fa", "parents": ["081d2aabadf20c11669d5d2b5defdcc2bc253d8a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981478 - Flip prefs to switch to NDK decoding/encoding on Android on nightly. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260149\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "30b2520b870c1f387ef06514d88223158c1ec920", "git_parents": ["585d0666afdcc11a98c2d9fb71406924249e217c"], "node": "7fccc0741ddc4ab08eb66b338b65971a5f19f13f", "parents": ["f20d8bec2726a8a55849115b2d436a408a8613fa"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074179 - Reject ErrorResult-internal nsresult values in IPC deserialization. r=tschuster,ipc-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330160\n", "files": ["dom/bindings/BindingUtils.cpp", "dom/bindings/ErrorResult.h", "ipc/chromium/src/chrome/common/ipc_message_utils.h"], "git_node": "4b3e088a325ceb62bb355e9abf264f76a0e829f0", "git_parents": ["30b2520b870c1f387ef06514d88223158c1ec920"], "node": "040080b22236403a7a3aaa9734200f7f3731612a", "parents": ["7fccc0741ddc4ab08eb66b338b65971a5f19f13f"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068241 - When Firefox is already installed and onboarded, open a custom tab for the sign-in flow. r=roger\n\nA QR-scanned pairing link (`accounts.firefox.com/pair#channel_id=...`) reaches Firefox through the App Links filter on `IntentReceiverActivity`. Previously, it fell through to the regular tab processor, leaving the FxA page open as a normal tab after sign-in or when abandoned.\n\n`IntentReceiverActivity` now records `pairing_link_opened` and opens the link with `createAuthCustomTabIntent`, the same route every sign-in entry point takes into `AuthCustomTabActivity`. That activity finishes on `onAuthenticated` and removes its custom tab whenever it is left, so neither success nor abandonment leaves a tab behind. Pairing links no longer count towards `opened_link`.\n\nThis mirrors `PairFragment`, which handles the same URL from the in-app QR scanner:\n\n- **In-app scanner:** `PairFragment` hands the URL to the native pairing flow and opens the resulting `/pair/supp` OAuth URL in the auth custom tab.\n- **External scanner:** the `/pair` page itself loads in the auth custom tab, and FxA starts OAuth over the pairing v2 web channel.\n\nBoth complete through the `fxaccounts:oauth_login` web channel message.\n\nThe receiver\u2019s transparent theme and the application context both lack the Material `colorSurface` attribute that `createCustomTabIntent` reads, so the intent is built using a `ContextThemeWrapper` with `NormalTheme`.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/415\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/IntentReceiverActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AuthCustomTabActivity.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/IntentReceiverActivityTest.kt"], "git_node": "7d5b7309c54720c05434c9c7eb74db54fe69b26d", "git_parents": ["4b3e088a325ceb62bb355e9abf264f76a0e829f0"], "node": "114e036e8c10cead74b394bfdcb175c3c670a698", "parents": ["040080b22236403a7a3aaa9734200f7f3731612a"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083815 - Update elapsed time to show what time of the audio is being scrubbed to r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336215\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/AudioProgressBar.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/AudioProgressBarTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetTest.kt"], "git_node": "9f84e406e3089fb1f80dcd3692fe977a0e972777", "git_parents": ["7d5b7309c54720c05434c9c7eb74db54fe69b26d"], "node": "cdf0c9fa5778ca63e2cbef0ff02047cf7695dd45", "parents": ["114e036e8c10cead74b394bfdcb175c3c670a698"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081939: Avoid duplicating frames that escape repeating headers. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336318\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/reftests/bugs/reftest.list"], "git_node": "4e802da860c0d46714b6942ae332b8eac9bf55fb", "git_parents": ["9f84e406e3089fb1f80dcd3692fe977a0e972777"], "node": "115dffd69d888416548d20a6c7a2d3343b88b602", "parents": ["cdf0c9fa5778ca63e2cbef0ff02047cf7695dd45"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083304 - Fix android background and foreground perf test on chrome r=sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336032\n", "files": ["testing/performance/android-resource/main-background.sh", "testing/performance/android-resource/main-foreground.sh", "testing/performance/android-resource/test-android-resource-usage.sh"], "git_node": "5a44a53a183ba70f1c3a14f5aeed770f8f8864fc", "git_parents": ["4e802da860c0d46714b6942ae332b8eac9bf55fb"], "node": "9951f557667f64f75c3ab65b19e4b4cdafd005cf", "parents": ["115dffd69d888416548d20a6c7a2d3343b88b602"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084362 - [bidi] Stop adding new viewport SessionData items for each setViewport call r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336854\n", "files": ["remote/shared/messagehandler/sessiondata/SessionData.sys.mjs", "remote/webdriver-bidi/modules/root/_configuration.sys.mjs", "remote/webdriver-bidi/modules/root/browsingContext.sys.mjs"], "git_node": "3afc77210e3e27c14c78ef23d5903f2257375e0a", "git_parents": ["5a44a53a183ba70f1c3a14f5aeed770f8f8864fc"], "node": "b39dec4dbdb13a8232971cdb770ebc2057931745", "parents": ["9951f557667f64f75c3ab65b19e4b4cdafd005cf"], "tags": []}, {"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085021 - Treat login timestamps outside the range of a JS Date as missing when passing them to the Rust storage. r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337106\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_storage_rust_timestamps.js", "toolkit/components/passwordmgr/test/unit/xpcshell.toml"], "git_node": "d2fc20f438970a5d63a683ad1233ce58fa1242c8", "git_parents": ["3afc77210e3e27c14c78ef23d5903f2257375e0a"], "node": "0eee4d33c28e3098b375ea25d3d6573c4b186101", "parents": ["b39dec4dbdb13a8232971cdb770ebc2057931745"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085003 - NVDA does not announce the Your Rule section in the VPN panel - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336751\n", "files": ["browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js"], "git_node": "bebcb82ad3523dcd98c7c77c42a3885ca2e9bc45", "git_parents": ["d2fc20f438970a5d63a683ad1233ce58fa1242c8"], "node": "c57663986f1b42d0ff92c8f95f654cafc2d3c902", "parents": ["0eee4d33c28e3098b375ea25d3d6573c4b186101"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081405 - Record telemetry when the autocomplete dropdown is suppressed because of an unrecognized autocomplete value. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334170\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_unrecognized_attribute_dynamic.js", "toolkit/components/formautofill/FormAutofillChild.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "d02456054279735d1884b3174f2e69a641919eae", "git_parents": ["bebcb82ad3523dcd98c7c77c42a3885ca2e9bc45"], "node": "2d19d03dd425044bde66b7aba71448f178a53ed4", "parents": ["c57663986f1b42d0ff92c8f95f654cafc2d3c902"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078831 - Bump the update generation under the same lock where ContentClassifierService::ProcessListChanges decides which engines to rebuild. r=emz\n\nThis patch changes ProcessListChanges to bump mUpdateGeneration and the\nper-feature versions under the same lock that reads mEngines, and to pass\nthem into UpdateFeatures. They used to be bumped in a later critical\nsection, so an older build-thread closure could still run Populate and\nPrune with its stale snapshot in between, pruning an engine that the newer\ncall had not scheduled for a rebuild because it still existed.\n\nThis patch also removes the active feature check in UpdateFeatures and\nreplaces it with a debug assertion. ProcessListChanges already only passes\nfeatures that are active in the same snapshot, so the check never dropped\nanything, and dropping one now would misalign the features with their\nversions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331619\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/ContentClassifierService.h"], "git_node": "da99a869e53027a47dd30658ea457a457434f3a2", "git_parents": ["d02456054279735d1884b3174f2e69a641919eae"], "node": "e081301bd6fa240554312c3b05d6cadb45d61fea", "parents": ["2d19d03dd425044bde66b7aba71448f178a53ed4"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080226 - Stop ContentClassifierRemoteSettingsClient from notifying the service after shutdown(). r=emz\n\nThis patch changes importAllLists() and onSync() to re-read #service after\ntheir awaits instead of using a reference captured before them. If\nshutdown() ran during rs.get() or deleteDownloaded(), the stale reference\nstill received onListsChanged(), which rejects with NS_ERROR_NOT_INITIALIZED\nonce ContentClassifierService::BlockShutdown has run. Short-lived xpcshell\ntests failed on the resulting uncaught rejection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332448\n", "files": ["toolkit/components/content-classifier/ContentClassifierRemoteSettingsClient.sys.mjs", "toolkit/components/content-classifier/test/unit/test_rs_client_shutdown.js", "toolkit/components/content-classifier/test/unit/xpcshell.toml"], "git_node": "f3693da8612691a44059f20da1184f035e292314", "git_parents": ["da99a869e53027a47dd30658ea457a457434f3a2"], "node": "6b8a1a7dfff79d5662cf06e7597ac40b577c0f25", "parents": ["e081301bd6fa240554312c3b05d6cadb45d61fea"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080291 - Don't block ContentClassifier requests the loading extension has explicit host permission for. r=emz\n\nThis patch changes the ETP request filter, renamed to ShouldClassifyForETP,\nto skip blocking when UrlClassifierCommon::AddonMayLoad() passes. This aligns\nthe ContentClassifier with url-classifier, whose protection features don't\nblock a content script's request to a host its extension has explicit host\npermission for. Annotation is unchanged, matching url-classifier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332806\n", "files": ["toolkit/components/antitracking/docs/content-classifier/index.md", "toolkit/components/content-classifier/ContentClassifierFeatureUtils.cpp", "toolkit/components/content-classifier/ContentClassifierFeatureUtils.h", "toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.cpp", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.h", "toolkit/components/content-classifier/test/browser/browser_content_classifier_content_script.js"], "git_node": "44377e1e4fb94890a93982f2188464c01658ecc6", "git_parents": ["f3693da8612691a44059f20da1184f035e292314"], "node": "e38fb1c90649b94b7342d8360e49344ddc32727d", "parents": ["6b8a1a7dfff79d5662cf06e7597ac40b577c0f25"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086097 - Bug 2058611 - Test for aborting node insertion after custom button element is added to form. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336204\n", "files": ["testing/web-platform/tests/custom-elements/custom-button-abort-insertion-crash.html"], "git_node": "8f2d73639488444c7014aa25bddc6b787ee7c7e4", "git_parents": ["44377e1e4fb94890a93982f2188464c01658ecc6"], "node": "f7e1b629cf0e2dc0a8f990d207c93cf4ea60dd5e", "parents": ["e38fb1c90649b94b7342d8360e49344ddc32727d"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086097 - Bug 2063871 - Test for aborting node insertion after custom image element is added to form. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336205\n", "files": ["testing/web-platform/tests/custom-elements/custom-image-abort-insertion-crash.html"], "git_node": "ebfd99c38b9397d92c8782afc5d41116c8563a6b", "git_parents": ["8f2d73639488444c7014aa25bddc6b787ee7c7e4"], "node": "d0fd668eb70e70d8ebe07ac863dd92a9c781fea4", "parents": ["f7e1b629cf0e2dc0a8f990d207c93cf4ea60dd5e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1958511 - Make @page inherit from the root element. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nMatches the spec and in some way we already have this dependency, since\nwe allow e.g. rem units inside @page.\n\nThis fixes a few pre-existing issues with rem units, because we were not\nwaiting for the root element to be styled. We query the page style\nbefore the root is styled for the initial frame constructor but then\nre-resolve it properly. It'd be nice to make that more explicit but not\ntoday...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337088\n", "files": ["layout/style/ServoStyleSet.cpp", "layout/style/ServoStyleSet.h", "servo/components/style/gecko/anon_boxes.toml", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-page/page-margin-006-print.html.ini", "testing/web-platform/tests/css/css-page/page-context-inherits-from-root-001-print-ref.html", "testing/web-platform/tests/css/css-page/page-context-inherits-from-root-002-print-ref.html", "testing/web-platform/tests/css/css-page/page-context-inherits-from-root-custom-property-print.html", "testing/web-platform/tests/css/css-page/page-context-inherits-from-root-em-rem-print.html", "testing/web-platform/tests/css/css-page/page-context-inherits-from-root-font-size-001-print.html", "testing/web-platform/tests/css/css-page/page-context-inherits-from-root-font-size-002-print.html", "testing/web-platform/tests/css/css-page/page-context-inherits-from-root-rem-print.html"], "git_node": "2093e3a470ca0478ca80fbcb005f4199c4371264", "git_parents": ["ebfd99c38b9397d92c8782afc5d41116c8563a6b"], "node": "1303a197762957980fcbe63b55d86cbe3d862920", "parents": ["d0fd668eb70e70d8ebe07ac863dd92a9c781fea4"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081939: Avoid duplicating frames that escape repeating headers. r=layout-reviewers,emilio\" for causing Crashtest failures.\n\nThis reverts commit 4e802da860c0d46714b6942ae332b8eac9bf55fb.\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/reftests/bugs/reftest.list"], "git_node": "94654d3ba4b395c8c250cf59e4589b4070a85ada", "git_parents": ["2093e3a470ca0478ca80fbcb005f4199c4371264"], "node": "754218392d3aab57978f13b41544dc3e64157504", "parents": ["1303a197762957980fcbe63b55d86cbe3d862920"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064110: Sign the test app bundle before languagePackUpdates.js launches the updater from it. r=application-update-reviewers,yjuglaret\n\nOn macOS with SIP enabled, syspolicyd appears to hold the launch of the updater inside the test's unsigned dir.app behind a \"dir is damaged\" prompt, so staging never starts. Add setupTestAppBundle as the one helper tests call to install the application files and the test updater and, on macOS, write the Info.plist and ad-hoc sign the bundle. Use it from both setupUpdaterTest and languagePackUpdates.js so the two can't drift apart again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331621\n", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_aus_update/languagePackUpdates.js"], "git_node": "d329f895463426a3e0c3933bc4bb6c9e3c60c3ab", "git_parents": ["94654d3ba4b395c8c250cf59e4589b4070a85ada"], "node": "fb9b2939e07aa0780c18062b077ab1ef1f539646", "parents": ["754218392d3aab57978f13b41544dc3e64157504"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086010: Wait for launch completion before stopping the Mac startup run loop. r=emilio\n\nThe startup loop can reach idle before the launch-finished callback, consuming its only stop attempt.\n\nLint passes, but I haven't reproduced the hang locally or verified this candidate with a build, runtime test, or regression test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337014\n", "files": ["toolkit/xre/MacApplicationDelegate.mm"], "git_node": "b9c68410a78a3640244f5b9cc6b2945c5e4f9d83", "git_parents": ["d329f895463426a3e0c3933bc4bb6c9e3c60c3ab"], "node": "dbc6293be9dc8ab0f6f76fbde5243a508e1a8bda", "parents": ["fb9b2939e07aa0780c18062b077ab1ef1f539646"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053295 - Update the Clear private session panel description to say it closes private tabs. r=fluent-reviewers,emz,bolsson\n\nClarify that clearing the private session will close all private tabs too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332842\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/locales/en-US/browser/browser.ftl"], "git_node": "d1dcbdad3ec494755fe497ab068224494aba3f75", "git_parents": ["b9c68410a78a3640244f5b9cc6b2945c5e4f9d83"], "node": "5985ceaa849af445e6fcc1e471214563573d93dc", "parents": ["dbc6293be9dc8ab0f6f76fbde5243a508e1a8bda"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084248 - Fix for vertical tab close buttons being cut off in compact mode when the sidebar is collapsed r=desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335760\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "ccf113faaffffce7d0aace2914cbb9ade7d0bd14", "git_parents": ["d1dcbdad3ec494755fe497ab068224494aba3f75"], "node": "51936d2e0b3a6ce1bf1052663b222373e41b2023", "parents": ["5985ceaa849af445e6fcc1e471214563573d93dc"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079506 - Rename \"Never save cards\" to \"Never save payment methods\" in the card save doorhanger. r=mtigley,fluent-reviewers,credential-management-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336859\n", "files": ["toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "b64c5f2c42de4fc77ce77c645b5dfbeea0f8b1ea", "git_parents": ["ccf113faaffffce7d0aace2914cbb9ade7d0bd14"], "node": "f74672fc9e4847f1586c20cfdd3977a4f4ae9577", "parents": ["51936d2e0b3a6ce1bf1052663b222373e41b2023"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081421 - Fix generating crash reports via the WER runtime exception module r=afranchuk,crashreporting-reviewers\n\nThis fixes two separate issues that had arised by previous refactorings\nof the crash reporter code. The first is that since we switched to a\npull model for transfering handles the WER runtime exception module\ncouldn't send the process and thread handles to the crash helper\nanymore. This is solved by replacing them with process and thread ids\nwhich we know remain valid as the corresponding handles remain open in\nthe WER runtime exception module until the crash helper is done dumping\nthe process. The second issue is that the crash report that the helper\ngenerated was not being properly recorded, so when the main process\nreached out for it, it wouldn't find it, leaving behind an orphaned\ncrash report.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335704\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs", "toolkit/crashreporter/mozwer-rust/lib.rs"], "git_node": "c69bc49a5ac983c3dcfb24400b6ca23a984a933d", "git_parents": ["b64c5f2c42de4fc77ce77c645b5dfbeea0f8b1ea"], "node": "83cdae3efa5e292207bce19e7290736a55d22469", "parents": ["f74672fc9e4847f1586c20cfdd3977a4f4ae9577"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082994 - Make DispatchWidgetEventViaAPZ MOZ_CAN_RUN_SCRIPT. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334576\n", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/CoalescedInputData.h", "dom/ipc/CoalescedMouseData.h", "dom/ipc/CoalescedTouchData.h"], "git_node": "3c0ca163c1abe14e85e23cf0ac296577e6888ac9", "git_parents": ["c69bc49a5ac983c3dcfb24400b6ca23a984a933d"], "node": "ef25ab79605673a3fd2ce4385b263ff0eed35e91", "parents": ["83cdae3efa5e292207bce19e7290736a55d22469"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082127 - Follow-up: Test native-anonymous elements don't appear in author shadow. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334412\n", "files": ["dom/base/test/mochitest.toml", "dom/base/test/test_anonymousContent_id_table.html"], "git_node": "3a14c8c6a2ce359aeea5a3c1d7c07880e9a766a8", "git_parents": ["3c0ca163c1abe14e85e23cf0ac296577e6888ac9"], "node": "f645c38bf1ff44b67d2dabdfd6a8a870020e9052", "parents": ["ef25ab79605673a3fd2ce4385b263ff0eed35e91"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2079095 - Base the browser language fallback on requested locales. r=settings-reviewers,mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336575\n", "files": ["browser/components/preferences/config/languages.mjs", "browser/components/preferences/tests/languages/browser_browser_languages_fallback.js"], "git_node": "38318d21ef31de5af89b06bf1f0aa4cc52f44994", "git_parents": ["3a14c8c6a2ce359aeea5a3c1d7c07880e9a766a8"], "node": "c50ab077d9cb5bdf4bbc12626de3f745cc520366", "parents": ["f645c38bf1ff44b67d2dabdfd6a8a870020e9052"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2084599 - Update neqo to v0.34.0 r=jesup,leggert,necko-reviewers,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336655\n", "files": [".cargo/config.toml.in", "Cargo.lock", "netwerk/socket/neqo_glue/Cargo.toml", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/http3server/Cargo.toml", "supply-chain/audits.toml", "third_party/rust/neqo-bin/.cargo-checksum.json", "third_party/rust/neqo-bin/Cargo.toml", "third_party/rust/neqo-bin/src/lib.rs", "third_party/rust/neqo-common/.cargo-checksum.json", "third_party/rust/neqo-common/Cargo.toml", "third_party/rust/neqo-common/src/codec.rs", "third_party/rust/neqo-common/src/lib.rs", "third_party/rust/neqo-http3/.cargo-checksum.json", "third_party/rust/neqo-http3/Cargo.toml", "third_party/rust/neqo-http3/src/connect_udp.rs", "third_party/rust/neqo-http3/src/connection.rs", "third_party/rust/neqo-http3/src/features/extended_connect/session.rs", "third_party/rust/neqo-http3/src/features/extended_connect/stats.rs", "third_party/rust/neqo-http3/src/features/extended_connect/tests/webtransport/anticipated_streams.rs", "third_party/rust/neqo-http3/src/features/extended_connect/tests/webtransport/datagrams.rs", "third_party/rust/neqo-http3/src/features/extended_connect/tests/webtransport/mod.rs", "third_party/rust/neqo-http3/src/features/extended_connect/webtransport_session.rs", "third_party/rust/neqo-http3/src/lib.rs", "third_party/rust/neqo-http3/src/webtransport.rs", "third_party/rust/neqo-http3/tests/connect_udp.rs", "third_party/rust/neqo-http3/tests/webtransport.rs", "third_party/rust/neqo-qpack/.cargo-checksum.json", "third_party/rust/neqo-qpack/Cargo.toml", "third_party/rust/neqo-qpack/src/encoder.rs", "third_party/rust/neqo-transport/.cargo-checksum.json", "third_party/rust/neqo-transport/Cargo.toml", "third_party/rust/neqo-transport/benches/frame_decode.rs", "third_party/rust/neqo-transport/src/ackrate.rs", "third_party/rust/neqo-transport/src/cc/cubic.rs", "third_party/rust/neqo-transport/src/cc/tests/cubic.rs", "third_party/rust/neqo-transport/src/cc/tests/mod.rs", "third_party/rust/neqo-transport/src/cid.rs", "third_party/rust/neqo-transport/src/connection/mod.rs", "third_party/rust/neqo-transport/src/connection/params.rs", "third_party/rust/neqo-transport/src/connection/tests/ackrate.rs", "third_party/rust/neqo-transport/src/connection/tests/datagram.rs", "third_party/rust/neqo-transport/src/connection/tests/handshake.rs", "third_party/rust/neqo-transport/src/connection/tests/migration.rs", "third_party/rust/neqo-transport/src/connection/tests/mod.rs", "third_party/rust/neqo-transport/src/connection/tests/pmtud.rs", "third_party/rust/neqo-transport/src/connection/tests/stream.rs", "third_party/rust/neqo-transport/src/connection/tests/vn.rs", "third_party/rust/neqo-transport/src/connection/tests/zerortt.rs", "third_party/rust/neqo-transport/src/crypto.rs", "third_party/rust/neqo-transport/src/datagram_queue.rs", "third_party/rust/neqo-transport/src/fc.rs", "third_party/rust/neqo-transport/src/frame.rs", "third_party/rust/neqo-transport/src/lib.rs", "third_party/rust/neqo-transport/src/packet/metadata.rs", "third_party/rust/neqo-transport/src/path.rs", "third_party/rust/neqo-transport/src/pmtud.rs", "third_party/rust/neqo-transport/src/quic_datagrams.rs", "third_party/rust/neqo-transport/src/recovery/mod.rs", "third_party/rust/neqo-transport/src/recovery/sent.rs", "third_party/rust/neqo-transport/src/recovery/token.rs", "third_party/rust/neqo-transport/src/recv_stream.rs", "third_party/rust/neqo-transport/src/send_stream.rs", "third_party/rust/neqo-transport/src/sender.rs", "third_party/rust/neqo-transport/src/stats.rs", "third_party/rust/neqo-transport/src/stream_id.rs", "third_party/rust/neqo-transport/src/streams.rs", "third_party/rust/neqo-transport/src/tparams.rs", "third_party/rust/neqo-transport/src/tracking.rs", "third_party/rust/neqo-udp/.cargo-checksum.json", "third_party/rust/neqo-udp/Cargo.toml"], "git_node": "bf58cab7b694b248055a0c9a5c19cd51540c3961", "git_parents": ["38318d21ef31de5af89b06bf1f0aa4cc52f44994"], "node": "ad60816def348ffce39fd29cc1a010b514c87766", "parents": ["c50ab077d9cb5bdf4bbc12626de3f745cc520366"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2079583 - Enable CSS namespace exposure in workers and worklets on Nightly; r=emilio,dom-worker-reviewers,edenchuang\n\nEnable the `layout.css.namespace.exposed-in-workers-and-worklets` preference by\ndefault on Nightly to help identify potential issues early and gather feedback\non the proposal.\n\nUpdate WPT expectations for tests that now pass in workers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335909\n", "files": ["dom/serviceworkers/test/test_serviceworker_interfaces.js", "dom/workers/test/test_worker_interfaces.js", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-typed-om/__dir__.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/to.tentative.any.js.ini"], "git_node": "3165806bb24aa16aea9f64c1caf9be8150e8ebfa", "git_parents": ["bf58cab7b694b248055a0c9a5c19cd51540c3961"], "node": "22546d23035529d054886eaa929e1d7877de86b0", "parents": ["ad60816def348ffce39fd29cc1a010b514c87766"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085757 - Simplify some attribute mapping code. r=firefox-style-system-reviewers,layout-reviewers,devtools-reviewers,dshin,nchevobbe\n\nThe things that are just mapped to the tag name can be UA sheet rules.\n\nRemove the math font pref because it's been shipping for a while.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336673\n", "files": ["browser/base/content/test/browser-static/browser_parsable_css.js", "devtools/client/inspector/rules/test/browser_rules_attributes-style.js", "devtools/server/actors/animation-type-longhand.js", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxPlatformFontList.cpp", "layout/inspector/tests/test_getMatchingCSSRules.html", "layout/mathml/mathml.css", "layout/style/res/quirk.css", "layout/svg/svg.css", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/color/parsing.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/font.rs", "servo/components/style/values/specified/color.rs", "testing/web-platform/meta/css/css-fonts/__dir__.ini", "testing/web-platform/meta/mathml/relations/css-styling/default-font-family.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/default-font.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/math-font-001-legacy.html.ini", "testing/web-platform/mozilla/meta/mathml/fonts/math-font-001.html.ini", "testing/web-platform/mozilla/tests/mathml/fonts/default-font.html", "testing/web-platform/mozilla/tests/mathml/fonts/math-font-001-legacy.html", "toolkit/components/resistfingerprinting/nsUserCharacteristics.cpp", "toolkit/components/resistfingerprinting/tests/gtest/test_mathml_prefs.cpp", "xpcom/ds/StaticAtoms.py"], "git_node": "3d2088d363af671f8d2b32dd2a69187b7ee50ca9", "git_parents": ["3165806bb24aa16aea9f64c1caf9be8150e8ebfa"], "node": "247dee667703034647fc3aa80675eac77743e073", "parents": ["22546d23035529d054886eaa929e1d7877de86b0"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2085922 - Improve Fenix/Focus TestRail milestone Slack notification r=isabel_rios\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337129\n", "files": ["taskcluster/kinds/release-notify-testrail/kind.yml", "taskcluster/scripts/lib/testrail_utils.py", "taskcluster/scripts/slack_notifier.py", "taskcluster/scripts/testrail_main.py"], "git_node": "8b05b10f985eb0c9e3c0474c8465e031b240e538", "git_parents": ["3d2088d363af671f8d2b32dd2a69187b7ee50ca9"], "node": "d1614e95eb3ac26ad14311235d2b82c0abdd28a6", "parents": ["247dee667703034647fc3aa80675eac77743e073"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082039 - Hold strong reference to ImageListener and requests during OnStartRequest r=smaug\n\nDuring ImageListener::OnStartRequest -\u003e AddNativeObserver, ReplayImageStatus calls can make things happen on the event loop, which potentially can invalidate weak references.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334458\n", "files": ["dom/base/crashtests/2082038.html", "dom/base/crashtests/crashtests.list", "dom/base/nsImageLoadingContent.cpp", "dom/html/ImageDocument.cpp"], "git_node": "afa0311f2e893f140034306d0e72d9c9700e2e02", "git_parents": ["8b05b10f985eb0c9e3c0474c8465e031b240e538"], "node": "8f67d6c0c4b39bec1db83a7702853b635b459860", "parents": ["d1614e95eb3ac26ad14311235d2b82c0abdd28a6"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081421 - Fix generating crash reports via the WER runtime exception module r=afranchuk,crashreporting-reviewers\" for causing build bustages with BorrowedHandle\n\nThis reverts commit c69bc49a5ac983c3dcfb24400b6ca23a984a933d.\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs", "toolkit/crashreporter/mozwer-rust/lib.rs"], "git_node": "b908ae23225c90a7421f4f86a78b2d721ad69e6b", "git_parents": ["afa0311f2e893f140034306d0e72d9c9700e2e02"], "node": "001a09b2349a1c05c752663af9ff3852d4fe52a4", "parents": ["8f67d6c0c4b39bec1db83a7702853b635b459860"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084948 - Remove the SkipLeaks annotation from verifyMergeTabGroupsViaSelectionListViewTest efficiency UI test r=aaronmt\n\nAll efficiency UI tests successfully passed 3x on Firebase\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337071\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TabbedBrowsingTest.kt"], "git_node": "a8f0ba5655b77cb764402aa265d85fbf5166386f", "git_parents": ["b908ae23225c90a7421f4f86a78b2d721ad69e6b"], "node": "e9769d83f42f7593bee7dce35cbe1a96438316a4", "parents": ["001a09b2349a1c05c752663af9ff3852d4fe52a4"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086063 - Fix intermittent verifyGoogleLensFunctionalityTest UI test failure r=aaronmt DONTBUILD\n\nRemoved the flaky `mozVerify(GoogleLensSelectors.UPLOAD_LOADING_STATUS)` from the test.\n\nThe UI test successfully passed 100x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=783c68db61a05c1df19e082b54c6bd65277f1965  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337115\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/GoogleLensSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/GoogleLensSearchTest.kt"], "git_node": "10765f059330a1e78fac37baad176dfa9c8bb09b", "git_parents": ["a8f0ba5655b77cb764402aa265d85fbf5166386f"], "node": "d2d5b0b06fce5671538a1fed2183708afdfb6235", "parents": ["e9769d83f42f7593bee7dce35cbe1a96438316a4"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084953 - Convert restoreTabFromTabCrashedReporterTest and closeTabFromCrashedTabReporterTest regression UI tests to the efficiency framework r=aaronmt\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll efficiency UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337085\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CrashReportingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAboutCrashesSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CrashReportingTest.kt"], "git_node": "a78ab596086d930bf1de485c45615e1ccacda4b7", "git_parents": ["10765f059330a1e78fac37baad176dfa9c8bb09b"], "node": "3e091c8b588ab7beac502f5c479430a228e325db", "parents": ["d2d5b0b06fce5671538a1fed2183708afdfb6235"], "tags": []}, {"author": "delan azabani \u003cdazabani@igalia.com\u003e", "branch": "default", "desc": "Bug 2080049 - Serialise fragments with \u003ctemplate shadowrootreferencetarget\u003e. r=keithamus\n\nper [#html-fragment-serialisation-algorithm] as of [html#10995], update StartSerializingShadowDOM() so that we serialise `\u003ctemplate shadowrootreferencetarget\u003e` for any relevant shadow roots whose reference target is non-null.\n\nthis should fix some subtests that regressed in [wpt#60213].\n\n[#html-fragment-serialisation-algorithm]: https://whatpr.org/html/10995/964f666...9407629/parsing.html#html-fragment-serialisation-algorithm\n[html#10995]: https://github.com/whatwg/html/pull/10995\n[wpt#60213]: https://github.com/web-platform-tests/wpt/pull/60213\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332282\n", "files": ["dom/base/nsContentUtils.cpp", "testing/web-platform/meta/shadow-dom/reference-target/tentative/gethtml-serialization.html.ini"], "git_node": "99808b4d5c0210e2455c76afa9becae02be417d3", "git_parents": ["a78ab596086d930bf1de485c45615e1ccacda4b7"], "node": "ce0850d1f46b7a7ac22572968bbc5e772a783726", "parents": ["3e091c8b588ab7beac502f5c479430a228e325db"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084757 - Remove orphaned macosx64-nightlyasrelease build r=releng-reviewers,jcristau\n\nthe x64 macOS NaR perftests were removed in Bug 2052310 but the build\ntask was not removed. The build is currently also triggers the x64 PGO\nprofile run (on the 10.15 macOS builders) on pushes that wouldn't need\nit otherwise.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337136\n", "files": ["browser/config/mozconfigs/macosx64/nightly-as-release", "taskcluster/kinds/beetmover-geckoview/kind.yml", "taskcluster/kinds/build/macosx.yml"], "git_node": "6601d1ffcf0d5510806feb3dde33eb2dc9c3b7a0", "git_parents": ["99808b4d5c0210e2455c76afa9becae02be417d3"], "node": "691f0f969f7f787cf4bf9e93bb6645dc398e42cd", "parents": ["ce0850d1f46b7a7ac22572968bbc5e772a783726"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061803 - Keep the profiles and secure sync subviews at the height of the menu they open from. r=desktop-theme-reviewers,mossop,mstriemer\n\nPanelMultiView already holds a subview at the height of the view it was opened from, through an inline min-height on the view container and, in the app menu, lockpanelvertical on appMenu-mainView. The profiles, secure sync and device recent tabs views opted out of that with height: fit-content and min-height: 0 !important, which is why they were the only places where the menu visibly resized while navigating. Dropping those overrides lets the shared mechanism apply to them as well, and removes the :has() selector that needed a stylelint exception.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336155\n", "files": ["browser/base/content/test/browser-sync/browser_sync.js", "browser/components/profiles/tests/browser/browser_appmenu.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "3c266b1e53dc0c2b6bfb2b5d628db686582a7e1e", "git_parents": ["6601d1ffcf0d5510806feb3dde33eb2dc9c3b7a0"], "node": "ea0930c5ffc88db0b500bc8a25236fffdb17c893", "parents": ["691f0f969f7f787cf4bf9e93bb6645dc398e42cd"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084796 - Name the card security code after the card network. r=credential-management-reviewers,fluent-reviewers,dimi,bolsson\n\nCreditCard.getSecurityCodeL10nId() and formatSecurityCodeName() name the code\nthe way the card's network does (CVV for Visa, CVC for Mastercard, CID for\nAmerican Express, and \"Security code\" otherwise). The doorhanger card\ndetails, the autocomplete entry, the payment methods list and dialogs, and the\nedit dialog's field use it instead of a fixed abbreviation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336187\n", "files": ["browser/extensions/formautofill/content/autofillEditForms.mjs", "browser/extensions/formautofill/content/editCreditCard.xhtml", "browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/unit/test_profileAutocompleteResult.js", "browser/locales/en-US/browser/preferences/formAutofill.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "python/l10n/fluent_migrations/bug_2084796_card_details.py", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl", "toolkit/locales/en-US/toolkit/payments/payments.ftl", "toolkit/modules/CreditCard.sys.mjs", "toolkit/modules/tests/xpcshell/test_CreditCard.js"], "git_node": "3e1890faf786caf947c267f6ed09bfa862dd888e", "git_parents": ["3c266b1e53dc0c2b6bfb2b5d628db686582a7e1e"], "node": "fe86cb275e76b3cbfe19ce545fee37db759723d2", "parents": ["ea0930c5ffc88db0b500bc8a25236fffdb17c893"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084803 - Update the card save doorhanger to the new security code design. r=credential-management-reviewers,fluent-reviewers,desktop-theme-reviewers,akulyk,flod,dimi\n\nWhen security codes are supported, the save doorhanger offers a toggle for\nsaving them in place of the checkbox. The description and card details follow\nthe toggle, so they only mention the security code when it will be saved. The\nupdate doorhanger keeps the checkbox for now. The lock icon of the card\ndoorhangers is now filled with the success color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336294\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/themes/shared/formautofill-notification.css", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "2948a11edcacb1a174188fd77fa78db91ef30ffd", "git_parents": ["3e1890faf786caf947c267f6ed09bfa862dd888e"], "node": "3b6765d5f966288091e982ad8b3f273d72140987", "parents": ["fe86cb275e76b3cbfe19ce545fee37db759723d2"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084805 - Update the card update doorhanger for updates that keep the security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\n\nWhen security codes are supported, the update doorhanger shows the plain\n\"Update payment method?\" content, without the security codes checkbox, and\nnotes the stored security code in the card details. A form submitted with an\nempty security code no longer clears the stored one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336295\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "b99b30a6aad68a53d98340266f63e9fd5721b962", "git_parents": ["2948a11edcacb1a174188fd77fa78db91ef30ffd"], "node": "2937d85a30b7b25f5d3663c63c68fc245bcb2878", "parents": ["3b6765d5f966288091e982ad8b3f273d72140987"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084804 - Update the card update doorhanger for a new or changed security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\n\nA saved card submitted with a new or changed security code gets a \"Save\nsecurity code?\" doorhanger with the security codes toggle. Turning the toggle\noff switches it to the plain update content in place, and updating then keeps\nthe stored security code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336296\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "e5d76e3da0c3a7b4e5ff322b66a8eaf224c23db9", "git_parents": ["b99b30a6aad68a53d98340266f63e9fd5721b962"], "node": "2c780fa43450128e2d756172ad7b2ce34e0e2724", "parents": ["2937d85a30b7b25f5d3663c63c68fc245bcb2878"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2072252 - Set layout.css.random.enabled for all users. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336982\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "c9a3dee025fee9f0fa339333bd38607a3bc7a1af", "git_parents": ["e5d76e3da0c3a7b4e5ff322b66a8eaf224c23db9"], "node": "36ecd98a52718cbed5015f4f9c0f34177e3352e0", "parents": ["2c780fa43450128e2d756172ad7b2ce34e0e2724"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054571 - Give the settings listboxes accessible names r=fluent-reviewers,settings-reviewers,mstriemer,bolsson\n\nAdds a localized accessible name, populated through a new Fluent string,\nto each listbox in the redesigned settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333749\n", "files": ["browser/components/preferences/config/containers.mjs", "browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/config/languages.mjs", "browser/components/preferences/config/search.mjs", "browser/components/preferences/tests/head-common.js", "browser/components/preferences/tests/home/browser_homepage_custom_homepage_manage_urls.js", "browser/components/preferences/tests/languages/browser_website_language_reorder.js", "browser/components/preferences/tests/privacy/browser_containers_reorder.js", "browser/components/preferences/tests/search/browser_search_engineList.js", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "9871b7f55a02b671923099aee73de04bc02762d7", "git_parents": ["c9a3dee025fee9f0fa339333bd38607a3bc7a1af"], "node": "e331baae018c8afcd30090f6f890956f4be8d0a4", "parents": ["36ecd98a52718cbed5015f4f9c0f34177e3352e0"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085906 - Add the remaining strings for FRO r=omc-reviewers,fluent-reviewers,bolsson,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336905\n", "files": ["browser/locales/en-US/browser/newtab/onboarding.ftl"], "git_node": "dd79534f56a77c2f60ff0dc6b459ee9dc23b0d15", "git_parents": ["9871b7f55a02b671923099aee73de04bc02762d7"], "node": "46f0fbcb2cc4b3317b9191ee28b3952ea8869a09", "parents": ["e331baae018c8afcd30090f6f890956f4be8d0a4"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083770 - Convert verifyDownloadCompleteNotificationTest regression UI test to the efficiency framework r=aaronmt\n\nHad to refactor the legacy test to match the manual test.\nBoth the \"legacy\" and \"efficiency\" UI tests successfully passed 25x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=107209 | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=107210  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335537\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/DownloadTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/NotificationPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/NotificationSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/DownloadTest.kt"], "git_node": "49114d3fded0dc3ef0a474ad0466f3cfc18a30c5", "git_parents": ["dd79534f56a77c2f60ff0dc6b459ee9dc23b0d15"], "node": "db26b8dac8001aea18be16b15c5675678f1030eb", "parents": ["46f0fbcb2cc4b3317b9191ee28b3952ea8869a09"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade APZ thread assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333734\n", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZPublicUtils.cpp", "gfx/layers/apz/src/APZSampler.cpp", "gfx/layers/apz/src/APZUpdater.cpp", "gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/layers/apz/src/FocusTarget.cpp", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/layers/apz/util/APZThreadUtils.cpp", "gfx/layers/apz/util/CheckerboardReportService.cpp", "gfx/layers/apz/util/ChromeProcessController.cpp", "gfx/layers/apz/util/ScrollLinkedEffectDetector.cpp"], "git_node": "ffe19cbab97152794efc1c5568e210ca474a10f9", "git_parents": ["49114d3fded0dc3ef0a474ad0466f3cfc18a30c5"], "node": "78e0af3d9cb918bda35d2f54f0184b96796e152b", "parents": ["db26b8dac8001aea18be16b15c5675678f1030eb"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade layers/ipc thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333735\n", "files": ["gfx/layers/ipc/APZBridgeChild.cpp", "gfx/layers/ipc/APZBridgeParent.cpp", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerParent.cpp", "gfx/layers/ipc/APZChild.cpp", "gfx/layers/ipc/CanvasChild.cpp", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/CanvasTranslator.h", "gfx/layers/ipc/CompositableForwarder.h", "gfx/layers/ipc/CompositableTransactionParent.cpp", "gfx/layers/ipc/CompositableTransactionParent.h", "gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorManagerChild.cpp", "gfx/layers/ipc/CompositorManagerChild.h", "gfx/layers/ipc/CompositorManagerParent.cpp", "gfx/layers/ipc/CompositorThread.cpp", "gfx/layers/ipc/CompositorVsyncScheduler.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ISurfaceAllocator.cpp", "gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/ImageBridgeChild.cpp", "gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/layers/ipc/KnowsCompositor.h", "gfx/layers/ipc/LayerTreeOwnerTracker.cpp", "gfx/layers/ipc/RefCountedShmem.cpp", "gfx/layers/ipc/RemoteContentController.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/layers/ipc/SharedSurfacesChild.cpp", "gfx/layers/ipc/SharedSurfacesChild.h", "gfx/layers/ipc/SharedSurfacesParent.cpp", "gfx/layers/ipc/UiCompositorControllerChild.cpp", "gfx/layers/ipc/UiCompositorControllerParent.cpp", "gfx/layers/ipc/VideoBridgeChild.cpp", "gfx/layers/ipc/VideoBridgeParent.cpp"], "git_node": "ed7b11c6f52bbcb9d94b54c94dc46ae803e180eb", "git_parents": ["ffe19cbab97152794efc1c5568e210ca474a10f9"], "node": "d0f8d9c141db56347261e2a7651b4591072f10d7", "parents": ["78e0af3d9cb918bda35d2f54f0184b96796e152b"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Convert some  assertions to MOZ_RELEASE_ASSERT (part 1). r=gfx-reviewers,bradwerth\n\nConvert MOZ_ASSERT to MOZ_RELEASE_ASSERT for critical graphics resource assertions\nthat must hold even in release builds. These changes address cases where:\n- Output parameters from wr_window_new() must be valid (lines 317, 322, 323)\n- Memory mapping operations must succeed (line 510)\n\nThese cause immediate crashes in release builds if assertions fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333727\n", "files": ["gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "b7814b78584ce8a879e00aeda806c92f9e3ea7c8", "git_parents": ["ed7b11c6f52bbcb9d94b54c94dc46ae803e180eb"], "node": "91ae51664846e8c8833ef2b0da007b6a7d40a970", "parents": ["d0f8d9c141db56347261e2a7651b4591072f10d7"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Convert some resource assertions to MOZ_RELEASE_ASSERT (part 2). r=gfx-reviewers,bradwerth\n\nThese assertions guard critical resources where null would cause crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333728\n", "files": ["gfx/layers/AndroidImageConsumer.cpp", "gfx/vr/VRManager.cpp", "gfx/vr/VRServiceHost.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.cpp", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "3709798008845381d14e3c3b41ff57a6094c39aa", "git_parents": ["b7814b78584ce8a879e00aeda806c92f9e3ea7c8"], "node": "da1c2cf55252cbf8d34af28e40f8619626ded348", "parents": ["91ae51664846e8c8833ef2b0da007b6a7d40a970"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Fix contradictory assertion and upgrade shared memory checks to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nRemove contradictory MOZ_ASSERT in RenderTextureHostWrapper::EnsureTextureHost() that immediately precedes a null check. The null check is the actual guard and is already logging the error.\n\nConvert shared memory assertions to MOZ_RELEASE_ASSERT in VRManager since mShmem is accessed without fallback in the subsequent code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333729\n", "files": ["gfx/vr/VRManager.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp"], "git_node": "d51c592829d5df90648bc098bebd4f5527675612", "git_parents": ["3709798008845381d14e3c3b41ff57a6094c39aa"], "node": "6c0b2d5eb305e1a1c824f170958b04c26def82f8", "parents": ["da1c2cf55252cbf8d34af28e40f8619626ded348"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2081780: apply code formatting via Lando\n\n# ignore-this-changeset\n", 