], "node": "0aea405760479ac49ae51587c0b46b3e45f4c33e", "parents": ["e6d8ee43f077f1885ebceba8e67c1c1974ec37c2"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086021 - Report OOM in recordIonCompilationForHints when recording the Ion hint fails. r=spidermonkey-reviewers,mgaudet\n\nJitHintsMap::recordIonCompilation returns false on allocation failure without reporting an exception, so the testing function returned false with no pending exception.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337311\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/baseline/bug2086021.js"], "git_node": "1446df3b02bf139663ed57060ec003a66abc653b", "git_parents": ["c82de29361989d2216581b0c539f4578769f3c17"], "node": "898e1bedca379aa08929c407141e2765ecc63bce", "parents": ["0aea405760479ac49ae51587c0b46b3e45f4c33e"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2032540 - Part 1: Let the Google Lens upload screen attribute any image source. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334642\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensUploadOverlay.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensUploadViewModel.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensUploadViewModelTest.kt"], "git_node": "359bdd6a53fbf566de94577bc2ef1a5e1de66b59", "git_parents": ["1446df3b02bf139663ed57060ec003a66abc653b"], "node": "7db2a82fa22b530ad8054990ac5207a5929a1e59", "parents": ["898e1bedca379aa08929c407141e2765ecc63bce"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2032540 - Part 2: Show the loading screen while a camera capture uploads to Google Lens. r=android-reviewers,android-l10n-reviewers,parker,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334643\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensUploadOverlay.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraActivityTest.kt"], "git_node": "cefe3000ae1024e3c7c6e6a4ccf8f0c71de8b990", "git_parents": ["359bdd6a53fbf566de94577bc2ef1a5e1de66b59"], "node": "161eb29ea3cb7b9f9f012fa1b5738c450c3543fd", "parents": ["7db2a82fa22b530ad8054990ac5207a5929a1e59"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2032540 - Part 3: Remove the Google Lens host-side camera capture upload. r=android-reviewers,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334644\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/LensFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/LensImageUploader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensImageSearch.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/widget/LensSearchActivity.kt", "mobile/android/fenix/app/src/main/res/layout/activity_lens_search.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/LensFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/LensImageUploaderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensImageSearchTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/widget/LensSearchActivityTest.kt"], "git_node": "4da01eb466c8fcc1020c168706f70f4d81ccd6a9", "git_parents": ["cefe3000ae1024e3c7c6e6a4ccf8f0c71de8b990"], "node": "905469cb6fc751349701994ffccc1eb2f6a679ef", "parents": ["161eb29ea3cb7b9f9f012fa1b5738c450c3543fd"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085797 - Turning off built-in VPN while Work Offline is enabled triggers error - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336889\n", "files": ["browser/components/ipprotection/IPProtectionAlertManager.sys.mjs", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_network_error.js", "toolkit/components/ipprotection/IPPAutoActivation.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/Constants.md"], "git_node": "40f91ed7ce5e14610ae633036b8ce361f2e51f60", "git_parents": ["4da01eb466c8fcc1020c168706f70f4d81ccd6a9"], "node": "b9fd1436ef6bf79e62c5fabf81c26a5b42f68124", "parents": ["905469cb6fc751349701994ffccc1eb2f6a679ef"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086557 - Create new swipe extended toolbar to switch tabs efficiency regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll efficiency UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337549\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsCustomizeExpandedToolbarTest.kt"], "git_node": "f00f580efb290b87aad76f999a9dd8cf2cfe5846", "git_parents": ["40f91ed7ce5e14610ae633036b8ce361f2e51f60"], "node": "f0ce6a1c171496f84e948293d9745868cd443ea4", "parents": ["b9fd1436ef6bf79e62c5fabf81c26a5b42f68124"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086562 - Convert deletingBrowserHistoryClearsRecentlyClosedTabsListTest regression UI test to the efficiency framework r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll efficiency UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337554\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/RecentlyClosedTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/RecentlyClosedTabsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/RecentlyClosedTabsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/TabDrawerSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/RecentlyClosedTabsTest.kt"], "git_node": "60840653952e76c5162e1f55fb539ece863f5715", "git_parents": ["f00f580efb290b87aad76f999a9dd8cf2cfe5846"], "node": "16e04dc5adaa104931ad416492d406421827fa14", "parents": ["f0ce6a1c171496f84e948293d9745868cd443ea4"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2003648 - Symbolicate the simpleperf profiles with samply import --presymbolicate. r=mozperftest-reviewers,aglavic\n\nWe were using profiler-edit.js for symbolication, but this is no longer\nneeded now that samply import supports --presymbolicate. The sp3 profiling\ninfrastructure was already making use of this, but applink startup profiling\nwas not. This patch fixes it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336925\n", "files": ["python/mozperftest/mozperftest/system/simpleperf.py", "python/mozperftest/mozperftest/tests/test_simpleperf.py"], "git_node": "9fcb2321bc16ad74ebca595c5ce2ab165fe35b31", "git_parents": ["60840653952e76c5162e1f55fb539ece863f5715"], "node": "eab848072dd8273882c9796e81bcd2e2f9adc50d", "parents": ["16e04dc5adaa104931ad416492d406421827fa14"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051692 - Replace `Shmem` with `MutableSharedMemoryHandle`. r=webgpu-reviewers,gfx-reviewers,aosmond,ErichDonGubler\n\nAllocating a `Shmem` requires an IPC actor, so snapshot code had to\npass an `IProtocol` through just to create it.\nA `MutableSharedMemoryHandle` doesn't depend on an actor and\nfrees itself. That removes the extra plumbing, and code with no access\nto an actor can now create the memory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309805\n", "files": ["dom/canvas/ClientWebGLContext.cpp", "dom/canvas/WebGLIpdl.h", "dom/canvas/WebGLParent.cpp", "dom/canvas/WebGLParent.h", "dom/canvas/WebGLTypes.h", "dom/webgpu/SharedTexture.h", "dom/webgpu/SharedTextureD3D11.cpp", "dom/webgpu/SharedTextureD3D11.h", "dom/webgpu/SharedTextureDMABuf.cpp", "dom/webgpu/SharedTextureDMABuf.h", "dom/webgpu/SharedTextureMacIOSurface.cpp", "dom/webgpu/SharedTextureMacIOSurface.h", "dom/webgpu/ipc/WebGPUParent.cpp", "dom/webgpu/ipc/WebGPUParent.h", "gfx/ipc/CanvasManagerChild.cpp", "gfx/ipc/CanvasManagerParent.cpp", "gfx/layers/RemoteTextureMap.cpp", "gfx/layers/RemoteTextureMap.h"], "git_node": "cd25cf7a117ec0b27f7ae9751b872f80ec9db52f", "git_parents": ["9fcb2321bc16ad74ebca595c5ce2ab165fe35b31"], "node": "3ded37a3b3b8d52eaab8bf63f3226dfc81aafed0", "parents": ["eab848072dd8273882c9796e81bcd2e2f9adc50d"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051692 - Move creation of shmem for snapshots closer to where data is copied. r=webgpu-reviewers,ErichDonGubler\n\nThe snapshot buffer used to be allocated in `WebGPUParent`, using the\nswapchain descriptor's size and stride, and then passed down.\nEach backend then had to check the size matched and pad the rows.\nNow the code that copied the pixels also allocates the memory itself\nand returns it along with its real size and stride. The size checks\nand row padding are no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309806\n", "files": ["dom/webgpu/FrontBufferSnapshot.h", "dom/webgpu/SharedTexture.h", "dom/webgpu/SharedTextureD3D11.cpp", "dom/webgpu/SharedTextureD3D11.h", "dom/webgpu/SharedTextureDMABuf.cpp", "dom/webgpu/SharedTextureDMABuf.h", "dom/webgpu/SharedTextureMacIOSurface.cpp", "dom/webgpu/SharedTextureMacIOSurface.h", "dom/webgpu/ipc/WebGPUParent.cpp", "dom/webgpu/ipc/WebGPUParent.h", "dom/webgpu/moz.build", "gfx/ipc/CanvasManagerParent.cpp", "gfx/layers/RemoteTextureMap.cpp", "gfx/layers/RemoteTextureMap.h"], "git_node": "0c675df45654ba040526c3d0541221055431dfd9", "git_parents": ["cd25cf7a117ec0b27f7ae9751b872f80ec9db52f"], "node": "d055e92dbac973876e591d2b4fd5c10c7caddabb", "parents": ["3ded37a3b3b8d52eaab8bf63f3226dfc81aafed0"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074838 - Don't split UTF-8 characters when truncating filenames in nsWebBrowserPersist. r=mak\n\nFilenames were truncated by byte count, which could cut a multi-byte\ncharacter in half. The resulting name was invalid UTF-8 and the\nresource was not saved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335644\n", "files": ["dom/tests/browser/browser_persist_filename.js", "dom/webbrowserpersist/nsWebBrowserPersist.cpp"], "git_node": "6b96e521252911df0618f8fb1e4a2af848a386e9", "git_parents": ["0c675df45654ba040526c3d0541221055431dfd9"], "node": "98c9b8ea75bd9f3ccbeca885170d23215a645155", "parents": ["d055e92dbac973876e591d2b4fd5c10c7caddabb"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2083927: Add shared node count constants to a11y perftest head.js r=accessibility-platform-reviewers,eeejay\n\nThis patch removes the raw numbers we were using to control tree size in our perftest tasks. It makes them consts in the perftest head.js file.\n\nWe should audit/standardise these, since we probably don't need them to be different all over. See bug 2083929.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335406\n", "files": ["accessible/tests/browser/performance/browser_addManyIds.js", "accessible/tests/browser/performance/browser_addManyNodes.js", "accessible/tests/browser/performance/browser_bounds.js", "accessible/tests/browser/performance/browser_displayContentsBounds.js", "accessible/tests/browser/performance/browser_implicitRoleARIAExpanded.js", "accessible/tests/browser/performance/browser_panManySVGShapes.js", "accessible/tests/browser/performance/browser_reflowPseudoelements.js", "accessible/tests/browser/performance/browser_removeManySpellingErrors.js", "accessible/tests/browser/performance/head.js"], "git_node": "bb82ad6f97b1cdb2e289e88d0011f91781cc1921", "git_parents": ["6b96e521252911df0618f8fb1e4a2af848a386e9"], "node": "759e33e33aec1cbf187acc312a53c99a66bdc520", "parents": ["98c9b8ea75bd9f3ccbeca885170d23215a645155"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2003906: Create perftest to track recreation cost from CSS Visibility changes r=accessibility-platform-reviewers,mozperftest-reviewers,perftest-reviewers,eeejay,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335407\n", "files": ["accessible/tests/browser/performance/browser_testCSSVisibilityChange.js", "accessible/tests/browser/performance/perftest.toml", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2-ref.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "2fe39bb8b03138c7b61a19a61555f9cf93562b9f", "git_parents": ["bb82ad6f97b1cdb2e289e88d0011f91781cc1921"], "node": "f1091ff2b97b242f6211b06f6ba2f9e1b0015f05", "parents": ["759e33e33aec1cbf187acc312a53c99a66bdc520"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086255 - Remove the gfxFT2Font::ShapeText fallback mechanism for when HarfBuzz fails. r=jfkthame\n\nWhile I'm messing with the definitions, I can remove GetFontEntry and its\nsingular use and put it inline since it's quite simple. It was also moved to\nthe wrong C++ file at some point, so this also makes that not an issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337272\n", "files": ["gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2Fonts.cpp", "gfx/thebes/gfxFT2Fonts.h"], "git_node": "aa89118bf7ea07f7135a3ea3ed321d25bcfab4e6", "git_parents": ["2fe39bb8b03138c7b61a19a61555f9cf93562b9f"], "node": "9b946485c052dcc8e6cc43a9ef6556cb5b14a5e4", "parents": ["f1091ff2b97b242f6211b06f6ba2f9e1b0015f05"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1708261 - Show a focus ring on a dialog's initial focus when it was opened with the keyboard. r=firefox-desktop-core-reviewers ,Gijs\n\nSubDialog hid the focus ring on its initial focus for everyone (bug 1704882), so keyboard users couldn't see where focus went. Openers can now pass the event that made the user open the dialog: the triggeringEvent option of SubDialog.open(), also taken by SubDialogManager.open() and TabDialogBox.open(), or the third argument of gDialogBox.open(), which keeps it with queued dialogs. If that event came from the keyboard, following sourceEvent (e.g. the keypress or \u003ckey\u003e behind a command), the default focus shows the ring, and custom subDialogSetDefaultFocus handlers get it as a second argument, { focusVisible }, which they can pass to focus(). Without an event the ring stays hidden, as before; callers that don't pass one yet are left to a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336753\n", "files": ["browser/base/content/browser.js", "browser/base/content/test/browser-tabdialogs/browser_tabdialogbox_focus.js", "browser/base/content/test/browser-tabdialogs/subdialog.xhtml", "toolkit/modules/SubDialog.sys.mjs"], "git_node": "85054bceace4520774e594edac817fe099ec7e01", "git_parents": ["aa89118bf7ea07f7135a3ea3ed321d25bcfab4e6"], "node": "a1444196d6a3adb47d318059d7192a2343fcf638", "parents": ["9b946485c052dcc8e6cc43a9ef6556cb5b14a5e4"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086219 - Report the keyboard as the input source of panel items activated with Enter or Space. r=dom-core-reviewers,smaug\n\nPanelMultiView activates the selected item on Enter or Space by dispatching mousedown, mouseup and click events to it. Created with the event constructors, their inputSource was MOZ_SOURCE_UNKNOWN, and so was that of the command event the click triggers, so code checking for MOZ_SOURCE_KEYBOARD (moz-button, panel-list, SubDialog) couldn't tell these were keyboard activations. They are now synthesized with Window.synthesizeMouseEvent at the center of the item, with inputSource MOZ_SOURCE_KEYBOARD and the key's modifiers, which also fires the pointer events and the click like a real activation. As the event goes to the element under that point, the inner button of a moz-button no longer has to be targeted by hand.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337259\n", "files": ["browser/components/customizableui/PanelMultiView.sys.mjs", "browser/components/customizableui/test/browser_PanelMultiView_keyboard.js"], "git_node": "388229ff49110b571ed16e33f1f9215df62bb497", "git_parents": ["85054bceace4520774e594edac817fe099ec7e01"], "node": "cb4281542880a4d4b97912b96144fbd3eeb22127", "parents": ["a1444196d6a3adb47d318059d7192a2343fcf638"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup additional preferences test that relies on SRD pref being false r=akulyk,settings-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336272\n", "files": ["browser/components/preferences/tests/permissions/browser_notifications_pane.js"], "git_node": "d2a4bf91bd3de62a42a94d74324b3b6386658ebe", "git_parents": ["388229ff49110b571ed16e33f1f9215df62bb497"], "node": "875b99292e4ce44e7257fa81059810063d6e2e39", "parents": ["cb4281542880a4d4b97912b96144fbd3eeb22127"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup search and urlbar tests that rely on the SRD pref being false r=urlbar-reviewers,search-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336273\n", "files": ["browser/components/search/test/browser/browser_contentSearch.js", "browser/components/search/test/browser/browser_hiddenOneOffs_diacritics.js", "browser/components/search/test/browser/browser_searchbar_openpopup.js", "browser/components/urlbar/tests/browser-search/browser_oneOffs.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/unit/test_UrlbarSearchUtils.js", "browser/components/urlbar/tests/unit/test_providerTabToSearch.js", "toolkit/components/search/tests/xpcshell/test_hideOneOffButton.js", "toolkit/components/search/tests/xpcshell/test_settings_migration_hideOneOffs.js", "toolkit/components/search/tests/xpcshell/test_telemetry_installed_engine_counts.js", "toolkit/components/search/tests/xpcshell/xpcshell.toml"], "git_node": "add77735c5d31553bbfd7dc4207004f035ac7ffa", "git_parents": ["d2a4bf91bd3de62a42a94d74324b3b6386658ebe"], "node": "87356df784dd72546cd9b3c94cac5ecda1c7a299", "parents": ["875b99292e4ce44e7257fa81059810063d6e2e39"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup translations tests that rely on the SRD pref being false r=translations-reviewers,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336274\n", "files": ["browser/components/translations/tests/browser/browser.toml", "browser/components/translations/tests/browser/browser_translations_about_preferences_manage_downloaded_languages.js", "browser/components/translations/tests/browser/browser_translations_about_settings_main_page_offer_checkbox.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_a11y.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_basic.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_modify.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_observe.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_default.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_download_langs_basic.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_download_langs_sorting.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_never_translate_langs_a11y.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_never_translate_langs_basic.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_never_translate_langs_modify.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_never_translate_langs_observe.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_never_translate_sites_basic.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_never_translate_sites_observe.js", "browser/components/translations/tests/browser/browser_translations_full_page_panel_gear.js", "browser/components/translations/tests/browser/browser_translations_select_panel_settings_menu.js", "browser/components/translations/tests/browser/browser_translations_select_telemetry_settings_menu.js", "toolkit/components/translations/tests/browser/shared-head.js"], "git_node": "0b36f0f2066f2c6d7b3dd972eb70c01a2af24fca", "git_parents": ["add77735c5d31553bbfd7dc4207004f035ac7ffa"], "node": "99bee4b70907e31684349f4dfea449cd9355f83e", "parents": ["87356df784dd72546cd9b3c94cac5ecda1c7a299"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup enterprisepolicies tests that rely on the SRD pref being false r=jneuberger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336275\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_app_auto_update.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_background_app_update.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_buttons.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_masterpassword.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_popup_blocker.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_popup_blocker_locked.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_profile_import.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_downloads.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_masterpassword.js", "browser/components/enterprisepolic