chitests/test_peerConnection_glean.html", "dom/network/UDPSocketParent.cpp", "dom/webtransport/api/WebTransportSendStream.cpp", "ipc/docs/processes.md", "netwerk/base/nsIOService.cpp", "netwerk/docs/necko_lingo.md", "netwerk/socket/neqo_glue/src/lib.rs", "security/manager/ssl/nsNSSComponent.cpp", "security/sandbox/linux/SandboxFilter.cpp", "taskcluster/kinds/web-platform-tests/kind.yml", "toolkit/components/glean/docs/dev/ipc.md", "toolkit/components/glean/ipc/FOGIPC.h", "toolkit/components/glean/xpcom/nsIFOG.idl", "toolkit/crashreporter/docs/index.md"], "git_node": "1298e77b1c0f3e8cfcacbe5d1b557deaeb11807f", "git_parents": ["1ea5298550645f0a1cee6ab42073f038dc3af651"], "node": "2c032e405d58954cd819179bfac6466b7f8034ed", "parents": ["018c55895d48ea9bad0613569a44a3a5234a6271"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080015 - Add a Fluent string for the Wrexham wallpaper. r=fluent-reviewers,nina-py,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337756\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "15931e4314f422b87c0a18ec55b53500970ce9b8", "git_parents": ["1298e77b1c0f3e8cfcacbe5d1b557deaeb11807f"], "node": "9b4c60c371f6e86f2933300622c0e3fdf87b6bd1", "parents": ["2c032e405d58954cd819179bfac6466b7f8034ed"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081338 - Allow privacy widget to render in HNT sidebar r=reemhamz\n\nThe sidebar only holds one widget, so `resolveSidebarWidget` picks the\nfirst enabled \"small\" widget with sidebar placement in the order from the\nregistry, and the row and layout helpers leave that widget out. Weather\ncomes first, so it keeps the slot unless an experiment turns its\nplacement off.\n\nThe privacy widget's `trainhopSidebarKey` was scoped to bug 2081343,\nbut is landing here because without it, weather is the only widget\nthat can actually reach the sidebar, so there'd be no way to test the\nbehavior added in this patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334746\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsSidebar.jsx", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsSidebar.test.jsx"], "git_node": "904bd626d863b8e5f201195e2b955877c45430bb", "git_parents": ["15931e4314f422b87c0a18ec55b53500970ce9b8"], "node": "2d6e1cabe46b528de22128691841d0d8fbf88731", "parents": ["9b4c60c371f6e86f2933300622c0e3fdf87b6bd1"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084381 - Ensure early \"events\" pings don't clear recorded Glean events before session restore tests can read them. r=sessionstore-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337218\n", "files": ["browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/session_store_test_case.py"], "git_node": "0bd9abfbe9eb6a9b72a2c7afea3e744cf5ae38ec", "git_parents": ["904bd626d863b8e5f201195e2b955877c45430bb"], "node": "6872097ca072d1cd5f7dfd087d799b0b1ef0380b", "parents": ["2d6e1cabe46b528de22128691841d0d8fbf88731"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084984 - Increase sidebar width to accommodate non-overlay scrollbars with vertical tabs r=emilio,spohl,desktop-theme-reviewers,tabbrowser-reviewers,sidebar-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336268\n", "files": ["browser/components/sidebar/sidebar-main.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "c0e8cca06c087722d64fab8d7b77fbe076493e0c", "git_parents": ["0bd9abfbe9eb6a9b72a2c7afea3e744cf5ae38ec"], "node": "5934eb17224827f4d8206b0acd9725cd39b6cac7", "parents": ["6872097ca072d1cd5f7dfd087d799b0b1ef0380b"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087102 - Update data usage progress bar to show the \"remaining\" data instead of the \"used\" data r=corentin,titouan,roger\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/424\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/IPProtectionScreenTest.kt"], "git_node": "ce43cd7b5444cdc5ca78db4bbca672515a9f37b5", "git_parents": ["c0e8cca06c087722d64fab8d7b77fbe076493e0c"], "node": "348ae08567f1a0bb9b759c25cf9b4f5632127be2", "parents": ["5934eb17224827f4d8206b0acd9725cd39b6cac7"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2085027 - Avoid skipping extension-discarded tabs on close r=extension-reviewers,sessionstore-reviewers,tabbrowser-reviewers,jswinarton,robwu\n\nWhen the user manually unloads a tab, we style the tab accordingly and also skip\nit (where possible) when deciding which tab to switch to from a closed tab, to\navoid unnecessarily loading the tab again.\n\nWhen a browser extension discards a tab, we style it accordingly too, but we\n_don't_ always want to skip it when switching from a closed tab. That is because\nsome browser extensions aggressively discard non-active tabs, and so skipping\npast them all would be jarring.\n\nLet's distinguish between discarded tabs that should be skipped, and those that\nshouldn't. For now, let's consider all extension-discarded tabs as being the\nlatter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337301\n", "files": ["browser/components/extensions/parent/ext-tabs.js", "browser/components/extensions/test/browser/browser_ext_tabs_discard.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/docs/lazy-browsers.md", "browser/components/tabbrowser/test/browser/tabs/browser_discardBrowser_discarded_attribute.js", "browser/components/tabbrowser/test/browser/tabs/browser_discarded_tab_move.js", "browser/components/tabbrowser/test/browser/tabs/browser_selectMRUOnClose.js"], "git_node": "263623c80a5f6e622a2a74c804982dbd8cbe6c52", "git_parents": ["ce43cd7b5444cdc5ca78db4bbca672515a9f37b5"], "node": "baf3746916332096680b980aa3f19175635d24a9", "parents": ["348ae08567f1a0bb9b759c25cf9b4f5632127be2"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\naf -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nan -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nar -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nast -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\naz -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbe -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbg -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbn -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbo -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbqi -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbr -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbrx -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nbs -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nca -\u003e 9731881df5f0c033e654ef7c12c7ef6d6