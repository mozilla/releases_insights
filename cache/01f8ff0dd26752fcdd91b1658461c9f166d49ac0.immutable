3e39f2305225e47c4764", "6ab618d9c024c38f0a340f30e5c089926ff7f565", "049daa5c426a12cb0ab7b1035ab7790178435f7f", "ed5bb545f6486d2b67375baf928454d4f97637ca", "6d7e0f320698b11c02e1e0f73591a8501a5b906d", "f16a298ee2d60967c71e9ba78087c2261093abbc", "a3639ca8fe1089008b4afb910e830843f9b1fd0c", "ef0aa668c37b8dd26c0098a03c17fa58387be202", "9968c150907c7ffa4df5f047fe6969d0fddc86e5", "59732023eb8c7c6569c194148b6979adf502c3da", "f0755bc4632771e4b02809a1d1fb90394f643e7a", "498f71dc1c8d88217514b930c721585995d7bca4", "7d21ff54b26fc0c3a6297a2551c0e54e86546d32", "55c6e5375e0402e4696a63dd7936e045925ae4e2", "97e9c3f71f7512fb61aecc0c80a1eadb9e531fa6", "cf03f3b526f01b662e61d5a014bea445c494512b", "99c6b0c294fafb6d6fb75c65cc3aa7185166bf01", "f80cd0d9a75469a61a29b7e1d8b5372f8408ed70", "a1c5b1ddb642dcef5c8ebc0f3dfa81227f0b704b", "017c2574ad0f69cc80ed2bf0817a4eb2f51373a9", "9cb906b8fc3c775f2e2226a1605b688392151e6a", "2b2632018ce61e6dd2fe822d62075e4921337250", "db24d5cc3efa37955ca96b74654fa761390791e2", "77a024e5701e86f92c9c8b66f2c120e2a9b8b425", "747ca4deb7f587111f9be583bd638e20b4847044", "fb8603ede880c82b652beba23e8496e18c704738", "cf103b9362d64aa14c7adc0c0e4b9469ccbf6caa"], "user": "sstanca@mozilla.com"}, "45723": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2085820 - Skip the unmark gray call in JSStackFrame::UnregisterAndClear(). r=jonco,dom-core-reviewers,smaug\n\nUnregisterAndClear() is called when the JSStackFrame is unlinked or destroyed.\nThe read barrier on mStack means that we call unmark gray on it, which can be\nexpensive because odds are the stack is entirely gray if we're destroying things.\nWe are not actually touching the JS object itself here (instead, we are only removing\nourselves from a hash table on the realm private) so it is safe to skip the\nbarrier.\n\nIn a profile of some aiwindow browser chrome tests, this accounted for\nabout 100ms of time spent in FreeSnowWhite, or around 3% of the total\nCC time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336797\n", "files": ["dom/bindings/Exceptions.cpp"], "git_node": "02fb42df43718787beebada027f2066de43ab167", "git_parents": ["cf103b9362d64aa14c7adc0c0e4b9469ccbf6caa"], "node": "7d1ff1b0cb0cd47e27151084417c06574fc5cf19", "parents": ["644aed45371aec895a87138518eeb8e4849c95fd"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086928 - Make IconResourceComparator a consistent total order. r=mcarare,android-reviewers\n\nThe compare function tried to treat same URL as comparing the same, but due to\nattributes they may compare inconsistently with non-matching URLs which can\nlead to exceptions in the sort function.  Move the same-url check to the caller\ninstead.\n\nHistorical code when comparator was written used a TreeSet that automatically\ndeduped items that compared 0 so it wasn't impacted. When we switched to the\nsequence/distinct version we introduced crash.\n\nThis change also avoid potential duplicate downloads of same URL with different\nattributes. Only one copy was meaningfully consumed in both original and fixed\nversions of the code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338063\n", "files": ["mobile/android/android-components/components/browser/icons/src/main/java/mozilla/components/browser/icons/BrowserIcons.kt", "mobile/android/android-components/components/browser/icons/src/main/java/mozilla/components/browser/icons/pipeline/IconResourceComparator.kt", "mobile/android/android-components/components/browser/icons/src/test/java/mozilla/components/browser/icons/pipeline/IconResourceComparatorTest.kt"], "git_node": "b7051b094b62d2425a705000f613558cf6b5b05a", "git_parents": ["02fb42df43718787beebada027f2066de43ab167"], "node": "a6b776edbc19111f3da1f8ff5aaa75dfb6864211", "parents": ["7d1ff1b0cb0cd47e27151084417c06574fc5cf19"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088489 - Update KSP to version 2.3.13. r=android-reviewers,android-build-system-reviewers,ahochheiden,mcarare\" for causing fenix failures @SwitchTabsBaselineProfileGenerator.\n\nThis reverts commit 22c4faf7bf08dfd061ace31dd0d6e2e6bf0012e6.\n", "files": ["gradle/libs.versions.toml"], "git_node": "30fbd4a0ef699adf283d519cd2f3092810b207ea", "git_parents": ["b7051b094b62d2425a705000f613558cf6b5b05a"], "node": "94c224e5fec6a0cd0fd93f49562cda43dbce5181", "parents": ["a6b776edbc19111f3da1f8ff5aaa75dfb6864211"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt1. Introduce MASM ops to make indirect targets explicit r=jandem,iain\n\nIntroduce the indirectTarget MASM operation to explicitly label indirect\ntargets emitted by JIT code. Currently this is a no-op, but it can be used\nin the future to easily insert code before/after all indirect targets.\n\nA use-case for this is emitting the landing-pad instructions required by\nhardware enforced forward-edge control-flow integrity like IBT (endbr64)\non x86_64 and BTI (bti) on ARM64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335462\n", "files": ["js/src/jit/Ion.cpp", "js/src/jit/JitRuntime.h", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/none/MacroAssembler-none.h", "js/src/jit/shared/Assembler-shared.h", "js/src/jit/wasm32/MacroAssembler-wasm32.h"], "git_node": "1769d1307fe48e49d205180e9127ffa9e4d52edc", "git_parents": ["30fbd4a0ef699adf283d519cd2f3092810b207ea"], "node": "acfd913f863a1b278290a96ec6e9e0566fc8119d", "parents": ["94c224e5fec6a0cd0fd93f49562cda43dbce5181"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt2. Annotate indirect targets in Baseline JIT, Interpreter and ICs r=jandem,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335463\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineIC.cpp"], "git_node": "f4802046078ca19a9de5ebc8597483aa73cca26a", "git_parents": ["1769d1307fe48e49d205180e9127ffa9e4d52edc"], "node": "46379fbd6c4a7c1dc6d9b55f37bb51a3a9599ebe", "parents": ["acfd913f863a1b278290a96ec6e9e0566fc8119d"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt3. Annotate indirect targets for BaselineDebugModeOSR resume points r=iain,jandem\n\nExecution may resume in the Baseline Interpreter or a Baseline Script at return sites\ncorresponding to specific RetAddrEntry Kinds due to BaselineDebugModeOSR. These sites need\nto be marked as valid indirect jump targets. In the case of Baseline compiled scripts,\nthis is only required if recompilation (with or without debug instrumentation) was triggered\nby DebugOSR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335464\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineCompileTask.h", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h"], "git_node": "adecbd322d5ccf446ecb9b8ca70d9452b9d2d120", "git_parents": ["f4802046078ca19a9de5ebc8597483aa73cca26a"], "node": "33808b63e400a0d911afeec52ea0a3f9d8907895", "parents": ["46379fbd6c4a7c1dc6d9b55f37bb51a3a9599ebe"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt4. Annotate indirect targets in Ion/IonICs r=iain,jandem\n\n- Ion and lowers MTableSwitch to a jump table, and dispatches to case blocks\nthrough an indirect jump. To mark annotate these as targets, LBlock gets an\nisIndirectJumpTarget flag, which visitTableSwitch sets during lowering.\n- Since codegen skips trivial blocks, these annotations must be propagated to\nthe actual non-trivial block corresponding to switch targets. A new\nPropagateIndirectJumpTargets pass does this just before code generation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335465\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/Ion.cpp", "js/src/jit/IonCacheIRCompiler.cpp", "js/src/jit/LIR.cpp", "js/src/jit/LIR.h", "js/src/jit/Lowering.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/CodeGenerator-shared.h"], "git_node": "c91c3fec9997cf5feee7c64bcab281d77a70a3d1", "git_parents": ["adecbd322d5ccf446ecb9b8ca70d9452b9d2d120"], "node": "7705133a87c7b3699b7c465584fbb760ea3b0ff2", "parents": ["33808b63e400a0d911afeec52ea0a3f9d8907895"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt5. Annotate indirect targets in JIT trampolines/stubs and RegExp compilation r=jandem,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335466\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/InterpreterEntryTrampoline.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/Trampoline.cpp", "js/src/jit/TrampolineNatives.cpp", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/Trampoline-arm64.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x64/Trampoline-x64.cpp"], "git_node": "e7570383ca838e765d4dcc26ec3e9ff437b59d49", "git_parents": ["c91c3fec9997cf5feee7c64bcab281d77a70a3d1"], "node": "9e17f95152690b2f7c57bdf172609a93f75ec141", "parents": ["7705133a87c7b3699b7c465584fbb760ea3b0ff2"], "tags": []}, {"author": "any1here \u003cany1here@duck.com\u003e", "branch": "default", "desc": "Bug 2086923 - Keep window open when moving the last tab to a saved group r=tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337855\n", "files": ["browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tabContextMenu.js"], "git_node": "bf5269d1fa95c051a3523257e7a181779038b84e", "git_parents": ["e7570383ca838e765d4dcc26ec3e9ff437b59d49"], "node": "1abed8679e6922b8ee2ef117d351fc6c6a6bc035", "parents": ["9e17f95152690b2f7c57bdf172609a93f75ec141"], "tags": []}, {"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2084671 - Fix HNT card stack overlap with Add Shortcut button r=emcminn,ini\n\n- Case: 6 columns, 2 rows max, and 6 shortcuts so top row is full\n- The in-grid Add Shortcut button wraps to the second line with min-height\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338049\n", "files": ["browser/extensions/newtab/content-src/components/TopSites/_TopSites.scss", "browser/extensions/newtab/test/jest/content-src/components/TopSites/TopSite.test.jsx"], "git_node": "a084261133ac3b99556df689aeb0b2ed4ac73050", "git_parents": ["bf5269d1fa95c051a3523257e7a181779038b84e"], "node": "4a51ded6e3d5daec9443a247ab35c74ef4fd3962", "parents": ["1abed8679e6922b8ee2ef117d351fc6c6a6bc035"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083731 - Load urlbar quick actions from messaging system r=mimi,daleharvey,omc-reviewers,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334679\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/schemas/make-schemas.py", "browser/components/asrouter/content-src/templates/OnboardingMessage/UrlbarAction.schema.json", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/moz.build", "browser/components/asrouter/tests/xpcshell/head.js", "browser/components/urlbar/ActionsProvider.sys.mjs", "browser/components/urlbar/ActionsProviderQuickActions.sys.mjs", "browser/components/urlbar/QuickActionsLoaderMessaging.sys.mjs", "browser/components/urlbar/UrlbarProviderActionsSearchMode.sys.mjs", "browser/components/urlbar/UrlbarProviderGlobalActions.sys.mjs", "browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-quickactions/browser.toml", "browser/components/urlbar/tests/browser-quickactions/browser_messaging_actions.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_support_page.js", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "a09081379462bf0aec3538d333cc4d7847e70f39", "git_parents": ["a084261133ac3b99556df689aeb0b2ed4ac73050"], "node": "1812df69bd6fc1483db0025cabd8fb6777839996", "parents": ["4a51ded6e3d5daec9443a247ab35c74ef4fd3962"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080879 - Update tooltips for sidebar panel items r=fxview-reviewers,sidebar-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339224\n", "files": ["browser/components/firefoxview/HistoryController.sys.mjs", "browser/components/firefoxview/SyncedTabsController.sys.mjs", "browser/components/sidebar/sidebar-bookmark-list.mjs", "browser/components/sidebar/sidebar-tab-list.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js", "browser/components/sidebar/tests/browser/browser_history_sidebar.js", "browser/components/sidebar/tests/browser/browser_opentabs_sidebar.js", "browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar.js", "browser/components/sidebar/tests/browser/head.js"], "git_node": "f8c25c1173a75a4a3615402e4fca1957c558202c", "git_parents": ["a09081379462bf0aec3538d333cc4d7847e70f39"], "node": "c8795066d66992796310b2f3de52aa3ab616af8b", "parents": ["1812df69bd6fc1483db0025cabd8fb6777839996"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088701 - Hide the legacy search widget from picker r=android-reviewers,twhite,tthibaud\n\nHide the legacy widget from the widget picker without removing the underlying logic so the widget does not break for existing users but new users can't see it. We have added 3 new Glance widgets and should move away from the legacy widget.\n\n{F85148462}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339339\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/AddSearchWidgetPrompt.kt", "mobile/android/fenix/app/src/main/res/xml/search_widget_info.xml"], "git_node": "e955980d49fe27706dd046777f6e03be42edcfff", "git_parents": ["f8c25c1173a75a4a3615402e4fca1957c558202c"], "node": "b62cd6a4923e4a8f799df8eb70771296f7b28e08", "parents": ["c8795066d66992796310b2f3de52aa3ab616af8b"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1943629 - Avoid per-element style flushes and restyles when setting up media controls r=kpatenio\n\nCache control widths by CSS property and touch mode so repeated setup does\nnot interleave document-wide computed-style flushes with DOM writes.\n\nCache parsed widget templates per document and markup identifier, including\nthe keyboard tab preference for full controls. Import a clone for each\ninstance instead of parsing the same markup for every media element.\n\nSkip creating throwaway animations for immediate fades. Initialize audio\ncontrols to layout's 300px fallback intrinsic width to avoid a redundant\nrestyle and reflow on the first resizevideocontrols event.\n\nAdd a mochitest checking restyle counts when setting up many media elements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336838\n", "files": ["toolkit/content/tests/widgets/mochitest.toml", "toolkit/content/tests/widgets/test_videocontrols_setup_restyles.html", "toolkit/content/widgets/videocontrols.js"], "git_node": "425617fb57793900b9ffaf375a1581958b8c0269", "git_parents": ["e955980d49fe27706dd046777f6e03be42edcfff"], "node": "60cfd2ca2faddba4a0fe5642798a2ec8e0ba9a98", "parents": ["b62cd6a4923e4a8f799df8eb70771296f7b28e08"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088997 - Part 1: Give mochitest-browser-chrome on the macOS tart VMs 5400s of max-run-time. r=aryx\n\nSince bug 2084943 landed, about a third of the VM browser-chrome jobs killed at\nmax-run-time never hung: the slowest of the VM chunks just run past 3600s.\nRaise it to 5400s for the VM opt platforms, matching debug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339586\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "83c3eeb1bf9c33f74a45c7799007cbe5f4c99b3c", "git_parents": ["425617fb57793900b9ffaf375a1581958b8c0269"], "node": "2bd1cd01a1b07a9b12e9bbafcf39bbadd9fe352a", "parents": ["60cfd2ca2faddba4a0fe5642798a2ec8e0ba9a98"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2088160 - Render clip-path polygon() with WebRender path clips. r=firefox-svg-reviewers,longsonr\n\nWhen gfx.webrender.paths is enabled, polygon() clip paths are recorded with WrPathRecorder like path() and shape() instead of being painted into a mask image.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338802\n", "files": ["gfx/layers/apz/test/mochitest/helper_hittest_clippath.html", "gfx/layers/apz/test/mochitest/test_group_fission.html", "gfx/layers/apz/test/mochitest/test_group_touchevents-7.html", "layout/painting/nsDisplayList.cpp", "layout/svg/SVGUtils.cpp", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-fill.html.ini"], "git_node": "493819b4d1a88d02ee3de861adca0acdb3aef89e", "git_parents": ["83c3eeb1bf9c33f74a45c7799007cbe5f4c99b3c"], "node": "6363c88d8571982c991635660653dd986b23ea4d", "parents": ["2bd1cd01a1b07a9b12e9bbafcf39bbadd9fe352a"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088979 - Remove the 48dp min height from the Terms of Use onboarding button. r=gela\n\nThe design height is 40dp, matching the other onboarding pages. The Material 3 Button already provides a 48dp touch target via minimumInteractiveComponentSize, so the explicit minimum only changed the visual size.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/432\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/TermsOfServiceOnboardingPage.kt"], "git_node": "f8243c6fd75b3f30f332c376019760026fc5369c", "git_parents": ["493819b4d1a88d02ee3de861adca0acdb3aef89e"], "node": "a8cb2ff85335ec62300247c65daf4636d2c5a97a", "parents": ["6363c88d8571982c991635660653dd986b23ea4d"], "tags": []}, {"author": "SaaSha Pina \u003csaasha@heysparkbox.com\u003e", "branch": "default", "desc": "Bug 2059041 - Migrate Code Connect templates to the Template API r=mkennedy,frontend-codestyle-reviewers\n\nMigrate in-tree `.figma.ts` files to the Template API, add `toolkit/figma.config.json`,\nand document publish/create from the repository root. Register `figma.config.json` for\nBugzilla file metadata and use `import-x` in the figma ESLint config block.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317072\n", "files": ["browser/components/storybook/docs/README.figma-code-connect.stories.md", "eslint-ignores.config.mjs", "eslint.config.mjs", "toolkit/content/widgets/moz-badge/moz-badge-desktop-v3.figma.ts", "toolkit/content/widgets/moz-badge/moz-badge.figma.ts", "toolkit/content/widgets/moz-box-button/moz-box-button-desktop-v3.figma.ts", "toolkit/content/widgets/moz-box-button/moz-box-button.figma.ts", "toolkit/content/widgets/moz-box-group/moz-box-group-desktop-v3.figma.ts", "toolkit/content/widgets/moz-box-group/moz-box-group.figma.ts", "toolkit/content/widgets/moz-box-item/moz-box-item-desktop-v3.figma.ts", "toolkit/content/widgets/moz-box-item/moz-box-item.figma.ts", "toolkit/content/widgets/moz-box-link/moz-box-link-desktop-v3.figma.ts", "toolkit/content/widgets/moz-box-link/moz-box-link.figma.ts", "toolkit/content/widgets/moz-button-group/moz-button-group-desktop-v3.figma.ts", "toolkit/content/widgets/moz-button-group/moz-button-group.figma.ts", "toolkit/content/widgets/moz-button/moz-button-desktop-v3.figma.ts", "toolkit/content/widgets/moz-button/moz-button-icon-desktop-v3.figma.ts", "toolkit/content/widgets/moz-button/moz-button-icon.figma.ts", "toolkit/content/widgets/moz-button/moz-button-split.figma.ts", "toolkit/content/widgets/moz-button/moz-button-toolbar.figma.ts", "toolkit/content/widgets/moz-button/moz-button.figma.ts", "toolkit/content/widgets/moz-card/moz-card-desktop-v3.figma.ts", "toolkit/content/widgets/moz-card/moz-card-heading-desktop-v3.figma.ts", "toolkit/content/widgets/moz-card/moz-card-heading.figma.ts", "toolkit/content/widgets/moz-card/moz-card.figma.ts", "toolkit/content/widgets/moz-checkbox/moz-checkbox-desktop-v3.figma.ts", "toolkit/content/widgets/moz-checkbox/moz-checkbox.figma.ts", "toolkit/content/widgets/moz-fieldset/moz-fieldset-desktop-v3.figma.ts", "toolkit/content/widgets/moz-fieldset/moz-fieldset.figma.ts", "toolkit/content/widgets/moz-five-star/moz-five-star-desktop-v3.figma.ts", "toolkit/content/widgets/moz-five-star/moz-five-star.figma.ts", "toolkit/content/widgets/moz-input-color/color-picker-desktop-v3.figma.ts", "toolkit/content/widgets/moz-input-color/color-picker.figma.ts", "toolkit/content/widgets/moz-input-password/moz-input-password-desktop-v3.figma.ts", "toolkit/content/widgets/moz-input-password/moz-input-password.figma.ts", "toolkit/content/widgets/moz-input-search/moz-input-search-desktop-v3.figma.ts", "toolkit/content/widgets/moz-input-search/moz-input-search.figma.ts", "toolkit/content/widgets/moz-input-text/moz-input-text-desktop-v3.figma.ts", "toolkit/content/widgets/moz-input-text/moz-input-text.figma.ts", "toolkit/content/widgets/moz-label/moz-label-desktop-v3.figma.ts", "toolkit/content/widgets/moz-label/moz-label.figma.ts", "toolkit/content/widgets/moz-message-bar/moz-message-bar-desktop-v3.figma.ts", "toolkit/content/widgets/moz-message-bar/moz-message-bar.figma.ts", "toolkit/content/widgets/moz-page-nav/moz-page-nav-button-desktop-v3.figma.ts", "toolkit/content/widgets/moz-page-nav/moz-page-nav-button.figma.ts", "toolkit/content/widgets/moz-page-nav/moz-page-nav-desktop-v3.figma.ts", "toolkit/content/widgets/moz-page-nav/moz-page-nav.figma.ts", "toolkit/content/widgets/moz-promo/promo-desktop-v3.figma.ts", "toolkit/content/widgets/moz-promo/promo.figma.ts", "toolkit/content/widgets/moz-radio-group/moz-radio-desktop-v3.figma.ts", "toolkit/content/widgets/moz-radio-group/moz-radio.figma.ts", "toolkit/content/widgets/moz-select/moz-select-dropdown-desktop-v3.figma.ts", "toolkit/content/widgets/moz-select/moz-select-dropdown.figma.ts", "toolkit/content/widgets/moz-select/moz-select-menu-item-desktop-v3.figma.ts", "toolkit/content/widgets/moz-select/moz-select.figma.ts", "toolkit/content/widgets/moz-toggle/moz-toggle-desktop-v3.figma.ts", "toolkit/content/widgets/moz-toggle/moz-toggle.figma.ts", "toolkit/content/widgets/panel-list/panel-item-desktop-v3.figma.ts", "toolkit/content/widgets/panel-list/panel-item.figma.ts", "toolkit/content/widgets/panel-list/panel-list-desktop-v3.figma.ts", "toolkit/content/widgets/panel-list/panel-list.figma.ts", "toolkit/figma.config.json", "toolkit/moz.build"], "git_node": "8d3d056424e543bd275e6893c3f13cb165524088", "git_parents": ["f8243c6fd75b3f30f332c376019760026fc5369c"], "node": "a98662e17d3a4198745ef1345ea40be97d3645db", "parents": ["a8cb2ff85335ec62300247c65daf4636d2c5a97a"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088129 - Fix minor alignment issues with text selection menu. r=desktop-theme-reviewers,tabbrowser-reviewers,echa,jswinarton,tgiles\n\nFor background on the Highlight to Search project, here is [the current spec](https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe).\n\nTo manually experiment with this feature, here is [the UX prototype](https://searchux.netlify.app/highlight-to-search/).\n\nWith the feature gate on, the icons in the three-dot menu are centered in the end of each row with the label starting at its edge, the switches sit the same distance from the end of the row as from its top, the menu is wider so there is room after the Manage settings text, and that text is no longer bold.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338817\n", "files": ["browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "f21bdce242cf7999a87c693420167828ad530056", "git_parents": ["8d3d056424e543bd275e6893c3f13cb165524088"], "node": "e8527f5ce1f6c339027ed73df1034957ed6a7c4b", "parents": ["a98662e17d3a4198745ef1345ea40be97d3645db"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083731 - Load urlbar quick actions from messaging system r=mimi,daleharvey,omc-reviewers,urlbar-reviewers\" for causing python failures.\n\nThis reverts commit a09081379462bf0aec3538d333cc4d7847e70f39.\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/schemas/make-schemas.py", "browser/components/asrouter/content-src/templates/OnboardingMessage/UrlbarAction.schema.json", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/moz.build", "browser/components/asrouter/tests/xpcshell/head.js", "browser/components/urlbar/ActionsProvider.sys.mjs", "browser/components/urlbar/ActionsProviderQuickActions.sys.mjs", "browser/components/urlbar/QuickActionsLoaderMessaging.sys.mjs", "browser/components/urlbar/UrlbarProviderActionsSearchMode.sys.mjs", "browser/components/urlbar/UrlbarProviderGlobalActions.sys.mjs", "browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-quickactions/browser.toml", "browser/components/urlbar/tests/browser-quickactions/browser_messaging_actions.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_support_page.js", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "3cd27fadffe8a6b85b5f213cf6709eb8deec91af", "git_parents": ["f21bdce242cf7999a87c693420167828ad530056"], "node": "ec602a2219688084da1a862830d66975a877599e", "parents": ["e8527f5ce1f6c339027ed73df1034957ed6a7c4b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087325 - Don't force layout initialization of subdocuments. r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339173\n", "files": ["dom/base/Document.cpp"], "git_node": "622b2d7058c7822e712e671979198b7977343bd8", "git_parents": ["3cd27fadffe8a6b85b5f213cf6709eb8deec91af"], "node": "faa772298db8557df9ea44c52505f59367650b82", "parents": ["ec602a2219688084da1a862830d66975a877599e"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2085895 - Normalize URL paths before matching WebsiteFilter patterns. r=mkolodziej\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339559\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_websitefilter.js"], "git_node": "98b755ba48f9b27e36e0ea07c4c123259f01d2b9", "git_parents": ["622b2d7058c7822e712e671979198b7977343bd8"], "node": "53b621977444b307c3337d2e62412983054a2c04", "parents": ["faa772298db8557df9ea44c52505f59367650b82"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1945032 - Perform visibility checks on HTML elements with accesskeys in the chrome r=masayuki,mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321562\n", "files": ["dom/events/EventStateManager.cpp", "dom/events/test/chrome.toml", "dom/events/test/mochitest.toml", "dom/events/test/test_accesskey_visibility.html", "dom/events/test/test_accesskey_visibility_content.html", "toolkit/content/tests/widgets/lit-test-helpers.js", "toolkit/content/tests/widgets/test_moz_box_button.html"], "git_node": "c2c34d12c1212c466d9e5b5ce8bf9166e0fc24a4", "git_parents": ["98b755ba48f9b27e36e0ea07c4c123259f01d2b9"], "node": "f7c8ec16a01afcc37f5bb3189222d9feb75f361f", "parents": ["53b621977444b307c3337d2e62412983054a2c04"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942186 - Add automatic Fluent support for moz-button accesskeys r=mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321563\n", "files": ["accessible/tests/browser/events/browser_test_panel.js", "toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/widgets/moz-button/moz-button.mjs", "toolkit/content/widgets/moz-button/moz-button.stories.mjs"], "git_node": "ea3fcef0a8f2f549a3ad4b0dfd12c4c9b6b44c86", "git_parents": ["c2c34d12c1212c466d9e5b5ce8bf9166e0fc24a4"], "node": "8ed463cce55b3445db74edc26414b3ba983dd31d", "parents": ["f7c8ec16a01afcc37f5bb3189222d9feb75f361f"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942186 - Part 2: clean up existing usage of data-l10n-attrs='accesskey' on moz-button r=mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321564\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/components/preferences/widgets/sync-device-name/sync-device-name.mjs", "toolkit/content/net-error-card.mjs", "toolkit/content/widgets/moz-input-folder/moz-input-folder.mjs"], "git_node": "66f05fef7447125088beb73740654768ba3fa4e9", "git_parents": ["ea3fcef0a8f2f549a3ad4b0dfd12c4c9b6b44c86"], "node": "16dde397c3284635fd17a6af5deb8d1ab5499b5c", "parents": ["8ed463cce55b3445db74edc26414b3ba983dd31d"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086718 - Set a default busy timeout on async-only mozStorage connections to avoid busy-spinning on SQLITE_BUSY. r=hsingh\n\nAsync-only connections, including read-only clones that don't copy\nbusy_timeout, retried SQLITE_BUSY in a tight yield loop. Give them a default\n100ms busy timeout, and stop copying busy_timeout to clones, so they don't\ninherit a missing timeout. Stop retrying SQLITE_BUSY_SNAPSHOT, as it can never\nsucceed, and let interrupts end busy retries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337787\n", "files": ["storage/mozStorageAsyncStatementExecution.cpp", "storage/mozStorageConnection.cpp", "storage/test/unit/test_retry_on_busy.js", "storage/test/unit/test_storage_connection.js", "toolkit/components/places/ConcurrentConnection.cpp"], "git_node": "527221dd931175995e0f9a394b94d3dc499581bb", "git_parents": ["66f05fef7447125088beb73740654768ba3fa4e9"], "node": "143ba0d26791d3b564b7ac8f48147a9e568dc909", "parents": ["16dde397c3284635fd17a6af5deb8d1ab5499b5c"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088140 - Remove the obsolete B2G service worker skip from fetch_test_framework.js r=farre\n\nBug 1137683 was fixed long ago and B2G is no longer supported, so the user agent check in serviceWorkerTest() that skipped the service worker variant of the fetch tests is dead code. Remove it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338837\n", "files": ["dom/tests/mochitest/fetch/fetch_test_framework.js"], "git_node": "7bbda0168357b7b531977501785d658c9e26d665", "git_parents": ["527221dd931175995e0f9a394b94d3dc499581bb"], "node": "eef047e0b8f5dde6a4cde89de51555dc10a471f2", "parents": ["143ba0d26791d3b564b7ac8f48147a9e568dc909"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088141 - Remove the network.cookie.cookieBehavior=5 override from session restore test manifests. r=sessionstore-reviewers,nsharpley\n\nBug 1628486 has landed and browser/app/profile/firefox.js now defaults network.cookie.cookieBehavior to 5 (BEHAVIOR_PARTITION_FOREIGN), so the manifest-level override and its \"remove this after bug 1628486 is landed\" comment are no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338838\n", "files": ["browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_oldformat.toml"], "git_node": "7a0bc4e22dd17adfa2487686619f03f9a8d7ce34", "git_parents": ["7bbda0168357b7b531977501785d658c9e26d665"], "node": "2352ded9b929466dd922688bcd87610d9ac0025a", "parents": ["eef047e0b8f5dde6a4cde89de51555dc10a471f2"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088157 - Update stale comment in test_http3_non_ascii_header.js r=necko-reviewers,jesup DONTBUILD\n\nBug 1999659 is fixed, so non-ASCII request headers no longer cause an HTTP/2 fallback. Replace the outdated comment with one describing what test_non_ascii_header actually checks (request uses h3 and header value is preserved).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338814\n", "files": ["netwerk/test/unit/test_http3_non_ascii_header.js"], "git_node": "a0fcdd7193c968dfdd51936f918c61bf04124e97", "git_parents": ["7a0bc4e22dd17adfa2487686619f03f9a8d7ce34"], "node": "74cb99a004a4f4e0c0e60a44c4ee947c9042ca13", "parents": ["2352ded9b929466dd922688bcd87610d9ac0025a"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087325 - Don't force layout initialization of subdocuments. r=webidl,smaug\" for causing build bustages in Document.cpp.\n\nThis reverts commit 622b2d7058c7822e712e671979198b7977343bd8.\n", "files": ["dom/base/Document.cpp"], "git_node": "0fd516bb61edb5a66afe9b736d8a6b14a8027c1d", "git_parents": ["a0fcdd7193c968dfdd51936f918c61bf04124e97"], "node": "11fc8a23743a7c6b4bf6e61a2937d8df3d2d07d5", "parents": ["74cb99a004a4f4e0c0e60a44c4ee947c9042ca13"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\naf -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nan -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nar -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nast -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\naz -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nbe -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nbg -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nbn -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nbo -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nbqi -\u003e 5b094e31fb546340b59628831afe746a0ad93f48\nbr -\