el-list/panel-item-desktop-v3.figma.ts", "toolkit/content/widgets/panel-list/panel-item.figma.ts", "toolkit/content/widgets/panel-list/panel-list-desktop-v3.figma.ts", "toolkit/content/widgets/panel-list/panel-list.figma.ts", "toolkit/figma.config.json"], "git_node": "557268679dd2de97f481e5348dde9d79eb5db099", "git_parents": ["6f33b9a104ac2d4d01e6a39677bb06d2dc52b3df"], "node": "a1f7d904ce6d1575d0a854e8745074c18e05b64a", "parents": ["f08a15d739a91aa335bc920907695bf9a54c019d"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068103: Factor out and expose function for computing background image position. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333867\n", "files": ["layout/painting/nsCSSRendering.cpp", "layout/painting/nsCSSRendering.h"], "git_node": "60cea03fa4e1d7a1ed24256315112e0df5db4b33", "git_parents": ["557268679dd2de97f481e5348dde9d79eb5db099"], "node": "66bc100e64231af7e72c69d71c4df909bc44ff82", "parents": ["a1f7d904ce6d1575d0a854e8745074c18e05b64a"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068103: Skip image decoding when they're definitely positioned outside of visible area. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333868\n", "files": ["layout/painting/nsCSSRendering.cpp", "layout/painting/nsImageRenderer.cpp", "layout/painting/nsImageRenderer.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "69926e5b012a08d684c58610963b046a55a1da96", "git_parents": ["60cea03fa4e1d7a1ed24256315112e0df5db4b33"], "node": "9431a481cafda128fe3113ba51bf5f65589a6977", "parents": ["66bc100e64231af7e72c69d71c4df909bc44ff82"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085024 - gn_processor.py: Emit action targets' inputs and sources in GeneratedFile's extra_deps. r=glandium\n\nPreserve action targets' \"sources\" field through filtering, prefixing\nwith \"!\" for build-time generated files that will be located in the\nobjdir. During processing, ensure \"sources\" and \"inputs\" are listed in\nthe \"extra_deps\" field of the emitted GeneratedFile.\n\nSince actions' \"sources\" are now retained through the filtering stage,\nwe must ensure the processing stage does not emit them as\nSOURCES/UNIFIED_SOURCES.\n\nFor the task at hand (enabling ANGLE's Metal internal shader\ncompilation at build time) this serves two purposes:\n\n  1. Ensures the input Metal source file, which is listed under\n     \"sources\", is retained by ANGLE's vendoring script's pruning\n     step.\n\n  2. Enforces that dependencies are correctly listed between the chain\n     of emitted GeneratedFiles, where the output of one is used as the\n     input to the next. This ensures each step of the chain is\n     executed in the correct order at build time.\n\nThis causes a lot of noise in angle_program_version_id_gn/moz.build,\nas each input to the ANGLEShaderProgramVersion.h GeneratedFile is now\nexplicitly listed under extra_deps, and the exact list of inputs\nvaries per platform. This is, however, technically more correct than\npreviously omitting the dependencies.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314390\n", "files": ["build/gn_processor.py", "third_party/angle/angle_program_version_id_gn/moz.build"], "git_node": "b45084102440551f8126f2ab657b8f7471fd6867", "git_parents": ["69926e5b012a08d684c58610963b046a55a1da96"], "node": "257456e02f16377d20fb91a29b5d8c7b96a810ee", "parents": ["9431a481cafda128fe3113ba51bf5f65589a6977"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085024 - gn_processor.py: support actions whose flags contain paths to vendored source files. r=glandium\n\nGN actions may contain flags which are paths to vendored source\nfiles. In the generated project.json file, these will be written as\nrelative paths from the tempdir in which the project is generated. At\nbuild time, the GeneratedFile action will be executed with a cwd\nwithin the objdir.\n\nSince at vendoring time we cannot know either the absolute path of the\nsource tree, nor its relative path from the objdir, we must encode\nthese paths in the generated moz.build files as f-strings containing\n\"{TOPSRCDIR}\".\n\nNote that for the flags we currently care about (for ANGLE's Metal\ninternal shader compilation actions) the entire flag is always a\npath. However, one day we would like to support building ANGLE's\nVulkan backend, and that will require executing actions with flags\nthat contain a srcdir path prefixed by another string,\ne.g. \"--extinst=,../../path/to/srcdir/file\". We therefore ensure we\nsupport this from the get go.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314391\n", "files": ["build/gn_processor.py"], "git_node": "e0ade8188b8b9595016f4d9f43a774900df9ad18", "git_parents": ["b45084102440551f8126f2ab657b8f7471fd6867"], "node": "0f8647ba4b7e23dca293a997b9c5c94e951ad57b", "parents": ["257456e02f16377d20fb91a29b5d8c7b96a810ee"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076441 - Treat a deferred session with no windows or saved groups as nothing to restore. r=sessionstore-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330173\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_deferred_nothing_to_restore.py", "browser/components/sessionstore/test/marionette/test_restore_counts.py"], "git_node": "ff3b300c151f45f09f300284659f24f5d95b0f25", "git_parents": ["e0ade8188b8b9595016f4d9f43a774900df9ad18"], "node": "d9007e19b8a4c031f4b413e0273e3a157bec3bbd", "parents": ["0f8647ba4b7e23dca293a997b9c5c94e951ad57b"], "tags": []}], "date": 1793136343, "git_changesets": ["26f39a3f2bc5e7d02a035cb8f5937dae6cb41863", "b406282f2a20305247350520c451588062370ded", "bfa668a4834abe06f26c3395745c497357392dae", "930a9aafad3f56bf8685c07a86f18d9502340efa", "b01ad3ff30a5433cbdf83ddbf1a153ecb8f7f3ac", "619e331f9882492a70a3985c9a22f0c488b14bf3", "222753b13848363ed4639df302b37864e81d38c0", "7b7fa66c6b60b45054e7741cfd7721fbf2b3de90", "b251b0de8ddfd3cab648b8ab72a8ab3ccf695e76", "a61bc6854b312079380d9f22fb41e1b8879aeb6f", "dace3e5d11c0687157805331de2656442027c64c", "38e9036e49ffb109c0fa5d9a91c35c483e7ec89d", "8a682fd0029d915e92c91d3abd5502c2d63d2fb2", "585d0666afdcc11a98c2d9fb71406924249e217c", "30b2520b870c1f387ef06514d88223158c1ec920", "4b3e088a325ceb62bb355e9abf264f76a0e829f0", "7d5b7309c54720c05434c9c7eb74db54fe69b26d", "9f84e406e3089fb1f80dcd3692fe977a0e972777", "4e802da860c0d46714b6942ae332b8eac9bf55fb", "5a44a53a183ba70f1c3a14f5aeed770f8f8864fc", "3afc77210e3e27c14c78ef23d5903f2257375e0a", "d2fc20f438970a5d63a683ad1233ce58fa1242c8", "bebcb82ad3523dcd98c7c77c42a3885ca2e9bc45", "d02456054279735d1884b3174f2e69a641919eae", "da99a869e53027a47dd30658ea457a457434f3a2", "f3693da8612691a44059f20da1184f035e292314", "44377e1e4fb94890a93982f2188464c01658ecc6", "8f2d73639488444c7014aa25bddc6b787ee7c7e4", "ebfd99c38b9397d92c8782afc5d41116c8563a6b", "2093e3a470ca0478ca80fbcb005f4199c4371264", "94654d3ba4b395c8c250cf59e4589b4070a85ada", "d329f895463426a3e0c3933bc4bb6c9e3c60c3ab", "b9c68410a78a3640244f5b9cc6b2945c5e4f9d83", "d1dcbdad3ec494755fe497ab068224494aba3f75", "ccf113faaffffce7d0aace2914cbb9ade7d0bd14", "b64c5f2c42de4fc77ce77c645b5dfbeea0f8b1ea", "c69bc49a5ac983c3dcfb24400b6ca23a984a933d", "3c0ca163c1abe14e85e23cf0ac296577e6888ac9", "3a14c8c6a2ce359aeea5a3c1d7c07880e9a766a8", "38318d21ef31de5af89b06bf1f0aa4cc52f44994", "bf58cab7b694b248055a0c9a5c19cd51540c3961", "3165806bb24aa16aea9f64c1caf9be8150e8ebfa", "3d2088d363af671f8d2b32dd2a69187b7ee50ca9", "8b05b10f985eb0c9e3c0474c8465e031b240e538", "afa0311f2e89