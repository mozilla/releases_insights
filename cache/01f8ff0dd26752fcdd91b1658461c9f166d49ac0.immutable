ystem/config/helpers/figma-format/transform-token-value.mjs", "toolkit/themes/shared/design-system/config/helpers/general/replace-references.mjs", "toolkit/themes/shared/design-system/config/tokens-config.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/media-query-no-invalid.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-base-design-tokens.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-browser-refs-in-toolkit.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-has-selector.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.background-color.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.background-position.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.border-color.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.border-radius.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.box-shadow.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.color.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.fill.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.flex-basis.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.flex.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.font-size.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.font-weight.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.opacity.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.size.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.space.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.stroke.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.no-text-color.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.not-paired.tests.mjs"], "git_node": "1a1f5af187ed967b6f8752ad6d2c4a72c422499e", "git_parents": ["76a020521a80afe6eed9911ac11ea20892f11d02"], "node": "5e500c6a17f665d3f55b7cdebd69b047605871c4", "parents": ["b835a002292cc91e83406b22f9c28dbd70af2458"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2080511 - Implement argument grammar for var/env/attr substitution functions. r=firefox-style-system-reviewers,emilio\n\nArbitrary substitution functions are specified using a lenient argument\ngrammar that defines their syntax at parse time. The actual arguments\nare only parsed into their semantic forms at substitution time. For\n`var()`/`env()`/`attr()`, this makes nested references in the first\nparameter newly possible, like `var(var(--prop-name))`. Functions that\nwere previously considered invalid at parse time (like `var(1px)`) are\nnow considered valid so long as they match the argument grammar. The new\nargument grammar handling also adds support for free-form production\nmatching, so that `{}`-values work properly.\n\nIn this change, the core type that enables this functionality is\n`SubstitutionArgument\u003cT\u003e`. It can hold the `\u003cdeclaration-value\u003e` for the\nargument, but also eagerly parses it into the final `T` if there are no\nnested substitution functions. This enables parse-time usage of\narguments where possible, like attribute dependency tracking.\n\nIn order to handle functions with nested references, cycle detection\nruns Tarjan's algorithm through those references, and also performs\nsubstitution on those arguments to obtain the final referenced names.\n\nThis change passes existing WPTs for `var()` and `attr()` argument\ngrammar handling. New WPTs were added to test argument grammar handling\nfor `env()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333056\n", "files": ["devtools/client/inspector/rules/test/browser_rules_authored.js", "layout/style/test/property_database.js", "layout/style/test/test_css_supports_variables.html", "servo/components/style/custom_properties.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/stylesheets/container_rule.rs", "servo/components/style/stylist.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "servo/components/to_shmem/lib.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-env/env-fallback-substitution.html.ini", "testing/web-platform/meta/css/css-env/indexed-env.tentative.html.ini", "testing/web-platform/meta/css/css-values/attr-argument-grammar.html.ini", "testing/web-platform/meta/css/css-variables/var-ident-function.html.ini", "testing/web-platform/meta/css/css-variables/var-parsing.html.ini", "testing/web-platform/meta/css/css-variables/variable-declaration-29.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference-name-substitution-attr-taint.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference-name-substitution.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference.html.ini", "testing/web-platform/meta/css/css-variables/variable-supports-30.html.ini", "testing/web-platform/meta/css/css-variables/variable-supports-64.html.ini", "testing/web-platform/tests/css/css-conditional/container-queries/style-query-custom-attr-braces-change.html", "testing/web-platform/tests/css/css-conditional/container-queries/style-query-custom-attr-nested-name-change.html", "testing/web-platform/tests/css/css-env/env-fallback-braces.html", "testing/web-platform/tests/css/css-env/env-parsing.html", "testing/web-platform/tests/css/css-env/indexed-env.tentative.html", "testing/web-platform/tests/css/css-env/syntax.tentative.html", "testing/web-platform/tests/css/css-values/attr-all-types.html", "testing/web-platform/tests/css/css-values/attr-fallback-braces.html", "testing/web-platform/tests/css/css-variables/var-fallback-braces.html"], "git_node": "182ab3b89dc944acb33e9c65c016c3dc4e90fe58", "git_parents": ["1a1f5af187ed967b6f8752ad6d2c4a72c422499e"], "node": "4d77cec0f904cb62b7a89183b2feb3416fb3410f", "parents": ["5e500c6a17f665d3f55b7cdebd69b047605871c4"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2080511 - Use Parse trait and ParserContext for arbitrary substitution function arguments. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333114\n", "files": ["servo/components/style/custom_properties.rs", "servo/components/style/parser.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties_and_values/rule.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/queries/condition.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/stylist.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "servo/components/style/values/specified/image.rs", "servo/components/style/values/specified/param.rs", "servo/ports/geckolib/glue.rs"], "git_node": "cec478de07b4c0186a0dacc89922a92fe0e33246", "git_parents": ["182ab3b89dc944acb33e9c65c016c3dc4e90fe58"], "node": "8ac4b6b8276afff8824368f4933840fdb6bd2b82", "parents": ["4d77cec0f904cb62b7a89183b2feb3416fb3410f"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP r=release-managers,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338366\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "d21309c9e421f0ce69ad5a98246b167bc0d06bbf", "git_parents": ["cec478de07b4c0186a0dacc89922a92fe0e33246"], "node": "624d22b6c317d9fd7401f69f92eb2952922f9ec9", "parents": ["8ac4b6b8276afff8824368f4933840fdb6bd2b82"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2025220 - Export reopen last tab of current window as a configurable keyboard shortcut. r=sessionstore-reviewers,fluent-reviewers,bolsson,sfoster\" for causing bc failures @ browser_aboutKeyboard.js\n\nThis reverts commit b48a5620a933973384166428c134af07f5abbe51.\n", "files": ["browser/base/content/browser-sets.inc.xhtml", "browser/components/customkeys/CustomKeysParent.sys.mjs", "browser/locales/en-US/browser/customkeys.ftl"], "git_node": "370022d224cabe35df37202320a5783b5d7da232", "git_parents": ["d21309c9e421f0ce69ad5a98246b167bc0d06bbf"], "node": "7b8847ee6bc27ec934394d6ef36e6323774dbd04", "parents": ["624d22b6c317d9fd7401f69f92eb2952922f9ec9"], "tags": []}, {"author": "Matt Cleinman \u003c9295855+mcleinman@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087108 - Update website rules icon in Get Started state - r=ip-protection-reviewers,rking\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338161\n", "files": ["browser/components/ipprotection/content/ipprotection-content.css"], "git_node": "2dfb4d0ea904926072a38c8246bb2f13b712cdbb", "git_parents": ["370022d224cabe35df37202320a5783b5d7da232"], "node": "2d0cb63d4ce2389dadeed1908ca2b91dcae05742", "parents": ["7b8847ee6bc27ec934394d6ef36e6323774dbd04"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083140 - Animate panels with the panel motion tokens. r=kcochrane,emilio,desktop-theme-reviewers,reusable-components-reviewers,jules\n\nPanels now drop 4px and scale out of the corner they hang from, rather than\nsliding 70px. macOS animates the -moz-window-* properties as before, so the\nnative window shadow comes along and the system is not asked to recompute the\nwindow's shape mid-animation; since bug 2080204 those honour transform-origin,\nso a single declaration pivots both paths on the same corner. There the panel\nonly scales, with no drop.\n\nThe durations, the curve and the distances they animate over live in the design\nsystem as panel tokens, with --panel-motion-easing referencing\n--motion-easing-emphasized from bug 2083138 so the curve is named in one place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328873\n", "files": ["toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/panel.tokens.json", "toolkit/themes/shared/design-system/storybook/tokens-table.css", "toolkit/themes/shared/design-system/storybook/tokens-table.stories.mjs", "toolkit/themes/shared/popup.css"], "git_node": "46633940b5b1d26d9f5e9ac51435007dd5b53d01", "git_parents": ["2dfb4d0ea904926072a38c8246bb2f13b712cdbb"], "node": "738f4eaf297bb370317aec228ce526ca340ad9e5", "parents": ["2d0cb63d4ce2389dadeed1908ca2b91dcae05742"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087393 - Use meta tag rather than magic override for theming code. r=desktop-theme-reviewers,dao\n\nNo behavior change, but less magic :)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336534\n", "files": ["browser/base/content/browser.xhtml", "docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": "b731bc2cd3034c37bd83041c3c1b20e782284ee6", "git_parents": ["46633940b5b1d26d9f5e9ac51435007dd5b53d01"], "node": "4b68fa31e3cd2de91dca80dc2d47dd085e98623b", "parents": ["738f4eaf297bb370317aec228ce526ca340ad9e5"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054721 - Add testcase r=spidermonkey-reviewers,jandem\n\nThe problem here was already fixed by the changes in bug 2051882.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315238\n", "files": ["js/src/jit-test/tests/gc/bug-2054721.js"], "git_node": "be3ad3db838dd7c8f95444023d028651c5130573", "git_parents": ["b731bc2cd3034c37bd83041c3c1b20e782284ee6"], "node": "67e16adc3438e6de1df7d0a0989ae02507175846", "parents": ["4b68fa31e3cd2de91dca80dc2d47dd085e98623b"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046893 - Add tests r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307202\n", "files": ["js/src/jit-test/tests/gc/bug-2046893-2.js", "js/src/jit-test/tests/gc/bug-2046893.js"], "git_node": "3524153e107b2eef79a64ed4b66aa17d9d5ff6dc", "git_parents": ["be3ad3db838dd7c8f95444023d028651c5130573"], "node": "29120a1539fbe5e051c2f6330016e870404a7cc2", "parents": ["67e16adc3438e6de1df7d0a0989ae02507175846"], "tags": []}, {"author": "Sehat1137 \u003cSehat1137@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086366 - Keep address bar suggestions aligned during macOS fullscreen toolbar shifts. r=urlbar-reviewers,desktop-theme-reviewers,akulyk,daisuke\n\nWhen transform-aware anchor positioning is disabled, the top-layer view does not follow the toolbar translate. Apply the toolbar shift to the view in that configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337411\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/components/urlbar/tests/browser-UrlbarI