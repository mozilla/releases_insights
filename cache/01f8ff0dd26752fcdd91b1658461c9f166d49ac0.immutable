 -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nsq -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nsr -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nsv-SE -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nta -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nte -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nth -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\ntl -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\ntr -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\ntrs -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nuk -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nur -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nuz -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nvi -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nwo -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nxh -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nzam -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nzh-CN -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\nzh-TW -\u003e c8aa9267ac20cfdc45fca182f9df09ab3f259c5e\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "9a74ac2e511e30b87941e45762e6e5b4bacf86cd", "git_parents": ["cc8d913997945c3cb5e59ccf62d14f449d630600"], "node": "2941f697714bf9747dd61680e9dc3cbc17ad7114", "parents": ["318c52fc10e67b37d7e4eecde5bde04aba4bb4e1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2086305 - Use DrawSurface more often for SkPDF. r=lsalzman\n\nDrawTargetSkia::FillRect already redirects to DrawSurface when the image\nfits entirely inside the source rect, but it skipped that redirect for\nopaque surfaces drawn with OVER (which is basically every JPEG).\n\nOn a PDF canvas, the shader path makes SkPDF write a tiling Pattern, and\ngs ends up not downsampling it. A smarter optimizer could figure that\nout, but it seems better to use actual image objects in the PDF.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338022\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "testing/web-platform/mozilla/meta/printing/video-001-print.html.ini", "testing/web-platform/mozilla/meta/printing/video-002-print.html.ini", "testing/web-platform/mozilla/meta/printing/video-005-print.html.ini", "toolkit/components/printing/tests/browser.toml", "toolkit/components/printing/tests/browser_print_image_output.js", "toolkit/components/printing/tests/browser_print_page_size_output.js", "toolkit/components/printing/tests/file_print_images.html", "toolkit/components/printing/tests/head.js"], "git_node": "0b6146da78e50813404df3e74fe0dc29257252bc", "git_parents": ["9a74ac2e511e30b87941e45762e6e5b4bacf86cd"], "node": "f4a508492494366f3a7607a386205032e45d5f11", "parents": ["2941f697714bf9747dd61680e9dc3cbc17ad7114"], "tags": []}], "date": 1793351046, "git_changesets": ["5b2fc4f2c655fcdab5af9b6323169e002c712d8a", "3bfd67b34ebad584c54a98239f1e69342b0c168a", "4e360a1c1632a6a660b4f5c01e2d1687e244319f", "2cc8bc2d1c526f6a55298de5b8706e04cd7e59c1", "d5c9a5152ca30f570ce3eb1b7a77c8f6ec341291", "16dde4dc12c3393cdc9bf0d60656c78bde283621", "517f9708b42563649b3f65f534d3ea71bf661458", "0f8862b85efbbb9d50ade628421c9ff1036a41c8", "848b255b2e9b0d839b41c138c430291cc60f7d74", "be05818bc5bcd9369068340340d2d5163c03fc23", "0a001fac52aaf69e47e1004936e6966260b41423", "d6b85756630383d0ff2db89e644053cd7acc47ba", "9593776fd701035aeb9891d2a8c7287f3844d590", "8ce2d7d3ae765479f773ba313aae94f6d770489c", "cc1723545621203651cd14fba51441e08f04b864", "649d32066ed002f35a6918900a135e684ce52901", "30b424eea8c4859889924fc4e6fe8843485a96a2", "8d6a2d0bfa5bc4cd9c7b81e5f183f79f1c59ac74", "50b134ff4566d47f71e5babdb3895ac45a6ea075", "a881440c8844c9698fea024185d650cc8ed36e59", "9742c3931749a687851816572213dab790457524", "e274407227a7bb28f8ca796938450a1b79a516d7", "cc8d913997945c3cb5e59ccf62d14f449d630600", "9a74ac2e511e30b87941e45762e6e5b4bacf86cd", "0b6146da78e50813404df3e74fe0dc29257252bc"], "user": "smolnar@mozilla.com"}, "45678": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fb7bcc275b0b32c9f5be89f745500d022e86985e with DEVEDITION_160_0b3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "684ea5164efd991264678c5eaa0ac9811caa8c22", "git_parents": ["ea048f6d9a2d048d266bcefa17b6db897373fc82"], "node": "936036f368b7608c3c0f57a88c61d995c693401d", "parents": ["0134b7616423c2b7005f6b56a823558ebbade5ae"], "tags": []}], "date": 1793365665, "git_changesets": ["684ea5164efd991264678c5eaa0ac9811caa8c22"], "user": "ffxbld@lando.moz.tools"}, "45679": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fb7bcc275b0b32c9f5be89f745500d022e86985e with FIREFOX-ANDROID_160_0b3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a361fff2a94784e363ac6375844b5390a6e06201", "git_parents": ["684ea5164efd991264678c5eaa0ac9811caa8c22"], "node": "4e392830278fe36e6752727d2f3176ad47096817", "parents": ["936036f368b7608c3c0f57a88c61d995c693401d"], "tags": []}], "date": 1793365725, "git_changesets": ["a361fff2a94784e363ac6375844b5390a6e06201"], "user": "ffxbld@lando.moz.tools"}, "45680": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fb7bcc275b0b32c9f5be89f745500d022e86985e with FIREFOX_160_0b3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "6ab5c9bfe7eeab8598ee88f99e60ca17dc872292", "git_parents": ["a361fff2a94784e363ac6375844b5390a6e06201"], "node": "494112ca53a0e911f1a0c46233c0f6f3c45f34f6", "parents": ["4e392830278fe36e6752727d2f3176ad47096817"], "tags": []}], "date": 1793365782, "git_changesets": ["6ab5c9bfe7eeab8598ee88f99e60ca17dc872292"], "user": "ffxbld@lando.moz.tools"}, "45681": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fb7bcc275b0b32c9f5be89f745500d022e86985e with FIREFOX-ANDROID_160_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "507a2567dea8368d6337eb561164bacb34c1f70d", "git_parents": ["6ab5c9bfe7eeab8598ee88f99e60ca17dc872292"], "node": "72918474a2b17a864e67bcc8e4dd415c8e8ef6e0", "parents": ["494112ca53a0e911f1a0c46233c0f6f3c45f34f6"], "tags": []}], "date": 1793367316, "git_changesets": ["507a2567dea8368d6337eb561164bacb34c1f70d"], "user": "ffxbld@lando.moz.tools"}, "45682": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fb7bcc275b0b32c9f5be89f745500d022e86985e with FIREFOX_160_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0df97f335352d228110d4b50e8498e693795e668", "git_parents": ["507a2567dea8368d6337eb561164bacb34c1f70d"], "node": "9871fdcf3b02f58544307bdef7318ea94648034b", "parents": ["72918474a2b17a864e67bcc8e4dd415c8e8ef6e0"], "tags": []}], "date": 1793374262, "git_changesets": ["0df97f335352d228110d4b50e8498e693795e668"], "user": "ffxbld@lando.moz.tools"}, "45683": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fb7bcc275b0b32c9f5be89f745500d022e86985e with DEVEDITION_160_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "5604c13bae4a27047c977680444a29185ba46be9", "git_parents": ["0df97f335352d228110d4b50e8498e693795e668"], "node": "ac00609cd3c813e3a04711e892276cfcff083f15", "parents": ["9871fdcf3b02f58544307bdef7318ea94648034b"], "tags": []}], "date": 1793375100, "git_changesets": ["5604c13bae4a27047c977680444a29185ba46be9"], "user": "ffxbld@lando.moz.tools"}, "45684": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2085790 - [marionette] Clarify that commands must be sent sequentially. r=webdriver-reviewers,jdescottes DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337613\n", "files": ["remote/doc/index.md", "remote/doc/marionette/Protocol.md"], "git_node": "05bcc8025371ba4e55715a51ba5654b440f92a73", "git_parents": ["0b6146da78e50813404df3e74fe0dc29257252bc"], "node": "332dbf1a2581bdcdc1b9a6be4ce3e77af9b15196", "parents": ["f4a508492494366f3a7607a386205032e45d5f11"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087122 - Don't let APZUpdater::ClearTree wait for a blocked epoch, r=hiro,bradwerth.\n\nWhen a window is torn down before WebRender builds the scene for its last root\ndisplay list, the root layers id stays blocked on that epoch. Nothing will build\nit anymore, so ProcessQueue kept skipping the queued ClearTree task, which holds\nthe APZUpdater and leaks the whole APZ tree and compositor bridge. Tasks queued\nduring shutdown now run regardless of epochs, so ClearTree runs ahead of earlier\nblocked root tasks, which ProcessQueue then drops as it already does for stale\ncontent subtree tasks since bug 1465658.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338039\n", "files": ["gfx/layers/apz/public/APZUpdater.h", "gfx/layers/apz/src/APZUpdater.cpp"], "git_node": "1097a1e5ec5cd8efb1f5400d20c00dfa28c18df2", "git_parents": ["05bcc8025371ba4e55715a51ba5654b440f92a73"], "node": "f98082d33bd8b863078342a43963092f97afec41", "parents": ["332dbf1a2581bdcdc1b9a6be4ce3e77af9b15196"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087103 - Wait for running chrome animations before testing promiseDocumentFlushed, r=mconley.\n\nOn macOS, the titlebar opacity transition that runs when a fresh window gets\nfocused made test_basic fail in the standalone variant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338031\n", "files": ["dom/base/test/browser_promiseDocumentFlushed.js"], "git_node": "bc1342a7074b6d3ef8f9bcad24b96e19da97e256", "git_parents": ["1097a1e5ec5cd8efb1f5400d20c00dfa28c18df2"], "node": "671b9150f4b6ad12175a7351b8009ba28e60672f", "parents": ["f98082d33bd8b863078342a43963092f97afec41"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2086989 - Write the scratch product directly in BigInt division r=mgaudet\n\nSince bug 2084597, each quotient digit of a schoolbook division zeroes the\nscratch product with a memset call and then accumulates into it, which made\ndivision by small multi-digit divisors up to a third slower.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337902\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "c1415610245cc3207417a0aee82487ebd09e7d63", "git_parents": ["bc1342a7074b6d3ef8f9bcad24b96e19da97e256"], "node": "d066340aec766254a553bcd38b1d87ac0237667c", "parents": ["671b9150f4b6ad12175a7351b8009ba28e60672f"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2087368 - Apply patch from https://github.com/rust-lang/rust-bindgen/pull/3536. r=emilio,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338205\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/bindgen/.cargo-checksum.json", "third_party/rust/bindgen/ir/comp.rs"], "git_node": "663ab6b859911e2f14444850172c7f6139924eae", "git_parents": ["c1415610245cc3207417a0aee82487ebd09e7d63"], "node": "6e90a33ecf5732129e45bdd294e1407f908e694c", "parents": ["d066340aec766254a553bcd38b1d87ac0237667c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2086305 - Fix lossy image encoding in PrintTargetSkPDF. r=tnikkel\n\nI realized that the quality pref wasn't reducing the file size as\nexpected...\n\nWe were decoding the image, returning kBGRA_Color (which is the decoded\nsurface format), so we were bailing here:\n\n  https://searchfox.org/firefox-main/rev/b0625683b9b8cd108f6b3fa9eedbcd4aa0066d6e/gfx/skia/skia/src/pdf/SkPDFBitmap.cpp#311\n\nAdd a test for this based on the test for the previous patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338046\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "image/Decoder.cpp", "image/Decoder.h", "image/ImageMetadata.h", "image/ImageOps.cpp", "image/ImageOps.h", "image/decoders/nsJPEGDecoder.cpp", "toolkit/components/printing/tests/browser_print_image_output.js"], "git_node": "924e373ba49436c5308ca93ce72297c4ca61caff", "git_parents": ["663ab6b859911e2f14444850172c7f6139924eae"], "node": "507c59abda919dcc82fe63eaf7f8b49be3f8fa3f", "parents": ["6e90a33ecf5732129e45bdd294e1407f908e694c"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086542 - [customizable-menu] New settings entry to access the \"Customize menu\" screen r=android-reviewers,android-l10n-reviewers,petru,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337961\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/customize/FenixCustomizeMenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/CustomizationFragment.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/customization_preferences.xml"], "git_node": "426a9a20545a05d16eebfafe80967039df95546d", "git_parents": ["924e373ba49436c5308ca93ce72297c4ca61caff"], "node": "e2c13b8c9ba8946faf013fbf7bec4ed955b09a71", "parents": ["507c59abda919dcc82fe63eaf7f8b49be3f8fa3f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1821458 - Initialize RAPL members, r=profiler-reviewers,mstange.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338145\n", "files": ["tools/profiler/core/PowerCounters-mac-amd64.cpp"], "git_node": "cacdf904147e3855f7099a6255404b3c2745cadf", "git_parents": ["426a9a20545a05d16eebfafe80967039df95546d"], "node": "f677fe5294cd068cd4d3471d4d5e03a6cce1d6f9", "parents": ["e2c13b8c9ba8946faf013fbf7bec4ed955b09a71"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070280 - Update Checklist widget dropdown/button UI r=fluent-reviewers,bolsson,reemhamz\n\n- The list dropdown now works like the Stocks one: a single button\n  named after the current list, so the \"Change list\" string has been\n  removed.\n- At medium size, the plus button in the header has been made small.\n- The dropdown ends with \"Create a new list\", which is disabled at the\n  list limit and returns focus to the dropdown once the new name is\n  saved or cancelled.\n- `focusOnceRendered` has moved from the Stocks widget to\n  `lib/utils.jsx` so that Lists can use it too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337490\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Lists/Lists.jsx", "browser/extensions/newtab/content-src/components/Widgets/Lists/_Lists.scss", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/useStockSearch.jsx", "browser/extensions/newtab/content-src/lib/utils.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Lists.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/utils.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "32124795362be34958a1357b79b2bc8f948a8781", "git_parents": ["cacdf904147e3855f7099a6255404b3c2745cadf"], "node": "6385d1edc8de68ff44b600592c1a010ab050c287", "parents": ["f677fe5294cd068cd4d3471d4d5e03a6cce1d6f9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087101 - Keep non-test mouse events disabled until the end of test_tooltip_noautohide.xhtml, r=firefox-desktop-core-reviewers ,Gijs.\n\nA native mouse move from the real cursor, which Windows sends when the tooltip window appears, moved the pointer off the button and hid the tooltip.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338030\n", "files": ["toolkit/content/tests/chrome/test_tooltip_noautohide.xhtml"], "git_node": "f5928463d742a1ef9b8da1c78386c6bdb8037a53", "git_parents": ["32124795362be34958a1357b79b2bc8f948a8781"], "node": "222a84cb11460f51cf0c5eed8a9db7708cb0873f", "parents": ["6385d1edc8de68ff44b600592c1a010ab050c287"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1996471 - Close the tab hover preview before browser_tab_splitview_contextmenu.js moves the tab strip, r=tabbrowser-reviewers,sthompson.\n\nAlso remove the macOS 15.30 aarch64 skip-if from bug 2023967, a blanket skip for the new arm workers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338104\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_contextmenu.js"], "git_node": "2ef604e724f554a015ebcfdd04c76b5d78c8154d", "git_parents": ["f5928463d742a1ef9b8da1c78386c6bdb8037a53"], "node": "051c0a4377be64d19ad77ba854a6ebb10d3bc45e", "parents": ["222a84cb11460f51cf0c5eed8a9db7708cb0873f"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083705 - Check [SecureContext] when deserializing [Serializable] interfaces r=extension-reviewers,nika,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335106\n", "files": ["dom/base/StructuredCloneHolder.cpp", "dom/bindings/Codegen.py", "testing/web-platform/meta/fs/FileSystemBaseHandle-postMessage-insecure-context.https.window.js.ini", "testing/web-platform/meta/webmessaging/postMessage_CryptoKey_insecure.sub.html.ini", "toolkit/components/extensions/test/mochitest/test_ext_contentscript_securecontext.html"], "git_node": "0e3e49d0bccbe1e94e1042b8aa7c09c4c5c6146e", "git_parents": ["2ef604e724f554a015ebcfdd04c76b5d78c8154d"], "node": "eb1fbfb447cec416c0da77162edbac6faeb61c6d", "parents": ["051c0a4377be64d19ad77ba854a6ebb10d3bc45e"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2084865 - Also install a newer ca-certificates on Ubuntu 18.04, 20.04, Debian 10 and 11. r=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338182\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "965abe2c46680bd84b1d00cde3e341003414d816", "git_parents": ["0e3e49d0bccbe1e94e1042b8aa7c09c4c5c6146e"], "node": "84274262e68248bc3e81a084489bef02d258a1f3", "parents": ["eb1fbfb447cec416c0da77162edbac6faeb61c6d"], "tags": []}, {"author": "Dimi Lee \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085544 - Fill cc-csc only in frames same-origin with the triggering frame. r=credential-management-reviewers,NeilDeakin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338015\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_iframe_autofill_cc_csc.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/fixtures/autocomplete_cc_csc_embeded.html", "toolkit/components/formautofill/FormAutofillParent.sys.mjs"], "git_node": "83cc943ef56a8b21f9600986daa06f4c3ccb9977", "git_parents": ["965abe2c46680bd84b1d00cde3e341003414d816"], "node": "6d4a31ca21c192e80386f6fd0a0be9c909296d85", "parents": ["84274262e68248bc3e81a084489bef02d258a1f3"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run android build tasks on git-backed pushes, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327770\n", "files": ["taskcluster/kinds/build/android.yml"], "git_node": "91b178a3af9f817c9b0ac5910e901f7269ea058f", "git_parents": ["83cc943ef56a8b21f9600986daa06f4c3ccb9977"], "node": "e6ca1db974708caf554471f3454c335f5e5f018d", "parents": ["6d4a31ca21c192e80386f6fd0a0be9c909296d85"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run android-asan build tasks on git-backed pushes, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327771\n", "files": ["taskcluster/kinds/build/android-asan.yml"], "git_node": "a299181eb4b5dc7dc10dfbc2775a187d4241f636", "git_parents": ["91b178a3af9f817c9b0ac5910e901f7269ea058f"], "node": "6eba61233357fd8ebcbf7945f4011a3dea80d08d", "parents": ["e6ca1db974708caf554471f3454c335f5e5f018d"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run fenix build tasks on git-backed pushes, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327772\n", "files": ["taskcluster/kinds/build/fenix.yml"], "git_node": "e97662c6aff53b56dcc204c12fd61cb1601f400c", "git_parents": ["a299181eb4b5dc7dc10dfbc2775a187d4241f636"], "node": "77ed5f376d3b0608a3ac1cc4b5f257f5b0008639", "parents": ["6eba61233357fd8ebcbf7945f4011a3dea80d08d"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2087171. Cast only the size of SVG filter node task rects to integers. r=gfx-reviewers,bradwerth\n\nThe device rect of an SVG filter graph surface lives in its raster space, which\ncan be far from the origin (for example, under a large scale and perspective)\neven when its size is small. new_svg_filter_graph cast the whole node task rect\nto i32 only to take its size, so a position beyond i32 range panicked. Cast the\nsize instead, like get_surface_rects does for the surface task size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338189\n", "files": ["gfx/tests/crashtests/2087171.html", "gfx/tests/crashtests/crashtests.list", "gfx/wr/webrender/src/render_task.rs"], "git_node": "b4616f13f2de0169d049f3e2f8b8b2031c725929", "git_parents": ["e97662c6aff53b56dcc204c12fd61cb1601f400c"], "node": "77a9ce8b91a03f4fd8f895ed3976b1fc46998ee9", "parents": ["77ed5f376d3b0608a3ac1cc4b5f257f5b0008639"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086118 - Factor out the functions adding the common annotations r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337190\n", "files": ["toolkit/crashreporter/crash_helper_server/src/crash_generation.rs"], "git_node": "96d263f707814e785f4a55fb7bf09d06ae88e6fe", "git_parents": ["b4616f13f2de0169d049f3e2f8b8b2031c725929"], "node": "105e011f8d4532b49036dc8e28851e2df33650bd", "parents": ["77a9ce8b91a03f4fd8f895ed3976b1fc46998ee9"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086118 - Let the crash helper populate the process uptime annotation r=afranchuk,crashreporting-reviewers\n\nThe macOS implementation requires a small C stub as it uses a syscall to\nread the `kinfo_proc` structure of the target process. This structure\ndoesn't have a Rust representation yet and is *huge*, so making a\ndedicated copy of its layout just for this use-case would have been\noverkill.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337191\n", "files": ["toolkit/crashreporter/crash_helper/crashhelper.cpp", "toolkit/crashreporter/crash_helper_server/build.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/linux.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/macos.c", "toolkit/crashreporter/crash_helper_server/src/crash_generation/macos.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/test/unit/test_crashreporter_crash.js"], "git_node": "00547b3535191b23beb0be4a0c3e51657c262986", "git_parents": ["96d263f707814e785f4a55fb7bf09d06ae88e6fe"], "node": "ba6759dea63064cd8a144d9fe9e1d066ad942bd3", "parents": ["105e011f8d4532b49036dc8e28851e2df33650bd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086749 - Run clang-format on 30 core workers r=linter-reviewers,marco\n\nOn try clang-format takes 133 seconds on the 8 core workers and 45\nseconds on 30 cores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337751\n", "files": ["taskcluster/kinds/source-test/mozlint.yml"], "git_node": "d5f1cb02c5666bc59dab575926b7b5b2028be8f7", "git_parents": ["00547b3535191b23beb0be4a0c3e51657c262986"], "node": "9a9bcbc8197e496bdec9d23569453b91bb37bc35", "parents": ["ba6759dea63064cd8a144d9fe9e1d066ad942bd3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086791 - Run clang-tidy and clang-external on 30 core workers r=linter-reviewers,marco\n\nOn review bot pushes that touch C++, clang-tidy and clang-external\nfinish last, so moving one without the other gains little. On try\nclang-tidy takes 185 seconds on the 8 core workers and 106 seconds on\n30 cores, and clang-external 182 and 98 seconds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337752\n", "files": ["taskcluster/kinds/source-test/clang.yml"], "git_node": "1ff811b407a6fef2cfceaecb3001bc76de91ac10", "git_parents": ["d5f1cb02c5666bc59dab575926b7b5b2028be8f7"], "node": "01245341c8a8b3482472de571d7b27268f2f95ed", "parents": ["9a9bcbc8197e496bdec9d23569453b91bb37bc35"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086789 - Run clippy on 30 core workers r=linter-reviewers,sylvestre\n\nOn try clippy takes 318 seconds on the 8 core workers and 225 seconds\non 30 cores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337753\n", "files": ["taskcluster/kinds/source-test/mozlint.yml"], "git_node": "512760f462f7a0d801821cf226060027ef419fea", "git_parents": ["1ff811b407a6fef2cfceaecb3001bc76de91ac10"], "node": "59a2d35f6d766cdf8bf9dafe54df345500d38e28", "parents": ["01245341c8a8b3482472de571d7b27268f2f95ed"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086792 - Run taskgraph-diff on 30 core workers r=linter-reviewers,marco\n\ntaskgraph-diff generates the graph for each of the 42 parameter sets\nin `taskcluster/test/params`, spread over one process per core. On\ntry it takes 507 seconds on the 8 core workers and 185 seconds on 30\ncores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337754\n", "files": ["taskcluster/kinds/source-test/taskgraph.yml"], "git_node": "a4d94f737c8b0618cbb7964ae0bd17580cb9568f", "git_parents": ["512760f462f7a0d801821cf226060027ef419fea"], "node": "d13d6c36368b4e8759c2c27b77f9fac06dd77fbb", "parents": ["59a2d35f6d766cdf8bf9dafe54df345500d38e28"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086790 - Run typescript on 30 core workers r=linter-reviewers,marco\n\nOn try the typescript check takes 49 seconds on the 8 core workers and\n19 seconds on 30 cores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337755\n", "files": ["taskcluster/kinds/source-test/mozlint.yml"], "git_node": "e7c574faba51ec8c2ebdc95c499e98fbf0af69ac", "git_parents": ["a4d94f737c8b0618cbb7964ae0bd17580cb9568f"], "node": "153fb5636fcfee11856b9eb218eb315134770b21", "parents": ["d13d6c36368b4e8759c2c27b77f9fac06dd77fbb"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084934 - Use the remote executor for processes running under another UID r=crashreporting-reviewers,afranchuk\n\nThe first characteristic of isolated processes that prevents our usual\nway of getting crash dumps is that they run under their own UID.\nLuckily, that also gives us a handy way of identifying them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337483\n", "files": ["toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation_server.cc"], "git_node": "92dd8b19b278a57864a3ab80e2f7eb03ab440cdd", "git_parents": ["e7c574faba51ec8c2ebdc95c499e98fbf0af69ac"], "node": "d35528872e540a093d20f1bef6c6334909ae0151", "parents": ["153fb5636fcfee11856b9eb218eb315134770b21"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084934 - Enable content crash tests on isolated processes r=crashreporting-reviewers,geckoview-reviewers,afranchuk,m_kato\n\nWe just have to disable the assertions that rely on annotations since\nthey're still buggy, see bug 2082922.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337484\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentCrashTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TestCrashHandler.java"], "git_node": "6e1894f5fe91032b0527a5a522dca29c7e828166", "git_parents": ["92dd8b19b278a57864a3ab80e2f7eb03ab440cdd"], "node": "d4d0eac5ef5332734da128cf59922e79c51f6512", "parents": ["d35528872e540a093d20f1bef6c6334909ae0151"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086118 - Let the crash helper populate the process uptime annotation r=afranchuk,crashreporting-reviewers\" for causing build bustages\n\nThis reverts commit 00547b3535191b23beb0be4a0c3e51657c262986.\n\nRevert \"Bug 2086118 - Factor out the functions adding the common annotations r=afranchuk,crashreporting-reviewers\"\n\nThis reverts commit 96d263f707814e785f4a55fb7bf09d06ae88e6fe.\n", "files": ["toolkit/crashreporter/crash_helper/crashhelper.cpp", "toolkit/crashreporter/crash_helper_server/build.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/linux.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/macos.c", "toolkit/crashreporter/crash_helper_server/src/crash_generation/macos.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/test/unit/test_crashreporter_crash.js"], "git_node": "b4b2b5591ce497eda46b94c919c42c230d394a5e", "git_parents": ["6e1894f5fe91032b0527a5a522dca29c7e828166"], "node": "d341392066131e2391972560ed551e3ca964973a", "parents": ["d4d0eac5ef5332734da128cf59922e79c51f6512"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087388 - Update android nightly application-services version bump to bab3c82d25c1f93f6bb5a6ebb2d34eb849163f71 r=pascalc,release-managers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338219\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "deded938efb7658ba1fe6c1eeb88b927e288b0c2", "git_parents": ["b4b2b5591ce497eda46b94c919c42c230d394a5e"], "node": "4181a28b54a85eaa6d4021b6bbe488f11ed8a52a", "parents": ["d341392066131e2391972560ed551e3ca964973a"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2082379 - Add EngineChoicesModel, replacing enabled_changes, towards per-device sync engine choices. r=android-reviewers,sfamisa\n\nFor https://github.com/mozilla/application-services/pull/7638\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334071\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt"], "git_node": "fa3e3302abd171b3846643be047bb66be7891f46", "git_parents": ["deded938efb7658ba1fe6c1eeb88b927e288b0c2"], "node": "5378102cfc3564455555e6ce70da8fec86ba19f4", "parents": ["4181a28b54a85eaa6d4021b6bbe488f11ed8a52a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086834 - Keep the Gradle user home of Android CI tasks in a worker cache r=RyanVM,taskgraph-reviewers,android-build-system-reviewers,releng-reviewers,jcristau\n\nCI kept its Gradle settings as files in in-tree Gradle user homes,\nwhich run-task cleans, so every task started cold, and moving a home\nlost the settings. Tasks now pass the settings as `GRADLE_FLAGS` with\n`use-gradle: offline` or `use-gradle: online`, and offline tasks keep\n`GRADLE_USER_HOME` in a persistent worker cache when they set\n`use-gradle-cache`. As with sccache, shippable and shipping tasks do not\nopt in, and a verification rejects them on release projects. On a\nworker that keeps the cache, android-lints is about 73s faster (281s\nto 208s on try, with the Gradle daemon on).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337779\n", "files": ["build/test/python/test_android_gradle_build.py", "mobile/android/gradle.configure", "mobile/android/gradle/dotgradle-offline/gradle.properties", "mobile/android/gradle/dotgradle-offline/init.gradle", "mobile/android/gradle/dotgradle-online/gradle.properties", "mobile/android/gradle/dotgradle-online/init.gradle", "taskcluster/android_taskgraph/job.py", "taskcluster/android_taskgraph/transforms/build_components.py", "taskcluster/docker/android-build/Dockerfile", "taskcluster/docker/android-components/Dockerfile", "taskcluster/docker/android-ui-tests/Dockerfile", "taskcluster/docker/lint/Dockerfile", "taskcluster/gecko_taskgraph/test/test_android_taskgraph.py", "taskcluster/gecko_taskgraph/test/test_transforms_job.py", "taskcluster/gecko_taskgraph/test/test_transforms_job_common.py", "taskcluster/gecko_taskgraph/test/test_util_verify.py", "taskcluster/gecko_taskgraph/transforms/job/__init__.py", "taskcluster/gecko_taskgraph/transforms/job/common.py", "taskcluster/gecko_taskgraph/util/verify.py", "taskcluster/kinds/build-components/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build-samples-browser/kind.yml", "taskcluster/kinds/build/android-asan.yml", "taskcluster/kinds/build/android-stuff.yml", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/fenix.yml", "taskcluster/kinds/instrumented-build-apk/kind.yml", "taskcluster/kinds/instrumented-build-macrobenchmark-apk/kind.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/source-test/android-detekt.yml", "taskcluster/kinds/source-test/android-gradle-plugins.yml", "taskcluster/kinds/source-test/buildconfig.yml", "taskcluster/kinds/source-test/mozlint-android.yml", "taskcluster/kinds/source-test/python-android.yml", "taskcluster/kinds/test-apk/kind.yml", "taskcluster/kinds/test-components/kind.yml", "taskcluster/kinds/toolchain/android.yml", "taskcluster/scripts/builder/build-android.sh"], "git_node": "1e0443cd79280780cc82a90d354e9d9302cbf3cb", "git_parents": ["fa3e3302abd171b3846643be047bb66be7891f46"], "node": "1510eb11a2614733ffd14b97dd67601a759a68ef", "parents": ["5378102cfc3564455555e6ce70da8fec86ba19f4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086735 - Reuse one Gradle daemon across the Gradle runs of a CI task r=RyanVM,android-build-system-reviewers,taskgraph-reviewers,jcristau\n\nEach Gradle run in a task started its own JVM, paid the startup and\nwarm up again, and threw away the loaded build logic. With one daemon\nper task, the Android Gradle dependencies toolchain is about 114s\nfaster and android-lints about 78s faster on try.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337778\n", "files": ["taskcluster/docker/android-components/Dockerfile", "taskcluster/docker/android-ui-tests/Dockerfile", "taskcluster/gecko_taskgraph/test/test_android_taskgraph.py", "taskcluster/gecko_taskgraph/test/test_transforms_job.py", "taskcluster/gecko_taskgraph/test/test_transforms_job_common.py", "taskcluster/gecko_taskgraph/transforms/job/common.py"], "git_node": "21c6355615995df430ee7071d95a0a7c517f4cb1", "git_parents": ["1e0443cd79280780cc82a90d354e9d9302cbf3cb"], "node": "e5a96ffeb6f2e83506aec66f0d0f404012c07f36", "parents": ["1510eb11a2614733ffd14b97dd67601a759a68ef"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086925 - Rebuild the Android Gradle dependencies toolchains when `widget/android/moz.build` changes r=RyanVM\n\n`widget/android/moz.build` decides whether the toolchain's `mach build` runs\nthe Gradle export, and that run fetched aapt2, which no enumeration pass lists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338165\n", "files": ["taskcluster/kinds/toolchain/android.yml"], "git_node": "6b4a6d87fdb0390c1e78fbbfbcaf9255b27bd04e", "git_parents": ["21c6355615995df430ee7071d95a0a7c517f4cb1"], "node": "d1055ce3dafdfe4084db374d6e60b19844411b1b", "parents": ["e5a96ffeb6f2e83506aec66f0d0f404012c07f36"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086925 - Generate the GeckoView JNI wrappers only with a compile environment r=RyanVM\n\nOnly C++ reads the wrappers, so builds without a compile environment,\nlike the Android lint, standalone Android, fat AAR and Gradle\ndependencies toolchain tasks, spent a Gradle run on files nothing used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337860\n", "files": ["widget/android/moz.build"], "git_node": "8100386729139d7eb965dfb49cfd5bd14cf9ad36", "git_parents": ["6b4a6d87fdb0390c1e78fbbfbcaf9255b27bd04e"], "node": "b7f8f66bb4597d04a0205b73103482ab5f6460bb", "parents": ["d1055ce3dafdfe4084db374d6e60b19844411b1b"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2005955 - Emit neqo_glue logs via Rust tracing r=necko-reviewers,kershaw\n\nSwitch neqo_glue's log call sites (log::debug and the neqo qdebug/qwarn/\nqerror macros) over to the Rust tracing macros so that neqo glue logging shows\nup as profiler markers when profiling.\n\nAlso wrap neqo_http3conn_process_input and\nneqo_http3conn_process_output_and_send in entered Rust tracing spans. Because\neach span stays open for the duration of the call, the profiler records it\nas an interval marker with a real duration, not just a point-in-time event.\nThe spans carry the byte and segment counts (bytes_received/segments_received\nand bytes_sent/segments_sent).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309236\n", "files": ["Cargo.lock", "netwerk/socket/neqo_glue/Cargo.toml", "netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "7fb30e8fbc4dcceef8759e12177aaccb592c900d", "git_parents": ["8100386729139d7eb965dfb49cfd5bd14cf9ad36"], "node": "c5632fc9d55e4c7cb2631224241770de1a53f7dd", "parents": ["b7f8f66bb4597d04a0205b73103482ab5f6460bb"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2087403 - Adjust mozglue build script for up to rustc 1.99. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338231\n", "files": ["mozglue/static/rust/build.rs"], "git_node": "919e7330196d57eff007109b794a4da58d9fc98e", "git_parents": ["7fb30e8fbc4dcceef8759e12177aaccb592c900d"], "node": "3591414691bd4f8ca84cdc188cdef59afe9b848d", "parents": ["c5632fc9d55e4c7cb2631224241770de1a53f7dd"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2087358 - Fix sysroot-wasm32-wasi-clang-trunk task. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338204\n", "files": ["taskcluster/kinds/toolchain/sysroot.yml", "taskcluster/scripts/misc/wasi-sdk-clang_24.patch"], "git_node": "e694d9a963f05f5a062996d7b4dde5c497a767e7", "git_parents": ["919e7330196d57eff007109b794a4da58d9fc98e"], "node": "0a0763e2855c391aede35a5c31bd56c2c380a17d", "parents": ["3591414691bd4f8ca84cdc188cdef59afe9b848d"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2087367 - Add reproducibility checks for macos builds. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338201\n", "files": ["taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/diffoscope/reproducible.yml"], "git_node": "1f9b2e204fbe3df0f45eb6238c4434a3d38225a6", "git_parents": ["e694d9a963f05f5a062996d7b4dde5c497a767e7"], "node": "3482ec0ac3ac034719ebd76a5c874974885dfc2e", "parents": ["0a0763e2855c391aede35a5c31bd56c2c380a17d"], "tags": []}, {"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081203 - Add Android specific ./mach usage to the Android skill r=ai4dev-reviewers,android-reviewers,adhingra,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333595\n", "files": [".agents/skills/android/SKILL.md", ".claude/skills/android/SKILL.md"], "git_node": "e3e7af094556ad80dc159091024e47a9cc213e14", "git_parents": ["1f9b2e204fbe3df0f45eb6238c4434a3d38225a6"], "node": "eb94c184cfa85cbb3f2cb5c04e4d60ce1188cf73", "parents": ["3482ec0ac3ac034719ebd76a5c874974885dfc2e"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066061 - Set return types of all methods of UrlbarChildControllerProxy to void. r=urlbar-reviewers,mak DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337107\n", "files": ["browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/types/urlbar.ts"], "git_node": "07344ddd5754ea375cbf345518f1e4029770b122", "git_parents": ["e3e7af094556ad80dc159091024e47a9cc213e14"], "node": "3423bada9be1de57cc59c88f0dee8714bf57d905", "parents": ["eb94c184cfa85cbb3f2cb5c04e4d60ce1188cf73"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086344 - Remove an overzealous thread dispatch check when loading SQLite extensions. r=jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337620\n", "files": ["storage/mozStorageConnection.cpp", "toolkit/modules/Sqlite.sys.mjs"], "git_node": "dfca3973a2563865b75bb7b3cd8e3d2259fa0f45", "git_parents": ["07344ddd5754ea375cbf345518f1e4029770b122"], "node": "143a2ccc14fe5b0a926aede2f0a1d55f4be780e5", "parents": ["3423bada9be1de57cc59c88f0dee8714bf57d905"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2087379 - Add reproducibility checks for android builds. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338218\n", "files": ["taskcluster/kinds/build/android.yml", "taskcluster/kinds/diffoscope/reproducible.yml"], "git_node": "0966eb223808dde8449f56768a131ceecab0a9ce", "git_parents": ["dfca3973a2563865b75bb7b3cd8e3d2259fa0f45"], "node": "d97c2a9fb82a59b5137d9b288ce88a2a28f1e13a", "parents": ["143a2ccc14fe5b0a926aede2f0a1d55f4be780e5"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086767 - Save the directory instead of the file as the last temporary add-on location in about:debugging; r=nchevobbe,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338013\n", "files": ["devtools/client/aboutdebugging/src/modules/extensions-helper.js", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_temporary_install_path.js"], "git_node": "68319eab4c7b263dd5ebf05e322ef36ff3941775", "git_parents": ["0966eb223808dde8449f56768a131ceecab0a9ce"], "node": "3ccd4854a4355e9096e3a9ef7a6bbfd092eea232", "parents": ["d97c2a9fb82a59b5137d9b288ce88a2a28f1e13a"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2087426 - Add a Necko code review skill and load it for netwerk/ patches. r=ai4dev-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338254\n", "files": [".agents/skills/necko-review/SKILL.md", ".claude/skills/necko-review/SKILL.md", "review-context.toml"], "git_node": "38c413de0216ed6eb389ee7d5ba21d0963b7abbf", "git_parents": ["68319eab4c7b263dd5ebf05e322ef36ff3941775"], "node": "27600908f05506025bf5c3ca2a08d35e316c8673", "parents": ["3ccd4854a4355e9096e3a9ef7a6bbfd092eea232"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087379 - Add reproducibility checks for android builds. r=firefox-build-system-reviewers,sergesanspaille\" for causing ci failures\n\nThis reverts commit 0966eb223808dde8449f56768a131ceecab0a9ce.\n", "files": ["taskcluster/kinds/build/android.yml", "taskcluster/kinds/diffoscope/reproducible.yml"], "git_node": "0167f98f12058d8882ba95cbe15bdff9e3bdb8ee", "git_parents": ["38c413de0216ed6eb389ee7d5ba21d0963b7abbf"], "node": "2ea26bb56e2860aae43104b3760e6e67a7516739", "parents": ["27600908f05506025bf5c3ca2a08d35e316c8673"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991680 - Set NHE entries for subframes r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338084\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/CanonicalBrowsingContext.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/DOMTypes.ipdlh", "dom/ipc/PContent.ipdl", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-bfcache-in-iframe.html.ini"], "git_node": "e1bd2456b024f2c4ffe17e124150521e813d20c6", "git_parents": ["0167f98f12058d8882ba95cbe15bdff9e3bdb8ee"], "node": "b7c10c2d391206b2bd0864ef59e3a84839d27c2f", "parents": ["2ea26bb56e2860aae43104b3760e6e67a7516739"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086765 - Implement the text-autospace-size property. r=firefox-style-system-reviewers,layout-reviewers,dshin,emilio,TYLin,devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337722\n", "files": ["devtools/server/actors/animation-type-longhand.js", "dom/base/use_counter_metrics.yaml", "gfx/src/nsFontMetrics.cpp", "gfx/src/nsFontMetrics.h", "layout/base/nsPresContext.cpp", "layout/generic/nsTextFrame.cpp", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/style/test/property_database.js", "layout/style/test/test_transitions_per_property.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/data.py", "servo/components/style/properties/longhands.toml", "testing/web-platform/meta/css/css-text/text-autospace/__dir__.ini", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-computed.html", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-invalid.html", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-valid.html", "testing/web-platform/tests/css/css-text/text-autospace/crashtests/text-autospace-size-huge-crash.html", "testing/web-platform/tests/css/css-text/text-autospace/text-autospace-size-001-ref.html", "testing/web-platform/tests/css/css-text/text-autospace/text-autospace-size-001.html"], "git_node": "c50dfe132013be94e0ae2bef3a1a9f365d77e8de", "git_parents": ["e1bd2456b024f2c4ffe17e124150521e813d20c6"], "node": "da607619a6dace61db9480f98b58ed066af3829a", "parents": ["b7c10c2d391206b2bd0864ef59e3a84839d27c2f"], "tags": []}, {"author": "Welpy-cw \u003c58345540+Welpy-cw@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084270 - Stop applying ancestor clips outside popups in intersection observations. r=emilio,layout-reviewers\n\nStop ancestor clipping at the popup frame while preserving clipping inside\nit, so visible popup content can intersect outside subdocument viewports.\n\nCover the regression with a chrome mochitest using nested same-origin\niframes and a panel outside a small embedding viewport.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335689\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/base/test/chrome/chrome.toml", "dom/base/test/chrome/file_intersectionobserver_popup.xhtml", "dom/base/test/chrome/file_intersectionobserver_popup_container.xhtml", "dom/base/test/chrome/test_intersectionobserver_popup.xhtml"], "git_node": "4ef82ea9b6598d8f9f98eadd8df0fa8f0ea8801d", "git_parents": ["c50dfe132013be94e0ae2bef3a1a9f365d77e8de"], "node": "4eb5da8fdcfdec335b8ed3fdb545c31a3f99131a", "parents": ["da607619a6dace61db9480f98b58ed066af3829a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087209 - Make CSSImportRule::GetStyleSheet less confusing/footgunny. r=firefox-style-system-reviewers,layout-reviewers,AlaskanEmily\n\nThis got me backed out in bug 2081980 because I called\nCSSImportRule::GetStyleSheet rather than Rule::GetStyleSheet. Use a\nclearer name and delete CSSImportRule::GetStyleSheet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338090\n", "files": ["layout/inspector/ServoStyleRuleMap.cpp", "layout/style/CSSImportRule.h", "layout/style/Rule.cpp"], "git_node": "a7595b1c7190dca80d47f49f11b3db285fc3051f", "git_parents": ["4ef82ea9b6598d8f9f98eadd8df0fa8f0ea8801d"], "node": "a2c41f6826b129829f21ff7fc4bdc9051e4d45e1", "parents": ["4eb5da8fdcfdec335b8ed3fdb545c31a3f99131a"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081854 - [devtools] Add advanced settings section to the new settings inventory r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nLeave out disabling JavaScript for now, we add it in a later patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337580\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/inventory.mjs"], "git_node": "f0f9a9749d338b39e44258d7ad98751d7c2c8c51", "git_parents": ["a7595b1c7190dca80d47f49f11b3db285fc3051f"], "node": "04a05aa2f86edc1ba455fbbd88e99f51ac857bf4", "parents": ["a2c41f6826b129829f21ff7fc4bdc9051e4d45e1"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081854 - [devtools] Add disable JavaScript to the new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337581\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-disable-javascript.mjs", "devtools/client/settings/components/devtools-settings-disable-javascript.tagmap.d.ts", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/panel.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_disable_javascript.js", "devtools/client/settings/types/inventory.d.ts", "devtools/client/settings/types/toolbox.d.ts"], "git_node": "b0cf97d090b6d2d27e22dcaf58f818ea035cad5e", "git_parents": ["f0f9a9749d338b39e44258d7ad98751d7c2c8c51"], "node": "09eeb117ffe35a254e5e1704fc44774588bdbeb4", "parents": ["04a05aa2f86edc1ba455fbbd88e99f51ac857bf4"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2085315 - Store an all-zero Value from the zero register on arm64. r=jandem\n\nTemplate objects often hold slots whose Value bits are all zero, and\nstoreValue(const Value&) materialized the zero in a scratch register before\nevery such store:\n\n  mov x16, #0\n  str x16, [x0, #0x18]\n\nStore it through storePtr(ImmWord(0)) instead, which the arm64 backend\nalready emits as a store of xzr. fillSlotsWithConstantValue gets the same\ntreatment for runs of zero slots, so it no longer needs to load the temp.\n\nOn a JetStream 3 run on arm64 this removes about 1,200 instructions from\nIon code and turns 3,500 slot stores into stores of xzr.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336933\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "48329e040138d6eb2e2880b58abf47d4ea4f3b1e", "git_parents": ["b0cf97d090b6d2d27e22dcaf58f818ea035cad5e"], "node": "30ea1d097b75a5c080726caabc43aa3de08cef71", "parents": ["09eeb117ffe35a254e5e1704fc44774588bdbeb4"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086225 - Add telemetry for the 'Save security codes' setting. r=mtigley,settings-reviewers,credential-management-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338044\n", "files": ["browser/components/preferences/config/passwords-autofill.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvvPreference.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/unit/test_savedCreditCardCounts.js", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "2ee8679ed1e2a424a6e84891ddc2a2265bf836b6", "git_parents": ["48329e040138d6eb2e2880b58abf47d4ea4f3b1e"], "node": "9cbeb77ff136080a797cc2174d4d392939db3ae2", "parents": ["30ea1d097b75a5c080726caabc43aa3de08cef71"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086765 - Implement the text-autospace-size property. r=firefox-style-system-reviewers,layout-reviewers,dshin,emilio,TYLin,devtools-reviewers,nchevobbe\" for causing mochitest failures @ test_animation-type-longhand.html\n\nThis reverts commit c50dfe132013be94e0ae2bef3a1a9f365d77e8de.\n", "files": ["devtools/server/actors/animation-type-longhand.js", "dom/base/use_counter_metrics.yaml", "gfx/src/nsFontMetrics.cpp", "gfx/src/nsFontMetrics.h", "layout/base/nsPresContext.cpp", "layout/generic/nsTextFrame.cpp", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/style/test/property_database.js", "layout/style/test/test_transitions_per_property.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/data.py", "servo/components/style/properties/longhands.toml", "testing/web-platform/meta/css/css-text/text-autospace/__dir__.ini", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-computed.html", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-invalid.html", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-valid.html", "testing/web-platform/tests/css/css-text/text-autospace/crashtests/text-autospace-size-huge-crash.html", "testing/web-platform/tests/css/css-text/text-autospace/text-autospace-size-001-ref.html", "testing/web-platform/tests/css/css-text/text-autospace/text-autospace-size-001.html"], "git_node": "305af13b8e619a4b376121a903517da0c97bd3a7", "git_parents": ["2ee8679ed1e2a424a6e84891ddc2a2265bf836b6"], "node": "f29c640b2991050823447c95a2ac201f84808a52", "parents": ["9cbeb77ff136080a797cc2174d4d392939db3ae2"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079375 part 1 - Move the WebDriver BiDi moz:debugging code into a shared DebugSession module in js/src/debugger. r=jdescottes,webdriver-reviewers,bthrall\n\nThe WebDriver BiDi moz:debugging module implements a small debugger on top of the\nDebugger API. Move the core of this into js/src/debugger/DebugSession.sys.mjs\nbehind a small host interface, so that it has no Gecko dependencies and can also\nrun in the JS shell.\n\nLater patches will use this to only expose this higher-level debugger API in the\nJS shell when `--fuzzing-safe` is used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331684\n", "files": ["js/src/debugger/DebugSession.sys.mjs", "js/src/debugger/moz.build", "remote/webdriver-bidi/modules/windowglobal/moz/debugging.sys.mjs"], "git_node": "c0fe5087469e6c8e09155a69a5866a7975630a84", "git_parents": ["305af13b8e619a4b376121a903517da0c97bd3a7"], "node": "0fe7b8c9cf80ac78228cc64c13a3c6e26cb4536b", "parents": ["f29c640b2991050823447c95a2ac201f84808a52"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079375 part 2 - Add JS shell functions for the DebugSession module. r=bthrall\n\nThis adds `debugSessionCreate(global)` and `debugSessionCommand(command, arg)`\nto the shell. They implement a debugger built on the `DebugSession` module\nshared with WebDriver BiDi.\n\nThis API is meant to replace the full Debugger API for fuzzing, so it is\ndesigned so that untrusted scripts can't get to the Debugger API objects and\ncan't change the session during a pause. The only code running during a pause\nis debuggee code from 'evaluate' actions, like in a debugger console.\n\nThe module runs in a hidden global, invisible to debuggers, together with\na small shell host (DebugSessionHost.js). Both are embedded in the shell binary.\nOnly JSON strings cross the boundary of this hidden global.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331685\n", "files": ["js/src/jit-test/lib/debug-session.js", "js/src/jit-test/tests/debug/DebugSession-breakpoints.js", "js/src/jit-test/tests/debug/DebugSession-evaluate.js", "js/src/jit-test/tests/debug/DebugSession-scripts.js", "js/src/jit-test/tests/debug/DebugSession-stepping.js", "js/src/shell/DebugSession.cpp", "js/src/shell/DebugSession.h", "js/src/shell/DebugSessionHost.js", "js/src/shell/embed_source.py", "js/src/shell/js.cpp", "js/src/shell/jsshell.h", "js/src/shell/moz.build", "tools/lint/spidermonkey/check_spidermonkey_style.py"], "git_node": "3c23a6080804c23fdd19f38f632e23898044d0c3", "git_parents": ["c0fe5087469e6c8e09155a69a5866a7975630a84"], "node": "6d46a752418e46f7a0e5666f5338439b79c9506d", "parents": ["0fe7b8c9cf80ac78228cc64c13a3c6e26cb4536b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079375 part 3 - Don't expose the Debugger API with --fuzzing-safe. r=bthrall\n\nAI testing is finding many Debugger API issues that don't affect real-world debugger uses.\nWith `--fuzzing-safe`, we now no longer define the `Debugger` constructor.\n\nThe debug session API, which is more similar to how WebDriver BiDi uses the\nDebugger API, is the only debugger left.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331686\n", "files": ["js/src/jit-test/tests/cacheir/bug2002748.js", "js/src/jit-test/tests/debug/DebugSession-fuzzing-safe.js", "js/src/jit-test/tests/debug/bug-1904011.js", "js/src/jit-test/tests/debug/bug-2001969.js", "js/src/jit-test/tests/debug/bug1353356.js", "js/src/jit-test/tests/debug/bug2046626.js", "js/src/jit-test/tests/debug/onStep-interrupt-fuzzing-safe.js", "js/src/jit-test/tests/gc/bug-1491326.js", "js/src/jit-test/tests/gc/bug-1877406.js", "js/src/shell/js.cpp"], "git_node": "0c6da3736e11c9d32d985fe83ad814ebe2d5bbc7", "git_parents": ["3c23a6080804c23fdd19f38f632e23898044d0c3"], "node": "92b7aabc1d819fc6395cd617cfeb93e4834cbaae", "parents": ["6d46a752418e46f7a0e5666f5338439b79c9506d"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079375 part 4 - Support pausing on exceptions in the DebugSession module. r=bthrall\n\nAdd `setPauseOnExceptions(mode)` to the `DebugSession` module, with the modes\n\"none\" (the default), \"uncaught\" and \"all\". This is a minimal version of\nwhat DevTools does. The serialized exception is included in the pause data.\n\nWebDriver BiDi doesn't use this yet but we expose it in the shell so that fuzzing\ncovers exception unwinding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331687\n", "files": ["js/src/debugger/DebugSession.sys.mjs", "js/src/jit-test/tests/debug/DebugSession-exceptions.js", "js/src/shell/DebugSessionHost.js", "js/src/shell/js.cpp"], "git_node": "317011aa80909157ca4553993647f1a23333bc7c", "git_parents": ["0c6da3736e11c9d32d985fe83ad814ebe2d5bbc7"], "node": "4f9a6df98a9b657ea03858a084ba7e52f92ce70b", "parents": ["92b7aabc1d819fc6395cd617cfeb93e4834cbaae"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079375 part 5 - Don't lose scope variables named __proto__ in the DebugSession module. r=jdescottes,bthrall\n\nThis is fixing a pre-existing issue in the BiDi code. We collect variables with\n`scope.variables[name] = value`, so a variable named `__proto__` set the\nprototype of the variables object instead of adding a property, and was\nmissing from the pause data. Use an object without prototype instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331688\n", "files": ["js/src/debugger/DebugSession.sys.mjs", "js/src/jit-test/tests/debug/DebugSession-proto-variable.js"], "git_node": "d3a3e695066c0ff1de10c14ac9bd27de64d2cb29", "git_parents": ["317011aa80909157ca4553993647f1a23333bc7c"], "node": "438a6fe2a5e610faabc35a6d8e4f5c68209f36c1", "parents": ["4f9a6df98a9b657ea03858a084ba7e52f92ce70b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079375 part 6 - Support Wasm code in the DebugSession module. r=bthrall\n\n`Debugger.Script.prototype.url` only supports JS scripts. Use the URL of the\n`Debugger.Source` for Wasm scripts. This should also improve WebDriver BiDi\nsupport for Wasm a bit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331689\n", "files": ["js/src/debugger/DebugSession.sys.mjs", "js/src/jit-test/tests/debug/DebugSession-wasm.js"], "git_node": "f555c91ef6662be4b02ec8ad658ff72a35ed4b83", "git_parents": ["d3a3e695066c0ff1de10c14ac9bd27de64d2cb29"], "node": "3ce5a5589f2402e24fb69b7d8dfed3803030134c", "parents": ["438a6fe2a5e610faabc35a6d8e4f5c68209f36c1"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2087379 - Add reproducibility checks for android builds. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338218\n", "files": ["taskcluster/kinds/build/android.yml", "taskcluster/kinds/diffoscope/reproducible.yml"], "git_node": "693f4b0e9f5497299d4461280a2b69c1456cdb50", "git_parents": ["f555c91ef6662be4b02ec8ad658ff72a35ed4b83"], "node": "a904a8ebd3404af41ff1898122cead03e9b26990", "parents": ["3ce5a5589f2402e24fb69b7d8dfed3803030134c"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085038 - Skip un-decodable records in SSLTokenCache.Get instead of failing r=necko-reviewers,valentin,leggert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336206\n", "files": ["netwerk/base/SSLTokensCache.cpp", "netwerk/test/gtest/TestSSLTokensCache.cpp"], "git_node": "a4b3416e0343acd1731870b4da658e75ac0bd0b3", "git_parents": ["693f4b0e9f5497299d4461280a2b69c1456cdb50"], "node": "1ab01ab0d97cfe24cd475bd1c58073a4c61a7c5a", "parents": ["a904a8ebd3404af41ff1898122cead03e9b26990"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087430 - Accept form resubmission prompts in the web-platform profile. r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338256\n", "files": ["testing/profiles/web-platform/user.js"], "git_node": "82f06b8238824fa17210dca64f4d604f0dc45e6d", "git_parents": ["a4b3416e0343acd1731870b4da658e75ac0bd0b3"], "node": "c3a3a523f41deb648230cd66ff4d3702fe779452", "parents": ["1ab01ab0d97cfe24cd475bd1c58073a4c61a7c5a"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086765 - Implement the text-autospace-size property. r=firefox-style-system-reviewers,layout-reviewers,dshin,emilio,TYLin,devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337722\n", "files": ["devtools/server/actors/animation-type-longhand.js", "dom/base/use_counter_metrics.yaml", "gfx/src/nsFontMetrics.cpp", "gfx/src/nsFontMetrics.h", "layout/base/nsPresContext.cpp", "layout/generic/nsTextFrame.cpp", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/style/test/property_database.js", "layout/style/test/test_transitions_per_property.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/data.py", "servo/components/style/properties/longhands.toml", "testing/web-platform/meta/css/css-text/text-autospace/__dir__.ini", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-computed.html", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-invalid.html", "testing/web-platform/tests/css/css-text/parsing/text-autospace-size-valid.html", "testing/web-platform/tests/css/css-text/text-autospace/crashtests/text-autospace-size-huge-crash.html", "testing/web-platform/tests/css/css-text/text-autospace/text-autospace-size-001-ref.html", "testing/web-platform/tests/css/css-text/text-autospace/text-autospace-size-001.html"], "git_node": "6ccf95b9ebde6559ef917c9dcd254b395e87362f", "git_parents": ["82f06b8238824fa17210dca64f4d604f0dc45e6d"], "node": "12c0286b4d9bd3aa311dd72bee20716b7fe6e3c1", "parents": ["c3a3a523f41deb648230cd66ff4d3702fe779452"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085038 - Skip un-decodable records in SSLTokenCache.Get instead of failing r=necko-reviewers,valentin,leggert\" for causing build bustages @ TestSSLTokensCache.cpp\n\nThis reverts commit a4b3416e0343acd1731870b4da658e75ac0bd0b3.\n", "files": ["netwerk/base/SSLTokensCache.cpp", "netwerk/test/gtest/TestSSLTokensCache.cpp"], "git_node": "1c25d5ce85302f3c4b032aa0ecac7b600c56fd34", "git_parents": ["6ccf95b9ebde6559ef917c9dcd254b395e87362f"], "node": "517cd947cbad1a073559dce41a699afb0720c68e", "parents": ["12c0286b4d9bd3aa311dd72bee20716b7fe6e3c1"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083664 - Make SidebarManager.getBackupState always return an object. r=sidebar-reviewers,kcochrane\n\n`getBackupState()` returned `null` when the `sidebar.backupState` pref was unparsable or was the literal \"null\". `startDelayedLoad` passes that value to `updateUIState(state = {})`, and a default parameter doesn't apply to `null`, so it threw a TypeError.\n\n`getBackupState()` now resets the pref and returns `{}` whenever the stored value isn't a JSON object.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335089\n", "files": ["browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_sidebar_backup_state.js"], "git_node": "12efb27364dc23b6ad55b7cb5ca6c3a549dc0639", "git_parents": ["1c25d5ce85302f3c4b032aa0ecac7b600c56fd34"], "node": "e7191ebe1f50dc828acafa576bef9e0a1936073f", "parents": ["517cd947cbad1a073559dce41a699afb0720c68e"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079871 - Add a smoother transition from square to rounded corner of the content area when opening/closing the sidebar r=desktop-theme-reviewers,sidebar-reviewers,akulyk,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337716\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js", "browser/themes/shared/sidebar.css"], "git_node": "0d26600e4c1e2ba6acc5019bb96d6519eaa72860", "git_parents": ["12efb27364dc23b6ad55b7cb5ca6c3a549dc0639"], "node": "6d245325e3ff0e3044a99cc448cefd5bb5b533d0", "parents": ["e7191ebe1f50dc828acafa576bef9e0a1936073f"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087032 - Don't let ConcurrentConnection open or leave a connection open during shutdown. r=places-reviewers,jteow\n\nPlaces notifies places-init-complete again at profile-change-teardown, before\nConcurrentConnection's shutdown blocker runs, which could make it start opening\nplaces.sqlite. The blocker was then removed while the open was in progress, and\nthe connection was only closed once the open completed, which nothing waited\nfor, so it could still be opening at xpcom-shutdown-threads.\nDon't open the connection once shutdown is confirmed, and keep blocking\nshutdown until an in-progress open or close is completed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337949\n", "files": ["toolkit/components/places/ConcurrentConnection.cpp", "toolkit/components/places/ConcurrentConnection.h"], "git_node": "627a616617e0659d64582c743fe517d48783aa39", "git_parents": ["0d26600e4c1e2ba6acc5019bb96d6519eaa72860"], "node": "06836f6e945bd04f0cf46dc21c7a2427f0499ada", "parents": ["6d245325e3ff0e3044a99cc448cefd5bb5b533d0"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2084881 - Replace std::usize::MAX with usize::MAX. r=decoder\n\nFixes:\nerror: use of deprecated constant `std::usize::MAX`: replaced by the `MAX` associated constant on this type\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336111\n", "files": ["tools/fuzzing/rust/src/lib.rs"], "git_node": "f336e157b834cb3228a644f1e210aac26ddd1355", "git_parents": ["627a616617e0659d64582c743fe517d48783aa39"], "node": "b4db021af2f0f09ad639b34afc41f7c8e50a1118", "parents": ["06836f6e945bd04f0cf46dc21c7a2427f0499ada"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087393 - Use this rather than magic for theming code. r=desktop-theme-reviewers,dao\n\nNo behavior change, but less magic :)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336534\n", "files": ["browser/base/content/browser.xhtml", "toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": "982679fade6224e1fd52e68d7136b4e01c1dd07f", "git_parents": ["f336e157b834cb3228a644f1e210aac26ddd1355"], "node": "2ea5565cec9ec507650adaabada5cc9caf30ab43", "parents": ["b4db021af2f0f09ad639b34afc41f7c8e50a1118"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084583 - [devtools] Check if container for node exists before updating it. r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338264\n", "files": ["devtools/client/inspector/markup/markup.js"], "git_node": "e024d545970631bfe53b232e927ccdc84d1555bf", "git_parents": ["982679fade6224e1fd52e68d7136b4e01c1dd07f"], "node": "70b6319ee7841c4e6982dddb66e1b864be6cdcad", "parents": ["2ea5565cec9ec507650adaabada5cc9caf30ab43"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087126 - VPN remains blocked in No internet error state send time Work Offline is enabled - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338138\n", "files": ["browser/components/ipprotection/IPProtectionAlertManager.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_alert_manager.js"], "git_node": "9f1a86956a87238600231077067b35d1bd74454a", "git_parents": ["e024d545970631bfe53b232e927ccdc84d1555bf"], "node": "8651f40c12c43af2eb9ede0d296217f3a02a5b54", "parents": ["70b6319ee7841c4e6982dddb66e1b864be6cdcad"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080071 - Scope semantic history search to a domain when the query starts with an origin. r=places-reviewers,mak,urlbar-reviewers\n\nWhen browser.urlbar.suggest.semanticHistory.domainScopedSearch is enabled, a search like \"github.com/some-topic\" or \"github.com some topic\" only scores pages from that domain and its subdomains, using the remaining text as the query. Those pages are scored directly rather than through the KNN index, whose global nearest neighbors may not include any page from the domain.\n\nThere must be at least 4 characters after the domain name. Currently we don't strip the slashes in the latter part of the url component, but we could consider that in the future\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332303\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarProviderSemanticHistorySearch.sys.mjs", "browser/components/urlbar/UrlbarTokenizer.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarProviderSemanticHistorySearch.js", "browser/components/urlbar/tests/unit/test_tokenizer.js", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/places/PlacesSemanticHistoryManager.sys.mjs", "toolkit/components/places/tests/unit/test_PlacesSemanticHistoryManager.js"], "git_node": "bdb7df641d5d0658fb775ec3175b37eed5863ba4", "git_parents": ["9f1a86956a87238600231077067b35d1bd74454a"], "node": "dd6ce84e6ba7f086ff8d72ff1679675a12d9a03d", "parents": ["8651f40c12c43af2eb9ede0d296217f3a02a5b54"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081733 - Adjust themes list view sections styling to better match the card-looking style from the related Figma specs. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333671\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-picker.css", "toolkit/mozapps/extensions/content/components/recommended-themes-section.mjs"], "git_node": "06a6a32c08e4729d5370bfb83db5ee823548ada1", "git_parents": ["bdb7df641d5d0658fb775ec3175b37eed5863ba4"], "node": "f4d485c810ef53c61a9651299dabdb4faa03dc6f", "parents": ["dd6ce84e6ba7f086ff8d72ff1679675a12d9a03d"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081734 - Make recommended themes section in themes list view an accordion-type moz-card. r=willdurand,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333673\n", "files": ["python/l10n/fluent_migrations/bug_2081734_recommended_themes_card_heading.py", "toolkit/locales/en-US/toolkit/about/aboutAddons.ftl", "toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/mozapps/extensions/content/components/recommended-themes-section.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_list_view_recommendations.js"], "git_node": "715998f49d053aa97b3fa760e15f590455db90a9", "git_parents": ["06a6a32c08e4729d5370bfb83db5ee823548ada1"], "node": "67b4ca28ceb910ce8119805dfc8af854eb5483f9", "parents": ["f4d485c810ef53c61a9651299dabdb4faa03dc6f"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081734 - Make disabled themes section in themes list view an accordion-type moz-card and change enabled themes localized section heading. r=willdurand,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333674\n", "files": ["python/l10n/fluent_migrations/bug_2081734_disabled_themes_card_heading.py", "toolkit/locales/en-US/toolkit/about/aboutAddons.ftl", "toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/mozapps/extensions/content/aboutaddons.mjs", "toolkit/mozapps/extensions/content/components/addon-card.mjs", "toolkit/mozapps/extensions/content/components/addon-list.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_list_view.js", "toolkit/mozapps/extensions/test/browser/head.js"], "git_node": "6520cc9bd70cc3c819646155a8077e17f1d74dea", "git_parents": ["715998f49d053aa97b3fa760e15f590455db90a9"], "node": "2de12d06e79cc2c88a30aeb09d0920fcc291906a", "parents": ["67b4ca28ceb910ce8119805dfc8af854eb5483f9"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087123 - Support try presets in `./mach try perf`. r=sparky,perftest-reviewers\n\nThis lets `./mach try perf` load fuzzy presets such as `sm-perf`. This is useful\nfor the team because now we can run `./mach try --preset sm-perf` for the most\ncommon cases.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338040\n", "files": ["testing/perfdocs/generated/mach-try-perf.md", "testing/performance/mach-try-perf/perfdocs/index.md", "tools/tryselect/mach_commands.py", "tools/tryselect/selectors/perf.py", "tools/tryselect/test/test_presets.py"], "git_node": "93ff10f39fe4b9b0f1a930df47c5065ad534cea0", "git_parents": ["6520cc9bd70cc3c819646155a8077e17f1d74dea"], "node": "2a8eb1b70f4f490956aad37115ba35000bf87e43", "parents": ["2de12d06e79cc2c88a30aeb09d0920fcc291906a"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2084276 - Fetch per-architecture crashreporter symbols for macOS tests of universal builds. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335702\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py"], "git_node": "ab9ddb6741131797996ac17b7a500141fb0b2ab8", "git_parents": ["93ff10f39fe4b9b0f1a930df47c5065ad534cea0"], "node": "0fca4dd478e84a64e2f54b5e60203b0029175fd2", "parents": ["2a8eb1b70f4f490956aad37115ba35000bf87e43"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2081774 - Run all raptor a55 tests at LT by default. r=kshampur,perftest-reviewers\n\nThis patch removes the transform we've been using to run tests at LT. Instead, LT is now the default and no other performance tests in the raptor harness should be running at bitbar unless explicitly requested (e.g. through another transform).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334143\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py", "taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/browsertime/mobile.yml", "testing/perfdocs/generated/performance-infrastructure.md", "testing/perfdocs/generated/raptor.md"], "git_node": "31517def0d03f32c224fbee022b726a6e5312d01", "git_parents": ["ab9ddb6741131797996ac17b7a500141fb0b2ab8"], "node": "ebec9b57e3538c3e24ad8057589d8881d6b45e20", "parents": ["0fca4dd478e84a64e2f54b5e60203b0029175fd2"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086118 - Factor out the functions adding the common annotations r=afranchuk,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337190\n", "files": ["toolkit/crashreporter/crash_helper_server/src/crash_generation.rs"], "git_node": "397ab0e7c9107d5399f25ab9ce5805fae7a194a3", "git_parents": ["31517def0d03f32c224fbee022b726a6e5312d01"], "node": "0189022fc3d38022a5fb5522ee11473914b00cf1", "parents": ["ebec9b57e3538c3e24ad8057589d8881d6b45e20"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086118 - Let the crash helper populate the process uptime annotation r=afranchuk,crashreporting-reviewers\n\nThe macOS implementation requires a small C stub as it uses a syscall to\nread the `kinfo_proc` structure of the target process. This structure\ndoesn't have a Rust representation yet and is *huge*, so making a\ndedicated copy of its layout just for this use-case would have been\noverkill.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337191\n", "files": ["toolkit/crashreporter/crash_helper/crashhelper.cpp", "toolkit/crashreporter/crash_helper_server/build.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/linux.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/macos.c", "toolkit/crashreporter/crash_helper_server/src/crash_generation/macos.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/test/unit/test_crashreporter_crash.js"], "git_node": "b400ca35043cbb0c4fb34fdd0b682283d6a344cc", "git_parents": ["397ab0e7c9107d5399f25ab9ce5805fae7a194a3"], "node": "6e338e3a332bbeed6afb7c64be2dd3cc531854ee", "parents": ["0189022fc3d38022a5fb5522ee11473914b00cf1"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087393 - Use this rather than magic for theming code. r=desktop-theme-reviewers,dao\" for causing bc failures @ browser_ext_themes_pbm.js\n\nThis reverts commit 982679fade6224e1fd52e68d7136b4e01c1dd07f.\n", "files": ["browser/base/content/browser.xhtml", "toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": "eed57099f5fd90b156725aeb1a25472dce631370", "git_parents": ["b400ca35043cbb0c4fb34fdd0b682283d6a344cc"], "node": "09edafd4f44481dd8cc968c97cb7b95dbbe6e86d", "parents": ["6e338e3a332bbeed6afb7c64be2dd3cc531854ee"], "tags": []}], "date": 1793377344, "git_changesets": ["05bcc8025371ba4e55715a51ba5654b440f92a73", "1097a1e5ec5cd8efb1f5400d20c00dfa28c18df2", "bc1342a7074b6d3ef8f9bcad24b96e19da97e256", "c1415610245cc3207417a0aee82487ebd09e7d63", "663ab6b859911e2f14444850172c7f6139924eae", "924e373ba49436c5308ca93ce72297c4ca61caff", "426a9a20545a05d16eebfafe80967039df95546d", "cacdf904147e3855f7099a6255404b3c2745cadf", "32124795362be34958a1357b79b2bc8f948a8781", "f5928463d742a1ef9b8da1c78386c6bdb8037a53", "2ef604e724f554a015ebcfdd04c76b5d78c8154d", "0e3e49d0bccbe1e94e1042b8aa7c09c4c5c6146e", "965abe2c46680bd84b1d00cde3e341003414d816", "83cc943ef56a8b21f9600986daa06f4c3ccb9977", "91b178a3af9f817c9b0ac5910e901f7269ea058f", "a299181eb4b5dc7dc10dfbc2775a187d4241f636", "e97662c6aff53b56dcc204c12fd61cb1601f400c", "b4616f13f2de0169d049f3e2f8b8b2031c725929", "96d263f707814e785f4a55fb7bf09d06ae88e6fe", "00547b3535191b23beb0be4a0c3e51657c262986", "d5f1cb02c5666bc59dab575926b7b5b2028be8f7", "1ff811b407a6fef2cfceaecb3001bc76de91ac10", "512760f462f7a0d801821cf226060027ef419fea", "a4d94f737c8b0618cbb7964ae0bd17580cb9568f", "e7c574faba51ec8c2ebdc95c499e98fbf0af69ac", "92dd8b19b278a57864a3ab80e2f7eb03ab440cdd", "6e1894f5fe91032b0527a5a522dca29c7e828166", "b4b2b5591ce497eda46b94c919c42c230d394a5e", "deded938efb7658ba1fe6c1eeb88b927e288b0c2", "fa3e3302abd171b3846643be047bb66be7891f46", "1e0443cd79280780cc82a90d354e9d9302cbf3cb", "21c6355615995df430ee7071d95a0a7c517f4cb1", "6b4a6d87fdb0390c1e78fbbfbcaf9255b27bd04e", "8100386729139d7eb965dfb49cfd5bd14cf9ad36", "7fb30e8fbc4dcceef8759e12177aaccb592c900d", "919e7330196d57eff007109b794a4da58d9fc98e", "e694d9a963f05f5a062996d7b4dde5c497a767e7", "1f9b2e204fbe3df0f45eb623