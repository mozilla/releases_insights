d82ade8b73cc10166be3c838580025eb899350", "git_parents": ["f3d4d7e93fddfdbba818ec16b20af3c91e56d498"], "node": "9682188370ed695350560b4c241b927934ca1b2e", "parents": ["9e053d97bc6eab6867528b06ea8cbd2ef64430ea"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085358 - Use clang flags rather than an env var to point to the sysroot. r=firefox-build-system-reviewers,ahochheiden\n\nThis makes clangd works properly with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336392\n", "files": ["build/midl.py", "build/moz.configure/bindgen.configure", "build/moz.configure/toolchain.configure", "build/moz.configure/windows-toolchain.configure", "build/moz.configure/windows.configure", "config/config.mk"], "git_node": "5e406c92f7d428cfb144c01934fb8b3948c33a99", "git_parents": ["8cd82ade8b73cc10166be3c838580025eb899350"], "node": "1630716311f57e05f950ba6339f9349f0f00e25a", "parents": ["9682188370ed695350560b4c241b927934ca1b2e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085351 - Let legacy fontconfig font removal ride the trains. r=lsalzman\n\nBug 2082557 has been the only serious issue we've found from it on\nnightly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336389\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "18ef3c7f45ef133ad545d78877ea90c21d3d2f5b", "git_parents": ["5e406c92f7d428cfb144c01934fb8b3948c33a99"], "node": "ae691c1b7ad53835d02f205db7b0f6fdf9c97edc", "parents": ["1630716311f57e05f950ba6339f9349f0f00e25a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081281 - Enable save-as-pdf page sizes on android. r=layout-reviewers,dshin\n\nOnly reason why they weren't was risk aversion (D195181), but the\nsave-as-pdf path is the same as on desktop so we should be consistent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336332\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "625aa593837ea90500495024aa375d3234609517", "git_parents": ["18ef3c7f45ef133ad545d78877ea90c21d3d2f5b"], "node": "6be3dc085f40eaf22b98f71860dc6eccfe12cc8a", "parents": ["ae691c1b7ad53835d02f205db7b0f6fdf9c97edc"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084964 - Make nsProgressFrame::ReflowChildFrame work on logical coordinates. r=jfkthame,layout-reviewers\n\nThis caught an issue on how progress/meter bar deals with margins in\nrtl, it now works in the same way as in e.g. block layout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336150\n", "files": ["layout/forms/nsProgressFrame.cpp", "layout/forms/nsProgressFrame.h", "layout/reftests/forms/meter/bar-pseudo-element-vertical-rtl-ref.html", "layout/reftests/forms/progress/bar-pseudo-element-vertical-rtl-ref.html", "widget/Theme.cpp"], "git_node": "6df171e7774a36be04dc6f1b1295e368344a8e6c", "git_parents": ["625aa593837ea90500495024aa375d3234609517"], "node": "59b218c01aecb7dfac8ecb47df4a36f396eece02", "parents": ["6be3dc085f40eaf22b98f71860dc6eccfe12cc8a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2084807 - Reduce the duration of browser_akamai_waf_telemetry.js and request a longer timeout r=necko-reviewers,jesup\n\nThe test opens a new tab per scenario, which exceeds the timeout in chaos mode\non macOS debug test-verify runs. The pref-disabled checks don't depend on the\nHTTP version, so they now run against a single server.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336110\n", "files": ["netwerk/test/browser/browser_akamai_waf_telemetry.js"], "git_node": "956a72ae0616a2280bd5c0d925bf72bab7ece8c5", "git_parents": ["6df171e7774a36be04dc6f1b1295e368344a8e6c"], "node": "825862d5566cbe1ef8f7aa9a29656b520635ac0e", "parents": ["59b218c01aecb7dfac8ecb47df4a36f396eece02"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081216 - Move the app update tests' mock install dir and continue files to the temp dir, r=application-update-reviewers,spohl.\n\nThe mock install dir, the launch script, the callback app's argument log and the continue files for slow update checks and downloads were all created inside the test directory, which is shared by tests running in parallel. Put them in the per-test temp directory instead. That directory is already unique to each test and removed by the harness, so the test-named subdirectory and the removal of the install dir's parent are only kept for the Program Files location used by the maintenance service tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333295\n", "files": ["toolkit/mozapps/update/tests/data/app_update.sjs", "toolkit/mozapps/update/tests/data/shared.js", "toolkit/mozapps/update/tests/data/sharedUpdateXML.js", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js"], "git_node": "3369e0022d84aca7e0cf4b19a77136bbd7308fc2", "git_parents": ["956a72ae0616a2280bd5c0d925bf72bab7ece8c5"], "node": "254ae805304d776ca5ed76c582901878caa21943", "parents": ["825862d5566cbe1ef8f7aa9a29656b520635ac0e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2081216 - Create the app update symlink fixtures in the temp dir instead of /tmp, r=application-update-reviewers,spohl.\n\nTestAUSHelper's setup-symlink and remove-symlink commands created the symlink targets under hardcoded /tmp/moz-foo and /tmp/moz-foo2 directories, so marStageSuccessComplete.js and marAppInUseStageSuccessComplete_unix.js removed each other's fixtures when running in parallel. Pass the base directory as an argument and use the per-test temp dir, so marStageSuccessComplete.js no longer needs to run sequentially on Linux.\n\n