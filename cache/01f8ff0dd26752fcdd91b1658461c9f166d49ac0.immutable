ut/src/webgpu/shader/execution/expression/call/builtin/buffer_view_utils.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/builtin/subgroupBroadcast.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/mixed_type_aliasing_utils.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/execution/expression/call/user/ptr_aliasing.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/expression/unary/address_of_and_indirection.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/functions/alias_analysis.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/functions/restrictions.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/shader/validation/uniformity/uniformity.spec.ts", "dom/webgpu/tests/cts/checkout/src/webgpu/web_platform/copyToTexture/ImageBitmap.spec.ts", "dom/webgpu/tests/cts/checkout/tools/gen_version", "dom/webgpu/tests/cts/moz.yaml", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/command_buffer/image_copy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/resource_init/texture_zero/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/service.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/buffer/mapping/shared.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/user/ptr_aliasing/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/expression/unary/address_of_and_indirection/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/functions/alias_analysis/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/functions/restrictions/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/validation/parse/requires/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/service.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/shared.https.html.ini", "testing/web-platform/mozilla/tests/webgpu/common/internal/version.js", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/api/validation/buffer/mapping/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/api/validation/buffer/mapping/dedicated.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/api/validation/buffer/mapping/service.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/api/validation/buffer/mapping/shared.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/shader/execution/expression/call/user/ptr_aliasing/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/shader/validation/functions/alias_analysis/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/cts.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/dedicated.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/service.https.html", "testing/web-platform/mozilla/tests/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/shared.https.html", "testing/web-platform/mozilla/tests/webgpu/webgpu/api/validation/buffer/mapping.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/capability_info.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/listing.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/builtin/bufferArrayView.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/builtin/bufferView.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/builtin/buffer_view_utils.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/builtin/subgroupBroadcast.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/mixed_type_aliasing_utils.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/execution/expression/call/user/ptr_aliasing.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/expression/unary/address_of_and_indirection.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/functions/alias_analysis.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/functions/restrictions.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/uniformity/uniformity.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/web_platform/copyToTexture/ImageBitmap.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/execution/expression/call/user/ptr_aliasing.as_worker.js"], "git_node": "ad68c0052dfcbca67b70e4958721fb40eb8def2f", "git_parents": ["ec3dc035521df23563b1f0d558fee70d4fa51ba5"], "node": "a68e48dfe34bb5b107ca2b6f6d59ca6b7082ff13", "parents": ["9b413210237f2957e5975d3263e377c847b531a2"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "2ddeeb1b93940ac0b0fe81522e80afb42258da7d", "git_parents": ["ad68c0052dfcbca67b70e4958721fb40eb8def2f", "6bb811006a50c49d09691d9066cfebbc1b2b1dcc"], "node": "0485c683537246bb67caa3337fbd93a8e610448a", "parents": ["a68e48dfe34bb5b107ca2b6f6d59ca6b7082ff13", "f6051ce1ac15a48ce146fa85e9e0eac911e27554"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080608 - Restore tabs that reference an unknown tab group. r=sessionstore-reviewers,tabbrowser-reviewers,sthompson\" for causing eslint failures in Tabbrowser.sys.mjs.\n\nThis reverts commit eeab674cf8ee30cbb6fabf9678177736d8f3d219.\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_tab_groups_restore_unknown_group_id.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "9d996d8b21df35ef0771a0c11eee92261138c79d", "git_parents": ["2ddeeb1b93940ac0b0fe81522e80afb42258da7d"], "node": "74414eccbffcffe8074399ebf2aeac5016e7d85f", "parents": ["0485c683537246bb67caa3337fbd93a8e610448a"], "tags": []}, {"author": "Alan Liu \u003chaoping.liu@amd.com\u003e", "branch": "default", "desc": "Bug 2086053 - [Wayland] Flush Wayland display after native layer commit r=stransky,gtk-reviewers\n\nNativeLayerRootWayland::CommitToScreenLocked() runs on the Renderer thread\nand commits the layer surfaces through WaylandSurfaceLock::Commit(), which\nnever flushes the Wayland display. The commit requests then wait in the\nclient buffer until an unrelated flush, usually the next main thread frame\ncallback commit. On a 24fps video on a 60Hz output about half of the frames\nreach the compositor one refresh late, so the on-screen cadence becomes\n1:4 instead of 3:2.\n\nFlush the display once after the native layer commit, as Mesa's\neglSwapBuffers() does on Wayland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337086\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "widget/gtk/WaylandSurfaceLock.cpp", "widget/gtk/WaylandSurfaceLock.h"], "git_node": "4218da725756369ac266ed311375225714b4fa44", "git_parents": ["9d996d8b21df35ef0771a0c11eee92261138c79d"], "node": "4b546abd6a70ca83bf945c2d33d73d77ae1e1623", "parents": ["74414eccbffcffe8074399ebf2aeac5016e7d85f"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085905 - Update New Tab section empty state for Nova. r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336883\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSEmptyState/DSEmptyState.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSEmptyState/_DSEmptyState.scss", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/DSEmptyState.test.jsx"], "git_node": "e5d422a672ea572999407ce317b30fa458aeaf27", "git_parents": ["4218da725756369ac266ed311375225714b4fa44"], "node": "d550853b7f31a45ee2b20b119ef7a53b42d2202c", "parents": ["4b546abd6a70ca83bf945c2d33d73d77ae1e1623"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085905 - Update strings for New Tab section empty state. r=fluent-reviewers,bolsson,jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337260\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSEmptyState/DSEmptyState.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSEmptyState/_DSEmptyState.scss", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "20efc8f680c82b16e24f0a0dddadd55c9be41666", "git_parents": ["e5d422a672ea572999407ce317b30fa458aeaf27"], "node": "d87ad64ed2c46aeefb0e7fcd077a1778cf04aef4", "parents": ["d550853b7f31a45ee2b20b119ef7a53b42d2202c"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086336 - Update NSS to ec3e5a9399c980345a5190d1a9969eaaa63bf3d1. UPGRADE_NSS_RELEASE r=nss-reviewers,jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337362\n", "files": ["security/nss/automation/abi-check/previous-nss-release", "security/nss/cmd/signver/signver.c", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/pkcs11u.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h", "security/nss/moz.yaml"], "git_node": "b0625683b9b8cd108f6b3fa9eedbcd4aa0066d6e", "git_parents": ["20efc8f680c82b16e24f0a0dddadd55c9be41666"], "node": "034aba04d78bb4327993de40c6d4abc7a1f7e0b2", "parents": ["d87ad64ed2c46aeefb0e7fcd077a1778cf04aef4"], "tags": []}], "date": 1793223039, "git_changesets": ["532638161e81e1fe049fc645f4747521ccea3098", "d11a66924b178a8643fab82851918057e69b4605", "2511cb15c44b122399e503a6b1e55e16bd18214d", "0b5ad54d7da09325228da06263baecaeee3559b5", "a362b3e9a326e51565e836aeb0c1b7befcbd02bf", "978e8e715fce2342537e652eebe994c1d4382982", "2412434d0e41affaaa57f9f3f52353c58ef4ca1f", "56b4cca1503ab17334fa4bdfe00e7801d31f9c42", "8ef0137f9a4cc04540099bdb03889f6c1623c061", "588ca0be4f0c15ec197110e4bcae770f734c5bb4", "e32d28fbc6ee8325ae71229014d7ea478ab06cd6", "6470fdebf7f16a1ba101694cdd3c8ea00ed93c5f", "b14ce7584c2aae2d8b5a569ef9e570abca0d8fd7", "2aaf1516463fafc94c1dbc80eb9e4ba7313f23b3", "30b7996447f8a6212d7577aff0d38c9f021aba0f", "73f8d2e43d6f0f0b8298013dd01d785fcd297f24", "abe226b3fc435019db4d24ca8843c006cad5b0ba", "2cafdc65efbf83290bf37cf391352b4beb587af5", "7ba4903c899aef6b13f56de70e385a04893a5435", "099964401b598081a701474e4cc020f9f974eb11", "04a8864f4248f586e353ae7bca001b4e2e2cf36d", "7942d75eb7814e5521b06c4a3f20730e4e45cfdb", "01f83e0326dd8e4d551e88effef6dcc43d220cc4", "56b114470de7f77a744d3652d3db08b2306cb7cf", "f6176fe3d657e397279524027a7717317e5be7df", "f70112a06d428542eedf9c1dd42166766b86e241", "78aa3c457a1d264dde4d89cfae5477766ee61ce4", "eeab674cf8ee30cbb6fabf9678177736d8f3d219", "da1273f7594f86927a4e74f8768e0a70fc2ca090", "1219580d439b0c5efb5d182237a6d68966fbc34d", "9cb0323765223510f2ff899f3d3fb405b5e83ace", "10dee32874ee6cda48d1f902724957e876094939", "8131035980847624eff9dc421240747e39bab605", "8d86f7f04acf324bddc444d11169692c497c0e19", "ec3dc035521df23563b1f0d558fee70d4fa51ba5", "ad68c0052dfcbca67b70e4958721fb40eb8def2f", "2ddeeb1b93940ac0b0fe81522e80afb42258da7d", "9d996d8b21df35ef0771a0c11eee92261138c79d", "4218da725756369ac266ed311375225714b4fa44", "e5d422a672ea572999407ce317b30fa458aeaf27", "20efc8f680c82b16e24f0a0dddadd55c9be41666", "b0625683b9b8cd108f6b3fa9eedbcd4aa0066d6e"], "user": "imoraru@mozilla.com"}, "45671": {"changesets": [{"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080904 - Add migration telemetry event for quatity migrated and quantity availble per resource. r=settings-reviewers,hjones,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334199\n", "files": ["browser/components/migration/360seMigrationUtils.sys.mjs", "browser/components/migration/ChromeProfileMigrator.sys.mjs", "browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/MigrationWizardChild.sys.mjs", "browser/components/migration/MigrationWizardParent.sys.mjs", "browser/components/migration/MigratorBase.sys.mjs", "browser/components/migration/SafariProfileMigrator.sys.mjs", "browser/components/migration/content/migration-dialog-window.js", "browser/components/migration/metrics.yaml", "browser/components/migration/tests/browser/browser.toml", "browser/components/migration/tests/browser/browser_resource_migrated_telemetry.js", "browser/components/migration/tests/browser/head.js", "browser/components/migration/tests/unit/head_migration.js", "browser/components/migration/tests/unit/test_360se_bookmarks.js", "browser/components/migration/tests/unit/test_Chrome_bookmarks.js", "browser/components/migration/tests/unit/test_Chrome_formdata.js", "browser/components/migration/tests/unit/test_Chrome_history.js", "browser/components/migration/tests/unit/test_Chrome_passwords.js", "browser/components/migration/tests/unit/test_Safari_bookmarks.js", "browser/components/migration/tests/unit/test_Safari_history.js", "browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/main.js"], "git_node": "0010b096c0518f93792894bcfb37908296c3f715", "git_parents": ["b0625683b9b8cd108f6b3fa9eedbcd4aa0066d6e"], "node": "380774351611d4ebbcd5f9b867b67f85a7126779", "parents": ["034aba04d78bb4327993de40c6d4abc7a1f7e0b2"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082972 - Share the notification helper profile guard across installations r=iholmes\n\nEach installation ships its own notification helper. The profile mutex name\nhashed the install directory together with the profile path. So two installs\nthat share a profile didn't see each other's mutex. Both helpers ran and\nfought over the same autopush connection.\n\nThe mutex name now uses the profile path only. The first helper to start wins\nand any other helper exits quietly. The stop events still include the install\ndirectory, so stopping a helper stays per install.\n\nA helper without this fix still uses the old name. Two helpers can run until\nboth installs have the fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337217\n", "files": ["toolkit/mozapps/pushnotificationhelper/src/lifecycle.rs", "toolkit/mozapps/pushnotificationhelper/src/main.rs"], "git_node": "1084f59d2f3026315c1ff1151efcf680301e24a8", "git_parents": ["0010b096c0518f93792894bcfb37908296c3f715"], "node": "12648e4373d24bf719a950db226a2a40b691e80c", "parents": ["380774351611d4ebbcd5f9b867b67f85a7126779"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082972 - Document the shared notification helper profile guard r=iholmes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337553\n", "files": ["toolkit/mozapps/pushnotificationhelper/docs/index.md"], "git_node": "8e412b7465171031051fb9bfbc0713486b82e009", "git_parents": ["1084f59d2f3026315c1ff1151efcf680301e24a8"], "node": "0479f8f4edea5aed13db36311d57a7778c9bd621", "parents": ["12648e4373d24bf719a950db226a2a40b691e80c"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082945 - Stop retrying Safari when remote automation is disabled. r=perftest-reviewers,sparky\n\nWhen \"Allow remote automation\" is off, browsertime and raptor kept retrying a\nSafari run that could never start. Raptor now stops on the first occurrence\nand prints the two ways to enable it: sudo safaridriver --enable, or Safari's\nDeveloper settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334554\n", "files": ["testing/raptor/raptor/browsertime/base.py", "testing/raptor/test/test_raptor.py"], "git_node": "5e250471de439386578aa581c86bdee49bc53aec", "git_parents": ["8e412b7465171031051fb9bfbc0713486b82e009"], "node": "1c5d5126ef4ac544a3ca8a3a4b57afb55c4382a1", "parents": ["0479f8f4edea5aed13db36311d57a7778c9bd621"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013287 - Run the YouTube playback tests on Android emulators on autoland. r=perftest-reviewers,sparky\n\nAdd browsertime-youtube-playback-mobile to the android-em-14-arm64 test set and\nrun the Fenix av1-sfr, hfr and vp9-sfr subtests on autoland at tier 3, using\nthe same subtests and hfr exclusions as the A55.\n\nGeckoView and the reference browser only define subtests for physical\ndevices, so limit them to android-hw platforms instead of creating empty\nemulator tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336217\n", "files": ["taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/test-sets.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "cacfe6147f9b9a4a29e5b2e537fad7e34e0079d2", "git_parents": ["5e250471de439386578aa581c86bdee49bc53aec"], "node": "4aff8dbab9d93a9972296bda0d9b342837ca83ad", "parents": ["1c5d5126ef4ac544a3ca8a3a4b57afb55c4382a1"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015146 - Run the foreground/background resource tests on Android emulators on autoland. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nAdd perftest-android-emulator-shippable-{foreground,background}-resource-fenix,\nrunning on autoland at tier 3 on the macOS arm64 emulator workers.\n\nThe only xmlstarlet toolchain is built for Linux, so the test script now falls\nback to xmllint, which ships with macOS, when xmlstarlet is not available.\nDevices that fetch xmlstarlet keep using it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336218\n", "files": ["taskcluster/kinds/perftest/android-emulator.yml", "testing/performance/android-resource/hooks_android_resource.py", "testing/performance/android-resource/test-android-resource-usage.sh"], "git_node": "a54ae4a3606abea098cb1c828320c73002273c8a", "git_parents": ["cacfe6147f9b9a4a29e5b2e537fad7e34e0079d2"], "node": "aca519a0c8fa99699fba6fcecd8e09a2c3cad9ca", "parents": ["4aff8dbab9d93a9972296bda0d9b342837ca83ad"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085939 - Remove chrome/CaR tp6m tests r=perftest-reviewers,taskgraph-reviewers,bhearsum,aglavic\n\nThis patch removes chrom* tp6m tests in an effort to run high value\ntests on our hardware. This saves approximately ~138 hours/month as a\nlower bound, from tasks running on cron.\n\nAdditoinally tasks that are no longer scheduled are cleaned up too,\nwhich would prevent accidental selection via Try\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337153\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/mobile.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/tp6/live/browsertime-live.toml", "testing/raptor/raptor/tests/tp6/mobile/browsertime-tp6m.toml"], "git_node": "56341d9f314fb7f9da634a7125f686f63c906086", "git_parents": ["a54ae4a3606abea098cb1c828320c73002273c8a"], "node": "3d6431504b494b3d8a903e8805f3271e4ceafd57", "parents": ["aca519a0c8fa99699fba6fcecd8e09a2c3cad9ca"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082390 - [customizable menu] Basic \"Customize menu\" screen. r=android-reviewers,android-l10n-reviewers,parker,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337075\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuItemColors.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuDragIndicator.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGridContainer.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGridGroupContent.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGridItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroupContent.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuListItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuListItemGroup.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuRowGroupContent.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_drag_indicator_24.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/customize/FenixCustomizeMenuFragment.kt"], "git_node": "30a6895226ff00ce66d13219c48b82cf04a8c32a", "git_parents": ["56341d9f314fb7f9da634a7125f686f63c906086"], "node": "539338ab5f6e40b76d0057ad157afe94cf55f01c", "parents": ["3d6431504b494b3d8a903e8805f3271e4ceafd57"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1999336 - Support inline-fragmented frames in view transitions. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nAs per spec.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337599\n", "files": ["dom/view-transitions/ViewTransition.cpp", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/style/res/ua.css", "testing/web-platform/meta/css/css-view-transitions/multiline-span-with-overflowing-text-and-box-decorations.html.ini", "testing/web-platform/tests/css/css-view-transitions/inline-with-block-child-new.html", "testing/web-platform/tests/css/css-view-transitions/inline-with-block-child-old.html", "testing/web-platform/tests/css/css-view-transitions/inline-with-block-child-ref.html"], "git_node": "8c619f2f598f264c2a16ccc9baebc9a138fe6b7f", "git_parents": ["30a6895226ff00ce66d13219c48b82cf04a8c32a"], "node": "fa442bddb1ce5ffa6ac005256c3266e39f77375b", "parents": ["539338ab5f6e40b76d0057ad157afe94cf55f01c"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086608 - Apply the try overrides for backstop and expanded pushes to the perf-cadence aliases. r=taskgraph-reviewers,bhearsum DONTBUILD\n\nPerf tasks reference the perf-cadence-* aliases rather than the\nunderlying strategies, so the tryselect overrides keyed on\nskip-unless-backstop and skip-unless-expanded no longer matched them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337594\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py"], "git_node": "61ec5138984e42a2de2985707dc43113217e0c8a", "git_parents": ["8c619f2f598f264c2a16ccc9baebc9a138fe6b7f"], "node": "3a5693dc96607e242ad924d1af3eb4ded967f351", "parents": ["fa442bddb1ce5ffa6ac005256c3266e39f77375b"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 1977827 - Queue at most one LargestContentfulPaint entry per paint r=bas\n\nEvery candidate larger than the current LCP size was queued as soon as\nit was finalized. Images while building the WebRender display list, and\ntext in `PresShell::EndPaint` while walking an unordered hash map. A\nsingle paint could therefore emit several entries, both across images\nand text and among text elements. The spec picks one candidate per\npaint, so keep the largest one pending and queue it at the end of the\npaint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337615\n", "files": ["dom/performance/LargestContentfulPaint.cpp", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceMainThread.h", "layout/base/PresShell.cpp", "testing/web-platform/tests/largest-contentful-paint/image-and-text-same-frame.html"], "git_node": "9db117d146c775f69a93bf4a6d2ae0a7a438745a", "git_parents": ["61ec5138984e42a2de2985707dc43113217e0c8a"], "node": "72363d2efc4e50987610149660480dd6520c52e0", "parents": ["3a5693dc96607e242ad924d1af3eb4ded967f351"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2086580 - Apply the accelerated canvas size limit to PDF.js. r=pdfjs-reviewers,marco\n\nCap maxCanvasDim at a positive gfx.canvas.accelerated.max-size when PDF.js\nhardware acceleration is enabled and canvases are actually accelerated.\nThis avoids requesting page canvases that DrawTargetWebgl rejects for\nexceeding that limit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337568\n", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_max_canvas_dim.js"], "git_node": "ad4747687452903d326bf69a8c20021395bd1686", "git_parents": ["9db117d146c775f69a93bf4a6d2ae0a7a438745a"], "node": "7e070dd8256e71784ba4ff2a78d0eccba2b73a26", "parents": ["72363d2efc4e50987610149660480dd6520c52e0"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\naf -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nan -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nar -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nast -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\naz -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbe -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbg -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbn -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbo -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbqi -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbr -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbrx -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nbs -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nca -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\nca-valencia -\u003e bc037c8fabb9a001403511e2fd270b3366ba59cd\ncak -