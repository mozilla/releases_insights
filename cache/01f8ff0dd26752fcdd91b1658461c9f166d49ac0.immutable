r.services.mozilla.com/D338658\n", "files": ["gfx/gl/SharedSurfaceDMABUF.cpp", "gfx/gl/SharedSurfaceDMABUF.h", "widget/gtk/DMABufSurface.cpp"], "git_node": "3115ce257ce661412b857ac6973212e044a08d02", "git_parents": ["796c048ba533d1c2a1ac0c45b241ed5a994b6d40"], "node": "01899013a739265e74bed62a31329745f757fc47", "parents": ["66f39fc2e2c6cb1eb728ad8ce854718698a60c54"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1991325 - Parse the certificate exception location with URL.parse instead of URI fixup. r=keeler\n\nThe certificate exception dialog passed the location, typically a bare\nhost:port such as \"mail.example.com:993\", to URI fixup. Fixup treats\n\"mail.example.com\" as a possible scheme and keeps it if an external protocol\nhandler claims it. On Flatpak and Snap the handler check goes through the\ndesktop portal, which can claim any scheme. The result was a URI with no host\nand port -1, so setting the default port threw NS_ERROR_MALFORMED_URI and the\n\"Confirm Security Exception\" button did nothing.\n\nParse the location with URL.parse instead, retrying with an https:// prefix if\nthe result has no host, and always use https.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338106\n", "files": ["security/manager/pki/resources/content/exceptionDialog.js", "security/manager/ssl/tests/mochitest/browser/browser_add_exception_dialog.js"], "git_node": "8114bb98204916820829ba4e0cad32e584ce9ded", "git_parents": ["3115ce257ce661412b857ac6973212e044a08d02"], "node": "c86c16f1d81a87286dc7b98e6fcdb7f84278d896", "parents": ["01899013a739265e74bed62a31329745f757fc47"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2088032 - Create two new verifyLongTapShortcutDisplaysEditShortcutTest and cancelTheDownloadFromPromptTest regression UI tests r=aaronmt\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338732\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/DownloadTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsCustomizeSimpleToolbarTest.kt"], "git_node": "7b6d9c58e0751fad8f1ad514e049aa4936b3ac1e", "git_parents": ["8114bb98204916820829ba4e0cad32e584ce9ded"], "node": "70848bee58ea9e5edd146377094c495ca830b2c9", "parents": ["c86c16f1d81a87286dc7b98e6fcdb7f84278d896"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2080763 - Only advertise device capabilities when the account has the sync keys/scope r=android-reviewers,tthibaud\" for causing a regression on android devices.\n\nThis reverts commit 86136a5faf970e59063cd07b822717f6fd03a958.\n", "files": ["mobile/android/android-components/components/concept/sync/src/main/java/mozilla/components/concept/sync/Devices.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FxaDeviceConstellation.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaDeviceConstellationTest.kt"], "git_node": "7d44c5bbb43280f61cd892152e4873026d85ce4f", "git_parents": ["7b6d9c58e0751fad8f1ad514e049aa4936b3ac1e"], "node": "c58a87dd95f9134d27981cb700864e4fe2965c34", "parents": ["70848bee58ea9e5edd146377094c495ca830b2c9"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2088010 - Add a SWGL span fast path for path tiles. r=lsalzman\n\nIt matches the behavior of the ssaa4/ssaa8 versions of the original shader.\n\nFor now path rendering is only done as a clip (by masking out pixels in an\nintermediate target with the premultiplied-dest-out blend mode), so SWGL's\nfast path focuses on that. At some point we will adapt this to be able to\nblend colors directly into the destination target.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338674\n", "files": ["gfx/wr/glsl-to-cxx/src/hir.rs", "gfx/wr/swgl/src/swgl_ext.h", "gfx/wr/webrender/res/cs_path_tile.glsl", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "bc917854a8179e344909d9e46f2e4f22501f2fe1", "git_parents": ["7d44c5bbb43280f61cd892152e4873026d85ce4f"], "node": "0ffc1e79446cd6c371bab28f18766354bede622e", "parents": ["c58a87dd95f9134d27981cb700864e4fe2965c34"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2088010 - Enable clip paths in WebRender when using SWGL. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338801\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-concave.html.ini"], "git_node": "94dc6e8242e0006696a7b067ea6c75e248ec2937", "git_parents": ["bc917854a8179e344909d9e46f2e4f22501f2fe1"], "node": "c49f525c5fa24cfb1874b91e04c80adc39d3d348", "parents": ["0ffc1e79446cd6c371bab28f18766354bede622e"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087408 - Revert APZ sampler and updater thread assertions to MOZ_ASSERT. r=gfx-reviewers,tnikkel\n\nIsSamplerThread and IsUpdaterThread take a mutex and query the current thread id, which costs two Mach calls on macOS. They run per APZC on every sample and every layers update, so checking them in release builds regressed scrolling benchmarks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338659\n", "files": ["gfx/layers/apz/src/APZSampler.cpp", "gfx/layers/apz/src/APZUpdater.cpp"], "git_node": "268207bf52c9d9c63cf0ab8d01b8dea7131a1a7b", "git_parents": ["94dc6e8242e0006696a7b067ea6c75e248ec2937"], "node": "c7f5e2ff45fbd99959eab908a9ba993cb4bd77bd", "parents": ["c49f525c5fa24cfb1874b91e04c80adc39d3d348"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "ef1a3f851604590b1bbf4ead53b52e10095c7c13", "git_parents": ["268207bf52c9d9c63cf0ab8d01b8dea7131a1a7b", "2b71df5bf2e07525d1129be46e0ee02ec70d34d8"], "node": "d903c6bac349f065b3449d2108d16c4ed2b85bd5", "parents": ["c7f5e2ff45fbd99959eab908a9ba993cb4bd77bd", "6d99215ef3a0d23b50444ae3b7dd33feb9a52fff"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run ios build tasks on git-backed pushes, r=taskgraph-reviewers,ahal,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327773\n", "files": ["taskcluster/kinds/build/ios.yml"], "git_node": "3d13a22291bfb85401c455c25ee719feeb8bc57a", "git_parents": ["ef1a3f851604590b1bbf4ead53b52e10095c7c13"], "node": "1eac0bf2b1fa1e2d5c72d1a7475596d07cd44c20", "parents": ["d903c6bac349f065b3449d2108d16c4ed2b85bd5"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070444 - Run addon tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324546\n", "files": ["taskcluster/kinds/addon/kind.yml"], "git_node": "e3f450a9cef357179e865342432b0206f07e261f", "git_parents": ["3d13a22291bfb85401c455c25ee719feeb8bc57a"], "node": "edd7bf93f2945fdd2ddc4772a9d584dd10964e24", "parents": ["1eac0bf2b1fa1e2d5c72d1a7475596d07cd44c20"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070444 - Run artifact-build tasks on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nRemove the `run-on-repo-type: [hg]` and `clone-with: hg` keys so the\nartifact-build tasks are scheduled on git-backed pushes and clone from\nGitHub. Rebased on current main after the mozconfig changes from bug\n2073844.\n\nThis landed on 2026-09-11 and was reverted the same day (be92328f2e2f)\nbecause Chain of Trust verification did not yet accept git-cloned tasks\nin hg-based graphs. That is fixed by bugs 2071338, 2071349, 2073481 and\n2073542 and the scriptworker deploy of 2026-10-08. Verified before the\nfirst landing: hg try push 2027770 and firefox-dev push cefdda7ceaf8,\nall green.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324547\n", "files": ["taskcluster/kinds/artifact-build/kind.yml"], "git_node": "0976cf0737a52afb61d1fda785d9dbf326f5fe13", "git_parents": ["e3f450a9cef357179e865342432b0206f07e261f"], "node": "871f9876999d20d35880cd5ac1cc7f1494563f58", "parents": ["edd7bf93f2945fdd2ddc4772a9d584dd10964e24"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064413 - Clone the Linux build tasks with Git, r=taskgraph-reviewers,firefox-build-system-reviewers,sergesanspaille,ahal\n\nDrop `clone-with: hg` from linux.yml and linux-base-toolchains.yml so these build tasks use\nthe kind default and check out the GitHub mirror at the git commit of the\npushed hg changeset (run-task-git, shallow clone). Only the checkout\nchanges: MOZ_SOURCE_REPO and MOZ_SOURCE_CHANGESET are still taken from the\npush, so application.ini, about:buildconfig, buildhub.json and the\nsourcestamp file keep their hg values. Crash symbol source attribution\nrelies on the symbolstore change earlier in this stack.\n\nVerified on try with the desktop set cloning from Git: opt, debug and\nshippable builds for linux64, win64 and macosx64, mingw, the native mac\nbuild, build-signing, mac signing, repackage, msix, mar-signing and\nupload-symbols, all green:\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=821ff954b8b41671848108de9d6c4d91403e8598\napplication.ini, platform.ini, buildhub.json, target.json and about:buildconfig\nkeep the hg source values and the symbol FILE records are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335066\n", "files": ["taskcluster/kinds/build/linux-base-toolchains.yml", "taskcluster/kinds/build/linux.yml"], "git_node": "87d6a4f373f059a1634cf458753dd1f65493eb73", "git_parents": ["0976cf0737a52afb61d1fda785d9dbf326f5fe13"], "node": "5aa7b1dd51fbd844558747bcb77a5547f91bfac4", "parents": ["871f9876999d20d35880cd5ac1cc7f1494563f58"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064413 - Clone the Windows build tasks with Git, r=firefox-build-system-reviewers,sergesanspaille\n\nDrop `clone-with: hg` from windows.yml and windows-mingw.yml so these build tasks use\nthe kind default and check out the GitHub mirror at the git commit of the\npushed hg changeset (run-task-git, shallow clone). Only the checkout\nchanges: MOZ_SOURCE_REPO and MOZ_SOURCE_CHANGESET are still taken from the\npush, so application.ini, about:buildconfig, buildhub.json and the\nsourcestamp file keep their hg values. Crash symbol source attribution\nrelies on the symbolstore change earlier in this stack.\n\nVerified on try with the desktop set cloning from Git: opt, debug and\nshippable builds for linux64, win64 and macosx64, mingw, the native mac\nbuild, build-signing, mac signing, repackage, msix, mar-signing and\nupload-symbols, all green:\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=821ff954b8b41671848108de9d6c4d91403e8598\napplication.ini, platform.ini, buildhub.json, target.json and about:buildconfig\nkeep the hg source values and the symbol FILE records are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335067\n", "files": ["taskcluster/kinds/build/windows-mingw.yml", "taskcluster/kinds/build/windows.yml"], "git_node": "0769aa319b4708066ba61fe657d00e1e7ea6efae", "git_parents": ["87d6a4f373f059a1634cf458753dd1f65493eb73"], "node": "11c29df89c8a7defcd996a4daaa82b9b2baad7dc", "parents": ["5aa7b1dd51fbd844558747bcb77a5547f91bfac4"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064413 - Clone the macOS build tasks with Git, r=firefox-build-system-reviewers,sylvestre\n\nDrop `clone-with: hg` from macosx.yml and macosx-native.yml so these build tasks use\nthe kind default and check out the GitHub mirror at the git commit of the\npushed hg changeset (run-task-git, shallow clone). Only the checkout\nchanges: MOZ_SOURCE_REPO and MOZ_SOURCE_CHANGESET are still taken from the\npush, so application.ini, about:buildconfig, buildhub.json and the\nsourcestamp file keep their hg values. Crash symbol source attribution\nrelies on the symbolstore change earlier in this stack.\n\nVerified on try with the desktop set cloning from Git: opt, debug and\nshippable builds for linux64, win64 and macosx64, mingw, the native mac\nbuild, build-signing, mac signing, repackage, msix, mar-signing and\nupload-symbols, all green:\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=821ff954b8b41671848108de9d6c4d91403e8598\napplication.ini, platform.ini, buildhub.json, target.json and about:buildconfig\nkeep the hg source values and the symbol FILE records are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335068\n", "files": ["taskcluster/kinds/build/macosx-native.yml", "taskcluster/kinds/build/macosx.yml"], "git_node": "c3e29736278149153f9cb2bf1c51fd268a5f72f4", "git_parents": ["0769aa319b4708066ba61fe657d00e1e7ea6efae"], "node": "3fc033946b9e0a67618549e67df0aae9d6aaa0af", "parents": ["11c29df89c8a7defcd996a4daaa82b9b2baad7dc"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2070808 - Stop the Organize Tabs and monitor panels from adding observers after their window unloads, r=Mardak.\n\nThe leak was seen with the Organize Tabs panel; the monitor panel has the same pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337541\n", "files": ["browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs"], "git_node": "91da82057a097b3058a4df75c8448dee85dbcf22", "git_parents": ["c3e29736278149153f9cb2bf1c51fd268a5f72f4"], "node": "5d4870bac67ca6913cd763f3d27387ad2194e27c", "parents": ["3fc033946b9e0a67618549e67df0aae9d6aaa0af"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2076627 - Fire the headless load deadline once the redirect has gone off-site in browser_smartwindow_get_page_content_timeout.js, r=Mardak.\n\nWith a 500ms load timeout, a slow build could time out before the redirect was seen, so the read was reported as a timeout instead of a block. Wait for the off-site location and expire the load then, as bug 2080002 did for the page extractor tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337543\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_get_page_content_timeout.js"], "git_node": "a77e50aa9783ca211120300a1dd6f8d26dfa1de4", "git_parents": ["91da82057a097b3058a4df75c8448dee85dbcf22"], "node": "6ecf94571b08c86fe0b4d1a0c85d3da8e9b7d827", "parents": ["5d4870bac67ca6913cd763f3d27387ad2194e27c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2071563 - Wait for the smartbar editor to apply typed text before awaiting its query in typeInSmartbar, r=Mardak.\n\nThe multiline editor applies typed text from a mutation observer after\nEventUtils.sendString returns, so typeInSmartbar read a stale\nlastQueryContextPromise and returned while the query was still running.\nbrowser_aiwindow_smartbar_suggestions.js then counted group labels before\nthe query had finished updating the view.\n\ntypeInSmartbar is shared by every test in this directory that types in the\nsmartbar; they all now wait for the editor's input event.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337910\n", "files": ["browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "e3181a89b836173a149fd79ff5fcb1da461e1b7e", "git_parents": ["a77e50aa9783ca211120300a1dd6f8d26dfa1de4"], "node": "779bc5073dee8a104e77455ead0bea0cf95047ba", "parents": ["6ecf94571b08c86fe0b4d1a0c85d3da8e9b7d827"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086555 - Don't run LLM telemetry or write its last-run pref during shutdown, r=Mardak.\n\nA scheduler tick or a run in progress at shutdown fails because ChatStore has\nclosed its connection, then writes browser.smartwindow.lastLLMTelemetryRunTime\nafter XPCOMShutdownThreads, which asserts in debug builds. The finally guard\ncovers a run already in progress; the early return avoids starting a run whose\nDB queries can only fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337546\n", "files": ["browser/components/aiwindow/models/TelemetryManager.sys.mjs"], "git_node": "81a8f06fd53d416e871bf2b3fabc30255a569ff9", "git_parents": ["e3181a89b836173a149fd79ff5fcb1da461e1b7e"], "node": "497f826938ebd75f9d8d12f1c27eeba96683e578", "parents": ["779bc5073dee8a104e77455ead0bea0cf95047ba"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2025711 - Remove the Smart Window sidebar browser when switching to a classic window, r=Mardak.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337547\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml"], "git_node": "f77b6e1096b26fd6544fbb898e5cfe4670f592ab", "git_parents": ["81a8f06fd53d416e871bf2b3fabc30255a569ff9"], "node": "d894c224164054110ac028774f0892bacbc7e701", "parents": ["497f826938ebd75f9d8d12f1c27eeba96683e578"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083655 - Clone the compiler and sysroot toolchain tasks with Git, r=taskgraph-reviewers,ahal\n\nDrop `clone-with: hg` from the toolchain kind defaults and from clang, clang-tidy, compiler-rt,\nlibunwind, llvm-symbolizer, gcc, sysroot, dist-toolchains and macos-sdk, so these tasks use the default and check out\nthe GitHub mirror at the git commit of the pushed changeset (run-task-git,\nshallow clone). The toolchain digest does not include the clone method, so\nlanding this causes no rebuild of the cached toolchains.\n\nVerified on try with one task of every toolchain file cloning from Git, all\ngreen (clang, gcc, rust, sysroot, onnx, dxc and the smaller tools):\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=59e6631743746f7f0bb76a5aab92538ac4079a01\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=9cdd4fdcf66b0650391487fee54447672c0ccca6\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=1f6428757c5c91446ddd94acec16b17f4a4962ca\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=91680d9c4c89b2e3be63e8e0e62a07f9af5d1b9d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335135\n", "files": ["taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/compiler-rt.yml", "taskcluster/kinds/toolchain/dist-toolchains.yml", "taskcluster/kinds/toolchain/gcc.yml", "taskcluster/kinds/toolchain/kind.yml", "taskcluster/kinds/toolchain/libunwind.yml", "taskcluster/kinds/toolchain/llvm-symbolizer.yml", "taskcluster/kinds/toolchain/macos-sdk.yml", "taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "7252a7f5bfaf8f0334fd895aada73b725341f1d2", "git_parents": ["f77b6e1096b26fd6544fbb898e5cfe4670f592ab"], "node": "79a3a1f1a6f7f699c9c6aea9b5012f14fe805679", "parents": ["d894c224164054110ac028774f0892bacbc7e701"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083655 - Clone the Rust and Rust-built toolchain tasks with Git, r=taskgraph-reviewers,ahal\n\nDrop `clone-with: hg` from rust, rust-size, cargo-vet, cbindgen, dump-syms, fix-stacks, grcov,\ngeckodriver, jj, minidump-stackwalk, mozcheck, nimbus-fml, samply, sccache\nand embedded-uniffi-bindgen, so these tasks use the default and check out\nthe GitHub mirror at the git commit of the pushed changeset (run-task-git,\nshallow clone). The toolchain digest does not include the clone method, so\nlanding this causes no rebuild of the cached toolchains.\n\nVerified on try with one task of every toolchain file cloning from Git, all\ngreen (clang, gcc, rust, sysroot, onnx, dxc and the smaller tools):\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=59e6631743746f7f0bb76a5aab92538ac4079a01\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=9cdd4fdcf66b0650391487fee54447672c0ccca6\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=1f6428757c5c91446ddd94acec16b17f4a4962ca\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=91680d9c4c89b2e3be63e8e0e62a07f9af5d1b9d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335136\n", "files": ["taskcluster/kinds/toolchain/cargo-vet.yml", "taskcluster/kinds/toolchain/cbindgen.yml", "taskcluster/kinds/toolchain/dump-syms.yml", "taskcluster/kinds/toolchain/embedded-uniffi-bindgen.yml", "taskcluster/kinds/toolchain/fix-stacks.yml", "taskcluster/kinds/toolchain/geckodriver.yml", "taskcluster/kinds/toolchain/grcov.yml", "taskcluster/kinds/toolchain/jj.yml", "taskcluster/kinds/toolchain/minidump-stackwalk.yml", "taskcluster/kinds/toolchain/mozcheck.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml", "taskcluster/kinds/toolchain/rust-size.yml", "taskcluster/kinds/toolchain/rust.yml", "taskcluster/kinds/toolchain/samply.yml", "taskcluster/kinds/toolchain/sccache.yml"], "git_node": "a6b61887d737ddec2f589b48529a4f6c2a8359a3", "git_parents": ["7252a7f5bfaf8f0334fd895aada73b725341f1d2"], "node": "1ca85e3705728d846847dcd2285d59a28a1adfe8", "parents": ["79a3a1f1a6f7f699c9c6aea9b5012f14fe805679"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083655 - Clone the remaining build tool toolchain tasks with Git, r=taskgraph-reviewers,ahal\n\nDrop `clone-with: hg` from 7zz, cabextract, dxc, gn, hostutils, libxml2, nasm, node, onnx, pkgconf,\npython, upx and uv, so these tasks use the default and check out\nthe GitHub mirror at the git commit of the pushed changeset (run-task-git,\nshallow clone). The toolchain digest does not include the clone method, so\nlanding this causes no rebuild of the cached toolchains.\n\nVerified on try with one task of every toolchain file cloning from Git, all\ngreen (clang, gcc, rust, sysroot, onnx, dxc and the smaller tools):\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=59e6631743746f7f0bb76a5aab92538ac4079a01\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=9cdd4fdcf66b0650391487fee54447672c0ccca6\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=1f6428757c5c91446ddd94acec16b17f4a4962ca\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=91680d9c4c89b2e3be63e8e0e62a07f9af5d1b9d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335137\n", "files": ["taskcluster/kinds/toolchain/7zz.yml", "taskcluster/kinds/toolchain/cabextract.yml", "taskcluster/kinds/toolchain/dxc.yml", "taskcluster/kinds/toolchain/gn.yml", "taskcluster/kinds/toolchain/hostutils.yml", "taskcluster/kinds/toolchain/libxml2.yml", "taskcluster/kinds/toolchain/nasm.yml", "taskcluster/kinds/toolchain/node.yml", "taskcluster/kinds/toolchain/onnx.yml", "taskcluster/kinds/toolchain/pkgconf.yml", "taskcluster/kinds/toolchain/python.yml", "taskcluster/kinds/toolchain/upx.yml", "taskcluster/kinds/toolchain/uv.yml"], "git_node": "cec9244e00a7bb74b455d86b0e8090b09db28869", "git_parents": ["a6b61887d737ddec2f589b48529a4f6c2a8359a3"], "node": "5d2a99f85c77f634ff07e20f0d1e1a5ceb5af1ca", "parents": ["1ca85e3705728d846847dcd2285d59a28a1adfe8"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run the system-symbols, upload-generated-sources and upload-symbols-dummy kinds on git-backed pushes, r=taskgraph-reviewers,jcristau\n\nsystem-symbols pins every task to a Mercurial clone and all three kinds\ncarry `run-on-repo-type: [hg]`. With the guards gone the system-symbols\nand upload-generated-sources tasks clone from GitHub; the dummy has no\ncheckout.\n\nVerified on staging-firefox (git-backed) on Oct 12: system-symbols-alpine,\nthe four upload-generated-sources tasks and the upload-symbols dummy\ncompleted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333139\n", "files": ["taskcluster/kinds/system-symbols/kind.yml", "taskcluster/kinds/upload-generated-sources/kind.yml", "taskcluster/kinds/upload-symbols-dummy/kind.yml"], "git_node": "c895adc17e351f91bc57e98adfcca52dcb9a496e", "git_parents": ["cec9244e00a7bb74b455d86b0e8090b09db28869"], "node": "7b4d3333cbd323251a9af09155c31b4ddcb05856", "parents": ["5d2a99f85c77f634ff07e20f0d1e1a5ceb5af1ca"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2087406 - Make the TRR pre-connect reuse the TRR connection entry and also run at Android cold start. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338706\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/dns/TRRService.cpp", "netwerk/dns/TRRService.h", "netwerk/dns/TRRServiceBase.cpp", "netwerk/test/unit/test_trr_foreground_preconnect.js"], "git_node": "c74459568aba8685a2c8852935877c4a51a23a88", "git_parents": ["c895adc17e351f91bc57e98adfcca52dcb9a496e"], "node": "c008679ab9281d7650b325e54ea71eaea655bfda", "parents": ["7b4d3333cbd323251a9af09155c31b4ddcb05856"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run signing-apk tasks on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,jcristau\n\nRemove the `run-on-repo-type: [hg]` guard so signing-apk tasks are\nscheduled on git-backed pushes, together with the android build family.\n\nDep-signing on git-backed pushes needed the Chain of Trust fix from bug\n2070846 (scriptworker 63.6.1, deployed 2026-10-08). Verified on a\ngit-backed push (staging-firefox 3f1d4444b983, task group\nRA6yNPC9RaSiJSRzem7qZw): all 5 signing-apk tasks completed (fenix debug,\nnightly, nightly-simulation; focus debug, nightly).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332812\n", "files": ["taskcluster/kinds/signing-apk/kind.yml"], "git_node": "c0f87a7ade047234d823f74c38fae2a00fbc0fee", "git_parents": ["c74459568aba8685a2c8852935877c4a51a23a88"], "node": "8dc02f58c3a6e6c84f70152a660fa28f79aeaa85", "parents": ["c008679ab9281d7650b325e54ea71eaea655bfda"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run signing-bundle tasks on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,jcristau\n\nRemove the `run-on-repo-type: [hg]` guard so signing-bundle tasks are\nscheduled on git-backed pushes, together with the android build family.\n\nDep-signing on git-backed pushes needed the Chain of Trust fix from bug\n2070846 (scriptworker 63.6.1, deployed 2026-10-08). Verified on a\ngit-backed push (staging-firefox 3f1d4444b983, task group\nRA6yNPC9RaSiJSRzem7qZw): all 4 signing-bundle tasks completed (fenix\ndebug, nightly; focus debug, nightly).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332813\n", "files": ["taskcluster/kinds/signing-bundle/kind.yml"], "git_node": "a6c67a33820225bc1a8ea8963d77ca36900b39fc", "git_parents": ["c0f87a7ade047234d823f74c38fae2a00fbc0fee"], "node": "96bbad24980ba314d543ddb5aaaffe20fe890fa4", "parents": ["8dc02f58c3a6e6c84f70152a660fa28f79aeaa85"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084959 - Run the merge automation, repo-update, bhr-aggregate and dte-test kinds on git-backed pushes, r=taskgraph-reviewers,releng-reviewers,ahal\n\nDeletes `run-on-repo-type: [hg]` from mark-as-merged, merge-automation,\nrepo-update, submit-nightly-release-metadata, bhr-aggregate and dte-test.\nNone of these kinds pins a checkout type, so the change is scheduling only:\na no-op on the existing Mercurial graphs, in effect once these graphs run\nagainst a GitHub repository. The tasks cannot be exercised at level 1\n(production tokens, cron triggers or real branches), so this lands without\na test run, as agreed with ahal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336143\n", "files": ["taskcluster/kinds/bhr-aggregate/kind.yml", "taskcluster/kinds/dte-test/kind.yml", "taskcluster/kinds/mark-as-merged/kind.yml", "taskcluster/kinds/merge-automation/kind.yml", "taskcluster/kinds/repo-update/kind.yml", "taskcluster/kinds/submit-nightly-release-metadata/kind.yml"], "git_node": "4b1fa9be6a11b369753c6dd23549794287b098e1", "git_parents": ["a6c67a33820225bc1a8ea8963d77ca36900b39fc"], "node": "a0de306f4027795d3b1d3419ae75bd4b489dd3f0", "parents": ["96bbad24980ba314d543ddb5aaaffe20fe890fa4"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082897 - Pick /rev/ or /commit/ in source URLs by repository host, r=firefox-build-system-reviewers,sergesanspaille\n\n`build/variables.py` already writes MOZ_SOURCE_URL with `/rev/` for\nhg.mozilla.org and `/commit/` for GitHub, but `mach source-package`\n(sourcestamp.txt), `build/appini_header.py` (App:sourceurl, i.e.\nServices.appinfo.sourceURL) and the mozharness resource monitor still\nappend `/rev/` unconditionally. For a push that originates on GitHub,\nMOZ_SOURCE_REPO is a github.com URL and those links do not exist. Pushes\non hg.mozilla.org, including build tasks that only clone the Git mirror,\nkeep the hg URL and are unaffected.\n\nVerified on try (linux64 build, python-mozbuild and python-mozharness\ntests): https://treeherder.mozilla.org/jobs?repo=try&revision=b4bcfebc11e25afe36d9c0d74f58d11f165d60a4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334560\n", "files": ["build/appini_header.py", "python/mozbuild/mozbuild/mach_commands.py", "testing/mozharness/mozharness/base/python.py"], "git_node": "0a61268d29ccd5498b2a54059eae234cede43c5b", "git_parents": ["4b1fa9be6a11b369753c6dd23549794287b098e1"], "node": "3ec7f9e32193586947736a0d3f6e2a6b4113764e", "parents": ["a0de306f4027795d3b1d3419ae75bd4b489dd3f0"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2088035 - Increase max-run-time of Marionette tests on TSan to 90 minutes. r=releng-reviewers,jcristau\n\nChunks that contain the sessionstore Marionette tests take about an hour on\nTSan because each test restarts the browser, so they hit the old limit while\ntests are still passing. There is no TSan runtime data for that manifest to\nbalance the chunks (bug 2088252), so raise the limit to match\nfirefox-ui-functional and wdspec on TSan for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338896\n", "files": ["taskcluster/kinds/test/marionette.yml"], "git_node": "382b1cbc5e087ae660ae1bbbbf131d484d0bcf3b", "git_parents": ["0a61268d29ccd5498b2a54059eae234cede43c5b"], "node": "18f733b3abd0e0e346ccd6d82763b35fbe91976e", "parents": ["3ec7f9e32193586947736a0d3f6e2a6b4113764e"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2087340 - chore(angle): update ANGLE to 76fb6f485785021e6e4c09e449bde7e413627f99 (Chrome Beta 158.0.8127.2) r=gfx-reviewers,nical\n\n## Behavioral changes in CTS\n\nUpstream ANGLE b64f67868464 (\"D3D11: Reject mixed 3D/non-3D and overlapping layer attachments\") changes results on our Windows D3D11 backend:\n\n- We no longer fail `framebuffer-mismatched-attachment-targets`, fixing bug 1725283.\n- We technically regressed `framebuffer-render-to-layer`, but I think it was likely only accidentally correct before. It now joins Android 14 and macOS 10.15 in its expected failures, though those fail for a different reason (pixel mismatches), and diverges from Linux and newer versions of macOS.\n\n\tPer the upstream commit, D3D11's `OMSetRenderTargets` silently failed on this test's attachment combination, and left stale targets bound. So, it doesn't seem like D3D11 ever really supported it; we just didn't detect failure in the CTS properly before.\n\n## Changes to our downstream patch stack\n\nModified patches:\n- 0001 refreshed against the new base; upstream renamed `mBaseLevel` to a local `baseLevel` in a context line, so it only applied with fuzz.\n- 0011 refreshed against the new base; upstream added (disabled) zstd support in `angle_compression_config` and `angle_compression`, invalidating the context around our `//angle/third_party/zlib` rewrites.\n- 0018 (formerly 0020) gained `From:`/`Date:` headers, as it was not generated with `git format-patch`. The date is its landing time from bug 2061638, as no authoring date was recorded.\n\nRemoved patches:\n- 0017 (`Avoid implicit StrictNumeric conversion in a new[] size expression`) upstreamed.\n- 0018 (`Use TMap for recursive SelectedFields::subfields`) obviated; upstream stores `SelectedFields *` instead.\n\nRenumbered patches: 0019 -\u003e 0017, 0020 -\u003e 0018\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338255\n", "files": ["dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "gfx/angle/moz.yaml", "gfx/angle/patches/0001-Restrict-the-slow-texture-upload-workaround-to-128bi.patch", "gfx/angle/patches/0011-Patch-build-scripts-for-Firefox-s-gn_processor.py.patch", "gfx/angle/patches/0017-Avoid-implicit-StrictNumeric-conversion-in-a-new-siz.patch", "gfx/angle/patches/0017-Fall-back-to-CLOCK_MONOTONIC-when-CLOCK_MONOTONIC_RA.patch", "gfx/angle/patches/0018-TLS-constinit-thread_local.patch", "gfx/angle/patches/0018-Use-TMap-for-recursive-SelectedFields-subfields.patch", "gfx/angle/patches/0019-Fall-back-to-CLOCK_MONOTONIC-when-CLOCK_MONOTONIC_RA.patch", "gfx/angle/patches/0020-TLS-constinit-thread_local.patch", "third_party/angle/BUILD.gn", "third_party/angle/angle_common_gn/moz.build", "third_party/angle/angle_common_shader_state_gn/moz.build", "third_party/angle/angle_d3d_format_tables_gn/moz.build", "third_party/angle/angle_frame_capture_mock_gn/moz.build", "third_party/angle/angle_gl_enum_utils_gn/moz.build", "third_party/angle/angle_gpu_info_util_gn/moz.build", "third_party/angle/angle_image_util_gn/moz.build", "third_party/angle/angle_image_util_headers_gn/moz.build", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-224ff58d943d0ea4.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-2754eec91c6a052d.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-2ca480ea075ac18b.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-32453ac923e2698a.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-3df9a565c263d77f.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-8e80c91a6eb55351.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-ab273ad633b7f99c.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-b2b0483eff4acc2b.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-b98afd