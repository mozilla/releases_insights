e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nsl -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nson -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nsq -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nsr -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nsv-SE -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nta -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nte -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nth -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\ntl -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\ntr -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\ntrs -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nuk -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nur -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nuz -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nvi -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nwo -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nxh -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nzam -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nzh-CN -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\nzh-TW -\u003e 9731881df5f0c033e654ef7c12c7ef6d6c0053c5\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "41c2642190242c2de1724aa812d6a64938ef6475", "git_parents": ["17e57f91c8d1f2a797dc9a30561be691718bb5b8"], "node": "21f6e658ac1cbe92d5ab5ccc9c886502672610ce", "parents": ["9de5d3ea29d92dbdcf75ceb3afbab4c42e34511d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2086305 - Use DrawSurface more often for SkPDF. r=lsalzman\n\nDrawTargetSkia::FillRect already redirects to DrawSurface when the image\nfits entirely inside the source rect, but it skipped that redirect for\nopaque surfaces drawn with OVER (which is basically every JPEG).\n\nOn a PDF canvas, the shader path makes SkPDF write a tiling Pattern, and\ngs ends up not downsampling it. A smarter optimizer could figure that\nout, but it seems better to use actual image objects in the PDF.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338022\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "toolkit/components/printing/tests/browser.toml", "toolkit/components/printing/tests/browser_print_image_output.js", "toolkit/components/printing/tests/browser_print_page_size_output.js", "toolkit/components/printing/tests/file_print_images.html", "toolkit/components/printing/tests/head.js"], "git_node": "bc36bffe55930bbb6d73c06d0c346643a073f03e", "git_parents": ["41c2642190242c2de1724aa812d6a64938ef6475"], "node": "d776bcdc5b8eb3584354028eac1a1d6c5adead49", "parents": ["21f6e658ac1cbe92d5ab5ccc9c886502672610ce"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2013867 - Fix link preview setting UI being hidden entirely instead of only the AI feature UI r=yjamora,mkennedy\" for causing failures at browser_aiFeatures_visibility.js.\n\nThis reverts commit c6d8bae2101eeea801941d97ee861a4c85540a8b.\n", "files": ["browser/components/preferences/config/tabs-browsing.mjs", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_visibility.js"], "git_node": "beeeb624527c0dec19008c5791a0b5f3a2d77ffe", "git_parents": ["bc36bffe55930bbb6d73c06d0c346643a073f03e"], "node": "6937072d1f3e15aae1fc35f5e5558ed879f6317c", "parents": ["d776bcdc5b8eb3584354028eac1a1d6c5adead49"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086797 - Remove the artifact build localization checks r=RyanVM\n\nThe l10n driver from bug 2038810 works with artifact builds, so\n`mach package-multi-locale` and `mach repackage-single-locales` should\nno longer gate artifact builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337871\n", "files": ["build/docs/locales.md", "python/mozbuild/mozbuild/mach_commands.py"], "git_node": "8cfa301db5b75d6fb0e64290db048aa0022ce94d", "git_parents": ["beeeb624527c0dec19008c5791a0b5f3a2d77ffe"], "node": "458e56e066263ac91e0c0c6576889dbef386eaec", "parents": ["6937072d1f3e15aae1fc35f5e5558ed879f6317c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086797 - Allow artifact builds for Android shippable builds r=taskgraph-reviewers,android-build-system-reviewers,jcristau,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337872\n", "files": ["taskcluster/gecko_taskgraph/transforms/build.py"], "git_node": "248a8cdf64066a68197b639536f85bda3753ef6b", "git_parents": ["8cfa301db5b75d6fb0e64290db048aa0022ce94d"], "node": "2560c899d07f19c7ad8ce01f3356b03cbcdd0d4c", "parents": ["458e56e066263ac91e0c0c6576889dbef386eaec"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2087181 - Update PDF.js to new version 22f5df1269b3ac950f80dd9fc25523ab4836c124 r=pdfjs-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338064\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.css", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "72e6c5e597e9a604e33f2849c86fa68d1fb9e443", "git_parents": ["248a8cdf64066a68197b639536f85bda3753ef6b"], "node": "252543de823d97b481994fdf9918d6db0e37b25d", "parents": ["2560c899d07f19c7ad8ce01f3356b03cbcdd0d4c"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079378 - Add a feature callout to the text selection menu. r=fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,flozia,nsharpley,tgiles,settings-reviewers,bolsson\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nThe first time the menu appears with Search or Copy, a callout points at Search, or at the first visible action when Search is off, and explains the feature. Pressing the three dots in its text opens the three-dot menu. It is shown once, and not at all to someone who has turned the menu or one of its actions on in Settings.\n\nTo try it manually: flip `browser.highlightToSearch.featureGate` on, make sure\n`browser.highlightToSearch.callout.seen` is false, and select text on any page.\nReset `callout.seen` to see it again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333416\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/main-popupset.inc.xhtml", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/tests/browser/browser.toml", "browser/components/genai/tests/browser/browser_chat_contextmenu.js", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/preferences/config/tabs-browsing.mjs", "browser/components/preferences/tests/browser_tabs_browsing_highlightToSearch.js", "browser/locales/en-US/browser/genai.ftl", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "ffec2c608d2abb3aabeed3c4e0094bc64fc4d04d", "git_parents": ["72e6c5e597e9a604e33f2849c86fa68d1fb9e443"], "node": "ce276b45a01e5c94d151e1bfbfdcc39f0c818a87", "parents": ["252543de823d97b481994fdf9918d6db0e37b25d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081980. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337511\n", "files": ["layout/style/CSSImportRule.cpp", "layout/style/Rule.h", "layout/style/StyleSheet.h"], "git_node": "a471ebfcf8fa1e4f435c62e374fb2e3a623d9e6b", "git_parents": ["ffec2c608d2abb3aabeed3c4e0094bc64fc4d04d"], "node": "9fc56c612f5f83a89bc0b083934877b577dd9340", "parents": ["ce276b45a01e5c94d151e1bfbfdcc39f0c818a87"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085050 - Keep the windows open when deleting browsing data from the fire button's dialog. r=bvandersloot\n\nWhen the clear browsing data dialog was opened from the fire button and history was selected, it also closed every browser window and opened a new one, whatever the time range. With \"Last hour\", that closed tabs opened long before, and the \"Leave page?\" prompt of a page that asks before closing ended up hidden behind the dialog.\n\nPer the product decision, choosing what to delete now only deletes the selected data and keeps all tabs and windows open, like the dialog opened from anywhere else, even when everything is selected. Deleting everything from the fire button's panel still closes the windows and opens a new one. The closeWindowsWithHistory option of Sanitizer.showUI had no other users, so it is removed, and so is the dialog's \"aborted\" outcome, which only closing windows could cause, along with the \"aborted\" data of the sanitizer-sanitization-complete notification that reported it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336223\n", "files": ["browser/base/content/sanitizeDialog.js", "browser/base/content/test/browser-sanitize/browser_sanitize-history.js", "browser/base/content/test/browser-sanitize/browser_sanitizeDialog_v2.js", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/test/browser_fireButton.js", "browser/modules/Sanitizer.sys.mjs"], "git_node": "fcfcac40a41c21f98d4faba7f5bca850a887e51c", "git_parents": ["a471ebfcf8fa1e4f435c62e374fb2e3a623d9e6b"], "node": "8892c2498672d3e36b1147b6130169d35a4ae60d", "parents": ["9fc56c612f5f83a89bc0b083934877b577dd9340"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2038777 - Make privilegedabout implicitly COOP, r=mconley,mccr8,tabbrowser-reviewers,dao\n\nCurrently there is largely no reason for a privilegedabout tab to have\nan opener relationship with a non-privilegedabout tab. This patch\nenforces this by breaking opener tabs in a similar manner to if the\nCross-Origin-Opener-Policy header was specified when loading\nprivilegedabout content.\n\nIn addition, this change also blocks framing of privilegedabout content\nby non-privilegedabout documents. It should still be possible to frame\nnon-privilegedabout content sandboxed within a privilegedabout frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300048\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_new_tab_in_privilegedabout_process_pref.js", "browser/components/tabbrowser/test/browser/tabs/browser_privilegedabout_popup_opener.js", "dom/ipc/ProcessIsolation.cpp"], "git_node": "5f3e805831460c59a9e3d92377b42f25f6d784fe", "git_parents": ["fcfcac40a41c21f98d4faba7f5bca850a887e51c"], "node": "3a039e08de8026af4d5b12ec33d140175ee78186", "parents": ["8892c2498672d3e36b1147b6130169d35a4ae60d"], "tags": []}, {"author": "Beatriz Rizental \u003cbea@torproject.org\u003e", "branch": "default", "desc": "Bug 2078384 - Avoid a doubled slash in the testing-common resource URI. r=florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330895\n", "files": ["testing/mochitest/runtests.py"], "git_node": "c486b396c418cc69a3899d7de44a1c3fe3e820a9", "git_parents": ["5f3e805831460c59a9e3d92377b42f25f6d784fe"], "node": "7e980bf4ca22013bff12c1d3fbb4e1e08fcd5968", "parents": ["3a039e08de8026af4d5b12ec33d140175ee78186"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996168 - Use logical properties for spacing/positioning r=desktop-theme-reviewers,echa,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337154\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-footer/applied-memories-button.css", "browser/components/aiwindow/ui/components/ai-chat-grid/ai-chat-grid.css", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.css", "browser/components/aiwindow/ui/components/ai-sff-form-review/ai-sff-form-review.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-website-confirmation/ai-website-confirmation.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/kit-mention/kit-mention.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/smartwindow-heading/smartwindow-heading.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/aiwindow/ui/components/smartwindow-resume-card/smartwindow-resume-card.css", "browser/components/aiwindow/ui/content/firstrun.css", "browser/components/genai/chat.css", "browser/components/genai/content/link-preview-card.css", "browser/components/genai/content/model-optin.css"], "git_node": "3b7dcc3bf244926b71bf74c8932c4279d54f0f06", "git_parents": ["c486b396c418cc69a3899d7de44a1c3fe3e82