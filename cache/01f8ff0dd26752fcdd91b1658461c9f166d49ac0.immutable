c/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "layout/painting/nsCSSRenderingBorders.cpp", "layout/painting/nsCSSRenderingBorders.h", "layout/painting/nsDisplayList.cpp", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-complex.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-double.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-multiple-backgrounds.html.ini", "testing/web-platform/tests/css/css-backgrounds/background-clip/clip-border-area-complex-color-ref.html", "testing/web-platform/tests/css/css-backgrounds/background-clip/clip-border-area-complex-color.html", "testing/web-platform/tests/css/css-backgrounds/background-clip/clip-border-area-large-dotted-ref.html", "testing/web-platform/tests/css/css-backgrounds/background-clip/clip-border-area-large-dotted.html"], "git_node": "ca36402118035660f0c958f6d257746302742ec3", "git_parents": ["e1e5e44532ffd74f2935e3fa2911e6ba5e1bb989"], "node": "3a9f8219a10201d49a5c4055f10b2130435348e5", "parents": ["4412e0b571b0baaad084025ccda99ac03099f153"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083043 - Swap in correct warning icon for delete error dialog in VPN site rules - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334673\n", "files": ["browser/components/ipprotection/content/vpn-site-rules-list.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection_siterules.js"], "git_node": "71a5fb2a63d9cc23cf9442eeaa033e3f9503c8ae", "git_parents": ["ca36402118035660f0c958f6d257746302742ec3"], "node": "eb41a3e5b9ed891eeab9e0a1469e1ffdd0ed4cb3", "parents": ["3a9f8219a10201d49a5c4055f10b2130435348e5"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046372 - Support background-clip: border-area r=