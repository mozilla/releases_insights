8a4825f9047eb0497c3f4805512dc45", "286447d12c3684ae6fccaa904d14f112a069e70a", "2b492f3cac2ee10ae459df2aa5b0fe981d74ccaf", "4d3d3e407d3dd30a792ef0483fdd2130e8bccf9b", "59a643159a0038a83797db4a3b400ac263d5aa48", "f3844ddba78b62caa6dbd32ff1dc555754951a3e", "c092b556246630b91161c616724c07f00853eb9e", "8ad4293e17eb7048dd206780303196658d81b5ac", "d7c7595033d99543243423c1a1b756159d9658f6", "5983a7a59ac732c2839e0d5284c98ad757ca19c1", "006efdbf7c0e7436a601c8112b9defe077f8ccdb", "fa381652d424eada71a0b8b1f56e0788185f7263", "7d43e90e8a47caf994949db523c930865d4ed3d2", "a048299413f0b63f337ca94485d28b5e81be19f4", "ba8af8a4aa4e92c0a79c7a4db2f72ae87179f45d", "2eaf6bc2f2fc4f7707ee1509a34032c93076fb8d", "b2aa6b5ba7f0758a7c9929e30377a0f76f2b1c4f", "8371d146374dda801386fe8ab589fba23127cb8b", "1a09c806d8daecedafd27d22b3193b1d3e251e62", "eec91bd8941bf97b46014f6de68bd54ac0e99760", "052b3ca9afa7236783c06aa42ba44cf2e1cae011", "957b88ed6b43a62a1efe357df03fec946415dc6d", "94bb21308ac3c0374d2ad18733eb56d9707f38ef", "3d20e13447e995d9127067a17480b549d91464bd", "4049c5066ca34b12db85c554acc9c7c5bb4242c5", "ceebaa703b0f6b41c4b3e61a7e0e3b42eaded605", "1d7959209e1fbddca7eefae2db196c25bbc4a686", "8aa11076ee84f268b50b50bb625cdb7a4f0f7d97", "b88f19a33828d9f94c036a6fff7c6a3432860241", "7d5074d2f46eca1f8020cd3fd36d213df82f842a", "cfe6693828ddc02071ca1e4b48f61cfe23681ae9", "5a83619d110de8fe5812fbf4e9c89328989d14db", "d329884a39efa133c73b869ef47ee7dad84fd38c", "9daee94dbbcd8b57a34bf90b68f1ad85b5634f83", "352a5930523647fb213013e7c91a88cf0e921dbf", "8744e29bad79970df1f1537fe9aae807bbb87fac", "1744250c7ab2c778288edd3d95588e546deabdd2", "6c1c1228993b4afc607a806ef4e4275a4a25e318", "81bddd92b987d7a3f02891ae8a48f749ffd4b9bc", "7578c118d608d0efce1a969442c2fc36126cc577", "a523d729bb1cd6c8ea17cf3d89373112985506e9", "5cd0800e1e93b919f1cb7dcf06c83bc6b5585cd0", "9e6136fbb8ede45a1dd190256b09e8d3318debb3", "858256cf636c727c69ef2beaccbd7dcaced7fc9b", "892c696155e7c4bef3b0feb5867e4ed6677eb042", "4628f35fa9702f6a5379bad975960efb588b401e", "47ae419b84e7930be1c5c03289720cf10f1230f9", "34be9e3155845f2ca0f18afc3fc4e6c33a8a7e6e", "112b98932d21154eb1c2019faedbe336edac4ab6"], "user": "asilaghi@mozilla.com"}, "45703": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087591 - Allow New Tab widget registry entries to add items to their card menu. r=fchasen\n\nA registry entry with `card: \"FramedWidgetCard\"` is drawn by the new\nFramedWidgetCard component, for a widget whose document a hosted page provides.\nIt is a MozWidgetCard with the entry's `menu` items above the shared ones.\nA \"choice\" item is a submenu of checkable options whose value is stored in a\npref and passed to the widget's document in its URL fragment; an \"action\" item\nruns a host action, of which \"show-customize\" is the only one.\n\nAn option can also name a `size`: while it is chosen, the widget is drawn at\nleast that size where the layout allows resizing, and choosing a smaller size\nswitches the choice to its first option that fits.\n\nThe frame keeps the URL it first loaded. Later changes to only its fragment\nreach it through location.replace(), so switching options doesn't add entries\nto the tab's session history.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338385\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/FramedWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/lib/utils.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FramedWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MozWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsErrorBoundary.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx"], "git_node": "744459603b08ae202bf128171fc7035dd3d25a98", "git_parents": ["34be9e3155845f2ca0f18afc3fc4e6c33a8a7e6e"], "node": "c34d0393af9d597887fc8988a5574608467a53b7", "parents": ["f42fcaa18b0f34cd53c1019e9e27b2126901686f"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087597 - Show a placeholder in a widget card that has no document. r=nina-py,fluent-reviewers,bolsson\n\nMozWidgetCard shows \"Watch this space\" in place of the widget while its\nregistry entry has no document to frame. This is meant as a fallback while\nframed widgets using MozWidgetCard are built out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338386\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MozWidgetCard.test.jsx", "browser/locales-preview/newtabPreview.ftl"], "git_node": "8ea34b353cb07af46d73424b7a51208e9ff8ffc7", "git_parents": ["744459603b08ae202bf128171fc7035dd3d25a98"], "node": "09acf88cceecc3b2a73ea2b87ffdaf0946fb2aac", "parents": ["c34d0393af9d597887fc8988a5574608467a53b7"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087595 - Add a stub Wrexham AFC widget to New Tab. r=fchasen,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338387\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_wrexhamafc_widget.js", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/locales-preview/newtabPreview.ftl"], "git_node": "75c059651a3bd78191060ec0bf6fb9f2b433b19b", "git_parents": ["8ea34b353cb07af46d73424b7a51208e9ff8ffc7"], "node": "f2b51ddb1326ce332fc9a895ef5440b8872982ae", "parents": ["09acf88cceecc3b2a73ea2b87ffdaf0946fb2aac"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072034 - Keep desktop Sync engine choices local behind the per-device pref. r=markh,sync-reviewers\n\nWith services.sync.perDeviceEngineChoices on, Choose What to Sync is local\nto this device. Desktop stops syncing the declined list, stops changing\nlocal choices to match meta/global, and stops deleting server data when an\nengine is disabled.\n\nOn its first sync after sign-in, the device copies the account's choices\nfrom meta/global, as a legacy client would.\n\nThe setup dialog is pre-filled with the same choices. Re-enabling an engine\nresets its last sync, since disabling it no longer resets it.\n\nNothing changes with the pref off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326752\n", "files": ["services/sync/modules/engines.sys.mjs", "services/sync/modules/engines/clients.sys.mjs", "services/sync/modules/service.sys.mjs", "services/sync/modules/stages/declined.sys.mjs", "services/sync/modules/stages/enginesync.sys.mjs", "services/sync/tests/unit/test_clients_engine.js", "services/sync/tests/unit/test_service_sync_updateEnabledEngines.js"], "git_node": "c309bd3a27f50d839df794048c42788d89cfeb2a", "git_parents": ["75c059651a3bd78191060ec0bf6fb9f2b433b19b"], "node": "98b1cef958f425f08abfabebf4926b2959514a02", "parents": ["f2b51ddb1326ce332fc9a895ef5440b8872982ae"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072034 - Add a meta/syncids registry for per-device engine sync IDs. r=markh,sync-reviewers\n\nPer-device clients can't add or remove entries in meta/global's `engines`\nwithout changing legacy clients' choices, but they still need a shared\nsyncID per engine. This keeps those in a new storage/meta/syncids record.\n\nmeta/global's entry is used when it exists. When a legacy client removes\nit, per-device clients use meta/syncids and don't reset. A per-device\nclient that recreates meta/global after a server wipe republishes the\naccount's choices from the last meta/global it saw, so legacy clients keep\ntheirs. Without any, it publishes its own, as a legacy client would.\n\nNothing reads or writes meta/syncids with the pref off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328045\n", "files": ["services/sync/modules/engines.sys.mjs", "services/sync/modules/engines/passwords.sys.mjs", "services/sync/modules/service.sys.mjs", "services/sync/modules/stages/enginesync.sys.mjs", "services/sync/modules/stages/syncids.sys.mjs", "services/sync/moz.build", "services/sync/tests/unit/test_load_modules.js", "services/sync/tests/unit/test_password_engine.js", "services/sync/tests/unit/test_service_sync_updateEnabledEngines.js"], "git_node": "51e9a7c5ffcf233e279385957858cef269b2688b", "git_parents": ["c309bd3a27f50d839df794048c42788d89cfeb2a"], "node": "d98cb572c187e70c61b6cba00cc56aa808d224d4", "parents": ["98b1cef958f425f08abfabebf4926b2959514a02"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081585: Add ability for TPS tests to test accounts with PDS and non-PDs r=markh,sync-reviewers,frontend-codestyle-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333492\n", "files": ["services/sync/tests/tps/.eslintrc.mjs", "services/sync/tests/tps/all_tests.json", "services/sync/tests/tps/pds/pds_tests.json", "services/sync/tests/tps/pds/test_pds_creates_account.js", "services/sync/tests/tps/pds/test_pds_join_legacy_account.js", "services/sync/tests/tps/pds/test_pds_legacy_decline.js", "services/sync/tests/tps/pds/test_pds_local_decline.js", "services/sync/tps/extensions/tps/resource/tps.sys.mjs"], "git_node": "6416859fe1334aa829fdab66c76482e5a4dddcea", "git_parents": ["51e9a7c5ffcf233e279385957858cef269b2688b"], "node": "30bac61d8c22aa17272ad0dde64483628d2c5762", "parents": ["d98cb572c187e70c61b6cba00cc56aa808d224d4"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082451 - Add guarded-by annotation to mPlatformFontEntry. r=layout-reviewers,firefox-style-system-reviewers,AlaskanEmily\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338812\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h", "layout/style/FontFaceSetDocumentImpl.cpp"], "git_node": "182a4bbf2e7b806fac28066be78dce5d86380a47", "git_parents": ["6416859fe1334aa829fdab66c76482e5a4dddcea"], "node": "926da6f2c06cf3c1e0579805570b01b0e5d3c4c3", "parents": ["30bac61d8c22aa17272ad0dde64483628d2c5762"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086579 - Part 1 - Limit the GeckoView linters to the directories their Gradle tasks check r=adhingra\n\nandroid-api-lint, android-checkstyle, android-format, android-lint and\nandroid-test included all of `mobile/android`, so a change only to\nfenix, focus or android-components also ran their Gradle tasks.\nandroid-javadoc included the GeckoView test sources, which its task\ndoes not read. android-lint and android-test now also run for\n`dom/media/systemservices/android_video_capture`, whose Java GeckoView\ncompiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338234\n", "files": ["tools/lint/android-api-lint.yml", "tools/lint/android-checkstyle.yml", "tools/lint/android-format.yml", "tools/lint/android-javadoc.yml", "tools/lint/android-lint.yml", "tools/lint/android-test.yml"], "git_node": "f0cbed472244c73a7ba3dcefbbb14244b4916aa8", "git_parents": ["182a4bbf2e7b806fac28066be78dce5d86380a47"], "node": "85d31ce680c827b5086d590b4b39ae8778c74d06", "parents": ["926da6f2c06cf3c1e0579805570b01b0e5d3c4c3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086579 - Part 2 - List the inputs of the GeckoView linters in their `support-files` r=linter-reviewers,sergesanspaille\n\nThe GeckoView linters treated every `*.gradle` file as a support file,\nso a change to a fenix, focus or android-components build script linted\nthe whole tree with all of them. They also missed files Gradle reads\nwhile configuring them, such as `gradle.properties`, the version\ncatalog, the wrapper and `.config.yml`. They missed `lints.py` and the\n`./mach gradle` code it runs, and inputs their `java` and `kt`\nextensions filter out, such as `api.txt`, `lint.xml` and the GeckoView\nmanifest, resources and AIDL files. android-api-lint also missed\n`config/milestone.txt`, which sets the version it checks deprecations\nagainst. They now list the shared build setup, the plugin builds that\nroot `settings.gradle` includes, and the build scripts and other inputs\nof the projects each linter checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338235\n", "files": ["tools/lint/android-api-lint.yml", "tools/lint/android-checkstyle.yml", "tools/lint/android-format.yml", "tools/lint/android-javadoc.yml", "tools/lint/android-lint.yml", "tools/lint/android-test.yml"], "git_node": "c8db3e7d2758120e4a3149930aaf8bed35176681", "git_parents": ["f0cbed472244c73a7ba3dcefbbb14244b4916aa8"], "node": "1067e1a58803af2ed83c76f3de67f78ecdf65d4f", "parents": ["85d31ce680c827b5086d590b4b39ae8778c74d06"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086579 - Part 3 - Schedule the android-lints task on the inputs of its linters r=linter-reviewers,sergesanspaille\n\nThe task ran on any Java, Kotlin or resource change under\n`mobile/android` and on any Gradle script in the tree, including\nchanges only to fenix, focus or android-components. It now runs on the\ndirectories and build files the GeckoView linters check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338236\n", "files": ["taskcluster/kinds/source-test/mozlint-android.yml"], "git_node": "26db924dc5757a1accf6332a388d1f73c93d897e", "git_parents": ["c8db3e7d2758120e4a3149930aaf8bed35176681"], "node": "b8d005d4c40d7d1e06f74900562d163cb098ec7d", "parents": ["1067e1a58803af2ed83c76f3de67f78ecdf65d4f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086579 - Part 4 - List the inputs of the fenix, focus and android-components linters in their `support-files` r=adhingra\n\nandroid-fenix, android-focus and android-ac treated every `*.gradle` file in\nthe tree as a support file, and their tasks ran on any Gradle script change.\nThey now list the shared build setup, the project each one checks, and the\nbuild scripts of the android-components and GeckoView projects it depends on.\nTheir tasks run on the same files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338913\n", "files": ["taskcluster/kinds/source-test/mozlint-android.yml", "tools/lint/android-ac.yml", "tools/lint/android-fenix.yml", "tools/lint/android-focus.yml"], "git_node": "ceea4077dd2526a2cf5a5e6948f3ce817a34d890", "git_parents": ["26db924dc5757a1accf6332a388d1f73c93d897e"], "node": "31813abcd82d9d57a1ea3d23b96370da9c1abfe2", "parents": ["b8d005d4c40d7d1e06f74900562d163cb098ec7d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086579 - Part 5 - Schedule the GeckoView docs task on the inputs of its Gradle build r=adhingra\n\nThe task ran on any Gradle script in the tree, including changes only to\nfenix, focus or android-components. It now runs on the GeckoView build files\nand the shared Gradle setup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338914\n", "files": ["taskcluster/kinds/build/android-stuff.yml"], "git_node": "aee57d96c6f4688e25b0c9f2b3c816390009c3e1", "git_parents": ["ceea4077dd2526a2cf5a5e6948f3ce817a34d890"], "node": "fca1d66fdbadabedcd69daf31806cca1d242b13f", "parents": ["31813abcd82d9d57a1ea3d23b96370da9c1abfe2"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056305 - Check accessible names on reorderable Settings lists. r=settings-reviewers,mkennedy,hjones\n\nAdd browser tests that check the search engine, website language,\ncontainer, and custom homepage lists have nonempty aria-labels and\naccessible names.\n\nSplit the scenarios into separate files to reduce per-file runtime\nduring verification.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333895\n", "files": ["browser/components/preferences/tests/browser.toml", "browser/components/preferences/tests/browser_reorderable_list_accessible_names_containers.js", "browser/components/preferences/tests/browser_reorderable_list_accessible_names_homepage.js", "browser/components/preferences/tests/browser_reorderable_list_accessible_names_languages.js", "browser/components/preferences/tests/browser_reorderable_list_accessible_names_search.js", "browser/components/preferences/tests/head-common.js"], "git_node": "12b0f7f65348ea5fd2338f5f589223928447bbb2", "git_parents": ["aee57d96c6f4688e25b0c9f2b3c816390009c3e1"], "node": "fe9ed9688baea5aa7051aea4a5d52667c969f9d3", "parents": ["fca1d66fdbadabedcd69daf31806cca1d242b13f"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074130: Journey metadata is created and persisted from memories r=cdipersio,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334550\n", "files": ["browser/components/aiwindow/models/memories/MemoriesSchedulers.sys.mjs", "browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/memories/journeys/JourneyStore.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js", "browser/components/aiwindow/models/tests/browser/browser_MemoriesSchedulers.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "94b3db5f9f7184b20bc693441edd7bc2cfe5de4b", "git_parents": ["12b0f7f65348ea5fd2338f5f589223928447bbb2"], "node": "36b078c66729a992860e6b1629965c71f7466240", "parents": ["fe9ed9688baea5aa7051aea4a5d52667c969f9d3"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074131 - Back PUWYLO functionality with new persisted journeys r=cdipersio,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336078\n", "files": ["browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "a503979fd6e75626e84138ecf79d63a23446e58f", "git_parents": ["94b3db5f9f7184b20bc693441edd7bc2cfe5de4b"], "node": "3aeac9de4a2818806c4daf7c880a99d4290b3a45", "parents": ["36b078c66729a992860e6b1629965c71f7466240"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074131 - Rename resume activity identifiers in JourneyManager to journey terms r=cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336079\n", "files": ["browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js"], "git_node": "b03da9275bf9c957dee6717ce35ef3f53d339cf4", "git_parents": ["a503979fd6e75626e84138ecf79d63a23446e58f"], "node": "41a8407d643971eb7b22cd3c5987e0c896f4c092", "parents": ["3aeac9de4a2818806c4daf7c880a99d4290b3a45"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074133 - Implement new functionality to service PUWYLO Cards design, r=cdipersio,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336080\n", "files": ["browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js"], "git_node": "231b79566c34b4758264ac5dd5e79b6f19ede836", "git_parents": ["b03da9275bf9c957dee6717ce35ef3f53d339cf4"], "node": "1f99359c7666f36a089f8eeb614398f007cee7f1", "parents": ["41a8407d643971eb7b22cd3c5987e0c896f4c092"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081585: Add ability for TPS tests to test accounts with PDS and non-PDs r=markh,sync-reviewers,frontend-codestyle-reviewers,Standard8\" for causing js extra modules at services/sync/moz.build\n\nThis reverts commit 6416859fe1334aa829fdab66c76482e5a4dddcea.\n\nRevert \"Bug 2072034 - Add a meta/syncids registry for per-device engine sync IDs. r=markh,sync-reviewers\"\n\nThis reverts commit 51e9a7c5ffcf233e279385957858cef269b2688b.\n\nRevert \"Bug 2072034 - Keep desktop Sync engine choices local behind the per-device pref. r=markh,sync-reviewers\"\n\nThis reverts commit c309bd3a27f50d839df794048c42788d89cfeb2a.\n", "files": ["services/sync/modules/engines.sys.mjs", "services/sync/modules/engines/clients.sys.mjs", "services/sync/modules/engines/passwords.sys.mjs", "services/sync/modules/service.sys.mjs", "services/sync/modules/stages/declined.sys.mjs", "services/sync/modules/stages/enginesync.sys.m