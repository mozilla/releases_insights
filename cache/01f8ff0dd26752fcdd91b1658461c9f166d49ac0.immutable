866c76b", "parents": ["9ef170b86402a4cfd96a0eff39512643249298f4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088285 - Fix test_textScaleFactor_system_font expectations.\n", "files": ["widget/tests/test_textScaleFactor_system_font.html"], "git_node": "93bf8e77cc16766b818cce8eb9e5e2cb4edf60bd", "git_parents": ["2aec3f9c8abad57ebe8fd9c13090c84f1f869eae"], "node": "621dc09bf43631094612bad484e7b09d2b634e97", "parents": ["68e091ee1bd05c392e0229c1ca56f4517866c76b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088285 - Make select_on_focus remain true for headless.\n\nMatches the previous behavior and there's one test that relies on it.\n", "files": ["widget/gtk/nsLookAndFeel.cpp"], "git_node": "13dc3126ab911b8f043de1126703358149e8dfbb", "git_parents": ["93bf8e77cc16766b818cce8eb9e5e2cb4edf60bd"], "node": "1ef4953a8e8f9d98a416cfa4aac44b92eed8b557", "parents": ["621dc09bf43631094612bad484e7b09d2b634e97"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2088582 - Enable pdf.js worker rendering on Nightly and Developer Edition. r=marco\n\nEARLY_BETA_OR_EARLIER is going away (bug 2051729).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339410\n", "files": ["toolkit/components/pdfjs/PdfJsOverridePrefs.js"], "git_node": "e7fc22bc2a60c406cef60bb7ffa3d1fcdd1be8b5", "git_parents": ["13dc3126ab911b8f043de1126703358149e8dfbb"], "node": "21350a5992b42a27f525f046f4bdc483457de396", "parents": ["1ef4953a8e8f9d98a416cfa4aac44b92eed8b557"], "tags": []}, {"author": "Emily Wachowiak \u003cewachowiak@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074615 - Update the quit-with-downloads confirmation dialog copy. r=Gijs,fluent-reviewers,bolsson\n\nDownloads in progress are saved and resumed on the next launch, so the old\n\"will be canceled\" wording was inaccurate. The quit prompt now says downloads\nwill be stopped, that Firefox will try to resume them, and that progress may\nbe lost. The offline prompt gets the same treatment, since downloads are\nrestarted when the network returns. The Private Browsing prompt now says\ndownloads can't be resumed, which is accurate because private downloads are\nremoved on exit.\n\nEach prompt gets its own title, message and button strings, and shares a\nsingle \"Cancel\" string. The old shared title and \"Cancel N Downloads\" button,\nand the old per-prompt strings, are removed. Windows uses \"exit\" in the quit\ntitle and primary button; other platforms use \"quit\". This also fixes the\n\"Don't Quit\" button never appearing on macOS, because PLATFORM() returns\n\"macos\", not \"mac\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338821\n", "files": ["toolkit/components/downloads/DownloadUIHelper.sys.mjs", "toolkit/locales/en-US/toolkit/downloads/downloadUI.ftl"], "git_node": "a0c6031b800e6f6df17a972d0af58cd608099f0e", "git_parents": ["e7fc22bc2a60c406cef60bb7ffa3d1fcdd1be8b5"], "node": "deaeb0f79b6c127cd69e3f0c3779626b69870b04", "parents": ["21350a5992b42a27f525f046f4bdc483457de396"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2003766 - Write gtest for parsing multiple cached Content-Type headers r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D275439\n", "files": ["netwerk/test/gtest/TestHttpResponseHead.cpp"], "git_node": "163709d5f7483aca57ffd00f8fc3e12ea51fa4d8", "git_parents": ["a0c6031b800e6f6df17a972d0af58cd608099f0e"], "node": "455a62969e9c10b95ce212269e1b6bc725fb02d8", "parents": ["deaeb0f79b6c127cd69e3f0c3779626b69870b04"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2085289 - Add EINTR retries to AndroidHardwareBuffer::MergeFences() with a debug retry limit r=gfx-reviewers,jnicol\n\nRetry sync_merge() when it fails with EINTR in AndroidHardwareBuffer::MergeFences(). Limit retries in debug builds to expose persistent interruptions, matching Chromium\u2019s HANDLE_EINTR behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339425\n", "files": ["gfx/layers/AndroidHardwareBuffer.cpp"], "git_node": "8bf6322785fe934eb0e44186bcfca24286555822", "git_parents": ["163709d5f7483aca57ffd00f8fc3e12ea51fa4d8"], "node": "1f343b7b29721e8bcdde831c5060417061eef5f9", "parents": ["455a62969e9c10b95ce212269e1b6bc725fb02d8"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088765 - Update android nightly application-services version bump to c4eb3a25c600c356d06fe40fc5facfcfec464262 r=release-managers,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339401\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "d90bf6bfeac50a277edc2f2c90e8bbecff7afee5", "git_parents": ["8bf6322785fe934eb0e44186bcfca24286555822"], "node": "3455444f2da75a315b328701c5bc7c39fdb0c937", "parents": ["1f343b7b29721e8bcdde831c5060417061eef5f9"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088443 - Filter ping responses before ORB validation. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339092\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp", "testing/web-platform/meta/fetch/orb/tentative/ping.optional.html.ini", "testing/web-platform/tests/fetch/orb/resources/ping.py", "testing/web-platform/tests/fetch/orb/tentative/ping.optional.html"], "git_node": "6feda8c4578b6ffdc3870f332ea2235fc37ea345", "git_parents": ["d90bf6bfeac50a277edc2f2c90e8bbecff7afee5"], "node": "4cf3794465e21d81c1de537847ae9b7dfc442896", "paren