psing-children-nested-margin-trim.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-self-collapsing-children-offsets-nested-multiple-times.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-self-collapsing-children-offsets-nested-once.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-in-inline-002.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-in-inline-005.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-in-inline-006.html.ini", "testing/web-platform/tests/css/css-box/margin-trim/block-container-block-end-propagation-boundaries.html"], "git_node": "858256cf636c727c69ef2beaccbd7dcaced7fc9b", "git_parents": ["9e6136fbb8ede45a1dd190256b09e8d3318debb3"], "node": "20486f32dd5936428b66d6cb8b51236c811cbb16", "parents": ["9ddcd6146334217e2de6c6bbedd34f51124d35eb"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051240 - Add margin-trim to the property database. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338715\n", "files": ["layout/style/test/property_database.js", "testing/web-platform/meta/css/css-box/inheritance.html.ini"], "git_node": "892c696155e7c4bef3b0feb5867e4ed6677eb042", "git_parents": ["858256cf636c727c69ef2beaccbd7dcaced7fc9b"], "node": "73892dea1097f87071f7d91ed7ffbc77b26f98bb", "parents": ["20486f32dd5936428b66d6cb8b51236c811cbb16"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051240 - Enable layout.css.margin-trim.enabled by default on nightly. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336750\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "4628f35fa9702f6a5379bad975960efb588b401e", "git_parents": ["892c696155e7c4bef3b0feb5867e4ed6677eb042"], "node": "94a261848dc71a7fd71b011e5c94f77c9c601db0", "parents": ["73892dea1097f87071f7d91ed7ffbc77b26f98bb"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088026 - cache remote cryptoki objects before acquiring the certificate search state lock r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338938\n", "files": ["security/manager/ssl/nsNSSComponent.cpp"], "git_node": "47ae419b84e7930be1c5c03289720cf10f1230f9", "git_parents": ["4628f35fa9702f6a5379bad975960efb588b401e"], "node": "fd5c5ea8f4a0e3019b430fc46be010030f7806fd", "parents": ["94a261848dc71a7fd71b011e5c94f77c9c601db0"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083856 - Keep the URLs of anchors around block content in extracted page text r=rrando,ai-platform-reviewers,ai-security-reviewers,thasan\n\nListing pages (hotels, products, jobs) wrap each result card in an anchor\naround block content. DOMExtractor only wrote markdown links for inline\nanchors and, outside the google-search strategy, dropped the URL of a block\nanchor from the text; it went to the seen-URL ledger only. The model then had\nnothing to link each item to, and AITab tables linked only the results page.\n\nDOMExtractor now does this for every page, with no new option:\n\n- An anchor around block content is formatted as a markdown link on one of\n  its blocks. The label is the anchor's heading when it is visible and has no\n  link of its own, because a card often opens with a badge or a price;\n  otherwise it is the first block that has no link of its own, so a link is\n  never wrapped inside another one.\n  The google-search strategy keeps its cite selector, and YouTube keeps its\n  setting.\n- An anchor already formatted inline is not wrapped a second time. Before,\n  an image-only link inside a block anchor became a link inside a link.\n- Link URLs count as a fixed length toward sufficientLength, so long\n  tracking URLs do not crowd out the prose of a page. Callers that send the\n  text to a model usually swap each URL for a short token.\n\nAITab already counts each URL at its token length and never cuts inside a\nURL when it trims a page to its budget (bug 2079886).\n\nOn 7 listing test pages (45 cards), the card URLs in the model input went\nfrom 0/45 to 45/45. With the matching prompt change, the generated tables\nlink 45/45 cards for Qwen and Gemini, against 12/45 and 39/45 before.\n\nNew coverage in browser_dom_extractor.js: block-anchor links, the link\ntarget length, links inside a card with and without a heading, a heading with\nits own link, a hidden heading, and a card with no text. Card links in\nbrowser_tools_get_page_content.js.\nThe existing anchor and search-strategy tests are updated for the new\ndefault.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335773\n", "files": ["browser/components/aiwindow/models/tests/browser/browser_tools_get_page_content.js", "toolkit/components/pageextractor/DOMExtractor.sys.mjs", "toolkit/components/pageextractor/PageExtractor.d.ts", "toolkit/components/pageextractor/tests/browser/browser_dom_extractor.js", "toolkit/components/pageextractor/tests/browser/browser_dom_extractor_search_tool.js"], "git_node": "34be9e3155845f2ca0f18afc3fc4e6c33a8a7e6e", "git_parents": ["47ae419b84e7930be1c5c03289720cf10f1230f9"], "node": "f42fcaa18b0f34cd53c1019e9e27b2126901686f", "parents": ["fd5c5ea8f4a0e3019b430fc46be010030f7806fd"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["browser/themes/shared/app-marketplace-icons/LICENSE", "browser/themes/shared/app-marketplace-icons/af/android.png", "browser/themes/shared/app-marketplace-icons/ar/android.png", "browser/themes/shared/app-marketplace-icons/ar/ios.svg", "browser/themes/shared/app-marketplace-icons/az/android.png