"b45f6eda95565fbcc229aa37c041b9232e525ca4", "a3ec512d31965815fea490639c39d8eb47aadb94", "2d147bee928d213673bcb0aa30cd19c86e955253", "a63fb65a6c9421553008f8ba1dc27ae399c20212", "bc27b23f58474c6d3714211c3ac59a68b4ff53db", "8c27489c2b0cf46194ef9af029127a9d3c1943e6", "be307de1dc963b6cb5f86373f2cd0924cff6b6a3", "8d1f3d1e21559ee6a63160a0f752a0c20e62edb0", "410fcbde90c7d906cd4a0ac02ae3405f38ecfd02", "b1505db46ba7d5bbff9418e34b8bd907f6bf196e", "1e47b8b0f7b47577192e9f028ab67d0a1c6840cf", "0aa80c16d636525db17a5161f6941305f2325bcf", "3bdf29bbde001414f2df4d06cf4ea2eb46a3acde", "d7052b45fa0319b72348fff8dbec9b8815a25d5a", "94088a1681c0de9314c512b68fcb04f3353da050", "0e2d20f798532c9bf19434a9844e5166b1363aae", "92a410f49cf7539728637760424d67845e145e42", "d628a34d12908fb235bf5fca1bf188bdad68d4fe", "ae83ea2d6e09bc5def2241e02826becc580dbb13", "01a5aeab7a7dda4eb39ac2311acfa4fda2d9f835", "5911acd3aac2b7c7efb6c89b71e77c148bb76d97", "2ec07e22398d3e66ba139a81fcc2de8efc2c4efd", "705a6d654db1b15db27b478bd26decbc241b64a7", "a6d6021dd8ba556084bb6a9e32c29ecae3d92ac6", "307686390bfbc933a88001710835dd4bc10acb94", "4bca72a3526f59a632d8080aba43613d51c31257", "e9b5c423dc3e126f3e1bd18a3cfaa0950244c514", "d3e2b37067a8bc124ee55887e404cf60c50a5a96", "a9e6d629ce4a84e2647ee2ecab31bccd1116ba64", "4e63d8c0229e74ea3975e6a09ea408c9c50fd489", "5850cc176714d09e105a2ca86c53752d1671e341", "d0741bc6c8a74eef4654294c5d5b0a598965e842", "38e1f0e2c5dc09e11f521566156cbaf80bdd3fdb", "99255d704c05a8c741d744ebfb789f95b790aacc", "6b83159c0b6e3da6a7d579c6b1f5f3814610b250", "818bbe64c71dd396ea05ff742d1bee42113f69c2", "5ac3e10c8b62193464ceb325c29928a3dcdac47a", "263aa1dbdeafea250549f631dc9363de8457678d", "fc5b3d4a829a97a045c04e38168357df847fe002", "84c3a480c4dcc4199c408eab9eddafd670f0b315", "390e056826c973bd3ff9bf0c1ebbc16ad6ac5324", "18877929d1da51b883e4cd826ed8e62f996fbf46", "b14f82a56f2373093040f24d2c788a8cddee0f43", "af1079d7195eeefb645ea4734f139a503ab79959", "d52f03339fc05a774e1e78f2f8fdbacd8537ed43", "7a315fc898bbd3e61ba7dd220a8fb1d0721a1eb7"], "user": "nfay@mozilla.com"}, "45702": {"changesets": [{"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2087770 - Test setting a default value on a deleted shared pref. r=gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338799\n", "files": ["modules/libpref/test/unit_ipc/test_read_deleted_shared_pref.js", "modules/libpref/test/unit_ipc/xpcshell.toml"], "git_node": "e6f63b4473820e48e86c33939218e33e64eeb74f", "git_parents": ["d52f03339fc05a774e1e78f2f8fdbacd8537ed43"], "node": "d4271380fde931baf3c20399dd88588bead0489d", "parents": ["ca595544481bd29136ac6015559284fd0591ea47"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2087770 - Let a deleted shared pref take a default value again. r=gstoll\n\nDeleting a pref that is in the shared pref map leaves a typeless entry\nin the parent to mask it, which SetDefaultValue() rejected for any type.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338800\n", "files": ["modules/libpref/Preferences.cpp"], "git_node": "687e6cddd31fc4365b31825fd19b9c91753cbc6a", "git_parents": ["e6f63b4473820e48e86c33939218e33e64eeb74f"], "node": "12668eeed8d1d3dc574278c643e18185aa2ff5d6", "parents": ["d4271380fde931baf3c20399dd88588bead0489d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076423 - Enforce module script MIME type checks for worklets. r=arai,necko-reviewers,media-playback-reviewers,devtools-reviewers,jdescottes,valentin,padenot\n\nWorklet module fetches never checked the response MIME type against the\nrequested module type, so a top-level worklet script served as e.g. text/plain\nwould run, as would a JSON import served with a non-JSON type.  The netwerk\ncheck can't be used, since all worklet fetches share one content policy type\nregardless of module type; instead plumb the module type to\nWorkletScriptHandler and check there, reporting mismatches to the console.\nThe necko wrong-MIME warning is skipped for worklets, since it claimed the\nscript was loaded anyway.\n\nThis also stops treating application/wasm responses as wasm when the wasm ESM\nintegration pref is off or the module type isn't JavaScript, and gives the\nAudioWorklet test Blobs that relied on the missing check a JavaScript MIME\ntype.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333842\n", "files": ["devtools/client/webconsole/test/browser/test-worker-promise-error.html", "dom/media/test/crashtests/audioworkletnode-after-unload-1.html", "dom/worklet/WorkletFetchHandler.cpp", "dom/worklet/WorkletFetchHandler.h", "dom/worklet/loader/WorkletModuleLoader.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "testing/web-platform/tests/fetch/api/request/destination/fetch-destination.https.html", "testing/web-platform/tests/fetch/api/request/destination/resources/dummy.js"], "git_node": "6887b3096925985fcbc224d9d907f765a32163a9", "git_parents": ["687e6cddd31fc4365b31825fd19b9c91753cbc6a"], "node": "1510822a5ec8254f0ab40d96beff809994665003", "parents": ["12668eeed8d1d3dc574278c643e18185aa2ff5d6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081937 - Key worklet fetching requests by module type as well as URI. r=arai\n\nWorkletModuleLoader tracked in-flight fetches by URI only, while\nModuleLoaderBase treats the same URI imported as different module types as\nseparate fetches.  Concurrent fetches of one URL as two types overwrote each\nother's entry, so one fetch completed the wrong request and the other found no\nrequest (debug) or completed the same one twice (release), leaving the first\nrequest pending forever.  RemoveRequest() also called Remove() inside\nMOZ_ASSERT, so entries were never removed in non-debug builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333843\n", "files": ["dom/worklet/WorkletFetchHandler.cpp", "dom/worklet/WorkletFetchHandler.h", "dom/worklet/loader/WorkletModuleLoader.cpp", "dom/worklet/loader/WorkletModuleLoader.h"], "git_node": "744e7c716eeef44ca1f892f311a2ab1dec58bb45", "git_parents": ["6887b3096925985fcbc224d9d907f765a32163a9"], "node": "86a7f2c0d4941d1f1ebd41b007b7dddcad99f8eb", "parents": ["1510822a5ec8254f0ab40d96beff809994665003"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081937 - Test importing one URL as two module types in a worklet. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333844\n", "files": ["dom/worklet/tests/import_same_url_twice_target.mjs", "dom/worklet/tests/mochitest.toml", "dom/worklet/tests/test_import_same_url_twice.html"], "git_node": "4f2871fa7bffa950b3f3f02b6d6f8da025829d8a", "git_parents": ["744e7c716eeef44ca1f892f311a2ab1dec58bb45"], "node": "f95f2abaf5803c032c18afe6256a8b88123740be", "parents": ["86a7f2c0d4941d1f1ebd41b007b7dddcad99f8eb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076423 - Test worklet module script MIME type checks. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333845\n", "files": ["dom/worklet/tests/mochitest.toml", "dom/worklet/tests/server_mime_type.sjs", "dom/worklet/tests/test_audioWorklet_mimeType.html"], "git_node": "56634cafc109f4931058788dc9147594013c2a4f", "git_parents": ["4f2871fa7bffa950b3f3f02b6d6f8da025829d8a"], "node": "1bb05603a6931bee29b37815f1f7d735218cbfe0", "parents": ["f95f2abaf5803c032c18afe6256a8b88123740be"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082140 - Check the ref count inside of the lock. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334181\n", "files": ["gfx/wr/wr_glyph_rasterizer/src/platform/unix/font.rs"], "git_node": "27f63f7c5826ec4915a47d8696b79bff91d7cca6", "git_parents": ["56634cafc109f4931058788dc9147594013c2a4f"], "node": "1b3ee33b1e1421e52f043c964f4cb1d0da2f316e", "parents": ["1bb05603a6931bee29b37815f1f7d735218cbfe0"], "tags": []}, {"author": "Rana Al-Khulaidi \u003cralkhulaidi@gmail.com\u003e", "branch": "default", "desc": "Bug 2045143 - Add isFxASignedInMozilla targeting attribute. r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305616\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "9f099cf54c5e7b567b3c2b07f45a0c5dae903a85", "git_parents": ["27f63f7c5826ec4915a47d8696b79bff91d7cca6"], "node": "31eb30d986350bf45e34df41ecb3d3c52d8103c7", "parents": ["1b3ee33b1e1421e52f043c964f4cb1d0da2f316e"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061911 - Ask for confirmation before removing an extension r=android-reviewers,android-l10n-reviewers,android-addons-reviewers,marcin,mobiletest-reviewers,parker,aaronmt,robwu\n\nTapping \"Remove\" on an installed extension uninstalled it right away, so an accidental tap would remove the extension and its settings.\n\nA confirmation dialog has been added, allowing the user to either confirm the removal or cancel it. This matches desktop's behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335690\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAddonsManagerPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAddonsManagerSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAddonsManagerAddonDetailedMenuRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonsTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ui/RemoveAddonDialog.kt", "mobile/android/fenix/app/src/main/res/layout/fragment_installed_add_on_details.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/ui/RemoveAddonDialogTest.kt"], "git_node": "c49068741b2069dc47e0d93ec05feebded58c728", "git_parents": ["9f099cf54c5e7b567b3c2b07f45a0c5dae903a85"], "node": "c1c1759fbd579d8f61662a337428f975e6299229", "parents": ["31eb30d986350bf45e34df41ecb3d3c52d8103c7"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082913 - Remove browser.nova.enabled=false coverage from customization tests. r=firefox-desktop-core-reviewers ,Gijs,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338464\n", "files": ["browser/components/customizableui/test/browser_970511_undo_restore_default.js", "browser/components/customizableui/test/browser_customizemode_uidensity.js", "browser/components/customizableui/test/browser_help_panel_cloning.js", "browser/components/customizableui/test/browser_novaHelpSwitchDevicePromo.js", "browser/components/customizableui/test/browser_novaHelpViewLayout.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/customizableui/test/browser_uidensity_auto_touch.js"], "git_node": "222c63cee06e263b5f24a0bbdf5bd645807cb53c", "git_parents": ["c49068741b2069dc47e0d93ec05feebded58c728"], "node": "8d6aee6daa9b83d6283814396c8cbcc72fef1d14", "parents": ["c1c1759fbd579d8f61662a337428f975e6299229"], "tags": []}, {"author": "SaaSha Pina \u003csaasha@heysparkbox.com\u003e", "branch": "default", "desc": "Bug 20590