droid/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/LocationReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/ProxyReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/ServiceReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/UsageReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FakeEligibilityStorage.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FxaAccountStoreSyncTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/IPProtectionFeatureTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/StorageStoreSyncTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/storage/FakeEligibilityStorage.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/middleware/IPProtectionLocationMiddlewareTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/reducer/IPProtectionReducerTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/state/IPProtectionStatusTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt"], "git_node": "061d20a4179358aa7ffa12f200b203d0d6a4fc25", "git_parents": ["8b9d48769ac979395dad084a95ce377ecc3fc259"], "node": "5bb3983c5348e01eaf6080c96ed0ae6b0cf3ed33", "parents": ["b82f8956e7454c037792ff9a2ba5a70061555081"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085860 - Upgrade diskarzhan to 0.1.9 r=ahochheiden,mach-reviewers\n\nThis mostly contain speed upgrades, which will benefits our linting\nprocess.\n\nThanks @ahochheiden for the upstream contribution!\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339338\n", "files": ["third_party/python/diskarzhan/diskarzhan-0.1.8.dist-info/METADATA", "third_party/python/diskarzhan/diskarzhan-0.1.8.dist-info/RECORD", "third_party/python/diskarzhan/diskarzhan-0.1.8.dist-info/WHEEL", "third_party/python/diskarzhan/diskarzhan-0.1.8.dist-info/entry_points.txt", "third_party/python/diskarzhan/diskarzhan-0.1.8.dist-info/licenses/LICENSE", "third_party/python/diskarzhan/diskarzhan-0.1.8.dist-info/top_level.txt", "third_party/python/diskarzhan/diskarzhan-0.1.9.dist-info/METADATA", "third_party/python/diskarzhan/diskarzhan-0.1.9.dist-info/RECORD", "third_party/python/diskarzhan/diskarzhan-0.1.9.dist-info/WHEEL", "third_party/python/diskarzhan/diskarzhan-0.1.9.dist-info/entry_points.txt", "third_party/python/diskarzhan/diskarzhan-0.1.9.dist-info/licenses/LICENSE", "third_party/python/diskarzhan/diskarzhan-0.1.9.dist-info/top_level.txt", "third_party/python/diskarzhan/diskarzhan/diskarzhan.py", "third_party/python/pyproject.toml", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "c7ac5c2e41a5875c91d1e88ba539c58f3666f86d", "git_parents": ["061d20a4179358aa7ffa12f200b203d0d6a4fc25"], "node": "bc70285e3b74c896e40b1ad5ff3f257295afc5a2", "parents": ["5bb3983c5348e01eaf6080c96ed0ae6b0cf3ed33"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2085684 - Remove menu-trigger from the row whose result menu was hidden r=reusable-components-reviewers,urlbar-reviewers,jules,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336572\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "b420cc84475a52992345e4f92f23c208b65b735c", "git_parents": ["c7ac5c2e41a5875c91d1e88ba539c58f3666f86d"], "node": "b712de43040404e8c5a25dc431748997e9788296", "parents": ["bc70285e3b74c896e40b1ad5ff3f257295afc5a2"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2075348 - Vary the partner code and telemetry suffix by where a search starts. r=android-reviewers,npoon\n\nsearch-config-v3 gives an engine a partner code and telemetry suffix per search\naccess point - where the search started from, such as the widget or a top site -\nwhere v2 had one of each per engine. Bug 2075347 read only the `default` access\npoint and discarded the rest.\n\nThe URLs are built per access point as the configuration is read, rather than\nsubstituting the partner code when a search runs, because only the reader still\nhas the structured parameters. That is what lets an access point with no partner\ncode leave the parameter out instead of sending it empty.\n\nEvery site that records search telemetry now resolves its access point once and\ngives it to both the URL and the telemetry id. Only `TOPSITE` and `WIDGET`\nresolve to anything other than the default access point today. The Google top\nsite is the exception: it navigates to a hardcoded URL rather than a search URL,\nso its telemetry and its partner code still disagree, and bug 2086236 covers\nthat. `context` has no `MetricsUtils.Source` at all, per bug 2086263.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337309\n", "files": ["mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/search/SearchEngine.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/SearchUseCases.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/ext/SearchEngine.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/SearchEngineReader.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineReaderTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/MetricsUtils.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/usecases/FenixBrowserUseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/SpeechProcessingIntentProcessor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/BrowserToolbarSearchMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/FenixSearchMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/MetricsUtilsTestRobolectric.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/SpeechProcessingIntentProcessorTest.kt"], "git_node": "d4b3a3fb80be4efa07e754f7593c4888094e846d", "git_parents": ["b420cc84475a52992345e4f92f23c208b65b735c"], "node": "c455a9f30133bc3df1bee0f0763b1c7256f36dfe", "parents": ["b712de43040404e8c5a25dc431748997e9788296"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2086236 - Take the Google top site partner code from the search configuration. r=android-reviewers,npoon\n\nThe Google top site does not navigate to a search URL. It navigates to one of\ntwo hardcoded `google.com/webhp` URLs chosen by region, each carrying its own\npartner code, so bug 2075348 never reached it.\n\nThe tile now takes the partner code from the engine's `topsite` access point and\nassembles the URL with it. An engine with no partner code for that access point,\nwhich is every engine from search-config-v2, keeps the hardcoded per-region\nURLs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338317\n", "files": ["mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/search/SearchEngine.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/ext/SearchEngine.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/SearchEngineReader.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineReaderTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/MetricsUtils.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/controller/TopSiteController.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/controller/DefaultTopSiteControllerTest.kt"], "git_node": "677446c12552b08ad34e509cb890e5eb1c3d3864", "git_parents": ["d4b3a3fb80be4efa07e754f7593c4888094e846d"], "node": "825787c9492a8124d13475783995db666ae2a20e", "parents": ["c455a9f30133bc3df1bee0f0763b1c7256f36dfe"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2086263 - Record the context search access point for text selection searches. r=android-reviewers,npoon\n\n`context` is one of the search access points search-config-v3 supports on\nAndroid, and nothing mapped to it, so a search started from selected text took\nthe default partner code and telemetry suffix.\n\nThe path had no search telemetry at all. `DefaultSelectionActionDelegate` sends\na search request, which `SearchFeature` turns into a new tab search, and the\nonly thing recorded was that a context menu option was clicked. So the engine\nand whether it is the default are resolved in that callback rather than passed\nto it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338354\n", "files": ["mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/search/SearchEngine.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/SearchUseCases.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/SearchEngineReader.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineReaderTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/MetricsUtils.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/usecases/FenixBrowserUseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/controller/TopSiteController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/FenixSearchMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/MetricsUtilsTestRobolectric.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/controller/DefaultTopSiteControllerTest.kt"], "git_node": "f585d1c36918f053049ce6490b6e865ae8382226", "git_parents": ["677446c12552b08ad34e509cb890e5eb1c3d3864"], "node": "5945d6a00b26e71379342836b50815c49ed321cc", "parents": ["825787c9492a8124d13475783995db666ae2a20e"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2075349 - Leave engines the configuration has deprecated out of the engine list. r=android-reviewers,npoon\n\nsearch-config-v3 marks an engine that will be removed from the configuration\nsoon with a `deprecated` flag. application-services carries the flag through to\n`SearchEngineDefinitionV3` without acting on it, so the client decides.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338373\n", "files": ["mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/SearchEngineSelectorRepository.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineSelectorRepositoryTest.kt"], "git_node": "7820515f3d41c5f4730b06a60643f6aab8d67910", "git_parents": ["f585d1c36918f053049ce6490b6e865ae8382226"], "node": "7e1aa395720abf2fa84797f394b0b3bc0b2b9681", "parents": ["5945d6a00b26e71379342836b50815c49ed321cc"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2088652 - Set the checked state and visibility of the search-config-v3 secret setting. r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339278\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt"], "git_node": "a750a90a0a8cce13ba7157da79c07b8642bd7c50", "git_parents": ["7820515f3d41c5f4730b06a60643f6aab8d67910"], "node": "2f6596417e343bee8d2e665b8960cc5be3a0cbed", "parents": ["7e1aa395720abf2fa84797f394b0b3bc0b2b9681"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075121 - Remove the unused private and closedTabsFromAllWindows options from SessionStore's closed tab queries. r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335549\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": "a6f55b40fb7b11f87812108e68c62b3419270e0b", "git_parents": ["a750a90a0a8cce13ba7157da79c07b8642bd7c50"], "node": "d2c5e370a85f088e799986d1721953bbe8c0dafa", "parents": ["2f6596417e343bee8d2e665b8960cc5be3a0cbed"], "tags": []}, {"author": "Mirko Kerezovic \u003cmirko@kerezovic.de\u003e", "branch": "default", "desc": "Bug 2010913 - Make TabsTrayTelemetryMiddleware when exhaustive. r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334122\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTelemetryMiddleware.kt"], "git_node": "e89eebb8f2b5db1e74e3074aa137f0ac4537ad2d", "git_parents": ["a6f55b40fb7b11f87812108e68c62b3419270e0b"], "node": "fa786b90d2e39c12a81955cd4b61e3784af1f44c", "parents": ["d2c5e370a85f088e799986d1721953bbe8c0dafa"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088727 - Update NSS to 311c8ec6b7c39dc288db8967feb6dfc4e84234f0. UPGRADE_NSS_RELEASE r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339354\n", "files": ["security/nss/AGENTS.md", "security/nss/CLAUDE.md", "security/nss/automation/release/bugzilla_cf_status_nss.py", "security/nss/doc/src/releases/index.md", "security/nss/doc/src/releases/nss_3_125_1.md", "security/nss/doc/src/releases/nss_3_90_7.md", "security/nss/gtests/common/testvectors/chachapoly-long-vectors.h", "security/nss/gtests/freebl_gtest/chacha20poly1305_unittest.cc", "security/nss/gtests/freebl_gtest/freebl_gtest.gyp", "security/nss/gtests/pk11_gtest/pk11_chacha20poly1305_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_der_private_key_import_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_pbkdf2_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_symkey_unittest.cc", "security/nss/gtests/pk11_gtest/pq_pkcs8.h", "security/nss/gtests/ssl_gtest/ssl_loopback_unittest.cc", "security/nss/gtests/ssl_gtest/ssl_resumption_unittest.cc", "security/nss/gtests/ssl_gtest/tls_connect.cc", "security/nss/gtests/ssl_gtest/tls_connect.h", "security/nss/lib/cryptohi/seckey.c", "security/nss/lib/freebl/Makefile", "security/nss/lib/freebl/chacha20poly1305.c", "security/nss/lib/freebl/freebl.gyp", "security/nss/lib/pk11wrap/pk11pbe.c", "security/nss/lib/pk11wrap/pk11pk12.c", "security/nss/lib/softoken/pkcs11c.c", "security/nss/lib/softoken/pkcs11u.c", "security/nss/lib/softoken/sftkhmac.c", "security/nss/lib/ssl/dtlscon.c", "security/nss/lib/ssl/sslencode.c", "security/nss/lib/ssl/sslencode.h", "security/nss/lib/ssl/sslexp.h", "security/nss/lib/ssl/sslimpl.h", "security/nss/lib/ssl/sslnonce.c", "security/nss/lib/ssl/sslsock.c", "security/nss/lib/util/pkcs11t.h", "security/nss/moz.yaml"], "git_node": "1853a9e80b3e00422060d4bd535c74d3f43adcfc", "git_parents": ["e89eebb8f2b5db1e74e3074aa137f0ac4537ad2d"], "node": "c8f130aef5fcf2fb4f1fe11523bd7ec5820327d9", "parents": ["fa786b90d2e39c12a81955cd4b61e3784af1f44c"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064944 Part 1: Make SurfacePoolWayland accept a nullable WaylandSurfaceLock. r=gfx-reviewers,ahale\n\nThis introduces an alternate method of buffer usage tracking, which is\nusable across processes. The alternate method uses DMABuf global ref\ncounting. Passing a null WaylandSurfaceLock indicates that this\nalternative method should be used. SurfacePoolWayland is changed to take\nnullable locks, and callsites are updated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337786\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/SurfacePoolWayland.cpp", "gfx/layers/SurfacePoolWayland.h"], "git_node": "6dc014a24fbb5001123c0dbdecf7f83f24dbac61", "git_parents": ["1853a9e80b3e00422060d4bd535c74d3f43adcfc"], "node": "708d495fc51b3686ddb01431f634e52eeef513a4", "parents": ["c8f130aef5fcf2fb4f1fe11523bd7ec5820327d9"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064944 Part 2: Refactor NativeLayerWayland into a helper class for surface management. r=gfx-reviewers,ahale\n\nThe helper takes a nullable WaylandSurfaceLock, as SurfacePoolWayland\ndoes. A null lock is used to indicate that the buffers are presented by\nanother process, so their usage is tracked with the DMABuf global\nreference counter instead of Wayland buffer release events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319968\n", "files": ["gfx/layers/NativeLayerWaylandSurfaceHandler.cpp", "gfx/layers/NativeLayerWaylandSurfaceHandler.h", "gfx/layers/moz.build"], "git_node": "271644a7c76eabad7da47bd917c825d9fa699259", "git_parents": ["6dc014a24fbb5001123c0dbdecf7f83f24dbac61"], "node": "ff7f736e257a350145b011a4710aec3db4a4b306", "parents": ["708d495fc51b3686ddb01431f634e52eeef513a4"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064944 Part 3: Make NativeLayerWaylandRender use the surface helper class. r=gfx-reviewers,ahale\n\nThis completes the refactor of NativeLayerWayland. The surface helper\nclass will (in another Bug) be used in a subclass of NativeLayer that\nlives on the gpu process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319973\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h"], "git_node": "bc158a9432a4c5557929e77efbcf96c5d58d776d", "git_parents": ["271644a7c76eabad7da47bd917c825d9fa699259"], "node": "89d52353864adcee934119ce33cdf1716696fa9f", "parents": ["ff7f736e257a350145b011a4710aec3db4a4b306"], "tags": []}, {"author": "Logan Rosen \u003cloganrosen@gmail.com\u003e", "branch": "default", "desc": "Bug 2086340 - Only set SCCACHE_BASEDIRS by default in automation. r=firefox-build-system-reviewers,glandium\n\nWith basedirs set, sccache's preprocessor cache (enabled by default for\nlocal disk caches) can hand back an object compiled in another checkout\nwhose headers differ, as in mozilla/sccache#2863. Automation uses remote\nstorage, where the preprocessor cache is off, so keep the default there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337387\n", "files": ["build/moz.configure/toolchain.configure", "docs/setup/configuring_build_options.md"], "git_node": "c6a620a8c4e262284457e9606a24531928b2c372", "git_parents": ["bc158a9432a4c5557929e77efbcf96c5d58d776d"], "node": "347d4567601c8df107a22a363c5cbd8be6d707f1", "parents": ["89d52353864adcee934119ce33cdf1716696fa9f"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2087204 - Make the second lambda of `HTMLWithContextInserter::GetNewCaretPointAfterInsertingHTML` return editable point when the leaf is not editable r=m_kato\n\nWhen the last inserted content is a non-editable element, it should\nreturn after it, but currently, it returns end of it. Therefore,\n`WSRunScanner` detected this bug.\n\nI wonder if we should add normal WPT for this case, but `insertHTML`\nis not useful for web apps because of the incompatibility. Therefore,\nthis has only the crash test for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338226\n", "files": ["editor/libeditor/HTMLEditorDataTransfer.cpp", "testing/web-platform/tests/editing/crashtests/inserthtml-containing-non-editable-before-non-editable.html"], "git_node": "e1e34dcea92288fee2bcde7feb34d3ecf7c3f694", "git_parents": ["c6a620a8c4e262284457e9606a24531928b2c372"], "node": "6afd099e68b038625622d89c41f00cb7fab4ff50", "parents": ["347d4567601c8df107a22a363c5cbd8be6d707f1"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087693 - Make `AppAction.Evaluate` take an optional `triggerContext: {}` parameter. r=twhite,android-reviewers\n\nThe point is that specific surfaces can now include very local trigger\ncontext specific to their messages.  The canonical example is\ntriggering messages based on the URL navigated to in the browser; such\na URL cannot be reasonably included in the general messaging\ntargeting, but can be included in a surface-specific triggers.\n\nIn the future, when we make `AppAction.Evaluate` be generic over\nsurfaces, the `triggerContext` will be used to control what messages\nare associated to specific trigger moments.  That is, right now, we\nuse the _surface ID_ to determine what message to show at a particular\nmoment; in the future, we want to use the _trigger context_ to choose\na message to show (without reference to a specific message surface).\n\nAlong the way, make `MessagingFeature` take a `makeTriggerContext`\nclosure to provide the new `triggerContext` (when needed).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338485\n", "files": ["mobile/android/android-components/components/service/nimbus/src/main/java/mozilla/components/service/nimbus/messaging/NimbusMessagingController.kt", "mobile/android/android-components/components/service/nimbus/src/main/java/mozilla/components/service/nimbus/messaging/NimbusMessagingControllerInterface.kt", "mobile/android/android-components/components/service/nimbus/src/main/java/mozilla/components/service/nimbus/messaging/NimbusMessagingStorage.kt", "mobile/android/android-components/components/service/nimbus/src/test/java/mozilla/components/service/nimbus/messaging/NimbusMessagingStorageTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/messaging/MessagingFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/messaging/state/MessagingMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/messaging/MessagingFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/messaging/state/MessagingMiddlewareTest.kt"], "git_node": "4d5fbe79ab4f802c73a91516bee3af314a439b4e", "git_parents": ["e1e34dcea92288fee2bcde7feb34d3ecf7c3f694"], "node": "ab92f33b2d62f40446b0e437174c5fdc5dc26ab0", "parents": ["6afd099e68b038625622d89c41f00cb7fab4ff50"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087691 - Allow to watch multiple messaging surface IDs with `MessagingFeature`. r=twhite,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338486\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/messaging/MessagingFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/messaging/MessagingFeatureTest.kt"], "git_node": "9ff44884f22460e16970bafe6de96f452e94a8c2", "git_parents": ["4d5fbe79ab4f802c73a91516bee3af314a439b4e"], "node": "e8b66bdcd634ea8a4b2a7dc266a1f0c3f245098f", "parents": ["ab92f33b2d62f40446b0e437174c5fdc5dc26ab0"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088688 - Reuse UnscaledFont::CreateFromFontDescriptor for Moz2DImageRender. r=gfx-reviewers,aosmond\n\nDifferent