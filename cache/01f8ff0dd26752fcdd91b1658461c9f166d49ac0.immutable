a/tests/webgpu/webgpu/shader/execution/expression/call/builtin/textureSampleLevel.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/web_platform/canvas/configure.spec.js"], "git_node": "cfa0508a3bcffb86d3f4a5dadf3f97199e025a6e", "git_parents": ["a6e01ce91ad7db2e5aee5c2dbcc30fa1de1e277d"], "node": "f1c11bab78507cb1324c55f1e4e9daeacd0520ff", "parents": ["d70be976447107081df548028a5be27c0da63ade"], "tags": []}], "date": 1792728557, "git_changesets": ["96da67866f916bf88a83415e46bb0e2ecb743aa6", "d83bf36f96fd568ed6ef5a05b668574b72d6ac23", "d74136ea0e4f976c6a0dfae44aad655301568fb3", "07806576b0ba61e5c15a9972c96505dcb87e0091", "96767840b80ec0b831cfdf2eec01be4606c2d9db", "f0219d88990089cc31a089482dfbc29622d0d63a", "8c18222015065a47be11eafc27ee8aadb42fd9b3", "4ec5aa7e96b6f6de9b6238df781f91782092f363", "d656330a8a04c52c51cf6a66bfcd6d781b093a4f", "7fd4eb39d98c6245d8eb141f044c43897ed4172f", "1d9bc9ed888d69eed878809f3b184544b976bfcd", "ca6b1d03bd469538c88d7b42913ea0b2a21987b7", "4f9ade73c7e124ba526e4a989d127b581fe923c0", "06e311b673e1596b5fbde4dba54e703399ce1a73", "006217c78481a5d1878d47145ece8a723da2e9e6", "15c49a6dac52ab8734e3a99d8937a86b1272dc78", "df00cbf51ab00159131938e73cb54580b1edd252", "3c16758421339308cb5bc8361ac9dfc1d918a8c1", "12fa4ab5d3d237677ec4704af47e50170bac459f", "c888b760172b00134e1ea08ce9f2910624d2218e", "e3d574c28dee00d1e586e1dc14d1af771fa371b6", "e940b2854950365466fca51c88e38bd27c88ec32", "c5f3845df84eccdd4f3b286e3f1be7c548402dcd", "557d696040f11d6875e3e90c233b4f7919c52d57", "5947465d264d7f7f8a211cfaa7348f399fc80b01", "a6e01ce91ad7db2e5aee5c2dbcc30fa1de1e277d", "cfa0508a3bcffb86d3f4a5dadf3f97199e025a6e"], "user": "amarc@mozilla.com"}, "45638": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2029706 - Check the format of X11 window properties before reading them. r=stransky,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335845\n", "files": ["widget/gtk/WidgetUtilsGtk.cpp", "widget/gtk/nsWindowX11.cpp"], "git_node": "5fc4ea3944dd108f6f79c093bf8249feb451456e", "git_parents": ["cfa0508a3bcffb86d3f4a5dadf3f97199e025a6e"], "node": "90cecfa4c23221960e56292a5a7d8e3645324ed1", "parents": ["f1c11bab78507cb1324c55f1e4e9daeacd0520ff"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/importer/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/protection-dashboard/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/lib/crash/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-sq/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-es/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sq/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml", "mobile/android/focus-android/app/src/main/res/values-sk/strings.xml"], "git_node": "e63e93f6ae254802c55b181ca9c19975afae741f", "git_parents": ["5fc4ea3944dd108f6f79c093bf8249feb451456e"], "node": "8dfd4828ef96f2b306f741ce0046ac8ae3cca9cb", "parents": ["90cecfa4c23221960e56292a5a7d8e3645324ed1"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2058648 - Keep the GTK emoji picker on the focused window. r=stransky,gtk-reviewers\n\nInsertEmoji() redirected the picker to whatever rollup popup was open, even\none belonging to another toplevel. That popup's hidden GtkEntry then kept\nthe focused toplevel as its insert_text target for as long as the popup\nlived.\n\nRedirect only to a popup of the same toplevel. The entry now also holds a\nreference to its target window, so the target outlives the insert_text\nhandler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334388\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "c25ff1d5742ef3b63aef7e1ca3889f3d839b4d0d", "git_parents": ["e63e93f6ae254802c55b181ca9c19975afae741f"], "node": "e4c27d2501ac93d982f12f164b36d61845b42333", "parents": ["8dfd4828ef96f2b306f741ce0046ac8ae3cca9cb"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042935 - Announce the new position after reordering a moz-box-group reorderable list. r=reusable-components-reviewers,fluent-reviewers,mkennedy,bolsson\n\nWhen options are wrapped in other elements, such as setting-control in\nsettings, moving an item up only fires subtree move events, so NVDA does\nnot announce the item's new position. The group now announces \"Item moved\nto position N of M\" with ariaNotify().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332602\n", "files": ["toolkit/content/tests/widgets/test_moz_box_group.html", "toolkit/content/widgets/moz-box-group/moz-box-group.mjs", "toolkit/locales/en-US/toolkit/global/mozBoxBase.ftl"], "git_node": "b679200a2504c567b0b6b27c8b0f1860bb7a1dfa", "git_parents": ["c25ff1d5742ef3b63aef7e1ca3889f3d839b4d0d"], "node": "3fba52b283d27abd30c0be3d9dbde60922d806c0", "parents": ["e4c27d2501ac93d982f12f164b36d61845b42333"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080339 - Register panel-list anchors as popover invokers in about:profiling. r=profiler-reviewers,mstriemer,canova\n\nThis menu opens on mousedown from a button that isn't the panel-list's popover\ninvoker, so the UA treats the release as outside the popover and light-dismisses\nit. Since bug 2071887 panel-list follows that dismissal, closing the menu as\nsoon as the mouse button is released. Use moz-button's menuId in about:profiling\nand document the invoker requirement in the panel-list README.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333486\n", "files": ["devtools/client/performance-new/components/aboutprofiling/AboutProfiling.js", "devtools/client/performance-new/test/browser/browser_aboutprofiling-more-actions-menu.js", "toolkit/content/widgets/panel-list/README.stories.md"], "git_node": "7ab28335841a813e7a80783db80b4d05669ec96e", "git_parents": ["b679200a2504c567b0b6b27c8b0f1860bb7a1dfa"], "node": "bbe7e1287f0752e7ffe649d7dbc17f6118c80f99", "parents": ["3fba52b283d27abd30c0be3d9dbde60922d806c0"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084579. Show the display color profile's description in about:support. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335955\n", "files": ["gfx/qcms/qcms.h", "gfx/qcms/src/c_bindings.rs", "gfx/qcms/src/gtest.rs", "gfx/qcms/src/iccread.rs", "gfx/thebes/gfxPlatform.cpp"], "git_node": "24a60fee8e770a982c312e7d4c63b98b941263b9", "git_parents": ["7ab28335841a813e7a80783db80b4d05669ec96e"], "node": "f44a483d9afd37d45149df86856c1a20378cf4ed", "parents": ["bbe7e1287f0752e7ffe649d7dbc17f6118c80f99"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084601. Show whether the display color profile came from the pref or the system in about:support. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335971\n", "files": ["gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h"], "git_node": "66bc4052c09de29c91e2744dfa2a823ac4d7e4c0", "git_parents": ["24a60fee8e770a982c312e7d4c63b98b941263b9"], "node": "91adef4c89f3dc2dc62a2e2bcd0fcde6adb82bcd", "parents": ["f44a483d9afd37d45149df86856c1a20378cf4ed"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085033 - Update CI to build OpenH264 2.7.0. r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336200\n", "files": ["taskcluster/kinds/fetch/openh264.yml"], "git_node": "4a469f1be1ab254644715bc20b41a813eca2770b", "git_parents": ["66bc4052c09de29c91e2744dfa2a823ac4d7e4c0"], "node": "63a32d18b0b6510375e3bc7633062a6890944822", "parents": ["91adef4c89f3dc2dc62a2e2bcd0fcde6adb82bcd"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083259 - Record when the text selection menu is dismissed. r=Mardak\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nRecords a `selection_menu.dismissed` event each time the menu closes, paired with `selection_menu.displayed`, and whether the user completed an action from it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334905\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "7069f4c00d48b478e7de8b5495535acb3e7934e3", "git_parents": ["4a469f1be1ab254644715bc20b41a813eca2770b"], "node": "75d7a7750ff7f7bb6f7f5cf901262c951271ec47", "parents": ["63a32d18b0b6510375e3bc7633062a6890944822"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042800: Add the unhandled exception's type to the std::terminate crash reason. r=gsvelto,mac-reviewers,bradwerth,crashreporting-reviewers,afranchuk\n\nnsExceptionHandler.cpp is compiled with -fno-exceptions, so the handler cannot catch the in-flight exception to read its `what()`. The Itanium C++ ABI counts a terminate handler reached from a throw as an exception handler and runs `__cxa_begin_catch()` before it, so `abi::__cxa_current_exception_type()` still returns the type there, and that call compiles with both exceptions and RTTI disabled. Windows uses the MSVC ABI, which has no equivalent entry point, so its crash reason is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302842\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "ac21bb009fae4c92c04de3b8d7f6a0d291b0674d", "git_parents": ["7069f4c00d48b478e7de8b5495535acb3e7934e3"], "node": "9dcd263385b7ab61651f708e8f1f2b3ca58fd211", "parents": ["75d7a7750ff7f7bb6f7f5cf901262c951271ec47"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042800: Catch ObjC exceptions in -[GeckoNSApplication nextEventMatchingMask:...] for diagnostics and Apple-bug mitigation. r=gsvelto,mac-reviewers,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302776\n", "files": ["widget/cocoa/nsAppShell.mm"], "git_node": "3754a2a8cf8baa032baf958b5c27e46e4ff1a9e0", "git_parents": ["ac21bb009fae4c92c04de3b8d7f6a0d291b0674d"], "node": "2ca3c5bdce8f5b0a95f9db517d666709f65fc9a5", "parents": ["9dcd263385b7ab61651f708e8f1f2b3ca58fd211"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084964 - Use logical directions for progress/meter orientation in vertical writing-modes. r=jfkthame,layout-reviewers\n\nProposed change in https://github.com/whatwg/html/pull/13054, matches\nWebKit / Blink.\n\nExtra tests in https://github.com/web-platform-tests/wpt/pull/63544\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336149\n", "files": ["layout/forms/nsProgressFrame.cpp", "layout/reftests/forms/meter/meter-orient-vertical-top-ref.html", "layout/reftests/forms/meter/reftest.list", "testing/web-platform/meta/css/css-writing-modes/forms/meter-appearance-native-vertical-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/meter-appearance-native-vertical.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-native-vertical-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-native-vertical.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-none-vertical-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-none-vertical.optional.html.ini", "widget/Theme.cpp"], "git_node": "41a957327136db085d5793f3cf80bb9360344b2b", "git_parents": ["3754a2a8cf8baa032baf958b5c27e46e4ff1a9e0"], "node": "9b99748527bce26d7347a8656ccfc2529e426870", "parents": ["2ca3c5bdce8f5b0a95f9db517d666709f65fc9a5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085066 - Use Rust edition 2024 for fontations glue. r=jfkthame,layout-reviewers\n\nI wanted to use if let ...  && ... and I couldn't because of this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336230\n", "files": ["gfx/fontations_glue/Cargo.toml", "gfx/fontations_glue/rustfmt.toml"], "git_node": "5af0292500a3a995689f09851f41b3c74890a5ff", "git_parents": ["41a957327136db085d5793f3cf80bb9360344b2b"], "node": "f767a756fbbb21aeee8f041f23bd201946d740e0", "parents": ["9b99748527bce26d7347a8656ccfc2529e426870"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082557 - Hack around broken font metrics of Nimbus family of fonts. r=jfkthame,layout-reviewers\n\nThe OpenType versions of the URW++ \"Nimbus\" fonts (Nimbus Sans, Nimbus\nRoman, Nimbus Mono PS...) have hhea/typo ascents barely above their cap\nheight, with the remaining vertical space in a large line gap, which\nmakes text look shifted upwards.\n\nTheir usWin* metrics match the font bounding box that FreeType used for\nthe Type 1 versions of the same fonts, so use those instead to match the\nrendering from before removing Type 1 support.\n\nGiven these are the default alias to some very common fonts like\nHelvetica or Times, this seems worth it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336231\n", "files": ["gfx/fontations_glue/lib.rs", "gfx/thebes/gfxFT2FontBase.cpp"], "git_node": "79e5add1ed503ecb346e49665dc9ca8212ba9a89", "git_parents": ["5af0292500a3a995689f09851f41b3c74890a5ff"], "node": "6393c38b823370101145f94a56dca279833039a1", "parents": ["f767a756fbbb21aeee8f041f23bd201946d740e0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2085066 - Use unsafe(no_mangle) rather than just no_mangle for FFI functions.\n", "files": ["gfx/fontations_glue/lib.rs"], "git_node": "24196af1cdf3c6292588082706a5c712178bbb00", "git_parents": ["79e5add1ed503ecb346e49665dc9ca8212ba9a89"], "node": "ad96ffcc12ae4e0da8a515237c9870e4758bd8ad", "parents": ["6393c38b823370101145f94a56dca279833039a1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081982. r=edgar\n\nNot the prettiest, but other approaches welcome, see bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335399\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "0cd910133ec7afe53bb66f38c9436bb6083ea5da", "git_parents": ["24196af1cdf3c6292588082706a5c712178bbb00"], "node": "4e063cf163a3b02ee0272fb3c34a3373f316d48c", "parents": ["ad96ffcc12ae4e0da8a515237c9870e4758bd8ad"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082699 - Run the multi locale test package and upload steps through mach instead of make r=jcristau\n\nThese were the last make calls made outside mach, and so the last users\nof `.mozconfig.mk` and the `config.mk` environment exports, which bug\n2038789 will remove. `MakeUploadOutputParser` goes too, because nothing\nreads the retry status it sets. The `echo-variable-PACKAGE` and\n`echo-variable-UPLOAD_FILES` calls are dropped. Their output was only\nlogged, apart from a failure when `PACKAGE` came back empty.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334350\n", "files": ["python/mozbuild/mozbuild/mach_commands.py", "testing/mozharness/mozharness/mozilla/building/buildbase.py", "testing/mozharness/mozharness/mozilla/l10n/multi_locale_build.py"], "git_node": "aaaf80bd10130501fdc34f132ad32803dc4388d2", "git_parents": ["0cd910133ec7afe53bb66f38c9436bb6083ea5da"], "node": "cd249ee9b4c7157335948a319eec70b70b253d12", "parents": ["4e063cf163a3b02ee0272fb3c34a3373f316d48c"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2082900. Create DrawTargetWebgl render textures as ANGLE render targets up front. r=lsalzman\n\nhttps://searchfox.org/firefox-main/rev/4523d65b575546e2b588dfb8b91e3d94ebeec19a/dom/canvas/DrawTargetWebgl.cpp#2746\n\nWe allocate DrawTargetWebgl's render textures with TexStorage and no usage\nhint, so ANGLE's D3D backend creates non-render-target storage for them and\nthen recreates it as render target storage the first time we attach the\ntexture to a framebuffer. The ANGLE update in bug 2079951 picked up\nhttps://github.com/google/angle/commit/17c57c6066ac, which makes recreating\nthe storage also copy the old contents back into staging textures. That\nregressed pdfpaint on Windows by up to 39%.\n\nAdd WebGLContext::HintTexRenderTarget, which sets GL_TEXTURE_USAGE_ANGLE to\nGL_FRAMEBUFFER_ATTACHMENT_ANGLE on D3D ANGLE, and call it before TexStorage\nin BindAndInitRenderTex so ANGLE creates render target storage from the\nstart. It is only for DrawTargetWebgl and is not exposed to content. Every\ncaller of BindAndInitRenderTex attaches the texture to a framebuffer, so the\nnon-render-target storage was never useful. On try this fixes the regressed\npdfpaint tests and leaves them faster than before the ANGLE update.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335528\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextTextures.cpp"], "git_node": "022f5b711c6369d4bf77fe2acf3eafbe1f24a3b6", "git_parents": ["aaaf80bd10130501fdc34f132ad32803dc4388d2"], "node": "861b1cf668b1e4e54fc3409c64865835ff693612", "parents": ["cd249ee9b4c7157335948a319eec70b70b253d12"], "tags": []}, {"author": "Josh Pieper \u003cjjp@pobox.com\u003e", "branch": "default", "desc": "Bug 2084963 - Honor the per-page size in PrintTargetSkPDF::BeginPage. r=lsalzman\n\nLike PrintTargetPDF used to do. We had no test at all for this pref,\namazing.\n\nAdd a browser test based on the one in comment 1 but rewritten to avoid\nhaving to do the temporary file dance or manually parse PDFs.\n\nCo-authored-by: Josh Pieper \u003cjjp@pobox.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336337\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "toolkit/components/printing/tests/browser.toml", "toolkit/components/printing/tests/browser_print_page_size_output.js", "toolkit/components/printing/tests/page_size_mixed.html"], "git_node": "966b17a5e71b0961d9f9cc77d44fa53fe5419d0e", "git_parents": ["022f5b711c6369d4bf77fe2acf3eafbe1f24a3b6"], "node": "7dde70bca8f8460266e79accdc2be1c3761e85a4", "parents": ["861b1cf668b1e4e54fc3409c64865835ff693612"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084963 - Honor the per-page size in PrintTargetSkPDF::BeginPage. r=lsalzman\" for causing wpt failures in page-name-001-print.html.\n\nThis reverts commit 966b17a5e71b0961d9f9cc77d44fa53fe5419d0e.\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "toolkit/components/printing/tests/browser.toml", "toolkit/components/printing/tests/browser_print_page_size_output.js", "toolkit/components/printing/tests/page_size_mixed.html"], "git_node": "fcce6e923cbe95d86f81e7cf35e56507d4d167df", "git_parents": ["966b17a5e71b0961d9f9cc77d44fa53fe5419d0e"], "node": "7d9ab912f54e12810cd89991d4675bd3026a2119", "parents": ["7dde70bca8f8460266e79accdc2be1c3761e85a4"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084107 - [bidi] Do not clear user activation when userActivation is false r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335611\n", "files": ["remote/shared/Realm.sys.mjs", "remote/shared/test/xpcshell/test_Realm.js", "remote/webdriver-bidi/modules/windowglobal/script.sys.mjs"], "git_node": "37ca8e540789f2d1e48576adb1be9f60cac146df", "git_parents": ["fcce6e923cbe95d86f81e7cf35e56507d4d167df"], "node": "f605f61b5705100712e59934e9f75e137e8fee19", "parents": ["7d9ab912f54e12810cd89991d4675bd3026a2119"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084107 - [wdspec] Add tests for userActivation not clearing existing activation r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335612\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/script/call_function/user_activation.py", "testing/web-platform/tests/webdriver/tests/bidi/script/evaluate/user_activation.py"], "git_node": "988533cc3a99dc0725c5650ee0f71a1034e31349", "git_parents": ["37ca8e540789f2d1e48576adb1be9f60cac146df"], "node": "98f920f2b32b04e7ada66757e557595faba50ab0", "parents": ["f605f61b5705100712e59934e9f75e137e8fee19"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084964 - Use logical directions for progress/meter orientation in vertical writing-modes. r=jfkthame,layout-reviewers\" for causing linux reftests failures in meter-vlr.html.\n\nThis reverts commit 41a957327136db085d5793f3cf80bb9360344b2b.\n", "files": ["layout/forms/nsProgressFrame.cpp", "layout/reftests/forms/meter/meter-orient-vertical-top-ref.html", "layout/reftests/forms/meter/reftest.list", "testing/web-platform/meta/css/css-writing-modes/forms/meter-appearance-native-vertical-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/meter-appearance-native-vertical.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-native-vertical-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-native-vertical.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-none-vertical-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-none-vertical.optional.html.ini", "widget/Theme.cpp"], "git_node": "b558ade8a6ae3ac3e4a7ac756acdea78cf49a78e", "git_parents": ["988533cc3a99dc0725c5650ee0f71a1034e31349"], "node": "8d5f8f53eb2622b8abc2b4482bdc09851ae946f1", "parents": ["98f920f2b32b04e7ada66757e557595faba50ab0"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n change