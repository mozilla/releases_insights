s/client/netmonitor/test/websockets/browser_net_ws-messages-navigation.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-sockjs-stomp-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-stomp-payload.js"], "git_node": "9c39628d8a13f72d996899fa7eed1cb00801e55b", "git_parents": ["0a3fd3baad9f2631c6a194c8e6335f58bbe86af1"], "node": "3d9744f085a6a3f8f2a50aaee0bb61169cf84191", "parents": ["4fecfbf16e25c31c32df9e3361b1ef95440d4374"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2088160 - Render clip-path polygon() with WebRender path clips. r=firefox-svg-reviewers,longsonr\n\nWhen gfx.webrender.paths is enabled, polygon() clip paths are recorded with WrPathRecorder like path() and shape() instead of being painted into a mask image.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338802\n", "files": ["gfx/layers/apz/test/mochitest/helper_hittest_clippath.html", "layout/painting/nsDisplayList.cpp", "layout/svg/SVGUtils.cpp", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-fill.html.ini"], "git_node": "9cf2fc489618c77512d5ca84f8c60ea8c0878e52", "git_parents": ["9c39628d8a13f72d996899fa7eed1cb00801e55b"], "node": "601e56d9ce0608309b4dd9a82a891fe9e41ca410", "parents": ["3d9744f085a6a3f8f2a50aaee0bb61169cf84191"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade WebRender thread assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333736\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.cpp", "gfx/layers/wr/OMTASampler.cpp", "gfx/layers/wr/RenderRootStateManager.cpp", "gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderImageHost.cpp", "gfx/layers/wr/WebRenderLayerManager.cpp", "gfx/layers/wr/WebRenderTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidSurfaceTextureHost.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderTextureHost.cpp", "gfx/webrender_bindings/RenderThread.cpp", "gfx/webrender_bindings/RenderThread.h", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "df620f53b137a784e62464b7d26d233a407a7673", "git_parents": ["9cf2fc489618c77512d5ca84f8c60ea8c0878e52"], "node": "97c654ce18fbcef4240d39f6d66d05ad8e54ee24", "parents": ["601e56d9ce0608309b4dd9a82a891fe9e41ca410"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055998 - Ignore repeated return events in urlbar. r=urlbar-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338263\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser/browser_enter.js"], "git_node": "ed50c8d1f53ffc070871e2eb060f2cc8371c47b5", "git_parents": ["df620f53b137a784e62464b7d26d233a407a7673"], "node": "4640631824b9eadb0ec358c973b585155794197f", "parents": ["97c654ce18fbcef4240d39f6d66d05ad8e54ee24"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2086521 - Add PDF.js viewer UI performance tests using PDFs with empty pages. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nTalos pdfpaint mixes the viewer startup with the rendering of the first page,\nso most of its subtests measure the startup.\n\nUse empty PDFs to track viewer opening and interaction costs. Record\nopening milestones separately and run interactions in ASAP mode to\nreduce frame pacing delays.\n\nThe opening, scroll, zoom and go-to times alert. The first open and the\nrender delay, too noisy on try, don't.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337603\n", "files": ["python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "taskcluster/test/data/bugbug-push-schedules.json", "testing/perfdocs/generated/mozperftest.md", "toolkit/components/pdfjs/moz.build", "toolkit/components/pdfjs/test/perf/browser_pdfjs_ui_interaction_perf.js", "toolkit/components/pdfjs/test/perf/browser_pdfjs_ui_open_perf.js", "toolkit/components/pdfjs/test/perf/file_pdfjs_empty_1.pdf", "toolkit/components/pdfjs/test/perf/file_pdfjs_empty_100.pdf", "toolkit/components/pdfjs/test/perf/file_pdfjs_empty_1000.pdf", "toolkit/components/pdfjs/test/perf/head.js", "toolkit/components/pdfjs/test/perf/perftest.toml"], "git_node": "e5fe4a4d7fcf72647a25a9427f50d96a1e04076e", "git_parents": ["ed50c8d1f53ffc070871e2eb060f2cc8371c47b5"], "node": "09fa60796abf2fbd97f0bc982c60e5f9c151cb1c", "parents": ["4640631824b9eadb0ec358c973b585155794197f"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2087754 - Update happy-eyeballs to v1.1.0. r=kershaw,necko-reviewers\n\nSince v1.1.0 the crate port-prefixes the HTTPS query name for a non-443\norigin. nsHostResolver already adds that prefix from the origin port, so\nresolve the origin host for the HTTPS record, as before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338663\n", "files": [".cargo/config.toml.in", "Cargo.lock", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/happy_eyeballs_glue/Cargo.toml", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "third_party/rust/happy-eyeballs/.cargo-checksum.json", "third_party/rust/happy-eyeballs/.clippy.toml", "third_party/rust/happy-eyeballs/.github/workflows/claude.yml", "third_party/rust/happy-eyeballs/.github/workflows/mutants.yml", "third_party/rust/happy-eyeballs/.github/workflows/rust.yml", "third_party/rust/happy-eyeballs/.github/workflows/sbom.yml", "third_party/rust/happy-eyeballs/.oss-scanner/Dockerfile", "third_party/rust/happy-eyeballs/.oss-scanner/threat_model.md", "third_party/rust/happy-eyeballs/Cargo.lock", "third_party/rust/happy-eyeballs/Cargo.toml", "third_party/rust/happy-eyeballs/src/id.rs", "third_party/rust/happy-eyeballs/src/lib.rs", "third_party/rust/happy-eyeballs/tests/common/mod.rs", "third_party/rust/happy-eyeballs/tests/connect_by_name.rs", "third_party/rust/happy-eyeballs/tests/connection_attempts.rs", "third_party/rust/happy-eyeballs/tests/failure.rs", "third_party/rust/happy-eyeballs/tests/hostname_resolution.rs", "third_party/rust/happy-eyeballs/tests/https_records.rs", "third_party/rust/happy-eyeballs/tests/network_config.rs", "third_party/rust/happy-eyeballs/tests/optimistic_dns.rs", "third_party/rust/happy-eyeballs/tests/type_impls.rs"], "git_node": "b9ec779f306c54147c32057d96beb58a056d16bd", "git_parents": ["e5fe4a4d7fcf72647a25a9427f50d96a1e04076e"], "node": "4ea439f9dbe5ca738c0bb8295d597dd045af9d41", "parents": ["09fa60796abf2fbd97f0bc982c60e5f9c151cb1c"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2088592 - Update happy-eyeballs to v2.0.0. r=kershaw,necko-reviewers\n\nv2.0.0 takes AAAA results as ScopedIpv6Addr. Pass them without a scope id\nfor now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339223\n", "files": [".cargo/config.toml.in", "Cargo.lock", "netwerk/protocol/http/happy_eyeballs_glue/Cargo.toml", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "third_party/rust/happy-eyeballs/.cargo-checksum.json", "third_party/rust/happy-eyeballs/Cargo.lock", "third_party/rust/happy-eyeballs/Cargo.toml", "third_party/rust/happy-eyeballs/src/lib.rs", "third_party/rust/happy-eyeballs/tests/common/mod.rs", "third_party/rust/happy-eyeballs/tests/connection_attempts.rs", "third_party/rust/happy-eyeballs/tests/hostname_resolution.rs", "third_party/rust/happy-eyeballs/tests/https_records.rs", "third_party/rust/happy-eyeballs/tests/network_config.rs", "third_party/rust/happy-eyeballs/tests/optimistic_dns.rs"], "git_node": "642d31f9438c7bf9e669b49040439412fe72aedc", "git_parents": ["b9ec779f306c54147c32057d96beb58a056d16bd"], "node": "bf878f744aa5aee50be42ae15f69f93dcbc45afe", "parents": ["4ea439f9dbe5ca738c0bb8295d597dd045af9d41"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083080 - Keep the IPv6 scope id of resolved addresses in Happy Eyeballs, r=necko-reviewers,mxinden,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339222\n", "files": ["netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/test/unit/test_happy_eyeballs_ipv6_link_local.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "f6a2b036e17bcdfc5de8ee4a01d279a0e180cb47", "git_parents": ["642d31f9438c7bf9e669b49040439412fe72aedc"], "node": "a8593607652fc439d9d6545d29812aad4692ccb0", "parents": ["bf878f744aa5aee50be42ae15f69f93dcbc45afe"], "tags": []}, {"author": "Jonatan Wallmander \u003cjonatan.wallmander@kdab.com\u003e", "branch": "default", "desc": "Bug 2025390 - WebGL: Refactor/add checks for attribute count r=nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339090\n", "files": ["dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLProgram.cpp"], "git_node": "cc96a28bb18d1228a907b888769e51cbea5589b4", "git_parents": ["f6a2b036e17bcdfc5de8ee4a01d279a0e180cb47"], "node": "0c187878aef655b169e5bb6e023831aaca8f7e0e", "parents": ["a8593607652fc439d9d6545d29812aad4692ccb0"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088458 - Connection Allowlists: Update spec URL. r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339167\n", "files": ["dom/reporting/ConnectionAllowlistViolationReportBody.h", "dom/security/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlists.h", "dom/security/ConnectionAllowlistsService.h", "dom/security/PolicyContainer.h", "dom/webidl/Reporting.webidl"], "git_node": "ef8c6627a18ba203283a3062105b82b56d74b2f7", "git_parents": ["cc96a28bb18d1228a907b888769e51cbea5589b4"], "node": "b28dff9f4f1542c3e68cea1c7a8c53249a2d7419", "parents": ["0c187878aef655b169e5bb6e023831aaca8f7e0e"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2088786 - Set network.http.speculative-parallel-limit in test_trr_foreground_preconnect.js. r=leggert\n\nThe test waits for the TRR preconnect to establish a TLS connection, so it\nhangs when the application's default speculative connection limit is 0, as\nit is in Thunderbird\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339424\n", "files": ["netwerk/test/unit/test_trr_foreground_preconnect.js"], "git_node": "832d92482f454aff75583a913d6bba54182b129c", "git_parents": ["ef8c6627a18ba203283a3062105b82b56d74b2f7"], "node": "d6c255992d965c16051140599f6b5d30ad2fec85", "parents": ["b28dff9f4f1542c3e68cea1c7a8c53249a2d7419"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2079712 - Trigger character data change when nsContentUtils::SetNodeTextContent reuses the text node of a script element. r=smaug,tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338741\n", "files": ["dom/base/nsContentUtils.cpp"], "git_node": "82a9eb523364286ea512d76f2ed1a91326962a44", "git_parents": ["832d92482f454aff75583a913d6bba54182b129c"], "node": "f2b7c3d6f91141dbc8fe53d69c3e12d65adeba28", "parents": ["d6c255992d965c16051140599f6b5d30ad2fec85"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088160 - Render clip-path polygon() with WebRender path clips. r=firefox-svg-reviewers,longsonr\" for causing mochitest failures @test_group_fission.html.\n\nThis reverts commit 9cf2fc489618c77512d5ca84f8c60ea8c0878e52.\n", "files": ["gfx/layers/apz/test/mochitest/helper_hittest_clippath.html", "layout/painting/nsDisplayList.cpp", "layout/svg/SVGUtils.cpp", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-fill.html.ini"], "git_node": "135219cee2255c920152b42115ee4b79f3713151", "git_parents": ["82a9eb523364286ea512d76f2ed1a91326962a44"], "node": "d9d253866f64e5a713a12d935126d72d7488bce2", "parents": ["f2b7c3d6f91141dbc8fe53d69c3e12d65adeba28"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2025390 - WebGL: Refactor/add checks for attribute count r=nical\" for causing webgl failures @test_conformance__attribs__gl-bindAttribLocation-aliasing.html.\n\nThis reverts commit cc96a28bb18d1228a907b888769e51cbea5589b4.\n", "files": ["dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLProgram.cpp"], "git_node": "76809854ee1293454d148466a22218049421472b", "git_parents": ["135219cee2255c920152b42115ee4b79f3713151"], "node": "4ded28f6e098abb45ad675c54f966195820a0127", "parents": ["d9d253866f64e5a713a12d935126d72d7488bce2"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074493 - Wait for the TLS handshake when the 0-RTT early data limit is reached, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338725\n", "files": ["netwerk/protocol/http/TlsHandshaker.cpp", "netwerk/protocol/http/TlsHandshaker.h", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/test/unit/test_h2_0rtt_early_data_limit.js", "netwerk/test/unit/xpcshell.toml", "security/manager/ssl/tests/unit/tlsserver/cmd/ZeroRttAcceptServer.cpp"], "git_node": "229d531ab4a14ea2dabec193d64d9e9b4cb83af2", "git_parents": ["76809854ee1293454d148466a22218049421472b"], "node": "fa6edc54501c17a7bca20bfbf1d92e8245151161", "parents": ["4ded28f6e098abb45ad675c54f966195820a0127"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081972 - Make sure -moz-label-content only creates one element. r=layout-reviewers,boris\n\nSo that it doesn't break string change optimizations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339263\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "91b647aab0228b7ffcc461b49ec1143d76026ef7", "git_parents": ["229d531ab4a14ea2dabec193d64d9e9b4cb83af2"], "node": "1cdda5db90ebd367af1f87001531d9f376ccbf1f", "parents": ["fa6edc54501c17a7bca20bfbf1d92e8245151161"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088683 - Darken the green and blue nodes in the urlbar frecency diagram so their white text is readable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339302\n", "files": ["browser/components/urlbar/docs/ranking.md"], "git_node": "5acfefd0714a2e59b0bb391284b7ff436ce5b2f5", "git_parents": ["91b647aab0228b7ffcc461b49ec1143d76026ef7"], "node": "eabbab23bc2f5d01194353f8d3a85a12d563d6ff", "parents": ["1cdda5db90ebd367af1f87001531d9f376ccbf1f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088683 - Draw the pipe IPC boxes in the notification server diagrams in translucent gray. r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339304\n", "files": ["toolkit/mozapps/notificationserver/docs/index.md"], "git_node": "6e74cd51b0fbc1d9fe1da4a23940630822836560", "git_parents": ["5acfefd0714a2e59b0bb391284b7ff436ce5b2f5"], "node": "376b0a952b4f6de6628cfb6ad0cf171ff6488bbf", "parents": ["eabbab23bc2f5d01194353f8d3a85a12d563d6ff"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088683 - Draw ZenUML's step numbers in the color of its message labels. r=firefox-source-docs-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339305\n", "files": ["docs/_static/custom_theme.css"], "git_node": "438c3cfda66e6561778edd50bb000c6ce95ac648", "git_parents": ["6e74cd51b0fbc1d9fe1da4a23940630822836560"], "node": "a80a4a4aa09980be92a78419f98143ef18a1d89a", "parents": ["376b0a952b4f6de6628cfb6ad0cf171ff6488bbf"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088818 - Move the stats into the OnStatsAvailable dispatch capture (Coverity CID 1701157) r=necko-reviewers,kershaw\n\nWebTransportSessionProxy::OnStatsAvailable copied the\nMaybe\u003cWebTransportStatsData\u003e into the runnable it dispatches, and did so while\nholding mMutex. Nothing reads the local copy after the dispatch on that path,\nso it can be moved instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339436\n", "files": ["netwerk/protocol/webtransport/WebTransportSessionProxy.cpp"], "git_node": "42d242d08bcfa00fdadfd6d8c7ceb73d04f82791", "git_parents": ["438c3cfda66e6561778edd50bb000c6ce95ac648"], "node": "b00fe44512a01fc4c3082716a8117fd3a34bbf83", "parents": ["a80a4a4aa09980be92a78419f98143ef18a1d89a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088801 - Move the library names in the Linux base profiler shared library enumeration (Coverity CIDs 1703936, 1703930) r=profiler-reviewers,dcarver\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339441\n", "files": ["mozglue/baseprofiler/core/shared-libraries-linux.cc"], "git_node": "f121bd442d190c5b88054e3f7d2557809765d09a", "git_parents": ["42d242d08bcfa00fdadfd6d8c7ceb73d04f82791"], "node": "c4a472bb6323090eb6bae652f3242bb6adf26052", "parents": ["b00fe44512a01fc4c3082716a8117fd3a34bbf83"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088808 - Remove the null checks after std::make_unique in the transferable cache and primitive helpers (Coverity CIDs 1704206, 1704205) r=edgar\n\nstd::make_unique is infallible, so these checks are dead code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339447\n", "files": ["widget/nsPrimitiveHelpers.cpp", "widget/nsTransferable.cpp"], "git_node": "ad1cdd7362847c14925e5b90ff98982ab4d44382", "git_parents": ["f121bd442d190c5b88054e3f7d2557809765d09a"], "node": "9a3c57c0c75ae383a308f25eee103a9b76978b90", "parents": ["c4a472bb6323090eb6bae652f3242bb6adf26052"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088807 - Make the parakeet.cpp throw override a single statement r=padenot,media-webspeech-reviewers\n\nThe `abort(); if (false)` form expands a brace-less `if (c) throw X;`\ninto two statements, so an `else` following it would bind to the\ninner if (false). It also triggers 14 Coverity indentation defects\n(CIDs 1703935, 1703924, 1703932, 1703904, 1703920, 1703900, 1703897,\n1703914, 1703903, 1703902, 1703907, 1703905, 1703894).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339446\n", "files": ["third_party/parakeet.cpp/moz-overrides.h"], "git_node": "166e85802e436420b8c9a9b24c22f8ea8e852259", "git_parents": ["ad1cdd7362847c14925e5b90ff98982ab4d44382"], "node": "0a70c72526da9883acf7d5c971ac558cfb504f2e", "parents": ["9a3c57c0c75ae383a308f25eee103a9b76978b90"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071819 - add keep rules for obfuscation. r=gela\n\nThis is in preparation for turning on obfuscation - which will be a simple follow up \"switch it on\" PR, for ease of backoutability :)\n\nThis changeset adds the keep rules we will need for the app to still work ok with obfuscation on.\n\nAnywhere that navigation arguments using mozilla defined types are used, doesn't play nicely with obfuscation because androidx navigation uses reflection under the hood. So each module now offers a set of consumer proguard rules to allow it to be obfuscated by fenix or focus.\n\n[try after rebase is here](https://treeherder.mozilla.org/jobs?repo=try&revision=63149bcfe31845a0075bf8ab081b7b492107d241)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/425\n", "files": ["mobile/android/android-components/components/browser/state/proguard-rules-consumer.pro", "mobile/android/android-components/components/concept/engine/build.gradle", "mobile/android/android-components/components/concept/engine/proguard-rules-consumer.pro", "mobile/android/android-components/components/concept/storage/build.gradle", "mobile/android/android-components/components/concept/storage/proguard-rules-consumer.pro", "mobile/android/android-components/components/feature/addons/build.gradle", "mobile/android/android-components/components/feature/addons/proguard-rules-consumer.pro"], "git_node": "55ed1e11ca642edf036bc0205abe0001a2a5e091", "git_parents": ["166e85802e436420b8c9a9b24c22f8ea8e852259"], "node": "1c4de9019a28f624764d91f620dc8dea81399762", "parents": ["0a70c72526da9883acf7d5c971ac558cfb504f2e"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084939 - Send age of pulled data on collection sync r=gbeckley,remote-settings-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338677\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs", "services/settings/Utils.sys.mjs", "services/settings/metrics.yaml", "services/settings/test/unit/test_remote_settings.js"], "git_node": "4ca17667e1c34a59d34ec4d5bfa1f4c44ea24df3", "git_parents": ["55ed1e11ca642edf036bc0205abe0001a2a5e091"], "node": "5339b64407e2a047223fdce7cc8c5228f0f797d9", "parents": ["1c4de9019a28f624764d91f620dc8dea81399762"], "tags": []}, {"author": "Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2082440 [wpt PR 63674] - [css-mixins] Rewrite @private names with stylesheet registry (2.1/N), a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Rewrite @private names with stylesheet registry (2.1/N)\n\nReplace StyleRulePrivate and CSSPrivateVariable with selectorless\nStyleRules storing declarations as internal -ua-private- custom\nproperties.\n\nEach StyleSheetContents owns a private PropertyRegistry that maps\ninternal names to authored names and stores optional type registrations.\nIt is shared by stylesheet wrappers, copied during copy-on-write, and\nexcluded from the registered custom property namespace.\n\nDeclarations with the same authored name and nearest style-rule ancestor\nreuse an internal name, while nested style rules receive distinct names.\nCSSPrivateRule reverse-maps them for serialization.\n\nLow-Coverage-Reason: COVERAGE_UNDERREPORTED\nBug: 542651959\nChange-Id: I34f5de0c3ca8b8938f231389431c583f84c01c14\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8508326\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1719303}\n\n--\n\nwpt-commits: 00a955c41136fa3b007646636a270d61573da968\nwpt-pr: 63674\n", "files": ["testing/web-platform/tests/css/css-mixins/private/private-cssom-serialization.tentative.html", "testing/web-platform/tests/css/css-mixins/private/private-shared-stylesheet.tentative.html", "testing/web-platform/tests/css/css-mixins/private/resources/shared-private.css"], "git_node": "199a96c654694452b3bd5421cd998cde1602ecd3", "git_parents": ["4ca17667e1c34a59d34ec4d5bfa1f4c44ea24df3"], "node": "415526908b06994ad52151ded0a1479366c3d920", "parents": ["5339b64407e2a047223fdce7cc8c5228f0f797d9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082440 [wpt PR 63674] - Update wpt metadata, a=testonly\n\nwpt-pr: 63674\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/private/private-shared-stylesheet.tentative.html.ini"], "git_node": "e8f4d2b3d61756de8c3b41a57730f25a00b56e17", "git_parents": ["199a96c654694452b3bd5421cd998cde1602ecd3"], "node": "0dad7159049e787c4e82eaed1c918a90fdb9026e", "parents": ["415526908b06994ad52151ded0a1479366c3d920"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2082491 [wpt PR 63676] - Fix filterable-select-keyboard-behavior.tentative.html failures, a=testonly\n\nAutomatic update from web-platform-tests\nFix filterable-select-keyboard-behavior.tentative.html failures\n\nThis patch fixes two failure modes in\nfilterable-select-keyboard-behavior.tentative.html:\n\n1. StartFiltering() and StopFiltering() were previously called in\n   TextFieldInputType::HandleFocusInEvent and HandleBlurEvent. However,\n   Document::SetFocusedElement skips dispatching focus/focusin/blur\n   events when GetPage()-\u003eGetFocusController().IsFocused() is false. On\n   macOS headless_shell, RenderWidgetHostViewMac::Focus() posts\n   SetPageFocus(true) asynchronously, so focusing the filter \u003cinput\u003e\n   early during test load did not call StartFiltering() to set\n   :active-option. Moving StartFiltering() and StopFiltering() to\n   HTMLInputElement::SetFocused (when focus_type != FocusType::kPage)\n   ensures :active-option is updated synchronously when the input gains\n   or loses focus regardless of page focus state.\n\n2. Adding the 5th subtest in https://crrev.com/c/8490185 increased the\n   number of sequential WebDriver actions enough to exceed the default\n   10s WPT timeout on several bots. Adding \u003cmeta name=timeout\n   content=long\u003e prevents the test from timing out.\n\nFixed: 568838683\nChange-Id: I72dfe6320f0609e72ed33147a70637ee9fdedb62\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8516300\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719312}\n\n--\n\nwpt-commits: a44cc5f44cde2f781495e0ef6ac75ca659f9446c\nwpt-pr: 63676\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/filterable-select/filterable-select-keyboard-behavior.tentative.html"], "git_node": "6d0cef4d8064d85a696e9be5d4d983d4cd432e3d", "git_parents": ["e8f4d2b3d61756de8c3b41a57730f25a00b56e17"], "node": "9d847d3efb27f22cfb7e9078c88e678094ee16c7", "parents": ["0dad7159049e787c4e82eaed1c918a90fdb9026e"], "tags": []}, {"author": "BruceDai \u003cfeng.dai@intel.com\u003e", "branch": "default", "desc": "Bug 2082496 [wpt PR 63684] - webnn: validate opSupportLimits rank ranges for operators with companion operands, a=testonly\n\nAutomatic update from web-platform-tests\nwebnn: validate opSupportLimits rank ranges for operators with companion operands\n\nFollow-up to the rank-validation helpers added in the previous CL, for\noperators whose buildFn has to synthesise companion operands whose\nshapes are derived from the input rank under test:\n\n - conv2d / convTranspose2d build a filter whose input-channel dim\n   matches the input's C dim so the default groups=1 divides evenly.\n - gemm, batchNormalization build the matching second operand / mean /\n   variance for the rank being exercised.\n - gru, gruCell, lstm, lstmCell build weight and recurrentWeight from\n   the steps / inputSize / hiddenSize implied by the input shape, and\n   return the first output of the returned sequence.\n - argMinMax additionally covers every (rank, axis) pair, since the\n   valid axis domain depends on the rank under test.\n\nBug: 501135993\nCq-Include-Trybots: luci.chromium.try\u200b:win11-blink-rel, mac14.arm64-blink-rel, mac14-blink-rel, mac15.arm64-blink-rel, mac15-blink-rel, linux-blink-rel\n\nChange-Id: Ie2abc60a9a32f5921acb1042ee3358a892252ddf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8425104\nAuto-Submit: Dai, Feng \u003cfeng.dai@intel.com\u003e\nReviewed-by: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nCommit-Queue: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719342}\n\n--\n\nwpt-commits: b9c3597497cd81695d8c19294ccc09233b1e243c\nwpt-pr: 63684\n", "files": ["testing/web-platform/tests/webnn/validation_tests/argMinMax.https.any.js", "testing/web-platform/tests/webnn/validation_tests/batchNormalization.https.any.js", "testing/web-platform/tests/webnn/validation_tests/conv2d.https.any.js", "testing/web-platform/tests/webnn/validation_tests/convTranspose2d.https.any.js", "testing/web-platform/tests/webnn/validation_tests/gemm.https.any.js", "testing/web-platform/tests/webnn/validation_tests/gru.https.any.js", "testing/web-platform/tests/webnn/validation_tests/gruCell.https.any.js", "testing/web-platform/tests/webnn/validation_tests/lstm.https.any.js", "testing/web-platform/tests/webnn/validation_tests/lstmCell.https.any.js"], "git_node": "71667d18d2fe323cea6de4dc1d655d08fb1abfa6", "git_parents": ["6d0cef4d8064d85a696e9be5d4d983d4cd432e3d"], "node": "68c310c96222b256d5afee7a087e0f9226f8f201", "parents": ["9d847d3efb27f22cfb7e9078c88e678094ee16c7"], "tags": []}, {"author": "Ryosuke Niwa \u003crniwa@webkit.org\u003e", "branch": "default", "desc": "Bug 2082554 [wpt PR 63689] - Restore the WebKit tests which were erroneously removed in 5493ae6cbd., a=testonly\n\nAutomatic update from web-platform-tests\nRestore the WebKit tests which were erroneously removed in 5493ae6cbd.\n\n--\n\nwpt-commits: 74234dce2f666776904b7b1ecb3de4dd84db5441\nwpt-pr: 63689\n", "files": ["testing/web-platform/tests/html/user-activation/consumption-crossorigin.sub.html", "testing/web-platform/tests/html/user-activation/consumption-sameorigin.html"], "git_node": "c7c12acad23f20574a23237fc8220e23aa8a267c", "git_parents": ["71667d18d2fe323cea6de4dc1d655d08fb1abfa6"], "node": "783dac3a7777062c11cb40f2685cd607c23c3c52", "parents": ["68c310c96222b256d5afee7a087e0f9226f8f201"], "tags": []}, {"author": "Florian Rivoal \u003cgit@florian.rivoal.net\u003e", "branch": "default", "desc": "Bug 2082555 [wpt PR 63690] - Test the effect of line-clamp on last baseline sets, a=testonly\n\nAutomatic update from web-platform-tests\nTest the effect of line-clamp on last baseline sets (#63690)\n\nSee https://github.com/w3c/csswg-drafts/pull/14609\n--\n\nwpt-commits: 7e533fc30ba6da5fff52aee3d8e4aa04ca0a699f\nwpt-pr: 63690\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-baseline-001.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-baseline-001-ref.html"], "git_node": "3268ddd78e84426953077f83ebd85b7d351fbc59", "git_parents": ["c7c12acad23f20574a23237fc8220e23aa8a267c"], "node": "9cf32cef2564fd189acc5f5f7e84a78125ae07d4", "parents": ["783dac3a7777062c11cb40f2685cd607c23c3c52"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082555 [wpt PR 63690] - Update wpt metadata, a=testonly\n\nwpt-pr: 63690\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-baseline-001.html.ini"], "git_node": "0d673e7955699040b5cbd23e0c0da0311c11c310", "git_parents": ["3268ddd78e84426953077f83ebd85b7d351fbc59"], "node": "d0a2a3bfb1e600d6792bfe9ad96ba8278916b88f", "parents": ["9cf32cef2564fd189acc5f5f7e84a78125ae07d4"], "tags": []}, {"author": "Noam Rosenthal \u003cnoamr@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077392 [wpt PR 63176] - Test that sanitizer doesn't affect Noah's ark rule, a=testonly\n\nAutomatic update from web-platform-tests\nTest that sanitizer doesn't affect Noah's ark rule\n\nAttributes removed by the sanitizer should still count towards Noah's ark rule (only 3 identical active formatting elements)\n--\n\nwpt-commits: e652b5999803777612aabadbf3d654d432a6d060\nwpt-pr: 63176\n", "files": ["testing/web-platform/tests/sanitizer-api/sanitizer-in-noahs-ark.html"], "git_node": "968ec29940e1c40a3b0f4aab545de2a3fb6bf4f6", "git_parents": ["0d673e7955699040b5cbd23e0c0da0311c11c310"], "node": "7e69460a0de41f49398089d1def4c414771829b9", "parents": ["d0a2a3bfb1e600d6792bfe9ad96ba8278916b88f"], "tags": []}, {"author": "Maksim Sadym \u003c69349599+sadym-chromium@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080404 [wpt PR 63476] - [testdriver] Add test_driver.bidi.emulation.set_media_features_override, a=testonly\n\nAutomatic update from web-platform-tests\n[testdriver] Add test_driver.bidi.emulation.set_media_features_override (#63476)\n\n- Expose `test_driver.bidi.emulation.set_media_features_override` matching WebDriver BiDi `emulation.setMediaFeaturesOverride`.\n- Allow WPT tests to emulate and override CSS media features (such as `prefers-color-scheme` or `forced-colors`) across browsing contexts.\n- Add `wptrunner` action and protocol handlers along with WPT infrastructure test and documentation.\n\nSpec: https://w3c.github.io/webdriver-bidi/#command-emulation-setMediaFeaturesOverride\n--\n\nwpt-commits: c3b891829f88cb347e9c4e443124cf736e2f2410\nwpt-pr: 63476\n", "files": ["testing/web-platform/tests/docs/writing-tests/testdriver.md", "testing/web-platform/tests/infrastructure/metadata/infrastructure/testdriver/bidi/emulation/set_media_features_override.https.html.ini", "testing/web-platform/tests/infrastructure/testdriver/bidi/emulation/set_media_features_override.https.html", "testing/web-platform/tests/resources/testdriver.js", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/asyncactions.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executorwebdriver.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/protocol.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/testdriver-extra.js"], "git_node": "f57a9d26baf0badbc00125180dcfb81ed0334c06", "git_parents": ["968ec29940e1c40a3b0f4aab545de2a3fb6bf4f6"], "node": "8aab1cd67004b42a9593941058e35c455a98f152", "parents": ["7e69460a0de41f49398089d1def4c414771829b9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080404 [wpt PR 63476] - Update wpt metadata, a=testonly\n\nwpt-pr: 63476\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/infrastructure/testdriver/bidi/emulation/set_media_features_override.https.html.ini"], "git_node": "c25665af176868921ebd364c8d22c2a891ca6bca", "git_parents": ["f57a9d26baf0badbc00125180dcfb81ed0334c06"], "node": "6e9f4111430e01994d0f12f1fd925e29ddc9acff", "parents": ["8aab1cd67004b42a9593941058e35c455a98f152"], "tags": []}, {"author": "Luke Warlow \u003clwarlow@igalia.com\u003e", "branch": "default", "desc": "Bug 2082383 [wpt PR 63419] - Implement moving steps for optgroup and hr, a=testonly\n\nAutomatic update from web-platform-tests\nImplement moving steps for optgroup and hr (#63419)\n\nHTMLOptGroupElement and HTMLHRElement keep a pointer to their owner select, which is set in\ninsertionSteps() and cleared in removingSteps().\nNeither had moving steps, so after a moveBefore() the pointer kept referring to the old select.\nThat left a stale optgroup label rendered outside a select, and hit the owner select assertion in removingSteps() when the element was later removed.\n\nThis adds moving steps to both, matching HTMLOptionElement, they update the owner select and\nrecalculate the list items of the old and new selects.\nThe optgroup also invalidates its shadow tree so its label updates.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326810\n--\n\nwpt-commits: c058d9509ae79209e9729ad8cd5e857598c9f82e\nwpt-pr: 63419\n", "files": ["testing/web-platform/tests/dom/nodes/moveBefore/moveBefore-optgroup-crash.html", "testing/web-platform/tests/dom/nodes/moveBefore/moveBefore-optgroup.html", "testing/web-platform/tests/dom/nodes/moveBefore/moveBefore-select-hr-crash.html"], "git_node": "f346af2811b4e04c47ba0e0d2b91485f2dc3d037", "git_parents": ["c25665af176868921ebd364c8d22c2a891ca6bca"], "node": "382a0e135f71f8bc2daace584a3b1a747f99aff2", "parents": ["6e9f4111430e01994d0f12f1fd925e29ddc9acff"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082383 [wpt PR 63419] - Update wpt metadata, a=testonly\n\nwpt-pr: 63419\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/dom/nodes/moveBefore/chrome-338071841-crash.html.ini"], "git_node": "a3f2a019b793f06c237e960706b47b29b05917f2", "git_parents": ["f346af2811b4e04c47ba0e0d2b91485f2dc3d037"], "node": "0ec61de948b711db1743e1812d968288b14b5985", "parents": ["382a0e135f71f8bc2daace584a3b1a747f99aff2"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080984 [wpt PR 63572] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327231, a=testonly\n\nAutomatic update from web-platform-tests\nDrawing a BGRX VideoFrame should disregard the alpha component (#63572)\n\nRGBX and BGRX VideoFrames must be rendered as if they were opaque:.\nThe fourth byte of a pixel is padding, not alpha.\nIt was handled as alpha, so a padding byte of 0 made the frame transparent when drawn.\n\nVideoFrame gets a virtual shouldIgnoreAlpha(), false by default.\n- VideoFrameCV stores the flag and sets it in createRGBX/createBGRX and when\n  alpha: 'discard' is used. VideoFrame::updateShouldIgnoreAlpha makes a cheap\n  clone sharing the pixel buffer, so an RGBX frame made from an RGBA one is\n  not deep copied. The pixel data is left untouched.\n- VideoFrameCV::create takes a mandatory VideoFrameCV::ShouldIgnoreAlpha when\n  given a color space. The overload computing the color space from the buffer\n  has no flag; resize and asVideoFrameCV set it with updateShouldIgnoreAlpha.\n- The flag is preserved by clone, rotation, resize, SharedVideoFrame and\n  RemoteVideoFrameProxy properties.\n- VideoFrameGStreamer needs no flag since it creates RGBx/BGRx frames.\n\nWhen creating a VideoFrame from a HTMLVideoElement or HTMLImageElement, we are now using ShouldClone::Yes.\nThis is fixing an existing bug where if we create two WebCodecsVideoFrame from the same HTMLVideoElement synchronously,\nwe would use the same underlying VideoFrame, which is ok except if we are discarding alpha/changing timestamp in one but not the other.\nBy using ShouldClone::Yes, when updating, we will clone the VideoFrame around the same underlying resource.\n\nConsumers use the flag as follows:\n- VideoFrame::copyNativeImage creates images without alpha (kCGImageAlphaNoneSkipFirst).\n- copyTo sets the X byte to 255 for RGBX/BGRX, and the RGBA/BGRA row copies\n  now use vImage channel permutations instead of per byte loops.\n- For WebGL texImage, the CG image extractor sets the skipped byte to 255 in\n  a copy of the pixels when the upload format has an alpha component.\n- Encoders convert RGB frames to YUV, which already drops alpha.\n\nWe update ImageTransferSessionVT::createPixelBuffer from a CGImageRef so that it preserves alpha.\nWe add a flag to allow this preservation.\nWe implement it by drawing on premultiplied alpha as CGBitmapContextCreate with kCGImageAlphaFirst does not work..\n\nWe add several tests to cover all consumers and alpha discard code paths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327231\n--\n\nwpt-commits: 8308a42717dd7a8d185709ec6da4af4a50a0bc88\nwpt-pr: 63572\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-alpha-discard-utils.js", "testing/web-platform/tests/webcodecs/videoFrame-alpha-discard.any.js", "testing/web-platform/tests/webcodecs/videoFrame-alpha-discard.window.js", "testing/web-platform/tests/webcodecs/videoFrame-copyTo-rgbx.any.js", "testing/web-platform/tests/webcodecs/videoFrame-drawImage-rgbx.any.js", "testing/web-platform/tests/webcodecs/videoFrame-rgbx-imageBitmap.any.js", "testing/web-platform/tests/webcodecs/videoFrame-rgbx-utils.js", "testing/web-platform/tests/webcodecs/videoFrame-rgbx-webgl.window.js"], "git_node": "1d4babc9c7fe73363ca7725e2767aebe61a73978", "git_parents": ["a3f2a019b793f06c237e960706b47b29b05917f2"], "node": "648bbe7abd18850761b6985274743aea89cbddd9", "parents": ["0ec61de948b711db1743e1812d968288b14b5985"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080984 [wpt PR 63572] - Update wpt metadata, a=testonly\n\nwpt-pr: 63572\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/videoFrame-alpha-discard.any.js.ini", "testing/web-platform/meta/webcodecs/videoFrame-alpha-discard.window.js.ini"], "git_node": "565adec210640381414a4f6b56b7d05a76bf08fe", "git_parents": ["1d4babc9c7fe73363ca7725e2767aebe61a73978"], "node": "ecb73233b235146dfd8bf498956d60e48b0b51f3", "parents": ["648bbe7abd18850761b6985274743aea89cbddd9"], "tags": []}, {"author": "TTyChud \u003chimanshujha1218@gmail.com\u003e", "branch": "default", "desc": "Bug 2076169 [wpt PR 63015] - layout: Apply the iso-8859-8 stylesheet when the document encoding matches, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Apply the iso-8859-8 stylesheet when the document encoding matches\n\nApply the stylesheet that the HTML rendering spec defines for documents decoded as ISO-8859-8.\n\nThose documents are expected to compute `unicode-bidi: bidi-override`, so the `\u003csearch\u003e - unicode-bidi` subtest in `search-styles-iso-8859-8.html` is now an expected failure.\n\nTesting: the `flow-content-0` and `bidi-rendering` WPT directories pass with the two `expected: FAIL` entries in `search-styles-iso-8859-8.html.ini`.\n\nFixes: #48436\nSigned-off-by: TTyChud \u003chimanshujha1218@gmail.com\u003e\n\n--\n\nwpt-commits: 0d41c0ca59c5d2770ea1449574bc1437886fc683\nwpt-pr: 63015\n", "files": ["testing/web-platform/tests/html/rendering/bidi-rendering/unicode-bidi-ua-rules-iso-8859-8.html"], "git_node": "e14a3387c8d9c9b179a25dd3a962c8a36051ba63", "git_parents": ["565adec210640381414a4f6b56b7d05a76bf08fe"], "node": "40b327153912dd8f751538c8e24161a066d1a6e7", "parents": ["ecb73233b235146dfd8bf498956d60e48b0b51f3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076169 [wpt PR 63015] - Update wpt metadata, a=testonly\n\nwpt-pr: 63015\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/rendering/bidi-rendering/unicode-bidi-ua-rules-iso-8859-8.html.ini"], "git_node": "3b5b29613aa8df563444142c66d4024173927518", "git_parents": ["e14a3387c8d9c9b179a25dd3a962c8a36051ba63"], "node": "9a6bddb61fc351e4f8196b0c70ffb8ee3ed9ecb0", "parents": ["40b327153912dd8f751538c8e24161a066d1a6e7"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2081867 [wpt PR 63641] - Lint directories that differ only in case, a=testonly\n\nAutomatic update from web-platform-tests\nLint directories that differ only in case\n\nDUPLICATE-CASE-INSENSITIVE-PATH only compared whole file paths, so #63524 could\nadd WebIDL/ next to webidl/, which a case-insensitive file system merges into\none directory. Compare every directory too, and report the files under the\nspelling with fewer files, so that the stray spelling is flagged regardless of\nthe order the paths are walked in.\n\n--\nUse native path separators in the case-insensitive path test\n\n--\nMake the case-insensitive path lint cheaper\n\nRecord each file and directory spelling once, and return early when no name has\nmore than one spelling, which is the common case. Only then count the files\nunder each spelling, with a Counter, to work out which spelling to report.\n\n--\n\nwpt-commits: db375f75c028077333b1dded88816615cfacde22, b6003ce99dd49562cdbbf663238adecc5d94a234, 08501d2b71db9fd82927f5865d35cd9603ee4ec9\nwpt-pr: 63641\n", "files": ["testing/web-platform/tests/tools/lint/lint.py", "testing/web-platform/tests/tools/lint/tests/test_path_lints.py"], "git_node": "786f0531410af646e38631825764972f6ecb7dd8", "git_parents": ["3b5b29613aa8df563444142c66d4024173927518"], "node": "009eebc272a23133ac1b6f02679d934cf23d4691", "parents": ["9a6bddb61fc351e4f8196b0c70ffb8ee3ed9ecb0"], "tags": []}, {"author": "mxmgorin \u003c102797145+mxmgorin@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079146 [wpt PR 63317] - webgl: Keep the attribute array type when setting a constant attribute, a=testonly\n\nAutomatic update from web-platform-tests\nwebgl: Keep the attribute array type when setting a constant attribute\n\nSigned-off-by: mxmgorin \u003c102797145+mxmgorin@users.noreply.github.com\u003e\n\n--\n\nwpt-commits: abbcb4de39f6aaf2199969f62446e79a285fa831\nwpt-pr: 63317\n", "files": ["testing/web-platform/tests/webgl/vertexAttrib-keeps-array-type.html"], "git_node": "fcc932ba845d551abb50e713ea1779426bbe7d3f", "git_parents": ["786f0531410af646e38631825764972f6ecb7dd8"], "node": "816bd7460b3b213fabb3720edcae34617514cfac", "parents": ["009eebc272a23133ac1b6f02679d934cf23d4691"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2082424 [wpt PR 63695] - [chromium-bidi] Fix network.provideResponse when omitting optional fields, a=testonly\n\nAutomatic update from web-platform-tests\n[chromium-bidi] Fix network.provideResponse when omitting optional fields\n\n- Ensure `network.provideResponse` provides a synthetic response when\n  `body` and `headers` are omitted.\n- Previously, omitting `body` and `headers` caused the command to\n  continue the request instead of fulfilling it via `Fetch.fulfillRequest`.\n- Add WPT `test_status_code_without_body_before_request_sent` in\n  `provide_response/status_code.py` and an E2E regression test in\n  `chromium-bidi`.\n\nBug: 571267467\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I6a5f9ef33852eae6c8101370db1427a08a9cdcde\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8572797\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719481}\n\n--\n\nwpt-commits: 06d23a30082afc6a1e5f8da966dfc07bd0466b28\nwpt-pr: 63695\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/network/provide_response/status_code.py"], "git_node": "6915c3d3adf8bbbf23b1a4ab13ec75a3a35a7baf", "git_parents": ["fcc932ba845d551abb50e713ea1779426bbe7d3f"], "node": "be6422d2a143d18928a330a7aa1c44fff070ce77", "parents": ["816bd7460b3b213fabb3720edcae34617514cfac"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082424 [wpt PR 63695] - Update wpt metadata, a=testonly\n\nwpt-pr: 63695\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/network/provide_response/body.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/provide_response/cookies.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/provide_response/headers.py.ini"], "git_node": "d3548e9bf55ff42fedc171b73e27fa95f8f2925c", "git_parents": ["6915c3d3adf8bbbf23b1a4ab13ec75a3a35a7baf"], "node": "67de74282e7ad76dc2c5ee1f26dc9fc1311e7bd9", "parents": ["be6422d2a143d18928a330a7aa1c44fff070ce77"], "tags": []}, {"author": "Nico Burns \u003cnico@nicoburns.com\u003e", "branch": "default", "desc": "Bug 2066071 [wpt PR 62170] - [css-flexbox] Add intrinsic-size reftest for negative margins on inflexible items, a=testonly\n\nAutomatic update from web-platform-tests\n[css-flexbox] Add intrinsic-size reftests for negative margins on flex items\n\n--\n\nwpt-commits: 152d8364404b8a3e3699e41e1204151fc54cd719\nwpt-pr: 62170\n", "files": ["testing/web-platform/tests/css/css-flexbox/intrinsic-size/col-flex-grow-negative-margin-001.html", "testing/web-platform/tests/css/css-flexbox/intrinsic-size/col-negative-margin-hidden-grid-item-001.html", "testing/web-platform/tests/css/css-flexbox/intrinsic-size/row-009.html", "testing/web-platform/tests/css/css-flexbox/intrinsic-size/row-010.html"], "git_node": "0d1c7d4841680078b2137ae1fe3b3ef616404a32", "git_parents": ["d3548e9bf55ff42fedc171b73e27fa95f8f2925c"], "node": "154234b688fa775f037cf3fa2dead701cc15ba8c", "parents": ["67de74282e7ad76dc2c5ee1f26dc9fc1311e7bd9"], "tags": []}, {"author": "Youenn Fablet \u003cyouenn@apple.com\u003e", "branch": "default", "desc": "Bug 2082574 [wpt PR 63706] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327238, a=testonly\n\nAutomatic update from web-platform-tests\nAllow copyTo to convert to RGB on the fly\n\nWe add support for passing a RGB/BGR format to copyTo.\nWe implement the conversion in VideoFrame::copyTo, limited to using SRGB color space for now.\nA follow-up should allow to support passing a color space to copyTo as well.\n\nWe convert whenever the copyTo expected format is not the internal VideoFrame format.\nWe then use the usual ARGB/BGRA copyTo routines.\n\nWe update LayoutTests/imported/w3c/web-platform-tests/webcodecs/videoFrame-copyTo-rgb.any.js as follows:\n- The rbg2yuv routine needs to be more accurate in its handling of the color space, including fullRange or videoRange.\n- We increase the tolerance by 1 when there is a yuv conversion since there could be additional rouding errors.\n- We split the tests for each tested color as this helps debugging.\n\n--\n\nwpt-commits: 747441a2e2c7a86c1bc6b4363c3a90e100d8bb00\nwpt-pr: 63706\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-copyTo-rgb.any.js", "testing/web-platform/tests/webcodecs/videoFrame-copyTo-rgbx.any.js"], "git_node": "325efc3d11b00602daa68acc2ae5ce777c4730dd", "git_parents": ["0d1c7d4841680078b2137ae1fe3b3ef616404a32"], "node": "ecec0b353c63cfc1f8c53078f0121f98bd0e5f4b", "parents": ["154234b688fa775f037cf3fa2dead701cc15ba8c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082574 [wpt PR 63706] - Update wpt metadata, a=testonly\n\nwpt-pr: 63706\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/videoFrame-copyTo-rgb.any.js.ini"], "git_node": "85119ae556f67be00c52806115e313241374ea4d", "git_parents": ["325efc3d11b00602daa68acc2ae5ce777c4730dd"], "node": "23fb3540cfe5ecf7b88607a3d593560ef076252b", "parents": ["ecec0b353c63cfc1f8c53078f0121f98bd0e5f4b"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@igalia.com\u003e", "branch": "default", "desc": "Bug 2082562 [wpt PR 63692] - net: Replace all matching HTTP cached resources when revalidating, a=testonly\n\nAutomatic update from web-platform-tests\nnet: Replace all matching HTTP cached resources when revalidating\n\nThis change fixes issues with cache revalidation where an older response\nwould be returned from the cache. Now when a new response comes in, it\nreplaces all *matching* older ones using the same logic that is used to\nfind candidate cached resources during load. In addition, when there is\nmore than one matching resource, the *newest matching* is returned.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@igalia.com\u003e\nCo-authored-by: Josh Bowman-Matthews \u003cjosh@joshmatthews.net\u003e\n\n--\n\nwpt-commits: 0ca97a5f9674f833b9f50046b4e8f68eddc86d3d\nwpt-pr: 63692\n", "files": ["testing/web-platform/tests/fetch/http-cache/vary.any.js"], "git_node": "bce5dd78f4810b90136846ccf7f990aafdcadb95", "git_parents": ["85119ae556f67be00c52806115e313241374ea4d"], "node": "589591d479f70f40f23dd5df7478b1656484bf11", "parents": ["23fb3540cfe5ecf7b88607a3d593560ef076252b"], "tags": []}, {"author": "Maksim Sadym \u003c69349599+sadym-chromium@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071541 [wpt PR 62638] - [wdspec] test `emulation.setScrollbarTypeOverride`, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] test `emulation.setScrollbarTypeOverride` (#62638)\n\nCo-authored-by: Henrik Skupin \u003cmail@hskupin.info\u003e\n--\n\nwpt-commits: 42cbc75a89c64ce896ad20736f2393dba7ba2e91\nwpt-pr: 62638\n", "files": ["testing/web-platform/tests/tools/webdriver/webdriver/bidi/modules/emulation.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_scrollbar_type_override/__init__.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_scrollbar_type_override/conftest.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_scrollbar_type_override/contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_scrollbar_type_override/global.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_scrollbar_type_override/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_scrollbar_type_override/scrollbar_type.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_scrollbar_type_override/user_contexts.py"], "git_node": "465dd48a6f6710085071f5488c4307a1c6cade82", "git_parents": ["bce5dd78f4810b90136846ccf7f990aafdcadb95"], "node": "d261619e448859889101c05b4b9c54d6a9b9820a", "parents": ["589591d479f70f40f23dd5df7478b1656484bf11"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071541 [wpt PR 62638] - Update wpt metadata, a=testonly\n\nwpt-pr: 62638\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scrollbar_type_override/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scrollbar_type_override/global.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scrollbar_type_override/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scrollbar_type_override/scrollbar_type.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scrollbar_type_override/user_contexts.py.ini"], "git_node": "deeba6da3d7b4edbc96219a88de40088a9f7f629", "git_parents": ["465dd48a6f6710085071f5488c4307a1c6cade82"], "node": "c2dd98106ad3db7b82db3c1c93227654ccce643f", "parents": ["d261619e448859889101c05b4b9c54d6a9b9820a"], "tags": []}, {"author": "Abhay Agarwal \u003cabhayagarwal1@ibm.com\u003e", "branch": "default", "desc": "Bug 2082626 [wpt PR 63714] - FileAPI: handle host endianness in Blob constructor TypedArray tests, a=testonly\n\nAutomatic update from web-platform-tests\nFileAPI: handle host endianness in Blob constructor TypedArray tests\n\n--\n\nwpt-commits: 5878c7a7c0201cef04904f098351825c5c671d3f\nwpt-pr: 63714\n", "files": ["testing/web-platform/tests/FileAPI/blob/Blob-constructor.any.js"], "git_node": "2ff8f8a0c2aca2f04493318ab45be23ffd1e523d", "git_parents": ["deeba6da3d7b4edbc96219a88de40088a9f7f629"], "node": "4fe4fddd7afb51bff01628122d4fabba40eda486", "parents": ["c2dd98106ad3db7b82db3c1c93227654ccce643f"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2082678 [wpt PR 63719] - Don't consume unrecognized function tokens in shape() functions, a=testonly\n\nAutomatic update from web-platform-tests\nDon't consume unrecognized function tokens in shape() functions\n\nEven though the parsing failed, we consumed function tokens which were\nnever balanced for block levels. Use Peek() for idents before consuming.\n\nBug: 573614362\nChange-Id: If3da296b825d1022d23579509241c55d9c1ccf96\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8578573\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719622}\n\n--\n\nwpt-commits: fcc01db16771f26522ae7c12a6ec3840123dbcbd\nwpt-pr: 63719\n", "files": ["testing/web-platform/tests/css/css-syntax/invalid-shape-block-balancing.html"], "git_node": "f223fdc3050880cb830d0d6ccfb2d242e20d72b1", "git_parents": ["2ff8f8a0c2aca2f04493318ab45be23ffd1e523d"], "node": "26adff959efc303e8cdce6b1014a00f84e713cc4", "parents": ["4fe4fddd7afb51bff01628122d4fabba40eda486"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2082681 [wpt PR 63720] - Peek() for ident before consuming margin-trim token, a=testonly\n\nAutomatic update from web-platform-tests\nPeek() for ident before consuming margin-trim token\n\nWe consumed invalid function tokens which would lead to block balancing\nissues when resuming after an invalid margin-trim declaration.\n\nBug: 573671137\n\nChange-Id: Ic99261751eeddf9c2aa909e52607d0a58667a2ee\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8580348\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719623}\n\n--\n\nwpt-commits: 8169abbe55c68b0694e8daa7f3b01b9798108f81\nwpt-pr: 63720\n", "files": ["testing/web-platform/tests/css/css-syntax/invalid-margin-trim-block-balancing.html"], "git_node": "e5837e703da35493e5e72d8732ddee539c13cd23", "git_parents": ["f223fdc3050880cb830d0d6ccfb2d242e20d72b1"], "node": "2c9ede818457037d3459054d0bc7501cd1f752e0", "parents": ["26adff959efc303e8cdce6b1014a00f84e713cc4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082681 [wpt PR 63720] - Update wpt metadata, a=testonly\n\nwpt-pr: 63720\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-syntax/crashtests/atrule-with-escape-character.html.ini"], "git_node": "0fa124ba3ce66264383e44371230c10d9911f5ea", "git_parents": ["e5837e703da35493e5e72d8732ddee539c13cd23"], "node": "45c143fef4e1a48fc0418266f0da707683a5fa56", "parents": ["2c9ede818457037d3459054d0bc7501cd1f752e0"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2082685 [wpt PR 63721] - [chromium-bidi] Fix accessibility locateNodes in same-origin iframes, a=testonly\n\nAutomatic update from web-platform-tests\n[chromium-bidi] Fix accessibility locateNodes in same-origin iframes\n\n- Use `Accessibility.getRootAXNode` with `frameId: this.id` instead of\n  `DOM.getDocument` when `startNodes` is empty in\n  `#locateNodesByAccessibility`, so same-origin child frames query their\n  own document's AXTree rather than the top-level frame's document.\n- Pass `executionContextId: realm.executionContextId` to\n  `DOM.resolveNode` so matched nodes are resolved in the target realm.\n- Expand WPT `test_locate_in_iframe` and `chromium-bidi` E2E tests to\n  cover accessibility locators in same-origin and cross-origin iframes.\n\nTAG=agy\n\nBug: 571486947\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nChange-Id: I06cfdb01ba97a0d8071881c8379004f56fe17283\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8558489\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719667}\n\n--\n\nwpt-commits: 55aded0764d20bed00ca5d8c0fc314533bf8f18b\nwpt-pr: 63721\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browsing_context/locate_nodes/context.py"], "git_node": "7e3cfa257df952114d74fd1277f260105b2148f1", "git_parents": ["0fa124ba3ce66264383e44371230c10d9911f5ea"], "node": "f0bc52b08ea4dc00b416b81364a3d0649b1243cf", "parents": ["45c143fef4e1a48fc0418266f0da707683a5fa56"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082685 [wpt PR 63721] - Update wpt metadata, a=testonly\n\nwpt-pr: 63721\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/locate_nodes/context.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/locate_nodes/invalid.py.ini"], "git_node": "bb91ed58bc31d03f502c9f6d6683744ddd766213", "git_parents": ["7e3cfa257df952114d74fd1277f260105b2148f1"], "node": "10eb58a0aca7a3fa6162c39e445308761c138558", "parents": ["f0bc52b08ea4dc00b416b81364a3d0649b1243cf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081164 [wpt PR 63589] - WebTransport: improve connection-level stats reporting, a=testonly\n\nAutomatic update from web-platform-tests\nWebTransport: improve connection-level stats reporting (#63589)\n\n- Expose expiredIncoming\u00a0and preserve incoming datagram counters in cached stats after close.\n - Make \u00a0datagrams\u00a0 required.\n - Default estimatedSendRate\u00a0to null.\n - Omit RTT fields until a valid sample exists.\n - Extend existing datagram tests and cover stats before/after connection, including measured RTT variation.\n - Fix WPT polling to await its delay and strengthen stats validation.\n\nSpecs:\nhttps: //www.w3.org/TR/webtransport/#web-transport-connection-stats\nhttps: //www.w3.org/TR/webtransport/#dictdef-webtransportdatagramstats\nChange-Id: Ic2c36b54c5a12a0b20ad7573083e4a4a84b531ad\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8527605\nReviewed-by: Nidhi Jaju \u003cnidhijaju@chromium.org\u003e\nCommit-Queue: Viktoriya Bryhider \u003cvbryhider@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1717811}\n\nCo-authored-by: Viktoriya Bryhider \u003cvbryhider@microsoft.com\u003e\n--\n\nwpt-commits: 7d8962796f4180ebc6187d2c0b45c7fa6fad0a3c\nwpt-pr: 63589\n", "files": ["testing/web-platform/tests/webtransport/stats.https.any.js"], "git_node": "d25f756266e38b4165169b118861e9e79bc27f93", "git_parents": ["bb91ed58bc31d03f502c9f6d6683744ddd766213"], "node": "f0c80a4548f68607328a045d9e0767087ea10bab", "parents": ["10eb58a0aca7a3fa6162c39e445308761c138558"], "tags": []}, {"author": "James Craig \u003ccookiecrook@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079389 [wpt PR 63340] - Tentative: role=none/presentation conflict resolution tests (rebased #50002), a=testonly\n\nAutomatic update from web-platform-tests\nTentative: role=none/presentation conflict resolution tests (acc name + role) (#63340)\n\nRebase of #50002 onto master. Master already added\nwai-aria/role/role_none_conflict_resolution.tentative.html via #50045\n(nested-button tests); #50002 created a same-named file with different\ninput[role=none] tests, causing an add/add conflict. Union both sets into\nthe single file (broadened title, appended the four input tests, added\nverifyGenericRolesBySelector call), and add the new accname test\ncomp_host_language_label.tentative.html.\n\nOriginal tests by @giacomo-petri; rebased onto master and conflicts\nresolved by @cookiecrook.\n\nCo-authored-by: Giacomo Petri \u003cgiacomo.petri@usablenet.com\u003e\n--\n\nwpt-commits: 04d51858390eb4a717fe8ce793b47130376969a3\nwpt-pr: 63340\n", "files": ["testing/web-platform/tests/accname/name/comp_host_language_label.tentative.html", "testing/web-platform/tests/wai-aria/role/role_none_conflict_resolution.tentative.html"], "git_node": "7c4cd151a1d7c67a8cd68438afe087461c8c044b", "git_parents": ["d25f756266e38b4165169b118861e9e79bc27f93"], "node": "73c46745d776c80ae7f0fbb4a821fddb27fffcc9", "parents": ["f0c80a4548f68607328a045d9e0767087ea10bab"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079389 [wpt PR 63340] - Update wpt metadata, a=testonly\n\nwpt-pr: 63340\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/accname/name/comp_host_language_label.tentative.html.ini", "testing/web-platform/meta/wai-aria/role/role_none_conflict_resolution.tentative.html.ini"], "git_node": "25eb0d423f8ae837b82b583364b5876c2b63f2fd", "git_parents": ["7c4cd151a1d7c67a8cd68438afe087461c8c044b"], "node": "df65cf2f497269c8a46f2a4ba462e500590e0787", "parents": ["73c46745d776c80ae7f0fbb4a821fddb27fffcc9"], "tags": []}, {"author": "github-actions[bot] \u003c41898282+github-actions[bot]@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082698 [wpt PR 63657] - Sync interfaces/ with @webref/idl 3.85.2, a=testonly\n\nAutomatic update from web-platform-tests\nSync interfaces/ with @webref/idl 3.85.2 (#63657)\n\nCo-authored-by: wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e\n--\n\nwpt-commits: 0a1a03dc35eca2540abb81eec24b2f4a6a8c95f7\nwpt-pr: 63657\n", "files": ["testing/web-platform/tests/interfaces/SVG.idl", "testing/web-platform/tests/interfaces/container-timing.idl", "testing/web-platform/tests/interfaces/cross-origin-storage.idl", "testing/web-platform/tests/interfaces/cssom-view.idl", "testing/web-platform/tests/interfaces/html.idl", "testing/web-platform/tests/interfaces/install-element.idl", "testing/web-platform/tests/interfaces/mediacapture-extensions.idl", "testing/web-platform/tests/interfaces/model-element.idl", "testing/web-platform/tests/interfaces/serial.idl", "testing/web-platform/tests/interfaces/trusted-types.idl", "testing/web-platform/tests/interfaces/wasm-js-api.idl"], "git_node": "5a13b4e9820e74fce35d7958bcd6c6e4922fa4aa", "git_parents": ["25eb0d423f8ae837b82b583364b5876c2b63f2fd"], "node": "c8d4fb26c6e70d57b8ba4b8558332d8435ca6300", "parents": ["df65cf2f497269c8a46f2a4ba462e500590e0787"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082698 [wpt PR 63657] - Update wpt metadata, a=testonly\n\nwpt-pr: 63657\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-masking/mask-image/backdrop-filter-bad-mask-image.html.ini", "testing/web-platform/meta/fetch/api/credentials/cookies.any.js.ini", "testing/web-platform/meta/html/dom/idlharness.https.html.ini", "testing/web-platform/meta/mediacapture-record/MediaRecorder-requestData.html.ini", "testing/web-platform/meta/selection/selection-shadow-dom-crash-print.html.ini", "testing/web-platform/meta/touch-events/hover-state-caused-by-compatibility-mouse-events.tentative.html.ini", "testing/web-platform/meta/trusted-types/idlharness.window.js.ini", "testing/web-platform/meta/webdriver/tests/classic/accept_alert/accept.py.ini", "testing/web-platform/meta/webrtc/simulcast/setParameters-active.https.html.ini"], "git_node": "48988df5859ef73043ae43c4006975a7c40cd072", "git_parents": ["5a13b4e9820e74fce35d7958bcd6c6e4922fa4aa"], "node": "d3c7a8fa79f7239ebed5dd2ffa00159ddccbba40", "parents": ["c8d4fb26c6e70d57b8ba4b8558332d8435ca6300"], "tags": []}, {"author": "Ravjit Uppal \u003cravjit@chromium.org\u003e", "branch": "default", "desc": "Bug 2082732 [wpt PR 63725] - [CE]Prevent crash when frame is detached during capability element registration, a=testonly\n\nAutomatic update from web-platform-tests\n[CE]Prevent crash when frame is detached during capability element registration\n\nCreating the embedded permission request descriptor can trigger layout\nupdates or script execution that detaches the frame or execution\ncontext.\n\nThis change invokes CreateEmbeddedPermissionRequestDescriptor earlier\nand verifies that the frame, rendered state, receiver binding, and\nexecution context remain valid before proceeding with registration or\npermission requests.\n\nBug: 568730797\nChange-Id: Icd2ac6cfc17a222620e31cbbab88cc31d7c86b7b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8572457\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Thomas Nguyen \u003ctungnh@chromium.org\u003e\nAuto-Submit: Ravjit Uppal \u003cravjit@chromium.org\u003e\nCommit-Queue: Ravjit Uppal \u003cravjit@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719744}\n\n--\n\nwpt-commits: 268c339eda912acecb4b2bbfa68b29a8a8883b45\nwpt-pr: 63725\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/geolocation-element/remove-iframe-during-register-crash.html"], "git_node": "7650899e727f0fef50a0733621024a4c777e5b41", "git_parents": ["48988df5859ef73043ae43c4006975a7c40cd072"], "node": "fce3a37c065ee1abc8b71986b6d6325e9ad75b08", "parents": ["d3c7a8fa79f7239ebed5dd2ffa00159ddccbba40"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2082734 [wpt PR 63726] - Reland \"WebMCP: Re-check for a duplicate tool name after serializing inputSchema\", a=testonly\n\nAutomatic update from web-platform-tests\nReland \"WebMCP: Re-check for a duplicate tool name after serializing inputSchema\"\n\nThis is a reland of commit bbf032940645a5dcea55e6dc1bdb34b8c989650f,\nwhich was reverted in 8a0f949dda972 for breaking the build.\n\nThe original CL was written against a `ModelContext` whose `tool_map_`\nwas keyed by tool name, and checked for a duplicate with\n`tool_map_.find(tool-\u003ename())`. https://crrev.com/c/8510757 landed in\nbetween and changed `tool_map_` to be keyed by tool ID, so that no\nlonger compiled. The reland uses `FindToolDataByName()`, just like the\nup-front duplicate check does.\n\nOriginal change's description:\n\u003e WebMCP: Re-check for a duplicate tool name after serializing inputSchema\n\u003e\n\u003e `registerTool()` rejects a duplicate tool name up front, but then\n\u003e serializes `inputSchema`, which can run script (via `toJSON()`) that\n\u003e registers another tool with the same name. `registerTool()` then still\n\u003e sends the duplicate to the browser, which kills the renderer.\n\u003e\n\u003e Check for a duplicate name again after serialization, next to the\n\u003e existing document-activity re-check, and reject with the same\n\u003e `InvalidStateError` as the up-front check.\n\u003e\n\u003e See https://github.com/webmachinelearning/webmcp/pull/347 for the spec\n\u003e fix.\n\u003e\n\u003e R=khushalsagar\n\u003e\n\u003e Bug: 573722078\n\u003e Change-Id: I044e3ad96fb00c624829eb182047aa30575f81a6\n\nR=khushalsagar\n\nBug: 573722078\nChange-Id: I6b07f7ba6900724d4695ac5f3ee4524e0149736c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8587455\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Fr \u003cbeaufort.francois@gmail.com\u003e\nAuto-Submit: Dominic Farolino \u003cdom@chromium.org\u003e\nReviewed-by: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1719748}\n\n--\n\nwpt-commits: a053bc506b6697f91f23cae24bbd85a273e62238\nwpt-pr: 63726\n", "files": ["testing/web-platform/tests/webmcp/imperative/register-tool-input-schema-registers-same-name.https.html"], "git_node": "f5b56af0e5fe9b83282caa62c09f1e59ef9b7934", "git_parents": ["7650899e727f0fef50a0733621024a4c777e5b41"], "node": "3dd796241cbf9302dfc206c7af133fc599d06037", "parents": ["fce3a37c065ee1abc8b71986b6d6325e9ad75b08"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082734 [wpt PR 63726] - Update wpt metadata, a=testonly\n\nwpt-pr: 63726\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/register-tool-input-schema-registers-same-name.https.html.ini"], "git_node": "27c0848d198099d4b587016744f096591ef31b49", "git_parents": ["f5b56af0e5fe9b83282caa62c09f1e59ef9b7934"], "node": "16233ae839248de49d80389c1cedcca956d5353c", "parents": ["3dd796241cbf9302dfc206c7af133fc599d06037"], "tags": []}, {"author": "Noam Rosenthal \u003cnoamr@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082740 [wpt PR 63729] - Expect Window.onmessage instead of DOMWindow.onmessage in loaf-onmessage.html, a=testonly\n\nAutomatic update from web-platform-tests\nExpect Window.onmessage instead of DOMWindow.onmessage in loaf-onmessage.html (#63729)\n\nThe Long Animation Frames specification constructs event listener invoker names using the event target's WebIDL interface identifier (`Window`), not Blink's internal C++ class name (`DOMWindow`).\n--\n\nwpt-commits: 705331d44391a7656f0e4ab6b312a34ca3ead219\nwpt-pr: 63729\n", "files": ["testing/web-platform/tests/long-animation-frame/loaf-onmessage.html"], "git_node": "3d31b1f5d90539ebfe433a2262d932c062c513e1", "git_parents": ["27c0848d198099d4b587016744f096591ef31b49"], "node": "538ae691f3a25839fd48ccb566424b0cbf4e77ed", "parents": ["16233ae839248de49d80389c1cedcca956d5353c"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082736 [wpt PR 63727] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327147, a=testonly\n\nAutomatic update from web-platform-tests\nAnimated percentage values in SVG text y/dy resolve against the viewport width instead of its height (#63727)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nSVGAnimatedLengthListAccessor::createAnimator() always created the animator\nwith SVGLengthMode::Width, so the from/to/toAtEndOfDuration lists parsed\ntheir lengths in Width mode. During animation, percentage values were\nresolved against the viewport width and then written back in the animated\nlist's own length mode. For \u003ctext\u003e y/dy, which use SVGLengthMode::Height,\nthis gave wrong animated values: for example, animating y to 50% in a\n600x400 viewport produced 300 instead of 200.\n\nPass the length mode of the animated property's base value instead,\nmatching what SVGAnimatedLengthAccessor already does.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327147\nWebKit-Canonical-Link: https://commits.webkit.org/323847@main\n--\n\nwpt-commits: ad450c89a7ba1c42597b5c899d7ba9e309b9e90c\nwpt-pr: 63727\n", "files": ["testing/web-platform/tests/svg/animations/svglengthlist-animation-percentage.html"], "git_node": "5c20b57e561e2deca48ae5e4b3aef3fc1916b249", "git_parents": ["3d31b1f5d90539ebfe433a2262d932c062c513e1"], "node": "234e9a3d71db9544d93a582af951778b10fdd1e5", "parents": ["538ae691f3a25839fd48ccb566424b0cbf4e77ed"], "tags": []}, {"author": "Chris Lilley \u003cchris@w3.org\u003e", "branch": "default", "desc": "Bug 2082749 [wpt PR 63665] - Add progressive png decode and render tests, a=testonly\n\nAutomatic update from web-platform-tests\nprogressive png decode and render tests (#63665)\n--\n\nwpt-commits: 6d4552a8b1057e42a180119d70273f563e53a264\nwpt-pr: 63665\n", "files": ["testing/web-platform/tests/png/progressive/1bit_19x13-progressive-ref.html", "testing/web-platform/tests/png/progressive/1bit_19x13-progressive.html", "testing/web-platform/tests/png/progressive/I16_37x23-progressive-ref.html", "testing/web-platform/tests/png/progressive/I16_37x23-progressive.html", "testing/web-platform/tests/png/progressive/I16_3x5-hdr-progressive-ref.html", "testing/web-platform/tests/png/progressive/I16_3x5-hdr-progressive.html", "testing/web-platform/tests/png/progressive/I16_3x5-progressive-ref.html", "testing/web-platform/tests/png/progressive/I16_3x5-progressive.html", "testing/web-platform/tests/png/progressive/I16_5x3-progressive-ref.html", "testing/web-platform/tests/png/progressive/I16_5x3-progressive.html", "testing/web-platform/tests/png/progressive/I16_64x64-progressive-ref.html", "testing/web-platform/tests/png/progressive/I16_64x64-progressive.html", "testing/web-platform/tests/png/progressive/L_37x23-progressive-ref.html", "testing/web-platform/tests/png/progressive/L_37x23-progressive.html", "testing/web-platform/tests/png/progressive/L_3x5-progressive-ref.html", "testing/web-platform/tests/png/progressive/L_3x5-progressive.html", "testing/web-platform/tests/png/progressive/L_5x3-progressive-ref.html", "testing/web-platform/tests/png/progressive/L_5x3-progressive.html", "testing/web-platform/tests/png/progressive/L_64x64-progressive-ref.html", "testing/web-platform/tests/png/progressive/L_64x64-progressive.html", "testing/web-platform/tests/png/progressive/P_37x23-hdr-progressive-ref.html", "testing/web-platform/tests/png/progressive/P_37x23-hdr-progressive.html", "testing/web-platform/tests/png/progressive/P_37x23-progressive-ref.html", "t