9 - Remove browser.nova.enabled=false coverage from private browsing tests. r=manuel\n\nbrowser.nova.enabled is about to be locked to true, so only the Nova paths need testing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339309\n", "files": ["browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_default_pin_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_default_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nimbus_dismiss.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nimbus_impressions.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nova_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_indicator.js", "browser/components/privatebrowsing/test/browser/head.js"], "git_node": "0d5b2e3f91a9070879d18bdc999898bf554bacf7", "git_parents": ["22c4faf7bf08dfd061ace31dd0d6e2e6bf0012e6"], "node": "5f396d3906b4c56586f8d1ee9553fdbc03a7e238", "parents": ["1a4777407b1c17af24ff61582995b57dc7084d62"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085451 - Remove the Listen to Page notification when the service ends playback r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339262\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionServiceTest.kt"], "git_node": "91bed8c9957a9f4260b9eaf9b4efa13f39e078df", "git_parents": ["0d5b2e3f91a9070879d18bdc999898bf554bacf7"], "node": "7d4f3e88fb80258f665181f4d0e5a7c2f8ec8b2e", "parents": ["5f396d3906b4c56586f8d1ee9553fdbc03a7e238"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088880 - Run the TypeScript lint job when a project's tsconfig.json changes. r=linter-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339503\n", "files": ["taskcluster/kinds/source-test/mozlint.yml"], "git_node": "5ab7739d895ba3996f8494b7bff54db63f84dc52", "git_parents": ["91bed8c9957a9f4260b9eaf9b4efa13f39e078df"], "node": "89cb5a49ba2958f199b6806f7c6ff25f8a04ce34", "parents": ["7d4f3e88fb80258f665181f4d0e5a7c2f8ec8b2e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088797 - Pass the pixel lambda by reference to the SurfacePipe row helpers (Coverity CIDs 1703912, 1703906) r=tnikkel\n\nWritePixels and WritePixelBlocks call the row helpers in a loop, and\nthose helpers took the lambda by value, so forwarding it moved from it\non every iteration after the first. Take it by reference instead, so it\nis neither moved nor copied.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339437\n", "files": ["image/SurfacePipe.h"], "git_node": "81df513a76eb45bae08cf4a5f8e8eed2db73eae1", "git_parents": ["5ab7739d895ba3996f8494b7bff54db63f84dc52"], "node": "fbb431815d5060bc76032349f637f69381b36d87", "parents": ["89cb5a49ba2958f199b6806f7c6ff25f8a04ce34"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087441 - Record markers for bugbug requests in decision task resource usage profiles. r=marco,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338269\n", "files": ["taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "a5dd47c3be5fb7d32a8253f87c9e765accacd791", "git_parents": ["81df513a76eb45bae08cf4a5f8e8eed2db73eae1"], "node": "1545d18dd893b4cba02259983d6bff5cc26c56c4", "parents": ["fbb431815d5060bc76032349f637f69381b36d87"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087441 - Poll bugbug for push schedules every 2 seconds rather than 10. r=marco,taskgraph-reviewers,bhearsum\n\nGenerating the test kinds' tasks waits on bugbug, so polling less often left\nthem waiting up to 10 seconds after its results were ready.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338271\n", "files": ["taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "9e422c56e93f269592e4ef1e515251c8944516b0", "git_parents": ["a5dd47c3be5fb7d32a8253f87c9e765accacd791"], "node": "d09b1a7b16a041f633a9748ab3156be6f7b7ff19", "parents": ["1545d18dd893b4cba02259983d6bff5cc26c56c4"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087441 - make a single bugbug query, and share its results. r=taskgraph-reviewers,bhearsum\n\nWe were making the same bugbug query from various test kinds and the\noptimizer (the cache is ineffective since taskgraph went multiprocess).\nThe decision task now makes that query as soon as it starts, on autoland\nand on try pushes using the bugbug test manifest loader, and writes its\nresult to a file named in the environment, which reaches those processes\nhowever taskgraph starts them, and push_schedules waits for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338272\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_decision.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py", "taskcluster/gecko_taskgraph/test/test_util_bugbug.py", "taskcluster/gecko_taskgraph/util/bugbug.py", "taskcluster/mach_commands.py"], "git_node": "56a7ee279fe275a1f1a75c086039bd5ac5e24cab", "git_parents": ["9e422c56e93f269592e4ef1e515251c8944516b0"], "node": "e86fc38e42818f03a7afda55e463aacdc3a53a74", "parents": ["d09b1a7b16a041f633a9748ab3156be6f7b7ff19"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080511 - Move some tests from attr-all-types.html to attr-argument-grammar.html. r=sajidanwar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339484\n", "files": ["testing/web-platform/tests/css/css-values/attr-all-types.html", "testing/web-platform/tests/css/css-values/attr-argument-grammar.html"], "git_node": "55ff0c2670997d2bd8b0398d3459f51989f220a1", "git_parents": ["56a7ee279fe275a1f1a75c086039bd5ac5e24cab"], "node": "b46a8af75c959e612fe38e9d3d0d131d8bb2a139", "parents": ["e86fc38e42818f03a7afda55e463aacdc3a53a74"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2086768 - Set test_names as an object attribute. r=perftest-reviewers,aglavic DONTBUILD\n\nFixes failures when using condprof on android due to a missing set for test_names. Moved it's initialization to the init method.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337726\n", "files": ["testing/raptor/raptor/browsertime/android.py", "testing/raptor/raptor/perftest.py", "testing/raptor/raptor/raptor.py", "testing/raptor/test/test_raptor.py"], "git_node": "03a5bc09a3ff28590ad9ef1790bbf6170ab51c6d", "git_parents": ["55ff0c2670997d2bd8b0398d3459f51989f220a1"], "node": "ef6c49856e9669d39b64951bdc19a3eb8ea07efb", "parents": ["b46a8af75c959e612fe38e9d3d0d131d8bb2a139"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075980: Suppress unnecessary label asserts. r=yury\n\nIn various places in baseline, an oversize stack frame can abort\ncompilation. This can trigger the assert for Label that all labels are\nbound. But this is basically the same category of failure as an OOM, and\nwe don't fire this assert on OOMs because presumably it's just too\nannoying to convert everything to NonAssertingLabel any time it might\nlive across an OOM.\n\n(A previous attempt at this patch just added NonAssertingLabel in a few\ncases, but it turns out there are all kinds of places where this can\noccur, so I think a more general fix is in order.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339208\n", "files": ["js/src/jit-test/tests/wasm/gc/bug2075980.js", "js/src/jit/JitContext.h", "js/src/jit/Label.cpp", "js/src/wasm/WasmBCFrame.cpp"], "git_node": "4568c305ce9d2434a4dab99b8a0ffa9b80676279", "git_parents": ["03a5bc09a3ff28590ad9ef1790bbf6170ab51c6d"], "node": "797ef7f902c685131314e6e8df83dc59e4f08f88", "parents": ["ef6c49856e9669d39b64951bdc19a3eb8ea07efb"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088875 - [devtools] Await waitUntil calls in application and aboutdebugging tests r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339489\n", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_sidebar_network_runtimes.js", "devtools/client/application/test/browser/head.js"], "git_node": "1d9e8ee184973d406e23970f0aff7f6432e61d96", "git_parents": ["4568c305ce9d2434a4dab99b8a0ffa9b80676279"], "node": "4ba11f6e7e892840f53b0d766e9cd0941550444c", "parents": ["797ef7f902c685131314e6e8df83dc59e4f08f88"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088875 - [devtools] Fix keyboard focus assertions in browser_dbg-features-source-tree.js r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339490\n", "files": ["devtools/client/debugger/test/mochitest/integration/browser_dbg-features-source-tree.js"], "git_node": "3cfd092ddee140ec6b910950d99c2c5ff342ed88", "git_parents": ["1d9e8ee184973d406e23970f0aff7f6432e61d96"], "node": "1f222e3908b1db884c95bfe9833a722513d388f3", "parents": ["4ba11f6e7e892840f53b0d766e9cd0941550444c"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088875 - [devtools] Fix toggleMapScopes and browser_dbg-preview-switch.js waits r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339491\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-preview-switch.js", "devtools/client/debugger/test/mochitest/shared-head.js"], "git_node": "fdff9ad13c6d303f2ea76037d4cff0311960f4f8", "git_parents": ["3cfd092ddee140ec6b910950d99c2c5ff342ed88"], "node": "c945b68abb2b88250629811144a0e48a890bf059", "parents": ["1f222e3908b1db884c95bfe9833a722513d388f3"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088875 - [devtools] Fix race when opening and closing the menu in browser_toolbox_meatball.js r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339492\n", "files": ["devtools/client/framework/test/browser_toolbox_meatball.js"], "git_node": "69483bd83542a3113923869630968d59212290d7", "git_parents": ["fdff9ad13c6d303f2ea76037d4cff0311960f4f8"], "node": "b5a505cc471a1163c502791136399e0d011d9b5b", "parents": ["c945b68abb2b88250629811144a0e48a890bf059"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088875 - [devtools] Fix browser_toolbox_console_new_process.js which never checked the console messages r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339493\n", "files": ["devtools/client/webconsole/test/browser/browser_toolbox_console_new_process.js"], "git_node": "a613ba94e0af3d6c9cc95819ab4708e0e368b715", "git_parents": ["69483bd83542a3113923869630968d59212290d7"], "node": "8fa548439a079baa988a25218e5cbbf2fc556ddf", "parents": ["b5a505cc471a1163c502791136399e0d011d9b5b"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2088782 - Wait for the console to see the paused frame before evaluating r=nchevobbe,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339504\n", "files": ["devtools/client/webconsole/test/browser/browser_jsterm_redeclare_let_const_in_frame.js"], "git_node": "06918073d85e3ce685ed5f9fe317f98705d17a9d", "git_parents": ["a613ba94e0af3d6c9cc95819ab4708e0e368b715"], "node": "8d364ef6d8674eb8cb36377281805a8a8a1b1d3f", "parents": ["8fa548439a079baa988a25218e5cbbf2fc556ddf"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088814 - [bidi] Clear Content-Length when network.continueRequest replaces request body r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339456\n", "files": ["remote/shared/NetworkRequest.sys.mjs"], "git_node": "7fe42eac8d6f7998912e8744dee9ea10646ce016", "git_parents": ["06918073d85e3ce685ed5f9fe317f98705d17a9d"], "node": "3c4429ccc3a8789ab466884e5d89f53a0ceb376c", "parents": ["8d364ef6d8674eb8cb36377281805a8a8a1b1d3f"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088814 - [wdspec] Add test to check body received after network.continueRequest r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339457\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/network/continue_request/body.py", "testing/web-platform/tests/webdriver/tests/support/http_handlers/body_echo.py"], "git_node": "b0a6501890916aa42e2e9855ec041426b7d6197e", "git_parents": ["7fe42eac8d6f7998912e8744dee9ea10646ce016"], "node": "1ce34a539236c30e81fd47434634866c9e1816d5", "parents": ["3c4429ccc3a8789ab466884e5d89f53a0ceb376c"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt1. Introduce MASM ops to make indirect targets explicit r=jandem,iain\n\nIntroduce the indirectTarget MASM operation to explicitly label indirect\ntargets emitted by JIT code. Currently this is a no-op, but it can be used\nin the future to easily insert code before/after all indirect targets.\n\nA use-case for this is emitting the landing-pad instructions required by\nhardware enforced forward-edge control-flow integrity like IBT (endbr64)\non x86_64 and BTI (bti) on ARM64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335462\n", "files": ["js/src/jit/Ion.cpp", "js/src/jit/JitRuntime.h", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/none/MacroAssembler-none.h", "js/src/jit/shared/Assembler-shared.h", "js/src/jit/wasm32/MacroAssembler-wasm32.h"], "git_node": "bf95836597e5874fd3370fe4022a4bebadfae1f2", "git_parents": ["b0a6501890916aa42e2e9855ec041426b7d6197e"], "node": "6818f386b96a9d947958d5d73ab6e931e5dea692", "parents": ["1ce34a539236c30e81fd47434634866c9e1816d5"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt2. Annotate indirect targets in Baseline JIT, Interpreter and ICs r=jandem,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335463\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineIC.cpp"], "git_node": "646c43292ae88a97279fa098afa71e822dc99a74", "git_parents": ["bf95836597e5874fd3370fe4022a4bebadfae1f2"], "node": "f7ceca84775a06dc8b784e34c82cd394436653b5", "parents": ["6818f386b96a9d947958d5d73ab6e931e5dea692"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt3. Annotate indirect targets for BaselineDebugModeOSR resume points r=iain,jandem\n\nExecution may resume in the Baseline Interpreter or a Baseline Script at return sites\ncorresponding to specific RetAddrEntry Kinds due to BaselineDebugModeOSR. These sites need\nto be marked as valid indirect jump targets. In the case of Baseline compiled scripts,\nthis is only required if recompilation (with or without debug instrumentation) was triggered\nby DebugOSR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335464\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineCompileTask.h", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h"], "git_node": "8540a8081f21208d2a592a07b9314591ca2b700b", "git_parents": ["646c43292ae88a97279fa098afa71e822dc99a74"], "node": "1328b213f95cb2df543d5eaf5dc18c5615dc5e37", "parents": ["f7ceca84775a06dc8b784e34c82cd394436653b5"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt4. Annotate indirect targets in Ion/IonICs r=iain,jandem\n\n- Ion and lowers MTableSwitch to a jump table, and dispatches to case blocks\nthrough an indirect jump. To mark annotate these as targets, LBlock gets an\nisIndirectJumpTarget flag, which visitTableSwitch sets during lowering.\n- Since codegen skips trivial blocks, these annotations must be propagated to\nthe actual non-trivial block corresponding to switch targets. A new\nPropagateIndirectJumpTargets pass does this just before code generation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335465\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/Ion.cpp", "js/src/jit/IonCacheIRCompiler.cpp", "js/src/jit/LIR.cpp", "js/src/jit/LIR.h", "js/src/jit/Lowering.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/CodeGenerator-shared.h"], "git_node": "62a288e4a78164a651501d0d5455a333973b4db2", "git_parents": ["8540a8081f21208d2a592a07b9314591ca2b700b"], "node": "3a94507895429b4085c829627e93d53f19e7b350", "parents": ["1328b213f95cb2df543d5eaf5dc18c5615dc5e37"], "tags": []}, {"author": "Abhishek Sharma \u003cabhishekcs@protonmail.com\u003e", "branch": "default", "desc": "Bug 2083571 - pt5. Annotate indirect targets in JIT trampolines/stubs and RegExp compilation r=jandem,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335466\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/InterpreterEntryTrampoline.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/Trampoline.cpp", "js/src/jit/TrampolineNatives.cpp", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/Trampoline-arm64.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x64/Trampoline-x64.cpp"], "git_node": "892657fc6176059859e30c4a507d60f5657ccb0a", "git_parents": ["62a288e4a78164a651501d0d5455a333973b4db2"], "node": "a3dfa1b68be5fd0c1e37f8ce45f2786a9b547fb0", "parents": ["3a94507895429b4085c829627e93d53f19e7b350"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084126 - Enable listen to page by default in dev, nightly r=android-reviewers,matt-tighe,mobiletest-reviewers,aaronmt\n\n- Also updates some Selectors to be tolerant of listen to page\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338984\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/NavigationToolbarRobot.kt"], "git_node": "b00092666fb12452f59be1cfebeb7a10bf4c7552", "git_parents": ["892657fc6176059859e30c4a507d60f5657ccb0a"], "node": "74e96f3e1275e18901df7a55d72a81774a21c967", "parents": ["a3dfa1b68be5fd0c1e37f8ce45f2786a9b547fb0"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2088510 - Wait for the add-ons manager list after removing an add-on in UI tests r=ajoltan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339206\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAddonsManagerAddonDetailedMenuRobot.kt"], "git_node": "98ac2ff3193322f30a33a46186f25d4672e758eb", "git_parents": ["b00092666fb12452f59be1cfebeb7a10bf4c7552"], "node": "2c5cf10308de2d139aba2ede08ccc045741e03b4", "parents": ["74e96f3e1275e18901df7a55d72a81774a21c967"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074423 - Fix openHistoryItemTest efficiency UI test r=aaronmt\n\nThe UI test was failing because clicking a history item opens the page in the browser.\nThe test didn't know that it had left the \"History\" screen and failed trying to leave a screen that was already gone.\n\nTo fix this, I've added an openHistoryItem() helper that taps the history item, waits for the browser\u2019s engine view, and records the move to BrowserPage so the test knows it\u2019s on the browser before checking the URL.\n\nThe UI test successfully passed 50x on Firebase \u2705\nAll efficiency UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339512\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/HistoryPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HistoryTest.kt"], "git_node": "7c83ec25b6d402fa15650b7ab701ac84e2aa23f2", "git_parents": ["98ac2ff3193322f30a33a46186f25d4672e758eb"], "node": "1e00cef21f74edcebe884e8bd49b9608ddedf99f", "parents": ["2c5cf10308de2d139aba2ede08ccc045741e03b4"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088755 - Update EngineDispatcher to only be idle when nothing is running. r=ai-platform-reviewers,valentinp\n\nUpdates `EngineDispatcher` to stay alive while any run is in progress, and `MLEngine` to reject pending requests when the engine shuts down.\n\n- Tracks running requests and returns to IDLE after the last one finishes.\n- Adds `#setStatus` for handling status transitions.\n- Starts the idle timeout only when IDLE.\n- Rejects pending requests on termination, termination timeout, or inference process crash.\n- Moves the port check in `run()` and `runWithGenerator()` before the request is queued.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339396\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/docs/api.md", "toolkit/components/ml/tests/browser/browser_ml_engine_lifetime.js"], "git_node": "362fcb56e211c295278a6d5b9e6b57f04f947f76", "git_parents": ["7c83ec25b6d402fa15650b7ab701ac84e2aa23f2"], "node": "7c08723fbeea119b7b0c17abe6712fa41704ad57", "parents": ["1e00cef21f74edcebe884e8bd49b9608ddedf99f"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088788 - Add haptic feedback to onboarding buttons, links, toggl\u2026 r=lottie,corentin\n\nGated behind `FeatureFlags.onboardingHapticsEnabled` (Nightly and debug only) so it can be tried on-device before deciding whether to ship it. Swipes only play when the pager settles after a user drag, so advancing with a button does not buzz twice.\n\n**Reviewer notes**: To test in debug, enable the`FeatureFlag` ` val onboardingFeatureEnabled = Config.channel.isDebug` and have fresh install.\n\n**Implementation notes**: the wrapping helpers (`hapticOnClick`, `hapticOnLinkClick`, `hapticOnCheckedChange`) live in the onboarding package for now. They are the first tap haptics in the tree (existing usages are all long-press, or Confirm on pull-to-refresh), so we should move to android-components compose/base alongside `LongPressIconButton` if the we move this change into production.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/429\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FeatureFlags.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/ManagePrivacyPreferencesDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/HapticOnClick.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/MarketingDataOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/TermsOfServiceOnboardingPage.kt"], "git_node": "ea0a0b11be23a45ee1c47cf286cb20a10f1da480", "git_parents": ["362fcb56e211c295278a6d5b9e6b57f04f947f76"], "node": "a8441150bee860863cb63035e3fbf3a8b870d989", "parents": ["7c08723fbeea119b7b0c17abe6712fa41704ad57"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087182 - Record markers for python-test test files and tests in run-task resource usage profiles. r=releng-reviewers,bhearsum\n\nThe test subprocesses forward their markers through mozunit's pytest plugin,\nwhich reads the forwarding path before tests run since some, like\nmozsystemmonitor's, unset it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338080\n", "files": ["config/mozunit/mozunit/pytest_plugin.py", "python/mach_commands.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "31ef8fb93d3dc752b40c1cc2fbbe0537a1f2327f", "git_parents": ["ea0a0b11be23a45ee1c47cf286cb20a10f1da480"], "node": "d108a8d221b82bfe81e461aeaf0b07cf6d4ac33e", "parents": ["a8441150bee860863cb63035e3fbf3a8b870d989"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087183 - Record markers for hg.mozilla.org queries in decision task resource usage profiles. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338081\n", "files": ["taskcluster/gecko_taskgraph/util/hg.py"], "git_node": "f36574aa3b80837f86832890c8584e9d26fc8dc4", "git_parents": ["31ef8fb93d3dc752b40c1cc2fbbe0537a1f2327f"], "node": "38abec64ca496ac25964d442cba387e892ea3313", "parents": ["d108a8d221b82bfe81e461aeaf0b07cf6d4ac33e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087161 - Install uv in the decision image and give the decision task a uv cache. r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nMach creates the taskgraph site with uv when it is available, which is faster\nthan pip, and the cache avoids downloading its requirements on every push.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338082\n", "files": [".taskcluster.yml", "taskcluster/docker/decision/Dockerfile"], "git_node": "32e4acbda7eb8cb12f2d5fbb95361f4a981bd57e", "git_parents": ["f36574aa3b80837f86832890c8584e9d26fc8dc4"], "node": "dbf0611e58a64bc036ee25ab9147cf4e22a94d92", "parents": ["38abec64ca496ac25964d442cba387e892ea3313"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087436 - Use the gecko_decision image for git decision tasks, and record their resource usage. r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nThe image has run-task-git, along with the startup hook and resourcemonitor.py\nthat taskgraph's run-task image lacks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338265\n", "files": [".taskcluster.yml"], "git_node": "08a4fac27f43dffe4e696284f45e2ac64326dd7a", "git_parents": ["32e4acbda7eb8cb12f2d5fbb95361f4a981bd57e"], "node": "4fec85071ff665f51165df39a175c3507b83311f", "parents": ["dbf0611e58a64bc036ee25ab9147cf4e22a94d92"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087438 - Don't preserve the timestamps of the scripts the decision task uploads as artifacts. r=taskgraph-reviewers,bhearsum\n\nTheir artifact markers in the resource usage profile are timestamped with the\nfiles' modification times, so copying those from the checkout put the markers\nbefore the task even started.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338266\n", "files": ["taskcluster/gecko_taskgraph/decision.py"], "git_node": "da0c5555c8162d2d49b83e39f2305225e47c4764", "git_parents": ["08a4fac27f43dffe4e696284f45e2ac64326dd7a"], "node": "96b01667cd12b913ac733a4fdd1f9059b806aa43", "parents": ["4fec85071ff665f51165df39a175c3507b83311f"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087439 - Record markers for git fetches in decision task resource usage profiles. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338267\n", "files": ["taskcluster/gecko_taskgraph/decision.py"], "git_node": "6ab618d9c024c38f0a340f30e5c089926ff7f565", "git_parents": ["da0c5555c8162d2d49b83e39f2305225e47c4764"], "node": "8fadf7bd095cda5fd04d54567c023f5b3f373362", "parents": ["96b01667cd12b913ac733a4fdd1f9059b806aa43"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087440 - Record markers for virtualenv creation and pip installs in mozharness resource usage profiles. r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338268\n", "files": ["testing/mozharness/mozharness/base/python.py"], "git_node": "049daa5c426a12cb0ab7b1035ab7790178435f7f", "git_parents": ["6ab618d9c024c38f0a340f30e5c089926ff7f565"], "node": "207cf283e9c5ad3702c9ec418c4601400c75d812", "parents": ["8fadf7bd095cda5fd04d54567c023f5b3f373362"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074327 - Container tab Stroke updated for Nova r=settings-reviewers,desktop-theme-reviewers,fxview-reviewers,tabbrowser-reviewers,sidebar-reviewers,urlbar-reviewers,nsharpley,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334717\n", "files": ["browser/base/content/main-popupset.js", "browser/components/contextualidentity/content/container-select.css", "browser/components/contextualidentity/content/usercontext.css", "browser/components/contextualidentity/test/browser/browser_container_definitions_in_sync.js", "browser/components/firefoxview/opentabs-tab-row.css", "browser/components/sidebar/sidebar-tab-row.css", "browser/components/tabbrowser/content/tabs.mjs", "browser/components/tabbrowser/content/tabsplitview.mjs", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/tabbrowser/tab-hover-preview.css", "browser/themes/shared/tabbrowser/tabs.css", "browser/themes/shared/urlbar/view-nova.css", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_contextual_identities.js"], "git_node": "ed5bb545f6486d2b67375baf928454d4f97637ca", "git_parents": ["049daa5c426a12cb0ab7b1035ab7790178435f7f"], "node": "5af60b405c36dfff03acd5cc1cebfcced3ff6dde", "parents": ["207cf283e9c5ad3702c9ec418c4601400c75d812"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074327 - Rename --identity-stroke-color to --identity-color r=settings-reviewers,desktop-theme-reviewers,fxview-reviewers,tabbrowser-reviewers,sidebar-reviewers,urlbar-reviewers,Gijs,nsharpley,dao,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334718\n", "files": ["browser/components/contextualidentity/content/container-select.css", "browser/components/contextualidentity/content/usercontext.css", "browser/components/contextualidentity/test/browser/browser_container_definitions_in_sync.js", "browser/components/firefoxview/opentabs-tab-row.css", "browser/components/sidebar/sidebar-tab-row.css", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/tabbrowser/tab-hover-preview.css", "browser/themes/shared/tabbrowser/tabs.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/usercontext/container-editor.css", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/config.mjs"], "git_node": "6d7e0f320698b11c02e1e0f73591a8501a5b906d", "git_parents": ["ed5bb545f6486d2b67375baf928454d4f97637ca"], "node": "05ed360804250eaa88fe130eeea29d1374f84adc", "parents": ["5af60b405c36dfff03acd5cc1cebfcced3ff6dde"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088556 - Keep forward entries in navigation.entries() after a cross-document replace navigation. r=dom-core-reviewers,avandolder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339210\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "testing/web-platform/tests/navigation-api/navigation-history-entry/entries-after-cross-document-replace-with-forward-entries.html"], "git_node": "f16a298ee2d60967c71e9ba78087c2261093abbc", "git_parents": ["6d7e0f320698b11c02e1e0f73591a8501a5b906d"], "node": "1e67e11ced6c3220b5ec5d3207c029cba7ec40dd", "parents": ["05ed360804250eaa88fe130eeea29d1374f84adc"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2084492 - Use NewDecoderWithoutBOMHandling in TextEncoderStream. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339513\n", "files": ["dom/encoding/TextEncoderStream.cpp"], "git_node": "a3639ca8fe1089008b4afb910e830843f9b1fd0c", "git_parents": ["f16a298ee2d60967c71e9ba78087c2261093abbc"], "node": "fbdba472a25a7bd41397d561b4ac27247d6fac78", "parents": ["1e67e11ced6c3220b5ec5d3207c029cba7ec40dd"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088632, don't setup or initialize form handling if no valid fields have been found, r=dimi,credential-management-reviewers\n\nThis change allows similar behaviour when ML is enabled as when ML is not enabled, and improves performance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339259\n", "files": ["toolkit/components/formautofill/FormAutofillChild.sys.mjs", "toolkit/components/formautofill/FormAutofillParent.sys.mjs"], "git_node": "ef0aa668c37b8dd26c0098a03c17fa58387be202", "git_parents": ["a3639ca8fe1089008b4afb910e830843f9b1fd0c"], "node": "96ab1e207c9b068452ef789fa3b7eaae8c5aaf55", "parents": ["fbdba472a25a7bd41397d561b4ac27247d6fac78"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084854 - Rename the \"*** PurgeTrackerService:\" log module to \"PurgeTrackerService\". r=timhuang\n\nMOZ_LOG reads the colon as a separator and does not accept \"*\" or spaces\nin a module name, so it could not configure this module.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337631\n", "files": ["toolkit/components/antitracking/PurgeTrackerService.sys.mjs"], "git_node": "9968c150907c7ffa4df5f047fe6969d0fddc86e5", "git_parents": ["ef0aa668c37b8dd26c0098a03c17fa58387be202"], "node": "b537ed0f500925f47a77dc87ef379d2ddd155c47", "parents": ["96ab1e207c9b068452ef789fa3b7eaae8c5aaf55"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084854 - Rename the \"Login crypto\", \"Login storage\" and \"LoginHelper(\u003cprocess\u003e)\" log modules to \"LoginCrypto\", \"LoginStorage\" and \"LoginHelper.\u003cprocess\u003e\". r=credential-management-reviewers,joschmidt\n\nMOZ_LOG could not configure these modules:\n- \"Login crypto\" and \"Login storage\" become \"LoginCrypto\" and\n  \"LoginStorage\": MOZ_LOG reads the space as a separator.\n- \"LoginHelper(Main)\" and \"LoginHelper(Content)\" become\n  \"LoginHelper.Main\" and \"LoginHelper.Content\": MOZ_LOG does not accept\n  parentheses in a module name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337632\n", "files": ["toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/components/passwordmgr/crypto-SDR.sys.mjs", "toolkit/components/passwordmgr/storage-geckoview.sys.mjs"], "git_node": "59732023eb8c7c6569c194148b6979adf502c3da", "git_parents": ["9968c150907c7ffa4df5f047fe6969d0fddc86e5"], "node": "2e871a91d9722cd49be9a2d862ead1e8c7961d38", "parents": ["b537ed0f500925f47a77dc87ef379d2ddd155c47"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084854 - Rename the \"ML:OpenAIPipeline\" and \"ML:LlamaCppPipeline\" log modules to \"GeckoMLOpenAIPipeline\" and \"GeckoMLLlamaCppPipeline\". r=ai-platform-reviewers,valentinp\n\nMOZ_LOG reads the colon as a separator, so it could not configure these\nmodules. The new names follow the one of GeckoMLONNXPipeline.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337633\n", "files": ["toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/OpenAIPipeline.mjs"], "git_node": "f0755bc4632771e4b02809a1d1fb90394f643e7a", "git_parents": ["59732023eb8c7c6569c194148b6979adf502c3da"], "node": "1aef29839398ef8c1cd6b695fc90c6c7178ccbec", "parents": ["2e871a91d9722cd49be9a2d862ead1e8c7961d38"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084854 - Rename the \"BackupService::ArchiveEncryption\" log module to \"BackupService.ArchiveEncryption\". r=mconley\n\nMOZ_LOG reads the colons as separators, so it could not configure this\nmodule.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337634\n", "files": ["browser/components/backup/ArchiveEncryptionState.sys.mjs"], "git_node": "498f71dc1c8d88217514b930c721585995d7bca4", "git_parents": ["f0755bc4632771e4b02809a1d1fb90394f643e7a"], "node": "86bab140100885e218181c6f2ba048ad4f6bf1f7", "parents": ["1aef29839398ef8c1cd6b695fc90c6c7178ccbec"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084253: Clear the restore flag if a window does not close r=tabbrowser-reviewers,sessionstore-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335997\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_restore_tabless_window.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "toolkit/content/globalOverlay.js"], "git_node": "7d21ff54b26fc0c3a6297a2551c0e54e86546d32", "git_parents": ["498f71dc1c8d88217514b930c721585995d7bca4"], "node": "95e33e778b8ae303d37dbc857ed793299cd7eab5", "parents": ["86bab140100885e218181c6f2ba048ad4f6bf1f7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088405 - Don't crash on WorkManager's direct boot initialization error. r=android-reviewers,mcarare\n\nWorkManager 2.12.0 throws from ForceStopRunnable as soon as UserManagerCompat.isUserUnlocked() returns false.\nOn some devices (mostly EMUI 8.1) that happens while credential encrypted storage is accessible, where 2.11\nran its startup cleanup normally. With the handler, WorkManager skips that cleanup for the affected start\ninstead of crashing, and runs it on the next start that sees the user unlocked. Other initialization failures\nstill crash as before.\n\nRevisit once a WorkManager release resolves https://issuetracker.google.com/issues/578572401.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339525\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/FenixApplicationTest.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/FocusApplication.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/FocusApplicationTest.kt"], "git_node": "55c6e5375e0402e4696a63dd7936e045925ae4e2", "git_parents": ["7d21ff54b26fc0c3a6297a2551c0e54e86546d32"], "node": "69f825475434556378588cba0ba69392e4bd3dbb", "parents": ["95e33e778b8ae303d37dbc857ed793299cd7eab5"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077468 - Disable semantic history in browser_security_get_open_tabs.js r=bjohns,yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335176\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_security_get_open_tabs.js"], "git_node": "97e9c3f71f7512fb61aecc0c80a1eadb9e531fa6", "git_parents": ["55c6e5375e0402e4696a63dd7936e045925ae4e2"], "node": "5820b63182ff4202108b37ce465f058e39ba09d5", "parents": ["69f825475434556378588cba0ba69392e4bd3dbb"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077468 - Part 1: Move get_open_tabs test helper to head r=bjohns,czhou\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332163\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_security_get_open_tabs.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "cf03f3b526f01b662e61d5a014bea445c494512b", "git_parents": ["97e9c3f71f7512fb61aecc0c80a1eadb9e531fa6"], "node": "26411bcee7fc7f043d784d70857f06fb19c8a1ea", "parents": ["5820b63182ff4202108b37ce465f058e39ba09d5"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077468 - Part 2: Show a fullpage chat tab unchecked instead of grouping it by default. r=czhou,bjohns\n\nThe chat tab was added to every tab group made from a fullpage chat, even when only other tabs were requested. The confirmation card now offers it unticked, and without a card it is left out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332164\n", "files": ["browser/components/aiwindow/models/ManageTabs.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_ManageTabs.js", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_fullpage_chat.js"], "git_node": "99c6b0c294fafb6d6fb75c65cc3aa7185166bf01", "git_parents": ["cf03f3b526f01b662e61d5a014bea445c494512b"], "node": "099fcb87371deee023b80fc8cfb6001a34b0f221", "parents": ["26411bcee7fc7f043d784d70857f06fb19c8a1ea"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076176 - Let the assistant reply when manage_tabs fails r=bjohns,czhou\n\nA manage_tabs call always ended the current chat turn. Without a confirmation or result card a user receives no feedback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332165\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_chat_tool_calls.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_fullpage_chat.js"], "git_node": "f80cd0d9a75469a61a29b7e1d8b5372f8408ed70", "git_parents": ["99c6b0c294fafb6d6fb75c65cc3aa7185166bf01"], "node": "dd216d82a4a78c2f2e6eff509049405fa2fc3542", "parents": ["099fcb87371deee023b80fc8cfb6001a34b0f221"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077468 - Part 3: Let the model include fullpage chat tabs in a tab group r=bjohns,ai-security-reviewers,czhou\n\nAdds an include_chat_tab option to manage_tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332830\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/ManageTabs.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_ManageTabs.js", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_fullpage_chat.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_tool.js"], "git_node": "a1c5b1ddb642dcef5c8ebc0f3dfa81227f0b704b", "git_parents": ["f80cd0d9a75469a61a29b7e1d8b5372f8408ed70"], "node": "20f676fd5b8c4fc5568a894da7ec756176f9466d", "parents": ["dd216d82a4a78c2f2e6eff509049405fa2fc3542"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078565 - Allow grouping pinned and grouped tabs r=bjohns,omarg\n\nThe confirmation card offered pinned and grouped tabs that were rejected and silently failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333278\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/ManageTabs.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_ManageTabs.js", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_fullpage_chat.js", "browser/components/aiwindow/ui/test/xpcshell/test_TabManagementService.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolUI.js"], "git_node": "017c2574ad0f69cc80ed2bf0817a4eb2f51373a9", "git_parents": ["a1c5b1ddb642dcef5c8ebc0f3dfa81227f0b704b"], "node": "de1390df3e6e03dcde6682db277a1f9e602246f7", "parents": ["20f676fd5b8c4fc5568a894da7ec756176f9466d"], "tags": []}, {"author": "Ulrich Sp\u00f6rlein \u003cuspoerlein@gmail.com\u003e", "branch": "default", "desc": "Bug 2081992 - Use Services.io instead of nsINetworkLinkService in SyncedTabsErrorHandler. r=fxview-reviewers,jsudiaman\n\nnsINetworkLinkService is only implemented on some platforms (Windows,\nmacOS, Linux, Android), so on e.g. FreeBSD the contract does not exist\nand loading the module errors out like so:\n\nUncaught TypeError: can't access property \"getService\", Cc[aContract] is undefined\n    defineLazyServiceGetter resource://gre/modules/XPCOMUtils.sys.mjs:125\n    init resource:///modules/firefox-view-synced-tabs-error-handler.sys.mjs:48\n    \u003canonymous\u003e resource:///modules/firefox-view-synced-tabs-error-handler.sys.mjs:242\n    \u003canonymous\u003e chrome://browser/content/sidebar/sidebar-syncedtabs.mjs:26\n    SyncedTabsInSidebar chrome://browser/content/sidebar/sidebar-syncedtabs.mjs:35\n    \u003canonymous\u003e chrome://browser/content/sidebar/sidebar-syncedtabs.mjs:476\n\nleaving the synced tabs sidebar and Firefox View blank.\n\nDetermine the initial network state from Services.io.connectivity and\nServices.io.offline instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339080\n", "files": ["browser/components/firefoxview/firefox-view-synced-tabs-error-handler.sys.mjs"], "git_node": "9cb906b8fc3c775f2e2226a1605b688392151e6a", "git_parents": ["017c2574ad0f69cc80ed2bf0817a4eb2f51373a9"], "node": "ccd5aacb52c94137af36c2c0c07b270b1a952d91", "parents": ["de1390df3e6e03dcde6682db277a1f9e602246f7"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088169 - Settle promise in error cases in FetchCompleteRunnable::RunOnWorkletThread; r=allstarschh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339198\n", "files": ["dom/worklet/WorkletFetchHandler.cpp"], "git_node": "2b2632018ce61e6dd2fe822d62075e4921337250", "git_parents": ["9cb906b8fc3c775f2e2226a1605b688392151e6a"], "node": "ebaaab4aa6accc185650ec2ffe2af83adcbe6b04", "parents": ["ccd5aacb52c94137af36c2c0c07b270b1a952d91"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 1700396: Bump Updatebot r=firefox-build-system-reviewers,sylvestre\n\nThis includes:\n- Fail fast, and say why, when arc diff refuses a diff that's too large\n- Remove the separate-platforms (two-platform) try runs\n- Explain on the bug, rather than failing, when try is closed\n- Retry connecting to MySQL for a while instead of failing the run\n- Add vendoring tests that run real Mercurial operations\n- Detect spurious updates for libraries with patches, and commit files our patches add or delete\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339509\n", "files": ["taskcluster/docker/updatebot/updatebot-version.sh"], "git_node": "db24d5cc3efa37955ca96b74654fa761390791e2", "git_parents": ["2b2632018ce61e6dd2fe822d62075e4921337250"], "node": "f6f124369765c9ffc6a97a72f8fb0ffd363d2eb6", "parents": ["ebaaab4aa6accc185650ec2ffe2af83adcbe6b04"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1820471 - Log Remote Settings reads interrupted by shutdown as debug r=gbeckley,remote-settings-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339495\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs"], "git_node": "77a024e5701e86f92c9c8b66f2c120e2a9b8b425", "git_parents": ["db24d5cc3efa37955ca96b74654fa761390791e2"], "node": "d2c1f3512edd89419a1dff6675b872b692fab624", "parents": ["f6f124369765c9ffc6a97a72f8fb0ffd363d2eb6"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083571 - pt5. Annotate indirect targets in JIT trampolines/stubs and RegExp compilation r=jandem,iain\" for causing fenix failures @SwitchTabsBaselineProfileGenerator.\n\nThis reverts commit 892657fc6176059859e30c4a507d60f5657ccb0a.\n\nRevert \"Bug 2083571 - pt4. Annotate indirect targets in Ion/IonICs r=iain,jandem\"\n\nThis reverts commit 62a288e4a78164a651501d0d5455a333973b4db2.\n\nRevert \"Bug 2083571 - pt3. Annotate indirect targets for BaselineDebugModeOSR resume points r=iain,jandem\"\n\nThis reverts commit 8540a8081f21208d2a592a07b9314591ca2b700b.\n\nRevert \"Bug 2083571 - pt2. Annotate indirect targets in Baseline JIT, Interpreter and ICs r=jandem,iain\"\n\nThis reverts commit 646c43292ae88a97279fa098afa71e822dc99a74.\n\nRevert \"Bug 2083571 - pt1. Introduce MASM ops to make indirect targets explicit r=jandem,iain\"\n\nThis reverts commit bf95836597e5874fd3370fe4022a4bebadfae1f2.\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h", "js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineCompileTask.h", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineIC.cpp", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h", "js/src/jit/CodeGenerator.cpp", "js/src/jit/InterpreterEntryTrampoline.cpp", "js/src/jit/Ion.cpp", "js/src/jit/IonCacheIRCompiler.cpp", "js/src/jit/JitRuntime.h", "js/src/jit/LIR.cpp", "js/src/jit/LIR.h", "js/src/jit/Lowering.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/Trampoline.cpp", "js/src/jit/TrampolineNatives.cpp", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/Trampoline-arm64.cpp", "js/src/jit/none/MacroAssembler-none.h", "js/src/jit/shared/Assembler-shared.h", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/CodeGenerator-shared.h", "js/src/jit/wasm32/MacroAssembler-wasm32.h", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x64/Trampoline-x64.cpp"], "git_node": "747ca4deb7f587111f9be583bd638e20b4847044", "git_parents": ["77a024e5701e86f92c9c8b66f2c120e2a9b8b425"], "node": "f6d2b1483f98f6ea06ecc23213979199a8102bd0", "parents": ["d2c1f3512edd89419a1dff6675b872b692fab624"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996168 - Use logical properties for spacing/positioning r=mtigley,credential-management-r