toml", "supply-chain/config.toml", "supply-chain/imports.lock", "third_party/rust/icu_collator/Cargo.toml", "third_party/rust/icu_collator/src/comparison.rs", "third_party/rust/icu_collator/src/elements.rs", "third_party/rust/icu_collections/Cargo.toml", "third_party/rust/icu_collections/src/codepointtrie/cptrie.rs", "third_party/rust/icu_collections/src/codepointtrie/error.rs", "third_party/rust/icu_collections/src/codepointtrie/iter.rs", "third_party/rust/icu_collections/src/codepointtrie/mod.rs", "third_party/rust/icu_collections/src/codepointtrie/serde.rs", "third_party/rust/icu_normalizer/Cargo.toml", "third_party/rust/icu_normalizer/src/lib.rs", "third_party/rust/icu_normalizer/src/properties.rs", "third_party/rust/icu_normalizer/src/uts46.rs", "third_party/rust/utf16_iter/.cargo-checksum.json", "third_party/rust/utf16_iter/.cargo_vcs_info.json", "third_party/rust/utf16_iter/Cargo.lock", "third_party/rust/utf16_iter/Cargo.toml", "third_party/rust/utf16_iter/Cargo.toml.orig", "third_party/rust/utf16_iter/README.md", "third_party/rust/utf16_iter/src/basic.rs", "third_party/rust/utf16_iter/src/cptrie.rs", "third_party/rust/utf16_iter/src/cptrie_indices.rs", "third_party/rust/utf16_iter/src/handler.rs", "third_party/rust/utf16_iter/src/indices.rs", "third_party/rust/utf16_iter/src/lib.rs", "third_party/rust/utf16_iter/src/macros.rs", "third_party/rust/utf16_iter/src/report.rs", "third_party/rust/utf8_iter/.cargo-checksum.json", "third_party/rust/utf8_iter/.cargo_vcs_info.json", "third_party/rust/utf8_iter/Cargo.lock", "third_party/rust/utf8_iter/Cargo.toml", "third_party/rust/utf8_iter/Cargo.toml.orig", "third_party/rust/utf8_iter/README.md", "third_party/rust/utf8_iter/src/basic.rs", "third_party/rust/utf8_iter/src/cptrie.rs", "third_party/rust/utf8_iter/src/cptrie_indices.rs", "third_party/rust/utf8_iter/src/handler.rs", "third_party/rust/utf8_iter/src/indices.rs", "third_party/rust/utf8_iter/src/lib.rs", "third_party/rust/utf8_iter/src/macros.rs", "third_party/rust/utf8_iter/src/report.rs", "third_party/rust/utf8_iter/src/str.rs", "third_party/rust/utf_types/.cargo-checksum.json", "third_party/rust/utf_types/.cargo_vcs_info.json", "third_party/rust/utf_types/CONTRIBUTING.md", "third_party/rust/utf_types/COPYRIGHT", "third_party/rust/utf_types/Cargo.lock", "third_party/rust/utf_types/Cargo.toml", "third_party/rust/utf_types/Cargo.toml.orig", "third_party/rust/utf_types/LICENSE-APACHE", "third_party/rust/utf_types/LICENSE-MIT", "third_party/rust/utf_types/README.md", "third_party/rust/utf_types/src/lib.rs", "third_party/rust/utf_types/src/utf16.rs", "third_party/rust/utf_types/src/utf8.rs"], "git_node": "605b0ba99c99a686138b5f4e846107ec62b59725", "git_parents": ["d15a1fdb3b2e007d4fb003ce4829a52d384c9537"], "node": "90bddef92aa9c2f444fb09bce6902cf9b0c1b728", "parents": ["6595f73b10c098c02600be6168f338103713fafa"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2087955 - Pass parameters to deprecation reports for warnings. r=dom-core-reviewers,vhilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338645\n", "files": ["dom/base/Document.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/reporting/tests/mochitest.toml", "dom/reporting/tests/test_deprecated_params.html"], "git_node": "ec55f888786690c923ccdd1b0da4e83fc3847470", "git_parents": ["605b0ba99c99a686138b5f4e846107ec62b59725"], "node": "06de5bd42102662735293aa7479dd11bd3e7bbe8", "parents": ["90bddef92aa9c2f444fb09bce6902cf9b0c1b728"], "tags": []}, {"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2087310: Check all prefs in `Instance::RequestAdapter`. r=webgpu-reviewers,teoxoy\n\nIn `mozilla::webgpu::Instance::RequestAdapter`, check not only the\n`dom.webgpu.enabled` preference, but also the\n`dom.webgpu.service-workers-enabled` pref if appropriate.\n\nIntroduce a helper function, `Instance::DisabledByPrefWithExplanation`, to\nconsolidate the decision process.\n\nIn `AllocPWebGPUParent`, note that we don't need to check\n`dom.webgpu.service-workers-enabled` at this point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338372\n", "files": ["dom/webgpu/Instance.cpp", "dom/webgpu/Instance.h", "gfx/ipc/CanvasManagerParent.cpp"], "git_node": "3fb0b8c145c82a9b770127b55f182b331e161cd1", "git_parents": ["ec55f888786690c923ccdd1b0da4e83fc3847470"], "node": "047bc96a5554a4d8fff4dda931213c66c35937ac", "parents": ["06de5bd42102662735293aa7479dd11bd3e7bbe8"], "tags": []}, {"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2087311: Consolidate WebGPU checks behind `AllowWebGPU`. r=webgpu-reviewers,teoxoy\n\nWebGPU is only available on 64-bit builds, and on Windows, only when DXC is\navailable. Move the checks for these conditions from `Instance::RequestAdapter`\ninto `gfxPlatform::InitWebGPUConfig`, and use them to enable or disable\n`Feature::WEBGPU`, which is used to set `gfxVars::AllowWebGPU`. This ensures that:\n\n- the checks are performed in the GPU process, not just the content process;\n\n- `gfxVars::AllowWebGPU` and `Instance::RequestAdapter` are using the same\n  criteria; and\n\n- an explanation of the decision appears in `about:support`.\n\nIn `Instance::RequestAdapter`, correct the error message not to claim that\nWebGPU is disabled by blocklist whenever `AllowWebGPU` returns false. There were\nalways other reasons this might occur. Instead, refer the user to\n`about:support`, where the full decision log is recorded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338432\n", "files": ["dom/webgpu/Instance.cpp", "gfx/thebes/gfxPlatform.cpp"], "git_node": "6abea445e825dcb2e1565785f2a97bdfaa6063eb", "git_parents": ["3fb0b8c145c82a9b770127b55f182b331e161cd1"], "node": "075c69d00f7109df71f3b50a8520b6afde45d2e1", "parents": ["047bc96a5554a4d8fff4dda931213c66c35937ac"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2084182 - Add compat info from docs prose into schema r=mkaply DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335642\n", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": "d18152b0faea413aa2fdbda6211a6c380a72f7dc", "git_parents": ["6abea445e825dcb2e1565785f2a97bdfaa6063eb"], "node": "f9c5999e262af32a3a1c5707ab36a4c740935679", "parents": ["075c69d00f7109df71f3b50a8520b6afde45d2e1"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2084182 - Add compat info for DisabledCiphers members. r=mkaply DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335643\n", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": "22e9d3aba3547e1390ec2bacac10f7d67b19e8bb", "git_parents": ["d18152b0faea413aa2fdbda6211a6c380a72f7dc"], "node": "2b135a7893a180f11aac0bd925fc7495757f35c2", "parents": ["f9c5999e262af32a3a1c5707ab36a4c740935679"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087766 - Move the setting of the text-autospace-size pref up so it covers both the parsing and rendering tests. r=layout-reviewers,emilio\n\nAlso clean up references to the older text-autospace pref, which is enabled by default\non all channels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338516\n", "files": ["testing/web-platform/meta/css/css-text/__dir__.ini", "testing/web-platform/meta/css/css-text/parsing/text-autospace-computed.html.ini", "testing/web-platform/meta/css/css-text/parsing/text-autospace-invalid.html.ini", "testing/web-platform/meta/css/css-text/parsing/text-autospace-valid.html.ini", "testing/web-platform/meta/css/css-text/text-autospace/__dir__.ini"], "git_node": "7a03288c5d771ad205095ad56e4d289cf8165f74", "git_parents": ["22e9d3aba3547e1390ec2bacac10f7d67b19e8bb"], "node": "820bed49db791ba59b5aac269482d260a114c384", "parents": ["2b135a7893a180f11aac0bd925fc7495757f35c2"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1709948 - Adjust geckoview-isolated-process mochitest scheduling and tiers. r=geckoview-reviewers,m_kato\n\nRemove `geckoview-isolated-process` variant tier overrides so they have\nthe default tier.\n\nRun `geckoview-isolated-process` variant for `mochitest-plain-gpu` suite\non `built-projects` for `android-em.*/debug`, matching other suites.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338047\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "be47ffa3b3553dfaf318fd49228e1ec303552caa", "git_parents": ["7a03288c5d771ad205095ad56e4d289cf8165f74"], "node": "8e9866242815ebbe005ddd2dd7cdcb16b61891c8", "parents": ["820bed49db791ba59b5aac269482d260a114c384"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087111 - Add partner code per-SAP handling to URIFixup. r=search-reviewers,firefox-desktop-core-reviewers ,scunnane,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338010\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_keyword_fixup.js", "docshell/base/URIFixup.sys.mjs", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsIURIFixup.idl", "docshell/test/browser/browser_search_notification.js"], "git_node": "c456c07567b74194f62bfabc6676457737d0b650", "git_parents": ["be47ffa3b3553dfaf318fd49228e1ec303552caa"], "node": "e876880d9903247a926f7fabd0027d63ca2e1235", "parents": ["8e9866242815ebbe005ddd2dd7cdcb16b61891c8"], "tags": []}], "date": 1793638010, "git_changesets": ["970e600f7929d597f7301b2d123aaf4a9e08d7ff", "d77a26e6b6bd84589bb