ff3b300c151f45f09f300284659f24f5d95b0f25"], "node": "9f6fdf825d45e015ee645837c47c94e203b9b3ef", "parents": ["d9007e19b8a4c031f4b413e0273e3a157bec3bbd"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033485 - Update vertical tabs pin tabs promo for Nova. r=fluent-reviewers,desktop-theme-reviewers,sidebar-reviewers,tgiles,bolsson,tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334333\n", "files": ["browser/components/sidebar/sidebar-pins-promo.css", "browser/components/sidebar/sidebar-pins-promo.mjs", "browser/components/sidebar/tests/browser/browser_sidebar_pinned_tab_promo.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_to_pin.js", "browser/locales/en-US/browser/sidebar.ftl", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/sidebar/kit-pinned-tabs-promo.svg", "python/l10n/fluent_migrations/bug_2033485_sidebar_pins_promo_heading_nova.py"], "git_node": "d6bbcc57b778f985faf1f6cf9945c2bcb16c63d1", "git_parents": ["74cf16c3e770ab326787667fb5017955b9bbb618"], "node": "848c0dfa28d21eee6a3b38d64e08eb668f5f0f25", "parents": ["9f6fdf825d45e015ee645837c47c94e203b9b3ef"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084245 - Shorten the fire button's label so it fits in the Customize palette. r=fluent-reviewers,bolsson\n\n\"Delete some or all of your browsing data\" wrapped to three lines in the palette. The label is now \"Delete some or all data\", which fits on two lines. The tooltip keeps the full text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336937\n", "files": ["browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/locales/en-US/browser/browser.ftl"], "git_node": "825419279961afeda2ed7cdeaf29d6e7876b4873", "git_parents": ["d6bbcc57b778f985faf1f6cf9945c2bcb16c63d1"], "node": "7179fd760b8b5777cc4e6890248f80ae096272c0", "parents": ["848c0dfa28d21eee6a3b38d64e08eb668f5f0f25"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082773 - Quota manager: add a test for bug 2065499. r=dom-storage-reviewers,jari\n\nWe fake an underflow (bug 1585978) and test that this doesn't trigger storage pressure nor break storage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334433\n", "files": ["dom/quota/test/xpcshell/common/head.js", "dom/quota/test/xpcshell/test_underflowStoragePressure.js", "dom/quota/test/xpcshell/test_underflowedCacheRescan.js", "dom/quota/test/xpcshell/xpcshell.toml"], "git_node": "f4d41414e3b273aba79a6fb78ef1700abd313da0", "git_parents": ["825419279961afeda2ed7cdeaf29d6e7876b4873"], "node": "1aad723b31f870ebe2e0171d9354d4609b53fcc5", "parents": ["7179fd760b8b5777cc4e6890248f80ae096272c0"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2086062 - Make SVGContextPaint refcounting threadsafe r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337102\n", "files": ["layout/svg/SVGContextPaint.h"], "git_node": "409a149b1a6b552a335399ebdab74ed323cfe5eb", "git_parents": ["f4d41414e3b273aba79a6fb78ef1700abd313da0"], "node": "15c0a851f5def0739a5f5ff3e301e7a261ce2a6b", "parents": ["1aad723b31f870ebe2e0171d9354d4609b53fcc5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2086185 - Allow non-native reflow observers to run script. r=TYLin,layout-reviewers\n\nThe blocker was added for AccessibleCaret, but that doesn't need to be a\nreflow observer.\n\nThe other native reflow observer (IMEContentObserver) doesn't need the\nblocker, it just schedules async work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337206\n", "files": ["layout/base/AccessibleCaretEventHub.cpp", "layout/base/AccessibleCaretEventHub.h", "layout/base/AccessibleCaretManager.h", "layout/base/PresShell.cpp"], "git_node": "47ab9b4d737c35dc639db4df9f463b7f716f61a3", "git_parents": ["409a149b1a6b552a335399ebdab74ed323cfe5eb"], "node": "4b5faad3a135bb84c36251df2673fdb43d5b158e", "parents": ["15c0a851f5def0739a5f5ff3e301e7a261ce2a6b"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079392 - Rename MicroTaskEntry to PromiseJobObject and ThenableJob to ThenableJobObject r=spidermonkey-reviewers,yulia\n\nMechanical rename. These are the JSObject-backed promise jobs; naming them\n*Object distinguishes them from jobs held inline in a JS::MicroTask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336226\n", "files": ["js/src/builtin/Promise.cpp", "js/src/vm/JSContext.h"], "git_node": "8c6dae23625fbef2f3d2380bc5d560398a552de5", "git_parents": ["47ab9b4d737c35dc639db4df9f463b7f716f61a3"], "node": "385cd0aef594ae09024e63f1feebf4a62ab6e82c", "parents": ["4b5faad3a135bb84c36251df2673fdb43d5b158e"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079392 - Rename the PromiseReaction microtask kind to PromiseReactionObject r=spidermonkey-reviewers,yulia\n\nMechanical rename. The job for this kind is a PromiseReactionRecord object,\nas opposed to a reaction held inline in the JS::MicroTask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336227\n", "files": ["js/src/builtin/Promise.cpp", "js/src/vm/JSContext.h"], "git_node": "4c113413b2431ab034e0cc757f0d8d2d1416a274", "git_parents": ["8c6dae23625fbef2f3d2380bc5d560398a552de5"], "node": "a940ba589606191a14bbf341085cf37922cae71b", "parents": ["385cd0aef594ae09024e63f1feebf4a62ab6e82c"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079392 - Move ReactionRecord allocation into dedicated helper r=spidermonkey-reviewers,jonco\n\nThis is a setup patch to centralize the allocation of the PromiseReactionRecord, which we\nare going to elide under some circumstances shortly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331701\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "94e72707c96ab9b45151a5296fcfebfa6250c9e2", "git_parents": ["4c113413b2431ab034e0cc757f0d8d2d1416a274"], "node": "061519822d92729f6c5ff38c974b3dd26b52ce12", "parents": ["a940ba589606191a14bbf341085cf37922cae71b"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079392 - Separate Promise Reaction Storage from Interface r=spidermonkey-reviewers,jonco\n\nRefactoring to support multiple representations\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331702\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "f57e5476ea7b06c807b918aafadd7fbcd89fa5cb", "git_parents": ["94e72707c96ab9b45151a5296fcfebfa6250c9e2"], "node": "9baf61f00ff05ce07fb41ad5ae00c754ae16e9fb", "parents": ["061519822d92729f6c5ff38c974b3dd26b52ce12"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079392 - Use RootedTuple for host defined data in NewReactionRecord r=spidermonkey-reviewers,jonco\n\n(this is a total drive-by, it just irked me when I saw it )\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331704\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "42f9d6f6deb6be0647ac818a1342b3d800bb6649", "git_parents": ["f57e5476ea7b06c807b918aafadd7fbcd89fa5cb"], "node": "01317b51427996a7aa5b7bc5e9a5b3aa7a1a9539", "parents": ["9baf61f00ff05ce07fb41ad5ae00c754ae16e9fb"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079392 - Support settled promise reaction without object allocation r=spidermonkey-reviewers,jonco\n\nBy adding room to MicroTask we can enqueue simple promise reactions without needing to allocate\na PromiseReactionRecords.\n\nReactions which can't be transparently represented as MicroTask values are instead converted to\nPromiseReactionRecords, which go through the normal path.\n\nLocal measurements get about 5% win on doxbee-promise, and about 25% on doxbee-async.\n\nNote: Profiler flow markers for reactions held by value are only emitted when the\nprofiler is enabled at the time the reaction is enqueued; otherwise the task\nhas no flow id and JSMicroTaskRef::getFlowId returns false. This is justifiable because\nflow markers are not the default (nor are they super widely used yet)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331705\n", "files": ["js/public/friend/MicroTask.h", "js/src/builtin/Promise.cpp", "js/src/jsapi-tests/testMicroTask.cpp", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h", "xpcom/base/CycleCollectedJSContext.cpp"], "git_node": "cb3f9dbf4d1293b58ea377688e48a0484d78ac38", "git_parents": ["42f9d6f6deb6be0647ac818a1342b3d800bb6649"], "node": "0ac017db3b927bdcac43bab794ad491588dcb670", "parents": ["01317b51427996a7aa5b7bc5e9a5b3aa7a1a9539"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2077716 - Don't hide panel-list on resize events bubbling up from in-process subframes, r=reusable-components-reviewers,mkennedy.\n\nA page settling its size while a panel-list in a XUL panel was opening hid it before popupshown, timing out browser_policy_search_engine.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336674\n", "files": ["toolkit/content/tests/browser/browser.toml", "toolkit/content/tests/browser/browser_panel_list_subframe_resize.js", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "2ef7a956c8b6de978fa07a367b7392f5c8a777d7", "git_parents": ["cb3f9dbf4d1293b58ea377688e48a0484d78ac38"], "node": "33d5c36c53bbb527866e1d8d05df9a9c5d58f61a", "parents": ["0ac017db3b927bdcac43bab794ad491588dcb670"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2083859 - Don't keep a closed about:preferences window alive while its tracker count query is pending, r=settings-reviewers,mkennedy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336675\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/components/protections/PrivacyMetricsService.sys.mjs", "browser/components/protections/test/xpcshell/test_PrivacyMetricsService.js"], "git_node": "a04a7da9af376cd019b942d41ffb1d1f40f2a1c3", "git_parents": ["2ef7a956c8b6de978fa07a367b7392f5c8a777d7"], "node": "8fe7a0fe33d666bbec6e0b4f9143b6cbaf69880c", "parents": ["33d5c36c53bbb527866e1d8d05df9a9c5d58f61a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082033 - Don't fire events sync for pending load triggers. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336732\n", "files": ["layout/style/Loader.cpp", "layout/style/Loader.h", "layout/style/SharedStyleSheetCache.cpp", "layout/style/SharedStyleSheetCache.h", "layout/style/SheetLoadData.h", "layout/style/StreamLoader.cpp"], "git_node": "fe230632b5851fd9900434e068a0994cb869a99a", "git_parents": ["a04a7da9af376cd019b942d41ffb1d1f40f2a1c3"], "node": "45465847b033773506128240995715ea4041e6c8", "parents": ["8fe7a0fe33d666bbec6e0b4f9143b6cbaf69880c"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086094 - The add-on infobar is displayed while on youtube when VPN is off and another site has an inclusion rule - r=ip-protection-reviewers,baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337135\n", "files": ["browser/extensions/ipp-activator/README.md", "browser/extensions/ipp-activator/extension/api/parent/ext-ipp.js", "browser/extensions/ipp-activator/extension/api/schemas/ipp.json", "browser/extensions/ipp-activator/extension/conditions/vpn.js", "browser/extensions/ipp-activator/manifest.json", "browser/extensions/ipp-activator/tests/browser/browser_conditions_vpn.js"], "git_node": "1c2fdfccf0410018ef38eded32af9db3f3cb748e", "git_parents": ["fe230632b5851fd9900434e068a0994cb869a99a"], "node": "02d7c666ed71210b5ddfa78336cfb361a671435e", "parents": ["45465847b033773506128240995715ea4041e6c8"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2086092 - Test the tag of a Value in memory through its upper word on arm64. r=iain\n\nThe Address forms of the tag tests loaded the whole Value and extracted\nthe sign-extended tag with an asr before the cmn. The upper 32 bits of a\nValue are the tag shifted left by 15, so for the types whose payload fits\nin 32 bits (int32, boolean, null, undefined, magic) and for the number,\ndouble and GC thing range tests a 32-bit load of the upper word compares\ndirectly: the negated upper word is a multiple of 1 \u003c\u003c 15 below 1 \u003c\u003c 20\nand encodes as a shifted 12-bit immediate. The pointer types keep the\nextraction because their payload reaches into the upper word.\n\nThe GC thing test of a pre-barrier on a slot was\n\n  ldr x16, [x0, #0x20]\n  asr x16, x16, #47\n  cmn w16, #5\n  b.lo skip\n\nand becomes\n\n  ldr w16, [x0, #0x24]\n  cmn w16, #0x28, lsl #12\n  b.lo skip\n\nand an int32 guard on a slot goes from\n\n  ldr x16, [x0, #0x20]\n  asr x16, x16, #47\n  cmn w16, #14\n  b.ne fail\n\nto\n\n  ldr w16, [x0, #0x24]\n  cmn w16, #0x70, lsl #12\n  b.ne fail\n\nThis is what x64 already does with a cmp32 of the upper word; the change\nis limited to the arm64 backend.\n\nIn a JetStream 3 run this removes one instruction from 73,000 tests, 52,000\nof them the GC thing test of pre-barriers and 15,000 Ion int32 guards on\nframe slots, and shortens the dependency chain before the branch.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337118\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "8fdf94fa666b8f0b34206bf160b15bfe84117434", "git_parents": ["1c2fdfccf0410018ef38eded32af9db3f3cb748e"], "node": "b3ef45d73a57426e6f2308cf3082332bb5af772a", "parents": ["02d7c666ed71210b5ddfa78336cfb361a671435e"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2086202 - Update random-computed.tentative.html WPT to fix percentage simplification cases. r=firefox-style-system-reviewers,emilio\n\nThree cases in random-computed.tentative.html, related to simplification of percentages in\n`random()`, look incorrect. When a `random()` function has arguments that can't be simplified\nat computed-value time, then its key must be replaced by `fixed \u003cnumber\u003e`.\n\n- `border-image-slice: random(10%, 30%)`\n  - Test asserts the result has the `fixed` key. However, because `border-image-slice` computes\n    percentages as `\u003cpercentage\u003e`, and not relative to a basis, percentages in the property can\n    be simplified. This `random()` should therefore simplify to `10%`.\n\n- `translate(random(30%, 10%))`\n  - Test asserts the `random()` simplifies to `30%`. But `translate()` uses `\u003clength-percentage\u003e`\n    when in a `\u003ctransform-function\u003e`, so percentages can't be simplified. This computed value\n    should have `random(fixed ..., 30%, 10%)`.\n\n- `radial-gradient(at 30% random(33%, 1%), silver random(30%, 10%, 1%), gold random(70%, 10%, 1%))`\n  - Test asserts that the first `random()` can't simplify (the gradient center) while the second\n    and third (color stop positions) can simplify. But in radial gradient syntax, all three are\n    `\u003clength-percentage\u003e` values that can't be simplified and must compute to `random(fixed ...)`.\n\nSee also: https://github.com/w3c/csswg-drafts/issues/12131 (simplification of percentages)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337249\n", "files": ["testing/web-platform/meta/css/css-values/random-computed.tentative.html.ini", "testing/web-platform/tests/css/css-values/random-computed.tentative.html"], "git_node": "31481cf5b084cf49856ac8ea211fc169d7840dbb", "git_parents": ["8fdf94fa666b8f0b34206bf160b15bfe84117434"], "node": "b3d4cb524af602230d0a0bf5937b117f91e66c8f", "parents": ["b3ef45d73a57426e6f2308cf3082332bb5af772a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2086200 - Don't include SVGImageContext.h from nsLayoutUtils.h. r=firefox-svg-reviewers,longsonr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337229\n", "files": ["accessible/base/TextAttrs.cpp", "layout/base/nsLayoutUtils.h", "layout/painting/nsCSSRenderingBorders.cpp", "layout/painting/nsImageRenderer.cpp", "layout/xul/tree/nsTreeBodyFrame.cpp"], "git_node": "5d0b2517f79af354375f273f0f3b4c6b41af82e8", "git_parents": ["31481cf5b084cf49856ac8ea211fc169d7840dbb"], "node": "dffeffdfbbd969e8a0e11abc4e9236ca00706535", "parents": ["b3d4cb524af602230d0a0bf5937b117f91e66c8f"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069045 - Connect PDF.js signature event to GeckoView r=geckoview-reviewers,owlish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324684\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PdfSignatureTest.kt", "toolkit/components/pdfjs/PdfJsOverridePrefs.js", "toolkit/components/pdfjs/content/GeckoViewPdfJsParent.sys.mjs"], "git_node": "baa91290f0f291a02c56a2546aeaf93a9f0ec14c", "git_parents": ["5d0b2517f79af354375f273f0f3b4c6b41af82e8"], "node": "97dc5203968aef62e7c7084624846a820cc43308", "parents": ["dffeffdfbbd969e8a0e11abc4e9236ca00706535"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079932 - Check actor on PDF Signature on Android r=geckoview-reviewers,owlish\n\nAdds a guard to make sure the right actor responds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332481\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PdfSignatureTest.kt", "toolkit/components/pdfjs/content/GeckoViewPdfJsParent.sys.mjs"], "git_node": "194f927159a0c199269c32eb0db237ed4aa1c1cd", "git_parents": ["baa91290f0f291a02c56a2546aeaf93a9f0ec14c"], "node": "7a39fd1555013e95089d5ea055b201c6ab614102", "parents": ["97dc5203968aef62e7c7084624846a820cc43308"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071388 - Turn on PDF Signatures for Nightly r=android-reviewers,gmalekpour,mobiletest-reviewers,jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329056\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CustomTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/PDFViewerTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/PDFViewerTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/BrowserRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/CustomTabRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/DownloadRobot.kt"], "git_node": "1e6145f049667d060c1ac5064ff674551a955608", "git_parents": ["194f927159a0c199269c32eb0db237ed4aa1c1cd"], "node": "e0ff686b08754a55c0435f886f458343b4fe9379", "parents": ["7a39fd1555013e95089d5ea055b201c6ab614102"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070190 - Add a wait state to prevent multiple add a signature requests r=android-reviewers,android-l10n-reviewers,parker,pollymce\n\nThis patch:\n* Adds an `isAddingSignature` signature state\n* Adds some gates to prevent attempts to double add a signature\n* Adds UI to indicate a loading state spinner\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336064\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/SignatureState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/ui/PdfOverlayContent.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/ui/SignatureDialog.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationGleanTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/ui/SignatureDialogTest.kt"], "git_node": "ca953e586d4a46b6b632e799feeb7090327d4fcd", "git_parents": ["1e6145f049667d060c1ac5064ff674551a955608"], "node": "03e00218262cb52758d9579892e380505a55212a", "parents": ["e0ff686b08754a55c0435f886f458343b4fe9379"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085012 - Handle focus order for bottom toolbar case r=android-reviewers,mcarare\n\nThe bottom mounted toolbar case wasn't defined in bug 2066197, the patch adds it so it has a logical focus order for this case too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336240\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt"], "git_node": "e8d520089740819c2fd957cc6d58ef09b1d0e102", "git_parents": ["ca953e586d4a46b6b632e799feeb7090327d4fcd"], "node": "2fd4e6a10feea292437ec4ac134396f24968eccd", "parents": ["03e00218262cb52758d9579892e380505a55212a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085887 - Only hold back as many frames as the stream may reorder in GMPVideoDecoder when low latency is requested. r=media-playback-reviewers,padenot\n\nOtherwise the reorder queue holds back at least four frames for H264. WebRTC\nrequests low latency, and libwebrtc senders declare that no frames are\nreordered, so they no longer see any added latency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336885\n", "files": ["dom/media/platforms/agnostic/gmp/GMPVideoDecoder.cpp", "dom/media/platforms/agnostic/gmp/GMPVideoDecoder.h"], "git_node": "b3e2399193457e8a3185118148895e9f2f87a472", "git_parents": ["e8d520089740819c2fd957cc6d58ef09b1d0e102"], "node": "dff6e441b26329a311b5846e33e03db77e811e8d", "parents": ["2fd4e6a10feea292437ec4ac134396f24968eccd"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2001164 - Keep the 2D context's buffer provider across OffscreenCanvas.transferToImageBitmap. r=gfx-reviewers,lsalzman\n\nOffscreenCanvas::TransferToImageBitmap reset the 2D context with ResetBitmap(), which frees the PersistentBufferProvider. The next snapshot or draw then had to create a new provider. For PersistentBufferProviderShared, that means a new shmem TextureClient allocated by synchronous dispatch to the ImageBridge thread (ImageBridgeChild::DispatchAllocShmemInternal), plus a synchronous IsReadLocked check on the fresh texture. This happened on every transferToImageBitmap() call.\n\nThe canvas size does not change, so call ResetBitmap(false) instead, just as ClearTarget does when the size is unchanged. The provider is kept and marked mBufferNeedsClear, so the next BorrowTarget clears it and restores clips/transforms. Already-transferred bitmaps are not affected: their snapshot comes from the borrowed DrawTarget, and TextureData::ReturnDrawTarget detaches all snapshots before the texture can be reused.\n\nExtend test_offscreencanvas_toimagebitmap.html to check that bitmaps transferred earlier keep their contents after the canvas is drawn again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336991\n", "files": ["dom/canvas/OffscreenCanvas.cpp", "dom/canvas/test/test_offscreencanvas_toimagebitmap.html"], "git_node": "ef97d0cba6f43fc2d9ce0ee3568fb61c54a57411", "git_parents": ["b3e2399193457e8a3185118148895e9f2f87a472"], "node": "d5eaef062e7e2aec7e368e2603784e842f1424a0", "parents": ["dff6e441b26329a311b5846e33e03db77e811e8d"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1868588 - [devtools] Only load stylesheet's text when they are selected in the style editor. r=devtools-reviewers,bomsy\n\nWe were fetching stylesheet's text before trying to show them in the\nleft sidebar. But I don't think we need any data based on the text\ncontent before doing this.\n\nNow, we have some place like file saving that relied on the fact\nthat the text was always fetched. They could be some others?\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324697\n", "files": ["devtools/client/styleeditor/StyleEditorUI.sys.mjs", "devtools/client/styleeditor/StyleSheetEditor.sys.mjs"], "git_node": "9a05376372bffabaabc90ccc11e20dbe2c83f660", "git_parents": ["ef97d0cba6f43fc2d9ce0ee3568fb61c54a57411"], "node": "a4bd7fd240c3953b048a21de325b00f1a33079fc", "parents": ["d5eaef062e7e2aec7e368e2603784e842f1424a0"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2084169 - [Monitor Agent] Stop tasks from running when Smart Window is blocked in AI controls. r=tetchart,yjamora,fluent-reviewers,bolsson\\\n\nBlocking Smart Window in AI controls left existing tasks running on their\nschedule, so watched page content was still sent to the model, and\nabout:smartwindowtasks still allowed creating and checking tasks.\n\nTasks are now suspended while Smart Window is blocked and resume on unblock.\nCreating and checking tasks is refused, and about:smartwindowtasks shows an\nunavailable message.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336816\n", "files": ["browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/ui/actors/SmartWindowTasksChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartWindowTasksParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_tasks_actors.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "08b8413aa1e0bafce59608b08cc7b3c37b85c927", "git_parents": ["9a05376372bffabaabc90ccc11e20dbe2c83f660"], "node": "10c4315c41845fb24e83706a3e8630715702eacc", "parents": ["a4bd7fd240c3953b048a21de325b00f1a33079fc"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052899 - Remove EARLY_BETA_OR_EARLIER from js/src r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337172\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/frontend/ParseNode.h", "js/src/jit/BacktrackingAllocator.h", "js/src/tests/jstests.py"], "git_node": "b7588bd40957ac03ffa3454e0c5b4fe2cd1214e1", "git_parents": ["08b8413aa1e0bafce59608b08cc7b3c37b85c927"], "node": "89f7e7359175e450f1ca863f216b775c391a0374", "parents": ["10c4315c41845fb24e83706a3e8630715702eacc"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081876 - Make tracker count cumulative per site. r=fluent-reviewers,desktop-theme-reviewers,urlbar-reviewers,hjones,adw,bolsson\n\nThe tracker count in the address bar, and the trust panel's blocked-tracker\ncounts and lists, now add up across the pages of a site visited in a tab,\ninstead of resetting on every navigation. A tracker blocked on several pages\nis listed once with a \"(\u00d7N)\" count of those pages.\n\nEach tab keeps the content-blocking logs of the pages visited on its current\nsite, keyed by inner window ID so pages restored from the back-forward cache\naren't counted twice. Whether the site changed is decided from the document\nthat actually loaded, so loads that never commit (downloads, stopped loads)\nand redirects through other sites don't reset the count, and a tab that\nnavigates cross-site in the background starts over when selected again.\nPages without a host, like the transient about:blank created while\nnavigating, neither count nor end the visit.\n\nThe outgoing page's log is stored when a navigation starts and when\nswitching tabs, so trackers blocked after the last content-blocking event\nare included.\n\nWhen the tracker count feature is disabled, the panel keeps showing only the\ncurrent page's counts. The trustpanel.opened event still reports whether\ntrackers were blocked on the current page.\n\nSame-site now uses SiteDataManager.getBaseDomainFromHost, so IP addresses\nand hosts without a base domain (e.g. localhost) compare by host.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329609\n", "files": ["browser/base/content/browser-siteProtections.js", "browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser-trustPanel/navigation.sjs", "browser/locales/en-US/browser/siteProtections.ftl", "browser/themes/shared/controlcenter/panel.css"], "git_node": "1cdd78167e50fcc0d538de1d35a0361f86f88174", "git_parents": ["b7588bd40957ac03ffa3454e0c5b4fe2cd1214e1"], "node": "16a318135adf2dda909e11a78b5fe3057accd4eb", "parents": ["89f7e7359175e450f1ca863f216b775c391a0374"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083821 - Moving a tab to another window shouldn't decrease or reset the count. r=urlbar-reviewers,daisuke,timhuang\n\nThe per-site tracker logs move from the window's TrustPanel to a shared\nmodule keyed by the browser's permanentKey, which follows the tab between\nwindows and outlives the window the tab was moved out of.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335263\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/TrustPanelTrackerLogs.sys.mjs", "browser/components/controlcenter/moz.build", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js"], "git_node": "41165a77b220a028594d5d50b779786e6d95bcc0", "git_parents": ["1cdd78167e50fcc0d538de1d35a0361f86f88174"], "node": "06c75df13e806a8f78f029b6f6f53e4bfc3042bb", "parents": ["16a318135adf2dda909e11a78b5fe3057accd4eb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085995: accept the older WebTransportError(init) constructor form alongside the current one, r=jib,webidl,smaug\n\nUpstream WPTs such as streams-close still construct WebTransportError with a\nsingle WebTransportErrorInit dictionary.  An object first argument is now\nread as that dictionary rather than stringified into the message.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336993\n", "files": ["dom/webidl/WebTransportError.webidl", "dom/webtransport/api/WebTransportError.cpp", "dom/webtransport/api/WebTransportError.h", "testing/web-platform/meta/webtransport/historical.https.sub.any.js.ini", "testing/web-platform/tests/webtransport/historical.https.sub.any.js"], "git_node": "7ff6e61fe6b8a0f7bd9f2272eb8f78654fe2f9b7", "git_parents": ["41165a77b220a028594d5d50b779786e6d95bcc0"], "node": "fef5db4ac23a39e9e84690019598b150ed397921", "parents": ["06c75df13e806a8f78f029b6f6f53e4bfc3042bb"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082632 - Show the IPP panel error only when on an included site or global VPN is on - r=ip-protection-reviewers,mcleinman\" for causing bc failures @browser_ipprotection_alert_manager.js.\n\nThis reverts commit 47e2fbf3ee1738d7f02a00b7c7316abe6d94edde.\n\nRevert \"Bug 2082632 - Show the IPP error alert only in windows whose tab the failed connection carries. r=ip-protection-reviewers,mcleinman\"\n\nThis reverts commit f9171295d3d013a878caffc642f67aac2cbd7952.\n\nRevert \"Bug 2082632 - Show the IPP toolbar error and inclusion state only on tabs a connection carries. r=rking,ip-protection-reviewers\"\n\nThis reverts commit c6de46d456a3af0c6e3248868a159238d10d69c7.\n", "files": ["browser/components/ipprotection/IPProtectionAlertManager.sys.mjs", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_alert_manager.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_panel.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_toolbar.js"], "git_node": "45ce2e53f20f6059f2f3a34d03bdca259f6473a9", "git_parents": ["7ff6e61fe6b8a0f7bd9f2272eb8f78654fe2f9b7"], "node": "a76b3ac967a3e9afe12b13fd5bd35ccdce36959b", "parents": ["fef5db4ac23a39e9e84690019598b150ed397921"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021150 - Add the Tab Groups button to the toolbar the first time tab groups are created. r=tabbrowser-reviewers,kcochrane\n\nAdds the button once per profile, the first time a group is created or on startup if there are saved groups. It won't add it if it's already there or the user removed it.\n\n- Follows the Home buttons pattern for adding a toolbar button dynamically: a CustomizableUI listener to catch removals, plus a pref so it only happens once\n- The logic is profile-wide rather than per window, so it lives in a new module. I considered Tabbrowser.sys.mjs, but that file's already very long and this felt self-contained. Happy to move it though if there is a preference for a different pattern!\n- It goes right after List All Tabs since that's the closest related button. If List All Tabs isn't somewhere visible, it goes just before the extensions button (referenced pattern from IP button)\n- Only groups created through the create panel (TabGroupCreateDone) count. Groups created by AI, Smart Window or extensions don't\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336224\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/customizableui/test/browser_tab_groups_button.js", "browser/components/tabbrowser/TabGroupsToolbarButton.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/moz.build", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "5be238d8209c3a494c91f195d7e7f455070a2bfd", "git_parents": ["45ce2e53f20f6059f2f3a34d03bdca259f6473a9"], "node": "d0c50fa46d5d4ddfc59995abd29be2eaaa352942", "parents": ["a76b3ac967a3e9afe12b13fd5bd35ccdce36959b"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002102: Add a configurable result limit to native macOS Places query menus. r=mak,fluent-reviewers,places-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332549\n", "files": ["browser/app/profile/firefox.js", "browser/components/places/PlacesUIUtils.sys.mjs", "browser/components/places/content/browserPlacesViews.js", "browser/components/places/tests/browser/browser.toml", "browser/components/places/tests/browser/browser_native_menu_query_limit.js", "browser/locales/en-US/browser/menubar.ftl"], "git_node": "6f77b3edb2b0aeccbb9c2c0667e4af7a40810261", "git_parents": ["5be238d8209c3a494c91f195d7e7f455070a2bfd"], "node": "ff516b4b739532e0eee64f287ba9d4268f42af3b", "parents": ["d0c50fa46d5d4ddfc59995abd29be2eaaa352942"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048790: Turn on tab groups alternateMenu in all channels r=sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335707\n", "files": ["browser/app/profile/firefox.js"], "git_node": "6db3e1bf215e472867bc2442dd46b1e5c84f0f94", "git_parents": ["6f77b3edb2b0aeccbb9c2c0667e4af7a40810261"], "node": "1b1ec6a27682a5ad894c6a2f0f71408c2df3fdd9", "parents": ["ff516b4b739532e0eee64f287ba9d4268f42af3b"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup additional preferences test that relies on SRD pref being false r=akulyk,settings-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336272\n", "files": ["browser/components/preferences/tests/permissions/browser_notifications_pane.js"], "git_node": "afe8545a2c15608e3fc098f6af418a081af0f4e1", "git_parents": ["6db3e1bf215e472867bc2442dd46b1e5c84f0f94"], "node": "a535ccb0678da69fc55b08ad70b3607c12951cea", "parents": ["1b1ec6a27682a5ad894c6a2f0f71408c2df3fdd9"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup search and urlbar tests that rely on the SRD pref being false r=urlbar-reviewers,search-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336273\n", "files": ["browser/components/search/test/browser/browser_contentSearch.js", "browser/components/search/test/browser/browser_hiddenOneOffs_diacritics.js", "browser/components/search/test/browser/browser_searchbar_openpopup.js", "browser/components/urlbar/tests/browser-search/browser_oneOffs.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/unit/test_UrlbarSearchUtils.js", "browser/components/urlbar/tests/unit/test_providerTabToSearch.js", "toolkit/components/search/tests/xpcshell/test_hideOneOffButton.js", "toolkit/components/search/tests/xpcshell/test_settings_migration_hideOneOffs.js", "toolkit/components/search/tests/xpcshell/test_telemetry_installed_engine_counts.js", "toolkit/components/search/tests/xpcshell/xpcshell.toml"], "git_node": "381bb5936e126913a9900444f81489be51097fe9", "git_parents": ["afe8545a2c15608e3fc098f6af418a081af0f4e1"], "node": "baadfe3380f2e89e095806043869cc13d1c98522", "parents": ["a535ccb0678da69fc55b08ad70b3607c12951cea"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085129 - Cleanup translations tests that rely on the SRD pref being false r=translations-reviewers,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336274\n", "files": ["browser/components/translations/tests/browser/browser.toml", "browser/components/translations/tests/browser/browser_translations_about_preferences_manage_downloaded_languages.js", "browser/components/translations/tests/browser/browser_translations_about_settings_main_page_offer_checkbox.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_a11y.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_basic.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_modify.js", "browser/components/translations/tests/browser/browser_translations_about_settings_subpage_always_translate_langs_observe.js", "browser/components/translation