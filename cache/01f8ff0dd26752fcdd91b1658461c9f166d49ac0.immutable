s/components/support/tracing/src/lib.rs", "third_party/application-services/components/support/viaduct-backend-rust/Cargo.toml", "third_party/application-services/moz.yaml", "third_party/application-services/tools/embedded-uniffi-bindgen/src/uniffi_bindgen.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "6fab544fb9f230d4be05a72a6b324c535fb6f2ea", "git_parents": ["ea2f27d751c1997293a9b1a016c7e4a5343ce3d7"], "node": "b0b6ff4f51825c1f8807498544d31b0cc7867779", "parents": ["e053f6b0c963cd67480b94c48d3a71c1dbc4caf2"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084814 - Crossword: Use the shared Powered by menu component r=nina-py\n\nCrossword built its \u201cPowered by Particle\u201d item with hardcoded English. It now uses WidgetMenuPoweredBy and a Fluent string, so the link opens in a new tab like Horoscopes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336947\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Crossword/Crossword.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Crossword.test.jsx"], "git_node": "1b8f1cb0df61738319b8cc09172dadf14f7832a1", "git_parents": ["6fab544fb9f230d4be05a72a6b324c535fb6f2ea"], "node": "26838a1705cf6239cae0fe561e57b2adc00d6a56", "parents": ["b0b6ff4f51825c1f8807498544d31b0cc7867779"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086696 - Flip browser.ipProtection.features.siteInclusions to true by default - r=ip-protection-reviewers,mcleinman\n\nExposes the site inclusions feature to Nightly users in preparation for 161 release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337665\n", "files": ["browser/app/profile/firefox.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_confirmation_hints_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_exclusion.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_keyboard_navigation.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_card.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_viewer_site_exclusion.js", "toolkit/components/ipprotection/docs/Preferences.md"], "git_node": "d3e35205ae7f2ad09b151ed6f30accd7c8725626", "git_parents": ["1b8f1cb0df61738319b8cc09172dadf14f7832a1"], "node": "c6013acaaca8c6fd17f879af0c3f41c13218a5c4", "parents": ["26838a1705cf6239cae0fe561e57b2adc00d6a56"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2084940: Slightly increase the fuzzy tolerance for WPT mix-blend-mode-rotated-clip.html. r=layout-reviewers,intermittent-reviewers,jfkthame,aryx\n\nFor some reason the fuzzy-failure 'maxDifference' metric slightly increased\nfor this test recently, for test runners that use drawSnapshot (the rendering\nbackend that we use for screenshots).\n\nThis patch is just updating the fuzzy annotation to account for that (and also\nallow for lower amounts of fuzz by using a maxDifference range).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337720\n", "files": ["testing/web-platform/meta/css/compositing/mix-blend-mode/mix-blend-mode-rotated-clip.html.ini"], "git_node": "890aef34fbd9b7be155fc3917fdd3014bbc72928", "git_parents": ["d3e35205ae7f2ad09b151ed6f30accd7c8725626"], "node": "bace0e30962e8b5759cceb9af22187d1cbe6c2e4", "parents": ["c6013acaaca8c6fd17f879af0c3f41c13218a5c4"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2084673 - Simplify mojo dead proxy handling, r=ipc-reviewers,mccr8\n\nPreviously, the mojo ports backend used a generic \"broadcast\" mechanism\nwhich was only ever used to broadcast a specific `ObserveProxy` message\nto signal a dead proxy. This specific message had special handling in\nevery place it was used within the ports code.\n\nThis makes the single use of the broadcast mechanism more explicit, by\nexplicitly limiting it to only support sending a `DeadProxy` message,\nand removing broadcast support from generic events.\n\nThis also fixes a minor bug in proxy handling where the broker process\nwould never be delivered the dead proxy notification itself, and the\nsending process would handle the dead proxy notification multiple times.\n\nChromium no longer uses this ports code upstream, so this divergence is\nnot an uplift concern. We are now the sole maintainers of this logic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337281\n", "files": ["ipc/chromium/gtest/ports_unittest.cc", "ipc/chromium/src/mojo/core/ports/event.cc", "ipc/chromium/src/mojo/core/ports/event.h", "ipc/chromium/src/mojo/core/ports/node.cc", "ipc/chromium/src/mojo/core/ports/node.h", "ipc/chromium/src/mojo/core/ports/node_delegate.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/NodeController.cpp", "ipc/glue/NodeController.h", "ipc/glue/ProtocolUtils.h", "ipc/ipdl/ipdl.py", "tools/fuzzing/ipc/IPCFuzzController.cpp"], "git_node": "f1c9c8b97e0e162b7b78d6c9d2b1aa38c29e3443", "git_parents": ["890aef34fbd9b7be155fc3917fdd3014bbc72928"], "node": "1d5b2ed5fadc3ede9cb23cfeb9c123702c1d36f8", "parents": ["bace0e30962e8b5759cceb9af22187d1cbe6c2e4"], "tags": []}, {"author": "Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e", "branch": "default", "desc": "Bug 2057265: Implement RTCEncodingOptions.keyFrame in RTCRtpSender.setParameters r=bwc,webidl,smaug\n\nAlso moves the WPT to webrtc-extensions where the feature is specified.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336853\n", "files": ["dom/media/webrtc/jsapi/RTCRtpSender.cpp", "dom/media/webrtc/jsapi/RTCRtpSender.h", "dom/media/webrtc/libwebrtcglue/MediaConduitInterface.h", "dom/media/webrtc/libwebrtcglue/VideoConduit.cpp", "dom/media/webrtc/libwebrtcglue/VideoConduit.h", "dom/webidl/RTCRtpParameters.webidl", "dom/webidl/RTCRtpSender.webidl", "media/webrtc/signaling/gtest/MockConduit.h", "testing/web-platform/meta/webrtc/RTCRtpSender-setParameters-keyFrame.html.ini", "testing/web-platform/tests/webrtc-extensions/RTCRtpSender-setParameters-keyFrame.html", "testing/web-platform/tests/webrtc/RTCRtpSender-setParameters-keyFrame.html"], "git_node": "64a0f13ed45a7d31d1d6e0e109d50170869531f5", "git_parents": ["f1c9c8b97e0e162b7b78d6c9d2b1aa38c29e3443"], "node": "5e9db947677a5b3f7354e99540e594e13805e490", "parents": ["1d5b2ed5fadc3ede9cb23cfeb9c123702c1d36f8"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/browser/menu/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/feature/app-links/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/feature/findinpage/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/feature/fxsuggest/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/feature/importer/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/feature/listentopag