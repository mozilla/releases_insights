69ce30a", "parents": ["816bc0ccb9b95c71461068d62c4ee1b9d10847bf"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087595 - Add a stub Wrexham AFC widget to New Tab. r=fchasen,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338387\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_wrexhamafc_widget.js", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/locales-preview/newtabPreview.ftl"], "git_node": "a046879d4ab4827229e5565c9762485b2c748c71", "git_parents": ["48ea38c98827cf505c43d528094e689d961a9b7f"], "node": "7d0da189bc18e6da1b8372c4cbfdef688a9944e2", "parents": ["c34fe0f3b5967846b8c929da54f5fcbc569ce30a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086554 - Don't let the \"in\" transition reset clobber an \"out\" transition in MultiStageAboutWelcome, r=omc-reviewers,jprickett.\n\nA navigation right after a screen appears could advance twice, skipping a\nscreen. Because the advance timer checks a stale closure index, an extra\npending advance could also move past the last screen, leaving an empty page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337544\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/MultiStageAboutWelcome.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAboutWelcome.test.jsx"], "git_node": "452b00ccc5ad571e8b0732160be7c9fc1a6956d3", "git_parents": ["a046879d4ab4827229e5565c9762485b2c748c71"], "node": "f395d416738951a886beb01aace0683e8e579c84", "parents": ["7d0da189bc18e6da1b8372c4cbfdef688a9944e2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2012723 - Don't wait for the transient intro screen in browser_aiwindow_firstrun.js and re-enable it on debug standalone, r=Mardak.\n\nThe intro screen auto-advances, so a spawn starting after it left waited forever.\nThe welcome-screen test, which checks the intro itself, uses the default\nauto-advance so the intro stays long enough to be seen.\nOn debug builds the failures were the screen skipping fixed in bug 2086554.\nBug 2025711 is a sidebar leak; debug standalone runs of this test pass leakcheck.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337545\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_firstrun.js"], "git_node": "9317a9978b7f0bca0bb9fd4c5961e0d971a88acd", "git_parents": ["452b00ccc5ad571e8b0732160be7c9fc1a6956d3"], "node": "efb9831ee17f337256b36c5744bf453c78adab97", "parents": ["f395d416738951a886beb01aace0683e8e579c84"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087132 - Temporarily add instrumentation from onboarding experiments to the 'events' ping r=jlockhart,extension-reviewers,tabbrowser-reviewers,sidebar-reviewers,jsudiaman,hsohaney,omarg,search-reviewers,daleharvey,rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338045\n", "files": ["browser/components/backup/metrics.yaml", "browser/components/genai/metrics.yaml", "browser/components/metrics.yaml", "browser/components/search/metrics.yaml", "browser/components/sidebar/metrics.yaml", "browser/components/tabbrowser/metrics.yaml", "browser/components/taskbartabs/metrics.yaml", "security/certverifier/metrics.yaml", "services/fxaccounts/metrics.yaml", "toolkit/components/pdfjs/metrics.yaml", "toolkit/components/processtools/metrics.yaml", "toolkit/components/telemetry/metrics.yaml", "toolkit/mozapps/extensions/metrics.yaml"], "git_node": "1038e9395cca4ed80a03e67b39e719a783815040", "git_parents": ["9317a9978b7f0bca0bb9fd4c5961e0d971a88acd"], "node": "b1bee0b330dd825493d0fbdf2b81fe02571cf854", "parents": ["efb9831ee17f337256b36c5744bf453c78adab97"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086741 - [Research Agent][FE] Add a reusable clarifying question card for Smart Window AI flows r=yjamora,fluent-reviewers,desktop-theme-reviewers,reusable-components-reviewers,bolsson,mstriemer\" for causing lint failures in ai-clarifying-question.mjs\n\nThis reverts commit 7e7be4380c6f559333285842f63b562fc72ebb49.\n", "files": ["browser/components/aiwindow/ui/components/ai-clarifying-question/ai-clarifying-question.css", "browser/components/aiwindow/ui/components/ai-clarifying-question/ai-clarifying-question.mjs", "browser/components/aiwindow/ui/components/ai-clarifying-question/ai-clarifying-question.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-highlights/aitab-highlights.stories.mjs", "browser/components/aiwindow/ui/content/ai-window-shared.css", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn", "browser/locales-preview/aiWindow.ftl", "toolkit/content/tests/widgets/test_moz_input_text.html", "toolkit/content/tests/widgets/test_moz_textarea.html", "toolkit/content/widgets/moz-input-text/moz-input-text.mjs", "toolkit/content/widgets/moz-textarea/moz-textarea.mjs"], "git_node": "718b77c068312e2d09d3a12e5648317da04c7da9", "git_parents": ["1038e9395cca4ed80a03e67b39e719a783815040"], "node": "34a43d24c149081d618c07495d0d1e010ea8503b", "parents": ["b1bee0b330dd825493d0fbdf2b81fe02571cf854"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088608 - Fix test failures in activation window r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339244\n", "files": ["browser/extensions/newtab/test/browser/browser_activation_window.js"], "git_node": "d9881da4c7b880b4931cf39802f3c4589d71b3e9", "git_parents": ["718b77c068312e2d09d3a12e5648317da04c7da9"], "node": "92dc03ed36ab4bde82768a3c91fce691439fe432", "parents": ["34a43d24c149081d618c07495d0d1e010ea8503b"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086594: Limit entries in native macOS bookmark folder menus. r=mak\n\nLimit the menu items we create because nested folder results do not apply `maxResults`.\n\nNative menu updates while a menu is open have not been tested at runtime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337863\n", "files": ["browser/app/profile/firefox.js", "browser/components/places/PlacesUIUtils.sys.mjs", "browser/components/places/content/browserPlacesViews.js", "browser/components/places/tests/browser/browser.toml", "browser/components/places/tests/browser/browser_native_menu_folder_limit.js", "browser/components/places/tests/browser/browser_native_menu_query_limit.js", "browser/locales/en-US/browser/menubar.ftl"], "git_node": "9cb4c9cf80d93b603603a5e4908133b03fe0c436", "git_parents": ["d9881da4c7b880b4931cf39802f3c4589d71b3e9"], "node": "745a8658080dd5602b3016ed16f0f8b8cd971cbf", "parents": ["92dc03ed36ab4bde82768a3c91fce691439fe432"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080324 - Stop reading the device pipeline option. r=ai-platform-reviewers,nordzilla,fluent-reviewers,bolsson\n\nOnly the onnx backend read it. cpu mapped to wasm, the default. gpu mapped to\nWebGPU, which no feature uses. onnx-native ignores it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333362\n", "files": ["toolkit/components/aboutinference/content/aboutInference.ftl", "toolkit/components/aboutinference/content/aboutInference.html", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/aboutinference/tests/browser/browser_aboutinference.js", "toolkit/components/ml/content/backends/ONNXPipeline.mjs", "toolkit/components/ml/docs/api.md", "toolkit/components/ml/docs/extensions.md", "toolkit/components/ml/tests/browser/browser_ml_engine_multi_perf.js", "toolkit/components/ml/tests/browser/browser_ml_engine_pipeline_options.js"], "git_node": "cb19c6f5c599ecbd278763eabe18d845a67d8600", "git_parents": ["9cb4c9cf80d93b603603a5e4908133b03fe0c436"], "node": "266cf74b3b3eb0637deae5e3878f0049579de0e7", "parents": ["745a8658080dd5602b3016ed16f0f8b8cd971cbf"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 1: List the inference devices of the HWInference process. r=ai-platform-reviewers,nordzilla\n\nDevices that fail a real initialisation are not listed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333363\n", "files": ["config/external/mozinference/mozinference.symbols", "dom/chrome-webidl/HWInference.webidl", "dom/chrome-webidl/moz.build", "toolkit/components/ml/MLProfilerMarkers.h", "toolkit/components/ml/backends/llama/LlamaBackend.cpp", "toolkit/components/ml/backends/llama/LlamaBackend.h", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h", "toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/ipc/HWInference.cpp", "toolkit/components/ml/ipc/HWInference.h", "toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceDeviceTypes.ipdlh", "toolkit/components/ml/ipc/HWInferenceTypes.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/ipc/moz.build", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_hwinference_device_discovery.js", "tools/@types/generated/lib.gecko.dom.d.ts"], "git_node": "53a1e1440621c88c19f892ea248b84cdfc60f4a5", "git_parents": ["cb19c6f5c599ecbd278763eabe18d845a67d8600"], "node": "4d5ba6f025bac122dbe0e043b52cb8bb38d48698", "parents": ["266cf74b3b3eb0637deae5e3878f0049579de0e7"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 2: Let a TextGenerator choose its device through a placement. r=ai-platform-reviewers,webidl,smaug,nordzilla\n\nnGpuLayers, offloadKqv and opOffload are removed from LlamaRunner. The KV\ncache and host-side ops follow the loaded device. An empty placement loads on\nthe CPU.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333364\n", "files": ["config/external/mozinference/mozinference.symbols", "dom/chrome-webidl/HWInference.webidl", "dom/chrome-webidl/TextGenerator.webidl", "dom/webidl/LlamaRunner.webidl", "toolkit/components/ml/MLProfilerMarkers.h", "toolkit/components/ml/backends/llama/LlamaBackend.cpp", "toolkit/components/ml/backends/llama/LlamaBackend.h", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h", "toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/ipc/HWInferenceDeviceTypes.ipdlh", "toolkit/components/ml/tests/browser/browser_ml_hwinference_device_discovery.js", "toolkit/components/ml/tests/gtest/TestTextGeneration.cpp", "toolkit/components/ml/textgeneration/TextGenerationChild.cpp", "toolkit/components/ml/textgeneration/TextGenerationParent.cpp", "toolkit/components/ml/textgeneration/TextGenerationParent.h", "toolkit/components/ml/textgeneration/TextGenerationTypes.ipdlh", "toolkit/components/ml/textgeneration/TextGenerator.cpp", "toolkit/components/ml/textgeneration/TextGenerator.h", "tools/@types/generated/lib.gecko.dom.d.ts"], "git_node": "56f99db5c5cc168196e63dc4ebbf60b210a8a250", "git_parents": ["53a1e1440621c88c19f892ea248b84cdfc60f4a5"], "node": "4745a899a566560541b3ed16fd3d2640c537a991", "parents": ["4d5ba6f025bac122dbe0e043b52cb8bb38d48698"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 3: Let the device pipeline option place a text generation. r=ai-platform-reviewers,nordzilla\n\nThe option is an HWInferencePlacement, forwarded unchanged to\nTextGenerator.create().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333365\n", "files": ["toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/docs/api.md", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_engine_pipeline_options.js", "toolkit/components/ml/tests/browser/browser_ml_textgeneration_engine.js", "toolkit/components/ml/tests/browser/head.js", "toolkit/components/ml/textgeneration/TextGenerationEngine.sys.mjs"], "git_node": "e3997055527cf6234d43b26a468626a6872db5ee", "git_parents": ["56f99db5c5cc168196e63dc4ebbf60b210a8a250"], "node": "e3e5be019415ffe40585ae5f63ccfe3c819c2ee3", "parents": ["4745a899a566560541b3ed16fd3d2640c537a991"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 4: Record the kind of device that loaded a text generation model. r=ai-platform-reviewers,nordzilla\n\nThe device_kind extra is cpu, gpu or npu. The device id stays out of\ntelemetry. The extra is null on backends that do not place models.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333366\n", "files": ["toolkit/components/ml/MLTelemetry.sys.mjs", "toolkit/components/ml/metrics.yaml", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_textgeneration_telemetry.js", "toolkit/components/ml/textgeneration/TextGenerationEngine.sys.mjs"], "git_node": "45be2a43455d957913408c2cf2ecb7395db96504", "git_parents": ["e3997055527cf6234d43b26a468626a6872db5ee"], "node": "9ab313e073c76be69d0808cdef2887ef5863277e", "parents": ["e3e5be019415ffe40585ae5f63ccfe3c819c2ee3"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 5: Test llama.cpp on the Metal GPU of the macOS CI machines. r=ai-platform-reviewers,taskgraph-reviewers,jcristau,nordzilla\n\nMOZ_ML_EXPECT_ACCELERATOR makes a missing accelerator a test failure. It also\nadds a SmolLM2 chat run placed on a GPU, with no CPU fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333367\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "toolkit/components/ml/tests/browser/browser_ml_hwinference_device_discovery.js", "toolkit/components/ml/tests/browser_models/browser_ml_smollm2_chat.js"], "git_node": "d5ce10e284c29ccab91ab1e5451df99dfd3267ca", "git_parents": ["45be2a43455d957913408c2cf2ecb7395db96504"], "node": "b19d4e9b6c9a39b21b9108c2d27c609758311041", "parents": ["9ab313e073c76be69d0808cdef2887ef5863277e"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080323 - Part 1: about:inference fixes for HWInference engines. r=ai-platform-reviewers,nordzilla\n\n- Terminate HWInference engines from the page, their only owner.\n- Only query an inference process that is already running.\n- Read metrics in the shape every backend returns.\n- Pass flashAttn with a quantized KV cache.\n- Clear the polls on unload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333368\n", "files": ["toolkit/components/aboutinference/content/aboutInference.js"], "git_node": "5eb858ed683a55d8df7762c71fcbf9329a69565b", "git_parents": ["d5ce10e284c29ccab91ab1e5451df99dfd3267ca"], "node": "a16d1e2536e3ad9a7741b8acbfeb2e4dfa26c236", "parents": ["b19d4e9b6c9a39b21b9108c2d27c609758311041"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080323 - Part 2: Sub-tabs and a devices panel in about:inference. r=ai-platform-reviewers,fluent-reviewers,bolsson,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333369\n", "files": ["toolkit/components/aboutinference/content/aboutInference.css", "toolkit/components/aboutinference/content/aboutInference.ftl", "toolkit/components/aboutinference/content/aboutInference.html", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/aboutinference/tests/browser/browser_aboutinference.js"], "git_node": "e8bd48e6e55ec855b79f2ee905834e83f463f37e", "git_parents": ["5eb858ed683a55d8df7762c71fcbf9329a69565b"], "node": "eccd58de7056157f0460f9ed06ea042de86d2f2e", "parents": ["a16d1e2536e3ad9a7741b8acbfeb2e4dfa26c236"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080323 - Part 3: Text generation panel in about:inference. r=ai-platform-reviewers,fluent-reviewers,bolsson,nordzilla\n\nQuantized KV cache types require flash attention.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333370\n", "files": ["toolkit/components/aboutinference/content/aboutInference.css", "toolkit/components/aboutinference/content/aboutInference.ftl", "toolkit/components/aboutinference/content/aboutInference.html", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/aboutinference/tests/browser/browser_aboutinference.js"], "git_node": "47a4a66bd66a6597100627cb1b59741a398214a8", "git_parents": ["e8bd48e6e55ec855b79f2ee905834e83f463f37e"], "node": "83b42279434fd7d148e33178126c97d6ef57e4e1", "parents": ["eccd58de7056157f0460f9ed06ea042de86d2f2e"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1844578 - Set the Chrome-for-Testing chromedriver layout in the taskgraph instead of raptor. r=perftest-reviewers,kshampur\n\nAll chromedrivers now come from Chrome-for-Testing, so the v115+ path rewrite in raptor is no longer needed. Pass the versioned cft-chromedriver-* path from setup_browsertime and only fill in the version in raptor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338473\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py", "testing/raptor/raptor/browsertime/base.py"], "git_node": "e8b04889c151ef8ec6f864471140e7d3e0cf387f", "git_parents": ["47a4a66bd66a6597100627cb1b59741a398214a8"], "node": "269ab99c684002f8bc3291699a8d94322e5fac92", "parents": ["83b42279434fd7d148e33178126c97d6ef57e4e1"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082232 - extend HLS metrics expiry to version 168. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339237\n", "files": ["dom/media/hls/metrics.yaml"], "git_node": "8d20299a7960e566a52ced9011e2c98eba389d15", "git_parents": ["e8b04889c151ef8ec6f864471140e7d3e0cf387f"], "node": "5e0fa9accae5e37d31c04bf95d4e4dc44fe2db19", "parents": ["269ab99c684002f8bc3291699a8d94322e5fac92"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082232 - extend Matroska metrics expiry to version 168. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339238\n", "files": ["dom/media/metrics.yaml"], "git_node": "1078ad0cec45dfb931cc95e6af6753f8247c6e2e", "git_parents": ["8d20299a7960e566a52ced9011e2c98eba389d15"], "node": "126e3afe4988d0c98f74610e15184aa43e0f82e5", "parents": ["5e0fa9accae5e37d31c04bf95d4e4dc44fe2db19"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081210 - Add gtests for GMP service creation racing the main thread and shutdown. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335182\n", "files": ["dom/media/gtest/TestGMPServiceCreation.cpp", "dom/media/gtest/moz.build"], "git_node": "b22b147ff424d83aec96cf3df2d89e8b41e83728", "git_parents": ["1078ad0cec45dfb931cc95e6af6753f8247c6e2e"], "node": "94948a7da2f40848722ec3348c13e87182751672", "parents": ["126e3afe4988d0c98f74610e15184aa43e0f82e5"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081210 - Guard GMPServiceParent::mStorageBaseDir with mMutex. r=media-playback-reviewers,alwu\n\nIt is set on the main thread but will be read from any thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335183\n", "files": ["dom/media/gmp/GMPServiceParent.cpp", "dom/media/gmp/GMPServiceParent.h"], "git_node": "de3da345cd27e2f22fc9a2014df2c1ced337fc7b", "git_parents": ["b22b147ff424d83aec96cf3df2d89e8b41e83728"], "node": "ee937a982d3d344f334882db99c7212e8d1114c5", "parents": ["94948a7da2f40848722ec3348c13e87182751672"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081210 - Factor out GMPServiceParent::RejectPendingInitPromise. r=aosmond,media-playback-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335184\n", "files": ["dom/media/gmp/GMPServiceParent.cpp", "dom/media/gmp/GMPServiceParent.h"], "git_node": "de84a76dc17341a26bafc65a6507e7a54765c3d7", "git_parents": ["de3da345cd27e2f22fc9a2014df2c1ced337fc7b"], "node": "845e8cba3246b540116d7a947bd23fa9829fcda1", "parents": ["ee937a982d3d344f334882db99c7212e8d1114c5"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081210 - Create the GMP service without waiting for the main thread. r=aosmond,media-playback-reviewers\n\nPublish the singleton under a lock from any thread and run the main thread only setup as a task, inline on main. Skip the setup and shut the service down if shutdown was confirmed first.\n\nThis removes the SyncRunnable that deadlocked against nsComponentManager waiting for the pending service.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335185\n", "files": ["dom/media/gmp/GMPService.cpp", "dom/media/gmp/GMPService.h", "dom/media/gmp/GMPServiceChild.cpp", "dom/media/gmp/GMPServiceChild.h", "dom/media/gmp/GMPServiceParent.cpp", "dom/media/gmp/GMPServiceParent.h"], "git_node": "7acce669451677275dcb83a2cf54262c8549b405", "git_parents": ["de84a76dc17341a26bafc65a6507e7a54765c3d7"], "node": "03cfc1a3606ca9115087ec64be6d1158770f4025", "parents": ["845e8cba3246b540116d7a947bd23fa9829fcda1"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2003021 - Insert related tabs next to their opener in collapsed tab groups r=tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338873\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js"], "git_node": "24b4749bbef2f5773cfe95be7ba00767add8dd9b", "git_parents": ["7acce669451677275dcb83a2cf54262c8549b405"], "node": "90cdc336f52ecbedee37e594955b32848a11c074", "parents": ["03cfc1a3606ca9115087ec64be6d1158770f4025"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2081558 - Keep the D-Bus remote object's connection until Shutdown() unregisters it. r=stransky,gtk-reviewers\n\nStore the connection in OnBusAcquired(), when the OpenURL object is\nregistered, instead of in OnNameAcquired(), and unregister through it in\nShutdown(), so both ends of the registration use the same connection\nwhatever happens to the bus name. The name-acquired and name-lost\nhandlers only managed the connection and the registration, so they are\ndropped: with DO_NOT_QUEUE and no ALLOW_REPLACEMENT the name is only ever\nlost when someone else already owns it or the connection closes, and\nkeeping the object registered until Shutdown() changes nothing in either\ncase. mConnection becomes a RefPtr so the connection stays valid until the\nobject is unregistered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337771\n", "files": ["toolkit/components/remote/nsDBusRemoteServer.cpp", "toolkit/components/remote/nsDBusRemoteServer.h"], "git_node": "fca9042d3a5ced004ae8f22feb95da085436f707", "git_parents": ["24b4749bbef2f5773cfe95be7ba00767add8dd9b"], "node": "a65eee8132d3d230dc480f4bff0b1df6e05920f8", "parents": ["90cdc336f52ecbedee37e594955b32848a11c074"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084405 - Intern the three gradient types in the display list builder r=gfx-reviewers,lsalzman\n\nThe stops no longer travel with every paint. All three move together because\na nine-patch border can source any of them, and such a border now records the\ngradient's handle. The gradient keys are not PrimKey\u003cT\u003e, so placement resolves\nthrough a PrimKeyCommon trait.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338940\n", "files": ["gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/gradient/conic.rs", "gfx/wr/webrender/src/prim_store/gradient/linear.rs", "gfx/wr/webrender/src/prim_store/gradient/mod.rs", "gfx/wr/webrender/src/prim_store/gradient/radial.rs", "gfx/wr/webrender/src/prim_store/interned.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/interning.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "2f5eb9457f2227829e1f8d67a58e8bb8f76f6633", "git_parents": ["fca9042d3a5ced004ae8f22feb95da085436f707"], "node": "5aa20c0fd0e0893d33f6fce6fca4a49d05d35e87", "parents": ["a65eee8132d3d230dc480f4bff0b1df6e05920f8"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084406 - Intern both border kinds in the display list builder r=gfx-reviewers,nical\n\nEvery BorderKind arm is now a handle, with the bounds and widths in the key.\nThe radius clamp runs before interning, so borders that render identically\nshare an entry. A foreign border image resolves to ImageKey::DUMMY.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338941\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/interned.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/interning.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "dafbfb1c5d3796fcb69ba278f2f465e2a59c5267", "git_parents": ["2f5eb9457f2227829e1f8d67a58e8bb8f76f6633"], "node": "bdad51de82061676f1af7fb405103190204cfdfd", "parents": ["5aa20c0fd0e0893d33f6fce6fca4a49d05d35e87"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 1421485 - Import multiple visits per url from Chrome history. r=jhirsch,mconley\n\nPreviously each Chrome URL was imported with one visit at its last visit\ntime, typed if it had ever been typed. Now up to\nbrowser.migrate.chrome.history.visit.limit of a URL's most recent visits\nare imported with their own dates, and their Chrome transitions mapped to\nPlaces ones, so frecency reflects recent usage. The number of imported URLs is\nunchanged, so frecency recalculation, which is per page and accelerated after\nlarge imports since bug 1873629, does about the same amount of work. Only the\nnumber of inserted visits grows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336293\n", "files": ["browser/app/profile/firefox.js", "browser/components/migration/ChromeMigrationUtils.sys.mjs", "browser/components/migration/ChromeProfileMigrator.sys.mjs", "browser/components/migration/tests/unit/test_ChromeMigrationUtils.js", "browser/components/migration/tests/unit/test_Chrome_history.js", "browser/components/migration/tests/unit/xpcshell.toml"], "git_node": "a5b23cf9ecb7b55fa447f551ef63db1d678db85b", "git_parents": ["dafbfb1c5d3796fcb69ba278f2f465e2a59c5267"], "node": "28fa2dd492082b6f978f2b61503e4372fc1a74a8", "parents": ["bdad51de82061676f1af7fb405103190204cfdfd"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 1: Reset the time stretcher after its flushed output has played. r=padenot\n\nReturning to 1x flushes the time stretcher. The flush pads the input with\nsilence, and SoundTouch keeps counting that padding as output it still owes.\nSince the stretcher is now kept alive across rate changes, this debt grows on\nevery return to 1x, so each flush plays more silence than the last and audio\nfalls further behind video.\n\nOnce the flushed output has played, clear the stretcher and prime it again, so\nthe next rate change starts from the same state as the first. Prime it in\nsmall chunks, as this now runs on every return to 1x.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338508\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h"], "git_node": "b4a53084f98ceb6219ae5639e2b7e9b1ea98d461", "git_parents": ["a5b23cf9ecb7b55fa447f551ef63db1d678db85b"], "node": "de78827024006eb321f4db7d104e4808ba2a668b", "parents": ["28fa2dd492082b6f978f2b61503e4372fc1a74a8"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 2: Count the time stretcher output only as the source it holds. r=padenot\n\nThe clock counted every frame out of the time stretcher as media time at the\ncurrent rate. That output also carries the silence the stretcher is primed\nwith and the silence a flush pads it with, so the clock, and the video that\nfollows it, ran ahead of the audio, more on every return to 1x.\n\nKeep track of the source fed to the stretcher and of the media the clock has\ncounted for its output. Stretcher output now advances the clock only up to\nthe source the clock has not counted yet, and the rest holds the position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338509\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h"], "git_node": "3cc5c64d8328437926015f10c60970574002bc77", "git_parents": ["b4a53084f98ceb6219ae5639e2b7e9b1ea98d461"], "node": "beff5496be9edd8bb5ede1bf1de5d81c43b0d90b", "parents": ["de78827024006eb321f4db7d104e4808ba2a668b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 3: Test that rate changes keep the audio clock on the source position. r=padenot\n\nThe previous test only checked that rate changes do not consume too much\nsource, so it passed while the clock ran ahead of the audio. Check instead,\nfor several rates with and without pitch preservation, and for returns to 1x\nboth long and too short for the time stretcher to play out, that the clock\nnever passes the source taken from the data source, that the source consumed\nstays within bounds of what the rates ask for, and that every cycle after the\nfirst consumes the same source and leaves the clock the same distance behind.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338510\n", "files": ["dom/media/gtest/TestAudioStream.cpp"], "git_node": "e1cb53aa2811e27ae79b8d1d037ad43904b62881", "git_parents": ["3cc5c64d8328437926015f10c60970574002bc77"], "node": "4c411fef2fbe1f5a5c3f56cc372f437fa7805599", "parents": ["beff5496be9edd8bb5ede1bf1de5d81c43b0d90b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075947 - Part 4: Document how the audio clock counts the time stretcher output. r=padenot,media-playback-reviewers\n\nThe AudioStream document described how the frame history maps frames to media\ntime, but not the time stretcher that playback rates other than 1x go through.\nExplain when the stretcher is used, why it is primed, flushed and reset, and\nhow the clock counts its output so that it never runs ahead of the source.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338511\n", "files": ["dom/media/docs/AudioStream.md"], "git_node": "0f7f612244e6e83ba0d4b430ad980da0a6f97d6c", "git_parents": ["e1cb53aa2811e27ae79b8d1d037ad43904b62881"], "node": "0f98f7e1636f81183438ea6beebd2fb3209ca0f5", "parents": ["4c411fef2fbe1f5a5c3f56cc372f437fa7805599"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088484 - Keep vertical tabs scrolled into view clear of the overflow fade. r=desktop-theme-reviewers,tabbrowser-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339216\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_scroll_into_view_vertical.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "63102f7198e76dba952284842cbf77a30c05fc04", "git_parents": ["0f7f612244e6e83ba0d4b430ad980da0a6f97d6c"], "node": "9bcce3919f68714c34930eb00b020593962c633c", "parents": ["0f98f7e1636f81183438ea6beebd2fb3209ca0f5"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086894 - Add a Glean event for credit card storage errors. r=mtigley,credential-management-reviewers,dimi\n\nAdd `formautofill.creditcards.store_error`, an event with `operation`\n(\"add\", \"update\", \"clear\", \"read\"), `error_type` and `has_cvv` extras,\nso failed credit card writes and reads show up in telemetry instead of\nfailing silently.\n\n`RustAutofillCreditCardsAdapter` passes the records involved to\n`#recordStoreError(operation, e, records)`, which checks them for a\ncode: `_add` passes `[record]`, `_update` passes `[record, stored]`, and\nan update that drops a code the stored card held is recorded as \"clear\".\n`update()` now passes the stored record to\n`_update(store, guid, record, stored)` for that check.\n\n`#read` records \"read\" when `getCreditCard`/`getAllCreditCards` fails,\nwith the cards from `listCreditCardCandidates()`, which does not use the\nkey and cannot prompt. `has_cvv` is left out when that listing also\nfails. A missing record is not counted.\n\n`error_type` is the `AutofillApiError` subclass name (`CryptoError`,\n`SqlError`, ...), \"PrimaryPasswordLocked\" for a declined or locked\nprimary password (`NS_ERROR_ABORT`), or \"Unknown\". Locked errors are\nrecorded so queries can filter them out. No message, guid or card\nvalue is recorded.\n\nThe store encrypts the number and code in one call, so `has_cvv` says a\ncode was involved, not that it caused the failure. The JSON store holds\nno codes and is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338097\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "toolkit/components/formautofill/RustAutofillAdapterBase.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "23803081cb4e9200f0f9e470d1e81e153e0175aa", "git_parents": ["63102f7198e76dba952284842cbf77a30c05fc04"], "node": "a198abbcc632981a56d7124aeb636afe772cc213", "parents": ["9bcce3919f68714c34930eb00b020593962c633c"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086256 -- Add back Rust component breadcrumb reporting, r=jonalmeida,android-reviewers,android-build-system-reviewers\n\nIn bug 1991443 I removed the Sentry error reporting, since we're now\nreporting Rust errors via the Glean ping.  However, the breadcrumbs can\nbe useful for Fenix Sentry errors, so let's record those.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337639\n", "files": ["mobile/android/android-components/components/support/appservices/build.gradle", "mobile/android/android-components/components/support/appservices/src/main/java/mozilla/components/support/AppServicesInitializer.kt", "mobile/android/android-components/components/support/appservices/src/main/java/mozilla/components/support/rusterrors/RustErrors.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt"], "git_node": "5e787235f9ac066842b2beeb63917cf042fc553f", "git_parents": ["23803081cb4e9200f0f9e470d1e81e153e0175aa"], "node": "cfd51789d5a03113e76d836c32f7df44773f3948", "parents": ["a198abbcc632981a56d7124aeb636afe772cc213"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings mobile-merino-manifest ct-logs r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339276\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "eee15031ead03096fb10ff64ba8ad3af1b5a0a43", "git_parents": ["5e787235f9ac066842b2beeb63917cf042fc553f"], "node": "66aa5d8a1d380f94e44ea38405223bd3f9823bbb", "parents": ["cfd51789d5a03113e76d836c32f7df44773f3948"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083952 - Add a SUBMIT_SMARTWINDOW_PROMPT message action for AI Tab feature callouts. r=omc-reviewers,aminomancer\n\nNew SUBMIT_SMARTWINDOW_PROMPT asrouter message that initiates a Smart Window chat prompt (opening sidebar if necessary).\n\nUsed for the AI Tab (internal name for Smart Page) OMC callouts.\n\nSupports split view and page-type treatments. Uses a primary button that asks the Smart Window chat for a page with a message-supplied prompt. The request goes to the sidebar chat, opening the sidebar on the tab's conversation. The user stays on the page they are comparing.\n\nThe test messages anchor to the sidebar Smartbar when the sidebar is open and fall back to the Ask button (on top right of screen) otherwise.\n\nNote that this the first time that we're passing prompts through, which means we need to add a new telemetry category in some cases to indicate how the command was initiated. Alternatively we can consider it 'chat' but I thought it would be good to track success rates of OMC (labed as 'asrouter') triggers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336242\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_aitab_callout.js", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_submit_smartwindow_prompt.js"], "git_node": "032ed0eaa96a01d1acad889c2c227837b7a41a21", "git_parents": ["eee15031ead03096fb10ff64ba8ad3af1b5a0a43"], "node": "c7ac89c34d222a5428c09802e894cb778e6a8848", "parents": ["66aa5d8a1d380f94e44ea38405223bd3f9823bbb"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053088 - Establish the outer proxy connection via Happy Eyeballs, r=mxinden\n\nGated by network.http.happy_eyeballs.proxy_enabled (default off). When enabled,\nthe outer Firefox\u003c-\u003eproxy connection for HTTPS CONNECT and MASQUE proxies is\ndriven by HappyEyeballsConnectionAttempt instead of DnsAndConnectSocket.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311264\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/HappyEyeballsConnMgrDelegate.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/HappyEyeballsTransaction.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpConnectionBase.h", "netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/nsAHttpTransaction.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.h", "netwerk/test/gtest/TestHappyEyeballsConnectionAttempt.cpp", "netwerk/test/unit/test_http3_proxy.js", "netwerk/test/unit/test_http3_proxy_no_speculative.js", "netwerk/test/unit/test_https_proxy_h3_outer_via_https_rr.js", "netwerk/test/unit/test_https_proxy_with_https_rr.js", "netwerk/test/unit/test_proxy_forwarding_peer_port.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "deb0af4d7d8318f5d78c2128b5c0e567070247d0", "git_parents": ["032ed0eaa96a01d1acad889c2c227837b7a41a21"], "node": "b54e33d5df8253f69a189e3e00a2eadcd5001d74", "parents": ["c7ac89c34d222a5428c09802e894cb778e6a8848"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053088 - Use Happy Eyeballs for SOCKS proxies via by-name connection attempts, r=necko-reviewers,valentin,mxinden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324051\n", "files": ["netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/AlternateServices.h", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/ConnectionEstablisher.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.cpp", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/nsAHttpTransaction.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/gtest/TestHappyEyeballsConnectionAttempt.cpp", "netwerk/test/gtest/TestHappyEyeballsNetAddrArray.cpp", "netwerk/test/unit/test_altsvc_proxy_cert_origin.js", "netwerk/test/unit/test_socks_proxy_fetch.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "d0a1285fcb61a0a930ae7f8e0b443ee95ecf60bc", "git_parents": ["deb0af4d7d8318f5d78c2128b5c0e567070247d0"], "node": "dfbab17a5f2d0febe3138dd08de1b0d15d7a21e6", "parents": ["b54e33d5df8253f69a189e3e00a2eadcd5001d74"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072034 - Keep desktop Sync engine choices local behind the per-device pref. r=markh,sync-reviewers\n\nWith services.sync.perDeviceEngineChoices on, Choose What to Sync is local\nto this device. Desktop stops syncing the declined list, stops changing\nlocal choices to match meta/global, and stops deleting server data when an\nengine is disabled.\n\nOn its first sync after sign-in, the device copies the account's choices\nfrom meta/global, as a legacy client would.\n\nThe setup dialog is pre-filled with the same choices. Re-enabling an engine\nresets its last sync, since disabling it no longer resets it.\n\nNothing changes with the pref off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326752\n", "files": ["services/sync/modules/engines.sys.mjs", "services/sync/modules/engines/clients.sys.mjs", "services/sync/modules/service.sys.mjs", "services/sync/modules/stages/declined.sys.mjs", "services/sync/modules/stages/enginesync.sys.mjs", "services/sync/tests/unit/test_clients_engine.js", "services/sync/tests/unit/test_service_sync_updateEnabledEngines.js"], "git_node": "9575300b9866f5a879d5c31eddb3230041830c47", "git_parents": ["d0a1285fcb61a0a930ae7f8e0b443ee95ecf60bc"], "node": "4deb4e38a9c906f50ce7041535d56c6f9372488e", "parents": ["dfbab17a5f2d0febe3138dd08de1b0d15d7a21e6"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072034 - Add a meta/syncids registry for per-device engine sync IDs. r=markh,sync-reviewers\n\nPer-device clients can't add or remove entries in meta/global's `engines`\nwithout changing legacy clients' choices, but they still need a shared\nsyncID per engine. This keeps those in a new storage/meta/syncids record.\n\nmeta/global's entry is used when it exists. When a legacy client removes\nit, per-device clients use meta/syncids and don't reset. A per-device\nclient that recreates meta/global after a server wipe republishes the\naccount's choices from the last meta/global it saw, so legacy clients keep\ntheirs. Without any, it publishes its own, as a legacy client would.\n\nNothing reads or writes meta/syncids with the pref off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328045\n", "files": ["services/sync/modules/engines.sys.mjs", "services/sync/modules/engines/passwords.sys.mjs", "services/sync/modules/service.sys.mjs", "services/sync/modules/stages/enginesync.sys.mjs", "services/sync/modules/stages/syncids.sys.mjs", "services/sync/moz.build", "services/sync/tests/unit/test_load_modules.js", "services/sync/tests/unit/test_password_engine.js", "services/sync/tests/unit/test_service_sync_updateEnabledEngines.js"], "git_node": "7cd1da1d92b9bee2fc9b32a6da132c7b2c4f3d8e", "git_parents": ["9575300b9866f5a879d5c31eddb3230041830c47"], "node": "b4cc27fca33464fde549b9e5820ab1a3f66d3576", "parents": ["4deb4e38a9c906f50ce7041535d56c6f9372488e"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081585: Add ability for TPS tests to test accounts with PDS and non-PDs r=markh,sync-reviewers,frontend-codestyle-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333492\n", "files": ["services/sync/tests/tps/.eslintrc.mjs", "services/sync/tests/tps/all_tests.json", "services/sync/tests/tps/pds/pds_tests.json", "services/sync/tests/tps/pds/test_pds_creates_account.js", "services/sync/tests/tps/pds/test_pds_join_legacy_account.js", "services/sync/tests/tps/pds/test_pds_legacy_decl