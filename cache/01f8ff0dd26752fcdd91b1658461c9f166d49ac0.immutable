rch/SearchEngine.sys.mjs", "toolkit/components/search/tests/xpcshell/test_searchTermFromResult.js"], "git_node": "b98d8535259841455c95b1148abb353168421b6c", "git_parents": ["917ca3c59bc0f9648e11a7337de7d4138316f5aa"], "node": "190f1116d10e5cf38e690a81d81d987fd96be133", "parents": ["1043d1ce095e495babfd364462e17850415ead7c"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083936 - Make definitions of TTF cmap structures more canonical. r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336870\n", "files": ["gfx/thebes/gfxFontUtils.cpp"], "git_node": "bea55255d5950e463fa0cda1bdafeaa74d4bcc81", "git_parents": ["b98d8535259841455c95b1148abb353168421b6c"], "node": "1e03b083628a410cc47b18c9c7e186cbd959e57e", "parents": ["190f1116d10e5cf38e690a81d81d987fd96be133"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085569 - Use MozElementMixin's XUL template format in arrowscrollbox and menupopup r=reusable-components-reviewers,hjones,Gijs\n\nThey defined an instance markup getter and their own fragment getter,\nbut this behaviour is already provided by MozElementMixin which they\ninherit from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336524\n", "files": ["browser/components/places/content/places-menupopup.js", "toolkit/content/widgets/arrowscrollbox.js", "toolkit/content/widgets/menupopup.js"], "git_node": "d96b5a3cdc48c4f93f0ec3394f2fa5d6fecc365f", "git_parents": ["bea55255d5950e463fa0cda1bdafeaa74d4bcc81"], "node": "bbb6437631b977cb401fdf587a1e4fd8f6e58081", "parents": ["1e03b083628a410cc47b18c9c7e186cbd959e57e"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086069 - P1. Vendor application-services 53354393 r=theidkamp\n\nVendor application-services 53354393f, which merges #7687 (bug 2085717):\nupdate_credit_card keeps the stored CVV when cc_cvv is null and clears it when\nit is empty, and scrubbing encrypted data clears the CVV along with the number.\n\nThe revision also carries the upstream changes since eba864f9: Remote Settings\nclient errors include the server's error details (bug 1941569), ads-client\ntelemetry strings are cut to Glean's limit (bug 2047640), and\nviaduct-backend-rust moves to reqwest 0.13.5 (bug 2084735).\n\nThis also includes the file changes from `./mach uniffi generate`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337094\n", "files": ["third_party/application-services/components/ads-client/src/telemetry/backend.rs", "third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/db/credit_cards.rs", "third_party/application-services/components/autofill/src/db/store.rs", "third_party/application-services/components/autofill/src/sync/credit_card/outgoing.rs", "third_party/application-services/components/remote_settings/src/client.rs", "third_party/application-services/components/remote_settings/src/error.rs", "third_party/application-services/components/remote_settings/src/service.rs", "third_party/application-services/components/support/viaduct-backend-rust/Cargo.toml", "third_party/application-services/docs/building.md", "third_party/application-services/examples/remote-settings-cli/Cargo.toml", "third_party/application-services/libs/README.md", "third_party/application-services/libs/build-all.sh", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs"], "git_node": "5a39ae6d8f22fb6d26dc3b10de3f8e78f1fd6d6a", "git_parents": ["d96b5a3cdc48c4f93f0ec3394f2fa5d6fecc365f"], "node": "9b24ca28bd1ec13616468accc80332d250742dbf", "parents": ["bbb6437631b977cb401fdf587a1e4fd8f6e58081"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086069 - P2. Clear a credit card's CVV by passing an empty string to the Rust store r=credential-management-reviewers,theidkamp\n\nThe Rust store now keeps the stored CVV when an update passes null, so\nclearing a security code on desktop has to pass an empty string.\n\nThe update doorhanger test pins existing behaviour: a form submitted with an\nempty security code field keeps the stored one.\n\nDepends on D337094\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337095\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_sync_engine.js", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs"], "git_node": "fd3ebb9d419066273898a0bb2c993632b4a58a6a", "git_parents": ["5a39ae6d8f22fb6d26dc3b10de3f8e78f1fd6d6a"], "node": "e32baf86004864a7fb8903234904ccb03c4e049b", "parents": ["9b24ca28bd1ec13616468accc80332d250742dbf"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083960 - Move the Expat XML_GetCurrentByteIndex fallback into Mozilla's wrapper. r=hsivonen\n\nnsExpatDriver reads the byte index between XML_Parse calls, including before the first chunk and after the\nfinal empty chunk, where upstream returns -1. Return the total bytes fed in those cases from\nMOZ_XML_GetCurrentByteIndex instead of patching xmlparse.c; nothing is left unparsed there, so it equals the\nbytes consumed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335434\n", "files": ["parser/expat/04_getcurrentbyteindex.patch", "parser/expat/11_unused.patch", "parser/expat/expat/lib/moz_xmlparse.c", "parser/expat/expat/lib/xmlparse.c", "parser/expat/moz.yaml"], "git_node": "b7cd526e59b2fe123f7330824ba5b1602df3b3d7", "git_parents": ["fd3ebb9d419066273898a0bb2c993632b4a58a6a"], "node": "3a0717b4a90bd1a6d2820b73bd2d5007e4ade7a2", "parents": ["e32baf86004864a7fb8903234904ccb03c4e049b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083960 - Drop the Expat patch passing parameter entity names for the internal subset. r=hsivonen\n\nIt only fed `%name;` into the internal subset string kept on DocumentType, which nothing reads now that\ninternalSubset is no longer exposed. It also broke Expat's documented contract that a NULL context marks a\nparameter entity.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335435\n", "files": ["parser/expat/08_internalsubset.patch", "parser/expat/expat/lib/xmlparse.c", "parser/expat/moz.yaml", "parser/htmlparser/nsExpatDriver.cpp"], "git_node": "610c98c34f7cb40b61db390d2d5d3b1deaf20026", "git_parents": ["b7cd526e59b2fe123f7330824ba5b1602df3b3d7"], "node": "9b692f4de6249e0def123abbf91adfd539995a56", "parents": ["3a0717b4a90bd1a6d2820b73bd2d5007e4ade7a2"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083960 - Drop the Expat patch always storing raw tag names. r=mccr8\n\nExpat 2.7.0 restructured internal entity processing (upstream a910fbc0, \"Fix internal entity processing\"), so\ninternalEntityProcessor only parses entity text and main document content always returns through\ncontentProcessor, which calls storeRawNames(). The tag stack can no longer be left pointing into the input\nbuffer after an interruption inside an internal entity.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335449\n", "files": ["parser/expat/05_always_store_rawnames.patch", "parser/expat/06_dont_ignore_undeclared_entity.patch", "parser/expat/expat/lib/xmlparse.c", "parser/expat/moz.yaml"], "git_node": "d2c4a1e2d32d3be519822ffbf141ffdbe1de01f3", "git_parents": ["610c98c34f7cb40b61db390d2d5d3b1deaf20026"], "node": "afaadacd8fb9164103958a76ffd212aa1fc35c96", "parents": ["9b692f4de6249e0def123abbf91adfd539995a56"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079508 - Show 'Payment method saved' or 'Payment method updated' after the card doorhanger. r=mtigley,fluent-reviewers,credential-management-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337158\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_confirmation_popup.js", "browser/extensions/formautofill/test/browser/head.js", "browser/locales/en-US/browser/confirmationHints.ftl", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "0b8de9789e84035be6aace4e5521d0e21ec48519", "git_parents": ["d2c4a1e2d32d3be519822ffbf141ffdbe1de01f3"], "node": "4bcc05246027c9f4d0d9f5df98d9210b3710a629", "parents": ["afaadacd8fb9164103958a76ffd212aa1fc35c96"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084545 - Fix searchTermFromResult for engines with a {partnerCode} param - r=Standard8\" for causing xpc failures @test_providerTabToSearch.js.\n\nThis reverts commit b98d8535259841455c95b1148abb353168421b6c.\n", "files": ["toolkit/components/search/SearchEngine.sys.mjs", "toolkit/components/search/tests/xpcshell/test_searchTermFromResult.js"], "git_node": "649331170af6b3c41773e9bc2ae17196dd0c4489", "git_parents": ["0b8de9789e84035be6aace4e5521d0e21ec48519"], "node": "0af2db990cc5a6ff1d51ef1f3a90763ce9bbe29b", "parents": ["4bcc05246027c9f4d0d9f5df98d9210b3710a629"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084545 - Fix searchTermFromResult for engines with a {partnerCode} param - r=Standard8\n\nDif