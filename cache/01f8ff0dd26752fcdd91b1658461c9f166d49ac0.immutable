es/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pa-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sc/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-skr/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sq/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "e74f5a48f0c69c14861a01acd30f667b17079bff", "git_parents": ["ac4ffb51155729bb3cda97febd9646aeb14a7143"], "node": "ac78a40eb2c9c6220d75ef47d5b62372c41c0e31", "parents": ["da1bc1de717d9555fe55a56e52f8721d3ece9ace"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2087286: Use reassignment instead of std::exchange in UndoTryPositionWithDifferentDefaultAnchor. r=layout-reviewers,TYLin\n\nstd::exchange just does reassignment and then returns the replaced value.\n\nIn this particular usage, we don't use its return value at all.  And some\ncompilers have a warning to enforce that std::exchange's return value *must* be\nused.\n\nIt's equivalent and strictly simpler (and avoids that warning) if we just do\nreassignment.\n\n(I'm using std::move() here, since *semantically* we're taking the contents of\na no-longer-needed object, and for consistency with the previous line. But in\npractice there's not currently any special move-specific behavior that happens\nhere with this particular struct as it currently exists.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338356\n", "files": ["layout/base/AnchorPositioningUtils.h"], "git_node": "02c42c546d4a5cbdf11cfa77c547820f67aedc59", "git_parents": ["e74f5a48f0c69c14861a01acd30f667b17079bff"], "node": "def1482d9a594f95769256bf4315eeb736fca3e5", "parents": ["ac78a40eb2c9c6220d75ef47d5b62372c41c0e31"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2086609 - Update tzdata to 2026f. r=mgaudet\n\nChanges made mechanically by running `./update-tzdata.sh 2026f`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338158\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/windowsZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/windowsZones.txt", "intl/tzdata/source/zoneinfo64.txt"], "git_node": "f8a0895bb4984e3099a775e2e5113b81883a95f6", "git_parents": ["02c42c546d4a5cbdf11cfa77c547820f67aedc59"], "node": "9ebd8d452f2660a832ba5a2ed8299cd8ffbe6622", "parents": ["def1482d9a594f95769256bf4315eeb736fca3e5"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2086609 - Revert metaZones to tzdata 2026e. r=mgaudet\n\nmetaZones data distributed by icu-data 2026f cause incorrect localized\ntime zone names for Europe/London with ICU 78. Revert to the previous\nmetaZones until we update to ICU 79.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338159\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/metaZones.txt"], "git_node": "4e2a2fc656fb19feeae2bbbb6e9c44e700ad35a2", "git_parents": ["f8a0895bb4984e3099a775e2e5113b81883a95f6"], "node": "bfdac94d66d4731b51133e216e2ec51cbe6565a8", "parents": ["9ebd8d452f2660a832ba5a2ed8299cd8ffbe6622"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2086609 - Regenerate js files for tzdata 2026f. r=mgaudet\n\nThis change was generated by `./make_intl_data.py tzdata`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338160\n", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "e9864f06d4ba36422a39314fa0dbece8f259f01b", "git_parents": ["4e2a2fc656fb19feeae2bbbb6e9c44e700ad35a2"], "node": "bda8a87b67aaf2dd80879de8b567caa1c9d5da45", "parents": ["bfdac94d66d4731b51133e216e2ec51cbe6565a8"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2081288: Rewrite crashtest 2075414.html to do its work in an iframe. r=vhilla\n\nBefore this patch, the crashtest 2075414.html reloads itself, which is not\nsomething that the reftest harness robustly handles (particularly for\n\"reftest-wait\" tests).  When a test needs to do that, we typically handle it by\nputting put the main guts of the test an iframe which can freely navigate,\nwhich gets hosted by a lightweight outer document that waits for a signal from\nthe inner document before declaring the test done.\n\nThis patch does that for this crashtest -- just moving the existing crashtest\nto now be 2075414-frame.html, and creating a new lightweight 2075414.html to\nhost it in an iframe and maintain the \"reftest-wait\" is-the-test-done state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336047\n", "files": ["docshell/base/crashtests/2075414-frame.html", "docshell/base/crashtests/2075414.html"], "git_node": "31cdffc607b8c753270f564ec20d31ca59075c5d", "git_parents": ["e9864f06d4ba36422a39314fa0dbece8f259f01b"], "node": "0535d950d52661d4f7dee21746f8882e2b44999f", "parents": ["bda8a87b67aaf2dd80879de8b567caa1c9d5da45"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2060318 - Delete private download files on shutdown too r=webdriver-reviewers,jdescottes,mak\n\n\"last-pb-context-exited\" is never notified in permanent private browsing mode, so files queued via deletePrivateFileWhenPossible (browser.download.deletePrivate) and deleteTemporaryPrivateFileWhenPossible were never removed. The private browsing session also ends at shutdown, so expunge those files on \"profile-before-change\" too. The existing logic moves into a shared ExpungeAllPrivateFiles() helper. It is idempotent because the lists are cleared after expunging.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335433\n", "files": ["testing/marionette/harness/marionette_harness/tests/integration-tests.toml", "toolkit/components/downloads/moz.build", "toolkit/components/downloads/test/marionette/manifest.toml", "toolkit/components/downloads/test/marionette/test_delete_private_permanent_pbm.py", "uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/nsExternalHelperAppService.h"], "git_node": "32af0f3bb6b323c1c660d70ecbad4e64479c09f5", "git_parents": ["31cdffc607b8c753270f564ec20d31ca59075c5d"], "node": "267c91ebd74745334fce236818e6b7b268e9ce6a", "parents": ["0535d950d52661d4f7dee21746f8882e2b44999f"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2030454 - Update WPT expectations; r=arai\" for causing spidermonkey failures at global-exports.tentative.any.js\n\nThis reverts commit 97d9354713dfafe82b4fce9869d6b37cdc1922c8.\n\nRevert \"Bug 2030454 - Add jit-tests for evaluation phase wasm modules; r=arai\"\n\nThis reverts commit aa2f8236d9fc1fa9f2ce29f8ba3ee9b0fa6b3f05.\n\nRevert \"Bug 2030454 - Support evaluation of wasm modules; r=arai\"\n\nThis reverts commit c0b78af7fd07fd1a691fc3c872ad5e416aec2c2f.\n\nRevert \"Bug 2030454 - Return wasm module filename in ModuleObject::filename; r=arai\"\n\nThis reverts commit 825a30987a7fed6040629097c6999c126319cbac.\n\nRevert \"Bug 2030454 - Reject non-global imports from the imported string constants module; r=rhunt\"\n\nThis reverts commit 12f52de96fe773deec8995ec7a34ed9592163bfb.\n\nRevert \"Bug 2030454 - Implement WasmModuleExecute; r=rhunt\"\n\nThis reverts commit 996ff81c8c2035a39f3d141c90038e6a80b6c41c.\n\nRevert \"Bug 2030454 - Copy fetched wasm bytes into the request in worklets; r=dom-worker-reviewers,edenchuang\"\n\nThis reverts commit 793a3154a1c88e8f062472b68ecafba66a2fa6a3.\n\nRevert \"Bug 2030454 - Set module private in shell loader; r=arai\"\n\nThis reverts commit 2807a311d6c09adbc4783a7592398a1e5459b394.\n\nRevert \"Bug 2030454 - Call ensureConstructor in Module::instantiate; r=rhunt\"\n\nThis reverts commit 43648b2c99e38c4579524f7517b5f7c6f806e973.\n\nRevert \"Bug 2030454 - Add initWasmExportBindings; r=arai\"\n\nThis reverts commit 5b5454215cf2971ea7946c8173ec70a581250bca.\n\nRevert \"Bug 2030454 - Expose Module APIs for use by WasmModuleExecute; r=arai\"\n\nThis reverts commit 1affdc57d8a2f1ba2e248b0dd18474aa2d6604f5.\n\nRevert \"Bug 2030454 - Split out helper functions from GetImports(); r=rhunt\"\n\nThis reverts commit 0f10a616795d3e9131e89bf8e6c06fd56dde4667.\n\nRevert \"Bug 2030454 - Merge source and evaluation phase wasm module record creation; r=arai,dom-worker-reviewers,edenchuang\"\n\nThis reverts commit d3ecb63ebdd28c75a9f9f4438c515bacc8dbd4a8.\n\nRevert \"Bug 2030454 - Populate importEntries in CreateWasmModule; r=arai\"\n\nThis reverts commit 4bd0f7e4471f451ac224ab35d3be5cae0936b121.\n\nRevert \"Bug 2030454 - Add [[Instance]] slot for wasm modules; r=arai\"\n\nThis reverts commit 2b05a3cf6d3ed6be540baf9409fbc318a8a6c63c.\n\nRevert \"Bug 2030454 - Initialize async slots for wasm modules; r=arai\"\n\nThis reverts commit cf6e7b15d34b4bbb8a3ce1b72ab573f912179b98.\n\nRevert \"Bug 2030454 - Add WasmModuleInitializeEnvironment; r=arai\"\n\nThis reverts commit 35332ecff715cda383aa5c0c1376ad90e2b218e5.\n\nRevert \"Bug 2030454 - Add WasmModuleResolveExport to Modules.cpp; r=arai\"\n\nThis reverts commit 5ccc39c362277ef8474bb08ae669766366d7e0ca.\n\nRevert \"Bug 2030454 - Support wasm modules in ModuleGetExportedNames; r=arai\"\n\nThis reverts commit eb3219a7338a436293dbe6735716a2b054f8ab68.\n\nRevert \"Bug 2030454 - Replace isSourcePhaseModule with isWasmModule in ModuleObject; r=arai\"\n\nThis reverts commit 8cb19a8f9adf940ca1c78102d4034b1775612b0d.\n\nRevert \"Bug 2030454 - Use export names when creating wasm module environment; r=arai\"\n\nThis reverts commit 603586052cd53ccfad4755dce2fc828f0b162820.\n\nRevert \"Bug 2030454 - Add wasm::GetModuleExportNames; r=rhunt\"\n\nThis reverts commit 764f05af26b5bd3083eb9d213f6f855963f5215d.\n\nRevert \"Bug 2030454 - Store requested modules on wasm module records; r=arai\"\n\nThis reverts commit 0948e64f91486b562f0fb5bdb143e85ace2d093c.\n\nRevert \"Bug 2030454 - Add wasm::GetModuleImports; r=rhunt\"\n\nThis reverts commit 7f08ff8b6e1a076cfa544bcc738704463b6defcb.\n\nRevert \"Bug 2030454 - Don't fetch dependencies for source-phase imports; r=arai,dom-worker-reviewers,edenchuang\"\n\nThis reverts commit 858ab3eb2c23b854f371a355456c7c8