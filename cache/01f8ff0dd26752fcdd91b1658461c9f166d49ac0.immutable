add53494"], "node": "930a514448245ddd1c71e1aef1cda78e19fe3512", "parents": ["cdb1db373d09f7ebaab5439614a31880f9a6a3da"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082844 - Implement a Guest Auth Provider for SmartWindow - part 5 - Show a temporarily unavailable message when Smart Window guest sign-in fails r=fluent-reviewers,omc-reviewers,pdahiya,bolsson,aminomancer,gazhibekova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335633\n", "files": ["browser/components/aboutwelcome/content/onboarding.ftl", "browser/components/aiwindow/models/auth/GuestAuthProviderImpl.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_auth_guest.js", "browser/components/aiwindow/ui/modules/ToUSpotlight.sys.mjs"], "git_node": "0f902b2db8275ae1c910f1dd7b0f61f7459f1b57", "git_parents": ["5cda3930736dd5fc6b334a72840f6bcdb9de4a50"], "node": "23bf2a37afe9fab59e976835024632877ac4fb59", "parents": ["930a514448245ddd1c71e1aef1cda78e19fe3512"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082844 - Implement a Guest Auth Provider for SmartWindow - part 6 - Guest vs FxA auth flow r=pdahiya,bjohns\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335073\n", "files": ["browser/components/aiwindow/models/AuthProvider.sys.mjs", "browser/components/aiwindow/models/auth/AuthImplSelector.sys.mjs", "browser/components/aiwindow/models/auth/AuthProviderImpl.sys.mjs", "browser/components/aiwindow/models/auth/FxaAuthProviderImpl.sys.mjs", "browser/components/aiwindow/models/auth/FxaSignedInWatcher.sys.mjs", "browser/components/aiwindow/models/auth/GuestAuthProviderImpl.sys.mjs", "browser/components/aiwindow/models/auth/moz.build", "browser/components/aiwindow/models/tests/browser/browser_auth_guest.js", "browser/components/aiwindow/models/tests/xpcshell/test_AuthImplSelector.js", "browser/components/aiwindow/models/tests/xpcshell/test_FxaSignedInWatcher.js", "browser/components/aiwindow/models/tests/xpcshell/xpcshell.toml", "browser/components/aiwindow/ui/aiwindow.manifest", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "0d307a17466601b324d36f75d6133ff28d67f073", "git_parents": ["0f902b2db8275ae1c910f1dd7b0f61f7459f1b57"], "node": "6d939c583e860283004cb78e3d7a9c8382e764fa", "parents": ["23bf2a37afe9fab59e976835024632877ac4fb59"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086007 - Detect a stale topsrcdir in config.status.json r=nalexander,geckoview-reviewers,android-build-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337012\n", "files": ["mobile/android/gradle/mozconfig.gradle"], "git_node": "cf0c84cabfd5bb6915b1957f4e3a9fb173ab7ed3", "git_parents": ["0d307a17466601b324d36f75d6133ff28d67f073"], "node": "1bf98db96bed14e295277f95ef31d39fccfd5232", "parents": ["6d939c583e860283004cb78e3d7a9c8382e764fa"], "tags": []}, {"author": "Dmitry Gozman \u003cdgozman@gmail.com\u003e", "branch": "default", "desc": "Bug 2083712 - Report a mouse for the pointer capabilities in headless GTK. r=emilio\n\nHeadlessLookAndFeel returns PointerCapabilities::None for\nPrimaryPointerCapabilities and AllPointerCapabilities, so headless\nFirefox on Linux matches (hover: none) and (pointer: none) and gets the\ntouch-only layout of every site that uses the interaction media\nfeatures. The headed GTK nsLookAndFeel doesn't implement these IDs at\nall, in which case nsMediaFeatures falls back to the desktop default,\nFine | Hover; headless on macOS and Windows use the native LookAndFeel\nand already report a mouse.\n\nReport Fine | Hover in headless GTK as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335122\n", "files": ["widget/headless/HeadlessLookAndFeelGTK.cpp"], "git_node": "b3d4109a77d8d03706e2c7710db51e4495d61cf3", "git_parents": ["cf0c84cabfd5bb6915b1957f4e3a9fb173ab7ed3"], "node": "784334bfaa10e52f332e23f735b1384fd1a20e0b", "parents": ["1bf98db96bed14e295277f95ef31d39fccfd5232"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2088235 - convert gradient type to enum class r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338878\n", "files": ["layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGradientFrame.cpp", "layout/svg/SVGGradientFrame.h"], "git_node": "f49a709e547d121d0a22e70bd0170f201554fbe5", "git_parents": ["b3d4109a77d8d03706e2c7710db51e4495d61cf3"], "node": "d34268f00fcd9b45b6d89172a1897323ecc629f8", "parents": ["784334bfaa10e52f332e23f735b1384fd1a20e0b"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079875 - Place AITab Highlights after the body content and render single or empty highlights as text. r=fluent-reviewers,cmurray,bolsson,omarg\n\nThe Highlights description in the component catalog is part of the\nprompt, so it now tells the model where Highlights goes. A Highlights\nblock with one statement looks like an empty card, so A2UI hydration\nturns it into a text block, and drops a Highlights block with no\nstatements. The stored surface and the model's conversation keep what\nthe model wrote, because a modification revises that surface.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336796\n", "files": ["browser/components/aiwindow/models/aitab/component_schema.json", "browser/components/aiwindow/ui/components/aitab-page/aitab-text-block/aitab-text-block.mjs", "browser/components/aiwindow/ui/modules/A2UI.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js", "browser/components/aiwindow/ui/test/xpcshell/test_A2UI.js"], "git_node": "b91c52ae026e8139defeb39b037c5fc24bc0c2b8", "git_parents": ["f49a709e547d121d0a22e70bd0170f201554fbe5"], "node": "c63c18fb52d01ca9bd09965b8fbc8abaaaac8249", "parents": ["d34268f00fcd9b45b6d89172a1897323ecc629f8"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086856 - Fix UI issues with text selection menu. r=fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,echa,jswinarton,tgiles,flod\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nWith the feature gate on, the three-dot menu, the strip, the Ask AI menu and the Copied confirmation use the prototype's layout and sizes, the menus open just below the strip, and the Ask AI input reads \"Ask AI\u2026\" when no chatbot name is known.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337832\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/locales/en-US/browser/genai.ftl", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "32fc38c2dfb3d1587603918978d28e9b3e64df63", "git_parents": ["b91c52ae026e8139defeb39b037c5fc24bc0c2b8"], "node": "4d544a95791f3b9b049bc84978002de63c926c72", "parents": ["c63c18fb52d01ca9bd09965b8fbc8abaaaac8249"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087595, Bug 2087597, Bug 2087591 - Add a stub Wrexham AFC widget to New Tab. r=fchasen,fluent-reviewers,bolsson\" for causing failure @ browser_wrexhamafc_widget.js\n\nThis reverts commit 75c059651a3bd78191060ec0bf6fb9f2b433b19b.\n\nRevert \"Bug 2087597 - Show a placeholder in a widget card that has no document. r=nina-py,fluent-reviewers,bolsson\"\n\nThis reverts commit 8ea34b353cb07af46d73424b7a51208e9ff8ffc7.\n\nRevert \"Bug 2087591 - Allow New Tab widget registry entries to add items to their card menu. r=fchasen\"\n\nThis reverts commit 744459603b08ae202bf128171fc7035dd3d25a98.\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/FramedWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/lib/utils.jsx", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_wrexhamafc_widget.js", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FramedWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MozWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsErrorBoundary.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/locales-preview/newtabPreview.ftl"], "git_node": "060c47bd4e0899b22ca3d1a56fe1499fc492b3ce", "git_parents": ["32fc38c2dfb3d1587603918978d28e9b3e64df63"], "node": "9da10dccdc900f5a685f54b11c3e8ec9d65371ab", "parents": ["4d544a95791f3b9b049bc84978002de63c926c72"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087830 - Report an error in hasSameBytecodeData when CheckedUnwrapDynamic fails r=spidermonkey-reviewers,mgaudet\n\nCheckedUnwrapDynamic returns null without reporting an exception when unwrapping is denied (e.g. for security wrappers created with newGlobal's `securityWrappers` option), so hasSameBytecodeData returned false with no pending exception. Report \"The arguments must be interpreted functions.\" in that case, as requested by iireland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338877\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/proxy/bug2087830.js"], "git_node": "703e1d6f871cc4c61592dc3f8ac79f54602bcd1a", "git_parents": ["060c47bd4e0899b22ca3d1a56fe1499fc492b3ce"], "node": "3d66ed298d08dfb4526260568886d78201dd5ae8", "parents": ["9da10dccdc900f5a685f54b11c3e8ec9d65371ab"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1752382 - Implement the match-parent value for CSS quotes. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338703\n", "files": ["layout/base/nsQuoteList.cpp", "layout/inspector/tests/test_bug877690.html", "layout/style/res/html.css", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/values/specified/list.rs", "testing/web-platform/tests/css/css-content/parsing/quotes-computed.html", "testing/web-platform/tests/css/css-content/parsing/quotes-invalid.html", "testing/web-platform/tests/css/css-content/parsing/quotes-valid.html", "testing/web-platform/tests/css/css-content/quotes-030.html", "testing/web-platform/tests/css/css-content/quotes-match-parent-001.html", "testing/web-platform/tests/css/css-content/reference/quotes-030-ref.html", "testing/web-platform/tests/css/css-content/reference/quotes-match-parent-001-ref.html"], "git_node": "e85820044b027bd4ad4478791400f59eb1ba0625", "git_parents": ["703e1d6f871cc4c61592dc3f8ac79f54602bcd1a"], "node": "4d228376bceae86515aa256c549b9a989d22b103", "parents": ["3d66ed298d08dfb4526260568886d78201dd5ae8"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071092 - Hash the run-task a task actually runs into its checkout cache name r=taskgraph-reviewers,bhearsum,ahal\n\nCheckout cache names carry a hash of run-task so that a new run-task never\ninherits a cache an older one left behind. The hash was picked by the\nrepository type of the push, hg on autoland, so a task that clones with git ran\nrun-task-git but was keyed on run-task-hg, and a change to the git run-task\nnever gave those tasks fresh caches.\n\nLater commits teach run-task to give git tasks sparse checkouts and to share\none checkout cache per worker pool between sparse and full tasks. A cache only\never widens there: a full task on a sparse cache switches it to a full\ncheckout, and a sparse task on a cache with a different profile adds its\npatterns. An older run-task knows none of that. Handed a cache a newer one\nleft sparse, it would run a full task on the sparse tree without noticing,\nwith source files missing and no error. Two run-task versions must therefore\nnever share a cache, and the hash has to be the one of the run-task the task\nactually runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325174\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "3bf616aa79f274a086c64d0348884d0d4fcf3c28", "git_parents": ["e85820044b027bd4ad4478791400f59eb1ba0625"], "node": "76ce84ea6fc6d0bb496f77005e3f4fc0ad84e0e4", "parents": ["4d228376bceae86515aa256c549b9a989d22b103"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071092 - Add the run-task hash to generic-worker checkout caches too r=taskgraph-reviewers,bhearsum,ahal\n\nDocker-worker caches carry a version and a hash of run-task in their name, so\ntwo run-task versions never share a cache. Generic-worker caches, which is\nevery Windows and macOS task and the Linux device pools, were named plainly,\n`checkouts` with nothing after it, so that guarantee never held there. The\ncache audit only looked at docker-worker caches and at commands given as a\nlist, so it could not notice, and it skipped the flags inside the single\ncommand line string Windows tasks get.\n\nGeneric-worker caches of run-task tasks now get the same suffix, and the audit\nreads cache mounts and the joined command line as well.\n\nEvery generic-worker run-task cache changes name once when this lands, so each\nWindows and mac worker does one cold clone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325175\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "5e67b544da1d43ca3c24ae79a10acc22b5303588", "git_parents": ["3bf616aa79f274a086c64d0348884d0d4fcf3c28"], "node": "513c9359becb0574803e249afe38fa5aee055e5f", "parents": ["76ce84ea6fc6d0bb496f77005e3f4fc0ad84e0e4"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 1970924 - Propagate user.displayName for MakeCredential r=jschanck\n\nThis propagates the `displayName` field of `PublicKeyCredentialEntity` in\nCTAP2 `MakeCredential` requests.\n\nThese fields may be used on authenticators with screens or the caBLE\ntransport, and will show up on resident keys when using credential\nmanagement commands.\n\nThis also limits the length of the `name` and `displayName` fields to 64\nUTF-8 bytes, breaking on grapheme cluster boundaries, per WebAuthn-3 \u00a76.4.1:\n\nhttps://w3c.github.io/webauthn/#sctn-strings-truncation\n\nFirefox didn't limit the length of the `name` sent to an authenticator,\nwhich could cause it to reject the request or to truncate it in a\nsub-optimal way (eg: only on UTF-8 codepoint boundaries).  This is more\nlikely to happen with `displayName` than `name`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337448\n", "files": ["Cargo.lock", "dom/webauthn/authenticator/Cargo.toml", "dom/webauthn/authenticator/src/ctap2/server.rs", "dom/webauthn/authrs_bridge/src/lib.rs"], "git_node": "926820629d251a9a65ea8721a9147e7891d53c67", "git_parents": ["5e67b544da1d43ca3c24ae79a10acc22b5303588"], "node": "f95195df1d5e2c7a23d040986201abdf3dbb600b", "parents": ["513c9359becb0574803e249afe38fa5aee055e5f"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088130 - Assign Backup component triage ownership rotation duties to Yazan Al Macki. r=kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338787\n", "files": ["browser/components/backup/triage.json"], "git_node": "71c577c5f4b5ec2661669c0189327fe399b0c4ac", "git_parents": ["926820629d251a9a65ea8721a9147e7891d53c67"], "node": "3200c1315a47f91174f5b6b647a6db0f2eb8c3ee", "parents": ["f95195df1d5e2c7a23d040986201abdf3dbb600b"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2083590 - Reuse attribute removal lookups. r=dom-core-reviewers,vhilla\n\nReuse removal lookups and use main-thread atomization for dataset deletion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334875\n", "files": ["dom/base/Attr.cpp", "dom/base/Attr.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsDOMAttributeMap.h", "dom/html/nsDOMStringMap.cpp"], "git_node": "12628893f92f6a8bace33a34b643e931e85c0837", "git_parents": ["71c577c5f4b5ec2661669c0189327fe399b0c4ac"], "node": "76fcc076d211b63cde15450bc5f7b787b6178b2f", "parents": ["3200c1315a47f91174f5b6b647a6db0f2eb8c3ee"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086804 - Default New Tab custom shortcut URLs to https instead of http when no scheme is typed. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338006\n", "files": ["browser/extensions/newtab/content-src/components/TopSites/TopSiteForm.jsx", "browser/extensions/newtab/test/jest/content-src/components/TopSites/TopSiteForm.test.jsx"], "git_node": "040821a2800d0aa0e5cc0c5b3b5ac7771e52dff1", "git_parents": ["12628893f92f6a8bace33a34b643e931e85c0837"], "node": "d7012b4e9201281473ee523ac3a65f22303b49f8", "parents": ["76fcc076d211b63cde15450bc5f7b787b6178b2f"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079950 - Write the R8 mapping UUID to a build-metadata.properties asset. r=android-reviewers,geckoview-reviewers,nalexander,android-build-system-reviewers,ahochheiden\n\nIn order to symbolicate Kotlin stacks in crash-reporting or profiling, we need\nan idenfier to be able to look up the R8/proguard mapping file. This follows\nthe rough approach of Sentry Gradle Plugin of storing into a metadata.properties\nasset file and transforming the pg_map_hash value from mapping.txt into a\nUUIDv3. Both the pg_map_hash (generated by R8) and the UUID are saved for\nflexibility if we want to change how we label things in the future. Either form\ncan be derived again from published AAB file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332287\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/focus-android/app/build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/WriteBuildMetadata.kt"], "git_node": "3adfa18fd4e7ed20d293452d8706de0bf415bbe9", "git_parents": ["040821a2800d0aa0e5cc0c5b3b5ac7771e52dff1"], "node": "c5591197e4893014b3c2b65530daaf7207c5770e", "parents": ["d7012b4e9201281473ee523ac3a65f22303b49f8"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079950 - Read the R8 debug mapping UUID on startup. r=android-reviewers,nalexander\n\nAdds BuildMetadata to support-utils. Fenix reads it once at startup, when\nAnalytics is created during crash reporter setup, and keeps it as\ncomponents.buildMetadata. In the future socorro, crashping, sentry, and gecko\nprofiler will consume so their Kotlin stacks can be symbolicated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332288\n", "files": ["mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/utils/BuildMetadata.kt", "mobile/android/android-components/components/support/utils/src/test/java/mozilla/components/support/utils/BuildMetadataTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Analytics.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/FocusApplication.kt"], "git_node": "97403cb7a1ccea7a20a7ba2fbbc8859be95d429a", "git_parents": ["3adfa18fd4e7ed20d293452d8706de0bf415bbe9"], "node": "0c60b10d1d38f697b0edc7805deb6f57efb9886d", "parents": ["c5591197e4893014b3c2b65530daaf7207c5770e"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088267 - vendor webrtc-sdp to 0.3.17;r=mjf,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338953\n", "files": ["Cargo.lock", "dom/media/webrtc/sdp/rsdparsa_capi/Cargo.toml", "supply-chain/audits.toml", "third_party/rust/webrtc-sdp/.cargo-checksum.json", "third_party/rust/webrtc-sdp/.cargo_vcs_info.json", "third_party/rust/webrtc-sdp/CHANGELOG.md", "third_party/rust/webrtc-sdp/Cargo.lock", "third_party/rust/webrtc-sdp/Cargo.toml", "third_party/rust/webrtc-sdp/Cargo.toml.orig", "third_party/rust/webrtc-sdp/src/lib.rs", "third_party/rust/webrtc-sdp/src/lib_tests.rs", "third_party/rust/webrtc-sdp/src/media_type.rs", "third_party/rust/webrtc-sdp/src/media_type_tests.rs", "third_party/rust/webrtc-sdp/tests/parse_sdp_tests.rs"], "git_node": "eab1f2fc83d6ca6649d863228bf0699b5df303b9", "git_parents": ["97403cb7a1ccea7a20a7ba2fbbc8859be95d429a"], "node": "55eb78c22dc39e5dbc64e5a034ec0009ef577c39", "parents": ["0c60b10d1d38f697b0edc7805deb6f57efb9886d"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088057 - add sdp gtest for i line;r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338992\n", "files": ["media/webrtc/signaling/gtest/sdp_unittests.cpp"], "git_node": "9dbb16fa65fee9aa91a86099f33c5be97e08c535", "git_parents": ["eab1f2fc83d6ca6649d863228bf0699b5df303b9"], "node": "4a4b06edb7aa31ead84622dd64695984238a2f94", "parents": ["55eb78c22dc39e5dbc64e5a034ec0009ef577c39"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2088057, 2088267: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["media/webrtc/signaling/gtest/sdp_unittests.cpp"], "git_node": "bab7043ddbb59819fb6477f4547194f72d53d4f9", "git_parents": ["9dbb16fa65fee9aa91a86099f33c5be97e08c535"], "node": "59f5532ddf0ae7e7640dc22e577920d9de3ff577", "parents": ["4a4b06edb7aa31ead84622dd64695984238a2f94"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087159 - Stop mirroring telemetry for ScriptPreloader. r=arai,chumphreys\n\nThe telemetry is still gathered in Glean and this only impacts the now-unused\nlegacy telemetry datasets. There were no existing tests for the legacy mirrors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338048\n", "files": ["js/xpconnect/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "e2a1a35f29a1b9ee240e85a6858a19f7271c5ebf", "git_parents": ["bab7043ddbb59819fb6477f4547194f72d53d4f9"], "node": "4fa57c1a2821c70d68c569d4b0c661ee24dc32f4", "parents": ["59f5532ddf0ae7e7640dc22e577920d9de3ff577"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084392 - Don't start a widget drag from inside its context menu r=fchasen\n\nPressing and dragging inside an open widget context menu moved the\nwidget underneath it. A press inside the context menu or on its button\nno longer starts a widget drag, for `moz-widget` widgets too. Test\ncoverage has been updated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338649\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/useWidgetDnD.jsx", "browser/extensions/newtab/content-src/lib/usePointerReorder.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useWidgetDnD.test.jsx"], "git_node": "c5135b0c93c99556d1e83cfc6a3c3031725adebb", "git_parents": ["e2a1a35f29a1b9ee240e85a6858a19f7271c5ebf"], "node": "5187e25d360c16453eb1cfa3e3f4a34204abe698", "parents": ["4fa57c1a2821c70d68c569d4b0c661ee24dc32f4"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2001164 - Keep the 2D context's buffer provider across OffscreenCanvas.transferToImageBitmap. r=gfx-reviewers,lsalzman\" at dev request for causing Bug 2088063\n\nThis reverts commit ef97d0cba6f43fc2d9ce0ee3568fb61c54a57411.\n", "files": ["dom/canvas/OffscreenCanvas.cpp", "dom/canvas/test/test_offscreencanvas_toimagebitmap.html"], "git_node": "254ad693f11f3906b4fd4f140ec68759fa537e16", "git_parents": ["c5135b0c93c99556d1e83cfc6a3c3031725adebb"], "node": "e4da93f7d619827ff22baa50749b4cf474ccda41", "parents": ["5187e25d360c16453eb1cfa3e3f4a34204abe698"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": [], "git_node": "d73e5c421ab328c98492554a9dd73e09a733c76c", "git_parents": ["112b98932d21154eb1c2019faedbe336edac4ab6", "254ad693f11f3906b4fd4f140ec68759fa537e16"], "node": "384eb3f1527ab4c08dfb0c16b516afd26054f268", "parents": ["7425b02c0ba4bc4ad507077c52dcb855856f8a09", "e4da93f7d619827ff22baa50749b4cf474