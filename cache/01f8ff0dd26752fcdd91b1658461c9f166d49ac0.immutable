onfig/home-startup.mjs", "browser/components/preferences/main.js"], "git_node": "03c426c3dbc37d7f41ab47347872ad3f85d86c07", "git_parents": ["8e814812f23e7359a6f4c1b164fb7f5789fa5e3d"], "node": "ede946f8423aa85a8c965df8cd0cd28f84b0e913", "parents": ["299f5812a3615e999bd895960f820f9ea53089c1"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079894 - move createDefaultBrowserConfig out of main.js r=settings-reviewers,mconley\" for causing bc failures with startup-windows-launch-on-login-profile-disabled\n\nThis reverts commit 64addbb5da4aaa92eff676e885a15c8d625c0816.\n", "files": ["browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/config/default-browser.mjs", "browser/components/preferences/config/home-startup.mjs", "browser/components/preferences/jar.mn", "browser/components/preferences/main.js"], "git_node": "b7c19c9e7f43e94e052fdf1c546adb69a099afdf", "git_parents": ["03c426c3dbc37d7f41ab47347872ad3f85d86c07"], "node": "dd9235651d3c0a788be054f86e83c7d960b1ad08", "parents": ["ede946f8423aa85a8c965df8cd0cd28f84b0e913"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059669 - Add gradient for sun theme preview in dark mode r=desktop-theme-reviewers,hjones,mossop\" for causing failures at test_theme_picker.html.\n\nThis reverts commit 2d190e0fa90ad54aa69a9b4cb6da9c3f9e080f42.\n", "files": ["browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_test.js", "browser/themes/ThemesList.sys.mjs", "browser/themes/test/unit/test_ThemesList.js"], "git_node": "3974310818647a6d410d68eeb415f533eacf25a0", "git_parents": ["b7c19c9e7f43e94e052fdf1c546adb69a099afdf"], "node": "8d57e5956bc84c3e517086f5d0f8f5617d54352d", "parents": ["dd9235651d3c0a788be054f86e83c7d960b1ad08"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1996471 - Close the tab hover preview before browser_tab_splitview_contextmenu.js moves the tab strip, r=tabbrowser-reviewers,sthompson.\"\n\nThis reverts commit baa998d0ad9a55506541dcbec4210e3d2190497e.\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_contextmenu.js"], "git_node": "0603017f99e03a40b697866562ea032206045058", "git_parents": ["3974310818647a6d410d68eeb415f533eacf25a0"], "node": "a8c4b624e46c59b404299551e3fdb46717b7302f", "parents": ["8d57e5956bc84c3e517086f5d0f8f5617d54352d"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087119 - Register and unregister tab notes window listeners without waiting for the database, r=tabbrowser-reviewers,sthompson.\"\n\nThis reverts commit 75fcba685a34f24f98e8cad94c4ea933680747f6.\n", "files": ["browser/components/tabnotes/TabNotes.sys.mjs", "browser/components/tabnotes/TabNotesController.sys.mjs"], "git_node": "7e7cec125bd9f2392d9f4cd0fcdfbc8ef2fd1eb2", "git_parents": ["0603017f99e03a40b697866562ea032206045058"], "node": "7998c625d98dd071574e9fea693b1c4929e79769", "parents": ["a8c4b624e46c59b404299551e3fdb46717b7302f"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087103 - Wait for running chrome animations before testing promiseDocumentFlushed, r=mconley.\"\n\nThis reverts commit d427bb59c3e8f7a4341359a8f18f8e9ed5b2fb49.\n", "files": ["dom/base/test/browser_promiseDocumentFlushed.js"], "git_node": "cfe62a660bf90f9b93ba85b5a2fb909e4694bdb7", "git_parents": ["7e7cec125bd9f2392d9f4cd0fcdfbc8ef2fd1eb2"], "node": "c3a9cc5b4b0c335e7eff3bbcd7a2998e7b2bf9e9", "parents": ["7998c625d98dd071574e9fea693b1c4929e79769"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084383 - Keep the pinned tabs when the fire button closes the windows to delete browsing data. r=manuel,nsharpley\n\nWhen the fire button's panel deletes everything, it closes every\nwindow and opens a new one, so the pinned tabs were lost.\n\nThe openWindows cleaner gets a keepPinnedTabs option, which the panel\npasses. Before closing the windows, it takes the session store state\nof the pinned tabs of the non-private windows, and removes what\ndeleting should get rid of: the back and forward history, what the\npages stored, and what was typed in the address bar.\n\nOnce everything else is cleared, the tabs are restored into the new\nwindow, unloaded. They keep the referrer, triggering principal,\ncontainer, mute state and icon of their current page. A tab that\nfails to restore is skipped.\n\nThe Forget button is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336005\n", "files": ["browser/base/content/test/browser-sanitize/browser.toml", "browser/base/content/test/browser-sanitize/browser_sanitize-keepPinnedTabs.js", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/test/browser_fireButton.js", "browser/modules/Sanitizer.sys.mjs"], "git_node": "b1c59d105b80b2524d7be8f6ee1ddbe41a7c2a03", "git_parents": ["cfe62a660bf90f9b93ba85b5a2fb909e4694bdb7"], "node": "1d9195dc7ff31efb441eef2f71d3af9c4ec8d7b2", "parents": ["c3a9cc5b4b0c335e7eff3bbcd7a2998e7b2bf9e9"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007825: Necko side of adding anticipatedConcurrentIncomingUni/BidirectionalStreams r=necko-reviewers,webidl,saschanaz,kershaw,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283502\n", "files": ["dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h", "ipc/glue/PBackground.ipdl", "netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportSession.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportSession.h", "netwerk/protocol/http/WebTransportSessionBase.h", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.h", "netwerk/protocol/webtransport/nsIWebTransport.idl", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/gtest/TestHttp3ConnectUDPStream.cpp"], "git_node": "544fdfacf5f487aa62a2be7548a9d64eebcd6729", "git_parents": ["b1c59d105b80b2524d7be8f6ee1ddbe41a7c2a03"], "node": "c3651f4e709f06255ab0314d5ed5e12137434095", "parents": ["1d9195dc7ff31efb441eef2f71d3af9c4ec8d7b2"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007825: Implement the DOM portion of anticipatedConcurrentIncomingUni/BidirectionalStreams r=webidl,saschanaz,necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283501\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "dom/webtransport/child/WebTransportChild.cpp", "dom/webtransport/child/WebTransportChild.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "dom/webtransport/shared/PWebTransport.ipdl", "testing/web-platform/meta/webtransport/anticipated-concurrent-incoming-streams.https.any.js.ini", "testing/web-platform/meta/webtransport/anticipated-streams.https.any.js.ini", "testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini"], "git_node": "7e95428f350d68c08cdedaf01049ff8467378a15", "git_parents": ["544fdfacf5f487aa62a2be7548a9d64eebcd6729"], "node": "11a3701eb3ae4ed5a7b1531769df8a667aa91de7", "parents": ["c3651f4e709f06255ab0314d5ed5e12137434095"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080556: apply WebTransport anticipatedConcurrentIncoming*Streams when the CONNECT is sent r=necko-reviewers,valentin\n\nThe hints were only passed to neqo from OnSessionReadyInternal(), after the CONNECT response, so a server opening streams right after its 200 waited up to a round trip for the MAX_STREAMS update.  neqo accepts the hint for a session that is still negotiating, and the session id is known as soon as CreateWebTransport succeeds in Http3Session::TryActivating.\n\nAdd a listener method returning the hints, reach it through the transaction, and apply any non-zero value there.  OnSessionReadyInternal() still applies them for values set after the CONNECT went out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333502\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/nsIWebTransport.idl", "netwerk/test/gtest/TestHttp2WebTransport.cpp"], "git_node": "e0232b648a29176e8d85626a0b0fcd47be6d08aa", "git_parents": ["7e95428f350d68c08cdedaf01049ff8467378a15"], "node": "53e31a9a4a020b0008982b2c75290959d0b02a0e", "parents": ["11a3701eb3ae4ed5a7b1531769df8a667aa91de7"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086613: List shortcut modifiers in the macOS order: Control, Option, Shift, Command. r=firefox-desktop-core-reviewers ,mossop\n\nShortcutUtils listed Shift, Option, Control, which differs from the native macOS menus, so about:keyboard and the toolbar menus showed shortcuts in a different order than the menu bar and System Settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337841\n", "files": ["browser/components/customkeys/tests/browser/head.js", "toolkit/modules/ShortcutUtils.sys.mjs", "toolkit/modules/tests/browser/browser.toml", "toolkit/modules/tests/browser/browser_ShortcutUtils_modifierOrder.js"], "git_node": "1fa30d6f23c90b0be2e0e07296d65fdbc1a66a75", "git_parents": ["e0232b648a29176e8d85626a0b0fcd47be6d08aa"], "node": "b18d980b014e1d584fb913560f5a69f311a38212", "parents": ["53e31a9a4a020b0008982b2c75290959d0b02a0e"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087257 - Bump IntelliSense to use C++20. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338129\n", "files": ["python/mozbuild/mozbuild/backend/visualstudio.py"], "git_node": "b08643605b4963e83d44c24c616bb8966c3b784b", "git_parents": ["1fa30d6f23c90b0be2e0e07296d65fdbc1a66a75"], "node": "1ee091996f3e472d1fcbac65e09309a34878ee42", "parents": ["b18d980b014e1d584fb913560f5a69f311a38212"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077355 - Always give about:blank documents a policy container. r=vhilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338050\n", "files": ["docshell/base/nsDocShell.cpp", "dom/ipc/ContentChild.cpp"], "git_node": "0c0960aae91ac1499c909abbb72c57e9c81bd094", "git_parents": ["b08643605b4963e83d44c24c616bb8966c3b784b"], "node": "407dc1de5c5e8a83c97a044cff5acada9d68a6ef", "parents": ["1ee091996f3e472d1fcbac65e09309a34878ee42"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077355 - Null-check the CSP in PerformTrustedTypesPreNavigationCheck. r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338051\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "50673387440dafde0227e72a1cb1088f208b0d96", "git_parents": ["0c0960aae91ac1499c909abbb72c57e9c81bd094"], "node": "dc5b8b5f46ff9dde4885e4a665d07e9a9abbb01e", "parents": ["407dc1de5c5e8a83c97a044cff5acada9d68a6ef"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086990 - [devtools] Avoid creating intermediary array objects when dealing with Iterators. r=devtools-reviewers,ochameau.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337903\n", "files": ["devtools/client/aboutdebugging/src/types/ui.js", "devtools/client/framework/test/browser_toolbox_options.js", "devtools/client/framework/toolbox.js", "devtools/client/inspector/rules/models/element-style.js", "devtools/client/inspector/shared/highlighters-overlay.js", "devtools/client/netmonitor/src/selectors/requests.js", "devtools/client/responsive/manager.js", "devtools/client/shared/components/object-inspector/components/ObjectInspector.js", "devtools/client/shared/remote-debugging/remote-client-manager.js", "devtools/client/shared/widgets/TreeWidget.js", "devtools/server/actors/compatibility/lib/MDNCompatibility.js", "devtools/server/actors/object/property-iterator.js", "devtools/server/actors/resources/network-events-content.js", "devtools/server/actors/resources/storage/cache.js", "devtools/server/actors/resources/storage/indexed-db.js", "devtools/server/actors/thread.js", "devtools/server/actors/utils/sources-manager.js", "devtools/shared/commands/target/target-command.js", "devtools/shared/webconsole/js-property-provider.js"], "git_node": "df577922b455ffd0ac40df5c41d0ea0539aeb688", "git_parents": ["50673387440dafde0227e72a1cb1088f208b0d96"], "node": "958815ad0a420e1e2465830f5d0f0d3dcc804242", "parents": ["dc5b8b5f46ff9dde4885e4a665d07e9a9abbb01e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086334 - use the public libwebrtc repo to show branch-head commits. r=dbaker\n\nQuerying webrtc.googlesource.com directly avoids having to clone or\nrestore a local copy of libwebrtc just to list branch-head commits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337359\n", "files": ["dom/media/webrtc/third_party_build/check_missing_branch_head_commits.py", "dom/media/webrtc/third_party_build/show_branch_head_commits.py"], "git_node": "d32b3cffa9f29217701257fe2cf60e5d519cde08", "git_parents": ["df577922b455ffd0ac40df5c41d0ea0539aeb688"], "node": "8640782944896f5074c67609739a2f418f6aad86", "parents": ["958815ad0a420e1e2465830f5d0f0d3dcc804242"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086334 - allow ignoring missing branch-head commits per Firefox version. r=dbaker\n\nSome branch-head commits are intentionally not taken on a given Firefox\nrelease, so they should not keep being reported as missing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337360\n", "files": ["dom/media/webrtc/third_party_build/check_missing_branch_head_commits.py", "dom/media/webrtc/third_party_build/ignored_branch_head_commits.json"], "git_node": "fab0eb519d3c20125f448a79305c88cd048880b3", "git_parents": ["d32b3cffa9f29217701257fe2cf60e5d519cde08"], "node": "b8071b1fca102ee16f6177946c704d0dc6759d21", "parents": ["8640782944896f5074c67609739a2f418f6aad86"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086335 - fix tar/gc issues in fetch_github_repo.py r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337361\n", "files": ["dom/media/webrtc/third_party_build/fetch_github_repo.py"], "git_node": "390eb0eb615723d0a06d88b3e8f658aa357c08cc", "git_parents": ["fab0eb519d3c20125f448a79305c88cd048880b3"], "node": "587cc6eb656090aeed2c4cf2ba94bbab1685108d", "parents": ["b8071b1fca102ee16f6177946c704d0dc6759d21"], "tags": []}, {"author": "Tyson Smith \u003ctwsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084054 - Update grizzly-framework to 1.4.0 for the fuzzing smoke test. r=mach-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338162\n", "files": ["tools/fuzzing/smoke/grizzly_requirements.in", "tools/fuzzing/smoke/grizzly_requirements.txt", "tools/fuzzing/smoke/test_grizzly.py"], "git_node": "4a4ea238398aba6fb91273d28720c56a81eb8571", "git_parents": ["390eb0eb615723d0a06d88b3e8f658aa357c08cc"], "node": "d55f58ed29420700bf94d86aece3e520c6359bbf", "parents": ["587cc6eb656090aeed2c4cf2ba94bbab1685108d"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072767 - restore handling of unknown media types for webrtc-sdp;r=dbaker,bwc\n\nThis reverts an earlier commit which disabled unknown media type handling in webrtc-sdp.\nThis is done in preperation to handle unknown media types in JSEP.\n\nThis reverts commit fd91c147ba52436b225265b4db1cdd8f5ce34132.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334304\n", "files": ["dom/media/webrtc/sdp/RsdparsaSdpParser.cpp", "dom/media/webrtc/sdp/rsdparsa_capi/src/lib.rs", "media/webrtc/signaling/gtest/sdp_unittests.cpp", "testing/web-platform/meta/webrtc/protocol/unknown-mediatypes.html.ini"], "git_node": "6960b48f955cf68bd8162e85cf025ba6e526fe7e", "git_parents": ["4a4ea238398aba6fb91273d28720c56a81eb8571"], "node": "5f32aea1c95056ed6d9cd1e9d3a9296790f8dc68", "parents": ["d55f58ed29420700bf94d86aece3e520c6359bbf"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072767 - set port=0 in m-sections with unknown media types in answers;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334305\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepTrack.cpp", "dom/media/webrtc/sdp/SdpHelper.cpp", "dom/media/webrtc/sdp/SdpMediaSection.h", "dom/media/webrtc/sdp/SdpMediaSectionImpl.