ault", "desc": "Bug 2085004 - Schedule tasks on mozilla-firefox/firefox-dev-secure, r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336269\n", "files": [".taskcluster.yml", "taskcluster/gecko_taskgraph/decision.py"], "git_node": "441d0463696ff5f4bb765a1ec748b7a2bd72ea88", "git_parents": ["ccbd768c840352063b626b2687ca6d60a9b9c0af"], "node": "955004bc1812a26450b25519d0f8a2577cb7724f", "parents": ["c19a0cc605d2b38b883fd1481d95d8895328656d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084575 - Re-enable tests disabled on debug, opt or asan builds that pass there on try. r=aryx,webdriver-reviewers,credential-management-reviewers,permissions-reviewers,layout-reviewers,whimboo,timhuang,tnikkel,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336652\n", "files": ["browser/base/content/test/browser-caps/browser.toml", "browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-pageinfo/browser.toml", "browser/base/content/test/browser-permissions/browser.toml", "browser/base/content/test/browser-popups/browser.toml", "browser/base/content/test/browser-webrtc/browser.toml", "browser/components/aboutlogins/tests/browser/browser.toml", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_oldformat.toml", "browser/extensions/webcompat/tests/browser/browser.toml", "devtools/client/framework/test/browser_destroying_iframes.toml", "devtools/client/webconsole/test/browser/_browser_console.toml", "devtools/shared/network-observer/test/browser/browser.toml", "docshell/test/browser/browser.toml", "dom/base/test/mochitest.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-rendering.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-rendering.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/events/test/mochitest.toml", "dom/ipc/tests/browser.toml", "dom/media/webaudio/test/mochitest.toml", "dom/security/test/csp/mochitest.toml", "dom/security/test/general/chrome.toml", "dom/security/test/general/mochitest.toml", "dom/security/test/referrer-policy/browser.toml", "extensions/permissions/test/browser.toml", "gfx/tests/mochitest/mochitest.toml", "layout/base/tests/browser.toml", "netwerk/test/mochitests/mochitest.toml", "remote/shared/messagehandler/test/browser/browser_timeout.toml", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/terminator/tests/xpcshell/xpcshell.toml", "tools/profiler/tests/xpcshell/xpcshell.toml"], "git_node": "593eefcb55f6dc6446da5549594a4544ead41178", "git_parents": ["441d0463696ff5f4bb765a1ec748b7a2bd72ea88"], "node": "0fe0966c56d117c2def338edb0676116d5b328cc", "parents": ["955004bc1812a26450b25519d0f8a2577cb7724f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2084575 - Narrow skip-if conditions on debug, opt or asan builds to the configurations where the tests fail. r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336653\n", "files": ["docshell/test/navigation/mochitest.toml", "dom/security/test/mixedcontentblocker/mochitest.toml", "dom/serviceworkers/test/mochitest-common.toml"], "git_node": "bf99d597eabb42c5a9812781f3dfe32c6d7584fe", "git_parents": ["593eefcb55f6dc6446da5549594a4544ead41178"], "node": "51ad90f35a4ac3d1ce4904c3ec03e1870072a479", "parents": ["0fe0966c56d117c2def338edb0676116d5b328cc"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079715 - Check for content type before using content type hint r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336386\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "3cefc2e7ff220c10ed2ec641ba304c1ea0d281fe", "git_parents": ["bf99d597eabb42c5a9812781f3dfe32c6d7584fe"], "node": "4b8be7b4f502a57433fbfa43067030f1c29b521a", "parents": ["51ad90f35a4ac3d1ce4904c3ec03e1870072a479"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085803 - Enable Picture of the Day \"Set as wallpaper\" by default. r=mconley\n\nFlip the default of browser.newtabpage.activity-stream.widgets.pictureOfTheDay.setAsWallpaper.enabled to true\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336755\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs"], "git_node": "fd0828cd8b54c64a3443225bb10c4d5bee315234", "git_parents": ["3cefc2e7ff220c10ed2ec641ba304c1ea0d281fe"], "node": "d9997f7a9e7702bd21e9d1b3f25514f639b12a4b", "parents": ["4b8be7b4f502a57433fbfa43067030f1c29b521a"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077353 - keep favicon image processing out of the parent in the broken site reporter UI; r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336247\n", "files": ["browser/components/reportbrokensite/test/browser/browser_url_widgets.js", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs"], "git_node": "c326a39a451a1574863c48607bdbfd16ef7c4efb", "git_parents": ["fd0828cd8b54c64a3443225bb10c4d5bee315234"], "node": "536caf61485f954ef7b20b94377eb09f8f97affe", "parents": ["d9997f7a9e7702bd21e9d1b3f25514f639b12a4b"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2084617 - Refactor 2- and 3-operand BigInt digitAdd, digitSub r=mgaudet\n\nA three-operand digitAdd/digitSub makes the compiler emit better code\nand cleans up call sites.  It also allows two-operand digitAdd and\ndigitSub to assign their carry output rather than incrementing it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335980\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "527356dc20a80bdce100b48d6617b3fc07f6fca3", "git_parents": ["c326a39a451a1574863c48607bdbfd16ef7c4efb"], "node": "68530d031ec06cbf5038ea2da891bfca3ebdf09c", "parents": ["536caf61485f954ef7b20b94377eb09f8f97affe"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084061: Fix existing string-formatting warnings in `moz.configure`. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336503\n", "files": ["moz.configure"], "git_node": "c6f8a397348cada08a6c73d678d006bbfd766e01", "git_parents": ["527356dc20a80bdce100b48d6617b3fc07f6fca3"], "node": "3a7822e4bfcc030292995184560f17d26c0dc560", "parents": ["68530d031ec06cbf5038ea2da891bfca3ebdf09c"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2079321 - Support referrerpolicy on script and image elements r=emilio,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336403\n", "files": ["dom/svg/SVGFEImageElement.cpp", "dom/svg/SVGFEImageElement.h", "dom/svg/SVGImageElement.cpp", "dom/svg/SVGImageElement.h", "dom/svg/SVGScriptElement.cpp", "dom/svg/SVGScriptElement.h", "dom/svg/test/mochitest.toml", "dom/svg/test/test_bug2079321.html", "dom/webidl/SVGFEImageElement.webidl", "dom/webidl/SVGImageElement.webidl", "dom/webidl/SVGScriptElement.webidl", "testing/web-platform/tests/svg/interact/scripted/script-referrerpolicy-idl.html"], "git_node": "f0f657f95e2d8b461bae4bba7364163f1d6d1efd", "git_parents": ["c6f8a397348cada08a6c73d678d006bbfd766e01"], "node": "20300f30130a6bc228ecfaf74df7eaa1de8e95cf", "parents": ["3a7822e4bfcc030292995184560f17d26c0dc560"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2081829 - Add a Nimbus feature to re-enable autofill, password management, and credential sync on Android Automotive OS r=twhite\n\nAdds the `automotive-sensitive-data` Nimbus feature, off by default. On Android Automotive OS it enables or disables password, credit card and address autofill, password management, and password and credit card sync. It has no effect on other devices.\n\n`Settings.isAutofillSupported` now combines the Automotive check with the feature and is the single source of truth. Everything that already read it follows the feature, including the autofill settings, the main menu passwords entry, the logins deeplink, settings search, and the `AutofillService` component. `BackgroundServices` and `AccountSettingsFragment` now read it too, instead of checking for Automotive themselves.\n\nAddress autofill is controlled by the same feature rather than being enabled separately.\n\nTry: https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=107416\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/400\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/BackgroundServices.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/BackgroundServicesTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "65b02addc9227999c41fa45bfac15478bb1bd355", "git_parents": ["f0f657f95e2d8b461bae4bba7364163f1d6d1efd"], "node": "20acd25e27058cff67c0ac7fce2a1ce0eb01a9fa", "parents": ["20300f30130a6bc228ecfaf74df7eaa1de8e95cf"], "tags": []}, {"author": "gazhibekova-hub \u003cgazhibekova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074214 - Provide location data for Smart Window weather integration r=bjohns,flozia,thasan,urlbar-reviewers,baku,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328915\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/SmartWindowLocation.sys.mjs", "browser/components/aiwindow/models/moz.build", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js", "browser/components/aiwindow/models/tests/browser/browser_smartwindow_location.js", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/urlbar/private/GeolocationUtils.sys.mjs", "browser/components/urlbar/tests/unit/test_geolocationUtils.js"], "git_node": "9e422dd058f421d19b67295cb5cfac0f44138dc3", "git_parents": ["65b02addc9227999c41fa45bfac15478bb1bd355"], "node": "ac65b226de3ad47f865ab8df907157e6bc5d06bb", "parents": ["20acd25e27058cff67c0ac7fce2a1ce0eb01a9fa"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes mobile-experiments ct-logs r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336777\n", "files": ["mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "a440a193e7d195088204e27639aade24ca914105", "git_parents": ["9e422dd058f421d19b67295cb5cfac0f44138dc3"], "node": "433046cffd327c793f2a2914e30ce9811c9161ba", "parents": ["ac65b226de3ad47f865ab8df907157e6bc5d06bb"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084256 - Remove the version 158 train-hop guard for variant_id and source_section_id in NewTabContentPing. r=ini\n\nFirefox 158 is on Release, so every platform build that can run the newtab XPI has the variant_id and source_section_id extra_keys in its newtab_content schema. Drop the @backward-compat { version 158 } shim in sanitizeEventData() that stripped them on builds older than 158.0a1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335685\n", "files": ["browser/extensions/newtab/lib/NewTabContentPing.sys.mjs"], "git_node": "2406824d84a6912a3baa1aff805da74efee99c42", "git_parents": ["a440a193e7d195088204e27639aade24ca914105"], "node": "74587ff1a90f9ab8c6ffb4b25aca8f6e28930f49", "parents": ["433046cffd327c793f2a2914e30ce9811c9161ba"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333781: Rebuild XUL keyset handlers when its key elements change. r=dom-core-reviewers,smaug\n\nA keyset builds its handler chain once, so adding, removing or changing one of its key elements has no effect until the keyset is re-inserted into the document. Such a change now drops the keyset's handler chain, and the next key event builds a new one. Key event handlers are refcounted, so a walk of the chain that runs script keeps the handlers it uses alive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329568\n", "files": ["dom/events/GlobalKeyListener.cpp", "dom/events/GlobalKeyListener.h", "dom/events/KeyEventHandler.cpp", "dom/events/KeyEventHandler.h", "dom/events/ShortcutKeys.cpp", "dom/events/ShortcutKeys.h", "dom/html/TextControlState.cpp", "dom/xul/nsXULElement.cpp", "toolkit/content/tests/chrome/window_keys.xhtml"], "git_node": "cfb6458b99bb75d62951376e7c59c6b349854c28", "git_parents": ["2406824d84a6912a3baa1aff805da74efee99c42"], "node": "4b8b450fbb5a45f83318b251870364a4b3a83573", "parents": ["74587ff1a90f9ab8c6ffb4b25aca8f6e28930f49"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333781: Highlight a menu bar item when its shortcut runs, not before the window handles the key. r=mac-reviewers,bradwerth\n\nThe menu bar ran a highlight-only pass for every Command shortcut before the page saw the key, so menus flashed for keys the page consumed and for disabled commands, sometimes twice. That pass is gone. When a key element runs its command, the menu item showing that shortcut is highlighted through performActionForItemAtIndex: with its action switched off, which is the same AppKit path a key equivalent takes. Keys without Command still stay with a native key window such as a sheet, as bug 2060306 requires, and for Command keys the menu bar now reports whether it handled the key instead of always returning NO.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329570\n", "files": ["widget/cocoa/nsMenuBarX.h", "widget/cocoa/nsMenuBarX.mm", "widget/cocoa/nsMenuGroupOwnerX.h", "widget/cocoa/nsMenuGroupOwnerX.mm", "widget/cocoa/nsMenuItemX.mm"], "git_node": "df17f7ba110e04e31a181464509e0c207fd990d4", "git_parents": ["cfb6458b99bb75d62951376e7c59c6b349854c28"], "node": "aee194e4fc5942ad761571fd889671ea6cbcb7ae", "parents": ["4b8b450fbb5a45f83318b251870364a4b3a83573"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333781: Let a shortcut assigned to a menu item in System Settings replace the built-in one. r=mac-reviewers,bradwerth\n\nAppKit honors a shortcut the user assigns to a menu item in System Settings, but Gecko kept running the built-in shortcut first. The menu bar now runs an item whose assigned shortcut matches the key and consumes the event, so neither Gecko nor web content sees it. The XUL key element is rewritten to the assigned shortcut and keeps its own values in data-builtin-* attributes, so tooltips and about:keyboard show the shortcut that actually works. AppKit applies assignments when an item is inserted into a menu and announces later changes through NSMenuDidChangeItemNotification, so the copy runs at those points.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329571\n", "files": ["widget/cocoa/TextInputHandler.h", "widget/cocoa/nsCocoaUtils.h", "widget/cocoa/nsCocoaUtils.mm", "widget/cocoa/nsMenuBarX.h", "widget/cocoa/nsMenuBarX.mm", "widget/cocoa/nsMenuGroupOwnerX.h", "widget/cocoa/nsMenuGroupOwnerX.mm", "widget/cocoa/nsMenuItemX.h", "widget/cocoa/nsMenuItemX.mm", "widget/cocoa/nsMenuX.h", "widget/cocoa/nsMenuX.mm", "widget/tests/gtest/TestCocoaKeyCodeNames.mm", "widget/tests/gtest/moz.build", "xpcom/ds/StaticAtoms.py"], "git_node": "8e8903c1cd3e3bff4c4a339ad463da842a3e8f42", "git_parents": ["df17f7ba110e04e31a181464509e0c207fd990d4"], "node": "1096293273e92d16a5abcbb6e5188409bc7c21b9", "parents": ["aee194e4fc5942ad761571fd889671ea6cbcb7ae"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333781: Make about:keyboard work underneath a shortcut assigned in System Settings. r=Jamie,fluent-reviewers,bolsson\n\nWhile a System Settings assignment is in effect, a customization made in about:keyboard goes into the key element's data-builtin-* copies, so it applies once the assignment is removed instead of fighting it. about:keyboard shows where such a shortcut comes from and doesn't offer to change it. The keyset re-append workaround is gone, since key elements now take attribute changes in place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329572\n", "files": ["browser/components/customkeys/CustomKeys.sys.mjs", "browser/components/customkeys/CustomKeysParent.sys.mjs", "browser/components/customkeys/content/customkeys.css", "browser/components/customkeys/content/customkeys.js", "browser/components/customkeys/tests/browser/browser.toml", "browser/components/customkeys/tests/browser/browser_CustomKeys.js", "browser/components/customkeys/tests/browser/browser_aboutKeyboard_systemAssigned.js", "browser/components/customkeys/tests/browser/head.js", "browser/locales/en-US/browser/customkeys.ftl"], "git_node": "2140b2d6746e2142f42ff9177f13846aa0b23e46", "git_parents": ["8e8903c1cd3e3bff4c4a339ad463da842a3e8f42"], "node": "9e5021a79c9495ca9db1ccb6ff6659557ce9ff2f", "parents": ["1096293273e92d16a5abcbb6e5188409bc7c21b9"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083766 - Improve the secret settings naming for the privacy notification feature. r=john-oberhauser\n\n\u003cimg width=\"540\" height=\"1200\" alt=\"Screenshot_20261022_142425\" src=\"https://github.com/user-attachments/assets/e7ba4388-e405-4c4c-858c-9aa5db3df01d\" /\u003e\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/408\n", "files": ["mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "3755fc1f573fcebb3252db8f7bf6b5b46842ee7f", "git_parents": ["2140b2d6746e2142f42ff9177f13846aa0b23e46"], "node": "9604017998cd0987ead3fdacb631d3ca6e7cdab7", "parents": ["9e5021a79c9495ca9db1ccb6ff6659557ce9ff2f"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge firefox-main to firefox-autoland\n", "files": ["gfx/wr/wrench/invalidation/backdrop_above_slice_overlay.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_clip_grow_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_clip_grow_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_move_together_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_move_together_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_overlay.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_overlay_ref.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_radius_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_radius_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_rounded.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_rounded_ref.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_under_clip_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_scroll_under_clip_2.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_underlay.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_underlay_ref.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_unsampled_1.yaml", "gfx/wr/wrench/invalidation/backdrop_cross_slice_unsampled_2.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_control.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_inside.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_inside_ref.yaml", "gfx/wr/wrench/invalidation/backdrop_own_slice_overlay_outside.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-invisible-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-invisible.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-partial-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-partial.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scaled-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scaled.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scroll-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-scroll.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-two-scrollers-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-cross-slice-two-scrollers.yaml"], "git_node": "d0f22bcddc1144be6daf1cea5eff806dd4662209", "git_parents": ["3755fc1f573fcebb3252db8f7bf6b5b46842ee7f", "f4970b3baab87e71af27f3f919abe49c86cfb83c"], "node": "e82f0bc4de6f77f663fff406c1978b07d8009fa4", "parents": ["9604017998cd0987ead3fdacb631d3ca6e7cdab7", "72f8ce062f6096c1bfac61dfc7f7f87a0eeb21fa"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2084315 - Fix verifyAddonsCanBeUninstalledTest by adjusting wait conditions r=isabel_rios\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336761\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAddonsManagerAddonDetailedMenuRobot.kt"], "git_node": "683198796ef303fac8995cd734780af1dac3ab42", "git_parents": ["d0f22bcddc1144be6daf1cea5eff806dd4662209"], "node": "16776c24fd09b0a1bd7bd4cc7951aa3a1e240b17", "parents": ["e82f0bc4de6f77f663fff406c1978b07d8009fa4"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077353 - keep favicon image processing out of the parent in the broken site reporter UI; r=mossop\" for causing bc failures at browser_url_widgets.js\n\nThis reverts commit c326a39a451a1574863c48607bdbfd16ef7c4efb.\n", "files": ["browser/components/reportbrokensite/test/browser/browser_url_widgets.js", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs"], "git_node": "63367f125eaed22ac8f87b0abcf32cfb72d579d7", "git_parents": ["683198796ef303fac8995cd734780af1dac3ab42"], "node": "0b137b65858a9d62b039445516cc582bee6019b9", "parents": ["16776c24fd09b0a1bd7bd4cc7951aa3a1e240b17"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084061: Fix existing string-formatting warnings in `moz.configure`. r=firefox-build-system-reviewers,sergesanspaille\" for causing mozbuild failures\n\nThis reverts commit c6f8a397348cada08a6c73d678d006bbfd766e01.\n", "files": ["moz.configure"], "git_node": "4fc7662e357c6814ff9561e909cde2a5dfa5e3d0", "git_parents": ["63367f125eaed22ac8f87b0abcf32cfb72d579d7"], "node": "8f7c31e312e216685cbdf6b48150f780ebdb93df", "parents": ["0b137b65858a9d62b039445516cc582bee6019b9"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2077159 - Update cached env in CodeCoverageMixin._set_gcov_prefix. r=marco\n\nScriptMixin.query_env maintains a cache of the environment in self.env,\nbut _set_gcov_prefix only modified os.environ, so if query_env was\ncalled before the _set_gcov_prefix call, future calls without the\npartial_env variable would use the cached value without the new env\nvars.\n\nThis caused these environment variables not to be forwarded to new\nprocesses like the self.run_command call following a plain\nself.query_env() call in AndroidEmulatorTest.run_tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333271\n", "files": ["testing/mozharness/mozharness/mozilla/testing/codecoverage.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/scripts/web_platform_tests.py"], "git_node": "39d5c439d40310ea4400301b051878e1119a338e", "git_parents": ["4fc7662e357c6814ff9561e909cde2a5dfa5e3d0"], "node": "98049cbc20eafd950fe1eb9c9ee31200ef95e316", "parents": ["8f7c31e312e216685cbdf6b48150f780ebdb93df"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2077159 - Transform and forward GCOV_PREFIX to aplications started via adb.py. r=marco\n\nWhen we start an application such as the test_runner on a remote\nAndroid device, we need to set GCOV_PREFIX so that the application\ndumps its GCOV output. But we can't set it to the same location as in\nour host, which is created with mktemp -d.\n\nInstead we reuse the same random basename and put it in\ndevice.test_root, which is writable by the target application.\n\nIn a following commit, we will pull back those files to the host's\nGCOV_PREFIX.\n\nThis doesn't cover wdspec tests because they do not use adb.py but a\ncustom ADB client written in Rust.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333272\n", "files": ["testing/mochitest/runjunit.py", "testing/mozbase/mozdevice/mozdevice/adb.py"], "git_node": "5012ad2b572a60bac4a504f0d763695f41c658c1", "git_parents": ["39d5c439d40310ea4400301b051878e1119a338e"], "node": "be9e7ee1557e2c250bf516b09d191b3ec32a8ba2", "parents": ["98049cbc20eafd950fe1eb9c9ee31200ef95e316"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2085795. Only drop a named timeline's animation list once it is empty. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,dshin\n\nRemoveCorrespondingAnimation() removed the whole mAnimationsWithNamedTimeline\nentry for a name after taking one animation out of its list, so every other\nanimation referring to the same timeline name stopped being tracked and was no\nlonger updated when a timeline of that name appeared, disappeared or changed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336766\n", "files": ["layout/style/nsAnimationManager.cpp", "testing/web-platform/tests/scroll-animations/css/animation-timeline-shared-name-removal.html"], "git_node": "0354651b9bedfa4ebec78677cd53a81080013ff2", "git_parents": ["5012ad2b572a60bac4a504f0d763695f41c658c1"], "node": "aaeb0bb72c2211b88a370191f8d9e1cc00aa0fa6", "parents": ["be9e7ee1557e2c250bf516b09d191b3ec32a8ba2"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082925 - Remove Legacy Telemetry Slow SQL reporting r=janerik,mak,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335665\n", "files": ["modules/libpref/init/all.js", "storage/mozStorageConnection.cpp", "storage/mozStorageService.h", "toolkit/components/telemetry/core/Telemetry.cpp", "toolkit/components/telemetry/core/Telemetry.h", "toolkit/components/telemetry/core/nsITelemetry.idl", "toolkit/components/telemetry/docs/data/main-ping.md", "toolkit/components/telemetry/pings/TelemetrySession.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryHistograms.js", "toolkit/components/telemetry/tests/unit/test_TelemetrySession.js", "toolkit/content/aboutTelemetry.js", "toolkit/content/aboutTelemetry.xhtml", "toolkit/locales/en-US/toolkit/about/aboutTelemetry.ftl"], "git_node": "3183e35f8ba2e962e8fe1fbc8d8d6dd9df5ae6dc", "git_parents": ["0354651b9bedfa4ebec78677cd53a81080013ff2"], "node": "1875510f565c2ca605987c0f084f4e3457d09840", "parents": ["aaeb0bb72c2211b88a370191f8d9e1cc00aa0fa6"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084543 - Stop testing function getAtomMarkColor from using illegal bitmap index r=spidermonkey-reviewers,jandem\n\nThie idea is that you can call getAtomMarkIndex() to get the internal index of\nan atom and pass it to getAtomMarkColor(). But nothing stopped you making up an\nimpossible one and passing it in, resulting in an assertion failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335977\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking.cpp", "js/src/jit-test/tests/gc/bug-2084543.js"], "git_node": "fcfedd33b8c4eb760d76a4dd77dd0212ce510627", "git_parents": ["3183e35f8ba2e962e8fe1fbc8d8d6dd9df5ae6dc"], "node": "1e51c20e960bf909560e222128c2a96c99e4b954", "parents": ["1875510f565c2ca605987c0f084f4e3457d09840"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033297 - Improve messaging in Download Manager r=android-reviewers,petru,android-l10n-reviewers,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335436\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/di/DownloadUIMiddlewareProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/middleware/DownloadUIMapperMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/middleware/FileItemDescriptionProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/String.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "5f3069e13e83a174a191791f423f620791b5d9da", "git_parents": ["fcfedd33b8c4eb760d76a4dd77dd0212ce510627"], "node": "82fbd3a5e88caa3409bbbe2844e4afe2711f8bb1", "parents": ["1e51c20e960bf909560e222128c2a96c99e4b954"], "tags": []}, {"author": "Christopher DiPersio \u003ccdipersio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083764 - Update the memories sensitive info keywords regex list for UK items r=cmurray\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336161\n", "files": ["browser/components/aiwindow/models/memories/SensitiveInfoDetector.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_MemoriesChatSource.js", "browser/components/aiwindow/models/tests/xpcshell/test_MemoriesHistorySource.js", "browser/components/aiwindow/models/tests/xpcshell/test_SensitiveInfoDetector.js"], "git_node": "0d4a1495d59c95f16fa055e01ace9a0efd8d1455", "git_parents": ["5f3069e13e83a174a191791f423f620791b5d9da"], "node": "e79d9d115e7bde19ca7aaca484b9ffb951533ce1", "parents": ["82fbd3a5e88caa3409bbbe2844e4afe2711f8bb1"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082525 - add secret setting for QWAC ui r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335186\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "543924b158116fc4563561d4ce4ea0f8c38ae8bb", "git_parents": ["0d4a1495d59c95f16fa055e01ace9a0efd8d1455"], "node": "884e7adb55e85f2574ae1ea2ec489dc19171e797", "parents": ["e79d9d115e7bde19ca7aaca484b9ffb951533ce1"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084332: Adjust space above footer for AITab r=jlewis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336245\n", "files": ["browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css"], "git_node": "15a19c5b86101319723f32d2a4d1ae1864f13c8a", "git_parents": ["543924b158116fc4563561d4ce4ea0f8c38ae8bb"], "node": "5ce7f6c7e7f75d5343c289a4ec65d573004807e8", "parents": ["884e7adb55e85f2574ae1ea2ec489dc19171e797"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Replace misuse of std::forward by std::move in js/ r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335948\n", "files": ["js/src/debugger/Debugger.h", "js/xpconnect/loader/ScriptPreloader.cpp"], "git_node": "5216e359bc97c281e63526d4a262316c3b9d5b2b", "git_parents": ["15a19c5b86101319723f32d2a4d1ae1864f13c8a"], "node": "0b431868a1b68da073e1420248c53d91fb01f9c7", "parents": ["5ce7f6c7e7f75d5343c289a4ec65d573004807e8"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084829 - Ensure gray bits invalidated state doesn't get out of sync when aborting GC r=spidermonkey-reviewers,iain\n\nThe GrayBitsInvalidatedInCurrentGC is usually cleared in\nGCRuntime::endSweepPhase, but this doesn't run if we reset the GC in states\nMarkRoots or Mark. Clear it here instead.\n\nThis problem did not result in the gray bits invalid state being set\nincorrectly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336726\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/jit-test/tests/gc/bug-2084829.js"], "git_node": "16d8123f1dec190d7441ac88393a693de0578372", "git_parents": ["5216e359bc97c281e63526d4a262316c3b9d5b2b"], "node": "fa8e54d58f8a013855d28487c4c9330eb6d989f2", "parents": ["0b431868a1b68da073e1420248c53d91fb01f9c7"], "tags": []}, {"author": "Welpy-cw \u003c58345540+Welpy-cw@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084270 - Stop applying ancestor clips outside popups in intersection observations. r=emilio,layout-reviewers\n\nStop ancestor clipping at the popup frame while preserving clipping inside\nit, so visible popup content can intersect outside subdocument viewports.\n\nCover the regression with a chrome mochitest using a same-origin iframe,\na panel, and a plain observed element outside the embedding viewport.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335689\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/base/test/chrome/chrome.toml", "dom/base/test/chrome/file_intersectionobserver_popup.xhtml", "dom/base/test/chrome/test_intersectionobserver_popup.xhtml"], "git_node": "09284977af1bf2ecb3db36b8d6d5fd2d6fc2bb9a", "git_parents": ["16d8123f1dec190d7441ac88393a693de0578372"], "node": "5c69f54ccef9d55b8fab90031270f84218be6010", "parents": ["fa8e54d58f8a013855d28487c4c9330eb6d989f2"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2075347 - Use the search-config-v3 selector APIs when v3 is enabled r=npoon\n\nSearchEngineSelectorRepository takes a useSearchConfigV3 flag, set from the secret setting and Nimbus flag added in bug 2075344. When it is set the repository calls useRemoteSettingsServerV3 and filterEngineConfigurationV3, and maps SearchEngineDefinitionV3 through a new SearchEngineReader entry point.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/406\n", "files": ["mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/SearchEnums.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/SearchEngineReader.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/SearchEngineSelectorRepository.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineReaderTest.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineSelectorRepositoryTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt"], "git_node": "f2690c4d5b8e26603b8ab032b4eb4a055ff0b73c", "git_parents": ["09284977af1bf2ecb3db36b8d6d5fd2d6fc2bb9a"], "node": "c8d98188db5240de14461fb083a2b130207899bd", "parents": ["5c69f54ccef9d55b8fab90031270f84218be6010"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081176 - [devtools] Remove Debug button in slow script dialog. r=iain,devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334580\n", "files": ["browser/locales/en-US/chrome/browser/browser.properties", "browser/modules/ProcessHangMonitor.sys.mjs", "browser/modules/test/browser/browser_ProcessHangNotifications.js", "devtools/client/debugger/test/mochitest/browser_dbg-slow-script.js", "devtools/client/debugger/test/mochitest/browser_qz.toml", "devtools/client/fronts/thread.js", "devtools/client/shared/metrics.yaml", "devtools/server/actors/thread.js", "devtools/startup/DevToolsStartup.sys.mjs", "dom/base/SlowScriptDebug.sys.mjs", "dom/base/components.conf", "dom/base/moz.build", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsISlowScriptDebug.idl", "dom/ipc/PProcessHangMonitor.ipdl", "dom/ipc/ProcessHangMonitor.cpp", "dom/ipc/ProcessHangMonitor.h", "dom/ipc/nsIHangReport.idl"], "git_node": "9221c825e66155cc32edce9a3d652d7ddd437345", "git_parents": ["f2690c4d5b8e26603b8ab032b4eb4a055ff0b73c"], "node": "3411959c34862f383f5a183e124ba92f775f8586", "parents": ["c8d98188db5240de14461fb083a2b130207899bd"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075553 - Fix intermittent browser_searchModeSwitcher.js fail by skipping hostname check when search service is not available. r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335635\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "798c2b7c2c7e0d0a9fe4aacba21998d8e876c639", "git_parents": ["9221c825e66155cc32edce9a3d652d7ddd437345"], "node": "2612d9ae4591e7f4d7795f34f64ab18c0fc9e226", "parents": ["3411959c34862f383f5a183e124ba92f775f8586"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075553 - Add main process check to search service. r=search-reviewers,jteow\n\nThis is mainly just for improving error messages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336356\n", "files": ["toolkit/components/search/SearchService.sys.mjs"], "git_node": "f3ae438280feb363977a5e54f09bbe181c1ee2f3", "git_parents": ["798c2b7c2c7e0d0a9fe4aacba21998d8e876c639"], "node": "35efb9276bd0fdad9fd8bb8e8140b3f748d3b161", "parents": ["2612d9ae4591e7f4d7795f34f64ab18c0fc9e226"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082525 - add secret setting for QWAC ui r=android-reviewers,twhite\" for causing fenix-lints\n\nThis reverts commit 543924b158116fc4563561d4ce4ea0f8c38ae8bb.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "fa1624ba31c3309f55c0f25c40c3e28a61ee4044", "git_parents": ["f3ae438280feb363977a5e54f09bbe181c1ee2f3"], "node": "86b878230866830b2222d61ac8a288588b20f100", "parents": ["35efb9276bd0fdad9fd8bb8e8140b3f748d3b161"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1332891 - Replace misuse of std::forward by std::move in js/ r=spidermonkey-reviewers,jandem\" for causing SM bustages\n\nThis reverts commit 5216e359bc97c281e63526d4a262316c3b9d5b2b.\n", "files": ["js/src/debugger/Debugger.h", "js/xpconnect/loader/ScriptPreloader.cpp"], "git_node": "b3ad1cea68edf3480e31643ca77371908684aecd", "git_parents": ["fa1624ba31c3309f55c0f25c40c3e28a61ee4044"], "node": "f5b61070bb8b1310e624a13c90dbb25658bc2278", "parents": ["86b878230866830b2222d61ac8a288588b20f100"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084543 - Stop testing function getAtomMarkColor from using illegal bitmap index r=spidermonkey-reviewers,jandem\" for causing SM bustages\n\nThis reverts commit fcfedd33b8c4eb760d76a4dd77dd0212ce510627.\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking.cpp", "js/src/jit-test/tests/gc/bug-2084543.js"], "git_node": "1f305346170e394ca57a4ba936f5985bd8851e62", "git_parents": ["b3ad1cea68edf3480e31643ca77371908684aecd"], "node": "541fae0a4fd1d83fd273d7a293b99ce12fc90e09", "parents": ["f5b61070bb8b1310e624a13c90dbb25658bc2278"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Replace misuse of std::forward by std::move in js/ r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335948\n", "files": ["js/src/debugger/Debugger.h", "js/xpconnect/loader/ScriptPreloader.cpp"], "git_node": "8476e08565b80ab3506ad86f3d5bab1963b7e8bc", "git_parents": ["1f305346170e394ca57a4ba936f5985bd8851e62"], "node": "107a98d65877291ecb0eb2a2ccb6ff928fdb72e0", "parents": ["541fae0a4fd1d83fd273d7a293b99ce12fc90e09"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1812136 - Keep the blob group invalid rect until it is sent to WebRender. r=gfx-reviewers,bradwerth\n\nEndGroup can bail out without sending an update, for example when the group's\nvisible rect is empty, after ComputeGeometryChange already updated the item\ndata. Resetting mInvalidRect at the start of the next paint then lost that\ninvalidation, and WebRender later failed to find items with matching bounds\nwhen merging the blob. Unused items are also swept before that early return\nso that removed items are always invalidated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335180\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "gfx/tests/crashtests/1805333-1.html", "gfx/tests/crashtests/crashtests.list"], "git_node": "62716040314082f5f9941321c1733b92b80db343", "git_parents": ["8476e08565b80ab3506ad86f3d5bab1963b7e8bc"], "node": "e294b51ed416e3269b55f18c6ed06daef72f662c", "parents": ["107a98d65877291ecb0eb2a2ccb6ff928fdb72e0"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085146 - Let about:newtab set wildcard frame-src CSP for two Mozilla-owned domains. r=ckerschb\n\nWe are likely to host more framed widgets on *.merino.nonprod.webservices.mozgcp.net (stage) and\n *.merino.prod.webservices.mozgcp.net (prod) over time. Rather than manually adding each one, we've\ngotten permission from the security team to use a subdomain wildcard CSP for about:newtab/about:home\nfor those two domains.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336806\n", "files": ["dom/security/nsContentSecurityUtils.cpp"], "git_node": "4fb8d218d1ab6b1397f79267de69417efd0f595b", "git_parents": ["62716040314082f5f9941321c1733b92b80db343"], "node": "e562d1cad4c557a53878e808f108b32e1670e7b0", "parents": ["e294b51ed416e3269b55f18c6ed06daef72f662c"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085146 - Let framed widgets load from more Mozilla-owned domains. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336288\n", "files": ["browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/data/content/abouthomecache/page.html.template", "browser/extensions/newtab/prerendered/activity-stream-debug.html", "browser/extensions/newtab/prerendered/activity-stream-noscripts.html", "browser/extensions/newtab/prerendered/activity-stream.html"], "git_node": "e081b51c83346cffec906cc6633e97dff608e176", "git_parents": ["4fb8d218d1ab6b1397f79267de69417efd0f595b"], "node": "09bf04df03c97c02e2c63e1001d132aa5cf25afe", "parents": ["e562d1cad4c557a53878e808f108b32e1670e7b0"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085256 - Include an xpcshell debugging test in devtools compat jobs (dtbc(same)) r=devtools-reviewers,nchevobbe\n\nAutomates the \"Check xpcshell debugging\" step of the devtools release tasks\n\nRun an xpcshell test with --jsdebugger from the DTbc(same) job and debug it from\nabout:debugging: pause on the first line, hit a breakpoint, step, and resume.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336346\n", "files": ["devtools/client/aboutdebugging/test/backward_compat_test_server/control.py", "devtools/client/aboutdebugging/test/backward_compat_test_server/fixtures/xpcshell/test_debug_me.js", "devtools/client/aboutdebugging/test/backward_compat_test_server/fixtures/xpcshell/xpcshell.toml", "devtools/client/aboutdebugging/test/backward_compat_test_server/moz.build", "devtools/client/aboutdebugging/test/backward_compat_test_server/runner.py", "devtools/client/aboutdebugging/test/backward_compat_test_server/servers.py", "devtools/client/aboutdebugging/test/backward_compat_test_server/session.py", "devtools/client/aboutdebugging/test/browser/browser_backward_compat.toml", "devtools/client/aboutdebugging/test/browser/browser_backward_compat_xpcshell.js", "devtools/docs/contributor/release.md", "devtools/docs/contributor/tests/backward-compat-tests.md", "devtools/mach_commands.py", "python/sites/devtools-compat-test.txt", "testing/mozharness/scripts/devtools_compat.py"], "git_node": "18aade48713aa0e4e030e0dd5c47b21b320f88ec", "git_parents": ["e081b51c83346cffec906cc6633e97dff608e176"], "node": "5a7b7dd371a3db6eebaf998bcc868ae9c1ba9c57", "parents": ["09bf04df03c97c02e2c63e1001d132aa5cf25afe"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085054 - Update `wgpu` to revision bbb9b06e90a166989f3112696cc7c52ce9700cdc. r=webgpu-reviewers,supply-chain-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336748\n", "files": [".cargo/config.toml.in", "Cargo.lock", "gfx/wgpu_bindings/Cargo.toml", "gfx/wgpu_bindings/moz.yaml", "supply-chain/audits.toml", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/command_buffer/image_copy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/rendering/3d_texture_slices/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/state/device_lost/destroy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupAdd/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupMinMax/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/subgroupMul/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGather/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureLoad/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSample/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleBias/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleCompareLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleGrad/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/zero_init/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/service.https.html.ini", "third_party/rust/wgpu-core/.cargo-checksum.json", "third_party/rust/wgpu-core/src/command/clear.rs", "third_party/rust/wgpu-core/src/device/resource.rs", "third_party/rust/wgpu-core/src/indirect_validation/dispatch.rs", "third_party/rust/wgpu-core/src/indirect_validation/draw.rs", "third_party/rust/wgpu-core/src/indirect_validation/mod.rs", "third_party/rust/wgpu-core/src/instance.rs", "third_party/rust/wgpu-core/src/pipeline.rs", "third_party/rust/wgpu-core/src/timestamp_normalization/mod.rs", "third_party/rust/wgpu-core/src/validation.rs", "third_party/rust/wgpu-hal/.cargo-checksum.json", "third_party/rust/wgpu-hal/src/metal/adapter.rs", "third_party/rust/wgpu-hal/src/metal/mod.rs", "third_party/rust/wgpu-hal/src/metal/surface.rs", "third_party/rust/wgpu-hal/src/vulkan/adapter.rs", "third_party/rust/wgpu-hal/src/vulkan/command.rs", "third_party/rust/wgpu-hal/src/vulkan/device.rs", "third_party/rust/wgpu-hal/src/vulkan/mod.rs", "third_party/rust/wgpu-hal/src/vulkan/swapchain/native.rs", "third_party/rust/wgpu-types/.cargo-checksum.json", "third_party/rust/wgpu-types/src/features.rs"], "git_node": "ff83dff191276d2d15eb7f3ba904e0a5d65c93bc", "git_parents": ["18aade48713aa0e4e030e0dd5c47b21b320f88ec"], "node": "6a31089867cba2399661aa9a9b588d97ead790c0", "parents": ["5a7b7dd371a3db6eebaf998bcc868ae9c1ba9c57"], "tags": []}, {"author": "Fabio Kaminski \u003cfabio.kaminski@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2078878 fix ext-texture-norm16 test failures avoiding Android builds. r=gfx-reviewers,bradwerth,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334115\n", "files": ["dom/canvas/test/webgl-mochitest/mochitest.toml"], "git_node": "9a4ac7408ab6b40a75efbb2e794530d59b3d45b8", "git_parents": ["ff83dff191276d2d15eb7f3ba904e0a5d65c93bc"], "node": "1c51ff413524a4887f447d6c7cd682f71bca7f3d", "parents": ["6a31089867cba2399661aa9a9b588d97ead790c0"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085010 - Link removal and dropdown panel events through flow_id. r=mtigley,credential-management-reviewers\n\n`record_interaction` and `record_dialog_interaction` now carry the dropdown's\n`flow_id`. A delete or edit click, and the answer to the removal dialog, can\nnow be joined to the `dropdown_shown` and `dropdown_closed` events of the same\npanel.\n\nRemoving a password, address or payment method hides the dropdown while the\nreauth or confirmation prompt is up. This created new `flow_id`s when the\npanel was reopened. A delete now holds the current `flow_id` for the reopen on\nthe same field, for up to 5 seconds after the provider finishes.\n\n- `dropdown_closed` gets a new `close_reason`, \"removal_prompt\", for the close\n  caused by the prompt.\n- `dropdown_shown` gets a boolean extra, `reopened_after_removal`. It is true\n  only for the automatic reopen.\n- `AutoCompleteParent` passes the `flow_id` to the provider as its own\n  argument, and the provider passes it on to\n  `AutocompleteRemoveRecord.confirmRemoval`. It never goes through\n  `fillMessageData`, which comes from content.\n\nForm history removals never closed the dropdown, so they only gain the\n`flow_id` on `record_interaction`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336222\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/passwordmgr/LoginManagerParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/AutocompleteRemoveRecord.sys.mjs", "toolkit/components/satchel/metrics.yaml", "toolkit/components/satchel/test/browser/browser_popup_secondary_action.js"], "git_node": "d9dd195ea52ea06bcbd6e30cb13f125f89614381", "git_parents": ["9a4ac7408ab6b40a75efbb2e794530d59b3d45b8"], "node": "b042ff532e8cc0017ff3bb184b67796a223b01bb", "parents": ["1c51ff413524a4887f447d6c7cd682f71bca7f3d"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083944 - Update the clear browsing data dialog's strings to the final design. r=fluent-reviewers,bolsson,settings-reviewers,akulyk\n\nThe fire button's dialog design replaces the old one for every entry point, so the option labels and subtitles, the \"All time\" option and the warning change wherever the dialog opens. Each string gets a new ID since its meaning changed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335411\n", "files": ["browser/base/content/sanitizeDialog.js", "browser/base/content/sanitize_v2.xhtml", "browser/components/preferences/config/privacy.mjs", "browser/locales/en-US/browser/sanitize.ftl"], "git_node": "6140c7ddaf9229056c16fdefb6e54e4c284bad80", "git_parents": ["d9dd195ea52ea06bcbd6e30cb13f125f89614381"], "node": "05e6a1a6e8f61973f41c5a2b88a4d3cd8e041310", "parents": ["b042ff532e8cc0017ff3bb184b67796a223b01bb"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083944 - Tighten the spacing of the clear browsing data dialog's options to match the design. r=desktop-theme-reviewers,kcochrane\n\nThe checkbox margins and row padding added up to about 10px between a label and its subtitle and 26px between options, where the design has 4px and 16px. The space below the last option now matches the gaps between options, with a little more above the first one to set the options apart from the dropdown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335815\n", "files": ["browser/themes/shared/sanitizeDialog_v2.css"], "git_node": "34fd7aeb3ea7be76afd789cc675aa2726ee5baee", "git_parents": ["6140c7ddaf9229056c16fdefb6e54e4c284bad80"], "node": "0e6c61354982b6d9db83a8f218d09bffc36969df", "parents": ["05e6a1a6e8f61973f41c5a2b88a4d3cd8e041310"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034086: Make fileIds unknown on failed removals. r=dom-storage-reviewers,hsingh\n\nForeign key enforcement is enabled for every connection; the data\nmanager's connection already had it from InitializeConnection, but the\nquota client connections did not, so no cascade fired there.\n\nWhen the on-disk blob cannot be removed, the FileIds row is removed and\nthe usage released all the same, instead of keeping the row for an idle\nmaintenance which does not exist. Rows left behind by earlier versions,\nand temporary files of writable streams which a crash prevented from\nclosing, are removed when FileSystemDataManager opens the database;\nnothing can reference them at that point. The sweep is not done from\nFileSystemQuotaClient::InitOrigin because the quota manager skips client\ninitialization for origins restored from its cache, so InitOrigin does\nnot run on a normal startup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296312\n", "files": ["dom/fs/parent/datamodel/FileSystemDataManager.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManager.h", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion001.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion001.h", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.h", "dom/fs/test/gtest/parent/FileSystemParentTest.cpp", "dom/fs/test/gtest/parent/FileSystemParentTest.h", "dom/fs/test/gtest/parent/TestFileSystemOrphanCleanup.cpp", "dom/fs/test/gtest/parent/moz.build", "dom/fs/test/xpcshell/test_fileIdCarry.js", "dom/fs/test/xpcshell/test_orphanUsageCleanup.js", "dom/fs/test/xpcshell/xpcshell.toml"], "git_node": "d4dc5d2dedcf7af6b1919cf51b3f0c5b722645b2", "git_parents": ["34fd7aeb3ea7be76afd789cc675aa2726ee5baee"], "node": "7dceaa61313bbe1098ed5dc95fdbc17a09609f7d", "parents": ["0e6c61354982b6d9db83a8f218d09bffc36969df"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034086: Remove usage rows whose file id no longer exists. r=dom-storage-reviewers,hsingh\n\nUsages rows with no FileIds parent from the time before foreign key\nenforcement was enabled are removed in RemoveFileIdsWithoutMainFile\nwhich runs once per DataManager open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335192\n", "files": ["dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.cpp", "dom/fs/test/xpcshell/test_orphanUsageCleanup.js"], "git_node": "43e2431c583ce4ef4eb89eaf8ec8fc496437df38", "git_parents": ["d4dc5d2dedcf7af6b1919cf51b3f0c5b722645b2"], "node": "35660cbca7fcb8cb82ad49a39016324db08796a6", "parents": ["7dceaa61313bbe1098ed5dc95fdbc17a09609f7d"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084105 - [bidi] Throw invalid argument when deserializing a local value with an unknown type r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335609\n", "files": ["remote/webdriver-bidi/RemoteValue.sys.mjs", "remote/webdriver-bidi/test/browser/browser_RemoteValue.js"], "git_node": "63f90da2ab1ff87de4a81e496090367fbb395995", "git_parents": ["43e2431c583ce4ef4eb89eaf8ec8fc496437df38"], "node": "a2c39525069f10d191bcc708ca35df69227f7876", "parents": ["35660cbca7fcb8cb82ad49a39016324db08796a6"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084105 - [wdspec] Add tests for script.callFunction with unknown local value types r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335610\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/script/call_function/invalid.py"], "git_node": "e5d0735ea912c0428eeb51ec23106c5ff6a583f0", "git_parents": ["63f90da2ab1ff87de4a81e496090367fbb395995"], "node": "a1c8c8324da20204c65411c1a09718fd439af5ef", "parents": ["a2c39525069f10d191bcc708ca35df69227f7876"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045799 - Stop running macOS aarch64 AWSY pageload tests on hardware. r=perftest-reviewers,aglavic\n\n~2 week follow up on D332037\nawsy pageload now runs on macOS tartVMs\nawsy base stays on hardware\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332443\n", "files": ["taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "testing/perfdocs/generated/awsy.md"], "git_node": "e0d2a616a4e825d0c09fbe022f72b3b6b4aba5a1", "git_parents": ["e5d0735ea912c0428eeb51ec23106c5ff6a583f0"], "node": "359d01f998251dc1623ba625d6509c750356d3e6", "parents": ["a1c8c8324da20204c65411c1a09718fd439af5ef"], "tags": []}, {"author": "Oskar Mansfeld \u003comansfeld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082899 - Instrument ECN for experimentation and clean up FeatureManifest.yaml r=necko-reviewers,valentin\n\n- Adds `http3_ecn_mark` to the FeatureManifest\n- Groups Congestion Control prefs in a new `networkingCongestionControl`\n  feature\n- moves two DNS prefs to the existing `networkingDNS` feature\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334534\n", "files": ["toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "d8409b8b37d6e9812c0179d87ac9b7af8e9d47bf", "git_parents": ["e0d2a616a4e825d0c09fbe022f72b3b6b4aba5a1"], "node": "a943efc5c48f27797c0c10bc29585161f44a88d5", "parents": ["359d01f998251dc1623ba625d6509c750356d3e6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1858394 - Give each mozproxy test its own Firefox policies directory. r=perftest-reviewers,kshampur\n\nThe tests passed a bare \"firefox\" binary, so MitmproxyDesktop wrote distribution/policies.json in the current\ndirectory, which test_proxy.py, test_recording.py and the mozproxy processes test_command_line.py starts all\nshare. As mach python-test runs test files in parallel, one test could rewrite or turn off the policies\nbetween another's write and its check, failing install_mitmproxy_cert with SystemExit.\n\nThe binary now lives under a per-test directory, with a MacOS parent so the macOS Resources path stays inside\nit too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336300\n", "files": ["testing/mozbase/mozproxy/tests/support.py", "testing/mozbase/mozproxy/tests/test_command_line.py", "testing/mozbase/mozproxy/tests/test_proxy.py", "testing/mozbase/mozproxy/tests/test_recording.py"], "git_node": "7c8badd91eba4c9a692a6e9daae462f5d06a4c8a", "git_parents": ["d8409b8b37d6e9812c0179d87ac9b7af8e9d47bf"], "node": "1153fc63645584d0d0da57eb77464f2f508b37ca", "parents": [